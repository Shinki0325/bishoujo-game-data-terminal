"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"八坂学園海空機科に通う三年生。通称は白姫。"},{"spoiler":false,"text":"シキシマ国第一王女。主人公の幼馴染。"},{"spoiler":false,"text":"一子相伝のシキシマ流性交術の使い手にしてハルの筆おろしの相手。"},{"spoiler":false,"text":"時に優しく、時に厳しい、男の子をリードしてくれる癒し系のお姉さん。"},{"spoiler":false,"text":"実はSっ気が……。"}],"source":"egs","sourceCharacterId":"26221","sourceWorkId":"6369","spoiler":false},{"segments":[{"spoiler":false,"text":"シキシマ国第一王女。ハルの幼なじみの一人。"},{"spoiler":false,"text":"基本的に優しくハルのお姉さんの様な存在。何でも出来る王女らしい人物だが、ドS。"}],"source":"bangumi","sourceCharacterId":"130078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7d0f44a1aa6990ba71f9d559e50ff30cb3342bf7aea33ac26c13a16c516746a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b970095034917ff542cd858f1d1bac9ec51dfccc6612f9c9199f8ff3fb2e1550.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218171:130078:4432:1","source":"bangumi"}]},{"characterId":"char_c20696","characterName":"ポチ","sourceIds":{"bangumi":[{"characterId":"130081","match":"exact-normalized-name-in-linked-work","subjectId":"218171"}],"egsCharacterIds":["26224"],"vndbCharacterId":"c20696"},"originalCharacterName":"ポチ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"八坂学園陸甲機科に通う一年生。"},{"spoiler":false,"text":"ナナミに仕えるメイド……、だがメイドとしてはほとんど役に立たない。"},{"spoiler":false,"text":"ただし、メカニックマンとしては優秀で、主であるナナミの愛車（戦車）「AMT58J フリントストーン」の修理、メンテナンスは完璧。また操縦についてもプロフェッショナル。"},{"spoiler":false,"text":"主と同様に興奮するとセンゴク訛り（関西弁）になる。"}],"source":"egs","sourceCharacterId":"26224","sourceWorkId":"6369","spoiler":false},{"segments":[{"spoiler":false,"text":"ナナミのメイド。"},{"spoiler":false,"text":"ナナミの自家用車(戦車)の運転と修理は完璧にこなすがそれ以外はてんでダメ。頭が弱いアホの子。"},{"spoiler":false,"text":"犬耳ヘアーからポチと呼ばれている。"}],"source":"bangumi","sourceCharacterId":"130081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d51eb96c058de4efb3bc6bca67e1ec31a9caf1d9076c2ed9679948d01424656c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6543df1866b486cd61b287a8a0003fa387bb3e4e3b3c61e6e780048986072e2.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤 邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218171:130081:4514:1","source":"bangumi"}]},{"characterId":"char_c20697","characterName":"サキサカ サキ","sourceIds":{"bangumi":[{"characterId":"130080","match":"exact-normalized-name-in-linked-work","subjectId":"218171"}],"egsCharacterIds":["26225"],"vndbCharacterId":"c20697"},"originalCharacterName":"サキサカ サキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"八坂学園宙行機科に通う二年生。"},{"spoiler":false,"text":"サキサカ国第一王女。"},{"spoiler":false,"text":"身体の約80％を機械化している、通称ロボ姫。"},{"spoiler":false,"text":"普段は寡黙で、感情の起伏も少ないが、一度スイッチが入ると自分で制御が出来なくなってしまう。"}],"source":"egs","sourceCharacterId":"26225","sourceWorkId":"6369","spoiler":false},{"segments":[{"spoiler":false,"text":"サキサカ国第一王女。"},{"spoiler":false,"text":"身体の80%を機械化しており、感情表現が乏しい。"},{"spoiler":false,"text":"自国の関係もあり蔑まれているが、本人は自分がロボットである事に誇りを持っている。"},{"spoiler":false,"text":"ヤガミの地下資源目当てにハルに近付く。"}],"source":"bangumi","sourceCharacterId":"130080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53cf11b96a01d1b2279f7f0a8eaeda4ab710d0f02a91e66d5a78bbee00ea7d2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bee73d14d1dff414c6321be2eee495ad485b79bd387e54678efb5192fd6e730f.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218171:130080:4714:1","source":"bangumi"}]},{"characterId":"char_c20699","characterName":"ヤガミ コハル","sourceIds":{"bangumi":[{"characterId":"130076","match":"exact-normalized-name-in-linked-work","subjectId":"218171"}],"egsCharacterIds":["26220"],"vndbCharacterId":"c20699"},"originalCharacterName":"ヤガミ コハル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"八坂学園陸甲機科に通う二年生。愛称はハル。"},{"spoiler":false,"text":"腹違いの兄が急逝したことによって、繰り上げで、ヤガミ国の第一王位継承者になった。"},{"spoiler":false,"text":"そのため、暗殺者に狙われるようになった彼は、同学園海空機科三年生にして同学園学園長、さらにはトワノ国王子であるトワノアキヒトのはからい（？）によって、身分を隠し、女装して女子学生として学園生活を送ることになる。"},{"spoiler":false,"text":"普段はのほほんとしているが、やるときはやる、そんな男の子。"}],"source":"egs","sourceCharacterId":"26220","sourceWorkId":"6369","spoiler":false},{"segments":[{"spoiler":false,"text":"このゲームの主人公。ショタで普段は女装をしている。"},{"spoiler":false,"text":"ヤガミ国第一王位継承者で、現在王位に相応しい人物になる為の教育と暗殺を避ける為に女子校に通う。"},{"spoiler":false,"text":"受身な性格で基本はヘタレで、いつも女の子に振り回される（性的な意味で）が決める時はしっかり決めて漢を見せる。"},{"spoiler":false,"text":"実はこのゲームの最強候補…というか、設定だけなら最強。"}],"source":"bangumi","sourceCharacterId":"130076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88d8d7308ee79500f979fc496e0b88d2d78fd98881bf420968df453b2a331bbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bebe5e9dc527776afecc2bb0662a5fd5e8a291c8b0f13c5c0e044380573b557.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218171:130076:6045:1","source":"bangumi"}]},{"characterId":"char_c20701","characterName":"シキシマ ココ","sourceIds":{"bangumi":[{"characterId":"130079","match":"exact-normalized-name-in-linked-work","subjectId":"218171"}],"egsCharacterIds":["26223"],"vndbCharacterId":"c20701"},"originalCharacterName":"シキシマ ココ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"八坂学園陸甲機科に通う一年生。通称は妹姫。"},{"spoiler":false,"text":"シキシマ王と愛妾サクラの間に生まれた、ナコトの腹違いの妹。"},{"spoiler":false,"text":"柔和で可愛らしい女の子だが、極度に恥ずかしがり屋で、臆病な性格。"},{"spoiler":false,"text":"そのため、すぐに物陰に隠れてしまったりする。"},{"spoiler":false,"text":"喋り方も小声でボソボソと話す。"}],"source":"egs","sourceCharacterId":"26223","sourceWorkId":"6369","spoiler":false},{"segments":[{"spoiler":false,"text":"シキシマ国第二王女。ナコトの腹違いの妹。"},{"spoiler":false,"text":"人見知りの激しい性格で男性恐怖症。"}],"source":"bangumi","sourceCharacterId":"130079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d57f19c6d7d54ee3f8a7b30935be7ac8dbba3