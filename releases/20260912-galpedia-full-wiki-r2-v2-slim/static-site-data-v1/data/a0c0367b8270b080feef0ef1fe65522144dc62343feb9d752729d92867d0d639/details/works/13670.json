ourceWorkId":"16645","spoiler":false},{"segments":[{"spoiler":false,"text":"前シリーズでの主人公。"},{"spoiler":false,"text":"今作では……。"}],"source":"egs","sourceCharacterId":"2754","sourceWorkId":"19658","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロインで、白樺学園に通う少女。"},{"spoiler":false,"text":"つややかな長い髪と清楚な顔立ちで、男子の間では学園でも5本の指に入るアイドル。"},{"spoiler":false,"text":"しかし本人にはまったくその自覚が無く、また恥ずかしがりな性格からまだ誰とも付き合ったことがない。"},{"spoiler":false,"text":"それどころかほとんどの男子とまともに会話も出来ない。"},{"spoiler":false,"text":"のほほんとした性格で、かなりのお人好し。"},{"spoiler":false,"text":"重度の運動オンチで、何もないところで転んだりすることもしばしば。"},{"spoiler":false,"text":"強い思念の持ち主（＝強い魔力を持つ者）としてエーテルランドの女王に認められ、魔法少女に変身して違反者と戦うことになる。"},{"spoiler":false,"text":"「違反者さんたちは私が退治します！」"}],"source":"bangumi","sourceCharacterId":"94669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5d92b397541f2289264ab4a0f92592742e1d8ffe6844b75d84ee25d3bc7aaa1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a1e3c580d58e44e5c4011f9110a15ec5407a5bebc3c2abe1092c59cdd043a77.webp","width":211,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:333083:94669:4177:1","source":"bangumi"}]},{"characterId":"char_c39943","characterName":"エミット","sourceIds":{"bangumi":[{"characterId":"94671","match":"exact-normalized-name-in-linked-work","subjectId":"120942"},{"characterId":"94671","match":"exact-normalized-name-in-linked-work","subjectId":"197213"},{"characterId":"94671","match":"exact-normalized-name-in-linked-work","subjectId":"333081"},{"characterId":"94671","match":"exact-normalized-name-in-linked-work","subjectId":"333082"},{"characterId":"94671","match":"exact-normalized-name-in-linked-work","subjectId":"33308