ode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:67683","source":"vndb"},{"creditedName":"みるく","creatorId":"vndb:s4182","sourcePersonId":"vndb:s4182","canonicalEntityId":"vndb:s4182","name":"みるく","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:67684","source":"vndb"},{"creditedName":"黒崎 朔夜","creatorId":"vndb:s5137","sourcePersonId":"vndb:s5137","canonicalEntityId":"vndb:s5137","name":"黒崎 朔夜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:67685","source":"vndb"},{"creditedName":"All Limited Trigger","creatorId":"vndb:s13612","sourcePersonId":"vndb:s13612","canonicalEntityId":"vndb:s13612","name":"All Limited Trigger","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:67688","source":"vndb"},{"creditedName":"平瀬 まり","creatorId":"vndb:s52122","sourcePersonId":"vndb:s52122","canonicalEntityId":"vndb:s52122","name":"平瀬 まり","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:67690","source":"vndb"}]},"cast":[{"characterId":"char_c20792","characterName":"円谷 みなも","sourceIds":{"bangumi":[{"characterId":"54508","match":"exact-normalized-name-in-linked-work","subjectId":"18280"}],"egsCharacterIds":["10460"],"vndbCharacterId":"c20792"},"originalCharacterName":"円谷 みなも","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも元気で騒がしい神出鬼没な下級生。"},{"spoiler":false,"text":"すっとんきょうな格好や言動でいつも御代を引っ張りまわすトラブルメーカーだが、特に悪意は感じられない。"},{"spoiler":false,"text":"流行りもののＴＶ番組が大好き、時々ＴＶの影響で喋り方や性格などびっくりする様な変容を遂げる。"},{"spoiler":false,"text":"だが、所詮頭の中身はイマイチ変わらないようだ。"},{"spoiler":false,"text":"入院している姉のまどかをいつも気にかけている優しい一面もある。"},{"spoiler":false,"text":"周りのものの影響を受けすぎて、ついには自分の存在を保てなくなっていってしまう……。"}],"source":"egs","sourceCharacterId":"10460","sourceWorkId":"15067","spoiler":false},{"segments":[{"spoiler":false,"text":"変身願望の強いメディアダンサー"},{"spoiler":false,"text":"いつも元気で騒がしい神出鬼没な下級生。"},{"spoiler":false,"text":"すっとんきょうな格好や言動でいつも御代を引っ張りまわすトラブルメーカーだが、特に悪意は感じられない。"},{"spoiler":false,"text":"流行りもののTV番組が大好き。時々TVの影響で喋り方や性格などがびっくりするほどの変容を遂げる。"},{"spoiler":false,"text":"だが、しょせん頭の中身はイマイチ変わらないようだ。"},{"spoiler":false,"text":"入院している姉の円をいつも気にかけている優しい一面もある。"},{"spoiler":false,"text":"周りのものの影響を受けすぎて、ついには自分の存在を保てなくなっていってしまう……。"},{"spoiler":false,"text":"「私はこの騒がしい街がだーいすき！ なんだよ。だってここには私の見たことも無いものがまだまだぎぃ～しり詰まってるのだ！」"}],"source":"bangumi","sourceCharacterId":"54508"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b133ff3c583306aafeb7bc3d4915becad8ab7f4e1eaf3bbb3bd3d66d9bf70456.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12ad326f91aff6e02a9104cf6ab030dc213c9551bc05a16388db66d9199dbd2e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18280:54508:5020:1","source":"bangumi"}]},{"characterId":"char_c36728","characterName":"梔 初夏","sourceIds":{"bangumi":[{"characterId":"54506","match":"exact-normalized-name-in-linked-work","subjectId":"18280"}],"egsCharacterIds":["10458"],"vndbCharacterId":"c36728"},"originalCharacterName":"梔 初夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつもオドオドした、引っ込み思案で他人との関係を築くことが出来ない少女。"},{"spoiler":false,"text":"ある事件をきっかけに声をだせなくなったため、いつもスケッチブックを使い筆談で意思疎通をはかっている。"},{"spoiler":false,"text":"「んっ！」とか「うんっ」などの短い意思表示は出来る。"},{"spoiler":false,"text":"御代だけは彼女と会話ができるのだが、それには彼女自身の理《コトワリ》が深く関係している。"},{"spoiler":false,"text":"ただひとり自分と会話ができる――心を許すことができた――御代に頼りきってしまうことで、初夏の運命は大きく変わってゆく事になる。"}],"source":"egs","sourceCharacterId":"10458","sourceWorkId":"15067","spoiler":false},{"segments":[{"spoiler":false,"text":"引っ込み思案で話せない少女"},{"spoiler":false,"text":"いつもオドオドした、引っ込み思案で他人との関係を築くことが出来ない少女。"},{"spoiler":false,"text":"ある事件をきっかけに声を出せなくなったため、いつもスケッチブックを使い筆談で意思疎通を図っている。"},{"spoiler":false,"text":"「んっ！」 とか 「うんっ」 などの短い意思表示は出来る。"},{"spoiler":false,"text":"御代だけは彼女と会話が出来るのだが、それには彼女自身の “理（コトワリ） ”が深く関係している。"},{"spoiler":false,"text":"ただ一人自分と会話が出来る ――心を許すことが出来た―― 御代に頼りきってしまうことで、初夏の運命は大きく変わってゆくことになる。"},{"spoiler":false,"text":"「んっ……う……ぅんっ」"}],"source":"bangumi","sourceCharacterId":"54506"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90119f472632dae656fd76c4cd6e673311090755e2fdb5884b2f47e1aed03ee4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2c83357e7597314a8868d207239e7477e175a2ea3ee13f4e32ca72f72915225.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18280:54506:6166:1","source":"bangumi"}]},{"characterId":"char_c36729","characterName":"橘 清見","sourceIds":{"bangumi":[{"characterId":"54507","match":"exact-normalized-name-in-linked-work","subjectId":"18280"}],"egsCharacterIds":["10459"],"vndbCharacterId":"c36729"},"originalCharacterName":"橘 清見","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悠基の親友と恥ずかしげも無く言い放つ、友達系健康優良少女。"},{"spoiler":false,"text":"いつも明るく笑いながら、態度は常にオーバーアクション。"},{"spoiler":false,"text":"オバケやオカルトが大好きで、いつか見てみたいと思っている。"},{"spoiler":false,"text":"しかし彼女のような健全なる魂には、決して理《コトワリ》を見ることができない。"},{"spoiler":false,"text":"陸上部に所属しているが、あまり早い方ではなくレギュラーを行ったり来たりしている程度。"},{"spoiler":false,"text":"最近身の回りに不可解な事件が起き始めている……。"}],"source":"egs","sourceCharacterId":"10459","sourceWorkId":"15067","spoiler":false},{"segments":[{"spoiler":false,"text":"幽霊に憧れる健康優良少女"},{"spoiler":false,"text":"悠基の親友と恥ずかしげも無く言い放つ、友達系健康優良少女。"},{"spoiler":false,"text":"いつも明るく笑いながら、態度は常にオーバーアクション。"},{"spoiler":false,"text":"オバケやオカルトが大好きで、いつか見てみたいと思っている。"},{"spoiler":false,"text":"しかし彼女のような健全なる魂には、決して “理（コトワリ）” を見ることが出来ない。"},{"spoiler":false,"text":"陸上部に所属しているが、あまり早いほうではなくレギュラーを行ったり来たりしている程度。"},{"spoiler":false,"text":"最近身の回りに不可解な事件が起き始めている……"},{"spoiler":false,"text":"「あたしはいつか見てみたいよ、幽霊。でもそれで辛い人や悲しむ人が出てくるんなら……それはイヤだ」"}],"source":"bangumi","sourceCharacterId":"54507"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9b9ea42805b1cb48307f7af8941033664dc14544f94320320ab440a6182c72f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46bad957b9de9b7e6f8c6aa537bb0011e729f2c0e67b2766aceb4af05d8af143.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18280:54507:5922:1","source":"bangumi"}]},{"characterId":"char_c6152","characterName":"由比ケ浜 悠基","sourceIds":{"bangumi":[{"characterId":"54504","match":"exact-normalized-name-in-linked-work","subjectId":"18280"}],"egsCharacterIds":["10456"],"vndbCharacterId":"c6152"},"originalCharacterName":"由比ケ浜 悠基","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と居る時だけ理《コトワリ》が見えるようになってしまう少女。"},{"spoiler":false,"text":"世話焼きで物怖じしない性格から、初対面の御代にも積極的に関わってきてしまうが、それは理《コトワリ》との関わりを余儀なくされる事と同義であった。"},{"spoiler":false,"text":"スポーツ万能、成績優秀で前向きな性格。"},{"spoiler":false,"text":"普段は怖いもの知らずな言動が目立つが、オバケの類にトラウマがあり大の苦手。"},{"spoiler":false,"text":"今でこそ元気が取柄だが、幼い頃は身体が弱く外に出ることも出来なかった。"},{"spoiler":false,"text":"体の弱かった頃に一度だけオバケを見たとがあったらしいが、本人にはあまり記憶が無い。"}],"source":"egs","sourceCharacterId":"10456","sourceWorkId":"15067","spoiler":false},{"segments":[{"spoiler":false,"text":"亡くなった御代の恩人によく似た少女"},{"spoiler":false,"text":"主人公といる時だけ “理（コトワリ）” が見えるようになってしまう少女。"},{"spoiler":false,"text":"世話焼きで物怖じしない性格から、初対面の御代にも積極的に関わってきてしまうが、それは “理（コトワリ）” との関わりを余儀なくされることと同義であった。"},{"spoiler":false,"text":"スポーツ万能、成績優秀で前向きな性格。"},{"spoiler":false,"text":"普段は怖いもの知らずな言動が目立つが、オバケの類にトラウマがあり大の苦手。"},{"spoiler":false,"text":"今でこそ元気が取柄だが、幼い頃は身体が弱く外に出ることも出来なかった。"},{"spoiler":false,"text":"身体の弱かった頃に一度だけオバケを見たことがあったらしいが、本人にはあまり記憶が無い。"},{"spoiler":false,"text":"「“理（コトワリ）” なんて関係ない！　そんなモノが見えていようといまいと、キミが困っているのに助けないでいられると思う？」"}],"source":"bangumi","sourceCharacterId":"54504"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ebb6139ef70ccaccf4fdfdb0196e4a0ce9491d228165ff0ebf9c9102d9a5c80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc4be73c4deaca68a87b2de0b9fd49837a7337c7de46a8887aa729178e55ab31.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18280:54504:6016:1","source":"bangumi"}]},{"characterId":"char_c6165","characterName":"白妙 あやめ","sourceIds":{"bangumi":[{"characterId":"54505","match":"exact-normalized-name-in-linked-work","subjectId":"18280"}],"egsCharacterIds":["10457"],"vndbCharacterId":"c6165"},"originalCharacterName":"白妙 あやめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつもぶっきらぼうで無表情系。他人を遠ざけるクールな雰囲気の先輩。"},{"spoiler":false,"text":"「仲良くしようとすると鬼に襲われる」という噂があり、自分を「鬼憑き」と呼んで他人に頼ることや、人付き合いを極端に避けている。"},{"spoiler":false,"text":"実際に被害が出ているといわれており、恐ろしがって誰も近寄ろうとはしない。"},{"spoiler":false,"text":"過去に大きな事件に巻き込まれているらしく、そのときの怪我が原因で今でも目を覚まさない弟をずっと一人で看病している。"},{"spoiler":false,"text":"「鬼」が彼女にもたらす現実とは……。"}],"source":"egs","sourceCharacterId":"10457","sourceWorkId":"15067","spoiler":false},{"segments":[{"spoiler":false,"text":"鬼に憑かれ人を遠ざける先輩"},{"spoiler":false,"text":"いつもぶっきらぼうで無表情系。他人を遠ざけるクールな雰囲気の先輩。"},{"spoiler":false,"text":"“仲良くしようとすると鬼に襲われる” という噂があり、自分を “鬼憑き” と呼んで、他人に頼ることや人付き合いを極端に避けている。"},{"spoiler":false,"text":"実際に被害が出ていると言われており、恐ろしがって誰も近寄ろうとはしない。"},{"spoiler":false,"text":"過去に大きな事件に巻き込まれているらしく、その時の怪我が原因で今も目を覚まさない弟をずっと一人で看病している。"},{"spoiler":false,"text":"“鬼” が彼女にもたらす現実とは……。"},{"spoiler":false,"text":"「私は鬼憑き、仲良しゴッコになんて付き合えないわ。わかった？ だったら早く私の前から消えてよ……」"}],"source":"bangumi","sourceCharacterId":"54505"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22d84e9708149242451a0458f693189133e887f9fc8d703917eb57b9774e3e24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f49c05757ecde8b4fe4c69b478898b131184bdea78f34b3d140abf557251c18.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel"