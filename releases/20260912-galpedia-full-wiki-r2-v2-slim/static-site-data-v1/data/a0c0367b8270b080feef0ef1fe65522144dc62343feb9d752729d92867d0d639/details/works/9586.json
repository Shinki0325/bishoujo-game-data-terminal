天才的な腕前を持ち、「自分は世界一だ」という自負心を持っている。とはいえイヤミではなく、明るく豪胆な性格の持ち主。しかし、日常生活においてはかなり不器用。"},{"spoiler":false,"text":"ひとに言えない密かな弱点があり、そのせいで一部の魔法が使えないらしい。"}],"source":"egs","sourceCharacterId":"19659","sourceWorkId":"9586","spoiler":false},{"segments":[{"spoiler":false,"text":"通り名は「烈火のレイラ」（レイラ・ザ・ブレイズ）。剣術、魔術ともに天才的な腕前を持ち、「自分は世界一だ」という自負心を持っている。とはいえイヤミではなく、明るく豪胆な性格の持ち主。しかし、日常生活においてはかなり不器用。"},{"spoiler":false,"text":"ひとに言えない密かな弱点があり、そのせいで一部の魔法が使えないらしい。"}],"source":"bangumi","sourceCharacterId":"209988"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9c43e4c40f2e9ff60f936152622934d99fcfa30a9739303ac5fc33c320ad434.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5c66ce2e0ba46fe6c25587e3d86dc2dd833c295bb21b69aa7bfe92b7af184ac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永野らび","creatorId":"vndb:s7116","sourcePersonId":"vndb:s7116","canonicalEntityId":"vndb:s7116","name":"永野 らび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218637:209988:63096:1","source":"bangumi"}]},{"characterId":"char_c81010","characterName":"ローズ・ド・モルガン","sourceIds":{"bangumi":[{"characterId":"209989","match":"exact-normalized-name-in-linked-work","subjectId":"218637"}],"egsCharacterIds":["19660"],"vndbCharacterId":"c81010"},"originalCharacterName":"ローズ・ド・モルガン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"社交界では「フォセットの白薔薇」と呼ばれている。全教科（芸術も含む）を極めている天才的な頭脳の持ち主。伯爵家の令嬢であり、とても気品がある。ふだんは、恋愛やエッチにはまったく興味がないという顔をしているが、ひそかに強い憧れの気持ちを抱いている。"},{"spoiler":false,"text":"ひとに言えない「恥ずかしい趣味」のコレクションをしており、それをひた隠しにしている。"}],"source":"egs","sourceCharacterId":"19660","sourceWorkId":"9586","spoiler":false},{"segments":[{"spoiler":false,"text":"社交界では「フォセットの白薔薇」と呼ばれている。全教科（芸術も含む）を極めている天才的な頭脳の持ち主。伯爵家の令嬢であり、とても気品がある。ふだんは、恋愛やエッチにはまったく興味がないという顔をしているが、ひそかに○い憧れの気持ちを抱いている。"},{"spoiler":false,"text":"ひとに言えない「恥ずかしい趣味」のコレクションをしており、それをひた隠しにしている。"}],"source":"bangumi","sourceCharacterId":"209989"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6dec4ebbbdb0d3bdf2d5837f82adfcd6ebaab94fb0cfc187320c678adc97ae3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/152e9824c6b72801f459aaa7fea11781a0755850354076a5b70ea43fc7ccfa74.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲良さく","creatorId":"vndb:s7809","sourcePersonId":"vndb:s7809","canonicalEntityId":"vndb:s7809","name":"咲良 さく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218637:209989:92705:1","source":"bangumi"}]},{"characterId":"char_c81011","characterName":"クララ・アンデルソン","sourceIds":{"bangumi":[{"characterId":"209990","match":"exact-normalized-name-in-linked-work","subjectId":"218637"}],"egsCharacterIds":["19661"],"vndbCharacterId":"c81011"},"originalCharacterName":"クララ・アンデルソン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教区司祭（教会に勤めるシスター）だが、密かにバイトで酒場のウェイトレスをしている。"},{"spoiler":false,"text":"気だての良い、天真爛漫な性格。ひとの安らかな顔や、うれしそうな顔を見るのが大好き。教会ではしおらしくマジメにシスターをやっているが、夜になると、酒場のアイドル的存在で、いつもテンション高くはしゃいでいる。酒場のバイトがバレると教会をクビになるのは確実なので、そのことが悩みである。"}],"source":"egs","sourceCharacterId":"19661","sourceWorkId":"9586","spoiler":false},{"segments":[{"spoiler":false,"text":"気だての良い、天真らんまんな性格。ひとの安らかな顔や、うれしそうな顔を見るのが大好き。"},{"spoiler":false,"text":"教会ではしおらしくマジメにシスターをやっているが、夜になると、酒場のアイドル的存在で、いつもテンション高くはしゃいでいる。酒場のバイトがバレると教会をクビになるのは確実なので、そのことが悩みである。"}],"source":"bangumi","sourceCharacterId":"209990"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d4fd7d6b503bb0cd1758464705b18d04545763092de77687e08cd8303d04abf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32143b42e19c3f42e198b590405d8a643f55edf3b765b209cfc5c9c5a8048668.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"廣瀬仁美","creatorId":"vndb:s2330","sourcePersonId":"vndb:s2330","canonicalEntityId":"vndb:s2330","name":"廣瀬 仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218637:209990:6303:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p463","sourceCompanyId":"egs:brand:1375","canonicalEntityId":"vndb:p463","name":"TOMATO","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9586:1375","source":"egs"},{"companyId":"vndb:p463","sourceCompanyId":"vndb:p463","canonicalEntityId":"vndb:p463","name":"Tomato","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2689:v1220","source":"vndb"},{"companyId":"vndb:p463","sourceCompanyId":"vndb:p463","canonicalEntityId":"vndb:p463","name":"Tomato","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:42094:v1220","source":"vndb"},{"companyId":"vndb:p463","sourceCompanyId":"vndb:p463","canonicalEntityId":"vndb:p463","name":"Tomato","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:42095:v1220","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
