vndb:s1701","canonicalEntityId":"vndb:s1701","name":"REIKA","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:46372","source":"vndb"},{"creditedName":"T-Yam","creatorId":"vndb:s7095","sourcePersonId":"vndb:s7095","canonicalEntityId":"vndb:s7095","name":"T-Yam","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46375","source":"vndb"}]},"cast":[{"characterId":"char_c61375","characterName":"益戸 毛 まなみ","sourceIds":{"bangumi":[{"characterId":"147102","match":"exact-normalized-name-in-linked-work","subjectId":"468982"}],"egsCharacterIds":["16022"],"vndbCharacterId":"c61375"},"originalCharacterName":"益戸 毛 まなみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公らが通う現代風学園にやってきた交換留学生。"},{"spoiler":false,"text":"ケモノのような耳と尻尾を持ち、行動様式は犬に似ている女の子。"},{"spoiler":false,"text":"よく鼻をひくひくさせて臭いを嗅いだり、お気に入りの人（特に主人公）に飛びついたり、舐めたりする。"},{"spoiler":false,"text":"全体的にほんわかした雰囲気で、何事にもマイペース。"},{"spoiler":false,"text":"ぼんきゅっぼーんのナイスバディと可愛らしい顔立ちから、学園の男子からの視線を集めるが、主人公に懐き気味なので、その周りにはエッチな視線と敵意の視線が入り混じった複雑な空気が漂っている。"}],"source":"egs","sourceCharacterId":"16022","sourceWorkId":"11718","spoiler":false},{"segments":[{"spoiler":false,"text":"巨乳ケモノ耳娘。名前が普通には発音できないので、それに近いものを適当に当てたそうだが、本人にも良く判っていない。"},{"spoiler":false,"text":"行動様式は犬に似ているが、別に犬から進化したという訳でもないらしい。"},{"spoiler":false,"text":"よく鼻をひくひくさせて臭いを嗅いでおり、飛びついたり舐めたりしては美那緒から文句を言われてしまう。"},{"spoiler":false,"text":"基本的に分け隔てなく人と接し、何事にもマイペースで全体的にほんわかとしている。"}],"source":"bangumi","sourceCharacterId":"147102"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df3f2d1ec8e74f46715a3585665c65507a5a2a5692c5c2e1b921dbc824e675fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6fed84f6e18e2170e4b362c850edde50d9a8ce43809be23af36a2d27af51889.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:468982:147102:6106:1","source":"bangumi"}]},{"characterId":"char_c61376","characterName":"木城院 美那緒","sourceIds":{"bangumi":[{"characterId":"147103","match":"exact-normalized-name-in-linked-work","subjectId":"468982"}],"egsCharacterIds":["16023"],"vndbCharacterId":"c61376"},"originalCharacterName":"木城院 美那緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。クラス委員長。"},{"spoiler":false,"text":"華奢で小さく、ぺったんな外見とは違った古めかしい言葉遣いとキツイ性格の、天上天下唯我独尊を地でいく女の子。"},{"spoiler":false,"text":"ジェット噴射のような毒舌がトレードマーク。"},{"spoiler":false,"text":"そんな小さなテロリストのような彼女に、誰も逆らえない。"},{"spoiler":false,"text":"幼馴染の主人公は、完全に下僕扱いされ、彼女自身は主人公がそうであることを当然と思っている。"},{"spoiler":false,"text":"自分の下僕である主人公が闖入者である留学生とほんわかしているのがお気に召さないらしく、得意の毒舌と突っ込みが激しさを増している。"}],"source":"egs","sourceCharacterId":"16023","sourceWorkId":"11718","spoiler":false},{"segments":[{"spoiler":false,"text":"ちいさい、ぺたん、ほそい、華奢。"},{"spoiler":false,"text":"外見とは大違いの古めかしい言葉使いときつい性格で、初対面の相手からも絶対に忘れられない。"},{"spoiler":false,"text":"毒舌が口からジェット噴射のように飛び出すが、誰もそれには逆らえない。天上天下唯我独尊を地でいく。"},{"spoiler":false,"text":"まなみと向洋がほんわかしているのが、大変お気に召さないらしい。"}],"source":"bangumi","sourceCharacterId":"147103"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f83f3445b0714427ef40be7609b33eb7895d3eac513ede53d37a3e77be5fe69d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/