{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"39928","model":{"presentationWorkId":"vndb:v54131","staff":{"artwork":[],"scenario":[],"music":[{"creditedName":"YHU","creatorId":"vndb:s43739","sourcePersonId":"vndb:s43739","canonicalEntityId":"vndb:s43739","name":"YHU","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:212917","source":"vndb"}],"other":[{"creditedName":"ぎどら","creatorId":"vndb:s41575","sourcePersonId":"vndb:s41575","canonicalEntityId":"vndb:s41575","name":"ぎどら","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:212916","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c147268","characterName":"氷室 ショウ","sourceIds":{"vndbCharacterId":"c147268"},"originalCharacterName":"氷室 ショウ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The troubled, ordinary young man who's also a gang member."},{"spoiler":false,"text":"Unable to resist the expectations placed on him, he's burdened with the traditions and prestige of the gang, reluctantly walking the path of the yakuza as the young acting leader of the declining Hakurou-gumi."},{"spoiler":false,"text":"Caught between his strict older sister and a selfish younger one, he has difficulty voicing his true feelings."},{"spoiler":false,"text":"His only wish is to have a peaceful, mundane life."},{"spoiler":false,"text":"Part of Hakurou-gumi"},{"spoiler":false,"text":"Modified from Steam page"}],"source":"vndb","sourceCharacterId":"c147268"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec399b862d2754a7fc81f0a689ef1dede86a1d32ed29c06dd76be