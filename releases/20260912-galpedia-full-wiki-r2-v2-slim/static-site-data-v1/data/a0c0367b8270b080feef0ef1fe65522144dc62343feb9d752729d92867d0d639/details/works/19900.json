:213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"囲 まこと","creatorId":"vndb:s11331","sourcePersonId":"vndb:s11331","canonicalEntityId":"vndb:s11331","name":"囲 まこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63326","source":"vndb"}]},{"characterId":"char_c118794","characterName":"伊早 直樹","sourceIds":{"bangumi":[],"egsCharacterIds":["5744"],"vndbCharacterId":"c118794"},"originalCharacterName":"伊早 直樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"歴史やミリタリー、動物、プロレス、社会情勢など豊富な知識を持っているが、全てゲームで培ったもの。"},{"spoiler":false,"text":"どんなゲームもひと通りプレイしているが一番好きなのはエロゲ。"}],"source":"egs","sourceCharacterId":"5744","sourceWorkId":"19900","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c29805","characterName":"九條 真","sourceIds":{"bangumi":[{"characterId":"141218","match":"exact-normalized-name-in-linked-work","subjectId":"126138"}],"egsCharacterIds":["5738"],"vndbCharacterId":"c29805"},"originalCharacterName":"九條 真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"503"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"暴力的な生徒会会長にして、護憲派リーダー。"},{"spoiler":false,"text":"正義感が強いが、すぐに手が出るのが玉に瑕。"},{"spoiler":false,"text":"憲法九条は世界に誇れる思想で、人類の理想だと信じている。"}],"source":"egs","sourceCharacterId":"5738","sourceWorkId":"19900","spoiler":false},{"segments":[{"spoiler":false,"text":"誕生日：5月3日（憲法記念日）　　趣味：スポーツ観戦"},{"spoiler":false,"text":"学園を仕切る番長……ではなく、生徒会会長にして護憲派のリーダー。"},{"spoiler":false,"text":"護憲派でありながら○○的であり、ひとたび逆鱗に触れると鍛えぬかれた左腕が首元を鋭く打ち抜き意識を奪う。"},{"spoiler":false,"text":"付いたあだ名は “おっぱい番長”、“ショベル九條”。 得意技は卍固めとウエスタンラリアート。"},{"spoiler":false,"text":"生徒会の会長として、面倒見の良さと誠実な人柄から学生・教師ともに人望は厚い。"},{"spoiler":false,"text":"口癖である “専守防衛” の通り、基本的には守るためにしか○○を振るわないが、必要最低限度の○○かどうかは分からない。"},{"spoiler":false,"text":"そんな彼女には、決して人には話せない大きな秘密があった………。"},{"spoiler":false,"text":"【主張】"},{"spoiler":false,"text":"戦争するぐらいなら無抵抗で平和を訴えて 「笑って死ぬ」 と主張。"},{"spoiler":false,"text":"憲法九条は世界に誇れる思想で、人類の理想だと信じている。"}],"source":"bangumi","sourceCharacterId":"141218"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19df538758175cbc322ee97eded5749d530ab5702f4937913634e417088b6d83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c987a685ee0f023de35927225faad37d6b9273c0033dd4cc4336747de15d6ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城ほのか","creatorId":"vndb:s6018","sourcePersonId":"vndb:s6018","canonicalEntityId":"vndb:s6018","name":"結城 ほのか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126138:141218:20256:1","source":"bangumi"}]},{"characterId":"char_c29806","characterName":"大前 唯南","sourceIds":{"bangumi":[{"characterId":"141219","match":"exact-normalized-name-in-linked-work","subjectId":"126138"}],"egsCharacterIds":["5739"],"vndbCharacterId":"c29806"},"originalCharacterName":"大前 唯南","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"505"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大前夕菜の双子の姉で、護憲派の参謀的ポジション。"},{"spoiler":false,"text":"男女同権を訴えるフェミニストにして、妹を溺愛するシスコンでもある。"},{"spoiler":false,"text":"毒舌家。"}],"source":"egs","sourceCharacterId":"5739","sourceWorkId":"19900","spoiler":false},{"segments":[{"spoiler":false,"text":"誕生日：5月5日（○○の日）　　趣味：料理"},{"spoiler":false,"text":"夕菜の双子の姉で、護憲派の参謀的ポジション。 男女同権を訴えるフェミニスト。"},{"spoiler":false,"text":"彼女にとって、すべての人間は “女” か “そうじゃない” かの 2つに分けられる。"},{"spoiler":false,"text":"元始、女性は太陽であったとされているが、彼女に言わせれば今も昔も太陽である。"},{"spoiler":false,"text":"そして男のことは宇宙ゴミくらいに思っており、男に媚びへつらう女はバカだと見下している。"},{"spoiler":false,"text":"そんな彼女が愛している人間は、妹の夕菜だけ。"},{"spoiler":false,"text":"【主張】"},{"spoiler":false,"text":"“人権” を守るということに重きを置き、あらゆる人権を蹂躙する戦争を否定。"},{"spoiler":false,"text":"老子の 「兵は不祥の器にして、君子の器にあらず」 を信じている。"}],"source":"bangumi","sourceCharacterId":"141219"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43462d47e0d5498d5534a7734c955381f99f540245416ab3dd43b1f753dd3aa2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/799108c68cd92b602eedcd4c1f3515e37d602d70abc1db51ecfbf73028efe2bb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅宮ここ","creatorId":"vndb:s8768","sourcePersonId":"vndb:s8768","canonicalEntityId":"vndb:s8768","name":"梅宮 ここ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126138:141219:37729:1","source":"bangumi"}]},{"characterId":"char_c29807","characterName":"大前 夕菜","sourceIds":{"bangumi":[{"characterId":"141220","match":"exact-normalized-name-in-linked-work","subjectId":"126138"}],"egsCharacterIds":["5740"],"vndbCharacterId":"c29807"},"originalCharacterName":"大前 夕菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"505"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大前唯南の双子の妹にして、護憲派のマスコット。"},{"spoiler":false,"text":"元気で人懐っこい性格で、動物が大好き。"},{"spoiler":false,"text":"家ではたくさんの動物たちと暮らしている。"}],"source":"egs","sourceCharacterId":"5740","sourceWorkId":"19900","spoiler":false},{"segments":[{"spoiler":false,"text":"誕生日：5月5日（○○の日）　　趣味：動物飼育"},{"spoiler":false,"text":"唯南の双子の妹にして、護憲派のマスコット。"},{"spoiler":false,"text":"姉の唯南とは対照的に、元気で人懐っこい性格をしている。 ちょっぴりアホの子。"},{"spoiler":false,"text":"動物が大好きで、捨てられた動物を見つけては手厚く保護して可愛がっている。"},{"spoiler":false,"text":"また完全菜食主義者で動物性食品を一切摂らず、また食用以外の動物の利用も避けている。"},{"spoiler":false,"text":"心優しい彼女だが、剣鋒学園の職員会議で一番名前が挙げられる超問題児。"},{"spoiler":false,"text":"動物を学園に連れてきては脱走させるため、職員会議ではしばしば “猛禽類やげっ歯類の対応について” という議論がなされている。"},{"spoiler":false,"text":"【主張】"},{"spoiler":false,"text":"戦争によって無抵抗の動物たちが殺されることを心配している。"},{"spoiler":false,"text":"争いなんて虚しいだけだと主張する。"}],"source":"bangumi","sourceCharacterId":"141220"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22804e0269a380dc438ba78788a4734d40264ea8cd26ab2e60463eaf9a1ddafb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdb9d3894fc9442a1c36323d3353db308aa94fb0dbce9c50995c8f3df1704b56.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七瀬あかり","creatorId":"vndb:s8769","sourcePersonId":"vndb:s8769","canonicalEntityId":"vndb:s8769","name":"七瀬 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126138:141220:25290:1","source":"bangumi"}]},{"characterId":"char_c29808","characterName":"大和 永遠","sourceIds":{"bangumi":[{"characterId":"141221","match":"exact-normalized-name-in-linked-work","subjectId":"126138"}],"egsCharacterIds":["5735"],"vndbCharacterId":"c29808"},"originalCharacterName":"大和 永遠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"211"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大財閥のご令嬢にしてクラス委員長を務める改憲派のリーダー。"},{"spoiler":false,"text":"生徒会選挙で負けて以降、九條真をライバル視している。"},{"spoiler":false,"text":"戦争は人類の本能……戦争は治療法のない病気のようなもの。"},{"spoiler":false,"text":"それを肯定して正しく対応していきたいと考えている。"}],"source":"egs","sourceCharacterId":"5735","sourceWorkId":"19900","spoiler":false},{"segments":[{"spoiler":false,"text":"誕生日：2月11日（建国記念日）　　趣味：絵画"},{"spoiler":false,"text":"大財閥のご令嬢にしてクラス委員長を務める、改憲派のリーダー。"},{"spoiler":false,"text":"持って生まれた美貌と権力で常に勝利者として歩み続けてきたが、生徒会長を決める選挙でまさかの落選。"},{"spoiler":false,"text":"以来、自分に膝をつかせた存在として九條真をライバル視している。"},{"spoiler":false,"text":"今回のディベートでは、最高の舞台で雪辱戦ができると意気込んでいる。"},{"spoiler":false,"text":"ちなみに、春野桜子は唯一無二の親友。"},{"spoiler":false,"text":"【主張】"},{"spoiler":false,"text":"戦争は人類の本能…… 戦争は治療法の無い病気のようなもの。"},{"spoiler":false,"text":"それを肯定して正しく対応していきたいと考えている。"}],"source":"bangumi","sourceCharacterId":"141221"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10f5c5d5332f7d7f575adb9293619056358f3693fbcaf197e16cb6d4af446b6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5c310a55303f8da992fdfb65694affac157215539ac9f84509f64e22615d984.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加賀美こころ","creatorId":"vndb:s6019","sourcePersonId":"vndb:s6019","canonicalEntityId":"vndb:s6019","name":"加賀美 こころ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126138:141221:19374:1","source":"bangumi"}]},{"characterId":"char_c29809","characterName":"春野 桜子","sourceIds":{"bangumi":[{"characterId":"141222","match":"exact-normalized-name-in-linked-work","subjectId":"126138"}],"egsCharacterIds":["5736"],"vndbCharacterId":"c29809"},"originalCharacterName":"春野 桜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1103"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"改憲派の参謀にして、大和永遠の腹心。"},{"spoiler":false,"text":"歴史好きで、地歴部でコラムや歴史小説を執筆している。"},{"spoiler":false,"text":"好きな人物は斎藤道三、丹羽長秀、伊達政宗などなど。"}],"source":"egs","sourceCharacterId":"5736","sourceWorkId":"19900","spoiler":false},{"segments":[{"spoiler":false,"text":"誕生日：11月3日（文化の日）　　趣味：城めぐり、読書"},{"spoiler":false,"text":"改憲派の参謀にして、大和永遠の腹心。"},{"spoiler":false,"text":"歴史への造詣が深く、所属する地歴部では史跡探訪のコラムや歴史小説を連載するなど、歴女としての一面を持つ。"},{"spoiler":false,"text":"特に日本の戦国時代・幕末、中国の春秋戦国時代・三国時代を好む。"},{"spoiler":false,"text":"家柄が厳しいせいでゲームやマンガに疎く、歴史の知識は小説から得たものばかり。"},{"spoiler":false,"text":"そんな彼女は “実像と史実によって作り上げられた人物像に大きな差があったとしても、それは神格化と同じで、その人物の偉業の一つとして捉えるべきだ” という独自の解釈を持っている。"},{"spoiler":false,"text":"それゆえに、イケメン化される武将も許容している。"},{"spoiler":false,"text":"【主張】"},{"spoiler":false,"text":"孫子曰く 「兵は国の大事にして、死生の地、存亡の地なり。 察せざるべからず」"},{"spoiler":false,"text":"人類の歴史を見ても戦争を無くすことは出来ず、戦争放棄という選択肢はありえない。"}],"source":"bangumi","sourceCharacterId":"141222"}],"profileFacts":[],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1103","source":"vndb","sourceCharacterId":"c29809","value":"1103"},{"comparisonValue":"1103","source":"egs","sourceCharacterId":"5736","value":"11/3"},{"comparisonValue":"0113","source":"bangumi","sourceCharacterId":"141222","value":"11月3日（文化の日）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb1f47d8f4bbf7ddcd6319ab7f0519785b7e4068ce06b483f2a2ba2d69b04aa3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a29e696309583f7f320687b43a453437d287c73540211412b8a048ca033f64b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹星 ゆうひ","creatorId":"vndb:s30366","sourcePersonId":"vndb:s30366","canonicalEntityId":"vndb:s30366","name":"芹星 ゆうひ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63328","source":"vndb"}]},{"characterId":"char_c29810","characterName":"鬼川 萌奈","sourceIds":{"bangumi":[{"characterId":"141223","match":"exact-normalized-name-in-linked-work","subjectId":"126138"}],"egsCharacterIds":["5737"],"vndbCharacterId":"c29810"},"originalCharacterName":"鬼川 萌奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1208"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"改憲派の自称軍事顧問にして、ネットで軍備拡張を訴えるメガネっ娘。"},{"spoiler":false,"text":"普段はおどおどして引っ込み思案な彼女だが、ミリタリーを語り始めると止まらない。"},{"spoiler":false,"text":"ミリタリー好きの観点から、憲法9条を改正すべきと主張。"}],"source":"egs","sourceCharacterId":"5737","sourceWorkId":"19900","spoiler":false},{"segments":[{"spoiler":false,"text":"誕生日：12月8日（開戦記念日）　　趣味：模型作り"},{"spoiler":false,"text":"改憲派の自称 “軍事顧問” にして、ネットで軍備拡張を訴えるメガネっ娘。"},{"spoiler":false,"text":"普段はオドオドして引っ込み思案な彼女だが、ミリタリーを語り始めると止まらない。"},{"spoiler":false,"text":"好きな戦車は “メルカバ”、“M4シャーマン”、“ヤークトティーガー”。"},{"spoiler":false,"text":"“メルカバ” は、イスラエルの軍事情勢をそのまま設計思想に盛り込み、人命を優先するためにエンジンを前方に配置し後方に出入り可能なハッチを取り付け、負傷兵の輸送も可能にしている思慮の深さに感銘を受けている。同様に “M4シャーマン” はアメリカの物量主義と合理性が如実に現れているところが良いらしい。 “ヤークトティーガー” はWW2中、実戦配備された最重量戦車で128mm……（以下略）"},{"spoiler":false,"text":"【主張】"},{"spoiler":false,"text":"ミリタリー好きの観点から、憲法九条を改正すべきと主張。"},{"spoiler":false,"text":"軍事力が抑止力をもたらし、結果的に平和の状態が続くと断言。"}],"source":"bangumi","sourceCharacterId":"141223"}],"profileFacts":[],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1208","source":"vndb","sourceCharacterId":"c29810","value":"1208"},{"comparisonValue":"1208","source":"egs","sourceCharacterId":"5737","value":"12/8"},{"comparisonValue":"0128","source":"bangumi","sourceCharacterId":"141223","value":"12月8日（開戦記念日）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f1e69a1e5d02a4a44ad0f5952db2cf183198015cc870dea48fdff890afa8d98.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/674071eb3d5a75c3f1fc6300d8acb998434236120f81d26e26730c56de5eb181.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"湯宮由海","creatorId":"vndb:s5006","sourcePersonId":"vndb:s5006","canonicalEntityId":"vndb:s5006","name":"湯宮 由海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126138:141223:19558:1","source":"bangumi"}]},{"characterId":"char_c29811","characterName":"古緋 心愛","sourceIds":{"bangumi":[{"characterId":"141224","match":"exact-normalized-name-in-linked-work","subjectId":"126138"}],"egsCharacterIds":["5741"],"vndbCharacterId":"c29811"},"originalCharacterName":"古緋 心愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"815"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"剣鋒学園の影の権力者であり、一番のトラブルメーカーな担任教師。"},{"spoiler":false,"text":"名門古緋一族の本家の末娘であり、自由奔放でわがまま。"}],"source":"egs","sourceCharacterId":"5741","sourceWorkId":"19900","spoiler":false},{"segments":[{"spoiler":false,"text":"誕生日：8月15日（終戦記念日）　　趣味：婚活"},{"spoiler":false,"text":"剣鋒学園の影の権力者であり、一番のトラブルメーカーな担任教師。"},{"spoiler":false,"text":"その生まれは名門・古緋一族の本家の末娘であり、育てられ方に問題があったのか、自由奔放でワガママ。"},{"spoiler":false,"text":"“学生をオモチャくらいにしか思っていない” というのが周りの評価で、実際に不機嫌な時は学生たちに無茶ぶりして楽しんでいる。"},{"spoiler":false,"text":"そろそろ結婚して家庭に入りたいが性格と家柄のせいで相手は見つからず、せっせと婚活パーティーに参加している。"},{"spoiler":false,"text":"そして、そんな彼女にはもう一つの裏の顔があるのだが……。"}],"source":"bangumi","sourceCharacterId":"141224"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/146aafb51fbdfcae14e56fb19f539d395c7efb5fc5f43217966a0e23f4a07bee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/chara