lse},{"segments":[{"spoiler":false,"text":"満花と徹の母親。"},{"spoiler":false,"text":"早くに旦那を亡くし、女手ひとつで二人を育ててきた肝っ玉母ちゃん。"},{"spoiler":false,"text":"性格に反して外見は美しく、歳を感じさせない美貌で村のジイ様たちからアイドル扱いを受けている。"}],"source":"bangumi","sourceCharacterId":"22453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4df3db220accf599a4b32f7f05f1ae33c7701c95423c42cfa9f52fb0b8e7eaae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e19bb84e21f03fc4ef684893fb111d580068aef7edbf83028af252c5db94b2af.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c48266","characterName":"丸山 沙緒里","sourceIds":{"bangumi":[{"characterId":"149432","match":"exact-normalized-name-in-linked-work","subjectId":"228939"}],"egsCharacterIds":["17747"],"vndbCharacterId":"c48266"},"originalCharacterName":"丸山 沙緒里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"徹の婚約者。婚約報告をしに田舎に帰省した徹の帰りを心待ちにしている。"},{"spoiler":false,"text":"年上の女性で、徹の勤める会社の先輩でもある。付き合いだしてから２年が経過。"},{"spoiler":false,"text":"平素、クールではっきり物を言う性格だが、反面、面倒見もよく心配性で、徹が風邪を引いた時など、傍で看病してくれたりもした、母性豊かなキャリアウーマン。"},{"spoiler":false,"text":"以前、付き合っていた彼氏との初体験でヒドイ扱いをされて、一時、男性恐怖症に。"}],"source":"egs","sourceCharacterId":"17747","sourceWorkId":"25905","spoiler":false},{"segments":[{"spoiler":false,"text":"徹の婚約者。"},{"spoiler":false,"text":"婚約報告をしに田舎に帰省した徹の帰りを心待ちにしている。"},{"spoiler":false,"text":"年上の女性で、徹の勤める会社の先輩でもある。"},{"spoiler":false,"text":"付き合いだしてから2年が経過。"},{"spoiler":false,"text":"平素、クールではっきり物を言う性格だが、反面、面倒見もよく心配性で、"},{"spoiler":false,"text":"徹が風邪を引いた時など、傍で看病してくれたりもした、母性豊かなキャリアウーマン。"},{"spoiler":false,"text":"以前、付き合っていた彼氏との初体験でヒドイ扱いをされて、一時、男性恐怖症に。"}],"source":"bangumi","sourceCharacterId":"149432"}],"profileFacts":[],"meta