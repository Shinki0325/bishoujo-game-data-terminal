5704"],"vndbCharacterId":"c865"},"originalCharacterName":"絢音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayane is the protagonist's wife. She works as a manager of a restaurant. While she was working as a part time waitress, the restaurant where she worked at noticed how she attracts guests into the restaurant. That's how she became the manager at her young age of 20. However, she has no knowledge of how to manage a restaurant, so the business is in trouble. The restaurant's parent company is taking it seriously too. She can't sit still, and she has a tendency not to think about things too much."},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c865"},{"segments":[{"spoiler":false,"text":"主人公の細君。"},{"spoiler":false,"text":"ラブラブの結婚一年目。"},{"spoiler":false,"text":"ファミレス店のバイトをしてるときに、その美貌から尋常ではない集客力を記録したことから、20歳の若さで店長に抜擢された。"},{"spoiler":false,"text":"しかし、経営能力がからっきしだったことから、店は赤字経営になり、本社は頭を抱えている。"},{"spoiler":false,"text":"落ち着きがない性格で、普段から何も考えていない、そんな感じの女性だ。"}],"source":"egs","sourceCharacterId":"25704","sourceWorkId":"7336","spoiler":false},{"segments":[{"spoiler":false,"text":"紘一の妻。"},{"spoiler":false,"text":"ファミレスチェーン店の店長。 ウェイトレスのバイトをしていたとき、尋常ではない集客力に目をつけられて若干20歳で店長に抜擢された。 しかし経営感覚がまるで備わっておらず、あっさり赤字経営に。 本社の方でも問題になっているらしい。 落ち着きがなく、普段から何も考えていないタイプ。"}],"source":"bangumi","sourceCharacterId":"204675"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/471408ed59aa6c44356eab8bc5a34ca53946486102a0a1f8ad728a77c80efe27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c5c6aca607189afd3a69f7b2ffffa5ea68039a2cd9c20a811384acd4ca5b627.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:539273:204675:18086:1","source":"bangumi"}]},{"characterId":"char_c866","characterName":"真絢","sourceIds":{"bangumi":[{"characterId":"204676","match":"exact-normalized-name-in-linked-work","subjectId":"539273"}],"egsCharacterIds":["25705"],"vndbCharacterId":"c866"},"originalCharacterName":"真絢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Maaya is Ayane's younger sister. She is a college student. She and the protagonist used to be classmates back in the day. She is very innocent and can be taken advantage of very easily. She tries to hide her personality of being influenced easily by being rough, but it isn't working too well. She has a complex about her small breasts and her wavy hair and often compares herself with her sister. She works as a waitress at the restaurant that Ayane manages."},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c866"},{"segments":[{"spoiler":false,"text":"主人公の妻である絢音の妹。"},{"spoiler":false,"text":"主人公の高校時代の同級生で、現在は女子大生。"},{"spoiler":false,"text":"姉が店長をしているファミレス店でウェイトレスのバイトをしている。"},{"spoiler":false,"text":"お人好しな性格で、何かと流されやすく、そうした欠点を粗暴な性格を装ってごまかそうとしているが、あまり効果はあがっていない。"},{"spoiler":false,"text":"類稀な美貌を持つ姉に劣等感を持っているようだが……。"}],"source":"egs","sourceCharacterId":"25705","sourceWorkId":"7336","spoiler":false},{"segments":[{"spoiler":false,"text":"絢音の妹。"},{"spoiler":false,"text":"大学生。主人公と高校時代、同級生だった。 ダマされやすく乗せられやすいお人好し。 雰囲気に飲まれやすいのを、粗暴な性格を装ってごまかそうとしている。 が、あまりうまく行ってない。 くせっ毛や胸の小ささを気にしていて、なにかにつけては姉と比較してしまい、劣等感にさいなまれている。 絢音のつとめる店で、ウェイトレスのアルバイトをしている。"}],"source":"bangumi","sourceCharacterId":"204676