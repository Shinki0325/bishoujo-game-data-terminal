":false},{"segments":[{"spoiler":false,"text":"コンチェルト１のメインヒロイン。"},{"spoiler":false,"text":"明るく真面目で芯の強い優等生。"},{"spoiler":false,"text":"常に前向きで明るく、皆とも仲がいい。"},{"spoiler":false,"text":"ただ、責任感が強すぎるせいで人に頼るということが苦手だったが、俊太郎という幼馴染と共に戦うことで少し緩和されてきている。"}],"source":"egs","sourceCharacterId":"24684","sourceWorkId":"39102","spoiler":false},{"segments":[{"spoiler":false,"text":"「コンチェルト１」のメインヒロイン。"},{"spoiler":false,"text":"明るく真面目で芯の強い優等生。"},{"spoiler":false,"text":"常に前向きで明るく、皆とも仲がいい。"},{"spoiler":false,"text":"ただ、責任感が強すぎるせいで、人に頼るということが苦手。"},{"spoiler":false,"text":"俊太郎という幼馴染が居る。"},{"spoiler":false,"text":"エクスティア・イグニスに変身し、ギルツシードを回収するために戦う。"}],"source":"bangumi","sourceCharacterId":"134640"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a9325d349f26f417f264d44e56b34dddbe3e1bc07e85ed0121c62e9dc084659.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffc1259ad7dba762725c488da1943369300181a3891b492d7458bdc740afabf0.webp","width":151,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花月さや","creatorId":"vndb:s23345","sourcePersonId":"vndb:s23345","canonicalEntityId":"vndb:s23345","name":"花月さや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:581488:134640:40638:1","source":"bangumi"}]},{"characterId":"char_c129437","characterName":"エクスティア・ルーナ","sourceIds":{"bangumi":[{"characterId":"134431","match":"exact-normalized-name-in-linked-work","subjectId":"444272"},{"characterId":"134431","match":"exact-normalized-name-in-linked-work","subjectId":"581488"}],"egsCharacterIds":["24693"],"vndbCharacterId":"c129437"},"originalCharacterName":"エクスティア・ルーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main protagonist of \"Kouyoku Senki ExS-Tia Concerto 2\""},{"spoiler":false,"text":"A mysterious girl who is always alone. She appears to be the cool type and doesn't say much."},{"spoiler":false,"text":"She has a younger sister, whom she cherishes more than anything else."},{"spoiler":false,"text":"She didn't have much confidence in herself, but through her fight with Haruno, she has had more opportunities to show her true compassion."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c129437"},{"segments":[{"spoiler":false,"text":"「コンチェルト２」のメインヒロイン。"},{"spoiler":false,"text":"いつも一人で居るミステリアスな少女。"},{"spoiler":false,"text":"クール系に見える。口数は少なめ。"},{"spoiler":false,"text":"妹がおり、何よりも、誰よりも大切に思っている。"},{"spoiler":false,"text":"あまり自分に自信がない。"},{"spoiler":false,"text":"エクスティア・ルーナに変身し、春乃とは別の筋でギルツシードを回収するために戦っている。"}],"source":"egs","sourceCharacterId":"24693","sourceWorkId":"34384","spoiler":false},{"segments":[{"spoiler":false,"text":"コンチェルト２のメインヒロイン。"},{"spoiler":false,"text":"いつも一人で居るミステリアスな少女。"},{"spoiler":false,"text":"クール系に見え、口数も少なめ。"},{"spoiler":false,"text":"妹がおり、何よりも、誰よりも大切に思っている。"},{"spoiler":false,"text":"あまり自分に自信がなかったが、春乃との闘いを通じて本来の思いやりを発揮する機会が増えている。"}],"source":"egs","sourceCharacterId":"24693","sourceWorkId":"39102","spoiler":false},{"segments":[{"spoiler":false,"text":"「コンチェルト２」のメインヒロイン。"},{"spoiler":false,"text":"いつも一人で居るミステリアスな少女。"},{"spoiler":false,"text":"クール系に見える。口数は少なめ。"},{"spoiler":false,"text":"妹がおり、何よりも、誰よりも大切に思っている。"},{"spoiler":false,"text":"あまり自分に自信がない。"},{"spoiler":false,"text":"エクスティア・ルーナに変身し、"},{"spoiler":false,"text":"春乃とは別の筋でギルツシードを回収するために戦っている。"}],"source":"bangumi","sourceCharacterId":"134431"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c82f5beafa1a02f79042cd51618cbbad713c0bc45a906cbea16e1610d37c66ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48b6aaf394ddf178a33d364abf3319208fcd67e42fe355eca30b7bbbdc77a93d.webp","width":151,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:581488:134431:5936:1","source":"bangumi"}]},{"characterId":"char_c138835","characterName":"エクスティア・アクア","sourceIds":{"bangumi":[{"characterId":"183071","match":"exact-normalized-name-in-linked-work","subjectId":"504993"},{"characterId":"183071","match":"exact-normalized-name-in-linked-work","subjectId":"581488"}],"egsCharacterIds":["26071"],"vndbCharacterId":"c138835"},"originalCharacterName":"エクスティア・アクア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main protagonist of \"Kouyoku Senki ExS-Tia Concerto 4\""},{"spoiler":false,"text":"An introverted and quiet girl. She's smart and surprisingly strong-willed. And when she believes in something, she puts her heart into it."},{"spoiler":false,"text":"She's not very sociable and was bullied as a child, but Kanon saved her and they have been best friends ever since."},{"spoiler":false,"text":"She feels like Kanon is the only friend she has, and aware that she is a little too dependent on her, so she thinks it would be better if she distance herself from her best friend."},{"spoiler":false,"text":"However, she discovers that she has high PP abilities, and in order to change herself, she cooperates with Ichika and became an ExS-TIA."},{"spoiler":false,"text":"Translated from Official Site"},{"spoiler":true,"text":"Later revealed that she has romantic feelings for her best friend, Oosumi Kanon"}],"source":"vndb","sourceCharacterId":"c138835"},{"segments":[{"spoiler":false,"text":"内向的でおとなしい子。頭がいい。"},{"spoiler":false,"text":"意外と芯は強く、思い込んだら一途な面がある。"},{"spoiler":false,"text":"あまり社交的ではないことから幼少期にいじめられたことがあるが、その時に夏音に助けられて以来親友として接している。"},{"spoiler":false,"text":"というかある意味夏音しか友達が居ないみたいな感じになっている。"},{"spoiler":false,"text":"ちょっと依存度が高いことを千秋自身も自覚し、少し距離をおいたほうがいいと思っている。"},{"spoiler":false,"text":"そんな中でＰＰ能力が高いことが発覚して、自分を変える為にも一花に協力することになる。"}],"source":"egs","sourceCharacterId":"26071","sourceWorkId":"36360","spoiler":false},{"segments":[{"spoiler":false,"text":"コンチェルト４のメインヒロイン。"},{"spoiler":false,"text":"内向的でおとなしい子。頭がいい。"},{"spoiler":false,"text":"意外と芯は強く、思い込んだら一途な面がある。"},{"spoiler":false,"text":"あまり社交的ではないことから幼少期にいじめられたことがあるが、その時に夏音に助けられて以来親友として接している。"},{"spoiler":false,"text":"というかある意味夏音しか友達が居ないみたいな感じになっている。"},{"spoiler":false,"text":"ちょっと依存度が高いことを千秋自身も自覚したが、それに対して素直になったことで夏音とはいい仲になっている。"}],"source":"egs","sourceCharacterId":"26071","sourceWorkId":"39102","spoiler":false},{"segments":[{"spoiler":false,"text":"内向的でおとなしい子。頭がいい。"},{"spoiler":false,"text":"意外と芯は強く、思い込んだら一途な面がある。"},{"spoiler":false,"text":"あまり社交的ではないことから幼少期にいじめられたことがあるが、"},{"spoiler":false,"text":"その時に夏音に助けられて以来親友として接している。"},{"spoiler":false,"text":"というかある意味夏音しか友達が居ないみたいな感じになっている。"},{"spoiler":false,"text":"ちょっと依存度が高いことを千秋自身も自覚し、"},{"spoiler":false,"text":"少し距離をおいたほうがいいと思っている。"},{"spoiler":false,"text":"そんな中でＰＰ能力が高いことが発覚して、"},{"spoiler":false,"text":"自分を変える為にも一花に協力することになる。"}],"source":"bangumi","sourceCharacterId":"183071"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d6f7ea263d53494a1cb244c405501fe360efc0e1e6527b5994a349bd1dacf7c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18cc5f3542c6e5fa492ed1aa1e1b15a17bf2507b91316c47061d6836db94edc5.webp","width":151,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤月ゆむ","creatorId":"vndb:s8643","sourcePersonId":"vndb:s8643","canonicalEntityId":"vndb:s8643","name":"赤月 ゆむ","