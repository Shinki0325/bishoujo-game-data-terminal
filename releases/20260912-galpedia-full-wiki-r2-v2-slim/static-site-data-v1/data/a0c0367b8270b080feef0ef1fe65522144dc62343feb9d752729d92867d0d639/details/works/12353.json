{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12353","model":{"presentationWorkId":"vndb:v3073","staff":{"artwork":[{"creditedName":"置弓枷","creatorId":"vndb:s3561","sourcePersonId":"egs:creator:3501","canonicalEntityId":"vndb:s3561","name":"置弓枷","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:76786","source":"egs"}],"scenario":[{"creditedName":"関口辰巳","creatorId":"vndb:s9965","sourcePersonId":"egs:creator:13795","canonicalEntityId":"vndb:s9965","name":"関口辰巳","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:76787","source":"egs"}],"music":[{"creditedName":"スタディオノーマライズ","creatorId":"vndb:s6568","sourcePersonId":"vndb:s6568","canonicalEntityId":"vndb:s6568","name":"有限会社ノーマライズ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:40230","source":"vndb"}],"other":[]},"cast":[{"characterId":"char_c57964","characterName":"西園寺 燐","sourceIds":{"bangumi":[{"characterId":"22210","match":"exact-normalized-name-in-linked-work","subjectId":"89517"}],"egsCharacterIds":["15433"],"vndbCharacterId":"c57964"},"originalCharacterName":"西園寺 燐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"バイオリンを専攻する学生。"},{"spoiler":false,"text":"優等生。バイオリンの演奏も非常に秀でている。"},{"spoiler":false,"text":"性格は、非常に我儘で生意気。"},{"spoiler":false,"text":"主人公を小馬鹿にして、授業をまともに聞かない。"},{"spoiler":false,"text":"優秀であるが故に、非常に扱い難く、その学生らしくない態度を注意したくともなかなか叱ることが出来ない。"},{"spoiler":false,"text":"今期末に大きなコンクールがあり、それに向けて猛練習を重ねている。"}],"source":"egs","sourceCharacterId":"15433","sourceWorkId":"12353","spoiler":false},{"segments":[{"spoiler":false,"text":"バイオリン専攻"},{"spoiler":false,"text":"生意気な学生"},{"spoiler":false,"text":"主人公をバカにしたり、授業をまともに聞きもしない。"},{"spoiler":false,"text":"しかし成績はかなり優秀で、 専門的な分野ではギリギリ主人公の方が上だが、 それでも時々主人公の間違いを指摘するほどの優等生である。"},{"spoiler":false,"text":"そのため、なかなか叱り様もなく優等生だが手がかかる…という、 他の生徒や先生にとっても扱いにくい存在。"},{"spoiler":false,"text":"バイオリンの演奏に秀て、今期末には大きなコンクールがある、 それに向かい日々練習を重ねる。"}],"source":"bangumi","sourceCharacterId":"22210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cd8c906f606ec78d0b94cc96f96a7ee0f82e470b927cdf6a56fd661b0aa1edd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42b835c0d6f434c4be7a6693b59e0e96921af67305d683e92fee64067c534919.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89517:22210:5936:1","source":"bangumi"}]},{"characterId":"char_c57966","characterName":"沖本 柚香利","sourceIds":{"bangumi":[{"characterId":"201370","match":"exact-normalized-name-in-linked-work","subjectId":"89517"}],"egsCharacterIds":["15434"],"vndbCharacterId":"c57966"},"originalCharacterName":"沖本 柚香利","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"西園寺燐の担任教師。"},{"spoiler":false,"text":"非常に大人しく、まだ新人気分が抜け切れていない先生。"},{"spoiler":false,"text":"その新人故に、生徒への指導に対して自信が持てず、悩んでいる。"},{"spoiler":false,"text":"学園では後輩になるが、やや経験の面で長い主人公に依存し、頼りにすることもしばしば。"}],"source":"egs","sourceCharacterId":"15434","sourceWorkId":"12353","spoiler":false},{"segments":[{"spoiler":false,"text":"燐の担任"},{"spoiler":false,"text":"おとなし目で、比較的新人の先生。先生としては自分より後輩ではあるが、この学園では 先輩になる。いつも指導に関して悩んでいる。学園モノの定番の位置にいる先生である。"},{"spoiler":false,"text":"新人教師ゆえに、指導に自信の持てない柚香利は、この学園では後輩になるが、多少経験 の深い主人公に、依存し、頼りにする事がしばしばある。"},{"spoiler":false,"text":"そんな性格ゆえ、主人公のていの良いはけ口として利用される事がしばしば。"}],"source":"bangumi","sourceCharacterId":"201370"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbb11bd9d0b55c5e2b46e376ca93697abad535b1e41a1ddddfda4d866b8ba53e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/668547e90bfbf8d53fa64e94208134bdfed311af26d8821150500986d9112658.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89517:201370:13512:1","source":"bangumi"}]},{"characterId":"char_c57967","characterName":"香澄","sourceIds":{"bangumi":[{"characterId":"201371","match":"exact-normalized-name-in-linked-work","subjectId":"89517"}],"egsCharacterIds":["15435"],"vndbCharacterId":"c57967"},"originalCharacterName":"香澄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に他者を自由に操る方法が書かれた本を渡した、謎めいた少女。"},{"spoiler":false,"text":"不思議なアイテムを持ってきたり、その使い方を教えたりと、主人公を陰からサポートしてくれる。"},{"spoiler":false,"text":"実は彼女の正体は……？"}],"source":"egs","sourceCharacterId":"15435","sourceWorkId":"12353","spoiler":false},{"segments":[{"spoiler":false,"text":"本の精のような不思議な存在。"},{"spoiler":false,"text":"不思議アイテムを持ってきたり、使い方を教えてくれるサポートキャラ。"}],"source":"bangumi","sourceCharacterId":"201371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13ee95782bb0f074e3f08052d7382a68ea946c34a1f16f