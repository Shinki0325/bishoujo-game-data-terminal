ate":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34e8184bfbc04d072b13e6cda93d9ba68741eec4d2307afd7981e42c5dd348e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a360c8586110b5a91240ee9ddb884a0ae6afba8a63bb95f60e71c7e9eec4457e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"涼森 ちさと","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29122","source":"vndb"}]},{"characterId":"char_vndb_c36793","characterName":"結城 千鶴","sourceIds":{"vndbCharacterId":"c36793"},"originalCharacterName":"結城 千鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The director of “Matsunomi En” where the main characters work, and the mother of Miya & Shinya."},{"spoiler":false,"text":"She adores children and considers the main characters as her child."},{"spoiler":false,"text":"She has a somewhat carefree and optimistic personality, and depending on how you look at her, she can be seen as an airhead."},{"spoiler":false,"text":"She is a motherly woman who smiles and gives out gentle hugs."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c36793"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30944793788af9495e12e98575942aa1c7be4c48c878145d31a10825678fc18e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caf604d08add6df7dca31467217b0d83c9db15acd1e30d0becb30b4056840d02.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29125","source":"vndb"}]},{"characterId":"char_vndb_c36794","characterName":"結城 真弥","sourceIds":{"vndbCharacterId":"c36794"},"originalCharacterName":"結城 真弥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of the twins"},{"spoiler":false,"text":"She has a “big sisterly” personality, and she decided to become a day-care center mother because she is worried about her twin sister Miya, who is somewhat unreliable. However, in her heart of hearts, she still loves the main character as much as Miya does."},{"spoiler":false,"text":"She is good at running and climbing trees (although she is afraid of heights and cannot climb above her own height). She has low blood pressure and is weak in the morning, giving the impression that she is somewhat unsteady in the morning."},{"spoiler":false,"text":"Unlike Miya, she is not good at cooking (she says she is “practicing”). She is extremely shy, and a simple tap on the back causes her to yelp."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c36794"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcb7469c1fb82f08625ec8580cffe345211d76a1ed998d586ac524180d227037.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cacdc43ce04963420e1b3955ab42835dfb76aa1585b6b1092c4b3324869d1d09.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"涼森 ちさと","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29121","source":"vndb"}]},{"characterId":"char_vndb_c36795","characterName":"結城 未弥","sourceIds":{"vndbCharacterId":"c36795"},"originalCharacterName":"結城 未弥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The older sister of the twins."},{"spoiler":false,"text":"She is a day-care center mother who is basically calm, nonchalant, and goes at her own pace. She is a little shy and withdrawn, but her mind is positive. She has a habit of calling the main character, who is a senior day-care center father, “big brother” and often blushes."},{"spoiler":false,"text":"She seems to be somewhat “attached” to the main character. She has been assigned as a day-care center mother at the same school as the main character, with secret feelings in her heart."},{"spoiler":false,"text":"Her hobbies(?) are organizing and cooking. She is good at organizing things and cooking, and is also good at playing the piano. She likes to sew, but she is not very good at it and often pricks her fingers with a needle. Sometimes, from a distance, it looks like she is sitting on the floor nursing her baby."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c36795"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb0774d79c7ccebb95a04ac606d4cea6f01f77b8f12db6c6223f3a4968f35c39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89919beaef05ce93335f11535aaeb5f7f9c1d42cda26413e4aa4193bcc3e2644.webp","width":213,"height":256,"source":