bel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167233","source":"egs"},{"creditedName":"並木ユギ(夕凪デザイン)","creatorId":"vndb:s16964","sourcePersonId":"egs:creator:18668","canonicalEntityId":"vndb:s16964","name":"並木ユギ(夕凪デザイン)","detail":"UIデザイン","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167234","source":"egs"},{"creditedName":"Halvoice(はる)","creatorId":"egs:creator:27455","sourcePersonId":"egs:creator:27455","canonicalEntityId":"egs:creator:27455","name":"Halvoice(はる)","detail":"PV","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:167235","source":"egs"},{"creditedName":"ルクル","creatorId":"vndb:s1246","sourcePersonId":"egs:creator:16759","canonicalEntityId":"vndb:s1246","name":"ルクル","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:255101","source":"egs"},{"creditedName":"Studio神無月(神無月、Terry chandler)","creatorId":"vndb:s9491","sourcePersonId":"egs:creator:25932","canonicalEntityId":"vndb:s9491","name":"Studio神無月(神無月、Terry chandler)","detail":"SE","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:294930","source":"egs"},{"creditedName":"桐葉","creatorId":"vndb:s3374","sourcePersonId":"vndb:s3374","canonicalEntityId":"vndb:s3374","name":"すしめかぶ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:113288","source":"vndb"}]},"cast":[{"characterId":"char_c23362","characterName":"遊行寺 夜子","sourceIds":{"bangumi":[{"characterId":"26421","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5049"],"vndbCharacterId":"c23362"},"originalCharacterName":"遊行寺 夜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Shut up!\""},{"spoiler":false,"text":"Class 2, Grade 1, Fujitsubo School (not going to school)"},{"spoiler":false,"text":"A girl who likes books more than anyone and more than anything. With the peculiar appearance of white hair and red eyes, she used to be looked at with vigilant eyes, and is thus hostile to others. That is why she has fostered a love for books which never betray her."},{"spoiler":false,"text":"She was wary of the protagonist when they first met, and a chilly atmosphere arose between them. As a result, she opposes the protagonist entering the library, and bears dissatisfaction with other family members who welcome him."},{"spoiler":false,"text":"She is reserved and mysteriously charming. She spends every day in the library, buried in books."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c23362"},{"segments":[{"spoiler":false,"text":"藤壺学園 1年2組（不登校中）"},{"spoiler":false,"text":"誰よりも本が好きで、何よりも本が好きな少女。"},{"spoiler":false,"text":"白髪に赤目という奇抜な身体的特徴を持っており、過去、他人から忌避の視線で見られたことから、他人に対して敵意を強く持っている。"},{"spoiler":false,"text":"そのため、誰よりも何よりも平等な本を愛するようになった。"},{"spoiler":false,"text":"出会った当初は主人公に警戒心を持っており、顔を合わせる度に険悪な雰囲気を生んでいた。"},{"spoiler":false,"text":"そのため、主人公が図書館に出入りすることに反対しており、主人公を歓迎する他の家族に不満がある。"},{"spoiler":false,"text":"クールで神秘的な魅力を持っている。"},{"spoiler":false,"text":"図書館に引きこもって読書漬けの毎日を送っている。"}],"source":"egs","sourceCharacterId":"5049","sourceWorkId":"20988","spoiler":false},{"segments":[{"spoiler":false,"text":"藤壺学園 1年2組（不登校中）。 クールで神秘的な魅力を持っている。"},{"spoiler":false,"text":"誰よりも本が好きで、何よりも本が好きな少女。 図書館に引きこもって読書漬けの毎日を送っている。"},{"spoiler":false,"text":"白髪に赤目という奇抜な身体的特徴を持っており、過去、他人から忌避の視線で見られたことから、他人に対して敵意を強く持っている。"},{"spoiler":false,"text":"そのため、誰よりも何よりも平等な本を愛するようになった。"},{"spoiler":false,"text":"出会った当初は主人公に警戒心を持っており、顔を合わせる度に険悪な雰囲気を生んでいた。"},{"spoiler":false,"text":"そのため、主人公が図書館に出入りすることに反対しており、主人公を歓迎する他の家族に不満がある。"},{"spoiler":false,"text":"「うるさい黙れ」"}],"source":"bangumi","sourceCharacterId":"26421"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8f915af8fb894080b37ea475cd1aafec258aa649e64abd834c430cc31476401.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07c0a73856892c5bb1c49b8ec823dedac7bf2bc5ad63377c2094c45c009f88cf.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26421:15637:1","source":"bangumi"}]},{"characterId":"char_c23363","characterName":"月社 妃","sourceIds":{"bangumi":[{"characterId":"26422","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5050"],"vndbCharacterId":"c23363"},"originalCharacterName":"月社 妃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I wanted to be proudly in love with my elder brother.\""},{"spoiler":false,"text":"Class 2, Grade 3, Takayama School"},{"spoiler":false,"text":"Despite being a full younger sister of the protagonist, she is using her mother's family name, Tsukiyashiro."},{"spoiler":false,"text":"She is a smart girl and a sharp-tongued eccentric. She disguises her conscending attitude towards things and behaves herself in public, and has thus won fame and popularity at school; her real side is revealed only to her loved ones."},{"spoiler":false,"text":"She never shows weakness to others, and keeps an unhurried manner. Nobody understands her worries hidden under her constant smile."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c23363"},{"segments":[{"spoiler":false,"text":"鷹山学園 3年2組。"},{"spoiler":false,"text":"主人公の実の妹であるが、母方の姓である「月社」を名乗っている。"},{"spoiler":false,"text":"とても頭の回転が早く、賢い少女ではあるのだが、性格はひねくれていて、毒舌家。"},{"spoiler":false,"text":"斜に構えたような部分があるが、それが表に出ないよう仮面を被って振る舞う。"},{"spoiler":false,"text":"そのため、学園ではとても評判がよく、人気も高いが、親しい相手の前では、遠慮無く素顔を晒す。"},{"spoiler":false,"text":"弱みを誰にも見せず、常に余裕のある振る舞いを保ち続けている。"},{"spoiler":false,"text":"いかなるときでも不敵に微笑む彼女の悩みは、今も誰にも分からない。"}],"source":"egs","sourceCharacterId":"5050","sourceWorkId":"20988","spoiler":false},{"segments":[{"spoiler":false,"text":"鷹山学園 3年2組。 主人公の実の妹だが、母方の姓である “月社” を名乗っている。"},{"spoiler":false,"text":"とても頭の回転が早く、賢い少女ではあるのだが、性格はひねくれていて毒舌家。"},{"spoiler":false,"text":"斜に構えたような部分があるが、それが表に出ないよう仮面を被って振る舞う。 そのため学園ではとても評判が良く人気も高いが、親しい相手の前では遠慮無く素顔を晒す。"},{"spoiler":false,"text":"弱みを誰にも見せず、常に余裕のある振る舞いを保ち続けている。"},{"spoiler":false,"text":"いかなる時でも不敵に微笑む彼女の悩みは、今も誰にも分からない。"},{"spoiler":false,"text":"「実の兄を愛していると誇れる妹に、私はなりたかった」"}],"source":"bangumi","sourceCharacterId":"26422"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71cd18bf745583a61f2652d9e5f9de1cf44de771b502d943f7bc1feae62ff6c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78b59f275ff87a7b4f80e4c0482915289c8125b35dd79c7031b6d8f31dbbab28.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26422:6359:1","source":"bangumi"}]},{"characterId":"char_c23364","characterName":"伏見 理央","sourceIds":{"bangumi":[{"characterId":"26423","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5051"],"vndbCharacterId":"c23364"},"originalCharacterName":"伏見 理央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Ah! It's Ruri there!\""},{"spoiler":false,"text":"Class 2, Grade 1, Fujitsubo School"},{"spoiler":false,"text":"Ever since she was adopted in childhood by the owner of the library, she has been dwelling and working as a maid here. She is a positive and somewhat innocent girl who pacifies the atmosphere with her warm smile. She is good at domestic work, especially cooking, and pleases everyone at the dining table."},{"spoiler":false,"text":"She has been loving the protagonist from childhood, and has never tried to conceal this feeling. Conscious that the feeling will not receive any response, however, she has never expected or wished anything. She is living with plenty of worries and concerns."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c23364"},{"segments":[{"spoiler":false,"text":"藤壺学園 1年2組。"},{"spoiler":false,"text":"図書館の、雑用係。"},{"spoiler":false,"text":"幼い頃に図書館の主に拾われてから、以来この図書館に居候させてもらっている。"},{"spoiler":false,"text":"性格は天然混じりの超ポジティブ少女。"},{"spoiler":false,"text":"いつもニコニコ柔らかな微笑みで、周囲を和ませてくれるムードメーカー。"},{"spoiler":false,"text":"家事全般がとても得意で、特に料理の腕は天才的で、彼女の料理は食卓に笑顔を咲かせてくれる。"},{"spoiler":false,"text":"幼い頃から主人公のことが大好きで、そのことを隠そうとはしていない。"},{"spoiler":false,"text":"ただ、その気持ちが報われないことを自覚しているので、何も期待はしておらず、何も願ってさえいない。"},{"spoiler":false,"text":"彼女なりにたくさん悩み、たくさん考えて、彼女は今も生きている。"}],"source":"egs","sourceCharacterId":"5051","sourceWorkId":"20988","spoiler":false},{"segments":[{"spoiler":false,"text":"藤壺学園 1年2組。 図書館の雑用係。"},{"spoiler":false,"text":"幼い頃に図書館の主に拾われてから、図書館に居候させてもらっている。"},{"spoiler":false,"text":"性格は天然混じりの超ポジティブ少女。 いつもニコニコ柔らかな微笑みで、周囲を和ませてくれるムードメーカー。"},{"spoiler":false,"text":"家事全般がとても得意で、特に料理の腕は天才的。 彼女の料理は食卓に笑顔を咲かせてくれる。"},{"spoiler":false,"text":"幼い頃から主人公のことが大好きで、そのことを隠そうとしていない。"},{"spoiler":false,"text":"ただ、その気持ちが報われないことを自覚しているので、何も期待はしておらず、何も願ってさえいない。"},{"spoiler":false,"text":"彼女なりにたくさん悩み、たくさん考えて、彼女は今も生きている。"},{"spoiler":false,"text":"「あーーーー！ 瑠璃くんがいるーーーー！」"}],"source":"bangumi","sourceCharacterId":"26423"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f5769f9e2283945aec06c3163c9a6de2a312ee273007e43e6f7cd2020cf81f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99f45a05478abafc3468065db0112024945b1a7c5dc1c3399f91686e3bc4a476.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真中桂子","creatorId":"vndb:s4378","sourcePersonId":"vndb:s4378","canonicalEntityId":"vndb:s4378","name":"真中 桂子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26423:5205:1","source":"bangumi"}]},{"characterId":"char_c23365","characterName":"日向 かなた","sourceIds":{"bangumi":[{"characterId":"26424","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5073"],"vndbCharacterId":"c23365"},"originalCharacterName":"日向 かなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Just leave it to me. I am forever on your side, you know?\""},{"spoiler":false,"text":"Class 1, Grade 1, Fujitsubo School"},{"spoiler":false,"text":"She is the protagonist's classmate at Fujibuchi School, and sits just behind his first assigned seat. She is a nice, politely-spoken classmate wearing a cheerful and cute smile... which is just a first impression; her real side is quite weird. Both lovely and nasty, she is extremely honest with her curiosity, and actively enquires into anything unusual. Armed with such obtained secrets, she works on behalf of the \"detective club\" (with no evil intentions)."},{"spoiler":false,"text":"As a result, she is being evaded by other students and does not integrate well with the school. At that time, the innocent protagonist gets in touch with her, and from then on they will have more and more chances (which Kanata unilaterally brings about) to act together."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c23365"},{"segments":[{"spoiler":false,"text":"藤壺学園 1年1組。"},{"spoiler":false,"text":"主人公が入学した藤壺学園のクラスメイトであり、最初の割り振られた席の真後ろ。"},{"spoiler":false,"text":"常に礼儀正しい口調で、元気で可愛らしい笑顔を見せてくれる素敵なクラスメイト……というのが第一印象だったが、中身はたいそうな問題児である。"},{"spoiler":false,"text":"可愛げのある腹黒さを持ち合わせており、自分の好奇心にはどこまでも素直。"},{"spoiler":false,"text":"気になったことは何でも調べ上げてしまうアクティブさの持ち主。"},{"spoiler":false,"text":"そうして手にした秘密は自らの武器として扱い、「探偵部」としても活動をしている。（本人に悪意はない）"},{"spoiler":false,"text":"その結果、学生からは煙たがられており、学園ではやや浮いている。"},{"spoiler":false,"text":"そんな中、何も知らない主人公は彼女と接点を持ってしまい、以降行動を共にする機会が増えていく（ヒロインから一方的に）。"}],"source":"egs","sourceCharacterId":"5073","sourceWorkId":"20988","spoiler":false},{"segments":[{"spoiler":false,"text":"藤壺学園 1年1組。 最初の席順で主人公の真後ろの席だった。"},{"spoiler":false,"text":"常に礼儀正しい口調で、元気で可愛らしい笑顔を見せてくれる素敵なクラスメイト……というのが第一印象だったが、中身はたいそうな問題児。"},{"spoiler":false,"text":"可愛げのある腹黒さを持ち合わせており、自分の好奇心にはどこまでも素直。"},{"spoiler":false,"text":"気になったことは何でも調べ上げてしまうアクティブさの持ち主。"},{"spoiler":false,"text":"そうして手にした秘密は自らの武器として扱い、“探偵部” としても活動をしている（悪意はない）。"},{"spoiler":false,"text":"その結果、学生からは煙たがられており、学園ではやや浮いている。"},{"spoiler":false,"text":"そんな中、何も知らない主人公は彼女と接点を持ってしまい、行動を共にする機会が増えていく（彼女から一方的に）。"},{"spoiler":false,"text":"「任せて下さい。 私はいつだって、あなたの味方ですよ？」"}],"source":"bangumi","sourceCharacterId":"26424"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b5c5a2f9479db9fde6becd447dacf99ef2d142c0c7a9314ba63b6ce78539e41.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d4ac31f42d6e3bd35ee8ec09eca0f01862549fd918361e034323086e53de00c.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26424:17075:1","source":"bangumi"}]},{"characterId":"char_c23366","characterName":"クリソベリル","sourceIds":{"bangumi":[{"characterId":"26429","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5078"],"vndbCharacterId":"c23366"},"originalCharacterName":"クリソベリル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Kyahahaha! Okay, just open the book.\""},{"spoiler":false,"text":"Mysterious girl appearing in front of the protagonist group"},{"spoiler":false,"text":"She looks like Yoruko but has an entirely different personality. The elusive girl always emerges from the dark with a \"magic book\" open on one hand."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c23366"},{"segments":[{"spoiler":false,"text":"主人公たちの前に現れる謎の少女。"},{"spoiler":false,"text":"その容姿は夜子と似ているけれど、中身はまるで別物。"},{"spoiler":false,"text":"神出鬼没、夜の闇とともに現れる少女は、いつだって片手に「魔法の本」を開いてしまっている。"}],"source":"egs","sourceCharacterId":"5078","sourceWorkId":"20988","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公たちの前に現れる謎の少女。"},{"spoiler":false,"text":"その容姿は夜子と似ているけれど、中身はまるで別物。"},{"spoiler":false,"text":"神出鬼没。 夜の闇と共に現れる少女は、いつだって片手に “魔法の本” を開いてしまっている。"},{"spoiler":false,"text":"「きゃはははっ！　さあ、本を開きましょう」"}],"source":"bangumi","sourceCharacterId":"26429"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22e179a15d5ab17e365372470e77103701d1867f9863f2174733998c11974614.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/768d09ce747f070d4969898a8192eddc3d4edab7ac0a979679b0830fdf1e81f8.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26429:5936:1","source":"bangumi"}]},{"characterId":"char_c24483","characterName":"本城 岬","sourceIds":{"bangumi":[{"characterId":"26425","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5074"],"vndbCharacterId":"c24483"},"originalCharacterName":"本城 岬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Let's get along appropriately, newbie.\""},{"spoiler":false,"text":"Class 1, Grade 1, Fujitsubo School"},{"spoiler":false,"text":"A classmate who approaches the protagonist, who comes from outside the island. She has a friendly personality and is a nice girl who gets along with everyone, but she doesn't form deep relationships with anyone and keeps a certain distance."},{"spoiler":false,"text":"Because of that, she is a good conversation partner for the protagonist, who keeps a secret regarding the library. Sometimes close, sometimes distant, she nonetheless maintains respectful and comforting relationships."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c24483"},{"segments":[{"spoiler":false,"text":"藤壺学園 1年1組。"},{"spoiler":false,"text":"島の外から入学してきた主人公を、フレンドリーに迎えてくれるクラスメイト。"},{"spoiler":false,"text":"気さくで明るい性格をしていて、誰とでも仲良くなることが出来る素敵な女の子だが、深い付き合いをよしとはせず、常に線引した付き合い方に長けている。"},{"spoiler":false,"text":"そのため図書館の秘密を抱える主人公にとって、気兼ねなく話し相手になってくれる貴重な相手。"},{"spoiler":false,"text":"ほどほどに仲良く、ほどほどに冷たく、それでも互いを尊重し合う関係に、居心地の良さがある。"}],"source":"egs","sourceCharacterId":"5074","sourceWorkId":"20988","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efacc30d9b947e7258aff5e1786ad854c6f69b22ba55cfb1ad037ee2cbb5d320.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98d28c0a0d683a5fe7d73b5c716ae18fb6dfd80ad93d52f239dcde5628b5b497.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八幡七味","creatorId":"vndb:s1988","sourcePersonId":"vndb:s1988","canonicalEntityId":"vndb:s1988","name":"八幡 七味","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26425:21494:1","source":"bangumi"}]},{"characterId":"char_c46887","characterName":"本城 奏","sourceIds":{"bangumi":[{"characterId":"26426","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5075"],"vndbCharacterId":"c46887"},"originalCharacterName":"本城 奏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You know nothing about the scariness of magical books.\""},{"spoiler":false,"text":"A private detective hired by Yugyouji's main family."},{"spoiler":false,"text":"She appears before the protagonist and his friends as they get involved in magical book events and tells them about the danger."},{"spoiler":false,"text":"While she appears to be a competent detective, when she gets mad, she ignores her surroundings and goes berserk."},{"spoiler":false,"text":"She is intensely vigilant about magical books, and while she does not wish to let the children get involved with the books, stories continue to unfold around them regardless of whether they like it."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c46887"},{"segments":[{"spoiler":false,"text":"遊行寺本家のお抱え私立探偵。"},{"spoiler":false,"text":"魔法の本の事件に巻き込まれていく主人公たちの前に現れて、その危険性を教えてくれる。"},{"spoiler":false,"text":"有能な探偵ではあるらしいが、怒ると周りが見えなくなり、暴走してしまうことがある。"},{"spoiler":false,"text":"魔法の本に対しては強い警戒心を抱いており、少年少女がそれに関わることを望んでいないが、彼女がそれを望む望まないに関わらず、物語は常に彼女たちを巻き込み続けていく。"}],"source":"egs","sourceCharacterId":"5075","sourceWorkId":"20988","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1ea8ff48a24f0bc5e85504afcae9b4b59954ac1100bcb65cc8e298b48a7d21a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6339e922a6ea5df0f41ca67f503bffc478162da38af5b81e1fdd0a6cc3fa0ae7.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野上結生","creatorId":"vndb:s3364","sourcePersonId":"vndb:s3364","canonicalEntityId":"vndb:s3364","name":"野上結生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26426:31794:1","source":"bangumi"}]},{"characterId":"char_c46888","characterName":"遊行寺 闇子","sourceIds":{"bangumi":[{"characterId":"26428","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5077"],"vndbCharacterId":"c46888"},"originalCharacterName":"遊行寺 闇子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Will you please take care of Yoruko?\""},{"spoiler":false,"text":"The real mother of Yoruko."},{"spoiler":false,"text":"As the library's owner, she is deeply involved in the matter of magical books. She spoils Yoruko with love, and she even believes it is okay to sacrifice everything for Yoruko's sake. The library and the books it contains are all prepared for Yoruko. Even today, she is collecting books for the happiness of Yoruko."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c46888"},{"segments":[{"spoiler":false,"text":"夜子の実の母。"},{"spoiler":false,"text":"図書館の当主にして、魔法の本と強い関わりを持つ女性。"},{"spoiler":false,"text":"夜子のことを溺愛しており、夜子のためなら全てを捧げても良いと思うほど愛してしまっている。"},{"spoiler":false,"text":"この図書館も、本も、全ては夜子のために用意されたもの。"},{"spoiler":false,"text":"今日も彼女は、夜子の幸せのために本を集め続けるのだ。"}],"source":"egs","sourceCharacterId":"5077","sourceWorkId":"20988","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04c1c21e6b0d5670017399249b16df7b49cdc6c56669386e12f1a2f70595807b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2236b921337ea9c4ec177214aba1f5c4029e2a169c23a2ae3b895d464a1afa39.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26428:5890:1","source":"bangumi"}]},{"characterId":"char_c99183","characterName":"遊行寺 汀","sourceIds":{"bangumi":[{"characterId":"26427","match":"exact-normalized-name-in-linked-work","subjectId":"111552"}],"egsCharacterIds":["5076"],"vndbCharacterId":"c99183"},"originalCharacterName":"遊行寺 汀","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class 2, Grade 1, Fujitsubo Academy (held back one year)."},{"spoiler":false,"text":"He is Yoruko's older half-brother, but the two are not on good terms. He has a free-spirited and unruly personality, earning him a reputation as a troublesome figure at school. However, he is simply honest with his feelings, which leads to him being ostracized and looked down upon by those around him. He is a lone wolf and doesn't mix with others, but he has taken a liking to the protagonist."},{"spoiler":false,"text":"Although he dotes on his sister in the library, she mostly ignores him. He is also very fond of the protagonist's younger sister, Kisaki, leading to rumors that he is an irredeemable siscon."},{"spoiler":false,"text":"This rumor is so at odds with his intimidating public image that hardly anyone believes it. It seems he often skips school to work alongside Honjou Kanade, dealing with the magical books."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c99183"},{"segments":[{"spoiler":false,"text":"藤壺学園 1年2組（1年留年）。"},{"spoiler":false,"text":"自由奔放に生きる、学園でも有名な悪童。"},{"spoiler":false,"text":"そして夜子の腹違いの兄。"},{"spoiler":false,"text":"一匹狼で他人とつるむことはあまりないが、主人公のことはたいそう気に入っている。"},{"spoiler":false,"text":"その中身はただ自分に正直な性格をしているだけなのだが、周りからは腫れ物扱いされている。"},{"spoiler":false,"text":"図書館では妹のことを溺愛しているが、あまり相手にされていない。"},{"spoiler":false,"text":"主人公の妹である妃のことも可愛がっているため、見境のない妹好きという噂もあるが、あまりにも学園でのイメージとかけ離れているせいで、なかなかその話を信じる人はいない。"},{"spoiler":false,"text":"学園をサボっては、本城奏の元で本に関わる仕事を務めているらしい。"}],"source":"egs","sourceCharacterId":"5076","sourceWorkId":"20988","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78421a2d11601f12d75cd0f45ef57c70a9636b0197a0ddf19a9a251183629823.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab2eb7b6eac8edd37558d83ec3515a46ff5188e942647aff947057cb497cf53c.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田友貴","creatorId":"vndb:s34","sourcePersonId":"vndb:s34","canonicalEntityId":"vndb:s34","name":"原田 友貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:111552:26427:18219:1","source":"bangumi"}]},{"characterId":"char_vndb_c26006","characterName":"四條 瑠璃","sourceIds":{"vndbCharacterId":"c26006"},"originalCharacterName":"四條 瑠璃","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I want to enjoy youth, too. Please help me.\""},{"spoiler":false,"text":"Class 1, Grade 1, Fujitsubo School"},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c26006"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4671","sourceCompanyId":"egs:brand:4368","canonicalEntityId":"vndb:p4671","name":"ウグイスカグラ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:20988:4368","source":"egs"},{"companyId":"vndb:p10779","sourceCompanyId":"vndb:p10779","canonicalEntityId":"vndb:p10779","name":"Kuratari Translation","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:115616:v15871","source":"vndb"},{"companyId":"vndb:p19867","sourceCompanyId":"vndb:p19867","canonicalEntityId":"vndb:p19867","name":"阡陌","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:142262:v15871","source":"vndb"},{"companyId":"vndb:p19867","sourceCompanyId":"vndb:p19867","canonicalEntityId":"vndb:p19867","name":"阡陌","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:142263:v15871","source":"vndb"},{"companyId":"vndb:p23609","sourceCompanyId":"vndb:p23609","ca