egs"},{"creditedName":"呉","creatorId":"vndb:s507","sourcePersonId":"vndb:s507","canonicalEntityId":"vndb:s507","name":"呉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10765","source":"vndb"},{"creditedName":"恋純 ほたる","creatorId":"vndb:s1908","sourcePersonId":"vndb:s1908","canonicalEntityId":"vndb:s1908","name":"恋純 ほたる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10768","source":"vndb"},{"creditedName":"Mitha","creatorId":"vndb:s2131","sourcePersonId":"vndb:s2131","canonicalEntityId":"vndb:s2131","name":"Mitha","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:10770","source":"vndb"}]},"cast":[{"characterId":"char_c11243","characterName":"月村 美姫","sourceIds":{"bangumi":[{"characterId":"13987","match":"exact-normalized-name-in-linked-work","subjectId":"15744"},{"characterId":"13987","match":"exact-normalized-name-in-linked-work","subjectId":"21849"},{"characterId":"13987","match":"exact-normalized-name-in-linked-work","subjectId":"21850"}],"egsCharacterIds":["18590"],"vndbCharacterId":"c11243"},"originalCharacterName":"月村 美姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"605"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend of the protagonist, reunited after a long time.A second-year student at Kotogaoka Academy."},{"spoiler":false,"text":"With a gentle personality and graceful, beautiful features—and a fine figure to match—she is seen as something of an unattainable flower at the academy, though she herself doesn’t quite notice it."},{"spoiler":false,"text":"Through her activities in the school's Volunteer Club, she is also well-liked by the townspeople."},{"spoiler":false,"text":"She can be a little absent-minded at times, but she is entirely earnest and a very hard worker."},{"spoiler":false,"text":"Though slender, she is a skilled practitioner of Aikido."},{"spoiler":false,"text":"She has always held feelings for Koichi and is happier than anyone about their reunion this time."}],"source":"vndb","sourceCharacterId":"c11243"},{"segments":[{"spoiler":false,"text":"琴が丘学園二年生。主人公の幼馴染。"},{"spoiler":false,"text":"眉目秀麗で、淑やかな性格の彼女は、学園では高嶺の花的な存在。"},{"spoiler":false,"text":"またボランティア部に所属し、様々な活動をしていることから島の住民からも評判。"},{"spoiler":false,"text":"真面目で頑張り屋さんだが、やや抜けているところも。"},{"spoiler":false,"text":"身体の線は細いものの、合気道の腕前はかなりのもの。"},{"spoiler":false,"text":"島を離れた主人公をずっと想っていたらしい。"}],"source":"egs","sourceCharacterId":"18590","sourceWorkId":"8398","spoiler":false},{"segments":[{"spoiler":false,"text":"おしとやかな性格で、眉目秀麗。"},{"spoiler":false,"text":"そしてスタイルもいいとあって、学園では高嶺の花のように見られているが、本人にはピンとこない。"},{"spoiler":false,"text":"学校のボランティア部での部活動を通して、町の住民にも人気が高い。"},{"spoiler":false,"text":"やや抜けているところもあるが、本人は至って真面目。"},{"spoiler":false,"text":"そして、とても頑張り屋だ。"},{"spoiler":false,"text":"身体は細いが、合気道のかなりの使い手。"}],"source":"egs","sourceCharacterId":"18590","sourceWorkId":"10568","spoiler":false},{"segments":[{"spoiler":false,"text":"久しぶりの再会となった、主人公の幼なじみ。琴が丘学園2年生。"},{"spoiler":false,"text":"おしとやかな性格で、眉目も秀麗。そしてスタイルもいいとあって、学園では高嶺の花のように見られているが、本人にはピンとこない。"},{"spoiler":false,"text":"学校のボランティア部での部活動を通して、町の住民にも人気が高い。"},{"spoiler":false,"text":"やや抜けているところもあるが、本人は至って真面目。そして、とても頑張り屋だ。"},{"spoiler":false,"text":"身体は細いが、合気道のかなりの使い手。光一の事をずっと想っていて、今回の再会を誰よりも喜んでいる。"}],"source":"bangumi","sourceCharacterId":"13987"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"18590","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"18590","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"18590","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"18590","sourceWorkId":"10568","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c78a43437a1c0498d382255083763a1f2b0cf6a90ea8fbc996191778fc09cadd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c864c3d594d01654e6442bcd28c3496e7f0d6286a487708083a686f4539a8bb9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神田理江","creatorId":"vndb:s858","sourcePersonId":"vndb:s858","canonicalEntityId":"vndb:s858","name":"神田 理江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21850:13987:4618:1","source":"bangumi"}]},{"characterId":"char_c11244","characterName":"行野 無月","sourceIds":{"bangumi":[{"characterId":"13988","match":"exact-normalized-name-in-linked-work","subjectId":"15744"},{"characterId":"13988","match":"exact-normalized-name-in-linked-work","subjectId":"21849"},{"characterId":"13988","match":"exact-normalized-name-in-linked-work","subjectId":"21850"}],"egsCharacterIds":["18591"],"vndbCharacterId":"c11244"},"originalCharacterName":"行野 無月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"331"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's sister (cousin).A first-year student at Kotogaoka Academy."},{"spoiler":false,"text":"From Koichi's perspective, she is his cousin."},{"spoiler":false,"text":"Having lost both her parents, she was adopted into the Yukino family."},{"spoiler":false,"text":"Originally, only Koichi was supposed to move to the island, but she later followed him here."},{"spoiler":false,"text":"It seems she acted out of the belief that Koichi couldn’t manage without her."},{"spoiler":false,"text":"That said, Koichi is generally the more dependable one, so her reasoning doesn’t hold up well in practice."},{"spoiler":false,"text":"She is fairly proactive, though not particularly tomboyish in nature."},{"spoiler":false,"text":"She tends to be the caring type and is somewhat quiet—especially around others—but shows a more lively side only around Koichi."},{"spoiler":false,"text":"She takes interest in many things and has numerous hobbies."},{"spoiler":false,"text":"However, her tendency to lose interest quickly is her Achilles' heel."}],"source":"vndb","sourceCharacterId":"c11244"},{"segments":[{"spoiler":false,"text":"琴が丘学園一年生。主人公の妹。"},{"spoiler":false,"text":"本当は、主人公の従妹にあたるが、彼女の両親が亡くなったことから、行野家の養女となった。"},{"spoiler":false,"text":"主人公が島に移り住むことを知り、その後を追っかけてきた。"},{"spoiler":false,"text":"大人しく見えて、行動力があり、何かと世話を焼きたがるタイプ。"},{"spoiler":false,"text":"好奇心旺盛で趣味も多いが、飽きっぽい。"}],"source":"egs","sourceCharacterId":"18591","sourceWorkId":"8398","spoiler":false},{"segments":[{"spoiler":false,"text":"光一から見て、従妹に当たる女の子。"},{"spoiler":false,"text":"両親を亡くしてしまったため、行野家の養子となった。"},{"spoiler":false,"text":"島に移るのは本当は光一だけだったのだが、後から光一を追ってやって来た。"},{"spoiler":false,"text":"光一には自分が付いていないとダメ、と思っての行動とか。"},{"spoiler":false,"text":"そうはいっても、だいたいにおいて光一の方がしっかりしているので、実際はあまり理由になっていない。"},{"spoiler":false,"text":"タイプ的には世話焼き型で、若干おとなしめ。特に他人に対してはそうだが、光一にだけは、元気な一面も見せる。"},{"spoiler":false,"text":"色々な事に興味を持ち、趣味が多い。ただ、飽きっぽいのが玉に傷。"}],"source":"egs","sourceCharacterId":"18591","sourceWorkId":"10568","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。琴が丘学園1年生。"},{"spoiler":false,"text":"光一から見て、従妹に当たる女の子。両親を亡くしてしまったため、行野家の養子となった。"},{"spoiler":false,"text":"島に移るのは本当は光一だけだったのだが、後から光一を追ってやって来た。光一には自分が付いていないとダメ、と思っての行動とか。そうはいっても、だいたいにおいて光一の方がしっかりしているので、実際はあまり理由になっていない。"},{"spoiler":false,"text":"行動力はある方だが、特に男勝りという事もない。タイプ的には世話焼き型で、若干おとなしめ。特に他人に対してはそうだが、光一にだけは、元気な一面も見せる。"},{"spoiler":false,"text":"色々な事に興味を持ち、趣味が多い。ただ、飽きっぽいのが玉に傷。"},{"spoiler":false,"text":"「私は、お兄ちゃんの保護者、なんだからね」"}],"source":"bangumi","sourceCharacterId":"13988"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"18591","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"18591","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"18591","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"18591","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"18591","sourceWorkId":"10568","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c475eae494021a14390febe56749661b6af00fcfde595be0798d887627bb2c35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8da772fbb155c7c726fa035e1d3684162a9ddafefd513fa7278076a965a867a2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21850:13988:6349:1","source":"bangumi"}]},{"characterId":"char_c11315","characterName":"岡本 ののか","sourceIds":{"bangumi":[{"characterId":"13990","match":"exact-normalized-name-in-linked-work","subjectId":"15744"},{"characterId":"13990","match":"exact-normalized-name-in-linked-work","subjectId":"21849"},{"characterId":"13990","match":"exact-normalized-name-in-linked-work","subjectId":"21850"}],"egsCharacterIds":["18592"],"vndbCharacterId":"c11315"},"originalCharacterName":"岡本 ののか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"515"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Maid.A third-year student at Kotogaoka Academy."},{"spoiler":false,"text":"She is a clumsy, fumbling girl who often makes mistakes but puts her whole heart into her maid duties."},{"spoiler":false,"text":"She gives off a sense of warmth and reliability—the kind of person who is always there whenever you turn around."},{"spoiler":false,"text":"She has been working as a live-in maid at the protagonist's family home for a little over a year."},{"spoiler":false,"text":"In truth, she has lost her memory, and it is due to these circumstances that she began working as a maid."},{"spoiler":false,"text":"Although Koichi is supposed to be meeting Nonoka for the first time, he somehow feels a sense of nostalgia around her."},{"spoiler":false,"text":"Commonly called Nono."}],"source":"vndb","sourceCharacterId":"c11315"},{"segments":[{"spoiler":false,"text":"琴が丘学園三年生。"},{"spoiler":false,"text":"一年と少し前から主人公の生家でメイドをしている女の子。"},{"spoiler":false,"text":"おどおどした感じのドジッ娘で、失敗ばかりしているが、仕事は一生懸命頑張っている。"},{"spoiler":false,"text":"何処か安心感を与えてくれるような温かい人柄を持つ。"},{"spoiler":false,"text":"そんな彼女は実は記憶を失っており、そうした事情から主人公の家で住み込みでメイドをさせてもらっている。"}],"source":"egs","sourceCharacterId":"18592","sourceWorkId":"8398","spoiler":false},{"segments":[{"spoiler":false,"text":"メイドさん。"},{"spoiler":false,"text":"おどおどしたドジっ子。失敗ばかりだが、メイドのお仕事には一所懸命だ。"},{"spoiler":false,"text":"振り向けば、いつでもそこにいてくれる。そんな安心感を与えてくれるような、温かな人柄の持ち主。"},{"spoiler":false,"text":"一年ちょっとほど、主人公の生家でメイドをしている。"},{"spoiler":false,"text":"実は記憶を失っていて、そうした事情から住み込みでメイドを始めるようになった。"},{"spoiler":false,"text":"ののかとは初めて会うはずの光一だが、何故か懐かしいものを感じるのだった。"},{"spoiler":false,"text":"通称、ののちゃん。"}],"source":"egs","sourceCharacterId":"18592","sourceWorkId":"10568","spoiler":false},{"segments":[{"spoiler":false,"text":"メイドさん。琴が丘学園3年生。"},{"spoiler":false,"text":"おどおどしたドジっ子。失敗ばかりだが、メイドのお仕事には一所懸命だ。振り向けば、いつでもそこにいてくれる。そんな安心感を与えてくれるような、温かな人柄の持ち主。"},{"spoiler":false,"text":"一年ちょっとほど、主人公の生家でメイドをしている。実は記憶を失っていて、そうした事情から住み込みでメイドを始めるようになった。"},{"spoiler":false,"text":"ののかとは初めて会うはずの光一だが、何故か懐かしいものを感じるのだった。通称、ののちゃん。"},{"spoiler":false,"text":"「一所懸命、が一番ですよね」"}],"source":"bangumi","sourceCharacterId":"13990"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"18592","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"18592","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"18592","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"18592","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"18592","sourceWorkId":"10568","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d48df24f86f28b876df06981b82867a72e96b81105eada2abee8a900b8049110.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd6b7542f980d582f8f63e16d9ca337c6bd03ec26e41958163e5b77419f58d53.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21850:13990:4434:1","source":"bangumi"}]},{"characterId":"char_c11316","characterName":"本町 春乃","sourceIds":{"bangumi":[{"characterId":"13989","match":"exact-normalized-name-in-linked-work","subjectId":"15744"},{"characterId":"13989","match":"exact-normalized-name-in-linked-work","subjectId":"21849"},{"characterId":"13989","match":"exact-normalized-name-in-linked-work","subjectId":"21850"}],"egsCharacterIds":["18593"],"vndbCharacterId":"c11316"},"originalCharacterName":"本町 春乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1010"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An overly cheerful shrine maiden trainee.A first-year student at Kotogaoka Academy."},{"spoiler":false,"text":"Though called a shrine maiden trainee, it's really just a part-time job, but she does look quite fitting in her shrine maiden attire."},{"spoiler":false,"text":"The reason she works such a job is due to her constitution—she is easily possessed by spirits."},{"spoiler":false,"text":"All kinds of ghosts flock to her, from wandering spirits to earth-bound spirits, evil spirits, and even living spirits."},{"spoiler":false,"text":"Haruno diligently works part-time every day alongside a professional shrine maiden, who possesses the power to exorcise such spirits—sometimes dispelling them, sometimes helping them attain peace."},{"spoiler":false,"text":"Though she seems to lead quite a troubled life, she shows no sign of being bothered by it."},{"spoiler":false,"text":"She is simply bright and positive."}],"source":"vndb","sourceCharacterId":"c11316"},{"segments":[{"spoiler":false,"text":"琴が丘学園一年生。"},{"spoiler":false,"text":"浮遊霊から地縛霊、悪霊、生き霊……、とあらゆる霊に憑かれやすい体質のため、巫女見習いのバイトをしている。"},{"spoiler":false,"text":"そんな不幸な人生を歩んでいる彼女だが、とにかく明るくポジティブな性格で、あまり気にするそぶりも見せない。"}],"source":"egs","sourceCharacterId":"18593","sourceWorkId":"8398","spoiler":false},{"segments":[{"spoiler":false,"text":"やたらと明るい巫女見習い。"},{"spoiler":false,"text":"巫女見習いといっても単なるバイトだが、巫女姿はそれなりにサマになっている。"},{"spoiler":false,"text":"どうしてそんなバイトをしているのかというと、幽霊に憑かれやすい、という体質のため。"},{"spoiler":false,"text":"浮遊霊から地縛霊、悪霊、生き霊などなんでもござれで寄ってくるのだ。"},{"spoiler":false,"text":"そうした幽霊たちを、ときに退治し、ときに成仏させる。"},{"spoiler":false,"text":"そんな退魔のチカラを持った本職の巫女と一緒に、春乃は日々バイトにいそしんでいる。"},{"spoiler":false,"text":"たいへんな人生を送っているようだが、本人は気にするそぶりも見せない。"},{"spoiler":false,"text":"とにかく明るく、ポジティブ。"}],"source":"egs","sourceCharacterId":"18593","sourceWorkId":"10568","spoiler":false},{"segments":[{"spoiler":false,"text":"やたらと明るい巫女見習い。琴が丘学園1年生。"},{"spoiler":false,"text":"巫女見習いといっても単なるバイトだが、巫女姿はそれなりにサマになっている。どうしてそんなバイトをしているのかというと、幽霊に憑かれやすい、という体質のため。浮遊霊から地縛霊、悪霊、生き霊などなんでもござれで寄ってくるのだ。そうした幽霊たちを、ときに退治し、ときに成仏させる、そんな退魔のチカラを持った本職の巫女と一緒に、春乃は日々バイトにいそしんでいる。"},{"spoiler":false,"text":"たいへんな人生を送っているようだが、本人は気にするそぶりも見せない。とにかく明るく、ポジティブなのだ。"},{"spoiler":false,"text":"「心の持ちよう、なんですねえ」"}],"source":"bangumi","sourceCharacterId":"13989"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"18593","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"18593","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"18593","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"18593","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"18593","sourceWorkId":"10568","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65dcb16259f19c1481196642bcbdd7d8e7864a21978fd6785b58cd05eb585560.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/779780565a2f2655b9e0034824b1848357ccb0012a7c50d8e8ca6ce0f5609fad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"土谷麻貴","creatorId":"vndb:s2132","sourcePersonId":"vndb:s2132","canonicalEntityId":"vndb:s2132","name":"土谷 麻貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21850:13989:5134:1","source":"bangumi"}]},{"characterId":"char_c11317","characterName":"宮城野 紗由","sourceIds":{"bangumi":[{"characterId":"13991","match":"exact-normalized-name-in-linked-work","subjectId":"15744"},{"characterId":"13991","match":"exact-normalized-name-in-linked-work","subjectId":"21849"},{"characterId":"13991","match":"exact-normalized-name-in-linked-work","subjectId":"21850"}],"egsCharacterIds":["18594"],"vndbCharacterId":"c11317"},"originalCharacterName":"宮城野 紗由","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"801"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"49"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student at Kotogaoka Academy, she is a girl who always carries a doll with her."},{"spoiler":false,"text":"She is an extremely fancy girl, always carrying a doll named Sayurin that resembles her, and wearing a headband with unmistakable cat ears."},{"spoiler":false,"text":"With a cheerful and innocent personality, she appears younger than her actual age, both mentally and physically."},{"spoiler":false,"text":"Rumors say that Sayurin can actually speak, though the truth remains unclear. According to the girl herself, it’s something like ventriloquism, yet not quite…"},{"spoiler":false,"text":"Witness accounts suggest that Sayurin, in contrast to Sayu, makes very cold and cynical remarks."}],"source":"vndb","sourceCharacterId":"c11317"},{"segments":[{"spoiler":false,"text":"琴が丘学園一年生。"},{"spoiler":false,"text":"いつも自分に似ている人形を持ち歩き、頭にネコミミのカチューシャという、エキセントリックな格好の女の子。"},{"spoiler":false,"text":"天真爛漫な性格で、精神的にも、肉体的にも、実年齢よりも幼く見える彼女。"},{"spoiler":false,"text":"そのいつも連れ歩いている人形は、喋るという噂があり、目撃者の話では、非常に冷淡でシニカルな発言をするそうな。"}],"source":"egs","sourceCharacterId":"18594","sourceWorkId":"8398","spoiler":false},{"segments":[{"spoiler":false,"text":"いつも人形を連れている女の子。"},{"spoiler":false,"text":"本人に似ている人形（さゆりん）をいつも持ち、頭にはまんまネコ耳なカチューシャをしているという、ファンシー極まりない女の子。"},{"spoiler":false,"text":"天真爛漫な性格で、精神的にも肉体的にも、実際の年齢より下に見える。"},{"spoiler":false,"text":"さゆりんは、なんと喋れるという噂があるのだが、真偽は定かではない。"},{"spoiler":false,"text":"本人曰く、腹話術のような、そうではないような…。"},{"spoiler":false,"text":"目撃者の談話によると、さゆりんの方は、紗由とは正反対に、非常に冷淡でシニカルな発言をするとの事。"}],"source":"egs","sourceCharacterId":"18594","sourceWorkId":"10568","spoiler":false},{"segments":[{"spoiler":false,"text":"いつも人形を連れている女の子。琴が丘学園1年生。"},{"spoiler":false,"text":"本人に似ている人形をいつも持ち、頭にはまんまネコ耳なカチューシャをしているという、ファンシー極まりない女の子。天真爛漫な性格で、精神的にも肉体的にも、実際の年齢より下に見える。"},{"spoiler":false,"text":"いつも連れている人形は、なんと喋れるという噂があるのだが、真偽は定かではない。本人曰く、腹話術のような、そうではないような…。目撃者の談話によると、人形の方は、紗由とは正反対に、非常に冷淡でシニカルな発言をするとの事だ。"},{"spoiler":false,"text":"「あぅー…腹話術じゃないんだけど…、あっ、でも、やっぱり、そうだから！」"}],"source":"bangumi","sourceCharacterId":"13991"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"18594","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"146 cm","valueContext":null,"source":"egs","sourceCharacterId":"18594","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"18594","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"49 cm","valueContext":null,"source":"egs","sourceCharacterId":"18594","sourceWorkId":"10568","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"18594","sourceWorkId":"10568","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea5950cbd3873cc93cfe0fbd60f8ac3c7cb0fd721f3cea7a1e5cc29e6