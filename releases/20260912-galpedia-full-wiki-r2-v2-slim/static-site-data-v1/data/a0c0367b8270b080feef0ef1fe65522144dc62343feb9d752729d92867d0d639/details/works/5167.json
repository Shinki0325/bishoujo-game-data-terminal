に告白した人物だったため。付き合って１年たらずで婚約、今に至る。恋愛に関してはいささか少女趣味。婚約者は婚前交渉をせまってくるが「結婚までは清い身体で・・・」という思いから、処女だった。媚薬の効果で主人公とＨしてしまってこれがマリッジブルーなのかと思い悩む。"}],"source":"bangumi","sourceCharacterId":"90220"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"26563","sourceWorkId":"5167","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"26563","sourceWorkId":"5167","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"26563","sourceWorkId":"5167","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c1b72205265500250bc4608405290d458d772162268ee1c73586ca5dbf34c03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09285e873fe52dc66c810d48ee72244d56a586bf8dd38ba130e82ed31302211b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223769:90220:4490:1","source":"bangumi"}]},{"characterId":"char_c47757","characterName":"川崎 朋香","sourceIds":{"bangumi":[{"characterId":"90221","match":"exact-normalized-name-in-linked-work","subjectId":"223769"}],"egsCharacterIds":["26564"],"vndbCharacterId":"c47757"},"originalCharacterName":"川崎 朋香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"22"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","va