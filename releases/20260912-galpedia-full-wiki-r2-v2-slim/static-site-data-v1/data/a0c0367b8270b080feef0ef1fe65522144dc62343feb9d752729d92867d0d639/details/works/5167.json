ource":"vndb","sourceCharacterId":"c47758"},{"segments":[{"spoiler":false,"text":"高飛車でゴージャスな、不景気もなんのそのの見栄っ張り。"},{"spoiler":false,"text":"実家が金持ちで、独立して上京してからも仕送りを絶やさずにいてくれたので生活レベルを落したことがない。"},{"spoiler":false,"text":"エリートが大好きでブランドも大好き。"},{"spoiler":false,"text":"社長秘書に抜擢されたのは、その見栄えの良さとスケジュール管理能力を買われたため。"},{"spoiler":false,"text":"子安専務の愛人となっているが、仕事は仕事、セックスはセックスで楽しむタイプである。"},{"spoiler":false,"text":"逆に自分のだらしないところを見せたり、誰かに何もかも投げ出して甘えるという行為を知らない。"},{"spoiler":false,"text":"ストレスの解消法の幅が狭く、セックスの最中ですら上品に振舞おうとする気質。"},{"spoiler":false,"text":"しかし、スプレーのおかげで主人公の前では乱れまくり。"},{"spoiler":false,"text":"媚***によって乱れまくることで新たな自分を発見し、発見させてくれた主人公への態度も変化していくことになる。"}],"source":"egs","sourceCharacterId":"26565","sourceWorkId":"5167","spoiler":false},{"segments":[{"spoiler":false,"text":"高飛車でゴージャスな、不景気もなんのそのの見栄っ張り。"},{"spoiler":false,"text":"実家が金持ちで、独立して上京してからも仕送りを絶やさずにいてくれたので生活レベルを落としたことがない。エリートが大好きでブランドも大好き。 社長秘書に抜擢されたのは、その見栄えの良さとスケジュール管理能力を買われたため。子安専務の愛人となっているが、仕事は仕事、セックスはセックスで楽しむタイプである。 逆に自分のだらしないところを見せたり、誰かに何もかも投げ出して甘えるという行為を知らない。ストレスの解消法の幅が狭く、セックスの最中ですら上品に振舞おうとする気質。 しかし、スプレーのおかげで主人公の前では乱れまくり。 媚薬によって乱れまくることで新たな自分を発見し、発見させてくれた主人公への態度も変化していくことになる。"}],"source":"bangumi","sourceCharacterId":"90222"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"26565","sourceWorkId":"5167","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"26565","sourceWorkId":"5167","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"26565","sourceWorkId":"5167","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/072e81bc88db5e5efd01a994ee0f701d685c035339ba109167aeb14f884de8ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b962c8cb1dfedc0735cfb1cf7a42def8d5e846d6863a59e43