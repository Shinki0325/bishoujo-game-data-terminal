EntityId":"vndb:s54423","name":"恋々","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45645","source":"vndb"}]},"cast":[{"characterId":"char_c44322","characterName":"浅霧 ちはや","sourceIds":{"bangumi":[{"characterId":"146837","match":"exact-normalized-name-in-linked-work","subjectId":"14230"}],"egsCharacterIds":["15098"],"vndbCharacterId":"c44322"},"originalCharacterName":"浅霧 ちはや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"朧沢学園の2年生で主人公の幼馴染。"},{"spoiler":false,"text":"元々この地を治めていた大名・浅霧家の一人娘であるにもかかわらず、なんにでも好奇心をもって首を突っ込みたがる「ゲームの勇者」タイプの女の子。"},{"spoiler":false,"text":"お姫様育ちのため、主人公のことは便利な家来か何かだと思っている。"},{"spoiler":false,"text":"紫子とは遠い親戚で姉妹のような関係。"},{"spoiler":false,"text":"「こんな美人をつかまえて、許せない言いぐさね。これはもう制裁だわ。制裁あるのみだわ」"}],"source":"egs","sourceCharacterId":"15098","sourceWorkId":"12681","spoiler":false},{"segments":[{"spoiler":false,"text":"朧沢学園の2年生で主人公の幼なじみ。"},{"spoiler":false,"text":"誰もが認める学園一の美少女であるにもかかわらず、何にでも好奇心を持って首を突っ込みたがる。"},{"spoiler":false,"text":"その反面、主人公の助けを待つお姫様的存在。"},{"spoiler":false,"text":"お嬢様系ツンデレキャラ。"}],"source":"bangumi","sourceCharacterId":"146837"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ef0aa7d9790630c95016bf35c95fa41e0131f241a766c97b0d642e6e6dd3c83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8365da394a1258c5ed4d7e9c0dedeccedd0aea63d0ec96edcf6db2524c3a3e56.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14230:146837:4792:1","source":"bangumi"}]},{"characterId":"char_c44323","characterName":"朧沢 紫子","sourceIds":{"bangumi":[{"characterId":"146838","match":"exact-normalized-name-in-linked-work","subjectId":"14230"}],"egsCharacterIds":["15099"],"vndbCharacterId":"c44323"},"originalCharacterName":"朧沢 紫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"朧沢学園の2年生で主人公の幼馴染。"},{"spoiler":false,"text":"古典的巫女さんキャラ。親しい仲でも丁寧語でしゃべる。"},{"spoiler":false,"text":"本人は名前が読みにくいことを気にしている。"},{"spoiler":false,"text":"落ち着きがありみんなのお姉さん役である。ちはやは妹のような存在。"},{"spoiler":false,"text":"朧神社の巫女で、朧姫にまつわる様々な伝承にも詳しい。"},{"spoiler":false,"text":"電化製品オンチで家電製品は触るだけで壊してしまうほどだが、昔からある日用品の扱いは得意で、将棋やチェスといったアナログなゲームも強い。"},{"spoiler":false,"text":"「あらあら、死屍累々ですねえ」"}],"source":"egs","sourceCharacterId":"15099","sourceWorkId":"12681","spoiler":false},{"segments":[{"spoiler":false,"text":"朧沢学園の2年生で主人公の幼なじみ。"},{"spoiler":false,"text":"古典的巫女さんキャラ。親しい仲でも丁寧語でしゃべる。"},{"spoiler":false,"text":"名前が長くて読みにくいことを気にしている。"},{"spoiler":false,"text":"朧神社の巫女で、朧姫にまつわる様々な伝承にも詳しい。"},{"spoiler":false,"text":"鈴は朧神社のご神体でありシンボルでもあるため、髪飾りに鈴を付けている。"}],"source":"bangumi","sourceCharacterId":"146838"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/871c358e27b68ede2c9c8f83cd023d6850978b2bc313754f7413a7c95992da31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e50c3d7d154c5c2fc67a95409d2453089c451c324f1327f9ccaab83b4f534fb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14230:146838:5906:1","source":"bangumi"}]},{"characterId":"char_c44324","characterName":"舞原 美那","sourceIds":{"bangumi":[{"characterId":"146839","match":"exact-normalized-name-in-linked-work","subjectId":"14230"}],"egsCharacterIds":["15100"],"vndbCharacterId":"c44324"},"originalCharacterName":"舞原 美那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"朧沢学園に最近転校してきた1年生。"},{"spoiler":false,"text":"無口で、誰に話しかけられてもそっけない反応しか帰さない、西洋人形のような少女。"},{"spoiler":false,"text":"表向き普通に学園生活を送る傍ら、裏では特定の女生徒やこの土地を支配する大財閥・山王寺家の内情を探っているらしい謎の顔を持つ。"},{"spoiler":false,"text":"「もちろんです。女の子をからかって、責任を取って下さい」"}],"source":"egs","sourceCharacterId":"15100","sourceWorkId":"12681","spoiler":false},{"segments":[{"spoiler":false,"text":"朧沢学園に最近転校してきた1年生。"},{"spoiler":false,"text":"無口で、誰に話しかけられてもそっけない反応しか返さない、西洋人形のような少女。"},{"spoiler":false,"text":"表向き普通に学園生活を送る傍ら、裏では特定の女生徒やこの土地を支配する大財閥・山王寺家の内情などを探っているらしい謎の顔を持つ。"}],"source":"bangumi","sourceCharacterId":"146839"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f7a9f74d7dff9df55ee7685feabcc28ba1fb5e6d126c1581125004e66c16135.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33018399b4e9e47bd0ae8ce11258500e5984de35d68dba0ab1a1229710649c81.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14230:146839:6038:1","source":"bangumi"}]},{"characterId":"char_c77237","characterName":"竹内 南","sourceIds":{"bangumi":[{"characterId":"146841","match":"exact-normalized-name-in-linked-work","subjectId":"14230"}],"egsCharacterIds":["15101"],"vndbCharacterId":"c77237"},"originalCharacterName":"竹内 南","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"新聞部員で壁新聞の編集長。主人公達のクラスメイト。"},{"spoiler":false,"text":"学園のにぎやかな場面の中心にはいつも必ず南がいて、今回もイベントを盛り上げるため、運営側の人間でありながら「朧小町コンテスト」に参加する。"},{"spoiler":false,"text":"父親は市議会議員でいろいろなところにコネがあるため、常識はずれなほどに広い行動範囲と情報収集網を持つ。"},{"spoiler":false,"text":"男勝りな性格で、何かに夢中になると周りのことが見えなくなってしまう熱中体質。"},{"spoiler":false,"text":"将来はジャーナリストを目指しているが、今のところはゴシップ記事を書いて学園の生徒達へ日々のちょっとした（悪意ある）話題を提供することに夢中になっている。"},{"spoiler":false,"text":"「神出鬼没が私の売りなの。事件あるところ私あり、覚えといて」"}],"source":"egs","sourceCharacterId":"15101","sourceWorkId":"12681","spoiler":false},{"segments":[{"spoiler":false,"text":"新聞部員で、主人公たちのクラスメイト。"},{"spoiler":false,"text":"イベントを盛り上げるため、運営側の人間でありながら『朧小町コンテスト』に参加する。"},{"spoiler":false,"text":"父親が市議会議員で色々なところにコネがあるため、常識外れなほどに行動範囲と情報収集網を持つ。"},{"spoiler":false,"text":"男勝りな性格で、なにかに夢中になると周りのことが見えなくなってしまう熱中体質。将来はジャーナリストを目指している。"}],"source":"bangumi","sourceCharacterId":"146841"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6bc14ade75f152c24b64358d07a0aa90c56abc60eff26c3f6b5eb897e5d4ca8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1808a5606850752561c624f70a6a3aff389b169a8d9215c12a19543e538b1cf8.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14230:146841:5741:1","source":"bangumi"}]},{"characterId":"char_c77238","characterName":"木村 ケイ","sourceIds":{"bangumi":[{"characterId":"146842","match":"exact-normalized-name-in-linked-work","subjectId":"14230"}],"egsCharacterIds":["15102"],"vndbCharacterId":"c77238"},"originalCharacterName":"木村 ケイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"写真部員で、主人公達のクラスメイト。"},{"spoiler":false,"text":"行動が小動物めいており、小さなスキマから建物に忍び込んでスクープ写真をとってきたりする。"},{"spoiler":false,"text":"なにかあるととりあえず笑うくせがある。"},{"spoiler":false,"text":"笑顔が好きで、カメラを向けるとみんな笑顔になるから写真が好き。"},{"spoiler":false,"text":"主食はポテチとコケコーラで、コーラを飲むときは腰に手を当てて一気飲みをする。"},{"spoiler":false,"text":"「心霊写真を撮りたい」という素朴な夢があり、学園に現れるという幽霊の噂を、入学以来ずっと追い求めている。"},{"spoiler":false,"text":"「ゆーちゃんの心の中まで写せるカメラがあればいいのになぁ」"}],"source":"egs","sourceCharacterId":"15102","sourceWorkId":"12681","spoiler":false},{"segments":[{"spoiler":false,"text":"新聞部員で、主人公たちのクラスメイト。"},{"spoiler":false,"text":"イベントを盛り上げるため、運営側の人間でありながら『朧小町コンテスト』に参加する。"},{"spoiler":false,"text":"父親が市議会議員で色々なところにコネがあるため、常識外れなほどに行動範囲と情報収集網を持つ。"},{"spoiler":false,"text":"男勝りな性格で、なにかに夢中になると周りのことが見えなくなってしまう熱中体質。将来はジャーナリストを目指している。"}],"source":"bangumi","sourceCharacterId":"146842"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ee991a8fa39d6309651fe3dc72025d5ca754e84805e0f4c35eb9f6213973a30.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b601e0355df6b1103deb9cffa820f4f02744437d38f87c532e7e66d6ab13a25f.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14230:146842:5890:1","source":"bangumi"}]},{"characterId":"char_c77246","characterName":"村田 環","sou