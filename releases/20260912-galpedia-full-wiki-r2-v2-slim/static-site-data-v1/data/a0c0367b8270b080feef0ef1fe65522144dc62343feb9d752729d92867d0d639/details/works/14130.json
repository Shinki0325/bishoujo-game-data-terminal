Url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b64b0fc5b66b2d27035c1f9e75e322f394f0986d209f775b58661cd3c623e07.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11175:64111:4463:1","source":"bangumi"}]},{"characterId":"char_c46728","characterName":"星影 リオン","sourceIds":{"bangumi":[{"characterId":"64112","match":"exact-normalized-name-in-linked-work","subjectId":"11175"}],"egsCharacterIds":["11580"],"vndbCharacterId":"c46728"},"originalCharacterName":"星影 リオン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女神の標ミュージカルで男役として絶大な人気を誇る百合神の1人。"},{"spoiler":false,"text":"いつもレイといちゃいちゃしているが、可愛い女の子なら何でもOK。非常に男という存在を嫌い敵視している。"},{"spoiler":false,"text":"女神の標のトップスターで、その象徴とも言える存在。"},{"spoiler":false,"text":"名前は芸名で、レイとは姉妹にあたる。"}],"source":"egs","sourceCharacterId":"11580","sourceWorkId":"14130","spoiler":false},{"segments":[{"spoiler":false,"text":"女神の標ミュージカルのトップスターで、その象徴とも言える存在。"},{"spoiler":false,"text":"男役として絶大な人気を誇る百合神のひとり。"},{"spoiler":false,"text":"いつもレイといちゃいちゃしているが、可愛い女の子ならなんでもOK。"},{"spoiler":false,"text":"非常に男という存在を嫌い敵視している。"},{"spoiler":false,"text":"名前は芸名で、レイとは姉妹にあたる。"},{"spoiler":false,"text":"「男なんてくだらない生き物だ。下等な者たちがいても仕方ないだろう？」"}],"source":"bangumi","sourceCharacterId":"64112"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8fee2c058b0f5e41bbdfa59619c8e45ab865fab18cafb9a254d69bce0b6c0a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6eed846db2bc3e7b9c725d24