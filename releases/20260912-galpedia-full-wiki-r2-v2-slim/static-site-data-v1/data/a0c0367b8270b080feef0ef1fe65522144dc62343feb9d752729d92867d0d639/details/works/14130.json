109"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2f747553b9767cdb19c712b5f4bcb90b3e23552d7d2170ee57d957d12c7caf5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9046a5b305094879decb3610b5c1db923e4a66a82ff479cfd49bac8571f82146.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11175:64109:6046:1","source":"bangumi"}]},{"characterId":"char_c46726","characterName":"剣 九重","sourceIds":{"bangumi":[{"characterId":"64110","match":"exact-normalized-name-in-linked-work","subjectId":"11175"}],"egsCharacterIds":["11578"],"vndbCharacterId":"c46726"},"originalCharacterName":"剣 九重","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現在のブルマ神。"},{"spoiler":false,"text":"幾多のスポーツを掛け持ちで行いながらも、その全ての競技で世界に通用する実力を発揮する。女子スポーツ界の至宝。"},{"spoiler":false,"text":"寡黙でクールな見た目から非常に女性人気が高いが、実はとても口べたなだけ。"}],"source":"egs","sourceCharacterId":"11578","sourceWorkId":"14130","spoiler":false},{"segments":[{"spoiler":false,"text":"現在のブルマ神。"},{"spoiler":false,"text":"幾多のスポーツを掛け持ちで行いながらも、その全ての競技で世界に通用する実力を発揮する。"},{"spoiler":false,"text":"女子スポーツ界の至宝。"},{"spoiler":false,"text":"寡黙でクールな見た目から非常に女性人気が高いが、実はとても口べたなだけ。"},{"spoiler":false,"text":"「……うん、頑張る」"}],"source":"bangumi","sourceCharacterId":"64110"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5164a8f416bb8561647f87e061456ba9c59377bfab77fde997a2f62ff39b908.webp","fallbackUrl":"https://