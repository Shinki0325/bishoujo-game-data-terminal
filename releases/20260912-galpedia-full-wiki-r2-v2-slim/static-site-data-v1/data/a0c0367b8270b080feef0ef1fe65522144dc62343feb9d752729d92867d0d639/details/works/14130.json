sourceIds":{"bangumi":[{"characterId":"11099","match":"exact-normalized-name-in-linked-work","subjectId":"11175"}],"egsCharacterIds":["11562"],"vndbCharacterId":"c46708"},"originalCharacterName":"氷野 水乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公、真舟伊月の幼馴染み。"},{"spoiler":false,"text":"幼い頃に事故で負ったケガを治して貰った事から伊月の神通力を知り、女装までさせて巫女神に仕立て上げた張本人。"},{"spoiler":false,"text":"口よりも先に手が出る過激な性格だが、学園では驚くべき猫かぶり技術と弛まない日々の努力で巫女達の憧れである守巫女の役職に就く。"},{"spoiler":false,"text":"背の小ささと貧乳を気にしており、その事を指摘して5秒後に立っていられた者はいないと言われている。"},{"spoiler":false,"text":"名誉も資産もある水乃だが、なぜか守巫女の立場と巫女ノ杜の序列に関して異常とも思える執着を見せる。"}],"source":"egs","sourceCharacterId":"11562","sourceWorkId":"14130","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公·真舟伊月的青梅竹马。"},{"spoiler":false,"text":"小时候在事故中受重伤，被伊月治好后知道了他的神通力，不惜让他拌女装来侍奉巫女神的元凶。"},{"spoiler":false,"text":"虽然有着手比口快的过激性格，但在学园凭借着惊人的装乖技巧和每天毫不懈怠以及巫女们的仰慕而担任守巫女一职。"},{"spoiler":false,"text":"十分在意自己的娇小的身材与贫乳，据说指出这一点的人5秒后没有能站得起来的。"},{"spoiler":false,"text":"水乃虽说是有名有利，却不知为何对作为守巫女的立场和巫女社的排名方面表现出异常的执着。"}],"source":"bangumi","sourceCharacterId":"11099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7028ed5d0869183872c4950da98bab599dda28ef280545d5857bb47e54f11e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8ba7ee28eaf589aa38fbad742dd68cf649dff083cacc32135105686e8dc9bed8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11175:11099:5922:1","source":"bangumi"}]},{"characterId":"char_c46709","characterName":"炎道 紅葉","sourceIds":{"bangumi":[{"characterId":"11100","match":"exact-normalized-name-in-linked-work","subjectId":"11175"}],"egsCharacterIds":["11563"],"vndbCharacterId":"c46709"},"originalCharacterName":"炎道 紅葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"巫女神に仕える守巫女の1人で名門炎道財閥の跡取り娘。"},{"spoiler":false,"text":"生まれも育ちも本物の正真正銘のお嬢様。"},{"spoiler":false,"text":"気位が高く厳しい物言いが多いため敵を作りやすいが、実は誰よりも優しい性格をしていて学園生を大切に思っている。"},{"spoiler":false,"text":"炎道家の名に恥じぬ守巫女という重責に誇りと名誉を感じている。"},{"spoiler":false,"text":"幼い頃から引きこもり気味に育てられたため、人には言えないオタク趣味にドップリはまっており図書室のネットPCを使っての趣味活動が唯一の安らぎの時間となっている。"}],"source":"egs","sourceCharacterId":"11563","sourceWorkId":"14130","spoiler":false},{"segments":[{"spoiler":false,"text":"侍奉巫女神的守巫女之一，名门·炎道财团的继承人。"},{"spoiler":false,"text":"无论出身还是教养都是真正名副其实的大小姐。"},{"spoiler":false,"text":"由于自尊心高傲、常常措辞严厉而容易树敌，但实际上有着比任何人都温柔的性格，十分珍视学园里的学生。"},{"spoiler":false,"text":"怀有作为一个不辱炎道家之名的守巫女的骄傲与矜持。"},{"spoiler":false,"text":"由于小时候就被养在深闺之中，沉浸于不能对人言的宅兴趣，使用图书馆的电脑上网这一兴趣活动成为了她唯一能放松的时间。"}],"source":"bangumi","sourceCharacterId":"11100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2b7e134eb2bd8074f0db5ce0426f81ec897f0d0f57629316bcf99b05f36a845.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dbcf9454474fdabc9b65f24fed38d192a9c16d11c9b3aa604b261a9febbabaa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野梨沙","creatorId":"vndb:s1610","sourcePersonId":"vndb:s1610","canonicalEntityId":"vndb:s1610","name":"雪野 梨沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11175:11100:5903:1","source":"bangumi"}]},{"characterId":"char_c46710","characterName":"風間 奈津","sourceIds":{"bangumi":[{"characterId":"10611","match":"exact-normalized-name-in-linked-work","subjectId":"11175"}],"egsCharacterIds":["11564"],"vndbCharacterId":"c46710"},"originalCharacterName":"風間 奈津","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく元気で屈託のない性格は誰とでもすぐに親しくなれる。"},{"spoiler":false,"text":"どんな時も元気で周りの雰囲気を明るくしてくれる守巫女の中のムードメーカー。"},{"spoiler":false,"text":"運動能力が高くスポーツ万能で巫女ノ杜にはスポーツ特待生枠で入学。"},{"spoiler":false,"text":"しかしこう見えて性的好奇心が非常に旺盛。"},{"spoiler":false,"text":"密かにエロ系雑誌を買ってきては妄想を膨らませるとってもHな女の子。"},{"spoiler":false,"text":"突然現れた異性、伊月に対して並々ならぬ興味を抱く。"}],"source":"egs","sourceCharacterId":"11564","sourceWorkId":"14130","spoiler":false},{"segments":[{"spoiler":false,"text":"侍奉巫女神的守护巫女之一，紅葉的青梅竹马，用“僕”自称。"},{"spoiler":false,"text":"明朗活泼，无忧无虑的性格，和谁都能马上打成一片。"},{"spoiler":false,"text":"无论何时都精力充沛，"},{"spoiler":false,"text":"守护巫女中能让周围空气快乐起来的活跃人士。"},{"spoiler":false,"text":"运动能力出众，体育万能，作为体育优待生进入巫女ノ杜。"},{"spoiler":false,"text":"不过其实她在性方面的好奇心非常旺盛。"},{"spoiler":false,"text":"会偷偷地买来工口杂志肆意妄想，非常H的女孩子。"},{"spoiler":false,"text":"对突然出现的异性伊月有着非比寻常的兴趣。"}],"source":"bangumi","sourceCharacterId":"10611"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e25e787890f5a888e8cccb8db1b8306847dff17921d2ab5d6346ab0f666b518c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b879c45654975a3d684d39f9c2554716814ae951c017dd6f04f64e805244e664.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voi