{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8714","model":{"presentationWorkId":"vndb:v4188","staff":{"artwork":[{"creditedName":"金目鯛ぴんく","creatorId":"vndb:s901","sourcePersonId":"egs:creator:156","canonicalEntityId":"vndb:s901","name":"金目鯛ぴんく","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22264","source":"egs"}],"scenario":[{"creditedName":"大神キリン","creatorId":"vndb:s2326","sourcePersonId":"egs:creator:5428","canonicalEntityId":"vndb:s2326","name":"大神キリン","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22285","source":"egs"},{"creditedName":"哀河童子","creatorId":"vndb:s2930","sourcePersonId":"egs:creator:3269","canonicalEntityId":"vndb:s2930","name":"哀河童子","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22286","source":"egs"},{"creditedName":"春日晶","creatorId":"vndb:s2720","sourcePersonId":"egs:creator:1799","canonicalEntityId":"vndb:s2720","name":"春日晶","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:30406","source":"egs"}],"music":[{"creditedName":"有限会社クワイア","creatorId":"vndb:s1266","sourcePersonId":"egs:creator:4024","canonicalEntityId":"vndb:s1266","name":"有限会社クワイア","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:39268","source":"egs"},{"creditedName":"ジル・ブラッド","creatorId":"vndb:s3051","sourcePersonId":"vndb:s3051","canonicalEntityId":"vndb:s3051","name":"ジル・ブラッド","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:48166","source":"vndb"}],"other":[{"creditedName":"キドカヲル","creatorId":"vndb:s3056","sourcePersonId":"egs:creator:16488","canonicalEntityId":"vndb:s3056","name":"キドカヲル","detail":"主題歌 「アカトキクタチ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:101189","source":"egs"},{"creditedName":"やべあきら","creatorId":"vndb:s40461","sourcePersonId":"egs:creator:40574","canonicalEntityId":"vndb:s40461","name":"やべあきら","detail":"イベントCG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:276414","source":"egs"},{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"OPデモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70229","source":"egs"},{"creditedName":"金目鯛 ぴんく","creatorId":"vndb:s901","sourcePersonId":"vndb:s901","canonicalEntityId":"vndb:s901","name":"金目鯛ぴんく","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:48160","source":"vndb"},{"creditedName":"キド カヲル","creatorId":"vndb:s3056","sourcePersonId":"vndb:s3056","canonicalEntityId":"vndb:s3056","name":"キド カヲル","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:48167","source":"vndb"},{"creditedName":"千田 友紀","creatorId":"vndb:s9964","sourcePersonId":"vndb:s9964","canonicalEntityId":"vndb:s9964","name":"千田 友紀","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:48168","source":"vndb"}]},"cast":[{"characterId":"char_c49727","characterName":"愛姫","sourceIds":{"bangumi":[{"characterId":"90173","match":"exact-normalized-name-in-linked-work","subjectId":"79203"}],"egsCharacterIds":["13932"],"vndbCharacterId":"c49727"},"originalCharacterName":"愛姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Haguro Hizen-no-kami Genjou, the former lord of Hizen. She became the proxy ruler after her father's sudden death from illness. True to her status as a princess, she's naive and unworldly, yet kind and compassionate to everyone. She readily accepts the mysterious Setsuran into her service as strategist. Her curious nature sometimes leads her to sneak onto the battlefield disguised as a foot soldier to follow Uneme..."}],"source":"vndb","sourceCharacterId":"c49727"},{"segments":[{"spoiler":false,"text":"卑前の国、前国主・羽黒卑前守玄丞の娘。"},{"spoiler":false,"text":"急逝した玄丞に成り代わり、国主代理として国を治めることになる。"},{"spoiler":false,"text":"一国の姫らしく、世間知らずで浮世離れしているが、優しく慈愛に満ち溢れ、気丈さをも兼ね備える。"},{"spoiler":false,"text":"好奇心旺盛なところもあり、足軽に扮して戦場に居る羽黒軍四天王の筆頭・矢走畝芽の元に走ることも……。"}],"source":"egs","sourceCharacterId":"13932","sourceWorkId":"8714","spoiler":false},{"segments":[{"spoiler":false,"text":"卑前の国の前国主「羽黒 卑前守 玄丞」（はぐろ ひぜんのかみ げんじょう）の娘。"},{"spoiler":false,"text":"玄丞が急な病で亡くなった為、急遽国主代理として国を治めることになる。一国の姫らしく世間知らずで浮世離れしている一方、誰に対しても優しく、慈しみの心に満ち溢れ、どこの何者とも知れない雪蘭を快く受け入れ、軍師として重用する。"},{"spoiler":false,"text":"好奇心旺盛な一面も持っており、足軽に扮装し、戦場まで畝芽について行ってしまうことも……。"}],"source":"bangumi","sourceCharacterId":"90173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b806ae1fee93697fd30dc28f9e4b85eb6edeae2cfeefe0015c5bf71c013a2ef6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ec9316e6753e3278150728f76b16add43725757ab5a4ac6e7c4caaa05edc66d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79203:90173:4830:1","source":"bangumi"}]},{"characterId":"char_c49728","characterName":"羽黒 茜音","sourceIds":{"bangumi":[{"characterId":"90174","match":"exact-normalized-name-in-linked-work","subjectId":"79203"}],"egsCharacterIds":["13933"],"vndbCharacterId":"c49728"},"originalCharacterName":"羽黒 茜音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of lord Haguro Genjou by a concubine, making her Manahime's half-sister. Treated as an outsider (the concubine's child) since Manahime's birth shortly after her own, this complex fueled her passion for martial arts. She grew into one of the Four Heavenly Kings. Known as the 'Galloping Princess Warrior' for leading her cavalry swiftly across the battlefield. She trained swordsmanship alongside her senior Uneme, her senior in both age and swordsmanship by seven years, and has looked up to him like an older brother since childhood, harboring secret feelings she never shows. She hates being called \"Princess\" and often fights with Uneme over it."}],"source":"vndb","sourceCharacterId":"c49728"},{"segments":[{"spoiler":false,"text":"卑前の国、前国主・羽黒卑前守玄丞の側室の娘。"},{"spoiler":false,"text":"愛姫とは異母姉にあたる。"},{"spoiler":false,"text":"幼少より「妾の子」と蔑まれ続けていたコンプレックスから、武芸に明け暮れ、羽黒軍四天王の一角を担うほどの女丈夫に成長し、「疾風の武者姫」と渾名されるようになる。"},{"spoiler":false,"text":"畝芽は兄弟子として一緒に鍛錬した仲で、兄のように慕い、ほのかな恋心を抱いているようだ。"}],"source":"egs","sourceCharacterId":"13933","sourceWorkId":"8714","spoiler":false},{"segments":[{"spoiler":false,"text":"羽黒玄丞の側室の娘で愛姫の異母姉。茜音が生まれて間も無く、正室が愛姫を産んだ為、「妾の子」として一線を引いた扱いをされ続けてきた。"},{"spoiler":false,"text":"そのコンプレックスから、幼い頃より武芸を好み、四天王の一角を担うほどに成長。誰よりも早く戦場に駆けつけ、騎馬を率いて戦場を駆け巡る姿から『疾風の武者姫』との異名を誇る。"},{"spoiler":false,"text":"7歳上の畝芽とは兄弟子として共に剣術を学んだ仲で、幼い頃から兄のように慕い、ほのかな恋心を抱いているが、その想いを決して表に出そうとはしない。「姫」と呼ばれることを嫌い、それをネタによく畝芽とケンカをしている。"}],"source":"bangumi","sourceCharacterId":"90174"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3da8da2641ec45b93a93511dc2c1620b09ef0ada5332ccdc81918f1089352e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d81eca2e5ad835c170d6f833266311e0a59ca80015b46c278174c3469449a746.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79203:90174:8055:1","source":"bangumi"}]},{"characterId":"char_c49729","characterName":"烏丸 雪蘭","sourceIds":{"bangumi":[{"characterId":"90175","match":"exact-normalized-name-in-linked-work","subjectId":"79203"}],"egsCharacterIds":["13934"],"vndbCharacterId":"c49729"},"originalCharacterName":"烏丸 雪蘭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A genius female strategist who suddenly appeared amidst the chaos of war and became another member of the Four Heavenly Kings. Having trained under various military tacticians, she proposed revolutionary recruitment methods for the outnumbered Haguro army. Her strategies are ruthlessly effective, chilling even her allies. Usually quiet and expressionless, she becomes animated and joyful when discussing tactics in war councils or commanding on the battlefield."}],"source":"vndb","sourceCharacterId":"c49729"},{"segments":[{"spoiler":false,"text":"劣勢を強いられていた卑前の国に突如として現れた天才軍師。"},{"spoiler":false,"text":"各地の兵法家の元で用兵、戦術等を学び、研鑽を重ねてきた彼女が発案した募兵方法は冷酷さを極め、味方さえも恐れおののくものだった。"},{"spoiler":false,"text":"普段は無口で無表情だが、軍議の場や戦場においては、その軍略を饒舌に語り、嬉々とした表情を見せる。"}],"source":"egs","sourceCharacterId":"13934","sourceWorkId":"8714","spoiler":false},{"segments":[{"spoiler":false,"text":"戦乱の中、突然羽黒軍に現れた天才女軍師。各地の兵法家の元で研鑽を重ねた軍師で、人的不利に立たされている羽黒軍に、画期的な募兵方法を提案する。その戦略は冷酷さを極め、味方さえ震え上がらせる。"},{"spoiler":false,"text":"普段は口数が少なく無表情だが、軍議の場や戦場などでは、溢れんばかりの軍略を語り、嬉々とした表情で軍配を振るう。"}],"source":"bangumi","sourceCharacterId":"90175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e72c9e0decea7cfd4f9fafd6483e33c75019cda73b205a3b46908518ac938321.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1a613046af7f24701c4ade32a8b03282159d3adba4253aa16bfae18f3256b8a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79203:90175:4463:1","source":"bangumi"}]},{"characterId":"char_c49730","characterName":"桔梗","sourceIds":{"bangumi":[{"characterId":"90176","match":"exact-normalized-name-in-linked-work","subjectId":"79203"}],"egsCharacterIds":["13935"],"vndbCharacterId":"c49730"},"originalCharacterName":"桔梗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful assassin directly under Imae Yoshinori's command. Trained as a kunoichi, her exceptional combat skills led to her specializing in the more dangerous task of assassination. Her work is precise - she has never missed a target. Raised from birth in a ninja village, Kikyou knows no other life; for her, \"living\" is synonymous with \"killing people\"."}],"source":"vndb","sourceCharacterId":"c49730"},{"segments":[{"spoiler":false,"text":"敵国・卑後の国、国主・今柄義範直属のくノ一。"},{"spoiler":false,"text":"忍としての才能を義範に買われ、主に暗殺の仕事を任される。"},{"spoiler":false,"text":"その仕事の手際は正確無比で、狙った獲物を逃したことはないという。"},{"spoiler":false,"text":"生まれたときから忍の里に育ち、忍としての生き方しか知らず、彼女にとって「生きる」とは「人を殺す」ことと同義とされる。"}],"source":"egs","sourceCharacterId":"13935","sourceWorkId":"8714","spoiler":false},{"segments":[{"spoiler":false,"text":"今柄義範直属の美貌の女刺客。"},{"spoiler":false,"text":"くのいちとしての修行を積んでいたが、その戦闘能力の高さを買われ、より危険な任務「暗殺」をメインに行う、義範直属の刺客となる。"},{"spoiler":false,"text":"その仕事は正確さを極め、狙った獲物を逃した事は一度も無い。"},{"spoiler":false,"text":"生まれた時から忍びの里で育ち、それ以外の生き方を知らない桔梗にとって、「生きること」と「人を殺すこと」は同義である。"}],"source":"bangumi","sourceCharacterId":"90176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed9e9c00e66ba060c0725e08d21e3bc1c3d0adcf5ea1e5e7128c046f564da90e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f5c9b4656df8ceb8bd305844521ef9e304d897541535fb0cced54c177b0bf16.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"歌織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79203:90176:12717:1","source":"bangumi"}]},{"characterId":"char_vndb_c49731","characterName":"真田 彦三郎","sourceIds":{"vndbCharacterId":"c49731"},"originalCharacterName":"真田 彦三郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The oldest of the Haguro army's Four Heavenly Kings, he is deeply trusted by his comrades. Having endured countless brutal battles, he remains unflappable, inspiring confidence in his troops. More adept at defense than offense, he's often tasked with guarding key positions, earning him the moniker 'Unmovable Hikosaburou'. Gentle and approachable, but once his temper ignites, no one can stop him. Fiercely loyal, he would gladly lay down his life for his comrades. He is a renowned commander within the Haguro army."}],"source":"vndb","sourceCharacterId":"c49731"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/618e835d474eda4d9e4a0dc8e1ad5b64a3c77ac231759961b2c309c57ba9db09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/754e98d7ea50b859da0abf4320ffb9a7328d877b838bc5ab4faffd614404f235.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c49732","characterName":"今柄 義範","sourceIds":{"vndbCharacterId":"c49732"},"originalCharacterName":"今柄 義範","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lord of Higo. His personality is perverse and insidious. His invasion of Hizen was largely motivated by having exhausted all desirable women within Higo and seeking new prey. During intimate encounters, he forces women to utter vulgarities, earning him the nickname 'Lord of Lewdness'. Women who fail to satisfy him with obscene talk are given to his subordinates as comfort women, treated like public toilets."}],"source":"vndb","sourceCharacterId":"c49732"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a5dd34b8f6ff0b64ae621cb7db5d78af4da8ecc7eaeb9f35b5d403345225ec4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25dba8a1395386858226a1cb5bf7009217f754955aeee6f98bbc472e5b5b72c2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中澤 歩","creatorId":"vndb:s1490","sourcePersonId":"vndb:s1490","canonicalEntityId":"vndb:s1490","name":"中澤歩(中澤アユム","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26712","source":"vndb"}]},{"characterId":"char_vndb_c49733","characterName":"乱獄","sourceIds":{"vndbCharacterId":"c49733"},"originalCharacterName":"乱獄","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strategist directly under Imae Yoshinori. His tactics are precise and ruthless. He seems to enjoy manipulating people and toying with lives; battlefields under his direct command become scenes of extreme carnage. Possessing beauty easily mistaken for a woman's, rumors swirl within the Imae household that he also serves as Yoshinori's attendant. Though only recently joining the Imae forces, his beauty and intellect earned him the strategist position. It was Rangaku's schemes that convinced Yoshinori to invade Hizen."}],"source":"vndb","sourceCharacterId":"c49733"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d58bfb40a078ab24d833b3668a6fcd06741710c509961e8481e9fd1ebdc5eb9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01226a43862f9f05837d879feef411eed91958b414d643138ef2bda75a7dbfc2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深井 晴花","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26707","source":"vndb"}]},{"characterId":"char_vndb_c49734","characterName":"さくら","sourceIds":{"vndbCharacterId":"c49734"},"originalCharacterName":"さくら","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","