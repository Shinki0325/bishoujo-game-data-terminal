"spoiler":false,"text":"だけど、芯が強く強情な一面もある。"},{"spoiler":false,"text":"普段は、学生として学校に通い勉学に励んだり、実家の喫茶店「るなルナ」の手伝いをしている。"}],"source":"egs","sourceCharacterId":"7069","sourceWorkId":"22388","spoiler":false},{"segments":[{"spoiler":false,"text":"世界を守る使命を託された聖戦使 “ルナティック・エンジェルズ” のリーダー。"},{"spoiler":false,"text":"ごく普通の学生だったが、数年前に月の女神から ルナティック・ジェム を授けられ、"},{"spoiler":false,"text":"愛と正義を守る魔法少女 “ルナティック・エンジェル” となった。"},{"spoiler":false,"text":"普段は学生として学園に通う、純真でまじめな女の子。"},{"spoiler":false,"text":"人懐っこく温厚柔和な性格だが、芯が強く強情な一面もある。"},{"spoiler":false,"text":"家では 3人の姉たちと一緒に、家業の喫茶店・るなルナ の手伝いをしている。"},{"spoiler":false,"text":"「月の加護がある限り、卑劣なオジサンには決して負けません！」"}],"source":"bangumi","sourceCharacterId":"149308"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"7069","sourceWorkId":"22388","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"7069","sourceWorkId":"22388","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"7069","sourceWorkId":"22388","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"7069","sourceWorkId":"22388","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"7069","sourceWorkId":"22388","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cf387b007a2cf5d6d68419e2d97410fce255922bb189efe3482a79b7c727cc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e34e2adc5e75ec6911f1ac35b8339628dc49511c1b263f2070b310fee65ce658.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八ッ橋きなこ","creatorId":"vndb:s353","sourcePersonId":"vndb:s353","canonicalEntityId":"vndb:s353","na