Status":"source-native","relationId":"vndb:vn-staff:157746","source":"vndb"},{"creditedName":"八月朔日 珈瑠","creatorId":"vndb:s4915","sourcePersonId":"vndb:s4915","canonicalEntityId":"vndb:s4915","name":"八月朔日珈瑠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157748","source":"vndb"},{"creditedName":"雪屋町","creatorId":"vndb:s10383","sourcePersonId":"vndb:s10383","canonicalEntityId":"vndb:s10383","name":"原 英里佳","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157749","source":"vndb"},{"creditedName":"河原 ゆう","creatorId":"vndb:s13712","sourcePersonId":"vndb:s13712","canonicalEntityId":"vndb:s13712","name":"河原 ゆう","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:157750","source":"vndb"},{"creditedName":"アトリエ空機関","creatorId":"vndb:s14253","sourcePersonId":"vndb:s14253","canonicalEntityId":"vndb:s14253","name":"アトリエ空機関(Atelier 空機関、空機関)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157751","source":"vndb"},{"creditedName":"Rin","creatorId":"vndb:s14351","sourcePersonId":"vndb:s14351","canonicalEntityId":"vndb:s14351","name":"Rin","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:157752","source":"vndb"},{"creditedName":"imamura","creatorId":"vndb:s15618","sourcePersonId":"vndb:s15618","canonicalEntityId":"vndb:s15618","name":"imamura","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157754","source":"vndb"}]},"cast":[{"characterId":"char_c83594","characterName":"カシマ・ヒカリ","sourceIds":{"bangumi":[{"characterId":"70486","match":"exact-normalized-name-in-linked-work","subjectId":"284362"}],"egsCharacterIds":["21466"],"vndbCharacterId":"c83594"},"originalCharacterName":"カシマ・ヒカリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The tough female swordswoman with the urge to breed♥"},{"spoiler":false,"text":"Profession: Samurai"},{"spoiler":false,"text":"Country: The island of the rising sun, Akitsushima"},{"spoiler":false,"text":"Race: Human"},{"spoiler":false,"text":"Height: A little short"},{"spoiler":false,"text":"Breast Size: Big"},{"spoiler":false,"text":"While the country does not boast much in the way of power, the people of Akitsushima are a warrior race, who hold pride in the fact that their country has never once been defeated since its' creation. In all of Akitsushima, the girl Kashima Hikari alone is feared as the strongest at the sword. For the sake of her country, she has traveled to Laurentia to steal the seed of the hero."},{"spoiler":false,"text":"She challenges the hero to a duel, but the power of the hero reaches directly to her (to her womb), and she inadvertently drops her katana. But for samurai of Akitsushima, one's katana is an object more important than their life. As such, Hikari admits her defeat."},{"spoiler":false,"text":"「The man who knocks me up, he must be none other than the strongest man in all the world!」"}],"source":"vndb","sourceCharacterId":"c83594"},{"segments":[{"spoiler":false,"text":"国力は小さいながら、建国以来、常勝不敗を誇る戦闘民族の国、“アキツシマ”。そのアキツシマで最強の剣士と恐れられる少女。皇国のためならばと、主人公の種を奪いに、ローレンシアにやって来た。"},{"spoiler":false,"text":"主人公に勝負を挑むも、勇者としての異能をまともに（子宮に）喰らって、思わず刀を取り落としてしまう。剣士にとって、刀は命よりも大事なもの。そうして、ヒカリは自分の負けを認めるのだった。"}],"source":"egs","sourceCharacterId":"21466","sourceWorkId":"28031","spoiler":false},{"segments":[{"spoiler":false,"text":"国力は小さいながら、建国以来、常勝不敗を誇る戦闘民族の国、“アキツシマ”。そのアキツシマで最強の剣士と恐れられる少女。皇国のためならばと、主人公の種を奪いに、ローレンシアにやって来た。"},{"spoiler":false,"text":"主人公に勝負を挑むも、勇者としての異能をまともに（子宮に）喰らって、思わず刀を取り落としてしまう。剣士にとって、刀は命よりも大事なもの。そうして、ヒカリは自分の負けを認めるのだった。"}],"source":"bangumi","sourceCharacterId":"70486"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e999b2a64300f4844025cd02d757312cfab31852e75d20b3a507305332e1335e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4ce1bb0c75a3689638ffea2c7e0c8e161115c328763b3ecc4ed3527a8a1257db.webp","width":256,"height":219,"source":"static-detail"},"actors":[{"creditedName":"清水美紗","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284362:70486:21151:1","source":"bangumi"}]},{"characterId":"char_c83595","characterName":"アーレンシア・ヨナ・エルボーグ","sourceIds":{"bangumi":[{"characterId":"70487","match":"exact-normalized-name-in-linked-work","subjectId":"284362"}],"egsCharacterIds":["21493"],"vndbCharacterId":"c83595"},"originalCharacterName":"アーレンシア・ヨナ・エルボーグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The proud female knight of the Empire."},{"spoiler":false,"text":"Profession: Knight of the Imperial Guard"},{"spoiler":false,"text":"Country: The Holy Imperium, Valhalla"},{"spoiler":false,"text":"Race: Human"},{"spoiler":false,"text":"Height: Slightly tall"},{"spoiler":false,"text":"Breast size: Big"},{"spoiler":false,"text":"Under instruction from their gods, the great western empire of Valhalla seeks to broaden its' lands."},{"spoiler":false,"text":"In Valhalla, Alencia holds the vaulted position of \"Head of the First Order of Imperial Knights, in Guard of Her Royal Princess\", which is to say she is the strongest knight."},{"spoiler":false,"text":"In order to further spread the influence of Valhalla's gods across the world, she travels to Laurentia, to take the hero's seed."},{"spoiler":false,"text":"Her pride is excessive, to say the least, and her tendency to shout \"I'll kill you for that!\" at the slightest provocation tends to make those around her quite ill at ease."},{"spoiler":false,"text":"While she was rather curt with the protagonist at the start, after he saved her from an energetic orc, she quickly finds herself falling for him."},{"spoiler":false,"text":"「Though I know it's for the Empire, to have to take the seed of a pitiful man such as yourself... I'd just as soon kill you.」"}],"source":"vndb","sourceCharacterId":"c83595"},{"segments":[{"spoiler":false,"text":"神の教えによって版図拡大を狙う、西の大帝国、“ヴァルハラ”。彼女はそのヴァルハラで、“第一皇女付近衛騎士団長”という立派な役職に就いているが、要は最強の剣士である。神の威光であまねく世界を覆うべく、主人公の種を奪いに、ローレンシアにやって来た。"},{"spoiler":false,"text":"プライドがやたらと高く、ちょっとしたことでも、「くっ殺せ」などと口走るので、よく周囲を困惑させている。最初こそ素っ気なかったが、ヤる気マンマンのオークから主人公が救ってくれたことで、早速デレてくれる。"}],"source":"egs","sourceCharacterId":"21493","sourceWorkId":"28031","spoiler":false},{"segments":[{"spoiler":false,"text":"神の教えによって版図拡大を狙う、西の大帝国、“ヴァルハラ”。彼女はそのヴァルハラで、“第一皇女付近衛騎士団長”という立派な役職に就いているが、要は最強の剣士である。神の威光であまねく世界を覆うべく、主人公の種を奪いに、ローレンシアにやって来た。"},{"spoiler":false,"text":"プライドがやたらと高く、ちょっとしたことでも、「くっ殺せ」などと口走るので、よく周囲を困惑させている。最初こそ素っ気なかったが、ヤる気マンマンのオークから主人公が救ってくれたことで、早速デレてくれる。"}],"source":"bangumi","sourceCharacterId":"70487"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f74f66316ebf4b342bce2dc079a0284edf5d2a5339904f7dae710983871e0e11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34d91a5b3fc9edef8ff522d37247d799055844fad9cb02a12be4a7a4ec43a7a2.webp","width":256,"height":219,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284362:70487:8055:1","source":"bangumi"}]},{"characterId":"char_c83596","characterName":"エーリッテ","sourceIds":{"bangumi":[{"characterId":"70488","match":"exact-normalized-name-in-linked-work","subjectId":"284362"}],"egsCharacterIds":["21494"],"vndbCharacterId":"c83596"},"originalCharacterName":"エーリッテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The listless Princess who has an immense interest in the erotic?"},{"spoiler":false,"text":"Profession: Princess"},{"spoiler":false,"text":"Country: The distant realm of Elfheim"},{"spoiler":false,"text":"Race: Elf"},{"spoiler":false,"text":"Height: Tall"},{"spoiler":false,"text":"Breast size: Smaller than others, yes, but still quite big"},{"spoiler":false,"text":"In the far off kingdom of Elfheim, the elves live in peace and harmony. Under instruction from the King who desires nothing but peace, the princess Eritte arrives to receive the seed of the hero."},{"spoiler":false,"text":"Though rather somber and always bringing a downer mood to those around her, Eritte actually really loves lewd things."},{"spoiler":false,"text":"She also really loves the protagonist, who managed to become her very first partner."},{"spoiler":false,"text":"Elves being elves, they spend most of their time living in the forest... which makes them a little lacking when it comes to common sense. As a member of Royalty, she bears no family name."},{"spoiler":false,"text":"「Guess there's no way around it... It's for the peace of the world and all that. I'll bear your child...」"}],"source":"vndb","sourceCharacterId":"c83596"},{"segments":[{"spoiler":false,"text":"どこか遠いところにあって、エルフたちが平和に暮らす王国、“エルフヘイム”。平和を心から願う王様の命により、主人公の種をもらい受けにやって来た王女様。"},{"spoiler":false,"text":"いつも物憂げでダウナーな雰囲気を漂わせているが、実はエッチが大好き。自分の初めての相手となった主人公のことも大好き。"},{"spoiler":false,"text":"エルフは、基本的に、エルフだけで森の中で暮らしているため、少々常識にうといところがある。なお、王族のため、ファミリーネームはない。"}],"source":"egs","sourceCharacterId":"21494","sourceWorkId":"28031","spoiler":false},{"segments":[{"spoiler":false,"text":"どこか遠いところにあって、エルフたちが平和に暮らす王国、“エルフヘイム”。平和を心から願う王様の命により、主人公の種をもらい受けにやって来た王女様。"},{"spoiler":false,"text":"いつも物憂げでダウナーな雰囲気を漂わせているが、実はエッチが大好き。自分の初めての相手となった主人公のことも大好き。"},{"spoiler":false,"text":"エルフは、基本的に、エルフだけで森の中で暮らしているため、少々常識にうといところがある。なお、王族のため、ファミリーネームはない。"}],"source":"bangumi","sourceCharacterId":"70488"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/812155f3cd93e1cad21f9fdd597d288f2525880969e962526a569ceed27adfec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9866aa13328e5bedfc6c2c2d5664a322bd35a422445deb45aa16d8b760963929.webp","width":256,"height":219,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284362:70488:15995:1","source":"bangumi"}]},{"characterId":"char_c83597","characterName":"マドリー・パルネポリ","sourceIds":{"bangumi":[{"characterId":"70489","match":"exact-normalized-name-in-linked-work","subjectId":"284362"}],"egsCharacterIds":["21495"],"vndbCharacterId":"c83597"},"originalCharacterName":"マドリー・パルネポリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Goddess who's given up on men."},{"spoiler":false,"text":"Profession: Right now? Flower vendor. Before? Priestess."},{"spoiler":false,"text":"Country: The promised land of Sumerian"},{"spoiler":false,"text":"Race: Diva (demigod)"},{"spoiler":false,"text":"Height: Average"},{"spoiler":false,"text":"Breast size: Extremely big"},{"spoiler":false,"text":"Long, long ago, before humanity even knew how to write, existed Sumerian. The land granted by the gods. In that land, prostitutes are revered as priests..."},{"spoiler":false,"text":"But even though that is true, Madorie still would rather not embrace a man she does not love. And so, possessing only the clothes on her back, she fled from Sumerian, all the way to Essenbaum. There she has her fated encounter with the protagonist."},{"spoiler":false,"text":"With an existence like that of a goddess, Diva women have given up on men as husbands, yet still seem to possess overflowing love and maternal affection..."},{"spoiler":false,"text":"「Alright, let's you and I make children♥」"}],"source":"vndb","sourceCharacterId":"c83597"},{"segments":[{"spoiler":false,"text":"まだ文字も無かった上古の昔、神との約束によって賜れた土地、“スメリアン”。そこでは、娼婦は聖職者としてあがめられていた…。とはいえ、好きでもない男に抱かれるのはやっぱり嫌と、彼女は着の身着のまま、はるばるエッセンバウムまで逃げてきた。そこで主人公と運命的な出会いをすることになる。"},{"spoiler":false,"text":"女神に近い存在の彼女たちは、夫となった男のことを、“駄目”にしてしまうような、母性と愛情に溢れているらしい…。"}],"source":"egs","sourceCharacterId":"21495","sourceWorkId":"28031","spoiler":false},{"segments":[{"spoiler":false,"text":"まだ文字も無かった上古の昔、神との約束によって賜れた土地、“スメリアン”そこでは、娼婦は聖職者としてあがめられていた…。とはいえ、好きでもない男に抱かれるのはやっぱり嫌と、彼女は着の身着のまま、はるばるエッセンバウムまで逃げてきた。そこで主人公と運命的な出会いをすることになる。"},{"spoiler":false,"text":"女神に近い存在の彼女たちは、夫となった男のことを、“駄目”にしてしまうような、母性と愛情に溢れているらしい…。"}],"source":"bangumi","sourceCharacterId":"70489"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2009bb229cea5c68350b45996cea403d7cd91c103ba8a0ec70a97a3459579050.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32c9ad88af8f0764d0032153e8c2abeef30707cb17ac14a4d26720cd52f2a099.webp","width":256,"height":219,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284362:70489:17075:1","source":"bangumi"}]},{"characterId":"char_c83598","characterName":"真木柱 夕奈","sourceIds":{"bangumi":[{"characterId":"70490","match":"exact-normalized-name-in-linked-work","subjectId":"284362"}],"egsCharacterIds":["21496"],"vndbCharacterId":"c83598"},"originalCharacterName":"真木柱 夕奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The wandering fortune teller."},{"spoiler":false,"text":"Profession: Fortune Teller"},{"spoiler":false,"text":"Country: The Women's Autonomous Commune of Yoshinohara"},{"spoiler":false,"text":"Race: Youko"},{"spoiler":false,"text":"Height: A little short"},{"spoiler":false,"text":"Breasts: Big"},{"spoiler":false,"text":"Whatever a man's heredity or position may be, whatever his rank or social status may be, the moment he steps foot past the gate to Yoshinohara he is stripped of all of them until he is nothing more than yet another naked male. In this autonomous community of Yoshinohara, Yuuna befriends the prostitutes whose troubles are so many, and runs a business at divination and fortune telling. Her magical abilities are so strong, she has gained a reputation at being able to divine most anything; from the identity of your lover's adulterous partner to that thing you lost and have been looking for, she can find it all."},{"spoiler":false,"text":"As a native of Yoshinohara, Yuuna's speech tends to reflect that used by the courtesans and prostitutes she lives with, though she herself is no lady of the night. She hears rumors about the Hero Who'd Be a Father, and decides head to Laurentia to maybe go tell him his fortune. Though... for all her ability at telling the fortune's of others, she has never been able to tell her own future."},{"spoiler":false,"text":"「If it's you and I, master, no doubt I'll give birth to a beautiful gem of a child.」"}],"source":"vndb","sourceCharacterId":"c83598"},{"segments":[{"spoiler":false,"text":"男たちは、“葦ノ原”の門を一歩くぐれば、生まれの貴賎、職の上下など一切の虚飾がはぎ取られ、一個の裸のオスとなる。女たちの自治都市、葦ノ原で、悩み多き遊女たちを相手に占い業を営んでいる。その強力な妖力で、間夫の浮気相手から失せ物探しまで、何でも良く当たると評判だった。"},{"spoiler":false,"text":"生まれも葦ノ原のため、ついオイラン言葉が移ってしまったが、夕奈自身は遊女ではない。勇者の父親爆誕の噂を聞きつけ、ちと占ってやろうと、はるばるローレンシアまでやって来た。なお、自分自身について占うことはできない。"}],"source":"egs","sourceCharacterId":"21496","sourceWorkId":"28031","spoiler":false},{"segments":[{"spoiler":false,"text":"男たちは、“葦ノ原”の門を一歩くぐれば、生まれの貴賎、職の上下など一切の虚飾がはぎ取られ、一個の裸のオスとなる。女たちの自治都市、葦ノ原で、悩み多き遊女たちを相手に占い業を営んでいる。その強力な妖力で、間夫の浮気相手から失せ物探しまで、何でも良く当たると評判だった。"},{"spoiler":false,"text":"生まれも葦ノ原のため、ついオイラン言葉が移ってしまったが、夕奈自身は遊女ではない。勇者の父親爆誕の噂を聞きつけ、ちと占ってやろうと、はるばるローレンシアまでやって来た。なお、自分自身について占うことはできない"}],"source":"bangumi","sourceCharacterId":"70490"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3378c7081751d22a1e3e866940f9637bc49a72fac4d6a3279dda3dcb3440268a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e38d8b3c5236c96ffbabd0f1bff4e66e7ebb47cc71154fe473f172705b24aa94.webp","width":256,"height":219,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284362:70490:5075:1","source":"bangumi"}]},{"characterId":"char_c83599","characterName":"アンナ・ハイリッテ","sourceIds":{"bangumi":[{"characterId":"70491","match":"exact-normalized-name-in-linked-work","subjectId":"284362"}],"egsCharacterIds":["21497"],"vndbCharacterId":"c83599"},"originalCharacterName":"アンナ・ハイリッテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The girl who, even at first meeting, treats you like a long lost friend."},{"spoiler":false,"text":"Profession: Poster girl for \"The Peaceful Arbor of the Wolf\""},{"spoiler":false,"text":"Country: The Center of the World, Laurentia."},{"spoiler":false,"text":"Race: Human (Quarter Nymph)"},{"spoiler":false,"text":"Height: About average"},{"spoiler":false,"text":"Breast size: Big."},{"spoiler":false,"text":"The Republic of Laurentia is the center most country, and hub of the world."},{"spoiler":false,"text":"At the center of the Laurentia lies the city of Essenbaum, and it is there that Anna works as a restaurant waitress."},{"spoiler":false,"text":"With amazing looks and a personality to match, she has received no end of interested courtiers, but somehow none of them ever sparked her interest."},{"spoiler":false,"text":"And so, as much as the marriage proposals keep fluttering in, she has never yet known love."},{"spoiler":false,"text":"Her own lack of love actually had her secretly worried, but then an accident happens and she is saved by the protagonist..."},{"spoiler":false,"text":"Just like that, for the very first time in her life, she feels a certain throbbing from her womb."},{"spoiler":false,"text":"「I'll do my best! I'll give it my all, and give birth to a strong and healthy child for you!」"}],"source":"vndb","sourceCharacterId":"c83599"},{"segments":[{"spoiler":false,"text":"世界の中心にあるという“ローレンシア共和国”。その中心都市“エッセンバウム”で、レストランの店員として働いている女の子。器量よし・気立てよしということで、求婚は絶えなかったが、誰と会ってもいまいちその気になれなかった。"},{"spoiler":false,"text":"縁談ならいくらでも舞い込んでくるのに、いまだ恋も知らない。そのことで密かに悩んでいた彼女だが、とある事故から主人公に助けられたとき…、初めて、子宮がうずくという感覚を覚えてしまうのだった。"}],"source":"egs","sourceCharacterId":"21497","sourceWorkId":"28031","spoiler":false},{"segments":[{"spoiler":false,"text":"世界の中心にあるという“ローレンシア共和国”。その中心都市“エッセンバウム”で、レストランの店員として働いている女の子。器量よし・気立てよしということで、求婚は絶えなかったが、誰と会ってもいまいちその気になれなかった。"},{"spoiler":false,"text":"縁談ならいくらでも舞い込んでくるのに、いまだ恋も知らない。そのことで密かに悩んでいた彼女だが、とある事故から主人公に助けられたとき…、初めて、子宮がうずくという感覚を覚えてしまうのだった。"}],"source":"bangumi","sourceCharacterId":"70491"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8613594b71742110ee97a025f06784f624b35a313609783fe47520dfcd44b825.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab7de6a452c61047e2d46ff70cb33e43011e124c592db48e3853169909702a0b.webp","width":256,"height":219,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284362:70491:10662:1","source":"bangumi"}]},{"characterId":"char_c83600","characterName":"エルダ・ハイリッテ","sourceIds":{"bangumi":[{"characterId":"70492","match":"exact-normalized-name-in-linked-work","subjectId":"284362"}],"egsCharacterIds":["21498"],"vndbCharacterId":"c83600"},"originalCharacterName":"エルダ・ハイリッテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The beauty who's a genuine star, yet still manages to be good humored and kind"},{"spoiler":false,"text":"Profession: Dancer"},{"spoiler":false,"text":"Country: The Center of the World, Laurentia"},{"spoiler":false,"text":"Race: Human (Quarter Nymph)"},{"spoiler":false,"text":"Height: Tall"},{"spoiler":false,"text":"Breast size: Extremely big."},{"spoiler":false,"text":"The biggest theater in Essenbaum (and thus also the biggest theatre in the entire world) is the \"Golden Theatre\"."},{"spoiler":false,"text":"To take the stage there is the highest honor a performer could hope to achieve, and of all the theatre's performers, its number one star is Elda, the Dancer."},{"spoiler":false,"text":"Up until now, the stage was all that Elda ever thought about, to the point that she avoided associating with men."},{"spoiler":false,"text":"However, on meeting the hero she starts to think \"Marriage and having children, maybe those could be good, too?\""},{"spoiler":false,"text":"She is Anna's elder sister, and the two have a really good relationship together."},{"spoiler":false,"text":"Since she's a quarter forest nymph, there are some who theorize it's her magical Nymph charm which makes her dancing as appealing as it is."},{"spoiler":false,"text":"「If it's for you, and for your child, I have no problem giving up my life as a dancer.」"}],"source":"vndb","sourceCharacterId":"c83600"},{"segments":[{"spoiler":false,"text":"エッセンバウム最大、つまりは世界最大の劇場、“ゴールデン・シアター”。そのステージに立つのは芸人にとって最高の誉れという劇場において、人気ナンバーワンを誇るスターな踊り子。これまで踊り子であることを第一に考えていて、男との付き合いも避けてきたが、主人公と出会ったことで、結婚・出産もいいかな？　と思うようになった。"},{"spoiler":false,"text":"アンナの姉。姉妹仲はとてもいい。森の妖精、ニンフとのクォーターで、その魔力が踊りにさらなる魅力を加えているという説もある。"}],"source":"egs","sourceCharacterId":"21498","sourceWorkId":"28031","spoiler":false},{"segments":[{"spoiler":false,"text":"エッセンバウム最大、つまりは世界最大の劇場、“ゴールデン・シアター”。そのステージに立つのは芸人にとって最高の誉れという劇場において、人気ナンバーワンを誇るスターな踊り子。これまで踊り子であることを第一に考えていて、男との付き合いも避けてきたが、主人公と出会ったことで、結婚・出産もいいかな？　と思うようになった。"},{"spoiler":false,"text":"アンナの姉。姉妹仲はとてもいい。森の妖精、ニンフとのクォーターで、その魔力が踊りにさらなる魅力を加えているという説もある。"}],"source":"bangumi","sourceCharacterId":"70492"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc96381d5c9545de917ff14b23d3d6e58a63ec8bff8c3e255dbf91454ace3d3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d366c8adfaceb42cdb6bfc5945d2d29282d3b4c830d53dd119bfb92a3f2fa74.webp","width":256,"height":219,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284362:70492:15637:1","source":"bangumi"}]},{"characterId":"char_c83601","characterName":"セジマ・セイヤ","sourceIds":{"bangumi":[],"egsCharacterIds":["23319"],"vndbCharacterId":"c83601"},"originalCharacterName":"セジマ・セイヤ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Hero"},{"spoiler":false,"text":"Profession: Cook"},{"spoiler":false,"text":"Birthplace: Tokyo, Japan"},{"spoiler":false,"text":"Race: Human"},{"spoiler":false,"text":"A man from another world. He had turned twenty without once having done it, so he got concerned."},{"spoiler":false,"text":"Due to a certain incident, he finds himself flung into the parallel world of Laurentide."},{"spoiler":false,"text":"Although he's never gone all the way with a woman before, he finds himself at the center of of a prophecy that is attracting many beautiful suitors. His mission is to have as much baby-making sex as possible!"}],"source":"vndb","sourceCharacterId":"c83601"},{"segments":[{"spoiler":false,"text":"主人公。一つの運命が終わったかと思ったら、またも別の運命を背負うことになった。その運命とはやっぱり子作りである。"},{"spoiler":false,"text":"７人の奥様＆お腹には７人の赤ちゃんがいるのに、別の女性と子作りセックスなんて許されるのか…？　と思う人もいるでしょうが、許されます！"}],"source":"egs","sourceCharacterId":"23319","sourceWorkId":"30597","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03aaf3160e64752d80e1e8b2eeec0c3836f468e5742e672fd6be39e053ac7d92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/449cfed44c6b7cf27143c9fb7bd38495b3332cc6bf3e33581037612e19a04e1c.webp","width":256,"height":100,"source":"static-detai