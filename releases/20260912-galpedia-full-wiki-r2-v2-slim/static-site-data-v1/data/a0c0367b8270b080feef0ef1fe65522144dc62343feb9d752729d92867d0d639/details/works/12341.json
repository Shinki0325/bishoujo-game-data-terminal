wiki/v1/characters/v1/images/92/92e881a740b7a3e835aa03b7bb2cd90a7b427f5017ca0d650d58b5c6343fa124.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40073cfbdbbb7bd86fb553a900265c9fb983a8145e128a4c65e5d2ea28e91eef.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大石 けいぞう","creatorId":"vndb:s72","sourcePersonId":"vndb:s72","canonicalEntityId":"vndb:s72","name":"近藤 隆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15637","source":"vndb"}]},{"characterId":"char_vndb_c64395","characterName":"日下部 アキナ","sourceIds":{"vndbCharacterId":"c64395"},"originalCharacterName":"日下部 アキナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haru's younger sister."}],"source":"vndb","sourceCharacterId":"c64395"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/9476b1a190177f9cb6b8c108803f9441b3870dc6eca3fe88a1b2a2bdea5b5b53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5a0987c58d11e6ea8d5db2556fd811a39169d05ae11d78eb6b401f2e18a6ea5.webp","width":173,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c7630","characterName":"早坂 サツキ","sourceIds":{"vndbCharacterId":"c7630"},"originalCharacterName":"早坂 サツキ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Satsuki is an unconfident, shy third-year high schooler afraid to fall in love (and of men to a small extent). Satsuki's negative attitude to romance was born from an event 5 years ago, during junior high school. She decided to pluck up her courage and confess her feelings to her first love and childhood friend, Kanade. However, she overhears Kanade saying to his classmate that he has no interest whatsoever in \"a girl like her\". To make matters worse, just before he was bound for Austria, Kanade told her that she was ugly and that she should keep her glasses on to hide her hideous face."},{"spoiler":false,"text":"In spite of her plain appearance, Satsuki has a great love for sewing and clothes. After seeing a Takarazuka (a Japanese musical where female actresses take on roles as male characters) performance, Satsuki is greatly moved by the show, and by Jun Hikari, whom acted as the male hero. Now an enthusiastic fan of Hikari, Satsuki dreams of making a costume for her."},{"spoiler":true,"text":"After high school, Satsuki joins the costumes department of the Stella Theatre. She eventually becomes Hikari's stylist."}],"source":"vndb","sourceCharacterId":"c7630"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8177da0c69ba9fc197d11bc967a88d4527addfd62ba4a4a5ac9642c74e984bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e52ebf96e62217cea2568171cb6bff73fd8757cc5bcc496ec4cc061bab199e2.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"君影 ミヤビ","creatorId":"vndb:s16137","sourcePersonId":"vndb:s16137","canonicalEntityId":"vndb:s16137","name":"君影 ミヤビ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15640","source":"vndb"}]},{"characterId":"char_vndb_c7631","characterName":"鈴城 カナデ","sourceIds":{"vndbCharacterId":"c7631"},"originalCharacterName":"鈴城 カナデ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The blunt and stand-offish childhood friend of Satsuki. The root of her aversion to romance, Kanade frequently called her ugly, and is the reason why she rarely removes her glasses. A gifted pianist, Kanade trained in Europe to further his skills. Out of the blue, he returns to Japan to perform in a concert, and seems to have changed very little, personality-wise."},{"spoiler":true,"text":"After high school, he travels to Europe again to continue his musical studies. He becomes a famous pianist, under his performer alias, Tomokusa Sou"}],"source":"vndb","sourceCharacterId":"c7631"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60b9d9967affb320266b69c14311fcf012053817a83a92dcf99f28642bf3a359.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/516c4b26573bb9b1583252903a8c717774533d07f1f74185e4267aa4375a8424.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"先割れスプーン","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15635","source":"vndb"}]},{"characterId":"char_vndb_c7632","characterName":"夜凪 トウワ","sourceIds":{"vndbCharacterId":"c7632"},"originalCharacterName":"夜凪 トウワ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Touwa is the second-in-charge of the school's Theatre Club. Almost nothing like his loud and attention-seeking childhood friend, Sei'ichiro, Touwa is antisocial, blunt, stoic and somewhat of a sadist. His father is a well-respected director working for the Stella Theatre, where Jun Hikari performs."},{"spoiler":true,"text":"After high school, Touwa goes on to become a theatre director at the Stella Theatre."}],"source":"vndb","sourceCharacterId":"c7632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd650bb97b9a4237061ebaf1507de24e7a5dc8a7e31f6686c5cb16ea85d27c76.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c49b1cd0d857f35d3c82b09c0bd4c8c30be2d809327d3ad24c8ecc38e215b23.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皇 帝","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15634","source":"vndb"}]},{"characterId":"char_vndb_c7633","characterName":"東 清一郎","sourceIds":{"vndbCharacterId":"c7633"},"originalCharacterName":"東 清一郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The president of the Theatre Club, although he passes on most of the administrative duties to Touwa. From a wealthy family, Seiichirou is somewhat spoiled, though not unpleasantly arrogant. Proud of his family's traditional Japanese roots, his likes and interests are all associated as such- e.g., Kabuki theatre, his preference for wearing Hakama (kimono for men) as opposed to western clothing (outside of school), and even commuting to school via a human-drawn carriage."},{"spoiler":true,"text":"After high school, Seiichirou becomes a famous Kabuki actor, as well as a popular personality on a national quiz television show. His older cousin works alongside Jun Hikari as her Senpai"}],"source":"vndb","sourceCharacterId":"c7633"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63ec2f24bbcc71494b7932a5ef630dafe133fcb14783045ac128b801c6f5ab85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b3d4e85eb78598768e667e2f19bade97b6781de1f60d9971e547a0877095220.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"プログレス","creatorId":"vndb:s400","sourcePersonId":"vndb:s400","canonicalEntityId":"vndb:s400","name":"千葉進歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15638","source":"vndb"}]},{"characterId":"char_vndb_c7637","characterName":"ユキ","sourceIds":{"vndbCharacterId":"c7637"},"originalCharacterName":"ユキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of the Theatre Club, Yuki is energetic, friendly and positive, in direct contrast to most of its members. He openly shows his affection for Satsuki, though never laciviously. In spite of his child-like cheer, Yuki is surprisingly perceptive of everything that goes on around him. Since he works part time in the props department at the Stella Theatre during the day, he attends and studies at school in the evening. As a result, he can't attend the club as often as he'd like. He is self-conscious of his short height, and is quick to redeem himself as the physically strongest of the club."},{"spoiler":true,"text":"Yuki suffered from memory loss, and was found by his current guardian. He later discovers that he is a partial entity of Misumi Kei, a scripwriter who is in a coma. Kei discovered that his master stole his script, and in despair, attempted to run away but fell off the stage. As a result of his injuries, he fell into a coma. Kei's anger and resentment gave birth to Yuki, but Yuki had no recollection of his \"true\" self."}],"source":"vndb","sourceCharacterId":"c7637"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fb5af0bf9d90334e1abbf508851e85a3a5780ae4d356534e0fc4f2b244f46cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfe57ac3572ceddc0296fcbd833b85bff8fce5a1ee8bd2bec0eab64c80f7133c.webp","width":162,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木島 宇太","creatorId":"vndb:s52","sourcePersonId":"vndb:s52","canonicalEntityId":"vndb:s52","name":"水島 大宙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15639","source":"vndb"}]},{"characterId":"char_vndb_c7642","characterName":"日下部 ハル","sourceIds":{"vndbCharacterId":"c7642"},"originalCharacterName":"日下部 ハル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haru is a long-time member of the Theatre Club, and also Satsuki's classmate. Meek, quiet and very shy, Haru is a pacifist and tries to avoid directly stating his point of view- especially when Touwa and Sei'ichirou argue (though he finds himself getting involved anyway). He is the gentlest and kindest towards Satsuki and never orders her around. Haru enjoys creative writing, and does so at any spare moment he gets. Though from a vastly wealthy family, Haru has almost no interest in money or material possessions."},{"spoiler":false,"text":"In spite of his docile nature, everyone is careful not to overly upset Haru, as he is heavily hinted to be scary when he finally loses his patience."},{"spoiler":true,"text":"After high school, Haru becomes a successful professional author. Beneath his gentle exterior lies a dark nature- deep down, Haru is dangerously possessive. His sexual desires are somewhat dark too, as he confesses to imagining raping Satsuki \"many times\"."}],"source":"vndb","sourceCharacterId":"c7642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f56c48d3d81b5f9d06bdc7b8d2b366973bbfd5718fe7ec7b1d9fc5fc474ba055.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b1d538eeea093d69ffe6d9f91d32dd02308289547ad0b60631644cbdbdb17d1.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井 達矢","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15633","source":"vndb"}]},{"characterId":"char_vndb_c7645","characterName":"淳 ヒカリ","sourceIds":{"vndbCharacterId":"c7645"},"originalCharacterName":"淳 ヒカリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The handsome actress that inspired Satsuki to love theatre. Hikari is brave, confident and strong, but gentle and kind. Her popularity and rising talent threatens her senior acting peers, and as a result, Hikari is subject to their bullying. In spite of this, she remains strong and loves her job."},{"spoiler":true,"text":"Her true name is Izumi Hikari. She intially enlists Satsuki to be her fan manager, but after Satsuki got her dream job of being in the costumes department, Hikari eventually re-enlists her as her stylist."}],"source":"vndb","sourceCharacterId":"c7645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27a3e0c8a69009f0a56e1b9ce4b8dc879f8c5a96a012491f05e50de46a6aef10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61bb60d0569f6b127abc1fa9ab5670d0723187255f4a7e8ebfc53389991d1e0e.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紺野綾","creatorId":"vndb:s16138","sourcePersonId":"vndb:s16138","canonicalEntityId":"vndb:s16138","name":"紺野綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15641","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p411","sourceCompanyId":"egs:brand:984","canonicalEntityId":"vndb:p411","name":"美蕾","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:12341:984","source":"egs"},{"companyId":"vndb:p411","sourceCompanyId":"vndb:p411","canonicalEntityId":"vndb:p411","name":"美蕾","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30215:v1926","source":"vndb"},{"companyId":"vndb:p411","sourceCompanyId":"vndb:p411","canonicalEntityId":"vndb:p411","name":"美蕾","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4492:v1926","source":"vndb"},{"companyId":"vndb:p411","sourceCompanyId":"vndb:p411","canonicalEntityId":"vndb:p411","name":"美蕾","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:75535:v1926","source":"vndb"},{"companyId":"vndb:p411","sourceCompanyId":"vndb:p411","canonicalEntityId":"vndb:p411","name":"美蕾","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:75536:v1926","source":"vndb"},{"companyId":"vndb:p411","sourceCompanyId":"vndb:p411","canonicalEntityId":"vndb:p411","name":"美蕾","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:90726:v1926","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
