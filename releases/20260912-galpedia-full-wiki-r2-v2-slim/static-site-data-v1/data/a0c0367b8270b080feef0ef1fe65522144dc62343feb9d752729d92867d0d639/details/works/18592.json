{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18592","model":{"presentationWorkId":"vndb:v23163","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c4033","characterName":"佐々山 深雪","sourceIds":{"bangumi":[{"characterId":"30977","match":"exact-normalized-name-in-linked-work","subjectId":"128057"},{"characterId":"30977","match":"exact-normalized-name-in-linked-work","subjectId":"222171"}],"egsCharacterIds":["572"],"vndbCharacterId":"c4033"},"originalCharacterName":"佐々山 深雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おおざっぱでいい加減なところがあるが、肉感的で色っぽい大人の女性。"},{"spoiler":false,"text":"学生達から恋愛相談を持ちかけられることもある。十彦のことを嫌っていて監視している。"},{"spoiler":false,"text":"――視姦趣味"},{"spoiler":false,"text":"実は男性経験が全くない処女。欲求不満で玩具を使い自らを慰めている。"},{"spoiler":false,"text":"男性に視姦されるのは嫌だが、意識すると興奮してしまう。"}],"source":"egs","sourceCharacterId":"572","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"魅惑の女教師。"},{"spoiler":false,"text":"スタイル抜群な上に美人とあって、男からいやらしい視線を浴び続けている。"},{"spoiler":false,"text":"最初は嫌だったが、徐々に視られることに快感を覚えるようになった。"},{"spoiler":false,"text":"現在では、自慰のときも誰かに視られていることを想像しながら耽るようになってしまった。"}],"source":"egs","sourceCharacterId":"572","sourceWorkId":"9799","spoiler":false},{"segments":[{"spoiler":false,"text":"【主人公の担任／数学の教師】"},{"spoiler":false,"text":"学園の数学の教師。学生に対して厳しく接するも面倒見は良い。"},{"spoiler":false,"text":"教師という仕事に強い誇りを持っている。"},{"spoiler":false,"text":"堅物な性格で厳しい面があるため、美人の割に言い寄ってくる男少ない。"},{"spoiler":false,"text":"教職の仕事を最優先に考えており、恋愛にまで手が回らない状態である。"},{"spoiler":false,"text":"主人公はそんな深雪のことがすきで、彼女にアプローチを掛けるが深雪はあくまで学生のひとりとして主人公を扱う。"}],"source":"egs","sourceCharacterId":"572","sourceWorkId":"18592","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の教師。おおざっぱで、いい加減なところがあるが、学生から恋愛相談を持ちかけられることも。 主人公をとても嫌っていて監視している。"},{"spoiler":false,"text":"実はまだ処女。男性経験もまったくなく、欲求不満でおもちゃを購入している。 昔から男に視姦されており、意識するように。嫌だったが、見られて興奮することに気づく。"}],"source":"bangumi","sourceCharacterId":"30977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98457883213828a6ac6d13db57ddfab49359a6130794fd81a963f16ce792f8b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4acca1c9fec7c127040b066db19d9b03944c971fb57aede9519c25e453261377.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"君島 りさ","creatorId":"vndb:s2310","sourcePersonId":"vndb:s2310","canonicalEntityId":"vndb:s2310","name":"君島 りさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77786","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p826","sourceCompanyId":"egs:brand:1885","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18592:1885","source":"egs"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:65121:v23163","source":"vndb"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:81169:v23163","source":"vndb"}],"missingStates":["current-run