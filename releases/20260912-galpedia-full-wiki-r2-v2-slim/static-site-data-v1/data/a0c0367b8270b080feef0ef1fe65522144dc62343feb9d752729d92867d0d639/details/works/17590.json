{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17590","model":{"presentationWorkId":"egs:17590","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_106165","characterName":"Mio","sourceIds":{"bangumi":[{"characterId":"106165","match":"source-roster","subjectId":"2534"},{"characterId":"106165","match":"source-roster","subjectId":"99714"},{"characterId":"106165","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Mio","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"京都弁を話すおっとりとした性格で、発明家のタマゴ。しかし人の名前を憶えられない節がある。「世の中の人に役立つもの」をモットーに様々な品を発明するが、肝心な部分が抜け落ちていたり、矛盾が生じて意味を成さなかったり、計らずも人体や環境に悪影響を及ぼしかねない物も多い。なお、現在はとある薬の研究に没頭している。ホストガールの中ではグラマーな部類に入り、唯一眼鏡を着用しているキャラクター（設定で眼鏡を外す事も出来る）。"},{"spoiler":false,"text":"『舞台』では機能停止したアイリを救うべくナオ、ノノノとともにアイリの体内に潜入した。演じる黒須はダンスの振付や構成を担当している。"},{"spoiler":false,"text":"『ドリームクラブ ディア・ガールズ』では原作以上に変な発明をして他のホストガールを脅かしたり騒動を引き起こすことがあるが本人は人の役に立ちたいと思っている。"}],"source":"bangumi","sourceCharacterId":"106165"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecc6feb1a37a3e0ded80494a7f7fc2a42c69bce0abe30ca8ce1e19655f6bc8fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c170a357a8fe7961df322e3c1dbb925a7dff75a97f455af35ba8355d73e485f.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:106165:4251:1","source":"bangumi"}]},{"characterId":"char_bangumi_106167","characterName":"Rui","sourceIds":{"bangumi":[{"characterId":"106167","match":"source-roster","subjectId":"2534"},{"characterId":"106167","match":"source-roster","subjectId":"99714"},{"characterId":"106167","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Rui","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"昼は男子校の教師で、夜はこっそりホストガールをしているという女性。抜群のプロポーションを誇り、店の制服も自慢の胸を強調する造りとなっている等、大人の魅力を打ち出したキャラクターだが、やや夢見がちな少女的一面も持つ。ドリームクラブでの勤務は長いらしく、それなりに古株の様だが、とある大きな悩みを持っている。"},{"spoiler":false,"text":"『ZERO』では、普段は地味な自分に大人の魅力を出すためにドリームクラブに通っている。"},{"spoiler":false,"text":"『舞台』では玲香、雪とともに亜麻音の帰りを待つ。またレビューの稽古シーンではコスプレを披露した。以降の作品では演じる雨情の性格も相まっておとぼけキャラが定着している。"}],"source":"bangumi","sourceCharacterId":"106167"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95c08d60bcfae389c56d141543482969f96e5151d4733a2439c61a5e0b58823f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a01479591ac8979fce4016b9d345e79e3cf192a4aca61d77bdb718c7d1a430e.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田ひとみ","creatorId":"vndb:s1116","sourcePersonId":"vndb:s1116","canonicalEntityId":"vndb:s1116","name":"原田 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:106167:5206:1","source":"bangumi"}]},{"characterId":"char_bangumi_106168","characterName":"Nao","sourceIds":{"bangumi":[{"characterId":"106168","match":"source-roster","subjectId":"2534"},{"characterId":"106168","match":"source-roster","subjectId":"99714"},{"characterId":"106168","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Nao","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ショートカットが特徴の明朗快活なボーイッシュなキャラクターで、一人称が「ボク」という俗に言うボクっ子。実家が総合格闘技の道場で、彼女も師範代として指導を務めている。体育系の大学に通っており、トレーニングも兼ねて大抵は走って移動する。しかし、もっと女の子らしさを身に着けたいという思いから、ドリームクラブで働く事でヒントを得ようとしている。『ZERO』では、開始時にはまだ入店しておらず、序盤で新規入店する。この時は口調や振る舞いも女の子らしく振舞おうとした。"},{"spoiler":false,"text":"『舞台』ではみお、ノノノとともに、機能停止したアイリの体内に潜入、アイリの防衛プログラム相手に得意の格闘技を披露した。"}],"source":"bangumi","sourceCharacterId":"106168"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/423cbaa989430b0845084c7de05c2dfd16c5ec899c0ef105c00da65396acb397.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4060aad45626f6bc7c93c870909ed0082af4e3cf4750c2767a7ff1b871546760.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"又吉愛","creatorId":"vndb:s1646","sourcePersonId":"vndb:s1646","canonicalEntityId":"vndb:s1646","name":"又吉 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:106168:5013:1","source":"bangumi"}]},{"characterId":"char_bangumi_106169","characterName":"Mari","sourceIds":{"bangumi":[{"characterId":"106169","match":"source-roster","subjectId":"2534"},{"characterId":"106169","match":"source-roster","subjectId":"99714"},{"characterId":"106169","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Mari","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"隠しキャラクターとして設定されているホストガールで、条件を満たすかマイクロソフトポイントを支払うことで指名可能となる。"},{"spoiler":false,"text":"自らを「ブラッディマリリン」と名乗るミステリアスな女性で、ゴシック・ファッションを思わせる制服と左目の黒い眼帯が特徴。「小悪魔」や「堕天使」といった暗く耽美なフレーズを好む。開発当初はダウンロード専用キャラクターだった。全ホストガール中最も酒に強い。"},{"spoiler":false,"text":"『ZERO』でも隠しキャラクターとして登場、主人公をヴァンパイアと思い込み素性を探ろうとする。"},{"spoiler":false,"text":"『舞台』ではユウ、エルを伴い怪しい儀式を行っており、リハビリに悩むあすかを儀式に招き入れる。"}],"source":"bangumi","sourceCharacterId":"106169"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdc78aa61b481858008a5d1e1f617e2f32cc264e14e5638250e0823b4bfc45c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4ca90f9a94e0f1deca096e2b029a6c79e5f90b0deb18424514b67fa71a6a54c.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石毛佐和","creatorId":"vndb:s2222","sourcePersonId":"vndb:s2222","canonicalEntityId":"vndb:s2222","name":"石毛佐和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:106169:3848:1","source":"bangumi"}]},{"characterId":"char_bangumi_106170","characterName":"Airi","sourceIds":{"bangumi":[{"characterId":"106170","match":"source-roster","subjectId":"2534"},{"characterId":"106170","match":"source-roster","subjectId":"99714"},{"characterId":"106170","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Airi","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔璃同様隠しキャラクターとして設定されているホストガールで、条件を満たすかマイクロソフトポイントを支払うことで指名可能となる。"},{"spoiler":false,"text":"「ROZA零式」という名の自動自律型アンドロイド。会話による感情データ収集のためにドリームクラブで働くこととなるが、時折いかがわしいデータを収集してしまっている様子。語尾に「?です」と付けて話すのが特徴。私服として「東京」「修理中」「純愛」など奇妙な単語の入ったTシャツを着ている。『ZERO』ではウイルスに冒されてしまう。"},{"spoiler":false,"text":"『舞台』ではレビューショウ前に機能停止してしまうが、未来のアイリがノノノに助けを求める。"}],"source":"bangumi","sourceCharacterId":"106170"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62a6b9b96f925e5b9c11f0dda0969244d9154fad13b0768114bee0912167b343.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4f7d36589335121fc2fcaa289e5254e77b48abc1074189c1ce377d631ce0dcb.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉明日美","creatorId":"vndb:s11385","sourcePersonId":"vndb:s11385","canonicalEntityId":"vndb:s11385","name":"児玉明日美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:106170:5120:1","source":"bangumi"}]},{"characterId":"char_bangumi_106174","characterName":"受付","sourceIds":{"bangumi":[{"characterId":"106174","match":"source-roster","subjectId":"2534"},{"characterId":"106174","match":"source-roster","subjectId":"99714"},{"characterId":"106174","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"受付","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ドリームクラブの入り口で待つ受付嬢。主人公がピュアな心の持ち主であるとして1年間の会員権を贈呈する。以後会員期間中、入店時の案内等でお世話になることになる。"},{"spoiler":false,"text":"サブキャラでありながらその容姿と性格で高い人気を持ち、『マージャン・ドリームクラブ』では夢王位決定リーグ戦を優勝すると初めて指名可能になり、コスプレを披露し、主題歌を歌う他『ドリームクラブ ZERO Special Edipyon!』では、条件を満たすとドリームクラブのステージで歌を披露すること（もちろんほろ酔いやコスプレも可能）が明らかになった。ラジオや漫画などで登場したホストガール姿も本作で初披露となった（ちなみにサイズはMサイズ）。"},{"spoiler":false,"text":"『舞台』では店長からの指令をホストガールに伝えた。また亜麻音を勇気付けるなど重要な役割を担った。持ち歌は『ホストガール ライブオンステージ Vol.4』で初披露した『マージャン・ドリームクラブ』の主題歌『風をあつめて』、ダンスは舞台版の完全オリジナルである。"}],"source":"bangumi","sourceCharacterId":"106174"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c4ed26165ee6a1616819171c10071953d07127680f020c06a03ed6734b1af8a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27495812a9a442921e7fca88e166adfe3d197a5b22ea431e1c569313567297da.webp","width":173,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平田真菜","creatorId":"vndb:s7989","sourcePersonId":"vndb:s7989","canonicalEntityId":"vndb:s7989","name":"平田 真菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:106174:7543:1","source":"bangumi"}]},{"characterId":"char_bangumi_1270","characterName":"Amane","sourceIds":{"bangumi":[{"characterId":"1270","match":"source-roster","subjectId":"2534"},{"characterId":"1270","match":"source-roster","subjectId":"99714"},{"characterId":"1270","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Amane","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一说到电影相关的话题就会停不下来，将来也希望能参与像那样了不起作品的演出；也因为这样而想要改变自己，因此决定来到《Dream C Club》担任“Host Girl”，藉此作为改变自己的第一步的大小姐。"}],"source":"bangumi","sourceCharacterId":"1270"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70ca21af7ab2157f57a23a34bf3d323c83c01f8cc4bf972ed32c8dfbb9406d30.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c479dee6a4231bae9ea1254c028539eb000986f311bf61fe40f9a1e510a44e42.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:1270:4474:1","source":"bangumi"}]},{"characterId":"char_bangumi_1272","characterName":"Setsu","sourceIds":{"bangumi":[{"characterId":"1272","match":"source-roster","subjectId":"2534"},{"characterId":"1272","match":"source-roster","subjectId":"99714"},{"characterId":"1272","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Setsu","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"将来的梦想是希望能够成为超一流甜点师傅的少女，因为娇小的外表，而经常被亜麻音当成小孩子。喜欢特摄英雄的她，最喜欢的男性类型是像“熊本米”（日本熊本县农业研究中心农产园艺研究所所培育的水稻品种）那样的男性！"}],"source":"bangumi","sourceCharacterId":"1272"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8cd0e2f92542d6460ffc7d6647bc415f650a5acd34792f3e97a46e119b9768e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c0dd6a2f41fd24e8100a0556ffdf2bb365c6ce4c4a86aa316e5174471f98353.webp","width":125,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:1272:3851:1","source":"bangumi"}]},{"characterId":"char_bangumi_1273","characterName":"Reika","sourceIds":{"bangumi":[{"characterId":"1273","match":"source-roster","subjectId":"2534"},{"characterId":"1273","match":"source-roster","subjectId":"99714"},{"characterId":"1273","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Reika","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"多才多艺的关西御姊系女孩，最擅长保龄球，至于将来的梦想，则是希望能够成为一名职业保龄球选手，目前则正在等待有勇气的男人出现……。"}],"source":"bangumi","sourceCharacterId":"1273"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8116dc583f810930207843fb557f49c77c7b13c0da5b75ee94db180ae0212d4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6ebb3304d9cb5c0cd6c47f855b6fb409c2c6c50de5ec7a656d94198cb23e11f.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早水リサ","creatorId":"vndb:s8127","sourcePersonId":"vndb:s8127","canonicalEntityId":"vndb:s8127","name":"早水 リサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:1273:4623:1","source":"bangumi"}]},{"characterId":"char_bangumi_1274","characterName":"Mian","sourceIds":{"bangumi":[{"characterId":"1274","match":"source-roster","subjectId":"2534"},{"characterId":"1274","match":"source-roster","subjectId":"99714"},{"characterId":"1274","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"Mian","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"不擅长与人接触，虽然如此却还是很努力在工作上的女孩。尽管如此，内心里却还是期待着有能够不管她说什么硬是要来破冰要求跟她交往的男性出现。"}],"source":"bangumi","sourceCharacterId":"1274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1eb82fe4c28219c854d9fe426c28c4769838802e05cddbcc511fbba3ef3aec44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/122d13998465b999d3788d809a9c01d48044bacfeaf58455b606334442a5c63e.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真堂圭","creatorId":"vndb:s41","sourcePersonId":"vndb:s41","canonicalEntityId":"vndb:s41","name":"真堂 圭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:1274:4905:1","source":"bangumi"}]},{"characterId":"char_bangumi_1276","characterName":"双叶理保","sourceIds":{"bangumi":[{"characterId":"1276","match":"source-roster","subjectId":"2534"},{"characterId":"1276","match":"source-roster","subjectId":"99714"},{"characterId":"1276","match":"source-roster","subjectId":"99715"}]},"originalCharacterName":"双叶理保","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本名为双叶理保的元气少女，兴趣是冲浪跟滑雪。原本是为了学习电影里的角色才隐瞒目的来店里打工的她，目前正在招募男朋友中！"}],"source":"bangumi","sourceCharacterId":"1276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc3ed923b8950e67b8b5dcdb7f0629ef75337b6d1a2616aba45e929cef1903a4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0d5372f1ec44b0ba89ce42a393d3c8e6a0f74faea6bab55b94b0ffd18cbf1c5.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99714:1276:4514:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p592","sourceCompanyId":"egs:brand:731","canonicalEntityId":"vndb:p592","name":"D3 PUBLISHER INC.","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17590:731","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
