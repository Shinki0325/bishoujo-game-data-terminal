":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukine is a third-year student and the president of the student council and the representative of the dormitory for girls. Tsukine has common sense but no common knowledge, Boys are attracted to Tsukine because of Tsukine's smile. In the school, all the students respect Tsukine and all the teachers trust Tsukine. Tsukine is calm and friendly and has mercy on anybody and the spirit of self-sacrifice. On the other hand Tsukine is ditzy so that rarely makes mistakes no one will do."}],"source":"vndb","sourceCharacterId":"c25102"},{"segments":[{"spoiler":false,"text":"【誰もが憧れるほんわか天然系生徒会長】"},{"spoiler":false,"text":"学園3年生。生徒会長。"},{"spoiler":false,"text":"女子寮で暮らしており、女子寮の寮長もしている。"},{"spoiler":false,"text":"ほんわかした柔らかい笑顔と穏やかな物腰で男共を魅了する良家のお嬢さまで、学園きっての才媛。"},{"spoiler":false,"text":"やや天然気味なところがあり、たまに誰もやらないようなドジをやらかしてしまう。"},{"spoiler":false,"text":"今でも成長まっただ中の爆乳は、型くずれせずに感度も抜群。"},{"spoiler":false,"text":"しかし、幼い頃からそれで目立ってきたため、本人にとってはコンプレックスになっている。"},{"spoiler":false,"text":"「エ、エッチなことはいけません。…セクハラ禁止、ですっ」"}],"source":"egs","sourceCharacterId":"1221","sourceWorkId":"17912","spoiler":false},{"segments":[{"spoiler":false,"text":"学園3年生。 生徒会長。"},{"spoiler":false,"text":"女子寮で暮らしており、女子寮の寮長もしている。"},{"spoiler":false,"text":"ほんわかした柔らかい笑顔と穏やかな物腰で男共を魅了する良家のお嬢さまで、学園きっての才媛。"},{"spoiler":false,"text":"やや天然気味なところがあり、たまに誰もやらないようなドジをやらかしてしまう。"},{"spoiler":false,"text":"今でも成長まっただ中の爆乳は、型崩れせずに感度も抜群。"},{"spoiler":false,"text":"しかし、幼い頃からそれで目立ってきたため、本人にとってはコンプレックスになっている。"},{"spoiler":false,"text":"「エ、エッチなことはいけません。…セクハラ禁止、ですっ」"}],"source":"bangumi","sourceCharacterId":"46214"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2187ef0bb760f2fe591eef259200096481e29cf6ca0de7d0b1b2dddac216b55a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bcfe0fd53c7336830eefd3da5aef1695ce5a6d3a698613745cdfc0dbd8d4e9d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65737:46214:5936:1","source":"bangumi"}]},{"characterId":"char_c25103","characterName":"皆森 青葉","sourceIds":{"bangumi":[{"characterId":"46215","match":"exact-normalized-name-in-linked-work","subjectId":"65737"}],"egsCharacterIds":["1222"],"vndbCharacterId":"c25103"},"originalCharacterName":"皆森 青葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aohs is second year student and student council secretary. Aoha seems to be a tsundere but she became attached to Akira once Aoha fall into love. Aoha is a hard worker. Aoha studies in the school, do work for student council, work in a cafe and do housework herself, bua Aoha conceals her efforts. No one notices her hard work, Aoha watch out for Akira because Akria is on the blacklist of student council, Aoha respects Tsukine because Tsukine is kind without calculation."}],"source":"vndb","sourceCharacterId":"c25103"},{"segments":[{"spoiler":false,"text":"【主人公と犬猿の仲のツンデレクラスメイト】"},{"spoiler":false,"text":"学園2年生。主人公のクラスメイトで、生徒会の書記。女子寮暮らし。"},{"spoiler":false,"text":"生徒会のブラックリスト入りしている主人公を専属マークしていて、よき喧嘩相手でもある。"},{"spoiler":false,"text":"しかし周りからは痴話喧嘩扱いされ、付き合っているという噂すら流れている始末。"},{"spoiler":false,"text":"学園近くのカフェでバイトをしており、看板娘として人気を博している。"},{"spoiler":false,"text":"あまり目立たないが、出るとこは出てきゅっと引き締まったモデル顔負けの美しい体型をしている。"},{"spoiler":false,"text":"イクとおしっこをしてしまう放尿癖がある。"},{"spoiler":false,"text":"「あなたにデレることはありませんからご安心ください」"}],"source":"egs","sourceCharacterId":"1222","sourceWorkId":"17912","spoiler":false},{"segments":[{"spoiler":false,"text":"学園2年生。 主人公のクラスメイトで、生徒会の書記。 女子寮暮らし。"},{"spoiler":false,"text":"生徒会のブラックリスト入りしている主人公を専属マークしていて、よき喧嘩相手でもある。"},{"spoiler":false,"text":"しかし周りからは痴話喧嘩扱いされ、付き合っているという噂すら流れている始末。"},{"spoiler":false,"text":"学園近くのカフェでバイトをしており、看板娘として人気を博している。"},{"spoiler":false,"text":"あまり目立たないが、出るとこは出てきゅっと引き締まったモデル顔負けの美しい体型をしている。"},{"spoiler":false,"text":"イクとおしっこをしてしまう放尿癖がある。"},{"spoiler":false,"text":"「あなたにデレることはありませんからご安心ください」"}],"source":"bangumi","sourceCharacterId":"46215"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/995181bf94932665f60ee4a500bbe4628dfbc8d404c038203d6c2174ba51e80e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/764be66798ae8ed5bdcbdeaf1ffb6fbc1ca8cad4201589cb9140a535f5300783.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山名枝里子","creatorId":"vndb:s17301","sourcePersonId":"vndb:s17301","canonicalEntityId":"vndb:s17301","name":"山名 枝里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65737:46215:16083:1","source":"bangumi"},{"creditedName":"桜城 ちか","creatorId":"vndb:s1174","sourcePersonId":"vndb:s1174","canonicalEntityId":"vndb:s1174","name":"月ヶ瀬 あかね","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:52350","source":"vndb"}]},{"characterId":"char_c25104","characterName":"河内 涼","sourceIds":{"bangumi":[{"characterId":"46216","match":"exact-normalized-name-in-linked-work","subjectId":"65737"}],"egsCharacterIds":["1223"],"vndbCharacterId":"c25104"},"originalCharacterName":"河内 涼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Suzu is second year student and Akria's younger sister and Akira's classmate. In the school. Suzu is the representative of Suzu's class. Now Suzu and Akira live in the same house without their parents because they live overseas. Suzu does all the housework and rule the Kawauchi household. Suzu doesn't lose her composure anytime and makes a cold judgement. She loves Ice Cream and keeps ice cream in the Kawauchi freezer. To tell the truth, Suzu is mentally wealk and easy to lose sight of herself."}],"source":"vndb","sourceCharacterId":"c25104"},{"segments":[{"spoiler":false,"text":"【主人公のクールな妹】"},{"spoiler":false,"text":"クールビューティーな主人公の同い年の実妹。"},{"spoiler":false,"text":"現在は、主人公と二人暮らし。"},{"spoiler":false,"text":"主人公たちのクラス委員長をしており、頼りになるしっかりもので通っている。"},{"spoiler":false,"text":"学校では気を張ることが多いため、家では風呂上がりに薄着でブラチラしながらアイスを食べているなど、無防備な姿を見せている。"},{"spoiler":false,"text":"普段は「兄さん」呼びだが、ついうっかり昔の癖で「お兄ちゃん」と呼んでしまうことがあり、気づいて真っ赤になる照れ屋な一面も。"},{"spoiler":false,"text":"兄さん大好きっこで、主人公の使用済みパンツをクンカクンカしながらオナニーしてしまう変態さん。"},{"spoiler":false,"text":"「兄さん、あまり心配かけさせないで」"}],"source":"egs","sourceCharacterId":"1223","sourceWorkId":"17912","spoiler":false},{"segments":[{"spoiler":false,"text":"クールビューティーな、主人公の同い年の実妹。 現在は主人公と二人暮らし。"},{"spoiler":false,"text":"同じクラスで委員長をしており、頼りになるしっかり者で通っている。"},{"spoiler":false,"text":"学園では気を張ることが多いせいか、家では風呂上がりに薄着でブラチラしながらアイスを食べているなど、無防備な姿を見せている。"},{"spoiler":false,"text":"普段は “兄さん” 呼びだが、ついうっかり昔の癖で “お兄ちゃん” と呼んでしまうことがあり、気づいて真っ赤になる照れ屋な一面も。"},{"spoiler":false,"text":"兄さん大好きっこで、兄の使用済みパンツをクンカクンカしながらオナニーしてしまう変態さん。"},{"spoiler":false,"text":"「兄さん、あまり心配かけさせないで」"}],"source":"bangumi","sourceCharacterId":"46216"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5827c77f4561883339d24c520cf7504b05d53fe432fc1c72d7f4dff12f158f31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dec6621703decedb9ee08668a6d556a689faa6f6144edb4719051733496d5b65.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65737:46216:15637:1","source":"bangumi"}]},{"characterId":"char_vndb_c134483","characterName":"河内 明","sourceIds":{"vndbCharacterId":"c134483"},"originalCharacterName":"河内 明","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p503","sourceCompanyId":"egs:brand:2141","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17912:2141","source":"egs"},{"companyId":"vndb:p503","sourceCompanyId":"vndb:p503","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:164044:v12352","source":"vndb"},{"companyId":"vndb:p503","sourceCompanyId":"vndb:p503","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["developer","publisher"],"identityStatus":"source-native"