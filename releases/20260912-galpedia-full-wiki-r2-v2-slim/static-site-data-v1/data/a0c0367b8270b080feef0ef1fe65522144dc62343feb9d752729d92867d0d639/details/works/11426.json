3"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖C学園に勤務する女性教師。"},{"spoiler":false,"text":"敬虔なクリスチャンで、信仰心が厚い。"},{"spoiler":false,"text":"悠斗たちによる魔の眷属化にも心を揺るがさず、学園の異常事態を観察している。"},{"spoiler":false,"text":"信念の強さでヴァンパイアの魅了を撥ね退けてはいるが、吸血されてしまうと、抵抗ができない。"},{"spoiler":false,"text":"胸の十字架が心のよりどころ。"}],"source":"egs","sourceCharacterId":"16462","sourceWorkId":"11426","spoiler":false},{"segments":[{"spoiler":false,"text":"正義感の強い学園の女性教師。"},{"spoiler":false,"text":"学園の教師のほとんどが瑠璃子か悠斗に魅了され眷属化している中で自分を保ち、学園の現状に強い不審を抱いている。"},{"spoiler":false,"text":"敬虔なクリスチャンで、胸もとにはいつも十字架が提げられている。"},{"spoiler":false,"text":"魅了に掛かりにくいというだけで普通の人間であるため、実力行使をされれば抵抗することはできない。"},{"spoiler":false,"text":"亜沙香の助手に立候補し役に立とうとするが、ヴァンパイアの恐ろしさを本質的には理解していない。"}],"source":"bangumi","sourceCharacterId":"61574"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"16462","sourceWorkId":"11426","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"16462","sourceWorkId":"11426","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"16462","sourceWorkId":"11426","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"16462","sourceWorkId":"11426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2be102cb50474d5fdc06833eb1552683fc5327d59a68647f10397717e5b03bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5fa32a5d15544fb466c2f89fcf9ed599ce