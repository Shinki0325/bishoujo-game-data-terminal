リ」"},{"spoiler":false,"text":"ミステリアスな雰囲気を持つ、聖C学園の学生。"},{"spoiler":false,"text":"その正体は人ならざる者「ヴァンパイア」。"}],"source":"egs","sourceCharacterId":"10649","sourceWorkId":"14885","spoiler":false},{"segments":[{"spoiler":false,"text":"伊集院子飼いの“くのいち”ヴァンパイア。ある日、転校生として学園に現れる。"},{"spoiler":false,"text":"「悠斗さまを護衛し、学園に入り込んだヴァンパイアハンターを始末するために」と伊集院が送り込んできた戦士だが、実際には悠斗への監視と工作が目的。"},{"spoiler":false,"text":"瑠璃子はその意図を薄々見抜いているが、拒否できず渋々受け入れている。"},{"spoiler":false,"text":"外見に見合わず男を誘惑する術に熟達し、何度も悠斗を骨抜きにしようと試みてくる。"}],"source":"bangumi","sourceCharacterId":"61573"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10649","sourceWorkId":"11426","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"10649","sourceWorkId":"11426","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"10649","sourceWorkId":"11426","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"10649","sourceWorkId":"11426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c2dc617c29e81d5fe2a20be023e2ab8b81f0538e6c035a2277899f2c02d8bb6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0dcb466d4286059af97a3163c9f873620ce6adf2b314cdc4f535a8518b694e5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:240064:61573:5907:1","source":"bangumi"}]},{"characterId":"char_c47349","characterName":"千木良 美羽","sourceIds":{"bangumi":[{"characterId":"61571","match":"exact-normalize