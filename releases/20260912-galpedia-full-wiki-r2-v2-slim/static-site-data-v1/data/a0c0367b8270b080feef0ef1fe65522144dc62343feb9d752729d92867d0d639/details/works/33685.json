x":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sayone's childhood friend."},{"spoiler":false,"text":"Good at chanting and dancing."},{"spoiler":false,"text":"Although he is a cute looking boy, he has a frosty personality which makes people want to kick him in the face. He's especially bitter with women."},{"spoiler":false,"text":"He comes from a wealthy family where the skill of Noh is passed from generation to generation. You can say that anyone from his house is a local celebrity."},{"spoiler":false,"text":"His favorite thing is plum wine."},{"spoiler":false,"text":"Edited and translated from the official website"}],"source":"vndb","sourceCharacterId":"c9040"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a489eb5c59ccb03e4f12c00b48c594d676da4b2ef804f970804134d37cc0eab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e906448896a8fd01fd0fe4bdb5f0d9b572258bf5fafa99c68cf55abffcf6c058.webp","width":173,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9041","characterName":"謎の少年","sourceIds":{"vndbCharacterId":"c9041"},"originalCharacterName":"謎の少年","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An emotionless child whom Sayone occasionally meets. They seem to have some kind of strange connection between them."},{"spoiler":false,"text":"He wears scarlet stone earrings, the stones ring often and make a sound similar to that of a bell."},{"spoiler":false,"text":"Edited and translated from the official website"}],"source":"vndb","sourceCharacterId":"c9041"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dab1f51165e8f924f69062baf8a5769a6ec491e1a3cbff1808c39931f786f357.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69e75aef84fd806bfa2bf2a8d8c4267d232b36ec88755216ae240db85cf141a5.webp","width":155,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9042","characterName":"スカイアイ","sourceIds":{"vndbCharacterId":"c9042"},"originalCharacterName":"スカイアイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"Personality: laid back, gentle."},{"spoiler":false,"text":"This virtual pet uses Kyoto accent for some reason."},{"spoiler":false,"text":"Likes: web surfing and Chukamans. Dislikes: bullies."},{"spoiler":false,"text":"This is a kind of a multi-functional virtual pet called \"Cyber ​​Angel\" who lives in Sayone's PC."},{"spoiler":false,"text":"Her father is the developer of this \"program\", and Sayone has to test it, so you get to choose either Skyeye or Morningstar to be your (Sayone's) virtual pet during the game."},{"spoiler":false,"text":"You can also choose to name them how you want, they don't even have a gender, so you can choose any name at all."},{"spoiler":false,"text":"Edited and translated from the official website"}],"source":"vndb","sourceCharacterId":"c9042"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13e98d45ed28a6b84cc514887a459baf6612998c6d30d5e4ab87b4eac125e383.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bd115efcb031c46940106a1b6101330ea836349e936610e93bc837bb6990459.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9043","characterNam