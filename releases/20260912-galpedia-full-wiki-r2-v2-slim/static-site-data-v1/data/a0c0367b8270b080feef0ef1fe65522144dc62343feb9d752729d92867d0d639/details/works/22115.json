urce":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The fiery vice-chief of the guardians. She’s mostly nice, friendly and cheerful, however she seems to act way too competitively and attempts to be very serious when she is with Chief Miyu. She easily warms up to everyone, but seems to never be on friendly terms with Miyu. Likes to train with the MC for his judo, but he gets beaten up most of the time."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c18277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31741fac0e0afa4947b52ae8b9d143627133b66c378db11ffca6b13118476176.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22e16529d7ccee4f33c8c74c6e21288f1009343aff37c6d5bdecda4e17cf8528.webp","width":216,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c18278","characterName":"Sakurano Machiko","sourceIds":{"vndbCharacterId":"c18278"},"originalCharacterName":"Sakurano Machiko","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the thieving foxgirls. Seemingly mysterious, but in truth she is quite the lazy foxgirl who dislikes to do work and would love nothing more than to just lie down and relax or sleep. However, she cares a lot about her younger sister and seems to know more than she lets on. The one that flirts with the MC the most."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c18278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"http