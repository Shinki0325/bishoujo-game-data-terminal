oiler":false,"text":"戦闘サポートでお役立ちします！"},{"spoiler":false,"text":"（公式設定より）"},{"spoiler":false,"text":"特技がブラインドタッチだったり、趣味が自作PC作りだったり、PC関係にはけっこう強い。"},{"spoiler":false,"text":"休日もお店でパーツやゲームを浅津など、わりと筋金入りのようだ。"},{"spoiler":false,"text":"コスプレしてお店の宣伝をすることも。"}],"source":"egs","sourceCharacterId":"7731","sourceWorkId":"22570","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db1ef292e2a34b1df46251b899fa3d6947aec363e68343ad65bbdbec8fac7f64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/827b32573f33af327ad2503481f1ff2557f911fe14b71834160307b842f7d4b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:4712","sourceCompanyId":"egs:brand:4712","canonicalEntityId":"egs:brand:4712","name":"(有)ありす","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:22570:4712","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
