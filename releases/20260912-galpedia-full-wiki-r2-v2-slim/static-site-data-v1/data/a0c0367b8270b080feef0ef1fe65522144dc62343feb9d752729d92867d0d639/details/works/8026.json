er":false,"text":"She had been living for several years in Shanghai after forced marriage, but returned home just in time Harumichi died."},{"spoiler":false,"text":"Her calm aura from childhood is changed to bewitching demeanour. Now she is known as \"Huang Lianhua\" (The Yellow Lotus) and it seems that she has quite an authority in Shanghai underworld."},{"spoiler":false,"text":"She behaves as she knows something about the Girl."}],"source":"vndb","sourceCharacterId":"c19361"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33424aaa60757aee4353f5bd066c5417c81eb388ef4962e1958021dd69ce14aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f4c5c65f10e3342c2975d52ce93b35661e8538ad338fe3e85429756a6ae789b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海原 エレナ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7732","source":"vndb"}]},{"characterId":"char_vndb_c19363","characterName":"眞山 皐之介","sourceIds":{"vndbCharacterId":"c19363"},"originalCharacterName":"眞山 皐之介","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend of Masashige and Harumichi."},{"spoiler":false,"text":"A rough-mannered, but attentive man born as a noble. Now he is working as a newspaper reporter."}],"source":"vndb","sourceCharacterId":"c19363"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8879c9240a617588051573319f6585f97cd10c8afee8776be92157402a89ce2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2cae94799b9c0158ef83e1a09d0712cf9cdc15bc4f25127284916066b163c8d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波多野 和俊","creatorId":"vndb:s6865","sourcePersonId":"vndb:s6865","canonicalEntityId":"vndb:s6865","name":"波多野和俊","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7739","source":"vndb"}]},{"characterId":"char_vndb_c19364","characterName":"織田桐 治道","sourceIds":{"vndbCharacterId":"c19364"},"originalCharacterName":"織田桐 治道","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head of Odagiri family and a friend of Masashige."},{"spoiler":false,"text":"He had been mastering the art of painting in France for several years, but suddenly returned home 8 months ago, shut himself in his estate and immersed himself in \"something\"."},{"spoiler":false,"text":"It is said that he has borrowed a lot of money from here and there."}],"source":"vndb","sourceCharacterId":"c19364"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4e61d44fd8d6e6cbf5d08adcb4fadaab7b19176e23837f9887d2ba2bafd8220.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d6e7ba1a3123ff6b191f70d2f7cee57a5218b66720a5664175da20c709e6bbe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皇 帝","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"皇帝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7733","source":"vndb"}]},{"characterId":"char_vndb_c19365","characterName":"蔡 子才","sourceIds":{"vndbChara