rce-native","relationId":"vndb:vn-staff:15785","source":"vndb"},{"creditedName":"KILA","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井麻美","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15786","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c19359","characterName":"少女","sourceIds":{"vndbCharacterId":"c19359"},"originalCharacterName":"少女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl with blond hair and green eyes who was left by Harumichi as a heritage."},{"spoiler":false,"text":"Not only her appearance, but voice and behaviour are adorable and innocent. Even her sulky face and angry voice are charming."},{"spoiler":false,"text":"Her age and origin are unknown. She also doesn't know anything about herself, and even can't take a meal by her own."},{"spoiler":false,"text":"She earnestly adores her Master (Masashige) and entrusts everything to him."}],"source":"vndb","sourceCharacterId":"c19359"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cffaeaf51965700b38ca84fe1a69ed075af7a2ce1167854af8fb6765aeba5dab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fa956ac0def8c15aececc19901e4b41ce10b8e8086b8d395ba71f2b0d0c8f5f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まき いづみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7736","source":"vndb"}]},{"characterId":"char_vndb_c19360","characterName":"矢旗澤 香純","sourceIds":{"vndbCharacte