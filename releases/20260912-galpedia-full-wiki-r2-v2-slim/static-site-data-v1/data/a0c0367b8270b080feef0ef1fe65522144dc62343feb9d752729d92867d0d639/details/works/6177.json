e/terminal-wiki/v1/characters/v1/images/92/92e038c585a9c29313b4ca1b594b197c7128e7e8b7a2a2f33b4c07e38f461981.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8ad5a9ebed15119bbbf44c91ea9f7a5edf1cd519beaadb92dba15e93195f4858.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218175:90851:4432:1","source":"bangumi"}]},{"characterId":"char_c5426","characterName":"御島 せり","sourceIds":{"bangumi":[{"characterId":"90850","match":"exact-normalized-name-in-linked-work","subjectId":"206342"}],"egsCharacterIds":["12241"],"vndbCharacterId":"c5426"},"originalCharacterName":"御島 せり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の花嫁候補の一人。"},{"spoiler":false,"text":"御来屋の分家である御島家の娘。"},{"spoiler":false,"text":"主人公とは初対面のはずだが、せりは辰雄を見知っている様子で「たっちゃん」と呼び、純朴な好意を顕わにする。"},{"spoiler":false,"text":"天真爛漫で人当たりが良く、元気な田舎っ娘。"},{"spoiler":false,"text":"家の畑では野菜を栽培しており、トマト嫌いな辰雄にしきりにトマトを勧めてくる。"}],"source":"egs","sourceCharacterId":"12241","sourceWorkId":"3252","spoiler":false},{"segments":[{"spoiler":false,"text":"御来屋の分家である御島家の娘。"},{"spoiler":false,"text":"総天然田舎娘。辰雄の花嫁候補その１。辰雄とは初対面のはずだが、せりは辰雄を見知っている様子で、「たっちゃん」と呼び、純朴な好意を顕わにする。天真爛漫で人当たりが良く、元気な田舎っ娘。家の畑では野菜を栽培しており、トマト嫌いな辰雄にしきりにトマトを勧めてくる。"},{"spoiler":false,"text":"「ト～～マト、トマト♪　おいしい、トマト♪　あっかくて、おっきくって、おいしっくて♪」"}],"source":"bangumi","sourceCharacterId":"90850"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9678da85e0cf9c1827550512b5e2f0a6f8fee099fbe36003475a0dadeabd3e68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ac7015a3b12b1ea9bdabcf773e17133941734371ce7674062d57bc338eaf207.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218175:90850:4463:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p956","sourceCompanyId":"egs:brand:946","canonicalEntityId":"vndb:p956","name":"ネル","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6177:946","source":"egs"},{"companyId":"vndb:p956","sourceCompanyId":"vndb:p956","canonicalEntityId":"vndb:p956","name":"ネル","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10665:v4754","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
