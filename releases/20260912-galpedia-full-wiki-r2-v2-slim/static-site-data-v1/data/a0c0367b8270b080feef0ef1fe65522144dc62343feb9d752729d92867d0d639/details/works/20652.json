."}],"source":"vndb","sourceCharacterId":"c40191"},{"segments":[{"spoiler":false,"text":"明日菜の一年先輩。学園の生徒会長。"},{"spoiler":false,"text":"どこか上品で気品を感じさせ、物腰柔らかでありながらも、生徒会長として指摘すべき点はびしっと指摘する優等生。"},{"spoiler":false,"text":"生成優秀、運動能力優秀、見た目は美人と非の打ち所がない。"},{"spoiler":false,"text":"憧れている生徒は男女ならずとも多い。"},{"spoiler":false,"text":"実は彼女もチンポを持ち合わせているふたなりだが、もちろんそれは明日菜同様に秘め事。"},{"spoiler":false,"text":"明日菜と違い、彼女の肉棒には睾丸が付いている。"},{"spoiler":false,"text":"だが、彼女自身は己の肉棒を汚らわしいと毛嫌いし、嫌悪している。"},{"spoiler":false,"text":"疼きに耐えかね仕方なく自慰をするが、それはもっぱら女性器で行い、男性器には一切触れない。しかし絶頂するのはいつもチンポ。"},{"spoiler":false,"text":"ある日、生徒会室での明日菜のオナニー現場を目撃する。"},{"spoiler":false,"text":"自分とは違い、臆面も無く肉棒を掴み、そして愛でている彼女に言い表せない強い感情を得てしまう。"},{"spoiler":false,"text":"その感情は『明日菜のオナニーを手伝う』という、飛んでもない事を彼女自身に口走らせてしまったのだった。"}],"source":"egs","sourceCharacterId":"4557","sourceWorkId":"20652","spoiler":false},{"segments":[{"spoiler":false,"text":"成績優秀、運動能力優秀、見た目は美人と非の打ち所がない。"},{"spoiler":false,"text":"物腰柔らかでありながらも、生徒会長として指摘すべき点はびしっと指摘する優等生。"},{"spoiler":false,"text":"憧れている学生は男女問わず多い。"},{"spoiler":false,"text":"「私は女の子なのに、生徒会長なのに、どうしてこんな汚らしいものがッ！」"}],"source":"bangumi","sourceCharacterId":"40944"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"4557","sourceWorkId":"20652","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"4557","sourceWorkId":"20652","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"4557","sourceWorkId":"20652","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"4557","sourceWorkId":"20652","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c40191","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"4557","value":"女性"},{"comparisonValue":"f","sour