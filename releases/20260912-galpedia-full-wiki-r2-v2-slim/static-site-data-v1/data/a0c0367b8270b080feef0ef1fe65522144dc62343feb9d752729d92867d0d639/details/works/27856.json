:false,"text":"A twintailed girl who is always full of energy. Called \"Genius Girl\" in certain areas and has her name published in papers. She hates her surname, and does not want people calling her by it. She's roommates with Ruka."}],"source":"vndb","sourceCharacterId":"c50424"},{"segments":[{"spoiler":false,"text":"元気いっぱいでツインテールな女の子。"},{"spoiler":false,"text":"界隈では知られた「天才少女」であり、数多の論文を発表している。"},{"spoiler":false,"text":"自分の苗字が嫌いで、名前で呼ばないと怒る。"},{"spoiler":false,"text":"マヨネーズについては一家言ある様子。"}],"source":"egs","sourceCharacterId":"10558","sourceWorkId":"23563","spoiler":false},{"segments":[{"spoiler":false,"text":"元気いっぱいでツインテールな女の子。"},{"spoiler":false,"text":"とある界隈では名の知れた“天才少女”であり、数多の論文を発表している。"},{"spoiler":false,"text":"自分の苗字が嫌いで、名前で呼ばないと怒る。"},{"spoiler":false,"text":"マヨネーズについては一家言ある様子。"},{"spoiler":false,"text":"「はい、それではこちら、ご紹介に預かりましたももです！　ももちゃんとお呼びください！」"}],"source":"bangumi","sourceCharacterId":"43698"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02b195434e79b9eff535361cd3bf8a1c61b5d3a6f71e6307720a5ceb91948beb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1a61590799eb8cf919aaa0cfc1f21f8a6eb82dabac55632017ee594fbe7339d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松平美波穂","creatorId":"vndb:s601","sourcePersonId":"vndb:s601","canonicalEntityId":"vndb:s601","name":"松平 美波穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:293800:43698:15488:1","source":"bangumi"}]},{"characterId":"char_c50425","characterName":"アイ","sourceIds":{"bangumi":[{"characterId":"43699","match":"exact-normalized-name-in-linked-work","subjectId":"176606"}],"egsCharacterIds":["10559"],"vndbCharacterId":"c50425"},"originalCharacterName":"アイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect"