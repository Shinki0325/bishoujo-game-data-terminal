b:s7547","canonicalEntityId":"vndb:s7547","name":"石川 由依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78367","source":"vndb"}]},{"characterId":"char_vndb_c73097","characterName":"桃野 夕","sourceIds":{"vndbCharacterId":"c73097"},"originalCharacterName":"桃野 夕","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Let's run. Please, Kyosuke.\""},{"spoiler":false,"text":"A girl with a simple and innocent personality. Has known Sakurai for the longest."},{"spoiler":false,"text":"Lived nextdoor to Sakurai, and grew up together like siblings."},{"spoiler":false,"text":"Even as a high school student now, she always sticks to Sakurai."},{"spoiler":false,"text":"She is in the Camera Club, and brings with her a pink camera at all times."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c73097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd09077e7b963312c0c26fd98096995198d8aac456d769e347d6dbf80da63ec5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf31c55b3772a87944f689596677d061a9e195a5938b9cc04ef630439080db4f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木戸 衣吹","creatorId":"vndb:s9797","sourcePersonId":"vndb:s9797","canonicalEntityId":"vndb:s9797","name":"木戸衣吹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78368","source":"vndb"}]},{"characterId":"char_vndb_c73098","characterName":"東国 ユリア","sourceIds":{"vndbCharacterId":"c73098"},"originalCharacterName":"東国 ユリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Just kidding. It's joke.\""},{"spoiler":false,"text":"Despite the childish look and actions, she is a genius physicist acknowledged by the government."},{"spoiler":false,"text":"Carries around a strange stuffed animal that she named Patty."},{"spoiler":false,"text":"She acts at her own pace, but when something happened within the group of friends, she has always helped solve the problem using her intelligence."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c73098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc92937bda63c8fbcf04880a75cda2eee09557b693960b1f9458ff5cf551f4ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f9803ba6aacc23ef23a4fdb393eddbbecc33975880cdceb7bd4f79210c3eac3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚木 尚子","creatorId":"vndb:s16410","sourcePersonId":"vndb:s16410","canonicalEntityId":"vndb:s16410","name":"柚木 尚子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78369","source":"vndb"}]},{"characterId":"char_vndb_c73099","characterName":"神谷 才","sourceIds":{"vndbCharacterId":"c73099"},"originalCharacterName":"神谷 才","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Leave it to me."},{"spoiler":false,"text":"I'll take care of everything.\""},{"spoiler":false,"text":"President of the student council at high school. Son of a renowned politician."},{"spoiler":false,"text":"Handsome, smart, and athletic; He is a perfect figure."},{"spoiler":false,"text":"He was the brain of the 8, and had led the group together with Sakurai."},{"spoiler":false,"text":"Using his talents and personal connections, he has overcome many difficulties."},{"spoiler":false,"text":"In the \"Chronos World\", he seems a bit different..."},{"spoiler":false,"text":"From Official site"},{"spoiler":true,"text":"He is actually not Kamiya Sai, but Kamiya Sae, his little sister."},{"spoiler":true,"text":"The real Kamiya Sai has been in the Chronos World before and died there. Sae took his place as their father's successor."}],"source":"vndb","sourceCharacterId":"c73099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a614ca96ce77f4283b29371f3b09b698291b40358e7f471976f6df520c3ec66c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fef512a1149de2ddf5944b7fcc8dfb0ed30670eeab0ed6034792f6b10ee79a72.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朴 ロ美","creatorId":"vndb:s625","sourcePersonId":"vndb:s625","canonicalEntityId":"vndb:s625","name":"朴 璐美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78365","source":"vndb"}]},{"characterId":"char_vndb_c73100","characterName":"両角愛","sourceIds":{"vndbCharacterId":"c73100"},"originalCharacterName":"両角愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm the one that knows Kamiya-kun the best.\""},{"spoiler":false,"text":"Secretary of the school council at high school. Has a very serious personality."},{"spoiler":false,"text":"Puts righteousness as her number one priority. She is strict to everybody, including herself."},{"spoiler":false,"text":"Kamiya saved her 