source":"egs","sourceCharacterId":"13631","sourceWorkId":"24252","spoiler":false},{"segments":[{"spoiler":false,"text":"お金欲しさに動画配信業を始め、瞬く間に人気に火がついた実力者。"},{"spoiler":false,"text":"イケボでトークに定評がある。"},{"spoiler":false,"text":"人気の影で別の動画サイトに、オフ会で知り合った女の子とのオフパコ動画を投稿し、こちらでも再生数を荒稼ぎしている。"},{"spoiler":false,"text":"正真正銘のクズ。"}],"source":"bangumi","sourceCharacterId":"218907"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c72850","characterName":"北見 有紗","sourceIds":{"bangumi":[{"characterId":"49715","match":"exact-normalized-name-in-linked-work","subjectId":"204755"}],"egsCharacterIds":["13629"],"vndbCharacterId":"c72850"},"originalCharacterName":"北見 有紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世間知らずなところのある黒髪清楚なヒロイン。"},{"spoiler":false,"text":"浮き世離れした雰囲気があり、クラスでは浮きがち。"},{"spoiler":false,"text":"家庭も厳しく、習い事を多くこなし、多忙である。"},{"spoiler":false,"text":"そんな有紗も暇を見つけては、年相応にゲーム実況や歌ってみたを視聴している。"},{"spoiler":false,"text":"近頃は、主人公の投稿する動画を見るのが密かな楽しみで、お小遣いを動画の宣伝に費やしている。"}],"source":"egs","sourceCharacterId":"13629","sourceWorkId":"24252","spoiler":false},{"segments":[{"spoiler":false,"text":"世間知らずなところのある黒髪清楚なお嬢様。"},{"spoiler":false,"text":"浮き世離れした雰囲気があり、クラスでは浮きがち。 習い事も多くて忙しい。"},{"spoiler":false,"text":"男性の手すら握ったことがない奥手な一面も。"},{"spoiler":false,"text":"年相応にゲーム実況や“歌ってみた”を視聴している。"},{"spoiler":false,"text":"近頃は主人公が投稿する動画を見るのを密かな楽しみにしており、お小遣いを動画の宣伝に費やしている。"},{"spoiler":false,"text":"「初めてなので…… その、優しく、してくださいね」"}],"source":"bangumi","sourceCharacterId":"49715"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b826774ef9c753068717f4dbe83ad11e39ca3c0de4564aade4c10282b07439bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2ae2005524163f1bc227903964964d9cad328759c3aac3aedfd5214db5eae9c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ありかわ真奈","creatorId":"vndb:s5761","sourcePersonId":"vndb:s5761","canonicalEntityId":"vndb:s5761","name":"ありかわ真奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:204755:49715:21127:1","source":"bangumi"}]},{"characterId":"char_c72851","characterName":"丸川 鈴","sourceIds":{"bangumi":[{"characterId":"49716","match":"exact-normalized-name-in-linked-work","subjectId":"204755"}],"egsCharacterIds":["13630"],"vndbCharacterId":"c72851"},"originalCharacterName":"丸川 鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"北見有紗の友人でクラスメイト。"},{"spoiler":false,"text":"以前から主人公と関係を持っており、カノジョを自称している。"},{"spoiler":false,"text":"普段から主人公とのハメ撮りを投稿しており、求められればどんなプレイでもすると言っているが、強気な態度とは裏腹に、主人公の捨てられるのが怖くて、愛されようと必死で背伸びしている。"},{"spoiler":false,"text":"主人公の親愛に応えるために、親友である北見有紗を貶める。"}],"source":"egs","sourceCharacterId":"13630","sourceWorkId":"24252","spoiler":false},{"segments":[{"spoiler":false,"text":"北見有紗の数少ない友人でクラスメイト。"},{"spoiler":false,"text":"以前から主人公と関係を持っており、カノジョを自称している。"},{"spoiler":false,"text":"また主人公とのハメ撮りを投稿しており、求められればどんなプレイでもする。"},{"spoiler":false,"text":"強気な態度とは裏腹に、捨てられるのを恐れて愛されようと必死で背伸びしている。"},{"spoiler":false,"text":"「つーか、鈴、聞いてないんだけど？」"}],"source":"bangumi","sourceCharacterId":"49716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77f9b165966683ce2cbe8912d0934f268d059a78a578b49654872a63fa9c429c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1fc908cfb87636166e8c1f69ce32a3bc921f26b514fb3ddb21a50378999e900.webp","width":213,"height":256,"source":"static-d