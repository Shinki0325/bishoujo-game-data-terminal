","source":"vndb"},{"creditedName":"如月 聖","creatorId":"vndb:s11570","sourcePersonId":"vndb:s11570","canonicalEntityId":"vndb:s11570","name":"如月 聖","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:204586","source":"vndb"},{"creditedName":"如月 聖","creatorId":"vndb:s11570","sourcePersonId":"vndb:s11570","canonicalEntityId":"vndb:s11570","name":"如月 聖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204587","source":"vndb"},{"creditedName":"花咲 樹木","creatorId":"vndb:s11571","sourcePersonId":"vndb:s11571","canonicalEntityId":"vndb:s11571","name":"花咲 樹木","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204589","source":"vndb"},{"creditedName":"heki.","creatorId":"vndb:s14765","sourcePersonId":"vndb:s14765","canonicalEntityId":"vndb:s14765","name":"heki.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204590","source":"vndb"},{"creditedName":"JENNI","creatorId":"vndb:s35062","sourcePersonId":"vndb:s35062","canonicalEntityId":"vndb:s35062","name":"JENNI","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204593","source":"vndb"},{"creditedName":"松長 暁生","creatorId":"vndb:s44160","sourcePersonId":"vndb:s44160","canonicalEntityId":"vndb:s44160","name":"松長 暁生","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204594","source":"vndb"}]},"cast":[{"characterId":"char_c13067","characterName":"レグナー・アーシェス","sourceIds":{"bangumi":[{"characterId":"12716","match":"exact-normalized-name-in-linked-work","subjectId":"13003"}],"egsCharacterIds":["10793"],"vndbCharacterId":"c13067"},"originalCharacterName":"レグナー・アーシェス","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wil's childhood friend and senior alchemist."},{"spoiler":false,"text":"Always cool and collected while helping Wil."},{"spoiler":false,"text":"He enjoys pushing himself as Wil's rival."},{"spoiler":true,"text":"His real name is Krove Zilterry. He is Emelita's older brother and second surviving heir of the last Mikelty king."}],"source":"vndb","sourceCharacterId":"c13067"},{"segments":[{"spoiler":false,"text":"ウィルの幼なじみにして、工匠の先輩。"},{"spoiler":false,"text":"高い技術も持つ創造体を作り出すことのできるゴーレム使いであり、先史文明の様々な技術や知識を紐解きながら、自らの工房で創造体を産み出す研究を続けている。"},{"spoiler":false,"text":"冷静沈着で皮肉屋だが、互いのことは知り尽くしているほどに仲が良いウィルに対しては色々と世話を焼く。"},{"spoiler":false,"text":"新米であるウィルはなかなか周囲の職人に認められないが、レグナーは工匠同士ライバルとしてウィルと切磋琢磨することを心より楽しんでいる。"},{"spoiler":false,"text":"彼と競い合うことで、ウィルはどれだけ工匠の世界で大きくなれるのだろうか……。"}],"source":"egs","sourceCharacterId":"10793","sourceWorkId":"14709","spoiler":false},{"segments":[{"spoiler":false,"text":"ウィル的青梅竹马，早一年成为了工匠的前辈。"},{"spoiler":false,"text":"是有着高级技术的ユイドラ首屈一指的创造体师傅，解读应用着史前文明的各式技术和知识来持续研究。"},{"spoiler":false,"text":"沉着冷静，爱说讽刺的话，但也对自己的竹马好友ウィル给与了很多方面的照顾。"},{"spoiler":false,"text":"和他之间是互相竞争着，ウィル渐渐在工匠的世界成长……"},{"spoiler":false,"text":"「一直以来相互竞争的对手落后于人的话，我也会认真不起来的，让人困扰。」"}],"source":"bangumi","sourceCharacterId":"12716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c17a6bbb3b7124390f6d3334736131f2650d2f38e75ee03b4fb1b88bb1a5b9ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5b33beb9e225ecd839f303ccb4b7d1fcc889bd8ea616c7abf12c0da31c18484.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c492","characterName":"セラヴァルウィ・エンドース","sourceIds":{"bangumi":[{"characterId":"12707","match":"exact-normalized-name-in-linked-work","subjectId":"13003"}],"egsCharacterIds":["10786"],"vndbCharacterId":"c492"},"originalCharacterName":"セラヴァルウィ・エンドース","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Elf from the nearby forest that came to Yuidora to understand humans and their living style. Became fascinated with Will as she saw him as a person who would be able to promote the co-existance of elves and humans, thus becoming his teacher in matters related to elves and spirits."}],"source":"vndb","sourceCharacterId":"c492"},{"segments":[{"spoiler":false,"text":"近隣の森に住まうエルフ。人には呼びにくい名前の為、ウィルが「セラウィ」という略称で呼ぶようになる。"},{"spoiler":false,"text":"その呼び名は人間からの初めての贈り物として大切にしている。"},{"spoiler":false,"text":"寿命や暮らしなどの生き方が大きく異なることもあり、人とは相容れないと考える者が多いエルフ族の中で、人間族に興味を持って共存できる可能性を模索している稀有な人物。"},{"spoiler":false,"text":"その考え方ゆえにエルフと人間の橋渡し役となるべくユイドラへの使者として送られてきた。"},{"spoiler":false,"text":"情報収集の為に訪れた酒場で主人公と出会い、共存の足がかりとなる素質を見出し教官役を買って出る。"},{"spoiler":false,"text":"普段は明るくおっとりとした性格だが、迷宮で戦いを教える姿は厳しい。"},{"spoiler":false,"text":"それも全ては主人公の無事を願うためである。"},{"spoiler":false,"text":"長い時を生きるエルフの恒久的な考え方。"},{"spoiler":false,"text":"短い生の中で次々と新たな物を生み出し多くのことを忘れていく人間の姿"}],"source":"egs","sourceCharacterId":"10786","sourceWorkId":"14709","spoiler":false},{"segments":[{"spoiler":false,"text":"生活在附近的森林里的精灵族。因为有着发音难的名字，所以ウィル就叫她作「セラウィ」。"},{"spoiler":false,"text":"因为寿命和生存方式等的不同处，在多数认为和人类是无法相容的精灵族中罕有地对人类感兴趣，并积极去摸索和人类之间的共存可能性的人物。"},{"spoiler":false,"text":"为了收集情报而来到酒场并认识了主人公，在主人公身上看到共存的线索所以就自荐教官一职。"},{"spoiler":false,"text":"平时是开朗文静的性格，但在迷宫中的战斗教导可是很严厉。"},{"spoiler":false,"text":"那也全是希望主人公能够平安无事所做的。"},{"spoiler":false,"text":"「这是第一份从人类那收到的礼物。一定会成为我的重要回忆的……」"}],"source":"bangumi","sourceCharacterId":"12707"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07504ef67985bdbcda50adb46f3b3da8f019d97252f93b05a33f65269b1137dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1