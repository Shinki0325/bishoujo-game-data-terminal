v1/characters/v1/images/39/3925328b243fa99627680da0c9a9756c1ae0f431639f71fe5aa4b80a4fe65141.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しましまはかせ","creatorId":"vndb:s44624","sourcePersonId":"vndb:s44624","canonicalEntityId":"vndb:s44624","name":"しましまはかせ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97284","source":"vndb"}]},{"characterId":"char_vndb_c139062","characterName":"アルヴィナ","sourceIds":{"vndbCharacterId":"c139062"},"originalCharacterName":"アルヴィナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A borderline psychopath and battle maniac who is happiest when fighting and killing her enemies. She enjoys testing herself, getting stronger, and facing strong enemies. While she is loyal to her salt, that doesn't prevent her from deliberately misinterpreting orders to her convenience. She currently serves as Lucretzia's bodyguard and general enforcer (basically intimidating and killing rivals). She is a devotee of the dark gods, but she doesn't take it too seriously. However, she shares the amorality of many of her fellows."}],"source":"vndb","sourceCharacterId":"c139062"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12ec45d29cbd14e43a21be343279e4372664a8404442357b0ee1681631ef75e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e755e3a1a5d838a9d030d0a9986b6e7a4256daa66251443678b84d29248e82c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北板 利亜","creatorId":"vndb:s992","sourcePersonId":"vndb:s992","canonicalEntityId":"vndb:s992","name":"藤原 由林","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97267","source":"vndb"}]},{"characterId":"char_vndb_c139063","characterName":"ヴェラ","sourceIds":{"vndbCharacterId":"c139063"},"originalCharacterName":"ヴェラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An amazoness from the Yusol Tribal Nation. Unlike most of her people, she is pragmatic and calm, with a sense of curiosity about the outside world."}],"source":"vndb","sourceCharacterId":"c139063"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8d6d24a40f5f80c66b5a83377816e542136295a9535954d207bac9b4d89ca3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31116ff13cbf94f369b318f1263f6b25795d8f1b4b914fcc983e1828ca40fb78.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あかし ゆき","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97271","source":"vndb"}]},{"characterId":"char_vndb_c139064","characterName":"エルネス","sourceIds":{"vndbCharacterId":"c139064"},"originalCharacterName":"エルネス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/701668408151cb1bc48955a4af610560eebfeb77d1739b06b3387b04c3186fa7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04c318859ffe0275ed160f