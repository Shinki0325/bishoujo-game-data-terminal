:{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f9ea1f7b66a0cbc9c8e9fe36ceff0c5d113270022089a4be98ac5d643e87bfc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d984073f08f760829a1394d440b5c25ca3e7ac7685ec7e12ccd547464b3f7ec.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村まどか","creatorId":"vndb:s12128","sourcePersonId":"vndb:s12128","canonicalEntityId":"vndb:s12128","name":"木村まどか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:16764","source":"vndb"}]},{"characterId":"char_vndb_c72794","characterName":"アルベール・カモミール","sourceIds":{"vndbCharacterId":"c72794"},"originalCharacterName":"アルベール・カモミール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dc6ecac644ed65f0f6d23a4a47afdd5e3606573563caa139747152c1f8ff78f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd3206659afbfc5941a04746de63fca3c7e6d4a796c007cb5d684dd8a618bceb.webp","width":111,"height":150,"source":"static-detail"},"actors":[{"creditedName":"矢部 雅史","creatorId":"vndb:s16172","sourcePersonId":"vndb:s16172","canonicalEntityId":"vndb:s16172","name":"矢部 雅史","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:16772","source":"vndb"}]},{"characterId":"char_vndb_c95944","characterName":"エヴァンジェリン・アタナシア・カテリン・マクダウェル","sourceIds":{"vndbCharacterId":"c95944"},"originalCharacterName":"エヴァンジェリン・アタナシア・カテリン・マクダウェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eva's appearance at night."},{"spoiler":false,"text":"Attendance number: 26."},{"spoiler":false,"text":"Date of Birth: Unknown."},{"spoiler":false,"text":"Club activities: Go club, tea ceremony club"},{"spoiler":false,"text":"Evangeline is a British \"high daylight walker\" pure-blooded-vampire (真祖, Shinso, true Ancestor) who was turned at the age of ten during the Hundred Years' War. After many years of struggle, hiding, and hardship, she eventually became known as one of the most feared mages in both worlds."},{"spoiler":false,"text":"Evangeline's power is notorious in the Magic World, which leads to her being called by many fearsome nicknames. As a dark mage, Evangeline specializes in ice-based spells and dark magic, and is shown to be incredibly powerful. Her abilities also allow her to fly and have extremely fast regeneration. She is also a master of puppetry, and she is able to control hundreds of marionettes at once, or use the ability on her opponents. She currently only uses one sentient doll, Chachazero (Chachamaru), although she cannot move without a large concentration of magic."},{"spoiler":true,"text":"After coming into contact with Nagi Springfield, she starts following him around out of love until he seals her within the Mahora Academy grounds, telling her to \"live in the light for a change\" and promising to free her upon graduation. He disappears soon after, which means that she cannot be freed without blood from his bloodline, which makes her target Negi."},{"spoiler":true,"text":"Evangeline attempts to obtain Negi's blood and free herself from the curse, but as she cannot regularly access her power, she is eventually defeated. She takes an interest in Negi afterward, and decides to not pursue him any longer. She takes him as a student sometime later, helping him improve his combat and magical abilities. She occasionally takes his blood as payment, and they train within a special miniaturized world, which she refers to as her \"resort,\" which is located within a glass sphere where a day inside the sphere is only an hour. She also trains Asuna, Setsuna, and several other members of Negi's group."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c95944"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b37175a7b9643831b08fc42bd52a7dca0c2d8a1f54a27d5035160dafbec6792.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6724ae972c615b82d71c3f6eae26032f9ef247ecfe77394c4dbeee8e54a5ca9.webp","width":145,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p77","sourceCompanyId":"egs:brand:621","canonicalEntityId":"vndb:p77","name":"KONAMI","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6301:621","source":"egs"},{"companyId":"vndb:p77","sourceCompanyId":"vndb:p77","canonicalEntityId":"vndb:p77","name":"KONAMI","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4943:v2098","source":"vndb"},{"companyId":"vndb:p77","sourceCompanyId":"vndb:p77","canonicalEntityId":"vndb:p77","name":"KONAMI","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4944:v2098","source":"vndb"},{"companyId":"vndb:p77","sourceCompanyId":"vndb:p77","canonicalEntityId":"vndb:p77","name":"KONAMI","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4945:v2098","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
