{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10895","model":{"presentationWorkId":"vndb:v2499","staff":{"artwork":[{"creditedName":"あちくん","creatorId":"vndb:s2902","sourcePersonId":"egs:creator:5503","canonicalEntityId":"vndb:s2902","name":"あちくん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:69927","source":"egs"}],"scenario":[{"creditedName":"草薙","creatorId":"vndb:s1964","sourcePersonId":"egs:creator:10804","canonicalEntityId":"vndb:s1964","name":"草薙","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:69928","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c20765","characterName":"神谷 恵子","sourceIds":{"bangumi":[{"characterId":"204761","match":"exact-normalized-name-in-linked-work","subjectId":"184790"}],"egsCharacterIds":["18115"],"vndbCharacterId":"c20765"},"originalCharacterName":"神谷 恵子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"307"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"由佳子が養っている女の子の一人。長女。"},{"spoiler":false,"text":"おっとり天然ボケの眼鏡ッ娘関西人。"},{"spoiler":false,"text":"性格は優しく、穏やかで、母性溢れる女性。"},{"spoiler":false,"text":"ボケボケしてはいるものの、仕事は出来るらしく、会社ではそれなりの地位にいるらしい。"},{"spoiler":false,"text":"小さい頃に家族がバラバラになってしまった過去があり、そのときに生き別れになった弟を気にしている。"}],"source":"egs","sourceCharacterId":"18115","sourceWorkId":"10895","spoiler":false},{"segments":[{"spoiler":false,"tex