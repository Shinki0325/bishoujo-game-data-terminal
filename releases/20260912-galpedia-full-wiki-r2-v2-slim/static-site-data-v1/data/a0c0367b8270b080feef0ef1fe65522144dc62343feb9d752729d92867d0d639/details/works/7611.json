eWorkId":"20552","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bededb300fb7b2d21452fc21ed646073d13d1bedd0ba983ace853e594d1605d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91b1ac63cde71ecc8921467917383021dbf56bbc632af736ed783a3afbb5861c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c23821","characterName":"井上 ひなた","sourceIds":{"bangumi":[{"characterId":"55776","match":"exact-normalized-name-in-linked-work","subjectId":"219392"}],"egsCharacterIds":["3907"],"vndbCharacterId":"c23821"},"originalCharacterName":"井上 ひなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"静香の姉。通称、ひなた姉。"},{"spoiler":false,"text":"高校時代は新体操で活躍し、オリンピック候補になったこともあるほどの逸材だったが、怪我のために引退。"},{"spoiler":false,"text":"現在は体育教師となり、本人の強い希望により聖風学園に転任してくる。"},{"spoiler":false,"text":"静香に劣らぬ美貌の持ち主で、明るく面倒見の良い性格から赴任早々、学園の人気者になる。"},{"spoiler":false,"text":"主人公と静香の淫らな交際を禁止するが、誤まって超強力な発情の媚***を飲んでしまったことから、発情を抑えるために主人公とアブナイ関係に……!?"}],"source":"egs","sourceCharacterId":"3907","sourceWorkId":"7611","spoiler":false},{"segments":[{"spoiler":false,"text":"静香の姉で通称・ひなた姉。"},{"spoiler":false,"text":"静香と同様優秀な女の子で高校時代は新体操で活躍、マスコミなどにも取り上げられオリンピック候補になった事もある。（ケガが原因で引退）"},{"spoiler":false,"text":"高校卒業後、一人暮らしをはじめ大学卒業後に高校教師となり、本人の強い希望で聖風学園に体育教師として転任してくる。"},{"spoiler":false,"text":"そして静香に劣らぬその容姿と明るい面倒見の良い性格ですぐに聖風学園人気ＮＯ1の先生となる。また赴任して草々、新体操部のコーチを任されたりもしている。"},{"spoiler":false,"text":"主人公と静香の交際に気付き、それを禁止するが、主人公が静香に飲ませようと思っていた超強力媚薬を過って飲んでしまい、発情を抑えるために主人公と危険な関係に!?"}],"source":"egs","sourceCharacterId":"3907","sourceWorkId":"20552","spoiler":false},{"segments":[{"spoiler":false,"text":"静香の姉で通称・ひな姉。"},{"spoiler":false,"text":"静香と同様優秀な女の子で高校時代は新体操で活躍、"},{"spoiler":false,"text":"マスコミなどにも取り上げられオリンピック候補になった事もある。（ケガが原因で引退）"},{"spoiler":false,"text":"高校卒業後、一人暮らしをはじめ大学卒業後に高校教師となり、本人の強い希望で聖風学園に体育教師として転任してくる。"},{"spoiler":false,"text":"そして静香に劣らぬその容姿と明るい面倒見の良い性格ですぐに聖風学園人気ＮＯ1の先生となる。"},{"spoiler":false,"text":"また赴任して早々、新体操部のコーチを任されたりもしている。"},{"spoiler":false,"text":"主人公と静香の交際に気付き、それを禁止するが、主人公が静香に飲ませようと思っていた超強力媚薬を誤って飲んでしまい、発情を抑えるために主人公と危険な関係に！？"}],"source":"bangumi","sourceCharacterId":"55776"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c10663bef91d2e1270ded0e54e0208c3d188e5939225837a3be95367cddbe47a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc115e5309c521dc3ad233b2f3819248d2f625f5cdd61a028c5a8697da171af4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219392:55776:5890:1","source":"bangumi"}]},{"characterId":"char_c23822","characterName":"井上 静香","sourceIds":{"bangumi":[{"characterId":"55772","match":"exact-normalized-name-in-linked-work","subjectId":"219391"},{"characterId":"55772","match":"exact-normalized-name-in-linked-work","subjectId":"219392"}],"egsCharacterIds":["3906"],"vndbCharacterId":"c23822"},"originalCharacterName":"井上 静香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“橘ミキオ（主人公）”の自宅の隣に住んでいる幼馴染。主人公と同じ聖風学園の2年生だ。"},{"spoiler":false,"text":"容姿端麗、学業優秀、モデル体系に美巨乳と男子、女子ともに人気があり、現在は、生徒会長も務めている彼女。"},{"spoiler":false,"text":"ある日、その主人公に「恥ずかしい写真」を撮られ、それをネタに『奴隷彼女』になるよう強要され、敢えなく応じることに……"},{"spoiler":false,"text":"最初は、なんて酷い人間なんだと思っていた彼女だが、元人気ＡＶ男優の著作「女の堕とし方、秘儀伝授」全12巻から学んだ（とされる）主人公の性技に狂わされ、身体が勝手に反応するようになってしまうのだったが……。"}],"source":"egs","sourceCharacterId":"3906","sourceWorkId":"5227","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染にして奴隷（カノジョ）。"},{"spoiler":false,"text":"学園では生徒会長を務め、超巨乳にして容姿端麗、成績優秀の優等生から男女とも人気がある。"},{"spoiler":false,"text":"前作の経緯から、すっかり主人公と奴隷（カノジョ）な関係にあるにも関わらず、奴隷ではないとあくまでも強がる意地っ張りな女の子。"},{"spoiler":false,"text":"姉のひなたに交際を禁止され、あっさり承諾した主人公に怒り心頭の彼女は、主人公を避けるようにしているものの、主人公が姉と浮気しているのでは、とヤキモキしているようだが……。"}],"source":"egs","sourceCharacterId":"3906","sourceWorkId":"7611","spoiler":false},{"segments":[{"spoiler":false,"text":"聖風学園の2年生。ミキオの幼馴染。ミキオの自宅の隣に住んでいる。"},{"spoiler":false,"text":"幼いときはよくミキオと遊んでいて、線の細いミキオを引っ張る姉のような存在だった。"},{"spoiler":false,"text":"学園の生徒会長をしていて、モデル体型に美巨乳、抜群の容姿から男子・女子からも人気のある美少女。"},{"spoiler":false,"text":"成績もかなり優秀で周囲から期待されている。"},{"spoiler":false,"text":"そういった周囲の期待に応えようと頑張りすぎるところがあって、いつもオーバーワーク気味。"},{"spoiler":false,"text":"しかも静香は聖風学園初の女性生徒会長としてのプレッシャーがあり、なんとしてもニ年に一度行われるという聖風学園体育祭を成功裏に納めて、自分の後も女の子が気軽に参加できる生徒会にしたいと思っている。"},{"spoiler":false,"text":"そんな中、主人公に「恥ずかしい写真」を撮られて『奴隷彼女』になることに。"},{"spoiler":false,"text":"最初はなんて酷い人間なんだと思ったが、その性技に狂わされるうちに憎むどころか、身体が勝手に期待するようになっている。それがどうしても悔しい静香は、表面的にはますます厳しくミキオに反発するようになっている。"},{"spoiler":false,"text":"そんな静香だが、何かと仕事を抱え込んでしまう勝気で負けず嫌いな彼女が、気軽に何でも頼めてしまう唯一の存在が主人公である事には気付いていない。"}],"source":"egs","sourceCharacterId":"3906","sourceWorkId":"20552","spoiler":false},{"segments":[{"spoiler":false,"text":"聖風学園の2年生。ミキオの幼馴染。ミキオの自宅の隣に住んでいる。幼いときはよくミキオと遊んでいて、線の細いミキオを引っ張る姉のような存在だった。学園の生徒会長をしていて、モデル体型に美巨乳、"},{"spoiler":false,"text":"抜群の容姿から男子・女子からも人気のある美少女。成績もかなり優秀で周囲から期待されている。そういった周囲の期待に応えようと頑張りすぎるところがあって、いつもオーバーワーク気味。"},{"spoiler":false,"text":"しかも静香は聖風学園初の女性生徒会長としてのプレッシャーがあり、"},{"spoiler":false,"text":"なんとしてもニ年に一度行われるという聖風学園体育祭を成功裏に納めて、自分の後も女の子が気軽に参加できる生徒会にしたいと思っている。そんな中、主人公に「恥ずかしい写真」を撮られて『奴隷彼女』になることに。最初はなんて酷い人間なんだと思ったが、その性技に狂わされるうちに憎むどころか、身体が勝手に期待するようになっている。"},{"spoiler":false,"text":"それがどうしても悔しい静香は、表面的にはますます厳しくミキオに反発するようになっている。そんな静香だが、何かと仕事を抱え込んでしまう勝気で負けず嫌いな彼女が、気軽に何でも頼めてしまう唯一の存在が主人公である事には気付いていない。"}],"source":"bangumi","sourceCharacterId":"55772"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d4b1b3f3eeb1b48588831c6ef118b8056b647f811dc21ea135c40a4a5c436a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbea73c03beec95407abfd433a19ddd3526c79ec4bc449e7ce99fcd6e5e781a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219392:55772:6409:1","source":"bangumi"}]},{"characterId":"char_c23823","characterName":"矢口 アスカ","sourceIds":{"bangumi":[],"egsCharacterIds":["3908"],"vndbCharacterId":"c23823"},"originalCharacterName":"矢口 アスカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖風学園の1年生。校医の矢口麗華の妹。"},{"spoiler":false,"text":"明るく活発で、好奇心旺盛な女の子。"},{"spoiler":false,"text":"幼い容姿とは裏腹に、エッチに興味津々で、姉から主人公が男として最高と聞いたことから、自分の処女を奪って貰おうと躍起になって主人公を追っかけ回す。"},{"spoiler":false,"text":"聖風学園の年末恒例、部活予算争奪戦の混乱を利用してサークル連合を組織するが……。"}],"source":"egs","sourceCharacterId":"3908","sourceWorkId":"7611","spoiler":false},{"segments":[{"spoiler":false,"text":"聖風学園の1年生。校医の矢口麗華の妹。"},{"spoiler":false,"text":"活発そうなショートカットと大きな瞳がかわいい美少女。"},{"spoiler":false,"text":"その容姿とは裏腹にＨに興味深々な女の子で、姉から主人公のことを最高の男だと聞き、自分の処女を奪ってもらおうと執拗に追っかけてくる。"},{"spoiler":false,"text":"聖風学園の年末恒例、部活予算争奪戦の混乱を利用してサークル連合を組織する。"},{"spoiler":false,"text":"サークル連合の目的とは!?"}],"source":"egs","sourceCharacterId":"3908","sourceWorkId":"20552","spoiler":false}],"profileFacts":[],"metadataCandidateConflict