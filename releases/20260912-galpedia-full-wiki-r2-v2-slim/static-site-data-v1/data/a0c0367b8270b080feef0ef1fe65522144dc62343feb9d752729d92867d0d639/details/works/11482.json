characterId":"92301","match":"exact-normalized-name-in-linked-work","subjectId":"80623"}],"egsCharacterIds":["16333"],"vndbCharacterId":"c13323"},"originalCharacterName":"竜宮寺 姫乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生徒会長にして、学園を運営する竜宮寺財閥の令嬢。"},{"spoiler":false,"text":"高慢で気高く、超美人でかなりの巨乳。他人に命令されるのが大嫌いなタカビー。"},{"spoiler":false,"text":"フィギュアスケートをしており、その華麗な舞に『氷上の舞姫』と呼ばれている。"},{"spoiler":false,"text":"学園にあるスケートリンクも入学時に彼女のために立てられた物だが、もちろん部活動でも使用されている。"},{"spoiler":false,"text":"根っからの綺麗好きで、汚い物、醜い物が嫌い。"},{"spoiler":false,"text":"【暗示のストーリー】"},{"spoiler":false,"text":"高慢で高飛車な姫乃は、被虐願望を植え付け変態性癖を開発されることでストーリーが進行。"},{"spoiler":false,"text":"主人公の体液中毒にされたり、心と身体を別々の意識にさせられたりと、特異なシチュエーションが満載。"}],"source":"egs","sourceCharacterId":"16333","sourceWorkId":"11482","spoiler":false},{"segments":[{"spoiler":false,"text":"高慢で気高く、超美人でかなりの巨乳。他人に命令されるのが大嫌いなタカビー。"},{"spoiler":false,"text":"生徒会長にして、学園を運営する竜宮寺財閥の令嬢。"},{"spoiler":false,"text":"フィギュアスケートをしており、その華麗な舞で 『氷上の舞姫』と呼ばれている。"},{"spoiler":false,"text":"学園にあるスケートリンクも入学時に彼女のために建てられたものだが、もちろん部活動でも使用されている。"},{"spoiler":false,"text":"根っからのキレイ好きで、汚い物、醜い物が嫌い。"}],"source":"bangumi","sourceCharacterId":"92301"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/291909b9d73f1cdb24cf20a6eeacd39c6283464ac5adc9559a29df88f1eba68b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/453ff7407550a924ec4713a08e0a7407266a5a45443ae56137f70223bb6d2727.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前川優子","creatorId":"vndb:s1064","sourcePersonId":"vndb:s1064","canonicalEntityId":"vndb:s1064","name":"前川 優子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80623:92301:6321:1","source":"bangumi"}]},{"characterId":"char_c13324","characterName":"三好 薫子","sourceIds":{"bangumi":[{"characterId":"92302","match":"exact-normalized-name-in-linked-work","subjectId":"80623"}],"egsCharacterIds":["16334"],"vndbCharacterId":"c13324"},"originalCharacterName":"三好 薫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく、誰にでも優しい包容力のある先生。"},{"spoiler":false,"text":"良家のお嬢様で、少し抜けたところがありクラスの苛めに気づいていない。"},{"spoiler":false,"text":"主人公の担任で、同僚の教師、伸也と婚約している。"},{"spoiler":false,"text":"容姿と性格、かなりの巨乳も手伝い、学園でも相当な人気。"},{"spoiler":false,"text":"生徒思いの非常に良い先生。"},{"spoiler":false,"text":"【暗示のストーリー】"},{"spoiler":false,"text":"優しくて包容力のある薫子先生は『ＳＥＸが出来る女性＝一人前の女性』だと思い込まされて、主人公とSEXの練習をすることでストーリーが進行。"},{"spoiler":false,"text":"SEXの練習では、身体が穢れることがないと暗示をかけられているため、ファーストキスの練習、破瓜の練習と、アナルファックの練習と、その行為はエスカレート。"}],"source":"egs","sourceCharacterId":"16334","sourceWorkId":"11482","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく、誰にでも優しい包容力のある担任教師。"},{"spoiler":false,"text":"良家のお嬢様で、少し抜けたところがありクラスで蔓延しているイジメに気付いていない。"},{"spoiler":false,"text":"すでに婚約をしているが、その巨乳と容姿、性格も手伝い学園でもかなりの人気。"},{"spoiler":false,"text":"学生想いの非常に良い先生。"}],"source":"bangumi","sourceCharacterId":"92302"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c94e8414e685057bdab233cef84fae5a16529a4584b640d49d944f208b0d4e61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0184e9cb6e1ff781de4a0af835708cb405f7b9bd42b9bf0b984857a7e446485e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80623:92302:6036:1","source":"bangumi"}]},{"characterId":"char_c13325","characterName":"芹園 小百合","sourceIds":{"bangumi":[{"characterId":"92303","match":"exact-normalized-name-in-linked-work","subjectId":"80623"}],"egsCharacterIds":["16335"],"vndbCharacterId":"c13325"},"originalCharacterName":"芹園 小百合","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の隣の部屋に住む、貞淑な奥さん。"},{"spoiler":false,"text":"何事も曲がったことが大嫌いで融通が利かない生真面目タイプ。"},{"spoiler":false,"text":"相手の気持ちを考えながらも、言いたいことはきちんと伝える。"},{"spoiler":false,"text":"夫を愛しているが、夜の営みが上手くいっておらず、子供が出来ないことを悩んでいる。"},{"spoiler":false,"text":"若干欲求不満気味だが貞操観念が強い。"},{"spoiler":false,"text":"【暗示のストーリー】"},{"spoiler":false,"text":"一番最初に催眠術の犠牲者となる小百合は、夫への罪悪感に興奮する変態性癖を植え付けられ、浮気して、主人公と子作りＳＥＸすることでストーリーが進む。"},{"spoiler":false,"text":"主人公はさらなる罪悪感を与えようと、夫にもさせたことがないディープキスさせたり、潔癖症の小百合に初フェラチオさせたりする。"}],"source":"egs","sourceCharacterId":"16335","sourceWorkId":"11482","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の隣の部屋に住む、貞淑な奥さん。"},{"spoiler":false,"text":"何事も曲がったことが大嫌いで融通の利かない生真面目。相手の気持ちを考えながらも、言いたいことはきちんと伝える。"},{"spoiler":false,"text":"夫を心の底から愛しているが、夜の営みが上手くいっておらず、子供ができないことを悩んでいる。若干欲求不満気味だが貞操観念が強い。"}],"source":"bangumi","sourceCharacterId":"92303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68062f82f0192a82366c60603aeba9f3d60ccc757afd92bd3140e64e5a3e8562.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a429a42ea4dcfdd30711081a538998a63c1da6aec99c09ee672e419811f7d351.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"片浦寛子","creatorId":"vndb:s2299","sourcePersonId":"vndb:s2299","canonicalEntit