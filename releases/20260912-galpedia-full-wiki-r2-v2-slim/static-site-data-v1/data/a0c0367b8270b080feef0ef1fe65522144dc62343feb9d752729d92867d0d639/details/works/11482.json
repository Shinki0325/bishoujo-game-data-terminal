},"descriptions":[{"segments":[{"spoiler":false,"text":"誰にでも分け隔て無く優しい美少女で学園のマドンナ。"},{"spoiler":false,"text":"イケメンの不良“晶”に心惹かれている。"},{"spoiler":false,"text":"しかし恥ずかしがり屋で、その思いを伝えられずにいる。"},{"spoiler":false,"text":"主人公とは同じ園芸委員。唯奈を除く他の委員は主人公に作業を押し付けている。"},{"spoiler":false,"text":"なので、二人きりで活動することが多くそこそこ仲が良い。"},{"spoiler":false,"text":"いつも優しく接してくれる唯奈は、主人公にとって一番大好きなタイプ。"},{"spoiler":false,"text":"【暗示のストーリー】"},{"spoiler":false,"text":"ストーリーは憧れの男性を、主人公だと思わせることで進む。"},{"spoiler":false,"text":"催眠術で自分を意識でき無くさせて、膝の上で排泄させたり、涎をドリンクだと思わせて飲ませたりする。"}],"source":"egs","sourceCharacterId":"16331","sourceWorkId":"11482","spoiler":false},{"segments":[{"spoiler":false,"text":"誰にでも分け隔てなく優しい美少女で学園のマドンナ。"},{"spoiler":false,"text":"性格は恥ずかしがり屋なところもあり、イケメンの晶に恋をしているが、その思いを伝えられずにいる。"},{"spoiler":false,"text":"主人公とは同じ園芸委員で、唯奈を除く他の委員は主人公に押し付けているため、ふたりきりで活動することが多くそこそこ仲が良い。"},{"spoiler":false,"text":"いつも優しく接してくれる唯奈は、主人公にとって一番大好きなタイプ。"}],"source":"bangumi","sourceCharacterId":"92299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/709db0ddba31f96f1386657d3a9ad2a3ec38c67c327cecde6ded8ea198e2efdc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d171c9a52c613bfb610eb787237a074bd1a61d58f72ce39524cfb573549f34ed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80623:92299:11511:1","source":"bangumi"}]},{"characterId":"char_c13322","characterName":"水城 渚","sourceIds":{"bangumi":[{"characterId":"92300","match":"exact-normalized-name-in-linked-work","subjectId":"80623"}],"egsCharacterIds":["16332"],"vndbCharacterId":"c13322"},"originalCharacterName":"水城 渚","characterNameSource":null,"role":"primary","status":"source-only-cand