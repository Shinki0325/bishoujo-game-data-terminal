vndb:s32180","canonicalEntityId":"vndb:s32180","name":"矢島 秀崇","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129177","source":"vndb"},{"creditedName":"星野 夏子","creatorId":"vndb:s32185","sourcePersonId":"vndb:s32185","canonicalEntityId":"vndb:s32185","name":"星野 夏子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129178","source":"vndb"},{"creditedName":"栗本 博史","creatorId":"vndb:s32186","sourcePersonId":"vndb:s32186","canonicalEntityId":"vndb:s32186","name":"栗本 博史","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129179","source":"vndb"},{"creditedName":"大渡 勝一","creatorId":"vndb:s32188","sourcePersonId":"vndb:s32188","canonicalEntityId":"vndb:s32188","name":"大渡 勝一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129180","source":"vndb"},{"creditedName":"浦上 進","creatorId":"vndb:s32233","sourcePersonId":"vndb:s32233","canonicalEntityId":"vndb:s32233","name":"浦上 進","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129181","source":"vndb"},{"creditedName":"木本 慶子","creatorId":"vndb:s54189","sourcePersonId":"vndb:s54189","canonicalEntityId":"vndb:s54189","name":"木本 慶子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129183","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c6580","characterName":"神楽坂 優奈","sourceIds":{"vndbCharacterId":"c6580"},"originalCharacterName":"神楽坂 優奈","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuna is the main character of the series. At first, she was just another normal schoolgirl: a first-year student at Yokohama's Shiraokadai All-Girls' High School, enrolled in class 1-B, commuting from home to school each day via the local train route. Sometime prior to the first game, Yuna and several other girls entered the \"Miss Ojousama Contest\", an intergalactic beauty pageant, with Yuna herself being chosen as the winner. In doing so, she became an instant celebrity, and began a career as a popular idol singer."},{"spoiler":false,"text":"One night, the Matrix of Light Elner appeared to Yuna. She introduced herself as part of Yuna's personality (literally translated, \"her other self\"), and asked her to become the Savior of Light. Yuna then learned a great evil was about to invade the universe, and that Yuna herself had been charged with its protection. Thus began the first of Yuna's intergalactic adventures."},{"spoiler":false,"text":"Yuna is sometimes a bit clumsy and prone to making silly mistakes, and at first glance, one would think she's a natural airhead. However, she has a very energetic and positive personality that more than makes up for her shortcomings. She isn't very skilled as an idol singer, nor is she quite diligent in her studies and exercise routine, and both her enemies and friends often wonder whether she has any potential talent that has yet to be unlocked."},{"spoiler":false,"text":"During battle or times of great personal danger, Yuna undergoes a henshin sequence and appears wearing her armored battle suit, the Light Suit. Her Light Suit has a very large array of weaponry to use in her battle against the forces of evil, ranging from a sword and rifle to an incredibly powerful beam cannon called the Matrix Divider (In \"Galaxy Fraulein Yuna 2: Eternal Princess\", it is upgraded to a more powerful version known as the Matrix Divider Plus)."},{"spoiler":false,"text":"Yuna is also a HUGE fan of the TV superheroine Ojousama Kamen Polylina (or Polylina the Masked Maiden), proudly boasting her status as \"the #1 fan of the \"Polylina-sama Fanclub\". This fandom borders on complete obsession, with Yuna even going as far as referring to Polylina as her \"one and only\". Her heroine is in fact a TV character played by her best friend Lia, but for some reason, Yuna NEVER manages to figure it out. In fact, Yuna's affection for Polylina is a major running joke in the series, with Lia often reacting in some (usually humorous) fashion to Yuna's fangirlish (and somewhat misguided) proclamations of shōjo-ai for her idol."},{"spoiler":false,"text":"Her friends call her by a variety of nicknames, including \"Yuna\", \"Yuna-rin\", and \"Yuna-san\". Yuna Kagurazaka currently lives with her parents, Naoko & Yuuichiro Kagurazaka, on Earth, in Japan's Yokohama Prefecture."},{"spoiler":false,"text":"("}],"source":"vndb","sourceCharacterId":"c6580"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0095d3ad846f5e19ecb14f9169995652a45278e1d2003bec1ff41f681f7b0f6b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7164e3a33a469fca48489fa243a0ae8c3eff1df9f29e2d84afebb0f5922395a3.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"横山 智佐","creatorId":"vndb:s7607","sourcePersonId":"vndb:s7607","canonicalEntityId":"vndb:s7607","name":"横山 智佐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68815","source":"vndb"}]},{"characterId":"char_vndb_c6581","characterName":"ユーリィ・キューブ","sourceIds":{"vndbCharacterId":"c6581"},"originalCharacterName":"ユーリィ・キューブ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuri is an android created by a highly advanced race. She was discovered in some ancient ruins on the moon during the storyline of \"Galaxy Fraulein Yuna 2: Eternal Princess\". Yuri came home with Yuna and lives at her house, and then becomes Yuna's best friend. At some point, she becomes the Kagurazaka family's adopted daughter, making her full name Yuri Cube Kagurazaka. Yuri is best known for her insatiable appetite, which has led some fans to speculate that she may have a black hole for a stomach. Yuri is immensely strong though performing feats of strength depletes her energy reserves, at which point she must eat to regain her strength. Quite humorously, her appetite is also her biggest weakness, as Yuna has been seen bribing Yuri with food on more than one occasion."},{"spoiler":false,"text":"In combat, Yuri not only uses her super strength, but she uses a weapon called Twin Dragon Fangs that can interchange to Sword mode or Gun mode. Also, she can create reinforced parts for upgrading El-Line to the more powerful El-Line Noi."},{"spoiler":false,"text":"("}],"source":"vndb","sourceCharacterId":"c6581"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d0ceae64cd1680b6cc8f2ad0455d76fd7c7360d85c228eac73d4a90bd7a779f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e18a25788cfc317c5d065378337c04e633f16213d40f6c3a849585b547ac76c9.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋 美紀","creatorId":"vndb:s2161","sourcePersonId":"vndb:s2161","canonicalEntityId":"vndb:s2161","name":"高橋 美紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68813","source":"vndb"}]},{"characterId":"char_vndb_c6582","characterName":"リーアベルト・フォン・ノイエシュタイン","sourceIds":{"vndbCharacterId":"c6582"},"originalCharacterName":"リーアベルト・フォン・ノイエシュタイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lia was the leader of The 13 Frauleins of Darkness, the 13 servants of the Queen of Darkness. She was defeated by Yuna in the first video game. Since her defeat, she has become one of Yuna's closest friends and a powerful ally. Her alter-ego is Lia the Phoenix. Lia is also Polylina the Masked Maiden, a mask wearing, crime-fighting superheroine with her own TV show. For some reason, Yuna never figures out that her friend Lia is also her beloved Polylina. Lia (and Polylina) has a robotic pet cat named Milky, who can transform into various weapons."},{"spoiler":false,"text":"("}],"source":"vndb","sourceCharacterId":"c6582"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5526cd8c6035fe12924103ed538a73a2501ba0b87316c05182a9fcce785b59d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d84998157b1a90a583d95398d213de989f47eb9c1485335a76997f6f6a505005.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"冬馬 由美","creatorId":"vndb:s1084","sourcePersonId":"vndb:s1084","canonicalEntityId":"vndb:s1084","name":"冬馬 由美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68812","source":"vndb"}]},{"characterId":"char_vndb_c6583","characterName":"一条院ミサキ","sourceIds":{"vndbCharacterId":"c6583"},"originalCharacterName":"一条院ミサキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Misaki's debut appearance is at the PC-FX game Galaxy Fraulein Yuna FX: Selene of Sadness and Galaxy Fraulein Yuna OVA: Siren's Sadness. As an intelligence officer of the Galaxy Alliance under the codename: Selene (or Saline in ADV Films' translation) she disguises as a mysterious transfer student in Shiraokadai HS All-Girls' High School to investigate claimed charges that Yuna is trying to take over the galaxy. Later, thanks to Fraulein D's plot, she wrongfully accused Yuna for terrorizing the city and arrested her. Before Yuna's execution, she listened to positive testimonials of Yuna's friends, which caused her to realize that Yuna is truly innocent. In the nick of time, she prevented the execution, foiled Fraulein D's plan and entered into Yuna's circle of friends."},{"spoiler":false,"text":"Unlike others who receive their armored suits from outside sources Misaki's armored suit is standard issue to the Galaxy Alliance. She specializes in long-range combat with her Linear Railgun, has access to secret files of the Galaxy Alliance for intelligence gathering and has the ability to teleport, one of the only characters other than Lia that can perform such a feat."},{"spoiler":false,"text":"("}],"source":"vndb","sourceCharacterId":"c6583"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80702cf2fda8f9260d4d636c117c8759c2a2cd01d56b11c15cf889955c03ec02.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15540c062c987473f8411ed5f46eedb1c8ceb89d6ce7fecf5fd0b7353cf2bd9a.webp","width":256,"height":182,"source":"static-detail"},"actors":[{"creditedName":"こおろぎ さとみ","creatorId":"vndb:s802","sourcePersonId":"vndb:s802","canonicalEntityId":"vndb:s802","name":"こおろぎ さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68811","source":"vndb"}]},{"characterId":"char_vndb_c6584","characterName":"プリンセス・ミラージュ","sourceIds":{"vndbCharacterId":"c6584"},"originalCharacterName":"プリンセス・ミラージュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her real name is \"Culture Computer No.3\". She first appears in Galaxy Fraulein Yuna 2: Eternal Princess as a captain of an extremely powerful battleship, the titular \"Eternal Princess\". Scattered throughout the galaxy, hidden beacons are placed throughout every planet left eons ago, which monitors the level of conflict in the area. Whenever there is a strong level of conflict, such as interplanetary warfare, the beacon signals the Eternal Princess to go and stop the wars from reaching galactic scale by destroying the planets that are involved with its main cannon."},{"spoiler":false,"text":"When Yuna and Erika engaged into a cat-fight, they happen to be close to the beacon which signals the Eternal Princess to come and destroy Earth. Luckily, with the help of Yuri, Yuna managed to stop Earth's destruction and gained Princess Mirage's friendship. Now Princess Mirage orbits around Earth watching over Yuna, and giving the often-oversleeping Yuna her daily \"morning alarm\" (which usually provokes a rather humorous reaction from the rudely-awakened Yuna)."},{"spoiler":false,"text":"Princess Mirage is designed by Kōsuke Fujishima, hence the strong resemblance to Belldandy from Oh! My Goddess."},{"spoiler":false,"text":"("}],"source":"vndb","sourceCharacterId":"c6584"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c5b7cdee48205e68da4eaf2e01473b84feb72c2ebddb0e4982c824201f8809f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/123c292f3d0bb2708c4b91352be8ea5f932eac4dbbe331f45e22510e2dacc0bd.webp","width":147,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水谷 優子","creatorId":"vndb:s3229","sourcePersonId":"vndb:s3229","canonicalEntityId":"vndb:s3229","name":"水谷 優子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68814","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p540","sourceCompanyId":"egs:brand:761","canonicalEntityId":"vndb:p540","name":"ハドソン","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:7836:761","source":"egs"},{"companyId":"vndb:p12381","sourceCompanyId":"vndb:p12381","canonicalEntityId":"vndb:p12381","name":"Stargood Translations","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:117884:v19074","source":"vndb"},{"companyId":"vndb:p540","sourceCompanyId":"vndb:p540","canonicalEntityId":"vndb:p540","name":"株式会社ハドソン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:32776:v19074","source":"vndb"},{"companyId":"vndb:p1078","sourceCompanyId":"vndb:p1078","canonicalEntityId":"vndb:p1078","name":"株式会社レッド・エンタテインメント","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:32777:v19074","source":"vndb"},{"companyId":"vndb:p10173","sourceCompanyId":"vndb:p10173","canonicalEntityId":"vndb:p10173","name":"株式会社 ウィル","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:32778:v19074","source":"vndb"},{"companyId":"vndb:p540","sourceCompanyId":"vndb:p540","canonicalEntityId":"vndb:p540","name":"株式会社ハドソン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51895:v19074","source":"vndb"},{"companyId":"vndb:p1078","sourceCompanyId":"vndb:p1078","canonicalEntityId":"vndb:p1078","name":"株式会社レッド・エンタテインメント","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:51896:v19074","source":"vndb"},{"companyId":"vndb:p10173","sourceCompanyId":"vndb:p10173","canonicalEntityId":"vndb:p10173","name":"株式会社 ウィル","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:51897:v19074","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
