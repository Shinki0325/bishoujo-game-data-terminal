手で、男性を嫌悪。"},{"spoiler":false,"text":"しかし、委員長なのに生意気おっぱいのため、比較的小さいエリナにそのことを弄られる。"},{"spoiler":false,"text":"「ご指名ありがとうございます」"}],"source":"bangumi","sourceCharacterId":"63657"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"14406","sourceWorkId":"13049","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"14406","sourceWorkId":"13049","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"14406","sourceWorkId":"13049","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14406","sourceWorkId":"13049","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"14406","sourceWorkId":"13049","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"14406","sourceWorkId":"13049","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/808a40a6825c7e40576348a163de550e6d26cbb630929092444efb11851deee9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cac2c8e018cfeec6c2af671082249bbbf24ba0c50020fa52e2f6673c550ffe7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14410:63657:6019:1","source":"bangumi"}]},{"characterId":"char_c53593","characterName":"ミリィ・ロンデルスタット・ウィルビエント","sourceIds":{"bangumi":[{"characterId":"63659","match":"exact-normalized-name-in-linked-work","subjectId":"14410"}],"egsC