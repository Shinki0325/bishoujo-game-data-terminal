ons":[{"segments":[{"spoiler":false,"text":"本編主人公（♂）。"},{"spoiler":false,"text":"舞台となる私立秋桜女学院の臨時現代国語教師。"},{"spoiler":false,"text":"女性のように華奢な身体付きで、肌も綺麗、しかも女顔。"},{"spoiler":false,"text":"エリナに「チェリーくん」と罵られるが、一応、非童貞。"},{"spoiler":false,"text":"たまたま「キュアメイトクラブ」に踏み込んでしまったことから、無理やり女装させられた上、従業員にさせられる。"},{"spoiler":false,"text":"学生からの信頼はまだ薄いが、「キュアメイトクラブ」を通して生徒たちと触れ合っていくうちに、徐々にその信頼を勝ち取っていく。"},{"spoiler":false,"text":"「キュアメイトクラブ」内での、源氏名は、ヒロ。"}],"source":"egs","sourceCharacterId":"14410","sourceWorkId":"13049","spoiler":false},{"segments":[{"spoiler":false,"text":"本編の主人公。線が細く、女顔。"},{"spoiler":false,"text":"秋桜女学院で産休をとった先生の臨時現国教師。"},{"spoiler":false,"text":"別に化粧もしてないのに、女性のような綺麗な肌をしている。"},{"spoiler":false,"text":"タバコは吸わない。運転免許持ち。"},{"spoiler":false,"text":"たまたまキュアメイトクラブに踏み込んでしまったところから、無理やり入れられ、女装させられてしまう。"},{"spoiler":false,"text":"「え……そ、その、ヒ、ヒロです」"}],"source":"bangumi","sourceCharacterId":"63663"}],"profileFacts":[{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"14410","sourceWorkId":"13049","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"14410","sourceWorkId":"13049","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef348331f19d6c268f28430e86827ad2203c385f7621b3b7c52bfb898447d2ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3876acfa88f2bb385605cd1a4a3e4d8e5293d859dc4034da797b4f53b9e8b5e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c53596","characterName":"高嶺 業平","sourceIds":{"vndbCharacterId":"c53596"},"originalCharacterName":"高嶺 業平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"