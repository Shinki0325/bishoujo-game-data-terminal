dentityStatus":"source-native","relationId":"vndb:vn-staff:49454","source":"vndb"},{"creditedName":"乃美 糸","creatorId":"vndb:s2929","sourcePersonId":"vndb:s2929","canonicalEntityId":"vndb:s2929","name":"乃美 糸","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:49458","source":"vndb"},{"creditedName":"はらだ","creatorId":"vndb:s4015","sourcePersonId":"vndb:s4015","canonicalEntityId":"vndb:s4015","name":"はらだ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49459","source":"vndb"},{"creditedName":"有限会社マジックハウス","creatorId":"vndb:s7052","sourcePersonId":"vndb:s7052","canonicalEntityId":"vndb:s7052","name":"有限会社マジックハウス","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49462","source":"vndb"}]},"cast":[{"characterId":"char_c44221","characterName":"蓮見 奏","sourceIds":{"bangumi":[{"characterId":"92097","match":"exact-normalized-name-in-linked-work","subjectId":"80908"}],"egsCharacterIds":["18109"],"vndbCharacterId":"c44221"},"originalCharacterName":"蓮見 奏","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female student who lives with her twin brother, Hibiki."},{"spoiler":false,"text":"Due to the aftereffects of a serious injury he sustained as a child, Hibiki's right leg is slightly disabled, and she often looks after him, but she also feels some guilt for having injured him while playing around."},{"spoiler":false,"text":"Perhaps because of this, she has grown into a girl who is relied upon by those around her, and while her life revolves around Hibiki, she is also careful not to make her brother feel burdened by it."},{"spoiler":false,"text":"Recently, her breasts have suddenly started to grow, and she seems to find them a bit of a hindrance when she dresses up as a man."}],"source":"vndb","sourceCharacterId":"c44221"},{"segments":[{"spoiler":false,"text":"双子の弟・響と二人で暮らしている女子学生。"},{"spoiler":false,"text":"幼い頃の大怪我の後遺症で、少し右足が不自由な響の面倒をよく見ているが、そこには、悪ふざけで怪我をさせてしまった弟への罪悪感が多少含まれている。"},{"spoiler":false,"text":"そのためか、周囲から頼りにされる少女へと成長し、響を中心にした生活をしながらも、それを弟が負担に思わないよう気も配っている。"},{"spoiler":false,"text":"最近、急に大きくなりだした胸を、男装の際に少し邪魔に感じている模様。"}],"source":"egs","sourceCharacterId":"18109","sourceWorkId":"10900","spoiler":false},{"segments":[{"spoiler":false,"text":"女子校に通っている女子学生。明るく快活な性格で、学校では人気者。"},{"spoiler":false,"text":"母親は奏たちが物心つく前に病気で亡くなっており、父・弟・自分の3人家族。"},{"spoiler":false,"text":"父親は有名なカメラマンで仕事で海外にいることが多く、ほとんど家に居ない。"},{"spoiler":false,"text":"弟の「響（ひびき）」とは双子で同じ格好をすると見分けが付かなくなるほど似ている。"},{"spoiler":false,"text":"幼いころに響と一緒に遊んでいる時に悪ふざけをしていて響に大怪我を負わせてしまう。"},{"spoiler":false,"text":"その怪我の後遺症で響は今も右足が不自由。それ以来、自分よりも響中心の生活をしているため、恋愛関係にはあまり興味がない。"},{"spoiler":false,"text":"運動神経が良く、スポーツは全般的に得意。運動部からの誘いも多かったが、部活には所属していない。"},{"spoiler":false,"text":"弟の無実と真実を知るために男装をし、私立聖昂学園（しりつせいこうがくえん）に響のふりをして登校することになる。"}],"source":"bangumi","sourceCharacterId":"92097"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"18109","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"18109","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"18109","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"18109","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"18109","sourceWorkId":"10900","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ee20e0ea52c6149a279f0d791f04143895be2471caa262240aaad51bea6a77b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b2ee84cf0dbbab34270c53c544dee4a65868cfc58c853edbe79ab11d37fd735.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80908:92097:5907:1","source":"bangumi"}]},{"characterId":"char_c44222","characterName":"宇佐美 紗香","sourceIds":{"bangumi":[{"characterId":"92098","match":"exact-normalized-name-in-linked-work","subjectId":"80908"}],"egsCharacterIds":["18110"],"vndbCharacterId":"c44222"},"originalCharacterName":"宇佐美 紗香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the chairman of the \"Cross Committee\" that regulates the school's discipline."},{"spoiler":false,"text":"She hates injustice and is very strict with those who break the school rules."},{"spoiler":false,"text":"Because of this, she is trusted by the teachers, but many students also talk about her behind her back."},{"spoiler":false,"text":"She is a classmate of Hibiki, and she is always concerned about Hibiki, who has a disability in his leg."},{"spoiler":false,"text":"She is sensitive to bullying and has a strong aversion to it, and hates both bullies and those who are bullied."}],"source":"vndb","sourceCharacterId":"c44222"},{"segments":[{"spoiler":false,"text":"学園の風紀を取り締まる「十字委員会」の委員長。"},{"spoiler":false,"text":"曲った事が大嫌いで、校則違反者に対しては非常に厳しい。"},{"spoiler":false,"text":"そのため、教師たちの信頼は厚いが、影口を叩く生徒も多い。"},{"spoiler":false,"text":"響とはクラスメイト同士で、脚が不自由な彼を何かと気にしていた。"},{"spoiler":false,"text":"イジメに対して敏感で、強い嫌悪感を持っており、イジメる方も、イジメられる方も大嫌い。"}],"source":"egs","sourceCharacterId":"18110","sourceWorkId":"10900","spoiler":false},{"segments":[{"spoiler":false,"text":"曲がったことが嫌いでイジメなどは見逃せなく、本心を素直に出せない不器用な性格。"},{"spoiler":false,"text":"先輩後輩関係なく校則違反者には非常に厳しく、その性格と相まって陰口を叩く敵も多い。"},{"spoiler":false,"text":"2年生になって早々に十字委員会（じゅうじいいんかい）の委員長を譲り受ける。"},{"spoiler":false,"text":"聖霊降臨祭（せいれいこうりんさい）が近く、学校全体がうわついているのでピリピリしている。特に、行事を取り仕切っている典礼委員が校則違反をしたりしないか気をつけており、典礼委員に関わっている響（奏）に対しても、何かとうるさい。"}],"source":"bangumi","sourceCharacterId":"92098"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"18110","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"18110","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"18110","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"18110","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"18110","sourceWorkId":"10900","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/948b1631294e30201d8fc8e8832cc1ece7925a75a7ae00a435d3fa087174d427.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/160a1a965ea1922b62cc8d7ef04712b020ba87b794618b4e25b086dc6fbf6c19.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80908:92098:7169:1","source":"bangumi"}]},{"characterId":"char_c44223","characterName":"守谷 瑠璃","sourceIds":{"bangumi":[{"characterId":"92099","match":"exact-normalized-name-in-linked-work","subjectId":"80908"}],"egsCharacterIds":["18111"],"vndbCharacterId":"c44223"},"originalCharacterName":"守谷 瑠璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A quiet girl who is a member of the library committee."},{"spoiler":false,"text":"She prefers reading alone to chatting with friends."},{"spoiler":false,"text":"She is acquainted with Hibiki and Madoka, who are regulars at the library."},{"spoiler":false,"text":"She believes she has no special talents and is passive in everything she does."},{"spoiler":false,"text":"Because of this, she tends to envy people who have a strong sense of self."}],"source":"vndb","sourceCharacterId":"c44223"},{"segments":[{"spoiler":false,"text":"物静かな図書委員の少女。"},{"spoiler":false,"text":"友達とのお喋りよりも、一人で読書しているほうが好きなタイプ。"},{"spoiler":false,"text":"図書館常連の響やまどかとは顔見知り。"},{"spoiler":false,"text":"自分にとりえがないと思い込み、何に対しても受け身。"},{"spoiler":false,"text":"そのため、しっかりと自分を持っている人を羨む傾向がある。"}],"source":"egs","sourceCharacterId":"18111","sourceWorkId":"10900","spoiler":false},{"segments":[{"spoiler":false,"text":"図書委員会に所属する女の子で友達とお喋りするよりも、一人で静かに読書をすることのほうが好き。"},{"spoiler":false,"text":"自分はとりえの無い人間だと思っていて、何事にも諦め気味の性格。"},{"spoiler":false,"text":"しっかりと自分を持っている人を羨ましく感じ将来は好きな人と結婚して幸せに暮らしたいという夢を持っている。"},{"spoiler":false,"text":"図書室の常連である響やまどかとは顔見知りで身体が不自由ながらも自分の目標を持っている響に好意を持っている。"}],"source":"bangumi","sourceCharacterId":"92099"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"18111","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"18111","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"18111","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"18111","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"18111","sourceWorkId":"10900","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c3af72b58bb44dbaf153946f1b1302fcffe46ba89babf1e9599e159544e5c10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96fde45c41a8b79af2cdbce48c3877c114cf1006564f845e215d9345af6ab843.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80908:92099:4463:1","source":"bangumi"}]},{"characterId":"char_c44224","characterName":"白雪 まどか","sourceIds":{"bangumi":[{"characterId":"92100","match":"exact-normalized-name-in-linked-work","subjectId":"80908"}],"egsCharacterIds":["18112"],"vndbCharacterId":"c44224"},"originalCharacterName":"白雪 まどか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a sister at the church on campus and a newly transferred teacher this year."},{"spoiler":false,"text":"She is a pure Catholic and has a straightforward and gentle personality, which makes her beloved by students, both male and female."},{"spoiler":false,"text":"However, because she has always studied and taught at a Catholic girls' school, she is a little naive and easily deceived, and has little tolerance for men."},{"spoiler":false,"text":"She got to know Hibiki through tending to the flower beds, and has always been concerned about her."}],"source":"vndb","sourceCharacterId":"c44224"},{"segments":[{"spoiler":false,"text":"校内にある教会のシスターで、今年度転任してした女教師。"},{"spoiler":false,"text":"カトリックの純粋な信者であり、裏表がなくおっとりしていることから、男女問わず、学生たちに慕われている。"},{"spoiler":false,"text":"しかし、ずっとカトリック系女子校で学んで来た＆教えてきたため、少し世間知らずで騙されやすく、男性への免疫も少ない。"},{"spoiler":false,"text":"花壇の世話を通じて響と知り合い、普段から気にかけていた。"}],"source":"egs","sourceCharacterId":"18112","sourceWorkId":"10900","spoiler":false},{"segments":[{"spoiler":false,"text":"教師兼シスターで今年度から転任してきた。人を疑うことを知らず、騙されやすい性格。"},{"spoiler":false,"text":"本来はまどかの仕事ではない花壇の世話をしており、同じように花壇の世話をしていた響とは良く話をしていて足の不自由な響のことを普段から気にかけていた。"},{"spoiler":false,"text":"幼い頃からずっとカトリック系女子校で学び、教師になってからも女子校で教壇に立ち続けていたため男性に対する免疫が少ない純粋なカトリック信者。"}],"source":"bangumi","sourceCharacterId":"92100"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"18112","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"18112","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"18112","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"18112","sourceWorkId":"10900","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"18112","sourceWorkId":"10900","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7253330f0afb1cc379b9e245febbb06816bc6314b3434753ab8c9e7452eb4344.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e758860aaa2ac6676fbe0d97bdcb1d828339f319b4ab6cfbde6769df9e6cb80.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","id