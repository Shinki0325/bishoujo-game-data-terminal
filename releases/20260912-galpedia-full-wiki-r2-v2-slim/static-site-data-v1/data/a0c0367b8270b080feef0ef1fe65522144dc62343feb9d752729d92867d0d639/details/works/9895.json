{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9895","model":{"presentationWorkId":"vndb:v4354","staff":{"artwork":[{"creditedName":"深泥正","creatorId":"vndb:s2572","sourcePersonId":"egs:creator:2428","canonicalEntityId":"vndb:s2572","name":"深泥正","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:47794","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c5783","characterName":"神崎 紫音","sourceIds":{"bangumi":[{"characterId":"162933","match":"exact-normalized-name-in-linked-work","subjectId":"113275"}],"egsCharacterIds":["14085"],"vndbCharacterId":"c5783"},"originalCharacterName":"神崎 紫音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の隣に住むお姉さん。"},{"spoiler":false,"text":"彼女の家は地元の名士として通っている資産家。"},{"spoiler":false,"text":"お嬢様である彼女は、真面目で頼りがいがあり、学業優秀な上に武道の心得もあり、男子学生だけでなく、女子学生にも人気。"},{"spoiler":false,"text":"幼い頃は気弱で、お嬢様的な生活習慣のためかよく男子に苛められていた。"},{"spoiler":false,"text":"それを年下の主人公が庇ってくれたことから、お姉さんとしてもっとしっかりしようと奮起し、鉄壁な女性に成長する。"},{"spoiler":false,"text":"主人公に好意を抱き続けているが、なかなか素直になれない。"},{"spoiler":false,"text":"主人公が他の女の子にちょっかいを出していたりすると、過剰なヤキモチを焼く。"}],"source":"egs","sourceCharacterId":"14085","sourceWorkId":"9895","spoiler":false},{"segments":[{"spoiler":false,"text":"『幼馴染のお姉ちゃんは専属メイド！ ～夏休み同棲生活～』登場のヒロイン。"},{"spoiler":false,"text":"主人公の隣に住むお姉さん。"},{"spoiler":false,"text":"彼女の家は地元の名士として通っている資産家。"},{"spoiler":false,"text":"お嬢様である彼女は、真面目で頼りがいがあり、学業優秀な上に武道の心得もあり、男子学生だけでなく、女子学生にも人気。"},{"spoiler":false,"text":"幼い頃は気弱で、お嬢様的な生活習慣のためかよく男子に苛められていた。"},{"spoiler":false,"text":"それを年下の主人公が庇ってくれたことから、お姉さんとしてもっとしっかりしようと奮起し、鉄壁な女性に成長する。"},{"spoiler":false,"text":"主人公に好意を抱き続けているが、なかなか素直になれない。"},{"spoiler":false,"text":"主人公が他の女の子にちょっかいを出していたりすると、過剰なヤキモチを焼く。"}],"source":"egs","sourceCharacterId":"14085","sourceWorkId":"13401","spoiler":false},{"segments":[{"spoiler":false,"text":"秀生のお隣に住むお姉さん。家は地元でも名士で通っている資産家でお嬢様。真面目で頼りがいがあり、頭脳明晰、武道の心得まである完璧なお姉さま。校内では男子人気はもちろん、女子人気も高い。"},{"spoiler":false,"text":"幼い頃は、逆に気弱な女の子で、お嬢様的な生活習慣のためによく男の子にいじめられていた。それを弟的な立場である秀生に助けられていた。このときの出来事をきっかけに秀生のお姉ちゃんとして相応しい女性になろうと頑張り始め、いつの間にか、完璧というより鉄壁といった方がいいほど隙のない女性に成長してしまった。"},{"spoiler":false,"text":"秀生にはずっと好意を抱き続けており、彼のことを心配するあまり、厳しくせっしたり、過剰な指導をしてしまう。またお堅い風を装っているが嫉妬深いところがあり、それを素直に出せずに、秀生が他の女の子に意識を向けていると激しい暴力に訴える。"},{"spoiler":false,"text":"秀生が自分を庇って怪我をしてしまうと、昔の事を思い出し、また彼に迷惑をかけてしまったと自戒を強くする。そこを彼に付け込まれてメイドでのお世話を同意してしまう。ただし、内心では彼との同居というシチュエーションは楽しみにしている。"}],"source":"bangumi","sourceCharacterId":"162933"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10adf00fb3be7a6ac42961a8ebc708d127a8e27a855e4be17457142f02a53ff6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa3d92bb8b765d767f50155adaeada9bc3980733e153324857cb62ebcaa9915e.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c46463","characterName":"武原 秀生","sourceIds":{"vndbCharacterId":"c46463"},"originalCharacterName":"武原 秀生","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p314","sourceCompanyId":"egs:brand:2093","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9895:2093","source":"egs"},{"companyId