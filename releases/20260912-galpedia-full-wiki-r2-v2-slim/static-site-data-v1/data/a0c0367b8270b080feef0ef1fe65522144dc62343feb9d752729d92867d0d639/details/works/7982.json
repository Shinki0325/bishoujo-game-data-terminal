-native","relationId":"vndb:vn-staff:13993","source":"vndb"}]},"cast":[{"characterId":"char_c2954","characterName":"ひなた","sourceIds":{"bangumi":[{"characterId":"140273","match":"exact-normalized-name-in-linked-work","subjectId":"461266"}],"egsCharacterIds":["25323"],"vndbCharacterId":"c2954"},"originalCharacterName":"ひなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と兄がよく遊んでいた田舎の祖父の飼い犬。祖父の死後、とある神社の狛犬の霊魂と融合し、狛犬となる。"},{"spoiler":false,"text":"その後、大好きな主人公たちを思い出し、匂いをたどってやってきた。"},{"spoiler":false,"text":"体型はやや大きめ（特に胸）。"},{"spoiler":false,"text":"性格は人なつっこく、従順で忠誠心が高い。"}],"source":"egs","sourceCharacterId":"25323","sourceWorkId":"7982","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と兄が、父方の実家でよく遊んでいた祖父の犬。祖父の死後、近所の陽（ひなた）神社の狛犬の霊魂と融合し、狛犬となる。"},{"spoiler":false,"text":"融合が原因で記憶があやふやになり彷徨っていたが、大好きな主人公たちのことを思い出し、匂いをたどってやってきた。"},{"spoiler":false,"text":"元がゴールデンレトリバーだったためか、やや大きめ（特に胸）。性格は人なつっこく、従順で忠誠心が高く、犬っぽい。"},{"spoiler":false,"text":"犬的脳内ランキングは「主人公＞兄＞自分＞梓」の順番。"},{"spoiler":false,"text":"「朝ですー！　朝ですよォ！　おはようございます～～！」"}],"source":"bangumi","sourceCharacterId":"140273"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4c747d011660f5962b5380b2e638b182248a43fbe42cd1fabcc2d3d21dd01a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e63a0be96e36039d1ca9ececfbd31ebc8adbf5e81d92b3b50af199a164500190.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永井真衣","creatorId":"vndb:s896","sourcePersonId":"vndb:s896","canonicalEntityId":"vndb:s896","name":"永井 真衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:461266:140273:16172:1","source":"bangumi"}]},{"characterId":"char_c2955","characterName":"梓","sourceIds":{"bangumi":[{"characterId":"140274","match":"exact-normalized-name-in-linked-work","subjectId":"461266"}],"egsCharacterIds":["25324"],"vndbCharacterId":"c2955"},"originalCharacterName":"梓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"昔、主人公と兄に罠から助けられた化け狐の少女。"},{"spoiler":false,"text":"なかなか恩返しに行けない彼女を見かねた母狐が、都会にある学園に入学させた。"},{"spoiler":false,"text":"夜行性のくせに、早寝早起き。全体的に小柄な体型。"},{"spoiler":false,"text":"気が強いわりに引っ込み思案なところがあり、格好つけて敬語を使っているが、根は甘えん坊。"}],"source":"egs","sourceCharacterId":"25324","sourceWorkId":"7982","spoiler":false},{"segments":[{"spoiler":false,"text":"昔、主人公と兄に助けられた化け狐の少女。"},{"spoiler":false,"text":"キツネ目で、全体的にコンパクトな女の子。本名は郁芳門院 梓（かくもうほんいん あずさ）。"},{"spoiler":false,"text":"由来は単なる母ギツネの昔の住処で、梓自身初耳だった。"},{"spoiler":false,"text":"気が強いわりに引っ込み思案な性格で、なかなか恩返しに行けない彼女を見かねて、母狐が都会の学園へ入学させた。"},{"spoiler":false,"text":"格好付けて敬語を使っているが、根は甘えん坊なツン少女。"},{"spoiler":false,"text":"「おかしなことッ、言わないでください…。まったく、だから人間は…」"}],"source":"bangumi","sourceCharacterId":"140274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cad6faa835a9e950169ac56d0ca6fd0ddf0869d5c3bd9f50a76ed0f5759f3202.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21f9e340f4830f4060b2390197cf97bddce85e243411e78321b11d7e60c9a8df.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:461266:140274:6547:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:148","sourceCompa