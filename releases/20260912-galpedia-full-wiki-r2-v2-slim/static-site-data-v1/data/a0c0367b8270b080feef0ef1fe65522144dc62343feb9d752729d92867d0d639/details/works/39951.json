reatorId":"vndb:s45071","sourcePersonId":"vndb:s45071","canonicalEntityId":"vndb:s45071","name":"野原 駈","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:220689","source":"vndb"}]},"cast":[{"characterId":"char_c165029","characterName":"イレーナ＝ヴィオラ・ノクスヘイム","sourceIds":{"bangumi":[{"characterId":"195248","match":"exact-normalized-name-in-linked-work","subjectId":"616202"}],"egsCharacterIds":["28348"],"vndbCharacterId":"c165029"},"originalCharacterName":"イレーナ＝ヴィオラ・ノクスヘイム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"I am the First Princess of Noxheim, and upon that name, I will fight to the very last!"},{"spoiler":false,"text":"Irena is the First Princess of the Noxheim Empire, and no mere figurehead: she serves in the very army sworn to defend it. Proud and unbending, she holds fast to her own will no matter how the odds turn against her. Her people come before all else, and for the sake of a brighter empire she gives herself to the work without rest."},{"spoiler":false,"text":"That same lofty devotion to freedom and equality wins her the love of the common folk as surely as it costs her the regard of the imperial nobility."},{"spoiler":false,"text":"The gun at her side is a one-of-a-kind piece, forged with a Nox Crystal set into it."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c165029"},{"segments":[{"spoiler":false,"text":"ノクスヘイム帝国の第一皇女で、帝国を守る軍の一員でもある。"},{"spoiler":false,"text":"勝ち気な性格で、どんな逆境でも自分の意志を貫く強い心を持っている。"},{"spoiler":false,"text":"国民をなにより大切に想っており、帝国の明るい未来のため日々奮闘している。"},{"spoiler":false,"text":"自由と平等を望む気高き志は、庶民の心を掴む一方で、 帝国貴族からの評判はいまいち。"},{"spoiler":false,"text":"彼女の持つ銃は『ノクス・クリスタル』が埋め込まれた特注品。"}],"source":"egs","sourceCharacterId":"28348","sourceWorkId":"39951","spoiler":false},{"segments":[{"spoiler":false,"text":"ノクスヘイム帝国の第一皇女で、帝国を守る軍の一員でもある。"},{"spoiler":false,"text":"勝ち気な性格で、どんな逆境でも自分の意志を貫く強い心を持っている。"},{"spoiler":false,"text":"国民をなにより大切に想っており、帝国の明るい未来のため日々奮闘している。"},{"spoiler":false,"text":"自由と平等を望む気高き志は、庶民の心を掴む一方で、 帝国貴族からの評判はいまいち。"},{"spoiler":false,"text":"彼女の持つ銃は『ノクス・クリスタル』が埋め込まれた特注品。"}],"source":"bangumi","sourceCharacterId":"195248"}],"profileFacts":[{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"28348","sourceWorkId":"39951","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"28348","sourceWorkId":"39951","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea8580d9b3d527c915ba5e6781167bdfad13d1f7dff4117f6ed34e5b255d60d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03710097b67aa10593007cdb6f73b2e6284ea856554fdd079b7913430f357eec.webp","width":237,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:616202:195248:20833:1","source":"bangumi"}]},{"characterId":"char_c165030","characterName":"ローレッタ・セントライト","sourceIds":{"bangumi":[{"characterId":"195249","match":"exact-normalized-name-in-linked-work","subjectId":"616202"}],"egsCharacterIds":["28350"],"vndbCharacterId":"c165030"},"originalCharacterName":"ローレッタ・セントライト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Loretta is a sister of the Baselbute Order, a cult that worships Lucius as a god. She schemes to resurrect him in order to bring the Empire to ruin."},{"spoiler":false,"text":"She has a striking figure and appears as a gentle, refined beauty, but beneath the surface she's a weirdo with a fanatical, near-mad devotion to Lucius. She throws herself fully into serving him, but her reckless, indiscriminate methods leave a sense of unease."},{"spoiler":false,"text":"She possesses the 'Creation' rune. She can bring anything non-living into existence, provided that she knows its structure. All creations disappear after a time."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c165030"},{"segments":[{"spoiler":false,"text":"ルシウスを神とする『バゼルビュート教団』のシスター。"},{"spoiler":false,"text":"帝国を破滅に導くため、ルシウスの復活を企んでいる。"},{"spoiler":false,"text":"抜群のスタイルを持ち、穏やかで上品な美人という印象を受けるが、 内面はルシウスに狂気じみた信仰心を抱く変わり者。"},{"spoiler":false,"text":"ルシウスのためならば何事も全力を尽くすが、 無鉄砲かつ見境がないため、少々危うさがある。"},{"spoiler":false,"text":"“創造”のルーンの所有者。"},{"spoiler":false,"text":"構造さえ知っていれば、生き物以外はどんなものでも作り出せる。"},{"spoiler":false,"text":"作ったものはしばらくすると消える。"}],"source":"egs","sourceCharacterId":"28350","sourceWorkId":"39951","spoiler":false},{"segments":[{"spoiler":false,"text":"ルシウスを神とする『バゼルビュート教団』のシスター。"},{"spoiler":false,"text":"帝国を破滅に導くため、ルシウスの復活を企んでいる。"},{"spoiler":false,"text":"抜群のスタイルを持ち、穏やかで上品な美人という印象を受けるが、 内面はルシウスに狂気じみた信仰心を抱く変わり者。"},{"spoiler":false,"text":"ルシウスのためならば何事も全力を尽くすが、 無鉄砲かつ見境がないため、少々危うさがある。"},{"spoiler":false,"text":"“創造”のルーンの所有者。"},{"spoiler":false,"text":"構造さえ知っていれば、生き物以外はどんなものでも作り出せる。"},{"spoiler":false,"text":"作ったものはしばらくすると消える。"}],"source":"bangumi","sourceCharacterId":"195249"}],"profileFacts":[{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"28350","sourceWorkId":"39951","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"28350","sourceWorkId":"39951","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3abab6b87565fdc2970335e00a1fa5c16ade163ddd69f4b46c4d38d8b18369f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ee11fac1e15740269a7f77c21250998e560a10fc7789b0785f9b47da8982f2c.webp","width":237,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:616202:195249:6558:1","source":"bangumi"}]},{"characterId":"char_c165031","characterName":"アシュリー","sourceIds":{"bangumi":[{"characterId":"195250","match":"exact-normalized-name-in-linked-work","subjectId":"616202"}],"egsCharacterIds":["28351"],"vndbCharacterId":"c165031"},"originalCharacterName":"アシュリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"If bringing you back is what it takes, then I'll do anything at all... that, and nothing more."},{"spoiler":false,"text":"A girl the Empire wants caught, living her life in its shadows. She moves alone by choice, and there is no one better at the quiet work done out of sight. Cool, dry, every word coming out flat and lifeless, and perhaps that is exactly why no one can ever read what lies behind her eyes."},{"spoiler":false,"text":"Like Loretta, she means to throw in with Lucius and see the Empire fall... or so it would appear."},{"spoiler":false,"text":"She is the bearer of the rune of \"Control\": let a living body cross into her sight, and she can strengthen it, or bend it entirely to her will."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c165031"},{"segments":[{"spoiler":false,"text":"帝国に追われている、闇に生きる少女。"},{"spoiler":false,"text":"単独行動を好み、裏工作を得意としている。"},{"spoiler":false,"text":"クールかつドライな性格で、口調も無機質的。"},{"spoiler":false,"text":"そのためか何を考えているか掴みづらい。"},{"spoiler":false,"text":"ローレッタと同じく、帝国を滅ぼすためにルシウスに協力しようとするが……？"},{"spoiler":false,"text":"“制御”のルーンの所有者。"},{"spoiler":false,"text":"視界に入れた人間の肉体を強化したり操ることができる。"}],"source":"egs","sourceCharacterId":"28351","sourceWorkId":"39951","spoiler":false},{"segments":[{"spoiler":false,"text":"帝国に追われている、闇に生きる少女。"},{"spoiler":false,"text":"単独行動を好み、裏工作を得意としている。"},{"spoiler":false,"text":"クールかつドライな性格で、口調も無機質的。"},{"spoiler":false,"text":"そのためか何を考えているか掴みづらい。"},{"spoiler":false,"text":"ローレッタと同じく、帝国を滅ぼすためにルシウスに協力しようとするが……？"},{"spoiler":false,"text":"“制御”のルーンの所有者。"},{"spoiler":false,"text":"視界に入れた人間の肉体を強化したり操ることができる。"}],"source":"bangumi","sourceCharacterId":"195250"}],"profileFacts":[{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"28351","sourceWorkId":"39951","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"28351","sourceWorkId":"39951","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae1faa79b48a6f860001fe6137a7337f6037797df8efa56de9fe897faa1584f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a34b9821514d57490fdf77840006391c878b96b80a575e9ff6174cbe3593cb38.webp","width":237,"height":256,"source":"static-detail"},"actors":[{"creditedName":"乙倉由依","creatorId":"vndb:s26305","sourcePersonId":"vndb:s26305","canonicalEntityId":"vndb:s26305","name":"乙倉 由依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:616202:195250:48849:1","source":"bangumi"}]},{"characterId":"char_c165032","characterName":"ルシウス・ヴァールハイト","sourceIds":{"bangumi":[{"characterId":"209277","match":"exact-normalized-name-in-linked-work","subjectId":"616202"}],"egsCharacterIds":["28352"],"vndbCharacterId":"c165032"},"originalCharacterName":"ルシウス・ヴァールハイト","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"71"}},"descriptions":[{"segments":[{"spoiler":false,"text":"If you're so set on keeping that secret behind your teeth, then I'll simply have to ask your body instead."},{"spoiler":false,"text":"The mage who once called catastrophe down upon an entire kingdom — who came within a breath of unmaking the world itself — until a \"hero\" sealed him away. Legend has kept his name ever since, though only as one: the Mage of Ruin — the Warlock."},{"spoiler":false,"text":"He bends rune after rune to his will, his power matched only by the mind that wields it, and a charisma sharp enough to draw any eye. That insufferable arrogance of his is no mere posturing; it is the quiet certainty of a man whose strength has never once failed to back it up. A shameless womanizer, too, yet improbably the sort who looks after the people around him."},{"spoiler":false,"text":"The seal is broken now, but what stepped free is only a fraction of what was bound: most of his power and memories are gone. He hunts for every last shard of himself, seeking the day he reclaims it all and rises whole once more."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c165032"},{"segments":[{"spoiler":false,"text":"かつて国に災厄を招き、“英雄”に封印された魔導師。"},{"spoiler":false,"text":"伝承では“破滅の魔導師（ウォーロック）”と呼ばれている。"},{"spoiler":false,"text":"複数のルーンを操る力と頭脳を持ち、カリスマ性も高い。"},{"spoiler":false,"text":"尊大な態度は、実力に裏打ちされた自信からくるもの。"},{"spoiler":false,"text":"かなりの女好き。意外にも面倒見がいい。"},{"spoiler":false,"text":"封印から解放されたものの、力と記憶は大半が失われており、 全てを取り戻すことでの完全復活を望む。"}],"source":"egs","sourceCharacterId":"28352","sourceWorkId":"39951","spoiler":false},{"segments":[{"spoiler":false,"text":"かつて国に災厄を招き、“英雄”に封印された魔導師。"},{"spoiler":false,"text":"伝承では“破滅の魔導師（ウォーロック）”と呼ばれている。"},{"spoiler":false,"text":"複数の『ルーン』を操る力と頭脳を持ち、カリスマ性も高い。 尊大な態度は、実力に裏打ちされた自信からくるもの。"},{"spoiler":false,"text":"かなりの女好き。意外にも面倒見がいい。"},{"spoiler":false,"text":"封印から解放されたものの、力と記憶は大半が失われており、全てを取り戻すことでの完全復活を望む。"},{"spoiler":false,"text":"「あくまでも秘密を喋らないなら、お前の身体に聞くだけのことだ」"}],"source":"bangumi","sourceCharacterId":"209277"}],"profileFacts":[{"label":"身高（本版本）","value":"177 cm","valueContext":null,"source":"egs","sourceCharacterId":"28352","sourceWorkId":"39951","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e38442cb5095173f83dd32edf0d8ac5f4185ebf54f4652f9b59361cd552826ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/886c990dad66c67fb783b8176a7791784da003980a87761ccf9ccc83cea1ec73.webp","width":169,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c165033","characterName":"リリア＝レット・ノクスヘイム","sourceIds":{"vndbCharacterId":"c165033"},"originalCharacterName":"リリア＝レット・ノクスヘイム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lilia is the Second Imperial Princess of the Noxheim Empire. She is Irena's younger half-sister by a different mother."},{"spoiler":false,"text":"Gentle and mild-mannered, she is somewhat shy. She is not very athletic, but makes up for it by reading extensively and possessing exceptional knowledge."},{"spoiler":false,"text":"She admires Irena and always strives help her."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c165033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/964bb48e32f96a5aa7851e8d594f6c6b2612cab23b6fe255693c6acc43a5bcfc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af8904d0a7ba493f34df1e6cc58075227c2b958b16608f1d68ea1a7f3175dac2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花月 さや","creatorId":"vndb:s23345","sourcePersonId":"vndb:s23345","canonicalEntityId":"vndb:s23345","name":"花月 さや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101917","source":"vndb"}]},{"characterId":"char_vndb_c165034","characterName":"スカーレット＝ルナリ・ノクスヘイム","sourceIds":{"vndbCharacterId":"c165034"},"originalCharacterName":"スカーレット＝ルナリ・ノクスヘイム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Scarlet is the current Empress Consort of Noxheim and Irena's stepmother."},{"spoiler":false,"text":"To secure the throne for her own daughter, Lilia, she schemes to bring down Irena - a legitimate heir to the throne."},{"spoiler":false,"text":"She is a hardline aristocratic supremacist."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c165034"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b67bd90cca4f1f7ac54de1c994d8fab8eae580324dacefd3be89eba537fd92df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c83bae64b38891c7c27593e480fa0d071e616b165680b08a670be82d67c73d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"くどう 彩織","creatorId":"vndb:s18673","sourcePersonId":"vndb:s18673","canonicalEntityId":"vndb:s18673","name":"くどう 彩織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101916","source":"vndb"}]},{"characterId":"char_vndb_c165035","characterName":"オースティン・レッドウッド","sourceIds":{"vndbCharacterId":"c165035"},"originalCharacterName":"オースティン・レッドウッド","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Austin Redwood is a Marshal of the Imperial Army and Irena's uncle. With the Emperor struck down by illness, he seeks to uphold the Empire in his stead. He has long cared for Irena like a daughter, quietly working to support her."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c165035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0e6fcdb58c6a82fa94abb7c87985a85b1eec0b2aed6a872db021fb85fe33eab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charac