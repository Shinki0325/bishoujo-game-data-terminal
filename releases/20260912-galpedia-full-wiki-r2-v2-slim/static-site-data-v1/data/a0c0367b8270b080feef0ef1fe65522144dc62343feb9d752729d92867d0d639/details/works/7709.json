{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7709","model":{"presentationWorkId":"vndb:v1293","staff":{"artwork":[],"scenario":[{"creditedName":"叶 希一","creatorId":"vndb:s1815","sourcePersonId":"vndb:s1815","canonicalEntityId":"vndb:s1815","name":"叶 希一","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:22766","source":"vndb"},{"creditedName":"宮城 季詩子","creatorId":"vndb:s3431","sourcePersonId":"vndb:s3431","canonicalEntityId":"vndb:s3431","name":"宮城季詩子","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:22768","source":"vndb"},{"creditedName":"中野 麻衣","creatorId":"vndb:s10659","sourcePersonId":"vndb:s10659","canonicalEntityId":"vndb:s10659","name":"中野 麻衣","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:22769","source":"vndb"}],"music":[{"creditedName":"馬場信繁","creatorId":"vndb:s47876","sourcePersonId":"egs:creator:3588","canonicalEntityId":"vndb:s47876","name":"馬場信繁","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:67955","source":"egs"},{"creditedName":"志倉 千代丸","creatorId":"vndb:s441","sourcePersonId":"vndb:s441","canonicalEntityId":"vndb:s441","name":"志倉 千代丸","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:22764","source":"vndb"}],"other":[{"creditedName":"天野こずえ","creatorId":"egs:creator:4755","sourcePersonId":"egs:creator:4755","canonicalEntityId":"egs:creator:4755","name":"天野こずえ","detail":"原作","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:17919","source":"egs"},{"creditedName":"RMG(Rainbow-Motion-Graphics)","creatorId":"vndb:s2828","sourcePersonId":"egs:creator:12859","canonicalEntityId":"vndb:s2828","name":"RMG(Rainbow-Motion-Graphics)","detail":"OPムービー制作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68198","source":"egs"},{"creditedName":"KAORI.","creatorId":"vndb:s567","sourcePersonId":"vndb:s567","canonicalEntityId":"vndb:s567","name":"KAORI.","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:22765","source":"vndb"},{"creditedName":"RMG Rainbow-Motion-Graphics","creatorId":"vndb:s2828","sourcePersonId":"vndb:s2828","canonicalEntityId":"vndb:s2828","name":"RMG Rainbow-Motion-Graphics","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22767","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c71302","characterName":"水無 灯里","sourceIds":{"vndbCharacterId":"c71302"},"originalCharacterName":"水無 灯里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A native of Japan on Manhome (Earth) who immigrates to Aqua (Mars) when she is 15 to become an undine. While initially not as skillful at rowing a gondola as Alice nor as familiar with the history of her adopted city as Aika, Akari makes friends quickly and easily converse with customers and other strangers. She is depicted as optimistic and cheerful, finding enjoyment in things or events that others think humdrum and mundane."}],"source":"vndb","sourceCharacterId":"c71302"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd140404cdc117560c89321be82d4e518a7caec0466aff7b80efa574437b4c0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f453745103cf2e70419430245ffdede87c6739b0aaf6b0489c095c316fe7cd7.webp","width":107,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葉月 絵理乃","creatorId":"vndb:s15983","sourcePersonId":"vndb:s15983","canonicalEntityId":"vndb:s15983","name":"葉月 絵理乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11573","source":"vndb"}]},{"characterId":"char_vndb_c71303","characterName":"アリシア·フローレンス","sourceIds":{"vndbCharacterId":"c71303"},"originalCharacterName":"アリシア·フローレンス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only other undine in Aria Company, Alicia is one of the Three Water Fairies of Neo-Venezia, known by the title \"Snow White.\""},{"spoiler":false,"text":"At the start of the series, she is the most popular undine in the city, noted especially for her graceful rowing style. She was promoted to Prima at 15, the youngest ever to do so. Like Akari, she is relaxed and easy-going, but she also likes to tease others, especially her childhood friend Akira."},{"spoiler":false,"text":"Her favorite phrase is ara ara (\"Well Well\") and she frequently giggles, to Akira's annoyance. According to Grandma Akino, she is an excellent undine because of her ability to enjoy everything"}],"source":"vndb","sourceCharacterId":"c71303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49e0c8e2f785f8972abb78ac909f6f611de18b79b0cf1ae7dc88b032865fb1d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d47f270a515f9b23afeed7eb0395b2bb6a6adc89177e6d4852604d13292a1065.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大原 さやか","creatorId":"vndb:s100","sourcePersonId":"vndb:s100","canonicalEntityId":"vndb:s100","name":"大原 さやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11566","source":"vndb"}]},{"characterId":"char_vndb_c71304","characterName":"藍華·S·グランチェスタ","sourceIds":{"vndbCharacterId":"c71304"},"originalCharacterName":"藍華·S·グランチェスタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first friend Akari makes on Aqua, Aika is 16 when they meet. Aika is a Pair and then Single at Himeya Company. She is the only daughter and heir of Himeya Company's owners, but does not enjoy the distinction as she feels the company's employees fawned on her too much. Aika speaks bluntly and often responds to Akari's idealistic comments with \"Embarrassing remarks are not allowed!\" (恥ずかしいセリフ禁止! Hazukashii serifu kinshi!).26 Despite their contrasting personalities, she gets along well with Akari and Alice, but frequently squabbles with her mentor, Akira, whom she resembles. Aika considers herself reliable, especially compared to distractible Akari and antisocial Alice, but both her friends call her a crybaby for her tendency to tear up when emotional. She is proud of her gondola skill as an undine, and can be very competitive about it. She also greatly admires Alicia, and finds any excuse to visit Aria Company—and once tells Akari that if not for her family obligations, she would have joined Aria Company."}],"source":"vndb","sourceCharacterId":"c71304"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/252d7487df61e1ca74cb508726266f7d677942a97210d32cd6590b2bfb56b2d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ac2429e483c756dfde2b0cdc7c8ae3874a07edc12b2138ef755966d117d5119.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎藤 千和","creatorId":"vndb:s475","sourcePersonId":"vndb:s475","canonicalEntityId":"vndb:s475","name":"斎藤千和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11568","source":"vndb"}]},{"characterId":"char_vndb_c71305","characterName":"晃·E·フェラーリ","sourceIds":{"vndbCharacterId":"c71305"},"originalCharacterName":"晃·E·フェラーリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Neo-Venezia's Three Water Fairies, and a native of Aqua. As a Prima undine, Akira is called the \"Crimson Rose\" and is famed for her conversational skills. She has many admirers among her customers, especially the females, although she considers herself very feminine."}],"source":"vndb","sourceCharacterId":"c71305"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10f93704417ab9793a0b5b8b779f4eed5843839bb3085fe3724cbca6d3d680a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e76ee41a3a34e55e94030f2807c05dd4e9fbbd85e3327a04732cbd9048ef2c02.webp","width":103,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皆川 純子","creatorId":"vndb:s948","sourcePersonId":"vndb:s948","canonicalEntityId":"vndb:s948","name":"皆川純子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11570","source":"vndb"}]},{"characterId":"char_vndb_c71306","characterName":"アリス·キャロル","sourceIds":{"vndbCharacterId":"c71306"},"originalCharacterName":"アリス·キャロル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alice is a 14-year-old undine for Orange Planet. She first appears (in volume 3 of Aria/episode 3 of Aria the Animation) as a standoffish, detached girl. Aika later describes her as anti-social and complains about her tendency to put on a grim face and speak in a quiet voice."},{"spoiler":false,"text":"Alice speaks in a deadpan manner, though she frequently uses dekkai as an intensifier. Although initially only a Pair, her rowing already surpasses both Aika and Akari's—for which skill Orange Planet scouted her despite her young age. Despite working for rival companies, Alice, Akari, and Aika often practice together, and Alice sincerely enjoys the others' company. However, this does not stop her from telling them to be quiet when they argue."},{"spoiler":false,"text":"Because of her age and lower status, Aika often addresses her as \"kōhai-chan\" (\"junior\" said in a friendly manner). Through her friendship with Akari and Aika, Alice lightens up as the series progresses, though she still struggles with her detachment"}],"source":"vndb","sourceCharacterId":"c71306"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e9d338d5e1ff58bfb757584ef8503e1972c298518cf71c44d11a25b92f7e480.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f19d34df64dccb62ad17c3d90d34a830d964eff13d164cd250c1093207d45ad9.webp","width":99,"height":256,"source":"static-detail"},"actors":[{"creditedName":"広橋 涼","creatorId":"vndb:s467","sourcePersonId":"vndb:s467","canonicalEntityId":"vndb:s467","name":"広橋涼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11567","source":"vndb"}]},{"characterId":"char_vndb_c71307","characterName":"アテナ·グローリィ","sourceIds":{"vndbCharacterId":"c71307"},"originalCharacterName":"アテナ·グローリィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Neo-Venezia's Three Water Fairies, known by the title \"Siren\" for her beautiful singing voice. She is Alice's mentor at Orange Planet. She is quiet most of the time and often appears to be an airhead who does not pay attention to her surroundings (in the anime, she is shown more than once forgetting to duck while rowing under a bridge), but she genuinely cares about Alice. Athena has a strange laugh that comes out sounding as though she is angry."}],"source":"vndb","sourceCharacterId":"c71307"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a93e30f4026b70849011310cf7f833c706cf979dacc1156ddaaa82de97de45ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/993f33cc802515ed758caefd63e9c2b80b2ea8e0240b7bbd7717a145622eea63.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川上 とも子","creatorId":"vndb:s477","sourcePersonId":"vndb:s477","canonicalEntityId":"vndb:s477","name":"川上 とも子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11569","source":"vndb"}]},{"characterId":"char_vndb_c71308","characterName":"アリア・ポコテン","sourceIds":{"vndbCharacterId":"c71308"},"originalCharacterName":"アリア・ポコテン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"Aria company's cat."}],"source":"vndb","sourceCharacterId":"c71308"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e49f8e67a609c0df48313e97