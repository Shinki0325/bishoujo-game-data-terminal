{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1012"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c68009","characterName":"ナオミ","sourceIds":{"vndbCharacterId":"c68009"},"originalCharacterName":"ナオミ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"608"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'll pitch in too, just for you!\""},{"spoiler":false,"text":"A childhood friend from the same neighbourhood as you; she's just like a little sister. Incredible cheerful and energetic by nature, she's very liberal -- perhaps too liberal -- around you. But she still has the common sense to be polite to elders, or anyone she isn't close with."},{"spoiler":false,"text":"When she was small, she looked up to you as a big brother, but as she slowly grew older, she started to feel as though she had to do something for you. And so, that has become her goal in life. Kinda, sorta."},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c68009"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f42dceeef105194983199ed449cc399afffb19e9c7000ecb70194ba74b9949d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30aac08a046b261bf3b6dd05f6183ce98b4d3e2fdf654aad563ad75bd4730fd4.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"そよかぜ みらい","creatorId":"vndb:s12843","sourcePersonId":"vndb:s12843","canonicalEntityId":"vndb:s12843","name":"そよかぜみらい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72217","source":"vndb"}]},{"characterId":"char_vndb_c68010","characterName":"エリカ","sourceIds":{"vndbCharacterId":"c68010"},"originalCharacterName":"エリカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"birthday":{"reviewState":"source-only","source":"vndb","value":"411"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Let's make this a nice vacation.\""},{"spoiler":false,"text":"You and her were classmates back in your school days. Everyone had looked up to her, as someone out of their reach. But she wasn't the loner type - she was friendly and cordial with everyone, popular with both the guys and girls."},{"spoiler":false,"text":"Although she was a dream girl, you only ever looked up to her. Your other classmates felt the same; rather than a feeling of attraction, they all felt admiration for her instead, so although she was popular, no one had ever actually confessed to her."},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c68010"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d7f12ecc4ba64e6f03b7fa9d23b0addbe2e60cfbfbe8b50b52045cc3385a039.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3abfda7a03ee371dd9372c23f35c1ff98720635726fd0c45916ce2356e458b3a.webp","width":182,"height":243,"source":"static-detail"},"actors":[{"creditedName":"綾野 莉音","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72216","source":"vndb"}]},{"characterId":"char_vndb_c68011","characterName":"リサ","sourceIds":{"vndbCharacterId":"c68011"},"originalCharacterName":"リサ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1203"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"This is something we at the Royal Kai Hotel are famous for.\""},{"spoiler":false,"text":"The owner of the hotel you stay at, the Royal Kai. Wealthy and elegant, her very gait is a sight to behold. Her model-like proportions are one of her points of pride."},{"spoiler":false,"text":"From the way she dresses, speaks, and acts, one would think she has a terrible personality, but it's actually the opposite: she's a kind, understanding person, and a hard worker. However, there are people who end up disliking her even more because of that. Although she is often on Tropical Island, she's a natural-born Japanese."},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c68011"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7ba247611dc653536660a239eecdf73ab724be405149da933e2baa3fd0ea1a01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f95e3af3caaf1c36dc196eadc00573268bbb69972aca364867cec00c19af6658.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今 理名","creatorId":"vndb:s1540","sourcePersonId":"vndb:s1540","canonicalEntityId":"vndb:s1540","name":"村田 知沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72218","source":"vndb"}]},{"characterId":"char_vndb_c68012","characterName":"ケイ","sourceIds":{"vndbCharacterId":"c68012"},"originalCharacterName":"ケイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"801"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"99"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"97"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I jog around this area pretty often. If you spot me, feel free to say hi.\""},{"spoiler":false,"text":"An older girl who is frank, good-humoured, and possesses an inclination for athletics, she loves alcohol, and is a heavy drinker."},{"spoiler":false,"text":"Although she's pretty rough around the edges, she's got a feminine side too. She can be quite cutely naive as well. In her next life, she wants to be reborn as a small, cute girl so she can dress in frilly, lacy dresses - or so the thought crosses her mind quite often. Her peers all say she can absolutely pull it off even now, though."},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c68012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d79d0e1c73fe3e34c35a90b0429515331a59509e8563d2eea5911e402985eb44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12ad7830a4648d11832cd0c2dbdee66cc854a623f7ae1b0cfd7c1a1f0d9c3077.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘 まお","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72212","source":"vndb"}]},{"characterId":"char_vndb_c68013","characterName":"桜子","sourceIds":{"vndbCharacterId":"c68013"},"originalCharacterName":"桜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"330"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Pleased to make your acquaintance. Surely this must be an act of fate.\""},{"spoiler":false,"text":"Adorned in Japanese-style clothes, she is the embodiment of the perfect traditional Japanese girl. Her mannerisms are highly refined, with politeness bordering on obsessive. In a way, she's practically an endangered species."},{"spoiler":false,"text":"She takes things at her own pace, and is quite bad at English. Her airheadedness is quite something - she can be so detached that someone could be teasing her and she wouldn't even realize."},{"spoiler":false,"text":"Her favorite kanji character is \"sakura\" (桜). The reason is simple -- it's her name."},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c68013"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcc4b985eeab367f424af98ab45bb008a9353311428c0e128e16009e62ee87be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d0bdbc18ed82d5273ac4e91ac31b2c16e41838a229ecf91f7e5f387bce697f4.webp","width":179,"height":238,"source":"static-detail"},"actors":[{"creditedName":"夢野 ぼたん","creatorId":"vndb:s2571","sourcePersonId":"vndb:s2571","canonicalEntityId":"vndb:s2571","name":"田中 茉理花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72214","source":"vndb"}]},{"characterId":"char_vndb_c68014","characterName":"エマ","sourceIds":{"vndbCharacterId":"c68014"},"originalCharacterName":"エマ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"511"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"146"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Are you all right? Would you like big sister here to explain it for you?\""},{"spoiler":false,"text":"An \"adult\" older sister-type girl, a bit of the meddlesome type. (To put it simply, a loli with big boobs.)"},{"spoiler":false,"text":"Her height gets pointed out often, but she's very feminine and is very capable of taking care of other people, so she does feel like an \"adult\" older sister. She also has a more maidenly, romantic side to her, but is still that \"adult\" older sister."},{"spoiler":false,"text":"Be wary that she will get mad whenever you mention her height, or treat her like a kid. But the way she gets mad is also really cute, so sometimes you end up wanting to point it out just so see her expression."},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c68014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15d7fb20684e72d29240a542d3ef3d1e84759dd0b435c13091d4bd75f643e5d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e7f0be6e9241d6f13e2c06df3fc7a82815bac0f20f547d131cf3807b3f1de8a.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉 江美","creatorId":"vndb:s896","sourcePersonId":"vndb:s896","canonicalEntityId":"vndb:s896","name":"永井 真衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72211","source":"vndb"}]},{"characterId":"char_vndb_c68015","characterName":"カレン","sourceIds":{"vndbCharacterId":"c68015"},"originalCharacterName":"カレン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1010"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Really... I'm sorry...\""},{"spoiler":false,"text":"Quite frail and sickly, and on the negative side of the spectrum. Her constitution is weak since birth, and she has been repeatedly admitted to the hospital since she was a child. Because of that, though she is mentally strong, she has a tendency to apologise all the time; every time she speaks, it's to say sorry."},{"spoiler":false,"text":"She's the kind of girl you want to protect, or so says Naomi, but what drives that?"},{"spoiler":false,"text":"Is it a fatherly instinct? Or perhaps -- love?"},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c68015"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa5361db0710d31afb01bbc1228e84b9c9ad595c670c0ae415fa4c1a43e56471.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91a99bcc26081a22d289d4d9d537a7a88318a9b3770996542425896660da810d.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まのめ るか","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72215","source":"vndb"}]},{"characterId":"char_vndb_c68016","characterName":"アンナ","sourceIds":{"vndbCharacterId":"c68016"},"originalCharacterName":"アンナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"724"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"99"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I-It's not like I waited just for you or anything!\""},{"spoiler":false,"text":"An older girl who works as a tour guide. Naturally, she's quite familiar with Tropical Island."},{"spoiler":false,"text":"While people often see her as the beautiful yet cool, collected girl, she actually has quite the sharp tongue. She just can't be honest with herself, so she inadvertedly ends up hurting people with her language. After saying something mean, she tends to get depressed and regretting it later by herself - she's really a good person deep down."},{"spoiler":false,"text":"She is, at least, working on fixing that part of her. Supposedly. But there haven't been any signs of improvement."},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c68016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/809784df5e7e07849d1158650a3daa95e49a1bc91701c131b17505f7f89f1a8e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/te