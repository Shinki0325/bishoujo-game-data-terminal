","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:17573","source":"vndb"},{"creditedName":"茶飲","creatorId":"vndb:s7283","sourcePersonId":"vndb:s7283","canonicalEntityId":"vndb:s7283","name":"茶飲 一服","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:17574","source":"vndb"}]},"cast":[{"characterId":"char_c3984","characterName":"八坂 あろえ","sourceIds":{"bangumi":[{"characterId":"31211","match":"exact-normalized-name-in-linked-work","subjectId":"2722"}],"egsCharacterIds":["23967"],"vndbCharacterId":"c3984"},"originalCharacterName":"八坂 あろえ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl who has been left alone in a city that collapsed. She has trouble communicating with others due to having autism."},{"spoiler":false,"text":"While she is quiet, there will be situations where she will show sudden and unpredictable behavior, and bother people by repeating difficult to understand words. On the other hand, she has a few mysterious abilities that normal people don't have."}],"source":"vndb","sourceCharacterId":"c3984"},{"segments":[{"spoiler":false,"text":"崩壊してしまった街に、一人取り残されてしまった少女。"},{"spoiler":false,"text":"自閉症スペクトラム障害を持っている。"},{"spoiler":false,"text":"大人しい性格をしているが、状況に関係なく、突発的で予測不能の行動や、理解の難しい発言を繰り返し、その場の人間を困らせることも少なくない。"},{"spoiler":false,"text":"そのかわり、人にはない不思議な能力を持っている。"}],"source":"egs","sourceCharacterId":"23967","sourceWorkId":"5924","spoiler":false},{"segments":[{"spoiler":false,"text":"崩坏的街道中独自一人活下来的少女。"},{"spoiler":false,"text":"高机能自闭症患者，无法与他人交流沟通。"},{"spoiler":false,"text":"性格安静老实，但会在与环境无关的情况下，做出令人无法预测的突发行动，"},{"spoiler":false,"text":"或是不停说出难以理解的话，经常让大家困惑不已。"},{"spoiler":false,"text":"不过相对地，拥有某种常人不具备的特殊能力。"}],"source":"bangumi","sourceCharacterId":"31211"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50aa8752273efc119f2458a244bbf414945910ee9d5181b0d3b097631094ff71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a311c83c9827eaed060f6f9090dba67658e76826123eded09c99980641b58176.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2722:31211:4463:1","source":"bangumi"}]},{"characterId":"char_c3985","characterName":"尼子 司","sourceIds":{"bangumi":[{"characterId":"31725","match":"exact-normalized-name-in-linked-work","subjectId":"2722"}],"egsCharacterIds":["23965"],"vndbCharacterId":"c3985"},"originalCharacterName":"尼子 司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. A university student living by himself. However, he seems to be putting more effort in practicing piano."},{"spoiler":false,"text":"He can be a hard person to read due to a lack of facial expressions or emotions."}],"source":"vndb","sourceCharacterId":"c3985"},{"segments":[{"spoiler":false,"text":"大学生だが、本業よりも、ピアノの練習に力を入れている。"},{"spoiler":false,"text":"あまり感情的なことを言ったり、表情に出したりしないため、掴みづらい人間だと思われているが、本人はそのことをあまり理解していない。"}],"source":"egs","sourceCharacterId":"23965","sourceWorkId":"5924","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。一个人在住宅区居住的大学生。"},{"spoiler":false,"text":"比起学生本职，更注重于钢琴的练习。"},{"spoiler":false,"text":"由于不怎么吐露心声或表露感情，"},{"spoiler":false,"text":"在别人眼中显得有些神秘。"}],"source":"bangumi","sourceCharacterId":"31725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82621d89ad9cad529ab6ac62396fc34988794041c1cf38bfd80e08cb6a8c05dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7f1df76e23179d03ae479c6a2b8423edca2aa698e4abd5a867621c041942300.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"広末涼","creatorId":"vndb:s1254","sourcePersonId":"vndb:s1254","canonicalEntityId":"vndb:s1254","name":"広末 涼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2722:31725:49377:2","source":"bangumi"},{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2722:31725:5669:1","source":"bangumi"}]},{"characterId":"char_c3986","characterName":"田能村 慎","sourceIds":{"bangumi":[{"characterId":"31726","match":"exact-normalized-name-in-linked-work","subjectId":"2722"}],"egsCharacterIds":["23971"],"vndbCharacterId":"c3986"},"originalCharacterName":"田能村 慎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フリーターの青年。"},{"spoiler":false,"text":"地元の住民で、生まれたときからずっとここで暮らしている。"},{"spoiler":false,"text":"朗らかな性格で、スポーツマンタイプ。"},{"spoiler":false,"text":"自然とリーダー的な立場に立たされることが多い。"}],"source":"egs","sourceCharacterId":"23971","sourceWorkId":"5924","spoiler":false},{"segments":[{"spoiler":false,"text":"ケーキ屋でアルバイトをしているフリーター。生まれた時から物語の舞台である街で暮らしてきた、生粋の地元っ子。実家は剣道場を開いており、剣道にはそれなり以上の嗜みを持つ。彼も地震で家族と家を喪い、朽ちかけた教会でひとり佇んでいるところに司たちと出会う。"},{"spoiler":false,"text":"容姿は今時の青年風だが、穏やかかつ芯の通った物腰の持ち主。言い争いはせず、陰口も叩かず、仲間をそれとなくフォローしながら何に対してもポジティヴかつ粘り強く臨むその姿勢には信望が集まり、新たな避難先となった学校内においてもリーダー的な立場に選ばれる。"}],"source":"bangumi","sourceCharacterId":"31726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf4ffcbb6305fe7fdff51385b8801c1a38411ed49bf925454be7ba30e289b71f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5efb98d759a5effd2fab7a42c1e3705ef7970d772ec2d35e4519adc9ed2b087.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎淳","creatorId":"vndb:s32","sourcePersonId":"vndb:s32","canonicalEntityId":"vndb:s32","name":"尾崎準(尾崎淳、滝沢アツヤ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2722:31726:6382:1","source":"bangumi"}]},{"characterId":"char_c3989","characterName":"鍬形 拓馬","sourceIds":{"bangumi":[{"characterId":"31727","match":"exact-normalized-name-in-linked-work","subjectId":"2722"}],"egsCharacterIds":["23972"],"vndbCharacterId":"c3989"},"originalCharacterName":"鍬形 拓馬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"柚香達と同じ学校に通う大学生。"},{"spoiler":false,"text":"趣味はパソコン。女性に対するコンプレックスが強く、それ以外にも自信が持てない臆病な性格。"},{"spoiler":false,"text":"こっそり柚香に好意を抱いている。"}],"source":"egs","sourceCharacterId":"23972","sourceWorkId":"5924","spoiler":false},{"segments":[{"spoiler":false,"text":"柚香や雲雀と同じ大学に通う学生。一人暮らしをしていたアパートが倒壊し、同じように部屋を失った柚香や雲雀と共に避難先を求めて教会へと辿り着く。近所に住む柚香とは挨拶を交わす程度の仲だが、彼女に対しての好意を表に出せずに一人悶々としている。自分の容姿に対するコンプレックスのためか、全体的に卑屈で臆病な性格。その点が気に食わない雲雀によくドツかれている。災害によって剥き出しになった街や人の変貌に感情を激しく揺さぶられ続け、その内面を大きく変化させていく。本作品上でもっとも非情な一面を出す。"},{"spoiler":false,"text":"趣味はパソコンとインターネットでメカニックに強いインドア派だが、脱出のための筏を組み上げるアウトドアのスキルも併せ持つ。"}],"source":"bangumi","sourceCharacterId":"31727"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bf2ca75fdd5f0e73926a37249402636c7d2a0d87843afd5751a3f57481d4b72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f46ce16043531933c94f9d7cde4482c0461a02a4dfa2bf379e9844fde73b7ca3.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜坂幸平","creatorId":"vndb:s1255","sourcePersonId":"vndb:s1255","canonicalEntityId":"vndb:s1255","name":"桜坂 幸平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2722:31727:64301:1","source":"bangumi"}]},{"characterId":"char_c3991","characterName":"佐々木 柚香","sourceIds":{"bangumi":[{"characterId":"31728","match":"exact-normalized-name-in-linked-work","subjectId":"2722"}],"egsCharacterIds":["23966"],"vndbCharacterId":"c3991"},"originalCharacterName":"佐々木 柚香","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A university student who lives alone. She has excellent looks and figure but she herself doesn't seem to be aware of them."},{"spoiler":false,"text":"Even with the destroyed city, she continues to endure and smile gently. She doesn't mind the labor of making good food to warm up everyone's morale. She's always worried about her close friend, Hibari."}],"source":"vndb","sourceCharacterId":"c3991"},{"segments":[{"spoiler":false,"text":"一人暮らしをする大学生。"},{"spoiler":false,"text":"優れた美貌とスタイルを兼ね備えているが、本人には自覚がないようだ。"},{"spoiler":false,"text":"変わり果てた街のなかでも強く耐え、いつでも優しく微笑んでいる。"},{"spoiler":false,"text":"労働をいとわず、得意の料理をつくっては、皆の気持ちを暖かくさせる。"},{"spoiler":false,"text":"地震の月の公共料金の支払いはどうなるのかが気がかりらしい。"}],"source":"egs","sourceCharacterId":"23966","sourceWorkId":"5924","spoiler":false},{"segments":[{"spoiler":false,"text":"过着单身生活的大学生。"},{"spoiler":false,"text":"拥有漂亮的外表和拔群的身材，不过本人似乎并不在意。"},{"spoiler":false,"text":"即便身处灾后的街中仍能强忍悲伤，常常温柔地微笑着。"},{"spoiler":false,"text":"不怕劳累，为大家制作拿手的料理，让众人气馁的心情好转起来。"},{"spoiler":false,"text":"总是关心着好友川瀬雲雀。"}],"source":"bangumi","sourceCharacterId":"31728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fad35b119cfe754ec1ecf37a1bc3c34bc4e592bed4b688e988a88b4541b01b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/518ddb35119ea14d9d64bd16364cfc538492ab433e119cf398beeb7b67ce4d11.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"たかはし智秋","creatorId":"vndb:s287","sourcePersonId":"vndb:s287","canonicalEntityId":"vndb:s287","name":"たかはし 智秋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2722:31728:4604:1","source":"bangumi"}]},{"characterId":"char_c3992","characterName":"川瀬 雲雀","sourceIds":{"bangumi":[{"characterId":"31729","match":"exact-normalized-name-in-linked-work","subjectId":"2722"}],"egsCharacterIds":["23968"],"vndbCharacterId":"c3992"},"originalCharacterName":"川瀬 雲雀","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuka's friend who goes to the same university as her. On the night of the earthquake, she was spending time with Yuka and they survived."},{"spoiler":false,"text":"She has a strong will and is not afraid to speak her mind. However, because she is very honest, she shows her selfish side a lot. That said, her energy is considered valuable in the situation they're in."}],"source":"vndb","sourceCharacterId":"c3992"},{"segments":[{"spoiler":false,"text":"柚香の友人で、同じ大学に通っている。"},{"spoiler":false,"text":"地震の夜は柚香と一緒に過ごし、生き残った。"},{"spoiler":false,"text":"気が強く、思ったことはいつでもはっきりと口にする。"},{"spoiler":false,"text":"ただ、結果として気分でものを言ってしまうため、わがままも多い。"},{"spoiler":false,"text":"廃墟となってしまった街で、飼い主を喪ったペットのことをよく考えているようだ。"}],"source":"egs","sourceCharacterId":"23968","sourceWorkId":"5924","spoiler":false},{"segments":[{"spoiler":false,"text":"柚香的好友，两人就读于同一所大学。"},{"spoiler":false,"text":"地震之夜与柚香一起度过，两人一同生还。"},{"spoiler":false,"text":"性格强气，想到什么就说什么。"},{"spoiler":false,"text":"只是有时候太过口无遮拦，最后变成任性较劲，不过她的振作在这种情况下也是极其贵重的。"}],"source":"bangumi","sourceCharacterId":"31729"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b57770ff6961ae547c48287ad2267a06eda0aa2ca61b76c50780aa028d85d425.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61b9862db6112d318e055ea25fc4eda9162c1b2b7f47af5d62a602e13af7cda7.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2722:31729:6409:1","source":"bangumi"}]},{"characterId":"char_c3995","characterName":"乃木 妙子","sourceIds":{"bangumi":[{"characterId":"31730","match":"exact-normalized-name-in-linked-work","subjectId":"2722"}],"egsCharacterIds":["23969"],"vndbCharacterId":"c3995"},"originalCharacterName":"乃木 妙子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"地震後の廃墟で、司たちと出会う少女。"},{"spoiler":false,"text":"詳細は不明。"}],"source":"egs","sourceCharacterId":"23969","sourceWorkId":"5924","spoiler":false},{"segments":[{"spoiler":false,"text":"街をうろつく男共に絡まれていた所を、街の調査に出掛けた司たちが助けた女性。飾り気こそないが、端正な美貌と静謐な雰囲気を持つ。"},{"spoiler":false,"text":"実は新興宗教「大智の会（だいちのかい）」の首魁であり、予知能力を持つ「竜華樹（りゅうげじゅ）」として奉られている。幼い頃から「竜華樹」として育てられ、その教育から来る