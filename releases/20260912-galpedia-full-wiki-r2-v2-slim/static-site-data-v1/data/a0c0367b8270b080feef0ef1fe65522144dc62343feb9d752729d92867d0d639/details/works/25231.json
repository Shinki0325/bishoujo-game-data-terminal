d":"vndb:s13804","name":"らいれす","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129075","source":"vndb"},{"creditedName":"一色 緑","creatorId":"vndb:s19521","sourcePersonId":"vndb:s19521","canonicalEntityId":"vndb:s19521","name":"一色緑","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129077","source":"vndb"},{"creditedName":"うさこ","creatorId":"vndb:s19605","sourcePersonId":"vndb:s19605","canonicalEntityId":"vndb:s19605","name":"うさこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129078","source":"vndb"},{"creditedName":"株式会社エスプリズム","creatorId":"vndb:s24622","sourcePersonId":"vndb:s24622","canonicalEntityId":"vndb:s24622","name":"S-Prism","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129079","source":"vndb"},{"creditedName":"Ian Willett-Jacob","creatorId":"vndb:s28348","sourcePersonId":"vndb:s28348","canonicalEntityId":"vndb:s28348","name":"Ian Willett-Jacob","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129080","source":"vndb"}]},"cast":[{"characterId":"char_c567","characterName":"風見 雄二","sourceIds":{"bangumi":[{"characterId":"10974","match":"exact-normalized-name-in-linked-work","subjectId":"10869"},{"characterId":"10974","match":"exact-normalized-name-in-linked-work","subjectId":"366021"}],"egsCharacterIds":["11377"],"vndbCharacterId":"c567"},"originalCharacterName":"風見 雄二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the first Grisaia series. Ace number 9029, Yuuji is the \"janitor\" for the underworld. Tired of his life, he wanted to live a normal school life. Cool, philosophical, and minimalist, Yuuji is a realist (but also a tsundere). Being very cautious, he always plans and scouts before action. Other than his occasional orthodontic military methods, he’s just a fit young man. He disguised himself as \"exchange student from Canada\"."},{"spoiler":false,"text":"Edited from Warum's review"}],"source":"vndb","sourceCharacterId":"c567"},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"雑然とした社会から切り取られたような平和な学園に、ある日突然やってきた転入生。"},{"spoiler":false,"text":"幼い頃に事故で姉を亡くし、両親と死別して以降の詳細は経歴は不明だったが、現在はドイツ人の養親に引き取られている。"},{"spoiler":false,"text":"美浜学園の学園長とは旧知の間柄であり、その縁を介することで、書類上は海外からの招待留学生として6人目の学生となった。"},{"spoiler":false,"text":"口数が少なく、非常に落ち着いた性格をしているが、浮世離れした言動や行動が目立ち、いかにも“ワケあり”な部分を感じさせる謎の男。"},{"spoiler":false,"text":"それでいて物事に対しては非常に真摯であり、時には真面目が過ぎるような一面も見せ、養親と同じ職場でアルバイトに励みながら日々を真剣に生きている。"}],"source":"egs","sourceCharacterId":"11377","sourceWorkId":"14237","spoiler":false},{"segments":[{"spoiler":false,"text":"某日突然来到远离红尘俗世的和平学园的转校生。"},{"spoiler":false,"text":"在小时候的事故中失去了姐姐，和双亲死别之后的详细经历不明，现在被德国人的养母收养着。"},{"spoiler":false,"text":"和美浜学园的学园长是老朋友，通过这层关系，以来自海外的招待留学生的名义成为了第6个学生。"},{"spoiler":false,"text":"沉默寡言，性格非常稳重，不通世俗的言行很显眼，给人有“黑历史”感觉的谜之男人。"},{"spoiler":false,"text":"然而做事情又非常认真，有时还会认真过头，在和养母相同的职场做着兼职，一丝不苟地活在每一天。"}],"source":"bangumi","sourceCharacterId":"10974"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/767681e6091ec28551fa7eab55875a560264c77803dfdb96d721eb16ae0c80e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3a1955168c719e49761c10478377d5197d096e623ed39bedd0fdf3492047d2b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c579","characterName":"ジュリア・バルデラ","sourceIds":{"bangumi":[{"characterId":"10976","match":"exact-normalized-name-in-linked-work","subjectId":"10869"},{"characterId":"10976","match":"exact-normalized-name-in-linked-work","subjectId":"24275"},{"characterId":"10976","match":"exact-normalized-name-in-linked-work","subjectId":"366021"},{"characterId":"10976","match":"exact-normalized-name-in-linked-work","subjectId":"46868"}],"egsCharacterIds":["314"],"vndbCharacterId":"c579"},"originalCharacterName":"ジュリア・バルデラ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"402"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuji's guardian and work boss. Her former name is Julia Bardera but she changed it after moving to Japan, that’s why Yuuji calls her JB. Though she looks American, she is half-German and half-Italian. She also drives a yellow Ferrari."},{"spoiler":false,"text":"From Shiori-chan's review"}],"source":"vndb","sourceCharacterId":"c579"},{"segments":[{"spoiler":false,"text":"旧名は Julia・Bardera（ジュリア・バルデラ） であり、親しい者からは “JB” という愛称で呼ばれている。"},{"spoiler":false,"text":"風見雄二の現養親であり、アルバイト先の上司（保護管理官） を務めている。"},{"spoiler":false,"text":"アメリカの古いポルノ映画に出てくるテニスウェアでファックされる頭の悪いお姉さんのような容姿をしているが、ドイツ人とイタリア人のハーフである。"},{"spoiler":false,"text":"生真面目で職人気質なドイツ人の父、陽気で皮肉屋なイタリア人の母の間に生まれ、父親の性格と母親の容姿を受け継いでいる。"},{"spoiler":false,"text":"仕事の都合上アメリカ国籍から日本に帰化してはいるが、多国語に精通しており日本語も極めて流暢であるが故に国籍不明の感が否めず、謎の人物と目されることが多い。"},{"spoiler":false,"text":"男好きしそうな派手な容姿に係わらず、性格は至って真面目で自分の仕事はキッチリこなす優等生タイプだが、愚直なまでに生真面目なその性格を便利に使われ、貧乏くじを引くケースも散見される。"}],"source":"egs","sourceCharacterId":"314","sourceWorkId":"14237","spoiler":false},{"segments":[{"spoiler":false,"text":"旧名はＪｕｌｉａ・Ｂａｒｄｅｒａ（ジュリア・バルデラ）であり、親しい者からは“ＪＢ”という愛称で呼ばれている。"},{"spoiler":false,"text":"風見雄二の現養親であり、アルバイト先の上司（保護管理官）を務めている。"},{"spoiler":false,"text":"生真面目で職人気質なドイツ人の父、陽気で皮肉屋なイタリア人の母の間に生まれ、父親の性格と母親の容姿を受け継いでいる。"},{"spoiler":false,"text":"仕事の都合上アメリカ国籍から日本に帰化してはいるが、多国語に精通しており日本語も極めて流暢であるが故に国籍不明の感が否めず、謎の人物と目されることが多い。"},{"spoiler":false,"text":"男好きしそうな派手な容姿に係わらず、性格は至って真面目で自分の仕事はキッチリこなす優等生タイプだが、愚直なまでに生真面目なその性格を便利に使われ、貧乏くじを引くケースも散見される。"},{"spoiler":false,"text":"風見雄二の師匠である日下部麻子とは元同僚であり、十数年の付き合いがあった。"},{"spoiler":false,"text":"そして麻子の死後、風見雄二を引き取ることとなる。"}],"source":"egs","sourceCharacterId":"314","sourceWorkId":"15915","spoiler":false},{"segments":[{"spoiler":false,"text":"旧名はJulia・Bardera（ジュリア・バルデラ）であり、親しい者からは“JB”という愛称で呼ばれている。"},{"spoiler":false,"text":"風見雄二の現養親であり、アルバイト先の上司（保護管理官）を務めている。"},{"spoiler":false,"text":"アメリカの古いポルノ映画に出てくるテニスウェアでファックされる頭の悪いお姉さんのような容姿をしているが、ドイツ人とイタリア人のハーフである。"},{"spoiler":false,"text":"生真面目で職人気質なドイツ人の父、陽気で皮肉屋なイタリア人の母の間に生まれ、父親の性格と母親の容姿を受け継いでいる。"},{"spoiler":false,"text":"仕事の都合上アメリカ国籍から日本に帰化してはいるが、多国語に精通しており日本語も極めて流暢であるが故に国籍不明の感が否めず、謎の人物と目されることが多い。"},{"spoiler":false,"text":"男好きしそうな派手な容姿に係わらず、性格は至って真面目で自分の仕事はキッチリこなす優等生タイプだが、愚直なまでに生真面目なその性格を便利に使われ、貧乏くじを引くケースも散見される。"},{"spoiler":false,"text":"風見雄二の師匠である日下部麻子とは元同僚であり、十数年の付き合いがあった。"}],"source":"egs","sourceCharacterId":"314","sourceWorkId":"15916","spoiler":false},{"segments":[{"spoiler":false,"text":"一姫が所属するアイドル事務所の社長。"},{"spoiler":false,"text":"躄蟹プロダクション社長の蒔菜とは、しばしば衝突することもあり、基本的には仲が悪い。"}],"source":"egs","sourceCharacterId":"314","sourceWorkId":"20490","spoiler":false},{"segments":[{"spoiler":false,"text":"风见雄二的监护人兼在“会社”的上司"},{"spoiler":false,"text":"虽然长着一副美国的色情老片中会出现的穿着网球服被Fuck的脑残御姐一般的容貌，但其实是德国人与意大利人的混血儿。"},{"spoiler":false,"text":"父亲是一本正经具有职人气质的德国人，母亲是性格开朗喜欢冷嘲热讽的意大利人，她遗传了父亲的性格与母亲的容貌。"},{"spoiler":false,"text":"出于工作关系从美国籍转投日本籍，但因为精通多国语言，日语也极其流畅的缘故，给人国籍不明的感觉，常常被视为充满谜团的人物。"},{"spoiler":false,"text":"尽管长着一副看上去极其放荡的艳丽容貌，性格却极为正经，是一板一眼地完成本职工作的优等生类型，但她过分正直的性格常被便利地利用，走霉运的事例也处处可见。"}],"source":"bangumi","sourceCharacterId":"10976"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/653527d6a4c4ca6e1fbc3ce707cca938f25063b626489b36156760f3c175a2a4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae1c0a742022c0ea8c305c040fa06dbfa3f42db39d8e378086ef439e6a3778ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:169767:10976:4489:1","source":"bangumi"}]},{"characterId":"char_vndb_c44707","characterName":"マリオン・ガーランド","sourceIds":{"vndbCharacterId":"c44707"},"originalCharacterName":"マリオン・ガーランド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"9"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The target of Yuuji's escort mission. Daughter of Colombian accountant, Timothy Garland."}],"source":"vndb","sourceCharacterId":"c44707"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41e0bff6473e7a1055a1c74dfe00bd1626ac2aa5ceb7299578ef18303ebfdeb3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1ba140038cdb33a361b7f1d5445400109305ab2e9ccd1ed36ab2e9d2f7c575bb.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五十嵐 