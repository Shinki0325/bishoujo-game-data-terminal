994","source":"vndb"},{"creditedName":"めいと","creatorId":"vndb:s12616","sourcePersonId":"vndb:s12616","canonicalEntityId":"vndb:s12616","name":"迷人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:188995","source":"vndb"},{"creditedName":"跡部 泰広","creatorId":"vndb:s14185","sourcePersonId":"vndb:s14185","canonicalEntityId":"vndb:s14185","name":"跡部 泰広","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:188996","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c128205","characterName":"四ノ宮 銀花","sourceIds":{"vndbCharacterId":"c128205"},"originalCharacterName":"四ノ宮 銀花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Welcome back, Ryuusei.\""},{"spoiler":false,"text":"A mysterious girl who Ryuusei meets when he comes back to the island. She looks exactly the same as Shinomiya Ginka who was spirited away five years ago—she has not even aged since then. Despite forgotten her own name, she remembers that she loves Ryuusei. Shy and innocent, Ginka wishes to marry him with all her heart."},{"spoiler":false,"text":"Edited from the official website"}],"source":"vndb","sourceCharacterId":"c128205"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f424d593779c6335b9ca04f9a0170806ac1fa46a6845918f71d5fdf00559742.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c3f8eff42dca8df3727c50ccdb2a45b61d5f9e47cab07292d8338a9a6a2a696.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川 育美","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92791","source":"vndb"}]},{"characterId":"char_vndb_c128206","characterName":"青羽 流星","sourceIds":{"vndbCharacterId":"c128206"},"originalCharacterName":"青羽 流星","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"But then I met you, Ginka, and I realized that I could keep on living because of you.\""},{"spoiler":false,"text":"The protagonist, a normal boy who used to live on Himejima."},{"spoiler":false,"text":"Although he jokes around often, he is prone to falling into dark and gloomy thoughts. As a newcomer to the island, he had trouble fitting in at school, but his friendship with Ginka changed his life for the better. He moved back to the mainland after Ginka was spirited away. When he is reunited with Ginka upon a visit to Himejima, he can finally have the summer vacation that he always wanted."},{"spoiler":false,"text":"Edited from the official website"}],"source":"vndb","sourceCharacterId":"c128206"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f211e7edb7994914648eaf3870dcd9706fe695f6264c9d517e6854ac7a320db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/941dbce9fda5bae71f22b053d3ad3e4d3461d05a7bd60b380f4c9eb5a99b62e4.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c131016","characterName":"謎の少女","sourceIds":{"vndbCharacterId":"c131016"},"originalCharacterName":"謎の少女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I came here to look for God.\""},{"spoiler":false,"text":"A mysterious girl that shows up on the island one day."},{"spoiler":false,"text":"She wears an unfamiliar school uniform and dons a sword at her hip."},{"spoiler":false,"text":"Her hair is silver and she acts prim and proper—almost like a high school aged Ginka."},{"spoiler":false,"text":"Taken from Official English page"}],"source":"vndb","sourceCharacterId":"c131016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b50b175844d9185afb0a87b187653637a1e1c71b8f63558e55ff00bcf010995.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7e8f799c9e13a5fd19ca91cfd18243db691196079ffa1f17c5201aed51e113a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c131017","characterName":"海野 ひまわり","sourceIds":{"vndbCharacterId":"c131017"},"originalCharacterName":"海野 ひまわり","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm sure the festival will be a blast now that Ryuu-nii is back!.\""},{"spoiler":false,"text":"The daughter of a local fisherman, she was born and raised on the island."},{"spoiler":false,"text":"It's her dream to move the city and become a famous influencer."},{"spoiler":false,"text":"She's bright, happy, and able to raise the spirits of everyone around her."},{"spoiler":false,"text":"She played with Ryuusei often when they were little, and she calls him \"Ryuu-nii.\""},{"spoiler":false,"text":"Edited from Official English page"}],"source":"vndb","sourceCharacterId":"c131017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de53ca49cbda60cee9b1cee77afb020f662b3bd595ab9da31bf30598004cb29e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d3a242ac0997cb88a855dad5db20b470651fb41709d67f87bbdec44f16b3f6e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長縄 まりあ","creatorId":"vndb:s2653","sourcePersonId":"vndb:s2653","canonicalEntityId":"vndb:s2653","name":"長縄 まりあ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92787","source":"vndb"}]},{"characterId":"char_vndb_c131018","characterName":"涼代 リン","sourceIds":{"vndbCharacterId":"c131018"},"originalCharacterName":"涼代 リン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm really happy you two are back."},{"spoiler":false,"text":"Welcome home, Princess, Ryuusei.\""},{"spoiler":false,"text":"The ringleader of the kids on the island, she is two years older than Ryuusei."},{"spoiler":false,"text":"A good-looking, kind, and caring girl, she was the first to befriend Ryuusei and invite him into her circle of friends when he moved to Himeshima."},{"spoiler":false,"text":"Throughout elementary school,she went undefeated in the local martial arts tournament."},{"spoiler":false,"text":"Perhaps she got her strength and athleticism from her father, who is a farmer."},{"spoiler":false,"text":"Edited from Official English page"}],"source":"vndb","sourceCharacterId":"c131018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bcbfd4ab373d6626784bd950cad2a8690a4b174d128ca895eac6c4d691de292.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c282465dc37be66d80dabfef4e9154ab2dae9367b0a8804cec4551cf548d51a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 彩沙","creatorId":"vndb:s17835","sourcePersonId":"vndb:s17835","canonicalEntityId":"vndb:s17835","name":"伊藤 彩沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92792","source":"vndb"}]},{"characterId":"char_vndb_c131019","characterName":"荒羅伎 なずな","sourceIds":{"vndbCharacterId":"c131019"},"originalCharacterName":"荒羅伎 なずな","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm glad you came back."},{"spoiler":false,"text":"I hope you'll enjoy your summer vacation here.\""},{"spoiler":false,"text":"Ryuusei's old homeroom teacher at Himeshima's elementary school."},{"spoiler":false,"text":"She takes Ryuusei in her care when he comes back to the island and is one of the few grown-ups he can rely on."},{"spoiler":false,"text":"In the classroom, she's diligent and calm. However, she's also a martial arts master, and she teaches the children self-defense during PE."},{"spoiler":false,"text":"All of her former pupils still respect her greatly."},{"spoiler":false,"text":"Edited from Official English page"}],"source":"vndb","sourceCharacterId":"c131019"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2112af3a6f231b6758fc7d29bb6fb071fac7cbe748297d6b163f47300790f73f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a8d95cde90361d6b99045b4e1ae090af3798cb0637913951e3b34f8bae19eae.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安済 知佳","creatorId":"vndb:s8117","sourcePersonId":"vndb:s8117","canonicalEntityId":"vndb:s8117","name":"安済 知佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92788","source":"vndb"}]},{"characterId":"char_vndb_c131020","characterName":"七守 草二","sourceIds":{"vndbCharacterId":"c131020"},"originalCharacterName":"七守 草二","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"We are the Summer Festival Executive Commitee — a secret society working day and night to revive the summer festival.\""},{"spoiler":false,"text":"Ryuusei's classmate."},{"spoiler":false,"text":"Souji has always seen Ryuusei as a rival, because they're the same age."},{"spoiler":false,"text":"A stickler for the rules, he values being just and fair above all else."},{"spoiler":false,"text":"Although he's always at odds with Ryuusei, he'll still give him praise when it's due."},{"spoiler":false,"text":"Coming from a lineage of politicians, he wishes to do everything in his power to contribute to the local community."},{"spoiler":false,"text":"The island's declining population is one of his major worries."},{"spoiler":false,"text":"Edited from Official English page"}],"source":"vndb","sourceCharacterId":"c131020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31fab7950fa058b9ccdd43417f1636a72b9a3ac2fb1092fece251e323d77ba1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92cf66c82c13a1c9c041fc27ba23da83fb70f07098957e8f012d4bbf442bfa79.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森嶋 秀太","creatorId":"vndb:s8382","sourcePersonId":"vndb:s8382","canonicalEntityId":"vndb:s8382","name":"森嶋 秀太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92789","source":"vndb"}]},{"characterId":"char_vndb_c131021","characterName":"ゴン太","sourceIds":{"vndbCharacterId":"c131021"},"originalCharacterName":"ゴン太","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Mraw...\""},{"spoiler":false,"text":"A big cat, affectionately nicknamed \"Rowdy Gonta.\""},{"spoiler":false,"text":"Gonta is the king of the cats on the island,"},{"spoiler":false,"text":"and he will fight—and defeat—anyone who challenges his authority."},{"spoiler":false,"text":"However, he doesn't attack people indiscriminately. Whenever Himawari picks him up and pets him, he lets her do as she pleases, only purring discontentedly in response."},{"spoiler":false,"text":"He's a busy cat, always patrolling the island to keep the peace."},{"spoiler":false,"text":"Taken from Official English page"}],"source":"vndb","sourceCharacterId":"c131021"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9deed357b711fd59669735178eeaeccd5ca509cf747ec1a5911529b5276c660e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a78eeba5352ea8f46440ad7580138d84120d78ff179accf140f401f986cc4979.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北垣内 春香","creatorId":"vndb:s12829","sourcePersonId":"vndb:s12829","canonicalEntityId":"vndb:s12829","name":"北垣内 春香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92790","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p336","sourceCompanyId":"egs:brand:275","canonicalEntityId":"vndb:p336","name":"FrontWing","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:36353:275","source":"egs"},{"companyId":"vndb:p336","sourceCompanyId":"vndb:p336","canonica