{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21091","model":{"presentationWorkId":"vndb:v16067","staff":{"artwork":[{"creditedName":"NOBU(原画)","creatorId":"vndb:s6923","sourcePersonId":"egs:creator:6711","canonicalEntityId":"vndb:s6923","name":"NOBU(原画)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138612","source":"egs"}],"scenario":[{"creditedName":"えろっちつばめ21","creatorId":"vndb:s5329","sourcePersonId":"egs:creator:17389","canonicalEntityId":"vndb:s5329","name":"えろっちつばめ21","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138613","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c22242","characterName":"小日向 花子","sourceIds":{"bangumi":[{"characterId":"48202","match":"exact-normalized-name-in-linked-work","subjectId":"197505"}],"egsCharacterIds":["4924"],"vndbCharacterId":"c22242"},"originalCharacterName":"小日向 花子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A full-time housewife in her late thirties. She is calm, very kind, and receptive. She is the type of woman who likes to make men feel good about themselves and see their faces when they are happy. She has a pure and innocent heart that knows no doubts."},{"spoiler":false,"text":"She grew up in an ordinary family where her parents loved her very much. She attended a public school all her life, and after graduating from a junior college, she got a job at a department store."},{"spoiler":false,"text":"She married a man she met in a college club and retired on her own. She has never known any other man except her husband. Her husband has been impotent for many years and she is frustrated."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c22242"},{"segments":[{"spoiler":false,"text":"三十代後半。専業主婦。"},{"spoiler":false,"text":"母性本能のカタマリのような優しいタイプの美人巨乳ママ。"},{"spoiler":false,"text":"夫以外の男性は知らない。"},{"spoiler":false,"text":"夫が長年インポテンツを患っているため、欲求不満を溜め込んでいる。"}],"source":"egs","sourceCharacterId":"4924","sourceWorkId":"21091","spoiler":false},{"segments":[{"spoiler":false,"text":"三十代後半の専業主婦。"},{"spoiler":false,"text":"おっとりとしていてとても優しく、包容力がある。"},{"spoiler":false,"text":"男性を立てたり、男性の喜ぶ顔を見るのが好きな、大和撫子タイプ。"},{"spoiler":false,"text":"人を疑うことを知らない、純真無垢な心の持ち主でもある。"},{"spoiler":false,"text":"平凡な家庭で両親に存分に愛されて育った。"},{"spoiler":false,"text":"ずっと公立の学園に通い、短大卒業後はデパートに就職。"},{"spoiler":false,"text":"大学のサークルで知り合った男性と結婚して寿退職する。"},{"spoiler":false,"text":"夫以外の男性を知らない。 夫が長年インポテンツを患っており、欲求不満を溜め込んでいる。"}],"source":"bangumi","sourceCharacterId":"48202"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"48202","value":"菓子作り、メルヘン調の食器集め、散歩"},{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"4924","sourceWorkId":"21091","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"4924","sourceWorkId":"21091","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"4924","sourceWorkId":"21091","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"4924","sourceWorkId":"21091","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"4924","sourceWorkId":"21091","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3dc702379f75c5a20bbcf90c809732506b5035cd46ee50f263d7cf86c07697f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/095420d296db786d4b949e290331a33a776cc1cbabc90934ad8d9bb8754920f8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197505:48202:5669:1","source":"bangumi"}]},{"characterId":"char_c22243","characterName":"堅城 操","sourceIds":{"bangumi":[{"characterId":"48203","match":"exact-normalized-name-in-linked-work","subjectId":"197505"}],"egsCharacterIds":["4925"],"vndbCharacterId":"c22243"},"originalCharacterName":"堅城 操","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Single mother in her late thirties. She works mainly from home as a translator. She was raised with a strict upbringing and was baptized with rigid values from the time she was a child. Because of this, she is often seen as a cold person, but in fact she is very compassionate and loving."},{"spoiler":false,"text":"After graduating from college, she had an arranged marriage partner, but her husband was unable to put up with her strictness and cheated on her, and the marriage fell apart within two years."},{"spoiler":false,"text":"She has not healed from the emotional trauma of the divorce and vows never to fail again, but on the other hand, she is tired of her rigid lifestyle and has a desire to be dominated by a man of her own free will."},{"spoiler":false,"text":"She has never known a man other than her husband, and has been frustrated because she has had no contact with the male sex for so long."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c22243"},{"segments":[{"spoiler":false,"text":"三十代後半。シングルマザー。主に在宅で翻訳の仕事をしている。"},{"spoiler":false,"text":"カタブツなインテリタイプの美人巨乳ママ。"},{"spoiler":false,"text":"夫とは何年も前に離婚している。"},{"spoiler":false,"text":"夫以外の男性は知らず、長い間男性と接触がないので、欲求不満を溜め込んでいる。"}],"source":"egs","sourceCharacterId":"4925","sourceWorkId":"21091","spoiler":false},{"segments":[{"spoiler":false,"text":"三十代後半のシングルマザー。 主に在宅で翻訳の仕事をしている。"},{"spoiler":false,"text":"子供の頃から厳しくしつけられ、堅苦しい価値観の洗礼を受けて育った。"},{"spoiler":false,"text":"そのため冷たい人間に見られがちだが、実はとても情が濃く愛情深い。"},{"spoiler":false,"text":"大学卒業後、お見合いした相手と結婚するが、夫は彼女の厳しさにガマンできず浮気し、二年で破綻する。"},{"spoiler":false,"text":"離婚の心の傷が癒えておらず、二度と挫折しないよう心に誓っているが、その一方で堅苦しい生き方に疲れ、“強い男に支配されたい” “思いきりハジケてみたい” という願望を秘めている。"},{"spoiler":false,"text":"夫以外の男性は知らず、長い間男性と接触がないので、欲求不満を溜め込んでいる。"}],"source":"bangumi","sourceCharacterId":"48203"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"48203","value":"海外文学の読書、エアロビクス"},{"label":"胸围（本版本）","value":"100 cm","valueContext":null,"source":"egs","sourceCharacterId":"4925","sourceWorkId":"21091","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"i","valueContext":null,"source":"egs","sourceCharacterId":"4925","sourceWorkId":"21091","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"4925","sourceWorkId":"21091","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"4925","sourceWorkId":"21091","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"4925","sourceWorkId":"21091","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6511e3f7bf96e0159ca3f4c4daca041e69a8bd0529d63122ccfa967ed90a183.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec97e26ee2361f2907e5411988708af964ef8ba1c27289fd3517fd5af6103ccd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197505:48203:4799:1","source":"bangumi"}]},{"characterId":"char_vndb_c111322","characterName":"小日向 日々希","sourceIds":{"vndbCharacterId":"c111322"},"originalCharacterName":"小日向 日々希","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this work. He is the only son of Hanako. He is slow to grow physically and is annoyed when his appearance is compared to other boys his age."},{"spoiler":false,"text":"For better or worse, he is passionate, possessive, and competitive, and when his pride is hurt, he takes thorough actions to recover it. He pretends that his secondary sexual characteristics have not yet arrived, but in fact he is an immensely fertile man."},{"spoiler":false,"text":"At school, he seduces and fucks pretty girls and female teachers at will. He is taking swimming lessons to build his manly body, but he is still a beginner."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c111322"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/247bf9f8dc8a0950a770ef13ed5d929429c49dc93a77c956f9b015bf9ea8d679.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e16be887b8f5f1e60caeeb95199fcb44048dc7f4b358036be0d1ffcdf45fff9.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c111323","characterName":"堅城 聖","sourceIds":{"vndbCharacterId":"c111323"},"originalCharacterName":"堅城 聖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Friend of the main character. He is the only son of Misao. He is a bit shy, but he has a bright and kind heart, and is innocent and has no doubts about others."},{"spoiler":false,"text":"Compared to other men of his age, even he beats out the protagonist in looking younger. He is true virgin boy."},{"spoiler":false,"text":"He is disciplined daily and pressured to do his best in his studies. He knows in his head that this is for his own good, but the stress is starting to get to him."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c111323"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a735ef3e276a30acbaf67bda08635409fc486213588135d7657e4c24e8142db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31c5739a21d2d0f2170e87849ebfb09cb0463a444d313757cf12376788e8d7cd.