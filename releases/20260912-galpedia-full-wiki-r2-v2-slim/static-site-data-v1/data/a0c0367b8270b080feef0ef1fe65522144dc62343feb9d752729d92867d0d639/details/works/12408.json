{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12408","model":{"presentationWorkId":"vndb:v1647","staff":{"artwork":[{"creditedName":"綾瀬はづき","creatorId":"vndb:s580","sourcePersonId":"egs:creator:5019","canonicalEntityId":"vndb:s580","name":"綾瀬はづき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:77470","source":"egs"}],"scenario":[{"creditedName":"でぇすて(D.S.T、不二川巴人)","creatorId":"vndb:s921","sourcePersonId":"egs:creator:1074","canonicalEntityId":"vndb:s921","name":"でぇすて(D.S.T、不二川巴人)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78534","source":"egs"}],"music":[],"other":[{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:82668","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26929","source":"vndb"}]},"cast":[{"characterId":"char_c22666","characterName":"秋月 蓮","sourceIds":{"bangumi":[{"characterId":"205492","match":"exact-normalized-name-in-linked-work","subjectId":"223674"}],"egsCharacterIds":["15318"],"vndbCharacterId":"c22666"},"originalCharacterName":"秋月 蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秋月流剣術の使い手。"},{"spoiler":false,"text":"幼い頃から祖父と共に山野で修行を終業生活を送ってきたため、剣術の腕は抜群。"},{"spoiler":false,"text":"その一方で世間の常識には極端に疎い。"},{"spoiler":false,"text":"クールで負けず嫌い。多少短期なところはあるが、何事にも正々堂々、真正面から向い合う。"},{"spoiler":false,"text":"より強い血を取り込むという家の掟のため、彼の妻となり子を成すことになる。"},{"spoiler":false,"text":"本人は義務として、強い種を残すためという感じで、ツンツンしながらも、積極的に子作りを求め、誘う。"},{"spoiler":false,"text":"負けず嫌いなところがあるため、ツンツンしているが、将明の実力は認め、その強さや奔放さに惹かれてもいる。"},{"spoiler":false,"text":"しかし、本人もそんな感情には気づかず、グータラな彼には厳しくあたる。"},{"spoiler":false,"text":"「本日只今より、私はおまえの妻になる」"}],"source":"egs","sourceCharacterId":"15318","sourceWorkId":"12408","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ee0bd86b7a283227d93a3a8a4495fc368be28fcdb37d287bb30913f169c1d4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c98aa2d1a264c69910ea37084482365cd0949f56485063fa4170a5d685e31d46.webp","width":256,"height":246,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223674:205492:6083:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p314","sourceCompanyId":"egs:brand:2093","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:12408:2093","source":"egs"},{"companyId":"vndb:p314","sourceCompanyId":"vndb:p314","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11586:v1647","source":"vndb"},{"companyId":"vndb:p314","sourceCompanyId":"vndb:p314","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:11587:v1647","source":"vndb"},{"companyId":"vndb:p1596","sourceCompanyId":"vndb:p1596","canonica