etail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:70601:31006:5075:1","source":"bangumi"}]},{"characterId":"char_c19393","characterName":"虎丸 泰我","sourceIds":{"bangumi":[{"characterId":"31007","match":"exact-normalized-name-in-linked-work","subjectId":"70601"}],"egsCharacterIds":["2769"],"vndbCharacterId":"c19393"},"originalCharacterName":"虎丸 泰我","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【トラブルチェイサー】"},{"spoiler":false,"text":"庶民生徒。悪友。"},{"spoiler":false,"text":"革命だ！　とにかく体制に反抗するのか大好きなちょっと危険な男。"},{"spoiler":false,"text":"特に思想はなく、カオスで刺激的なことが大好きなだけ。"},{"spoiler":false,"text":"何かと偉人の名言を引用したがるなど、中二病を多分に引きずっている。"},{"spoiler":false,"text":"PC関連の造詣が深く、他人の（一般人の）ＰＣに侵入するくらいならやってのける。"},{"spoiler":false,"text":"基本脳内スペックは高いはずなのに、勉強には全く活かせていない。"},{"spoiler":false,"text":"泰我いわく、好きでないことには気合いが入らない。"},{"spoiler":false,"text":"「私は実験において、失敗など一度たりともしていない。"},{"spoiler":false,"text":"この方法ではうまく行かないということを発見してきたのだ。エジソン」"}],"source":"egs","sourceCharacterId":"2769","sourceWorkId":"18872","spoiler":false},{"segments":[{"spoiler":false,"text":"遥斗の悪友の一人。"},{"spoiler":false,"text":"「革命だ！」 が口癖の、とにかく体制に反抗するのか大好きなちょっと危険な男。"},{"spoiler":false,"text":"特に思想はなく、カオスで刺激的なことが大好きなだけ。"},{"spoiler":false,"text":"なにかと偉人の名言を引用したがるなど、中二病を多分に引きずっている。"},{"spoiler":false,"text":"PC関連の造詣が深く、他人の （一般人の） PCに侵入するくらいならやってのける。"},{"spoiler":false,"text":"基本脳内スペックは高いはずなのに、勉強にはまったく活かせていない。"},{"spoiler":false,"text":"本人曰く、好きでないことには気合いが入らないらしい。"},{"spoiler":false,"text":"「私は実験において、失敗など一度たりともしていない。この方法ではうまく行かないということを発見してきたのだ。エジソン」"}],"source":"bangumi","sourceCharacterId":"31007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e97312825e3616bc3090f9027eb5a055f2675ff9739b1f284da31c5f2fa4895f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c92e8d0b4cac784d1497d59975659d7538bc21bacbf44c7be4969908cde809e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀井茶渡","creatorId":"vndb:s2915","sourcePersonId":"vndb:s2915","canonicalEntityId":"vndb:s2915","name":"堀井 茶渡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:70601:31007:18049:1","source":"bangumi"}]},{"characterId":"char_c19394","characterName":"龍巳 元樹","sourceIds":{"bangumi":[{"characterId":"31008","match":"exact-normalized-name-in-linked-work","subjectId":"70601"}],"egsCharacterIds":["2770"],"vndbCharacterId":"c19394"},"originalCharacterName":"龍巳 元樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【熱血、根性、暑苦しい】"},{"spoiler":false,"text":"庶民生徒。悪友。"},{"spoiler":false,"text":"ことあるごとに「全力を出せ！」"},{"spoiler":false,"text":"「共に汗を流せばわかりあえる！」など暑苦しい。説教臭い。"},{"spoiler":false,"text":"妹がふたりいるので、面倒を見ているうち兄貴的な言動が身に染みついてしまった。"},{"spoiler":false,"text":"庶民だのセレブだのにあまり興味は無いのだが、"},{"spoiler":false,"text":"それを理由に見下されるのは気に入らないと思っている。"},{"spoiler":false,"text":"そう、優雅にてぃーたいむばかりではなく、ともに熱く汗を流せばきっと心根は正されるだろう。"},{"spoiler":false,"text":"というわけで両者を隔てている壁を疎ましく思っている。"},{"spoiler":false,"text":"ちなみに妹を通じて現実を知っているため、異性でも年下には興味が湧かない。"},{"spoiler":false,"text":"「ほら、今度はお兄ちゃんが一緒にやってやるから。もう一回だ」"}],"source":"egs","sourceCharacterId":"2770","sourceWorkId":"18872","spoiler":false},{"segments":[{"spoiler":false,"text":"遥斗の悪友の一人。"},{"spoiler":false,"text":"ことあるごとに 「全力を出せ！」 「共に汗を流せばわかりあえる！」 など暑苦しい。説教臭い。"},{"spoiler":false,"text":"妹がふたりいるので、面倒を見ているうちに兄貴的な言動が身に染み付いてしまった。"},{"spoiler":false,"text":"庶民だのセレブだのにあまり興味は無いのだが、それを理由に見下されるのは気に入らないと思っている。"},{"spoiler":false,"text":"そう、優雅にてぃーたいむばかりではなく、共に熱く汗を流せばきっと心根は正されるだろう。"},{"spoiler":false,"text":"というわけで、両者を隔てている壁を疎ましく思っている。"},{"spoiler":false,"text":"年下にはまったく興味がなく、熟女好き。"},{"spoiler":false,"text":"「本当に力を出し尽くしたのか？　敵は手加減なんてしちゃくれないぞ！」"}],"source":"bangumi","sourceCharacterId":"31008"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e81755c25797fecf905b3cd35c6b406dd4f3ffabaaf0907267ab1e87fc495374.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33555d60cccaed088d327fb16e2a0f69d235c8bbef3465f0221c281ef5170363.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林健次郎","creatorId":"vndb:s2914","sourcePersonId":"vndb:s2914","canonicalEntityId":"vndb:s2914","name":"小林 健次郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:70601:31008:62784:1","source":"bangumi"}]},{"characterId":"char_vndb_c102262","characterName":"島田 遥斗","sourceIds":{"vndbCharacterId":"c102262"},"originalCharacterName":"島田 遥斗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p188","sourceCompanyId":"egs:brand:840","canonicalEntityId":"vndb:p188","name":"SCORE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18872:840","source":"egs"},{"companyId":"vndb:p188","sourceCompanyId":"vndb:p188","canonicalEntityId":"vndb:p188","name":"Score","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30813:v12435","source":"vndb"},{"companyId":"vndb:p188","s