:false,"text":"・性格："},{"spoiler":false,"text":"おとなしい。"},{"spoiler":false,"text":"・特徴："},{"spoiler":false,"text":"かなりグラマー。髪型はロングで、リボンをしている。"},{"spoiler":false,"text":"・備考："},{"spoiler":false,"text":"主人公。見た目的には、落ち着いているように見えるが、実はおっとり＆のんびりしているだけ。"},{"spoiler":false,"text":"良介に告白された日の夜、つい、ちょっとだけ自慰してしまった所を写真に撮られて、それをネタに脅され始める。"},{"spoiler":false,"text":"最初は、ただ「神村　良介と別れろ」という内容の脅迫文だけだったのが、ある日突然、見知らぬ男達が現れた事で、悪夢のような境遇におかれてしまう。"}],"source":"bangumi","sourceCharacterId":"27138"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67d3af01cc5e316d9481cf77819ae4594cf21d70a07f4c022d4599da02a39777.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ac7a6b48bd7c385cb318111c13f831f2f04f807ac5a2e67426795a46fbdccae.webp","width":240,"height":240,"source":"static-detail"},"actors":[{"creditedName":"川崎恵理子","creatorId":"vndb:s121","sourcePersonId":"vndb:s121","canonicalEntityId":"vndb:s121","name":"川崎 恵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:350885:27138:4034:1","source":"bangumi"},{"creditedName":"鷹月 さくら","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27151","source":"vndb"}]},{"characterId":"char_c32741","characterName":"結城 綾","sourceIds":{"bangumi":[{"characterId":"28066","match":"exact-normalized-name-in-linked-work","subjectId":"114894"},{"characterId":"28066","match":"exact-normalized-name-in-linked-work","subjectId":"350885"}],"egsCharacterIds":["20931"],"vndbCharacterId":"c32741"},"originalCharacterName":"結城 綾","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments