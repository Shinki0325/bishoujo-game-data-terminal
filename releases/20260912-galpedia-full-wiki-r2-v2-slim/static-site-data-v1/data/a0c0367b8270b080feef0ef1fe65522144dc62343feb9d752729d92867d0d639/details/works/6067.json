e":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c42962","characterName":"中村 悠里","sourceIds":{"vndbCharacterId":"c42962"},"originalCharacterName":"中村 悠里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's cousin."},{"spoiler":false,"text":"She used to be a bright and cheerful girl, but became timid and reserved after becoming the target of relentless bullying."},{"spoiler":false,"text":"She relies on the protagonists as her sole ally, but for some reason declines to talk of the details and reasons for the bullying, insisting she's the one at fault. Yuuri refuses to ask for help and instead insists on enduring her ordeal intently, but in reality she is already close to her breaking point."},{"spoiler":false,"text":"She feels uneasy at being approached by Satou Mika due to the heavy resemblance to her tormentor, and their relationship stays rocky despite Mika's intentions."}],"source":"vndb","sourceCharacterId":"c42962"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a72384653c7e4373e0dc1d0abfaa6aa19d8a255977b9bf3e463d52316d9d8e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b3904832c3357e747c79f15f7e5465cc12ccef1be9c9afe24ce92a5902592b7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風華","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","rel