":"auto-confirmed","relationId":"egs:work-creator:15749","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c64109","characterName":"緋月 詩乃","sourceIds":{"bangumi":[{"characterId":"58091","match":"exact-normalized-name-in-linked-work","subjectId":"23048"}],"egsCharacterIds":["23391"],"vndbCharacterId":"c64109"},"originalCharacterName":"緋月 詩乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A teacher at Akizuki Academy and the older sister of Ayumi and Mitsuna."},{"spoiler":false,"text":"She is an average teacher and doesn't feel any special passion towards teaching. Still, as a young female teacher she is popular among students."},{"spoiler":false,"text":"During her schooldays she learned Aikido (has black belt), so she's got self-defense covered."},{"spoiler":false,"text":"She's extremely direct and harsh with her words. Loves alcohol and drinks a lot, sometimes drinking so much she loses her memory."},{"spoiler":false,"text":"In the past she has experienced a huge failure, since then, she has put any relations with men on hold."}],"source":"vndb","sourceCharacterId":"c64109"},{"segments":[{"spoiler":false,"text":"学園の女教師で、鮎美、美津菜の姉。"},{"spoiler":false,"text":"教師として、特に気合いを入れて指導してはいないが、その容姿と若さから、教え子たちからの人気は上々。"},{"spoiler":false,"text":"学生時代、合気道をしていた体育会系で、きつくダイレクトな言葉がタマにキズ。"},{"spoiler":false,"text":"過去に大失恋をしており、それ以来、男関係はないようだが……。"}],"source":"egs","sourceCharacterId":"23391","sourceWorkId":"8725","spoiler":false},{"segments":[{"spoiler":false,"text":"【次女】"},{"spoiler":false,"text":"秋月学園に勤める女教師で、鮎美と美津菜の姉。"},{"spoiler":false,"text":"教師としては凡庸であり、特に熱血教師をやっている感じではない。"},{"spoiler":false,"text":"しかし、若い女教師ということもあり、教え子たちからの人気はそこそこある。"},{"spoiler":false,"text":"学生時代合気道をならっていたので（黒帯）、護身術の心得がある。"},{"spoiler":false,"text":"言葉が非常にダイレクトできつい。"},{"spoiler":false,"text":"酒好き。酒豪。記憶をなくすまで飲むこともしばしば。"},{"spoiler":false,"text":"過去に大失恋を経験している。それ以来、男はキャンセル気味。"}],"source":"bangumi","sourceCharacterId":"58091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63f0091e088117056c0ee142022e8f6fcb30fd1f3662e5a8a93e813a75d1820a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d177f4f126dd9aef0ba210900ad092a908b0a7eb655d7c90d9e903192265820f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石松千恵美","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98935:58091:4273:1","source":"bangumi"}]},{"characterId":"char_vndb_c14836","characterName":"神楽 美和","sourceIds":{"vndbCharacterId":"c14836"},"originalCharacterName":"神楽 美和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9343a5b239a507820b93758234acb27e5d51c0a6cfa5ba2a54fb22b52d0bb1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8289216cc46917633c6ab63fe162162ad5fb73b24ca850e684c5ed5bacc077a4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35433","source":"vndb"}]},{"characterId":"char_vndb_c34605","characterName":"美原 あかね","sourceIds":{"vndbCharacterId":"c34605"},"originalCharacterName":"美原 あかね","cha