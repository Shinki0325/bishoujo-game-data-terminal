{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"24267","model":{"presentationWorkId":"egs:24267","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c34049","characterName":"鏑木 由希江","sourceIds":{"bangumi":[{"characterId":"33670","match":"exact-normalized-name-in-linked-work","subjectId":"134488"},{"characterId":"33670","match":"source-roster","subjectId":"134488"},{"characterId":"33670","match":"source-roster","subjectId":"172774"},{"characterId":"33670","match":"source-roster","subjectId":"356280"}],"egsCharacterIds":["7164"],"vndbCharacterId":"c34049"},"originalCharacterName":"鏑木 由希江","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Known to Ren and Ichika as the \"Kind Older Sister\" who lives next door to the Ougi house."},{"spoiler":false,"text":"Although they go to different schools, the three of them sometimes go to school together when time allows it. Yukie also loves Ren and Ichika as if they were her younger siblings."},{"spoiler":false,"text":"In particular, she shows a playful side to Ren, and likes to tease him sometimes. She is the student council president of Shiraba Academy, and is well respected by the students for her accurate and reliable execution of all tasks."},{"spoiler":false,"text":"\"Hehe. You've changed a lot, haven't you, Ren-kun? ...You've gotten a lot cooler.\""}],"source":"vndb","sourceCharacterId":"c34049"},{"segments":[{"spoiler":false,"text":"皇城家の隣の家に住んでいる、蓮や一花にとっては“お隣りの優しいお姉さん”。"},{"spoiler":false,"text":"由希江も、蓮や一花を弟や妹のように可愛がっており、特に蓮に対しては、時に連に対しては、時にからかったり、悪戯心を出してみたりと、お茶目な一面を見せる。"},{"spoiler":false,"text":"学園は違うが、時間が合えば三人一緒に登校することもある。"},{"spoiler":false,"text":"白羽学園の学生会長をしており、何事にも的確かつ確実に実行するため、学生達からも一目置かれている。"}],"source":"egs","sourceCharacterId":"7164","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"皇城家の隣家に住んでいる、蓮や一花にとっては “お隣りの優しいお姉さん”。"},{"spoiler":false,"text":"学園は違うが、時間が合えば三人一緒に登校することもある。"},{"spoiler":false,"text":"由希江も蓮や一花を弟妹のように可愛がっている。"},{"spoiler":false,"text":"特に蓮に対しては、イタズラ心からからかうなど、お茶目な一面を見せることも。"},{"spoiler":false,"text":"白羽学園では学生会長を務めていて、"},{"spoiler":false,"text":"何事も的確かつ確実に実行するため、学生たちから一目置かれている。"},{"spoiler":false,"text":"「ふふっ。 そういう蓮君だってかなり変わったよ？　……すっごくカッコよくなった」"}],"source":"bangumi","sourceCharacterId":"33670"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1814d23637381819fdc81e54241f67dcb70b24d9f75328391e5df63e838e5b63.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9a15456165476582da8e3e5d8d15a2e307902c682624bc23de5574d08e1224e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2612","sourceCompanyId":"egs:brand:2612","canonicalEntityId":"egs:brand:2612","name":"ensemble","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:24267:2612","source":"egs"}],"missingStates":["current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
