{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7008","model":{"presentationWorkId":"vndb:v4448","staff":{"artwork":[{"creditedName":"御堂つかさ","creatorId":"vndb:s2965","sourcePersonId":"egs:creator:3841","canonicalEntityId":"vndb:s2965","name":"御堂つかさ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13800","source":"egs"}],"scenario":[{"creditedName":"巽ヒロヲ","creatorId":"vndb:s2300","sourcePersonId":"egs:creator:1839","canonicalEntityId":"vndb:s2300","name":"巽ヒロヲ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13801","source":"egs"}],"music":[{"creditedName":"有限会社クワイア","creatorId":"vndb:s1266","sourcePersonId":"egs:creator:4024","canonicalEntityId":"vndb:s1266","name":"有限会社クワイア","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22914","source":"egs"},{"creditedName":"ジル・ブラッド","creatorId":"vndb:s3051","sourcePersonId":"vndb:s3051","canonicalEntityId":"vndb:s3051","name":"ジル・ブラッド","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:50042","source":"vndb"}],"other":[{"creditedName":"三々山鈴","creatorId":"vndb:s8322","sourcePersonId":"egs:creator:23439","canonicalEntityId":"vndb:s8322","name":"三々山鈴","detail":"OP曲 「私がここにいる理由」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:148683","source":"egs"},{"creditedName":"御堂 つかさ","creatorId":"vndb:s2965","sourcePersonId":"vndb:s2965","canonicalEntityId":"vndb:s2965","name":"御堂 つかさ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:50040","source":"vndb"},{"creditedName":"三々山 鈴","creatorId":"vndb:s8322","sourcePersonId":"vndb:s8322","canonicalEntityId":"vndb:s8322","name":"三々山鈴","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:50043","source":"vndb"}]},"cast":[{"characterId":"char_c50433","characterName":"明日原 ゆうこ","sourceIds":{"bangumi":[{"characterId":"221333","match":"exact-normalized-name-in-linked-work","subjectId":"229576"}],"egsCharacterIds":["25923"],"vndbCharacterId":"c50433"},"originalCharacterName":"明日原 ゆうこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８５"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８６"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５３"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After graduating from a prestigious private university with excellent grades, she became a Japanese language teacher at an elite private school in the city. However, she was stalked by a janitor who worked at the school, and due to the psychological stress, she requested a transfer and moved to a school in a rural area."},{"spoiler":false,"text":"Thanks to her natural cheerfulness and sincere approach to the students, she quickly became a popular figure at the school. Additionally, many male students secretly admire and admire her for her beauty."},{"spoiler":false,"text":"She is occasionally approached for love advice from female students, but since she has little experience with men, she can only offer general advice based on knowledge rather than personal experience. As a result, she relies on information from magazines and friends to stay informed."},{"spoiler":false,"text":"She is a teacher who is always smiling and always has a kind word for everyone."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c50433"},{"segments":[{"spoiler":false,"text":"名門私大を優秀な成績で卒業後、都会の私立エリート校の国語教師となる。"},{"spoiler":false,"text":"しかし、学園の用務員にストーカーを受け、心に傷を負い転任。"},{"spoiler":false,"text":"新しい学園では持ち前の明るさと誠実さで、一躍人気者となる。"},{"spoiler":false,"text":"女生徒から恋愛相談を受けることもあるが、男性との交際経験がないため、一般的なアドバイスに止まる。"},{"spoiler":false,"text":"機械オンチなため、自身の盗撮写真が掲載されていたアングラサイトのことは知らない。"}],"source":"egs","sourceCharacterId":"25923","sourceWorkId":"7008","spoiler":false},{"segments":[{"spoiler":false,"text":"ほら、ダメよ、学校にこんなもの持ってきちゃ。まぁ、今日の所は見逃してあげる"},{"spoiler":false,"text":"名門私大を優秀な成績で卒業後、都会の私立エリート校の国語教師と"},{"spoiler":false,"text":"なるが、その学園に勤務する用務員（Ｓ氏）にストーカーされ、その"},{"spoiler":false,"text":"心的ストレスにより転任を希望、とある地方の学園へと転属する。"},{"spoiler":false,"text":"持ち前の明るさと、生徒達に対する親身な接し方により、転属早々、"},{"spoiler":false,"text":"あっという間に学園の人気者となる。"},{"spoiler":false,"text":"また、その美貌から密かに憧れ慕う男子学生も多い。"},{"spoiler":false,"text":"女生徒から恋の相談を受けたりもするが、実は今までろくに男性と"},{"spoiler":false,"text":"付き合ったことが無い為、経験談では無く、あくまで一般論的な知識"},{"spoiler":false,"text":"としてのアドバイスしかできないでいる。"},{"spoiler":false,"text":"その為、雑誌や友人達から仕入れた情報で耳年増になっている。"}],"source":"bangumi","sourceCharacterId":"221333"}],"profileFacts":[{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"25923","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"25923","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"25923","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"25923","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"25923","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"25923","sourceWorkId":"7008","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f505061b30c3f58b7833c2dc66ac1dd0df92d00c38acec7ccc12fe890926367.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e5828496d0396c4aaf9839f34e9d933ad391abc68077c7b35ed46b03a5d5d20.webp","width":93,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229576:221333:6036:1","source":"bangumi"}]},{"characterId":"char_c50434","characterName":"榊 いづみ","sourceIds":{"bangumi":[{"characterId":"221334","match":"exact-normalized-name-in-linked-work","subjectId":"229576"}],"egsCharacterIds":["25924"],"vndbCharacterId":"c50434"},"originalCharacterName":"榊 いづみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８６"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８５"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５０"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female teacher who teaches physical education at the school attended by the protagonist. She has a cheerful and straightforward personality and is very popular with her students."},{"spoiler":false,"text":"On the other hand, she tends to say whatever she thinks, which has earned her the resentment of some people. Some of the male teachers dislike her."},{"spoiler":false,"text":"Due to her personality, she has many male friends but no romantic experience and no experience with men. She is unaware of it, but this has become an unconscious complex, and she harbors a slight jealousy toward the more feminine Yuuko."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c50434"},{"segments":[{"spoiler":false,"text":"主人公の学園の体育教師。担当は男子体育。"},{"spoiler":false,"text":"さばさばした性格で生徒たちに好かれている。ただ、物事をハッキリ言うところがあり、疎ましく思っている者もいる様子。"},{"spoiler":false,"text":"男友達は多いが、恋愛経験はなし。それが無意識にコンプレックスとなり、ゆうこに劣等感を抱くことも。"},{"spoiler":false,"text":"授業中に男子学生の太ももや水着姿にドキドキし、いけないと思いつつも自慰に耽ってしまう。"}],"source":"egs","sourceCharacterId":"25924","sourceWorkId":"7008","spoiler":false},{"segments":[{"spoiler":false,"text":"おい、オマエら！　廊下は走っちゃダメだって何度言えばわかるんだ!?"},{"spoiler":false,"text":"主人公の通う学園で、体育を担当している女教師。"},{"spoiler":false,"text":"明るくさばさばとした性格で、生徒からの人気も高い。"},{"spoiler":false,"text":"一方、思ったことをすぐ口にしてしまう為、一部の人々からは反感も"},{"spoiler":false,"text":"買っている。男性教師の中にはいづみを疎ましく思う者も。"},{"spoiler":false,"text":"その性格から、男友達は多いが恋愛経験は皆無で男性経験も無し。"},{"spoiler":false,"text":"本人は意識していないがそれが無自覚のコンプレックスとなっており"},{"spoiler":false,"text":"女らしいゆうこにちょっとしたジェラシーを抱いている。"}],"source":"bangumi","sourceCharacterId":"221334"}],"profileFacts":[{"label":"年龄（本版本）","value":"25 岁","valueContext":null,"source":"egs","sourceCharacterId":"25924","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"25924","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"25924","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"25924","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"25924","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"54 kg","valueContext":null,"source":"egs","sourceCharacterId":"25924","sourceWorkId":"7008","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c95862ab9fc5253a24e32001b1dabd251cb5c88e930810ee8fd3ff6e2e2abe2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8eeb48dd0c4abd07a7a49390853565558b1416921d5b655861176693546ab281.webp","width":108,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229576:221334:19333:1","source":"bangumi"}]},{"characterId":"char_c50435","characterName":"森原 木葉","sourceIds":{"bangumi":[{"characterId":"221339","match":"exact-normalized-name-in-linked-work","subjectId":"229576"}],"egsCharacterIds":["25927"],"vndbCharacterId":"c50435"},"originalCharacterName":"森原 木葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"７９"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７８"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"４８"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the protagonist's classmate and serves as class president, and in that capacity, she often supports Yuko. She is an excellent student and has high expectations from those around her, so she unconsciously forces herself to always behave that way."},{"spoiler":false,"text":"She is also very conscious of her appearance and takes the initiative in picking up paper scraps that have fallen on the floor,"},{"spoiler":false,"text":"showing her obsessive-compulsive side."},{"spoiler":false,"text":"She is an excellent student, but she is not good at sports, so she often observes physical education classes under the pretext of feeling unwell or having her period."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c50435"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。クラス委員長と風紀委員を兼務。"},{"spoiler":false,"text":"学業優秀で、周りからの期待も高い為、常にそう振る舞うことを無意識に自分に課している。"},{"spoiler":false,"text":"身だしなみにも気を使っており、床に落ちた紙くずなどを率先して拾うなど、潔癖症な面がある。"},{"spoiler":false,"text":"父親への強い反動で男性に対して拒否反応を示す。そのせいかレズっ気があり、ゆうこに対して愛情に近い感情を抱く。"}],"source":"egs","sourceCharacterId":"25927","sourceWorkId":"7008","spoiler":false},{"segments":[{"spoiler":false,"text":"別に私はあなたと競う為に勉強してるわけじゃないから……"},{"spoiler":false,"text":"主人公のクラスメイトでクラス委員長を務めており、その立場上、"},{"spoiler":false,"text":"何かとゆうこのサポートをしている。"},{"spoiler":false,"text":"学業優秀で、周りからの期待も高い為、常にそう振る舞うことを"},{"spoiler":false,"text":"無意識に自分に課している。"},{"spoiler":false,"text":"身嗜みにも気を使っており、床に落ちた紙くずなどを率先して"},{"spoiler":false,"text":"拾うなど、潔癖症な面も持っている。"},{"spoiler":false,"text":"学業優秀な反面、運動関係は得意ではなく、体育の授業を"},{"spoiler":false,"text":"体調不良や生理を理由に見学することが多い。"}],"source":"bangumi","sourceCharacterId":"221339"}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"25927","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"25927","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"25927","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"25927","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"25927","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"25927","sourceWorkId":"7008","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5feb1f39416934bdf54a0303b92ab003b84208a0e1963abafff5c6365bc803f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0abb0f2d7051b19a83c91cb3e2e7e17aa1f33034e60b576fabb3c59005c26bb6.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229576:221339:5900:1","source":"bangumi"}]},{"characterId":"char_c50436","characterName":"椎名 瞳","sourceIds":{"bangumi":[{"characterId":"221336","match":"exact-normalized-name-in-linked-work","subjectId":"229576"}],"egsCharacterIds":["25925"],"vndbCharacterId":"c50436"},"originalCharacterName":"椎名 瞳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"９２"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８７"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５２"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The school nurse at the school where the protagonist attends. With her mature charm, many male students frequent the infirmary even when they have no reason to be there."},{"spoiler":false,"text":"She has a wicked personality, enjoying toying with others, and often makes suggestive advances toward disinterested students,"},{"spoiler":false,"text":"manipulating men for her own amusement."},{"spoiler":false,"text":"On the surface, she pretends to be a kind and serious school nurse, but in private, she seeks out male students who catch her eye. It seems the protagonist is also one of her favorites, and she often subtly tempts him."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c50436"},{"segments":[{"spoiler":false,"text":"主人公の通う学園に勤務する保険医。"},{"spoiler":false,"text":"その妖艶な魅力に、保健室に日参してしまう男子学生も多い。"},{"spoiler":false,"text":"ショタコンの気があり、男子学生をちょくちょく保健室に引きずり込んでは、つまみ食いしている。"},{"spoiler":false,"text":"男性経験は豊富で、その性的テクニックは相当のもの。"},{"spoiler":false,"text":"成績も良く、見栄えもそれなりに良い主人公を機会があればつまみ食いしたいと企んでいる。"}],"source":"egs","sourceCharacterId":"25925","sourceWorkId":"7008","spoiler":false},{"segments":[{"spoiler":false,"text":"もぉ、また怪我したの？気をつけなきゃダメよ♪"},{"spoiler":false,"text":"主人公の通う学園に勤務する保険医。"},{"spoiler":false,"text":"その大人の魅力で、用も無いのに保健室に入り浸る男子学生も多い。"},{"spoiler":false,"text":"他人を弄んで楽しむ、悪女のような性格の持ち主で、気の無い生徒に"},{"spoiler":false,"text":"対して、それらしいアプローチをかけたり、と、男を手玉に取って"},{"spoiler":false,"text":"楽しんでいる。"},{"spoiler":false,"text":"表向きは優しく真面目な保険医を装っているが、裏では好みの"},{"spoiler":false,"text":"男子学生を物色している。主人公も気に入られているらしく、"},{"spoiler":false,"text":"それとなく誘惑されることもしばしば。"}],"source":"bangumi","sourceCharacterId":"221336"}],"profileFacts":[{"label":"年龄（本版本）","value":"28 岁","valueContext":null,"source":"egs","sourceCharacterId":"25925","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"25925","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"25925","sourceWorkId":"7008","sourceField":null,"scoped":true},{"label":"臀