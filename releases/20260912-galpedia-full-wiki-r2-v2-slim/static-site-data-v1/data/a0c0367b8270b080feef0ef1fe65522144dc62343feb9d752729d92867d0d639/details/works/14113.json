staff:54079","source":"vndb"},{"creditedName":"松島 詩史","creatorId":"vndb:s7486","sourcePersonId":"vndb:s7486","canonicalEntityId":"vndb:s7486","name":"松島 詩史","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:54080","source":"vndb"},{"creditedName":"松島 詩史","creatorId":"vndb:s7486","sourcePersonId":"vndb:s7486","canonicalEntityId":"vndb:s7486","name":"松島 詩史","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54081","source":"vndb"}]},"cast":[{"characterId":"char_c26205","characterName":"七枷 結衣","sourceIds":{"bangumi":[{"characterId":"12818","match":"exact-normalized-name-in-linked-work","subjectId":"12285"}],"egsCharacterIds":["11856"],"vndbCharacterId":"c26205"},"originalCharacterName":"七枷 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"822"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yui is Tatsuki’s older sister. She tended to ignore him in favor of talking to her friends before the world was screwed up. She then turns into a slightly doting big sister. She’s quite mysterious at times too."},{"spoiler":false,"text":"\"If a maid's fine, Yui will then dress up as a maid.\""},{"spoiler":false,"text":"On the night of shooting stars she gets her wish to be beautiful."}],"source":"vndb","sourceCharacterId":"c26205"},{"segments":[{"spoiler":false,"text":"冷静でクールな性格だが日常はテレビばかり見てだらだら過ごしている。"},{"spoiler":false,"text":"かと思うと、いきなり突拍子もないことを思いついて、主人公に命じてやらせたりする。"},{"spoiler":false,"text":"主人公の心の中や思ってることを的確に察知して、さりげなく近づいてきたりする優しい面もある。"},{"spoiler":false,"text":"夜中に一人でブラリと出かけ、鉄製のガラクタを拾ってきて、部屋に飾る。"},{"spoiler":false,"text":"鋼鉄で作られたモノ（工具、建材、銃、戦車、ロボットなど）にフェチな執着を持つ。"}],"source":"egs","sourceCharacterId":"11856","sourceWorkId":"14113","spoiler":false},{"segments":[{"spoiler":false,"text":"虽然性格冷静而冷漠，但每天尽是看电视来混日子。"},{"spoiler":false,"text":"但有时会突然想到些乱七八糟的点子，开始对主人公发号施令。"},{"spoiler":false,"text":"能够准确揣摩到主人公心中的想法、将不想听的话全端了出来，但当其他的家人为主人公着想而拉开距离的时候，只有結衣毫不在意地靠近过来，可见她温柔的一面。"},{"spoiler":false,"text":"夜晚一个人在外晃荡，捡些铁制的破烂回来装饰在房间里。"},{"spoiler":false,"text":"对钢铁制的东西（工具、建材、枪、战车、机器人等）有着恋物癖般的执着。"},{"spoiler":false,"text":"「喜欢女仆的话，就让結衣来扮成女仆的样子来吧？」"}],"source":"bangumi","sourceCharacterId":"12818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bce1845ced1da96dd4e65263cf9336f76053d673c2ebf4f285e0a4cc034126.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73819595af78ba3821ec4bca05de89acc86319a3ffb53fefe12ed011ffa664ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12285:12818:4809:1","source":"bangumi"}]},{"characterId":"char_c26206","characterName":"七枷 ギズモ","sourceIds":{"bangumi":[{"characterId":"12820","match":"exact-normalized-name-in-linked-work","subjectId":"12285"}],"egsCharacterIds":["11866"],"vndbCharacterId":"c26206"},"originalCharacterName":"七枷 ギズモ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tatsuki’s pet cat whom he picked up after Kotoko died. Yes, pet cat. Even though she has the appearance of a girl, she still behaves like a cat (e.g. sleeps a lot, says “nya” a lot, goes into heat, ect). She also doesn’t speak much at the start. Some of the other characters are quite cold to her though. Unlike any maids, she is very bad at cooking and cleaning. Gizumo is also very hostile of Yuzu and her antics."},{"spoiler":false,"text":"\"Mantis, will you eat? Will you not eat? I caught it, do you, hate it?\""},{"spoiler":false,"text":"On the night of shooting stars she gets her wish to become human ...mostly."}],"source":"vndb","sourceCharacterId":"c26206"},{"segments":[{"spoiler":false,"text":"主人公の飼い猫で、ある日、猫耳メイドとなった少女。"},{"spoiler":false,"text":"性格は従順、健気で可愛らしい。"},{"spoiler":false,"text":"好奇心旺盛でチョロチョロ動くものを見ると追いかけずにはいられない。"},{"spoiler":false,"text":"虫を平気で捕まえる。シャワーやお風呂が大嫌い。"},{"spoiler":false,"text":"マタタビで酔っぱらう。"},{"spoiler":false,"text":"主人公に優しくされると、主人公の指先をぺろぺろ舐める。"},{"spoiler":false,"text":"幼馴染の子 （柚） に敵視され、いろいろ対立されたりする。"}],"source":"egs","sourceCharacterId":"11866","sourceWorkId":"14113","spoiler":false},{"segments":[{"spoiler":false,"text":"性格温顺果敢而可爱。"},{"spoiler":false,"text":"好奇心旺盛，看见有东西在动就不由自主地追过去。"},{"spoiler":false,"text":"能毫不在意地抓起虫子。最讨厌洗澡。葛枣就能让她烂醉。"},{"spoiler":false,"text":"被主人公温柔对待的时候，就会用舌头舔主人公的指尖。"},{"spoiler":false,"text":"虽然被青梅竹马的柚所敌视、并各种对立，但本人以为这只是在和自己嬉戏。"},{"spoiler":false,"text":"「螳螂要吃吗？不吃吗？抓住了，不喜欢吃这吗？」"}],"source":"bangumi","sourceCharacterId":"12820"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec4744eeba1786ed29ac41d2ed96764efbad669088e08bee5a4a8c354cff98f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52c56dd45edd52b96ef7ae98f6ad76d3cab166e66dfb5694a5b5bf697d7496ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12285:12820:4792:1","source":"bangumi"}]},{"characterId":"char_c26207","characterName":"七枷 琴子","sourceIds":{"bangumi":[{"characterId":"12822","match":"exact-normalized-name-in-linked-work","subjectId":"12285"}],"egsCharacterIds":["11868"],"vndbCharacterId":"c26207"},"originalCharacterName":"七枷 琴子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"46"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite things: Books, reading, cherry"},{"spoiler":false,"text":"Kotoko’s generally a quiet and thoughtful girl who seems to spend most of her life reading books in her room. She’s pretty mysterious as well and holds the key to most of the mysteries in the game."},{"spoiler":false,"text":"On the night of shooting stars, her brother's wish brings her back to life."}],"source":"vndb","sourceCharacterId":"c26207"},{"segments":[{"spoiler":false,"text":"子供らしい遊びをせず、友達も作らず、難しい本を読んだりゲーム （パズル系） ばかりしたり、1日中、家の中で過ごす。"},{"spoiler":false,"text":"それ以外のことはまるで無関心。"},{"spoiler":false,"text":"ツンツンしてるわけではなく、話しかければちゃんと愛想よくしゃべる。"},{"spoiler":false,"text":"ただ、表情の動きは乏しく、人と接することそのものが苦手な様子。"},{"spoiler":false,"text":"常時無表情だが、兄が心から喜んでる時だけ優しい笑顔を見せる。"}],"source":"egs","sourceCharacterId":"11868","sourceWorkId":"14113","spoiler":false},{"segments":[{"spoiler":false,"text":"不玩小孩子们的游戏，不交朋友，尽读些复杂的书、玩些解谜游戏。"},{"spoiler":false,"text":"一整天都在家里读书和玩掌上游戏机。对这之外的事毫不关心。"},{"spoiler":false,"text":"并非是傲而不娇，打招呼时会很亲切地回应。只是，缺乏表情变化，似乎不擅长与人相处。"},{"spoiler":false,"text":"平时基本上都是毫无表情，但只有在哥哥从心底里高兴的时候才会露出温柔的微笑。"},{"spoiler":false,"text":"「哥哥，还记得我以前说过的话吗？」"}],"source":"bangumi","sourceCharacterId":"12822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85ddfc5921904cfd37cf94158d27c9b03fe0b8b66c6b24c9d071ca72aae65dc1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64051cbd4813d147b463786e5efc64e9e580432f73d16676d57d3c79d0057dcd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12285:12822:4705:1","source":"bangumi"}]},{"characterId":"char_c26208","characterName":"七枷 式子","sourceIds":{"bangumi":[{"characterId":"12819","match":"exact-normalized-name-in-linked-work","subjectId":"12285"}],"egsCharacterIds":["11865"],"vndbCharacterId":"c26208"},"originalCharacterName":"七枷 式子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"831"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shikiko is Tatsuki’s mother. She’s a kind-hearted girl who tries to look after her family, she also loves plants and is very green fingered; her room is full of plants. However, Shikiko has a fair amount of secrets with her as well; for some reason, she can't get close to fire nor touch meat."},{"spoiler":false,"text":"On the night of shooting stars, she gets her wish to become young again."}],"source":"vndb","sourceCharacterId":"c26208"},{"segments":[{"spoiler":false,"text":"身の回りに何が起こってもふわふわニコニコしていている優しい母親。"},{"spoiler":false,"text":"時折植物と会話していたりする。"},{"spoiler":false,"text":"家とは「小さな森」のようなもの、という信念を持っていて、家の中に小さな生態系を作ろうと計り、台所、浴室、居間と、ところかまわず植物の栽培を開始する（主人公が暴走を止めないと、家の中は次第にジャングル化してゆく）。"},{"spoiler":false,"text":"基本的に（植物のこと以外で）頼まれたことは断らない。"},{"spoiler":false,"text":"家族のわがままを、なんでも受け入れてしまう。"}],"source":"egs","sourceCharacterId":"11865","sourceWorkId":"14113","spoiler":false},{"segments":[{"spoiler":false,"text":"身边不管发生什么事都轻飘飘地微笑着的温柔母亲。"},{"spoiler":false,"text":"有时会和植物交谈。"},{"spoiler":false,"text":"坚持认为家应该是像“小型森林”一样，为了在家中建立小型生态圈而开始在厨房、浴室、客厅等地毫无顾忌地栽培植物（如果不是主人公制止其暴走，家中就会渐渐演替成热带雨林）。"},{"spoiler":false,"text":"基本上（植物的事以外）不会拒绝别人的请求。"},{"spoiler":false,"text":"对于家人无论怎样的任性都能够包容。"},{"spoiler":false,"text":"「卓君真是的，不管过多久都是小孩子呢～」"}],"source":"bangumi","sourceCharacterId":"12819"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/162b11820add6ddd433b29532bbfc39d5385795469d77c19ba17bb4f03b8f504.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85323ea7490f6fdcc784c5085f1b80d1bbc995bd04502112550bce7c8b1a2646.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12285:12819:6275:1","source":"bangumi"}]},{"characterId":"char_c26209","characterName":"柚","sourceIds":{"bangumi":[{"characterId":"12821","match":"exact-normalized-name-in-linked-work","subjectId":"12285"}],"egsCharacterIds":["11867"],"vndbCharacterId":"c26209"},"originalCharacterName":"柚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"329"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite things: Sports, Tatsuki"},{"spoiler":false,"text":"Yuzu is Tatsuki’s childhood friend. She’s pretty weird and comes into his room through the window and such, and often tries to butt into his life. She also makes him food occasionally. Also a self-proclaimed \"realist\" who tries to do things “acceptable to societies”."}],"source":"vndb","sourceCharacterId":"c26209"},{"segments":[{"spoiler":false,"text":"隣の家に住む幼馴染の女の子。"},{"spoiler":false,"text":"主人公の一家とは小さい頃から付き合いがあった。"},{"spoiler":false,"text":"不登校でブラブラしてる主人公を心配し、時々様子を見に来る。"},{"spoiler":false,"text":"普通の学生生活 （みんなと一緒に楽しく過ごすこと） に興味のない主人公を、なんとか「まともな男の子」に立ち直らせようと、無駄な努力をしたり、お節介を焼いたりする。"},{"spoiler":false,"text":"主人公のことが密かに好き。"},{"spoiler":false,"text":"本人は清く正しくポジティブに生きようとしてるが、それが行き過ぎて他人に理想を押しつけてしまうところがある。"},{"spoiler":false,"text":"身体を動かすのが好きで、スポーツ全般が得意。 考えるより行動するタイプ。"},{"spoiler":false,"text":"お化けや超常現象の類は一切信じない現実主義者。"}],"source":"egs","sourceCharacterId":"11867","sourceWorkId":"14113","spoiler":false},{"segments":[{"spoiler":false,"text":"住在隔壁家的青梅竹马的女孩子。从小时候起就和主人公一家有来往。"},{"spoiler":false,"text":"担心着不上学并游手好闲的主人公，时常来探望。"},{"spoiler":false,"text":"为了让对普通的学园生活（和大家一起快乐地生活）毫无兴趣的主人公改过自新成为“正经的男孩子”，经常做些无用功，并多管闲事。"},{"spoiler":false,"text":"暗中喜欢着主人公。"},{"spoiler":false,"text":"为了让主人公活得清正积极而努力，但有时会做得过头，变得把自己的理想强加在他人身上。"},{"spoiler":false,"text":"喜欢活动身体，擅长所有体育运动。行动先于思考的类型。"},{"spoiler":false,"text":"对妖怪和超常现象一概不相信的现实主义者。"},{"spoiler":false,"text":"「那群家伙的真面目，就由本大人来揭穿！」"}],"source":"bangumi","sourceCharacterId":"12821"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27796f4b3d6feed1e78046d6544c61e1f3c43b3237211e3535c42ea8b2462b78.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de29e96003ea5a2502a5f984bac8e049482e8d7b1da21616d03f55187538cc17.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12285:12821:5020:1","source":"bangumi"}]},{"characterId":"char_vndb_c43577","characterName":"パッくん","sourceIds":{"vndbCharacterId":"c43577"},"originalCharacterName":"パッくん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"Shikiko's carniverous plant she found at a garden store. It seems to want to eat humans and causes some trouble for the family. Later it even learns to walk making it even more dangerous to keep around."}],"source":"vndb","sourceCharacterId":"c43577"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de1762be22bf17ecde05ebdf6a22d517b590af4ded4e705350e036b910c2f7c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c46a12b3928a7460c4ba2f9b5d14877051deab0b484038b6f0b5baf5b6910a24.webp","width":256,"height":194,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1090","sourceCompanyId":"egs:brand:2901","canonicalEntityId":"vndb:p1090","name":"WHITESOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14113:2901","source":"egs"},{"companyId":"vndb:p1090","sourceCompanyId":"vndb:p1090","canonicalEntityId":"vndb:p1090","name":"Whitesoft","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10952:v4909","source":"vndb"},{"companyId":"vndb:p1090","sourceCompanyId":"vndb:p1090","canonicalEntityId":"vndb:p1090","name":"Whitesoft","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:13635:v4909","source":"vndb"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:169678:v4909","source":"vndb"},{"companyId":"vndb:p1090","sourceCompanyId":"vndb:p1090","canonicalEntityId":"vndb:p1090","name":"Whitesoft","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:169679:v4909","source":"vndb"},{"companyId":"vndb:p1090","sourceCompanyId":"vndb:p1090","canonicalEntityId":"vndb:p1090","name":"Whitesoft","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:170064:v4909","source":"vndb"},{"companyId":"vndb:p1090","sourceCompanyId":"vndb:p1090","canonicalEntityId":"vndb:p1090","name":"Whitesoft","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:63248:v4909","source":"vndb"},{"companyId":"vndb:p1090","sourceCompanyId":"vndb:p1090","canonicalEntityId":"vndb:p1090","name":"Whitesoft","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:69309:v4909","source":"vndb"},{"companyId":"vndb:p2263","sourceCompanyId":"vndb:p2263","canonicalEntityId":"vndb:p2263","name":"萌えAPP","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:69310:v4909","source":"vndb"},{"companyId":"vndb:p1090","sourceCompanyId":"vndb:p1090","canonicalEntityId":"vndb:p1090","name":"Whitesoft","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:69311:v4909","source":"vndb"},{"companyId":"vndb:p2263","sourceCompanyId":"vndb:p2263","canonicalEntityId":"vndb:p2263","name":"萌えAPP","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:69312:v4909","source":"vndb"},{"companyId":"vndb:p1090","sourceCompanyId":"vndb:p1090","canonicalEntityId":"vndb:p1090","name":"Whitesoft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:75248:v4909","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
