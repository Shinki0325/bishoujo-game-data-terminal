{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26018","model":{"presentationWorkId":"vndb:v22105","staff":{"artwork":[{"creditedName":"鷹乃ゆき(たかのゆき、朱音流架)","creatorId":"vndb:s685","sourcePersonId":"egs:creator:12946","canonicalEntityId":"vndb:s685","name":"鷹乃ゆき(たかのゆき、朱音流架)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:193180","source":"egs"},{"creditedName":"またたび丸。","creatorId":"vndb:s23598","sourcePersonId":"egs:creator:30524","canonicalEntityId":"vndb:s23598","name":"またたび丸。","detail":"SD原画","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:198712","source":"egs"}],"scenario":[{"creditedName":"近江谷宥","creatorId":"vndb:s4352","sourcePersonId":"egs:creator:20596","canonicalEntityId":"vndb:s4352","name":"近江谷宥","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:193179","source":"egs"}],"music":[],"other":[{"creditedName":"段林","creatorId":"egs:creator:19573","sourcePersonId":"egs:creator:19573","canonicalEntityId":"egs:creator:19573","name":"段林","detail":"WEB","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:198705","source":"egs"},{"creditedName":"CUBE(株式会社キューブ)","creatorId":"vndb:s2651","sourcePersonId":"egs:creator:4321","canonicalEntityId":"vndb:s2651","name":"CUBE(株式会社キューブ)","detail":"音声収録・キャスティング","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:198706","source":"egs"},{"creditedName":"eco*(えこ)","creatorId":"vndb:s1781","sourcePersonId":"egs:creator:4871","canonicalEntityId":"vndb:s1781","name":"eco*(えこ)","detail":"CG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:198707","source":"egs"},{"creditedName":"鳩崎亜紋","creatorId":"egs:creator:22207","sourcePersonId":"egs:creator:22207","canonicalEntityId":"egs:creator:22207","name":"鳩崎亜紋","detail":"インターフェイスデザイン","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:198708","source":"egs"},{"creditedName":"株式会社クリープ(cre-p)","creatorId":"vndb:s18796","sourcePersonId":"egs:creator:27621","canonicalEntityId":"vndb:s18796","name":"株式会社クリープ(cre-p)","detail":"背景","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:198709","source":"egs"},{"creditedName":"ほっしー","creatorId":"vndb:s2082","sourcePersonId":"egs:creator:13151","canonicalEntityId":"vndb:s2082","name":"ほっしー","detail":"ディレクター、スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:198710","source":"egs"},{"creditedName":"アラガー","creatorId":"vndb:s4578","sourcePersonId":"egs:creator:23406","canonicalEntityId":"vndb:s4578","name":"アラガー","detail":"プロデューサー、広報・営業","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:198711","source":"egs"},{"creditedName":"David Evelyn","creatorId":"vndb:s27805","sourcePersonId":"vndb:s27805","canonicalEntityId":"vndb:s27805","name":"David Evelyn","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:144919","source":"vndb"}]},"cast":[{"characterId":"char_c55100","characterName":"風魔 ゆら","sourceIds":{"bangumi":[{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["13251"],"vndbCharacterId":"c55100"},"originalCharacterName":"風魔 ゆら","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I, Fuuma Yura, in accordance to the contract hereby swear, to serve you, Lord Haruki!\""},{"spoiler":false,"text":"The elder of the Fuuma sisters. A demi cat."},{"spoiler":false,"text":"She walks the path of shinobi and swears loyalty to our hero. But she is absent minded and often foolish."},{"spoiler":false,"text":"An optimistic girl who doesn 't let failure and hardship put her down."},{"spoiler":false,"text":"Her weaknesses are her tail and headpats."},{"spoiler":false,"text":"Though she enjoys showing her master how capable she is, she is unable to resist a good coddling."},{"spoiler":false,"text":"A self-proclaimed martial master."},{"spoiler":false,"text":"Terrible at ninjutsu."},{"spoiler":false,"text":"From Sekai Project"}],"source":"vndb","sourceCharacterId":"c55100"},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた忍び姉妹の姉。"},{"spoiler":false,"text":"猫の亜人。"},{"spoiler":false,"text":"忍道を尊び、主人公に忠誠を誓っているが、天然で隙も多い。"},{"spoiler":false,"text":"失敗してもめげない、若干はた迷惑な前向きキャラ。"},{"spoiler":false,"text":"弱点は尻尾とナデナデ。"},{"spoiler":false,"text":"毅然としたところを見せて主様に褒めていただきたいと思いながらも、徹底できない甘えっ子。"},{"spoiler":false,"text":"自称・体術タイプの忍者で忍法は苦手。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に仕えている猫耳忍者。"},{"spoiler":false,"text":"年こそ若いがれっきとした風魔の上忍で、無類の頑張り屋さん（全て自称）。"},{"spoiler":false,"text":"押しかけ女房的に、現在は主人公の家で暮らしている。"},{"spoiler":false,"text":"主人公の忍びであることに誇りを感じていて、お役に立ちたくて仕方ない。"},{"spoiler":false,"text":"身辺警護的な意味でも主人公の傍を片時も離れたくないし、自慢の可愛さで癒やして差し上げたい。"},{"spoiler":false,"text":"要するに天下無双の甘えんぼ。"},{"spoiler":false,"text":"主人公がマヤを構う様子には忸怩たるものを感じているようで……？"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"体感的にはだいぶ前に主人公の元にやってきた風魔の猫耳忍者。"},{"spoiler":false,"text":"共通の障壁や困難はお互いの愛をますます堅固なものにする的なあれで、鋼鉄の忠誠心にも磨きがかかってきた（自称）。"},{"spoiler":false,"text":"一方で、里見勢とは相変わらずケンカばかり。"},{"spoiler":false,"text":"主人公への愛やご寵愛に関しては、誰にも譲れないのは相変わらず。"},{"spoiler":false,"text":"陽葵たちへの態度は、今のところ決めかねている様子。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた、猫忍姉妹のパワー担当。"},{"spoiler":false,"text":"馬鹿力と大雑把な性格は健在。"},{"spoiler":false,"text":"初めて北条家を訪れたあの日から、はや数年。"},{"spoiler":false,"text":"優しい主の元、平和な日々を謳歌している。"},{"spoiler":false,"text":"いまいち忍びとして働き場がないことについては、あまり考えないことにした模様。とはいえ、雑賀の動乱は気になるようで、「あるいはハルキ殿の天下の予感？」的な妄想したりしている。"},{"spoiler":false,"text":"相変わらずずっと、ハルキ殿のことが大好き。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"「在下風魔由良！遵從約定自今天起，為春希殿下獻上我的忠誠！」"},{"spoiler":false,"text":"來自風魔之里的忍者姊妹中的姊姊。貓咪型亞人。"},{"spoiler":false,"text":"推崇忍道，雖然對主人宣誓效忠，但是個性天然而渾身空隙。"},{"spoiler":false,"text":"遭遇失敗也不屈不撓，是個會稍微對週圍的人帶來困擾的樂觀角色。"},{"spoiler":false,"text":"弱點是尾巴還有摸摸。"},{"spoiler":false,"text":"雖然總是想著要讓主人看看自己的信念讓他誇獎，"},{"spoiler":false,"text":"但總是無法貫徹到底，是愛撒嬌的孩子。"},{"spoiler":false,"text":"自稱是擅長體術類型的忍者，對忍術不拿手。"}],"source":"bangumi","sourceCharacterId":"49095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae199390257854c04f3a65dd3f3e803596a9fd69ea57a27717d16b9c116b4f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/4672b4a46d6cf8ad1eb10c77a3e8f014bafebbcee701f8d1d3d47d02ef34c7c6.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230909:49095:7302:1","source":"bangumi"}]},{"characterId":"char_c55101","characterName":"風魔 たま","sourceIds":{"bangumi":[{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["13252"],"vndbCharacterId":"c55101"},"originalCharacterName":"風魔 たま","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Master, aren't you going to feed us?\""},{"spoiler":false,"text":"The younger of the Fuuma Sisters. A demi cat just like her sister."},{"spoiler":false,"text":"Compared to her (supposedly) serious sister, she has her head in the clouds. She doesn't treat our"},{"spoiler":false,"text":"hero like her master, and instead treats him like her brother. She incessantly begs for coddles."},{"spoiler":false,"text":"She is a poor academic, but a master of ninjutsu."},{"spoiler":false,"text":"She is able to use a wide array of Fuuma Ninjutsu despite her young age."},{"spoiler":false,"text":"She enjoys eating fluffy food."},{"spoiler":false,"text":"Very relaxed. Enjoys basking in the sun."},{"spoiler":false,"text":"From Sekai Project"}],"source":"vndb","sourceCharacterId":"c55101"},{"segments":[{"spoiler":false,"text":"姉のゆら同様、風魔の里からやってきた忍び姉妹の妹。"},{"spoiler":false,"text":"同じく猫の亜人。"},{"spoiler":false,"text":"（表向き）生真面目な姉と比べて、ふわふわと浮世離れした性格。"},{"spoiler":false,"text":"主人公のことも一応は主と見ているものの、完全にお兄ちゃん扱いで全身全霊で甘えてくる。"},{"spoiler":false,"text":"お勉強は苦手だが、忍術は大得意。"},{"spoiler":false,"text":"この若さで大半の風魔忍法を使いこなす。"},{"spoiler":false,"text":"好きな食べ物はふわふわしたもの。"},{"spoiler":false,"text":"基本的にのんびり屋で、ひなたぼっこと昼寝が幸せ。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"姉のゆらと一緒に主人公に仕えている猫耳忍者。"},{"spoiler":false,"text":"活発な姉と比べてだいぶマイペース。"},{"spoiler":false,"text":"相変わらず主人公のことは「おにいちゃん」呼びだが、大好きぶりはますます加速していて、毎日のように主人公の背中や膝を姉と取り合いしている。"},{"spoiler":false,"text":"最近はゴロ寝テレビの術(オリジナル)を習得して、ぐーたらぶりにも磨きがかかってきた。"},{"spoiler":false,"text":"特に子供向けアニメがお気に入り。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"ゆらと一緒に、主人公の家に押しかけてきた猫耳妹。"},{"spoiler":false,"text":"こう見えて風魔の上忍で、風魔忍法の全てを修めた天才……のはずなのだが、誰よりも猫らしい性格は相変わらずで、もはやぐーたらの域。"},{"spoiler":false,"text":"それはそれで手間がかからなくていいと主人公も静観している様子。"},{"spoiler":false,"text":"とはいえ、食べることと主人公のことは別。"},{"spoiler":false,"text":"主人公に仇なす悪い人が現れたりしたら本気出す。多分。"},{"spoiler":false,"text":"特に何もなければゴロ寝テレビの術で。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた、猫忍姉妹の術担当。"},{"spoiler":false,"text":"のんびりおおらかでちゃっかりした性格は、もはやどうにもなりようがない。"},{"spoiler":false,"text":"愛され上手の子猫ちゃん。"},{"spoiler":false,"text":"姉同様、平和な日々をのんびり楽しんでいる。"},{"spoiler":false,"text":"特に何ってほどのことはしていない。"},{"spoiler":false,"text":"雑賀の動乱に対しても、姉ほどは興味がない。"},{"spoiler":false,"text":"相変わらずマイペースで、変わらすにおにいちゃんのことが大好き。"},{"spoiler":false,"text":"みんなで一緒にいられればそれで幸せ。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"「主人，不是會給我們好吃的飯嗎？」"},{"spoiler":false,"text":"和姊姊由良一樣，是來自風魔之里的忍者姊妹中的妹妹。同樣是貓咪型亞人。"},{"spoiler":false,"text":"（表面上）和非常認真的姊姊相較之下，有著飄飄然不食人間煙火的個性。"},{"spoiler":false,"text":"雖然姑且把男主角當成主人，"},{"spoiler":false,"text":"卻完全把他當做哥哥看待，全心全意地對他撒嬌。"},{"spoiler":false,"text":"雖然對學習不大拿手，但是非常擅長忍術。如此年輕就能夠使用大半風魔相傳的忍術。"},{"spoiler":false,"text":"喜歡的食物是軟綿綿的東西。"},{"spoiler":false,"text":"基本上個性很悠閒，對於在日光的照耀下睡午覺感到幸福。"}],"source":"bangumi","sourceCharacterId":"49096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04fb5bad1c084997db4687dcb48cd1fb5bf05affbc64dcc6c91f199448c9574a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/331ba241520ab676eb9fd3b22cc0244680a8655d3e2a9dd04033b13c8104bb9e.webp","width":126,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230909:49096:8580:1","source":"bangumi"}]},{"characterId":"char_c55102","characterName":"彩羽","sourceIds":{"bangumi":[{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"269282"}],"egsCharacterIds":["13253","18485"],"vndbCharacterId":"c55102"},"originalCharacterName":"彩羽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I will just return everything to normal, so just take a breath, everything will come up with a time.\""},{"spoiler":false,"text":"Protagonist's childhood friend who attends the same school as him. Doesn't have any close friends besides the protagonist, behaves cold towards the others."}],"source":"vndb","sourceCharacterId":"c55102"},{"segments":[{"spoiler":false,"text":"主人公と同じ学園に通う同級生だが、鈴木　彩は世を忍ぶ仮の姿。"},{"spoiler":false,"text":"いくつもの忍びの里を出自とする忍者によって構成されている組織において、作戦を指揮する立場にある。"},{"spoiler":false,"text":"主人公が通う学園に先月引っ越してきて、今日に至るまで周辺を調査していたようだが主人公本人は気付いていない。"},{"spoiler":false,"text":"学園ではクールキャラを通しており、親しい友人はいない。"}],"source":"egs","sourceCharacterId":"13253","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と仲間達のお目付け役的な存在。"},{"spoiler":false,"text":"風魔の里に動きがあることを察知し、主(あるじ)格である主人公の元に派遣されてきた。"},{"spoiler":false,"text":"忍び、特に抜け忍が起こす事件の警戒・対応が主な仕事と言っているが、素性はもちろん、所属している組織についてもはっきりとは語っていない。"},{"spoiler":false,"text":"相変わらずクールキャラを貫いているが、ゆらたまのわんぱくぶりに怒りマークを浮かべていることも稀によくある。"},{"spoiler":false,"text":"現在は謎の猫忍者の対応に追われている。"}],"source":"egs","sourceCharacterId":"18485","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"お目付け役も板についてきたクールビューティ。"},{"spoiler":false,"text":"主人公たちとの付き合いも長くなってきたものの、馴れ合う様子は微塵もなく、猫忍たちにニャーニャー威嚇されてもどこ吹く風。"},{"spoiler":false,"text":"所属や素性なども相変わらず謎のまま……でここまできたが、陽葵の巻き添えを食らう形で色々バレそう。"},{"spoiler":false,"text":"最近、ついに漢方系の胃腸薬に手を出した。胃を元気にしたい系女子。"}],"source":"egs","sourceCharacterId":"18485","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"「只不過是回到原本的生活唷。只要一個呼吸之間，我就能解決一切」"},{"spoiler":false,"text":"和男主角同一個學校的同年級學生，以鈴木彩這個身份當做偽裝。"},{"spoiler":false,"text":"和數名同樣是來出身自忍者之里的忍者一同組成組織，"},{"spoiler":false,"text":"並且立於指揮作戰的立場。"},{"spoiler":false,"text":"在男主角進到這所學校前一個月搬過來，"},{"spoiler":false,"text":"似乎至今為止都在調查這周邊一帶，不過男主角完全沒有察覺。"},{"spoiler":false,"text":"在學校裡頭是個帥氣的角色，沒有親暱的友人。"}],"source":"bangumi","sourceCharacterId":"49097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8b466657b40ef62654d79e6f1ca2b12c878f041384c1db0f6891f4abfaad1fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0fab56ffa2fcea14668c779c66f2d7a12080998c7332b3e1f7997a2169861e0.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230909:49097:5928:1","source":"bangumi"}]},{"characterId":"char_c55103","characterName":"なち","sourceIds":{"bangumi":[{"characterId":"49098","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49098","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49098","match":"exact-normalized-name-in-linked-work","subjectId":"269282"}],"egsCharacterIds":["13254"],"vndbCharacterId":"c55103"},"originalCharacterName":"なち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"What will you do, then? If you have a plan you will surprise me a bit.\""},{"spoiler":false,"text":"A shinobi who serves Saiha."},{"spoiler":false,"text":"A runaway from the Fuuma clan that arbitrarily made Saiha her Master after she saved her from starving. Born as a Fuuma and originally also as Haruki's bodyguard, she has some lingering affection for him that she tries to hide."},{"spoiler":false,"text":"Treated as an Idol by the rest of the Fuuma clan for sending money to them regularly."}],"source":"vndb","sourceCharacterId":"c55103"},{"segments":[{"spoiler":false,"text":"彩羽に仕える忍び。"},{"spoiler":false,"text":"彼女に仕える忍びを総括する四天王の筆頭であり、その実力には信を置かれている様子。"},{"spoiler":false,"text":"男勝りで、がさつなところもあるが面倒見がいい一面も？"},{"spoiler":false,"text":"本人は隠しているつもりでいるが、猫ちゃん好きとして仲間には広く知られている。"},{"spoiler":false,"text":"主人公に仕える風魔の猫忍者二匹が気になる様子。"}],"source":"egs","sourceCharacterId":"13254","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"風魔の里出身の忍びで、ゆらたまの実姉でもある。"},{"spoiler":false,"text":"里の逼迫した財布事情を支えるために妹達よりひと足早く里を出たが、耳を隠してのアルバイトは思うようにいかず、行き倒れかけていたところを彩羽に拾われた。"},{"spoiler":false,"text":"恩義もあって忍びとして彩羽に臣従を誓っている身だが、本来の主であった主人公や可愛い妹達のことは気になる様子。"},{"spoiler":false,"text":"ぶっきらぼうを装いながら、家や学園にもマメに顔を出す。"}],"source":"egs","sourceCharacterId":"13254","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"（主にゆらに）彩羽の元を離れるように言われて一悶着あったが、今は里と決別する形で彩羽の元に身を寄せている。"},{"spoiler":false,"text":"妹たちも自分の決断を尊重してくれていると思っているが、そんなことはない。"},{"spoiler":false,"text":"どこの世界も姉は大変。"},{"spoiler":false,"text":"彩羽が寝てる間に足つぼマッサージをしてあげるのが最近の日課。"}],"source":"egs","sourceCharacterId":"13254","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"「該怎麼做？如果下命令的話我就稍微去吓吓他們」"},{"spoiler":false,"text":"侍奉彩羽的忍者。"},{"spoiler":false,"text":"是侍奉她的忍者中，統領眾人的四天王的首領，"},{"spoiler":false,"text":"她的實力不容質疑。"},{"spoiler":false,"text":"比男性還能幹，雖然細心過頭了，不過也有擅於照顧人的一面？"},{"spoiler":false,"text":"雖然本人想要隱藏起來，"},{"spoiler":false,"text":"不過同伴們卻都知道她喜歡小貓咪。"},{"spoiler":false,"text":"似乎相當在意侍奉著男主角的兩隻風魔的貓忍者。"}],"source":"bangumi","sourceCharacterId":"49098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42276e283de1e5bf0d5067838baddd50ef2abb205158047b436605e8aaecad08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2da484f57e567094512dd38c56d54bfeabc73991534ebef995e2f8c047048928.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230909:49098:15637:1","source":"bangumi"}]},{"characterId":"char_c82427","characterName":"北条 春希","sourceIds":{"bangumi":[{"characterId":"179913","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["28198"],"vndbCharacterId":"c82427"},"originalCharacterName":"北条 春希","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦国時代からこっそり続いている名門・北条家の一応は当主。"},{"spoiler":false,"text":"両親については謎に包まれている。"},{"spoiler":false,"text":"前章『猫忍えくすはーと』では風魔の里からやってきた、ゆらたまを受け入れ、様々な体験をふまえて立派に成長した（多分）。"},{"spoiler":false,"text":"現在は地元の大学に通いながら、北条の長としての今後に向けた準備を進めている。"},{"spoiler":false,"text":"新章主人公・菊丸達よりほんのちょっと年上。"},{"spoiler":false,"text":"性格は温厚で、ゆらたま達との関係も相変わらず。"},{"spoiler":false,"text":"みんなのことが大好き。"}],"source":"egs","sourceCharacterId":"28198","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"戦国時代からこっそり続いている名門・北条家の一応は当主。"},{"spoiler":false,"text":"両親については謎に包まれている。"},{"spoiler":false,"text":"前章『猫忍えくすはーと』では風魔の里からやってきた、ゆらたまを受け入れ、"},{"spoiler":false,"text":"様々な体験をふまえて立派に成長した（多分）。"},{"spoiler":false,"text":"現在は地元の大学に通いながら、北条の長としての今後に向けた準備を進めている。"},{"spoiler":false,"text":"新章主人公・菊丸達よりほんのちょっと年上。"},{"spoiler":false,"text":"性格は温厚で、ゆらたま達との関係も相変わらず。"},{"spoiler":false,"text":"みんなのことが大好き。"}],"source":"bangumi","sourceCharacterId":"179913"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"179913","value":"北条家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5bce00666776a6c57326d52abf89d99959320c31917c4a5a66ace057fc61d44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cf8d85c08826422242ba357342514d246fb3c243716df572b33316de38bded9.webp","width":236,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p273","sourceCompanyId":"egs:brand:1888","canonicalEntityId":"vndb:p273","name":"Whirlpool","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26018:1888","source":"egs"},{"companyId":"vndb:p9059","sourceCompanyId":"vndb:p9059","canonicalEntityId":"vndb:p9059","name":"MinoriTeam","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:128971:v22105","source":"vndb"},{"companyId":"vndb:p9059","sourceCompanyId":"vndb:p9059","canonicalEntityId":"vndb:p9059","name":"MinoriTeam","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:129245:v22105","source":"vndb"},{"companyId":"vndb:p9059","sourceCompanyId":"vndb