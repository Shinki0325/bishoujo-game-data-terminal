,{"spoiler":false,"text":"普段はあまり表に出さないが、やっぱり息子を溺愛している。"},{"spoiler":false,"text":"また、成長するにつれて優斗に少しずつ似てきた息子に、密かにときめく。"},{"spoiler":false,"text":"「もう、優希ったら、しかたない子ね……　？　こんなに、あまえんぼだったかしら？」"}],"source":"egs","sourceCharacterId":"15068","sourceWorkId":"12703","spoiler":false},{"segments":[{"spoiler":false,"text":"優希のママで、みいなの双子の姉。キリッとした美女で爆乳ボディの持ち主。"},{"spoiler":false,"text":"学生時代にグラビアで みいなと共にHな水着姿を披露していたが、やがて旦那と結婚して引退。"},{"spoiler":false,"text":"それから優希を産んで数年後、旦那は事故で故人になってしまう。以来、グラビア経験を生かし、グラビア誌の編集として働いている。"},{"spoiler":false,"text":"甘える優希に、いけないと思いつつ、つい流されてしまう 『艶母』。"},{"spoiler":false,"text":"「もう、優希ったら、しかたのない子ね…こんなに、あまえんぼだったかしら？」"}],"source":"bangumi","sourceCharacterId":"49877"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"49877","value":"グラビア誌の編集者"},{"label":"胸围（本版本）","value":"106 cm","valueContext":null,"source":"egs","sourceCharacterId":"15068","sourceWorkId":"12703","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"l","valueContext":null,"source":"egs","sourceCharacterId":"15068","sourceWorkId":"12703","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"15068","sourceWorkId":"12703","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"15068","sourceWorkId":"12703","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"15068","sourceWorkId":"12703","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/063b733b84f0247318a1d77a3c287307648fce51e0406181296a376a489789cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ee3dfc479cf5a99b6f69f008b20779fb72f29d8fc015417703d5918a2810fa1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creat