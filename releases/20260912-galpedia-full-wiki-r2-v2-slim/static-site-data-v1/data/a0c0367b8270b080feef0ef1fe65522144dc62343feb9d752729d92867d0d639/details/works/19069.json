match":"source-roster","subjectId":"31191"}]},"originalCharacterName":"Kilbert Hanees","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"180"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"78"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セラ島冒険者ギルドに所属する有名冒険者。背中にはフラガラッハという名の大剣を背負っている。冒険者界隈ではキルベルト・サーガなる彼の武勇伝が広がっているが、噂の真偽は定かではない。"},{"spoiler":false,"text":"街の外へ採取に行く際の護衛役を探していたアニーと出会い、仲間に加わる。"}],"source":"bangumi","sourceCharacterId":"192833"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec6db3d8a36cb053900e831c2c4c3ee850b662efc6c054e28e789f7d13e212dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec4b602e5bc9223b02c223f6dc89d4b1ffd30eb8341f6081c9de75472d6d84d6.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小杉十郎太","creatorId":"vndb:s743","sourcePersonId":"vndb:s743","canonicalEntityId":"vndb:s743","name":"小杉 十郎太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:31191:192833:4302:1","source":"bangumi"}]},{"characterId":"char_bangumi_192835","characterName":"Jalia Kraut","sourceIds":{"bangumi":[{"characterId":"192835","match":"source-roster","subjectId":"31191"}]},"originalCharacterName":"Jalia Kraut","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"168"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"リゾート開発中のセラ島の治安を維持するために、王国本土から派遣された騎士団所属の女騎士。槍術の天才とまで称されているが、いつもへらへらして天然ボケを炸裂させているため、まったく強そうに見えない。騎士としての自覚がまったくなく、いつも仕事をサボって騎士団長に追いかけ回されている。"},{"spoiler":false,"text":"アニーが街の外に採取に行く際のボディーガードを探していたときに出会い、彼女がその役を引き受ける。"}],"source":"bangumi","sourceCharacterId":"192835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/600ab0f4b2c51c97985f5c475bd7dc7c2f7c4152b9db77896ee26842d8c1f1b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c526ad615d6d7c0e98e287fd38ea4ebbbb996307659e04c97c8110a03e293cf9.webp","width":142,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あきやまかおる","creatorId":"vndb:s18137","sourcePersonId":"vndb:s18137","canonicalEntityId":"vndb:s18137","name":"あきやま かおる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:31191:192835:27871:1","source":"bangumi"}]},{"characterId":"char_bangumi_192837","characterName":"Kyle Yugrald","sourceIds":{"bangumi":[{"characterId":"192837","match":"source-roster","subjectId":"31191"}]},"originalCharacterName":"Kyle Yugrald","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"184"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"69"}},"descriptions":[{"segments":[{"spoiler":false,"text":"機械文明が発達した異国の機械士で、セラ島に機械文明を布教すべくやってきた。美形でモデル体型だが、中身はおそろしく三枚目で無駄にハイテンションなことから、アニーには若干煙たがられている。"},{"spoiler":false,"text":"本人曰く、リゾート開発に貢献するための様々な機械を発明しているらしいが、そのほとんどは失敗作で、常にアニーを巻き込んではトラブルを起こしている。"}],"source":"bangumi","sourceCharacterId":"192837"}],"profileFacts":[],"metadataCandidateC