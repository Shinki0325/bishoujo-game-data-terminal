5479","sourcePersonId":"vndb:s5479","canonicalEntityId":"vndb:s5479","name":"ごぉ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125654","source":"vndb"},{"creditedName":"山川 竜一郎","creatorId":"vndb:s6198","sourcePersonId":"vndb:s6198","canonicalEntityId":"vndb:s6198","name":"山川 竜一郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125655","source":"vndb"},{"creditedName":"KOMEWORKS","creatorId":"vndb:s8736","sourcePersonId":"vndb:s8736","canonicalEntityId":"vndb:s8736","name":"KOMEWORKS","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125656","source":"vndb"},{"creditedName":"kur","creatorId":"vndb:s9509","sourcePersonId":"vndb:s9509","canonicalEntityId":"vndb:s9509","name":"kur","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:125657","source":"vndb"}]},"cast":[{"characterId":"char_c40661","characterName":"御原 凛音","sourceIds":{"bangumi":[{"characterId":"37703","match":"exact-normalized-name-in-linked-work","subjectId":"150191"}],"egsCharacterIds":["8026"],"vndbCharacterId":"c40661"},"originalCharacterName":"御原 凛音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"229"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is one of the daughters of the three families. She is a recluse who lives a nocturnal lifestyle, and goes out of the house only at night. While blunt and curt to a fault, she romantically considers herself a \"princess.\" Five years ago, she was taken away by spirits, and she has never told anyone. What does she know about Setsuna?"},{"spoiler":false,"text":"From Anime News Network"}],"source":"vndb","sourceCharacterId":"c40661"},{"segments":[{"spoiler":false,"text":"“浦島御三家”の一つ、御原家の跡取り娘。"},{"spoiler":false,"text":"引きこもりで昼夜逆転生活を続けており、昼間は頑なに外に出ようとしない。"},{"spoiler":false,"text":"趣味は深夜の散歩。"},{"spoiler":false,"text":"人物を紹介する時に年齢を付け加える癖がある。"},{"spoiler":false,"text":"ぶっきらぼうで冷淡なところがあるかと思えば、一方で、自らを『お姫様』と称する夢見がちな側面も。"},{"spoiler":false,"text":"不審人物であるはずの主人公・切那に衣食住や仕事、そして名前を与え、執拗に絡んできたり嫉妬の表情を見せてくる。"},{"spoiler":false,"text":"切那について何か知っているのは間違いないが、頑なに口を割ろうとしない。"},{"spoiler":false,"text":"同じ島の住人にとっても謎の多い人物。"},{"spoiler":false,"text":"５年ほど前に神隠しに遭ったと噂されているが、その詳細を語ろうとする者はいない。"},{"spoiler":false,"text":"一部には、本当に御原家の血を引いているのかと疑う島人もいる。"}],"source":"egs","sourceCharacterId":"8026","sourceWorkId":"22723","spoiler":false},{"segments":[{"spoiler":false,"text":"“浦島御三家” の一つ・御原家の跡取り娘。"},{"spoiler":false,"text":"引きこもりで昼夜逆転生活を続けており、昼間は頑なに外に出ようとしない。"},{"spoiler":false,"text":"趣味は深夜の散歩。 人物を紹介する時に年齢を付け加える癖がある。"},{"spoiler":false,"text":"ぶっきらぼうで冷淡なところがあるかと思えば、自らを “お姫様” と称する夢見がちな側面も。"},{"spoiler":false,"text":"不審人物であるはずの主人公・切那に衣食住や仕事、そして名前を与え、執拗に絡んだり嫉妬の表情を見せたりしてくる。"},{"spoiler":false,"text":"彼について何か知っているのは間違いないが、頑なに口を割ろうとしない。"},{"spoiler":false,"text":"同じ島の住人にとっても謎の多い人物。"},{"spoiler":false,"text":"5年ほど前に神隠しに遭ったと噂されているが、その詳細を語ろうとする者はいない。"},{"spoiler":false,"text":"一部には、本当に御原家の血を引いているのかと疑う島人もいる。"},{"spoiler":false,"text":"「だって―― わたしもタイムトラベラーだから」"}],"source":"bangumi","sourceCharacterId":"37703"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcce21def29e5384ae02cdd74465f5303654b63bfdc9ed93bc4ded8216994351.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/468aebea45d224085d3f1f747f556110340c32fa22139e321ac987685911bd2c.webp","width":173,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150191:37703:3965:1","source":"bangumi"}]},{"characterId":"char_c40662","characterName":"伽藍堂 紗羅","sourceIds":{"bangumi":[{"characterId":"37704","match":"exact-normalized-name-in-linked-work","subjectId":"150191"}],"egsCharacterIds":["8027"],"vndbCharacterId":"c40662"},"originalCharacterName":"伽藍堂 紗羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"16"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"824"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Urajima Shrine's sole miko. She has a great fascination with curses and supernatural powers, and has never really stopped believing in unscientific powers. She claims to have a connection with another time traveler from the future. She is the island's enthusiastic believer and little idol. Ever since she lost her parents in the fire five years ago, she has lived in a prefab cabin on the island."},{"spoiler":false,"text":"From Anime News Network"}],"source":"vndb","sourceCharacterId":"c40662"},{"segments":[{"spoiler":false,"text":"“浦島御三家”の一つ、伽藍堂家の跡継ぎ。"},{"spoiler":false,"text":"浦島神社の巫女。"},{"spoiler":false,"text":"主人公・切那のことを何かと目の敵にし命を狙ってくる。"},{"spoiler":false,"text":"呪術や超能力に傾倒しており、非科学的な力の存在を信じてやまない。"},{"spoiler":false,"text":"その理由は彼女が口にする『もう一人の未来人』と関係がある。"},{"spoiler":false,"text":"島人の間では非常識な言動で有名で、生暖かい目で見守られているが、一部には熱狂的な信者も存在する、島の小さなアイドル。"},{"spoiler":false,"text":"５年前の火事で両親を失っており、現在は境内に建てられたプレハブ小屋で一人暮しをしている。"},{"spoiler":false,"text":"両親は何らかの事件に巻き込まれて殺されたのではないかと疑っており、真相を探る中で自らの「宿命」の本当の意味に気付いていく。"}],"source":"egs","sourceCharacterId":"8027","sourceWorkId":"22723","spoiler":false},{"segments":[{"spoiler":false,"text":"“浦島御三家” の一つ・伽藍堂家の跡継ぎ。 浦島神社の巫女。"},{"spoiler":false,"text":"切那のことを何かと目の敵にし、命を狙ってくる。"},{"spoiler":false,"text":"呪術や超能力に傾倒しており、非科学的な力の存在を信じてやまない。"},{"spoiler":false,"text":"その理由は彼女が口にする “もう一人の未来人” と関係がある。"},{"spoiler":false,"text":"島人の間では非常識な言動で有名で、生暖かい目で見守られているが、一部には熱狂的な信者も存在する、島の小さなアイドル。"},{"spoiler":false,"text":"5年前の火事で両親を失っており、現在は境内に建てられたプレハブ小屋で一人暮しをしている。"},{"spoiler":false,"text":"両親は何らかの事件に巻き込まれて殺されたのではないかと疑っており、真相を探る中で自らの “宿命” の本当の意味に気付いていく。"},{"spoiler":false,"text":"「私は―― この島を救う宿命を負う者です」"}],"source":"bangumi","sourceCharacterId":"37704"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/780ae266230343d19378225b7bc2ac56182b9dc5c04155e66e38392b15f9a26f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b513a886d2283cebb52d6f9ea55a0559e103aba172b7b36ce5d08d07539c0df1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"村川梨衣","creatorId":"vndb:s7858","sourcePersonId":"vndb:s7858","canonicalEntityId":"vndb:s7858","name":"村川梨衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150191:37704:9096:1","source":"bangumi"}]},{"characterId":"char_c40663","characterName":"枢都 夏蓮","sourceIds":{"bangumi":[{"characterId":"37705","match":"exact-normalized-name-in-linked-work","subjectId":"150191"}],"egsCharacterIds":["8028"],"vndbCharacterId":"c40663"},"originalCharacterName":"枢都 夏蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"17"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1005"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the daughter of the town mayor. Her manners and speech are both rough, and she carries a knife with her everywhere she goes. She is right in the middle of her rebellious phase. She is a girl of common sense among the islanders, and a late bloomer in matters of love. Five years ago, her mother abandoned her family and the island and crossed to the mainland. She has always admired her mother, and she herself dreams of escaping the island to the mainland."},{"spoiler":false,"text":"From Anime News Network"}],"source":"vndb","sourceCharacterId":"c40663"},{"segments":[{"spoiler":false,"text":"“浦島御三家”の一つ、枢都家の長女。"},{"spoiler":false,"text":"島の町長の娘。"},{"spoiler":false,"text":"男勝りな口調で、常にナイフを所持しているなど、未だに反抗期のまっただ中。"},{"spoiler":false,"text":"その実、恋愛ごとに関しては奥手で、よく主人公・切那に弄られる。"},{"spoiler":false,"text":"勉強は出来ないが、島の人間の中ではかなりの常識人で情に厚い。"},{"spoiler":false,"text":"その家柄や人柄から玉の輿を狙う島の男は多いが、本人は、家出をして本土に行くという夢に向かって邁進中。"},{"spoiler":false,"text":"切那のことを本土の人間だと信じており、興味を寄せてくる。"},{"spoiler":false,"text":"５年前に家族を捨てて島を去った母親に憧れており、母の背中を追いかける過程で、その背中の大きさに気付いていく。"}],"source":"egs","sourceCharacterId":"8028","sourceWorkId":"22723","spoiler":false},{"segments":[{"spoiler":false,"text":"“浦島御三家” の一つ・枢都家の長女。 島の町長の娘。"},{"spoiler":false,"text":"男勝りな口調で、常にナイフを所持しているなど、未だに反抗期のまっただ中。"},{"spoiler":false,"text":"しかし恋愛ごとに関しては奥手で、よく切那にいじられる。"},{"spoiler":false,"text":"勉強はできないが、島の人間の中ではかなりの常識人で情に厚い。"},{"spoiler":false,"text":"その家柄や人柄から玉の輿を狙う島の男は多いが、本人は家出をして本土に行くという夢に向かって邁進中。"},{"spoiler":false,"text":"切那のことを本土の人間だと信じており、興味を寄せてくる。"},{"spoiler":false,"text":"5年前に家族を捨てて島を去った母親に憧れており、母の背中を追いかける過程で、その背中の大きさに気付いていく。"},{"spoiler":false,"text":"「あたしは―― ぜってーこの島を出てってやる！」"}],"source":"bangumi","sourceCharacterId":"37705"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f79537ad637a1d471bd12ef999e314ecdd00dfadde23e83f8a05212a5c291208.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ecf17d9ec1c9bc1d451550046693b6179039fda3bbcbf08e412002526beb132.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿澄佳奈","creatorId":"vndb:s1189","sourcePersonId":"vndb:s1189","canonicalEntityId":"vndb:s1189","name":"阿澄 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150191:37705:4868:1","source":"bangumi"}]},{"characterId":"char_c40664","characterName":"三千界 切那","sourceIds":{"bangumi":[{"characterId":"37706","match":"exact-normalized-name-in-linked-work","subjectId":"150191"}],"egsCharacterIds":["8025"],"vndbCharacterId":"c40664"},"originalCharacterName":"三千界 切那","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a young man who washed up naked on the sandy beaches of the island. He was rescued by Rinne and begins living in the employ of the Ohara family as their servant. He claims to come from the future to save the world, but cannot even remember who gave him the mission. With a mysterious confidence and optimism, he continues to smash every tradition on the island."},{"spoiler":false,"text":"From Anime News Network"}],"source":"vndb","sourceCharacterId":"c40664"},{"segments":[{"spoiler":false,"text":"この物語の主人公。"},{"spoiler":false,"text":"全裸で島の砂浜に打ち上げられていた謎の青年。"},{"spoiler":false,"text":"御原凛音に助けられ、住み込みの使用人として働き始める。"},{"spoiler":false,"text":"世界を救うという使命を背負い未来から来たのだと主張する。"},{"spoiler":false,"text":"使命を果たすためには元凶となる人物を殺さなくてはいけないのだが、肝心の名前をどうしても思い出せない。"},{"spoiler":false,"text":"それどころか自分がどこの誰なのかすらも覚えていないが、あまり深くは考えない脳天気な楽天家。"},{"spoiler":false,"text":"ぶっちゃけ、ただの不審者。"},{"spoiler":false,"text":"奇天烈な言動で閉鎖的な島の雰囲気にマシンガンのごとく風穴を開けていく。"}],"source":"egs","sourceCharacterId":"8025","sourceWorkId":"22723","spoiler":false},{"segments":[{"spoiler":false,"text":"この物語の主人公。 全裸で島の砂浜に打ち上げられていた謎の青年。"},{"spoiler":false,"text":"御原凛音に助けられ、住み込みの使用人として働き始める。"},{"spoiler":false,"text":"世界を救うという使命を背負い未来から来たのだと主張する。"},{"spoiler":false,"text":"使命を果たすためには元凶となる人物を殺さなくてはいけないのだが、肝心の名前をどうしても思い出せない。"},{"spoiler":false,"text":"それどころか自分が誰なのかすらも覚えていないが、あまり深くは考えない脳天気な楽天家。"},{"spoiler":false,"text":"ぶっちゃけ、ただの不審者。"},{"spoiler":false,"text":"奇天烈な言動で閉鎖的な島の雰囲気にマシンガンのごとく風穴を開けていく。"},{"spoiler":false,"text":"「そんな歴史は、こんな世界はぶっ壊してやるッ!!」"}],"source":"bangumi","sourceCharacterId":"37706"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a7d6d21f54eba5970ae7ce7ee0a2b87884dd5019e07bc4176a5b9b734ec287f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab5691a49c7fa405fb0d9fd0f2db6e654eda5b2f9d15a38e635e006092aaa2a2.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c136897","characterName":"ネハン・オハラ","sourceIds":{"vndbCharacterId":"c136897"},"originalCharacterName":"ネハン・オハラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A stubborn old man with white hair. He is Rinné's grandfather. He was initially vehemently opposed to having Setsuna live with them."}],"source":"vndb","sourceCharacterId":"c136897"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63917656a79a94700f2f6467f0c2646a2454b7f29c1cd4d40a46a54afac3f1d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa1043c853b68d3dc8f24e0ad16da2ad269e80ed4a8e242e04080a9d5dc5ad8d.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"楠見 尚己","creatorId":"vndb:s5991","sourcePersonId":"vndb:s5991","canonicalEntityId":"vndb:s5991","name":"楠見 尚己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66989","source":"vndb"}]},{"characterId":"char_vndb_c148575","characterName":"有馬 雨蘭","sourceIds":{"vndbCharacterId"