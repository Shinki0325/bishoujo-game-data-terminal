ndb","sourceCharacterId":"c8632"},{"segments":[{"spoiler":false,"text":"主人公の母親。"},{"spoiler":false,"text":"夫を亡くしてから、女手ひとつで主人公と木葉を育ててきた。"},{"spoiler":false,"text":"性格は、優しく穏やかで、理想の母親になろうと努力しているが、依頼心が強いため、息子である主人公に甘えてしまうこともしばしば。"},{"spoiler":false,"text":"今後を考え、辰雄と再婚したが、主人公と辰雄の溝は深まるばかりで、再婚はするべきではなかったと後悔し始めているが……。"}],"source":"egs","sourceCharacterId":"17318","sourceWorkId":"11224","spoiler":false},{"segments":[{"spoiler":false,"text":"隆也の母親。"},{"spoiler":false,"text":"夫を亡くし、以来一人で隆也と木葉を育ててきた。"},{"spoiler":false,"text":"今後の生活のことを考えて辰雄と再婚したが、隆也と辰雄の間の溝は深まるばかりなため、再婚はするべきではなかったのか……と後悔し始めている。"},{"spoiler":false,"text":"優しく穏やかな性格で、理想の母親になろうと頑張っているが、本来は甘えん坊なところがあるため、気を抜くとそういう部分がうっかり出てしまうことがある。"}],"source":"bangumi","sourceCharacterId":"143313"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f989390e6a474b535090df1445f60459221cd29873764af8d764fdabe9272e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e72e3e0bf110f518508a0881799a66e9a185f8cd731f86be32a46642ea0da45.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269967:143313:4918:1","source":"bangumi"}]},{"characterId":"char_c8634","characterName":"一条 木葉","sourceIds":{"bangumi":[{"characterId":"143314","match":"exact-normalized-name-in-linked-work","subjectId":"269967"}],"egsCharacterIds":["17319"],"vndbCharacterId":"c8634"},"originalCharacterName":"一条 木葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryuya's sister. He confesses to her at the start of the game but she tells him it's wrong for siblings to be in love."}],"source":"vndb","sourceCharacterId":"c8634"},{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"温厚で優しい性格は母親譲り。"},{"spoiler":false,"text":"また、責任感が強く、頑張り屋さん。"},{"spoiler":false,"text":"一見、おとなしそうだが頑固な一面も。"},{"spoiler":false,"text":"主人公に兄としてではなく異性として行為を抱いているが、常識人である彼女は、そうした想いを封印しているようだが……。"}],"source":"egs","sourceCharacterId":"17319","sourceWorkId":"11224","spoiler":false},{"segments":[{"spoiler":false,"text":"隆也の妹。"},{"spoiler":false,"text":"隆也に恋心を抱いているが、倫理が邪魔をしているため、自分の気持ちを伝えることができずにいる。"},{"spoiler":false,"text":"母親譲りの性格で、責任感が強い頑張り屋。一見控えめで大人しそうな印象だが、譲れない一線などはきちんと主張する強さも持っている"}],"source":"bangumi","sourceCharacterId":"143314"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91841a695a80f7af76668cfe513479d08fd10d64fe87218938979796acb78f1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03ea3452a3909cc91508f1201a7470ba9a0c2aaee21ad14abcfdb17ee82d4334.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269967:143314:6045:1","source":"bangumi"}]},{"characterId":"char_c8668","characterName":"天城 ルイ","sourceIds":{"bangumi":[{"characterId":"143315","match":"exact-normalized-name-in-linked-work","subjectId":"269967"}],"egsCharacterIds":["17321"],"vndbCharacterId":"c8668"},"originalCharacterName":"天城 ルイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":