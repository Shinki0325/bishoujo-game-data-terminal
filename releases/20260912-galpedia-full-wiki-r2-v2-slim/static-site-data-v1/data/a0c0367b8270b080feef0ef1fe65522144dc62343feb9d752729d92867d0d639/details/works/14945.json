db","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"昴の妹で永遠の双子の姉。"},{"spoiler":false,"text":"身体を動かすことが大好きな元気娘。"},{"spoiler":false,"text":"水泳部のエースで現在大会に向けて猛練習中。"},{"spoiler":false,"text":"前を見ずに突っ走ることも度々あり、その際には妹の永遠がフォローをすることもしばしば。"},{"spoiler":false,"text":"妹の永遠と比べて胸が小さいことがコンプレックスでもあり、あまり女の子っぽくないのでは？　というのが悩みの種。"},{"spoiler":false,"text":"明るい反面考え込みすぎて落ち込むときはとことんダウンしてしまう。"},{"spoiler":false,"text":"お兄ちゃんのことは幼いころから大好き。"}],"source":"egs","sourceCharacterId":"10537","sourceWorkId":"14945","spoiler":false},{"segments":[{"spoiler":false,"text":"昴の妹で、永遠の双子の姉。身体を動かすことが大好きな元気娘。"},{"spoiler":false,"text":"水泳部のエースで現在大会に向けて猛練習中。"},{"spoiler":false,"text":"前を見ずに突っ走ることも度々あり、その際には永遠がフォローをすることもしばしば。"},{"spoiler":false,"text":"妹の永遠と比べて胸が小さいことがコンプレックスであり、あまり女の子っぽくないのでは（？） というのが悩みの種。"},{"spoiler":false,"text":"明るい反面、考え過ぎて落ち込む時はとことんダウンしてしまう。"},{"spoiler":false,"text":"お兄ちゃんのことは幼い頃から大好き。"},{"spoiler":false,"text":"「おにぃ、今日も部活の練習見てくれる？　ほんと？ やった♪　じゃあ17：00にプールで待ってるからね。絶対、ずえぇっ～～ったいに忘れちゃダメだからね!!」"}],"source":"bangumi","sourceCharacterId":"53404"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"53404","value":"双子座"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d0ca7613e779d9819435e854341d4113b7a3a05995c8178c8e28fa5bb57ac3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb325e20218decf36ad0c9ec15b570158129aff09c15a93c5ddafad9a57ae988.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河原木志穂","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:184383:53404:4422:1","source":"bangumi"}]},{"characterId":"char_c27247","characterName":"春夏秋冬 永遠","sourceIds":{"bangumi":[{"characterId":"53405","match":"exact-normalized-name-in-linked-work","subjectId":"184383"}],"egsCharacterIds":["10538"],"vndbCharacterId":"c27247"},"originalCharacterName":"春夏秋冬 永遠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"621"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"昴の妹で遥の双子の妹。"},{"spoiler":false,"text":"わが道を行くをもっとーに日々マイペース。"},{"spoiler":false,"text":"ただ、ここぞというときの行動力は遥よりもあったり。"},{"spoiler":false,"text":"昔体が弱かった影響からか今も図書館で読書するのが好きで、先生からも鍵を預かり実質図書館の主になっている。"},{"spoiler":false,"text":"猫かぶりをしているわけではないが、はた目からは遥との対比もありおとなしい美少女という印象から、毎年恒例の蓮花台学園新入生女子ランキングで堂々の1位を獲得した。"},{"spoiler":false,"text":"（本人は知らないけど、なぜか遥はそのランキング表をゲットしている）。"},{"spoiler":false,"text":"上記のような印象に反して嫌味にならない程度に腹黒く計算高い部分もある。"}],"source":"egs","sourceCharacterId":"10538","sourceWorkId":"14945","spoiler":false},{"segments":[{"spoiler":false,"text":"昴の妹で遥の双子の妹。“わが道を行く” をもっとーに、日々マイペース。"},{"spoiler":false,"text":"ただ、ここぞという時の行動力は遥よりもあったり。"},{"spoiler":false,"text":"昔は身体が弱かった影響からか今も図書館で読書するのが好きで、先生からも鍵を預かり実質図書館の主になっている。"},{"spoiler":false,"text":"はた目からは遥との対比もありおとなしい美少女という印象が強く、毎年恒例の蓮花台学園新入生女子ランキングで堂々の1位を獲得した。"},{"spoiler":false,"text":"そんな印象に反して、嫌味にならない程度に腹黒く計算高い部分もある。"},{"spoiler":false,"text":"「にいさん、今日のことはハルちゃんにも内緒ですよ？　もし破ったら……たとえにいさんでも容赦しませんからね♪」"}],"source":"bangumi","sourceCharacterId":"53405"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"53405","value":"双子座"},{"