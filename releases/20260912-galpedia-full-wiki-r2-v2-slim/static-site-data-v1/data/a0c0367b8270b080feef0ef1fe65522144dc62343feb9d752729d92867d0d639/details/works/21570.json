confirmed","relationId":"egs:work-creator:145092","source":"egs"},{"creditedName":"Aurora","creatorId":"vndb:s5456","sourcePersonId":"egs:creator:23000","canonicalEntityId":"vndb:s5456","name":"Aurora","detail":"OP曲 「Wildfire」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:150819","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117122","source":"vndb"},{"creditedName":"聖 少女","creatorId":"vndb:s1001","sourcePersonId":"vndb:s1001","canonicalEntityId":"vndb:s1001","name":"聖 少女","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:117123","source":"vndb"},{"creditedName":"デン","creatorId":"vndb:s1029","sourcePersonId":"vndb:s1029","canonicalEntityId":"vndb:s1029","name":"デン","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:117126","source":"vndb"},{"creditedName":"Aurora","creatorId":"vndb:s5456","sourcePersonId":"vndb:s5456","canonicalEntityId":"vndb:s5456","name":"Aurora","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:117128","source":"vndb"}]},"cast":[{"characterId":"char_c26818","characterName":"セリシア・ロックハート","sourceIds":{"bangumi":[{"characterId":"61589","match":"exact-normalized-name-in-linked-work","subjectId":"124014"}],"egsCharacterIds":["6380"],"vndbCharacterId":"c26818"},"originalCharacterName":"セリシア・ロックハート","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Occupation: Bounty Hunter"},{"spoiler":false,"text":"Hobbies: Taking care of her revolver"},{"spoiler":false,"text":"Skills: Shooting (with a revolver)"},{"spoiler":false,"text":"Likes: Tougo, her revolver"},{"spoiler":false,"text":"Dislikes: Poor people, slimy things"},{"spoiler":false,"text":"Tougo's childhood friend and Celine's older twin sister. Because they didn't have any other relatives aside from their parents, they were forced to live their lives in an orphanage. Due to her skill with the revolver and being able to shoot brilliantly with two revolvers at the same time, she is nicknamed \"Double Tap\". In the past, she was invited by sheriff George Mitchell to a tournament where she proved that she can shoot 12 bullets in 1.2 seconds, and which in turn helped her to become a bounty hunter despite Tougo's warnings. Despite all this, Celicia has a poor sense of direction and tends to get easily lost."}],"source":"vndb","sourceCharacterId":"c26818"},{"segments":[{"spoiler":false,"text":"セリシアは、セリーヌの双子の姉。"},{"spoiler":false,"text":"両親は蒸発し、身寄りがなかったセリシアとセリーヌは施設で慎ましく暮らしていた。"},{"spoiler":false,"text":"デカいリボルバーを２丁腰に下げており『ダブル・プル・ザ・トリガー』の異名を持ち、速射が得意。"},{"spoiler":false,"text":"保安官でもあるジョージ・ミッチェルに誘われ、事務所内で行われた早打ち大会に出場したところ、１．２秒で１２発の弾丸を全ての的に当てるという偉業を達成しその異名が付けられた。"},{"spoiler":false,"text":"それで味をしめたのか、トウゴの反対を押し切りバウンティーハンターになってしまう。"},{"spoiler":false,"text":"ちなみにセリシアは、かなりの方向音痴。"}],"source":"egs","sourceCharacterId":"6380","sourceWorkId":"21570","spoiler":false},{"segments":[{"spoiler":false,"text":"セリーヌの双子の姉。 両親が蒸発し身寄りがなかったふたりは、施設で慎ましく暮らしていた。"},{"spoiler":false,"text":"デカいリボルバーを 2丁腰に下げ “ダブル・プル・ザ・トリガー” の異名を持ち、速射が得意。"},{"spoiler":false,"text":"保安官であるジョージ・ミッチェルに誘われ、事務所内で行われた早打ち大会に出場したところ、1.2秒で 12発の弾丸をすべての的に当てるという偉業を達成し異名が付けられた。"},{"spoiler":false,"text":"それで味をしめたのか、トウゴの反対を押し切りバウンティーハンターになってしまう。"},{"spoiler":false,"text":"ちなみにセリシアは、かなりの方向音痴。"},{"spoiler":false,"text":"「出し入れできる穴を 5、6個増やしてやってもいいんだぜ！」"}],"source":"bangumi","sourceCharacterId":"61589"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"61589","value":"トウゴ、愛銃"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"61589","value":"貧乏、ヌルヌルしたもの"},{"label":"特技","source":"bangumi","sourceCharacterId":"61589","value":"射撃（リボルバー）"},{"label":"職業","source":"bangumi","sourceCharacterId":"61589","value":"バウンティーハンター"},{"label":"趣味","source":"bangumi","sourceCharacterId":"61589","value":"愛銃の手入れ"},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"6380","sourceWorkId":"21570","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"6380","sourceWorkId":"21570","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"6380","sourceWorkId":"21570","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"6380","sourceWorkId":"21570","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"6380","sourceWorkId":"21570","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bd27de4deb06a6e29db19b3e00839b9aa4171eb7d85219158a72a1d7f6021e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5072aad170972c723b3c58b4283cb386caf357d37870130601a6642872847188.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:124014:61589:10027:1","source":"bangumi"}]},{"characterId":"char_c26819","characterName":"セリーヌ・ヴァルシーナ","sourceIds":{"bangumi":[{"characterId":"33816","match":"exact-normalized-name-in-linked-work","subjectId":"124014"}],"egsCharacterIds":["6381"],"vndbCharacterId":"c26819"},"originalCharacterName":"セリーヌ・ヴァルシーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Occupation: One of the directors of Closed GAME"},{"spoiler":false,"text":"Hobbies: Kingcraft"},{"spoiler":false,"text":"Skills: Shooting (with handguns)"},{"spoiler":false,"text":"Likes: Everything that Michiko likes"},{"spoiler":false,"text":"Dislikes: Everything that Michiko finds boring"},{"spoiler":false,"text":"Her maiden name is Celine Lockhart, and she is Celicia's younger twin sister. She lived in the same orphanage together with her and Tougo, until she was suddenly adopted by Michiko and got separated from them. In her childhood, she used to be introverted and respected Celicia very much, but after growing up she has changed tremendously, even as far as becoming one of the directors for the Closed GAME."}],"source":"vndb","sourceCharacterId":"c26819"},{"segments":[{"spoiler":false,"text":"幼少の頃は、セリシアとトウゴと共に地上の施設で暮らしていたが、突然ミチコがセリーヌだけを養子として引き取ったことで、セリシアとは離れ離れになってしまう。"},{"spoiler":false,"text":"子供の頃のセリーヌは、運動音痴で内向的な性格で、セリシアの事が自慢の姉だった。"},{"spoiler":false,"text":"それから十数年の月日が経った時、『Closed GAME』の進行役として突然セリシアの目の前に現れたセリーヌは、子供のころの面影が全くなくなっている。"},{"spoiler":false,"text":"ちなみに利き腕の左腕には、幼少の時にできた傷がいまだに残っている。"}],"source":"egs","sourceCharacterId":"6381","sourceWorkId":"21570","spoiler":false},{"segments":[{"spoiler":false,"text":"旧姓是赛琳・洛哈特。塞西莉亚的双胞胎妹妹。"},{"spoiler":false,"text":"小时候和塞西莉亚和东吾一起在地上的设施生活，但美智子突然把赛琳收为养女，和塞西莉亚分开。"},{"spoiler":false,"text":"小时候的赛琳是个运动音痴，性格内向，塞西莉亚是她引以为傲的姐姐。"},{"spoiler":false,"text":"过去了十几年的岁月，突然作为“Closed GAME”的主持人出现在塞西莉亚的面前的赛琳已经和小时候判若两人了。"},{"spoiler":false,"text":"顺带一提惯用的左臂至今还残留着小时候的伤痕。"},{"spoiler":false,"text":"「我是来给你机会的哦，姐姐」"}],"source":"bangumi","sourceCharacterId":"33816"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"33816","value":"帝王学"},{"label":"喜欢","source":"bangumi","sourceCharacterId":"33816","value":"美智子感到开心"},{"label":"特技","source":"bangumi","sourceCharacterId":"33816","value":"射击（手枪）"},{"label":"职业","source":"bangumi","sourceCharacterId":"33816","value":"Closed GAME的主持人"},{"label":"讨厌","source":"bangumi","sourceCharacterId":"33816","value":"美智子觉得无聊"},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"6381","sourceWorkId":"21570","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"6381","sourceWorkId":"21570","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"6381","sourceWorkId":"21570","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"6381","sourceWorkId":"21570","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"6381","sourceWorkId":"21570","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ebeda937a738fa89a6d5f8d2b6f8ad85c5179b8426f427e74ea6eeea30b81db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/eca52ef9c0fb7b664cf6d0928cba12375f0474b5356b7bf46bf003c32215e7b8.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"おか梨衣菜","creatorId":"vndb:s3366","sourcePersonId":"vndb:s3366","canonicalEntityId":"vndb:s3366","name":"おか梨衣菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62853","source":"vndb"}]},{"characterId":"char_c26820","characterName":"ミチコ・ヴァルシーナ","sourceIds":{"bangumi":[{"characterId":"61590","match":"exact-normalized-name-in-linked-work","subjectId":"124014"}],"egsCharacterIds":["6382"],"vndbCharacterId":"c26820"},"originalCharacterName":"ミチコ・ヴァルシーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Occupation: Producer"},{"spoiler":false,"text":"Hobbies: Killing time"},{"spoiler":false,"text":"Skills: Sex"},{"spoiler":false,"text":"Likes: People who are overflowing with adrenaline"},{"spoiler":false,"text":"Dislikes: Boredom"},{"spoiler":false,"text":"The producer of \"Closed GAME\". She was born and raised in Caelum Urbs, but was raised as a human. In the Heaven, things such as having sex and exchanging body fluids are considered vulgar, and humans who possess extreme sexual drives are considered as criminals. In order to gain the trust and support of the Heaven's people, she produced all kinds of freak shows for them, with Closed GAME being one of them. Thanks to them, Michiko has gained tremendous popularity in the Heaven and trust of the Heaven's people, with her shows having excellent viewer rates and being extremely successful there."}],"source":"vndb","sourceCharacterId":"c26820"},{"segments":[{"spoiler":false,"text":"生まれも育ちもカエルム・ウルブス育ち。『Closed GAME』のプロデューサー。"},{"spoiler":false,"text":"『生まれた』といっても母体から生まれたわけではなく、培養で育った人間。"},{"spoiler":false,"text":"自分も人の子を身籠ったこともなければ生んだこともなく、妊娠という現象にも興味がない。"},{"spoiler":false,"text":"天上界では、ＳＥＸや体液交換などの行為は低俗なものだと思われており、それにまつわる性衝動を保有する人間は、犯罪者のように扱われる。"},{"spoiler":false,"text":"それでも天上人は『性』に関してまったく興味がないわけではなく、逆に興味があるが『低俗な行為』としての風潮が長すぎたため、周りの目を気にしすぎてしまい自分達では行動に移せないでいる。"},{"spoiler":false,"text":"そこでミチコは、天上人の『怖いもの見たさ』を刺激するプログラム『Freak show』を企画、そのプログラム内にある『Closed GAME』を、人間とは思っていない『地上人』を使って、ショウとして天上界で放映している。"},{"spoiler":false,"text":"そんな『Closed GAME』は視聴率がよく、プロデューサーであるミチコは天上界の人々から絶大な支持を得ている。"}],"source":"egs","sourceCharacterId":"6382","sourceWorkId":"21570","spoiler":false},{"segments":[{"spoiler":false,"text":"“Closed GAME” のプロデューサー。 生まれも育ちも カエルム・ウルブス。"},{"spoiler":false,"text":"“生まれた” といっても母体から生まれたわけではなく、培養で育った人間。"},{"spoiler":false,"text":"天上界では、セックスや体液交換などの行為は低俗なものだと思われており、それにまつわる性衝動を保有する人間は犯罪者のように扱われる。"},{"spoiler":false,"text":"それでも天上人は性に関してまったく興味が無いわけではなく、逆に興味はあるが低俗な行為としての風潮が強すぎるため、周りの目を気にして行動に移せないでいる。"},{"spoiler":false,"text":"そこでミチコは、天上人の 怖いもの見たさ を刺激するプログラム “Freak show” を企画。"},{"spoiler":false,"text":"その内の一つである Closed GAME は、人間とは思っていない地上人たちを使ったショー。"},{"spoiler":false,"text":"これは天上界での視聴率が良く、プロデューサーであるミチコは天上人たちから絶大な支持を得ている。"},{"spoiler":false,"text":"「退屈退屈退屈退屈退屈退屈退屈なのよ！」"}],"source":"bangumi","sourceCharacterId":"61590"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"61590","value":"アドレナリンがあふれ出すもの"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"61590","value":"