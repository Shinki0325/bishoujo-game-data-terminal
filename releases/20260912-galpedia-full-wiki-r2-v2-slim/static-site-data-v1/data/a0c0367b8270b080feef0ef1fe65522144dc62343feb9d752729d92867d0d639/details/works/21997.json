eConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a233322341650a10ec3d4b4ba2ee2d72e83fed72e9b79d3aa3eec10ac3cacde4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e44852da32dbdd40835e8ae00f6d6dbd70aef9dbce29f4bf68af2fe4332e1c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安 ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47769","source":"vndb"}]},{"characterId":"char_vndb_c9490","characterName":"大蔵 りそな","sourceIds":{"vndbCharacterId":"c9490"},"originalCharacterName":"大蔵 りそな","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"515"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hometown: Tokyo, Japan"},{"spoiler":false,"text":"Aeon's full sister and Yuusei's half-sister. A hikikomori and an avid gamer."},{"spoiler":false,"text":"She has an intense love for Yuusei and is not shy to admit that she is a brocon. She would do anything for him to find true happiness, even if it means sacrificing herself in the process."},{"spoiler":false,"text":"Has a habit of referring people with anything other than their true name, such as younger big brother (to Yuusei), Lunachomu (to Luna), model girl (to Bluette), monastery girl (to Meryl), etc. She refers to herself as \"imouto\" when talking to both of her brothers."},{"spoiler":true,"text":"It is revealed later that Resona is actually talented in fashion design. The reason Aeon said otherwise is that so Resona doesn't get on the way of his ambition."}],"source":"vndb","sourceCharacterId":"c9490"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/633977afe6f8bf47acdc1b1b90f909bae18bc53fa2885b593c6f2f64803d9a1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95fa12951e647d48d19c6d2e04453979003b8dd0528173a2b3f233ea469f2a64.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"又吉 愛","creatorId":"vndb:s1646","sourcePersonId":"vndb:s1646","canonicalEntityId":"vndb:s1646","name":"又吉 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47784","source":"vndb"}]},{"characterId":"char_vndb_c9491","characterName":"大蔵 衣遠","sourceIds":{"vndbCharacterId":"c9491"},"originalCharacterName":"大蔵 衣遠","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1111"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Resona's full brother and Yuusei's half-brother."},{"spoiler":true,"text":"It is revealed later in Otome Riron to Sono Shuuhen -Ecole de Paris- that he is not Ookura Shinsei's true son, and that he was conceived in result of his mother's infidelity, making him an illegitimate heir to the Ookura family. His ambition and obsession toward talent was the result of his insecurity from that."},{"spoiler":true,"text":"This also means that he and Resona are half-siblings, and he is not related to Yuusei by blood."}],"source":"vndb","sourceCharacterId":"c9491"}],"