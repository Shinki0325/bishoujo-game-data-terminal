,"identityStatus":"no-alias-hit","relationId":"egs:work-creator:175014","source":"egs"},{"creditedName":"尾之上咲太","creatorId":"vndb:s1807","sourcePersonId":"egs:creator:2255","canonicalEntityId":"vndb:s1807","name":"尾之上咲太","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:219012","source":"egs"}]},"cast":[{"characterId":"char_bangumi_133999","characterName":"Rune","sourceIds":{"bangumi":[{"characterId":"133999","match":"source-roster","subjectId":"217500"}]},"originalCharacterName":"Rune","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"均整の取れたボディラインを持つ赤髪の女吸血鬼。"},{"spoiler":false,"text":"性格は極めて悪く、自分本位。尚に召還され数百年ぶりに現世に現れた。"},{"spoiler":false,"text":"「闇の女王リリトゥが一子。最古の魔人が一柱（本人談）」"},{"spoiler":false,"text":"しかし、のっけから尚には吸血鬼と連呼されまともに呼ばせるのを諦める。"},{"spoiler":false,"text":"現代社会は非常に興味深いらしく、基本的にはあちこちウロウロと飛び回っていて、稀に、面白いことがあると尚のところにやってきて、熱っぽく語り出したりするさびしがり屋な一面も。"}],"source":"bangumi","sourceCharacterId":"133999"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05194cfa457bbda728c5042251b1d99636970dbadf7d21847185379e8d7f41e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7280eb102eacccbb129f22c4012d1027d8f45496224e1c4188d6f880ecfcfe99.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217500:133999:4832:1","source":"bangumi"}]},{"characterId":"char_bangumi_134000","characterName":"Nagamori Kaname","sourceIds":{"bangumi":[{"characterId":"134000","match":"source-roster","subjectId":"217500"}]},"originalCharacterName":"Nagamori Kaname","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"尚が通う学園のクラスメイト。"},{"spoiler":false,"text":"愛らしい優等生な雰囲気を持っているが、これがどうしてなかなかのドジっこ。無防備というか隙が多く、ワタワタとよく慌てる。"},{"spoiler":false,"text":"よく、尚の部屋に遊びに来る。その時は必ず本を一冊持ってきてくれて、前に持ってきた本の感想を聞いてくる。"},{"spoiler":false,"text":"なかなかに安らいだ時間ではあるが、学校に来るようにと言ってきたりするので、その点が困る。"}],"source":"bangumi","sourceCharacterId":"134000"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5413a37be6a208c8aa07df64517f9dc60ff21efb6b98c6313555d92ad9b403e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8bf3bbcba6ee3b129300cf75611e4d42cfab97143af1ec51a9fb2786b1616f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217500:134000:4489:1","source":"bangumi"}]},{"characterId":"char_bangumi_134001","characterName":"Ryouke Neo","sourceIds":{"bangumi":[{"characterId":"134001","match":"source-roster","subjectId":"217500"}]},"originalCharacterName":"Ryouke Neo","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゴスロリサイコ少女。そしてつるぺた。"},{"spoiler":false,"text":"悪魔信者。ナイフを片手に夜の町を徘徊している、どこか壊れた感じの子。常に黒を身につけていないと安心できない。"},{"spoiler":false,"text":"音楽学校に通う良家のお嬢様。しかし、ピアニストとしての才能はない。"},{"spoiler":false,"text":"普段は無表情で淡々とした口振りだが、胸には劣等感が渦を巻いており、破壊願望が強い。"}],"source":"bangumi","sourceCharacterId":"134001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a330b41b582c1d592e8158ffd92c5d9d0f245445b61f2897dc1f03ee4c49e6ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b383f7dda683a7aed1a1f8e95eb859dbcd345b69e5d70bfa7084a23ffac5834e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217500:134001:4689:1","source":"bangumi"}]},{"characterId":"char_bangumi_134002","characterName":"Faran","sourceIds":{"bangumi":[{"characterId":"134002","match":"source-roster","subjectId":"217500"}]},"originalCharacterName":"Faran","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"謎の屋台のクレープ屋さん。"},{"spoiler":false,"text":"お客さんが酷い業を背負っていたり霊障にあっていたりすると、鋭く悟り、占いと称してアドバイスを送ってあげる。性格は活発で、虫も殺せぬ善良娘。"},{"spoiler":false,"text":"「です」「ます」口調の、自称丁寧さん。自称するところが奥ゆかしくない。どうやら、自信はないらしい。"},{"spoiler":false,"text":"やることなすこと間が抜けていて、隙が多い。ただし、素体能力が凄まじく高いので、イタズラは死と隣り合わせ。"},{"spoiler":false,"text":"彼女は驚くと全身から発光する。それを浴びると…！"}],"source":"bangumi","sourceCharacterId":"134002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cc33155cebfe560f65dfe96dfcc366878405e1d3a6e919d6831f2ace155dd95.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2291f5824c30b9097d100afd2dce81561e8a924d09516fbc474d9ade6c47f97.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217500:134002:6409:1","source":"bangumi"}]},{"characterId":"char_bangumi_134003","characterName":"Harada Ryouko","sourceIds":{"bangumi":[{"characterId":"134003","match":"source-roster","subjectId":"217500"}]},"originalCharacterName":"Harada Ryouko","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"尚が下宿している、おんぼろアパートの大家さん。"},{"spoiler":false,"text":"夫は５年前に他界。スタイルは熟れたお色気ムンムンボディ。"},{"spoiler":false,"text":"ほんわかとした雰囲気の、妙齢未亡人。明るく、かなりのお人よし。"},{"spoiler":false,"text":"娘が可愛くて仕方ない。"},{"spoiler":false,"text":"尚は娘のよき遊び相手という認識で、家庭についての同情もあり、可愛い息子くらいの認識でいる節が。"},{"spoiler":false,"text":"顔を見るたびにあれこれと世話を焼いてきたり、つれなくするとオロオロしたりと一人大忙し。"},{"spoiler":false,"text":"尚が、最も苦手とする女性でもあるが身近な存在でもある。"}],"source":"bangumi","sourceCharacterId":"134003"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/491d09977c4c4c9984befbb82c2ab1012b8bac6ed90c3fc8d4414bcded3a170a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cdf5089c5eef84ca2237cb7af835cb0902921c7357b7914944a5d6a64282334.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217500:134003:4940:1","source":"bangumi"}]},{"characterId":"char_bangumi_134004","characterName":"Harada Honoka","sourceIds":{"bangumi":[{"characterId":"134004","match":"source-roster","subjectId":"217500"}]},"originalCharacterName":"Harada Honoka","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"原田諒子の一人娘。父親を亡くしていて、ちょっと寂しいがおかーさんが心配するので元気に振舞い大人であろうと頑張っている。"},{"spoiler":false,"text":"が、同年齢と比べても小さい。"},{"spoiler":false,"text":"身体つきは、ふっくらくらいでつるぺた。"},{"spoiler":false,"text":"ツンツンした雰囲気のおすましさんで、大人ぶろうと難しい言葉を使おうとしてみたりするが、すぐに間違える。"},{"spoiler":false,"text":"犬耳のかたちの髪飾りがお気に入り。"}],"source":"bangumi","sourceCharacterId":"134004"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af98b9d100e7d0d644b5977d65bba29fa572af2fd08ab593e611e895474aa4a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6cbab9aced900ad206de98979f35e67eaa4c4a19a9d315eb38ea6ba41b148e5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217500:134004:6038:1","source":"bangumi"}]},{"characterId":"char_bangumi_134005","characterName":"Kohinata Hikari","sourceIds":{"bangumi":[{"characterId":"134005","match":"source-roster","subjectId":"217500"}]},"originalCharacterName":"Kohinata Hikari","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"音央の傍に仕える、忠実なメイドさん。"},{"spoiler":false,"text":"音央のメイドにして、警備係。メイド部隊（尚認識）"},{"spoiler":false,"text":"の隊長。ただし、要らない一言が多すぎる。"},{"spoiler":false,"text":"多くは語らないが、過去のなかなか後ろ暗い経験がある様子。"},{"spoiler":false,"text":"しかし常識知らずで根央の機嫌を損ねては、あたふたとする。"},{"spoiler":false,"text":"音央の言うことにはあくまで忠実。音央は、彼女が義務として自分に仕えていると考えているが、本人は姉のような目で見ている…つもり。"},{"spoiler":false,"text":"そういう感情は、なかなか表に出ない。"}],"source":"bangumi","sourceCharacterId":"134005"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29cd6799113c807215e07fbf7d1e81c0d31d0ed569034742481d1dd4a1fdcb4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/6093a20f181ab6b30f3ad77414811983b4c7fe6d5f3ff369804da7883b61c894.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田愛理","creatorId":"vndb:s757","sourcePersonId":"vndb:s757","canonicalEntityId":"vndb:s757","name":"如月葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217500:134005:6037:1","source":"bangumi"}]},{"characterId":"char_bangumi_134006","characterName":"勝間　尚","sourceIds":{"bangumi":[{"characterId":"134006","match":"source-roster","subjectId":"217500"}]},"originalCharacterName":"勝間　尚","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"中肉中背、顔はよく見ればそこそこ見られる。"},{"spoiler":false,"text":"ただし、いじめられっ子。"},{"spoiler":false,"text":"今時の引きこもり少年で学生だが登校拒否児。片親（母は死去）で、"},{"spoiler":false,"text":"父親はほとんど家にいないと、家庭環境的にも劣悪。"},{"spoiler":false,"text":"とにかく自分の現状が嫌で、壊してしまいたいと思っている。"}],"source":"bangumi","sourceCharacterId":"134006"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p903","sourceCompanyId":"egs:brand:1093","canonicalEntityId":"vndb:p903","name":"Sincere","roleCodes":["brand"],"identityStatus":"auto-confirmed","re