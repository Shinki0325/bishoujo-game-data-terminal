:"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:127491","source":"vndb"}]},"cast":[{"characterId":"char_c43325","characterName":"時谷 忍","sourceIds":{"bangumi":[{"characterId":"39312","match":"exact-normalized-name-in-linked-work","subjectId":"168338"}],"egsCharacterIds":["8290"],"vndbCharacterId":"c43325"},"originalCharacterName":"時谷 忍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuharu's non-identical twin younger sister - it's supposed to be like that, but in fact the two has no blood relation at all."}],"source":"vndb","sourceCharacterId":"c43325"},{"segments":[{"spoiler":false,"text":"主人公の二卵性双生児、双子の妹――ということになっているが、実はまったく血のつながりのない他人。"},{"spoiler":false,"text":"義妹ならぬ偽妹。美柿野学園の二年生。"},{"spoiler":false,"text":"幼少期のとある事件が元で、一春と兄妹であると世間をだましてこれまで二人きりで生きてきた。"},{"spoiler":false,"text":"兄と違い、人望があり生徒会長まで勤めている。"},{"spoiler":false,"text":"が、それはあくまでも外面であり、その実体は兄大好きな病的なまでのブラコン妹である。"},{"spoiler":false,"text":"家で一春と二人きりの時は、あらゆる手をつくして、兄を誘惑し既成事実を作るタイミングを虎視眈々と狙っている。"},{"spoiler":false,"text":"一春同様この世は非情な荒野であり、ここまで成長する過程で多くの辛酸を一春とともになめてきた苦労人でもある。"},{"spoiler":false,"text":"そして、今まで自分を守ってくれた一春に心酔し「この恩を返すために処女も命も捧げる」と家では公言してはばからない。"},{"spoiler":false,"text":"ストレートロングの黒髪が特徴の、クールな雰囲気を漂わせる美少女。"}],"source":"egs","sourceCharacterId":"8290","sourceWorkId":"23045","spoiler":false},{"segments":[{"spoiler":false,"text":"ストレートロングの黒髪が特徴の、クールな雰囲気を漂わせる美少女。"},{"spoiler":false,"text":"美柿野学園の 2年生で、主人公・一春の二卵性双生児、双子の妹――"},{"spoiler":false,"text":"ということになっているが、実はまったく血の繋がりのない他人。 義妹ならぬ偽妹。"},{"spoiler":false,"text":"幼少期のとある事件をキッカケに、世間をだまして一春と二人きりで生きてきた。"},{"spoiler":false,"text":"兄と違い、人望があり生徒会長まで務めている。"},{"spoiler":false,"text":"が、それはあくまでも外面であり、その実体は兄大好きな病的なまでのブラコン妹。"},{"spoiler":false,"text":"あらゆる手を尽くして兄を誘惑し、既成事実を作るタイミングを虎視眈々と狙っている。"},{"spoiler":false,"text":"一春同様この世は非情な荒野と考え、これまで多くの辛酸を一春と共になめてきた苦労人。"},{"spoiler":false,"text":"今まで自分を守ってくれた一春に心酔し、「この恩を返すために処女も命も捧げる」 と家では公言してはばからない。"}],"source":"bangumi","sourceCharacterId":"39312"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3dcb64fc1a6a872552f193a4184050ac7eae551b53637d8a939393c7db09cbe3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e09bbcc625d9ac1735ba04d3831e0e07a83d5f01380ff1a657047f01d80f122d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎真実","creatorId":"vndb:s199","sourcePersonId":"vndb:s199","canonicalEntityId":"vndb:s199","name":"尾崎 真実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:168338:39312:8165:1","source":"bangumi"}]},{"characterId":"char_c43326","characterName":"宮本 遊花","sourceIds":{"bangumi":[{"characterId":"39313","match":"exact-normalized-name-in-linked-work","subjectId":"168338"}],"egsCharacterIds":["8291"],"vndbCharacterId":"c43326"},"originalCharacterName":"宮本 遊花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、幼馴染。呼称はあたしで、主人公を「一春」と呼び捨てる。（主人公には遊（ゆう）と呼ばれている）"},{"spoiler":false,"text":"一春とフランクに話すことができる数少ない少女。飾らない性格で男女共に人気がある。"},{"spoiler":false,"text":"ひとつ下の弟がおり、その弟を「ウザイ」といいつつも可愛がっている。"},{"spoiler":false,"text":"主人公のぶっきらぼうな態度の裏に隠された優しい性格を知っているため、主人公の家に夕食のおかずをおすそ分けに行ったりと何かと世話を焼いてくれる優しいいい子。"},{"spoiler":false,"text":"だが、それを決して表には出さない。ややツンデレ属性。そして怒るとやかましい。"},{"spoiler":false,"text":"主人公のバイトする大衆食堂の看板娘。"},{"spoiler":false,"text":"容姿は今風のオシャレ系の美少女で、ごくたまに読者モデルのバイトをすることもある。"},{"spoiler":false,"text":"今度、グラドルになるとの話も出ていて芸能プロに仮所属している。"},{"spoiler":false,"text":"勉強はあまりしないので成績は一春とともに下降線を辿り気味。"},{"spoiler":false,"text":"忍をのぞけばもっとも一春と付き合いの長い人物だが、一春と忍の真の関係までは知らない。"},{"spoiler":false,"text":"一春も口にはしないが、遊花のことは憎からず思ってはいる。"},{"spoiler":false,"text":"そのため忍にとって、遊花は要注意人物の筆頭である。"}],"source":"egs","sourceCharacterId":"8291","sourceWorkId":"23045","spoiler":false},{"segments":[{"spoiler":false,"text":"世話焼きで優しく、読者モデルもしている大衆食堂の看板娘。"},{"spoiler":false,"text":"一春とはクラスメイトで幼なじみ。 お互いを名前で呼び捨て合う仲。"},{"spoiler":false,"text":"ひとつ下の弟がおり、その弟を 「ウザイ」 と言いつつも可愛がっている。"},{"spoiler":false,"text":"今度 グラドルになるという話も出ていて、芸能プロに仮所属している。"},{"spoiler":false,"text":"勉強はあまりしないので、成績は一春とともに下降線を辿り気味。"},{"spoiler":false,"text":"飾らない性格で、男女共に人気がある。"},{"spoiler":false,"text":"一春の隠された優しさを知っており、夕飯のおすそ分けをしたりと何かと世話を焼いてくれる。"},{"spoiler":false,"text":"しかし、ややツンデレ属性で怒るとやかましい。"},{"spoiler":false,"text":"忍を除けば最も一春との付き合いが長い人物だが、一春と忍の真の関係は知らない。"},{"spoiler":false,"text":"口にはしないが、一春も遊花のことは憎からず思っている。"},{"spoiler":false,"text":"そのため忍にとって、遊花は要注意人物の筆頭。"}],"source":"bangumi","sourceCharacterId":"39313"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dea658d2a9dd158b8736c28f2809fadaef903f5bed12df199fb28745a0ea5c50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d56f8bdfdb904410a7b8b42e00752e5cb93180133e901df37026fb07f102e2d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹内仁美","creatorId":"vndb:s978","sourcePersonId":"vndb:s978","canonicalEntityId":"vndb:s978","name":"羽鳥いち","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:168338:39313:15924:1","source":"bangumi"}]},{"characterId":"char_c43327","characterName":"川津 翼","sourceIds":{"bangumi":[{"characterId":"39316","match":"exact-normalized-name-in-linked-work","subjectId":"168338"}],"egsCharacterIds":["8293"],"vndbCharacterId":"c43327"},"originalCharacterName":"川津 翼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の学園に突如として現れた謎の美少女。"},{"spoiler":false,"text":"制服が違うので他校の生徒が勝手に、侵入していると思われるが詳細は不明。"},{"spoiler":false,"text":"神出鬼没で、教師達も手を焼いている。"},{"spoiler":false,"text":"一春が屋上で授業をさぼっていると何故かよく遭遇することがある。"},{"spoiler":false,"text":"内向的な性格で、長い前髪で顔を隠して見知らぬ相手にはバリアーを張っている。"},{"spoiler":false,"text":"だが、芯は強く気丈な一面も持っている。真面目な子。"},{"spoiler":false,"text":"心を開いた相手には甘える傾向がある。"},{"spoiler":false,"text":"そして一度なつくと今度は子犬のように離れなくなる。"}],"source":"egs","sourceCharacterId":"8293","sourceWorkId":"23045","spoiler":false},{"segments":[{"spoiler":false,"text":"学園に突如として現れた謎の美少女。"},{"spoiler":false,"text":"制服が違うので他校の学生と思われるが、詳細は不明。"},{"spoiler":false,"text":"神出鬼没で、教師たちも手を焼いている。"},{"spoiler":false,"text":"一春が屋上で授業をさぼっていると何故かよく遭遇することがある。"},{"spoiler":false,"text":"内向的な性格で、長い前髪で顔を隠して見知らぬ相手にはバリアーを張っている。"},{"spoiler":false,"text":"だが、芯は強く気丈な一面も持っている。 まじめな子。"},{"spoiler":false,"text":"心を開いた相手には甘える傾向があり、一度なつくと子犬のように離れなくなる。"}],"source":"bangumi","sourceCharacterId":"39316"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f6e3d4bab123be29a10d1182d3f16d031fef6f305905cb1e14cba9064db599a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10caf9e31897b94111268caa64ee5d365ded47b167e7578d402c8e8c182de358.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林桂子","creatorId":"vndb:s443","sourcePersonId":"vndb:s443","canonicalEntityId":"vndb:s443","name":"美月(声優)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:168338:39316:16180:1","source":"bangumi"}]},{"characterId":"char_c43328","characterName":"田中 寧々子","sourceIds":{"bangumi":[{"characterId":"39314","match":"exact-normalized-name-in-linked-work","subjectId":"168338"}],"egsCharacterIds":["8292"],"vndbCharacterId":"c43328"},"originalCharacterName":"田中 寧々子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のバイト先である飛行場の倉庫の先輩。十八歳。"},{"spoiler":false,"text":"一春よりひとつ年上で、チームの責任者でもあり主人公はバイト先では「田中チーフ」と呼ぶ。"},{"spoiler":false,"text":"無免許でフォークリフトを操ったり、トラックの運ちゃんとケンカしたりと破天荒で強気、でもさっぱりとした男前な少女である。"},{"spoiler":false,"text":"主人公をイジって遊びつつも何かと目をかけて、助けてくれる。"},{"spoiler":false,"text":"主人公が頭の上がらない数少ない人物。"},{"spoiler":false,"text":"後に一春の通う学園の上級生であると発覚し、学園でもイジられることになる。"},{"spoiler":false,"text":"学園での呼び名は「田中先輩、寧々子先輩」。美柿野学園の三年生。"},{"spoiler":false,"text":"多くは語らないが、主人公同様複雑な家庭環境に育ち、たまに陰のある面も垣間見せる。"}],"source":"egs","sourceCharacterId":"8292","sourceWorkId":"23045","spoiler":false},{"segments":[{"spoiler":false,"text":"一春のバイト先の一つである飛行場倉庫の先輩。"},{"spoiler":false,"text":"ひとつ年上で、チームの責任者でもあり “田中チーフ” と呼ばれている。"},{"spoiler":false,"text":"無免許でフォークリフトを操ったり トラックの運ちゃんとケンカしたりと、破天荒で強気。"},{"spoiler":false,"text":"さっぱりとした男前な少女。"},{"spoiler":false,"text":"一春をイジって遊びつつも、何かと目をかけて助けてくれる。"},{"spoiler":false,"text":"おかげで一春が頭の上がらない数少ない人物。"},{"spoiler":false,"text":"後に一春の通う学園の上級生であると発覚し、学園でもイジられることになる。"},{"spoiler":false,"text":"美柿野学園の 3年生。 学園での呼び名は “田中先輩、寧々子先輩”。"},{"spoiler":false,"text":"多くは語らないが、主人公同様複雑な家庭環境に育ち、たまに陰のある面も垣間見せる。"}],"source":"bangumi","sourceCharacterId":"39314"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6b82236a7d1ca1e65c64c50dc3453ce658f1671dd7838d6b1c244c7fe9464d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3560b1b7512a4a745c474b570a88c89960a030785af81037c315b0d5a6917e23.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 由依","creatorId":"vndb:s4454","sourcePersonId":"vndb:s4454","canonicalEntityId":"vndb:s4454","name":"陸","roleCo