vndb:s8764","name":"黒蜜きなこ(原画)","detail":"イベントグラフィック彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:257832","source":"egs"},{"creditedName":"蒼井 翔太","creatorId":"vndb:s141","sourcePersonId":"vndb:s141","canonicalEntityId":"vndb:s141","name":"蒼井 翔太","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:121275","source":"vndb"},{"creditedName":"KENN","creatorId":"vndb:s372","sourcePersonId":"vndb:s372","canonicalEntityId":"vndb:s372","name":"KENN","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:121276","source":"vndb"},{"creditedName":"伊東 愛","creatorId":"vndb:s8298","sourcePersonId":"vndb:s8298","canonicalEntityId":"vndb:s8298","name":"伊東 愛","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:121278","source":"vndb"},{"creditedName":"黒蜜 きなこ","creatorId":"vndb:s8764","sourcePersonId":"vndb:s8764","canonicalEntityId":"vndb:s8764","name":"黒蜜 きなこ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:121279","source":"vndb"},{"creditedName":"Yocke","creatorId":"vndb:s36519","sourcePersonId":"vndb:s36519","canonicalEntityId":"vndb:s36519","name":"Yocke","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:121282","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c39873","characterName":"中山 ひなこ","sourceIds":{"vndbCharacterId":"c39873"},"originalCharacterName":"中山 ひなこ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Stop. I don't want to fight in any meaningless battles.\""},{"spoiler":false,"text":"Class First Year Sumiregumi (Violet)"},{"spoiler":false,"text":"Specialty General Martial Arts"},{"spoiler":false,"text":"For as long as she's known she's been under the care of the state and, according to their policies, she's learned various martial arts since childhood. Ever since meeting her twin brother, who suddenly appeared, she's become enrolled in this prefecture's only high school for delinquents, Shishiku Academy, in her brother's place."},{"spoiler":false,"text":"Translation taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c39873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7584fe9994274114faebeab78f7fed0c96374dec7cecb781b2473bf93d61f3d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19c97a13b11476cc1104a2c91672bcb02e4a829fe2481c41de4d2e707a22ccc0.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c39874","characterName":"箕輪 斗々丸","sourceIds":{"vndbCharacterId":"c39874"},"originalCharacterName":"箕輪 斗々丸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"420"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"There's no way I can remain quiet after you looked down on me.\""},{"spoiler":false,"text":"Class First Year Sumiregumi (Violet)"},{"spoiler":false,"text":"Personality Genuine, Compassionate"},{"spoiler":false,"text":"Specialty Karate"},{"spoiler":false,"text":"Just after he entered high school, he talked big about crushing the class but then had his ass kicked by the heroine. After that, he recognized her superiority and became her close friend. As a person who isn't two faced and is a good-natured person to interact with, he treasures bonds between people, and will help others without compensation. Even though he's together with the heroine more often than anyone else, he's a thickheaded person who hasn't noticed at all that she's a girl."},{"spoiler":false,"text":"Translation taken from Otome Jikan"}],"source":"vndb","sourceCharacterId":"c39874"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01307e0d1978e3ea18430e01db04085b6888852991361f914d25bbd9844baee9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c768c800a8e880fcce62bd649ca048d918d57f12f9045443eebb657358888fd.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"KENN","creatorId":"vndb:s372","sourcePersonId":"vndb:s372","canonicalEntityId":"vndb:s372","name":"KENN","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64719","source":"vndb"}]},{"characterId":"char_vndb_c39875","characterName":"金春 貴之","sourceIds":{"vndbCharacterId":"c39875"},"originalCharacterName":"金春 貴之","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"119"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You're a nuisance. If you have no business here, leave.\""},{"spoiler":false,"text":"Class First Year Fujigumi (Wisteria)"},{"spoiler":false,"text":"Personality Serious, Stubborn, Hot-blooded"},{"spoiler":false,"text":"Specialty Brazilian Jiu-Jitsu"},{"spoiler":false,"text":"He is the strongest between all the first-years and part of the class next to the heroine's. As a user of jiu-jitsu he fights regardless of his physique. In regard to the heroine, who is smaller than everyone else, he feels a kindred spirit and is kind to her somewhat. But, because he dislikes women under the prejudice that \"women = weak\", never in his wildest dreams would he think that the heroine is a girl."},{"spoiler":false,"text":"Translation taken from Otome Jikan"}],"source":"vndb","sourceCharacterId":"c39875"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a2d1bc9a2f6dcb81ccb7c7c54689178d4b4891ae3b07376f8711f0f0cf6669a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62204306a9599cece7d148c7431f6dbef71557b8fa6076244d89a1aa70201d5b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蒼井 翔太","creatorId":"vndb:s141","sourcePersonId":"vndb:s141","canonicalEntityId":"vndb:s141","name":"蒼井 翔太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64716","source":"vndb"}]},{"characterId":"char_vndb_c39876","characterName":"吉良 麟太郎","sourceIds":{"vndbCharacterId":"c39876"},"originalCharacterName":"吉良 麟太郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1024"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"66"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Don't be rash. It's better not to do things like fight, right?\""},{"spoiler":false,"text":"Class Second Year Yurigumi (Lily)"},{"spoiler":false,"text":"Personality Cool, Apathetic"},{"spoiler":false,"text":"Speciality Boxing"},{"spoiler":false,"text":"It is said that his abilities and strength are number one among the second year delinquents. But this is just noise from the people around him and the person himself is unconcerned about competing for the top. A taciturn boy who dislikes hanging out with people, he's always doing things alone."},{"spoiler":false,"text":"Translation taken from Otome Jikan"}],"source":"vndb","sourceCharacterId":"c39876"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97c9cb59ba55eb81b95b70905035b394eed52b72193828099b96a06d6519e97d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e82edef9a55ddaab4c6096809a8bcfbe52d66e30bddacac7644b40fcc80420a0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"細谷 佳正","creatorId":"vndb:s251","sourcePersonId":"vndb:s251","canonicalEntityId":"vndb:s251","name":"細谷 佳正","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64717","source":"vndb"}]},{"characterId":"char_vndb_c39877","characterName":"未良子 裕太","sourceIds":{"vndbCharacterId":"c39877"},"originalCharacterName":"未良子 裕太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"726"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"This year's first years aren't cute. Give your senior a little respect.\""},{"spoiler":false,"text":"Class Second Year Sakuragumi (Cherry Blossom)"},{"spoiler":false,"text":"Personality Pompous, Haraguro"},{"spoiler":false,"text":"Speciality Kickboxing"},{"spoiler":false,"text":"A second-year delinquent. It is said that he has the abilities and strength to rival Kira. During middle school, he was a delinquent strong enough to rule the school, but all of a sudden he turned over and became an idol. He's always floating around with a grin but somewhere, on that surface, there is a deep part of him that he lets no one look deeper into."},{"spoiler":false,"text":"Translation taken from Otome Jikan"}],"source":"vndb","sourceCharacterId":"c39877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a2997c12f65cb313976e0b3509e6e9dfdcc2bf58b01a8765554124036593235.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/722c357ba7965bdec57b0fcae720cecbfae613b41c2f93745fffe414bbcb25c5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柿原 徹也","creatorId":"vndb:s80","sourcePersonId":"vndb:s80","canonicalEntityId":"vndb:s80","name":"柿原 徹也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64715","source":"vndb"}]},{"characterId":"char_vndb_c39878","characterName":"鬼ヶ島 鳳凰","sourceIds":{"vndbCharacterId":"c39878"},"originalCharacterName":"鬼ヶ島 鳳凰","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1216"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"75"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Guys, fighting is great and all, but be sure to stick to your principles.\""},{"spoiler":false,"text":"Class Third Year Kirigumi (Paulownia)"},{"spoiler":false,"text":"Personality Cheerful, Unprecedented"},{"spoiler":false,"text":"Specialty Judo"},{"spoiler":false,"text":"The heroine and Hikaru's older brother, born of a different mother, but the details are unknown. Ever since a young age he lived separately from Hikaru and has a prejudice against him. Entering Shishiku Academy, according to the customs of the Onigashima family, he carries the legend of ruling the school within a month."},{"spoiler":false,"text":"Translation taken from Otome Jikan"}],"source":"vndb","sourceCharacterId":"c39878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24f25db690ea1ab2f933aa66bde2bf0a4116046302d5d8247ec12a0c7c9cab24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85c30234e0d9cbab65c15142a7cc837c1ed13d442ea2a19eeff4fe83aa8e8fea.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前野 智昭","creatorId":"vndb:s64","sourcePersonId":"vndb:s64","canonicalEntityId":"vndb:s64","name":"前野 智昭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64713","source":"vndb"}]},{"characterId":"char_vndb_c39879","characterName":"鬼ヶ島 ひかる","sourceIds":{"vndbCharacterId":"c39879"},"originalCharacterName":"鬼ヶ島 ひかる","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"No way. Why do I have to do something so stupid?\""},{"spoiler":false,"text":"Personality Selfish, Moody, Monophobic"},{"spoiler":false,"text":"The heroine's twin brother. Following the customs of his family, he was enrolled in Shishiku Academy but upon learning of the existence of his twin sister he swapped places with her. In exchange, he entered an all-girls school as his younger sister. He enjoys his life of wearing female clothing and being a female high school student."},{"spoiler":false,"text":"Translation taken from Otome Jikan"}],"source":"vndb","sourceCharacterId":"c39879"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f297e7264cbd7dab25023f449fd45f3c3dd93643be1a3b443c6a1118a74b3366.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c51d5108cb44a9ef64c051dd8f2718e07574cb475f41e7d4dae0b221431562d1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"代永 翼","creatorId":"vndb:s291","sourcePersonId":"vndb:s291","canonicalEntityId":"vndb:s291","name":"代永 翼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64718","source":"vndb"}]},{"characterId":"char_vndb_c39880","characterName":"坂口 春生","sourceIds":{"vndbCharacterId":"c39880"},"originalCharacterName":"坂口 春生","characterNameSource":null,"role":"side","status":"source-only-