vndb:s27618","canonicalEntityId":"vndb:s27618","name":"Linktriforce007","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:43316","source":"vndb"},{"creditedName":"wavedash","creatorId":"vndb:s27654","sourcePersonId":"vndb:s27654","canonicalEntityId":"vndb:s27654","name":"Greg Deng","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:43317","source":"vndb"},{"creditedName":"ochareinja","creatorId":"vndb:s27799","sourcePersonId":"vndb:s27799","canonicalEntityId":"vndb:s27799","name":"ochareinja","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:43318","source":"vndb"},{"creditedName":"DragonSamurai55","creatorId":"vndb:s27612","sourcePersonId":"vndb:s27612","canonicalEntityId":"vndb:s27612","name":"Roman Stuart","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:43319","source":"vndb"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:43320","source":"vndb"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:43321","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:43322","source":"vndb"},{"creditedName":"酒井 童人","creatorId":"vndb:s635","sourcePersonId":"vndb:s635","canonicalEntityId":"vndb:s635","name":"酒井 童人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:43325","source":"vndb"},{"creditedName":"チーム・ちゃっちゃきロビン","creatorId":"vndb:s636","sourcePersonId":"vndb:s636","canonicalEntityId":"vndb:s636","name":"チーム・ちゃっちゃきロビン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:43326","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c18356","characterName":"戦乙女スヴィア","sourceIds":{"vndbCharacterId":"c18356"},"originalCharacterName":"戦乙女スヴィア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Clad in armor that shines emerald. Braided long hair and dark green eyes. Her features yet retain an innocence to them. She comes from a respectable pedigree of a family in Asgard. As a result of studying the sword and magic from a young age, her technique is second to none. Additionally, she educated herself diligently as a soldier, and her tactical planning is utterly top class."},{"spoiler":false,"text":"However, her uncompassionate conduct and occasionally selfish actions have left her in a not-so-high position amongst the Valkyries (the soldier squadron of Valhalla). Still, she is among the strongest of Valkyries, and it is difficult to say whether she or Sigurd is stronger. She carries one of the keys to the floodgates of the River of Wisdom, whose water flows into the roots of Yggdrasil, within her womb."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c18356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eaf27ee8c8b6e6c0c6fee876a2f9ff69e4dc59a2753e13fe075bcb213ef0d3f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7410571776664f06837228dd90eb678f40d7055d0d1818b92edc763cda8431d.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金松 由花","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23835","source":"vndb"}]},{"characterId":"char_vndb_c18357","characterName":"戦乙女シグルド","sourceIds":{"vndbCharacterId":"c18357"},"originalCharacterName":"戦乙女シグルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful girl with golden hair and agate eyes, who wears a traditional azure battle uniform. She was originally human, not a divine, but her bravery and technique with a blade was evident on sight and she became a Valkyrie. On the opposite side of the spectrum from firm and strong-minded, her emotions run deep. She’s warm-hearted and displays ladylike care. She has a big-sister disposition to her, and boasts a befitting popularity amongst the soliders."},{"spoiler":false,"text":"She handles a sword larger than she is as if it were light as a feather. In battle she’s a power fighter who takes the lead and mows down enemies in front of her. On the other hand, she also happens to have an intellectual side, and executes faithfully the strategies Svia comes up with without breaking a sweat. But as a Valkyrie, her human roots have left her at the lowest rank, and she was left behind on the march to rescue Odin to guard over Valhalla. As a result, when the Divine Forces were defeated, the troops she led became the final hope for Asgard."},{"spoiler":false,"text":"She’s Svia’s only friend. Also, like Svia, she carries one of the keys to the floodgates within her womb."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c18357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5f262dbe0f89e4e34ca55b2c24ee94b8f2e4183b2adade989876c4eaaecef89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/694b63f62619374330da8be92e8ebf780f5c01900be83b4043c697166a7adedb.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日 アン","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23836","source":"vndb"}]},{"characterId":"char_vndb_c93088","characterName":"ロキ","sourceIds":{"vndbCharacterId":"c93088"},"originalCharacterName":"ロキ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10d379004d3b8d1e75a8a5533be21cc63c2da692b073b1a775613c7bb24fd07e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aaca22ccdcd54a32667c2a5e5709b8a0ee583d5618825909d67272acaca117e.webp","width":177,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1413","sourceCompanyId":"egs:brand:1023","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8543:1023","source":"egs"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10711:v3458","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["publisher"],"identityStatus":"source-n