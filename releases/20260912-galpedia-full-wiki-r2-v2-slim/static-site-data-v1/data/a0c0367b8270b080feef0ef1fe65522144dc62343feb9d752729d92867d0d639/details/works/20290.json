ler":false,"text":"エロに関しては内向的であまり積極的ではないが、興味が無いわけでもないらしい。"},{"spoiler":false,"text":"「仕方ないじゃないですか。 まだ素人に毛が生えた程度なんです」"}],"source":"bangumi","sourceCharacterId":"25356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89e3f0c80850f0e263482d1f94c6765d09ee1e19a68ab66e727fb3900cc4b42e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1db5336e67c9cc907f26b8f7ebb5cb35e1bcca12e8b933d76fffe1296ce5af6e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98072:25356:6349:1","source":"bangumi"}]},{"characterId":"char_c20192","characterName":"三笠 ミライ","sourceIds":{"bangumi":[{"characterId":"25357","match":"exact-normalized-name-in-linked-work","subjectId":"98072"}],"egsCharacterIds":["3660"],"vndbCharacterId":"c20192"},"originalCharacterName":"三笠 ミライ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元々、ソロのプレイヤー（怪盗）。"},{"spoiler":false,"text":"しかし、成績が悪く、若くして引退の危機にあった所、主人公の元に送られる事になった。"},{"spoiler":false,"text":"多少、短絡的で腕力で解決しようとする傾向があり、怪盗に向いてないんじゃないかなぁと思われたりする。"},{"spoiler":false,"text":"エロ方向にオープンで、主人公に積極的。"},{"spoiler":false,"text":"巴の目を気にせずに迫ったり夜這いを掛けてくるので、色々と困らされる。"}],"source":"egs","sourceCharacterId":"3660","sourceWorkId":"20290","spoiler":false},{"segments":[{"spoiler":false,"text":"元々はソロのプレイヤー （怪盗）。"},{"spoiler":false,"text":"しかし成績が悪く、若くして引退の危機にあったところ、主人公のもとへ送られることになった。"},{"spoiler":false,"text":"多少、短絡的で腕力で解決しようとする傾向があり、怪盗に向いてないんじゃないかなぁと思われたりする。"},{"spoiler":false,"text":"エロ方向にオープンで、主人公に対して積極的。"},{"spoiler":false,"text":"巴の目を気にせずに迫ったり夜這いを掛けたりしてくるので、色々と困らされる。"},{"spoiler":false,"text":"「パンチラよりも、パンモロの方がエロいと思う」"}],"source":"bangumi","sourceCharacterId":"25357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bbf6bed9580802f2238e8c8a02f0bd60c102c8fd27842853995a5466ee060ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f3d8e5b5537ab1497d5ffaa53cd04a8eaec3b52b0ada423c012813920ea1785.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲乃藍里","creatorId":"vndb:s436","sourcePersonId":"vndb:s436","canonicalEntityId":"vndb:s436","name":"咲乃 藍里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98072:25357:5692:1","source":"bangumi"}]},{"characterId":"char_c20194","characterName":"山日野 瑠流","sourceIds":{"bangumi":[{"characterId":"25360","match":"exact-normalized-name-in-linked-work","subjectId":"98072"}],"egsCharacterIds":["3664"],"vndbCharacterId":"c20194"},"originalCharacterName":"山日野 瑠流","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『夜祭』所属の人間。"},{"spoiler":false,"text":"『夜祭』の意図や依頼を、善四郎に伝えるメッセンジャーの役目を持つ。"},{"spoiler":false,"text":"彼女の父親は『夜祭』の創始者の一人。"},{"spoiler":false,"text":"彼女が善四郎の担当になった事には何かの思惑があるかもしれない。"},{"spoiler":false,"text":"表の仕事も、善四郎の秘書をやっており、かなり善四郎に密着した人物。"},{"spoiler":false,"text":"ちなみに善四郎の表の仕事は巴やミライが通う"},{"spoiler":false,"text":"学園のオーナー兼事務員。"}],"source":"egs","sourceCharacterId":"3664","sourceWorkId":"20290","spoiler":false},{"segments":[{"spoiler":false,"text":"“夜祭” 所属の人間。"},{"spoiler":false,"text":"“夜祭” の意図や依頼を善四郎に伝えるメッセンジャーの役割を持つ。"},{"spoiler":false,"text":"彼女の父親は “夜祭” の創始者の一人。"},{"spoiler":false,"text":"彼女が善四郎の担当になったことには、何かの思惑があるかもしれない。"},{"spoiler":false,"text":"表の仕事も善四郎の秘書をやっており、かなり善四郎に密着した人物。"},{"spoiler":false,"text":"ちなみに善四郎の表の仕事は、巴やミライが通う学園のオーナー 兼 事務員。"},{"spoiler":false,"text":"「この書類にサインを頂けないと、仕事が進まないのですが……」"}],"source":"bangumi","sourceCharacterId":"25360"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2ca1be5d87d03f0fd56eab1bc0ba0cf3d361db580eaa4fc6bdf51dfcc245004c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71792e38c15ffd214ea1aad984ae68e9f884c769c2b00dd9e104d932d3d76dd9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98072:25360:5940:1","source":"bangumi"}]},{"characterId":"char_c38877","characterName":"ラグドール","sourceIds":{"bangumi":[{"characterId":"25362","match":"exact-normalized-name-in-linked-work","subjectId":"98072"}],"egsCharacterIds":["3666"],"vndbCharacterId":"c38877"},"originalCharacterName":"ラグドール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ベテランプレイヤー（怪盗）の一人。"},{"spoiler":false,"text":"下準備を怠らず、狙った獲物を確実に手にするタイプ。"},{"spoiler":false,"text":"宝石系の財宝を好んで狙う。"}],"source":"egs","sourceCharacterId":"3666","sourceWorkId":"20290","spoiler":false},{"segments":[{"spoiler":false,"text":"ベテランプレイヤー （怪盗） の一人。"},{"spoiler":false,"text":"下準備を怠らず、狙った獲物を確実に手にするタイプ。"},{"spoiler":false,"text":"宝石系の財宝を好んで狙う。"},{"spoiler":false,"text":"「気楽に行きましょう。 どうせ私の物になるんだから」"}],"source":"bangumi","sourceCharacterId":"25362"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bisho