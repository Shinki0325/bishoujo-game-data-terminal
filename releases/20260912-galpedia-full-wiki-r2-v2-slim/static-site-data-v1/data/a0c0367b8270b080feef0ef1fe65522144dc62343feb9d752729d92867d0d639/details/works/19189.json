"1599"],"vndbCharacterId":"c24393"},"originalCharacterName":"間宮 美冬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも微笑みを浮かべ、非常に穏やかで清楚な女性。言葉遣いも上品で誰に対しても礼儀正しい。"},{"spoiler":false,"text":"家事全般に長け、特に料理上手で、ガーデニングも得意だが、お菓子作りだけはなぜか下手。"},{"spoiler":false,"text":"元夫・現在の夫共に、セックスに関しては淡白。子供がいるものの性的に倒錯したプレイなどは未経験なうえ、良妻賢母であらねばというストレスからか、本人は気付かないものの、深層心理では熟れた身体を持て余し欲求不満になっている。"},{"spoiler":false,"text":"誰よりも家族思いであり、今回の再婚で主人公に早く心を開いて欲しいと思い、何かと世話を焼いてくる。そこを利用され、近親相姦的な行為を要求されるものの、暗示のせいでそれが家族のスキンシップだと誤認させられて段々と行為をエスカレートさせられていく。"}],"source":"egs","sourceCharacterId":"1599","sourceWorkId":"19189","spoiler":false},{"segments":[{"spoiler":false,"text":"ペンライトによる催眠を真っ先に受けた母親。"},{"spoiler":false,"text":"包み込んでくれるような優しさがあり、ついつい甘えたくなるような女性。"},{"spoiler":false,"text":"相変わらず主人公から歪んだ愛情を求められ続けるが何の疑問も持たずに受け入れる。"},{"spoiler":false,"text":"しかし、本当の母として意識してもらいたい美冬にとって形はなんであれ主人公から求められることが嬉しく、つい輪をかけて応えていく。"}],"source":"egs","sourceCharacterId":"1599","sourceWorkId":"24229","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義理の母親。 ペンライトによる催眠を真っ先に受けた。"},{"spoiler":false,"text":"包み込んでくれるような優しさがあり、ついつい甘えたくなるような女性。"},{"spoiler":false,"text":"主人公から歪んだ愛情を求められ続けているが、何の疑問も持たずに受け入れる。"},{"spoiler":false,"text":"本当の母として見てほしいと思っており、どんな形であれ求められると嬉びを感じる。"},{"spoiler":false,"text":"「本当に困ったら、遠慮なく言ってね。 何があっても、私は貴方の味方よ」"}],"source":"bangumi","sourceCharacterId":"60952"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"1599","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"1599","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"1599","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"1599","sourceWorkId":"19189","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1420b561465b65414e879924c39c0be8ceb7e8f8c7cca58685373fb2c33cf66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fe79f17201102d7e5804e7249e780807a5a8fe8eb4fb0e72dd91458ff0c764f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79505:60952:4940:1","source":"bangumi"}]},{"characterId":"char_c24394","characterName":"間宮 夏希","sourceIds":{"bangumi":[{"characterId":"60953","match":"exact-normalized-name-in-linked-work","subjectId":"226914"},{"characterId":"60953","match":"exact-normalized-name-in-linked-work","subjectId":"79505"}],"egsCharacterIds":["1600"],"vndbCharacterId":"c24394"},"originalCharacterName":"間宮 夏希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美冬の長女で、女子校に通う学生。母親ゆずりの巨乳と華やかで整った容姿。"},{"spoiler":false,"text":"見かけによらず根は素直ないい子で、ガードも堅く、性的な知識に関してはかなりの初心。"},{"spoiler":false,"text":"外面では明るく行動的で友達は多いが、小さい頃に父親を失っているせいか、親しい人間にも本当の感情をオープンにするのが下手で、家族に対する愛情表現もやや屈折している。その実、誰よりも家族のことを大切に思っていて、自分以外に家族のことを悪く言われると非常に機嫌が悪くなる。"},{"spoiler":false,"text":"本人はまだ主人公の事を家族と認めておらず、心を開いていない。そのため態度が冷たい。"}],"source":"egs","sourceCharacterId":"1600","sourceWorkId":"19189","spoiler":false},{"segments":[{"spoiler":false,"text":"美冬の長女。明るく元気な今時な女の子。"},{"spoiler":false,"text":"催眠を掛けるまでの冷かな態度はどこにいったのか、今では義理の兄である主人公のことを積極的に求めるようになっている。"},{"spoiler":false,"text":"兄妹というよりもどこか友達のような接し方で親しみを表現するが、"},{"spoiler":false,"text":"普通の友達同士ではやらないような変態行為を催眠によって簡単に受け入れるのだった。"}],"source":"egs","sourceCharacterId":"1600","sourceWorkId":"24229","spoiler":false},{"segments":[{"spoiler":false,"text":"美冬の長女。 明るく元気な今時の女の子。"},{"spoiler":false,"text":"かつての冷かな態度はなく、催眠によって主人公を積極的に求めるようになる。"},{"spoiler":false,"text":"兄妹というよりもどこか友達のような接し方で親しみを表現する。"},{"spoiler":false,"text":"ただし普通の友達同士ではやらないような変態行為も簡単に受け入れる。"},{"spoiler":false,"text":"「この前は、兄さんからあまりしてくれなかったから、ちょっと物足りなかったんだ」"}],"source":"bangumi","sourceCharacterId":"60953"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"1600","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"1600","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"1600","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"1600","sourceWorkId":"19189","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/867de387e1f2e74be1fa9a0c6983be3913fec9adad4404780fbde9bbe1aff341.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07ad5d84d06aaf9fafc91d6124cd01cbe82b15994f86627351e772a0e6eb762d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79505:60953:15637:1","source":"bangumi"}]},{"characterId":"char_c24395","characterName":"間宮 秋葉","sourceIds":{"bangumi":[{"characterId":"60954","match":"exact-normalized-name-in-linked-work","subjectId":"226914"},{"characterId":"60954","match":"exact-normalized-name-in-linked-work","subjectId":"79505"}],"egsCharacterIds":["1601"],"vndbCharacterId":"c24395"},"originalCharacterName":"間宮 秋葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美冬の次女。人目を惹く姉と違ってとても地味であり、性格も引っ込み思案。優秀な姉と比較されて低い評価を受けることが多く本人も気にしている。けなされるとすぐに落ち込み、その反面褒められると分かりやすく喜び、それらがそのまま態度にも出やすい。"},{"spoiler":false,"text":"趣味や嗜好の違いから、姉とは可愛らしい姉妹喧嘩になることが多いが、姉同様家族思いであり、優秀な姉をひそかに尊敬していて、それが冴えない自分を責めるコンプレックスになっている。"},{"spoiler":false,"text":"本人は主人公という兄が出来たことを非常に嬉しく思っている。しかし男性に触れる経験が殆ど無かったため、甘えたくても甘えられず、戸惑っている。"},{"spoiler":false,"text":"耳年増で性的知識は姉よりも豊富。"}],"source":"egs","sourceCharacterId":"1601","sourceWorkId":"19189","spoiler":false},{"segments":[{"spoiler":false,"text":"美冬の次女。姉である夏希とは違い大人しく、引っ込み思案な性格の女の子。"},{"spoiler":false,"text":"それもあってか姉に引っ張りまわされたり先を越されてしまうこともしばしば。"},{"spoiler":false,"text":"それが嫌だと言えるわけもなかったが、催眠によってたがが外れた秋葉は兄である主人公にべったりと甘えるようになる。"},{"spoiler":false,"text":"夏希とは違いむっつりさも相成って主人公が驚くような行動を取ることも。"}],"source":"egs","sourceCharacterId":"1601","sourceWorkId":"24229","spoiler":false},{"segments":[{"spoiler":false,"text":"美冬の次女。 姉の夏希とは違い、おとなしく引っ込み思案な女の子。"},{"spoiler":false,"text":"それもあってか、姉に引っ張り回されたり先を越されてしまうこともしばしば。"},{"spoiler":false,"text":"催眠によってタガが外れ、主人公にべったりと甘えるようになる。"},{"spoiler":false,"text":"夏希とは違いムッツリさも相まって、主人公が驚くような行動を取ることも。"},{"spoiler":false,"text":"「お兄ちゃんに褒めてもらえるなら、わたし、いつだって頑張るよ……」"}],"source":"bangumi","sourceCharacterId":"60954"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"1601","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"1601","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"1601","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"1601","sourceWorkId":"19189","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd91ba8b3b7fd2d53ed41d4d0c4b321ba837a7921829f05f924dd6352b69918a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cc3127c198a27d14d4be57570a43f8ad28d4a08efa64783b61fbe3f5490694d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞森柚子","creatorId":"egs:creator:36244","sourcePersonId":"egs:creator:36244","canonicalEntityId":"egs:creator:36244","name":"瑞森柚子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79505:60954:25171:1","source":"bangumi"},{"creditedName":"このえ ゆずこ","creatorId":"vndb:s995","sourcePersonId":"vndb:s995","canonicalEntityId":"vndb:s995","name":"このえ ゆずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53792","source":"vndb"}]},{"characterId":"char_c24396","characterName":"日野原 春珂","sourceIds":{"bangumi":[{"characterId":"60955","match":"exact-normalized-name-in-linked-work","subjectId":"226914"},{"characterId":"60955","match":"exact-normalized-name-in-linked-work","subjectId":"79505"}],"egsCharacterIds":["1602"],"vndbCharacterId":"c24396"},"originalCharacterName":"日野原 春珂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"171"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美冬の４つ違いの妹で、町内の総合病院である明桐病院に務めている女医。精神科担当。学生時代から秀才として名を馳せていたが「女の割りには」などと周りの男性と比べられることを嫌がり、医師という難関な道を歩む。そのためか姉とは対照的に強気な性格をしており、男性への態度はキツい。"},{"spoiler":false,"text":"特に主人公のように主体性がなく卑屈にみえる男性への態度は目に見えて硬くなる。"},{"spoiler":false,"text":"姉の美冬が主人公に対して優しく接することも「甘やかしている」と考え、快く思っていない。"},{"spoiler":false,"text":"また徹底的な現実主義者で、非科学的なことには拒否反応を示す。暗示や催眠などはフィクションでしかないと真っ向から否定しているが……"}],"source":"egs","sourceCharacterId":"1602","sourceWorkId":"19189","spoiler":false},{"segments":[{"spoiler":false,"text":"美冬の妹で、主人公達の叔母にあたる女性。"},{"spoiler":false,"text":"総合病院に勤める精神科医で「催眠なんてデタラメ」と断じてきたが、実際に催眠をかけられて辱めを受ける日々を送らされる羽目に。"},{"spoiler":false,"text":"そんな春珂は姉とは対照的に強気な性格で負けん気も強い。催眠の魔の手から姉たちを助け出そうと抵抗を続けていた。"},{"spoiler":false,"text":"しかし、いつしか自身も快楽に屈し始めてしまい理性との間で板ばさみをするようになっていた。"}],"source":"egs","sourceCharacterId":"1602","sourceWorkId":"24229","spoiler":false},{"segments":[{"spoiler":false,"text":"美冬の妹で、主人公たちの叔母にあたる女性。"},{"spoiler":false,"text":"総合病院に勤める精神科医で、「催眠なんてデタラメ」と断じてきた。"},{"spoiler":false,"text":"しかし実際に催眠をかけられて、辱めを受ける日々を送るハメになる。"},{"spoiler":false,"text":"強気な性格で負けん気も強く、姉たちを助け出そうと抵抗を続けていたが、"},{"spoiler":false,"text":"いつしか自身も快楽に屈し始め、理性との間で板ばさみになっている。"},{"spoiler":false,"text":"「調子に乗らないで。 私はまだ、認めきったわけじゃないんだからっ……」"}],"source":"bangumi","sourceCharacterId":"60955"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"1602","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"171 cm","valueContext":null,"source":"egs","sourceCharacterId":"1602","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"1602","sourceWorkId":"19189","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"1602","sourceWorkId":"19189","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b1455e196e0f07e60e9d6bb3b64cfa68c2c783ed4c69fa816b47cce8fe54ec2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21c965403b748331d82ce4bd57fbc34e0692d67f52d4cea37abf89397ba08a8a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79505:60955:6131:1","source":"bangumi"}]},{"characterId":"char_c38067","characterName":"間宮 雄一","sourceIds":{"bangumi":[{"characterId":"90158","match":"exact-normalized-name-in-linked-work","subjectId":"79505"}],"egsCharacterIds":["1598"],"vndbCharacterId":"c38067"},"originalCharacterName":"間宮 雄一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"子供の頃、仕事の鬼の父親に愛想をつかし、母親が浮気相手と出ていった為、多少屈折した性格になっている。父親から再婚の話を聞かされて動揺し浪人となってしまい、現在は予備校に通っている。"},{"spoiler":false,"text":"新しい家族との生活が始まったが、責めるべき父親は海外出張に出てしまい、成熟した大人の色香を放つ義母・美冬を含めた巨乳母娘との生活を続けていくなかで、性欲を押さえられなくなっていく。"},{"spoiler":false,"text":"身体は中肉中背なのだが性欲旺盛のうえ射精量も多く、自分の父親とは比べものにならない程の大きなペニスを所有している。性的嗜好はフェラ好きかつ潜在的な孕ませ好き。"},{"spoiler":false,"text":"家族愛に飢えており、最終的に新しい家族とひとつになりたいという願望を心のなかに持っている。それは母娘を孕ませて新しい自分の家族を作ろうとする目的につながっていく。"}],"source":"egs","sourceCharacterId":"1598","sourceWorkId":"19189","spoiler":false},{"segments":[{"spoiler":false,"text":"浪人で予備校に通っている主人公。"},{"spoiler":false,"text":"子供の頃、仕事の鬼の父親に愛想を尽かした母親が浮気相手と出ていったため、多少屈折した性格になっている。"},{"spoiler":false,"text":"新しい家族との生活が始まったが父親は海外出張に出てしまい、巨乳な義母・姉妹にひとり囲まれた生活を送ることになる。"},{"spoiler":false,"text":"身体は普通の中肉中背だが、性欲旺盛のうえ射精量も多く、父親とは比べものにならないほど大きなペニスを所有している。"},{"spoiler":false,"text":"性的嗜好はフェラ好き、かつ潜在的な孕ませ好き。"},{"spoiler":false,"text":"家族愛に飢えており、最終的に新しい家族とひとつになりたいと思っている。"},{"spoiler":false,"text":"それは、母娘を孕ませて新しい自分の家族を作ろうとする目的に繋がっていく……。"}],"source":"bangumi","sourceCharacterId":"90158"}],"profileFacts":[{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"1598","sourceWorkId":"19189","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9844eb0e32120de1acdcd2e4c54a6b0b69aef79d28c2b0fba98fa1da1393d63a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bed38a0e8b514b383b0c58fe84079ec4e42ad85c4177230836a40e179014b2fe.webp","width":256,"height":217,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p490","sourceCompanyId":"egs:brand:328","canonicalEntityId":"vndb:p490","name":"ルネ","roleCodes":["brand"],"identityStatus":"auto-confirmed","rela