roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:31781","source":"vndb"},{"creditedName":"内田 明理","creatorId":"vndb:s7590","sourcePersonId":"vndb:s7590","canonicalEntityId":"vndb:s7590","name":"内田 明理","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:31783","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c4000","characterName":"主人公","sourceIds":{"vndbCharacterId":"c4000"},"originalCharacterName":"主人公","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year High School student just transferred to Towano High School. Soon after he joins the library committee, the tennis club and a part time job at a family restaurant. He's the only character you can name in the game, and you may choose to refer in first person as ore (俺?) or boku (僕?) (both are the male form of \"I,\" although \"Ore\" is considered more masculine). In the Loveplus Rinko Days manga his name is Wataru Aikawa."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4000"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c4001","characterName":"高嶺 愛花","sourceIds":{"vndbCharacterId":"c4001"},"originalCharacterName":"高嶺 愛花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1005"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year high school student who goes to the same after school tennis club with the protagonist. She comes from a well-off family and has lived a sheltered life, having no experience in many \"normal\" things like eating a hamburger combo, going out with her friends after the club, or watching TV. Her classmates shy away from her perfectionism, which is why she has few friends."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4372f849689ad00ecc9ec892dc398c8274e070f5a1577a045a5b78dedb486db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a63eba31e3f7425ca93b8b32b3c54a83673b78a9d614ba1836da67d1bfcf004e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早見 沙織","creatorId":"vndb:s1871","sourcePersonId":"vndb:s1871","canonicalEntityId":"vndb:s1871","name":"早見 沙織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:16774","source":"vndb"}]},{"characterId":"char_vndb_c4002","characterName":"小早川 凛子","sourceIds":{"vndbCharacterId":"c4002"},"originalCharacterName":"小早川 凛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"817"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year high school student who the protagonist meets after being forced to join the library committee. She constantly wears earphones and has an attitude that keeps people away from her. Rinko's attitude stems from her feeling alienated and unwanted in her home after her father remarried, bringing a new mother and younger brother into the house. \"Whenever I am home, the atmosphere darkens\", as Rinko described. She wanders the streets afte