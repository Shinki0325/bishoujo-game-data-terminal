年下。めったなことでは怒りをあらわにしない。暗いところが苦手で夜には一人でトイレにも行けない女の子。"}],"source":"bangumi","sourceCharacterId":"66413"}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"25806","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"25806","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"25806","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"25806","sourceWorkId":"7164","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0fb62511d126069ab40102f7e72e833a43b7b543926bf6cdf53ac9df34ba1d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43dab436e844a083e119a5e3ffc5a420495c09a479709ad5f02a6299ec5211ae.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262237:66413:4956:1","source":"bangumi"}]},{"characterId":"char_c56674","characterName":"七條 このえ","sourceIds":{"bangumi":[{"characterId":"66414","match":"exact-normalized-name-in-linked-work","subjectId":"262237"}],"egsCharacterIds":["25807"],"vndbCharacterId":"c56674"},"originalCharacterName":"七條 このえ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"96"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の教え子の一人。18歳。"},{"spoiler":false,"text":"先祖代々の軍人の家系に生まれ、自らもその道を選んだエリート。"},{"spoiler":false,"text":"性格は至ってクールで口数も少なく、あまり人付き合いも良くない。"},{"spoiler":false,"text":"しかし、やや直情型の傾向があり、感情を爆発させてしまうこともしばしば。"},{"spoiler":false,"text":"父親を“メギン（＝モンスターのようなもの）”に殺害されたことから、そのメギンを討伐する「メギンエージェント」になることを決意する。"},{"spoiler":false,"text":"射撃の腕前は超一流。"}],"source":"egs","sourceCharacterId":"25807","sourceWorkId":"7164","spoiler":false},{"segments":[{"spoiler":false,"text":"代々バリバリのエリート軍事家系に生まれた美少女。自らに軍人としての責務を強く課しており、それにふさわしい思考を持つ。父親（軍人）をメギンに殺されており、その意志を引き継ぐために、メギンエージェントになることを決意する。"},{"spoiler":false,"text":"クールな性格で人付き合いが良くないが、ときおり直情的で感情的な一面（拳銃をぶっぱなしたりする）を併せ持つ一時的プッツン少女。最大の悩みは胸が大きすぎて射撃に邪魔になっている事。"}],"source":"bangumi","sourceCharacterId":"66414"}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"25807","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"25807","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"25807","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"25807","sourceWorkId":"7164","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cfc40733bdadebf91c21c7ab80b65e71e0b4c77c7e67fd6be1854e25659f0e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb26827cd373377988e557350efc52c58f178248db93875ff64d4a7b8cf1c320.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"望月まゆ","creatorId":"vndb:s1020","sourcePersonId":"vndb:s1020","canonicalEntit