って桃源学園に入学した。"},{"spoiler":false,"text":"まほろば防衛大学に進学し、卒業すれば士官待遇を得て、給金の高い職場が保障されることから、躍起になって勉強している。"},{"spoiler":false,"text":"これまでは家族に楽をさせたいと思って頑張ってきたが、「メギンエージェント」の仕事の危険性を知るに連れて、自分自身のことも考え始めるようになった。"}],"source":"egs","sourceCharacterId":"25810","sourceWorkId":"7164","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"25810","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"25810","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"25810","sourceWorkId":"7164","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"25810","sourceWorkId":"7164","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bf7366085dcbc89cde6c8d2edad01bd73a3465d3a0c31285b381de97dd91552.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2be662891fdbc88c2d6f0354708e731a8547ac2e02e65773cea373b12b3fecf4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅里 ミーオ","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31637","source":"vndb"}]},{"characterId":"char_c56678","characterName":"足立 綾菜","sourceIds":{"bangumi":[{"characterId":"204088","match":"exact-normalized-name-in-linked-work","subjectId":"262237"}],"egsCharacterIds":["25811"],"vndbCharacterId":"c56678"},"originalCharacterName":"足立 綾菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-confli