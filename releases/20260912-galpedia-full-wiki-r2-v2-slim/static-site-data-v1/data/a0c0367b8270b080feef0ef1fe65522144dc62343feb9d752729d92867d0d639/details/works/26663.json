{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26663","model":{"presentationWorkId":"vndb:v18291","staff":{"artwork":[{"creditedName":"ゴゴちゃん","creatorId":"vndb:s6481","sourcePersonId":"egs:creator:28633","canonicalEntityId":"vndb:s6481","name":"ゴゴちゃん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197812","source":"egs"},{"creditedName":"トガタ","creatorId":"vndb:s14972","sourcePersonId":"egs:creator:28634","canonicalEntityId":"vndb:s14972","name":"トガタ","detail":"SD原画","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197813","source":"egs"}],"scenario":[{"creditedName":"高岡果林(岡果輪)","creatorId":"vndb:s2378","sourcePersonId":"egs:creator:4915","canonicalEntityId":"vndb:s2378","name":"高岡果林(岡果輪)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197814","source":"egs"},{"creditedName":"落合海","creatorId":"vndb:s14973","sourcePersonId":"egs:creator:28635","canonicalEntityId":"vndb:s14973","name":"落合海","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197815","source":"egs"},{"creditedName":"御門蓮","creatorId":"vndb:s14974","sourcePersonId":"egs:creator:28636","canonicalEntityId":"vndb:s14974","name":"御門蓮","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197816","source":"egs"},{"creditedName":"ゆら あやと","creatorId":"vndb:s14976","sourcePersonId":"egs:creator:32460","canonicalEntityId":"vndb:s14976","name":"ゆら あやと","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197817","source":"egs"},{"creditedName":"おうさか美穂","creatorId":"vndb:s14977","sourcePersonId":"egs:creator:32461","canonicalEntityId":"vndb:s14977","name":"おうさか美穂","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197818","source":"egs"}],"music":[],"other":[{"creditedName":"佐和真中","creatorId":"vndb:s864","sourcePersonId":"egs:creator:16635","canonicalEntityId":"vndb:s864","name":"佐和真中","detail":"OP曲「Spiral Memory」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:213325","source":"egs"},{"creditedName":"佐和 真中","creatorId":"vndb:s864","sourcePersonId":"vndb:s864","canonicalEntityId":"vndb:s864","name":"佐和真中","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:124527","source":"vndb"},{"creditedName":"ゴゴちゃん","creatorId":"vndb:s6481","sourcePersonId":"vndb:s6481","canonicalEntityId":"vndb:s6481","name":"ゴゴちゃん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:124529","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c50398","characterName":"香月 蓮","sourceIds":{"vndbCharacterId":"c50398"},"originalCharacterName":"香月 蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Haa, won't you just acknowledge my existence already?\""},{"spoiler":false,"text":"An 'artificial god' that lives at the Haruki Shrine. He's the reason the protagonist has lost the memories of her childhood."},{"spoiler":false,"text":"He used to be a regular human, but after he became a subject for the 'Artificial God Program' all of his memories of being human were erased."},{"spoiler":false,"text":"His god powers were sealed along with the protagonist's memories. And because of that his way of thinking is closer to humans than the other artificial gods."},{"spoiler":false,"text":"He thinks that it was his fate to become an artificial god, but at his root he longs to be a normal human."},{"spoiler":false,"text":"He's cooperating with Touma in order to fulfill some kind of duty, but he wants to be closer to the protagonist so he transfers into her university."}],"source":"vndb","sourceCharacterId":"c50398"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4485ebcfb0719e4284a937266cd5f52d196fee1090d50008a03cbf7d14b7ff5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/977f249812c5cc5ff63c736a0f69f3afe2f215f3e29a72f2541d8bba0532a28c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐和 真中","creatorId":"vndb:s864","sourcePersonId":"vndb:s864","canonicalEntityId":"vndb:s864","name":"佐和真中","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66311","source":"vndb"}]},{"characterId":"char_vndb_c50399","characterName":"香月 湊","sourceIds":{"vndbCharacterId":"c50399"},"originalCharacterName":"香月 湊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"924"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You don't have to worry about the house. I just want you to do whatever you feel like.\""},{"spoiler":false,"text":"The protagonist's non-blood related older brother."},{"spoiler":false,"text":"A kind and serious person who raised Sayu by himself after their parent's died."},{"spoiler":false,"text":"He gets along well with her and gives off quite the siscon vibe."},{"spoiler":false,"text":"Before his parents died he found out that he's not actually blood related to their family, but he hasn't told Sayu the truth yet."},{"spoiler":false,"text":"He doesn't have memories of his true parents, but he doesn't wish to meet those parents who abandoned him. He's thankful to the Katsuki family for taking him in and teaching him about warm family feelings. He's determined to protect Sayu himself."},{"spoiler":false,"text":"He has a normal amount of love experience, but he prioritizes Sayu above anything else and courteously distances himself from others."},{"spoiler":false,"text":"He looks like an ordinary government worker, but he actually works at a government facility to create artificial gods that is underneath the Haruki Shrine."}],"source":"vndb","sourceCharacterId":"c50399"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0a03d9999c17998d26034fbf0e21fe479dec95d888fee84a09d67d4592da160.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c22c10887c3a206ee10ad5e29b0dee2f8d56c4efa18b7db6a1c585cf5eee23b1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河村 眞人","creatorId":"vndb:s457","sourcePersonId":"vndb:s457","canonicalEntityId":"vndb:s457","name":"山中 真尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66308","source":"vndb"}]},{"characterId":"char_vndb_c50400","characterName":"国方 瑛太","sourceIds":{"vndbCharacterId":"c50400"},"originalCharacterName":"国方 瑛太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"812"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Sayu, no... It's been a while Katsuki.\""},{"spoiler":false,"text":"The protagonist's childhood friend, he was at her side when she lost her memories."},{"spoiler":false,"text":"He always played with Sayu and Minato when they were younger. He was bullied then because of his cute appearance and was protected by the tomboy Sayu."},{"spoiler":false,"text":"Now that he's grown up he wants to become stronger to protect her instead, so he started training kendo in the dojo behind the Haruki Shrine with Touma as his teacher."},{"spoiler":false,"text":"He also joined the kendo club at school and aims to become their ace, but because of his kendo infused lifestyle he isn't good at studying. However he's a bright and friendly guy who is the center of attention in class. He's pretty popular with the girls at school too, but he doesn't pay it much mind."},{"spoiler":false,"text":"After being reunited with Sayu after her parents died, he wants to get their past relationship back, so he starts helping Ren with trying to find her memories."}],"source":"vndb","sourceCharacterId":"c50400"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d9c45a19314e5121eef4c96001aef1df9964c279a910d1f445195d04af55e8a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02e78df897e7579404e6203fa20a00ae2e8f51a929722d68cd49a21ed39e6825.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"四ツ谷 サイダー","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66309","source":"vndb"}]},{"characterId":"char_vndb_c50401","characterName":"速水 理玖","sourceIds":{"vndbCharacterId":"c50401"},"originalCharacterName":"速水 理玖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"924"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Shall I teach you Katsuki-san? You're worried about the test right?\""},{"spoiler":false,"text":"The protagonist's homeroom teacher at the academy."},{"spoiler":false,"text":"He's always calm and smiling and is popular with the students and other teachers."},{"spoiler":false,"text":"But he really has an unconcerned attitude of 'what will be will be' about himself and others. He avoids interacting with others and his private life is cloaked in mystery."},{"spoiler":false,"text":"He's lost his memories of his childhood, but since it doesn't affect his current life he doesn't pay it much mind."},{"spoiler":false,"text":"Because he resembles her older brother Minato, the protagonist adores him."},{"spoiler":false,"text":"After talking with him about her memories she was really interested to learn that he seems to have the same situation with losing his childhood memories as her."},{"spoiler":false,"text":"After that he began to show her more of his true self and he started thinking of her like a little sister."},{"spoiler":false,"text":"He currently lives alone in an apartment close to the academy."}],"source":"vndb","sourceCharacterId":"c50401"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7499e825d2c70113c5f0122aa55025c48e41fc64ea347f72d27e534f7a082903.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc614674644d01ab4a4709dc6275b35c9ae635a00e93060c49b182ac02c15e3e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒井 勇","creatorId":"vndb:s6948","sourcePersonId":"vndb:s6948","canonicalEntityId":"vndb:s6948","name":"白井悠介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66312","source":"vndb"}]},{"characterId":"char_vndb_c50402","characterName":"香月 斗真","sourceIds":{"vndbCharacterId":"c50402"},"originalCharacterName":"香月 斗真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1126"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"It's been a while Sayu. I'm the one in charge of this place now, if you have any questions feel free to ask.\""},{"spoiler":false,"text":"He knows that his father and the protagonist's father had a succession battle about who would take over the Haruki Shrine, but he thinks that it has nothing to do with him so he holds no ill will towards Sayu and they get along well."},{"spoiler":false,"text":"He helps support her with her part time job."},{"spoiler":false,"text":"His job is to support the artificial god Ren and help purify the 'impurities' that were also created when the artificial gods were."},{"spoiler":false,"text":"He thinks of Ren as a troublesome little brother rather than revering him as a god."},{"spoiler":false,"text":"He's the one who knows all the secrets of the artificial god program and the Katsuki family."}],"source":"vndb","sourceCharacterId":"c50402"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8bb256ffe79ad2d0101592d37c496d503d29347b1a5911644dc5367ebccc2e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7cc5dc50d13c606f934eebafa34b277c05859aaf0de3f30c3e680c5e5c85935.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"土門 熱","creatorId":"vndb:s683","sourcePersonId":"vndb:s683","canonicalEntityId":"vndb:s683","name":"佐藤 拓也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66310","source":"vndb"}]},{"characterId":"char_vndb_c50403","characterName":"香月 紗結","sourceIds":{"vndbCharacterId":"c50403"},"originalCharacterName":"香月 紗結","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"913"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Gods? There's no way things like that exist...\""},{"spoiler":false,"text":"Her parents used to live in the neighborhood near the Haruki Shrine, but after they died she moved into an apartment near her academy with her older brother."},{"spoiler":false,"text":"She's supposed to be in charge of the cooking, laundry, and other household chores, but her brother does most of it."},{"spoiler":false,"text":"She was a tomboy when she was younger but she started acting more bright after her parent's died in order not to worry her brother."},{"spoiler":false,"text":"She's lost her memories of her childhood, but she doesn't think much of it and thinks that it's just regular fading with time."},{"spoiler":false,"text":"She is sociable and has many friends, but she finds it hard to show her true feeling to people. She doesn't have much interest in love and she has never had a boyfriend."},{"spoiler":false,"text":"Neither studying nor moving her body are her strong point, she's an average girl with no strong or weak points."},{"spoiler":false,"text":"She wants to hurry up and become independent so she works part time at the Haruki Shrine."},{"spoiler":false,"text":"She's a realist who doesn't believe in things like gods, but then she met the self styled 'god' Ren."},{"spoiler":false,"text":"After learning that her childhood memories were sealed along with Ren's god powers she only half believed it, but she feels something strange when she's with him, so she starts to search for her missing memories along with him."}],"source":"vndb","sourceCharacterId":"c50403"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3345e36940964804d486e4e8adf3837f2742b4bb09abe3fc5ba690dda6d5a979.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c7f14986a33ccfb40b457663ba5009621b8644c59b8312f6daed02a4ea70238.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3638","sourceCompanyId":"egs:brand:4199","canonicalEntityId":"vndb:p3638","name":"dramatic create","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26663:4199","source":"egs"},{"companyId":"vndb:p22878","sourceCompanyId":"vndb:p22878","canonicalEntityId":"vndb:p22878","name":"Flamecho","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:153633:v18291","source":"vndb"},{"companyId":"vndb:p3471","sourceCompanyId":"vndb:p3471","canonicalEntityId":"vndb:p3471","name":"アズリング","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:49025:v18291","source":"vndb"},{"companyId":"vndb:p3471","sourceCompanyId":"vndb:p3471","canonicalEntityId":"vndb:p3471","name":"アズリング","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:55379:v18291","source":"vndb"},{"companyId":"vndb:p3471"