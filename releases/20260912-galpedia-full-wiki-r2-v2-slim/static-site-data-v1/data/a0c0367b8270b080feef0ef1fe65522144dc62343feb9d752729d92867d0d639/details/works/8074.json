ler":false,"text":"操の兄、事代裕太に対し、秘めた想いを抱いている。"}],"source":"egs","sourceCharacterId":"24617","sourceWorkId":"8074","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公（操）が通う学校の、執行部会長。"},{"spoiler":false,"text":"ショートの髪にメガネ、細めの体型にきつめの容貌をしている。"},{"spoiler":false,"text":"幼い頃からの教育の影響もあってか、規律を重視するタイプ。"},{"spoiler":false,"text":"堅物で口調も語る内容も厳しく、周囲からは浮きつつも会長としては有能。"},{"spoiler":false,"text":"だが本来は強い人間ではなく、強くありたいと願っているだけの少女。"},{"spoiler":false,"text":"実は、操の兄【事代裕太】に対し秘めた想いを抱いている。"}],"source":"bangumi","sourceCharacterId":"68963"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26d55a37b43bcf44e929f77606bff244e3e1507da22a0ac8663a1d3a099f8736.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90cf989657d6be61ce290460e5c792dadb0d6f4b14b3feecb2c12ef8ffa8f492.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"此花 ゆりな","creatorId":"vndb:s1697","sourcePersonId":"vndb:s1697","canonicalEntityId":"vndb:s1697","name":"七生みこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3944","source":"vndb"}]},{"characterId":"char_c36283","characterName":"香坂 百合子","sourceIds":{"bangumi":[{"characterId":"68964","match":"exact-normalized-name-in-linked-work","subjectId":"265740"}],"egsCharacterIds":["24619"],"vndbCharacterId":"c36283"},"originalCharacterName":"香坂 百合子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学校の国語教師。"},{"spoiler":false,"text":"ルールや規律を重視する、超堅物な女性。"},{"spoiler":false,"text":"あまりに厳しく、杓子定規な部分があるため、学生達からは実は不人気。"},{"spoiler":false,"text":"陰では「いきおくれ」などとあだ名されることも……。"},{"spoiler":false,"text":"実は処女。"}],"source":"egs","sourceCharacterId":"24619","sourceWorkId":"8074","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公（操）が通う学校の国語教師。"},{"spoiler":false,"text":"ルールや規律を重視する、超堅物な女教師。"},{"spoiler":false,"text":"あまりに厳しく杓子定規な部分があるため、学生達からはやや不人気。"},{"spoiler":false,"text":"陰では「行き遅れ」などとあだ名される事も……。実は処女。"}],"source":"bangumi","sourceCharacterId":"68964"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/2557dea5e19b4804297f3be854f563b3dfffe9050ce73ea27b258114813b28e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cfd48f9831327facee08e17922d534769f1e06784ebaeb7611f493ca3e72c3c.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"歌織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265740:68964:12717:1","source":"bangumi"}]},{"characterId":"char_c36284","characterName":"仁科 翔子","sourceIds":{"bangumi":[{"characterId":"68967","match":"exact-normalized-name-in-linked-work","subjectId":"265740"}],"egsCharacterIds":["24618"],"vndbCharacterId":"c36284"},"originalCharacterName":"仁科 翔子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学校の保健医。"},{"spoiler":false,"text":"セクシーなスタイルと、端正な顔立ちをした女性。"},{"spoiler":false,"text":"優しく頼りがいがあり、学生の良き理解者。"},{"spoiler":false,"text":"学生達の憧れの的となっていて、言い寄られる事も多いが、相手を傷つけることなくはぐらかす事の出来る大人の女性。"}],"source":"egs","sourceCharacterId":"24618","sourceWorkId":"8074","spoiler":false},{"segments":[{"spoiler":false,"text":"学校の保健医。"},{"spoiler":false,"text":"セクシーなスタイルと、ウェーブがかったロングヘア、そして端正な顔立ちをした女性。"},{"spoiler":false,"text":"一見、ゴージャス系な女性に見られがちだが、高飛車な所は無い。"},{"spoiler":false,"text":"優しく頼りがいがある、学生の良き理解者。そういったことか