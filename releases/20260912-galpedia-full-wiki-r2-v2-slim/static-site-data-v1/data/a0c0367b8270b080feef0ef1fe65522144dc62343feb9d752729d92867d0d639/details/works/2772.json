:{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/774558a44c91291c3e294e881030d4260322a1f50eb7906d5632881d3157918e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f0b5972452f6f0f7504c242a19b909b1aa773fc16a5e5defce11d530185029d.webp","width":200,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c77279","characterName":"沖田 愛美","sourceIds":{"vndbCharacterId":"c77279"},"originalCharacterName":"沖田 愛美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"34"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The wife of a dry cleaner in a nearby shopping district. 34 years old."},{"spoiler":false,"text":"She is a cheerful, upbeat woman who supports the family-run store."},{"spoiler":false,"text":"The main character's father, who is a widower, asks her to do their laundry as well as their dry cleaning. The main character also treats her well, so they are like friends."},{"spoiler":false,"text":"She takes pity on the protagonist, who is a very healthy person. She is very kind to the main character, perhaps because of this."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c77279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa63240827442763bb361889ce7c2fa9f628d0873449a9c4768fe96ad5fc0c21.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14ad6157893e4a2cd4fe600bdfcad80eb8ac8187b67a0d1a9c07df92d9979063.webp","width":200,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c77280","characterName":"田沼 幸恵","sourceIds":{"vndbCharacterId":"c77280"},"originalChara