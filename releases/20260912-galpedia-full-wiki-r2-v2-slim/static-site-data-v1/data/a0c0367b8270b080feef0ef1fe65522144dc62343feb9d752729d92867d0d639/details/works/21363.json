Id":"21363","spoiler":false},{"segments":[{"spoiler":false,"text":"慎之助の同級生で特に仲のいい友人。"},{"spoiler":false,"text":"本当は慎之助と同じ学校に進学しようとしていたのだが、慎之助が落ちてしまい叶わなかった。"},{"spoiler":false,"text":"そのことを受験に失敗した本人以上に残念がっている。"},{"spoiler":false,"text":"外見的には線の細い美少年で、振る舞いもことごとく可愛らしいため、ほとんどの人間が女性と勘違いする。"},{"spoiler":false,"text":"しかも本人にまったく自覚が無いので、新しい世界に目覚めた人々を周囲に生み続けている。"},{"spoiler":false,"text":"おとなしい性格だが身体を動かすのが好きで、特に野球が大好き。"},{"spoiler":false,"text":"休日にはよく慎之助をキャッチボールに誘っている。"},{"spoiler":false,"text":"「本当を言うとね、慎之助と同じ学校に行きたかったんだ」"}],"source":"bangumi","sourceCharacterId":"31285"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"31285","value":"小山田学院 1年生"},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"6242","sourceWorkId":"21363","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3918bff7a89919d12a5fd532a93b2eae08a24e8f9cfb34799f021d37553b23a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d6e318fa178bce28b20b64a679373137b9e2cc90c96149c906a0148b9c859e0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:120279:31285:4689:1","source":"bangumi"}]},{"characterId":"char_vndb_c166670","characterName":"桜坂 慎之助","sourceIds":{"vndbCharacterId":"c166670"},"originalCharacterName":"桜坂 慎之助","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:1466","sourceCompanyI