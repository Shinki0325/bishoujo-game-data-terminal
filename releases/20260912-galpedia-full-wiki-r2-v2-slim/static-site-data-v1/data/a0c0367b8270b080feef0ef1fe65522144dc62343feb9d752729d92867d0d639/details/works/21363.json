-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1010"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"慎之助の従妹で、由羽子の双子の姉。 妹と共に天海学院に通っている。"},{"spoiler":false,"text":"表を歩けば妹と並んで美人双子で通るのだが、実際は怠け者。"},{"spoiler":false,"text":"学院から帰るとすぐに部屋に引きこもってしまうため、慎之助とはほとんど顔を合わせることがない。"},{"spoiler":false,"text":"ただチャットを介しては毎日のように話をしている。 その会話内容は一般人には意味不明なほどネットスラングだらけである。"},{"spoiler":false,"text":"そんな彼女であるが、根の部分は実は寂しがり屋。"},{"spoiler":false,"text":"由羽子が天海学院を受験したいと言い出した時、離れ離れになるのが嫌で同じ学院を受験した。"},{"spoiler":false,"text":"その際、自宅ではほとんど勉強をしていないにも関わらず、あっさり受験を突破してしまうほどの天才肌である。"},{"spoiler":false,"text":"また妹に頼まれて受験勉強を見てあげるなど、お姉さんらしい一面も持っている。"},{"spoiler":false,"text":"「できるなら由羽子ちゃんとお兄ちゃんに面倒をみてもらいながら、一生引きこもって過ごしたい」"}],"source":"bangumi","sourceCharacterId":"33186"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"33186","value":"天海学院 3回生"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"6243","sourceWorkId":"21363","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"6243","sourceWorkId":"21363","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"144 cm","valueContext":null,"source":"egs","sourceCharacterId":"6243","sourceWorkId":"21363","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"6243","sourceWorkId":"21363","sourceField":null,"scoped":true},{"label":"腰围（本版本）","v