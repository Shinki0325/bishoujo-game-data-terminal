12","sourcePersonId":"vndb:s5012","canonicalEntityId":"vndb:s5012","name":"かわうそP","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:115986","source":"vndb"},{"creditedName":"cao.","creatorId":"vndb:s12910","sourcePersonId":"vndb:s12910","canonicalEntityId":"vndb:s12910","name":"cao.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:115987","source":"vndb"}]},"cast":[{"characterId":"char_c1562","characterName":"泉戸 ましろ","sourceIds":{"bangumi":[{"characterId":"1801","match":"source-roster","subjectId":"114064"},{"characterId":"1801","match":"source-roster","subjectId":"131917"},{"characterId":"1801","match":"source-roster","subjectId":"18333"},{"characterId":"1801","match":"source-roster","subjectId":"198439"},{"characterId":"1801","match":"exact-normalized-name-in-linked-work","subjectId":"3177"},{"characterId":"1801","match":"source-roster","subjectId":"3177"}],"egsCharacterIds":["8239"],"vndbCharacterId":"c1562"},"originalCharacterName":"泉戸 ましろ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"403"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She calls Yuuri her husband. Pretty obvious from her cute ears that she isn’t a human. She has considerable power even among the tayutama and hopes for the union of humans and tayutama. She doesn’t get the current technology so it’s pretty funny to see her fumble around with it. She has a pretty optimistic and cute personality. Florence student."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c1562"},{"segments":[{"spoiler":false,"text":"創聖学院女子学部（フローレス）カリキュラムＳ受講生（最上級生）。"},{"spoiler":false,"text":"裕理を「夫」と呼び、積極的にアタックしてくる太転依（たゆたい）の娘。"},{"spoiler":false,"text":"その姿勢は何かを覚悟しているように見え、なし崩し的に泉戸家に住むことに。"},{"spoiler":false,"text":"知識が全体的に古く、能天気で寛容的だが、怒ると恐ろしい。"},{"spoiler":false,"text":"アメリとは裕理と巡った恋のライバル。"},{"spoiler":false,"text":"「私はいつでも、どんな時でも、裕理さんの味方ですから」"}],"source":"egs","sourceCharacterId":"8239","sourceWorkId":"10100","spoiler":false},{"segments":[{"spoiler":false,"text":"最強の力を持った太転依、綺久羅美守毘売の化成した姿。"},{"spoiler":false,"text":"人と太転依との共存を志し、芦原町での事件の後、夫である裕理と共に全国を精力的に巡っていた。"},{"spoiler":false,"text":"鷹千帆が国内でも特に濃い神気の集まる土地であることが発覚し、矢古民町に八衢神社が建立されてからは、泉戸こはくと共にと2人で暮らしている。"},{"spoiler":false,"text":"礼節正しい大人の女性だが、自分の意見を曲げない頑固なところがあったり、子供のようにはしゃいでしまったり、娘のように可愛がっているこはくに対して親バカっぷりを発揮したりすることもある。"},{"spoiler":false,"text":"裕理とは精神的に繋がっており、いつでも言葉を交わせるため、そういう意味で寂しさは感じることは無いのだが、こはくと空のやり取りなどを見ていると、つい羨ましくなって、裕理に泣き付くこともある。"},{"spoiler":false,"text":"好きな物はましゅまろ。"},{"spoiler":false,"text":"最近、恋愛小説を読み始め、夢中になってしまっているらしい。"}],"source":"egs","sourceCharacterId":"8239","sourceWorkId":"21942","spoiler":false},{"segments":[{"spoiler":false,"text":"开学日突然出现的少女，创圣学院女子学部S课程学生（最上级生）。其真正身分是以前绮久罗美守毗卖“化成”的太转依，懂得使用咒术，“真白”是裕理取的名称。外表和人类分表不大，但有狐耳和尾。知识非常古老，不懂得操作电器。对裕理在恋爱上积极展开攻势，之后更住在泉户家。保持着绮久罗美守毗卖的思想和记忆，要和裕理创造“人类和太转依共存的世界”。"}],"source":"bangumi","sourceCharacterId":"1801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5549be002b3b6a27ab520da7fe6dd389c0e8888428aeb5c7ee8e0de857ad79d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee11443c5c871897273d9d33cd90fe64f24fcfe3f47aa19b7e0f9c781dd5572e.webp","width":168,"height":256,"source":"static-de