idate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1010"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"67"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AAA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"慎之助の従妹にあたる一歳年下の双子姉妹の妹で彼のことを兄として慕っている。"},{"spoiler":false,"text":"両親が慎之助の家の隣に建っているマンションの管理人であるため、独り暮らしの慎之助の様子を見るために、ときどき家にやってくる。"},{"spoiler":false,"text":"慎之助が通うことになる天海学院に姉と共に通っており、彼女を知る人は口を揃えて、明るくしっかり者で、礼儀正しい女の子と評するが、ある一点において、慎之助は彼女のことを心から恐れている。"},{"spoiler":false,"text":"それは彼女が家にやってくるたびに、慎之助の部屋を掃除したがり、ひとたび彼女の『整頓』が始まってしまうと部屋に隠された秘蔵のエロ的品々がすべて暴かれてしまうからだ。"},{"spoiler":false,"text":"しかし本人には悪気はまったくなく、ただ純粋に慎之助の世話を焼きたいだけである。"},{"spoiler":false,"text":"実は勉強はあまり得意ではなく、努力によって何とかするタイプ。"},{"spoiler":false,"text":"天海学院の入試も、抜群に頭のきれる姉に教わって突破した。"}],"source":"egs","sourceCharacterId":"6240","sourceWorkId":"21363","spoiler":false},{"segments":[{"spoiler":false,"text":"慎之助の従妹にあたる一歳年下の双子姉妹の妹で、彼のことを兄として慕っている。"},{"spoiler":false,"text":"両親が慎之助の家の隣に建っているマンションの管理人であるため、独り暮らしの慎之助の様子を見るためにときどき家にやってくる。"},{"spoiler":false,"text":"慎之助が通うことになる天海学院に姉とともに通っており、彼女を知る人は口を揃えて明るくしっかり者で礼儀正しい女の子と評するが、ある一点において慎之助は彼女のことを心から恐れている。"},{"spoiler":false,"text":"彼女が家にやってくるたびに慎之助の部屋を掃除したがり、ひとたび彼女の “整頓” が始まってしまうと部屋に隠された秘蔵のエロ的品々がすべて暴かれてしまうからだ。"},{"spoiler":false,"text":"しかし本人には悪気はまったくなく、ただ純粋に慎之助の世話を焼きたいだけである。"},{"spoiler":false,"text":"実は勉強はあまり得意ではなく、努力によって何とかするタイプ。"},{"spoiler":false,"text":"天海学院の入試も、抜群に頭のきれる姉に教わって突破した。"},{"spoiler":false,"text":"「せっかく久しぶりにお部屋を綺麗に “整頓” してあげようと思ったのに」"}],"source":"bangumi","sourceCharacterId":"31283"}],"profileFacts":[{"label":"学