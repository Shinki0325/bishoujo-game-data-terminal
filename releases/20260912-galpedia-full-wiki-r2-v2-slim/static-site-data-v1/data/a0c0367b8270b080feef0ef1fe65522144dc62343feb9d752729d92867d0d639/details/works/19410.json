vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54551","source":"vndb"}]},{"characterId":"char_c22246","characterName":"ユラハ オンライン","sourceIds":{"bangumi":[{"characterId":"22459","match":"exact-normalized-name-in-linked-work","subjectId":"79839"}],"egsCharacterIds":["2049"],"vndbCharacterId":"c22246"},"originalCharacterName":"ユラハ オンライン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"カタナの遺伝子を狙うため未来からやってきた宇宙海賊。"},{"spoiler":false,"text":"非常にグラマラスなスタイルの持ち主であり、その性格も良かれ悪しかれひどく女性的。"},{"spoiler":false,"text":"まるで猫の目のようにくるくると気持ちは変わり、そのときどきに好きなことを好きなようにやるという極めて直情的かつ享楽的な気分屋。"},{"spoiler":false,"text":"ただし、自身の戦艦に乗っている時だけは別。"},{"spoiler":false,"text":"彼女いわく“お仕事モード”のときは目的のためなら手段を選ばない、ごく冷徹で冷淡な性格に変貌する。"},{"spoiler":false,"text":"「先生と、イイコトしましょ♪」"}],"source":"egs","sourceCharacterId":"2049","sourceWorkId":"19410","spoiler":false},{"segments":[{"spoiler":false,"text":"エクゼの時空ワープにこっそり便乗してやって来た宇宙海賊。"},{"spoiler":false,"text":"エクゼに保護される主人公を海賊の直感から金になると感じ、様々な方法で彼を誘惑し、そして拉致しようとしている。"},{"spoiler":false,"text":"非常にグラマラスなスタイルの持ち主であり、その性格も良かれ悪かれ、ひどく女性的。"},{"spoiler":false,"text":"まるで猫の目のようにくるくると気持ちは変わり、その時々に好きなことを好きなようにやるという極めて直情的かつ享楽的な気分屋。"},{"spoiler":false,"text":"ただし、自身の戦艦に乗っている時だけは別。"},{"spoiler":false,"text":"彼女曰く “お仕事モード” の時は目的のためなら手段を選ばない、ごく冷徹で冷淡な性格に変貌する。"},{"spoiler":false,"text":"「先生と、イイコトしましょ♪」"}],"source":"bangumi","sourceCharacterId":"22459"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c22246","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"2049","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"2049","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b85b7f1e069a95f1e7d81e60605babc71f1eb26399534fe479052f658536d7a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0078f26e5717697d4504598b4970294b95d27cb0ebeacb6ad26f8d7fc171e6a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79839:22459:4937:1","source":"bangumi"}]},{"characterId":"char_c22247","characterName":"月乃 ユーガッタ ファメル13世","sourceIds":{"bangumi":[],"egsCharacterIds":["2050"],"vndbCharacterId":"c22247"},"originalCharacterName":"月乃 ユーガッタ ファメル13世","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現代より遠い未来で興され、そして滅亡した冥王月王国の末裔。"},{"spoiler":false,"text":"王国再興のため、主人公の遺伝子を狙っている。"},{"spoiler":false,"text":"態度は大きく、その性格は極めて尊大。"},{"spoiler":false,"text":"しかし、年齢よりもひどく劣った発育のために背丈は低く、胸はドがつく貧乳。"},{"spoiler":false,"text":"さらに意外に度胸がなく、サプライズにひどく弱い。"},{"spoiler":false,"text":"最初は主人公のことを狙っていたものの、次第に彼に惹かれていくようになる。"},{"spoiler":false,"text":"「わ、わらわを愚弄するとひどいのじゃ！"},{"spoiler":false,"text":"ひどいのじゃぞ！」"}],"source":"egs","sourceCharacterId":"2050","sourceWorkId":"19410","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/605233c02a051ef36a7b7874bce8fec11b4905c6cb2cde8a5a6de6869867b0b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/2624f33f5d67f8aac2955fb97d9d005a65067b1263f2305470f047b5276d3e61.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"有栖川 みや美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54550","source":"vndb"}]},{"characterId":"char_c22248","characterName":"深語 ナオ","sourceIds":{"bangumi":[{"characterId":"22461","match":"exact-normalized-name-in-linked-work","subjectId":"79839"}],"egsCharacterIds":["2051"],"vndbCharacterId":"c22248"},"originalCharacterName":"深語 ナオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エクゼと敵対する組織からやって来た暗殺者。"},{"spoiler":false,"text":"主人公の暗殺を目論んでおり、様々な手を尽くして彼を襲撃する 。"},{"spoiler":false,"text":"遠未来の世界の中でも常に内乱が続いた国の出身であり、生まれたときより戦いの中に身を置いていた。"},{"spoiler":false,"text":"その性格は極めて酷薄で冷徹なもの。"},{"spoiler":false,"text":"ありとあらゆる戦闘技術に通じているが、それ以外はかなりのドジで天然という、かなり残念なもの。"},{"spoiler":false,"text":"「……お前を殺す」"}],"source":"egs","sourceCharacterId":"2051","sourceWorkId":"19410","spoiler":false},{"segments":[{"spoiler":false,"text":"エクゼと敵対する組織からやって来た暗殺者。"},{"spoiler":false,"text":"主人公の暗殺を目論んでおり、様々な手を尽くして彼を襲撃する （しかし、それはすべてエクゼによって妨害される）。"},{"spoiler":false,"text":"遠未来の世界の中でも常に内乱が続いた国の出身であり、生まれた時より戦いの中に身を置いていた。"},{"spoiler":false,"text":"その性格は極めて酷薄であり、およそ人の信頼や好意といった感情を理解することが出来ない。"},{"spoiler":false,"text":"しかし、エクゼとの戦いの中で触れた主人公の優しさに惹かれ、彼を暗殺することに、そして今までの自分の人生に疑いを持つようになっていく。"},{"spoiler":false,"text":"「……お前を殺す」"}],"source":"bangumi","sourceCharacterId":"22461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7c8d7ee85d39941a6f2eb5a792ab8b2c92a124fad4361b11f2008253bb74d35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/264ffaeeaed66525206e2d21987a117f7812ae3962d89536bae31e4e5412cb31.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName