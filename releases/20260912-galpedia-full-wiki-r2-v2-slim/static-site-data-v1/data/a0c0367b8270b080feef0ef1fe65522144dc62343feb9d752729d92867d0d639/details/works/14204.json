{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"14204","model":{"presentationWorkId":"vndb:v5324","staff":{"artwork":[{"creditedName":"置弓枷","creatorId":"vndb:s3561","sourcePersonId":"egs:creator:3501","canonicalEntityId":"vndb:s3561","name":"置弓枷","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:89317","source":"egs"}],"scenario":[{"creditedName":"関口辰巳","creatorId":"vndb:s9965","sourcePersonId":"egs:creator:13795","canonicalEntityId":"vndb:s9965","name":"関口辰巳","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:189101","source":"egs"}],"music":[{"creditedName":"スタディオノーマライズ","creatorId":"vndb:s6568","sourcePersonId":"vndb:s6568","canonicalEntityId":"vndb:s6568","name":"有限会社ノーマライズ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:56862","source":"vndb"}],"other":[{"creditedName":"デミトロ・バジーナ大尉","creatorId":"vndb:s16131","sourcePersonId":"egs:creator:23105","canonicalEntityId":"vndb:s16131","name":"デミトロ・バジーナ大尉","detail":"プロデューサー、広報、営業","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:189102","source":"egs"},{"creditedName":"PACO","creatorId":"vndb:s50801","sourcePersonId":"egs:creator:19204","canonicalEntityId":"vndb:s50801","name":"PACO","detail":"プロデューサー、デバッグ","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:189103","source":"egs"},{"creditedName":"デミトロ・バジーナ大尉","creatorId":"vndb:s16131","sourcePersonId":"vndb:s16131","canonicalEntityId":"vndb:s16131","name":"デミトロ・バジーナ大尉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:56864","source":"vndb"}]},"cast":[{"characterId":"char_c57961","characterName":"神代 結衣","sourceIds":{"bangumi":[{"characterId":"126549","match":"exact-normalized-name-in-linked-work","subjectId":"103309"}],"egsCharacterIds":["14667"],"vndbCharacterId":"c57961"},"originalCharacterName":"神代 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【匿われた孤高の委員長】"},{"spoiler":false,"text":"今作のメインヒロイン。"},{"spoiler":false,"text":"私立　聖・へレンズ学院（せい・へれんずがくいん）で生徒会長をしている。"},{"spoiler":false,"text":"とある理由で主人公の勤めるネットカフェに来店した事で知り合い、それを縁に後日、和也の部屋に逃げ込む事に…"},{"spoiler":false,"text":"一見人当たりの良い性格ではあるが、身近になればなるほど人当たりがキツくなる。"},{"spoiler":false,"text":"プライドも高く、なかなか素直になる事が苦手。"},{"spoiler":false,"text":"すぐに食ってかかるが、いつも和也に逆手にとられてしまう。"},{"spoiler":false,"text":"性的にはかなり未熟ではあるが、彼女の身体の一部は人より感じやすい特別な特徴をもつ。"},{"spoiler":false,"text":"「あ……な、何よ……また私に……ひ、酷い事するつもりなの？ダ、ダメ……そ、そんなにしたら……わ、私また……んうぅンッ！」"}],"source":"egs","sourceCharacterId":"14667","sourceWorkId":"14204","spoiler":false},{"segments":[{"spoiler":false,"text":"私立 圣·海仑兹学院的学生会会长。"},{"spoiler":false,"text":"因为某个理由光临主人公工作的网咖而人士，因为这道关系日后逃进了和也的房间。"},{"spoiler":false,"text":"待人接物的态度良好，对初次见面的对象也温和地对待，但关系亲近后便会表露原来的一本正经的性格，是不是会表露出很严厉的举止……"},{"spoiler":false,"text":"自尊心很高，无法率直起来。"},{"spoiler":false,"text":"虽然会马上和和也极力争辩，但总是很快被他反咬一口。"},{"spoiler":false,"text":"虽然那方面还未成熟，但她的身体的一部分有着比其他人更敏感的特征。"},{"spoiler":false,"text":"「啊……干，干什么……又要对我……做，做什么过分的事情吗？不，不要……做，做那种事的话……我，我又要……嗯呜呜！」"}],"source":"bangumi","sourceCharacterId":"126549"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfb3c38f5956797b7f711923694af6e63544c839b2dfd520fec390244d673d22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/511d563812f533bb496eaad7a16130c3294633d98030992d44dd7ebb86687b5c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"冬乃 ありさ","creatorId":"vndb:s15611","sourcePersonId":"vndb:s15611","canonicalEntityId":"vndb:s15611","name":"冬乃 ありさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31665","source":"vndb"}]},{"characterId":"char_c57962","characterName":"灰原 柑奈","sourceIds":{"bangumi":[{"characterId":"126550","match":"exact-normalized-name-in-linked-work","subjectId":"103309"}],"egsCharacterIds":["14668"],"vndbCharacterId":"c57962"},"originalCharacterName":"灰原 柑奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【ネカフェのアイドル店員】"},{"spoiler":false,"text":"主人公のバイト先であるネットカフェ『ミーロ』の店員"},{"spoiler":false,"text":"（受付係り及び雑務全般のマスコットキャラクター）"},{"spoiler":false,"text":"主人公の事を『おにいちゃん』と呼び慕っている。"},{"spoiler":false,"text":"和也が出勤するといつもまとわり付くように話しかけてくる。"},{"spoiler":false,"text":"仕事態度は悪いがなぜか客には絶大な人気がある。"},{"spoiler":false,"text":"店の経営に関してもほぼ彼女に一任され、彼女なしではまともに開店する事も出来ない。"},{"spoiler":false,"text":"しかし本人のプロフィールには謎につつまれた部分が……"},{"spoiler":false,"text":"「ねぇ、お兄ちゃん……いつもみたいにしてぇ……カナ……も、もう我慢なんて出来ないよぅ……ん、んぅッ！」"}],"source":"egs","sourceCharacterId":"14668","sourceWorkId":"14204","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的打工网咖『米罗』的店员（接待员皆负责所有杂务的吉祥物系角色）。"},{"spoiler":false,"text":"将主人公称呼为「哥哥」来爱慕。"},{"spoiler":false,"text":"和也上班的时候总是跟在身边缠着说话。"},{"spoiler":false,"text":"虽然工作态度很差，但不知为何很受客人欢迎。"},{"spoiler":false,"text":"而店里的经营基本上也是交给她来打理，没有她的话店也就无法开。"},{"spoiler":false,"text":"但是本人的介绍里有着被谜团包围的部分……"},{"spoiler":false,"text":"「呐，哥哥……和平时一样做吧……柑奈……已，已经忍不住了……嗯，嗯呜！」"}],"source":"bangumi","sourceCharacterId":"126550"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd7f0581880c07d94260c42a2c9efdbf211f82b97f8574b9773e58a014315492.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45a7af0c5e673cd5ef8b7e5cc34efba8ba73351a026e46d3a82c2dace267ca36.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜木アミサ","creatorId":"vndb:s2281","sourcePersonId":"vndb:s2281","canonicalEntityId":"vndb:s2281","name":"桜木 アミサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:103309:126550:15996:1","source":"bangumi"}]},{"characterId":"char_c57963","characterName":"紅坂 和也","sourceIds":{"bangumi":[{"characterId":"126551","match":"exact-normalized-name-in-linked-work","subjectId":"103309"}],"egsCharacterIds":["14670"],"vndbCharacterId":"c57963"},"originalCharacterName":"紅坂 和也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"自分の部屋に転がり込んできた結衣を匿ってやる交換条件として、脅したりなだめたりしながら思うがままに調教していく。"},{"spoiler":false,"text":"普段は親類が経営するネットカフェに勤めているがこれと言った仕事をするでもなく、好きな時に出社し物品の調達や仕入れなども行っている。"},{"spoiler":false,"text":"その際、私的なモノも購入したりしている。"},{"spoiler":false,"text":"自分勝手で切れ者……サディスティックなタイプであるが、その一方で僅かに見せる繊細な一面も併せ持っている。"}],"source":"egs","sourceCharacterId":"14670","sourceWorkId":"14204","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的主人公。作为隐藏闯进自己房间的结衣的交换条件，一边威胁利诱一边随心所欲地进行调教。"},{"spoiler":false,"text":"平时在亲属管理的网咖工作，虽说如此但却没正经工作，喜欢的时候进行工作用品的收集和进货。"},{"spoiler":false,"text":"那时也会购买私人用物品。"},{"spoiler":false,"text":"虽然是我行我素的厉害人物……虐待狂的类型，但另一方面也有着（只有些微）纤细的一面。"}],"source":"bangumi","sourceCharacterId":"126551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abe4ab52060133ac2dcc74fcbb1f73f4165ad6ff8cdbf814bcaacea299478560.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da2ef0f5f20362030e79685c212eb1fb8372a439770429fbc5214fd75fab87c4.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p863","sourceCompanyId":"egs:brand:1465","canonicalEntityId":"vndb:p863","name":"Delta","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14204:1465","source":"egs"},{"companyId":"vndb:p863","sourceCompanyId":"vndb:p863","canonicalEntityId":"vndb:p863","name":"Delta","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11960:v5324","source":"vndb"},{"companyId":"vndb:p863","sourceCompanyId":"vndb:p863","canonicalEntityId":"vndb:p863","name":"Delta","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11968:v5324","source":"vndb"},{"companyId":"vndb:p187","sourceCompanyId":"vndb:p187","canonicalEntityId":"vndb:p187","name":"アイチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:35236:v5324","source":"vndb"},{"companyId":"vndb:p863","sourceCompanyId":"vndb:p863","canonicalEntityId":"vndb:p863","name":"Delta","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:35237:v5324","source":"vndb"},{"companyId":"vndb:p6036","sourceCompanyId":"vndb:p6036","canonicalEntityId":"vndb:p6036","name":"プチチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:35238:v5324","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
