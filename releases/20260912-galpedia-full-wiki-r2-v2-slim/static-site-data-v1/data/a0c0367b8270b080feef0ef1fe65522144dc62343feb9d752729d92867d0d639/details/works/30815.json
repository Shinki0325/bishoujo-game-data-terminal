{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30815","model":{"presentationWorkId":"vndb:v19843","staff":{"artwork":[{"creditedName":"塩こうじ","creatorId":"vndb:s8740","sourcePersonId":"egs:creator:30458","canonicalEntityId":"vndb:s8740","name":"塩こうじ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236722","source":"egs"},{"creditedName":"株式会社キューン・プラント","creatorId":"vndb:s7417","sourcePersonId":"vndb:s7417","canonicalEntityId":"vndb:s7417","name":"株式会社キューン・プラント(quunplant)","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:133367","source":"vndb"},{"creditedName":"けいまる","creatorId":"vndb:s8741","sourcePersonId":"vndb:s8741","canonicalEntityId":"vndb:s8741","name":"けいまる","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:133371","source":"vndb"},{"creditedName":"VISMODEL","creatorId":"vndb:s27341","sourcePersonId":"vndb:s27341","canonicalEntityId":"vndb:s27341","name":"VISMODEL","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:133375","source":"vndb"},{"creditedName":"Senju Kobo","creatorId":"vndb:s27342","sourcePersonId":"vndb:s27342","canonicalEntityId":"vndb:s27342","name":"Senju Kobo","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:133377","source":"vndb"}],"scenario":[{"creditedName":"飯田泰貴(あけお、Akeo)","creatorId":"vndb:s8739","sourcePersonId":"egs:creator:30459","canonicalEntityId":"vndb:s8739","name":"飯田泰貴(あけお、Akeo)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236723","source":"egs"}],"music":[{"creditedName":"Low","creatorId":"vndb:s8742","sourcePersonId":"egs:creator:30460","canonicalEntityId":"vndb:s8742","name":"Low","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236724","source":"egs"}],"other":[{"creditedName":"くゆり","creatorId":"vndb:s3761","sourcePersonId":"egs:creator:34383","canonicalEntityId":"vndb:s3761","name":"くゆり","detail":"主題歌「Unveil」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236725","source":"egs"},{"creditedName":"くゆり","creatorId":"vndb:s3761","sourcePersonId":"vndb:s3761","canonicalEntityId":"vndb:s3761","name":"くゆり","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:133365","source":"vndb"},{"creditedName":"け～まる","creatorId":"vndb:s6704","sourcePersonId":"vndb:s6704","canonicalEntityId":"vndb:s6704","name":"け～まる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133366","source":"vndb"},{"creditedName":"塩 こうじ","creatorId":"vndb:s8740","sourcePersonId":"vndb:s8740","canonicalEntityId":"vndb:s8740","name":"塩 こうじ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:133369","source":"vndb"},{"creditedName":"ダニエレP","creatorId":"vndb:s8743","sourcePersonId":"vndb:s8743","canonicalEntityId":"vndb:s8743","name":"ダニエレP","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133373","source":"vndb"},{"creditedName":"けあふりい","creatorId":"vndb:s14281","sourcePersonId":"vndb:s14281","canonicalEntityId":"vndb:s14281","name":"けあふりい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133374","source":"vndb"},{"creditedName":"VISMODEL","creatorId":"vndb:s27341","sourcePersonId":"vndb:s27341","canonicalEntityId":"vndb:s27341","name":"VISMODEL","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133376","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c60242","characterName":"獅子舞 凛火","sourceIds":{"vndbCharacterId":"c60242"},"originalCharacterName":"獅子舞 凛火","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"727"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She currently runs a small café named Lion House in place of her grandmother, who returned to the countryside temporarily to take care of a relative. The blonde streaks in her hair are natural, but have caused her peers to label her as a delinquent. To that effect, she rarely speaks to anyone there other than her friends Miharu, Mao and Naomi. This fact doesn't particularly bother her however, especially as she's not one for keeping up with trends and adjusting her attitude to those around her. Ironically she's also seen as cool and aloof thanks to that, when in reality she cares for her friends deeply."},{"spoiler":false,"text":"She has no particular hobbies to speak of, though she does enjoy shopping and reading shoujo manga. Black coffee is a favorite of hers, though she dislikes anything either too bitter or too sweet."},{"spoiler":false,"text":"One day while returning home with Naomi, she dies while shielding Naomi from an explosion, becoming a participant in Divine Selection in the process. Her memory is somewhat fuzzy however, possibly due the shock of being caught up in the explosion, leading her to participate while not knowing both her cause of death and her regret."},{"spoiler":false,"text":"From Sekai Project's site"}],"source":"vndb","sourceCharacterId":"c60242"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d65efaf3bafc901d4d244bfccedbfcd2d869aae50c297457f4ee635bd5de2a44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77713099a730464beb8bbd6920e419f13f7df53e2859eb01931eb094d86e1096.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松井 恵理子","creatorId":"vndb:s7955","sourcePersonId":"vndb:s7955","canonicalEntityId":"vndb:s7955","name":"松井 恵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70671","source":"vndb"}]},{"characterId":"char_vndb_c60243","characterName":"女神パルカ","sourceIds":{"vndbCharacterId":"c60243"},"originalCharacterName":"女神パルカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An odd girl who claims to be a goddess."},{"spoiler":false,"text":"She oversees Divine Selection, and only interacts with Rinka and the other participants within the strange dream world it takes place in. Unlike the participants, she can also move around freely in this space. She feels absolutely nothing over the events that take place during Divine Selection."},{"spoiler":false,"text":"Her white dress and wool-like hair provide a fantastical air to her appearance, and while she may speak like a lady from the upper echelons of society, she has little issue saying some rather horrible things. Very little is known about her, including her preferences or even how she spends her time when not overseeing Divine Selection."},{"spoiler":false,"text":"From Sekai Project's site"},{"spoiler":true,"text":"She was known as Dianna, sister of Linda, great-great-grandmother to Rinka while alive"}],"source":"vndb","sourceCharacterId":"c60243"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a57c1ce35be9e00535cbab5f8286a9f82cde5e45dd65908dee1d93196285636.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88ea6ada849cd2845dcb13f1b67cd7307ecd68eba1b0896e360937e2bc8635e3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野村 香菜子","creatorId":"vndb:s14282","sourcePersonId":"vndb:s14282","canonicalEntityId":"vndb:s14282","name":"野村 香菜子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70672","source":"vndb"}]},{"characterId":"char_vndb_c62401","characterName":"日辻 直未","sourceIds":{"vndbCharacterId":"c62401"},"originalCharacterName":"日辻 直未","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rinka's underclassman at Amecha Girls' University High School."},{"spoiler":false,"text":"Shy and introverted most of the time, though she has no issues talking to those she gets along with. Came to know Rinka through certain circumstances, and eventually became friends with Mao and Miharu through her. A bookworm at heart, she also enjoys making sweets often. Dark places and scary stories are two of her biggest weaknesses. She has a solid relationship with her parents."},{"spoiler":false,"text":"Her tendency to keep her feelings to herself lead to her classmates assigning her as head of the committee for the cafe they plan on opening during the culture festival, but her dedication to doing the best possible job leads to her learning how to brew coffee from Rinka."},{"spoiler":false,"text":"The events of Rinka's death haunt her dreams despite said events having been erased due to Divine Selection, possibly because she was present at the time. While not a participant, she does help Rinka gather information for Divine Selection."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c62401"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/885e0c2f8a04b355a051cc05df85de8512645f88192f9c382b9c817fe1c1ee27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18551d13bcce493e4a7562f88907b36d61adeefc61b5e1e64fbae79d45a4eb55.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"角元 明日香","creatorId":"vndb:s14283","sourcePersonId":"vndb:s14283","canonicalEntityId":"vndb:s14283","name":"角元 明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70673","source":"vndb"}]},{"characterId":"char_vndb_c63407","characterName":"未島 海晴","sourceIds":{"vndbCharacterId":"c63407"},"originalCharacterName":"未島 海晴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at Amecha Girls' University High School, and one of Rinka's classmates. While beautiful with the brains to match, others consider her difficult to approach, which results in her being avoided much like Rinka. As one would imagine, studying is her specialty, to the point where she can go for long hours without any breaks once she gets into it. Her eating habits would indicate that she isn't fussy in the slightest, but in reality she simply doesn't care much for taste in the first place. She works part-time at a certain restaurant, but apparently she's yet to ask Rinka and Mao to come along at some point."},{"spoiler":false,"text":"While typically level-headed, she sometimes speaks her mind without hesitation, leading to some harsh takes now and then. Her circumstances while growing up seem to be somewhat complicated, but not even Rinka knows much about it."},{"spoiler":false,"text":"Her feelings for Rinka surpass the boundaries of simple friendship, but Rinka herself seems to be completely clueless about this."},{"spoiler":false,"text":"From official site"},{"spoiler":true,"text":"Her name card reads 'II - Name - Hebinata Miharu'. Hebinata was her father's surname, and is her preferred one."}],"source":"vndb","sourceCharacterId":"c63407"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4e96ce657f1b4b76cc1349688d992a2f79b60ee9cf8540af986cbf9d4040162.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc1b2ea509d8294912009eda0abdd79b609ae7b98f37cdf4714e7b9f456a24ad.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"駒形 友梨","creatorId":"vndb:s14411","sourcePersonId":"vndb:s14411","canonicalEntityId":"vndb:s14411","name":"駒形友梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70675","source":"vndb"}]},{"characterId":"char_vndb_c63408","characterName":"小熊 真央","sourceIds":{"vndbCharacterId":"c63408"},"originalCharacterName":"小熊 真央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rinka's classmate and the mood maker of the group."},{"spoiler":false,"text":"Seemingly has little interest in her classmates other than Rinka and Miharu, though unlike them she does have other friends. She loves shopping like no other, to the point that her first priority at amusement parks is to hit up the gift stores."},{"spoiler":false,"text":"Rinka makes it a point not to tell her about Divine Selection, though she has noticed that something isn't quite right."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c63408"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a20ad7a35d5001f91fa94b52a0ef586fca8301a6412f5acd418b090358f265d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9687d3fcdb302c92a4b77150d4b516aa7e7f06357cb5b359f0acc9b573b9d2c.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七瀬 めぐみ","creatorId":"vndb:s14412","sourcePersonId":"vndb:s14412","canonicalEntityId":"vndb:s14412","name":"七瀬 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70676","source":"vndb"},{"creditedName":"藤村 鼓乃美","creatorId":"vndb:s14665","sourcePersonId":"vndb:s14665","canonicalEntityId":"vndb:s14665","name":"藤村 鼓乃美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70679","source":"vndb"}]},{"characterId":"char_vndb_c63410","characterName":"チャン·チャン","sourceIds":{"vndbCharacterId":"c63410"},"originalCharacterName":"チャン·チャン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young and cheerful lady."},{"spoiler":false,"text":"Both her and her husband died in an accident while on their honeymoon, but Divine Selection made it so that both of them returned home safe and sound. To this effect, her elimination would result in her husband's death as well, leading her to desperate measures."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c63410"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acc0a6cac7d47c99749e701a23a027be8ed5f7cac8a59868e041944b21e53a01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63fa80d5ebdf4f44487595b58f7c0c991a8a631ab3bbb2190914e2ce72f99773.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今泉 有満","creatorId":"vndb:s14413","sourcePersonId":"vndb:s14413","canonicalEntityId":"vndb:s14413","name":"今泉 有満","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70677","source":"vndb"}]},{"characterId":"char_vndb_c63411","characterName":"???","sourceIds":{"vndbCharacterId":"c63411"},"originalCharacterName":"???","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious child who crossed paths with Rinka and Naomi as they were making their way home. Gender unknown; Rinka thinks female, while Naomi thinks male."},{"spoiler":false,"text":"While later revealed to be a participant in Divine Selection, further details are unknown."},{"spoiler":false,"text":"From official site"},{"spoiler":true,"text":"Though he was never given a birth name, he later adopts the name, Yu, after Shigetsugu gives it to him."}],"source":"vndb","sourceCharacterId":"c63411"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/497ccb9fd01fa98e97630d8bed9ad5fe0b66bfccafb5ae67023ae85c0bd2eb19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccfe27730f43c478a638602da5d465868614827b1e09e1f5c24ac7b0eefb941c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎藤 美保","creatorId":"vndb:s14414","sourcePersonId":"vndb:s14414","canonicalEntityId":"vndb:s14414","name":"斎藤 美保","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70678","source":"vndb"}]},{"characterId":"char_vndb_c63412","characterName":"夢の中の男性","sourceIds":{"vndbCharacterId":"c63412"},"originalCharacterName":"夢の中の男性","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An androgynous man who appeared in Rinka's dreams."},{"spoiler":false,"text":"He seems to live in the dream world, but it's unknown if he has any ties to Parca. Rinka has no recollection of meeting him."},{"spoiler":false,"text":"From official site"},{"spoiler":true,"text":"He's Lethe the cat, which Rinka takes care of and named Leo when Dianna was still alive."}],"source":"vndb","sourceCharacterId":"c63412"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edf9ffff47318918b45584f9531b562432c0b0fed250e0dafcb1a6e87fee13f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22840c1ab6b69a376605c8e15bb74211534475cd22d5f222ea7d541fbc6ff1ca.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長塚 コト","creatorId":"vndb:s14410","sourcePersonId":"vndb:s14410","canonicalEntityId":"vndb:s14410","name":"長塚 コト","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70674","source":"vndb"}]},{"characterId":"char_vndb_c71740","characterName":"ソフィア・プリズニェツィ・アレクセーエヴナ","sourceIds":{"vndbCharacterId":"c71740"},"originalCharacterName":"ソフィア・プリズニェツィ・アレクセーエヴナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"603"},"height":{"reviewState":"source-only","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl from Russia who boldly confronts Rinka in the real world despite being a participant in Divine Selection. What could she be planning…?"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c71740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8272c332223bcbd2f035b11dbe321aff008dfb0f99cd1d3fd12f86055deb3d75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fb34bc1c675b192f0dceb2f2c099d0a3cbb8d6a5f4633ebefbba9e81ceb5ef6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"リンネ","creatorId":"vndb:s16959","sourcePersonId":"vndb:s16959","canonicalEntityId":"vndb:s16959","name":"リンネ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70681","source":"vndb"}]},{"characterId":"char_vndb_c74969","characterName":"スケール・ジョーンズ","sourceIds":{"vndbCharacterId":"c74969"},"originalCharacterName":"スケール・ジョーンズ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man with an upbeat mentality."},{"spoiler":false,"text":"He calmly observed the situation during the beginning of the Divine Selection and little he gets involved in gathering information on Divine Selection. He scrutinizes every action as good or evil and has stated that if the last one standing in Divine Selection is someone of justice, he'd gladly give up the right to be that person."},{"spoiler":false,"text":"He's been seen drinking at the bar with Federico and Odette but what exactly is his relationship with those two...?"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c74969"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47757e4e3c8c894826bcc0f6d2f1cdc24f14b210b834f415c6b0bf9cbad1f6ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/1509db099eb9af0080c0db595822c066770549a428fbb05c84e8575da87f314e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"武田 直人","creatorId":"vndb:s16033","sourcePersonId":"vndb:s16033","canonicalEntityId":"vndb:s16033","name":"武田 直人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70680","source":"vndb"}]},{"characterId":"char_vndb_c75499","characterName":"アラン・スコーピオン","sourceIds":{"vndbCharacterId":"c75499"},"originalCharacterName":"アラン・スコーピオン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An Indian man of little words."},{"spoiler":false,"text":"His personality makes his actions hard to predict, though it's apparent that he has every intention of eliminating every other Divine Selection participant without mercy. What motivates him is unknown, but there's certainly more to him than meets the eye."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c75499"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/338c6f3e20a32d90f9de98939c6210292549b17556bbbe3aea8143888ad02320.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/844a4f7e3f2e0f6b50984740a8e7fffc4442dfa044053dff5c8498630db59491.webp","width":230,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田 邦宏","creatorId":"vndb:s163","sourcePersonId":"vndb:s163","canonicalEntityId":"vndb:s163","name":"前田邦宏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70670","source":"vndb"}]},{"characterId":"char_vndb_c77493","characterName":"フェデリーコ・カルミナーティ","sourceIds":{"vndbCharacterId":"c77493"},"originalCharacterName":"フェデリーコ・カルミナーティ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Italian Stallion."},{"spoiler":false,"text":"Seemingly a member of the mafia until he stirred up a certain incident, resulting in his death and participation in Divine Selection. Develops something of a friendly rivalry with Odette, another participant, and they agree to help each other until they're the final two left."},{"spoiler":false,"text":"Incredibly proud of his homeland, and convinced that no other country boasts food better than Italy. This leads to plenty of disputes with Odette. His main priorities when it comes to women are their appearance and chest size."},{"spoiler":false,"text":"While rather happy go lucky most of the time, he's known to display his mafioso side when the circumstances call for it."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c77493"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdd02d263f11c7b1dade985f798a9c192d2085d21fcf4ef337b5afedf69fb732.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37d35631aec8fecda23ad61e4cf28a89dceb1d9b42a6f33f4733da32793f277e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小出 弘","creatorId":"vndb:s18688","sourcePersonId":"vndb:s18688","canonicalEntityId":"vndb:s18688","name":"小出 弘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70682","source":"vndb"}]},{"characterId":"char_vndb