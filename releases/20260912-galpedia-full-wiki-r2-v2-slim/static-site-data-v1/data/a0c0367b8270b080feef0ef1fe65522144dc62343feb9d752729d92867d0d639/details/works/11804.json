{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11804","model":{"presentationWorkId":"vndb:v1366","staff":{"artwork":[{"creditedName":"吉野恵子","creatorId":"vndb:s2157","sourcePersonId":"egs:creator:322","canonicalEntityId":"vndb:s2157","name":"吉野恵子","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:75973","source":"egs"}],"scenario":[{"creditedName":"夢野Q作","creatorId":"vndb:s2202","sourcePersonId":"egs:creator:2423","canonicalEntityId":"vndb:s2202","name":"夢野Q作","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:75974","source":"egs"}],"music":[{"creditedName":"鈴木 太郎","creatorId":"vndb:s8399","sourcePersonId":"vndb:s8399","canonicalEntityId":"vndb:s8399","name":"鈴木 太郎","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:23970","source":"vndb"},{"creditedName":"武礼堂","creatorId":"vndb:s11707","sourcePersonId":"vndb:s11707","canonicalEntityId":"vndb:s11707","name":"神谷 勇","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:23971","source":"vndb"}],"other":[{"creditedName":"吉野 恵子","creatorId":"vndb:s2157","sourcePersonId":"vndb:s2157","canonicalEntityId":"vndb:s2157","name":"吉野 恵子","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:23967","source":"vndb"}]},"cast":[{"characterId":"char_c43456","characterName":"成瀬 愛","sourceIds":{"bangumi":[{"characterId":"89339","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15984"],"vndbCharacterId":"c43456"},"originalCharacterName":"成瀬 愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の亡くなった母親の妹、いわゆる叔母さん。"},{"spoiler":false,"text":"舞台となる病院でナース長を務めているベテラン。"},{"spoiler":false,"text":"仕事ぶりも優秀で、性格もしっかりしており、また気さくで人当たりもよく、患者からの信頼も厚い。"},{"spoiler":false,"text":"学生時代の寮が主人公の家の近所にあったため、美咲や主人公とよく遊んであげていた。"},{"spoiler":false,"text":"主人公が頭のあがらない存在でもある。"},{"spoiler":false,"text":"外科の若手エリート医師・永瀬直樹と婚約しており、その彼と再来月に挙式の予定。"}],"source":"egs","sourceCharacterId":"15984","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"誠人の母親の妹にあたる叔母さん。看護婦長。"},{"spoiler":false,"text":"しっかり者で人当たりも良く、多くの患者から信頼されている。"},{"spoiler":false,"text":"学生時代の寮が誠人の家の近所にあったことから、美咲や誠人とはよく遊んであげていた。"},{"spoiler":false,"text":"誠人が絶対に頭の上がらない人。外科の若手エリート医師と婚約しており、再来月に挙式の予定。"}],"source":"bangumi","sourceCharacterId":"89339"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/222124673aa70dbf29336a458c6b1743b4e2e353cd82b8d34cba28988e82f711.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e71b16994e7444ea305735df857c29b31c23e9f6359318909e9ee4ce9c881b1a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20153:89339:5741:1","source":"bangumi"}]},{"characterId":"char_c43457","characterName":"白幡 さくら","sourceIds":{"bangumi":[{"characterId":"89340","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15985"],"vndbCharacterId":"c43457"},"originalCharacterName":"白幡 さくら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、看護学校の研修生。"},{"spoiler":false,"text":"夜逃げ同然で引っ越したこともあって、主人公とは約10年ぶりの再会となる。"},{"spoiler":false,"text":"看護学校ではトップクラスの成績だったが、極度に緊張する性分から本番に弱いらしい。"},{"spoiler":false,"text":"何もないところでよく転ぶ、ややドジッ娘タイプ。"},{"spoiler":false,"text":"子供の頃に苛められていたせいか、自分の容姿にコンプレックスを抱いている。"}],"source":"egs","sourceCharacterId":"15985","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"誠人の幼なじみである、看護学校の研修生。"},{"spoiler":false,"text":"夜逃げ同然に引っ越したため、10年ぶりに誠人と再会する。"},{"spoiler":false,"text":"看護学校の成績はトップクラスなのだが、緊張して本番には弱いらしい。なにも無いところでよく転ぶ。"},{"spoiler":false,"text":"子供の頃はイジメられっ子だったせいか、自分の容姿にコンプレックスを持っている。"}],"source":"bangumi","sourceCharacterId":"89340"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c25292abd1a79314a23550066c2ff362581285d2e6e372ac833244d1e2c92182.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/301b04af05839e54aafc321405d9d9ab471336f46edd492294f3eb5ee661d9b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩居由希子","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20153:89340:4163:1","source":"bangumi"}]},{"characterId":"char_c43458","characterName":"相馬 美咲","sourceIds":{"bangumi":[{"characterId":"89337","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15982"],"vndbCharacterId":"c43458"},"originalCharacterName":"相馬 美咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の実姉。主人公の通う学園の音楽教師。"},{"spoiler":false,"text":"おっとりしていて、押しの弱い性格。"},{"spoiler":false,"text":"幼い時に母親を亡くし、以来、主人公の母親代わりとして頑張ってきた。"},{"spoiler":false,"text":"非常に弟想いだが、その主人公が必要以上に慕ってくれていることに理解しながらも、同時に戸惑いを感じている。"},{"spoiler":false,"text":"問題児に育ってしまった主人公を心配で仕方ないらしい。"}],"source":"egs","sourceCharacterId":"15982","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"誠人の通う学園で音楽教師を務めている実姉。誠人の母親代わりでもある。"},{"spoiler":false,"text":"弟想いだが、おっとりした性格で押しに弱い。"},{"spoiler":false,"text":"誠人が自分のことを必要以上に慕ってくれていることも理解しているが、どう応えていいのか困り果てている。"},{"spoiler":false,"text":"美咲にとって誠人はあくまでも守るべき対象であり、誠人が問題児なためにいつも心配でしょうがないらしい。"}],"source":"bangumi","sourceCharacterId":"89337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7434fe5b133a183274380f85bb7a65ce542b80917f518b03f32fccee4d4cf152.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c3c6aaf4785288552ef453a71782f11bbfd2da3ecbcb42d20571edda93b93aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20153:89337:4647:1","source":"bangumi"}]},{"characterId":"char_c43494","characterName":"相馬 菜月","sourceIds":{"bangumi":[{"characterId":"89335","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15980"],"vndbCharacterId":"c43494"},"originalCharacterName":"相馬 菜月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の父親の再婚相手。主人公の義母。"},{"spoiler":false,"text":"父親の元部下だったらしいが、現在は、転職して雑誌編集に携わるキャリアウーマン。"},{"spoiler":false,"text":"自他共に厳しく、仕事への妥協は一切しない。"},{"spoiler":false,"text":"男に負けたくない、という強い意志を持ち、競争心、また闘争心は旺盛。"},{"spoiler":false,"text":"仕事で家事をすることが出来ず、全て義娘の美咲に任せてしまっていることを、やや負い目に感じている。また義理の息子となった主人公に対しては、そのいやららしい視線が気になっており、家の残している娘を心配している。"}],"source":"egs","sourceCharacterId":"15980","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"誠人の父親の再婚相手。元部下だったらしいのだが、現在は転職して雑誌編集に携わるキャリアウーマン。"},{"spoiler":false,"text":"仕事への妥協は一切せず、自分にも他人にも厳しい。"},{"spoiler":false,"text":"男には負けたく無いという強い意識があり、競争・闘争心が非常に高い。"},{"spoiler":false,"text":"家事全般は姉の美咲に任せてしまっており、若干の負い目を感じている。"},{"spoiler":false,"text":"最近、誠人の粘つくような視線が気になるらしく、仕事中に娘を家に残している事を心配している。"}],"source":"bangumi","sourceCharacterId":"89335"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0030103f32cdf8802d5fcf1abed6d71f1c4fbddfbdaf80fa4555bcf301f9793a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94704335c137a05d15a63dc84058ee7d8a7232f0096685c6d0c16b84e1242ffe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田ゆきえ","creatorId":"vndb:s790","sourcePersonId":"vndb:s790","canonicalEntityId":"vndb:s790","name":"前田 ゆきえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20153:89335:3952:1","source":"bangumi"}]},{"characterId":"char_c43526","characterName":"相馬 結菜","sourceIds":{"bangumi":[{"characterId":"89336","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15981"],"vndbCharacterId":"c43526"},"originalCharacterName":"相馬 結菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"菜月の連れ子。主人公の義妹。"},{"spoiler":false,"text":"母子家庭に育ってきた彼女にとって、家族が増えたことは非常に嬉しく、特に主人公に対しては「お兄ちゃん」と呼んで慕っている。"},{"spoiler":false,"text":"無邪気で子供っぽいところもあるが、感受性が強く、家庭内の不和を敏感に察知し、自分の力で何とか仲良くさせようと頑張っている。"},{"spoiler":false,"text":"また自分をかばって、主人公が交通事故に遭ってしまったことに責任を感じている。"}],"source":"egs","sourceCharacterId":"15981","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"菜月の連れ子。"},{"spoiler":false,"text":"ずっと母子家庭に育ったために家族が増えたことを喜び、特に誠人に懐いているお兄ちゃん子。"},{"spoiler":false,"text":"それだけに結菜を助けて誠人が交通事故に遭ってしまったことに責任を感じているらしい。"},{"spoiler":false,"text":"無邪気な性格だけに家庭内の不和を敏感に察知し、仲良くさせようと懸命に努力している。"}],"source":"bangumi","sourceCharacterId":"89336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5afb7d9cdbac9ec3b403805782f4c151b28a1ccb045bdd3a313def5a7d841f2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d515b3e894e9fd2e7aeac93914ced9f3e7c2ad49dc4d64081dbab1e38367e5d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20153:89336:4830:1","source":"bangumi"}]},{"characterId":"char_c43527","characterName":"春日部 陽菜","sourceIds":{"bangumi":[{"characterId":"89338","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15983"],"vndbCharacterId":"c43527"},"originalCharacterName":"春日部 陽菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美咲の中学時代からの親友。体育教師。"},{"spoiler":false,"text":"気さくで明朗快活、非常にさっぱりとした性格。好奇心旺盛で、面白そうなことがあると首を突っ込みたがる。また自分の納得できないことはとことんやらない性分。"},{"spoiler":false,"text":"世間知らずのお嬢様っぽい美咲の世話を焼いている。"},{"spoiler":false,"text":"美咲のブラコンをからかってはいるが、同時に弟離れできない彼女を本気で心配している。"},{"spoiler":false,"text":"顧問をしているチアリーディング部の練習中に怪我をして、現在、舞台となる病院で検査入院をしている。"}],"source":"egs","sourceCharacterId":"15983","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"美咲の中学生の頃からの親友で、明るいフランクな感じの体育教師。"},{"spoiler":false,"text":"世間知らずの美咲の世話をなにかと焼いている。"},{"spoiler":false,"text":"面白そうなことにはちょっかいを出さずにはいられない。竹を割ったような性格だが、納得できないことはとことんやらない。"},{"spoiler":false,"text":"誠人と美咲のシスコン・ブラコンをからかう一方、美咲が弟離れできないでいることを心配している。"},{"spoiler":false,"text":"チアリーディング部の顧問をしているが、練習中に転落してしまい、現在検査入院中。"}],"source":"bangumi","sourceCharacterId":"89338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d0e210a94f07c0d043bfaefeab5714b8f76dee841e1e5dabca48022bcfce4fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74dc3df4cfb917c425a48136b75fc4524554fb48ab09968545c85ac508b8139a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c43451","characterName":"相馬 誠人","sourceIds":{"vndbCharacterId":"c43451"},"originalCharacterName":"相馬 誠人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b888b13a95ace4d04267e7b569cae3ea5ee244e8020ebe4449ecb1c8a14c821c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5570cc836009c7c56de5090025e66f7a18c2868c4425581ee216744bbfb6eb8a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c43528","characterName":"永瀬 直樹","sourceIds":{"vndbCharacterId":"c43528"},"originalCharacterName":"永瀬 直樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metad