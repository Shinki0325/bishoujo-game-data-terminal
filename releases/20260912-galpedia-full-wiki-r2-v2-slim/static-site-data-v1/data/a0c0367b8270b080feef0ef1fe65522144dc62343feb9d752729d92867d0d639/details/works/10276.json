me":"CANDY","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:27709","source":"vndb"},{"creditedName":"有原 昌顕","creatorId":"vndb:s3326","sourcePersonId":"vndb:s3326","canonicalEntityId":"vndb:s3326","name":"有原 昌顕","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:27710","source":"vndb"},{"creditedName":"有原 昌顕","creatorId":"vndb:s3326","sourcePersonId":"vndb:s3326","canonicalEntityId":"vndb:s3326","name":"有原 昌顕","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:27711","source":"vndb"},{"creditedName":"どせい","creatorId":"vndb:s4161","sourcePersonId":"vndb:s4161","canonicalEntityId":"vndb:s4161","name":"どせい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:27713","source":"vndb"},{"creditedName":"AKOU","creatorId":"vndb:s15096","sourcePersonId":"vndb:s15096","canonicalEntityId":"vndb:s15096","name":"AKOU","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:27716","source":"vndb"}]},"cast":[{"characterId":"char_c13964","characterName":"音羽 桂香","sourceIds":{"bangumi":[{"characterId":"87298","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"87298","match":"exact-normalized-name-in-linked-work","subjectId":"320098"},{"characterId":"87298","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8364"],"vndbCharacterId":"c13964"},"originalCharacterName":"音羽 桂香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Keika is the main heroine of Natsu Kagura and eldest daughter of Otowa sisters with a very long jet black hair. Gently mild and polite, a perfect Yamato Nadeshiko type shrine maiden, who's living at Minamori shrine. A second year student who attends school at the bottom of the mountain. Since she takes seriously whatever she's told, she often becomes subject of teasing by Youko and even sometimes by herown younger sister. Her weakness is her lack of awareness between male-female's relationship and her awkwardness for electronic equipment systems, though it seems that she's able to use the microwave oven. Despite of her modesty and gentle personality, she's shown to have an excessive sexual addiction during rape."},{"spoiler":false,"text":"Keika is prominent in kenjutsu. Her weapon is Shishio (獅子王), a legendary katana that possesses massive divine spiritual power & lightning properties, which can be summoned by her at anytime."}],"source":"vndb","sourceCharacterId":"c13964"},{"segments":[{"spoiler":false,"text":"温和で優しい水杜神社の長女。 礼儀正しい大和撫子タイプ。"},{"spoiler":false,"text":"長く美しい黒髪とバランスのとれたスタイルの持ち主。"},{"spoiler":false,"text":"神社では一番の常識人で、天然ボケ揃いな一家のツッコミ役と化している。"},{"spoiler":false,"text":"麓の学園に通う二年生で、主人公より1つ下。"},{"spoiler":false,"text":"物事を何でも素直に受け取るので、時々妹や居候のおもちゃにされている。"},{"spoiler":false,"text":"欠点は、男性に対してほとんど免疫がないのと、電子機器に対する不器用さ。"}],"source":"egs","sourceCharacterId":"8364","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社の長女であり、初花の姉。"},{"spoiler":false,"text":"巫女としての修行に励む、温和で礼儀正しい美少女ではあるが、やや天然な部分もある。"},{"spoiler":false,"text":"何事にも真面目で、素直に全てを受け止める性格だが、電子機器に対して絶望的に相性が悪い。"}],"source":"egs","sourceCharacterId":"8364","sourceWorkId":"30023","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社の長女である退魔巫女。"},{"spoiler":false,"text":"巫女として懸命に修行に励んでいる。"},{"spoiler":false,"text":"温和で礼儀正しい美少女であるが、やや天然な部分もある。"},{"spoiler":false,"text":"何事にも真面目で、素直に全てを受け止める。"}],"source":"egs","sourceCharacterId":"8364","sourceWorkId":"40479","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社の長女であり、初花の姉。"},{"spoiler":false,"text":"巫女としての修行に励む、温和で礼儀正しい美少女ではあるが、やや天然な部分もある。"},{"spoiler":false,"text":"何事にも真面目で、素直に全てを受け止める性格だが、電子機器に対して絶望的に相性が悪い。"}],"source":"bangumi","sourceCharacterId":"87298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/4612fb09532aa604edf154e4c6ef0802b18ac6ce15d8490bab563ecd0b6430c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bb2fa035850d06c73c130e9a7cd75bb6d995694a65b6018324d78f5d2d9d188.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮川美保","creatorId":"vndb:s3635","sourcePersonId":"vndb:s3635","canonicalEntityId":"vndb:s3635","name":"宮川 美保","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:120318:87298:4693:1","source":"bangumi"}]},{"characterId":"char_c13965","characterName":"音羽 初花","sourceIds":{"bangumi":[{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"310182"},{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8365"],"vndbCharacterId":"c13965"},"originalCharacterName":"音羽 初花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second heroine of Natsu Kagura and younger daughter of Minamori shrine. Hatsuka has black hair with pony tail. A bright, active, cheerful, and innocent personality."},{"spoiler":false,"text":"There is no right or wrong side in her mind. She has a behaviour to straight out her emotions over action. And... noisy anyway. Because of that, she is often scolded by Keika, her older sister."},{"spoiler":false,"text":"A freshman who attends school at the bottom of the mountain."},{"spoiler":false,"text":"Hatsuka is skilled in archery."}],"source":"vndb","sourceCharacterId":"c13965"},{"segments":[{"spoiler":false,"text":"天真爛漫な水杜神社の次女。 姉と同じく麓の学園に通う一年生。"},{"spoiler":false,"text":"運動神経はそこそこ良いが、それ以上に頭が良く手先が器用。"},{"spoiler":false,"text":"感情に裏表がなく活動的……というか、とにかく騒々しい。"},{"spoiler":false,"text":"しょっちゅう桂香に叱られている。"},{"spoiler":false,"text":"主人公に対しても遠慮がなく、後ろから抱き付いてきたりする。"},{"spoiler":false,"text":"桂香より胸が小さいのを気にしている。"}],"source":"egs","sourceCharacterId":"8365","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"水社神社の次女として生まれ、巫女の修行をしている元気いっぱいの少女。"},{"spoiler":false,"text":"その明るく裏表の無い性格は誰からも好かれるが、時には騒々しいと叱られることも。"},{"spoiler":false,"text":"得意の弓を手にして、妖怪達に立ち向かっていく。"}],"source":"egs","sourceCharacterId":"8365","sourceWorkId":"29786","spoiler":false},{"segments":[{"spoiler":false,"text":"水社神社の次女として生まれ、巫女の修行をしている元気いっぱいの少女。"},{"spoiler":false,"text":"その明るく裏表の無い性格は誰からも好かれるが、時には騒々しいと叱られることも。"},{"spoiler":false,"text":"得意の弓を手にして、妖怪達に立ち向かっていく。"}],"source":"bangumi","sourceCharacterId":"78080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22730f29c923878fd38f52f0e43ebd103d0b12aa3f52f377cfbcc5d05ccdffe1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efee0670cfe136f90f5547e2aab16729e40f1cf164175c419d389d2823ea88c9.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41747:78080:5940:1","source":"bangumi"}]},{"characterId":"char_c14025","characterName":"音羽 葉子","sourceIds":{"bangumi":[{"characterId":"140427","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"140427","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8366"],"vndbCharacterId":"c14025"},"originalCharacterName":"音羽 葉子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third heroine of Natsu Kagura and the elder of the Otowa Clan. A Freeloader of Minamori shrine and a gentle person. She is very calm in any situation. Youko is actually an incarnation of nine tailed fox spectre. She was sealed by the great grandfather of Otowa, long time ago, and since then she had been serving at the Otowa home. Due to the nature of a fox, her smile is unexpectedly a part of her scheming. She has a bad habit of teasing other people, especially Keika, even during sex with her. In many ocassion, she demonstrated her great knowledges regarding the situatiion, including the youkai's detail. Youko seems to know Kijima from Oni Kagura series since long time ago. She has daughter named Nanaka, who appears at Debo no Subako. Youko appears at Aozora Magiccer which is direct sequel of Youko's route from Natsu Kagura and take place in alternate (fantasy) universe. Youko also makes cameo at Kagura Douchukii."}],"source":"vndb","sourceCharacterId":"c14025"},{"segments":[{"spoiler":false,"text":"音羽家一番の年長者。 神社の居候。 音羽家で一番胸の大きい人。"},{"spoiler":false,"text":"一見おっとりさんで、大抵のことには動じず笑顔のままで対応できる大物。"},{"spoiler":false,"text":"しかし時々人をからかう悪い癖を持っていて、意外と腹黒い部分もある。"},{"spoiler":false,"text":"実は昔の大妖怪で狐の化身。 桂香たちの祖父に封じられ、以来音羽家に仕えている。"},{"spoiler":false,"text":"現在は霊力のほとんどが封じられているので簡単な雑務しか出来ないが、膨大な知識を持っていて妖怪や退魔についても詳しい。"}],"source":"egs","sourceCharacterId":"8366","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"音羽家一番の年長者。神社の居候。"},{"spoiler":false,"text":"音羽家で一番胸の大きい人。"},{"spoiler":false,"text":"一見おっとりさんで、常に微笑みをたたえています。"},{"spoiler":false,"text":"大抵のことには動じず、笑顔のままで対応出来る大物。"},{"spoiler":false,"text":"ただし本性が妖怪なので、腹黒い部分もあるようです。"},{"spoiler":false,"text":"年の功というか、策士の人。"}],"source":"bangumi","sourceCharacterId":"140427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d55d252216ff2165c052a032126a0d9658816f70ae8a3c4b41052e26de9cc89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0788968f245192b9c7f86d8401dfc7a3b06796cdcc84fb22e2e2344b0280c8d8.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:120318:140427:4432:1","source":"bangumi"}]},{"characterId":"char_c17193","characterName":"ナツ","sourceIds":{"bangumi":[{"characterId":"87303","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"87303","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8368"],"vndbCharacterId":"c17193"},"originalCharacterName":"ナツ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"犬耳・尻尾付きの神様。 無口で感情表現が乏しい。"},{"spoiler":false,"text":"非常に人見知りが激しく、主人公が近付いても最初は怯えられるだけ。"},{"spoiler":false,"text":"葉子にだけ懐いている。"},{"spoiler":false,"text":"そのくせ好奇心旺盛という、ややこしい性格の持ち主。"},{"spoiler":false,"text":"神様というより座敷わらしに近い？　一度懐くと、それこそ犬のようにどこにでもついてくる。"},{"spoiler":false,"text":"水杜神社に祀られている神様で、付近の霊や妖怪の力を “殺生石” に封じている。"},{"spoiler":false,"text":"そのため妖怪たちは、この “殺生石” を狙っている。"}],"source":"egs","sourceCharacterId":"8368","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社に住む犬耳尻尾付きの神様。"},{"spoiler":false,"text":"幹也や音羽姉妹との生活で人見知りは大分なりを潜めた。"},{"spoiler":false,"text":"ただし相変わらず口数は少なく、慣れていない人の前ではあまり感情を出さない。"},{"spoiler":false,"text":"その心根は優しい。"}],"source":"egs","sourceCharacterId":"8368","sourceWorkId":"30006","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社に住む犬耳尻尾付きの神様。"},{"spoiler":false,"text":"幹也や音羽姉妹との生活で人見知りは大分なりを潜めた。"},{"spoiler":false,"text":"ただし相変わらず口数は少なく、慣れていない人の前ではあまり感情を出さない。"},{"spoiler":false,"text":"その心根は優しい。"}],"source":"bangumi","sourceCharacterId":"87303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1a3fa8d86b7c52519f01719397a9c54f3787a2b735e7011460ff83a7bb0e9f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75f91d2c9346b59d8f4e858d866472bcbf9176f14772f8d0c4d9fce638f2ec0f.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"静木亜美","creatorId":"vndb:s663","sourcePersonId":"vndb:s663","canonicalEntityId":"vndb:s663","name":"静木 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:120318:87303:8575:1","source":"bangumi"}]},{"characterId":"char_c20719","characterName":"滝峰 幹也","sourceIds":{"bangumi":[{"characterId":"140632","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"140632","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8367"],"vndbCharacterId":"c20719"},"originalCharacterName":"滝峰 幹也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist, Takimine Mikiya is a priest apprentice of the Takimine clan. A mild-mannered pacifist and a relative of the heroines. He’s dispatched to help Otowa house exterminating an abnormally massive amount of demons emerging in Minamori’s land. Mikiya is remarkably skilled in Onmyouji spells (able to perform one without incantation), various shikigamis summoning, medical purification, healing spell, and a very strong spiritual power. Though his Onmyouji destruction spell (by projecting it through kick and fist) is able to deal high damage, it’s still required access and full spiritual power preparation by the user. It’s makes him powerful yet vulnerable to enemy’s counterattack. During one of the confrontation, Mikiya having his power sealed by a Spider specter. Thus keeping him from front line’s fighting as often as the more combat oriented Otowa sisters. Mikiya tends to rely on Keika, Hatsuka, and his shikigamis when direct combat is required. Later, as explained at Keika’s ending, Mikiya occasionally travels to another cities and reappears as temporary lecturer in it’s sequel, TsukiKagura. Mikiya also reappears in Aozora Magiccer!! as the sequel of Youko’s ending."}],"source":"vndb","sourceCharacterId":"c20719"},{"segments":[{"spoiler":false,"text":"音羽姉妹とは親戚関係にある神社の倅。"},{"spoiler":false,"text":"拳や蹴りで妖怪を退治する格闘術の使い手。"},{"spoiler":false,"text":"性格は温厚な平和主義者。 そのため戦闘はあまり好きではないのだが、なまじ腕があるせいであちこちの助っ人に派遣されている。"},{"spoiler":false,"text":"本人はデスクワークへの異動を常に申請中。"},{"spoiler":false,"text":"もっとも、上層部は無視している模様。"}],"source":"egs","sourceCharacterId":"8367","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"神主候補の青年。"},{"spoiler":false,"text":"ヒロイン達とは親戚関係にある神社の倅。"},{"spoiler":false,"text":"拳や蹴りで妖怪を退治する格闘術の使い手ですが、"},{"spoiler":false,"text":"性格は温厚な平和主義者です。"},{"spoiler":false,"text":"その為、戦闘はあまり好きではないのですが、"},{"spoiler":false,"text":"なまじ腕があるせいで、あちこちの助っ人に"},{"spoiler":false,"text":"派遣されています。"},{"spoiler":false,"text":"本人はデスクワークへの異動を常に申請中。"}],"source":"bangumi","sourceCharacterId":"140632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc673e37546ea15af4f4d883da16c7572263f3669befec4cd3e6d24f8dd7428e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/im