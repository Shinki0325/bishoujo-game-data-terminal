nId":"egs:work-creator:84339","source":"egs"},{"creditedName":"りりあん嬢","creatorId":"vndb:s3043","sourcePersonId":"egs:creator:2192","canonicalEntityId":"vndb:s3043","name":"りりあん嬢","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:94166","source":"egs"}],"music":[{"creditedName":"有限会社 クワイア","creatorId":"vndb:s1266","sourcePersonId":"vndb:s1266","canonicalEntityId":"vndb:s1266","name":"有限会社 クワイア","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:44038","source":"vndb"}],"other":[{"creditedName":"Ayumi.(オリヒメヨゾラ、織姫よぞら、nerine)","creatorId":"vndb:s1282","sourcePersonId":"egs:creator:19735","canonicalEntityId":"vndb:s1282","name":"Ayumi.(オリヒメヨゾラ、織姫よぞら、nerine)","detail":"OP曲「黒い蝶♀」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:103689","source":"egs"},{"creditedName":"オリヒメ ヨゾラ","creatorId":"vndb:s1282","sourcePersonId":"vndb:s1282","canonicalEntityId":"vndb:s1282","name":"Ayumi.","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:44039","source":"vndb"}]},"cast":[{"characterId":"char_c17047","characterName":"パーフェクト・メイデン","sourceIds":{"bangumi":[{"characterId":"46983","match":"exact-normalized-name-in-linked-work","subjectId":"66599"},{"characterId":"46983","match":"exact-normalized-name-in-linked-work","subjectId":"80603"}],"egsCharacterIds":["745"],"vndbCharacterId":"c17047"},"originalCharacterName":"パーフェクト・メイデン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【パーフェクト・メイデン】"},{"spoiler":false,"text":"・階級：フルムーン"},{"spoiler":false,"text":"・身長：169cm"},{"spoiler":false,"text":"・武器：王家に伝わるレイピア"},{"spoiler":false,"text":"Ｇ・ルナリアムの姫であり、リーダーの証「フルムーン」の紋章を持つ。"},{"spoiler":false,"text":"地上での名前は“ルルーナ・フォンブラウン・ムーンランド”。"},{"spoiler":false,"text":"気位が非常に高く、王族であること、そして幹部たちのリーダーであることを誇りに思っている。"},{"spoiler":false,"text":"周りが女ばかりで育ったため、男ギライの気があり、主人公には厳しく当たる。"},{"spoiler":false,"text":"全てにおいて完璧を自称するが、あまり学業のほうがよろしくないという噂も……。"},{"spoiler":false,"text":"地上ではムーンランド公国の留学生として、シルバスターこと十五夜つきみと同じ学園の同じクラスに所属する。"},{"spoiler":false,"text":"「このルナテミス、Ｇ・ルナリアムの姫としての誇りにかけて、必ずやシルバスターを仕留めてご覧に入れましょう！」"}],"source":"egs","sourceCharacterId":"745","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【パーフェクト・メイデン】"},{"spoiler":false,"text":"幹部たちのリーダーにして王国のお姫様。最年少ながら最強の実力を誇る。"},{"spoiler":false,"text":"地球上ではムーンランド公国の姫として、正義のヒロイン十五夜つきみ＆まりあ姉妹と同じ学園に通う。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"海への旅行と聞いて浮かれるルナテミスだったが、宿泊場所である民宿のあまりのボロさに心が折れそうになる。"},{"spoiler":false,"text":"さらにヘカテリーナの特訓や学園の課題と、数々の試練に直面することに。"},{"spoiler":false,"text":"「無理っ！　こんなところで一夜を明かすのは100％無理ですわ！"},{"spoiler":false,"text":"パーフェクト・メイデンたるこの私が言うのだから間違い無いわ！」"}],"source":"egs","sourceCharacterId":"745","sourceWorkId":"16574","spoiler":false},{"segments":[{"spoiler":false,"text":"幹部たちのリーダーにして王国のお姫様。"},{"spoiler":false,"text":"最年少ながら最強の実力を誇る。"},{"spoiler":false,"text":"地球上ではムーンランド公国の姫として、正義のヒロイン・十五夜つきみ＆まりあ姉妹と同じ学園に通う。"},{"spoiler":false,"text":"【リゾート編エピソード】"},{"spoiler":false,"text":"海への旅行と聞いて浮かれるルナテミスだったが、宿泊場所である民宿のあまりのボロさに心が折れそうになる。"},{"spoiler":false,"text":"さらにヘカテリーナの特訓や学園の課題と、数々の試練に直面することに。"},{"spoiler":false,"text":"「無理っ！　こんなところで一夜を明かすのは100％無理ですわ！　パーフェクト・メイデンたるこの私が言うのだから間違い無いわ！」"}],"source":"bangumi","sourceCharacterId":"46983"}],"profileFacts":[{"label":"身高（本版本）","value":"169 cm","valueContext":null,"source":"egs","sourceCharacterId":"745","sourceWorkId":"13527","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf55c2901581af3bab8febdb4c8c743347b02fe79741a17464d05b64798e016f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0715bb0828378ceabae3014451c3f791454e9d562a734bb547f8c5572a61c02d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66599:46983:5669:1","source":"bangumi"}]},{"characterId":"char_c17048","characterName":"カグヤ","sourceIds":{"bangumi":[],"egsCharacterIds":["746"],"vndbCharacterId":"c17048"},"originalCharacterName":"カグヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaguya is Lunatemis' personal maid and number 2 of the organization. She is also Katsuma's childhood friend. Unlike Katsuma she is extremely talented, which, unknown to her, annoys him. Given her own annoyance at Maria calling the protagonist by his first name, it seems Kaguya is quite possessive over Katsuma. She even goes as far as to question the relationship he has with Maria."}],"source":"vndb","sourceCharacterId":"c17048"},{"segments":[{"spoiler":false,"text":"【月隠流忍術正統】"},{"spoiler":false,"text":"・階級：ハーフムーン"},{"spoiler":false,"text":"・身長：167cm"},{"spoiler":false,"text":"・武器：二振りの忍者刀「シャドウブレード」"},{"spoiler":false,"text":"組織の２番手、ハーフムーンの紋章をもつ幹部。地上での名前は“月影輝夜”。"},{"spoiler":false,"text":"主人公の幼馴染だが落ちこぼれの主人公と違い、優秀で地位に見合う実力の持ち主。"},{"spoiler":false,"text":"Ｇ・ルナリアムの歴史から失われていた「月影流忍術」復活させた忍者マスターで、"},{"spoiler":false,"text":"命令であればどんな任務でも顔色一つ変えずにこなす。"},{"spoiler":false,"text":"幼馴染の主人公のことは少なからず心配しており、主人公が今の地位にいられるよういろいろフォローしている。"},{"spoiler":false,"text":"しかし主人公にはそれが強者の驕りだと忌々しく思われている。"},{"spoiler":false,"text":"地上の大使館ではメイドとして働き、主にルルーナの面倒を見ている。"},{"spoiler":false,"text":"「……相手が気づかぬうちに仕留める……それが忍の流儀。必ずやシルバスターの首を持ち帰ってご覧にいれます」"}],"source":"egs","sourceCharacterId":"746","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【月影流忍術正統】"},{"spoiler":false,"text":"月影流忍術を操る無口な女忍者。"},{"spoiler":false,"text":"人前に出るのを嫌い、影からターゲットを討つことを信条としている。"},{"spoiler":false,"text":"主人公カツマの幼馴染みでもある。"},{"spoiler":false,"text":"地球上ではメイドとしてルルーナを公私ともに支える。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"海には特別な思い入れのあるカグヤだが、いまいち気乗りできない理由があった。"},{"spoiler":false,"text":"それは強い日差しとたくさんの人。"},{"spoiler":false,"text":"数多の光線と視線をその身に浴びて、カグヤの限界は近づきつつあった。"},{"spoiler":false,"text":"「……………………暑い」"}],"source":"egs","sourceCharacterId":"746","sourceWorkId":"16574","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"746","sourceWorkId":"13527","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78ea0f7815ef6c22a94f7cc762be5cbd37e74fa11e83a86052c85b5ece61fb4a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f8281e775c4368f1a5851b29f1a27cb0ffff7787811053e2c8223cc3a2906f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"片倉 ひな","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24337","source":"vndb"}]},{"characterId":"char_c17049","characterName":"エファ・グラナーダ","sourceIds":{"bangumi":[{"characterId":"46986","match":"exact-normalized-name-in-linked-work","subjectId":"66599"},{"characterId":"46986","match":"exact-normalized-name-in-linked-work","subjectId":"80603"}],"egsCharacterIds":["747"],"vndbCharacterId":"c17049"},"originalCharacterName":"エファ・グラナーダ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【狂魔元帥】"},{"spoiler":false,"text":"・階級：ハーフムーン"},{"spoiler":false,"text":"・身長：174cm"},{"spoiler":false,"text":"・武器：鍵爪状の武器「デモンズフック」"},{"spoiler":false,"text":"カグヤと同じ階級である、ハーフムーンの幹部。"},{"spoiler":false,"text":"地上での名前は“エファ・グラナーダ”。"},{"spoiler":false,"text":"快楽主義でサディストだが、王国と女王への忠義は本物で、その忠誠心ゆえに魔道に身を落とし、強大な魔力を手に入れた。"},{"spoiler":false,"text":"代償として外見は悪魔のようになってしまったが、本人はむしろ美しくなったとさえ思っている。"},{"spoiler":false,"text":"地上では大使館の館長を勤め、クセ者揃いの部下達をまとめあげる。"},{"spoiler":false,"text":"見た目はいつも笑顔を絶やさない優しい人物だが、中身は悪魔そのものである。"},{"spoiler":false,"text":"「クズのくせに、いい度胸してんじゃないのさ。表に出な！　先にお仕置きを済ませておいてやるよ」"}],"source":"egs","sourceCharacterId":"747","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【狂魔元帥】"},{"spoiler":false,"text":"幹部たちの最古参であり、時にはルナテミスの代わりに幹部たちをまとめることもある実力者。"},{"spoiler":false,"text":"強気な性格だが王国に対しては忠実で、そのために魔道に身をやつして肌の色さえ変えてしまった。"},{"spoiler":false,"text":"地球上では大使館の美人館長として辣腕を振るっている。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"特訓とはいえ、久しぶりの海を満喫するエファナティカ。"},{"spoiler":false,"text":"せわしない日々を忘れ緩やかな時間を楽しむものの、そんな姿が『おばさん臭い』と金髪の爆乳女に揶揄されて……"},{"spoiler":false,"text":"「私って、おばさん臭い？　そんなことないわよね？　ないって言って！」"}],"source":"egs","sourceCharacterId":"747","sourceWorkId":"16574","spoiler":false},{"segments":[{"spoiler":false,"text":"幹部たちの最古参であり、時にはルナテミスの代わりに幹部たちをまとめることもある実力者。"},{"spoiler":false,"text":"強気な性格だが王国に対しては忠実で、そのために魔道に身をやつして肌の色さえ変えてしまった。"},{"spoiler":false,"text":"地球上では大使館の美人館長として辣腕を振るっている。"},{"spoiler":false,"text":"【リゾート編エピソード】"},{"spoiler":false,"text":"特訓とはいえ、久しぶりの海を満喫するエファナティカ。"},{"spoiler":false,"text":"せわしない日々を忘れ緩やかな時間を楽しむものの、そんな姿が 「おばさん臭い」 と金髪の爆乳女に揶揄されて……"},{"spoiler":false,"text":"「私って、おばさん臭い？　そんなことないわよね？　ないって言って！」"}],"source":"bangumi","sourceCharacterId":"46986"}],"profileFacts":[{"label":"身高（本版本）","value":"174 cm","valueContext":null,"source":"egs","sourceCharacterId":"747","sourceWorkId":"13527","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18c506a48435ed0d0ca11d01b45c64d46cd8c1ff05ce40bac560fdc0d11b1a2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/598d01acab67d0aa00bd3d9a3d62a5af9f64e05998d82ade7febd5c33ee29758.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66599:46986:4832:1","source":"bangumi"}]},{"characterId":"char_c17050","characterName":"セレイン・チャン","sourceIds":{"bangumi":[{"characterId":"46987","match":"exact-normalized-name-in-linked-work","subjectId":"66599"},{"characterId":"46987","match":"exact-normalized-name-in-linked-work","subjectId":"80603"}],"egsCharacterIds":["748"],"vndbCharacterId":"c17050"},"originalCharacterName":"セレイン・チャン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【獣狼拳】"},{"spoiler":false,"text":"・階級：クレセントムーン"},{"spoiler":false,"text":"・身長：１７６ｃｍ"},{"spoiler":false,"text":"・武器：「王王棒(わんわんろっど)」"},{"spoiler":false,"text":"３人のクレセントムーンの一人。地上での名前は“セレイン・チャン”。"},{"spoiler":false,"text":"Ｇ・ルナリアムでは希少種といわれる月狼族の若き族長で、一族に伝わる拳法『獣狼拳』を操る。"},{"spoiler":false,"text":"典型的な格闘バカだが、あまりにバカ過ぎてちょっとやそっとのことでは動じない。"},{"spoiler":false,"text":"小細工を弄するのは苦手だが格闘センスは抜群で、単純な戦闘能力ではフルムーンのルナテミスを凌ぐとも言われている。"},{"spoiler":false,"text":"地上の大使館ではボディーガードを命ぜられているが、平和な日本ではあまり仕事が無いので、商店街で肉まんを買ってはパクついている。"},{"spoiler":false,"text":"「お任せください女王様。このセレーナが、正々堂々、完全勝利でシルバスターを打ちのめしてきます！」"}],"source":"egs","sourceCharacterId":"748","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【獣狼拳】"},{"spoiler":false,"text":"王国の武闘派『月狼族』の若き族長。"},{"spoiler":false,"text":"月狼拳という拳法を操り、体術では王国一との誉れも高い戦士。"},{"spoiler":false,"text":"地球上では大使館のボディガードを務めているものの、仕事が無いため日がな一日ぶらぶらしている。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"セレーナは海に来ても相変わらずなにかと勝負し続けていた。"},{"spoiler":false,"text":"ヘカテリーナ、オボロ、そして海……しかし、一番手ごわい相手は己の心だった"},{"spoiler":false,"text":"「頭なら使ってるじゃないか！　ばっちゃんもさっき見ただろ？"},{"spoiler":false,"text":"私の華麗な三段頭突きを！」"}],"source":"egs","sourceCharacterId":"748","sourceWorkId":"16574","spoiler":false},{"segments":[{"spoiler":false,"text":"王国の武闘派 “月狼族” の若き族長。"},{"spoiler":false,"text":"月狼拳という拳法を操り、体術では王国一との誉れも高い戦士。"},{"spoiler":false,"text":"地球上では大使館のボディガードを務めているものの、仕事が無いため日がな一日ぶらぶらしている。"},{"spoiler":false,"text":"【リゾート編エピソード】"},{"spoiler":false,"text":"セレーナは海に来ても相変わらずなにかと勝負し続けていた。"},{"spoiler":false,"text":"へカテリーナ、オボロ、そして海…… しかし、一番手ごわい相手は己の心だった。"},{"spoiler":false,"text":"「頭なら使ってるじゃないか！　ばっちゃんもさっき見ただろ？　私の華麗な三段頭突きを！」"}],"source":"bangumi","sourceCharacterId":"46987"}],"profileFacts":[{"label":"身高（本版本）","value":"176 cm","valueContext":null,"source":"egs","sourceCharacterId":"748","sourceWorkId":"13527","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e614224ef281cafc10d99ce15384397ee47b8614970dbac999c42bc8d019729.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02052da468772f878a9ae473880714fb696efa09c43a97814af8dbd0e8e1eb8c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66599:46987:4177:1","source":"bangumi"}]},{"characterId":"char_c17051","characterName":"オボロ","sourceIds":{"bangumi":[],"egsCharacterIds":["749"],"vndbCharacterId":"c17051"},"originalCharacterName":"オボロ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【幽夜(かくりよ)に嗤う】"},{"spoiler":false,"text":"・階級：クレセントムーン"},{"spoiler":false,"text":"・身長：158cm"},{"spoiler":false,"text":"・武器：霊符"},{"spoiler":false,"text":"3人のクレセントムーンの一人。"},{"spoiler":false,"text":"地上での名前は"},{"spoiler":false,"text":"月狼族と同じく希少種の月兎族の出身。"},{"spoiler":false,"text":"直接的な戦闘力はあまり高くなく、霊符や式神などを操る術を得意とする。"},{"spoiler":false,"text":"クールで皮肉屋だが、月狼族のセレーナとはしょっちゅうケンカばかりしている。"},{"spoiler":false,"text":"大使館では事務・経理を担当。"},{"spoiler":false,"text":"情報関係に強く、零細な大使館の経理をあらゆる手段を使って支えている。"},{"spoiler":false,"text":"「ウチがシルバスターにどこまで通用するか？　フフ、笑止」"}],"source":"egs","sourceCharacterId":"749","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【幽世に嗤う】"},{"spoiler":false,"text":"月の住人である『月兎族』の鬼才と言われた幹部で、札や陣による術、研棒術数に優れる。"},{"spoiler":false,"text":"セレーナとは対抗意識を燃やし、お互い切磋琢磨している間柄。"},{"spoiler":false,"text":"地球上では大使館の事務や経理を担当し、館長であるエファを補佐する。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"それほどアクティブではないオボロはバカンスにも消極的。"},{"spoiler":false,"text":"しかしそれには理由があった。オボロ唯一にして最大の弱点。それは……"},{"spoiler":false,"text":"「外に出れば日に焼け、海に入れば髪が傷みます。"},{"spoiler":false,"text":"おまけにこの暑さ……自殺行為です。バカバカしいです」"}],"source":"egs","sourceCharacterId":"749","sourceWorkId":"16574","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"749","sourceWorkId":"13527","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fceb435ad0f46c747859db4f7803fc73628f33fd56326c420162716d880f5b6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8f7cecf2cc3b61812d4cd45236a627bbe867eb4843a6d6dd2c1e893b4b0668c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青井 美海","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24338","source":"vndb"}]},{"characterId":"char_c17052","characterName":"ダイヤナ","sourceIds":{"bangumi":[{"characterId":"46989","match":"exact-normalized-name-in-linked-work","subjectId":"66599"},{"characterId":"46989","match":"exact-normalized-name-in-linked-work","subjectId":"80603"}],"egsCharacterIds":["750"],"vndbCharacterId":"c17052"},"originalCharacterName":"ダイヤナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【ハイグレード・ダイヤモンド】"},{"spoiler":false,"text":"・階級：クレセントムーン"},{"spoiler":false,"text":"・身長：１６４ｃｍ"},{"spoiler":false,"text":"・武器：巨大キセル「ディアマンテ」"},{"spoiler":false,"text":"地球を裏切ってＧ・ルナリアムに付いた元地球人。"},{"spoiler":false,"text":"地上での名前は“ディアナ・アーマーン”。"},{"spoiler":false,"text":"月の人間の末裔で、その潜在能力に目を付けた女王によりスカウトされた。"},{"spoiler":false,"text":"特に崇高な信念などはなく、即物的であり欲望には正直に生きる快楽主義者。"},{"spoiler":false,"text":"女王とは任務達成の暁には世界中全ての宝石を自分のものとする約束をしている。"},{"spoiler":false,"text":"細かいことは気にしない性格だが、昔のことを詮索されると激しい敵意を見せる。"},{"spoiler":false,"text":"地上では大使館の広報・営業を担当しているが、外で遊び歩いてるのを見つかっては館長に怒られている。"},{"spoiler":false,"text":"「んふふ……シルバスターなんかメッタメタにやっつけちゃって、ついでに宝石もゲットよん！」"}],"source":"egs","sourceCharacterId":"750","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【ハイグレード・ダイヤモンド】"},{"spoiler":false,"text":"元地球人で、裏切って王国についた異色の経歴を持つ。"},{"spoiler":false,"text":"潜在能力は随一で、手にした巨大きせる『ディアマンテ』によって炎を自在に操る。"},{"spoiler":false,"text":"地球上では大使館の広報を務めるものの、職務に忠実とは言いがたい。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"珍しい海でのバカンスに気合十分のダイヤナ。"},{"spoiler":false,"text":"ところがダイヤナにとってつきみとまりあが着いてきたのは想定外だった。"},{"spoiler":false,"text":"彼女にとって十五夜姉妹は開けてはならないパンドラの箱、黒歴史を知る人物なのだ。"},{"spoiler":false,"text":"「何かあった？　じゃないわ。これから起こすのよ。このビーチにディアナちゃん旋風を、ね」"}],"source":"egs","sourceCharacterId":"750","sourceWorkId":"16574","spoiler":false},{"segments":[{"spoiler":false,"text":"元地球人で、裏切って王国についた異色の経歴を持つ。"},{"spoiler":false,"text":"潜在能力は随一で、手にした巨大キセル “ディアマンテ” によって炎を自在に操る。"},{"spoiler":false,"text":"地球上では大使館の広報を務めるものの、職務に忠実とは言いがたい。"},{"spoiler":false,"text":"【リゾート編エピソード】"},{"spoiler":false,"text":"珍しい海でのバカンスに気合十分のダイヤナ。"},{"spoiler":false,"text":"ところがダイヤナにとって、つきみとまりあが付いてきたのは想定外だった。"},{"spoiler":false,"text":"彼女にとって十五夜姉妹は開けてはならないパンドラの箱、黒歴史を知る人物なのだ。"},{"spoiler":false,"text":"「何かあった？ じゃないわ。これから起こすのよ。このビーチにディアナちゃん旋風を、ね」"}],"source":"bangumi","sourceCharacterId":"46989"}],"profileFacts":[{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"750","sourceWorkId":"13527","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb91e96678e385655de9d231e0b8f6f50c0b64880e4c35206244b8cceb144255.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efa6f7a3af7d4ab5aa4b0ecc4728bc035727d927dffb8d9d80816481b6917ecd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前川優子","creatorId":"vndb:s1064","sourcePersonId":"vndb:s1064","canonicalEntityId":"vndb:s1064","name":"前川 優子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66599:46989:6321:1","source":"bangumi"}]},{"characterId":"char_c17053","characterName":"ルナルバース13世","sourceIds":{"bangumi":[{"characterId":"46990","match":"exact-normalized-name-in-linked-work","subjectId":"66599"},{"characterId":"46990","match":"exact-normalized-name-in-linked-work","subjectId":"80603"}],"egsCharacterIds":["751"],"vndbCharacterId":"c17053"},"originalCharacterName":"ルナルバース13世","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【ミレニアム・クィーン】"},{"spoiler":false,"text":"現代に復活したＧ・ルナリアムの女王でルナテミスの母。"},{"spoiler":false,"text":"フルムーンを凌ぐダブルムーンの紋章を持ち、王国に君臨する。"},{"spoiler":false,"text":"千年生きているとも言われているが、見た目は若いまま。"},{"spoiler":false,"text":"王国の安定と未来を常に考え、部下達にも寛容。"},{"spoiler":false,"text":"優秀な統治者として、全国民から尊敬と畏怖を集める存在。"},{"spoiler":false,"text":"反面、プライベートは奔放で、男女や階級を問わず手を出しまくる困った人である。"},{"spoiler":false,"text":"「シルバスターを退けぬ限り、この死の大地にパラダイスを築くことなど夢のまた夢……。なんなら、余が自ら出ても構わぬのじゃぞ？」"}],"source":"egs","sourceCharacterId":"751","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【ミレニアム・クイーン】"},{"spoiler":false,"text":"Ｇ・ルナリアムの女王にして王国最高位の紋章『ダブルムーン』を持つ女性。"},{"spoiler":false,"text":"１０００年以上の時を生きていると言われているが、その絶大な力により、見た目は若いままで保たれている。"},{"spoiler":false,"text":"英雄色を好むのとおり、性に対しては奔放で、いろんな人間にちょっかいを出してはトラブルを引き起こす。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"今回の特訓を一番楽しみにしていたのは女王だった。"},{"spoiler":false,"text":"最高責任者として日がな一日玉座で過ごす毎日。"},{"spoiler":false,"text":"その鬱積を晴らすかのうように、解き放たれた女王は力の限りビーチで遊びまわる。"},{"spoiler":false,"text":"「余の今までの退屈で退屈で超退屈な城での生活の鬱憤を晴らしまくるのじゃあ！"},{"spoiler":false,"text":"今の余は誰にも止められないィィ!!」"}],"source":"egs","sourceCharacterId":"751","sourceWorkId":"16574","spoiler":false},{"segments":[{"spoiler":false,"text":"G・ルナリアムの女王にして王国最高位の紋章 “ダブルムーン” を持つ女性。"},{"spoiler":false,"text":"1000年以上の時を生きていると言われているが、その絶大な力により見た目は若いままで保たれている。"},{"spoiler":false,"text":"英雄色を好むのとおり性に対しては奔放で、いろんな人間にちょっかいを出してはトラブルを引き起こす。"},{"spoiler":false,"text":"【リゾート編エピソード】"},{"spoiler":false,"text":"今回の特訓を一番楽しみにしていたのは女王だった。"},{"spoiler":false,"text":"最高責任者として日がな一日玉座で過ごす毎日。"},{"spoiler":false,"text":"その鬱憤を晴らすかのように、解き放たれた女王は力の限りビーチで遊びまわる。"},{"spoiler":false,"text":"「余の今までの退屈で退屈で超退屈な城での生活の鬱憤を晴らしまくるのじゃあ！　今の余は誰にも止められないィィ!!」"}],"source":"bangumi","sourceCharacterId":"46990"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32525f35c3e7ea5fe03c40676f04daa538136e2c52f8966c99dcd0799df92b56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b2e0afa468bcf6ec9ecde83123ae954db6ce2400492004495f9145cc84a9bea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66599:46990:8055:1","source":"bangumi"}]},{"characterId":"char_c17054","characterName":"シルバスター","sourceIds":{"bangumi":[{"characterId":"46991","match":"exact-normalized-name-in-linked-work","subjectId":"66599"},{"characterId":"46991","match":"exact-normalized-name-in-linked-work","subjectId":"80603"}],"egsCharacterIds":["752"],"vndbCharacterId":"c17054"},"originalCharacterName":"シルバスター","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【銀星装甲シルバスター】"},{"spoiler":false,"text":"正義のヒロイン「シルバスター」に変身してＧ・ルナリアムの魔の手から地球を守るために戦う元気娘。"},{"spoiler":false,"text":"つきみはまず「ガン・シスター」と呼ばれるセミ戦闘形態に変身、その後姉のまりあと融合合身することで「シルバスター」へと２段変身する。"},{"spoiler":false,"text":"性格は明朗快活で、罪を憎んで人を憎まず！が信条。"},{"spoiler":false,"text":"普段は姉と共に、市内の学園に通う女学生である。"},{"spoiler":false,"text":"「街の人々を無意味に傷つけるのは許さない　これ以上やるならわたしが相手だよ！」"}],"source":"egs","sourceCharacterId":"752","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【銀星装甲シルバスター】"},{"spoiler":false,"text":"Ｇ・ルナリアムの宿敵ともいうべき、地球を守る正義のヒロイン。"},{"spoiler":false,"text":"ステラルクスという反Ｇ・ルナリアム組織に属し、『シルバスター』という戦士に変身し、悪の女幹部たちと戦いを繰り広げる。"},{"spoiler":false,"text":"本人は明るくマイペース、いわゆる天然な性格をしている。"},{"spoiler":false,"text":"ルルーナ(ルナテミス)とは学園のクラスメイトで親友。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"ルルーナたちが悪の女幹部たちとは知らず、のんきに民宿へと足を運ぶつきみ。"},{"spoiler":false,"text":"そんなつきみを牙を研いで待ち受ける女幹部たちだったが、つきみのポテンシャルを目の当たりにして驚愕することに。"},{"spoiler":false,"text":"「えっとね、お姉ちゃんが突然ここに旅行するって……むぐっ！」"}],"source":"egs","sourceCharacterId":"752","sourceWorkId":"16574","spoiler":false},{"segments":[{"spoiler":false,"text":"G・ルナリアムの宿敵ともいうべき、地球を守る正義のヒロイン。"},{"spoiler":false,"text":"『ステラルクス』 という反G・ルナリアム組織に属し、“シルバスター” という戦士に変身し、悪の女幹部たちと戦いを繰り広げる。"},{"spoiler":false,"text":"本人は明るくマイペース、いわゆる天然な性格をしている。"},{"spoiler":false,"text":"ルルーナ（ルナテミス）とは学園のクラスメイトで親友。"},{"spoiler":false,"text":"【リゾート編エピソード】"},{"spoiler":false,"text":"ルルーナたちが悪の女幹部たちとは知らず、のんきに民宿へと足を運ぶつきみ。"},{"spoiler":false,"text":"そんなつきみを、牙を研いで待ち受ける女幹部たちだったが、つきみのポテンシャルを目の当たりにして驚愕することに。"},{"spoiler":false,"text":"「えっとね、お姉ちゃんが突然ここに旅行するって……むぐっ！」"}],"source":"bangumi","sourceCharacterId":"46991"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df7db7bb757f562d2d56e06488514ccfcbd67b716e9eade209f52b7ca9585a81.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02ec70b17c4aa8bc5db377ef13ad433d1df437bf5d79e8db2f8b1bc7932d856e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66599:46991:6106:1","source":"bangumi"}]},{"characterId":"char_c17055","characterName":"十五夜 まりあ","sourceIds":{"bangumi":[{"characterId":"46992","match":"exact-normalized-name-in-linked-work","subjectId":"66599"},{"characterId":"46992","match":"exact-normalized-name-in-linked-work","subjectId":"80603"}],"egsCharacterIds":["753"],"vndbCharacterId":"c17055"},"originalCharacterName":"十五夜 まりあ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【つきみのサポート役】"},{"spoiler":false,"text":"つきみの姉で、シルバスターとして戦う妹のことをサポートする。"},{"spoiler":false,"text":"シルバスターはまりあを取り込むことでその本来の力を発揮することができるようになる。"},{"spoiler":false,"text":"沈着冷静で、戦闘時は戦略面で妹をサポートする。"},{"spoiler":false,"text":"しかし、体を張って戦うのはあくまで妹なので、本人にはそのことがコンプレックスになっており、そこを主人公につけ込まれることに……。"},{"spoiler":false,"text":"「……そう、よ。これ以上、つきみを危険な目に合わせるわけにはいかないの……私がやらなくちゃ……」"}],"source":"egs","sourceCharacterId":"753","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【つきみのサポート役】"},{"spoiler":false,"text":"十五夜つきみの姉であり、つきみと共にシルバスターに変身する正義のヒロイン。"},{"spoiler":false,"text":"しかしあくまでサポート役であり、直接戦闘するつきみに引け目を感じており、その心の隙間をカツマに利用されてしまうことに。"},{"spoiler":false,"text":"▼リゾート編エピソード"},{"spoiler":false,"text":"カツマが海に行くことを知って強引に着いてきてしまったまりあ。"},{"spoiler":false,"text":"ひょんなことからルルーナの課題のことを知り、勉強を教えることに。"},{"spoiler":false,"text":"「あなたは黙ってなさい。いえ、たまたまです。"},{"spoiler":false,"text":"偶然旅行に来たら鉢合わせたというだけですよ、ムーンランドさん」"}],"source":"egs","sourceCharacterId":"753","sourceWorkId":"16574","spoiler":false},{"segments":[{"spoiler":false,"text":"十五夜つきみの姉であり、つきみと共にシルバスターに変身する正義のヒロイン。"},{"spoiler":false,"text":"しかしあくまでサポート役であり、直接戦闘するつきみに引け目を感じており、その心の隙間をカツマに利用されてしまうことに。"},{"spoiler":false,"text":"【リゾート編エピソード】"},{"spoiler":false,"text":"カツマが海に行くことを知って強引に付いてきてしまったまりあ。"},{"spoiler":false,"text":"ひょんなことからルルーナの課題のことを知り、勉強を教えることに。"},{"spoiler":false,"text":"「あなたは黙ってなさい。いえ、たまたまです。偶然旅行に来たら鉢合わせたというだけですよ、ムーンランドさん」"}],"source":"bangumi","sourceCharacterId":"46992"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffcdbfeff91924168ef3174df31bd8cebe32034a2cc2e482a4f67e3df8721d24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f349685df40cb37324af8da4420d7769f9948acee4b9fe0993f302ee0195ec0.webp","width":86,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66599:46992:8055:1","source":"bangumi"}]},{"characterId":"char_c17057","characterName":"ジュンジロー","sourceIds":{"bangumi":[],"egsCharacterIds":["755"],"vndbCharacterId":"c17057"},"originalCharacterName":"ジュンジロー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【主人公の部下】"},{"spoiler":false,"text":"主人公に割り当てられた部下で、月面ドーベルマンという種。"},{"spoiler":false,"text":"ただの犬ではなく、知性があり人と同じ言葉をしゃべることができる。"},{"spoiler":false,"text":"ぐうたらでまったく役に立たないが、態度だけはムダにでかい。"},{"spoiler":false,"text":"大使館では番犬として警備員である主人公と行動を共にしている。"},{"spoiler":false,"text":"「ご主人のとばっちりで私までお仕置きされるのはいやですぞ」"}],"source":"egs","sourceCharacterId":"755","sourceWorkId":"13527","spoiler":false},{"segments":[{"spoiler":false,"text":"【カツマの部下の犬】"},{"spoiler":false,"text":"カツマに割り当てられた唯一の部下で、月面ドーベルマンという種類。"},{"spoiler":false,"text":"人間と同じ言葉を喋る。ひたすらぐーたらで基本的に役立たず。"},{"spoiler":false,"text":"「おお……バカンスに来てもなお仕事熱心。感服致します」"}],"source":"egs","sourceCharacterId":"755","sourceWorkId":"16574","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef810bf606e8366f9edeafa330c16add4abef3cb9736f587eb39285a37481908.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecec3d8099fa0fdec700bd338709d2cb5eae8bd9c6cf4886cdb94234dd70645b.webp","width":105,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c17063","characterName":"ピースムーン","sourceIds":{"bangumi":[],"egsCharacterIds":["754"],"vndbCharacterId":"c17063"},"originalCharac