vndb:s59","name":"谷山 紀章","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:63038","source":"vndb"},{"creditedName":"桜 ひろし","creatorId":"vndb:s64","sourcePersonId":"vndb:s64","canonicalEntityId":"vndb:s64","name":"前野 智昭","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:63039","source":"vndb"},{"creditedName":"ひよ","creatorId":"vndb:s1684","sourcePersonId":"vndb:s1684","canonicalEntityId":"vndb:s1684","name":"ひよ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:63041","source":"vndb"},{"creditedName":"西緒 十琉","creatorId":"vndb:s2381","sourcePersonId":"vndb:s2381","canonicalEntityId":"vndb:s2381","name":"西緒 十琉","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:63042","source":"vndb"},{"creditedName":"時風 聖夜","creatorId":"vndb:s28299","sourcePersonId":"vndb:s28299","canonicalEntityId":"vndb:s28299","name":"時風 聖夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63049","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c10244","characterName":"ティアナ","sourceIds":{"vndbCharacterId":"c10244"},"originalCharacterName":"ティアナ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young lady that came to live with Ookami-san after her stepmother discreetly chased her out. Although somewhat strong-willed and stubborn, at heart, she is emotionally honest, but sometimes struggles to express herself. In the forest, there a few that wish to \"eat\" her, for which she has mixed feelings about. For some reason, Tiana is the only one that can name herself and be named in the Lost Forest without adverse effect, even though every other resident will meet with misfortune if they do the same."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10244"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/baf03980b1fddb362724400e76a04e5d806b3c8d42d862024fe45411a61e1733.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c5e5668612b18d28c24068e08133b469ce5b641fb259e51d060beb780862473.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35248","source":"vndb"}]},{"characterId":"char_vndb_c10245","characterName":"狼さん","sourceIds":{"vndbCharacterId":"c10245"},"originalCharacterName":"狼さん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"height":{"reviewState":"source-only","source":"vndb","value":"186"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A wolf who let Tiana live with him after finding her wandering around the forest. Saying that the current Tiana is \"not ready to eat\", he decided to take care of her until she is \"ripe\". Even though that is what Ookami-san said, the truth is that he wants to \"eat\" Tiana straight away, and as a result, is quite touchy-feely with her. Calm, composed and somewhat frivolous, because of his strong sense of responsibility, Ookami-san is easy to rely on."},{"spoiler":false,"text":"According to Kitsune-san, Ookami-san is \"a man among men; an alpha male\". He doesn't get along with Yamaneko-san. Sometimes, he says things and acts in ways that implies he might have known Tiana before their first meeting..."},{"spoiler":true,"text":"According to his ending bonus \"Secret Memo\", Ookami-san's real name is Claus, his favourite food is hot chocolate, favourite colour is black and his hobby is to work out."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10245"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fdcc89ef6dd0bfdd9eb8f569538f0c1b1eee3912ba2d5d2e9f808bfad787dba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e938d0f7cac93557fddca8003660f603e140d0327debfb176e684148a0d6119.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉崎 和哉","creatorId":"vndb:s59","sourcePersonId":"vndb:s59","canonicalEntityId":"vndb:s59","name":"谷山 紀章","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35250","source":"vndb"}]},{"characterId":"char_vndb_c10246","characterName":"山猫さん","sourceIds":{"vndbCharacterId":"c10246"},"originalCharacterName":"山猫さん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of the only restaurant in the Lost Forest, \"Restaurant Solitude\". Though he speaks gently and politely and has a seemingly calm personality, it doesn't feel genuine, but instead, feels cold and impersonal. He shows interest in Tiana, and when the opportunity arises, he tries to \"eat\" her, but Ookami-san interjects before Yamaneko-san can succeed. Ookami-san claims that something bothers him about Yamaneko-san's restaurant and Yamaneko-san's being in the forest, but cannot provide a reason."},{"spoiler":true,"text":"According to his ending bonus \"Secret Memo\", Yamaneko-san's real name is Fredi, his favourite food is apple pie, favourite colour is yellow and his hobby is magical research."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10246"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/573c258b7416440769cd6614e6b687bcea67f2580c008fd8b10905d557b5fbdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06b06109e8253a8100f0ed313f1deee051952b561fd7abe95fd3515ac5d82546.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柴木 幕流","creatorId":"vndb:s56","sourcePersonId":"vndb:s56","canonicalEntityId":"vndb:s56","name":"遊佐 浩二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35249","source":"vndb"}]},{"characterId":"char_vndb_c10247","characterName":"きつねさん","sourceIds":{"vndbCharacterId":"c10247"},"originalCharacterName":"きつねさん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The fox that was apparently once Ookami-san's apprentice. Kitsune-san regards Ookami-san as a \"man's man\", and greatly admires him. After he left Ookami-san's home to live alone, he soon learns that Tiana moved in with him and sees her as annoyance. Simple and frank, he tends to believe everything somebody tells him. One day, he accidentally tells Tiana that she is his type, and begins to get flustered often. Secretly, he is interested in how Tiana \"tastes\". Currently, he works at Yamaneko-san's restaurant as a cook-in-training. His best dish is omelette."},{"spoiler":true,"text":"According to his ending bonus \"Secret Memo\", Kitsune-san's real name is Luc, his favourite food is omelette, favourite colour is white and his hobby is cooking."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10247"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c8efcd824225d7eaa0c3782bbd18c80bbb9452fef043d62c3509ba8542d67bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92f64fd73eeb965b09e021c23679fe93e08ab6f7f505ef2ca7bda30df17c8cb9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春野 風","creatorId":"vndb:s60","sourcePersonId":"vndb:s60","canonicalEntityId":"vndb:s60","name":"春野風","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35251","source":"vndb"}]},{"characterId":"char_vndb_c10250","characterName":"猟師さん","sourceIds":{"vndbCharacterId":"c10250"},"originalCharacterName":"猟師さん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"32"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A hunter that Tiana saved when he had problems with his traps. Ryoushi-san is taciturn, and doesn't talk about himself much. He makes his livelihood hunting in the Lost Forest, particularly hunting wolves. He calls himself \"an old man\" and Tiana \"a young lady\". He has a hidden home in the forest, and doesn't leave until his wounds heal."},{"spoiler":false,"text":"He tells her of a past incident where a villager was killed by a wolf... but which wolf?"},{"spoiler":true,"text":"According to his ending bonus \"Secret Memo\", Ryoushi-san's real name is Gerard, his favourite food is meatloaf, favourite colour is blue and his hobby is the maintenance of his firearms."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10250"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf845ab811fc1820aa6f7c4b4253ab93b7ec752653b729ceb0a8f0528955d8ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/795c745d1cd68b81303a76247d669a0d29f67ad487524144c67b4f77b66f9651.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富士 爆発","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西 克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35255","source":"vndb"}]},{"characterId":"char_vndb_c10252","characterName":"小人さん","sourceIds":{"vndbCharacterId":"c10252"},"originalCharacterName":"小人さん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"With the exact same height, face and voice, the seven of them line up next to one another. Treated like the forest's mascots, all seven of them are loved by the citizens. Out of everybody in the forest, they get on with Kitsune-san the most, because he gives them sweets everyday. They also seem to have some knowledge about many things concerning the mysteries of the Lost Forest."},{"spoiler":true,"text":"The seven dwarves are actually Nazo no Seinen/Otona-san split up. Nazo no Seinen prefers to stay in his dwarven form(s) as he finds it more convenient, as well as the fact that he enjoys the attention, gifts and overall treatement he receives from the citizens of the forest."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10252"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3124a8c7b7bcbd35370d6aedd7abbc75937154da1cccb4f8d2638152e16cd6c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4d4b8343287badd9a70abed76ca23f8ff1fd5271e09ab52ad87b8519062b08a.webp","width":256,"height":131,"source":"static-detail"},"actors":[{"creditedName":"佐藤 しずく","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35252","source":"vndb"}]},{"characterId":"char_vndb_c10254","characterName":"ナイトメア","sourceIds":{"vndbCharacterId":"c10254"},"originalCharacterName":"ナイトメア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"You can meet him in the forest's \"Grey Flower Field\". Hidden behind a mask, you can't see his bare face, but his eyes reflect a certain sadness. Transparent, it's not possible to touch his body. Only Tiana and the Seven Dwarves are able to see Nightmare. Much like the other residents of the cursed Lost Forest, Nightmare's true name is a mystery, and was placed by the dwarves."},{"spoiler":true,"text":"Nightmare is actually the (human) prince of the country the story takes place in. According to his ending bonus \"Secret Memo\", Nightmare's real name is Carlfriedrich and he is 18 years old. His favourite food is mint tea, favourite colour is light blue and his hobby is horse-riding."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10254"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e29b11ba7d2988975c1e9fcf6b676cbcd1caa6df0cdfe5cb2731f124ea1fb6e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aee2e58efab7844338b2452834cfadb6b47971e9cb28593f0458135b989808a3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜 ひろし","creatorId":"vndb:s64","sourcePersonId":"vndb:s64","canonicalEntityId":"vndb:s64","name":"前野 智昭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35254","source":"vndb"}]},{"characterId":"char_vndb_c10256","characterName":"謎の青年","sourceIds":{"vndbCharacterId":"c10256"},"originalCharacterName":"謎の青年","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Only when he sees that you're close to a certain somebody in the story, will Nazo no Seinen make an appearance. He is naive, innocent and cheerful with a bright and carefree personality. Where he lives, what he does and his identity is a mystery."},{"spoiler":true,"text":"Nazo no Seinen is actually the \"true\" form of the Seven Dwarves when they remerge as one. Because of Nazo no Seinen's more adult appearance, Tiana nicknames him \"Otona-san\", which translates to \"Mr. Adult\"."},{"spoiler":true,"text":"While he doesn't have a route, when a certain ending is obtained, as a bonus, you get his \"Secret Memo\". His real name is Anel and he is 25-years-old. His favourite food is sweets, favourite colour is the seven colours of the rainbow and his hobby is to collect beetles, specifically, Rhinoceros beetles."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10256"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/598d74e3c6c1a3abcba6c221a02c030de82bbaeddd9e8644fd57c2f0689ec01b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0dbf563ac0141e4aa233d413416a9591d2bbf09419e0a076494e7c2756c2567.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川 ゆうすけ","creatorId":"vndb:s63","sourcePersonId":"vndb:s63","canonicalEntityId":"vndb:s63","name":"寺島 拓篤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35253","source":"vndb"}]},{"characterId":"char_vndb_c10257","characterName":"ウサギさん","sourceIds":{"vndbCharacterId":"c10257"},"originalCharacterName":"ウサギさん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"height":{"reviewState":"source-only","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head chef of Restaurant Solitude. As his culinary skills are incredible, he is also Kitsune-san's cooking \"teacher\". Though a very tall man with a large body structure, Usagi-san is calm, carefree and gentle. He lets the Seven Dwarves play \"climb climb\", which is where they climb up and around Usagi-san. As Usagi-san allows them climb him to their heart's content, he's popular with the Dwarves."},{"spoiler":false,"text":"Taken from the official website"}],"source":"vndb","sourceCharacterId":"c10257"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca02195362f2520766b040dd54508fde32280fdbaa92ade8d2c63bc87da9527f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4da7c220ba49382b91dc8fdb1b68255c143a0b211c1aa025ee8b2bd4bc4466a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沖野 靖夫","creatorId":"vndb:s67","sourcePersonId":"vndb:s67","canonicalEntityId":"vndb:s67","name":"高橋 広樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35256","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1866","sourceCompanyId":"egs:brand:3197","canonicalEntityId":"vndb:p1866","name":"キャラメリアトルテ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15034:3197","source":"egs"},{"companyId":"vndb:p1866","sourceCompanyId":"vndb:p1866","canonicalEntityId":"vndb:p1866","name":"キャラメリアトルテ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:14572:v6256","source":"vndb"},{"companyId":"vndb:p1866","sourceCompanyId":"vndb:p1866","canonicalEntityId":"vndb:p1866","name":"キャラメリアトルテ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:16255:v6256","source":"vndb"},{"companyId":"vndb:p1866","sourceCompanyId":"vndb:p1866","canonicalEntityId":"vndb:p1866","name":"キャラメリアトルテ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:28279:v6256","source":"vndb"},{"companyId":"vndb:p4702","sourceCompanyId":"vndb:p4702","canonicalEntityId":"vndb:p4702","name":"心游之域","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51115:v6256","source":"vndb"},{"companyId":"vndb:p1709","sourceCompanyId":"vndb:p1709","canonicalEntityId":"vndb:p1709","name":"Наша версия","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:69254:v6256","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
