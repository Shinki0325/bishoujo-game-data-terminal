cterName":"櫻井 空良","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"814"},"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I don't even know how many times it's been today, but I gotta say it anyway... What kind of cliché plot is this!?\""},{"spoiler":false,"text":"The protagonist of the story, possessing a constitution that passively attracts all manner of TMPL (Template) events."},{"spoiler":false,"text":"Thanks to his free-spirited father's remarriage, he gains a brand-new stepsister out of nowhere."},{"spoiler":false,"text":"His next-door neighbor is a childhood friend who's mastered the art of sneaking in through windows and smothering him with affection."},{"spoiler":false,"text":"At school, he's been targeted by a tsundere class rep."},{"spoiler":false,"text":"Day after day, he gets dragged into one textbook trope after another. As a result, he's honed his skills as the ultimate straight man and roast master."},{"spoiler":false,"text":"Class: Hinamori Academy, Class 2-1"},{"spoiler":false,"text":"Height: 176cm"},{"spoiler":false,"text":"Birthday: August 14th"},{"spoiler":false,"text":"Likes: Freedom, peace and quiet"},{"spoiler":false,"text":"Dislikes: Turbulent drama, monotonous repetition"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c66907"},{"segments":[{"spoiler":false,"text":"テンプレ巻き込まれ体質な主人公。"},{"spoiler":false,"text":"自由奔放な父親の再婚で義理の妹ができてしまったり、二階の窓を伝って入ってくる世話焼きの幼馴染がいたり、ツンデレ委員長に目を付けられて何かと絡まれたりとお約束な日々を過ごしている。"},{"spoiler":false,"text":"おかげでかなりの突っ込み体質に。"}],"source":"egs","sourceCharacterId":"19378","sourceWorkId":"26305","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"176 cm","valueContext":null,"source":"egs","sourceCharacterId":"19378","sourceWorkId":"26305","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c66908","characterName":"櫻井 詩央","sourceIds":{"bangumi":[{"characterId":"59906","match":"exact-normalized-name-in-linked-work","subjectId":"234352"}],"egsCharacterIds":["19374"],"vndbCharacterId":"c66908"},"originalCharacterName":"櫻井 詩央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"829"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Ugh, gross. Don't you dare pull the 'big brother' card on me... Nii-san\""},{"spoiler":false,"text":"A girl who becomes the protagonist's stepsister after her mother remarries."},{"spoiler":false,"text":"Her cooking skills are catastrophically bad, described as extinction-level disasters."},{"spoiler":false,"text":"Deep down, she still remembers the marriage promise she made with the protagonist when they were kids."},{"spoiler":false,"text":"Part of her regrets that they've become family, yet another part is happy just to live under the same roof."},{"spoiler":false,"text":"Unable to sort out these contradictory feelings, she can never quite be honest whenever she faces the boy who's now her big brother."},{"spoiler":false,"text":"Class: Hinamori Academy, Class 2-1"},{"spoiler":false,"text":"Height: 154cm"},{"spoiler":false,"text":"Birthday: August 29th"},{"spoiler":false,"text":"Likes: The 5-minute snooze after turning off the alarm, shooting stars"},{"spoiler":false,"text":"Dislikes: Cooking (hers is lethal-grade), pitch-black rooms"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c66908"},{"segments":[{"spoiler":false,"text":"母親の再婚で主人公の義理の妹になった少女。"},{"spoiler":false,"text":"料理は壊滅的に下手。"},{"spoiler":false,"text":"幼少期に主人公と結婚の約束をしたことを覚えており、家族になってしまったことを残念に思う自分と、一緒に居られて嬉しい自分とで心の整理ができずに、兄になった主人公に素直になれない。"}],"source":"egs","sourceCharacterId":"19374","sourceWorkId":"26305","spoiler":false},{"segments":[{"spoiler":false,"text":"母親の再婚で主人公の義理の妹になった少女。"},{"spoiler":false,"text":"料理は壊滅的に下手。"},{"spoiler":false,"text":"幼少期に主人公と結婚の約束をしたことを覚えており、"},{"spoiler":false,"text":"家族になってしまったことを残念に思う自分と、"},{"spoiler":false,"text":"一緒に居られて嬉しい自分とで心の整理ができずに、"},{"spoiler":false,"text":"兄になった主人公に素直になれない。"}],"source":"bangumi","sourceCharacterId":"59906"}],"profileFacts":[{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"19374","sourceWorkId":"26305","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/751f0f2efeb4f0ac58182ccb9de794bdde91cbe118e0142c0fc30282ae952f19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/644309dcb1ca8a4337b344e5ef7a62029a272bdb2169cb164f176f94ce1e5acd.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:234352:59906:11646:1","source":"bangumi"}]},{"characterId":"char_c66909","characterName":"恋祝 星七","sourceIds":{"bangumi":[{"characterId":"59907","match":"exact-normalized-name-in-linked-work","subjectId":"234352"}],"egsCharacterIds":["19375"],"vndbCharacterId":"c66909"},"originalCharacterName":"恋祝 星七","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"602"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Don’t worry. I’ll always be on your side, Sora-chan!\""},{"spoiler":false,"text":"The nurturing, doting, caretaker-type childhood friend and big-sister figure."},{"spoiler":false,"text":"In short, she absolutely adores the protagonist and can't help but spoil him rotten."},{"spoiler":false,"text":"Her housework is flawless, and at school she's adored as the ideal Onee-san."},{"spoiler":false,"text":"Unfortunately, she has a habit of getting way too touchy-feely and overprotective with the protagonist specifically, her one and only flaw."},{"spoiler":false,"text":"Class: Hinamori Academy, Class 3-2"},{"spoiler":false,"text":"Height: 161cm"},{"spoiler":false,"text":"Birthday: June 2nd"},{"spoiler":false,"text":"Likes: All housework (she's extremely skilled), unchanging daily routines"},{"spoiler":false,"text":"Dislikes: Black-and-white thinking, police sirens"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c66909"},{"segments":[{"spoiler":false,"text":"お母さん系だだ甘世話焼き幼馴染おねえちゃん。"},{"spoiler":false,"text":"とにかく主人公のことが大好きで甘やかしてしまう。"},{"spoiler":false,"text":"家事は完璧だし、学園でも理想のお姉さまとして人気だが、主人公にだけ接触過多で過保護なのが玉に瑕。"}],"source":"egs","sourceCharacterId":"19375","sourceWorkId":"26305","spoiler":false},{"segments":[{"spoiler":false,"text":"お母さん系だだ甘世話焼き幼馴染おねえちゃん。"},{"spoiler":false,"text":"とにかく主人公のことが大好きで甘やかしてしまう。"},{"spoiler":false,"text":"家事は完璧だし、学園でも理想のお姉さまとして人気だが、"},{"spoiler":false,"text":"主人公にだけ接触過多で過保護なのが玉に瑕。"}],"source":"bangumi","sourceCharacterId":"59907"}],"profileFacts":[{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"19375","sourceWorkId":"26305","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7432f8fb8a6a7915d03cab562f1134fa698790ecfd26f07980578abb5c497649.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9f4940667567698ec18d0d7ea3535e4aa2c4a3d659b8c787bd838652fb84dd0.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:234352:59907:17075:1","source":"bangumi"}]},{"characterId":"char_c66910","characterName":"古坂 未依","sourceIds":{"bangumi":[{"characterId":"59908","match":"exact-normalized-name-in-linked-work","subjectId":"234352"}],"egsCharacterIds":["19376"],"vndbCharacterId":"c66910"},"originalCharacterName":"古坂 未依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"909"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Do not misunderstand. I merely wish to prove you are unworthy of my Lady.\""},{"spoiler":false,"text":"An expressionless maid."},{"spoiler":false,"text":"She transfers to the school to investigate the target of her mistress Matsuri's affections."},{"spoiler":false,"text":"Unwilling to hand her over to anyone, she deliberately makes things difficult for the protagonist."},{"spoiler":false,"text":"However, driven by her devotion to do what’s best for her lady, she gradually warms up to him as she observes his behavior."},{"spoiler":false,"text":"She also appears to possess several secret tools known as the \"Seven Maid Treasures.\""},{"spoiler":false,"text":"Class: Hinamori Academy, Class 2-1"},{"spoiler":false,"text":"Height: 149cm"},{"spoiler":false,"text":"Birthday: September 9th"},{"spoiler":false,"text":"Likes: Her mistress, small animals (though she thinks she’s good at hiding this)"},{"spoiler":false,"text":"Dislikes: Anyone who dares approach her lady with ill intentions"},{"spoiler":false,"text":"From Steam"},{"spoiler":true,"text":"Although she did put a maid act, later revealed in her route that she was not really a maid. But actually the daughter of the wealthy family that she said she's working for."},{"spoiler":true,"text":"She is Matsuri 's Older sister."}],"source":"vndb","sourceCharacterId":"c66910"},{"segments":[{"spoiler":false,"text":"お嬢様が想いを寄せている主人公を調査するために転校してきた無表情系メイド。"},{"spoiler":false,"text":"お嬢様を渡したくないので主人公を敵視しているが、お嬢様の為と素行調査をしているうちに徐々に評価を改めていく。"},{"spoiler":false,"text":"メイド七つ道具なる秘密道具をいくつも隠し持っているらしい。"}],"source":"egs","sourceCharacterId":"19376","sourceWorkId":"26305","spoiler":false},{"segments":[{"spoiler":false,"text":"お嬢様が想いを寄せている主人公を調査するために"},{"spoiler":false,"text":"転校してきた無表情系メイド。"},{"spoiler":false,"text":"お嬢様を渡したくないので主人公を敵視しているが、"},{"spoiler":false,"text":"お嬢様の為と素行調査をしているうちに徐々に評価を改めていく。"},{"spoiler":false,"text":"メイド七つ道具なる秘密道具をいくつも隠し持っているらしい。"}],"source":"bangumi","sourceCharacterId":"59908"}],"profileFacts":[{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"19376","sourceWorkId":"26305","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffa9659bb4e661f5e52986e31e620bb4ed9460a47f1dfc63864369ee260b533f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2528549efb08be8767614a3fe21ce7be566e111bca20b6ff3b0b61c66857f4f.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:234352:59908:13368:1","source":"bangumi"}]},{"characterId":"char_c66911","characterName":"藤宮 凜音","sourceIds":{"bangumi":[{"characterId":"599