image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b35573c8bc934125c6f6617099e1fa86983368f6b76d44d6197fbf94d40a8ff6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/eca1cc25387af8435086efda399fbe4537a9198ff9d3d0a3108e097928386acc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真木碧","creatorId":"vndb:s2000","sourcePersonId":"vndb:s2000","canonicalEntityId":"vndb:s2000","name":"真木 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131028:46506:6130:1","source":"bangumi"}]},{"characterId":"char_c50594","characterName":"祖父江 めぐる","sourceIds":{"bangumi":[{"characterId":"46507","match":"exact-normalized-name-in-linked-work","subjectId":"131028"}],"egsCharacterIds":["18146"],"vndbCharacterId":"c50594"},"originalCharacterName":"祖父江 めぐる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"214"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"陽気で明るい、欧米からの帰国子女。"},{"spoiler":false,"text":"名門財閥“祖父江”家の伝統で、今まで同年代の男の子と接する機会がなく、ひょんなことから、主人公（男の子）に初めて声をかけられ、一目惚れ。"},{"spoiler":false,"text":"欧米仕込みの性知識で過激なアタックをするが、知識自体が間違っているようで……。"},{"spoiler":false,"text":"「はろ～ボク、めぐるだよ！　男の人って女王様が好きなんだって？」"}],"source":"egs","sourceCharacterId":"18146","sourceWorkId":"10867","spoiler":false},{"segments":[{"spoiler":false,"text":"世界各国を渡り歩く名門財閥・祖父江家の娘。"},{"spoiler":false,"text":"帰国子女のため欧米的なノリとスキンシップが過剰で、クラスでも浮いてるが、微笑ましく傍観されている。"},{"spoiler":false,"text":"大の甘党でお菓子が大好き。"},{"spoiler":false,"text":"たまたま声を掛けられた主人公にひと目惚れしてしまう。"},{"spoiler":false,"text":"アメリカ仕込みの間違ったな性的知識が豊富。"},{"spoiler":false,"text":"男性はコスプレ好きと思っていたり、SMグッズやコスプレの収集にも積極的……。"}],"source":"bangumi","sourceCharacterId":"46507"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"18146","sourceWorkId":"10867","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"18146","sourceWorkId":"10867","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"18146","sourceWorkId":"10867","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"18146","sourceWorkId":"10867","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"44 kg","valueContext":null,"source":"egs","sourceCharacterId":"18146","sourceWorkId":"10867","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a4431d1970c567ac042ec95b7a19e98dfef5897d6a1af4418a523b7c2a0bd64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/710df7c5aad50c6f819ee5ad09a3b956c944068f20abb2bf021bcf8ec4358895.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南川のりこ","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131028:46507:20327:1","source":"bangumi"}]},{"characterId":"char_c50595","characterName":"瀬名 陸","sourceIds":{"bangumi":[{"characterId":"46509","match":"exact-normalized-name-in-linked-work","subjectId":"131028"}],"egsCharacterIds":["18147"],"vndbCharacterId":"c50595"},"originalCharacterName":"瀬名 陸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"65"},"height":{"reviewState":"no-conflict","source":"vndb","value":"139"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"64"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"33"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冷静沈着で無口無表情、頭脳明晰な女の子。"},{"spoiler":false,"text":"今後、増えるであろう男子学生のサンプルとして、主人公のデータを収集している。"},{"spoiler":false,"text":"文字上の知識量は、性的なものも含めて豊富。"},{"spoiler":false,"text":"一見、ロボット染みた印象を受けるが、実は一途で情に厚かったりする。"},{"spoiler":false,"text":"「…………勃起するまでの時間を計測中。平均値」"}],"source":"egs","sourceCharacterId":"18147","sourceWorkId":"10867","spoiler":false},{"segments":[{"spoiler":false,"text":"基本的に無口・無表情で過ごす不思議な女の子。実は一途で情に厚い。"},{"spoiler":false,"text":"いつでもノートPCを持っており、それを使って会話を成立させることが多い。"},{"spoiler":false,"text":"沈着冷静で頭脳明晰、情報としての知識は豊富で、性的なものも例外ではない。"},{"spoiler":false,"text":"現在は主に、今後も増えるであろう男子学生のサンプルとして主人公のデータを収集している。"}],"source":"bangumi","sourceCharacterId":"46509"}],"profileFacts":[{"label":"胸围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"18147","sourceWorkId":"10867","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"139 cm","valueContext":null,"source":"egs","sourceCharacterId":"18147","sourceWorkId":"10867","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"18147","sourceWorkId":"10867","sourceField":null,"scoped":true},