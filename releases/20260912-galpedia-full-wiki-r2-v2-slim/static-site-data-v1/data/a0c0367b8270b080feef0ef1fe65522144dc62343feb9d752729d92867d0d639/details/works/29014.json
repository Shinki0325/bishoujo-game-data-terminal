031","source":"vndb"}]},{"characterId":"char_vndb_c39084","characterName":"星川 翡翠","sourceIds":{"vndbCharacterId":"c39084"},"originalCharacterName":"星川 翡翠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"919"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"166"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"‘There’s no need to worry."},{"spoiler":false,"text":"I’ll stay by your side until you’re used to this.’"},{"spoiler":false,"text":"Well-mannered and polite, he takes on the role of scolding the blunt Hayato."},{"spoiler":false,"text":"However, he also seems to dislike women. Because a special power awakened within him, he joined the Fukurou."},{"spoiler":false,"text":"From Rie's Otoge Blog"}],"source":"vndb","sourceCharacterId":"c39084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10db5251e6b156130860dcd4a648021e8e455de60a54a17ed6f293bae2cdb48a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8ddeaa9f027ac1dd7abc2f36e56f8fc38d33d6655eab7de63beaf65384b9113f.webp","width":187,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢坂 良太","creatorId":"vndb:s248","sourcePersonId":"vndb:s248","canonicalEntityId":"vndb:s248","name":"逢坂 良太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66028","source":"vndb"}]},{"characterId":"char_vndb_c39085","characterName":"鵜飼 昌吾","sourceIds":{"vndbCharacterId":"c39085"},"originalCharacterName":"鵜飼 昌吾","characterNameSource":null,"role":"primary","status":"source-