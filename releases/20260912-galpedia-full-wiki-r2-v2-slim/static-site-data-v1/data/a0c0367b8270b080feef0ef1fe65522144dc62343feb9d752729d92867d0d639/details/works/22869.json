":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126645","source":"vndb"},{"creditedName":"Lem","creatorId":"vndb:s5851","sourcePersonId":"vndb:s5851","canonicalEntityId":"vndb:s5851","name":"Lem(忌野Lem)","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:126649","source":"vndb"},{"creditedName":"Lem","creatorId":"vndb:s5851","sourcePersonId":"vndb:s5851","canonicalEntityId":"vndb:s5851","name":"Lem(忌野Lem)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126651","source":"vndb"},{"creditedName":"さがら 梨々","creatorId":"vndb:s7795","sourcePersonId":"vndb:s7795","canonicalEntityId":"vndb:s7795","name":"さがら 梨々","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:126652","source":"vndb"},{"creditedName":"禾 刀郷","creatorId":"vndb:s7796","sourcePersonId":"vndb:s7796","canonicalEntityId":"vndb:s7796","name":"禾 刀郷","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126655","source":"vndb"},{"creditedName":"しまさらゆめき","creatorId":"vndb:s9293","sourcePersonId":"vndb:s9293","canonicalEntityId":"vndb:s9293","name":"しまさらゆめき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126656","source":"vndb"},{"creditedName":"aina","creatorId":"vndb:s9294","sourcePersonId":"vndb:s9294","canonicalEntityId":"vndb:s9294","name":"aina","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126657","source":"vndb"},{"creditedName":"グランテール井上","creatorId":"vndb:s9295","sourcePersonId":"vndb:s9295","canonicalEntityId":"vndb:s9295","name":"グランテール井上","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126658","source":"vndb"},{"creditedName":"大木 犬太郎","creatorId":"vndb:s10273","sourcePersonId":"vndb:s10273","canonicalEntityId":"vndb:s10273","name":"大木 犬太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126659","source":"vndb"}]},"cast":[{"characterId":"char_c42899","characterName":"Le Soldat Jeune / The Young Soldier (青年兵士)","sourceIds":{"bangumi":[{"characterId":"159226","match":"exact-normalized-name-in-linked-work","subjectId":"155944"}],"egsCharacterIds":["7939"],"vndbCharacterId":"c42899"},"originalCharacterName":"Le Soldat Jeune / The Young Soldier (青年兵士)","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young soldier fighting to free his motherland from the grasp of its invading neighbor. Concluding his training in the Free French Forces, he enlisted into the newly-formed French Special Air Service. A fair young man, brimming with a sense of justice and bearing no falsehoods in his heart, he obstinately clings to what he thinks is right, but is also prone to self-righteousness. During the invasion of Normandy, unforeseen circumstances cause him to lose his way in the interstice between this world and another."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c42899"},{"segments":[{"spoiler":false,"text":"祖国を隣国の侵攻によって失い、祖国解放のために戦う青年兵士。"},{"spoiler":false,"text":"開戦前はパリ国立大学史学科を目指して学んでいたが、折り悪く第二次世界大戦が勃発。フランス降伏後、親友であるオリヴィエと共にパリでレジスタンス活動に参加するが、２人はすぐに占領軍当局にマークされ、パリから脱出。渡英して自由フランス軍に志願する。厳しい特殊部隊訓練をくぐり抜け、先頃フランスSASへと配属されたばかりであった。"},{"spoiler":false,"text":"ノルマンディー上陸作戦の行動中、不慮の事態から異界との狭間に迷い込み、黒公女エドワルダ率いるテルールの騎行に遭遇し、混乱の中、異形世界へと完全に迷い込んでしまう。"},{"spoiler":false,"text":"エドワルダの剣に斬り伏せられ倒れた彼は、しかし泉の畔に立つ時計台に住む少女、ジャンヌに救われる。行方不明となった親友オリヴィエの行方を探しつつ、また、元の世界へ戻る方法を探すために、ジャンヌと共に異形世界の各地を訪れる。"},{"spoiler":false,"text":"正義感が強く、裏表のない好青年だが、その若さと祖国占領以後の境遇から、一度正しいと思った事に対して頑なになる面もあり、ともすれば独善的な考えに陥りがちな欠点も持ち合わせている。"},{"spoiler":false,"text":"ジャンヌが泉より召喚した不壊の聖剣デュランダルを手に、数々の戦いをくぐり抜ける中、やがて彼女を守る聖騎士としての力と志に目覚めていく。"}],"source":"egs","sourceCharacterId":"7939","sourceWorkId":"22869","spoiler":false},{"segments":[{"spoiler":false,"text":"祖国を隣国の侵攻によって失い、祖国解放のために戦う青年兵士。"},{"spoiler":false,"text":"自由フランス軍での厳しい訓練を終え、フランスSASへ配属されたばかりだった。"},{"spoiler":false,"text":"正義感が○く裏表のない好青年だが、一度正しいと思ったことに対して頑な面があり、"},{"spoiler":false,"text":"独善的な考えに陥りがちな欠点も持ち併せている。"},{"spoiler":false,"text":"ノルマンディー上陸作戦の行動中、不慮の事態から異界との狭間に迷い込む。"},{"spoiler":false,"text":"そこで黒公女・エドワルダと遭遇し、完全に異形世界へと迷い込んでしまった。"},{"spoiler":false,"text":"エドワルダの剣に斬り伏せられた彼だったが、乙女ジャンヌに救われる。"},{"spoiler":false,"text":"そして作戦中に行方不明となった親友・オリヴィエを見つけて元の世界へ戻るため、"},{"spoiler":false,"text":"ジャンヌが召喚した不壊の聖剣・デュランダルを手に数々の戦いをくぐり抜けていく。"},{"spoiler":false,"text":"その中で、彼女を守る聖騎士としての力と志に目覚めていく。"}],"source":"bangumi","sourceCharacterId":"159226"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94e5cdd61682e3d25a61a770ac5b0f3cbe5cba000e116d0b27a5a194bc6e3737.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/846b4a81ccae1167d6c0aa9cea521255029435db9ca91fe7def9cf484f40a991.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深津智義","creatorId":"vndb:s2128","sourcePersonId":"vndb:s2128","canonicalEntityId":"vndb:s2128","name":"深津 智義","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155944:159226:19334:1","source":"bangumi"}]},{"characterId":"char_c42901","characterName":"The Black Princess (黒公女)","sourceIds":{"bangumi":[{"characterId":"159228","match":"exact-normalized-name-in-linked-work","subjectId":"155944"}],"egsCharacterIds":["7941"],"vndbCharacterId":"c42901"},"originalCharacterName":"The Black Princess (黒公女)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fearsome terror from a mysterious land from beyond the sea, and a fearsome female knight clad in black."},{"spoiler":false,"text":"Heir to the throne of her motherland, she is capable of summoning and wielding the Sword of Mercy, Curtana, as proof of her heritage. But her demeanor could not be further from her sword’s moniker. Night after night she sets out with her attendants, hunting down the Silhouettes for no reason but to satisfy her twisted delights."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c42901"},{"segments":[{"spoiler":false,"text":"海を隔てた異国よりこの地へと侵略してきた恐るべきテルールにして、美麗なる黒衣の女騎士。"},{"spoiler":false,"text":"母国では王位継承者であり、王位継承の証である慈悲の聖剣クルタナを自ら召還して揮うが、彼女の振る舞いは剣の二つ名とは真逆である。夜な夜な配下のテルールたちを従えて騎行し、自らの愉悦の為だけにシルエットたちを無慈悲に狩り立てるのである。"},{"spoiler":false,"text":"異界の狭間に迷い込んだロランとオリヴィエを襲撃したのも彼女であり、彼女の剣をその身に受けて生き延びたロランに強い関心を抱き、彼をどこまでもつけ狙う。"},{"spoiler":false,"text":"占領したリジョンに築いた居城、シャトー・ガイヤールを根城とする。"}],"source":"egs","sourceCharacterId":"7941","sourceWorkId":"22869","spoiler":false},{"segments":[{"spoiler":false,"text":"海を隔てた異国より侵略してきた恐るべきテルールにして、美麗なる黒衣の女騎士。"},{"spoiler":false,"text":"母国の王位継承者であり、その証である慈悲の聖剣・クルタナを召喚して揮う。"},{"spoiler":false,"text":"しかし彼女の振る舞いは、剣の二つ名とは真逆。"},{"spoiler":false,"text":"夜な夜な配下を従えて、自らの愉悦のためだけにシルエットを無慈悲に狩り立てる。"},{"spoiler":false,"text":"異界の狭間に迷い込んだロランとオリヴィエを襲撃したのも彼女であり、"},{"spoiler":false,"text":"彼女の剣を身に受けて生き延びたロランに○い関心を抱き、彼をどこまでもつけ狙う。"},{"spoiler":false,"text":"占領したリジョンに築いた居城 シャトー・ガイヤールを根城とする。"}],"source":"bangumi","sourceCharacterId":"159228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/010aedd5cd63c867858526785096d0649693c2844b688ca4ca2a8baeece4fa6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11e8952c9adb8764dd8dd83195cd9ab92e94f5412ce88607630e58e5ae032cb1.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155944:159228:6359:1","source":"bangumi"}]},{"characterId":"char_c42903","characterName":"Le Chevalier Ensanglantée / The Bloodstained Knight (血塗れの騎士)","sourceIds":{"bangumi":[{"characterId":"159230","match":"exact-normalized-name-in-linked-work","subjectId":"155944"}],"egsCharacterIds":["7943"],"vndbCharacterId":"c42903"},"originalCharacterName":"Le Chevalier Ensanglantée / The Bloodstained Knight (血塗れの騎士)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"敵の返り血に塗れた鎧を纏う騎士。端正で怜悧な顔をしているが、その肌は蝋の様に青ざめ、瞳は炯々とルビーの様に赤く輝き、吸血鬼的な雰囲気を醸している。"},{"spoiler":false,"text":"普段は物静かで、いかにも高位貴族然とした洗練された物腰だが、血を見ると狂気に染まる。"},{"spoiler":false,"text":"“魔女ジャンヌ”を神の如く崇拝してかしずき、彼女の果てなき闘争にどこまでも付き従う。"},{"spoiler":false,"text":"彼の振るう大剣フランベルジュは、戦に於いて実際に炎を纏い、敵をその魂までも焼き尽くす。"},{"spoiler":false,"text":"彼の名は、かつてジャンヌ・ダルクと馬首を並べて戦い、彼女の非業の刑死の後、自領に籠もり錬金術に耽って領民の殺戮に明け暮れた、狂気のフランス元帥のそれと同じであるが──"}],"source":"egs","sourceCharacterId":"7943","sourceWorkId":"22869","spoiler":false},{"segments":[{"spoiler":false,"text":"敵の返り血に塗れた鎧を纏う騎士。"},{"spoiler":false,"text":"端正で怜悧な顔をしているが、その肌は蝋のように青ざめ、"},{"spoiler":false,"text":"瞳は炯々とルビーのように赤く輝き、吸血鬼的な雰囲気を醸している。"},{"spoiler":false,"text":"普段は物静かで高位貴族然とした洗練された物腰だが、血を見ると狂気に染まる。"},{"spoiler":false,"text":"魔女ジャンヌを神の如く崇拝してかしずき、彼女の果てなき闘争に付き従う。"},{"spoiler":false,"text":"彼の揮う大剣・フランベルジュは実際に炎を纏い、敵をその魂までも焼き尽くす。"},{"spoiler":false,"text":"彼の名は、かつて ジャンヌ・ダルク と馬首を並べて戦い、"},{"spoiler":false,"text":"彼女の死後、領民の殺戮に明け暮れた狂気のフランス元帥のそれと同じであるが──"}],"source":"bangumi","sourceCharacterId":"159230"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e360bf4073d79806fa2526702f5e3256ec5497f76bc22dad73823953e760947c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b58cd92564cec5332c248dcaeeef864664eea80b825ae94457c81c159e6a51ed.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"景浦大輔","creatorId":"vndb:s837","sourcePersonId":"vndb:s837","canonicalEntityId":"vndb:s837","name":"景浦 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155944:159230:4936:1","source":"bangumi"}]},{"characterId":"char_c42904","characterName":"La Dame Mystère / The Mysterious Lady (謎の貴婦人)","sourceIds":{"bangumi":[{"characterId":"159231","match":"exact-normalized-name-in-linked-work","subjectId":"155944"}],"egsCharacterIds":["7944"],"vndbCharacterId":"c42904"},"originalCharacterName":"La Dame Mystère / The Mysterious Lady (謎の貴婦人)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ロランと“乙女”ジャンヌの前に現れた、謎の貴婦人。自らミレディを名乗ったが、それはデュマ・ペール作『三銃士』に登場する架空の人物の名であり、偽名であることは明白である。"},{"spoiler":false,"text":"異形世界の理に知悉しているとみられ、また、その口ぶりから、ロランが元いた世界の存在をも把握しているものと思われる。"},{"spoiler":false,"text":"時にロランと乙女ジャンヌに助言を与え、また時に不可思議な術を操る、神出鬼没かつ神秘的な人物。"},{"spoiler":false,"text":"普段は黒の尖塔オベリスクに住み、なにやら研究に明け暮れているようである。"}],"source":"egs","sourceCharacterId":"7944","sourceWorkId":"22869","spoiler":false},{"segments":[{"spoiler":false,"text":"ロランと乙女ジャンヌの前に現れた、神出鬼没かつ神秘的な女性。"},{"spoiler":false,"text":"時にロランと乙女ジャンヌに助言を与え、また時に不可思議な術を操る。"},{"spoiler":false,"text":"自らミレディと名乗ったが、それはデュマ・ペール作 『三銃士』 に登場する架空の人物の名であり、偽名であることは明白である。"},{"spoiler":false,"text":"普段は黒の尖塔・オベリスクに住み、なにやら研究に明け暮れている様子。"},{"spoiler":false,"text":"異形世界の理を知悉しており、ロランがいた世界の存在も把握していると思われる。"}],"source":"bangumi","sourceCharacterId":"159231"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a51d2a604e807a35eb7d7b2420194e4ddb65decb7929d0f8397c891573aca10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/824d52319c3f7b9c1315db98a20bd7af5d8df9371726009c14082c7854e0af70.webp","width":107,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155944:159231:22331:1","source":"bangumi"}]},{"characterId":"char_c42905","characterName":"Le Chevalier Blanc / The White Knight (白の騎士)","sourceIds":{"bangumi":[{"characterId":"159232","match":"exact-normalized-name-in-linked-work","subjectId":"155944"}],"egsCharacterIds":["7945"],"vndbCharacterId":"c42905"},"originalCharacterName":"Le Chevalier Blanc / The White Knight (白の騎士)","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異形世界の広い領域を支配、君臨するとされる大帝の使者としてロラン達の前に現れた騎士。"},{"spoiler":false,"text":"霧を飛び越え、リジョンの間を渡る事のできる飛龍を駆る、大帝の忠実なる近衛竜騎兵。"},{"spoiler":false,"text":"ロランをつけ狙う黒公女エドワルダとの戦いに介入し、彼とジャンヌを大帝の宮殿へと招く。"},{"spoiler":false,"text":"象牙色の鎧兜を常に身に纏い、顔全体を覆う兜の奥から、くぐもった声音で語りかけてくる。"},{"spoiler":false,"text":"重厚な刃を持つ宝剣ミュルグレスは、彼が敵と認めた存在の五体と魂を容赦なく打ち砕く。"},{"spoiler":false,"text":"対等と認めた相手に対しては騎士として丁重に振る舞うが、自らの従者であるオンディーヌや、大帝の被支配民であるシルエットたちに対しては極めて傲慢で、時に苛烈な仕打ちに及ぶことも辞さない。"}],"source":"egs","sourceCharacterId":"7945","sourceWorkId":"22869","spoiler":false},{"segments":[{"spoiler":false,"text":"霧を飛び越え、リジョンの間を渡ることのできる飛龍を駆る近衛竜騎兵。"},{"spoiler":false,"text":"異形世界の広い領域を支配し君臨する 大帝 の使者としてロランたちの前に現れた。"},{"spoiler":false,"text":"ロランをつけ狙うエドワルダとの戦いに介入し、彼とジャンヌを大帝の宮殿へと招く。"},{"spoiler":false,"text":"象牙色の鎧兜を常に身に纏い、その兜の奥からくぐもった声音で語り掛けてくる。"},{"spoiler":false,"text":"重厚な刃を持つ宝剣・ミュルグレスは、彼が敵と認めた存在の五体と魂を打ち砕く。"},{"spoiler":false,"text":"対等と認めた相手に対しては騎士として丁重に振る舞うが、"},{"spoiler":false,"text":"従者や大帝の被支配民に対しては極めて傲慢で、時に苛烈な仕打ちをも辞さない。"}],"source":"bangumi","sourceCharacterId":"159232"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0f11f327cce9a65cc2ef5f2f3c8d6f7e52c6ce93877ef2c78e707ea8609e34f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/998509e5582906a9bb2bb580686d9bb1cbd16576b1dd98c6a31be9b379b91c4f.webp","width":137,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c42908","characterName":"La Fée des Eaux / The Water Fairy (水妖)","sourceIds":{"bangumi":[{"characterId":"159233","match":"exact-normalized-name-in-linked-work","subjectId":"155944"}],"egsCharacterIds":["7946"],"vndbCharacterId":"c42908"},"originalCharacterName":"La Fée des Eaux / The Water Fairy (水妖)","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"白の騎士に仕える水妖にして“湖の乙女”。"},{"spoiler":false,"text":"宝剣ミュルグレスを召喚し、彼女の主である白の騎士に与え、その力の源泉となる。献身的に彼女の主に仕えるが、悲しきかな、主である白の騎士は彼女の事をただの道具としか捉えていない。"},{"spoiler":false,"text":"水妖は人間を愛し、愛されることで、人間に等しい魂を得るという、古くからの伝承があるが、彼女が主への愛によりそれを得ているとは、到底思われない。"}],"source":"egs","sourceCharacterId":"7946","sourceWorkId":"22869","spoiler":false},{"segments":[{"spoiler":false,"text":"白の騎士・ガヌロンに仕える水妖にして “湖の乙女” 。"},{"spoiler":false,"text":"宝剣・ミュルグレスを召喚し白の騎士に与え、その力の源泉となる。"},{"spoiler":false,"text":"献身的に主に仕えるが、悲しきかな、その主は彼女をただの道具としか捉えていない。"},{"spoiler":false,"text":"水妖は人間を愛し愛されることで、人間に等しい魂を得るという伝承がある。"},{"spoiler":false,"text":"しかし彼女が主への愛によりそれを得ているとは、到底思えない。"}],"source":"bangumi","sourceCharacterId":"159233"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52d53c702c838f4e602c6c8f7646307d9359a473ab13890a3c0810def1f03eb8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31cf06cc2ed6d81c37fc0dffa07d067390411dc1cb0578a513a1f608ff0f6eb1.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155944:159233:6379:1","source":"bangumi"}]},{"characterId":"char_c42910","characterName":"Le Camarade / The Comrade (戦友)","sourceIds":{"bangumi":[{"characterId":"159234","match":"exact-normalized-name-in-linked-work","subjectId":"155944"}],"egsCharacterIds":["7947"],"vndbCharacterId":"c42910"},"originalCharacterName":"Le Camarade / The Comrade (戦友)","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ロランと共に祖国フランスを脱出し、自由フランス軍に加わった青年で、ロランの良き親友である。"},{"spoiler":false,"text":"ロランと同い年だが、数ヶ月先に生まれていることもあり、何かと兄貴風をふかす。お調子者で、学校でも部隊でもムードメーカーである。女性に目がなく手が早いのが玉に瑕だが、悪びれる風はない。"},{"spoiler":false,"text":"ノルマンディー上陸作戦では、ロランと共にフェカン郊外の森へと降下。霧に包まれた森の中で黒公女エドワルダと遭遇。ロランが意識を失ってから後の、彼の行方は定かではない。"}],"source":"egs","sourceCharacterId":"7947","sourceWorkId":"22869","spoiler":false},{"segments":[{"spoiler":false,"text":"ロランの良き親友。 共に祖国フランスを脱出し、自由フランス軍に加わった。"},{"spoiler":false,"text":"同い年だが数ヵ月先に生まれていることもあり、何かと兄貴風をふかす。"},{"spoiler":false,"text":"お調子者で、学校でも部隊でもムードメーカーである。"},{"spoiler":false,"text":"女性に目がなく手が早いのが玉にキズだが、悪びれる風はない。"},{"spoiler":false,"text":"ノルマンディー上陸作戦では、ロランと共にフェカン郊外の森へと降下。"},{"spoiler":false,"text":"そして霧に包まれた森の中で黒公女・ドワルダと遭遇する。"},{"spoiler":false,"text":"ロランが意識を失った後、彼がどうなったのかは定かではない。"}],"source":"bangumi","sourceCharacterId":"159234"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29ebb5cacd78b2ff8839c46581eaf764bcc47cb21562e6707474efbab5855531.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b2d8820fd31a5ab6fd107c4c6d4da9567f7c139e748f8019deb2a7cdd2fd092.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中澤まさとも","creatorId":"vndb:s864","sourcePersonId":"vndb:s864","canonicalEntityId":"vndb:s864","name":"佐和真中","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155944:159234:7538:1","source":"bangumi"}]},{"characterId":"char_vndb_c42900","characterName":"ジャンヌ","sourceIds":{"vndbCharacterId":"c42900"},"originalCharacterName":"ジャンヌ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A kind girl who shuns conflict, the bearer of an endlessly unblemished heart. She nurses the gravely injured Roland back to health at a spring near the clock tower, the saving his life. She then begins to travel the countless Regions that dot the mysterious alternate world alongside Roland."},{"spoiler":false,"text":"The denizens of the mysterious world, the Silhouettes, worship her as a 'the Saint', much to her dismay."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c42900"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0dd2d0326fb9772e811dd3d75641447915c47d644f04d054ea03bdccb07abf0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/346d9e667474e07b854cd7f5b62e379fed1246a1daafaf30193684e07426a33f.webp","width":249,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あかし ゆき","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67558","source":"vndb"}]},{"characterId":"char_vndb_c42902","characterName":"ジャンヌ","sourceIds":{"vndbCharacterId":"c42902"},"originalCharacterName":"ジャンヌ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her mature demeanor gives the impression she may be an older sister or some other relative of hers. The image of her in battle invokes that of the tragic heroine Jeanne d'Arc, but her cold gaze is constantly thick with hatred, chillingly murderous intent seeping from her every gesture."},{"spoiler":false,"text":"Never lending an ear to the denizens of the distorted world's cries for salvation, she spends her every waking moment hunting down and fighting invading forces. Wielding the tainted demonic blade Joyeuse, she brings anyone who meets that blade to destruction, no matter who they may be."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c42902"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08f6d1375964b2a86439c3aa7f2467243f74d40841453d054dd831a9dd265065.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9e0572640927dfeb796c4de889d53db47df57cea07e13dcad48c845f0e12b7d.webp","width":213,"height":256,"