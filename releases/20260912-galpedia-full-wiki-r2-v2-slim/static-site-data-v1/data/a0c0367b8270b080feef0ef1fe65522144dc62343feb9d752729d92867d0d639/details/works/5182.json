value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義母。"},{"spoiler":false,"text":"彼女もバツイチで、前夫と死別してから主人公の父親と一緒になった。"},{"spoiler":false,"text":"真面目で健気な良妻賢母。"},{"spoiler":false,"text":"主人公を実の息子のように慈しみ、可愛がっている。そのため、主人公を子供としてしか見ておらず、家の中では無防備な格好でいることが多く、それが主人公を刺激することに……。"},{"spoiler":false,"text":"幸せな家庭のように見えるが、夫が冷たくなったことに心を痛めている。"}],"source":"egs","sourceCharacterId":"26553","sourceWorkId":"5182","spoiler":false},{"segments":[{"spoiler":false,"text":"前夫と死別してから主人公の父親と再婚する。"},{"spoiler":false,"text":"健気、真面目な性格。"},{"spoiler":false,"text":"現在の夫との間に子供が出来なかった為、主人公の事を慈しんでいる。"},{"spoiler":false,"text":"主人公の事は子供としてしか見ていない為、家の中では無防備な格好でいる事も多い。"},{"spoiler":false,"text":"周りからは良妻賢母と見られており、幸せな家庭を築いていると思われているが、"},{"spoiler":false,"text":"最近は夫が冷たくなった事に心を痛めている。"}],"source":"bangumi","sourceCharacterId":"94047"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"26553","sourceWorkId":"5182","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"26553","sourceWorkId":"5182","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"26553","sourceWorkId":"5182","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"26553","sourceWorkId":"5182","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc8bd43daccd437a22d9e9cc7a27a72490bf143d74a460d0ef63663a150a3fb1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1283152f661bcb5ce16b0b500c8a3bbb45881ad34f6097fa3b87b80d4fcba84.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"甲斐祐子","creatorId":"vndb:s26940","sourcePersonId":"vndb:s26940","canonicalEntityId":"vndb:s26940","name":"甲斐 祐子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:86851:94047:20969:1","source":"bangumi"},{"creditedName":"朝咲 そよ","creatorId":"vndb:s5181","sourcePersonId":"vndb:s5181","canonicalEntityId":"vndb:s5181","name":"朝咲 そよ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18894","source":"vndb"}]},{"characterId":"char_c33219","characterName":"工藤 玉江","sourceIds":{"bangumi":[{"characterId":"94048","match":"exact-normalized-name-in-linked-work","subjectId":"86851"}],"egsCharacterIds":["26554"],"vndbCharacterId":"c33219"},"originalCharacterName":"工藤 玉江","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"66"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の同級生であり友人の母親で、PTAの会長を務めている。"},{"spoiler":false,"text":"性格はキツく、高飛車で、他人を見下すような発言が多い。"},{"spoiler":false,"text":"ただし、溺愛する息子に対しては、まるで違った態度で、優しくかつ甘い。"},{"spoiler":false,"text":"主人公の義母・小夜に対して、PTA仕事を手伝わせては、何かと叱りつけており、それが主人公に反感を持たれるようになる。"}],"source":"egs","sourceCharacterId":"26554","sourceWorkId":"5182","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の友人の母親。主人公が通う学園のＰＴＡ会長。"},{"spoiler":false,"text":"性格はキツく他人を見下すような事を言う事も多い。"},{"spoiler":false,"text":"本人は当然の事を言っただけと思っている。"},{"spoiler":false,"text":"主人公に対して高飛車な態度を取る事もあるが、"},{"spoiler":false,"text":"これは主人公だからという訳ではなく、誰に対しても同じように高飛車な態度をとる。"},{"spoiler":false,"text":"ただ息子に対してだけは、非常に優しくかつ甘い仕草を見せる。"},{"spoiler":false,"text":"見た目にもはっきり分かるほど、息子を溺愛している。"},{"spoiler":false,"text":"息子は主人公の同級生であり友人。"}],"source":"bangumi","sourceCharacterId":"94048"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13bb0ba12f92311d3e070a477e31e3fcdfc6128571f6f6b1d8a60bd902a82c57.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12e35b2e4fddf5d274c0b63a7db6f4b962e2e95cee168de45486ce7929cf3cef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋夕稀","creatorId":"vndb:s2666","sourcePersonId":"vndb:s2666","canonicalEntityId":"vndb:s2666","name":"高橋 夕稀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:86851:94048:31746:1","source":"bangumi"}]},{"characterId":"char_c33220","characterName":"野口 奈緒","sourceIds":{"bangumi":[{"characterId":"94049","match":"exact-normalized-name-in-linked-work","subjectId":"86851"}],"egsCharacterIds":["26555"],"vndbCharacterId":"c33220"},"originalCharacterName":"野口 奈緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公行き付けの喫茶店「星の物語」のオーナー。"},{"spoiler":false,"text":"夫とは死別し、現在は独り身。"},{"spoiler":false,"text":"亡くなった夫の遺産が莫大であり、仕事をしなくとも暮らしていける。そのため、喫茶店の経営も真面目に取り組んでおらず、彼女の気分次第で店の開け閉めをしている。"},{"spoiler":false,"text":"明るく、姐御肌の性格のためか、慕ってくる人も多い。"}],"source":"egs","sourceCharacterId":"26555","sourceWorkId":"5182","spoiler":false},{"segments":[{"spoiler":false,"text":"近所に住む未亡人。明るい性格。喫茶店のオーナー。"},{"spoiler":false,"text":"明るく姉御肌の性格の為、慕ってくる人は多い。"},{"spoiler":false,"text":"夫の遺産が莫大にある為か、仕事に対してはあまり真面目ではない。"},{"spoiler":false,"text":"その日の気分で店を開けたり閉めたりしている。"},{"spoiler":false,"text":"それでも、奈緒と話をする為にいそいそと男性客が訪れる。"},{"spoiler":false,"text":"春休みの間、主人公は喫茶店でバイトしていた事もあり、"},{"spoiler":false,"text":"学校帰りの主人公に良く声をかけては、からかっている。"}],"source":"bangumi","sourceCharacterId":"94049"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59ddf1d927ae652c7ef1103b06d4678ac5bc76a2013329fed488d0b3782d2606.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1e6fb22dc02da28e62360f6d0235941563c2398e1c1da79877eed2069bce331.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:86851:94049:18086:1","source":"bangumi"}]},{"characterId":"char_vndb_c78134","characterName":"志賀 海人","sourceIds":{"vndbCharacterId":"c78134"},"originalCharacterName":"志賀 海人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ceea5af45abfec0d870efbd12eb51372266bb1a2d13ff7b7644f039272539926.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3dd37fe6f341e96ba409e4ae8634d0bde7beadb43915079cb904629ce81dc6ba.webp","width":256,"height":236,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78135","characterName":"工藤 匠","sourceIds":{"vndbCharacterId":"c78135"},"originalCharacterName":"工藤 匠","characterNameSource"