d":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:87558","source":"vndb"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"vndb:s720","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87560","source":"vndb"},{"creditedName":"六弦 アリス","creatorId":"vndb:s5347","sourcePersonId":"vndb:s5347","canonicalEntityId":"vndb:s5347","name":"六弦 アリス","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87563","source":"vndb"},{"creditedName":"舞子","creatorId":"vndb:s5406","sourcePersonId":"vndb:s5406","canonicalEntityId":"vndb:s5406","name":"舞子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:87564","source":"vndb"}]},"cast":[{"characterId":"char_c5681","characterName":"カーラ・クロムウェル","sourceIds":{"bangumi":[{"characterId":"68075","match":"exact-normalized-name-in-linked-work","subjectId":"229092"}],"egsCharacterIds":["8515"],"vndbCharacterId":"c5681"},"originalCharacterName":"カーラ・クロムウェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Main Heroine."},{"spoiler":false,"text":"A noble vampire queen who boast immense power and popularity among her people."},{"spoiler":false,"text":"Despite her noble exterior, she is easy to talk to regardless of status."},{"spoiler":false,"text":"She made a pact to reconcile vampire relations with human, sprouted by her father."},{"spoiler":false,"text":"She is on good term with the Uehara family, and in turn Kitae since the previous king's rule."},{"spoiler":false,"text":"Cara ordered Marika to destroy Gram's organization which has been dealing in trafficking human and vampire blood. She then decided to take care of her uncle Gram, the boss of the organization, by herself."},{"spoiler":false,"text":"The Master of Blood...The most powerful vampire known the Man, the Blood-Lord!"}],"source":"vndb","sourceCharacterId":"c5681"},{"segments":[{"spoiler":false,"text":"血を統べる者──ブラッド・ロードの異名を持つ最強の吸血鬼。"},{"spoiler":false,"text":"吸血鬼の中でも絶大な力と人気を誇る、気高き吸血鬼の女王。"},{"spoiler":false,"text":"代々吸血鬼の王国に君臨する王の家系で、雄ならば誰でも惹き付けられそうな美貌の持ち主。"},{"spoiler":false,"text":"高貴な雰囲気は漂わせているものの、身分など関係なく気さくに話しをする。"},{"spoiler":false,"text":"先王の代から続く人との協定で人間と交流があり、融和を望んでいる。"},{"spoiler":false,"text":"割りと奔放で退屈を嫌う性格。ただ女王としての身分はわきまえており、秩序を乱す者は身内であっても断固制裁する。"},{"spoiler":false,"text":"同胞の血を売り、人間を奴隷や家畜として買うのが我慢ならず、闇社会を根絶しようと人間と手を組むことを提唱した。"},{"spoiler":false,"text":"吸血鬼の血液と人間の人身売買を行っていたグラムの組織を、マリカに命じて壊滅させた張本人。"},{"spoiler":false,"text":"そのとき、組織のボスであった伯父であるグラムを自らの手にかけた。"},{"spoiler":false,"text":"上原家とは先王の頃より付き合いがあり、北絵とも仲がいい。"}],"source":"egs","sourceCharacterId":"8515","sourceWorkId":"17064","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"吸血鬼の中でも絶大な力と人気を誇る、気高き吸血鬼の女王。"},{"spoiler":false,"text":"高貴な雰囲気は漂わせているものの、身分など関係なく気さくに話しをする。"},{"spoiler":false,"text":"先王の代から続く人との協定で人間と交流があり、融和を望んでいる。"},{"spoiler":false,"text":"上原家とは先王の頃より付き合いがあり、北絵とも仲が良い。"},{"spoiler":false,"text":"吸血鬼の血液と人間の人身売買を行っていたグラムの組織を、マリカに命じて壊滅させた張本人。その時、組織のボスであった伯父であるグラムを自らの手にかけた。"},{"spoiler":false,"text":"血を統べる者── ブラッド・ロードの異名を持つ最強の吸血鬼。"},{"spoiler":false,"text":"「あら、あなた人間？」"}],"source":"bangumi","sourceCharacterId":"68075"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ac56f02af54fac59d217423b3e2de15a6d5898d7672798818879ca785792e9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78a17435abf07b66399c3b19b154fcafaf3fbfcc8274a22c95de92e3d239e76c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229092:68075:6131:1","source":"bangumi"}]},{"characterId":"char_c5849","characterName":"マリカ・クリシュナ","sourceIds":{"bangumi":[{"characterId":"68076","match":"exact-normalized-name-in-linked-work","subjectId":"229092"}],"egsCharacterIds":["8516"],"vndbCharacterId":"c5849"},"originalCharacterName":"マリカ・クリシュナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A purebred vampire, she is an exotic brown-skinned beauty. A confident the ruler, Cara, and comes from a family that has served the royal family for generations."},{"spoiler":false,"text":"As the Queen's bodyguard, she is always with her, but can come across as overprotective."},{"spoiler":false,"text":"She is armed with a chainsaw with a rune engraved on the blade."},{"spoiler":false,"text":"Marika also belongs to the Queen's Knights of Assassination and the powerful person in the world. She has the alias of the Grim Reaper."},{"spoiler":false,"text":"She almost single-handedly decimated Gram's organization and showed off her high combat prowess, but was then poisoned by Gram."}],"source":"vndb","sourceCharacterId":"c5849"},{"segments":[{"spoiler":false,"text":"純血種の吸血鬼で、褐色肌の美女。"},{"spoiler":false,"text":"王であるカーラの腹心であり、代々王家に仕える家系の生まれ。"},{"spoiler":false,"text":"女王の護衛として常に行動をともにする。"},{"spoiler":false,"text":"お目付役でもありかなり過保護な一面も。実直な性格で、女王のためなら己の身すらなげうつ。"},{"spoiler":false,"text":"また、王国内で特別に女王直属として組織されている暗殺騎士団にも属していて、随一の実力者。死神の異名を持つ。"},{"spoiler":false,"text":"王国に攻め入ろうとした国の当時の代表や司令官を一夜のうちに全員暗殺したり、グラムの組織をほぼ一人で壊滅させ、グラム自身にも圧倒的な戦闘力を見せつけた。"},{"spoiler":false,"text":"ただしそのとき、一度グラムに毒殺されている。"},{"spoiler":false,"text":"刃にルーンが刻まれたチェーンソーを武器としている。"}],"source":"egs","sourceCharacterId":"8516","sourceWorkId":"17064","spoiler":false},{"segments":[{"spoiler":false,"text":"純血種の吸血鬼で、褐色肌の美女。"},{"spoiler":false,"text":"王であるカーラの腹心であり、代々王家に仕える家系の生まれ。"},{"spoiler":false,"text":"女王の護衛として常に行動を共にするがお目付役でもあり、かなり過保護な一面も。"},{"spoiler":false,"text":"刃にルーンが刻まれたチェーンソーを武器としている。"},{"spoiler":false,"text":"女王直属の暗殺騎士団にも属していて、随一の実力者。死神の異名を持つ。"},{"spoiler":false,"text":"グラムの組織をほぼ一人で壊滅させ圧倒的な戦闘力を見せつけたが、その時に一度グラムに毒殺されている。"},{"spoiler":false,"text":"「イエス、カーラ様」"}],"source":"bangumi","sourceCharacterId":"68076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dba64df66befb2ab19fec915cb81c1cbb349662ac72febf67dbd55217296b2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9a53fb45b6a3a65417d384ba22ed3b5ecda6bb73ae8e999d43509a6125cf087.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229092:68076:6359:1","source":"bangumi"}]},{"characterId":"char_c5850","characterName":"神村 東","sourceIds":{"bangumi":[{"characterId":"68077","match":"exact-normalized-name-in-linked-work","subjectId":"229092"}],"egsCharacterIds":["8517"],"vndbCharacterId":"c5850"},"originalCharacterName":"神村 東","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Azuma was born into a clan of vampire hunters that have hunted evil vampires since ancient times."},{"spoiler":false,"text":"She is an excellent hunter and rumored to be the best in Japan, one of the leading country against the vampires."},{"spoiler":false,"text":"A keen six-sense and she is quick to detect any abnormalities."},{"spoiler":false,"text":"She is usually a teacher at Hayato Gakuen, which is run by Kitae and trains technician."},{"spoiler":false,"text":"Considered a delinquent teacher, but she loves her student and tend to sacrifice herself if they're in danger."},{"spoiler":false,"text":"Her weapon is metal bat which is said to have sucked the blood of a thousand vampires, passed down from generations to generations in her family."}],"source":"vndb","sourceCharacterId":"c5850"},{"segments":[{"spoiler":false,"text":"古くから、人に害を為す吸血鬼と闘ってきた吸血鬼を狩るハンターの一族の生まれ。"},{"spoiler":false,"text":"ハンターとしてかなり優秀で、対吸血鬼先進国である日本の中でも右に出る者はいないと噂されるほど。"},{"spoiler":false,"text":"超能力の域と言っていいくらい勘が鋭く、異常をいち早く察知したりする。"},{"spoiler":false,"text":"普段は北絵が経営している隼人学園で教師をしており、術者を鍛えている。"},{"spoiler":false,"text":"美女ではあるが、常に煙草をくわえていたり口汚いところがあるヤンキー先生。"},{"spoiler":false,"text":"ただ生徒思いで、生徒に危険が及ぶと身を投げ出して助けに入る。"},{"spoiler":false,"text":"神村家に代々伝わる対吸血鬼用の武器で、千の吸血鬼の血を吸ったと言われている「鬼切」という名前の梵字の刻まれた金属バットを使用する。"}],"source":"egs","sourceCharacterId":"8517","sourceWorkId":"17064","spoiler":false},{"segments":[{"spoiler":false,"text":"古くから、人に害を為す吸血鬼と闘ってきた吸血鬼ハンターの一族の生まれ。"},{"spoiler":false,"text":"ハンターとしてかなり優秀で、対吸血鬼先進国である日本の中でも右に出る者はいないと噂されるほど。"},{"spoiler":false,"text":"超能力の域と言っていいほど勘が鋭く、異常をいち早く察知したりする。"},{"spoiler":false,"text":"普段は北絵が経営している隼人学園で教師をしており、術者を鍛えている。"},{"spoiler":false,"text":"ヤンキー先生だが学生思いで、教え子に危険が及ぶと身を投げ出して助けに入る。"},{"spoiler":false,"text":"神村家に代々伝わる、千の吸血鬼の血を吸ったと言われている “鬼切” という名前の金属バットを使用する。"},{"spoiler":false,"text":"「来なよ！ この鬼切でぶっ殺されたきゃあな！」"}],"source":"bangumi","sourceCharacterId":"68077"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34172e9ed8261de8637a090e272ba3b3567d48c828a77ef856ccae3c60df753c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/759d5a4c19c1e8fce7196cc3bea5bb28240d38f279cbf321e25c4db70be58093.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229092:68077:13773:1","source":"bangumi"}]},{"characterId":"char_c5851","characterName":"上原 北絵","sourceIds":{"bangumi":[{"characterId":"68078","match":"exact-normalized-name-in-linked-work","subjectId":"229092"}],"egsCharacterIds":["8518"],"vndbCharacterId":"c5851"},"originalCharacterName":"上原 北絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kitae is the world's most foremost magician who helped creates the barriers against vampires."},{"spoiler":false,"text":"The barrier is so strong that it not only repels vampires, it destroys them if they try to force their way through."},{"spoiler":false,"text":"She established an academy where she fosters potential magicians, set up a barrier, and serves as a board member."},{"spoiler":false,"text":"Although she is growing older, her beauty and body have not deteriorated."},{"spoiler":false,"text":"Kitae's grandfather acted as the ambassador for the vampire's pact with the humans."},{"spoiler":false,"text":"Since childhood, she has been close friends with Cara."}],"source":"vndb","sourceCharacterId":"c5851"},{"segments":[{"spoiler":false,"text":"対吸血鬼用の結界を作り出す世界でも随一の術者。"},{"spoiler":false,"text":"その結界は吸血鬼をはね除けるばかりか、無理に通過しようとすると消滅させてしまうほど強力なもの。"},{"spoiler":false,"text":"隼人学園という術者を育てる学校を作り、そこに結界を張って、理事をしながら後任を育てている。"},{"spoiler":false,"text":"年は重ねているものの、美貌も肉体も衰えてはいない。"},{"spoiler":false,"text":"人と吸血鬼の協定を結ぶ際、北絵の祖父が仲介人を務めたこともあり、人間側の代表の一人で権力も持っている。"},{"spoiler":false,"text":"また、子供の頃からカーラとは友人関係。"},{"spoiler":false,"text":"自身よりも遥かに年上のカーラを捕まえて、働かざる者食うべからずと、学校の教師を押し付ける剛毅な性格。"}],"source":"egs","sourceCharacterId":"8518","sourceWorkId":"17064","spoiler":false},{"segments":[{"spoiler":false,"text":"対吸血鬼用の結界を作り出す世界でも随一の術者。"},{"spoiler":false,"text":"その結界は吸血鬼をはね除けるばかりか、無理に通過しようとすると消滅させてしまうほど強力なもの。"},{"spoiler":false,"text":"隼人学園という術者を育てる学校を作り、そこに結界を張って、理事をしながら後任を育てている。"},{"spoiler":false,"text":"年は重ねているものの、美貌も肉体も衰えてはいない。"},{"spoiler":false,"text":"人と吸血鬼の協定を結ぶ際、北絵の祖父が仲介人を務めたこともあり、人間側の代表の一人で権力も持っている。"},{"spoiler":false,"text":"また、子供の頃からカーラとは友人関係。 自身よりも遥かに年上のカーラを捕まえて、働かざる者食うべからずと、学園の教師を押し付ける剛毅な性格。"},{"spoiler":false,"text":"「女王でも、ここへ来たら働かざる者食うべからずよ カーラ」"}],"source":"bangumi","sourceCharacterId":"68078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c699e8b185d0a921d1974ad215482acb433177bfc56432e873642886782408a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e11189a32a00a2781f3a5e81504f42068fc078b4f74c40b304d82947cfe57914.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨津 さえ","creatorId":"vndb:s1653","sourcePersonId":"vndb:s1653","canonicalEntityId":"vndb:s1653","name":"雨津 さえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46455","source":"vndb"}]},{"characterId":"char_vndb_c89729","characterName":"グラム・デリック","sourceIds":{"vndbCharacterId":"c89729"},"originalCharacterName":"グラム・デリック","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character of the game, he is a vampire and a member of the royal family. He is also Cara's uncle. As a member of the royal family, he is a powerful being who abuses his abilities as a vampire."},{"spoiler":false,"text":"He is the boss of a underground organization that makes a living selling the blood of vampire and human trafficking. He has a brutal personality that uses special bugs to corrupt people's personality for his amusement."},{"spoiler":false,"text":"He is a vampire supremacist who believes in blood-sucking. He looks down on his fellow vampires who have abandoned hunting humans to suck their blood."},{"spoiler":false,"text":"Cara and Marika crushed his organization and killed him, but he is revived by his bugs as a precaution. He holds a strong grudge against Cara and the others who are ruining the underworld he controls."}],"source":"vndb","sourceCharacterId":"c89729"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e18acd3b8d1c91dab7e313b89946abc0b9beff6dcf89365808fe8b09d4a30d02.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea58d493daeed763f2420719cd681bab3f528cefc0d406e0ccbed171801be374.webp","width":255,"height":229,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1412","sourceCompanyId":"egs:brand:1586","canonicalEntityId":"vndb:p1412","name":"ANIME LiLiTH","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17064:1586","source":"egs"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131548:v10249","source":"vndb"},{"companyId":"vndb:p1412","sourceCompanyId":"vndb:p1412","canonicalEntityId":"vndb:p1412","name":"Anime Lilith","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:24414:v10249","source":"vndb"},{"companyId":"vndb:p1412","sourceCompanyId":"vndb:p1412","canonicalEntityId":"vndb:p1412","name":"Anime Lilith","roleCodes":["developer","p