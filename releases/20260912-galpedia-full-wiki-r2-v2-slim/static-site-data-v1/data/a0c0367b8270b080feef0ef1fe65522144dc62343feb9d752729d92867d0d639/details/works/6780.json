"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"優しく温厚ながら、冷静さも兼ね備えた性格。"},{"spoiler":false,"text":"生い立ちのせいか、やや人の顔色を伺う傾向があるものの、他人からはそれが気配りに思われているようだ。"},{"spoiler":false,"text":"剣聖と呼ばれるミュラー・セフィスが剣の師匠。"}],"source":"egs","sourceCharacterId":"14822","sourceWorkId":"6780","spoiler":false},{"segments":[{"spoiler":false,"text":"優しさとともに冷静さを持ち合わせた本作の主人公。"},{"spoiler":false,"text":"生い立ちのせいで、やや人の顔色を伺う傾向がある。"},{"spoiler":false,"text":"剣の師匠は、剣聖と呼ばれるミュラー・セフィス。"}],"source":"bangumi","sourceCharacterId":"217727"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/681c5d570c8bb6dd511d121e6f0fb0ee55a6c3c51d26a9c94dcf8429b91c3e4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f286fecacbcca303ee11db07c39d4a56fffde707a83a5690ecf91e7093d0ec7b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c2923","characterName":"碧 光陰","sourceIds":{"bangumi":[{"characterId":"188811","match":"exact-normalized-name-in-linked-work","subjectId":"23563"},{"characterId":"188811","match":"exact-normalized-name-in-linked-work","subjectId":"253906"}],"egsCharacterIds":["14834"],"vndbCharacterId":"c2923"},"originalCharacterName":"碧 光陰","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The son of a Buddhist priest, Kouin is a noble-hearted young man who cares deeply for his friend Yuuto and Yuuto's sister Kaori. Summoned to Phantasmagoria, he must face Yuuto in battle as an Etranger of the Malorigan Republic."},{"spoiler":false,"text":"From jastusa.com"}],"source":"vndb","sourceCharacterId":"c2923"},{"segments":[{"spoiler":false,"text":"武器：永遠神剣・第五位「因果」"},{"spoiler":false,"text":"主人公と今日子の親友。"},{"spoiler":false,"text":"碧遠寺（りょくおんじ）の住職の息子。"},{"spoiler":false,"text":"普段のナンパな振る舞いから、軽い性格と思われがちだが、非常に思慮深く、精神的にもしっかりしている。"},{"spoiler":false,"text":"今日子と付き合っているが、彼女の気持ちが本当は主人公に向いていることも知っている。それを知っていてもなお、彼女のへの気持ちを違えず、見守っている。"},{"spoiler":false,"text":"しかしながら、年下の女の子が好きという性癖はいただけない。"},{"spoiler":false,"text":"主人公らと共にファンタズマゴリアへと召喚された彼は、マロリガン共和国のエトランジェとして、愛ゆえに望まぬ戦いに身を投じる。"}],"source":"egs","sourceCharacterId":"14834","sourceWorkId":"3134","spoiler":false},{"segments":[{"spoiler":false,"text":"武器：永遠神剣・第五位「因果」"},{"spoiler":false,"text":"軽薄そうに見えるが、観察眼に優れ、思慮が深い。"},{"spoiler":false,"text":"そうした面を意識して表に出さないようにしているため、彼の本性を知る人はほとんどいない。"},{"spoiler":false,"text":"自分の力を使って全力でレスティーナを全力で補佐している。"}],"source":"egs","sourceCharacterId":"14834","sourceWorkId":"6780","spoiler":false},{"segments":[{"spoiler":false,"text":"武器：永遠神剣・第五位「因果」"},{"spoiler":false,"text":"主人公と今日子の親友。"},{"spoiler":false,"text":"碧遠寺（りょくおんじ）の住職の息子。"},{"spoiler":false,"text":"普段のナンパな振る舞いから、軽い性格と思われがちだが、非常に思慮深く、精神的にもしっかりしている。"},{"spoiler":false,"text":"今日子と付き合っているが、彼女の気持ちが本当は主人公に向いていることも知っている。それを知っていてもなお、彼女のへの気持ちを違えず、見守っている。"},{"spoiler":false,"text":"しかしながら、年下の女の子が好きという性癖はいただけない。"},{"spoiler":false,"text":"主人公らと共にファンタズマゴリアへと召喚された彼は、マロリガン共和国のエトランジェとして、愛ゆえに望まぬ戦いに身を投じる。"}],"source":"bangumi","sourceCharacterId":"188811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d19ac9f9e69b87da8c6fe7a010a40b56628dafa4f9175a48d8e3d63b202c2c2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa148e5b9ed89c2b5db0dd4dc341347f9b89b02e1a9cc7122a631e0bdeace8fb.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間寺 司","creatorId":"vndb:s123","sourcePersonId":"vndb:s123","canonicalEntityId":"vndb:s123","name":"堀川 りょう","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:851","source":"vndb"}]},{"characterId":"char_c59211"