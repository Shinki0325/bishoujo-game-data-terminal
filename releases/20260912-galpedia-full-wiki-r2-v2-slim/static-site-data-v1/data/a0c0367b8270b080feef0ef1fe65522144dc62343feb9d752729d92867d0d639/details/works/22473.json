i-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf4a40cce89d084800815f92c87fcffcfe4452657abca4f897907b49e7651b10.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150138:26601:5906:1","source":"bangumi"}]},{"characterId":"char_c22094","characterName":"芙蓉","sourceIds":{"bangumi":[{"characterId":"26602","match":"exact-normalized-name-in-linked-work","subjectId":"109758"},{"characterId":"26602","match":"exact-normalized-name-in-linked-work","subjectId":"150138"}],"egsCharacterIds":["4422"],"vndbCharacterId":"c22094"},"originalCharacterName":"芙蓉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second demon created by Makoto."},{"spoiler":false,"text":"Curiously, both her appearance and personality matches Kikyou's, perhaps due to how much she means to Makoto. She knows how to do any and all housework and is the only one of his demons who can be seen by an average person without a sixth sense, which makes chores like shopping a cinch. However, due to that, she has no special abilities whatsoever. Of course, because she looks like Kikyou, seeing her angry is... quite a sight."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c22094"},{"segments":[{"spoiler":false,"text":"真のためだけに生みだされた二番目の鬼。"},{"spoiler":false,"text":"桔梗に似た容姿をしており、性格もとてもよく似ている。"},{"spoiler":false,"text":"家事に長けた鬼であり、買い物などに不都合がないよう芙蓉は例外的に霊視の力を持たない者でも普通に視ることができる。"},{"spoiler":false,"text":"その影響で、葵のような特殊な力は持っていない。"},{"spoiler":false,"text":"容姿が似ていることもあり、やはり芙蓉も怒ると……？"}],"source":"egs","sourceCharacterId":"4422","sourceWorkId":"20717","spoiler":false},{"segments":[{"spoiler":false,"text":"真に仕える鬼の一人。"},{"spoiler":false,"text":"霊などの本来見えないモノを可視化する力を持つ。"},{"spoiler":false,"text":"加賀見家の家事を担い、彼女の作る料理は絶品。"},{"spoiler":false,"text":"葵の妹なのだが芙蓉の方がしっかりしており、マイペースすぎる姉の世話に手を焼いている。"}],"source":"egs","sourceCharacterId":"4422","sourceWorkId":"22473","spoiler":false},{"segments":[{"spoiler":false,"text":"真のためだけに生みだされた二番目の鬼。"},{"spoiler":false,"text":"桔梗に似た容姿をしており、性格もとてもよく似ている。"},{"spoiler":false,"text":"家事に長けた鬼であり、買い物などに不都合がないよう芙蓉は例外的に霊視の力を持たない者でも普通に視ることができる。"},{"spoiler":false,"text":"その影響で、葵のような特殊な力は持っていない。"},{"spoiler":false,"text":"容姿が似ていることもあり、やはり芙蓉も怒ると……？"}],"source":"bangumi","sourceCharacterId":"26602"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1baf34d37ff19ac8ec90bc3eb22e51b900c4755403b9afec81ba71e8474e49c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f50d74e88abf4bed83168c681774933c5335f16497a6de6b5e0530117f3bf72.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150138:26602:6359:1","source":"bangumi"}]},{"characterId":"char_c22095","characterName":"アイリス","sourceIds":{"bangumi":[{"characterId":"26603","match":"exact-normalized-name-in-linked-work","subjectId":"109758"},{"characterId":"26603","match":"exact-normalized-name-in-linked-work","subjectId":"150138"}],"egsCharacterIds":["4423"],"vndbCharacterId":"c22095"},"originalCharacterName":"アイリス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third demon created by Makoto."},{"spoiler":false,"text":"Unlike the other demons, she wears western clothing and always carries around a stuffed toy named Axy. Iris is a telepath, a fact that allows her to link the minds of Makoto and all of his demons in order for them to communicate more easily regardless of distance. However, precisely due to those powers, she has trouble speaking directly to people, so she stutters and stammers quite often in person."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c22095"},{"segments":[{"spoiler":false,"text":"真のためだけに生みだされた三番目の鬼。"},{"spoiler":false,"text":"他の二人と違い洋服を身に纏っており、いつもぬいぐるみの「ウーパくん」を抱いている。"},{"spoiler":false,"text":"テレパシー能力を持っており、複数の相手と言葉を声に出すことなく会話が可能。"},{"spoiler":false,"text":"あまり範囲は広くないが、遠くにいる人物にもテレパシーは届く。"},{"spoiler":false,"text":"その能力のためか本人は肉声で喋るのがとても苦手で、普通に話そうととすると激しくどもってしまう。"}],"source":"egs","sourceCharacterId":"4423","sourceWorkId":"20717","spoiler":false},{"segments":[{"spoiler":false,"text":"真に仕える鬼の一人。"},{"spoiler":false,"text":"テレパシー能力を持ち、肉声で話すのが苦手。"},{"spoiler":false,"text":"鬼三姉妹の末妹であり、やはり葵よりしっかりしている。"},{"spoiler":false,"text":"いつも抱いているぬいぐるみの名前は「ウーパくん」で、アイリスの奴隷らしい。"}],"source":"egs","sourceCharacterId":"4423","sourceWorkId":"22473","spoiler":false},{"segments":[{"spoiler":false,"text":"真のためだけに生みだされた三番目の鬼。"},{"spoiler":false,"text":"他の二人と違い洋服を身に纏っており、いつもぬいぐるみの “ウーパくん” を抱いている。"},{"spoiler":false,"text":"テレパシー能力を持っており、複数の相手と言葉を声に出すことなく会話が可能。"},{"spoiler":false,"text":"あまり範囲は広くないが、遠くにいる人物にもテレパシーは届く。"},{"spoiler":false,"text":"その能力のためか本人は肉声で喋るのがとても苦手で、普通に話そうととすると激しくどもってしまう。"}],"source":"bangumi","sourceCharacterId":"26603"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2766c3a5f5ffa4f31cc0d26b12683c00e37ca93d3dfe5c6a515eb5555565bf48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acdd0683fe20af10f9d97a7625a5a80acfd33bd388a23d487759820c6b176b1a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜咲千依","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"藤咲ウサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150138:26603:8990:1","source":"bangumi"}]},{"characterId":"char_c40538","characterName":"ベルベット","sourceIds":{"bangumi":[{"characterId":"40937","match":"exact-normalized-name-in-linked-work","subjectId":"150138"}],"egsCharacterIds":["7704"],"vndbCharacterId":"c40538"},"originalCharacterName":"ベルベット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A foreign girl who is always calm, cool, and collected. She is a staff member of the Ibaraki Prefectural Detectives Office, which is headed by Yoko Ibaragi. Her job is to investigate and resolve spiritual incidents."},{"spoiler":false,"text":"During the \"Old School Ghosts\" Investigations she meets Yashiro, and she gets a curse along with him. She can speak Japanese fluently but can't read it. Because of that, when she wants to order food from school, she's unable to to purchase a ticket until Yashiro reads the menu for her."}],"source":"vndb","sourceCharacterId":"c40538"},{"segments":[{"spoiler":false,"text":"常に冷静沈着な異国の少女。"},{"spoiler":false,"text":"葛城葉子を所長とする『葛城霊能探偵事務所』のスタッフであり、霊関係の事件の調査及び解決が彼女の仕事である。"},{"spoiler":false,"text":"『旧校舎の幽霊』の調査中に社と出会い、呪われてしまった彼と行動を共にするようになる。"},{"spoiler":false,"text":"日本語を流暢に話すことはできるが読むことはできず、学食で食事をとるときは社にメニューを読んでもらわないと食券が購入できない。"}],"source":"egs","sourceCharacterId":"7704","sourceWorkId":"22473","spoiler":false},{"segments":[{"spoiler":false,"text":"常に冷静沈着な異国の少女。"},{"spoiler":false,"text":"葛城葉子を所長とする 葛城霊能探偵事務所 のスタッフであり、霊関係の事件の調査 及び解決が彼女の仕事である。"},{"spoiler":false,"text":"“旧校舎の幽霊” の調査中に社と出会い、呪われてしまった彼と行動を共にす