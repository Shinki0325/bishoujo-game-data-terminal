orId":"vndb:s47264","sourcePersonId":"vndb:s47264","canonicalEntityId":"vndb:s47264","name":"Black mist iland","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125607","source":"vndb"},{"creditedName":"Chocolanty","creatorId":"vndb:s47265","sourcePersonId":"vndb:s47265","canonicalEntityId":"vndb:s47265","name":"Chocolanty","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125608","source":"vndb"}]},"cast":[{"characterId":"char_c22089","characterName":"伊予","sourceIds":{"bangumi":[{"characterId":"26599","match":"exact-normalized-name-in-linked-work","subjectId":"109758"},{"characterId":"26599","match":"exact-normalized-name-in-linked-work","subjectId":"150138"}],"egsCharacterIds":["4419"],"vndbCharacterId":"c22089"},"originalCharacterName":"伊予","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Though her outward appearance is that of an innocent young girl, she's actually an ancient zashiki-warashi. Iyo supports Makoto with her vast reserves of knowledge, a fact that is not lost upon the inexperienced young head of the Kagami family. As a zashiki-warashi, she supposedly brings fortune to everyone who resides in the same house as her, but her twisted personality and tendency to tease others makes that hard to believe."},{"spoiler":false,"text":"Iyo is a hardcore gamer and seems to stay in her room, on her computer, at all times unless there's food on the table. She mainly prefers online games too, where her dominant personality is fully unleashed."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c22089"},{"segments":[{"spoiler":false,"text":"見た目はあどけない少女だが、その正体は長い年月を生きる座敷わらし。"},{"spoiler":false,"text":"お役目に不慣れな真をその豊富な知識でサポートする。"},{"spoiler":false,"text":"座敷わらしの特性から加賀見家に福を呼ぶ存在ではあるが、性格はねじくれており他人（特に真）をおちょくる天才。"},{"spoiler":false,"text":"また重度のゲーマーで、食事時以外は自室に引きこもっている。"},{"spoiler":false,"text":"主にネトゲを好み、もちろんトップクラスの廃人である。"}],"source":"egs","sourceCharacterId":"4419","sourceWorkId":"20717","spoiler":false},{"segments":[{"spoiler":false,"text":"加賀見家に棲みつく座敷わらし。"},{"spoiler":false,"text":"見た目はあどけない少女だが、中身は下ネタ好きのおっさんである。"},{"spoiler":false,"text":"そして廃がつくほどのゲーマーで、一日中自室に引きこもっている。"},{"spoiler":false,"text":"加賀見家の相談役としてお役目の手助けをしていたが、真が経験を積み成長したことで、最近はあまり口を挟まなくなった。"}],"source":"egs","sourceCharacterId":"4419","sourceWorkId":"22473","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目はあどけない少女だが、その正体は長い年月を生きる座敷わらし。"},{"spoiler":false,"text":"お役目に不慣れな真をその豊富な知識でサポートする。"},{"spoiler":false,"text":"座敷わらしの特性から加賀見家に福を呼ぶ存在ではあるが、性格はねじくれており他人 （特に真） をおちょくる天才。"},{"spoiler":false,"text":"また重度のゲーマーで、食事時以外は自室に引きこもっている。"},{"spoiler":false,"text":"主にネトゲを好み、もちろんトップクラスの廃人である。"}],"source":"bangumi","sourceCharacterId":"26599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd13e2ae3ae9ed339e9c31d9a8450f6a08c0fd845cc8cf07297a5d4f2ab93205.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8e9ca35ec0f9bd6f7e47c20ec53e0deb707f1314b1dc0516bf32cd037a30518.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柏木美優","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150138:26599:6540:1","source":"bangumi"}]},{"characterId":"char_c22093","characterName":"葵","sourceIds":{"bangumi":[{"characterId":"26601","match":"exact-normalized-name-in-linked-work","subjectId":"109758"},{"characterId":"26601","match":"exact-normalized-name-in-linked-work","subjectId":"150138"}],"egsCharacterIds":["4421"],"vndbCharacterId":"c22093"},"originalC