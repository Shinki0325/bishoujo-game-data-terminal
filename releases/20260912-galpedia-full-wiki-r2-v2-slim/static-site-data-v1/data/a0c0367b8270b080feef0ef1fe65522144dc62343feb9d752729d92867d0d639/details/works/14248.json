{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"14248","model":{"presentationWorkId":"egs:14248","staff":{"artwork":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:88626","source":"egs"}],"scenario":[],"music":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"music","roleLabel":"作品音乐","identityStatus":"alias-only-review","relationId":"egs:work-creator:88627","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_10461","characterName":"ほうじゅう ぬえ","sourceIds":{"bangumi":[{"characterId":"10461","match":"source-roster","subjectId":"1395"},{"characterId":"10461","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"ほうじゅう ぬえ","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"未确认幻想飞行少女。"}],"source":"bangumi","sourceCharacterId":"10461"}],"profileFacts":[{"label":"能力","source":"bangumi","sourceCharacterId":"10461","value":"无法判断正体程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/131f22bf0634b84fa6ea5e00dd557b1962012e81de6ebb74f940fb24046a0a4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e6c4ab5584237308d7be58fff5c844d93d00f82f0cc1e1f3bfd285d65d31a6d.webp","width":210,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_10802","characterName":"虎丸星","sourceIds":{"bangumi":[{"characterId":"10802","match":"source-roster","subjectId":"1395"},{"characterId":"10802","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"虎丸星","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"BGM：虎柄の毘沙門天。"}],"source":"bangumi","sourceCharacterId":"10802"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"10802","value":"妖怪"},{"label":"能力","source":"bangumi","sourceCharacterId":"10802","value":"收集财宝程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76245386bf7722300b81e21072d68da2872804f6a6887aa3653dc41e78250973.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46e42eebd647e60bff5c1e711a24807714cb0daf6dd5f60eecc611afe4777c0e.webp","width":153,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_10805","characterName":"被封印的大魔法使","sourceIds":{"bangumi":[{"characterId":"10805","match":"source-roster","subjectId":"1395"},{"characterId":"10805","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"被封印的大魔法使","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大人气同人系列游戏《东方project》的主要角色。首次出现在《东方星莲船》。 白莲在命莲死后，对人生苦短感到恐惧，想要求得永生长存。可惜通过佛力无法达成，白莲转而学习魔法与妖术保持青春。在与妖怪的接触中，她意识到妖力不强大是无法生存的，并且视为至理，逐渐在这条道上越走越深。一方面，她接受退治妖怪，另一方面又帮助妖怪，这就是她所认为的平衡。最终她的作为无法被人类接受，被封印到了魔界——与星莲船同音的圣辇船航向的目的地。"}],"source":"bangumi","sourceCharacterId":"10805"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"10805","value":"魔法师"},{"label":"能力","source":"bangumi","sourceCharacterId":"10805","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b01c998a106aaa224f7364e915e7fd3e812db9fe477fb868e482f3d4adaa8762.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/737defe3a5c9809789d6f0246c5f898ad1bc13a6a51f49e2e8b4cf6e891ba628.webp","width":179,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_11375","characterName":"比那名居地子","sourceIds":{"bangumi":[{"characterId":"11375","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"比那名居地子","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"比那名居天子(Hinanai Tenshi)，《东方绯想天》的最终BOSS。居住在有顶天的天人，因为过于无聊而引发地震等待一些有趣的事情，似乎不想住在天上，最终在博丽神社放下要石以镇压地震，试图住在博丽神社结果被紫赶了出来。"}],"source":"bangumi","sourceCharacterId":"11375"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"11375","value":"天人"},{"label":"能力","source":"bangumi","sourceCharacterId":"11375","value":"操纵大地的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15b017b7c01894d07fd060b73195c5ffd9014f1d2f8b7de168408599fbd6c8b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d52a670ffb68a61ca3564f8e089558bbd8a3ecc49161de138b831689207c3e6b.webp","width":256,"height":220,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_16659","characterName":"本怖！貴方の後ろにいるよ \\ 本怖！就在你的身后","sourceIds":{"bangumi":[{"characterId":"16659","match":"source-roster","subjectId":"1155"},{"characterId":"16659","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"本怖！貴方の後ろにいるよ \\ 本怖！就在你的身后","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"东方地灵殿，古明地姉妹之妹。"},{"spoiler":false,"text":"她与觉一样拥有读心术，但她知道人们讨厌这种能力，因此将能读心的第三只眼紧闭。不过却获得了操控无意识程度的能力。"},{"spoiler":false,"text":"其实自身的读心能力并没有消失，但是读取的内容会被写入潜意识而隐没。而本人也是在潜意识下行动，无法让人察觉到她的存在。"},{"spoiler":false,"text":"平时在地上与地灵殿间漫无目的地游荡。偶尔会出现在地面，但因为本身的能力，即使看到她只要注意力分散很快就会忘掉她。其实也有很多地底的妖怪对于恋的现状感到很自责。"}],"source":"bangumi","sourceCharacterId":"16659"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"16659","value":"觉"},{"label":"能力","source":"bangumi","sourceCharacterId":"16659","value":"操控无意识程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47bd4d07632a3ef03c8dcf6036d0f48d2a761853b0e4058f2a71d07239a5d3d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0be5c300dd2605d866daeb801b41f0102be0ebf4f7a06e7a548b84aa714034ec.webp","width":149,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_17683","characterName":"語られる怪力乱神 / 人所谈论的怪力乱神","sourceIds":{"bangumi":[{"characterId":"17683","match":"source-roster","subjectId":"1155"},{"characterId":"17683","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"語られる怪力乱神 / 人所谈论的怪力乱神","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人之所谓怪力乱神"},{"spoiler":false,"text":"《东方地灵殿》 三面BOSS"},{"spoiler":false,"text":"和萃香一起曾经被称为山中四天王的鬼族一员。现居住于旧都中。"},{"spoiler":false,"text":"旧都过去虽然曾经是地狱的一部分，是伴随着地狱小型化计划而被废弃的土地。"},{"spoiler":false,"text":"这里虽然有居住着各种各样的妖怪，但其中具有代表性的妖怪便是鬼族。鬼族对于人类的欺骗行为感到厌恶决定主动离开，利用地狱多余的土地构建了新的社会。"},{"spoiler":false,"text":"同时鬼族也积极的率先接收那些在地上同样遭到欺骗耍弄的妖怪。对此事产生危机感的地上妖怪们，作为承认新的地底都市的条件提出了一个要求。"},{"spoiler":false,"text":"那便是由他们来封印地底的怨灵。相对的定下了任何妖怪都不得进入地下都市的约定。"},{"spoiler":false,"text":"鬼们完全断绝了与地上的交流，不为人知的开始了全新的社会生活。"},{"spoiler":false,"text":"勇仪和其他鬼一样，每天一边嬉闹一边喝酒，快乐的享受着生活。突然听说有强大的人类来此，虽然酒才喝到一半但还是慌忙前去想一探究竟……"},{"spoiler":false,"text":"--------------------------------------------------------"},{"spoiler":false,"text":"有着刚毅且乾脆利落的性格。喜欢力气大、有勇气以及正直的人们，相反饶不过那些懦弱的、胆小的、狡猾的人们。"}],"source":"bangumi","sourceCharacterId":"17683"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"17683","value":"鬼"},{"label":"能力","source":"bangumi","sourceCharacterId":"17683","value":"拥有怪力乱神程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c037b247a573fa74ba8a4bcbbc76983fdfd56958f891fcd5ce039ea3fd250be3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c89edd6a8bd2a847ee3e1aeeb494425c8ef5d605152cdb8f833d2e6ecf1287c7.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20129","characterName":"超妖怪弹头","sourceIds":{"bangumi":[{"characterId":"20129","match":"source-roster","subjectId":"104009"},{"characterId":"20129","match":"source-roster","subjectId":"1155"},{"characterId":"20129","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"超妖怪弹头","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人气弹幕系列游戏《东方project》的主要角色。妖怪山的全能水利工程师，外貌为穿戴“太阳帽、探险制服、登山套鞋”的双马尾少女，左手拿着狗尾草，总是背着一个大包包。初次登场是在《东方风神录》。"}],"source":"bangumi","sourceCharacterId":"20129"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20129","value":"河童"},{"label":"能力","source":"bangumi","sourceCharacterId":"20129","value":"操纵水程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/984ff1f6d554bb899d5e0bba41a209f8b0631802b21aa7b20f2abf9cb04ed3c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb6582adcbc425f59b1e15618739a986f9e7dd4ccbcf366fda037222ed8788cf.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20130","characterName":"やさか かなこ","sourceIds":{"bangumi":[{"characterId":"20130","match":"source-roster","subjectId":"1155"},{"characterId":"20130","match":"source-roster","subjectId":"2134"},{"characterId":"20130","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"やさか かなこ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"守矢神社所供奉的神明"},{"spoiler":false,"text":"因为在外界得不到信仰的关系，所以和早苗一起决定将守矢神社迁进幻想乡，希望能在幻想乡内收集到信仰"},{"spoiler":false,"text":"刚进入幻想乡时一直被天狗们警戒着，后来经过交涉之后和解"},{"spoiler":false,"text":"性格豪爽，大方，不拘小节。非常开朗，头脑也很明晰"},{"spoiler":false,"text":"因为从外界来的关系，似乎对外界的技术和科学知识有着高度的了解"},{"spoiler":false,"text":"爱好技术革命，不过似乎是因为为了获得信仰？"},{"spoiler":false,"text":"喜欢宴会，和人类与妖怪游玩是她希望的信仰方式"},{"spoiler":false,"text":"主导著守矢神社的信仰心"},{"spoiler":false,"text":"原本是风神，不过在经过许多波折之后变成了山神"},{"spoiler":false,"text":"符卡名均来源于诹访神社的传说与惯例"}],"source":"bangumi","sourceCharacterId":"20130"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20130","value":"神灵"},{"label":"能力","source":"bangumi","sourceCharacterId":"20130","value":"创造乾程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a44ce4116037db504edf0f96e12a72ee75eb8179940c6c406ab2be957783b72d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f7b49b41c9035985fdc531476abd6b33b0ef40d62813c31bb73069f8a1e03cb.webp","width":182,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20131","characterName":"土著神的顶点","sourceIds":{"bangumi":[{"characterId":"20131","match":"source-roster","subjectId":"1155"},{"characterId":"20131","match":"source-roster","subjectId":"2134"},{"characterId":"20131","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"土著神的顶点","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"守矢神社真正供奉的神明"},{"spoiler":false,"text":"在远古时候拥有非常恐怖的信仰心，作为神的同时甚至作为王建立了一个王国"},{"spoiler":false,"text":"因为在和神奈子的战斗中败北而投降，将王国交出"},{"spoiler":false,"text":"不过因为神奈子无法得到王国人们的信仰，而变成了在神奈子背后一起治理着王国的情况"},{"spoiler":false,"text":"随着时间的流逝，诹访子渐渐的被人们所遗忘，记得诹访子真名的人，也几乎没有了"},{"spoiler":false,"text":"此时神奈子决定将守矢神社迁到幻想乡内，从此诹访子在幻想乡内开始了新的生活"},{"spoiler":false,"text":"诹访子是早苗遥远的祖先，不过早苗对此却完全不知情"}],"source":"bangumi","sourceCharacterId":"20131"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20131","value":"神明（土著神）"},{"label":"能力","source":"bangumi","sourceCharacterId":"20131","value":"创造坤（地）程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a5241709cc4571e16292d3daf08de9ffd9fb5f6db2b70ca6b885ec975bde2bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1c313ab7a2dae13aac5be7b8ebef0080b78598e66c51adc21543ad533c2e46b.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20132","characterName":"怨灵也为之恐惧的少女","sourceIds":{"bangumi":[{"characterId":"20132","match":"source-roster","subjectId":"1155"},{"characterId":"20132","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"怨灵也为之恐惧的少女","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"古明地觉是地底都市遗迹里残留着的怨灵的管理者，在灼热地狱遗址上建立起了地灵殿，她就在那里居住了下来。"},{"spoiler":false,"text":"因为她能够读取他人心中的想法，不管是任何妖怪，连怨灵都为之感到恐惧，不知从何时起几乎没有人再来地灵殿造访了。但是，相反因为能读心而受到那些不会说话的动物们的喜爱。"},{"spoiler":false,"text":"因为宠物的增多，导致灼热地狱遗迹无法完美的管理，最后只得把很多管理事项交由宠物们去做。"},{"spoiler":false,"text":"当她听说间歇泉的异变时，她也稍微的吃了一惊。"}],"source":"bangumi","sourceCharacterId":"20132"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20132","value":"妖怪"},{"label":"能力","source":"bangumi","sourceCharacterId":"20132","value":"可以读心程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/658acbb6b479fc0e665ff64772860298e68fa5c997636c103ac9b366c2486bc3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60d7e893599652164586f7afb5c698d18a439847dbb0fc6742c25a74053973f1.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21128","characterName":"愉快的遗忘之伞","sourceIds":{"bangumi":[{"characterId":"21128","match":"source-roster","subjectId":"12696"},{"characterId":"21128","match":"source-roster","subjectId":"1395"},{"characterId":"21128","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"愉快的遗忘之伞","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二面中头目及头目，由长年不被使用的伞化成的妖怪，对于经常吓不了人类而感到自卑。"},{"spoiler":false,"text":"虽然在关卡的名字是代表着独眼妖怪，不过主要也是指她手上的伞罢了，但本体不是那把伞。瞳孔的颜色一边为蓝，一边为红。"},{"spoiler":false,"text":"神灵庙又再次出现，与火焰猫磷并列为出现次数最多的头目（四次）。"},{"spoiler":false,"text":"吓到人会摆出一副很满足的表情，无视她的话会变得很郁卒。不会害人的妖怪，所以不需要担心。"},{"spoiler":false,"text":"如果可怜可怜她，还是装一下吓到的表情哄她开心吧。"},{"spoiler":false,"text":"人之里中很受小孩子欢迎。"}],"source":"bangumi","sourceCharacterId":"21128"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21128","value":"附丧神（唐伞妖怪）"},{"label":"能力","source":"bangumi","sourceCharacterId":"21128","value":"惊吓人类程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e346d665b3915d9a2fe30f61eadb4e647e0a7b81d0171adb8761c208310fa165.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b85e398e9e9a77bb2864b0c02aa82222489679dd5526a0303a01681c48b5b46.webp","width":207,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21130","characterName":"守护与被守护的大轮","sourceIds":{"bangumi":[{"characterId":"21130","match":"source-roster","subjectId":"1395"},{"characterId":"21130","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"守护与被守护的大轮","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三面中头目及头目，外表是一个拿着圆环的少女，和入道为同伴关系，这对组合就是云居。"},{"spoiler":false,"text":"表面上只是单纯地守卫著宝船。实际上，这对组合是为了诱使得到飞船的碎片的灵梦等人进入宝船，从而令宝船能够前往魔界。"},{"spoiler":false,"text":"本来与村纱等人被封印在地底，因为温泉异变又回到地面，并帮助白莲解除魔界封印。"},{"spoiler":false,"text":"原本是人类，因为和云山待久了而成为妖怪，因此有一说她是魔法使（但却没听过“入道使”）。"},{"spoiler":false,"text":"会趁白莲不注意时偷喝酒。（佛教徒称酒作“般若汤”）"}],"source":"bangumi","sourceCharacterId":"21130"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21130","value":"妖怪"},{"label":"能力","source":"bangumi","sourceCharacterId":"21130","value":"使用入道的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3ee92a056f0c054ad6cebdd0d57d56784a7acf4964160885ac105161de7105f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d243c11a1207aa45807cd7c836f9c4e0b686fead0af1447a80560dc669826ff5.webp","width":161,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21144","characterName":"水难事故的念缚灵","sourceIds":{"bangumi":[{"characterId":"21144","match":"source-roster","subjectId":"1395"},{"characterId":"21144","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"水难事故的念缚灵","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"四面头目，圣辇船船长。手上的勺子是自备的，用来灌水和攻击。"},{"spoiler":false,"text":"她原是很久以前在海难事故中死了的人的灵魂化成的念缚灵。"},{"spoiler":false,"text":"水蜜是原名，而村纱是代表该海域引发水难事故的妖怪，在水蜜遭遇水难成为念缚灵后，因其怨念过深，所以水蜜取代了其地位，成为现今的村纱水蜜。"},{"spoiler":false,"text":"过去的她常常引发许多水难事故，愈来愈多人死于他所引她的水难，她的力量便随之增长。"},{"spoiler":false,"text":"最后当地人委托白莲来治退这麻烦的妖怪。但身为妖怪的白莲当然不可能消灭掉她。"},{"spoiler":false,"text":"要致退妖怪最佳的方法就是精神攻击，白莲对村沙下了“令”，这个令就是圣辇船，村沙最后被白莲感化，而使她能够离开该海域。"},{"spoiler":false,"text":"因为地底温泉异变而使圣辇船和飞仓解除封印。村沙因此回到地面。"},{"spoiler":false,"text":"听到寅丸说白莲解封有望，为了报恩而引导灵梦等人解开白莲的封印。"},{"spoiler":false,"text":"现在虽然是命莲寺的僧侣，但她还是会杀人（在幻想乡引发水难），和以前的差别是现在还会挑选对象。"},{"spoiler":false,"text":"据说还会趁死神不注意（就是偷懒），在三途川的船上灌水。"}],"source":"bangumi","sourceCharacterId":"21144"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21144","value":"舟幽霊"},{"label":"能力","source":"bangumi","sourceCharacterId":"21144","value":"引起水难事故的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e7427c10a93e44d26274fba7e6fca3bc73b4b1061409fc678b533915e5d9568.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8504165d50808b807ed1a70234076d65cdd0949766e34f5ff5446cb1d3d25e41.webp","width":119,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29659","characterName":"Kisume","sourceIds":{"bangumi":[{"characterId":"29659","match":"source-roster","subjectId":"1155"},{"characterId":"29659","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"Kisume","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"走在夜路上的时候突然从正上方掉落，撞在头顶上的恐怖妖怪。"},{"spoiler":false,"text":"平常都呆在洞窟或者水井里。非常喜欢狭窄的地方所以一直都在桶里，是个内向的妖怪。"}],"source":"bangumi","sourceCharacterId":"29659"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"29659","value":"吊瓶妖"},{"label":"能力","source":"bangumi","sourceCharacterId":"29659","value":"降下鬼火程度的能力（地灵殿）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f23dcab0f04210660748468db1f5e039b2aa446c8cc94dcf6fc34a0f75fa24b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf89775ab77a40ebb39f85dd979d9fa4baf0f28cb758fa61e1f31ce029a0b329.webp","width":127,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29663","characterName":"熱かい悩む神の火 \\ 难以驾驭的神之火","sourceIds":{"bangumi":[{"characterId":"29663","match":"source-roster","subjectId":"1155"},{"characterId":"29663","match":"source-roster","subjectId":"2134"},{"characterId":"29663","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"熱かい悩む神の火 \\ 难以驾驭的神之火","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"有着特别姿态的鸦。"},{"spoiler":false,"text":"左足是\"分解之足\"、右足是\"融合之足\"、还有制御两者的右手\"第三足\"，她以这三足操控着究极的能源。"},{"spoiler":false,"text":"空的任务是看守灼热地狱遗迹让它不至失控。"},{"spoiler":false,"text":"身体内拥有称为八咫乌的神明。八咫乌拥有的究极之力量，就是创造原子的力量－核融合。"}],"source":"bangumi","sourceCharacterId":"29663"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"29663","value":"地狱鸦"},{"label":"能力","source":"bangumi","sourceCharacterId":"29663","value":"操控核融合的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a8f00e72e6f71036bfa2e12f115bc7d5926836508d108490855c7a61d1380f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70c7d8199a57908f09f3d5f093898b1640380f3f3060c3458c304db9d4e98172.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29664","characterName":"姬海棠羽立、姬海棠极","sourceIds":{"bangumi":[{"characterId":"29664","match":"source-roster","subjectId":"104009"},{"characterId":"29664","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"姬海棠羽立、姬海棠极","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"29664","value":"天狗"},{"label":"能力","source":"bangumi","sourceCharacterId":"29664","value":"能够使用念写程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34de52f2cc67a75716f3d83cfdffa9df5a0d149e2ff60f587e0a1b10ee1ee93b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a3b11f95b7585f56e6d1308fc26286e42b75fb64f2eec30d7c38b2bcac95f16.webp","width":118,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29666","characterName":"Kagiyama Hina","sourceIds":{"bangumi":[{"characterId":"29666","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"Kagiyama Hina","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"能力 收集厄运程度的能力"},{"spoiler":false,"text":"危险度 极高"},{"spoiler":false,"text":"人类友好度 中"},{"spoiler":false,"text":"主要活动场所 玄武之泽，无缘塚，中有之道等"},{"spoiler":false,"text":"收集厄运的神明。所谓的疫病神。不管是人类还是妖怪只要靠近了她就会变得不幸。"},{"spoiler":false,"text":"但是，她本人却完全没有恶意。倒不如说她是个待人友好的神明。收集厄运的本意，也只是为了不让厄运转移到人类身上。"},{"spoiler":false,"text":"关于这个神明的避讳之事实在太多，所以也不过多提及（×1 我也不想变得不幸……）。"},{"spoiler":false,"text":"关于她的忌讳之事有"},{"spoiler":false,"text":"「即使看到了也当做没看到」"},{"spoiler":false,"text":"「不跟她走同一条道」"},{"spoiler":false,"text":"「说话时不主动展开话题」"},{"spoiler":false,"text":"等等。"},{"spoiler":false,"text":"触犯了忌讳的话灾祸就会降临。"},{"spoiler":false,"text":"这样一来就不得不用，脏东西走开（×2 交叉食指与中指喊着「脏东西走开」。）来解除了。"},{"spoiler":false,"text":"因为与人类的接触很少，所以性格很难判断。不过，据某个因触犯忌讳而变得不幸的人所言，她的性格十分开朗且平易近人。"},{"spoiler":false,"text":"流雏与厄运"},{"spoiler":false,"text":"收集厄运是因为，厄运可以成为她的力量。厄运的负面能量本身是使她行动的原动力。"},{"spoiler":false,"text":"疫病神，虽然名字里有个神字，但却不追求信仰。她并非普通的神明，而是妖怪的一种。"},{"spoiler":false,"text":"利用了人们将厄运附于雏人偶随河川漂流而去的风俗习惯，在河流下游将雏人偶全数回收来收集厄运。因此，她的住所都是一些雏人偶，不过最近她为了循环利用，好像有把人偶反卖给人类村落（×3 因为大家都无视她所以现在正准备着一家无人商店。）。"},{"spoiler":false,"text":"厄运即为令人变得不幸的思念体。是不幸的幽灵。不幸就是幸运的反面。性质基本上是相同的（×4 无论哪种都是指的运气上的偏差。）因此收集不幸的她，在某种意义上也是个持有幸运光环的人。"},{"spoiler":false,"text":"对策"},{"spoiler":false,"text":"非常危险的存在。就算遇见她也请一定要保持距离。"},{"spoiler":false,"text":"不幸这种状态是谈不上抵抗的。受伤、大病、破产、离别……甚至有可能会出现一股脑儿全数袭来的惨况。"},{"spoiler":false,"text":"要是沾上厄运请务必马上去神社或是寺院驱厄。不过，要是抽签抽到大凶那就不知道会不会变成饭后谈资了（×5 这种一般都被看做是好运，虽然很可能会抽出小吉。）。"}],"source":"bangumi","sourceCharacterId":"29666"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"29666","value":"厄运神、疫病神"},{"label":"能力","source":"bangumi","sourceCharacterId":"29666","value":"储存厄运程度的能力（风神录、求闻口授）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccd112f11072946a2e9f13d132af53fae5c1d75d31bf982d5437729972239726.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3da54d5230c54bc76731550e086826e24fffb06ba16b98e0cb4c85215c364581.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29668","characterName":"Aki Minoriko","sourceIds":{"bangumi":[{"characterId":"29668","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"Aki Minoriko","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"29668","value":"神明"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42bf474ab9a5bf28685c6d18de890fffa981f0001e66e717d5992aaef4c93805.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a9e18253e65c79eed748792e7d598b7006ba2e0edeced7c576c025b1c469357.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29685","characterName":"Kurodani Yamame","sourceIds":{"bangumi":[{"characterId":"29685","match":"source-roster","subjectId":"1155"},{"characterId":"29685","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"Kurodani Yamame","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3039c349faa4213a157b43158b98f96fdff7eb4939d515872846b3a8b82c1c90.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e302716ce117faf00a4d08bc74c3a51a96e58fadba7da53808ec78d00925cc26.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29686","characterName":"Mizuhashi Parsee","sourceIds":{"bangumi":[{"characterId":"29686","match":"source-roster","subjectId":"1155"},{"characterId":"29686","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"Mizuhashi Parsee","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"能力 操纵嫉妒心程度的能力"},{"spoiler":false,"text":"危险度 中"},{"spoiler":false,"text":"人类友好度 完全没有"},{"spoiler":false,"text":"主要活动场所 旧地狱"},{"spoiler":false,"text":"居住在地底的妖怪，桥姬。"},{"spoiler":false,"text":"现在的旧地狱成了受人厌恶者的栖息地，她也是其中的一位。总之是个嫉妒心很强的妖怪。"},{"spoiler":false,"text":"煽动人们心中的嫉妒。看着他们因嫉妒而疯狂，生活逐渐崩溃的样子，并以此做为粮食。在她看来被嫉妒所驱使的人类是不可或缺的。"},{"spoiler":false,"text":"她的嫉妒是没有情理可言的。只要一觉得别人过得比自己幸福就会发作起来。如果别人和自己一样的话，就会夸耀说自己更加不幸一些。就算对方比自己更加不幸，只要对方不来嫉妒自己，也会因为对方的这份宽容而嫉妒。如果对方来嫉妒自己的话，这份嫉妒就会成为自己的粮食。走火入魔到这种程度。"},{"spoiler":false,"text":"但这并不意味着她本身也很不幸。只要有人心生嫉妒，她的力量便会无穷无尽，也没人会想去要她的命。她听说旧地狱聚集了不少被人厌恶的同伴。嫉妒者也并非全是不幸者吧。正相反，因为这这份嫉妒，所以才会看起来是不幸的样子吧。"},{"spoiler":false,"text":"她是个妖怪，却有着人类的性格。称之为嫉妒心本身也丝毫不为过。跟她进行直接对话的时候会给人一种很普通的开朗的感觉，但心中却已是波澜万丈。之后会在背地里使劲说你坏话，并对你怨恨起来。让人感觉十分的不好。"},{"spoiler":false,"text":"丑时参拜"},{"spoiler":false,"text":"有种咒术叫做丑时参拜。这是心怀强烈怨恨的人类暗地里进行复仇的著名咒术。"},{"spoiler":false,"text":"其实丑时参拜就是她开发的东西，这种说法广为流传。虽然没有正式的做法，但是在午夜两点半的时候把稻草人钉在木头上，作法的时候不能被任何人看到是共通点。"},{"spoiler":false,"text":"关于这个咒术的成功报告很少。因为这个咒术本身并没有什么复仇的意思。作法的人负担很大，一个劲地增强嫉妒心对于他人来说根本算不上什么咒术。（×1 最多也就是后背激灵一下子的程度。）"},{"spoiler":false,"text":"可是为什么，这种毫无效果的咒术会广为流传呢。"},{"spoiler":false,"text":"丑时参拜是增强嫉妒心的咒术。从这一点出发结论只有一个，丑时参拜就是她创作的咒术吧。劝诱人类去进行丑时参拜，煽动他们的嫉妒心，使其成为自己的力量。"},{"spoiler":false,"text":"对应方法"},{"spoiler":false,"text":"不要被她挑唆成功了就好。"},{"spoiler":false,"text":"她有着促进嫉妒心膨胀的强大力量，如果没有可以承受下来的精神力，便会自取灭亡。很多人类就是因为抗拒着嫉妒心，就活生生成为了她的粮食。"},{"spoiler":false,"text":"就算与她遭遇，和她打个招呼程度的话应该是没什么问题的。"},{"spoiler":false,"text":"如果不幸被嫉妒所驱使的话，那就喝点酒发泄一下吧。"}],"source":"bangumi","sourceCharacterId":"29686"}],"profileFacts":[{"label":"能力","source":"bangumi","sourceCharacterId":"29686","value":"操纵嫉妒心程度的能力（地灵殿、求闻口授）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c87412d808f1c8c89e12628a30fd6489717af06c8118f51deea1fa3f306ef04c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d0a538c3d6c2e82257c25c97857c072f4b590a18e9b419e38585cac70a83e9b.webp","width":142,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29687","characterName":"Kaenbyou Rin","sourceIds":{"bangumi":[{"characterId":"29687","match":"source-roster","subjectId":"1155"},{"characterId":"29687","match":"source-roster","subjectId":"430567"},{"characterId":"29687","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"Kaenbyou Rin","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df1127ea2536fc077cfc97b201805aa85d78fdb417050a3e1a21d8d6c38edcdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b08b01f5455839f1e7aa60cb3325c869f048320528e43f56652d6dbeeef39d87.webp","width":201,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_485","characterName":"博麗靈夢","sourceIds":{"bangumi":[{"characterId":"485","match":"source-roster","subjectId":"104009"},{"characterId":"485","match":"source-roster","subjectId":"1146"},{"characterId":"485","match":"source-roster","subjectId":"1148"},{"characterId":"485","match":"source-roster","subjectId":"1150"},{"characterId":"485","match":"source-roster","subjectId":"1151"},{"characterId":"485","match":"source-roster","subjectId":"1153"},{"characterId":"485","match":"source-roster","subjectId":"1155"},{"characterId":"485","match":"source-roster","subjectId":"1157"},{"characterId":"485","match":"source-roster","subjectId":"1160"},{"characterId":"485","match":"source-roster","subjectId":"12696"},{"characterId":"485","match":"source-roster","subjectId":"131875"},{"characterId":"485","match":"source-roster","subjectId":"1395"},{"characterId":"485","match":"source-roster","subjectId":"2134"},{"characterId":"485","match":"source-roster","subjectId":"329342"},{"characterId":"485","match":"source-roster","subjectId":"430567"},{"characterId":"485","match":"source-roster","subjectId":"5752"},{"characterId":"485","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"博麗靈夢","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幻想乡境内博丽神社的现有巫女。"},{"spoiler":false,"text":"博丽神社是专门守护幻想乡不可缺少的大结界的神社。博丽的巫女代代以解决异变为事业。"},{"spoiler":false,"text":"她是历代巫女中最缺乏危机感的一位，不知是因为修行不足，还是因为已经拥有足够的实力。"},{"spoiler":false,"text":"她天生地幸运和敏锐，也退治了不少妖怪。"}],"source":"bangumi","sourceCharacterId":"485"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"485","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"主要是在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"作为博丽巫女的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"操纵灵气的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33007c417ade7c73b7ee78244285c2ff601da86919605a6f56c0570deb01c0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc26d83763ce8144e0a342eaeb5a41bf3e1756ec782d0268170ef9bac39c8489.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_486","characterName":"霧雨魔理沙","sourceIds":{"bangumi":[{"characterId":"486","match":"source-roster","subjectId":"104009"},{"characterId":"486","match":"source-roster","subjectId":"1146"},{"characterId":"486","match":"source-roster","subjectId":"1148"},{"characterId":"486","match":"source-roster","subjectId":"1150"},{"characterId":"486","match":"source-roster","subjectId":"1151"},{"characterId":"486","match":"source-roster","subjectId":"1153"},{"characterId":"486","match":"source-roster","subjectId":"1155"},{"characterId":"486","match":"source-roster","subjectId":"1157"},{"characterId":"486","match":"source-roster","subjectId":"1160"},{"characterId":"486","match":"source-roster","subjectId":"12696"},{"characterId":"486","match":"source-roster","subjectId":"131875"},{"characterId":"486","match":"source-roster","subjectId":"1395"},{"characterId":"486","match":"source-roster","subjectId":"2134"},{"characterId":"486","match":"source-roster","subjectId":"329342"},{"characterId":"486","match":"source-roster","subjectId":"430567"},{"characterId":"486","match":"source-roster","subjectId":"5752"},{"characterId":"486","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"霧雨魔理沙","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"居住于魔法森林的人类魔法使，常骑着扫把，「霧雨店」的独生女。會使用魔法森林的蘑菇調製火藥，所使用的魔法幾乎只有把東西破壞的效果，而且燃料需要長時間準備，但是其效果非常強力，在Spell Card規則成立下，純粹的破壞力在人類當中屬於最高等級。此外在幻想乡是出了名的小偷，帕邱莉的图书馆、香霖堂，如果不是古明地觉会读心术，甚至连地灵殿都会惨遭毒手。"}],"source":"bangumi","sourceCharacterId":"486"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"486","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"486","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e00e4df671f5f80d5733c44e4b69596b901aad88177fc335789c2dd5ea6b2d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bd6c6ab5c1df20f216ccf8f7e1581841d4fed04fe2cad0f92ce726df7fb8d1.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_487","characterName":"射命丸 文","sourceIds":{"bangumi":[{"characterId":"487","match":"source-roster","subjectId":"104009"},{"characterId":"487","match":"source-roster","subjectId":"1150"},{"characterId":"487","match":"source-roster","subjectId":"1151"},{"characterId":"487","match":"source-roster","subjectId":"2134"},{"characterId":"487","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"射命丸 文","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"射命丸文是天狗之中速度很快的鸦天狗。手持相机，在幻想乡各处奔走，记录下各种有趣的事件。"},{"spoiler":false,"text":"虽说是鸦天狗，外表和人类并无太大差别。"},{"spoiler":false,"text":"随身带着的道具是团扇、相机和文花帖。"},{"spoiler":false,"text":"团扇是起风的道具，一扇能刮倒屋子，二扇能刮倒大树，三扇能将旅人的斗篷吹飞。是天狗的武器。"},{"spoiler":false,"text":"相机是天狗的另一件武器。能将瞬间景象拍下的必杀武器（×1拍摄速度也十分地惊人。）。"},{"spoiler":false,"text":"拍下的相片会登载在新闻报纸上。"},{"spoiler":false,"text":"文花帖是将能成为新闻记事的题材记录起来的天狗的笔记本。里面混杂了各种相片和手写文字（×2天狗的手写体意外地可爱。）。"},{"spoiler":false,"text":"操纵风的能力，指的是既能瞬间吹起狂风又能瞬间让狂风停止，还能肆意刮起龙卷风，纯粹追求强力的猛烈技能。"}],"source":"bangumi","sourceCharacterId":"487"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"487","value":"鸦天狗（花映冢、风神录、绯想天）/天狗（地灵殿、求闻史纪、天空璋）"},{"label":"能力","source":"bangumi","sourceCharacterId":"487","value":"操纵风程度的能力（花映冢、风神录、绯想天、地灵殿、求闻史纪、天空璋）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76964ca8ed3f6929b65c57aee506edb84d82d9d95c36aa5803ddc89f98434a70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c30a2767989de1befcc33502cf3697399f51b28cb405e96be8425b397255b10.webp","width":161,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_489","characterName":"纳兹琳","sourceIds":{"bangumi":[{"characterId":"489","match":"source-roster","subjectId":"1395"},{"characterId":"489","match":"source-roster","subjectId":"430567"},{"characterId":"489","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"纳兹琳","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"虽然她是寅丸星的使魔鼠妖，但是实际上她是真正的毘沙门天派来的高等级妖怪。是派来帮助和监视寅丸星工作的。"},{"spoiler":false,"text":"她的特技是探宝。所谓的探宝，本意是指搜寻地下埋藏的水脉，但是她的能力并不仅限于此，更多的时候是在探寻财宝。"},{"spoiler":false,"text":"一般的探宝的方法，会到使用探测棒，震动摆探测器等。但是她是使用野生老鼠来作为探测器的。因为无论是多么狭小或者深邃的地方都能钻进去，所以可以通过听声辨位来确认所寻之物的所在处。"},{"spoiler":false,"text":"也并非是什么样的东西都可以找到。那些太大的东西（×1 太大的东西老鼠反而看不见。）、如同饵食一样能吃的东西（×2 会吃掉的。）、活着的动物（×3 猫。），都不是它们擅长寻找的东西。还有，让老鼠收集那些它们无法辨识、无法理解的东西，也是比较困难的。"},{"spoiler":false,"text":"虽然她的身材不大，但是性格却是出奇的骄傲自大。不过这是因为有毘沙门天做她的后盾，其实她的性格是比较胆小的。一旦遇到什么可怕的事情立刻就逃之夭夭了。"}],"source":"bangumi","sourceCharacterId":"489"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"489","value":"鼠妖"},{"label":"能力","source":"bangumi","sourceCharacterId":"489","value":"要搜寻东西就能搜寻到的能力（星莲船、求闻口授）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b6a6f96cfaf5d5063c42785b3e386e769c073e92a6e656678ac6fd1f6328081.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cba464b83875f3464f6b9958ffcc371ddd61b045cb6bad8e4a53ccdb14c960a.webp","width":157,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_889","characterName":"東風谷 早苗","sourceIds":{"bangumi":[{"characterId":"889","match":"source-roster","subjectId":"104009"},{"characterId":"889","match":"source-roster","subjectId":"12696"},{"characterId":"889","match":"source-roster","subjectId":"131875"},{"characterId":"889","match":"source-roster","subjectId":"1395"},{"characterId":"889","match":"source-roster","subjectId":"2134"},{"characterId":"889","match":"source-roster","subjectId":"329342"},{"characterId":"889","match":"source-roster","subjectId":"430567"},{"characterId":"889","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"東風谷 早苗","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"住在妖怪之山上的守矢神社的巫女。"}],"source":"bangumi","sourceCharacterId":"889"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"889","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"889","value":"引发奇迹程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b1c4cec24100603ccda5fb96eda4303e1cc0ee88841ee32d35f05a2905a1efd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46d80e50773b6c9b14e3ada0d949ea2c94dd248ab95c87a252bcd67ab59d5f22.webp","width":171,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:997","sourceCompanyId":"egs:brand:997","canonicalEntityId":"egs:brand:997","name":"上海アリス幻樂団","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:14248:997","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
