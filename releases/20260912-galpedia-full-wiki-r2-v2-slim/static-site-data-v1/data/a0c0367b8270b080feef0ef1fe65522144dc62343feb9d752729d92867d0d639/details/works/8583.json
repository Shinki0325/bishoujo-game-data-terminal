6fd1e9a61d88308dffa6d41390212b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d25611d4488e159a966d7d2f7b9ddbf7675ce88e1b90af005e567bf2d4c3ab99.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤 孝行","creatorId":"vndb:s2121","sourcePersonId":"vndb:s2121","canonicalEntityId":"vndb:s2121","name":"近藤 孝行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28853","source":"vndb"}]},{"characterId":"char_vndb_c141733","characterName":"緒方 真竹","sourceIds":{"vndbCharacterId":"c141733"},"originalCharacterName":"緒方 真竹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d636721943c4ce5939d26dca4758f2264fa41ae84cf3fecf8d0c16a6aa912b2b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccc7a9b61871c29c8a80f427fe01a11f0639a4cbf4099e1832b3b943567bb47b.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 由美子","creatorId":"vndb:s2125","sourcePersonId":"vndb:s2125","canonicalEntityId":"vndb:s2125","name":"小林 由美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28854","source":"vndb"}]},{"characterId":"char_vndb_c27154","characterName":"坂井 悠二","sourceIds":{"vndbCharacterId":"c27154"},"originalCharacterName":"坂井 悠二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuji, the main protagonist of the story, is just an average high school student. However, his world is turned upside down when he discovers that he is already dead and does not have much time before he disappears. Fortunately, Yuuji is a Mystes who contains a treasure known as the \"Midnight Lost Child\" (Reiji Maigo). Unlike normal torches, the treasure inside him restores his Power of Existence every night at midnight."}],"source":"vndb","sourceCharacterId":"c27154"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f81f4e8ffc590089af57f237b7b00ee6a0eee83fe8a163f0ededd375e1db1c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13d680eadd60ea9c47168889e829dc49e40d1029ee88a594746f8a9736f0da75.webp","width":165,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c73934","characterName":"シャナ","sourceIds":{"vndbCharacterId":"c73934"},"originalCharacterName":"シャナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shana is the female lead of the show and a Flame Haze. She was formerly human (but as stated in the novels and manga, that once a human makes a contract with a crimson lord, they become a Flame Haze and live forever). Her nickname is the \"Flame-Haired Red-Hot-Eyed Hunter\". Initially she is concentrated solely on her duty as a Flame Haze, going as far as to not bearing even a name. She sees Yuji only as a Torch, an object, marginally interesting because of his status as a Mystes. Yuji, in his need to humanize her, chose to name her \"Shana\" after her katana. However, she slowly opens up to Yuji, coming to think of him as a person, despite being a Torch, and eventually comes to love him. Until she met Yuji, she was identified by only her Flame Haze title \"Flame-Haired Burning-Eyed Hunter,\" or her nodachi, Nietono no Shana. Shana has a habit of saying \"Urusai! Urusai! Urusai!\" (\"Shut up! Shut up! Shut up!\") whenever Yuji asks her questions or makes remarks that disturb her original world view or embarrass her. But in reality they really care for each other. She has a great fondness for sweets, especially melon bread. Shana is shown to be highly intelligent in the series; she got a perfect score on every exam and is talented in Phys. Ed. She is shown, however, to be naive when it comes to social affairs, once even unabashedly asking \"how babies are made\"."}],"source":"vndb","sourceCharacterId":"c73934"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f1dbb8a6c5e9106b10ee1bd6806a634d0e3b8ebe9957a83c73370add25ef25a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09505c48f2819d514509792d8434e33a06c5dd9cd8b63a40c1baec573674560e.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"釘宮 理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28848","source":"vndb"}]},{"characterId":"char_vndb_c73935","characterName":"吉田一美","sourceIds":{"vndbCharacterId":"c73935"},"originalCharacterName":"吉田一美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazumi is Yuji's classmate. She has a crush on Yuji, but is a bit too shy to tell him directly. In the first season, she spends most of her screen time remaining ignorant of Shana's true nature and her actual relationship with Yuji. When Shana became her love-rival, she vowed to tell Yuji her feelings and to let him decide between her and Shana."}],"source":"vndb","sourceCharacterId":"c73935"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e2cdffa3fbb19dbe4d011dabb7b473954d0470b02802e568a9da9ee86adb0d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32e9efad3ab21be650477018df0d25ac1fb62ec96ba99ca98bb170a387049ed5.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川澄 綾子","creatorId":"vndb:s16","sourcePersonId":"vndb:s16","canonicalEntityId":"vndb:s16","name":"川澄 綾子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28844","source":"vndb"}]},{"characterId":"char_vndb_c73936","characterName":"坂井 千草","sourceIds":{"vndbCharacterId":"c73936"},"originalCharacterName":"坂井 千草","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chigusa is Yuji's mother. Her husband, Kantaro, works outside the country. Chigusa remains ignorant of Shana and Yuji's true nature, but becomes a source of good advice for Shana on matters where Alastor can not counsel her. The Crimson Lord himself acknowledges and bows to her wisdom after a phone call between the two of them. Described as a woman who can accept anything, she seems to harbor absolutely no problems with Shana often visiting Yuji under the pretext of \"training\"."}],"source":"vndb","sourceCharacterId":"c73936"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f770b450ab2d817be378993073a2d44545f106917a2ebcbba04150a2f87edbb7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11c1526616f5b891dac2f739fba1320ce25b2e3763871e2961e968ffefd787ee.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井 智","creatorId":"vndb:s16615","sourcePersonId":"vndb:s16615","canonicalEntityId":"vndb:s16615","name":"櫻井 智","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28856","source":"vndb"}]},{"characterId":"char_vndb_c73937","characterName":"アラストール","sourceIds":{"vndbCharacterId":"c73937"},"originalCharacterName":"アラストール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alastor is the Lord of the Crimson Realm to whom Shana is bound. He is known as the \"Flame of the Heavens\". He expresses his will through a divine vessel called the Cocytus, which (in Shana's case) takes the form of a pendant. Alastor is considered to be one of the strongest of all Lords or Denizens; in fact being one of the true Gods of the Crimson Realm."}],"source":"vndb","sourceCharacterId":"c73937"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abc46c0ca62eba9f6899316c6eb6985483b50a07a594eb6a6e96c15b0182fd4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fb166e3021855115775e4234e22a01c7aab75df7e11994e9dd923f8029ebfbf.webp","width":226,"height":144,"source":"static-detail"},"actors":[{"creditedName":"江原 正士","creatorId":"vndb:s2070","sourcePersonId":"vndb:s2070","canonicalEntityId":"vndb:s2070","name":"江原 正士","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28851","source":"vndb"}]},{"characterId":"char_vndb_c73939","characterName":"マージョリー・ドー","sourceIds":{"vndbCharacterId":"c73939"},"originalCharacterName":"マージョリー・ドー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Margery is a tall, \"well-endowed\" and mature blond Flame Haze with a drinking habit. She uses the book Grimoire, which is the divine vessel through which Marchosias, to whom she is bound, expresses his will. Her specialty seems to be Power of Unrestraint, and her main powers focus around chanting spells and turning into a werewolf."}],"source":"vndb","sourceCharacterId":"c73939"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/852f270dd69ed30b9f1da543d38782c25cf1650c90adb82b79b032ca87b224a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0467e34e16f9bf6e9d9daefcbe06d0b14dfb3e1cb7654d991fe5ec77a709f476.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"生天目 仁美","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目 仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28845","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p137","sourceCompanyId":"egs:brand:623","canonicalEntityId":"vndb:p137","name":"アスキー・メディアワークス","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8583:623","source":"egs"},{"companyId":"vndb:p591","sourceCompanyId":"vndb:p591","canonicalEntityId":"vndb:p591","name":"株式会社ブリッジ","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:10522:v4688","