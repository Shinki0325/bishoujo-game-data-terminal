descriptions":[{"segments":[{"spoiler":false,"text":"元々は葉子のクラスメイトで親しい間柄だったが、悪の組織「デストルドー」の出現によって、彼女は魅入られ、悪の魔法少女「ビューティ・モス」に変身し、正義の魔法少女「ミスティ・バタフライ（＝葉子）」を苦しめた。"},{"spoiler":false,"text":"しかし、その「デストルドー」が葉子に滅ぼされ、行き場を失った彼女は人間社会に溶け込み、現在は、普通のOLとして営業の仕事に就いている。"},{"spoiler":false,"text":"葉子に対して性別を超えた感情を抱いているが、組織を滅ぼされた強い憎しみも持ち合わせ、その二つの感情の狭間で苦悩している。"}],"source":"egs","sourceCharacterId":"16378","sourceWorkId":"11473","spoiler":false},{"segments":[{"spoiler":false,"text":"体形はモデルタイプ。出るとこ出て、引っ込んでるところは引っ込んでる。"},{"spoiler":false,"text":"小さい頃は、葉子より胸が出ていた。"},{"spoiler":false,"text":"葉子とは、元クラスメイト。葉子が正義の神に選ばれたのに対し、アゲハは"},{"spoiler":false,"text":"魔神に見入られ、悪の魔法少女「ビューティ・モス」に変身する。しかし、激"},{"spoiler":false,"text":"闘の末、悪の組織「デストルドー」は滅ぼされ、今は普通に仕事をしている。"},{"spoiler":false,"text":"葉子には性別を超えた愛情を持っているが、同時に組織を滅ぼした仇でもあ"},{"spoiler":false,"text":"り、時々苦悶している。葉子の旦那である神荻春太に対しては、単純に悪意を"},{"spoiler":false,"text":"持っている。"}],"source":"egs","sourceCharacterId":"16378","sourceWorkId":"29263","spoiler":false},{"segments":[{"spoiler":false,"text":"体形はモデルタイプ。出るとこ出て、引っ込んでるところは引っ込んでる。 小さい頃は、葉子より胸が出ていた。"},{"spoiler":false,"text":"葉子とは、元クラスメイト。"},{"spoiler":false,"text":"葉子が正義の神に選ばれたのに対し、アゲハは魔神に見入られ、悪の魔法少女「ビューティ・モス」に変身する。 しかし、激闘の末、悪の組織「デストルドー」は滅ぼされ、今は営業の仕事をしている。"},{"spoiler":false,"text":"葉子には性別を超えた愛情を持っているが、同時に組織を滅ぼした仇でもあり、時々苦悶している。"}],"source":"bangumi","sourceCharacterId":"178144"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"16378","sourceWorkId":"11473","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"16378","sourceWorkId":"11473","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"16378","sourceWorkId":"11473","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"16378","sourceWorkId":"11473","sourceField":null,"scoped":true}],"metadat