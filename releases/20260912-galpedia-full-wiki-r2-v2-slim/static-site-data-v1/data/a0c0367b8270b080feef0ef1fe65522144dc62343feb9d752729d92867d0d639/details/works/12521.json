ce-native","relationId":"vndb:vn-staff:1849","source":"vndb"},{"creditedName":"大熊猫","creatorId":"vndb:s23198","sourcePersonId":"vndb:s23198","canonicalEntityId":"vndb:s23198","name":"大熊猫","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1850","source":"vndb"},{"creditedName":"杵蓄 太郎","creatorId":"vndb:s23236","sourcePersonId":"vndb:s23236","canonicalEntityId":"vndb:s23236","name":"杵蓄 太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1851","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c440","characterName":"屑屋","sourceIds":{"vndbCharacterId":"c440"},"originalCharacterName":"屑屋","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist is a nameless middle-aged soldier living the life of a \"junker\"—scavenging useful items among ruined cities to survive."},{"spoiler":false,"text":"He has a tough personality that comes from trying to survive in a dystopic world. He carries a grenade launcher with him and covers himself with a waterproof coat to protect his skin from the toxic rain. For drinking water, his canteen has a water purifier that can purify the rain. He is constantly searching for rarer substances such as cigarettes and alcohol which can be sold at high prices."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c440"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"小野 大輔","creatorId":"vndb:s103","sourcePersonId":"vndb:s103","canonicalEntityId":"vndb:s103","name":"小野 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:497","source":"vndb"}]},{"characterId":"char_vndb_c441","characterName":"ほしの ゆめみ","sourceIds":{"vndbCharacterId":"c441"},"originalCharacterName":"ほしの ゆめみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yumemi is a goodhearted but extremely talkative gynoid attendant of an abandoned planetarium; she is designed to look like a young girl. Yumemi is slightly damaged and completely unaware of the changes that have occurred in the past 30 years, as none of the facilities and databases that she connects to exist anymore."},{"spoiler":false,"text":"Yumemi is very adamant about protecting humans and is happiest when she is helping those she serves. When she is unable to help someone, she gets terribly worried that she is incapable of offering assistance and must instead indirectly help a customer by directing him or her to someone who can. Protecting humans is her top priority and will even ignore previous orders to make sure no human is harmed when in her care."},{"spoiler":false,"text":"From Wikipedia"},{"spoiler":false,"text":"Her name could be literary translated The Reverie(Dream) of a Little Planet."}],"source":"vndb","sourceCharacterId":"c441"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b63d632b5dfe932a447ba773520eed021e6767d662d19d6bcbf8c4de8181c27b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/959f8278605f289222ca8c94a5cf68b7f1e983708f5ba3dfcd88eab415ba43b8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずき けいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:498","source":"vndb"}]}],"so