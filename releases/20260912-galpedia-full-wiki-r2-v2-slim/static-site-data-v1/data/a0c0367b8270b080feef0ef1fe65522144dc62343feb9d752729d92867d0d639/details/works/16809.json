{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"16809","model":{"presentationWorkId":"vndb:v9861","staff":{"artwork":[{"creditedName":"さいとうつかさ","creatorId":"vndb:s2482","sourcePersonId":"egs:creator:327","canonicalEntityId":"vndb:s2482","name":"さいとうつかさ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:103633","source":"egs"}],"scenario":[{"creditedName":"土岐乱鳳(土岐光鳳)","creatorId":"vndb:s3035","sourcePersonId":"egs:creator:5661","canonicalEntityId":"vndb:s3035","name":"土岐乱鳳(土岐光鳳)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:105209","source":"egs"}],"music":[],"other":[{"creditedName":"DelightStyle","creatorId":"vndb:s14566","sourcePersonId":"egs:creator:30293","canonicalEntityId":"vndb:s14566","name":"DelightStyle","detail":"OP曲「愛☆Promise」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:183375","source":"egs"},{"creditedName":"神代 流","creatorId":"vndb:s2188","sourcePersonId":"vndb:s2188","canonicalEntityId":"vndb:s2188","name":"神代 流","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:85424","source":"vndb"},{"creditedName":"神代 流","creatorId":"vndb:s2188","sourcePersonId":"vndb:s2188","canonicalEntityId":"vndb:s2188","name":"神代 流","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:85425","source":"vndb"},{"creditedName":"ろど","creatorId":"vndb:s4155","sourcePersonId":"vndb:s4155","canonicalEntityId":"vndb:s4155","name":"ろど","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:85428","source":"vndb"},{"creditedName":"DelightStyle","creatorId":"vndb:s14566","sourcePersonId":"vndb:s14566","canonicalEntityId":"vndb:s14566","name":"DelightStyle","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:85429","source":"vndb"}]},"cast":[{"characterId":"char_c23493","characterName":"ペシュリーゼ・ランピック・デ・コーニング","sourceIds":{"bangumi":[{"characterId":"16089","match":"exact-normalized-name-in-linked-work","subjectId":"35434"}],"egsCharacterIds":["8856"],"vndbCharacterId":"c23493"},"originalCharacterName":"ペシュリーゼ・ランピック・デ・コーニング","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヨーロッパの小国・ヒューガルデン公国のお姫様。"},{"spoiler":false,"text":"いつもおっとりニコニコ、物腰が柔らかく、誰にでも丁寧に接する。"},{"spoiler":false,"text":"世間知らずな半面とても賢く、病床の父に代わって政務も取り仕切っている。"},{"spoiler":false,"text":"継母に疎まれ望まぬ縁談を進められており、日本を訪れた際に主人公を頼りに突発的に逃げ出してしまった。"},{"spoiler":false,"text":"してしまったことについては後悔しているが、もはや引くに引けない状態に。"},{"spoiler":false,"text":"芯が強く、ちょっぴり頑固。"}],"source":"egs","sourceCharacterId":"8856","sourceWorkId":"16809","spoiler":false},{"segments":[{"spoiler":false,"text":"欧洲小国、ヒューガルデン公国的公主。"},{"spoiler":false,"text":"一直展现着笑容，态度和善，无论对方是谁都会礼貌地对待。"},{"spoiler":false,"text":"不懂人情世故但是知情达理，代替躺在病床上的父亲处理政务。"},{"spoiler":false,"text":"因为关系生疏的继母提出的自己不想接受的婚约，在到访日本之际依赖主人公突然逃了出来。"},{"spoiler":false,"text":"虽然对这件事情感到后悔，但事情已经到了无法回头的状态。坚强而有点稳固。"}],"source":"bangumi","sourceCharacterId":"16089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7536d8dac6acea4aa0330942d2ad28a644b3232cf804878c1411b935831c692.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7baec69ca586f5f8f1be86cb127638573733c04a159ca0f328e5b99ca7cff26.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:35434:16089:5020:1","source":"bangumi"}]},{"characterId":"char_c23494","characterName":"デュベル","sourceIds":{"bangumi":[{"characterId":"16093","match":"exact-normalized-name-in-linked-work","subjectId":"35434"}],"egsCharacterIds":["8860"],"vndbCharacterId":"c23494"},"originalCharacterName":"デュベル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ペシェリーゼ姫を暗殺するために派遣された暗殺者……と言い張っているが、とてもその様には見えないへっぽこニンジャ。"},{"spoiler":false,"text":"日本文化に大きく致命的な誤解を抱いており、やること成すこと言うこと、すべてがズレている。"},{"spoiler":false,"text":"エージェントとしては一流なのだが、とにかく “ニンジャ” にこだわって失敗ばかり。"},{"spoiler":false,"text":"やる気があるのか無いのか、それとも別の目的があるのか……。"}],"source":"egs","sourceCharacterId":"8860","sourceWorkId":"16809","spoiler":false},{"segments":[{"spoiler":false,"text":"为了暗杀ペシェリーゼ公主而被派来的暗杀者……虽然她这样虚张声势，但无论怎么看都是个不会痛下杀手的忍者。"},{"spoiler":false,"text":"对日本文化有着极大的误解，无论做什么说什么都与事实擦肩而过。"},{"spoiler":false,"text":"拥有相当的才能，但因为太执着于“忍者”这个词而经常失败。"},{"spoiler":false,"text":"不知道她有没有干劲，还是说有其他的目的……"}],"source":"bangumi","sourceCharacterId":"16093"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4f1dd63156cda8ca2896627d46cca7349c073e259dadce1cc5d7f84726d40d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af7ab7236fdeb63c42873a2f8afb658e9ce5e4b984c2f4ea699484021dad5dcf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七穂元美","creatorId":"vndb:s3769","sourcePersonId":"vndb:s3769","canonicalEntityId":"vndb:s3769","name":"七穂 元美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:35434:16093:9417:1","source":"bangumi"}]},{"characterId":"char_c23495","characterName":"プルミエール・シメイ・ロシフォール","sourceIds":{"bangumi":[{"characterId":"16092","match":"exact-normalized-name-in-linked-work","subjectId":"35434"}],"egsCharacterIds":["8859"],"vndbCharacterId":"c23495"},"originalCharacterName":"プルミエール・シメイ・ロシフォール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ペシェリーゼ姫の従姉妹にあたる姫。"},{"spoiler":false,"text":"勝手にペシェリーゼをライバル視している。"},{"spoiler":false,"text":"ワガママで泣き虫、そのくせ意地っ張り。"},{"spoiler":false,"text":"ヘソを曲げると子供じみた悪口を言って去って行く。"},{"spoiler":false,"text":"他人のモノを欲しくなる悪癖があり、ペシェリーゼから主人公を奪おうとするが、根っこはお人好しでお馬鹿さんなため、空回りしてばかり。"},{"spoiler":false,"text":"いつもペシェリーゼに憎まれ口を叩くが、実は彼女のことが大好きであり、構ってほしいだけ。"},{"spoiler":false,"text":"素直になれない寂しがり屋。"}],"source":"egs","sourceCharacterId":"8859","sourceWorkId":"16809","spoiler":false},{"segments":[{"spoiler":false,"text":"与ペシェリーゼ公主是表姐妹关系的公主。单方面视ペシェリーゼ为对手。"},{"spoiler":false,"text":"任性而易哭，却又爱逞强。一不高兴就会扭拧地说些难听的话转身离开。"},{"spoiler":false,"text":"有着索求别人拥有的东西的坏习惯，要从ペシェリーゼ手上抢走主人公，但因为根子里是个善良的蠢蛋，总是白忙一场。"},{"spoiler":false,"text":"一直对着ペシェリーゼ恶言相向，其实很喜欢她，只是想她注意自己而已。"}],"source":"bangumi","sourceCharacterId":"16092"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba03ae6f160eaa177a4c4c72992ab469176752656542bf0e95d1eec0eb6663aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fbe885124d1c61cf83b161052326895a25c71b24a91d17cb333bb367de50202.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:35434:16092:5075:1","source":"bangumi"}]},{"characterId":"char_c23496","characterName":"ステラ・アルトワ","sourceIds":{"bangumi":[{"characterId":"16090","match":"exact-normalized-name-in-linked-work","subjectId":"35434"}],"egsCharacterIds":["8857"],"vndbCharacterId":"c23496"},"originalCharacterName":"ステラ・アルトワ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ペシェリーゼ姫付きの女騎士。"},{"spoiler":false,"text":"我が身に代えても姫を守る！ という強い忠誠心の持ち主。"},{"spoiler":false,"text":"まじめで仕事熱心だが、その反面融通が利かず超カタブツ。"},{"spoiler":false,"text":"めんどくさいくらいのツンデレ。"},{"spoiler":false,"text":"それが災いして、姫には「いやいや仕えられている」 と誤解されている。"},{"spoiler":false,"text":"ついでに大の男嫌い。"},{"spoiler":false,"text":"男勝りだが、実はかなりの乙女。"},{"spoiler":false,"text":"男勝りな性格に反して身体つきは非常に女性らしく、それがコンプレックスになってしまっている。"},{"spoiler":false,"text":"本人も気づいていないが、実はMっ気アリ。"}],"source":"egs","sourceCharacterId":"8857","sourceWorkId":"16809","spoiler":false},{"segments":[{"spoiler":false,"text":"陪同ペシェリーゼ公主的女骑士。"},{"spoiler":false,"text":"拥有「牺牲自己也要保护公主！」这等强烈的忠诚心。"},{"spoiler":false,"text":"做事认真工作热心，但反过来不怎么通融，超级顽固。甚至让人觉得有点讨厌的傲娇。"},{"spoiler":false,"text":"因此不幸地让公主误以为她其实是“很不情愿地来侍奉自己”。"},{"spoiler":false,"text":"相当讨厌男性。外表纯爷们，但其实相当有少女味。"},{"spoiler":false,"text":"与性格相反，身材很能体现女性的特点，但却为此而感到自卑。"},{"spoiler":false,"text":"本人尽管没有察觉，其实有点M。"}],"source":"bangumi","sourceCharacterId":"16090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0f92e90c5bb6884cb0099e4954e1a3d6aa8b7110a7a98ca02397f6ecb64dfd8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54b081ec268370896113d4340df1e39175ab1cf9a84ee26453cc1dab9c661561.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"志村由美","creatorId":"vndb:s198","sourcePersonId":"vndb:s198","canonicalEntityId":"vndb:s198","name":"志村由美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:35434:16090:4690:1","source":"bangumi"}]},{"characterId":"char_c23497","characterName":"ヴェデット・ホワイト","sourceIds":{"bangumi":[{"characterId":"16091","match":"exact-normalized-name-in-linked-work","subjectId":"35434"}],"egsCharacterIds":["8858"],"vndbCharacterId":"c23497"},"originalCharacterName":"ヴェデット・ホワイト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ペシェリーゼ姫付きのメイド。"},{"spoiler":false,"text":"メイドなのだが炊事家事全般は苦手。"},{"spoiler":false,"text":"主なお仕事はお話相手と遊び相手。"},{"spoiler":false,"text":"髪の手入れだけは得意だったりする。"},{"spoiler":false,"text":"感情の起伏が見えにくいが、奔放でイタズラ好きな困ったちゃん。"},{"spoiler":false,"text":"主従関係に疎く 姫にはタメ口。"},{"spoiler":false,"text":"ともかく口がとても悪いのでいつもステラを怒らせている。"},{"spoiler":false,"text":"姫のことはとても愛しており、姫のためならどんなことでもする、と決意している。"},{"spoiler":false,"text":"匂いフェチ。"}],"source":"egs","sourceCharacterId":"8858","sourceWorkId":"16809","spoiler":false},{"segments":[{"spoiler":false,"text":"陪同ペシェリーゼ公主的女仆。"},{"spoiler":false,"text":"明明是女仆却不擅长煮饭和所有家务。主要的工作是陪公主谈话玩耍。"},{"spoiler":false,"text":"唯一擅长的是梳理头发。"},{"spoiler":false,"text":"很难看见她的感情起伏，但性格奔放喜欢恶作剧的麻烦女孩。"},{"spoiler":false,"text":"不遵从上下关系，对公主说话随便，口没遮拦等问题总是让ステラ生气。"},{"spoiler":false,"text":"很喜欢公主，下定决心只要是为了公主，无论什么事情都会去做。"},{"spoiler":false,"text":"有气味癖。"}],"source":"bangumi","sourceCharacterId":"16091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45185232d4471b661098acd4b33f2990d0284e4841acd389f4d14a967c235a9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1d98ee2f639b1e67c9cc36e394607460a13f70c40f1182276e88c541b1b2ca3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:35434:16091:4854:1","source":"bangumi"}]},{"characterId":"char_c23499","characterName":"白州 榮","sourceIds":{"bangumi":[{"characterId":"16094","match":"exact-normalized-name-in-linked-work","subjectId":"35434"}],"egsCharacterIds":["8861"],"vndbCharacterId":"c23499"},"originalCharacterName":"白州 榮","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の母。豪放磊落が服を着たような肝っ玉母ちゃん。"},{"spoiler":false,"text":"息子を日本に置いて、どこか遠くへ旅に出ている。"},{"spoiler":false,"text":"その度あちこちで金を使い、借金を増やしている。"},{"spoiler":false,"text":"過去、ヒューガルデン公国の危機を救ったことがあり、国の英雄扱い。"},{"spoiler":false,"text":"すごいんだけどダメな人。"}],"source":"egs","sourceCharacterId":"8861","sourceWorkId":"16809","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的母亲。穿着豪放磊落的「肝っ玉母ちゃん」。"},{"spoiler":false,"text":"将儿子丢在日本，不知去了哪里远游。"},{"spoiler":false,"text":"旅游期间到处花钱，令债务增加。"},{"spoiler":false,"text":"过去曾拯救了ヒューガルデン公国而被当成国家英雄。"},{"spoiler":false,"text":"虽然很厉害，但是个废柴。"}],"source":"bangumi","sourceCharacterId":"16094"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3518187488984e61d01b0f37958d14f9d0fab887d55c4c1513e56dc08cfec8df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b438aa65a8e95844b5304d3f6efecee5e1843373e03bab6142e212bd203f1ca4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野上 奈々","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-nat