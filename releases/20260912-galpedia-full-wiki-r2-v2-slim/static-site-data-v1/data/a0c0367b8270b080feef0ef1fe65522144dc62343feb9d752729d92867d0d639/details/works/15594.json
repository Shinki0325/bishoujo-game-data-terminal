ata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"両親ともに狼男・狼女の、生粋の人狼族。"},{"spoiler":false,"text":"ユリィはそんな人狼族の娘で、今が一番美しく、そして元気な年頃。"},{"spoiler":false,"text":"近々、人生初めての発情期を迎えつつある、まさに〈お年頃〉。"},{"spoiler":false,"text":"人狼族にとって、発情期を迎えることは大人になった証拠であり、初めての発情期に特定のパートナーがいることは最高の幸せとされている。"},{"spoiler":false,"text":"そんな身体の成熟という〈大人の階段〉を上ると同時に、初発情期に素敵な出会いがやってこないだろうか、と夢見ている、まさに青春真っ只中の女の子。"}],"source":"egs","sourceCharacterId":"9950","sourceWorkId":"15594","spoiler":false},{"segments":[{"spoiler":false,"text":"愛称は ユリィ。 両親ともに狼男・狼女の生粋の人狼族。"},{"spoiler":false,"text":"今が一番美しく、そして元気な時期。近々人生初めての発情期を迎えつつある、まさに “お年頃”。"},{"spoiler":false,"text":"人狼族にとって発情期を迎えることは大人になった証拠であり、初めての発情期に特定のパートナーがいることは最高の幸せとされている。"},{"spoiler":false,"text":"そんな身体の成熟という “大人の階段” を上ると同時に、初発情期に素敵な出会いがやってこないだろうかと夢見ている、まさに青春真っ只中の女の子。"}],"source":"bangumi","sourceCharacterId":"93689"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09b27d206f862799d468e357ecdce4e4709aed4d72f9319f826bb0294147f859.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acf8d087aadc9658ee710fce0c0ef85e7b2a5d7bb08ebe722bc2eda0b1a79255.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23607:93689:7169:1","source":"bangumi"}]},{"characterId":"char_c18906","characterName":"クーリウス・メルダイン","sourceIds":{"bangumi":[{"characterId":"93690","match":"exact-normalized-name-in-linked-work","subjectId":"23607"}],"egsCharacterIds":["9951"],"vndbCharacterId":"c18906"},"originalCharacterName":"クーリウス・メルダイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-