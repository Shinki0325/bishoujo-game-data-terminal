xt":"恋人の主人公と同棲をスタートし、苦手だった家事も頑張ろうと奮闘中。"}],"source":"egs","sourceCharacterId":"109","sourceWorkId":"10083","spoiler":false},{"segments":[{"spoiler":false,"text":"文月文芸学園の1年生。主人公と同級生。彼女。"},{"spoiler":false,"text":"実家は、何の変哲も無い古本屋。一人暮らしがしたくて、あえて遠方の学園「文月文芸学園」に入学。"},{"spoiler":false,"text":"映研には比較的映画が好きだったので何となくサークルを覗いた所、そこに居合わせた会長に捕まり済し崩し的に入部させられてしまうが後悔はしていない。"},{"spoiler":false,"text":"竜也をサポートするため、不得意だった家事炊事などを克服しようと、がんばって身につけ始める。"}],"source":"bangumi","sourceCharacterId":"204067"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"109","sourceWorkId":"10083","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"109","sourceWorkId":"10083","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"109","sourceWorkId":"10083","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"109","sourceWorkId":"10083","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07a581fe379bccce7bcc9d475914e47dc52e6d3fc04a594e4db7330020e8c9b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ab498241b06c0147d18bff3d48474ed495d11bc4b7dc675c0e20a1634f7cb83.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267720:204067:5741:1","source":"bangumi"}]},{"characterId":"char_c73253","characterName":"水口 夏海","sourceIds":{"bangumi":[{"characterId":"204068","match":"exact-normalized-name-in-linked-work","subjectId":"267720"}],"egsCharacterIds":["110"],