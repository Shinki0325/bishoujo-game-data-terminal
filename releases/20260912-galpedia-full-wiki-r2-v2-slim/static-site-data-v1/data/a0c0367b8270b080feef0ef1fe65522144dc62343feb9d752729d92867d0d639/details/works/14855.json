"relationId":"egs:work-creator:93655","source":"egs"},{"creditedName":"内山 涼介","creatorId":"vndb:s3170","sourcePersonId":"vndb:s3170","canonicalEntityId":"vndb:s3170","name":"内山 涼介","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:65168","source":"vndb"},{"creditedName":"桃梨","creatorId":"vndb:s9125","sourcePersonId":"vndb:s9125","canonicalEntityId":"vndb:s9125","name":"桃梨(歌手)","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:65171","source":"vndb"}]},"cast":[{"characterId":"char_c22051","characterName":"香月 涼花","sourceIds":{"bangumi":[{"characterId":"144432","match":"exact-normalized-name-in-linked-work","subjectId":"14068"}],"egsCharacterIds":["10670"],"vndbCharacterId":"c22051"},"originalCharacterName":"香月 涼花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本名は『猿飛佐助』。真田家に仕えていた忍者、真田十勇士の1人。"},{"spoiler":false,"text":"義理堅く、使命に忠実で真面目な性格で厳しいながらも優しく、主人公「翔一」の力になろうとする、母性と父性を併せ持った少女。"},{"spoiler":false,"text":"助けてくれた翔一の元に居候することになるが、現代の常識に当てはまらない行動をするため、トラブルを巻き起こしてしまうこともしばしば。"},{"spoiler":false,"text":"しかし、後の世にも語られるだけあり、忍びとしての実力は折り紙付き。"}],"source":"egs","sourceCharacterId":"10670","sourceWorkId":"14855","spoiler":false},{"segments":[{"spoiler":false,"text":"突如学園に出現した女の子。猿飛佐助を名乗っていた。"},{"spoiler":false,"text":"義理堅く、使命に忠実で真面目な性格であるが、現代常識に乏しいため変なトラブルを起こすことも。"},{"spoiler":false,"text":"縁が重なり翔一の家に居候して、彼の教育係となる。"},{"spoiler":false,"text":"厳しいながらも優しく、母性と父性を併せ持って翔一の力になろうとする。"},{"spoiler":false,"text":"武器：忍者刀、他"},{"spoiler":false,"text":"戦椿符：『流星光（りゅうせいこう）』"},{"spoiler":false,"text":"雷の力を宿した戦椿符。雷を放射しての攻撃はもちろん、物質に帯電させることも可能。"},{"spoiler":false,"text":"涼花自身が持つ雷の忍法の力を増幅させる働きもある。"},{"spoiler":false,"text":"「この戦、ただでは終わらないでしょう。だからこそ私はここに呼ばれたのかもしれません」"}],"source":"bangumi","sourceCharacterId":"144432"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3ffebc82fa22be0f13f08c29cbb71c6e8068f9bd70d6b966fe53496ff9341bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53856c61b9ea36cb26c70a4055ceb33225ca06297759006a6806b0a1a0a8be00.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14068:144432:6038:1","source":"bangumi"}]},{"characterId":"char_c22062","characterName":"千賀 成美","sourceIds":{"bangumi":[{"characterId":"144434","match":"exact-normalized-name-in-linked-work","subjectId":"14068"}],"egsCharacterIds":["10672"],"vndbCharacterId":"c22062"},"originalCharacterName":"千賀 成美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"雷公学園1年生。2年生である主人公「翔一」にとっては後輩にあたる存在。"},{"spoiler":false,"text":"自称『服部半蔵の生まれ変わり』という、なんとも夢見がちな女の子。"},{"spoiler":false,"text":"しかし当然、誰もそんなことを信じるわけがなくよく呆れられているが、『もしかして本当に？』と思わせる言動も時折見せることがあるようなないような。"},{"spoiler":false,"text":"普段の性格は、色んな人から“子犬のようだ”と称される程、裏表のない素直で 良い子。"},{"spoiler":false,"text":"喜怒哀楽の変化が非常に激しく、ころころ表情が変わるので皆からはペット 扱いされている。"},{"spoiler":false,"text":"身体能力は特筆すべきものはないが、勘や感覚は非常に優れている。"},{"spoiler":false,"text":"自身の戦法は、忍術とボクシングを組み合わせたまったく新しい格闘技だと訴えているが、周囲からは、疑問と傍観交じりの生暖かい視線で見守られている。"}],"source":"egs","sourceCharacterId":"10672","sourceWorkId":"14855","spoiler":false},{"segments":[{"spoiler":false,"text":"自称・服部半蔵の生まれ変わり の後輩。"},{"spoiler":false,"text":"当然、誰もそんなことを信じるわけがないが、時々、本当にそうかと思わせる言動を見せる。"},{"spoiler":false,"text":"子犬のようだと形容されるほど素直で、夢見がち。"},{"spoiler":false,"text":"コロコロ表情が変わるので皆からは （妄言を吐くこと以外は） 可愛がられている。"},{"spoiler":false,"text":"武器：手甲"},{"spoiler":false,"text":"戦椿符：『ワイルド・ファング』"},{"spoiler":false,"text":"熱の力を宿した戦椿符。発動させることで一定時間、身体能力を上昇させる。"},{"spoiler":false,"text":"また、使いこなすことで拳や瞳に炎を宿すようになる。"},{"spoiler":false,"text":"この能力によって、本物の忍者に肉薄する力を得ることが出来るが、副作用として非常にお腹が空く。"},{"spoiler":false,"text":"「熱き心は獣を焦がし！　秘める想いは敵を討つ！　忍びの魂、胸に秘め……雷公学園1年生・千賀成美、参ります！」"}],"source":"bangumi","sourceCharacterId":"144434"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d291ed0b1535237d0de27c9eb45d40cd921b436254283f814e9f5ba93f1c0c1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01295e812c0911e3c40eeb09ade3f64107edcbcc54681a6324a00c609a4737e5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14068:144434:13512:1","source":"bangumi"}]},{"characterId":"char_c44198","characterName":"風間 ことり","sourceIds":{"bangumi":[{"characterId":"144433","match":"exact-normalized-name-in-linked-work","subjectId":"14068"}],"egsCharacterIds":["10671"],"vndbCharacterId":"c44198"},"originalCharacterName":"風間 ことり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世襲制で脈々と継がれてきた『風魔小太郎』一族の、26代目頭領。"},{"spoiler":false,"text":"主人公の幼馴染みであり、普段は忍者であることを隠して生活している。"},{"spoiler":false,"text":"その外見にと口数の少なさが相まってクールビューティとして見られがちであるが、本当は口下手で、人見知りで弱気な女の子である。"},{"spoiler":false,"text":"主人公「翔一」の幼馴染であり、ずっと想い続けているが、忍者にとって一般人との 色恋沙汰は御法度なので、微妙な関係のままでいる。"},{"spoiler":false,"text":"科学と技の融合を果たした、現代に生きる忍者として高い能力を発揮する。"}],"source":"egs","sourceCharacterId":"10671","sourceWorkId":"14855","spoiler":false},{"segments":[{"spoiler":false,"text":"翔一の幼なじみ。友達以上恋人未満。"},{"spoiler":false,"text":"その外見と口数の少なさからクールに見られがちだが、本当は口下手で人見知りする弱気な女の子。"},{"spoiler":false,"text":"忍者であることをずっと隠していたが、翔一の危機についに正体を明かしてしまった。"},{"spoiler":false,"text":"科学と技の融合を果たした、現代に生きる忍者として高い能力を発揮する。"},{"spoiler":false,"text":"武器：拳銃、他"},{"spoiler":false,"text":"戦椿符：『あやめ鳥』"},{"spoiler":false,"text":"風の力を宿した戦椿符。攻撃手段の他、風を纏うことで光を屈折させて姿を隠したり、圧縮させた空気を防御に回すことも出来る。"},{"spoiler":false,"text":"ことりが得意とする風の忍法の力を増幅させる働きもある。"},{"spoiler":false,"text":"「うん……。その……。風魔小太郎って……知ってるよね？　実はボク、26代目」"}],"source":"bangumi","sourceCharacterId":"144433"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/348aaae1a7f42bef5f37f38bd35fa270bd73a7816f264204eae9dfd247151f65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04e4e819baace33eea574a6afbfd83caecc5d246773709d0f1dc2c467dacdcc5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14068:144433:4463:1","source":"bangumi"}]},{"characterId":"char_c44199","characterName":"松尾 芭蕉","sourceIds":{"bangumi":[{"characterId":"144435","match":"exact-normalized-name-in-linked-work","subjectId":"14068"}],"egsCharacterIds":["10673"],"vndbCharacterId":"c44199"},"originalCharacterName":"松尾 芭蕉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"数々の俳句を残した、有名な俳人と同姓同名の女教師。"},{"spoiler":false,"text":"学園長とも古くから面識があり、学園開校時に赴任した。"},{"spoiler":false,"text":"普段は保健室の先生として学生らを癒すかたわら、非常勤で古典も教える名物教師。"},{"spoiler":false,"text":"だがその姿はあまりに幼く、学生やそれ以下の子供と間違えられることもあるものの、中身はれっきとした大人。ただし少々、口が悪い。"},{"spoiler":false,"text":"そんなギャップがまた微笑ましいのか、学生達にはよくからかわれている。"},{"spoiler":false,"text":"大会中は救護班を担当、怪我人の治療やリタイヤした選手の保護などを行っている。"}],"source":"egs","sourceCharacterId":"10673","sourceWorkId":"14855","spoiler":false},{"segments":[{"spoiler":false,"text":"普段は保健室の先生として学生らを癒すかたわら、非常勤で古典も教える名物教師。"},{"spoiler":false,"text":"中身はれっきとした大人だが、少々口が悪い。"},{"spoiler":false,"text":"そんなギャップがまた微笑ましいのか、学生たちにはよくからかわれている。"},{"spoiler":false,"text":"大会中は救護班を担当、怪我人の治療などを行っている。"},{"spoiler":false,"text":"武器：錫杖"},{"spoiler":false,"text":"戦椿符：『月下美人』"},{"spoiler":false,"text":"花の力を宿した戦椿符。対象の傷口に触れることでそれを治癒する。"},{"spoiler":false,"text":"逆に相手の成長を遅延させ、回復を遅らせることも可能。"},{"spoiler":false,"text":"命刻祭の救護班として、これ以上なく相応しい能力である。"},{"spoiler":false,"text":"「稲妻に悟らぬ人の貴さよ……、か」"}],"source":"bangumi","sourceCharacterId":"144435"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8275f8c0196dbeabd1dd1c60832d3f0acd4b194a0b969c32c0c6f010914676b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2ad88c5167eb4c854d3d3391f163b2006f1c6a9c9f1f0e013ecbf1f1fbac49d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14068:144435:6106:1","source":"bangumi"}]},{"characterId":"char_c44200","characterName":"藤林 長門","sourceIds":{"bangumi":[{"characterId":"144436","match":"exact-normalized-name-in-linked-work","subjectId":"14068"}],"egsCharacterIds":["10676"],"vndbCharacterId":"c44200"},"originalCharacterName":"藤林 長門","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦国時代、伊賀の里の頭目と言われた忍者『藤林長門守（ふじばやし ながとのかみ）』とほぼ同じ名前を持つ歴史教師。"},{"spoiler":false,"text":"学園創設当初より美人教師として親しまれており、翔一のクラスの担任。"},{"spoiler":false,"text":"セクシーな肢体に、メガネがチャームポイント。"},{"spoiler":false,"text":"どこかのんびりした雰囲気だが、今大会の運営にも携わっており、学生会の指導者でもある。"},{"spoiler":false,"text":"なにかと理由を付けて学生会を翔一たちにぶつけ、時には自らも手を下すなど、戦いを煽っている節がある。"},{"spoiler":false,"text":"その真意は、今回の大会の陰謀に深く関わることだという。"}],"source":"egs","sourceCharacterId":"10676","sourceWorkId":"14855","spoiler":false},{"segments":[{"spoiler":false,"text":"美人教師として親しまれる翔一の担任。"},{"spoiler":false,"text":"セクシーな肢体に、メガネがチャームポイント。"},{"spoiler":false,"text":"どこかのんびりした雰囲気だが、今大会の運営にも携わっており学生会の指導者でもある。"},{"spoiler":false,"text":"武器：鎖鎌"},{"spoiler":false,"text":"戦椿符：『日月星（じつげつせい）』"},{"spoiler":false,"text":"光を収束したレーザー攻撃を放つことも出来るが、藤林先生は主に得意の瞳術に応用している。"},{"spoiler":false,"text":"他者が視ているものを自分も視たり、複数人の視界をシャッフルさせて幻惑するといった術法を使う。"},{"spoiler":false,"text":"「あーん、見てないで助けてよーっ！　見て見ぬふりなんてひどいわーっ！」"}],"source":"bangumi","sourceCharacterId":"144436"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a20ea4568505717b13415d7c73b5c80511fe16272dd34a108830bcbf6d12c79d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fca1c11fd4f0b35263c07bca8620c37799681fd18c7b07e734921a55072fe78b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永見はるか","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14068:144436:4674:1","source":"bangumi"}]},{"characterId":"char_c44201","characterName":"石川 藤子","sourceIds":{"bangumi":[{"characterId":"144437","match":"exact-normalized-name-in-linked-work","subjectId":"14068"}],"egsCharacterIds":["10675"],"vndbCharacterId":"c44201"},"originalCharacterName":"石川 藤子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本名は『石川五右衛門（いしかわ　ごえもん）』。"},{"spoiler":false,"text":"猿飛佐助と同じく、過去からやってきたと名乗る伊賀忍出身の泥棒。自称義賊。"},{"spoiler":false,"text":"現代にやってきた時期は猿飛佐助よりも早く、それなりに現代に馴染んでいるが、盗み癖だけは直っていない。"},{"spoiler":false,"text":"師匠である百地三太夫と瓜二つの少女を見つけ、 ほぼ一方的に友好関係を結び、「モモちゃん」と親しげに呼んでいる。"},{"spoiler":false,"text":"彼女を喜ばせるために盗みをしたりしているが、結局はいい迷惑となるのが日常。"},{"spoiler":false,"text":"泥棒ゆえ即物的であると思われがちだが、なかなか粋な面もあるにはある。"},{"spoiler":false,"text":"学生会として藤林の指示通りに翔一たちの前に立ち塞がり、得意の窃盗術で翔一らを翻弄する。"}],"source":"egs","sourceCharacterId":"10675","sourceWorkId":"14855","spoiler":false},{"segments":[{"spoiler":false,"text":"過去からやってきたと言い張る自称義賊。"},{"spoiler":false,"text":"百地理保子を 「モモちゃん」 と親しげに呼び、彼女を喜ばせるために盗みをしては怒られている。"},{"spoiler":false,"text":"理保子と共に命刻祭に参加し、得意の窃盗術で翔一らを翻弄する。"},{"spoiler":false,"text":"武器：ふろしき"},{"spoiler":false,"text":"戦椿符：『浮舟』"},{"spoiler":false,"text":"雲の力を宿した戦椿符。自在に雲を発生させ、姿はもちろん気配も完全に隠すことが可能。"},{"spoiler":false,"text":"また、精神を統一すれば雲に乗って移動することも出来る。"},{"spoiler":false,"text":"使いこなせば、狭い範囲ながら天候をも操る。"},{"spoiler":false,"text":"「にゃははははっ、盗んでドッキリ大成功～っ！」"}],"source":"bangumi","sourceCharacterId":"144437"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43dee140eda0b394d93812c4a8e6edf03ff3debeb68ddf0f4889c7ffe1c17c98.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b64c7566c08c8d327b0a3502a80c0b66e5a360dfbb769527fe65ef1e118b5925.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14068:144437:5907:1","source":"bangumi"}]},{"characterId":"char_c44202","characterName":"百地 理保子","sourceIds":{"bangumi":[{"characterId":"144438","match":"exact-normalized-name-in-linked-work","subjectId":"14068"}],"egsCharacterIds":["10674"],"vndbCharacterId":"c44202"},"originalCharacterName":"百地 理保子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"雷公学園二年で、学生会会長。"},{"spoiler":false,"text":"戦国時代において、石川五右衛門に酷い目に遭わされてきた忍『百地三太夫』の末裔。"},{"spoiler":false,"text":"しかしながら、非常識な他の面々の中で、唯一の常識人。"},{"spoiler":false,"text":"石川五右衛門の巻き起こす騒動のために、いつも酷い目に遭い、彼女をうざがっている。"},{"spoiler":false,"text":"が、端から見ると非常に仲がよく見える。"},{"spoiler":false,"text":"怒るときに、ちょっと古くさい文句が飛び出るのが特徴。"},{"spoiler":false,"text":"藤林の指示とは別に、個人の判断でも翔一らを追いかけるようになっていく。"},{"spoiler":false,"text":"能力は一般人と大差ないが、石川との連携は中々のもの。"}],"source":"egs","sourceCharacterId":"10674","sourceWorkId":"14855","spoiler":false},{"segments":[{"spoiler":false,"text":"雷公学園の学生会長。"},{"spoiler":false,"text":"非常識な他の面々の中で、唯一の常識人で苦労人。藤子のせいでいつも騒動に巻き込まれている。"},{"spoiler":false,"text":"学生会の代表として、命刻祭の秩序のために参加し、ルール違反の私闘などを取り締まっている。"},{"spoiler":false,"text":"能力は一般人と大差ないが、藤子との連携はなかなか。"},{"spoiler":false,"text":"武器：木刀"},{"spoiler":false,"text":"戦椿符：『銀嶺（ぎんれい）』"},{"spoiler":false,"text":"氷の力を宿した戦椿符。冷気を発して物体を氷結させる。"},{"spoiler":false,"text":"物体の運動を停止させるなどのことも可能で、これを応用することで足を壁などに貼り付けて歩いたり、攻撃を食い止めることが出来る。"},{"spoiler":false,"text":"「ふ、ふざけんじゃないわよ、このうすらとんかち！」"}],"source":"bangumi","sourceCharacterId":"144438"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b594c183c433e7b9c501d29613c7413f74fe14f0fa0cfdf4558d6487e6dd1a4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa33da87eb4fabc7983d0a415f69b2e510e2855a4c6e04fb132b99671f8ee63a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14068:144438:5905:1","source":"bangumi"}]},{"characterId":"char_c91245","characterName":"加藤 翔一","sourceIds":{"bangumi":[{"characterId":"221369","match":"exact-normalized-name-in-linked-work","subjectId":"14068"}],"egsCharacterIds":["10677"],"vndbCharacterId":"c91245"},"originalCharacterName":"加藤 翔一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"表面的にはごく普通の学園生。"},{"spoiler":false,"text":"普通の学生らしく振舞いながら、内心では他愛のない空想などに思いを馳せては、現実と比較して漠然と現実はつまらないなーという感情を持ち続けていた。"},{"spoiler":false,"text":"涼花との出会いや、幼馴染のカミングアウトなど、訳の分からない騒動に次々に巻き込まれていくことになる。"},{"spoiler":false,"text":"ところが、その騒動が彼の空想に近かったことから、やがては無自覚に事態を楽しむようになっていき、まるで水を得た魚のように元気になっていく。"},{"spoiler":false,"text":"幼い頃、忍者に憧れていた時期があり、その方面の知識は残っており、基本的な忍術理論も知っているし、身体を鍛えていた時期もある。"},{"spoiler":false,"text":"地に足がつかず、どこか浮いているような様子から、周囲の人間からは「トンビのカトちゃん」とあだ名で呼ばれていた。"}],"source":"egs","sourceCharacterId":"10677","sourceWorkId":"14855","spoiler":false},{"segments":[{"spoiler":false,"text":"ごく普通の学園生。"},{"spoiler":false,"text":"他愛ない空想に思いを馳せては、現実と比較して落胆していたが、命刻祭でそれも終わる。"},{"spoiler":false,"text":"わけの分からない騒動に次々と巻き込まれていく中、その騒動が己の空想に近かったことから無自覚に事態を楽しむようになり、水を得た魚のように元気になっていく。"},{"spoiler":false,"text":"武器：トンファー"},{"spoiler":false,"text":"戦椿符：『不明』"},{"spoiler":false,"text":"翔一は、命刻祭開催前に戦椿符を紛失してしまっている。そのため、本来は参加できなかったはずなのであるが……。"},{"spoiler":false,"text":"翔一の戦椿符は、参加者の誰かが持っているはず。"},{"spoiler":false,"text":"「なんでボクの周りで、こう変なことが続くんだよ！」"}],"source":"bangumi","sourceCharacterId":"221369"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16e9785b41443cb687443aba867d75138d7a2bb0da2247b9c278ad1f4317357c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da3223bf26f6fe27cb67d651599471b7c707a758a2583ae67272f15896bade28.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1225","sourceCompanyId":"egs:brand:2854","canonicalEntityId":"vndb:p1225","name":"tritail","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14855:2854","source":"egs"},{"companyId":"vndb:p302","sourceCompanyId":"vndb:p302","canonicalEntityId":"vndb:p302","name":"ninetail","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107949:v6539","source":"vndb"},{"companyId":"vndb:p1225","sourceCompanyId":"vndb:p1225","canonicalEntityId":"vndb:p1225","name":"トライテイル","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:15403:v6539","source":"vndb"},{"companyId":"vndb:p1225","sourceCompanyId":"vndb:p1225","canonicalEntityId":"vndb:p1225","name":"トライテイル","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:57747:v6539","source":"vndb"},{"companyId":"vndb:p302","sourceCompanyId":"vndb:p302","canonicalEntityId":"vndb:p302","name":"ninetail","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:73407:v6539","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
