65","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"18709","sourceWorkId":"10465","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"18709","sourceWorkId":"10465","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"18709","sourceWorkId":"10465","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42c2fa8a4595af9347b7479cd5fc4a7aabb74c06dad2df3363b8d9f963e92129.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a3803e43d3c490c3c250085468f53a3f8b226106f08acb216338ef01c60ff6a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星野千寿子","creatorId":"vndb:s128","sourcePersonId":"vndb:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271178:92782:4210:1","source":"bangumi"}]},{"characterId":"char_c33025","characterName":"賀曽利 優子","sourceIds":{"bangumi":[{"characterId":"92783","match":"exact-normalized-name-in-linked-work","subjectId":"271178"}],"egsCharacterIds":["18710"],"vndbCharacterId":"c33025"},"originalCharacterName":"賀曽利 優子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vice-President of the Student Council, who has an efficient and precise brain like a computer. She does most of the student council work alone and has a cool atmosphere. Yuuko is called \"Razor Yuuko\" because of her relentless and strict response and is feared by the other students."}],"source":"vndb","sourceCharacterId":"c33025"},{"segments":[{"spoiler":false,"text":"コンピュータのように効率的かつ緻密な頭脳を持つ、学生会副会長。"},{"spoiler":false,"text":"学生会の仕事をほとんど一人でこなし、またクールな雰囲気と容赦ない厳格な対応から「カミソリ優子」と呼ばれ、学生たちから恐れられている。"},{"spoiler":false,"text":"皐月と拓巳の恋のキューピット役として、二人の背中を後押しし、以後、友人として二人と付き合ってきたが、最近、いけないと思いつつも拓巳に想いを寄せるようになり……。"},{"spoiler":false,"text":"「あなたは十分すぎるくらい、私の力になってくれたわ……。これ以上、よくされたら、私……」"}],"source":"egs","sourceCharacterId":"18710","sourceWorkId":"10465","spoiler":false},{"segments":[{"spoiler":false,"text":"桜台学園の三年生で学生会副会長。コンピューターのように効率的かつ緻密な頭脳のも持ち主で、学生会のほとんどの仕事をひとりで処理しているらしい。"},{"spoiler":false,"text":"そのクールな言動や雰囲気ならびに、容赦のない厳格な対応から、カミソリ優子と呼ばれ多くの学生達から恐れられている。 拓己と皐月が付き合うことなった時は、二人の背中を押し、恋のキューピッド役を果たした。"},{"spoiler":false,"text":"以降、皐月と拓己は学生会の仕事を手伝うようなり、友人として付き合っている。"},{"spoiler":false,"text":"学生会の仕事を通して、いけないことと思いつつも拓己に想いを寄せてしまう。"}],"source":"bangumi","sourceCharacterId":"92783"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"18710","sourceWorkId":"10465","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"18710","sourceWorkId":"10465","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"18710","sourceWorkId":"10465","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"18710","sourceWorkId":"10465","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dc600beefcbfc958b18715a8ca9439dfcbe5d7009348ccad83da047dd56317a.webp","fallbackUrl":