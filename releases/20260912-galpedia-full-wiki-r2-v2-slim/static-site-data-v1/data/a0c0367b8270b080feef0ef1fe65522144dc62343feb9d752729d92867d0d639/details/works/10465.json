,"identityStatus":"source-native","relationId":"vndb:vn-staff:7090","source":"vndb"},{"creditedName":"東雲 一彦","creatorId":"vndb:s2263","sourcePersonId":"vndb:s2263","canonicalEntityId":"vndb:s2263","name":"東雲 一彦","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:7094","source":"vndb"},{"creditedName":"kanoko","creatorId":"vndb:s43203","sourcePersonId":"vndb:s43203","canonicalEntityId":"vndb:s43203","name":"kanoko","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:7097","source":"vndb"}]},"cast":[{"characterId":"char_c33015","characterName":"霧島 深月","sourceIds":{"bangumi":[{"characterId":"92778","match":"exact-normalized-name-in-linked-work","subjectId":"271178"},{"characterId":"92778","match":"exact-normalized-name-in-linked-work","subjectId":"271179"}],"egsCharacterIds":["18707"],"vndbCharacterId":"c33015"},"originalCharacterName":"霧島 深月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takumi's neighbor and childhood friend, Mizuki is cheerful and active, she teaches swimming lessons at the local pool. She has a habit of waking up Takumi every day."}],"source":"vndb","sourceCharacterId":"c33015"},{"segments":[{"spoiler":false,"text":"深月の妹。拓己とは幼なじみかつクラスメイトで、なんでも気軽に話せる親友のような関係をお互いに築いている。"},{"spoiler":false,"text":"人生適当をモットーに日々遊びまくる、お気楽少女。好奇心旺盛かつ悪戯好きな性格で、よく姉の深月や拓己をからかって楽しんでいる……らしい。"},{"spoiler":false,"text":"霧島重工の社長令嬢だが、下品なシモネタを平気で口にしたり、人前であぐらをかいたりと、おおよそ令嬢らしくない行動や言動が目立つ。"},{"spoiler":false,"text":"ただ、その破天荒な行動や言動は、一部の学生（生徒会関係者。特に風紀委員）からは快く思われていない。"},{"spoiler":false,"text":"ちなみにかなりのゲーマーで、駅前のゲーセンに集うゲーマーたちからは「無敵ちゃん」or「コールドインビンシブル」などと呼ばれ、一目置かれている。"},{"spoiler":false,"text":"「へへ～、朝っぱらから両手に花とは……うひひ、もう拓ちゃんのス・ケ・ベ！」"}],"source":"egs","sourceCharacterId":"18707","sourceWorkId":"8435","spoiler":false},{"segments":[{"spoiler":false,"text":"お隣に住んでいる、年上だが気さくな幼馴染。"},{"spoiler":false,"text":"明るく活発、運動神経抜群、おまけに大企業の社長令嬢というお嬢様だが、お姉ちゃんぶって拓巳にあれこれ世話を焼くのが好きらしい。"},{"spoiler":false,"text":"意外とドジで不器用な面、要領の悪い所があり、家事全般の細かい作業と、恋愛ごとが苦手。"},{"spoiler":false,"text":"「拓巳、朝よ。ほら、そろそろ起きないと遅刻しちゃうわよ」"}],"source":"egs","sourceCharacterId":"18707","sourceWorkId":"10465","spoiler":false},{"segments":[{"spoiler":false,"text":"隣に住んでいる年上の幼なじみで、大学の二年生。"},{"spoiler":false,"text":"明るく活発な性格で、拓己に対しては何かとお姉ちゃんぶって、あれこれ世話を焼いている。"},{"spoiler":false,"text":"運動神経は抜群だが、不器用で要領の悪いところがあり、家事等の細かい作業、ならびに恋愛ごとは苦手。あと意外とドジ。"},{"spoiler":false,"text":"世界的な企業である霧島重工の社長令嬢だが、本人はそのことを鼻にかけるようことはしない。またそういう雰囲気を感じさせない気さくな人柄の持ち主。"}],"source":"bangumi","sourceCharacterId":"92778"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"18707","sourceWorkId":"10465","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"18707","sourceWorkId":"10465","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"18707","sourceWorkId":"10465","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"18707","sourceWorkId":"10465","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f4d2394fd27ab1fe710ee2983b00a366142fd95accac2fc27174f149afa5b0a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b4c89353778990d7d4e3e1c12e5e63dd5fde2f777ca412788527791aeb9e1ab.web