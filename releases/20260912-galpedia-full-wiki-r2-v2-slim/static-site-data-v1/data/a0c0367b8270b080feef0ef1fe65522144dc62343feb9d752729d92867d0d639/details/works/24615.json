36"}],"egsCharacterIds":["14229"],"vndbCharacterId":"c64561"},"originalCharacterName":"神宮 アキラ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女になってしまったせいか、色々と吹っ切れている。"},{"spoiler":false,"text":"だが、基本はネガティブ。"},{"spoiler":false,"text":"ある日突然女にされて今までの自分と分断された為パニックを起こすも、一人になると性別を忘れてプライベートを満喫してしまうところあたりはマイペース。"},{"spoiler":false,"text":"取り敢えずは、寝て起きたら女になってて突然自分の嫁にする！と宣言されて、夜の生活方面にゾクゾクしながらもどうにか前向きに満喫しようとはする。"}],"source":"egs","sourceCharacterId":"14229","sourceWorkId":"24615","spoiler":false},{"segments":[{"spoiler":false,"text":"ある日突然女にされてしまった側の主人公。"},{"spoiler":false,"text":"基本的にはネガティブだが、女になったこともあり色々と吹っ切れている。"},{"spoiler":false,"text":"一人になるとプライベートを満喫しようとするマイペースさは変わっていない。"},{"spoiler":false,"text":"夜の生活方面にゾクゾクしながらも、どうにか前向きに楽しもうと考えている。"}],"source":"bangumi","sourceCharacterId":"89022"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55618c090474c6db1706cd6bc7fc42b691110860aff6556d5dd0a4c2a18aac7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2215b12363a3005ed267ce58ebb82a220e5f4c4826eed5d7a93c09e6f1a582ac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73012","source":"vndb"}]},{"characterId":"char_c64562","characterName":"観月 詩織","sourceIds":{"bangumi":[{"characterId":"89023","match":"exact-normalized-name-in-linked-work","subjectId":"207736"}],"egsCharacterIds":["16749"],"vndbCharacterId":"c64562"},"originalCharacterName":"観月 詩織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アキトの幼馴染みで負けん気が強いお姉さん。"},{"spoiler":false,"text":"基本的に性癖は男よりのバイで、案外縛りはなく奔放。"},{"spoiler":false,"text":"一見サバサバした性格だが、想えば一途なところもある。"}],"source":"egs","sourceCharacterId":"16749","sourceWorkId":"24615","spoiler":false},{"segments":[{"spoiler":false,"text":"疎遠になっていた幼なじみ。"},{"spoiler":false,"text":"幼少期は一緒に遊ぶことも多かったが、互いに恋愛対象としは見ていなかった。"},{"spoiler":false,"text":"高校生の頃から男女交際を重ねたものの、結婚に至るまでの出会いは0。"},{"spoiler":false,"text":"性癖は大らかで、男性寄りのバイセクシャル。"},{"spoiler":false,"text":"一見サバサバした性格だが、恋に落ちると一途なところも。"}],"source":"bangumi","sourceCharacterId":"89023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0de304e831bb86e6a28839bfb5733d7156c467189f68b5d57cbfdf02071bc97f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/458b17feb585e0c9a9caf0a6a2050e86e593b987427a27e2a53469ad38e75914.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Raica","creatorId":"vndb:s5100","sourcePersonId":"vndb:s5100","canonicalEntityId":"vndb:s5100","name":"Raica","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73013","source":"vndb"}]},{"characterId":"char_c69972","characterName":"神宮 アキト","sourceIds":{"bangumi":[{"characterId":"89269","match":"exact-normalized-name-in-linked-work","subjectId":"207736"}],"egsCharacterIds":["14230"],"vndbCharacterId":"c69972"},"originalCharacterName":"神宮 アキト","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"27歳童貞、彼女いない歴＝年齢。"},{"spoiler":false,"text":"魔法使いも目前に迫った感漂うプログラマー"},{"spoiler":false,"text":"人間付き合いが面倒くさくて結婚を諦めてはいたが政府公認のクローニングに、駄目元で応募してみると申込者が少なかった為、クローン少女＝自分を作ることに。"},{"spoiler":false,"text":"何も期待はしていなかったのだが、脳内構築で眠る幼少期に似た自分の姿が可愛くて、彼女を嫁にすると決めてしまったのだった。"}],"source":"egs","sourceCharacterId":"14230","sourceWorkId":"24615","spoiler":false},{"segments":[{"spoiler":false,"text":"27歳童貞、彼女いない歴＝年齢。 魔法使いも目前に迫った感漂うプログラマー。"},{"spoiler":false,"text":"人付き合いが面倒で結婚も諦めていたが、政府公認のクローニングに応募したら"},{"spoiler":false,"text":"当選してしまい、クローン少女＝自分 を作ることに。"},{"spoiler":false,"text":"何も期待はしていなかったが、思いのほか可愛かった自分を嫁に決めてしまう。"}],"source":"bangumi","sourceCharacterId":"89269"}],"profileFacts":[{"label":"年龄（本版本）","value":"27 岁","valueContext":null,"source":"egs","sourceCharacterId":"14230","sourceWorkId":"24615","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c03c1d098518de3ecac5fe9b560762f5c50afda5396a2472ce3cf920d987acdc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14170d4a72f490570a7cc07c18b3a068abf11f8cb0bf7fb7b6e2d8452db7c0ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p529","sourceCompanyId":"egs:brand:1997","canonicalEntityId":"vndb:p529","name":"WendyBell","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:24615:1997","source":"egs"},{"companyId":"vndb:p529","sourceCompanyId":"vndb:p529","canonicalEntityId":"vndb:p529","name":"WendyBell","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:170531:v20679","source":"vndb"},{"companyId":"vndb:p529","sourceCompanyId":"vndb:p529","canonicalEntityId":"vndb:p529","name":"WendyBell","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:57204:v20679","source":"vndb"},{"companyId":"vndb:p529","sourceCompanyId":"