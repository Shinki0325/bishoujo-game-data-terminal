","name":"逢川奈々","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:113470","source":"vndb"}]},"cast":[{"characterId":"char_c44648","characterName":"大紅 翼","sourceIds":{"bangumi":[{"characterId":"53993","match":"exact-normalized-name-in-linked-work","subjectId":"116491"}],"egsCharacterIds":["5146"],"vndbCharacterId":"c44648"},"originalCharacterName":"大紅 翼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"身長：145cm、スリーサイズ： B75（B） / W53 / H79"},{"spoiler":false,"text":"“都亜”の妹。成績も運動も中の上、何もかもを平均よりちょっと上でこなす。"},{"spoiler":false,"text":"反面、特に秀でた何かがある訳でもなく努力してもうまくいかない。"},{"spoiler":false,"text":"成績優秀、運動神経バツグンな姉“都亜”と比べられがち。"},{"spoiler":false,"text":"何をやっても“都亜”には敵わず、劣等感を抱くようになる。"},{"spoiler":false,"text":"いつしか物事に熱中する事を諦めるようになり、ドライな性格になった。"},{"spoiler":false,"text":"それにより“都亜”に対して劣等感と苦手意識を持ってしまっている。"},{"spoiler":false,"text":"“都亜”に対して、心の奥底では憧れと親愛の情は抱いているのだが、苦手意識が先に立ち冷たく接してしまっている。"},{"spoiler":false,"text":"陰核が人より大きいのが悩み。"},{"spoiler":false,"text":"ある日、クリトリスにあたる部分がペニスに変わってしまう。"},{"spoiler":false,"text":"性知識・性への興味は共に薄い。オナニーは、週に１回もすればいいほう。"},{"spoiler":false,"text":"自慰行為のたびに軽い自己嫌悪を覚えてしまうタイプ。"},{"spoiler":false,"text":"なお、生えたペニスから出る精液？は甘くて美味しい。"},{"spoiler":false,"text":"甘さを控え目にしたマロン風味シロップのような味わい。"},{"spoiler":false,"text":"また、おしっこは女性器側についている尿道から出る。"}],"source":"egs","sourceCharacterId":"5146","sourceWorkId":"21011","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公である都亜の妹。 成績も運動も中の上、何もかもを平均よりちょっと上でこなす。"},{"spoiler":false,"text":"反面、特に秀でた何かがあるわけでもなく、努力してもうまくいかない。"},{"spoiler":false,"text":"成績優秀・運動神経バツグンな姉と比べられることが多く、劣等感から物事に熱中することを諦めてドライな性格になった。"},{"spoiler":false,"text":"都亜に対して本音では憧れと親愛の情を抱いているのだが、苦手意識が先に立ち冷たく接してしまっている。"},{"spoiler":false,"text":"陰核が人より大きいのが悩み。 ある日、クリトリスがペニスに変わってしまう。"},{"spoiler":false,"text":"性知識・性への興味は薄く、オナニーは週に1回するかしないか。"},{"spoiler":false,"text":"ペニスから出る精液？は甘くて美味しい。 また、おしっこは女性器側から出る。"}],"source":"bangumi","sourceCharacterId":"53993"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"5146","sourceWorkId":"21011","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"5146","sourceWorkId":"21011","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"5146","sourceWorkId":"21011","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"5146","sourceWorkId":"21011","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"5146","sourceWorkId":"21011","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c44648","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"5146","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"5146","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"53993","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67db2befdd449b45a3e585c157c25f7a7b02912e1200d4e1e20a76f39688cd6b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a4ec67bb30118cfb612c3d9697ea28efac264883b67ccc02cafdb2b6e30ee04.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"四ノ宮ひな","creatorId":"vndb:s6383","sourcePersonId":"vndb:s6383","canonicalEntityId":"vndb:s6383","name":"四ノ宮ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116491:53993:48851:1","source":"bangumi"}]},{"characterId":"char_c44649","characterName":"大紅 都亜","sourceIds":{"bangumi":[{"characterId":"53994","match":"exact-normalized-name-in-linked-work","subjectId":"116491"}],"egsCharacterIds":["5147"],"vndbCharacterId":"c44649"},"originalCharacterName":"大紅 都亜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"身長：158cm、スリーサイズ：B82（E） / W52 / H85"},{"spoiler":false,"text":"“翼”の姉。容姿端麗、学業優秀、スポーツ万能だが、それを全く鼻にかけていない。"},{"spoiler":false,"text":"あまり騒いだりもせず、落ち着いたお姉さまという印象を持たれている。"},{"spoiler":false,"text":"生徒会長への推薦などもあったが、断った。"},{"spoiler":false,"text":"現生徒会長を差し置いて、学生代表のような扱いを受けている。"},{"spoiler":false,"text":"なお、それらはすべて重度にこじらせたシスコンの影響でしかない。"},{"spoiler":false,"text":"自分が好成績だろうがスポーツ万能だろうがまったく興味はなく、そんな事に気を取られている暇があったら妹“翼”の事を考えていたい。"},{"spoiler":false,"text":"もちろん、生徒会長への推薦を断ったのは“翼”との時間を減らさないため。"},{"spoiler":false,"text":"いつも静かに“翼”の事ばかり考えており、落ち着いていると思われがち。"},{"spoiler":false,"text":"なお“翼”は“都亜”にあまり近づこうとしないのだが、“都亜”は家の中で“翼”と同じ空気を吸っているだけで幸せなので問題ない。"},{"spoiler":false,"text":"趣味は“翼”とイチャラブする妄想と自宅廊下に落ちている“翼”の体毛拾い。"},{"spoiler":false,"text":"外では自重しているが“翼”と２人きりだと性格が変わり、“翼”に猛烈アピールしていく。"},{"spoiler":false,"text":"性への興味は強く、知識もある。"},{"spoiler":false,"text":"しかしオナニーは週に２～３回もすればいいほう。"},{"spoiler":false,"text":"オカズはもちろん“翼”。処女。"}],"source":"egs","sourceCharacterId":"5147","sourceWorkId":"21011","spoiler":false},{"segments":[{"spoiler":false,"text":"翼の姉。 容姿端麗・学業優秀・スポーツ万能だが、それをまったく鼻に掛けていない。"},{"spoiler":false,"text":"落ち着いたお姉様という印象で、生徒会長を差し置いて学生代表のような扱いを受けている。"},{"spoiler":false,"text":"なお、それらはすべて重度にこじらせたシスコンの影響でしかない。"},{"spoiler":false,"text":"勉強にも運動にもまったく興味はなく、そんなことに煩わされるよりも妹の翼のことを考えていたい。"},{"spoiler":false,"text":"翼と同じ空気を吸っているだけで幸せなので、一緒の場所に居られれば問題ない。"},{"spoiler":false,"text":"趣味は翼とイチャラブする妄想と、自宅廊下に落ちている翼の体毛拾い。"},{"spoiler":false,"text":"外では自重しているが翼と2人きりだと性格が変わり、翼に猛烈アピールしていく。"},{"spoiler":false,"text":"性への興味は強く、知識もある。 しかしオナニーは週に2～3回ほど。 オカズはもちろん翼。"}],"source":"bangumi","sourceCharacterId":"53994"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"5147","sourceWorkId":"21011","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"5147","sourceWorkId":"21011","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"5147","sourceWorkId":"21011","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"5147","sourceWorkId":"21011","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"5147","sourceWorkId":"21011","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d562b4903d4cb70b62ef4909d1a14411220d6f14e5cbf9849bc67b2c1c0c1ebd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10d84c48f9790e3c1f8baaccd57e0771a364477867f1832730c846add54c2267.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひろは","cre