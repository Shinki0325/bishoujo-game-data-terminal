092","spoiler":false},{"segments":[{"spoiler":false,"text":"真面目ポンコツ！？付喪神"},{"spoiler":false,"text":"付喪神の少女。"},{"spoiler":false,"text":"とても真面目で人を疑わないタイプの女の子で、真っ直ぐで曲がらないことが正確に反映されている。"},{"spoiler":false,"text":"その容姿はとても美しく、そしてとても可愛らしい。"},{"spoiler":false,"text":"紆余曲折を経て、今は縁結びの神社の「榛月神社」に身を寄せているが、元が刃物の彼女は役にたつことがなかったり。"},{"spoiler":false,"text":"それでも神様の役に立ちたいと彼女は、主人公（侑斗）の縁結びの手助けをしたいと申し出ます。"},{"spoiler":false,"text":"しかし、刃物の扱い以外はポンコツで、本来の“縁”を結ぶのがどうにも苦手だったりする。"},{"spoiler":false,"text":"『是非、わたくしに貴方の縁を結ばせてくださいっ！』"}],"source":"bangumi","sourceCharacterId":"58989"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"18442","sourceWorkId":"26092","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"18442","sourceWorkId":"26092","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"18442","sourceWorkId":"26092","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"18442","sourceWorkId":"26092","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb7cfe70a593d12adcb789bbc9378e9b182eaba25595aaf7919c430478da76e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44d3f003ffe2e5c757cbae5374698f01a0eb7a42695322f914c21312962c16a0.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229662:58989:6509:1","source":"bangumi"}]},{"characterId":"char_c65315","characterName":"天野 美咲","sourceIds":{"bangumi":[{"characterId":"58990","matc