96","sourceWorkId":"10767","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26a8a6ea887201cd460dd3944911daaa9e1d293601ca4be827f31f10f00c8cee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f828c7cfdf857b7f71b432537b3313c4aab16ce0f288981fb86201cdf8cc70cb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:296441:203121:5075:1","source":"bangumi"}]},{"characterId":"char_c51143","characterName":"エルピス","sourceIds":{"bangumi":[{"characterId":"203119","match":"exact-normalized-name-in-linked-work","subjectId":"296441"}],"egsCharacterIds":["18300"],"vndbCharacterId":"c51143"},"originalCharacterName":"エルピス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大スンダ王国の王子であり、本作の主人公。"},{"spoiler":false,"text":"真っ直ぐな性格で曲った事が嫌いなタイプだが、それ故、熱くなりすぎることもしばしば。"},{"spoiler":false,"text":"幼いころから英才教育を受けており、剣・槍・弓など、全ての武器を扱える上、その実力は折り紙つきで、国内でも随一の実力者。"},{"spoiler":false,"text":"戦場では白銀の鎧をまとっていることから、敵には「白い悪魔」と呼ばれている。"}],"source":"egs","sourceCharacterId":"18300","sourceWorkId":"10767","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。物語の舞台である大スンダ王国の王子。"},{"spoiler":false,"text":"実力がモノを言うこの国で、早くから英才教育を受け国内でも随一の実力者となった。"},{"spoiler":false,"text":"剣、槍、弓などすべての武器を扱える上に、その実力はトップクラス。"},{"spoiler":false,"text":"戦場では白銀の鎧をまとって戦うため、敵には\"白い悪魔\"とも呼ばれる。"},{"spoiler":false,"text":"曲がったことが嫌いな潔癖な性格で、それ故に熱くなりすぎることもしばしばある。"}],"source":"bangumi","sourceCharacterId":"203119"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06324f927d830df4803331c4eb86147077c47971b0047fb7422feff11a2c7c77.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74077fe9794ce0971a9e39f02af819d887aacf69cec14b9bcebf703402be2a01.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c51144","characterName":"ビアンカ","sourceIds":{"bangumi":[{"characterId":"203122","match":"exact-normalized-name-in-linked-work","subjectId":"296441"}],"egsCharacterIds":["18297"],"vndbCharacterId":"c51144"},"originalCharacterName":"ビアンカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルピスの幼馴染で、自分の腕一つでのし上がった実力者。"},{"spoiler":false,"text":"エルピスの良き理解者で、元は彼の身の回りの世話する役目だったが、陸軍士官学校に入ったのち、メキメキ実力をつけ、今では「セレーネ護衛騎兵隊」隊長を任されるまでに成長する。"},{"spoiler":false,"text":"男っぽい言動が目立つが、時折見せる女らしさが堪らなくキュート。"},{"spoiler":false,"text":"エルピスにほのかな恋心を抱いていたが、彼に婚約者ができたため、結局、言い出せずにいる。"}],"source":"egs","sourceCharacterId":"18297","sourceWorkId":"10767","spoiler":false},{"segments":[{"spoiler":false,"text":"エルピスの幼なじみで、よき理解者。自分の腕ひとつでのし上がってきた実力派の騎士。"},{"spoiler":false,"text":"言葉遣いは男っぽいが、時々女らしさを見せることもある。"},{"spoiler":false,"text":"元は主人公の身の回りを世話する役目だったが、12歳で陸軍士官学校に入り、今ではセレーネ護衛騎兵隊隊長を任されるまでになっている。"},{"spoiler":false,"text":"ほのかに主人公に恋心を抱いているが、婚約者ができてしまったため結局言い出せないでいる。"},{"spoiler":false,"text":"公衆の面前ではエルピスのことを「殿下」と呼ぶが、プライベートなどではお互い名前で呼び合う仲。"}],"source":"bangumi","sourceCharacterId":"203122"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"18297","sourceWorkId":"10767","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"18297","sourceWorkId":"10767","sourceField":null,"scoped":true},{"