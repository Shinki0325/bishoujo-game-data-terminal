 minutes to put them in. Although she is caring and playful with her sisters, she shows a grumpy and somewhat aggressive personality to outsiders. She likes pancakes, but hates tsukemono. Her favorite drink is warm water, her favorite animals are rabbits, her favorite TV program type is variety shows, her best subject is English, and her daily convention is putting on a facial mask and doing yoga."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c94553"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8311940a23273787c933d9c8c2f7893a641c93a350a00f22a3961af47edbada.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41bb76945daea74da001112c17c1b78eae3adbd4cf35abdb64ad25d779383f33.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹達 彩奈","creatorId":"vndb:s1767","sourcePersonId":"vndb:s1767","canonicalEntityId":"vndb:s1767","name":"竹達 彩奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90408","source":"vndb"}]},{"characterId":"char_vndb_c94554","characterName":"中野 三玖","sourceIds":{"vndbCharacterId":"c94554"},"originalCharacterName":"中野 三玖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"505"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third sister, she has medium-length hair, \"emotionless\" eyes and normally a specific 