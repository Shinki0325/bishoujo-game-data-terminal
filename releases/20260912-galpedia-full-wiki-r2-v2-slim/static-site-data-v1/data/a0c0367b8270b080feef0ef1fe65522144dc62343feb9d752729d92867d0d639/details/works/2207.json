alue":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水泳部に所属する、ストイックで近寄り難い雰囲気の女の子。"},{"spoiler":false,"text":"弱小の水泳部にあって、その実力は全国大会レベル。"}],"source":"egs","sourceCharacterId":"27505","sourceWorkId":"2207","spoiler":false},{"segments":[{"spoiler":false,"text":"弱小の水泳部にありながら、全国大会レベルの実力を持つ少女。"},{"spoiler":false,"text":"だが、そのストイックな姿勢と無愛想な態度から、水泳部の中では孤立している。"},{"spoiler":false,"text":"外見は日独クォータのため、金髪。"},{"spoiler":false,"text":"年齢の割には身長も低く、かなり幼い印象を受ける。"},{"spoiler":false,"text":"日本に住んで長いはずだが、微妙にズレた言動が目立つ。"}],"source":"bangumi","sourceCharacterId":"149269"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a03dd662878cf106cc0b28bf23cbbc62e6c9c2030fe9130214ba0534ada3d7b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/195d7f66b5455185408d1fd898c983041b96bf11974beefbe80b591c2a262d3b.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七瀬 凛","creatorId":"vndb:s30404","sourcePersonId":"vndb:s30404","canonicalEntityId":"vndb:s30404","name":"七瀬凛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:16605","source":"vndb"}]},{"characterId":"char_c105257","characterName":"柊 沙希","sourceIds":{"bangumi":[{"characterId":"149274","match":"exact-normalized-name-in-linked-work","subjectId":"230346"}],"egsCharacterIds":["27506"],"vndbCharacterId":"c105257"},"originalCharacterName":"柊 沙希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"新体操部に副部長を務める、主人公のクラスメイト。"},{"spoiler":false,"text":"努力家だが、それを他人に知られることを嫌い、常に余裕そうに振舞う。"},{"spoiler":false,"text":"バレー部の薫とは犬猿の仲。"}],"source":"egs","sourceCharacterId":"27506","sourceWorkId":"2207","spoiler":false},{"segments":[{"spoiler":fa