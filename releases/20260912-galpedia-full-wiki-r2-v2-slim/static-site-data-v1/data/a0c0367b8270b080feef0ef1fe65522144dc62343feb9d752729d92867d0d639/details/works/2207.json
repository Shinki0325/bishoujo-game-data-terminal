ceWorkId":"2207","spoiler":false},{"segments":[{"spoiler":false,"text":"女子空手部の副部長。"},{"spoiler":false,"text":"普段は縁側で寝くたれる猫のような雰囲気を持つ少女だが、空手家としての実力は非常に高く、部内では『眠れる獅子』という異名を持つ。"},{"spoiler":false,"text":"セミロングの黒髪をポニーテールにまとめた、スレンダーな体型。"},{"spoiler":false,"text":"しなやかな体躯は、イメージ通り猫を思わせる。"},{"spoiler":false,"text":"同じ武道系の弓道部にライバル意識があるらしい。"}],"source":"bangumi","sourceCharacterId":"149273"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4005ff32a4cb7d7a744a40245cffd8075ccf74f46eea696a2503426f41d7503.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97f009971b24ef317b9525382abc0a7485b698a6cb40e31d1a818d767e1f3429.webp","width":160,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c105263","characterName":"藤山 絵美子","sourceIds":{"bangumi":[{"characterId":"149275","match":"exact-normalized-name-in-linked-work","subjectId":"230346"}],"egsCharacterIds":["27512"],"vndbCharacterId":"c105263"},"originalCharacterName":"藤山 絵美子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美術部に所属する、ほんわかのほほ～んとした女の子。"},{"spoiler":false,"text":"普段はおっとりしているが、「芸術」のことになると、途端に目の色が変わり、激しく情熱的になる。"}],"source":"egs","sourceCharacterId":"27512","sourceWorkId":"2207","spoiler":false},{"segments":[{"spoiler":false,"text":"３年生の美術部員。"},{"spoiler":false,"text":"ポヤ～っとした外見と、それに違わずほんわかした性格の持ち主。"},{"spoiler":false,"text":"普段はのんびりとした少女だが、”芸術”に関しては激しいほどの情熱を見せる。"},{"spoiler":false,"text":"高名な画家の展覧会には欠かさず足を運び、常にその目と感性を養っている。"},{"spoiler":false,"text":"その為に学業を後回しにしてしまう事もしばしばで、成績は美術こそ飛びぬけているものの、他の科目は中の下程度。"}],"source":"bangumi","sourceCharacterId":"149275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/c