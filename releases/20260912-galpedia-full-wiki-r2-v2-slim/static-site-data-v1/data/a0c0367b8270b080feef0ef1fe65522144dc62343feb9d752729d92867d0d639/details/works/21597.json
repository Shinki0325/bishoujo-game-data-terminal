か。"},{"spoiler":false,"text":"しかし本人は気にしている感じでもなく、クラスの誰ともあまり進んで絡む様子が見られない。"}],"source":"bangumi","sourceCharacterId":"25405"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00f3ecb86eb065743fa68969eab30311877bfe574367f1aabd51eccfbf395339.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf6b0e2c990a46b49ee3f38843ba75338c678f7bf3452a46079107d07c8d4d7c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c18504","characterName":"笠井 陽子","sourceIds":{"bangumi":[{"characterId":"25406","match":"exact-normalized-name-in-linked-work","subjectId":"97551"}],"egsCharacterIds":["3593"],"vndbCharacterId":"c18504"},"originalCharacterName":"笠井 陽子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"123"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Reiji's classmates. She is a simple girl who doesn't doubt what others say and easily jumps from a new trend or conversation topic to another."}],"source":"vndb","sourceCharacterId":"c18504"},{"segments":[{"spoiler":false,"text":"玲児たちのクラスメイトで、いかにも普通の女子生徒。直緒の取り巻きの一人で、暇さえあれば直緒と馬鹿話に花を咲かせている。人から言われたことに疑問を持たない単純で素直な性格をしており、話題や流行には簡単に飛び付いてしまう。"}],"source":"egs","sourceCharacterId":"3593","sourceWorkId":"20269","spoiler":false},{"segments":[{"spoil