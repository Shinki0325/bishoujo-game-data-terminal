461","sourcePersonId":"egs:creator:40574","canonicalEntityId":"vndb:s40461","name":"やべあきら","detail":"イベントCG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:276417","source":"egs"},{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74111","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66726","source":"vndb"},{"creditedName":"織姫 よぞら","creatorId":"vndb:s1282","sourcePersonId":"vndb:s1282","canonicalEntityId":"vndb:s1282","name":"Ayumi.","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:66738","source":"vndb"}]},"cast":[{"characterId":"char_c41690","characterName":"白峰 メルセデス","sourceIds":{"bangumi":[{"characterId":"141148","match":"exact-normalized-name-in-linked-work","subjectId":"229570"}],"egsCharacterIds":["13067"],"vndbCharacterId":"c41690"},"originalCharacterName":"白峰 メルセデス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編のメインヒロインのひとり。北欧出身の日本国籍の少女で、通称“メル”。"},{"spoiler":false,"text":"過去に瀕死の重傷を負った際「エレメンタルコア」を身体に埋め込むことで一命を取り留めると同時に、炎の魔法を操る音速の魔法少女“ソニックメルセデス”に変身することになった。"},{"spoiler":false,"text":"普通は双子の妹“ジゼル”と共に学園に通いながら、帝国に囚われた義父を助けるために戦い続ける。"},{"spoiler":false,"text":"明るくおおらかな性格で、いつもニコニコほよよんとしているのんびり娘。しかし、誰かを守るためなら危険を厭わない心の強い少女でもある。"}],"source":"egs","sourceCharacterId":"13067","sourceWorkId":"11243","spoiler":false},{"segments":[{"spoiler":false,"text":"双子ヒロインの姉。北欧出身の日本国籍で、愛称はメル。"},{"spoiler":false,"text":"瀕死の重傷を負った際、秘宝・エレメンタルコアを身体に埋め込まれたことで一命を取り留め、同時に炎の魔法を操る音速の魔法少女『ソニックメルセデス』に変身することになった。"},{"spoiler":false,"text":"妹のジゼルと共に学園に通いながら、帝国に捕らわれた義父を助けるために戦い続ける。"},{"spoiler":false,"text":"明るくおおらかな性格で、いつもニコニコほよよんとしているのんびり娘。"},{"spoiler":false,"text":"物事を深く考えずに行動するためただの能天気娘のように思われがちだが、不思議と事態はいい方向へと流れることが多い。"},{"spoiler":false,"text":"だれかを守るためなら、自分が傷つくことも恐れず果敢に敵へと立ち向かう。"},{"spoiler":false,"text":"特技は寝ること。"},{"spoiler":false,"text":"たとえ敵に捕まっていても熟睡することができ、一度寝るとなかなか起きない。嫌なことがあっても一回寝ると、だいたい忘れることができる。"},{"spoiler":false,"text":"使い魔：さら　CV：金田まひる"},{"spoiler":false,"text":"「あはははは……またやっちゃったよぉ。ごめんね？　ジゼルぅ～」"}],"source":"bangumi","sourceCharacterId":"141148"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"13067","sourceWorkId":"11243","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"13067","sourceWorkId":"11243","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"13067","sourceWorkId":"11243","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"13067","sourceWorkId":"11243","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"13067","sourceWorkId":"11243","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc283b18f24df8239f8d59fd8d278d0d406d62ce9eabac04ecad6ab22adf9258.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b3579cacd8153688cfaebbe4f660c661276b72b5e99bcb38c5ce8545e0026fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb