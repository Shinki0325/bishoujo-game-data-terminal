terId":"char_c41978","characterName":"木魂 音葉","sourceIds":{"bangumi":[{"characterId":"46455","match":"exact-normalized-name-in-linked-work","subjectId":"193107"},{"characterId":"46455","match":"exact-normalized-name-in-linked-work","subjectId":"225019"}],"egsCharacterIds":["7421"],"vndbCharacterId":"c41978"},"originalCharacterName":"木魂 音葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【掴みどころのない主人公の姉】"},{"spoiler":false,"text":"山彦同様に陰神楽の使い手。"},{"spoiler":false,"text":"普段は穏やかで、飄々として捉え所のない性格。"},{"spoiler":false,"text":"ビジネスはビジネス、趣味は趣味と割り切っており、常に理想を追い求める山彦を青臭いと子供扱いしている。"},{"spoiler":false,"text":"「山彦はきっとすぐに木魂家の重鎮になる。そうすれば見えてくるものもあるはずよ」"}],"source":"egs","sourceCharacterId":"7421","sourceWorkId":"21767","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の実姉。同じく陰神楽の使い手。"},{"spoiler":false,"text":"木魂一族の現エースで、最前線で活動している。すれ違った瞬間にイかせるほどのテクニックの持ち主。"},{"spoiler":false,"text":"主人公のことはとても可愛がっているが、同時に青臭いと侮ってもいる。"},{"spoiler":false,"text":"普段は柔和で穏やかな接し方をするが、のれんに腕押しという風で正体が掴めない。"},{"spoiler":false,"text":"常に悠然としていられるのは、確かな実力に裏打ちされた自信から来るもの。"},{"spoiler":false,"text":"最近は心を強く揺さぶられることが無いのが悩み、というほどである。"}],"source":"egs","sourceCharacterId":"7421","sourceWorkId":"22699","spoiler":false},{"segments":[{"spoiler":false,"text":"山彦同様に陰神楽の使い手。"},{"spoiler":false,"text":"普段は穏やかで、飄々として捉え所のない性格。"},{"spoiler":false,"text":"ビジネスと趣味は割り切っており、常に理想を追い求める山彦を青臭いと子供扱いしている。"},{"spoiler":false,"text":"「山彦はきっとすぐに木魂家の重鎮になる。 そうすれば見えてくるものもあるはずよ」"}],"source":"bangumi","sourceCharacterId":"46455"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/143441e10bfd2b2576536ff29758d6010d7c1cb15fd06b092f328904a277fb2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/498e6a184ed226493