:"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69320","source":"vndb"}]},"cast":[{"characterId":"char_c46229","characterName":"皐月乃 つばさ","sourceIds":{"bangumi":[{"characterId":"94801","match":"exact-normalized-name-in-linked-work","subjectId":"228952"},{"characterId":"94801","match":"exact-normalized-name-in-linked-work","subjectId":"67981"}],"egsCharacterIds":["16956"],"vndbCharacterId":"c46229"},"originalCharacterName":"皐月乃 つばさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖プリムローズ女学園の○等部に通う女学生。しかしてその正体は、純菜と同じ、愛と正義のヒロイン聖天使「プリマヴェール」。"},{"spoiler":false,"text":"元気いっぱいで、頭で考えるより行動する方が早いタイプ。純粋であり、非常に健気。しかし、思い込みも激しく、思い立ったら一直線、それが無謀であっても突き進む女の子。"},{"spoiler":false,"text":"先輩である純菜を「ねーさま」と呼び、憧れ以上の感情を抱いているようだ。"}],"source":"egs","sourceCharacterId":"16956","sourceWorkId":"2440","spoiler":false},{"segments":[{"spoiler":false,"text":"聖プリムローズ女学園に通うごく普通の女子学生だったが、ある日突然、愛と正義のヒロインになってしまった。"},{"spoiler":false,"text":"純菜のことを「ねーさま、ねーさま」と呼び、慕い、甘えていた。とても元気で活発な、周りの迷惑を余り考えない。勉強よりスポーツが得意で頭が悪いが、一途で真っ直ぐないい子。純菜が捕まった後、一人で戦いながら、純菜の居所を探していた。"},{"spoiler":false,"text":"思い込みが強く、これと思うと、一直線に突き進む。無謀で、男の子ともよく喧嘩をする。彼女が通う学校は女子校で、実は「ねーさま」にただならぬ感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"94801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f435da277ad372b7599e3ff6b70b5fc1fa1856f18cc6ddbbe70e647451dbf4f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d17c35c2f735461d26e4c4a5de15d9218b248a74f97295d5f99a2e5241f504f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"比未子","creatorId":"vndb:s1499","sourcePersonId":"vndb:s1499","canonicalEntityId":"vndb:s1499","name":"比未子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228952:94801:18171:1","source":"bangumi"}]},{"characterId":"char_c46231","characterName":"ムーングラム","sourceIds":{"bangumi":[{"characterId":"94804","match":"exact-normalized-name-in-linked-work","subjectId":"228952"},{"characterId":"94804","match":"exact-normalized-name-in-linked-work","subjectId":"67981"}],"egsCharacterIds":["16959"],"vndbCharacterId":"c46231"},"originalCharacterName":"ムーングラム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秘密結社「マルク・ジェネ」の皇帝、マルカス・ジェネイル直属の幹部。"},{"spoiler":false,"text":"マルク・ジェネ三将軍（彼女とジェネシス将軍、そして主人公）の一人。"},{"spoiler":false,"text":"ジェネシス将軍の妻で、主人公にとっては義姉にあたる。"},{"spoiler":false,"text":"腹黒く、何を考えているかわからない、妖艶でグラマラスな美女。彼女の色香の虜になった男は数知れず、さしずめ蜘蛛女と云ったところか。"},{"spoiler":false,"text":"義弟である主人公を誘惑することも……！？"}],"source":"egs","sourceCharacterId":"16959","sourceWorkId":"2440","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の兄であるジェネシス将軍の嫁にして、上司。"},{"spoiler":false,"text":"主人公のことを「坊や」と呼びバカにする。"},{"spoiler":false,"text":"腹黒く、いつも何かを企んでいるイケ好かない女だが、"},{"spoiler":false,"text":"兄曰く「身体はなかなかのもの」らしい。"},{"spoiler":false,"text":"主人公が手柄を立て、出世しそうになると、"},{"spoiler":false,"text":"その妖艶さと魅惑の肉体を駆使して誘惑を……。"}],"source":"bangumi","sourceCharacterId":"94804"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77910370486fdecbe9687055f156451f0562bbf6b47512554bc7cbb5be3e78bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/6133c9145d8a3ba5d9fce0b5fcb3058bb74e57eecf7f8ebf5a01eca8c44011f1.webp","width":176,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜井 薔子","creatorId":"vndb:s5084","sourcePersonId":"vndb:s5084","canonicalEntityId":"vndb:s5084","name":"桜井 薔子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:38866","source":"vndb"}]},{"characterId":"char_c46232","characterName":"ジェネシス将軍","sourceIds":{"bangumi":[{"characterId":"94805","match":"exact-normalized-name-in-linked-work","subjectId":"228952"},{"characterId":"94805","match":"exact-normalized-name-in-linked-work","subjectId":"67981"}],"egsCharacterIds":["16960"],"vndbCharacterId":"c46232"},"originalCharacterName":"ジェネシス将軍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秘密結社「マルク・ジェネ」の幹部。"},{"spoiler":false,"text":"組織内では圧倒的な支持を得ている豪傑。"},{"spoiler":false,"text":"弟である主人公のことを大切に思い、可愛がっているが、立派な男になって欲しいと厳しく接することも多い。"}],"source":"egs","sourceCharacterId":"16960","sourceWorkId":"2440","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の兄で、豪快な武人タイプの人。"},{"spoiler":false,"text":"かなりの豪傑で、組織内で彼を支持する人間は多い。"},{"spoiler":false,"text":"「がっはっは」と笑う。"},{"spoiler":false,"text":"いつも主人公に「男とは！」とか説教をする。"},{"spoiler":false,"text":"基本的にいい人。"},{"spoiler":false,"text":"主人公のことを可愛がる半面、"},{"spoiler":false,"text":"男として立派になってほしいと厳しい面も見せる。"},{"spoiler":false,"text":"ひげ面の筋肉質。"}],"source":"bangumi","sourceCharacterId":"94805"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66ee7d01f5bc4f3b11080bbc498034602dbfe6d6251acc948372273f69fbf763.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/547bd9ab0f592eb44d328c53116421a85c2fe0dfbeed90e50907cc1e281be39f.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"甘美","creatorId":"vndb:s6307","sourcePersonId":"vndb:s6307","canonicalEntityId":"vndb:s6307","name":"甘美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:38867","source":"vndb"}]},{"characterId":"char_c96044","characterName":"若草 純菜","sourceIds":{"bangumi":[{"characterId":"94800","match":"exact-normalized-name-in-linked-work","subjectId":"228952"},{"characterId":"94800","match":"exact-normalized-name-in-linked-work","subjectId":"67981"}],"egsCharacterIds":["16955"],"vndbCharacterId":"c96044"},"originalCharacterName":"若草 純菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖プリムローズ女学園に通う女学生。しかしてその正体は人々の平和を守る愛と正義のヒロイン聖天使「プリマヴェール」。"},{"spoiler":false,"text":"明朗快活で、正義感の強い女の子。シッカリしている上に世話好きで、周りに頼りにされるタイプで、先生からの評判も上々。また自尊心が強く、自分が正しいと思ったことは、絶対に曲げない。"},{"spoiler":false,"text":"純真無垢で、まだ恋を知らない。そんな穢れを知らない彼女が主人公の淫靡な調教の餌食にされ……。"}],"source":"egs","sourceCharacterId":"16955","sourceWorkId":"2440","spoiler":false},{"segments":[{"spoiler":false,"text":"聖プリムローズ女学園に通うごく普通の女子校生だったが、ある日突然、愛と正義のヒロインになってしまった。"},{"spoiler":false,"text":"ハキハキと明朗活発で、よく気のきく子。近所でも評判がよく、先生などの印象もよかった。自尊心が強く、自分が正しいとあらば、テコでも動かない。他人の世話を焼くタイプで、自分のことはいつも後回し。しっかり者なので、つい周りの人も彼女に頼ってしまう。"},{"spoiler":false,"text":"恋に遊びに大忙しの友達を見ていると、「あぁ、私も…」と思ったりもするが、好きな人がいるわけでもなく、当面は世界の平和のために自分の幸せは先送りってところ。"},{"spoiler":false,"text":"そんな純菜だが、哀れかな、悪の組織の捕虜となり、監禁調教されてしまう。"}],"source":"bangumi","sourceCharacterId":"94800"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/179680e6237374c06d3dfe726e1a0a8c043a66f0740a92613f8ba292ceb2afa9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/479c7e12fd4e6175461de651399a3c049179a012d4d323eb0d0199f1e5fb57d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228952:94800:18086:1","source":"bangumi"}]},{"characterId":"char_c96045","characterName":"チカちゃん","sourceIds":{"bangumi":[{"characterId":"94802","match":"exact-normalized-name-in-linked-work","subjectId":"228952"},{"characterId":"94802","match":"exact-normalized-name-in-linked-work","subjectId":"67981"}],"egsCharacterIds":["16957"],"vndbCharacterId":"c96045"},"originalCharacterName":"チカちゃん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一見すれば、○学生風の女の子だが、ジェネシス将軍が今回の計画を任された主人公のために用意した秘書。自称“ハタチ”。"},{"spoiler":false,"text":"見た目と変わらず、あどけなく子供っぽい。しかし子供扱いされると怒る。"},{"spoiler":false,"text":"ドジで失敗ばかりの彼女だが、好意を寄せる主人公のために頑張ろうと努力しており、またナイーブで傷つきやすい主人公の“癒し”になっている。"}],"source":"egs","sourceCharacterId":"16957","sourceWorkId":"2440","spoiler":false},{"segments":[{"spoiler":false,"text":"秘書。どう見ても見た目は学生な彼女だけど、ジェネシス将軍が今度の作戦のために主人公につけてくれた秘書。"},{"spoiler":false,"text":"チビで子供で泣きべそでドジな可愛い女の子なんだけど、プリンス某のことを慕っており、彼の為になろうとがんばって秘書らしく振る舞おうとする。ドジでいつも失敗ばかりしているけど、子供扱いされると怒る。そのくせ、「プリンス様、きーてください。隣の席のケンちゃんってば酷いんですよぉ！まったく失礼しちゃうわ、プンプン」とか言ったりする。そんなあどけない可愛い彼女が、主人公のナイーブで傷つきやすいハートを癒してくれる時も多い。"}],"source":"bangumi","sourceCharacterId":"94802"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6410bc597ceda7adfb02a29da390f6f9e89cef6f3c561eba00d52261e0294285.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82bde21d2460af534b913d7a167465891ad685a515aaac2a5f3c2333b6c532e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"すずき けいこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228952:94802:6275:1","source":"bangumi"}]},{"characterId":"char_c96046","characterName":"ちはる","sourceIds":{"bangumi":[{"characterId":"94803","match":"exact-normalized-name-in-linked-work","subjectId":"228952"},{"characterId":"94803","match":"exact-normalized-name-in-linked-work","subjectId":"67981"}],"egsCharacterIds":["16958"],"vndbCharacterId":"c96046"},"originalCharacterName":"ちはる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秘密結社「マルク・ジェネ」の超科学研究開発部の開発主任にして、主人公の幼馴染。"},{"spoiler":false,"text":"人嫌いと陰険な性格とも相俟って、組織内では浮いた存在。しかし、その腕と知能は優秀で、組織にはなくてはならない存在。"},{"spoiler":false,"text":"好きな実験や発明を自由にさせてもらえる、という理由で組織に加担している。"},{"spoiler":false,"text":"主人公とはずっと一緒だったが、犬猿の仲。"},{"spoiler":false,"text":"傍から見ると冷たい印象の彼女だが、年頃の女の子らしく、色々と悩みを抱えているらしい。"}],"source":"egs","sourceCharacterId":"16958","sourceWorkId":"2440","spoiler":false},{"segments":[{"spoiler":false,"text":"超科学研究開発部の開発主任にして、主人公の幼なじみ。"},{"spoiler":false,"text":"陰険で人間嫌いの発明好き。"},{"spoiler":false,"text":"いつもツンケンしていて、皆から嫌われているが、腕の方は超一流。主人公とは親の関係で、幼い頃から一緒にいたけど、昔から犬猿の仲。主人公はそんな女の子に「新しいバイブを作ってくれ」とか頼みにいかなければならない。いったい何を考えているのかわからない女の子。別に組織のためとかも思ってない。ただ、好きに超科学の実験をできるのがいいらしい。"},{"spoiler":false,"text":"傍から見ている分にはクールで冷たい印象だけど、やはり年頃の女の子。それなりに色々な悩みがあるらしいのだが…。"}],"source":"bangumi","sourceCharacterId":"94803"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2fe2a2ea13ed16c0ce0827f003ad1d8b3df4bf812950ab61d09728e66bc050c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/803cfd3c23ae101e2728f2c509e74dfe6eb46f9d286a74969486466ff1991f52.webp","width":213,"height":256,"source":"static-