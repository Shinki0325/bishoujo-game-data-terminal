ler":false,"text":"家では姉、学校では先輩となる。"},{"spoiler":false,"text":"性格は明るく無邪気、人懐っこくて甘え上手の寂しがりや。"},{"spoiler":false,"text":"子供の頃、父親に 『猫になる魔法』 をかけられた。"},{"spoiler":false,"text":"そのせいで “寂しくなる” と猫の耳と尻尾が生える。"},{"spoiler":false,"text":"一人ぼっちでいると寂しくなって変身してしまうため、家でも学校でもなるべく誰かと一緒にいるようにしている。"}],"source":"egs","sourceCharacterId":"14135","sourceWorkId":"13383","spoiler":false},{"segments":[{"spoiler":false,"text":"次女。見た目はちっちゃいロリっ娘だけど一つ年上。"},{"spoiler":false,"text":"家では姉、学校では先輩となる。"},{"spoiler":false,"text":"性格は明るく無邪気、人懐っこくて甘え上手の寂しがり屋。"},{"spoiler":false,"text":"子供の頃、父親に 『猫になる魔法』 をかけられた。"},{"spoiler":false,"text":"そのせいで “寂しくなる” と猫の耳と尻尾が生える。"},{"spoiler":false,"text":"一人ぼっちでいると寂しくなって変身してしまうため、家でも学校でもなるべく誰かと一緒にいるようにしている。"}],"source":"bangumi","sourceCharacterId":"88655"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e43090cbeb5d68c27c15d92d230112e38493dd39fadfb1dea25224259b7c1a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3646efc2a63dd29ab058ea84fd35467205f3d4984e66eae6bde690a5cf165514.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:143843:88655:4714:1","source":"bangumi"}]},{"characterId":"char_c4172","characterName":"卯月 岬子","sourceIds":{"bangumi":[{"characterId":"139476","match":"exact-normalized-name-in-linked-work","subjectId":"143843"}],"egsCharacterIds":["14137"],"vndbCharacterId":"c4172"},"originalCharacterName":"卯月 岬子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The fourth and you