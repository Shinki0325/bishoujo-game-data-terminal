{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"2719","model":{"presentationWorkId":"vndb:v7235","staff":{"artwork":[{"creditedName":"藤原秋久","creatorId":"vndb:s4051","sourcePersonId":"egs:creator:861","canonicalEntityId":"vndb:s4051","name":"藤原秋久","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:3857","source":"egs"},{"creditedName":"天野雨乃(あまのあめの)","creatorId":"vndb:s3719","sourcePersonId":"egs:creator:1810","canonicalEntityId":"vndb:s3719","name":"天野雨乃(あまのあめの)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:3858","source":"egs"}],"scenario":[{"creditedName":"華肉ざくろ","creatorId":"vndb:s4056","sourcePersonId":"egs:creator:1478","canonicalEntityId":"vndb:s4056","name":"華肉ざくろ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:3859","source":"egs"},{"creditedName":"火々野 未完","creatorId":"vndb:s2388","sourcePersonId":"vndb:s2388","canonicalEntityId":"vndb:s2388","name":"火々野 未完","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:69763","source":"vndb"}],"music":[{"creditedName":"ミリオンバンブー(有限会社バンブー)","creatorId":"vndb:s1435","sourcePersonId":"egs:creator:2670","canonicalEntityId":"vndb:s1435","name":"ミリオンバンブー(有限会社バンブー)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11837","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c48783","characterName":"緒方 沙弥香","sourceIds":{"bangumi":[{"characterId":"97698","match":"exact-normalized-name-in-linked-work","subjectId":"261796"}],"egsCharacterIds":["27688"],"vndbCharacterId":"c48783"},"originalCharacterName":"緒方 沙弥香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new nurse who begins working at “Date Clinic,” where the protagonist has been assigned."},{"spoiler":false,"text":"Although she’s clumsy and constantly makes mistakes, her kind nature and cheerful, ever-smiling demeanor earn her a good reputation among patients."},{"spoiler":false,"text":"In exchange for helping her sick mother, she agrees to fulfill the protagonist’s request to serve as a “comfort nurse”."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c48783"},{"segments":[{"spoiler":false,"text":"主人公の任された「伊達病院」で働くことになった新人看護婦。"},{"spoiler":false,"text":"ドジで失敗も多いが、何事も一生懸命で、素直で明るく優しい献身的な性格から患者からの評判は高い。"},{"spoiler":false,"text":"病気の母親を助けてくれることを引き換えに、慰安看護婦としての調教を受けることになるが……。"}],"source":"egs","sourceCharacterId":"27688","sourceWorkId":"1790","spoiler":false},{"segments":[{"spoiler":false,"text":"本編のメインヒロイン。主人公が任された「伊達医院」に勤務することになる新人看護婦。"},{"spoiler":false,"text":"ドジで失敗ばかりしているが、優しい性格と微笑を絶やさない健気な態度で患者からの評判は良い。"},{"spoiler":false,"text":"病気の母親を助けるのと引き換えに、主人公の要求する『慰安看護婦』としての調教を受けることになる。"},{"spoiler":false,"text":"性格は素直で優しい、理想の看護婦とも言える。人に奉仕し、喜んでもらうことに喜びを見出すタイプ。"},{"spoiler":false,"text":"失敗にしても本人は一生懸命なのだが、力の入りすぎが原因で失敗してしまうことが多い。"},{"spoiler":false,"text":"始めは『慰安看護婦』の仕事への嫌悪感から反抗するが、『慰安看護婦』として調教されていくうちに次第に……。"}],"source":"bangumi","sourceCharacterId":"97698"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/989b705e960c13fb120441169f4b3a8250ed20f7ed94ba41dcc49a272b45c775.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad013e76d5e7cb36779f52f942e02fee86ba66335106fc143841837e31726c60.webp","width":190,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_c48786","characterName":"榊　麗美","sourceIds":{"bangumi":[{"characterId":"97701","match":"exact-normalized-name-in-linked-work","subjectId":"261796"}],"egsCharacterIds":["27691"],"vndbCharacterId":"c48786"},"originalCharacterName":"榊　麗美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A pharmacist who ends up working at “Date Clinic.” She was sent by the protagonist’s father to assist with “the plan,” but she is a woman shrouded in mystery."},{"spoiler":false,"text":"She is “useful”—exploiting her position as a pharmacist to divert drugs and procure illegal substances—but she gives off a vaguely dangerous vibe."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c48786"},{"segments":[{"spoiler":false,"text":"「伊達医院」で働くことになった調剤師。"},{"spoiler":false,"text":"モデル並みのプロポーションの持ち主で、どことなく危険な雰囲気が漂う妖艶な女性。"},{"spoiler":false,"text":"主人公に対しても、思わせぶりな態度と言動で誘惑してくることも。"},{"spoiler":false,"text":"調剤師の立場を利用して薬品の横流し、違法薬品の調達したりと、色々と使い勝手があるのだが……。"}],"source":"egs","sourceCharacterId":"27691","sourceWorkId":"1790","spoiler":false},{"segments":[{"spoiler":false,"text":"「伊達医院」に勤務することになる薬剤師。"},{"spoiler":false,"text":"薬剤師の立場を利用しての薬品の横流し、違法薬品の調達など「使いで」のある女性。"},{"spoiler":false,"text":"だが、どことなく危険な雰囲気を持つ。主人公に対して何かとちょっかいを出す。"},{"spoiler":false,"text":"主人公に対して、妖艶な態度で思わせぶりな言動をしたり、取引に主人公の身体を要求したりする。"},{"spoiler":false,"text":"外観的な特徴は、身長は女性キャラ中最も高く、１７５ぐらい。"},{"spoiler":false,"text":"金髪ロングで切れ長の目、モデルのようなプロポーションの持ち主。"}],"source":"bangumi","sourceCharacterId":"97701"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1bc651a4b14dd9e91f66d4d7d9718d0f3799a475bf74d42c5126daf01f5a158.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e999d11d89daa72377de0a72f882d41f1efbbd815c46ea891e55a02e7107f35.webp","width":190,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c102205","characterName":"伊逹 隆一","sourceIds":{"vndbCharacterId":"c102205"},"originalCharacterName":"伊逹 隆一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The son of Fujimiya Ryuuichi."}],"source":"vndb","sourceCharacterId":"c102205"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c102206","characterName":"小早川 瀬里奈","sourceIds":{"vndbCharacterId":"c102206"},"originalCharacterName":"小早川 瀬里奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nurse who began working at “Date Clinic” on Reimi’s recommendation. Unlike the other two, she volunteered to work there of her own accord."},{"spoiler":false,"text":"In fact, she is a former patient whose life was saved by the protagonist in the past; ever since then, she has been deeply in love with him and has been striving to become a nurse."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c102206"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0ca96b0cf242c669d61c9f81f122cafbe2b3e605b89e9c79ed82e5b27c14187.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/369f962198c5fd82d507c3edde8e04a4bcfb6aca8462188cbf520a1f25a1ee8f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c102207","characterName":"陣内 仁美","sourceIds":{"vndbCharacterId":"c102207"},"originalCharacterName":"陣内 仁美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nurse who began working at “Date Clinic” on Reimi’s recommendation. She and Shiori had been senior and junior colleagues at their previous hospital."},{"spoiler":false,"text":"She came to “Date Clinic”—which is located in the suburbs, which offers a pleasant environment, and pays an impeccable salary—to care for her frail brother-in-law."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c102207"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9ccae0cee63319c63dd660f9506f154918c227e0f067ec95957ccb29210dcef1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13891bc1e92445ea49e1c2efe4d18a7166f88ff8e3ad67a3447e5a7f780f204f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c102208","characterName":"麻生 紫織","sourceIds":{"vndbCharacterId":"c102208"},"originalCharacterName":"麻生 紫織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nurse who began working at “Date Clinic” on Reimi’s recommendation. She had previously worked alongside Hitomi at her former hospital."},{"spoiler":false,"text":"When the protagonist confronts her about her relationship with Hitomi, he exploits the situation and subjects her to training as a “comfort nurse.”"},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c102208"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b087ce2fb3f3d03b2706b815241d1b9a8467aad04afbb9ff9fe5c85731f55139.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24999431185f4b8b2ee5bcab1915a174ef33105bc170ff30f3c4d7b9fb8bcc77.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c102209","characterName":"支倉 瑶子","sourceIds":{"vndbCharacterId":"c102209"},"originalCharacterName":"支倉 瑶子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Reimi invited her to work as a doctor at “Date Clinic.” Although they had been romantically involved in the past, they have completely moved on from each other romantically. Their current relationship is that of close confidants."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c102209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de2e5d9825e76b7ff120e92a20f9a3bf4e6f4ca3c4f88dd5fab43155c904a654.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdb9a4e440e7ac880ec6fb08f5216aae9deccb57e8d3ba6a57a3349b28c211a5.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c102210","characterName":"島 僚子","sourceIds":{"vndbCharacterId":"c102210"},"originalCharacterName":"島 僚子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She was in the same class as the protagonist during medical school, and they went on to work together at the same “Date General Hospital.” Ever since then, she has viewed the protagonist as a rival."},{"spoiler":false,"t