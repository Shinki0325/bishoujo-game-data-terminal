rce":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の姉。既婚者の人妻。"},{"spoiler":false,"text":"現在の旦那・隆行とは、見合い結婚。"},{"spoiler":false,"text":"お嬢様育ちで、世間知らずなところもあるが、面倒見がよく、落ち着いた雰囲気を持ち、清楚で優しい女性。"},{"spoiler":false,"text":"夫が浮気し、夫婦仲は冷め切っている。そうしたなか、久しぶりに一緒に過ごす弟（主人公）の優しさに触れ、姉弟ながらもトキメキを感じてしまう。"},{"spoiler":false,"text":"夫とのセッ○スが淡白なのか、性的なことには疎さがあり、初々しさがある。"}],"source":"egs","sourceCharacterId":"14209","sourceWorkId":"13268","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の姉で既婚。夫とは見合い結婚。"},{"spoiler":false,"text":"面倒見がよく、落ち着いていて清楚。"},{"spoiler":false,"text":"お嬢様育ちなため、少し世間知らずなところがある。"},{"spoiler":false,"text":"久しぶりに会った弟の優しい態度に頼りがいを感じ、今まで覚えたことのない感情を抱く。"},{"spoiler":false,"text":"性的にはまだまだ開発段階だが、覚えたてのため好奇心は旺盛。身体がついつい感じてしまう。"}],"source":"bangumi","sourceCharacterId":"45816"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2095e5300631b67c199ebd81621197263bf18e5f16b16aaeef63bde312150f46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a195d13e86fbf040d076de2e5516e7391a50afcbc62672fe1c07f1fae307ff7f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今井 美月","creatorId":"vndb:s462","sourcePersonId":"vndb:s462","canonicalEntityId":"vndb:s462","name":"藤原 美央子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20809","source":"vndb"}]},{"characterId":"char_vndb_c133355","characterName":"宮本 祐二","sourceIds":{"vndbCharacterId":"c133355"},"originalCharacterName":"宮本 祐二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p832","sourceCompanyId":"egs:brand:2298","canonicalEntity