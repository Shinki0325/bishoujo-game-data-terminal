leLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:297796","source":"egs"},{"creditedName":"夏和小","creatorId":"vndb:s8737","sourcePersonId":"egs:creator:26545","canonicalEntityId":"vndb:s8737","name":"夏和小","detail":"OP曲「クランクイン!」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:298545","source":"egs"},{"creditedName":"夏和小","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:218386","source":"vndb"},{"creditedName":"Rin'ca","creatorId":"vndb:s8804","sourcePersonId":"vndb:s8804","canonicalEntityId":"vndb:s8804","name":"Rin'ca","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:218387","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c156663","characterName":"神鳥 流花","sourceIds":{"vndbCharacterId":"c156663"},"originalCharacterName":"神鳥 流花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student. President of the Film Club."},{"spoiler":false,"text":"Ruka boasts a beauty and proportions that rival any professional actress. She possesses a strong-willed, dignified character, charging straight ahead toward her goals and dreams. Yet her heart is pure and innocent."},{"spoiler":false,"text":"The protagonist is drawn to Ruka's overwhelming charisma and wants to create a work with her as the heroine."},{"spoiler":false,"text":"She's a true film enthusiast, but her aspirations lie not in acting, but solely in directing. She has been scouted by talent agencies, but has declined every offer."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c156663"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/158dd5f9a5879107244b98b85982c3efbb96ce628a329eef02c8d2d411e5e90c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d51b4a7e65b1072a7a9801488556ef75fa4ec9cd4217156c9fa1b8eb8c33075.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神山 翠","creatorId":"vndb:s46929","sourcePersonId":"vndb:s46929","canonicalEntityId":"vndb:s46929","name":"神山 翠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101301","source":"vndb"}]},{"characterId":"char_vndb_c156664","characterName":"猫屋敷 寝子","sourceIds":{"vndbCharacterId":"c156664"},"originalCharacterName":"猫屋敷 寝子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist's younger sister. A third-year student at the academy."},{"spoiler":false,"text":"She has a cheerful, friendly personality, but she can also be fickle like a cat. Because of her short stature and childlike face, she's very rarely seen as a senpai, which frustrates her."},{"spoiler":false,"text":"Even though she's still a student, she's also a genius pharmaceutical researcher. To save her older brother, who was hovering between life and death due to overwork, she administered an immortality drug that she developed herself, causing him to turn young again as a side effect."},{"spoiler":false,"text":"She ends up joining the film club's activities. She helps fill in during filming when the club is short-handed."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c156664"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea4cb116f104a64981f44cbb852859cb17beb4d410cfab1ca52f0e3aea9b4915.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bef376a0f7c574bb5bc218a3360d46363499341eed1fc2190cf94afad43ad175.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花咲 ねね","creatorId":"vndb:s33269","sourcePersonId":"vndb:s33269","canonicalEntityId":"vndb:s33269","name":"愛原 ありさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101302","source":"vndb"}]},{"characterId":"char_vndb_c156666","characterName":"辰巳 深空","sourceIds":{"vndbCharacterId":"c156666"},"originalCharacterName":"辰巳 深空","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second-year student. A friend of Ruka, serves as the vide president of the Film Club."},{"spoiler":false,"text":"An extreme gamer with deep knowledge of smartphone functions. She uses her expertise to work as the club's camerawoman and sound technician."},{"spoiler":false,"text":"She has a perpetually listless, downer vibe and speaks in a flat tone, but she isn't cold; in fact, she possesses a deeply compassionate side."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c156666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ad217fcfaf81ce355498fb3a14a74a5ba296aaff84f794db7e4911849f327d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98b34d1fce30ba54ca4e23b8c3b1b1157063dfa4938fc44174d91f5d202f0258.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏和小","creatorI