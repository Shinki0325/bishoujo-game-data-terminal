tityStatus":"source-native","relationId":"vndb:vn-staff:50194","source":"vndb"},{"creditedName":"666","creatorId":"vndb:s25503","sourcePersonId":"vndb:s25503","canonicalEntityId":"vndb:s25503","name":"666","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50195","source":"vndb"},{"creditedName":"紅娘","creatorId":"vndb:s12344","sourcePersonId":"vndb:s12344","canonicalEntityId":"vndb:s12344","name":"EorX","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50196","source":"vndb"}]},"cast":[{"characterId":"char_c23544","characterName":"加藤 由香里","sourceIds":{"bangumi":[{"characterId":"98300","match":"exact-normalized-name-in-linked-work","subjectId":"224203"}],"egsCharacterIds":["21188"],"vndbCharacterId":"c23544"},"originalCharacterName":"加藤 由香里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"28"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She switched from being a stage actress to a voice actress. In her younger days, she was a charismatic voice actress who boasted of her idol-like popularity."},{"spoiler":false,"text":"However, when the president of her production company tried to have a sexual relationship with her, she refused, which led to resentment and the end of her career as a voice actress."},{"spoiler":false,"text":"She then set up a private agency to nurture Maya Ichijou, who became a voice actress because she admired her when she was a popular voice actress."},{"spoiler":false,"text":"Currently, she is working hard as a manager to promote Maya. She is intelligent and has a winning personality. She hates men due to past trauma. She is a virgin."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c23544"},{"segments":[{"spoiler":false,"text":"舞台女優から声優に転向し、若手時代はアイドル的なカリスマ声優として人気を誇った。"},{"spoiler":false,"text":"プロダクションの社長に男女の関係を迫られ、それを拒否したことから、業界から干され、声優生命を絶たれる。"},{"spoiler":false,"text":"その後、自分に憧れ声優の道を選んだ麻耶を育てるために個人事務所を設立し、彼女のマネージャーとして第二の人生を歩んでいる。"},{"spoiler":false,"text":"性格は理知的で勝気。過去のトラウマから男嫌い。処女。"}],"source":"egs","sourceCharacterId":"21188","sourceWorkId":"8948","spoiler":false},{"segments":[{"spoiler":false,"text":"舞台女優から声優に転向。若手時代はアイドル的な人気を誇るカリスマ声優だった。"},{"spoiler":false,"text":"プロダクションの社長に男女の関係を迫られ拒否したことで逆恨みされ、業界から干され声優生命を絶たれる。"},{"spoiler":false,"text":"その後、人気声優だったころの自分に憧れて声優になった一条麻耶を育てるために、個人事務所を立ち上げる。"},{"spoiler":false,"text":"現在は麻耶を売り出すためマネージャーとして奔走している。"},{"spoiler":false,"text":"理知的で、勝気な性格。過去のトラウマから男嫌い。処女。"}],"source":"bangumi","sourceCharacterId":"98300"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"21188","sourceWorkId":"8948","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"21188","sourceWorkId":"8948","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"21188","sourceWorkId":"8948","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"21188","sourceWorkId":"8948","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/940ac64ba18a39d533b9a2290de7d2f44c9567a0dee4843b87f218a1d5c14abf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebb64e4b8090296636a7b18c14d39a03d6b4c50e587a9148fbe9ce372842e3be.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紫陽花","creatorId":"vndb:s33245","sourcePersonId":"vndb:s33245","canonicalEntityId":"vndb:s33245","name":"紫陽花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27802","source":"vndb"}]},{"characterId":"char_c23549","characterName":"一条 麻耶","sourceIds":{"bangumi":[{"characterId":"98299","match":"exact-normalized-name-in-linked-work","subjectId":"224203"}],"egsCharacterIds":["21187"],"vndbCharacterId":"c23549"},"originalCharacterName":"一条 麻耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful girl who has loved anime since she was a child. She entered a voice actor training school because she admired Yukari Katou, a charismatic voice actress who starred in primetime shows at the time."},{"spoiler":false,"text":"She was shocked to learn that Yukari had already retired, but in order to make up for her lost time, she pleaded with the agency to have Yukari manage her."},{"spoiler":false,"text":"Yukari is a single-minded and healthy girl. She has a character of not being able to say no when asked to do so. She is a virgin."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c23549"},{"segments":[{"spoiler":false,"text":"現役女学生声優。"},{"spoiler":false,"text":"子供の頃からアニメが大好きで、カリスマ声優だった加藤由香里に憧れ、声優養成所に入った。"},{"spoiler":false,"text":"頼まれると嫌とはいえない性格で、一途で健気。処女。"}],"source":"egs","sourceCharacterId":"21187","sourceWorkId":"8948","spoiler":false},{"segments":[{"spoiler":false,"text":"小さいころからアニメが好きだった美少女。"},{"spoiler":false,"text":"当時ゴールデンタイムに主演していたカリスマ声優だった加藤由香里に憧れて声優養成所に入る。"},{"spoiler":false,"text":"由香里が既に現役を退いていたことを知りショックを受けるが、由香里の分までがんばるために事務所に懇願して由香里にマネージメントを依頼した。"},{"spoiler":false,"text":"一途で健気な少女。頼まれるとイヤと言えない性格。処女。"}],"source":"bangumi","sourceCharacterId":"98299"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"21187","sourceWorkId":"8948","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"21187","sourceWorkId":"8948","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"21187","sourceWorkId":"8948","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"21187","sourceWorkId":"8948","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/002bfc82b6c56bb0c9aa80c82a6ac62afe6352a903e1e5090d4a86b99e96eadd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d29901fd197f0d4dc95a5ce1e2bd86342ce4f4b9894f56d119704b6fe22e78f6.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日 アン","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224203:98299:6480:1","source":"bangumi"}]},{"characterId":"char_vndb_c23533","characterName":"麻生 俊介","sourceIds":{"vndbCharacterId":"c23533"},"originalCharacterName":"麻生 俊介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"31"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A scenario writer. He was asked to plan and write a game for bishojo game and was present for the recording."},{"spoiler":false,"text":"When he was unknown, Yukari had undermined his scenario and he lost his job for a while. She has now changed her name and returned to the industry."},{"spoiler":false,"text":"He is now active mainly in the adult writing field. Behind his smile, he has a sadistic personality that hides a selfish and insidious nature."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c23533"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1571","sourceCompanyId":"egs:brand:1883","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8948:1883","source":"egs"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10069:v4455","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:10070:v4455","source":"vndb"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163945:v4455","source":"vndb"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:16705:v4455","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name