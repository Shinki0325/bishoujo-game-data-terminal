{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"38181","model":{"presentationWorkId":"vndb:v10570","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c10258","characterName":"十坂 ひよこ","sourceIds":{"vndbCharacterId":"c10258"},"originalCharacterName":"十坂 ひよこ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of Heartful Boyfriend, she is the hardworking and optimistic, only human student at St. Pigeonation. Hiyoko is a hunter-gatherer that lives alone in a cave. Her favourite food is udon."}],"source":"vndb","sourceCharacterId":"c10258"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c10259","characterName":"華原 涼太","sourceIds":{"vndbCharacterId":"c10259"},"originalCharacterName":"華原 涼太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1203"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hiyoko's childhood friend, Ryouta is a kind and considerate Rock Dove. Although he suffers from a weak stomach (and poor health in general), because his mother is ill, Ryouta is always busy with his part-time jobs to support their household."},{"spoiler":false,"text":"Based on the official website"}],"source":"vndb","sourceCharacterId":"c10259"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c2a73c5870dc23025adf9324c6ecae3dd02cfb85b13cf4ac7786893615d669c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5549b1e9649d3a4147ff268a7b7d60d590c34ccbdbff41e4b044757beceec952.webp","width":256,"height":218,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10260","characterName":"七姫 一明","sourceIds":{"vndbCharacterId":"c10260"},"originalCharacterName":"七姫 一明","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"923"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hiyoko, Ryouta, Sakuya and San's narcoleptic King Quail homeroom (2nd Year, Class 3) teacher, who also teaches mathematics. In spite of his slow and steady pace, Kazuaki is an incredibly intelligent bird whom possesses a brilliant mind."},{"spoiler":false,"text":"Based on the official website."}],"source":"vndb","sourceCharacterId":"c10260"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/059d49af815109448cf6a95ef6d5c4f199c45f69cb36a07a86491a5ff03d9490.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b88fc3933cb810b6891dfc251fa17ce3506fac487965488a0e081e241e0e22c.webp","width":256,"height":248,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10261","characterName":"藤代 嘆","sourceIds":{"vndbCharacterId":"c10261"},"originalCharacterName":"藤代 嘆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1019"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nageki is a quiet Mourning Dove that's always in the school library. Because he reads books all day, everyday, he apparently has no friends..."},{"spoiler":false,"text":"Based on the official website."}],"source":"vndb","sourceCharacterId":"c10261"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ef65aba31f3c5cbb17cf6d9e88b9a855aa1766f33a89a3c48ef08b18cd9a776.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac8f0cd409aae106ce38c3d55561510193e43f8b3e97fb187c7943d02143dc18.webp","width":256,"height":249,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10262","characterName":"尾呼 散","sourceIds":{"vndbCharacterId":"c10262"},"originalCharacterName":"尾呼 散","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"712"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nicknamed \"Okosan\", San is a strange and hyperactive Fantail Pigeon, and also Hiyoko's classmate. Despite his odd obsession with pudding and general eccentricity, San is brilliant at most sports, and is the incredibly fast-footed captain of the school's track team. He is unable to speak human languages; speaking in in-game translated \"coos\" instead. The \"pudding\" he mentions frequently is apparently different from your run-of-the-mill varieties..."},{"spoiler":false,"text":"Based on the official wesbite."}],"source":"vndb","sourceCharacterId":"c10262"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8af18a9ff67d3755ec439361dc11dd043ac42a9d88561e2cf0e757b22c76a434.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc0cc40563d5aa123dd66ca746c231d66f2af6ba651a500e0fc0d72af919829c.webp","width":256,"height":227,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10263","characterName":"朔夜・ル・ベル・銀","sourceIds":{"vndbCharacterId":"c10263"},"originalCharacterName":"朔夜・ル・ベル・銀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"623"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hiyoko's classmate, Sakuya is a French Fantail transfer student. From the pureblooded and noble Le Bel family, Sakuya looks down upon other birds as \"mongrels\". Hard to satisfy with an enormous pride, he's St. Pigeonation's able student council president. Before his transfer, he learned a great amount about Japanese culture."},{"spoiler":false,"text":"Based on the official website."}],"source":"vndb","sourceCharacterId":"c10263"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b94f7b7dabacc59960bf73d0a6b930eb0b5831ea092d2a5fb9d55a62c17b19b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a439f14b9bd761e393362bdd4baac3163fe447c9d7ba4b759b84add96fff41f.webp","width":256,"height":215,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10264","characterName":"坂咲 優夜","sourceIds":{"vndbCharacterId":"c10264"},"originalCharacterName":"坂咲 優夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"425"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuya is the older half-brother of Sakuya, and also a Fantail Pigeon. Infamous in St. Pigeonation for being a big flirt, he often misses his classes. Despite his lack of attendance, he can be seen frequently helping out the school's infirmary as Shuu's assistant."},{"spoiler":false,"text":"Based on the official website"}],"source":"vndb","sourceCharacterId":"c10264"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2899463b7b29bbd3f84ee985d04c4bda63cf933100c55a5e5f2b7d8e39af5ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb0d654ce77797e772b786f1e68c80524ff6067b9a00fb89e8ceb7f5da7e4f2d.webp","width":238,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10265","characterName":"岩峰 舟","sourceIds":{"vndbCharacterId":"c10265"},"originalCharacterName":"岩峰 舟","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1212"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Chukar Patridge school doctor of St. Pigeonation. Generally considered creepy by most of the student body due to his ability to seemingly appear out of nowhere and tendency to calmly and coolly deliver subtle threats (usually of the gory nature). There are even rumours that he \"experiments\" on the bird students. Putting his oddities aside, Shuu is a highly respected practitioner of medicine on a worldwide scale."},{"spoiler":false,"text":"Based on the official website"}],"source":"vndb","sourceCharacterId":"c10265"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57ce570995760babd70333b94a68b083e31ef71c9e65ea452e5c9f5aa76c1faf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/011b830d345c1009d4c6b0aa234c0a31cb30b3eed1228fcd6148129912f93b4e.webp","width":256,"height":228,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10291","characterName":"緋紅 アンヘル","sourceIds":{"vndbCharacterId":"c10291"},"originalCharacterName":"緋紅 アンヘル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"502"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A quirky Luzon Bleeding-heart dove that is a member of the school's manga club. Anghel is in the homeroom next to Hiyoko's (2nd Year, Class 2). He is a weird loner that speaks and refers to people as though he were in a video game. Anghel believes that he is an angel with a \"mission\", and that a destructive force is sealed within his chest."},{"spoiler":false,"text":"NOTE: He does not appear in the demo version of Heartful Boyfriend."},{"spoiler":false,"text":"Based on the official website."}],"source":"vndb","sourceCharacterId":"c10291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e86e25dfba1d5877036c3d60404805d32c431424d114628a92bdc47d081c0da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2693d460e4070ddeff06c9d6b1b2fbd9b2a88347e3eedfb27aeaec1d476c643.webp","width":256,"height":177,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10293","characterName":"漆原 健三郎","sourceIds":{"vndbCharacterId":"c10293"},"originalCharacterName":"漆原 健三郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kenzaburou is a gentlemanly parakeet who owns Torimi Café. He has a calm and humble personality and is quite a neat bird. Depending on certain choices, Hiyoko has the option of working for him. He appears in the summer side story."},{"spoiler":false,"text":"NOTE: Kenzaburou is a full version only character."},{"spoiler":false,"text":"Based on his Hatoful Boyfriend Wikia entry."}],"source":"vndb","sourceCharacterId":"c10293"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d30eaae5e93f6b27c63ddf2d8187f40b98d5ce468e615bc99191cac3963e88f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2405bfa3b52768cc33b3f72d93eb298533e20be9935cf721af7dfc7468959924.webp","width":233,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10294","characterName":"ラブ","sourceIds":{"vndbCharacterId":"c10294"},"originalCharacterName":"ラブ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rabu is a yellow budgeriger with a Kansai accent. He is a regular customer of Torimi cafe, which is owned by Kenzaburou. His manner of speech is similar to that of a gangster, which is an oddity in the classy Torimi Cafe. Currently he works as a chauffeur and goes to Torimi to relax before his shifts. He is said to be a very careful and reliable driver. He is part of a sidestory that is available during summer."},{"spoiler":false,"text":"NOTE: Rabu only appears in the full version."},{"spoiler":false,"text":"Taken from his Hatoful Boyfriend Wikia entry."}],"source":"vndb","sourceCharacterId":"c10294"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c2304b9c0b3089142a1a02b34c286dda7b26664a9575d458e592f0d85ed01c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7ee7afab8b23f0c257eecc92a49d74cc54da6be32c03daa88fa1ed0d3120448.webp","width":222,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10295","characterName":"緒根","sourceIds":{"vndbCharacterId":"c10295"},"originalCharacterName":"緒根","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One is a cockatiel that is St. Pigeonation's janitor."}],"source":"vndb","sourceCharacterId":"c10295"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8a9e4292eb5c66e86cbf0ce1f62dd6111c2e86aa1d9d49121eeb0bdbc45fe29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83b82c7d8a7803c5a86897067996a45970a5c2fb180245e814d51dcc59bf1a03.webp","width":256,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c94591","characterName":"錦小路 斗織","sourceIds":{"vndbCharacterId":"c94591"},"originalCharacterName":"錦小路 斗織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The editor-in-chief of Golden Weekly."},{"spoiler":true,"text":"He is a scientist who excels at weaponry. He used to work in the same lab as Shuu but was overshadowed by him and now seeks revenge."}],"source":"vndb","sourceCharacterId":"c94591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a172c48a5023c2184ccbe281d4da104dd7ea4aef261c305125b2172836582dad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65adecc13884d054425fa392161405a78b5cebeb39fc3d6849dd294f04e59c36.webp","width":241,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c94592","characterName":"華原 隆司","sourceIds":{"vndbCharacterId":"c94592"},"originalCharacterName":"華原 隆司","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryouta's father. He was a scientist who was close to Shuu."}],"source":"vndb","sourceCharacterId":"c94592"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8b3149d1349cf84f8cf9aa8bc3e201ec1327fb995fb08d954fe0db74ec04047.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29820e77dfabfe631b633b91fd4da56259cc8e73b30f68fa67bf77c9d530eab3.webp","width":254,"height":198,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c94593","characterName":"The Migrant","sourceIds":{"vndbCharacterId":"c94593"},"originalCharacterName":"The Migrant","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A traveler who is wandering among the stars."}],"source":"vndb","sourceCharacterId":"c94593"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://