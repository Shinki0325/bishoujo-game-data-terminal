l Sakuya, but Sakuya hired him so that he would only kill Sakuya on Sakuya's orders."}],"source":"vndb","sourceCharacterId":"c94595"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaf5977bc2028a2a781d3b8a2087d119715c90261ac761e6c585d2a91e79938d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e12cd6f7855f4a960daa0d5cbd1c302e0992ad9155a36893f9ecfc0764db11c.webp","width":255,"height":196,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:8799","sourceCompanyId":"egs:brand:8799","canonicalEntityId":"egs:brand:8799","name":"Hato-King","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:38181:8799","source":"egs"},{"companyId":"vndb:p15419","sourceCompanyId":"vndb:p15419","canonicalEntityId":"vndb:p15419","name":"花绿青","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:110761:v10570","source":"vndb"},{"companyId":"vndb:p16470","sourceCompanyId":"vndb:p16470","canonicalEntityId":"vndb:p16470","name":"Azad麻姑","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:110762:v10570","source":"vndb"},{"companyId":"vndb:p2205","sourceCompanyId":"vndb:p2205","canonicalEntityId":"vndb:p2205","name":"Moa","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:25160:v10570","source":"vndb"},{"companyId":"vndb:p2205","sourceCompanyId":"vndb:p2205","canonicalEntityId":"vndb:p2205","name":"Moa","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:28496:v10570","source":"vndb"},{"companyId":"vndb:p2205","sourceCompanyId":"vndb:p2205","canonicalEntityId":"vndb:p2205","name":"Moa","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:47439:v10570","source":"vndb"},{"com