ndb:s1686","name":"小島 秀夫","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:35679","source":"vndb"},{"creditedName":"木下 富晴","creatorId":"vndb:s1687","sourcePersonId":"vndb:s1687","canonicalEntityId":"vndb:s1687","name":"木下 富晴","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:35680","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c92236","characterName":"ジョナサン・イングラム","sourceIds":{"vndbCharacterId":"c92236"},"originalCharacterName":"ジョナサン・イングラム","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"30"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aged 55 (but physically 30). The protagonist. One of the five \"Original Cops\" (a nickname given in likeness to Project Mercury's \"Original Seven\") that comprised the Policenauts. He was stranded in space for 25 years after a space-walking accident, only to be found alive, cryogenically frozen in his \"survival ball\". He developed cosmophobia (a fear of outer space) after this incident and has remained on earth as a freelance P.I. in Old Los Angeles. He returns to Beyond Coast under Lorraine's request."},{"spoiler":false,"text":"from Fandom"}],"source":"vndb","sourceCharacterId":"c92236"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43b042371fbeb8754db2d4ada23a678db7ea2e771a5bb0c3cea5cf55a8d09ed2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fe0b38bd21099be54f73c897fff0c1c1b40885f1782a1262af75434fb1eb152.webp","width":211,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 秀幸","creatorId":"vndb:s6436","sourcePersonId":"vndb:s6436","canonicalEntityId":"vndb:s6436","name":"田中 秀幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19115","source":"vndb"}]},{"characterId":"char_vndb_c92237","characterName":"エド・ブラウン","sourceIds":{"vndbCharacterId":"c92237"},"originalCharacterName":"エド・ブラウン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"55"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The chief of Beyond Coast Police's Vice Unit. He was Jonathan's partner during their days in the LAPD and was also one of the Original Cops. He is a devoted father to both of his children, Anna and Marc. He renews his partnership with Jonathan after 28 long years to solve Lorraine's murder."},{"spoiler":false,"text":"From Fandom"}],"source":"vndb","sourceCharacterId":"c92237"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf4802aa7714c925b0858c8448f21e5c925b43c53a5ec552bc588a8c6f9df819.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8334d049d562aff8f8521744bc77a42f7a4b929464999b5963d57f680650a6d5.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飯塚 昭三","creatorId":"vndb:s502","sourcePersonId":"vndb:s502","canonicalEntityId":"vndb:s502","name":"飯塚 昭三","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19113","source":"vndb"}]},{"characterId":"char_vndb_c92238","characterName":"カレン・北条","sourceIds":{"vndbCharacterId":"c92238"},"originalCharacterName":"カレン・北条","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The heroine of the game. Daughter of Lorraine and Kenzo Houjou, she is a popular anchorwoman on Beyond and bears a striking resemblance to her mother. She's been diagnosed with secondary aplastic anemia."},{"spoiler":false,"text":"From Fandom"}],"source":"vndb","sourceCharacterId":"c92238"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0be298f51b112a547065603ae97e5032668f5252743a76a12043e0c44c0ecd6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/171feecd2829806eb31b60f7f5b2ed4e2a6489732393cacb71c27bb54e15accc.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 喜久子","creatorId":"vndb:s473","sourcePersonId":"vndb:s473","canonicalEntityId":"vndb:s473","name":"井上喜久子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19112","source":"vndb"}]},{"characterId":"char_vndb_c92239","characterName":"ジョゼフ・サダオキ・トクガワ","sourceIds":{"vndbCharacterId":"c92239"},"originalCharacterName":"ジョゼフ・サダオキ・トクガワ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"60"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Original Cops, he quit BCP many years ago in order to take over his family's company, the Tokugawa Group, following his father's retirement. He is the most powerful man on Beyond and wields considerable influence over the colony's media. He is also the chairman of the ISPA, the International Space Promotion Agency, Beyond's own space development project."},{"spoiler":false,"text":"From Fandom"}],"source":"vndb","sourceCharac