ceCharacterId":"20704","sourceWorkId":"27101","spoiler":false},{"segments":[{"spoiler":false,"text":"精鋭指揮官。階級は大佐。スターラベルはブルースター。"},{"spoiler":false,"text":"アントワーヌ・ド・サガンの上官であり、同期のレグルスと仲が良い。"},{"spoiler":false,"text":"顔に似合わず甘いものが大好き。"},{"spoiler":false,"text":"主人公である箱根羊介の祖父にあたる人物。"}],"source":"egs","sourceCharacterId":"20704","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"《ブルースター》と呼ばれた元軍人。"},{"spoiler":false,"text":"頬は裂け、顔は赤黒く爛れている。"},{"spoiler":false,"text":"一見乱暴者だが変なところで面倒見が良い。"},{"spoiler":false,"text":"膨大なセルエネルギーを持つエンゲージの天才。"},{"spoiler":false,"text":"かつてSTX軍のエースパイロットとして精鋭部隊の指揮をしていたが、"},{"spoiler":false,"text":"とある事情から軍を脱走した。"},{"spoiler":false,"text":"《封鎖区域》に逃げ込んでからは、そこに住む人々をコンスエロから守るため、"},{"spoiler":false,"text":"愛機のバトルシープである《修羅》を駆り、戦い続ける。"},{"spoiler":false,"text":"「俺ですら、自分が何者かわからないんだ。人間なのか、薔薇なのか……」"}],"source":"bangumi","sourceCharacterId":"77143"},{"segments":[{"spoiler":false,"text":"精鋭指揮官。階級は大佐。スターラベルはブルースター。"},{"spoiler":false,"text":"アントワーヌ・ド・サガンの上官であり、同期のレグルスと仲が良い。"},{"spoiler":false,"text":"顔に似合わず甘いものが大好き。"},{"spoiler":false,"text":"主人公である箱根羊介の祖父にあたる人物。"}],"source":"bangumi","sourceCharacterId":"81347"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62cd181166658e569b4fe7ac6e7e0cc8ce4933d55bd075a2f90d67834f22e4dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e24c113f493ea44e8550418e680c94f803baad8278bbd20b8e513bc8b0b8f29.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"須藤翔","creatorId":"vndb:s4816","sourcePersonId":"vndb:s4816","canonicalEntityId":"vndb:s4816","name":"やじまのぼる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:263799:77143:19281:1","source":"bangumi"}]},{"characterId":"char_c76168","characterName":"箱根ミリヤ","sourceIds":{"bangumi":[{"characterId":"77144","match":"exact-normalized-name-in-linked-work","subjectId":"263799"}],"egsCharacterIds":["20705"],"vndbCharacterId":"c76168"},"originalCharacterName":"箱根ミリヤ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I want to become a bona fide pilot and help the Red Zone as soon as I can...\""},{"spoiler":false,"text":"A top-scoring STX Space Force pilot, or Silver Star. With dreams of becoming a Battle-SHEEP combat pilot, she feels let down by her own innate lack of sel skills."},{"spoiler":false,"text":"Average but earnest, she relies on hard work alone."},{"spoiler":false,"text":"Pure at heart, but largely naive about the world."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c76168"},{"segments":[{"spoiler":false,"text":"《シルバースター》のラベルを持つ、ＳＴＸ軍の操縦士。"},{"spoiler":false,"text":"将来の夢はバトルシープに乗って《戦う操縦士》になることだが、セルエネルギーが精鋭操縦士の基準値に満たないことが悩み。"},{"spoiler":false,"text":"真面目なせいで損をしがちな努力の凡人。"},{"spoiler":false,"text":"夜鷹によって愛機である電気羊の《HAL》をオークションにかけられてしまう。"},{"spoiler":false,"text":"純粋で世間知らず。"}],"source":"egs","sourceCharacterId":"20705","sourceWorkId":"27101","spoiler":false},{"segments":[{"spoiler":false,"text":"《シルバースター》のラベルを持つ、STX軍の操縦士。"},{"spoiler":false,"text":"将来の夢はバトルシープに乗って《戦う操縦士》になることだが、"},{"spoiler":false,"text":"セルエネルギーが精鋭操縦士の基準値に満たないことが悩み。"},{"spoiler":false,"text":"真面目なせいで損をしがちな努力の凡人。"},{"spoiler":false,"text":"夜鷹によって愛機である電気羊の《HAL》をオークションにかけられてしまう。"},{"spoiler":false,"text":"純粋で世間知らず。"},{"spoiler":false,"text":"「いつか私も《戦う操縦士》になれるんだから」"}],"source":"bangumi","sourceCharacterId":"77144"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0746a5294ef2f8081cb54ca910d2bf520c505711b9459398a11ea74b17894ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/chara