":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"A painless death for these miserable sinners.\""},{"spoiler":false,"text":"A girl who bears the name \"Sanson,\" Executioner of Paris."},{"spoiler":false,"text":"Sanson came from a family of doctors and is known for inventing the guillotine."},{"spoiler":false,"text":"She presided over the execution of many famous people, including Marie Antoinette."},{"spoiler":false,"text":"From website"}],"source":"vndb","sourceCharacterId":"c95762"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa8bdd0504ac8583521070baeb21c1c5431937f12a57bf5c46c7ee0c45899d6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9762020e8a3dc757bd0712dffa4c644e44f6df1258971e8f11c2285fcf1bd4d.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ruiru","creatorId":"vndb:s30723","sourcePersonId":"vndb:s30723","canonicalEntityId":"vndb:s30723","name":"ruiru","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86863","source":"vndb"}]},{"characterId":"char_vndb_c95763","characterName":"シャーロット","sourceIds":{"vndbCharacterId":"c95763"},"originalCharacterName":"シャーロット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Sorry, Sir. I did not mean to step on your shoe.\""},{"spoiler":false,"text":"A dead person. A queen who was tragically executed during the French Revolution."},{"spoiler":false,"text":"Taken from English Official site"}],"source":"vndb","sourceCharacterId":"c95763"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.dat