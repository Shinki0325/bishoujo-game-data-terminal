{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"27373","model":{"presentationWorkId":"vndb:v28799","staff":{"artwork":[{"creditedName":"れかみえ","creatorId":"vndb:s24587","sourcePersonId":"vndb:s24587","canonicalEntityId":"vndb:s24587","name":"れかみえ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:167807","source":"vndb"}],"scenario":[{"creditedName":"れさお","creatorId":"vndb:s24588","sourcePersonId":"vndb:s24588","canonicalEntityId":"vndb:s24588","name":"れさお","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:167808","source":"vndb"}],"music":[{"creditedName":"煉獄庭園","creatorId":"vndb:s9674","sourcePersonId":"vndb:s9674","canonicalEntityId":"vndb:s9674","name":"煉獄庭園","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:167804","source":"vndb"}],"other":[{"creditedName":"Taira Komori","creatorId":"vndb:s14646","sourcePersonId":"vndb:s14646","canonicalEntityId":"vndb:s14646","name":"小森 平","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:167805","source":"vndb"},{"creditedName":"れかみえ","creatorId":"vndb:s24587","sourcePersonId":"vndb:s24587","canonicalEntityId":"vndb:s24587","name":"れかみえ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:167806","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c91713","characterName":"寺田 ありす","sourceIds":{"vndbCharacterId":"c91713"},"originalCharacterName":"寺田 ありす","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl living alone with her mother in the Hopefield apartment complex. Her treatment would be considered \"neglect\" by anyone with sound judgement."},{"spoiler":false,"text":"While she loves BUTA-CHA~, it would seem the financial situation of her household is too severe to allow for anything but $1 shop trinkets."},{"spoiler":false,"text":"As she is a half blood born between her Japanese mother and a foreign father, Alice has blonde hair and blue eyes. Because of this, she is an easy target for bullies at school, but due to some bad rumors, it would seem the school doesn't want anything to do with Alice's mother, and they do nothing about the bulling."},{"spoiler":false,"text":"Edited from the in-game character profile"}],"source":"vndb","sourceCharacterId":"c91713"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba247e8b5b4daf2a3f3043b57323dce085aa9c09d83ec0ed8ae8d5aedc63802e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8201fa8c207111866f7cf4059f24c2c19a273a8775acc2e1a4d1ef88a3c5199c.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大山 チロル","creatorId":"vndb:s996","sourcePersonId":"vndb:s996","canonicalEntityId":"vndb:s996","name":"英みらい(大山チロル、ひつじまる)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85257","source":"vndb"}]},{"characterId":"char_vndb_c94077","characterName":"白井 洋平","sourceIds":{"vndbCharacterId":"c94077"},"originalCharacterName":"白井 洋平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Going by the alias \"Mercenary\", Youhei is a freelance digital wiz who can do anything from design 101 to programming 999."},{"spoiler":false,"text":"While he had tried out working as a normal company employee, his superior skills and excellence in all fields made him the target of fierce bulling. Since that day, Youhei trusts no-one now and has worked freelance ever since."},{"spoiler":false,"text":"Just as his \"mercenary\" alias purports, he will quickly complete any task with a high level of quality. This has given him an edge on the competition and a name on the internet for the man to go for sudden and urgent job."},{"spoiler":false,"text":"It would seem he earns so much that it is odd he lives in such an apartment complex."},{"spoiler":false,"text":"From the in-game character profile"}],"source":"vndb","sourceCharacterId":"c94077"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4aebe53f7478f8a1efc425af5461b4a8da18cb43d1a5ca22a15529e06ef0905.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3553f1ae065e664154245bdc06c8ad025bac5ed340132fecb30795d387cebc2b.webp","width":174,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p9980","sourceCompanyId":"egs:brand:5083","canonicalEntityId":"vndb:p9980","name":"家庭菜園","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27373:5083","source":"egs"},{"companyId":"vndb:p9980","sourceCompanyId":"vndb:p9980","canonicalEntityId":"vndb:p9980","name":"家庭菜園","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:100724:v28799","source":"vndb"},{"companyId":"vndb:p9980","sourceCompanyId":"vndb:p9980","canonicalEntityId":"vndb:p9980","name":"家庭菜園","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:100727:v28799","source":"vndb"},{"companyId":"vndb:p9980","sourceCompanyId":"vndb:p9980","canonicalEntityId":"vndb:p9980","name":"家庭菜園","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:100728:v28