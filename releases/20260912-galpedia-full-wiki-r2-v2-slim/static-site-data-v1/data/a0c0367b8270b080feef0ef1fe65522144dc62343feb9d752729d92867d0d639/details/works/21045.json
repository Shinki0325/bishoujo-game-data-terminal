adata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"height":{"reviewState":"source-only","source":"vndb","value":"166"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: the Aquarium, qualifications, research"},{"spoiler":false,"text":"Dislike: sweets, old-fashioned thinking"},{"spoiler":false,"text":"Rieko is Aquarium staff. She has a good figure like a model, but her makeup and hair style make her look rigid."},{"spoiler":false,"text":"She is quite familiar with not only biology, but also management and marketing."},{"spoiler":false,"text":"Taken from Official Website"}],"source":"vndb","sourceCharacterId":"c39405"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f812ee7df28b0fed222902994ea562ff47675051dd43d8440396703d5769fc4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75b1efc2a518b8d149a2e9adc3ef1887f52546a2cf03d5653a02212ed74d79e7.webp","width":188,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c39406","characterName":"日吉 憲二","sourceIds":{"vndbCharacterId":"c39406"},"originalCharacterName":"日吉 憲二","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: baseball, children"},{"spoiler":false,"text":"Dislikes: drinking alcohol, games"},{"spoiler":false,"text":"He works in the Manten East building as a part time worker. He's still well-muscled from his history of sports."},{"spoiler":false,"text":"Kenji 