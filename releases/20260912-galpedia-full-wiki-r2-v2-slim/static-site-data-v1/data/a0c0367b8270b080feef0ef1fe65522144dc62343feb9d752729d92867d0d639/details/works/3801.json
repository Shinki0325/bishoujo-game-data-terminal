{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3801","model":{"presentationWorkId":"vndb:v9650","staff":{"artwork":[{"creditedName":"志水直隆(志水なおたか)","creatorId":"vndb:s2213","sourcePersonId":"egs:creator:71","canonicalEntityId":"vndb:s2213","name":"志水直隆(志水なおたか)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5859","source":"egs"},{"creditedName":"ごまさとし","creatorId":"vndb:s2557","sourcePersonId":"egs:creator:1432","canonicalEntityId":"vndb:s2557","name":"ごまさとし","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5860","source":"egs"},{"creditedName":"和馬村政(和馬村正)","creatorId":"vndb:s3586","sourcePersonId":"egs:creator:2161","canonicalEntityId":"vndb:s3586","name":"和馬村政(和馬村正)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5861","source":"egs"},{"creditedName":"さあぺんと(更紗)","creatorId":"vndb:s804","sourcePersonId":"egs:creator:1041","canonicalEntityId":"vndb:s804","name":"さあぺんと(更紗)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5862","source":"egs"},{"creditedName":"ますやまけい","creatorId":"vndb:s9916","sourcePersonId":"egs:creator:832","canonicalEntityId":"vndb:s9916","name":"ますやまけい","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5863","source":"egs"},{"creditedName":"庵西蘭","creatorId":"vndb:s9917","sourcePersonId":"egs:creator:2096","canonicalEntityId":"vndb:s9917","name":"庵西蘭","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5864","source":"egs"},{"creditedName":"AGA","creatorId":"vndb:s7040","sourcePersonId":"egs:creator:2146","canonicalEntityId":"vndb:s7040","name":"AGA","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5865","source":"egs"},{"creditedName":"オノメシン","creatorId":"vndb:s4990","sourcePersonId":"egs:creator:1786","canonicalEntityId":"vndb:s4990","name":"オノメシン","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6408","source":"egs"}],"scenario":[{"creditedName":"シナリオ制作チームさるさる","creatorId":"egs:creator:5656","sourcePersonId":"egs:creator:5656","canonicalEntityId":"egs:creator:5656","name":"シナリオ制作チームさるさる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:272915","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c51907","characterName":"五十嵐 優菜","sourceIds":{"bangumi":[{"characterId":"124638","match":"exact-normalized-name-in-linked-work","subjectId":"397347"}],"egsCharacterIds":["22775"],"vndbCharacterId":"c51907"},"originalCharacterName":"五十嵐 優菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「聖ミカエル総合病院」の看護婦で、現在は看護学校に実習講師として出向している正看護婦。"},{"spoiler":false,"text":"『尽くしてあげちゃう2～なんでもしちゃうの～』にも登場。"},{"spoiler":false,"text":"20代中半で主人公とはほぼ同年代。"},{"spoiler":false,"text":"しかし立ち振る舞いが大人びているので、主人公に対してもちょっとお姉さん風な感じで接する。"},{"spoiler":false,"text":"学生時代、一生を添い遂げようと誓った恋人が居たが、処女を捧げる前に交通事故で他界している。"},{"spoiler":false,"text":"以来失語症寸前の口数の少なさになってしまった。"},{"spoiler":false,"text":"主人公と話すときも、必要最低限の言葉しか話さない。"},{"spoiler":false,"text":"主人公には昔の恋人の面影があるらしく、初めはそれを追いかけるように主人公に接してくる。"},{"spoiler":false,"text":"しかし主人公への思いが特別なものに育つにつれて、愛おしさと同時に心中の悩みも大きくなってしまう。"},{"spoiler":false,"text":"相変わらずの「……（こくこく）」「……（ふるふる）」"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"1991","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の先輩でむつみとも仲がいい。"},{"spoiler":false,"text":"ほっそり清楚な感じだが、着やせするタイプなのか胸は結構ある。"},{"spoiler":false,"text":"物静かでお嬢様然とした雰囲気。"},{"spoiler":false,"text":"声が小さくて、おもわず守ってあげたくなりそう。"},{"spoiler":false,"text":"大の猫好きで、発見すると別人のように興奮する。"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"3684","spoiler":false},{"segments":[{"spoiler":false,"text":"『尽くしてあげちゃう2』、『看護しちゃうぞ2』に登場。"},{"spoiler":false,"text":"原画：志水直隆（トラヴュランス）"},{"spoiler":false,"text":"主人公の一つ年上の先輩で、むつみとも親しい。"},{"spoiler":false,"text":"真っ白い肌と穏やかで柔らかい物腰はいかにも「深窓の令嬢」と言う感じ。"},{"spoiler":false,"text":"中肉中背、胸は大きめ。癖のないストレートロングの黒髪、とろんとした瞳と太めの眉、大きな眼鏡がチャームポイント。"},{"spoiler":false,"text":"声も小さく、下級生である主人公達にも常に敬語を使う。"},{"spoiler":false,"text":"特に主人公に「お願い」をする際は、真っ赤な顔のまま彼の服の裾をつんつん引っ張る様な感じ。"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"3801","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の先輩で、むつみとも仲がいい。学業優秀で、一言でたとえるなら「深窓の令嬢」と言う感じ。"}],"source":"bangumi","sourceCharacterId":"124638"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/440f1d52d92e73cc25e4f360ec8fc1bcd720135f92699fb7c17e6b04156ca485.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28c5e0e22c990a2ccf7f0a65718d2d6fb9473611b9103d07cfa33769ec5fff37.webp","width":183,"height":220,"source":"static-detail"},"actors":[]},{"characterId":"char_c51926","characterName":"本木 るい","sourceIds":{"bangumi":[{"characterId":"141117","match":"exact-normalized-name-in-linked-work","subjectId":"348548"}],"egsCharacterIds":["22778"],"vndbCharacterId":"c51926"},"originalCharacterName":"本木 るい","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"金髪が自慢の資産家の娘。"},{"spoiler":false,"text":"子供扱いされのが大嫌いで、プライドも高く、すぐ怒り、すぐ吠える感情表現豊かな女の子。"},{"spoiler":false,"text":"美亜をライバル視し、熾烈な主人公争奪戦を繰り広げる。"},{"spoiler":false,"text":"そのため、美亜に負けたくないばかりに過激なエッチを主人公に求めてくる。"},{"spoiler":false,"text":"常に親友のクマのぬいぐるみ「ラインハルト」を抱いて離さない。"}],"source":"egs","sourceCharacterId":"22778","sourceWorkId":"2557","spoiler":false},{"segments":[{"spoiler":false,"text":"実家は資産家で、縦ロールの金髪が自慢のお嬢様。"},{"spoiler":false,"text":"相変わらず主人公をめぐり、美亜と熾烈な奪い合いを繰り広げる宿命のライバル。"},{"spoiler":false,"text":"身なりはやや少女趣味で、クマのぬいぐるみとかクマグッズが大好き。"},{"spoiler":false,"text":"常に親友のクマのぬいぐるみ「ラインハルト」を抱いて、手放さない。"},{"spoiler":false,"text":"大きくなってもすぐ怒る、すぐ吠えるという激情の持ち主。"},{"spoiler":false,"text":"でもホントは主人公に甘えたかったり。"},{"spoiler":false,"text":"美亜に負けたくないばっかりに、常に主人公に過激なエッチをおねだり。"},{"spoiler":false,"text":"両親に主人公と付合う事の了解を得て、正に「お嫁さんにして！」と切り込んでくる。"}],"source":"egs","sourceCharacterId":"22778","sourceWorkId":"3139","spoiler":false},{"segments":[{"spoiler":false,"text":"『ふくらみかけ りた～んず』、『ふくらみかけ2 ～ブラかえました～』に登場。"},{"spoiler":false,"text":"原画：ごまさとし（トラヴュランス）"},{"spoiler":false,"text":"実家は資産家で、縦ロールの金髪が自慢のお嬢様。"},{"spoiler":false,"text":"相変わらず主人公をめぐり、美亜（『ふくらみかけ』シリーズヒロイン）と熾烈な奪い合いを繰り広げる宿命のライバル。"},{"spoiler":false,"text":"身なりはやや少女趣味で、クマのぬいぐるみとかクマグッズが大好き。"},{"spoiler":false,"text":"常に親友のクマのぬいぐるみ「ラインハルト」を抱いて、手放さない。"}],"source":"egs","sourceCharacterId":"22778","sourceWorkId":"3801","spoiler":false},{"segments":[{"spoiler":false,"text":"実家は資産家で、縦ロールの金髪が自慢のお嬢様。"},{"spoiler":false,"text":"主人公をめぐり、美亜と熾烈な奪い合いを繰り広げる宿命のライバル（？）です。"},{"spoiler":false,"text":"身なりはやや少女趣味で、クマのぬいぐるみとかクマグッズが大好き。"},{"spoiler":false,"text":"常に親友のクマのぬいぐるみ「ラインハルト」を抱いて、手放さない。"},{"spoiler":false,"text":"○○扱いされるが嫌いで、すぐ怒る、すぐ吠えるという激情の持ち主。"},{"spoiler":false,"text":"でもホントは主人公に甘えたかったり・・・。"}],"source":"bangumi","sourceCharacterId":"141117"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bde322d9dce8bfcf50149edca31096093691ed03321c2aadd31ae0e208087d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dab6f180614d5be2da3150925f0c58419163e561b7c74f356026bbdf7dde76c.webp","width":256,"height":228,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51932","ch