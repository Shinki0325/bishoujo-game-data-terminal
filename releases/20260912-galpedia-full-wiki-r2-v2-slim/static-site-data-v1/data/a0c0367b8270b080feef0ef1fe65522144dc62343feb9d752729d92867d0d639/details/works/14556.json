iler":false,"text":"(From Liemyx's Eroge Blog)"}],"source":"vndb","sourceCharacterId":"c1153"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d1f9bb4ad7ee8b3c9848da672cdec7f1e464946d144d6f26e6ee6a517eb920a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69cba1c9f0dd27e662f0f0fcac206528464e974f86a417e9a561b990751119cf.webp","width":187,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部 順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32232","source":"vndb"}]},{"characterId":"char_vndb_c1154","characterName":"フランシス","sourceIds":{"vndbCharacterId":"c1154"},"originalCharacterName":"フランシス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Francis is probably the most quiet of the Roachrists and prefers spending time in the library reading. He’s very smart, a hard worker and he also gets bossed around by his older sister (Vivi). Francis and his sister are also the only two characters who originally come from Luche."},{"spoiler":false,"text":"(from Liemyx's Eroge Blog)"}],"source":"vndb","sourceCharacterId":"c1154"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/1512f93afe898240aadda7e4dfa0cf2b227c284c20cfcb1d0f3d1b5c56820e5f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ace5f717a4fb950b36