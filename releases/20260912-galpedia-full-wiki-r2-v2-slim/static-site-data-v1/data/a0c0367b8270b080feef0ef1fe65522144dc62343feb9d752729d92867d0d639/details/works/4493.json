","identityStatus":"source-native","relationId":"vndb:vn-staff:4419","source":"vndb"},{"creditedName":"菜摘 かんな","creatorId":"vndb:s3257","sourcePersonId":"vndb:s3257","canonicalEntityId":"vndb:s3257","name":"菜摘 かんな","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:4421","source":"vndb"},{"creditedName":"風之宮 そのえ","creatorId":"vndb:s5019","sourcePersonId":"vndb:s5019","canonicalEntityId":"vndb:s5019","name":"風之宮そのえ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4422","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c17307","characterName":"ゲオリク・ザベリスク","sourceIds":{"vndbCharacterId":"c17307"},"originalCharacterName":"ゲオリク・ザベリスク","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"195"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"72"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Former royal physician and Hardland's greatest swordsman. He left his work to move to the countryside in order to take care of his sick sister Lilith."},{"spoiler":false,"text":"\"...hasn't been having a good week. His sister is a talking head, his new boss is a sociopath, and he's constantly being pestered by the minions of hell and/or skeezy debt collectors. He wears eyeshadow, but in a manly way.\""},{"spoiler":false,"text":"Based on Hirameki's Official Site (Website is via webarchive)"}],"source":"vndb","sourceCharacterId":"c17307"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7e39da7bf4bf9de5d56074b92afc4329ae32d8c3eea440a49e0a5f2da173b4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fe0a6523f65f9a9e948811eb35244909d254a3cd8432b95d334408db94b5d55.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1434","source":"vndb"}]},{"characterId":"char_vndb_c17308","characterName":"リリス・ザベリスク","sourceIds":{"vndbCharacterId":"c17308"},"originalCharacterName":"リリス・ザベリスク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"138"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Georik's little sister. She was beheaded in a witch hunt, but her head remained alive and now she is living hidden in the cellar."},{"spoiler":false,"text":"\"...is Georik's goth-loli little sister. A run-in with a mob of angry villagers has left her without the usual complement of limbs - indeed, without any of the body parts usually found below the neck - so she has to live in the basement and get corpse-pieces sewn onto her on a semi-regular basis.\""},{"spoiler":false,"text":"Based on Hirameki's Official Site (Website is via webarchive)"}],"source":"vndb","sourceCharacterId":"c17308"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad843df955fcc2c72a49c8f09765824d3eb4f2f7c370b2d09f9327dea0917a48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95eaf44684d70ff9040e22e86fef6d27f125db96cf19c52b12bfd3ffc92bfcd5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1426","source":"vndb"}]},{"characterId":"char_vndb_c17309","characterName":"ジェルマン・カッセル","sourceIds":{"vndbCharacterId":"c17309"},"originalCharacterName":"ジェルマン・カッセル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Georik's childhood friend and Lilith's betrothed. He is Hardland's number one inventor and develops war robots, a work that he really doesn't like. He likes caramels and reading adventure novels."},{"spoiler":false,"text":"\"...wants to build robots, but the fun kind of robots, not the kind that kill people. Unfortunately, he's been recruited for some secret military project, so you can guess which kind of robots he actually builds. He's also Lillith's fiance, but their relationship has hit a snag with the whole \"disembodied head\" thing.\""},{"spoiler":false,"text":"Based on Hirameki's Official Site (Website is via webarchive)"}],"source":"vndb","sourceCharacterId":"c17309"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ad7d76ab23a253e2ab5b676939c39a9a5be9e88f0ada2f8a28a77b3014728d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c5026dbc0780e4456ecc319ad8a76afacb58cdd3ad714d34cd4ce822a99bd9e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石田 彰","creatorId":"vndb:s74","sourcePersonId":"vndb:s74","canonicalEntityId":"vndb:s74","name":"石田 彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1429","source":"vndb"}]},{"characterId":"char_vndb_c17310","characterName":"ミハエル・ランフト","sourceIds":{"vndbCharacterId":"c17310"},"originalCharacterName":"ミハエル・ランフト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Georik's childhood friend and rival. As the captain of the Royal Guard, he takes his work very seriously."},{"spoiler":false,"text":"\"...has hobbies ranging from \"going to church\" to \"harassing Georik into going to church.\" For a change of pace, he also likes to start barfights. He's theoretically Georik's best friend, but in a resentful, insecure, \"why can't I be better than you?\" way.\""},{"spoiler":false,"text":"Based on Hirameki's Official Site (Website is via webarchive)"}],"source":"vndb","sourceCharacterId":"c17310"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/baa3be0905efd14ca4b07c6f701808c47013961a5ac12b2ef6bbf3da178c06ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9df8c3f1018a62856b6d64208dcc6d7332713b9a1fd2018f463063f72f1858f5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緑川 光","creatorId":"vndb:s73","sourcePersonId":"vndb:s73","canonicalEntityId":"vndb:s73","name":"緑川 光","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1428","source":"vndb"}]},{"characterId":"char_vndb_c17311","characterName":"ヤン・ファン・リュースブルグ","sourceIds":{"vndbCharacterId":"c17311"},"originalCharacterName":"ヤン・ファン・リュースブルグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious and powerful medium. He owns a shop called Golden Goose, where he sells illegal alchemy and magic supplies. A member of the Hell-Fire Club."},{"spoiler":true,"text":"Also known as Cantarella, the assassin who kills with a kiss."},{"spoiler":false,"text":"\"...sees dead people. When he isn't busy exorcising restless spirits and having a dark secret, he runs some sort of alchemical supply shop-cum-manicure parlor. Okay, I made up the manicure parlor thing, but have you seen his nails? I rest my case.\""},{"spoiler":false,"text":"Based on Hirameki's Official Site (Website is via webarchive)"}],"source":"vndb","sourceCharacterId":"c17311"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e3227f614c45133551d020b4702ed1f54a08fe96bd1d0304f644e2693b565fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63d2290554b89c467ac50f19ffd86f7a926f06c841c7be38117fe82a1b723f7f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緒方 恵美","creatorId":"vndb:s611","sourcePersonId":"vndb:s611","canonicalEntityId":"vndb:s611","name":"緒方 恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1432","source":"vndb"}]},{"characterId":"char_vndb_c17312","characterName":"フランシス・ダッシュウッド","sourceIds":{"vndbCharacterId":"c17312"},"originalCharacterName":"フランシス・ダッシュウッド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","