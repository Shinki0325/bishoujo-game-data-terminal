{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"38216","model":{"presentationWorkId":"vndb:v55256","staff":{"artwork":[{"creditedName":"日向奈尾(ひなたなお)","creatorId":"vndb:s4203","sourcePersonId":"egs:creator:16294","canonicalEntityId":"vndb:s4203","name":"日向奈尾(ひなたなお)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290990","source":"egs"},{"creditedName":"まりオイル","creatorId":"vndb:s25564","sourcePersonId":"egs:creator:23373","canonicalEntityId":"vndb:s25564","name":"まりオイル","detail":"SDキャラクター","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290991","source":"egs"}],"scenario":[{"creditedName":"木葉尽","creatorId":"vndb:s15617","sourcePersonId":"egs:creator:32413","canonicalEntityId":"vndb:s15617","name":"木葉尽","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290992","source":"egs"},{"creditedName":"泰良則充","creatorId":"vndb:s10528","sourcePersonId":"egs:creator:27934","canonicalEntityId":"vndb:s10528","name":"泰良則充","detail":"おまけパート","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290993","source":"egs"}],"music":[{"creditedName":"橋咲 透","creatorId":"vndb:s4510","sourcePersonId":"vndb:s4510","canonicalEntityId":"vndb:s4510","name":"橋咲 透","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:214610","source":"vndb"}],"other":[{"creditedName":"夢乃ゆき","creatorId":"vndb:s4363","sourcePersonId":"egs:creator:21363","canonicalEntityId":"vndb:s4363","name":"夢乃ゆき","detail":"OP曲「愛のパズル」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290998","source":"egs"},{"creditedName":"与呼太(yokota)","creatorId":"vndb:s4680","sourcePersonId":"egs:creator:17287","canonicalEntityId":"vndb:s4680","name":"与呼太(yokota)","detail":"ムービー制作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290999","source":"egs"},{"creditedName":"呉(呉一郎)","creatorId":"vndb:s507","sourcePersonId":"egs:creator:166","canonicalEntityId":"vndb:s507","name":"呉(呉一郎)","detail":"企画・原案","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:291000","source":"egs"},{"creditedName":"小春めう","creatorId":"vndb:s1971","sourcePersonId":"egs:creator:18951","canonicalEntityId":"vndb:s1971","name":"小春めう","detail":"ED曲「singing!」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:297448","source":"egs"},{"creditedName":"Pomelo","creatorId":"vndb:s32404","sourcePersonId":"vndb:s32404","canonicalEntityId":"vndb:s32404","name":"Pomelo","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:214603","source":"vndb"},{"creditedName":"呉","creatorId":"vndb:s507","sourcePersonId":"vndb:s507","canonicalEntityId":"vndb:s507","name":"呉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:214604","source":"vndb"},{"creditedName":"小春 めう","creatorId":"vndb:s1971","sourcePersonId":"vndb:s1971","canonicalEntityId":"vndb:s1971","name":"小春 めう","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:214605","source":"vndb"},{"creditedName":"日向 奈尾","creatorId":"vndb:s4203","sourcePersonId":"vndb:s4203","canonicalEntityId":"vndb:s4203","name":"日向奈尾(ひなたなお)","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:214606","source":"vndb"},{"creditedName":"天ヶ咲 麗","creatorId":"vndb:s4314","sourcePersonId":"vndb:s4314","canonicalEntityId":"vndb:s4314","name":"天ヶ咲 麗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:214608","source":"vndb"},{"creditedName":"夢乃 ゆき","creatorId":"vndb:s4363","sourcePersonId":"vndb:s4363","canonicalEntityId":"vndb:s4363","name":"夢乃 ゆき","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:214609","source":"vndb"}]},"cast":[{"characterId":"char_c150328","characterName":"冥林 月子","sourceIds":{"bangumi":[{"characterId":"173003","match":"exact-normalized-name-in-linked-work","subjectId":"545371"}],"egsCharacterIds":["27809"],"vndbCharacterId":"c150328"},"originalCharacterName":"冥林 月子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"平均くらい"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Girl Who Can \"See Them.\""},{"spoiler":false,"text":"SR Evaluation Value: 7/10"},{"spoiler":false,"text":"Occupation: Second-year student"},{"spoiler":false,"text":"Height: About average"},{"spoiler":false,"text":"Bust: Large"},{"spoiler":false,"text":"A girl who \"sees things.\" What exactly? Ghosts. Because of this, her daily life is full of struggles. She isn’t naturally a gloomy person, but due to her unique ability, she has spent most of her time with her head down, avoiding others."},{"spoiler":false,"text":"The truth is, when she smiles, she’s incredibly cute, but she hasn’t been able to truly laugh."},{"spoiler":false,"text":"To come to terms with her ability and be able to smile honestly, she must \"grow.\" It was at that moment that she encountered the protagonist, who had just arrived at the academy."},{"spoiler":false,"text":"What kind of girl is she?"},{"spoiler":false,"text":"She is always looking down, which at first glance makes her seem gloomy. However, this is only because she is troubled by the ghosts she can see. In reality, she is a bright and kind-hearted girl."},{"spoiler":false,"text":"「I can see them anytime, anywhere...」"}],"source":"vndb","sourceCharacterId":"c150328"},{"segments":[{"spoiler":false,"text":"“見えちゃう”女の子。何を？　幽霊を。そのせいで日々困って暮らしている。本来は暗い性格でもないのだが、自身の異能ゆえに、俯いてばかりいた。本当は笑ったらとても可愛らしいのに、笑うことができないでいた。自身の異能に折り合いを付けて、素直に笑えるようになるには、“伸びる”ことこそ大事らしい…。そんなとき、学園へとやってきた主人公と出会うのだった。"}],"source":"egs","sourceCharacterId":"27809","sourceWorkId":"38216","spoiler":false},{"segments":[{"spoiler":false,"text":"“見えちゃう”女の子。何を？　幽霊を。そのせいで日々困って暮らしている。本来は暗い性格でもないのだが、自身の異能ゆえに、俯いてばかりいた。本当は笑ったらとても可愛らしいのに、笑うことができないでいた。自身の異能に折り合いを付けて、素直に笑えるようになるには、“伸びる”ことこそ大事らしい…。そんなとき、学園へとやってきた主人公と出会うのだった。"}],"source":"bangumi","sourceCharacterId":"173003"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"173003","value":"２年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35f9c384c3b3a4492803ac9cc97e521fd9d23ece8e568ead0c1db69095619232.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df8c94868175b7bd728c4c53df35890ff6989af125c219d0bf1c65a459e9882c.webp","width":126,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花月さや","creatorId":"vndb:s23345","sourcePersonId":"vndb:s23345","canonicalEntityId":"vndb:s23345","name":"花月さや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:545371:173003:40638:1","source":"bangumi"}]},{"characterId":"char_c150329","characterName":"天戸原 日乃魅","sourceIds":{"bangumi":[{"characterId":"173002","match":"exact-normalized-name-in-linked-work","subjectId":"545371"}],"egsCharacterIds":["27808"],"vndbCharacterId":"c150329"},"originalCharacterName":"天戸原 日乃魅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"平均くらい"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Princess Reincarnated in Another World"},{"spoiler":false,"text":"SR Evaluation Value: 10/10"},{"spoiler":false,"text":"Occupation: Second-year student"},{"spoiler":false,"text":"Height:About average"},{"spoiler":false,"text":"Bust:Extremely large"},{"spoiler":false,"text":"Far beyond the dimensions of the world we live in lies another realm—Laurentide. At the heart of Laurentide stands the Divine Nation of Amato, ruled by the descendants of the heavens."},{"spoiler":false,"text":"Hinomi was a princess of Amato. However..."},{"spoiler":false,"text":"Due to an unexpected twist of fate, she found herself reincarnated into another world, descending upon Earth—Japan. During this otherworldly reincarnation, she lost the mystical power she once possessed."},{"spoiler":false,"text":"To return to her original world, she must \"grow.\""},{"spoiler":false,"text":"It was at that moment that she encountered the protagonist, who had just arrived at the academy."},{"spoiler":false,"text":"What kind of girl is she?"},{"spoiler":false,"text":"Being of noble birth, she possesses a strong sense of pride and dignity. At first, she struggles to adapt to this world, but as she interacts with the protagonist, she gradually begins to change."},{"spoiler":false,"text":"Though she is a princess, she is surprisingly very curious about lewd things."},{"spoiler":false,"text":"「Love me with all your heart and soul. In return, I shall bring you pleasure...」"}],"source":"vndb","sourceCharacterId":"c150329"},{"segments":[{"spoiler":false,"text":"我々が暮らす地球から遠く次元を隔てた異世界、ローレンタイド。そのローレンタイドの中心に、天からの子孫がしろしめす（治める、の意）神国アマトが存在する。日乃魅は、そのアマト国のお姫様だった。なのだが…。ひょんなことから異世界転生をしてしまい、我々が暮らす地球・日本へと降臨する。異世界転生の際、元々持っていた妖力を失ってしまい、元いた世界に戻るには、“伸びる”しかない。そんなとき、学園へとやってきた主人公と出会うのだった。"}],"source":"egs","sourceCharacterId":"27808","sourceWorkId":"38216","spoiler":false},{"segments":[{"spoiler":false,"text":"我々が暮らす地球から遠く次元を隔てた異世界、ローレンタイド。そのローレンタイドの中心に、天からの子孫がしろしめす（治める、の意）神国アマトが存在する。日乃魅は、そのアマト国のお姫様だった。なのだが…。ひょんなことから異世界転生をしてしまい、我々が暮らす地球・日本へと降臨する。異世界転生の際、元々持っていた妖力を失ってしまい、元いた世界に戻るには、“伸びる”しかない。そんなとき、学園へとやってきた主人公と出会うのだった。"}],"source":"bangumi","sourceCharacterId":"173002"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"173002","value":"２年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b23355b6324d09db489ced0377985e117a519dac79abed7725e63029b8de1e23.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61be293aa0ead7c004004ff5d2b257a5f0b371988b54ed470fc454d8428fc0c2.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:545371:173002:15684:1","source":"bangumi"}]},{"characterId":"char_c150330","characterName":"後宮 深果梨","sourceIds":{"bangumi":[{"characterId":"173004","match":"exact-normalized-name-in-linked-work","subjectId":"545371"}],"egsCharacterIds":["27810"],"vndbCharacterId":"c150330"},"originalCharacterName":"後宮 深果梨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"小さい"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Magical Girl ☆ Mikarin"},{"spoiler":false,"text":"SR Evaluation Value: 9/10"},{"spoiler":false,"text":"Occupation:First-year student"},{"spoiler":false,"text":"Height:Short"},{"spoiler":false,"text":"Bust:Large"},{"spoiler":false,"text":"She channels the thoughts and wishes of people into her magical staff, battling evil demons day and night—that is the duty of Magical Girl ☆ Mikarin."},{"spoiler":false,"text":"However… the most important thing, \"thoughts and wishes,\" aren’t reaching her."},{"spoiler":false,"text":"Without those, her magical staff becomes clouded, losing its power and turning into nothing more than a regular stick…"},{"spoiler":false,"text":"Up until now, Mikarin (Mikari) has fought alone, but she has come to realize that for her to truly shine as a magical girl, she needs a dependable assistant. It was at that moment that she met the protagonist, who had just arrived at the academy."},{"spoiler":false,"text":"What kind of girl is she?"},{"spoiler":false,"text":"A cheerful and optimistic girl. To gather the warm feelings and wishes of people, she runs the \"Magical Girl ☆ Mikarin\" official channel. However, at the moment, she receives more cold comments than warm ones, leading to daily comment battles (flame wars)."},{"spoiler":false,"text":"「I've got a reliable assistant now! ☆」"}],"source":"vndb","sourceCharacterId":"c150330"},{"segments":[{"spoiler":false,"text":"魔法のステッキに人々の想いを込めて、日夜、悪いアクマを退治する。それが、魔法少女☆ミカリン。だがしかし…肝心の“想い”が届かない。“想い”がないと、魔法のステッキも曇ってしまって、ただの棒となってしまう…。深果梨はこれまで一人で活動を続けてきたが、魔法少女としての更なる活躍には、頼りになる助手が必要…と本人は考えていた。そんなとき、学園へとやってきた主人公と出会うのだった。"}],"source":"egs","sourceCharacterId":"27810","sourceWorkId":"38216","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法のステッキに人々の想いを込めて、日夜、悪いアクマを退治する。それが、魔法少女☆ミカリン。だがしかし…肝心の“想い”が届かない。“想い”がないと、魔法のステッキも曇ってしまって、ただの棒となってしまう…。深果梨はこれまで一人で活動を続けてきたが、魔法少女としての更なる活躍には、頼りになる助手が必要…と本人は考えていた。そんなとき、学園へとやってきた主人公と出会うのだった。"}],"source":"bangumi","sourceCharacterId":"173004"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"173004","value":"１年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1df2c86730989633a55d6add305506c9300d92e1ce7dfef6dc492a091d766b6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4760a3ecc80add270ad2df5611221c719c59d5d51154b41237bcd512f6a4688b.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚木雪那","creatorId":"vndb:s22613","sourcePersonId":"vndb:s22613","canonicalEntityId":"vndb:s22613","name":"柚木 雪那","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:545371:173004:44177:1","source":"bangumi"}]},{"characterId":"char_c150331","characterName":"麓天 音遠","sourceIds":{"bangumi":[{"characterId":"173005","match":"exact-normalized-name-in-linked-work","subjectId":"545371"}],"egsCharacterIds":["27811"],"vndbCharacterId":"c150331"},"originalCharacterName":"麓天 音遠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"やや高い"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Promised Messiah"},{"spoiler":false,"text":"SR Evaluation Value: Unmeasurable"},{"spoiler":false,"text":"Occupation: Third-year student"},{"spoiler":false,"text":"Height: Slightly tall"},{"spoiler":false,"text":"Bust: Large"},{"spoiler":false,"text":"She is actually the protagonist’s childhood friend. Since they were young, they had always felt a subtle attraction toward each other. However, one day, she suddenly disappeared without a trace, and since then, there had been no contact. The protagonist had always wondered about her, but…"},{"spoiler":false,"text":"It turns out that Neon is destined to save the world—a Messiah."},{"spoiler":false,"text":"That said, she herself has absolutely no intention of playing that role. Perhaps, if she \"grows\" as an SR, she might come to accept her fate as the Messiah."},{"spoiler":false,"text":"It was at that moment that she reunited with the protagonist, who had just arrived at the academy."},{"spoiler":false,"text":"What kind of girl is she?"},{"spoiler":false,"text":"Growing up in a unique family environment, she developed a somewhat blunt and curt personality. She prefers cats over humans. Despite this, the protagonist has been the one person she has admired since childhood. As things stand now, the idea of becoming a Messiah is the last thing she wants."},{"spoiler":false,"text":"「Being loved by everyone... it's disgusting, isn't it?」"}],"source":"vndb","sourceCharacterId":"c150331"},{"segments":[{"spoiler":false,"text":"実は主人公の幼なじみの女の子。幼い頃から、お互い、ほのかに惹かれ合っていた。ところが、音遠は突然姿を消してしまい、それっきり音信不通となっていた。主人公もずっと気にかけていたのだが…。音遠は、将来世界を救うことになる、救世主（メシア）…であるらしい。もっとも、音遠自身にそんな気はまるでないのだが。もし、ＳＲとして伸びれば、救世主の自覚も生まれるかもしれない。そんなとき、学園へとやってきた主人公と再会するのだった。"}],"source":"egs","sourceCharacterId":"27811","sourceWorkId":"38216","spoiler":false},{"segments":[{"spoiler":false,"text":"実は主人公の幼なじみの女の子。幼い頃から、お互い、ほのかに惹かれ合っていた。ところが、音遠は突然姿を消してしまい、それっきり音信不通となっていた。主人公もずっと気にかけていたのだが…。音遠は、将来世界を救うことになる、救世主（メシア）…であるらしい。もっとも、音遠自身にそんな気はまるでないのだが。もし、ＳＲとして伸びれば、救世主の自覚も生まれるかもしれない。そんなとき、学園へとやってきた主人公と再会するのだった。"}],"source":"bangumi","sourceCharacterId":"173005"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"173005","value":"３年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78f6c7b42358be6d0f22fc9926c71666798ef03b73441a08a93bff00f9876516.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86e96b1fac6abaa2577b3bbc8126652cdd0d05ce273e99a2a2a5dcec1d324ff5.webp","width":137,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原由林","creatorId":"vndb:s992","sourcePersonId":"vndb:s992","canonicalEntityId":"vndb:s992","name":"藤原 由林","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:545371:173005:25037:1","source":"bangumi"}]},{"characterId":"char_vndb_c150333","characterName":"高遠 光希","sourceIds":{"vndbCharacterId":"c150333"},"originalCharacterName":"高遠 光希","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1630","sourceCompanyId":"egs:brand:2765","canonicalEntityId":"vndb:p1630","name":"MOONSTONE Cherry","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:38216:2765","source":"egs"},{"companyId":"vndb:p251","sourceCompanyId":"vndb:p251","canonicalEntityId":"vndb:p251","name":"MOONSTONE","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:144282:v55256","source":"vndb"},{"companyId":"vndb:p1630","sourceCompanyId":"vndb:p1630","canonicalEntityId":"vndb:p1630","name":"MOONSTONE Cherry","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:144283:v55256","source":"vndb"},{"companyId":"vndb:p251","sourceCompanyId":"vndb:p251","canonicalEntityId":"vndb:p251","name":"MOONSTONE","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:151633:v55256","source":"vndb"},{"companyId":"vndb:p1630","sourceCompanyId":"vndb:p1630","canonicalEntityId":"vndb:p1630","name":"MOONSTONE Cherry","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:151634:v55256","source":"vndb"},{"companyId":"vndb:p28758","sourceCompanyId":"vndb:p28758","canonicalEntityId":"vndb:p28758","name":"CarbyneX","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:160585:v55256","source":"vndb"},{"companyId":"vndb:p23771","sourceCompanyId":"vndb:p23771","canonicalEntityId":"vndb:p23771","name":"Kagami Games","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:171488:v55256","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
