umi","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"駿林学園の1年生。主人公の一年下の後輩。"},{"spoiler":false,"text":"態度・言動ともに尊大で妙に時代がかっている。"},{"spoiler":false,"text":"発育が悪く、義務教育中に間違われることもしばしば。"},{"spoiler":false,"text":"「魔法少女まじかるそふりん！性器を隠さぬ悪徳メーカーは、回収ビームで社会的制裁よ！」"}],"source":"egs","sourceCharacterId":"16800","sourceWorkId":"11282","spoiler":false},{"segments":[{"spoiler":false,"text":"駿林学園の1年生。主人公の一年下の後輩。"},{"spoiler":false,"text":"淫乱で素直クール。"},{"spoiler":false,"text":"変わった人、とその学年では名が知れている。"},{"spoiler":false,"text":"態度・言動ともに尊大で妙に時代がかっていて、周囲の反応にもひたすらクールで気にする様子なし。"},{"spoiler":false,"text":"「人一倍、エロい」と自認している淫乱っ娘。"},{"spoiler":false,"text":"加えて、「人が恋愛する以上、性交はあって当然なモノ」という考えのため、性愛に対する羞恥心がまったくない。"},{"spoiler":false,"text":"あたり構わず下ネタをぶちかまして周りの居心地を悪くさせるが、本人は至って真面目に言っている。"},{"spoiler":false,"text":"発育が悪く、義務教育中に間違われることもしばしば。"},{"spoiler":false,"text":"一人称は「自分」、主人公の事は「お前」と呼ぶ。"}],"source":"bangumi","sourceCharacterId":"53718"}],"profileFacts":[{"label":"胸围（本版本）","value":"67 cm","valueContext":null,"source":"egs","sourceCharacterId":"16800","sourceWorkId":"11282","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"69 cm","valueContext":null,"source":"egs","sourceCharacterId":"16800","sourceWorkId":"11282","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"16800","sourceWorkId":"11282","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f3bf9f661c0c6958cf3c88b416a169376a2c9453e577098f6ed0fe1d59a2a0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f14c58cdcfb9aa4523c71fa4f39494226ad142757e477f8d68da5b665cadb393.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","iden