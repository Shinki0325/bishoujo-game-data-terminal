only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Polish Exorcist"}],"source":"vndb","sourceCharacterId":"c18297"},{"segments":[{"spoiler":false,"text":"ポーランド人の優秀な女エクソシスト。"},{"spoiler":false,"text":"主人公とチームを組んで仕事を行うことが多い良きパートナー。"},{"spoiler":false,"text":"東洋人ながら非凡な才能を持つ主人公をライバル視しながらも、その力を認め尊敬している。"},{"spoiler":false,"text":"感情表現に乏しく、クールな印象を与える彼女だが、主人公が苦戦する事件を手助けするべく来日するなど、意外に情に厚いところも。"}],"source":"egs","sourceCharacterId":"26230","sourceWorkId":"6367","spoiler":false},{"segments":[{"spoiler":false,"text":"シスターであり、優秀なエクソシスト。ポーランド人。"},{"spoiler":false,"text":"主人公をライバル視しているが、その一方で、高い才能を持ち東洋人にも関わらず一線で活躍する彼を尊敬もしている。"},{"spoiler":false,"text":"恋愛をタブー視し、神の教えに準じようとしている。"}],"source":"bangumi","sourceCharacterId":"151091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eeaf5897bc42f8c7cb650043457571713a1d4f706782282df7ae612967ebadb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffa15edc947e8bc14a4d8b53cfb744f2140a5c6db7df9d0c568ac7179183e535.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:199453:151091:5669:1","source":"bangumi"}]},{"characterId":"char_c18298","characterName":"羽白 沙織","sourceIds":{"bangumi":[{"characterId":"151089","match":"exact-normalized-name-in-linked-work","subjectId":"199453"}],"egsCharacterIds":["26228"],"vndbCharacterId":"c18298"},"originalCharacterName":"羽白 沙織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hashiro Mana's and Hashiro Aya's mother."}],"source":"vndb","sourceCharacterId":"c18298"},{"segments":[{"spoiler":false,"text":"聖マダレナ女学院の院長にして、双子の姉妹の母。"},{"spoiler":false,"text":"夫は十年前に亡くし、未亡人。"},{"spoiler":false,"text":"おっとり心優しい性格。"},{"spoiler":false,"text":"二人の子供がいるとは思えないほど若く美しく、時折見せる少女っぽい仕草や言動がそれに拍車をかけている。"},{"spoiler":false,"text":"過去に孤児を引き取る施設を運営しており、主人公はその施設の出身。"},{"spoiler":false,"text":"幼かった主人公の才能を見抜き、その将来の指針を与えた人物でもある。"}],"source":"egs","sourceCharacterId":"26228","sourceWorkId":"6367","spoiler":false},{"segments":[{"spoiler":false,"text":"姉妹の母親。年齢を感じさせない美人。夫は十年近く前に亡くしている。"},{"spoiler":false,"text":"昔は孤児を引き取る施設を営む一方で教会を運営していた。現在は教会で引き取る孤児の数が減ったこともあり、教会なりの斡旋で今はミッション系の学園で校長をしている。"},{"spoiler":false,"text":"主人公の才能を見抜いた人物だが、自身の才能はあまりなく悪魔関係にも疎い。"},{"spoiler":false,"text":"心優しいおっとりした女性。"}],"source":"bangumi","sourceCharacterId":"151089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51849946fce1ceab48e4bd0a8e1a27d5a09a65b33aea63ab56cbc1b06f942f39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7648e7a8df656112425dda7999a7d28628ec550d22f3eff266cd73b9039ab5e.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:199453:151089:5741:1","source":"bangumi"}]},{"characterId":"char_c18299","characterName":"月岬 礼美","sourceIds":{"bangumi":[{"characterId":"151090","match":"exact-normalized-name-in-linked-work","subjectId":"199453"}],"egsCharacterIds":["26229"],"vndbCharacterId":"c18299"},"originalCharacterName":"月岬 礼美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"摩菜の後輩。"},{"spoiler":false,"text":"一見すると、清楚なお嬢様だが、その性格は高飛車で傲慢。"},{"spoiler":false,"text":"「オカルト研究会」に入会したのは、憧れている摩菜と一緒に居たかったから。"},{"spoiler":false,"text":"摩菜に特別な感情を抱いているらしく、摩菜に親しく接する主人公にあからさまな敵愾心を向ける。"}],"source":"egs","sourceCharacterId":"26229","sourceWorkId":"6367","spoiler":false},{"segments":[{"spoiler":false,"text":"ステレオタイプのたかびーお嬢様。摩菜に憧れ文芸部(と言う名のオカルト同好会)に所属。見た目は清楚な、美人タイプ。"},{"spoiler":false,"text":"レズビアンで、摩菜と親しくなれなれしい態度の主人公には敵愾心むきだし。"}],"source":"bangumi","sourceCharacterId":"151090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acae7ebe4e717f1420264eca54e48bddee0691a96889c3f1330d0db55452bb80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcfcc0db1a95106e298e9379deb3c97d52037741059567fe987d85aa71a08b15.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:199453:151090:4489:1","source":"bangumi"}]},{"characterId":"char_c18300","characterName":"羽白 綾","sourceIds":{"bangumi":[{"characterId":"151087","match":"exact-normalized-name-in-linked-work","subjectId":"199453"}],"egsCharacterIds":["26226"],"vndbCharacterId":"c18300"},"originalCharacterName":"羽白 綾","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hashiro Mana's older sister and Hashiro Saori's daughter."}],"source":"vndb","sourceCharacterId":"c18300"},{"segments":[{"spoiler":false,"text":"双子の妹。"},{"spoiler":false,"text":"姉の摩菜とは対照的に明るく活発な性格。"},{"spoiler":false,"text":"学園でも常に中心にいるような女の子。"},{"spoiler":false,"text":"勉強は苦手だが、体を動かすことは大好きで、チアリーディング部に所属している。"},{"spoiler":false,"text":"しっかりしているようで、子供っぽい。"},{"spoiler":false,"text":"悪魔に憑依された姉に、その悪魔の種子を植え込まれ、性欲が激しくなってしまっている。"}],"source":"egs","sourceCharacterId":"26226","sourceWorkId":"6367","spoiler":false},{"segments":[{"spoiler":false,"text":"妹。活発でさっぱりした性格の女の子。しかし、学園では周りに合わせておすましぶっている。"},{"spoiler":false,"text":"頑張りやだが勉強は苦手。また、かなりの怖がりで、悪魔的な話も自ら避けている。"},{"spoiler":false,"text":"姉が取り付かれた悪魔から、悪魔の種子を植え込まれてしまう。"}],"source":"bangumi","sourceCharacterId":"151087"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b1f1a62f9222d089521405b16f4a7782342673e260cf323a6b034d9e2b37dca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f6338012b25abf7a7f2aa609f2edc6215cb9fe93b6350cb62cea65179770e38.webp","width":174,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:199453:151087:6045:1","source":"bangumi"}]},{"characterId":"char_c18301","characterName":"羽白 摩菜","sourceIds":{"bangumi":[{"characterId":"151088","match":"exact-normalized-name-in-linked-work","subjectId":"199453"}],"egsCharacterIds":["26227"],"vndbCharacterId":"c18301"},"originalCharacterName":"羽白 摩菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hashiro Aya's older sister and Hashiro Saori's daughter."}],"source":"vndb","sourceCharacterId":"c18301"},{"segments":[{"spoiler":false,"text":"双子の姉。"},{"spoiler":false,"text":"知的で浮世離れした雰囲気の女の子。"},{"spoiler":false,"text":"無口な上に控えめで、のんびりしているが、意外にしっかりしている。"},{"spoiler":false,"text":"オカルトに興味があり、学園に「オカルト研究会」を自ら設立するなど、好きなものに対しては行動的になるところも。"},{"spoiler":false,"text":"強大な力を持つ悪魔に憑依され、淫乱な女の子に豹変してしまう。"}],"source":"egs","sourceCharacterId":"26227","sourceWorkId":"6367","spoiler":false},{"segments":[{"spoiler":false,"text":"姉。のんびり屋でぽーっとした女の子。ただ、口に出さないだけで、物事は割としっかり考えている。"},{"spoiler":false,"text":"文芸部（と言う名のオカルト研究会）に所属し、勉強ができ悪魔関係のコアな知識も持つ。"},{"spoiler":false,"text":"悪魔に憑依され、淫乱な身体になってしまう。"}],"source":"bangumi","sourceCharacterId":"151088"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5729a74cb2cb24a8ca75c753dab403750d700ec00dfd4501b22ae657c7fa858.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5ffb46033f93df2c00dfd9371ae301bfe8660e5aab7a1b30bb4e5e44caa4c875.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:199453:151088:13773:1","source":"bangumi"}]},{"characterId":"char_vndb_c18296","characterName":"祷 英之","sourceIds":{"vndbCharacterId":"c18296"},"originalCharacterName":"祷 英之","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edbcc600e557d06e70789ffeea4fac54d640e7f9d6f0c6414030303ac34f8429.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59e1476d51e684dc9cfd38df99e6aab2ab4d6158a161136b2e8c861d342a430f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92