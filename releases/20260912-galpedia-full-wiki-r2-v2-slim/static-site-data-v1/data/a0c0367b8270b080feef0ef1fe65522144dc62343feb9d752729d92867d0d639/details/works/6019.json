roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:83733","source":"egs"},{"creditedName":"菱野優希(JamJamHouse)","creatorId":"vndb:s2791","sourcePersonId":"egs:creator:14589","canonicalEntityId":"vndb:s2791","name":"菱野優希(JamJamHouse)","detail":"OPデモムービー、イベント用デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84971","source":"egs"},{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:14154","source":"vndb"},{"creditedName":"菱野 優希","creatorId":"vndb:s2791","sourcePersonId":"vndb:s2791","canonicalEntityId":"vndb:s2791","name":"菱野 優希","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14157","source":"vndb"},{"creditedName":"藤原 将","creatorId":"vndb:s8572","sourcePersonId":"vndb:s8572","canonicalEntityId":"vndb:s8572","name":"藤原 たすく","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14160","source":"vndb"}]},"cast":[{"characterId":"char_c107797","characterName":"柏倉 春留","sourceIds":{"bangumi":[{"characterId":"204715","match":"exact-normalized-name-in-linked-work","subjectId":"271316"}],"egsCharacterIds":["26495"],"vndbCharacterId":"c107797"},"originalCharacterName":"柏倉 春留","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の母方の従姉妹。"},{"spoiler":false,"text":"また幼馴染でもあり、家も近く、同じ学園に通っている同級生。"},{"spoiler":false,"text":"学園ではソフトボール部のエースで、運動神経も抜群。"},{"spoiler":false,"text":"しかし、お勉強の方は……。"},{"spoiler":false,"text":"ボーイッシュで、口より手が先に出るタイプで、口調もやや乱暴。"},{"spoiler":false,"text":"主人公を嫌っているらしく、仲が悪い。"},{"spoiler":false,"text":"どうやら主人公の不思議な力に感付いているようだが……。"}],"source":"egs","sourceCharacterId":"26495","sourceWorkId":"6019","spoiler":false},{"segments":[{"spoiler":false,"text":"正吾の母方のイトコ。幼なじみで、家も近く、同級生でもある。しかし正吾とは仲が悪い。というか、一方的に嫌っている。"},{"spoiler":false,"text":"正吾の能力に気付いている節があり、それを気味悪がっている。しかし、仲の良い友人から見てみれば、気にかけているのは一目瞭然だったりする。ソフトボール部に在籍しピッチャーとして能力が高いが、勉○はあまりできない。両親と弟（夏生）と暮らしている。家族は全員、正吾と仲が良い。"}],"source":"bangumi","sourceCharacterId":"204715"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6702ef709899ed500192d43751a091c56715bcd1e144e7ea08814952aebcd55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c04d56b50aafaaa5f6b1d7772ec0dd6eb83cbd547cf1864485131d48b7cd07ec.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271316:204715:4809:1","source":"bangumi"}]},{"characterId":"char_c107798","characterName":"結城 小星","sourceIds":{"bangumi":[{"characterId":"204717","match":"exact-normalized-name-in-linked-work","subjectId":"271316"}],"egsCharacterIds":["26497"],"vndbCharacterId":"c107798"},"originalCharacterName":"結城 小星","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"地元の有力者たちの尊敬と畏怖を集めている結城神社の家系の娘。主人公と春留が通う学園の先輩。"},{"spoiler":false,"text":"のんびりした雰囲気を持つ、マイペースな女の子。"},{"spoiler":false,"text":"母性的な雰囲気を漂わせる和風美人だが、家柄のこともあってか、友人すらも少ない。"},{"spoiler":false,"text":"結城神社の人間として、陰陽師の修行をしている。"},{"spoiler":false,"text":"主人公と同じ“見鬼”の能力を持ち、それが縁で主人公と親しくなる。"}],"source":"egs","sourceCharacterId":"26497","sourceWorkId":"6019","spoiler":false},{"segments":[{"spoiler":false,"text":"地元の有力者たちすべての尊敬と畏怖を集めている結城神社の家系の娘。正吾や春留と同じ学園に通う先輩。部活には所属していない。"},{"spoiler":false,"text":"とてものんびりとした言動で、母性愛的な雰囲気を漂わせている。しかし、家柄のこともあってか友人は少ない、というかいない。いつも1人でぼけ～っとしている。結城神社は陰陽道系であり、小星も陰陽師としての修行をしている。正吾と同じ「見鬼」の能力を持っており、それで互いに興味を持つことになる"}],"source":"bangumi","sourceCharacterId":"204717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b2e396222bff2ef0e2c503bb71b97ceda94c9b94b4e78873774de2cf5de94af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d91a26e268f41d7080f1d2a55fa00ab0bc4237a32faf5de7d39ded5bc639dc73.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271316:204717:4940:1","source":"bangumi"}]},{"characterId":"char_c42500","characterName":"育","sourceIds":{"bangumi":[{"characterId":"204716","match":"exact-normalized-name-in-linked-work","subjectId":"271316"}],"egsCharacterIds":["26496"],"vndbCharacterId":"c42500"},"originalCharacterName":"育","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"記憶喪失で街をぼんやり彷徨っていたところを主人公に保護され、そのまま三輪家に居着いてしまった、何処かエキセントリックな雰囲気の少女。"},{"spoiler":false,"text":"人見知りが激しく、大人しい性格で、何処か幼さを感じさせる。また世間知らずで、あまり常識が通用しないところも。"},{"spoiler":false,"text":"お風呂嫌いで、昼寝好き。"},{"spoiler":false,"text":"「みどり」という名の人物を探しているらしい。主人公の死んだ祖母の名前と同じだが、偶然の一致か……。"}],"source":"egs","sourceCharacterId":"26496","sourceWorkId":"6019","spoiler":false},{"segments":[{"spoiler":false,"text":"記憶喪失でさまよっていたところを、正吾が保護する。そしてそのまま正吾の家に居着いてしまう、ちょっと不思議な少女。"},{"spoiler":false,"text":"憶えていることは「みどり」と言う名の人物を捜していることだけ。ちなみにそれは正吾の祖母の名前なのだが、すでに亡くなっている。外見も言動も幼い感じだが、なにかにつけ丁寧。しかし世間知らずなところがあり、常識が通用しないこともある。また、何故か風呂が嫌いで長湯はしない。昼寝が好きで、一人で家で待っている間はほとんど寝て過ごしている。"}],"source":"bangumi","sourceCharacterId":"204716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70b359ab2f5e4b2bce37ad9bf2a6aa60dc439159a81f965fa2d09faacc2d4ea5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fcf8e81ba3a054c0762a730c015169145827d9630b5f0d7b1890e296457c613.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271316:204716:4714:1","source":"bangumi"}]},{"characterId":"char_vndb_c107799","characterName":"るい","sourceIds":{"vndbCharacterId":"c107799"},"originalCharacterName":"るい","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2998393e39d513dc92a7968955ff62bfc7ecc1c53727909ca4bcd9ce33863cad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a68cd2e5af84a3d75071f12c11ab08a165fec3eaa8be45e2c2ff19b1fb9dc1ec.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 まひる","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7066","source":"vndb"}]},{"characterId":"char_vndb_c107800",