acterId":"char_vndb_c16530","characterName":"シエラ＝ロザン","sourceIds":{"vndbCharacterId":"c16530"},"originalCharacterName":"シエラ＝ロザン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Prince Edvard's head maid-cum-bodyguard-cum-personal hitman."},{"spoiler":false,"text":"Holding the highest position a common woman can have, she's an object of admiration to other women."},{"spoiler":false,"text":"As well as leadership skills and knowledge pertaining to politics she has high level combat abilities in order to protect her master."}],"source":"vndb","sourceCharacterId":"c16530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9918f4dc27d906ba20d0be33691eca9233636e6c5894bad06af7113acb336c5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b739717421fa1d4ac2dde8e9280c42429f82ec3ec728e63be9d2c64a41c54be.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c16531","characterName":"エドワルド＝ウィンフリー","sourceIds":{"vndbCharacterId":"c16531"},"originalCharacterName":"エドワルド＝ウィンフリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The master the heroine swore allegiance to."},{"spoiler":false,"text":"Second prince of the kingdom."},{"spoiler":false,"text":"Has the classic 'handsome prince' appearance, but in reality he looks down on everyone and everything."},{"spoiler":false,"text":"Frendly and charismatic when it comes to high society, both inside and outside he's an exceedingly princely prince."},{"spoiler":false,"text":"Tolerant to his retainers but merciless to his enemies."},{"spoiler":false,"text":"Sees the heroine as more than a subordinate and loves her more than family... or so he says."}],"source":"vndb","sourceCharacterId":"c16531"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fb5c16873fe5072c144909b6b1b06b8128d0e4d34e92d90a41dc4e7bf77e32b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/330cf8248a95000bb9bd63aeb1db506ee89df83d76f1773593455bc9e01b4449.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴村 健一","creatorId":"vndb:s90","sourcePersonId":"vndb:s90","canonicalEntityId":"vndb:s90","name":"鈴村 健一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14665","source":"vndb"}]},{"characterId":"char_vndb_c16532","characterName":"ジャスティン＝ロベラッティ","sourceIds":{"vndbCharacterId":"c16532"},"originalCharacterName":"ジャスティン＝ロベラッティ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first prince of the kingom."},{"spoiler":false,"text":"Edvard's half brother."},{"spoiler":false,"text":"Because he was born to a lower class mistress, his right to the throne is lower than his brother's."},{"spoiler":false,"text":"Holds emnity towards Edvard despite their blood relation and keeps sending assassins after him but the heroine has stopped them every time."},{"spoiler":false,"text":"Since she keeps getting in his way Justin wants to deal with her somehow."}],"source":"vndb","sourceCharacterId":"c16532"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1835936fc7026f782d75106da6a