{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"35671","model":{"presentationWorkId":"vndb:v36451","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c110413","characterName":"天谷遥乃","sourceIds":{"vndbCharacterId":"c110413"},"originalCharacterName":"天谷遥乃","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"For some reason, she quit her job and stayed in her ex-boyfriend's house to live with him, but after half a year there was still no sign of reemployment. Her ex-boyfriend kicked her out."},{"spoiler":false,"text":"She was at a loss with no money, job, or house, and was invited to live with a strange man passing by who said: \"I guarantee all the clothes, food, and shelter, so why don't you become my cat?\""},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c110413"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7af081f100c8b04a60f671654b47d043bd074afd4886bba5a80d6b525f3ab5ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfde3df9ca7ccc6684565e4818a2c3e13055399f95e6023648655fc36291a7cf.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"棗 いつき","creatorId":"vndb:s17103","sourcePersonId":"vndb:s17103","canonicalEntityId":"vndb:s17103","name":"棗いつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91532","source":"vndb"}]},{"characterId":"char_vndb_c110414","characterName":"赤星真人","sourceIds":{"vndbCharacterId":"c110414"},"originalCharacterName":"赤星真人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strange young man who invited Haruno to live with him by asking, \"Why don't you become my cat?\" However, contrary to his blunt words and actions, he's a kind \"owner\" who treats Haruno very carefully and spoils her."},{"spoiler":false,"text":"Despite his playful appearance, he's actually very sensitive to people's subtleties and has a caring yet serious personality. He loves cats like no other."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c110414"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23ff1bd1f2d6972e3f3e515bac82fa5425705c5602c807b36740e9f164726351.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5088344ecf014354050e40dec3de6fa164ba7e6b1ef4d00a911be93eb4fb5827.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"更科 真都","creatorId":"vndb:s3762","sourcePersonId":"vndb:s3762","canonicalEntityId":"vndb:s3762","name":"更科真都","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91530","source":"vndb"}]},{"characterId":"char_vndb_c110415","characterName":"茶野麗奈","sourceIds":{"vndbCharacterId":"c110415"},"originalCharacterName":"茶野麗奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruno's friend since high school."},{"spoiler":false,"text":"She supports her despite her harsh words and isn't afraid to speak her mind. When Haruno wants to say something but can't, she'll ste