{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11425","model":{"presentationWorkId":"vndb:v4512","staff":{"artwork":[{"creditedName":"こつえー(駒都えーじ)","creatorId":"vndb:s5071","sourcePersonId":"egs:creator:315","canonicalEntityId":"vndb:s5071","name":"こつえー(駒都えーじ)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71461","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c72790","characterName":"カル・ルスラン","sourceIds":{"bangumi":[{"characterId":"13360","match":"exact-normalized-name-in-linked-work","subjectId":"14529"}],"egsCharacterIds":["11974"],"vndbCharacterId":"c72790"},"originalCharacterName":"カル・ルスラン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝国ジュニア・アカデミー第二学年所属。"},{"spoiler":false,"text":"１４年前の統一戦争で帝国軍に滅ぼされた小国「ルスラン」のお姫様であるが、現在は王家復興を願う多くの遺臣たち期待を一身に背負いつつ帝都で勉学に励む。"},{"spoiler":false,"text":"そしてもうひとつ裏の顔は、違法Ｅテクノロジー研究および、違法Ｅウェポンを取り締まる政府組織「パシアテ文明保存管理局」、通称“ライブラリ”の学生エージェント。"},{"spoiler":false,"text":"相手がライブラリの命令に応じず強硬手段に出る場合は、超重機動兵「アルパー」を呼び出し戦闘も行う。"},{"spoiler":false,"text":"長身でスタイル抜群、凛とした美貌を備えた美少女。"},{"spoiler":false,"text":"実年齢よりずっと大人びて見えるため学校では一目置かれ、近寄りがたいと思われることもあるが、根は正直者、生真面目な努力家。"}],"source":"egs","sourceCharacterId":"11974","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b591830fa81ad8f0686ba6049201cecc10f5882b676272679c9d60682c26ea7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d15434ebb4c5f57723851e0f28be5ce4e80aec7911879a649397dab07d12ce0.webp","width":256,"height":251,"source":"static-detail"},"actors":[{"cre