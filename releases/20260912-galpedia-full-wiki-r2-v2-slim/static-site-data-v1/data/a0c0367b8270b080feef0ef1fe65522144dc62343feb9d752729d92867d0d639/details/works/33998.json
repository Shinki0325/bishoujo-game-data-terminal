rId":"char_bangumi_141395","characterName":"根津哲也","sourceIds":{"bangumi":[{"characterId":"141395","match":"source-roster","subjectId":"421433"},{"characterId":"141395","match":"source-roster","subjectId":"48010"},{"characterId":"141395","match":"source-roster","subjectId":"85349"}]},"originalCharacterName":"根津哲也","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fa28e8ccfca85564d352ab5dbec2fb19614d2f014a83554cda72ebe8e6c2fbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82c44c764cdbc279f5c20eabd1b1ca56f546e974d10a2910c420bbe0d5520d86.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"荻原秀樹","creatorId":"vndb:s749","sourcePersonId":"vndb:s749","canonicalEntityId":"vndb:s749","name":"荻原 秀樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:421433:141395:4069:1","source":"bangumi"}]},{"characterId":"char_bangumi_19020","characterName":"内藤舞亜","sourceIds":{"bangumi":[{"characterId":"19020","match":"source-roster","subjectId":"421433"},{"characterId":"19020","match":"source-roster","subjectId":"48010"},{"characterId":"19020","match":"source-roster","subjectId":"85349"}]},"originalCharacterName":"内藤舞亜","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在透的梦中出现的最坏的精神折磨。"},{"spoiler":false,"text":"作出透被囚禁在梦里的原因的，就是她本人。"},{"spoiler":false,"text":"然而在明晰梦这个限制中，本应无法再次现身才对——"}],"source":"bangumi","sourceCharacterId":"19020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29e6817e284698a6337f903c352c6398d53677a48f17041fa6c09d15657dcc6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a776949df8f3d22495cfc65301035debda0d38158d1b8e926609e4501c981033.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:421433:19020:4646:1","source":"bangumi"}]},{"characterId":"char_c11596","characterName":"鳥海 有栖","sourceIds":{"bangumi":[{"characterId":"19016","match":"source-roster","subjectId":"421433"},{"characterId":"19016","match":"exact-normalized-name-in-linked-work","subjectId":"48010"},{"characterId":"19016","match":"source-roster","subjectId":"48010"},{"characterId":"19016","match":"source-roster","subjectId":"85349"}],"egsCharacterIds":["8475"],"vndbCharacterId":"c11596"},"originalCharacterName":"鳥海 有栖","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl that appears in Tooru’s dreams. She claims to be able to wander from dream to dream, but there’s no way to prove it."},{"spoiler":false,"text":"Her words and actions are often frustrating, because she seems to know various things but then it turns out she really doesn’t."},{"spoiler":false,"text":"But it’s at least certain that she’s an ally of Tooru’s... Probably."},{"spoiler":false,"text":"She is never really on her guard."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c11596"},{"segments":[{"spoiler":false,"text":"透の夢の中に現れる女の子。"},{"spoiler":false,"text":"夢の中を渡り歩くだなんてそれこそ夢みたいなことを言っているけれど、それが本当か確かめる手段は無い。"},{"spoiler":false,"text":"色々知ってそうで知らない、もどかしい言動が多い。"},{"spoiler":false,"text":"ただ、透の味方であることは確か……だと、思う。"},{"spoiler":false,"text":"ガードが緩い。"}],"source":"egs","sourceCharacterId":"8475","sourceWorkId":"17442","spoiler":false},{"segments":[{"spoiler":false,"text":"在透的梦中出现的女孩。"},{"spoiler":false,"text":"倒不如说在梦中踱步这种情景更像是梦，但并没有任何证实的方法。"},{"spoiler":false,"text":"似乎知道很多但又什么也不知道，有着很多这样的矛盾言行。"},{"spoiler":false,"text":"但是，可以肯定的是站在透这一边——他是这样想的。"},{"spoiler":false,"text":"没什么防人之心。"}],"source":"bangumi","sourceCharacterId":"19016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c41a82cd2c42e605718578c24ed696d2aa5587dc99c6c86df4c07f70805c1b0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78e279e4dc9cc6f3bacf77bbb5f2959f81591fa57a1de3d892a50ebcebe2233b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:421433:19016:4727:1","source":"bangumi"}]},{"characterId":"char_c11597","characterName":"蓮乃 咲","sourceIds":{"bangumi":[{"characterId":"19017","match":"source-roster","subjectId":"421433"},{"characterId":"19017","match":"exact-normalized-name-in-linked-work","subjectId":"48010"},{"characterId":"19017","match":"source-roster","subjectId":"48010"},{"characterId":"19017","match":"exact-normalized-name-in-linked-work","subjectId":"85349"},{"characterId":"19017","match":"source-roster","subjectId":"85349"}],"egsCharacterIds":["2710"],"vndbCharacterId":"c11597"},"originalCharacterName":"蓮乃 咲","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tooru’s childhood friend and Keiko's classmate."},{"spoiler":false,"text":"She used to be a good, honest girl, but after a certain point she became Tooru’s little sister, and turned into a scary girl who entangles her brother in her wiles. (According to Tooru.)"},{"spoiler":false,"text":"And the scariest part is that she does so almost unconsciously, so her brother is always troubled."},{"spoiler":false,"text":"With circumstances being what they are, it’s not that she has a complex towards her brother."},{"spoiler":false,"text":"Incidentally, her family are rich landowners."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c11597"},{"segments":[{"spoiler":false,"text":"透たちの幼なじみ。"},{"spoiler":false,"text":"昔は素直な良い子だったのに、ある時期を境に透の妹になって、兄を手練手管で絡め取る怖い子になってしまった（透談）。"},{"spoiler":false,"text":"なにより恐ろしいのはその手段が半分無自覚だということで、お兄ちゃんはいつも困ってます。"},{"spoiler":false,"text":"経緯が経緯なのでブラコンとはちょっと違う。"},{"spoiler":false,"text":"ついでに言うと、実家が土地持ちで金持ち。"}],"source":"egs","sourceCharacterId":"2710","sourceWorkId":"17442","spoiler":false},{"segments":[{"spoiler":false,"text":"透達の幼なじみ。"},{"spoiler":false,"text":"昔は素直な良い子だったが、ある時期を境に幼なじみである透を兄と呼び、面倒をみるようになっていった。"},{"spoiler":false,"text":"時折、女として透を手練手管で絡め取るような行動をとるけれど、完全に無自覚。"},{"spoiler":false,"text":"ブラコンでも無ければ、面倒見が良すぎて貧乏くじを引き続けて居る。"}],"source":"egs","sourceCharacterId":"2710","sourceWorkId":"19429","spoiler":false},{"segments":[{"spoiler":false,"text":"透他们的青梅竹马。"},{"spoiler":false,"text":"明明以前是个直率的好孩子，自从经历了某个时期而成为了透的妹妹以后，就成了熟练地拘束哥哥身体的可怕孩子（透曰）。"},{"spoiler":false,"text":"更可怕的是她的方法有一半是毫无自觉的，总是让哥哥为难。"},{"spoiler":false,"text":"事出有因，与兄控这个词的意思稍稍有点不一样。"},{"spoiler":false,"text":"顺带一提，老家是有钱地主。"}],"source":"bangumi","sourceCharacterId":"19017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70667f30ac9cacf806dfe811d759a4c467ddfcc684e09a1b5d0feb3a810fb608.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7a4618d3daa741bc113c3ca298e5766806192c56269bc98f17c10a37d1dd1bc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:421433:19017:4432:1","source":"bangumi"}]},{"characterId":"char_c11598","characterName":"弥生・B・ルートウィッジ","sourceIds":{"bangumi":[{"characterId":"19018","match":"source-roster","subjectId":"421433"},{"characterId":"19018","match":"exact-normalized-name-in-linked-work","subjectId":"48010"},{"characterId":"19018","match":"source-roster","subjectId":"48010"},{"characterId":"19018","match":"exact-normalized-name-in-linked-work","subjectId":"85349"},{"characterId":"19018","match":"source-roster","subjectId":"85349"}],"egsCharacterIds":["2711"],"vndbCharacterId":"c11598"},"originalCharacterName":"弥生・B・ルートウィッジ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tooru’s sempai and the head of the school science club who has returned to Japan."},{"spoiler":false,"text":"As her name suggests, she’s half Japanese."},{"spoiler":false,"text":"One mustn’t be deceived by her appearance, because she is always behaving in a calculating manner—or so she says, but Tooru thinks she mostly just relys on intuition."},{"spoiler":false,"text":"But it’s impossible to know what she’s thinking behind that smile."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c11598"},{"segments":[{"spoiler":false,"text":"透の先輩で科学部部長、帰国子女。"},{"spoiler":false,"text":"名前の通りハーフで、見たとおり日本人離れしたスタイルを持っている。"},{"spoiler":false,"text":"その見た目に騙されるなかれ、いつも計算高く振る舞っている――と自分では言っているけれど、実際はほとんど勘に頼ってると透は思っている。"},{"spoiler":false,"text":"それでもその笑顔の裏で何を考えているのかは分からない。"}],"source":"egs","sourceCharacterId":"2711","sourceWorkId":"17442","spoiler":false},{"segments":[{"spoiler":false,"text":"透の先輩で、科学部部長の帰国子女。"},{"spoiler":false,"text":"名の通りハーフで、日本とイギリスを行き来している。人前では落ち着いた頼れる先輩として振る舞っているが、身内しかいない所ではその弱みを存分に見せ、そして甘えつつ付け込んでくる。"},{"spoiler":false,"text":"最近、素直に笑えるようになってきたというが――。"}],"source":"egs","sourceCharacterId":"2711","sourceWorkId":"19429","spoiler":false},{"segments":[{"spoiler":false,"text":"透的学姐兼科学部部长，归国子女。"},{"spoiler":false,"text":"如名字所示的混血儿，拥有如外表所示的脱离日本人的身材。"},{"spoiler":false,"text":"你被我的外表给骗了，我的行为都是经过精密计算的——尽管本人是这样说，但实际上都是依靠第六感，透是这样认为的。"},{"spoiler":false,"text":"然而他又不明白这张笑脸后面究竟正在思考着什么。"}],"source":"bangumi","sourceCharacterId":"19018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4039feef21b3f5ba8ccc054b1bde70bfb3f15d255a2b5995345c7f06767774d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bcf5cd0cf4244cda7c6020379d04f914426c8c6cd6d9571d08eb34723a97c26.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:421433:19018:4956:1","source":"bangumi"}]},{"characterId":"char_c11599","characterName":"平坂 景子","sourceIds":{"bangumi":[{"characterId":"19019","match":"source-roster","subjectId":"421433"},{"characterId":"19019","match":"exact-normalized-name-in-linked-work","subjectId":"48010"},{"characterId":"19019","match":"source-roster","subjectId":"48010"},{"characterId":"19019","match":"exact-normalized-name-in-linked-work","subjectId":"85349"},{"characterId":"19019","match":"source-roster","subjectId":"85349"}],"egsCharacterIds":["2712"],"vndbCharacterId":"c11599"},"originalCharacterName":"平坂 景子","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Saki’s classmate and Tooru’s underclassman. The principal’s niece."},{"spoiler":false,"text":"She doesn’t have many friends because she doesn’t talk much and often glares at people. She plays guitar as a hobby, and sometimes sings in front of the train station."},{"spoiler":false,"text":"Often behaves coldly, and kept Tooru and co. at a distance at first. She doesn’t like Yayoi because the latter is over-familiar and it’s hard to know what she’s thinking."},{"spoiler":false,"text":"It goes without saying that she’s from a well-off family."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c11599"},{"segments":[{"spoiler":false,"text":"咲の同級生で透の後輩、学園長の姪。"},{"spoiler":false,"text":"言葉少なで人をすぐ睨むように見るのもあって、あまり友人はいない。"},{"spoiler":false,"text":"趣味はギターで、時折駅前で歌っていたりする。"},{"spoiler":false,"text":"冷めた振る舞いが多く、最初は透たちも遠ざけるけれど――？"},{"spoiler":false,"text":"馴れ馴れしいうえに何を考えているか分からない弥生が苦手。"},{"spoiler":false,"text":"言うまでもなく本当はお嬢様。"}],"source":"egs","sourceCharacterId":"2712","sourceWorkId":"17442","spoiler":false},{"segments":[{"spoiler":false,"text":"咲の同級生で学園長の姪。"},{"spoiler":false,"text":"ギターが趣味で、気晴らしにと駅前で歌っている姿をよく見かける。"},{"spoiler":false,"text":"父親と折り合いが悪く、気付かれない家出として透や咲の所に泊まりに来る事もある。"},{"spoiler":false,"text":"ただ、その折り合いの悪さの質も変わってきたようで、余計に困惑していた。"}],"source":"egs","sourceCharacterId":"2712","sourceWorkId":"19429","spoiler":false},{"segments":[{"spoiler":false,"text":"咲的同级生，透的学妹，学园长的侄女。"},{"spoiler":false,"text":"说话不多再加上经常瞪着人，所以没什么朋友。"},{"spoiler":false,"text":"兴趣是吉他，不时在车站前面唱歌。"},{"spoiler":false,"text":"行为经常很冷淡，一开始连透他们也远离她？"},{"spoiler":false,"text":"厌烦一副熟人脸孔而且不知道在想些什么的弥生。"},{"spoiler":false,"text":"毋容置疑的大小姐。"}],"source":"bangumi","sourceCharacterId":"19019"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92433d58e36e636ad278fee3ad1892bd4f8698ad577f39ec88c8b677e7556588.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abcb17d07f5f0be637813cffeecc96ad42048e963925d2d41eecd1e8a8eafebb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:421433:19019:5922:1","source":"bangumi"}]},{"characterId":"char_c17217","characterName":"鳥海 有子","sourceIds":{"bangumi":[{"characterId":"23322","match":"source-roster","subjectId":"421433"},{"characterId":"23322","match":"source-roster","subjectId":"48010"},{"characterId":"23322","match":"exact-normalized-name-in-linked-work","subjectId":"85349"},{"characterId":"23322","match":"source-roster","subjectId":"85349"}],"egsCharacterIds":["2708"],"vndbCharacterId":"c17217"},"originalCharacterName":"鳥海 有子","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"透のクラスメイトで、長期入院により闘病していた少女。"},{"spoiler":false,"text":"あるきっかけにより快復に向かい、短期ではあるが退院した事により学園に復帰した。"},{"spoiler":false,"text":"読書が趣味、というか病室で許された事しか趣味が無く、また若干世の中を斜に見て居る所があるが、あらゆる意味で耐久力が無い。"},{"spoiler":false,"text":"何故か透に対して、言いようのない感情を抱いている……？"}],"source":"egs","sourceCharacterId":"2708","sourceWorkId":"19429","spoiler":false},{"segments":[{"spoiler":false,"text":"透のクラスメイトで、長期入院により闘病していた少女。"},{"spoiler":false,"text":"あるきっかけにより快復に向かい、短期ではあるが退院したことにより学園に復帰した。"},{"spoiler":false,"text":"読書が趣味、というか病室で許されたことしか趣味がなく、また若干世の中を斜に見ているところがあるが、あらゆる意味で耐久力が無い。"},{"spoiler":false,"text":"何故か透に対して、言いようのない感情を抱いている……？"},{"spoiler":false,"text":"「ボクが一体何をしたというんだい」"}],"source":"bangumi","sourceCharacterId":"23322"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38d8d9792e3c667c20a3e4aaa9ca74ea822a2b1e1185c0bcd9b1e79413e8483e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b46e75d9d1e5e189eeca67b52dffe8933223881f15b5f649fd35af60b3c69fbf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:421433:23322:4727:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p132","sourceCompanyId":"egs:brand:666","canonicalEntityId":"vndb:p132","name":"Purple software","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33998:666","source":"egs"}],"missingStates":["vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
