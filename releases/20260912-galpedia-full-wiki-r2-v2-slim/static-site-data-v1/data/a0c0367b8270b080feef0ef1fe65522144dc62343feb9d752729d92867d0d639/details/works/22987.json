"vndbCharacterId":"c44216"},"originalCharacterName":"カッパ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"・ミイラ化してたところを発見され、水を掛けて貰って復活する。"},{"spoiler":false,"text":"・手乗りサイズ。"},{"spoiler":false,"text":"・キュウリで頼み事を聞いてくれる。"},{"spoiler":false,"text":"・敵の尻子玉を抜く。"},{"spoiler":false,"text":"・結構、強い。"}],"source":"egs","sourceCharacterId":"8015"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2f3753f4bbd86b7431835dd595281335ebe2cd6cc204b03d119213d6b78c46c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8168664a3cf3a2b1a8807592a5996f7baa1227f1164c957f461999389ba73ff0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c44217","characterName":"キセ","sourceIds":{"bangumi":[],"egsCharacterIds":["8016"],"vndbCharacterId":"c44217"},"originalCharacterName":"キセ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"・カッパと同じぐらいの大きさ。"},{"spoiler":false,"text":"・コロボックルの亜種で土地神の一種だと思われる。本人もよくわかってない。"},{"spoiler":false,"text":"・北海道弁を喋る。"},{"spoiler":false,"text":"・部室の冷蔵庫に住んでる。"}],"source":"egs","sourceCharacterId":"8016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c07c60af25c67c4d0342ca2d98ae37d93cf71a984287ed3ce3520c6a6d305feb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8bb73837ee6d84a520ca3487da58b79395b3e4a1b4a9f7a193abbcd34c08a6e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c44218","characterName":"ミーたん","sourceIds":{"bangumi":[],"egsCharacterIds":["8017"],"vndbCharacterId":"c44218"},"originalCharacterName":"ミーたん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"・黒猫。"},{"spoiler":false,"text":"・でっぷりして大きい。"},{"spoiler":false,"text":"・メス。"},{"spoiler":false,"text":"・学園を縄張りにしているボス猫。"},{"spoiler":false,"text":"・簡単には触らせてくれない。"}],"source":"egs","sourceCharacterId":"8017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae36d154162cfd1a256dfc719709156deef18a4d57e37a5bd997f689358d608d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f1888d77de5344351d8e23e614dcfff4d336b17151f8f0716c6580a88aec4ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c44219","characterName":"校長先生","sourceIds":{"bangumi":[],"egsCharacterIds":["8018"],"vndbCharacterId":"c44219"},"originalCharacterName":"校長先生","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"・犬　雑種の中型犬。"},{"spoiler":false,"text":"・首輪から「校長」の札を下げている。"},{"spoiler":false,"text":"・皆、校長先生として扱っている。"},{"spoiler":false,"text":"・主人公以外は、特に変だと思っていないフシが有る。"},{"spoiler":false,"text":"・職員室の片隅に校長室（犬小屋）がある。"},{"spoiler":false,"text":"・ミーたんと仲良し。"},{"spoiler":false,"text":"・主人公が好き過ぎて、足に抱き付いては腰を振る。たまにブッカケる。"},{"spoiler":false,"text":"・何故か周囲からは、主人公は校長に贔屓されていると思われている。"},{"spoiler":false,"text":"・某白い犬と違って最初から犬。"}],"source":"egs","sourceCharacterId":"8018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/672418929ddb447f0815d67327020f082210ebcb4557f17a249c83b1f7ff81e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0f1a1d8e9b946fc3c2f872e7ec793629b9727eb242086e91367765422ef2a6b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c44220","characterName":"追湊 ユウマ","sourceIds":{"bangumi":[{"characterId":"128273","match":"exact-normalized-name-in-linked-work","subjectId":"161053"}],"egsCharacterIds":["8020"],"vndbCharacterId":"c44220"},"originalCharacterName":"追湊 ユウマ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. A baby-faced guy who has a kind personality. His biggest dream is becoming a best-selling light novel writer, however he has yet to pass the first qualification rounds at writing contests. At the academy, he often does odd jobs for both the student council and the second literature club, which he was forced into joining by Yuzuna. After the grimoire ends up in his hands, he ends up in various lewd scenarios with his schoolmates."}],"source":"vndb","sourceCharacterId":"c44220"},{"segments":[{"spoiler":false,"text":"・身長　165cm"},{"spoiler":false,"text":"・一応、主人公。"},{"spoiler":false,"text":"・文芸部に入りたくてこの学園を選んで進学したものの、実は数年前に廃部になっていたという、ゲーム開始直後から悲劇にみまわれる。"},{"spoiler":false,"text":"・痩せ型で童顔。"},{"spoiler":false,"text":"・一人称　ボク"},{"spoiler":false,"text":"・生徒会書記で雑用係。"},{"spoiler":false,"text":"・第二文芸部員で雑用係。"},{"spoiler":false,"text":"・世話好きで親切。"},{"spoiler":false,"text":"・ラノベ作家になるのが夢で、主に図書室で執筆活動をしているものの、いまだコンテストの一次審査を突破出来ずにいる。"},{"spoiler":false,"text":"・第二文芸部の柚夏先輩からは下僕扱いされる。"},{"spoiler":false,"text":"・柚夏先輩のことはペット感覚で可愛がってる。"},{"spoiler":false,"text":"・第二文芸部の天使様と仲良し。"},{"spoiler":false,"text":"・クラスメートの碧唯に弁当を食べられること多し。"},{"spoiler":false,"text":"・最近は弁当は、碧唯に食べさせる為に作ってる感がある。"},{"spoiler":false,"text":"・魔導書と契約してから、よくエッチなハプニングに巻き込まれる。"},{"spoiler":false,"text":"・人外に好かれるが、霊能力は無い。"},{"spoiler":false,"text":"・ダウジングだけは得意。"},{"spoiler":false,"text":"・戦闘力は皆無。"},{"spoiler":false,"text":"・一人暮しらしい。"}],"source":"egs","sourceCharacterId":"8020"}],"profileFacts":[{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"8020","sourceWorkId":"22987","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4390","sourceCompanyId":"egs:brand:4277","canonicalEntityId":"vndb:p4390","name":"しろいぱんつ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22987:4277","source":"egs"},{"companyId":"vndb:p4390","sourceCompanyId":"vndb:p4390","canonicalEntityId":"vndb:p4390","name":"しろいぱんつ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:50780:v18752","source":"vndb"},{"companyId":"vndb:p4390","sourceCompanyId":"vndb:p4390","canonicalEntityId":"vndb:p4390","name":"しろいぱんつ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:60212:v18752","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
