miji","creatorId":"vndb:s9072","sourcePersonId":"vndb:s9072","canonicalEntityId":"vndb:s9072","name":"momiji","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:127097","source":"vndb"}]},"cast":[{"characterId":"char_c44182","characterName":"猛犬チワワ","sourceIds":{"bangumi":[{"characterId":"47153","match":"exact-normalized-name-in-linked-work","subjectId":"161053"}],"egsCharacterIds":["8002"],"vndbCharacterId":"c44182"},"originalCharacterName":"猛犬チワワ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The president of the second literature club. In reality, she is a magician who will curse anyone who gets in her way and is regarded as the scariest person in the school. While she constantly treats Yuuma like a slave, she still takes good care of him and looks after him. When Yuuma attempted to create a character based on her for his novel, his editor told him off for coming up with such a ridiculous idea."}],"source":"vndb","sourceCharacterId":"c44182"},{"segments":[{"spoiler":false,"text":"・第二文芸部　部長。"},{"spoiler":false,"text":"・先輩。"},{"spoiler":false,"text":"・身長　150cm"},{"spoiler":false,"text":"・ちっこくてかわいい系。"},{"spoiler":false,"text":"・制服の上にマント（小さめ）着用。"},{"spoiler":false,"text":"・一人称「あたし」"},{"spoiler":false,"text":"・猛犬チワワの二つ名を持つ本物の魔法使い。"},{"spoiler":false,"text":"・口が悪い。"},{"spoiler":false,"text":"・邪魔する奴は呪う。"},{"spoiler":false,"text":"・学園で最も恐れられている。"},{"spoiler":false,"text":"・でも、本当はいい人……かもしれない。"},{"spoiler":false,"text":"・柚夏をモデルにしたキャラは、編集さんからラノベとは言え荒唐無稽すぎるとコメントされる。"},{"spoiler":false,"text":"・ユウマの事は下僕扱いするが実質、面倒をみて貰っている。"},{"spoiler":false,"text":"・去年まで図書委員をしていた。"}],"source":"egs","sourceCharacterId":"8002"},{"segments":[{"spoiler":false,"text":"主人公が所属することになる第二文芸部の部長。"},{"spoiler":false,"text":"制服の上にマントを着用し、“猛犬チワワ” の二つ名を持つ本物の魔法使い。"},{"spoiler":false,"text":"学園で最も恐れられており、邪魔をする奴は呪う。"},{"spoiler":false,"text":"主人公が彼女をモデルにしたキャラクターを小説に登場させると、編集さんから荒唐無稽すぎると言われる始末。"},{"spoiler":false,"text":"いつも主人公を下僕扱いするが、実態は面倒をみてもらっている。"},{"spoiler":false,"text":"本当はいい人……なのかもしれない。"}],"source":"bangumi","sourceCharacterId":"47153"}],"profileFacts":[{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"8002","sourceWorkId":"22987","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c33f84f981c00a05fe9c5fda90b148df87eed271c03cc0afcbe1ee015cc48d5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1898ced5c5a80fe9c5d408d40cb18fdecdbad7c1dc2e04de670ea61f3218afb0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八ッ橋きなこ","creatorId":"vndb:s353","sourcePersonId":"vndb:s353","canonicalEntityId":"vndb:s353","name":"八ッ橋きなこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161053:47153:16170:1","source":"bangumi"}]},{"characterId":"char_c44183","characterName":"吾達 碧唯","sourceIds":{"bangumi":[{"characterId":"47154","match":"exact-normalized-name-in-linked-work","subjectId":"161053"}],"egsCharacterIds":["8003"],"vndbCharacterId":"c44183"},"originalCharacterName":"吾達 碧唯","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuma's friendly, curious and energetic classmate who talks in an odd way. Aoi is an ace at sports and always wears spats under her skirt. She sometimes acts like a fool but in reality gets excellent grades. She quickly gets hungry and as such it's part of her routine to try and take Yuuma's lunchbox. She also loves cute things."}],"source":"vndb","sourceCharacterId":"c44183"},{"segments":[{"spoiler":false,"text":"・フレンドリーで元気なクラスメート。"},{"spoiler":false,"text":"・身長　150cm"},{"spoiler":false,"text":"・運動神経は抜群。"},{"spoiler":false,"text":"・スカートの下にスパッツ着用。"},{"spoiler":false,"text":"・一人称　あたい。"},{"spoiler":false,"text":"・好奇心旺盛。ぶっきらぼうで、やや舌っ足らずな喋り方。"},{"spoiler":false,"text":"・少しおバカな友人ポジションだが、成績は天才的。"},{"spoiler":false,"text":"・ハードウェアとソフトウェアの両方イケる。"},{"spoiler":false,"text":"・腹ペコキャラ。お腹を空かせて廊下に倒れてることも。"},{"spoiler":false,"text":"・ユウマの弁当を早弁するのが日課。"},{"spoiler":false,"text":"・たまに生徒会長の魅優とユウマの弁当を奪い合う。"},{"spoiler":false,"text":"・可愛いモノ？が大好き。"},{"spoiler":false,"text":"・レオナルド先生と仲がいい。いろいろ作って貰う。"},{"spoiler":false,"text":"・語尾が「～だぞ」"},{"spoiler":false,"text":"・猫揉み１級の腕前。"}],"source":"egs","sourceCharacterId":"8003"},{"segments":[{"spoiler":false,"text":"フレンドリーで元気っ子なクラスメイト。 やや舌っ足らずな喋り方。"},{"spoiler":false,"text":"運動神経が抜群で、スカートの下にスパッツを着用している。"},{"spoiler":false,"text":"好奇心旺盛で少しおバカな友人ポジションだが、成績は天才的。"},{"spoiler":false,"text":"腹ペコキャラで、主人公の弁当を早弁するのが日課。 たまに生徒会長の魅優と奪い合う。"},{"spoiler":false,"text":"かわいいモノ（？）が大好き。 猫揉み 1級の腕前。"}],"source":"bangumi","sourceCharacterId":"47154"}],"profileFacts":[{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"8003","sourceWorkId":"22987","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ac69b70b4d3a3c73e5778e380c391587863e3f76f4a982945b17566ffbcf827.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f1daf309cc1bb270b1fb3f05b13135c496fe47bb4a52329aff04dd18ff2cf83.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161053:47154:15995:1","source":"bangumi"}]},{"characterId":"char_c44184","characterName":"雨能 緋凪","sourceIds":{"bangumi":[{"characterId":"47155","match":"exact-normalized-name-in-linked-work","subjectId":"161053"}],"egsCharacterIds":["8004"],"vndbCharacterId":"c44184"},"originalCharacterName":"雨能 緋凪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The library committee's leader who is normally like a caring and kind older sister, however she doesn't tolerate anyone breaking the rules nor making noise at the school's library. She becomes especially enraged at people not taking proper care of the books. Due to her love for literature, Hina often gives Yuuma advice regarding his writing."},{"spoiler":false,"text":"She is one of Yuzuna's few friends, and often gets caught in lewd situations involving the grimoire. She also secretly writes doujin novels in her free time."}],"source":"vndb","sourceCharacterId":"c44184"},{"segments":[{"spoiler":false,"text":"・図書委員にして図書室の支配者。"},{"spoiler":false,"text":"・先輩。"},{"spoiler":false,"text":"・身長　165cm"},{"spoiler":false,"text":"・委員長ぽい雰囲気を醸し出しているが、内面は面倒見のいいお姉さん。"},{"spoiler":false,"text":"・一人称　わたし"},{"spoiler":false,"text":"・図書室で騒ぐ奴は許さない！"},{"spoiler":false,"text":"・柚夏先輩の数少ない友達。"},{"spoiler":false,"text":"・図書委員の仕事はいつも一生懸命。"},{"spoiler":false,"text":"・図書室の蔵書を汚されると怒りに我を忘れるらしい。"},{"spoiler":false,"text":"・常識人だが、本を触ってないと落ち着かない。"},{"spoiler":false,"text":"・同人誌でモノスゴい小説を書いているらしい。"},{"spoiler":false,"text":"・場所柄、魔導書絡みの事件に巻き込まれ易い。"},{"spoiler":false,"text":"・主人公に創作のアドバイスをしてくれる。"}],"source":"egs","sourceCharacterId":"8004"},{"segments":[{"spoiler":false,"text":"図書委員にして図書室の支配者。"},{"spoiler":false,"text":"普段は面倒見の良いお姉さんだが、図書室で騒ぐ奴は許さない！"},{"spoiler":false,"text":"図書室の蔵書を汚されると、怒りに我を忘れるらしい。"},{"spoiler":false,"text":"柚夏の数少ない友達。 魔導書絡みの事件に巻き込まれやすい。"},{"spoiler":false,"text":"本を触っていないと落ち着かない性質で、よく主人公に創作のアドバイスをしてくれる。"},{"spoiler":false,"text":"同人誌でもの凄い小説を書いているらしい。"}],"source":"bangumi","sourceCharacterId":"47155"}],"profileFacts":[{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"8004","sourceWorkId":"22987","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/213cd899b30ec6917db1246bf98f6cfaa83cec8d8a4448a21f585ca70ea37eff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/712ba5a50bd3f6dd11b56750790cfc1899355c307e614296f150af9c9eb221b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤邑鈴香","creatorId":"vndb:s2309","sourcePersonId":"vndb:s2309","canonicalEntityId":"vndb:s2309","name":"藤邑鈴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161053:47155:16173:1","source":"bangumi"}]},{"characterId":"char_c44185","characterName":"鷺武 魅優","sourceIds":{"bangumi":[{"characterId":"47156","match":"exact-normalized-name-in-linked-work","subjectId":"161053"}],"egsCharacterIds":["8005"],"vndbCharacterId":"c44185"},"originalCharacterName":"鷺武 魅優","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The student council president of the academy who is popular particularly due to her looks. A mischievous troublemaker who constantly does things without thinking and then pushes the responsibilites onto Yuuma. She sometimes gains random bouts of spiritual powers."},{"spoiler":false,"text":"Miyu has very odd habits, with one of them being that she rarely enters and exits her classrooms normally through doors, instead opting to do so through balconies and windows. She is sexually interested in girls, and always becomes excited when Nanami points her wooden sword at her."}],"source":"vndb","sourceCharacterId":"c44185"},{"segments":[{"spoiler":false,"text":"・生徒会長。"},{"spoiler":false,"text":"・先輩。"},{"spoiler":false,"text":"・身長　165cm"},{"spoiler":false,"text":"・美形。気が強そうな顔。大きめの柔らかおっぱい。"},{"spoiler":false,"text":"・靴下はいてない。"},{"spoiler":false,"text":"・一人称　オレ"},{"spoiler":false,"text":"・学園の人気者。無駄に高スペックで性格はサバサバしている。"},{"spoiler":false,"text":"・直ぐに仕事を主人公に押し付けて逃げる。"},{"spoiler":false,"text":"・後先考えず、事態を面白くしたがるトラブルメーカー。"},{"spoiler":false,"text":"・ベランダ＆窓から出入りし、廊下や階段を使わないで移動する。"},{"spoiler":false,"text":"・お行儀は最悪。"},{"spoiler":false,"text":"・たまにユウマの弁当を押し買いする。"},{"spoiler":false,"text":"・お昼の放送を担当している。"},{"spoiler":false,"text":"・可愛い娘が大好き（性的な意味で）。"},{"spoiler":false,"text":"・七水先輩に木刀を突き付けられると声が可愛くなる。"},{"spoiler":false,"text":"・たまに霊感がある。"}],"source":"egs","sourceCharacterId":"8005"},{"segments":[{"spoiler":false,"text":"学園の人気者で、無駄に高スペックで性格はサバサバしている生徒会長。"},{"spoiler":false,"text":"後先考えず事態を面白くしたがるトラブルメーカー。 すぐ仕事を主人公に押し付けて逃げる。"},{"spoiler":false,"text":"気が強そうで整った顔立ち。 おっぱいは柔らかくて大きめ。 靴下は履いていない。"},{"spoiler":false,"text":"なぜかベランダや窓から教室に出入りし、廊下や階段を使わないで移動する。"},{"spoiler":false,"text":"たまに霊感がある。 性的な意味で可愛い娘が大好き。"},{"spoiler":false,"text":"七水に木刀を突き付けられると声が可愛くなる。"}],"source":"bangumi","sourceCharacterId":"47156"}],"profileFacts":[{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"8005","sourceWorkId":"22987","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bb8e4c8ef0dbee094a0164b6a2b9fead6183cbe93577d0bf80a0ed9e33496ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd7292412bc10460cd1c3e09922fbee4e5b469bd984cb74d1865982ea14d74ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161053:47156:20833:1","source":"bangumi"}]},{"characterId":"char_c44186","characterName":"榊禊 莉桜","sourceIds":{"bangumi":[{"characterId":"47157","match":"exact-normalized-name-in-linked-work","subjectId":"161053"}],"egsCharacterIds":["8006"],"vndbCharacterId":"c44186"},"originalCharacterName":"榊禊 莉桜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who is the same age as Yuuma but in a different class. She is either always sleeping or feeling very sleepy, and she tends to fall asleep in the weirdest places, with the school's emergency exit staircase being among her favorites. Despite it all, it is rumored that she is somehow able to stay awake during classes."}],"source":"vndb","sourceCharacterId":"c44186"},{"segments":[{"spoiler":false,"text":"・主人公と同学年。"},{"spoiler":false,"text":"・別のクラスの娘。"},{"spoiler":false,"text":"・身長　150cm"},{"spoiler":false,"text":"・いつも眠そうor寝てる。"},{"spoiler":false,"text":"・縞パンらしい。"},{"spoiler":false,"text":"・一人称　莉桜さん"},{"spoiler":false,"text":"・授業中はちゃんと起きているらしい。あくまで噂。"},{"spoiler":false,"text":"・どこでも寝る。"},{"spoiler":false,"text":"・特に非常階段は重要なお昼寝スポット。"},{"spoiler":false,"text":"・変なところに入り込んで居眠りしていることもある。"},{"spoiler":false,"text":"・たまに主人公が回収する。"},{"spoiler":false,"text":"・居眠りしている最中に何かすると後で慰謝料を請求される。"},{"spoiler":false,"text":"・語尾が「～なのです」"},{"spoiler":false,"text":"・誰かれ構わず呼び捨てなのです。"}],"sourc