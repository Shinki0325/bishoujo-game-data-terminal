,"canonicalEntityId":"vndb:s17528","name":"大地こねこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153845","source":"vndb"},{"creditedName":"うみこ","creatorId":"vndb:s17577","sourcePersonId":"vndb:s17577","canonicalEntityId":"vndb:s17577","name":"U35","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:153846","source":"vndb"},{"creditedName":"うみこ","creatorId":"vndb:s17577","sourcePersonId":"vndb:s17577","canonicalEntityId":"vndb:s17577","name":"U35","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153848","source":"vndb"},{"creditedName":"立花 詩穂","creatorId":"vndb:s18453","sourcePersonId":"vndb:s18453","canonicalEntityId":"vndb:s18453","name":"立花 詩穂","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153849","source":"vndb"},{"creditedName":"藤田","creatorId":"vndb:s20690","sourcePersonId":"vndb:s20690","canonicalEntityId":"vndb:s20690","name":"藤田","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153851","source":"vndb"}]},"cast":[{"characterId":"char_c77351","characterName":"向坂 海希","sourceIds":{"bangumi":[{"characterId":"67337","match":"exact-normalized-name-in-linked-work","subjectId":"267378"}],"egsCharacterIds":["20794"],"vndbCharacterId":"c77351"},"originalCharacterName":"向坂 海希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1014"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"快活で人懐っこい同級生の幼なじみ。達観を「たっくん」と愛称で呼ぶ。"},{"spoiler":false,"text":"恋愛に対しウブな達観に、ニコニコ笑みを浮かべ、からかったりするが、実のところ、彼女自身も経験豊富とは言えない。"},{"spoiler":false,"text":"つねに達観に優しい視線を持ち、女心を教える良き相談相手にもなる。"},{"spoiler":false,"text":"交友関係が浅く広いため、学校内の小さなニュースも把握することができる。"},{"spoiler":false,"text":"実家はＭＩＣＯ（ミコ）という喫茶店を経営しており、海希自身も接客や料理を手伝っているため、事全般は得意。"},{"spoiler":false,"text":"達観と家が近く、幼少期は家族ぐるみの付き合いだったが、思春期に疎遠だった時期がある。"},{"spoiler":false,"text":"学校の成績はあまりよくないが、運動神経抜群。"},{"spoiler":false,"text":"海可（みか）という大学生の姉がいる。"}],"source":"egs","sourceCharacterId":"20794","sourceWorkId":"27418","spoiler":false},{"segments":[{"spoiler":false,"text":"偶尔会笑嘻嘻地跟纯情的达观开玩笑，但实际上她自已也算不上有丰富的恋爱经验。"},{"spoiler":false,"text":"总是用温柔的视线看待达观，是个会解释女人心的优秀倾诉对象。虽然挚友不多但交友甚广，有能力快速知晓校内的各路新闻。"},{"spoiler":false,"text":"家里开了一家叫MICO的咖啡厅，她自已也会帮忙做服务员或者在厨房打下手因此很擅长各项家务。和达观住得很近因为父母一辈熟识，小时候一起玩过，进入青春期之后疏远过一段时间。成绩不怎么好，但运动能力超强。有个叫海可的大学生姐姐。"}],"source":"bangumi","sourceCharacterId":"67337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e43ed3b067bb4a7b2a15cf19847b479d452a9b1b647843ca614872acc4a63c73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48b67d2e3cba7cda08790c85d30a69982af4565f13096a37b0630db3a6206a0b.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267378:67337:7302:1","source":"bangumi"}]},{"characterId":"char_c77352","characterName":"仲手川 結","sourceIds":{"bangumi":[{"characterId":"67338","match":"exact-normalized-name-in-linked-work","subjectId":"267378"}],"egsCharacterIds":["20795"],"vndbCharacterId":"c77352"},"originalCharacterName":"仲手川 結","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"224"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"良家で大事に育てられた真性の箱入り娘。"},{"spoiler":false,"text":"共学の学園生活に過剰な憧れを抱き、お嬢様学園から転校してきた。"},{"spoiler":false,"text":"なるべくイマドキ女子学生っぽく振る舞おうとするが、言動の端々から気品が漂い、周囲を困惑させる。"},{"spoiler":false,"text":"普段はほんわかとした雰囲気をまとっているが、物事を曖昧にせず、ハッキリと意思表示する芯の強さを持つ。"},{"spoiler":false,"text":"よく言えば自分に素直、悪く言えば猪突猛進。"},{"spoiler":false,"text":"成績はとても優秀で、進路もすでに決めているらしい。"},{"spoiler":false,"text":"運動神経はイマイチ。ことわざ・格言辞典を読むのがマイブーム。"}],"source":"egs","sourceCharacterId":"20795","sourceWorkId":"27418","spoiler":false},{"segments":[{"spoiler":false,"text":"被家里捧着护着养大的如假包换的大家闺秀。"},{"spoiler":false,"text":"由于过度期待男女同校的校园生活，从贵族学校特地转学过来。努力让自己展现得更像跟得上时代的女学生，但言行举止透露出高雅的气质，时常使周遭同学感到困惑。"},{"spoiler":false,"text":"平时给人一种暖洋洋的感觉但从不暖昧，是个会明确表达意见的坚定女孩。说得好听点叫忠于自我，说得难听点叫没自控力。"},{"spoiler":false,"text":"成绩十分优秀，似乎已经决定好毕业后的计划了。运动能力一般般，最近喜欢读格言谚语辞典。"}],"source":"bangumi","sourceCharacterId":"67338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fbc0c499cbe9f234f46fe4ca9d6519963d48124b922cd2cd92e60ef8a575a26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1287a9de5c9f77384248a5f62750466b65a3cc3b8aa4c07a2e6e77894d11aa8.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"末柄里恵","creatorId":"vndb:s6837","sourcePersonId":"vndb:s6837","canonicalEntityId":"vndb:s6837","name":"実羽ゆうき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267378:67338:12356:1","source":"bangumi"}]},{"characterId":"char_c77353","characterName":"椎野 ことね","sourceIds":{"bangumi":[{"characterId":"67340","match":"exact-normalized-name-in-linked-work","subjectId":"267378"}],"egsCharacterIds":["20796"],"vndbCharacterId":"c77353"},"originalCharacterName":"椎野 ことね","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1203"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イマドキ女子学生的な見た目の一年生だが、前の学園までは典型的な『地味子』で、そんな自分を変えたくて、思い切って学園デビューを果たした。"},{"spoiler":false,"text":"オシャレもメイクも色々と勉強しているという意味では、努力家の側面がある。"},{"spoiler":false,"text":"しかし、ある意味での『背伸び』を続け、クラスのイケてる女子グループと無理に合わせ続けた結果、心身ともに疲れ始める。"},{"spoiler":false,"text":"その無理がたたり、友人関係が破綻したところで、主人公グループに拾われる。"},{"spoiler":false,"text":"はじめは達観たちに刺々しい態度をとっているが、少しずつ心を開いていく。"},{"spoiler":false,"text":"成績は中くらいで、運動神経もそこそこ。ひそかにカラオケを得意としている。"}],"source":"egs","sourceCharacterId":"20796","sourceWorkId":"27418","spoiler":false},{"segments":[{"spoiler":false,"text":"看上去是个时髦的一年级学生，但在之前的学校是个典型的士味女孩，因此升学之后她彻底改换了自已的形象，尝试通过这样的方式改变自已。学习了不少打扮与化妆的知识，是个会努力的人。"},{"spoiler":false,"text":"但是像这样强迫自已去配合班上那群时的女生，最终的结果只能是身心俱疲。疲意最终招致了塑料友情的破碎，因此加入了主角的小集体。"},{"spoiler":false,"text":"刚开始的时候对待达观等人的态度很毒辣，后来慢慢开了自已的心靠。成绩中等，运动能力尚可。没什么人知道她其实擅长唱K。"}],"source":"bangumi","sourceCharacterId":"67340"}],"profileFacts":[],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1203","source":"vndb","sourceCharacterId":"c77353","value":"1203"},{"comparisonValue":"1203","source":"egs","sourceCharacterId":"20796","value":"12/3"},{"comparisonValue":"0123","source":"bangumi","sourceCharacterId":"67340","value":"12/3（射手座）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0195520de06815b9fb8e611325b28c7c2008ae60d3781aa2397754c6d2397e3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce03629be6133c73c43c60ca1b15f9ac2758fcbf11ed2d9c96d6a16370331d3b.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤田茜","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267378:67340:17981:1","source":"bangumi"}]},{"characterId":"char_c77354","characterName":"榊 千尋","sourceIds":{"bangumi":[{"characterId":"67556","match":"exact-normalized-name-in-linked-work","subjectId":"267378"}],"egsCharacterIds":["20797"],"vndbCharacterId":"c77354"},"originalCharacterName":"榊 千尋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"901"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"186"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"長身で大人びた風貌の男子生徒。整った顔立ちでスポーツ万能。"},{"spoiler":false,"text":"当然のように女子に人気だが、あまり取り合わず、常に達観、海希と行動している。"},{"spoiler":false,"text":"ぶっきらぼうな口調だが、言葉の端々に達観と海希への優しさが滲む。"},{"spoiler":false,"text":"家庭に複雑な事情があるため、両親と距離を置き、アパートで一人暮らしをしている。"},{"spoiler":false,"text":"なにより達観や海希と過ごす時間が好きで、今の関係を崩したくないと願っている。"}],"source":"egs","sourceCharacterId":"20797","sourceWorkId":"27418","spoiler":false},{"segments":[{"spoiler":false,"text":"成熟的高个男生。长相俊美，体育运动无所不能。这样的他当然很受女生欢迎，但他不怎么搭理，总是和达观、海希起活动。"},{"spoiler":false,"text":"口气粗鲁，但字里行间都渗透出对达观与海希的关心。家庭环境复杂，和父母保持着距离，在公寓过着独居生活。"},{"spoiler":false,"text":"非常喜欢和达观与海希在一起，不希望大家现在的关系被打乱。"}],"source":"bangumi","sourceCharacterId":"67556"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"67556","value":"二年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f6c2b852ac788614fd5432eaf0048b585b19b2c03072eec699ca33e10637c10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/263d2fd136c8b6867fbebb0cd935b678abab2782637b3e24cb400885d2d922ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安東 朝夜","creatorId":"vndb:s21539","sourcePersonId":"vndb:s21539","canonicalEntityId":"vndb:s21539","name":"福西 勝也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79833","source":"vndb"}]},{"characterId":"char_c77431","characterName":"たっくん","sourceIds":{"bangumi":[{"characterId":"67557","match":"exact-normalized-name-in-linked-work","subjectId":"267378"}],"egsCharacterIds":["20798"],"vndbCharacterId":"c77431"},"originalCharacterName":"たっくん","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"515"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ごく平凡な二年生男子。"},{"spoiler":false,"text":"容姿の良い向坂海希、榊千尋とつるんでいるため、仲良くなった経緯を知らない生徒からは「なんで一緒にいるんだろう？（釣り合わない）」と囁かれている。"},{"spoiler":false,"text":"無意識に人との距離感が近く、初対面でも困っている人を見ると、なるべく良い方向へ導こうとし、海希や千尋からは「善意の撒き餌」などとからかわれている。"},{"spoiler":false,"text":"趣味はもっぱら読書や音楽などインドア派だったが、友人の影響でここ数年はスポーツの楽しさもわかってきて、よく昼休みに３人でバスケを楽しんでいる。"}],"source":"egs","sourceCharacterId":"20798","sourceWorkId":"27418","spoiler":false},{"segments":[{"spoiler":false,"text":"ごく平凡な二年生男子。"},{"spoiler":false,"text":"容姿の良い向坂海希、榊千尋とつるんでいるため、仲良くなった経緯を知らない生徒からは"},{"spoiler":false,"text":"「なんで一緒にいるんだろう？（釣り合わない）」と囁かれている。"},{"spoiler":false,"text":"無意識に人との距離感が近く、初対面でも困っている人を見ると、なるべく良い方向へ導こうとし、"},{"spoiler":false,"text":"海希や千尋からは「善意の撒き餌」などとからかわれている。"},{"spoiler":false,"text":"趣味はもっぱら読書や音楽などインドア派だったが、友人の影響でここ数年はスポーツの楽しさもわかってきて、"},{"spoiler":false,"text":"よく昼休みに3人でバスケを楽しんでいる"},{"spoiler":false,"text":"「恋愛って……『青春』って言葉を盾にして、無理やりするもんでもないな、って」"}],"source":"bangumi","sourceCharacterId":"67557"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"67557","value":"二年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7ac7b4d714678fa9acd7ec62deb13e1047875caac2ec3e028963c8cdef2831a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cfd64ea537824f01fdb8565ad9d995a625d222371b49858b89f8f708725d898.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p6066","sourceCompanyId":"egs:brand:781","canonicalEntityId":"vndb:p6066","name":"エンターグラム","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29203:781","source":"egs"},{"companyId":"vndb:p6347","sourceCompanyId":"vndb:p6347","canonicalEntityId":"vndb:p6347","name":"株式会社 HIKARI FIELD","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:103908:v24702","source":"vndb"},{"companyId