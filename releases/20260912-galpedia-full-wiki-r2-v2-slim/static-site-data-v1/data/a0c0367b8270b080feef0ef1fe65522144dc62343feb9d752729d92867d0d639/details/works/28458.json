すが本人はぽや～っとした癒し系です。一方でボスにとらわれての凌○では最も大変な目に遭ったりもするという、なにかと極端な立ち位置に居る子です。"},{"spoiler":false,"text":"伝説において、過去の英雄にちからを与え邪悪の封印に協力した地水火風の精霊たち。"},{"spoiler":false,"text":"その後は王家の指輪のなかで眠りに就いていたのだが、今回の異変により、襲撃者たちに捕らえられ、凌辱の憂き目に遭う。"},{"spoiler":false,"text":"助け出すことでジャンヌの強力な助っ人に。"}],"source":"bangumi","sourceCharacterId":"156863"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ed63773c2400515a0b2cbd1e3ce74974d82639c93e87d381a8da568039764b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/346bd8cb6b3ea5295724b9091db102128f34790ad9368e11ce4dc23a2aff57ac.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小日向みき","creatorId":"vndb:s13093","sourcePersonId":"vndb:s13093","canonicalEntityId":"vndb:s13093","name":"小日向 みき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295362:156863:29176:1","source":"bangumi"}]},{"characterId":"char_bangumi_156866","characterName":"風の精霊ル・フージユ","sourceIds":{"bangumi":[{"characterId":"156866","match":"source-roster","subjectId":"295362"}]},"originalCharacterName":"風の精霊ル・フージユ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"風の精霊ル・フージユ"},{"spoiler":false,"text":"風の精霊ちゃん「ル・フージユ」は、もとから精霊唯一の男の子。"},{"spoiler":false,"text":"伝説において、過去の英雄にちからを与え邪悪の封印に協力した地水火風の精霊たち。"},{"spoiler":false,"text":"その後は王家の指輪のなかで眠りに就いていたのだが、今回の異変により、襲撃者たちに捕らえられ、凌辱の憂き目に遭う。"},{"spoiler":false,"text":"助け出すことでジャンヌの強力な助っ人に。"}],"source":"bangumi","sourceCharacterId":"156866"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/471f9c3c08a50c382e9c1a05d54db8e4d8558614df6903af8