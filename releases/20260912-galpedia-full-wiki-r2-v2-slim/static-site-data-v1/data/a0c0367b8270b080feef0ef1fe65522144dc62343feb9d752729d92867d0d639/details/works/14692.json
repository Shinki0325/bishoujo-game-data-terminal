:[{"spoiler":false,"text":"Works for a pharmaceutical company in Britain. He has a stubborn personality, and doesn't bother with flattery."},{"spoiler":false,"text":"Due to his pretty face and nice body, he's very attractive to the men and women around him, but he has no awareness of this. In fact, he has an immense dislike of being noticed by others, to the point where it's become something of a complex for him."},{"spoiler":false,"text":"translated from official site"}],"source":"vndb","sourceCharacterId":"c15247"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fcf8d0dfc4059a6134c2d1272400a529efbf55b92e4e77661bab124cbd8cacd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97eca335c34bcb21785e069986b9f1036c06a83837e347ff339b68e0380e6c42.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夕凪 孝","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28454","source":"vndb"}]},{"characterId":"char_vndb_c15248","characterName":"アシュラフ＝ルシュディ","sourceIds":{"vndbCharacterId":"c15248"},"originalCharacterName":"アシュラフ＝ルシュディ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first in line to become the successor to the throne of the Shamsu kingdom. He has an easygoing demeanor, and is quite a philanthropist."},{"spoiler":false,"text":"However, he has a hidden cold-hearted side as well, and shows no mercy for those who provoke him. There's a great darkness hidden in his heart."},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c15248"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/413aef5353d74582f5603b24ca54287ba15e26b2fe2df2910f43bd955e24ea7a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/709b7205c8269da113ea2dfa31094c78d106bc58ad104ab50b43e7493206eb4f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高嶺 悠賀","creatorId":"vndb:s380","sourcePersonId":"vndb:s380","canonicalEntityId":"vndb:s380","name":"野島 健児","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28453","source":"vndb"}]},{"characterId":"char_vndb_c15249","characterName":"ハキム＝ルシュディ","sourceIds":{"vndbCharacterId":"c15249"},"originalCharacterName":"ハキム＝ルシュディ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Shamsu kingdom's successors, second-in-line to inherit the throne after his brother. He has a single-mindedly earnest and arrogant personality."},{"spoiler":false,"text":"His character is that of a born leader. He wants everything to go according to his plans, and will stop at nothing to make that happen."},{"spoiler":false,"text":"translated from official site"}],"source":"vndb","sourceCharacterId":"c15249"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e3536b7e8f551ce51fc1ef464c302d234d868c361503cfd44a1fcb70ab030d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5221ceb886824b2d7ec5cf9ab523495cb6c449bb5259036fc8