rce":"vndb"},{"creditedName":"BAL","creatorId":"vndb:s5190","sourcePersonId":"vndb:s5190","canonicalEntityId":"vndb:s5190","name":"BAL","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11457","source":"vndb"},{"creditedName":"藤原 もりじ","creatorId":"vndb:s5451","sourcePersonId":"vndb:s5451","canonicalEntityId":"vndb:s5451","name":"藤原 もりじ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11458","source":"vndb"},{"creditedName":"ソルシエール・サウンド・デザイン","creatorId":"vndb:s6240","sourcePersonId":"vndb:s6240","canonicalEntityId":"vndb:s6240","name":"ソルシエール・サウンド・デザイン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11460","source":"vndb"},{"creditedName":"Expect","creatorId":"vndb:s12836","sourcePersonId":"vndb:s12836","canonicalEntityId":"vndb:s12836","name":"Expect","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11461","source":"vndb"},{"creditedName":"りう","creatorId":"vndb:s20145","sourcePersonId":"vndb:s20145","canonicalEntityId":"vndb:s20145","name":"りう","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11462","source":"vndb"},{"creditedName":"高岡 嘉子","creatorId":"vndb:s36781","sourcePersonId":"vndb:s36781","canonicalEntityId":"vndb:s36781","name":"高岡 嘉子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11463","source":"vndb"}]},"cast":[{"characterId":"char_c22257","characterName":"レイナ＝クライトン","sourceIds":{"bangumi":[{"characterId":"140289","match":"exact-normalized-name-in-linked-work","subjectId":"101275"}],"egsCharacterIds":["25409"],"vndbCharacterId":"c22257"},"originalCharacterName":"レイナ＝クライトン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"活発で勝気、負けず嫌いな性格。人に弱みは見せないが、主人公には見抜かれているらしい。病弱で施設に預けられた妹をずっと気にかけており、主人公と同じ魔術師の道を志すが、根本的な資質に欠けているらしく悩んでいる。武器は拳。"}],"source":"egs","sourceCharacterId":"25409","sourceWorkId":"7717","spoiler":false},{"segments":[{"spoiler":false,"text":"活発で勝ち気な性格。負けず嫌いで決して人に弱い部分を見せない。泣いているところも絶対に見せないが、主人公にはいつも見抜かれてしまっている様子。"},{"spoiler":false,"text":"病弱で施設に引き取られた妹のことをずっと気に掛けており、カールと同じく妹の病気を治すために魔術師の道を志すが、根本的な資質が無いらしく負い目に感じている。"},{"spoiler":false,"text":"リィナとお揃いのリボンは、小さい頃に誕生日プレゼントとしてカールから送られたもの。武器は拳。"}],"source":"bangumi","sourceCharacterId":"140289"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35bb977d6b5f11d40552c7bd19bc74fa37809b7b1687df1e29011132405f270f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53e0d6f7892ff008d58b46b9e6fe7061399404024c8b78ba1757137dc116d628.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:101275:140289:4956:1","source":"bangumi"}]},{"characterId":"char_c22258","characterName":"リィナ＝クライトン","sourceIds":{"bangumi":[{"characterId":"140290","match":"exact-normalized-name-in-linked-work","subjectId":"101275"}],"egsCharacterIds":["25410"],"vndbCharacterId":"c22258"},"originalCharacterName":"リィナ＝クライトン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生まれつき病弱で部屋から出られず、窓から主人公と姉が遊ぶ姿を眺めていた。病状が重くなったため、ある施設に送られるが…。幼い頃は主人公を「お兄ちゃん」と呼び慕っていたが、今は無表情で「カールさん」と他人行儀。武器はレイピアなどの細剣。"}],"source":"egs","sourceCharacterId":"25410","sourceWorkId":"7717","spoiler":false},{"segments":[{"spoiler":false,"text":"生まれつき病弱で、幼いときからほとんど部屋から出られない生活を送っており、いつも窓から、主人公と姉が元気にはしゃいでいる姿を眺めて暮らしていた。"},{"spoiler":false,"text":"やがて病状が重くなったため、家を出て遠くにある専門の施設へと送られる。"},{"spoiler":false,"text":"本編で主人公達は元気になった彼女と再会することになるが、家族と引き裂かれ、長く続いた愛されることのない実験動物にも等しい生活が、彼女の性格を冷たい、殻に閉じこもったものに変えてしまっていた。"},{"spoiler":false,"text":"幼少時は主人公を「お兄ちゃん」と呼んで慕っていたが、今では無表情で「カールさん」と無表情に他人行儀で呼ぶ。武器はレイピアなどの細剣。"}],"source":"bangumi","sourceCharacterId":"140290"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c616fa76124069fbd5948326f830b73d4b54afb9755f3bff644ac07bdede3958.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79961b7db99297c524734caa6062754bd48986570c83a7f56b15d17bdd567674.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:101275:140290:4830:1","source":"bangumi"}]},{"characterId":"char_c22287","characterName":"リゼッタ＝パジェス","sourceIds":{"bangumi":[{"characterId":"140291","match":"exact-normalized-name-in-linked-work","subjectId":"101275"}],"egsCharacterIds":["25412"],"vndbCharacterId":"c22287"},"originalCharacterName":"リゼッタ＝パジェス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"落ち着いた雰囲気の無口な同級生。本人は努めて目立たないようにしているが、面倒見が良いので「リゼッタお姉様」と呼ばれている。偉大な魔術師だったらしい母親の行方を追って魔法学園にやってきた。武器は弓。"}],"source":"egs","sourceCharacterId":"25412","sourceWorkId":"7717","spoiler":false},{"segments":[{"spoiler":false,"text":"落ち着いた、無口な同級生。本人は意識して目立たないようにしているつもりだが、面倒見が良いので周りの女の子たちからは「リゼッタお姉様」と呼ばれて慕われている。"},{"spoiler":false,"text":"偉大な魔術師だったという母親の消息を尋ねて魔法学園の門を叩く。武器は弓。"}],"source":"bangumi","sourceCharacterId":"140291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7be4a929d646a6f4ce630b70e0a3fa265b3ed87f8032d9609d95548db88222a4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/175cf33c8e95633d717cf6abc56a2e176b28cc022fd5fe4a1cbe57461c0b1b12.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:101275:140291:6379:1","source":"bangumi"}]},{"characterId":"char_c39653","characterName":"カール＝ワインバーグ","sourceIds":{"bangumi":[{"characterId":"140292","match":"exact-normalized-name-in-linked-work","subjectId":"101275"}],"egsCharacterIds":["25408"],"vndbCharacterId":"c39653"},"originalCharacterName":"カール＝ワインバーグ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"His aunt (father's older sister) Marion Weinberg appeared in the previous game."}],"source":"vndb","sourceCharacterId":"c39653"},{"segments":[{"spoiler":false,"text":"魔術師の名門、クライトン家の傍流に生まれる。両親を早くに亡くしたが、魔術師の才能を認められ本家に預けられる。リィナの病気を治したいがため、魔術師を志す。伯母（父の姉）は前作でも登場したマリオン。武器は長棍。"}],"source":"egs","sourceCharacterId":"25408","sourceWorkId":"7717","spoiler":false},{"segments":[{"spoiler":false,"text":"魔術師の名門、クライトン家の傍流に生まれる。両親は早くに亡くなっており、そのままなら路頭に迷う可能性もあったが、男子には珍しく魔術師としての才能が認められたため、本家に預けられる。"},{"spoiler":false,"text":"当主の双子の娘とは兄妹同然に育ってきており、特に寝たきりだった妹を気に掛けていた。魔術師の道を選んだのは、そうしないと支援を受けられないこともあったが、何よりも彼女の病気を治したいと思ったため。"},{"spoiler":false,"text":"叔母（父の姉）は前作でも登場したマリオン。武器は長棍。"}],"source":"bangumi","sourceCharacterId":"140292"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/176a7b2af5bef6a8bf762e4b7af7d025c14eeac64eef4445026eabf85f6d95e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a6cd77fe23eba9f041103f2beccc1eecd7992e943768ab623c3a64b056abbfc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木貴征","creatorId":"vndb:s37","sourcePersonId":"vndb:s37","canonicalEntityId":"vndb:s37","name":"鈴木 貴征","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:101275:140292:40410:1","source":"bangumi"}]},{"characterId":"char_c60603","characterName":"静穂＝エインズワース","sourceIds":{"bangumi":[{"characterId":"140293","match":"exact-normalized-name-in-linked-work","subjectId":"101275"}],"egsCharacterIds":["25411"],"vndbCharacterId":"c60603"},"originalCharacterName":"静穂＝エインズワース","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the second daughter of Ryle Ainsworth and Ayanokouji Mizuho from the previous game."}],"source":"vndb","sourceCharacterId":"c60603"},{"segments":[{"spoiler":false,"text":"前作の主人公ライルと瑞穂の間に生まれた２番目の娘。両親は姉の菫と世界中を飛び回っているため、寮でひとり暮らしをしている。犬型の天然系な性格。動物に変身できるが、ひどく驚くと人間の姿に戻ってしまい、しばらく変身できない。武器は薙刀。"}],"source":"egs","sourceCharacterId":"25411","sourceWorkId":"7717","spoiler":false},{"segments":[{"spoiler":false,"text":"前作の主人公ライルと、瑞穂の間に生まれた二人目の娘。両親は腕利きハンターとして長女菫と共に世界中を飛び回っているため、一人学園寮で暮らしている。"},{"spoiler":false,"text":"性格は母親に似ず天然系で、猫型と言うよりは犬型。次女なので賢者の石は胎内に受け継いでいないが、動物などの姿に変身する能力は持っている。そのため、頻繁に白猫に化けては学園中を徘徊し、挙げ句の果てには主人公の部屋に住み着いてしまう。武器は薙刀。"}],"source":"bangumi","sourceCharacterId":"140293"}],"profileFacts":[],"meta