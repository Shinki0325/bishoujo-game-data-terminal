de":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:128077","source":"vndb"},{"creditedName":"Soundsnap","creatorId":"vndb:s18227","sourcePersonId":"vndb:s18227","canonicalEntityId":"vndb:s18227","name":"Soundsnap","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:128078","source":"vndb"},{"creditedName":"Freesound","creatorId":"vndb:s23831","sourcePersonId":"vndb:s23831","canonicalEntityId":"vndb:s23831","name":"The Free Sound Project","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:128079","source":"vndb"},{"creditedName":"Brian Kwek","creatorId":"vndb:s50674","sourcePersonId":"vndb:s50674","canonicalEntityId":"vndb:s50674","name":"Brian Kwek","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:128080","source":"vndb"},{"creditedName":"Brian Kwek","creatorId":"vndb:s50674","sourcePersonId":"vndb:s50674","canonicalEntityId":"vndb:s50674","name":"Brian Kwek","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:128081","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c124274","characterName":"Stella Hoshii","sourceIds":{"vndbCharacterId":"c124274"},"originalCharacterName":"Stella Hoshii","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1225"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Stella Hoshii is the daughter of wealthy parents and a regular customer at VA-11 Hall-A. She is also a Cat Boomer and a long time friend of Sei Asagiri."}],"source":"vndb","sourceCharacterId":"c124274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5952df6b283aa694df41711690e6f9071f0e03d51a421f0fb476d485e2056fb7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25290a5a16b466e1e2d713e4e468de024cb0f7e415a95eb3e4ba37601c7187c7.webp","width":218,"height":189,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c54391","characterName":"Julianne Natalie Stingray","sourceIds":{"vndbCharacterId":"c54391"},"originalCharacterName":"Julianne Natalie Stingray","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"birthday":{"reviewState":"source-only","source":"vndb","value":"627"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jill is a 27-year-old bartender of VA-11 Hall-A and the main protagonist. She is one of two bartenders in the bar, the other being Gil."},{"spoiler":false,"text":"Half-French. Avid smoker. Went to college. Drinks a lot of beer because of her implant that allows her to drink lots of beer and not get drunk. Has a cat named Fore, whom she talks to every time she's at home"}],"source":"vndb","sourceCharacterId":"c54391"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf18581a7db592a740688f235fe7ead4cc05504020f6dc6ac963c4fb79198d7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a80ab8e3ffac153d43da1d3d6580c12bdb1893bf8d2fa20afa0412bc0bf249e3.webp","width":142,"height":182,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c54393","characterName":"Dana Zane","sourceIds":{"vndbCharacterId":"c54393"},"originalCharacterName":"Dana Zane","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"531"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Dana Zane is"},{"spoiler":true,"text":"a former wrestler and"},{"spoiler":false,"text":"the owner of VA-11 Hall-A. Her left arm is a mechanical prosthesis and is the subject of several rumors."}],"source":"vndb","sourceCharacterId":"c54393"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80e05321ecff99a3ddfc44504dd6c5dfc662ea25c4196ad48e386d3b2bdaae6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/747a7c1beec62dfa8e722e7ef881cfcae3303d109be998bd95ff5b5f2f739fad.webp","width":142,"height":209,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c54395","characterName":"Sei P. Asagiri","sourceIds":{"vndbCharacterId":"c54395"},"originalCharacterName":"Sei P. Asagiri","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"320"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A White Knight serving under the Valkyrie First-Response unit. Despite the White Knights' reputation, Sei is extremely kindhearted and truly believes in helping people."},{"spoiler":false,"text":"Although she isn't the sharpest tool in the shed, she can take care of herself and is one of the most kindhearted characters in the game. She's Stella's best friend"},{"spoiler":true,"text":"and unofficial bodyguard."},{"spoiler":true,"text":"Sei and Stella first met when Stella asked her father to take her to a \"real kids park\". The two formed a close bond and began to meet at the park regularly, until one day while they were there, a rogue White Knight took them hostage, on the run for undisclosed reasons. After being approached by the authorities, he began to gouge Stella's eye out and kicked Sei in the chest after she attempted to stop him, breaking several of her ribs and rupturing her organs, as well as knocking her out."},{"spoiler":true,"text":"Afterward, Sei briefly regained consciousness to see the White Knight on the ground, not moving, whilst another had her slumped over his shoulder. He put his helmet on Stella's head and the two were quickly taken to the hospital. Sei was placed into emergency care due to the severity of her injuries and only woke up after Stella began punching her leg, telling her to do so. The two of them recovered eventually."}],"source":"vndb","sourceCharacterId":"c54395"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/377944d5eeb27fc314fe9511070ae9e5f87db85ae554f4867726f13e95ad1115.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/808d5a7a1a7a368ddfb1fd13cb5161358dd896bd80e2b9c5d92224ab207b97b2.webp","width":205,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69153","characterName":"Alma Armas","sourceIds":{"vndbCharacterId":"c69153"},"originalCharacterName":"Alma Armas","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"725"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alma Armas is a professional hacker, a close friend of Jill, and a regular customer at VA-11 Hall-A."},{"spoiler":false,"text":"Alma tends to be playful and enjoys teasing people."},{"spoiler":true,"text":"However, she takes family and familial responsibility very seriously. One of the biggest sources of frustration in her life at the moment is that her older sister is not taking the time to actually raise her children."},{"spoiler":true,"text":"Alma started coming to VA-11 Hall-A roughly six months before the start of the game. She was served by Gillian the first time she came around but was served by Jill the second time and felt like Jill just \"got her.\""}],"source":"vndb","sourceCharacterId":"c69153"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d98d6578629eb5a1ca294095a27b6a1c299eb571d3b50b8f7db9ff7bb364309d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32223e4a9f409079bd6e1347fe26ccb132ce730865656b2daa638c9f14f0a4b8.webp","width":205,"height":215,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69154","characterName":"Art von Delay","sourceIds":{"vndbCharacterId":"c69154"},"originalCharacterName":"Art von Delay","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Art is a private investigator. He initially comes to VA-11 Hall-A seeking the killers Crimson Rose and Cobalt Lily, but ends up becoming a regular."},{"spoiler":false,"text":"Art makes a big deal about appearing cool and often acts like he's in a detective thriller. Despite his quirks, he does take his work seriously and is a competent PI."},{"spoiler":true,"text":"Art got his start as a private investigator when his daughter disappeared for years without a word after the two of them got into a big fight. At first, he waited for her but eventually, he got worried and started looking for her. Eventually, he found his daughter taking cover in a dumpster, unconscious from starvation. The contacts and skill he acquired during this time would continue to be used by him for years to come."},{"spoiler":true,"text":"After he found his daughter, Art continued to get regular work as a private investigator."}],"source":"vndb","sourceCharacterId":"c69154"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4ff70dd48dcb3b11128022ec93998c4991c9e350cf343ffca435eeb0cfcef59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74594393bf2e44686864a3a11d2974d9d0f8d016668ac948c198d4eb18655ad6.webp","width":205,"height":190,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69155","characterName":"Beatrice Albert","sourceIds":{"vndbCharacterId":"c69155"},"originalCharacterName":"Beatrice Albert","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"819"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Betty is a veterinarian who works at Seifar Toy Company, Deal's best friend, and a regular patron at VA-11 Hall-A."},{"spoiler":false,"text":"She is a lesbian and has had numerous short-lived relationships with other women,"},{"spoiler":true,"text":"usually ending them because of petty problems she has with her partner. Despite this, she feels she may be attracted to Deal, and asks Jill for advice about it."},{"spoiler":true,"text":"Betty fosters a dislike of cybernetic enhancements. This is due to her days of studying surgery at medical school when five of her classmates used shady means to try and get cybernetic enhancements for their hands. Although she managed to talk one of them out of it, two of them lost their hands, one of them became arthritic, and another died on the operating table. According to Jill, the man responsible for hooking them up was later caught, as was covered by a news story. Betty makes a distinction that she doesn't have a problem with cybernetic prostheses, only implants that drastically improve ability rather than serving as a replacement. She feels the same way about Lilim who needlessly upgrade their bodies."}],"source":"vndb","sourceCharacterId":"c69155"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae9b2e8af8525bc064da327457f1f17b2a9dd3d1dca8cb9c1dcecf5a2ecbfd76.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed8f0dfa6a088f2f5c522bbabe98ac0a533e5624bfb33c534cc99cc1964c0c3a.webp","width":205,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69156","characterName":"Deal","sourceIds":{"vndbCharacterId":"c69156"},"originalCharacterName":"Deal","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"413"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Deal is a Lilim, the best friend of Betty, and a regular patron at VA-11 Hall-A."},{"spoiler":false,"text":"Deal is rather straight-laced and matter of fact most of the time."},{"spoiler":false,"text":"He has an extreme love of dogs, Corgis in particular, meaning he greatly enjoys his work at the Seifar Toy Company."},{"spoiler":true,"text":"According to Betty, he sleeps with a Corgi plushie and has a wall dedicated to photos he's taken at the company."},{"spoiler":true,"text":"One of Deal's neighbors has a dog that works at Seifar. This neighbor was the one who originally told him that the company was looking to hire humanoids. Deal now has the job mostly because the company legally has to have one humanoid on the payroll. He works as an \"office boy\", but with greater duties as he often has to perform jobs and functions that his employers are unable to complete because of their lack of thumbs."}],"source":"vndb","sourceCharacterId":"c69156"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee7e8c2ef7675edd78eac745183061bb272f455fdb79dca35598a7a4ce552281.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a11e3960b2c17ea75fe785e471f0b1ac356a3502d11cc499c1b93687edf81290.webp","width":205,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69157","characterName":"Donovan D. Dawson","sourceIds":{"vndbCharacterId":"c69157"},"originalCharacterName":"Donovan D. Dawson","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"112"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Donovan D. Dawson is the owner and CEO of The Augmented Eye, ex-employer of Kimberly La Vallette and a customer at VA-11 Hall-A."},{"spoiler":false,"text":"Donovan has a very crude personality and is often one to speak his mind."},{"spoiler":true,"text":"Despite his crudeness, however, he appears to be an extremely intelligent man, owning and running The Augmented Eye, and perhaps more impressively, learned Cantonese in just 2 weeks, because he didn't want to be seen with his translator."},{"spoiler":true,"text":"Donovan has been married at least twice and is still paying alimony on at least one. Years ago he went to Hong Kong to try to start a silicon business and was in the city during the Hong Kong riots."}],"source":"vndb","sourceCharacterId":"c69157"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f87050638406ce5e2424f1bcacb9fb87ae7cb685362cea8eb0ac3880f59fb901.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da50a74d8f1582038ba0e01998e33da1bc3b9444f03436732beb5f345283e866.webp","width":205,"height":215,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69158","characterName":"Rebecca Dorothy Willow Graem","sourceIds":{"vndbCharacterId":"c69158"},"originalCharacterName":"Rebecca Dorothy Willow Graem","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1105"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rebecca Dorothy Willow Graem (otherwise known as Dorothy Haze) is a Lilim sex worker, a close friend of Julianne Stingray, and a regular patron at VA-11 Hall-A. She is a DFC-72 class Lilim."},{"spoiler":false,"text":"Dorothy appears to have a bubbly, joyful and somewhat flirtatious attitude. She often greets every patron politely."},{"spoiler":false,"text":"Like all Lilim, Dorothy was also programmed with a random character quirk. In her case, she has an irrational fear of dogs and chinchillas."},{"spoiler":true,"text":"She takes great pride in her work, often discussing it with Jill and even Streaming-chan at one point. Her kind nature was also shown when she gave up an entire day's work to come visit Jill when she was feeling down, sleeping with her overnight in order to comfort her, all for enough money to \"pay for a can of soda\"."},{"spoiler":true,"text":"Her physical appearance age is 13, while mental age is 24"}],"source":"vndb","sourceCharacterId":"c69158"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36604b7724082a0bd62669cfc331d338e349ed27d32fb9ec857dd956664b0bb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da77cfb73a413ec56fdb7971653802e03832053a417ef88f0a1e7643c8a1b437.webp","width":205,"height":170,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69161","characterName":"Ingram McDougal","sourceIds":{"vndbCharacterId":"c69161"},"originalCharacterName":"Ingram McDougal","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"228"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ingram McDougal is a man who is generally ill tempered. He likes strong drinks."},{"spoiler":true,"text":"Four years before the beginning of the game, Ingram's daughter died due to a White Knights hitting her to move her out of the way, causing her to hit her head on a wall and die. Infuriated, Ingram spent years paying for information regarding the man who killed his daughter. He eventually got his revenge, hiring someone to kill the man."},{"spoiler":true,"text":"Although he was able to find justice for his daughter, he remarks still feels empty inside, as evident to his constant vices to fill the hole with sex, booze and Dorothy, which is hired every year to roleplay as his own daughter."}],"source":"vndb","sourceCharacterId":"c69161"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3ce7298d9d8e5426f4c669560f4db548736d7f47be43b4a7a2a94bfd8205b7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c943c9a32a6d3ff917c75d08e21d4ea8876961deee5dd83cfce3320eba57deca.webp","width":205,"height":210,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c80881","characterName":"*Kira* Miki","sourceIds":{"vndbCharacterId":"c80881"},"originalCharacterName":"*Kira* Miki","characterNameSource":null,"role":"side"