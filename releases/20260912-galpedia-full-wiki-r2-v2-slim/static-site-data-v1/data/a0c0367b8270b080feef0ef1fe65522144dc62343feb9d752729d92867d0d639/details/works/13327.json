ts":[{"spoiler":false,"text":"主人公の一学年上の先輩。前生徒会長で、現在は副会長を務めている。"},{"spoiler":false,"text":"入学してすぐに馬鹿騒ぎを起こして生徒たちに笑いを提供した主人公に目を付け生徒会に引き入れ、生徒会長に推薦、抜擢する。"},{"spoiler":false,"text":"面白いことが大好きで、そのためなら手段を選ばない、主人公と同じく“非”常識人。"},{"spoiler":false,"text":"しかし成績は優秀な上に美人のため、学園での人気はナンバーワン。"}],"source":"egs","sourceCharacterId":"14186","sourceWorkId":"13327","spoiler":false},{"segments":[{"spoiler":false,"text":"陽介の1つ上の先輩。前生徒会長にして、現生徒会副会長。"},{"spoiler":false,"text":"陽介を生徒会に引き込んだ人物。"},{"spoiler":false,"text":"入学してすぐに馬鹿騒ぎを起こし生徒たちを楽しませている陽介に目を付け、いつか生徒会に入れてしまおうと考えていた。"},{"spoiler":false,"text":"陽介と同じで非常識人。面白そうな事ならなんでも大好き。"},{"spoiler":false,"text":"成績優秀で美人なため、学園では人気NO.1．"}],"source":"bangumi","sourceCharacterId":"45804"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"14186","sourceWorkId":"13327","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"14186","sourceWorkId":"13327","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"14186","sourceWorkId":"13327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b259e1b5f0b1cd3bc4d0f20f90a0067847a6b096d8e15eadaebf6729ef38c87a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e8f6bc986697114581b995990fd79c3e5236d008bc90819ac0cc2f67a6ceccb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:25968:45804:6351:1","source":"bangumi"}]},{"characterId":"char_c37541","characterName":"水沼 珊瑚","sourceIds":{"bangumi":[{"characterId":"45805","match":"exact-normalized-name-in-linked-work","subjectId":"25968"}],"egsCharacterIds":["14187"],"vndbCharacterId":"c37541"},"originalCharacterName":"水沼 珊瑚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"陽介の一つ下の後輩。生徒会の書記。"},{"spoiler":false,"text":"事なかれ主義の寡黙な女性。"},{"spoiler":false,"text":"自分に災いが降りかからないように注意しながら傍観者を決め込む。"},{"spoiler":false,"text":"あまり喋らない自分をつまらない人間だと思い込んでいる。そのため自分に話しかけてくる主人公を変人だと思いながらも、なんとなく気になっている。"}],"source":"egs","sourceCharacterId":"14187","sourceWorkId":"13327","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会の書記。陽介の1つ下の下級生。"},{"spoiler":false,"text":"自分に災いが降りかからないようにしている、事なかれ主義の寡黙な性格。"},{"spoiler":false,"text":"陽介と涼香の言い合いを、双葉と一緒にお茶を飲みながら傍観している。"},{"spoiler":false,"text":"あまり喋らず、自分をつまらない人間だと自覚している。"},{"spoiler":false,"text":"その為、自分によく話しかけてくる唯一の男性である陽介のことを変人だと思っている反面、ちょっと気になってはいる。"}],"source":"bangumi","sourceCharacterId":"45805"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"14187","sourceWorkId":"13327","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"14187","sourceWorkId":"13327","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"14187","sourceWorkId":"13327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89242d75cc238965ea5da84f114806cab472ecfab593d22e77e2097c3e83de64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wi