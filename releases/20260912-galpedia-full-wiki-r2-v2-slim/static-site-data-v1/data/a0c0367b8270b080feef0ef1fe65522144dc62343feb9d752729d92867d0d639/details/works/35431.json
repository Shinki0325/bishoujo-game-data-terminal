","canonicalEntityId":"vndb:s10650","name":"miko_master","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:201445","source":"vndb"},{"creditedName":"ハラユカ。","creatorId":"vndb:s15589","sourcePersonId":"vndb:s15589","canonicalEntityId":"vndb:s15589","name":"ハラユカ。","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:201446","source":"vndb"},{"creditedName":"奈緒","creatorId":"vndb:s27048","sourcePersonId":"vndb:s27048","canonicalEntityId":"vndb:s27048","name":"奈緒","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:201447","source":"vndb"},{"creditedName":"あき","creatorId":"vndb:s27050","sourcePersonId":"vndb:s27050","canonicalEntityId":"vndb:s27050","name":"あき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:201448","source":"vndb"},{"creditedName":"高岡 嘉子","creatorId":"vndb:s36781","sourcePersonId":"vndb:s36781","canonicalEntityId":"vndb:s36781","name":"高岡 嘉子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:201449","source":"vndb"}]},"cast":[{"characterId":"char_c132986","characterName":"真上 久遠","sourceIds":{"bangumi":[{"characterId":"143717","match":"exact-normalized-name-in-linked-work","subjectId":"466004"}],"egsCharacterIds":["24962"],"vndbCharacterId":"c132986"},"originalCharacterName":"真上 久遠","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人里から離れた山中の神社に暮らす女の子。"},{"spoiler":false,"text":"明るく前向き、純真無垢な性格をしている。"},{"spoiler":false,"text":"今は亡き母や動物たち以外とは接しておらず、色々と世間知らずで純粋なところがある。"},{"spoiler":false,"text":"真神大神まかみのおおかみという神様の父と退魔巫女の母の間に生まれた半神半人である。"},{"spoiler":false,"text":"退魔巫女だった母の手ほどきを受けて、剣技や術を修めている。"},{"spoiler":false,"text":"退魔士見習いというレベルだが、血統からかその潜在能力は非常に高い。"},{"spoiler":false,"text":"山奥の神社で過ごし、母以外の人とは接触が無かったため、世俗に疎い。"}],"source":"egs","sourceCharacterId":"24962","sourceWorkId":"35431","spoiler":false},{"segments":[{"spoiler":false,"text":"人里から離れた山中の神社に暮らす女の子。"},{"spoiler":false,"text":"明るく前向き、純真無垢な性格をしている。"},{"spoiler":false,"text":"今は亡き母や動物たち以外とは接しておらず、"},{"spoiler":false,"text":"色々と世間知らずで純粋なところがある。"},{"spoiler":false,"text":"真神大神(まかみのおおかみ)という神様の父と"},{"spoiler":false,"text":"退魔巫女の母の間に生まれた半神半人である。"},{"spoiler":false,"text":"退魔巫女だった母の手ほどきを受けて、剣技や術を修めている。"},{"spoiler":false,"text":"退魔士見習いというレベルだが、血統からかその潜在能力は非常に高い。"},{"spoiler":false,"text":"山奥の神社で過ごし、母以外の人とは接触が無かったため、世俗に疎い。"},{"spoiler":false,"text":"——————————————————————————————————————"},{"spoiler":false,"text":"住在远离人类集落的森林中的神社的少女。"},{"spoiler":false,"text":"个性开朗、正向又纯真无邪。"},{"spoiler":false,"text":"因为没接触过已故的母亲与动物之外的事物，有着不谙世事又纯真的一面。"},{"spoiler":false,"text":"身为父亲「真神大神」与母亲「退魔巫女」之间的爱情结晶，她是个半人半神的存在。"},{"spoiler":false,"text":"而做过退魔巫女的母亲以前曾经教导过她剑术与术式。"},{"spoiler":false,"text":"虽然会的东西大概就只是个见习退魔士，但因为她的血统的关系潜能很高。"},{"spoiler":false,"text":"由于一直在山里的神社内生活，除了母亲以外也没有接触任何人，对世事一窍不通。"}],"source":"bangumi","sourceCharacterId":"143717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3c4b4495ab081a3703cb082c9141839d71d24a1e14bfcb13321a386c7bfc2f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4c6490c37cb47ccfa332f41f6d1bc7f3563eeb41f042474f7c689d5790b898d.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みたかりん","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:466004:143717:25596:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2720","sourceCompanyId":"egs:brand:2720","canonicalEntityId":"egs:bra