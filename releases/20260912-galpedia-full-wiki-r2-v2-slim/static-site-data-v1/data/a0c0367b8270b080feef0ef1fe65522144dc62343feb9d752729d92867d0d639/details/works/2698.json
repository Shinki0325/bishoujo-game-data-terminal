ts":[{"spoiler":false,"text":"青央学園に通う三年生。青央学生会会長。"},{"spoiler":false,"text":"ワガママで意地っ張り、プライドの高いお金持ちのお嬢様。"},{"spoiler":false,"text":"しかし、突っ込まれたり、守りに入ると弱く、オロオロしてしまうことも。"},{"spoiler":false,"text":"学園では高嶺の花的な存在だが、主人公が級長を務めていたときに出席した学生会会議で知り合う。"},{"spoiler":false,"text":"実はド近眼なのだが、主人公以外には知られていないらしい。"}],"source":"egs","sourceCharacterId":"22766","sourceWorkId":"3299","spoiler":false},{"segments":[{"spoiler":false,"text":"本編ヒロイン。"},{"spoiler":false,"text":"宝飾品店を持つ三ノ宮グループ会長家の一人娘。青央学園の一年生。"},{"spoiler":false,"text":"高慢でワガママなお嬢様だが、何処か抜けていたり、意外に頑張り屋さんだったりもする。"},{"spoiler":false,"text":"実はド近眼でコンタクト派。"},{"spoiler":false,"text":"ひょんなことから憧れの先輩二人のお屋敷で、住み込みのメイドとして働くことになる。"}],"source":"egs","sourceCharacterId":"22766","sourceWorkId":"7027","spoiler":false},{"segments":[{"spoiler":false,"text":"青央学園３年Ａ組。青央学生会会長。"},{"spoiler":false,"text":"洋介は級長だった事で、学生会会議に出席する事で知り合いになった。"},{"spoiler":false,"text":"お金持ちのお嬢様で、わがままで意地っ張りで高飛車。"},{"spoiler":false,"text":"しかしツッコミに弱く、すぐにオロオロしてしまう面もある。"},{"spoiler":false,"text":"実はド近眼なのだが、その事は学園内では洋介以外誰も知らない。"}],"source":"bangumi","sourceCharacterId":"109239"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af7776ce3324a886e053c19f0ea4adcc25f5cec0bd255417f51aef5204d7060a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/011848b0a98ddf42d929d808540ea3b03826fcf05b57555b5244863bed356e60.webp","width":141,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c3434","characterName":"櫻井 詩乃","sourceIds":{"bangumi":[{"characterId":"95765","match":"exact-normalized-name-in-linked-work","subjectId":"146050"},{"characterId":"95765","match":"exact-normalized-name-in-linked-work","subjectId":"206368"},{"characterId":"95765","match":"exact-normalized-name-in-linked-work","subjectId":"592748"}],"egsCharacterIds":["22777"],"vndbCharacterId":"c3434"},"originalCharacterName":"櫻井 詩乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"白雲学園に赴任してきたばかりの新米化学教師。"},{"spoiler":false,"text":"2年C組の担任にして科学部顧問、さらには学生会副顧問まで務める。"},{"spoiler":false,"text":"いつも眠そうな眼と、丁寧な口調が特徴。"},{"spoiler":false,"text":"おっとりしていながら、押しが強い。"},{"spoiler":false,"text":"セックスが大好きで、基本的に老若男女、時と場所も問わず、あらゆるエッチに精通。"}],"source":"egs","sourceCharacterId":"22777","sourceWorkId":"2698","spoiler":false},{"segments":[{"spoiler":false,"text":"青央学園の化学教師。学生会顧問。"},{"spoiler":false,"text":"昨年度から引き続き、主人公のクラス担任を務めている。"},{"spoiler":false,"text":"可愛らしい容姿と、たわわに実った巨乳とも相俟って、学園内でナンバーワンの人気を誇る。"},{"spoiler":false,"text":"いつも眠たそうな目をしていて、まったりしていそうだが、意外に押しが強く、授業もテスト厳しく教えるスパルタ教師。"},{"spoiler":false,"text":"鈴音とは大学のサークルで知り合い、それが縁で親友になった。"},{"spoiler":false,"text":"「あら。わたくしはそんなつもりはありませんでしたよ？」"}],"source":"egs","sourceCharacterId":"22777","sourceWorkId":"3299","spoiler":false},{"segments":[{"spoiler":false,"text":"白雲学園に赴任してきたばかりの新米化学教師。"},{"spoiler":false,"text":"2年C組の担任にして科学部顧問、さらには学生会副顧問まで務める。"},{"spoiler":false,"text":"いつも眠そうな眼と、丁寧な口調が特徴。"},{"spoiler":false,"text":"おっとりしていながら、押しが強い。"},{"spoiler":false,"text":"セックスが大好きで、基本的に老若男女、時と場所も問わず、あらゆるエッチに精通。"}],"source":"bangumi","sourceCharacterId":"95765"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17b34727fb218e3594ebe3779be8a3dee17e0f3c4e7b1bbfd4f3f05b354ad7f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7538983df1c7872962c0858343181203c414ec92587d214be48b052a36181277.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:146050:95