{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"16891","model":{"presentationWorkId":"vndb:v10211","staff":{"artwork":[{"creditedName":"タカスギコウ","creatorId":"vndb:s7063","sourcePersonId":"egs:creator:16766","canonicalEntityId":"vndb:s7063","name":"タカスギコウ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:103998","source":"egs"}],"scenario":[{"creditedName":"髪ノ毛座","creatorId":"vndb:s1948","sourcePersonId":"egs:creator:2275","canonicalEntityId":"vndb:s1948","name":"髪ノ毛座","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:104000","source":"egs"}],"music":[{"creditedName":"Funczion SOUNDS","creatorId":"vndb:s1071","sourcePersonId":"vndb:s1071","canonicalEntityId":"vndb:s1071","name":"Funczion SOUNDS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:87251","source":"vndb"}],"other":[{"creditedName":"回転木馬","creatorId":"vndb:s1027","sourcePersonId":"egs:creator:16720","canonicalEntityId":"vndb:s1027","name":"回転木馬","detail":"企画・プロデュース","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:104001","source":"egs"},{"creditedName":"回転 木馬","creatorId":"vndb:s1027","sourcePersonId":"vndb:s1027","canonicalEntityId":"vndb:s1027","name":"回転 木馬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87250","source":"vndb"},{"creditedName":"あらき まき","creatorId":"vndb:s2830","sourcePersonId":"vndb:s2830","canonicalEntityId":"vndb:s2830","name":"あらき まき","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:87253","source":"vndb"},{"creditedName":"タカスギ コウ","creatorId":"vndb:s7063","sourcePersonId":"vndb:s7063","canonicalEntityId":"vndb:s7063","name":"タカスギ コウ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:87254","source":"vndb"},{"creditedName":"豪カート","creatorId":"vndb:s7064","sourcePersonId":"vndb:s7064","canonicalEntityId":"vndb:s7064","name":"豪カート","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:87256","source":"vndb"}]},"cast":[{"characterId":"char_c137865","characterName":"メリケン爺","sourceIds":{"bangumi":[{"characterId":"92035","match":"exact-normalized-name-in-linked-work","subjectId":"82289"}],"egsCharacterIds":["8801"],"vndbCharacterId":"c137865"},"originalCharacterName":"メリケン爺","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious old man who is always fishing in the harbor. He calls himself the village elder. He is called “Meriken-aji” (American old man) by everyone."},{"spoiler":false,"text":"No one knows the exact reason why he is called so, but a popular theory explaining his name is because he is fond of saying, \"Blond girls are American girls\"."},{"spoiler":false,"text":"Since there is no bookstore in the village, he lends the main character his small motorcycle to go to the next town to buy western gravure magazines. He is good friends with the main character and often talks with him when he comes to the port. He often tells erotic gossip to the protagonist, which may or may not be true."},{"spoiler":false,"text":"He used to be the owner of a movie theater on top of a hill, but he quit the business a long time ago."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c137865"},{"segments":[{"spoiler":false,"text":"いつも港で釣りをしている謎の爺さん。"},{"spoiler":false,"text":"自称・村の長老。"},{"spoiler":false,"text":"みんなからは\"メリケン爺\"と呼ばれている。"},{"spoiler":false,"text":"なぜそう呼ばれているのか、明確な理由は誰も知らないが「おなごはパツキンのメリケン娘に限る」が口癖なので、“メリケン爺”と呼ばれるようになった、という説が有力。"}],"source":"egs","sourceCharacterId":"8801","sourceWorkId":"16891","spoiler":false},{"segments":[{"spoiler":false,"text":"職業：不明　 趣味：釣り・グラビア鑑賞"},{"spoiler":false,"text":"いつも港で釣りをしている謎の爺さん。自称・村の長老。"},{"spoiler":false,"text":"みんなからは “メリケン爺” と呼ばれている。"},{"spoiler":false,"text":"なぜそう呼ばれているのか明確な理由は誰も知らないが、「おなごはパツキンのメリケン娘に限る」 が口癖なので、“メリケン爺” と呼ばれるようになった、という説が有力。"},{"spoiler":false,"text":"主人公とは仲が良く、よく港へやってくる主人公と話をしている。"},{"spoiler":false,"text":"内容は主にエロ話で、本当か嘘かも分からないようなエロイうわさ話を、よく主人公に吹き込んでくる。"},{"spoiler":false,"text":"「やっぱり、おなごはメリケン娘に限るのぉ～」"}],"source":"bangumi","sourceCharacterId":"92035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c492f1ccb1e2a4add76cdf822612ebbff32831b3f00ed8389225ab6bf0d1fbcf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a65c431d9e5a4be29fb777301d45431cab75a9da1cfb9ba0aa514e3628602b61.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c40671","characterName":"バーバー三崎","sourceIds":{"bangumi":[{"characterId":"92033","match":"exact-normalized-name-in-linked-work","subjectId":"82289"}],"egsCharacterIds":["8799"],"vndbCharacterId":"c40671"},"originalCharacterName":"バーバー三崎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"42"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"J"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She an older woman who runs the only barbershop in in the village, She's known as \"Barber Misaki\"."},{"spoiler":false,"text":"She remains youthful and her flamboyant appearance and personality makes her stand out from the crowd in the village. Since, junior high school, she had been a beautiful girl with big breasts, making her the target for constant rumors regarding her having romantic relationships with many men, she would be regularly shunned by the women of the village."},{"spoiler":false,"text":"After graduating from high school, she moved to Tokyo to become an actress, but her dream did not come true and about 10 years later she returned to the village and started a barbershop."},{"spoiler":false,"text":"Perhaps because she had been through the rough and tumble of the city, she has lost all of her moxie, and now has a calm and easygoing personality. No one in the village knows what kind of rough times he went through."},{"spoiler":false,"text":"However, perhaps because of her youth, he is still a bit out of place in the village. The main character is a regular customer who comes to the barbershop without any regard for such things. On his off days the main character has a habit of going to the barbershop to read manga. She buys new issues of manga several times a month for him."},{"spoiler":false,"text":"She has been watching over the main character since he was a child, but recently she has noticed that he sees her as a woman, and she is happy but at the same time confused."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c40671"},{"segments":[{"spoiler":false,"text":"村にある唯一の床屋「バーバー三崎」を営んでいるおばちゃん。"},{"spoiler":false,"text":"若い頃は見た目も性格も派手で、村の中では浮いた存在だった。"},{"spoiler":false,"text":"高校を卒業した後、女優を目指して上京したのだが夢は叶わず、約十年後に村へ戻ってきて床屋を始めた。"},{"spoiler":false,"text":"都会の荒波に揉まれたためか、すっかり角は取れ、今でははんなりと穏やかな性格になっている。"},{"spoiler":false,"text":"どんな荒波に揉まれたかは村の誰も知らない。"},{"spoiler":false,"text":"主人公は、そんなこと関係無しで床屋へやってくる常連さん。"},{"spoiler":false,"text":"幼い頃からずっと見守ってきた主人公が、最近自分をオンナとして見ていることに気付き、嬉しく思いつつも戸惑っている。"}],"source":"egs","sourceCharacterId":"8799","sourceWorkId":"16891","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢：42歳　 身長：170cm　 スリーサイズ：B100（J）/ W65/ H92"},{"spoiler":false,"text":"趣味：映画鑑賞　 方言：はんなりした方言"},{"spoiler":false,"text":"村にある唯一の床屋 『バーバー三崎』 を営んでいるおばちゃん。"},{"spoiler":false,"text":"若い頃は見た目も性格も派手で、村の中では浮いた存在だった。"},{"spoiler":false,"text":"女優を目指して上京したのだが夢は叶わず、約十年後に戻ってきて床屋を始めた。"},{"spoiler":false,"text":"都会の荒波に揉まれたためか、すっかり角は取れ、今でははんなりと穏やかな性格になっている。 どんな荒波に揉まれたかは村の誰も知らない。"},{"spoiler":false,"text":"主人公は、そんなこと関係無しで床屋へやってくる常連さん。"},{"spoiler":false,"text":"幼い頃からずっと見守ってきた主人公が、最近自分をオンナとして見ていることに気付き、嬉しく思いつつも戸惑っている。"},{"spoiler":false,"text":"「いつでも来てくれてええよ。おばちゃんの店、ヒマやし」"}],"source":"bangumi","sourceCharacterId":"92033"}],"profileFacts":[{"label":"年龄（本版本）","value":"42 岁","valueContext":null,"source":"egs","sourceCharacterId":"8799","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"100 cm","valueContext":null,"source":"egs","sourceCharacterId":"8799","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"j","valueContext":null,"source":"egs","sourceCharacterId":"8799","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"8799","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"8799","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"8799","sourceWorkId":"16891","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba753daf9f63bd30555c047867838690cf0fc752e9a44ae820edc36672dfd6bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb3c5232d0d7c7b62f523216554f9956357b22397683edc752c8b72bb1510295.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉ゆき","creatorId":"vndb:s839","sourcePersonId":"vndb:s839","canonicalEntityId":"vndb:s839","name":"佐倉 ゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82289:92033:15997:1","source":"bangumi"},{"creditedName":"緋牡丹","creatorId":"vndb:s7859","sourcePersonId":"vndb:s7859","canonicalEntityId":"vndb:s7859","name":"緋牡丹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46287","source":"vndb"}]},{"characterId":"char_c40672","characterName":"野津 江美子","sourceIds":{"bangumi":[{"characterId":"92034","match":"exact-normalized-name-in-linked-work","subjectId":"82289"}],"egsCharacterIds":["8800"],"vndbCharacterId":"c40672"},"originalCharacterName":"野津 江美子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"35"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character is her husband's nephew. The main character who lost his parents was taken in by them and raised as if he was their own child. Her husband is a fisherman and comes home only a few times a year because of the long fishing trips."},{"spoiler":false,"text":"She was born and raised in the village, and her husband is also from the village. She is the only woman diver in the village and goes out to sea every day to fish."},{"spoiler":false,"text":"She has a deep-seated and amiable personality, but when her husband does not return for a long period of time, she begins to feel anguish and a mysterious atmosphere begins to emerge."},{"spoiler":false,"text":"For a while, she releases her anguish by diving, but when she can no longer hold it in, she asks the protagonist for some “help\"."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c40672"},{"segments":[{"spoiler":false,"text":"主人公の叔母。"},{"spoiler":false,"text":"夫の甥である、両親を亡くした主人公を引き取り、自分の子供同然に育ててきた。"},{"spoiler":false,"text":"夫は漁師で、遠洋漁業にでているため年に数回しか帰って来ない。"},{"spoiler":false,"text":"溌剌としていて人当たりの良い性格だが、長い期間夫が帰って来ないと悶々とした気持ちが溜まり、妖しい雰囲気を漂わせ始める。"},{"spoiler":false,"text":"しばらくは素潜りなどで悶々とした気持ちを発散させているが、それでも抑えきれなくなると主人公にとある「お手伝い」を頼んでくる。"},{"spoiler":false,"text":"洋子のことは、若い頃の印象が強く残っているため、あまり良く思っていない。"},{"spoiler":false,"text":"そのため、主人公が床屋へ行くこともあまり快く思っていない。"}],"source":"egs","sourceCharacterId":"8800","sourceWorkId":"16891","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢：35歳　 身長：162cm　 スリーサイズ：B93（H）/ W64/ H95"},{"spoiler":false,"text":"趣味：素潜り　 方言：ハツラツとした方言"},{"spoiler":false,"text":"主人公の叔母。両親を亡くした主人公を引き取り、自分の子供同然に育ててきた。"},{"spoiler":false,"text":"夫は漁師で、遠洋漁業に出ているため年に数回しか帰って来ない。"},{"spoiler":false,"text":"ハツラツとしていて人当たりの良い性格だが、長い期間夫が帰って来ないと悶々とした気持ちが溜まり、妖しい雰囲気を漂わせ始める。"},{"spoiler":false,"text":"しばらくは素潜りなどで悶々とした気持ちを発散させているが、それでも抑えきれなくなると主人公に とある “お手伝い” を頼んでくる。"},{"spoiler":false,"text":"洋子のことは、若い頃の印象が強く残っているため、あまり良く思っていない。"},{"spoiler":false,"text":"そのため、主人公が床屋へ行くこともあまり快く思っていない。"},{"spoiler":false,"text":"「ええやん。身内なんやから照れる必要ないやろ？」"}],"source":"bangumi","sourceCharacterId":"92034"}],"profileFacts":[{"label":"年龄（本版本）","value":"35 岁","valueContext":null,"source":"egs","sourceCharacterId":"8800","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"8800","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"8800","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"8800","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"8800","sourceWorkId":"16891","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"8800","sourceWorkId":"16891","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/991363500e84a4930554c32a8a35fe86a7a7539079d0cc2e13f848242dee971f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0a644831f918e42c6620ad69cc3ae8cd2639ab7e3ad960cdfa9dab544c0b032.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅里紗生","creatorId":"vndb:s2569","sourcePersonId":"vndb:s2569","canonicalEntityId":"vndb:s2569","name":"梅里 紗生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82289:92034:21339:2","source":"bangumi"},{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82289:92034:4940:1","source":"bangumi"}]},{"characterId":"char_vndb_c137864","characterName":"野津一平","sourceIds":{"vndbCharacterId":"c137864"},"originalCharacterName":"野津一平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character."},{"spoiler":false,"text":"He lost his mother when he was a baby and his father when he was in junior high school, and was taken in by his uncle and his wife. However, he has a cheerful personality that belies her circumstances."},{"spoiler":false,"text":"His father taught him to speak in standard Japanese since he was a child. His uncle and his wife continued that educational policy and raised him accordingly. He does not have his village's dialect whatsoever."},{"spoiler":false,"text":"There is no one in the village of his age, and he is the only one who can be called a young man. Next year, he is going to work at a kamaboko factory in a neighboring town. On his days off, he usually goes to the barbershop and reads manga."},{"spoiler":false,"text":"He has known the old lady at the barbershop for a long time, but after hearing a rumor from old man Meriken, he becomes strangely conscious of her."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c137864"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2968","sourceCompanyId":"egs:brand:3412","canonicalEntityId":"vndb:p2968","name":"Guilty eX","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:16891:3412","source":"egs"},{"companyId":"vndb:p2968","sourceCompanyId":"vndb:p2968","canonicalEntityId":"vndb:p2968","name":"Guilty eX","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:24346:v10211","source":"vndb"},{"companyId":"vndb:p2968","sourceCompanyId":"vndb:p2968","canonicalEntityId":"vndb:p2968","name":"Guilty eX","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:24586:v10211","source":"vndb"},{"companyId":"vndb:p1276","so