ndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the main character's younger sister who lives with him in a rather large house."},{"spoiler":false,"text":"She used to not be an excellent cook, but she joined the cooking club so that the main character could eat delicious meals."},{"spoiler":false,"text":"Thanks to this, her cooking skills have improved considerably."},{"spoiler":false,"text":"She has a huge brother complex and is also a spoiled child."},{"spoiler":false,"text":"Perhaps this is because he has been living alone with him since their parents passed away."},{"spoiler":false,"text":"Recently, he seems to have started distancing himself from the protagonist, albeit gradually..."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c51787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2aa6831b114bf15cc3fd637f493d42163b646c17614756b03bbf25cbb425c11c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa27a522d1b315744aa22ccfcd934b029e5761eecce8397357705bae1898a4fe.webp","width":148,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51790","characterName":"氷野 綾音","sourceIds":{"vndbCharacterId":"c51790"},"originalCharacterName":"氷野 綾音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An honours type who cares about grades and such other things."},{"spoiler":false,"text":"She looks down on others, but is that because she is afraid to think of herself as weak?"},{"spoiler":false,"text":"She has no friends in her class."},{"spoiler":false,"text":"She is the head of the tea ceremony club."},{"spoiler":false,"text":"In the tea ceremony club, she seems to get along well with others and even laughs."},{"spoiler":false,"text":"Her father is the principal of the school and raised her quite strictly."},{"spoiler":false,"text":"Her grades have been at the top of the class since he entered the school."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c51790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70a224bdad64aa8669043ad88858974ad3c399674122a1a081833491f377ea46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b3b7616f32f4360d702e31f6c5211b9da1121650a35a44f4891ce098cf7ddc4.webp","width":148,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51792","characterName":"エリザベータ","sourceIds":{"vndbCharacterId":"c51792"},"originalCharacterName":"エリザベータ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has recently transferred to a new school."},{"spoiler":false,"text":"She looks like a genuine foreigner, but her Japanese is fluent since she has been living in Japan since elementary school."},{"spoiler":false,"text":"Her mother is divorced and came to Japan with her daughter."},{"spoiler":false,"text":"On the surface, she is a friendly person, but she has had a traumatic experience and is not good with touching people."},{"spoiler":false,"text":"She is in the same class as Moe and they are good friends."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c51792"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfc7c974f8800be918c190822e051cce954d5241b53f7f7ff38818e5403dc4a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0afb4078dbb2ac32852b8ab21a4afeeb038f8aa39c49642d129bba1390104fd.webp","width":148,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51793","characterName":"大地 いづみ","sourceIds":{"vndbCharacterId":"c51793"},"originalCharacterName":"大地 いづみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a dignified and disciplined type of woman, with short-cut hair, and is the advisor of the archery club."},{"spoiler":false,"text":"She is popular among the students...but it seems that is only on the surface."},{"spoiler":false,"text":"Her good-natured personality makes her the target of envy among female students."},{"spoiler":false,"text":"For some reason, despite not being a physical education teacher, she still wears a jersey."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c51793"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/647eb42309f07aac3cc02210c05ec6b68da26fdba93062d6dc9ddc1619038e07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00cb0234e6ebc2d9635d9174f60762b67a250532a6f961e8d483c46c85a9d2ad.webp","width":148,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51794","characterName":"火炎院 麗香","sourceIds":{"vndbCharacterId":"c51794"},"originalCharacterName":"火炎院 麗香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strong-willed young lady. She tends to try to look good to those around her."},{"spoiler":false,"text":"She has two close aides and a few cronies."},{"spoiler":false,"text":"She does not get along well with Ayane Hino (Ayane has no interest in her), is hostile toward her, and often harasses her."},{"spoiler":false,"text":"His father is a city councillor and donates a large amount of money to the school."},{"spoiler":false,"text":"Therefore, there is no one at the school who can resist him."},{"spoiler":false,"text":"Incidentally, the protagonist has tutored Reika in the past."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c51794"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd2c534d1583ee5684ba1397fbc1fa4f16db1e61d4988b72456ef74ccc826bac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c3ba7b99dcc00c531630055e5c6aeb7e224e6f1c975d1e949e8963b553e2f5b.webp","width":148,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1502","sourceCompanyId":"egs:brand:191","canonicalEntityId":"vndb:p1502","name":"DEEP ZONE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:591:191","source":"egs"},{"companyId":"vndb:p1502","sourceCompanyId":"vndb:p1502","canonicalEntityId":"vndb:p1502","name":"Deep Zone","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:27164:v11287","source":"vndb"},{"companyId":"vndb:p4557","sourceCompanyId":"vndb:p4557","canonicalEntityId":"vndb:p4557","name":"Pandemonium","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:27165:v11287","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-fu