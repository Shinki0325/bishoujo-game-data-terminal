0418"},"originalCharacterName":"カイナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I don't want to go out. I'm scared of people outside...\""},{"spoiler":false,"text":"A boy living with his adoptive father in a mansion on the outskirts of town."},{"spoiler":false,"text":"He was abandoned shortly after he was born because of his hair color, and grew up in the facility of the God-Forgotten Conservation Group \"Tenkei no Kai\"."},{"spoiler":false,"text":"He was taken in by Jill about two years ago and started living in Uchimori, but he has little interaction with the townspeople."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c110418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3ef0e1357f7d0fa7d0633fd671a01cbdd32a72d8307ef88be8b61616916c4a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1de15960bdb207799f859824c69a29b86ecf29bc87dc85720f0aebf00c62e7e2.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c110419","characterName":"ジル・ヘッセン","sourceIds":{"vndbCharacterId":"c110419"},"originalCharacterName":"ジル・ヘッセン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You are not afraid of forgetting God.\""},{"spoiler":false,"text":"Kaina's adoptive father."},{"spoiler":false,"text":"He took Kaina from \"Tenkei no Kai\" and came to Uchimori about two years ago. He is a foreigner who is fluent in Japanese."},{"spoiler":false,"text":"He is as 