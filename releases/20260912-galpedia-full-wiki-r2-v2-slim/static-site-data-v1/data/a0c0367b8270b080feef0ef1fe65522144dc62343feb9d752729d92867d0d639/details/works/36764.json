{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36764","model":{"presentationWorkId":"egs:36764","staff":{"artwork":[{"creditedName":"広輪(広輪凪)","creatorId":"egs:creator:24216","sourcePersonId":"egs:creator:24216","canonicalEntityId":"egs:creator:24216","name":"広輪(広輪凪)","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:281512","source":"egs"},{"creditedName":"BlackCony","creatorId":"egs:creator:41166","sourcePersonId":"egs:creator:41166","canonicalEntityId":"egs:creator:41166","name":"BlackCony","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:281513","source":"egs"}],"scenario":[{"creditedName":"遠蛮","creatorId":"egs:creator:41167","sourcePersonId":"egs:creator:41167","canonicalEntityId":"egs:creator:41167","name":"遠蛮","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:281510","source":"egs"}],"music":[],"other":[{"creditedName":"遠蛮","creatorId":"egs:creator:41167","sourcePersonId":"egs:creator:41167","canonicalEntityId":"egs:creator:41167","name":"遠蛮","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"no-alias-hit","relationId":"egs:work-creator:281511","source":"egs"}]},"cast":[{"characterId":"char_egs_26300","characterName":"新羅 辰馬","sourceIds":{"egsCharacterIds":["26300"]},"originalCharacterName":"新羅 辰馬","characterNameSource":null,"role":"3","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"男性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"黒き翼の大天使(くろてん) 主人公。"},{"spoiler":false,"text":"アカツキ皇国京師太宰の冒険者育成校 「蒼月館」 の2年生主席、 筆頭者。女尊男卑のアカツキ皇国において男子で学年筆頭にあるというだけでその実力のほどは知れる。女の子じみた 美少女的容姿だが、 そのことは絶対に禁句。"},{"spoiler":false,"text":"実家は古武術道場 「新羅江南流」講武所。武芸も達者なら霊的資質においても傑出しており、神力と魔力の融和して一段上に昇華させた力 の使い手。"},{"spoiler":false,"text":"これは彼が聖女アーシェ・ユスティニアと魔王オディナ、この二人の間に生まれた魔皇子であるゆえ。"},{"spoiler":false,"text":"魔皇子ではあるのだが、脆弱惰弱といわれても仕方ないほどメンタルは豆腐。 敵にとどめを刺せないのはもちろん、モンスター相手でも殺せない。拷問とか伝聞を聞かされただけでも泣くし、なんなら華を踏んだだけでも泣く。そのくせふだんの態度や言葉遣いは傲岸なくらい生意気で放埓で野放図。「殺す」のは絶対的にタブーだが「しばく」のはOKというよくわからない自分ルールを持つ。"},{"spoiler":false,"text":"彼が帝紀1816年6月19日、山賊のアジトからヒロイン神楽坂瑞穂を救出したことから物語が動き出す。第1幕の終着点はヒノミヤとの決着だが、今作(1幕1章)では悪辣の女神サティアが相手。"}],"source":"egs","sourceCharacterId":"26300"},{"segments":[{"spoiler":false,"text":"アカツキ皇国京師太宰の冒険者育成校 「蒼月館」 の、 2年生主席。 筆頭者。"},{"spoiler":false,"text":"女尊男卑のアカツキ皇国において男子で学年筆頭にある、 というだけでその実力のほどは知れる。"},{"spoiler":false,"text":"実家は古武術道場 「新羅江南流」講武所。"},{"spoiler":false,"text":"武芸も達者なら霊的資質においても傑出しており、神力と魔力の融和して一段上に昇華させた力 の使い手。"},{"spoiler":false,"text":"これは彼が聖女アーシェ・ユスティニアと魔王オディナ、この二人の間に生まれた魔皇子であるゆえ。"},{"spoiler":false,"text":"魔皇子ではあるのだが、 脆弱惰弱といわれても仕方ないほどメンタルは豆腐。 敵にとどめを刺せないのはもちろん、モンスター相手でも殺せない。"},{"spoiler":false,"text":"拷問とか伝聞を聞かされただけでも泣くし、なんなら華を踏んだだけでも泣く。"},{"spoiler":false,"text":"そのくせふだんの態度や言葉遣いは傲岸なくらい生意気で放埓で野放図、「殺す」のは絶対的にタブーだが「しばく」のはOKというよくわからない自分ルールを持つ。"},{"spoiler":false,"text":"帝紀1816年6月19日、山賊のアジトから神楽坂瑞穂を救出、 このことから物語が動き出す。"},{"spoiler":false,"text":"第1幕の終着点はヒノミヤとの決着だが1幕1章では悪辣の女神サティアが相手。"},{"spoiler":false,"text":"女の子じみた、 美少女的容姿だが、 そのことは絶対に禁句。"}],"source":"egs","sourceCharacterId":"26300","sourceWorkId":"36764","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"26300","sourceWorkId":"36764","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_egs_26301","characterName":"神楽坂 瑞穂","sourceIds":{"egsCharacterIds":["26301"]},"originalCharacterName":"神楽坂 瑞穂","characterNameSource":null,"role":"1","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メインヒロインの一人。"},{"spoiler":false,"text":"アカツキ皇国宗教特区「ヒノミヤ」の巫女衆筆頭、84代齋姫。神官長神楽坂相模の娘だが養女であり、幼いころは皇国京師の2等市街区でスリをしていたことも。作中随一のバスト121センチを誇るが体重も相応に重いのを気にしている。"},{"spoiler":false,"text":"皇国の主神神炎の豊穣女神 「ホノアカ」のほか、時間操作の「トキジク」、 人の心を読む「サトリ」、あわせて三柱の神と契約している絶大な精神許容量の持ち主。"},{"spoiler":false,"text":"明るく穏やかで人当たりのいい性格だが、 性欲が非常に強い。"},{"spoiler":false,"text":"ヒノミヤ神楽坂派の聖域 「奥津城」の神座にあって巫女たちを差配していたが、対抗者である神月派神月五十六の軍師磐座穣の攻撃を受け、奥津城陥落寸前に晦日美咲に導かれて脱出。帝紀1816年6月19日、 釜山の洞窟で新羅辰馬に救われ庇護を受け、そのためか辰馬を「ご主人様」と慕う。"}],"source":"egs","sourceCharacterId":"26301"},{"segments":[{"spoiler":false,"text":"メインヒロインの一人。"},{"spoiler":false,"text":"アカツキ皇国宗教特区 「ヒノミヤ」 の巫女衆筆頭・84代齋姫。"},{"spoiler":false,"text":"神官長・神楽坂相模の娘だが養女であり、幼いころは皇国京師の2等市街区でスリをしていたことも。"},{"spoiler":false,"text":"皇国の主神・神炎の豊穣女神 「ホノアカ」のほか、時間操作の「トキジク」、 人の心を読む「サトリ」、あわせて三柱の神と契約している絶大な精神許容量の持ち主。"},{"spoiler":false,"text":"ヒノミヤ神楽坂派の聖域 「奥津城」の神座にあって巫女たちを差配していたが対抗者である神月派神月五十六の軍師・磐座穣の攻撃を受け、奥津城陥落寸前に晦日美咲に導かれて脱出。"},{"spoiler":false,"text":"帝紀1816年6月19日、 釜山の洞窟で新羅辰馬に救われ庇護を受け そのためか辰馬を「ご主人様」と慕う。"},{"spoiler":false,"text":"明るく穏やかで人当たりのいい性格だが、 性欲が非常に強い。"},{"spoiler":false,"text":"作中随一のバスト121センチを誇るが体重も相応に重いのを気にしている。"}],"source":"egs","sourceCharacterId":"26301","sourceWorkId":"36764","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"121 cm","valueContext":null,"source":"egs","sourceCharacterId":"26301","sourceWorkId":"36764","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_egs_26329","characterName":"牢城 雫","sourceIds":{"egsCharacterIds":["26329"]},"originalCharacterName":"牢城 雫","characterNameSource":null,"role":"1","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メインヒロインの一人。"},{"spoiler":false,"text":"主人公辰馬のの8歳年上の幼なじみでありまた、「新羅江南流」の跡取り息子と高弟という関係。冒険者育成校「蒼月館」 の体育教諭、ときどき代打で史学の教鞭もとる。アカツキ皇国最大の貴族 「三大公家」筆頭 「覇城家」の傍系。 母・フィーリアは妖精郷 「聖森アルフハイム」の姫女王であるが 純血主義の覇城家から忌まれて雫の父・訓は奪爵されている。 大貴族の列から落とされたわけだが雫含めて牢城の家族はそのことを気にしておらず、 庶民的に過ごす。"},{"spoiler":false,"text":"剣を取らせては天下一品の腕前、剣聖といわれる。「魔力欠損症」という体質であり、一切の魔法が使えない代わり魔術的干渉もほぼ受けない。"},{"spoiler":false,"text":"誰にでもわけへだてなく、明るく元気な性格だが辰馬の前ではそれが度を超すことが多く暴走しがち。隙あらば辰馬にセクハラしようとする変態。「やははー」という独特な笑い方が特徴。"}],"source":"egs","sourceCharacterId":"26329"},{"segments":[{"spoiler":false,"text":"メインヒロインの一人。"},{"spoiler":false,"text":"アカツキ皇国最大の貴族 「三大公家」筆頭 「覇城家」の傍系。"},{"spoiler":false,"text":"母・フィーリアは妖精郷 「聖森アルフハイム」の姫女王であるが 純血主義の覇城家から忌まれて雫の父・訓は奪爵されている。"},{"spoiler":false,"text":"大貴族の列から落とされたわけだが雫含めて牢城の家族はそのことを気にしておらず、 庶民的に過ごす。"},{"spoiler":false,"text":"主人公・新羅辰馬の8歳年上の幼なじみであり冒険者育成校「蒼月館」 の体育教諭。ときどき代打で史学の教鞭もとる。"},{"spoiler":false,"text":"また学園外では「新羅江南流」の跡取り息子と高弟という関係。"},{"spoiler":false,"text":"誰にでもわけへだてなく、明るく元気な性格だが辰馬の前ではそれが度を超すことが多く暴走しがち。"},{"spoiler":false,"text":"隙あらば辰馬にセクハラしようとする変態。"},{"spoiler":false,"text":"こんなふうだが剣を取らせては天下一品の腕前、剣聖といわれる。"},{"spoiler":false,"text":"「魔力欠損症」という体質であり、一切の魔法が使えない代わり魔術的干渉もほぼ受けない。"},{"spoiler":false,"text":"「やははー」という独特な笑い方が特徴。"}],"source":"egs","sourceCharacterId":"26329","sourceWorkId":"36764","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_egs_26330","characterName":"エーリカ リスティ ヴェスローディア","sourceIds":{"egsCharacterIds":["26330"]},"originalCharacterName":"エーリカ リスティ ヴェスローディア","characterNameSource":null,"role":"1","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アルティミシア大陸西北端の国、 ヴェスローディアの第四王女。"},{"spoiler":false,"text":"父王没後、兄と叔父の政争から身を避けてアカツキに亡命したが、その途上汽車の中で気前よく宝石を切り崩して使っていたら路銀が足りなくなり、汽車から叩きだされる。"},{"spoiler":false,"text":"空腹を抱えてアカツキ京師太宰近郊をさまよっているところを新羅辰馬に救われ、このとき素うどんをおごられたためにエーリカの中で素うどんは嗜好の美味ということになっている。"},{"spoiler":false,"text":"出自確かなお姫さまだが幼少時は城を抜け出して城下の悪ガキどもとチャンバラごっこに明け暮れていたような少女深層の姫君というより道産子のド根性を持つ。"},{"spoiler":false,"text":"内面的には繊細なのだが表面的には図々しく強気、騒々しく怒りっぽく、そのくせ寂しがりのわかりやすいツンデレ。 国元に連絡するわけにもいかず貧乏生活中の赤貧プリンセス 現在グラドルとして売り出し中だがなかなか芽が出ない巨乳自慢だったが降ってわいた瑞穂の爆乳に地位を奪われる。"}],"source":"egs","sourceCharacterId":"26330"},{"segments":[{"spoiler":false,"text":"アルティミシア大陸西北端の国、 ヴェスローディアの第四王女。"},{"spoiler":false,"text":"父王没後、兄と叔父の政争から身を避けてアカツキに亡命したが、その途上汽車の中で気前よく宝石を切り崩して使っていたら路銀が足りなくなり、汽車から叩きだされる。"},{"spoiler":false,"text":"空腹を抱えてアカツキ京師太宰近郊をさまよっているところを新羅辰馬に救われ、このとき素うどんをおごられたためにエーリカの中で素うどんは嗜好の美味ということになっている。"},{"spoiler":false,"text":"出自確かなお姫さまだが幼少時は城を抜け出して城下の悪ガキどもとチャンバラごっこに明け暮れていたような少女深層の姫君というより道産子のド根性を持つ。"},{"spoiler":false,"text":"内面的には繊細なのだが表面的には図々しく強気、騒々しく怒りっぽく、そのくせ寂しがりのわかりやすいツンデレ。 国元に連絡するわけにもいかず貧乏生活中の赤貧プリンセス 現在グラドルとして売り出し中だがなかなか芽が出ない巨乳自慢だったが降ってわいた瑞穂の爆乳に地位を奪われる。"}],"source":"egs","sourceCharacterId":"26330","sourceWorkId":"36764","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_egs_26331","characterName":"ラケシス フィーネ ロザリンド","sourceIds":{"egsCharacterIds":["26331"]},"originalCharacterName":"ラケシス フィーネ ロザリンド","characterNameSource":null,"role":"2","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"サティア編メインヒロインの一人。"},{"spoiler":false,"text":"蒼月館学院2年。「神国」ウェルス法王庁から聖女見習いとして学院に留学しており、学生会副会長も務める。主人公の実母で元聖女アーシェ・ユスティニアの門人として新羅家にも出入りしており、蒼月館入学当初から新羅辰馬とは仲が良い。"},{"spoiler":false,"text":"天才型のひらめきと言ったものはないが努力の天才であり、結果を出すために人一倍の努力をするので、いつのまにかトップに立ててしまっているタイプ。主に神聖魔法の使い手だが、穏やかな性格にもかかわらず回復魔法より攻撃魔法が得意。"},{"spoiler":false,"text":"苛烈な男子排斥を唱える学生会の中にあって、男女間の融和を訴える学生会の良心でもある。明るく優しく裏表がなく家庭的ということで、学園の「お嫁さんにしたい女の子」ランキング1位。本人曰くそんなに家庭的じゃないし裏表もあるということだが 実際人としての汚さが少ないのは確か。"}],"source":"egs","sourceCharacterId":"26331"},{"segments":[{"spoiler":false,"text":"「神国」ウェルス法王庁の聖女見習い。"},{"spoiler":false,"text":"もと聖女アーシェ・ユスティニアの門人として新羅家に出入りしており、蒼月館入学当初から新羅辰馬とは仲が良い。"},{"spoiler":false,"text":"天才型のひらめきと言ったものはないが努力の天才であり、結果を出すために人一倍の努力をするので、いつのまにかトップに立ててしまっているタイプ。"},{"spoiler":false,"text":"蒼月館学院2年。 留学生でありながら学生会副会長。"},{"spoiler":false,"text":"苛烈な男子排斥を唱える学生会の中にあって、男女間の融和を訴える学生会の良心でもある。"},{"spoiler":false,"text":"明るく優しく裏表がなく家庭的ということで、学園の「お嫁さんにしたい女の子」ランキング1位。"},{"spoiler":false,"text":"本人曰くそんなに家庭的じゃないし裏表もある、ということだが 実際人としての汚さが少ないのは確か。"},{"spoiler":false,"text":"当然のように神聖魔法の使い手だが、穏やかな性格にもかかわらず回復魔法より攻撃魔法が得意。"}],"source":"egs","sourceCharacterId":"26331","sourceWorkId":"36764","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_egs_26998","characterName":"サティア","sourceIds":{"egsCharacterIds":["26998"]},"originalCharacterName":"サティア","characterNameSource":null,"role":"2","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とある寒村でなにやら暗躍している女神。"}],"source":"egs","sourceCharacterId":"26998"},{"segments":[{"spoiler":false,"text":"とある寒村でなにやら暗躍している女神。"}],"source":"egs","sourceCharacterId":"26998","sourceWorkId":"36764","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_egs_26999","characterName":"塚原 繭","sourceIds":{"egsCharacterIds":["26999"]},"originalCh