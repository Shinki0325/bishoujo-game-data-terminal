"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の上級生で、豪徳学園の生徒会長を務める。"},{"spoiler":false,"text":"規律に厳しく、曲がったことは許さない。"},{"spoiler":false,"text":"先天的な霊感があり、タマを最初から見る事ができた人。"},{"spoiler":false,"text":"計算高く行動しているだけに、予測不能の事態に陥るとオロオロしてしまうことも。"},{"spoiler":false,"text":"常時、オシオキ用メタルルーラ（金属製30cm定規）を仕込んでおり、風紀を乱す者に天誅を下す。"}],"source":"egs","sourceCharacterId":"25858","sourceWorkId":"7162","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の上級生で、生徒会長。"},{"spoiler":false,"text":"先天的な霊感があり、タマを最初から見ることができる、数少ない人物。"},{"spoiler":false,"text":"戒律に厳しく、曲がったことは許さない。それは相手が幽霊であっても例外ではなく、校内に出入りしている部外者のタマのことを目の仇にしている。"}],"source":"bangumi","sourceCharacterId":"38009"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/492d5399661749c5838506fcaa6fb00fc439367ac0f81989377c2430d6acdc6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e76d2932abfdb63dedbaa7c7810fd3db6ad6bef670626bae62dd240676717e50.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かわの亜衣","creatorId":"vndb:s7742","sourcePersonId":"vndb:s7742","canonicalEntityId":"vndb:s7742","name":"かわの 亜衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152370:38009:20633:1","source":"bangumi"}]},{"characterId":"char_c70970","characterName":"七宮 なずな","sourceIds":{"bangumi":[{"characterId":"38010","match":"exact-normalized-name-in-linked-work","subjectId":"152370"}],"egsCharacterIds":["25859"],"vndbCharacterId":"c70970"},"originalCharacterName":"七宮 なずな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元気が取り柄だが、ちょっと頼りない感じの後輩。"},{"spoiler":false,"text":"最近学園に転校してきた。"},{"spoiler":false,"text":"嘘が下手で正直者。悪い事はできない性格。"},{"spoiler":false,"text":"後ろめたいことでもあるのか、弱気な態度が主人公のイジメ心をくすぐりしょっちゅう遊ばれている。"},{"spoiler":false,"text":"実は主人公の師匠、七宮芹の実妹なのだが、周囲にはバレていない様子。"},{"spoiler":false,"text":"新米除霊師、いろんな意味でチビッ子。"}],"source":"egs","sourceCharacterId":"25859","sourceWorkId":"7162","spoiler":false},{"segments":[{"spoiler":false,"text":"元気が取り柄だがちょっと頼りない感じの後輩。学園に転校してきたばかり。"},{"spoiler":false,"text":"どことなく弱気な態度のせいで主人公に目をつけられ、しょっちゅうからかわれている。"},{"spoiler":false,"text":"新人の除霊師。"}],"source":"bangumi","sourceCharacterId":"38010"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a582dc7131042113a281fe3e7c6ff0ea76a7a3dadc1304c82cbbc1d3959d9621.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c506e139afda8291e4465a2cc55e557f6de5ec3625bbf68cf26f6d98a1abde1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152370:38010:4646:1","source":"bangumi"}]},{"characterId":"char_c70971","characterName":"芹先生","sourceIds":{"bangumi":[{"characterId":"38011","match":"exact-normalized-name-in-linked-work","subjectId":"152370"}],"egsCharacterIds":["25860"],"vndbCharacterId":"c70971"},"originalCharacterName":"芹先生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"表の顔は豪徳学園養護教諭。"},{"spoiler":false,"text":"しかし実態は主人公の師匠にして現代最強といわれる除霊師。"},{"spoiler":false,"text":"絶対的な余裕と自信を備えたオトナの女性。"},{"spoiler":fals