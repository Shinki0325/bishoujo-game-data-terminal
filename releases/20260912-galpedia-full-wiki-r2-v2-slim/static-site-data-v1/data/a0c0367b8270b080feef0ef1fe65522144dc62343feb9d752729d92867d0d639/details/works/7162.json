/v1/characters/v1/images/3c/3c6ebbd1cc297de59946b186bc52b9f822f1cc14e0688e4fa9f42bdf6621502d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c70967","characterName":"タマ","sourceIds":{"bangumi":[{"characterId":"38007","match":"exact-normalized-name-in-linked-work","subjectId":"152370"}],"egsCharacterIds":["25856"],"vndbCharacterId":"c70967"},"originalCharacterName":"タマ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の上に降ってきた幽霊（？）の少女。"},{"spoiler":false,"text":"霊力のこもった野球ボールをぶつけられ、ショックで記憶喪失に。"},{"spoiler":false,"text":"自分の名前も思い出せなくなっている。"},{"spoiler":false,"text":"性格は元気で率直、目立ちたがり屋。"},{"spoiler":false,"text":"思ったことをすぐ口にしてしまい、それが元でトラブルになることも。"}],"source":"egs","sourceCharacterId":"25856","sourceWorkId":"7162","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の上に降ってきた幽霊少女。"},{"spoiler":false,"text":"霊力のこもった野球ボールをぶつけられ、ショックで記憶喪失になっていて、自分が何者かすら思い出せない。"},{"spoiler":false,"text":"自分を認識できる異性が主人公だけであり、触れると癒される主人公の霊能力に興味を持つ。エッチなことにも興味津々？"}],"source":"bangumi","sourceCharacterId":"38007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82c544e3d73954f094acdf6a0da94168d8f2a4584bda7da0931645037cffd976.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b796fcda12a59592a72fc4c6be21934de2decdc52bc89cf208986dd6dbd5380d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水原薫","creatorId":"vndb:s1979","sourcePersonId":"vndb:s1979","canonicalEntityId":"vndb:s1979","name":"水原 薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152370:38007:5763:1","source":"bangumi"}]},{"characterId":"char_c70968","characterName