acterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"運動神経抜群、成績優秀な従姉。"},{"spoiler":false,"text":"ルックス良し、明朗快活な少女だが、家事全般は壊滅的にダメで、その上、意地っ張りな性格からか、逆上すると、手がつけられないほど凶暴化する。"},{"spoiler":false,"text":"ナノが現れて以来、何故か主人公に前に増して突っかかってくるのだが……。"}],"source":"egs","sourceCharacterId":"19420","sourceWorkId":"9712","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の隣の家に住んでいる、同じ年の従兄妹。"},{"spoiler":false,"text":"主人公とは学園でもクラスメイトで、記憶に無いほど昔からの幼馴染。"},{"spoiler":false,"text":"実は昔から主人公の事が好きなのだが、意地っ張りな性格が災いして、上手く告白できずに悩んでいた。"},{"spoiler":false,"text":"成績は良い方で、運動も得意だが家事は苦手。"},{"spoiler":false,"text":"ナノと主人公の関係にショックを受け、突然積極的に告白を繰り返すようになるが、半ば冗談だと思われている。"}],"source":"bangumi","sourceCharacterId":"56195"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"19420","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"19420","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"19420","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"19420","sourceWorkId":"9712","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b1a2db535cb0d8be55bb21ecd3a70cc4beef39fb38a6723951dfe5ac7724e48.webp","fallbackUrl":"https://wiki-a