ceCharacterId":"19419","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"19419","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"19419","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"19419","sourceWorkId":"9712","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b558221468ae6dc5e37e25d8d7e184fbc6ccdebfbf8784b8af911b321b6cd1a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efdf31cec45bdd1caaa2a3d6dbca5b9bbc6caf25906a5e2d5c229401879190a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日 アン","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218185:56194:6480:1","source":"bangumi"}]},{"characterId":"char_c52854","characterName":"習志野 真乃","sourceIds":{"bangumi":[{"characterId":"56196","match":"exact-normalized-name-in-linked-work","subjectId":"218185"}],"egsCharacterIds":["19421"],"vndbCharacterId":"c52854"},"originalCharacterName":"習志野 真乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"茅沙の妹。"},{"spoiler":false,"text":"凶暴な姉（主人公談）とは対照的な性格で、穏やかで家庭的、家事全般をそつなくこなし、主人公の身の周りの世話をも焼いてくれる。"},{"spoiler":false,"text":"茅沙と主人公の過激なやり取りを暖かい目で見守っていることもしばしば。"}],"source":"egs","sourceCharacterId":"19421","sourceWorkId":"9712","spoiler":false},{"segments":[{"spoiler":false,"text":"茅沙の妹。茅沙とは正反対の性格で、穏やかで家庭的。"},{"spoiler":false,"text":"学年は一つ下で、主人公とは実の兄妹のように育った。"},{"spoiler":false,"text":"ほとんど一人暮らしのような生活をしている主人公の元に姉と共に通い、料理や洗濯を一手に引き受けている。"},{"spoiler":false,"text":"姉が和杜を好きな事に気付いており、暖かく見守っている。"}],"source":"bangumi","sourceCharacterId":"56196"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"19421","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"19421","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"19421","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"19421","sourceWorkId":"9712","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d48c10d4e97fc33be0b5d035bcb75efb9e141ee4177a76f9b01f6eaa077c6f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c703828716404e8fcb6c3736bb84999f577ab9fb131f1afb7081e64c32d87f78.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218185:56196:11511:1","source":"bangumi"}]},{"characterId":"char_c52855","characterName":"杵宮 沙羅奈","sourceIds":{"bangumi":[{"characterId":"56197","match":"exact-normalized-name-in-linked-work","subjectId":"218185"}],"egsCharacterIds":["19422"],"vndbCharacterId":"c52855"},"originalCharacterName":"杵宮 沙羅奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学校の先輩で、科学部の部長。"},{"spoiler":false,"text":"その科学知識は相当なもので、教師すら一目置いているほどらしい。"},{"spoiler":false,"text":"だがその分、世間や常識に疎く、一般人には理解されていない様子。"}],"source":"egs","sourceCharacterId":"19422","sourceWorkId":"9712","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公たちの一年先輩で、主人公を含め部員が二人しかいない科学部の部長。"},{"spoiler":false,"text":"常に分厚い本を携帯しており、少々常識外れな部分もあるが、科学に関する知識は驚くほどハイレベルで、教師たちにも一目置かれている。"},{"spoiler":false,"text":"反面、人付き合いのようなものは苦手で、人前では自然と口数が減ってしまう為、周囲から冷たい性格だと誤解され易い。その為、多くを語らなくても意思を感じ取ってくれる主人公の事を、数少ない大切な友人だと思っている。"}],"source":"bangumi","sourceCharacterId":"56197"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"19422","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"19422","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"19422","sourceWorkId":"9712","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"19422","sourceWorkId":"9712","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc67d226502f4e4664f91363a6481af620848df095ae694780c1db51d6a23d9f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01491a1fddb12b24a7977e2a5cdfc1710dc63b23e51eb70710d429afa687b34b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218185:56197:6351:1","source":"bangumi"}]},{"characterId":"char_c52856","characterName":"シェリィ","sourceIds":{"bangumi":[{"characterId":"56198","match":"exact-normalized-name-in-linked-work","subjectId":"218185"}],"egsCharacterIds":["19423"],"vndbCharacterId":"c52856"},"originalCharacterName":"シェリィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ナノの姉妹を自称する人物で、同じ異次元ジャンプの体質を持つ。"},{"spoiler":false,"text":"男を気嫌いしており、ナノと仲良くしている主人公は、許しがたい存在らしい。"},{"spoiler":false,"text":"好みの女の子を見ると抱きついたり、よくセクハラしたりしているが……？"}],"source":"egs","sourceCharacterId":"19423","sourceWorkId":"9712","spoiler":false},{"segments":[{"spoiler":false,"text":"ナノの実の妹。"},{"spoiler":false,"text":"ナノと同じ体質を持ち、以前は二人で共に様々な世界を渡り歩いていたが、何年も前から離れ離れになっていた。"},{"spoiler":false,"text":"本質的に女の子が好きで、男が大嫌い。その為、再会した姉にベタベタしている主人公を目の仇にする。"},{"spoiler":false,"text":"異次元の生物、ムルムルとの共存関係にあり、そのおかげで、比較的自由に一定の空間に留まる事ができる。"},{"spoiler":false,"text":"その為か、一つ一つの世界に対する執着がナノに比べて薄く、この世界に順応しようという意識も、とても希薄である。"}],"source":"bangumi","sourceCharacterId":"56198"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ca22311e2a145d2dc4610f183c379876645acc766c225f9eb6321cd59f128d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/ima