ers/v1/images/5e/5e6c4ab5584237308d7be58fff5c844d93d00f82f0cc1e1f3bfd285d65d31a6d.webp","width":210,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_10802","characterName":"虎丸星","sourceIds":{"bangumi":[{"characterId":"10802","match":"source-roster","subjectId":"1395"},{"characterId":"10802","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"虎丸星","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"BGM：虎柄の毘沙門天。"}],"source":"bangumi","sourceCharacterId":"10802"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"10802","value":"妖怪"},{"label":"能力","source":"bangumi","sourceCharacterId":"10802","value":"收集财宝程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76245386bf7722300b81e21072d68da2872804f6a6887aa3653dc41e78250973.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46e42eebd647e60bff5c1e711a24807714cb0daf6dd5f60eecc611afe4777c0e.webp","width":153,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_10805","characterName":"被封印的大魔法使","sourceIds":{"bangumi":[{"characterId":"10805","match":"source-roster","subjectId":"1395"},{"characterId":"10805","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"被封印的大魔法使","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大人气同人系列游戏《东方project》的主要角色。首次出现在《东方星莲船》。 白莲在命莲死后，对人生苦短感到恐惧，想要求得永生长存。可惜通过佛力无法达成，白莲转而学习魔法与妖术保持青春。在与妖怪的接触中，她意识到妖力不强大是无法生存的，并且视为至理，逐渐在这条道上越走越深。一方面，她接受退治妖怪，另一方面又帮助妖怪，这就是她所认为的平衡。最终她的作为无法被人类接受，被封印到了魔界——与星莲船同音的圣辇船航向的目的地。"}],"source":"bangumi","sourceCharacterId":"10805"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"10805","value":"魔法师"},{"label":"能力","source":"bangumi","sourceCharacterId":"10805","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b01c998a106aaa224f7364e915e7fd3e812db9fe477fb868e482f3d4adaa8762.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/737defe3a5c9809789d6f0246c5f898ad1bc13a6a51f49e2e8b4cf6e891ba628.webp","width":179,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21128","characterName":"愉快的遗忘之伞","sourceIds":{"bangumi":[{"characterId":"21128","match":"source-roster","subjectId":"12696"},{"characterId":"21128","match":"source-roster","subjectId":"1395"},{"characterId":"21128","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"愉快的遗忘之伞","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二面中头目及头目，由长年不被使用的伞化成的妖怪，对于经常吓不了人类而感到自卑。"},{"spoiler":false,"text":"虽然在关卡的名字是代表着独眼妖怪，不过主要也是指她手上的伞罢了，但本体不是那把伞。瞳孔的颜色一边为蓝，一边为红。"},{"spoiler":false,"text":"神灵庙又再次出现，与火焰猫磷并列为出现次数最多的头目（四次）。"},{"spoiler":false,"text":"吓到人会摆出一副很满足的表情，无视她的话会变得很郁卒。不会害人的妖怪，所以不需要担心。"},{"spoiler":false,"text":"如果可怜可怜她，还是装一下吓到的表情哄她开心吧。"},{"spoiler":false,"text":"人之里中很受小孩子欢迎。"}],"source":"bangumi","sourceCharacterId":"21128"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21128","value":"附丧神（唐伞妖怪）"},{"label":"能力","source":"bangumi","sourceCharacterId":"21128","value":"惊吓人类程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e346d665b3915d9a2fe30f61eadb4e647e0a7b81d0171adb8761c208310fa165.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b85e398e9e9a77bb2864b0c02aa82222489679dd5526a0303a01681c48b5b46.webp","width":207,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21130","characterName":"守护与被守护的大轮","sourceIds":{"bangumi":[{"characterId":"21130","match":"source-roster","subjectId":"1395"},{"characterId":"21130","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"守护与被守护的大轮","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三面中头目及头目，外表是一个拿着圆环的少女，和入道为同伴关系，这对组合就是云居。"},{"spoiler":false,"text":"表面上只是单纯地守卫著宝船。实际上，这对组合是为了诱使得到飞船的碎片的灵梦等人进入宝船，从而令宝船能够前往魔界。"},{"spoiler":false,"text":"本来与村纱等人被封印在地底，因为温泉异变又回到地面，并帮助白莲解除魔界封印。"},{"spoiler":false,"text":"原本是人类，因为和云山待久了而成为妖怪，因此有一说她是魔法使（但却没听过“入道使”）。"},{"spoiler":false,"text":"会趁白莲不注意时偷喝酒。（佛教徒称酒作“般若汤”）"}],"source":"bangumi","sourceCharacterId":"21130"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21130","value":"妖怪"},{"label":"能力","source":"bangumi","sourceCharacterId":"21130","value":"使用入道的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3ee92a056f0c054ad6cebdd0d57d56784a7acf4964160885ac105161de7105f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d243c11a1207aa45807cd7c836f9c4e0b686fead0af1447a80560dc669826ff5.webp","width":161,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21144","characterName":"水难事故的念缚灵","sourceIds":{"bangumi":[{"characterId":"21144","match":"source-roster","subjectId":"1395"},{"characterId":"21144","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"水难事故的念缚灵","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"四面头目，圣辇船船长。手上的勺子是自备的，用来灌水和攻击。"},{"spoiler":false,"text":"她原是很久以前在海难事故中死了的人的灵魂化成的念缚灵。"},{"spoiler":false,"text":"水蜜是原名，而村纱是代表该海域引发水难事故的妖怪，在水蜜遭遇水难成为念缚灵后，因其怨念过深，所以水蜜取代了其地位，成为现今的村纱水蜜。"},{"spoiler":false,"text":"过去的她常常引发许多水难事故，愈来愈多人死于他所引她的水难，她的力量便随之增长。"},{"spoiler":false,"text":"最后当地人委托白莲来治退这麻烦的妖怪。但身为妖怪的白莲当然不可能消灭掉她。"},{"spoiler":false,"text":"要致退妖怪最佳的方法就是精神攻击，白莲对村沙下了“令”，这个令就是圣辇船，村沙最后被白莲感化，而使她能够离开该海域。"},{"spoiler":false,"text":"因为地底温泉异变而使圣辇船和飞仓解除封印。村沙因此回到地面。"},{"spoiler":false,"text":"听到寅丸说白莲解封有望，为了报恩而引导灵梦等人解开白莲的封印。"},{"spoiler":false,"text":"现在虽然是命莲寺的僧侣，但她还是会杀人（在幻想乡引发水难），和以前的差别是现在还会挑选对象。"},{"spoiler":false,"text":"据说还会趁死神不注意（就是偷懒），在三途川的船上灌水。"}],"source":"bangumi","sourceCharacterId":"21144"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21144","value":"舟幽霊"},{"label":"能力","source":"bangumi","sourceCharacterId":"21144","value":"引起水难事故的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e7427c10a93e44d26274fba7e6fca3bc73b4b1061409fc678b533915e5d9568.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8504165d50808b807ed1a70234076d65cdd0949766e34f5ff5446cb1d3d25e41.webp","width":119,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_30129","characterName":"Unzan","sourceIds":{"bangumi":[{"characterId":"30129","match":"source-roster","subjectId":"1151"},{"characterId":"30129","match":"source-roster","subjectId":"1395"}]},"originalCharacterName":"Unzan","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"30129","value":"入道"},{"label":"能力","source":"bangumi","sourceCharacterId":"30129","value":"能够自由地变换形状和大小的能力"}],"metada