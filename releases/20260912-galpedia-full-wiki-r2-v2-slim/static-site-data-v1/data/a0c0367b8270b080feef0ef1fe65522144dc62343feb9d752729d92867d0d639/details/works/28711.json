{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"28711","model":{"presentationWorkId":"egs:28711","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_18546","characterName":"あすか","sourceIds":{"bangumi":[{"characterId":"18546","match":"source-roster","subjectId":"108440"},{"characterId":"18546","match":"source-roster","subjectId":"15927"},{"characterId":"18546","match":"source-roster","subjectId":"194888"},{"characterId":"18546","match":"source-roster","subjectId":"221228"},{"characterId":"18546","match":"source-roster","subjectId":"223001"},{"characterId":"18546","match":"source-roster","subjectId":"288017"},{"characterId":"18546","match":"source-roster","subjectId":"48002"},{"characterId":"18546","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"あすか","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0908"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"90"},"height":{"reviewState":"source-only","source":"bangumi","value":"155"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも元気いっぱいで、どんなことにも一生懸命。忍の道とは何か、本人なりに一生懸命に考えている。忍としての実力はまだまだだが、偉大な忍を祖父「半蔵」に持っており、潜在能力は抜群。好きな物はじっちゃん（半蔵）の太巻き。趣味は修行。秘伝忍法はガマ。属性は土。長短2本の脇差を振るう戦闘をする二刀流での斬撃が中心の戦闘スタイル。"}],"source":"bangumi","sourceCharacterId":"18546"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18546","value":"修行"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18546","value":"爷爷的太卷寿司"}],"metadataCandidat