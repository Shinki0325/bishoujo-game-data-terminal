。好きな物は懐石料理と日本茶だが、創作料理の見た目は微妙とのこと。趣味は読書。秘伝忍法は火の鳥。属性は火。"}],"source":"bangumi","sourceCharacterId":"18548"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18548","value":"读书"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18548","value":"怀石料理/日本茶"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8829795d821c1b2a30c0595101a3ffabb3dcc5911b229c9d2e196febe5d569b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b9fc25fd15d641f1bff9e34e7c19e20bc50a71748aef227811b8dda698ca254.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今井麻美","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:288017:18548:4061:1","source":"bangumi"}]},{"characterId":"char_bangumi_18554","characterName":"ほむら","sourceIds":{"bangumi":[{"characterId":"18554","match":"source-roster","subjectId":"108440"},{"characterId":"18554","match":"source-roster","subjectId":"15927"},{"characterId":"18554","match":"source-roster","subjectId":"194888"},{"characterId":"18554","match":"source-roster","subjectId":"223001"},{"characterId":"18554","match":"source-roster","subjectId":"288017"},{"characterId":"18554","match":"source-roster","subjectId":"48002"},{"characterId":"18554","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"ほむら","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0103"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"87"},"height":{"reviewState":"source-only","source":"bangumi","value":"163"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"2年生でありながら生徒会代表を務める。蛇女選抜メンバーでもその実力は随一で実質のリーダー格。最強の忍となることを目指しており、そのためなら手段は選ばないないが、仲間に情が厚く、敵に厳しいが、敵であっても強い者を認める。言葉使いが男性っぽいが、礼儀作法はしっかりと身につけており、意外と女の子らしい一面もある。根が真面目で融通がきかないところもあるため、たまに暴走して空回りしてしまい他のメンバーからあきれられることも。飛鳥とは縁があり、互いを高め合うライバルとなる。趣味は戦いで、好きな食べ物は和食。六刀を振るう剣技の他に、最終決戦ではもう一本の太刀を使う一刀流の技を使う。太刀を使用している状態では「紅蓮の焔」と表記されており、蛇女編では一定条件を満たした後に使用可能になる。"}],"source":"bangumi","sourceCharacterId":"18554"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18554","value":"战斗"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18554","value":"日式食物、肉"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66d0997711ce7e792e0f2c78a2d6fa9ffdc08488686d057472920066cf377b25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f02bcf5bcfca67126eae1323c0e263aaba1b7a272df605c0d420ad6f3671a434.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:288017:18554:4251:1","source":"bangumi"}]},{"characterId":"char_bangumi_18555","characterName":"よみ","sourceIds":{"bangumi":[{"characterId":"18555","match":"source-roster","subjectId":"108440"},{"characterId":"18555","match":"source-roster","subjectId":"15927"},{"characterId":"18555","match":"source-roster","subjectId":"194888"},{"characterId":"18555","match":"source-roster","subjectId":"221228"},{"characterId":"18555","match":"source-roster","subjectId":"223001"},{"characterId":"18555","match":"source-roster","subjectId":"288017"},{"characterId":"18555","match":"source-roster","subjectId":"48002"},{"characterId":"18555","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"よみ","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0210"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"95"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"hip":{"reviewState":"source-only","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お嬢様口調で、見た目は穏やかだが内面は憎悪が渦巻く激烈な性格。服装や見た目、喋り方はお嬢様っぽいが、実態は食べるものにも困る日々を送っていたが、本人はそれにめげずに明るく強くたくましく生きている。趣味は裁縫。好きな食べ物はもやし。重火器と大剣による距離を問わないコンビネーション攻撃に加え爆弾を使う。"}],"source":"bangumi","sourceCharacterId":"18555"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18555","value":"裁缝"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18555","value":"豆芽菜"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c3b57aa84d4eb248a49e278b7e8985015056e771a9f09e00d8cf46edc3fb9ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36bff7201024e5cbe98060bba88a3f66473892bbe80267b1c54af57ea6e0f654.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅野愛衣","creatorId":"vndb:s630","sourcePersonId":"vndb:s630","canonicalEntityId":"vndb:s630","name":"茅野 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:288017:18555:5847:1","source":"bangumi"}]},{"characterId":"char_bangumi_18556","characterName":"ひかげ","sourceIds":{"bangumi":[{"characterId":"18556","match":"source-roster","subjectId":"108440"},{"characterId":"18556","match":"source-roster","subjectId":"15927"},{"characterId":"18556","match":"source-roster","subjectId":"194888"},{"characterId":"18556","match":"source-roster","subjectId":"223001"},{"characterId":"18556","match":"source-roster","subjectId":"288017"},{"characterId":"18556","match":"source-roster","subjectId":"48002"},{"characterId":"18556","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"ひかげ","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0909"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"85"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"実力はあるが「感情がない」と自称する無表情で口数も少なく、何を考えているのかよくわからない無気力な少女。葛城からの挑戦に気乗りせず、受け流している。手足に暗器を仕込み、柔軟な体と合わせた変幻自在の体術を使う。一定以上の痛みを受けると極度の興奮状態、狂乱モードになる。クールに戦うその姿はまるで戦闘マシーン。"}],"source":"bangumi","sourceCharacterId":"18556"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18556","value":"无"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18556","value":"无"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f8de0dd709ef7bee88e514ff8ecdeee96c20c88834270f23b4c4861d6aaf1bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57403e245834aaf352b304f011953e28b8273660e30f0adad9a9adfb632149c0.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白石涼子","creatorId":"vndb:s953","sourcePersonId":"vndb:s953","canonicalEntityId":"vndb:s953","name":"白石涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:288017:18556:4730:1","source":"bangumi"}]},{"characterId":"char_bangumi_18557","characterName":"みらい","sourceIds":{"bangumi":[{"characterId":"18557","match":"source-roster","subjectId":"108440"},{"characterId":"18557","match":"source-roster","subjectId":"15927"},{"characterId":"18557","match":"source-roster","subjectId":"194888"},{"characterId":"18557","match":"source-roster","subjectId":"223001"},{"characterId":"18557","match":"source-roster","subjectId":"288017"},{"characterId":"18557","match":"source-roster","subjectId":"48002"},{"characterId":"18557","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"みらい","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1228"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"62"},"height":{"reviewState":"source-only","source":"bangumi","value":"150"},"hip":{"reviewState":"source-only","source":"bangumi","value":"59"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大人ぶってひねたところを見せるが、 見た目通り幼く、子供っぽさがなかなか抜けない素直な子供。無視されるのが人一倍嫌い。個性的な先輩たちに囲まれて苦労するところもあるようだが、蛇女の居心地はよい模様。趣味はインターネット。好きな食べ物は鍋物。銃を仕込んだ西洋傘と呪術を駆使した戦闘スタイルを使う。本来は善忍の家系だが、幼少期のいじめが原因で蛇女の門をたたくことになった。そのため、人から無視されるのが一番嫌いで、最初に戦った柳生の反応が気に入らずつけ回している。蛇女入学の理由はかつて自分をいじめていた連中へ仕返しするための実力を付けるためである。 蛇女序盤から中盤にかけては彼女を中心にしたストーリー展開が多い。"}],"source":"bangumi","sourceCharacterId":"18557"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18557","value":"英特网"},{"label":"喜欢的食物","source":"bangumi","sour