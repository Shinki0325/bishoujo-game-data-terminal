us":"source-native","relationId":"vndb:vn-staff:53528","source":"vndb"}]},"cast":[{"characterId":"char_c1053","characterName":"七瀬 恋","sourceIds":{"bangumi":[{"characterId":"21410","match":"exact-normalized-name-in-linked-work","subjectId":"33105"},{"characterId":"21410","match":"exact-normalized-name-in-linked-work","subjectId":"77563"},{"characterId":"21410","match":"exact-normalized-name-in-linked-work","subjectId":"77564"}],"egsCharacterIds":["10280"],"vndbCharacterId":"c1053"},"originalCharacterName":"七瀬 恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"159cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"45kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Works at the gynecology clinic. She is cheerful and kind, a true angel in a white coat. Her boyfriend is hospitalized at the same hospital. She has no interest in men other than her boyfriend."},{"spoiler":false,"text":"Translated from the official game's website, archived"}],"source":"vndb","sourceCharacterId":"c1053"},{"segments":[{"spoiler":false,"text":"主人公の憧れの女性。"},{"spoiler":false,"text":"「聖ユリアンナ病院」の事件以来四年間姿を消していたが、璃瑠に手引きされ、「聖カトレア総合病院」のナース主任として復職する。"},{"spoiler":false,"text":"昔と変わらず、清楚、可憐で誰にでも優しい笑顔をふりまく、ナースの鏡のような女性だが……。"}],"source":"egs","sourceCharacterId":"10280","sourceWorkId":"3235","spoiler":false},{"segments":[{"spoiler":false,"text":"医科大付属・聖カデンツァ看護学校に通う看護生。"},{"spoiler":false,"text":"『夜勤病棟』の頃と変わらず、清楚さと可憐さを持ち合わせる美少女。"},{"spoiler":false,"text":"若さ故か、未熟さ故か、まだ頼りなく、ややおっちょこちょいなところも。"},{"spoiler":false,"text":"校内では、その美貌と、誰にでも優しく接する穏やかな性格から、他の学生の憧れの存在になっている。"}],"source":"egs","sourceCharacterId":"10280","sourceWorkId":"5020","spoiler":false},{"segments":[{"spoiler":false,"text":"舞台となる「聖ユリアンナ病院」の婦人科に勤めるナース。22歳。"},{"spoiler":false,"text":"明るく誰にでも優しい性格で、まさに白衣の天使。"},{"spoiler":false,"text":"病院内に入院中の彼氏がおり、彼氏以外の男性に興味が無いらしい。"}],"source":"egs","sourceCharacterId":"10280","sourceWorkId":"11110","spoiler":false},{"segments":[{"spoiler":false,"text":"学園三年生。主人公のクラスメイト。"},{"spoiler":false,"text":"急に転入してきた主人公の初恋の女の子。"},{"spoiler":false,"text":"男の理想像的な女性で、明るく誰にでも優しい性格。"},{"spoiler":false,"text":"主人公に想いを寄せている。"},{"spoiler":false,"text":"両親は離婚していて、父と暮らしている。"}],"source":"egs","sourceCharacterId":"10280","sourceWorkId":"12783","spoiler":false},{"segments":[{"spoiler":false,"text":"比良坂のターゲットとなった特別病棟勤務候補の看護師の一人。"},{"spoiler":false,"text":"長い間、理想の獲物に恵まれなかった比良坂の前に現れた、最高の実験素材。"},{"spoiler":false,"text":"清楚可憐で、優しく献身的に患者に尽くす姿勢は、まさに白衣の天使といった様相。"},{"spoiler":false,"text":"初対面の比良坂を避けることもせず、誠心誠意をもって対応する真の人格者だがその裏表のない清廉潔白な性格が、自身を追い込んでいることに当の本人は気がついていない。"}],"source":"egs","sourceCharacterId":"10280","sourceWorkId":"15241","spoiler":false},{"segments":[{"spoiler":false,"text":"「七瀬恋」"},{"spoiler":false,"text":"医科大付属・聖カデンツァ看護学校に通う看護生。"},{"spoiler":false,"text":"『夜勤病棟』の頃と変わらず、清楚さと可憐さを持ち合わせる美少女。"},{"spoiler":false,"text":"若さ故か、未熟さ故か、まだ頼りなく、ややおっちょこちょいなところも。"},{"spoiler":false,"text":"校内では、その美貌と、誰にでも優しく接する穏やかな性格から、他の学生の憧れの存在になっている。"}],"source":"egs","sourceCharacterId":"10280","sourceWorkId":"28990","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく誰にでも優しい。"},{"spoiler":false,"text":"彼氏以外の男性には興味無いはずだったが………"}],"source":"bangumi","sourceCharacterId":"21410"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"10280","sourceWorkId":"5020","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"1