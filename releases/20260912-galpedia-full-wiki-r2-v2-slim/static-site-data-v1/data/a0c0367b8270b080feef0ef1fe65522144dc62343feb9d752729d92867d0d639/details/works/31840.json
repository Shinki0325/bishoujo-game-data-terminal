:s4523","sourcePersonId":"vndb:s4523","canonicalEntityId":"vndb:s4523","name":"永原 さくら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179205","source":"vndb"},{"creditedName":"アラガー","creatorId":"vndb:s4578","sourcePersonId":"vndb:s4578","canonicalEntityId":"vndb:s4578","name":"アラガー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179207","source":"vndb"},{"creditedName":"Mju:z","creatorId":"vndb:s5438","sourcePersonId":"vndb:s5438","canonicalEntityId":"vndb:s5438","name":"Mju:z","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179208","source":"vndb"},{"creditedName":"ス★シ","creatorId":"vndb:s4933","sourcePersonId":"vndb:s4933","canonicalEntityId":"vndb:s4933","name":"伊芸","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:179210","source":"vndb"}]},"cast":[{"characterId":"char_c101086","characterName":"Yùchú Liàn","sourceIds":{"bangumi":[{"characterId":"102631","match":"exact-normalized-name-in-linked-work","subjectId":"357038"}],"egsCharacterIds":["23848"],"vndbCharacterId":"c101086"},"originalCharacterName":"Yùchú Liàn","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Because if it's you... when I die, you'll completely forget all about me, won't you.\""},{"spoiler":false,"text":"A second-year student who transferred into Morinomiya Academy."},{"spoiler":false,"text":"Having originally worked in the entertainment industry as a child actor, she stands out incredibly well thanks to her extraordinary beauty and crisp, cheerful personality."},{"spoiler":false,"text":"She used to attend a different, ordinary school, but transferred in after her \"Gift\" suddenly awakened one day."},{"spoiler":false,"text":"Due to the effects of the \"Gift\" she possesses, she is firmly convinced that she will \"die in the not-too-distant future.\" Furthermore, she does not hide this fact and openly reveals it to those around her."},{"spoiler":false,"text":"In order to leave no regrets in her short remaining life, and to fully sing the praises of her fleeting youth, she asks the protagonist out, pleading, \"Please be my lover.\""},{"spoiler":false,"text":"Hiding her wounds behind a smile... what will this girl, who is destined to lose everything, find in this place?"},{"spoiler":false,"text":"Translated from Official Website."}],"source":"vndb","sourceCharacterId":"c101086"},{"segments":[{"spoiler":false,"text":"杜ノ宮学園に編入してきた二年生。"},{"spoiler":false,"text":"元々子役から芸能活動をしていて、並外れた美貌でハキハキした明るい性格もあってとにかく目立つ。"},{"spoiler":false,"text":"以前は別の普通の学園に通っていたが、ある日『ギフト』が覚醒し編入してくることになった。"},{"spoiler":false,"text":"彼女自信が持つその『ギフト』の影響により、「そう遠くないうちに自分は死んでしまう」と確信している。また、それを隠すこともなく周りに明かしている。"},{"spoiler":false,"text":"残り少ない人生に悔いを残さないため、わずかな青春を謳歌するため、主人公に「私の恋人になって」とお付き合いをおねだりする。"},{"spoiler":false,"text":"笑顔の奥に傷を隠した……全てを失う少女は、この地で何を見つけるのだろうか。"}],"source":"egs","sourceCharacterId":"23848","sourceWorkId":"31840","spoiler":false},{"segments":[{"spoiler":false,"text":"杜ノ宮学園に編入してきた二年生。"},{"spoiler":false,"text":"元々子役から芸能活動をしていて、"},{"spoiler":false,"text":"並外れた美貌でハキハキした明るい性格もあってとにかく目立つ。"},{"spoiler":false,"text":"以前は別の普通の学園に通っていたが、"},{"spoiler":false,"text":"ある日『ギフト』が覚醒し編入してくることになった。"},{"spoiler":false,"text":"彼女自信が持つその『ギフト』の影響により、"},{"spoiler":false,"text":"「そう遠くないうちに自分は死んでしまう」と確信している。"},{"spoiler":false,"text":"また、それを隠すこともなく周りに明かしている。"},{"spoiler":false,"text":"残り少ない人生に悔いを残さないため、わずかな青春を謳歌するため、"},{"spoiler":false,"text":"主人公に「私の恋人になって」とお付き合いをおねだりする。"},{"spoiler":false,"text":"笑顔の奥に傷を隠した……全てを失う少女は、この地で何を見つけるのだろうか。"}],"source":"bangumi","sourceCharacterId":"102631"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b23bc3d40c0ffbc68974b3208c088f38020411818dde5fe0e98119357086b76d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8f172a177bd8a3737a51a3703f278851fec7f407a4f988f31d8996704dcf588.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西連寺亜希","creatorId":"vndb:s14876","sourcePersonId":"vndb:s14876","canonicalEntityId":"vndb:s14876","name":"西連寺 亜希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:357038:102631:36177:1","source":"bangumi"}]},{"characterId":"char_c101087","characterName":"りな","sourceIds":{"bangumi":[{"characterId":"102632","match":"exact-normalized-name-in-linked-work","subjectId":"357038"}],"egsCharacterIds":["23849"],"vndbCharacterId":"c101087"},"originalCharacterName":"りな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の周りをいつもちょろちょろしている、無感情で猫な女の子。"},{"spoiler":false,"text":"神出鬼没で、主人公の部屋にふらっと現れてはベッドに潜り込んだり、備蓄を食い荒らしたりする。挙動も猫だし、頭にも猫の三角耳が生えている。"},{"spoiler":false,"text":"極めつけに彼女の姿はなぜか主人公にしか見えていない。他の人間にはそこにいることを一切認識することをできない。りなが言葉を発しても主人公以外に届くことは無いし、触れたとしてもぼんやりとした感触でしか伝わることはない。"},{"spoiler":false,"text":"なぜ彼女がそんな状況に陥っているのか、なぜ猫耳が生えているのか、りな自身もその理由は一切わからない。"},{"spoiler":false,"text":"必然的に唯一自分を認識している主人公に懐いていて、「いちばんのともだち」と言っている。何らかの『ギフト』は宿していると思われるが、本人が語ることはない。"}],"source":"egs","sourceCharacterId":"23849","sourceWorkId":"31840","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の周りをいつもちょろちょろしている、無感情で猫な女の子。"},{"spoiler":false,"text":"神出鬼没で、主人公の部屋にふらっと現れてはベッドに潜り込んだり、"},{"spoiler":false,"text":"備蓄を食い荒らしたりする。"},{"spoiler":false,"text":"挙動も猫だし、頭にも猫の三角耳が生えている。"},{"spoiler":false,"text":"極めつけに彼女の姿はなぜか主人公にしか見えていない。"},{"spoiler":false,"text":"他の人間にはそこにいることを一切認識することをできない。"},{"spoiler":false,"text":"りなが言葉を発しても主人公以外に届くことは無いし、"},{"spoiler":false,"text":"触れたとしてもぼんやりとした感触でしか伝わることはない。"},{"spoiler":false,"text":"なぜ彼女がそんな状況に陥っているのか、"},{"spoiler":false,"text":"なぜ猫耳が生えているのか、りな自身もその理由は一切わからない。"},{"spoiler":false,"text":"必然的に唯一自分を認識している主人公に懐いていて、"},{"spoiler":false,"text":"「いちばんのともだち」と言っている。"},{"spoiler":false,"text":"何らかの『ギフト』は宿していると思われるが、本人が語ることはない。"}],"source":"bangumi","sourceCharacterId":"102632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5ce915e0429c64c912ad9852dc7ea30263877a6e9b306187a84aa2d5293d96b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d8fb7cff4e2b900dc96263956557554991ab51e32a6f37683d9bc4ee041ef30.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福圓美里","creatorId":"vndb:s362","sourcePersonId":"vndb:s362","canonicalEntityId":"vndb:s362","name":"福圓 美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:357038:102632:4372:1","source":"bangumi"}]},{"characterId":"char_c101088","characterName":"シャロ","sourceIds":{"bangumi":[{"characterId":"102633","match":"exact-normalized-name-in-linked-work","subjectId":"357038"}],"egsCharacterIds":["23850"],"vndbCharacterId":"c101088"},"originalCharacterName":"シャロ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小悪魔なところが魅力（自称）の杜ノ宮学園に通う一年生。"},{"spoiler":false,"text":"彼女もこの春からの編入生だが、立場と事情は主人公達と少々異なる。"},{"spoiler":false,"text":"彼女は『ギフト』能力を保持する中でもさらに選ばれた者だけが身を置く、世界的な組織『葬者連盟』に属している。"},{"spoiler":false,"text":"『葬者連盟』の活動は非常に多岐に渡るが、その中の主なひとつとして「神の定めの輪から逸れた迷える魂を救済する務め」がある。生と死を司る存在……いわば信仰の象徴としてこの世界に根付く組織において、彼女はまさに世界を股にかけて活躍してきた超絶エリート。"},{"spoiler":false,"text":"現在は一時的な能力の不調（自称）で調整のためにこの杜ノ宮学園にやってきた。その辺りの事情を