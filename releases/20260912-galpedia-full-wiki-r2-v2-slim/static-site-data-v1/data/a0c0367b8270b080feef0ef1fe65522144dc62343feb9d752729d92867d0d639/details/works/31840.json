tus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"杜ノ宮学園に通う三年生。ちっこいしあれこれ幼いけれど最上級生である。"},{"spoiler":false,"text":"見た目を裏切らず中身も子供で、拗ねたり甘えたり忙しい。特に寂しがり屋で仲間外れが嫌いなところは注意が必要。"},{"spoiler":false,"text":"かつて欧州を中心に勢力を築き、しかし今は衰勢に向かう『ヴァリニャーノ神言教』の教主。若い身でありながらそれを可能にしたのは、彼女に与えられたおそらくは世界最高の『ギフト』……『神言』。"},{"spoiler":false,"text":"『この力は「神に呼びかけることで神の力を借り受ける」というもの。あらゆることを可能とする権限を与えられた、いわば奇跡の代行者である。……その都度、神に交換条件として示される『何か』を代償として捧げることを引き換えとして。"},{"spoiler":false,"text":"彼女はなぜこのサナトリウムにいるのか？『ヴァリニャーノ神言教』復活を叫ぶ彼女の秘めた過去を主人公はまだ知らない。"}],"source":"egs","sourceCharacterId":"23851","sourceWorkId":"31840","spoiler":false},{"segments":[{"spoiler":false,"text":"杜ノ宮学園に通う三年生。ちっこいしあれこれ幼いけれど最上級生である。"},{"spoiler":false,"text":"見た目を裏切らず中身も子供で、拗ねたり甘えたり忙しい。"},{"spoiler":false,"text":"特に寂しがり屋で仲間外れが嫌いなところは注意が必要。"},{"spoiler":false,"text":"かつて欧州を中心に勢力を築き、"},{"spoiler":false,"text":"しかし今は衰勢に向かう『ヴァリニャーノ神言教』の教主。"},{"spoiler":false,"text":"若い身でありながらそれを可能にしたのは、"},{"spoiler":false,"text":"彼女に与えられたおそらくは世界最高の『ギフト』……『神言』。"},{"spoiler":false,"text":"『この力は「神に呼びかけることで神の力を借り受ける」というもの。"},{"spoiler":false,"text":"あらゆることを可能とする権限を与えられた、いわば奇跡の代行者である。"},{"spoiler":false,"text":"……その都度、神に交換条件として示される『何か』を"},{"spoiler":false,"text":"代償として捧げることを引き換えとして。"},{"spoiler":false,"text":"彼女はなぜこのサナトリウムにいるのか？"},{"spoiler":false,"text":"『ヴァリニャーノ神言教』復活を叫ぶ彼女の秘めた過去を主人公はまだ知らない。"}],"source":"bangumi","sourceCharacterId":"102634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7126f20474b17c81a2b71e57c2ffa6c0c8d034e85005ac617bf4b8e7e88e2a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd9e5a92ba11f41b240b3d63fea7b1bc6592289dcf2f82639b41ebdb68e9d41e.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:357038:102634:32998:1","source":"bangumi"}]},{"characterId":"char_c101090","characterName":"小早川 祈","sourceIds":{"bangumi":[{"characterId":"102635","match":"exact-normalized-name-in-linked-work","subjectId":"357038"}],"egsCharacterIds":["23852"],"vndbCharacterId":"c101090"},"originalCharacterName":"小早川 祈","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"この春、物語の舞台となる杜ノ宮学園に編入してきた二年生。"},{"spoiler":false,"text":"彼に発現した『ギフト』は「自らが決めたたったひとつのことを除いて、新しい記憶を持ち越せない」というもの。彼の記憶は学園に来る以前の段階で停滞しているため、毎朝、枕元の日記で確認しないとここがどこかも思い出せない。"},{"spoiler":false,"text":"『ギフト』は意志で行使する異能力という見方が一般的なので、彼のこの体質が『ギフト』と呼べるかは担当医も首を傾げている。"},{"spoiler":false,"text":"なかなかタフな状況ではあるものの、前向きに学園生活に取り組む意志はある。「今を楽しめれば今日に価値が出る」「昨日の俺に勝つ」というところ。若干、自分に言い聞かせている節は否めないが……。"},{"spoiler":false,"text":"学園は生徒がなんらかの部活に入ることを奨励しているので、部活は放送部に所属している。なお、放送部に入った動機は覚えていない。"}],"source":"egs","sourceCharacterId":"23852","sourceWorkId":"31840","spoiler":false},{"segments":[{"spoiler":false,"text":"この春、物語の舞台となる杜ノ宮学園に編入してきた二年生。"},{"spoiler":false,"text":"彼に発現した『ギフト』は"},{"spoiler":false,"text":"「自らが決めたたったひとつのことを除いて、新しい記憶を持ち越せない」というもの。"},{"spoiler":false,"text":"彼の記憶は学園に来る以前の段階で停滞しているため、"},{"spoiler":false,"text":"毎朝、枕元の日記で確認しないとここがどこかも思い出せない。"},{"spoiler":false,"text":"『ギフト』は意志で行使する異能力という見方が一般的なので、"},{"spoiler":false,"text":"彼のこの体質が『ギフト』と呼べるかは担当医も首を傾げている。"},{"spoiler":false,"text":"なかなかタフな状況ではあるものの、前向きに学園生活に取り組む意志はある。"},{"spoiler":false,"text":"「今を楽しめれば今日に価値が出る」「昨日の俺に勝つ」というところ。"},{"spoiler":false,"text":"若干、自分に言い聞かせている節は否めないが……。"},{"spoiler":false,"text":"学園は生徒がなんらかの部活に入ることを奨励しているので、部活は放送部に所属している。"},{"spoiler":false,"text":"なお、放送部に入った動機は覚えていない。"}],"source":"bangumi","sourceCharacterId":"102635"}],"prof