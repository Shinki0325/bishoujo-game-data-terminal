{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20847","model":{"presentationWorkId":"vndb:v15947","staff":{"artwork":[{"creditedName":"東雲一彦","creatorId":"vndb:s2263","sourcePersonId":"egs:creator:1532","canonicalEntityId":"vndb:s2263","name":"東雲一彦","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:135296","source":"egs"}],"scenario":[{"creditedName":"長野ヒロユキ","creatorId":"vndb:s2264","sourcePersonId":"egs:creator:1735","canonicalEntityId":"vndb:s2264","name":"長野ヒロユキ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:135297","source":"egs"}],"music":[],"other":[{"creditedName":"長野ヒロユキ","creatorId":"vndb:s2264","sourcePersonId":"egs:creator:1735","canonicalEntityId":"vndb:s2264","name":"長野ヒロユキ","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:135320","source":"egs"},{"creditedName":"東雲 一彦","creatorId":"vndb:s2263","sourcePersonId":"vndb:s2263","canonicalEntityId":"vndb:s2263","name":"東雲 一彦","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:113594","source":"vndb"}]},"cast":[{"characterId":"char_c17978","characterName":"日向 桜","sourceIds":{"bangumi":[{"characterId":"42807","match":"exact-normalized-name-in-linked-work","subjectId":"185734"},{"characterId":"42807","match":"exact-normalized-name-in-linked-work","subjectId":"45027"}],"egsCharacterIds":["2173"],"vndbCharacterId":"c17978"},"originalCharacterName":"日向 桜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shirou's adoptive mother and she loves him as her own child. After her husband died in an accident a few years ago, she has been doing her best to raise the 3 children. Because she wants all of them to be able to enter university, she often works overtime and recently her family is worried about her health because of that. She's recently been missing the skinship she had with Shirou when he was little."},{"spoiler":false,"text":"Sawako's sudden appearance was really surprising for her and she feels scared that Sawako is going to steal Shirou away. Because of that she starts to increase the amount of skinship to the point of insisting of entering the bath together."}],"source":"vndb","sourceCharacterId":"c17978"},{"segments":[{"spoiler":false,"text":"舞と七菜の母親で、主人公の義母に当たる女性。"},{"spoiler":false,"text":"おっとりした性格だが、芯はとても強く、大和撫子の鏡のような存在。"},{"spoiler":false,"text":"優しく母性に溢れた性格で、自分の娘と全く同じように四郎に対して『母親』として接している。"},{"spoiler":false,"text":"彼女の何もかも包み込んでくれるような温かな優しさの前に、新しい家族に戸惑いを感じていた四郎も心を開き、桜のことを『母さん』と呼ぶようになった。"},{"spoiler":false,"text":"年齢を感じさせないほど若作りで、２０歳台半ば……主人公の姉に思われることも多々あるほどである。"},{"spoiler":false,"text":"実際、主人公達への接し方も母親というよりもお姉さん的な所もあり、母親でありながらも頼れる年上のお姉さんといった雰囲気を持っている。"},{"spoiler":false,"text":"１８歳で結婚、１９歳の時に舞を出産した。その後、２年後に七菜を出産する。そんな中、叔父である陸奥高富を通じ、両親を亡くし、行く当てのない四郎を預かることになる。"},{"spoiler":false,"text":"四郎を加えた新しい家族での生活で幸せいっぱいの日向家だったが、不意の事故で夫を亡くしてしまう。"},{"spoiler":false,"text":"しかし、桜は突然の不幸にも心折れることなく、昔していた仕事を再開し日向家を支えていく。"},{"spoiler":false,"text":"二人の娘はもちろん四郎のことを、心から大切に思っていて、舞と七菜、そして四郎が幸せになることを願っている。"},{"spoiler":false,"text":"しかし、自分一人の収入だけで３人の子供を育てるのはなかなか大変で、最近は残業の日々が続き、体力を消耗してしまっている。"},{"spoiler":false,"text":"気丈に振るまい何とか日向家を支えているものの、内心では将来に不安を感じていて、希に四郎に息子ではなく、男性として頼り、依存したくなる時がある。"},{"spoiler":false,"text":"桜はそんな気持ちになる度に、激しい自己嫌悪に陥っている。"}],"source":"egs","sourceCharacterId":"2173","sourceWorkId":"17312","spoiler":false},{"segments":[{"spoiler":false,"text":"舞と七菜の母親で、主人公の義母に当たる女性。"},{"spoiler":false,"text":"おっとりした性格だが、芯はとても強く、大和撫子の鏡のような存在。"},{"spoiler":false,"text":"優しく母性に溢れた性格で、自分の娘と全く同じように四郎に対して『母親』として接している。"},{"spoiler":false,"text":"彼女の何もかも包み込んでくれるような温かな優しさの前に、新しい家族に戸惑いを感じていた四郎も心を開き、桜のことを『母さん』と呼ぶようになった。"},{"spoiler":false,"text":"年齢を感じさせないほど若作りで、20歳台半ば……主人公の姉に思われることも多々あるほどである。"},{"spoiler":false,"text":"実際、主人公達への接し方も母親というよりもお姉さん的な所もあり、母親でありながらも頼れる年上のお姉さんといった雰囲気を持っている。"}],"source":"egs","sourceCharacterId":"2173","sourceWorkId":"17392","spoiler":false},{"segments":[{"spoiler":false,"text":"舞と七菜の母親で、主人公の義母に当たる女性。"},{"spoiler":false,"text":"おっとりしているが芯はとても強く、大和撫子の鏡のような存在。"},{"spoiler":false,"text":"優しく母性にあふれた性格で、自分の娘とまったく同じように四郎に “母親” として接している。"},{"spoiler":false,"text":"年齢を感じさせないほど若作りで、20歳台半ば…… 主人公の姉に思われることもあるほど。"},{"spoiler":false,"text":"娘たちを出産した後、叔父である陸奥高富を通じて両親を失った四郎を預かることになる。"},{"spoiler":false,"text":"5人家族となり幸せいっぱいの日向家だったが、ある日不意の事故で夫を亡くしてしまう。"},{"spoiler":false,"text":"桜は突然の不幸にも心折れることなく日向家を支えていく。"},{"spoiler":false,"text":"娘たちはもちろん四郎のことも心から大切に思っていて、三人が幸せになることを願っている。"},{"spoiler":false,"text":"「歳なんて関係ないわ。四郎がいくつになっても母さんにとって、四郎は四郎…… 可愛い息子なんだから」"}],"source":"bangumi","sourceCharacterId":"42807"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6567e19290675668cbf9a22934294db7e40ea98a63f10ff3d5e8a7ca4fd57c3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a3954371096ea88061cd1310701113120dc8814597a785171cb4a411788362f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId"