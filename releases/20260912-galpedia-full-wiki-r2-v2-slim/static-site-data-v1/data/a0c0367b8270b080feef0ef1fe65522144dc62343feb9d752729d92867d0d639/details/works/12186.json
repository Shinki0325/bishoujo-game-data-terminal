conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A knight who awoke in the woods with no memories."},{"spoiler":false,"text":"Having lost all her memories, she named herself 'Milles,' which means 'nameless' in this world. She carries a deep darkness in her eyes."},{"spoiler":false,"text":"Because she has lost her memories, her original personality is unknown."},{"spoiler":false,"text":"Milles as she is now has a gentle, straightforward personality."},{"spoiler":false,"text":"When the darkness she carries is awakened, along with her memories, even greater darkness will be called forth."},{"spoiler":true,"text":"After masturbating at a shrine of the local god, Milles regains her memories. It turns out that Milles was a servant of Diva-Sama. And that she used to be a slime monster who was given a humanoid body. This is because since Milles (when she was a slime) wanted to become the sacrifice for the year, Diva did not understand her feelings, so he gave her the form of a beautiful woman; a tribute to the beautiful girls that got sacrificed years prior."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c18272"},{"segments":[{"spoiler":false,"text":"記憶を失い、森で倒れていた女騎士。"},{"spoiler":false,"text":"名前すらも覚えておらず、この世界で“名無し”を意味する“ミレス”と名乗る。"},{"spoiler":false,"text":"現在の彼女は、非常に優しく、真っ直ぐな性格だが、記憶を失っているため、それが本当の彼女であるかは定かではない。"},{"spoiler":false,"text":"整った顔立ちで、意志の強そうな眼の奥には、深い闇が宿っている。"}],"source":"egs","sourceCharacterId":"15566","sourceWorkId":"12186","spoiler":false},{"segments":[{"spoiler":false,"text":"森に倒れていた記憶喪失の騎士。"},{"spoiler":false,"text":"すべての記憶を失っており、この世界で名無しという意味の 『ミレス』と名乗る。"},{"spoiler":false,"text":"その瞳の奥には深い闇を宿している。"},{"spoiler":false,"text":"本来の性格は不明だが、現在のミレスは優しく、まっすぐな性格。"},{"spoiler":false,"text":"ミレスの抱える闇は、甦る記憶と共にさらなる深い闇を呼び覚ます。"}],"source":"bangumi","sourceCharacterId":"62090"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"15566","sourceWorkId":"12186","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"15566","sourceWorkId":"12186","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"15566","sourceWorkId":"12186","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"15566","sourceWorkId":"12186","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aee50a3c698bffd3b78812c7b90ca9a76b3fb134ea1b47288d9612523c995230.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/657b0c61cab4a50b9e8f5c2297485320c9fdaaf02f4d7e954220c0aed287ed66.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長瀬ゆずは","creatorId":"vndb:s2287","sourcePersonId":"vndb:s2287","canonicalEntityId":"vndb:s2287","name":"長瀬ゆずは","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81548:62090:24238:1","source":"bangumi"}]},{"characterId":"char_c18273","characterName":"カディア","sourceIds":{"bangumi":[{"characterId":"62091","match":"exact-normalized-name-in-linked-work","subjectId":"81548"}],"egsCharacterIds":["15567"],"vndbCharacterId":"c18273"},"originalCharacterName":"カディア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"ba