source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A runaway girl taken in by the main character, Ichito."},{"spoiler":false,"text":"She stubbornly hides her surname."},{"spoiler":false,"text":"A beautiful, pure and innocent girl with translucent white skin."},{"spoiler":false,"text":"She has the presence of a rich lady."},{"spoiler":false,"text":"The story is set in Okinawa, where the sunlight is strong, so she often uses a parasol, which suits her well."},{"spoiler":false,"text":"Contrary to her appearance, she has a little devilish personality."},{"spoiler":false,"text":"She has a straightforward nature, and is quick to act on her ideas."},{"spoiler":false,"text":"To put it in a good way, she is positive, but to put it in a bad way, she is reckless and likes to play pranks."},{"spoiler":false,"text":"Perhaps because she is a rich lady, she is fearless, which can make her even more devious."}],"source":"vndb","sourceCharacterId":"c139860"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae548eb621cf9639e7cf412dbeae4ec40e588e1ff4738a3c87d94711b1b994cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/602e7fab74ad1002a78631a6e64ca6cadf52ebba4cc5faa08c5aa04387cfa66b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遥 そら","creatorId":"vndb:s195","sourcePersonId":"vndb:s195","canonicalEntityId":"vndb:s195","name":"仙台 エリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98296","source":"vndb"}]},{"characterId":"char_vndb_c139861","characterName":"月代 零","sourceIds":{"vndbCharacterId":"c139861"},"originalCharacterName":"月代 零","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"113"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at the academy."},{"spoiler":false,"text":"The younger sister of the main character, Ichito."},{"spoiler":false,"text":"She calls Ichito \"Nii-nii.\""},{"spoiler":false,"text":"Her silver hair is symbolic of the moon."},{"spoiler":false,"text":"She has a fragile air about her."},{"spoiler":false,"text":"She is generally reserved, but when the time comes, she can speak mercilessly with a cold expression."},{"spoiler":false,"text":"She is sickly."},{"spoiler":false,"text":"During her first year at the academy, she would attend school on and off depending on her health."},{"spoiler":false,"text":"Now in her second year, she is able to attend school normally, but she still needs to go to the hospital."},{"spoiler":false,"text":"Rei is the sister of the King of Ryukyu, and as a Ryukyu priestess, she supports her brother Ichito with religious ceremonies."},{"spoiler":false,"text":"However, she sometimes blames herself for not being able to fulfill her role properly due to her poor health."}],"source":"vndb","sourceCharacterId":"c139861"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d6fedcd7bf24588a351bf742af24fdf6791fd4591c6a9f91f7acd0dad39a6c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8acc504dbee7d8c1c388d2d70ca8afaded6f0ed0c71fbd726d6fa1cfc48d514e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏和小","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98299","source":"vndb"}]},{"characterId":"char_vndb_c139862","characterName":"喜良原 詩呼","sourceIds":{"vndbCharacterId":"c139862"},"originalCharacterName":"喜良原 詩呼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1008"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student at the school."},{"spoiler":false,"text":"On the surface, she is a female student who belongs to the Marine Sports Club."},{"spoiler":false,"text":"Behind her back, she is a member of the Ookumiza."},{"spoiler":false,"text":"Among them, she is one of the shrine maidens (yuta) who serve the protagonist, Ichito, and is a close aide to the king."},{"spoiler":false,"text":"Possessing a commensurate amount of dragon power (seji), Shioko can freely control fire."},{"spoiler":false,"text":"She speaks in a dignified, masculine tone."},{"spoiler":false,"text":"She is earnest, honest, and pure, but also inflexible and rigid, which can cause trouble for Ichito even without her realizing it."}],"source":"vndb","sourceCharacterId":"c139862"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6ad365668b12dfc1c9f6765bc8721ee9d2c8ab59cc726857765ea16a4ff9fcc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b72bdd31b4b5d3b78bc6ad14bab3aed28f15107b43bb4586908d470d7efe2408.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c139863","characterName":"垣花 彩楽","sourceIds":{"vndbCharacterId":"c139863"},"originalCharacterName":"垣花 彩楽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"320"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student at the school."},{"spoiler":false,"text":"On the surface, she is a female student who belongs to the Marine Sports Club."},{"spoiler":false,"text":"Behind her back, she is a member of the Ookumiza."},{"spoiler":false,"text":"Like Shiiko, she is one of the shrine maidens (yuta) who serve the protagonist, Ichito, and is an aide to the king."},{"spoiler":false,"text":"With the appropriate amount of dragon power (seji), Sairaku can freely control the wind."},{"spoiler":false,"text":"Her personality is that of a modern schoolgirl."},{"spoiler":false,"text":"She is a fun-loving, cheeky brat."},{"spoiler":false,"text":"She hopes to leave this rural town one day and have more girly fun in the city."},{"spoiler":false,"text":"By the way, Ichito calls the two of them \"Shiisaa\", combining Uiko's \"shi\" and Sairaku's \"saa\"."}],"source":"vndb","sourceCharacterId":"c139863"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca4a4150ae9191cf3b4f81c7d5856a685601871916d51942a082a8c9fc388676.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4d5576c3098a174fd0da5cf474e5ce01fadd237219b31fd8fc5d0ca9510ee17.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奏雨","creatorId":"vndb:s199","sourcePersonId":"vndb:s199","canonicalEntityId":"vndb:s199","name":"尾崎 真実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98297","source":"vndb"}]},{"characterId":"char_vndb_c139864","characterName":"ねーねー","sourceIds":{"vndbCharacterId":"c139864"},"originalCharacterName":"ねーねー","characterNameSource":null,"