"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the current headmaster of St. Lilium Academy. She was appointed to the school, which was at a standstill due to a declining birthrate, and has successfully restored it. In accordance with the school's motto, she places importance on the independence of students. Although she has a gentle and mild personality, she has a strong belief in his educational policy, and is looked up to not only by students but also by teachers."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c144098"},{"segments":[{"spoiler":false,"text":"聖リリウム学園の現学園長。"},{"spoiler":false,"text":"少子化から経営的に行き詰まっていた学園に赴任し、見事に立て直した手腕の持ち主。"},{"spoiler":false,"text":"学園の校是に則り、生徒の自主自立を重んじている。"},{"spoiler":false,"text":"穏やかで柔和な性格ながら、自分の教育方針には信念を持っており、生徒だけでなく教師陣からも尊敬の目で見られている。"},{"spoiler":false,"text":"その正体は、かつて\"羊飼い\"と呼ばれた手練れの女衒。"},{"spoiler":false,"text":"今は、独自に開発した調教プログラム—SHEEP—の完成に心血を注いでいる。"},{"spoiler":false,"text":"その目的のため、学園の生徒達を実験台として、様々なデータの収集をしている。"}],"source":"egs","sourceCharacterId":"27548","sourceWorkId":"36711","spoiler":false},{"segments":[{"spoiler":false,"text":"教育者の仮面を被った鬼才の女衒"},{"spoiler":false,"text":"聖リリウム学園の現学園長。"},{"spoiler":false,"text":"少子化から経営的に行き詰まっていた学園に赴任し、見事に立て直した手腕の持ち主。"},{"spoiler":false,"text":"学園の校是に則り、生徒の自主自立を重んじている。"},{"spoiler":false,"text":"穏やかで柔和な性格ながら、自分の教育方針には信念を持っており、"},{"spoiler":false,"text":"生徒だけでなく教師陣からも尊敬の目で見られている。"},{"spoiler":false,"text":"その正体は、かつて\"羊飼い\"と呼ばれた手練れの女衒。"},{"spoiler":false,"text":"今は、独自に開発した調○プログラム—SHEEP—の完成に心血を注いでいる。"},{"spoiler":false,"text":"その目的のため、学園の生徒達を実験台として、様々なデータの収集をしている。"},{"spoiler":false,"text":"「”百合の花のように強く、しなやかに” 生徒の皆さんが健やかに成長されることを願います」"}],"source":"bangumi","sourceCharacterId":"185872"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"27548","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"27548","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"175 cm","valueContext":null,"source":"egs","sourceCharacterId":"27548","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"27548","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"27548","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"62 kg","valueContext":null,"source":"egs","sourceCharacterId":"27548","sourceWorkId":"36711","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"94","source":"vndb","sourceCharacterId":"c144098","value":"94"},{"comparisonValue":"89","scope":"sourceWork","source":"egs","sourceCharacterId":"27548","sourceWorkId":"36711","value":"89"},{"comparisonValue":"89","source":"bangumi","sourceCharacterId":"185872","value":"89"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/328a0d0490f972d847b773f701922fcee4494121ae78810bdb17033f16e8c0ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22959305ead9a73957bd24c0879bfb00c83f0f2f2ea31c0b891e0501e1abb7eb.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:501701:185872:6380:1","source":"bangumi"}]},{"characterId":"char_c144195","characterName":"白洲　江里華","sourceIds":{"bangumi":[{"characterId":"185873","match":"exact-normalized-name-in-linked-work","subjectId":"501701"}],"egsCharacterIds":["27549"],"vndbCharacterId":"c144195"},"originalCharacterName":"白洲　江里華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the head of the Shirayuri Dormitory, a dormitory that places importance on social status, such as position, bloodline, and financial power. She has a gorgeous face with the features of a Western doll. However, inside, she is self-centered and self-righteous. She is selfish, arrogant, and tyrannical. She looks down on poor people usng her family richness as yardstick, and she tries to expel anyone she doesn't like from the school with her cronies, even teachers. Her father has been donating a large amount of money to the school, so the school has left her alone for the most part."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c144195"},{"segments":[{"spoiler":false,"text":"地位や血筋、財力など社会的ステータスに重きを置く“白百合寮”の寮長。"},{"spoiler":false,"text":"西洋人形のように整った顔立ちの、華やかなルックスの持ち主。"},{"spoiler":false,"text":"しかし、中身は自己中心的で独善的。自分勝手で横暴な暴君気質。"},{"spoiler":false,"text":"実家が金持ちかどうかが江里華の尺度であり、貧乏人は当然のように見下し、気に入らない者は教師であろうと取り巻きを従えて学園から追放しようとする。"},{"spoiler":false,"text":"父親が学園に多額な寄付金を収めているため、学園側も半ば放置している状態。"}],"source":"egs","sourceCharacterId":"27549","sourceWorkId":"36711","spoiler":false},{"segments":[{"spoiler":false,"text":"白百合寮に君臨するワガママな女王様"},{"spoiler":false,"text":"地位や血筋、財力など社会的ステータスに重きを置く“白百合寮”の寮長。"},{"spoiler":false,"text":"西洋人形のように整った顔立ちの、華やかなルックスの持ち主。"},{"spoiler":false,"text":"しかし、中身は自己中心的で独善的。自分勝手で横暴な暴君気質。"},{"spoiler":false,"text":"実家が金持ちかどうかが江里華の尺度であり、貧乏人は当然のように見下し、"},{"spoiler":false,"text":"気に入らない者は教師であろうと取り巻きを従えて学園から追放しようとする。"},{"spoiler":false,"text":"父親が学園に多額な寄付金を収めているため、学園側も半ば放置している状態。"},{"spoiler":false,"text":"「ちょっと！貧乏臭いわね、近寄らないでくれる？」"}],"source":"bangumi","sourceCharacterId":"185873"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"185873","value":"1年1組"},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"27549","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"27549","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"27549","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"27549","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"27549","sourceWorkId":"36711","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"27549","sourceWorkId":"36711","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c9acce16