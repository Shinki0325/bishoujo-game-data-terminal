{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"5126","model":{"presentationWorkId":"vndb:v1410","staff":{"artwork":[{"creditedName":"啼兎☆(なきうさ、青空れみな)","creatorId":"vndb:s2481","sourcePersonId":"egs:creator:2133","canonicalEntityId":"vndb:s2481","name":"啼兎☆(なきうさ、青空れみな)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:8889","source":"egs"}],"scenario":[{"creditedName":"武藤礼恵","creatorId":"vndb:s1792","sourcePersonId":"egs:creator:265","canonicalEntityId":"vndb:s1792","name":"武藤礼恵","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:10499","source":"egs"},{"creditedName":"箕崎准","creatorId":"vndb:s3775","sourcePersonId":"egs:creator:2595","canonicalEntityId":"vndb:s3775","name":"箕崎准","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:10500","source":"egs"},{"creditedName":"木之本みけ","creatorId":"vndb:s2488","sourcePersonId":"egs:creator:2035","canonicalEntityId":"vndb:s2488","name":"木之本みけ","detail":"雪音onlyルート","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:12169","source":"egs"},{"creditedName":"いこもといさや","creatorId":"vndb:s46080","sourcePersonId":"egs:creator:3958","canonicalEntityId":"vndb:s46080","name":"いこもといさや","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14216","source":"egs"},{"creditedName":"でぇすて","creatorId":"vndb:s921","sourcePersonId":"vndb:s921","canonicalEntityId":"vndb:s921","name":"でぇすて(D.S.T、不二川巴人)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:24603","source":"vndb"}],"music":[{"creditedName":"Ecnemuse","creatorId":"vndb:s2146","sourcePersonId":"egs:creator:2983","canonicalEntityId":"vndb:s2146","name":"Ecnemuse","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:10501","source":"egs"}],"other":[{"creditedName":"真優","creatorId":"vndb:s1024","sourcePersonId":"egs:creator:6591","canonicalEntityId":"vndb:s1024","name":"真優","detail":"主題歌「DOKIDOKIのキ・モ・チ▼」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:127510","source":"egs"},{"creditedName":"でぇすて(D.S.T、不二川巴人)","creatorId":"vndb:s921","sourcePersonId":"egs:creator:1074","canonicalEntityId":"vndb:s921","name":"でぇすて(D.S.T、不二川巴人)","detail":"シナリオヘルプ(濡れ場を2シーン程)","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14215","source":"egs"},{"creditedName":"真優","creatorId":"vndb:s1024","sourcePersonId":"vndb:s1024","canonicalEntityId":"vndb:s1024","name":"桂木 真優","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:24604","source":"vndb"}]},"cast":[{"characterId":"char_c10412","characterName":"牧村 みのり","sourceIds":{"bangumi":[{"characterId":"139897","match":"exact-normalized-name-in-linked-work","subjectId":"153681"}],"egsCharacterIds":["26629"],"vndbCharacterId":"c10412"},"originalCharacterName":"牧村 みのり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８２"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７８"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５７"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の実家のご近所に住んでいた女の子。"},{"spoiler":false,"text":"主人公が実家に住んでいた当時、主人公を「お兄ちゃん」と慕って甘えていた。"},{"spoiler":false,"text":"一見、お淑やかなお嬢様に見えるが、かなり行動的で世話好き、かつ面倒見の良いしっかり者だが、ここぞというときにヘマをしてしまう本番に弱いタイプ。"},{"spoiler":false,"text":"主人公のお嫁さんになる夢をもっているが、お嫁さん必須の家事全般が不得手。"},{"spoiler":false,"text":"オマケにメカオンチで、家事をやらせるのは、かなり危険。"},{"spoiler":false,"text":"好きになったら一途な性格で、さらにはヤキモチ焼き。"}],"source":"egs","sourceCharacterId":"26629","sourceWorkId":"5126","spoiler":false},{"segments":[{"spoiler":false,"text":"ある日突然、正太郎の部屋に押しかけてきた女の子。それは、正太郎の実家のご近所さん『牧村家』の長女みのりであった。正太郎が実家に住んでいた当時は、幼馴染みだったみのりを実の妹の様に可愛がっていたが、大学への進学によって一人暮らしを始める事となり、それ以来実に３年ぶりの再会となる。"},{"spoiler":false,"text":"優しい顔立ちにサラサラの長い髪、それに大人しめな印象の服装が相まって、一見お淑やかなお嬢様の様にも見える。しかしその可憐な外見とは裏腹に、性格は至って行動的で世話好き、かつ面倒見の良いしっかり者。親しみやすい性格と可憐な容姿から周囲の人気も高く、妹の雪音もそんな姉の事が大好き。ただ、思考回路に若干ズレた所もあり、ここぞという時に限ってヘマをしてしまう本番に弱い所も持っている。"},{"spoiler":false,"text":"好きな食べ物は甘い物（特に和菓子）と女の子らしく、また穏和な性格を象徴するかのごとく、日に１回は欠かさないひなたぼっこが趣味。昔から正太郎の事が大好きで、将来は正太郎のお嫁さんになりたいと強く願っているものの、お嫁さん必修科目でもある家事全般が非常に苦手。また極度のメカオンチである事も手伝って、家事をやらせると大変な事に。"},{"spoiler":false,"text":"好きになったら一途な性格のみのりだが、反面かなりのやきもち焼き。また、大好きな正太郎の望む事・喜ぶ事なら何でもしたいという強い想いがあらぬ方向へいってしまう事も多く、妹の雪音を実験台にしては独自にＨなお勉強をしていたり……。雪音の過剰な姉への好意（愛？）は、この辺りに原因があるのかも。"}],"source":"bangumi","sourceCharacterId":"139897"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"26629","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"26629","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"26629","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"26629","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"26629","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"44 kg","valueContext":null,"source":"egs","sourceCharacterId":"26629","sourceWorkId":"5126","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83ee9f2c830e11afafe80932d64ed59eac94c89ac6cec5516d2984541a3ca7c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7237f4350feb4dc0cf72d43f360b48b470c2e5a84d10c0a97e78ad0e54fa947f.webp","width":98,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒河奈美","creatorId":"vndb:s1062","sourcePersonId":"vndb:s1062","canonicalEntityId":"vndb:s1062","name":"本山美奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153681:139897:4754:1","source":"bangumi"}]},{"characterId":"char_c10413","characterName":"牧村 雪音","sourceIds":{"bangumi":[{"characterId":"139898","match":"exact-normalized-name-in-linked-work","subjectId":"153681"}],"egsCharacterIds":["26630"],"vndbCharacterId":"c10413"},"originalCharacterName":"牧村 雪音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"７９"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７６"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５２"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"みのりの妹。"},{"spoiler":false,"text":"主人公の押しかけて行った姉を心配して追いかけてきた女の子。"},{"spoiler":false,"text":"姉のことが大好きで、その姉に対しては非常に従順で可愛らしい良く出来た妹を演じる。"},{"spoiler":false,"text":"しかし、本来は感情的な性格であり、大好きな姉と自分の関係を邪魔しようとする輩には敵意を剥き出しにして、徹底的に排除しようとする。"},{"spoiler":false,"text":"当然、主人公を完全に敵視しており、得意のマシンガントークで主人公を責め立てる。"},{"spoiler":false,"text":"そんな彼女は、少女趣味的なところがあり、コスプレにも興味津々。"},{"spoiler":false,"text":"実は、主人公はツインテール萌えであり、コスプレ好きなのだが……。"}],"source":"egs","sourceCharacterId":"26630","sourceWorkId":"5126","spoiler":false},{"segments":[{"spoiler":false,"text":"牧村家の次女で、家を飛び出し正太郎の元へ押しかけに行った最愛の姉を心配して追いかけてきた女の子。ツインテールの髪型や乙女チックな可愛らしい服装を好むなど、少女趣味的な物やロマンティックな事を好み、そんな嗜好の延長からか今はコスプレに興味津々で、そういったイベントにも隠れて行っている様子。性格についても、姉みのりに対しては非常に従順で可愛らしい良くできた妹と言える。"},{"spoiler":false,"text":"だが、本来は感情的な性格であり、大好きな姉みのりと自分の関係を邪魔しようとする者に対しては容赦なく攻撃を加え、徹底的に排除しようとする。もちろん正太郎を完全に敵視しており、雪音お得意のマシンガントークで正太郎を責め立てる。"},{"spoiler":false,"text":"恋愛に関しては非常に甘えたがりな所があり、またお互いの時間の共有や身体の触れあいを求めるタイプのため、Ｈの後の余韻を大切にする。"},{"spoiler":false,"text":"また、耳を弄られるのに非常に弱い。姉みのりのお勉強に付き合わされた結果なのか、現在では男より女の子の方が好きという立派なレズっ娘に。特に姉みのりへの執着は強く、姉妹の禁断の恋というロマンティックな部分に陶酔しきってしまう事も。"}],"source":"bangumi","sourceCharacterId":"139898"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"26630","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"26630","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"26630","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"26630","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"26630","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"39 kg","valueContext":null,"source":"egs","sourceCharacterId":"26630","sourceWorkId":"5126","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b301055a2fe3c53b41b0ce2c226c9ca2262ca89315d174aaa66ed04b0913697.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1563094eb1f840c1d734a390c6237e8a5840c90ebc0a3662159f469a9b38273.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153681:139898:4490:1","source":"bangumi"}]},{"characterId":"char_c10414","characterName":"神代 珠美","sourceIds":{"bangumi":[{"characterId":"139899","match":"exact-normalized-name-in-linked-work","subjectId":"153681"}],"egsCharacterIds":["26631"],"vndbCharacterId":"c10414"},"originalCharacterName":"神代 珠美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８９"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"136"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７４"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"４８"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の住むマンションのお隣さんにして管理人。"},{"spoiler":false,"text":"未亡人で、双子の娘（ことり＆ヒナ）の3人で暮らしている。"},{"spoiler":false,"text":"驚異的な童顔で、136cmと小柄で華奢ながら、Fカップのバストを持つ「ロリ巨乳」。"},{"spoiler":false,"text":"年甲斐も無く主人公にベタ惚れしてしまい、その感情をストレートに表現する猪突猛進型の性格から、猛烈なアタックを繰り返していたが、みのりが現れてからは、俄然、ライバル心を露にし、そのアタックも苛烈になっていく。"},{"spoiler":false,"text":"主婦だけあって、その家事遂行能力は高く、料理の腕は抜群。"},{"spoiler":false,"text":"そんな家庭的な魅力と、大人の色気たっぷりのアタックで主人公のハートを射止めようとするが……。"}],"source":"egs","sourceCharacterId":"26631","sourceWorkId":"5126","spoiler":false},{"segments":[{"spoiler":false,"text":"正太郎の住むマンションの大家で、現在未亡人。娘のことりとヒナとの３人暮らし。１３６ｃｍという小柄な体躯とＦカップのとても大きな胸が特徴的で、髪はいつも後方でゆったりとまとめている。また、娘と同年代に見られても全く不思議では無い驚異的な童顔で、二児の母には決して見えない。視力が悪いため普段は眼鏡かコンタクトレンズを使用しているが、娘のヒナに「オバさんくさい」と言われてから眼鏡は極力使用しなくなっている。"},{"spoiler":false,"text":"性格は感情をストレートに表現する猪突猛進型で、年甲斐も無く正太郎にベタ惚れしてしまい、その性格が災いしてか現在は押せ押せの勢いで正太郎へのアタックを続けている。しかし、みのりの突然の来訪をきっかけに、みのりをライバル視し始め、珠美の正太郎へのアタックはより過激になっていく。さすがに元人妻だけあって、炊事洗濯などの家事全般を非常に得意としており、中でも料理の腕は超一流。一人暮らしの正太郎に、料理の差し入れを頻繁に持って行くなどしている。"},{"spoiler":false,"text":"Ｈな事に関しては非常に楽観的で、正太郎への過激なお色気アタック作戦も度々。また二児の母とは思えない程の綺麗な身体をしており、性的な感度も非常に高いのだが、同時に性的な事に非常に強く、珠美をイかせる前に正太郎が何度もイかされてしまう事に。ただ、自己本位で自分だけが気持ちよくなるためにＨをする事は無く、母性的な側面から相手に気持ちよくなって欲しいという思いが強いためか、正太郎を何度でも気持ちよくしてあげるための奉仕を厭わない献身的な面も。"}],"source":"bangumi","sourceCharacterId":"139899"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"26631","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"26631","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"136 cm","valueContext":null,"source":"egs","sourceCharacterId":"26631","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"26631","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"26631","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"26631","sourceWorkId":"5126","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e673e9ebc3089a82b9f046db467d0804644af5525e3bc3dcd35f1ef357e89af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f3c7234801dfea8b24e015263cb69cedbc6c28a76c34eb6c9f4aabead478f38.webp","width":116,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153681:139899:4675:1","source":"bangumi"}]},{"characterId":"char_c10415","characterName":"神代 ことり","sourceIds":{"bangumi":[{"characterId":"88148","match":"exact-normalized-name-in-linked-work","subjectId":"153681"}],"egsCharacterIds":["26632"],"vndbCharacterId":"c10415"},"originalCharacterName":"神代 ことり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"70"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"46"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"36"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神代家の長女にして、双子の姉。"},{"spoiler":false,"text":"物静かでお淑やかな女の子。"},{"spoiler":false,"text":"性格は、気弱で人見知りが激しく、いつもオドオドしている感じ。"},{"spoiler":false,"text":"母親の手伝いをしっかりしていたことから、家事全般をそつなくこなすしっかり者。"},{"spoiler":false,"text":"主人公に亡くなった父親を重ねているのか、めいっぱい甘えたいと思っているようだ。"},{"spoiler":false,"text":"清純可憐でウブであることは確かだが、耳年増でエッチなことに、かなり興味津々の模様。"},{"spoiler":false,"text":"また苛められることは好きではないようだが、M的資質を隠し持つ。"}],"source":"egs","sourceCharacterId":"26632","sourceWorkId":"5126","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：１４４ｃｍ　体重：３６ｋｇ"},{"spoiler":false,"text":"バスト：７０（Ａ）－４６－７４"},{"spoiler":false,"text":"神代家の長女。綺麗に切りそろえられた前髪とレース系で肌の露出が少ない服装（下着含む）を好む、如何にも純情可憐といった表現がピッタリな少女。しかし、母珠美とは似ても似つかぬＡカップの小さな胸をかなり気にしており、また人見知りが激しくいつもオドオドとしている。父親を早くに亡くした家庭環境のためか、家事全般はそつなくこなすしっかり者。しかし、正太郎の事を何故か頼りがいがある様に見えてしまっているあたり、実は誰かにめいっぱい甘えたいという願望があるのかも。"},{"spoiler":false,"text":"そんな優等生的な女の子だが、実は非常に耳年増でＨな事に興味津々。また、妄想癖があり、正太郎をＨな妄想の材料にして、あっちの世界へ旅立ってしまう事もしばしば。妹ヒナの影響なのかどうやら潜在的なＭ資質があるようで、いじめられる事自体は好きでは無いのだが、"},{"spoiler":false,"text":"身体が勝手に反応してしまう事も。また、身体の感度が非常に良く、すぐイってしまう。"}],"source":"bangumi","sourceCharacterId":"88148"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"26632","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"26632","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"144 cm","valueContext":null,"source":"egs","sourceCharacterId":"26632","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"26632","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"46 cm","valueContext":null,"source":"egs","sourceCharacterId":"26632","sourceWorkId":"5126","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"36 kg","valueContext":null,"source":"egs","sourceCharacterId":"26632","sourceWorkId":"5126","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a63f32ad85806a340a6b15c627e3bd3ae4b10aba5c8c1ce78e80b8ec544eb997.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cad909a084572686552dfcb2c35e288ea80df187cfe9956afae713d9c0929533.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153681:88148:6036:1","source":"bangumi"}]},{"characterId":"char_c10416","characterName":"神代 ヒナ","sourceIds":{"bangumi":[{"characterId":"88149","match":"exact-normalized-name-in-linked-work","subjectId":"153681"}],"egsCharacterIds":["26633"],"vndbCharacterId":"c10416"},"originalCharacterName":"神代 ヒナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"hip":{"reviewState":"source-only","source":"vndb","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"45"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"34"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神代家の次女にして、双子の妹。"},{"spoiler":false,"text":"姉とは正反対に、活発で行動的な女の子。"},{"spoiler":false,"text":"性格は、好奇心旺盛で負けず嫌い、小悪魔的なところもあるが、根本的にはお子様。"},{"spoiler":false,"text":"チヤホヤされたり、必要以上に優しくされると、途端に照れて恥ずかしくなてしまい、モジモジと……。"},{"spoiler":false,"text":"また打たれ弱く、逆境に追い込まれると何も出来なくなってしまう。"},{"spoiler":false,"text":"エッチの知識は疎いが、好奇心旺盛で、持ち前のお子様思考で過激にエスカレートしていく。"}],"source":"egs","sourceCharacterId":"26633","sourceWorkId":"5126","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：１４０ｃｍ　体重：３４ｋｇ"},{"spoiler":false,"text":"３ｓｉｚｅ：６９（Ｃ）－４５－７０"},{"spoiler":false,"text":"神代家の次女。勝ち気で生意気そうなツリ目とポニーテールが特徴的な女の子で、キュロット等の活発的な服装を好む。性格は好奇心旺盛で、極度の負けず嫌い。口調や仕草からいぢわるな雰囲気を醸し出す小悪魔的女王様気質。また、人によって態度を露骨に変化させるしたたかさも持ち合わせている。どうやら正太郎はヒナの「どれー」らしく、普段「いちごう」と呼ぶ。"},{"spoiler":false,"text":"そんな性格ではあるものの、根本的には超お子様的思考で、全く憎めないあたり実は甘え上手なのかも。実際にチヤホヤされたり必要以上に優しくされると、すぐに照れまくってしまう可愛らしさも。また、非常に打たれ弱く、逆境に追い込まれるとすぐ凹んでしまう。そんなヒナだけに恋愛に関する感情も非常にお子様チックで、愛や恋の前に興味が先行する。Ｈに関しての知識は疎いが好奇心が旺盛なため、どんどん過激にエスカレートしていく。"}],"source":"bangumi","sourceCharacterId":"88149"}],"profileFacts":[{"label":"胸围（本版本）","value":"69 cm","valueContext":null,"source":"egs","sourceCharacterId":"26633","sourceWorkId":"5126","sourceField"