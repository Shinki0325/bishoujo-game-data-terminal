46","sourcePersonId":"vndb:s1646","canonicalEntityId":"vndb:s1646","name":"又吉 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94553","source":"vndb"}]},{"characterId":"char_c101474","characterName":"有瀬 かぐや","sourceIds":{"bangumi":[{"characterId":"103852","match":"exact-normalized-name-in-linked-work","subjectId":"360498"}],"egsCharacterIds":["23906"],"vndbCharacterId":"c101474"},"originalCharacterName":"有瀬 かぐや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"411"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“A classy phantom thief always makes a grand entrance—swiping every heart in the room and leaving the crowd breathless.”"},{"spoiler":false,"text":"Born with a silver spoon in her mouth, Arise Kaguya hails from the wealthiest family in Sahoro. With her blue-blooded upbringing, it's no wonder she's the picture of grace with everyone she meets."},{"spoiler":false,"text":"The crown jewel of her school, she's sharp as a tack academically and straight as an arrow regarding behavior. Teachers and students sing her praises—the perfect girl in every way."},{"spoiler":false,"text":"When she's not acing her classes, you'll find her calling the shots as president of the Sahoro Historical Sites Research Club."},{"spoiler":false,"text":"Hobbies: Singing karaoke by herself, dancing, and enjoying anime"}],"source":"vndb","sourceCharacterId":"c101474"},{"segments":[{"spoiler":false,"text":"沙幌の街で一番の富豪、有瀬家の娘。"},{"spoiler":false,"text":"その家柄もあってか誰に対しても品のある対応をする、学校一の優等生。"},{"spoiler":false,"text":"沙幌歴史研究部の部長。"}],"source":"egs","sourceCharacterId":"23906","sourceWorkId":"32004","spoiler":false},{"segments":[{"spoiler":false,"text":"沙幌の街で一番の富豪、有瀬家の娘。"},{"spoiler":false,"text":"その家柄もあってか誰に対しても品のある对応をする、学校一の優等生。"},{"spoiler":false,"text":"成績も優秀で素行も良好。"},{"spoiler":false,"text":"先生からも生徒からも評判が良い、完璧な女の子。"},{"spoiler":false,"text":"沙幌歷史研究部の部長。"}],"source":"bangumi","sourceCharacterId":"103852"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22dfcd1aa250203a3d43d8ab44869b497eeb37ac6fe3cb336c6159dd7977809b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dda521d11c5ba184f75e972d88eb807e2d73501ae3cfc98db755846c3b66fd6.webp","width":256,"height":252,"source":"static-detail"},"actors":[{"creditedName":"藤田茜","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:420852:103852:17981:1","source":"bangumi"}]},{"characterId":"char_c101475","characterName":"シャルロット・ディ・カーブホーン・イェーズ","sourceIds":{"bangumi":[{"characterId":"103855","match":"exact-normalized-name-in-linked-work","subjectId":"360498"}],"egsCharacterIds":["23909"],"vndbCharacterId":"c101475"},"originalCharacterName":"シャルロット・ディ・カーブホーン・イェーズ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"720"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Charlotte is an detective dispatched from Interpol to Hokkaido in order to resolve the case of the phantom thief, Miss Arte. In order to make her life in Japan as normal as possible she attends the school of the protagonist as a 1st year student."},{"spoiler":false,"text":"As an detective she is famous for having perfectly resolved 99 previous cases by catching the criminal. She received most of her training in London, living in Baker street and becoming proficient in the martial arts skills known as \"Baritsu\"."},{"spoiler":true,"text":"She is Exna Yeatz's younger sister from Kin'iro Loveriche"}],"source":"vndb","sourceCharacterId":"c101475"},{"segments":[{"spoiler":false,"text":"「この名探偵、シャルロット・イェーズにかかれば解けない謎はないのであります！」"}],"source":"egs","sourceCharacterId":"23909","sourceWorkId":"32004","spoiler":false},{"segments":[{"spoiler":false,"text":"インターポールより派遣された世界的な名探偵。"},{"spoiler":false,"text":"これまで99の事件に関わり、なんとその解決率100％にものぼるという"},{"spoiler":false,"text":"圧倒的な実績を買われて沙幌の街にやってきた。"},{"spoiler":false,"text":"素晴らしい探偵……なのだが、推理力は悲しくなるくらいに皆無。"},{"spoiler":false,"text":"そんな彼女の最大の武器は、常軌を逸脱した圧倒的な身体能力。"},{"spoiler":false,"text":"小柄な体躯に秘められた能力はあのカリスをも上回る。"},{"spoiler":false,"text":"「この名探偵、シャルロット・イェーズにかかれば解けない謎はないのであります！」"}],"source":"bangumi","sourceCharacterId":"103855"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9aabd033287173c08b46f81319c1b52c81630f06b3becb73d417829760b86f8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/134bdeed363a8e4d1a044fbb46f31ecb929b03a332ee86f75306a52d5b4c8153.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎本 ねむ","creatorId":"vndb:s25620","sourcePersonId":"vndb:s25620","canonicalEn