ndidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ガラージュの街で鍛冶屋を営む。"},{"spoiler":false,"text":"魔剣の修復を主人公達から依頼され、関わる事に。"},{"spoiler":false,"text":"優しくて面倒見が良いお姉さん。"},{"spoiler":false,"text":"職業柄、男勝りの凜とした格好をしているが女性的でお母さんタイプでもある。"},{"spoiler":false,"text":"冒険者時代の主人公を知っており、憧れを抱いている乙女な一面もある。"},{"spoiler":false,"text":"彼女から見た魔剣は、一級品の魔法の武器。"},{"spoiler":false,"text":"鍛冶師としての興味は隠せない。"}],"source":"egs","sourceCharacterId":"13233","sourceWorkId":"24432","spoiler":false},{"segments":[{"spoiler":false,"text":"ガラージュの街で鍛冶屋を営むお姉さん。"},{"spoiler":false,"text":"優しくて面倒見が良く、男勝りな職業だが女性的なお母さんタイプ。"},{"spoiler":false,"text":"魔剣の修復を主人公たちから依頼され、関わることに。"},{"spoiler":false,"text":"冒険者時代の主人公を知っており、憧れを抱いている乙女な一面もある。"},{"spoiler":false,"text":"彼女から見た魔剣は一級品の魔法の武器で、鍛冶師としての興味は隠せない。"},{"spoiler":false,"text":"「それで……今日はいったいどうしたの？　頼まれてた商品の納期は、まだ先のはずよね？」"}],"source":"bangumi","sourceCharacterId":"50208"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a67aeb04be92c803fce205399ac7f2390e926fe203cd8e83f394bba8c99b96f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e688fc2f1e444ea5a1d0963c2a63eb6e9a27334d100f911ab9b48da3b727d75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城ほのか","creatorId":"vndb:s6018","sourcePersonId":"vndb:s6018","canonicalEntityId":"vndb:s6018","name":"結城 ほのか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197098:50208:20256:1","source":"bangumi"}]},{"characterId":"char_c55627","characterName":"ロゼッタ","sourceIds":{"bangumi":[{"characterId":"50209","match":"exact-normalized-name-in-linked-work","subjectId":"197098"}],"egsCharacterIds":["13234"],"vndbCharacterId":"c55627"},"originalCharacterName":"ロゼッタ","characterNameSource