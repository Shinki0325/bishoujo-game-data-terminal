iler":false,"text":"もっとしっかりしなきゃ。もっともっと。"},{"spoiler":false,"text":"そう奮起する彼女は、両親の再婚で義理の弟になった同級生の男の子にも、生来の勝ち気さとともに優位に立とうとする。"},{"spoiler":false,"text":"ところが、思いがけずそんな義弟の激しいオナニーシーンを目にしてしまったことから、彼女運命は、思わぬ方方角にねじれ始めていく。"}],"source":"bangumi","sourceCharacterId":"143355"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"21366","sourceWorkId":"27735","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"21366","sourceWorkId":"27735","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"21366","sourceWorkId":"27735","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"21366","sourceWorkId":"27735","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"21366","sourceWorkId":"27735","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11d3e34b23668435a684e8f5d593562313fa88700ef89550299c11a291059867.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aeddcfa0fe1f3010bd0bcd370f660d2917032f962ed571291e098b46aff1fa61.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜糀まい","creatorId":"vndb:s15608","sourcePersonId":"vndb:s15608","canonicalEntityId":"vndb:s15608","name":"桜糀まい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279451:143355:33497:1","source":"bangumi"}]},{"characterId":"char_c82494","characterName":"星宮 美咲","sourceIds":{"bangumi":[{"characterId":"143356","match":"exact-normalized-name-in-linked-work","subjectId":"279451"}],"egsCharacterIds":["21367"],"vndbCharacterId":"c82494"},"originalChar