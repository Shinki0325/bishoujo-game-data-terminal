ourceIds":{"bangumi":[{"characterId":"11054","match":"exact-normalized-name-in-linked-work","subjectId":"11530"}],"egsCharacterIds":["15808"],"vndbCharacterId":"c68914"},"originalCharacterName":"リリリィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界各国のありとあらゆる商品を揃える街のスーパーアイテムショップ「万国屋」。"},{"spoiler":false,"text":"その看板娘で街の男性から人気を集める可愛い女の子。"},{"spoiler":false,"text":"しかし賢三を激しく毛嫌いしていて、賢三の前でだけはとても性格の悪い子になる猫かぶり少女。"},{"spoiler":false,"text":"買い物と引き換えに様々な嫌がらせをしてくる。"},{"spoiler":false,"text":"「性犯罪者に売るものなんて無くてよ！"},{"spoiler":false,"text":"さっさと消えなさい……この世から！」"}],"source":"egs","sourceCharacterId":"15808","sourceWorkId":"11946","spoiler":false},{"segments":[{"spoiler":false,"text":"汇集了各国商品的街上的道具店“万国屋”的看板娘。"},{"spoiler":false,"text":"脸上洋溢着笑容，在城里的男性中极具人气。"},{"spoiler":false,"text":"不过却非常讨厌主角賢三，在賢三面前就会变得态度十分恶劣。"},{"spoiler":false,"text":"买东西时候对賢三进行百般刁难。"}],"source":"bangumi","sourceCharacterId":"11054"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ed7610275e6ae655295c1cdf449af079fc8fa967a88174a77641cf522a579e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23d5d832ff39a1ca54ed0176e40e9d0c727f5fa6873092b0cda6ea4e9bbcd2e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11530:11054:5922:1","source":"bangumi"}]},{"characterId":"char_c68915","characterName":"セロ・ポグロム","sourceIds":{"bangumi":[{"characterId":"147535","match":"exact-normalized-name-in-linked-work","subjectId":"11530"}],"egsCharacterI