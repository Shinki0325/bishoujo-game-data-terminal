{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30224","model":{"presentationWorkId":"egs:30224","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_29220","characterName":"東城会四代目","sourceIds":{"bangumi":[{"characterId":"29220","match":"source-roster","subjectId":"155364"},{"characterId":"29220","match":"source-roster","subjectId":"223578"}]},"originalCharacterName":"東城会四代目","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"184"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"88"}},"descriptions":[{"segments":[{"spoiler":false,"text":"背に彫られた宝玉を持った龍の刺青から「堂島の龍」「伝説の龍」「伝説の極道」と呼ばれる元ヤクザ。"},{"spoiler":false,"text":"強い正義感と情の厚さを兼ね備え、仁義に生きる男。引退後も彼の影響などで極道に足を踏み入れる者もいる。基本的に物静かで感情をあまり表情に出さないが、自身が強い信頼を抱いた者（島袋力也など）が死んだ場合などは滂沱（ぼうだ）の涙を流すこともある。また、根が強く、一度決めたら曲げないほどの頑固さもある。"}],"source":"bangumi","sourceCharacterId":"29220"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c46afdd7e618bfeb3f8e344af5e750f0a9e0c9f62754b5fdaeb76b1f660af3f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/381d2f0abe1bc99a9ecfd83b1c076d5a2d57fba4fef26523e2138af93c287434.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒田崇矢","creatorId":"vndb:s170","sourcePersonId":"vndb:s170","canonicalEntityId":"vndb:s170","name":"黒田 崇矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155364:29220:4225:1","source":"bangumi"}]},{"characterId":"char_bangumi_33965","characterName":"澤村 遥","sourceIds":{"bangumi":[{"characterId":"33965","match":"source-roster","subjectId":"155364"}]},"originalCharacterName":"澤村 遥","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"龍が如くシリーズの主人公である桐生一馬が恋していた澤村由美と由美の事実上の夫である神宮恭平の娘で、『1』の100億円事件のキーパーソン的人物。"},{"spoiler":false,"text":"ソープランドを知っていたり、地下カジノや賭場に来た際は行ったことがあるような素振りを見せるなどの風俗産業にも精通しているが、シリーズを追うごとに身長だけでも着実に高くなっており、桐生との信頼関係に至っては目を合わせただけで意思の疎通が出来るほどで、また桐生に対して臆することもなくおねだりしたり、『3』で養護施設「アサガオ」を破壊しに来た峯義孝の頬を叩いたりと見かけによらず肝が据わっている。"},{"spoiler":false,"text":"また、アサガオでは子供達の中では最年長であるため、他の子供達の面倒をみている。"},{"spoiler":false,"text":"『2』以外の作品では遥自身によるおねだりが存在しており、桐生で特定の場所に遥を連れていくと発生し、それをクリアして信頼度を高めることで自身からアイテムをもらうことができる（『2』では自身からもらえるアイテムが、前作『1』のクリアデータによる特典アイテムとして登場する）。"},{"spoiler":false,"text":"おねだりの種類は物の購入や飲食店での御馳走、ミニゲーム攻略（自身と対戦する場合もある）やギャンブルでの勝利がほとんどだが、それ以外にも人助けや自身との会話といったおねだりが発生する場合もある。また、おねだりは『3』まではメインストーリー中でも発生していたが、『4』以降はプレミアムアドベンチャーでのみの仕様となっている。"}],"source":"bangumi","sourceCharacterId":"33965"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f99a64248ba4873077f87981343d4961641aca99166b53038b900b2d2581e261.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/155d90c91d4ebcb8063bf5a9fc88553207c6f1cd43ac8cf9bc569bcf82426bc1.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"釘宮理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155364:33965:3936:1","source":"bangumi"}]},{"characterId":"char_bangumi_39124","characterName":"真島吾朗","sourceIds":{"bangumi":[{"characterId":"39124","match":"source-roster","subjectId":"155364"}]},"originalCharacterName":"真島吾朗","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"186"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"80"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「嶋野の狂犬」と呼ばれるヤクザ。"},{"spoiler":false,"text":"服装は素肌に直接羽織った蛇柄のジャケットと左目の眼帯（『3』以降は蛇のマークがついたもの）がトレードマークで、『2』では黄色のドカヘルも特徴的となっており、この服装以外にも『3』以降は幹部という立場から黒のスーツに赤シャツに黒ネクタイ、若き日の『0』ではキャバレー支配人という立場からタキシードを着用していた。体に白蛇や桜、般若をあしらった五分袖の額彫りの刺青を入れている。"}],"source":"bangumi","sourceCharacterId":"39124"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bb9ad21a78560eb5fe2aca5609dacf3b09a37cddfc4c51fc4bc7f8a77966c61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a53e02d8421dcb6acc31d370bffb55408102292037862e3a39fc98615569851a.webp","width":184,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_60391","characterName":"にしきやま あきら","sourceIds":{"bangumi":[{"characterId":"60391","match":"source-roster","subjectId":"155364"}]},"originalCharacterName":"にしきやま あきら","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桐生一馬と共に養護施設『ヒマワリ』で育つ。"},{"spoiler":false,"text":"恩人である風間新太郎の背中を追い、堂島組の盃を受ける。"},{"spoiler":false,"text":"幼い頃からの桐生一馬の親友であり、極道では兄弟分にあたる。"},{"spoiler":false,"text":"桐生一馬とは対照的な性格で、極道として器用に立ち回れるだけの才覚、"},{"spoiler":false,"text":"そして組織内でのし上がりたいと、より上の地位を目指したい考えを持っている。"},{"spoiler":false,"text":"そのため、出世に興味のない桐生一馬には物足りさなを覚えている。"},{"spoiler":false,"text":"また、その一方で、病気がちの妹に対して常に気にかけている一面を持つ。"}],"source":"bangumi","sourceCharacterId":"60391"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09a06bee33a8a0b3e143cbd901ffe1ec896e6b3827143b78a61c5c5379d5f4f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a734ae7e0b4fa7ec23873da01b7d31fe19fae962ba1a42beff925a9ce328db7a.webp","width":151,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_60392","characterName":"かざま しんたろう","sourceIds":{"bangumi":[{"characterId":"60392","match":"source-roster","subjectId":"155364"}]},"originalCharacterName":"かざま しんたろう","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"177"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"東城会最強と言われるまでに堂島組を支えてきた重要な中心人物であり、"},{"spoiler":false,"text":"実力と人物を兼ね備えた別格の極道。"},{"spoiler":false,"text":"一方で個人的に養護施設『ヒマワリ』を設立し、身寄りのない子を支援している。"},{"spoiler":false,"text":"そこで育った桐生一馬と錦山彰にとって風間新太郎は本当の親も同然であり、憧れの存在でもある。"},{"spoiler":false,"text":"半年前に風間組で賭博を開いた際に警察に見つかって以来、現状は刑務所に入れられている。"},{"spoiler":false,"text":"そのわずかな隙を見つけて堂島組若頭補佐の三人衆（久瀬大作、阿波野大樹、渋澤啓司）に、"},{"spoiler":false,"text":"風間新太郎の堂島組若頭の地位を狙われている。"}],"source":"bangumi","sourceCharacterId":"60392"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e80cd84f578c1606a8c92cd02cc3127e541e1b7b2b44b127452e5b7b3b87959.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/740fa5ff923e3d65fad3c5d878ecb2ff17911a701981bc806951d287818da852.webp","width":148,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:628","sourceCompanyId":"egs:brand:628","canonicalEntityId":"egs:brand:628","name":"SEGA(セガゲームス)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:30224:628","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
