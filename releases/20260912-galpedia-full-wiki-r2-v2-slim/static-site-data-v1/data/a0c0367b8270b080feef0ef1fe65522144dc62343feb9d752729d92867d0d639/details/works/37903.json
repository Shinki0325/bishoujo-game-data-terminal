native","relationId":"vndb:vn-staff:212015","source":"vndb"},{"creditedName":"蒼瀬","creatorId":"vndb:s9849","sourcePersonId":"vndb:s9849","canonicalEntityId":"vndb:s9849","name":"蒼瀬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:212017","source":"vndb"},{"creditedName":"rapiecage","creatorId":"vndb:s16605","sourcePersonId":"vndb:s16605","canonicalEntityId":"vndb:s16605","name":"rapiecage","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:212018","source":"vndb"},{"creditedName":"KIT","creatorId":"vndb:s17303","sourcePersonId":"vndb:s17303","canonicalEntityId":"vndb:s17303","name":"KIT","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:212019","source":"vndb"},{"creditedName":"望月 侑","creatorId":"vndb:s17887","sourcePersonId":"vndb:s17887","canonicalEntityId":"vndb:s17887","name":"望月侑","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:212020","source":"vndb"},{"creditedName":"薄迷","creatorId":"vndb:s23592","sourcePersonId":"vndb:s23592","canonicalEntityId":"vndb:s23592","name":"薄迷","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:212023","source":"vndb"},{"creditedName":"アーサー石井","creatorId":"vndb:s24218","sourcePersonId":"vndb:s24218","canonicalEntityId":"vndb:s24218","name":"アーサー石井","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:212024","source":"vndb"},{"creditedName":"あおいあいう","creatorId":"vndb:s30329","sourcePersonId":"vndb:s30329","canonicalEntityId":"vndb:s30329","name":"葵藍兎(あおいあいう)","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:212025","source":"vndb"},{"creditedName":"たかしな 浅妃","creatorId":"vndb:s46076","sourcePersonId":"vndb:s46076","canonicalEntityId":"vndb:s46076","name":"たかしな 浅妃","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:212027","source":"vndb"}]},"cast":[{"characterId":"char_c148812","characterName":"川倉 黎一","sourceIds":{"bangumi":[{"characterId":"170947","match":"exact-normalized-name-in-linked-work","subjectId":"523497"}],"egsCharacterIds":["27560"],"vndbCharacterId":"c148812"},"originalCharacterName":"川倉 黎一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"67"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A college student attending university in the city."},{"spoiler":false,"text":"As a kid, he was shipped off to his grandfather's place in Shinju Town while his parents focused on their careers. Years later, following his grandfather's passing and a cryptic final request, he returns to the now-ghost town after a seven-year absence."},{"spoiler":false,"text":"The old man raised him to be a man of his word, and Reiichi takes this lesson to heart - if he makes a promise, you can bet he'll move heaven and earth to keep it. His friends constantly roll their eyes at his \"boy scout personality\" that always seems to land him in hot water."},{"spoiler":false,"text":"When Shinju Town traps him in its supernatural nightmare and an entity called \"Shinju\" demands he assault and impregnate Haruna and other women, Reiichi refuses to surrender his principles. Instead, he fights against these dark forces, determined to escape this twisted realm and return to reality with both his companions and his moral compass intact."},{"spoiler":false,"text":"\"No matter what truth we might uncover, the time we spent together in Shinju Town and the memories we made there—those can never be erased.\""}],"source":"vndb","sourceCharacterId":"c148812"},{"segments":[{"spoiler":false,"text":"本作の主人公。都会の大学に通う大学生。"},{"spoiler":false,"text":"子供のころ両親の仕事の都合で祖父に預けられ、一時期心珠町で暮らしていたことがあった。"},{"spoiler":false,"text":"祖父の死と遺言をきっかけに、現在は廃村となっている心珠町へと７年ぶりに足を踏み入れる。"},{"spoiler":false,"text":"祖父から受けた『約束を大切にするように』という教えを大事にしており、たとえ口約束でも約束したことは可能な限り守ろうとする。"},{"spoiler":false,"text":"親しい友人からは「誠実だがとにかく損の多い性格」と呆れられることも。"},{"spoiler":false,"text":"閉ざされた異界と化した心珠町で、シンジュから陽渚たちを犯して孕ませろと要求されるが、自分たちを捕らえようとする力に抗い元の世界に戻るために行動していく。"}],"source":"egs","sourceCharacterId":"27560","sourceWorkId":"37903","spoiler":false},{"segments":[{"spoiler":false,"text":"「たとえどんな真実があったとしても、"},{"spoiler":false,"text":"俺たちが心珠町で過ごした時間と思い出は消えたりしないよ」"},{"spoiler":false,"text":"本作の主人公。都会の大学に通う大学生。"},{"spoiler":false,"text":"子供のころ両親の仕事の都合で祖父に預けられ、一時期心珠町で暮らしていたことがあった。"},{"spoiler":false,"text":"祖父の死と遺言をきっかけに、現在は廃村となっている心珠町へと７年ぶりに足を踏み入れる。"},{"spoiler":false,"text":"祖父から受けた『約束を大切にするように』という教えを大事にしており、 たとえ口約束でも約束したことは可能な限り守ろうとする。"},{"spoiler":false,"text":"親しい友人からは「誠実だがとにかく損の多い性格」と呆れられることも。"},{"spoiler":false,"text":"閉ざされた異界と化した心珠町で、シンジュから陽渚たちを犯して孕ませろと要求されるが、 自分たちを捕らえようとする力に抗い元の世界に戻るために行動していく。"}],"source":"bangumi","sourceCharacterId":"170947"}],"profileFacts":[{"label":"身高（本版本）","value":"176 cm","valueContext":null,"source":"egs","sourceCharacterId":"27560","sourceWorkId":"37903","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"67 kg","valueContext":null,"source":"egs","sourceCharacterId":"27560","sourceWorkId":"37903","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c077820f321ea6327696ac8eb4c202dad5826b63e95e53adef0ba66fdb31397.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f763f17c3da85970c83e0cfecea5c0f3e35dedfb27fff7ccc5d9fb863cf8fa2.webp","width":95,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c148813","characterName":"シンジュ","sourceIds":{"bangumi":[],"egsCharacterIds":["27555"],"vndbCharacterId":"c148813"},"originalCharacterName":"シンジュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl identical to Haruna, who calls herself the “Miko of Ohako-sama”"},{"spoiler":false,"text":"A mystery girl who emerges from Shinju Town's ruins to confront Reiichi."},{"spoiler":false,"text":"Mirror image of Haruna save for hair and eyes, she speaks as if she's known him forever."},{"spoiler":false,"text":"She corners the trapped Reiichi with a chilling demand - procreate with Haruna and the others. But there's more to her game..."},{"spoiler":false,"text":"Shinju ensnares Reiichi with dark allure and mind-reader's insight, yet breaks character with jarring moments of childish behavior."},{"spoiler":false,"text":"Her paradox: ruthlessly pushing Reiichi to violate Haruna and the others, while her own heart burns with barely hidden jealousy."},{"spoiler":false,"text":"\"Truth means nothing now. No one can ever leave this town.\""},{"spoiler":false,"text":"Translated and edited from the official site"}],"source":"vndb","sourceCharacterId":"c148813"},{"segments":[{"spoiler":false,"text":"黎一が廃墟の心珠町で遭遇する、謎めいた少女。"},{"spoiler":false,"text":"髪と目の色を除いて陽渚とそっくりで、黎一のことを昔から知っているように振る舞う。"},{"spoiler":false,"text":"町に閉じ込められた黎一の前に現われ、陽渚たちとの子作りを要求してくるが……。"},{"spoiler":false,"text":"陰を感じる大人びた色香と、まるで心を読めるかのような言動で黎一を翻弄するが、時折妙に幼い振る舞いを見せるなどアンバランスな所がある。"},{"spoiler":false,"text":"黎一に陽渚たちを犯すよう非情に迫る一方で、彼女らに嫉妬するような矛盾した一面も。"}],"source":"egs","sourceCharacterId":"27555","sourceWorkId":"37903","spoiler":false}],"profileFacts":[{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"27555","sourceWorkId":"37903","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"27555","sourceWorkId":"37903","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e0c9ae09d5b3da9b996255f0ec879eaf987505d7372b71796f8f7608b345c5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e713e09f54558cedd4e7413852b3e9b8f7a6610ef6df12f93443ce7c7cfccc1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杏 花","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99372","source":"vndb"}]},{"characterId":"char_c148815","characterName":"龍ヶ燈 やちよ","sourceIds":{"bangumi":[{"characterId":"170944","match":"exact-normalized-name-in-linked-work","subjectId":"523497"}],"egsCharacterIds":["27557"],"vndbCharacterId":"c148815"},"originalCharacterName":"龍ヶ燈 やちよ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Mysterious Girl with Many Secrets, Met in the abandoned town"},{"spoiler":false,"text":"A strange girl Reiichi encounters in the abandoned Shinjumachi."},{"spoiler":false,"text":"She appears before Reiichi and the others amidst the town's strange occurrences, revealing that they are trapped in a “kauriyo” (realm of the dead) and that to return to their original world, they must find the town's deity “Ohako-sama”."},{"spoiler":false,"text":"She claims to come from a special family and was sent to Shinjumachi under specific instructions, but..."},{"spoiler":false,"text":"Her dignified presence and blunt way of speaking often make her seem cold and unapproachable, but glimpses of her seriousness, politeness, and deep compassion can be seen in her actions."},{"spoiler":false,"text":"\"This is a “kakuriyo”—a place that exist nowhere, born between the realms of the living and the eternal. Me and you all have been lured into this world and are now its captives.\""}],"source":"vndb","sourceCharacterId":"c148815"},{"segments":[{"spoiler":false,"text":"黎一が廃墟の心珠町で出会う、見知らぬ少女。"},{"spoiler":false,"text":"町の異変とともに黎一たちの前に現われ、自分たちが“幽世”という世界に囚われており、元の世界に帰るには町の神である『オハコ様』を見つけなければいけないと告げる。"},{"spoiler":false,"text":"特別な家の出で、心珠町に来たのもその指示だと言うが……。"},{"spoiler":false,"text":"凜とした雰囲気と端的な物言いで、冷たく近寄りがたい印象を持たれがちだが、行動の端々に真面目さや礼儀正しさ、情の深さが見て取れる。"}],"source":"egs","sourceCharacterId":"27557","sourceWorkId":"37903","spoiler":false},{"segments":[{"spoiler":false,"text":"「ここは“幽世”。“現世”と“常世”の狭間に生まれたどこでもない場所。"},{"spoiler":false,"text":"私も、貴方たちも、この世界に誘われ囚われてしまったのです」"},{"spoiler":false,"text":"黎一が廃墟の心珠町で出会う、見知らぬ少女。"},{"spoiler":false,"text":"町の異変とともに黎一たちの前に現われ、自分たちが“幽世”という世界に囚われており、 元の世界に帰るには町の神である『オハコ様』を見つけなければいけないと告げる。"},{"spoiler":false,"text":"特別な家の出で、心珠町に来たのもその指示だと言うが……。"},{"spoiler":false,"text":"凜とした雰囲気と端的な物言いで、冷たく近寄りがたい印象を持たれがちだが、 行動の端々に真面目さや礼儀正しさ、情の深さが見て取れる。"}],"source":"bangumi","sourceCharacterId":"170944"}],"profileFacts":[{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"27557","sourceWorkId":"37903","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"27557","sourceWorkId":"37903","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21145badf258982428315711c788678b01e1d84a7c4d25217a04db9f26dddaec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40387db3caa1a7735a6cf787dc2118529fd28a17496d5507545388239bae98c6.webp","width":95,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花月さや","creatorId":"vndb:s23345","sourcePersonId":"vndb:s23345","canonicalEntityId":"vndb:s23345","name":"花月さや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:523497:170944:40638:1","source":"bangumi"}]},{"characterId":"char_c148817","characterName":"都築 七々瀬","sourceIds":{"bangumi":[{"characterId":"170946","match":"exact-normalized-name-in-linked-work","subjectId":"523497"}],"egsCharacterIds":["27559"],"vndbCharacterId":"c148817"},"originalCharacterName":"都築 七々瀬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A University Classmate and Reiichi’s bad influence"},{"spoiler":false,"text":"A college girl who shares Reiichi's seminar and currently ranks as his closest female friend."},{"spoiler":false,"text":"Wickedly smart, refreshingly down-to-earth, and blessed with the gift of never making things awkward—well, almost never—she's the friend everyone wants until her curiosity kicks in. She voices what everyone's thinking but won't say and takes artistic pleasure in pushing her friends' buttons, yet despite these social gifts, her inner circle consists of exactly one person: Reiichi."},{"spoiler":false,"text":"As he puts it: \"Look, I respect her and she's undeniably gorgeous, but peel back the layers and you'll find someone delightfully unhinged.\""},{"spoiler":false,"text":"When Reiichi ghosted everyone with nothing but \"heading to Shinju Town,\" her suspicion radar went haywire, so naturally she did what any good bad influence would do—followed him straight into the supernatural rabbit hole waiting there."},{"spoiler":false,"text":"\"If there's a box in front of you, it's only human nature to want to crack it open and peek inside\""}],"source":"vndb","sourceCharacterId":"c148817"},{"segments":[{"spoiler":false,"text":"黎一と同じ大学に通う女子大生。"},{"spoiler":false,"text":"所属しているゼミも同じで、黎一にとって現在最も付き合いの濃い異性の友人。"},{"spoiler":false,"text":"ノリ良く気さくで聡明な、友人として付き合いやすい性格。"},{"spoiler":false,"text":"ただ、強い知的好奇心から時々無遠慮な言動があるのと、親しい友人をからかうのが好きという悪癖を持ち、現状、黎一を除く特定の人間と仲良くしている様子はない。"},{"spoiler":false,"text":"黎一は「友人として尊敬しているし美人だとは思うが、中身を知るほどクセの強い女」と評している。"},{"spoiler":false,"text":"心珠町に行くと言って連絡を絶った黎一を不審に思い、自らも町に足を運んだことから異常に巻き込まれてしまう。"}],"source":"egs","sourceCharacterId":"27559","sourceWorkId":"37903","spoiler":false},{"segments":[{"spoiler":false,"text":"「そこに箱があれば、開いて中を確かめたくなるのが"},{"spoiler":false,"text":"人情というものよ」"},{"spoiler":false,"text":"黎一と同じ大学に通う女子大生。"},{"spoiler":false,"text":"所属しているゼミも同じで、黎一にとって現在最も付き合いの濃い異性の友人。"},{"spoiler":false,"text":"ノリ良く気さくで聡明な、友人として付き合いやすい性格。"},{"spoiler":false,"text":"ただ、強い知的好奇心から時々無遠慮な言動があるのと、親しい友人をからかうのが好きという悪癖を持ち、 現状、黎一を除く特定の人間と仲良くしている様子はない。"},{"spoiler":false,"text":"黎一は「友人として尊敬しているし美人だとは思うが、中身を知るほどクセの強い女」と評している。"},{"spoiler":false,"text":"心珠町に行くと言って連絡を絶った黎一を不審に思い、 自らも町に足を運んだことから異常に巻き込まれてしまう。"}],"source":"bangumi","sourceCharacterId":"170946"}],"profileFacts":[{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"27559","sourceWorkId":"37903","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"27559","sourceWorkId":"37903","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8eaeff9292ab1ae30f7ff50dd7d5e1eb2eea967f91a9da5a041724ef6161e080.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80921e45a9f252d0f61b8de15cdca655c6eddcc279d09de1579be42d8a8ae79a.webp","width":95,"height":256,"source":"static-detail"},"actors":[{"creditedName":"冬宮あずき","creatorId":"egs:creator:34636","sourcePersonId":"egs:creator:34636","canonicalEntityId":"egs:creator:34636","name":"奏カスカ(冬宮あずき、卯衣天ぺん)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:523497:170946:37731:1","source":"bangumi"},{"creditedName":"奏 カスカ","creatorId":"vndb:s42712","sourcePersonId":"vndb:s42712","canonicalEntityId":"vndb:s42712","name":"奏 カスカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99378","source":"vndb"}]},{"characterId":"char_vndb_c148814","characterName":"御汐 陽渚","sourceIds":{"vndbCharacterId":"c148814"},"originalCharacterName":"御汐 陽渚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Childhood Friend, Like a Little Sister—Reunited After Seven Long Years"},{"spoiler":false,"text":"Amid the crumbling remains of Shinju Town, Reiichi crosses paths again with his childhood friend, Mishio Haruna—the sole daughter of the family that once watched over the beloved Mishio Shrine. Seven years earlier, tragedy struck, claiming her father's life and forcing Haruna and her mother to leave it all behind."},{"spoiler":false,"text":"But Haruna never let misfortune dampen her spirit—she wears her heart on her sleeve, always quick to lend an ear and offer genuine comfort. Though she can be a bit scatterbrained or overly trusting at times, she's razor-sharp when it counts, with a backbone stronger than most."},{"spoiler":false,"text":"Growing up as the shrine keeper's daughter, Haruna had always been put on a pedestal, kept at arm's length by everyone else. Reiichi broke the ice, drawing her out and brightening her world. Her gratitude blossomed into affection, and soon enough, she found herself quietly head over heels for him."},{"spoiler":false,"text":"Now, back in town after all these years, Reiichi is thrown for a loop when he meets a mysterious girl named Shinju—who’s the spitting image of Haruna herself..."},{"spoiler":false,"text":"\"I believe in you. The Reiichi I know would never go back on his word.\""}],"source":"vndb","sourceCharacterId":"c148814"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7b4c2ed0c2bbbbb6f3fc71ff81f9b1afb985e38f265cb54334fcf0d98d2cef9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e08febef7829a10b704d7e28282396ef110cf9ed4bb876b2d6b9c47987b66f5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉 もも花","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99371","source":"vndb"}]},{"characterId":"char_vndb_c148816","characterName":"新沼 鈴","sourceIds":{"vndbCharacterId":"c148816"},"originalCharacterName":"新沼 鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Cheerful and Energetic Childhood Friend, Reunited After Seven Years"},{"spoiler":false,"text":"Another childhood friend Reiichi reunites with in the ruins of Shinjumachi."},{"spoiler":false,"text":"She’s one year younger than Haruna, and after the disaster seven years ago, her family left the town, cutting off all contact with both Reiichi and Haruna since then."},{"spoiler":false,"text":"She’s the same as ever—an upbeat, energetic mood-maker and a hard worker."},{"spoiler":false,"text":"Even in the now otherworldly Shinjumachi, she doesn’t let fear get the best of her and keeps Reiichi and the others motivated with her natural positivity."},{"spoiler":false,"text":"She's a sociable girl with many friends, always in tune with the latest trends, but surprisingly, she’s a bit of a grandma’s girl, well-versed in old games and folktales."},{"spoiler":false,"text":"Back when she lived in Shinjumachi, there weren’t many other kids around,"},{"spoiler":false,"text":"so she often tagged along with Reiichi and Haruna when they played."},{"spoiler":false,"text":"It seems she happened to run into Haruna just as she was heading back to Shinjumachi and insisted on coming along… ?"},{"spoiler":false,"text":"\"Mmm~! This feels like we’ve gone back in time, I’m so happy!\""}],"source":"vndb","sourceCharacterId":"c148816"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fa0a6b0f6d17ddffe2a63c843c088b2baba6bf4dfe3ed2b08190c198cece393.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02c43a8bd8dbbc57884091e646f846145cd296eca4f5aae561252ed1cb40a8e0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒瀬 アイル","creatorId":"vndb:s40974","sourcePersonId":"vndb:s40974","canonicalEntityId":"vndb:s40974","name":"黒瀬アイル","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99377","source":"vndb"}]},{"characterId":"char_vndb_c165455","characterName":"はるな","sourceIds":{"vndbCharacterId":"c165455"},"originalCharacterName":"はるな","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mishio Haruna from Shinju Town era"}],"source":"vndb","sourceCharacterId":"c165455"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2aa8363dabdd94e61c5f06d1a5e45d48e6d4dd00367f93a85858788711ed698e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0ddfef698f72a2c2b75ac29d42b87781a9b5c8c24a2c9ee13148e56295276dc.webp","width":226,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉下 撫子","creatorId":"vndb:s18213","sourcePersonId":"vndb:s18213","canonicalEntityId":"vndb:s18213","name":"倉下 撫子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99374","source":"vndb"}]},{"characterId":"char_vndb_c165456","characterName":"すず","sourceIds":{"vndbCharacterId":"c165456"},"originalCharacterName":"すず","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Niinuma Suzu from Shinju Town era"}],"source":"vndb","sourceCharacterId":"c165456"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd3e2d7445e2ee86e2fcf5b799124fbc236a7257ef7bac5dc4612619db2c5b64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdd2d45259a77b45236d4b24d541247407d3e3d62cc6abaa106a2ec578cba75a.webp","width":226,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅宮 ここ","creatorId":"vndb:s8768","sourcePersonId":"vndb:s8768","canonicalEntityId":"vndb:s8768","name":"梅宮 ここ","roleCode":"voice-a