{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20545","model":{"presentationWorkId":"egs:20545","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"左","creatorId":"vndb:s6653","sourcePersonId":"egs:creator:1124","canonicalEntityId":"vndb:s6653","name":"左","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:132358","source":"egs"},{"creditedName":"霜月はるか","creatorId":"vndb:s22","sourcePersonId":"egs:creator:3290","canonicalEntityId":"vndb:s22","name":"霜月はるか","detail":"イベントバトルテーマ「崇めよ、我は神鬼」、アバンタイトルテーマ「あめつちのことわり」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:269066","source":"egs"},{"creditedName":"いとうかなこ","creatorId":"vndb:s226","sourcePersonId":"egs:creator:12669","canonicalEntityId":"vndb:s226","name":"いとうかなこ","detail":"インフィニティーバトルテーマ「Sky of Twilight」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:269067","source":"egs"}]},"cast":[{"characterId":"char_bangumi_23960","characterName":"艾斯卡·玫莉耶","sourceIds":{"bangumi":[{"characterId":"23960","match":"source-roster","subjectId":"158006"},{"characterId":"23960","match":"source-roster","subjectId":"249447"},{"characterId":"23960","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"艾斯卡·玫莉耶","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A15　　15歳"},{"spoiler":false,"text":"黄昏の空に夢を追い続ける少女"},{"spoiler":false,"text":"業績の悪い落ちこぼれの開発班に引き入れられた、新人役人。"},{"spoiler":false,"text":"人々の役に立ちたい一心で支部の手伝いをしていたところ、役人として正式に採用された。"},{"spoiler":false,"text":"錬金術の腕は、小さい頃に母親から教わってからは独学だったため、まだまだ初心者も同然。"},{"spoiler":false,"text":"一族秘伝の古い様式の錬金術しか知らないが、自分の錬金術で人々が幸せになってくれればと願い、仕事に役立てようと努力する。"},{"spoiler":false,"text":"A16　　21歳"},{"spoiler":false,"text":"立派に成長した、食いしん坊錬金術士"},{"spoiler":false,"text":"ステラードの調査を進めるため、ソールがコルセイトから呼び寄せた錬金術士。"},{"spoiler":false,"text":"古式の錬金術が得意だが、なぜか食べ物関係の調合が多い。"},{"spoiler":false,"text":"行動力があり、奇想天外な発想で錬金術を活用（悪用？）してさまざまなことにチャレンジするものの、結果的に騒動を巻き起こしてしまうトラブルメーカーでもある。"}],"source":"bangumi","sourceCharacterId":"23960"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23960","value":"开发班的新手职员(A15)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23960","value":"派遣职员(A16)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d910ca7e9de0c10cc98ac0c40f30a9d90a85a64859a40ae8d7eefae2ba669b96.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f00b56e6f14a1c060c0a4a8ad65160838443f854645d62869459a0916c4ed798.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"村川梨衣","creatorId":"vndb:s7858","sourcePersonId":"vndb:s7858","canonicalEntityId":"vndb:s7858","name":"村川梨衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:23960:9096:1","source":"bangumi"}]},{"characterId":"char_bangumi_23961","characterName":"洛基库斯·菲克萨里奥","sourceIds":{"bangumi":[{"characterId":"23961","match":"source-roster","subjectId":"158006"},{"characterId":"23961","match":"source-roster","subjectId":"249447"},{"characterId":"23961","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"洛基库斯·菲克萨里奥","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"173"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A15　　18歳"},{"spoiler":false,"text":"見果てぬ夢を黄昏の空に願う少年"},{"spoiler":false,"text":"中央から派遣されて街へやってきた若い役人。"},{"spoiler":false,"text":"剣術と錬金術と組み合わせることで扱える、最新式の錬金術を駆使する錬金術士だが、とある事情で落ちこぼれの開発班へ配属させられる。"},{"spoiler":false,"text":"中央で最新の錬金術の技術を学んできたため、古いタイプの錬金術についてはあまり詳しくない。"},{"spoiler":false,"text":"A16　　24歳"},{"spoiler":false,"text":"”黄昏”の終わりへの希望を携える錬金術士"},{"spoiler":false,"text":"辺境の街コルセイトで、開発班の役人として務めていた若き錬金術士。剣術と錬金術を組み合わせた、「錬金剣」を扱うことができる。"},{"spoiler":false,"text":"「東の大陸が大変興味深いので要調査」という中央からの指令を受け、その思惑を図りかねるなか、ステラードにやってきた。"},{"spoiler":false,"text":"いつも目が離せない、よく知る彼女のいる街へーー"}],"source":"bangumi","sourceCharacterId":"23961"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23961","value":"中央的炼金术士(A15)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23961","value":"柯尔先特的职员(A16)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09e48d67055dd39f55d424f815e75b463a9d27133891ef980a3fbfd7f7612405.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5847c2dde724cdb4d394039251b423137591b2e1d130508261471e8594a0ec78.webp","width":173,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川界人","creatorId":"vndb:s4435","sourcePersonId":"vndb:s4435","canonicalEntityId":"vndb:s4435","name":"石川 界人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:23961:9953:1","source":"bangumi"}]},{"characterId":"char_bangumi_23962","characterName":"Wilbell Voll-Ersleid","sourceIds":{"bangumi":[{"characterId":"23962","match":"source-roster","subjectId":"158006"},{"characterId":"23962","match":"source-roster","subjectId":"37563"},{"characterId":"23962","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Wilbell Voll-Ersleid","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　14歳"},{"spoiler":false,"text":"未来の大魔法使いを目指す女の子"},{"spoiler":false,"text":"魔法使いの一族に生まれた女の子。大婆様のような偉大な魔法使いを目指すため魔法の修行を続けている。元気で活発な性格だが色々な知識があるせいか多少尊大になることも。"},{"spoiler":false,"text":"ちゃっかりしておりアーシャに修行の手伝いをさせたりもするがその豊富な知識と魔法でアーシャに助言をすることもある。"},{"spoiler":false,"text":"A15　　18歳"},{"spoiler":false,"text":"修行中の大魔法使い見習い"},{"spoiler":false,"text":"辺境から辺境へと渡り歩き、武者修行を続けている魔法使いの少女。"},{"spoiler":false,"text":"以前に友人たちの協力を経て風の精霊と契約を結んでからは、世界の様々な精霊に逢うことを修行の目的として放浪している。"},{"spoiler":false,"text":"魔法使いとしての素養は非常に高く、その若さに見合わない高い能力を持っている。"},{"spoiler":false,"text":"A16　　24歳"},{"spoiler":false,"text":"大きな試練に直面する、偉大なる魔法使い"},{"spoiler":false,"text":"各地の精霊と契約する修業中の魔法使い。"},{"spoiler":false,"text":"これまで契約した精霊の力を借りて、強力な魔法を行使できる。"},{"spoiler":false,"text":"偶然助けたシャルロッテに錬金術士と間違われ、憧れの対象となったことからシャルロッテのよき師匠になる。"},{"spoiler":false,"text":"年齢に見合わない幼い外見をしており、「大人になる」手がかりを求めている。"},{"spoiler":false,"text":"面倒くさがりでちゃっかりしているところは相変わらずだが、自分の子供っぽさにコンプレックスを抱いている。"},{"spoiler":false,"text":"そのため、無理に大人振ろうとして厄介ごとを招くこともしばしば。"}],"source":"bangumi","sourceCharacterId":"23962"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23962","value":"旅行的魔法师(A16)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23962","value":"魔法师(A14/A15)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90a9d58ba27701320c1028ea8bea6278a13fb61066dbddadd720774b9e299546.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f5e7655a562de786adc5fbabaef3708acecee7e6ad7a7392b7663bfa507e399.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬戸麻沙美","creatorId":"vndb:s1433","sourcePersonId":"vndb:s1433","canonicalEntityId":"vndb:s1433","name":"瀬戸 麻沙美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:23962:5766:1","source":"bangumi"}]},{"characterId":"char_bangumi_23963","characterName":"Linca","sourceIds":{"bangumi":[{"characterId":"23963","match":"source-roster","subjectId":"37563"},{"characterId":"23963","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Linca","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　20歳"},{"spoiler":false,"text":"純粋すぎる、美しき護衛乙女"},{"spoiler":false,"text":"幼少より戦闘の訓練を受けて育った、護衛のスペシャリスト。華奢な体格からは想像できない戦闘技術を誇るが一般教養、生活能力は皆無でマリオンに心配されている。"},{"spoiler":false,"text":"とても純粋で忠義心も厚くマリオンの護衛を務めている。反面、勝負に対するこだわりが強く友達が出来ないことを気にしている。"},{"spoiler":false,"text":"A15　　24歳"},{"spoiler":false,"text":"悩み多き、武闘派の天然剣士"},{"spoiler":false,"text":"班長補佐としてマリオンを支え続ける、戦闘のスペシャリスト。"},{"spoiler":false,"text":"多くの出張先で磨かれた剣の腕は一流だが、純粋で素直な性格ゆえに勘違いも多く、それが原因でトラブルを引き起こしてしまうこともしばしば。"},{"spoiler":false,"text":"エスカたちという部下を初めて持つが、分からないなりに上司として振る舞おうと努力する。"}],"source":"bangumi","sourceCharacterId":"23963"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23963","value":"开发班的副班长(A15)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23963","value":"护卫(A14)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62840be3c4f07b21d21e5092abcbac53119e4c727a674329ad72909df4ccd492.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b1b7f4a77d18a5c05f28abdeb1f4c847e3bd930125ea66921b2ade713651c46.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:23963:4474:1","source":"bangumi"}]},{"characterId":"char_bangumi_23964","characterName":"Marion Quin","sourceIds":{"bangumi":[{"characterId":"23964","match":"source-roster","subjectId":"37563"},{"characterId":"23964","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Marion Quin","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"150"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　22歳"},{"spoiler":false,"text":"小さな体に大きなガッツを秘めた駐在員"},{"spoiler":false,"text":"はるか遠方よりリンカと共に派遣されてきた調査員。"},{"spoiler":false,"text":"この地方の遺跡と資源の調査が主な任務となっている。"},{"spoiler":false,"text":"上司からの無理難題がくると文句を言いつつも遂行するスゴ腕の調査員で、アーシャの事情を知ると立場を顧みず協力を申し出る優しさも兼ね備えるスーパーキャリアウーマン。"},{"spoiler":false,"text":"A15　　26歳"},{"spoiler":false,"text":"開発班の活動を支える、燃える中間管理職"},{"spoiler":false,"text":"辺境の地での任務を終え、中央に戻ってきた矢先に別の辺境の地へと飛ばされたベテラン役人。"},{"spoiler":false,"text":"前回の調査任務の功績が認められてついに昇格し、そこでコルセイト支部の「開発班」の班長として就任することになる。"},{"spoiler":false,"text":"しかし、人手不足の開発班はほとんど実績が上げられていなかったようで、赴任したときには既にマリオンと相棒のリンカしか残っていない状態になっていた。"}],"source":"bangumi","sourceCharacterId":"23964"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23964","value":"开发班的班长(A15)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23964","value":"来自远方的驻外官(A14)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c89bc85e5398683cda8fa31bd9cecb2148b7c6e6b62241ae383336feba27ce91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e828691c5a631e4ea1af46f871a8e318fc16a5ec593c418ecfd43f981e3477d.webp","width":162,"height":256,"source":"static-detail"},"actors":[{"creditedName":"植田佳奈","creatorId":"vndb:s17","sourcePersonId":"vndb:s17","canonicalEntityId":"vndb:s17","name":"植田 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:23964:4263:1","source":"bangumi"}]},{"characterId":"char_bangumi_23965","characterName":"Nio Altugle","sourceIds":{"bangumi":[{"characterId":"23965","match":"source-roster","subjectId":"37563"},{"characterId":"23965","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Nio Altugle","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　13歳"},{"spoiler":false,"text":"黄昏に消えた少女"},{"spoiler":false,"text":"アーシャの妹。数年前に、アトリエの近くの遺跡で行方不明となる。姉想いの妹で仲も良く、毎日のように薬の材料の採取を手伝っていた。行方不明になりアーシャ達の懸命な捜査にも関わらず、見つけることが出来なかった。"},{"spoiler":false,"text":"その後何の手がかりもなく時間だけが過ぎて行ったころに、ニオが消えたとされる遺跡でアーシャは再びニオと出会い、世界のどこかで生きていることが判明する。"},{"spoiler":false,"text":"A15　　15歳"},{"spoiler":false,"text":"黄昏を語り継ぐ少女"},{"spoiler":false,"text":"旅の途中で街に立ち寄り、そのままリンゴ園に下宿するようになった異国の薬士の少女。"},{"spoiler":false,"text":"コルセイトでは、エスカの家に居候させてもらっている。"},{"spoiler":false,"text":"とある事情でウィルベルの世話になっているが、あまりウィルベルの迷惑にならないようにと、生活費は自分で稼ぎ、ちゃんと自立しようとしているしっかり者。"},{"spoiler":false,"text":"見た目に合わず大人びていて博識であり、街に伝わる何かを調査しているらしい。"}],"source":"bangumi","sourceCharacterId":"23965"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23965","value":"帮忙做家务(A14)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23965","value":"旅行的药师(A15)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54c8aa2cd8bd977a964568c16928495282a00d2bbed6181c54fe9a0da906aed6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5efe784ba0a3e6278413e74e9e09ab859b635d513d8d0c101a6d23d7187e68f6.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊瀬茉莉也","creatorId":"vndb:s4898","sourcePersonId":"vndb:s4898","canonicalEntityId":"vndb:s4898","name":"伊瀬 茉莉也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:23965:4769:1","source":"bangumi"}]},{"characterId":"char_bangumi_23966","characterName":"Lucille Ernella","sourceIds":{"bangumi":[{"characterId":"23966","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Lucille Ernella","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"145"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"14歳"},{"spoiler":false,"text":"小さな身体で人々を病から救おうとする女の子"},{"spoiler":false,"text":"中央から新しく開発班に配属されることになる、エスカたちの後輩。"},{"spoiler":false,"text":"医術を勉強していたことがあったらしく、注射器などの先進的な医療の知識が豊富。"},{"spoiler":false,"text":"細かい雑用なども率先して引き受ける真面目な性格だが、それ以上に仕事をすることそのものを楽しんでいるようにも見受けられる。"}],"source":"bangumi","sourceCharacterId":"23966"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23966","value":"开发班的晚辈职员"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7974ba6e3842e206f02a303705779bc28e82a3654b100ef2262b49a9055228c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d83768a9a4e695a53c48d4fb09b6d5bc41c57d4320aff7404889bbf684c1349.webp","width":126,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本多真梨子","creatorId":"vndb:s5178","sourcePersonId":"vndb:s5178","canonicalEntityId":"vndb:s5178","name":"本多真梨子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:23966:5203:1","source":"bangumi"}]},{"characterId":"char_bangumi_23967","characterName":"Katla Larchica","sourceIds":{"bangumi":[{"characterId":"23967","match":"source-roster","subjectId":"158006"},{"characterId":"23967","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Katla Larchica","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A15　　12歳"},{"spoiler":false,"text":"寂れた雑貨屋のお騒がせ少女"},{"spoiler":false,"text":"市街地の自宅の前で露天商をしている、ちゃっかり者の若い娘。"},{"spoiler":false,"text":"たまたま客引きにかかったエスカたちと仲良くなる。"},{"spoiler":false,"text":"昔は両親が個人経営の雑貨屋を営んでいたが、経営に失敗して潰れてしまった。"},{"spoiler":false,"text":"商売の道を諦めてしまった両親に代わって、雑貨屋の復活を夢見ている。"},{"spoiler":false,"text":"A16　　18歳"},{"spoiler":false,"text":"儲け話に目がない、お騒がせな行商人"},{"spoiler":false,"text":"故郷で家族の店を復活させたのち、新たな行商の旅に出た雑貨屋。"},{"spoiler":false,"text":"大きな商売を成功させるため、さまざまな場所で拾った珍しい物を売りながら儲け話を探している。"},{"spoiler":false,"text":"しかし、傍目には何の役にも立ちそうにない怪しげな品が多いため、本当に売れているのかどうかは彼女だけが知っている。"}],"source":"bangumi","sourceCharacterId":"23967"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23967","value":"旅行杂货商人(A16)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23967","value":"杂货店店长(A15)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f3657c5687a760502a5a9012e8b530fd465aff14e2185bea061c90c734fc69b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aa344e00aab03a9019f78e1b3c419017b09043233a993bb972e92c9daf9ec79.webp","width":184,"height":256,"source":"static-detail"},"actors":[{"creditedName":"うのちひろ","creatorId":"egs:creator:21899","sourcePersonId":"egs:creator:21899","canonicalEntityId":"egs:creator:21899","name":"うのちひろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:23967:14258:1","source":"bangumi"}]},{"characterId":"char_bangumi_44485","characterName":"Harry Olson","sourceIds":{"bangumi":[{"characterId":"44485","match":"source-roster","subjectId":"158006"},{"characterId":"44485","match":"source-roster","subjectId":"37563"},{"characterId":"44485","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Harry Olson","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"175"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　36歳"},{"spoiler":false,"text":"街の有力者にして稀代の好事家"},{"spoiler":false,"text":"フィルツベルクの自治会に大きな影響力を持つ商会の現経営者。"},{"spoiler":false,"text":"前時代に対して多大なる興味と感心と収集癖を持つ。"},{"spoiler":false,"text":"様々な前時代に関するトンデモ知識を独学で学習しており、その内容は嘘か真か判断がつかないものばかりだが、湯水のように湧き出る言葉が彼の「特定の知識に関する」造詣の深さを物語る。"},{"spoiler":false,"text":"金銀財宝には目もくれず、前時代の遺物をはじめとして、普通の人には何の価値も無いガラクタばかりに傾倒して収集している。"},{"spoiler":false,"text":"性格は温厚で典型的なとっちゃん坊やだが、育ちの環境も手伝ってか基本的にどんな人に対しても好意的で、アーシャにも助言や手助けを申し出てくれる。"},{"spoiler":false,"text":"A15　　40歳"},{"spoiler":false,"text":"奇妙なものが大好きな、器の大きい冒険家"},{"spoiler":false,"text":"謎の自称冒険家、珍しい物好きで、様々な場所に出没する変わり者。"},{"spoiler":false,"text":"遠方で大きな商会を運営していたようだが、しっかり者の後任に預け、私財を注ぎ込んで「学術的探求の旅」に出ている。"},{"spoiler":false,"text":"しかし探検家としてはまだまだ素人であり、冒険の度にトラブルに逢うこともしばしば。"},{"spoiler":false,"text":"金銀財宝の類には興味がなく、誰の目にもガラクタとしか思えないものを集めている。"},{"spoiler":false,"text":"A16　　46歳"},{"spoiler":false,"text":"まだ見ぬ秘宝を追い求める、風変わりな冒険家"},{"spoiler":false,"text":"謎の自称冒険家。珍しい物好きで、様々な場所に出没する変わり者。"},{"spoiler":false,"text":"相棒のレイファーと共に、学術的探求のために世界各地を巡っていて、今は黄昏の海を中心に活動している。"},{"spoiler":false,"text":"交易投資家としても成功しており、最近はステラードとフィルツベルクを結ぶ交易ルートの設置にも注力しているらしい。"}],"source":"bangumi","sourceCharacterId":"44485"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"44485","value":"哈利商会经营者兼好事玩家(A14)"},{"label":"职业","source":"bangumi","sourceCharacterId":"44485","value":"自称能干的冒险家(A16)"},{"label":"职业","source":"bangumi","sourceCharacterId":"44485","value":"谜一般的冒险家(A15)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/148a85ae5dfc4853c35ee007fb011b072882221c14e43aae965333f23f6f82eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdd6bfe4f002d47e053b0010a3e8a793b95211f606e3221f023dbc67f4867541.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真殿光昭","creatorId":"vndb:s887","sourcePersonId":"vndb:s887","canonicalEntityId":"vndb:s887","name":"真殿 光昭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:44485:4313:1","source":"bangumi"}]},{"characterId":"char_bangumi_44489","characterName":"Awin Sidelet","sourceIds":{"bangumi":[{"characterId":"44489","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Awin Sidelet","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"175"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"20歳"},{"spoiler":false,"text":"面倒見のいい、兄代わりの気球整備士"},{"spoiler":false,"text":"整備班に勤めている気球整備士。"},{"spoiler":false,"text":"他にも馬車、公共施設などの整備も担当し、周囲の人間からの人望は厚い。"},{"spoiler":false,"text":"義理堅く気さくな性格で、挑戦することに対して意欲的。"},{"spoiler":false,"text":"エスカとは従兄弟同士で、昔からエスカには「お兄ちゃん」と呼ばれ慕われている。"},{"spoiler":false,"text":"機械的な技術についての知識が豊富で、様々な面で調査のアシストをしてくれる。"}],"source":"bangumi","sourceCharacterId":"44489"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"44489","value":"整备班的气球整备士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f70da07e5b2836733153f4bcf8b4e20c5829c2033919432dc44365ef87822e89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97c3f79873ab6f5f7e21e6624f5e672f92be5291f9b9675a4fd8e2c287c23bbd.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤羽根健治","creatorId":"vndb:s1381","sourcePersonId":"vndb:s1381","canonicalEntityId":"vndb:s1381","name":"赤羽根 健治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:69146:44489:5685:1","source":"bangumi"}]},{"characterId":"char_bangumi_44490","characterName":"Threia Hazelgrimm","sourceIds":{"bangumi":[{"characterId":"44490","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Threia Hazelgrimm","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"167"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"26歳"},{"spoiler":false,"text":"失われた過去に挑む歴史研究家"},{"spoiler":false,"text":"支部に協力している、遺跡の歴史などを調査している専門家。"},{"spoiler":false,"text":"かつて栄えていたとされる時代の遺物などを研究しているため、その頃に使用されていた錬金術の知識も多少はあるが、本人は錬金術士ではない。調査班から報告された資料を分析するだけの研究を嫌い、多少の危険もかえりみず独自にフィールドワークを行う活動的な女性。"}],"source":"bangumi","sourceCharacterId":"44490"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"44490","value":"历史研究家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29af876ea158ac42bd3c8fe6397aa9a91db339c8e703da107d81447aa7fc3670.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f94c98f77e4f8655914fcd44ee8a658c54d48e95f7c59cb8a03b01b6e812f51.webp","width":111,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_44491","characterName":"Reyfer Luckberry","sourceIds":{"bangumi":[{"characterId":"44491","match":"source-roster","subjectId":"158006"},{"characterId":"44491","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Reyfer Luckberry","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"178"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A15　　32歳"},{"spoiler":false,"text":"お宝を探して世界を巡るトレジャーハンター"},{"spoiler":false,"text":"宝を追い求めて黄昏の世界をさすらうトレジャーハンター。"},{"spoiler":false,"text":"道中で出会った遺跡探検家と意気投合し、旅を馴れていない友人をサポートしながら遺跡発掘をしている。"},{"spoiler":false,"text":"ロマン主義者であり、面白そうな事には何にでも首を突っ込む。"},{"spoiler":false,"text":"サバイバル技術に長けていて、危険に対して勘がよく働くため、これまでも数多くのピンチを乗り越えてきた。"},{"spoiler":false,"text":"A16　　38歳"},{"spoiler":false,"text":"ハリーと共にお宝を探す、腕利きのトレジャーハンター"},{"spoiler":false,"text":"宝を追い求めて黄昏の世界をさすらうトレジャーハンター。"},{"spoiler":false,"text":"ハリーと共に、大海賊の財宝を求めてこの地方にやってきた。"},{"spoiler":false,"text":"すでに一財を成している成功者でもあるが、ロマンを求めて旅を続けている。"}],"source":"bangumi","sourceCharacterId":"44491"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharact