70","source":"vndb"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"vndb:s720","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:57073","source":"vndb"}]},"cast":[{"characterId":"char_c29893","characterName":"朝陽","sourceIds":{"bangumi":[{"characterId":"168810","match":"exact-normalized-name-in-linked-work","subjectId":"265952"}],"egsCharacterIds":["11209"],"vndbCharacterId":"c29893"},"originalCharacterName":"朝陽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"陽之影山に住む本作のメインヒロイン。"},{"spoiler":false,"text":"空から空夜の上に降ってきた神様。"},{"spoiler":false,"text":"かつて日影町に日の光をもたらした偉大な神様の子孫で、古からの月山家との盟約に従って、人間の子供をその身に授かる役目を帯びている。"},{"spoiler":false,"text":"神様のくせに神々しいみたいな雰囲気は一切感じられない。"},{"spoiler":false,"text":"人間の、ただの背と胸が小さい生意気な小娘に見える。"},{"spoiler":false,"text":"本来ならば神々の中でも特に強大な神気を持ち、悪天候を一瞬にして晴天に変えるなど天候すら操れるくらいの実力がある、陽の姫神(ようのひめがみ)と呼ばれる者。"},{"spoiler":false,"text":"ただその力は幼いときにどこかで落としてしまったとは、本人の談。"},{"spoiler":false,"text":"しかし周りには信じて貰えず散々馬鹿にされ続けて育つ。親にも諦められる程。"},{"spoiler":false,"text":"そんな環境で育ったためか、高慢で意地っ張りな性格に。"},{"spoiler":false,"text":"幼い頃山を抜け出して下界にやってきては一緒に遊んでいた幼なじみの空夜、稲穂と再会する。"},{"spoiler":false,"text":"本当は、小さい頃結婚を誓い合った仲である空夜に久しぶりに会えて嬉しいはずなのに、素直になれず意地を張ってしまう。"}],"source":"egs","sourceCharacterId":"11209","sourceWorkId":"14414","spoiler":false},{"segments":[{"spoiler":false,"text":"陽之影山に住む本作のメインヒロイン。"},{"spoiler":false,"text":"空から空夜の上に降ってきた神様。"},{"spoiler":false,"text":"かつて日影町に日の光をもたらした偉大な神様の子孫で、古からの月山家との盟約に従って、人間の子供をその身に授かる役目を帯びている。"},{"spoiler":false,"text":"神様のくせに神々しいみたいな雰囲気は一切感じられない。"},{"spoiler":false,"text":"人間の、ただの背と胸が小さい生意気な小娘に見える。"},{"spoiler":false,"text":"本来ならば神々の中でも特に強大な神気を持ち、悪天候を一瞬にして晴天に変えるなど天候すら操れるくらいの実力がある、陽の姫神(ようのひめがみ)と呼ばれる者。"},{"spoiler":false,"text":"ただその力は幼いときにどこかで落としてしまったとは、本人の談。"},{"spoiler":false,"text":"しかし周りには信じて貰えず散々馬鹿にされ続けて育つ。親にも諦められる程。"},{"spoiler":false,"text":"そんな環境で育ったためか、高慢で意地っ張りな性格に。"},{"spoiler":false,"text":"幼い頃山を抜け出して下界にやってきては一緒に遊んでいた幼なじみの空夜、稲穂と再会する。"},{"spoiler":false,"text":"本当は、小さい頃結婚を誓い合った仲である空夜に久しぶりに会えて嬉しいはずなのに、素直になれず意地を張ってしまう。"}],"source":"bangumi","sourceCharacterId":"168810"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb15611232c205ae5a3ffb951c27dba7337e0692f70a5ba696608ad21607922d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3c615f16060732df75476b9281bcd8f5044205333c4eb42ee7159a9ffec599a.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮沢ゆあな","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265952:168810:5915:1","source":"bangumi"}]},{"characterId":"char_c29894","characterName":"櫛南 稲穂","sourceIds":{"bangumi":[{"characterId":"168812","match":"exact-normalized-name-in-linked-work","subjectId":"265952"}],"egsCharacterIds":["11210"],"vndbCharacterId":"c29894"},"originalCharacterName":"櫛南 稲穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"空夜と同じ陰陽学園に通う幼なじみなサブヒロイン。"},{"spoiler":false,"text":"成績優秀で運動が得意。活動的で活発、さばさばとした性格。"},{"spoiler":false,"text":"気配り上手で姉御肌なところもあるので、周りからは頼りにされる存在。性別を問わず友達も多い。"},{"spoiler":false,"text":"友達だけじゃなく、もちろん校内の男子達からはかなりの人気がある。"},{"spoiler":false,"text":"体操服で運動している姿には、みんなその肢体に視線が釘付けになるなど、スタイルも抜群。"},{"spoiler":false,"text":"空夜に一途で、小さい頃からずっと想い続けている筋金入り。"},{"spoiler":false,"text":"けれどいざとなると、持ち前の活発さやさばさばしたところはなりを潜めてもじもじ。"},{"spoiler":false,"text":"活発な外見とは裏腹に結構乙女な部分もあり。家事全般が得意で尽くすタイプ。"},{"spoiler":false,"text":"ただ朝起きるのだけは苦手で、いつも空夜に起こして貰っている。"},{"spoiler":false,"text":"日影町にいた両親が実家のある出鉄(いづもの)という町に帰ってしまったが、本人は陰陽学園に通うために残り、双方の親合意の下で月山家に居候している。"},{"spoiler":false,"text":"実は魔を祓うことを生業とする祓魔師の家の生まれで、人間にしては強い神気を持っている。おまけに武術の達人。"},{"spoiler":false,"text":"幼なじみな神様の朝陽に空夜を取られそうになり一大決心。"},{"spoiler":false,"text":"朝陽に対抗するように空夜を縛り上げたりして暴走気味のアタックを開始する。"}],"source":"egs","sourceCharacterId":"11210","sourceWorkId":"14414","spoiler":false},{"segments":[{"spoiler":false,"text":"空夜と同じ陰陽学園に通う幼なじみなサブヒロイン。"},{"spoiler":false,"text":"成績優秀で運動が得意。活動的で活発、さばさばとした性格。"},{"spoiler":false,"text":"気配り上手で姉御肌なところもあるので、周りからは頼りにされる存在。性別を問わず友達も多い。"},{"spoiler":false,"text":"友達だけじゃなく、もちろん校内の男子達からはかなりの人気がある。"},{"spoiler":false,"text":"体操服で運動している姿には、みんなその肢体に視線が釘付けになるなど、スタイルも抜群。"},{"spoiler":false,"text":"空夜に一途で、小さい頃からずっと想い続けている筋金入り。"},{"spoiler":false,"text":"けれどいざとなると、持ち前の活発さやさばさばしたところはなりを潜めてもじもじ。"},{"spoiler":false,"text":"活発な外見とは裏腹に結構乙女な部分もあり。家事全般が得意で尽くすタイプ。"},{"spoiler":false,"text":"ただ朝起きるのだけは苦手で、いつも空夜に起こして貰っている。"},{"spoiler":false,"text":"日影町にいた両親が実家のある出鉄(いづもの)という町に帰ってしまったが、本人は陰陽学園に通うために残り、双方の親合意の下で月山家に居候している。"},{"spoiler":false,"text":"実は魔を祓うことを生業とする祓魔師の家の生まれで、人間にしては強い神気を持っている。おまけに武術の達人。"},{"spoiler":false,"text":"幼なじみな神様の朝陽に空夜を取られそうになり一大決心。"},{"spoiler":false,"text":"朝陽に対抗するように空夜を縛り上げたりして暴走気味のアタックを開始する。"}],"source":"bangumi","sourceCharacterId":"168812"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a4ec5b5697a9ee61f618cb5a5bd11ac9a3629101febd54d8863b65c0941ac29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/254de55596fa2b33adc7332d4a3b19f1b8018f46c92a92f81fe0403439c9fe40.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265952:168812:6019:1","source":"bangumi"}]},{"characterId":"char_c29895","characterName":"来海","sourceIds":{"bangumi":[{"characterId":"168814","match":"exact-normalized-name-in-linked-work","subjectId":"265952"}],"egsCharacterIds":["11211"],"vndbCharacterId":"c29895"},"originalCharacterName":"来海","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"陽の姫神である朝陽の幼なじみにして従者。"},{"spoiler":false,"text":"朝陽同様幼い頃に下界に来ては、空夜や稲穂と一緒に遊んでいたので、二人とは幼なじみな仲。"},{"spoiler":false,"text":"外見も声も大人な女性としか思えないが、実は男性。"},{"spoiler":false,"text":"でもどこからどう見ても妖艶美女にしか見えない。"},{"spoiler":false,"text":"主の朝陽とは対照的に物腰が柔らかく友好的。"},{"spoiler":false,"text":"久しぶりに会った人間の幼なじみ二人ともすぐに打ち解ける。"},{"spoiler":false,"text":"また人間達のこともよく勉強しているので、下界になじむのも早くなかなかの適応能力を発揮する。"},{"spoiler":false,"text":"いつもいつも、下界に慣れていない朝陽のフォローに奔走している。"},{"spoiler":false,"text":"朝陽が唯一信頼を置いている従者でもある。"},{"spoiler":false,"text":"ただ、にっこり笑顔のままで毒を吐くことがあり、周りをぎょっとさせることも。頑なに朝陽に仕えているが、かなりの腹黒キャラだと目されている。"}],"source":"egs","sourceCharacterId":"11211","sourceWorkId":"14414","spoiler":false},{"segments":[{"spoiler":false,"text":"陽の姫神である朝陽の幼なじみにして従者。"},{"spoiler":false,"text":"朝陽同様幼い頃に下界に来ては、空夜や稲穂と一緒に遊んでいたので、二人とは幼なじみな仲。"},{"spoiler":false,"text":"外見も声も大人な女性としか思えないが、実は男性。"},{"spoiler":false,"text":"でもどこからどう見ても妖艶美女にしか見えない。"},{"spoiler":false,"text":"主の朝陽とは対照的に物腰が柔らかく友好的。"},{"spoiler":false,"text":"久しぶりに会った人間の幼なじみ二人ともすぐに打ち解ける。"},{"spoiler":false,"text":"また人間達のこともよく勉強しているので、下界になじむのも早くなかなかの適応能力を発揮する。"},{"spoiler":false,"text":"いつもいつも、下界に慣れていない朝陽のフォローに奔走している。"},{"spoiler":false,"text":"朝陽が唯一信頼を置いている従者でもある。"},{"spoiler":false,"text":"ただ、にっこり笑顔のままで毒を吐くことがあり、周りをぎょっとさせることも。頑なに朝陽に仕えているが、かなりの腹黒キャラだと目されている。"}],"source":"bangumi","sourceCharacterId":"168814"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url"