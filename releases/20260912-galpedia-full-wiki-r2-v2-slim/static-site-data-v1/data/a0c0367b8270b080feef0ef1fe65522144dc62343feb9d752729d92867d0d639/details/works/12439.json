ler":false,"text":"間延びした口調と背丈にそぐわぬ巨乳が特徴的な、おっとり屋。"},{"spoiler":false,"text":"顧問という立場ではあるが、運動音痴の上にテニスは未経験という有様のため、実質的には部長が取り仕切っているようだ。"},{"spoiler":false,"text":"しかしフワフワした愛らしさで部員からはマスコットのように可愛がられている。"},{"spoiler":false,"text":"【フォルト!! S】"},{"spoiler":false,"text":"最近騒動の絶えないテニス部を心配している。"}],"source":"egs","sourceCharacterId":"706","sourceWorkId":"18906","spoiler":false},{"segments":[{"spoiler":false,"text":"担任网球部的顾问的新人教师。"},{"spoiler":false,"text":"和慢吞吞的语调与小个子不相称的巨乳是特征的慢性子。"},{"spoiler":false,"text":"虽然身为顾问，但因为不仅是运动白痴而且还没有网球经验的囧样，实质上貌似是部长在主持一切。"},{"spoiler":false,"text":"不过因为软呼呼的可爱样子，被部员们当成吉祥物般宠爱着。"},{"spoiler":false,"text":"「听我说听我说～～、老师想到了新招数～」"}],"source":"bangumi","sourceCharacterId":"12853"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e05afe6a73290995e39230b98f449df212b366303a1d04b9fc4eb00d09ee4f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33aeb95836464ed6fa2ade644ca2fc6e7c44a5c42df5a736650d0256813f2377.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西口有香","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16123:12853:6592:1","source":"bangumi"}]},{"characterId":"char_vndb_c5471","characterName":"伊達・ウィングフィールド・黎子","sourceIds":{"vndbCharacterId":"c5471"},"originalCharacterName":"伊達・ウィングフィールド・黎子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"166"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vn