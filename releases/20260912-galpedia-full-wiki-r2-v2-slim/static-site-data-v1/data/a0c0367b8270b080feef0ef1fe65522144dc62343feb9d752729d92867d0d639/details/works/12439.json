ndb:vn-staff:26965","source":"vndb"},{"creditedName":"矢加部 貴之","creatorId":"vndb:s50950","sourcePersonId":"vndb:s50950","canonicalEntityId":"vndb:s50950","name":"矢加部 貴之","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26966","source":"vndb"}]},"cast":[{"characterId":"char_c5470","characterName":"佐伯 藍","sourceIds":{"bangumi":[{"characterId":"12850","match":"exact-normalized-name-in-linked-work","subjectId":"16123"},{"characterId":"12850","match":"exact-normalized-name-in-linked-work","subjectId":"38043"},{"characterId":"12850","match":"exact-normalized-name-in-linked-work","subjectId":"97355"}],"egsCharacterIds":["703"],"vndbCharacterId":"c5470"},"originalCharacterName":"佐伯 藍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、テニス部の二年生。"},{"spoiler":false,"text":"天然純朴にして純真無垢な性格で、よく言えば素直、悪くいえばバカ正直。"},{"spoiler":false,"text":"妹のわがままに悩まされる主人公にとっては、心を癒してくれる存在となる。"},{"spoiler":false,"text":"少々ズレた発言をすることが多く、周囲からは格好のオモチャにされている。"},{"spoiler":false,"text":"主人公に心寄せる素振りを見せているが……。"}],"source":"egs","sourceCharacterId":"703","sourceWorkId":"15266","spoiler":false},{"segments":[{"spoiler":false,"text":"修一のクラスメイト。天然キャラで、奇想天外な思考の持ち主。"},{"spoiler":false,"text":"澪と「協定」を結んだことで、修一と付き合うことなった。"}],"source":"egs","sourceCharacterId":"703","sourceWorkId":"16993","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、テニス部の二年生。"},{"spoiler":false,"text":"天然純朴にして天真爛漫な性格で、よく言えば素直、悪く言えばバカ正直。"},{"spoiler":false,"text":"妹のわがままに悩まされる主人公にとっては、心を癒してくれる存在となる。"},{"spoiler":false,"text":"少々ズレた発言をすることが多く、周囲からは格好のオモチャにされている。"},{"spoiler":false,"text":"主人公に心寄せる素振りを見せているが……。"},{"spoiler":false,"text":"【フォルト!! S】"},{"spoiler":false,"text":"澪と「協定」を結んだことで、修一と付き合うことなった。"}],"source":"egs","sourceCharacterId":"703","sourceWorkId":"18906","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的同学，网球部的二年生。"},{"spoiler":false,"text":"天然纯朴，性格天真烂漫，好说是坦诚，歹说就是笨蛋老实。"},{"spoiler":false,"text":"对烦恼于妹妹的唯我独尊的主人公来说，是治愈心灵的存在。"},{"spoiler":false,"text":"略微有点脱线的发言不少，被周围人当成绝妙的玩具。"},{"spoiler":false,"text":"虽然显示出了倾心于主人公的样子……"},{"spoiler":false,"text":"「是的！我一直都很有精神！」"}],"source":"bangumi","sourceCharacterId":"12850"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a30fd0d336dd92aff3dcbe6234fee01bd6dbd813fb394bd7a92ac24b720093a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/515106ad324d0bd97476fa0a782dbeb63a07c2938a07a8560012b30b44fc44a6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16123:12850:5075:1","source":"bangumi"}]},{"characterId":"char_c5472","characterName":"杉山 澪","sourceIds":{"bangumi":[{"characterId":"12851","match":"exact-normalized-name-in-linked-work","subjectId":"16123"},{"characterId":"12851","match":"exact-normalized-name-in-linked-work","subjectId":"38043"},{"characterId":"12851","match":"exact-normalized-name-in-linked-work","subjectId":"97355"}],"egsCharacterIds":["704"],"vndbCharacterId":"c5472"},"originalCharacterName":"杉山 澪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。テニス部の一年生で、ツインテールと貧乳がチャームポイント。"},{"spoiler":false,"text":"とにかく生意気でわがままな性格なので、黎子と並んでトラブルの原因となる。"},{"spoiler":false,"text":"兄に対しては常に友達感覚で、人前でも平気でバカにするようなことを口にする。"},{"spoiler":false,"text":"だがその一方では、兄に近づく女性に敵対心を燃やすという一面も……。"}],"source":"egs","sourceCharacterId":"704","sourceWorkId":"15266","spoiler":false},{"segments":[{"spoiler":false,"text":"修一の妹。我が儘で勝ち気な性格だったが、多少は丸くなった。"},{"spoiler":false,"text":"藍と共に修一を占有する、「シェアリング構想」を打ち立てた。"}],"source":"egs","sourceCharacterId":"704","sourceWorkId":"16993","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。 テニス部の一年生で、ツインテールと貧乳がチャームポイント。"},{"spoiler":false,"text":"とにかく生意気でわがままな性格なので、黎子と並んでトラブルの原因となる。"},{"spoiler":false,"text":"兄に対しては常に友達感覚で、人前でも平気でバカにするようなことを口にする。"},{"spoiler":false,"text":"だがその一方では、兄に近づく女性に敵対心を燃やすという一面も……。"},{"spoiler":false,"text":"【フォルト!! S】"},{"spoiler":false,"text":"わがままで勝ち気な性格だったが、多少は丸くなった。"},{"spoiler":false,"text":"藍と共に修一を占有する「シェアリング構想」を打ち立てた。"}],"source":"egs","sourceCharacterId":"704","sourceWorkId":"18906","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的妹妹。网球部的一年生，双马尾和贫乳是萌点。"},{"spoiler":false,"text":"总之很是盛气凌人，性格唯我独尊，与黎子并列是麻烦的原因。"},{"spoiler":false,"text":"对兄长一直是朋友的感觉，在他人面前也能若无其事地说些看不起他的话。"},{"spoiler":false,"text":"然而在另一方面，也有着对接近兄长的女性燃起敌对心的一面……"},{"spoiler":false,"text":"「哼、不过是个笨蛋哥哥！」"}],"source":"bangumi","sourceCharacterId":"12851"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d44e51d8c676c7432facfc4836d18d4709d6edb7782c3e82360585de8dc24e36.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23d0701e7487205a471bb7245e4c7b8b1c75fb1909b18c930c781a7bdfdf186c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16123:12851:5922:1","source":"bangumi"}]},{"characterId":"char_c5473","characterName":"杉山 修一","sourceIds":{"bangumi":[{"characterId":"12855","match":"exact-normalized-name-in-linked-work","subjectId":"16123"},{"characterId":"12855","match":"exact-normalized-name-in-linked-work","subjectId":"38043"}],"egsCharacterIds":["708"],"vndbCharacterId":"c5473"},"originalCharacterName":"杉山 修一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公にして、テニス部の二年生。"},{"spoiler":false,"text":"素っ気ない態度と乱暴な言葉遣いのせいか、大人たちからの評価はあまり芳しくないが、当人はさほど気にしていない。"},{"spoiler":false,"text":"面倒事に巻き込まれるのは大嫌いなのだが、いつの間にか騒動に引きずり込まれては、その中心で頭を抱えていることが多い。"},{"spoiler":false,"text":"しかし今回の騒動は今まで以上で……。"}],"source":"egs","sourceCharacterId":"708","sourceWorkId":"15266","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"優柔不断な性格が祟り、藍と澪のふたりと交際を始める。"},{"spoiler":false,"text":"さらに転校生の真夜の出現に端を発し、部長の黎子からもアプローチを受けることになってしまう。"}],"source":"egs","sourceCharacterId":"708","sourceWorkId":"16993","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公にして、テニス部の二年生。"},{"spoiler":false,"text":"素っ気ない態度と乱暴な言葉遣いのせいか、大人たちからの評価はあまり芳しくないが、当人はさほど気にしていない。"},{"spoiler":false,"text":"面倒事に巻き込まれるのは大嫌いなのだが、いつの間にか騒動に引きずり込まれては、その中心で頭を抱えていることが多い。"},{"spoiler":false,"text":"しかし今回の騒動は今まで以上で……。"},{"spoiler":false,"text":"【フォルト!! S】"},{"spoiler":false,"text":"優柔不断な性格が祟り、藍と澪のふたりと交際を始める。"},{"spoiler":false,"text":"さらに転校生の真夜の出現に端を発し、部長の黎子からもアプローチを受けることになってしまう。"}],"source":"egs","sourceCharacterId":"708","sourceWorkId":"18906","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的主人公，网球部的二年生。"},{"spoiler":false,"text":"大概是因为冷淡的态度与粗鲁的措词的关系吧，大人们的评价不怎么好，不过本人并不怎么在意。"},{"spoiler":false,"text":"最讨厌被卷进麻烦事，不过在不知不觉间被卷进骚动，在其中心抱头orz是常有的事。"},{"spoiler":false,"text":"然而这次骚动的规模乃是前所未有……"},{"spoiler":false,"text":"「嘛、不是很好么？」"}],"source":"bangumi","sourceCharacterId":"12855"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7585e0767f11be66ffea7ba4a9d8a029c3f14c11bc17f84835914e1b9a32136.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1ca63b724900cd447abf92dbd7f942dcbfdbb7dd70e096ac7ebc9b5b4714be3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村圭佑","creatorId":"vndb:s924","sourcePersonId":"vndb:s924","canonicalEntityId":"vndb:s924","name":"夏村伊介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16123:12855:19138:1","source":"bangumi"}]},{"characterId":"char_c5474","characterName":"松岡 螢","sourceIds":{"bangumi":[{"characterId":"12854","match":"exact-normalized-name-in-linked-work","subjectId":"16123"},{"characterId":"12854","match":"exact-normalized-name-in-linked-work","subjectId":"38043"},{"characterId":"12854","match":"exact-normalized-name-in-linked-work","subjectId":"97355"}],"egsCharacterIds":["707"],"vndbCharacterId":"c5474"},"originalCharacterName":"松岡 螢","characterNameSource":null,"role":"side","status":"source-only-candidate","i