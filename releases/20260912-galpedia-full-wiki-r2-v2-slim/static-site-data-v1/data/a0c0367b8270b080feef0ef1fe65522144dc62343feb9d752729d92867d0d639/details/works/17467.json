s","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:80430","source":"vndb"},{"creditedName":"よつすい","creatorId":"vndb:s32125","sourcePersonId":"vndb:s32125","canonicalEntityId":"vndb:s32125","name":"よつすい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:80433","source":"vndb"},{"creditedName":"時の宿","creatorId":"vndb:s28299","sourcePersonId":"vndb:s28299","canonicalEntityId":"vndb:s28299","name":"時風 聖夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:80435","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c9272","characterName":"水無瀬 亜理紗","sourceIds":{"vndbCharacterId":"c9272"},"originalCharacterName":"水無瀬 亜理紗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"With a personality as sweet as candy, Arisa is a young lady who exudes pure charm and innocence, thoughtful towards others and with a bright sense of humor. She enjoys good-natured teasing with her close friends, stuffed animals, and tea parties like any ordinary girl, but she also has a bit of spice to her as well. She dislikes it when boys get a little too friendly with her, and is never afraid to make her displeasure known through a few well-placed smacks. Despite her cheerful demeanor, however, she has a tendency to worry and fret over others, and often gets lost in her own troubled thoughts."},{"spoiler":false,"text":"Once in Wonderland, she is given the new name of Alice, in spite of her protests. Unfortunately, she finds her stay is anything but pleasant, feeling confused, homesick, and wanting to return to reality as quick as possible."},{"spoiler":false,"text":"From: Ero + Dere"}],"source":"vndb","sourceCharacterId":"c9272"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc88c35389eb0fae4327c3b5025c51b6eec3343f6c274d4b9ee4642ff44ee864.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3c70498a86f3556fc05ce77f68cf0e7f520e9cc84b6a0ba01cf12a9da1ce097.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43888","source":"vndb"}]},{"characterId":"char_vndb_c9273","characterName":"水無瀬 静久","sourceIds":{"vndbCharacterId":"c9273"},"originalCharacterName":"水無瀬 静久","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Arisa’s adored older brother. While seemingly unemotional, rarely initiating conversation and scarcely changing expression, he cares deeply for his beloved younger sister and treasures her above all else. Their relationship has only deepened with the absence of their parents, and he tries to fill her loneliness with presents and kind words."},{"spoiler":false,"text":"He guides Arisa to her new home as the Black Rabbit. However, in this new form, he insists that he has no siblings and claims to not recognize the name Shizuku at all."},{"spoiler":false,"text":"From: Ero + Dere"}],"source":"vndb","sourceCharacterId":"c9273"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da7e1d3ca5bbaf6107c8908234070bb6bc2a1cceb6f36355b32fe832cbec5b9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be4ad994304d608e9ab585ecb9a397c45a6cbed70a0632d03040a4a4817099f3.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皇 帝","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43890","source":"vndb"}]},{"characterId":"char_vndb_c9274","characterName":"如月 蓮","sourceIds":{"vndbCharacterId":"c9274"},"originalCharacterName":"如月 蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lighthearted and energetic, he dotes on Arisa like a playful younger sibling and claims that she will be his future wife. Unfortunately, in his eagerness to please, his affectionate hugs and other gestures tend to bother his dear friend rather than please her, leaving him on the receiving end of her slaps. Not that he ever takes offense, always greeting her with laughter and a smile."},{"spoiler":false,"text":"In the Wonderland, he appears as Round, the clingy and childish Dormouse. It appears his only two interests are sleeping and playing games with Arisa, especially the latter."},{"spoiler":false,"text":"From: Ero + Dere"}],"source":"vndb","sourceCharacterId":"c9274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25ce09b4a67b2390b760671de07ef6f249a23ad3a576b2701da264829f088a6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/197b135502e4b5728641ca5de121de53c7cfd4803f67034cef1e0c6c4fea3036.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三酉","creatorId":"vndb:s382","sourcePersonId":"vndb:s382","canonicalEntityId":"vndb:s382","name":"木村 良平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43893","source":"vndb"}]},{"characterId":"char_vndb_c9275","characterName":"黒谷 南緒","sourceIds":{"vndbCharacterId":"c9275"},"originalCharacterName":"黒谷 南緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An idol of the school, he is extremely popular and has gathered a large number of fans due to his charismatic and suave nature. The smallest flirtatious gesture from him can send girls swooning, and Nao greatly enjoys basking in the attention. But in spite of this, he has remained strictly on a platonic level with Arisa, occasionally flustering her but failing to capture her heart with his silken words. Mellow and free-spirited, he even takes authority figures lightly."},{"spoiler":false,"text":"As the Cheshire Cat, he is even more flamboyant than before, completely discarding any sense of modesty, ignoring Arisa’s own comfort levels to lavish her with attention, whether it’s wanted or not."},{"spoiler":false,"text":"From Ero + Dere"}],"source":"vndb","sourceCharacterId":"c9275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eef264c705f7e73ed2af8cb511e22c2d6110b63b669f9d3b5dae393e1c8a4bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/113af5752db40209460ca7510062c5b08ce2db2dc441fa421c3175563292f447.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柏木 誉","creatorId":"vndb:s379","sourcePersonId":"vndb:s379","canonicalEntityId":"vndb:s379","name":"野島 裕史","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43892","source":"vndb"}]},{"characterId":"char_vndb_c9276","characterName":"上条 遠夜","sourceIds":{"vndbCharacterId":"c9276"},"originalCharacterName":"上条 遠夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Asagi’s twin and older brother, he is warm and friendly towards Arisa, hoping to become even closer friends with her. Polite, responsible, and a lively conversationalist, he gets along quite well with others, although there appears to be friction between him and Asagi."},{"spoiler":false,"text":"His Wonderland form is called Shadow, the equivalent of the Tweedledee and Tweedledum twins. He is much more chipper and immature than his counterpart in reality, but is always willing to help Arisa."},{"spoiler":false,"text":"From: Ero + Dere"}],"source":"vndb","sourceCharacterId":"c9276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b632a997bcb7211a6c546168842ab7076afc2757f6a8379def21fe1f85feeac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e54cc2992734f530a1a4d5f63b70c51f98f3ec55ee22cfe9eefbcc35f5b7f5f0.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野次馬 根性","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43895","source":"vndb"}]},{"characterId":"char_vndb_c9277","characterName":"上条 朝霧","sourceIds":{"vndbCharacterId":"c9277"},"originalCharacterName":"上条 朝霧","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"In stark contrast to his older brother, he is the most antisocial of the two and seems to be in a constant foul mood, although not outright hostile. His rude behavior and refusal to even speak to Arisa forces Touya to often apologize on his behalf, but he is too preoccupied with his own burdens to bother being kind."},{"spoiler":false,"text":"His Wonderland form is Shadow’s twin, Light. He is just as brusque as his self in the real world, and unlike everyone’s obvious adoration for Alice, he says to have no concern for her."},{"spoiler":false,"text":"From: Ero + Dere"}],"source":"vndb","sourceCharacterId":"c9277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c2c47674b54183401d8d6bb5d041da81cf4186da01f76c4196cfe8bbef4089d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df55ed79725964bd71ff9ac4cdffd5e0a51d86842f409624fab830e5f2d64118.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野次馬 根性","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43896","source":"vndb"}]},{"characterId":"char_vndb_c9278","characterName":"時任 司","sourceIds":{"vndbCharacterId":"c9278"},"originalCharacterName":"時任 司","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sharp-tongued and absolutely brutal with his words, Tsukasa is the sadistic school doctor who tolerates little from students and teachers alike. His overbearing presence greatly distresses Arisa, who tries her best to avoid him. Yet in spite of his cruel nature, he acts surprisingly concerned towards her at times―however, this turns out to be just a ruse, as he is quick to turn violent once she rejects him."},{"spoiler":false,"text":"He has been given the role of Chrono, the Mad Hatter, who has been plotting to capture Alice with the help of other Wonderlanders. His insane obsession stems not only from repressed lust, but from a desire to destroy her."},{"spoiler":false,"text":"From: Ero + Dere"}],"source":"vndb","sourceCharacterId":"c9278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e19c2eb30d12c62765edcb062c710d38709b24328feea52fe122a09fc1ce7118.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/955a19a9363a53f19e2dfea926683ad472dd5835aae9f801ef641cad0f27d107.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ほうでん亭 ガツ","creatorId":"vndb:s53","sourcePersonId":"vndb:s53","canonicalEntityId":"vndb:s53","name":"森川智之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43894","source":"vndb"}]},{"characterId":"char_vndb_c9279","characterName":"タイム","sourceIds":{"vndbCharacterId":"c9279"},"originalCharacterName":"タイム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A solemn young girl who seems to be an ally of the Black Rabbit, at first. In truth, she has been conspiring with Chrono to capture Alice, and is considered his “possession”. Yet despite remaining subservient to him, she is the only one who can withstand his fierce temper and calm his hysterical outbursts. The true nature of her relationship with Chrono is a mystery."},{"spoiler":false,"text":"From Ero + Dere"}],"source":"vndb","sourceCharacterId":"c9279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5f611e08673a749e8eea2ee06ac7779219cb7d45de7db239d07c7fe6bb238c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/035034fa2f19e2c24d0e3c3c51e3901a108af509a03ea20433910d9fd9eb9304.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茶谷 やすら","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43891","source":"vndb"}]},{"characterId":"char_vndb_c9280","characterName":"ハートの女王","sourceIds":{"vndbCharacterId":"c9280"},"originalCharacterName":"ハートの女王","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The ruler of Wonderland, the Queen of Hearts is a cruel woman that takes joy in executing her citizens for the pettiest of crimes. She also forces her people to watch the beheadings. Due to the time loop, she executes and forces people to watch her order the execution of Jack."}],"source":"vndb","sourceCharacterId":"c9280"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b08c26cb279d2388f73609add1383ec6d4689ec20245ef742a1d777bfa17e7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d50e0295203a468d013861d4ecefe5ae17ed9763ea3b115c421390a49c4fb54e.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篠崎 双葉","creatorId":"vndb:s752","sourcePersonId":"vndb:s752","canonicalEntityId":"vndb:s752","name":"篠崎双葉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43897","source":"vndb"}]},{"characterId":"char_vndb_c9281","characterName":"エリザベス","sourceIds":{"vndbCharacterId":"c9281"},"originalCharacterName":"エリザベス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"Elizabeth is a \"flower\" with the ability to speak that resides in a nearby small garden of Wonderland. Despite its feminine name and demeanour, due to having a voice more like a man's, its gender remains a mystery. Elizabeth dislikes being called a snake (which happens often, as its head heavily resembles one) and believes itself to be a beautiful flower. Elizabeth's eccentricities aside, it becomes a compassionate shoulder of Arisa's, and even dispenses valuable advice in times of need."}],"source":"vndb","sourceCharacterId":"c9281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30bbdb42c4f8799648577f45be2f60f409bee9cde2c209e326da4a21524ed4f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce17dac93a5bc2897f48dab5261c325301bd4c59e25bb7a809cc8892c883de00.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紀之","creatorId":"vndb:s15","sourcePersonId":"vndb:s15","canonicalEntityId":"vndb:s15","name":"杉山 紀彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43889","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1344","sourceCompanyId":"egs:brand:3090","canonicalEntityId":"vndb:p1344","name":"little cheese","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17467:3090","source":"egs"},{"companyId":"vndb:p1344","sourceCompanyId":"vndb:p1344","canonicalEntityId":"vndb:p1344","name":"little cheese","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:21266:v8820","source":"vndb