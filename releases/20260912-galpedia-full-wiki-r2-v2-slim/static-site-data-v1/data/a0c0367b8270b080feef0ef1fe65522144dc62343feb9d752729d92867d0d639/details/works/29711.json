121483","source":"vndb"},{"creditedName":"UC","creatorId":"vndb:s5222","sourcePersonId":"vndb:s5222","canonicalEntityId":"vndb:s5222","name":"UC","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:121484","source":"vndb"},{"creditedName":"Taichi","creatorId":"vndb:s5223","sourcePersonId":"vndb:s5223","canonicalEntityId":"vndb:s5223","name":"Taichi","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:121485","source":"vndb"},{"creditedName":"Taichi","creatorId":"vndb:s5223","sourcePersonId":"vndb:s5223","canonicalEntityId":"vndb:s5223","name":"Taichi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121486","source":"vndb"},{"creditedName":"宇都宮 つみれ","creatorId":"vndb:s5327","sourcePersonId":"vndb:s5327","canonicalEntityId":"vndb:s5327","name":"宇都宮 つみれ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:121487","source":"vndb"},{"creditedName":"桜 あいね","creatorId":"vndb:s553","sourcePersonId":"vndb:s553","canonicalEntityId":"vndb:s553","name":"櫻川 めぐ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:121489","source":"vndb"},{"creditedName":"小松 アン","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:121490","source":"vndb"},{"creditedName":"白咲 葵依","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"藤咲ウサ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:121491","source":"vndb"},{"creditedName":"桜乃 ひよ","creatorId":"vndb:s5178","sourcePersonId":"vndb:s5178","canonicalEntityId":"vndb:s5178","name":"本多真梨子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:121492","source":"vndb"},{"creditedName":"萩野 小唄","creatorId":"vndb:s11157","sourcePersonId":"vndb:s11157","canonicalEntityId":"vndb:s11157","name":"萩野 小唄","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121494","source":"vndb"},{"creditedName":"cao.","creatorId":"vndb:s12910","sourcePersonId":"vndb:s12910","canonicalEntityId":"vndb:s12910","name":"cao.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121496","source":"vndb"},{"creditedName":"SugarLover","creatorId":"vndb:s13225","sourcePersonId":"vndb:s13225","canonicalEntityId":"vndb:s13225","name":"SugarLover","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121497","source":"vndb"},{"creditedName":"合資会社ワムソフト","creatorId":"vndb:s15832","sourcePersonId":"vndb:s15832","canonicalEntityId":"vndb:s15832","name":"WAMSOFT(合資会社ワムソフト)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121498","source":"vndb"},{"creditedName":"ゆめ","creatorId":"vndb:s18803","sourcePersonId":"vndb:s18803","canonicalEntityId":"vndb:s18803","name":"ゆめ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:121499","source":"vndb"},{"creditedName":"干支神 一夜","creatorId":"vndb:s20877","sourcePersonId":"vndb:s20877","canonicalEntityId":"vndb:s20877","name":"干支神 一夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121500","source":"vndb"}]},"cast":[{"characterId":"char_c34928","characterName":"鳴海 兎亜","sourceIds":{"bangumi":[{"characterId":"35576","match":"exact-normalized-name-in-linked-work","subjectId":"137664"}],"egsCharacterIds":["8210"],"vndbCharacterId":"c34928"},"originalCharacterName":"鳴海 兎亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1203"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A genius programmer who aims to make money while taking it easy. She's a lazy little sister who shuts herself in her room."},{"spoiler":false,"text":"The protagonist's little sister and a first year student of the academy."},{"spoiler":false,"text":"She enjoys lazing around and finds most things to be a hassle. Sunlight is her enemy."},{"spoiler":false,"text":"Stays at home, mainly in her room, watching anime while surfing the internet, or playing video games. Rather than being unsociable, it would be more apt to say that she doesn't find any point in human interaction. When meeting people for the first time, she keeps conversation to a minimal, instead making her brother deal with them."},{"spoiler":false,"text":"Because the handful of people she does interact with -- her brother and her friend, Mihiro -- joined the Student Council, she joins as well, and is made the treasurer."},{"spoiler":false,"text":"Is especially good at programming, and develops prediction programs for the lottery or horse racing, as well as smartphone apps, so she can earn money without any effort. One app she developed out of complete boredom ended up becoming a big hit, and earns her a lot of money."},{"spoiler":false,"text":"She truly adores her big brother, but she is cold towards him."},{"spoiler":false,"text":"Edited from Sekai Project"}],"source":"vndb","sourceCharacterId":"c34928"},{"segments":[{"spoiler":false,"text":"主人公の実妹で学園の一年生。だらけるのが大好きで面倒くさがり。日光が敵。"},{"spoiler":false,"text":"出不精で基本的には部屋にこもってアニメをみながらネットサーフィンやゲームをしていることが多い。"},{"spoiler":false,"text":"人付き合いが苦手というよりは必要性を感じておらず、初対面の相手とは最低限の会話しかせず、兄にぶん投げる。"},{"spoiler":false,"text":"数少ない会話相手である兄と友人の未尋が生徒会に入ったので、自分もなんとなく生徒会に入り会計を担当している。"},{"spoiler":false,"text":"プログラミングが得意で、不労所得のため宝くじや競馬の予測プログラムや、スマホアプリなどを制作している。"},{"spoiler":false,"text":"実際に暇つぶしに作ったスマホアプリが大ヒットし、莫大な収益を生んでいる。"},{"spoiler":false,"text":"兄のことを心から慕ってはいるが、態度は冷たい。"}],"source":"egs","sourceCharacterId":"8210","sourceWorkId":"21867","spoiler":false},{"segments":[{"spoiler":false,"text":"幸樹の実妹で桜翠学園の1年生。幸樹の漫画家活動のことを知っている。かなり面倒がりな性格で家にこもってネットやゲームをしていることが多い。コンピュータプログラムの専門知識を持ち、スマホアプリの開発によって多額の収入を得ている。幸樹と同様に生徒会に加入し、会計を担当する。"}],"source":"bangumi","sourceCharacterId":"35576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/447c7355efb1668da83a522ea8ca0f44b811d5eb154db0b53dc1b9ac405ad780.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c237636aa6dee3dab8c82910979e327d190521ee0122fb1997c3aa07e9eb7d52.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:137664:35576:4809:1","source":"bangumi"}]},{"characterId":"char_c37364","characterName":"しかくん","sourceIds":{"bangumi":[{"characterId":"35574","match":"exact-normalized-name-in-linked-work","subjectId":"137664"}],"egsCharacterIds":["8208"],"vndbCharacterId":"c37364"},"originalCharacterName":"しかくん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"416"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The perfect Student Council President, but is secretly an illustrator and manga artist with a reputation for racy drawings."},{"spoiler":false,"text":"A third year student at the academy serving as the Student Council President."},{"spoiler":false,"text":"Her grades are always in the top; she carries herself with dignity; and treats everyone sociably, without any prejudice. This has brought her the trust of not only all of the students, but all of the teachers in the school as well."},{"spoiler":false,"text":"Behind the scenes, she's quite a popular illustrator who goes by the pen name \"Mr. Deer / Shika-kun\"."},{"spoiler":false,"text":"Forming a team with the protagonist, they have a running manga in a weekly magazine, but because all of their exchanges have been via e-mail or their editor, they didn't know they both attended the same school."},{"spoiler":false,"text":"Her family is affluent, and her grandfather is well-known around town. She's been raised strictly by her parents to make sure she doesn't bring any shame to the family name. In response, she became obsessed with manga and anime that she had just happened to come across, and turned into an otaku. Sometimes she also comes up with puns in the middle of conversations and people end up having no idea how to respond."},{"spoiler":false,"text":"Edited from Sekai Project"}],"source":"vndb","sourceCharacterId":"c37364"},{"segments":[{"spoiler":false,"text":"学園の三年生で生徒会長。"},{"spoiler":false,"text":"常にトップの成績、凛とした姿勢や態度、誰にでも別け隔てなく接する人当たりのよさで、全校学生のみならず教師からの信頼も厚い。"},{"spoiler":false,"text":"裏では「しかくん」というハンドルネームのイラストレーターとして活動しておりなかなかの売れっ子。"},{"spoiler":false,"text":"主人公とコンビを組んで週刊誌で連載を持っているが、メールや編集を通したやりとりしかしていないので同じ学園だということは知らなかった。"},{"spoiler":false,"text":"実家は裕福で祖父は地元の名士。名家に恥じない娘に育てるべく、両親に厳しく躾けられてきた。"},{"spoiler":false,"text":"その反動から、偶然触れた漫画やアニメにのめり込みオタクになる。"},{"spoiler":false,"text":"時折反応に困るおやじギャグを会話に挟み、周囲を困らせることも。"}],"source":"egs","sourceCharacterId":"8208","sourceWorkId":"21867","spoiler":false},{"segments":[{"spoiler":false,"text":"桜翠学園の3年生で生徒会長を務める黒髪の少女。品行方正で学年トップの成績を誇る優等生。歴史ある名家の出身であるが、厳しく躾けられた反動でオタク趣味にハマるようになった。「しかくん」というペンネームで漫画家として活動し、ライトノベルのイラストなども手がける。幸樹の漫画の作画担当者であるが、互いにいつも編集を通してやメールを送ってしか連絡していないため、同じ学園の生徒同士だということを最近まで知らなかった。"}],"source":"bangumi","sourceCharacterId":"35574"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2122c5e64d40c088cb4bb182e363aaa8c433d5ae3a7a939e0cdd2ff62c741bbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec9353a482ab094233eb8291eea9d8976f7c0aa6b3ad276c21c8985590f80196.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本多真梨子","creatorId":"vndb:s5178","sourcePersonId":"vndb:s5178","canonicalEntityId":"vndb:s5178","name":"本多真梨子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:137664:35574:5203:1","source":"bangumi"}]},{"characterId":"char_c37366","characterName":"宮瀬 未尋","sourceIds":{"bangumi":[{"characterId":"35577","match":"exact-normalized-name-in-linked-work","subjectId":"137664"}],"egsCharacterIds":["8211"],"vndbCharacterId":"c37366"},"originalCharacterName":"宮瀬 未尋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"606"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One year under the main character; devilish, and has exceptional talent in cooking."},{"spoiler":false,"text":"Toa's best friend. Also the poster girl of a long-running Western style restaurant."},{"spoiler":false,"text":"She's naturally talented and can do just about anything, but she won't make any effort unless she feels the need to."},{"spoiler":false,"text":"Although her grades were terrible, she poured everything she had into studying so that she could go to the same school as Toa and the protagonist. Because of her diligent study, she ended up overdoing it and scored the highest in the entrance exam."},{"spoiler":false,"text":"Thanks to her excellent grades in the entrance exam, she's scouted out by the Student Council."},{"spoiler":false,"text":"While she isn't comfortable with animals, they naturally find themselves drawn to her, and she often has a line of cats and dogs following her around. While the animals do tend to be mostly cats and dogs, there are some rare creatures like ducks that show up as well."},{"spoiler":false,"text":"The protagonist is the only person she refers to as \"Senpai\". It seems that she has her reasons for this."},{"spoiler":false,"text":"Edited from Sekai Project"}],"source":"vndb","sourceCharacterId":"c37366"},{"segments":[{"spoiler":false,"text":"主人公の後輩で兎亜の親友。老舗の洋食屋の看板娘。"},{"spoiler":false,"text":"基本的になんでもできる天才気質だが、必要に駆られないとやる気を出さない。"},{"spoiler":false,"text":"成績はよくなかったが、兎亜や主人公と同じ学園に通うため一念発起。"},{"spoiler":false,"text":"猛勉強した結果、やりすぎて主席合格してしまった。"},{"spoiler":false,"text":"入試の成績がよかったため、生徒会に勧誘されることになる。"},{"spoiler":false,"text":"本人は苦手にしているが動物になつかれやすい体質で、よく後輩の後ろを犬や猫が列を作って追いかけてくる。"},{"spoiler":false,"text":"犬猫が大半だが、たまにアヒルなどのレアキャラも。"},{"spoiler":false,"text":"『先輩』と呼ぶのは主人公のことだけ。本人なりにこだわりがあるらしい。"}],"source":"egs","sourceCharacterId":"8211","sourceWorkId":"21867","spoiler":false},{"segments":[{"spoiler":false,"text":"兎亜の親友の少女で桜翠学園の1年生。実家は洋食屋を営んでおり、料理が得意。幸樹のことを「先輩」と呼ぶ。兎亜と同様に、幸樹の漫画家活動のことを知っている。入学試験で首席だったことに目をかけられ、生徒会に勧誘される。ヒロイン一の巨乳の持ち主。"}],"source":"bangumi","sourceCharacterId":"35577"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a987e5e9254af3d9c115a61fea33acc88ec9bf080337d9cc2f15443fa3f52a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69047eef21cc1ae207b66256442f72fe6b82a9213d65a116968091f98c1de1f3.webp","width":125,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜咲千依","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"藤咲ウサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:137664:35577:8990:1","source":"bangumi"}]},{"characterId":"char_vndb_c37365","characterName":"桜木・ルーフォレット・アーシェ","sourceIds":{"vndbCharacterId":"c37365"},"originalCharacterName":"桜木・ルーフォレット・アーシェ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"222"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Serious, hates losing, and aims to be a composer. She serves as Vice President and isn't honest with her feelings."},{"spoiler":false,"text":"A student on the same year as the protagonist and the Student Council Vice President."},{"spoiler":false,"text":"Her grades are kept at the top of her year level for just about every subject, except for ones related to the Japanese language where she is beaten by the protagonist. She secretly considers him a rival for this."},{"spoiler":false,"text":"With a serious, strict personality, she hates losing and is a hard worker. Her sense of justice is strong, and hates anything that is crooked or wrongful."},{"spoiler":false,"text":"Loves eating, and can eat large amounts of food. When eating, she is a lot less hostile towards the protagonist. She prefers to eat working class food, and even though she comes from a rich household, whenever she eats high class French food, she gets an upset stomach."},{"spoiler":false,"text":"Her mother is a world-famous pianist and her father is a former violinist. Both of them are currently traveling the world, so she lives alone in their huge apartment."},{"spoiler":false,"text":"She had won a national piano competition, but her mother instead told her that she has no talent for playing the piano and her father told her to become a music composer instead."},{"spoiler":false,"text":"She now strives to be a composer. The reason why she joined the Student Council was because of her father's advice that she should broaden her experiences as a person in order to grow her talent as a composer."},{"spoiler":false,"text":"Edited from Sekai Project"}],"source":"vndb","sourceCharacterId":"c37365"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3692e9b3f198cfcc9d691ec4eb8200425a0a077d7ac04cc90ecc0b4145d2f28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04fbd99ecba517c3b0cafb4842da7bcbdac59cf121d8f8c801b0ff91e8f106f6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜 あいね","creatorId":"vndb:s553","sourcePersonId":"vndb:s553","canonicalEntityId":"vndb:s553","name":"櫻川 めぐ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64803","source":"vndb"}]},{"characterId":"char_vndb_c37756","characterName":"鳴海 幸樹","sourceIds":{"vndbCharacterId":"c37756"},"originalCharacterName":"鳴海 幸樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student and manga author whose work is serialized in a weekly magazine under the pen name \"Imo Sarada.\""},{"spoiler":false,"text":"Edited from Sekai Project"}],"source":"vndb","sourceCharacterId":"c37756"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a61be1565e287be5a46e2e74250442d13c771063ff0541339b52f2b3992a5f49.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/698cf6cdae61f88df1b2ba7e5cc8306757e9749f564ae342b823647850356a6a.webp","width":193,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c50691","characterName":"四月一日 奏恋","sourceIds":{"vndbCharacterId":"c50691"},"originalCharacterName":"四月一日 奏恋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1108"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's class representative."},{"spoiler":false,"text":"She's well aware of how beautiful a girl she is. Excels at sweet-talking people and has a calculating side to her as well."},{"spoiler":false,"text":"Judging by her looks and aura, she looks to be the type who plays around. However, not only is she the class representative, but is also the vice head of the drama club; she has a strong sense of responsibility."},{"spoiler":false,"text":"From Sekai Project"}],"source":"vndb","sourceCharacterId":"c50691"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27cb7f32cedbafd719b540b76b4ec28c0c881fa8e38d7f1de35036ffca78f27b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb5c5f5a99dd638360c22922c594f6a54d36209677ca91833a0e469cd3f31e8b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水羽 良子","creatorId":"vndb:s1648","sourcePersonId":"vndb:s1648","canonicalEntityId":"vndb:s1648","name":"中村 繪里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64808","source":"vndb"}]},{"characterId":"char_vndb_c50692","characterName":"鷹司 千歳","sourceIds":{"vndbCharacterId":"c50692"},"originalCharacterName":"鷹司 千歳","characterName