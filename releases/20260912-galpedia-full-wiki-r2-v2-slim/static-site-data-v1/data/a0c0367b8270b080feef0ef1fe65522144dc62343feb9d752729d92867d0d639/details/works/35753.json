nId":"egs:creator:3092","canonicalEntityId":"vndb:s1051","name":"SENTIVE","detail":"音素材","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:275365","source":"egs"},{"creditedName":"ザ・マッチメイカァズ","creatorId":"vndb:s11576","sourcePersonId":"egs:creator:18638","canonicalEntityId":"vndb:s11576","name":"ザ・マッチメイカァズ","detail":"音素材","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:275366","source":"egs"},{"creditedName":"魔王魂(KOUICHI、森田交一、株式会社ジョーカーサウンズ)","creatorId":"egs:creator:16982","sourcePersonId":"egs:creator:16982","canonicalEntityId":"egs:creator:16982","name":"魔王魂(KOUICHI、森田交一、株式会社ジョーカーサウンズ)","detail":"音素材","roleCode":"other","roleLabel":"其他","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:275367","source":"egs"},{"creditedName":"WEB WAVE LIB","creatorId":"vndb:s11575","sourcePersonId":"egs:creator:18871","canonicalEntityId":"vndb:s11575","name":"WEB WAVE LIB","detail":"音素材","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:275368","source":"egs"},{"creditedName":"shiro","creatorId":"egs:creator:40494","sourcePersonId":"egs:creator:40494","canonicalEntityId":"egs:creator:40494","name":"shiro","detail":"スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"ambiguous-alias-review","relationId":"egs:work-creator:275373","source":"egs"},{"creditedName":"高野鈴","creatorId":"egs:creator:40495","sourcePersonId":"egs:creator:40495","canonicalEntityId":"egs:creator:40495","name":"高野鈴","detail":"制作補助","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:275374","source":"egs"},{"creditedName":"広瀬 コウ","creatorId":"vndb:s13862","sourcePersonId":"vndb:s13862","canonicalEntityId":"vndb:s13862","name":"広瀬 コウ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:123156","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c154643","characterName":"ロザリア・ブレンメ","sourceIds":{"vndbCharacterId":"c154643"},"originalCharacterName":"ロザリア・ブレンメ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Gilbert's fiancée, the daughter of the Marquis of Bremme."},{"spoiler":false,"text":"Though proud and somewhat arrogant, she cares for Gilbert more than anyone else."},{"spoiler":false,"text":"Deep down, she is kind and humble, never flaunting her noble status."},{"spoiler":false,"text":"Her intense feelings sometimes cause her to act impulsively, putting her beloved first even if it may lead her to doing forbidden things."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c154643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a03c235dcdb7b5cd9318bbbe83c018f8f9f11abc2456754143f77216748a418.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86e73bcb2c1cb80c478452546c36a73b0df92fae2bcffb774f02132b584be2b5.webp","width":227,"height":230,"source":"static-detail"},"actors":[{"creditedName":"花鶏","creatorId":"vndb:s45154","sourcePersonId":"vndb:s45154","canonicalEntityId":"vndb:s45154","name":"花鶏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65798","source":"vndb"}]},{"characterId":"char_vndb_c154644","characterName":"イレーヌ・アップルヤード","sourceIds":{"vndbCharacterId":"c154644"},"originalCharacterName":"イレーヌ・アップルヤード","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A maid in the castle, she's actually Gilbert's childhood friend. Has a calm and gentle personality."},{"spoiler":false,"text":"She's a good advisor to Lithia, but she's also a playful woman who gets excited when it comes to romance."},{"spoiler":false,"text":"She has keen insight and observation skills, and can easily detect people's subtle emotions and lies."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c154644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/757c635c4d576ba52975a3fb8e97f0b8af69c4591e6705e9b44685c61b999cc2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/027284c31824104b1eaf8fc3bbdfd3c79e08a36539353945f7111475f96941f5.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山野 弥生","creatorId":"vndb:s45153","sourcePersonId":"vndb:s45153","canonicalEntityId":"vndb:s45153","name":"山野 弥生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65797","source":"vndb"}]},{"characterId":"char_vndb_c87519","characterName":"リシア","sourceIds":{"vndbCharacterId":"c87519"},"originalCharacterName":"リシア","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She's bright and positive, though also clumsy and absent-minded."},{"spoiler":false,"text":"Nevertheless, she never oversteps her bounds and is generally modest and humble, while also possessing the strength to bounce back even when hurt. She loves beautiful things and admires strong but kind people."},{"spoiler":false,"text":"Despite being a mermaid, she nearly drowned when her tail got caught. This made her feel ashamed, but she's deeply grateful to the prince who saved her. She's a bit slow at times, but is sensitive to others' emotional wounds."},{"spoiler":false,"text":"After losing her voice, she primarily communicates through writing, but there are times when she unintentionally misunderstands others due to her inability to speak in sudden situations."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c87519"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e415cb647ca56e60dfa882f733893e9440e766c7877b5107bd363664a5215faf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31923dac19fd2c8cfa9126134c62a2a603ed18c3e6ec4e948a1ae8aee080e0e9.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"響聖歌","creatorId":"vndb:s17108","sourcePersonId":"vndb:s17108","canonicalEntityId":"vndb:s17108","name":"響聖歌","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65793","source":"vndb"}]},{"characterId":"char_vndb_c87522","characterName":"ギルベルト・フォン・リィンベルク","sourceIds":{"vndbCharacterId":"c87522"},"originalCharacterName":"ギルベルト・フォン・リィンベルク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main hero."},{"spoiler":false,"text":"He seems to have been bedridden for a while, and often gets scolded for leaving his bed. He's generally kind and refined, but also has a slightly mischievous side. He's objective about his own appearance, deliberately acting \"like a prince\" to annoy the protagonist."},{"spoiler":false,"text":"He always wears an elegant smile, but he'll sometimes wear a slightly melancholic expression."},{"spoiler":false,"text":"He seems to like the protagonist quite a bit, since she doesn't seem to be the type to stick close by, so he often takes care of her."},{"spoiler":false,"text":"Interestingly, he also has a hobby of making picture books."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c87522"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8091f50e3b2769dad1f25ed2dd734d949d72a1896079fe4fd09a5cd73e2f5b83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bfded46636743b5d13173e156b56cecefbb24e01f747339813a06a292180d0a.webp","width":195,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奈方 幹典","creatorId":"vndb:s21430","sourcePersonId":"vndb:s21430","canonicalEntityId":"vndb:s21430","name":"DJ Miki(奈方幹典)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65794","source":"vndb"}]},{"characterId":"char_vndb_c87523","characterName":"ユージン・ベルクマン","sourceIds":{"vndbCharacterId":"c87523"},"originalCharacterName":"ユージン・ベルクマン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The prince's personal knight."},{"spoiler":false,"text":"He's quiet, blunt, and has an unapproachable aura to him. He's aware of this, so when the protagonist is unable to speak to him on their first encounter, he misunderstands this as her being so intimidated by him that she can't speak, leaving him feeling hurt. He's a bit stubborn, but has the sincerity to apologize once the misunderstanding is cleared."},{"spoiler":false,"text":"He loves reading and can read through mountains of books in one sitting. He was initially uncomfortable around women, but his outlook is gradually changing due to the protagonist's slightly unconventional nature."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c87523"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75cdb0503e85617e739d21af0edcb0a30a9af1775c6c46b76decfa7f2c06a306.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b94e0f34e4cde8bef42fa11c5b877e48624c09d46e4f8ce7052417874772765.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"祈鈴","creatorId":"vndb:s21431","sourcePersonId":"vndb:s21431","canonicalEntityId":"vndb:s21431","name":"祈鈴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65795","source":"vndb"}]},{"characterId":"char_vndb_c87524","characterName":"エディ・オールストン","sourceIds":{"vndbCharacterId":"c87524"},"originalCharacterName":"エディ・オールストン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend."},{"spoiler":false,"text":"Though he's a human, the two used to play together at the beach when they were young. Somewhat of a tsundere, and while he's seemingly exasperated by the protagonist's recklessness, he ultimately can't bring himself to abandon her."},{"spoiler":false,"text":"His tongue is sharp, but he's skilled with his hands, leading him to be selected as the castle's royal gardener. He struggles with his feelings for the protagonist, but always tries to support her."},{"spoiler":false,"text":"In truth, he's very kind-hearted, often bearing the protagonist's anger and sadness in her stead..."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c87524"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/691cdf205ed69cb8c8967b3e94386e902eff2ecd9fe6685e4fb54daeafc335a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/646c7e6734ccf931f68e35e3b43033d95d0e29b90e93dbf8f2fac10c50d31065.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"進藤海斗","creatorId":"vndb:s21432","sourcePersonId":"vndb:s21432","canonicalEntityId":"vndb:s21432","name":"進藤海斗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65796","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p2881","sourceCompanyId":"egs:brand:4467","canonicalEntityId":"vndb:p2881","name":"まじっくハウス","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:35753:4467","source":"egs"},{"companyId":"vndb:p2881","sourceCompanyId":"vndb:p2881","canonicalEntityId":"vndb:p2881","name":"まじっくハウス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:48087:v18106","source":"vndb"},{"companyId":"vndb:p2881","sourceCompanyId":"vndb:p2881","canonicalEntityId":"vndb:p2881","name":"まじっくハウス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:48088:v18106","source":"vndb"},{"companyId":"vndb:p2881","sourceCompanyId":"vndb:p2881","canonicalEntityId":"vndb:p2881","name":"まじっくハウス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:48089:v18106","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
