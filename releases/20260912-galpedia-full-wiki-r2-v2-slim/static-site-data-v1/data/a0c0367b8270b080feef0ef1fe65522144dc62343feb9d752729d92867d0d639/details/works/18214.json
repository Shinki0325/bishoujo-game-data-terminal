tus":"source-native","relationId":"vndb:vn-staff:44524","source":"vndb"},{"creditedName":"TOMO","creatorId":"vndb:s11252","sourcePersonId":"vndb:s11252","canonicalEntityId":"vndb:s11252","name":"TOMO","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:44525","source":"vndb"},{"creditedName":"ユズミツ","creatorId":"vndb:s4487","sourcePersonId":"vndb:s4487","canonicalEntityId":"vndb:s4487","name":"あかざ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:44526","source":"vndb"}]},"cast":[{"characterId":"char_c9637","characterName":"七瀬 ヒカリ","sourceIds":{"bangumi":[{"characterId":"93243","match":"exact-normalized-name-in-linked-work","subjectId":"21897"}],"egsCharacterIds":["23380"],"vndbCharacterId":"c9637"},"originalCharacterName":"七瀬 ヒカリ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"810"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hikari is the only daughter of the Superintendent General, for which she was given an unmatched official position and command of an airship, and established the Aozora Police Department, an independent law enforcement agency. She hunts down criminals for fun, randomly fires cannons around the city, and accidentally or sometimes intentionally hits the police headquarters. Citizens and police officers believe that Aozora Department are more dangerous than criminals."}],"source":"vndb","sourceCharacterId":"c9637"},{"segments":[{"spoiler":false,"text":"警際戦艦を一任された、「青空署」の署長。"},{"spoiler":false,"text":"父親が警偉総監で娘を溺愛している為、何をやっても基本的に許されてしまう。"},{"spoiler":false,"text":"パトベセル（青空署）の署長兼艦長。"},{"spoiler":false,"text":"警偉総監の一人娘であり、父親に溺愛されているため、若くしてその座に就いた言わば「七光」の指揮官。"},{"spoiler":false,"text":"その性格は唯我独尊にして大胆不敵、傍若無人にして一触即発の「警偉庁の核弾頭」。"},{"spoiler":false,"text":"警偉庁では彼女の名前を出すことはタブーとさえ言われ、警際官からも市民からも畏怖されているが、当の本人はまったく気にしていない。"},{"spoiler":false,"text":"ワガママし放題で自己中心的だが、タチが悪いことに人を惹き付けるカリスマと、テキトーに物事を押し進めても良い結果に転がってしまう強運を持っている。"},{"spoiler":false,"text":"「犯罪は許さないがただ平和なだけの町も面白くない」、という持論を持って今日も彼女は戦艦を駆る。"}],"source":"egs","sourceCharacterId":"23380","sourceWorkId":"8729","spoiler":false},{"segments":[{"spoiler":false,"text":"警際の青空署の署長で、パトベセルの艦長。"},{"spoiler":false,"text":"警偉総監の一人娘であり、父親に溺愛されているため、若くしてその座に就いた言わば「七光」の指揮官。"},{"spoiler":false,"text":"その性格は唯我独尊にして大胆不敵、傍若無人にして一触即発の「警偉庁の核弾頭」。"},{"spoiler":false,"text":"警偉庁では彼女の名前を出すことはタブーとさえ言われ、警際官からも市民からも畏怖されているが、当の本人はまったく気にしていない。"},{"spoiler":false,"text":"性格はひたすらに我が道を行くタイプで、しかも道にあるモノを全て撥ね除けて進む為に周りの被害が大きい。"},{"spoiler":false,"text":"ワガママし放題で自己中心的だが、タチが悪いことに人を惹き付けるカリスマと、テキトーに物事を押し進めても良い結果に転がってしまう強運を持っている。"},{"spoiler":false,"text":"新人警際官の主人公を妙に気に入り、強引に自分の戦艦へと配属させた。"},{"spoiler":false,"text":"「犯罪は許さないがただ平和なだけの町も面白くない」、という持論を持って今日も彼女は戦艦を駆る。"}],"source":"bangumi","sourceCharacterId":"93243"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09d8df51b9539acebae313d059557448dab009c285a617299f36b7abd7ed793e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d0ed2a6a255a0606114737a26d6683abe0d066f4152b2e45b274080d5b92094.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c150679","characterName":"向塚 巻子","sourceIds":{"vndbCharacterId":"c150679"},"originalCharacterName":"向塚 巻子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is an employee of Kouzuka Cleaning, a cleaning shop used by Aozora Police Station, and the name of the shop is apparently \"Elegant Cleaning''. She is skilled enough to make even patterned T-shirts pure white. She also has a habit of laughing loudly. She gets along well with Hikari, and is given special permission to pilot the Patvessel. Hikari calls her \"Macky\"."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c150679"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/570ff3a9d8d34de424c906ccb8e4fc6d4961bd937f19b8b3b4e591a0d0d7fd2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96928a4a51576d55aa7f399cf3df881e3677be5c7de598039b7564598ef17bad.webp","width":190,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c61666","characterName":"神尾 賢二","sourceIds":{"vndbCharacterId":"c61666"},"originalCharacterName":"神尾 賢二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"531"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3rd year high school student & professional manga artist."},{"spoiler":false,"text":"Hobby: Reading and drawing manga."},{"spoiler":false,"text":"Although he hides it at school, he is a professional shojo manga artist with a serial in the weekly shojo manga magazine \"Comic Charm\"."},{"spoiler":false,"text":"His pen name is \"Ijuuin Alice\" (name can be changed)."},{"spoiler":false,"text":"He made his debut at the age of 13 and was said to be a genius at the time, but he has a tendency to be moody and has been on the decline recently. This is his fourth manga to be canceled."},{"spoiler":false,"text":"He is passionate about drawing \"all-round manga\" that can be enjoyed by people of all ages and genders."},{"spoiler":false,"text":"In order to get rid of the title of canceled manga artist, Chika makes him cross-dress, revealing his hidden face to readers and promoting him as a \"beautiful girl manga artist\"."},{"spoiler":false,"text":"If you enter the heroine's route, the content is different, but the protagonist's true identity becomes known nationwide due to events and TV programs in which Ijuuin Alice appears. When this happens, he is often slapped by some of the heroines."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c61666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d82557eb381d2bbd54a6035461dfa6237fe34b370f0316b469ab87a057d95378.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6dc69deac100b33518477e0c58bfab206e127ee248c098578e8bebb843fe1382.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c61667","characterName":"伊集院 アリス","sourceIds":{"vndbCharacterId":"c61667"},"originalCharacterName":"伊集院 アリス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"531"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kamio Kenji's pen name and alter ego."}],"source":"vndb","sourceCharacterId":"c61667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7ca382a6e2c25bef768e4bd799d6c86ccfef21397ae9d26924d32185ca86aa8a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15b9ef385bbde6e98db7cb8041cc16fec821ba806e5f287ac0339b6e38ad5ab9.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c61668","characterName":"秋月 凛菜","sourceIds":{"vndbCharacterId":"c61668"},"originalCharacterName":"秋月 凛菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1220"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3rd year high school student & professional manga artist."},{"spoiler":false,"text":"Hobby: Drawing manga, Shopping"},{"spoiler":false,"text":"A student and girl manga artist in the same class as Kenji."},{"spoiler":false,"text":"Like Kenji, she serialises her work in Comic Charm. Her work is so popular that it ranked first in a reader survey. She serialises her work under her real name, not a pen name, so she is well-known at school. She is very popular with both boys and girls. She is thought to be a genius, but she works very hard behind the scenes. She is cheerful and friendly to those around her, and is unconcerned about Alice's popularity. However, in reality she is very competitive, and is so jealous of Alice's popularity that she will crack walls and other things. Not knowing that Kenji is a manga artist, she sees him as \"a friend who understands the feelings of a manga artist very well.\""},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c61668"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/073f933e6791e239dc742ce9252e879a9f47829b0657d0a47170ac2453c45d3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa1aa5748f35fda0aff506a3558c88a0c169ffd5e1d072862883c5e980cd2848.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚原 有里","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24644","source":"vndb"}]},{"characterId":"char_vndb_c61669","characterName":"羽鳥 ヒスイ","sourceIds":{"vndbCharacterId":"c61669"},"originalCharacterName":"羽鳥 ヒスイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3rd year high school student & manga assistant."},{"spoiler":false,"text":"Hobby: Drawing backgrounds & buildings."},{"spoiler":false,"text":"Kenji's childhood friend and classmate."},{"spoiler":false,"text":"She has been his assistant since Kenji's debut. Her dream is to become an architectural designer, and she works as Kenji's assistant to study, but in reality, she just wants to be with Kenji. Her dream is to live with Kenji in a house that she designed. She calls boys her age, including Kenji, \"Ome,\" and is nicknamed \"Dictator\" in class because she nonchalantly says amazing things and is sarcastic. She sometimes wears a maid uniform to motivate Kenji."},{"spoiler":false,"text":"She is also the ace of the art club, but she quickly goes home to work as an assistant, so she becomes a ghost member. She has also published a doujinshi, and the circle name is \"Gel-like\"."},{"spoiler":false,"text":"If she were to be the heroine, Kenji would fall into a temporary manga slump."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c61669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a045b542afea56e4beea0c60fe3c08f20ac39e1620b92c4937453c842f58d297.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8770aa5e93528fea0bbeec2793686ea9405b67405f79d6b1aa617398a4d3ada1.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24642","source":"vndb"}]},{"characterId":"char_vndb_c61670","characterName":"神尾 千佳","sourceIds":{"vndbCharacterId":"c61670"},"originalCharacterName":"神尾 千佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"801"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kenji's stepsister, a manga editor."},{"spoiler":false,"text":"Hobby: Working, Drinking beer"},{"spoiler":false,"text":"Kenji's sister-in-law and editor. Kenji calls her \"Chika-nee.\""},{"spoiler":false,"text":"She is a skilled editor who works at Akemi Publishing and is known as \"Ane-ki\" within the editorial department. In addition to Kenji, she is also in charge of Rinna, and is highly regarded as an editor."},{"spoiler":false,"text":"She also does housework despite her busy schedule, and is a good cook. She switches between work mode and private mode with the flip of a switch, and in private mode she likes alcohol (mainly beer) and is quite sloppy. She has a bit of a bro complex and shows a soft side to Kenji, but if Kenji's manga ranks low in a survey, she will use a fist technique (cloud knuckles) using a cloud-shaped ruler instead of brass knuckles."},{"spoiler":false,"text":"She is on bad terms with the deputy editor-in-chief."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c61670"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aa2d121b4fb415df0c286c2f20991e0868eccf927acb406c0c44bfcaba0eb25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22ca1c9e591743b805115f9305c11ae53516fb3e78f8fdd7f360865b84e388bc.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井 浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24641","source":"vndb"}]},{"characterId":"char_vndb_c61671","characterName":"紫堂 楓","sourceIds":{"vndbCharacterId":"c61671"},"originalCharacterName":"紫堂 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1111"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3rd year high school student."},{"spoiler":false,"text":"Hobby: Reading (Novels Only), Texting"},{"spoiler":false,"text":"Kenji's classmate and class representative."},{"spoiler":false,"text":"She is quiet and calm, manages the class, and is well-liked because of her good looks."},{"spoiler":false,"text":"For some reason, she has an abnormal dislike for manga, which has led to conflicts with the protagonist on multiple occasions. Her hobby is novels, but she also dislikes manga and light novels and other illustrations, saying that \"they give me goosebumps.\" She lives with her grandfather in a bookstore, and occasionally works at the store as a clerk. Her goal seems to be to get rid of the manga section one day. Contrary to her image, she is also addicted to texting on her cell phone, writing lengthy messages that are on par with novels. She is also an extremely good mahjong player, loves to gossip about other people, and is a mysterious character."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c61671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/666134542ae4c0b73f082ea198bfd8b5aa5294453294605a8110e92fbb78100b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/601190ce72ae960991c2a0c23565e3cd68237df4ff49647291b54fc655a56f57.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海 エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24638","source":"vndb"}]},{"characterId":"char_vndb_c61672","characterName":"高杉 ハルカ","sourceIds":{"vndbCharacterId":"c61672"},"originalCharacterName":"高杉 ハルカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"401"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A junior voice actress."},{"spoiler":false,"text":"Hobby: Saving money, Seasonal food"},{"spoiler":false,"text":"A new junior voice actress belonging to \"Gakepuchi Production\"."},{"spoiler":false,"text":"Although she was raised in a family that could not be called wealthy, she lives her life with a positive attitude and cheerfulness. Because of this, she looks young but is a very good girl. She loves cheap bean sprouts, and is sometimes called a bean sprout idol, rather than a healing type. Her daily routine is to check if there are any coins under vending machines. She also participates in ComicFy in cosplay. During one of her cosplays, she showed off her cosplay of \"Yachi Nagakura\" from \"Gakuen☆Shinsengumi\"."},{"spoiler":false,"text":"She is also a talented gag manga artist, and not only does she make Kenji, but also Hisui and Chika laugh out loud, so much so that even the deputy editor-in-chief, who is strict at work, becomes soft on her. If she is made the heroine, she will use this talent to write the scenario for Kenji's new work."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c61672"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28884e467468da8afed97d2e07a344cfdc76351485d1febec19316347764f602.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/6777e8e4f8de86647d1f0e036d885807ca3b4abf06c3c91e37e6ec627fd380b9.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24639","source":"vndb"}]},{"characterId":"char_vndb_c61673","characterName":"黛 沙耶香","sourceIds":{"vndbCharacterId":"c61673"},"originalCharacterName":"黛 沙耶香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"825"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only"