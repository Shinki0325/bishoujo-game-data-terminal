only","source":"vndb","value":"15"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mary's the second youngest daughter at age 15, but she acts like a baby. She's rather have fun than study, so Kira will have to do his best if she chooses her."},{"spoiler":false,"text":"Her natural charm and innocence is so alluring, one can't help but want to be around her."}],"source":"vndb","sourceCharacterId":"c82764"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9239a0803674680549635f6005df2efa6e2f498dcf14d839246dd90d28acee9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e5df1ff33f1a954edcca296077ca2089a405e07daf622f1509b1f0eb93cde6b.webp","width":132,"height":132,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82773","characterName":"シシル・グロリア","sourceIds":{"vndbCharacterId":"c82773"},"originalCharacterName":"シシル・グロリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sicile is one of Michelle's daughters. Even though she is only 17, she acts like everyone's mother."},{"spoiler":false,"text":"Even though she is part of the family, she serves the household as a maid, as some form of punishment. Her docile nature makes it hard to imagine what she did to get such a punishment."}],"source":"vndb","sourceCharacterId":"c82773"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d67749621812c3fcbf4d660cf46ad6367c0baa26318be9f15842af6b2fb0656.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29a1729c3ce00f0dda414cc2c0ed1ceee28e4b95beeba2a804efb2e3daea597f.webp","width":132,"height":132,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82811","characterName":"ナオミ・グロリア","sourceIds":{"vndbCharacterId":"c82811"},"originalCharacterName":"ナオミ・グロリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Gloria family's daughters. She is the same age as Sicile, but acts much more irresponsibly."},{"spoiler":false,"text":"She's quite cynical and makes sure to let others hear her strange viewpoints. Sake helps her loosen her tongue, so she drinks it all day long."}],"source":"vndb","sourceCharacterId":"c82811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ee09ee18ae0f3eb08b1d02d1c8e049490699b6d57c31e92fb80b7c968cc7120.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eef4a9a694b930669d3ee61d201eb015af1a4c3df6e6672c1a831e8731dff227.webp","width":132,"height":132,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82818","characterName":"シャルム・グロリア","sourceIds":{"vndbCharacterId":"c82818"},"originalCharacterName":"シャルム・グロリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Youngest daughter of the Gloria family. She's a very serious girl, and its hard for her to open up to others."},{"spoiler":false,"text":"The only one she truly cares for her is her pet lizard, Filemorth. You rarely see her without her precious pet."}],"source":"vndb","sourceCharacterId":"c82818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb01066429ec68167c24a71cad4bbff04d50bb2eb25c4593a377b82d6a3c8778.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f0d8e424c30a39c3fd9bd823d5f06181200c2d75dd18a601f53ad095cb4f005.webp","width":132,"height":132,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82852","characterName":"ミッシェル・M・グロリア","sourceIds":{"vndbCharacterId":"c82852"},"originalCharacterName":"ミッシェル・M・グロリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Current head of Gloria household. She seems to fall for Kira from the first moment she meets him."},{"spoiler":false,"text":"However, she seems to be able control her emotions so that she won't have a problem firing him if he doesn't do his job."}],"source":"vndb","sourceCharacterId":"c82852"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df3761e7bbba3f08d713d05bb8450b575e5d1f7b609d1bd3c4a66d0317f55c9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15e7ba62ae025a4ebec44e994b6b97e38783c5563598421e14c601e3a80738f8.webp","width":132,"height":132,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82855","characterName":"ゲオルク・ハイネセン","sourceIds":{"vndbCharacterId":"c82855"},"originalCharacterName":"ゲオルク・ハイネセン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb",