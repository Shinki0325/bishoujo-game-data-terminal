{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15375","model":{"presentationWorkId":"egs:15375","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"山本美禰子","creatorId":"vndb:s3962","sourcePersonId":"egs:creator:16411","canonicalEntityId":"vndb:s3962","name":"山本美禰子","detail":"OP曲「Fallin' The Star Light」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:100619","source":"egs"},{"creditedName":"岸田メル","creatorId":"egs:creator:29993","sourcePersonId":"egs:creator:29993","canonicalEntityId":"egs:creator:29993","name":"岸田メル","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"alias-only-review","relationId":"egs:work-creator:181923","source":"egs"},{"creditedName":"古原奈々","creatorId":"egs:creator:10589","sourcePersonId":"egs:creator:10589","canonicalEntityId":"egs:creator:10589","name":"古原奈々","detail":"ED曲「不思議なレシピ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"no-alias-hit","relationId":"egs:work-creator:269083","source":"egs"}]},"cast":[{"characterId":"char_bangumi_198251","characterName":"イクセル・ヤーン","sourceIds":{"bangumi":[{"characterId":"198251","match":"source-roster","subjectId":"11436"},{"characterId":"198251","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"イクセル・ヤーン","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"164"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ロロナやクーデリアと幼馴染の料理人。15歳。身長：164cm、A型。"},{"spoiler":false,"text":"あだ名はイクセくん。レストランの見習いという肩書きだが、実質的に店のほとんどは彼が切り盛りしている。ロロナには幼少の頃からよく手料理を振る舞っている。前向きで気さくな反面、勝気でもあり、特に料理の事となると途端に熱くなる。彼を仲間にして各地に赴く事で採取フラグが立つ素材がある為、そのイベントを起こさないといつまで経っても一部の材料が手に入らない状態が続く。"}],"source":"bangumi","sourceCharacterId":"198251"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d58ac71c16cb12a364d455f8da7ac38bf8ed6a750ce542c2ecaa1e6f80ade3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f2374a76318b05ad04d92d421a4554268c9efff40da13f5e2476b43db2234c4.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花慎之介","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:198251:4645:1","source":"bangumi"}]},{"characterId":"char_bangumi_198252","characterName":"タントリス","sourceIds":{"bangumi":[{"characterId":"198252","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"タントリス","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"174"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"放浪の旅をする吟遊詩人。19歳。身長：174cm、B型。"},{"spoiler":false,"text":"あだ名はタントさん。女たらしで、ナンパ好きな軽い性格。飄々としているが、あまり本心を語ろうとしない。楽器演奏が得意で、動物すら魅了する程の腕前。本名は「トリスタン・オルコック」でメリオダスの息子。政には興味を持っておらず気ままに旅を続けていたが、アーランドへと帰ってきた際にロロナと知り合う事になった。彼女の必死の努力を見ている内に、父の跡を継いで今一度アーランドの為に働く事を決意する。家出をして放浪している理由は父が仕事に感けてあまり接してくれなかった為に、父の気を引きたい一心もあるとアストリッドに暴露された。"}],"source":"bangumi","sourceCharacterId":"198252"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/903664095de3972dcd0f9a955a532991ebf9870d798c838f71a9c1482a365c1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d5edf8e83d87a693a3f8b8c7512be9b8a38c585c539e9eff898290ace3d5c37.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤孝行","creatorId":"vndb:s2121","sourcePersonId":"vndb:s2121","canonicalEntityId":"vndb:s2121","name":"近藤 孝行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:198252:3980:1","source":"bangumi"}]},{"characterId":"char_bangumi_198253","characterName":"Hom","sourceIds":{"bangumi":[{"characterId":"198253","match":"source-roster","subjectId":"19494"},{"characterId":"198253","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"Hom","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"142"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ロロナの従者。身長：142cm。この身長は背が低い事を気にしているクーデリアをからかうため、アストリッドがわざとクーデリアより少しだけ大きく作った。"},{"spoiler":false,"text":"寡黙で無表情だが、ロロナやアストリッドの命令には忠実に従い、そつなくこなす。幼い外見の割に、大人びた口調で話す。実はアストリッドが作り出した、世にも珍しいホムンクルスの成功例である。"},{"spoiler":false,"text":"なお、性別はホム誕生の少し前のイベントで選択可能であり、その際のロロナの回答によって決定される。アストリッドからロロナの弟（妹）となっているが、ホムはロロナを「マスター」と呼ぶ為、あまり姉弟（姉妹）という感じではない。運動能力と知能は、ロロナを遥かに上回るらしい。一人称は男女共に「ホム」。"}],"source":"bangumi","sourceCharacterId":"198253"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbfb660141d3c6ca6c1d94f11e04caaa4136e4efd7d7dbb7ccca49dbfc2be034.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/673e9c7fb3a7d552747e00786d82289b342a92390a170faf805564ce2712a81a.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井ノ上奈々","creatorId":"vndb:s1808","sourcePersonId":"vndb:s1808","canonicalEntityId":"vndb:s1808","name":"井ノ上奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:198253:4745:1","source":"bangumi"},{"creditedName":"宮崎羽衣","creatorId":"vndb:s273","sourcePersonId":"vndb:s273","canonicalEntityId":"vndb:s273","name":"宮崎 羽衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:198253:4773:2","source":"bangumi"}]},{"characterId":"char_bangumi_36074","characterName":"帕梅拉·伊碧斯","sourceIds":{"bangumi":[{"characterId":"36074","match":"source-roster","subjectId":"11436"},{"characterId":"36074","match":"source-roster","subjectId":"138202"},{"characterId":"36074","match":"source-roster","subjectId":"19494"},{"characterId":"36074","match":"source-roster","subjectId":"2250"},{"characterId":"36074","match":"source-roster","subjectId":"249447"},{"characterId":"36074","match":"source-roster","subjectId":"283338"},{"characterId":"36074","match":"source-roster","subjectId":"310881"},{"characterId":"36074","match":"source-roster","subjectId":"41265"},{"characterId":"36074","match":"source-roster","subjectId":"41271"},{"characterId":"36074","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"帕梅拉·伊碧斯","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"工作室系列的吉祥物之一。"},{"spoiler":false,"text":"在不同的世界观下，身世、性格稍有不同。"},{"spoiler":false,"text":"--------------------------------------------------"},{"spoiler":false,"text":"A4"},{"spoiler":false,"text":"最早登场是在メッテルブルグ宿屋的某房间，是在那里住了几十年的幽灵。以前那个房间因为有幽灵的传说，所以没人敢住。不过，后来尤蒂入住其中，并告诉大家帕梅拉并不是什么可怕东西的事实，于是那个房间又变得格外受欢迎了起来。"},{"spoiler":false,"text":"A5"},{"spoiler":false,"text":"25年后，原来的幽灵房间要事先预约也变得非常困难。但随着尤蒂回到自己的时代之后，帕梅拉渐渐开始有些觉得寂寞了，表情也没有以前看起来那么快乐。她也正在寻找新的朋友。"},{"spoiler":false,"text":"A6"},{"spoiler":false,"text":"アレーキア洞窟封印龙的祭品，后来成为幽灵后住过下水道、古堡、图书馆……虽然遇见过炼金很多代主角了、经历过很多冒险了，不过总是失忆的特性使得她仍如小白一般单纯天真。"},{"spoiler":false,"text":"A9"},{"spoiler":false,"text":"资料馆的幽灵，以惊吓学生为乐，剧情中加入了主角维恩所在的炼金工房，曾和现任校长是同学。"},{"spoiler":false,"text":"拥有该作最强技能，而且使用门槛很低。"},{"spoiler":false,"text":"A11"},{"spoiler":false,"text":"ロロナが拾ったクマのヌイグルミに宿っていた幽霊。悲壮感を感じさせないおっとりとした性格で後に自分のお店「パメラ屋さん」をオーブンする。"},{"spoiler":false,"text":"A12"},{"spoiler":false,"text":"トトリが住むアランヤ村にあるパメラ屋さんの店主。"},{"spoiler":false,"text":"何年か前にアーランドからやって来て、気づいたら店を開いていた。"},{"spoiler":false,"text":"のんびりぽや～っとした性格で、あまり物事を深く考えたりしない。"},{"spoiler":false,"text":"お店の管理もちゃんとできているのか、やや怪しいところがある。"},{"spoiler":false,"text":"見た目は若いが、年齢は不詳。"},{"spoiler":false,"text":"どうやら昔のことはあまり覚えていないらしい。"},{"spoiler":false,"text":"A13"},{"spoiler":false,"text":"经营量贩店，DLC可加入为战斗角色。"},{"spoiler":false,"text":"A17"},{"spoiler":false,"text":"教会のシスター。"},{"spoiler":false,"text":"おっとり、ほんわかとした性格。"},{"spoiler":false,"text":"常に間延びした口調でしゃべり、周囲を無意識に和ませる。"},{"spoiler":false,"text":"教会の仕事をほぼ一人で切り盛りしている他、街の子供たちを預かる託児所を開いているなど、わりと働き屋。"},{"spoiler":false,"text":"街の老人に対しても子供のように接するなど、彼女の年齢は謎。"},{"spoiler":false,"text":"A18"},{"spoiler":false,"text":"為了修女研修，離開家鄉基爾亨‧貝爾，出來旅行的修女。"},{"spoiler":false,"text":"但是在結束修女的培訓之後，因為買了太多土產導致盤纏都花完的關係，她不得不在萊森貝格經營店鋪工作賺錢。"},{"spoiler":false,"text":"總是從容不迫，也令人摸不著頭緒的個性。"},{"spoiler":false,"text":"A19"},{"spoiler":false,"text":"キルヘン・ベルでシスターを務めていた女性。今はヴェーニュ教会で、グレースとともにシスターの仕事に励んでいる。"},{"spoiler":false,"text":"キルヘン・ベルに戻るはずがなぜかメルヴェイユ行きの馬車に乗ってしまい、今は故郷に帰ることを目標に路銀を貯めている。"},{"spoiler":false,"text":"ぽわわんとした性格で、シスターとしての実力もある、教会でもかなりの人気者。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"在亚尔兹经营【帕梅拉的店】的女性。"},{"spoiler":false,"text":"因为个性温和又带着轻飘飘的感觉，让她的店成为亚尔兹的观光景点之一。似乎是萝乐娜的旧识。"},{"spoiler":false,"text":"A21"},{"spoiler":false,"text":"在库肯港初次登场。主线剧情后期，帕梅拉会作为旅行者在库肯港出现，并伴随一系列相关的支线任务。"},{"spoiler":false,"text":"A22"},{"spoiler":false,"text":"本作在王都初次登场。带着大量布丁，想把布丁推广到全世界。 机缘巧合加入了朵拉莉亚“盗贼”团，帮助盗贼团找到装满金币的宝箱分给了穷人们，盗贼团也帮助了帕梅拉推广布丁的愿望。"}],"source":"bangumi","sourceCharacterId":"36074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2304ac8c4bcdb34ff998c6c80281fdb7c6fa967e31baa0fc9baf2219a49d3c1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc34afc0557da8bf2a66c4a771137c06db970ca0d77810b85834ceeddb1208e.webp","width":187,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷井あすか","creatorId":"vndb:s657","sourcePersonId":"vndb:s657","canonicalEntityId":"vndb:s657","name":"谷井 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:36074:4593:1","source":"bangumi"}]},{"characterId":"char_bangumi_49541","characterName":"Rorolina Frixell","sourceIds":{"bangumi":[{"characterId":"49541","match":"source-roster","subjectId":"11436"},{"characterId":"49541","match":"source-roster","subjectId":"19494"},{"characterId":"49541","match":"source-roster","subjectId":"2250"},{"characterId":"49541","match":"source-roster","subjectId":"249447"}]},"originalCharacterName":"Rorolina Frixell","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"148"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A11　　14歳"},{"spoiler":false,"text":"本作的主角，突然被师傅强迫而接下经营炼金工房重任的少女，时而迷糊还少根筋的的新人炼金术士。通称：“萝洛娜”（ロロナ）"},{"spoiler":false,"text":"受到亚斯特丽德帮助，治疗了罹患流行病的双亲，却没钱付医药费，而以成为亚斯特丽德的弟子兼打杂小妹来代替还钱。"},{"spoiler":false,"text":"A12　　22歳"},{"spoiler":false,"text":"前作の主人公。基本的な性格は変わっていないが、色んな経験を積んで、精神的に大分逞しくなっている。"},{"spoiler":false,"text":"弟子の可愛がり方とかには、師匠成分も少々入っている。"},{"spoiler":false,"text":"あれからしばらく、錬金術士としてアーランドで活躍した後、色んな人に錬金術を教えるために各地を旅して周っている。"},{"spoiler":false,"text":"ついでに、ホムをつれてどこかに逃げてしまった師匠を探している。"},{"spoiler":false,"text":"A13　　??歳"},{"spoiler":false,"text":"前々作の主人公にしてトトリの錬金術の先生。"},{"spoiler":false,"text":"性格は相も変わらず、天然で抜けていてトトリが大好き。"},{"spoiler":false,"text":"しかし錬金術に関しては理屈で説明できない天才的な才能を持っている。"},{"spoiler":false,"text":"物語の冒頭、アールズを錬金術で発展させるために、ジオに頼まれて派遣されるはずだったが、突然横槍が入りアーランドに留まることになった。"},{"spoiler":false,"text":"その後アールズを訪れた時には、既にこの姿となっていた。"},{"spoiler":false,"text":"その理由は、未だ明らかにされていない…。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"アーランドの中でもトップクラスの実力をもつ錬金術士。ただ錬金術を独自のぐるぐる理論で理解しているため、人に教えるのは苦手。ルルアのお母さんではあるが、錬金術についてはピアニャに任せている。"},{"spoiler":false,"text":"仕事で各地を転々としており、大事なときにいない。"},{"spoiler":false,"text":"パイへの情熱は未だ衰えを知らず、今も日々、"},{"spoiler":false,"text":"より美味しく珍しいパイを作るべく奮闘している。"}],"source":"bangumi","sourceCharacterId":"49541"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"49541","value":"炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c541e92bde2c4d12e49bd731a24dc103f57bb0c4d4c3f5baae7b7fbad85474e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b44c6f8d34fa14fb1027e0736f5767bcc7c2e241b2a8fc1947883c841e8aa6d.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"門脇舞以","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"門脇 舞以","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:49541:4402:1","source":"bangumi"}]},{"characterId":"char_bangumi_49542","characterName":"库迪利亚·冯·费尔巴哈","sourceIds":{"bangumi":[{"characterId":"49542","match":"source-roster","subjectId":"11436"},{"characterId":"49542","match":"source-roster","subjectId":"19494"},{"characterId":"49542","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"库迪利亚·冯·费尔巴哈","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"139.8"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"罗洛娜儿时的玩伴，被罗洛娜亲切的称为「小库」。以前经常来工房找罗洛娜玩，不过总是会对罗洛娜说教，然后找借口照顾她（醉翁之意不在酒）。在《罗罗娜的工作室》中作为可参战人物登场，而《托托莉的工作室》中不知道什么原因当起了阿兰德冒险者协会的接待员工作（家道中落），全权负责冒险者资格的办理手续，每天都忙于工作中。虽然过了三年但除了年龄各方面都没什么成长的样子——性格也和过去一样易怒并且不够率直，被周围的人看来依旧像个小孩子（尤其是身高）——但是多少给人了一点可靠的感觉。"}],"source":"bangumi","sourceCharacterId":"49542"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db73013bb64266075952235bb5420f33d33e8de3cbc6c4da3cd9f7735161d022.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38a0ebfe2383abd9a00e876923ed15f2a7f70cb1d6fa1e45e3bd3b60af28cf2b.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:49542:4251:1","source":"bangumi"}]},{"characterId":"char_bangumi_59698","characterName":"ハゲル","sourceIds":{"bangumi":[{"characterId":"59698","match":"source-roster","subjectId":"11436"},{"characterId":"59698","match":"source-roster","subjectId":"19494"},{"characterId":"59698","match":"source-roster","subjectId":"2250"},{"characterId":"59698","match":"source-roster","subjectId":"24106"},{"characterId":"59698","match":"source-roster","subjectId":"28755"},{"characterId":"59698","match":"source-roster","subjectId":"41259"},{"characterId":"59698","match":"source-roster","subjectId":"41271"},{"characterId":"59698","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"ハゲル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"190"}},"descriptions":[{"segments":[{"spoiler":false,"text":"工作室系列中多次登场的秃头铁匠。"},{"spoiler":false,"text":"在不同的世界观中都很在意自己的秃头。"},{"spoiler":false,"text":"--------------------------------------------------"},{"spoiler":false,"text":"A19　　43歳"},{"spoiler":false,"text":"メルヴェイユで鍛冶屋を営んでいる大柄な男性。その名のとおり、頭頂部は光り輝いている。"},{"spoiler":false,"text":"代々鍛冶屋を生業とする家系で、自らの鍛冶屋を守っていくことにかけては並々ならぬ情熱を注いでいる。"},{"spoiler":false,"text":"陽気で気の良い性格をしており、その名物っぷりは観光ガイドブックにも載るほどである。"}],"source":"bangumi","sourceCharacterId":"59698"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"59698","value":"铁匠"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee4837113b5bf8050b2792d9d9974fb1b119caf50aec519e469167df306d887a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fbf71ce9d57dbf5cca0bea4b28df2233fe85c137c92674d4751caf65de0e7fe.webp","width":132,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立木文彦","creatorId":"vndb:s1943","sourcePersonId":"vndb:s1943","canonicalEntityId":"vndb:s1943","name":"立木 文彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:59698:4112:1","source":"bangumi"}]},{"characterId":"char_bangumi_68543","characterName":"史特尔布鲁克·库拉哈","sourceIds":{"bangumi":[{"characterId":"68543","match":"source-roster","subjectId":"11436"},{"characterId":"68543","match":"source-roster","subjectId":"19494"},{"characterId":"68543","match":"source-roster","subjectId":"2250"},{"characterId":"68543","match":"source-roster","subjectId":"249447"}]},"originalCharacterName":"史特尔布鲁克·库拉哈","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A11　　25歳"},{"spoiler":false,"text":"アーランド王国に仕える騎士。剣の腕が立つ真面目な青年だが不器用で口数が少ない為怖い人と思われている。ロロナに王国依頼を出す窓口役兼、保護者のような立場でもある。"},{"spoiler":false,"text":"A12　　33歳"},{"spoiler":false,"text":"相変わらず生真面目で苦労性。"},{"spoiler":false,"text":"前作からの五年で色々あったので、顔つきが更に不機嫌で怖くなっているが、中身はまったく変わってない。（ちょっと愚痴が多くなった程度）"},{"spoiler":false,"text":"アーランドが共和国になったため、今は正式な騎士ではなくなっている。"},{"spoiler":false,"text":"無責任に国をほったらかしてどこかに消えた前国王を探して、各地を旅して周っている。"},{"spoiler":false,"text":"その先々で新米冒険者の救出やら尻拭いやらをついついしているので、なんだかんだで冒険者の現場監督のような認識をされている。"},{"spoiler":false,"text":"A13　　39歳"},{"spoiler":false,"text":"アーランドの元騎士で自称騎士。冒険者たちの現場監督的立場を続けており、放浪する元王を追い続ける。"},{"spoiler":false,"text":"アールズではメルル姫に出会うことで、騎士熱が再燃する。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"かつてアーランド王国で騎士を務めていた男性。現在はアーランド全域の警備を仕事とする『警備団』の団長を務め、各地を転々としている。"},{"spoiler":false,"text":"堅物かつ真面目な人物で自己を律しようとする気持ちが強い。しかし心の奥底には熱いものが渦巻いており、時としてその感情が表出することも。"}],"source":"bangumi","sourceCharacterId":"68543"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"68543","value":"警备团团长"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/284bd851a733362156794599c80cadda593af94a1c7fb779ee21a91a62d26563.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/876a62afee353f92481802402f16dde145c9b2ad20a11af208d322eb72e5dbfd.webp","width":152,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小杉十郎太","creatorId":"vndb:s743","sourcePersonId":"vndb:s743","canonicalEntityId":"vndb:s743","name":"小杉 十郎太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:68543:4302:1","source":"bangumi"}]},{"characterId":"char_bangumi_68546","characterName":"Lionela Heinze","sourceIds":{"bangumi":[{"characterId":"68546","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"Lionela Heinze","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"151"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A11　　16岁"},{"spoiler":false,"text":"喜欢和人偶交流的少女，总是带着两个人偶，被罗罗娜称为「小莉欧」，性格比较内向，极度怕生。为了改变这个性格，她开始试着用两个人偶进行各种各样的表演。"},{"spoiler":false,"text":"猫のぬいぐるみと共に人形劇をしながら旅をしている少女。大道芸人でありながら極度の恥ずかしがり屋でもある。2匹のぬいぐるみと会話ができるがそれが彼女の秘密と関係しているようだ。"},{"spoiler":false,"text":"A20 37岁"},{"spoiler":false,"text":"アーランドで酒場「アラホロ亭」を営んでいる女性。"},{"spoiler":false,"text":"かつては人見知りで恥ずかしがり屋だったが、ロロナとの出会いや各地を旅したことによって、人当たりの良い社交的な性格に成長した。どんな事情がある人であっても平穏に過ごせる場所を作りたい、と酒場「アラホロ亭」を設けた。"}],"source":"bangumi","sourceCharacterId":"68546"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"68546","value":"酒馆店主"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a64144be8be665efa2631fe9e1f879f9d43111c06234e29f8c2a9e8a213550f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/973425fda80d1ed91b8a35715ab7aedcf2a4972e00e0b5e95f91284f15dd4851.webp","width":178,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真堂圭","creatorId":"vndb:s41","sourcePersonId":"vndb:s41","canonicalEntityId":"vndb:s41","name":"真堂 圭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:68546:4905:1","source":"bangumi"}]},{"characterId":"char_bangumi_78193","characterName":"ティファナ・ヒルデブランド","sourceIds":{"bangumi":[{"characterId":"78193","match":"source-roster","subjectId":"11436"},{"characterId":"78193","match":"source-roster","subjectId":"19494"},{"characterId":"78193","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"ティファナ・ヒルデブランド","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"31"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"}},"descriptions":[{"segments":[{"spoiler":false,"text":"阿兰德某杂货店店主。很多年前这还是一所夫妻店，后来自从丈夫辞世后就变成了她独自一人打理小店所有的事情。作为一个寡妇总给人以红颜薄命的体弱美人的感觉，虽然年过而立但是相貌依旧美丽可爱。在城里的男性之中人气高涨，店内时常是大叔云集。本人的性格很和善，生意也做得很红火。,PS：雖然個性和善，但喝醉酒之后发酒疯是很厉害的……,,声优与菲丽·艾哈特是同一人（都是大垣理香。当然不看声优表很难听出）。"}],"source":"bangumi","sourceCharacterId":"78193"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cddce338a76acab34f27815051a0ee518eba5602d5d0f290d958c421c364772c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9efbee8da03c6bb251a358d52449b04bf3e5fd246fca552aae9e8b6dfc08849e.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大垣理香","creatorId":"vndb:s2986","sourcePersonId":"vndb:s2986","canonicalEntityId":"vndb:s2986","name":"大垣 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:78193:19056:1","source":"bangumi"}]},{"characterId":"char_bangumi_78194","characterName":"エスティ・エアハルト","sourceIds":{"bangumi":[{"characterId":"78194","match":"source-roster","subjectId":"11436"},{"characterId":"78194","match":"source-roster","subjectId":"19494"},{"characterId":"78194","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"エスティ・エアハルト","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"165"}},"descriptions":[{"segments":[{"spoiler":false,"text":"最早登场于《罗罗娜的工作室》，是一个非常努力工作的冒险者公会的接待员，也是个非常善良并乐于助人的好人。但随着故事的发展，艾斯蒂害怕自己再也嫁不出去的恐惧与日俱增，终于在《托托莉的工作室》（快奔三）剧情开始前夕，辞去了工作满大陆寻找她那命中注定但不知是否存在的丈夫去了，接待员的工作则由她的妹妹接任。,在《梅露露的工作室》中，已经40岁的艾斯蒂似乎已经放弃了结婚的念头，并专注于她的事业。但她本人显然闷闷不乐，尤其是喝醉酒的时候，经常对妹妹大吐苦水。,不过听闻了罗罗娜制做了返老还童药水后，重燃了希望？,"}],"source":"bangumi","sourceCharacterId":"78194"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64ba4eae9a4d6263d6e39cc0c086ed9172fada565ee521dfc761380469d8a663.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a337fa43f82ffe1e9409752ad2f0113cb198f865aec1f738a5e777c91e99569a.webp","width":174,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤利奈","creatorId":"vndb:s360","sourcePersonId":"vndb:s360","canonicalEntityId":"vndb:s360","name":"佐藤 利奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:78194:4670:1","source":"bangumi"}]},{"characterId":"char_bangumi_78195","characterName":"アストリッド・ゼクセス","sourceIds":{"bangumi":[{"characterId":"78195","match":"source-roster","subjectId":"11436"},{"characterId":"78195","match":"source-roster","subjectId":"19494"},{"characterId":"78195","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"アストリッド・ゼクセス","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"40"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"162"}},"descriptions":[{"segments":[{"spoiler":false,"text":"阿兰德系列最伟大的炼金师，也是罗罗娜的老师。虽然被称为一个极端的天才，但因为她的懒惰和刻薄以及诡秘，更多的人视她为魔女，在阿兰德王国算得上是臭名昭著。,阿斯特里德曾经有一个极其敬爱的老师，不过那个人并没有多少炼金天赋，因此被人们看不起，之后更是被辞退，在失业后不久死去。至此阿斯特里德开始仇视大多数人，尽管拥有极强的炼金能力，她也只会接自己感兴趣的工作。,阿斯特里德曾在几年前医治过罗罗娜的父母，并收罗罗娜为徒。但是阿斯特里德无疑是个差劲的老师，睡觉+调戏罗罗娜成为了她的主要活动，炼金术方面基本上只丢给罗罗娜一些书和笔记让她自学，为日后罗罗娜独有的“罗罗娜式教学法”埋下了伏笔。不过在《新*罗罗娜的工作室》里面，必须承认，大老师带着罗罗娜去湖边踏青真是goodjob！,在《罗罗娜的工作室》剧情开始后，见习骑士斯特克前来传达阿斯特里德工房将被关闭的消息。对此并不上心的阿斯特里德当即拍板决定——阿斯特里德工房改名罗罗娜工房，之后的一系列业绩审查任务也都由罗罗娜全权负责，结果刚刚得到工房的主角就不得不为拯救自己的工房而东奔西走，大老师则是充分发挥其尖锐的观察力，谋定而动恶意围观。不过为了弥补罗罗娜没有妖精帮忙的短板，大老师制造了人造人“霍姆”来帮助罗罗娜收集材料（在《托托莉的工作室》中罗罗娜则用同样的技术制造了小人造人“吉姆”来收集复制材料），在炼金术士大赛（剧情结束）后，阿斯特里德带着霍姆前往了她老师的故乡阿鲁兹王国开了家炼金术商店。,PS：为了刺激罗罗娜的好姬友库迪利亚，霍姆的身高为142cm，仅比库迪利亚高2cm，因此当罗罗娜制造出身高仅有60cm的吉姆时……感动ing,《梅露露的工作室》中，罗罗娜找到了12年未曾谋面的恩师和霍姆。此时恰逢阿斯特里德在研究青春药水，于是师徒两人一起试验，但后喝下药水的罗罗娜却产生了副作用，原本打算恢复成14岁的身体缩水到了8岁，闹得众人还得研究青春药水的反向药水——成长药水"}],"source":"bangumi","sourceCharacterId":"78195"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25099885b3273dcfc1b1fb621bbcc5b1201e76e51034109be29d4d2313107613.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44ce3e6630f2d32ef38ea690ad58501c591bd9bec21b639c6c3f3fdde092acd0.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中敦子","creatorId":"vndb:s78","sourcePersonId":"vndb:s78","canonicalEntityId":"vndb:s78","name":"田中 敦子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:78195:3873:1","source":"bangumi"}]},{"characterId":"char_bangumi_78213","characterName":"小姆","sourceIds":{"bangumi":[{"characterId":"78213","match":"source-roster","subjectId":"11436"},{"characterId":"78213","match":"source-roster","subjectId":"19494"},{"characterId":"78213","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"小姆","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"0"},"height":{"reviewState":"source-only","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"罗罗娜瞒着托托莉偷偷制造的人造人自动组装装置“小人造人来来”的产品，不过和学园都市的饮料机一样，吞了材料后不工作，必须用力敲打，然后就会掉落一地的人造人易拉罐……,同罗罗娜那位师傅制作的人造人的不同点在于不会说话只会叫“吉姆”，相对的表情就比较丰富了。不过这些小鬼头是不是能充分领会主人的意图这是一个问题（汗）。食物就是派，吃不到的话就会丧失干劲，真正的nopies,no gains。,制造材料需要用到一种神秘的人造人生命之元……游戏中一共可以拥有5只吉姆，算是替代以前工房作品中的小精灵来帮助玩家收集材料。,PS：身高139.8cm的库酱对吉姆酱的身高很满意，感动得都哭了— —！,PS2：在制作人造人之前，罗罗娜会问托托莉喜欢的是男孩子还是女孩子，这直接关系到第一只吉姆的性别。,A20中长大的小姆是托托莉让小姆们成长，作为小姆战队的一员支援各地的炼金术士，A20中琵亚妮雅的小姆叫小姆龙。小姆龙称呼托托莉为大主人(Grand Master)，琵亚妮雅为主人，露露亚为小小主人(Nano Master)。长大后会说话并逐渐获得情感的小姆们十分尊敬托托莉，除了她命名的品味，以及仍然喜欢吃派。,,"}],"source":"bangumi","sourceCharacterId":"78213"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d09d44ca5953605b941e43391fa1c643479c1a70895582ef17115119ad20111e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/672f0291ff0042da42d2e323f3cab01d18f78f8943d751ddc8acdb9e3bc7f573.webp","width":179,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_78390","characterName":"Filly Erhard","sourceIds":{"bangumi":[{"characterId":"78390","match":"source-roster","subjectId":"11436"},{"characterId":"78390","match":"source-roster","subjectId":"19494"},{"characterId":"78390","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"Filly Erhard","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"156"}},"descriptions":[{"segments":[{"spoiler":false,"text":"《罗罗娜的工作室》中的接待员艾斯蒂的妹妹，因为挺中意接待员工作的姐姐辞掉工作为了寻找丈夫出去旅行了而被迫继承了她的工作。从相貌上看和她的姐姐也几乎没什么分别，甚至和她姐姐一样喜欢打探别人的桃色新闻。不过性格就差很多了，刚开始工作时（21岁）因为自身怕生胆小，工作上经常犯错，给外人的感觉就是工作比较勉强不怎么认真。经过六年锻炼后，现在已经不再害羞了，工作方面也有了很大进步，在《梅露露的工作室》中还陪同托托莉一起转战阿鲁兹王国。不过喜爱妄想的个性却愈演愈烈，不管什么都能作为妄想的题材……,有很强的妄想癖。只要看到两个人——尤其是两个女孩子在交谈，都会幻想她们是在谈情说爱（百合妄想）。,"}],"source":"bangumi","sourceCharacterId":"78390"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70e525e4e327b35d91bfc4b1588ac8b5bf557ce3eb206db0a6b9f3dfbcef0687.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41702a8fa81f5a947d91770335c011558748460c9bb0bcdd7a3af9cf17a694cf.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大垣理香","creatorId":"vndb:s2986","sourcePersonId":"vndb:s2986","canonicalEntityId":"vndb:s2986","name":"大垣 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2250:78390:19056:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p910","sourceCompanyId":"egs:brand:766","canonicalEntityId":"vndb:p910","name":"ガスト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15375:766","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
