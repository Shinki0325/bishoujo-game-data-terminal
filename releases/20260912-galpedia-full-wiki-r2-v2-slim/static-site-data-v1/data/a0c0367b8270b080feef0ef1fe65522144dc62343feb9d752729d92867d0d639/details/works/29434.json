":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An old woman and distant relative of Suzu who she lives with at the temple. She took in Suzu after her parents’ death and taught to play koto, and is like a foster parent to her. She is a high priest who is well-trusted by the locals, and while old in age, she is lively and a major lover of junk food like pizza, meat, and fried foods."}],"source":"vndb","sourceCharacterId":"c90667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e174bd6297d4b4462f814247c46d33ac9287804d1d6cec452c2aab4de486bd46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a496732da600eee85d33f14fed1a8b34a2c3049569a168167151feb32e42122.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篠永 百合","creatorId":"vndb:s21189","sourcePersonId":"vndb:s21189","canonicalEntityId":"vndb:s21189","name":"篠永 百合","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84366","source":"vndb"}]},{"characterId":"char_vndb_c90668","characterName":"小夜子","sourceIds":{"vndbCharacterId":"c90668"},"originalCharacterName":"小夜子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful woman with black hair who appears in Suzu’s dreams as her “older sister.” In those dreams, Suzu often sees her playing the koto by the window, and while she is the spitting image of Yuuka, her expressions and tone are kinder and warmer. She seems to be in a classroom in Kagurahara Girls Academy, but Suzu does not recognize her uniform. What is the connection between Sayoko and Suzu…?"}],"source":"vndb","sourceCharacterId":"c90668"}],"profileFacts":[],"meta