reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a relative of Suzuki from Izumo 2 ~Gakuen Kyousoukyoku~ and she wants to become a journalist like him."}],"source":"vndb","sourceCharacterId":"c40945"},{"segments":[{"spoiler":false,"text":"駆を新聞部に引きずり込んだ少女。"},{"spoiler":false,"text":"本当は、オカルト研究部を作りたかったのだが、許可が下りなかったため、新聞部の名目でオカルト活動にいそしんでいる。"},{"spoiler":false,"text":"夜の繁華街で絡まられている所を、駆に助けてもらって以降、一方的につきまとい、駆を振り回している。"}],"source":"egs","sourceCharacterId":"21066","sourceWorkId":"8993","spoiler":false},{"segments":[{"spoiler":false,"text":"新聞部所属。強引でわがままですが、根が善良なために嫌味がない性格。派手でもなく、優等生でもなく、駆同様クラスのはみ出し者。"},{"spoiler":false,"text":"オカルト系の話に目が無く、学校がオカルト研究部の新設を許可してくれないので、新聞部という名目で作ってしまおうと考えています。 言動からバカと思われがちですが、ＩＴ系に強く、インターネットなども自在に使いこなしています。"},{"spoiler":false,"text":"夜、繁華街で遊んでいたところを、フラレて根に持っていた男に絡まれ、そこを同級生の駆に助けてもらったことが始まり。その後色々話すうちに駆を気に入って、以後一方的につきまとい振り回しています。"}],"source":"bangumi","sourceCharacterId":"97443"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce83fa9afb264f09a145ce8ca1d143ee8ef1f787aed804af5d1b61de385bc61a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9ba0ad55211576e27a0569ee1700c16d559434454e3a59090be41d31160f7fc0.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲乃藍里","creatorId":"vndb:s436","sourcePersonId":"vndb:s436","canonicalEntityId":"vndb:s436","name":"咲乃 藍里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266126:97443:5692:1","source":"bangumi"}]},{"characterId":"char_c40946","characterName":"吾妻 鈴鹿","sourceIds":{"bangumi":[{"characterId":"97446","match":"exact-normalized-name-in-linked-work","subjectId":"266126"}],"egsCharacterIds":["21069"],"vndbCharacterId":"c40946"},"originalCharacterName":"吾妻 鈴鹿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the aunt of Kakeru and his younger sister Maina. She was the younger sister of Kakeru and Maina's father."}],"source":"vndb","sourceCharacterId":"c40946"},{"segments":[{"spoiler":false,"text":"学生会の副会長で、剣道部所属。"},{"spoiler":false,"text":"駆とは血縁のない親戚で、彼の事情もある程度把握している。"},{"spoiler":false,"text":"そのため、少なからず想っているのだが、立場上、表に出すわけにはいかず、いつも困っているらしい。"},{"spoiler":false,"text":"一族の跡目争いに巻き込まれていて、人間関係で辛い思いをしている。"}],"source":"egs","sourceCharacterId":"21069","sourceWorkId":"8993","spoiler":false},{"segments":[{"spoiler":false,"text":"学生会の副会長で剣道家。駆とは血縁のない親戚のため、彼の家庭の事情もある程度知っています。少なからず想ってもいるのですが、立場上そうも行かなくていつも困った顔をしています。容姿通りとてもまじめな性格。"},{"spoiler":false,"text":"一族の跡目争いに巻き込まれており、人間関係で色々と辛い思いをしています。"}],"source":"bangumi","sourceCharacterId":"97446"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e48fe10e96f7f6baaacea98dd54f502e843448895ac7245ef43429d73508dea9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ecf1f83355d65ea42131791a047bb1cb4128a471124ba0bb4721ee24d743f40.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"〆野潤子","creatorId":"vndb:s5676","sourcePersonId":"vndb:s5676","canonicalEntityId":"vndb:s5676","name":"〆野 潤子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266126:97446:5080:1","source":"bangumi"}]},{"characterId":"char_c40948","characterName":"宮村 栞","sourceIds":{"bangumi":[{"characterId":"97445","match":"exact-normalized-name-in-linked-work","subjectId":"266126"}],"egsCharacterIds":["21068"],"vndbCharacterId":"c40948"},"originalCharacterName":"宮村 栞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"駆のクラスメイトで、図書委員所属。"},{"spoiler":false,"text":"彼女に関係した事件を解決した後、新聞部に引きずり込まれた被害者2号。"},{"spoiler":false,"text":"引っ込み思案でおとなしい、気弱でか弱い女の子、……に見えるが、徐々にそのすごい性格が明らかになっていくだろう。"}],"source":"egs","sourceCharacterId":"21068","sourceWorkId":"8993","spoiler":false},{"segments":[{"spoiler":false,"text":"駆のクラスメイトで、図書委員。彼女にまつわる事件の解決後、新聞部に無理矢理引き込まれます。学生会の書記を務めていたこともあります。"},{"spoiler":false,"text":"一見、引っ込み思案でおとなしい、気弱でかよわい女の子風ですが…"}],"source":"bangumi","sourceCharacterId":"97445"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7efc4693c937e26b04e871d4f25b6f5c4617f60b009b50ec768bab60ac5b8793.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/669b31a8ea95904cfbc5610d99354a55e88a4ae5fda6156c69682db6af787f44.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北原美和","creatorId":"vndb:s1108","sourcePersonId":"vndb:s1108","canonicalEntityId":"vndb:s1108","name":"北原 美和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266126:97445:16229:1","source":"bangumi"}]},{"characterId":"char_c40949","characterName":"カヤノ","sourceIds":{"bangumi":[{"characterId":"97444","match":"exact-normalized-name-in-linked-work","subjectId":"266126"}],"egsCharacterIds":["21067"],"vndbCharacterId":"c40949"},"originalCharacterName":"カヤノ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異世界“ネノクニ”が誇る天然系戦巫女。"},{"spoiler":false,"text":"物事を真面目にこなそうとするが、肝心なところでミスをする、難しいことは舌を噛むという、ドジっ娘属性を備えている。"},{"spoiler":false,"text":"だが、微力ながらも「夢を紡ぐ力」を持っており、近辺の村を束ねる連合の長を務める一面も。"},{"spoiler":false,"text":"村で起こった異変を調べているうちに、“アシハラノクニ”に関わるものであることを突き止めた彼女は、自ら次元の挟間へ赴くのだが……。"}],"source":"egs","sourceCharacterId":"21067","sourceWorkId":"8993","spoiler":false},{"segments":[{"spoiler":false,"text":"ネノクニの天然系戦巫女。本人は至って真面目なのですが、肝心なところでドジを踏むことが多い。難しいことを言おうとすると舌を噛むことも。"},{"spoiler":false,"text":"カグツチとアマテラスの治めるクニよりもはるか南の村落の長で、微弱ながら「夢を紡ぐ力」を持ち、近辺の村落をまとめる連合の長も勤めています。"},{"spoiler":false,"text":"ＩＺＵＭＯ２のサクヤとは幼い頃に一度だけ対面したことがあり、その時以来「サクヤお姉さま」と慕っています。"}],"source":"bangumi","sourceCharacterId":"97444"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec95f0018c0061dddf98dfece78ef532c3bedc3f3cf1cd27975694391fda400a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/303437e516e48e44053beb6669730f7c385940c2b2e635ec65bfdfb94f080119.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南川のりこ","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266126:97444:20327:1","source":"bangumi"}]},{"characterId":"char_c40951","characterName":"笹山 芙由子","sourceIds":{"bangumi":[{"characterId":"97447","match":"exact-normalized-name-in-linked-work","subjectId":"266126"}],"egsCharacterIds":["21070"],"vndbCharacterId":"c40951"},"originalCharacterName":"笹山 芙由子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"何かと駆を叱る、クールな数学教師。"},{"spoiler":false,"text":"学生を思う気持ちが人一倍強く、駆を心配するが故に、つい口を出してしまう。"},{"spoiler":false,"text":"裕福な家庭に生まれ、幼いころより英才教育を受けてきた才女だが、基本的な生活能力が欠けており、特に料理の腕は壊滅的。"}],"source":"egs","sourceCharacterId":"21070","sourceWorkId":"8993","spoiler":false},{"segments":[{"spoiler":false,"text":"クールな数学教師。喋り方は堅苦しいのですが、学生を思う優しさは人一倍あります。 何かと駆を叱ることが多いですが、それも彼のことを心配しているが故。駆は最初煙たがっていましたが、やがて感謝するようになります。"},{"spoiler":false,"text":"実家暮らしで親に甘えているせいか、基本的な生活能力に欠けた所があります。料理も致命的にダメ。コンピュータゲーム全般に強く、特に格闘ゲームマニアです。"}],"source":"bangumi","sourceCharacterId":"97447"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c392cc66d3aa545bbf092435aadce597f3ddb7dbc23aca001baf2f3b3174947.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/560c364154cda09027d56ab11d438db61f65a4c18a055b07edd4e899bf2f4884.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小橋知子","creatorId":"vndb:s2331","sourcePersonId":"vndb:s2331","canonicalEntityId":"vndb:s2331","name":"小橋 知子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266126:97447:5224:1","source":"bangumi"},{"creditedName":"山崎 杏","creatorId":"vndb:s5736","sourcePersonId":"vndb:s5736","canonicalEntityId":"vndb:s5736","name":"山咲 杏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:6353","source":"vndb"}]},{"characterId":"char_c41281","characterName":"夜刀神","sourceIds":{"bangumi":[{"characterId":"97453","match":"exact-normalized-name-in-linked-work","subjectId":"266126"}],"egsCharacterIds":["21076"],"vndbCharacterId":"c41281"},"originalCharacterName":"夜刀神","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"蛇を操る水の神。"},{"spoiler":false,"text":"守護精霊の一人で、その転生体が駆と同じ学園に通っているらしい。"}],"source":"egs","sourceCharacterId":"21076","sourceWorkId":"8993","spoiler":false},{"segments":[{"spoiler":false,"text":"姿を見たものに災いを為す蛇の神。"},{"spoiler":false,"text":"何百年もの間封印され、とある人物の中で眠っていたところを何者かに覚醒させられ、宿主の憎悪に同調して駆たちを学園ごと狭間の世界へと落とし込んでしまいます。"}],"source":"bangumi","sourceCharacterId":"97453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b87531c7a2b88d2cd36461579f89e28e5074fb96d22962e76dc7e0083cddd244.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7a81a8178b32145621bfdd54b0141a0c292d9717afb5efc7c0afeb5a0b22190.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒河奈美","creatorId":"vndb:s1062","sourcePersonId":"vndb:s1062","canonicalEntityId":"vndb:s1062","name":"本山美奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266126:97453:4754:1","source":"bangumi"}]},{"characterId":"char_c41282","characterName":"黒崎 夕子","sourceIds":{"bangumi":[{"characterId":"97459","match":"exact-normalized-name-in-linked-work","subjectId":"266126"}],"egsCharacterIds":["21081"],"vndbCharacterId":"c41282"},"originalCharacterName":"黒崎 夕子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"駆の同級生。"},{"spoiler":false,"text":"生徒会長・吾妻幸伸の彼女だが、身体のみが目当ての幸伸に邪険に扱われ、精神的に追い込まれてしまう。"},{"spoiler":false,"text":"さらに、引っ越しで街を去る日が迫る現実が追い打ちとなり、彼女は、とあるサイトで知った黒魔術に手を染めてしまう……。"}],"source":"egs","sourceCharacterId":"21081","sourceWorkId":"8993","spoiler":false},{"segments":[{"spoiler":false,"text":"駆の同級生。"},{"spoiler":false,"text":"幸伸と付き合っていましたが、身体のみが目当てだった幸伸には邪険に扱われ、さらに引っ越しでこの街を去る日が迫っているため、精神的に追い詰められた彼女は、とあるサイトで知った黒魔術に手を染めてしまうことになります。"}],"source":"bangumi","sourceCharacterId":"97459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19e9fc662490aff53aef5539ba7d1c130eacf