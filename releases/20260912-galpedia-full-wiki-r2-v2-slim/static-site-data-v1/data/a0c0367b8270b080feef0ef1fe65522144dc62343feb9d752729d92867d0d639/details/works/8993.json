-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"守護精霊の一人で、天部衆と呼ばれる一族の一人。"},{"spoiler":false,"text":"芸術と音楽の女神。"},{"spoiler":false,"text":"平和を愛する女性であり、弁財天と吉祥天の緩衝材的な役割をこなしている。"}],"source":"egs","sourceCharacterId":"21077","sourceWorkId":"8993","spoiler":false},{"segments":[{"spoiler":false,"text":"平和を愛する芸術と音楽の女神。"},{"spoiler":false,"text":"非常に物静かな女性で、そのためいつも口喧嘩の絶えない弁財天と吉祥天をなだめる損な役回りになってしまっています。"}],"source":"bangumi","sourceCharacterId":"97454"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/754a10762f80f6ff6cd8a73b400a7dae85b3c7469a67a1503ea2acb8369feb68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea739a1a9233c772297fb10ae6532edcdfd25f63392b61ae20bca195aa436a72.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"廣瀬仁美","creatorId":"vndb:s2330","sourcePersonId":"vndb:s2330","canonicalEntityId":"vndb:s2330","name":"廣瀬 仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266126:97454:6303:1","source":"bangumi"}]},{"characterId":"char_c42060","characterName":"獏","sourceIds":{"bangumi":[{"characterId":"97452","match":"exact-normalized-name-in-linked-work","subjectId":"266126"}],"egsCharacterIds":["21075"],"vndbCharacterId":"c42060"},"originalCharacterName":"獏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悠久の時を生きる、守護精霊。"},{"spoiler":false,"text":"他人の夢を好み、気に入った夢には入り込んでしまうことも。"},{"spoiler":false,"text":"長く生きているわりに、子供っぽい外見をしているが、精神年齢も子供なので、違和感はまったくない。"}],"source":"egs","sourceCharacterId":"21075","sourceWorkId":"8993"