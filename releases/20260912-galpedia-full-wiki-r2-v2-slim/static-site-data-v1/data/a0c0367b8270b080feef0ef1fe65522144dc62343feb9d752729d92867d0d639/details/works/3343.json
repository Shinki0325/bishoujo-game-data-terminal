{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3343","model":{"presentationWorkId":"vndb:v4317","staff":{"artwork":[{"creditedName":"丹下ゲンタ(氷雨げんた)","creatorId":"vndb:s4217","sourcePersonId":"egs:creator:1483","canonicalEntityId":"vndb:s4217","name":"丹下ゲンタ(氷雨げんた)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:4957","source":"egs"},{"creditedName":"トシぞー","creatorId":"vndb:s3065","sourcePersonId":"egs:creator:1339","canonicalEntityId":"vndb:s3065","name":"トシぞー","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:4958","source":"egs"}],"scenario":[{"creditedName":"シナリオ制作チームさるさる","creatorId":"egs:creator:5656","sourcePersonId":"egs:creator:5656","canonicalEntityId":"egs:creator:5656","name":"シナリオ制作チームさるさる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:272867","source":"egs"},{"creditedName":"紺野かほる","creatorId":"vndb:s12719","sourcePersonId":"egs:creator:2154","canonicalEntityId":"vndb:s12719","name":"紺野かほる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:4959","source":"egs"}],"music":[{"creditedName":"m.c.TOM","creatorId":"vndb:s6343","sourcePersonId":"egs:creator:2622","canonicalEntityId":"vndb:s6343","name":"m.c.TOM","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7900","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c59158","characterName":"三条 めぐみ","sourceIds":{"bangumi":[{"characterId":"149052","match":"exact-normalized-name-in-linked-work","subjectId":"230356"}],"egsCharacterIds":["26884"],"vndbCharacterId":"c59158"},"originalCharacterName":"三条 めぐみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tomoya’s stepsister — a bright, energetic girl who is rather typical in disliking chores. Super curious about sex and totally down to get frisky with her brother. Has a hint of masochism and sees him as her \"gold standard\" for men. She’s also pretty possessive and gets jealous easily."}],"source":"vndb","sourceCharacterId":"c59158"},{"segments":[{"spoiler":false,"text":"主人公の義妹。"},{"spoiler":false,"text":"明朗快活で、はきはきした女の子。"},{"spoiler":false,"text":"エッチに興味津々なお年頃で、主人公との禁断のセックスで性に目覚める。"},{"spoiler":false,"text":"独占欲が強く、ヤキモチ焼き。"},{"spoiler":false,"text":"ちょっとマゾッ気があるらしいが……。"}],"source":"egs","sourceCharacterId":"26884","sourceWorkId":"3343","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義妹にあたる、明るく元気ではきはきした女の子。"},{"spoiler":false,"text":"性格は家の手伝い等はめんどくさがるような一般的な娘。"},{"spoiler":false,"text":"Ｈへの興味は大きく、積極的に兄とのプレイに興じている。"},{"spoiler":false,"text":"ちょっとマゾッ気アリ。"},{"spoiler":false,"text":"兄は「男の基準」だった。"},{"spoiler":false,"text":"独占欲は強いらしく、やきもち焼きらしい。"}],"source":"bangumi","sourceCharacterId":"149052"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bde6229ec624349af9246f15cdd2cd2ab8fa2b7262d659ebdf7be60f28a27358.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d98fbceee05e96f0ea9a4ed3ae97ce4dab8cb8ae28678f577db5ac58180782f9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230356:149052:4830:1","source":"bangumi"}]},{"characterId":"char_c59160","characterName":"名那瀬 優子","sourceIds":{"bangumi":[{"characterId":"149053","match":"exact-normalized-name-in-linked-work","subjectId":"230356"}],"egsCharacterIds":["26885"],"vndbCharacterId":"c59160"},"originalCharacterName":"名那瀬 優子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tomoya’s cousin how shows up later with her parents (the protagonist’s aunt and uncle). Catches the siblings in the act and schemes to turn Tomoya — who she’s had her eye on — into her plaything. A wildcard who does whatever she finds fun, including joining their escapades just for kicks. Acts like a carefree big sis but hides a sadistic streak, preferring to dominate. At first, she secretly joins the siblings’ play without tipping off the sister, but if exposed, she’ll drag the sister into a threesome for her own amusement."}],"source":"vndb","sourceCharacterId":"c59160"},{"segments":[{"spoiler":false,"text":"主人公の従姉妹。"},{"spoiler":false,"text":"面白ければ何でもやってしまう、あっけらかんとした性格の女性。"},{"spoiler":false,"text":"主人公を玩具にしたいと以前から思っており、主人公と義妹の関係を知ったときには、これ幸いと大喜び。"},{"spoiler":false,"text":"早速、主人公を脅迫し、エッチな関係に♪"},{"spoiler":false,"text":"サドッ気の強い彼女は、責めながら楽しむエッチが好み。"},{"spoiler":false,"text":"いずれは主人公の義妹も交えて3Pを楽しもうと目論んでいるが……。"}],"source":"egs","sourceCharacterId":"26885","sourceWorkId":"3343","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従兄弟に当たる。"},{"spoiler":false,"text":"物語後半に両親（主人公には叔父、叔母）と共に本家へ遊びに来る。"},{"spoiler":false,"text":"二人のプレイを看破し、前から手をつけたかった主人公をおもちゃにしようと画策。"},{"spoiler":false,"text":"自分が面白いと思う事なら何でもやってのける明け透けな性格で、「面白いから」の一言でプレイに参加する。普段はちゃらんぽらんお姉さん。"},{"spoiler":false,"text":"内心はかなりサドッ気が強く、主人公を責め立てる側が基本スタイル。"},{"spoiler":false,"text":"参加当初は妹に悟られないように妹と兄とのプレイに参加しているが、選択により12日目に妹にバレると一転、妹も自分のおもちゃにして3Pを企む。"}],"source":"bangumi","sourceCharacterId":"149053"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d97006b59a4f411f16c52c409e53c2ec0