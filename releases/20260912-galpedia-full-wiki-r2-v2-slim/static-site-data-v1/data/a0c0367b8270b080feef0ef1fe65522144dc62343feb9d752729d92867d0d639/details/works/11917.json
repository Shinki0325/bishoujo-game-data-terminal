s":"source-native","relationId":"vndb:vn-staff:23050","source":"vndb"},{"creditedName":"天ヶ咲 麗","creatorId":"vndb:s4314","sourcePersonId":"vndb:s4314","canonicalEntityId":"vndb:s4314","name":"天ヶ咲 麗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23054","source":"vndb"},{"creditedName":"与呼太","creatorId":"vndb:s4680","sourcePersonId":"vndb:s4680","canonicalEntityId":"vndb:s4680","name":"与呼太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23056","source":"vndb"},{"creditedName":"wight","creatorId":"vndb:s5342","sourcePersonId":"vndb:s5342","canonicalEntityId":"vndb:s5342","name":"wight","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23057","source":"vndb"}]},"cast":[{"characterId":"char_c34899","characterName":"弓野 奏","sourceIds":{"bangumi":[{"characterId":"12131","match":"exact-normalized-name-in-linked-work","subjectId":"4492"}],"egsCharacterIds":["15908"],"vndbCharacterId":"c34899"},"originalCharacterName":"弓野 奏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"和樹と幼馴染の女の子で、実家は和樹が住むアパートの大家さん。"},{"spoiler":false,"text":"頼りになるお姉さんを自負しているが、和樹からは妹としか思われていない模様。"},{"spoiler":false,"text":"誰これ構わず尽くす姿は、どこか子犬を思い起こさせる。"},{"spoiler":false,"text":"本当に困ったときに「一生のお願い！」をしてしまう（現在までの記録、1216回）。"},{"spoiler":false,"text":"だが、奏がお願いをする相手は和樹だけで、それだけ信頼している現れでもある。"}],"source":"egs","sourceCharacterId":"15908","sourceWorkId":"11917","spoiler":false},{"segments":[{"spoiler":false,"text":"与和樹是青梅竹马关系的女孩，娘家是和樹所住公寓的房东。"},{"spoiler":false,"text":"虽然自负是被弟弟们与邻居们仰慕依靠的大姐姐，但和樹似乎只把她当妹妹看待。"},{"spoiler":false,"text":"不分对象尽心侍奉的姿态，总令人想起小狗。"},{"spoiler":false,"text":"真的麻烦的时候，只会向和樹拜托「一生的愿望！」（至今为止的记录 1,216回）。"},{"spoiler":false,"text":"灰姑娘式的贫乏技术，多次令周围的名流们大吃一惊。"}],"source":"bangumi","sourceCharacterId":"12131"}],"profileFacts":[{"label":"胸围（本版本）","value":"並乳","valueContext":"原文","source":"egs","sourceCharacterId":"15908","sourceWorkId":"11917","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"普通","valueContext":"原文","source":"egs","sourceCharacterId":"15908","sourceWorkId":"11917","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"少しくびれてる","valueContext":"原文","source":"egs","sourceCharacterId":"15908","sourceWorkId":"11917","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/832ffaeb6bcc1416881feb82d36cb329e0b0c8a1954c3a28aee996db899add17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6e4eea84cf8a83095291142aca04c37b1cffb6fa246c1559cbca124af00e659.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4492:12131:5052:1","source":"bangumi"}]},{"characterId":"char_c34900","characterName":"さらちゃん","sourceIds":{"bangumi":[{"characterId":"12132","match":"exact-normalized-name-in-linked-work","subjectId":"4492"}],"egsCharacterIds":["15909"],"vndbCharacterId":"c34900"},"originalCharacterName":"さらちゃん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御星家の次期当主で、学園では理事長の次に権限を持つ。"},{"spoiler":false,"text":"学園では誰も彼女に逆らえず、まさにトップ・オブ・トップのお嬢様。"},{"spoiler":false,"text":"まだ１年生だが圧倒的な存在感があり、あまり他人を寄せ付けない。"},{"spoiler":false,"text":"図々しく接してくる主人公とは「この私を誰だと思っているの？」といつも喧嘩をしている。"},{"spoiler":false,"text":"また、知り合いは山のようにいるが、友達はいないし、必要ないと思っている節がある。"}],"source":"egs","sourceCharacterId":"15909","sourceWorkId":"11917","spoiler":false},{"segments":[{"spoiler":false,"text":"星家的下期家主，在学园里拥有仅次于理事长的权限。"},{"spoiler":false,"text":"在学园里没人敢反抗她，正可谓是Top?of?Top的千金小姐。虽然才1年级却有着压倒性的存在感，不怎么容易接近。"},{"spoiler":false,"text":"对于厚颜无耻地接近的主人公「你以为本小姐是谁？」，总是在吵架。"},{"spoiler":false,"text":"此外，虽然熟人很多，却没有朋友，认为没有必要。"},{"spoiler":false,"text":"只在甜食上没有自制，一旦见到就会眼色大变。"}],"source":"bangumi","sourceCharacterId":"12132"}],"profileFacts":[{"label":"胸围（本版本）","value":"豊乳","valueContext":"原文","source":"egs","sourceCharacterId":"15909","sourceWorkId":"11917","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"丸みを帯びている","valueContext":"原文","source":"egs","sourceCharacterId":"15909","sourceWorkId":"11917","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"くびれてる","valueContext":"原文","source":"egs","sourceCharacterId":"15909","sourceWorkId":"11917","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e64874c3c817249c82df58c6fe7d7775ccb4fdad9a9f2c02f229ed38b72f0a9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/1400b54a8ea68f5cf31969257fa16112d98f510669c9a9a83d3dcb1112c1e1a7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4492:12132:4432:1","source":"bangumi"}]},{"characterId":"char_c34901","characterName":"セーラ・アップルトン","sourceIds":{"bangumi":[{"characterId":"12134","match":"exact-normalized-name-in-linked-work","subjectId":"4492"}],"egsCharacterIds":["15910"],"vndbCharacterId":"c34901"},"originalCharacterName":"セーラ・アップルトン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界のホテル王を父に持つ、アップルトン家のお嬢様。１年生。"},{"spoiler":false,"text":"「正々堂々と戦う」ことが大好き。呼吸するアメリカンジャスティス。"},{"spoiler":false,"text":"普段からノリが良く、ちょっとおバカでかわいい面を持つ。"},{"spoiler":false,"text":"和樹や奏と一緒に行動したいらしく、休み時間はいつも和樹たちのクラスにくる。"},{"spoiler":false,"text":"学園にやってきたのはこの春からで、彼女とダリルも正真正銘の新入生。"}],"source":"egs","sourceCharacterId":"15910","sourceWorkId":"11917","spoiler":false},{"segments":[{"spoiler":false,"text":"拥有一个身为世界旅馆王的父亲，アップルトン家的千金小姐，1年级学生。"},{"spoiler":false,"text":"超级喜欢『堂堂正正地比试』的美国判官（Amerikann Justice）。"},{"spoiler":false,"text":"平常很来劲，有着稍微笨蛋而又可爱的一面。"},{"spoiler":false,"text":"似乎想要与主人公和奏一起行动，尽管是隔壁班级，总是在休息时间来到主人公他们班。"},{"spoiler":false,"text":"在一切意义上误解了日本文化，将约会与相亲当成同义语使用等等，会无所顾忌地口吐错误的知识。"}],"source":"bangumi","sourceCharacterId":"12134"}],"profileFacts":[{"label":"胸围（本版本）","value":"爆乳","valueContext":"原文","source":"egs","sourceCharacterId":"15910","sourceWorkId":"11917","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"少し大きめ","valueContext":"原文","source":"egs","sourceCharacterId":"15910","sourceWorkId":"11917","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"きゅっとくびれてる","valueContext":"原文","source":"egs","sourceCharacterId":"15910","sourceWorkId":"11917","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b67e2e2d29da7310f24d5671b521d8da89ef5f1b8569b722217a091632523cc1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f4c409780c8562abc20b0242160cf1822c233dbd035661baf0d6c6716e2b0a2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4492:12134:4937:1","source":"bangumi"}]},{"characterId":"char_c34902","characterName":"秋津原 瑞穂","sourceIds":{"bangumi":[{"characterId":"12135","match":"exact-normalized-name-in-linked-work","subjectId":"4492"}],"egsCharacterIds":["15911"],"vndbCharacterId":"c34902"},"originalCharacterName":"秋津原 瑞穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rokuemon's personal maid."}],"source":"vndb","sourceCharacterId":"c34902"},{"segments":[{"spoiler":false,"text":"六右衛門のメイド。"},{"spoiler":false,"text":"学年的には１年生でありながらも、主人である六右衛門と同じ教室で授業を受けるため、３年生の学習をしており、しかも完璧という才女。"},{"spoiler":false,"text":"しかもメイドとしても完璧で、失敗をした姿を誰も見たことがない。"},{"spoiler":false,"text":"さらりとキツい突っ込みを入れたり、笑顔で「死ねばいいのに」と軽く言ってしまうような黒い性格。"}],"source":"egs","sourceCharacterId":"15911","sourceWorkId":"11917","spoiler":false},{"segments":[{"spoiler":false,"text":"六右衛門的女仆。虽然是1年级，为了与主人六右衛門在同一个教室学习在进行3年级学生的学习的才女。"},{"spoiler":false,"text":"作为女仆堪称完美，无人见过她失败的样子。"},{"spoiler":false,"text":"若无其事地进行强力吐槽，满面笑容地轻言「死去就好了」般性格腹黑。"},{"spoiler":false,"text":"语气虽然粗野但本性善良，暗地里为主人公他们应援着。"},{"spoiler":false,"text":"其实对于身高与胸围的尺寸都很迷你的事稍微有点纠结。"}],"source":"bangumi","sourceCharacterId":"12135"}],"profileFacts":[{"label":"胸围（本版本）","value":"ふくらみかけ","valueContext":"原文","source":"egs","sourceCharacterId":"15911","sourceWorkId":"11917","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"小さめ","valueContext":"原文","source":"egs","sourceCharacterId":"15911","sourceWorkId":"11917","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"アンダーと同じ","valueContext":"原文","source":"egs","sourceCharacterId":"15911","sourceWorkId":"11917","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5