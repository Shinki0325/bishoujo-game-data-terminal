668fe864671ac06e7a582382d69e8c9438f9f5d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c5672","characterName":"仲原 秀晃","sourceIds":{"vndbCharacterId":"c5672"},"originalCharacterName":"仲原 秀晃","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A freeter who graduated from high school one and a half years ago. He's now returned to his hometown to try to find his childhood friend."}],"source":"vndb","sourceCharacterId":"c5672"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c9547","characterName":"橘　唯奈","sourceIds":{"vndbCharacterId":"c9547"},"originalCharacterName":"橘　唯奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"In the same way that the protagonist lost his mother and decided to become a doctor, she lost her brother and decided on the same goal. However, she was not able to realize that dream... Now, she is seeking it. A person to whom she can entrust her dream. And the power to grant her own dream again."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9547"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a4efe26ba0f71139f22e3145c60ea74336bedad62dea55bb8166d8ae109c563.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aff11ef0b84589aaf8e91f15933eb7d0ee8a1a91c0ee9ed66b519c401b12b49.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9548","characterName":"二見　美魚","sourceIds":{"vndbCharacterId":"c9548"},"originalCharacterName":"二見　美魚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who was admitted to the hospital that the protagonist previously worked at. Her illness was unknown, an incurable disease with no treatment. She was discharged and able to live normally as long as she didn't have any fits. She feels affection towards the protagonist, who made eager efforts to cure her, but it is the feeling of a younger sister who depends too much on her older brother, not the feeling of love."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9548"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed334d13036924559deb1250de0a36d213cf96e206170035316e2b59ad1f3560.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90c446b8f1057e5ca8b268bb8e96dd042d91ee4d6f5403fb869bb64f9a2b4d70.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9549","characterName":"二見　真魚","sourceIds":{"vndbCharacterId":"c9549"},"originalCharacterName":"二見　真魚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A taciturn and unsociable girl, however, she is also a gentle girl that worries about her younger sister more than anyone else. She wants to become a doctor for the sake of curing her little sister. She holds light feelings of love for the protagonist who puts in maximum efforts without sparing anything to save patients. She wants to become a doctor like him."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9549"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e96ac5cc7a361598410ac7c32b15f163b6a9045c01d9d2cf6742ac66638ddf6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1215d847f8a8e52820fe7be58b27b14e8fe0cab7eec17870c6f02c2915aa7506.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9550","characterName":"汽京　紅葉","sourceIds":{"vndbCharacterId":"c9550"},"originalCharacterName":"汽京　紅葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The hospital's cheerful, carefree, positive thinker. But her manners are good, and the patients deeply rely on her. Her mother was a talented doctor, and she herself matches her mother's skills. Together with the protagonist, there are big expectations for the future."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9550"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0262dfee5c4268af56091b30c1ea96b08e772674d6c713c4703c965b98d047b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8064680530e3560d8d2ed0b196957a50426f673704732ed145fdabd7aaa13679.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9551","characterName":"一ノ瀬　木葉","sourceIds":{"vndbCharacterId":"c9551"},"originalCharacterName":"一ノ瀬　木葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who is honest with her own feelings - during fun times she will laugh with all her might, and during sorrowful times she will cry in a loud voice. She is mischievous and often gets caught by the nurses."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ec3da0b86af7673528f68ca77236c1b830310b9b366af298403dc9ec145fdb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aee3e589f1e0ae1a9ad459f776a2457a81e24454a6b4444e2b8450cce709b1e8.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9552","characterName":"三原　香澄","sourceIds":{"vndbCharacterId":"c9552"},"originalCharacterName":"三原　香澄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Konoha's friend that often visits her in the hospital. She is a very healthy girl that can't calm down if she doesn't move her body. Whatever she does, she does it noisily. She is older that Konoha, but she certainly doesn't seem like it. She loves and respects her twin brother in a way that is not just sibling affection. It has already reached the level of love between a man and a woman."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/874021e0c5defe9f728fbb1593be27b86c917a0d9c9c6c31fbe76c4115d3f3cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20bd407e238181513b0637b4b336091ec03fb4b1b21298eb8aa2b47ac9e011a0.webp","width":203,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p500","sourceCompanyId":"egs:brand:226","canonicalEntityId":"vndb:p500","name":"BasiL","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:1432:226","source":"egs"},{"companyId":"vndb:p500","sourceCompanyId":"vndb:p500","canonicalEntityId":"vndb:p500","name":"BasiL","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:25179:v10481","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
