{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"32449","model":{"presentationWorkId":"egs:32449","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_93985","characterName":"沼の魔女","sourceIds":{"bangumi":[{"characterId":"93985","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"沼の魔女","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"百騎兵の主で、沼をつかさどる自称・天才魔女。通称“魔女様”。敵対関係にある、悪しき「森の魔女」を滅ぼしこの世を沼で満たそうと狙っている。目的の為なら、手段を選ばず問わずのダークヒーロー。"}],"source":"bangumi","sourceCharacterId":"93985"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a925c4d44ce7fee6dad711711b21d59bbbd8c8972914db80be85b20070216ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/8498e37de090bc1db59e557a0ac323264e33bb049bcfff45d0084681bbbef910.webp","width":206,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊瀬茉莉也","creatorId":"vndb:s4898","sourcePersonId":"vndb:s4898","canonicalEntityId":"vndb:s4898","name":"伊瀬 茉莉也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24169:93985:4769:1","source":"bangumi"}]},{"characterId":"char_bangumi_93986","characterName":"百騎兵","sourceIds":{"bangumi":[{"characterId":"93986","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"百騎兵","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"プレイヤーの分身で、通称「百騎兵（ひゃっきへい）」。沼の魔女が召喚した伝説の魔神で、不死身の存在。本来は圧倒的力を持つらしいがどうも様子が違う模様……。"}],"source":"bangumi","sourceCharacterId":"93986"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb80a9cd64e8dab7d653cd9f0a12d6669940d2fd1bec497478c0bb007af7506e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/413adfaeb1a10a97ed2ed90eb0da8c7d58ae7805a2fc847ec983a33c47ca0872.webp","width":238,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水原薫","creatorId":"vndb:s1979","sourcePersonId":"vndb:s1979","canonicalEntityId":"vndb:s1979","name":"水原 薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24169:93986:5763:1","source":"bangumi"}]},{"characterId":"char_bangumi_93987","characterName":"忠実なるシモベ","sourceIds":{"bangumi":[{"characterId":"93987","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"忠実なるシモベ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"沼の魔女邸でメタリカの世話をする執事。忠実といいつつも、慇懃無礼な物言いが多い。メタリカからの度重なる理不尽な暴力により、体のあちこちにガタがきている。"}],"source":"bangumi","sourceCharacterId":"93987"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bddf844f090e2bb043a6a4fe11793450af586b2dca9d94ed0bef5fd1805aa555.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b365a76410b1345f6ff78e8e24f9ffecbebaddf671a84cb0e547a48f1bf720e.webp","width":256,"height":184,"source":"static-detail"},"actors":[{"creditedName":"遊佐浩二","creatorId":"vndb:s56","sourcePersonId":"vndb:s56","canonicalEntityId":"vndb:s56","name":"遊佐 浩二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24169:93987:4614:1","source":"bangumi"}]},{"characterId":"char_bangumi_93988","characterName":"異端審問官","sourceIds":{"bangumi":[{"characterId":"93988","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"異端審問官","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"魔女の呪いによって、体の一部が犬化している少女。まっすぐで誠実な性格をしているが、周りからは「犬姫」と陰口を叩かれ疎まれている。呪いを解くため、魔女の力を借りることを決意する。"}],"source":"bangumi","sourceCharacterId":"93988"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e73573a1d6eaa6e215fa831494f59a57549a03b4678ca78417e2ec55c32fe92f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b40196e0202b8682fd87bb867b96ce3902c363b5313092ecea2f1f4ea7838ec5.webp","width":244,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤村歩","creatorId":"vndb:s1703","sourcePersonId":"vndb:s1703","canonicalEntityId":"vndb:s1703","name":"藤村 歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24169:93988:4783:1","source":"bangumi"}]},{"characterId":"char_bangumi_93989","characterName":"星読みの羊飼い","sourceIds":{"bangumi":[{"characterId":"93989","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"星読みの羊飼い","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"テッタラ砂漠に住まう素直で明るい羊飼いで占星術の一種「星読み」の一族の出身。しかし本人は星読みよりも魔女に憧れを抱いてており、いつしか自分も魔女になりたいと夢見ている。"}],"source":"bangumi","sourceCharacterId":"93989"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c312da068ff25435cd70a437b4741a78fdf3a0fc19d1121bc1dee488560a7715.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e59b27462398bf18ee6c1489353808c0a7beb72e99f67195fc75671247bd7e7.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24169:93989:5900:1","source":"bangumi"}]},{"characterId":"char_bangumi_93990","characterName":"霧の魔女","sourceIds":{"bangumi":[{"characterId":"93990","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"霧の魔女","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"霧を扱う魔法に長けた無口な魔女。可憐な見た目とは裏腹に当代の魔女の中では屈指の実力者だとうわさされており魔女たちが集う会議で議長を務める。ただし、その場でも本人はほぼ口を開かず手にした話をする杖が仕切っている。"}],"source":"bangumi","sourceCharacterId":"93990"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f461eb37b7724d198d1fde6dbe2455064a4b5b7ff54d17d118b1c9733ea8598.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d265570936f45c6231973d482ef0786092e8a58eb1f8f4bf33b7cf42cd434f76.webp","width":256,"height":221,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24169:93990:3851:1","source":"bangumi"}]},{"characterId":"char_bangumi_93991","characterName":"トラブルメーカーな見習い魔女","sourceIds":{"bangumi":[{"characterId":"93991","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"トラブルメーカーな見習い魔女","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"もうすぐ正式に魔女になる予定の見習い魔女。とある魔女に弟子入りしており、ただいま修行中。何か狙いがあるのか、メタリカたちの周りをうろちょろする。"}],"source":"bangumi","sourceCharacterId":"93991"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5faf920d33c471e48c8e93af4328e77465e3543809fc2f20cedeb8fed0972a59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50389c86b59cfccca00e139fbb330d7d582c9fa58665cc87a2657528b4c7a36e.webp","width":256,"height":203,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24169:93991:3851:1","source":"bangumi"}]},{"characterId":"char_bangumi_93992","characterName":"華の大公爵","sourceIds":{"bangumi":[{"characterId":"93992","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"華の大公爵","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"メタリカの暮らす沼から少し離れた場所にある「ヴァレンティーヌ領」を治める領主であり、大公爵。その領内に、この世界で屈指の歓楽街を有しており、彼女自身も享楽的。花の魔法を得意とする強力な大魔女であり、「華の大公爵」と呼ばれ、畏怖されている。"}],"source":"bangumi","sourceCharacterId":"93992"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb9a6f8606a95ea072eb218978143611625348572fa1a6bf868930e2465bc3b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f3cdad17af16b729f368decc5fd3e1152892fb4e21c3bd6136aa23df135f4af.webp","width":256,"height":221,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_93993","characterName":"嫌われ者の子鬼","sourceIds":{"bangumi":[{"characterId":"93993","match":"source-roster","subjectId":"24169"}]},"originalCharacterName":"嫌われ者の子鬼","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"粘着質で、陰湿で小悪党な妖精。ヴァレンティーヌ領のコリゴンは、領主であるヴァレンティーヌに強く支配・抑圧されているためか、その性分にも関わらず、従順に働く姿が見られる。"}],"source":"bangumi","sourceCharacterId":"93993"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff58da9277cd64d9dd4a1b9b7b9c993b4e808e2ab5fb7ec55d435f84f725a789.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/986462151d1b6b464164c58904a847b500cdd14dc398b3dff905437216e11490.webp","width":256,"height":221,"source":"static-detail"},"actors":[{"creditedName":"佐倉紗織","creatorId":"vndb:s1261","sourcePersonId":"vndb:s1261","canonicalEntityId":"vndb:s1261","name":"佐倉 紗織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24169:93993:6089:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p88","sourceCompanyId":"egs:brand:746","canonicalEntityId":"vndb:p88","name":"日本一ソフトウェア","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:32449:746","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
