rmed","relationId":"egs:work-creator:138331","source":"egs"},{"creditedName":"細井聡司(細井そうし)","creatorId":"vndb:s1335","sourcePersonId":"egs:creator:2308","canonicalEntityId":"vndb:s1335","name":"細井聡司(細井そうし)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138332","source":"egs"},{"creditedName":"鈴葉ユミ","creatorId":"vndb:s2523","sourcePersonId":"egs:creator:20295","canonicalEntityId":"vndb:s2523","name":"鈴葉ユミ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138333","source":"egs"},{"creditedName":"Music-Note.jp","creatorId":"vndb:s18825","sourcePersonId":"egs:creator:21945","canonicalEntityId":"vndb:s18825","name":"Music-Note.jp","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:139147","source":"egs"}],"other":[{"creditedName":"大石竜子","creatorId":"vndb:s296","sourcePersonId":"egs:creator:2111","canonicalEntityId":"vndb:s296","name":"大石竜子","detail":"イメージ画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:133946","source":"egs"},{"creditedName":"金山じゅん","creatorId":"vndb:s21693","sourcePersonId":"egs:creator:10886","canonicalEntityId":"vndb:s21693","name":"金山じゅん","detail":"製作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236766","source":"egs"},{"creditedName":"神月社","creatorId":"vndb:s4003","sourcePersonId":"egs:creator:12716","canonicalEntityId":"vndb:s4003","name":"神月社","detail":"ムービー制作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238947","source":"egs"}]},"cast":[{"characterId":"char_vndb_c100469","characterName":"四藤 依子","sourceIds":{"vndbCharacterId":"c100469"},"originalCharacterName":"四藤 依子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a housekeeper who manages all the household chores at the Kirishima family's villa. She is also in charge of making the sacred ropes that Kazuki uses in his rituals."},{"spoiler":false,"text":"She is a good cook and can make almost anything that is requested, as long as she has the ingredients and time."},{"spoiler":false,"text":"She is usually calm and kind, but when it comes to matters related to the Kirishima family's rituals, she becomes hysterical and transforms into a different person."},{"spoiler":false,"text":"She knows nothing about Mimasaka and the others' true nature or the \"game,\" and thinks they are Kazuki's friends."},{"spoiler":false,"text":"Translated from Wikipedia"}],"source":"vndb","sourceCharacterId":"c100469"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c2281e631887d378172c74fb48f86f3fa6ce90c487e043ff019ac554bc89801.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46771eed9b45ffbfefe369ca313e8d716cc699838f5e257b843fbd4249c48d8f.webp","width":138,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105949","characterName":"滝澤 昌之","sourceIds":{"vndbCharacterId":"c105949"},"originalCharacterName":"滝澤 昌之","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A diligent young man who works as a gardener for the Kirishima family. In addition to gardening and shopping, he is entrusted with physically demanding tasks that are difficult for Yoriko."},{"spoiler":false,"text":"Like Yoriko, he is unaware that the reason Mimasaka and the others are staying at the villa is the \"game.\""},{"spoiler":false,"text":"Translated from Wikipedia"}],"source":"vndb","sourceCharacterId":"c105949"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57c5c2da7da2faba6d8be223aeb0fedcc66046dbb1fb064f7123c8f8fb0b3ce8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c487984aa2a7fff75f607c488e358509b05887e962774ba0bfd20cbd9382da8.webp","width":220,"height":182,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c109621","characterName":"大森 匡","sourceIds":{"vndbCharacterId":"c109621"},"originalCharacterName":"大森 匡","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A suspicious man who turns up as a trespasser on Kirishima land."},{"spoiler":false,"text":"He has a strange tribalistic tattoo on his arm, but he doesn't seem to be a yakuza, and his true identity is unknown."},{"spoiler":false,"text":"He's extremely shady. He's friendly and talkative, but everything he says sounds like nonsense. However, it seems that it is not in his nature to get discouraged even when he is beaten, and he could even be called a \"lovable jester\"..."},{"spoiler":false,"text":"He acts as if he knows something about the Kirishima family and brings up some dubious stories."},{"spoiler":false,"text":"Translated from Official site"}],"source":"vndb","sourceCharacterId":"c109621"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69f050fead12a2adb01cd33c745fa0c2b1cbea4686893407e4161a6113b5330d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/055de6726dfbf22ae23d18c53cea4ab003fcbfa7cbccb4374fe9dafd04b64247.webp","width":175,"height":197,"source":"static-detail"},"actors":[{"creditedName":"縞馬 男爵","creatorId":"vndb:s546","sourcePersonId":"vndb:s546","canonicalEntityId":"vndb:s546","name":"間宮 康弘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47879","source":"vndb"}]},{"characterId":"char_vndb_c25974","characterName":"桐島和樹","sourceIds":{"vndbCharacterId":"c25974"},"originalCharacterName":"桐島和樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"920"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this game."},{"spoiler":false,"text":"The second son of the Kirishima family. He is enrolled in a university in Tokyo, but after the unexpected death of his older brother, who inherited the family assets at a young age after the passing of their parents, he suddenly becomes the new head of the household. He has never been good at socializing and has no interest in extravagant partying. He relied heavily on his only remaining relative, his older brother, and for this reason he was hardly involved in household matters and is ignorant in the ways of the world."},{"spoiler":false,"text":"He has a gentle personality and isn't used to doubting people, but this ultimately leads to him allowing the outrageous actions of the four visitors. According to Mimasaka, he is \"prettier than most girls.\""},{"spoiler":false,"text":"Translated from Official site and Wikipedia"}],"source":"vndb","sourceCharacterId":"c25974"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0047a21b3b45119144d02db47ee24bf1e80f0c4247e19323019fe15703a7942.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6b4eb2ffd7bf8643868b83d43b81a2c9e9795a43175aced031872cc9592b340.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松田 春樹","creatorId":"vndb:s2180","sourcePersonId":"vndb:s2180","canonicalEntityId":"vndb:s2180","name":"ペロペロンチーノ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47883","source":"vndb"}]},{"characterId":"char_vndb_c25975","characterName":"美作 祥輔","sourceIds":{"vndbCharacterId":"c25975"},"originalCharacterName":"美作 祥輔","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1017"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The son of a distinguished family that owns Miyoshi Group, a company at the head of a large conglomerate."},{"spoiler":false,"text":"His older brother is the successor, but Shousuke is also promised a carefree, comfortable future. From kindergarten onwards he attended prestigious private schools, but for a change of pace he went to a top-tier national university."},{"spoiler":false,"text":"He is blessed with good looks and a brilliant mind, and is extremely wealthy, but he has a twisted personality and takes pleasure in tricking and trapping others through careful planning and deception."},{"spoiler":false,"text":"His hobby is Japanese painting, and he has visited Mizuki's solo exhibitions several times. He had seen Kazuki there on those occasions."},{"spoiler":false,"text":"Translated from Official site and Wikipedia"}],"source":"vndb","sourceCharacterId":"c25975"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58b4a9302870d3afa8867a2a8b7530bd626a4bcba0ff21bcc1572e4ae9bdf4f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a09b3c462561753de4153572975794b68ffbce8cc3afe67eac9facf0c428529.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 タカ","creatorId":"vndb:s734","sourcePersonId":"vndb:s734","canonicalEntityId":"vndb:s734","name":"梯篤司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47885","source":"vndb"}]},{"characterId":"char_vndb_c25976","characterName":"橘 裕也","sourceIds":{"vndbCharacterId":"c25976"},"originalCharacterName":"橘 裕也","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"412"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The son of a distinguished family that owns a large conglomerate Tachibana Zaibatsu."},{"spoiler":false,"text":"Although he is the second son, he was raised by his grandfather, known as the \"Monster of the Showa Era,\" a powerful figure behind the scenes in the political and financial world, and was instilled with a unique leadership style."},{"spoiler":false,"text":"At first glance, he appears to be a violent, short-tempered tyrant, but he has a strong sense of self-confidence that comes from the belief that they are kings who should rule over the people. He believes that committing cruel acts without hesitation is the right of a king."},{"spoiler":false,"text":"He looks down on Kazuki, who is weak and has an androgynous appearance, calling him \"little girl\" or \"little deer.\" He is blessed with a strong physique and possesses physical strength that most people cannot match. He has a rule not to complain about the food he is given. He once invited Mizuki to go hunting when Mizuki was alive."},{"spoiler":false,"text":"Translated from Official site and Wikipedia"}],"source":"vndb","sourceCharacterId":"c25976"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22d63093ff36551d938b11b03a2b53447c1fc6b43010bedf8a6491f66f2032ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/750b4d40b42cd71d1e8425413e07df44ca45cc997989bbd349330e5b4f810fa1.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"髭内 悪太","creatorId":"vndb:s2548","sourcePersonId":"vndb:s2548","canonicalEntityId":"vndb:s2548","name":"竹内 良太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47880","source":"vndb"}]},{"characterId":"char_vndb_c25977","characterName":"雪ノ宮 透","sourceIds":{"vndbCharacterId":"c25977"},"originalCharacterName":"雪ノ宮 透","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"128"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the second son of the wealthy Yukinomiya family."},{"spoiler":false,"text":"His entire family is highly accomplished, many family members are geniuses. He is expected to assist his older brother, the heir, but their relationship is terrible and he rarely visits home. He constantly observes others with a detached gaze and often looks down on them."},{"spoiler":false,"text":"Translated from Official site"}],"source":"vndb","sourceCharacterId":"c25977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a5b88c3e32dd547c79473e81af722bb7332e2f6f75cff2262bfbb879bffd691.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b54655da88c473e9eb8a2bf0ea125f2b8c74b13bacd766337cf84991c05aa08e.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"634","creatorId":"vndb:s17807","sourcePersonId":"vndb:s17807","canonicalEntityId":"vndb:s17807","name":"634","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47884","source":"vndb"}]},{"characterId":"char_vndb_c25978","characterName":"水沢博嗣","sourceIds":{"vndbCharacterId":"c25978"},"originalCharacterName":"水沢博嗣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"808"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He comes from the main branch of a small, but renowned and wealthy family. Although he may not look like it, he is the eldest son."},{"spoiler":false,"text":"Though all four of them study at the same prestigious university, the other three have been advancing together since kindergarten through the so-called internal escalator school system, and only Hirotsugu entered the university from the \"outside\", by applying from the high school division."},{"spoiler":false,"text":"Perhaps for this reason, he gets grumpy every time the topic shifts to anything that happened before middle school. He's a semi-professional pianist, but rarely plays in front of others, and gets angry if you praise him."},{"spoiler":false,"text":"He is dexterous and good at repairing machinery."},{"spoiler":false,"text":"Translated from Official site and Wikipedia"}],"source":"vndb","sourceCharacterId":"c25978"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/208f237745c66db7512e341e0c01eecab0d3cce0f72bd8e1a5d740580834e346.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab00381f3b273baacc0f0da084267d0387afa93ab4a092c2b1fedd115f08fbcf.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清風 涼","creatorId":"vndb:s639","sourcePersonId":"vndb:s639","canonicalEntityId":"vndb:s639","name":"笹田 貴之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47882","source":"vndb"}]},{"characterId":"char_vndb_c25979","characterName":"和泉馨","sourceIds":{"vndbCharacterId":"c25979"},"originalCharacterName":"和泉馨","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1105"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a butler-in-training at the Kirishima household. The Izumi family has served the Kirishima family for generations, and his father now manages everything at the main house in Tokyo after the master's death."},{"spoiler":false,"text":"Kaoru spent a lot of time with the Kirishima brothers when he was little, and was especially close to Kazuki."},{"spoiler":false,"text":"Translated from Official site"}],"source":"vndb","sourceCharacterId":"c25979"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0709e71bb7ad83164e3785d22e34a51362c6f598ccc44b94f6ed096db49e41b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a77be098d018d26e4caef51908a428e1a0b05e37fdcda376b255c43dcf0b9391.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"錦戸 智久","creatorId":"vndb:s3164","sourcePersonId":"vndb:s3164","canonicalEntityId":"vndb:s3164","name":"川野 剛稔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47881","source":"vndb"}]},{"characterId":"char_vndb_c26518","characterName":"桐島瑞樹","sourceIds":{"vndbCharacterId":"c26518"},"originalCharacterName":"桐島瑞樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He was the eldest son and former head of the Kirishima family. Deceased."},{"spoiler":false,"text":"His parents died young, and he became the head of the family while still a student."},{"spoiler":false,"text":"He doted on his younger brother, Kazuki, and devoted himself to keeping him away from all danger, but at the same time, he was willing to sacrifice others for Kazuki's safety."},{"spoiler":false,"text":"His hobbies were hunting and Japanese painting, and he owned a shotgun and an art studio. He occasionally held solo exhibitions during his lifetime."},{"spoiler":false,"text":"Translated from Wikipedia"}],"source":"vndb","sourceCharacterId":"c26518"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/388f3ed7f026f10114c751fec3b1857a91c8d58778dd8c2322d68db5ebb373e7.webp","fallbackUrl":"https://wiki-assets.bishojo.da