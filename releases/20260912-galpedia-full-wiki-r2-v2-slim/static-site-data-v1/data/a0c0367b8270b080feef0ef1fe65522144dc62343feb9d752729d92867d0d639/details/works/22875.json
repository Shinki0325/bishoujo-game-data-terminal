db:s717","canonicalEntityId":"vndb:s717","name":"Gユウスケ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:126506","source":"vndb"},{"creditedName":"高濱 亮","creatorId":"vndb:s2093","sourcePersonId":"vndb:s2093","canonicalEntityId":"vndb:s2093","name":"高濱 亮","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126508","source":"vndb"},{"creditedName":"服部 道知","creatorId":"vndb:s9649","sourcePersonId":"vndb:s9649","canonicalEntityId":"vndb:s9649","name":"服部 道知","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126509","source":"vndb"},{"creditedName":"CF-X","creatorId":"vndb:s10645","sourcePersonId":"vndb:s10645","canonicalEntityId":"vndb:s10645","name":"CF-X","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126510","source":"vndb"},{"creditedName":"まゆき","creatorId":"vndb:s10649","sourcePersonId":"vndb:s10649","canonicalEntityId":"vndb:s10649","name":"まゆき","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:126511","source":"vndb"}]},"cast":[{"characterId":"char_c22061","characterName":"ラインハルト・トリスタン・オイゲン・ハイドリヒ","sourceIds":{"bangumi":[{"characterId":"40064","match":"source-roster","subjectId":"156122"},{"characterId":"40064","match":"exact-normalized-name-in-linked-work","subjectId":"16849"},{"characterId":"40064","match":"source-roster","subjectId":"16849"},{"characterId":"40064","match":"source-roster","subjectId":"187085"},{"characterId":"40064","match":"exact-normalized-name-in-linked-work","subjectId":"43372"},{"characterId":"40064","match":"source-roster","subjectId":"43372"}],"egsCharacterIds":["13336"],"vndbCharacterId":"c22061"},"originalCharacterName":"ラインハルト・トリスタン・オイゲン・ハイドリヒ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"307"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader of the Longinus Dreizehn Orden. Originally a high-ranking official in Germany, regarded as highly dangerous due to his seemingly boundless talent in all fields. Later, he bowed out of the public eye through the guise of a staged assassination, and formed the Obsidian Round Table alongside Mercurius."},{"spoiler":false,"text":"Their subordinate members acted behind the scenes of WW2 and kept on destroying friend and foe alike. His acts of destruction reached their climax during the fall of Berlin. However, he and his three direct subordinates disappeared shortly afterwards, leaving their current whereabouts a mystery."},{"spoiler":false,"text":"\"You would do well not to disappoint me.\""},{"spoiler":false,"text":"From Dies irae's Kickstarter Campaign Page"}],"source":"vndb","sourceCharacterId":"c22061"},{"segments":[{"spoiler":false,"text":"聖槍十三騎士団黒円卓第一位“愛すべからざる光（メフィスト・フェレス）”。"},{"spoiler":false,"text":"黄金の獣と呼ばれるナチスドイツの高官だったが、あまりに有能すぎたために危険視されるようになる。"},{"spoiler":false,"text":"後、彼は自身が暗殺されたと偽装して闇に潜り、副首領と共に騎士団を結成。"},{"spoiler":false,"text":"配下の団員達を戦争の裏で暗躍させ、敵といわず味方といわず滅ぼし続け、壊し続ける。"},{"spoiler":false,"text":"彼の破壊工作はベルリン陥落時に頂点を迎えるが、その後は直属の部下3名と共に消息を絶ち、現在に至るも行方不明。"},{"spoiler":false,"text":"彼が戻ってきた時に、世界は破滅すると言われている。"}],"source":"egs","sourceCharacterId":"13336","sourceWorkId":"12972","spoiler":false},{"segments":[{"spoiler":false,"text":"圣枪十三骑士団的首领。"},{"spoiler":false,"text":"本来是德意志的高官，因为过于有才能而被处处提防。"},{"spoiler":false,"text":"之后，他以被暗杀作为掩护躲了起来，与メルクリウス一起建立了骑士团。"},{"spoiler":false,"text":"麾下的团员们暗中在战争中活跃，不论敌友一律歼灭破坏。"},{"spoiler":false,"text":"他的破坏工作在柏林沦陷时迎来顶峰，之后与直属部下3名一起失去了消息，直到现在依旧行踪不明。"},{"spoiler":false,"text":"称号：愛すべからざる光"},{"spoiler":false,"text":"黒円卓：一位"},{"spoiler":false,"text":"ルーン：破壊"},{"spoiler":false,"text":"大アルカナ：皇帝"},{"spoiler":false,"text":"占星術：白羊宮"}],"source":"bangumi","sourceCharacterId":"40064"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5797373e741eb306e787d178a1da9fa48472f1b17ac7c83479181748823a532d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25320bbf32a761c5ec642e121cf16a095a2357b64dd1a6085bcc7c6f8cce99d9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156122:40064:3864:1","source":"bangumi"}]},{"characterId":"char_c28990","characterName":"Kazıklı Bey","sourceIds":{"bangumi":[{"characterId":"40065","match":"exact-normalized-name-in-linked-work","subjectId":"156122"},{"characterId":"40065","match":"source-roster","subjectId":"156122"},{"characterId":"40065","match":"source-roster","subjectId":"16849"},{"characterId":"40065","match":"source-roster","subjectId":"187085"},{"characterId":"40065","match":"source-roster","subjectId":"43372"}],"egsCharacterIds":["7910"],"vndbCharacterId":"c28990"},"originalCharacterName":"Kazıklı Bey","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"710"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"73"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man with a long criminal record who served as a First Lieutenant for the infamous 36th Waffen Grenadier Division of the SS. An albino, he shuns all light, especially that of the sun. In return, all of his senses magnify in the darkness, almost as if he was a vampire. Having embraced that nature of his as part of his identity. Wilhelm's designation and fondness for vampiric characteristics is no coincidence."},{"spoiler":false,"text":"\"State your name, kid. Don't you know anything about proper manners on the battlefield?\""},{"spoiler":false,"text":"From Dies irae's Kickstarter Campaign Page"}],"source":"vndb","sourceCharacterId":"c28990"},{"segments":[{"spoiler":false,"text":"聖槍十三騎士団黒円卓第四位、カズィクル・ベイの異名を持つ男。"},{"spoiler":false,"text":"第二次大戦中から一切歳を取らずに存在し続けており、世界中の紛争地帯に現れては暴虐の限りを尽くす吸血鬼として戦場の伝説となっている。"},{"spoiler":false,"text":"そして現在、長年待ち続けた黄金練成という儀式のために日本へ向かう直前の彼は、接触してきたインタビュアーに己の過去を語り始める。"}],"source":"egs","sourceCharacterId":"7910","sourceWorkId":"22875","spoiler":false},{"segments":[{"spoiler":false,"text":"拥有犯罪者的经历，恶名远扬的隶属于第38SS的武装擲弾兵師団的原中尉。"},{"spoiler":false,"text":"白化病患者，对光线尤其阳光很是避忌。"},{"spoiler":false,"text":"反过来，所有感觉器官会在夜间得到加强的吸血鬼体质。"},{"spoiler":false,"text":"本人也引以为豪，甚至连称号也明显带有吸血鬼的属性。（“穿刺公”是著名的吸血鬼“德古拉伯爵”的原型——弗拉德三世·采佩什的称号。）"},{"spoiler":false,"text":"称号：串刺し公"},{"spoiler":false,"text":"黒円卓：四位"},{"spoiler":false,"text":"ルーン：茨棘"},{"spoiler":false,"text":"大アルカナ：戦車"},{"spoiler":false,"text":"占星術：巨蟹宮"},{"spoiler":false,"text":"形態：人器融合型"},{"spoiler":false,"text":"位階：創造"},{"spoiler":false,"text":"聖遺物：闇の賜物"}],"source":"bangumi","sourceCharacterId":"40065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3747815ea66acbab6330aa9b8b6b36a98ea0ebe0b6246ad45590473ae97293e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/498f40cba0e3ea8a13552fdaf885db7a89262a3f662a536249a3bfc808bd66e3.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷山紀章","creatorId":"vndb:s59","sourcePersonId":"vndb:s59","canonicalEntityId":"vndb:s59","name":"谷山 紀章","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156122:40065:4678:1","source":"bangumi"}]},{"characterId":"char_c34712","characterName":"ヘルガ・エーレンブルグ","sourceIds":{"bangumi":[{"characterId":"43400","match":"exact-normalized-name-in-linked-work","subjectId":"156122"}],"egsCharacterIds":["7912"],"vndbCharacterId":"c34712"},"originalCharacterName":"ヘルガ・エーレンブルグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Helga Ehrenburg is the deceased mother and half sister of Wilhelm."}],"source":"vndb","sourceCharacterId":"c34712"},{"segments":[{"spoiler":false,"text":"ヴィルヘルムの母であり、姉である女性。すでに故人だが、彼の価値観に深い影響を与えた存在のため、聖遺物『闇の賜物』がヘルガの姿を真似、ヴィルヘルムの内界に巣食っている。"},{"spoiler":false,"text":"ゆえにあくまで彼が認識している母かつ姉という像にすぎないが、彼女が抱く愛は本物。持てる全能力をヴィルヘルムのために捧げると誓っている。"}],"source":"egs","sourceCharacterId":"7912","sourceWorkId":"22875","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴィルヘルムの母であり、姉である女性。すでに故人だが、彼の価値観に深い影響を与えた存在のため、聖遺物『闇の賜物』がヘルガの姿を真似、ヴィルヘルムの内界に巣食っている。"},{"spoiler":false,"text":"ゆえにあくまで彼が認識している母かつ姉という像にすぎないが、彼女が抱く愛は本物。持てる全能力をヴィルヘルムのために捧げると誓っている。"}],"source":"bangumi","sourceCharacterId":"43400"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4289fcf6968c3aa2b40dfb4f94cbd969786ab6574d1d82e18f1fad61a4c3f955.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdb41a74aaef971586ccd7e44144e934cedc5d86f54701174412d12a6f672f1f.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationI