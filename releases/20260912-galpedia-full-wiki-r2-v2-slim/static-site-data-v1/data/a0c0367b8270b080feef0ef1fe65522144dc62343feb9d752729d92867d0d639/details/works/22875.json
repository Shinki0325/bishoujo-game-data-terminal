s":[{"segments":[{"spoiler":false,"text":"Iron Hand: Goëtz von Berlichingen is a member of the Longinus Dreizehn Orden, occupying Seat VII. An enigmatic man, with a past veiled in mystery and an equally mysterious relationship with Ren Fujii. He is also one of the Three Knights, one of three members of the Black Round Table awarded the honor of becoming an Einherjar under Reinhard Heydrich's command, serving as part of the commanding echelons of the Longinus Thirteen and an essential piece to the success of their goals."}],"source":"vndb","sourceCharacterId":"c28992"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd39066b42a83bd4e7bcf1cb99b0d585112048b1d5abadc2ba730c998beb8cbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9ceaaf5dcd7d03305b0397434ceefad4861956d3c38473cf7a50a5d23c58e79e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安元 洋貴","creatorId":"vndb:s377","sourcePersonId":"vndb:s377","canonicalEntityId":"vndb:s377","name":"安元 洋貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67483","source":"vndb"}]},{"characterId":"char_vndb_c28993","characterName":"ルサルカ・シュヴェーゲリン","sourceIds":{"vndbCharacterId":"c28993"},"originalCharacterName":"ルサルカ・シュヴェーゲリン","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1118"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"height":{"reviewState":"source-only","source":"vndb","value":"146"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"},"weight":{"reviewState":"source-only","source":"vndb","value":"34"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An early member of the Deutsches Ahnenerbe - Nazi Germany's institute of archaeological and occult research - and a genuine witch who had stepped into the realm of sorcery even before joining the LDO. Her youthful appearance shelters one of the most ancient souls to have sworn loyalty to the Obsidian Round Table."},{"spoiler":false,"text":"Despite being cunning and crafty at her core, she is playful and flirtatious on the outside, making her a very dangerous individual to associate with. She also has a fondness for torture and is known to be extremely moody. Though essentially not a fighter, her cruelty rivals even Wilhelm's."},{"spoiler":false,"text":"\"Keep underestimating me and I just might gobble you up.\""},{"spoiler":false,"text":"From Dies irae's Kickstarter Campaign Page"}],"source":"vndb","sourceCharacterId":"c28993"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0cf564e7c72fa8a2cacaf3314776e27d58871d7ca8a5b5282601d4ba6699722.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f8ee55a98cbab1ca87d309329ca5446c7591d74aaca944fbde2f7e63bf07486.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくち ゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67485","source":"vndb"}]},{"characterId":"char_vndb_c28994","characterName":"エレオノーレ・フォン・ヴィッテンブルグ","sourceIds":{"vndbCharacterId":"c28994"},"originalCharacterName":"エレオノーレ・フォン・ヴィッテンブルグ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"91"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1213"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"64"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eleonore von Wittenburg is a member of the Longinus Dreizehn Orden, occupying Seat IX in the Black Round Table. As the most loyal and closest underling to Reinhard, she will go on to become an Einherjar and one of the Three Knights, part of the leading echelons of the Longinus Thirteen, and an essential player in the completion of the Transmutation of Gold."}],"source":"vndb","sourceCharacterId":"c28994"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69358767e203d6bc8eb451e057708a66064cd0c76324fe8ddc5b605c3e77640e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4490332206c92c2b7375ff95a770f853368a876f04653f452e0b87c3bfb8c603.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"矢口 アサミ","creatorId":"vndb:s7969","sourcePersonId":"vndb:s7969","canonicalEntityId":"vndb:s7969","name":"矢口 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67489","source":"vndb"}]},{"characterId":"char_vndb_c28995","characterName":"ロート・シュピーネ","sourceIds":{"vndbCharacterId":"c28995"},"originalCharacterName":"ロート・シュピーネ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"117"},"height":{"reviewState":"source-only","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rot Spinne is a member of the Longinus Dreizehn Orden. He occupies the seat number X in the Black Round Table. Mostly known by his Demon Name, as even he does not remember his true name, Spinne's nature is quite different to that of his peers. Instead of direct combat, he specializes in information gathering, black ops, and management. However, given this specialization, he is easily the most cowardly amongst the Longinus Thirteen's ranks."}],"source":"vndb","sourceCharacterId":"c28995"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11f5ff9ad8038abcd7d5aa79743802f2c03669f1e27b3378f0a40bf599c0137a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8eed375dd8c88172214280be6181a8d5f9f6955653c4ada76c22b014a65a030.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"はらさわ 晃綺","creatorId":"vndb:s2401","sourcePersonId":"vndb:s2401","canonicalEntityId":"vndb:s2401","name":"はらさわ晃綺(原沢勝広)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67488","source":"vndb"}]},{"characterId":"char_vndb_c28996","characterName":"リザ・ブレンナー","sourceIds":{"vndbCharacterId":"c28996"},"originalCharacterName":"リザ・ブレンナー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"211"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Riza Brenner is the nun that is in charge of running Suwahara City's Church, inside of which she lives. She is Rea Himuro's caretaker, and acts as a motherly figure to her, and seems to have a past with Father Trifa."},{"spoiler":true,"text":"Despite what her extremely kind, and even teasing and playful, disposition would suggest, she's actually a member of the Longinus Dreizehn Orden, occupying Seat XI of the Black Round Table and answering to the Demon Name of Babylon Magdalena: Great Mother."}],"source":"vndb","sourceCharacterId":"c28996"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62143b2fc8c45fefc60657956bcbfb1bbdb11c2b365efdb5a7c0383795f2a790.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4280e9226afd1709198491ea034a943fb4fb3d42dd0cb7153265059fcbaba9cb.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹 梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67478","source":"vndb"}]},{"characterId":"char_vndb_c28997","characterName":"ウォルフガング・シュライバー","sourceIds":{"vndbCharacterId":"c28997"},"originalCharacterName":"ウォルフガング・シュライバー","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"227"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wolfgang Schreiber was a member of the Longinus Dreizehn Orden, occupying Seat XII in the Black Round Table. Beginning as a mere street prostitute and serial killer in the streets of Berlin around the era World War II began, Schreiber would go on to become part of the Three Knights, the first members of the Round Table that would be granted the honor of becoming Einherjar in service to Reinhard Heydrich, as the upper echelons of the Longinus Thirteen and essential pieces in completing the plans of the Golden Beast."}],"source":"vndb","sourceCharacterId":"c28997"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e026091ffd18dbbdfdc169d63bdb63a531acb1965ff44bffbd2f6e1a71dbc7a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f9618eb721d3e86bf55cebf3a59cba800700c867ee4cec13b3a27c5a93f4efb.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"環 有希","creatorId":"vndb:s1849","sourcePersonId":"vndb:s1849","canonicalEntityId":"vndb:s1849","name":"環 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67490","source":"vndb"}]},{"characterId":"char_vndb_c28998","characterName":"メルクリウス","sourceIds":{"vndbCharacterId":"c28998"},"originalCharacterName":"メルクリウス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An ominous magician and alchemist who created Ewigkeit and established the Obsidian Round Table. He was the one responsible for turning the LDO from a clique of elite army officers merely dabbling in the occult into a den of genuine demons. Not only is Mercurius the one sworn friend of the Table's leader, he also stands as the only being capable of matching his sublime prowess."},{"spoiler":false,"text":"Although his position could be considered that of a mentor and a father, the other LDO members - with the exception of their master - shun him as a hateful taboo. His whereabouts have remained a mystery for the past six decades."},{"spoiler":false,"text":"\"Let the curtains rise on tonight's Grand Guignol.\""},{"spoiler":false,"text":"From Dies irae's Kickstarter Campaign Page"}],"source":"vndb","sourceCharacterId":"c28998"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e5e412e2c184f4b187d45ab2bc93a570c321465087f4a76bd88262061970650.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58b96f2997bb58306db7e2956a7eef75b79b30e29c9b194ee712e8ffa6cb3c7d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67477","source":"vndb"}]},{"characterId":"char_vndb_c28999","characterName":"ベアトリス・ヴァルトルート・フォン・キルヒアイゼン","sourceIds":{"vndbCharacterId":"c28999"},"originalCharacterName":"ベアトリス・ヴァルトルート・フォン・キルヒアイゼン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"730"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Beatrice Waltrud von Kircheisen was a former member of the Longinus Dreizehn Orden, being Kei Sakurai's predecessor in Seat V of the Black Round Table, now deceased. Despite being dead as of the beginning of Dies Irae's main story, her influence is still felt, mainly thanks to her connection to Kai and Kei Sakurai, as well as to her former commanding officer."}],"source":"vndb","sourceCharacterId":"c28999"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f19233ad9eed3d1442e0476752501f8096c7785f4c79bfc3cc135e3b2b1281d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/005f4781fef048722ad6362d4dfc480b679152d4a2e0fe396b36ab45e0b06249.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢 渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67476","source":"vndb"}]},{"characterId":"char_vndb_c41480","characterName":"ルートヴィヒ・ヴァン・ローゼンクライツ","sourceIds":{"vndbCharacterId":"c41480"},"originalCharacterName":"ルートヴィヒ・ヴァン・ローゼンクライツ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ludwig van Rosenkranz is an ancient deity and the embodiment of darkness."}],"source":"vndb","sourceCharacterId":"c41480"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5173bf7f2f0be05876e54f59c21d900f6373a3802f36b7c3a15629b99849c8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/t