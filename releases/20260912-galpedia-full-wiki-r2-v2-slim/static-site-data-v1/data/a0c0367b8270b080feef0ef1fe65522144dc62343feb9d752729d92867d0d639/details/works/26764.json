{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26764","model":{"presentationWorkId":"vndb:v23000","staff":{"artwork":[{"creditedName":"もんぷち","creatorId":"vndb:s13005","sourcePersonId":"egs:creator:25303","canonicalEntityId":"vndb:s13005","name":"もんぷち","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:198480","source":"egs"}],"scenario":[{"creditedName":"高尾登山","creatorId":"vndb:s323","sourcePersonId":"egs:creator:324","canonicalEntityId":"vndb:s323","name":"高尾登山","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:198481","source":"egs"}],"music":[{"creditedName":"株式会社ナッシュスタジオ","creatorId":"vndb:s11620","sourcePersonId":"vndb:s11620","canonicalEntityId":"vndb:s11620","name":"株式会社ナッシュスタジオ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:148557","source":"vndb"}],"other":[{"creditedName":"高尾登山","creatorId":"vndb:s323","sourcePersonId":"egs:creator:324","canonicalEntityId":"vndb:s323","name":"高尾登山","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:218869","source":"egs"},{"creditedName":"もんぷち","creatorId":"vndb:s13005","sourcePersonId":"vndb:s13005","canonicalEntityId":"vndb:s13005","name":"もんぷち","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:148558","source":"vndb"}]},"cast":[{"characterId":"char_c70436","characterName":"鷹取 明音","sourceIds":{"bangumi":[{"characterId":"96409","match":"exact-normalized-name-in-linked-work","subjectId":"279477"}],"egsCharacterIds":["20230"],"vndbCharacterId":"c70436"},"originalCharacterName":"鷹取 明音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヒロイン。主人公の妻。ちょっと強気で、夫を守っているタイプ。"},{"spoiler":false,"text":"学生時代は水泳をやっていた。最近は運動をしていなくて、少し肉がついてきたことを気にしている。"},{"spoiler":false,"text":"かつて氷上が自分に好意をもっていたことは気づいていたが、秋弘の誠実さが好きだった明音は彼を選んだ。それでも３人の関係が崩れず、ずっと友達でいられたことに感謝している。"}],"source":"egs","sourceCharacterId":"20230","sourceWorkId":"26764","spoiler":false},{"segments":[{"spoiler":false,"text":"結婚して3年になる、鷹取秋弘の妻。"},{"spoiler":false,"text":"秋弘とは学生時代からのつき合いで、氷上昭興を含む3人でよく行動していた。"},{"spoiler":false,"text":"豊満で男好きのする身体は、他の男性の目を惹きつける。"},{"spoiler":false,"text":"甲斐甲斐しく夫の世話を焼き、人生を支える。"},{"spoiler":false,"text":"そんな生き方に満足しているし、何より彼女自身がそれを幸せと感じる性格"},{"spoiler":false,"text":"。"},{"spoiler":false,"text":"そのため、夫の立場を慮るあまり、自分へのセクハラ行為を我慢してしまうこともしばしば。"},{"spoiler":false,"text":"そしてその行動が、ますます相手をつけあがらせてしまう。"},{"spoiler":false,"text":"男性経験は夫ひとりだけ――の初心な人妻だったのだが、"},{"spoiler":false,"text":"最近とある理由から性感を開発されてしまっている。"},{"spoiler":false,"text":"「いつまでも女の子として見てくれるのは嬉しいけど、ちょっと挙動不審よ、秋弘くん」"}],"source":"bangumi","sourceCharacterId":"96409"}],"profileFacts":[{"label":"年龄（本版本）","value":"27 岁","valueContext":null,"source":"egs","sourceCharacterId":"20230","sourceWorkId":"26764","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5e6d634d55fcfe43654660ea04958079336325ce253d597bead74c606cec36b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45f3459c8e19952fa7f2679c995b97e23c240916823e73aeb525d1c0b7eb2904.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279477:96409:12718:1","source":"bangumi"}]},{"characterId":"char_c70437","characterName":"苑田 舞依","sourceIds":{"bangumi":[{"characterId":"96410","match":"exact-normalized-name-in-linked-work","subjectId":"279477"}],"egsCharacterIds":["20231"],"vndbCharacterId":"c70437"},"originalCharacterName":"苑田 舞依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"26"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"サブヒロイン。主人公の同僚。真面目でおとなしいメガネ枠。脱いだらすごい。"},{"spoiler":false,"text":"鬼島の会社を担当しているうちに、彼に襲われ、すっかり調教済み。"}],"source":"egs","sourceCharacterId":"20231","sourceWorkId":"26764","spoiler":false},{"segments":[{"spoiler":false,"text":"秋弘の会社の同僚。"},{"spoiler":false,"text":"生真面目な仕事ぶりで愛想を見せることも少ないが、有能な会社員。怠慢やミスには特に厳しい。"},{"spoiler":false,"text":"職場では鬼島の担当になっていて、セクハラされまくりを他の社員からも同情されている。"},{"spoiler":false,"text":"実際はセクハラどころか、すっかり鬼島に調教されていて、セックスの虜。"},{"spoiler":false,"text":"鬼島の命令であれば、他の男に抱かれることも厭わない。"},{"spoiler":false,"text":"『脱いだらすごい』スケベボディで、普段はそれを隠すような服装を好んでいる。"},{"spoiler":false,"text":"「別に怒ってはいません。配偶者を大切にするのは、よい姿勢だと思います」"}],"source":"bangumi","sourceCharacterId":"96410"}],"profileFacts":[{"label":"年龄（本版本）","value":"26 岁","valueContext":null,"source":"egs","sourceCharacterId":"20231","sourceWorkId":"26764","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22267a2890f2d96baa3221b731e228d0cf1fad517877b5659cff738175714de8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b48445ea8d53bc6f3c936f86fa434d697b88836658a75d1caa7893c969d0e42.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId"