s":"source-native","relationId":"vndb:vn-staff:55978","source":"vndb"},{"creditedName":"oo39","creatorId":"vndb:s20117","sourcePersonId":"vndb:s20117","canonicalEntityId":"vndb:s20117","name":"八幡 浩暢","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:55979","source":"vndb"}],"other":[{"creditedName":"珠梨","creatorId":"vndb:s13004","sourcePersonId":"vndb:s13004","canonicalEntityId":"vndb:s13004","name":"珠梨","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:55976","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c135733","characterName":"槙原渉","sourceIds":{"vndbCharacterId":"c135733"},"originalCharacterName":"槙原渉","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"505"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Children will notice things we don’t. I’ve already failed one time, so I don’t want to make the same mistake again.”"},{"spoiler":false,"text":"The school’s newly employed English teacher. Though he’s had a teaching licence for some time, he hasn’t had much luck with getting jobs, so this is his first time teaching in front of a classroom. Before this, he used to work in the city at a cram school. He’s optimistic and a bit straight forward, but he’s long held the dream of becoming a teacher. Due to an incident in the past he was involved in, he’s extremely sincere in his dedication to the students, but he often misses the mark. Due to moving for his new job, he was recently dumped by his girlfriend. He’s the youngest child of a family who run a western restaurant in Yokosuka. A heavy drinker. He falls in love quickly."},{"spoiler":false,"text":"Source: official website profile"}],"source":"vndb","sourceCharacterId":"c135733"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb501ee8a804dd4073b0b7d244d9c2fd2f5ef4427663aa886aded5990eef4a67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d69969a59a55ed3b55b008556fce0bd9c73799f8e0827304e2e2240b79a465e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿部 敦","creatorId":"vndb:s633","sourcePersonId":"vndb:s633","canonicalEntityId":"vndb:s633","name":"阿部 敦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31048","source":"vndb"}]},{"characterId":"char_vndb_c135734","characterName":"津久居賢太郎","sourceIds":{"vndbCharacterId":"c135734"},"originalCharacterName":"津久居賢太郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"129"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"66"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“You aren’t the ones who locked me up, and haven’t been threatening me."},{"spoiler":false,"text":"––What are you after? ”"},{"spoiler":false,"text":"A writer for the Hokuto weekly newspaper who specialises in columns and articles regarding juvenile crimes. After finding out his younger brother Mikage Seishirou, who he hadn’t seen since their parents divorced, had died under mysterious circumstances, he came to the school to investigate it himself. Thanks to his stern appearance and blunt way of speaking, there are a lot of people who hate him both publicly and privately. Due to being busy with work, his treatment of his brother in recent years had been rather uncaring, which he regrets. He’s generally outspoken and indifferent towards strangers, but at heart he’s the caring older brother type. A heavy smoker."},{"spoiler":false,"text":"Source: official website profile"}],"source":"vndb","sourceCharacterId":"c135734"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1822cd00e425b51dd6f431592dbb53d4154d3eeb0c0cc695f71c5d9eaf7fc5c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9abbc1ee30a2931844447555b7c4edf57f6d6ca12e7bb36a789be0969d081898.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野島 健児","creatorId":"vndb:s380","sourcePersonId":"vndb:s380","canonicalEntityId":"vndb:s380","name":"野島 健児","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31047","source":"vndb"}]},{"characterId":"char_vndb_c135735","characterName":"久保谷瞠","sourceIds":{"vndbCharacterId":"c135735"},"originalCharacterName":"久保谷瞠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"401"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Can you promise me? If anything happens, don’t listen to what anyone says but me.”"},{"spoiler":false,"text":"An orphan raised in a facility run by the church next to the school grounds, which makes him unusual for a student at such a prestigious school. He’s a mood-maker who is kind and cheerful to everyone, but at the same time he takes extreme consideration for those around him. For some reason, he has a tendency to get extremely neurotic whenever it concerns his long involvement with his guardian or the stress of dealing with his homeroom teacher. He’s skilled with his hands, and has a good memory. He’s part of the church choir."},{"spoiler":false,"text":"He’s cocky towards Izumi, but is weak to Kaya."},{"spoiler":false,"text":"Source: official website profile"}],"source":"vndb","sourceCharacterId":"c135735"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5d6ac3f78965940ae1b02d12732cd6059c954ad1eb53ffc1f7ae194ec744ac3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/438d7d3cf3db90f24a8baf7e791b398fe991cd3bd8224b0998833f106badea23.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤羽根 健治","creatorId":"vndb:s1381","sourcePersonId":"vndb:s1381","canonicalEntityId":"vndb:s1381","name":"赤羽根 健治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31050","source":"vndb"}]},{"characterId":"char_vndb_c135736","characterName":"辻村煉慈","sourceIds":{"vndbCharacterId":"c135736"},"originalCharacterName":"辻村煉慈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"818"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"184"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"67"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“The greatest mysteries don’t come from plot twists or bizarre occurrences."},{"spoiler":false,"text":"––It’s when nobody’s able to find the body.”"},{"spoiler":false,"text":"Though he’s still a student, he’s a published author with up-and-coming newcomer awards under his belt. He has a tendency to ask lots of questions, and speaks as though he’s trying to control the conversation. He’s arrogant, proud, and doesn’t hold back his opinions, and though he considers himself an intellectual who favours debate, when he gets annoyed he’s quick to start a fight. He’s in charge of cooking at the Ghost Tower. The taste isn’t bad but it leaves something to be desired."},{"spoiler":false,"text":"He’s cocky towards Shiramine, but is weak to Izumi."},{"spoiler":false,"text":"Source: official website profile"}],"source":"vndb","sourceCharacterId":"c135736"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b933673fc60f4cda36f8cc38fbb8c96f15de8ef0cb238847d3a395c5d7fbc72c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b8fc54cd2ec73570627944f3aa32d31be7ab1e4d36271632de77737f728bc0f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31044","source":"vndb"}]},{"characterId":"char_vndb_c135737","characterName":"茅晃弘","sourceIds":{"vndbCharacterId":"c135737"},"originalCharacterName":"茅晃弘","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"408"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“We should just kill him and put him in his grave. Why are you all hesitating?”"},{"spoiler":false,"text":"The school’s student council president. No matter who he’s speaking to, he always greets them with the same kind, unwavering smile. He’s part of a powerful political family, his father a respected attorney. Because of this, teachers are always careful around him. He’s the model student, both good at sports and with excellent grades, but underneath that, he has no interests and is indifferent to most things. The only thing close to a hobby is going jogging every morning and evening. He has an older brother who’s currently in hospital."},{"spoiler":false,"text":"He’s cocky towards Kuboya, but is weak to Shiramine."},{"spoiler":false,"text":"Source: official website profile"}],"source":"vndb","sourceCharacterId":"c135737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbf3a50f8bc0948afab98b49f53ed59a478330354833ff61c11b28874e081428.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1c3630f8449725f857f1128f472a67cc35685fb369da4fe77da81d363c6f392.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井 孝宏","creatorId":"vndb:s50","sourcePersonId":"vndb:s50","canonicalEntityId":"vndb:s50","name":"櫻井 孝宏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31045","source":"vndb"}]},{"characterId":"char_vndb_c135738","characterName":"和泉咲","sourceIds":{"vndbCharacterId":"c135738"},"originalCharacterName":"和泉咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1103"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“If I died–– would you cry for me?”"},{"spoiler":false,"text":"A student who seems to get involved in a lot of accidents and get injured frequently, so is often absent from school. He finds it hard to show his emotions on his face, but contrary to his small, meek appearance he has a sharp tongue and a dry sense of humour. He’s also fond of pranks, but he’s often misunderstood by others, and has ended up with the impression of being difficult to get along with. He’s a big eater and loves using his mobile phone, and is a fickle troublemaker."},{"spoiler":false,"text":"He’s cocky towards Tsujimura, but is weak to Kuboya."},{"spoiler":false,"text":"Source: official website profile"}],"source":"vndb","sourceCharacterId":"c135738"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f9d1ac3a12b843aef842483a9362023a24f3b301dde429d1b4f86a5b6d21b46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5d3ecfa1692c7491996a3f8b413ae978a602570fd4dd5a1b5d0cbb75ce309ea.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木 千尋","creatorId":"vndb:s182","sourcePersonId":"vndb:s182","canonicalEntityId":"vndb:s182","name":"鈴木 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31046","source":"vndb"}]},{"characterId":"char_vndb_c135739","characterName":"白峰春人","sourceIds":{"vndbCharacterId":"c135739"},"originalCharacterName":"白峰春人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"923"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“I’m not expecting much of you. So please just respect this one thing. Don’t intrude on our business.”"},{"spoiler":false,"text":"The student who’s chosen for the role of Mary in the school nativity play. He’s a sociable but private person who speaks as if he’s playing with you, giving off the feeling he’s planning something, and smiles with intention. Though he keeps himself well put together, behind that he’s extremely empathetic to others, and hates people who use violence for no reason. He has a low blood pressure and is often tired, struggling to wake up in the mornings. His parents live in Tokyo and run an antiques store."},{"spoiler":false,"text":"He’s cocky towards Kaya, but is weak to Tsujimura."},{"spoiler":false,"text":"Source: official website profile"}],"source":"vndb","sourceCharacterId":"c135739"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/217ad100b265478029c1459ddcefe16d69d566e9e8abbf2ba87932fc96b2b6ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5439936c0c213a2a47edc6234c9f50a5dc1b6f61de7aeb4563f9c9876bbdcdf7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"箭内 仁","creatorId":"vndb:s1876","sourcePersonId":"vndb:s1876","canonicalEntityId":"vndb:s1876","name":"箭内仁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31051","source":"vndb"}]},{"characterId":"char_vndb_c135740","characterName":"御影清史郎","sourceIds":{"vndbCharacterId":"c135740"},"originalCharacterName":"御影清史郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"814"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One day in the middle of a storm he went out to the riverside to take photos, and never came back. Some of the items he had with him have been retrieved from the river, but his body still has yet to be found. A date for his funeral has been decided, but there are still many unexplained circumstances surrounding his death. His previous surname was Tsukui, which changed due to his parents’ divorce, and he is the younger brother of Kentarou. He used to live in the Ghost Tower."},{"spoiler":false,"text":"Source: official website profile"}],"source":"vndb","sourceCharacterId":"c135740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfccbb66beaaa944a023bf37ef80cd07cb96b0e1de1c750c3b85910e83941901.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/ima