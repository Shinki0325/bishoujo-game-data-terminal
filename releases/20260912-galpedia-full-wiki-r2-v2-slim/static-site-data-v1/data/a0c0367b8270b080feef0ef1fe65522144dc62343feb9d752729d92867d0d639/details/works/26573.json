{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26573","model":{"presentationWorkId":"egs:26573","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_105911","characterName":"エリン","sourceIds":{"bangumi":[{"characterId":"105911","match":"source-roster","subjectId":"321362"}]},"originalCharacterName":"エリン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「つまりはそういう仕事ってことよね。ま、お金の為なら」"},{"spoiler":false,"text":"傭兵。二十歳。身長低め（１５０センチ程度）、バスト大きめ（Ｃカップ程度）、童顔。"},{"spoiler":false,"text":"全体的に細く小さいが、尻から太ももにかけて肉がついている。"},{"spoiler":false,"text":"家が貧しかった為、幼い頃から戦ってお金を稼いでいた。"},{"spoiler":false,"text":"通っていた学校で魔物に襲われ死亡したと処理されてからは、"},{"spoiler":false,"text":"家に帰ることも出来ず傭兵として各地を渡り歩いている。"},{"spoiler":false,"text":"クールな性格で、感情をあまり顔に出さない。"},{"spoiler":false,"text":"加えてかなりドライで、目的の為なら多少の違法行為や性交渉も辞さない。"},{"spoiler":false,"text":"性行為はあくまで手段と割り切っている。"},{"spoiler":false,"text":"行為中はしっかり喘ぐが、目的を達成したら切り替えていつもの表情に戻る。"}],"source":"bangumi","sourceCharacterId":"105911"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b7f357f9e3c0480e5670c625473b17bb287b39241abd4729c9c7b807096d650.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/927146bb35a6b743930862f992f410b654475fa1c80578f2e8bc4498d6169ba9.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緑野らいむ","creatorId":"vndb:s21198","sourcePersonId":"vndb:s21198","canonicalEntityId":"vndb:s21198","name":"緑野 らいむ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:321362:105911:49333:1","source":"bangumi"}]},{"characterId":"char_bangumi_105912","characterName":"トムキャット","sourceIds":{"bangumi":[{"characterId":"105912","match":"source-roster","subjectId":"321362"}]},"originalCharacterName":"トムキャット","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「は～い。素材獲得おめでとうございま～す♪」"},{"spoiler":false,"text":"ナイトホークの『きょうだい』。精霊。見た目年齢は二十代半ば。"},{"spoiler":false,"text":"身長やや高め（１６０センチ弱）、巨乳（Ｆカップ程度）。"},{"spoiler":false,"text":"全身からエロスが滲み出ている綺麗なお姉さん。盾の精霊で、本来はナイトホークと同じく実体を持たない。"},{"spoiler":false,"text":"通りすがりの女魔導士の身体を借りて、エリンたちの前に現れた。"},{"spoiler":false,"text":"笑顔を絶やさない優しそうな見た目だが、実は腹黒。"},{"spoiler":false,"text":"姉であるナイトホークに強い憧れを持っており、重度のシスコン。"},{"spoiler":false,"text":"本来の姿は少年。姉に憧れるあまりゴスロリで女装している。"}],"source":"bangumi","sourceCharacterId":"105912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85c9daa8c1121ab96db3ba86b32b7751202e6af21888f9bfb5082c3cec370ed8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b74a37218851ba5a3c4ce2473ba0e3838e8436a1fa18e98b7c169e171ead2ff2.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_94546","characterName":"ナイトホーク","sourceIds":{"bangumi":[{"characterId":"94546","match":"source-roster","subjectId":"321362"}]},"originalCharacterName":"ナイトホーク","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"自称・剣の精霊。身長低め（１４０センチ程度）、ツルペタ。"},{"spoiler":false,"text":"実体を持たない存在で普段はエリンにしか見えず、戦う時には剣として現れる。"},{"spoiler":false,"text":"剣の精霊と名乗っているが、武器になら何にでも変化出来る。"},{"spoiler":false,"text":"学校で魔物に襲われ死にかけていたエリンと出会い、彼女の身体に間借りすることで彼女を救い、"},{"spoiler":false,"text":"以後ともに行動している。魔力（生命力）の源は殿方の精子。"},{"spoiler":false,"text":"魔物でも問題ない。本人いわく『好きだから』。"},{"spoiler":false,"text":"元気でお気楽な性格。感情に合わせて表情がコロコロ変わる。基本的に思考はエロ。"},{"spoiler":false,"text":"精子が魔力源の為、事あるごとにエリンにエロいことをさせようとする。"},{"spoiler":false,"text":"本人もエロいこと大好き。"}],"source":"bangumi","sourceCharacterId":"94546"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/530c0b2cb3c4d15eb2b656ddd393812e395ac002bf6c6e9db9690f9bdccf9021.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da715febbb25ed5f6d661af4552321b0f31640a36dc139334205d08748f362e1.webp","width":154,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p5367","sourceCompanyId":"egs:brand:2574","canonicalEntityId":"vndb:p5367","name":"sugar star","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26573:2574","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
