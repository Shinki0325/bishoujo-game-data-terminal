haracterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"...Even so, I want to create my ideal order of knights. I want to carve out the future together with them.\""},{"spoiler":false,"text":"She is the third princess of the country of Temilana. She has \"strong luck\" that allows her to visually see the path she should take when she is in danger."},{"spoiler":false,"text":"As a member of the royal family, she behaves gracefully in public, but when she talks to her close friends, she uses informal language and shows her normal girlish side."},{"spoiler":false,"text":"Because she is hated by the royal family as a \"cursed princess\", she lives in a short distance away from the royal castle."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c104701"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f92c9e4084685c0329dced71b0db53752e38f4730caa19385032cc9e150227a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dc7463a45c4bd441c40b006660fcb49638d5d7d5592bb415e078f0407921f5b.webp","width":198,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c104702","characterName":"ジョセフィ・コーネルヒルド・ゾンダリク","sourceIds":{"vndbCharacterId":"c104702"},"originalCharacterName":"ジョセフィ・コーネルヒルド・ゾンダリク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"66"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"As your knight, I will become your sword and shield, and vow to protect you. I'll lend you my strength. Feel honored.\""},{"spoiler":false,"text":"A prince of the ruined country \"Zondalik\", he now lives with the traveling troupe \"Marveil Theater\"."},{"spoiler":false,"text":"He is a proud man who is unable to speak well of others, and he is not afraid to talk to Cecilia. He also has an immature side, as he easily falls for provocations."},{"spoiler":false,"text":"However, he always has a strong desire to revive the Kingdom of Zondalik."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c104702"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d81d01909d24b4639f369f4fe24f42b3063580789318baa55adc8061665cc30d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2aa1e15958ccb72217dd13e45071ade67fd8951ae6750c6a5011357a989b1db9.webp","width":206,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古川 慎","creatorId":"vndb:s7848","sourcePersonId":"vndb:s7848","canonicalEntityId":"vndb:s7848","name":"古川 慎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90575","source":"vndb"}]},{"characterId":"char_vndb_c104703","characterName":"アデル・ナレス","sourceIds":{"vndbCharacterId":"c104703"},"originalCharacterName":"アデル・ナレス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"height":{"reviewState":"source-only","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"My name is Adel Nares. But you don't have to remember it. I usually don't even go inside the Royal City...\""},{"spoiler":false,"text":"He is the eldest son of a very poor family living in Samari Village, Shimominku."},{"spoiler":false,"text":"He is a gentle and caring person who takes care of his nine younger siblings."},{"spoiler":false,"text":"He is unable to attend school due to his poverty, but this changes when he meets Cecilia."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c104703"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ec26da778159c10550744fa17271d79dba3b2048033a3f128b857dfa4c0d563.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8167e324190546f5dfd674d1667dba1bb59d0c8905f9cd09427f845340e8b128.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"狩野 翔","creatorId":"vndb:s15015","sourcePersonId":"vndb:s15015","canonicalEntityId":"vndb:s15015","name":"狩野翔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90580","source":"vndb"}]},{"characterId":"char_vndb_c104704","characterName":"トビアス・ハーベック・フレイ","sourceIds":{"vndbCharacterId":"c104704"},"originalCharacterName":"トビアス・ハーベック・フレイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Someday, I will become a splendid knight like Commander Herringtail... ーGhaha!\""},{"spoiler":false,"text":"The head of the fallen aristocracy, the Habeck family, who has no parents or grandparents and is lonely."},{"spoiler":false,"text":"He is so sickly that he collapses after just a short walk, so he tends to be a recluse."},{"spoiler":false,"text":"He is reluctant to love, to live, and to do anything, but his yearning to be a knight is stronger than anyone else's."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c104704"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/655ce2a2543190ef25465ccb022c11c011e68db86d610bb7ba4f6cb4b3165ef4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1acdb72f4b07c033af111fb5f0404f455a4fe2c54abac6080394c13a83d41def.webp","width":207,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 裕介","creatorId":"vndb:s8317","sourcePersonId":"vndb:s8317","canonicalEntityId":"vndb:s8317","name":"小林 裕介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90576","source":"vndb"}]},{"characterId":"char_vndb_c104705","characterName":"ミラン・へリング","sourceIds":{"vndbCharacterId":"c104705"},"originalCharacterName":"ミラン・へリング","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"73"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I am a decorative blacksmith. I've always been a decorative blacksmith. I can't afford to worry about anything else.\""},{"spoiler":false,"text":"He is the owner of the blacksmith store \"Herring\" in the town of Balarboa in the common district. He runs the business by himself."},{"spoiler":false,"text":"He has been a blacksmith since his childhood. He is a typical craftsman."},{"spoiler":false,"text":"He sometimes destroys his own work if he doesn't like it."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c104705"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f9ada06297803c6aa501549ce53cc0f814ce21b9db766432319e2c001b78bde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28c2ca080069690f0300aa127040d6ec37556c7ce1b343d17dc7498785738804.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阪口 周平","creatorId":"vndb:s5072","sourcePersonId":"vndb:s5072","canonicalEntityId":"vndb:s5072","name":"阪口周平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90574","source":"vndb"}]},{"characterId":"char_vndb_c104706","characterName":"キア・ネルティ","sourceIds":{"vndbCharacterId":"c104706"},"originalCharacterName":"キア・ネルティ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I have a disease that makes me forget things easily. I have to write things down because tomorrow I'll forget them. I have to write everything down.\""},{"spoiler":false,"text":"A boy with no relatives that lives in the Nelty Foster Home."},{"spoiler":false,"text":"He developed a memory disorder when he was a child, and since then he forgets any event that happens after a day."},{"spoiler":false,"text":"He