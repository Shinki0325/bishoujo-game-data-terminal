{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7848","model":{"presentationWorkId":"vndb:v7373","staff":{"artwork":[{"creditedName":"辰波要徳","creatorId":"vndb:s3732","sourcePersonId":"egs:creator:1113","canonicalEntityId":"vndb:s3732","name":"辰波要徳","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:19696","source":"egs"},{"creditedName":"ほたかたまごろー","creatorId":"vndb:s6003","sourcePersonId":"egs:creator:3372","canonicalEntityId":"vndb:s6003","name":"ほたかたまごろー","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21108","source":"egs"}],"scenario":[{"creditedName":"髪ノ毛座","creatorId":"vndb:s1948","sourcePersonId":"egs:creator:2275","canonicalEntityId":"vndb:s1948","name":"髪ノ毛座","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:19697","source":"egs"},{"creditedName":"武田正憲","creatorId":"vndb:s41992","sourcePersonId":"vndb:s41992","canonicalEntityId":"vndb:s41992","name":"武田正憲","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:70503","source":"vndb"}],"music":[{"creditedName":"加納 しぐまん","creatorId":"vndb:s11067","sourcePersonId":"vndb:s11067","canonicalEntityId":"vndb:s11067","name":"加納 しぐまん","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:70502","source":"vndb"}],"other":[{"creditedName":"辰波要徳","creatorId":"vndb:s3732","sourcePersonId":"egs:creator:1113","canonicalEntityId":"vndb:s3732","name":"辰波要徳","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21109","source":"egs"},{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70200","source":"egs"}]},"cast":[{"characterId":"char_c58839","characterName":"山波 美奈保","sourceIds":{"bangumi":[{"characterId":"144115","match":"exact-normalized-name-in-linked-work","subjectId":"81258"}],"egsCharacterIds":["25359"],"vndbCharacterId":"c58839"},"originalCharacterName":"山波 美奈保","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a big sister who loves her little brother. Her father, Juubee, was worried about her doting on her younger brother and recommended her to study abroad."},{"spoiler":false,"text":"However, after being exposed to the liberal values of the U.S., much to her father's dismay, she returned home with confidence in herself and her love for her younger brother was stronger than ever."},{"spoiler":false,"text":"At the moment, she wears a maid's outfit to take care of her younger brother in the house. Although she has a strong image of a pampered big sister, she actually has a high IQ level and excels academically!"},{"spoiler":false,"text":"She has a surprising side to her that is not limited to languages, but also has a talent for geological analysis and other areas."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58839"},{"segments":[{"spoiler":false,"text":"主人公のお姉ちゃん。"},{"spoiler":false,"text":"主人公＝弟を溺愛し過ぎているため、それを心配した父親・十兵衛に海外留学させられるが、逆に海外の自由な価値観に触れ、弟が大好きな自分に自信を持って帰国。"},{"spoiler":false,"text":"弟に甘えん坊な彼女だが、IQは非常に高く、学業優秀。"}],"source":"egs","sourceCharacterId":"25359","sourceWorkId":"7848","spoiler":false},{"segments":[{"spoiler":false,"text":"弟大好きなお姉ちゃん。"},{"spoiler":false,"text":"弟を溺愛していることを父親の十兵衛に心配され留学を薦められた。ところが、アメリカの自由な価値観に触れて父親の願い空しく、弟が大好きな自分に自信をもって帰ってきてしまった。目下のところ、家の中で弟の世話を焼くためにメイド服を着たりしている。"},{"spoiler":false,"text":"甘えん坊のお姉ちゃんのイメージが強いが、実はIQ値が高く学業の成績は抜群！語学だけにとどまらず、地質分析などの方面にも才を持っていたりする意外な面もあり。"}],"source":"bangumi","sourceCharacterId":"144115"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbea4f1b6aaef9255083d90f553694c0ea03a5f991aecb1005a9c24a42ce73f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7b9d4ada144ce3e918cb1d8b489fef9723bc3585eef84b34db5ad34392f27fd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩村琴美","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81258:144115:4813:1","source":"bangumi"}]},{"characterId":"char_c58842","characterName":"結城 桃子","sourceIds":{"bangumi":[{"characterId":"144116","match":"exact-normalized-name-in-linked-work","subjectId":"81258"}],"egsCharacterIds":["25360"],"vndbCharacterId":"c58842"},"originalCharacterName":"結城 桃子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a somewhat strong-willed and conservative class president. In junior high school, she was not very well developed, but after entering high school, she grew up rapidly!"},{"spoiler":false,"text":"She forced Masamune to join her by recommending him to be a representative for the boys in class. She does all the work for the unwilling Masamune."},{"spoiler":false,"text":"She has liked Masamune since she was a child, but since Masamune was very attached to his big sister and Momoko had very small breasts at that time, she was not taken seriously."},{"spoiler":false,"text":"However, Momoko who was told by Minaho to take care of Masamune when she studied abroad with her big sister, convinced herself that she got her approval."},{"spoiler":false,"text":"Momoko is concerned about Masamune, but she is unable to tell him about her secret feelings. Momoko's pure love is on the verge of a crisis when Masamune's sister comes back as a temporary teacher!"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58842"},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"主人公とクラスも一緒で、委員長も務める。"},{"spoiler":false,"text":"性格は、やや気が強く、サバサバした感じ。"},{"spoiler":false,"text":"***時代は、発育はさほどでもなかったが、ここに来て急成長し、立派な“たっぷん”になった。"},{"spoiler":false,"text":"美奈保が留学する際に「正宗ちゃんをよろしくね」と頼まれたことから、「正宗はアタシがいなくちゃダメ！」と思い込んでおり、何かと主人公の世話を焼きたがる。"}],"source":"egs","sourceCharacterId":"25360","sourceWorkId":"7848","spoiler":false},{"segments":[{"spoiler":false,"text":"やや気が強いサバサバした委員長。"},{"spoiler":false,"text":"中学の頃は、あまり発育はよくなかったが高校に入って急成長！"},{"spoiler":false,"text":"ムネも成長し微乳娘は美乳娘に（笑）"},{"spoiler":false,"text":"無理やり正宗を男子学級委員に推薦したりして、自分の近くに正宗が来るように仕向けてた。"},{"spoiler":false,"text":"（おかげで、やる気のない正宗の仕事は全てやっている）"},{"spoiler":false,"text":"子供の頃から正宗が好きだったけど、正宗は「お姉ちゃん」にべったりだしその頃の桃子は微乳だったので相手にしてもらえなかった。"},{"spoiler":false,"text":"しかし、お姉ちゃん留学の際に『正宗ちゃんをよろしくね』といわれていた桃子は「正宗はアタシがいなくちゃダメ！」と思い込んでしまった。"},{"spoiler":false,"text":"正宗のことが気になりながらも、内に秘めた思いを告げられない……。"},{"spoiler":false,"text":"そんな中、正宗の姉が、臨時教員で帰ってきて桃子の純愛は危機一髪、臨戦体制！"}],"source":"bangumi","sourceCharacterId":"144116"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7381bac1c32d6873c522e5072ad309106cb0ed0f59405359591550a1bf27dcc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99a0909d1f5dfc59e83db2e95ee2ddf887b8ea0b7fa77d5a43a6917e1f9942fd.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c58845","characterName":"齋藤 千春","sourceIds":{"bangumi":[{"characterId":"144117","match":"exact-normalized-name-in-linked-work","subjectId":"81258"}],"egsCharacterIds":["25363"],"vndbCharacterId":"c58845"},"originalCharacterName":"齋藤 千春","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A friend of Momoko. She is a cheerful girl who always seems to be at ease. While she admires Momoko's aggressive attitude, she is also a good advisor for Momoko, who has many unexpected problems."},{"spoiler":false,"text":"She is also an author of erotic doujinshi and has a great interest in sex. She is open to all kinds of erotica (yaoi, yuri, and regular stuff)."},{"spoiler":false,"text":"She seems to be doing research by showing Momoko what she has written, but in fact she enjoys seeing Momoko's reaction. When she writes, she wears glasses."},{"spoiler":false,"text":"Her usual calm and natural atmosphere disappears and her eyes become sharp when focusing on her work. She is an impressionable young woman with an ear for music. However, she is not very good at love or sex."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58845"},{"segments":[{"spoiler":false,"text":"明るくほんわかとした桃子の友人。"},{"spoiler":false,"text":"積極的な桃子に憧れを抱きつつも、意外に悩みの多い桃子の良き相談役としてエールを送る。"},{"spoiler":false,"text":"エロ同人誌（小説系）の作家でもあり、エッチに関して興味津々（百合もボーイズもOK）。"},{"spoiler":false,"text":"完成した作品を桃子に見せては、そういったエッチに疎い桃子の反応を楽しんでいる。"},{"spoiler":false,"text":"文章を書くときは眼鏡をかけるのだが、途端にこれまでのおっとり天然の雰囲気が消え、眼光鋭くなる。"},{"spoiler":false,"text":"ちなみに彼女も立派な巨乳。"}],"source":"egs","sourceCharacterId":"25363","sourceWorkId":"7848","spoiler":false},{"segments":[{"spoiler":false,"text":"桃子お友達。"},{"spoiler":false,"text":"いつもほんわか明るいの女の子。"},{"spoiler":false,"text":"やっぱり巨乳（笑）積極的な桃子に憧れつつ、意外と悩みの多い桃子のよき相談役でもある。"},{"spoiler":false,"text":"エロ系同人誌(文章系)の作家もしており、えっちに対する興味はかなりのもの。"},{"spoiler":false,"text":"（ボーイズも百合も普通のものもなんでもＯＫ）"},{"spoiler":false,"text":"書いたものを桃子に見せてリサーチしてるようだけど、実は意外とオクテな桃子の反応を楽しんでいる。"},{"spoiler":false,"text":"文章を書くときは眼鏡をかける。"},{"spoiler":false,"text":"すると…いつものおっとりとした天然な雰囲気は消えて眼光鋭くなる。"},{"spoiler":false,"text":"耳年増で多感なお年頃。"},{"spoiler":false,"text":"でも、自分の恋愛とかえっちに関してはオクテ。"}],"source":"bangumi","sourceCharacterId":"144117"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a1adc1ad8db091d149adafc6cb92f5a1cbf62a0c52366ad9eb2e4bdbf7e123e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46561ccc236de11242e80ab4628ce992f20530ff74da6724ab96d6dc2d4daf2e.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81258:144117:4646:1","source":"bangumi"}]},{"characterId":"char_c58846","characterName":"北条 悟","sourceIds":{"bangumi":[{"characterId":"199079","match":"exact-normalized-name-in-linked-work","subjectId":"81258"}],"egsCharacterIds":["25362"],"vndbCharacterId":"c58846"},"originalCharacterName":"北条 悟","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a good advisor to Masamune. He is the mediator between Masamune and Momoko."},{"spoiler":false,"text":"He is quite handsome, but due to some circumstances in his past, he is no longer aggressive with women."},{"spoiler":false,"text":"He smilingly watches over Masamune, who is adored by two attractive women."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58846"},{"segments":[{"spoiler":false,"text":"主人公の親友にして、主人公と桃子の仲裁役。"},{"spoiler":false,"text":"なかなかのイケメンであるが、とある過去の出来事から女性に対し、積極的になれなくなってしまった。"},{"spoiler":false,"text":"女性の扱いは非常に上手く、そういったことに疎い主人公の良き相談相手になっている。"},{"spoiler":false,"text":"そして、ふたりの女性から慕われる主人公の行く末を微笑ましく見守っている、なんとも心優しき男。"}],"source":"egs","sourceCharacterId":"25362","sourceWorkId":"7848","spoiler":false},{"segments":[{"spoiler":false,"text":"正宗のよき相談相手。"},{"spoiler":false,"text":"正宗と桃子の仲裁役。"},{"spoiler":false,"text":"なかなかのイケメンなのだけど、過去のちょっとした事情から女性に積極的でなくなってしまった。"},{"spoiler":false,"text":"女性の扱いに対しては正宗の先輩。"},{"spoiler":false,"text":"2人の魅力的な女性から慕われる正宗を微笑ましく見守っている。"}],"source":"bangumi","sourceCharacterId":"199079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/757dca020a3eefe2c149d1d07a03c217a086c9c157246f7ebc28f855fd8d8a8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43cc2c907610ec0f93928f06cd17cdee09a5bbb05702c7f489c0f29556ac58a9.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鉄 滝次","creatorId":"vndb:s5677","sourcePersonId":"vndb:s5677","canonicalEntityId":"vndb:s5677","name":"鉄滝次","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39604","source":"vndb"}]},{"characterId":"char_c58847","characterName":"山波 十兵衛","sourceIds":{"bangumi":[{"characterId":"199078","match":"exact-normalized-name-in-linked-work","subjectId":"81258"}],"egsCharacterIds":["25361"],"vndbCharacterId":"c58847"},"originalCharacterName":"山波 十兵衛","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the father of Masamune and Minaho. Worried about his daughter's feelings for her brother, he sends her abroad to study, but in exchange he must allow her to be assigned as his homeroom teacher."},{"spoiler":false,"text":"He is a strict but overly lenient father. He advises Masamune on what to do, but also enjoys teasing him. He is quite busy, and often doesn't come home leaving the two alone for months. However, he worries about the two of them, and acts as an eccentric detective."},{"spoiler":false,"text":"He is a complete nuisance to both his children."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58847"},{"segments":[{"spoiler":false,"text":"主人公と美奈保の父親にして、山波学園の理事長。"},{"spoiler":false,"text":"主人公の「お姉ちゃん萌え」を心配し、美奈保を海外に留学させ、引き離すことに成功したものの、それと引き換えに主人公が在学中の担任教師として赴任することを承諾してしまう、厳しいようで全く激甘な父親。"},{"spoiler":false,"text":"1ヶ月だけ主人公と美奈保をふたりだけで過ごさせてあげようとするが、心配のあまり風変わりな探偵を装い、彼らの周囲に出没する。"}],"source":"egs","sourceCharacterId":"25361","sourceWorkId":"7848","spoiler":false},{"segments":[{"spoiler":false,"text":"山波学園の理事長であり、主人公の正宗、姉美奈保の父。"},{"spoiler":false,"text":"正宗の「お姉ちゃん萌え」が心配で、美奈保を海外留学させたものの、それと引き換えに正宗の在学中に担任教師として赴任することを許してしまった。"},{"spoiler":false,"text":"厳しいようで甘すぎる父。"},{"spoiler":false,"text":"正宗のよき相談相手でもあり、しかしおちょくっているようでもある。"},{"spoiler":false,"text":"基本的にヒマそうなので遊びに行ってあげないと所構わず電話をかけてくる。"},{"spoiler":false,"text":"一ヶ月間だけのサービスということで美奈保と正宗を家に二人きりにするために家には帰ってこない…。"},{"spoiler":false,"text":"しかし2人のことが心配で心配でエキセントリックな探偵行動をとる。"},{"spoiler":false,"text":"二人にとっては完全なるお邪魔虫なのである。"}],"source":"bangumi","sourceCharacterId":"199078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a64ce0153ac09b4a708919fc574de90ba28c5a903cedf8ac829112ca8a4523a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/ima