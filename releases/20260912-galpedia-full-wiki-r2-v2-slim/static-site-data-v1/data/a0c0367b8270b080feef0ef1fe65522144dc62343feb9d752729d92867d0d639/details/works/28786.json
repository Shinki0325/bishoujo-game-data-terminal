e-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく温和。"},{"spoiler":false,"text":"ちょっと先の未来が読めて、天気や動物の気持ちがわかる。"},{"spoiler":false,"text":"正義感があるが勇気がなくて戸惑いがち。"},{"spoiler":false,"text":"魔法少女として成長すると共に勇気と行動力を持ち、 心身ともに強く美しく変化していく。"}],"source":"egs","sourceCharacterId":"22521","sourceWorkId":"28786","spoiler":false},{"segments":[{"spoiler":false,"text":"开朗且温和。"},{"spoiler":false,"text":"能预测稍微未来发生的事情，可以了解天气与动物的心情。"},{"spoiler":false,"text":"一直烦恼于有正义感却没有付诸行动的勇气。"},{"spoiler":false,"text":"成长为魔法少女后，有了付诸行动的勇气，身心都变得强大且美丽。"}],"source":"bangumi","sourceCharacterId":"75060"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2535eb5396b24fddfb221c708e0fc25fd579e4a8fd8c1fa2c6ecb422fce23f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15420322389fd72d60ea0535b8b4ee594c95fef7e92d1762c72afdcfdf8d3864.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298578:75060:20833:1","source":"bangumi"}]},{"characterId":"char_c88440","characterName":"アンジェラ","sourceIds":{"bangumi":[{"characterId":"75061","match":"exact-normalized-name-in-linked-work","subjectId":"298578"}],"egsCharacterIds":["22522"],"vndbCharacterId":"c88440"},"originalCharacterName":"アンジェラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大人びており、物静か。ノエルのお姉さん的存在。"},{"spoiler":false,"text":"聖光天使の素養を持つ少女に力を与える。"},{"spoiler":false,"text":"力を使ってしまうと実体が保てない。"},{"spoiler":false,"text":"知識が豊富。ノエルをサポートする。"}],"sou