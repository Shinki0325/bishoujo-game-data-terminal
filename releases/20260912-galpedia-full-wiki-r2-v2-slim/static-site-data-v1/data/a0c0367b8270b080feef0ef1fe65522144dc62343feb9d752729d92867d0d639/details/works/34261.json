vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"....Slashing. It is my very essence.\""},{"spoiler":false,"text":"A mystifying presence among the quartet of Night Ogres terrorizing Ouma City, Mutsu is referred to as the \"Blade Ogre\" by those in the demon-slaying community. A study in stillness, this taciturn girl is an enigma wrapped in silence. Her stone-faced demeanor belies a heart of unwavering loyalty and purity."},{"spoiler":false,"text":"Sworn to Charlotte, Mutsu executes missions ranging from frontline combat to shadow operations. Her arsenal consists of three enchanted swords, each imbued with unique properties. With each blade she draws, Mutsu's abilities and fighting style shift dramatically, keeping her foes forever on their toes."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c126890"},{"segments":[{"spoiler":false,"text":"桜舞市に現れた四夜魔の一人。"},{"spoiler":false,"text":"日本の魔祓いたちからは、“刃鬼ジンキ”と呼ばれている、無機質で物静かな少女。"},{"spoiler":false,"text":"寡黙かつ表情変化に乏しく、言動も必要最小限のため、何を考えているのか読み取りにくいが、真面目で純粋な性格。"},{"spoiler":false,"text":"シャルロッテに忠誠を誓っており、彼女の命令に従って、戦闘や裏工作など様々な作戦行動を行う。"},{"spoiler":false,"text":"帯刀している三振りの刀はそれぞれ異なる性質を備えた妖刀であり、 抜いた刀によってムツ自身の能力と戦闘スタイルも変化するという、特異な力を持っている。"}],"source":"egs","sourceCharacterId":"24674","sourceWorkId":"34261","spoiler":false},{"segments":[{"spoiler":false,"text":"桜舞市に現れた四夜魔の一人。"},{"spoiler":false,"text":"日本の魔祓いたちからは、“刃鬼”と呼ばれている、無機質で物静かな少女。"},{"spoiler":false,"text":"寡黙かつ表情変化に乏しく、言動も必要最小限のため、何を考えているのか読み取りにくいが、真面目で純粋な性格。"},{"spoiler":false,"text":"シャルロッテに忠誠を誓っており、彼女の命令に従って、戦闘や裏工作など様々な作戦行動を行う。"},{"spoiler":false,"text":"帯刀している三振りの刀はそれぞれ異なる性質を備えた妖刀であり、 抜いた刀によってムツ自身の能力と戦闘スタイルも変化するという、特異な力を持っている。"}],"source":"bangumi","sourceCharacterId":"133672"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"24674","sourceWorkId":"34261","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"24674","sourceWorkId":"34261","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"24674","sourceWorkId":"34261","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"24674","sourceWorkId":"34261","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"24674","sourceWorkId":"34261","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a6559ecc1d2d0ca78a75658b149a9e749a6b6f852a358702787178e52977b91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adee4c54744be0e6de87d1d18836bc8fde5bacc5cda4d860cc05f8b12066c00c.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉下撫子","creatorId":"vndb:s18213","sourcePersonId":"vndb:s18213","canonicalEntityId":"vndb:s18213","name":"倉下 撫子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:430691:133672:34868:1","source":"bangumi"}]},{"characterId":"char_c126891","characterName":"シャルロッテ","sourceIds":{"bangumi":[{"characterId":"133673","match":"exact-normalized-name-in-linked-work","subjectId":"430691"}],"egsCharacterIds":["24675"],"vndbCharacterId":"c126891"},"originalCharacterName":"シャルロッテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Keep dancing in your delusion. Your resolve, your efforts, everything you hold dear—all will be shattered under my feet.\""},{"spoiler":false,"text":"One of the four Night Demons who appeared in Ouma city."},{"spoiler":false,"text":"Among the Japanese demon-slayers, she is known as the \"Beauteous Ogre.\""},{"spoiler":false,"text":"A figure of stern elegance, she observes situations with piercing rationality and is calculative to a fault, treating allies as expendable pawns. Although she usually maintains a stoic, dispassionate demeanor, there are rumors of a fiery, passionate side that she keeps meticulously hidden."},{"spoiler":false,"text":"Though Charlotte's powers remain a mystery, it's said a Sennagi of the Mikosono previously defeated her. Yet here she is, back in Ouma, seemingly taking on a laissez-faire leadership role among the gathered Night Ogres, intervening only when necessary."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c126891"},{"segments":[{"spoiler":false,"text":"桜舞市に現れた四夜魔の一人。"},{"spoiler":false,"text":"日本の魔祓いたちからは、“貌鬼ボウキ”と呼ばれている、冷厳にして秀麗な女性。"},{"spoiler":false,"text":"常に合理的に状況を俯瞰し、目的を成し遂げるためなら味方さえ道具のように使い捨てる、冷徹な性格。"},{"spoiler":false,"text":"基本的に感情を前に出さず、誰に対しても冷静かつ無愛想に接する一方、激情家な一面も持っている。"},{"spoiler":false,"text":"その能力は不明。過去、神子園の『戦巫』によって討たれたとされていたが、再び桜舞の地に姿を現した。"},{"spoiler":false,"text":"集まった夜魔たちのリーダー格のようだが、必要な時を除き、彼女たちの行動については放任している。"}],"source":"egs","sourceCharacterId":"24675","sourceWorkId":"34261","spoiler":false},{"segments":[{"spoiler":false,"text":"桜舞市に現れた四夜魔の一人。"},{"spoiler":false,"text":"日本の魔祓いたちからは、“貌鬼”と呼ばれている、冷厳にして秀麗な女性。"},{"spoiler":false,"text":"常に合理的に状況を俯瞰し、目的を成し遂げるためなら味方さえ道具のように使い捨てる、冷徹な性格。"},{"spoiler":false,"text":"基本的に感情を前に出さず、誰に対しても冷静かつ無愛想に接する一方、激情家な一面も持っている。"},{"spoiler":false,"text":"その能力は不明。過去、神子園の『戦巫』によって討たれたとされていたが、再び桜舞の地に姿を現した。"},{"spoiler":false,"text":"集まった夜魔たちのリーダー格のようだが、必要な時を除き、彼女たちの行動については放任している。"}],"source":"bangumi","sourceCharacterId":"133673"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"24675","sourceWorkId":"34261","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"24675","sourceWorkId":"34261","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"24675","sourceWorkId":"34261","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"24675","sourceWorkId":"34261","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"24675","sourceWorkId":"34261","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5008004c2ba02c1618bb0b31f8993fcd9055f5fc9f85c05f062853f52a08631c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e59521b1c6da682ef99eb723b54c0ef6520cea615ad98f6d61ccd5e90fb9cfd.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"叶一華","creatorId":"vndb:s16232","sourcePersonId":"vndb:s16232","canonicalEntityId":"vndb:s16232","name":"叶一華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:430691:133673:33030:1","source":"bangumi"}]},{"characterId":"char_vndb_c130398","characterName":"徒野 さくや","sourceIds":{"vndbCharacterId":"c130398"},"originalCharacterName":"徒野 さくや","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"If you're ever in a bind, don't hesitate to reach out to me.\""},{"spoiler":false,"text":"The classmate to both Himeka and Souma, as well as the class representative."},{"spoiler":false,"text":"Sakuya is known for being reliably diligent and socially adept, winning trust and respect from both her peers and instructors in a way different from Himeka."},{"spoiler":false,"text":"She has been acquainted with Himeka since before their enrollment and is one of the few people that Himeka can genuinely call a friend."},{"spoiler":false,"text":"For Souma, who's new to the school, Sakuya proves to be quite accommodating. She goes out of her way to help him settle in, offering various forms of assistance and guidance."},{"spoiler":false,"text":"Despite her youthful appearance, Sakuya often displays a more mature demeanor, which adds an intriguing quality to her character. This unique blend of attributes has quietly garnered her a fair share of admirers."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c130398"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e663a8b8b29c92bee3404f08ede7cab93f2e7a1dfeff2c91e5ada87c094ba93.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0426e77aca7b7c2b3b0be9dbe2b83b9ea308e92c9c2b6948eab8720e3b4b6be3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花月 さや","creatorId":"vndb:s23345","sourcePersonId":"vndb:s23345","canonicalEntityId":"vndb:s23345","name":"花月さや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95031","source":"vndb"}]},{"characterId":"char_vndb_c130399","characterName":"酒井戸 清吉","sourceIds":{"vndbCharacterId":"c130399"},"originalCharacterName":"酒井戸 清吉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You in the back... or should I say, you back there? Either way, I guess this is destiny. Let's hit it off!\""},{"spoiler":false,"text":"A classmate of Himeka and Souma."},{"spoiler":false,"text":"Conveniently seated in front of Souma, who has recently transferred schools, they naturally fall into easy conversations and quickly become friends."},{"spoiler":false,"text":"Seikichi is an outgoing and genuine guy who values friendships. His upbeat nature can sometimes miss the mark when it comes to reading the room, but it's an endearing quirk rather than a fault."},{"spoiler":false,"text":"Born into a family that owns a liquor store, Sakaido is a wellspring of peculiar tidbits and trivia, thanks to the odd facts he picks up from customers—even if academics aren't exactly his strong suit."}],"source":"vndb","sourceCharacterId":"c130399"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57c885b1ac4fa08aedb02548963fe27fb3d917b5cdf505a351a1d18e9972f51b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d66ae04977566438b0192e94f45f12ff9b67af5a3579a248ef72d4242bb516ca.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"世見 たづね","creatorId":"vndb:s34452","sourcePersonId":"vndb:s34452","canonicalEntityId":"vndb:s34452","name":"世見たづね","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95033","source":"vndb"}]},{"characterId":"char_vndb_c131617","characterName":"千尋","sourceIds":{"vndbCharacterId":"c131617"},"originalCharacterName":"千尋","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":