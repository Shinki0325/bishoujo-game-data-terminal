{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18836","model":{"presentationWorkId":"vndb:v12336","staff":{"artwork":[{"creditedName":"源造","creatorId":"vndb:s5328","sourcePersonId":"egs:creator:15751","canonicalEntityId":"vndb:s5328","name":"源造","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:116597","source":"egs"}],"scenario":[{"creditedName":"ヤタベトシキ","creatorId":"vndb:s4861","sourcePersonId":"egs:creator:13613","canonicalEntityId":"vndb:s4861","name":"ヤタベトシキ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:116598","source":"egs"},{"creditedName":"えろっちつばめ21","creatorId":"vndb:s5329","sourcePersonId":"egs:creator:17389","canonicalEntityId":"vndb:s5329","name":"えろっちつばめ21","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:116912","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c25220","characterName":"本条 智華","sourceIds":{"bangumi":[{"characterId":"134136","match":"exact-normalized-name-in-linked-work","subjectId":"231691"}],"egsCharacterIds":["425"],"vndbCharacterId":"c25220"},"originalCharacterName":"本条 智華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公祐樹の年上の幼馴染。宮乃樹学園三年生。一人称は「私」。"},{"spoiler":false,"text":"容姿端麗成績優秀な上にプロポーションも抜群という完璧少女。"},{"spoiler":false,"text":"性格は真面目でやや気が強い。クラスの委員長を務めている。"},{"spoiler":false,"text":"性的なコトにはほぼ免疫が無い処女。"},{"spoiler":false,"text":"祐樹とは幼い頃（祐樹は忘れていたが）結婚の約束をしており、密かに彼をずっと想っていた。"},{"spoiler":false,"text":"その為、麗菜も昔祐樹に結婚を申し込まれていたと知ってショックを受け、売り言葉に買い言葉で彼を巡り泡姫プレイを競い合う様になってしまう。"},{"spoiler":false,"text":"エロいプレイの知識は主にネットで検索して知る程度だが、持ち前の真面目さとスタイルの良さを生かし、不慣れながら恥じらいつつ懸命に祐樹に奉仕する。"}],"source":"egs","sourceCharacterId":"425","sourceWorkId":"18836","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・祐樹の年上の幼なじみ。 宮乃樹学園三年生。"},{"spoiler":false,"text":"容姿端麗・成績優秀なうえにプロポーションも抜群という完璧少女。"},{"spoiler":false,"text":"性格はまじめでやや気が強く、クラスの委員長を務めている。"},{"spoiler":false,"text":"性的なコトにはほぼ免疫が無い処女。"},{"spoiler":false,"text":"祐樹とは幼い頃に結婚の約束をしており、密かに彼をずっと想っていた。"},{"spoiler":false,"text":"そのため、麗菜も祐樹に結婚を申し込まれていたと知ってショックを受け、彼を巡って競い合うようになってしまう。"},{"spoiler":false,"text":"エロいプレイの知識は主にネットから得た程度だが、持ち前のまじめさとスタイルの良さを活かし、不慣れながら恥じらいつつ懸命に祐樹に奉仕する。"}],"source":"bangumi","sourceCharacterId":"134136"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96dcabdd64eaee8d1bf95db6814add29a0cad5660aed530eb2b154fdb045c90b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1c1c707fb44577eddb4e72e15fd195cfa76ce753c22f995bf07a19c75f2e4d2.webp","width":106,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c25221","characterName":"宮乃樹 麗菜","sourceIds":{"bangumi":[{"characterId":"134137","match":"exact-normalized-name-in-linked-work","subjectId":"231691"}],"egsCharacterIds":["426"],"vndbCharacterId":"c25221"},"originalCharacterName":"宮乃樹 麗菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"祐樹より年下の一年生。一人称は「私」。"},{"spoiler":false,"text":"学園理事長を母に持つ生粋のお嬢様。"},{"spoiler":false,"text":"かなり小柄なので、年齢以上に幼く見える。"},{"spoiler":false,"text":"もっともバストは身長の割りにはそこそこ膨らんでいる。"},{"spoiler":false,"text":"性格はワガママでかなり世間知らず。処女。"},{"spoiler":false,"text":"幼い頃祐樹に偶然出会い、智華同様に結婚を約束していたらしく、一方的に祐樹を旦那様と慕っている。"},{"spoiler":false,"text":"何の冗談か、母親から「良き妻になる為の極意」として色々なソーププレイを伝授されており、実戦経験は皆無ながら様々なテクニックを駆使して祐樹に奉仕しまくる。"}],"source":"egs","sourceCharacterId":"426","sourceWorkId":"18836","spoiler":false},{"segments":[{"spoiler":false,"text":"祐樹より年下の一年生。 学園理事長を母に持つ生粋のお嬢様。"},{"spoiler":false,"text":"かなり小柄なので、年齢以上に幼く見える。"},{"spoiler":false,"text":"性格はワガママでかなり世間知らず。 処女。"},{"spoiler":false,"text":"幼い頃、祐樹に偶然出会い智華同様に結婚を約束していたらしく、一方的に祐樹を旦那様と慕っている。"},{"spoiler":false,"text":"なんの冗談か、母親から “良き妻になるための極意” として様々なソーププレイを伝授されており、実戦経験は皆無ながら多彩なテクニックを駆使して祐樹に奉仕しまくる。"}],"source":"bangumi","sourceCharacterId":"134137"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b36b55dc5557a6609196bc22400d222431ee070f9ebf5f1007542a45ffc1040.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55cbeeb24b507b37c778d1e4a824d72c88d4f7a3272e8527329aaab24c57c6dd.webp","width":92,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3032","sourceCompanyId":"egs:brand:3726","canonicalEntityId":"vndb:p3032","name":"イノヘッドスタジオ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18836:3726","source":"egs"},{"companyId":"vndb:p3032","sourceCompanyId":"vndb:p3032","canonicalEntityId":"vndb:p3032","name":"イノヘッドスタジオ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30551:v12336","source":"vndb"},{"companyId":"vndb:p3032","sourceCompanyId":"vndb:p3032","canonicalEntityId":"vndb:p3032","name":"イノヘッドスタジオ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:31264:v12336","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
