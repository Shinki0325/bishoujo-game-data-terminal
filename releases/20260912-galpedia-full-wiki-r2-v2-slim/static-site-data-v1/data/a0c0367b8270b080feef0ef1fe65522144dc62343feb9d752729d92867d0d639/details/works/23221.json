:vn-staff:129235","source":"vndb"}]},"cast":[{"characterId":"char_c32040","characterName":"ジルコニア＝シルヴァトーレ","sourceIds":{"bangumi":[{"characterId":"33525","match":"exact-normalized-name-in-linked-work","subjectId":"120283"}],"egsCharacterIds":["6703"],"vndbCharacterId":"c32040"},"originalCharacterName":"ジルコニア＝シルヴァトーレ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異世界からやってきた、長い耳が特徴的なハイエルフの女の子。"},{"spoiler":false,"text":"人間よりも長寿な種族のため、実際の年齢は１００歳を超えるがあくまで女の子。特殊な事情で出会った幼い相馬を、本当の弟のように可愛がってくれた。そして今でも１から１０までお世話をしようとしてくれるあまあまなお姉ちゃん。"},{"spoiler":false,"text":"とはいえ弟として可愛がりつつも、相馬から女性として扱われることに喜びを感じ、自身も相馬を頼れる男性として見ている部分もある。そのため母性を象徴する大きな胸を武器に、隙あらばすり寄って可愛さアピールをしてくる。それでも間違ったことは間違っているときちんと叱ってくれるため、相馬にとっては精神的にも信頼できるお姉ちゃんとして心から慕っている存在。"},{"spoiler":false,"text":"実は今の相馬は彼女の理想の男性像なのか。光源氏計画は絶賛進行中！？"}],"source":"egs","sourceCharacterId":"6703","sourceWorkId":"21371","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界からやってきた、長い耳が特徴的なハイエルフの女の子。"},{"spoiler":false,"text":"人間よりも長寿なため実際の年齢は100歳を超えるが、あくまで女の子。"},{"spoiler":false,"text":"特殊な事情で出会った幼い相馬を、本当の弟のように可愛がってくれた。"},{"spoiler":false,"text":"そして今でも 1から10までお世話をしようとしてくれる、あまあまなお姉ちゃん。"},{"spoiler":false,"text":"弟として可愛がりつつも、女性として扱われると喜びを感じ、相馬を頼れる男性としても見ている。"},{"spoiler":false,"text":"そのため母性を象徴する大きな胸を武器に、隙あらばすり寄って可愛さアピールをしてくる。"},{"spoiler":false,"text":"それでも叱る時はきちんと叱ってくれるため、相馬は心から信頼し慕っている。"},{"spoiler":false,"text":"実は今の相馬は彼女の理想の男性像。 光源氏計画は絶賛進行中 !?"},{"spoiler":false,"text":"「いーの、弟くんのお世話をするのがお姉ちゃんの楽しみなんだから♪」"}],"source":"bangumi","sourceCharacterId":"33525"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"33525","value":"オレンジジュース、野菜（草食系）"},{"label":"特技","source":"bangumi","sourceCharacterId":"33525","value":"魔法薬の調合"},{"label":"趣味","source":"bangumi","sourceCharacterId":"33525","value":"ガーデニング、生け花、温泉の素集め"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c86cd1b923123087dfaaf0239234bb704bff30ce216b22faf18a2dd32238775b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72f4b1c903a30b6e6e48546cc5d934dde6cc1c523ae0534a00f5e142da232147.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上田 朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68828","source":"vndb"}]},{"characterId":"char_c47284","characterName":"獅堂 相馬","sourceIds":{"bangumi":[{"characterId":"33530","match":"exact-normalized-name-in-linked-work","subjectId":"120283"}],"egsCharacterIds":["6708"],"vndbCharacterId":"c47284"},"originalCharacterName":"獅堂 相馬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人間界とつながったもう一方の世界で、長期間暮らしていた経験を持つ唯一の人間。"},{"spoiler":false,"text":"自身の置かれた境遇に不安を抱えていた際、異世界人たちが親身になって解決してくれたことで、逆の立場となった現在では自分が人間界にやってきた異世界人の支えになろうと考えている。"},{"spoiler":false,"text":"特に対話によるコミュニケーションを大切にし、相手の感情を察してさりげなくフォローを入れるところもあれば、あえて前に出て力強く周囲を引っ張っていくこともあり、状況に応じてベストな解決へと導いていく。"},{"spoiler":false,"text":"そんな話しかけやすい空気を作っているため、会話の中心立つことも多く、周囲からは男女問わず頼りにされる。"},{"spoiler":false,"text":"人間界の勉強はほとんど受けてこなかったため学力は壊滅的で、日常生活に支障をきたすほど常識が通用しなかった。とはいえ、知らない知識を得る事を純粋に楽しむことができたので、２年ほどでごく普通に生活できるくらいにまでこちらの社会に適応している。ただし分数の足し算と割り算はいまだにたまに間違えることがある。"},{"spoiler":false,"text":"また常識を学ぶ際、マンガや小説を参考書としていたこともあり、マンガの主人公のキザな振る舞いかっこいいと考える痛い一面を持つ。"},{"spoiler":false,"text":"しかしそれに疑問を持つこともなく自然と実行している節があり、気づいたら本当に女子から好意を寄せられることも。"}],"source":"egs","sourceCharacterId":"6708","sourceWorkId":"21371","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界で長期間暮らしていた経験を持つ唯一の人間。"},{"spoiler":false,"text":"自身の境遇に不安を抱えていた時、異世界人たちが親身になって解決してくれたので、"},{"spoiler":false,"text":"逆の立場となった現在は自分が人間界にやってきた異世界人の支えになろうと考えている。"},{"spoiler":false,"text":"話し掛けやすい空気を作っているため会話の中心に立つことが多く、周囲からは男女問わず頼りにされる。"},{"spoiler":false,"text":"人間界の勉強はほとんど受けられなかったため学力は壊滅的で、日常生活に支障をきたすほど。"},{"spoiler":false,"text":"とはいえ、純粋に楽しみながら知識を吸収し、2年ほどで普通に生活できるまでになった。"},{"spoiler":false,"text":"ただし分数の足し算と割り算は未だにたまに間違えることがある。"},{"spoiler":false,"text":"また常識をマンガや小説で学んだので、キザな振る舞いをカッコいいと考える痛い一面を持つ。"},{"spoiler":false,"text":"しかしそれを自然と実行するためか、気づいたら本当に女子から好意を寄せられることも。"}],"source":"bangumi","sourceCharacterId":"33530"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:509","sourceCompanyId":"egs:brand:509","canonicalEntityId":"egs:brand:509","name":"HOOKSOFT(HOOK)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:23221:509","source":"egs"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:150859:v19088","source":"vndb"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51968:v19088","source":"vndb"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:56715:v19088","source":"vndb"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:80255:v19088","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
