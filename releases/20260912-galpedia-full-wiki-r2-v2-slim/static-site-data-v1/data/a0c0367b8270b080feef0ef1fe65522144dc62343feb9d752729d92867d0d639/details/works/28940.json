terId":"char_c87638","characterName":"サルテ","sourceIds":{"bangumi":[{"characterId":"76528","match":"exact-normalized-name-in-linked-work","subjectId":"295083"}],"egsCharacterIds":["22073"],"vndbCharacterId":"c87638"},"originalCharacterName":"サルテ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The star of this performance, known far and wide as the finest actress in Mersin's national theatre troupe."},{"spoiler":false,"text":"Clever and competent, she has always balanced her stage work and her royal duties with skill."},{"spoiler":false,"text":"Now she relives her time as Mersin's crown princess while searching for the reason for her death on Kloun's phantasmagoric stage."}],"source":"vndb","sourceCharacterId":"c87638"},{"segments":[{"spoiler":false,"text":"本公演の主演女優。"},{"spoiler":false,"text":"メルシン国営の劇団に所属しており、その演技力は他国にまで知られている看板女優。"},{"spoiler":false,"text":"頭も要領も良く、演劇も王女の役割も上手く両立している。"},{"spoiler":false,"text":"メルシン国の王女としての生を辿りながら、クルーンが仕切る幻想舞台の上で『自身が死んだ理由』を探す。"}],"source":"egs","sourceCharacterId":"22073","sourceWorkId":"28940","spoiler":false},{"segments":[{"spoiler":false,"text":"本公演の主演女優。"},{"spoiler":false,"text":"メルシン国営の劇団に所属しており、"},{"spoiler":false,"text":"その演技力は他国にまで知られている看板女優。"},{"spoiler":false,"text":"頭も要領も良く、"},{"spoiler":false,"text":"演劇も王女の役割も上手く両立している。"},{"spoiler":false,"text":"メルシン国の王女としての生を辿りながら、"},{"spoiler":false,"text":"クルーンが仕切る幻想舞台の上で"},{"spoiler":false,"text":"『自身が死んだ理由』を探す。"},{"spoiler":false,"text":"「どんな稚拙な脚本だとしても、私が最高の舞台にしてあげるわ」"}],"source":"bangumi","sourceCharacterId":"76528"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd07151fbb58b34316edd953949d687862f1ba442d0116d499d039e1590e71be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed414aa1c32905de9898652a3b05760637b1c7c7a5384f26e5866f162ce1368f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295083:76528:6359:1","source":"bangumi"}]},{"characterId":"char_c87639","characterName":"マリー","sourceIds":{"bangumi":[{"characterId":"76529","match":"exact-normalized-name-in-linked-work","subjectId":"295083"}],"egsCharacterIds":["22074"],"vndbCharacterId":"c87639"},"originalCharacterName":"マリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A kind-hearted nun, Salthe's childhood friend."},{"spoiler":false,"text":"Lives alone in a church outside town, where she cares for children who have lost their parents. The orphanage's finances are dire, but she keeps a cheerful smile while making ends meet. Salthe has been helping her look for adoptive parents for the orphans. She'll never back down once her mind is made up."}],"source":"vndb","sourceCharacterId":"c87639"},{"segments":[{"spoiler":false,"text":"サルテの幼馴染の心優しきシスター。"},{"spoiler":false,"text":"街外れの教会に住み女手ひとつで孤児らの面倒を見ている。"},{"spoiler":false,"text":"孤児院の生計は苦しいが、孤児らを放っておけず生活を切り詰め、子どもたちと共に明るく暮らしている。"},{"spoiler":false,"text":"思い込みが激しく、こうと決めたら譲らない。"},{"spoiler":false,"text":"サルテと共に子どもたちの里親を探している。"}],"source":"egs","sourceCharacterId":"22074","sourceWorkId":"28940","spoiler":false},{"segments":[{"spoiler":false,"text":"サルテの幼馴染の心優しきシスター。"},{"spoiler":false,"text":"街外れの教会に住み女手ひとつで孤児らの面倒を見ている。"},{"spoiler":false,"text":"孤児院の生計は苦しいが、孤児らを放っておけず生活を切り詰め、"},{"spoiler":false,"text":"子どもたちと共に明るく暮らしている。"},{"spoiler":false,"text":"思い込みが激しく、こうと決めたら譲らない。"},{"spoiler":false,"text":"サルテと共に子どもたちの里親を探している。"},{"spoiler":false,"text":"「わたしのことを『おねえちゃん』って言って甘えてた頃が懐かしいよ～」"}],"source":"bangumi","sourceCharacterId":"76529"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/976d6564979d953d0f0ee0f2c3a45f75ec3cc459e6cc8dd8dc4b8d10d58c5155.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fe407a18bee1afdc83f40d99da604112383522f665331d5e77483dcbdc11158.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林桂子","creatorId":"vndb:s443","sourcePersonId":"vndb:s443","canonicalEntityId":"vndb:s443","name":"美月(声優)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295083:76529:16180:1","source":"bangumi"}]},{"characterId":"char_c87640","characterName":"クルーン","sourceIds":{"bangumi":[{"characterId":"76530","match":"exact-normalized-name-in-linked-work","subjectId":"295083"}],"egsCharacterIds":["22075"],"vndbCharacterId":"c87640"},"originalCharacterName":"クルーン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"egs","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An enigmatic jester who grants Salthe a chance to return to life from the liminal stage. Professes to be Salthe's friend, but never drops a theatrical facade."}],"source":"vndb","sourceCharacterId":"c87640"},{"segments":[{"spoiler":false,"text":"正体不明の道化師。"},{"spoiler":false,"text":"死後の世界でサルテに生き返るチャンスを与える。"},{"spoiler":false,"text":"自身をサルテの味方と称し、常に芝居がかった口調と仕草で話す。"}],"source":"egs","sourceCharacterId":"22075","sourceWorkId":"28940","spoiler":false},{"segments":[{"spoiler":false,"text":"正体不明の道化師。"},{"spoiler":false,"text":"死後の世界でサルテに生き返るチャンスを与える。"},{"spoiler":false,"text":"自身をサルテの味方と称し、"},{"spoiler":false,"text":"常に芝居がかった口調と仕草で話す。"},{"spoiler":false,"text":"「さぁ、キミの人生をボクらに見せてごらん？」"}],"source":"bangumi","sourceCharacterId":"76530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/230393e8b8f1374c5aee540e08fcdb68c6cddb425c1c970539ebb139bf0c44f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bfe70c7459592485ce1e9795e27b7e652484cc3227c4a8030e0556f3760306a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田紗記子","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295083:76530:17079:1","source":"bangumi"}]},{"characterId":"char_c87642","characterName":"ジャン","sourceIds":{"bangumi":[{"characterId":"76531","match":"exact-normalized-name-in-linked-work","subjectId":"295083"}],"egsCharacterIds":["22076"],"vndbCharacterId":"c87642"},"originalCharacterName":"ジャン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young leader of Mersin's Royal Guard."},{"spoiler":false,"text":"He is involved in a romantic and sexual relationship with Princess Salthe, to whom he promises a future together."},{"spoiler":false,"text":"His serious, disciplined and hard-working personality is admired by his subordinates."},{"spoiler":false,"text":"He is also Mersin's best swordsman."}],"source":"vndb","sourceCharacterId":"c87642"},{"segments":[{"spoiler":false,"text":"メルシン国の若き近衛騎士長。"},{"spoiler":false,"text":"王女と将来を約束している恋仲で肉体関係もある。"},{"spoiler":false,"text":"真面目で規律を重んじる堅物な性格だが、それ故に部下の兵士たちからは慕われている。"},{"spoiler":false,"text":"剣の腕はメルシン国でも随一。"}],"source":"egs","sourceCharacterId":"22076","sourceWorkId":"28940","spoiler":false},{"segments":[{"spoiler":false,"text":"メルシン国の若き近衛騎士長。"},{"spoiler":false,"text":"王女と将来を約束している恋仲で肉体関係もある。"},{"spoiler":false,"text":"真面目で規律を重んじる堅物な性格だが、"},{"spoiler":false,"text":"それ故に部下の兵士たちからは慕われている。"},{"spoiler":false,"text":"剣の腕はメルシン国でも随一。"},{"spoiler":false,"text":"「約束は守る、絶対に。この剣に誓って」"}],"source":"bangumi","sourceCharacterId":"76531"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d80122e6c6c72907dea441691fa178cbef87b2b24ab6c14f0fe602bd9104325e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d408dd7f90e94974e95f1c6b18346a0f75dc75b4b1ca6b7f76e4b69e5d2c7d55.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"バレッタ裕","creatorId":"vndb:s12561","sourcePersonId":"vndb:s12561","canonicalEntityId":"vndb:s12561","name":"バレッタ 裕","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295083:76531:22527:1","source":"bangumi"}]},{"characterId":"char_c87643","characterName":"ガルニエ","sourceIds":{"bangumi":[{"characterId":"76532","match":"exact-normalized-name-in-linked-work","subjectId":"295083"}],"egsCharacterIds":["22077"],"vndbCharacterId":"c87643"},"originalCharacterName":"ガルニエ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The cool and collected prime minister of Mersin."},{"spoiler":false,"text":"He rose to prominence from an ordinary background and won himself a role in national politics through his competence."},{"spoiler":false,"text":"Unmarried but very fond of women, he often brings them into his chambers. He gets along poorly with the princess, though, and the two are frequently at odds."}],"source":"vndb","sourceCharacterId":"c87643"},{"segments":[{"spoiler":false,"text":"メルシン国の冷徹な宰相。"},{"spoiler":false,"text":"平民の出ながらその手腕を買われ、宰相として国の政治に食い込むほどのやり手。"},{"spoiler":false,"text":"妻は取らぬが女好きで、よく自室に女を連れ込んでいる。"},{"spoiler":false,"text":"王女とは反りが合わず常に対立している。"}],"source":"egs","sourceCharacterId":"22077","sourceWorkId":"28940","spoiler":false},{"segments":[{"spoiler":false,"text":"メルシン国の冷徹な宰相。"},{"spoiler":false,"text":"平民の出ながらその手腕を買われ、"},{"spoiler":false,"text":"宰相として国の政治に食い込むほどのやり手。"},{"spoiler":false,"text":"妻は取らぬが女好きで、"},{"spoiler":false,"text":"よく自室に女を連れ込んでいる。"},{"spoiler":false,"text":"王女とは反りが合わず常に対立している。"},{"spoiler":false,"text":"「そんなものは非現実主義者どもの詭弁。こんな雑草に価値などありませんよ」"}],"source":"bangumi","sourceCharacterId":"76532"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c75e50246370f7b2d12285988fec06463692c5b9715ac04a5b8df8e6812afe4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78d22c350bfcea2fc7f6eb49f2ab63eb3ca0e54d766f8f768cfafd641390c758.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"景浦大輔","creatorId":"vndb:s837","sourcePersonId":"vndb:s837","canonicalEntityId":"vndb:s837","name":"景浦 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295083:76532:4936:1","source":"bangumi"}]},{"characterId":"char_vndb_c127946","characterName":"Salome","sourceIds":{"vndbCharacterId":"c127946"},"originalCharacterName":"Salome","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The true Mersin's Princess, she looks exactly like Salthe. She both morally and sexually harasses Salthe."}],"source":"vndb","sourceCharacterId":"c127946"}],"profileFacts":[],"metadataCan