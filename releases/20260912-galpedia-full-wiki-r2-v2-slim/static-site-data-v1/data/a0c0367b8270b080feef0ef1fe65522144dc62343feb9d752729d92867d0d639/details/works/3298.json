ve","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8ddec66044c26b442ae7db7f03358af6fa8c6ec207c2b9457a52adccf93b307.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0937b56d13597d5239bfc888b869934ac818db7f1e9066986d805ba13f678f96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緒田 マリ","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35572","source":"vndb"}]},{"characterId":"char_vndb_c19785","characterName":"趙柏芝","sourceIds":{"vndbCharacterId":"c19785"},"originalCharacterName":"趙柏芝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student from China and a classmate of the protagonist and Mutsumi. She is Mutsumi's best friend."},{"spoiler":false,"text":"She's not exactly shy, but she's the type who's reserved around strangers."},{"spoiler":false,"text":"Before becoming friends with Mutsumi, she lived lonely days, unfamiliar with both Japan and the school."},{"spoiler":false,"text":"Because of her dignified expression, well-defined features, and magnificent body line, she's quite popular with boys, but perhaps because of her demeanor, it's difficult for them to approach her."},{"spoiler":false,"text":"The only guy she can talk to casually is the protagonist."},{"spoiler":false,"text":"She is a member of the rhythmic gymnastics club and was once in an acrobatics troupe, and she is proud of her flexibility."},{"spoiler":false,"text":"She can handle any seductive style."},{"spoiler":false,"text":"At heart, she is a serious person, always taking everything with utmost sincerity. Contrary to her cool appearance, she actively participates in even the most intense sex training sessions."},{"spoiler":false,"text":"Aiming to master acrobatic and glamorous dances that make the most of her body's flexibility!?"},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c19785"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7dfe2adf719433c182bca5f0ef536fa3d7cf101374fe04b3dda5f0fb87a8d47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15d9267f371d446b122ed174c27f0f2ef6a047a907c8eda2b5db434e1af888ef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉 さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35570","source":"vndb"}]},{"characterId":"char_vndb_c19786","characterName":"ジュディ・エリスン","sourceIds":{"vndbCharacterId":"c19786"},"originalCharacterName":"ジュディ・エリスン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/409cb17b63965c121b6013cb6026bf75bb2c42f22762cb09664208314da9e1ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7e7a9b372beebf7409171c88bbf8764d2492d181fd4507c8fd3e866af72b3a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 まひる","creatorId":"vndb:s485","sourcePersonId":"vndb:s4