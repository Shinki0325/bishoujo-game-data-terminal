{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22979","model":{"presentationWorkId":"vndb:v19065","staff":{"artwork":[{"creditedName":"薦田ロボ(蜜図帆こも、こもだ)","creatorId":"vndb:s2947","sourcePersonId":"egs:creator:14267","canonicalEntityId":"vndb:s2947","name":"薦田ロボ(蜜図帆こも、こもだ)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:160438","source":"egs"}],"scenario":[{"creditedName":"サブマリン","creatorId":"vndb:s5418","sourcePersonId":"egs:creator:22922","canonicalEntityId":"vndb:s5418","name":"サブマリン","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:160439","source":"egs"}],"music":[{"creditedName":"景家 淳","creatorId":"vndb:s1061","sourcePersonId":"vndb:s1061","canonicalEntityId":"vndb:s1061","name":"景家 淳","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:129033","source":"vndb"}],"other":[{"creditedName":"まりなりな(大野まりな)","creatorId":"vndb:s1253","sourcePersonId":"egs:creator:6055","canonicalEntityId":"vndb:s1253","name":"まりなりな(大野まりな)","detail":"主題歌「ごめんなさいが終わらない」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:162324","source":"egs"},{"creditedName":"大野 まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:129034","source":"vndb"}]},"cast":[{"characterId":"char_c68934","characterName":"アクリルブルー","sourceIds":{"bangumi":[{"characterId":"218961","match":"exact-normalized-name-in-linked-work","subjectId":"217812"}],"egsCharacterIds":["8473"],"vndbCharacterId":"c68934"},"originalCharacterName":"アクリルブルー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Serena is a composed senior and an elite magical girl who has slaughtered thousands of monsters and combatants in the past. She is kind enough to try to defend the townspeople and shows no mercy to those trying to disrupt the peace. She is feeling pressure from excessive hopes by her parents, who are leaders of the organization for justice. By the way, her favorite dish is gyouza."},{"spoiler":false,"text":"\"Evil does not reach justice; science too, does not reach magic.\""},{"spoiler":false,"text":"Translated from DLsite"}],"source":"vndb","sourceCharacterId":"c68934"},{"segments":[{"spoiler":false,"text":"今まで、幾千もの怪人・戦闘員を屠ってきたエリート魔法少女。"},{"spoiler":false,"text":"年長者で、落ち着いた雰囲気を持っている。"},{"spoiler":false,"text":"市民を守ろうとする優しさを持ち、平和を仇なすものに容赦しない。"},{"spoiler":false,"text":"両親とも正義の組織の幹部であり、親からの過度な期待にはプレッシャーを感じている。"},{"spoiler":false,"text":"好物は餃子。"}],"source":"egs","sourceCharacterId":"8473","sourceWorkId":"22979","spoiler":false},{"segments":[{"spoiler":false,"text":"今まで、幾千もの怪人・戦闘員を屠ってきたエリート魔法少女。"},{"spoiler":false,"text":"年長者で、落ち着いた雰囲気を持っている。"},{"spoiler":false,"text":"市民を守ろうとする優しさを持ち、平和を仇なすものに容赦しない。"},{"spoiler":false,"text":"両親とも正義の組織の幹部であり、親からの過度な期待にはプレッシャーを感じている。"},{"spoiler":false,"text":"好物は餃子。"},{"spoiler":false,"text":"「悪は正義に届かない、科学も魔法には届きません」"}],"source":"bangumi","sourceCharacterId":"218961"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6b0d0ad3aa734644e01b346a7ee3edb92bebb2b6e994928bcd9b9b19b37f584.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efb103301c4260e66328cf0bc2a0625c523ad7ea9d18cf99bf8f2a103ea104a9.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217812:218961:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68789","source":"vndb"}]},{"characterId":"char_c68935","characterName":"アクリルレッド","sourceIds":{"bangumi":[{"characterId":"218962","match":"exact-normalized-name-in-linked-work","subjectId":"217812"}],"egsCharacterIds":["8474"],"vndbCharacterId":"c68935"},"originalCharacterName":"アクリルレッド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A magical girl with little real combat experience yet, who retains some childishness. Precisely because she is an extraordinary being, she burns with a sense of duty to defend the townspeople and fight evil. She is somewhat cocky but generally performs outstandishly, and great results are expected from her in the future. By the way, she likes seniors and prefers grumpy old men."},{"spoiler":false,"text":"\"Because I am a magical girl\"."},{"spoiler":false,"text":"Translated from DLsite"}],"source":"vndb","sourceCharacterId":"c68935"},{"segments":[{"spoiler":false,"text":"まだ実戦経験が浅く、少し幼さが残る魔法少女。"},{"spoiler":false,"text":"特別な存在だからこそ、市民を守り悪と戦うという使命感に燃えている。"},{"spoiler":false,"text":"生意気な部分もあるが概ね優秀で、今後の活躍を期待されている。"},{"spoiler":false,"text":"一人称は “ボク”。 年上好きで、渋めのおじさんが好み。"}],"source":"egs","sourceCharacterId":"8474","sourceWorkId":"22979","spoiler":false},{"segments":[{"spoiler":false,"text":"まだ実戦経験が浅く、少し幼さが残る魔法少女。"},{"spoiler":false,"text":"特別な存在だからこそ、市民を守り悪と戦うという使命感に燃えている。"},{"spoiler":false,"text":"生意気な部分もあるが概ね優秀で、今後の活躍を期待されている。"},{"spoiler":false,"text":"一人称は “ボク”。 年上好きで、渋めのおじさんが好み。"},{"spoiler":false,"text":"「だって、ボク、魔法少女だからね」"}],"source":"bangumi","sourceCharacterId":"218962"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00a2b82257da0af95a3ac5c34ab94e1d1360285a6262b9d4e29021928d7cefa2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0ca921c66ebcc4a57c71802f31e471e8a0f98cff7b6f3de0e385c0c0cfbff58c.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217812:218962:4434:1","source":"bangumi"}]},{"characterId":"char_vndb_c101156","characterName":"平井源蔵","sourceIds":{"vndbCharacterId":"c101156"},"originalCharacterName":"平井源蔵","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A scientist, working as the leader of the science and research group of an evil society. He is clever, hot-tempered, and, so to say, sharp in both senses. His division was destroyed by magical girls. Although they brought him to the brink of death, he has been resurrected as a monster. In order to get revenge, he plans to make magical girls genuflect naked and, by doing so, to get them to ultimately surrender."},{"spoiler":false,"text":"\"I shall force them to genuflect before us fully naked!!\""},{"spoiler":false,"text":"Translated from DLsite"}],"source":"vndb","sourceCharacterId":"c101156"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p384","sourceCompanyId":"egs:brand:1869","canonicalEntityId":"vndb:p384","name":"HEAT-SOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22979:1869","source":"egs"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51867:v19065","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51868:v19065","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:65167:v19065","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
