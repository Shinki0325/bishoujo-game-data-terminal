ts":[{"spoiler":false,"text":"A teacher at The Oriens Academy. The subjects he teaches are unknown. A very mellow, kind and gentle teacher. He is friendly to everyone, but is particularly affectionate towards women. He is also very popular with the female students and the women in the town. However, he is very different whenever he is on or off the clock, and is frequently seen lying down in the academy’s garden looking sluggish and motionless."},{"spoiler":false,"text":"‘Saving money is a virtue. I am very fond of it…’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c121018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98c6803279b69f3559a876081994d3ea299c1cc223440848bc6120d1d5ce8975.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f191f67615c15d9d0541402a71d02bdf6a1b4466a02ce769910da39b05d6e81c.webp","width":204,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野 友樹","creatorId":"vndb:s42","sourcePersonId":"vndb:s42","canonicalEntityId":"vndb:s42","name":"小野 友樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84595","source":"vndb"}]},{"characterId":"char_vndb_c154807","characterName":"カルドゥエーリス・エリコ・ホレグ","sourceIds":{"vndbCharacterId":"c154807"},"originalCharacterName":"カルドゥエーリス・エリコ・ホレグ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bef611ea65b8af3983c955789f074a9d58d0e6c2e1986ef88f22f159dfe2861.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18e0a761299