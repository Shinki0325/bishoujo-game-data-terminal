s":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc24f15e44600939c9860b3e4964c184da2f52537590cafaeff7b0d3a5f087f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31fd773f3d0affa9759b4b1b95e000cb996d3627061deb50dcf37408633cc82c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渡部 康大","creatorId":"vndb:s26571","sourcePersonId":"vndb:s26571","canonicalEntityId":"vndb:s26571","name":"渡部 康大","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84604","source":"vndb"}]},{"characterId":"char_vndb_c154814","characterName":"ビルシャ・シディム・スターニス","sourceIds":{"vndbCharacterId":"c154814"},"originalCharacterName":"ビルシャ・シディム・スターニス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/584c6b5fef406619d0281c43be8b4b813b20e14effb2db5adfc15a00b47c9325.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/120898714a592990bb24dc5ce32ad0cd8f1b56d3e7902a2a1056fcd2f74cbacf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北山 恭祐","creatorId":"vndb:s5570","sourcePersonId":"vndb:s5570","canonicalEntityId":"vndb:s5570","name":"北山 恭祐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84600","source":"vndb"}]},{"characterId":"char_vndb_c154815","characterName":"リルモッド・エリコ・ミガッド","sourceIds":{"vndbCharacterId":"c154815"},"originalCharacterName":"リルモッド・エリコ・ミガッド","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/951ebe490ad93b89d05e4a0fdeccf85746bfc8cd9a16b722eb051a83dea7fca7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea59aaa6e0ae48724429c2e8972f866c56e8cf66d56cbb478d6de489f64193bf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡崎 雅紘","creatorId":"vndb:s35","sourcePersonId":"vndb:s35","canonicalEntityId":"vndb:s35","name":"岡崎 雅紘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84603","source":"vndb"}]},{"characterId":"char_vndb_c91132","characterName":"ガリカ・ローサ・スターニス","sourceIds":{"vndbCharacterId":"c91132"},"originalCharacterName":"ガリカ・ローサ・スターニス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of the Starnis family, famous in the world of magic. She is not very good at magic, though. Under the guidance of her outstanding older brother Fin, she is admitted to an elite magic academy, The Oriens Academy, but is shocked to find that she is now surrounded by students who are even more talented than she had ever imagined. So she tries her best to keep up with them. Her brother Fin dotes on her and she loves him very much too. She has a secret that she cannot tell anyone."},{"spoiler":false,"text":"‘That’s right, I cannot do anything else besides looking down.’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c91132"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01290ec3568ffc269b10fe65c3693d9638f9fc52110eb85451684ea45cb4f821.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a524888416e747038e486875ea60385f4bc6fd0db34325e36cfc01da3c71851.webp","width":204,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c91142","characterName":"グラン・エリコ・プレゼンス","sourceIds":{"vndbCharacterId":"c91142"},"originalCharacterName":"グラン・エリコ・プレゼンス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born into a family of honourable knights, who are responsible for the protection of the country, he aspires to follow in the footsteps of his respected father and become a knight himself. His magical skills at the academy are top class. A central figure for the academy thanks to his encouraging disposition and leadership skills. Although he is friendly and somewhat pushy, he is trusted by everyone, and many students even idolise him. He is a good friend of Fin."},{"spoiler":false,"text":"‘Let’s turn today into a good memory. Welcome to The Oriens Academy, Rika!’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c91142"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07409e1052cd831157d594c0981506e13ee0a16ea5e8c6ee0cb2fdcdb8ecdc97.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39eb798f0e1d4b328783e0ecb8b2fa4142e582e23e06f1f0354f78ed702974ec.webp","width":204,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山下 誠一郎","creatorId":"vndb:s4901","sourcePersonId":"vndb:s4901","canonicalEntityId":"vndb:s4901","name":"山下 誠一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84598","source":"vndb"}]},{"characterId":"char_vndb_c91144","characterName":"フィン・シディム・スターニス","sourceIds":{"vndbCharacterId":"c91144"},"originalCharacterName":"フィン・シディム・スターニス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The older brother of the protagonist. Eldest son of the Starnis family, a well-known and prominent family in the world of magic. His father was once a major figure in the world of magic and held an important position in parliament. Has outstanding magic skills, even among all the elite students of The Oriens Academy, and is able to use advanced magic without any difficulty. He is infatuated with his sister Rika and chases away any man who approaches her. He is a good friend of Gran."},{"spoiler":false,"text":"‘Whenever you are in trouble, I’ll be there to help you.’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c91144"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/900af149e5c9e98340e4ca95e2328725d3493eb3b661c5b201f082f1c94f3337.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac1204d11e08c17c8ccc8ff33211cc7bea3c6adabed96ea5799c1c8e5b0e43ab.webp","width":204,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斉藤 壮馬","creatorId":"vndb:s5499","sourcePersonId":"vndb:s5499","canonicalEntityId":"vndb:s5499","name":"斉藤 壮馬","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84599","source":"vndb"}]},{"characterId":"char_vndb_c91146","characterName":"ヴィクトル・エリコ・ミガット","sourceIds":{"vndbCharacterId":"c91146"},"originalCharacterName":"ヴィクトル・エリコ・ミガット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the most brilliant and well-mannered students in the academy, and also the head of the dormitory. A hardworking person who is never satisfied with the status quo and is always striving for improvement. Extremely strict both with himself and others and has no mercy for those who are lazy. Calm, cool-headed and intelligent, he is never moved by emotion. Part of a family of wizards specialised in white magic who saved the country in the past, and his father is a member of parliament. He abhors black magic."},{"spoiler":false,"text":"‘Please ask me for advice once you have actually made an effort. I hate people who don’t work hard, after all.’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c91146"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3ad9cf2013979d3a475c301745bbdd63fbb175997a02290aa01f48e43100dc0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be6765b76b35e4c95bdb45425b975bd621313f2ca4b108f5d487a33591d61a78.webp","width":204,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 拓也","creatorId":"vndb:s683","sourcePersonId":"vndb:s683","canonicalEntityId":"vndb:s683","name":"佐藤 拓也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84597","source":"vndb"}]},{"characterId":"char_vndb_c91147","characterName":"キャル・アイ・ミガット","sourceIds":{"vndbCharacterId":"c91147"},"originalCharacterName":"キャル・アイ・ミガット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student just like the protagonist. He is a quiet person who doesn’t talk with anyone and always spends time alone, away from everyone else. He lost his family when he was young and was taken in by the Migat family, so he and Victor are step brothers, but they rarely speak to each other. Advanced magic which lets you control spirit beasts is one of his strong points and he often plays with them. He may seem to have a small stature, but he is actually a glutton."},{"spoiler":false,"text":"‘I think you just need something to eat when you’re depressed.’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c91147"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ab2c0249616d0970507aaebc9c52ab896258cb6ec295e52da5096084ad6973e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7aebc08b66c8463fa80e2ab0d5e628cede5904c27f50be1924d2f016c740dad7.webp","width":204,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千葉 翔也","creatorId":"vndb:s11009","sourcePersonId":"vndb:s11009","canonicalEntityId":"vndb:s11009","name":"千葉 翔也","roleCode":"voice-actor","r