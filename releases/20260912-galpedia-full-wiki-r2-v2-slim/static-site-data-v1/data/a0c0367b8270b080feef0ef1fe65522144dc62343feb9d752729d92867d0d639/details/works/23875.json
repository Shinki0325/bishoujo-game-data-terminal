,"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05e1cc31fb5b477e75a6c9feafdb1975a83471880e70303f27159e0390e96fc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2463911f2d6d8d39030aed7cfea65d948d6b1633578fb60f9a65bd425e005175.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185619:43585:13368:1","source":"bangumi"}]},{"characterId":"char_c49308","characterName":"皆城 愛璃栖","sourceIds":{"bangumi":[{"characterId":"43586","match":"exact-normalized-name-in-linked-work","subjectId":"185619"}],"egsCharacterIds":["11766"],"vndbCharacterId":"c49308"},"originalCharacterName":"皆城 愛璃栖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"831"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"絵に硬いような真面目で超堅物な生徒会長。"},{"spoiler":false,"text":"自身の容姿には無頓着。主人公に『可愛い』と言われただけで、顔を真っ赤にして怒鳴るほど。"},{"spoiler":false,"text":"真面目でお堅い性格のせいで、融通が利かないところがあるが、生徒を思う気持ちは強い。"},{"spoiler":false,"text":"ゆうりとのＨ勝負に関しては、自身の処女を捧げてまで、身を挺する覚悟を持つほど。"},{"spoiler":false,"text":"恋愛に関しては奥手というよりも興味がない様子。"},{"spoiler":false,"text":"結婚に対しては親が決めた見合い結婚でいいとさえ思っている。"},{"spoiler":false,"text":"（※ゆうりは、それが嫌で、愛璃栖には恋愛をして欲しいと思っている。）"},{"spoiler":false,"text":"エッチに対しての忌避感はかなりのもので、相容れない主人公を常に『破廉恥』と罵倒し敵視する。"},{"spoiler":false,"text":"けど、主人公とのＨを通じて、隠れたマゾ資質を開花され、ゆうり以上のドＭな会長へと変貌を遂げていく。"}],"source":"egs","sourceCharacterId":"11766","sourceWorkId":"23875","spoiler":false},{"segments":[{"spoiler":false,"text":"学園を女子高に戻そうとしている生徒会長。"},{"spoiler":false,"text":"まじめで融通が利かないところもあるが、学生を思う気持ちは人一倍強い。"},{"spoiler":false,"text":"エッチに対する忌避感は強いが、ゆうりとのエッチ勝負では身を挺して処女を捧げる。"},{"spoiler":false,"text":"主人公を破廉恥と罵るが、「かわいい」 と言われるだけで真っ赤になってしまう。"},{"spoiler":false,"text":"恋愛には奥手というよりも、興味がない。 結婚もお見合いでいいと考えている。"},{"spoiler":false,"text":"（ゆうりはそれが嫌で、愛璃栖には恋愛をしてほしいと思っている。）"},{"spoiler":false,"text":"しかし主人公との行為でマゾ資質を開花され、ゆうり以上のドMに変貌していく。"},{"spoiler":false,"text":"「なんだお前か。 ん？　また女の子をスケベな目で見ていたのか？　呆れた奴だ」"}],"source":"bangumi","sourceCharacterId":"43586"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"11766","sourceWorkId":"23875","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"11766","sourceWorkId":"23875","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"11766","sourceWorkId":"23875","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11766","sourceWorkId":"23875","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"11766","sourceWorkId":"23875","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e35eaba119a14e6e24f4c6db77a0996e10fe58309344a7610badcf701432a1d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64a34cac2c11fa2d710aa8edee0bc9984f06a81e883ef9eb3165fa4978abec6d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水美紗","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185619:43586:21151:1","source":"bangumi"}]},{"characterId":"char_c49309","characterName":"衛藤 明日那","sourceIds":{"bangumi":[{"characterId":"43587","match":"exact-normalized-name-in-linked-work","subjectId":"185619"}],"egsCharacterIds":["11767"],"vndbCharacterId":"c49309"},"originalCharacterName":"衛藤 明日那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1224"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"愛璃栖に負けないぐらいに真面目で正義感の強いお嬢様。"},{"spoiler":false,"text":"少々お人よしで困ってる人を見るとついつい助けてあげたくなってしまう。"},{"spoiler":false,"text":"愛璃栖だけを犠牲にするのは嫌でＨ勝負に志願する。"},{"spoiler":false,"text":"主人公に対しては、会ったそうそう破廉恥な妄想人形劇の餌食にあい、打倒すべく闘志を燃やすほど毛嫌いしている。"},{"spoiler":false,"text":"恋愛に関しては多少興味がある様子。"},{"spoiler":false,"text":"エッチに対しては、覗きなどの破廉恥な行為を嫌う。"},{"spoiler":false,"text":"本人も知らないほど秘部感度は良く、濡れ体質なうえに、超潮吹き体質。"},{"spoiler":false,"text":"それを主人公に見抜かれ、ペニスや玩具で秘部を開発されていき、Ｈ大好きなエロデレお嬢様へと変貌を遂げていく。"}],"source":"egs","sourceCharacterId":"11767","sourceWorkId":"23875","spoiler":false},{"segments":[{"spoiler":false,"text":"お人好しで、困っている人を見ると放っておけないお嬢様。"},{"spoiler":false,"text":"愛璃栖だけを犠牲にするのが嫌でエッチ勝負に志願してしまう。"},{"spoiler":false,"text":"主人公には会った早々破廉恥な妄想人形劇の餌食に遭い、打倒すべく闘志を燃やす。"},{"spoiler":false,"text":"恋愛には多少興味があるものの、覗きなどの破廉恥な行為は嫌い。"},{"spoiler":false,"text":"実は秘部感度が良く、濡れ体質なうえに超潮吹き体質。"},{"spoiler":false,"text":"それを主人公に見抜かれ、開発されてエッチ大好きなエロデレお嬢様になってしまう。"},{"spoiler":false,"text":"「人を使って、エッチな妄想劇をするなーー!! このドスケベ!!」"}],"source":"bangumi","sourceCharacterId":"43587"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"11767","sourceWorkId":"23875","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"11767","sourceWorkId":"23875","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"11767","sourceWorkId":"23875","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"11767","sourceWorkId":"23875","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"11767","sourceWorkId":"23875","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/554c4366e8d8eef4a648cd5fefe6079b52a7ebabf0fdccb73222036b598ad20d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c5d4c57b6224df7606c64f6acbab0427efeb6471ab9aae0774fa48b832afd8b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八幡七味","creatorId":"vndb:s1988","sourcePersonId":"vndb:s1988","canonicalEntityId":"vndb:s1988","name":"八幡 七味","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185619:43587:21494:1","source":"bangumi"}]},{"characterId":"char_c49310","characterName":"井川 冬華","sourceIds":{"bangumi":[{"characterId":"43588","match":"exact-normalized-name-in-linked-work","subjectId":"185619"}],"egsCharacterIds":["11768"],"vndbCharacterId":"c49310"},"originalCharacterName":"井川 冬華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"603"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"普段から無表情で何を考えてるのか分からないお嬢様。"},{"spoiler":false,"text":"時々、擬音を口にする癖がある。（※『じー』とか）"},{"spoiler":false,"text":"得意技は、光速ビンタ。"},{"spoiler":false,"text":"主人公に対しては、会って早々胸を揉まれた経緯から、殺意が湧くほど毛嫌いしている。"},{"spoiler":false,"text":"それもあってかＨ勝負に参加する。"},{"spoiler":false,"text":"恋愛に関しては、これっぽちも興味がない様子。"},{"spoiler":false,"text":"エッチに対しては、恋愛と同じく興味もなく、やや毛嫌いしているとこがある。"},{"spoiler":false,"text":"羞恥とは無縁で、主人公とのエッチでも恥じらいを見せることがない。"},{"spoiler":false,"text":"恥ずかしがらせてやろうという主人公の思惑からお尻開発をされていってしまう。"},{"spoiler":false,"text":"当初は、お尻を開発されても恥ずかしがらなかったものの、エッチを通じて彼のことを知っていくうちに恋慕の気持ちを抱き始めると、極度に羞恥心を見せるようになる。"}],"source":"egs","sourceCharacterId":"11768","sourceWorkId":"23875","spoiler":false},{"segments":[{"spoiler":false,"text":"クールで少し変わり者なお嬢様。 時々擬音を口にする癖がある。"},{"spoiler":false,"text":"主人公には出会って早々胸を揉まれ、殺意が湧くほど毛嫌いしている。得意技は光速ビンタ。"},{"spoiler":false,"text":"恋愛にはこれっぽっちも興味がない様子。 エッチも好きではない。"},{"spoiler":false,"text":"敵愾心から参加したエッチ勝負では恥じらう姿を見せず、"},{"spoiler":false,"text":"そのため恥ずかしがらせたいと思った主人公にお尻開発をされてしまう。"},{"spoiler":false,"text":"そのうち主人公に恋慕の気持ちを抱き始めると、極度に羞恥心を見せるようになる。"},{"spoiler":false,"text":"「見事なスケベ面ですね。 まさに変態と呼ぶに相応しい顔をしています」"}],"source":"bangumi","sourc