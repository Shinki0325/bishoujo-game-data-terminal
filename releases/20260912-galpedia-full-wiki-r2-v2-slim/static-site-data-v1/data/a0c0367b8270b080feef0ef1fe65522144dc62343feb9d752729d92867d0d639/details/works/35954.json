gsCharacterIds":["23445"],"vndbCharacterId":"c94397"},"originalCharacterName":"レオナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"224"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cool but a bit of downer-type of person whose expressions have no ups and downs. She likes to talk and to make fun of Hilda."},{"spoiler":false,"text":"Leona was originally an honor student, but people's impression of her changed due to a certain event."},{"spoiler":false,"text":"She went to the same elementary school as Tyler and Hilda."},{"spoiler":false,"text":"Favorites: Chatting with Hilda, new sweets from convenience stores."}],"source":"vndb","sourceCharacterId":"c94397"},{"segments":[{"spoiler":false,"text":"感情の起伏が少なく、クールなダウナータイプ。"},{"spoiler":false,"text":"無口というわけではなく、おしゃべりは好き。"},{"spoiler":false,"text":"ヒルダをからかうのが趣味。"},{"spoiler":false,"text":"元々優等生だったが、とある経験から印象がかなり変わってしまった。"},{"spoiler":false,"text":"タイラ、ヒルダと同じ小学校出身。"}],"source":"egs","sourceCharacterId":"23445","sourceWorkId":"30345","spoiler":false},{"segments":[{"spoiler":false,"text":"兴致不高的冷淡类型。"},{"spoiler":false,"text":"但是，很喜欢说话。"},{"spoiler":false,"text":"原本是个优等生，但经历过某件事情之后，她给人的印象发生了大幅改变。"}],"source":"bangumi","sourceCharacterId":"88396"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b786c84ecf193754000917487a0f4ed663697b91cb237f7f7e66ee175859356c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51abdbd122333510aaaa4ec71e068f1f6a4873cfccac9e2327cd3c06ff06c1ba.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井澤詩織","creatorId":"vndb:s7962","sourcePersonId":"vndb:s7962","canonicalEntityId":"vndb:s7962","name":"井澤 詩織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:317672:88396:5642:1","source":"bangumi"}]},{"characterId":"char_c94398","characterName":"ミア","sourceIds":{"bangumi":[{"characterId":"88393","match":"exact-normalized-name-in-linked-work","subjectId":"317672"},{"characterId":"88393","match":"exact-normalized-name-in-linked-work","subjectId":"511943"}],"egsCharacterIds":["23442"],"vndbCharacterId":"c94398"},"originalCharacterName":"ミア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"402"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine."},{"spoiler":false,"text":"Mia has a vigilant cat-like face and rarely smiles."},{"spoiler":false,"text":"However, she deeply trusts the people she approves."},{"spoiler":false,"text":"A mysterious girl who doesn't talk about her past."},{"spoiler":false,"text":"Contrary to her childish appearance, she behaves in a mature manner. Has a personal view on pollock roe."},{"spoiler":false,"text":"Favorites: Collecting lip creams, pollock roe"}],"source":"vndb","sourceCharacterId":"c94398"},{"segments":[{"spoiler":false,"text":"警戒心の強い猫みたいな表情をしている。なかなか笑わない。"},{"spoiler":false,"text":"ただし、一度気を許した相手には全幅の信頼を寄せる。"},{"spoiler":false,"text":"あまり過去のことを語ろうとしないミステリアスな少女。"},{"spoiler":false,"text":"幼い見た目に反して、大人びた言動をとる。"},{"spoiler":false,"text":"明太子に一家言をもっている。"}],"source":"egs","sourceCharacterId":"23442","sourceWorkId":"30345","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的第一女主角，充满神秘感的少女。"},{"spoiler":false,"text":"与稚嫩的外表相反，有着成熟的言行举止。"}],"source":"bangumi","sourceCharacterId":"88393"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d32df6cfc2a61368c9bbf3de491e9725c1ad5cfbec348b872a41c66955004d73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53c20ddf5c1f116f843b8602cf0f93a38da3b5dea1799bbaec9105687be90921.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金子彩花","creatorId":"vndb:s22797","sourcePersonId":"vndb:s22797","canonicalEntityId":"vndb:s22797","name":"金子彩花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:317672:88393:21628:1","source":"bangumi"}]},{"characterId":"char_c94399","characterName":"ヒルダ","sourceIds":{"bangumi":[{"characterId":"88395","match":"exact-normalized-name-in-linked-work","subjectId":"317672"},{"characterId":"88395","match":"exact-normalized-name-in-linked-work","subjectId":"511943"}],"egsCharacterIds":["23444"],"vndbCharacterId":"c94399"},"originalCharacterName":"ヒルダ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"913"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seemingly a delinquent on the outside, she's actually an earnest, well-raised girl on the inside. Hilda is athletic, but on the contrary, she doesn't do really well at studying."},{"spoiler":false,"text":"Hilda is a straight-man type of heroine who headbutts people when reacting to their silly remarks. She's foolish on a different genre from Tyler. She's not very good at horror in general, and because of this Leona often makes fun of her by scaring her."},{"spoiler":false,"text":"She went to the same elementary school as Tyler and Leona."},{"spoiler":false,"text":"Favorites: Chatting with Leona, selfies"}],"source":"vndb","sourceCharacterId":"c94399"},{"segments":[{"spoiler":false,"text":"一見ガラが悪いが、根は真面目で育ちが良い。"},{"spoiler":false,"text":"身体を動かすのは得意だが、頭を使うのは苦手。"},{"spoiler":false,"text":"ツッコミに頭突きを食らわす、頭突き系ヒロイン。"},{"spoiler":false,"text":"タイラとは別ベクトルのアホな子。"},{"spoiler":false,"text":"ホラー全般が非常に苦手。いつもレオナにビビりだとからかわれている。"},{"spoiler":false,"text":"タイラ、レオナと同じ小学校出身。"}],"source":"egs","sourceCharacterId":"23444","sourceWorkId":"30345","spoiler":false},{"segments":[{"spoiler":false,"text":"对吐槽会以头槌攻击的头槌系女主角。"},{"spoiler":false,"text":"非常害怕恐怖系的东西。"},{"spoiler":false,"text":"经常被玲央奈嘲笑是胆小鬼。"}],"source":"bangumi","sourceCharacterId":"88395"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c7cc3ef33a35f4d8b19735c6974a70df0815c5c47abb02f7ed559c1d054f620.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c54bb15a0422bc5fdae5e5356f55207939f3f7e2f57e668e4417c27747e217b4.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河野ひより","creatorId":"vndb:s17127","sourcePersonId":"vndb:s17127","canonicalEntityId":"vndb:s17127","name":"河野ひより","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:317672:88395:31411:1","source":"bangumi"}]},{"characterId":"char_c94400","characterName":"タイラ","sourceIds":{"bangumi":[{"characterId":"88394","match":"exact-normalized-name-in-linked-work","subjectId":"317672"},{"characterId":"88394","match":"exact-normalized-name-in-linked-work","subjectId":"511943"}],"egsCharacterIds":["23443"],"vndbCharacterId":"c94400"},"originalCharacterName":"タイラ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"721"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tyler was a chubby child, but grown up into a handsome young man. Though, his personality stays a kid: foolish, passionate, and simple. Also energetic."},{"spoiler":false,"text":"He always come in ready for trekking, with his true identity being a natural born treasure hunting idiot. He spends his summer vacation immersing himself in various treasure hunting in Tokyo."},{"spoiler":false,"text":"He went to the same elementary school as Hilda and Leona."},{"spoiler":false,"text":"Favorites: Treasure hunting, Sentai hero shows"}],"source":"vndb","sourceCharacterId":"c94400"},{"segments":[{"spoiler":false,"text":"今作の主人公。"},{"spoiler":false,"text":"幼い頃は芋っぽかったが、今はなかなかのイケメンに生まれ変わっている。"},{"spoiler":false,"text":"しかし、中身は小学生のまま。バカで熱くて単純。そして元気。"},{"spoiler":false,"text":"いつでもトレッキングに出掛けられそうな格好をしている。"},{"spoiler":false,"text":"その正体は生粋の宝探しバカ。"},{"spoiler":false,"text":"この夏休みをすべて使って、都内にひしめく様々な宝探しに没頭している。"},{"spoiler":false,"text":"ヒルダ、レオナと同じ小学校出身。"}],"source":"egs","sourceCharacterId":"23443","sourceWorkId":"30345","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的主人公，也是纯粹的寻宝笨蛋。"},{"spoiler":false,"text":"整个暑假都埋头于都内花样繁多的寻宝活动。"}],"source":"bangumi","sourceCharacterId":"88394"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/8483455f1c3b1ff211bf430729d8a3586bfb86a3d957712fc8db7e879d570146.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db81b1cae418fe5c8b2673354b8eca0e22b7f54607ff7bd732f673985a04e112.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高塚智人","creatorId":"vndb:s9926","sourcePersonId":"vndb:s9926","canonicalEntityId":"vndb:s9926","name":"高塚 智人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:317672:88394:22515:1","source":"bangumi"}