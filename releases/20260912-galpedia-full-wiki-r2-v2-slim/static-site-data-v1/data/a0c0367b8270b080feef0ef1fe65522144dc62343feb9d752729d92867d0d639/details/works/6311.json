{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6311","model":{"presentationWorkId":"vndb:v2427","staff":{"artwork":[{"creditedName":"さくやついたち(サクヤ、さくや朔日)","creatorId":"vndb:s2800","sourcePersonId":"egs:creator:1294","canonicalEntityId":"vndb:s2800","name":"さくやついたち(サクヤ、さくや朔日)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14592","source":"egs"}],"scenario":[{"creditedName":"想ファクトリー","creatorId":"vndb:s2777","sourcePersonId":"egs:creator:2071","canonicalEntityId":"vndb:s2777","name":"想ファクトリー","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14593","source":"egs"}],"music":[{"creditedName":"有田宏","creatorId":"vndb:s2992","sourcePersonId":"egs:creator:16442","canonicalEntityId":"vndb:s2992","name":"有田宏","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:100821","source":"egs"}],"other":[{"creditedName":"ぐしゃ人間","creatorId":"vndb:s2993","sourcePersonId":"egs:creator:16443","canonicalEntityId":"vndb:s2993","name":"ぐしゃ人間","detail":"ED曲「悲しくて優しい旅」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:100822","source":"egs"},{"creditedName":"ウシ子","creatorId":"vndb:s2810","sourcePersonId":"vndb:s2810","canonicalEntityId":"vndb:s2810","name":"ウシ子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34863","source":"vndb"},{"creditedName":"ぐしゃ 人間","creatorId":"vndb:s2993","sourcePersonId":"vndb:s2993","canonicalEntityId":"vndb:s2993","name":"ぐしゃ 人間","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:34865","source":"vndb"}]},"cast":[{"characterId":"char_c24833","characterName":"葵","sourceIds":{"bangumi":[{"characterId":"193079","match":"exact-normalized-name-in-linked-work","subjectId":"269951"}],"egsCharacterIds":["26259"],"vndbCharacterId":"c24833"},"originalCharacterName":"葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の父にして朧衆頭目・幻十郎の側室。"},{"spoiler":false,"text":"年齢不詳で経歴も定かではなく、忍者屋敷の離れで、いつも暇を持て余し、ひとり歌を詠んだり、酒を飲んだり、自慰に耽ったりと、悠々自適に暮らしているらしい。"},{"spoiler":false,"text":"しかし、忍者屋敷の下忍や小間使い達は何かを知っているらしいが……。"}],"source":"egs","sourceCharacterId":"26259","sourceWorkId":"6311","spoiler":false},{"segments":[{"spoiler":false,"text":"幻十郎の側室。忍者屋敷の離れにある奥の間に幽閉されている。"},{"spoiler":false,"text":"艶のある美女で、豊満な肉体に謎めいた瞳を持つ。"},{"spoiler":false,"text":"普段は暇を持て余しており、一人で歌を詠んだり、酒を飲んだり、自慰に耽ったりしている。"},{"spoiler":false,"text":"年齢も経歴も定かではない。"},{"spoiler":false,"text":"忍者屋敷の下忍たちや小間使いたちは何か知っているらしいが、尋ねても誰もが一様に口を閉ざしてしまう。"}],"source":"bangumi","sourceCharacterId":"193079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d68d00f9931c59a5482c21e17a1ad864e875d49133186e7aafc96d3131d6e42.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41d6f77d772594c66adb08de20cad5c9e20520320a72724f6dbc45b13d954a93.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269951:193079:6547:1","source":"bangumi"}]},{"characterId":"char_c24834","characterName":"伽流羅","sourceIds":{"bangumi":[{"characterId":"193078","match":"exact-normalized-name-in-linked-work","subjectId":"269951"}],"egsCharacterIds":["26258"],"vndbCharacterId":"c24834"},"originalCharacterName":"伽流羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の直属の部下であるくノ一。"},{"spoiler":false,"text":"元々孤児だった彼女は、幻十郎に才能を見込まれ、鷹目らと一緒に忍者として育てられた。"},{"spoiler":false,"text":"感情を押し殺し、どのような状況においても動じることなく沈着冷静。"},{"spoiler":false,"text":"使命のためなら死すら厭わない、あまりにも忍者らしい忍者。"},{"spoiler":false,"text":"氷と雪を生み出し自在に操る“氷雪花の術”を得意とする。"},{"spoiler":false,"text":"また***草の扱いにもあかるく、妖怪変化をも異のままに操る“あやかし使い”の術にも通じている。"}],"source":"egs","sourceCharacterId":"26258","sourceWorkId":"6311","spoiler":false},{"segments":[{"spoiler":false,"text":"鷹目の直属の部下。これまでも長年に渡って、共に使命をこなしてきた。"},{"spoiler":false,"text":"もともと孤児で、才能を見込んだ幻十郎に引き取られ、鷹目や霧人と一緒に育てられた。"},{"spoiler":false,"text":"どんなときでも感情を表に出さず、冷静に振舞い、使命のためなら己の命をも捧げることを厭わない。"},{"spoiler":false,"text":"氷と雪を生み出して自在に操る＜氷雪花の術＞を得意とする。"},{"spoiler":false,"text":"また、薬草の扱いに長けており、妖怪変化を意のままに操る＜あやかし使い＞の技にも通じている。"}],"source":"bangumi","sourceCharacterId":"193078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b94dc11e020842307bde619229ad36779a22494bb9f81625b89a7332921f6b2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da3705daec2a6f4f7e8e676a67e847742685defb3a81b638e890a43f508f7102.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269951:193078:4956:1","source":"bangumi"}]},{"characterId":"char_c24835","characterName":"雛菊","sourceIds":{"bangumi":[{"characterId":"146014","match":"exact-normalized-name-in-linked-work","subjectId":"269951"}],"egsCharacterIds":["26257"],"vndbCharacterId":"c24835"},"originalCharacterName":"雛菊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三姉妹の三女。"},{"spoiler":false,"text":"天使のような純真さと、小悪魔のようなしたたかさの二面性を持つ少女。"},{"spoiler":false,"text":"その子どもの形（なり）を活かし、人を欺くことを説く意図する。"},{"spoiler":false,"text":"意識的には楓よりも世慣れしており、大人びているが、その小さき身体から、いつも背伸びしたがっている。"},{"spoiler":false,"text":"第六感に優れ、目を合わせて目標の意思を奪い、思いのままに操る“操幻の術”を使う。"},{"spoiler":false,"text":"体中に多数の暗器を忍ばせ、両手にはカラクリ篭手をはめている。"}],"source":"egs","sourceCharacterId":"26257","sourceWorkId":"6311","spoiler":false},{"segments":[{"spoiler":false,"text":"三姉妹の三女。天使のように純真に見えて実は小悪魔のようにしたたか。陰と陽のの二面性を持つ。わざと○○を演じて、人を騙す事が得意。世慣れしており、意識的には楓より大人だが、それでも体はやはり○○なので、いつも背伸びをしたがっている。くノ一としては、第六感に優れている。目を合わせた目標の意志を奪い、思い通りに操る＜操幻の術＞の使い手。"}],"source":"bangumi","sourceCharacterId":"146014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce38fc8c830a61e98fa17e485e1daab8ccb2271f592122f86e6d86a34b9225db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e395537c075f2c65158b47f3daaf8649de4adc1d36c27a1f4ea1dc0013034756.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269951:146014:5906:1","source":"bangumi"}]},{"characterId":"char_c24836","characterName":"楓","sourceIds":{"bangumi":[{"characterId":"146013","match":"exact-normalized-name-in-linked-work","subjectId":"269951"}],"egsCharacterIds":["26256"],"vndbCharacterId":"c24836"},"originalCharacterName":"楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三姉妹の次女。"},{"spoiler":false,"text":"肉体的には成熟しているものの、性格はまだ子供っぽく喜怒哀楽が激しい上に極度の負けず嫌い。"},{"spoiler":false,"text":"三姉妹の中で、もっとも体術に優れ、疾風の如き早業で敵を薙ぎ倒す。"},{"spoiler":false,"text":"さらに無から火を生み出し、その火を炎の龍と化して自在に操る“火炎龍の術”を使う。"}],"source":"egs","sourceCharacterId":"26256","sourceWorkId":"6311","spoiler":false},{"segments":[{"spoiler":false,"text":"三姉妹の次女。喜怒哀楽が激しく、無謀なくらい向こう見ずで、極度の負けずギライ。また、○○っぽく、我が侭なところがある。本当は三姉妹の中で一番女らしいのだが、素直になれず、自らそれを否定している。性的にも初心で、知識も無に等しい。くノ一としては、戦闘に長けており、その体術は睡蓮をも上回る。無から火を生じさせ、炎の龍を自在に操る＜火炎龍の術＞の使い手。"}],"source":"bangumi","sourceCharacterId":"146013"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd4752cc172f2bc89775cbd6805ee1ab1899656539f0ee1d70813ce3390f6450.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6f6e32c08ceaf4a2981a1e16885a33cd14c666f2fa84c364c7554cf10ecbacb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269951:146013:5741:1","source":"bangumi"}]},{"characterId":"char_c24837","characterName":"睡蓮","sourceIds":{"bangumi":[{"characterId":"146012","match":"exact-normalized-name-in-linked-work","subjectId":"269951"}],"egsCharacterIds":["26255"],"vndbCharacterId":"c24837"},"originalCharacterName":"睡蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三姉妹の長女。常に微笑を絶やさない、優しいお姉さん。"},{"spoiler":false,"text":"母性本能が強く、家族思い。頭もよく、機転も利く。"},{"spoiler":false,"text":"三姉妹の中にあって、もっとも優れたくノ一であり、特に智謀に長けている。"},{"spoiler":false,"text":"素肌から強烈な媚薬となる香りを放つ“春香の術”の使い手。"},{"spoiler":false,"text":"普段は抑えているが淫乱なところがあり、一度、火が点くと止まらなくなる。"}],"source":"egs","sourceCharacterId":"26255","sourceWorkId":"6311","spoiler":false},{"segments":[{"spoiler":false,"text":"三姉妹の長女。優しいお姉さんで、常に微笑みを絶やさない。家族思いで母性本能が強く、妹たちのことを溺愛している。さらに頭も良く、機転が利く。だが、性的には淫乱なところがあり、普段は抑えているが、いったん火が点くととまらなくなる。くノ一としては三姉妹の中で最も優れており、特に智謀に長けている。素肌から強烈な媚薬となる香りを放つ＜春香の術＞の使い手。"}],"source":"bangumi","sourceCharacterId":"146012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33c1809e27d0e2bda2960365c3d85add3b5b6941ff7c6b042fc876387ae32a12.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/372dd5ed9d519cd74c0a53816ff83d034eed55be52bcd9ccfdbe288572e79dbd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星野千寿子","creatorId":"vndb:s128","sourcePersonId":"vndb:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269951:146012:4210:1","source":"bangumi"}]},{"characterId":"char_vndb_c106569","characterName":"幻十郎","sourceIds":{"vndbCharacterId":"c106569"},"originalCharacterName":"幻十郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e57fdaf6c6b7ab1e22d68c40698ea10fa563e06f3d5ee0409504ad54e9cd72b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/448aaaa036918ebb464f97d5a0e18a671353613534cfe43749f9821068524a6f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"滝沢 アツヤ","creatorId":"vndb:s32"