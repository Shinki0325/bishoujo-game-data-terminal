tus":"auto-confirmed","relationId":"bangumi:character-voice:39909:21723:4032:1","source":"bangumi"}]},{"characterId":"char_bangumi_21724","characterName":"りゅうび げんとく","sourceIds":{"bangumi":[{"characterId":"21724","match":"source-roster","subjectId":"39909"}]},"originalCharacterName":"りゅうび げんとく","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0623"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4389ff9487662c2050d8fe00353ff4774e92f74a9c443dffa6772aff9026efc6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f043e19f6eece067341503bdad046cfe6522e8efa856fbe9683fdfe8fd917d5e.webp","width":256,"height":206,"source":"static-detail"},"actors":[{"creditedName":"真堂圭","creatorId":"vndb:s41","sourcePersonId":"vndb:s41","canonicalEntityId":"vndb:s41","name":"真堂 圭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:39909:21724:4905:1","source":"bangumi"}]},{"characterId":"char_bangumi_220740","characterName":"Chuukou Kyocho","sourceIds":{"bangumi":[{"characterId":"220740","match":"source-roster","subjectId":"39909"}]},"originalCharacterName":"Chuukou Kyocho","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0620"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"99"},"height":{"reviewState":"source-only","source":"bangumi","value":"184"},"hip":{"reviewState":"source-only","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"許昌学院の闘士。1年生。特Aランク。6月20日生まれ。O型。184cm。B：99・W：60・H：91。"},{"spoiler":false,"text":"転校生として登場し、過去に曹操と同じ道場で修業をしていた。少女時代の時点で同年代の男子より頭2つ分ほど背が高く、早熟だった模様。幼馴染である曹操のことを「孟くん」と呼んでおり、幼少時から彼の身を守ることを第一に考え、想いを寄せている。龍の力が暴走した曹操を身体を張って止め、彼が正気に戻るきっかけを作った。"},{"spoiler":false,"text":"桁外れの怪力を誇るが、口数は少なく、引っ込み思案な所がある。関羽の制服を繕ったり、曹操のハンカチに龍の刺繡を縫い込むなどの手芸も得意で、所属する手芸部の仲間からは「仲ちゃん」と呼ばれている。スポーツ万能で、様々な運動部からスカウトされたり、助っ人を頼まれている。実は特Aランクであることが、単行本第14巻初回限定版の小冊子で判明した。"},{"spoiler":false,"text":"アニメ版では『DD』で幼馴染設定だけが残っているものの、お互いは初対面状態。しかし、『XX』では原作準拠の設定へ変更された上、大闘士大会行きの船での再会をきっかけに馬超と親しくなる。また、『XX』以降では曹仁の親友という設定が追加され、2人セットの凸凹コンビとして登場することが多い。なお、酸味系の果物が好み。"},{"spoiler":false,"text":"OVA『EE』では弁慶と義経の許昌学院襲撃に際して曹操を守る為に弁慶に戦いを挑むが、実力の差によりピンチに陥った。だが、夏侯惇たちの助太刀と、曹操による義経の撃破により弁慶を撤退させる事に成功する。"},{"spoiler":false,"text":"原作の外伝で度々取り上げられたのが功を奏し、第2回人気投票では10位にランクイン。"}],"source":"bangumi","sourceCharacterId":"220740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9321456de02a8d07319a11cdfc6918e3dbc0ad2538966c8fa9c00929bd003eaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fb7654f94c9a54564f57d0eaa91b9584ac5d2ed5c6b17fc411233227ec0acc2.webp","width":106,"height":256,"source":"static-detail"},"actors":[{"creditedName":"武田華","creatorId":"vndb:s3716","sourcePersonId":"vndb:s3716","canonicalEntityId":"vndb:s3716","name":"武田華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:39909:220740:4870:1","source":"bangumi"}]},{"characterId":"char_bangumi_3325","characterName":"Hakufu Sonsaku","sourceIds":{"bangumi":[{"characterId":"3325","match":"source-roster","subjectId":"108440"},{"characterId":"3325","match":"source-roster","subjectId":"194888"},{"characterId":"3325","match":"source-roster","subjectId":"39909"},{"characterId":"3325","match":"source-roster","subjectId":"450504"}]},"originalCharacterName":"Hakufu Sonsaku","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0317"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"bust":{"reviewState":"source-only","source":"bangumi","value":"93"},"height":{"reviewState":"source-only","source":"bangumi","value":"162"},"hip":{"reviewState":"source-only","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"《一骑当千》的主角。天真烂漫的好战少女，没有性别之分，经常被人称为笨蛋，体内封印着水龙之力，战斗潜力不可限量，是难得的习武天才，后取代袁术成为南阳君主。在觉醒以后开始散发出领主的霸气，拥有可以打破命运诅咒的力量。作者盐崎雄二说，以孙策为主人公的理由是“谁都没以孙策为主人公过”。"},{"spoiler":false,"text":"原作漫画中为救周瑜跟随张纮学习水龙拳从而觉醒而回归赤壁之战战场逆转命运之力。动画版则在第二季被暴走曹操打飞，之后在张纮的指点下与于吉战斗中觉醒。"}],"source":"bangumi","sourceCharacterId":"3325"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0869203f09d9e6e6b810dc6329fbf3f79ffd5c27fea1f86c46923d42fdb558cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39b2846e217c14fada183b0a57f27f029453d8cc02ef6a427adb4575b0d21423.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅野真澄","creatorId":"vndb:s1146","sourcePersonId":"vndb:s1146","canonicalEntityId":"vndb:s1146","name":"浅野 真澄","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:39909:3325:3841:1","source":"bangumi"}]},{"characterId":"char_bangumi_3326","characterName":"りょもう しめい","sourceIds":{"bangumi":[{"characterId":"3326","match":"source-roster","subjectId":"194888"},{"characterId":"3326","match":"source-roster","subjectId":"39909"},{"characterId":"3326","match":"source-roster","subjectId":"450504"}]},"originalCharacterName":"りょもう しめい","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0903"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"85"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"hip":{"reviewState":"source-only","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本人气热血格斗动漫《一骑当千》中的人物，继承了三国武将吕蒙之魂的B级斗士。初期登场的时候表现狂傲，但相处下来其实是很可爱的女生，性格正经，平时举止拘谨，容易害羞，浅野真澄说“这是一个傲娇角色”。"},{"spoiler":false,"text":"南阳四天王之一，关节技绝顶高手，以手铐为武器配合，投入战斗时和平日判若两人，左眼因为多年前刘备暴走时被龙之力所伤而寄宿了龙之力。单恋着王允子师，除了南阳众人以外，与吕布奉先也有一段短暂却深刻的友谊。"}],"source":"bangumi","sourceCharacterId":"3326"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9dd2feff2f4d4b5057a75e6f0bf76bbcc2f4d4c8e1c8499bf70e37dd4a9339c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaf0fea7c63bef1903416872e40561163cee7a45b081f22fb560732fa00068f5.webp","width":133,"height":256,"source":"static-detail"},"actors":[{"creditedName":"甲斐田裕子","creatorId":"vndb:s3825","sourcePersonId":"vndb:s3825","canonicalEntityId":"vndb:s3825","name":"甲斐田裕子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:39909:3326:4245:1","source":"bangumi"}]},{"characterId":"char_bangumi_3329","characterName":"王允子师","sourceIds":{"bangumi":[{"characterId":"3329","match":"source-roster","subjectId":"39909"}]},"originalCharacterName":"王允子师","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0117"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"177"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"声 - 初代：森久保祥太郎 、『DD』以降：遊佐浩二"},{"spoiler":false,"text":"南陽四天王の一角。3年生。1月17日生まれ。O型。身長177cm。"},{"spoiler":false,"text":"飄々とした性格の持ち主で、女性には目が無く呉栄にもお世辞を言うほどなので、守備範囲は広い模様。「左慈」はスパイとして南陽に潜り込むための偽名であり、本名は王允 子師。送り込んだ張本人である董卓や華佗は、左慈が王允であることを知っていた。原作では常にタバコを咥えている。呂蒙・程普・楽就とは中等部からの付き合いで、呂布とも当時から旧知の仲にある。父親は南陽学院の理事長（士孫瑞談）。"},{"spoiler":false,"text":"原作では王允自身の命が尽きかけているために決死の覚悟で孫策に勝負を挑み、彼女の龍退治をした後に自決。アニメ版では存命しているが、『GG』においては「本物の左慈元放」がアニメオリジナルキャラクターとして登場したため、区別する意味からエンドクレジットには「王允子師」名義で記載されている。なお、孫策からは「さじっち」と呼ばれている。"},{"spoiler":false,"text":"アニメ版での髪の色は第1期だとやや暗い緑色だったが、『DD』以降は金髪となっている。なお、王允子師として勾玉を付けると髪が朱色に染まる。"}],"source":"bangumi","sourceCharacterId":"3329"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a92989a5af40d40894e36ee2bfff344035dc7478e8f34d050d3a8f13fe2cd5f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d5a10e5203451294b2e9ded3e1cc298babfca7a303759dbb9c6f099fc8f9c88.webp","width":256,"height":192,"source":"static-detail"},"actors":[{"creditedName":"遊佐浩二","creatorId":"vndb:s56","sourcePersonId":"vndb:s56","canonicalEntityId":"vndb:s56","name":"遊佐 浩二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:39909:3329:4614:1","source":"bangumi"}]},{"characterId":"char_bangumi_3339","characte