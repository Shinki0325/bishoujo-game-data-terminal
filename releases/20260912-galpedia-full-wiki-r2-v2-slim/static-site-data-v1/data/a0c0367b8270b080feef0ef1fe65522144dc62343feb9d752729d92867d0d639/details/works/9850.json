{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9850","model":{"presentationWorkId":"vndb:v249","staff":{"artwork":[{"creditedName":"Rけん","creatorId":"vndb:s4014","sourcePersonId":"egs:creator:977","canonicalEntityId":"vndb:s4014","name":"Rけん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:45168","source":"egs"}],"scenario":[{"creditedName":"てつじん","creatorId":"vndb:s3166","sourcePersonId":"egs:creator:1652","canonicalEntityId":"vndb:s3166","name":"てつじん","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:45169","source":"egs"}],"music":[{"creditedName":"Corey&Carter","creatorId":"vndb:s2994","sourcePersonId":"egs:creator:5071","canonicalEntityId":"vndb:s2994","name":"Corey&Carter","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71675","source":"egs"},{"creditedName":"薬師 るり","creatorId":"vndb:s2361","sourcePersonId":"vndb:s2361","canonicalEntityId":"vndb:s2361","name":"薬師 るり","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:6984","source":"vndb"}],"other":[{"creditedName":"薬師るり","creatorId":"vndb:s2361","sourcePersonId":"egs:creator:5042","canonicalEntityId":"vndb:s2361","name":"薬師るり","detail":"OP曲「ドリームライダー」、ED曲「みんなの声が聞こえる」、挿入歌「鳥籠に見た夢」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68738","source":"egs"},{"creditedName":"薬師 るり","creatorId":"vndb:s2361","sourcePersonId":"vndb:s2361","canonicalEntityId":"vndb:s2361","name":"薬師 るり","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:6985","source":"vndb"}]},"cast":[{"characterId":"char_c35887","characterName":"空崎 静枝","sourceIds":{"bangumi":[{"characterId":"126630","match":"exact-normalized-name-in-linked-work","subjectId":"21864"}],"egsCharacterIds":["19242"],"vndbCharacterId":"c35887"},"originalCharacterName":"空崎 静枝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公を助け「薫屋」へ引き入れた娼婦。"},{"spoiler":false,"text":"清楚で器量よし、物静かで落ち着きあり、とても娼婦をしているようには見えない不思議な女性。"},{"spoiler":false,"text":"だが内面は、とても寂しがり屋で怖がり。"},{"spoiler":false,"text":"数年前に起きた事件がきっかけで、赤線街から出ることを極端に嫌っている様子。"}],"source":"egs","sourceCharacterId":"19242","sourceWorkId":"9850","spoiler":false},{"segments":[{"spoiler":false,"text":"真之が憧れる、物静かで器量よしな女性。不思議な落ち着きをもった女性で、赤線宿「薫屋」のナンバーワン。"},{"spoiler":false,"text":"既に時代遅れな着物を普段着として着ている。"},{"spoiler":false,"text":"真之を「薫屋」に迎え入れた張本人。清楚で落ち着いていて、とても娼婦には見えない女性と、真之には映る。落ち着いているように見えるが、心底寂しがり屋で恐がり屋。"},{"spoiler":false,"text":"初め真之は彼女に母・董子の姿を映し恋焦がれるが、それが故ある事とは知らない。"},{"spoiler":false,"text":"赤線地区から外へ出る事を極端に嫌っている。それには数年前に起きた事件が関わっているらしいのだが……"}],"source":"bangumi","sourceCharacterId":"126630"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57958f24b6866d56c13160f1f090a0d4541c44a92aee6091632374a6e64f0c80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c16259dc8d0b828e27847be8f3f77413121010391246431d307113d3301cbb2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21864:126630:4434:1","source":"bangumi"}]},{"characterId":"char_c35888","characterName":"小此木 楓香","sourceIds":{"bangumi":[{"characterId":"126631","match":"exact-normalized-name-in-linked-work","subjectId":"21864"}],"egsCharacterIds":["19243"],"vndbCharacterId":"c35888"},"originalCharacterName":"小此木 楓香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じく、静枝に拾われた少女。"},{"spoiler":false,"text":"「薫屋」で下働きとして頑張っており、こう見えて、意外と頑固で負けず嫌いだったりする。"},{"spoiler":false,"text":"憧れの静枝に近づくため、風貌仕草をマネしようとするが、その道のりは、まだまだ遠い様子。"},{"spoiler":false,"text":"「しなやかに耐える大人」を目指しているようだが……。"}],"source":"egs","sourceCharacterId":"19243","sourceWorkId":"9850","spoiler":false},{"segments":[{"spoiler":false,"text":"静枝に拾われた少女。"},{"spoiler":false,"text":"真之と同年代の少女で、赤線宿「薫屋」で下働きをして生活をしている。自分が「薫屋」のお荷物になっていると思っており、"},{"spoiler":false,"text":"拾ってくれた静枝に恩返しするためにも、自分もいずれは女給として働くつもりでいる。"},{"spoiler":false,"text":"頑張り屋だが、意外と頑固で負けず嫌い。静枝に憧れていてその風貌仕草を真似しようとしているが、まだまだ全然届いていない。"},{"spoiler":false,"text":"「早く大人になりたい」という気持ちを真之と同様に持っており、真之とは反対の「しなやかに耐える大人」を目指してゆく。それゆえに真之と同じようなところで、大人への道に躓いてゆくのだが……"}],"source":"bangumi","sourceCharacterId":"126631"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3da6ad3c61eea8943294295796ecb2079058b071d4e20250d8b39e8d20342560.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/177d4f8caaffce03950b2616c20514e7867decb1483b12a2c13cc173123c6efd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21864:126631:6106:1","source":"bangumi"}]},{"characterId":"char_c35889","characterName":"来生 千尋","sourceIds":{"bangumi":[{"characterId":"126632","match":"exact-normalized-name-in-linked-work","subjectId":"21864"}],"egsCharacterIds":["19244"],"vndbCharacterId":"c35889"},"originalCharacterName":"来生 千尋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"喜怒哀楽が豊かな「薫屋」の娼婦。"},{"spoiler":false,"text":"あけっぴろげで気さく、明るくてお喋り、そしてよく怒るお姉さんタイプ。"},{"spoiler":false,"text":"口は悪いが、周囲への気配りには敏感で、それ故、一人で物事を抱えてしまうことも多い。"},{"spoiler":false,"text":"主人公が「薫屋」へやってきてからは、彼をからかうことが日課になった様子。"}],"source":"egs","sourceCharacterId":"19244","sourceWorkId":"9850","spoiler":false},{"segments":[{"spoiler":false,"text":"薫屋の娼婦。"},{"spoiler":false,"text":"あけっぴろげで気さく、明るくてよく喋りよく怒る感情豊かなお姉さん。口こそ悪いが、相手のことを思っての言動なので、周りからは好かれている。そんな性分ゆえに一人で何でも抱えてしまう事が多い。"},{"spoiler":false,"text":"真之が「薫屋」に来てからは、真之をからかう事が日課。真之の直情的な行動に怒ったり呆れたりしているが、内心は新鮮な驚きでもって見守ってくれている。"},{"spoiler":false,"text":"赤線業を「お上に許されたビジネス」と割り切って居る。それが真之には理解が出来ずに反発ばかりしているのだが、やがて千尋には千尋の守るべきものがある事に気がついてゆく。"}],"source":"bangumi","sourceCharacterId":"126632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c15aa60252d8decc0199ad24addee3aeeb6013ed11a2a631100c56c707777b1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7aaeb053bb394641719cc8c3144fe0af6caeddf71289a10d12bc925bae997985.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21864:126632:4832:1","source":"bangumi"}]},{"characterId":"char_vndb_c35891","characterName":"渡会 卓","sourceIds":{"vndbCharacterId":"c35891"},"originalCharacterName":"渡会 卓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-onl