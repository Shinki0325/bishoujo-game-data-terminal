tyId":"vndb:s2390","name":"華月 嵐","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:9597","source":"vndb"},{"creditedName":"電気","creatorId":"vndb:s2433","sourcePersonId":"vndb:s2433","canonicalEntityId":"vndb:s2433","name":"電気","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:9599","source":"vndb"},{"creditedName":"華憐","creatorId":"vndb:s2434","sourcePersonId":"vndb:s2434","canonicalEntityId":"vndb:s2434","name":"華憐","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:9600","source":"vndb"},{"creditedName":"aine","creatorId":"vndb:s4827","sourcePersonId":"vndb:s4827","canonicalEntityId":"vndb:s4827","name":"aine","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:9604","source":"vndb"},{"creditedName":"Kuri++","creatorId":"vndb:s14508","sourcePersonId":"vndb:s14508","canonicalEntityId":"vndb:s14508","name":"Kuri++","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:9605","source":"vndb"},{"creditedName":"一石 楠耳","creatorId":"vndb:s38037","sourcePersonId":"vndb:s38037","canonicalEntityId":"vndb:s38037","name":"一石 楠耳","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:9606","source":"vndb"}]},"cast":[{"characterId":"char_c18947","characterName":"翠川 藍子","sourceIds":{"bangumi":[{"characterId":"144161","match":"exact-normalized-name-in-linked-work","subjectId":"184542"}],"egsCharacterIds":["19856"],"vndbCharacterId":"c18947"},"originalCharacterName":"翠川 藍子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"第二章のヒロイン。"},{"spoiler":false,"text":"成績優秀、品行方正、容姿端麗、抜群のプロポーションを誇る優等生。"},{"spoiler":false,"text":"人当たりがよく、面倒見もよいと完璧超人のような人物で、学園内でも、彼女を慕う生徒は数知れず。"},{"spoiler":false,"text":"当然、かなりモテるのだが、それ故に、心のないイケメン君たちには、厭き厭きしている様子。"},{"spoiler":false,"text":"そんな彼女にとって、昌人は新鮮なキャラクターだったようで……。"},{"spoiler":false,"text":"「くすっ……そんなに緊張しなくても大丈夫よ。ほら……ちゃんとこっち見て」"}],"source":"egs","sourceCharacterId":"19856","sourceWorkId":"9471","spoiler":false},{"segments":[{"spoiler":false,"text":"「くすっ……そんなに緊張しなくても大丈夫よ。ほら……ちゃんとこっち見て」"},{"spoiler":false,"text":"成績優秀、品行方正な進学科の優等生。 美容の為に水泳をしており、隙の無いプロポーションをしてる。"},{"spoiler":false,"text":"マンションビルのペントハウスに住むプチお嬢様。 人当りが良く、面倒見も良い事から、彼女を慕う学生は多い。 学園内では髪を結い眼鏡をかけているので一見地味だが、その実、容姿端麗。 学業に差し障りの無い程度にモデル業もしている。 周囲からはかなりモテるようだが、それ故に所謂イケメン君達には厭き厭きしている。"},{"spoiler":false,"text":"そんな藍子にとって、昌人くんは新鮮なキャラクターなようで……。"},{"spoiler":false,"text":"【第二章紹介】 「好これって、BAD-END!?」"},{"spoiler":false,"text":"噴井昌人は、アニメやゲームが好きで少々大人しい学生。 所謂オタク。試験勉強の前夜も、息抜きのつもりがゲームに嵌って気がつけば朝。 そんな昌人の近頃の属性は「年上」＆「水着」。 そして、彼の学園には、水着の似合う先輩、翠川藍子が居た。 ひょんな事から藍子を助けた昌人は彼女から積極的なアプローチを受ける。 人付き合いが得意では無い昌人、 藍子のペースに振り回され気がつけばセックスをする関係に。 しかし、現実の女性は、ゲームと違って理想から程遠く……。"}],"source":"bangumi","sourceCharacterId":"144161"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a00c5326da51e8537354945b0ba05056b25f4b8028d6581de4bee9bfbed9a5eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feb32c056c36756371929879f8c93c5a432a02cc97a8192e82d19eb53866efb2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:184542:144161:4832:1","source":"bangumi"}]},{"characterId":"char_c18948","characterName":"サッキー","sourceIds":{"bangumi":[{"characterId":"144163","match":"exact-normalized-name-in-linked-work","subjectId":"184542"}],"egsCharacterIds":["19858"],"vndbCharacterId":"c18948"},"originalCharacterName":"サッキー","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"第三章の主人公。"},{"spoiler":false,"text":"人付き合いがよく、毎日を楽しく過ごせる性格。"},{"spoiler":false,"text":"学業、遊び、将来、全てのことを程々に考え、程々に努力し、そして程々に結果を残してきた。"},{"spoiler":false,"text":"そんなハッキリしたモノを持てない自分に、閉塞感を覚えながらも、それなりの日々を過ごしていたが……。"}],"source":"egs","sourceCharacterId":"19858","sourceWorkId":"9471","spoiler":false},{"segments":[{"spoiler":false,"text":"いたって普通の女の子。 人付き合いが良く、日常を楽しく過ごす事に長け、人間関係は良好。"},{"spoiler":false,"text":"人の恋話は気になるが、いざ自分の事となるとピンとこない。"},{"spoiler":false,"text":"程々に学業をこなし、程々に遊び、程々に生来の事を考えている。 何事も、程々に努力し、程々に結果を残す。"},{"spoiler":false,"text":"でも、何かはっきりとしたものを持ててはいない。 そんな自分に、閉塞感を覚えながらも、それなりの日々を過ごしている。"}],"source":"bangumi","sourceCharacterId":"144163"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4098bba917ba0c61ca6d322f48702cf5625df792f6c359576fe540aa190708f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd7f75b701ed647ba0f67e1d855a3a570f71643732a16354313388155b7d6623.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"たかはし智秋","creatorId":"vndb:s287","sourcePersonId":"vndb:s287","canonicalEntityId":"vndb:s287","name":"たかはし 智秋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:184542:144163:4604:1","source":"bangumi"}]},{"characterId":"char_c18949","characterName":"りぃ","sourceIds":{"bangumi":[{"characterId":"144164","match":"exact-normalized-name-in-linked-work","subjectId":"184542"}],"egsCharacterIds":["19859"],"vndbCharacterId":"c18949"},"originalCharacterName":"りぃ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"第四章過去編のヒロイン。"},{"spoiler":false,"text":"奇麗なストレートの黒髪、長く伸びた四肢、膨らみかけの胸と、少女時代の危うい魅力を持つ少女。"},{"spoiler":false,"text":"いっこ年下の虹助に大人ぶった態度をとりたがるが、その内容はちょっと我がままだったり、生意気だったり、まだまだ子供の域を出ないものが多い。"},{"spoiler":false,"text":"「女の子の胸とか触っていいのは、本当にその人が好きな時だけなんだよ？」"}],"source":"egs","sourceCharacterId":"19859","sourceWorkId":"9471","spoiler":false},{"segments":[{"spoiler":false,"text":"「女の子の胸とかに触っていいのは、本当にその人が好きな時だけなんだよ？」"},{"spoiler":false,"text":"黒いストレートの髪が印象的。 長く伸びた四肢と膨らみかけの胸という危ういスタイルの少女。"},{"spoiler":false,"text":"いっこ年下の友達・虹助に向かって、大人ぶった態度をとりたがる。"},{"spoiler":false,"text":"口調は少々おっとりしているが、 言葉の内容はちょっと我侭だったり生意気だったりして、時折、虹助を困らせる。"},{"spoiler":false,"text":"【第四章紹介】 「胸の底にこびり付く初恋の残滓」"},{"spoiler":false,"text":"水澤学園の教師・鮎川虹助は、あの時以来、何かを失ったままだった。 一日が、今よりもずっと長く感じられた頃。 夏休み二人は夜になると友達のりぃと一緒に水澤学園のプールに忍び込んでいた。"},{"spoiler":false,"text":"りぃは泳ぎが上手で、お姉さんぶってて、いつも虹助より大人だった。 りぃは、あんなに泳ぐ事が好きなのに、海に行った事が無かった。 りぃがどれだけ望んでも、家族はりぃを海に連れていかなかった。 だから、虹助はりぃを海に連れて行こうと思った。"},{"spoiler":false,"text":"その先に、悲しい出来事が待っているなんて、思いもせずに……。"}],"source":"bangumi","sourceCharacterId":"144164"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47eb67d5783175ac4e015fb239f4f0d9499571d791131c90b5678b7f936bd1f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23864efd7f4b164a394e647f30964609c2748f40d66ff75ca66d37f5744c9602.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:184542:144164:4830:1","source":"bangumi"}]},{"characterId":"char_c18950","characterName":"木場 晴海","sourceIds":{"bangumi":[{"characterId":"144160","match":"exact-normalized-name-in-linked-work","subjectId":"184542"}],"egsCharacterIds":["19855"],"vndbCharacterId":"c18950"},"originalCharacterName":"木場 晴海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"第一章のヒロイン。"},{"spoiler":false,"text":"健康的な肉付きのよい身体が、ちょっと気になる年頃の女の子。"},{"spoiler":false,"text":"水泳部に所属しているが、育ちすぎの胸のせいか、実力は今一つ。"},{"spoiler":false,"text":"幼い頃はお兄ちゃん子で、兄・弘海と仲よく遊んでいた。"},{"spoiler":false,"text":"近頃、エッチになった兄に「エロが移る」と、距離をとっていたが……。"},{"spoiler":false,"text":"「バカ兄ぃの視線ってエロくてねちっこいから、すぐわかるんだよね」"}],"source":"egs","sourceCharacterId":"19855","sourceWorkId":"9471","spoiler":false},{"segments":[{"spoiler":false,"text":"「バカ兄ぃの視線ってエロくてねちっこいから、すぐにわかるんだよね」"},{"spoiler":false,"text":"手を振ったときに上腕の肉がぷるぷると震えるのが少し気になるお年頃な女の子。少しスケベな兄貴・弘海を「ばか兄」と呼ぶのが口癖。"},{"spoiler":false,"text":"水泳部の非本格派部員。学業は普通のちょっと下。育ちすぎの胸が邪魔なのか、運動能力も今ひとつ。"},{"spoiler":false,"text":"幼い頃はお兄ちゃん子で、弘海とは兄貴＆子分的に （ピンポンダッシュ実行犯を務めるとか） 仲良く遊んでいた。"},{"spoiler":false,"text":"近年は、「エロが移る」と言って、兄との距離はとっているが、その本心は……。"},{"spoiler":false,"text":"【第一章紹介】 「好きと言ってはいけない」"},{"spoiler":false,"text":"ちょいとスケベな、要するに普通な男子である兄・弘海。 少し口の悪い妹・晴海。○○の頃は仲良く遊んだ二人だが、 思春期を過ぎた頃から、次第に一緒にいる時間は少なくなっていった。 しかし、この夏…試験勉強を機に二人の距離は再び接近する。 そして夏休み。両親の留守中に身体を重ねてしまう兄妹。 身体の奥底から溢れ出す性欲に溺れ、二人の行為は加速していく。 しかし、どれほど淫らな言葉を交し合おうとも、言ってはいけない言葉がある。 それを言ってしまえば、後戻りできなくなるから……。"}],"source":"bangumi","sourceCharacterId":"144160"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8b2d2e0b854823157a3facef9bf09ed734f12f2cd029b80eb2da868e59c09cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/3800af6b0c17c05b0e56e236aa650ca0e5f171d6573d696a3b499deeaba06d3e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:184542:144160:5907:1","source":"bangumi"}]},{"characterId":"char_c18951","characterName":"マリカ","sourceIds":{"bangumi":[{"characterId":"144162","match":"exact-normalized-name-in-linked-work","subjectId":"184542"}],"egsCharacterIds":["19857"],"vndbCharacterId":"c18951"},"originalCharacterName":"マリカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"第三章のヒロイン。"},{"spoiler":false,"text":"主人公のクラスに転校してきた少女。"},{"spoiler":false,"text":"家庭の事情で、幼いころから一つの場所に長く住まない事から、地域のコミュニティに深入りしないようにしている。"},{"spoiler":false,"text":"その代わり、趣味のコスプレやネットなどにハマっている様子。"},{"spoiler":false,"text":"人付き合いはあまり得意ではなく、人と中々打ち解けないが、一度、仲良くなると密なスキンシップをしてくるほど懐く。"},{"spoiler":false,"text":"「皐月ちゃん、たぶんコスプレしたらすっごく似合うよ！」"}],"source":"egs","sourceCharacterId":"19857","sourceWorkId":"9471","spoiler":false},{"segments":[{"spoiler":false,"text":"「皐月ちゃん、たぶんコスプレしたらすっごく似合うよ！」"},{"spoiler":false,"text":"家庭の事情で転校を繰り返している女の子。 趣味はコスプレ。隙だらけのプロポーションの持ち主。 中途半端に膨らんだ胸。申し訳程度にくびれた腰。いかにも運動が苦手そうな尻。 低い背丈。そんなメリハリの少ない体型を気にしている。"},{"spoiler":false,"text":"ひとつの場所に長く住まない事から、 学校等の地域に根ざすコミュニティには深入りしないよう心掛けている。 その代替として、ネットや趣味のコスプレの世界等に属している。 人付き合いはあまり得意ではなく中々他人とは打ち解けない。 しかし、一度打ち解けてしまえば、明るく饒舌で、不用意なスキンシップ等をしてしまう。"},{"spoiler":false,"text":"【第三章紹介】 「友情なのか恋なのか」"},{"spoiler":false,"text":"青葉皐月はどこにでもいる普通の女の子。 学業の成績や友達の恋話に一喜一憂する、当たり前の学生生活を送っている。 夏休みを目前に控えた或る日、転校生・風谷立夏がやってくる。 クラスに今ひとつ溶け込めない立夏。 皐月は親切にしようとするが、良い反応を得られない。 そんなある時、立夏の趣味がコスプレである事を知った皐月。 それは近寄り難い未知の世界だった。 立夏と仲良くなろうと、皐月は自らの足を趣味の世界に踏み入れて行く。 やがて、趣味の話題を切欠に、打ち解けるようになった皐月と立夏。 皐月は次第に、友情以上の感情を胸の内に覚え始め……。"}],"source":"bangumi","sourceCharacterId":"144162"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52f13bc01a8feca551c3807e7a5f5cb7db660a22d83f278d90a581dcdcfb3c2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cde355492b6f9fdbe1352bb70e6aff00888262a135eadf7adbe38ce74c27ecac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神崎ちろ","creatorId":"vndb:s1055","sourcePersonId":"vndb:s1055","canonicalEntityId":"vndb:s1055","name":"神崎 ちろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:184542:144162:4160:1","source":"bangumi"}]},{"characterId":"char_c4017","characterName":"天枷 美春","sourceIds":{"bangumi":[{"characterId":"2499","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"2499","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["18103"],"vndbCharacterId":"c4017"},"originalCharacterName":"天枷 美春","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"pending-conflict","source":"vndb","value":"306"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miharu is"},{"spoiler":true,"text":"an android patterned after"},{"spoiler":false,"text":"a childhood friend of the Asakura family"},{"spoiler":true,"text":"with the same name, and is thus experiencing lots of things for the first time"},{"spoiler":false,"text":". Her enthusiasm often overrules her common sense"},{"spoiler":true,"text":", and Jun'ichi often has to get her out of sight when her circuits start to overload"},{"spoiler":false,"text":"."},{"spoiler":true,"text":"Like her namesake"},{"spoiler":false,"text":", she enjoys eating bananas."},{"spoiler":true,"text":"The real-life"},{"spoiler":false,"text":"Miharu adores Nemu, and behaves much like a little puppy around her."}],"source":"vndb","sourceCharacterId":"c4017"},{"segments":[{"spoiler":false,"text":"通称は“わんこ”。"},{"spoiler":false,"text":"芳乃さくらが居なくなった後、朝倉兄妹の幼馴染になった少女。"},{"spoiler":false,"text":"特に音夢とは親友で、同じ委員会で“可愛がられて”いる。"},{"spoiler":false,"text":"無邪気な発言と忘れっぽい性格で、いつも主人公 をヤキモキさせるが、実は一番しっかりした性格をしている……、のかも。"},{"spoiler":false,"text":"主人公と音夢が義理の兄妹ということは知らず、二人の関係に夢見ているようなところもあるが、遠くから楽しく見守っている。"},{"spoiler":false,"text":"存在そのものが冗談のようなマッドサイエンティ ストの父を持つ。"},{"spoiler":false,"text":"意外と頑丈。バナナを愛している。"}],"source":"egs","sourceCharacterId":"18103","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"朝倉兄妹の幼馴染で音夢と同じ風紀委員に所属している後輩。"},{"spoiler":false,"text":"とにかく無邪気で、ニコニコと笑顔を振りまいている。"},{"spoiler":false,"text":"その姿はしっぽを振る「わんこ」。"}],"source":"egs","sourceCharacterId":"18103","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"朝倉兄妹の幼馴染で後輩。"},{"spoiler":false,"text":"明るくて元気、常に前向きなタイプだが、やや暴走気味な面も。"},{"spoiler":false,"text":"バナナを食べている時が、至福の時間らしい。"},{"spoiler":false,"text":"「そんな人を好きになった気持ちは、忘れちゃあ、ダメですよ」"}],"source":"egs","sourceCharacterId":"18103","sourceWorkId":"10905","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fbaf80c64f95d99b43e7f43e89e3c31211ae02ecfb5b8b4bbc0b15af5ae7173.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4a20da4fce2f56c88ef60fbbeefeec849cc9e5db3f7cfdcf8bbcbb9d8321707.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c4024","characterName":"月城 アリス","sourceIds":{"bangumi":[],"egsCharacterIds":["18099"],"vndbCharacterId":"c4024"},"originalCharacterName":"月城 アリス","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"327"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"141"},"hip":{"reviewState":"source-only","source":"vndb","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"32"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alice is a half-Japanese, half-northern-European. Having lost her parents at an early age, she lives with her butler, Seba, and several other helpers in a mansion on Hatsunejima. Incapable of speaking for herself or presenting her feelings, she communicates with others through her puppet Philos (ピロス Pirosu). Philos gets the ability to speak for Alice through the power of the magical sakura tree. Having spent time in a circus she has exceptional reflexes, but she is unable to swim. She is also good friends with Miharu who is in the same class as her, and Aisia who has came from the same region as she did."}],"source":"vndb","sourceCharacterId":"c4024"},{"segments":[{"spoiler":false,"text":"朝倉の一つ下の後輩で、とびの色の瞳と銀髪が特徴。"},{"spoiler":false,"text":"物静かだが、運動が得意という一面もあり。"},{"spoiler":false,"text":"同級生である美春とは親友同士。"},{"spoiler":false,"text":"「先輩が、こんなに近くにいてくれるから、私は寂しくないです」"}],"source":"egs","sourceCharacterId":"18099","sourceWorkId":"10905","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a279e149fc49ce3