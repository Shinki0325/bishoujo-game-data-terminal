{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10902","model":{"presentationWorkId":"vndb:v829","staff":{"artwork":[{"creditedName":"桜ロマ子(桜島サロマ子)","creatorId":"vndb:s2746","sourcePersonId":"egs:creator:1811","canonicalEntityId":"vndb:s2746","name":"桜ロマ子(桜島サロマ子)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68332","source":"egs"}],"scenario":[{"creditedName":"てっど","creatorId":"egs:creator:10831","sourcePersonId":"egs:creator:10831","canonicalEntityId":"egs:creator:10831","name":"てっど","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:67828","source":"egs"}],"music":[{"creditedName":"山本秀樹(斑尾歩、紫賀耕元)","creatorId":"vndb:s2708","sourcePersonId":"egs:creator:3138","canonicalEntityId":"vndb:s2708","name":"山本秀樹(斑尾歩、紫賀耕元)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:67829","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c37852","characterName":"みゅう","sourceIds":{"bangumi":[{"characterId":"93639","match":"exact-normalized-name-in-linked-work","subjectId":"37030"}],"egsCharacterIds":["18107"],"vndbCharacterId":"c37852"},"originalCharacterName":"みゅう","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹。"},{"spoiler":false,"text":"幼児体型のわりには胸だけはやたらと育った童顔巨乳幼女。"},{"spoiler":false,"text":"性格は穏やかで優しく、料理上手なしっかり者。"},{"spoiler":false,"text":"所属する陸上部では男子から、アイドル的に扱われている人気者。"},{"spoiler":false,"text":"ブラコン気味で、主人公に好意を抱いている模様。"}],"source":"egs","sourceCharacterId":"18107","sourceWorkId":"10902","spoiler":false},{"segments":[{"spoiler":false,"text":"裕太の義理の妹。一人称は『みゅう』。"},{"spoiler":false,"text":"穏やかな微笑が印象的な、料理上手のしっかり者。"},{"spoiler":false,"text":"幼児体型のわりに胸の発育だけはやたらと良く、陸上部の男子部員にはアイドル扱いされている。"},{"spoiler":false,"text":"甘い物（特にハチミツ）が大好き。"}],"source":"bangumi","sourceCharacterId":"93639"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/515bdc97fd47a49141b0d534ee200da957527051d442d00df4afbd62486ff06f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8737a6f90648c0997bf5c07953cd9ce5541e497c772f52d1958e79823612c22f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37030:93639:6480:1","source":"bangumi"}]},{"characterId":"char_c37853","characterName":"桜野 林檎","sourceIds":{"bangumi":[{"characterId":"88169","match":"exact-normalized-name-in-linked-work","subjectId":"37030"}],"egsCharacterIds":["18108"],"vndbCharacterId":"c37853"},"originalCharacterName":"桜野 林檎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の彼女いして、みうの大親友。"},{"spoiler":false,"text":"喜怒哀楽の感情表現豊かな、元気一杯のツインテールロリ少女。"},{"spoiler":false,"text":"男女問わず友達が多い人気者。"},{"spoiler":false,"text":"外を駆け回って遊ぶのが大好きそうだが、「RPGのレベル上げ」「B級映画観賞」「クロスワードパズル」が趣味のインドア派。"},{"spoiler":false,"text":"主人公の性癖を理解し、ぶっかけを受け入れてくれる。"}],"source":"egs","sourceCharacterId":"18108","sourceWorkId":"10902","spoiler":false},{"segments":[{"spoiler":false,"text":"裕太の彼女であり、みうの親友。"},{"spoiler":false,"text":"喜怒哀楽が表情に出やすく、よく喋りよく笑う明るい女の子。"},{"spoiler":false,"text":"男女を問わず友達の多い人気者だが……本性はインドア系。"},{"spoiler":false,"text":"『レベル上げ』『B級映画鑑賞』『クロスワードパズル』と特殊な趣味を持っている。"}],"source":"bangumi","sourceCharacterId":"88169"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc891b9e5ebcdb2df2a657fa900de58f7d4a9ab86a4168f4b67e9db9a71af7da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70e8df566d3adf859474d293190aa6c556abc009189c803224883756e0936c66.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37030:88169:13512:1","source":"bangumi"}]},{"characterId":"char_vndb_c37854","characterName":"桜野 達史","sourceIds":{"vndbCharacterId":"c37854"},"originalCharacterName":"桜野 達史","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdd4c14b8ff074823200653eca27f554732da58d33e2c1a1e0d110f13c0b9a3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/841d5d720392be6c5c817f9c8c51ae77364b65102fcc59cbcb5169854955a32e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37855","characterName":"下倉 裕太","sourceIds":{"vndbCharacterId":"c37855"},"originalCharacterName":"下倉 裕太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vnd