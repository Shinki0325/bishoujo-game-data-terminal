scriptions":[{"segments":[{"spoiler":false,"text":"種子島の食堂「なる軒」の一人娘。父親と二人でお店を切り盛りしている。"},{"spoiler":false,"text":"また、奈留島家は民宿「星窓亭」も管理しており、夏休みの間美宇たちの宿泊のサポートをする事に。"},{"spoiler":false,"text":"やさしい性格で、島の人々からも愛されている一方、人見知りが激しく島の外の人にはかなり抵抗がある。"},{"spoiler":false,"text":"当初与一たちにも壁を作っていたものの、美宇の宇宙に対する情熱に興味を抱き、知識はないが一緒にロケットを制作する事になる。"}],"source":"egs","sourceCharacterId":"6395","sourceWorkId":"21797","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e9905af6eb7b8fde8f278248556db2021cf06c80bf8e19d142bc189f1856622.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa21901746400f83642d0ee80a650aa975dcc50b1891eb589f9a77bb9c085e63.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_egs_6396","characterName":"奈留島 健吾","sourceIds":{"egsCharacterIds":["6396"]},"originalCharacterName":"奈留島 健吾","characterNameSource":null,"role":"4","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"8/25"},"bloodType":{"reviewState":"source-only","source":"egs","value":"B"},"sex":{"reviewState":"source-only","source":"egs","value":"男性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"奈留ちゃんの父で種子島の食堂「なる軒」の亭主。地元に精通しており、地鶏から海鮮料理など島中のあらゆる郷土料理をふるまえる。"},{"spoiler":false,"text":"また、義行らAVSAのメンバーとも戦前からの交流があり、古民家「星窓亭」の管理もしており、夏休みの間、美宇と与一たちに民宿として宿泊させてくれる事になる。"},{"spoiler":false,"text":"なお、高齢で授かった一人娘の茅を溺愛している模様。久しぶりに茅に友達が出来た事が嬉しいらしく、時たまに世話を焼きすぎて茅に嫌がられる事もある。"}],"source":"egs","sourceCharacterId":"6396","sourceWorkId":"21797","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"175 cm","valueContext":null,"source":"egs","sourceCharacterId":"6396","sourceWorkId":"21797","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/