acterIds":["6391"]},"originalCharacterName":"楢原 あやめ","characterNameSource":null,"role":"4","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"2/6"},"bloodType":{"reviewState":"source-only","source":"egs","value":"O"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"与一のクラスメイト。明るい性格で、周囲の誰からも信頼される人気者。"},{"spoiler":false,"text":"ロケットにはさっぱり興味がないが、世話焼きで周囲から浮きがちな与一を色々サポートしてくれる。"},{"spoiler":false,"text":"父親は実家で診療所を開いており、夏休みの間は手伝いのために里帰りをしている。"}],"source":"egs","sourceCharacterId":"6391","sourceWorkId":"21797","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a46c0be0d1a9fcff42c4703bd4631e01b7708aa54eb0631219dc59602e0600a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b0d4a656e095aebf77ccf92a262f4b7b187f52bb3099a83eab6dbb0726b381b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_egs_6392","characterName":"梶原 しのぶ","sourceIds":{"egsCharacterIds":["6392"]},"originalCharacterName":"梶原 しのぶ","characterNameSource":null,"role":"4","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"10/25"},"bloodType":{"reviewState":"source-only","source":"egs","value":"AB"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"与一たちの保護者にして、クラスの担任教師。専攻は物理。"},{"spoiler":false,"text":"理系らしからぬ自由奔放な性格で、趣味はサーフィン。"},{"spoiler":false,"text":"戦前は防衛技術研究所の研究者として活動していたらしいがその素性は不明。美宇の母親、克波と親交があったらしい。"},{"spoiler":false,"text":"その縁で両親を亡くした美宇たちの後見人になる。"},{"spoiler":false,"text":"戦時中の負傷のために、普段は左手に手袋をしている。"},{"spoiler":false,"text":"美宇たちには母親と同じ道をたどってほしくないとロケット作りに反対するが、もう一人の後見人からの手紙により、"},{"spoiler":false,"text":"姉弟と一緒に種子島へ行くことを決意する。"}],"source":"egs","sourceCharacterId":"6392","sourceWorkId":"21797","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b12cf599642237f524a4aa0600d638906cc37118d39347ce616ce4aeb9f60faf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c13d0b6f78c1897cf55188acac0dea96d8d1e8a28ef67cc62991268f5b30ff9.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_egs_6393","characterName":"中原 巴","sourceIds":{"egsCharacterIds":["6393"]},"originalCharacterName":"中原 巴","characterNameSource":null,"role":"4","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"不明"},"bloodType":{"reviewState":"source-only","source":"egs","value":"不明"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本の宇宙研究機関「AVSA」所長である木曽義行の秘書。"},{"spoiler":false,"text":"秘書という肩書だが、優柔不断な義行に代わって重要案件を決定する事も多く、"},{"spoiler":false,"text":"実質的にAVSAのナンバー2的ポジションにいる。"},{"spoiler":false,"text":"また、与一たちの「サマースクール」では財務や技術サポートをしてくれる。"},{"spoiler":false,"text":"見た目は少女のような外見だが、実年齢は不明。"},{"spoiler":false,"text":"気が強く与一らと同年代のように見える時もあれば、一転やけに大人びた振る舞いもする。（与一談）"},{"spoiler":false,"text":"とある事故で体をケガしてたらしく、リハビリ用のステッキを携行している。"}],"source":"egs","sourceCharacterId":"6393","sourceWorkId":"21797","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69e26ff5bc16c0196278172db634bee0128c60245f45e9eb87dc739ee6ffecd6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b03fbb77ecb19922d6f296290067e30469712a7c914b1adf37bd6af4c426aa98.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"c