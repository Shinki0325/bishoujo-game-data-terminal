","name":"間島 淳司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29202","source":"vndb"}]},{"characterId":"char_c27185","characterName":"エリーゼ・バレッタ","sourceIds":{"bangumi":[],"egsCharacterIds":["13026"],"vndbCharacterId":"c27185"},"originalCharacterName":"エリーゼ・バレッタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヒューズの双子の妹。"},{"spoiler":false,"text":"兄をもり立て、兄が称賛されることを喜びとする。"},{"spoiler":false,"text":"職業は兄を後方より支援する魔法使い。"},{"spoiler":false,"text":"兄同様、長年による周囲との摩擦がその性格を素直じゃなくしている。"},{"spoiler":false,"text":"かなりのわがまま。"}],"source":"egs","sourceCharacterId":"13026","sourceWorkId":"4627","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1e57353cac02716af26607429f39b9c4d22bc8b4b0dbfa54c8b75f5dc507164.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bcedd643b2bb3aaee808ccd2b451f0e4b0f341bb9fc43f87d4507eed748b896.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"この かなみ","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29200","source":"vndb"}]},{"characterId":"char_c27186","characterName":"ベネット・コジュール","sourceIds":{"bangumi":[],"egsCharacterIds":["13027"],"vndbCharacterId":"c27186"},"originalCharacterName":"ベネット・コジュール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"光綾学園の学園長。"},{"spoiler":false,"text":"かつては舞弦学園で教鞭を執っており、魔法の腕はかなりのもの。"},{"spoiler":false,"text":"ときに厳しく時に優しく、学園の学生たちを見守る。"},{"spoiler":false,"text":"エルフであるためその外見は若々しい。"}],"source":"egs","sourceCharacterId":"13027","sourceWorkId":"4627","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84f0c50961dbfa54954088cd80f79c30b5f11122360ec409a7a660001790413b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f5a0c8a8e8efe1f3cf9e4558948973340dedd00515e9dd36a7ddfc8623a92ba.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"猫魅 愛","creatorId":"vndb:s938","sourcePersonId":"vndb:s938","canonicalEntityId":"vndb:s938","name":"勝生真沙子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29204","source":"vndb"}]},{"characterId":"char_c3781","characterName":"フィル・イハート","sourceIds":{"bangumi":[{"characterId":"11355","match":"exact-normalized-name-in-linked-work","subjectId":"11169"}],"egsCharacterIds":["13020"],"vndbCharacterId":"c3781"},"originalCharacterName":"フィル・イハート","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"With tan-like skin and her twin tail hairstyle trademark, she's a vigorous elf who desires to learn God's technique. She appears before Yuuki and states that she is \"Yuuki's fiance\". Her thoughts and feelings express themselves easily on her face and she frequently quarrels with Rina. She likes manga and sweet things."},{"spoiler":false,"text":"from AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c3781"},{"segments":[{"spoiler":false,"text":"小麦色の肌とツインテールの髪がトレードマーク。"},{"spoiler":false,"text":"元気いっぱいの神術士志望のエルフの少女。"},{"spoiler":false,"text":"転校してきたユウキの前に現れ「ユウキの婚約者」を自称する。"},{"spoiler":false,"text":"感情が顔に出やすく、思った事はすぐ行動に移すタイプで、"},{"spoiler":false,"text":"リナとは衝突する事もしばしば。"},{"spoiler":false,"text":"マンガと甘いお菓子が好き。"}],"source":"egs","sourceCharacterId":"13020","sourceWorkId":"4627","spoiler":false},{"segments":[{"spoiler":false,"text":"特征是小麦色的肌肤与双马尾的发型。"},{"spoiler":false,"text":"志愿是神术士的朝气蓬勃的精灵少女。"},{"spoiler":false,"text":"出现在转校而来的ユウキ面前，自称是「ユウキ的未婚妻」。"},{"spoiler":false,"text":"胸无城府、想到就做的类型，时常与リナ起冲突。"},{"spoiler":false,"text":"喜欢漫画和甜食。"}],"source":"bangumi","sourceCharacterId":"11355"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8571fc438543757b3071db657e60391de039e26280be8cf86b220f5607e27d90.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/674ed93fffab3b9caec774f358e3aa9e2100c264618160f664785438722a1876.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11532:11355:4832:1","source":"bangumi"}]},{"characterId":"char_c3785","characterName":"斎香・Ｓ・ファルネーゼ","sourceIds":{"bangumi":[{"characterId":"11353","match":"exact-normalized-name-in-linked-work","subjectId":"11169"}],"egsCharacterIds":["13018"],"vndbCharacterId":"c3785"},"originalCharacterName":"斎香・Ｓ・ファルネーゼ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Falneze, a first grade meister, whose name is the most famous weapon maker in the Rubens continent. Like Yuuki, she was a student of Falneze AS, and Yuuki idolized her in secret. She is also transferred to Kōryō Academy although the reasons for her transfer are unknown. She is a top student and is experienced in the use of swords but has no common sense when it comes to the social aspect of the world. This causes various comical situations."},{"spoiler":false,"text":"from AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c3785"},{"segments":[{"spoiler":false,"text":"大陸一の武器メーカー「ファルネーゼ」の一人娘。"},{"spoiler":false,"text":"元ファルネーゼＡＳの学生で、ユウキが密かに憧れていた先輩。"},{"spoiler":false,"text":"ある日突然ファルネーゼを退学し消息不明になっていたが、"},{"spoiler":false,"text":"何故か光綾学園で復学しており、ユウキと再会する。"},{"spoiler":false,"text":"剣技に長け、立ち居振る舞いは上品にして優雅。"},{"spoiler":false,"text":"反面、社会常識に疎い所が（かなり）あり、"},{"spoiler":false,"text":"悪意のないナツミの口車に乗せられる事もしばしば。"}],"source":"egs","sourceCharacterId":"13018","sourceWorkId":"4627","spoiler":false},{"segments":[{"spoiler":false,"text":"大陆首屈一指的武器制作商『ファルネーゼ』的独生女。"},{"spoiler":false,"text":"原ファルネーゼAS的学生，ユウキ暗恋的前辈。"},{"spoiler":false,"text":"某日突然退学，之后下落不明，然而不知为何于光绫学园复学，和ユウキ再会。"},{"spoiler":false,"text":"擅长剑技，举止高贵而优雅。"},{"spoiler":false,"text":"但在另一面，（相当地）不懂社会常识，经常会被ナツミ没有恶意的花言巧语所骗。"}],"source":"bangumi","sourceCharacterId":"11353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e146f3e96aa85b9292e733983939899c88a88645b02609263bb23e413ecdb17d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e27e1eacbc581f6d3ef8f2c898b78ba291bb6ff52bcd256df5979e2b784b8bf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11532:11353:4675:1","source":"bangumi"}]},{"characterId":"char_vndb_c27181","characterName":"光岡 くおん","sourceIds":{"vndbCharacterId":"c27181"},"originalCharacterName":"光岡 くおん","characterNameSource":null,"role":"side","status":"source-only-candidate","identi