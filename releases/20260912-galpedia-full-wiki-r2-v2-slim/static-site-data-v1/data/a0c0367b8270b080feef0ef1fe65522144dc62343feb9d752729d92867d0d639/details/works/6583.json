{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6583","model":{"presentationWorkId":"vndb:v4758","staff":{"artwork":[{"creditedName":"おにぎりくん(ONIX)","creatorId":"vndb:s703","sourcePersonId":"egs:creator:956","canonicalEntityId":"vndb:s703","name":"おにぎりくん(ONIX)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16522","source":"egs"}],"scenario":[{"creditedName":"HIRO","creatorId":"vndb:s688","sourcePersonId":"egs:creator:969","canonicalEntityId":"vndb:s688","name":"HIRO","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:41901","source":"egs"}],"music":[{"creditedName":"Shade","creatorId":"vndb:s511","sourcePersonId":"egs:creator:957","canonicalEntityId":"vndb:s511","name":"Shade","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16523","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c27174","characterName":"ルーシー・ミンシアード","sourceIds":{"bangumi":[{"characterId":"11354","match":"exact-normalized-name-in-linked-work","subjectId":"11169"}],"egsCharacterIds":["13019"],"vndbCharacterId":"c27174"},"originalCharacterName":"ルーシー・ミンシアード","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An elf who wishes to be a scout and Yuuki's benefactor(?). She and her black cat companion Nii-san go and collect lucky items everyday, though her luck seems to be bad which in turn creates minor problems. The reason as to why she collects them is unclear. She keeps little distance away from humans due her being unsociable, her pace of speech and behavior."},{"spoiler":false,"text":"From AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c27174"},{"segments":[{"spoiler":false,"text":"スカウト志望のエルフの少女で、ユウキの恩人（？）。"},{"spoiler":false,"text":"黒ネコのニィさんとともに、日々ラッキーアイテムを収集しているが、"},{"spoiler":false,"text":"行動に反して本人の運は悪い。"},{"spoiler":false,"text":"収集の理由は不明。"},{"spoiler":false,"text":"無愛想でマイペースな言動のため、"},{"spoiler":false,"text":"周囲の人間からは、やや距離を置かれている。"}],"source":"egs","sourceCharacterId":"13019","sourceWorkId":"4627","spoiler":false},{"segments":[{"spoiler":false,"text":"志愿是Scout（盗术士）的精灵少女，ユウキ的恩人（？）。"},{"spoiler":false,"text":"和黑猫ニィ小姐一起，天天收集着幸运道具，但与行动相反本人的运气很坏。收集的理由不明。"},{"spoiler":false,"text":"因为言行冷淡特立独行的关系，有点被周围的人们敬而远之。"}],"source":"bangumi","sourceCharacterId":"11354"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e768b12d59ba543d5a863647f1a7efc54d5d1cf5ccc104d10e196a6fee8d529a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9eda3937ff13648881291ab7893060136847c29f8da1111f004a39b042608dbb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11532:11354:4830:1","source":"bangumi"}]},{"characterId":"char_c27175","characterName":"竜胆 リナ","sourceIds":{"bangumi":[{"characterId":"11352","match":"exact-normalized-name-in-linked-work","subjectId":"11169"}],"egsCharacterIds":["13017"],"vndbCharacterId":"c27175"},"originalCharacterName":"竜胆 リナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuki's childhood friend, whom Yuuki parts from to enter the Private Falneze AS, and met again as he is transferred to Kouryo Academy. As a novice magician, she yearns to become a world-renowned \"Teen idol Magician\". She is warmhearted, popular among friends but picky only to Yuuki."}],"source":"vndb","sourceCharacterId":"c27175"},{"segments":[{"spoiler":false,"text":"ユウキがラスタルに転校してきた初日に再会した、幼なじみの女の子。"},{"spoiler":false,"text":"魔法使い志望で、冒険者（兼アイドル）を目指している。"},{"spoiler":false,"text":"明るく、涙もろく、面倒見もよく、皆から慕われる性格なのだが、"},{"spoiler":false,"text":"ユウキにはなにかと口うるさい。"},{"spoiler":false,"text":"冒険者、竜胆沙耶（さや）を姉に持つ。実家はソバ屋。"}],"source":"egs","sourceCharacterId":"13017","sourceWorkId":"4627","spoiler":false},{"segments":[{"spoiler":false,"text":"ユウキ于来到ラスタル王国的首日再会的青梅竹马的女孩子。"},{"spoiler":false,"text":"志愿是魔法使，以成为冒险者（兼偶像）为目标。"},{"spoiler":false,"text":"开朗、爱掉泪、会关照人、性格讨人喜欢，不过对ユウキ则是说这说那很啰嗦。"},{"spoiler":false,"text":"有一个身为冒险者的姐姐竜胆沙耶（さや）。老家是荞面条铺。"}],"source":"bangumi","sourceCharacterId":"11352"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f27e3a14b4294bffb30d8e89eceafbd60366e2b9e8d1efdfd02b7110e89d7963.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6f88042cf377ae61c6a54220e1c0f2b7c82dd1a2f73a53f5ea604da349f3fdb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11532:11352:5020:1","source":"bangumi"}]},{"characterId":"char_c27177","characterName":"サワタリ","sourceIds":{"bangumi":[],"egsCharacterIds":["13021"],"vndbCharacterId":"c27177"},"originalCharacterName":"サワタリ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スカウト（盗術士）志望の男子で、ユウキのクラスメート。"},{"spoiler":false,"text":"フルネームは本人も言ってる通り、内緒。"},{"spoiler":false,"text":"忍者にかぶれており、普段着から忍びの着こなしを身に纏う。"},{"spoiler":false,"text":"転校してきたばかりのユウキと意気投合し友人になる。"},{"spoiler":false,"text":"スケベで美人に弱く、何をしてもだいたい３枚目になるけど、"},{"spoiler":false,"text":"やるときゃやるぜ。"}],"source":"egs","sourceCharacterId":"13021","sourceWorkId":"4627","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f43e5d2768b509e903fafb21fdd84dd1053f06fab46ea4f83cbdf092de7f212d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6efa7bc686b6753e70e6a76bc88206b068d6e5572ab8160e32dee9cb365b74ea.webp","width":235,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c27178","characterName":"シルビア・コール","sourceIds":{"bangumi":[],"egsCharacterIds":["13022"],"vndbCharacterId":"c27178"},"originalCharacterName":"シルビア・コール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔法使い志望の女子で、ユウキたちの所属クラス3-Bの委員長。"},{"spoiler":false,"text":"生真面目で融通が効かない性格のため何かと気苦労が多い。"},{"spoiler":false,"text":"多くのクラスメイトに「委員長」の愛称で呼ばれる。"},{"spoiler":false,"text":"倹約家で貧乏性の眼鏡っ子。"}],"source":"egs","sourceCharacterId":"13022","sourceWorkId":"4627","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9280a377313f75f0908035d95f6ca3cbb1104c972ebe9eaae3b115033863afcf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf8df2c99642bdc461b93d94ec8eaa1b5a465b7f3a89274cb4374678194342ae.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c27179","characterName":"ナツミ・キャメロン","sourceIds":{"bangumi":[],"egsCharacterIds":["13023"],"vndbCharacterId":"c27179"},"originalCharacterName":"ナツミ・キャメロン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スカウト志望の女子で、ユウキのクラスメート。"},{"spoiler":false,"text":"常日頃からニュースと事件を追い求めている。"},{"spoiler":false,"text":"いつもカメラを持ち歩き情報収集に余念がないが、"},{"spoiler":false,"text":"そのほとんどが先走った報道なので、周囲は迷惑する事もしばしば。"},{"spoiler":false,"text":"明るく元気で、多少の事ではめげない。へこたれない。"},{"spoiler":false,"text":"口癖は「なのさ」。"}],"source":"egs","sourceCharacterId":"13023","sourceWorkId":"4627","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80d981f89a02eb4d20c391c895a4caa84185ad4d66ad96ea09d5243bf3280b68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f7a5aba1afcf3a9e9f64d43755c5c9c350599ba16f4c8aa11af11604a044975.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"AYA","creatorId":"vndb:s662","sourcePersonId":"vndb:s662","canonicalEntityId":"vndb:s662","name":"茂呂田 かおる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29201","source":"vndb"}]},{"characterId":"char_c27180","characterName":"鈴木 ぼたん","sourceIds":{"bangumi":[],"egsCharacterIds":["13024"],"vndbCharacterId":"c27180"},"originalCharacterName":"鈴木 ぼたん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冒険者を目指す傍ら、マンガ同人誌を作っていて腕前はかなりのもの。"},{"spoiler":false,"text":"ジャンルは何でもこなすが、主に歴史系ボーイズラブを好む。"},{"spoiler":false,"text":"付けてる耳はアクセサリ。苗字で呼ばれる事には少々抵抗があるようだ。"}],"source":"egs","sourceCharacterId":"13024","sourceWorkId":"4627","spoiler":false}],"profileFacts":[],"met