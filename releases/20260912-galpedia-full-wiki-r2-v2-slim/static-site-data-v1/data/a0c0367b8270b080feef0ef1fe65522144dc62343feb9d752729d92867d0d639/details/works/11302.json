ntityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the son of the heir to a wealthy local family. He grew up without any problems, but he became tired of his relationship with his father and entered a boarding school."},{"spoiler":false,"text":"He never returned home, even on vacations, but after his father's death, he returns to his mansion for the first time in several years."},{"spoiler":false,"text":"Shaken by various temptations, he is tossed about by the waves of fate."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c21561"},{"segments":[{"spoiler":false,"text":"地方の資産家の跡取り息子。"},{"spoiler":false,"text":"なに不自由なく育ってきたが、父との関係に嫌気が差し全寮制の学園に入る。"},{"spoiler":false,"text":"休みであろうと帰省しなかったが、父の死により数年ぶりに屋敷へ戻ることとなる。"},{"spoiler":false,"text":"様々な誘惑に揺らぎながら、運命の波に翻弄されることに……。"}],"source":"bangumi","sourceCharacterId":"90445"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9be53e57af3393fcb91718e8722ca08978af5e562b0f58f7b54ab6e8f9b20a28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c479be921dc12a190e079472ffa7d891cf06cec1ebf4c62b64588e9a3ebad14.webp","width":228,"height":152,"source":"static-detail"},"actors":[]},{"characterId":"char_c21562","characterName":"桐生 雛姫","sourceIds":{"bangumi":[{"characterId":"90444","match":"exact-normalized-name-in-linked-work","subjectId":"268527"}],"egsCharacterIds":["487"],"vndbCharacterId":"c21562"},"originalCharacterName":"桐生 雛姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the younger sister of the main character. Growing up she would always fight her older sister Yuzuha over their brother."},{"spoiler":false,"text":"However, when the protagonist returns home, she treats him coldly and urges him to leave home as soon as possible."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c21562"},{"segments":[{"spoiler":false,"text":"3つ下の妹。"},{"spoiler":false,"text":"幼いころはお兄ちゃん子で、姉「柚葉」と主人公の取り合いなどを演じていたが、"},{"spoiler":false,"text":"帰省した主人公に対しては昔と異なり、冷たく当たり、早く家を出て行くよう促す。"}],"source":"egs","sourceCharacterId":"487","sourceWorkId":"11302","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の3つ下の妹。"},{"spoiler":false,"text":"幼い頃はお兄ちゃん子で、姉の柚葉と主人公の取り合いをしていた。"},{"spoiler":false,"text":"だが帰省した主人公に対しては冷たく当たり、早く家を出て行くよう促してくる。"}],"source":"bangumi","sourceCharacterId":"90444"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"487","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"487","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"487","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"487","sourceWorkId":"11302","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f39b4eafe9e300b6fa3aa1541cf956406464524d2fe1a8dc51e9ac4b10259801.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52e6c25cb9a3a86053ba02c614f05d69f5c1f42bc447fe30ce50769c7f77d612.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真木碧","creatorId":"vndb:s2000","sourcePersonId":"vndb:s2000","canonicalEntityId":"vndb:s2000","name":"真木 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268527:90444:6130:1","source":"bangumi"}]},{"characterId":"char_c54364","characterName":"桐生 麗香","sourceIds":{"bangumi":[{"characterId":"90441","match":"exact-normalized-name-in-linked-work","subjectId":"268527"}],"egsCharacterIds":["484"],"vndbCharacterId":"c54364"},"originalCharacterName":"桐生 麗香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bewitching and ageless widow. The mother of the protagonist. She is the current acting head of the family and no one can stand against her."},{"spoiler":false,"text":"The protagonist has few memories of his mother, and although she is his mother, he feels somewhat bitter toward her."},{"spoiler":false,"text":"She appoints the protagonist as the next head of the family and instructs him to stay in the area."},{"spoiler":true,"text":"Reika is actually Hayato's grandmother. As a demon living on Earth she cannot survive long outside hell. In order to continue living on Earth she feeds on the energy of other demons but since there are none she came up with a plan to have her children inbreed for many generations to keep their demon blood strong for her to survive on."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c54364"},{"segments":[{"spoiler":false,"text":"妖艶で年齢不詳の美人。現在の一族の当主代行であり、だれも彼女に逆らうことは出来ない。"},{"spoiler":false,"text":"主人公にはほとんど母との思い出が無く、母親ながらやや苦手に感じている。"},{"spoiler":false,"text":"主人公を次期当主に任命し、この地に留まるよう指示する。"},{"spoiler":false,"text":"目的ために手段を選ばないタイプ。"}],"source":"egs","sourceCharacterId":"484","sourceWorkId":"11302","spoiler":false},{"segments":[{"spoiler":false,"text":"妖艶で年齢不詳の未亡人。主人公の母親。"},{"spoiler":false,"text":"現在の一族の当主代行であり、だれも彼女に逆らうことはできない。"},{"spoiler":false,"text":"主人公には母との思い出がほとんどなく、母親ながら、やや苦手に感じている。"},{"spoiler":false,"text":"主人公を次期当主に任命し、この地に留まるよう指示する。"}],"source":"bangumi","sourceCharacterId":"90441"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"484","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"484","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"484","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"484","sourceWorkId":"11302","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fc862cbc09aa447cbb2f0ab85292844a9422a7a7916efe62a6f25978a4917a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd7b121f1b477e998bbcf8695db67c02b4a75d8926345b8d2b707fbf0f797bc0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"若泉絵子","creatorId":"vndb:s1099","sourcePersonId":"vndb:s1099","canonicalEntityId":"vndb:s1099","name":"若泉 絵子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268527:90441:25167:1","source":"bangumi"}]},{"characterId":"char_c54365","characterName":"桐生 静恵","sourceIds":{"bangumi":[{"characterId":"90442","match":"exact-normalized-name-in-linked-work","subjectId":"268527"}],"egsCharacterIds":["485"],"vndbCharacterId":"c54365"},"originalCharacterName":"桐生 静恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The sister of the protagonist's father, she is a single but motherly woman. She always has a somewhat fragile smile on her face."},{"spoiler":false,"text":"She is more like a mother to the protagonist than his mother, having cared for him since he was a child. For some reason, she tries to keep her distance from the protagonist, who has returned home."},{"spoiler":false,"text":"She feels estranged from her family's fate and hopes that the protagonist will be able to break through it."},{"spoiler":true,"text":"She is actually Hayato, Yuzuha, and Hinaki's mother. She married her own father and had children with him. She doesn't like what her mother Reika is planning, to have Hayato take the place of his father and make more inbred children for Reika to survive on but there isn't much she can do against her."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c54365"},{"segments":[{"spoiler":false,"text":"父の妹で、独身ながら母性溢れる存在。"},{"spoiler":false,"text":"つねに、どこか儚い笑顔を浮かべている。"},{"spoiler":false,"text":"子供時代から慈しんでくれた、主人公にとって冷たい母親よりも母親らしい存在。"},{"spoiler":false,"text":"帰ってきた主人公とはなぜか距離をおこうとしている。"},{"spoiler":false,"text":"一族の業を疎ましく思い、主人公がそれを打破してくれることを期待している。"}],"source":"egs","sourceCharacterId":"485","sourceWorkId":"11302","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の父の妹で、独身ながら母性あふれる女性。"},{"spoiler":false,"text":"常にどこか儚い笑顔を浮かべている。"},{"spoiler":false,"text":"子供の頃から慈しんでくれた、主人公にとって母親よりも母親らしい存在。"},{"spoiler":false,"text":"帰ってきた主人公とは、なぜか距離を置こうとしている。"},{"spoiler":false,"text":"一族の業を疎ましく思い、主人公がそれを打破してくれることを期待している。"}],"source":"bangumi","sourceCharacterId":"90442"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"485","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"485","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"485","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"485","sourceWorkId":"11302","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5484a9a8813a8c085c11b67d2357f20222c677439af22c702c8606b1b8646ab6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bd46ffce1830215d1b531014aa4f6ddb86aba96258beec3b4bd2f29dc0cfe90.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木川絵理子","creatorId":"vndb:s1634","sourcePersonId":"vndb:s1634","canonicalEntityId":"vndb:s1634","name":"木川 絵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268527:90442:4668:1","source":"bangumi"}]},{"characterId":"char_c54366","characterName":"桐生 柚葉","sourceIds":{"bangumi":[{"characterId":"90443","match":"exact-normalized-name-in-linked-work","subjectId":"268527"}],"egsCharacterIds":["486"],"vndbCharacterId":"c54366"},"originalCharacterName":"桐生 柚葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is three years older than the main character. She has always loved him dearly and kept in touch with him through letters and other correspondence while they were apart."},{"spoiler":false,"text":"She never leaves the protagonist's side when he returns, and takes excessive care of him, such as sleeping with him and washing his back in the bathtub."},{"spoiler":false,"text":"In fact, she is very possessive."},{"spoiler":true,"text":"She killed her own father who attempted to rape her. She has always planned on giving her virginity to the protagonist and nothing will stop her in doing that."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c54366"},{"segments":[{"spoiler":false,"text":"３つ年上の姉。"},{"spoiler":false,"text":"昔から主人公を溺愛しており、離れていた間も手紙などでずっと連絡を取っていた。"},{"spoiler":false,"text":"それは添い寝や風呂場での背中流しなど過剰なほど。"},{"spoiler":false,"text":"実は独占欲が強い。"}],"source":"egs","sourceCharacterId":"486","sourceWorkId":"11302","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公より3つ年上の姉。"},{"spoiler":false,"text":"昔から主人公を溺愛しており、離れていた間も手紙などでずっと連絡を取っていた。"},{"spoiler":false,"text":"帰ってきた主人公の側を片時も離れず、添い寝や風呂場で背中を流すなど、過剰なまでに世話を焼く。"},{"spoiler":false,"text":"実は独占欲が強い"}],"source":"bangumi","sourceCharacterId":"90443"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"486","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"486","sourceWorkId":"11302","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueCont