elationId":"vndb:vn-staff:214110","source":"vndb"},{"creditedName":"斉藤 あさみ","creatorId":"vndb:s19100","sourcePersonId":"vndb:s19100","canonicalEntityId":"vndb:s19100","name":"斉藤あさみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:214112","source":"vndb"},{"creditedName":"関 真央","creatorId":"vndb:s23242","sourcePersonId":"vndb:s23242","canonicalEntityId":"vndb:s23242","name":"関 真央","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:214113","source":"vndb"},{"creditedName":"吉田 ミサ","creatorId":"vndb:s23633","sourcePersonId":"vndb:s23633","canonicalEntityId":"vndb:s23633","name":"吉田 ミサ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:214114","source":"vndb"},{"creditedName":"櫻井ノエル","creatorId":"vndb:s39384","sourcePersonId":"vndb:s39384","canonicalEntityId":"vndb:s39384","name":"櫻井ノエル","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:214115","source":"vndb"},{"creditedName":"田中 清志","creatorId":"vndb:s11262","sourcePersonId":"vndb:s11262","canonicalEntityId":"vndb:s11262","name":"鞠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:214116","source":"vndb"},{"creditedName":"HAGANE","creatorId":"vndb:s47391","sourcePersonId":"vndb:s47391","canonicalEntityId":"vndb:s47391","name":"HAGANE","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:214118","source":"vndb"},{"creditedName":"Sakura","creatorId":"vndb:s47393","sourcePersonId":"vndb:s47393","canonicalEntityId":"vndb:s47393","name":"よしださくら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:214120","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c149422","characterName":"ソフィア","sourceIds":{"vndbCharacterId":"c149422"},"originalCharacterName":"ソフィア","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You're wrong. I'm not taking you all along. We're going together.\""},{"spoiler":false,"text":"The 17th Jeanne d’Arc."},{"spoiler":false,"text":"A young woman fated to save the nation of Exlattle, yet secretly wishing to free herself from the title of “saint.” Bold, self-assured, and unafraid of danger, she is far removed from the image of a pious or innocent holy maiden."},{"spoiler":false,"text":"When it comes to romance, once she recognizes her feelings, she pursues them with unwavering determination—though beneath her fearless attitude lies a complete novice in matters of love."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c149422"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c43f559969cc1e7087bb987f565ca2b0c512ee5a49efdecbe8b1a5e0d4bb874e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d76c29a1a130d2f30734befd0850abafd0df862f620136f409b79713c5cb0f58.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c149423","characterName":"リーズ・ルネ・シャナ","sourceIds":{"vndbCharacterId":"c149423"},"originalCharacterName":"リーズ・ルネ・シャナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Shall we go, my Jeanne d'Arc? To protect the people from suffering.\""},{"spoiler":false,"text":"The protagonist’s childhood friend, raised in a family that has served the Jeanne d’Arc lineage for generations."},{"spoiler":false,"text":"A gentle young man overflowing with kindness and compassion, blessed with striking good looks. Though his role as a squire is to protect the heroine, she is far stronger—both physically and mentally—leaving him more often the one being protected instead."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c149423"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b49ae90dd6ab659aa615035462315492b466f4e2c920e4adee5253ca658e655.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0226a841e8050394427fc5a3c7871b03565a12c0f9f5f201d04975e118e4bdb7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内田 雄馬","creatorId":"vndb:s11606","sourcePersonId":"vndb:s11606","canonicalEntityId":"vndb:s11606","name":"内田雄馬","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99880","source":"vndb"}]},{"characterId":"char_vndb_c149480","characterName":"レクス・ド・クラーシェル","sourceIds":{"vndbCharacterId":"c149480"},"originalCharacterName":"レクス・ド・クラーシェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I, Rex de Couraciel shall be the blade that clears your path!\""},{"spoiler":false,"text":"A knight of the Exlattle Order."},{"spoiler":false,"text":"With his fresh, striking looks, courteous manners, and strong sense of duty, he could easily be called the ideal knight at first glance."},{"spoiler":false,"text":"Yet when it comes to protecting the lives of the people, he will stop at nothing—even employing methods that stray far from the code of chivalry."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c149480"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c06ca3ac03412c4b6e384f84e9b1b18d532e4bf304df8c799ad8dab0a9627de6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef7af22c0bb10e216df3f699b9833bf4b66d2454fba5067973465162d6f68d63.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浦和希","creatorId":"vndb:s25595","sourcePersonId":"vndb:s25595","canonicalEntityId":"vndb:s25595","name":"浦和希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99883","source":"vndb"}]},{"characterId":"char_vndb_c149481","characterName":"ヴァーデス","sourceIds":{"vndbCharacterId":"c149481"},"originalCharacterName":"ヴァーデス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm proud to say I'm even more devoted to women's lives.\""},{"spoiler":false,"text":"A priest of the Holy Order, devoted to the Five Pillars."},{"spoiler":false,"text":"Though his duty is to serve the Order, he often prioritizes protecting women’s lives and well-being, giving him an impression of being carefree—or even flirtatious."},{"spoiler":false,"text":"In truth, he is a hard-working soul constantly being swept along by Jeanne and her companions."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c149481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adc0840395ec573cb59300af3b29108fdc2244215aed7478bea8607c00082c35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/415083b32d596dfaa5963e515d71d6c426445d84be09c5dae3d0890783478a1a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山下 誠一郎","creatorId":"vndb:s4901","sourcePersonId":"vndb:s4901","canonicalEntityId":"vndb:s4901","name":"山下 誠一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99877","source":"vndb"}]},{"characterId":"char_vndb_c149482","characterName":"フラトニス・ライラプス","sourceIds":{"vndbCharacterId":"c149482"},"originalCharacterName":"フラトニス・ライラプス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"No doubt you came to this world as a mighty saintess to meet me!\""},{"spoiler":false,"text":"A knight from the rival nation of Regenerate, ranked among the very strongest."},{"spoiler":false,"text":"He prefers straightforward expressions of emotion and has little patience for anything indirect."},{"spoiler":false,"text":"After challenging the heroine to a head-to-head duel, he was instantly captivated by her beauty and strength—and has since pursued her with relentless determination."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c149482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86914f35c7b7093bd5e3575d6fff94931cbf62e120bec5e04b8194b7962fd2fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/641390e3c3fefda0d7a811ba735b6f1b529c014269f4d4a759c96aad04d1dd00.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野島 健児","creatorId":"vndb:s380","sourcePersonId":"vndb:s380","canonicalEntityId":"vndb:s380","name":"野島 健児","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99875","source":"vndb"}]},{"characterId":"char_vndb_c149483","characterName":"クロノール","sourceIds":{"vndbCharacterId":"c149483"},"originalCharacterName":"クロノール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"32"},"height":{"reviewState":"source-only","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Fools. How stupid to trust such a phony saintess\""},{"spoiler":false,"text":"A young gunslinger who has traveled far and wide as a mercenary, belonging to no nation."},{"spoiler":false,"text":"A true lone wolf—stubborn, blunt, sharp-tongued, and cynical—he despises being treated like a subordinate by anyone."},{"spoiler":false,"text":"Though he speaks his mind without hesitation, he possesses a calm, discerning perspective beneath his rough exterior."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c149483"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7915c08256171eea4af18c60f3a54841d33381eceb243e901cdc7c3abe2eca4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/174817a1b42726096153e5f0cfa450ba32923ce5ff675075f05ce6896b27932f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古川 慎","creatorId":"vndb:s7848","sourcePersonId":"vndb:s7848","canonicalEntityId":"vndb:s7848","name":"古川 慎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99879","source":"vndb"}]},{"characterId":"char_vndb_c157337","characterName":"God","sourceIds":{"vndbCharacterId":"c157337"},"originalCharacterName":"God","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Behold, God has descended! Show some proper respect and give a big round of applause!\""},{"spoiler":false,"text":"A self-proclaimed “God” who has bestowed blessings upon every Jeanne d’Arc throughout history."},{"spoiler":false,"text":"Careless at his duties and hopelessly unreliable in critical moments, he is, in short, a lovable klutz. Contrary to his lofty title, he is cheerful, easygoing, and playful."},{"spoiler":false,"text":"He has watched over the heroine since childhood, appearing in her dreams and offering advice that is often more confusing than helpful. He is also the very one who placed the “Chains of Love” upon her."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c157337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f78706a75d1728bd0b332a064b8d79610e33cdcc7bee1fbae2da78d8c9fd095.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74f41da7908d7a555b6ca842dde94d239abb27033c36cc5b1097801b457f4e6f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶 裕貴","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99873","source":"vndb"}]},{"characterId":"char_vndb_c158709","characterName":"リビティナ","sourceIds":{"vndbCharacterId":"c158709"},"originalCharacterName":"リビティナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A witch who represents the organization Ooze, devoted to hunting down saints."},{"spoiler":false,"text":"She is a girl of few expressions, seemingly apathetic and detached. Opposes the heroine and her companions in her quest to create a world where witches—and the enemies of saints—can be acknowledged and accepted."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c158709"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65e447d0d4863bc2ea4529e3ac0c2727e2a4d4a5bb71f5559c6bf1225acb82ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84f712a47e7653889658f80a13ac39f2e569c7b6faf67e48f0ca5461e66f2763.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白石 晴香","creatorId":"vndb:s7593","sourcePersonId":"vndb:s7593","canonicalEntityId":"vndb:s7593","name":"白石 晴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99878","source":"vndb"}]},{"characterId":"char_vndb_c158710","characterName":"キャスパー","sourceIds":{"vndbCharacterId":"c158710"},"originalCharacterName":"キャスパー","ch