{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3270","model":{"presentationWorkId":"vndb:v10894","staff":{"artwork":[{"creditedName":"ゆうきあずさ","creatorId":"vndb:s8838","sourcePersonId":"egs:creator:2919","canonicalEntityId":"vndb:s8838","name":"ゆうきあずさ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:9267","source":"egs"}],"scenario":[{"creditedName":"ゆうきあずさ","creatorId":"vndb:s8838","sourcePersonId":"egs:creator:2919","canonicalEntityId":"vndb:s8838","name":"ゆうきあずさ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:9268","source":"egs"}],"music":[],"other":[{"creditedName":"ゆうき あずさ","creatorId":"vndb:s8838","sourcePersonId":"vndb:s8838","canonicalEntityId":"vndb:s8838","name":"ゆうき あずさ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:90983","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c20352","characterName":"アレクサンドル＝パストゥール","sourceIds":{"vndbCharacterId":"c20352"},"originalCharacterName":"アレクサンドル＝パストゥール","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alex is the first prince of Hell (Naraku), the elder twin born from the right red eye of the King of Hell. He is to fight Platina to the death over the succession of Naraku. He doesn't really know Platina and has a lot of conflict over having to fight, especially as he is initially weaker than his brother. He is a bit selfish with a short temper if he doesn't get his way, but behind this lies a deep and caring attitude."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c20352"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf435f7395ff5f23c802eee0edab11341aba4c67432ecc9ab29e22e2bce9c43b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfa323d7d6254034838b31ff54ea44002c03a3e63516f0f63f6a28317976deec.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城 元気","creatorId":"vndb:s487","sourcePersonId":"vndb:s487","canonicalEntityId":"vndb:s487","name":"高城 元気","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48344","source":"vndb"}]},{"characterId":"char_vndb_c20353","characterName":"プラチナ＝パストゥール","sourceIds":{"vndbCharacterId":"c20353"},"originalCharacterName":"プラチナ＝パストゥール","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Platina is the second prince of Hell (Naraku), the younger twin born from the left blue eye of the King of Hell. He is to fight Alex to the death over the succession of Naraku. He is initially stronger than Alex and seems to have no problems fighting to save his own life, but inside he still struggles with internal conflict about the battle for succession. He is a bit calm and cold, taking a rather serious stance towards things, but he really is concerned with doing the right thing."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c20353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c02de34ee83ddc707caa2002c3d2398f97e37c1fb229beea15b6e386a3629937.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5a387ec7ac1d303b3fea78fcfc1c0ef9e8ec663c9bbb3b83956232256ccd31f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木 千尋","creatorId":"vndb:s182","sourcePersonId":"vndb:s182","canonicalEntityId":"vndb:s182","name":"鈴木 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48342","source":"vndb"}]},{"characterId":"char_vndb_c28904","characterName":"サフィルス＝ホーソン","sourceIds":{"vndbCharacterId":"c28904"},"originalCharacterName":"サフィルス＝ホーソン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sapphirus (called Sapphi by Alex) is Alex's staff officer. He has a rather cheery disposition, playing the role of teacher and care-taker of Alex, and holds amazing patience with Alex's stubborn attitude. Since he is trying to help Alex win the battle of succession, he takes on a rather rival-like relationship with Jade, Platina's staff officer. However, there is more to Sapphirus than meets the eye..."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28904"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/031748d852884a8d69d24699bd0a242e9d95ce53d3ac17603d168b71e8c03522.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/973c62f5d390ce36ab1fc1da051988cf3a277a9da5882f4767f7c76276d5a5da.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"関 智一","creatorId":"vndb:s249","sourcePersonId":"vndb:s249","canonicalEntityId":"vndb:s249","name":"関智一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48343","source":"vndb"}]},{"characterId":"char_vndb_c28905","characterName":"ジェイド＝デイヴィス","sourceIds":{"vndbCharacterId":"c28905"},"originalCharacterName":"ジェイド＝デイヴィス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jade is Platina's staff officer. He has a more serious and intelligent demeanor, with a quick tongue that may offend people, but he doesn't care. He is Platina's care-taker, and is very devoted to him. Since he is trying to help Platina win the battle of succession, he takes on a rather rival-like relationship with Sapphirus, Alex's staff officer. However, there seems to be a mysterious side of Jade that is hiding something..."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c4317717281dbccc422a66906ee5b04f480bb99bb824372d6bea7cf9f04b039.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0417b2656d0ad726beccf4f7669169ff248f42df7066d550fca51b29f4344f2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森川 智之","creatorId":"vndb:s53","sourcePersonId":"vndb:s53","canonicalEntityId":"vndb:s53","name":"森川智之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48340","source":"vndb"}]},{"characterId":"char_vndb_c28906","characterName":"ルビイ＝ジャンクソン","sourceIds":{"vndbCharacterId":"c28906"},"originalCharacterName":"ルビイ＝ジャンクソン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ruby is a care-free chivalrous thief who is now a lone hunter against the angels. He acts rather fun and playful, speaking in the quick Kansai dialect, but also has a serious side, especially when it comes to his quest for revenge against Carrol, his half-brother, who he hates since Carrol betrayed his trust in the past and gave him the scar across his chest. He is a good friend with a sense of humor, but he is also a strong fighter. He either becomes an ally to Alex or Platina, and whichever side he chooses, Carrol will be on the opposite side."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28906"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8c39b100ccf5b33236d0f31050297b48129230c7d5d314ff64bfc7be74ce058.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/224d0d15f1ea85db04644ec60580e34338042b080bf35926ddbba643f5f25538.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川 英郎","creatorId":"vndb:s1533","sourcePersonId":"vndb:s1533","canonicalEntityId":"vndb:s1533","name":"石川 英郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48345","source":"vndb"}]},{"characterId":"char_vndb_c28907","characterName":"カロール＝マルテル","sourceIds":{"vndbCharacterId":"c28907"},"originalCharacterName":"カロール＝マルテル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Carrol is a half-angel priest who runs an orphanage for half-angel children. He is Ruby's half-brother, the son of an angel mother and Ruby's demon father. He holds a grudge against Ruby since Ruby's father left him and his mother, and Ruby got to experience a normal childhood that he never had being a half-angel, which eventually caused him to lash out against Ruby and give him the scar across his chest. He is very quiet and reserved, but has a short-temper hidden beneath. He either becomes an ally to Alex or Platina, and whichever side he chooses, Ruby will be on the opposite side."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28907"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fe8168b51af5e314f27727557562c75ea60438f1a46e2ba73cf04cef507509a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/523dabb845eeff51fa417fdbf081ebef743d3f1faa44127fd3433426f754ba2d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"保志 総一朗","creatorId":"vndb:s114","sourcePersonId":"vndb:s114","canonicalEntityId":"vndb:s114","name":"保志 総一朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48341","source":"vndb"}]},{"characterId":"char_vndb_c28912","characterName":"ライズ","sourceIds":{"vndbCharacterId":"c28912"},"originalCharacterName":"ライズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rize is a bounty hunter who works in the same group as Jade and Sapphirus. He starts to suspect that Sapphirus is a fallen angel and plans to do something about this..."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddcdf0b0b9fb5ac8a8711c2ecbd87d5ecd9ec9216e1bbfa8ccb9590ad5e10880.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3518a746c00c9b8ec5212f47ce31e38fdc8615de71946478e9409d93939b4846.webp","width":130,"height":150,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28913","characterName":"リタ","sourceIds":{"vndbCharacterId":"c28913"},"originalCharacterName":"リタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affectionately called \"sister\" (nee-san) by Ruby, Rita is a good friend of Ruby's. She works in the pub where Ruby acts as bouncer, and is in love with him, even though he does not share her feelings. When Carrol shows up, she helps to take care of him. A very pretty and caring individual, she ends up in a bad situation when the town is attacked by bandits..."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28913"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0064bb8cbd313ba4b14dab6e30129ecc276971e1b10ad8c65e782a592993f81.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/beac0f43c4e3ecb43161f70fcb2c65e4392d1b2820a3441a9b624ade2efc9ddd.webp","width":130,"height":150,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1063","sourceCompanyId":"egs:brand:669","canonicalEntityId":"vndb:p1063","name":"STACK software","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3270:669","source":"egs"},{"companyId":"vndb:p1063","sourceCompanyId":"vndb:p1063","canonicalEntityId":"vndb:p1063","name":"有限会社スタック","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:25951:v10894","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
