{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19475","model":{"presentationWorkId":"vndb:v13385","staff":{"artwork":[{"creditedName":"鬼MAYUGE","creatorId":"vndb:s2733","sourcePersonId":"egs:creator:6864","canonicalEntityId":"vndb:s2733","name":"鬼MAYUGE","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:124140","source":"egs"}],"scenario":[{"creditedName":"南条巴","creatorId":"vndb:s3163","sourcePersonId":"egs:creator:6715","canonicalEntityId":"vndb:s3163","name":"南条巴","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:124141","source":"egs"}],"music":[{"creditedName":"Arp","creatorId":"vndb:s3570","sourcePersonId":"egs:creator:13566","canonicalEntityId":"vndb:s3570","name":"Arp","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:128650","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c24161","characterName":"朱鷺田 栞","sourceIds":{"bangumi":[{"characterId":"22337","match":"exact-normalized-name-in-linked-work","subjectId":"85285"}],"egsCharacterIds":["2344"],"vndbCharacterId":"c24161"},"originalCharacterName":"朱鷺田 栞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"賢治と同い年だが、小柄で胸も小さく、少し幼く見える。"},{"spoiler":false,"text":"柔らかな長い髪をまとめて下の方でリボンでまとめて、右肩の前から胸元へ垂らしている。"},{"spoiler":false,"text":"目が大きいが表情には乏しく、西洋人形のように肌が白い。"},{"spoiler":false,"text":"司書服を着ていて、常に大きめの本を両手で胸に抱えている。"},{"spoiler":false,"text":"引っ込み思案で読書家。体が弱く、引き籠もりのような生活を長年送って来た。"},{"spoiler":false,"text":"本の登場人物達のように自分も友達が欲しい、恋もしたい。"},{"spoiler":false,"text":"けれど、実際に上手く他人と話すことができずに日々を過ごしている。"}],"source":"egs","sourceCharacterId":"2344","sourceWorkId":"19475","spoiler":false},{"segments":[{"spoiler":false,"text":"朱鹭田图书馆的图书馆员。"},{"spoiler":false,"text":"因为体弱所以没有上学，长年来都在自家与朱鹭田图书馆之间度过。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"引っ込み思案で読書家。 身体が弱く、引き籠もりのような生活を長年送ってきた。"},{"spoiler":false,"text":"本の登場人物たちのように自分も友達が欲しい、恋もしたい。"},{"spoiler":false,"text":"けれど実際には、上手く他人と話すことが出来ずに日々を過ごしている。"},{"spoiler":false,"text":"「人というのは、いつが最も美しいの……？」"}],"source":"bangumi","sourceCharacterId":"22337"}],"profileFacts":[{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"2344","sourceWorkId":"19475","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"2344","sourceWorkId":"19475","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"2344","sourceWorkId":"19475","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"2344","sourceWorkId":"19475","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ec000a5caaceead7e56e9efe6be439fb8cc4ae3434610b765474c2076839618.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2466b62e39fbff5658f1149fe554eb5969785502872275750afcd94eb304b47b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花 かのん","creatorId":"vndb:s3108","sourcePersonId":"vndb:s3108","canonicalEntityId":"vndb:s3108","name":"立花かのん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55110","source":"vndb"}]},{"characterId":"char_c24162","characterName":"如月 美智","sourceIds":{"bangumi":[{"characterId":"22338","match":"exact-normalized-name-in-linked-work","subjectId":"85285"}],"egsCharacterIds":["2345"],"vndbCharacterId":"c24162"},"originalCharacterName":"如月 美智","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"常に白衣を纏った大人の女性。"},{"spoiler":false,"text":"小鳥遊図書館では栞の仕事を手伝いもするが、基本的には医師として常駐している。"},{"spoiler":false,"text":"週に１度は街の総合病院で診察をしている。"},{"spoiler":false,"text":"常に栞の体調を気遣っており、少しでも顔色が優れないと過保護ともいえる処置を施す。"},{"spoiler":false,"text":"栞の住まいは図書館から数分の屋敷で、美智も侍医として同居している。"},{"spoiler":false,"text":"性格は、他人に対してはクールだが、それはあからさまに冷たいということではなく、礼儀や愛想をふんだんに利用しつつも距離を置く大人の対応。"},{"spoiler":false,"text":"賢治は栞に惹かれつつも、美智の大人の魅力に憧れてもいる。"}],"source":"egs","sourceCharacterId":"2345","sourceWorkId":"19475","spoiler":false},{"segments":[{"spoiler":false,"text":"在朱鹭田图书馆协助栞的工作，并以栞的专任医生的身份，固定在图书馆中工作。"},{"spoiler":false,"text":"很年轻就取得博士学位，从栞的小时候，栞的祖父就雇用她为专任医生。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"常に白衣を纏った大人の女性。"},{"spoiler":false,"text":"図書館で栞の仕事を手伝っているが、基本的には医師として常駐し、週に一度は街の総合病院で診察をしている。"},{"spoiler":false,"text":"性格はクールだが、礼儀や愛想をふんだんに利用しつつも距離を置く大人の対応。"},{"spoiler":false,"text":"常に栞の体調を気遣っており、少しでも顔色が優れないと過保護とも言える処置を施す。"},{"spoiler":false,"text":"栞の住まいは図書館から数分の屋敷で、美智も侍医として同居している。"},{"spoiler":false,"text":"賢治は栞に惹かれつつも、美智の大人の魅力に憧れてもいる。"},{"spoiler":false,"text":"「可愛い栞…… 大丈夫よ……」"}],"source":"bangumi","sourceCharacterId":"22338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63cffc4f17027fb0e5f083203b994fdf30744f3e7002ca5688a4793817d4396c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2db4df8bd0de90e75e70ca432dc5dd6a45447ba1078b812ca2131acbd01f5c2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小田切 みかん","creatorId":"vndb:s21212","sourcePersonId":"vndb:s21212","canonicalEntityId":"vndb:s21212","name":"小田切 みかん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55113","source":"vndb"}]},{"characterId":"char_c24163","characterName":"君島 エリカ","sourceIds":{"bangumi":[{"characterId":"22339","match":"exact-normalized-name-in-linked-work","subjectId":"85285"}],"egsCharacterIds":["2346"],"vndbCharacterId":"c24163"},"originalCharacterName":"君島 エリカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天真爛漫な賢治の同級生。"},{"spoiler":false,"text":"運動神経抜群なのに運動部の勧誘を足蹴にする賢治をカッコイイと思っており、彼女になりたいと願っている。"},{"spoiler":false,"text":"性格はグイグイで、クラスでも目立つタイプ。"},{"spoiler":false,"text":"成績は芳しくないが、幼馴染みで鈍臭い柚那を子分的に扱っている。"},{"spoiler":false,"text":"言うことは大抵、間違っているのだが、いつも自信たっぷりなので、賢治はゴリ押しで論破されることがある。"},{"spoiler":false,"text":"賢治が好きな物は何でも嫌うので、当然、栞のことも良く思っていない。"}],"source":"egs","sourceCharacterId":"2346","sourceWorkId":"19475","spoiler":false},{"segments":[{"spoiler":false,"text":"主角的同学，是个追求时髦的女高中生。"},{"spoiler":false,"text":"动手比动脑快的类型，会凭当下的直觉，不考虑后果地采取行动。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"天真爛漫な、賢治の同級生。"},{"spoiler":false,"text":"運動神経抜群なのに運動部の勧誘を足蹴にする賢治をカッコイイと思っており、彼女になりたいと願っている。"},{"spoiler":false,"text":"グイグイと押していく性格で、クラスでも目立つタイプ。"},{"spoiler":false,"text":"言うことは大抵間違っているのだが、いつも自信たっぷりなので、賢治はゴリ押しで論破されることがある。"},{"spoiler":false,"text":"賢治が好きな人は誰でも嫌うので、当然 栞のことも良く思っていない。"},{"spoiler":false,"text":"成績は芳しくないが、幼なじみで鈍臭い文系の柚那を子分のように扱っている。"},{"spoiler":false,"text":"「来てよ。 ずっと待ってたんだよ、アタシ」"}],"source":"bangumi","sourceCharacterId":"22339"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/509a00e55a32547025fa1a83d4195423661d0fcd5395188cdd8f4bff2086cf26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7703def26bb250b3993fbcb5794f8a43ad8bec5e41816e05092688cedc35a5fa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 いちか","creatorId":"vndb:s6114","sourcePersonId":"vndb:s6114","canonicalEntityId":"vndb:s6114","name":"後藤 いちか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55111","source":"vndb"}]},{"characterId":"char_c24164","characterName":"白木 柚那","sourceIds":{"bangumi":[{"characterId":"22340","match":"exact-normalized-name-in-linked-work","subjectId":"85285"}],"egsCharacterIds":["2347"],"vndbCharacterId":"c24164"},"originalCharacterName":"白木 柚那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"成績は良いが大人しくて鈍臭い、エリカの幼馴染み。"},{"spoiler":false,"text":"小さい頃からエリカの強引さには辟易していたが、イジメに遭わないために一緒にいる。"},{"spoiler":false,"text":"ド近眼のため、常にメガネをかけている。"},{"spoiler":false,"text":"自分の意志はあるが、強引に迫られると頷いてしまうタイプの少女。"},{"spoiler":false,"text":"頭が良く自己の意見を巧みに操れる美智に憧れ、小鳥遊図書館でもたまにアルバイトをしている。"}],"source":"egs","sourceCharacterId":"2347","sourceWorkId":"19475","spoiler":false},{"segments":[{"spoiler":false,"text":"主角的同学，跟永梨香是从小的闺密。"},{"spoiler":false,"text":"成绩优秀，但个性软弱，很不会拒绝人，不敢直率说出自己的想法。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"成績は良いがおとなしくて鈍臭い、エリカの幼なじみ。"},{"spoiler":false,"text":"自分の意志はあるが、強引に迫られると頷いてしまうタイプの少女。"},{"spoiler":false,"text":"ド近眼のため、常にメガネをかけている。"},{"spoiler":false,"text":"小さい頃からエリカの強引さには辟易していたが、イジメに遭わないために一緒にいる。"},{"spoiler":false,"text":"頭が良く自己の意見を巧みに操れる美智に憧れ、図書館でもたまにアルバイトをしている。"},{"spoiler":false,"text":"「い、痛ぁーーーっ！　や、やめて！　なに!?」"}],"source":"bangumi","sourceCharacterId":"22340"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccb154b087267c96a0b9316b58f5a02d06ec905740dc64c73f100acd9894f1a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d0d2d998814f27cc1ebaf93dcd0cbd2be9dd62760d286fe82225c517f8282a5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤 こより","creatorId":"vndb:s21213","sourcePersonId":"vndb:s21213","canonicalEntityId":"vndb:s21213","name":"藤 こより","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55114","source":"vndb"}]},{"characterId":"char_c24165","characterName":"遠藤 章子","sourceIds":{"bangumi":[{"characterId":"22341","match":"exact-normalized-name-in-linked-work","subjectId":"85285"}],"egsCharacterIds":["2348"],"vndbCharacterId":"c24165"},"originalCharacterName":"遠藤 章子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美智が週に１回外来を受け持つ病院のナース。"},{"spoiler":false,"text":"意外にワガママボディ。"},{"spoiler":false,"text":"かなりのドジッ子で、やることなすこと失敗ばかり。"},{"spoiler":false,"text":"美智の書いた処方箋の薬を届けに来て事件に巻き込まれる。"}],"source":"egs","sourceCharacterId":"2348","sourceWorkId":"19475","spoiler":false},{"segments":[{"spoiler":false,"text":"每周一次前来帮忙美智的护理师。"},{"spoiler":false,"text":"从她能够观察周围的气氛与用语中都能知道是十分体贴他人的个性，不过是个超夸张的迷煳蛋。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"美智が週に1回外来を受け持つ病院のナース。"},{"spoiler":false,"text":"意外にワガママボディ。 かなりのドジッ子で、やること成すこと失敗ばかり。"},{"spoiler":false,"text":"美智の書いた処方箋の薬を届けに来て、事件に巻き込まれる。"},{"spoiler":false,"text":"「えっ、やっ！　だ、駄目です中は！」"}],"source":"bangumi","sourceCharacterId":"22341"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/796a57548e8df11be927c788c06c06