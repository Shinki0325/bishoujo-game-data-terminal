{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33481","model":{"presentationWorkId":"vndb:v39861","staff":{"artwork":[{"creditedName":"ねこふじかおる","creatorId":"vndb:s21811","sourcePersonId":"egs:creator:25891","canonicalEntityId":"vndb:s21811","name":"ねこふじかおる","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:259084","source":"egs"}],"scenario":[{"creditedName":"ねこふじかおる","creatorId":"vndb:s21811","sourcePersonId":"egs:creator:25891","canonicalEntityId":"vndb:s21811","name":"ねこふじかおる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:259085","source":"egs"}],"music":[{"creditedName":"TAKASUKE","creatorId":"vndb:s36020","sourcePersonId":"egs:creator:40017","canonicalEntityId":"vndb:s36020","name":"TAKASUKE","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:284884","source":"egs"}],"other":[{"creditedName":"ねこふじかおる","creatorId":"vndb:s21811","sourcePersonId":"egs:creator:25891","canonicalEntityId":"vndb:s21811","name":"ねこふじかおる","detail":"企画、システム","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:284883","source":"egs"},{"creditedName":"ねこふじ かおる","creatorId":"vndb:s21811","sourcePersonId":"vndb:s21811","canonicalEntityId":"vndb:s21811","name":"CHARON","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:191162","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c119209","characterName":"時雨やどり","sourceIds":{"vndbCharacterId":"c119209"},"originalCharacterName":"時雨やどり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An honor student heroine who is perfect, smart and intelligent. She is popular in class and loved by everyone.....at least, that's the front she puts on."},{"spoiler":false,"text":"Deep down inside, she is filled with immeasurable possessiveness, a desire for approval, hideous hatred, and sheer jealousy. She shows this filthy inner self only to Amatarou, and binds him with any weakness she finds in him."},{"spoiler":false,"text":"She orders him to meet her behind the school on rainy days, and sometimes forces him to commit criminal and sexual acts."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c119209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d33a6db78daed962cef2c493e2b74de5687cf11a0617615f4043c04b5afef8d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a8b433827dc3b2dc7b8bace2896e5332a0cc998526875a1604134c228184030.webp","width":144,"height":256,"source":"static-detail"},"actors":[{"creditedName":"手塚 りょうこ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93550","source":"vndb"}]},{"characterId":"char_vndb_c119210","characterName":"睡蓮はすみ","sourceIds":{"vndbCharacterId":"c119210"},"originalCharacterName":"睡蓮はすみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a shy, plain girl who does not stand out much in class, but has a well-defined face."},{"spoiler":false,"text":"She works in the nightlife business to earn money for her family's living and medical expenses. She never shows it outside the house, but at home she has a tendency to be harsh towards her younger sister, Yomi."},{"spoiler":false,"text":"Since she has never been in love, she secretly falls in love with the protagonist, who is the first person outside of her family to need her."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c119210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a746a4a69302df61611d44a88b4ca6cbfbfc4c0f8f1e7f1bf08f6da5aec0b11a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d35058efdbf0b5d170d90a16495acfc675ee0293f993374ffd281412422c3cf9.webp","width":144,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野 七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93552","source":"vndb"}]},{"characterId":"char_vndb_c119211","characterName":"睡蓮よみ","sourceIds":{"vndbCharacterId":"c119211"},"originalCharacterName":"睡蓮よみ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hasumi's younger sister. She is quiet, lacking in self-confidence, and frequently abused by her older sister."},{"spoiler":false,"text":"Perhaps because of this trauma, she has become a girl who cannot speak very clearly. She loves her family, but she is always being yelled at for not being able to express her feelings well."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c119211"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d644327447f18dd4226592815d12fc21019a8b5404a9e0152fd185fa08474c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/590623023815f83055e061d92c493b1c87b0fdc9382b6608ae064cb01ceb328d.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真白 真雪","creatorId":"vndb:s25963","sourcePersonId":"vndb:s25963","canonicalEntityId":"vndb:s25963","name":"真白 真雪","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93553","source":"vndb"}]},{"characterId":"char_vndb_c119212","characterName":"高槻みちる","sourceIds":{"vndbCharacterId":"c119212"},"originalCharacterName":"高槻みちる","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character's ex-girlfriend. She is beautiful, pretty, charming, and always has an endless supply of men."},{"spoiler":false,"text":"She seems to be aware of this, too, and is always harsh in her criticisms and condescending to others."},{"spoiler":false,"text":"She is severely mentally ill, an attention seeker, and has an egoistic, self-centered side."},{"spoiler":false,"text":"She is unable to forgive those who betray her, and is harsh towards those she considers her enemies."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c119212"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be699b03ee6d02532db6e3e651b4dcb35df7365284b97830f6d84f8b8b8c8bbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72a4778db90d08058bea0486351efe7bd14b9d9c26a05ae7551880fb2737c6a7.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山田 じぇみ子","creatorId":"vndb:s8416","sourcePe