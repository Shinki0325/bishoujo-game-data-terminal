55","name":"CHARON","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:109141:v39861","source":"vndb"},{"companyId":"vndb:p4855","sourceCompanyId":"vndb:p4855","canonicalEntityId":"vndb:p4855","name":"CHARON","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:110482:v39861","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
