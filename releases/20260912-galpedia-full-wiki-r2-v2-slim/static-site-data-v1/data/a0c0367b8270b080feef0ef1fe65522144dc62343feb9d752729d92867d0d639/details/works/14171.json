characterId":"char_vndb_c76963","characterName":"ノノノ","sourceIds":{"vndbCharacterId":"c76963"},"originalCharacterName":"ノノノ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1018"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mysterious hostess who claims to be a time traveling agent from the future. In her own words, Nonono arrived at the present time for an important mission; which is as confidential as it is important, especially when asked for details surrounding it. She's undeniably a bit of an airhead. It looks like a part of her work involves finding the protagonist a perfect match, also..."},{"spoiler":true,"text":"Her real name is Nonono (ののの) just written differently."}],"source":"vndb","sourceCharacterId":"c76963"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf528af676cf4e3f713c7406bfc9897717cc266c236616933168f2849362150f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16839f64676220d3abfbd6e0094f0b687fb265b48821f8ac5866b29ad0692eff.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金元 寿子","creatorId":"vndb:s1769","sourcePersonId":"vndb:s1769","canonicalEntityId":"vndb:s1769","name":"金元 寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48797","source":"vndb"}]},{"characterId":"char_v