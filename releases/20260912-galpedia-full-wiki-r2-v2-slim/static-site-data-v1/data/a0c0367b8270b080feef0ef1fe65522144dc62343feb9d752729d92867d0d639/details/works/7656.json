{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7656","model":{"presentationWorkId":"vndb:v259","staff":{"artwork":[{"creditedName":"皇裕介(皇祐介)","creatorId":"vndb:s1982","sourcePersonId":"egs:creator:217","canonicalEntityId":"vndb:s1982","name":"皇裕介(皇祐介)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17739","source":"egs"}],"scenario":[{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"egs:creator:2171","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17740","source":"egs"}],"music":[{"creditedName":"武礼堂","creatorId":"vndb:s11707","sourcePersonId":"egs:creator:4049","canonicalEntityId":"vndb:s11707","name":"武礼堂","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:18785","source":"egs"}],"other":[{"creditedName":"皇 裕介","creatorId":"vndb:s1982","sourcePersonId":"vndb:s1982","canonicalEntityId":"vndb:s1982","name":"皇 裕介","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:7108","source":"vndb"},{"creditedName":"NATORI 烏賊","creatorId":"vndb:s1983","sourcePersonId":"vndb:s1983","canonicalEntityId":"vndb:s1983","name":"NATORI 烏賊","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:7110","source":"vndb"},{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"vndb:s2261","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:7112","source":"vndb"}]},"cast":[{"characterId":"char_c83078","characterName":"甲本 恵","sourceIds":{"bangumi":[{"characterId":"134149","match":"exact-normalized-name-in-linked-work","subjectId":"447674"}],"egsCharacterIds":["25513"],"vndbCharacterId":"c83078"},"originalCharacterName":"甲本 恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"頭脳明晰で運動神経抜群の主人公の姉。"},{"spoiler":false,"text":"明るく優しく、まさに理想の姉像を具現化したような女の子。"},{"spoiler":false,"text":"もちろん、容姿端麗で、学園でも人気も高い。"}],"source":"egs","sourceCharacterId":"25513","sourceWorkId":"7656","spoiler":false},{"segments":[{"spoiler":false,"text":"優しくて明るい性格の雅人の姉であり、学園中の憧れの的で人気者。"},{"spoiler":false,"text":"言い寄られることも多いが、今のところ色恋沙汰には興味が無いそぶりで部活に打ち込む日々を過ごす。"},{"spoiler":false,"text":"身長の高さを生かしてバスケ部で活躍している。"},{"spoiler":false,"text":"運動の邪魔にならないように、長い髪をポニーテールにまとめていることが多い。"},{"spoiler":false,"text":"体は柔軟で運動神経も抜群。"},{"spoiler":false,"text":"頭脳明晰で、雅人にとってすべてにおいて手本となっている理想の姉だ。"},{"spoiler":false,"text":"姉弟の仲はよく、弟の成長するさまを見て喜んでいたが、いつしか恵は雅人を男として意識するようになってしまう。"},{"spoiler":false,"text":"彼女に芽生えたその感情は二人の関係を大きく変えていくことになるのだろうか？"}],"source":"bangumi","sourceCharacterId":"134149"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"134149","value":"スポーツ全般"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"134149","value":"不真面目なこと"},{"label":"趣味","source":"bangumi","sourceCharacterId":"134149","value":"弟の面倒を見ること"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a19792f889436e07f2e789d53d45cb33a56a0a7842b3d47760e5d23f446ba72a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ea6bce817275534f40342b2b7961509a666a0e608e0835f9b76b917e28b32fb.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木川絵理子","creatorId":"vndb:s1634","sourcePersonId":"vndb:s1634","canonicalEntityId":"vndb:s1634","name":"木川 絵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:447674:134149:4668:1","source":"bangumi"}]},{"characterId":"char_c83081","characterName":"望月 愛","sourceIds":{"bangumi":[{"characterId":"134151","match":"exact-normalized-name-in-linked-work","subjectId":"447674"}],"egsCharacterIds":["25514"],"vndbCharacterId":"c83081"},"originalCharacterName":"望月 愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に思いを寄せる女の子。"},{"spoiler":false,"text":"主人公がバスケ部に入部したことからマネージャーになった。"},{"spoiler":false,"text":"普段は大人しく控えめながら、時に大胆になることも。"}],"source":"egs","sourceCharacterId":"25514","sourceWorkId":"7656","spoiler":false},{"segments":[{"spoiler":false,"text":"おとなしく控えめな性格のバスケ部マネージャー。"},{"spoiler":false,"text":"背は低いが意外と胸が大きく、可愛らしい女の子だ。"},{"spoiler":false,"text":"雅人のことを以前からよく知っており、彼のことを密かに想っている。"},{"spoiler":false,"text":"マネージャーになったのも彼がバスケ部に入ったからのようだ。"},{"spoiler":false,"text":"部活動でお世話をしているうちに徐々に親しくなるが、まだ告白はできないでいる。"},{"spoiler":false,"text":"ありったけの勇気を振り絞って、その想いを伝えることはできるのだろうか？"}],"source":"bangumi","sourceCharacterId":"134151"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"134151","value":"可愛らしいもの"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"134151","value":"虫"},{"label":"趣味","source":"bangumi","sourceCharacterId":"134151","value":"ショッピング"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9986168ff39731d069749fed3bd5a57d701cf104d91682281d13716b92bfface.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b3ffb539429af6e3c5e98c3be4b573e6b169927c662bffcf6a4e959bfa8c47c.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"椿理沙","creatorId":"vndb:s3863","sourcePersonId":"vndb:s3863","canonicalEntityId":"vndb:s3863","name":"椿 理沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:447674:134151:20162:1","source":"bangumi"}]},{"characterId":"char_c83082","characterName":"佐々木 菜摘","sourceIds":{"bangumi":[{"characterId":"134153","match":"exact-normalized-name-in-linked-work","subjectId":"447674"}],"egsCharacterIds":["25515"],"vndbCharacterId":"c83082"},"originalCharacterName":"佐々木 菜摘","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"恵の親友。"},{"spoiler":false,"text":"可愛らしい顔立ちと、モデル並みのスタイルで男子生徒からの人気も高い。"},{"spoiler":false,"text":"しかし、特定の彼氏は作らず、恵との友情を優先しているようだが、本当の恋はまだ苦手な感じだ。"}],"source":"egs","sourceCharacterId":"25515","sourceWorkId":"7656","spoiler":false},{"segments":[{"spoiler":false,"text":"愛らしい顔立ちとモデル並みのスタイルから、多くの男子学生が憧れている。"},{"spoiler":false,"text":"恵の親友で彼女の相談に乗っているが、実は恋愛経験がほとんどなく耳年増だったりする。"},{"spoiler":false,"text":"今のところ恵との友情が第一と思っているようだ。"}],"source":"bangumi","sourceCharacterId":"134153"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"134153","value":"お菓子作り"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce95d2aea3f46c0e9ab7eb461117650a4473be6ebf1f85e64359ee3bd69f8105.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8014905c392668c262291d3ae45ba70a60d46adcf067679ca7531868dcb50af7.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田ゆきえ","creatorId":"vndb:s790","sourcePersonId":"vndb:s790","canonicalEntityId":"vndb:s790","name":"前田 ゆきえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:447674:134153:3952:1","source":"bangumi"}]},{"characterId":"char_vndb_c83077","characterName":"甲本 雅人","sourceIds":{"vndbCharacterId":"c83077"},"originalCha