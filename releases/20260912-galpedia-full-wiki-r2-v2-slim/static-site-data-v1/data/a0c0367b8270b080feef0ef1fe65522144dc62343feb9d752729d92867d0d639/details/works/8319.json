4335","name":"KIRIKO(REM、ましろゆき、真白月子)","detail":"OP曲「雪のワルツ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:164029","source":"egs"},{"creditedName":"RMG(Rainbow-Motion-Graphics)","creatorId":"vndb:s2828","sourcePersonId":"egs:creator:12859","canonicalEntityId":"vndb:s2828","name":"RMG(Rainbow-Motion-Graphics)","detail":"OPムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68179","source":"egs"},{"creditedName":"KIRIKO","creatorId":"vndb:s4335","sourcePersonId":"vndb:s4335","canonicalEntityId":"vndb:s4335","name":"KIRIKO","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:13349","source":"vndb"}]},"cast":[{"characterId":"char_c16803","characterName":"鷹羽 紗璃奈","sourceIds":{"bangumi":[{"characterId":"159836","match":"exact-normalized-name-in-linked-work","subjectId":"217680"}],"egsCharacterIds":["24357"],"vndbCharacterId":"c16803"},"originalCharacterName":"鷹羽 紗璃奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「ですわ」「ますわ」のお嬢様風の語り口調と、高笑いを標準装備した超・ワガママお嬢様。"},{"spoiler":false,"text":"プライドが高く、負けん気も強い。"},{"spoiler":false,"text":"女子校で純粋培養されたことから、男子に免疫がない。"},{"spoiler":false,"text":"何故か、恋夏を一方的にライバル視し、何かと勝負をふっかけてくる。"}],"source":"egs","sourceCharacterId":"24357","sourceWorkId":"8319","spoiler":false},{"segments":[{"spoiler":false,"text":"一樹のクラスメイト。もともとは都会で暮らしていたお嬢様。恋夏をライバル視している。"}],"source":"bangumi","sourceCharacterId":"159836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7396536ab238bc5dda08ba1072e25bba7d30403cbf42dcd7e37d68c8103aef81.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f66c3304b7811edf0faed4b42f3c8615f7c46654de30f4adf1fd7bf1222538a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217680:159836:11511:1","source":"bangumi"}]},{"characterId":"char_c16805","characterName":"若草 なるみ","sourceIds":{"bangumi":[{"characterId":"159835","match":"exact-normalized-name-in-linked-work","subjectId":"217680"}],"egsCharacterIds":["24356"],"vndbCharacterId":"c16805"},"originalCharacterName":"若草 なるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公らが通う学校の妖精。"},{"spoiler":false,"text":"いつも丁寧で親切な振る舞いをする女の子。"},{"spoiler":false,"text":"その小さい身体で一生懸命仕事をしようとする姿に、周囲からは心配されてばかり。"},{"spoiler":false,"text":"そんな彼女はクラスのマスコット的存在として、可愛がられている。"}],"source":"egs","sourceCharacterId":"24356","sourceWorkId":"8319","spoiler":false},{"segments":[{"spoiler":false,"text":"一樹のクラスメイトでクラスの委員長。更に、学校の妖精でもある。皆の役に立とうと一所懸命な頑張り屋。"}],"source":"bangumi","sourceCharacterId":"159835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dec7fd188ded806fce4d8c413db476f4f7e500f49560cb2ae2bdeffdf9dd4766.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3d32bbfd372c5a30bc340c6bcb2fa52154ca8ecc19d04f799b98b76e4b7f5ed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林和実","creatorId":"vndb:s2892","sourcePersonId":"vndb:s2892","canonicalEntityId":"vndb:s2892","name":"小林 和実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217680:159835:65239:1","source":"bangumi"}]},{"characterId":"char_c16806","characterName":"ふるる","sourceIds":{"bangumi":[{"characterId":"159832","match":"exact-normalized-name-in-linked-work","subjectId":"217680"}],"egsCharacterIds":["24353"],"vndbCharacterId":"c16806"},"originalCharacterName":"ふるる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"突然、居なくなった雪の王様（＝父親）を探しに地上界にやってきた、雪のプリンセス。"},{"spoiler":false,"text":"地上界に降り立ったとき、主人公とキスをしてしまったことから、それが契約となり、以後、主人公と共に行動することになる。"},{"spoiler":false,"text":"やや浮世離れした雰囲気はあるが、いつも笑顔を絶やさない、素直で明るい女の子。"},{"spoiler":false,"text":"地上のものが珍しく、何にでも感動してしまう。"}],"source":"egs","sourceCharacterId":"24353","sourceWorkId":"8319","spoiler":false},{"segments":[{"spoiler":false,"text":"雪の妖精のプリンセスであり、行方不明になった自分の父親を探すために人間界に来た本作のメインヒロイン。一樹と「契約」を交わし、時沢家に滞在して人間界で行動することになる。世間知らずで色恋沙汰にも無知無垢な性格。"}],"source":"bangumi","sourceCharacterId":"159832"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c34d97c4cdb8db5858c056809e64914a633a7d55f5f714033067b14774c98e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89d9d983c04e988cba18513672a602a008afec5ec7a8eedd9285d4ad6210dcdf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217680:159832:8055:1","source":"bangumi"}]},{"characterId":"char_c16807","characterName":"坂井 恋夏","sourceIds":{"bangumi":[{"characterId":"159834","match":"exact-normalized-name-in-linked-work","subjectId":"217680"}],"egsCharacterIds":["24355"],"vndbCharacterId":"c16807"},"originalCharacterName":"坂井 恋夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"何でも難なくこなす天才型の優等生。"},{"spoiler":false,"text":"外見や言動はボーイッシュだが、優しく面倒見がよいお姉さん的な性格。"},{"spoiler":false,"text":"何事もマイペースで、自分に対して頓着がない。"},{"spoiler":false,"text":"転校生でありながら、主人公と野々花とは親友の間柄。"},{"spoiler":false,"text":"相手をたしなめるとき人差し指を相手の口に当てる「めっ」とするのが彼女の必殺技（？）。"}],"source":"egs","sourceCharacterId":"24355","sourceWorkId":"8319","spoiler":false},{"segments":[{"spoiler":false,"text":"一樹のクラスメイトで、物語の開始時点より前に転入してきた転校生。ボーイッシュな性格で自分のことを「ボク」と呼ぶ。文武両道の天才だが料理だけは苦手。"}],"source":"bangumi","sourceCharacterId":"159834"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e9e64c8508f0f7776c38c228ea157239f02c0fb94d24b7806e94a4453c9e103.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e31d480bfb79e2ba50f445f314b5b5bb62e5e78e3ec136e509c6d54c9b45b6da.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217680:159834:6351:1","source":"bangumi"}]},{"characterId":"char_c16808","characterName":"河崎 野々花","sourceIds":{"bangumi":[{"characterId":"159833","match":"exact-normalized-name-in-linked-work","subjectId":"217680"}],"egsCharacterIds":["24354"],"vndbCharacterId":"c16808"},"originalCharacterName":"河崎 野々花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明朗快活な主人公の幼馴染。"},{"spoiler":false,"text":"クラスでは情報通で通っている、噂に敏感な女の子で、ムードメーカー的存在。"},{"spoiler":false,"text":"自身がリーダーを務める「若草探偵団」を率いて、校内を駆け回っている。"},{"spoiler":false,"text":"主人公には淡い恋心を抱いているらしいが……。"}],"source":"egs","sourceCharacterId":"24354","sourceWorkId":"8319","spoiler":false},{"segments":[{"spoiler":false,"text":"一樹の幼馴染でクラスメイト。元気な性格で、よくニュースを追いかけている。しばしば一樹に「野々花パンチ」をお見舞いする。"}],"source":"bangumi","sourceCharacterId":"159833"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/165c813f081d8fb496bb5ababe170591d649dacfc9d4603a5d3de7022fdcc156.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fb66a2c557409bd59cafa9b85b5eb8f69d525d84c787613a8ee0184bfa334a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217680:159833:5890:1","source":"bangumi"}]},{"characterId":"char_vndb_c120127","characterName":"雨宮 光歩","sourceIds":{"vndbCharacterId":"c120127"},"originalCharacterName":"雨宮 光歩","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a95ae8fc699aead1bf3f8d9862a96623b065353498aeee3b940774064f3b4111.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7c4d190c3a4623b5bd9f249d68238262322b9b5c7a46765b93ee173ba6353a2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 希紗良","creatorId":"vndb:s30862","sourcePersonId":"vndb:s30