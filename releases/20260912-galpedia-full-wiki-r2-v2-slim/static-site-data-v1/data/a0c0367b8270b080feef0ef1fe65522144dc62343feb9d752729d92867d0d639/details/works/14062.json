"},{"creditedName":"小田 真ゆみ","creatorId":"vndb:s494","sourcePersonId":"vndb:s494","canonicalEntityId":"vndb:s494","name":"小田 真ゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14","source":"vndb"}]},{"characterId":"char_vndb_c6548","characterName":"藤堂 隆道","sourceIds":{"vndbCharacterId":"c6548"},"originalCharacterName":"藤堂 隆道","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The hero of the story, the average boy who deeply cares about his little sister Kana. During childhood he didn't like Kana due to the attention she got from their parents but after an incident started supporting her, even more than a real brother. He is always there for her when she needs him. Later in the game he becomes confused about his feelings for Kana."}],"source":"vndb","sourceCharacterId":"c6548"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f49d7b45b6e26c4fa3512674d4389931feaf800ce72ca657839251da30cb87c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f1de627f54501a4a0823bd72adbc8a6d324a007699809a24fed79f98c9dcd96.webp","width":256,"height":213,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c6549","characterName":"鹿島 夕美","sourceIds":{"vndbCharacterId":"c6549"},"originalCharacterName":"鹿島 夕美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who attends the same school as Taka. Taka liked her until an incident occurred between them in the fifth grade, after which he started hating her with a passion. She, however, has always pursued him."}],"source":"vndb","sourceCharacterId":"c6549"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/704ec65b4b68ed6c03a79ca626723d50c4b7f87fda04c9364e607ed32b073fd3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b04b5b83e2746f1a3ddbe0e08d1ab2a7195b3d342dc8167885058deae70af22b.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"支倉 ミキ","creatorId":"vndb:s14","sourcePersonId":"vndb:s14","canonicalEntityId":"vndb:s14","name":"高野 直子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18","source":"vndb"}]},{"characterId":"char_vndb_c6550","characterName":"近藤 美樹","sourceIds":{"vndbCharacterId":"c6550"},"originalCharacterName":"近藤 美樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The hospital nurse who has taken care of Kana since she was a little girl. When she first started taking care of Kana, she was just starting out. Although she's a veteran now, she still takes care of Kana. She thinks of Kana as her little sister and Taka as her little brother."}],"source":"vndb","sourceCharacterId":"c6550"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cd6361efe33d8b350da7a356130a9ea27c5085b4356f150a4929b6bf96e7812.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/527f5b235f84b3f8e3915c2a9778ac5c79480062fb33f9ed092a01af05379dc6.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","c