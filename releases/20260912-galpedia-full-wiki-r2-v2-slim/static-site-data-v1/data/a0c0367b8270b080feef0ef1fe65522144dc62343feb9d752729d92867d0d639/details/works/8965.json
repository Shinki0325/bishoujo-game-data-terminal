{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8965","model":{"presentationWorkId":"vndb:v7242","staff":{"artwork":[{"creditedName":"只野あきら","creatorId":"vndb:s2573","sourcePersonId":"egs:creator:5431","canonicalEntityId":"vndb:s2573","name":"只野あきら","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:51284","source":"egs"},{"creditedName":"市緒","creatorId":"vndb:s2945","sourcePersonId":"egs:creator:10366","canonicalEntityId":"vndb:s2945","name":"市緒","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:51285","source":"egs"}],"scenario":[{"creditedName":"なつみかんさい","creatorId":"vndb:s2974","sourcePersonId":"egs:creator:10367","canonicalEntityId":"vndb:s2974","name":"なつみかんさい","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:51286","source":"egs"}],"music":[],"other":[{"creditedName":"ウシ子","creatorId":"vndb:s2810","sourcePersonId":"vndb:s2810","canonicalEntityId":"vndb:s2810","name":"ウシ子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69797","source":"vndb"},{"creditedName":"姫ノ宮 レイ","creatorId":"vndb:s2968","sourcePersonId":"vndb:s2968","canonicalEntityId":"vndb:s2968","name":"姫ノ宮 レイ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69799","source":"vndb"},{"creditedName":"水碕 睦月","creatorId":"vndb:s2970","sourcePersonId":"vndb:s2970","canonicalEntityId":"vndb:s2970","name":"水碕 睦月","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:69800","source":"vndb"}]},"cast":[{"characterId":"char_c24818","characterName":"七島 末利","sourceIds":{"bangumi":[{"characterId":"96031","match":"exact-normalized-name-in-linked-work","subjectId":"269978"},{"characterId":"96031","match":"exact-normalized-name-in-linked-work","subjectId":"269995"}],"egsCharacterIds":["17784"],"vndbCharacterId":"c24818"},"originalCharacterName":"七島 末利","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"７４"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７６"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５８"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水着：旧タイプスクール水着"},{"spoiler":false,"text":"汐里と並ぶ水泳部のエース候補の1人。"},{"spoiler":false,"text":"普段は物静かでおとなしい性格だが、思ったことを頑固に貫く、芯の強さを持っている。"},{"spoiler":false,"text":"義兄に恋愛感情を抱いており、その大好きな義兄のことが絡むと、とたんに感情の起伏が激しくなり、大胆な行動を起こすこともしばしば。"},{"spoiler":false,"text":"キャプテンの汐里を密かにライバルとして意識しているが、同時に苦手にも思っているようだ。"}],"source":"egs","sourceCharacterId":"17784","sourceWorkId":"11108","spoiler":false},{"segments":[{"spoiler":false,"text":"今回の合宿参加メンバーの１人で、汐里と並んで水泳部のエース候補の１人。 大人しめの性格の中に、自分の想いを強固に貫く芯の強さを持っている。また汐里とは対照的に常に前向きで、試合に負けた時も落ち込む事無く明日への糧に出来る精神の持ち主でもある。 ちなみに義理の兄に対して恋愛感情を抱いており、合宿中も大好きな兄の声が聞きたい為に、持ち込み禁止なのを承知で携帯電話を使い、頻繁に連絡を取っている。 末利にとってこの兄は無くてはならない存在で、彼の事が絡むと感情を激しく起伏させて大胆な行動に出ることもある。"},{"spoiler":false,"text":"また同部屋の美乃とは水泳部に入部以来の親友で、気軽に相談事が出来る間柄。今回の合宿では彼女のお目付役を自認し、手綱取りと称してはいるが、実際には美乃をオモチャにしている傾向がある。 キャプテンの汐里に対して密かにライバル意識を持っているものの、同時に彼女からは一方的に敵対視されている為に苦手意識も同様に抱えている。"}],"source":"bangumi","sourceCharacterId":"96031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6bd0b21f28eb81fd70468933669222f8ffc5a31424f2dacbddd25b690417b2e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2b690c60e187b0dde9cfa39e656d540f8799eb4bb1d6eab03def255c535bbb0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葦沢 モモ美","creatorId":"vndb:s2825","sourcePersonId":"vndb:s2825","canonicalEntityId":"vndb:s2825","name":"藍川 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39170","source":"vndb"}]},{"characterId":"char_c24844","characterName":"沢井 郁美","sourceIds":{"bangumi":[{"characterId":"192333","match":"exact-normalized-name-in-linked-work","subjectId":"269957"},{"characterId":"192333","match":"exact-normalized-name-in-linked-work","subjectId":"269989"}],"egsCharacterIds":["21209"],"vndbCharacterId":"c24844"},"originalCharacterName":"沢井 郁美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大学を優秀な成績で卒業し、現在は大学病院で研修医として働く女性。"},{"spoiler":false,"text":"大学時代、音露と交際していたが、仕事が忙しくなっていったことで疎遠になった。"},{"spoiler":false,"text":"性格は、優しく穏やかなで、何事も慎重に進めていくタイプ。"},{"spoiler":false,"text":"今回、どのようなかたちで音露に絡んでいくのか……。"}],"source":"egs","sourceCharacterId":"21209","sourceWorkId":"6650","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の元恋人にして、レイプ犯になった原因を作った女性。"},{"spoiler":false,"text":"現在は、出身大学の付属病院の女医として勤務している。"},{"spoiler":false,"text":"穏やかで優しく、真面目な性格で、患者にも親身になって世話をする。"},{"spoiler":false,"text":"一児の母でもあるが、何かの事情で一人身。"},{"spoiler":false,"text":"その一人息子・夜叉を何よりも大事に考え、息子のためならどんなことでも耐えられる心の強さを持つ。"}],"source":"egs","sourceCharacterId":"21209","sourceWorkId":"8965","spoiler":false},{"segments":[{"spoiler":false,"text":"穏やかで優しい性格。大らかな心の持ち主で、音露と恋人関係であった頃は、彼のすべてを受け入れていた。非常に真面目で患者に親身になるあまり、オーバーワークになりがち。今ではシングルマザーとして、子供を守るためなら、どんなに打たれても折れない強い芯を持っている。"},{"spoiler":false,"text":"音露がレイプ魔となった原因の女性であり、初めて音露にレイプされた被害者でもある。大学を優秀な成績で卒業し、出身大学の付属病院で研修医として働いたあと、そのまま女医として勤務している。"},{"spoiler":false,"text":"一人息子の『夜叉（やしゃ）』のことをなによりも大事にしている、一児の母。しかし、なにか事情があるらしく、現在は独身。"},{"spoiler":false,"text":"「……毒島くん、本当にあなたなの？」"}],"source":"bangumi","sourceCharacterId":"192333"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d8ffb24c72b85bf43726f01ff15aad02d91d226fba369f3c4716047925d6f3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ac1844cde2e5ffde229d7718cf677ebdbacd2d256373899c8bde20a3fc54d3a.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269957:192333:4489:1","source":"bangumi"}]},{"characterId":"char_c24853","characterName":"由愛子","sourceIds":{"bangumi":[{"characterId":"164524","match":"exact-normalized-name-in-linked-work","subjectId":"269957"},{"characterId":"164524","match":"exact-normalized-name-in-linked-work","subjectId":"269980"}],"egsCharacterIds":["21215"],"vndbCharacterId":"c24853"},"originalCharacterName":"由愛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"麻子の姉。"},{"spoiler":false,"text":"成績優秀な優等生で、教師からも一目置かれる存在。"},{"spoiler":false,"text":"内向的で自分の意見を主張できず、常に相手の様子を窺っているような女の子。"},{"spoiler":false,"text":"それゆえ、クラスで浮いた存在で苛めに遭うようになり、現在は登校拒否中。"},{"spoiler":false,"text":"そんな彼女が主人公と出会い……。"}],"source":"egs","sourceCharacterId":"21215","sourceWorkId":"8550","spoiler":false},{"segments":[{"spoiler":false,"text":"成績優秀な優等生。"},{"spoiler":false,"text":"内向的で自分の意見を主張できず、常に相手の様子を窺っているような女の子。"},{"spoiler":false,"text":"しかし、苛めに遭っていた女の子を正義感から助けたことから、今度は自分がターゲットにされるようになってしまう。"},{"spoiler":false,"text":"そうしたことから、現在は不登校になってしまった。"}],"source":"egs","sourceCharacterId":"21215","sourceWorkId":"8965","spoiler":false},{"segments":[{"spoiler":false,"text":"ある学園の女子生徒。成績優秀かつ品行方正ゆえに学園内で評価されていた一方、一部の同級生のいじめに遭い、登校拒否に陥っていた。その後、音露と出会い、登校拒否から抜け出す。"},{"spoiler":false,"text":"『おかわり一杯目』にも登場する。"}],"source":"bangumi","sourceCharacterId":"164524"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b30ba3722f1a8021e369a6a5aae224266eabfd83afdf8f5a73936bf4b4cb6bb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/701ccdfdc692da44ad2b3ebd05fc9564de2706bd91442578346dfe7fc8445f43.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269957:164524:4463:1","source":"bangumi"}]},{"characterId":"char_c24860","characterName":"百瀬 美鳥","sourceIds":{"bangumi":[{"characterId":"192347","match":"exact-normalized-name-in-linked-work","subjectId":"269957"}],"egsCharacterIds":["21210"],"vndbCharacterId":"c24860"},"originalCharacterName":"百瀬 美鳥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一定の年齢を超えると心の成長が止まり、身体だけが成長する奇病を患い、入院中の少女。"},{"spoiler":false,"text":"そのため、年齢よりも言動や行動が子供っぽい。"},{"spoiler":false,"text":"性格は天真爛漫で明るく、優しい心を持っている。"},{"spoiler":false,"text":"大財閥百瀬グループの会長の娘であり、兄・拓郎が、自分の担当医・郁美を好いていることからその恋が成就するよう応援している。"}],"source":"egs","sourceCharacterId":"21210","sourceWorkId":"8965","spoiler":false},{"segments":[{"spoiler":false,"text":"一定の年齢を超えると心が成長を終え、体だけが成長するという難病にかかり、入院している。郁美がインターンの時代から受け持ち続けている患者。"},{"spoiler":false,"text":"年齢の割には非常に子供っぽい。言動や行動も幼く小学校高学年くらいの少女のよう。明るく元気。心優しい天真爛漫な少女。郁美の息子である夜叉の面倒を、たびたび見ている。"},{"spoiler":false,"text":"大財閥百瀬グループの会長の娘で、百瀬拓郎という兄がいる。兄が郁美のことを好きだと知っていて、その恋の成就を応援している。早く兄と郁美が結婚し、郁美や夜叉と、本当の家族になれるようにと考えている。"},{"spoiler":false,"text":"「うん、桜、きれいだなって思って。なんか少し、私に似てるなーなんて。えへへ」"}],"source":"bangumi","sourceCharacterId":"192347"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5778bd8432cf5523fe2f98b0423e00a2517d18c8664211f6190bdb78fd057e1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/868e19b4ab30b47146957fe2a5dbe443c8852360c8a1be64f33d9afd0d4aedfb.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269957:192347:24747:1","source":"bangumi"}]},{"characterId":"char_c24861","characterName":"七海 志保子","sourceIds":{"bangumi":[{"characterId":"192349","match":"exact-normalized-name-in-linked-work","subjectId":"269957"}],"egsCharacterIds":["21211"],"vndbCharacterId":"c24861"},"originalCharacterName":"七海 志保子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"新婚ほやほやの妊婦。"},{"spoiler":false,"text":"幼い容姿に似合わず、しっかりしており、親の教育が行き届いているためか、非常に礼儀正しい。"},{"spoiler":false,"text":"性格は明朗快活で、時にお姉さんぶることも。"},{"spoiler":false,"text":"友人の紹介で郁美と知り合い、自分と同じく若い年齢で出産した彼女から色々とアドバイスを貰っている。"},{"spoiler":false,"text":"女手一つで子育てしている郁美を尊敬している。"}],"source":"egs","sourceCharacterId":"21211","sourceWorkId":"8965","spoiler":false},{"segments":[{"spoiler":false,"text":"幼い外見に似合わず、明朗活発なしっかり者。お姉さんぶることがあり、余裕の態度を見せることが好き。親の教育が行き届いているため、非常に礼儀正しく、子供の見本にしたいような挨拶をする。まだ新婚ほやほやで、愛する夫との子供が生まれることに、幸せを感じている。"},{"spoiler":false,"text":"妊娠したおり、友人の紹介で郁美と知り合い、自分と同じように若い年齢で出産した郁美に、いろいろとアドバイスをもらっている。 女手一つで子育てしている郁美を尊敬している。"},{"spoiler":false,"text":"「順調に育ってるみたいでよかった……」"}],"source":"bangumi","sourceCharacterId":"192349"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95f3084a89c2bcdd13e1776bb08befcb33d56eaf5736703a9a88ae18f8228a23.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6394b1c51b27951c1adc2076159243c9077ddd3e617b178fe4fcfded67dc0b83.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269957:192349:8055:1","source":"bangumi"}]},{"characterId":"char_c24862","characterName":"鳥居 梓菜","sourceIds":{"bangumi":[],"egsCharacterIds":["21212"],"vndbCharacterId":"c24862"},"originalCharacterName":"鳥居 梓菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エリート意識が強い美人OL。"},{"spoiler":false,"text":"高飛車で、無能な人間には容赦が無く、その性格が仇となって男性社員から敬遠されている。"},{"spoiler":false,"text":"しかし、恋人や同性の前ではしおらしく、女性的な一面をみせる。"},{"spoiler":false,"text":"郁美を大学時代からライバル視していたが、郁美には勝てず、暗い情念を抱いていた。"},{"spoiler":false,"text":"それが年齢を重ねるにつれて、郁美のような存在がいることが自分の成長に繋がっていると考えるようになった。"}],"source":"egs","sourceCharacterId":"21212","sourceWorkId":"8965","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/2678cd3f4bc89c314116a0e22f79f363b58ba5c364eae103d7722d5e21d09b4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5d73c619d1c3fe82cfade416399e6f2a48530a997dac136e1b1067b12388ba8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和葉","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39166","source":"vndb"}]},{"characterId":"char_c24863","characterName":"木之下 理絵美","sourceIds":{"bangumi":[{"characterId":"192351","match":"exact-normalized-name-in-linked-work","subjectId":"269957"}],"egsCharacterIds":["21214"],"vndbCharacterId":"c24863"},"originalCharacterName":"木之下 理絵美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"由愛子と同じ学園に通う女子学生。"},{"spoiler":false,"text":"気弱で押しが弱く、人の意見に流されやすい性格。"},{"spoiler":false,"text":"小動物のように頼りなく、それゆえクラスメイトに苛められるようになった。"},{"spoiler":false,"text":"苛めに苦しめられていた彼女を救ったのが由愛子。"},{"spoiler":false,"text":"以来、由愛子と親密になった。"},{"spoiler":false,"text":"夏休みに入って、苦しい家計を助けるために喫茶店でアルバイトを始めた。"}],"source":"egs","sourceCharacterId":"21214","sourceWorkId":"8965","spoiler":false},{"segments":[{"spoiler":false,"text":"気弱でうぶな性格をしていて、押しが弱く、人の意見に流されやすい。子犬のように頼りない。また現状に依存するところがあり、一度悪い循環に嵌ってしまうと、そこから自分で抜け出せない。"},{"spoiler":false,"text":"亀頭由愛子と同じ学園に通う由愛子の親友。クラスメイトに虐められ、そのとき由愛子に助けられたことが切っ掛けで親密になる。"},{"spoiler":false,"text":"夏休みに入り、芳しくない家計の手助けをするために、喫茶店でアルバイトをはじめた。"},{"spoiler":false,"text":"「いらっしゃいませ、何名様でしょうか？」"}],"source":"bangumi","sourceCharacterId":"192351"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fa227fe0d11dbb2ef2090eeb4985db4232655e4246c0756c3248832f9608810.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a21fefdd1b1b32ff324b1195f7aa2bbfc8a49ea6fd5bbd8e90b50f8d658e09b.webp","width":140,"height":256,"source":"static-detail"},"actors":[{