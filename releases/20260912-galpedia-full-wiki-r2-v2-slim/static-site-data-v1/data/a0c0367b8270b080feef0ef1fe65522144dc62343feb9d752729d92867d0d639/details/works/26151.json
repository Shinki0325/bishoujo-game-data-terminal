4e929e0a5eed13aa.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64698","characterName":"弥島 幸介","sourceIds":{"vndbCharacterId":"c64698"},"originalCharacterName":"弥島 幸介","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"30"},"birthday":{"reviewState":"source-only","source":"vndb","value":"502"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eldest son of the Yajima family and the protagonist's fiancé."},{"spoiler":false,"text":"Kousuke had been taking on duties as the shopkeeper since his father's collapse but after the protagonist assumed his position, he became the assistant shopkeeper. He has plans to eventually convert the store into a hotel but as his father disagrees with his vision, they're currently at odds with one another. While he's ambitious and calculating, he hates anything that's underhanded. When making important decisions, he often takes a gamble."},{"spoiler":false,"text":"Translation of official website profile."}],"source":"vndb","sourceCharacterId":"c64698"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1edc6556a773ca95e61601fecc835a5926d720bf3e2ca1bb462011f5076926e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14dbd61bf0d82762df01477b249943b05b5c03f9707f6e4a986d01f1d1e430c2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平川 大輔","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75369","source":"vndb"}]},{"characterId":"char_vndb_c64699","characterName":"弥島 裕介","sourceIds":{"vndbCharacterId":"c64699"},"originalCharacterName":"弥島 裕介","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"birthday":{"reviewState":"source-only","source":"vndb","value":"203"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second son of the Yajima family."},{"spoiler":false,"text":"Stubborn and unyielding, Yuusuke won't budge once he's set on something. He's a serious man who absolutely lives for his job- which he's good at- but is totally useless in matters pertaining to his private life. He's self-conscious about the fact that his \"professional self\" and \"home self\" are wildly different, so he doesn't want his peers (especially his family) to see him at work. Incredibly short-sighted, Yuusuke can't see anything without his glasses."},{"spoiler":false,"text":"Translation of official website profile."}],"source":"vndb","sourceCharacterId":"c64699"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bcf40b6ff11004ee2bcbb437f6038fc9741eed1d3ccd659c84501fe080872b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dde082bdcf00619780384f19073b9171726df17853a9d6ef1498f5d02d885c13.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間島 淳司","creatorId":"vndb:s756",