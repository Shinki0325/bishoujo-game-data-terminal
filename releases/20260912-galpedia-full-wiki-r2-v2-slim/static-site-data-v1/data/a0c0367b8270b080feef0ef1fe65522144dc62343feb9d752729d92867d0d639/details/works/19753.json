:{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"黙っていれば割と美人と評判の直樹のクラスメイト。"},{"spoiler":false,"text":"楽しいことが好きなムードメーカー。"},{"spoiler":false,"text":"野次馬体質で、ヒロイン達と直樹とのやり取りを、自分の妄想で彩ってハァハァして楽しんでいる変態的な一面を併せ持つ。"},{"spoiler":false,"text":"ただの変態のように見えるが、わりと気の回る良い友人。"}],"source":"egs","sourceCharacterId":"3170","sourceWorkId":"19753","spoiler":false},{"segments":[{"spoiler":false,"text":"黙っていればわりと美人と評判の主人公のクラスメイト。"},{"spoiler":false,"text":"楽しいことが大好きなムードメーカー。"},{"spoiler":false,"text":"野次馬体質で、ヒロインたちと主人公とのやり取りを、自分の妄想で彩ってハァハァして楽しんでいる変態的な一面を併せ持つ。"},{"spoiler":false,"text":"ただの変態のように見えるが、わりと気の回る良い友人。"},{"spoiler":false,"text":"「直樹が私にポジションを譲るというなら、私の胸を触らせてあげてもいいのよ？」"}],"source":"bangumi","sourceCharacterId":"24355"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/090cc3aab418c0345fe8c5a7ba7fbc4e30f0244f72c70920bfae5de9a1874104.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3af43605a8dcf97e0e917c077e61048b5c5ff76d161d4cb7e01c66a57b84b6b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井まみ","creatorId":"vndb:s939","sourcePersonId":"vndb:s939","canonicalEntityId":"vndb:s939","name":"平井 まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:93359:24355:18547:1","source":"bangumi"}]},{"characterId":"char_c66680","characterName":"鈴原 直樹","sourceIds":{"bangumi":[{"characterId":"119721","match":"exact-normalized-name-in-linked-work","subjectId":"93359"}],"egsCharacterIds":["3168"],"vndbCharacterId":"c66680"},"originalCharacterName":"鈴原 直樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"医者である