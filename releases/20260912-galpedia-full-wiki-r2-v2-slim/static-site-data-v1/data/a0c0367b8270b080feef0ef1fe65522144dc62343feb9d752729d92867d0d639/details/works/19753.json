,"egsCharacterIds":["3167"],"vndbCharacterId":"c17660"},"originalCharacterName":"松島 有希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のバイト先である喫茶店の娘さん。"},{"spoiler":false,"text":"実家の喫茶店の手伝いを一所懸命している良い子。"},{"spoiler":false,"text":"一年ほど前、喫茶店のお使い中に交通事故に遭うが、通りかかった主人公に救われて九死に一生を得る。"},{"spoiler":false,"text":"助けられた事や、ぶっきらぼうながら紳士な主人公に一目惚れをしてしまう。"}],"source":"egs","sourceCharacterId":"3167","sourceWorkId":"19753","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のバイト先である喫茶店の娘さん。"},{"spoiler":false,"text":"実家の喫茶店の手伝いを一所懸命している良い子。"},{"spoiler":false,"text":"一年ほど前、喫茶店のお使い中に交通事故に遭うが、通りかかった主人公に救われて九死に一生を得る。"},{"spoiler":false,"text":"そして、ぶっきらぼうながら紳士な主人公に一目惚れをしてしまう。"},{"spoiler":false,"text":"恥ずかしさもあって冗談めかした 「好き」 という言葉を伝えるが、主人公には本気にされず軽くスルーされている。"},{"spoiler":false,"text":"「私の本気は、とっても熱いんだから覚悟して」"}],"source":"bangumi","sourceCharacterId":"24353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5a671db24693b7d53f75d570be13d652b23942d4075842528f7aa5561c740c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc5e0538dff693d68d53c896c517f80cd6ffbd755872b9c8305400bd0fe076d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:93359:24353:6046:1","source":"bangumi"}]},{"characterId":"char_c17661","characterName":"小波 咲耶","sourceIds":{"bangumi":[{"characterId":"24354","match":"exact-normalized-name-in-linked-work","subjectId":"93359"}],"egsCharacterIds":["3169"],"vndbCharacterId":"c17661"},"originalCha