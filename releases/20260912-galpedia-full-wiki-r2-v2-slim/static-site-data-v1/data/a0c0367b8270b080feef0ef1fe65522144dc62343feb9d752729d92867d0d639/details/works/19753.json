zed-name-in-linked-work","subjectId":"93359"}],"egsCharacterIds":["3165"],"vndbCharacterId":"c17658"},"originalCharacterName":"南野 音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"良家のお嬢様で一般には取っ付き難い女の子。"},{"spoiler":false,"text":"友達がいなくて寂しい思いをしているが、世間体のために友達を作れない不器用な娘。"},{"spoiler":false,"text":"そんな中で主人公が表面的な事だけで見ず、寂しい気持ちに気付いてくれた事があり、「私をわかってくれた」主人公の事を特別だと思うようになった。"}],"source":"egs","sourceCharacterId":"3165","sourceWorkId":"19753","spoiler":false},{"segments":[{"spoiler":false,"text":"良家のお嬢様で、一般人には取っ付き難い女の子。"},{"spoiler":false,"text":"友達がいなくて寂しい思いをしているが、世間体のために友達を作れない不器用な子。"},{"spoiler":false,"text":"そんな中、主人公が自分の気持ちに気付いてくれて、特別な想いを抱くようになった。"},{"spoiler":false,"text":"ずっと寂しかったので、本当はかなりの甘えん坊。"},{"spoiler":false,"text":"主人公が自分に優しくしてくれるので、それが心地良く、もっと一緒に居てほしいと思っている。"},{"spoiler":false,"text":"「ぎゅってして、離さないで」"}],"source":"bangumi","sourceCharacterId":"24351"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5809e06a4f9b25dfeb36250f304b0e44ce5914fa8d26dd7acbb4efbc4ff01534.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82ad0add50c26c9dbb51daa4b1c65dc1fac1bd1561a3208c2129d916f4631fca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤田しずく","creatorId":"vndb:s937","sourcePersonId":"vndb:s937","canonicalEntityId":"vndb:s937","name":"藤田 しずく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:93359:24351:16178:1","source":"bangumi"}]},{"characterId":"char_c17659","characterName":"鈴原 結衣菜","sourceIds":{"bangumi":[{"characterId":"24352","match":"exact-normalized-name-in-linked-work","subjec