bjectId":"225210"}]},"originalCharacterName":"Farren Sierwinde","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔族に落ちたエルフ、あるいは不吉の前触れと言われ、"},{"spoiler":false,"text":"王国で忌み嫌われていた種族の戦士。"},{"spoiler":false,"text":"兵士によって幽閉されていたところをレンジャー部の面々に保護される。"},{"spoiler":false,"text":"悪意はないものの、種族の生い立ちからか"},{"spoiler":false,"text":"他人との付き合いにぎこちなさが見て取れる。"},{"spoiler":false,"text":"幼き頃から慕っていた姉が指名手配となっている事を知り"},{"spoiler":false,"text":"彼女を探すために彩たちと同行することになる。"}],"source":"bangumi","sourceCharacterId":"65097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c949af14f505fa3118cf3a92b9e949a2cf3fffd99e1d293415eb7135967a8629.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0ffc6f0f3260459e804f7bc0da849438ed53853d0fe695fc986b9754cf6d06e3.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花理香","creatorId":"vndb:s11042","sourcePersonId":"vndb:s11042","canonicalEntityId":"vndb:s11042","name":"立花 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225210:65097:14610:1","source":"bangumi"}]},{"characterId":"char_bangumi_65098","characterName":"Merrina Iris","sourceIds":{"bangumi":[{"characterId":"65098","match":"source-roster","subjectId":"225210"}]},"originalCharacterName":"Merrina Iris","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"廃墟となった村で出会う、獣人族ケット・シーの少女。"},{"spoiler":false,"text":"小柄の猫耳姿で、好奇心が強く幼子のような振る舞いが特徴的。"},{"spoiler":false,"text":"元々は物事を深く考えず楽天的に生きる種族だが、"},{"spoiler":false,"text":"異形のオークの群れを引き連れて異世界からやってきた侵略者から、"},{"spoiler":false,"text":"懸命に村を守ろうとしている。"},{"spoiler":false,"text":"ゴールドが好きという、ちゃっかりした一面もある。"}],"source":"bangumi","sourceCharacterId":"65098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9182173461fc24d5fdd883b10809c2748d310508b771379c6126934509a225a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc35806f72631dba8bebfc200fead7d2f8ccb20fed667c4d89611e069fb6ef01.webp","width":184,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本希望","creatorId":"vndb:s1455","sourcePersonId":"vndb:s1455","canonicalEntityId":"vndb:s1455","name":"山本 希望","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225210:65098:7147:1","source":"bangumi"}]},{"characterId":"char_bangumi_65099","characterName":"Haldina Chrysant","sourceIds":{"bangumi":[{"characterId":"65099","match":"source-roster","subjectId":"225210"}]},"originalCharacterName":"Haldina Chrysant","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"山深い地域にあるエルフの古都で近衛兵を務める戦士。"},{"spoiler":false,"text":"自然と調和し、共存する種族として生きてきたため"},{"spoiler":false,"text":"加工された金属や自然破壊的な行為を嫌う。"},{"spoiler":false,"text":"エルフという種族の特性から、見た目より遙かに年齢が高く"},{"spoiler":false,"text":"落ち着いた清楚な口調で話す反面、"},{"spoiler":false,"text":"他の種族が年齢の話題に触れると冷静さを失う。"},{"spoiler":false,"text":"この世界のエルフは一様に長寿で、"},{"spoiler":false,"text":"人間の基準では見た目と実年齢に10倍ほどの開きがある。"}],"source":"bangumi","sourceCharacterId":"65099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0497594247e7596a2e02544e05b604d6fd17ca036d4564c97bf7dd5fab662dbd.w