iler":false,"text":"初等部、中等部時代は、救護部に所属していた彼女。"},{"spoiler":false,"text":"レンジャー部員としては、まだまだ、新米である。"},{"spoiler":false,"text":"クラスメイトでもある“金園優理奈”と一緒に“岬守の両翼”として日々、"},{"spoiler":false,"text":"明るく元気一杯に突き進んでいる！"},{"spoiler":false,"text":"体育祭の直前に異世界へ飛ばされて大混乱！"},{"spoiler":false,"text":"本物のお姫様との出会い、“模擬戦”ではない“実戦バトル”を経て"},{"spoiler":false,"text":"真の“炎”として成長できるか？"}],"source":"bangumi","sourceCharacterId":"25907"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89135b4f532eb3e732804c6ec61bc0008140b1265d85e9462d41717615639227.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0b76784c7e44dec2a0a38c66649781a617350e20ce68969f96ae5ea825cdfaa.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"M・A・O","creatorId":"vndb:s7526","sourcePersonId":"vndb:s7526","canonicalEntityId":"vndb:s7526","name":"市道 真央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225210:25907:10887:1","source":"bangumi"}]},{"characterId":"char_bangumi_25908","characterName":"金園 優理奈","sourceIds":{"bangumi":[{"characterId":"25908","match":"source-roster","subjectId":"225210"}]},"originalCharacterName":"金園 優理奈","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0507"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"85"},"height":{"reviewState":"source-only","source":"bangumi","value":"154"},"hip":{"reviewState":"source-only","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レンジャー部の内部崩壊させるべく、