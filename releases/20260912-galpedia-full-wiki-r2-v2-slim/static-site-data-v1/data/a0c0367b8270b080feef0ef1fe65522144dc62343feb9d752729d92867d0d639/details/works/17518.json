}],"source":"bangumi","sourceCharacterId":"65969"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5326e2fb2b0797c4c4dd7b602cdfe647cf0a437565c821b03fe6bf50192a4934.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61ce694b4b938f61a52ed4462ca0c7c95c530fd933395f0bd3316b0ef30b59ae.webp","width":149,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_65970","characterName":"Sernoa Grace","sourceIds":{"bangumi":[{"characterId":"65970","match":"source-roster","subjectId":"258404"},{"characterId":"65970","match":"source-roster","subjectId":"258406"}]},"originalCharacterName":"Sernoa Grace","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"魔族の国、グレイスのお姫様。自由奔放で気まぐれなため、束縛と退屈をこの上なく嫌う。"},{"spoiler":false,"text":"両親の才能を深く受け継ぎ、こと戦いに関しては、他の追随を許さない。持ち味の速さは、身のこなしだけではなく。至高速度や判断速度、手の早さにまで深く影響する。"},{"spoiler":false,"text":"素直になることが苦手なため、いつも憎まれ口を叩くがあまりにもわかりやすい強がりが周りの苦笑を誘い心を穏やかにしてくれる。"}],"source":"bangumi","sourceCharacterId":"65970"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b216df77022f274bf69948af26f7697ee164c211742db0ca9eae5e564c30b85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2e14cc9a6063822e8bece28ae3231e995774395ee8bc393ecab2072da53b95f.webp","width":135,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2235","sourceCompanyId":"egs:brand:2235","canonicalEntityId":"egs:brand:2235","name":"The sense of sight","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:17518:2235","source":"egs"},{"companyId":"vndb:p1274","sourceCompanyId":"vndb:p1274","canonicalEntityId