ndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69883","source":"vndb"}]},{"characterId":"char_c49313","characterName":"姫川 白雪","sourceIds":{"bangumi":[{"characterId":"46382","match":"exact-normalized-name-in-linked-work","subjectId":"185494"}],"egsCharacterIds":["10880"],"vndbCharacterId":"c49313"},"originalCharacterName":"姫川 白雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"光明市市長の一人娘。箱入りお嬢様を絵に描いたような少女。"},{"spoiler":false,"text":"慈愛と博愛の塊のような少女で、誰に対しても好意的に接する。しかし同時に世間知らずと天然ボケの結晶のような存在で、どこかズレた発言や勘違いをして周囲のトラブルを助長してしまう。"},{"spoiler":false,"text":"学園内に当然のようにファンクラブが存在するが、流通している非公式グッズの類は全て姫川従者隊の厳密な審査を通さなければならない。これもう公式グッズじゃないのかな。"}],"source":"egs","sourceCharacterId":"10880","sourceWorkId":"23866","spoiler":false},{"segments":[{"spoiler":false,"text":"光明市市長の一人娘。 箱入りお嬢様を絵に描いたような少女。"},{"spoiler":false,"text":"自愛と博愛の塊のような少女で、誰に対しても好意的に接する。"},{"spoiler":false,"text":"しかし同時に世間知らずと天然ボケの結晶のような存在で、"},{"spoiler":false,"text":"どこかズレた発言や勘違いをして周囲のトラブルを助長してしまう。"},{"spoiler":false,"text":"学園内に当然のようにファンクラブが存在するが、"},{"spoiler":false,"text":"流通している非公式グッズの類はすべて従者隊の厳密な審査を通さなければならない。"},{"spoiler":false,"text":"「赤崎さんはとても優しい方なのですね。」"}],"source":"bangumi","sourceCharacterId":"46382"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c06adc3c00183b5f485748841dccdaadf1940122b1acf75382b45743ec096ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d80c65333591e086c874087ef8c5bacbf68e825ae395afb24b0eef9ac7a6c618.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松代真由","creatorId":"vndb:s3931","sourcePersonId":"vndb:s3931","canonicalEntityId":"vndb:s3931","name":"三つ木ちかる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185494:46382:25293:1","source":"bangumi"}]},{"characterId":"char_c49315","characterName":"佐倉 桃","sourceIds":{"bangumi":[{"characterId":"46383","match":"exact-normalized-name-in-linked-work","subjectId":"185494"}],"egsCharacterIds":["10881"],"vndbCharacterId":"c49315"},"originalCharacterName":"佐倉 桃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"対策委員会の後輩。委員会活動を行いながら、どこがいいのか敦に熱烈なアプローチを続けている変人。"},{"spoiler":false,"text":"明るく気安くノリがいい、あざとかわいい後輩キャラ。まさしくアホの子を絵に描いたような後輩ではあるが、敦が輪にかけてアホなので、彼女の飛ばす好き好きビームは全て無効化される可哀想な子。"},{"spoiler":false,"text":"その姿は滑車の中を空回りし続けるハムスターのようで、哀愁を誘う。見る人がみれば可愛い……かもしれない。"}],"source":"egs","sourceCharacterId":"10881","sourceWorkId":"23866","spoiler":false},{"segments":[{"spoiler":false,"text":"対策委員会の後輩。 なぜか主人公に熱烈なアプローチを続けている変人。"},{"spoiler":false,"text":"明るく気安くノリが良い、あざとかわいい後輩キャラ。"},{"spoiler":false,"text":"アホの子を絵に描いたような後輩ではあるが、主人公が輪を掛けてアホなので"},{"spoiler":false,"text":"彼女が飛ばす好き好きビームはすべて無効化されている。"},{"spoiler":false,"text":"その姿は滑車を空回しし続けるハムスターのようでもあり、哀愁を誘う。"},{"spoiler":false,"text":"「こんなところで会うなんて奇遇ですね運命ですねっ！ よーしこのまま桃ちゃんルート入っちゃいましょう！」"}],"source":"bangumi","sourceCharacterId":"46383"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c7b6400691624e7d369836fd91d9c6cab4266ece311792155eb3a432cba5695.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8981ad21622ce4595a39ff18252db28fb1caa5e814bc46424b1fedf3532f420.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小岩井 みるる","creatorId":"vndb:s11905","sourcePersonId":"vndb:s11905","canonicalEntityId":"vndb:s11905","name":"小岩井 みるる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69887","source":"vndb"}]},{"characterId":"char_c49316","characterName":"平塚 藍茶","sourceIds":{"bangumi":[{"characterId":"46384","match":"exact-normalized-name-in-linked-work","subjectId":"185494"}],"egsCharacterIds":["10882"],"vndbCharacterId":"c49316"},"originalCharacterName":"平塚 藍茶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"敦の幼馴染みで人生の被害者。対策委員会の副委員長で、周りのバカどもには出来ないデスクワークを一手に引き受けている。暴走特急の敦の手綱を握ることができる数少ない人物で、周囲からは動物園の飼育員のような扱い。"},{"spoiler":false,"text":"ヒロイン中一番の読書家で、目を離すと本ばかり読んでいる。学園内に数えるほどしかいない常識人の一人。実は隠れ眼鏡。"},{"spoiler":false,"text":"バカのバカに付き合わされすぎて慣れているため、敦の扱いが雑。その対応はコンビニバイト二年目の大学生を彷彿とさせる。"}],"source":"egs","sourceCharacterId":"10882","sourceWorkId":"23866","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみで、人生の被害者。"},{"spoiler":false,"text":"対策委員会で副委員長を務め、おバカには出来ないデスクワークを引き受けている。"},{"spoiler":false,"text":"暴走特急な主人公の手綱を握ることが出来る数少ない人物で、周囲からは動物園の飼育員のように見られている。"},{"spoiler":false,"text":"かなりの読書家で、いつも本ばかり読んでいる。"},{"spoiler":false,"text":"学園の数少ない常識人の一人であり、実は眼鏡っ子。"},{"spoiler":false,"text":"おバカたちの扱いには慣れきっていて、主人公の扱いも非常に雑。"},{"spoiler":false,"text":"「……あ、やっと終わった？　じゃあ次いこっか」"}],"source":"bangumi","sourceCharacterId":"46384"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85df5dbbc194cb3823b254fe09a3116917884c65948041487be03e4ded484cc2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25063f7d43651f4681ff9c1a33adadcc69645d41775380740f64e5387442803b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春菜めばえ","creatorId":"vndb:s13052","sourcePersonId":"vndb:s13052","canonicalEntityId":"vndb:s13052","name":"春菜 めばえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185494:46384:29381:1","source":"bangumi"}]},{"characterId":"char_c49317","characterName":"御厨 伊墨","sourceIds":{"bangumi":[{"characterId":"46385","match":"exact-normalized-name-in-linked-work","subjectId":"185494"}],"egsCharacterIds":["10883"],"vndbCharacterId":"c49317"},"originalCharacterName":"御厨 伊墨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"光明学園の学生理事会長。いつもニヤニヤと惨事を見物してはちょっかいを掛けてくる。敦を対策委員長に任命した諸悪の根源。"},{"spoiler":false,"text":"対策委員会に仕事と称して厄介ごとを持ち込み方々へとけしかけている。その上、毎日のように好き勝手にこき使うなど完全に私物化している。"},{"spoiler":false,"text":"学園内では“魔女”と呼ばれる悪の秘密結社の首領のような扱い。やっていることはバカの元締めなので大体あってる。"}],"source":"egs","sourceCharacterId":"10883","sourceWorkId":"23866","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の学生理事会長。 主人公に対策委員会委員長という役職を与えた諸悪の根源。"},{"spoiler":false,"text":"いつも対策委員会に仕事と称して厄介事を持ち込み、方々へとけしかけている。"},{"spoiler":false,"text":"そしてニヤニヤと惨事を見物しては、ちょっかいを出してくる。"},{"spoiler":false,"text":"学園内では“魔女”と呼ばれ、悪の秘密結社の首領のような扱い。"},{"spoiler":false,"text":"「一つ、君に質問をしよう―― 君は魔法を信じるかい？」"}],"source":"bangumi","sourceCharacterId":"46385"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/087335157b9e4a7d5fb63e4bfdfad7757e43095432b9ed3abe53ab038027e338.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edbd07e51fa61b591de1fa