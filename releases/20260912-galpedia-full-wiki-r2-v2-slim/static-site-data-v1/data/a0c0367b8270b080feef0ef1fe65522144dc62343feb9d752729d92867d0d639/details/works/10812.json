{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10812","model":{"presentationWorkId":"vndb:v5268","staff":{"artwork":[{"creditedName":"ジェントル佐々木","creatorId":"vndb:s1223","sourcePersonId":"egs:creator:87","canonicalEntityId":"vndb:s1223","name":"ジェントル佐々木","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:67602","source":"egs"}],"scenario":[{"creditedName":"石弓達也(牧山昌弘)","creatorId":"vndb:s4411","sourcePersonId":"egs:creator:1244","canonicalEntityId":"vndb:s4411","name":"石弓達也(牧山昌弘)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97470","source":"egs"},{"creditedName":"野良うさぎ","creatorId":"vndb:s9017","sourcePersonId":"egs:creator:13702","canonicalEntityId":"vndb:s9017","name":"野良うさぎ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97471","source":"egs"},{"creditedName":"群青","creatorId":"vndb:s17261","sourcePersonId":"egs:creator:12794","canonicalEntityId":"vndb:s17261","name":"群青","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97472","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c58913","characterName":"一之瀬 真衣","sourceIds":{"bangumi":[{"characterId":"52475","match":"exact-normalized-name-in-linked-work","subjectId":"211407"}],"egsCharacterIds":["18220"],"vndbCharacterId":"c58913"},"originalCharacterName":"一之瀬 真衣","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"23"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本政府が秘密裏に組織した「特命捜査部」に所属する女捜査官。23歳。"},{"spoiler":false,"text":"性格は真面目な努力家で、正義感が強く、またプライドも高い。"},{"spoiler":false,"text":"両親は、彼女が幼いときにマフィアの抗争に巻き込まれ、亡くなっている。"},{"spoiler":false,"text":"天涯孤独の身だが、笑顔を絶やさず、そうした哀しい過去を感じさせない、気丈さを持つ。"},{"spoiler":false,"text":"少しでも平和な街を取り戻したいと思って警察官になる。"},{"spoiler":false,"text":"特務捜査官になってから、まだ日が浅い。"}],"source":"egs","sourceCharacterId":"18220","sourceWorkId":"10812","spoiler":false},{"segments":[{"spoiler":false,"text":"女捜査官。素直で真面目な頑張り屋。正義感が強くプライドが高い。"},{"spoiler":false,"text":"両親は5歳のときマフィアの抗争に巻き込まれ亡くなった。"},{"spoiler":false,"text":"一人っ子で天涯孤独の身だが、悲しい過去を感じさせない笑顔の持ち主。"},{"spoiler":false,"text":"少しでも平和な街にしようと思い警察官になる。特務捜査官になってからまだ日が浅い。"},{"spoiler":false,"text":"男性経験は余りない。"}],"source":"bangumi","sourceCharacterId":"52475"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"18220","sourceWorkId":"10812","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"18220","sourceWorkId":"10812","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"18220","sourceWorkId":"10812","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"18220","sourceWorkId":"10812","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77790e1b0e470a4f085a312be1779251740bc8cc23ab87e4e6fa3cd7526e2a63.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09cdee3cdeb67630dd602debefb252ad5ad5095f66f2c1ab523ea625e5e4cc05.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211407:52475:6480:1","source":"bangumi"}]},{"characterId":"char_c58915","characterName":"麗華","sourceIds":{"bangumi":[{"characterId":"52476","match":"exact-normalized-name-in-linked-work","subjectId":"211407"}],"egsCharacterIds":["18221"],"vndbCharacterId":"c58915"},"originalCharacterName":"麗華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"28"},"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高級娼婦などの性を生業とさせる人の調教を得意とする女調教師。28歳"},{"spoiler":false,"text":"その世界でも有数の調教師として名高く、腕前も超一流。"},{"spoiler":false,"text":"調教師としての仕事に誇りを持ち、また自分の腕に絶対の自信を持っている。"},{"spoiler":false,"text":"可愛い娘が自分の調教によって牝奴隷になっていく姿が楽しく、真衣に対しても様々な方法を駆使して堕落させていく。"}],"source":"egs","sourceCharacterId":"18221","sourceWorkId":"10812","spoiler":false},{"segments":[{"spoiler":false,"text":"高級娼婦、人身売買など性の技を駆使する人を調教する調教師。"},{"spoiler":false,"text":"その世界で一流の腕を持ち、仕事をキッチリこなすプロフェッショナル。"},{"spoiler":false,"text":"調教師としての仕事に誇りを持ちまた絶対の自信を持っている。"},{"spoiler":false,"text":"可愛い娘が牝奴隷になる過程が楽しく、様々な方法で真衣を調教する。"}],"source":"bangumi","sourceCharacterId":"52476"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"18221","sourceWorkId":"10812","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"18221","sourceWorkId":"10812","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"18221","sourceWorkId":"10812","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"18221","sourceWorkId":"10812","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51ccb1fb5bedf6c1338a69c8be2d703fcb6a15d7dcdc6bb12c982911b762e841.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71b5723090a23cf9a44a61a98e8764871ee16ee3694df13cca0ab6ad221cbfd8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 玲羅","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31216","source":"vndb"}]},{"characterId":"char_c58916","characterName":"瀧川","sourceIds":{"bangumi":[{"characterId":"215609","match":"exact-normalized-name-in-linked-work","subjectId":"211407"}],"egsCharacterIds":["18222"],"vndbCharacterId":"c58916"},"originalCharacterName":"瀧川","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"35"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"特命捜査官・真衣が内偵していた香港系マフィア「牙狼」の若頭的な存在。35歳。"},{"spoiler":false,"text":"瀧川と名乗っているが、本名は不明。"},{"spoiler":false,"text":"一見、紳士的なヤクザだが、自分の意にそぐわない者には容赦しない。"},{"spoiler":false,"text":"自分の利益になれば、誰であろうと殺すことに躊躇わない、冷酷で非常な男。"},{"spoiler":false,"text":"調教師・麗華を招聘した張本人。"}],"source":"egs","sourceCharacterId":"18222","sourceWorkId":"10812","spoiler":false},{"segments":[{"spoiler":false,"text":"35歳、犯罪組織の幹部。"},{"spoiler":false,"text":"瀧川と名乗るが本名は不明。"},{"spoiler":false,"text":"香港系マフィアの日本支部『牙狼（がろう）』の若頭的な存在。"},{"spoiler":false,"text":"態度は一見紳士的だが、自分の意にそぐわない者には容赦しない。"},{"spoiler":false,"text":"考え方が打算的で、利益があれば親でも殺す冷酷非情な男。"},{"spoiler":false,"text":"調教師の麗華に真衣の調教を依頼する。"}],"source":"bangumi","sourceCharacterId":"215609"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c43b1a29419ccfe4fb150667abb7e8a4ac5d2676d7686b1850f9c3883f18d2b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b92effa03f923d6b859bed7441c710b2d0408900f9d9e8289be140d39107809.webp","width":128,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p680","sourceCompanyId":"egs:brand:2186","canonicalEntityId":"vndb:p680","name":"極フェロ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10812:2186","source":"egs"},{"companyId":"vndb:p680","sourceCompanyId":"vndb:p680","canonicalEntityId":"vndb:p680","name":"極フェロ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11819:v5268","source":"vndb"},{"companyId":"vndb:p680","sourceCompanyId":"vndb:p680","canonicalEntityId":"vndb:p680","name":"極フェロ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11820:v5268","source":"vndb"},{"companyId":"vndb:p139","sourceCompanyId":"vndb:p139","canonicalEntityId":"vndb:p139","name":"電脳CLUB","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11821:v5268","source":"vndb"},{"companyId":"vndb:p680","sourceCompanyId":"vndb:p680","canonicalEntityId":"vndb:p680","name":"極フェロ","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:11822:v5268","source":"vndb"},{"companyId":"vndb:p680","sourceCompanyId":"vndb:p680","canonicalEntityId":"vndb:p680","name":"極フェロ","roleCodes":["publisher"],"identityStatu