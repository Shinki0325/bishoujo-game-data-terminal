day":{"reviewState":"source-only","source":"vndb","value":"1014"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Date of Birth (Creation): 2006/10/14"},{"spoiler":false,"text":"From: Musashino-shi, Tokyo."},{"spoiler":false,"text":"Hobbies: Bathing, playing with cats, gaming."},{"spoiler":false,"text":"Special skill: Guitar, cooking (Japanese food)."},{"spoiler":false,"text":"Favorite food: Ramen (pork noodles), macaroon."},{"spoiler":false,"text":"Favorite artists: Nirvana, Foo Fighters, Sonic Youth, Iggy and The Stooges, The Clash, Patti Smith, Avril Lavigne."},{"spoiler":false,"text":"Recent favorites: Maximum the Hormone and Grizzly Bear."},{"spoiler":false,"text":"Super Sonico was created by the Nitroplus Company in 2007 to be the mascot for their yearly Nitro Super Sonic (NSS) Music Festival held in Japan each year. Since her creation, she has become quite popular and has even starred in her own video game: SoniComi, the PS3/PSV game Motto! SoniComi and the 3DS idol producing game SoniPro. She even starred in her own anime, SoniAni."},{"spoiler":false,"text":"She also a member of band Dai Ichi Uchuu Sokudo and has released several singles and albums."},{"spoiler":false,"text":"From 2011.03.01 till 2011.05.31 Sonico starred in Kimisho as a limited time heroine."},{"spoiler":false,"text":"Profile details translated from her official site."},{"spoiler":false,"text":"Summary from Anime Vice."}],"source":"vndb","sourceCharacterId":"c3643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/character