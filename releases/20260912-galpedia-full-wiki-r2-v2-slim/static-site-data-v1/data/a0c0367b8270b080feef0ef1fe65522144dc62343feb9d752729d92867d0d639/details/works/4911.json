rId":"vndb:s3326","sourcePersonId":"vndb:s3326","canonicalEntityId":"vndb:s3326","name":"有原 昌顕","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:27700","source":"vndb"}]},"cast":[{"characterId":"char_c14025","characterName":"音羽 葉子","sourceIds":{"bangumi":[{"characterId":"140427","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"140427","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8366"],"vndbCharacterId":"c14025"},"originalCharacterName":"音羽 葉子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third heroine of Natsu Kagura and the elder of the Otowa Clan. A Freeloader of Minamori shrine and a gentle person. She is very calm in any situation. Youko is actually an incarnation of nine tailed fox spectre. She was sealed by the great grandfather of Otowa, long time ago, and since then she had been serving at the Otowa home. Due to the nature of a fox, her smile is unexpectedly a part of her scheming. She has a bad habit of teasing other people, especially Keika, even during sex with her. In many ocassion, she demonstrated her great knowledges regarding the situatiion, including the youkai's detail. Youko seems to know Kijima from Oni Kagura series since long time ago. She has daughter named Nanaka, who appears at Debo no Subako. Youko appears at Aozora Magiccer which is direct sequel of Youko's route from Natsu Kagura and take place in alternate (fantasy) universe. Youko also makes cameo at Kagura Douchukii."}],"source":"vndb","sourceCharacterId":"c14025"},{"segments":[{"spoiler":false,"text":"音羽家一番の年長者。 神社の居候。 音羽家で一番胸の大きい人。"},{"spoiler":false,"text":"一見おっとりさんで、大抵のことには動じず笑顔のままで対応できる大物。"},{"spoiler":false,"text":"しかし時々人をからかう悪い癖を持っていて、意外と腹黒い部分もある。"},{"spoiler":false,"text":"実は昔の大妖怪で狐の化身。 桂香たちの祖父に封じられ、以来音羽家に仕えている。"},{"spoiler":false,"text":"現在は霊力のほとんどが封じられているので簡単な雑務しか出来ないが、膨大な知識を持っていて妖怪や退魔についても詳しい。"}],"source":"egs","sourceCharacterId":"8366","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"音羽家一番の年長者。神社の居候。"},{"spoiler":false,"text":"音羽家で一番胸の大きい人。"},{"spoiler":false,"text":"一見おっとりさんで、常に微笑みをたたえています。"},{"spoiler":false,"text":"大抵のことには動じず、笑顔のままで対応出来る大物。"},{"spoiler":false,"text":"ただし本性が妖怪なので、腹黒い部分もあるようです。"},{"spoiler":false,"text":"年の功というか、策士の人。"}],"source":"bangumi","sourceCharacterId":"140427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d55d252216ff2165c052a032126a0d9658816f70ae8a3c4b41052e26de9cc89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0788968f245192b9c7f86d8401dfc7a3b06796cdcc84fb22e2e2344b0280c8d8.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23562:140427:4432:1","source":"bangumi"}]},{"characterId":"char_c17193","characterName":"ナツ","sourceIds":{"bangumi":[{"characterId":"87303","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"87303","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8368"],"vndbCharacterId":"c17193"},"originalCharacterName":"ナツ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"犬耳・尻尾付きの神様。 無口で感情表現が乏しい。"},{"spoiler":false,"text":"非常に人見知りが激しく、主人公が近付いても最初は怯えられるだけ。"},{"spoiler":false,"text":"葉子にだけ懐いている。"},{"spoiler":false,"text":"そのくせ好奇心旺盛という、ややこしい性格の持ち主。"},{"spoiler":false,"text":"神様というより座敷わらしに近い？　一度懐くと、それこそ犬のようにどこにでもついてくる。"},{"spoiler":false,"text":"水杜神社に祀られている神様で、付近の霊や妖怪の力を “殺生石” に封じている。"},{"spoiler":false,"text":"そのため妖怪たちは、この “殺生石” を狙っている。"}],"source":"egs","sourceCharacterId":"8368","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社に住む犬耳尻尾付きの神様。"},{"spoiler":false,"text":"幹也や音羽姉妹との生活で人見知りは大分なりを潜めた。"},{"spoiler":false,"text":"ただし相変わらず口数は少なく、慣れていない人の前ではあまり感情を出さない。"},{"spoiler":false,"text":"その心根は優しい。"}],"source":"egs","sourceCharacterId":"8368","sourceWorkId":"30006","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社に住む犬耳尻尾付きの神様。"},{"spoiler":false,"text":"幹也や音羽姉妹との生活で人見知りは大分なりを潜めた。"},{"spoiler":false,"text":"ただし相変わらず口数は少なく、慣れていない人の前ではあまり感情を出さない。"},{"spoiler":false,"text":"その心根は優しい。"}],"source":"bangumi","sourceCharacterId":"87303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1a3fa8d86b7c52519f01719397a9c54f3787a2b735e7011460ff83a7bb0e9f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75f91d2c9346b59d8f4e858d866472bcbf9176f14772f8d0c4d9fce638f2ec0f.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ダイナマイト 亜美","creatorId":"vndb:s663","sourcePersonId":"vndb:s663","canonicalEntityId":"vndb:s663","name":"静木 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14464","source":"vndb"}]},{"characterId":"char_vndb_c14064","characterName":"天神 かんな","sourceIds":{"vndbCharacterId":"c14064"},"originalCharacterName":"天神 かんな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Live in Amanomori shrine, Kanna is the main heroine of Oni Kagura and eldest daughter of the Amagami sister."},{"spoiler":false,"text":"Kanna is a serious bullish, short-tempered and overconfident. However she is actually a kind, loyal, and respectful person. She is very easy to anger when considering Kijima's behavior and often argues with him like cat and dog."},{"spoiler":false,"text":"Kanna is skilled in Shizugokoro-ryu sword technique. There is no hesitation in her when she kills her opponent, an ayakashi-killer professional."},{"spoiler":false,"text":"Kanna's weapon of choice is a long sword nodachi."},{"spoiler":false,"text":"CV: Misumi- みすみ"}],"source":"vndb","sourceCharacterId":"c14064"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07aba9136a209d4343f160fd0b6c163d5ebcf815b4c20f9c4782c9fb074112b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/007f48e8e0ff29dc6bb56503540910ce01dbba0e9e423caf3610047d0e26717a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みすみ","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14467","source":"vndb"}]},{"characterId":"char_vndb_c14070","characterName":"天神 うづき","sourceIds":{"vndbCharacterId":"c14070"},"originalCharacterName":"天神 うづき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of Amagami Kanna. Second heroine of Oni Kagura, Uzuki is logistic support representative and a shy art teacher with pigtails."},{"spoiler":false,"text":"She is outwardly shy, delicate, and timid. A quiet girl with a gentle heart & low voice even when speak. Smart and loves animals."},{"spoiler":false,"text":"Uzuki is small in stature and always hiding behind her sister, Kanna."},{"spoiler":false,"text":"Unlike her sister, Uzuki doesn’t seem to hate Kijima."}],"source":"vndb","sourceCharacterId":"c14070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94865abfb798353d8ede78e7ca5a2700d771cc8f57f4bd4c13da06085d1c207c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab412647a4f47b3ff1f06e94f66e9821b8d3cb63d9a2a1a2e3e08f6daca59864.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野 江麻","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14469","source":"vndb"}]},{"characterId":"char_vndb_c14124","characterName":"イチ様","sourceIds":{"vndbCharacterId":"c14124"},"originalCharacterName":"イチ様","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2acf836db9ba172f8eb77c7f922682c857095e7ba41c4d627a76c4ca27e34595.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/458d88c6fcf28194c76bb8ec9bc830e4c82b8853875e68341dff63373f895c71.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 あやか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14463","source":"vndb"}]},{"characterId":"char