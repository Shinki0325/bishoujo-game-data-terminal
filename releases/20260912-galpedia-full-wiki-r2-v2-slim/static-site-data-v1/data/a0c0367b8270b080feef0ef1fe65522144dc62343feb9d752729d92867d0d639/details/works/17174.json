db:s919","name":"小沢 裕樹","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:88927","source":"vndb"},{"creditedName":"くわだ ゆうき","creatorId":"vndb:s2366","sourcePersonId":"vndb:s2366","canonicalEntityId":"vndb:s2366","name":"くわだ ゆうき","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:88928","source":"vndb"},{"creditedName":"神剣 桜花","creatorId":"vndb:s3011","sourcePersonId":"vndb:s3011","canonicalEntityId":"vndb:s3011","name":"神剣桜花","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:88930","source":"vndb"}]},"cast":[{"characterId":"char_c33834","characterName":"橘 四つ葉","sourceIds":{"bangumi":[{"characterId":"19045","match":"exact-normalized-name-in-linked-work","subjectId":"23704"}],"egsCharacterIds":["9586"],"vndbCharacterId":"c33834"},"originalCharacterName":"橘 四つ葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"402"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Examining what's cheap in supermarkets, home gardening"},{"spoiler":false,"text":"Skills: Housework in general, saving money"}],"source":"vndb","sourceCharacterId":"c33834"},{"segments":[{"spoiler":false,"text":"妹達の中では１番最初に生まれた「長女」にあたる妹。"},{"spoiler":false,"text":"そのため、かなりしっかり者で兄妹みんなから頼られているが、実は寂しがりや。"},{"spoiler":false,"text":"お兄ちゃんとふたりきりのときには、甘えん坊になる一面も。"},{"spoiler":false,"text":"ちょっぴり天然で、癒し系。お兄ちゃんの匂いに目が無く、妄想癖がある。"},{"spoiler":false,"text":"妹の中で、いちばん家庭的で料理が得意。"},{"spoiler":false,"text":"前の学園では、蒿太とは同じクラブに所属している先輩後輩の間柄だった。"}],"source":"egs","sourceCharacterId":"9586","sourceWorkId":"16095","spoiler":false},{"segments":[{"spoiler":false,"text":"妹妹中最早出生的、橘家的“长女”。"},{"spoiler":false,"text":"虽然是认真的优等生但是有点天然，据说偶尔不慎透露出来的老实话是兄妹中最强大的。"},{"spoiler":false,"text":"外表沉着，行动力一流。 没自觉地做出大胆的行动，甩得哥哥团团转。"},{"spoiler":false,"text":"为哥哥的味道神魂颠倒，而且有妄想癖。"},{"spoiler":false,"text":"～亲热恋爱后日谈 『自妹党的亲热恋爱公约』～"},{"spoiler":false,"text":"就任妹会会长以后，依旧作为大家的姐姐每天努力。"},{"spoiler":false,"text":"但是和哥哥独处的时候会随心撒娇。"},{"spoiler":false,"text":"无法停止偷偷进入哥哥的房间妄想。"},{"spoiler":false,"text":"「和哥哥这样一起，每天大家一起生活……是最幸福的」"}],"source":"bangumi","sourceCharacterId":"19045"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"19045","value":"调查附近超市的最低价、家庭菜园"},{"label":"特技","source":"bangumi","sourceCharacterId":"19045","value":"全部家务、节俭"}],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"83","source":"vndb","sourceCharacterId":"c33834","value":"83"},{"comparisonValue":"83","scope":"sourceWork","source":"egs","sourceCharacterId":"9586","sourceWorkId":"16095","value":"83"},{"comparisonValue":"84","source":"bangumi","sourceCharacterId":"19045","value":"84"}],"hip":[{"comparisonValue":"85","source":"vndb","sourceCharacterId":"c33834","value":"85"},{"comparisonValue":"85","scope":"sourceWork","source":"egs","sourceCharacterId":"9586","sourceWorkId":"16095","value":"85"},{"comparisonValue":"86","source":"bangumi","sourceCharacterId":"19045","value":"86"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a9c289a83506b3312157af54e7a4cb2db83e0a305daf561f13d7b59091b7175.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/398fdab3838b810ff9b71594e9a993180935b569c6a969b9a246b3e81c3d4690.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"中村繪里子","creatorId":"vndb:s1648","sourcePersonId":"vndb:s1648","canonicalEntityId":"vndb:s1648","name":"中村 繪里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41153:19045:4991:1","source":"bangumi"}]},{"characterId":"char_c33835","characterName":"橘 茉莉","sourceIds":{"bangumi":[{"characterId":"19046","match":"exact-normalized-name-in-linked-work","subjectId":"23704"}],"egsCharacterIds":["9587"],"vndbCharacterId":"c33835"},"originalCharacterName":"橘 茉莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"608"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一生懸命、大人になろうと背伸びをする妹。"},{"spoiler":false,"text":"ティーンズ向けのファッション雑誌で読者モデルをしていて、他の妹たちからも人気が高い。"},{"spoiler":false,"text":"隠れて色んな努力をしているが、それを人に知られるのはカッコワルイと思っている。"},{"spoiler":false,"text":"真面目で、面倒見が良く、困っている人を放っておけない性格。"},{"spoiler":false,"text":"兄の前ではなかなか素直になれないが、人一倍家族を大事に思っている。"}],"source":"egs","sourceCharacterId":"9587","sourceWorkId":"16095","spoiler":false},{"segments":[{"spoiler":false,"text":"尽全力想要成为大人的妹妹。"},{"spoiler":false,"text":"总是躲起来锻炼，因为她觉得被人知道会很没面子。"},{"spoiler":false,"text":"对自己高度严格但是对他人宽容。因为害羞所以对哥哥的态度也不由自主地强硬了。"},{"spoiler":false,"text":"拥有热心和复杂的少女心的妹妹。最喜欢甜品和小孩。"},{"spoiler":false,"text":"～亲热恋爱后日谈 『心跳不已的2人新婚生活』～"},{"spoiler":false,"text":"就任妹会会长后依旧以人气模特・まつり的身份，在杂志、CM等媒介上十分活跃。在妹妹们中也大有人气。"},{"spoiler":false,"text":"在别人面前还是一如既往地严肃，但是2人独处的时候就变得十分害羞。"},{"spoiler":false,"text":"实际上最想向哥哥撒娇的正是她本人。"},{"spoiler":false,"text":"「可以哦？我，可是你的老婆……哥哥想要我做的事情……无、无论是什么，我都会为你做」"}],"source":"bangumi","sourceCharacterId":"19046"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"19046","value":"锻炼自己、购物"},{"label":"特技","source":"bangumi","sourceCharacterId":"19046","value":"照顾小孩"}],"metadataCandidateConflicts":{"waist":[{"comparisonValue":"56","source":"vndb","sourceCharacterId":"c33835","value":"56"},{"comparisonValue":"56","scope":"sourceWork","source":"egs","sourceCharacterId":"9587","sourceWorkId":"16095","value":"56"},{"comparisonValue":"55","source":"bangumi","sourceCharacterId":"19046","value":"55"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d73706be14ea10e2f8c91683cd813babde06bab7c083dd50f11ede0e4751a4eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17970cf8a10255f1d06f5ee6dca3cab3c70d0b9e0e0ff549ff903982317e410e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41153:19046:5905:1","source":"bangumi"}]},{"characterId":"char_c33836","characterName":"橘 柊","sourceIds":{"bangumi":[{"characterId":"19047","match":"exact-normalized-name-in-linked-work","subjectId":"23704"}],"egsCharacterIds":["9588"],"vndbCharacterId":"c33836"},"originalCharacterName":"橘 柊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1225"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouta's 269th little sister."}],"source":"vndb","sourceCharacterId":"c33836"},{"segments":[{"spoiler":false,"text":"兄様に早く捧げたい、と願う困った妹。"},{"spoiler":false,"text":"時々、ものすごく大胆なことをしてしまうが、本人にあまり自覚は無い。"},{"spoiler":false,"text":"おっぱいが大きいのがとても恥ずかしい。"},{"spoiler":false,"text":"おっぱいが大きいのは、自分がとてもいやらしいからではないかとひっそり思っている。"},{"spoiler":false,"text":"自分のことよりも、何よりも兄が大事。予知能力を持っており、兄の危険を頻繁に察知する。"},{"spoiler":false,"text":"本当は他の妹たちとも仲良くしたいけれど、不器用なのでどうすればいいかわからない。"}],"source":"egs","sourceCharacterId":"9588","sourceWorkId":"16095","spoiler":false},{"segments":[{"spoiler":false,"text":"虽然看上去稳着，但是内心充满激情。"},{"spoiler":false,"text":"因为胸大而非常害羞。"},{"spoiler":false,"text":"暗地里想着自己胸大会不会让别人觉得自己淫荡。"},{"spoiler":false,"text":"兴趣爱好广泛而精通。受猫神加护，拥有很强的预知能力。"},{"spoiler":false,"text":"哥哥的幸福比任何事情都重要。"},{"spoiler":false,"text":"～亲热恋爱后日谈 『美人妹妹温泉烟渺事件簿』～"},{"spoiler":false,"text":"就任妹会会长以后，依旧尽心服侍哥哥。"},{"spoiler":false,"text":"不知道是不是因为和哥哥过着幸福的每天，神通力越发精进。"},{"spoiler":false,"text":"最近为了寻找特殊的H玩法，天天泡在网上。当然这是为了哥哥。"},{"spoiler":false,"text":"「我只是……为随时能把这身体……奉献给哥哥而已……」"}],"source":"bangumi","sourceCharacterId":"19047"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"19047","value":"研究猫神、读书"},{"label":"特技","source":"bangumi","sourceCharacterId":"19047","value":"跳舞、察知哥哥的危险"}],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"88","source":"vndb","sourceCharacterId":"c33836","value":"88"},{"comparisonValue":"88","scope":"sourceWork","source":"egs","sourceCharacterId":"9588","sourceWorkId":"16095","value":"88"},{"comparisonValue":"91","source":"bangumi","sourceCharacterId":"19047","value":"91"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff63801e1f9d771666eb08ee8e3ef3353d19fd66221c83fd92db890b2513113b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd9bbb93755892dbfb0355cd1540959bcf445d99666bdb58ea087d3f51fe921d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41153:19047:5075:1","source":"bangumi"}]},{"characterId":"char_c33837","characterName":"橘 きっか","sourceIds":{"bangumi":[{"characterId":"19048","match":"exact-normalized-name-in-linked-work","subjectId":"23704"}],"egsCharacterIds":["9589"],"vndbCharacterId":"c33837"},"originalCharacterName":"橘 きっか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"401"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"139"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"笑顔を絶やさない、元気で活発な末っ子妹。"},{"spoiler":false,"text":"365人の妹の中では、唯一、兄とずっと一緒に暮らしてきた。"},{"spoiler":false,"text":"幼い見た目とは裏腹に、、しっかり者で、人をまとめるのが得意。"},{"spoiler":false,"text":"選挙管理委員として公平な立場で、選挙を取りまとめる。"},{"spoiler":false,"text":"ノリがよく、お祭り騒ぎが大好き。"},{"spoiler":false,"text":"たくさんの姉が出来たことを心から嬉しく思っている。"}],"source":"egs","sourceCharacterId":"9589","sourceWorkId":"16095","spoiler":false},{"segments":[{"spoiler":false,"text":"被哥哥爱着，率真地成长起来的妹妹。"},{"spoiler":false,"text":"因为总是兄妹2人，所以憧憬热闹的家庭。"},{"spoiler":false,"text":"平易近人，喜欢祭典。最重视的是哥哥和姐姐。"},{"spoiler":false,"text":"アル来了后，叫着「我终于成为姐姐了！」而兴奋起来。"},{"spoiler":false,"text":"～亲热恋爱后日谈『实妹眼中的橘家大事情』～"},{"spoiler":false,"text":"就任妹会会长后依旧以高涨的情绪为橘家制造活力。"},{"spoiler":false,"text":"虽然最喜欢哥哥，但也很喜欢姐姐。"},{"spoiler":false,"text":"每天都在摸索让全家人变得最幸福的方法。"},{"spoiler":false,"text":"「呐，哥哥……喜欢我吗？」"}],"source":"bangumi","sourceCharacterId":"19048"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"19048","value":"读报、观察人类"},{"label":"特技","source":"bangumi","sourceCharacterId":"19048","value":"背圆周率、编三股辫"}],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"75","source":"vndb","sourceCharacterId":"c33837","value":"75"},{"comparisonValue":"75","scope":"sourceWork","source":"egs","sourceCharacterId":"9589","sourceWorkId":"16095","value":"75"},{"comparisonValue":"76","source":"bangumi","sourceCharacterId":"19048","value":"76"}],"hip":[{"comparisonValue":"79","source":"vndb","sourceCharacterId":"c33837","value":"79"},{"comparisonValue":"79","scope":"sourceWork","source":"egs","sourceCharacterId":"9589","sourceWorkId":"16095","value":"79"},{"comparisonValue":"78","source":"bangumi","sourceCharacterId":"19048","value":"78"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45d590adfea03e404891d4490bcceacdd0702375d061bf79ff918c5a93353b7f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae866eafd555c70e80104f079283e33c1539d807660d68198dee1aa808a3dd4d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤乃 理香","creatorId":"vndb:s945","sourcePersonId":"vndb:s945","canonicalEntityId":"vndb:s945","name":"藤乃 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47224","source":"vndb"}]},{"characterId":"char_c33851","characterName":"橘 アルテミシア","sourceIds":{"bangumi":[{"characterId":"19044","match":"exact-normalized-name-in-linked-work","subjectId":"41153"}],"egsCharacterIds":["6866"],"vndbCharacterId":"c33851"},"originalCharacterName":"橘 アルテミシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"229"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"64"},"height":{"reviewState":"no-conflict","source":"vndb","value":"132"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Occupation: A teacher at Tachibana Gakuen, the leader of the \"Tachiagare Imouto (Raise Up, Little Sisters!)\" party"},{"spoiler":false,"text":"Hobbies: Gaming, eating, sleeping"},{"spoiler":false,"text":"Skills: Languages, can sleep anywhere"},{"spoiler":false,"text":"The 366th little sister who was appointed as a teacher. Despite being a genius who has graduated from a medical university outseas, Artemisia is very sloppy and doesn't know how to take care of herself, and hates studying. She came to Japan so she could meet her brother and sisters; at the same time, she thought her life would become easier."}],"source":"vndb","sourceCharacterId":"c33851"},{"segments":[{"spoiler":false,"text":"趣味：食べること、寝ること、ゲーム、特技：語学、どこでも寝られる"},{"spoiler":false,"text":"好きなもの：おやつ、ロボット、うさぎさん、嫌いなもの：にんじん、おかたづけ、なかまはずれ"},{"spoiler":false,"text":"ひみつ：夜中ひとりでトイレに行けない、役職：橘学園教員、たちあがれ妹党　党首"},{"spoiler":false,"text":"政党名：たちあがれ妹党"},{"spoiler":false,"text":"スローガン：おにいちゃんをぶっこわせ！ ～正々堂々妹ハーレム～"},{"spoiler":false,"text":"マニフェスト：みんなしあわせ、いもうとはーれむ"},{"spoiler":false,"text":"突如、教師として赴任してきた366人目の妹。"},{"spoiler":false,"text":"飛び級で大学を卒業し博士号を持つ天才だけど、生活能力は皆無。ズボラでだらしない。"},{"spoiler":false,"text":"日本にやってきたのは、お兄ちゃんやお姉ちゃんに会いたかったから。"},{"spoiler":false,"text":"それに、なかまはずれはさみしくていやだったから。"},{"spoiler":false,"text":"柊に借りた妹ゲーで、エロゲーにハマり"},{"spoiler":false,"text":"ハーレムルートはみんな幸せそうで嬉しかったので、すっかりハーレム推奨派に。"},{"spoiler":false,"text":"「……アルだけ、妹ハーレムに入れてもらえないの？　なかまはずれ？」"}],"source":"egs","sourceCharacterId":"6866","sourceWorkId":"17174","spoiler":false},{"segments":[{"spoiler":false,"text":"突然作为教师赴任的第366个妹妹。"},{"spoiler":false,"text":"虽然是跳级从大学毕业取得博士号的天才，但是毫无生活能力。随便懒散。"},{"spoiler":false,"text":"来日本的理由是想见哥哥和姐姐，还有觉得会很有趣。"},{"spoiler":false,"text":"讨厌学习。讲课不久就让大家自习。"},{"spoiler":false,"text":"很喜欢日本的小众文化，来日后才第一次玩工口游戏。沉迷于后宫游戏。"},{"spoiler":false,"text":"就是因为这样，设立强化妹妹后宫的左派新党『たちあがれ妹党』。"},{"spoiler":false,"text":"政党名： 『たちあがれ妹党』"},{"spoiler":false,"text":"标语： 玩残哥哥！ ～堂堂正正的妹后宫～"},{"spoiler":false,"text":"「蒿太作为长男应该尽力让橘家繁栄。所以成立妹妹后宫吧」"}],"source":"bangumi","sourceCharacterId":"19044"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"19044","value":"吃、睡、游戏"},{"label":"特技","source":"bangumi","sourceCharacterId":"19044","value":"语言学、哪里都能睡着"},{"label":"胸围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"6866","sourceWorkId":"17174","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"132 cm","valueContext":null,"source":"egs","sourceCharacterId":"6866","sourceWorkId":"17174","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"6866","sourceWorkId":"17174","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"6866","sourceWorkId":"17174","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0831527238d73adc81aea0365e9f72f57d4070b35af6d546ff3e924542703633.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fc4ceda89acac446467ab531bec7456986c13b2668a08daf5c91259a5f3b282.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus"