{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"24972","model":{"presentationWorkId":"egs:24972","staff":{"artwork":[],"scenario":[],"music":[{"creditedName":"アサノハヤト(浅野隼人)","creatorId":"vndb:s37186","sourcePersonId":"egs:creator:30702","canonicalEntityId":"vndb:s37186","name":"アサノハヤト(浅野隼人)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:185447","source":"egs"}],"other":[{"creditedName":"岸田メル","creatorId":"egs:creator:29993","sourcePersonId":"egs:creator:29993","canonicalEntityId":"egs:creator:29993","name":"岸田メル","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"alias-only-review","relationId":"egs:work-creator:181922","source":"egs"},{"creditedName":"時雨沢恵一","creatorId":"egs:creator:4834","sourcePersonId":"egs:creator:4834","canonicalEntityId":"egs:creator:4834","name":"時雨沢恵一","detail":"シリーズ構成","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:183905","source":"egs"},{"creditedName":"五十嵐雄策","creatorId":"vndb:s23728","sourcePersonId":"egs:creator:12819","canonicalEntityId":"vndb:s23728","name":"五十嵐雄策","detail":"シリーズ構成","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:183906","source":"egs"},{"creditedName":"夏海公司","creatorId":"egs:creator:30357","sourcePersonId":"egs:creator:30357","canonicalEntityId":"egs:creator:30357","name":"夏海公司","detail":"シリーズ構成","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:183907","source":"egs"},{"creditedName":"さよならポニーテール","creatorId":"egs:creator:30701","sourcePersonId":"egs:creator:30701","canonicalEntityId":"egs:creator:30701","name":"さよならポニーテール","detail":"OP曲「リフレクト」、ED曲「さよなら、笑って」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"no-alias-hit","relationId":"egs:work-creator:185446","source":"egs"},{"creditedName":"岸田メル","creatorId":"egs:creator:29993","sourcePersonId":"egs:creator:29993","canonicalEntityId":"egs:creator:29993","name":"岸田メル","detail":"原案","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:185448","source":"egs"}]},"cast":[{"characterId":"char_bangumi_50647","characterName":"しらい ひなこ","sourceIds":{"bangumi":[{"characterId":"50647","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"しらい ひなこ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0821"},"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"BLUE REFLECTION"},{"spoiler":false,"text":"○关于日菜子"},{"spoiler":false,"text":"就读星宫女子高级中学普通班的少女。高中一年级。"},{"spoiler":false,"text":"曾是被寄予厚望的天才芭蕾舞者，却因伤而不得不退役。"},{"spoiler":false,"text":"芭蕾是日菜子的人生意义。"},{"spoiler":false,"text":"失去了人生意义的她甚至连上学都做不到，每天过着有如行尸走肉的生活。"},{"spoiler":false,"text":"○日菜子的愿望"},{"spoiler":false,"text":"日菜子戴上神秘戒指后变身成反像者，起初这让她有些手足无措。"},{"spoiler":false,"text":"然而，当听说只要打倒所有原种就能实现一个愿望时，她便投身战斗。"},{"spoiler":false,"text":"她的愿望只有一个，那就是“想再跳一次芭蕾舞”。"},{"spoiler":false,"text":"mask○日菜子的决心与最后的战斗"},{"spoiler":false,"text":"就算打倒所有原种，也无法实现愿望。"},{"spoiler":false,"text":"不仅如此，甚至会遗忘小夕和来梦。"},{"spoiler":false,"text":"她们将不复存在于世。"},{"spoiler":false,"text":"即便知道了真相，日菜子仍下定决心要与原种战斗到底。"},{"spoiler":false,"text":"在朋友们的鼓励下，日菜子迎向最后的战斗。"},{"spoiler":false,"text":"○打倒达特后的黄昏"},{"spoiler":false,"text":"日菜子连达特都打倒了，她战胜了所有原种。"},{"spoiler":false,"text":"在傍晚的操场上，她与小夕和来梦度过最后的时光。"},{"spoiler":false,"text":"分离的时刻还是到了。"},{"spoiler":false,"text":"那个瞬间，她心中强烈地希望“要永远记得她们两人”。"},{"spoiler":false,"text":"○日菜子的真正愿望"},{"spoiler":false,"text":"在一个艳阳高照的夏日。"},{"spoiler":false,"text":"日菜子把手上来历不明的戒指当作护身符，走进了校门。"},{"spoiler":false,"text":"就在那时，一道喊着“小菜菜”的声音在脑海一闪而过。"},{"spoiler":false,"text":"她清楚地记得——那两个她所珍视，并且不想遗忘的人。/mask"},{"spoiler":false,"text":"BLUE REFLECTION SUN"},{"spoiler":false,"text":"○在日杜事件中的日菜子"},{"spoiler":false,"text":"隶属于研究机构AASA的反像者，为了调查任务而开始造访日杜。"},{"spoiler":false,"text":"除了AASA的计划之外，日菜子还有一个目标，那就是要通过位于日杜附近的宇宙之牙到达可梦，拯救夕月和来梦。"},{"spoiler":false,"text":"跟诗帆是认识已久的朋友，很喜欢她泡的咖啡。"},{"spoiler":false,"text":"mask○对现在这个世界的责任感"},{"spoiler":false,"text":"来梦和夕月计划把反像者的情感转化为避难所，但就算世界末日将至，日菜子还是拒绝接受这个计划。"},{"spoiler":false,"text":"她认为是她打倒了达特，才导致世界走向毁灭，责任应由她一人承担。"},{"spoiler":false,"text":"最终在大家的劝说下，她参与构筑点滴世界。"},{"spoiler":false,"text":"在末日来临之际，她再次发誓不会忘记夕月和来梦。/mask"},{"spoiler":false,"text":"BLUE REFLECTION TIE"},{"spoiler":false,"text":"○来到学校的日菜子"},{"spoiler":false,"text":"从爱央她们建造的咖啡空间中出现的少女。"},{"spoiler":false,"text":"她失去了记忆，不记得之前见过诗帆。"},{"spoiler":false,"text":"性格沉稳，带有一种仿佛看透世事的气质。"},{"spoiler":false,"text":"虽然她不记得自己曾学过芭蕾舞，但一听到芭蕾舞这个词，内心就会有些不平静。"},{"spoiler":false,"text":"mask○日菜子的过去"},{"spoiler":false,"text":"往日的日菜子是被寄予厚望的天才芭蕾舞者。"},{"spoiler":false,"text":"然而，她在练习中受伤，导致膝盖留下严重的后遗症。"},{"spoiler":false,"text":"芭蕾曾是她的人生意义，再也跳不了芭蕾的她陷入了低潮，而此时夕月和来梦拯救了她。"},{"spoiler":false,"text":"回想起一切后，日菜子决定要与两人再次相见。"},{"spoiler":false,"text":"○与夕月、来梦的重逢"},{"spoiler":false,"text":"日菜子终于和夕月与来梦重逢，向她们倾诉她们不在时她是多么寂寞，吐露出怀疑是自己搞乱了世界的罪恶感。"},{"spoiler":false,"text":"两人的温暖话语拯救了她。"},{"spoiler":false,"text":"三人紧抓住又将分离前的短暂时光，珍惜每一分每一秒。/mask"}],"source":"bangumi","sourceCharacterId":"50647"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd62e89d3d0038d45d009297f2bb29adb93fc3a22efe3e6587f8d4d0bd02e51b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e98362ed0b493af9dde50dab0ddba15b31a46374e77be59407b3bc607b06ca74.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田憂希","creatorId":"vndb:s10197","sourcePersonId":"vndb:s10197","canonicalEntityId":"vndb:s10197","name":"高田 憂希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:50647:18087:1","source":"bangumi"}]},{"characterId":"char_bangumi_50648","characterName":"しじょう ゆづき","sourceIds":{"bangumi":[{"characterId":"50648","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"しじょう ゆづき","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"147"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日菜子にリフレクターの力を与えた謎の少女のひとり。"},{"spoiler":false,"text":"出会った数日後に同じ学校に突然転校してくる。"},{"spoiler":false,"text":"非常に明るくユーモアがあり、誰からも好かれる性格で、一発ギャグが得意。出会ったばかりではあるものの、日菜子のことを第一に考えている。"}],"source":"bangumi","sourceCharacterId":"50648"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5574ba834ce69f18f32498bbb3b1368273e26ec44cb46c351aad6e510a08ca3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56c60bae02eaa6b5b772363825ea738ef230db68bb7ce468017d80506a1fc379.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高野麻里佳","creatorId":"vndb:s12286","sourcePersonId":"vndb:s12286","canonicalEntityId":"vndb:s12286","name":"高野麻里佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:50648:16031:1","source":"bangumi"}]},{"characterId":"char_bangumi_50649","characterName":"しじょう らいむ","sourceIds":{"bangumi":[{"characterId":"50649","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"しじょう らいむ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0327"},"height":{"reviewState":"source-only","source":"bangumi","value":"146"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"36"}},"descriptions":[{"segments":[{"spoiler":false,"text":"BLUE REFLECTION"},{"spoiler":false,"text":"○关于来梦"},{"spoiler":false,"text":"出现在日菜子面前的神秘少女，司城夕月的妹妹。"},{"spoiler":false,"text":"她有时会展现出效率至上的一面，比起他人的心情，她更重视计划的推进和自己的感受。"},{"spoiler":false,"text":"不过，她跟姐姐一样都很重视日菜子。"},{"spoiler":false,"text":"○反像者前辈"},{"spoiler":false,"text":"赋予日菜子反像者力量的人。"},{"spoiler":false,"text":"和姐姐一样，来梦自己也是反像者。"},{"spoiler":false,"text":"是她教会了日菜子反像者的义务和战斗方式。"},{"spoiler":false,"text":"mask○来梦的死亡事故与生前的憧憬"},{"spoiler":false,"text":"在一场连接可梦与现实世界的实验意外中，来梦与夕月双双失去了生命。"},{"spoiler":false,"text":"在数不清的实验空档，她被日菜子的芭蕾舞深深吸引，从此成为日菜子的粉丝。/mask"},{"spoiler":false,"text":"BLUE REFLECTION RAY"},{"spoiler":false,"text":"○月宫事件中的来梦"},{"spoiler":false,"text":"连接可梦与现实世界的少女。司城夕月的妹妹。"},{"spoiler":false,"text":"在星宫事件解决后时间倒流过的世界里，担任着传令者的角色，也同时负责管理可梦。"},{"spoiler":false,"text":"BLUE REFLECTION SUN"},{"spoiler":false,"text":"○散发神秘气息的少女"},{"spoiler":false,"text":"出现在被派遣到出云管区的队长面前的少女。"},{"spoiler":false,"text":"“一直在等你来。”"},{"spoiler":false,"text":"她留下了一句耐人寻味的话便离开了。"},{"spoiler":false,"text":"mask○日杜事件中的来梦"},{"spoiler":false,"text":"和姐姐夕月一起担任可梦的守护者。"},{"spoiler":false,"text":"看着被灰侵蚀、逐渐消逝的世界，为了让人类得以存续，她打算利用队长和特种部队成员的情感，创造出全新的世界。/mask"},{"spoiler":false,"text":"BLUE REFLECTION TIE"},{"spoiler":false,"text":"○来到学校的来梦"},{"spoiler":false,"text":"至今仍在心像空间内沉睡不醒，是夕月的妹妹。"},{"spoiler":false,"text":"点滴世界守护少女们不受外敌侵害，而为了精准维持和管理点滴世界，她倾注了全部心力。"},{"spoiler":false,"text":"一旦情感出现波动，点滴世界的稳定就会受到影响，来梦的负担也会随之加重。"},{"spoiler":false,"text":"可沉睡中的她无法开口说话，所以无从得知她的状态。"},{"spoiler":false,"text":"mask○点滴世界的管理者来梦"},{"spoiler":false,"text":"将反像者聚集到一处，减轻了因少女分散在点滴世界各处造成的管理负担。"},{"spoiler":false,"text":"不仅如此，通过小熊玩偶与日菜子等人产生情感共鸣后，来梦终于醒了过来。"},{"spoiler":false,"text":"原以为再也见不到的的挚友日菜子，就在这个世界，仅此一点，便足以让她对未来抱有希望。/mask"}],"source":"bangumi","sourceCharacterId":"50649"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31782567443e7cc865097ea31089b6106002866bd8e934dd440bcd998bfac7a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d2c7406c3d3bf82c22ee407b46f73a2db3bcfe1ae60bc6898b3dbcacd116602.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秦佐和子","creatorId":"egs:creator:30354","sourcePersonId":"egs:creator:30354","canonicalEntityId":"egs:creator:30354","name":"秦佐和子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:50649:15983:1","source":"bangumi"}]},{"characterId":"char_bangumi_70321","characterName":"いちのせあこ","sourceIds":{"bangumi":[{"characterId":"70321","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"いちのせあこ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"149.7"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"利益やお金に目がなく、大金を稼ぐことを夢見る少女。"},{"spoiler":false,"text":"その行動から場を乱すことが多いものの、どこか憎めない愛嬌のようなものがある。"},{"spoiler":false,"text":"放送部に所属しており、将来はジャーナリスト志望。"}],"source":"bangumi","sourceCharacterId":"70321"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a49c200192390e9d7bfe8bd97b91a55fc9ec99aa2d8a410f0f8b31c9ccecbc69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1833b192c9fbf230923cdca049c10e525d0810c03e5f965346b7360019ec65ff.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花守ゆみり","creatorId":"vndb:s14119","sourcePersonId":"vndb:s14119","canonicalEntityId":"vndb:s14119","name":"花守 ゆみり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:70321:10503:1","source":"bangumi"}]},{"characterId":"char_bangumi_70322","characterName":"いのうえちひろ","sourceIds":{"bangumi":[{"characterId":"70322","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"いのうえちひろ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"152"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"何を考えているかわからない不思議ちゃん。"},{"spoiler":false,"text":"クラスに謎のぬいぐるみを飾るなど、はたから見て迷惑な行動をとるが、それらはすべて他人を思うがゆえの行動である。"},{"spoiler":false,"text":"思いやりのあるとてもいい子だが、それが空回りしてうまく伝わらない。"},{"spoiler":false,"text":"いわば、悪意のないトラブルメーカー。"}],"source":"bangumi","sourceCharacterId":"70322"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a375b8f48db62d2f93f51cb812e50242ffc26333b83cf10e20e68ca771dc90bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfc9a9c8ad3b318f7f80813ea1b49bebfd6145bf111a173abf53e7dde3c931c1.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪彩花","creatorId":"vndb:s13437","sourcePersonId":"vndb:s13437","canonicalEntityId":"vndb:s13437","name":"諏訪彩花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:70322:11247:1","source":"bangumi"}]},{"characterId":"char_bangumi_70323","characterName":"ちいきゆり","sourceIds":{"bangumi":[{"characterId":"70323","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"ちいきゆり","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1214"},"height":{"reviewState":"source-only","source":"bangumi","value":"159"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"BLUE REFLECTION"},{"spoiler":false,"text":"○关于有理"},{"spoiler":false,"text":"天生拥有极高智商的少女。"},{"spoiler":false,"text":"表面上装作是普通的学生，实则不擅长理解他人的情感，也无法清楚表达自己的情感。"},{"spoiler":false,"text":"她察觉到星宫正在发生某些事情，对小夕和来梦尤其感兴趣。"},{"spoiler":false,"text":"○才能与其代价"},{"spoiler":false,"text":"有理年纪轻轻，就已经是能在科学杂志上发表论文的天才。"},{"spoiler":false,"text":"另一方面，她却严重缺乏一般常识。"},{"spoiler":false,"text":"例如她没在便利店消费过，还没结账就吃掉了商品。"},{"spoiler":false,"text":"又例如，她不知道有试衣间这种服务。"},{"spoiler":false,"text":"整体而言，有理的日常生活与社会相当脱节。"},{"spoiler":false,"text":"○对人类的兴趣酝酿"},{"spoiler":false,"text":"有理再怎么精通数学和物理学，都无法理解人的内心。"},{"spoiler":false,"text":"她为此十分苦恼，然而通过与日菜子的相处，她逐渐开始理解何谓情感。"},{"spoiler":false,"text":"现在她已成功和日菜子成为朋友，但在日常生活中依然笨拙如故。"},{"spoiler":false,"text":"BLUE REFLECTION RAY"},{"spoiler":false,"text":"○月宫事件中的有理"},{"spoiler":false,"text":"隶属于研究机构AASA的少女。"},{"spoiler":false,"text":"她潜入月宫女子高级中学，调查发生在月宫的事件。"},{"spoiler":false,"text":"她通过都，向阳樱莉她们提供可梦和敌对反像者的信息。"},{"spoiler":false,"text":"在可梦之门开启后，她仍和都保持联系，并为了守护都的情感，将一枚戒指交给了她。"}],"source":"bangumi","sourceCharacterId":"70323"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb6d92a80ea74bde49569db94d8179a6d068a67f82b36e12e470378ac0dd5377.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79c570bcb64dd9e04941728a11bd671edac9ef2a48a07e68f545c3ac1b483b84.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉綾音","creatorId":"vndb:s3892","sourcePersonId":"vndb:s3892","canonicalEntityId":"vndb:s3892","name":"佐倉 綾音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:70323:5745:1","source":"bangumi"}]},{"characterId":"char_bangumi_70324","characterName":"さなだりん","sourceIds":{"bangumi":[{"characterId":"70324","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"さなだりん","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"155"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"53.5"}},"descriptions":[{"segments":[{"spoiler":false,"text":"テニス部に所属している少女で、そこそこの実力を有する。"},{"spoiler":false,"text":"優柔不断な性格をしているが、思い込んだら一辺倒なところもある。"},{"spoiler":false,"text":"現在、他校の男子に片想い中。"},{"spoiler":false,"text":"お出かけするのが好きで、休日はよく食べ歩きをしている。"}],"source":"bangumi","sourceCharacterId":"70324"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d097712949044745a3733ea90d0e1e23063af6aebc50f3c8f858f4d6fbbd832e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f63bfeea6371b9b2b5c07ddadd26180f81c13b9c5732d6324efed95fd8218fc.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤はるか","creatorId":"egs:creator:30356","sourcePersonId":"egs:creator:30356","canonicalEntityId":"egs:creator:30356","name":"伊藤はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:70324:22632:1","source":"bangumi"}]},{"characterId":"char_bangumi_70325","characterName":"すがもとしほり","sourceIds":{"bangumi":[{"characterId":"70325","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"すがもとしほり","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"162"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"47.5"}},"descriptions":[{"segments":[{"spoiler":false,"text":"独特の雰囲気を持つセクシーな少女。"},{"spoiler":false,"text":"おしゃれなどにも詳しく、美容系の相談に乗ってくれることもある。"},{"spoiler":false,"text":"スタイル抜群な美人で何かと男性から助けられることが多く、さほど苦労をした経験がない。"},{"spoiler":false,"text":"男友達も多数おり、男性とふたりきりで出かけることもしばしば。"},{"spoiler":false,"text":"しかし、しほりにとっては全員等しく友達。"}],"source":"bangumi","sourceCharacterId":"70325"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3b921aef6dffc5c640ab18e0b38ef661975363a5c4dec6c7ddad199ff3aeae5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92af2fba137a261b85fe8f273f6a4bd27b1dcfb039b0cce43a491954118cde95.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小松未可子","creatorId":"vndb:s7545","sourcePersonId":"vndb:s7545","canonicalEntityId":"vndb:s7545","name":"小松 未可子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:70325:7498:1","source":"bangumi"}]},{"characterId":"char_bangumi_70326","characterName":"たやふみお","sourceIds":{"bangumi":[{"characterId":"70326","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"たやふみお","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0112"},"height":{"reviewState":"source-only","source":"bangumi","value":"150"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"35"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○关于史绪"},{"spoiler":false,"text":"就读于特长班，是一位拥有绝对音感的钢琴家。"},{"spoiler":false,"text":"史绪出生在富裕的家庭，在祖母严厉的教育下，她从小就开始学习钢琴。"},{"spoiler":false,"text":"她有个坏毛病，会不小心说出心里的想法和真心话，时常因此惹恼别人。"},{"spoiler":false,"text":"○对死亡行军的亲切感"},{"spoiler":false,"text":"史绪非常执着于追求理想的音色。"},{"spoiler":false,"text":"受到身为系统工程师的父亲影响，她选择以死亡行军的方式来追求，最终体力不支倒下。"},{"spoiler":false,"text":"在失控被制止后，她开始追求考虑到听众的音乐，但她那不顾一切的冲劲依然一点都没变，总会把日菜子卷入其中，丝毫不觉自己造成了他人困扰。"},{"spoiler":false,"text":"○叫人妒恨的天赋"},{"spoiler":false,"text":"无论是程序设计还是下厨。只要觉得有助于弹出理想音色，史绪就会立刻动手尝试。"},{"spoiler":false,"text":"但由于她不太会取舍，总会安排些超出能力范围的任务，导致自己濒临崩溃。"},{"spoiler":false,"text":"即便如此，凭借着与生俱来的天赋，史绪总能在几近崩溃的状态下完美做好每一件事。"}],"source":"bangumi","sourceCharacterId":"70326"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/781d5db8a48d7178827ed56c712eba42e474b5a18b0e453a59605c373e39751b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53be510cacde08e06ed354d2c79251281b9824d77fdc0a2279f26e50ff92f2e6.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白城なお","creatorId":"vndb:s13301","sourcePersonId":"vndb:s13301","canonicalEntityId":"vndb:s13301","name":"白城なお","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190880:70326:26508:1","source":"bangumi"}]},{"characterId":"char_bangumi_70327","characterName":"なりみやけい","sourceIds":{"bangumi":[{"characterId":"70327","match":"source-roster","subjectId":"190880"}]},"originalCharacterName":"なりみやけい","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"168"},"sex":{"reviewState":"source-only","source":"bangumi","