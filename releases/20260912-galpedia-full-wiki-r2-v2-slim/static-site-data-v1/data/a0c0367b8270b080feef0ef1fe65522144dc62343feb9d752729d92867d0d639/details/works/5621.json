こ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:28691","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c101732","characterName":"霧島 拓哉","sourceIds":{"vndbCharacterId":"c101732"},"originalCharacterName":"霧島 拓哉","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c5673","characterName":"真聡","sourceIds":{"vndbCharacterId":"c5673"},"originalCharacterName":"真聡","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A boy who appears in a lot of Navel and Basil games, and mischievously lifts the skirts of the heroines."},{"spoiler":false,"text":"adapted from Danbooru Wiki"}],"source":"vndb","sourceCharacterId":"c5673"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6589525f41c85aec2c8de9016d0a1682da1e1ecef786c599c9882c5896fe1926.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3f2f456febf3432aa881d956b3b94c3b0a36b8e72d05c79371140074868ed92.webp","width":205,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c9546","characterName":"榊　芹","sourceIds":{"vndbCharacterId":"c9546"},"originalCharacterName":"榊　芹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend. She became a nurse to help him. She is the woman closest to the protagonist and the one that understands his pain the most. She is always cheerful and positive, but she can be a little violent towards the protagonist. But that is all intended to cheer him up, and she worries about him more than anyone else. Her feelings are obviously romantic."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9546"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6956b2b305fe381ce8e2d84eb92d9cca35b8c1355eaab86c034b0f7f96db192d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f26a54e44378e4bbdb68ea8752f04f5a077d267877807c0c6240a2df065fc2f.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川澄 綾子","creatorId":"vndb:s16","sourcePersonId":"vndb:s16","canonicalEntityId":"vndb:s16","name":"川澄 綾子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15043","source":"vndb"}]},{"characterId":"char_vndb_c9547","characterName":"橘　唯奈","sourceIds":{"vndbCharacterId":"c9547"},"originalCharacterName":"橘　唯奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"In the same way that the protagonist lost his mother and decided to become a doctor, she lost her brother and decided on the same goal. However, she was not able to realize that dream... Now, she is seeking it. A person to whom she can entrust her dream. And the power to grant her own dream again."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9547"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a4efe26ba0f71139f22e3145c60ea74336bedad62dea55bb8166d8ae109c563.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aff11ef0b84589aaf8e91f15933eb7d0ee8a1a91c0ee9ed66b519c401b12b49.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野 五月","creatorId":"vndb:s474","sourcePersonId":"vndb:s474","canonicalEntityId":"vndb:s474","name":"ゆきの さつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15044","source":"vndb"}]},{"characterId":"char_vndb_c9548","characterName":"二見　美魚","sourceIds":{"vndbCharacterId":"c9548"},"originalCharacterName":"二見　美魚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who was admitted to the hospital that the protagonist previously worked at. Her illness was unknown, an incurable disease with no treatment. She was discharged and able to live normally as long as she didn't have any fits. She feels affection towards the protagonist, who made eager efforts to cure her, but it is the feeling of a younger sister who depends too much on her older brother, not the feeling of love."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9548"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed334d13036924559deb1250de0a36d213cf96e206170035316e2b59ad1f3560.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90c446b8f1057e5ca8b268bb8e96dd042d91ee4d6f5403fb869bb64f9a2b4d70.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日向 裕羅","creatorId":"vndb:s562","sourcePersonId":"vndb:s562","canonicalEntityId":"vndb:s562","name":"日向 裕羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15045","source":"vndb"}]},{"characterId":"char_vndb_c9549","characterName":"二見　真魚","sourceIds":{"vndbCharacterId":"c9549"},"originalCharacterName":"二見　真魚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A taciturn and unsociable girl, however, she is also a gentle girl that worries about her younger sister more than anyone else. She wants to become a doctor for the sake of curing her little sister. She holds light feelings of love for the protagonist who puts in maximum efforts without sparing anything to save patients. She wants to become a doctor like him."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9549"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e96ac5cc7a361598410ac7c32b15f163b6a9045c01d9d2cf6742ac66638ddf6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1215d847f8a8e52820fe7be58b27b14e8fe0cab7eec17870c6f02c2915aa7506.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長沢 美樹","creatorId":"vndb:s1385","sourcePersonId":"vndb:s1385","canonicalEntityId":"vndb:s1385","name":"長沢 美樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15048","source":"vndb"}]},{"characterId":"char_vndb_c9550","characterName":"汽京　紅葉","sourceIds":{"vndbCharacterId":"c9550"},"originalCharacterName":"汽京　紅葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The hospital's cheerful, carefree, positive thinker. But her manners are good, and the patients deeply rely on her. Her mother was a talented doctor, and she herself matches her mother's skills. Together with the protagonist, there are big expectations for the future."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9550"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0262dfee5c4268af56091b30c1ea96b08e772674d6c713c4703c965b98d047b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8064680530e3560d8d2ed0b196957a50426f673704732ed145fdabd7aaa13679.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三石 琴乃","creatorId":"vndb:s626","sourcePersonId":"vndb:s626","canonicalEntityId":"vndb:s626","name":"三石琴乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15046","source":"vndb"}]},{"characterId":"char_vndb_c9551","characterName":"一ノ瀬　木葉","sourceIds":{"vndbCharacterId":"c9551"},"originalCharacterName":"一ノ瀬　木葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who is honest with her own feelings - during fun times she will laugh with all her might, and during sorrowful times she will cry in a loud voice. She is mischievous and often gets caught by the nurses."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ec3da0b86af7673528f68ca77236c1b830310b9b366af298403dc9ec145fdb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aee3e589f1e0ae1a9ad459f776a2457a81e24454a6b4444e2b8450cce709b1e8.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南 央美","creatorId":"vndb:s1870","sourcePersonId":"vndb:s1870","canonicalEntityId":"vndb:s1870","name":"南 央美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15049","source":"vndb"}]},{"characterId":"char_vndb_c9552","characterName":"三原　香澄","sourceIds":{"vndbCharacterId":"c9552"},"originalCharacterName":"三原　香澄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Konoha's friend that often visits her in the hospital. She is a very healthy girl that can't calm down if she doesn't move her body. Whatever she does, she does it noisily. She is older that Konoha, but she certainly doesn't seem like it. She loves and respects her twin brother in a way that is not just sibling affection. It has already reached the level of love between a man and a woman."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/874021e0c5defe9f728fbb1593be27b86c917a0d9c9c6c31fbe76c4115d3f3cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20bd407e238181513b0637b4b336091ec03fb4b1b21298eb8aa2b47ac9e011a0.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飯塚 雅弓","creatorId":"vndb:s1383","sourcePersonId":"vndb:s1383","canonicalEntityId":"vndb:s1383","name":"飯塚 雅弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15047","source":"vndb"}]},{"characterId":"char_vndb_c9553","characterName":"狭川　翠","sourceIds":{"vndbCharacterId":"c9553"},"originalCharacterName":"狭川　翠","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A waitress who works part time at the tea shop and stand in the hospital. She wears a considerably special uniform that is popular among some enthusiasts. She always does things at her pace, but she is brimming with curiosity. If she becomes a little interested in something she will immediately stick her nose into it. Although she is unexpectedly a level-headed person, she has some careless points."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9553"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac9aa901de066d8195f9adef353b369a27df9221dd42a80ff225d4606729e4d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9012fd1a6df25c4b8ab1ce9b883ddd0b94a3b9112de03dbe3f9b6aa10e11f99.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊嶋 真千子","creatorId":"vndb:s11232","sourcePersonId":"vndb:s11232","canonicalEntityId":"vndb:s11232","name":"豊嶋 真千子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15050","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p22","sourceCompanyId":"egs:brand:683","canonicalEntityId":"vndb:p22","name":"Princess Soft","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:5621:683","source":"egs"},{"companyId":"vndb:p22","sourceCompanyId":"vndb:p22","canonicalEntityId":"vndb:p22","name":"プリンセスソフト","roleCodes":["publish