:"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Otoya is an energetic, cheerful and kind boy. He is a positive and friendly person who enjoys singing and playing sports."},{"spoiler":false,"text":"Despite his age, he acts like a child and is always straightforward and honest."},{"spoiler":false,"text":"He is afraid of heights and plays the guitar."},{"spoiler":false,"text":"He shares a room with Tokiya from Class S and is in Class A."}],"source":"vndb","sourceCharacterId":"c4829"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b761207fa8ab0d6ccea671597f7567e64c41ce7c35f27b7c833d13db66dc6e11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/193a6e1e8ccf2b665dcd9baa3f20ce503ef6eb0b5282ffd228e14c0f7862515a.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺島 拓篤","creatorId":"vndb:s63","sourcePersonId":"vndb:s63","canonicalEntityId":"vndb:s63","name":"寺島 拓篤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28460","source":"vndb"}]},{"characterId":"char_vndb_c4831","characterName":"聖川 真斗","sourceIds":{"vndbCharacterId":"c4831"},"originalCharacterName":"聖川 真斗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1229"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Masato is the oldest son and heir to the Hijirikawa Group. He was raised in a strict environment, making him very serious and because of that, his way of thinking is a little old-fashioned."},{"spoiler":false,"text":"He's unable to show his real self due to his serious nature and seems to have some form of rivalry going on with Ren, whom he knows since he was little. He plays the piano."},{"spoiler":false,"text":"He shares a room with Ren from Class S and is in Class A."},{"spoiler":false,"text":"Based on Wikipedia"}],"source":"vndb","sourceCharacterId":"c4831"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/138f06bfe7d4bc0d8275e732cc6d9b640b0453ff25cd996150b0ef0511fefb9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14e99e0c35039a00e0293765ec4fb395d3ef45fdf544eabf69115e094a09ce73.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴村 健一","creatorId":"vndb:s90","sourcePersonId":"vndb:s90","canonicalEntityId":"vndb:s90","name":"鈴村 健一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28464","source":"vndb"}]},{"characterId":"char_vndb_c4832","characterName":"四ノ宮 那月","sourceIds":{"vndbCharacterId":"c4832"},"originalCharacterName":"四ノ宮 那月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"609"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"186"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Natsuki is a kind boy who's fond of cute things, because of this, he's very affectionate towards Haruka and specially Shou, whom he thinks to be very adorable. He also likes cooking, though the result is always disastrous."},{"spoiler":false,"text":