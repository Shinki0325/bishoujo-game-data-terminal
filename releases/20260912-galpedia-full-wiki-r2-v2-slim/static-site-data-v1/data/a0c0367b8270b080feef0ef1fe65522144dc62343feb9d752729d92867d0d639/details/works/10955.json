canonicalEntityId":"vndb:s8286","name":"栗林","detail":"マップ・ユニット","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112249","source":"egs"},{"creditedName":"Tulip Goddess Maria","creatorId":"vndb:s27522","sourcePersonId":"vndb:s27522","canonicalEntityId":"vndb:s27522","name":"Amy Osteraas","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:175520","source":"vndb"},{"creditedName":"Tulip Goddess Maria","creatorId":"vndb:s27522","sourcePersonId":"vndb:s27522","canonicalEntityId":"vndb:s27522","name":"Amy Osteraas","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:175521","source":"vndb"},{"creditedName":"Vodka","creatorId":"vndb:s27580","sourcePersonId":"vndb:s27580","canonicalEntityId":"vndb:s27580","name":"Vodka","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175522","source":"vndb"},{"creditedName":"Ludo-Rathowm","creatorId":"vndb:s38718","sourcePersonId":"vndb:s38718","canonicalEntityId":"vndb:s38718","name":"Ludo-Rathowm","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:175523","source":"vndb"},{"creditedName":"Ludo-Rathowm","creatorId":"vndb:s38718","sourcePersonId":"vndb:s38718","canonicalEntityId":"vndb:s38718","name":"Ludo-Rathowm","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:175524","source":"vndb"},{"creditedName":"Roven-Pan","creatorId":"vndb:s38719","sourcePersonId":"vndb:s38719","canonicalEntityId":"vndb:s38719","name":"Roven-Pan","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:175525","source":"vndb"},{"creditedName":"Roven-Pan","creatorId":"vndb:s38719","sourcePersonId":"vndb:s38719","canonicalEntityId":"vndb:s38719","name":"Roven-Pan","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:175526","source":"vndb"},{"creditedName":"Sandrio","creatorId":"vndb:s38720","sourcePersonId":"vndb:s38720","canonicalEntityId":"vndb:s38720","name":"Sandrio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175527","source":"vndb"},{"creditedName":"いってんちろく","creatorId":"vndb:s693","sourcePersonId":"vndb:s693","canonicalEntityId":"vndb:s693","name":"いってんちろく","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:175530","source":"vndb"}]},"cast":[{"characterId":"char_c11970","characterName":"見当 かなみ","sourceIds":{"bangumi":[{"characterId":"22097","match":"source-roster","subjectId":"11157"},{"characterId":"22097","match":"source-roster","subjectId":"11158"},{"characterId":"22097","match":"source-roster","subjectId":"11162"},{"characterId":"22097","match":"exact-normalized-name-in-linked-work","subjectId":"11168"},{"characterId":"22097","match":"source-roster","subjectId":"11168"},{"characterId":"22097","match":"source-roster","subjectId":"118055"},{"characterId":"22097","match":"exact-normalized-name-in-linked-work","subjectId":"134929"},{"characterId":"22097","match":"source-roster","subjectId":"134929"},{"characterId":"22097","match":"source-roster","subjectId":"1795"},{"characterId":"22097","match":"exact-normalized-name-in-linked-work","subjectId":"19750"},{"characterId":"22097","match":"source-roster","subjectId":"19750"},{"characterId":"22097","match":"exact-normalized-name-in-linked-work","subjectId":"226254"},{"characterId":"22097","match":"source-roster","subjectId":"226254"},{"characterId":"22097","match":"source-roster","subjectId":"238552"},{"characterId":"22097","match":"source-roster","subjectId":"347533"},{"characterId":"22097","match":"source-roster","subjectId":"450504"},{"characterId":"22097","match":"source-roster","subjectId":"75442"},{"characterId":"22097","match":"source-roster","subjectId":"75508"},{"characterId":"22097","match":"source-roster","subjectId":"76134"},{"characterId":"22097","match":"source-roster","subjectId":"80316"},{"characterId":"22097","match":"source-roster","subjectId":"83856"},{"characterId":"22097","match":"exact-normalized-name-in-linked-work","subjectId":"88739"},{"characterId":"22097","match":"source-roster","subjectId":"88739"},{"characterId":"22097","match":"exact-normalized-name-in-linked-work","subjectId":"98078"},{"characterId":"22097","match":"source-roster","subjectId":"98078"}],"egsCharacterIds":["3282"],"vndbCharacterId":"c11970"},"originalCharacterName":"見当 かなみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"15"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"503"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Lia's personal ninjas, she does all the dirty or secret jobs that Lia orders her to do. While seemingly apathetic from the outside, Kanami is actually very concerned with her ability as a ninja. It's implied that she is always training by herself to hone her skills. She longs to be a normal girl, but that's an impossible dream. Lia ordered her to keep tabs on Rance, a job that she hates since she also hates him."},{"spoiler":true,"text":"She later fell in love with Rance and gave birth to his daughter, Kentou Uzume."}],"source":"vndb","sourceCharacterId":"c11970"},{"segments":[{"spoiler":false,"text":"リーザス王女リアの直属忍者。"},{"spoiler":false,"text":"小柄で素早く、忍者としての力をおおいに発揮するが、"},{"spoiler":false,"text":"出身のJAPANの忍者の里では中忍程度。"},{"spoiler":false,"text":"女の色香を使う『くのいち』の技は未修得。"}],"source":"egs","sourceCharacterId":"3282","sourceWorkId":"3852","spoiler":false},{"segments":[{"spoiler":false,"text":"リア専属の忍者。"},{"spoiler":false,"text":"忍者としての能力はそれほど低くはないのだが、天才的な鈴女とは残念ながら比べ物にならない。"},{"spoiler":false,"text":"現在は、リアの命令でランスの警護という名の監視を行っているが、"},{"spoiler":false,"text":"過去、ちょっかいを出された事も多く、ランスの事はあまり好きではない。"}],"source":"egs","sourceCharacterId":"3282","sourceWorkId":"14858","spoiler":false},{"segments":[{"spoiler":false,"text":"リーザス王国女王の直属の忍者。"},{"spoiler":false,"text":"ランスがリーザス国内でのある事件を調べていた時、女王（当時は王女）リアの命令による妨害工作を仕掛けてランスと出会った。"},{"spoiler":false,"text":"以来、ランスにベタ惚れになってしまったリアの命令でランスの監視任務についていることが多く、だいたいはランスがいる部屋の天井裏にいる。"},{"spoiler":false,"text":"小柄で素早く、忍者の能力はそこそこあるのだが、本人は普通の女の子として幸せになりたいと願っている。"}],"source":"egs","sourceCharacterId":"3282","sourceWorkId":"19702","spoiler":false},{"segments":[{"spoiler":false,"text":"以前はリーザス王女直属で、今はランス専属の女忍者。"},{"spoiler":false,"text":"才能はあるのだが、いまいち修行が中途半端になってしまった永遠の発展途上忍。"},{"spoiler":false,"text":"「見当」は本当は苗字ではなく忍者として授かった別名。"}],"source":"egs","sourceCharacterId":"3282","sourceWorkId":"20764","spoiler":false},{"segments":[{"spoiler":false,"text":"リーザス王女リアに仕える忍者。"},{"spoiler":false,"text":"主人と任務に忠実で、冷静に行動しようと努める普通の女の子。"},{"spoiler":false,"text":"「最っ低……初めて会った時から思ってたけど　やっぱ最低ね……」"}],"source":"egs","sourceCharacterId":"3282","sourceWorkId":"22060","spoiler":false},{"segments":[{"spoiler":false,"text":"现任利萨斯女王莉雅的直属女忍者，mask出身于位于JAPAN关东地区的风魔忍军。在年幼的时候到大陆去游学，但在途中与朋友走散，在利萨斯被莉雅捡到后服侍于她，因此被风魔忍军视为逃忍（抜け忍）。（初期设定是在战场上为莉亚所救。）只听从莉雅的命令，负责谍报与暗杀作业。在小光诱拐事件后与兰斯成了孽缘，负责当他与女王之间的联络人。刚开始时极为讨厌与兰斯做爱，但因为莉雅的命令就是要服侍兰斯，所以无法脱离这个不幸。加奈美是兰斯十位命运中的女人（運命の女）之一。原本是一位不管任务多么困难都会泰然处之的女忍者，不过随着年纪增长开始对“普通女孩子的生活”产生憧憬。忍术方面并不大出色，但因为时常与兰斯做爱，才能限界也因此提升。如果只看才能界限，还是有十万人选一的卓越才能。伊贺忍军首领犬饲认为如果她多加努力的话可以达到中忍水准。与利萨斯红色军团副将美娜德‧西塞是好朋友。在《战国》中回到故乡JAPAN，发觉自己的忍术才能跟故乡的忍者相较之下显得微不足道。曾接受伊贺忍者首领犬饲的锻炼。在《Quest》中，接受了变成幽灵的铃女加强忍术各项才能的基础训练。/mask"},{"spoiler":false,"text":"喜欢穿带有青蛙 logo 的内衣。"}],"source":"bangumi","sourceCharacterId":"22097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6d7fc1f850ef8bdc5a6ea3a299b3748f8c77d6124bc691d3142d2d05acb02e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d352e60c62354dbf830c097cef8cea22e173ce383d40b9d8999f2ee0a914bbae.webp","width":120,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c2865","characterName":"犬飼","sourceIds":{"bangumi":[{"characterId":"189477","match":"exact-normalized-name-in-linked-work","subjectId":"1795"}],"egsCharacterIds":["12766"],"vndbCharacterId":"c2865"},"originalCharacterName":"犬飼","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"GI988年"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young head of the ninja house Iga. He fights to protect the social status and rights of ninjas. His specialty is manipulating animals, especially dogs."}],"source":"vndb","sourceCharacterId":"c2865"},{"segments":[{"spoiler":false,"text":"【勢力：伊賀家】"},{"spoiler":false,"text":"忍者の為の忍者の国と忍者の秩序を作ろうと理想に燃える、若き忍者頭。"}],"source":"egs","sourceCharacterId":"12766","sourceWorkId":"8134","spoiler":false},{"segments":[{"spoiler":false,"text":"伊賀忍者の若き頭領。伊賀家当主。実力は伊賀では鈴女に次ぐNo.2で、JAPANでも屈指。"}],"source":"bangumi","sourceCharacterId":"189477"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14678566626b75c19403d1db88326923983cb6ae992b7becca11ac10c3d72389.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13c5f426f6d724f07b46bbf9c89aa5497b32643b2ef1f685bc0caf3c092003ea.webp","width":256,"height":214,"source":"static-detail"},"actors":[]},{"characterId":"char_c2868","characterName":"千姫","sourceIds":{"bangumi":[{"characterId":"23090","match":"source-roster","subjectId":"11162"},{"characterId":"23090","match":"exact-normalized-name-in-linked-work","subjectId":"1795"},{"characterId":"23090","match":"source-roster","subjectId":"1795"},{"characterId":"23090","match":"source-roster","subjectId":"19750"},{"characterId":"23090","match":"source-roster","subjectId":"226254"},{"characterId":"23090","match":"source-roster","subjectId":"347533"},{"characterId":"23090","match":"source-roster","subjectId":"450504"},{"characterId":"23090","match":"source-roster","subjectId":"88739"}],"egsCharacterIds":["12769"],"vndbCharacterId":"c2868"},"originalCharacterName":"千姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"23"},"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"GI1000年"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Originating as a princess from a conflicted region in Nippon, she possesses an unexplainable passion for battles, especially those where her forces face near-annihilation."},{"spoiler":false,"text":"In LP5, her clan was devastated by youkai tanuki, and she was imprisoned in a dungeon, only to be rescued by Rance."},{"spoiler":false,"text":"Following the establishment of peace in Nippon, she embarked on a quest in pursuit of warfare."},{"spoiler":false,"text":"Her fervor for combat has earned her the moniker \"戦姫\" (pronounced Senhime, which means \"war princess\")."},{"spoiler":false,"text":"Based on in-game Trivia"},{"spoiler":true,"text":"At the climax of the Helmanian Revolution in Rance IX, it was revealed that Sen had become pregnant by Rance. Following the birth of their child, Tokugawa Tone, Sen decided to retire from her life as a warrior and put down her weapon for good."}],"source":"vndb","sourceCharacterId":"c2868"},{"segments":[{"spoiler":false,"text":"【勢力：徳川家】"},{"spoiler":false,"text":"元三河を支配していた一族の姫。"},{"spoiler":false,"text":"大抵の武士は家康を恐れ、言いなりになり狸の着ぐるみを着て徳川家に仕えているが、"},{"spoiler":false,"text":"野獣のように抵抗してくる千姫は怖いので地下牢に閉じこめられている。"},{"spoiler":false,"text":"戦好きの乱暴姫なのでみんな”戦姫”と呼んでいる。"}],"source":"egs","sourceCharacterId":"12769","sourceWorkId":"8134","spoiler":false},{"segments":[{"spoiler":false,"text":"大陸の東にある島国ＪＡＰＡＮ出身の傭兵。本名は徳川千。"},{"spoiler":false,"text":"戦乱が続いていたＪＡＰＡＮの一国の姫として生まれるも、"},{"spoiler":false,"text":"なぜか大の戦好き、しかもほぼ全滅するぐらいの負け戦が"},{"spoiler":false,"text":"たまらないという性格に育ってしまった。"},{"spoiler":false,"text":"妖怪狸に家を滅ぼされ、地下牢に閉じ込められていたところを"},{"spoiler":false,"text":"ランスに助けられた。"},{"spoiler":false,"text":"平和になったＪＡＰＡＮを出て、戦いを求めて旅をしている。"}],"source":"bangumi","sourceCharacterId":"23090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebeb54a9e961a7d1b037bc0afdb805328df5fccbb80a381149d275b58620fc34.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/290e7af28866bfcb387859df71d53f0cd2b25b368b2a433f23fb4dbe54740b17.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c736","characterName":"鈴女","sourceIds":{"bangumi":[{"characterId":"13427","match":"exact-normalized-name-in-linked-work","subjectId":"1795"},{"characterId":"13427","match":"exact-normalized-name-in-linked-work","subjectId":"19750"}],"egsCharacterIds":["11300"],"vndbCharacterId":"c736"},"originalCharacterName":"鈴女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"GI1002年"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"161cm、30cm(灵体)"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"0kg(灵体)"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a super kunoichi from JAPAN."},{"spoiler":false,"text":"She is an expert in assassination and spying enemies in JAPAN."},{"spoiler":false,"text":"Of course, she is also an \"ero\" expert too."},{"spoiler":false,"text":"In her past she attempted to take Rance's life away. However, she becomes Rance's bodyguard after she falls in love with him."},{"spoiler":false,"text":"Edited and roughly translated from Getchu"},{"spoiler":false,"text":"In Sengoku Rance:"},{"spoiler":false,"text":"The best kunoichi in Japan. Gifted with talent, she can master most ninjutsu without effort. She has assassinated over 100 influential people, with a success rate of 100%. She used to have rivals, but she's defeated them all. She's often bored because there isn't anyone strong enough to compete with her."}],"source":"vndb","sourceCharacterId":"c736"},{"segments":[{"spoiler":false,"text":"【勢力：伊賀家】"},{"spoiler":false,"text":"JAPANでも最強クラスのくのいち。"},{"spoiler":false,"text":"忍者としての腕も超一流だが、"},{"spoiler":false,"text":"エロテクを使ったくのいち暗殺術でどんな強い男もイチコロ。"},{"spoiler":false,"text":"明るくて元気で前向き。"},{"spoiler":false,"text":"何故かランスの事を気に入りつきまとう"}],"source":"egs","sourceCharacterId":"11300","sourceWorkId":"8134","spoiler":false},{"segments":[{"spoiler":false,"text":"JAPAN出身の超天才くのいち。"},{"spoiler":false,"text":"諜報・暗殺などの技術はJAPAN一。"},{"spoiler":false,"text":"もちろん、エロい事もバッチリ。"},{"spoiler":false,"text":"過去にランスの命を狙ったが、ランスの事が気に入り、以後、そばでランスを護り続けている。"}],"source":"egs","sourceCharacterId":"11300","sourceWorkId":"14858","spoiler":false},{"segments":[{"spoiler":false,"text":"在JAPAN伊贺村中成长的天才女忍者"},{"spoiler":false,"text":"不喜欢让人痛苦的古板戒律"},{"spoiler":false,"text":"本计划拼上性命暗杀兰斯"},{"spoiler":false,"text":"可反而喜欢上兰斯，成了叛逃忍者"}],"source":"bangumi","sourceCharacterId":"13427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41c989916684f3e3cfa31ba8df2829c17bf7917177c11c409e2f70537452ca4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a7d2d54610969a9019f7e91ac0b12427672b73ad5877abbba4dc7c579688cdb.webp","width":173,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c79865","characterName":"プルーペット","sourceIds":{"vndbCharacterId":"c79865"},"originalCharacterName":"プルーペット","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"38"},"height":{"reviewState":"source-only","source":"vndb","value":"100"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Pluepet is a talented merchant born in the free city of Portugal in GI980. He travels to all sorts of places as a travelling merchant selling rare goods. He appeared in most Rance games after the 4.x games, and also made appearances in Toushin Toshi games."},{"spoiler":false,"text":"He's a strange green creature that travels around in something that resembles a spaceship. His race is unknown but he's probably some rare type of monster. Personality-wise, he's a businessman. He's a very skilled and clever individual that knows how to trade, but he's also very cruel and cold, showing no interest in everything outside of selling his goods and making money. He completely lacks morality and will do whatever he considers will bring the best earning, regardless if it's selling drugs, slaves or innocent girls as prostitutes. He simply sees everything around him as a means to trade and increase profits, and is perfectly fine with helping people as well if he thinks it will be profitable."},{"spoiler":false,"text":"From AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c79865"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06a15c79da4cce227d6ae2e0ff9a61ee952e42f6d72d88df2d282b206afcfb8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c62b9d1ba5718363eb0fe6bae612763b447b30544aa6903401cd66fc2a8d4b5a.webp","width":168,"height":188,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p120","sourceCompanyId":"egs:brand:30","canonicalEntityId":"vndb:p120","name":"ALICESOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10955:30","source":"egs"},{"companyId":"vndb:p120","sourceCompanyId":"vndb:p120","canonicalEntityId":"vndb:p120","name":"アリスソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:90114:v31408","source":"vndb"},{"companyId":"vndb:p3193","sourceCompanyId":"vndb:p3193","canonicalEntityId":"vndb:p3193","name":"2.0 Translations","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:90115:v31408","source":"vndb"},{"companyId":"vndb:p12268","sourceCompanyId":"vndb:p12268","canonicalEntityId":"vndb:p12268","name":"卡拉保护协会","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:91716:v31408","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
