{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"5803","model":{"presentationWorkId":"vndb:v862","staff":{"artwork":[],"scenario":[{"creditedName":"菜の花すみれ","creatorId":"vndb:s2083","sourcePersonId":"egs:creator:4919","canonicalEntityId":"vndb:s2083","name":"菜の花すみれ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21182","source":"egs"}],"music":[{"creditedName":"Elements Garden","creatorId":"vndb:s557","sourcePersonId":"egs:creator:2307","canonicalEntityId":"vndb:s557","name":"Elements Garden","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16502","source":"egs"},{"creditedName":"藤間 仁","creatorId":"vndb:s1710","sourcePersonId":"vndb:s1710","canonicalEntityId":"vndb:s1710","name":"藤間 仁","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:16832","source":"vndb"},{"creditedName":"上松 範康","creatorId":"vndb:s2311","sourcePersonId":"vndb:s2311","canonicalEntityId":"vndb:s2311","name":"上松 範康","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:16833","source":"vndb"}],"other":[{"creditedName":"佐藤ひろ美(佐藤裕美)","creatorId":"vndb:s398","sourcePersonId":"egs:creator:4525","canonicalEntityId":"vndb:s398","name":"佐藤ひろ美(佐藤裕美)","detail":"OP曲 「Angelic Symphony」、ED曲 「Eternal Love 2004」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:145226","source":"egs"},{"creditedName":"かなん","creatorId":"vndb:s16503","sourcePersonId":"egs:creator:3520","canonicalEntityId":"vndb:s16503","name":"かなん","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16832","source":"egs"},{"creditedName":"Aroduc","creatorId":"vndb:s39716","sourcePersonId":"vndb:s39716","canonicalEntityId":"vndb:s39716","name":"Aroduc","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:16831","source":"vndb"},{"creditedName":"佐藤 裕美","creatorId":"vndb:s398","sourcePersonId":"vndb:s398","canonicalEntityId":"vndb:s398","name":"佐藤 ひろ美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:16834","source":"vndb"},{"creditedName":"木谷 高明","creatorId":"vndb:s10618","sourcePersonId":"vndb:s10618","canonicalEntityId":"vndb:s10618","name":"木谷 高明","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:16835","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c809","characterName":"ミルフィーユ・桜葉","sourceIds":{"vndbCharacterId":"c809"},"originalCharacterName":"ミルフィーユ・桜葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Milfeulle Sakuraba is a member of the Moon Angel Troupe. Her hobby is cooking snacks, particularly cake, and making tea. She pilots the Emblem Frame Lucky Star."},{"spoiler":false,"text":"Milfeulle is always caring and cheerful and will never hesitate to help another person, even an enemy. Her extreme luck caused her little but trouble when she was younger and the isolation, combined with her highly emotional nature, causes her to blame herself and her power whenever something goes wrong. Milfeulle is the most naive of the Angels and, though not stupid by any means, she can be clueless and accident-prone. She is incredibly slow to anger, usually becoming sad or disappointed if displeased. Otherwise she is extremely expressive, often accompanying her moods with exaggerated speech and body language. Likewise, she is almost incapable of hatred or antagonism; rather than hating Eonia for what he has done she finds it sad that he is willing to drown the galaxy in blood just because he is unhappy. Milfeulle also dislikes the idea of anyone dying for anyone else, no matter how noble the cause, since it would still create sadness for the loved ones left behind."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c809"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/622d672294ef70cd307f3d20aa08beaa6e29fe29a2f2282ee8a79fe9e3cdb9ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d87738ffe7a9eb9726b22349a79af93cf7e00cfa692aae401f8d484ecaed9f2c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新谷 良子","creatorId":"vndb:s3626","sourcePersonId":"vndb:s3626","canonicalEntityId":"vndb:s3626","name":"新谷 良子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8381","source":"vndb"}]},{"characterId":"char_vndb_c811","characterName":"タクト・マイヤーズ","sourceIds":{"vndbCharacterId":"c811"},"originalCharacterName":"タクト・マイヤーズ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tact was defined by three things: his carefree attitude, his empathic nature and his sharp mind. While on the surface he appeared to be unreliable and lazy, he was actually a highly competent strategist and tactician. As his friend Lester remarks at one point, while Tact's behavior is embarrassing at times, he is at his best when it matters the most."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b85dee44c7523e3a1cc814899da647214edd2e9b556b4c8be6553bf9456f4420.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0de390dfb9b10d72f5904ee17b62d0801c489f770fa060f1d8fa59472b805aa6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上田 祐司","creatorId":"vndb:s1443","sourcePersonId":"vndb:s1443","canonicalEntityId":"vndb:s1443","name":"うえだ ゆうじ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8378","source":"vndb"}]},{"characterId":"char_vndb_c812","characterName":"ヴァニラ・H","sourceIds":{"vndbCharacterId":"c812"},"originalCharacterName":"ヴァニラ・H","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"height":{"reviewState":"source-only","source":"vndb","value":"132"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vanilla H is the youngest member of the Moon Angel Troupe, and she pilots the Emblem Frame GA-005, also known as Harvester. She has the ability to control nanomachines, which allowes her to treat wounds, and with the assistance of Harvester, repair machinery as well."},{"spoiler":false,"text":"A very stoic girl, she hardly ever showed any emotion and spoke in a deadpan voice. She was always seen wearing a headgear featuring a red gem on top, possibly a mark of her family or religion."},{"spoiler":false,"text":"Age 13 in GA and 14 in the later games."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c812"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85263a8e146bbc6cce863b40516757763e4dcc23fc3302a04b319721b65e0b11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82302d5ee9bd74b45813a2425f4178cf1bb6ee1530c67c17c0cacec4129cd853.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かない みか","creatorId":"vndb:s1818","sourcePersonId":"vndb:s1818","canonicalEntityId":"vndb:s1818","name":"かない みか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8379","source":"vndb"}]},{"characterId":"char_vndb_c813","characterName":"烏丸ちとせ","sourceIds":{"vndbCharacterId":"c813"},"originalCharacterName":"烏丸ちとせ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chitose is a member of the Moon Angel Troupe and pilots the Emblem Frame Sharp Shooter."},{"spoiler":false,"text":"A traditional, polite, and soft-spoken young woman, Chitose joined the military for two reasons; for her respect and admiration for both her father and the Angel Troupe. Extremely intelligent, Chitose became an elite within the military, scoring the highest marks ever in the military exam, defeating even Milfeuille (whom scored the second highest due to her luck)."},{"spoiler":false,"text":"Highly experienced in archery, Chitose ends up being chosen as the pilot of the 6th Angel Frame, the \"Sharp Shooter\", which is designed for extreme range sniping. Chitose greatly respects her friends/teammates in the Angel Troupe, to the point where she wishes not to do anything that might offend them, even to the point of forcing herself to suppress her growing feelings for Tact."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c813"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64807d36150ef8dc84d7a4a600db7695524bce8c30903732a16b2284fc1e66d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e496f9db627476c954999608cdbf652a00e9bd400569505f78aad0522a18d5b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 沙緒里","creatorId":"vndb:s244","sourcePersonId":"vndb:s244","canonicalEntityId":"vndb:s244","name":"後藤沙緒里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8370","source":"vndb"}]},{"characterId":"char_vndb_c820","characterName":"蘭花・フランボワーズ","sourceIds":{"vndbCharacterId":"c820"},"originalCharacterName":"蘭花・フランボワーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ranpha Franboise is a member of the Moon Angel Troupe and pilots the emblem frame Kung-fu Fighter."},{"spoiler":false,"text":"Ranpha is a proud and sometimes harsh woman who can be difficult to approach but is kind to people she considers her friends and is willing to put their feelings and needs before her own. She favours a direct approach to problem solving, often defusing situations with an application of brute force that coincides well with the Kung Fu Fighter's abilities."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c820"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1712ebb58e9eb67105570311c64dfd867fbd5580db44fcb9705c59161943c0b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f7ecb2486a2cb8d10198f4ce9fdbfb7f435722260c683c0d59ecf31e67ef2df.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村 ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8369","source":"vndb"}]},{"characterId":"char_vndb_c821","characterName":"ミント・ブラマンシュ","sourceIds":{"vndbCharacterId":"c821"},"originalCharacterName":"ミント・ブラマンシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"123"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mint Blancmanche is a member of the Moon Angel Troupe and pilots the Emblem Frame Trick Master."},{"spoiler":false,"text":"Possessing telepathic abilities, Mint can read the surface thoughts of others, even if she doesn't want to. This led to her reluctancy to be with others outside the Angel Troupe. She loves all candy and exotic tea, particularly Orange Pekoe from the planet Nirugi and tea leaf from the Samrong system. Mint also has a fascination for fast food owing to her sheltered life in the Blancmanche family mansion. The one thing she keeps secret from even her closest friends is her hobby of dressing up in animal costumes."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c821"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c4a8e07fdf97d7efd75249b747738fcb8e39ff0431640a7daf957a51399d155.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4eab33bbdbf76f6ba1d72d8ae18ccbd99d81f56d21559d1d81c611ad275cfc9a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城 みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8366","source":"vndb"}]},{"characterId":"char_vndb_c822","characterName":"フォルテ・シュトーレン","sourceIds":{"vndbCharacterId":"c822"},"originalCharacterName":"フォルテ・シュトーレン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Forte Stollen is a member of the Moon Angel Troupe and pilots the Emblem Frame Happy Trigger."},{"spoiler":false,"text":"Forte is the leader of the Moon Angel Troupe. Being the oldest, Forte acts as the big sister of the group, often giving advice to others. Like many of the other characters in the first game, Forte is less than impressed with the appointment of Tact as the commander of the Elsior and bluntly tells him that she will not consider him her commander until he proves himself. He eventually does, and she begins to trust him as much as she would her teammates on the Angels."},{"spoiler":false,"text":"Forte is the most experienced among the Angels, and is intimately familiar with such details as the mechanics of Milfeulle's luck as well as the workings of the Emblem Frames. She is fond of gunpowder weapons rather than laser weapons, even though gunpowder weapons are difficult to come by in the time period in which the games take place."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0164343745823c5d8922fca47c51a44f709ff6274d52ae19fbcd79b2636c5ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/615137ed30e8e055b4563526c16d8bf46d8347ae23b1d06e0b5205a7309fd072.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山口 眞弓","creatorId":"vndb:s3103","sourcePersonId":"vndb:s3103","canonicalEntityId":"vndb:s3103","name":"山口 眞弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8380","source":"vndb"}]},{"characterId":"char_vndb_c836","characterName":"レスター・クールダラス","sourceIds":{"vndbCharacterId":"c836"},"originalCharacterName":"レスター・クールダラス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"186"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first officer of the Elsior, Lester spends most of his time either making sure that Tact is doing his job as a commander, or trying to find Tact as he goes off on one of his crazy adventures with the Angel Troupe. Has known Tact since the military academy, and has been with him ever since."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5377e239245d3505cecdc1e8a398df126243d3f189a3ba1c5812d83db5caf5f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c501d89a27a2383f91749adc4899dea38455fbdfdff37349e021bf8a8ae9c32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小西 克幸","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8367","source":"vndb"}]},{"characterId":"char_vndb_c883","characterName":"シャトヤーン","sourceIds":{"vndbCharacterId":"c883"},"originalCharacterName":"シャトヤーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Referred to as a saint by virtually every character in the games, she is the ruler of the White Moon that orbits the homeworld of the Transbaal Empire. The respect she is given by other characters (including Tact Mayers, who generally eschews the use of honorifics) is shown by the suffix '-sama' (様), which is used to refer to those of a much higher rank."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c883"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8611bc7ba6e3d88a8e77a2980ba9b48699a8253ddce48fdbb40c5c6b0954bb03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c65c92584f34a9a41177e98a610e760eeb994566a52d1c211d533b240021b2d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 喜久子","creatorId":"vndb:s473","sourcePersonId":"vndb:s473","canonicalEntityId":"vndb:s473","name":"井上喜久子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8373","source":"vndb"}]},{"characterId":"char_vndb_c8833","characterName":"ルシャーティ","sourceIds":{"vndbCharacterId":"c8833"},"originalCharacterName":"ルシャーティ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lushati is from the legendary civilisation EDEN. She comes to beg Tact Mayers for his help in liberating EDEN from the Val Fasq. She is polite and soft-spoken, but also rather naive at times."},{"spoiler":false,"text":"Based on Galaxy Angel Wiki"},{"spoiler":true,"text":"Lushati is the administrator of \"Library\", a huge database of EDEN's knowledge."},{"spoiler":true,"text":"She was controlled by Wein in order to gain the trust of the Elsior's crew and sabotage the relationship between Tact and his chosen angel. Wein also uses her to pilot the stolen GA007. When Gern plans to execute her, Wein betrays the Val Fasq and returns Lushati safely to EDEN."}],"source":"vndb","sourceCharacterId":"c8833"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4822bbd52416d39d9a3e6a0a97a212cc61a44e4c6f80b0dca3aae968f914543.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8397e29caa64c00a171c3c91deebcfac277ae96ef75046f1e545463caba51c39.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくち ゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8374","source":"vndb"}]},{"characterId":"char_vndb_c8834","characterName":"ヴァイン","sourceIds":{"vndbCharacterId":"c8834"},"originalCharacterName":"ヴァイン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wein has escaped from EDEN, which was conquered by the Val Fasq, with his sister, Lushati. His demeanor is quiet, calm and reserved. He provides a lot of useful intelligence on the Val Fasq to the Elsior."},{"spoiler":false,"text":"Based on Galaxy Angel Wiki"},{"spoiler":true,"text":"Wein controls Lushati to take advantage of her position as the administrator of \"Library\", and to drive a wedge between Tact and his chosen angel. When Wein steals GA007 he uses Lushati to pilot it and reveals that he is from the Val Fasq race."},{"spoiler":true,"text":"Wein's time on the Elsior and his experience fighting the emblem frames with GA007 cause him to have a change of heart later on. When Gern decides to execute Lushati so that EDEN will be unable to access its \"Library\", Wein escapes from the Val Fasq with Lushati and is fatally wounded in the process."}],"source":"vndb","sourceCharacterId":"c8834"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95d59b402d7757d52f0ba3177042070e71d047d894806ea5d2fe47e7ee67a6d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c623110861ca9b56ea05a123d2b03bba8e8aab1a565d775707961b29df0afa8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森 訓久","creatorId":"vndb:s9116","sourcePersonId":"vndb:s9116","canonicalEntityId":"vndb:s9116","name":"森 訓久","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8383","source":"vndb"}]},{"characterId":"char_vndb_c8835","characterName":"ロウィル","sourceIds":{"vndbCharacterId":"c8835"},"originalCharacterName":"ロウィル","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The commander in chief of the Val Fasq No.2 invasion fleet. He is not prone to getting into long debates like other enemies; upon his introduction he simply gives a speech that they will all be crushed and they have no hope to win, and then cuts the communication."},{"spoiler":false,"text":"From Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c8835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c9cc37f1445ddb9d7e0d593b6994f5dde65ab3ef3116cca727330c681957753.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4796d10034d7b1cd83925cdbe50bf116cfb10fd3960abee9f09fde529f180283.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"保村 真","creatorId":"vndb:s289","sourcePersonId":"vndb:s289","canonicalEntityId":"vndb:s289","name":"保村 真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8371","source":"vndb"}]},{"characterId":"char_vndb_c8836","characterName":"ゲルン","sourceIds":{"vndbCharacterId":"c8836"},"originalCharacterName":"ゲルン","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Gern is the king of the Val Fasq race and one of the oldest Val Fasq. He sounds like an elder experienced in age, and his speech uses sophisticated language. He is extremely arrogant, believing all criticism or protest to be the protests of dogs who have not yet learned to respect their betters."},{"spoiler":false,"text":"He thinks that Val Fasq who act in an improper manner (such as caring about others) are literally \"garbage\" to be thrown away, and that Val Fasq who are defeated are not true Val Fasq."},{"spoiler":false,"text":"Based on Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c8836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b85dcfe95cd0d0ffef1bf5a528af7462b204474b932da73667f36c9fae0c716d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/173aabfe521541da1c8312358f20eac8dbbb4d68657fd1962635f9c64b9cd278.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c8876","characterName":"アルモ・ブルーベリー","sourceIds":{"vndbCharacterId":"c8876"},"originalCharacterName":"アルモ・ブルーベリー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Almo is the communications officer on the Elsior. She has a bright personality and is a good friend of Coco."},{"spoiler":false,"text":"Almo has a major crush on Lester, but he doesn't notice at all."},{"spoiler":false,"text":"Translated from developer's website"}],"source":"vndb","sourceCharacterId":"c8876"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b19a381bd3c10ab9eaa42812f8c2f87bd866af6b64fbf50cc26c619cdb129d43.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e53dcb2eb3a7e0c7edac16127d323f93fe22b922f935bcb33ab8118339ffde1a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小暮 英麻","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8375","source":"vndb"}]},{"characterId":"char_vndb_c8877","characterName":"ココ・ナッツミルク","sourceIds":{"vndbCharacterId":"c8877"},"originalCharacterName":"ココ・ナッツミルク","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Coco is the radar operator on the Elsior. She is friendly and a good friend of Almo."},{"spoiler":false,"text":"Translated from developer's website"}],"source":"vndb","sourceCharacterId":"c8877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/715d76a2f9258d7794e61ae50fc16e9f94b4d657ea5bdc2c8b29a75ac90878b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ef0f611b06b0bcd80847b87abc0b7545f5bcef931c4e0e55663bf76fa6536e8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅野 るり","creatorId":"vndb:s1239","sourcePersonId":"vndb:s1239","canonicalEntityId":"vndb:s1239","name":"浅野 るり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8377","source":"vndb"}]},{"characterId":"char_vndb_c8878","characterName":"クレータ・ビスキュイ","sourceIds":{"vndbCharacterId":"c8878"},"originalCharacterName":"クレータ・ビスキュイ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Creta is in charge of maintenance of the Elsior and Emblem Frames. She is a major fan of bishonen idol Ricky Kart."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c8878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9756a5ee7274b545526c73f9ef92304cb4512989e1617f2a7e931b8092b69532.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21d69fa8862757a5c63d153f3d08b79eed3627965af956bcd5b5ff36b799ac51.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小島 幸子","creatorId":"vndb:s16617","sourcePersonId":"vndb:s16617","canonicalEntityId":"vndb:s16617","name":"小島幸子",