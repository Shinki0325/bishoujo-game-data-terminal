racterName":"叶 夏恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"民宿〈豊平屋〉を手伝っている若女将。"},{"spoiler":false,"text":"彼女の両親がセカンドライフで始めた民宿だが、なんとなくついてきて、何となく後を継ぎつつある。"},{"spoiler":false,"text":"人の世話をするのが何となく楽しい……という理由であるらしい。"},{"spoiler":false,"text":"同じような理由で、主人公にもまるで新妻のように世話を焼くが、渚から「お兄ちゃん」がどれだけ素敵な人か、と聞かされていたり、同世代の男性がまったく居なかったり……と色々な条件もあって、夏恋もまた主人公に惹かれていくことになる。"},{"spoiler":false,"text":"渚のことは夏恋にとっては、一人っ子の自分に出来た可愛い妹だと思っている。"}],"source":"egs","sourceCharacterId":"10297","sourceWorkId":"15199","spoiler":false},{"segments":[{"spoiler":false,"text":"民宿 『豊平屋』 を手伝っている若女将。"},{"spoiler":false,"text":"彼女の両親がセカンドライフで始めた民宿だが、なんとなく付いてきて、なんとなく後を継ぎつつある。"},{"spoiler":false,"text":"人の世話をするのがなんとなく楽しい……という理由であるらしい。"},{"spoiler":false,"text":"同じような理由で、主人公にもまるで新妻のように世話を焼くが、渚から “お兄ちゃん” がどれだけ素敵な人か、と聞かされていたり、同世代の男性がまったくいなかったり……と色々な条件もあって、夏恋もまた主人公に惹かれていくことになる。"},{"spoiler":false,"text":"深夜、裸で海水浴場のシャワールームに行くところを主人公に見咎められて関係を持つ。"},{"spoiler":false,"text":"以降、渚の想い人であることを知りつつ、そんなふたりを良いお姉さんとして微笑ましく仲良く見守りながらも、裏では抑えられない性欲に任せた関係を主人公と続けていく。"},{"spoiler":false,"text":"渚のことは一人っ子の自分にできた可愛い妹だと思っている。"},{"spoiler":false,"text":"エッチについては誘い受け系が多い。その豊満な身体を使っての奉仕プレイが精神的にも肉体的にも得意。"},{"spoiler":false,"text":"柔らかな雰囲気と包容力で、奉仕されたい、征服したいという主人公の精神を刺激するタイプ。"},{"spoiler":false,"text":"「はいはい。まったくしょうがない先生ですね？　そんなことでいいのかしら……ふふっ」"}],"source":"bangumi","sourceCharacterId":"42532"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10297","sourceWorkId":"15199","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"10297","sourceWorkId":"15199","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10297","sourceWorkId":"15199","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"10297","sourceWorkId":"15199","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa7611b8a1667d9a705db011dca1f14f5b4e6c5d2e44e3913614f1bffacedb24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e305437d7cddc997d524a455abdf63d31b09c3874c97a27fe662a7089848f19.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:32365:42532:4646:1","source":"bangumi"}]},{"characterId":"char_c23284","characterName":"津嘉山 渚","sourceIds":{"bangumi":[{"characterId":"42533","match":"exact-normalized-name-in-linked-work","subjectId":"32365"}],"egsCharacterIds":["10298"],"vndbCharacterId":"c23284"},"originalCharacterName":"津嘉山 渚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"臨時教師の間、主人公の教え子となる。"},{"spoiler":false,"text":"もともと主人公は学生時代、姉の汀と付き合っていたが、その頃からそんな主人公に対して「お兄ちゃん」と呼んで思慕の念を抱いていた。"},{"spoiler":false,"text":"主人公が戻ってきたのを機会に一念発起し、好きだということを告げようとするが、そこで夏恋との行為を目撃してしまう。驚きつつも、それが恋人としての関係ではないことを知り、渚自身もその中に踏み出していく。"},{"spoiler":false,"text":"学校では主人公を「先生」と呼ぶが、普段は「お兄ちゃん」と呼んでいる。"},{"spoiler":false,"text":"夏恋は渚にとって、主人公と一緒に都会へ行ってしまった姉と入れ替わりに現れた、もう一人の姉のような存在。"}],"source":"egs","sourceCharacterId":"10298","sourceWorkId":"15199","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：154cm　 スリーサイズ：B78/ W59/ H84"},{"spoiler":false,"text":"臨時教師になった主人公の教え子である少女。"},{"spoiler":false,"text":"もともと主人公は学生時代、彼女の姉の汀と付き合っていたが、その頃から主人公を 「お兄ちゃん」 と呼んで思慕の念を抱いていた。"},{"spoiler":false,"text":"主人公が戻ってきたのを機会に一念発起し、好きだということを告げようとするが、そこで夏恋との行為を目撃してしまう。"},{"spoiler":false,"text":"驚きつつも、それが恋人としての関係ではないことを知り、渚自身もその中に踏み出していく。"},{"spoiler":false,"text":"当初、「大好きなふたりに置いて行かれたくない」 という気持ちから関係を結んだが、性的な優等生であった渚は主人公の施す行為にどんどんのめり込んでいく。"},{"spoiler":false,"text":"“やさしい先生” と “ちょっと怖いお兄ちゃん” との狭間で、渚は女性としての才能を開花させていく。"},{"spoiler":false,"text":"学園では主人公を 「先生」 と呼ぶが、普段は 「お兄ちゃん」 と呼んでいる。"},{"spoiler":false,"text":"夏恋は渚にとって、主人公と一緒に都会へ行ってしまった姉と入れ替わりに現れた、もう一人の姉のような存在。"},{"spoiler":false,"text":"エッチについては調教系が多い。無茶な命令にも従順に従い、子犬のような面も見せるが、時には積極的に。"},{"spoiler":false,"text":"ちょっとおどおどしたり甘えん坊なところが、主人公のS心を刺激するタイプ。"},{"spoiler":false,"text":"「いじわる。そんなこと言われたら……嫌って言えるわけ、ないじゃん」"}],"source":"bangumi","sourceCharacterId":"42533"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"10298","sourceWorkId":"15199","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"10298","sourceWorkId":"15199","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"10298","sourceWorkId":"15199","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"10298","sourceWorkId":"15199","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},