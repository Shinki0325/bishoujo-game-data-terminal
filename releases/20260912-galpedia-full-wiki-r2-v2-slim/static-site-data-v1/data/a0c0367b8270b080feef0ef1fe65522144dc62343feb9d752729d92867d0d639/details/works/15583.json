22"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1b6989515d1b8192ea915da0f76ab6ed8cc825ae4871b62eaa64b6c2e009f08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8aaab3aa62397c57c0a7cc8e5c73a307e04b965716b50a84d41aab394cd82363.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43456","characterName":"成瀬 愛","sourceIds":{"bangumi":[{"characterId":"89339","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15984"],"vndbCharacterId":"c43456"},"originalCharacterName":"成瀬 愛","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の亡くなった母親の妹、いわゆる叔母さん。"},{"spoiler":false,"text":"舞台となる病院でナース長を務めているベテラン。"},{"spoiler":false,"text":"仕事ぶりも優秀で、性格もしっかりしており、また気さくで人当たりもよく、患者からの信頼も厚い。"},{"spoiler":false,"text":"学生時代の寮が主人公の家の近所にあったため、美咲や主人公とよく遊んであげていた。"},{"spoiler":false,"text":"主人公が頭のあがらない存在でもある。"},{"spoiler":false,"text":"外科の若手エリート医師・永瀬直樹と婚約しており、その彼と再来月に挙式の予定。"}],"source":"egs","sourceCharacterId":"15984","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"誠人の母親の妹にあたる叔母さん。看護婦長。"},{"spoiler":false,"text":"しっかり者で人当たりも良く、多くの患者から信頼されている。"},{"spoiler":false,"text":"学生時代の寮が誠人の家の近所にあったことから、美咲や誠人とはよく遊んであげていた。"},{"spoiler":false,"text":"誠人が絶対に頭の上がらない人。外科の若手エリート医師と婚約しており、再来月に挙式の予定。"}],"source":"bangumi","sourceCharacterId":"89339"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/222124673aa70dbf29336a458c6b1743b4e2e353cd82b8d34cba28988e82f711.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e71b16994e7444ea305735df857c29b31c23e9f6359318909e9ee4ce9c881b1a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43457","characterName":"白幡 さくら","sourceIds":{"bangumi":[{"characterId":"89340","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15985"],"vndbCharacterId":"c43457"},"originalCharacterName":"白幡 さくら","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、看護学校の研修生。"},{"spoiler":false,"text":"夜逃げ同然で引っ越したこともあって、主人公とは約10年ぶりの再会となる。"},{"spoiler":false,"text":"看護学校ではトップクラスの成績だったが、極度に緊張する性分から本番に弱いらしい。"},{"spoiler":false,"text":"何もないところでよく転ぶ、ややドジッ娘タイプ。"},{"spoiler":false,"text":"子供の頃に苛められていたせいか、自分の容姿にコンプレックスを抱いている。"}],"source":"egs","sourceCharacterId":"15985","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"誠人の幼なじみである、看護学校の研修生。"},{"spoiler":false,"text":"夜逃げ同然に引っ越したため、10年ぶりに誠人と再会する。"},{"spoiler":false,"text":"看護学校の成績はトップクラスなのだが、緊張して本番には弱いらしい。なにも無いところでよく転ぶ。"},{"spoiler":false,"text":"子供の頃はイジメられっ子だったせいか、自分の容姿にコンプレックスを持っている。"}],"source":"bangumi","sourceCharacterId":"89340"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c25292abd1a79314a23550066c2ff362581285d2e6e372ac833244d1e2c92182.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/301b04af05839e54aafc321405d9d9ab471336f46edd492294f3eb5ee661d9b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43458","characterName":"相馬 美咲","sourceIds":{"bangumi":[{"characterId":"89337","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15982"],"vndbCharacterId":"c43458"},"originalCharacterName":"相馬 美咲","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の実姉。主人公の通う学園の音楽教師。"},{"spoiler":false,"text":"おっとりしていて、押しの弱い性格。"},{"spoiler":false,"text":"幼い時に母親を亡くし、以来、主人公の母親代わりとして頑張ってきた。"},{"spoiler":false,"text":"非常に弟想いだが、その主人公が必要以上に慕ってくれていることに理解しながらも、同時に戸惑いを感じている。"},{"spoiler":false,"text":"問題児に育ってしまった主人公を心配で仕方ないらしい。"}],"source":"egs","sourceCharacterId":"15982","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"誠人の通う学園で音楽教師を務めている実姉。誠人の母親代わりでもある。"},{"spoiler":false,"text":"弟想いだが、おっとりした性格で押しに弱い。"},{"spoiler":false,"text":"誠人が自分のことを必要以上に慕ってくれていることも理解しているが、どう応えていいのか困り果てている。"},{"spoiler":false,"text":"美咲にとって誠人はあくまでも守るべき対象であり、誠人が問題児なためにいつも心配でしょうがないらしい。"}],"source":"bangumi","sourceCharacterId":"89337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7434fe5b133a183274380f85bb7a65ce542b80917f518b03f32fccee4d4cf152.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c3c6aaf4785288552ef453a71782f11bbfd2da3ecbcb42d20571edda93b93aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43494","characterName":"相馬 菜月","sourceIds":{"bangumi":[{"characterId":"89335","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15980"],"vndbCharacterId":"c43494"},"originalCharacterName":"相馬 菜月","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の父親の再婚相手。主人公の義母。"},{"spoiler":false,"text":"父親の元部下だったらしいが、現在は、転職して雑誌編集に携わるキャリアウーマン。"},{"spoiler":false,"text":"自他共に厳しく、仕事への妥協は一切しない。"},{"spoiler":false,"text":"男に負けたくない、という強い意志を持ち、競争心、また闘争心は旺盛。"},{"spoiler":false,"text":"仕事で家事をすることが出来ず、全て義娘の美咲に任せてしまっていることを、やや負い目に感じている。また義理の息子となった主人公に対しては、そのいやららしい視線が気になっており、家の残している娘を心配している。"}],"source":"egs","sourceCharacterId":"15980","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"誠人の父親の再婚相手。元部下だったらしいのだが、現在は転職して雑誌編集に携わるキャリアウーマン。"},{"spoiler":false,"text":"仕事への妥協は一切せず、自分にも他人にも厳しい。"},{"spoiler":false,"text":"男には負けたく無いという強い意識があり、競争・闘争心が非常に高い。"},{"spoiler":false,"text":"家事全般は姉の美咲に任せてしまっており、若干の負い目を感じている。"},{"spoiler":false,"text":"最近、誠人の粘つくような視線が気になるらしく、仕事中に娘を家に残している事を心配している。"}],"source":"bangumi","sourceCharacterId":"89335"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0030103f32cdf8802d5fcf1abed6d71f1c4fbddfbdaf80fa4555bcf301f9793a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94704335c137a05d15a63dc84058ee7d8a7232f0096685c6d0c16b84e1242ffe.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43526","characterName":"相馬 結菜","sourceIds":{"bangumi":[{"characterId":"89336","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15981"],"vndbCharacterId":"c43526"},"originalCharacterName":"相馬 結菜","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"菜月の連れ子。主人公の義妹。"},{"spoiler":false,"text":"母子家庭に育ってきた彼女にとって、家族が増えたことは非常に嬉しく、特に主人公に対しては「お兄ちゃん」と呼んで慕っている。"},{"spoiler":false,"text":"無邪気で子供っぽいところもあるが、感受性が強く、家庭内の不和を敏感に察知し、自分の力で何とか仲良くさせようと頑張っている。"},{"spoiler":false,"text":"また自分をかばって、主人公が交通事故に遭ってしまったことに責任を感じている。"}],"source":"egs","sourceCharacterId":"15981","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"菜月の連れ子。"},{"spoiler":false,"text":"ずっと母子家庭に育ったために家族が増えたことを喜び、特に誠人に懐いているお兄ちゃん子。"},{"spoiler":false,"text":"それだけに結菜を助けて誠人が交通事故に遭ってしまったことに責任を感じているらしい。"},{"spoiler":false,"text":"無邪気な性格だけに家庭内の不和を敏感に察知し、仲良くさせようと懸命に努力している。"}],"source":"bangumi","sourceCharacterId":"89336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5afb7d9cdbac9ec3b403805782f4c151b28a1ccb045bdd3a313def5a7d841f2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d515b3e894e9fd2e7aeac93914ced9f3e7c2ad49dc4d64081dbab1e38367e5d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43527","characterName":"春日部 陽菜","sourceIds":{"bangumi":[{"characterId":"89338","match":"exact-normalized-name-in-linked-work","subjectId":"20153"}],"egsCharacterIds":["15983"],"vndbCharacterId":"c43527"},"originalCharacterName":"春日部 陽菜","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美咲の中学時代からの親友。体育教師。"},{"spoiler":false,"text":"気さくで明朗快活、非常にさっぱりとした性格。好奇心旺盛で、面白そうなことがあると首を突っ込みたがる。また自分の納得できないことはとことんやらない性分。"},{"spoiler":false,"text":"世間知らずのお嬢様っぽい美咲の世話を焼いている。"},{"spoiler":false,"text":"美咲のブラコンをからかってはいるが、同時に弟離れできない彼女を本気で心配している。"},{"spoiler":false,"text":"顧問をしているチアリーディング部の練習中に怪我をして、現在、舞台となる病院で検査入院をしている。"}],"source":"egs","sourceCharacterId":"15983","sourceWorkId":"11799","spoiler":false},{"segments":[{"spoiler":false,"text":"美咲の中学生の頃からの親友で、明るいフランクな感じの体育教師。"},{"spoiler":false,"text":"世間知らずの美咲の世話をなにかと焼いている。"},{"spoiler":false,"text":"面白そうなことにはちょっかいを出さずにはいられない。竹を割ったような性格だが、納得できないことはとことんやらない。"},{"spoiler":false,"text":"誠人と美咲のシスコン・ブラコンをからかう一方、美咲が弟離れできないでいることを心配している。"},{"spoiler":false,"text":"チアリーディング部の顧問をしているが、練習中に転落してしまい、現在検査入院中。"}],"source":"bangumi","sourceCharacterId":"89338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d0e210a94f07c0d043bfaefeab5714b8f76dee841e1e5dabca48022bcfce4fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74dc3df4cfb917c425a48136b75fc4524554fb48ab09968545c85ac508b8139a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59149","characterName":"霧島 さゆり","sourceIds":{"bangumi":[{"characterId":"92714","match":"exact-normalized-name-in-linked-work","subjectId":"20155"}],"egsCharacterIds":["18667"],"vndbCharacterId":"c59149"},"originalCharacterName":"霧島 さゆり","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"清進学院に通う女子学生。双子の妹。"},{"spoiler":false,"text":"学園の生徒会長を務めている。"},{"spoiler":false,"text":"性格は、非常にクールで頭の回転が早い切れ者。"},{"spoiler":false,"text":"物事への取り組み方から、他人への接し方まで全て計算ずくで行う。"},{"spoiler":false,"text":"そのため、周囲には「親しみやすい」といった印象を与えているようだ。"}],"source":"egs","sourceCharacterId":"18667","sourceWorkId":"10498","spoiler":false},{"segments":[{"spoiler":false,"text":"双子の妹。主人公の学園の生徒会長。クールで頭の回転が早い切れ者です。"},{"spoiler":false,"text":"すべての物事を（他人に対する接し方まで）計算づくで行う女の子。"},{"spoiler":false,"text":"そのため、性格のわりに「親しみやすい」と思われています。"}],"source":"bangumi","sourceCharacterId":"92714"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86a608bc8c816026f29f6b94918ad06b8431746d10b3d5fc401ca883f782951a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2102d5163406d2d4c3a7bbacab0b58252866c8501641e53bab3dc552649ffdac.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59150","characterName":"霧島 まなみ","sourceIds":{"bangumi":[{"characterId":"92715","match":"exact-normalized-name-in-linked-work","subjectId":"20155"}],"egsCharacterIds":["18668"],"vndbCharacterId":"c59150"},"originalCharacterName":"霧島 まなみ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"清進学院に通う女子学生。双子の姉。"},{"spoiler":false,"text":"学園の副生徒会長を務めている。"},{"spoiler":false,"text":"姉とは違い、裏表のない素直な性格。やや天然（？）。"},{"spoiler":false,"text":"勉強は不得意だが、スポーツは万能で、運動部の助っ人として頼られることもしばしば。"}],"source":"egs","sourceCharacterId":"18668","sourceWorkId":"10498","spoiler":false},{"segments":[{"spoiler":false,"text":"双子の姉。生徒会副会長。裏表のない素直な（天然？）タイプです。"},{"spoiler":false,"text":"妹と違い勉強は得意ではありませんが、温和な性格に似合わず運動が得意です。"},{"spoiler":false,"text":"そのため運動部に助っ人として頼られることも。"}],"source":"bangumi","sourceCharacterId":"92715"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae1332bb43e21fc5aee82f1b271d93c17da05b854bd828b26d552e61fe820d10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e93e767ec314b1c6c797002daf624c27aa4bac9479ab0c183f0453147eeddf45.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c13268","characterName":"桜井 進","sourceIds":{"vndbCharacterId":"c13268"},"originalCharacterName":"桜井 進","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this work. A second-year student at Seishin Academy."},{"spoiler":false,"text":"He lives with his mother in a single-parent household."},{"spoiler":false,"text":"He's not good at sports and has an introverted personality."},{"spoiler":false,"text":"And because of his personality, he is the target of bullying at the academy."},{"spoiler":false,"text":"At home, his earnest, respectable mother puts a lot of pressure on him, but he doesn't rebel and lives an empty life."},{"spoiler":false,"text":"The only time he finds peace is during dinner at his aunt's house."},{"spoiler":false,"text":"By chance, he meets a man named Murakoshi who has moved into the same apartment building, and the two become friends."},{"spoiler":false,"text":"This marks a major turning point in his life..."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c13268"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8ba3940b9b674bff4200caf76cc0b7d4a8abce8f1f753ba677e6b7febfaeffbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a5181650733be1bb6b45008c009535e84b426406bdcf4e5271a9d64de6ae0f9.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c13326","characterName":"かなえ","sourceIds":{"vndbCharacterId":"c13326"},"originalCharacterName":"かなえ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"58"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"59"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e8f0717ec8f8141ecd0700a7495b0abf7a7e450c0aab72e8a238e2d24632cd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee4921f58045f945ddef0d8ba275622236