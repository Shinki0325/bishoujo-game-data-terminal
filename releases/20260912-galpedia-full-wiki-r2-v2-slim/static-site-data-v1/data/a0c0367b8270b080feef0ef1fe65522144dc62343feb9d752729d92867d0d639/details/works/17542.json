","value":"101"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"114"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"101"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The middle sister of the Kominezaki family. The protagonist's classmate."},{"spoiler":false,"text":"She has very fair skin, and is the biggest of her sisters. She wants to lose weight, but loves to eat."},{"spoiler":false,"text":"An excellent student academically, but weak with exercise..."},{"spoiler":false,"text":"A maidenly schoolgirl who's in love with love. But after being rejected too much because of her weight, she's very shy around boys and tends to just yearn for them from afar."},{"spoiler":false,"text":"After a life of feeling bad about her body, she was grateful to meet the protagonist, as he found her attractive. Could he be the \"Prince Charming\" Nanaka has been waiting her entire life for...?"}],"source":"vndb","sourceCharacterId":"c21883"},{"segments":[{"spoiler":false,"text":"小嶺崎三姉妹の次女。"},{"spoiler":false,"text":"主人公・頼雅の同級生。"},{"spoiler":false,"text":"色白で、三姉妹の中で一番太っている。"},{"spoiler":false,"text":"痩せたいけれど、食べることが大好き。"},{"spoiler":false,"text":"学業成績優秀。運動は……。"},{"spoiler":false,"text":"「わ、私が可愛い!?　ううぅ～……からかうのはやめてよぉ」"}],"source":"egs","sourceCharacterId":"5161","sourceWorkId":"17542","spoiler":false},{"segments":[{"spoiler":false,"text":"小嶺崎三姉妹の次女。"},{"spoiler":false,"text":"主人公・頼雅の同級生。"},{"spoiler":false,"text":"色白で、三姉妹の中で一番太っている。"},{"spoiler":false,"text":"痩せたいけれど、食べることが大好き。"},{"spoiler":false,"text":"学業成績優秀。運動は……。"},{"spoiler":false,"text":"「わ、私が可愛い!?　ううぅ～……からかうのはやめてよぉ」"}],"source":"bangumi","sourceCharacterId":"168831"}],"profileFacts":[{"label":"胸围（本版本）","value":"101 cm","valueContext":null,"source":"egs","sourceCharacterId":"5161","sourceWorkId":"17542","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"5161","sourceWorkId":"17542","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"114 cm","valueContext":null,"source":"egs","sourceCharacterId":"5161","sourceWorkId":"17542","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"5161","sourceWorkId":"17542","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"101 kg","valueContext":null,"source":"egs","sourceCharacterId":"5161","sourceWorkId":"17542","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2285b7fe0b4fc5e4ede27204c1179884e9a88d72da125edf2d7d483b22ea6ae2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5389f9a9b191b1a3f4150a7efe37477455466ee07a59325c2740beea571f66c9.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181314:168831:10027:1","source":"bangumi"}]},{"characterId":"char_c21884","characterName":"小嶺崎 瑠々","sourceIds":{"bangumi":[{"characterId":"168832","match":"exact-normalized-name-in-linked-work","subjectId":"181314"}],"egsCharacterIds":["5162"],"vndbCharacterId":"c21884"},"originalCharacterName":"小嶺崎 瑠々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"124"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"108"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"91"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The oldest sister of the Kominezaki family. The protagonist's upperclassman."},{"spoiler":false,"text":"She has beautiful long hair, and the largest chest of her sisters. She likes eating, but enjoys cooking even more."},{"spoiler":false,"text":"An excellent student academically, but weak with exercise..."},{"spoiler":false,"text":"A calm, easygoing girl who meets her troubles with a carefree \"Oh my, oh well,\" sort of peacefulness. Her caring personality and penchant for housework, as well as her plump body, has earned her the nickname \"Mom\" among her friends. But Ruru's still just a teenage girl..."},{"spoiler":false,"text":"Rather than be treated as a motherly figure, she's found one boy (the protagonist) who is willing to treat her as a normal girl instead. How will Ruru's feeling develop towards him...?"}],"source":"vndb","sourceCharacterId":"c21884"},{"segments":[{"spoiler":false,"text":"小嶺崎三姉妹の長女。"},{"spoiler":false,"text":"主人公・頼雅の上級生。"},{"spoiler":false,"text":"美しい長い髪と、三姉妹一大きな乳房が特徴。"},{"spoiler":false,"text":"食べるのも好きだが、作るほうも大好き。"},{"spoiler":false,"text":"学業成績優秀。運動はやっぱり……。"},{"spoiler":false,"text":"「これからは、私が色々と“お世話”してあげるわね♪」"}],"source":"egs","sourceCharacterId":"5162","sourceWorkId":"17542","spoiler":false},{"segments":[{"spoiler":false,"text":"小嶺崎三姉妹の長女。"},{"spoiler":false,"text":"主人公・頼雅の上級生。"},{"spoiler":false,"text":"美しい長い髪と、三姉妹一大きな乳房が特徴。"},{"spoiler":false,"text":"食べるのも好きだが、作るほうも大好き。"},{"spoiler":false,"text":"学業成績優秀。運動はやっぱり……。"},{"spoiler":false,"text":"「これからは、私が色々と“お世話”してあげるわね♪"}],"source":"bangumi","sourceCharacterId":"168832"}],"profileFacts":[{"label":"胸围（本版本）","value":"124 cm","valueContext":null,"source":"egs","sourceCharacterId":"5162","sourceWorkId":"17542","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","va