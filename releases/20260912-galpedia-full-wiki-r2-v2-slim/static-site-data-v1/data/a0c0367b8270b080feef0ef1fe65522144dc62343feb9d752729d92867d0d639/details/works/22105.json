ityStatus":"source-native","relationId":"vndb:vn-staff:121053","source":"vndb"},{"creditedName":"made in harutoshi","creatorId":"vndb:s5350","sourcePersonId":"vndb:s5350","canonicalEntityId":"vndb:s5350","name":"ハルトシ(made in harutoshi)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121054","source":"vndb"},{"creditedName":"かま みざき","creatorId":"vndb:s20374","sourcePersonId":"vndb:s20374","canonicalEntityId":"vndb:s20374","name":"かま みざき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121055","source":"vndb"},{"creditedName":"黒瀬 ゆづき","creatorId":"vndb:s39321","sourcePersonId":"vndb:s39321","canonicalEntityId":"vndb:s39321","name":"黒瀬 ゆづき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121056","source":"vndb"}]},"cast":[{"characterId":"char_c36691","characterName":"心願寺 紅","sourceIds":{"bangumi":[{"characterId":"89554","match":"exact-normalized-name-in-linked-work","subjectId":"145539"}],"egsCharacterIds":["7779"],"vndbCharacterId":"c36691"},"originalCharacterName":"心願寺 紅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"吸血鬼と人間のハーフでありながら、対魔忍として生きる異端の存在。"},{"spoiler":false,"text":"凜として張り詰めた雰囲気の美少女で、性格は潔癖で高潔。"},{"spoiler":false,"text":"剣術に長け、吸血鬼の優れた身体能力と魔力も相まって絶大なる戦闘能力を誇る。"},{"spoiler":false,"text":"ふうま一族を支配する頭目衆 “ふうま八将” の一人に数えられているほどの実力者。"},{"spoiler":false,"text":"肉親を害した魔族を嫌悪しており、対魔忍の任務に対して強い執念を燃やしている。"},{"spoiler":false,"text":"規律よりも自己の利益や欲望を優先する傾向があり、ふうま一族の中では浮いた存在。"},{"spoiler":false,"text":"【絶技・旋風陣】"},{"spoiler":false,"text":"“風遁の術” と 二刀の小太刀・白神と紅魔 を用いた剣術で、真空の刃を作り出す。"},{"spoiler":false,"text":"技により大量の返り血を浴びる姿から、“殲血の紅姫” という異名を持つ。"},{"spoiler":false,"text":"「奴らは魔族であり、私は対魔忍…… 理由など、それで充分だ」"}],"source":"egs","sourceCharacterId":"7779","sourceWorkId":"22105","spoiler":false},{"segments":[{"spoiler":false,"text":"対魔忍。吸血鬼と人間のハーフでありながら"},{"spoiler":false,"text":"対魔忍として生きる異端の存在。"},{"spoiler":false,"text":"祖父である“ふうま八将”心願寺幻庵から剣術の指南を受け、"},{"spoiler":false,"text":"ゆくゆくは八将を継ぐと目されていた実力者。"},{"spoiler":false,"text":"しかしかつての内紛の咎で幻庵は失脚。"},{"spoiler":false,"text":"その跡目を継ぐはずだった紅もふうまの里を離れ、"},{"spoiler":false,"text":"現在はどこにも属さない自由な立場で行動している。"},{"spoiler":false,"text":"アサギたち対魔忍には協力しないが"},{"spoiler":false,"text":"幼馴染であるふうまの頼みなら悩みつつも"},{"spoiler":false,"text":"昔を思い出し仕方なく引き受けてしまう。"},{"spoiler":false,"text":"先代のふうま八将・心願寺幻庵から受け継いだ二刀の小太刀『白神』『紅魔』を所持。"},{"spoiler":false,"text":"ハーフヴァンパイアの身体能力を活かした絶大なる戦闘能力を誇り、"},{"spoiler":false,"text":"二刀の小太刀を高速で操ることで真空の刃を作り出す“絶技・旋風陣”を得意とする。"}],"source":"bangumi","sourceCharacterId":"89554"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"89554","value":"魔性"},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"7779","sourceWorkId":"22105","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a64d3d6cdb4eaec96f3cdd65eeec5f91423fe1d3e71dc8e4e4146e5fa2c68f05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/915881f5a29eba0f7082baea7efd65fd0d7803e91d41f2d9d9f272a63222265f.webp","width":253,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145539:89554:5052:1","source":"bangumi"}]},{"characterId":"char_c36692","characterName":"槇島 あやめ","sourceIds":{"bangumi":[{"characterId":"94215","match":"exact-normalized-name-in-linked-work","subjectId":"145539"}],"egsCharacterIds":["7780"],"vn