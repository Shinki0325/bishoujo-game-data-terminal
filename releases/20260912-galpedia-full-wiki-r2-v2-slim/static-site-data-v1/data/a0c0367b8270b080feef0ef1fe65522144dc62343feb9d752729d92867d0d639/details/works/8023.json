ntext":null,"source":"egs","sourceCharacterId":"25297","sourceWorkId":"8023","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5580e6125ff5222202bc7b781e21eca3012f92927661d4aa2f115ba60fe35de5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4b4dafaa320a91b92a8c03e664615f6323ab67196c5b110b7c7cacf343f4c79.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79408:90474:5741:1","source":"bangumi"}]},{"characterId":"char_c8313","characterName":"ワダツミ・サクヤ","sourceIds":{"bangumi":[{"characterId":"90475","match":"exact-normalized-name-in-linked-work","subjectId":"79408"}],"egsCharacterIds":["25298"],"vndbCharacterId":"c8313"},"originalCharacterName":"ワダツミ・サクヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"820"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"軍事機密"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国連宇宙軍「アークス」所属のパイロット。"},{"spoiler":false,"text":"特殊能力を有する人類「ディゾルブ」種の少女で、さらに戦闘用に強化された特別な素体。"},{"spoiler":false,"text":"戦うことをだけを徹底的に叩き込まれ、故に他者との交流が苦手とし、結果、口数が少なく、素っ気無い。"},{"spoiler":false,"text":"時折、辛そうに何かにジッと耐えるような表情を見せる。"}],"source":"egs","sourceCharacterId":"25298","sourceWorkId":"8023","spoiler":false},{"segments":[{"spoiler":false,"text":"国連宇宙軍『アークス』所属のパイロット。"},{"spoiler":false,"text":"特殊な能力を持ち人類と共存するもう一つの人類『ディゾルブ』種の少女で、その中でもさらに戦闘用に強化された、特別な存在。"},{"spoiler":false,"text":"戦うことだけをその使命として教育されているため、他者との交流が苦手で、その結果、普段から口数が少なく態度も冷たい。"},{"spoiler":false,"text":"時折辛そうな、何かにじっと耐えているような表情を見せる。本人は望んでいないが、その重い使命を共に背負う仲間が、サクヤには必要である。"}],"source":"bangumi","sourceCharacterId":"90475"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"25298","sourceWorkId":"8023","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"25298","sourceWorkId":"8023","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"25298","sourceWorkId":"8023","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"25298","sourceWorkId":"8023","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"25298","sourceWorkId":"8023","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81d48012e8cee4b608638b6054898cb7c666409f47c2553a70b8a10af225eed2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ce34f624eb3c0afcf8d72e45ce7749c0344d9f8b8252549556df9672e923661.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79408:90475:4832:1","source":"bangumi"}]},{"characterId":"char_c8316","characterName":"イリアス","sourceIds":{"bangumi":[{"characterId":"90476","match":"exact-normalized-name-in-linked-work","subjectId":"79408"}],"egsCharacterIds":["25299"],"vndbCharacterId":"c8316"},"originalCharacterName":"イリアス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"覚えていないのにゃ"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"49"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AAA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"130"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"48"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"37"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"この時代、「エルシド」との戦いによって激減した人類は、ヒトと動物の遺伝子を掛け合わせ、目的別に様々な「混合種（＝ハイブリッド）」を生み出した。"},{"spoiler":false,"text":"彼女もその一種で、地球から遠く離れた海王星軌道の最前線防衛衛星群に配置されていた。"},{"spoiler":false,"text":"しかし、それら防衛衛星群は既に存在せず、他の仲間たちはエルシドとの戦いで戦死。"},{"spoiler":false,"text":"子供っぽい容姿に、無邪気な言動からは想像できない高い戦闘能力を持ち、「アレキサンダー」の運用を含むあらゆる兵器に精通するエキスパート。"}],"source":"egs","sourceCharacterId":"25299","sourceWorkId":"8023","spoiler":false},{"segments":[{"spoiler":false,"text":"この時代、宇宙怪獣（エルシド）との戦争によって激減してしまった人類は、目的別にさまざまな『ハイブリッド』種の人類を誕生させており、イリアスは、地球から遠く離れた海王星軌道からたった一人でやって来た、最新型のハイブリッドです。"},{"spoiler":false,"text":"好奇心が旺盛で、面白いものを見つけると、慌ててあなたに教えに来てくれます。"},{"spoiler":false,"text":"また、イリアスは戦闘用ハイブリッド種の頂点に位置する個体で、単体戦闘能力でも『アレキサンダー』操縦を含むあらゆる兵器運用能力でも、他の追随を許しません。"},{"spoiler":false,"text":"将来の夢は……人間に、なること。"}],"source":"bangumi","sourceCharacterId":"90476"}],"profileFacts":[{"label":"胸围（本版本）","value":"49 cm","valueContext":null,"source":"egs","sourceCharacterId":"25299","sourceWorkId":"8023","sourceField":null,"scoped":true},{"label":"罩杯（本版