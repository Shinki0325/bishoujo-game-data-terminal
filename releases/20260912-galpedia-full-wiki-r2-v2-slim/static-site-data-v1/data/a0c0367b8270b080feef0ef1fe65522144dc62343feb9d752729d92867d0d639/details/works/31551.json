ource":"vndb","sourceCharacterId":"c65711"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10771645086ed32b7cfd107d7059b03d18330c18ec7e873800b84521bd9d45d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa5fd479d2bb7bfb3bb4b4e09f633050c5876056fa5a85dc864b4c228dcc3384.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"刺草 ネトル","creatorId":"vndb:s5570","sourcePersonId":"vndb:s5570","canonicalEntityId":"vndb:s5570","name":"北山 恭祐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74320","source":"vndb"}]},{"characterId":"char_vndb_c65712","characterName":"ミツギ","sourceIds":{"vndbCharacterId":"c65712"},"originalCharacterName":"ミツギ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An architectural designer. He’s a cool lone wolf type, just as he appears, but, fundamentally, his exterior is that of a sensible, common-sense man. However, it takes surprisingly little to make his anger boil over. He’s been hostile towards Azuma alone from their very first meeting for some reason. Azuma isn’t without blame either, calling Mitsugi a “blonde shithead” to his face; Whenever these two are in the same spot together, expect a fight to break out. Seems to be participating in the tour for some reason related to his work. Good with his hands."},{"spoiler":false,"text":"Source: official website profile."}],"source":"vndb","sourceCharacterId":"c65712"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7327fc977b93c1807d2a71da43102578aa88f116820a17de6ba01228cea3709.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97ce09bb2ad6f73cc81efa72e58c897b1b2d4565955424e18aacab06a328630e.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一条 光","creatorId":"vndb:s755","sourcePersonId":"vndb:s755","canonicalEntityId":"vndb:s755","name":"笹沼 尭羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74317","source":"vndb"}]},{"characterId":"char_vndb_c65713","characterName":"マツダ","sourceIds":{"vndbCharacterId":"c65713"},"originalCharacterName":"マツダ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A salesman. Excels at taking charge of situations and good at looking after others. A manly person who will undertake a challenge even if he must play the role of the bad guy. If there’s a dispute, he’ll settle it from one step away in true Japanese fashion. He’s aware of the fact that he looks older than his age. Loves to fish. Participating in the tour because he heard of the big catches to be had fishing on the island."},{"spoiler":false,"text":"Source: official website profile."}],"source":"vndb","sourceCharacterId":"c65713"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2603f2070c791d3cae85c4e2c1bc342ab3d9289f3da5da97424801d67b3c043.webp","fal