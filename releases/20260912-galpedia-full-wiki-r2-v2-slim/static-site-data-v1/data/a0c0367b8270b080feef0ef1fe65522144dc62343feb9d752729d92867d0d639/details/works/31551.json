":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A freelance photographer. He takes pictures of everything, but he seems to have been a war photographer at one point. Looking for rare subjects, he participated in a tour for the first time and was interested in uninhabited islands. He's always shy and at his own pace, and doesn't break his stance as a bystander, but his real face is a dangerous person."}],"source":"vndb","sourceCharacterId":"c65715"},{"segments":[{"spoiler":false,"text":"生徒会長を務め、品行方正で通っている。"},{"spoiler":false,"text":"学校の風紀をただし、誰からも尊敬されている。"},{"spoiler":false,"text":"主人公はシマダのことを兄のように慕い、悩みを良く相談している。"},{"spoiler":false,"text":"どんな意見でも真剣に向き合うことで、解決しようとする、出来た人間。"},{"spoiler":false,"text":"他人の悩みを、彼なりの答えで導いていく。"}],"source":"egs","sourceCharacterId":"9565","sourceWorkId":"16109","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b851a8dac1ebd20d5b6bca9546be7229d98f86efae1a0e5dd01fb232c4ad17e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50332103ad1bcbe358204ed394f4443d956b992f11ccf92578a4dd65c4a6713e.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"機知 通","creatorId":"vndb:s35","sourcePersonId":"vndb:s35","canonicalEntityId":"vndb:s35","name":"岡崎 雅紘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74315","source":"vndb"}]},{"characterId":"char_vndb_c124869","characterName":"キド","sourceIds":{"vndbCharacterId":"c124869"},"originalCharacterName":"キド","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb