me":"椿姫 アカネ","sourceIds":{"bangumi":[{"characterId":"62270","match":"exact-normalized-name-in-linked-work","subjectId":"220518"}],"egsCharacterIds":["17123"],"vndbCharacterId":"c61406"},"originalCharacterName":"椿姫 アカネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An Aragami brought down to the world by the Divine Education Act."},{"spoiler":false,"text":"She's a naughty goddess who skips school."},{"spoiler":false,"text":"Although she possesses the power to manipulate electricity, since she's an Aragami, she can only make electricity go haywire."},{"spoiler":false,"text":"She accidentally causes power outages when angry or irritated."},{"spoiler":false,"text":"Since she easily gets angry, she causes power outages almost every day somewhere in town."},{"spoiler":false,"text":"Though she'd like to be in control of her power, things always spiral out of control when she tries to use them."},{"spoiler":false,"text":"This doesn't bother her, since she figures it's only natural for an Aragami, such as herself, to cause messes here and there."},{"spoiler":false,"text":"She's stubborn and does what she wants, but it's not because she won't listen to instruction, she just doesn't want to do what she doesn't understand."},{"spoiler":false,"text":"She gets a kick out of teasing Sho by trying to seduce him."},{"spoiler":false,"text":"She also occasionally pulls pranks on Sho and seduces him in front of Maika to make her jealous."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c61406"},{"segments":[{"spoiler":false,"text":"カミサマ教育法によって降臨したアラガミ。"},{"spoiler":false,"text":"学園にも通わず、自由気ままに生活しているヤンチャなカミサマ。"},{"spoiler":false,"text":"電気に干渉する力があるが、アラガミなので電気系統を狂わすことしかできない。"},{"spoiler":false,"text":"怒ったり動揺したりすると無意識に自分を中心に停電を引き起こす。"},{"spoiler":false,"text":"怒りっぽい性格で、何かにつけてすぐ怒るので、ほぼ毎日のようにどこかで停電を引き起こしている。"}],"source":"egs","sourceCharacterId":"17123","sourceWorkId":"25585","spoiler":false},{"segments":[{"spoiler":false,"text":"カミサマ教育法によって降臨したアラガミ（荒神）。"},{"spoiler":false,"text":"学園にも通わず、自由気ままに生活しているヤンチャなカミサマ。"},{"spoiler":false,"text":"電気に干渉する力があるものの、アラガミなので電気系統を狂わすことしかできない。"},{"spoiler":false,"text":"また怒りっぽい性格で、ほぼ毎日のようにどこかで停電を引き起こしている。"},{"spoiler":false,"text":"周囲を混乱させても、アラガミとしては当然のことなのでまったく気にしていない。"},{"spoiler":false,"text":"我儘三昧だが、言うことを聞かないわけではなく納得できないことはやらないタイプ。"},{"spoiler":false,"text":"将を誘惑して甘やかしてもらおうとするような小悪魔的な部分もある。"},{"spoiler":false,"text":"また舞花の前でわざと将を誘惑して嫉妬させるなど、悪ふざけをすることもしばしば。"},{"spoiler":false,"text":"「ざーんねん。 今日は1日ごろごろするって予定が入ってるんでーす」"}],"source":"bangumi","sourceCharacterId":"62270"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"17123","sourceWorkId":"25585","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"17123","sourceWorkId":"25585","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"17123","sourceWorkId":"25585","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"17123","sourceWorkId":"25585","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81fdf856b61cb1daab06694e0716be062fbccfb24a8ce72f184d7b423f55c451.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0ca4f2942e433b5dafc500c56991cce8711e6b7f5cd43142367aab26c7f34a7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷口夢奈","creatorId":"vndb:s14335","sourcePersonId":"vndb:s14335","canonicalEntityId":"vndb:s14335","name":"谷口 夢奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:220518:62270:29570:1","source":"bangumi"}]},{"characterId":"char_c61407","characterName":"神木 イノリ","sourceIds":{"bangumi":[{"characterId":"136441","match":"exact-normalized-name-in-linked-work","subjectId":"220518"}],"egsCharacterIds":["17124"],"vndbCharacterId":"c61407"},"originalCharacterName":"神木 イノリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An earth goddess dispatched to rehabilitate Akane who keeps causing damage to the town by not following the Divine Education Act."},{"spoiler":false,"text":"This goddess is serious and focused, but innocent; she doesn't seem to know a lot about certain things."},{"spoiler":false,"text":"Despite being the local earth goddess, she never acts arrogant, and instead talks politely to everyone."},{"spoiler":false,"text":"She is charming and elegant, but is also fairly clumsy."},{"spoiler":false,"text":"She is easy-going, with a docile personality, but brings heavy rainfall to the town when she gets angry."},{"spoiler":false,"text":"Although she rarely gets angry, once she does, the damage she inflicts is incomparable to Akane's."},{"spoiler":false,"text":"She broods over the fact that she has no prominent advantages over other goddesses, and hates to get mislabeled as a \"dirt goddess\"."},{"spoiler":false,"text":"Because of her laid-back personality, she doesn't really care even if Sho sees her naked."},{"spoiler":false,"text":"She'd even ask if he'd like to touch her chest."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c61407"},{"segments":[{"spoiler":false,"text":"カミサマ教育法に従わず町に被害を出し続けるアカネを更生するために カミサマたちから派遣された土地神様。"},{"spoiler":false,"text":"真面目だが世間ずれしておらず、物事をあまり知らない。"},{"spoiler":false,"text":"土地神なのに偉そうではなく、むしろ誰にでも敬語で話す。"},{"spoiler":false,"text":"大和撫子のような立ち居振る舞いをするがドジっ子な面もある。"},{"spoiler":false,"text":"普段はおっとりしていて、柔和な性格だが、怒ると局地的に豪雨が降る。"},{"spoiler":false,"text":"滅多に怒ることがない反面、一度怒るとアカネとは比較にならならいくらいに被害が出る。"}],"source":"egs","sourceCharacterId":"17124","sourceWorkId":"25585","spoiler":false},{"segments":[{"spoiler":false,"text":"アカネを更生するために カミサマたちから派遣された土地神様。"},{"spoiler":false,"text":"まじめで世間ずれしておらず、物事をあまり知らない。"},{"spoiler":false,"text":"柔和で大和撫子のような立ち居振る舞いをするが、ドジっ子な面もある。"},{"spoiler":false,"text":"また滅多に怒ることはないが、一度怒ると局地的に豪雨が降り甚大な○○を及ぼす。"},{"spoiler":false,"text":"おおらかな性格なので、将に裸を見られても特に気にしない。"},{"spoiler":false,"text":"むしろ 「胸を触りたいんですか？」 と、平然と聞いてしまう。"},{"spoiler":false,"text":"なお自身にこれといって長所がないことを気にしていて、"},{"spoiler":false,"text":"「地味神（じみがみ）」 と言われると性格が豹変して口が悪くなる。"},{"spoiler":false,"text":"「神木イノリと申します。 以後、お見知りおきを」"}],"source":"bangumi","sourceCharacterId":"136441"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"17124","sourceWorkId":"25585","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"17124","sourceWorkId":"25585","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"17124","sourceWorkId":"25585","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"17124","sourceWorkId":"25585","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfe27af27405ee4cc27795dbcf63e3e4b6fe8398248c541226b9556cd310c1f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55a37f78cca8811e59ba4835adb5962fc4bc43356a8cb06e94508ba9ae049b3d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝香 ゆず","creatorId":"vndb:s14336","sourcePersonId":"vndb:s14336","canonicalEntityId":"vndb:s14336","name":"朝香 ゆず","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74134","source":"vndb"}]},{"characterId":"char_c61408","characterName":"功刀 舞花","sourceIds":{"bangumi":[{"characterId":"136442","match":"exact-normalized-name-in-linked-work","subjectId":"220518"}],"egsCharacterIds":["17125"],"vndbCharacterId":"c61408"},"originalCharacterName":"功刀 舞花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sho's junior, landlady, and close childhood friend."},{"spoiler":false,"text":"She's just your average fashionable girl."},{"spoiler":false,"text":"Her looks are stylish and she loves wearing makeup."},{"spoiler":false,"text":"Contrary to her appearance, she's rather diligent and capable."},{"spoiler":false,"text":"She has feelings for Sho, but can't find it in her to confess."},{"spoiler":false,"text":"Although she works as the apartment landlady with her mother while attending school, she often makes comments about not caring if the old building gets demolished."},{"spoiler":false,"text":"In actuality, she's a good kid and is serious about looking over the apartments."},{"spoiler":false,"text":"She's tsundere, and wants to continue living there together with Sho."},{"spoiler":false,"text":"Sometimes she gets jealous when Akane or Inori gets too friendly with Sho."},{"spoiler":false,"text":"Even though she seems to know about the adult world, she blushes intensely only when Sho sees her underwear."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c61408"},{"segments":[{"spoiler":false,"text":"将の後輩兼アパートの管理人兼幼馴染。"},{"spoiler":false,"text":"あか抜けた感じの、イマドキ風女子。"},{"spoiler":false,"text":"化粧もしっかり整えた、おしゃれ系ギャル。"},{"spoiler":false,"text":"外見に反して、真面目でしっかり者で頭も良い。"},{"spoiler":false,"text":"将に好意を抱いているが、伝えられない。"},{"spoiler":false,"text":"学校に通いながら母親と共にアパートの管理をしているが、常日頃から「採算のとれないアパートはなんだから潰したほうがいい」 といっている。"}],"source":"egs","sourceCharacterId":"17125","sourceWorkId":"25585","spoiler":false},{"segments":[{"spoiler":false,"text":"将の後輩 兼 アパートの管理人 兼 幼なじみ。"},{"spoiler":false,"text":"あか抜けた感じのイマドキ風女子。 それでいてまじめなしっかり者で、頭も良い。"},{"spoiler":false,"text":"将に好意を抱いているが、伝えられないツンデレさん。"},{"spoiler":false,"text":"日頃から母に 「アパートは採算が取れないから潰したほうがいい」 と言いながらも、"},{"spoiler":false,"text":"きっちり管理人の仕事はこなしている良い子。"},{"spoiler":false,"text":"本心では、将との居場所がなくなるのは嫌だと思っている。"},{"spoiler":false,"text":"将に馴れ馴れしい アカネ や イノリ に嫉妬するなど、年頃の女の子な一面もある。"},{"spoiler":false,"text":"耳年増だが、パンツを見られただけで真っ赤になってしまう。"},{"spoiler":false,"text":"「寮母なんだから住人の安全を守る義務があるのよ」"}],"source":"bangumi","sourceCharacterId":"136442"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"17125","sourceWorkId":"25585","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"17125","sourceWorkId":"25585","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"