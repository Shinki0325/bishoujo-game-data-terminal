terminal-wiki/v1/characters/v1/images/ba/ba6f048744a5ff6654fc6c925bf33761b22197c26f6e5dbc8c6b7b9b4ff3668e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/182c7b322ef8620aa5157b0e24ea1535fbf3a5cd8dc57f55ecc1c9a887be78dc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:45094:40275:6351:1","source":"bangumi"}]},{"characterId":"char_c33869","characterName":"成瀬 鈴萌","sourceIds":{"bangumi":[{"characterId":"40276","match":"exact-normalized-name-in-linked-work","subjectId":"45094"}],"egsCharacterIds":["9139"],"vndbCharacterId":"c33869"},"originalCharacterName":"成瀬 鈴萌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桜城下付属三年生。"},{"spoiler":false,"text":"主人公の一つ下。"},{"spoiler":false,"text":"複雑な事情で成瀬家で世話になることになった愛嬌のある可愛い女の子……。"},{"spoiler":false,"text":"だが、主人公に対してはさながら女王様の振るまい。"},{"spoiler":false,"text":"主人公とは顔を合わせるたびにケンカをする仲。"},{"spoiler":false,"text":"でも寂しがり屋なので夜は主人公のベッドを占領してしまう、ネコのように気まぐれな性格の持ち主。"}],"source":"egs","sourceCharacterId":"9139","sourceWorkId":"16512","spoiler":false},{"segments":[{"spoiler":false,"text":"桜城下付属三年生。"},{"spoiler":false,"text":"複雑な大人の事情で、成瀬家で厄介になることになった愛嬌のある可愛い女の子……"},{"spoiler":false,"text":"なのだが、裕也に対してはさながら女王様の振るまいで、顔を合わせるたびにケンカする仲。"},{"spoiler":false,"text":"けれど寂しがり屋さんなので夜は裕也のベッドを占領してしまう、ネコのように気まぐれな性格の持ち主。"},{"spoiler":false,"text":"「あーあ、バカ裕也のせいでのどかわいちゃった。どっか喫茶店でも入りましょ」"}],"source":"bangumi","sourceCharacterId":"40276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/792ae4c1dd5c5b7f6812e6a5241ae7beb8bc6abdc08b20cc4107a99748c3ff59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4c61d05914b90070c989acf590a3f52b4de5b5b500d8703f1aa60ddf158abfb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:45094:40276:7890:1","source":"bangumi"}]},{"characterId":"char_c33870","characterName":"紗亘 心弦","sourceIds":{"bangumi":[{"characterId":"40277","match":"exact-normalized-name-in-linked-work","subjectId":"45094"}],"egsCharacterIds":["9140"],"vndbCharacterId":"c33870"},"originalCharacterName":"紗亘 心弦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水ノ瀬学園三年生。"},{"spoiler":false,"text":"物腰穏やかなおっとり美人なお姉さん。"},{"spoiler":false,"text":"時々出る天然はご愛敬。"},{"spoiler":false,"text":"水ノ瀬に越してきた主人公の世話を何かと焼き、年上らしく振る舞おうとするが、主人公からのダメ出しを根に持つなど子供っぽい一面も多々。"},{"spoiler":false,"text":"運動が苦手なのはその豊満なバストが邪魔なせいだとか。"}],"source":"egs","sourceCharacterId":"9140","sourceWorkId":"16512","spoiler":false},{"segments":[{"spoiler":false,"text":"水ノ瀬学園三年生。"},{"spoiler":false,"text":"物腰穏やかなおっとり美人のお姉さん。 時折出てしまう天然はご愛敬。"},{"spoiler":false,"text":"水ノ瀬に越してきた裕也の世話をなにかと焼き、年上らしく振る舞おうとするが、裕也からのダメ出しを根に持つなど子供っぽい一面も多々。"},{"spoiler":false,"text":"運動が苦手なのは、その豊満なバストが邪魔なせいだとまことしやかにささやかれている。"},{"spoiler":false,"text":"「うふふ、ごめんね つい。そうね、裕くんって少し子供っぽいところあるかも？」"}],"source":"bangumi","sourceCharacterId":"40277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9380158b42d7fa95441d7665314542dfb74113e56e3d9587fc01a81b7681a3c7.webp","