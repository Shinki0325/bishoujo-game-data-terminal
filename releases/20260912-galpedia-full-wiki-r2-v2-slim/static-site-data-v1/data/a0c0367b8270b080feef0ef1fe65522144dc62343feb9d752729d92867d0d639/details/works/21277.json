{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21277","model":{"presentationWorkId":"vndb:v10889","staff":{"artwork":[{"creditedName":"置弓枷","creatorId":"vndb:s3561","sourcePersonId":"egs:creator:3501","canonicalEntityId":"vndb:s3561","name":"置弓枷","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:292414","source":"egs"},{"creditedName":"偽おかゆ","creatorId":"vndb:s6931","sourcePersonId":"egs:creator:12518","canonicalEntityId":"vndb:s6931","name":"偽おかゆ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:292415","source":"egs"}],"scenario":[{"creditedName":"天城 悠理","creatorId":"vndb:s2413","sourcePersonId":"vndb:s2413","canonicalEntityId":"vndb:s2413","name":"天城 悠理","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:90963","source":"vndb"},{"creditedName":"桜庭 丸男","creatorId":"vndb:s2934","sourcePersonId":"vndb:s2934","canonicalEntityId":"vndb:s2934","name":"桜庭 丸男","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:90964","source":"vndb"}],"music":[{"creditedName":"浅野 彰","creatorId":"vndb:s1696","sourcePersonId":"vndb:s1696","canonicalEntityId":"vndb:s1696","name":"浅野 彰","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:90962","source":"vndb"}],"other":[{"creditedName":"デミトロ・バジーナ大尉","creatorId":"vndb:s16131","sourcePersonId":"vndb:s16131","canonicalEntityId":"vndb:s16131","name":"デミトロ・バジーナ大尉","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:90967","source":"vndb"}]},"cast":[{"characterId":"char_c24188","characterName":"スカーレット・ルンベルク","sourceIds":{"bangumi":[{"characterId":"18526","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18526","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1705"],"vndbCharacterId":"c24188"},"originalCharacterName":"スカーレット・ルンベルク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"史上最年少で法皇直属の聖騎士に抜擢された若き剣士。"},{"spoiler":false,"text":"その若さと整った顔立ちで市民の間では人気が高く、赤い装束を好んで身に纏うことから 『紅の騎士』 と呼ばれている。"},{"spoiler":false,"text":"また、二本の剣を使って舞うように戦うことから、ソードダンサーとも呼ばれている。"},{"spoiler":false,"text":"地方の王国の出だが、早くから国許を離れ聖都の皇立アカデミーで学び、卒業後は聖都を守護する守備隊に入隊。"},{"spoiler":false,"text":"女性でありながら高位の北門を任されていたエリート。"},{"spoiler":false,"text":"性格は強気だが女らしい繊細さも併せ持つ。"},{"spoiler":false,"text":"正義感が強く几帳面さも手伝って、少々融通が利かない面も。"}],"source":"egs","sourceCharacterId":"1705","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「お前などに絶対に屈し…… おっほおおおぉおおぉおおぉぉ!!!」"},{"spoiler":false,"text":"史上最年少で法皇直属の聖騎士まで上り詰めた若き剣士。"},{"spoiler":false,"text":"旧元老院、評議長アグファスとマルックにより罠にはめられつつも、その悪巧みを暴き法皇マリィを救った英雄でもある。"},{"spoiler":false,"text":"現在は、法王庁の行政機関である「元老院評議長」となっているが、ドラゴンの子を身篭ったことから、竜の騎士とも呼ばれている。"}],"source":"egs","sourceCharacterId":"1705","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"史上最年轻的被提拔为法皇直属圣骑士的年轻剑士。"},{"spoiler":false,"text":"其年轻美貌的外表在市民之间的人气很高，因为喜欢一身红色装束被称为『红骑士』。"},{"spoiler":false,"text":"同时，因为擅长使用双剑进行舞蹈一般的战斗，又被称为剑之舞姬。"},{"spoiler":false,"text":"地方的王国出身，但很早以前就离开故乡在圣都的皇立学会里学习，毕业后进入了守护圣都的守备队。"},{"spoiler":false,"text":"虽然是女性但却掌管着高位的北门的精英。"},{"spoiler":false,"text":"拥有坚强的性格以及女性的纤细。正义感很强，做事也一丝不苟，有着略为有些死板的一面。"},{"spoiler":false,"text":"「所以…我才会举起剑！！」"}],"source":"bangumi","sourceCharacterId":"18526"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba55dd7b3ccda4b18bbd1f0bbd73b025c8c4ac580d6605ed22ded53235b4454c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88af4d66aa7ebb31fb6c9bd2970c199020ba1a48f198be6fa0df088fe6a40e63.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61392:18526:8055:1","source":"bangumi"}]},{"characterId":"char_c24189","characterName":"マリアーヌ・ローエン・グリン","sourceIds":{"bangumi":[{"characterId":"18530","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18530","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1706"],"vndbCharacterId":"c24189"},"originalCharacterName":"マリアーヌ・ローエン・グリン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"61"},"height":{"reviewState":"no-conflict","source":"vndb","value":"130"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"65"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"修聖教会第36代目の法皇。 愛称はマリィ。"},{"spoiler":false,"text":"いまだ見習い状態で、正式な公務はさせてもらえない。"},{"spoiler":false,"text":"本来は明るく他人思いの優しい性格なのだが、何不自由なくそだてられた結果ワガママになってしまった。"},{"spoiler":false,"text":"しかしそれらは全て寂しさの裏返しで、心の底では愛情に飢えている。"},{"spoiler":false,"text":"唯一気を許す相手はメイドのリアン。"}],"source":"egs","sourceCharacterId":"1706","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「仲良くまぐわって何が悪いのじゃー!!」"},{"spoiler":false,"text":"修聖教会 第36代目の法皇。"},{"spoiler":false,"text":"先の聖都で起こった大災害「炎の日」から奇跡的な復興を成し遂げた若き指導者。"},{"spoiler":false,"text":"少々ひねくれた性格をしているが根は素直で優しい。"},{"spoiler":false,"text":"スカーレットとの別れを経験し、一回りも二回りも成長した。（と自分では思っている）"},{"spoiler":false,"text":"相変わらず甘いお菓子が大好物。"},{"spoiler":false,"text":"現在、聖都復興により傾いた財政をなんとかすべく、諸国を回って協力を呼びかけるたびに出ている。"},{"spoiler":false,"text":"当然ながら、マリィの身の回りの世話はメイドのリアンが行っている。"}],"source":"egs","sourceCharacterId":"1706","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"修圣教会第36任法皇。爱称玛丽。"},{"spoiler":false,"text":"现在还是见习状态，无法进行正式的公务。"},{"spoiler":false,"text":"本来是开朗和为他人着想的温和性格，但因为放任自由地长大变得很任性。"},{"spoiler":false,"text":"但是在另一面非常地寂寞，在内心深处渴望着爱情。"},{"spoiler":false,"text":"唯一能信任的对方是女仆莉安。"},{"spoiler":false,"text":"「这个世界和点心之间是能！！」"}],"source":"bangumi","sourceCharacterId":"18530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a03ae6d1e00a9163ab745f4e371b0b265e3a026dc3ddaf160ca8d6278c850b17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/780a355fd45d0bd68058e72ee551684f9dd165954f96efaa618a9637f0213692.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜木アミサ","creatorId":"vndb:s2281","sourcePersonId":"vndb:s2281","canonicalEntityId":"vndb:s2281","name":"桜木 アミサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61392:18530:15996:1","source":"bangumi"}]},{"characterId":"char_c24190","characterName":"リアン","sourceIds":{"bangumi":[{"characterId":"18531","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18531","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1707"],"vndbCharacterId":"c24190"},"originalCharacterName":"リアン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"法皇マリィの身の回りの世話をする専属のメイド。"},{"spoiler":false,"text":"平民の出だが、その素性は謎が多い。"},{"spoiler":false,"text":"美しい銀髪に整った顔立ちだが、冷たい印象のためメイド仲間からも近寄りがたい存在となっている。"},{"spoiler":false,"text":"マリィに仕えていたメイドたちは度重なるイヤガラセで居なくなってしまい、残ったのはリアンだけだった。"},{"spoiler":false,"text":"以降、マリィに気に入られ一人で身の回りの世話をしている。"}],"source":"egs","sourceCharacterId":"1707","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「マリィ様、それちょっと違う……」"},{"spoiler":false,"text":"法皇マリィの身の回りの世話をする専属のメイド。"},{"spoiler":false,"text":"元評議長のアグファスの密偵だったが、マリィの純真さに惹かれ寝返った。"},{"spoiler":false,"text":"「炎の日」では、スカーレットと協力してマリィを助けた功労者でもある。"},{"spoiler":false,"text":"その後メイドの仕事をこなしつつ、マリィの手足となって水面下で活動している。"},{"spoiler":false,"text":"この旅ではマリィに随行し、身の回りの世話全てとツッコミ役を担っている。"}],"source":"egs","sourceCharacterId":"1707","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"照顾法皇玛丽日常生活的专属女仆。"},{"spoiler":false,"text":"平民出身，但其出身有很多谜团。"},{"spoiler":false,"text":"有着美丽的银发和美丽外表。但其冷酷的印象成为了让女仆同事都难以靠近的存在。"},{"spoiler":false,"text":"而服侍玛丽的女仆们因为接二连三地惹玛丽生气的原因而离开，留下来的只有莉安。"},{"spoiler":false,"text":"在这之后，作为玛丽认可的一人而照顾日常起居。"},{"spoiler":false,"text":"「玛丽大人，到喝茶的时间了」"}],"source":"bangumi","sourceCharacterId":"18531"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/260b3850370482fda38b6eae3d7b0daf02eb7b27649cedbed820ac7aab002620.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aa24972398e93138146d8410eecf56ae3903fbc85dac99f340ec175fc27dfd8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中茉理花","creatorId":"vndb:s2571","sourcePersonId":"vndb:s2571","canonicalEntityId":"vndb:s2571","name":"田中 茉理花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61392:18531:15994:1","source":"bangumi"},{"creditedName":"神坂 秋穂","creatorId":"vndb:s3331","sourcePersonId":"vndb:s3331","canonicalEntityId":"vndb:s3331","name":"神坂 秋穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48331","source":"vndb"}]},{"characterId":"char_c24192","characterName":"ソフィア","sourceIds":{"bangumi":[{"characterId":"18533","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18533","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1709"],"vndbCharacterId":"c24192"},"originalCharacterName":"ソフィア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"修聖教会の巫女たちを束ねる巫女頭。"},{"spoiler":false,"text":"聖地に赴くスカーレットに随行、共に聖地を目指し儀式を取り仕切る役割を担う。"},{"spoiler":false,"text":"性格は温厚で聖母のような女性。"},{"spoiler":false,"text":"知識も広く、謎の多い教会の中では珍しく色々なことを説明してくれる。"},{"spoiler":false,"text":"巫女としてのお勤めに喜びを感じ、誠心誠意神に尽くしているが……"}],"source":"egs","sourceCharacterId":"1709","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「この御珍宝は神罰なのですよッ!!」"},{"spoiler":false,"text":"教会の巫女たちを束ねる巫女頭。"},{"spoiler":false,"text":"聖地に赴くスカーレットに随行し聖地を目指していたが、ルカミラの罠にハマり森に置き去りにされてしまっている。"}],"source":"egs","sourceCharacterId":"1709","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"统领修圣教会的巫女的巫女头领。"},{"spoiler":false,"text":"和赶往圣地的斯卡雷特同行，一起以圣地为目标，肩负着主管仪式的任务。"},{"spoiler":false,"text":"性格温厚，如圣母般的女性。"},{"spoiler":false,"text":"知识面很广，在谜多的教会之中说明各种各样的新奇事情。"},{"spoiler":false,"text":"对能够作为巫女而工作感到很高兴，诚心诚意地为神奉献出一切……"},{"spoiler":false,"text":"「不可以！那个御宝是为了神而使用的东西」"}],"source":"bangumi","sourceCharacterId":"18533"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/412fb00fd2ec5c726456c14cf7075debc3fc977f516f9281fe4c3c7c3e81e55a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66884ea5d34fe4fe2566f07c962d395ee90b9db4127a0fba3912d8a4ac956036.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤祐記","creatorId":"vndb:s1412","sourcePersonId":"vndb:s1412","canonicalEntityId":"vndb:s1412","name":"近藤 祐記","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61392:18533:5904:1","source":"bangumi"}]},{"characterId":"char_c24193","characterName":"ルカミラ・ハル・ロッシュ","sourceIds":{"bangumi":[{"characterId":"18532","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18532","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1708"],"vndbCharacterId":"c24193"},"originalCharacterName":"ルカミラ・ハル・ロッシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"法皇庁使節団、聖騎士の副官。"},{"spoiler":false,"text":"スカーレットとは皇立アカデミー時代から剣の腕を競う仲ではあるが、常に対抗心を持っていて内心は失敗すればいいとすら思っている。"},{"spoiler":false,"text":"副官の地位に不満を感じており、元老院評議員のマルックに接近しているとの噂も……"}],"source":"egs","sourceCharacterId":"1708","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「私が悪かったわ、だから許して、お願い許して!!」"},{"spoiler":false,"text":"法皇庁使節団、聖騎士の副官。"},{"spoiler":false,"text":"皇立アカデミー時代からスカーレットをライバル視していた。"},{"spoiler":false,"text":"使節団が聖地に入る際に謀反を起こし秘宝奪取を目論むも失敗。"},{"spoiler":false,"text":"あげくに部下からも裏切られることに……"},{"spoiler":false,"text":"罠に掛けたスカーレット同様、森の中を一人さ迷う。"}],"source":"egs","sourceCharacterId":"1708","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"法皇厅使节团，圣骑士的副官。"},{"spoiler":false,"text":"和斯卡雷特是从皇立学会时代就开始互相比拼剑术的对手关系，虽然时常抱有对抗心但是想着失败也没办法。"},{"spoiler":false,"text":"而关于她也有着对副官地位的不满，而接近元老院评议员马鲁克的传言……"},{"spoiler":false,"text":"「你在说什么？我们是朋友吧」"}],"source":"bangumi","sourceCharacterId":"18532"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cc5dc4b20ba2ab66bde36d25b99e8dcc39cae7f4ec88d312bc40217ba469579.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d3502605feebebb5ea61a84ea292820bd0fdb5420333fe4917f0ae5b8c9a466.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61392:18532:12718:1","source":"bangumi"}]},{"characterId":"char_c57976","characterName":"アグファス・ブロウニン","sourceIds":{"bangumi":[{"characterId":"18534","match":"exact-normalized-name-in-linked-work","subjectId":"61392"}],"egsCharacterIds":["13128"],"vndbCharacterId":"c57976"},"originalCharacterName":"アグファス・ブロウニン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"155cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"45kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"法王庁の中で行政を担う機関・元老院の最高権力者。"},{"spoiler":false,"text":"教会圏でも有数の大国の元国王で、実業家としての実績も持つ。"},{"spoiler":false,"text":"政治力をバックボーンに元老院評議長の座を手放そうとしない、権力欲の権化。"},{"spoiler":false,"text":"賢者をはじめとする教会上層部が秘密主義であることを快く思っていない。"},{"spoiler":false,"text":"今回の使節団派遣で、聖地から持ち出される“聖宝”を我が物にしようと企む。"}],"source":"egs","sourceCharacterId":"13128","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"法皇厅中负责行政机关·元老院的最高掌权者。"},{"spoiler":false,"text":"教会圈里也是数一数二的大国的原国王，作为实业家拥有着实绩。"},{"spoiler":false,"text":"决不会把象征政治力的中心的元老院评议长之座拱手相让，权欲的化身。"},{"spoiler":false,"text":"对以贤者为首的教会上层的秘密主义感到不快。"},{"spoiler":false,"text":"企图将这一次使节团的派遣，而将带出圣地的“圣宝”据为己有。"},{"spoiler":false,"text":"「混账，你敢忤逆我吗！！」"}],"source":"bangumi","sourceCharacterId":"18534"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dc806b29431b43ca6b11151085bce68ee6198741279952498ee2c84632dc161.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e953077af43bdfbc5eabdf27c40fbb0d8a7b249b9046d659b5052c11b75b5e0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c57977","characterName":"マルック・スタンレー","sourceIds":{"bangumi":[{"characterId":"18535","match":"exact-normalized-name-in-linked-work","subjectId":"61392"}],"egsCharacterIds":["13129"],"vndbCharacterId":"c57977"},"originalCharacterName":"マルック・スタンレー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"182cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"69kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元老院、評議員の一人。"},{"spoiler":false,"text":"貴族社会の番付ではかなり上位に位置する名門の家柄。"},{"spoiler":false,"text":"若い頃から政治家として頭角を現し、評議長アグファスの懐刀と呼ばれるまでに出世する。"},{"spoiler":false,"text":"性格は温厚、包容力があり落ち着いている。"},{"spoiler":false,"text":"しかし非情な一面を垣間見せることもあり、目的のためには手段を選ばない現実主義者。"}],"source":"egs","sourceCharacterId":"13129","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"元老院评议员之一。"},{"spoiler":false,"text":"在贵族社会的排名表中相当于上位位置的名门家族。"},{"spoiler":false,"text":"从年轻时就作为政治家而崭露头角，被称为评议长艾格法斯的匕首而大获成功。"},{"spoiler":false,"text":"性格温厚，拥有包容力，非常沉稳。"},{"spoiler":false,"text":"但是也有着无情的一面，为了目的不择手段的现实主义者。"},{"spoiler":false,"text":"「没关系，我还有其它手段」"}],"source":"bangumi","sourceCharacterId":"18535"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad3fc1dfa82375af5bdeff9e6ce5e012803c983de3aef0e7ae3cd1989dbefdd4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efab8cde11b439061144f71b66e7a2bff36fe85504785acc3450bf2b542f8b26.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c57978","characterName":"モノキオス","sourceIds":{"bangumi":[{"characterId":"18536","match":"exact-normalized-name-in-linked-work","subjectId":"61392"}],"egsCharacterIds":["13130"],"vndbCharacterId":"c57978"},"originalCharacterName":"モノキオス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"egs","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"全知の存在と言われる教会七賢者の筆頭。"},{"spoiler":false,"text":"常に冷静なしゃべり方だが、何を考えているか分からない人物。"},{"spoiler":false,"text":"性格は極めて冷徹。"},{"spoiler":false,"text":"感情の起伏ですら物理現象として考えるほど。"},{"spoiler":false,"text":"人々を導き、少しでも神に近づけることが自身の使命と信じて疑わない。"},{"spoiler":false,"text":"王侯貴族の集まりである元老院を見下したような態度をとる。"}],"source":"egs","sourceCharacterId":"13130","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"被认为是全知存在的教会七贤者的笔头。"},{"spoiler":false,"text":"平时操着一副冷静的口调，但完全令人不明白在想什么的人物。"},{"spoiler":false,"text":"性格极为冷彻。将感情的欺负也当成是物理现象来考虑。"},{"spoiler":false,"text":"也对引导人们，能够一点一点地接近神是自己的使命深信不疑。"},{"spoiler":false,"text":"对聚集着王侯贵族的元老院持轻蔑的态度。"},{"spoiler":false,"text":"「人类的心灵就是既矮小又浅陋的东西」"}],"source":"bangumi","sourceCharacterId":"18536"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5805febb1552cc6c94115ce0c8cd01f249e10e6bec580137b30cac4fa37269c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/730267612c86025d187e68bbdd17c702353ce5ef323ae9a1d96c7be45f5d562d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2930","sourceCompanyId":"egs:brand:3541","canonicalEntityId":"vndb:p2930","name":"Trois","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21277:3541","source":"egs"},{"companyId":"vndb:p19962","sourceCompanyId":"vndb:p19962","canonicalEntityId":"vndb:p19962","name":"Dazed Translations","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:141667:v10889","source":"vndb"},{"companyId":"vndb:p2930","sourceCompanyId":"vndb:p2930","canonicalEntityId":"vndb:p2930","name":"Trois","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer