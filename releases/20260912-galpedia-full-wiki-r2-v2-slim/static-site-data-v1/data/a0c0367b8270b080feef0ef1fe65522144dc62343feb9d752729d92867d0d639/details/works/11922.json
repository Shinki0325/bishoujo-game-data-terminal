terId":"50449"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"15894","sourceWorkId":"11922","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"15894","sourceWorkId":"11922","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"15894","sourceWorkId":"11922","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"15894","sourceWorkId":"11922","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7ff155db01d2bc02d8a5a1dbe0fb5a1846d5643a99c1524e821b66ed2d1dab37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/422fed8285bdb4bbb90c2a3671e1391ab0483acacbb712333ba606aa30b26723.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114760:50449:4956:1","source":"bangumi"}]},{"characterId":"char_c40610","characterName":"エリノア・ブラウンシュヴァイク","sourceIds":{"bangumi":[{"characterId":"50450","match":"exact-normalized-name-in-linked-work","subjectId":"114760"}],"egsCharacterIds":["15895"],"vndbCharacterId":"c40610"},"originalCharacterName":"エリノア・ブラウンシュヴァイク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名前以外の素性が明らかにされていない、謎の少女。"},{"spoiler":false,"text":"騎士団に所属するにふさわしい剣の腕に加えて、学問にも長けている。"},{"spoiler":false,"text":"官職に就くことを頑なに拒み、一般兵としてふるまう掴みどころのない一面も。"},{"spoiler":false,"text":"性格は完璧主義にして頑固。能力の劣る者に対しては厳しい態度をとる。"},{"spoiler":false,"text":"「――許すのは一度きりですからね。」"}],"source":"egs","sourceCharacterId":"15895","sourceWorkId":"11922","spoiler":false},{"segments":[{"spoiler":false,"text":"1年前、宮中伯ヴァーリア・クーニッツの口添えでエーデル薔薇騎士団に所属することになった女騎士。"},{"spoiler":false,"text":"騎士団に名を連ねるに相応しい剣の使い手で、豊かな教養と知識を有していたこともあり、騎士団内でその存在感を増しつつある。"},{"spoiler":false,"text":"だが能力は申し分ない一方で、官職に就くことは頑なに固辞し続けるという、掴み所のない一面を持ち合わせている。"},{"spoiler":false,"text":"性格は完璧主義にして融通の利かない頑固者。"},{"spoiler":false,"text":"口数の少ないほうではないが、能力の劣る者に対しては年齢性別問わず厳しい態度を取ることから、他人を極端に遠ざける傾向にある。"}],"source":"bangumi","sourceCharacterId":"50450"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"15895","sourceWorkId":"11922","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"15895","sourceWorkId":"11922","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"15895","sourceWorkId":"11922","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"15895","sourceWorkId":"11922","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b10a1154f9674b600ef865a8fa89e6c399735c42b02018b5cbd2e2625967b487.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f527c44fa45bdf026758dceb61bf8bdecea146ed9106c1f713ff8a716ec9369.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedNam