{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19187","model":{"presentationWorkId":"vndb:v12840","staff":{"artwork":[{"creditedName":"置弓枷","creatorId":"vndb:s3561","sourcePersonId":"egs:creator:3501","canonicalEntityId":"vndb:s3561","name":"置弓枷","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:292412","source":"egs"},{"creditedName":"偽おかゆ","creatorId":"vndb:s6931","sourcePersonId":"egs:creator:12518","canonicalEntityId":"vndb:s6931","name":"偽おかゆ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:292413","source":"egs"},{"creditedName":"ブッチャー U","creatorId":"vndb:s582","sourcePersonId":"vndb:s582","canonicalEntityId":"vndb:s582","name":"ブッチャー U","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:100839","source":"vndb"},{"creditedName":"ジェントル 佐々木","creatorId":"vndb:s1223","sourcePersonId":"vndb:s1223","canonicalEntityId":"vndb:s1223","name":"ジェントル 佐々木","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:100840","source":"vndb"},{"creditedName":"ぶぶづけ","creatorId":"vndb:s4581","sourcePersonId":"vndb:s4581","canonicalEntityId":"vndb:s4581","name":"ぶぶづけ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:100849","source":"vndb"},{"creditedName":"眼帯 ペンギン","creatorId":"vndb:s13609","sourcePersonId":"vndb:s13609","canonicalEntityId":"vndb:s13609","name":"JUNNY","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:100851","source":"vndb"}],"scenario":[{"creditedName":"北川 晴","creatorId":"vndb:s1473","sourcePersonId":"vndb:s1473","canonicalEntityId":"vndb:s1473","name":"HARE","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:100842","source":"vndb"},{"creditedName":"assault","creatorId":"vndb:s1510","sourcePersonId":"vndb:s1510","canonicalEntityId":"vndb:s1510","name":"assault","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:100843","source":"vndb"},{"creditedName":"おくとぱす","creatorId":"vndb:s1512","sourcePersonId":"vndb:s1512","canonicalEntityId":"vndb:s1512","name":"おくとぱす","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:100844","source":"vndb"},{"creditedName":"天城 悠理","creatorId":"vndb:s2413","sourcePersonId":"vndb:s2413","canonicalEntityId":"vndb:s2413","name":"天城 悠理","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:100845","source":"vndb"},{"creditedName":"桜庭 丸男","creatorId":"vndb:s2934","sourcePersonId":"vndb:s2934","canonicalEntityId":"vndb:s2934","name":"桜庭 丸男","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:100846","source":"vndb"},{"creditedName":"田中 一郎","creatorId":"vndb:s4013","sourcePersonId":"vndb:s4013","canonicalEntityId":"vndb:s4013","name":"田中 一郎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:100848","source":"vndb"}],"music":[],"other":[{"creditedName":"ジェントル 佐々木","creatorId":"vndb:s1223","sourcePersonId":"vndb:s1223","canonicalEntityId":"vndb:s1223","name":"ジェントル 佐々木","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100841","source":"vndb"}]},"cast":[{"characterId":"char_c24188","characterName":"スカーレット・ルンベルク","sourceIds":{"bangumi":[{"characterId":"18526","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18526","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1705"],"vndbCharacterId":"c24188"},"originalCharacterName":"スカーレット・ルンベルク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"史上最年少で法皇直属の聖騎士に抜擢された若き剣士。"},{"spoiler":false,"text":"その若さと整った顔立ちで市民の間では人気が高く、赤い装束を好んで身に纏うことから 『紅の騎士』 と呼ばれている。"},{"spoiler":false,"text":"また、二本の剣を使って舞うように戦うことから、ソードダンサーとも呼ばれている。"},{"spoiler":false,"text":"地方の王国の出だが、早くから国許を離れ聖都の皇立アカデミーで学び、卒業後は聖都を守護する守備隊に入隊。"},{"spoiler":false,"text":"女性でありながら高位の北門を任されていたエリート。"},{"spoiler":false,"text":"性格は強気だが女らしい繊細さも併せ持つ。"},{"spoiler":false,"text":"正義感が強く几帳面さも手伝って、少々融通が利かない面も。"}],"source":"egs","sourceCharacterId":"1705","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「お前などに絶対に屈し…… おっほおおおぉおおぉおおぉぉ!!!」"},{"spoiler":false,"text":"史上最年少で法皇直属の聖騎士まで上り詰めた若き剣士。"},{"spoiler":false,"text":"旧元老院、評議長アグファスとマルックにより罠にはめられつつも、その悪巧みを暴き法皇マリィを救った英雄でもある。"},{"spoiler":false,"text":"現在は、法王庁の行政機関である「元老院評議長」となっているが、ドラゴンの子を身篭ったことから、竜の騎士とも呼ばれている。"}],"source":"egs","sourceCharacterId":"1705","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"史上最年轻的被提拔为法皇直属圣骑士的年轻剑士。"},{"spoiler":false,"text":"其年轻美貌的外表在市民之间的人气很高，因为喜欢一身红色装束被称为『红骑士』。"},{"spoiler":false,"text":"同时，因为擅长使用双剑进行舞蹈一般的战斗，又被称为剑之舞姬。"},{"spoiler":false,"text":"地方的王国出身，但很早以前就离开故乡在圣都的皇立学会里学习，毕业后进入了守护圣都的守备队。"},{"spoiler":false,"text":"虽然是女性但却掌管着高位的北门的精英。"},{"spoiler":false,"text":"拥有坚强的性格以及女性的纤细。正义感很强，做事也一丝不苟，有着略为有些死板的一面。"},{"spoiler":false,"text":"「所以…我才会举起剑！！」"}],"source":"bangumi","sourceCharacterId":"18526"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba55dd7b3ccda4b18bbd1f0bbd73b025c8c4ac580d6605ed22ded53235b4454c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88af4d66aa7ebb31fb6c9bd2970c199020ba1a48f198be6fa0df088fe6a40e63.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89247:18526:8055:1","source":"bangumi"}]},{"characterId":"char_c24189","characterName":"マリアーヌ・ローエン・グリン","sourceIds":{"bangumi":[{"characterId":"18530","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18530","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1706"],"vndbCharacterId":"c24189"},"originalCharacterName":"マリアーヌ・ローエン・グリン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"61"},"height":{"reviewState":"no-conflict","source":"vndb","value":"130"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"65"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"修聖教会第36代目の法皇。 愛称はマリィ。"},{"spoiler":false,"text":"いまだ見習い状態で、正式な公務はさせてもらえない。"},{"spoiler":false,"text":"本来は明るく他人思いの優しい性格なのだが、何不自由なくそだてられた結果ワガママになってしまった。"},{"spoiler":false,"text":"しかしそれらは全て寂しさの裏返しで、心の底では愛情に飢えている。"},{"spoiler":false,"text":"唯一気を許す相手はメイドのリアン。"}],"source":"egs","sourceCharacterId":"1706","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「仲良くまぐわって何が悪いのじゃー!!」"},{"spoiler":false,"text":"修聖教会 第36代目の法皇。"},{"spoiler":false,"text":"先の聖都で起こった大災害「炎の日」から奇跡的な復興を成し遂げた若き指導者。"},{"spoiler":false,"text":"少々ひねくれた性格をしているが根は素直で優しい。"},{"spoiler":false,"text":"スカーレットとの別れを経験し、一回りも二回りも成長した。（と自分では思っている）"},{"spoiler":false,"text":"相変わらず甘いお菓子が大好物。"},{"spoiler":false,"text":"現在、聖都復興により傾いた財政をなんとかすべく、諸国を回って協力を呼びかけるたびに出ている。"},{"spoiler":false,"text":"当然ながら、マリィの身の回りの世話はメイドのリアンが行っている。"}],"source":"egs","sourceCharacterId":"1706","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"修圣教会第36任法皇。爱称玛丽。"},{"spoiler":false,"text":"现在还是见习状态，无法进行正式的公务。"},{"spoiler":false,"text":"本来是开朗和为他人着想的温和性格，但因为放任自由地长大变得很任性。"},{"spoiler":false,"text":"但是在另一面非常地寂寞，在内心深处渴望着爱情。"},{"spoiler":false,"text":"唯一能信任的对方是女仆莉安。"},{"spoiler":false,"text":"「这个世界和点心之间是能！！」"}],"source":"bangumi","sourceCharacterId":"18530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a03ae6d1e00a9163ab745f4e371b0b265e3a026dc3ddaf160ca8d6278c850b17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/780a355fd45d0bd68058e72ee551684f9dd165954f96efaa618a9637f0213692.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜木アミサ","creatorId":"vndb:s2281","sourcePersonId":"vndb:s2281","canonicalEntityId":"vndb:s2281","name":"桜木 アミサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89247:18530:15996:1","source":"bangumi"}]},{"characterId":"char_c24190","characterName":"リアン","sourceIds":{"bangumi":[{"characterId":"18531","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18531","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1707"],"vndbCharacterId":"c24190"},"originalCharacterName":"リアン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"法皇マリィの身の回りの世話をする専属のメイド。"},{"spoiler":false,"text":"平民の出だが、その素性は謎が多い。"},{"spoiler":false,"text":"美しい銀髪に整った顔立ちだが、冷たい印象のためメイド仲間からも近寄りがたい存在となっている。"},{"spoiler":false,"text":"マリィに仕えていたメイドたちは度重なるイヤガラセで居なくなってしまい、残ったのはリアンだけだった。"},{"spoiler":false,"text":"以降、マリィに気に入られ一人で身の回りの世話をしている。"}],"source":"egs","sourceCharacterId":"1707","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「マリィ様、それちょっと違う……」"},{"spoiler":false,"text":"法皇マリィの身の回りの世話をする専属のメイド。"},{"spoiler":false,"text":"元評議長のアグファスの密偵だったが、マリィの純真さに惹かれ寝返った。"},{"spoiler":false,"text":"「炎の日」では、スカーレットと協力してマリィを助けた功労者でもある。"},{"spoiler":false,"text":"その後メイドの仕事をこなしつつ、マリィの手足となって水面下で活動している。"},{"spoiler":false,"text":"この旅ではマリィに随行し、身の回りの世話全てとツッコミ役を担っている。"}],"source":"egs","sourceCharacterId":"1707","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"照顾法皇玛丽日常生活的专属女仆。"},{"spoiler":false,"text":"平民出身，但其出身有很多谜团。"},{"spoiler":false,"text":"有着美丽的银发和美丽外表。但其冷酷的印象成为了让女仆同事都难以靠近的存在。"},{"spoiler":false,"text":"而服侍玛丽的女仆们因为接二连三地惹玛丽生气的原因而离开，留下来的只有莉安。"},{"spoiler":false,"text":"在这之后，作为玛丽认可的一人而照顾日常起居。"},{"spoiler":false,"text":"「玛丽大人，到喝茶的时间了」"}],"source":"bangumi","sourceCharacterId":"18531"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/260b3850370482fda38b6eae3d7b0daf02eb7b27649cedbed820ac7aab002620.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aa24972398e93138146d8410eecf56ae3903fbc85dac99f340ec175fc27dfd8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中茉理花","creatorId":"vndb:s2571","sourcePersonId":"vndb:s2571","canonicalEntityId":"vndb:s2571","name":"田中 茉理花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89247:18531:15994:1","source":"bangumi"}]},{"characterId":"char_c24191","characterName":"アン","sourceIds":{"bangumi":[{"characterId":"154506","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1710"],"vndbCharacterId":"c24191"},"originalCharacterName":"アン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「気持ちわるいのやだなぁ。せめてお水で身体洗いたいな……」"},{"spoiler":false,"text":"使節団が立ち寄った村、ラッケンで、リザードマンに襲われてしまった少女。"},{"spoiler":false,"text":"その後、両親によって旅のサーカス団に売り飛ばされてしまい、ゴブリンと交わる奴隷として見世物にされる毎日を送っている。"}],"source":"egs","sourceCharacterId":"1710","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"・分支故事「怪杰小玛丽！」"},{"spoiler":false,"text":"在使节团访问的村子・拉克恩被蜥蜴人袭击的少女。"},{"spoiler":false,"text":"之后被父母卖给旅行马戏团，度过着当做是节目而与哥布林交合的奴隶的日子。"},{"spoiler":false,"text":"「感觉真难受啊。至少想用水洗洗身体啊……」"}],"source":"bangumi","sourceCharacterId":"154506"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3240933b1197ef413c1711231a986870b2e2afead1568119e62f236f678cf62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a68688680fb410ece93ec03e9004134282296efcac1e277a2437412f11f6e5e9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89247:154506:12718:1","source":"bangumi"}]},{"characterId":"char_c24192","characterName":"ソフィア","sourceIds":{"bangumi":[{"characterId":"18533","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18533","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1709"],"vndbCharacterId":"c24192"},"originalCharacterName":"ソフィア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"修聖教会の巫女たちを束ねる巫女頭。"},{"spoiler":false,"text":"聖地に赴くスカーレットに随行、共に聖地を目指し儀式を取り仕切る役割を担う。"},{"spoiler":false,"text":"性格は温厚で聖母のような女性。"},{"spoiler":false,"text":"知識も広く、謎の多い教会の中では珍しく色々なことを説明してくれる。"},{"spoiler":false,"text":"巫女としてのお勤めに喜びを感じ、誠心誠意神に尽くしているが……"}],"source":"egs","sourceCharacterId":"1709","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「この御珍宝は神罰なのですよッ!!」"},{"spoiler":false,"text":"教会の巫女たちを束ねる巫女頭。"},{"spoiler":false,"text":"聖地に赴くスカーレットに随行し聖地を目指していたが、ルカミラの罠にハマり森に置き去りにされてしまっている。"}],"source":"egs","sourceCharacterId":"1709","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"统领修圣教会的巫女的巫女头领。"},{"spoiler":false,"text":"和赶往圣地的斯卡雷特同行，一起以圣地为目标，肩负着主管仪式的任务。"},{"spoiler":false,"text":"性格温厚，如圣母般的女性。"},{"spoiler":false,"text":"知识面很广，在谜多的教会之中说明各种各样的新奇事情。"},{"spoiler":false,"text":"对能够作为巫女而工作感到很高兴，诚心诚意地为神奉献出一切……"},{"spoiler":false,"text":"「不可以！那个御宝是为了神而使用的东西」"}],"source":"bangumi","sourceCharacterId":"18533"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/412fb00fd2ec5c726456c14cf7075debc3fc977f516f9281fe4c3c7c3e81e55a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66884ea5d34fe4fe2566f07c962d395ee90b9db4127a0fba3912d8a4ac956036.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤祐記","creatorId":"vndb:s1412","sourcePersonId":"vndb:s1412","canonicalEntityId":"vndb:s1412","name":"近藤 祐記","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89247:18533:5904:1","source":"bangumi"}]},{"characterId":"char_c24193","characterName":"ルカミラ・ハル・ロッシュ","sourceIds":{"bangumi":[{"characterId":"18532","match":"exact-normalized-name-in-linked-work","subjectId":"61392"},{"characterId":"18532","match":"exact-normalized-name-in-linked-work","subjectId":"89247"}],"egsCharacterIds":["1708"],"vndbCharacterId":"c24193"},"originalCharacterName":"ルカミラ・ハル・ロッシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"法皇庁使節団、聖騎士の副官。"},{"spoiler":false,"text":"スカーレットとは皇立アカデミー時代から剣の腕を競う仲ではあるが、常に対抗心を持っていて内心は失敗すればいいとすら思っている。"},{"spoiler":false,"text":"副官の地位に不満を感じており、元老院評議員のマルックに接近しているとの噂も……"}],"source":"egs","sourceCharacterId":"1708","sourceWorkId":"16790","spoiler":false},{"segments":[{"spoiler":false,"text":"「私が悪かったわ、だから許して、お願い許して!!」"},{"spoiler":false,"text":"法皇庁使節団、聖騎士の副官。"},{"spoiler":false,"text":"皇立アカデミー時代からスカーレットをライバル視していた。"},{"spoiler":false,"text":"使節団が聖地に入る際に謀反を起こし秘宝奪取を目論むも失敗。"},{"spoiler":false,"text":"あげくに部下からも裏切られることに……"},{"spoiler":false,"text":"罠に掛けたスカーレット同様、森の中を一人さ迷う。"}],"source":"egs","sourceCharacterId":"1708","sourceWorkId":"19187","spoiler":false},{"segments":[{"spoiler":false,"text":"法皇厅使节团，圣骑士的副官。"},{"spoiler":false,"text":"和斯卡雷特是从皇立学会时代就开始互相比拼剑术的对手关系，虽然时常抱有对抗心但是想着失败也没办法。"},{"spoiler":false,"text":"而关于她也有着对副官地位的不满，而接近元老院评议员马鲁克的传言……"},{"spoiler":false,"text":"「你在说什么？我们是朋友吧」"}],"source":"bangumi","sourceCharacterId":"18532"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cc5dc4b20ba2ab66bde36d25b99e8dcc39cae7f4ec88d312bc40217ba469579.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d3502605feebebb5ea61a84ea292820bd0fdb5420333fe4917f0ae5b8c9a466.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89247:18532:12718:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p2930","sourceCompanyId":"egs:brand:3541","canonicalEntityId":"vndb:p2930","name":"Trois","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:19187:3541","source":"egs"},{"companyId":"vndb:p2930","sourceCompanyId":"vndb:p2930","canonicalEntityId":"vndb:p2930","name":"Trois","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:31957:v12840","source":"vndb"},{"companyId":"vndb:p2930","sourceCompanyId":"vndb:p2930","canonicalEntityId":"vndb:p2930","name":"Trois","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:34693:v12840","source":"vndb"},{"companyId":"vndb:p2930","sourceCompanyId":"vndb:p2930","canonicalEntityId":"vndb:p2930","name":"Trois","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:87526:v12840","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
