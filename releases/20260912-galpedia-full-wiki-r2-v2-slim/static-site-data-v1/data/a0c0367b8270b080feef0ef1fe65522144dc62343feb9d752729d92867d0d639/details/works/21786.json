s":"source-native","relationId":"vndb:vn-staff:119065","source":"vndb"}]},"cast":[{"characterId":"char_c32678","characterName":"白鳥 真由","sourceIds":{"bangumi":[{"characterId":"34444","match":"exact-normalized-name-in-linked-work","subjectId":"129720"}],"egsCharacterIds":["6374"],"vndbCharacterId":"c32678"},"originalCharacterName":"白鳥 真由","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立海浜樟南女子学園2年生で料縫部部長であり主人公の幼馴染み。"},{"spoiler":false,"text":"学園の寮に住んでいる。"},{"spoiler":false,"text":"世話焼きなものの、肝心なところは消極的であり、自分にない積極性を持っているアリスと何かと張り合ってしまう。"},{"spoiler":false,"text":"基本的に丁寧接するので、周りからはおしとやかな女性という印象を持たれている。"},{"spoiler":false,"text":"信一がいれてくれたロイヤルパシフィックミルクティーが好き。"},{"spoiler":false,"text":"また、生クリームも好きでパンケーキにはたっぷりのせるが、他人は胸焼けを起こすほどの量をのせる。"},{"spoiler":false,"text":"昔から真由はこの食べ方をするのだが、それに付き合わされていた信一は生クリームが苦手になった。"}],"source":"egs","sourceCharacterId":"6374","sourceWorkId":"21786","spoiler":false},{"segments":[{"spoiler":false,"text":"私立 海浜樟南女子学園 2年生。 料縫部部長で主人公の幼なじみ。 学園の寮住まい。"},{"spoiler":false,"text":"人づきあいを丁寧にこなすので、周りからはおしとやかな女性という印象を持たれている。"},{"spoiler":false,"text":"世話焼きなものの、肝心なところは消極的。 自分にない積極性を持っているアリスとはつい張り合ってしまう。"},{"spoiler":false,"text":"信一が淹れてくれたロイヤルパシフィックミルクティーが好き。"},{"spoiler":false,"text":"生クリームも好きで、パンケーキにたっぷりのせる。 それはもう他人は胸焼けを起こすほど……。"},{"spoiler":false,"text":"昔からこの食べ方で、それに付き合わされていた信一は生クリームが苦手になった。"}],"source":"bangumi","sourceCharacterId":"34444"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbce9851211813280b504cde2baabf2aa6dd30ed9c98e1d34c649651b1ce3929.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f20af812aa4f4990ec49369919b8ad6338b14ea2e387600dbcdcad360bd62cd.webp","width":213,"height":256,"source":"static-detail"},"actors"