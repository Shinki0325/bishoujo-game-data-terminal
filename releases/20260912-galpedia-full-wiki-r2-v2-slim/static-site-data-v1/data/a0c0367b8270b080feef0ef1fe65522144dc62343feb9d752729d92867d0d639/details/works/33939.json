{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33939","model":{"presentationWorkId":"vndb:v42616","staff":{"artwork":[{"creditedName":"神藤みけこ(みけこ)","creatorId":"vndb:s900","sourcePersonId":"egs:creator:1743","canonicalEntityId":"vndb:s900","name":"神藤みけこ(みけこ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:260499","source":"egs"}],"scenario":[{"creditedName":"づか","creatorId":"vndb:s9838","sourcePersonId":"egs:creator:27056","canonicalEntityId":"vndb:s9838","name":"づか","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:260498","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c124662","characterName":"支倉 美愛","sourceIds":{"vndbCharacterId":"c124662"},"originalCharacterName":"支倉 美愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A college student at a local university."},{"spoiler":false,"text":"Her biological father died when she was young, and she and Makoto became siblings when her mother remarried."},{"spoiler":false,"text":"She is a serious and firm person who is relied upon by everyone around her."},{"spoiler":false,"text":"However, when her doting younger brother is involved, she is a bit lax in her judgment."},{"spoiler":false,"text":"She cares for Makoto, but her feelings are family ones, and she has no romantic feelings for him."}],"source":"vndb","sourceCharacterId":"c124662"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec9b7f30828db786569ad0598a436b00dbf817ea30ba627db8d1fc06f45137c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed4061495936bbbe5d4a06a432af1d40f2ea88606d0df97089582a5ad55931e7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月読 梓","creatorId":"vndb:s22687","sourcePersonId":"vndb:s22687","canonicalEntityId":"vndb:s22687","name":"月読 梓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94523","source":"vndb"}]},{"characterId":"char_vndb_c124663","characterName":"支倉 誠","sourceIds":{"vndbCharacterId":"c124663"},"originalCharacterName":"支倉 誠","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Makoto Shikura is a second-year student at the school."},{"spoiler":false,"text":"He and Miai became siblings when their father remarried and came to live together."},{"spoiler":false,"text":"He is generally good-natured and calm."},{"spoiler":false,"text":"However, he was traumatized by his parents' divorce, and although his interactions with Miai have improved, he is still a little uncomfortable with women."},{"spoiler":false,"text":"He respects Miai as an older sister for her patience with him, but at the same time, he is also becoming conscious of her as a woman."}],"source":"vndb","sourceCharacterId":"c124663"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c124664","characterName":"江坂 臣","sourceIds":{"vndbCharacterId":"c124664"},"originalCharacterName":"江坂 臣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Esaka is a good student, and he does his student life and part-time jobs in moderation, while cutting corners."},{"spoiler":false,"text":"However, he has an unparalleled love for women, and is aggressive to the point of being forceful when it comes to the women he likes."},{"spoiler":false,"text":"Although he and Makoto have a lot in common, their tastes and personalities are so different that they keep a safe distance from each other."}],"source":"vndb","sourceCharacterId":"c124664"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5a552abaf2d28d79739340fdbedad92782bf23838ef8eb3ddd2435feaeea6fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3b927856dbe8eaf6ccb9eee076af6140ddecc78dcce09ede1613f3c467301f3.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1224","sourceCompanyId":"egs:brand:6706","canonicalEntityId":"vndb:p1224","name":"アトリエさくら","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33939:6706","source":"egs"},{"companyId":"vndb:p1224","sourceCompanyId":"vndb:p1224","canonicalEntityId":"vndb:p1224","name":"アトリエさくら","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:114316:v42616","source":"vndb"},{"companyId":"vndb:p1224","sourceCompanyId":"vndb:p1224","canonicalEntityId":"vndb:p1224","name":"アトリエさくら","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:117331:v42616","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
