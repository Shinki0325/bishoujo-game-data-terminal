jo.date/terminal-wiki/v1/characters/v1/images/67/6790d9b7d710851ba90756587d3a14e5765f5404aa69495c511ec7b3d4831faf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd7cc5585d651435e97eee7e927cfc8a80a5f3ff7f87ac4a49945ffff7f4eacd.webp","width":256,"height":222,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_126754","characterName":"シュネー","sourceIds":{"bangumi":[{"characterId":"126754","match":"source-roster","subjectId":"310545"}]},"originalCharacterName":"シュネー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とある城の王女だったが、美しさが仇となって継母に城を追い出されてしまう。"},{"spoiler":false,"text":"気弱で引っ込み思案な性格だが、迷子の自分を助けてくれた７人の小人たちの為に毎日家事を手伝っている。"},{"spoiler":false,"text":"ある日、いつものように森に食材を探しに出掛けるが・・・"},{"spoiler":false,"text":"～追跡者～"},{"spoiler":false,"text":"魔女に扮した女王、他"}],"source":"bangumi","sourceCharacterId":"126754"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d86fc7dc212342c329a461a3e0b8698646c678f760535b6290228cbd945bdcd6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d88a30d81019885bbe7f1d1b74bc22dda1e4b0eb952623da3b70b7c845cded1.webp","width":256,"height":222,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_126755","characterName":"マイア","sourceIds":{"bangumi":[{"characterId":"126755","match":"source-roster","subjectId":"310545"}]},"originalCharacterName":"マイア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔法使いの小麦の種より生まれた親指サイズの女の子。"},{"spoiler":false,"text":"世間知らず故か思ったこ