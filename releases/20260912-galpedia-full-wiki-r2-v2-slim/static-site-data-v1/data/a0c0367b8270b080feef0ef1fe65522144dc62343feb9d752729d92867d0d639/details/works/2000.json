}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Japanese teacher at Reiki Girls' Academy, and the homeroom teacher of Haruka and Mizuki, 25 years old."},{"spoiler":false,"text":"A year ago, she broke off her engagement and hasn't had a boyfriend since."},{"spoiler":false,"text":"She was originally supposed to be the dorm supervisor this year, so she is suspicious of the last-minute personnel changes that saw her replaced by Oizumi."},{"spoiler":false,"text":"Because of the broken engagement, she has become distrustful of men, and is cold towards Kengo."},{"spoiler":false,"text":"Translated from the official site,archived"}],"source":"vndb","sourceCharacterId":"c122795"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23d57913efe1583c3acb52398c85bf0ecdfc77848ba1f3ac70afa09edf7322f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/238abe1ed82a8bd61db24f86f321944f10f41e0666d66efe61c7de53fff58643.webp","width":113,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18685","source":"vndb"}]},{"characterId":"char_vndb_c122796","characterName":"藤村 貴子","sourceIds":{"vndbCharacterId":"c122796"},"originalCharacterName":"藤村 貴子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","