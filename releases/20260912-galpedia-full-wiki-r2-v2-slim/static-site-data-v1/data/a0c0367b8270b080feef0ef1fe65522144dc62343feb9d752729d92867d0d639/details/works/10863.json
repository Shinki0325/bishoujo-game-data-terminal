ue},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"18160","sourceWorkId":"10863","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15957eb0933d5fb1df78272fa7def05a2fb2a52517e16743f72c032955c8fdbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b720a3a37c8fceeaec5f2a5c2b3f8b41e581f4ec941e782cc5572f6668ed8264.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:119476:28308:4432:1","source":"bangumi"}]},{"characterId":"char_c50122","characterName":"聖堂 鶴未","sourceIds":{"bangumi":[{"characterId":"28309","match":"exact-normalized-name-in-linked-work","subjectId":"119476"}],"egsCharacterIds":["18161"],"vndbCharacterId":"c50122"},"originalCharacterName":"聖堂 鶴未","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1224"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Green tea, children."},{"spoiler":false,"text":"Dislikes: Carrots."},{"spoiler":false,"text":"A third year student at Seidou Gakuen who is the granddaughter of the headmaster. Tsurumi is also the leader of the \"Administration Department\" and as such she is the most charismatic and popular student in her school. Tsurumi has an aloof and strict personality and she despises pathetic and worthless men."},{"spoiler":false,"text":"Translated from Gyutto."}],"source":"vndb","sourceCharacterId":"c50122"},{"segments":[{"spoiler":false,"text":"聖堂学園三年。理事長の孫にして学園組織「管理部」会長。"},{"spoiler":false,"text":"学園ナンバーワンの権力を持つ、人気抜群のカリスマ生徒。"},{"spoiler":false,"text":"厳格な人柄で、クール。情けない男が大嫌い。"},{"spoiler":false,"text":"「私と貴様がどれほどかけ離れた人間であるか、望みどおり証明して見せよう」"}],"source":"egs","sourceCharacterId":"18161","sourceWorkId":"10863","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の中心組織\"管理部\"の会長を務め、学園内で圧倒的なファンを持つカリスマ女学生。"},{"spoiler":false,"text":"教師陣からの信頼も厚く、学園理事長の孫という立場から、実質学園のナンバーワン権力者。"},{"spoiler":false,"text":"冷徹でクール、情けない男が大嫌い。自分に厳しく、他人にはもっと厳しい。"},{"spoiler":false,"text":"主人公に学園生活の是非を説き、人員不足の管理部に引き入れる。"},{"spoiler":false,"text":"主人公の上級生。"},{"spoiler":false,"text":"「私と貴様がどれほどかけ離れた人間であるか、望み通り証明して見せよう」"}],"source":"bangumi","sourceCharacterId":"28309"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"18161","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"18161","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"18161","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"18161","sourceWorkId":"10863","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/226a9f42b93eafd48a83e57def1a6794ac177578ebdd9941d2010448e038e161.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69e5a26d87fbcc8da705d42457ba9ee5fdb7c21bf38ddb8ea20b046ced559