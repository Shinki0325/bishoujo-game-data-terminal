/v1/characters/v1/images/62/626514e15799d945d4c1cf5919dbd557677f4fdf91ff6d091e6023575ae4855a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a97523d784ed2d900ef32ee44d60bcebe490be2d8e55ef5074b55c2578ce7f46.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:119476:28311:6509:1","source":"bangumi"}]},{"characterId":"char_c50126","characterName":"結城 芹","sourceIds":{"bangumi":[{"characterId":"28312","match":"exact-normalized-name-in-linked-work","subjectId":"119476"}],"egsCharacterIds":["18164"],"vndbCharacterId":"c50126"},"originalCharacterName":"結城 芹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"615"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seri is a student at the prestigious \"St. Lawrence Girls' Academy\" for refined young ladies, which is located right next to Seidou Gakuen, the school that the protagonist attends."},{"spoiler":false,"text":"Seri is a gentle and mature young lady who instills a warm and loving atmosphere around her. For that reason she is quite popular at her school especially with junior students who tend to call her their onee-sama (older sister). Seri has two main weaknesses, one of which is her insecurity about having small breasts. Her second weak point is being unfamiliar with men, since she has only been attending schools for girls all her life. Despite her insecurity Seri deeply longs for true love and enjoys writing romance novels in her spare time."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c50126"},{"segments":[{"spoiler":false,"text":"聖・ローレンス女学院三年。男性が苦手なお嬢様。"},{"spoiler":false,"text":"温厚で優しい性格から学園で「お姉さま」と慕われている。"},{"spoiler":false,"text":"女子校育ちで男性への免疫ゼロだが、恋に恋する気持ちが強く、恋愛小説に思いを込める。"},{"spoiler":false,"text":"「あぅ、や、やめて……やめてください…っ……オデコ触るのやめて」"}],"source":"egs","sourceCharacterId":"18164","sourceWorkId":"10863","spoiler":false},{"segments":[{"spoiler":false,"text":"お嬢様ばかりが集まる名門\"聖・ローレンス女学院\"の学生。 主人公たちの通う聖堂学園から程近い位置にある学院で、芹は後輩たちから「お姉さま、お姉さま」と慕われる人気者。"},{"spoiler":false,"text":"温厚で優しく、すべてを包み込むような暖かい雰囲気のする女性。"},{"spoiler":false,"text":"小さい胸に密かなコンプレックスを持っている。"},{"spoiler":false,"text":"幼い頃から一貫して女子高に通っていたため、男性に対しての免疫がまったくない。"},{"spoiler":false,"text":"恋愛に対して\"憧れ\"だけは人一倍持っているので、それを恋愛小説として自分で書いている。"},{"spoiler":false,"text":"「あぅ、や、やめて…やめてください…っ、オデコ触るのやめて」"}],"source":"bangumi","sourceCharacterId":"28312"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"18164","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"18164","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"18164","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"18164","sourceWorkId":"10863","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6be7179e4083b1a9496dedaa3f6c219e091947f6f8fed6215f6f228738f6d2fd