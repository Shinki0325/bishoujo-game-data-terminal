{"spoiler":false,"text":"今年から学園に入学した新入生美少女。"},{"spoiler":false,"text":"下級生ながら鶴未ときよらに並び、密かにファンを増やしつつある新株の学園アイドル。"},{"spoiler":false,"text":"あまり感情を表に出さないタイプだが、その実、計算高くてわりと悪女。"},{"spoiler":false,"text":"ファンの間では「姫」と呼ばれている。"},{"spoiler":false,"text":"鶴未とは姉妹関係。"},{"spoiler":false,"text":"「……うぃ」"}],"source":"bangumi","sourceCharacterId":"28310"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"18162","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"18162","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"18162","sourceWorkId":"10863","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"18162","sourceWorkId":"10863","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/865d012f1e1790885302c39402d0996e16b53a853b226b6618fef816b7ab1bac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/539471b7d9c62a726fc39f1abf4cac75757f5984148b395cecb8d43f319ac622.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:119476:28310:4646:1","source":"bangumi"}]},{"characterId":"char_c50124","characterName":"天宮 心愛","sourceIds":{"bangumi":[{"characterId":"28311","match":"exact-normalized-name-in-linked-work","subjectId":"119476"}],"egsCharacterIds":["18163"],"vndbCharacterId":"c50124"},"originalCharacterName":"天宮 心愛","characterNameSource":null,"role":"primary","status":"source-only-cand