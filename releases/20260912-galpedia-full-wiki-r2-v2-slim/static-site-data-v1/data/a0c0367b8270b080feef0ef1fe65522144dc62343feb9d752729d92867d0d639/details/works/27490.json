 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268291:68452:5922:1","source":"bangumi"}]},{"characterId":"char_c79823","characterName":"アルティーシア","sourceIds":{"bangumi":[{"characterId":"68449","match":"source-roster","subjectId":"268291"},{"characterId":"68449","match":"source-roster","subjectId":"326857"},{"characterId":"68449","match":"exact-normalized-name-in-linked-work","subjectId":"378157"},{"characterId":"68449","match":"source-roster","subjectId":"378157"}],"egsCharacterIds":["20661"],"vndbCharacterId":"c79823"},"originalCharacterName":"アルティーシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"ちっこい"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second princess of Maaladian."}],"source":"vndb","sourceCharacterId":"c79823"},{"segments":[{"spoiler":false,"text":"エルフロリ娘。"},{"spoiler":false,"text":"エルフの王国、マーラディアンの第二王女。"},{"spoiler":false,"text":"少し桃色がかった長い銀髪。普段はきれいにまとめられている。"},{"spoiler":false,"text":"復讐王の反乱により死の間際まで追い詰められたのだが、間一髪で異界よりこの世界に逃がされた。"},{"spoiler":false,"text":"この世界では力の制限をされており、すこし幼い姿となっている。"},{"spoiler":false,"text":"アーシャとの半強制的な契約により、さくらは地獄の淵に立たされることになる。"},{"spoiler":false,"text":"ロリババア。おっぱいたちも大好き。"},{"spoiler":false,"text":"自分のことを聞かれると非常に弱い。"},{"spoiler":false,"text":"顔真っ赤になってしどろもどろに。"}],"source":"egs","sourceCharacterId":"20661","sourceWorkId":"27490","spoiler":false},{"segments":[{"spoiler":false,"text":"エルフのロリ娘。"},{"spoiler":false,"text":"エルフの王国、マーラディアンの元第二王女。"},{"spoiler":false,"text":"少し桃色がかった銀髪。サイドテールがフリフリとかわいい。"},{"spoiler":false,"text":"以前、エルフの国を地獄へと導こうとした、復讐王「グウェイン」の反乱をさくら達と共にうち払い、マーラディアンを救った英雄の一人。"},{"spoiler":false,"text":"事が終わった後もマーラディアンには戻らず、さくら達とともに人間界で共同生活している。"},{"spoiler":false,"text":"この世界では力の制限をされており、すこし幼い姿となっている。"},{"spoiler":false,"text":"おっぱいたちが大好き。"},{"spoiler":false,"text":"半面、自分のことを聞かれると非常に弱い。顔真っ赤になってしどろもどろに。"}],"source":"egs","sourceCharacterId":"20661","sourceWorkId":"32562","spoiler":false},{"segments":[{"spoiler":false,"text":"エルフロリ娘。"},{"spoiler":false,"text":"エルフの王国、マーラディアンの第二王女。"},{"spoiler":false,"text":"少し桃色がかった長い銀髪。普段はきれいにまとめられている。"},{"spoiler":false,"text":"復讐王の反乱により死の間際まで追い詰められたのだが、"},{"spoiler":false,"text":"間一髪で異界よりこの世界に逃がされた。"},{"spoiler":false,"text":"この世界では力の制御をされており少し幼い姿となっている。"},{"spoiler":false,"text":"アーシャとの半強制的な契約により、"},{"spoiler":false,"text":"さくらは地獄の淵に立たされることになる。"},{"spoiler":false,"text":"ロリババア。おっぱいたちも大好き。"},{"spoiler":false,"text":"自分のことを聞かれると非常に弱い。"},{"spoiler":false,"text":"顔真っ赤になってしどろもどろに。"},{"spoiler":false,"text":"「私の名はアルティーシア。アーシャと呼んでくれ。」"}],"source":"bangumi","sourceCharacterId":"68449"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a591d240cf2c7eeb5ae47799f11c7d53aefc334a62f2cf18f15d3534522b01b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62d1a070eda6e7155656d299df99c630c4ff5ed0d0095586248f157e4f8c38f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林桂子","creatorId":"vndb:s443","sourcePersonId":"vndb:s443","canonicalEntityId":"vndb:s443","name":"美月(声優)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268291:68449:16180:1","source":"bangumi"}]},{"characterId":"char_vndb_c112295","characterName":"リューネシア","sourceIds":{"vndbCharacterId":"c112295"},"originalCharacterName":"リューネシア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"First princess of Maaladian."}],"source":"vndb","sourceCharacterId":"c112295"}],"profileFacts":[],"metadataCa