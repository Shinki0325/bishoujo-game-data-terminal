o.date/terminal-wiki/v1/characters/v1/images/60/6007ce2af3749f48960a3277d557e3b40574a0a867c2c8b23d6c470c9ac95c05.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"猫野うさぎ","creatorId":"vndb:s15677","sourcePersonId":"vndb:s15677","canonicalEntityId":"vndb:s15677","name":"猫野うさぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285632:72059:35573:1","source":"bangumi"}]},{"characterId":"char_c85977","characterName":"ディアナ＝マルソール","sourceIds":{"bangumi":[{"characterId":"72060","match":"exact-normalized-name-in-linked-work","subjectId":"285632"}],"egsCharacterIds":["21519"],"vndbCharacterId":"c85977"},"originalCharacterName":"ディアナ＝マルソール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third princess of the Holy Kingdom of Montiana."},{"spoiler":false,"text":"In accordance with royal custom, she joined the Priest Knights for training."},{"spoiler":false,"text":"She has a proud, competitive, and strong-willed personality."},{"spoiler":false,"text":"She does not hide her dissatisfaction and anger at being unreasonably detained."},{"spoiler":false,"text":"During joint training with the Bulwono Kingdom, she learns that Bulwono is preparing to send troops to annihilate a mysterious army, and takes on the role herself."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c85977"},{"segments":[{"spoiler":false,"text":"神聖王国【モンティアナ】の第三王女。"},{"spoiler":false,"text":"王家のしきたりに則り、修行のため神官騎士団に所属。"},{"spoiler":false,"text":"性格は誇り高く勝気で強気。理不尽に拘束されたことへの不満と怒りを隠しもしない。"},{"spoiler":false,"text":"【ブルウォノ】王国で合同訓練を行っている最中、【ブルウォノ】が謎の軍隊を殲滅するため派兵準備を進めていると知って自らその役目を引き受ける。"}],"source":"egs","sourceCharacterId":"21519","sourceWorkId":"28128","spoiler":false},{"segments":[{"spoiler":false,"text":"神聖王国【モンティアナ】の第三王女。"},{"spoiler":false,"text":"王家のしきたりに則り、修行のため神官騎士団に所属。"},{"spoiler":false,"text":"性格は誇り高く勝気で強気。"},{"spoiler":false,"text":"理不尽に拘束されたことへの不満と怒りを隠しもしない。"},{"spoiler":false,"text":"【ブルウォノ】王国で合同訓練を行っている最中、"},{"spoiler":false,"text":"【ブルウォノ】が謎の軍隊を殲滅するため、"},{"spoiler":false,"text":"派兵準備を進めていると知って自らその役目を引き受ける。"}],"source":"bangumi","sourceCharacterId":"72060"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/5672f7603e136f4df3bcc79d43071fcf1941e8631f8e4a63bc5e48cf123fcec9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/048ec23696fc90d7ee7e336ccdd0c2ab7bb0b73610819f0487ed91085a508cc2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤陽菜乃","creatorId":"vndb:s17737","sourcePersonId":"vndb:s17737","canonicalEntityId":"vndb:s17737","name":"加藤 陽菜乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285632:72060:35572:1","source":"bangumi"}]},{"characterId":"char_c85978","characterName":"フリーダ＝ベーレンブルッフ","sourceIds":{"bangumi":[{"characterId":"72061","match":"exact-normalized-name-in-linked-work","subjectId":"285632"}],"egsCharacterIds":["21520"],"vndbCharacterId":"c85978"},"originalCharacterName":"フリーダ＝ベーレンブルッフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Furth woman, secretary to the major."},{"spoiler":false,"text":"Her rank is lieutenant."},{"spoiler":false,"text":"In contrast to her intelligent and cold appearance, she has a voluptuous body and exudes a somewhat seductive aura."},{"spoiler":false,"text":"Born into a family of military men, she grew up dreaming of one day inheriting the family business, but was devastated when she found out that she could not inherit the family business because she was a woman."},{"spoiler":false,"text":"Around that time, she met the major (still a captain at the time), and when she learned that he was burning with ambition, she used the backing of the Berenbruch family to somehow get him to promote her as secretary, and as a result of contributing to the major's promotion, she achieved her current position."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c85978"},{"segments":[{"spoiler":false,"text":"フルト人女性、少佐の秘書官。階級は中尉。"},{"spoiler":false,"text":"知的で冷徹な容貌とは裏腹に、艶かしい肢体を持ち、どこか蟲惑的な雰囲気を漂わせている。"},{"spoiler":false,"text":"代々軍人の家に生まれ、いずれ家督を継ぐ事を夢見て育ったが、女性であるため一家の家督を継げないとわかって絶望。"},{"spoiler":false,"text":"そんな頃に少佐（当時まだ大尉）と知り合い、出世の野望に燃えていると知ってベーレンブルッフ家の後ろ盾をエサに、どうにか秘書官として取り立てる約束を貰い、少佐の出世に貢献した結果今の地位を得る。"}],"source":"egs","sourceCharacterId":"21520","sourceWorkId":"28128","spoiler":false},{"segments":[{"spoiler":false,"text":"フルト人女性、少佐の秘書官。階級は中尉。"},{"spoiler":false,"text":"知的で冷徹な容貌とは裏腹に、艶かしい肢体を持ち、"},{"spoiler":false,"text":"どこか蟲惑的な雰囲気を漂わせている。"},{"spoiler":false,"text":"代々軍人の家に生まれ、いずれ家督を継ぐ事を夢見て育ったが、"},{"spoiler":false,"text":"女性であるため一家の家督を継げないとわかって絶望。"},{"spoiler":false,"text":"そんな頃に少佐（当時まだ大尉）と知り合い、"},{"spoiler":false,"text":"出世の野望に燃えていると知ってベーレンブルッフ家の後ろ盾をエサに、"},{"spoiler":false,"text":"どうにか秘書官として取り立てる約束を貰い、"},{"spoiler":false,"text":"少佐の出世に貢献した結果今の地位を得る。"}],"source":"bangumi","sourceCharacterId":"72061"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9198debbce65058e30968a68d8e792e39dac0b918c78df0c0dd0499d3e8ac448.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d04523cc8ffc514610a004b0b8f3e7168aee97f521fc37b54d509789b3f08ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朱野みゆき","creatorId":"vndb:s14829","sourcePersonId":"vndb:s14829","canonicalEntityId":"vndb:s14829","name":"朱野 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285632:72061:35575:1","source":"bangumi"}]},{"characterId":"char_c85982","characterName":"ディルク＝ベルンシュタイン","sourceIds":{"bangumi":[],"egsCharacterIds":["21516"],"vndbCharacterId":"c85982"},"originalCharacterName":"ディルク＝ベルンシュタイン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story, a military intelligence officer."},{"spoiler":false,"text":"His rank is Major."},{"spoiler":false,"text":"He has frontline experience and is a holder of the Silver Melee Medal."},{"spoiler":false,"text":"He ended up being transported to this world with his unit from Europe in 1945."},{"spoiler":false,"text":"Together with the researchers he has gathered, he has developed various interrogation and torture devices and methods."},{"spoiler":false,"text":"He is also quite a sadist, and feels strong sexual arousal from restraining and torturing people, and then seeing this transform into pleasure."},{"spoiler":false,"text":"He often takes the initiative in interrogating women, especially."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c85982"},{"segments":[{"spoiler":false,"text":"本編の主人公であり、軍の情報将校。階級は少佐。"},{"spoiler":false,"text":"前線経験者であり、白兵戦章の銀章所持者。"},{"spoiler":false,"text":"1945年のヨーロッパから己の部隊と共にこの世界に転移する羽目となった。"},{"spoiler":false,"text":"独自に集めた研究者達と共に様々な尋問・拷問の器具や方法の開発を行ってきた。"},{"spoiler":false,"text":"また相当なサディストであり、拘束し、痛めつけ、やがてそれらが快楽へと変貌していく事に強い性的興奮を覚える。"},{"spoiler":false,"text":"特に対象者が女の場合は自ら尋問に乗り出すことも多い。"}],"source":"egs","sourceCharacterId":"21516","sourceWorkId":"28128","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},