mi"}]},{"characterId":"char_c56464","characterName":"綾佳","sourceIds":{"bangumi":[{"characterId":"123248","match":"exact-normalized-name-in-linked-work","subjectId":"174565"}],"egsCharacterIds":["10633"],"vndbCharacterId":"c56464"},"originalCharacterName":"綾佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レンの娘。"},{"spoiler":false,"text":"5年前に美弥香に引き取られ、神武ビルの同じ部屋で生活している。"},{"spoiler":false,"text":"家事全般を担当しており、特に料理の腕はメキメキと上達中。"},{"spoiler":false,"text":"美弥香と良好な関係を築けている一方で、レンとの関係はほとんど変わっておらず、もっと距離を縮めたいと思っている。"}],"source":"egs","sourceCharacterId":"10633","sourceWorkId":"22735","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82ebd1cde59f323887400b593eb4c69342525846b8fcc921069ba16d69c12e07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37fa47461e876919cc6f7b59144a7f1a00239ea2dc898bf94f34997d29b657a4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木クルタ","creatorId":"vndb:s23104","sourcePersonId":"vndb:s23104","canonicalEntityId":"vndb:s23104","name":"鈴木クルタ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68962","source":"vndb"}]},{"characterId":"char_c56465","characterName":"レン","sourceIds":{"bangumi":[{"characterId":"123251","match":"exact-normalized-name-in-linked-work","subjectId":"174565"}],"egsCharacterIds":["10632"],"vndbCharacterId":"c56465"},"originalCharacterName":"レン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"蟲使いと呼ばれる一族の次