NameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"627"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Physically frail and emotionally withdrawn, Aoi seems lost in perpetual deep thought and socially unapproachable. Due to this, relatively few individuals pay heed to her existence, much less acknowledge as a friend. To those cherished people who know better, Aoi is unfailingly devoted and dependable, occasionally surprising them with her quirky yet endearing hidden personality."},{"spoiler":false,"text":"From Eroge Review"}],"source":"vndb","sourceCharacterId":"c4732"},{"segments":[{"spoiler":false,"text":"内気でネガティブな女の子。あかねとは幼馴染。"},{"spoiler":false,"text":"運動が苦手で、勉強自体もあまり好きではない。かといって、劣等生なわけでもない。"},{"spoiler":false,"text":"趣味は音楽鑑賞だが、その暗い性格とは対照的にヘヴィメタルなど激しい音楽を好む（特に鬱なゴシックメタル）。"},{"spoiler":false,"text":"父親と兄が自動車事故（加害者）で他界し、被害者側への賠償で安い借家へ引っ越したことが、彼女をいっそう暗い性格にさせた。"},{"spoiler":false,"text":"自虐的であり、人と関わるのを避けようとするが、無神経なことを平気で口にしてしまう危うさを持つ。"},{"spoiler":false,"text":"明るく、誰にでも好かれるあかねに密かな嫉妬心がある。"}],"source":"egs","sourceCharacterId":"8777","sourceWorkId":"6467","spoiler":false},{"segments":[{"spoiler":false,"text":"おとなしく、どちらかといえば根暗な女の子。"},{"spoiler":false,"text":"運動苦手。勉強は全般的に好きではないが、極端な劣等生というわけではない。"},{"spoiler":false,"text":"見た目と裏腹に、ヘヴィメタル、特に激しくも欝なゴシックメタル系をよく聴いている。"}],"source":"bangumi","sourceCharacterId":"40334"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d12bae73005c08221515109eba25a38db3b2c577d74e47ccc38c1b8b366