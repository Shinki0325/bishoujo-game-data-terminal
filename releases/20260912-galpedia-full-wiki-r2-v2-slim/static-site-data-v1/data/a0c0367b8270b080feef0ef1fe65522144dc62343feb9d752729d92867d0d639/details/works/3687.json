:"94843","match":"exact-normalized-name-in-linked-work","subjectId":"114016"},{"characterId":"94843","match":"exact-normalized-name-in-linked-work","subjectId":"148412"},{"characterId":"94843","match":"exact-normalized-name-in-linked-work","subjectId":"148414"}],"egsCharacterIds":["13873"],"vndbCharacterId":"c27257"},"originalCharacterName":"成羽 菫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"薊学園三年生で、主人公達の先輩。"},{"spoiler":false,"text":"綺麗だけど、妙な噂が絶えない人。"},{"spoiler":false,"text":"妙な噂とは、部の女子全員を喰ったとかっていうレズな噂を聞いたかと思えば、"},{"spoiler":false,"text":"後輩の男子を摘んでいる等々。"},{"spoiler":false,"text":"そんな艶聞の噂を断固として否定しない意志の強い人物。"},{"spoiler":false,"text":"アロマストラップなる『香油入れ』を常に持ち歩いている。"},{"spoiler":false,"text":"（中身は人を貶めるための睡眠薬だとか媚薬だという噂）"},{"spoiler":false,"text":"登場する女性キャラのなかで、一番大人のキャラ。"},{"spoiler":false,"text":"とかく性に対しては子供のように無邪気という困った人。"},{"spoiler":false,"text":"普段のおっとりした感じからは想像も出来ない"},{"spoiler":false,"text":"ラリー・キングも びっくり官能ハードトークには定評がある。"},{"spoiler":false,"text":"主人公の事を密かに（本人はそう思って）狙っている。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"3181","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園三年生。"},{"spoiler":false,"text":"アンニュイな感じの美少女。"},{"spoiler":false,"text":"しかし、水泳部の女子たちとレズ関係にあるとか、後輩の男子を摘み食いしているとか、妙な噂が絶えない。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"3687","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園三年生。心療クラブ代表。"},{"spoiler":false,"text":"学生らしからぬセクシーさとフェロモンを振りまく女性。"},{"spoiler":false,"text":"セックスについても奔放で、気に入れば男、女関係なく、誰とでも寝る。"},{"spoiler":false,"text":"男を手玉にとって、相手の恥ずかしがる姿を見ることに興奮を覚える。"},{"spoiler":false,"text":"うぶな一年生はクラブの新入生の女の子たちを摘み食いしている彼女は、英田柾や神目楓も狙っているらしいが……。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"6136","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園一年生。"},{"spoiler":false,"text":"家は資産家、門限は夕方という生粋のお嬢様。"},{"spoiler":false,"text":"世間知らずを認めており、親離れをするため、一人暮らしをはじめ薊学園に通っている。"},{"spoiler":false,"text":"早島つばきとは幼馴染みで親友。"},{"spoiler":false,"text":"趣味はアロマセラピー。"},{"spoiler":false,"text":"つばきの側にいる男子が気になるが、友情を気にして言い出せずにいる。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"13025","spoiler":false},{"segments":[{"spoiler":false,"text":"私立薊学園3年。セクシーな外見とエロい心を持つ。"},{"spoiler":false,"text":"決め台詞は「お姉さん変態だから」。"},{"spoiler":false,"text":"男を手玉に取り、相手が恥ずかしがるのが何より興奮するという特殊な性癖。"},{"spoiler":false,"text":"心療クラブという怪しげなサークルの権力者。"}],"source":"bangumi","sourceCharacterId":"94843"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/535e2c2accc1304399288de114e578633ce34c450598605088ef761735bba10e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e11e8e324636095c4a7740e75e87e522f877710add7e2a540ee1612854b7f66c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:148412:94843:15954:1","source":"bangumi"}]},{"characterId":"char_c8279","characterName":"美甘 櫻","sourceIds":{"bangumi":[{"characterId":"94844","match":"exact-normalized-name-in-linked-work","subjectId":"213278"}],"egsCharacterIds":["22727"],"vndbCharacterId":"c8279"},"originalCharacterName":"美甘 櫻","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく前向きな水泳部女子。"},{"spoiler":false,"text":"外見はボーイッシュな女の子だけど、中身はしっかり女の子している。"},{"spoiler":false,"text":"がんばり屋さんな性格もあって、水泳はなかなかの実力。"},{"spoiler":false,"text":"でも本番ではいつも巧く行かず、プレッシャーに弱い一面も。妄想癖アリ。"},{"spoiler":false,"text":"憧れの先輩とのファンタスティックドラマを 年がら年中、高速再生中。"},{"spoiler":false,"text":"物事をいい方に捕らえようとして失敗するタイプ。"},{"spoiler":false,"text":"そのせいで空回りすることもあるけど、それでも前向きに頑張る女の子。"},{"spoiler":false,"text":"水泳部だけあって引き締まった体に、 ばいーんとアンバランスな大きな胸。"},{"spoiler":false,"text":"膨らみっぱなしの胸に、密かに危機感を抱いていたりする。"},{"spoiler":false,"text":"自分以外の評価は非常に高いが、本人は気付かない。"}],"source":"egs","sourceCharacterId":"22727","sourceWorkId":"3181","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園の体育教師兼水泳部顧問。"},{"spoiler":false,"text":"三十路ながらも、童顔で年齢よりも若く見える。"},{"spoiler":false,"text":"そのため親しみやすいのか、、生徒たちからも友達感覚で話しかけられる。"},{"spoiler":false,"text":"見事な巨乳が彼女のトレードマーク（？）。"}],"source":"egs","sourceCharacterId":"22727","sourceWorkId":"3687","spoiler":false},{"segments":[{"spoiler":false,"text":"私立坂ノ下学園教師"},{"spoiler":false,"text":"水泳部顧問"},{"spoiler":false,"text":"担当教科：英語"},{"spoiler":false,"text":"教師歴5年"},{"spoiler":false,"text":"明るく頼りになる。"},{"spoiler":false,"text":"異性からはもちろん、同性からも人気の高い教師の見本のような人。"},{"spoiler":false,"text":"稲穂や沙月も、櫻にあこがれて教師を目指している。"},{"spoiler":false,"text":"以前よりも、お姉さん的色気を兼ね備えた。"}],"source":"egs","sourceCharacterId":"22727","sourceWorkId":"7395","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく前向きな女の子。夢見る少女ちゃんっぽい雰囲気がある。"},{"spoiler":false,"text":"つまり、まだまだ思考は中学生あがりのお子ちゃま。"},{"spoiler":false,"text":"しかし膨らみっぱなしの胸に密かに危機感を覚えている。"}],"source":"bangumi","sourceCharacterId":"94844"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68326b18b0affef62c25eee4c51ac0a065824af3c833657223d4ba402f8e8ac1.webp","fallbackUrl":"