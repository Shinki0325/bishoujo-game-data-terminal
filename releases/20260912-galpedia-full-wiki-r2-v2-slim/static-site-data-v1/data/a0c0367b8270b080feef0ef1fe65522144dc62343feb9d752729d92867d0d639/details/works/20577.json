{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20577","model":{"presentationWorkId":"vndb:v17146","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c63084","characterName":"篠原 貴美","sourceIds":{"bangumi":[{"characterId":"30981","match":"exact-normalized-name-in-linked-work","subjectId":"128057"},{"characterId":"30981","match":"exact-normalized-name-in-linked-work","subjectId":"222173"},{"characterId":"30981","match":"exact-normalized-name-in-linked-work","subjectId":"222174"}],"egsCharacterIds":["19283"],"vndbCharacterId":"c63084"},"originalCharacterName":"篠原 貴美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本性が荒く短気で乱暴なフリをしているが、本当は義父に怯え臆病者。"},{"spoiler":false,"text":"義父の金を稼ぐ為に男を取らされている。"},{"spoiler":false,"text":"（フェラのみで本番はまだ）"},{"spoiler":false,"text":"――拘束欲情"},{"spoiler":false,"text":"自分では否定しているが、拘束されるのが好き。"},{"spoiler":false,"text":"縄などで縛られると否応なしに感じてしまう。"}],"source":"egs","sourceCharacterId":"19283","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"『拘束願望』のヒロイン。"},{"spoiler":false,"text":"クールな印象を与える少女だが、その実、かなりの小心者。"},{"spoiler":false,"text":"養父に客を取らされ、売春まがいの行為を強いられている。"},{"spoiler":false,"text":"客の一人に縄で縛られたことをきっかけに、拘束される快感に目覚める。"}],"source":"egs","sourceCharacterId":"19283","sourceWorkId":"9801","spoiler":false},{"segments":[{"spoiler":false,"text":"【学生/ヒロイン】"},{"spoiler":false,"text":"いつも不機嫌で周囲に対しても威圧的な態度を取っている。"},{"spoiler":false,"text":"不良グループたちと一緒にいるため、一般の学生からは"},{"spoiler":false,"text":"煙たがられ距離を置かれている。"},{"spoiler":false,"text":"しかし実は、嫌いな父親へ反抗するために、不良の様に"},{"spoiler":false,"text":"振る舞っているだけで、根っからの不良というわけではない。"},{"spoiler":false,"text":"主人公とはお笹馴染みで、昔は一緒によく遊んでいたが"},{"spoiler":false,"text":"そのせいで今はすっかり疎遠になっている。"},{"spoiler":false,"text":"本心では、主人公と昔の様な関係に戻りたいと思っている。"}],"source":"egs","sourceCharacterId":"19283","sourceWorkId":"20577","spoiler":false},{"segments":[{"spoiler":false,"text":"気性が荒く、乱暴な学生。短気でケンカっぱやく振る舞うが、実際は酒乱の義父に怯える臆病もの。"},{"spoiler":false,"text":"ケンカの経験はほとんどなく、傷も義父に殴られたもの。思い詰め、父親を殺そうとクスリを用意している。ただし、まだ実行には踏み切れていない。"},{"spoiler":false,"text":"義父の命令で男を取らされている（口奉仕どまり）。実は拘束好き。"}],"source":"bangumi","sourceCharacterId":"30981"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d040d3ea5d82d4a68db34165b78ca8b33a33be9726320eee155b9ce2d5d2b324.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc1861bd01edc4fb9a4edaa80375c15479f8e48dad92690d05454864ae2b2cb1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63835","source":"vndb"}]},{"characterId":"char_vndb_c111816","characterName":"大杉 和也","sourceIds":{"vndbCharacterId":"c111816"},"originalCharacterName":"大杉 和也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:4251","sourceCompanyId":"egs:brand:4251","canonicalEntityId":"egs:brand:4251","name":"roroE","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:20577:4251","source":"egs"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:45508:v17146","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
