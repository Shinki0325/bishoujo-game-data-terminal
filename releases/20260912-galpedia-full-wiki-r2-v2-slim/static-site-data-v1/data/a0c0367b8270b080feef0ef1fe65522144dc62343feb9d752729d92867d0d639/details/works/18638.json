egs","sourceCharacterId":"989","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーをサポートし続ける忠実な副官。"},{"spoiler":false,"text":"冷静、沈着にして有能、家事一般にも秀でる。"},{"spoiler":false,"text":"相変わらずメッツァーに対して一途な気持ちを持ち続けている。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツアーの右腕にして愛らしい性奴隷。"},{"spoiler":false,"text":"メッツアーの初めての獲物でもある。"},{"spoiler":false,"text":"冷静で良く気が利き、全てをメッツァーに捧げる最高の副官。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァー・ハインケルの副官。"},{"spoiler":false,"text":"もともとは女神近衛団第二騎士団アップルナイツの副団長を務める魔法戦士であったが、メッツァーに捕獲された際に調教を受け、彼に忠実な下僕となり果てた。"},{"spoiler":false,"text":"メッツァーのことを心から愛しており、メッツァーもまた、ココノに対し副官以上の感情を抱いている。"},{"spoiler":false,"text":"メッツァーが封印された後、潜伏しながら封印を無効化する方法を探し続けていた。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に忠実で、よく気のつく優秀な副官。 もとはスイートナイツと同じく正義を守る戦士だ ったが、主人公に捕らえられ、調教されて、彼の 従順な奴隷となった。"},{"spoiler":false,"text":"冷静な反面、一途で甲斐甲斐しい一面を持つ。"}],"source":"bangumi","sourceCharacterId":"96134"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e9404b24147e340d10c3aa39f48b8548dda57054ea61d61351247374858bc75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9ce0793bc2c5a49fba998b91f67873e5fb419327e1eb375fe3c9c16264b8cba8.webp","width":154,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c51666","characterName":"スイートパッション","sourceIds":{"bangumi":[{"characterId":"96138","match":"exact-normalized-name-in-linked-work","subjectId":"200512"}],"egsCharacterIds":["986"],"vndbCharacterId":"c51666"},"originalCharacterName":"スイートパッション","characterNameSource":null,"role":"1","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewS