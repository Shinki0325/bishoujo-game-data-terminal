"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ひかり・めいかの従姉で現在は、星湘町の観光課に勤務する女の子。（予算の関係で）町の観光大使も兼任している。真面目で頑張り屋だが要領が悪く、また頼まれると断れない性格のせいで、昔からババを引くことが多かった。"},{"spoiler":false,"text":"自分の誤発注が発端となって、みんなに多大な迷惑を掛けたことを申し訳なく思いつつ、内心ひかりと一緒に夏のイベントを盛り上げることを楽しみにしている。どうにかして、ここで一発しっかりもののお姉ちゃんの威厳を見せつけようと思ってはいるようだが……多分、無理だろう。"}],"source":"egs","sourceCharacterId":"19959","sourceWorkId":"26819","spoiler":false},{"segments":[{"spoiler":false,"text":"原画：ベコ太郎"},{"spoiler":false,"text":"ひかり・めいかの従姉で現在は、星湘町の観光課に勤務する女の子。"},{"spoiler":false,"text":"（予算の関係で）町の観光大使も兼任している。"},{"spoiler":false,"text":"真面目で頑張り屋だが要領が悪く、また頼まれると断れない性格のせいで、昔からババを引くことが多かった。"},{"spoiler":false,"text":"自分の誤発注が発端となって、みんなに多大な迷惑を掛けたことを申し訳なく思いつつ、内心ひかりと一緒に夏のイベントを盛り上げることを楽しみにしている。"},{"spoiler":false,"text":"どうにかして、ここで一発しっかりもののお姉ちゃんの威厳を見せつけようと思ってはいるようだが……多分、無理だろう。"},{"spoiler":false,"text":"「くすくす……ひーちゃんその姿とっても似合ってるわよ」"}],"source":"bangumi","sourceCharacterId":"64775"}],"profileFacts":[{"label":"喜欢的东西","source":"bangumi","sourceCharacterId":"64775","value":"おもち、星湘町の人たち"},{"label":"特技","source":"bangumi","sourceCharacterId":"64775","value":"味見"},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"19959","sourceWorkId":"26819","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"19959","sourceWorkId":"26819","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"19959","sourceWorkId":"26819","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"19959","sourceWorkId":"26819","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9a11050a9f9c9e98ca7ce8f713e7d89caf313a8d17eb3d4b8323b55cf47768c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v