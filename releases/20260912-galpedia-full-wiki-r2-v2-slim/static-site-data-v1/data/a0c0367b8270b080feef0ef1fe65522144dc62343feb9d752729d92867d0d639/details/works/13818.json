c","roleLabel":"作品音乐","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:86152","source":"egs"},{"creditedName":"溝口哲也","creatorId":"vndb:s628","sourcePersonId":"egs:creator:3375","canonicalEntityId":"vndb:s628","name":"溝口哲也","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:86196","source":"egs"},{"creditedName":"六弦 A助","creatorId":"vndb:s1722","sourcePersonId":"vndb:s1722","canonicalEntityId":"vndb:s1722","name":"六弦 A助","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:46121","source":"vndb"}],"other":[{"creditedName":"舞子","creatorId":"vndb:s5406","sourcePersonId":"egs:creator:16975","canonicalEntityId":"vndb:s5406","name":"舞子","detail":"主題歌「背徳エレジー」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:105814","source":"egs"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46110","source":"vndb"},{"creditedName":"そのだ まさき","creatorId":"vndb:s596","sourcePersonId":"vndb:s596","canonicalEntityId":"vndb:s596","name":"そのだ まさき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46112","source":"vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46116","source":"vndb"},{"creditedName":"笹山 逸刀斎","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:46118","source":"vndb"},{"creditedName":"笹山 逸刀斎","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46119","source":"vndb"},{"creditedName":"舞子","creatorId":"vndb:s5406","sourcePersonId":"vndb:s5406","canonicalEntityId":"vndb:s5406","name":"舞子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:46122","source":"vndb"}]},"cast":[{"characterId":"char_c12030","characterName":"ミチコ=フルーレティ","sourceIds":{"bangumi":[{"characterId":"33662","match":"exact-normalized-name-in-linked-work","subjectId":"303918"},{"characterId":"33662","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12389"],"vndbCharacterId":"c12030"},"originalCharacterName":"ミチコ=フルーレティ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A demon who made a contract with Annerose. In layman's terms, she is a being from another dimension."},{"spoiler":false,"text":"Normally, she is a beautiful and bewitching maid, but when Annerose goes out, she transforms into a sloth."},{"spoiler":false,"text":"Her real name is Fleuretty, but Annerose finds it difficult to call her, so she is called \"Michiko\". She also likes it and calls herself Michiko."},{"spoiler":false,"text":"She loves Annerose in a lesbian way and thinks that a man is not suitable for Annerose at all."},{"spoiler":false,"text":"As a newcomer and a man, the main character is nothing but an obstacle to her, so she plays tricks (that would kill a normal person) on him at every opportunity."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c12030"},{"segments":[{"spoiler":false,"text":"アンネローゼと契約した悪魔。"},{"spoiler":false,"text":"平たくいうと異次元の存在。"},{"spoiler":false,"text":"普段は妖しい美少女メイドの姿でアンネローゼがお出かけの際にはトランクに化ける。"},{"spoiler":false,"text":"本名をフルーレティというがアンネローゼに呼びにくいという事でミチコと呼ばれるようになった。"},{"spoiler":false,"text":"本人も気に入っていてミチコと名乗っている。"},{"spoiler":false,"text":"悪魔変化、性悪女中、鉄斧乱舞、偏愛乙女。"},{"spoiler":false,"text":"アンネローゼをレズ的に愛していて、アンネローゼに男は全く相応しくないと思っている。"},{"spoiler":false,"text":"新参者で、しかも男である主人公は邪魔者でしかないので、ことあるごとに悪戯（普通人なら死ぬような）を仕掛けてくる。"},{"spoiler":false,"text":"「クヒヒ！　神経ガス入りクッキーの完成♪　あの馬鹿人間め、見ていろよ」"}],"source":"egs","sourceCharacterId":"12389","sourceWorkId":"13818","spoiler":false},{"segments":[{"spoiler":false,"text":"【鋼鉄の魔女アンネローゼ the-Anime】"},{"spoiler":false,"text":"アンネローゼと契約した悪魔。"},{"spoiler":false,"text":"平たくいうと異次元の存在。"},{"spoiler":false,"text":"普段は妖しい美少女メイドの姿でアンネローゼがお出かけの際にはトランクに化ける。"},{"spoiler":false,"text":"本名をフルーレティというがアンネローゼに呼びにくいという事でミチコと呼ばれるようになった。"},{"spoiler":false,"text":"本人も気に入っていてミチコと名乗っている。"},{"spoiler":false,"text":"悪魔変化、性悪女中、鉄斧乱舞、偏愛乙女。"},{"spoiler":false,"text":"アンネローゼをレズ的に愛していて、アンネローゼに男は全く相応しくないと思っている。"},{"spoiler":false,"text":"新参者で、しかも男である主人公は邪魔者でしかないので、"},{"spoiler":false,"text":"ことあるごとに悪戯（普通人なら死ぬような）を仕掛けてくる。"}],"source":"egs","sourceCharacterId":"12389","sourceWorkId":"15039","spoiler":false},{"segments":[{"spoiler":false,"text":"CV - 姫川あいり"},{"spoiler":false,"text":"アンネローゼと契約した女悪魔。 普段はメイドの姿をしており、アンネローゼに同行する際はトランクの姿をしている。"},{"spoiler":false,"text":"アンネローゼに対して同性愛的な愛情を持っているため、陸郎のことをよく思っておらず、嫌がらせをすることもある。"}],"source":"bangumi","sourceCharacterId":"33662"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc9ce4a00b9bf5971829311fd89fdaacddb7e01d15330b15e4150c3f2eba3b03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c2a3f6003f82da51514bfb3c7e647a23db3730ea277490ff9246423713ea800.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井清己","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"浅井 清己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89164:33662:4336:1","source":"bangumi"}]},{"characterId":"char_c12031","characterName":"李 美鳳","sourceIds":{"bangumi":[{"characterId":"33664","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12390"],"vndbCharacterId":"c12031"},"originalCharacterName":"李 美鳳","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a witch and a skilled assassin."},{"spoiler":false,"text":"Due to the \"werewolf\" scandal, she was hired by the Chinese mafia \"Kowloon Kai,\" one of the three major organizations in Amidahara."},{"spoiler":false,"text":"Unlike Annerose, she used to be a human, but when she killed a witch in the course of his assassination work, a \"tattoo,\" which was the source of the witch's power, was implanted in her back, giving her the witch's power."},{"spoiler":false,"text":"The witch's power is the ability to refine poison, and she has a white energy-like snake inside her body, which can refine poison at will and add it to her weapons."},{"spoiler":false,"text":"Her street name is \"White Snake\"."},{"spoiler":false,"text":"She has had trouble with Annerose in the past and they have been bitter enemies."},{"spoiler":false,"text":"She is always trying to bring down Annerose. She wants to see her die not in death, but in a sexually tragic way."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c12031"},{"segments":[{"spoiler":false,"text":"魔女にして凄腕の暗殺者。"},{"spoiler":false,"text":"“人狼”騒ぎによって、アミダハラを三分する組織の一つ、中華系マフィア「九龍会」の下部組織に雇われる。"},{"spoiler":false,"text":"アンネローゼとは違い元は人間であったが、暗殺の仕事の中で魔女を仕留めた折、"},{"spoiler":false,"text":"魔女の魔力の源であった“刺青”を自らの背中に移植して魔女の力を得る。"},{"spoiler":false,"text":"悪辣毒婦、漱石枕流、縄標飛来、白蛇魔女。"},{"spoiler":false,"text":"魔女の力は毒を精製する能力で、彼女は体内に白いエネルギー体のような蛇を飼っていて、"},{"spoiler":false,"text":"白い蛇は自在に毒を精製して彼女の武器に毒を付加してくれる。"},{"spoiler":false,"text":"通り名は「白蛇（ヨミ：シロヘビ）」。"},{"spoiler":false,"text":"過去の仕事でアンネローゼとトラブルがあり犬猿の仲。"},{"spoiler":false,"text":"事あるごとにアンネローゼの失脚を狙っている。死ではなく性的に悲惨な最期を。"},{"spoiler":false,"text":"「あら、アンネローゼのところの坊やね。いいところで会ったわ」"}],"source":"egs","sourceCharacterId":"12390","sourceWorkId":"13818","spoiler":false},{"segments":[{"spoiler":false,"text":"魔女にして凄腕の暗殺者。元々は人間だったが、ある魔女を暗殺してその刺青を自らの背中に移す形でその魔力を得て、魔女となった。"},{"spoiler":false,"text":"アンネローゼとの仲は悪く、彼女に屈辱を味わわせようと狙っている。"}],"source":"bangumi","sourceCharacterId":"33664"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a03210e2cb900714921cd263271fa8711c7df9d95aebd467f39ae6720d19aa93.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39a9891e896573b5529280baea0a062b63be4734ea3c6a0d0bae5c0d7865a8f4.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89164:33664:19333:1","source":"bangumi"}]},{"characterId":"char_c12032","characterName":"アイシュワリヤ・レイ","sourceIds":{"bangumi":[{"characterId":"33663","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12391"],"vndbCharacterId":"c12032"},"originalCharacterName":"アイシュワリヤ・レイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a brown demoness from the demon world. She is said to be the best fortune teller in Amidahara. Also known as Aish."},{"spoiler":false,"text":"She controls a group of ruins called \"Red Sky Tower,\" part of the Amidahara Ruins area, and runs gambling matches and a brothel."},{"spoiler":false,"text":"The operation is more of a hedonistic hobby than a means to make money, and as an independent force in Amidahara, she maintains a stance of non-aggression and non-interference with the organizations that rule Amidahara."},{"spoiler":false,"text":"Her nickname is \"Crimson Queen\" or \"Red Queen\"."},{"spoiler":false,"text":"She is a close friend of Annerose, but at the same time, she is a pervert who loves to torment her."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c12032"},{"segments":[{"spoiler":false,"text":"魔界出身の褐色妖女。"},{"spoiler":false,"text":"アミダハラ一と言われる占い師。通称アイシュ。"},{"spoiler":false,"text":"妖貴婦人、天衣無縫、悪質趣味、褐色妖女。"},{"spoiler":false,"text":"アミダハラの廃墟地域の一部「紅天楼」と呼ばれる廃墟群を支配して、賭け試合や娼館などを運営している。"},{"spoiler":false,"text":"金を儲けるというよりは快楽主義的な彼女の趣味の城であり、アミダハラの一独立勢力としてアミダハラを支配する組織からは互いに不可侵、"},{"spoiler":false,"text":"干渉せずというスタンスで存在している。"},{"spoiler":false,"text":"二つ名は「女王」「紅女王」。"},{"spoiler":false,"text":"アンネローゼの親友であるが、同時に彼女を苛めるのが大好きという変態趣味の持ち主。"},{"spoiler":false,"text":"「ねえ、君はアンネのとこに来てどのくらい？」"}],"source":"egs","sourceCharacterId":"12391","sourceWorkId":"13818","spoiler":false},{"segments":[{"spoiler":false,"text":"褐色の肌をもつ、魔界出身の妖女。表向きは凄腕の占い師だが、アミダハラの一地域「紅天楼」を支配し、アミダハラ全体を支配する組織とは相互不可侵条約を結んでいる。"},{"spoiler":false,"text":"アンネローゼとの仲は良好だが、彼女に対してサディスティックな感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"33663"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/709aaedc823ebd7d28c291cc22abd0dfa02eaf5cc2d93439bd9a7245b639f7af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc67f8fc02c9a5d48cfb19649aa17d9bd4d9fb8d56cad0b9c0cde7e4e88c24aa.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89164:33663:5669:1","source":"bangumi"}]},{"characterId":"char_c29885","characterName":"音無 美樹","sourceIds":{"bangumi":[{"characterId":"33665","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12392"],"vndbCharacterId":"c29885"},"originalCharacterName":"音無 美樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She came to Amidahara in search of her missing brother. She is an active girl who acts before thinking."},{"spoiler":false,"text":"She likes to talk and eat sweets. She is good at sports and not good at studying. She is longing for love."},{"spoiler":false,"text":"At first glance, she seems to be an ordinary high school girl, but she has a strong resistance to magic power, which is hard to believe for someone from outside Amidahara."},{"spoiler":false,"text":"When she sneaks into Amidahara, she is armed with a submachine gun purchased from a local yakuza."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c29885"},{"segments":[{"spoiler":false,"text":"行方不明の兄を捜しに、アミダハラにやってきた。"},{"spoiler":false,"text":"考えるより先に行動するタイプの活発な少女。"},{"spoiler":false,"text":"おしゃべりと甘い物が好き、スポーツが得意で勉強は苦手、恋愛に憧れている。"},{"spoiler":false,"text":"天真爛漫、体育会系、攻撃暴発、依頼少女。"},{"spoiler":false,"text":"一見、ごく普通の女子高生のようだが、アミダハラの外から来た人間とは思えないほど、魔力に対して強い耐性がある。"},{"spoiler":false,"text":"アミダハラに潜入する際に地元のヤクザから購入したサブマシンガンで武装している。"},{"spoiler":false,"text":"「こんな危険な町に一人でやってくるなんて無茶だってわかってる。"},{"spoiler":false,"text":"でも、今探さないと……お兄ちゃん、一生見つけられない気がして」"}],"source":"egs","sourceCharacterId":"12392","sourceWorkId":"13818","spoiler":false},{"segments":[{"spoiler":false,"text":"兄を探しにアミダハラを訪れた少女。明るい体育会系の少女で、魔力にも強い。"}],"source":"bangumi","sourceCharacterId":"33665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90665ee346d04ba83904a228f94ee19fc1fdb63cdcd3772531bb26e3889c4f4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f5c704d94a19de971dae3914d28d4d9afe8a3cf93158774a023831d7fb2d7ea.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89164:33665:5922:1","source":"bangumi"}]},{"characterId":"char_c34262","characterName":"人狼","sourceIds":{"bangumi":[],"egsCharacterIds":["12395"],"vndbCharacterId":"c34262"},"originalCharacterName":"人狼","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A monster who repeatedly commits disorderly murders in Amidahara."},{"spoiler":false,"text":"He is rumored to be a werewolf monster from the demon world or a demon from another world."},{"spoiler":false,"text":"The organizations that control Amidahara are in pursuit of him, but his true identity is completely unknown."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34262"},{"segments":[{"spoiler":false,"text":"身長200cm"},{"spoiler":false,"text":"アミダハラで無秩序な殺人を繰り返している怪人。"},{"spoiler":false,"text":"魔界から流れてきて人狼族の化け物とも異界の悪魔とも噂される殺人鬼。"},{"spoiler":false,"text":"正体不明、悪鬼羅刹、跳梁跋扈、人狼魔人。"},{"spoiler":false,"text":"アミダハラを支配する各組織が追っているが正体は一切不明"}],"source":"egs","sourceCharacterId":"12395","sourceWorkId":"13818","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"200 cm","valueContext":null,"source":"egs","sourceCharacterId":"12395","sourceWorkId":"13818","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e038db7e39d87a3ac8e54deaf9f195046debc14d77a7b6f565b94288fac5162.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be00617edc71d98d5a10b6bed003baccf5aa9b391d78a53bc519d044280cf8f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c34263","characterName":"三船 阿修羅","sourceIds":{"bangumi":[{"characterId":"94248","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12394"],"vndbCharacterId":"c34263"},"originalCharacterName":"三船 阿修羅","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a skilled swordsman who continues his journey of training. He is silent, arrogant, ruthless, and a demon of the art of war."},{"spoiler":false,"text":"He believes that the only thing he can rely on in the world is his own skill."},{"spoiler":false,"text":"He is a man who has no sense of right or wrong, and is obsessed with nothing but his own self-possession."},{"spoiler":false,"text":"He has lost his left eye and wears an eye patch. Therefore, attacks from his right eye appear to be effective, but on the contrary, he claims to have \"gained a mind's eye in his left eye\" (according to him) in place of his lost sight, and is able to recognize everything even in the dark."},{"spoiler":false,"text":"The werewolf fiasco has led him to become a prey of the \"Jinbu-gumi,\" a Japanese yakuza clan that is one of the three main gangs in the Amidahara area."},{"spoiler":false,"text":"He is a perfect human being and possesses terrifying power, even though he has not acquired any deformed or magical powers. He is a superhuman being."},{"spoiler":false,"text":"He is said to have traveled alone to the demon world and other dimensions inhabited by demons, and there are rumors that he is over 300 years old."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34263"},{"segments":[{"spoiler":false,"text":"修業の旅を続ける凄腕の剣客。"},{"spoiler":false,"text":"無口、傲慢、冷酷、兵法の鬼。"},{"spoiler":false,"text":"唯我独尊、唯一無二、勇往邁進、剣客鬼人。"},{"spoiler":false,"text":"自分自身を、非人間的な戒律で縛っているためストイックである。"},{"spoiler":false,"text":"世の中で頼りになるのは自分の腕だけだと思っている。"},{"spoiler":false,"text":"正も邪もなく、己をたたき上げる、ただそれだけに凝り固まった男。"},{"spoiler":false,"text":"左目は失われれおり眼帯。"},{"spoiler":false,"text":"従って右からの攻撃が有効に見えて、その逆、彼は失った視力の代わりに「左目に心眼を得た」（本人談）としており、"},{"spoiler":false,"text":"暗闇でもあらゆるものを認知できるという。"},{"spoiler":false,"text":"人狼騒ぎがキッカケとなってアミダハラを三分する暴力組織の一つ、日本系ヤクザ連合「神武組」の食客となっている。"},{"spoiler":false,"text":"完全なる人間で異形の力や魔力を一切得ていないが恐ろしい力を有する。超人間的存在。"},{"spoiler":false,"text":"ひとり魔界や悪魔たちが住まう異次元を旅したとされ、齢300歳を越しているという噂も。"},{"spoiler":false,"text":"「修羅が舞っておるぞ魔女よ。我れと同じ臭いがするのぉ」"}],"source":"egs","sourceCharacterId":"12394","sourceWorkId":"13818","spoiler":false},{"segments":[{"spoiler":false,"text":"修業の旅を続ける凄腕の剣客。無口、傲慢、冷酷、兵法の鬼。"},{"spoiler":false,"text":"世の中で頼りになるのは自分の腕だけだと思っている。"},{"spoiler":false,"text":"正も邪もなく、己をたたき上げる、ただそれだけに凝り固まった男。"},{"spoiler":false,"text":"左目は失われれおり眼帯。従って右からの攻撃が有効に見えて、その逆、彼は失った視力の代わりに 「左目に心眼を得た」（本人談） としており、暗闇でもあらゆるものを認知できるという。"},{"spoiler":false,"text":"人狼騒ぎがキッカケとなってアミダハラを三分する暴力組織の一つ・日本系ヤクザ連合 「神武組」 の食客となっている。"},{"spoiler":false,"text":"完全なる人間で異形の力や魔力を一切得ていないが恐ろしい力を有する。超人間的存在。"},{"spoiler":false,"text":"ひとり魔界や悪魔たちが住まう異次元を旅したとされ、齢300歳を越しているという噂も。"}],"source":"bangumi","sourceCharacterId":"94248"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a7541bbc51040fc65919a909268f73add0288dd1c2e30a3906c4848ae118f70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/218833531f5a5ac4d01aaa14f84e8e67a52a6d78b18fd77a4586f1df84402872.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c34264","characterName":"山田 太郎","sourceIds":{"bangumi":[{"characterId":"94249","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12393"],"vndbCharacterId":"c34264"},"originalCharacterName":"山田 太郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man who approaches Annerose and her friends, who may be friend or foe."},{"spoiler":false,"text":"He uses appropriate pseudonyms such as John Smith or Alan Smithee, depending on his mood at the time."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34264"},{"segments":[{"spoiler":false,"text":"アンネローゼたちに近づいてくる、敵とも味方とも知れない男。"},{"spoiler":false,"text":"不実虚構、不羈自由、企業奴隷、適当優男。"},{"spoiler":false,"text":"その時の気分でジョン・スミスやアラン・スミシーといった適当な偽名を使う。"}],"source":"egs","sourceCharacterId":"12393","sourceWorkId":"13818","spoiler":false},{"segments":[{"spoiler":false,"text":"アンネローゼたちに近づいてくる、敵とも味方とも知れない男。"},{"spoiler":false,"text":"その時の気分でジョン・スミスやアラン・スミシーといった適当な偽名を使う。"}],"source":"bangumi","sourceCharacterId":"94249"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acd92b3678307a12a863ac9ecbba4bf0c3bbb8733969c1dc4c4702f4ecb97677.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a25c303a4ce5bea6674600f89e38c735c2782b99fcb18244c687743647583002.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c34290","characterName":"バルド・バルド","sourceIds":{"bangumi":[{"characterId":"94250","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12396"],"vndbCharacterId":"c34290"},"originalCharacterName":"バルド・バルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a magician living in Amidahara."},{"spoiler":false,"text":"He used to be an elite officer of a secret research institute of the German military, which was enthusiastic about research on the magical world, and was in charge of magical research."},{"spoiler":false,"text":"He is said to be the third most powerful magician in Amidahara, and his abilities are well documented."},{"spoiler":false,"text":"His nickname is \"Baron\"."},{"spoiler":false,"text":"As the owner of the abandoned district called Nakanoshima, he is an eccentric who lives in a tall building that has been remodeled to look like a tower."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34290"},{"segments":[{"spoiler":false,"text":"アミダハラに住まう魔術師。"},{"spoiler":false,"text":"かつては魔界研究に熱心だったドイツ軍のある秘密研究機関のエリート将校として、魔術研究を担当していたという。"},{"spoiler":false,"text":"悪逆非道、鬼哭啾啾、魔獣自在、魔道狂人。"},{"spoiler":false,"text":"アミダハラ第三の魔術師と言われる男で、その実力は折紙付。"},{"spoiler":false,"text":"二つ名は、男爵。"},{"spoiler":false,"text":"ナカノシマと呼ばれる廃墟地区の主として一際高いビルを塔の様に改造して住まう奇人。"}],"source":"egs","sourceCharacterId":"12396","sourceWorkId":"13818","spoiler":false},{"segments":[{"spoiler":false,"text":"アミダハラに住まう魔術師。"},{"spoiler":false,"text":"かつては魔界研究に熱心だったドイツ軍の、ある秘密研究機関のエリート将校として魔術研究を担当していたという。"},{"spoiler":false,"text":"アミダハラ第三の魔術師と言われる男で、その実力は折紙付。"},{"spoiler":false,"text":"二つ名は 「男爵」。"},{"spoiler":false,"text":"ナカノシマと呼ばれる廃墟地区の主として、一際高いビルを塔のように改造して住まう奇人。"}],"source":"bangumi","sourceCharacterId":"94250"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1caf769f65d1aff6de57a884494c88b3901f71a7a0391d225eade32874082b2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46ad84e46fefc083a65a8f7a5704114b7dedb88993f1714491d9d6165a1c368a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c34292","characterName":"ノイ・イーズレーン","sourceIds":{"bangumi":[{"characterId":"94251","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12397"],"vndbCharacterId":"c34292"},"originalCharacterName":"ノイ・イーズレーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is recognized by all as the best magician in Amidahara, and is said to have lived for hundreds of years."},{"spoiler":false,"text":"She is from the magical world, but his race is unknown."},{"spoiler":false,"text":"She is one of the most important members of the Amidahara Magicians' Guild, which controls the darkness in Amidahara, and never makes enemies with any villain."},{"spoiler":false,"text":"She is also known as \"Auntie\"."},{"spoiler":false,"text":"She runs a small souvenir shop for tourists called \"Magical Hall,\" where she always sits at the counter like an ornament."},{"spoiler":false,"text":"Annerose calls her \"grandma\" and adores her, but she always treats her like a child and is basically unappreciative."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34292"},{"segments":[{"spoiler":false,"text":"誰もが認めるアミダハラ随一の魔術師で、数百年の時を生き続けているいう。"},{"spoiler":false,"text":"魔界出身であるがその種族は不明。"},{"spoiler":false,"text":"アミダハラの闇を司る魔術師組合の重鎮中の重鎮で、どんな悪党も決して敵に回そうとはしない。"},{"spoiler":false,"text":"老齢達観、天寿達成、海千山千、最強老婆。"},{"spoiler":false,"text":"通称は、おばばさま。"},{"spoiler":false,"text":"観光客相手の小さな土産屋「魔法堂」を営んでいて、いつ行ってもカウンターにちょこんと置物のように座っている。"},{"spoiler":false,"text":"アンネローゼは「おばあちゃん」と呼んで慕っているが、いつまでたっても子供扱いされて、基本的に頭が上がらない。"}],"source":"egs","sourceCharacterId":"12397","sourceWorkId":"13818","spoiler":false},{"segments":[{"spoiler":false,"text":"誰もが認めるアミダハラ随一の魔術師で、数百年の時を生き続けているという。"},{"spoiler":false,"text":"魔界出身であるがその種族は不明。"},{"spoiler":false,"text":"アミダハラの闇を司る魔術師組合の重鎮中の重鎮で、どんな悪党も決して敵に回そうとはしない。"},{"spoiler":false,"text":"通称は 「おばばさま」。"},{"spoiler":false,"text":"観光客相手の小さな土産屋 「魔法堂」 を営んでいて、いつ行ってもカウンターにちょこんと置物のように座っている。"},{"spoiler":false,"text":"アンネローゼは 「おばあちゃん」 と呼んで慕っているが、いつまでたっても子供扱いされて、基本的に頭が上がらない。"}],"source":"bangumi","sourceCharacterId":"94251"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f4f2a4489781323c342e9830d761e50de6645e50e4ddc724cd1a1de4c514675.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5e9cb82c3cee13e93c3e2ce1bf0c2c1852b9b6b089d4e1a2cc1166225ade8f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c6860","characterName":"橘 陸郎","sourceIds":{"bangumi":[],"egsCharacterIds":["12388"],"vndbCharacterId":"c6860"},"originalCharacterName":"橘 陸郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rikuro is a high school boy who, while on a school trip, gets kidnapped by slave traders but shortly rescued by Annerose. However, he is forced to bind himself to her through a contract. He is made into a living \"zombie\". He cannot die as long as Annerose still lives. He serves as both her servant and bodyguard."}],"source":"vndb","sourceCharacterId":"c6860"},{"segments":[{"spoiler":false,"text":"南聖風学園二年。"},{"spoiler":false,"text":"エロゲー史上有数の不幸な主人公。"},{"spoiler":false,"text":"修学旅行で京都に来た際、スケベな友人たちと廃棄都市アミダハラに訪れるも娼館での金をケチり、町をぶらぶらしていたところを奴隷商人によって浚われてしまう。"},{"spoiler":false,"text":"その後、アンネローゼの奴隷となり彼女の助手兼護衛として働く事に。"},{"spoiler":false,"text":"一般市民、平凡学生、特技妄想、健全青年。"},{"spoiler":false,"text":"主人公はアンネローゼによって魂を奪われ”不死者”とされている。"},{"spoiler":false,"text":"「神さま！　助けてくれたら俺、何でもします！」"}],"source":"egs","sourceCharacterId":"12388","sourceWorkId":"13818","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35d8b17b41d3c7dba29cb54991ce5aaea1ff205af94702b23a612779f54622cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3733f8b7b69d2e49b55f0cd637194262971a992ae75990d3df8f476a35b42d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c6861","characterName":"アンネローゼ ヴァジュラ","sourceIds":{"bangumi":[{"characterId":"33661","match":"exact-normalized-name-in-linked-work","subjectId":"303918"},{"characterId":"33661","match":"exact-normalized-name-in-linked-work","subjectId":"89164"}],"egsCharacterIds":["12387"],"vndbCharacterId":"c6861"},"originalCharacterName":"アンネローゼ ヴァジュラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Annerose is a feared and powerful witch living in Amidahara. She is half human, half demon and makes a living by running a detective agency. She wields the legendary sword Kongoyasha and her skill as a swordsman is second to none. While she is not down right evil Annerose is still ruthless when it comes how she conducts buisness."}],"source":"vndb","sourceCharacterId":"c6861"},{"segments":[{"spoiler":false,"text":"魔界の支配階級の男と人間の女の間に生まれたハーフ。魔女剣客。"},{"spoiler":false,"text":"伝説の魔刀、金剛夜叉を駆るダークヒロイン。"},{"spoiler":false,"text":"人界と魔界のほとりで探偵業を営む。"},{"spoiler":false,"text":"アミダハラの有力者に顔がきき、彼女と友好的なものもいれば、恨みを持つものも少な