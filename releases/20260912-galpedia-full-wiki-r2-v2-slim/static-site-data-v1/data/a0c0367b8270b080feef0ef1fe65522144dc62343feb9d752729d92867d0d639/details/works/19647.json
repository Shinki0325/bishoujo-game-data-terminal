":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Knitting"},{"spoiler":false,"text":"Skills: Baking"},{"spoiler":false,"text":"Likes: Penguins (Collecting goods)"},{"spoiler":false,"text":"Dislikes: Getting birthday and Christmas presents at the same time"},{"spoiler":false,"text":"Favorite food: Sweet foods, whipped cream"},{"spoiler":false,"text":"Hated food: Spicy, tough foods"},{"spoiler":false,"text":"Shotarou's non-blood-related younger sister who calls him \"onii-chan\" and lives with his family because of an accident where her parents died when she was younger. After moving in, she was often depressed, but Shotarou managed to cheer her up through various means. Kurumi is also the reason why Shotarou turned into such a hotblooded man who only spouts dumb words. Thanks to him, Kurumi opened up and became a more cheerful person, but is still very clumsy and loves penguins, and tries to support her onii-chan the best she can."}],"source":"vndb","sourceCharacterId":"c17264"},{"segments":[{"spoiler":false,"text":"翔太郎の義理の妹。"},{"spoiler":false,"text":"幼き頃、両親を事故でなくし翔太郎の父親が引き取る事になった。"},{"spoiler":false,"text":"両親の死を経験しているためか、引き取られた当初は塞ぎこんでいたが、翔太郎がしょうもないギャグや無駄に熱い言葉をかけ続けてくれたおかげで心が開き、現在のほのぼのとした性格になった。"},{"spoiler":false,"text":"翔太郎がバカなことをするとちゃんとお説教をし、「おにいちゃんもう少し落ち着いてくれないかなぁ」 と常々思っているのだが、その性格になった原因が自分にあることを知らない。"},{"spoiler":false,"text":"翔太郎も勿論くるみを大事にしており、『春うららのターザン事件』は例に漏れず伝説となっている。"}],"source":"egs","sourceCharacterId":"2398","sourceWorkId":"19647","spoiler":false},{"segments":[{"spoiler":false,"text":"翔太郎の義理の妹。 幼い頃両親を事故で亡くし、翔太郎の父親が引き取ることになった。"},{"spoiler":false,"text":"引き取られた当初は塞ぎこんでいたが、そんなくるみを励まそうとする翔太郎。"},{"spoiler":false,"text":"しょうもないギャグや無駄に熱い言葉を言いまくっているとくるみが笑うので、そのせいで翔太郎はバカな行動をとるようになった。"},{"spoiler":false,"text":"現在は翔太郎のおかげで心を開き、ほのぼのとした性格になる。"},{"spoiler":false,"text":"献身的に兄を支える妹だが、兄がバカなことをするとちゃんとお説教をする。"},{"spoiler":false,"text":"「おにいちゃんもう少し落ち着いてくれないかなぁ」 と常々思っているが、そんな性格になった原因が自分にあることを知らない。"},{"spoiler":false,"text":"翔太郎ももちろんくるみが大事で、“春うららのターザン事件” は例に漏れず伝説となっている。"},{"spoiler":false,"text":"「むにゃむにゃ…… まだ朝の5時だよおにいちゃん……」"}],"source":"bangumi","sourceCharacterId":"23485"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"23485","value":"ペンギン（グッズ集め）"},{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"23485","value":"甘い食べ物、生クリーム"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"23485","value":"誕生日・Xmasプレゼントを一緒にされること"},{"label":"学年","source":"bangumi","sourceCharacterId":"23485","value":"1年"},{"label":"星座","source":"bangumi","sourceCharacterId":"23485","value":"やぎ座"},{"label":"特技","source":"bangumi","sourceCharacterId":"23485","value":"お菓子作り"},{"label":"趣味","source":"bangumi","sourceCharacterId":"23485","value":"編み物"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b76a1f9b6a7d406ff1f7a0e89dad308dbb88848c179783b9e7b7c368116c3778.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b75564b41fd78823fe76bb715d5d4ce8303a445e4f85e02db4b5ac5b2b1334e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:85352:23485:4830:1","source":"bangumi"}]},{"characterId":"char_c17265","characterName":"海老原 ほのか","sourceIds":{"bangumi":[{"characterId":"23486","match":"exact-normalized-name-in-linked-work","subjectId":"85352"}],"egsCharacterIds":["2399"],"vndbCharacterId":"c17265"},"originalCharacterName":"海老原 ほのか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1025"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Walking around while drinking and eating"},{"spoiler":false,"text":"Skills: Being a glutton"},{"spoiler":false,"text":"Likes: Cats"},{"spoiler":false,"text":"Dislikes: Cheap taverns"},{"spoiler":false,"text":"Favorite food: Noodles (Especially after a drink or couple), alcholic drinks in general"},{"spoiler":false,"text":"Hated food: Oysters"},{"spoiler":false,"text":"Shotarou's homeroom teacher who teaches world history. She has a rival-like relationship with him. Honoka takes her work seriously, but other manners regarding to her life very lazily. She has a very fierce mouth and curses often, but is just a misunderstood maiden at heart. Honoka likes cats so much that she fights like one whenever she gets into fights with the students."}],"source":"vndb","sourceCharacterId":"c17265"},{"segments":[{"spoiler":false,"text":"翔太郎のクラスの担任。担当は世界史。"},{"spoiler":false,"text":"仕事は真面目だが口が悪い、授業や学校の仕事以外はちょっと抜けている。"},{"spoiler":false,"text":"口が悪いので多少の誤解を受けるが、根は悪い人間ではなく中身は乙女。猫が好きなので、学生たちは猫を盾にしてほのかと戦う。"},{"spoiler":false,"text":"『行き遅れ』『アラサー』という単語を聞くと激怒し、翔太郎たちによくからかわれバトルに発展することも日常茶飯事。"},{"spoiler":false,"text":"翔太郎とは『陽春の消火器事件』からライバル関係が続いている。"}],"source":"egs","sourceCharacterId":"2399","sourceWorkId":"19647","spoiler":false},{"segments":[{"spoiler":false,"text":"翔太郎のクラスの担任。 担当は世界史。"},{"spoiler":false,"text":"仕事はまじめだが、それ以外はちょっと抜けている。"},{"spoiler":false,"text":"口は悪いが性根まで悪い人間ではなく、多少の誤解を受けているが中身は乙女。"},{"spoiler":false,"text":"猫が好きなので、学生たちは猫を盾にしてほのかと戦う。"},{"spoiler":false,"text":"“行き遅れ” “アラサー” という単語を聞くと激怒し、翔太郎たちによくからかわれバトルに発展することも日常茶飯事。"},{"spoiler":false,"text":"翔太郎とは “陽春の消火器事件” からライバル関係が続いている。"},{"spoiler":false,"text":"「おい、翔太郎、ちょっとこっち来い」"}],"source":"bangumi","sourceCharacterId":"23486"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"23486","value":"猫"},{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"23486","value":"らーめん（特に飲んだ後）、酒類全般（特にビール）"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"23486","value":"安居酒屋、とりあえずビールという言葉"},{"label":"星座","source":"bangumi","sourceCharacterId":"23486","value":"さそり座"},{"label":"特技","source":"bangumi","sourceCharacterId":"23486","value":"大食い"},{"label":"職業","source":"bangumi","sourceCharacterId":"23486","value":"教師"},{"label":"趣味","source":"bangumi","sourceCharacterId":"23486","value":"食べ歩き、飲み歩き"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4b729b370b3e5e67048e369f2a093061e0a8a37bca94ad8450572e8f6004e48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3686d030d6f0eef89c07ad289d545e6bfb41fa006f2b675521283b7f6f8de756.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:85352:23486:5052:1","source":"bangumi"}]},{"characterId":"char_c17266","characterName":"あんこ","sourceIds":{"bangumi":[{"characterId":"23487","match":"exact-normalized-name-in-linked-work","subjectId":"85352"}],"egsCharacterIds":["2400"],"vndbCharacterId":"c17266"},"originalCharacterName":"あんこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"123"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"revi