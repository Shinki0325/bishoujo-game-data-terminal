nflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the most popular girls in school who has won the school's beauty pageant for four years in a row. Despite her status Satsuki herself has a bright personality and she is kind to everyone around her - however, the image of her being the \"perfect girl\" is just a mask she puts on."}],"source":"vndb","sourceCharacterId":"c36322"},{"segments":[{"spoiler":false,"text":"学園祭で行われる前期後期課課程合同ミスコンにおいて、前人未到の4連覇を成し遂げている誰もが認める学園一の美少女。"},{"spoiler":false,"text":"しかし本人はそのことを鼻にかけることはなく、人当たりの良い明るい性格で誰に対しても分け隔てなく接している。"},{"spoiler":false,"text":"そんな容姿も性格も完璧な女の子だが……？"}],"source":"egs","sourceCharacterId":"7040","sourceWorkId":"22300","spoiler":false},{"segments":[{"spoiler":false,"text":"学園祭で行われるミスコンにおいて、前人未到の4連覇を成し遂げている誰もが認める学園一の美少女。"},{"spoiler":false,"text":"人当たりの良い明るい性格で誰に対しても分け隔てなく接しており、容姿も性格も完璧な女の子だが……それはあくまでも仮の姿だったりする。"},{"spoiler":false,"text":"今年の春から“猫の手部”に入部。宗一郎に対してアタックを続けているものの、進展は今のところ無い。"}],"source":"egs","sourceCharacterId":"7040","sourceWorkId":"22396","spoiler":false},{"segments":[{"spoiler":false,"text":"学園祭で行われるミスコンにおいて、前人未到の４連覇を成し遂げている誰もが認める学園一の美少女。"},{"spoiler":false,"text":"そんな高嶺の花の彼女だが、誰に対しても分け隔てなく接しており、容姿も性格も完璧な女の子だが……それはあくまでも仮の姿。"},{"spoiler":false,"text":"本当の姿は負けず嫌いで、独占欲が強く、諦めが悪い性格で、好きな相手には積極的にアタックし続ける健気（？）な女の子なのである。"}],"source":"egs","sourceCharacterId":"7040","sourceWorkId":"22397","spoiler":false},{"segments":[{"spoiler":false,"text":"誰もが認める学園一の美少女。学園祭で行われるミスコンにおいて、前人未到の 5連覇を成し遂げている。 人当たりの良い明るい性格で、誰に対しても分け隔てなく接する。"},{"spoiler":false,"text":"そんな容姿も性格も完璧な女の子だが……それはあくまでも仮の姿。本当の姿は負けず嫌いで、独占欲が強く、諦めが悪い性格で、好きな相手には積極的にアタックし続ける健気（？）な女の子なのである。"}],"source":"egs","sourceCharacterId":"7040","sourceWorkId":"22398","spoiler":false},{"segments":[{"spoiler":false,"text":"誰もが認める学園一の美少女。"},{"spoiler":false,"text":"学園祭で行われるミスコンにおいて、前人未到の 4連覇を成し遂げている。"},{"spoiler":false,"text":"だが本人はそれを鼻にかけることなく、人当たりの良い明るい性格で誰に対しても分け隔てなく接している。"},{"spoiler":false,"text":"そんな容姿も性格も完璧な女の子だが……？"},{"spoiler":false,"text":"「嫌いな人なんていないよ。 みんな優しい人達だってわたしは知ってるもの」"}],"source":"bangumi","sourceCharacterId":"35756"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"35756","value":"後期課程2年"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9a66fecc44a044cc15be82884dcf2111cc33b94352d031a25b0305b5fa50ada.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19f30f27654801cc54da93e91e96484e31102a82d7d6786c72bec98d5229bfd1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木屋 場里絵","creatorId":"vndb:s416","sourcePersonId":"vndb:s416","canonicalEntityId":"vndb:s416","name":"清水 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77673","source":"vndb"}]},{"characterId":"char_c36323","characterName":"和泉 葵","sourceIds":{"bangumi":[{"characterId":"35757","match":"exact-normalized-name-in-linked-work","subjectId":"140431"},{"characterId":"35757","match":"exact-normalized-name-in-linked-work","subjectId":"166758"},{"characterId":"35757","match":"exact-normalized-name-in-linked-work","subjectId":"185497"},{"characterId":"35757","match":"exact-normalized-name-in-linked-work","subjectId":"230170"}],"egsCharacterIds":["7041"],"vndbCharacterId":"c36323"},"originalCharacterName":"和泉 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"207"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","va