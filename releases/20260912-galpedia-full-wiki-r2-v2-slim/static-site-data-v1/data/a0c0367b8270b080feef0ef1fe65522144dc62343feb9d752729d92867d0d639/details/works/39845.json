ts":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"黒髪ロングの才女で、心優しく人あたりもいいので同性異性問わず人気が高い。"},{"spoiler":false,"text":"健気かつ強い正義感を持っており、困っている人を放っておけない。"},{"spoiler":false,"text":"潜在能力の高さ故、エクスティアに変身して皆を守って戦うことになる。"}],"source":"egs","sourceCharacterId":"6199","sourceWorkId":"21403","spoiler":false},{"segments":[{"spoiler":false,"text":"前作でエクスティアへと変身して侵略者と闘い、退けた真理奈。"},{"spoiler":false,"text":"しかし新たな侵略者の罠に嵌ってしまい変身できなくなってしまう。"},{"spoiler":false,"text":"果たして再び戦えるようになるのか。"}],"source":"egs","sourceCharacterId":"6199","sourceWorkId":"22701","spoiler":false},{"segments":[{"spoiler":false,"text":"エクスティアとして異世界からの侵略に対して戦ってきたヒロイン。"},{"spoiler":false,"text":"心優しく、皆の為に戦う芯の強さをもっている。"},{"spoiler":false,"text":"少々やきもち焼きでもある。"},{"spoiler":false,"text":"主人公である創真の恋人であり、一緒の大学に通っている。"},{"spoiler":false,"text":"そろそろ将来のことについて考えたりしている。"}],"source":"egs","sourceCharacterId":"6199","sourceWorkId":"39845","spoiler":false},{"segments":[{"spoiler":false,"text":"黒髪ロングの才女で、主人公とは幼なじみ。"},{"spoiler":false,"text":"心優しく人当たりも良いので、同性異性問わず人気が高い。"},{"spoiler":false,"text":"健気で強い正義感を持っており、困っている人を放っておけない性分。"},{"spoiler":false,"text":"潜在能力の高さゆえ、エクスティアに変身して皆を守って戦うことになる。"}],"source":"bangumi","sourceCharacterId":"48209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f950e3f5d15be4cb8786ea122557bf9dddd27913ed97fa36c0a83424eea149b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33ac0632a89226f5e3a040eca06da380b00f91d96abd64454caf330ba070553b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葉村 夏緒","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101857","source":"vndb"}]},{"characterId":"char_c52923","characterName":"創ちゃん","sourceIds":{"bangumi":[{"characterId":"146850","match":"exact-normalized-name-in-linked-work","subjectId":"611389"}],"egsCharacterIds":["28301"],"vndbCharacterId":"c52923"},"originalCharacterName":"創ちゃん","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhood friend of Katsuragi Marina, also attending the same school. A bit pervert and almost didn't having any purpose in live, but having kind of hot-blooded personality. Play role as Marina's supporter during battle."},{"spoiler":false,"text":"Translation from official site"}],"source":"vndb","sourceCharacterId":"c52923"},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"真理奈とは幼馴染で、侵略に対しては真理奈へのサポートを担当していた。"},{"spoiler":false,"text":"真理奈とはＨによってＰＰと呼ばれるエネルギー回復をすることができる。"},{"spoiler":false,"text":"恋人である真理奈と同じ大学に通っている。"}],"source":"egs","sourceCharacterId":"28301","sourceWorkId":"39845","spoiler":false},{"segments":[{"spoiler":false,"text":"ExS-TIAシステム発動後、ソーマも戦えるようになりました。しかしシステムのフィードバックにより、彼は女性になってしまう。"}],"source":"bangumi","sourceCharacterId":"146850"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2720201c3d4a4af8d3a1698cac994b3c898a7884f95a2997510492e882e8f2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bd4c310046acb211e6d5fea0b0945601007e49f72d4babfeb408f8501b21b9b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c32434","characterName":"エクスティア","sourceIds":{"vndbCharacterId":"c32434"},"originalCharacterName":"エクスティア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The form o