leLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:62478","source":"vndb"},{"creditedName":"紫狼","creatorId":"vndb:s36729","sourcePersonId":"vndb:s36729","canonicalEntityId":"vndb:s36729","name":"紫狼","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:62479","source":"vndb"},{"creditedName":"天羽","creatorId":"vndb:s36730","sourcePersonId":"vndb:s36730","canonicalEntityId":"vndb:s36730","name":"天羽","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:62480","source":"vndb"},{"creditedName":"まばん","creatorId":"vndb:s36732","sourcePersonId":"vndb:s36732","canonicalEntityId":"vndb:s36732","name":"まばん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:62481","source":"vndb"},{"creditedName":"神館","creatorId":"vndb:s36731","sourcePersonId":"vndb:s36731","canonicalEntityId":"vndb:s36731","name":"神館マキ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:62482","source":"vndb"}]},"cast":[{"characterId":"char_c1626","characterName":"御崎玖美子","sourceIds":{"bangumi":[{"characterId":"148510","match":"exact-normalized-name-in-linked-work","subjectId":"265737"}],"egsCharacterIds":["19151"],"vndbCharacterId":"c1626"},"originalCharacterName":"御崎玖美子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mizuki's mother."},{"spoiler":false,"text":"the principal of the same school. She"},{"spoiler":false,"text":"is a capable educator and a strict woman. Mizuki has some things she doesn't like about her, but she also respects her. When Misaki was in elementary school, her husband died in a traffic accident. Since then, she has repeatedly refused talk of remarrying (to show her loyalty to her husband) and raised her daughter on her own. She has different educational principles from the school's chairman, Kuroda Takuzo."}],"source":"vndb","sourceCharacterId":"c1626"},{"segments":[{"spoiler":false,"text":"瑞希の母で、学園長を務める女性。"},{"spoiler":false,"text":"有能で厳しい教育者であり、瑞希にとって、少し苦手な所もあるが尊敬できる人物。"},{"spoiler":false,"text":"理事長である「黒田拓蔵」とは、教育方針に相違があるようで……。"},{"spoiler":false,"text":"「瑞希先生、探しましたよ。今、お時間ありますか？」"}],"source":"egs","sourceCharacterId":"19151","sourceWorkId":"10026","spoiler":false},{"segments":[{"spoiler":false,"text":"瑞希の母で、同じ学園に勤める学園長。有能な教育者であり、厳しい性格の女性。"},{"spoiler":false,"text":"瑞希にとっては、苦手な部分もあるが尊敬の念を抱く相手でもある。"},{"spoiler":false,"text":"瑞希が小学生の頃、夫は交通事故で死去。それ以来、再婚の話（夫に操を立てて）を何度も断り、女手一つで娘を育て上げた。"},{"spoiler":false,"text":"学園の理事長である「黒田　拓蔵」とは教育方針に相違がある。"}],"source":"bangumi","sourceCharacterId":"148510"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f0c43e3efc68707e757618be58cae6b1f59c47eb01190f1e555b2f3fd5e54e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d822384103a278e202cb106b537a7da7758281e5cff90254a49da422a5270767.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤村 美樹","creatorId":"vndb:s2558","sourcePersonId":"vndb:s2558","canonicalEntityId":"vndb:s2558","name":"藤村 美樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34896","source":"vndb"}]},{"characterId":"char_c1627","characterName":"御崎 瑞希","sourceIds":{"bangumi":[{"characterId":"86625","match":"exact-normalized-name-in-linked-work","subjectId":"265737"}],"egsCharacterIds":["19149"],"vndbCharacterId":"c1627"},"originalCharacterName":"御崎 瑞希","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kumiko's daughter."},{"spoiler":false,"text":"The protagonist of the story."},{"spoiler":false,"text":"A teacher at the school in her fourth year. Sincere and caring, she has a good reputation among both students and teachers. She is a cute woman who is reliable at work but has a slightly careless side in her private life. Shortly after arriving at the school, she encounters an incident in which a female student she was close to commits suicide. Her feelings of guilt for not being able to guide her in the right direction become the catalyst for her growth into a trusted teacher. She always puts her students first and acts with empathy."},{"spoiler":false,"text":"After a long relationship, she has just become engaged to \"Kimihara Noriyuki\"."}],"source":"vndb","sourceCharacterId":"c1627"},{"segments":[{"spoiler":false,"text":"本作の主人公で、着任四年目の学園教諭。"},{"spoiler":false,"text":"誠実で面倒見がよく、生徒や教師からの評判も上々。"},{"spoiler":false,"text":"しかしプライベートでは、少し抜けたところもあり、それがかえって、彼女の魅力を引き立たせている。"},{"spoiler":false,"text":"着任当時に起きた事件がきっかけで、生徒を第一に考え、信頼される教師へと成長させるきっかけに。"},{"spoiler":false,"text":"「私はあの時誓った…。私は絶対、教え子を見捨てたりしない」"}],"source":"egs","sourceCharacterId":"19149","sourceWorkId":"10026","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。"}],"source":"bangumi","sourceCharacterId":"86625"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97262d82507d3710b8ec31f685ba1fd41bdcb2c7d3db50083f5b65973dd7599d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9920844bca819f6965884c765292b10b16c83b74ffa37772df957a0f4fc10639.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265737:86625:4854:1","source":"bangumi"}]},{"characterId":"char_c1628","characterName":"音羽由衣","sourceIds":{"bangumi":[{"characterId":"86639","match":"exact-normalized-name-in-linked-work","subjectId":"265737"}],"egsCharacterIds":["19150"],"vndbCharacterId":"c1628"},"originalCharacterName":"音羽由衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at the school where Mizuki works. A bright and sociable girl. She admires Mizuki very much. Her dream is to become a wonderful teacher like Mizuki. Akira Kagami, who she was in love with, confessed to her and they began dating. She didn't even know that she was being deceived..."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c1628"},{"segments":[{"spoiler":false,"text":"瑞希の教え子で、明るく社交的な女の子。"},{"spoiler":false,"text":"瑞希をとても慕っており、彼女のような先生になるのが夢。"},{"spoiler":false,"text":"好意を寄せていた「各務晃」に告白されて、彼に処女を捧げてしまう。"},{"spoiler":false,"text":"本人は利用されていることを知らず、普通に付き合っているつもり。"},{"spoiler":false,"text":"「先生、男の子が貰って喜ぶものってなんですか!?」"}],"source":"egs","sourceCharacterId":"19150","sourceWorkId":"10026","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的学生之一，各务的女友。"}],"source":"bangumi","sourceCharacterId":"86639"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b977db2f3a8e66c443121f90625092015bb1b145c92d4fa99f44376edcf5434.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32ed9951cd4458b33406714207b1438db9588071b06529090f5506bd5364e79e.webp","width":164,"height":256,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265737:86639:4744:1","source":"bangumi"}]},{"characterId":"char_c1629","characterName":"各務雪乃","sourceIds":{"bangumi":[{"characterId":"148511","match":"exact-normalized-name-in-linked-work","subjectId":"265737"}],"egsCharacterIds":["19152"],"vndbCharacterId":"c1629"},"originalCharacterName":"各務雪乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the older sister of Akira Kagami. She is a seductive woman who is the manager of a secret members-only club. She is the mistress of the club owner. However, Yukino only loves Akira. As long as she has Akira, she doesn't need anything else. She is both sadistic and masochistic."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c1629"},{"segments":[{"spoiler":false,"text":"脅迫生徒「各務晃」の姉で、会員制秘密クラブの支配人。"},{"spoiler":false,"text":"クラブオーナーの情婦でもあるのだが、彼女が愛しているのは、弟の晃だけ。"},{"spoiler":false,"text":"その想いは、弟さえいれば他に何もいらないと思っているほど。"},{"spoiler":false,"text":"肉親である祖母「各務弥生」を嫌っているが……。"},{"spoiler":false,"text":"「あの子の事に深入りするのでしたら……それなりのお覚悟を見せていただかないと」"}],"source":"egs","sourceCharacterId":"19152","sourceWorkId":"10026","spoiler":false},{"segments":[{"spoiler":false,"text":"「各務　晃」の姉。会員制秘密クラブの支配人をしている妖艶な女性。クラブのオーナーの情婦となっている。"},{"spoiler":false,"text":"だが雪乃が愛しているのは晃だけ。晃さえいれば、他には何もいらないと思っている。サドでありマゾ。"},{"spoiler":false,"text":"祖母である「各務　弥生」を嫌っている。"}],"source":"bangumi","sourceCharacterId":"148511"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35137636e9d3734a886db91227c8059542ba2355d933b6f458aa50dfb4744470.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14cc53d85b957067a635e122f474e9f3837ae3b7059904356307427b39045f30.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265737:148511:4832:1","source":"bangumi"}]},{"characterId":"char_c1638","characterName":"佐山紀香","sourceIds":{"bangumi":[{"characterId":"148512","match":"exact-normalized-name-in-linked-work","subjectId":"265737"}],"egsCharacterIds":["19153"],"vndbCharacterId":"c1638"},"originalCharacterName":"佐山紀香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A friend of Mizuki's. She's a physical education teacher."}],"source":"vndb","sourceCharacterId":"c1638"},{"segments":[{"spoiler":false,"text":"瑞希の友人で、先輩体育教師。"},{"spoiler":false,"text":"ボーイッシュでシャープなイメージを持つ女性で、男勝りな性格とくだけた姿勢が、生徒に受けている。"},{"spoiler":false,"text":"同じ学園の男性教諭に、思慕の念を寄せているようだが……。"},{"spoiler":false,"text":"「瑞希、君原とは上手くいってるんだよ…な」"}],"source":"egs","sourceCharacterId":"19153","sourceWorkId":"10026","spoiler":false},{"segments":[{"spoiler":false,"text":"瑞希の友人で、同じ学園に勤める先輩体育教諭。男勝りな所があり、くだけた性格で生徒ともよく会話をする。"},{"spoiler":false,"text":"ボーイッシュでシャープなイメージ女性。"},{"spoiler":false,"text":"実は、同僚の教師であり瑞希の婚約者でもある君原に思慕の念を抱いている。"}],"source":"bangumi","sourceCharacterId":"148512"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e622713f77693d48d6c876636a7b3816a6753550f5a1eb83a75527e992498fa2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c1047c74eef5b1cf3483ad7d85fd9ea133ef917e6c9b068426dfb543af4624b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265737:148512:4799:1","source":"bangumi"}]},{"characterId":"char_c1639","characterName":"刑部 雛子","sourceIds":{"bangumi":[{"characterId":"148513","match":"exact-normalized-name-in-linked-work","subjectId":"265737"}],"egsCharacterIds":["19154"],"vndbCharacterId":"c1639"},"originalCharacterName":"刑部 雛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at the school where Mizuki is working. A close friend of Yui's, she's a shy and quiet girl."}],"source":"vndb","sourceCharacterId":"c1639"},{"segments":[{"spoiler":false,"text":"学園の生徒で、由衣の親友。"},{"spoiler":false,"text":"内気で大人しい少女だが、成績優秀で、記憶力は抜群。"},{"spoiler":false,"text":"一見、地味な印象を受けるが、よくよく見ると、可愛らしい顔立ちをしている。"},{"spoiler":false,"text":"刑事である「刑部良治」の一人娘。"},{"spoiler":false,"text":"「最近、由衣ちゃんの様子が変なんですけど、何か知りませんか？」"}],"source":"egs","sourceCharacterId":"19154","sourceWorkId":"10026","spoiler":false},{"segments":[{"spoiler":false,"text":"瑞希が勤める学園の生徒で、由衣の親友。成績優秀で、記憶力に長けている。"},{"spoiler":false,"text":"内気でおとなしい女の子。地味な印象だが、可愛い顔立ちをしている。"},{"spoiler":false,"text":"刑事「刑部　良治」の一人娘。"}],"source":"bangumi","sourceCharacterId":"148513"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/642fda5fa2f4c92bf46a5b0b8a62abda39872bb0a5500bf53f996642bac66740.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c96885135258f66081efa1d15b610b4911fded23a38b653042eb71f9da1be84.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"