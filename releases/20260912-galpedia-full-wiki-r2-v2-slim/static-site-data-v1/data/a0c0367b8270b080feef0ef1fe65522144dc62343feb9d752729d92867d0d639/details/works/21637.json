{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21637","model":{"presentationWorkId":"vndb:v16852","staff":{"artwork":[{"creditedName":"あおじる","creatorId":"vndb:s8143","sourcePersonId":"egs:creator:1689","canonicalEntityId":"vndb:s8143","name":"あおじる","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:146162","source":"egs"}],"scenario":[{"creditedName":"小峰久生","creatorId":"vndb:s3161","sourcePersonId":"egs:creator:4886","canonicalEntityId":"vndb:s3161","name":"小峰久生","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:146163","source":"egs"}],"music":[{"creditedName":"Triodesign","creatorId":"vndb:s5099","sourcePersonId":"vndb:s5099","canonicalEntityId":"vndb:s5099","name":"Triodesign","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:117790","source":"vndb"}],"other":[{"creditedName":"真理絵(marie)","creatorId":"vndb:s47","sourcePersonId":"egs:creator:12359","canonicalEntityId":"vndb:s47","name":"真理絵(marie)","detail":"OP曲「worthless」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:149032","source":"egs"},{"creditedName":"真理絵","creatorId":"vndb:s47","sourcePersonId":"vndb:s47","canonicalEntityId":"vndb:s47","name":"真理絵","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:117788","source":"vndb"}]},"cast":[{"characterId":"char_c33259","characterName":"高瀬 好美","sourceIds":{"bangumi":[{"characterId":"43048","match":"exact-normalized-name-in-linked-work","subjectId":"186406"}],"egsCharacterIds":["6229"],"vndbCharacterId":"c33259"},"originalCharacterName":"高瀬 好美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryuuji's little sister. She's immature, and a brocon who clings to her brother incessantly."},{"spoiler":false,"text":"But since they didn't spend a lot of time together, Ryuuji is more like an older friend than a brother to her."},{"spoiler":false,"text":"She's been noticing lately how close Ryuuji is getting with Yuki, and it's making her somewhat restless."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c33259"},{"segments":[{"spoiler":false,"text":"精神年齢が大分幼い。竜児とは故あって、長い間離れて暮らしていた。"},{"spoiler":false,"text":"そのせいか、「兄」というより先に、「年上の身近な男」という感覚で竜児を見るようになってしまう。"},{"spoiler":false,"text":"ブラコンで、兄にべったり。"},{"spoiler":false,"text":"遊季と再会してからというもの、竜児が遊季に惹かれているらしきところを見ていて、かなり落ち着かない思いでいる。"}],"source":"egs","sourceCharacterId":"6229","sourceWorkId":"21637","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・竜児の妹。 精神年齢が幼く、ブラコンで兄にべったり。"},{"spoiler":false,"text":"長い間 離れて暮らしていた竜児は、兄というより “年上の身近な男” という感覚。"},{"spoiler":false,"text":"最近 竜児が遊季に惹かれているらしい様子を見てしまい、落ち着かない思いでいる。"}],"source":"bangumi","sourceCharacterId":"43048"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d2c52524736cea071ccf4693df0d7a1b0e6055bc2672d0c489329b57cb5f81e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6601fa1ff8151f72fbd2ab80a5360fbe46b30a9344a12c19b6cf049bb8a6932.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ありかわ真奈","creatorId":"vndb:s5761","sourcePersonId":"vndb:s5761","canonicalEntityId":"vndb:s5761","name":"ありかわ真奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186406:43048:21127:1","source":"bangumi"}]},{"characterId":"char_c33260","characterName":"春日部 遊季","sourceIds":{"bangumi":[{"characterId":"43049","match":"exact-normalized-name-in-linked-work","subjectId":"186406"}],"egsCharacterIds":["6230"],"vndbCharacterId":"c33260"},"originalCharacterName":"春日部 遊季","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryuuji's childhood friend. A bright and energetic girl."},{"spoiler":false,"text":"When at home, she handles things like housework very well, and seems like she has no flaws. But since she endures this all on her own, there seems to be aspects of herself that she tries to suppress."},{"spoiler":false,"text":"After seeing Ryuuji again after such a long time, she's very happy."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c33260"},{"segments":[{"spoiler":false,"text":"竜児の幼馴染。明るく元気。久々に再会した竜児と楽しく過ごしている。"},{"spoiler":false,"text":"家では家事を一手に引き受けるしっかり者。"},{"spoiler":false,"text":"欠点らしい欠点はないのだが、一人で頑張り過ぎ、何でも自分の中に溜め込んでしまう一面がある。"}],"source":"egs","sourceCharacterId":"6230","sourceWorkId":"21637","spoiler":false},{"segments":[{"spoiler":false,"text":"竜児の幼なじみ。 明るく元気な女の子。"},{"spoiler":false,"text":"家では家事を一手に引き受けるしっかり者で、欠点らしい欠点もない。"},{"spoiler":false,"text":"ただ一人で頑張り過ぎてしまい、何でも自分の内に溜め込んでしまう一面がある。"},{"spoiler":false,"text":"久々に再会した竜児とは楽しく過ごしている。"}],"source":"bangumi","sourceCharacterId":"43049"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8fa58cf97fc048dc83c01a5071abb7cd7ab3d75a6a1d3d603b37a6adcfdeb04.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e86e2aa9dfe542757774d7baf19d1d0291c48e9acb33eb8ff93b92a90cdcac1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186406:43049:8580:1","source":"bangumi"}]},{"characterId":"char_c33261","characterName":"氷川 希星","sourceIds":{"bangumi":[{"characterId":"43050","match":"exact-normalized-name-in-linked-work","subjectId":"186406"}],"egsCharacterIds":["6231"],"vndbCharacterId":"c33261"},"originalCharacterName":"氷川 希星","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A flashy and playful girl, who's kind to her friends. She speaks very bluntly, which can sometimes make her come off as a bit cold."},{"spoiler":false,"text":"Since her parents are always at work, she's happy being surrounded by her companions. She dislikes difficult things, and wants to just happily live in the moment."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c33261"},{"segments":[{"spoiler":false,"text":"派手で遊び好きだが、仲間には結構親切。"},{"spoiler":false,"text":"ズケズケした物言いをし、オブラートに包むということをしないのでしばしば場を凍らせる。"},{"spoiler":false,"text":"父は実業家で、家庭を顧みない仕事人間。"},{"spoiler":false,"text":"母も公演等で忙しく飛び回っており留守がちで、友人に囲まれている時が一番楽しい。"},{"spoiler":false,"text":"難しいことは嫌い。今を楽しく生きたい。将来のことはまだ余り考えたくない。"}],"source":"egs","sourceCharacterId":"6231","sourceWorkId":"21637","spoiler":false},{"segments":[{"spoiler":false,"text":"派手で遊び好きだが、仲間には親切な女の子。"},{"spoiler":false,"text":"オブラートに包むということをせず、ズケズケした物言いで場を凍らせることも。"},{"spoiler":false,"text":"両親が仕事で留守がちなため、友人に囲まれている時が一番楽しいと感じている。"},{"spoiler":false,"text":"難しいことは嫌いで、とりあえず今を楽しく生きたいと考えている。"}],"source":"bangumi","sourceCharacterId":"43050"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24c033c2fdeafb70fb5b95d4557b84d9ab353d9fa7893a0e78c2fbd2bc36af6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/008dd0e5bad8ecb579a62ba78e39dea596de3dbad88b580ae1e13e40e108ab62.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186406:43050:7890:1","source":"bangumi"}]},{"characterId":"char_c33262","characterName":"四ノ宮 花菜","sourceIds":{"bangumi":[{"characterId":"43051","match":"exact-normalized-name-in-linked-work","subjectId":"186406"}],"egsCharacterIds":["6232"],"vndbCharacterId":"c33262"},"originalCharacterName":"四ノ宮 花菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The serious-natured class president. Gets decent grades, but is bad at physical activity."},{"spoiler":false,"text":"She's had an interest in sex from a young age, but has always been ashamed of these proclivities, considering them obscene."},{"spoiler":false,"text":"Though she shows no outward interest towards having a flashy appearance or making friends, she's secretly interested in those kind of things."},{"spoiler":false,"text":"Secretly has feelings for Ryuuji."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c33262"},{"segments":[{"spoiler":false,"text":"真面目な委員長。"},{"spoiler":false,"text":"非常に耳年増で、性的欲求も強い。"},{"spoiler":false,"text":"が、自分のそんな衝動を汚らわしいものだと思ってもいる。"},{"spoiler":false,"text":"嫌悪は興味の裏返しで、派手な格好や交友関係を嫌っている風に見せているが、本当は興味津々なところも……"},{"spoiler":false,"text":"成績は上の中程度。運動は大の苦手。密かに竜児のことを想っている。"}],"source":"egs","sourceCharacterId":"6232","sourceWorkId":"21637","spoiler":false},{"segments":[{"spoiler":false,"text":"まじめな委員長。 成績は上の中程度で、運動が大の苦手。"},{"spoiler":false,"text":"非常に耳年増で性的欲求も強いが、自分のそんな衝動を汚らわしいものと思っている。"},{"spoiler":false,"text":"派手な格好や交友関係を嫌っている風に見せているが、本当は興味津々。"},{"spoiler":false,"text":"密かに竜児のことを想っている。"}],"source":"bangumi","sourceCharacterId":"43051"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54d3388933e5bf308f9a30102b08dffc78c16a9792761d1b73459cd9115aa300.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6dff71064951c04b9366bdd554f1bd92a42009a7d1dad4307aba674ee1d1551.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186406:43051:13368:1","source":"bangumi"}]},{"characterId":"char_c33263","characterName":"神楽 舞","sourceIds":{"bangumi":[{"characterId":"43052","match":"exact-normalized-name-in-linked-work","subjectId":"186406"}],"egsCharacterIds":["6233"],"vndbCharacterId":"c33263"},"originalCharacterName":"神楽 舞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A quiet young girl with a mysterious air."},{"spoiler":false,"text":"She often stares at Ryuuji and his friends, with a sad face. She tries not to get involved with other people."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c33263"},{"segments":[{"spoiler":false,"text":"謎の多い無口な少女。いつも悲しげな表情をして、竜児達のことを見つめている。自分から人に関わろうとしない。"}],"source":"egs","sourceCharacterId":"6233","sourceWorkId":"21637","spoiler":false},{"segments":[{"spoiler":false,"text":"謎の多い無口な少女。"},{"spoiler":false,"text":"いつも悲しげな表情をしながら、竜児たちのことを見つめている。"},{"spoiler":false,"text":"自分から他人に関わろうとはしない。"}],"source":"bangumi","sourceCharacterId":"43052"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cdeffb3cb8cdb9446ed6c15173600b0258adf9e6d2927d31e91eed37e6723b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed0b27a7c5b94524d1089baec1cc1e5177d5221b2e4462646453ad369a341db7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松平美波穂","creatorId":"vndb:s601","sourcePersonId":"vndb:s601","canonicalEntityId":"vndb:s601","name":"松平 美波穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186406:43052:15488:1","source":"bangumi"}]},{"characterId":"char_c33264","characterName":"綾部 志紀","sourceIds":{"bangumi":[{"characterId":"43053","match":"exact-normalized-name-in-linked-work","subjectId":"186406"}],"egsCharacterIds":["6234"],"vndbCharacterId":"c33264"},"originalCharacterName":"綾部 志紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A newly-hired teacher. She has a rough, yet lively, disposition."},{"spoiler":false,"text":"Seems to have a mysterious power about her...?"},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c33264"},{"segments":[{"spoiler":false,"text":"新しく赴任しきてきた教師。大雑把な性格で豪快。"},{"spoiler":false,"text":"何か不思議な力を持っているらしい……？"}],"source":"egs","sourceCharacterId":"6234","sourceWorkId":"21637","spoiler":false},{"segments":[{"spoiler":false,"text":"新しく赴任しきてきた教師。"},{"spoiler":false,"text":"大雑把な性格で豪快。"},{"spoiler":false,"text":"何か不思議な力を持っているらしい……？"}],"source":"bangumi","sourceCharacterId":"43053"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7862dd87876ffb2abdeb79aaf83d9102f92b14f67f8fdce5245c428da24d4e25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74bcc74865919bfe8463fe479d771afc8a13c9b927da0af61534bbc811e47bd8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤井 ねここ","creatorId":"vndb:s7420","sourcePersonId":"vndb:s7420","canonicalEntityId":"vndb:s7420","name":"藤井 ねここ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63094","source":"vndb"}]},{"characterId":"char_vndb_c35270","characterName":"高瀬 竜児","sourceIds":{"vndbCharacterId":"c35270"},"originalCharacterName":"高瀬 竜児","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Transferred to his new school a year ago. A so-called \"ordinary\" male student. So ordinary, in fact, that there seems to be nothing interesting about him at all. Others around him have noticed this."},{"spoiler":false,"text":"He turns to things like movies, novels, and manga to get stimulation from something."},{"spoiler":false,"text":"Although he's the leader of his school's newspaper club, they haven't gotten any work done at all. His teacher, who couldn't stand this inactivity any longer, pushed him to gather members to report local ghost stories."},{"spoiler":false,"text":"After this, he and his clubmates began gathering info for their article on the town's Seven Wonders..."},{"spoiler":false,"text":"translated from getchu"}],"source":"vndb","sourceCharacterId":"c35270"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50902506b22c572dfe47a24d7be0304a3b4f2beb85002d3b48cc91a1d2900508.webp","fallbackUrl":"https://wiki-assets.bishojo.date/te