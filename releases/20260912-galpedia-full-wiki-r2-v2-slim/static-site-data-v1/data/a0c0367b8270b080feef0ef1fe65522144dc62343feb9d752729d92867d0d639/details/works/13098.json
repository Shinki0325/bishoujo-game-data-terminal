/2355027a8b0605555251dee5198bdd07e56b36975deaf3ca72671d6ac0f36d01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a30585fc51895f79883c7f78b55e33bcddc74fda3ff5e65faec32e79fe7f11b.webp","width":242,"height":241,"source":"static-detail"},"actors":[{"creditedName":"井口 裕香","creatorId":"vndb:s3971","sourcePersonId":"vndb:s3971","canonicalEntityId":"vndb:s3971","name":"井口 裕香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23570","source":"vndb"}]},{"characterId":"char_vndb_c1687","characterName":"エリサ・D(ドリトル)・鳴瀬","sourceIds":{"vndbCharacterId":"c1687"},"originalCharacterName":"エリサ・D(ドリトル)・鳴瀬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1215"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"166"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She transfers to Kirameki High School in the protagonist's second year. Although she has blond hair and blue eyes, she is a half-blooded Japanese born in Miyagi Prefecture. She is very interested in the Japanese culture and is very skilled in Kendo. Fumiko Yanagi is her best friend."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c1687"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2b7292ce6f320c5a87041a14c612cebf0cf687cf2e4b2eb87d2f30cfe75e13c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c13c1a4f08c392b96a4df9449ff04f4def78bfa739d62952277185be1cef5a1f.webp","width":242,"height":241,"source":"static-detail"},"actors":[{"creditedName":"立野 香菜子","creatorId":"vndb:s4701","sourcePersonId":"vndb:s4701","canonicalEntityId":"vndb:s4701","name":"立野 香菜子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23573","source":"vndb"}]},{"characterId":"char_vndb_c1688","characterName":"前田 一稀","sourceIds":{"vndbCharacterId":"c1688"},"originalCharacterName":"前田 一稀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"112"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itsuki is a tomboy who has passion in sports, especially soccer. She is in Kirameki girl soccer club and is the best player in the team. She is always seen dribbling a soccer ball. Her closet friend is Miyako."},{"spoiler":false,"text":"Besides athletic skills, Itsuki is also good at mechanics, as it is related to her family's business."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c1688"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9648bd0356faf0c59a6c5dd5f6c2a16ac7d2e98baa82ffe10000a24d442cbfd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47a22755565fe1cf2e9f2966c484e956afed8932b895f44a61