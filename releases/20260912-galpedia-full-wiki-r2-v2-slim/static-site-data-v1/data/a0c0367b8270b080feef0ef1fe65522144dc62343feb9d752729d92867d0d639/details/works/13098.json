lationId":"vndb:vn-staff:42682","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c1682","characterName":"星川 真希","sourceIds":{"vndbCharacterId":"c1682"},"originalCharacterName":"星川 真希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"601"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The female lead of Tokimeki Memorial 4, Maki is a compassionate, cheerful, sincere, and honest person who can get along with everyone and likes to help people around her. Due to this characteristic of hers, she readily volunteers to become the class representative and later on the president of the student union. Her favorite hobby, besides helping people, is listening to J-pop music. Her closest friend is Tsugumi Godo."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c1682"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cba29773ffbd2b403b13548332ed8a6742adfd2ce711e6ff018a440d8d3ee177.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f3513321fffce89dc0f7e00eaeb1ecc5817ff59209f574f9b30290c3ff39c4c.webp","width":241,"height":241,"source":"static-detail"},"actors":[{"creditedName":"大亀 あすか","creatorId":"vndb:s4699","sourcePersonId":"vndb:s4699","canonicalEntityId":"vndb:s4699","name":"大亀 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23571","source":"vndb"}]},{"characterId":"char_vndb_c1683","characterName":"語堂 つぐみ","sourceIds":{"vndbCharacterId":"c1683"},"originalCharacterName":"語堂 つぐみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"302"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsugumi is Maki's closest friend who overly cares for Maki and is ready to do everything to protect her."},{"spoiler":false,"text":"Tsugumi is very talented at language and literature. She is often found reading books in the school library. She belongs to Kirameki's literature club. After she graduates, she also continues her education in specialized school of language and literature. While she is academically excellent, she is very bad at sports."},{"spoiler":false,"text":"Unlike conventional eye-glassed nerdy girls, Tsugumi is neither soft-spoken nor gentle. Quite the opposite: she is morose and sulky, ready to snap at everyone who irritates her. She is also brave, once seen trying to protect Maki from a group of thugs."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c1683"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93f408b3e6d72e205fe1224ca9776ef733f0470c8b103ddd7777422ecd2d58db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/3299bdffcf7a517396a968766e77ba09011e0e1aa58419faef5ba68086810e11.webp","width":241,"height":241,"source":"static-detail"},"actors":[{"creditedName":"矢作 紗友里","creatorId":"vndb:s670","sourcePersonId":"vndb:s670","canonicalEntityId":"vndb:s670","name":"矢作紗友里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23565","source":"vndb"}]},{"characterId":"char_vndb_c1684","characterName":"龍光寺 カイ","sourceIds":{"vndbCharacterId":"c1684"},"originalCharacterName":"龍光寺 カイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"414"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter and the only successor of Ryuukouchi Zaibatsu, Kai is brought up like a boy and has a lot of masculine characteristics. She is very good at fighting and does not hesitate to beat up anyone who annoys her. This makes her a frightening figure among the local thugs. Her closest friend is Yu Satsuki."},{"spoiler":false,"text":"At school, Kai is a delinquent, hardly going to class or participating in any activities. During school, she spends most of her time taking a nap on the rooftop, chilling out at Kirameki riverside park, or going to game arcade. Despite her delinquency, Kai does surprisingly well in exams and often stays among the top of the class."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c1684"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7d224fad2460280a9d7df09ba867200eece66b1c32503dfdf6902fe0dd2bcfa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba608aed3db7324468a291ffb8b3a1f9cd934c0e4bc0ed1ae28b11d63ef5bfaf.webp","width":241,"height":241,"source":"static-detail"},"actors":[{"creditedName":"松浦 チエ","creatorId":"vndb:s774","sourcePersonId":"vndb:s774","canonicalEntityId":"vndb:s774","name":"松浦 チエ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23566","source":"vndb"}]},{"characterId":"char_vndb_c1685","characterName":"郡山 知姫","sourceIds":{"vndbCharacterId":"c1685"},"originalCharacterName":"郡山 知姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"714"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aki is an upperclassman who is extremely talented in chemistry. She always comes up with new recipes for supplemental nutrition and does not hesitate to distribute them to girls who are interested."},{"spoiler":false,"text":"Although Aki spends most of her time researching, she is surprisingly mature and caring. She often gives meaningful advices to the protagonist if he joins the chemistry club, as well as tries to take care of him."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c1685"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https: