viewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She was living the life of an ordinary high school girl, but when it was discovered that her father had a large amount of debt, her family was torn apart."},{"spoiler":false,"text":"In order to search for her missing cousin, Yoshiyuki Tanabe, she decided to attend Gonto Gakuen."},{"spoiler":false,"text":"Although it was still summer uniform season, she wore a sash around her chest and a gakuran to hide her difference in body shape, and attended Gonto Gakuen, an all-boys school."},{"spoiler":false,"text":"She was more of an optimistic person, and would rather take action than think too deeply."}],"source":"vndb","sourceCharacterId":"c48571"},{"segments":[{"spoiler":false,"text":"ごく普通の女子校生として生活を送っていたのだが、父親に多額の借金があることが発覚して一家離散することになってしまう。"},{"spoiler":false,"text":"失踪してしまった従兄弟のお兄ちゃん・田邊良行を探すため、「権轟学園」に通うこととなる。"},{"spoiler":false,"text":"まだ夏服の時期だが、体型の違いを隠すためサラシを胸に巻き、学ランを着て男子校である「権轟学園」に通う。"},{"spoiler":false,"text":"どちらかといえば楽天家で、深く考え込むよりも行動してみるタイプ。"}],"source":"egs","sourceCharacterId":"9602","sourceWorkId":"16075","spoiler":false},{"segments":[{"spoiler":false,"text":"ごく普通の女子校生として充実した学園生活を送っていた少女。"},{"spoiler":false,"text":"しかしある日、父親に多額の借金があることが発覚して一家離散することになってしまう。"},{"spoiler":false,"text":"その後、小さい頃によく一緒に遊んでいた従兄のお兄ちゃん・田邊良行を頼ろうとして家を訪ねるが、彼は数日前から失踪してしまっていた。"},{"spoiler":false,"text":"ネットで良行のことを調べたところ、失踪した原因は彼の通っていた権轟学園にあるのではないかと考え、調査のため転入することを決める。"},{"spoiler":false,"text":"小さい頃から剣術を習っていて、腕はかなり立つ。"},{"spoiler":false,"text":"どちらかといえば楽天家で、深く考え込むよりも行動してみるタイプ。"},{"spoiler":false,"text":"「見つかったら、逃げちゃえばいいんだもんね」"}],"source":"bangumi","sourceCharacterId":"46763"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46763","value":"権轟学園2年生（偽）"},{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"9602","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"9602","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"9602","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"9602","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"9602","sourceWorkId":"16075","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd00fb4aa67f397ddb656aaa37cb1fe066d5d6f38bbdb87606aa004d9be97dff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40b8eaaef9b90f56333ca005be11b8c1c371b795e65bc533469fa9c6fd0e7ad7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:38691:46763:5936:1","source":"bangumi"}]},{"characterId":"char_c48573","characterName":"柊 愛希","sourceIds":{"bangumi":[{"characterId":"46764","match":"exact-normalized-name-in-linked-work","subjectId":"38691"}],"egsCharacterIds":["9603"],"vndbCharacterId":"c48573"},"originalCharacterName":"柊 愛希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend of the missing Yoshiyuki Tanabe."},{"spoiler":false,"text":"She has a strong sense of justice and a cool personality that is not easily shaken by things, but when it comes to Yoshiyuki, her feelings waver."},{"spoiler":false,"text":"In order to find clues and reasons for Yoshiyuki's disappearance, she goes to Gongo Gakuen after school and talks to the students."},{"spoiler":false,"text":"She is single-minded in everything she does and is stubborn enough to not give up on anything she has decided on until it is complete."}],"source":"vndb","sourceCharacterId":"c48573"},{"segments":[{"spoiler":false,"text":"失踪した田邊良行の幼馴染。"},{"spoiler":false,"text":"正義感が強く、物事に動じないクールな性格だが、良行のことになると気持ちが揺れてしまう。"},{"spoiler":false,"text":"良行が失踪した理由やヒントを探すため放課後に「権轟学園」へ行き、学生たちに話を聞いてまわっている。"},{"spoiler":false,"text":"何事にも一途で一度決めたことはやり遂げるまで諦めない頑固さがある。"}],"source":"egs","sourceCharacterId":"9603","sourceWorkId":"16075","spoiler":false},{"segments":[{"spoiler":false,"text":"近隣でも有名なお嬢様校・英煌学園に通っている女子校生。"},{"spoiler":false,"text":"渚沙・良行とは幼なじみだが、小さい頃に引っ越した渚沙とは手紙を数回やりとりしたくらいで交流は途絶えていた。"},{"spoiler":false,"text":"受験に失敗して引きこもりがちになっている良行を半ば強引に学園へ通わせていたが、その良行が突然失踪してしまい、ショックを受ける。"},{"spoiler":false,"text":"無理をさせていたのではと後悔し、失踪の理由や居場所のヒントを探り当てるため、放課後に権轟学園へ行き学生たちに話を聞いて回るようになる。"},{"spoiler":false,"text":"正義感が強く、物事に動じないクールな性格だが、良行のことになると気持ちが揺れてしまう。"},{"spoiler":false,"text":"何事にも一途で、一度決めたことはやり遂げるまで諦めない頑固さがある。"},{"spoiler":false,"text":"「私のせいだわ……だから、私が見つけないと……」"}],"source":"bangumi","sourceCharacterId":"46764"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46764","value":"英煌学園3年生"},{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"9603","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"9603","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"9603","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"9603","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"9603","sourceWorkId":"16075","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/465f3edd5397c87878ba810cddccb9dcb2c0c1933a6a26515b743be214d9f310.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef96e29e3a9153fdfb2a47048f41ac0b12a530cd3f2aac2f72421bccadb23fed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:38691:46764:6359:1","source":"bangumi"}]},{"characterId":"char_c48574","characterName":"日浦 しおり","sourceIds":{"bangumi":[{"characterId":"46765","match":"exact-normalized-name-in-linked-work","subjectId":"38691"}],"egsCharacterIds":["9604"],"vndbCharacterId":"c48574"},"originalCharacterName":"日浦 しおり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a very shy personality and is always nervous in front of people."},{"spoiler":false,"text":"Deep down, she is a student teacher who wants to become a great teacher who doesn't get nervous."},{"spoiler":false,"text":"She is very opinionated, easily deceived, weak to pressure, and easily swayed. She"},{"spoiler":false,"text":"is quite naive, and is often annoyed by those around her."},{"spoiler":false,"text":"She likes \"famous quotes\" from great people and celebrities, and tries to insert them in the middle of conversations."}],"source":"vndb","sourceCharacterId":"c48574"},{"segments":[{"spoiler":false,"text":"かなり内気な性格で、人前ではいつもオドオドしている。"},{"spoiler":false,"text":"内心ではオドオドしない立派な教師になりたい教育実習生。"},{"spoiler":false,"text":"思い込みが激しく、騙されやすい性格をしていて、押しに弱く、流されやすい。"},{"spoiler":false,"text":"かなり天然で、周囲にあきれられることも多い。"},{"spoiler":false,"text":"偉人や有名人の「名言」が好きで、会話の途中などに名言を挟もうとする。"}],"source":"egs","sourceCharacterId":"9604","sourceWorkId":"16075","spoiler":false},{"segments":[{"spoiler":false,"text":"権轟学園に教育実習生でやってきた大学3年生。"},{"spoiler":false,"text":"小さい頃にテレビで見た学園ドラマに憧れ、教師になることを決めた。"},{"spoiler":false,"text":"成績があまり良いほうではなく、なんとか教育実習までたどり着いたが、行き先が有名な不良校だと知り不安を感じている。"},{"spoiler":false,"text":"教師をしている年上の男性と付き合っている。"},{"spoiler":false,"text":"思い込みが激しく、騙されやすい性格をしている。 押しに弱く、流されやすい。"},{"spoiler":false,"text":"かなりの天然で、周囲にあきれられることも多い。"},{"spoiler":false,"text":"偉人や有名人の “名言” が好きで、会話の途中などに名言を挟もうとする（しかし、いつもどこか使いどころを間違える）。"},{"spoiler":false,"text":"「わ、わたしの授業は……名言とともに始めたいと思っています」"}],"source":"bangumi","sourceCharacterId":"46765"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46765","value":"教育実習生（古文）・大学3年生"},{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"9604","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"9604","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"9604","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"9604","sourceWorkId":"16075","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"9604","sourceWorkId":"16075","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/448374a942f0c449a78a7e8ce823df14fd10e8a1adafce378b7980dacf2db90d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3147ca511d51ec8e1dc5ce378711473c6eeda1e5e58dfbef2eb08178d24200f7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:38691:46765:5907:1","source":"bangumi"}]},{"characterId":"char_vndb_c48576","characterName":"田邊 良行","sourceIds":{"vndbCharacterId":"c48576"},"originalCharacterName":"田邊 良行","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4428155fb7f0429db0616615fb8ff9a73c3c6419cc39d0e7262bbec7dd7119ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69edf4c48d0e791e6ea821acdedefcfa1efa16aae0dda44ea52f2df4ba0f2453.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48577","characterName":"窪塚 康也","sourceIds":{"vndbCharacterId":"c48577"},"originalCharacterName":"窪塚 康也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koya Kubozuka, a third-year student at Gondo Academy. He is the leader of a group of delinquents."},{"spoiler":false,"text":"His parents are art dealers and travel overseas throughout the year."},{"spoiler":false,"text":"He is given a room in an apartment by his permissive parents, and lives a comfortable life every day."},{"spoiler":false,"text":"His daily life is not particularly difficult, but he is not completely satisfied either. He is always looking for something fun or exciting to do with his friends Takumi and Kaname."},{"spoiler":false,"text":"He is not the type to seek leadership, but he always does interesting things, so others follow him."},{"spoiler":false,"text":"He is cunning and skilled at outsmarting others. He is the type who doesn't care whether the person providing fun is male or female."},{"spoiler":false,"text":"Lately, he's been feeling a bit bored, but the appearance of fun-loving people like Nagisa, Aki, and Shiori has him excited. He often comes up with witty metaphors or quotes on the spot."},{"spoiler":false,"text":"His catchphrase is, “Isn't that a great quote?”"},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","source