cterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"瀕死の所を和佳葉に救われた野良犬で、セレスにより一時的に人間の姿を与えられた。"},{"spoiler":false,"text":"犬らしく、命の恩人・和佳葉をご主人様と認め、彼女の言うことは何でも聞く。"},{"spoiler":false,"text":"基本的に自由奔放。じっとできず常にどこかで動き回っている。"},{"spoiler":false,"text":"知識が犬に準じているため、極度の常識はずれ。"},{"spoiler":false,"text":"性的なことに関してもかなりオープンで、恥ずかしいことをしているという意識が薄い。"},{"spoiler":false,"text":"が、その奔放さも魅力のひとつ。"},{"spoiler":false,"text":"和佳葉のことを何より第一に考え、彼女をいろいろな意味で愛している。"},{"spoiler":false,"text":"「天使創造」の際、和佳葉の従者となって彼女をサポートすることになる。"},{"spoiler":false,"text":"運動能力に優れた綾葉と同化することで、和佳葉はその運動能力の恩恵を受ける。"},{"spoiler":false,"text":"＋エッチの間違った知識を教わってしまう。"}],"source":"egs","sourceCharacterId":"21195","sourceWorkId":"8946","spoiler":false},{"segments":[{"spoiler":false,"text":"瀕死の所を和佳葉に救われた野良犬で、セレスにより一時的に人間の姿を与えられた。"},{"spoiler":false,"text":"犬らしく、命の恩人・和佳葉をご主人様と認め、彼女をいろいろな意味で愛している。"},{"spoiler":false,"text":"知識も犬に準じているため極度の常識はずれだが、自由奔放な性格で乗り切っている。"},{"spoiler":false,"text":"性についてもオープンで、和佳葉に間違った性知識を教える張本人でもある。"}],"source":"bangumi","sourceCharacterId":"46649"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0662de9f5232a436beea2d8944b1c842d3d6f5f3c4a334032220b586365b4cb1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c237e54006225334e8f1736dfc9a4d91eb8a3805c7690ede5628b3a4e670fa70.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:193487:46649:4809:1","source":"bangumi"}]},{"characterId":"char_c5099","characterName":"サリエル","sourceIds":{"bangumi":[{"characterId":"46651","match":"exact-normalized-name-in-linked-work","subjectId":"193487"}],"egsCharacterIds":["21189"],"vndbCharacterId":"c5099"},"originalCharacterName":"サリエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現「天使」の長にして、世界の力の均衡を保つ「世界樹」の管理者。"},{"spoiler":false,"text":"そんな立場を思わせない柔和な笑顔が印象的だが、その立振る舞いからは自ずと高貴さが漂っている。"},{"spoiler":false,"text":"過去に一度だけ主人公・祐来と出会っており、その際に彼の潜在能力に気づき、影ながらその生活を見守っていた。"}],"source":"egs","sourceCharacterId":"21189","sourceWorkId":"8946","spoiler":false},{"segments":[{"spoiler":false,"text":"現「天使」の長にして、世界の力の均衡を保つ「世界樹」の管理者。マイペースおっとりお姉様。"},{"spoiler":false,"text":"そんな立場を思わせない柔和な笑顔が印象的だが、その立振る舞いからは自ずと高貴さが漂っている。"},{"spoiler":false,"text":"過去に一度だけ主人公と出会っており、その際に彼の潜在能力に気づき、影ながらその生活を見守っていた。"}],"source":"bangumi","sourceCharacterId":"46651"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a8574cc54f4469c86671ce67f95204afd03b059c26b0e18a485d799346c1a7c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/904fde46108ef06e9eb541679b6a3b69fa805e00eb483ba01a8de06b61771f63.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:193487:46651:6131:1","source":"bangumi"}]},{"characterId":"char_c5100","characterName":"桧寺　雪那","sourceIds":{"bangumi":[{"characterId":"46645","match":"exact-normalized-name-in-linked-work","subjectId":"193487"}],"egsCharacterIds":["21191"],"vndbCharacterId":"c5100"},"originalCharacterName":"桧寺　雪那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"実業家の父を持つ正真正銘のお嬢様で、祐来とは生まれた頃からの幼馴染。"},{"spoiler":false,"text":"素顔は「お嬢様」を演じる、庶民的で茶目っ気のある普通の少女であるが、昔からの負けず嫌い＆勝気な性格が災いして、祐来にはなかなか素直になれない。"},{"spoiler":false,"text":"祐来を古くから慕い続け、秘める想いは妹・和佳葉やナース・志弦よりも熱く激しく強い。"},{"spoiler":false,"text":"彼を想うがゆえ、今回のようなコテージ事業に一同を巻き込んだほど。"},{"spoiler":false,"text":"それは彼女なりの精一杯のアプローチだったが、回りくどすぎて祐来には気づかれなかった。"},{"spoiler":false,"text":"と、そこに「天使創造」の話が舞い込んできた。"},{"spoiler":false,"text":"これはチャンスと思うと同時に、自分と同じ気持ちを持つライバルの存在にも気づく。"},{"spoiler":false,"text":"天使を作り出すため……それを建前に、雪那は自分の気持ちを徐々に解放していく。"}],"source":"egs","sourceCharacterId":"21191","sourceWorkId":"8946","spoiler":false},{"segments":[{"spoiler":false,"text":"実業家の父を持つ正真正銘のお嬢様。"},{"spoiler":false,"text":"主人公とは生まれた頃からの幼馴染で、素顔は「お嬢様」を演じる、庶民的で茶目っ気のある普通の少女である。"},{"spoiler":false,"text":"昔から負けず嫌い＆勝ち気な性格が災いして主人公にはなかなか素直になれない。"},{"spoiler":false,"text":"「天使創造」の話をチャンスと思うと同時に、ライバルの存在にも気づく。"},{"spoiler":false,"text":"世界を救うため……それを建前に、彼女の精一杯のアタックが始まる！"}],"source":"bangumi","sourceCharacterId":"46645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3047572d38aa4372881216d9f628c1bde308357804bf511289f6620d0f302b1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86d0a47da35fc0de60608a1a3ba36915c046e175a50da97279d8dd3b83996508.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:193487:46645:4956:1","source":"bangumi"}]},{"characterId":"char_c5101","characterName":"桜咲　志弦","sourceIds":{"bangumi":[{"characterId":"46647","match":"exact-normalized-name-in-linked-work","subjectId":"193487"}],"egsCharacterIds":["21192"],"vndbCharacterId":"c5101"},"originalCharacterName":"桜咲　志弦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の補佐を務めるトリマーのお姉さん。"},{"spoiler":false,"text":"ナース服が眩しく、同性の雪那たちもうらやむ（目のやり場に困る）プロポーションを持っている。"},{"spoiler":false,"text":"無意識で誘惑＆甘やかしオーラを放出することも……そういう意味では、コテージで最も女性らしい女性である。"},{"spoiler":false,"text":"開業当時から補佐をし、祐来や和佳葉たちとは家族同然のつきあいをしている。"},{"spoiler":false,"text":"昔のことを語らない、少し謎も持っている。"},{"spoiler":false,"text":"仕事では祐来の助手だが、それ以外では母のような役回りをこなす。"},{"spoiler":false,"text":"雪那や和佳葉も良き相談相手として認識しており、内心「かなわない存在」と思うことも。"}],"source":"egs","sourceCharacterId":"21192","sourceWorkId":"8946","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の補佐を務めるお姉さんナース。"},{"spoiler":false,"text":"家族同然のつきあいをしているが、無意識で誘惑＆甘やかしオーラを放出する困った人でもある。"},{"spoiler":false,"text":"雪那や和佳葉の良き相談相手として、母のような役回りをこなす。"}],"source":"bangumi","sourceCharacterId":"46647"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79979565bfb6cca3c37c984e025d57e7efd0c1c2c579c543d798ce8c2d9d5273.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb2952d2522e9ecb808531ddf2d16d1b44c6c4dc894ee77c3a93d79346fab62a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:193487:46647:4918:1","source":"bangumi"}]},{"characterId":"char_c5102","characterName":"神坂　和佳葉","sourceIds":{"bangumi":[{"characterId":"46646","match":"exact-normalized-name-in-linked-work","subjectId":"193487"}],"egsCharacterIds":["21193"],"vndbCharacterId":"c5102"},"originalCharacterName":"神坂　和佳葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おしとやかで兄思い、気配り上手な淑女という理想の性格を持つ少女。"},{"spoiler":false,"text":"今はやや回復しているが、生来身体が弱く、無理をすると倒れるので放っておけない。"},{"spoiler":false,"text":"幼少時に長年の入院生活を余儀なくされた影響か、引っ込み思案で、人付き合いはやや苦手。"},{"spoiler":false,"text":"特に初対面の人物を前にすると、兄・祐来の背中に隠れてしまうのが常である。"},{"spoiler":false,"text":"そんな和佳葉だが、兄のこととなると性格がくるりと変わる。兄のためなら自分の全てを使い、それこそ『どんなこと』でもやろうとしてしまう。そんな妹の暴走を、祐来はヒヤヒヤしながら見守っている。"},{"spoiler":false,"text":"雪那との付き合いも長く、彼女を姉のように慕う。行動力と女性らしさを併せ持つ雪那と、兄に頼りきりの自分を比べ、胸の内では少し劣等感を抱いている。"},{"spoiler":false,"text":"「お兄ちゃんを取られたくない」という想いから『天使創造』に参加した和佳葉。"},{"spoiler":false,"text":"しかし、その憧れは、やがて『女性としての想い』に変質していく。"}],"source":"egs","sourceCharacterId":"21193","sourceWorkId":"8946","spoiler":false},{"segments":[{"spoiler":false,"text":"おしとやかで兄思いな妹。"},{"spoiler":false,"text":"「気配り上手な淑女」という理想の性格を持っている。"},{"spoiler":false,"text":"生来身体が弱く、無理をすると倒れるので放っておけない。"},{"spoiler":false,"text":"幼少時に長年の入院生活を余儀なくされた影響か、引っ込み思案で、人付き合いはやや苦手。"},{"spoiler":false,"text":"「兄さんを取られたくない」という想いから『天使創造の儀式』を望む。"},{"spoiler":false,"text":"しかしその憧れは、やがて『女性としての想い』に変質していく。"}],"source":"bangumi","sourceCharacterId":"46646"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1145dbc3a59073eec6a4796831af5fabc7d52a03b9fa1e6429217e8ee87ea61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38cd07bb9c24275bfd06cd08a664dc9f592451dd3ab232ed997e24368dedf899.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:193487:46646:6409:1","source":"bangumi"}]},{"characterId":"char_c5108","characterName":"乃々華","sourceIds":{"bangumi":[{"characterId":"46648","match":"exact-normalized-name-in-linked-work","subjectId":"193487"}],"egsCharacterIds":["21194"],"vndbCharacterId":"c5108"},"originalCharacterName":"乃々華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Setsuna's pet cat that was given human form by Seles."}],"source":"vndb","sourceCharacterId":"c5108"},{"segments":[{"spoiler":false,"text":"雪那の飼い猫だったが、「天使創造」の管理者・セレスによって人間の姿を与えられた。"},{"spoiler":false,"text":"箱入りの座敷猫で外出の経験もほとんどなく、かなり臆病で世間知らず。"},{"spoiler":false,"text":"疑うことを知らないため、不要なトラブルに巻き込まれることもしばしば。"},{"spoiler":false,"text":"不測の事態に遭遇するとパニックに陥り、暴走するという危ない部分も持っている。"},{"spoiler":false,"text":"性的なことについては極度のウブで、男性経験（男ネコ経験？）はまったくの皆無。"},{"spoiler":false,"text":"しかし興味津々で、戸惑いながらも逃げることはしない。"},{"spoiler":false,"text":"人間化した後は、雪那の従者として力を貸すことになる。"},{"spoiler":false,"text":"雪那は乃々華と同化することで、彼女の能力の恩恵を受けることができる。"},{"spoiler":false,"text":"（乃々華の能力は、天使の力の行使。術という概念で展開されるそれを、雪那は自由に操ることができるようになる）"},{"spoiler":false,"text":"雪那の良き理解者で、祐来としては頼りになる相談相手となる。"}],"source":"egs","sourceCharacterId":"21194","sourceWorkId":"8946","spoiler":false},{"segments":[{"spoiler":false,"text":"雪那の飼い猫だったが、「天使創造」の管理者・セレスによって人間の姿を与えられた。"},{"spoiler":false,"text":"箱入りの座敷猫のため、かなり臆病で世間知らず。"},{"spoiler":false,"text":"性的なことについては極度のウブだが、実は興味津々で逃げることはしない。"},{"spoiler":false,"text":"人間化した後は、雪那の従者として力を貸すことになる。"}],"source":"bangumi","sourceCharacterId":"46648"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a8cad9c617bb5acaec31317a0a73e9075872a1d4854cb06a0061e90c7cc7237.webp","fallbackUrl":"https://wiki-assets.bishojo.date/t