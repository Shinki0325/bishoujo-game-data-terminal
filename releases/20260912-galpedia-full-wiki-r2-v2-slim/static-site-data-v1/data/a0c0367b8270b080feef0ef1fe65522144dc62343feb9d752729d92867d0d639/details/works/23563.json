bCharacterId":"c50422"},"originalCharacterName":"箒木 日向子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hinako is the character whose viewpoint you receive first, being harassed by her superior at work after she fails her assignment for the second time. Having just graduated from high school, she thought she could become independent by working, but soon realizes that her skills in the office are abysmal and eventually finds herself settling into a routine of simply riding the subway just to emulate her \"going to work\" until hearing about the Tryment Program from a senior."},{"spoiler":false,"text":"She is also roommates with Mhlia."},{"spoiler":false,"text":"From Visual Novels and Eroge Review"}],"source":"vndb","sourceCharacterId":"c50422"},{"segments":[{"spoiler":false,"text":"過去に大きな失敗をし、失意の中に暮らしていた女の子。"},{"spoiler":false,"text":"今までの生き方を変えるきっかけが欲しくて、学園へとやってきた。"},{"spoiler":false,"text":"ほんわかとした印象ながら、胸に秘めた思いは人一倍強い。"},{"spoiler":false,"text":"B級グルメ好き。"}],"source":"egs","sourceCharacterId":"10556","sourceWorkId":"23563","spoiler":false},{"segments":[{"spoiler":false,"text":"過去に大きな失敗をし、失意の中に暮らす女の子。"},{"spoiler":false,"text":"今までの生き方を変えるきっかけが欲しくて学園へとやってきた。"},{"spoiler":false,"text":"ほんわかとした印象ながら、胸に秘めた思いは人一倍強い。"},{"spoiler":false,"text":"B級グルメ好き。"},{"spoiler":false,"text":"「あわわわ、ごめん、なんか私すっごいポエミーなこと言ったよね。 チラシの裏にでも書いとけって話だよね」"}],"source":"bangumi","sourceCharacterId":"43696"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67e418260157926ba27d0b8f2358e7eed773cd983026bc1a1706505be71c2f50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e8e06f90798c154a38f347157905d98c32f7f3