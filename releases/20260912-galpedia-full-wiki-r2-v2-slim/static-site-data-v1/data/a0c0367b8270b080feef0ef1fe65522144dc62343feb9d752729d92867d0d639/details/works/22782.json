tatus":"source-native","relationId":"vndb:vn-staff:43665","source":"vndb"},{"creditedName":"霧生院 吏紗","creatorId":"vndb:s31133","sourcePersonId":"vndb:s31133","canonicalEntityId":"vndb:s31133","name":"霧生院 吏紗","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:43666","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c21378","characterName":"日向 要","sourceIds":{"vndbCharacterId":"c21378"},"originalCharacterName":"日向 要","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"820"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaname is a handyman at Shintoku. Though he actually passed the Shintoku entrance exams with top marks, due to financial problems he was unable to attend, so he took a job there as a handyman until he could save up enough money to finance his own education. He studies in private with Tsukimura in his free time. He is a very friendly and cheerful person, who loves plants and animals. Because of his effeminate character, he is disliked by some of the students at Shintoku, and because he hates violence, he has a hard time standing up for himself."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c21378"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c7e56bc35bcb19bdc0980147ad0f89ce2079f3404f307d51b60b76ca9940624.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8574612ce829c59ea0f08b2951f597c246f2b9a2487beb0bafaf4fe7d2e5abb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千葉 進歩","creatorId":"vndb:s400","sourcePersonId":"vndb:s400","canonicalEntityId":"vndb:s400","name":"千葉進歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24000","source":"vndb"}]},{"characterId":"char_vndb_c21379","characterName":"木下 真弓","sourceIds":{"vndbCharacterId":"c21379"},"originalCharacterName":"木下 真弓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"918"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mayumi, a first year student at Shintoku, is a seemingly obedient boy who is usually seen quietly standing in Azusa's shadow. His parents died in a boating accident when he was young, and he was raised by Azusa's parents, who were friends with parents, and he grew up beside Azusa and his older sister Ayumi. He has a dark past associated with growing up in the Hiura household, and his relationship with his childhood friend Azusa is a complex one that seems to mix envy, hatred, and yearning."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c21379"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0764a8f3eeba97c299a4184dab185db2bb291a5e4fd1ee9d3670c8cc18bc212.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bafe120dcfdece294a4808a5668e90ed4f4731d54e229b062cc980070faa025.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梯 篤司","creatorId":"vndb:s734","sourcePersonId":"vndb:s734","canonicalEntityId":"vndb:s734","name":"梯篤司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24001","source":"vndb"}]},{"characterId":"char_vndb_c21381","characterName":"火浦 あずさ","sourceIds":{"vndbCharacterId":"c21381"},"originalCharacterName":"火浦 あずさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"627"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Azusa is a first year student at Shintoku who is popular for his good looks, even attracting the admiration of two upperclassmen who act as his bodyguards. He is also typically in the company of Kinoshita Mayumi, who is usually seen quietly following Azusa around and carrying his things for him. Though Azusa appears as a cheerful and personable person on the outside, he is actually fastidious, haughty, and when he dislikes someone, he hates them from the bottom of his heart. He is also very gullible and often believes in other's superficial appearances, never thinking that they may also be two-sided like he is, giving him a sort of childish innocence to his personality. He idolizes Kaneko Mitsunobu, his upperclassman, and tries to find excuses to be around him."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c21381"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a69e4ca44e402667569a97804a20b85310ba71b000d79fc433b0430fc54b131.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c595e3afe8a7a5c33f4e2a4b6c58ea1b07268af6b514972664a9806b9ecf894.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 勇","creatorId":"vndb:s1681","sourcePersonId":"vndb:s1681","canonicalEntityId":"vndb:s1681","name":"佐藤 勇","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24002","source":"vndb"}]},{"characterId":"char_vndb_c21382","characterName":"水川 抱月","sourceIds":{"vndbCharacterId":"c21382"},"originalCharacterName":"水川 抱月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1016"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hougetsu first introduces himself to Kaname as the \"Hanakuihidori,\" but he is a very strange person who goes by many names. He is of mixed Japanese and British blood, and is an author of detective novels (\"Mizukawa Hougetsu\" is the penname he uses on his literary works). Though he does not work for Shintoku, he is often found hanging around in the school garden beneath the rose tree, while procrastinating on his writing. He attended Shintoku back when he was in high school, and was classmates with Tsukimura at that time, so he knows much concerning Tsukimura's elusive past."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c21382"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/825ae481a9e739ffef1662056984bff46b16b4dad8a8c4da817603abe504ea2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd00417fbadab913ede99a62bc6d4c6f7208cbd6225b7292305353c86d77d265.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森川 智之","creatorId":"vndb:s53","sourcePersonId":"vndb:s53","canonicalEntityId":"vndb:s53","name":"森川智之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23997","source":"vndb"}]},{"characterId":"char_vndb_c21383","characterName":"金子 光伸","sourceIds":{"vndbCharacterId":"c21383"},"originalCharacterName":"金子 光伸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1210"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mitsunobu is from a distinguished family of viscounts, and his father is a member of the House of Lords with the Diet. A second-year student who appears to be a top student and a gleaming example with a prominent future ahead of him, his true nature is very different: he ditches class whenever he gets a chance, and he slips out of the dormitory every night to indulge in the clubs of the redlight district. He is adored by Azusa, who only sees the \"honor student\" side of him and isn't aware of his true nature. He is also a huge fan of Mizukawa Hougetsu's novels."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c21383"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3c70e7f1be317d833e053909dd14ac2fc50f5ea9570e66beb4362acbc90ae4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fab6a4676a7dc667fafaaa63bc669290f2becff082089aae73081a9faf00cda5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川田 紳司","creatorId":"vndb:s255","sourcePersonId":"vndb:s255","canonicalEntityId":"vndb:s255","name":"川田紳司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23998","source":"vndb"}]},{"characterId":"char_vndb_c21385","characterName":"土田 憲実","sourceIds":{"vndbCharacterId":"c21385"},"originalCharacterName":"土田 憲実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"509"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Norizane is the second son in a large family that descended from samurai. He is a second year student at Shintoku and an expert at kendo, and after graduation plans to go to the naval forces academy. He is a very quiet person with little expression, but truly is an honest person with a strong sense of justice. He is one of the few people at Shintoku who is kind to Kaname, and he often worries about Kaname's present state."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c21385"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0caf68de422626ef700b716dbbfb5702833dac2793dd97794e4a95052505f58c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45d774864c289498bf6fcf4696e8ecc87ade87d919612920d80718574ac17acc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天田 真人","creatorId":"vndb:s1680","sourcePersonId":"vndb:s1680","canonicalEntityId":"vndb:s1680","name":"四反田マイケル(天田真人)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24003","source":"vndb"}]},{"characterId":"char_vndb_c21388","characterName":"月村 幹彦","sourceIds":{"vndbCharacterId":"c21388"},"originalCharacterName":"月村 幹彦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1104"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mikihiko is the biology teacher at Shintoku, and is in charge of the student dormitory, living on campus. Mikihiko is a rational person who rarely shows emotion, and has few relations with others. The exception is Kaname, who he is very kind to, and takes extra time to tutor and visit with in his free time. He receives a photograph of Kaname's violation from Hanakuihidori, and becomes Kaname's ally in searching for the criminal. Little is known about Mikihiko's past; he does not lie, but apparently keeps many secrets."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c21388"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b850b290b36398446bab5ec76e5ea21bc8fc5496c43b866dea3f703a1948d72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac493bacaecfcaaff40d10608a9d6d9390b0900b41413567027e7563119c5937.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一条 和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23999","source":"vndb"}]},{"characterId":"char_vndb_c27685","c