{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"31131","model":{"presentationWorkId":"vndb:v31333","staff":{"artwork":[{"creditedName":"T-28","creatorId":"vndb:s4809","sourcePersonId":"egs:creator:14160","canonicalEntityId":"vndb:s4809","name":"T-28","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:235740","source":"egs"}],"scenario":[{"creditedName":"狩野景","creatorId":"vndb:s8183","sourcePersonId":"egs:creator:17947","canonicalEntityId":"vndb:s8183","name":"狩野景","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:235739","source":"egs"}],"music":[],"other":[{"creditedName":"Barry Bee","creatorId":"vndb:s27727","sourcePersonId":"vndb:s27727","canonicalEntityId":"vndb:s27727","name":"Barry B. Benson","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:175356","source":"vndb"}]},"cast":[{"characterId":"char_c97821","characterName":"ベリス","sourceIds":{"bangumi":[{"characterId":"97214","match":"exact-normalized-name-in-linked-work","subjectId":"339051"}],"egsCharacterIds":["23486"],"vndbCharacterId":"c97821"},"originalCharacterName":"ベリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An evil female executive. She has a mysterious but cool and harsh personality."},{"spoiler":false,"text":"At first glance, she looks intriguing, but as a woman, she is the type you don't want to get close to."},{"spoiler":false,"text":"She is capable, but she is hard on herself and others, and looks down upon weaklings."},{"spoiler":false,"text":"Her daily life is tasteless, unfeminine, and lame."},{"spoiler":false,"text":"She cooks her own food, but only simple food. She can do housework, but it is limited to simple things."}],"source":"vndb","sourceCharacterId":"c97821"},{"segments":[{"spoiler":false,"text":"悪の女幹部。妖艶だがクールでキツい性格。ぱっと見そそられるが女としては近づきたくないタイプ。有能だが自分にも他人も厳しくけむたがられる。"},{"spoiler":false,"text":"普段の生活は味気ない、女っ気ない行き遅れ干物女。"},{"spoiler":false,"text":"家事もできるが必要最低限、料理も栄養のことなどを効率的に考える、という側面から自炊。ただし簡単なものに限る。"}],"source":"egs","sourceCharacterId":"23486","sourceWorkId":"31131","spoiler":false},{"segments":[{"spoiler":false,"text":"悪の女幹部。妖艶だがクールでキツい性格。"},{"spoiler":false,"text":"ぱっと見そそられるが女としては近づきたくないタイプ。"},{"spoiler":false,"text":"有能だが自分にも他人も厳しくけむたがられる。"},{"spoiler":false,"text":"普段の生活は味気ない、女っ気ない行き遅れ干物女。"},{"spoiler":false,"text":"家事もできるが必要最低限、料理も栄養のことなどを効率的に考える、"},{"spoiler":false,"text":"という側面から自炊。ただし簡単なものに限る。"}],"source":"bangumi","sourceCharacterId":"97214"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d91fa6d43c08ce1666f2bb428ec6e67d471460baa670332d7f7d6c120093860e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01c42aabf9cc70eb5e4f7de4f530d05325dce77e587023e2ef3667ba914acf63.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波野夏花","creatorId":"vndb:s3225","sourcePersonId":"vndb:s3225","canonicalEntityId":"vndb:s3225","name":"波野夏花(夏花)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:339051:97214:16169:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p918","sourceCompanyId":"egs:brand:2797","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31131:2797","source":"egs"},{"companyId":"vndb:p7324","sourceCompanyId":"vndb:p7324","canonicalEntityId":"vndb:p7324","name":"Cherry Kiss Games","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-prod