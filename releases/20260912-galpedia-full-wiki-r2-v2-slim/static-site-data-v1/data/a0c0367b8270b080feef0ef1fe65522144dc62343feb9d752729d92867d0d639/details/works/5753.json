{"segments":[{"spoiler":false,"text":"He is an old man who is the founder of KOKON. While he is leading an organization that is willing to conduct inhumane research, he himself is a good person."},{"spoiler":true,"text":"He has the power to see “something” in others that ordinary people cannot see, and in order to find out the meaning of this power, he gathered those who have that “something” and created the KOKON."}],"source":"vndb","sourceCharacterId":"c12765"},{"segments":[{"spoiler":false,"text":"予言的で人の心を見透かしたような発言をするカリスマ的人物。"},{"spoiler":false,"text":"『古痕』の創設者として、組織内に暗然とした影響力を持っている。"}],"source":"egs","sourceCharacterId":"16128","sourceWorkId":"2138","spoiler":false},{"segments":[{"spoiler":false,"text":"予言的で人の心を見透かしたような発言をするカリスマ的人物。"},{"spoiler":false,"text":"『古痕』の創設者として、組織内に暗然とした影響力を持っている。"},{"spoiler":false,"text":"「“経験に勝る信仰なし”と言うやつだ」"}],"source":"bangumi","sourceCharacterId":"50658"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/965a64ea0df7318b771d6a8e6bfc6b57c946a6c641b45ef6d7c06d1876e157f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a21458f40ab4559f2e5d69b20fffdabdff03d303630b39ed97f69fb3d8c6bf1.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清川元夢","creatorId":"vndb:s4851","sourcePersonId":"vndb:s4851","canonicalEntityId":"vndb:s4851","name":"清川元夢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7977:50658:3915:1","source":"bangumi"}]},{"characterId":"char_c12766","characterName":"荒山 鳥人","sourceIds":{"bangumi":[{"characterId":"50655","match":"exact-normalized-name-in-linked-work","subjectId":"7977"}],"egsCharacterIds":["16129"],"vndbCharacterId":"c12766"},"originalCharacterName":"荒山 鳥人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"s