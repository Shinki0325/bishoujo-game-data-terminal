Code":"vocalist","roleLabel":"歌手","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:230448","source":"egs"},{"creditedName":"milktub","creatorId":"vndb:s465","sourcePersonId":"vndb:s465","canonicalEntityId":"vndb:s465","name":"milktub","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:164555","source":"vndb"},{"creditedName":"AiRI","creatorId":"vndb:s1485","sourcePersonId":"vndb:s1485","canonicalEntityId":"vndb:s1485","name":"AiRI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:164556","source":"vndb"},{"creditedName":"どせい","creatorId":"vndb:s4161","sourcePersonId":"vndb:s4161","canonicalEntityId":"vndb:s4161","name":"どせい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:164558","source":"vndb"},{"creditedName":"赤月 ゆむ","creatorId":"vndb:s8643","sourcePersonId":"vndb:s8643","canonicalEntityId":"vndb:s8643","name":"赤月 ゆむ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:164561","source":"vndb"}]},"cast":[{"characterId":"char_c88413","characterName":"スカーレット","sourceIds":{"bangumi":[{"characterId":"77028","match":"exact-normalized-name-in-linked-work","subjectId":"298631"}],"egsCharacterIds":["22750"],"vndbCharacterId":"c88413"},"originalCharacterName":"スカーレット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"振り回されがちな、委員長属性の勇者。"},{"spoiler":false,"text":"オタク文化に理解はあるが、パーティーの仲間と違って創作面の才能を持たないことに悩む。"}],"source":"egs","sourceCharacterId":"22750","sourceWorkId":"29166","spoiler":false},{"segments":[{"spoiler":false,"text":"パーティーのなかでは振り回される委員長属性。"},{"spoiler":false,"text":"オタク文化のよき理解者であると同時に自分には才能がないと痛感する可愛そうポジション。"},{"spoiler":false,"text":"だれよりも、文化（作品性や隠れたテーマ）を理解するがそれを表現する能力を持たず、"},{"spoiler":false,"text":"他のヒロイン達がつぎつぎに主人公に才能を見出されることに戦慄を覚えるとともに、"},{"spoiler":false,"text":"この平和な世界に自分の居場所がないのでは？と不安になる。"},{"spoiler":false,"text":"しかし主人公ともっとも近しい感性の持ち主であるため、"},{"spoiler":false,"text":"オタクにとって一番大事なのは理解者であり語り合える仲間だ！と気づかされていく。"},{"spoiler":false,"text":"子供にまじって主人公が広めたカードゲームで遊んだり、"},{"spoiler":false,"text":"新しく生まれた魔法とスポーツの融合したバトルスポーツをたのしんだりと積極的に新しいものを受け入れる。"},{"spoiler":false,"text":"「えっ？ 新作描きあがったの?! なになに、見たい見たい！」"}],"source":"bangumi","sourceCharacterId":"77028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d51c9f766df1982bb577f036417c0d397ab9e3364e926dda68f80a6f039088b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/217cc86b23c56901d0c1c3333d4880ceb175c5d529ca10279143067151bb79c9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298631:77028:6351:1","source":"bangumi"}]},{"characterId":"char_c88414","characterName":"スノウ","sourceIds":{"bangumi":[{"characterId":"77031","match":"exact-normalized-name-in-linked-work","subjectId":"298631"}],"egsCharacterIds":["22753"],"vndbCharacterId":"c88414"},"originalCharacterName":"スノウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オタク文化から世界の発展を見出す頭脳派。漫画で道徳心や向上心を広める教育を提唱し、漫画家として日夜間違った方向に努力する。"}],"source":"egs","sourceCharacterId":"22753","sourceWorkId":"29166","spoiler":false},{"segments":[{"spoiler":false,"text":"クール系知的少女。"},{"spoiler":false,"text":"オタク文化から世界の発展を見出す頭脳派。"},{"spoiler":false,"text":"主人公の部屋にあった辞書を片手に、"},{"spoiler":false,"text":"漫画や雑誌などを日本語から異世界語への翻訳を率先して行うなど知識欲が旺盛。"},{"spoiler":false,"text":"主人公を知識と知恵の体現者として崇めるともにもっともっととせがむ欲張りさん。"},{"spoiler":false,"text":"漫画による教育という概念に着目し道徳心や向上心などを広めることに腐心する。"},{"spoiler":false,"text":"自らも漫画家として日夜間違った方向に努力して行く……"},{"spoiler":false,"text":"「これが、天上の書物!? 私たちの世界は1000年じゃ追いつけない！」"}],"source":"bangumi","sourceCharacterId":"77031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d1709c39ea31f9fb70576b080ca8613e6a598a51db16d3d126081c926e66ab7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb3ac3ff2128f937d590d06075749cf734765eecdb3cb64222d6f2e09bedc153.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野々原 まどか","creatorId":"vndb:s9112","sourcePersonId":"vndb:s9112","canonicalEntityId":"vndb:s9112","name":"野々原まどか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84013","source":"vndb"}]},{"characterId":"char_c88415","characterName":"フリージア","sourceIds":{"bangumi":[{"characterId":"77030","match":"exact-normalized-name-in-linked-work","subjectId":"298631"}],"egsCharacterIds":["22752"],"vndbCharacterId":"c88415"},"originalCharacterName":"フリージア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"勇者パーティーの吟遊詩人で、自由奔放な快楽主義者。"},{"spoiler":false,"text":"アイドルアニメにハマって以来、歌の力ででオタク文化布教に貢献する。"}],"source":"egs","sourceCharacterId":"22752","sourceWorkId":"29166","spoiler":false},{"segments":[{"spoiler":false,"text":"吟遊詩人で弓使い。自由奔放で無責任な快楽主義者。"},{"spoiler":false,"text":"どうにでもなる、どうとでもなれの精神で邁進していくムードメーカー兼トラブルメーカー。"},{"spoiler":false,"text":"SFアイドルアニメにドハマりし、歌のチカラで世界を平和に！をテーマに日夜主人公とアイドル活動にあけくれる。"},{"spoiler":false,"text":"コーマーシャルとしての歌とアイドルのコラボレーションにより、"},{"spoiler":false,"text":"異世界に主人公と開発した新商品や文化を洗脳――もといメディアミックスで伝播していく文化の体現者的存在。"},{"spoiler":false,"text":"「私の歌で戦いを終わらせてみせるから！ キリッ！」"}],"source":"bangumi","sourceCharacterId":"77030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37e2b79bfb1a571c9f2087f3e6366b1b6385e929279afffc248f3068cee5ecce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5abc7d18d6a5d9f8235ec684b829d83783d4c9ec88e8a40246caf8b2b35c84f7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤月ゆむ","creatorId":"vndb:s8643","sourcePersonId":"vndb:s8643","canonicalEntityId":"vndb:s8643","name":"赤月 ゆむ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298631:77030:28581:1","source":"bangumi"}]},{"characterId":"char_c88416","characterName":"サファイア","sourceIds":{"bangumi":[{"characterId":"77029","match":"exact-normalized-name-in-linked-work","subjectId":"298631"}],"egsCharacterIds":["22751"],"vndbCharacterId":"c88416"},"originalCharacterName":"サファイア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A royal family daughter who is curious about cosplay culture and is a priestess selected by the goddess."},{"spoiler":false,"text":"She is a girl who believes that it is her destiny to give birth to a child of the hero who is the apostle of the goddess."},{"spoiler":false,"text":"From the moment she meets the hero, she is in a state of immediate fall and takes care of the hero who is not familiar with this world."},{"spoiler":false,"text":"She puts her life into spreading the AKIBA culture of the main character and builds her huge fortune by spreading fashion to her aristocrats,"},{"spoiler":false,"text":"She's just worried that she doesn't have enough money to be a nerd"},{"spoiler":false,"text":"\"You are my destined person! I will be pregnant soon, so please leave it to me.\""}],"source":"vndb","sourceCharacterId":"c88416"},{"segments":[{"spoiler":false,"text":"コスプレに深い興味を持つ王族。"},{"spoiler":false,"text":"女神の使徒たる主人公の子を産むことを天命と信じつつ、貴族や教会のコネでオタク文化布教に励む。"}],"source":"egs","sourceCharacterId":"22751","sourceWorkId":"29166","spoiler":false},{"segments":[{"spoiler":false,"text":"振り回す学生会会長属性。"},{"spoiler":false,"text":"王族で女神の敬謙な信者である彼女は勇者と結婚するのが運命だと幼少の頃から思ってきた。"},{"spoiler":false,"text":"しかし勇者が女だったため、その夢も破れたものの勇者のよき理解者として共に魔王を滅ぼすたびをしている。"},{"spoiler":false,"text":"そんなおり、女神よりの使途が使わされ彼の子を産むことこそが天命であると信じて疑わない彼女。"},{"spoiler":false,"text":"教会や貴族たちに深いコネクションをもっているため、主人公の文化を広めることに率先して協力。"},{"spoiler":false,"text":"貴族たちを巻き込んでサロンで女貴族達とコスプレイベントを開いたりする。"},{"spoiler":false,"text":"主人公の夢にじゃまな貴族を追い詰めたり謀略を繰り返したりと主人公を妄信するあまり腹黒姫を地でいく面も。"},{"spoiler":false,"text":"「あなたが、わたしの運命の人ですね！ すぐに孕みますからおまかせください」"}],"source":"bangumi","sourceCharacterId":"77029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/718d5ebf055d083caecf2b7872a13cfbfbbc773cd67deb1d309b06f8c052b280.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab44b4106d32a3e86b11aff91337fa54cc6ec48a2a777b58deec28a5927f810c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298631:77029:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","rela