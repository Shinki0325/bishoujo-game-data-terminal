essive!"},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c2014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3c028d0527a4728774e432ae9f5c73d8fba8c83f4aabdb33af72ca3dfecb77f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/121b35d7db47d8b54d28efeeb895a424cc606aef2d66ee1e9a3ed7a57f14525d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日向 裕羅","creatorId":"vndb:s562","sourcePersonId":"vndb:s562","canonicalEntityId":"vndb:s562","name":"日向 裕羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1347","source":"vndb"}]},{"characterId":"char_vndb_c2015","characterName":"結城 こばと","sourceIds":{"vndbCharacterId":"c2015"},"originalCharacterName":"結城 こばと","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Yuuki family's youngest. She has no idea what to do with her life, but she puts her heart into the restaurant for now. She is very childish and loves to play games."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c2015"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/308eb206e578724fca2245031d8f055462ac5a3e6b853e5128432e535a50a491.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37769cfbab35ef1ef213e356ce5fa449ac68a294c5aae1912b9344c0377d4538.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 向日葵","creatorId":"vndb:s855","sourcePersonId":"vndb:s855","canonicalEntityId":"vndb:s855","name":"瀬那 歩美","roleCode":"voice-ac