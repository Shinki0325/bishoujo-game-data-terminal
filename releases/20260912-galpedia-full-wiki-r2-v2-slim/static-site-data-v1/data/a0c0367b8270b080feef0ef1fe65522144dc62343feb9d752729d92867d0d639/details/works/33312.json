","sourcePersonId":"vndb:s53358","canonicalEntityId":"vndb:s53358","name":"雷電","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:189166","source":"vndb"},{"creditedName":"粋筆堂","creatorId":"vndb:s53360","sourcePersonId":"vndb:s53360","canonicalEntityId":"vndb:s53360","name":"粋筆堂","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:189167","source":"vndb"}]},"cast":[{"characterId":"char_c116150","characterName":"河内 陽太","sourceIds":{"bangumi":[],"egsCharacterIds":["24318"],"vndbCharacterId":"c116150"},"originalCharacterName":"河内 陽太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公で、詩織の息子。九曜学園に通う学生。"},{"spoiler":false,"text":"仕事第一主義で家を留守にしてばかりの父親に反感を持っている。一方で父に代わって留守を預かり、自分の面倒を見てくれている母、詩織のことを尊敬し慕っている。"},{"spoiler":false,"text":"とはいえ、甘えたがりのマザコンというわけでなく、自分に出来ることは全てやり、家事手伝いも積極的に手伝っている。"},{"spoiler":false,"text":"気丈に振る舞っている母、詩織が本音では寂しい思いをしていることを知っていて、バスケ部に入部し、帰宅する時間が今までよりも遅くなったことを気に病んでいる。"}],"source":"egs","sourceCharacterId":"24318","sourceWorkId":"33312","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"178 cm","valueContext":null,"source":"egs","sourceCharacterId":"24318","sourceWorkId":"33312","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c116320","characterName":"河内 詩織","sourceIds":{"bangumi":[{"characterId":"121737","match":"exact-normalized-name-in-linked-work","subjectId":"404003"}],"egsCharacterIds":["24317"],"vndbCharacterId":"c116320"},"originalCharacterName":"河内 詩織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"105"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"101"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"専業主婦で主人公の母。"},{"spoiler":false,"text":"控えめで大人しい性格だが、芯が通った女性で、仕事第一で留守がちの夫に代わり、自宅を守り、ひとり息子である主人公の面倒を見ている。"},{"spoiler":false,"text":"夫は半年ほどという約束で海外に長期出張に出かけており、家や一人息子である主人公の面倒をすべて妻である詩織に押し付けている。"},{"spoiler":false,"text":"家庭を顧みず、自分の相手もろくにしてくれない夫に不満を抱いているが、しっかり者ゆえに、不満を口にすることはない。"},{"spoiler":false,"text":"しっかり者である息子、陽太との親子関係は良好で、詩織もひとり息子である陽太のことを可愛がっている。"},{"spoiler":false,"text":"人には言えないが元来、性欲が強く、子供も３人は欲しいと思っていた。しかし、夫は一人息子……主人公が産まれただけで満足し、妊活どころかセックスレスになってしまった。"},{"spoiler":false,"text":"以後、長年にわたって熟れた身体を持て余し、夫と主人公がいない日中に自慰行為を繰り返し、自分を慰めている。"},{"spoiler":false,"text":"１０５ｃｍのＨカップという爆乳に、１０１ｃｍオーバーのデカ尻と、女性として極めて恵まれたスタイルをしている。見た目も年齢よりも若々しく、初見の人に主人公と姉弟に間違われることもあるほど。"},{"spoiler":false,"text":"性感帯が多く、とても感じやすい体質で性欲も強い。しかし詩織本人はいやらしい、はしたないと思い、コンプレックスを感じている。"}],"source":"egs","sourceCharacterId":"24317","sourceWorkId":"33312","spoiler":false},{"segments":[{"spoiler":false,"text":"専業主婦で主人公の母。"},{"spoiler":false,"text":"控えめで大人しい性格だが、芯が通った女性で、仕事第一で留守がちの夫に代わり、自宅を守り、ひとり息子である主人公の面倒を見ている。"},{"spoiler":false,"text":"夫は半年ほどという約束で海外に長期出張に出かけており、家や一人息子である主人公の面倒をすべて妻である詩織に押し付けている。"},{"spoiler":false,"text":"家庭を顧みず、自分の相手もろくにしてくれない夫に不満を抱いているが、しっかり者ゆえに、不満を口にすることはない。"},{"spoiler":false,"text":"しっかり者である息子、陽太との親子関係は良好で、詩織もひとり息子である陽太のことを可愛がっている。"},{"spoiler":false,"text":"人には言えないが元来、性欲が強く、子供も3人は欲しいと思っていた。"},{"spoiler":false,"text":"しかし、夫は一人息子……主人公が産まれただけで満足し、妊活どころかセックスレスになってしまった。"},{"spoiler":false,"text":"以後、長年にわたって熟れた身体を持て余し、夫と主人公がいない日中に自慰行為を繰り返し、自分を慰めている。"},{"spoiler":false,"text":"105cmのHカップという爆乳に、101cmオーバーのデカ尻と、女性として極めて恵まれたスタイルをしている。"},{"spoiler":false,"text":"見た目も年齢よりも若々しく、初見の人に主人公と姉弟に間違われることもあるほど。"},{"spoiler":false,"text":"性感帯が多く、とても感じやすい体質で性欲も強い。しかし詩織本人はいやらしい、はしたないと思い、コンプレックスを感じている。"}],"source":"bangumi","sourceCharacterId":"121737"}],"profileFacts":[{"label":"年龄（本版本）","value":"39 岁","valueContext":null,"source":"egs","sourceCharacterId":"24317","sourceWorkId":"33312","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"105 cm","valueContext":null,"source":"egs","sourceCharacterId":"24317","sourceWorkId":"33312","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"24317","sourceWorkId":"33312","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"24317","sourceWorkId":"33312","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"101 cm","valueContext":null,"source":"egs","sourceCharacterId":"24317","sourceWorkId":"33312","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"24317","sourceWorkId":"33312","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0424484eece13290dbf047b675c7cb236d7f2ff656aa491a52205602204cca72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b5b244984740935477001b0687b530c15b2f6207759a5ed5cf91ee27d5d1e5e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:404003:121737:5928:1","source":"bangumi"}]},{"characterId":"char_c132302","characterName":"逆潮 政夫","sourceIds":{"bangumi":[],"egsCharacterIds":["24319"],"vndbCharacterId":"c132302"},"originalCharacterName":"逆潮 政夫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"詩織の大学時代の恩師。既婚者で息子が二人いる。"},{"spoiler":false,"text":"詩織が大学生だった頃、自分の講義を受けていた詩織の美貌と豊満な身体に目を付け、あからさまにえこひいきし、学生だった詩織を「面倒見の良い先生」として支えていた。"},{"spoiler":false,"text":"自分を慕う詩織に、隙あらば肉体関係を結ぼうと下心を抱いていたが、次男の受験問題で妻との関係が悪化し、あまり大胆な行動に出ることが出来なかった。"},{"spoiler":false,"text":"そんな事情から獲物だった詩織を捉えることなく、彼女の卒業を見送ってしまい悔しさを滲ませたが、神の導きのように結婚した詩織と再開。"},{"spoiler":false,"text":"冷えてしまった夫婦の関係に思い悩む詩織に対して、かつてのように「面倒見の良い先生」として相談に乗ることで、詩織の心の隙をつき、女性の魅力に溢れた身体をモノにしよう画策する。"}],"source":"egs","sourceCharacterId":"24319","sourceWorkId":"33312","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"62 岁","valueContext":null,"source":"egs","sourceCharacterId":"24319","sourceWorkId":"33312","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"24319","sourceWorkId":"33312","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b038704f0fb79004671139d70738e4434b1c028ff1b82b4930520d4da330d808.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/007b3e6120d50238b19d8d0a35e6c357c999df5e0d0bfe1d8c78aef13578fe70.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c132303","characterName":"逆潮 政文","sourceIds":{"bangumi":[],"egsCharacterIds":["24320"],"vndbCharacterId":"c132303"},"originalCharacterName":"逆潮 政文","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"35"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"政夫の次男。"},{"spoiler":false,"text":"大学受験に失敗して以来、頑張ることをやめ、３５歳になる今も引きこもり気味で特定の職にも就いていない。"},{"spoiler":false,"text":"子供の頃から優秀な兄と比べられ続けてきたせいか、とても卑屈な性格をしている。"},{"spoiler":false,"text":"仮性包茎であることを気にして、女性には消極的。これまで一度も女性と付き合ったことはなく、童貞である。"}],"source":"egs","sourceCharacterId":"24320","sourceWorkId":"33312","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"35 岁","valueContext":null,"source":"egs","sourceCharacterId":"24320","sourceWorkId":"33312","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"24320","sourceWorkId":"33312","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/213962068a2d617f0f87cdf1271172527dae45a85f31b693d1aed6228e741af0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/8488a938998ff796a7c56e6c6a5e988c03a17e40c350f809be36e43153e908d9.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c132304","characterName":"ジャックナイフ・浦波","sourceIds":{"bangumi":[],"egsCharacterIds":["24321"],"vndbCharacterId":"c132304"},"originalCharacterName":"ジャックナイフ・浦波","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アメリカ人と日本人のハーフ。愛称はジャック。"},{"spoiler":false,"text":"長身でマッチョ、日本人とは異なる肌色と、インパクトのある外見をしているが、人当たりは丁寧で温厚。"},{"spoiler":false,"text":"ただし、一度スイッチが入ると野獣のような本性を現し、手が付けられなくなる。"},{"spoiler":false,"text":"過去に一度、暴力沙汰で起訴されかけた事があり、その際に弁護を担当した政夫の長男を通じ、政夫と知り合った。"},{"spoiler":false,"text":"普段は政夫の手伝い（著書の翻訳作業）などをして暮らしつつ、政夫が女をモノにした時には、そのおこぼれに預かったりしている。"}],"source":"egs","sourceCharacterId":"24321","sourceWorkId":"33312","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"28 岁","valueContext":null,"source":"egs","sourceCharacterId":"24321","sourceWorkId":"33312","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"192 cm","valueContex