8","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156666:220562:5741:1","source":"bangumi"}]},{"characterId":"char_c81245","characterName":"桜華","sourceIds":{"bangumi":[{"characterId":"220567","match":"exact-normalized-name-in-linked-work","subjectId":"156666"}],"egsCharacterIds":["26758"],"vndbCharacterId":"c81245"},"originalCharacterName":"桜華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔を封じるべく、各地を旅する女兵法者。槍と薙刀の名人。"},{"spoiler":false,"text":"主人公が鬼族の末裔であることを知り、袂を分かとうとするが……。"}],"source":"egs","sourceCharacterId":"26758","sourceWorkId":"4893","spoiler":false},{"segments":[{"spoiler":false,"text":"彩と同じく、魔を封じるため各地を旅する。"},{"spoiler":false,"text":"いち早く信長の存在に気づき、その復活を妨げようとしている。"},{"spoiler":false,"text":"修羅丸が鬼の血を継いでいることを知り、袂を分かとうとするが不思議な力に呼び止められ、残ることに。"},{"spoiler":false,"text":"女性ながら東西まれに見る槍と薙刀の使い手"}],"source":"bangumi","sourceCharacterId":"220567"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce2c1ad42f5c9cc364afeb9b9b0a055b38d2d694cc5549b09658274053e266a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/637f730e06014f1fa977e6c55580e255bf106fc486c59acdf9b5940c4e937b96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156666:220567:4956:1","source":"bangumi"}]},{"characterId":"char_c81246","characterName":"蓮","sourceIds":{"bangumi":[{"characterId":"220563","match":"exact-normalized-name-in-linked-work","sub