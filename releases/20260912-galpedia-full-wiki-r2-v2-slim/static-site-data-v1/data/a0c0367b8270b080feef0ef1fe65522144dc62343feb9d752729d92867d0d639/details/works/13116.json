{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13116","model":{"presentationWorkId":"vndb:v2854","staff":{"artwork":[{"creditedName":"T-28","creatorId":"vndb:s4809","sourcePersonId":"egs:creator:14160","canonicalEntityId":"vndb:s4809","name":"T-28","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80848","source":"egs"}],"scenario":[{"creditedName":"優妃崎章人(松永佳宏)","creatorId":"vndb:s4099","sourcePersonId":"egs:creator:2648","canonicalEntityId":"vndb:s4099","name":"優妃崎章人(松永佳宏)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:133600","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c2755","characterName":"橋本 柚希","sourceIds":{"bangumi":[{"characterId":"214201","match":"exact-normalized-name-in-linked-work","subjectId":"223952"}],"egsCharacterIds":["14322"],"vndbCharacterId":"c2755"},"originalCharacterName":"橋本 柚希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"34"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's next door neighbor."}],"source":"vndb","sourceCharacterId":"c2755"},{"segments":[{"spoiler":false,"text":"主人公の隣の部屋に住む人妻。"},{"spoiler":false,"text":"現在、仕事人間の夫とは別居中で一人暮らし。離婚してもおかしくない状況だが、夫が世間体を気にして離婚には至っていない。"},{"spoiler":false,"text":"良家出身の女性で、性格は明るく、世間慣れしておらず、年の割には初々しく天然。"},{"spoiler":false,"text":"お隣さんの主人公の母親とも付き合いがあり、主人公にもしばしば力仕事を頼んだりしている。それがきっかけとなって、主人公の気を惹いてしまう。"}],"source":"egs","sourceCharacterId":"14322","sourceWorkId":"13116","spoiler":false},{"segments":[{"spoiler":false,"text":"34才。真一のお隣さん。正孝の妻。"},{"spoiler":false,"text":"良家の出で、明るいが天然で世間慣れしていない。真一の母親とも御近所さんとして懇意にしている。"},{"spoiler":false,"text":"そのため、近所に住む真一に力仕事等を頼む事がある。本人は自覚はないが、それが結果、彼に強い意識を抱かせる事になっている。"},{"spoiler":false,"text":"現在、見合結婚した夫とは別居中。彼女は愛情ある結婚を求めていたが、仕事人間の正孝との間に意識がズレがある。"},{"spoiler":false,"text":"夫との不和からくる鬱屈と真一の純粋な思いに惹かれたことから関係を持っていく。"}],"source":"bangumi","sourceCharacterId":"214201"}],"profileFacts":[{"label":"年龄（本版本）","value":"34 岁","valueContext":null,"source":"egs","sourceCharacterId":"14322","sourceWorkId":"13116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0732441bad99bb8455fc7f57deb23518c0f23130553212f680f663b47c6918db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72d8e4d829206bcbc1afeab8d1a71760edebfe5a6c55123f75d4c4e0b74cd56e.webp","width":166,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p918","sourceCompanyId":"egs:brand:2797","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13116:2797","source":"egs"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:168076:v2854","source":"vndb"},{"companyId":"vndb:p1596","sourceCompanyId":"vndb:p1596","canonicalEntityId":"vndb:p1596","name":"姫ちゃんカンパニー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:168077:v2854","source":"vndb"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6683:v2854","source":"vndb"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6684:v2854","