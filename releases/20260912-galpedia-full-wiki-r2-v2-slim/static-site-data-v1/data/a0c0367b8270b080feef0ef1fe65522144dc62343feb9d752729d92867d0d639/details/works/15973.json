"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9692"],"vndbCharacterId":"c38615"},"originalCharacterName":"夏野 美咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メインヒロイン。"},{"spoiler":false,"text":"責任感があり、明るく純粋で前向き。"},{"spoiler":false,"text":"美人と言うよりは元気で笑顔が魅力的、親しみやすいタイプ。"},{"spoiler":false,"text":"虐げられる者を見過ごせず、理屈よりも率直な感情で人を動かす。"},{"spoiler":false,"text":"島では『善玉グループ』のリーダー的な立場の1人として行動する。"}],"source":"egs","sourceCharacterId":"9692","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく純粋。元気な笑顔が魅力的な、いつだって前向きな女の子。"},{"spoiler":false,"text":"島では 『善玉グループ』 のリーダー的立場の1人としてみんなを引っ張っていくことに。"},{"spoiler":false,"text":"正義感がとても強く、理屈ではなく感情で人を動かすタイプ。"}],"source":"bangumi","sourceCharacterId":"93075"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f71f86a90766787144ee8002b95ddf036d402149b80e20b5d08a21b4f8b92523.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8c8670d0bd1a51e32a3cb11e68991cc7b5a8eece5ce3c7fa17f65aa6a0b2565.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122411:93075:6018:1","source":"bangumi"}]},{"characterId":"char_c38616","characterName":"雄々神 葵","sourceIds":{"bangumi":[{"characterId":"93076","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9693"],"vndbCharacterId":"c38616"},"originalCharacterName":"雄々神 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"孤高な性格の、文武両道の才女で華道部の部長。"},{"spoiler":false,"text":"冷静沈着で善人だが人を信用しない。"},{"spoiler":false,"text":"モデル体型で背が高く、とても美人で目立っている。"},{"spoiler":false,"text":"雄々神家は古武術を伝える家で、彼女はその達人。単純な格闘においては登場人物中最強となる。"},{"spoiler":false,"text":"島では葵とそれに親しい人間だけで『独立勢力グループ』として行動する。"}],"source":"egs","sourceCharacterId":"9693","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"文武両道な華道部の部長。冷静沈着で善人だが人を信用しない。"},{"spoiler":false,"text":"古武術を伝える家に生まれ、単純な格闘においては登場人物中最強である。"},{"spoiler":false,"text":"島ではごく親しい人間だけで 『独立勢力グループ』 として行動している。"}],"source":"bangumi","sourceCharacterId":"93076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d11f86f5aa703ab71b4ae833251634867dfd74eae00e18df08a95447f0d1183.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2fe0b9976b16993cea3648d362770248deb94c56ee96742e33366fd3132f8f7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田紗記子","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122411:93076:17079:1","source":"bangumi"}]},{"characterId":"char_c38617","characterName":"桐野 頼子","sourceIds":{"bangumi":[{"characterId":"93077","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9694"],"vndbCharacterId":"c38617"},"originalCharacterName":"桐野 頼子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伏し目がちでおどおどしている引っ込み思案な性格。"},{"spoiler":false,"text":"胸のせいで太めに見られることもあるが太ってはおらず巨乳。"},{"spoiler":false,"text":"学園内では男子の性的な視線と女子の侮蔑に晒されて孤立し、軽い苛めを受けていた。"},{"spoiler":false,"text":"島では『善玉グループ』の一員だったが『悪玉グループ』に寝返り、性的なアピールで自分の取り巻きを増やし『悪玉グループ』の女王的な権力を握るようになる。"}],"source":"egs","sourceCharacterId":"9694","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"伏し目がちで、常におどおどしている引っ込み思案な女の子。"},{"spoiler":false,"text":"胸が大きく、学園内では男子の性的な視線と女子の侮蔑に晒されていた。"},{"spoiler":false,"text":"島では 『善玉グループ』 の一員だったが、『悪玉グループ』 に寝返り、性的なアピールで自分の取り巻きを増やしていくようになる。"}],"source":"bangumi","sourceCharacterId":"93077"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3162fa848da6014e2bb63cbcf563d8a39c0f6f82db6bdcf2fba2139b0bf9a1f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22525cb25628da3bcaf0cc854e94d2cdc686d1aa20b1f70334af459ea37085cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西口有香","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122411:93077:6592:1","source":"bangumi"}]},{"characterId":"char_c38618","characterName":"雨宮 ほのか","sourceIds":{"bangumi":[{"characterId":"93078","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9695"],"vndbCharacterId":"c38618"},"originalCharacterName":"雨宮 ほのか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学生思いの善良な女教師。船編での唯一の大人の生き残り。"},{"spoiler":false,"text":"レイプから教え子を守る為に犠牲になる。"},{"spoiler":false,"text":"船編ではテロリストにクスリを打たれ、しかも教え子にレイプされ、船編では茫然自失状態。"},{"spoiler":false,"text":"島編でも教師らしい行動は出来ず『悪玉グループ』の欲望のはけ口にされる。"}],"source":"egs","sourceCharacterId":"9695","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"大人でただ一人の生き残り。"},{"spoiler":false,"text":"船上では教え子を守るために自らの身体を差し出すが、テロリストにクスリを打たれた挙句、学生たちに犯され茫然自失の状態になる。"},{"spoiler":false,"text":"それ以降は教師らしい行動は出来ず、『悪玉グループ』 の欲望の捌け口にされることに。"}],"source":"bangumi","sourceCharacterId":"93078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edf67bb69bce02c38503e0dc796ff7cb2a5dbbf98d2faa813953459962d64a6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b713953ba9d7d085c333f17bc0add223390420b3063aab5d5f050f83f5ca959.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122411:93078:5924:1","source":"bangumi"}]},{"characterId":"char_c63925","characterName":"秋月 進","sourceIds":{"bangumi":[{"characterId":"93079","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9696"],"vndbCharacterId":"c63925"},"originalCharacterName":"秋月 進","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いわゆる主人公。フツーの帰宅部な学生。夏野美咲と仲がいい。"},{"spoiler":false,"text":"ファンタジー小説等が好きで、サバイバル知識が豊富。"},{"spoiler":false,"text":"近代以前の武器なら自前で作ったり出来る。"},{"spoiler":false,"text":"ただし軍オタではないので火薬を使った武器の扱いは不慣れ。"},{"spoiler":false,"text":"正義感はあるが、体力が無く、荒事は苦手で、臆病でもある。"},{"spoiler":false,"text":"同級生が犯されているときに、勇気が無くてただ見ているだけだった自分を悔いている。"}],"source":"egs","sourceCharacterId":"9696","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"美咲と仲がいい。"},{"spoiler":false,"text":"体力はないが、ファンタジー小説が好きで、サバイバル知識にも長けている。"},{"spoiler":false,"text":"簡単な武器なら作ることもできる。"},{"spoiler":false,"text":"正義感はあるが臆病なところがあり、荒事には怯んでしまう一面も。"}],"source":"bangumi","sourceCharacterId":"93079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c92b75349ee627df69ee72ad394e8318aa561f6b94e47d70ad827eeabdbf3c75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/944434c03e45edf8631cde3b8bed67c15365d3d9b3b7c5618d5c3c7af3a4f285.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c63926","characterName":"久我 勇一","sourceIds":{"bangumi":[{"characterId":"93080","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9697"],"vndbCharacterId":"c63926"},"originalCharacterName":"久我 勇一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"他人とつるむのが嫌いな一匹狼の不良。喧嘩が強い。"},{"spoiler":false,"text":"勉強が嫌いなだけで、頭の回転は速い。"},{"spoiler":false,"text":"不良と言うよりはロッカーな感じ。なんだかんだで友情に厚い。"},{"spoiler":false,"text":"雄々神葵になんらかの「借り」があり、何かと気にしている。"},{"spoiler":false,"text":"単独生活を望み皆と袂を分かった雄々神葵についていく。"}],"source":"egs","sourceCharacterId":"9697","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"ケンカがとても強く、勉強はできないが頭の回転は速い。"},{"spoiler":false,"text":"素行はあまり良くないが、なんだかんだで情に厚い。"},{"spoiler":false,"text":"雄々神葵になんらかの “借り” があり、なにかと気にしている。"}],"source":"bangumi","sourceCharacterId":"93080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/471b8bc1deab7c8f0cb902e48f6269de0807c18b493226d8afc1e273d047cfa7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/244bf8b17db33ec4c19a703ae60522f292f5485b07a813fdfe53845ba5604b9b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c63927","characterName":"春日部 巧","sourceIds":{"bangumi":[{"characterId":"93081","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9698"],"vndbCharacterId":"c63927"},"originalCharacterName":"春日部 巧","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桐野頼子のことがずっと好きで、寡黙に従者のように付き従う男。"},{"spoiler":false,"text":"丸刈りで線目で四角い顔。ごつい。"},{"spoiler":false,"text":"見た目通りかなりの力があり、実は喧嘩が相当強い。内気で、口べた。"},{"spoiler":false,"text":"変わっていく頼子のことが心配で、しかしどうにもしてやれず、ただ守るように付き従っている。"},{"spoiler":false,"text":"そんな彼の気持ちに頼子は気付かず、最初は怖がっていたのだが、陵辱から助けられたことから唯一心を許す相手になり、色々愚痴って本音を漏らしたりする。"}],"source":"egs","sourceCharacterId":"9698","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"ガタイが良く、見た目通り力がある。実はケンカも相当強い。"},{"spoiler":false,"text":"ただ内気で口下手なため、自己主張をすることはあまりない。"},{"spoiler":false,"text":"桐野頼子に好意を寄せており、何かがあった時に守れるように彼女に付き従っている。"}],"source":"bangumi","sourceCharacterId":"93081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d0b4e5096e469811c39090539e591ded4b8ca82469602d1b888080d865aef8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef897c0e5bde9208b6ae72b2c454267c9ab197c3d9775bb6324d7dc1f56d0f1e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c63928","characterName":"白鳥 守","sourceIds":{"bangumi":[{"characterId":"93082","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9699"],"vndbCharacterId":"c63928"},"originalCharacterName":"白鳥 守","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"成績優秀な優等生。努力型の秀才。学生会長。"},{"spoiler":false,"text":"地に足の着かない理想論者で、小心なエゴイスト。"},{"spoiler":false,"text":"危機に際し馬脚を現し、クラス内での人望を失い、保身・自己正当化のため空疎な正論を振りかざす。"},{"spoiler":false,"text":"ヤンが逃亡時に（もちろん悪意で）授けた拳銃を隠し持っている。"},{"spoiler":false,"text":"オートマティック式で装填数不明。"},{"spoiler":false,"text":"学生会長として場を仕切ろうとするも立場が悪くなり、とうとう銃で周囲を脅して言うことを聞かせようとする。"}],"source":"egs","sourceCharacterId":"9699","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"努力型の秀才で、学生会長を務めているが、実はかなりの小心者でエゴイストでもある。"},{"spoiler":false,"text":"現実離れした理想論を振りかざすことも多く、事件が起きてからはどんどんと人望を失くしていく。"}],"source":"bangumi","sourceCharacterId":"93082"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d73afad7e292ed72928b2407f424c95983e2fa2a78e66f67b4245d20d0096b50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c536062cbf5c5666b50409b207fcf84390d505b8d36fcb6ea3967e2f632839d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c63930","characterName":"柏葉 亮二","sourceIds":{"bangumi":[{"characterId":"93083","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9700"],"vndbCharacterId":"c63930"},"originalCharacterName":"柏葉 亮二","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"このクラスの不良のNo.2。"},{"spoiler":false,"text":"生き残りの男子の中には数人彼の手下がいて、いつもつるんでいる。"},{"spoiler":false,"text":"粗暴で考えが足りない。"},{"spoiler":false,"text":"雨宮先生をレイプしたために、一層クラスの嫌われ者になる。"},{"spoiler":false,"text":"勇一とは幼なじみだが、力で取り巻きをまとめようとする亮二と勇一は考えが合わず最近は対立するようになっていた。"}],"source":"egs","sourceCharacterId":"9700","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"粗暴で考えが足りてないところが多い。"},{"spoiler":false,"text":"生き残りの男子を手下として従え、悪玉グループを陰で仕切っている。"},{"spoiler":false,"text":"久我勇一とは幼なじみではあるが、考えが合わず最近は対立するようになっていた。"}],"source":"bangumi","sourceCharacterId":"93083"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25babc223b59a6ddeca058158df5dba7417bb49eda99a7e82b97f18f16b1c82f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41461c411fe5ee938b3132a5aae31481a87689e890745b791ac9e6fd1357da3f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c63931","characterName":"ヤン","sourceIds":{"bangumi":[{"characterId":"93084","match":"exact-normalized-name-in-linked-work","subjectId":"122411"}],"egsCharacterIds":["9701"],"vndbCharacterId":"c63931"},"originalCharacterName":"ヤン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"海賊の頭目。"},{"spoiler":false,"text":"シージャックを起こした主犯格。"},{"spoiler":false,"text":"何名もの海賊たちを引き連れている。"},{"spoiler":false,"text":"ヤンという名前は偽名であり、素性については一切不明である。"}],"source":"egs","sourceCharacterId":"9701","sourceWorkId":"15973","spoiler":false},{"segments":[{"spoiler":false,"text":"海賊の頭目であり、何名もの海賊を引き連れ航海している。"},{"spoiler":false,"text":"ヤンという名前は偽名であり、素性については一切不明である。"}],"source":"bangumi","sourceCharacterId":"93084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfbcb32e5e19d7aebc831490d88f52a3d48c0d4f53fda42850a6b7f657784b6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56f00f589dd4bf91fedbe3