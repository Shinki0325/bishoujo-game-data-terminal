rceWorkId":"9708","spoiler":false},{"segments":[{"spoiler":false,"text":"ある日突然空から降ってきたド天然淫乱サッキュバスで、自称“淫魔のお姫様候補”。周りの人間をふりまわす、トラブルメーカーである。"},{"spoiler":false,"text":"敏行を「次期魔王になる男」と言い張り、既成事実を作るべく敏行とエッチな専属契約を結び、毎晩「妊娠されてダーリン」とせがんでくる。"},{"spoiler":false,"text":"本人曰く魔界にいた頃は相当お嬢様だったようで、目のやり場に困るコスチュームも「正装」であるとのこと。人間界での偽名は『藤原 ニナ（ふじわら にな）』。"}],"source":"bangumi","sourceCharacterId":"62713"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f66cd38a19dc0e649aa5370096a019d20af599431a8c18b9236430a95ba2c326.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48b339a2adfae271c717b4865cb3938c553f2aef0243f17ea8b0718e042e495d.webp","width":125,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218636:62713:5906:1","source":"bangumi"}]},{"characterId":"char_c52900","characterName":"天堂 理枝","sourceIds":{"bangumi":[{"characterId":"62714","match":"exact-normalized-name-in-linked-work","subjectId":"218636"}],"egsCharacterIds":["19433"],"vndbCharacterId":"c52900"},"originalCharacterName":"天堂 理枝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"品行方正なクラス委員長で、気になるお隣さん"},{"spoiler":false,"text":"敏行のクラスメイトで、品行方正なクラス委員長。"},{"spoiler":false,"text":"おまけにマンションのお隣さんでもある、ちょっと気になる女の子。"},{"spoiler":false,"text":"真面目で努力家だが内向的らしく、敏行にもどこかよそよそしい態度をとっていたが、ニナが敏行の家に来たことで心境に変化があったのか（？）"},{"spoiler":false,"text":"それまでよりも積極的に敏行とコミュニケーションをとってくるようになった。"},{"spoiler":false,"text":"ニナが起こすトラブルに巻き込まれる体質なのか、パンチラはもちろん、公衆の面前で服を溶かされちゃうことも…？"},{"spoiler":false,"text":"「あ、あの、貴方とニナさんって……どういう関係なのかな？」"}],"source":"egs","sourceCharacterId":"19433","sourceWorkId":"9708","spoiler":false},{"segments":[{"spoiler":false,"text":"敏行のクラスメイトで、品行方正なクラス委員長。おまけにマンションのお隣さんでもある、ちょっと気になる女の子。"},{"spoiler":false,"text":"真面目で努力家だが内向的らしく、敏行にもどこかよそよそしい態度をとっていたが、ニナが敏行の家に来たことで心境に変化があったのか（？）それまでよりも積極的に敏行とのコミュニケーションをとってくれるようになった。"},{"spoiler":false,"text":"ニナが起こすトラブルに巻き込まれる体質なのか、パンチラはもちろん、公衆の面前で服を溶かされちゃうことも…？"}],"source":"bangumi","sourceCharacterId":"62714"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19602df232d2d29f69106e89b809be7236cdcc0ffc6c0ebe3269d45077cc545d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fe5f42850ff66475205edba000f677ec2c97181ce6f2318033c3c16cb3c6981.webp","width":94,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218636:62714:4489:1","source":"bangumi"}]},{"characterId":"char_c52901","characterName":"リリス＝ルナ","sourceIds":{"bangumi":[{"characterId":"62715","match":"exact-normalized-name-in-linked-work","subjectId":"218636"}],"egsCharacterIds":["19434"],"vndbCharacterId":"c52901"},"originalCharacterName":"リリス＝ルナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ニナの母、反則爆乳ボディを持つ淫魔の人妻"},{"spoiler":false,"text":"人間時の偽名は　麻崎 真奈美（まさき・まなみ）"},{"spoiler":false,"text":"敏行の隣の部屋に引っ越してきた未亡人。"},{"spoiler":false,"text":"その正体はニナの母親。"},{"spoiler":false,"text":"娘が心配でやってきたはずが、敏行の下半身に興味津々で思わずつまみ食いしてしまい、素性がばれてしまう。"},{"spoiler":false,"text":"「あらあら……あなた、人間のくせに立派なものをもってますのね……美味しそうですわ」"}],"source":"egs","sourceCharacterId":"19434","sourceWorkId":"9708","spoiler":false},{"segments":[{"spoiler":false,"text":"敏行の隣の部屋に引っ越してきた未亡人。その正体はニナの母親。"},{"spoiler":false,"text":"娘が心配でやってきたはずが、敏行の下半身に興味津々で思わずつまみ食いしてしまい、素性がばれてしまう。"},{"spoiler":false,"text":"人間界での偽名は『麻崎 真奈美（まさき まなみ）』。"}],"source":"bangumi","sourceCharacterId":"62715"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2328a5ab881a9e4ad4f9d6c33a37271969a737b183f6fcfe760c9e676b14adfc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfdd27a73f357fb114201f284aed14962283791881f80c6307df76cf971e434a.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218636:62715:4940:1","source":"bangumi"}]},{"characterId":"char_c52903","characterName":"エリナ＝ミナ","sourceIds":{"bangumi":[{"characterId":"221622","match":"exact-normalized-name-in-linked-work","subjectId":"218636"}],"egsCharacterIds":["19435"],"vndbCharacterId":"c52903"},"originalCharacterName":"エリナ＝ミナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ニナをライバル視し、魔界から追いかけてきた半人前サキュバス"},{"spoiler":false,"text":"ニナのイトコにあたる双子。姉がエリナで妹がフローラ。"},{"spoiler":false,"text":"エリナは一方的にニナをライバル視しており、敏行を籠絡するため後を追いかけて人間界に来る。"},{"spoiler":false,"text":"しかし世間知らずでやることがずれていて、いつも失敗に終わってしまう。"},{"spoiler":false,"text":"「えっ？　ニナってば、こんな恥かしいことまでやってるの？　……じゃ、じゃあ私もやる!!」"}],"source":"egs","sourceCharacterId":"19435","sourceWorkId":"9708","spoiler":false},{"segments":[{"spoiler":false,"text":"ニナのイトコにあたる双子の姉。"},{"spoiler":false,"text":"エリナは一方的にニナをライバル視しており、敏行を籠絡するため後を追いかけて人間界に来る。"},{"spoiler":false,"text":"しかし世間知らずでやることがずれていて、いつも失敗に終わってしまう。"},{"spoiler":false,"text":"「えっ？　ニナってば、こんな恥かしいことまでやってるの？　……じゃ、じゃあ私もやる！！」"}],"source":"bangumi","sourceCharacterId":"221622"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/934c4dfc292b73469ffd572db0cebdb3f99a76fdcc9306dcf2cba29378d982f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5f4102b6678675d3edda3355b9e2bfbc062a6698edec4827ddc53c71b17f5f9.webp","width":109,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218636:221622:5900:1","source":"bangumi"}]},{"characterId":"char_c52905","characterName":"フローラ＝ミナ","sourceIds":{"bangumi":[{"characterId":"62716","match":"exact-normalized-name-in-linked-work","subjectId":"218636"}],"egsCharacterIds":["19436"],"vndbCharacterId":"c52905"},"originalCharacterName":"フローラ＝ミナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無口無表情なクールビューティーのサッキュバス"},{"spoiler":false,"text":"エリナの双子の妹。やはり、ニナのイトコにあたる。"},{"spoiler":false,"text":"いつも姉の側にいて、トラブルを起こした姉をクールにフォローする。"},{"spoiler":false,"text":"無口で無表情、なにも感心がないように見えるが、実は重度のシスコン。"},{"spoiler":false,"text":"姉のやることはすべて受け入れるし、逆に姉を馬鹿にされることがあれば本気で怒る。"},{"spoiler":false,"text":"ただ、人にまっすぐ見つめられるのに弱く、話すときも目を見ないで話すことが多い。"},{"spoiler":false,"text":"本人はニナに対して敵愾心などを持っているわけではないが、姉が一生懸命に張り合うので、それをサポートしている。"},{"spoiler":false,"text":"今回、人間界に来たのもそれが理由。"},{"spoiler":false,"text":"いつも手にもっているのは、魔界で人気の「血まみれウサタン」という人形である。"},{"spoiler":false,"text":"しゃべる機能はないが、フローラの腹話術で時折毒舌をはく。"},{"spoiler":false,"text":"「…………お姉ちゃん、それ、違う……」"}],"source":"egs","sourceCharacterId":"19436","sourceWorkId":"9708","spoiler":false},{"segments":[{"spoiler":false,"text":"エリナの双子の妹。"},{"spoiler":false,"text":"やはり、ニナのイトコにあたる。"},{"spoiler":false,"text":"いつも姉の側にいて、トラブルを起こした姉をクールにフォローする。"},{"spoiler":false,"text":"無口で無表情、なにも感心がないように見えるが、実は重度のシスコン。"},{"spoiler":false,"text":"いつも手にもっているのは、魔界で人気の「血まみれウサタン」という人形である。"},{"spoiler":false,"text":"しゃべる機能はないが、フローラの腹話術で時折毒舌をはく。"},{"spoiler":false,"text":"「…………お姉ちゃん、それ、違う……」"}],"source":"bangumi","sourceCharacterId":"62716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd6f1c32e8606927efdacd39440972c9284a09c938547fb7e4ff0c7de67364c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/908bea3b6a622a48c5793e958ae8af8325af5791d967d70349d8469b09787fec.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218636:62716:4714:1","source":"bangumi"}]},{"characterId":"char_vndb_c123191","characterName":"藤原 敏行","sourceIds":{"vndbCharacterId":"c123191"},"originalCharacterName":"藤原 敏行","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p258","sourceCompanyId":"egs:brand:721","canonicalEntityId":"vndb:p258","name":"マリン","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9708:721","source":"egs"},{"companyId":"vndb:p258","sourceCompan