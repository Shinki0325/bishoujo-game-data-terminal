fileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/1054c9f32e0b6973ab7c59594839e5d4e75b369df84f1a8845aed6855656bf37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aae299d88c71345993146f1ae42c0ec6da58d1f91ccc829a90d47aa9d9ef055d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"彩世 ゆう","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21319","source":"vndb"}]},{"characterId":"char_vndb_c57154","characterName":"火村 一平","sourceIds":{"vndbCharacterId":"c57154"},"originalCharacterName":"火村 一平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He left his parents to attend a boarding school in Tokyo because he was afraid that he found himself lusting after his mother."},{"spoiler":false,"text":"His father Tetsuji is a bastard and would often beat Ryou when he was drunk, Ryou is not a weak woman by any means, she endured it so the abuse would be directed at her instead of at Ippei."},{"spoiler":false,"text":"One day, Ippei decided to take advantage of the fact that his father was sleeping to punish him. So he sneaks into their bedroom and watches Ryou and Tetsuji's nighttime activities. The sight of the two, who normally do not get along so well, naked and entwined with each other arouses the young Ippei painfully, and he ejaculates for the first time."},{"spoiler":false,"text":"As Ippei grows older, however, the trauma weighs heavily on him, especially after his father's disappearance, he begins to dream almost every night of being with his mother. In order not to let this continue, he chose a boarding school for his higher education and decided to leave his parents as soon as possible."},{"spoiler":false,"text":"Like his father, he is a handsome man with a talent for womanizing, but his hatred for his father has made him subconsciously suppress it."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c57154"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c63297","characterName":"冨士田 鋭一","sourceIds":{"vndbCharacterId":"c63297"},"originalCharacterName":"冨士田 鋭一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"61"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"On the surface, he is the president of a real estate company, but behind the scenes he is a moneylender."},{"spoiler":false,"text":"Coming from a poor family, he has risen to this level with nothing but his bare hands. In the process, he has done many dirty things, and has earned the enmity of no less than 100 people. However, he does not seem to be bothered by such things."},{"spoiler":false,"text":"His one-man management also extends to his health care, and he goes to extremes in his extravagance when it comes to drinking and eating, even if his doctor tells him not to. As a result, he suffers from diabetes and is impotent, probably due to his age. For this reason, he often gives his wife, Mineko, SM-like torture to lower her spirits."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c63297"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a64d5495f6886f652ca548020f208f5a4adbdd1230930f0bdb975700f4326fba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characte