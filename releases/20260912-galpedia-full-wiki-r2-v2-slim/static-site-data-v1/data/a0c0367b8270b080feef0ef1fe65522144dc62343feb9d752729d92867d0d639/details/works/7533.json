rce":"vndb","sourceCharacterId":"c57136"},{"segments":[{"spoiler":false,"text":"主人公の義母。36歳。"},{"spoiler":false,"text":"家事全般を完璧にこなす、時に優しく、時に厳しい理想の母親。"},{"spoiler":false,"text":"さらに床上手。"},{"spoiler":false,"text":"極度の寂しがり屋の彼女だが、そうした面を見せない気丈さを持つ。"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"2648","spoiler":false},{"segments":[{"spoiler":false,"text":"レジェン妻（ゲスト出演）"},{"spoiler":false,"text":"『人妻×人妻3』の主人公、桜庭航太郎の義理の母親で、最終的に彼と結ばれた。"},{"spoiler":false,"text":"現在は航太郎との間に生まれた子供、海人の母親。"},{"spoiler":false,"text":"航太郎は、現在海外の大学で経営を学んでおり、ちょっぴり寂しい。"},{"spoiler":false,"text":"「あっ、あらひのオッ、オ○ンコがっ……！！オ○ンコがっ、こわれちゃうぅぅ！！」"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"7533","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妻。"},{"spoiler":false,"text":"『人妻×人妻3～』では、最愛の夫・長一郎を亡くし、夫の残してくれたスーパー「サクラマート」を義理の息子である主人公と一緒に盛り立ててきた。"},{"spoiler":false,"text":"そうしたなか、主人公と愛が芽生え、そして結婚に至る。"},{"spoiler":false,"text":"家事全般を難なくこなす、優しさと厳しさを同居させる女性。"},{"spoiler":false,"text":"昼は聖母、夜は娼婦の如き卓越した性テクニックを持つ。"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","spoiler":false},{"segments":[{"spoiler":false,"text":"航太郎の義理の母親。"},{"spoiler":false,"text":"実母のみさ子とは幼なじみの間柄である。"},{"spoiler":false,"text":"なぎさが産まれた直後に連れあいを亡くし、悲嘆に暮れていた航太郎の父、長一郎と再婚。"},{"spoiler":false,"text":"以来、家業のスーパーを盛り立てつつ、兄弟三人の面倒を見て来た。"},{"spoiler":false,"text":"家事全般を完璧にこなし、時に優しく、時に厳しい理想の母親。"},{"spoiler":false,"text":"本当は、常に誰かの支えがないと生きていけない極度の寂しがり屋なのだが、"},{"spoiler":false,"text":"その一面を見せるのは本当に好きになった男・・・長一郎の前のみである。"}],"source":"bangumi","sourceCharacterId":"95225"}],"profileFacts":[{"label":"年龄（本版本）","value":"39 岁","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"7533","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"7533","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"7533","sourc