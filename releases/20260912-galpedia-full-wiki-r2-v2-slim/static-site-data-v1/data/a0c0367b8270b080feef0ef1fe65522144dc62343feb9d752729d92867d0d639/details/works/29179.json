-staff:164439","source":"vndb"},{"creditedName":"赤羽 リュート","creatorId":"vndb:s6645","sourcePersonId":"vndb:s6645","canonicalEntityId":"vndb:s6645","name":"蒼月 しのぶ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:164440","source":"vndb"}]},"cast":[{"characterId":"char_c88372","characterName":"山田 いちコ","sourceIds":{"bangumi":[{"characterId":"76808","match":"exact-normalized-name-in-linked-work","subjectId":"298757"}],"egsCharacterIds":["22198"],"vndbCharacterId":"c88372"},"originalCharacterName":"山田 いちコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a cheerful and energetic zombie girl who dreams of becoming an idol."},{"spoiler":false,"text":"She may be clumsy, but she is strong-willed and straightforward, and has a charm that naturally draws people to her."},{"spoiler":false,"text":"She has longed to be an idol since she was alive, and her dream continues to thrive even after she is transformed into a zombie."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c88372"},{"segments":[{"spoiler":false,"text":"アイドルを夢見る、明るく元気なゾンビっ娘。"},{"spoiler":false,"text":"ドがつくポンコツだが、意思が強くまっすぐで、自然と周囲に人が集まるような魅力も持っている。"},{"spoiler":false,"text":"生前からアイドルに憧れており、ゾンビとなった後でもその夢を失っていない女の子。"}],"source":"egs","sourceCharacterId":"22198","sourceWorkId":"29179","spoiler":false},{"segments":[{"spoiler":false,"text":"アイドルを夢見る、明るく元気なゾンビっ娘。"},{"spoiler":false,"text":"ドがつくポンコツだが、意思が強くまっすぐで、自然と周囲に人が集まるような魅力も持っている。"},{"spoiler":false,"text":"生前からアイドルに憧れており、ゾンビとなった後でもその夢を失っていない女の子。"},{"spoiler":false,"text":"「便利だよね、この身体ー！生きてる時より、無茶できるし！」"}],"source":"bangumi","sourceCharacterId":"76808"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67e8855faa63ed08e57a5d9757ab0ee2144ddb6c7a1f937f890affa6a8ca2f17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8f898da52ccafd2542b8b9edef73a92c9db236e0f99cba0e4af21a28729d41c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298757:76808:5939:1","source":"bangumi"}]},{"characterId":"char_c88373","characterName":"佐藤 さとみ","sourceIds":{"bangumi":[{"characterId":"76809","match":"exact-normalized-name-in-linked-work","subjectId":"298757"}],"egsCharacterIds":["22199"],"vndbCharacterId":"c88373"},"originalCharacterName":"佐藤 さとみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"At first glance, she appears cool and mature, but she is a violent zombie girl with a short temper."},{"spoiler":false,"text":"She was an assassin before she died."},{"spoiler":false,"text":"She is straightforward and violent in her expressions, but she is a firm and serious person at heart, and is a very caring older sister figure. She loves to do solo karaoke."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c88373"},{"segments":[{"spoiler":false,"text":"一見クールで大人びているが、キレやすく物騒なゾンビっ娘。"},{"spoiler":false,"text":"それもそのはず、生前は殺し屋。"},{"spoiler":false,"text":"表現がストレートで乱暴だが、しっかり者で根は真面目、とても面倒見がよい姉御肌。ヒトカラだいすき。"}],"source":"egs","sourceCharacterId":"22199","sourceWorkId":"29179","spoiler":false},{"segments":[{"spoiler":false,"text":"一見クールで大人びているが、キレやすく物騒なゾンビっ娘。"},{"spoiler":false,"text":"それもそのはず、生前は殺し屋。"},{"spoiler":false,"text":"表現がストレートで乱暴だが、しっかり者で根は真面目、"},{"spoiler":false,"text":"とても面倒見がよい姉御肌。ヒトカラだいすき。"},{"spoiler":false,"text":"「ゾンビアイドルなんて……ステージに上がるだけでも、生卵の嵐だろうしな」"}],"source":"bangumi","sourceCharacterId":"76809"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa48e3d8a5c04895b4cbda101c1712bf86ee8827aae687ec3df1c17b8da35b10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e883b9c42107cb43046958763362cf9971bae9081136f7a7993bd45e97ddc5b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298757:76809:10027:1","source":"bangumi"}]},{"characterId":"char_c88374","characterName":"高橋 かつね","sourceIds":{"bangumi":[{"characterId":"76810","match":"exact-normalized-name-in-linked-work","subjectId":"298757"}],"egsCharacterIds":["22200"],"vndbCharacterId":"c88374"},"originalCharacterName":"高橋 かつね","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A super shy zombie girl."},{"spoiler":false,"text":"She has a miraculous singing voice, but cannot express herself in public."},{"spoiler":false,"text":"She is timid, but she is the most kind and considerate of people above all others."},{"spoiler":false,"text":"After becoming a zombie, the blood flowing through her somehow turned into vintage wine, and when she gets excited, her blood flow increases to the point that she automatically gets drunk, making her a difficult girl to deal with."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c88374"},{"segments":[{"spoiler":false,"text":"超引っ込み思案なゾンビっ娘。"},{"spoiler":false,"text":"奇跡の歌声を持つが、人前で自己表現できない。"},{"spoiler":false,"text":"臆病だが誰よりも人のことを見ていて、誰よりも優しい。"},{"spoiler":false,"text":"ゾンビになった際、身体を流れる血液がなぜかヴィンテージワインになっており、興奮すると血流が良くなり勝手に酔っ払う難儀な子。"}],"source":"egs","sourceCharacterId":"22200","sourceWorkId":"29179","spoiler":false},{"segments":[{"spoiler":false,"text":"超引っ込み思案なゾンビっ娘。"},{"spoiler":false,"text":"奇跡の歌声を持つが、人前で自己表現できない。"},{"spoiler":false,"text":"臆病だが誰よりも人のことを見ていて、誰よりも優しい。"},{"spoiler":false,"text":"ゾンビになった際、身体を流れる血液がなぜかヴィンテージワインになっており、"},{"spoiler":false,"text":"興奮すると血流が良くなり勝手に酔っ払う難儀な子。"},{"spoiler":false,"text":"「やっぱりわたしには無理です。できないですぅ～……」"}],"source":"bangumi","sourceCharacterId":"76810"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32fe726cd4cae2ec580390c9e472a82896e7767c113c181deba869bab27d8293.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87750f170e8196b4b58e264e420b09fd205e0c1b1c6361334c9b4c3382b4b772.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298757:76810:17075:1","source":"bangumi"}]},{"characterId":"char_c88375","characterName":"鈴木 歌姫","sourceIds":{"bangumi":[{"characterId":"76811","match":"exact-normalized-name-in-linked-work","subjectId":"298757"}],"egsCharacterIds":["22201"],"vndbCharacterId":"c88375"},"originalCharacterName":"鈴木 歌姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A zombie girl with an unconventional name, she has an easygoing, natural, and leisurely personality."},{"spoiler":false,"text":"She has a natural talent for songwriting, but her singing and dancing are so mediocre that no matter how hard she tries, she can't rise above the average level. She has an innocence that maintains her attitude no matter who she's with, and she is worryingly honest. She is half-Japanese and has a love for Japan's HENTAI ANIME."},{"spoiler":false,"text":"By the way, when she became a zombie, her body turned into silicon for some reason."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c88375"},{"segments":[{"spoiler":false,"text":"お気楽天然マイペースなキラキラネーム持ちのゾンビっ娘。"},{"spoiler":false,"text":"作詞作曲には天性の才能を発揮するが、歌と踊りはどれだけ頑張っても普通の域を超えることが出来ないほど普通。"},{"spoiler":false,"text":"誰が相手でも態度を変えない無邪気さを持ち、心配になるほどド素直。"},{"spoiler":false,"text":"ハーフであり、日本のＨＥＮＴＡＩ　ＡＮＩＭＥが大好き。"},{"spoiler":false,"text":"ちなみに、ゾンビになった際、体が何故かシリコン製になっていた。"}],"source":"egs","sourceCharacterId":"22201","sourceWorkId":"29179","spoiler":false},{"segments":[{"spoiler":false,"text":"お気楽天然マイペースなキラキラネーム持ちのゾンビっ娘。"},{"spoiler":false,"text":"作詞作曲には天性の才能を発揮するが、"},{"spoiler":false,"text":"歌と踊りはどれだけ頑張っても普通の域を超えることが出来ないほど普通。"},{"spoiler":false,"text":"誰が相手でも態度を変えない無邪気さを持ち、心配になるほどド素直。"},{"spoiler":false,"text":"ハーフであり、日本のHENTAI ANIMEが大好き。"},{"spoiler":false,"text":"ちなみに、ゾンビになった際、体が何故かシリコン製になっていた。"},{"spoiler":false,"text":"「え～どうしてー？ HENTAI ANIMEじゃ、このくらいふつーだったよー？」"}],"source":"bangumi","sourceCharacterId":"76811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e96882ef287e26b67e46f33fe44955c2267cb36254358b55385e0ab15187146c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e200dc0b0a048979253a95f05917a4a0ca91ec0914d4fcc15632e0ee8c36f1fa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298757:76811:5936:1","source":"bangumi"}]},{"characterId":"char_vndb_c88376","characterName":"丸綿さん","sourceIds":{"vndbCharacterId":"c88376"},"originalCharacterName":"丸綿さん","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist, yet a very enigmatic person."},{"spoiler":false,"text":"He is kind-hearted and mild-mannered, and is polite and serious to everyone."},{"spoiler":false,"text":"He is honest, easily empathizes with others, and is quite prone to tears."},{"spoiler":false,"text":"In general, he is always low-spirited and says very little."},{"spoiler":false,"text":"Although he may seem gloomy and gentle thus far, he is in fact a former secret service agent and a very skilled assassin."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c88376"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9f38c088adcf67d5ac3067580a35832809626f90182f185b0915ecd25f75470.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43455091552c771881936bf2a88a159ddece0f34899e3c957394a14989542d88.webp","width":195,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2793","sourceCompanyId":"egs:brand:3611","canonicalEntityId":"vndb:p2793","name":"あかべぇそふとすりぃ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29179:3611","source":"egs"},{"companyId":"vndb:p2793","sourceCompanyId":"vndb:p2793","canonicalEntityId":"vndb:p2793","name":"あかべぇそふとすりぃ","roleCodes":["developer","publisher"