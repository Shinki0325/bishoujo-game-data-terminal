us":"source-native","relationId":"vndb:vn-staff:26563","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:26564","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26565","source":"vndb"}]},"cast":[{"characterId":"char_c23822","characterName":"井上 静香","sourceIds":{"bangumi":[{"characterId":"55772","match":"exact-normalized-name-in-linked-work","subjectId":"219391"},{"characterId":"55772","match":"exact-normalized-name-in-linked-work","subjectId":"219392"}],"egsCharacterIds":["3906"],"vndbCharacterId":"c23822"},"originalCharacterName":"井上 静香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“橘ミキオ（主人公）”の自宅の隣に住んでいる幼馴染。主人公と同じ聖風学園の2年生だ。"},{"spoiler":false,"text":"容姿端麗、学業優秀、モデル体系に美巨乳と男子、女子ともに人気があり、現在は、生徒会長も務めている彼女。"},{"spoiler":false,"text":"ある日、その主人公に「恥ずかしい写真」を撮られ、それをネタに『奴隷彼女』になるよう強要され、敢えなく応じることに……"},{"spoiler":false,"text":"最初は、なんて酷い人間なんだと思っていた彼女だが、元人気ＡＶ男優の著作「女の堕とし方、秘儀伝授」全12巻から学んだ（とされる）主人公の性技に狂わされ、身体が勝手に反応するようになってしまうのだったが……。"}],"source":"egs","sourceCharacterId":"3906","sourceWorkId":"5227","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染にして奴隷（カノジョ）。"},{"spoiler":false,"text":"学園では生徒会長を務め、超巨乳にして容姿端麗、成績優秀の優等生から男女とも人気がある。"},{"spoiler":false,"text":"前作の経緯から、すっかり主人公と奴隷（カノジョ）な関係にあるにも関わらず、奴隷ではないとあくまでも強がる意地っ張りな女の子。"},{"spoiler":false,"text":"姉のひなたに交際を禁止され、あっさり承諾した主人公に怒り心頭の彼女は、主人公を避けるようにしているものの、主人公が姉と浮気しているのでは、とヤキモキしているようだが……。"}],"source":"egs","sourceCharacterId":"3906","sourceWorkId":"7611","spoiler":false},{"segments":[{"spoiler":false,"text":"聖風学園の2年生。ミキオの幼馴染。ミキオの自宅の隣に住んでいる。"},{"spoiler":false,"text":"幼いときはよくミキオと遊んでいて、線の細いミキオを引っ張る姉のような存在だった。"},{"spoiler":false,"text":"学園の生徒会長をしていて、モデル体型に美巨乳、抜群の容姿から男子・女子からも人気のある美少女。"},{"spoiler":false,"text":"成績もかなり優秀で周囲から期待されている。"},{"spoiler":false,"text":"そういった周囲の期待に応えようと頑張りすぎるところがあって、いつもオーバーワーク気味。"},{"spoiler":false,"text":"しかも静香は聖風学園初の女性生徒会長としてのプレッシャーがあり、なんとしてもニ年に一度行われるという聖風学園体育祭を成功裏に納めて、自分の後も女の子が気軽に参加できる生徒会にしたいと思っている。"},{"spoiler":false,"text":"そんな中、主人公に「恥ずかしい写真」を撮られて『奴隷彼女』になることに。"},{"spoiler":false,"text":"最初はなんて酷い人間なんだと思ったが、その性技に狂わされるうちに憎むどころか、身体が勝手に期待するようになっている。それがどうしても悔しい静香は、表面的にはますます厳しくミキオに反発するようになっている。"},{"spoiler":false,"text":"そんな静香だが、何かと仕事を抱え込んでしまう勝気で負けず嫌いな彼女が、気軽に何でも頼めてしまう唯一の存在が主人公である事には気付いていない。"}],"source":"egs","sourceCharacterId":"3906","sourceWorkId":"20552","spoiler":false},{"segments":[{"spoiler":false,"text":"聖風学園の2年生。ミキオの幼馴染。ミキオの自宅の隣に住んでいる。幼いときはよくミキオと遊んでいて、線の細いミキオを引っ張る姉のような存在だった。学園の生徒会長をしていて、モデル体型に美巨乳、"},{"spoiler":false,"text":"抜群の容姿から男子・女子からも人気のある美少女。成績もかなり優秀で周囲から期待されている。そういった周囲の期待に応えようと頑張りすぎるところがあって、いつもオーバーワーク気味。"},{"spoiler":false,"text":"しかも静香は聖風学園初の女性生徒会長としてのプレッシャーがあり、"},{"spoiler":false,"text":"なんとしてもニ年に一度行われるという聖風学園体育祭を成功裏に納めて、自分の後も女の子が気軽に参加できる生徒会にしたいと思っている。そんな中、主人公に「恥ずかしい写真」を撮られて『奴隷彼女』になることに。最初はなんて酷い人間なんだと思ったが、その性技に狂わされるうちに憎むどころか、身体が勝手に期待するようになっている。"},{"spoiler":false,"text":"それがどうしても悔しい静香は、表面的にはますます厳しくミキオに反発するようになっている。そんな静香だが、何かと仕事を抱え込んでしまう勝気で負けず嫌いな彼女が、気軽に何でも頼めてしまう唯一の存在が主人公である事には気付いていない。"}],"source":"bangumi","sourceCharacterId":"55772"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d4b1b3f3eeb1b48588831c6ef118b8056b647f811dc21ea135c40a4a5c436a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbea73c03beec95407abfd433a19ddd3526c79ec4bc449e7ce99fcd6e5e781a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219391:55772:6409:1","source":"bangumi"}]},{"characterId":"char_c23824","characterName":"矢口 麗華","sourceIds":{"bangumi":[{"characterId":"55774","match":"exact-normalized-name-in-linked-work","subjectId":"219391"}],"egsCharacterIds":["26546"],"vndbCharacterId":"c23824"},"originalCharacterName":"矢口 麗華","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖風学園の校医の先生。"},{"spoiler":false,"text":"豊満な肉体と大人の熟れた魅力がたっぷり彼女。性格は非常に気さくで快活で、学園の生徒に男女問わず人気があり、恋と性について悩みは彼女に相談するのが習慣になっているらしい。"},{"spoiler":false,"text":"若い男の子とエネルギッシュなエッチを好む彼女は、毎年、身体測定等で、好みの男の子を物色しており、そのとき主人公の素晴らしい巨根に魅せられてからは、主人公を誘惑するようになった。"},{"spoiler":false,"text":"そんなことから、主人公と静香の関係にも微妙に変化が……!?"}],"source":"egs","sourceCharacterId":"26546","sourceWorkId":"5227","spoiler":false},{"segments":[{"spoiler":false,"text":"聖風学園の校医の先生。豊満な肉体、大人の女の妖艶な色香と快活な性格で学園の生徒に男女問わず人気がある。生徒たちの中で、恋と性の相談は麗華先生という習慣が生まれている。若い男の子とのエネルギッシュなＨが大好きな麗華は毎年、身体測定などの機会に好み男子を物色している。そこでミキオのずば抜けた巨根に魅せられて、彼とＨしようと"},{"spoiler":false,"text":"あの手この手でミキオを誘惑している。彼女の介入で主人公と静香の関係に微妙な変化が……！？"}],"source":"bangumi","sourceCharacterId":"55774"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45d414de65de965fa43d5998ebc37d2082469d58527909129adcb33a7af34d17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9ee8202c6c37ad3809b7b902bd5ae512aafbdbf7f8a5d0a448b8a894ea87bc8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"歌織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219391:55774:12717:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:1036","sourceCompanyId":"egs:brand:1036","canonicalEntityId":"egs:brand:1036","name":"LiLiTH","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:5227:1036","source":"egs"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:18897:v1608","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:18898:v1608","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3738:v1608","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3739:v1608","source":"vndb"},{"companyId":"vndb:p6036","sourceCompanyId":"vndb:p6036","canonicalEntityId":"vndb:p6036","name":"プチチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3742:v1608","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:39240:v1608","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus"