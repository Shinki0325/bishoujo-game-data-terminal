entityStatus":"source-native","relationId":"vndb:vn-staff:34724","source":"vndb"},{"creditedName":"神月 社","creatorId":"vndb:s4003","sourcePersonId":"vndb:s4003","canonicalEntityId":"vndb:s4003","name":"神月 社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34727","source":"vndb"},{"creditedName":"ばんろっほ","creatorId":"vndb:s4354","sourcePersonId":"vndb:s4354","canonicalEntityId":"vndb:s4354","name":"ばんろっほ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34728","source":"vndb"},{"creditedName":"kanoko","creatorId":"vndb:s43203","sourcePersonId":"vndb:s43203","canonicalEntityId":"vndb:s43203","name":"kanoko","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34733","source":"vndb"}]},"cast":[{"characterId":"char_c7695","characterName":"九曜 更紗","sourceIds":{"bangumi":[{"characterId":"11378","match":"exact-normalized-name-in-linked-work","subjectId":"11526"}],"egsCharacterIds":["15056"],"vndbCharacterId":"c7695"},"originalCharacterName":"九曜 更紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1013"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student, one year older than the protagonist."},{"spoiler":false,"text":"She is in Class 3-F."},{"spoiler":false,"text":"She is the student council president at The Academy and also serves as the dormitory supervisor."},{"spoiler":false,"text":"She is beautiful, well-behaved, and academically gifted."},{"spoiler":false,"text":"Not only is she adept at sports, but as the daughter of a wealthy family, she is simply flawless."},{"spoiler":false,"text":"While she commands the respect of the entire school due to her flawless reputation, her aloof, cool gaze and the unsettling rumors that follow her have led others to keep their distance, making her a solitary figure."},{"spoiler":false,"text":"However, once she steps away from the student council, she reveals a different side to the protagonist alone—that of the “Maou’s Servant.”"},{"spoiler":false,"text":"The protagonist finds himself tormented every night by her stimulating, all-out devotion, as she swears absolute loyalty to the Maou…"}],"source":"vndb","sourceCharacterId":"c7695"},{"segments":[{"spoiler":false,"text":"主人公より1学年上の3年生。3-F所属。秋零学園の生徒会長で、寮の監督役も務めている。"},{"spoiler":false,"text":"容姿端麗、品行方正、学力優秀。運動もそつなくこなす上、家柄も財閥令嬢という事で申し分ない。"},{"spoiler":false,"text":"その隙の無さから学園中の尊敬を集める一方で、他人を寄せ付けないクールなまなざしとつきまとう不穏な噂から、周囲からは距離を置かれている孤高の人。"},{"spoiler":false,"text":"そんな彼女も生徒会から離れると、『魔王の下僕』という別の顔を主人公にだけ見せるようになる。"},{"spoiler":false,"text":"魔王に絶対の忠誠を誓う彼女の、優しくも妖しい尽くし攻撃に、主人公は毎晩悩まされる事になるのだが……。"},{"spoiler":false,"text":"「停滞は何も生まない。貴方がそこに立っていても、時間が無駄に過ぎていくだけよ」"}],"source":"egs","sourceCharacterId":"15056","sourceWorkId":"12720","spoiler":false},{"segments":[{"spoiler":false,"text":"比主人公大1年级的3年级学生。"},{"spoiler":false,"text":"秋零学园的学生会长，也担任宿舍的管理者。"},{"spoiler":false,"text":"容姿端丽、品行方正、学力优秀。再加上运动万能，出身又是财阀千金，简直完美无缺。"},{"spoiler":false,"text":"在因为无懈可击而受到学园中人的尊敬的一方面，也因为拒人于千里之外的冷酷的眼神与围绕她的不河蟹的传言，而被周围人敬而远之的孤高的人。"},{"spoiler":false,"text":"这样的她在离开学生会之后，也会只向主人公展示身为『魔王的仆人』的另一面。"},{"spoiler":false,"text":"面对向魔王宣誓了绝对的忠诚的她的献身式刺激攻击，主人公每晚都陷入烦恼……"},{"spoiler":false,"text":"「停滞不会产生任何东西。就算你站在那里，也只不过是浪费时间而已」"}],"source":"bangumi","sourceCharacterId":"11378"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"15056","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"15056","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"15056","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"15056","sourceWorkId":"12720","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"waist":[{"comparisonValue":"54","source":"vndb","sourceCharacterId":"c7695","value":"54"},{"comparisonValue":"57","scope":"sourceWork","source":"egs","sourceCharacterId":"15056","sourceWorkId":"12720","value":"57"},{"comparisonValue":"57","source":"bangumi","sourceCharacterId":"11378","value":"57"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/165d00aa28b94c56842e4a261b306560c039ec821c52f551f53e35d8ac022b3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0dc81977aa19a7de45e89aeb193b90e52dfab669c257dce50643e03d788a41bc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅川悠","creatorId":"vndb:s81","sourcePersonId":"vndb:s81","canonicalEntityId":"vndb:s81","name":"浅川 悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11526:11378:3958:1","source":"bangumi"}]},{"characterId":"char_c7696","characterName":"八城 つばさ","sourceIds":{"bangumi":[{"characterId":"11379","match":"exact-normalized-name-in-linked-work","subjectId":"11526"}],"egsCharacterIds":["15057"],"vndbCharacterId":"c7696"},"originalCharacterName":"八城 つばさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1218"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同学年で同じクラス、2-B所属。"},{"spoiler":false,"text":"まじめで融通が利かない性格で、口うるさいクラス委員長タイプ（ただし、委員長ではない）。"},{"spoiler":false,"text":"文武両道をモットーとし、中学までは剣道を習っていた。"},{"spoiler":false,"text":"CUQメンバーとは良く口喧嘩になるのだが、特に不仲というわけではなく、何かと理由をつけては一緒にいる事が多い。"},{"spoiler":false,"text":"秋零学園にはフェンシング部しか無いので部活には無所属だったのだが、成り行きから勇者部に入れられてしまう。"},{"spoiler":false,"text":"勇者部では得意の剣道と使命に忠実な正直さが買われ、切り込み隊長的ポジションを任されているようだ。"},{"spoiler":false,"text":"「もーっ、この連中ふざけすぎ！　少しは自重しなさいよね」"}],"source":"egs","sourceCharacterId":"15057","sourceWorkId":"12720","spoiler":false},{"segments":[{"spoiler":false,"text":"与主人公同学年同班。"},{"spoiler":false,"text":"性格一本正经不讲融通，多嘴的班长类型（虽然不是班长）。"},{"spoiler":false,"text":"以文武双全为信条，中学以前学过剑道。"},{"spoiler":false,"text":"与優菜是进入秋零以来的好友，因为这层关系与主人公他们一团老是纠缠在一起。"},{"spoiler":false,"text":"和CUQ成员虽然老是吵架，但并不是关系不好，有事没事就会找理由在一起。"},{"spoiler":false,"text":"在来秋零之前加入的是剑道部，但因为秋零学园只有击剑部，没有参加社团活动。顺水推舟进入了勇者部。"},{"spoiler":false,"text":"在勇者部得意的剑道与忠实于使命的笨蛋一根筋得到了评价，被赋予冲锋陷阵队长般的职位。"},{"spoiler":false,"text":"「真是，这帮家伙太乱来了！　稍微给我自重点好不好」"}],"source":"bangumi","sourceCharacterId":"11379"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"15057","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"15057","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"15057","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"15057","sourceWorkId":"12720","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf1e5006f11151c04dc5ed4c992ea430e04ce2249bbf8bb79441e489ad1f3692.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9acd03ae9cd03519d8c3cc54e4b7fb7b8f840550d9897246cdef936d863b26d3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神田理江","creatorId":"vndb:s858","sourcePersonId":"vndb:s858","canonicalEntityId":"vndb:s858","name":"神田 理江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11526:11379:4618:1","source":"bangumi"}]},{"characterId":"char_c7697","characterName":"七瀬 優菜","sourceIds":{"bangumi":[{"characterId":"11380","match":"exact-normalized-name-in-linked-work","subjectId":"11526"}],"egsCharacterIds":["15058"],"vndbCharacterId":"c7697"},"originalCharacterName":"七瀬 優菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"120"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同学年で同じクラス、2-B所属。"},{"spoiler":false,"text":"主人公の幼馴染で、幼少時は家族ぐるみの付き合いをしていたが、家庭の事情で引っ越してからは会う事が無かった。"},{"spoiler":false,"text":"秋零学園入学時に主人公と再会したが、そこからは長いブランクを感じさせない程の息が合った幼馴染みぶりを発揮している。"},{"spoiler":false,"text":"特に、主人公の行動の三歩先を読んでいるかのような気の利いたフォローは「熟年の夫婦でも敵わない」と学園内で評判になっている。"},{"spoiler":false,"text":"おだやかで人当たりが良いせいか、男子生徒達の人気も非常に高い。"},{"spoiler":false,"text":"料理が得意で、最近はケーキ作りに凝っているらしい。"},{"spoiler":false,"text":"「あ、憩ちゃん、無理しなくてもいいの、ほんとのほんとに」"}],"source":"egs","sourceCharacterId":"15058","sourceWorkId":"12720","spoiler":false},{"segments":[{"spoiler":false,"text":"与主人公同学年同班。"},{"spoiler":false,"text":"主人公的青梅竹马，小时候有着家庭间的交往，但因为家庭原因搬家之后没有再见面。"},{"spoiler":false,"text":"入学秋零学园时与主人公再会，之后发挥了让人感觉不到长时间空白期的青梅竹马同步率。"},{"spoiler":false,"text":"特别是，仿佛料到了主人公三步后的行动的贴心的圆场，在学园内得到了「中年夫妇也汗颜」的评价。"},{"spoiler":false,"text":"因为性格稳重擅于待人接物的关系么，在男生中的人气也非常高。"},{"spoiler":false,"text":"擅长料理，最近貌似在专心研究做蛋糕。"},{"spoiler":false,"text":"「啊、小憩、不用勉强，真的真的」"}],"source":"bangumi","sourceCharacterId":"11380"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"15058","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"15058","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"15058","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"15058","sourceWorkId":"12720","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b9d3b4d7acb392d9b73dd67886f04bab75395c133e20fa157899405fe37e992.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77ed75f7efd93a8796245138bd8e5aa75c2e8e6087ad3b259c74b9b4c01aee32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11526:11380:4705:1","source":"bangumi"}]},{"characterId":"char_c7698","characterName":"ちょこ先生","sourceIds":{"bangumi":[{"characterId":"11381","match":"exact-normalized-name-in-linked-work","subjectId":"11526"}],"egsCharacterIds":["15059"],"vndbCharacterId":"c7698"},"originalCharacterName":"ちょこ先生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"507"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"66"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"140cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"64"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公達のクラスの担任（物理の教師）。"},{"spoiler":false,"text":"チビっ子的外見なので年齢は不詳だが、本人曰く「大人のオンナ」「淑女（レディ）」。"},{"spoiler":false,"text":"生徒達からは「ちょこ先生」と呼ばれ、からかわれつつも親しまれている。"},{"spoiler":false,"text":"性格は破天荒の一言で、授業内容は気分次第でコロコロと変わる。"},{"spoiler":false,"text":"学園に魔王が出現してからは「勇者部」の顧問に就任するが、魔王退治よりももっぱら、その絶大な権限をいかに遊びに流用できるかを日々考えている。"},{"spoiler":false,"text":"「あたしは淑女（レディ）なんだよ！　それ相応に扱うのが、大人のマナーってもんだろーが！」"}],"source":"egs","sourceCharacterId":"15059","sourceWorkId":"12720","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公他们的班主任（物理教师）。"},{"spoiler":false,"text":"外貌萝莉年龄不详，本人自称『成人女性』『淑女（Lady）』。"},{"spoiler":false,"text":"被学生们称呼为『ちょこ老师』，在被取笑的同时也被亲近着。"},{"spoiler":false,"text":"性格一言以蔽之，破天荒。上课内容随着心情变化千变万化。"},{"spoiler":false,"text":"内心基本上是萝莉水平，非常喜欢电视游戏等全部玩具，不可思议的事与甜食。"},{"spoiler":false,"text":"魔王出现于学园之后就任『勇者部』的顾问，但比起消灭魔王，整天主要还是在考虑如何将这绝大的权限挪用到游玩上去。"},{"spoiler":false,"text":"「我可是淑女（Lady）唷！　恰如其分地对待我，才是成人礼节的说！」"}],"source":"bangumi","sourceCharacterId":"11381"}],"profileFacts":[{"label":"胸围（本版本）","value":"66 cm","valueContext":null,"source":"egs","sourceCharacterId":"15059","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"140 cm","valueContext":null,"source":"egs","sourceCharacterId":"15059","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"15059","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"47 cm","valueContext":null,"source":"egs","sourceCharacterId":"15059","sourceWorkId":"12720","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9d8da222d049f349412e4d39c6f5639796521db02066d9f1868d53f8bbe28cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32589f9958de62c87e1d2401cea557fd98ee8d2e26ca28188cbef3d3e6d83818.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11526:11381:4490:1","source":"bangumi"}]},{"characterId":"char_c7699","characterName":"リセリシアス・ハンドレッド・霧ヶ崎","sourceIds":{"bangumi":[{"characterId":"11382","match":"exact-normalized-name-in-linked-work","subjectId":"11526"}],"egsCharacterIds":["15060"],"vndbCharacterId":"c7699"},"originalCharacterName":"リセリシアス・ハンドレッド・霧ヶ崎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"328"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is in the same grade as the protagonist but in a different class."},{"spoiler":false,"text":"She is a member of Class 2-D."},{"spoiler":false,"text":"As the granddaughter of the chairman, she is so well-known within the school that she and Kuyou Sarasa are often referred to as the “Twin Towers.”"},{"spoiler":false,"text":"She is reserved and quiet, and her kind and gentle demeanor toward everyone makes her very popular among the students."},{"spoiler":false,"text":"She was born with a frail body and usually recuperates in a special room attached to the dormitory, so she is rarely seen on campus."},{"spoiler":false,"text":"Perhaps because of this, she is regarded as a sheltered young lady who embodies both mystery and fragility, and seems to have a small but passionate fan base."},{"spoiler":false,"text":"Her hobby is gardening, and she grows many flowers in the greenhouse on the rooftop of the Dormitory’s special wing and in her own room."},{"spoiler":false,"text":"On days when she cannot go to school, gazing out the window of her room is her only pleasure."}],"source":"vndb","sourceCharacterId":"c7699"},{"segments":[{"spoiler":false,"text":"主人公と同学年で別のクラス、2-D所属。"},{"spoiler":false,"text":"秋零学園理事長の孫で、九曜更紗とツインタワーと言われる有名人。"},{"spoiler":false,"text":"控えめで大人しく、誰にでも優しく接する事が出来る性格の為、生徒達の人気は高い。"},{"spoiler":false,"text":"生まれつき体が弱く、普段は寮に併設された特別室で療養しており、たまにしか学園に姿を見せない。"},{"spoiler":false,"text":"そのせいか神秘さとはかなさを兼ね備えた深窓の令嬢として、一部に熱狂的なファンがいるようだ。"},{"spoiler":false,"text":"趣味は園芸で、秋零寮特別棟屋上にある温室と自室で沢山の花を育てている。"},{"spoiler":false,"text":"「機会がありましたら是非、お茶をご馳走させてください」"}],"source":"egs","sourceCharacterId":"15060","sourceWorkId":"12720","spoiler":false},{"segments":[{"spoiler":false,"text":"与主人公同学年不同班。"},{"spoiler":false,"text":"秋零学园理事长的孙女，在学园内的知名度是与九曜更紗并称双塔的有名人。"},{"spoiler":false,"text":"性格内敛文静，对谁都很温柔，在学生中的人气很高。"},{"spoiler":false,"text":"天生体弱，平常在并设在宿舍里的特别室里疗养，偶尔会在学园现身。"},{"spoiler":false,"text":"因此作为兼具神秘性与梦幻性的深闺千金，貌似有着一部分狂热粉丝。"},{"spoiler":false,"text":"兴趣是园艺，在位于秋零宿舍特别栋屋顶的温室与自室里养育着许多花卉。"},{"spoiler":false,"text":"没法去学园的日子，从自室的窗口眺望远处的风景是唯一的乐趣。"},{"spoiler":false,"text":"「有机会的话请务必让我招待您喝茶」"}],"source":"bangumi","sourceCharacterId":"11382"}],"profileFacts":[{"label":"胸围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"15060","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"15060","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"15060","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"15060","sourceWorkId":"12720","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d36ffa2aaa4a14d1175800e3f6efe4b9269cc9d909b2ae279c8b82a89f11b7fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f90fbe9cb7c9a0062411ed30b9110c1a8d18754c8684f1b2b2d2c4e269a610ff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11526:11382:4646:1","source":"bangumi"}]},{"characterId":"char_c7701","characterName":"三条寺 忍","sourceIds":{"bangumi":[{"characterId":"88953","match":"exact-normalized-name-in-linked-work","subjectId":"11526"}],"egsCharacterIds":["15064"],"vndbCharacterId":"c7701"},"originalCharacterName":"三条寺 忍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1126"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の1学年下の1年生、1-E所属。"},{"spoiler":false,"text":"見た目は女の子だが、れっきとした男子。"},{"spoiler":false,"text":"CUQの中では弟分的存在（絶対に女の子扱いはしない）。"},{"spoiler":false,"text":"主人公とは中学校時代からの親友で、「センパイ」と呼んで慕ってくる。"},{"spoiler":false,"text":"服装は女子のものを愛用し、制服も女子用を身に着けている（学園からは許可をもらっている）。"},{"spoiler":false,"text":"ゲーム等、インドア系の遊びが得意で、ネットなどにも詳しい。"},{"spoiler":false,"text":"「だってオトコノコだもんっ。色々と準備が大変なんだよー」"}],"source":"egs","sourceCharacterId":"15064","sourceWorkId":"12720","spoiler":false},{"segments":[{"spoiler":false,"text":"三条寺 忍 （さんじょうじ しのぶ）　CV：北都南"},{"spoiler":false,"text":"身長：162cm　血液型：A　誕生日：11月26日"},{"spoiler":false,"text":"主人公の1学年下の1年生。1－E所属。"},{"spoiler":false,"text":"見た目は女の子だが、れっきとした男子。"},{"spoiler":false,"text":"CUQの中では弟分的存在（絶対に女の子扱いはしない）。"},{"spoiler":false,"text":"主人公とは中学校時代からの親友で、『センパイ』と呼んで慕ってくる。"},{"spoiler":false,"text":"服装は女子のものを愛用し、制服も女子用を身に着けている（学園からは許可をもらっている）。"},{"spoiler":false,"text":"ゲーム等、インドア系の遊びが得意で、ネットなどにも詳しい。"},{"spoiler":false,"text":"「だってオトコノコだもんっ。色々と準備が大変なんだよー」"}],"source":"bangumi","sourceCharacterId":"88953"}],"profileFacts":[{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"15064","sourceWorkId":"12720","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c7701","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"15064","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"15064","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"88953","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/t