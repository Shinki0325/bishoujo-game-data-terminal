15061","sourceWorkId":"12720","spoiler":false},{"segments":[{"spoiler":false,"text":"与主人公同学年同班。"},{"spoiler":false,"text":"一开口就停不下来的性格，建立报道部（非公认）独自进行活动的元气娘。"},{"spoiler":false,"text":"梦想是成为记者，但因为对事情不会深思熟虑，用独自的解释来指摘事物的关系，很难说有那方面的才能。"},{"spoiler":false,"text":"虽然有着搞砸都是别人的责任，功劳全是自己的东西的生存方式，但因为很脑残的语调的关系么，并不会让人觉得不快，很赚的定位。"},{"spoiler":false,"text":"在报道部制作新闻独自进行校内放送，进行着同好会一般的活动，为了让其作为部被承认日日追逐着刺激的独家新闻。"},{"spoiler":false,"text":"这时，从天而降的魔王骚动对她来说正是绝好的目标。"},{"spoiler":false,"text":"「总有一天四堂梢的名字一定会烙印在你的照相机（心）里，做好觉悟吧！」"}],"source":"bangumi","sourceCharacterId":"11383"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"15061","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"15061","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"15061","sourceWorkId":"12720","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"15061","sourceWorkId":"12720","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af7bbc6d18a85decf32a37476b0adea61b453fd0dab395f9e3213f02b2ca12f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/159b29cc8885ed3c1661cfae20f54c44f144102b68dca835ca6042221e22e57d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松元恵","creatorId":"egs:creator:8999","sourcePersonId":"egs:creator:8999","canonicalEntityId":"egs:creator:8999","name":"松元恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11526:11383:4515:1","source":"bangumi"},{"creditedName":"守田 羽糸","creatorId":"vndb:s882","sourcePersonId":"vndb:s882","canonicalE