{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6650","model":{"presentationWorkId":"vndb:v8081","staff":{"artwork":[{"creditedName":"玉姫金魚","creatorId":"vndb:s1082","sourcePersonId":"egs:creator:2333","canonicalEntityId":"vndb:s1082","name":"玉姫金魚","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13259","source":"egs"}],"scenario":[{"creditedName":"仁村紳志","creatorId":"vndb:s1608","sourcePersonId":"egs:creator:2163","canonicalEntityId":"vndb:s1608","name":"仁村紳志","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13260","source":"egs"},{"creditedName":"さんきち","creatorId":"vndb:s2812","sourcePersonId":"vndb:s2812","canonicalEntityId":"vndb:s2812","name":"さんきち","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:75674","source":"vndb"}],"music":[],"other":[{"creditedName":"ウシ子(うし子)","creatorId":"vndb:s2810","sourcePersonId":"egs:creator:1442","canonicalEntityId":"vndb:s2810","name":"ウシ子(うし子)","detail":"企画、原案","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:186587","source":"egs"}]},"cast":[{"characterId":"char_c24844","characterName":"沢井 郁美","sourceIds":{"bangumi":[{"characterId":"192333","match":"exact-normalized-name-in-linked-work","subjectId":"269957"},{"characterId":"192333","match":"exact-normalized-name-in-linked-work","subjectId":"269989"}],"egsCharacterIds":["21209"],"vndbCharacterId":"c24844"},"originalCharacterName":"沢井 郁美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大学を優秀な成績で卒業し、現在は大学病院で研修医として働く女性。"},{"spoiler":false,"text":"大学時代、音露と交際していたが、仕事が忙しくなっていったことで疎遠になった。"},{"spoiler":false,"text":"性格は、優しく穏やかなで、何事も慎重に進めていくタイプ。"},{"spoiler":false,"text":"今回、どのようなかたちで音露に絡んでいくのか……。"}],"source":"egs","sourceCharacterId":"21209","sourceWorkId":"6650","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の元恋人にして、レイプ犯になった原因を作った女性。"},{"spoiler":false,"text":"現在は、出身大学の付属病院の女医として勤務している。"},{"spoiler":false,"text":"穏やかで優しく、真面目な性格で、患者にも親身になって世話をする。"},{"spoiler":false,"text":"一児の母でもあるが、何かの事情で一人身。"},{"spoiler":false,"text":"その一人息子・夜叉を何よりも大事に考え、息子のためならどんなことでも耐えられる心の強さを持つ。"}],"source":"egs","sourceCharacterId":"21209","sourceWorkId":"8965","spoiler":false},{"segments":[{"spoiler":false,"text":"穏やかで優しい性格。大らかな心の持ち主で、音露と恋人関係であった頃は、彼のすべてを受け入れていた。非常に真面目で患者に親身になるあまり、オーバーワークになりがち。今ではシングルマザーとして、子供を守るためなら、どんなに打たれても折れない強い芯を持っている。"},{"spoiler":false,"text":"音露がレイプ魔となった原因の女性であり、初めて音露にレイプされた被害者でもある。大学を優秀な成績で卒業し、出身大学の付属病院で研修医として働いたあと、そのまま女医として勤務している。"},{"spoiler":false,"text":"一人息子の『夜叉（やしゃ）』のことをなによりも大事にしている、一児の母。しかし、なにか事情があるらしく、現在は独身。"},{"spoiler":false,"text":"「……毒島くん、本当にあなたなの？」"}],"source":"bangumi","sourceCharacterId":"192333"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d8ffb24c72b85bf43726f01ff15aad02d91d226fba369f3c4716047925d6f3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ac1844cde2e5ffde229d7718cf677ebdbacd2d256373899c8bde20a3fc54d3a.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269989:192333:4489:1","source":"bangumi"}]},{"characterId":"char_vndb_c24842","characterName":"日向 唯子","sourceIds":{"vndbCharacterId":"c24842"},"originalCharacterName":"日向 唯子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-