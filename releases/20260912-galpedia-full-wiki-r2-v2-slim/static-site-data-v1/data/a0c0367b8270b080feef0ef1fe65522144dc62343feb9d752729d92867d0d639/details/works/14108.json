lationId":"vndb:vn-staff:56215","source":"vndb"},{"creditedName":"表本 裕二","creatorId":"vndb:s4130","sourcePersonId":"vndb:s4130","canonicalEntityId":"vndb:s4130","name":"表本 裕二","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:56219","source":"vndb"}]},"cast":[{"characterId":"char_c44639","characterName":"相澤 まひる","sourceIds":{"bangumi":[{"characterId":"39936","match":"exact-normalized-name-in-linked-work","subjectId":"14257"}],"egsCharacterIds":["17895"],"vndbCharacterId":"c44639"},"originalCharacterName":"相澤 まひる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小五郎の幼なじみでクラスメイト。美能台学園２年生。"},{"spoiler":false,"text":"明るくて元気、男子の友人も多いムードメーカー。勉強は少し苦手…やる気になれば出来る子。"},{"spoiler":false,"text":"素直じゃないため、つい否定的に言ってしまった言葉を小五郎にストレートに取られて苦悩することが多い。"},{"spoiler":false,"text":"小五郎のことが好きなのは周囲にバレバレなのだが、本人はバレてないと思っている。"},{"spoiler":false,"text":"何故なら、小五郎自身にそれが全く伝わっていないから。"},{"spoiler":false,"text":"弓道部に所属しているが、ゲーム好きのためサボりがち。それをよく小五郎に咎められる。"},{"spoiler":false,"text":"「あたし、コゴローほど真面目じゃないし。っていうか朝から数式と睨めっこなんてしたくないってば！」"},{"spoiler":false,"text":"「あ、あのね、そもそも幼馴染がこうやって朝起こしに来てるんだし、もうちょっと嬉しそうにしなさいよ」"}],"source":"egs","sourceCharacterId":"17895","sourceWorkId":"14108","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・小五郎の幼なじみ。"},{"spoiler":false,"text":"美能台学園2年生。弓道部所属。"},{"spoiler":false,"text":"天真爛漫でムードーメーカー。"},{"spoiler":false,"text":"小五郎のことが好きなのだが、素直じゃないのでまったく伝わってない。"},{"spoiler":false,"text":"「あ、あのね、そもそも幼馴染がこうやって朝起こしに来てるんだし、もうちょっと嬉しそうにしなさいよ。」"}],"source":"bangumi","sourceCharacterId":"39936"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/034cce37b9aad7f02715f8d015c3219907b08414a184b1280bc75d5a3b09b7fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/331f0d5c1bebeae8295ca41cdcb699fd6e98bb81eaf5a3ac785a24cd813fcf07.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14257:39936:22331:1","source":"bangumi"}]},{"characterId":"char_c44640","characterName":"相澤 悠","sourceIds":{"bangumi":[{"characterId":"39937","match":"exact-normalized-name-in-linked-work","subjectId":"14257"}],"egsCharacterIds":["17896"],"vndbCharacterId":"c44640"},"originalCharacterName":"相澤 悠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"まひるの妹で、小五郎の幼なじみ。美能台学園１年生。"},{"spoiler":false,"text":"大人しくて読書家。運動が苦手な典型的な文系少女。"},{"spoiler":false,"text":"小五郎が一目置くほど博学なため、小五郎からまひるのように小うるさく「運動しろ」と言われない。"},{"spoiler":false,"text":"無意味に動物に好かれる体質（？）であり、彼女が外で読書をしていると猫などが集まってくる。"},{"spoiler":false,"text":"好きなもののセンスが少々特殊。"},{"spoiler":false,"text":"小五郎に対しては、姉のまひるよりも一歩引いた態度を取っている。"},{"spoiler":false,"text":"「はぁ……あのお家の鬼瓦、かっこいいかも……うっとり……」"},{"spoiler":false,"text":"「うーん、そこはちょっとだけ、他意っていうものが入っててもよかったかも、です」"}],"source":"egs","sourceCharacterId":"17896","sourceWorkId":"14108","spoiler":false},{"segments":[{"spoiler":false,"text":"まひるの妹。"},{"spoiler":false,"text":"大人しくて可憐。だが芯は強い。"},{"spoiler":false,"text":"読書好きで、とても博学。 なぜか動物にやたら好かれる体質。"},{"spoiler":false,"text":"小五郎には姉より一歩引いた態度を取る。"},{"spoiler":false,"text":"「ず、ずるいです、反則です。そんな風に言われたら、また好きになっちゃうじゃないですか……」"}],"source":"bangumi","sourceCharacterId":"39937"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6d480434c2920516788d8c02d1fe86661e34e8c605137511f65d2cda0192da6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a6ed0f8a2b16ac402b929f34ee3670e95dd38a4a51a82927e1f26ca96ce3cef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水神楓","creatorId":"vndb:s1493","sourcePersonId":"vndb:s1493","canonicalEntityId":"vndb:s1493","name":"水神 楓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14257:39937:22644:1","source":"bangumi"}]},{"characterId":"char_c44641","characterName":"屏風ヶ浦 麻美","sourceIds":{"bangumi":[{"characterId":"39938","match":"exact-normalized-name-in-linked-work","subjectId":"14257"}],"egsCharacterIds":["17897"],"vndbCharacterId":"c44641"},"originalCharacterName":"屏風ヶ浦 麻美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大財閥の娘。美能台学園３年生で、学校の生徒会長。"},{"spoiler":false,"text":"容姿端麗で、勉強も出来る、生徒みんなの憧れの的。"},{"spoiler":false,"text":"それも全て生徒会長としての責務を果たすため、生徒の模範人物になろうとする、影の努力の賜物。"},{"spoiler":false,"text":"…が、実はとても打たれ弱く、ちょっとの事で直ぐにへこんでしまう。"},{"spoiler":false,"text":"そんな彼女をサポートをすべく、右央と左央の２人がいつも本人の近くに居る。"},{"spoiler":false,"text":"小五郎を次期生徒会長にしようとアプローチをかけてくるが、毎度うまくいかない。"},{"spoiler":false,"text":"「来年の生徒会を、しいては全校生徒を率いるのは、コゴローさん以外におりませんわ」"},{"spoiler":false,"text":"「私が、生徒の理想刑……？　あ、あぁ、私はそのような立派な人間では……」"}],"source":"egs","sourceCharacterId":"17897","sourceWorkId":"14108","spoiler":false},{"segments":[{"spoiler":false,"text":"大財閥の娘で、小五郎やまひるの1年先輩。"},{"spoiler":false,"text":"容姿端麗。学生会会長を務めており、模範学生であろうと影で努力している。"},{"spoiler":false,"text":"次期会長に小五郎を推挙しているが……。"},{"spoiler":false,"text":"「……どうしましょう。個人的に、彼のことを知りたくなってきましたわ……」"}],"source":"bangumi","sourceCharacterId":"39938"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40322ddaefff29e1b5a44d55d39d780dddf3bc9f5dc47f4896d310e48aa6a705.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13b7d38377cb3dd0f0aeb996b4aec74502054ab437a30ed81bafe19568adeb27.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中美智","creatorId":"vndb:s796","sourcePersonId":"vndb:s796","canonicalEntityId":"vndb:s796","name":"田中美智(多田美智)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14257:39938:6313:1","source":"bangumi"}]},{"characterId":"char_c44642","characterName":"間宮 メイ","sourceIds":{"bangumi":[{"characterId":"39939","match":"exact-normalized-name-in-linked-work","subjectId":"14257"}],"egsCharacterIds":["17898"],"vndbCharacterId":"c44642"},"originalCharacterName":"間宮 メイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美能台学園にやってきた新任化学教師。"},{"spoiler":false,"text":"中学生並みに背が小さく、「かわいい！」と呼ばれるのにも慣れたもの。"},{"spoiler":false,"text":"生徒達とは友達のようなフランクな付き合いで気楽に行こうと考えているが、小五郎にはそれが理解できず、「教師と生徒」という主従関係を崩さない。"},{"spoiler":false,"text":"「教師」という職業にあまりやる気が無い様子の彼女は、彼の教育論の追及に戸惑うばかり。"},{"spoiler":false,"text":"彼女なりの理由が、何かあるのだと思うのだが…。"},{"spoiler":false,"text":"「はい、間宮メイですっ！　今日からしばらく化学を担当するから、みんなよろしくねっ！」"},{"spoiler":false,"text":"（もうちょっとテキトーにやりたかったんだけどなぁ。それこそみんなのオトモダチ、って感じでさ）"}],"source":"egs","sourceCharacterId":"17898","sourceWorkId":"14108","spoiler":false},{"segments":[{"spoiler":false,"text":"新任教師で化学担当。"},{"spoiler":false,"text":"背がとても小さい。"},{"spoiler":false,"text":"それに合わせて（？） 子供っぽく、気楽に学生と交流したいと思っている。"},{"spoiler":false,"text":"なぜか教師という仕事にやる気が無い。"},{"spoiler":false,"text":"「もうちょっとテキトーにやりたかったんだけどなぁ。それこそみんなのオトモダチ、って感じでさ。」"}],"source":"bangumi","sourceCharacterId":"39939"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c37accea93411d8bd9a01cc9d944a6ab0bcbcde40fd338aa74aa152936d8f22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/336ebbb0216ffb7aea554268e8b2b127fb57a54999843326aba7e1fc355b39af.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由宇翼","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"あさり☆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14257:39939:18193:1","source":"bangumi"}]},{"characterId":"char_c44645","characterName":"ユッキー","sourceIds":{"bangumi":[],"egsCharacterIds":["17900"],"vndbCharacterId":"c44645"},"originalCharacterName":"ユッキー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美能台学園２年生で、小五郎やまひるのクラスメイト。"},{"spoiler":false,"text":"女好きでナンパな性格であるが、実は小五郎の剣道のライバルであり、実力は非常に高い。"},{"spoiler":false,"text":"過去に剣の道に縛られすぎた反動で、現在は青春を謳歌しているようだ。"},{"spoiler":false,"text":"昔と相変わらずお堅い小五郎や、彼を好いているまひるのことを心配する、根はとてもいいヤツ。"},{"spoiler":false,"text":"「少しは肩の力抜けって。そんなんじゃ空気中で窒息しちまうぞ？」"},{"spoiler":false,"text":"「おめぇもたまには、俺のギャグに付き合えよ……」"}],"source":"egs","sourceCharacterId":"17900","sourceWorkId":"14108","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/900d33b62f19689c6c32de135f04b8f