:"vndb:vn-staff:132260","source":"vndb"},{"creditedName":"〆鯖コハダ","creatorId":"vndb:s6483","sourcePersonId":"vndb:s6483","canonicalEntityId":"vndb:s6483","name":"〆鯖コハダ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132261","source":"vndb"}]},"cast":[{"characterId":"char_c37388","characterName":"皆坂 亞璃絵","sourceIds":{"bangumi":[{"characterId":"63099","match":"exact-normalized-name-in-linked-work","subjectId":"41356"}],"egsCharacterIds":["11137"],"vndbCharacterId":"c37388"},"originalCharacterName":"皆坂 亞璃絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公・連の幼馴染。"},{"spoiler":false,"text":"メイガスオーダー（精鋭部隊の魔道官）候補生。"},{"spoiler":false,"text":"眉目秀麗、成績優秀な学園のアイドル的存在。"},{"spoiler":false,"text":"唯一苦手とするのが水泳。"},{"spoiler":false,"text":"メイガスオーダーに選ばれたことを誇りに思っている。"},{"spoiler":false,"text":"そのため、幼馴染でありながらいきなり教官となって赴任してきた連に対し、ライバル心を燃やす。"},{"spoiler":false,"text":"アーティファクト （魔導器） は 「キュプクロスの瞳」 と呼ばれる杖。"},{"spoiler":false,"text":"C.O.C （固有の魔法紋章） は槍。"},{"spoiler":false,"text":"魔力を圧縮し粒子砲として打ち出すことができ、遠～中距離戦では絶大な戦闘力を発揮する。"},{"spoiler":false,"text":"「あんたが新任教師!?　そんなの、認めるわけないでしょ！」"}],"source":"egs","sourceCharacterId":"11137","sourceWorkId":"13644","spoiler":false},{"segments":[{"spoiler":false,"text":"「サークルオブドゥーム」を連と共に戦い抜いたメイガスオーダー。"},{"spoiler":false,"text":"同じく終戦に大きな役割を果たしたイスカや天王寺こなたと共に、トライヴァナディーズと呼ばれるようなる。"},{"spoiler":false,"text":"現在では、キャメロットマグナの理事長、そして厳格なメイガスオーダーとして過酷な任務に率先して当たっている。"},{"spoiler":false,"text":"澪のことを理解しているが、澪に移した魂を戻さない限り連が戻ることはないことから、幼馴染み兼恋人の立場である亞璃絵は複雑な感情を常に抱いている。"},{"spoiler":false,"text":"アーティファクト(錬成器)はキュプクロスの瞳の銘を持つ杖"},{"spoiler":false,"text":"巨大なエリクサージュエルがはめ込まれており魔力を粒子砲のように打ち出す事ができ、その威力は一撃でサーキュラーズの群れを殲滅するほど。"},{"spoiler":false,"text":"味方の拠点防衛にも敵の拠点壊滅にも絶大な力を発揮する。"},{"spoiler":false,"text":"最強のメイガスオーダーの一人。"}],"source":"egs","sourceCharacterId":"11137","sourceWorkId":"23597","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・連の幼なじみ、メイガスオーダー （精鋭部隊の魔道官） 候補生。"},{"spoiler":false,"text":"眉目秀麗、成績優秀な学園のアイドル的存在。"},{"spoiler":false,"text":"唯一苦手とするのが水泳。"},{"spoiler":false,"text":"メイガスオーダーに選ばれたことを誇りに思っている。"},{"spoiler":false,"text":"そのため、幼なじみでありながらいきなり教官となって赴任してきた連に対し、ライバル心を燃やす。"},{"spoiler":false,"text":"アーティファクト （魔導器） は 『キュプクロスの瞳』 と呼ばれる杖。"},{"spoiler":false,"text":"C.O.C （固有の魔法紋章） は槍。魔力を圧縮し粒子砲として打ち出すことができ、遠～中距離戦では絶大な戦闘力を発揮する。"},{"spoiler":false,"text":"「あんたが新任教師!?　そんなの、認めるわけないでしょ！」"}],"source":"bangumi","sourceCharacterId":"63099"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"63099","value":"猫などの小動物系"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"63099","value":"水泳"},{"label":"特技・趣味","source":"bangumi","sourceCharacterId":"63099","value":"料理"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9723770ee86004c16eb7301194f80b99fec65dd2fbbaf2be4154866079aa0334.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edbc7189fabd978ab568b097717bb250df0a3c2f499750697c90553c4a9f014f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180011:63099:5907:1","source":"bangumi"}]},{"characterId":"ch