calEntityId":"vndb:s9623","name":"桂井よしあき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:113344","source":"vndb"},{"creditedName":"すぱな","creatorId":"vndb:s10633","sourcePersonId":"vndb:s10633","canonicalEntityId":"vndb:s10633","name":"すぱな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:113345","source":"vndb"}]},"cast":[{"characterId":"char_c21287","characterName":"早辺あるる","sourceIds":{"bangumi":[{"characterId":"28637","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4981"],"vndbCharacterId":"c21287"},"originalCharacterName":"早辺あるる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"23"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sexual experience: None"},{"spoiler":false,"text":"The most popular mangaka of Comic Bottom who draws both pure love and erotic manga. She is hardworking and very serious about her job as she is always trying to be ahead of the deadlines or be precisely on time. However, for a long time she has wanted to draw different genres instead of just the same ones. With the help of the protagonist, her dream is finally coming true."}],"source":"vndb","sourceCharacterId":"c21287"},{"segments":[{"spoiler":false,"text":"「コミックボトム」で一番人気の女性漫画家。"},{"spoiler":false,"text":"真面目で締め切りをしっかり守る。"},{"spoiler":false,"text":"単行本が一冊出ていて、売り上げ的には中の下。"},{"spoiler":false,"text":"でもボトムでは看板作家。"},{"spoiler":false,"text":"純愛ラブラブエロ漫画しか描いていない。"},{"spoiler":false,"text":"先輩編集が別編集部へ移籍する時に誘われたが、はるるは「もっといろんなジャンルを描いてみたい！」"},{"spoiler":false,"text":"と、ボトムに残って主人公と共に以前からやってみたかった様々なジャンルを描く事に。"}],"source":"egs","sourceCharacterId":"4981","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"『Comic Bottom』里最有人气的女性漫画家。"},{"spoiler":false,"text":"虽然只画纯爱爱情黄漫，但牢牢地遵守着截止日期。"},{"spoiler":false,"text":"出了一册单行本，销售额在中下水平。但却是Bottom的看板作家。"},{"spoiler":false,"text":"前辈编辑转移到其他编辑部的时候被他邀请，但出于「想画更多种类的黄漫！」的理由留在了Bottom。"},{"spoiler":false,"text":"然后和主人公一起尝试绘画从以前起便想试着画一下的各种类型的黄漫。"},{"spoiler":false,"text":"「如果要我明确说明的话，我想画色色的……黄漫」"}],"source":"bangumi","sourceCharacterId":"28637"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"28637","value":"漫画家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbba03608433d40921295b98d4bf133a11927d3edb148051ce6b79a4614ead1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/054f9b1db106cdf0bd4d18285316cd3d4e0efc4512f1032524142ec53e8bf933.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28637:6046:1","source":"bangumi"}]},{"characterId":"char_c21288","characterName":"しましまねこ","sourceIds":{"bangumi":[{"characterId":"28638","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4982"],"vndbCharacterId":"c21288"},"originalCharacterName":"しましまねこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sexual experience: None"},{"spoiler":false,"text":"A young mangaka who has been trying to get her manga serialized in Comic Bottom for many times. She is pretty popular because of her eromanga which are serialized in other magazine, and thus, has gained confidence and believes to be the best. Has a pretty cheeky personality and wants things quickly, and due to this, she is always fighting with the protagonist."}],"source":"vndb","sourceCharacterId":"c21288"},{"segments":[{"spoiler":false,"text":"「コミックボトム」で連載をしようとする若手女性漫画家。"},{"spoiler":false,"text":"即売会で主人公が発掘した。"},{"spoiler":false,"text":"生意気な性格で、よく主人公に反発する。"},{"spoiler":false,"text":"エロくないエロマンガを描くので雑誌内での人気は低い。"},{"spoiler":false,"text":"が、イベントなどの即売会では人気が高い（可愛らしい絵柄と、自分自身のかわいさで接客しているため）。"},{"spoiler":false,"text":"若さゆえの根拠のない自信を振りかざしているが、本当は…？"}],"source":"egs","sourceCharacterId":"4982","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"打算在『Comic Bottom』连载的年轻女性漫画家。在即售会上主人公挖掘来的。"},{"spoiler":false,"text":"因为画不色的黄漫所以在杂志内人气很低。"},{"spoiler":false,"text":"但似乎在即售会上人气很高（因为可爱的画风和用自己的可爱魅力来待客的缘故）。"},{"spoiler":false,"text":"性格自大，经常反抗主人公。"},{"spoiler":false,"text":"举手投足间充满着初生牛犊不怕虎的自信，但其实……？"}],"source":"bangumi","sourceCharacterId":"28638"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"28638","value":"漫画家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe618387a0ea0a51cc42ca33dc791921a62c5d4e37d9e3fae251ed1148787c71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d3e13e15c99f2461a79b694eef68ea1d46d7d532df03e49d810534ce218c76f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28638:5928:1","source":"bangumi"}]},{"characterId":"char_c23420","characterName":"乙姫ララ","sourceIds":{"bangumi":[{"characterId":"28639","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4984"],"vndbCharacterId":"c23420"},"originalCharacterName":"乙姫ララ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"32"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sexual experience: None"},{"spoiler":false,"text":"A mangaka who has failed several times getting her manga serialized in Comic Bottom. In the past she used to make shoujo manga, but stopped after becoming older. Right now, Kaori wants to become a teen's love mangaka, but it's been hard because teen's love is a very broad genre and it's hard to narrow down into just one subject. However, her most biggest problem is that she's over 30 and still a virgin."}],"source":"vndb","sourceCharacterId":"c23420"},{"segments":[{"spoiler":false,"text":"「コミックボトム」で連載をする落ち目の女性漫画家。"},{"spoiler":false,"text":"かつては一般の少女漫画雑誌で連載していた事もあったが、年齢と共に撤退。"},{"spoiler":false,"text":"その後、ティーンズラブ漫画家として活動するが、ティーンズラブは門戸が狭すぎてやはりダメ。"},{"spoiler":false,"text":"漫画は好きで描き続けたいけどどうしようと悩んで、当時同じ出版社にいたデザイナーに相談。ボトムを紹介される。"},{"spoiler":false,"text":"基本的に今まで漫画以外の事にあまり興味はなかったので、３２歳現在も処女である。"},{"spoiler":false,"text":"原稿をアナログで描く。"}],"source":"egs","sourceCharacterId":"4984","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"在『Comic Bottom』 连载的背运女性漫画家。"},{"spoiler":false,"text":"以前也在一般的少女漫画杂志上连载过，但因为年龄撤退了。"},{"spoiler":false,"text":"之后作为少女向黄漫漫画家活动，但因为门户太窄还是放弃了。"},{"spoiler":false,"text":"喜欢漫画所以想继续画下去，但因为不知该怎么办而烦恼，和当时属于同一出版社的设计家商谈。被介绍到了Bottom。"},{"spoiler":false,"text":"因为之前基本上对漫画以外的事情不怎么感兴趣，32岁的如今仍是处子。"},{"spoiler":false,"text":"用模拟来画原稿。"}],"source":"bangumi","sourceCharacterId":"28639"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"28639","value":"漫画家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f1ea3c05840d8b1ab63211064a302577875608afd72f5a74cbe058ee2fc471f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8b10167e5561e7d8d1ca2277268cb315cdc60b05c68dad949491a8ffde0c918.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28639:5936:1","source":"bangumi"}]},{"characterId":"char_c23421","characterName":"宮原 尚生","sourceIds":{"bangumi":[{"characterId":"28640","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4983"],"vndbCharacterId":"c23421"},"originalCharacterName":"宮原 尚生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"23"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sexual experience: None"},{"spoiler":false,"text":"An editor who works for Comic Bottom, she has handled the public business relations for over two years now. She always tries to help everybody and anybody, and can't ignore a person in need of it."}],"source":"vndb","sourceCharacterId":"c23421"},{"segments":[{"spoiler":false,"text":"「コミックボトム」編集部がある出版社で営業広報を努める新人。"},{"spoiler":false,"text":"体育会系で、猪突猛進。"},{"spoiler":false,"text":"気になる事はそのまま放っておけないタイプ。"},{"spoiler":false,"text":"出版社に就職して二年目。"},{"spoiler":false,"text":"最初の一年はいろんな部署をたらいまわしにされ、空回りが多く使えない子なので厄介払いとばかりにコミック編集部担当営業になった。"},{"spoiler":false,"text":"本人は「会社に期待されてる…！」と思っていて、早くも空回りの予感。"}],"source":"egs","sourceCharacterId":"4983","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"在『Comic Bottom』编辑部所处的出版社担任营业宣传第二年的新人。"},{"spoiler":false,"text":"行动派，性格鲁莽。对在意的事情不能放着不管的类型。"},{"spoiler":false,"text":"还有经常空忙一场的派不上用场的孩子。"},{"spoiler":false,"text":"第一年在各种岗位之间团团转，为了赶走这个扫把星而担当了漫画编辑部的营业。"},{"spoiler":false,"text":"本人虽然想「被公司期待了…！」，但很快便有了又是空忙一场的预感。"}],"source":"bangumi","sourceCharacterId":"28640"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"28640","value":"营业宣传"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/613aabc2275516483bde7c8cee4d3488d6ac66ee05cf6adf12b8a46ab00251e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71b739a67ca5e7e84451343188d89222f97de03d59f5bb9a0723a02bc15b399c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28640:10027:1","source":"bangumi"}]},{"characterId":"char_c23422","characterName":"柏木 紅緒","sourceIds":{"bangumi":[{"characterId":"28641","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4985"],"vndbCharacterId":"c23422"},"originalCharacterName":"柏木 紅緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"38"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Comic Bottom's Chief Editor. At first she was supposed to be the Chief Editor of a gossip magazine, but was voted to be the next Chief Editor for Comic Bottom instead. Due to this, she has no motivation to make sure that the magazine will be a succesful one."}],"source":"vndb","sourceCharacterId":"c23422"},{"segments":[{"spoiler":false,"text":"「コミックボトム」の編集長を務める大柄な女性。"},{"spoiler":false,"text":"やる気のないだるい雰囲気をかもし出している。"},{"spoiler":false,"text":"元々は同じ出版社のゴシップ誌の編集だったが、コミックボトム創立時に編集長に選出された。"},{"spoiler":false,"text":"しかし自分のやりたい仕事ではないため、とにかくやる気がない。"},{"spoiler":false,"text":"雑誌さえ潰れなければあとはどうでもいいと思っている。"}],"source":"egs","sourceCharacterId":"4985","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"担任『Comic Bottom』主编的高个女性。"},{"spoiler":false,"text":"浑身洋溢着毫无干劲的颓废氛围。"},{"spoiler":false,"text":"本来是同一出版社的八卦杂志的编辑，但在Comic Bottom创立时被选中当主编。"},{"spoiler":false,"text":"但因为不是自己想干的工作，所以总之毫无干劲。"},{"spoiler":false,"text":"只要杂志不被斩就怎样也无所谓。"}],"source":"bangumi","sourceCharacterId":"28641"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"28641","value":"Comic Bottom主编"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a2c612820cfa416388aa6d8858f0942e91fe671c2ce0ea739182e7ad5749bc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cd3b8cb6df40f68c52af49a8c87bcb67f0d0962d52d0dd9e570ea0ac851dc4a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28641:6131:1","source":"bangumi"}]},{"characterId":"char_c33953","characterName":"瑞鳥 大輔","sourceIds":{"bangumi":[{"characterId":"28645","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4989"],"vndbCharacterId":"c33953"},"originalCharacterName":"瑞鳥 大輔","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A friend of Kazuya's. It's hard to see it at a quick glance, but Midori is actually a boy, and his real name is Mizutori Daisuke, who works as a free graphic artist."}],"source":"vndb","sourceCharacterId":"c33953"},{"segments":[{"spoiler":false,"text":"美羽と組んでサークルで同人活動をしていた男の娘。"},{"spoiler":false,"text":"女装をしているので、ぱっと見た感じ女の子にしか見えないが、れっきとした男の子。"},{"spoiler":false,"text":"本名は瑞鳥大輔（みどり・だいすけ）。"},{"spoiler":false,"text":"本職はフリーグラフィッカー。"}],"source":"egs","sourceCharacterId":"4989","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"和美羽组团参加同人活动的伪娘。"},{"spoiler":false,"text":"因为穿着女装，外表像是个女孩，但是个确凿的男孩子。"},{"spoiler":false,"text":"本名瑞鳥大輔。本职是自由美工。"}],"source":"bangumi","sourceCharacterId":"28645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15262884b47d9209ac251cd7c68fab62e90d6372421f1067f3e9ab8204380052.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d162c18e8563a5a9444c8233236110b06d8b8e1f1e99a6dc42df810d0ae4abd0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎未來","creatorId":"vndb:s986","sourcePersonId":"vndb:s986","canonicalEntityId":"vndb:s986","name":"尾崎 未來","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28645:13776:1","source":"bangumi"}]},{"characterId":"char_c33954","characterName":"児玉 愛海","sourceIds":{"bangumi":[{"characterId":"28644","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4988"],"vndbCharacterId":"c33954"},"originalCharacterName":"児玉 愛海","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruru's full-time assistant. It's her job to go to Haruru's house to make sure that she isn't behind the deadlines. Even though she's an assistant, one day, she wants to make her own manga as well."}],"source":"vndb","sourceCharacterId":"c33954"},{"segments":[{"spoiler":false,"text":"はるるのところでアシスタントをしている女の子。専業アシスタントさん。"},{"spoiler":false,"text":"別の作家さんの所でもアシスタントをしていて、必要な時にははるるの家まで来る。"},{"spoiler":false,"text":"自分もいつか連載を持ちたいと思っているが、なかなかその機会には恵まれていない様子。"}],"source":"egs","sourceCharacterId":"4988","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"在はるる处担任专业助手的女孩。"},{"spoiler":false,"text":"也在其他作家处担任助手，必要的时候会到はるる家里来。"},{"spoiler":false,"text":"虽然也想有一天自己来连载，但似乎总是没机会的样子。"}],"source":"bangumi","sourceCharacterId":"28644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/549012cee9ebc7bd6b87da81f19b83b3876f8009f5a769809c44053392caa581.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5ff9063751948f2541e0566da19c7d89de0e8d16bbc4ca622b63ffd3c480fb2e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28644:5900:1","source":"bangumi"}]},{"characterId":"char_c33955","characterName":"白石 彩","sourceIds":{"bangumi":[{"characterId":"28642","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4986"],"vndbCharacterId":"c33955"},"originalCharacterName":"白石 彩","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A designer who works in the same company as the main girls, she is the one behind Comic Bottom's design. She is also an acquaintance of Kaori."}],"source":"vndb","sourceCharacterId":"c33955"},{"segments":[{"spoiler":false,"text":"主人公たちが勤めるフューチャーマガジン社でデザイナーをしている女性。"},{"spoiler":false,"text":"かつて香織が連載をしていた少女漫画雑誌のデザインをやっていたので、香織とは面識がある。"},{"spoiler":false,"text":"コミックボトムのデザインもやっている。"}],"source":"egs","sourceCharacterId":"4986","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"在主人公等人工作的Future Magazine社担任设计家的女性。"},{"spoiler":false,"text":"因为以前是香織连载的少女漫画杂志的设计者，所以和香織认识。"},{"spoiler":false,"text":"也会担任Comic Bottom的设计。"}],"source":"bangumi","sourceCharacterId":"28642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3b40c8cc588d2a23e510d8f0cddc58e52780481b69d4024dfda41c07b960b15.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7620aa0bab837a63752bf5c29392371079d893de256637ae7154e0bf464a27d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28642:12718:1","source":"bangumi"}]},{"characterId":"char_c33956","characterName":"佐々木 亮子","sourceIds":{"bangumi":[{"characterId":"28643","match":"exact-normalized-name-in-linked-work","subjectId":"121563"}],"egsCharacterIds":["4987"],"vndbCharacterId":"c33956"},"originalCharacterName":"佐々木 亮子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who works in one of Akihabara's most popular bookstores which sells doujins and other adults only material."}],"source":"vndb","sourceCharacterId":"c33956"},{"segments":[{"spoiler":false,"text":"秋葉原にあるアダルトコミック誌などを取り扱う書店で仕入れ担当をしている女の子。"},{"spoiler":false,"text":"若いながらに仕入れ担当という敏腕店員。"}],"source":"egs","sourceCharacterId":"4987","sourceWorkId":"20992","spoiler":false},{"segments":[{"spoiler":false,"text":"在秋叶原销售成人漫画杂志的书店负责进货的女孩。"},{"spoiler":false,"text":"年纪轻轻就负责进货的能干店员。"}],"source":"bangumi","sourceCharacterId":"28643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f68b9128d636f56b6e8f48dfb3ba179a7240f503353d5e1eaa2dd206ff4f84d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48c55c369a325a774a7bba8635a83f3fba5de1ff67ed26465e8bcaff0e2d4bfa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"英みらい","creatorId":"vndb:s996","sourcePersonId":"vndb:s996","canonicalEntityId":"vndb:s996","name":"英みらい(大山チロル、ひつじまる)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121563:28643:8069:1","source":"bangumi"}]},{"characterId":"char_c966","characterName":"ソノネ","sourceIds":{"bangumi":[{"characterId":"46736","match":"exact-normalized-name-in-linked-work","subjectId":"74841"}],"egsCharacterIds":["5363"],"vndbCharacterId":"c966"},"originalCharacterName":"ソノネ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"32"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hehehe, let's all work together so that even Mochizuki-kun can earn his salary!\""},{"spoiler":false,"text":"Nene is the company president of Flower, and acts as director, scriptor and project manager. She sleeps in the company's meeting room in order to save on finances. Despite her size, she's a full-fledged adult and at 32 and the oldest out of the girls at Flower, as she and Reina have been friends since childhood."},{"spoiler":false,"text":"She usually wears children's clothes because of her size and at the other girls' requests, but dons a proper suit when out on business, as one would expect of an adult."},{"spoiler":false,"text":"Of course, even a small is too big for her, so it doesn't exactly fit."},{"spoiler":false,"text":"Nene's main problem is that while being the president of Flower, few people treat her with any sort of respect. Most simply cannot take her seriously because of her size and child-like demeanor. Even her employees treat her more like the studio's mascot than anything else. At the same time, Nene doesn't feel like she is contributing much to the final product, as her role in the company isn't directly connected to the making of the game (even if she is the one in charge of negotiations with stores, contracts, meetings with the parent company, and anything connected to the business end of things)."},{"spoiler":false,"text":"Unlike the other girls, Nene has a little more experience with eroge, as she has played lots of them...in \"trial version\" form. Given that trial versions of any game cover the very basics of the story, Nene doesn't have much of an idea of what a complete eroge is supposed to be like."},{"spoiler":false,"text":"2 merged summaries - from Moroboshi Yuumei's review and from MangaGamer"}],"source":"vndb","sourceCharacterId":"c966"},{"segments":[{"spoiler":false,"text":"エロゲー会社「フラワー」の社長兼 営業兼 ディレクター兼 スクリプター。"},{"spoiler":false,"text":"節約のため会社の会議室で寝泊りしている。"},{"spoiler":false,"text":"見た目は小さいが、れっきとした大人の女性で「フラワー」の最年長。"},{"spoiler":false,"text":"普段はサイズの関係とスタッフの要望から子供っぽい服装をしているが、営業や外回りの用事がある時はスーツを着る。"},{"spoiler":false,"text":"大人としてのたしなみ。"},{"spoiler":false,"text":"もちろんSサイズでも大きいのでだぶだぶ。"},{"spoiler":false,"text":"唯一エロゲーに関してそれなりの知識と感性をもっているが、気が弱くてみんなに指導する事ができない。"},{"spoiler":false,"text":"外見のせいもあり、社内ではマスコット的な扱いをされ、営業に出てもなかなか真面目に取り合ってもらえない。"},{"spoiler":false,"text":"「えへへへー、望月くんのお給料も出せるよう、みんなでがんばっていきましょー！」"}],"source":"egs","sourceCharacterId":"5363","sourceWorkId":"13840","spoiler":false},{"segments":[{"spoiler":false,"text":"エロゲー会社「フラワー」の社長兼 営業兼 ディレクター兼 スクリプター。"},{"spoiler":false,"text":"節約のため会社の会議室で寝泊りしている。"},{"spoiler":false,"text":"見た目は小さいが、れっきとした大人の女性で「フラワー」の最年長。"},{"spoiler":false,"text":"普段はサイズの関係とスタッフの要望から子供っぽい服装をしているが、営業や外回りの用事がある時はスーツを着る。"},{"spoiler":false,"text":"大人としてのたしなみ。"},{"spoiler":false,"text":"もちろんSサイズでも大きいのでだぶだぶ。"},{"spoiler":false,"text":"唯一エロゲーに関してそれなりの知識と感性をもっているが、気が弱くてみんなに指導する事ができない。"},{"spoiler":false,"text":"外見のせいもあり、社内ではマスコット的な扱いをされ、営業に出てもなかなか真面目に取り合ってもらえない。"}],"source":"egs","sourceCharacterId":"5363","sourceWorkId":"21070","spoiler":false},{"segments":[{"spoiler":false,"text":"黄油公司「Flower」的社长兼营业兼指挥兼脚本。"},{"spoiler":false,"text":"为了节约而住在公司的会议室。"},{"spoiler":false,"text":"外表娇小，但是个货真价实的成年女性，在「Flower」中最年长。"},{"spoiler":false,"text":"平时因为身体的关系和员工的要求而穿着很孩子气的服装，"},{"spoiler":false,"text":"但在营业和外勤时穿着西服。"},{"spoiler":false,"text":"这是大人的爱好。当然S尺码也太大了而看上去很肥大。"},{"spoiler":false,"text":"唯一在关于黄油上拥有着一定的知识和感性，但因为软弱而没法指导大家。"},{"spoiler":false,"text":"因为外表的缘故，在公司内被当做是吉祥物对待，"},{"spoiler":false,"text":"进行营业时也没被认真应对过。"},{"spoiler":false,"text":"「唉嘿嘿嘿嘿，大家一起努力，让我们公司付得起望月君的工资吧！」"}],"source":"bangumi","sourceCharacterId":"46736"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e443627fc3cd9dd42eb162e3428842d1d89d1c695b4a8bc72de1b60ddc32dc20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/