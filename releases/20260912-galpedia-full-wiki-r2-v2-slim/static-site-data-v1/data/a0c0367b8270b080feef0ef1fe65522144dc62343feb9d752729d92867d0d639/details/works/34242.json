6","characterName":"白雪 姫","sourceIds":{"bangumi":[{"characterId":"129828","match":"exact-normalized-name-in-linked-work","subjectId":"432524"}],"egsCharacterIds":["24795"],"vndbCharacterId":"c126916"},"originalCharacterName":"白雪 姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A stunning Yuki-onna with a heart of gold, like a princess straight out of a fairytale."},{"spoiler":false,"text":"Hime's got her head on straight, but there's a quirky side to her as well."},{"spoiler":false,"text":"Touched by Yukinoshin's act of rescuing her younger brother, Hime pledges to repay his kindness. Curiously, her dedication to express her gratitude even extends into the realm of intimate affection."},{"spoiler":false,"text":"\"Hehe... I know everything about you, dear.\""}],"source":"vndb","sourceCharacterId":"c126916"},{"segments":[{"spoiler":false,"text":"上品で高貴なお姫様のような美女。"},{"spoiler":false,"text":"実は雪女。"},{"spoiler":false,"text":"しっかり者だが、不思議ちゃんの一面も持ち合わせている。"},{"spoiler":false,"text":"弟・ふぶきを救ってくれた主人公に恩返ししようとひたすら頑張る。"},{"spoiler":false,"text":"何故かエロ方面でも尽くしてくれる優しく明るい女の子。"}],"source":"egs","sourceCharacterId":"24795","sourceWorkId":"34242","spoiler":false},{"segments":[{"spoiler":false,"text":"優しく明るい女のコだが、その正体は雪女。しっかり者だが、不思議ちゃんの一面も持ち合わせている。弟·ふぶきを救ってくれた主人公に恩返ししようとひたすら頑張っており、エロ方面でも尽くしてくれる。"}],"source":"bangumi","sourceCharacterId":"129828"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"24795","sourceWorkId":"34242","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"24795","sourceWorkId":"34242","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"24795","sourceWorkId":"34242","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"24795","sourceWorkId":"34242","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"24795","sourceWorkId":"34242","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44dcdef93709dd8537e3550a5043cd68fa16f0d67bfcde9236d9966d13aba557.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42459e5afa09e5c7107d2b1d5285e84fb8d54f7f49debf5d41d432d7f835abc0.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みたかりん","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:432524:129828:25596:1","source":"bangumi"}]},{"characterId":"char_c127007","characterName":"白雪 ふぶき","sourceIds":{"bangumi":[{"characterId":"133843","match":"exact-normalized-name-in-linked-work","subjectId":"432524"}],"egsCharacterIds":["24797"],"vndbCharacterId":"c127007"},"originalCharacterName":"白雪 ふぶき","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fubuki, Hime's younger brother, is a tiny, white critter who follows Yukinoshin around like a loyal pup. He's undergoing intense training and working his tail off to become a top-notch Yuki-otoko (Snowman). Calling Fubuki \"cute\" ticks him off—though he's indeed the spitting image of an adorable pet."},{"spoiler":false,"text":"\"Squeak, squeak!\""}],"source":"vndb","sourceCharacterId":"c127007"},{"segments":[{"spoiler":false,"text":"姫の弟。白くて小さい小動物。"},{"spoiler":false,"text":"立派な雪男になるために目下鋭意修行中。"},{"spoiler":false,"text":"子犬のように主人公になついている。"},{"spoiler":false,"text":"「かわいい」と言われると怒るが、結局のところかわいいペットのような存在。"}],"source":"egs","sourceCharacterId":"24797","sourceWorkId":"34242","spoiler":false},{"segments":[{"spoiler":false,"text":"姫の弟。"},{"spoiler":false,"text":"白くて小さい小動物。"},{"spoiler":false,"text":"立派な雪男になるために目下鋭意修行中。"},{"spoiler":false,"text":"子犬のように主人公になついている。"},{"spoiler":false,"text":"「かわいい」と言われると怒るが、"},{"spoiler":false,"text":"結局のところかわいいペットのような存在。"},{"spoiler":false,"text":"「ぷいっ、ぷいっ！」"}],"source":"bangumi","sourceCharacterId":"133843"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e98651d392e5e213dd07b3060d28774bb578259c1ae6e6d6940e0b4495389297.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d5e67f1ff4a1727fdbddc35656bd75e7e0a44c1837c4a3f51b04e4eef3e05db.webp","width":232,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤田茜","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:432524:133843:17981:1","source":"bangumi"}]},{"characterId":"char_c127015","characterName":"一本木 直人","sourceIds":{"bangumi":[{"characterId":"133844","match":"exact-normalized-name-in-linked-work","subjectId":"432524"}],"egsCharacterIds":["24798"],"vndbCharacterId":"c127015"},"originalCharacterName":"一本木 直人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"100"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the few friends Yukinoshin has."},{"spoiler":false,"text":"Naoto, a committed disciple of the Musou Jikiden Eishin school, finds his fate tied to the dojo, mainly due to his engagement with Hyakuren's daughter. This connection leads to a respectful rivalry between him and Yukinoshin for the dojo's succession. Although Naoto emerges victorious from their competition, he profoundly admires Yukinoshin's undeniable skills."},{"spoiler":false,"text":"\"Yukinoshin may seem clumsy, yet he's the sole person I fully acknowledge. Have faith in him.\""}],"source":"vndb","sourceCharacterId":"c127015"},{"segments":[{"spoiler":false,"text":"主人公の数少ない友人であり、無双直伝想心流の門下生。"},{"spoiler":false,"text":"百錬の娘と婚約中のため、主人公と道場の跡目を巡って勝負をすることになる。"},{"spoiler":false,"text":"結果的に勝ってしまうが、主人公の実力を認めている。"}],"source":"egs","sourceCharacterId":"24798","sourceWorkId":"34242","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の数少ない友人であり、"},{"spoiler":false,"text":"無双直伝想心流の門下生。"},{"spoiler":false,"text":"百錬の娘と婚約中のため、主人公と道場の跡目を"},{"spoiler":false,"text":"巡って勝負をすることになる。"},{"spoiler":false,"text":"結果的に勝ってしまうが、"},{"spoiler":false,"text":"主人公の実力を認めている。"},{"spoiler":false,"text":"「信じましょう……不器用な奴ですが、俺が唯一人認めた男です」"}],"source":"bangumi","sourceCharacterId":"133844"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/8482377712ad4fdae3426c51a7b9dd1e247130aaf4ed8b3aad5da886c2e22439.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/657fb42eab41346be14aaae986a7877f464fef064fc7e4fa1b7b1b4f9cc8000e.webp","width":108,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八汐 優","creatorId":"vndb:s8378","sourcePersonId":"vndb:s8378","canonicalEntityId":"vndb:s8378","name":"八汐優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94969","source":"vndb"}]},{"characterId":"char_c127039","characterName":"幸田 百錬","sourceIds":{"bangumi":[{"characterId":"133845","match":"exact-normalized-name-in-linked-work","subjectId":"432524"}],"egsCharacterIds":["24799"],"vndbCharacterId":"c127039"},"originalCharacterName":"幸田 百錬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The twentieth headmaster of the Musou Jikiden Eishin-ryu and the mentor to Yukinoshin. Recognizing the latter's potential, he envisions him as the future successor. Yet, there is a note of sympathy for Yukinoshin's clumsiness."},{"spoiler":false,"text":"\"Perhaps discernment, in excess, poses its unique challenges...\""}],"source":"vndb","sourceCharacterId":"c127039"},{"segments":[{"spoiler":false,"text":"無双直伝想心流の宗家、第二十代道場主。"},{"spoiler":false,"text":"主人公の師匠。"},{"spoiler":false,"text":"主人公の実力を認めてくれていて、自分の跡継ぎに推薦する。"},{"spoiler":false,"text":"不器用な主人公を不憫に思っている。"}],"source":"egs","sourceCharacterId":"24799","sourceWorkId":"34242","spoiler":false},{"segments":[{"spoiler":false,"text":"無双直伝想心流の宗家、第二十代道場主。"},{"spoiler":false,"text":"主人公の師匠。"},{"spoiler":false,"text":"主人公の実力を認めてくれていて、"},{"spoiler":false,"text":"自分の跡继ぎに推薦する。"},{"spoiler":false,"text":"不器用な主人公を不憫に思っている。"},{"spoiler":false,"text":"「見えすぎるというのも、それはそれとして厄介なものなのかもしれめ……」"}],"source":"bangumi","sourceCharacterId":"133845"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82eb8d3a24c7c72de279c159560028bf7cd340daa587c0c28d134e0c4b106a66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e676bc405f02dad8fdaa19caebc9a6b93825ea979cce4074fb639bcadecf80bf.webp","width":79,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊勢 海老蔵","creatorId":"vndb:s36373","sourcePersonId":"vndb:s36373","canonicalEntityId":"vndb:s36373","name":"伊勢海老蔵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94971","source":"vndb"}]},{"characterId":"char_vndb_c126980","characterName":"蓮仏 雪之進","sourceIds":{"vndbCharacterId":"c126980"},"originalCharacterName":"蓮仏 雪之進","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A martial artist with an unwavering dedication to the way of the sword."},{"spoiler":false,"text":"After losing a bet on the dojo's succession, Yukinoshin gives up the worldly affair and devotes himself to training in the mountain."},{"spoiler":false,"text":"His dedication to getting better often consumes him to the point where he loses track of time and his immediate surroundings. This, combined with his overly serious nature, makes it difficult for him to engage in social situations, especially with women, in which he is genuinely interested."},{"spoiler":false,"text":"At first glance, he resembles a wandering ronin, tough and detached. However, beneath this stern exterior, Yukinoshin reveals unexpected hobbies. He has a soft spot for the tranquil art of knitting and indulges in the cultural richness of period dramas."},{"spoiler":false,"text":"\"Training is of utmost importance, indeed...\""}],"source":"vndb","sourceCharacterId":"c126980"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4949b69fa33c0d7092219cfcb99fc8ad98e0659cdf19114278f54f86d21aa95.webp","fallbackUrl":"https://wiki-ass