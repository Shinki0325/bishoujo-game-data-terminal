":"久坂 真生","creatorId":"vndb:s3502","sourcePersonId":"vndb:s3502","canonicalEntityId":"vndb:s3502","name":"島村 孝一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96858","source":"vndb"},{"creditedName":"セラフィック アーツ","creatorId":"vndb:s8783","sourcePersonId":"vndb:s8783","canonicalEntityId":"vndb:s8783","name":"セラフィック アーツ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96859","source":"vndb"},{"creditedName":"八重桜","creatorId":"vndb:s8785","sourcePersonId":"vndb:s8785","canonicalEntityId":"vndb:s8785","name":"八重桜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96861","source":"vndb"},{"creditedName":"身から出た鯖","creatorId":"vndb:s19125","sourcePersonId":"vndb:s19125","canonicalEntityId":"vndb:s19125","name":"身から出た鯖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96863","source":"vndb"},{"creditedName":"むらい てつや","creatorId":"vndb:s2160","sourcePersonId":"vndb:s2160","canonicalEntityId":"vndb:s2160","name":"村井 徹哉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96864","source":"vndb"}]},"cast":[{"characterId":"char_c10001","characterName":"安曇 璃紗","sourceIds":{"bangumi":[{"characterId":"16918","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16918","match":"exact-normalized-name-in-linked-work","subjectId":"62536"},{"characterId":"16918","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["553"],"vndbCharacterId":"c10001"},"originalCharacterName":"安曇 璃紗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class Representative of the Year 1 \"Snow\" class, and a classmate of Miya's. Has an earnest and hardworking personality. As a hard-nosed person, she often finds herself in leadership positions. She’s what you might call a high-class tsundere girl."},{"spoiler":false,"text":"While she naturally does well academically and has common sense, whenever she gets into it with Miya, she always gets outreasoned and frequently stomps her feet. Having an unusually strong sense of shame, she gets flustered and briefly digs herself into a hole when thrust into a romantic relationship."},{"spoiler":false,"text":"The half-Japanese daughter of a foreign company with a British mother. Built like a model, and the owner of enormous breasts."},{"spoiler":false,"text":"Translated from Getchu and Yurin Yurin"}],"source":"vndb","sourceCharacterId":"c10001"},{"segments":[{"spoiler":false,"text":"1年雪組のクラス委員長で、美夜とは同級生。"},{"spoiler":false,"text":"性格は生真面目で努力家。"},{"spoiler":false,"text":"押しが強く、気がつくとリーダー的立場になる事が多い。"},{"spoiler":false,"text":"いわゆるツンデレお嬢様、もちろん成績は優秀で常識人なのだが、美夜が絡むと必ず理屈で論破され、地団駄を踏むことが多い。"},{"spoiler":false,"text":"人一倍羞恥心が強く、恋愛関係で突っ込まれると、わたわたと慌て墓穴を掘る事しばし。"},{"spoiler":false,"text":"外資系企業令嬢で母親が英国人というハーフ。"},{"spoiler":false,"text":"モデル並みのプロポーションで、巨乳の持ち主。"}],"source":"egs","sourceCharacterId":"553","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"2年雪組のクラス委員長で、美夜とは同級生にして恋人。"},{"spoiler":false,"text":"性格は生真面目で努力家。"},{"spoiler":false,"text":"相変わらずサボりクセのある美夜をなんとか授業に出そうとするも、なんだかんだとへ理屈で論破された上に、可愛いキスや愛のささやきで誤魔化される事しばし。"},{"spoiler":false,"text":"実はかなりの可愛いもの好きで、少女趣味丸出しの部屋には、恋人の美夜しか入れた事がないらしい。"}],"source":"egs","sourceCharacterId":"553","sourceWorkId":"18197","spoiler":false},{"segments":[{"spoiler":false,"text":"２年雪組のクラス委員長で、美夜とは同級生にして恋人。性格は生真面目で努力家。"},{"spoiler":false,"text":"相変わらずサボりクセのある美夜をなんとか授業に出そうとするも、なんだかんだとへ理屈で論破され、地団駄を踏むことしばし。"},{"spoiler":false,"text":"実はかなりの可愛いもの好きで、少女趣味丸出しの部屋には、恋人の美夜しか入れた事がないらしい。"}],"source":"egs","sourceCharacterId":"553","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"１年雪組のクラス委員長で、美夜とは同級生。性格は生真面目で努力家。押しが強く、気がつくとリーダー的立場になる事が多い。"},{"spoiler":false,"text":"いわゆるツンデレお嬢様、もちろん成績は優秀で常識人なのだが、美夜が絡むと必ず理屈で論破され、地団駄を踏むことが多い"},{"spoiler":false,"text":"人一倍羞恥心が強く、恋愛関係で突っ込まれると、わたわたと慌て墓穴を掘る事しばし。"},{"spoiler":false,"text":"外資系企業令嬢で母親が英国人というハーフ。モデル並みのプロポーションで、巨乳の持ち主。"},{"spoiler":false,"text":"声：黒井音瑚 (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16918"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13ff9e850d66c7589580e8235cab018c100af7532872fb248cc0409fa083aeea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfa51e4058e46202569796bf8540b29f3a79d1c6ca93918c7069a5d87cb8685a.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米山有佳子","creatorId":"vndb:s3866","sourcePersonId":"vndb:s3866","canonicalEntityId":"vndb:s3866","name":"米山 有佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:62536:16918:19139:1","source":"bangumi"}]},{"characterId":"char_c10002","characterName":"綾瀬 美夜","sourceIds":{"bangumi":[{"characterId":"16919","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16919","match":"exact-normalized-name-in-linked-work","subjectId":"62536"},{"characterId":"16919","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["554"],"vndbCharacterId":"c10002"},"originalCharacterName":"綾瀬 美夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student of the Year 1 \"Snow\" class, and a classmate of Risa's. A prominent genius on campus, but has difficulty in social situations. Doesn’t really take issue with people other than Risa, and socializes as little as possible."},{"spoiler":false,"text":"Whenever she speaks with Risa it's always abusive, but she's actually covering her own embarrassment. Her speech and behavior always keep others at a distance. She rarely shows her soft side and is unflappable. When she does show her soft side, she becomes timid and casts nervous glances from beneath her lashes."},{"spoiler":false,"text":"Although you wouldn’t guess it from the way she talks, her behavior is actually quite ladylike. Possessing one of the most prominent intellects on campus, she has been offered the chance to study abroad and even skip grades, but she hates interacting with others, so she enrolled in the not particularly academically demanding school for high-class girls, St. Michael's."},{"spoiler":false,"text":"Translated from Getchu and Yurin Yurin"}],"source":"vndb","sourceCharacterId":"c10002"},{"segments":[{"spoiler":false,"text":"1年雪組の学生で璃紗のクラスメイト。"},{"spoiler":false,"text":"校内一の才女だが人付き合いが苦手で、璃紗以外の人物とは無難＆最小限の付き合い。"},{"spoiler":false,"text":"璃紗と口を利けば罵詈雑言ばかりだが、実は照れ隠し。"},{"spoiler":false,"text":"他の者とは常に距離を置いた口調と態度。"},{"spoiler":false,"text":"滅多にデレない＆動揺しない。デレる場合は気弱になって上目使いでソワソワ。"},{"spoiler":false,"text":"口調からそうは見えないが、実はかなり女らしい立ち振る舞い。"},{"spoiler":false,"text":"校内一の頭脳の持ち主で、海外留学や飛び級の打診もあったのだが、人付き合いを嫌い、さほど学力的には高くないお嬢様学校のミカ女に入学。"}],"source":"egs","sourceCharacterId":"554","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"璃紗の恋人で２年雪組の同級生。"},{"spoiler":false,"text":"校内一の才女で、相変わらず人付き合いが苦手だったがベストカップルのメンバーとはそれなりに交流を持ち始めて来た様子。"},{"spoiler":false,"text":"「受ける意味がない」と相変わらず授業をサボりまくり、旧美術部のアトリエを私物化して隠れ家状態に。"},{"spoiler":false,"text":"実はかなりの大食いで、さらに璃紗の私物をこっそりと着服してはコレクションしている模様。"}],"source":"egs","sourceCharacterId":"554","sourceWorkId":"18197","spoiler":false},{"segments":[{"spoiler":false,"text":"璃紗の恋人で２年雪組の同級生。校内一の才女で、相変わらず人付き合いが苦手だったがベストカップルのメンバーとはそれなりに交流を持ち始めて来た様子。"},{"spoiler":false,"text":"「受ける意味がない」と相変わらず授業をサボりまくり、旧美術部のアトリエを私物化して隠れ家状態に。"},{"spoiler":false,"text":"実はかなりの大食いで、さらに璃紗の私物をこっそりと着服してはコレクションしている模様。"}],"source":"egs","sourceCharacterId":"554","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"１年雪組の学生で璃紗のクラスメイト。校内一の才女だが人付き合いが苦手で、璃紗以外の人物とは無難＆最小限の付き合い。"},{"spoiler":false,"text":"璃紗と口を利けば罵詈雑言ばかりだが、実は照れ隠し。他の者とは常に距離を置いた口調と態度。"},{"spoiler":false,"text":"滅多にデレない＆動揺しない。デレる場合は気弱になって上目使いでソワソワ。"},{"spoiler":false,"text":"口調からそうは見えないが、実はかなり女らしい立ち振る舞い。"},{"spoiler":false,"text":"校内一の頭脳の持ち主で、海外留学や飛び級の打診もあったのだが、人付き合いを嫌い、さほど学力的には高くないお嬢様学校のミカ女に入学。"},{"spoiler":false,"text":"声：秋本ねりね (中村桜)"}],"source":"bangumi","sourceCharacterId":"16919"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dad290b2fd2b15b14ef53025180c88e4373be10555e3cf650bc1903a8f47fb89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44810265e598a12f38536181f35833984452aee80a2312f8ed98226616a72823.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村桜","creatorId":"vndb:s3644","sourcePersonId":"vndb:s3644","canonicalEntityId":"vndb:s3644","name":"中村 桜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:62536:16919:16171:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p2879","sourceCompanyId":"egs:brand:3657","canonicalEntityId":"vndb:p2879","name":"ゆりんゆりん","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18197:3657","source":"egs"},{"companyId":"vndb:p20157","sourceCompanyId":"vndb:p20157","canonicalEntityId":"vndb:p20157","name":"Yuri Neko","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:125287:v12097","source":"vndb"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131931:v12097