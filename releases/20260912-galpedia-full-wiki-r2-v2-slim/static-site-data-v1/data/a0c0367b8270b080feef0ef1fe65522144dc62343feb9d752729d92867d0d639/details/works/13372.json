:{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【気まぐれで好奇心旺盛な褐色の小悪魔】"},{"spoiler":false,"text":"キーワード：【シーフ】 【ホームレス】 【小悪魔】 【ツルぺったん】"},{"spoiler":false,"text":"突如主人公のもとに現れた “いもうと”。"},{"spoiler":false,"text":"性格はませており、怖いもの知らず。"},{"spoiler":false,"text":"人なつっこく、スキンシップ多めでロリのくせに、妙になまめかしい小悪魔。"},{"spoiler":false,"text":"スリの技術と、危ない色仕掛けで生計を立ててきたらしい。"},{"spoiler":false,"text":"知識は足りないが頭は良い。"},{"spoiler":false,"text":"「世の中騙した方の勝ち」がモットー。"},{"spoiler":false,"text":"恭太郎からは誘わないが、興味本位で自分から首を突っこんで、恭太郎と行動を共にする。"},{"spoiler":false,"text":"「キョータローとロリコンは違うの？」"}],"source":"egs","sourceCharacterId":"14155","sourceWorkId":"13372","spoiler":false},{"segments":[{"spoiler":false,"text":"突然在主人公身边出现的“妹妹”。"},{"spoiler":false,"text":"性格是较早熟，不知天高地厚。爱亲近人，身体接触多明明只是个萝莉，但又格外妖艳的小恶魔。"},{"spoiler":false,"text":"似乎是靠着偷窃技术和危险的色诱技维持着生计。"},{"spoiler":false,"text":"虽然知识不足但脑筋很好。信条是「在这社会能骗到人的就是赢家」。"},{"spoiler":false,"text":"尽管是没受到恭太郎的邀请，但却因自身好奇而插进来和恭太郎一起行动。"}],"source":"bangumi","sourceCharacterId":"12283"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"14155","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"aaa","valueContext":null,"source":"egs","sourceCharacterId":"14155","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"143 cm","valueContext":null,"source":"egs","sourceCharacterId":"14155","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"14155","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"14155","sourceWorkId":"13372","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13c14294bb3d87c502af2ca5775048db6a3c20a846bf56be49388a5181daff6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b500bbfe9628bcfc74023ac92c1f5a430dacfaab2b51f2ebee5d5e8f993f72f1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7189:12283:4432:1","source":"bangumi"}]},{"characterId":"char_c10844","characterName":"双葉 紺乃","sourceIds":{"bangumi":[{"characterId":"12284","match":"exact-normalized-name-in-linked-work","subjectId":"7189"}],"egsCharacterIds":["14156"],"vndbCharacterId":"c10844"},"originalCharacterName":"双葉 紺乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【主人公にはベタ甘な、結婚願望が強い巨乳幼なじみ】"},{"spoiler":false,"text":"キーワード：【？？？】 【幼なじみ】 【巨乳担当】 【1年生】"},{"spoiler":false,"text":"主人公の幼なじみ。癒し系乳担当。ドジッ子。意外に嫉妬深い。"},{"spoiler":false,"text":"弟が数人おり、母性本能過多で、世話焼き。思考は所帯臭い。"},{"spoiler":false,"text":"金銭感覚には厳しいが、主人公にはベタベタに甘い。"},{"spoiler":false,"text":"恭太郎への好意は誰が見てもあからさまで、将来の旦那様としてマークし、アプローチを続けている。"},{"spoiler":false,"text":"結婚願望が強く、恭太郎にはことある事に “結婚したくなるよう” 教育を施してきた。"},{"spoiler":false,"text":"「人間、普通が一番」がモットー。"},{"spoiler":false,"text":"恭太郎のために、泣く泣く部活動に参加する。"},{"spoiler":false,"text":"「はい、3回唱えてください。結婚結婚結婚」"}],"source":"egs","sourceCharacterId":"14156","sourceWorkId":"13372","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的青梅竹马。治愈系巨乳担当。冒失女孩。意外地妒忌心重。"},{"spoiler":false,"text":"有数个弟弟，母性本能过多，爱管闲事。家庭妇女似的。"},{"spoiler":false,"text":"金钱感觉严谨，但对主人公是娇宠死心塌地。"},{"spoiler":false,"text":"对恭太郎的好意已经到了谁都看得出的程度了，一直把他当作未来丈夫锁定，亲近。"},{"spoiler":false,"text":"结婚愿望强烈，总是对恭太郎施行“想要结婚”教育。"},{"spoiler":false,"text":"信条是「人，还是普通的最好」。"},{"spoiler":false,"text":"为了恭太郎而哭着不情愿地参加了社团活动。"}],"source":"bangumi","sourceCharacterId":"12284"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"14156","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"14156","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"14156","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"14156","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"14156","sourceWorkId":"13372","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90124ecea512031839c903de244d9c67f88ec880ddd03445a2738681958d9b22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/446d60a3d08a3b5f74633fc0c5b231fc5f8e799dbc51871af28d7915887d84ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7189:12284:4830:1","source":"bangumi"}]},{"characterId":"char_c10845","characterName":"汀 竜子","sourceIds":{"bangumi":[{"characterId":"12285","match":"exact-normalized-name-in-linked-work","subjectId":"7189"}],"egsCharacterIds":["14157"],"vndbCharacterId":"c10845"},"originalCharacterName":"汀 竜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【無口で無表情な謎の転校生は暗殺者!?】"},{"spoiler":false,"text":"キーワード：【アサシン】 【転校生】 【無口】 【1年生】"},{"spoiler":false,"text":"ローテンションでクール、社会性が皆無な謎の転校生。一般常識に乏しい。"},{"spoiler":false,"text":"あまり人と関わらない生活を送ってきたため、背後をとられると相手を刺客として攻撃したりする。"},{"spoiler":false,"text":"毒味をしていない食べ物はとらない、などの奇人っぷり。"},{"spoiler":false,"text":"実は殺戮貴族 『首渡（くびわたり）』 の一員。"},{"spoiler":false,"text":"裏社会で 「紫電（サンダーボルト）」 と呼ばれている。"},{"spoiler":false,"text":"「見敵鏖殺」がモットー。"},{"spoiler":false,"text":"「また、無粋なものを斬ってしまった」"}],"source":"egs","sourceCharacterId":"14157","sourceWorkId":"13372","spoiler":false},{"segments":[{"spoiler":false,"text":"神经质又酷，社会性概念皆无谜样的转校生。缺乏一般常识。"},{"spoiler":false,"text":"因为过着的是远离他人的生活，所以一站在她背后就会被她当作是刺客而进行攻击。"},{"spoiler":false,"text":"有着没试毒的食物不会吃等等之类的奇异行为。"},{"spoiler":false,"text":"实际上是杀戮贵族『首渡（くびわたり）』的一员，在黑社会中被称作「紫電（サンダーボルト）」。"},{"spoiler":false,"text":"信条是「见敌杀尽」。"}],"source":"bangumi","sourceCharacterId":"12285"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14157","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"14157","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"14157","sourceWorkId":"13372","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"14157","sourceWorkId":"13372","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/175d65313c2deb687e7c4dca5ab67d6e67f6c676c90290fd8a69cfd760e80a0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c120687f336be273da1125b79951605bbc47398c4c3fd46b3e404a45fcfcb248.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7189:12285:6038:1","source":"bangumi"}]},{"characterId":"char_c10846","characterName":"内藤 恭太郎","sourceIds":{"bangumi":[{"characterId":"12286","match":"exact-normalized-name-in-linked-work","subjectId":"7189"}],"egsCharacterIds":["14158"],"vndbCharacterId":"c10846"},"originalCharacterName":"内藤 恭太郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【憧れを追い求める、よろず屋家業の発起人】"},{"spoiler":false,"text":"キーワード：【主人公】 【料理人】 【よろず屋】"},{"spoiler":false,"text":"本作の主人公。憧れだった叔母の背中を追って泉州学園に入学する。"},{"spoiler":false,"text":"実家が洋食屋のため料理の腕はセミプロ級。"},{"spoiler":false,"text":"人当たりは良く社交性があり、自分から引っ張るよりも相手に合わせるタイプ。"},{"spoiler":false,"text":"思慮深いが行動は大胆。面倒見は良いほう。"},{"spoiler":false,"text":"紺乃の教育の甲斐あって女性には敬意を払うが、誰彼構わず優しいため、逆に紺乃の心配の種は増えている。"},{"spoiler":false,"text":"叔母を目標に、出会った少女たちと共によろず屋家業を開始する。"},{"spoiler":false,"text":"「いいよ。それなら、僕の家にくる？」"}],"source":"egs","sourceCharacterId":"14158","sourceWorkId":"13372","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的主人公。为了追赶自己所憧憬的叔母而入学到泉州学园。"},{"spoiler":false,"text":"因为老家是开西餐店的，所以他的料理本领是半职业级的。"},{"spoiler":false,"text":"待人很好，好交际，是与其主张自己不如配合对方的类型。"},{"spoiler":false,"text":"深思熟虑，行动大胆，很会照顾人。"},{"spoiler":false,"text":"因为有紺乃的教育而很敬重女性，但却是不管对谁都温柔，所以反而增加了紺乃担心的源头。"},{"spoiler":false,"text":"以叔母为目标，与刚认识不久的少女们一起开始了万事屋的业务。"}],"source":"bangumi","sourceCharacterId":"12286"}],"profileFacts":[{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"14158","sourceWorkId":"13372","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c10846","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"14158","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"14158","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"12286","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c9e01b8587cd71ec3b95a28c6ffd24c579395e6f338244886858593ff6f4548.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1cf0bf1d73c50d6d572b6faff49dbf41ba87c5f945f9e0ac260363a600d9327.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:1743","sourceCompanyId":"egs:brand:1743","canonicalEntityId":"egs:brand:1743","name":"Silver Bullet","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13372:1743","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:170351:v3391","source":"vndb"},{"companyId":"vndb:p330","sourceCompanyId":"vndb:p330","canonicalEntityId":"vndb:p330"