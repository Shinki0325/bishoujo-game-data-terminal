ts":[{"spoiler":false,"text":"快活で素直、元気の良い、剣士としての腕前を磨いている発展途上の女の子。"},{"spoiler":false,"text":"両親に冒険者を持ち、兄は城の騎士として生きている。"},{"spoiler":false,"text":"冒険者だった両親の遺伝もあり、肉体的には頑健でしなやかな筋肉・素質には恵まれており今後の伸びも期待できる。"},{"spoiler":false,"text":"今回の目的は強奪された村のご神体を取り返す事。"}],"source":"egs","sourceCharacterId":"15236","sourceWorkId":"12509","spoiler":false},{"segments":[{"spoiler":false,"text":"快活で素直、元気の良い、剣士としての腕前を磨いてる発展途上の女の子。"},{"spoiler":false,"text":"両親に冒険者を持ち、兄は城の騎士として生きている。"},{"spoiler":false,"text":"冒険者だった両親の遺伝もあり、肉体的には頑健でしなやかな筋肉、資質には恵まれており今後の伸びも期待できる。"},{"spoiler":false,"text":"今回の目的は強奪された村の神体を取り返す事。"}],"source":"bangumi","sourceCharacterId":"146266"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52b6fd5f4e13211ebe1f7ca6748d1b618eb95ad328ed22aee687f1a8a7a476ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87884e2f38919339a0029767122fb1aa5718ad0319199673bc2d97982260c978.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅島恵","creatorId":"vndb:s5565","sourcePersonId":"vndb:s5565","canonicalEntityId":"vndb:s5565","name":"梅島恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19393","source":"vndb"}]},{"characterId":"char_c4893","characterName":"シャルト＝コーニッシュ","sourceIds":{"bangumi":[{"characterId":"146265","match":"exact-normalized-name-in-linked-work","subjectId":"323507"}],"egsCharacterIds":["9477"],"vndbCharacterId":"c4893"},"originalCharacterName":"シャルト＝コーニッシュ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman who is a nimble and dexterous thief. With an easygoing and friendly manner, she is skilled at making a living. She is a member of a magician guild."},{"spoiler":false,"text":"At the beginning of the events of Thief & Sword, she is dispatched by the guild to reclaim a stolen grimoire."},{"spoiler":false,"text":"In the wake of that incident, she became focused on dealing with troubles involving chimeras and human trafficking."}],"source":"vndb","sourceCharacterId":"c4893"},{"segments":[{"spoiler":false,"text":"手先が器用で、身軽なシーフ能力を身に着けている女性。"},{"spoiler":false,"text":"口調は軽めで人なつっこい印象を与え、世渡り上手な所がある。"},{"spoiler":false,"text":"【魔術ギルド＜トライ・ノーレッジ＞】に所属しており、今回は魔術ギルドから盗み出された魔術書を取り戻しに行くのが目的。"}],"source":"egs","sourceCharacterId":"9477","sourceWorkId":"12509","spoiler":false},{"segments":[{"spoiler":false,"text":"【トライ＝ノーレッジ】という魔術師ギルドに所属している、ギルドの手伝いをしているという立場の盗賊。"},{"spoiler":false,"text":"過去に、伯爵によるキメラ復活計画に関わった後、キメラに関する事件や、人身売買のトラブルを中心に対処するようになった。"},{"spoiler":false,"text":"今回は単独で潜伏しているが、状況によっては同じギルドに所属しているシリアンと遭遇する事もあるかもしれない。"}],"source":"egs","sourceCharacterId":"9477","sourceWorkId":"16195","spoiler":false},{"segments":[{"spoiler":false,"text":"手先が器用で、身軽なシーフ能力を身につけている女性。"},{"spoiler":false,"text":"口調は軽めで人懐っこい印象を与え、世渡り上手なところがある。"},{"spoiler":false,"text":"【魔術ギルド・トライ・ノーレッジ】に所属しており、今回は魔術ギルドから盗み出された魔導書を取り戻しに行くのが目的。"}],"source":"bangumi","sourceCharacterId":"146265"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/5629b750ac6ae9df9ed507f4536cf021cefc27929e5fb70b59374c8b947b35f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0a3a4c8e8e64c0e1b418f67b88e844b07d3be5e33fac5a66c447eca60149e43.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松風みのり","creatorId":"vndb:s5566","sourcePersonId":"vndb:s5566","canonicalEntityId":"vndb:s5566","name":"松風みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19394","source":"vndb"}]},{"characterId":"char_c56763","characterName":"ホルス・マッザーカ","sourceIds":{"bangumi":[],"egsCharacterIds":["15237"],"vndbCharacterId":"c56763"},"originalCharacterName":"ホルス・マッザーカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"村娘。ここ数年不作の為に、村長の館で使用人として奉公している。"},{"spoiler":false,"text":"過程的で穏やかな物腰、特に料理の腕前は中々の物。"},{"spoiler":false,"text":"男性からも女性からも好かれる、おしとやかなタイプ。"},{"spoiler":false,"text":"誰にでも優しく接するので、たまに勘違いされる事もある。"},{"spoiler":false,"text":"ただ、村長の家で奉仕するようになってから、ため息が増えたそうだ。"},{"spoiler":false,"text":"その微笑みの陰りの原因は……？"}],"source":"egs","sourceCharacterId":"15237","sourceWorkId":"12509","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0cff6fc485a0443ee8202fd137b5e1aa36874f14865a9dcb27440677884f3d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/102e48351e974125ca47efba5fee28a54276b17635e32e986b525a7f89a23b13.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19391","source":"vndb"}]},{"characterId":"char_c56764","characterName":"ルシュ・ロボロフ","sourceIds":{"bangumi":[],"egsCharacterIds":["15239"],"vndbCharacterId":"c56764"},"originalCharacterName":"ルシュ・ロボロフ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伯爵に引き取られたメイド。"},{"spoiler":false,"text":"慇懃な態度の裏腹、他人を上から見下ろした物言いをする事が多い。"},{"spoiler":false,"text":"ただ見た目によらずなかなかの力持ちで、戦闘時にはハンマーを好む。"},{"spoiler":false,"text":"その鉄槌は、すべての敵を等しく粉砕するだろう。"}],"source":"egs","sourceCharacterId":"15239","sourceWorkId":"12509","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48bdfc8ccec3207645de05b04753ca06465f1972b2f185d505c98f65df5c81ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69bc101ea78c57cdcf4028ed05c19d883dc7a8d7fbc2c079c29d51b34daafc52.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19392","source":"vndb"}]},{"characterId":"char_c56765","characterName":"ラベラ・ロボロフ","sourceIds":{"bangumi":[],"egsCharacterIds":["15238"],"vndbCharacterId":"c56765"},"originalCharacterName":"ラベラ・ロボロフ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伯爵に引き取られたもう一人のメイド。"},{"spoiler":false,"text":"普段は寡黙で、必要な事を淡々と口にする第度。"},{"spoiler":false,"text":"伯爵に引き取られた恩を強く感じ、剣を持って彼に為に戦う。"},{"spoiler":false,"text":"敵対する相手の全てを斬り伏せるだろう。"}],"source":"egs","sourceCharacterId":"15238","sourceWorkId":"12509","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cacdcf501a3de0cb9b9363b414110ece25f03c3a38a8c8f542aa8df0dd93ae83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d3fc2f7fb84d5b06e6f4ee13c900154f57174f92fe78f04489b5a4762549f0e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香",