{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"1428","model":{"presentationWorkId":"vndb:v15812","staff":{"artwork":[{"creditedName":"本田直樹","creatorId":"vndb:s1890","sourcePersonId":"egs:creator:310","canonicalEntityId":"vndb:s1890","name":"本田直樹","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:237","source":"egs"}],"scenario":[{"creditedName":"大槻涼樹","creatorId":"vndb:s956","sourcePersonId":"egs:creator:311","canonicalEntityId":"vndb:s956","name":"大槻涼樹","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238","source":"egs"}],"music":[{"creditedName":"矢野雅士","creatorId":"vndb:s1047","sourcePersonId":"egs:creator:990","canonicalEntityId":"vndb:s1047","name":"矢野雅士","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:1570","source":"egs"}],"other":[{"creditedName":"本田 直樹","creatorId":"vndb:s1890","sourcePersonId":"vndb:s1890","canonicalEntityId":"vndb:s1890","name":"本田 直樹","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:113060","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_101340","characterName":"Hyde","sourceIds":{"bangumi":[{"characterId":"101340","match":"source-roster","subjectId":"130322"},{"characterId":"101340","match":"source-roster","subjectId":"99024"}]},"originalCharacterName":"Hyde","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"どこかひねくれた顔の、目つきの悪い２１歳。"},{"spoiler":false,"text":"幼なじみのサクラとともに世界を旅して回っている冒険者。"},{"spoiler":false,"text":"その目的は、失われた文明の財宝、『旧世界の遺産』を探し出すこと。"},{"spoiler":false,"text":"……というのは実は口実で、本当は自由気ままな暮しがしたくて冒険を始めたらしい。"},{"spoiler":false,"text":"何にでも首を突っ込みたがる性格。そのため必要の無いトラブルに巻き込まれることが多い。"},{"spoiler":false,"text":"とりわけ女好きなのだが、女難の相あり。しかし懲りない。"}],"source":"bangumi","sourceCharacterId":"101340"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f27863a6bb33e027a41df48f895da38e6b550499409c6a84dde9531d240a407.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f505e1367709a03e62929ce640201171eb56fc7f837e674ed99afd65f574e103.webp","width":122,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_101341","characterName":"Sakura","sourceIds":{"bangumi":[{"characterId":"101341","match":"source-roster","subjectId":"130322"},{"characterId":"101341","match":"source-roster","subjectId":"99024"}]},"originalCharacterName":"Sakura","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ハイドとは幼なじみで、冒険のパートナー（自称）。"},{"spoiler":false,"text":"ハイドが一人旅に出ようとした時、嫌がるハイドを押し切って無理矢理くっついてきた。行動派。"},{"spoiler":false,"text":"家事全般が得意で家庭的な一面を持つが、その強気な性格のためかハイドとはケンカが絶えない。"},{"spoiler":false,"text":"戦闘には全く役に立たないので街で留守番しているが、サクラはそれを不満に思っている。"},{"spoiler":false,"text":"ハイドのことを幼なじみ以上に想っているものの、素直になれない性格とハイドの鈍感さゆえ、なかなかその想いは実りそうにない。"}],"source":"bangumi","sourceCharacterId":"101341"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11381ee62b2a7dc5cf0df43e4db21b7f6a98b688b37a91cf108e0ea7e7f96d0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5a741625b69c3bdc4dad44546593c72ebd4d5015e3e4cbe04941a0e68443a16.webp","width":157,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_101350","characterName"