{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22805","model":{"presentationWorkId":"vndb:v18800","staff":{"artwork":[{"creditedName":"ちょびぺろ","creatorId":"vndb:s5369","sourcePersonId":"egs:creator:17690","canonicalEntityId":"vndb:s5369","name":"ちょびぺろ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:158931","source":"egs"}],"scenario":[{"creditedName":"和泉万夜","creatorId":"vndb:s217","sourcePersonId":"egs:creator:1614","canonicalEntityId":"vndb:s217","name":"和泉万夜","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:158932","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c42029","characterName":"七尾 いずみ","sourceIds":{"bangumi":[{"characterId":"60656","match":"exact-normalized-name-in-linked-work","subjectId":"189510"}],"egsCharacterIds":["27227"],"vndbCharacterId":"c42029"},"originalCharacterName":"七尾 いずみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"俊雄の同級生で、憧れの女の子。"},{"spoiler":false,"text":"容姿と性格から学園人気ナンバー1の少女。"},{"spoiler":false,"text":"穏やかで優しい性格をしており、女子から敬遠されている俊雄にも親身で接してくれる。"},{"spoiler":false,"text":"俊雄にとって理想のヒロイン像を体現する少女であり、憧れの対象。"},{"spoiler":false,"text":"そのために妄想内で、性欲処理をお願いする頻度も一番多く、幽体離脱を憶えた俊雄の第一ターゲットとなっている。"},{"spoiler":false,"text":"性に関して疎いため、いずみ自身も気付いていないが非常に感じやすく敏感な体質。"},{"spoiler":false,"text":"また、恥ずかしいとさらに敏感になってしまう難儀な性質も合わさり、俊雄の行動によってはどんどんと、Hな女の子に変えられていってしまう。"}],"source":"egs","sourceCharacterId":"27227"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd72f3643401200024acae9164fb815acdd5dd351905d99a008ce9a709d37fa8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8530ce523e4c32537eb1490edbfd5fbc762f4061e30a20b0b21dafd97bfea212.webp","width":145,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189510:60656:15637:1","source":"bangumi"}]},{"characterId":"char_c52559","characterName":"相田 俊雄","sourceIds":{"bangumi":[],"egsCharacterIds":["27234"],"vndbCharacterId":"c52559"},"originalCharacterName":"相田 俊雄","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。漫画研究部部長。"},{"spoiler":false,"text":"交通事故がきっかけで「幽体離脱」を憶えたスケベな少年。"},{"spoiler":false,"text":"妄想ばかりしており、どのような状況でどのようにイタズラしたら愉しくエロイかを日々脳内研究している。"},{"spoiler":false,"text":"そして、ときおりその妄想をぽろりと口に出してしまう癖があるので、女子にはまったくモテない。"},{"spoiler":false,"text":"「幽体離脱」はそんな彼の妄想力が、事故をきっかけに具現化したモノであり、透明人間のように視認されず、望んだモノはすり抜けることが出来る能力がある。"},{"spoiler":false,"text":"開花したばかりの才能であり、能力はさらに進化してゆく模様。"},{"spoiler":false,"text":"スケベで妄想が逞しい以外は普通の少年であり、倫理観も並程度に持ち合わせているが、年頃の男の子であるため、旺盛な性欲の前にそんなものは簡単に吹き飛んでしまう。"}],"source":"egs","sourceCharacterId":"27234"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/712fb320fb7924fbd60195b52782ef92c6ebbff457098bb432e2dc601b6b07d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7d7f46910c071c321107d97cb973832b590e7eabd0192535a4ea60f27247a94.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c52561","characterName":"嶋藤 優花","sourceIds":{"bangumi":[{"characterId":"60662","match":"exact-normalized-name-in-linked-work"