didate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Midori's older sister."}],"source":"vndb","sourceCharacterId":"c118984"},{"segments":[{"spoiler":false,"text":"八阿多学園に通う女子学生。主人公の幼馴染で、親友と呼べる間柄の女の子。"},{"spoiler":false,"text":"それなりに名の知れた旧家のご息女。勉学よりもスポーツを好み、陸上選手として県大会に出場するほどの実力を持つ。"},{"spoiler":false,"text":"考えるよりも直観を優先するタイプ。皮肉屋の一面を持ち、他人の言葉には耳を貸さない唯我独尊なところがあり、ナルシスト的な傾向を持ち、おだてられると調子に乗りやすい。"},{"spoiler":false,"text":"同じ学園の養護教諭、深雨は実姉。彼女自身、姉を天敵と思っているらしく、保健室に近寄ろうとしない。"}],"source":"egs","sourceCharacterId":"24715","sourceWorkId":"8439","spoiler":false},{"segments":[{"spoiler":false,"text":"妹大好きな巫鳥の姉"}],"source":"bangumi","sourceCharacterId":"49813"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"24715","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"24715","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"24715","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"24715","sourceWorkId":"8439","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3370a03787516304901ce4a512d27ba48b94f14b23388a53f40a4962190f7ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27f37acb3cdc6d54500da2ba9c579d4a96edf8177d92fea672a37ee3aac31386.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩村琴美","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134039:49813:4813:1","source":"bangumi"}]},{"characterId":"char_c35453","characterName":"エリン・グィディル","sourceIds":{"bangumi":[{"characterId":"49806","match":"exact-normalized-name-in-linked-work","subjectId":"134039"}],"egsCharacterIds":["24707"],"vndbCharacterId":"c35453"},"originalCharacterName":"エリン・グィディル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ellen is a hardworking witch from the magic land staying at the Yachikojima household. She was chosen as a student studying abroad in the human world owing to her effort. She is rather familiar with Japan (the human world), and speaks Japanese fluently. However, Ellen has a fear of heights and a complex about her tiny chest."}],"source":"vndb","sourceCharacterId":"c35453"},{"segments":[{"spoiler":false,"text":"遠い国から舞台となる八阿多市にやってきた魔女。"},{"spoiler":false,"text":"ひょんなことから主人公の家にホームステイし、八阿多学園に編入することになった。"},{"spoiler":false,"text":"上流階級のお嬢様で、普通にしていても気品を感じさせる。"},{"spoiler":false,"text":"学園では優等生。好奇心旺盛。負けず嫌いで強情な一面も。"},{"spoiler":false,"text":"実は極度の近眼で、メガネを掛けないと本すら読めない。普段は裸眼で生活しているが、コンタクトを使っているわけではなく、高所恐怖症を隠すためらしい。"},{"spoiler":false,"text":"人間界に降り立ってから、テレビに興味を持ち、特に時代劇がお気に入り。"}],"source":"egs","sourceCharacterId":"24707","sourceWorkId":"8439","spoiler":false},{"segments":[{"spoiler":false,"text":"ひょんなことから主人公宅に居候することになった、 高所恐怖症の空飛ぶ魔女。二年生へ編入することに なる。"},{"spoiler":false,"text":"学園では気品あふれるお嬢様として注目されるが、 負けず嫌いで強情な一面も。"},{"spoiler":false,"text":"こちらの世界に来てからは時代劇がお気に入りらしい。"},{"spoiler":false,"text":"「こんばんは。こんな夜更けにこんな場所で、一体何をしているのかしら？」"}],"source":"bangumi","sourceCharacterId":"49806"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"24707","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"24707","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"24707","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"24707","sourceWorkId":"8439","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6215057f36871becd1167efeee0f941b842a56770b66330ce0cc7f5e60a0f867.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b5b8783da84ad2073bada4df48a8264efa53ae9793b2d93afbe912eff85c041.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134039:49806:4432:1","source":"bangumi"}]},{"characterId":"char_c35455","characterName":"明松 月砂","sourceIds":{"bangumi":[{"characterId":"49807","match":"exact-normalized-name-in-linked-work","subjectId":"134039"}],"egsCharacterIds":["24708"],"vndbCharacterId":"c35455"},"originalCharacterName":"明松 月砂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazusa is Ren's classmate who always seems to be sleepy. In reality, she is an fox ayakashi whom Ren helped when he was a child, and nowadays is quite attached to him. Her favorite food is Inari sushi."}],"source":"vndb","sourceCharacterId":"c35455"},{"segments":[{"spoiler":false,"text":"「狐魅」と呼ばれる妖の一種で、神社に祀られている稲継魂大神と同じ存在。"},{"spoiler":false,"text":"迷子になっているところを幼い頃の主人公に助けられ、以来、親しくなり、幼馴染として長く付き合うようになる。現在は主人公と同じ学園に通い、クラスメイトとして一緒に過ごしている。"},{"spoiler":false,"text":"容姿は美しく、ミステリアスな雰囲気を醸し出し、そのクールさも相俟って女子学生から人気。無口、無表情、無愛想の無の三重奏を持つ彼女だが、人間の生活には興味があるらしい。"},{"spoiler":false,"text":"主人公に、とある約束から彼女が創り出した三匹の子狐を貸し与えている。"}],"source":"egs","sourceCharacterId":"24708","sourceWorkId":"8439","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトだが、その実態は主人公が幼い頃、偶然助けたあやかしの一種「狐魅」。"},{"spoiler":false,"text":"積極的に人と関わることはなく、クールで無愛想。その美しい容姿とミステリアスな言動で、女子生徒からの人気は高い。"},{"spoiler":false,"text":"好物はもちろん誰がなんと言おうといなり寿司。"},{"spoiler":false,"text":"「わたしは妖。お前はひとの子。」"}],"source":"bangumi","sourceCharacterId":"49807"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"24708","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"24708","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"24708","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"24708","sourceWorkId":"8439","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b12c88ccd1937e29290f7e8322ea1ee8bb78a433b54fe05b7cc5bcf3af7990b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51e8f0040671c19ccc6a8b1b95de2a761b1b6401804b516503ff700bc7862386.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩村琴美","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134039:49807:4813:1","source":"bangumi"}]},{"characterId":"char_c35458","characterName":"鷺ノ宮 ひより","sourceIds":{"bangumi":[{"characterId":"49810","match":"exact-normalized-name-in-linked-work","subjectId":"134039"}],"egsCharacterIds":["24711"],"vndbCharacterId":"c35458"},"originalCharacterName":"鷺ノ宮 ひより","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"70"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hiyori is a first-year transfer student at Ren's school. She is the only daughter of the distinguished Saginomiya family. Hiyori is friendly and the type that goes headlong at what she has decided to do despite her childish appearance. For some reason, she has an unusual love for natto."}],"source":"vndb","sourceCharacterId":"c35458"},{"segments":[{"spoiler":false,"text":"八阿多市の旧家、鷺ノ宮家の一人娘。"},{"spoiler":false,"text":"一応、お嬢様に該当するはずの彼女だが、あまりそういった雰囲気はなく、天真爛漫で騒がしい女の子。騒々しいっぷりは学園でも有名。しかし、彼女の評判は悪くなく、その愛らしい容姿と人懐っこさから、周囲からはまるで妹のように可愛がられている。"},{"spoiler":false,"text":"学園の先輩でもある井荻智香は、幼馴染の親友。いつも一緒にいることが多く、その二人の掛け合いは、まるで漫才のようで、学園の名物ともなっている。"},{"spoiler":false,"text":"恋愛事にも興味津々で、そっち系の知識や話題も豊富に持っている耳年増。"}],"source":"egs","sourceCharacterId":"24711","sourceWorkId":"8439","spoiler":false},{"segments":[{"spoiler":false,"text":"地元旧家出身の学園名物の一年生。"},{"spoiler":false,"text":"騒々しいが人なつっこく、憎めない性格で友達も多 い。"},{"spoiler":false,"text":"恋愛の話題には興味津々な耳年増。"},{"spoiler":false,"text":"「鬼っ、悪魔、甘党、蜂蜜カレーッ！」"}],"source":"bangumi","sourceCharacterId":"49810"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"24711","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"24711","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"24711","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"24711","sourceWorkId":"8439","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f4dc71a889186339ecaaa718a52bd9f272f0d9d80eeb00311e9afe727f55176.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/137df286f55cf096af9104fab05a843628091f4de844b8ae02d84ead9c18ee32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井清己","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"大花どん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134039:49810:4336:1","source":"bangumi"}]},{"characterId":"char_c35460","characterName":"井荻 智香","sourceIds":{"bangumi":[{"characterId":"49811","match":"exact-normalized-name-in-linked-work","subjectId":"134039"}],"egsCharacterIds":["24712"],"vndbCharacterId":"c35460"},"originalCharacterName":"井荻 智香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chika is a third-year student and Iori's bodyguard. Despite her cold and aloof personality, Chika is actually very girlish, and is good at sewing. She loves cooking as well, but is incredibly bad at it to the point where Iori calls her curry \"honey soup\" because of its extreme sweetness."}],"source":"vndb","sourceCharacterId":"c35460"},{"segments":[{"spoiler":false,"text":"八阿多学園の三年生。"},{"spoiler":false,"text":"年下のひよりとは幼馴染で、親友同士。いつも一緒に行動している。"},{"spoiler":false,"text":"井荻家は、古くから鷺ノ宮家に仕えており、それは現在は変わらない。そのため、彼女はひよりのお目付け役的な立ち位置にあるが、そうしたしがらみを超えて、妹のように大切に思っている。"},{"spoiler":false,"text":"そんな彼女は文武両道の美人だが、口が悪く、すぐに手が出る気質のため周囲から恐れら、憧れの対象にされることは多いが、友人と呼べる存在は少ない。"},{"spoiler":false,"text":"恋愛事に興味がなく、異性との交際経験もない。その手の話にも疎く、純情。"}],"source":"egs","sourceCharacterId":"24712","sourceWorkId":"8439","spoiler":false},{"segments":[{"spoiler":false,"text":"ひよりとはボケツッコミの凹凸コンビの三年生。"},{"spoiler":false,"text":"文武両道の美人だが、口が悪くすぐに手が出るので、 皆に恐れられている。"},{"spoiler":false,"text":"恋愛事には疎く、興味も無い純情さん。"},{"spoiler":false,"text":"「べったりはあんただ、あんたっ」"}],"source":"bangumi","sourceCharacterId":"49811"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"24712","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"24712","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"24712","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"24712","sourceWorkId":"8439","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38849432d8446d79442ec15b56890c49e23953a6f622cd90c6eba0969a288803.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09e28fff075cf76b4fee94eb34dd9cb7ac1852fd16229bc2f9becd556e2cb10b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原美央子","creatorId":"vndb:s462","sourcePersonId":"vndb:s462","canonicalEntityId":"vndb:s462","name":"藤原 美央子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134039:49811:13824:1","source":"bangumi"}]},{"characterId":"char_c35461","characterName":"亜多良 巫鳥","sourceIds":{"bangumi":[{"characterId":"49809","match":"exact-normalized-name-in-linked-work","subjectId":"134039"}],"egsCharacterIds":["24710"],"vndbCharacterId":"c35461"},"originalCharacterName":"亜多良 巫鳥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student and a miko at the local shrine which is owned by her family. Midori is also a member of the fortune telling circle."}],"source":"vndb","sourceCharacterId":"c35461"},{"segments":[{"spoiler":false,"text":"舞台となる八阿多市にある稲継魂神社の巫女さん。八阿多学園の三年生で、主人公の先輩。"},{"spoiler":false,"text":"座右の銘は「人類みな無病息災」。おっとりした雰囲気を持つ、お姉さん気質の何処か頼って（甘えて？）しまいたくなる女の子。しかし、一つの物事に集中すると周囲が見えなくなる傾向があり、危なっかしい。"},{"spoiler":false,"text":"学園では占い研究会に在席し、その的中率は百パーセントに近い。"},{"spoiler":false,"text":"鋭敏な災厄センサーを持ち、強い不幸を感じると不幸回避に奔走し始める。"}],"source":"egs","sourceCharacterId":"24710","sourceWorkId":"8439","spoiler":false},{"segments":[{"spoiler":false,"text":"八阿多第二学園三年生。的中率抜群の占い研究会部 長。"},{"spoiler":false,"text":"おっとりした性格だが、強い厄(不幸)を感知すると 部活と称してその回避に奔走する。"},{"spoiler":false,"text":"神主の家系で、日頃から巫女服を身にまとい、その まま町に出ることも。"},{"spoiler":false,"text":"「あなた、憑かれてますね？」"}],"source":"bangumi","sourceCharacterId":"49809"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"24710","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"24710","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"24710","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"24710","sourceWorkId":"8439","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7540dbadcc9f609b223070a00dd6b27535d54a8221a4153b390b523018a455be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2c2bc66a687852b44c6c42cde4af02fb8199d1e5135c030851ffdff38ab537f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高梁碧","creatorId":"vndb:s1193","sourcePersonId":"vndb:s1193","canonicalEntityId":"vndb:s1193","name":"高梁 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134039:49809:4781:1","source":"bangumi"}]},{"characterId":"char_c35463","characterName":"天矢 深雨","sourceIds":{"bangumi":[{"characterId":"49808","match":"exact-normalized-name-in-linked-work","subjectId":"134039"}],"egsCharacterIds":["24709"],"vndbCharacterId":"c35463"},"originalCharacterName":"天矢 深雨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The school nurse. She is infamous due to her unmotivated personality and for the fact that she spends most of her time in the school's infirmary playing video games, with the students having given her the nickname of \"the hikikomori of the school's infirmary\". But because of her beauty and kind nature, Miu is popular with the boys. She is also Ayuno's older sister."}],"source":"vndb","sourceCharacterId":"c35463"},{"segments":[{"spoiler":false,"text":"八阿多学園の養護教諭。天矢鮎乃の姉。"},{"spoiler":false,"text":"グラマラスな美人、ニコニコ笑顔で男子学生からの人気は高い。しかし、学生たちから「ひきこもり保健医さん」と揶揄されるほど、気が向かないと仕事をしようとしない。"},{"spoiler":false,"text":"保健室からは終始、携帯ゲーム機の音が漏れている。学生たちが保健室に訪れても、彼女自身は何もやらず、学生たちがそれぞれ治療して教室に戻る、という光景がよく見られるが、不思議と評判は悪くない。"},{"spoiler":false,"text":"主人公とは旧知の仲で、何かと携帯電話で呼びつけ使いパシリをさせている。"}],"source":"egs","sourceCharacterId":"24709","sourceWorkId":"8439","spoiler":false},{"segments":[{"spoiler":false,"text":"「ひきこもり保険医さん」と呼ばれる、すーごくやる気のない養護教諭。"},{"spoiler":false,"text":"しかし何故か評判は悪くなく、いつもニコニコ笑顔 に加えグラマラス美人なため、男子ファンも多数。"},{"spoiler":false,"text":"主人公とは幼い頃からの付き合いで、よく使いっ走りをさせている。"},{"spoiler":false,"text":"「蓮くんに捨てられたら お姉ちゃん生きていけないんだよ～！」"}],"source":"bangumi","sourceCharacterId":"49808"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"24709","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"24709","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"24709","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"24709","sourceWorkId":"8439","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2d4c1971a1386e7ae6798550091f1eafc384e2b232894dfd110b953236053e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/157001dcd01215e910281d57a507bd2f4a02364151ee5b35089f99c53f506a8c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134039:49808:6038:1","source":"bangumi"}]},{"characterId":"char_c35464","characterName":"八千古島 華","sourceIds":{"bangumi":[{"characterId":"49812","match":"exact-normalized-name-in-linked-work","subjectId":"134039"}],"egsCharacterIds":["24713"],"vndbCharacterId":"c35464"},"originalCharacterName":"八千古島 華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ren's little sister-like second cousin and younger step sister. Her mother and older brother died during a traffic accident, while her father remarried with Ren's mother. She is also the poster girl to the sweets shop \"Yachi\"."}],"source":"vndb","sourceCharacterId":"c35464"},{"segments":[{"spoiler":false,"text":"主人公の義妹。両親が営む甘味処「八千」の看板娘。また主人公と同じ八阿多学園に通っている。一年生。"},{"spoiler":false,"text":"人当たりがよく、しっかりもののようにみえることもあって、学園でも学級委員を務め、優等生として通っているが、実はかなりのグータラ娘。口癖は「めんどいなーもー」である。兄である主人公には素の自分を見せており、唯一、本来の自分を解放する存在となっている。"},{"spoiler":false,"text":"特技は菓子作りで、お店で出されている「季節のあんみつ」は彼女の手によるもので、評判のメニューになっている。"}],"source":"egs","sourceCharacterId":"24713","sourceWorkId":"8439","spoiler":false},{"segments":[{"spoiler":false,"text":"甘味処の看板娘、主人公の妹で一年生。"},{"spoiler":false,"text":"人当たりよく学級委員も務める優等生だが、実際は ぐーたらで面倒くさがりや。"},{"spoiler":false,"text":"兄の前では本来の自分をさらけ出し、心許せる存在 としてひそかに慕っている。"},{"spoiler":false,"text":"「いらっしゃいませっ♪お客さま、おひとりさまですか？」"}],"source":"bangumi","sourceCharacterId":"49812"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"24713","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"24713","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"24713","sourceWorkId":"8439","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"24713","sourceWorkId":"8439","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a32492cca937f159b0c1c5badeca4923c83b483ebb92071555ee9304d7a7e2e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/imag