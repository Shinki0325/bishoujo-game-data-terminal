:"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wife of the eldest son, Daigo. A radiant beauty with a healthy, athletic charm, she met Daigo in college. Her background in rhythmic gymnastics makes her incredibly flexible — both physically and mentally. She cracks crude jokes on par with her husband, but her dirtiest traits are all talk and no action."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c61808"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84ed17b56717e3a28d070625429377291f78c5f49a787f010ad8bb4b960d57f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18da76ac177a7270ec3d08fa707f037e3c7daf7dcaf1b25d92e78ef52732805f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米良実 いお","creatorId":"vndb:s9696","sourcePersonId":"vndb:s9696","canonicalEntityId":"vndb:s9696","name":"米良実 いお","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74194","source":"vndb"}]},{"characterId":"char_vndb_c61809","characterName":"霧島 菫","sourceIds":{"vndbCharacterId":"c61809"},"originalCharacterName":"霧島 菫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wife of the second son, Shinji, and a former executive secretary who quit after marrying. Her sharp, elegant looks might make her seem cold, but she’s deeply compassionate. Though chaste and tidy, she’s surprisingly open-minded, accepting both the pure and the messy sides of life."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c61809"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f69b44dc29daed3955c77cd4663ccc5686847efc6cd8d797198de5bb9515fc24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43100fd9260b93eb7fe1e606764ef11e0e2e5e3c7dbebca596482fb4517f2b52.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天川 みるく","creatorId":"vndb:s573","sourcePersonId":"vndb:s573","canonicalEntityId":"vndb:s573","name":"天川 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74193","source":"vndb"}]},{"characterId":"char_vndb_c61810","characterName":"霧島 剛","sourceIds":{"vndbCharacterId":"c61810"},"originalCharacterName":"霧島 剛","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. The youngest of three brothers and a college student. An average-looking virgin, he’s in the wrestling club and might... just might... become an Olympic prospect. Usually sensible, but…"},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c61810"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c61811","characterName":"霧島 大悟","sourceIds":{"vndbCharacterId":"c61811"},"originalCharacterName":"霧島 大悟","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eldest brother. Shunran’s husband. Works nights as a security guard handling VIP protection. A former Olympic judo prospect with a so-so record but a reputation as unbeatable. Bold and straightforward, he adores his wife and trusts her unconditionally. His love for family runs deep — he even cherishes his logical younger brother and (comparatively) wimpy youngest brother. Talks dirty nonstop but would never actually cross the line."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c61811"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c61812","characterName":"霧島 信二","sourceIds":{"vndbCharacterId":"c61812"},"originalCharacterName":"霧島 信二","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second brother. Sumire’s husband. An elite corporate warrior who originally aimed to become a bureaucrat but chose the private sector to work on the front lines. Proud of his chaste, reserved wife. A logical thinker... except when it comes to family. He respects his older brother and dotes on the younger one."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c61812"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4991","sourceCompanyId":"egs:brand:4490","canonicalEntityId":"vndb:p4991","name":"桃源郷","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25164:4490","source":"egs"},{"companyId":"vndb:p3320","sourceCompanyId":"vndb:p3320","canonicalEntityId":"vndb:p3320","name":"WORLD PG","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:174988:v21214","source":"vndb"},{"companyId":"vndb:p4991","sourceCompanyId":"vndb:p4991","canonicalEntityId":"vndb:p4991","name":"桃源郷","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:174989:v21214","source":"vndb"},{"companyId":"vndb:p4991","sourceCompanyId":"vndb:p4991","canonicalEntityId":"vndb:p4991","name":"桃源郷","roleCodes":["developer","publisher"],"identitySta