vndb:vn-staff:7914","source":"vndb"}]},"cast":[{"characterId":"char_c11778","characterName":"十宮 夏姫","sourceIds":{"bangumi":[{"characterId":"11480","match":"exact-normalized-name-in-linked-work","subjectId":"11174"}],"egsCharacterIds":["13014"],"vndbCharacterId":"c11778"},"originalCharacterName":"十宮 夏姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very energetic and cheerful university student who have her teacher practice in the academy where the protagonist studies. She is lazy, capricious and short-tempered. Natsuki loves to tease Kaname and sexually harassing him."}],"source":"vndb","sourceCharacterId":"c11778"},{"segments":[{"spoiler":false,"text":"舞台となる私立君影学園に教育実習生としてやってきた大学四回生。"},{"spoiler":false,"text":"さばさばした明るい雰囲気のお姉さん。"},{"spoiler":false,"text":"大雑把でノリを重視する性格。"},{"spoiler":false,"text":"気さくで面倒見もよく、学生からの人気も上々。"},{"spoiler":false,"text":"酒好きで、泥酔すると泣き上戸になる。"}],"source":"egs","sourceCharacterId":"13014","sourceWorkId":"9114","spoiler":false},{"segments":[{"spoiler":false,"text":"现在大学4年级。作为教育实习生来到了学校。"},{"spoiler":false,"text":"爽快开朗的大姐。十分重视规章的性格。与谁都能无所顾忌地交谈。另一方面、爱照顾人这点也很受到学生的爱慕。"},{"spoiler":false,"text":"嗜酒。喝醉后爱哭。"},{"spoiler":false,"text":"在家里只穿件衬衫。但外出之时总体面地穿着固定的衣服。感觉打扮很帅气。"},{"spoiler":false,"text":"H的时候想要掌握主导权。"}],"source":"bangumi","sourceCharacterId":"11480"}],"profileFacts":[{"label":"年龄（本版本）","value":"22 岁","valueContext":null,"source":"egs","sourceCharacterId":"13014","sourceWorkId":"9114","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6309f685bfce0df2b4141872b7355707ebb9c2e2f148fffc6976bf9be745379f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96c20e6b90e40809627fdf32dde41cbd54ac6371680000c25f8822b94d749261.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11174:11480:4832:1","source":"bangumi"}]},{"characterId":"char_c11779","characterName":"黒崎 時雨","sourceIds":{"bangumi":[{"characterId":"10576","match":"exact-normalized-name-in-linked-work","subjectId":"11174"}],"egsCharacterIds":["13015"],"vndbCharacterId":"c11779"},"originalCharacterName":"黒崎 時雨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"922"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strict math teacher who hides her kind, romantic and feminine nature. She's capable of both tender love and a wild jealousy."}],"source":"vndb","sourceCharacterId":"c11779"},{"segments":[{"spoiler":false,"text":"舞台となる私立君影学園に補充人員としてやってきた教師。"},{"spoiler":false,"text":"クールで理知的なお姉さん。"},{"spoiler":false,"text":"夏姫とは対照的に、几帳面で、そろばんずくなタイプ。"},{"spoiler":false,"text":"普段から素っ気ない態度の多い彼女だが、"},{"spoiler":false,"text":"授業はわかりやすくしっかりしているため、学生からは尊敬されている。"},{"spoiler":false,"text":"お酒は好きではないが強い。"},{"spoiler":false,"text":"しかし飲み過ぎると、抑えていた感情が爆発することも……。"}],"source":"egs","sourceCharacterId":"13015","sourceWorkId":"9114","spoiler":false},{"segments":[{"spoiler":false,"text":"做了4年教员。作为补充人员来到学园。"},{"spoiler":false,"text":"理智冷漠的姐姐。性格墨守成规、重视计划。无论对谁都是一副冷漠的态度。不过因为务实的授课内容而受到学生尊敬。"},{"spoiler":false,"text":"不喜酒但是海量。不过因为平时冷漠的缘故，喝过量的话会感情爆发。"},{"spoiler":false,"text":"不管公私都穿的很郑重。其实是穿上衣服反而显得瘦的类型、胸围比夏姫大。H方面是很随便的类型。"},{"spoiler":false,"text":"“十条君、上学不要迟到哦”"}],"source":"bangumi","sourceCharacterId":"10576"}],"profileFacts":[{"label":"年龄（本版本）","value":"26 岁","valueContext":null,"source":"egs","sourceCharacterId":"13015","sourceWorkId":"9114","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54a5baaa7ea32f49dd28e0d49cd370b1ba241aa492631d0fbdf0ebd0663e79e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/282a1315334d4b6acdd7c171705ff36162b3df9f88c864e7df50d6b2f8e54556.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11174:10576:5741:1","source":"bangumi"}]},{"characterId":"char_c11781","characterName":"笹塚 都","sourceIds":{"bangumi":[],"egsCharacterIds":["13016"],"vndbCharacterId":"c11781"},"originalCharacterName":"笹塚 都","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miyako is a very shy girl who secretly in love with Kaname, but can't find a way to confess her feelings. She often gets mad at the Hanimi twins and their crazy ideas."}],"source":"vndb","sourceCharacterId":"c11781"},{"segments":[{"spoiler":false,"text":"学年：１年"},{"spoiler":false,"text":"真面目でがんばり屋の後輩。"},{"spoiler":false,"text":"その性格から、埴御ツインズによく怒っている。"},{"spoiler":false,"text":"執行部の仕事のほとんどは都と要で片付けている。"},{"spoiler":false,"text":"明るく友達が多いが、生真面目な性格から恋愛沙汰にはウブ。"},{"spoiler":false,"text":"こと自分の恋愛に関しては奥手。"},{"spoiler":false,"text":"背が小さいことを気にしている。"}],"source":"egs","sourceCharacterId":"13016","sourceWorkId":"9114","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54e656e5c918adc41d2362d644525ce127d5184f9f0c8