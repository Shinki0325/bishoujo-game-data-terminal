rce":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2292","characterName":"ナンパB","sourceIds":{"vndbCharacterId":"c2292"},"originalCharacterName":"ナンパB","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the three thugs always picking up fights downtown and causing conflicts to Yukiniojou and co."},{"spoiler":false,"text":"Unlike the other 2 he was not named in the game."}],"source":"vndb","sourceCharacterId":"c2292"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd8f7bbc981bb2636fc2fa6f1fb6f406fe8fcd0e16f69a514b1980804f439ce1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b94720eefd9ac53bbbb944674495edfb6b859a89bf1dfd6aa9550a93f12a3e7.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c252","characterName":"宇佐美 明男","sourceIds":{"vndbCharacterId":"c252"},"originalCharacterName":"宇佐美 明男","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year student at Ryouzuki school in the specially selected sports class, Masaru and Yukinojou's underclassman and a member of the school boxing club."},{"spoiler":false,"text":"A hot-blooded lad who is at odds with Yukinojou as he never could accept him with what he did to Masaru. He loves Shouko and untiredly makes moves on her, but his feelings, unfortunately, have yet to reach her."}],"source":"vndb","sourceCharacterId":"c252"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6041f18cef1bc72a079001f58b4a07b965e85ddfc1ed7daaf6675c131dc04f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cceec0e7f51c33f052d923b3bfbc58a9dcbb1f4b3f41414d405749b5bdb07b92.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c253","characterName":"春日 せりな","sourceIds":{"vndbCharacterId":"c253"},"originalCharacterName":"春日 せりな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"209"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year student in Kashima school. Cheerful, vigorous, naive, a girl really knowledgeable about lots of trivia but at the same time failing at her own studies. Commander of the Kasuga Independent Gang."},{"spoiler":false,"text":"Hates things being obscured, and often does her utmost to unravel things forcefully, a really open character. An avid gamer of the game center in town along with her two childhood friends, Teppei and Tatsuya."}],"source":"vndb","sourceCharacterId":"c253"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56cb2fb3fe2460e53b445129a4b93122e37f546c4bb24d1dc9914baaf13687e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f21a18f5478e4fd49c298a2a3377af585fe57d0e86fcbf34e793cc40eec86999.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川崎 恵理子","creatorId":"vndb:s121","sourcePersonId":"vndb:s121","canonicalEntityId":"vndb:s121","name":"川崎 恵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18149","source":"vndb"}]},{"characterId":"char_vndb_c254","characterName":"久保 晶子","sourceIds":{"vndbCharacterId":"c254"},"originalCharacterName":"久保 晶子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"908"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Masaru's little sister and Yukinojou's childhood friend. She was the former manager of the boxing club when those two were still active members, even though she did not really enjoy boxing. The thought of her beloved brother and childhood friend \"beating\" each other always filled her with uneasiness."},{"spoiler":false,"text":"Following the accident sending Masaru into coma, she harshly condemned Yukinojou, who was unable to bear this and moved to Kashima city. Short while later Shouko followed him, as she didn't intend to let him off the hook so easily."},{"spoiler":true,"text":"After becoming heartbroken during the first game's course and following Masaru's awakening, she came back to Ryouzuki. Nowadays, it seems she has completely gained back her normal cheerfulness and kindness. She's a reliable girl who takes care of her incompetent older brother and object of admiration for many in Ryouzuki school, especially for Gonzou and Akio."}],"source":"vndb","sourceCharacterId":"c254"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16c461fb7d3204f9736436a3543a514a61831086c0841a764acfcb681af12d22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e875a28e57908396e1c33e3ed19143ada1cc4ee60c914164123cfcab9ec722dd.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c259","characterName":"久保 勝","sourceIds":{"vndbCharacterId":"c259"},"originalCharacterName":"久保 勝","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The title giver of the sequel game, Masaru."},{"spoiler":false,"text":"His boxing skills are probably at the same level as Yukinojou's, but due to his accident, it'd be quite difficult for him to continue. He was the one who introduced boxing to Yukinojou. They are best friends of each other and eternal rivals at boxing at the same time."},{"spoiler":false,"text":"He's basically a huge and lovable idiot, but when it comes to making decisions, he's definitely a guy who'll make firm choices and stick to them. He's not a morning person though and most of the time if his sister, Shouko, or their mom wouldn't wake him up (with various -often violent- methods they devise) then he'd sleep 'till well into the afternoon."},{"spoiler":false,"text":"Dislikes studying and loves playing games (including those in the game centers), movies, model toys; one could very well say he's a male version of Serina."}],"source":"vndb","sourceCharacterId":"c259"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e78c7ec9b209653f35c92cfcbb3409096a65336a75197cfa80c165edeb16cdbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bfe85d4245b15b63edf0902601199e593dc73fc1df483e3b4ffe24c62ebdb43.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c397","characterName":"雪村 雪之丞","sourceIds":{"vndbCharacterId":"c397"},"originalCharacterName":"雪村 雪之丞","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist and the title giver of Ashita no Yukinojou (the other half, \"Ashita no\", is a reference to the boxing manga Ashita no Joe). A genius boxer who after a certain incident completely abandoned boxing."},{"spoiler":true,"text":"The aforementioned event shocked him so much that he is completely unable to hit anyone."},{"spoiler":false,"text":"He transferred to the second year of Kashima school, into Serina's class. He's exceedingly fit, but at the same time taciturn and unsociable toward everyone."}],"source":"vndb","sourceCharacterId":"c397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df468c5cc9941f903b046e93035c467198d19ae1e16f3fcfe5665cd438be3645.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8354e52396b893e29daeac8583c36b853af42840f0e422a3e25ce1d2fa49182f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:70","sourceCompanyId":"egs:brand:70","canonicalEntityId":"egs:brand:70","name":"elf","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:1567: