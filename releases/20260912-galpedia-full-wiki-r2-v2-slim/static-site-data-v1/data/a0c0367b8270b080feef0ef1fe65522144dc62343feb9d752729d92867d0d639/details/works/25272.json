{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25272","model":{"presentationWorkId":"egs:25272","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"寺澤善徳","creatorId":"vndb:s11717","sourcePersonId":"egs:creator:16463","canonicalEntityId":"vndb:s11717","name":"寺澤善徳","detail":"プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:186949","source":"egs"},{"creditedName":"菅原隆行","creatorId":"egs:creator:30900","sourcePersonId":"egs:creator:30900","canonicalEntityId":"egs:creator:30900","name":"菅原隆行","detail":"監督、企画、シナリオ原案","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:186950","source":"egs"},{"creditedName":"丸谷竜也","creatorId":"egs:creator:30901","sourcePersonId":"egs:creator:30901","canonicalEntityId":"egs:creator:30901","name":"丸谷竜也","detail":"プロジェクトマネージャー","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:186951","source":"egs"},{"creditedName":"中尾文子","creatorId":"egs:creator:30902","sourcePersonId":"egs:creator:30902","canonicalEntityId":"egs:creator:30902","name":"中尾文子","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"alias-only-review","relationId":"egs:work-creator:186952","source":"egs"}]},"cast":[{"characterId":"char_bangumi_68922","characterName":"ひぐらし はると","sourceIds":{"bangumi":[{"characterId":"68922","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"ひぐらし はると","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真実の記事によって人の助けとなることを志し、「真白出版」という出版社に就職した編集者。生真面目で常識的な性格のため、強烈なキャラクター性の持ち主ばかりである他の面々のツッコミ役に回っている。"},{"spoiler":false,"text":"真面目ではあるが保守的でなくむしろ知的探求心が旺盛なところがあり、リョウのアートの対象になろうとしたり人の内面を分析したりしている。"},{"spoiler":false,"text":"ソイネマッチングの効果は「通常攻撃のダメージの増加」。全キャラで唯一全ての近接武器に適性を持つ他、異常回復系を除くキャラごとに適性が異なるスキルを全て中程度に使いこなせるマルチキャラ。それ以外の補助効果が乏しい。器用であり、金庫の開錠も得意。"}],"source":"bangumi","sourceCharacterId":"68922"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e5d33d795649ca517df7b30c556843a50ef414651f2df3415462bdb3c57c353.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cd72d3e16c55196f174de7a105632821d3f117d5c4896b70a552eadced7bd46.webp","width":132,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68923","characterName":"みかじめ りょう","sourceIds":{"bangumi":[{"characterId":"68923","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"みかじめ りょう","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人物・物品問わずに縛り上げ、その姿を写真に残すことで芸術とする自称「緊縛アーティスト」。ただし、あまり儲かってはいないらしくカメラマンも兼業。軽薄で能天気な発言が多い一方、裏表がなく純粋であるため人に好かれるタイプ。"},{"spoiler":false,"text":"ムードメーカーだが、怖気づいて後ろ向きな意見を出すこともある。概ねゼンやユマにいじられることが多い。大の野菜嫌い。"},{"spoiler":false,"text":"ソイネマッチングの効果は「マッピング範囲の拡張」。クリオネに関連したスキルが豊富で、後列において攻撃力・防御力を強化させることができるが、本作の主力である斬撃に適性がない。釣りが得意。"}],"source":"bangumi","sourceCharacterId":"68923"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5f34d3e3f7bfe97c3177ed544501b938d92e9e32f517bdc1ddf88c3e9eb968c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a32fa5e9fe8b36c50fe7438995761d2980bc3d5a3a4843c1bf2181889340c62b.webp","width":236,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68924","characterName":"くぼた ぜん","sourceIds":{"bangumi":[{"characterId":"68924","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"くぼた ぜん","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"農業を営む青年。中性的な外見と裏腹な毒舌家であり、本心の読めない辛辣な言動で周囲を振り回す。名字で呼ばれることを嫌っており、他の人物もあだ名で呼ぶことが多い。"},{"spoiler":false,"text":"度々攻撃的な面を見せることもあるが、世話好きなところもあり家庭菜園も手掛ける。"},{"spoiler":false,"text":"ソイネマッチングの効果は「獲得スコアの増加」。前後列双方で攻撃力が上昇するスキルを持つなど、攻撃能力が高い。また、スキルでもスコアの獲得量を増加させられる。採取と狩猟が得意。"}],"source":"bangumi","sourceCharacterId":"68924"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f66afa33bef1cf841def8cfe61aea5d7cffc460c94578876a6b652461181557b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a70d256d059da27242f7c7eda275f0bfac34bfd638522b02cdfb6773c19733f.webp","width":183,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68925","characterName":"いちよう まもる","sourceIds":{"bangumi":[{"characterId":"68925","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"いちよう まもる","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"筋骨隆々の体格を誇る小児科志望の研修医。理知的な振る舞いで周囲を落ち着かせる一方、悪ふざけには全力で付き合ったりと羽目を外すこともある。「愛」が口癖。"},{"spoiler":false,"text":"ソイネマッチングの効果は「一部状態異常発生の無効」。前列における戦闘適正とあらゆる回復アイテム適正が高く、さらに積載重量も高いという万能キャラ。狩猟が得意。"}],"source":"bangumi","sourceCharacterId":"68925"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/711a8d9729c77c3032b6fe22d635412a3e4a489ad01071a34af7f3fcbcecaf19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8ff39859a9e5d6ce62741f11bc15cc3a0b693accda2112e2cbe192eb322b4c0.webp","width":254,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68926","characterName":"すすきの りん","sourceIds":{"bangumi":[{"characterId":"68926","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"すすきの りん","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"花屋で働く女性。優しくおっとりとした性格だが、一方で周囲を困惑させる天然ボケのような発言も多い。やや理想主義で仲間意識が強い。"},{"spoiler":false,"text":"ソイネマッチングの効果は「チャージ速度の増加及びチャージ中のスタミナ減少無効」。なお、副次効果としてフルチャージのマーカー範囲も増加する。前後列双方で攻撃力が上昇するスキルを持ち、回復を強化するスキルを持つなど前線維持向けのキャラ。また、ソイネマッチングの効果に加えて斬撃を得意とするため、攻撃能力も高め。ハルト同様戦闘以外のスキルを中程度にこなす。"}],"source":"bangumi","sourceCharacterId":"68926"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d02573af41e6398c0c21efc43113e12bb8cf3576b3b558d0138ba05f6f850715.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be7ecedbf9b7695ae13bba248ac3465b3f177c088af7a3c8fac3ae5766ce75e9.webp","width":168,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68927","characterName":"ましろ ゆま","sourceIds":{"bangumi":[{"characterId":"68927","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"ましろ ゆま","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ぽっちゃりとした体形が特徴的な、真白財閥の令嬢。常に冷淡な口調で他者との慣れ合いを好まないが、その体型通り食べることには目がなく、時には食事を想像して口を動かす「エア食事」に耽る姿も見せる。"},{"spoiler":false,"text":"表情があまり変わらないまま冗談を言ったりするなど、つかみどころが内面も持つ。幼年期は普通の体系だが、曰く落ち着かないらしい。実はゲーム好き。"},{"spoiler":false,"text":"ソイネマッチングの効果は「確率でアイテムのドロップ数＋1」。後列の戦闘適応が高いが、近接攻撃は一番攻撃力が低くバリエーションも少なめな刺突しか適性がない。一方、元々女性陣が得意な投射武器に対し、固有のスキルを持つ。狩猟が得意。"}],"source":"bangumi","sourceCharacterId":"68927"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca8cb533493f859b8f04d4d12d43938aea26ec3e96bb3e4322f0e1bb7f316019.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/372540004931631d4c07202b180ba580588180ac4a5ae1fe4070d9e7019f2b61.webp","width":256,"height":231,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68928","characterName":"せとうち みなも","sourceIds":{"bangumi":[{"characterId":"68928","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"せとうち みなも","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"関西弁で話す警察官の女性。明るく快活な性格で、正義感の強さからお節介焼きな一面も持つ。"},{"spoiler":false,"text":"弟がいた経験からか世話好きで、料理も得意。"},{"spoiler":false,"text":"ソイネマッチングの効果は「低確率で致死ダメージに耐える」。前列で攻撃力・防御力を上げられる他、チャージを高速化できるスキルを持つ。料理回数を増やしたりアイテム使用対象のスタミナやストレスを回復させるなど、サポート効果も多い。狩猟が得意。"}],"source":"bangumi","sourceCharacterId":"68928"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3d848cb1649b82814dce16c2cd84c99ff11d549f0a5e396cd4e03f39481a1f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01ac3b24c0ed32d2efa1abd48697c5ca2c5e29f98be57432d292d7c77d7418b1.webp","width":256,"height":243,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68929","characterName":"ひらさか さちか","sourceIds":{"bangumi":[{"characterId":"68929","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"ひらさか さちか","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"右手・左足が義肢となった少女。唯一肩書が七つの大罪に由来せず、成長状態も少女で固定されているなど8人の中では異質な存在となっている。"},{"spoiler":false,"text":"義肢は古いギャグ作品に出てくるようなレトロなデザインだが、意外にも細かい作業が得意。また、義肢は所持品扱いらしく死亡するとその場に残るようだが、再生された体にも装着されていたりする。"},{"spoiler":false,"text":"ソイネマッチングの効果は「獲得経験値の増加」。様々なスキルを高いレベルで扱える一方、他のメンバーよりも幼い年齢で固定されているため身体能力が低い。世代に応じた適応スキルを持たない代わりに、コストパフォーマンス高めの戦闘補助スキルを習得できる。コンボゲージの現象を抑えるスキルを持つため、スコア稼ぎにも便利。"}],"source":"bangumi","sourceCharacterId":"68929"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/0515394ec519fcc34fc52b08e628b4811ad65b1e5c9f178ce4107a27fa2b5146.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e31477de576b9b92a046bd9858d9f826d28c3f5793479e1967346d203bcaed0e.webp","width":232,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68930","characterName":"Terashima Shou","sourceIds":{"bangumi":[{"characterId":"68930","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"Terashima Shou","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TV番組「エクステンドTV」のアシスタントを務める少年。主にボケ担当。"},{"spoiler":false,"text":"小学生なのだが、攻略ビデオをアレなビデオだと勘違いして大興奮するなど、スケベなところがある。"},{"spoiler":false,"text":"寒いダジャレに対する制裁など、時折差し向けられるギロチンを分身して回避できるほど身体能力が高い。"}],"source":"bangumi","sourceCharacterId":"68930"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e3e95c96e60204f4ad9071dfcdf3a076cb1842bf24f100ae2b529222397f3ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7883cade736a3dfd020d1c131e9b7fbb19345bef96a558cd22693529d78d9da8.webp","width":84,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68931","characterName":"Mirai","sourceIds":{"bangumi":[{"characterId":"68931","match":"source-roster","subjectId":"214519"}]},"originalCharacterName":"Mirai","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「エクステンドTV」の番組MCを務めるマスコット。雌羊。主にツッコミ担当。"},{"spoiler":false,"text":"ショウとは違い、ギロチンには毎回直撃してペケ字キーを残して消滅する。"}],"source":"bangumi","sourceCharacterId":"68931"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38d9926a599ba92467d99d086487daf432a7e4b8bd4da2420a0541a842925550.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2911ddaecefee497608f0141b6045010eaaf5f5fa38443bbe974d4a02658839.webp","width":175,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2807","sourceCompanyId":"egs:brand:741","canonicalEntityId":"vndb:p2807","name":"スパイク・チュンソフト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25272:741","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
