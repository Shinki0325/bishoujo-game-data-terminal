:{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13f0c0ef62d4abb7b5b3509df99b072bd5332c485f454586d816688d047422fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2fd26e34583b15622c219913002d716c0d73bc9b31d5035cf6753c6d648780b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さとう実琴","creatorId":"vndb:s117","sourcePersonId":"vndb:s117","canonicalEntityId":"vndb:s117","name":"真宮鈴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80909:92092:18740:1","source":"bangumi"}]},{"characterId":"char_vndb_c5342","characterName":"柊 望未","sourceIds":{"vndbCharacterId":"c5342"},"originalCharacterName":"柊 望未","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The other main character."},{"spoiler":false,"text":"He shares a room with Raika in the dorms."},{"spoiler":false,"text":"He's friendly and can get along with pretty much anyone, but he doesn't have any particularly close friends."},{"spoiler":false,"text":"He's a bit off-putting and hard to pin down."},{"spoiler":false,"text":"He has surprisingly strong nerves."},{"spoiler":true,"text":"When she was in high school, his sister came to the aid of a student who was being bullied."},{"spoiler":true,"text":"After that, the other students started bullying and raping her, including the student she had helped."},{"spoiler":true,"text":"She finally committed suicide on graduation day."},{"spoiler":true,"text":"To take revenge, Hiiragi decided to seek out the former students who had attacked his sister and kill them. The last of these former students are now teachers at the same high school as Raika's brother."}],"source":"vndb","sourceCharacterId":"c5342"}],"profileFa