{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21142","model":{"presentationWorkId":"vndb:v16794","staff":{"artwork":[{"creditedName":"置弓枷","creatorId":"vndb:s3561","sourcePersonId":"egs:creator:3501","canonicalEntityId":"vndb:s3561","name":"置弓枷","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:139058","source":"egs"}],"scenario":[{"creditedName":"嘘屋 佐々木酒人","creatorId":"vndb:s4095","sourcePersonId":"egs:creator:1134","canonicalEntityId":"vndb:s4095","name":"嘘屋 佐々木酒人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:139059","source":"egs"}],"music":[],"other":[{"creditedName":"デミトロ・バジーナ大尉","creatorId":"vndb:s16131","sourcePersonId":"egs:creator:23105","canonicalEntityId":"vndb:s16131","name":"デミトロ・バジーナ大尉","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:146099","source":"egs"},{"creditedName":"嘘屋 佐々木 酒人","creatorId":"vndb:s4095","sourcePersonId":"vndb:s4095","canonicalEntityId":"vndb:s4095","name":"嘘屋 佐々木 酒人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117544","source":"vndb"},{"creditedName":"デミトロ・バジーナ大尉","creatorId":"vndb:s16131","sourcePersonId":"vndb:s16131","canonicalEntityId":"vndb:s16131","name":"デミトロ・バジーナ大尉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117545","source":"vndb"}]},"cast":[{"characterId":"char_c29816","characterName":"女部田 勝代","sourceIds":{"bangumi":[{"characterId":"126435","match":"exact-normalized-name-in-linked-work","subjectId":"128903"}],"egsCharacterIds":["5852"],"vndbCharacterId":"c29816"},"originalCharacterName":"女部田 勝代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"剣道部の部長で、首都圏下でも屈指の剣士。"},{"spoiler":false,"text":"いっけん寡黙でとっつきにくい印象。"},{"spoiler":false,"text":"人見知り。"},{"spoiler":false,"text":"本来は純情かつ寂しがり屋で、割と愛嬌があるほうだが、幼少から珍姓を理由にいじめられていたため、他人になかなか心を許そうとしない。"},{"spoiler":false,"text":"両親はおらず祖父と二人暮らし。"},{"spoiler":false,"text":"家は由緒正しい道場だが門下生はおらず、祖父は借金を抱えて頭を悩ませている。"}],"source":"egs","sourceCharacterId":"5852","sourceWorkId":"21142","spoiler":false},{"segments":[{"spoiler":false,"text":"剑道部部长，首都圈内屈指可数的剑士。"},{"spoiler":false,"text":"外表看上去给人以沉默寡言和难以相处的印象，但其实很认生。"},{"spoiler":false,"text":"从小就因为怪异的姓氏被人欺负，所以不怎么对人敞开心扉。"},{"spoiler":false,"text":"本来是纯情和容易感到寂寞的女孩，特别可爱。"},{"spoiler":false,"text":"没有双亲，和祖父生活。"},{"spoiler":false,"text":"家里是历史悠久的道场，但没有学生，祖父因为欠债而烦恼。"}],"source":"bangumi","sourceCharacterId":"126435"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e80d493489be3362dba3857c43f6d91d5c933aa1a2ada5e1fa036e01c8c08ab9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74947fa4cde2fd87b81686e886fe171448790882e08037426b937d954afa498a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128903:126435:20833:1","source":"bangumi"}]},{"characterId":"char_c29817","characterName":"花山院 織雅","sourceIds":{"bangumi":[{"characterId":"126436","match":"exact-normalized-name-in-linked-work","subjectId":"128903"}],"egsCharacterIds":["5853"],"vndbCharacterId":"c29817"},"originalCharacterName":"花山院 織雅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる学園の名誉理事の孫娘。"},{"spoiler":false,"text":"乗馬をたしなみ、副主将待遇で乗馬部に所属している。"},{"spoiler":false,"text":"日露のハーフ。髪・瞳・肌色はロシア人の母親似。"},{"spoiler":false,"text":"非常に慎み深く、思いやり深く、誇り高く、そして何より「人智を超越した天の法としての『正義』を信じる」性格。"},{"spoiler":false,"text":"存命の血縁者は父方の祖母一人で、大きな屋敷に一緒に住んでいる。"}],"source":"egs","sourceCharacterId":"5853","sourceWorkId":"21142","spoiler":false},{"segments":[{"spoiler":false,"text":"学园的名誉理事的孙女。日俄混血，头发、瞳色、皮肤都和俄罗斯人的母亲很相似。"},{"spoiler":false,"text":"性格谦虚谨慎，体贴人，为人高傲，最重要的是深信“正义”是超越人智的天则。"},{"spoiler":false,"text":"喜欢马术，在学园以副主将的待遇加入骑马部。"},{"spoiler":false,"text":"还在世的血亲还有父方的祖母，在豪宅一起生活。"}],"source":"bangumi","sourceCharacterId":"126436"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cf75b47167205a698e959ae62794ec60f9b816dcd2791fb42e835d21d2ebfab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa4486fe83214e8dd655fee2702c4f5cd28f43653dbfb04f30d8866b612c1a35.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128903:126436:6046:1","source":"bangumi"}]},{"characterId":"char_c29818","characterName":"漆間 ひかり","sourceIds":{"bangumi":[{"characterId":"126437","match":"exact-normalized-name-in-linked-work","subjectId":"128903"}],"egsCharacterIds":["5854"],"vndbCharacterId":"c29818"},"originalCharacterName":"漆間 ひかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"最近本学園に転入してきた一年生。"},{"spoiler":false,"text":"片田舎出身。崩壊家庭に耐えかねて芸能界に飛び込んだ。"},{"spoiler":false,"text":"自分に巡ってきた最初で最後のチャンスを逃さないため彼女は必死。"},{"spoiler":false,"text":"現在は一山いくらのグループの一員に過ぎないが、目標はズバリ「トップアイドルになること」。"},{"spoiler":false,"text":"愛らしい見た目からは想像できない腹黒な野心家だ。"}],"source":"egs","sourceCharacterId":"5854","sourceWorkId":"21142","spoiler":false},{"segments":[{"spoiler":false,"text":"最近转入学园的1年生。"},{"spoiler":false,"text":"偏僻乡村出身，和可爱的外表相反，有着野心家的本性。"},{"spoiler":false,"text":"无法容忍破裂的家庭而进入了演艺圈。"},{"spoiler":false,"text":"为了抓住第一个也是最后一个机会而卯足全力。"},{"spoiler":false,"text":"虽然现在只不过是一文不值的团体一员，但目标很直接，就是“成为第一的偶像”。"}],"source":"bangumi","sourceCharacterId":"126437"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb47fb0774b45e32d08a40de7255122bceeb944ae20a29bbb38e5d8aca1aa514.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea03c9634902faa14a2e262c693001edb67c91612cf31f8046861f42f9398c76.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"湖月 ゆら","creatorId":"vndb:s9102","sourcePersonId":"vndb:s9102","canonicalEntityId":"vndb:s9102","name":"湖月 ゆら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63020","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p5004","sourceCompanyId":"egs:brand:4404","canonicalEntityId":"vndb:p5004","name":"Drei","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21142:4404","source":"egs"},{"companyId":"vndb:p24847","sourceCompanyId":"vndb:p24847","canonicalEntityId":"vndb:p24847","name":"Violette Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:148480:v16794","source":"vndb"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:148481:v16794","source":"vndb"},{"co