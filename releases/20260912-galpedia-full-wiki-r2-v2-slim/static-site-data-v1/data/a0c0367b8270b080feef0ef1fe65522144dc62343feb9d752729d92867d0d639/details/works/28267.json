-native","relationId":"vndb:vn-staff:108741","source":"vndb"},{"creditedName":"せんや","creatorId":"vndb:s31211","sourcePersonId":"vndb:s31211","canonicalEntityId":"vndb:s31211","name":"せんや","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108742","source":"vndb"}]},"cast":[{"characterId":"char_c19335","characterName":"白坂 美桜","sourceIds":{"bangumi":[{"characterId":"24269","match":"exact-normalized-name-in-linked-work","subjectId":"100380"}],"egsCharacterIds":["3630"],"vndbCharacterId":"c19335"},"originalCharacterName":"白坂 美桜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 3-C"},{"spoiler":false,"text":"Taichi and Mei's older sister, a gentle, kind, and intelligent girl."},{"spoiler":false,"text":"Mio has been holed up in her room for a while since an assailant violated her. However, after meeting Yuka on the Internet, she gradually recovers and proposes moving out of the loathsome city to her family."},{"spoiler":false,"text":"After the move and joining a particular organization at Yuka's recommendation, she seems to have regained her lost happiness ....."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c19335"},{"segments":[{"spoiler":false,"text":"穏やかで優しく、聡明な少女。"},{"spoiler":false,"text":"暴漢に強姦されたことが原因でしばらく自室にひきこもっていたが、ネット上で友佳と出会ったことをきっかけに徐々に立ち直り、家族に忌まわしい街からの引越しを提案。"},{"spoiler":false,"text":"移住先の街で、友佳の勧めからとある団体に加入する。"},{"spoiler":false,"text":"引越し後、すっかり以前の明るさを取り戻したように見えるが……"}],"source":"egs","sourceCharacterId":"3630","sourceWorkId":"20325","spoiler":false},{"segments":[{"spoiler":false,"text":"救いなんて、ない。"},{"spoiler":false,"text":"白坂 美桜 （しらさか みお）"},{"spoiler":false,"text":"身长：164cm　 バストサイズ：G CUP"},{"spoiler":false,"text":"所属：桜丘学园 3年C组"},{"spoiler":false,"text":"沉稳温柔的聪慧少女。"},{"spoiler":false,"text":"因为被歹徒强暴的原因一段时间封闭在自己的房间里。"},{"spoiler":false,"text":"但是以在网上与友佳相遇为契机逐渐恢复，对家人提出搬离这个不堪回首的城市。"},{"spoiler":false,"text":"在迁移的城市里在友佳的劝说下加入了某个团体。"},{"spoiler":false,"text":"搬家之后虽然外表上完全恢复了以前的开朗性格，但是……"},{"spoiler":false,"text":"穏やかで優しく、聡明な少女。"},{"spoiler":false,"text":"暴漢に強姦されたことが原因でしばらく自室に引きこもっていた。"},{"spoiler":false,"text":"しかしネット上で友佳と出会ったことをきっかけに徐々に立ち直り、家族に忌まわしい街からの引越しを提案。"},{"spoiler":false,"text":"移住先の街で、友佳の勧めからとある団体に加入する。"},{"spoiler":false,"text":"引越し後、すっかり以前の明るさを取り戻したように見えるが……"}],"source":"bangumi","sourceCharacterId":"24269"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e79512244a49ee8fcf33890a81dacb4694d951b34e2c1ab7c49dbb51c2dc0c1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cfe19ccbde26ddda4561d33a69a10eccb2e29b032bb426cc12b801b15a276e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100380:24269:6379:1","source":"bangumi"}]},{"characterId":"char_c19338","characterName":"白坂 芽生","sourceIds":{"bangumi":[{"characterId":"24270","match":"exact-normalized-name-in-linked-work","subjectId":"100380"}],"egsCharacterIds":["3631"],"vndbCharacterId":"c19338"},"originalCharacterName":"白坂 芽生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: Nozawa Academy"},{"spoiler":false,"text":"The younger sister of Taichi and Mio."},{"spoiler":false,"text":"Mei is a well-raised girl who is honest, lively, and innocent."},{"spoiler":false,"text":"She is not informed of the details of the incident involving her older sister, Mio, and is told that it was a traffic accident. Mei is concerned about her sister, who has been depressed since then, and is relieved that Mio has found happiness in the new home."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c19338"},{"segments":[{"spoiler":false,"text":"美桜と大智の妹。"},{"spoiler":false,"text":"素直で明るく、天真爛漫ながら、育ちの良さを感じさせる礼儀正しい少女。"},{"spoiler":false,"text":"姉である美桜の事件については詳しく知らされておらず、「交通事故」と聞かされている。"},{"spoiler":false,"text":"以来ふさぎ込んでいた姉を心配しており、移住先で明るさを取り戻したことを、素直に喜ぶ。"}],"source":"egs","sourceCharacterId":"3631","sourceWorkId":"20325","spoiler":false},{"segments":[{"spoiler":false,"text":"白坂 芽生 （しらさか めい）"},{"spoiler":false,"text":"白坂 芽生"},{"spoiler":false,"text":"身长：149cm　 バストサイズ：AA CUP"},{"spoiler":false,"text":"所属：野沢学园"},{"spoiler":false,"text":"美桜和大智的妹妹。"},{"spoiler":false,"text":"开朗率直，天真烂漫而让人感觉有良好教养的礼仪端正的少女。"},{"spoiler":false,"text":"对姐姐美桜的事件不明详细，只听说是“交通事故”。"},{"spoiler":false,"text":"自那以后便担心着阴郁的姐姐，在搬家处看见她恢复了开朗的性格而欣喜不已。"},{"spoiler":false,"text":"美桜と大智の妹。"},{"spoiler":false,"text":"素直で明るく、天真爛漫ながら、育ちの良さを感じさせる礼儀正しい少女。"},{"spoiler":false,"text":"姉である美桜の事件については詳しく知らされておらず、“交通事故” と聞かされている。"},{"spoiler":false,"text":"以来ふさぎ込んでいた姉を心配しており、移住先で明るさを取り戻したことを、素直に喜ぶ。"}],"source":"bangumi","sourceCharacterId":"24270"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4511185fa51ad71433b57652b29c7d739a8451d5ad94ac5b1335ce9427c3243.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52e874763f954a9019f63696ed6364d24cf54b9f16f7790f3203a151343233e0.