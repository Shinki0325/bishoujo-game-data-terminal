rmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"623"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ever since losing his childhood friend in a traffic accident, he has been experiencing uncontrollable suicidal tendencies. However, his attempts have always ended in failure."},{"spoiler":false,"text":"\"Why couldn't I save Sorano?\" The thought constantly hounds him."},{"spoiler":false,"text":"\"If it really was your fault that Sorano died, then you can gladly go after her, can't you?\" So says Amamiya, as he suggest he speak with Sorano's memories."},{"spoiler":false,"text":"And so, Kusuhara and Amamiya set off, towards the Connect Center, but--"}],"source":"vndb","sourceCharacterId":"c33125"},{"segments":[{"spoiler":false,"text":"本作の主人公"},{"spoiler":false,"text":"幼馴染を交通事故で亡くしてから自分では制御できない自殺衝動により自殺未遂を図るがいつも失敗している"},{"spoiler":false,"text":"「何故そらのを助けられなかったのだろう」という思いに囚われている楠原に対し「本当にお前のせいでそらのちゃんが死んだなら今度こそ気持ちよく後を追えるじゃん」"},{"spoiler":false,"text":"雨宮はそらのの記憶と話す事を提案する"},{"spoiler":false,"text":"そうして楠原と雨宮はコネクトセンターへと向かうのだが――"}],"source":"egs","sourceCharacterId":"6473","sourceWorkId":"22114","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"高校時代を共に過ごした女の子、瑞梨そらのを交通事故で亡くしてから、"},{"spoiler":false,"text":"自分では制御できない自殺衝動により、自殺未遂を図るがいつも失敗している。"},{"spoiler":false,"text":"「何故そらのを助けられなかったのだろう」"},{"spoiler":false,"text":"という思いに囚われている楠原に対し"},{"spoiler":false,"text":"「本当にお前のせいでそらのちゃんが死んだなら、今度こそ気持ちよく後を追えるじゃん」"},{"spoiler":false,"text":"翔はそらのの記憶と話す事を提案する。"},{"spoiler":false,"text":"そうして楠原と翔は、コネクトセンターへと向かうのだが――"}],"source":"bangumi","sourceCharacterId":"50777"}],"profileFacts":[{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"6473","sourceWorkId":"22114","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de84ce464ecfd4d653331393715a6f03b6fe19fe3efb8b55d3089071c5595fe5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab741e1c1ebe3d8bb8730563c8d1a1cd9ea74d08e61dfa9a3ea815d9dd0054d1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石谷春貴","creatorId":"vndb:s8318","sourcePersonId":"vndb:s8318","canonicalEntityId":"vndb:s8318","name":"石谷 春貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:195299:50777:2404:1","source":"bangumi"}]},{"characterId":"char_c33127","characterName":"瑞梨 そらの","sourceIds":{"bangumi":[{"characterId":"50780","match":"exact-normalized-name-in-linked-work","subjectId":"195299"}],"egsCharacterIds":["6474"],"vndbCharacterId":"c33127"},"originalCharacterName":"瑞梨 そらの","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"307"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kusuhara's now-deceased childhood friend. She normally has an easy, gentle personality, but sometimes shows a stubborn side to her as well. Kusuhara, Amamiya, and Sorano were always together wherever they went, and were best friends. However, Sorano lost her life just one month prior due to a traffic accident. According to the police report, she had thrown herself in front of a car, but Kusuhara refused to believe she would ever commit suicide. Determined, he decides to speak with Sorano's memories. The truth behind of her death is--"}],"source":"vndb","sourceCharacterId":"c33127"},{"segments":[{"spoiler":false,"text":"楠原の幼なじみだった女の子"},{"spoiler":false,"text":"普段はふんわりとした性格でありながら時には芯のある一面を見せることも"},{"spoiler":false,"text":"楠原と雨宮とそらの何をするにもいつも一緒の仲だったが一ヶ月前に交通事故で亡くなってしまう"},{"spoiler":false,"text":"警察の報告では自ら車に飛び込んだとされているが自殺である事が信じらない楠原は“そらのの記憶”と話す事を決意する"},{"spoiler":false,"text":"そらのの死の真相とは果たして――"}],"source":"egs","sourceCharacterId":"6474","sourceWorkId":"22114","spoiler":false},{"segments":[{"spoiler":false,"text":"裕樹と仲の良かった女の子。"},{"spoiler":false,"text":"普段はふんわりとした性格でありながら、時には芯のある一面を見せることも。"},{"spoiler":false,"text":"裕樹と翔とそらの、高校時代は何をするにもいつも一緒の仲だったが、"},{"spoiler":false,"text":"一ヶ月前に交通事故で亡くなってしまう"},{"spoiler":false,"text":"警察の報告では、自ら車に飛び込んだとされているが、"},{"spoiler":false,"text":"自殺である事が信じらない裕樹は“そらのの記憶”と話す事を決意する"},{"spoiler":false,"text":"そらのの死の真相とは果たして――"}],"source":"bangumi","sourceCharacterId":"50780"}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"6474","sourceWorkId":"22114","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"6474","sourceWorkId":"22114","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcce5d5124ae39c358021583123e8c96d659f3d1cd01c0d61aace27fca79277f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/6776bc352700dc208bc5bd90a9df8401f48ed69f0f4df747bf5e884498e31267.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤聡美","creatorId":"vndb:s4838","sourcePersonId":"vndb:s4838","canonicalEntityId":"vndb:s4838","name":"佐藤聡美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:195299:50780:5003:1","source":"bangumi"}]},{"characterId":"char_c33150","characterName":"折笠 レイナ","sourceIds":{"bangumi":[{"characterId":"50779","match":"exact-normalized-name-in-linked-work","subjectId":"195299"}],"egsCharacterIds":["6472"],"vndbCharacterId":"c33150"},"originalCharacterName":"折笠 レイナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"17"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"211"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious girl who appears before Kusuhara and Amamiya as they chase the mystery behind Sorano's memories. Contrary to her dainty, appearance, she is cool, intellectual, and possesses a great deal of scientific knowledge. She assists Kusuhara in unraveling the secrets regarding Sorano's memories. But why is this enigma of a woman helping out Kusuhara? Her goals are shrouded in secrecy."}],"source":"vndb","sourceCharacterId":"c33150"},{"segments":[{"spoiler":false,"text":"そらのの記憶の謎を追いかける楠原と雨宮の前に突如現れた少女"},{"spoiler":false,"text":"華奢な見た目とは裏腹に多くの科学的知識を有し聡明かつ冷静に楠原と共にそらのの記憶の謎を解決する手助けをしてくれる"},{"spoiler":false,"text":"正体不明の少女は何故楠原達を助けるのか？"},{"spoiler":false,"text":"その目的は謎に包まれている"}],"source":"egs","sourceCharacterId":"6472","sourceWorkId":"22114","spoiler":false},{"segments":[{"spoiler":false,"text":"そらのの記憶の謎を追いかける、裕樹と翔の前に突如現れた少女。"},{"spoiler":false,"text":"華奢な見た目とは裏腹に、多くの科学的知識を有し"},{"spoiler":false,"text":"聡明かつ冷静に、裕樹と共にそらのの記憶の謎を解決する手助けをしてくれる。"},{"spoiler":false,"text":"正体不明の少女は、何故裕樹達を助けるのか？"},{"spoiler":false,"text":"その目的は謎に包まれている。"}],"source":"bangumi","sourceCharacterId":"50779"}],"profileFacts":[{"label":"年龄（本版本）","value":"17 岁","valueContext":null,"source":"egs","sourceCharacterId":"6472","sourceWorkId":"22114","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"6472","sourceWorkId":"22114","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d05d0