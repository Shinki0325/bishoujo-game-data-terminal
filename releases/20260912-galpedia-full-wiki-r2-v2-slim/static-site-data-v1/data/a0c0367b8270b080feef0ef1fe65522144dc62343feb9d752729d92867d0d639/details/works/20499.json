{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20499","model":{"presentationWorkId":"vndb:v15222","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c63082","characterName":"当山 真尋","sourceIds":{"bangumi":[{"characterId":"30979","match":"exact-normalized-name-in-linked-work","subjectId":"128057"},{"characterId":"30979","match":"exact-normalized-name-in-linked-work","subjectId":"222173"},{"characterId":"88669","match":"exact-normalized-name-in-linked-work","subjectId":"222161"}],"egsCharacterIds":["19282"],"vndbCharacterId":"c63082"},"originalCharacterName":"当山 真尋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"可愛らしい容姿の少女だが、本性はかなり腹黒い上に超利己主義。"},{"spoiler":false,"text":"その容姿を利用して男達を騙している。"},{"spoiler":false,"text":"――義姉と3P妄想"},{"spoiler":false,"text":"違う学園に通う義姉がいる。"},{"spoiler":false,"text":"その義姉が大好きで、自分を含めて3Pがしたいという、変態的願望を抱いている。"}],"source":"egs","sourceCharacterId":"19282","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"『義姉との性交』のヒロイン。"},{"spoiler":false,"text":"可愛らしい仕草で相手につけこむことが得意な二面性を持った少女。"},{"spoiler":false,"text":"義姉のことを愛しており、肉体的にも結ばれたいと強く思っている。"},{"spoiler":false,"text":"そうした行き過ぎた感情が、いつしか義姉と一緒に犯されたい、という危険な願望へと変わっていく。"}],"source":"egs","sourceCharacterId":"19282","sourceWorkId":"9801","spoiler":false},{"segments":[{"spoiler":false,"text":"守ってあげたくなるようなかわいらしい雰囲気を持っている。"},{"spoiler":false,"text":"甘え上手で、他人に強調することが上手い。"},{"spoiler":false,"text":"だが根は腹黒く、聞こえないように毒舌を吐くことで鬱憤を晴らしている。"},{"spoiler":false,"text":"天然系ぶっていると一部の女子からは嫌われているが、ほとんどの人は彼女の味方である。"},{"spoiler":false,"text":"また、彼女自身もそのことをよく知っている。"},{"spoiler":false,"text":"主人公を、オタクでなにもできないのろまなヤツだと思い、嫌っている。"}],"source":"egs","sourceCharacterId":"19282","sourceWorkId":"20499","spoiler":false},{"segments":[{"spoiler":false,"text":"可愛らしい見た目に反して、実はかなり腹黒い。自分の容姿を利用して、男を騙している。"},{"spoiler":false,"text":"家も金持ちのように見えるが、実はとても貧乏。義母の残した借金が原因。 入院中の父親と、別の学園に通う義姉がいる。お金は家族を支えるために稼いでいる。 義姉思いだが、3Pを望む変態的な欲望がある。"}],"source":"bangumi","sourceCharacterId":"30979"},{"segments":[{"spoiler":false,"text":"甘え上手で、守ってあげたくなるようなかわいらしい女の子。"},{"spoiler":false,"text":"だが根は腹黒く、聞こえないように毒舌を吐くことで鬱憤を晴らしている。"},{"spoiler":false,"text":"天然系ぶっていると一部の女子からは嫌われているが、ほとんどの人は彼女の味方。"},{"spoiler":false,"text":"また、彼女自身もそのことをよく知っている。"},{"spoiler":false,"text":"主人公を、オタクで何も出来ないのろまなヤツだと思い嫌っている。"}],"source":"bangumi","sourceCharacterId":"88669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abb40f96e298125bb6a033f8c864e8164d0edf3ba3eeb95cb4c012036650360b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df3e2c933a84090e9f9f3dc1225c29a60a12ab900ae1f625aed2c3f5c6821ae0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222161:88669:15995:1","source":"bangumi"}]},{"characterId":"char_vndb_c111821","characterName":"尾鈴 昭一","sourceIds":{"vndbCharacterId":"c111821"},"originalCharacterName":"尾鈴 昭一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","v