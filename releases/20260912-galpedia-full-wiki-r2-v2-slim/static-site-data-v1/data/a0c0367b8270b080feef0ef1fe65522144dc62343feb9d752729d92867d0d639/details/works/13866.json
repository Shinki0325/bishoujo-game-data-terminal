value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園一年生。"},{"spoiler":false,"text":"性格は真面目だが、気弱。"},{"spoiler":false,"text":"学業成績は良い方で、常に成績は上位で10位辺りをうろちょろしている。"},{"spoiler":false,"text":"最近、胸が大きくなり、痴漢に遭うようになった。"},{"spoiler":false,"text":"性格がら痴漢されても堪えていたが、そろそろ我慢の限界に来ていた。"},{"spoiler":false,"text":"就寝前は欠かさずオナニーをしているオナニーッ娘。そのため、陰唇が肥大気味。"},{"spoiler":false,"text":"主人公を痴漢と間違い、それがもとで酷い目に遭ってしまう。"}],"source":"egs","sourceCharacterId":"11995","sourceWorkId":"13866","spoiler":false},{"segments":[{"spoiler":false,"text":"学園1年生。　成績はいつも上位にいるが10位辺りをうろうろしている。"},{"spoiler":false,"text":"真面目だけど気弱な性格。"},{"spoiler":false,"text":"最近、急に胸が大きくなってきて、そのことを気にしている。"},{"spoiler":false,"text":"胸が大きくなると共に痴漢に遭うようになり、ずっと我慢していたがその執拗さに、我慢の限界が来ていた。"},{"spoiler":false,"text":"オナニーっ娘で、就寝前には欠かさずオナニーをするため陰唇が肥大ぎみ。"},{"spoiler":false,"text":"アンダーヘアは濃い目。"}],"source":"bangumi","sourceCharacterId":"90527"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f9f6d69a53ca35ede157ac158b2e1391e59fac11d1a56eb40faf8b1d16d70b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc94cd6e3e630dacb7956fed93de0d67cb8bbd5b5eb40a0355afca8638a1ae8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267578:90527:6351:1","source":"bangumi"}]},{"characterId":"char_c20890","characterName":"奈雲 優莉亜","sourceIds":{"bangumi":[{"characterId":"90528","match":"exact-normalized-name-in-linked-work","subjectId":"267578"}],"egsCharacterIds":["11996"],"vndbCharacterId":"c20890"},"originalCharacterName":"奈雲 優莉亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"