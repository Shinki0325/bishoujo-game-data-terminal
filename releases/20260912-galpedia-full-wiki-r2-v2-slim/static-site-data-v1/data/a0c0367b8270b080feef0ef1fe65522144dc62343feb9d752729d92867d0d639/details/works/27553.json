null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"138"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Liese is a part of Archlond's royalty and is Julia's younger sister. As she is sickly, she often coops herself up in her own room."},{"spoiler":false,"text":"She is a very kind and caring person, and it is said that her singing voice is very soothing and that all who hear it are healed. Therefore, Liese will sometimes go out in public to sing."},{"spoiler":false,"text":"She often puts up a front of being healthy and energetic to prevent her sister from worrying about her too much, and Liese herself cares deeply for her sister."},{"spoiler":false,"text":"Liese also has her very own fanclub."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c24463"},{"segments":[{"spoiler":false,"text":"アークロンド公国の王族であり、ジュリアの妹。病気がちのため自室に籠もっていることが多い。"},{"spoiler":false,"text":"心優しい性格の持ち主で、彼女の優しい歌声は聞いた者を癒やす力がある。そのため、時折地上に出ては歌を披露している。"},{"spoiler":false,"text":"姉に心配をかけまいと常に気丈に振る舞っており、そんな彼女をジュリアも大切に思っている。地上には、彼女のファンクラブがある。"},{"spoiler":false,"text":"所有タクティカ、『銀翼の旋律（フェリチタ）』。 加護を司る。歌に祈りをのせ、加護の力を付与する。"}],"source":"egs","sourceCharacterId":"4910","sourceWorkId":"20852","spoiler":false},{"segments":[{"spoiler":false,"text":"アークロンド公国の王族であり、ジュリアの妹。"},{"spoiler":false,"text":"病気がちのため自室に籠もっていることが多い。"},{"spoiler":false,"text":"心優しい性格の持ち主で、彼女の優しい歌声は聞いた者を癒やす力がある。 そのため、時折地上に出ては歌を披露している。"},{"spoiler":false,"text":"姉に心配を掛けまいと常に気丈に振る舞っており、そんな彼女をジュリアも大切に思っている。"},{"spoiler":false,"text":"地上には、彼女のファンクラブがある。"},{"spoiler":false,"text":"「ふふっ、大丈夫ですよ姉様。 だってほら、今日はこんなにお日様がぽかぽかしてるんですもの」"},{"spoiler":false,"text":"所有タクティカ：『銀翼の旋律（フェリチタ）』"},{"spoiler":false,"text":"加護を司る。 歌に祈りをのせ、加護の力を付与する。"}],"source":"bangumi","sourceCharacterId":"27707"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"27707","value":"アークロンド公国"},{"label":"種族","source":"bangumi","sourceCharacterId":"27707","value":"竜族（♀）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/258138efbbffa2151094a37b4f39b8bb70d7716239bf87f3df3012fd90a7c9f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b055e93ec8749c7f7221c6ac35f5034177309b90f0a3e2f432594e9c87328a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:323723:27707:10026:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2058","sourceCompanyId":"egs:brand:2058","canonicalEntityId":"egs:brand:2058","name":"DualTail(DualMage)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:27553:2058","source":"egs"},{"companyId":"vndb:p302","sourceCompanyId":"vndb:p302","canonicalEntityId":"vndb:p302","name":"ninetail","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107949:v25392","source":"vndb"},{"companyId":"vndb:p102","sourceCompanyId":"vndb:p102","canonicalEntityId":"vndb:p102","name":"JAST USA","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:124282:v25392","source":"vndb"},{"companyId":"vndb:p102","sourceCompanyId":"vndb:p102","canonicalEntityId":"vndb:p102","name":"JAST USA","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:137115:v25392","source":"vndb"},{"companyI