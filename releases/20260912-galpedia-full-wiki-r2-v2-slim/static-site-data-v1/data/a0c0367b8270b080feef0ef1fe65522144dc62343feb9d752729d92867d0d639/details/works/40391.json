se,"text":"A new cast member."},{"spoiler":false,"text":"She approached Haito, enveloped in despair after being fired from his job, and guided him to Bunny Garden."},{"spoiler":false,"text":"She has an innocent and bright personality, treating everyone with kindness. Her untroubled smile provides comfort to customers. Despite her father's objections, she moved to Tokyo to pursue a certain dream."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c137762"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b27fecc046ee9b80791c1d12c730ed4d29c568c7cd4bcd4114ea8514558cbab4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d411fb8f6b969e4f1037b7b112097abe65930a8d0a7cd03ff35340ad401485ac.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星谷 美緒","creatorId":"vndb:s17075","sourcePersonId":"vndb:s17075","canonicalEntityId":"vndb:s17075","name":"星谷 美緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102288","source":"vndb"}]},{"characterId":"char_vndb_c137763","characterName":"凜","sourceIds":{"vndbCharacterId":"c137763"},"originalCharacterName":"凜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"903"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A free-spirited and friendly staff. She speaks informally to customers from the start. She provokes Haito playfully and enjoys his reactions."},{"spoiler":false,"text":"Despite her appearance, she is actually an anime and manga enthusiast. When she gets drunk, she passionately talks about her favorite anime and manga."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c137763"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2c7acb284b11492c2df77538db46cd9602d051f7eab6c548432b5c97bfa7cca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7157d1882ec7a8ad07e28359c57d017a243dd06dff2ce8fae1d5c75ab96095f5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木 絵理","creatorId":"vndb:s20404","sourcePersonId":"vndb:s20404","canonicalEntityId":"vndb:s20404","name":"鈴木 絵理","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102289","source":"vndb"}]},{"characterId":"char_vndb_c137764","characterName":"美羽香","sourceIds":{"vndbCharacterId":"c137764"},"originalCharacterName":"美羽香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"827"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her blunt words, spoken without filter have left countless customers disheartened. However, no harm is meant—it's just her style!"},{"spoiler":false,"text":"She lives and takes care of her younger sister."},{"spoiler":false,"text":"She has been a cast member longer than the other two."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c137764"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ea7a52d81e98a90be827ff31a5f00133e95ab91e556e4e5b34ef251667d5ba1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f62c6bd450e929a5fc41144c2d2d84a81e2212f5ffd16b49400dadf5a00667d0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田澤 茉純","creatorId":"vndb:s21956","sourcePersonId":"vndb:s21956","canonicalEntityId":"vndb:s21956","name":"田澤 茉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102291","source":"vndb"}]},{"characterId":"char_vndb_c165902","characterName":"英梨紗","sourceIds":{"vndbCharacterId":"c165902"},"originalCharacterName":"英梨紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cast member on her trial period."},{"spoiler":false,"text":"She tends to act aloof, but is actually a very kind and considerate girl with a tsundere personality."},{"spoiler":false,"text":"She has a severe tendency to overthink things, where even the protagonist's casual words or gestures can instantly send her imagination running wild in that direction."},{"spoiler":false,"text":"She may seem strong-willed, but she actually loves imagining romantic scenarios and sometimes gets lost in her own fantasy world."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c165902"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8663c5982b35bae14d78629ca4709001eefd8a06298a37ca2c4714eba7987071.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5405df035949664983659de6c1a47fcdd5b97d0e57cbb8abc3769bf19012d32d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"首藤 志奈","creatorId":"vndb:s20736","sourcePersonId":"vndb:s20736","canonicalEntityId":"vndb:s20736","name":"首藤 志奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102290","source":"vndb"}]},{"characterId":"char_vndb_c165903","characterName":"黒音","sourceIds":{"vndbCharacterId":"c165903"},"originalCharacterName":"黒音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her words and actions are utterly indecipherable at first meeting—mysterious and bewitching, leaving you unsure if she's joking or serious."},{"spoiler":false,"text":"One moment she'll suddenly close the distance, the next she'll drift away, leaving behind cryptic words."},{"spoiler":false,"text":"It's as if she's testing you. That very elusiveness is her charm."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c165903"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42725197d6cbf0f5faa6e6353eb01a105ea5f9d2fd6828c53f9fab1172420ca3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acb11b254805aa9b3d5d81725c4df7b136cc3d2934dadc06b7e0548903835d68.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野口 瑠璃子","creatorId":"vndb:s27004","sourcePersonId":"vndb:s27004","canonicalEntityId":"vndb:s27004","name":"野口 瑠璃子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102292","source":"vndb"}]},{"characterId":"char_vndb_c165904","characterName":"瑠那","sourceIds":{"vndbCharacterId":"c165904"},"originalCharacterName":"瑠那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her distinctive tone and slightly cheeky attitude make her stand out."},{"spoiler":false,"text":"She carries