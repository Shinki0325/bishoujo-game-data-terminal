）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"15150","sourceWorkId":"12624","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"15150","sourceWorkId":"12624","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"15150","sourceWorkId":"12624","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"15150","sourceWorkId":"12624","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6690c735651d953ec8c2b740bc30efe57a064856a6fea8f93333a68dc4fb87e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b73286af63cea27c4987385a5694cea606dcb64800ddbffeafd321be7f8a23d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194237:47008:6019:1","source":"bangumi"}]},{"characterId":"char_c37399","characterName":"桐野 静流","sourceIds":{"bangumi":[{"characterId":"47009","match":"exact-normalized-name-in-linked-work","subjectId":"194237"}],"egsCharacterIds":["15151"],"vndbCharacterId":"c37399"},"originalCharacterName":"桐野 静流","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"99"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桐野家の家長で優斗の叔母。"},{"spoiler":false,"text":"10年前に夫を亡くした未亡人で元教師。"},{"spoiler":false,"text":"今は非常勤で幼稚園の先生をしている。"},{"spoiler":false,"text":"唯一、誰も頭が上がらない存在。綾華ですら逆らえない。"},{"spoiler":false,"text":"直感が鋭いが普段は物腰柔らかくおっとりしている。"},{"spoiler":false,"text":"あまり苦労を苦労とは思わないポジティブ人間。"},{"spoiler":false,"text":"家長だけにシッカリしているが、たまに子供っぽい一面も見せる。"}],"source":"egs","sourceCharacterId":"15151","sourceWorkId":"12624","spoiler":false},{"segments":[{"spoiler":false,"text":"桐野家の家主。元教師で未亡人。"},{"spoiler":false,"text":"家事は主婦らしく最低限やっているが、片付けが好きではない。"},{"spoiler":false,"text":"唯一、誰も頭が上がらない存在。娘達ですら逆らえない。"},{"spoiler":false,"text":"怒ると怖いらしいが、いつもニコニコしていて怒る気配がない。"},{"spoiler":false,"text":"昔から男の子が欲しいと思っていたので、優斗が来てくれて嬉しく思っている。"}],"source":"bangumi","sourceCharacterId":"47009"}],"profileFacts":[{"label":"胸围（本版本）","value":"99 cm","valueContext":null,"source":"egs","sourceCharacterId":"15151","sourceWorkId":"12624","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"15151","sourceWorkId":"12624","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"15151","sourceWorkId":"12624","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"15151","sourceWorkId":"12624","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c49e3aa3c94ebdbd50246aebe93f7f20fa3151e11f7106976af920a542f5b3e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9234313dab511d139dd2bb5ed8f459230a419720d71d7c0f8ca4ce911b3186a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉ゆき","creatorId":"vndb:s839","sourcePersonId":"vndb:s839","canonicalEntityId":"vndb:s839","name":"佐倉 ゆき",