s://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caa91535729fde37c145dc93c795b708a6ee057d36260a52b93c592a75140e40.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155040","characterName":"佐藤 直人","sourceIds":{"vndbCharacterId":"c155040"},"originalCharacterName":"佐藤 直人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c155041","characterName":"桂芳院 絢音","sourceIds":{"vndbCharacterId":"c155041"},"originalCharacterName":"桂芳院 絢音","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c155042","characterName":"正志","sourceIds":{"vndbCharacterId":"c155042"},"originalCharacterName":"正志","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c155043","characterName":"涼木","sourceIds":{"vndbCharacterId":"c155043"},"originalCharacterName":"涼木","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c8340","characterName":"桐谷 優那","sourceIds":{"vndbCharacterId":"c8340"},"originalCharacterName":"桐谷 優那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a quiet, neat, gentle, and good-natured member of the rhythmic gymnastics club. She is a very attentive person and is well-liked by her club mates and classmates. She is an old-fashioned type who wants to devote herself to only one person whom she loves. She does not like to fight, and does not want to win by using someone else or using them as a stepping stone."},{"spoiler":false,"text":"She is very sensitive about her body and feels a strong sense of guilt about it."},{"spoiler":false,"text":"She has a faint yearning for love, but has never experienced it. A popular boy confesses his love for her, but she has no feelings for him and is at a loss for how to respond."},{"spoiler":false,"text":"Her parents died when she was young, and she is a struggling student, but she does not let that bother her. Since she lives alone, she is good at home-style cooking."},{"spoiler":false,"text":"She is attracted to the protagonist after he saves her from a pervert. She confesses her feelings to the protagonist, and unbeknownst to herself, she is about to enter the path of slavery."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c8340"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e66277c6433a12fcdd0bb37de7de021ae28034c12064f25a8243a517ea74aaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c53960ff2d58126458a9d14ebfaa3e3b470f19ee56da5773b58b69ae90d73e15.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"サトウ ユキ","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34766","source":"vndb"}]},{"characterId":"char_vndb_c8341","characterName":"椎名 莉子","sourceIds":{"vndbCharacterId":"c8341"},"originalCharacterName":"椎名 莉子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"source-only","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl with a Lolita-like appearance. She is the only daughter of the principal. She is naive and gives the impression of innocence to those around her. She is always wandering around with a stuffed animal with a blank expression on her face, which suggests that she has matured while still remaining a small child in mind. Although her behavior is outlandish, she is loved by the people around her."},{"spoiler":false,"text":"Her stuffed animal is Minami-chan, a southern red-crested anteater."},{"spoiler":false,"text":"She innocently believes in fortune-telling. She truly believes that one day a prince will appear in front of her."},{"spoiler":false,"text":"She falls in love with the main character at first sight."},{"spoiler":false,"text":"She truly believes that he is her prince and desires to do anything for him. And so, she innocently descends towards being a mare slave."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c8341"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e5679106e0de1101976b968f980018284dce33ae51f7b6e59c9a04b9947ae93.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c21e4f54ebe98ddec105130a872418a47b4b4df1ff2ef1f529a377a4fb7af277.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34767","source":"vndb"}]},{"characterId":"char_vndb_c8342","characterName":"草薙 のばら","sourceIds":{"vndbCharacterId":"c8342"},"originalCharacterName":"草薙 のばら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the daughter of a wealthy family that has existed since the Meiji era."},{"spoiler":false,"text":"Her father is a famous musician. Her mother is the daughter of a noble family. She will eventually succeed her grandfather as the head of the Kusanagi Group, and she is making every effort to become worthy of her position."},{"spoiler":false,"text":"She is secretly proud of her high status and is accustomed to being in a position to use others. Because of this, she tends to unconsciously look down on people of ordinary blood and servants."},{"spoiler":false,"text":"She has a faint crush on a childhood friend of the same age, but her pride gets in the way and she is unable to be honest with him."},{"spoiler":false,"text":"She has a secret complex about her small breasts. She hates dogs. Just looking at them gives her a chill down her spine."},{"spoiler":false,"text":"She is coerced into slavery by the protagonist, who threatens her on the basis of her family's wrongdoings. She is determined not to give in to the hero's cruelty."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c8342"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a404418d0a9de0f2784ad2589287b093d1392f89a3f8664eea7a0f298398f777.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e83c3a061600942acc4d3156126aaad2e60e66aa0c8b91d46ef43018cf5a847e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊木 春乃","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34768","source":"vndb"}]},{"characterId":"char_vndb_c8343","characterName":"鈴木 郁美","sourceIds":{"vndbCharacterId":"c8343"},"originalCharacterName":"鈴木 郁美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"106"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"I"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a new teacher and inexperienced, but her gentle nature makes her popular among students. Her tone of voice is gentle, and she is unable to scold students strongly because of her overly kind nature. She is especially popular among first-year boys. She tends to be timid and shy, and is very concerned about what people think of her. She is also closed-minded to the extent that she is unable to read the main character."},{"spoiler":false,"text":"She has a complex about her feminine body, and chooses to wear clothes that hide her figure. She is quite hairy, which also bothers her. She thinks she has a bad body odor, but in fact it is not that bad."},{"spoiler":false,"text":"Her brother is a murderer, and she keeps it a secret. When the protagonist finds out, he threatens her, and she becomes his slave. She obeys the protagonist because she doesn't want to be exposed as the sister of a murderer."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c8343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/839a44c709e67fdab44841b98851fd08727a1bd13333236c7df4085af426699b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0f7a57889eb3cdc67be477ee75014357d122958cb6c939bc32892964b43c368.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨津 さえ","creatorId":"vndb:s1653","sourcePersonId":"vndb:s1653","canonicalEntityId":"vndb:s1653","name":"雨津 さえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34771","source":"vndb"}]},{"characterId":"char_vndb_c8344","characterName":"椎名 柚紀","sourceIds":{"vndbCharacterId":"c8344"},"originalCharacterName":"椎名 柚紀","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the principal of Tenya Academy. She is Riko's biological mother."},{"spoiler":false,"text":"Her husband, who is a year older than her, was the head of the school, but he disappeared this summer after transferring the rights to the school to an unknown company. She is suspicious of her husband's disappearance and does not trust the main character who has been assigned to her as the school's director."},{"spoiler":false,"text":"In order to find out who is behind her husband's disappearance, she asks Aoi Sakazaki, a janitor, to investigate."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c8344"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6b28fea5f25f43b3d4d2f0465b8632aafa7fb59c673fa6c372382f5920190be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ef39207d8f1f51ee6fe4ad75b89c79a1a64249e90ce8a75ae952003567fec52.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中瀬 ひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34770","source":"vndb"}]},{"characterId":"char_vndb_c8345","characterName":"朔崎 葵","sourceIds":{"vndbCharacterId":"c8345"},"originalCharacterName":"朔崎 葵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She was hired as a janitor at the school a little earlier than the main character and lives in the janitor's office. She is a man-crazy person who loves to drink, hit, and eat (men). She has known the board chairman for a long time."},{"spoiler":false,"text":"She has a feminine body that does not look like a janitor from the outside, and she wears flashy clothes. Although she claims to be a janitor, it is unclear whether she actually does her job. There is a rumor that the school janitor is “poisoning students on their way home from club activities at night,” but no one knows the truth of this rumor."},{"spoiler":false,"text":"Later, the principal asks her to investigate the main protagonist, and she begins to snoop around him."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c8345"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae5fd4a4b0fb20489646a9597c265