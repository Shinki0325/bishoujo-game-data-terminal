ityStatus":"source-native","relationId":"vndb:vn-staff:74958","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c10394","characterName":"芦川 ゆきの","sourceIds":{"vndbCharacterId":"c10394"},"originalCharacterName":"芦川 ゆきの","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful and smart senpai who is considered the school idol and extremely popular to the point of being confessed to very often. However, because Yukino has no interest in love, she turns down every confession. She is happy for the amount of popularity she has, but at the same time she has no idea why everyone likes her so much."},{"spoiler":false,"text":"While Yukino is a student council member, she also secretly helps sometimes at gojoken, but her service there is terrible and awkward. In her previous school, she was part of the same committee Shigeru and shared a bond with him. Because she is helped by Shigure even nowadays, she wants to thank him, so one day, she calls him to the rooftop in order to give him a stapler."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c10394"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81facc74c5b44245020a675cc17a39d6aa1c7052234d8f0cc8d066eef9c29288.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46d7b744cbb75b12c2969773777202a4cc67c40255483a75e7cc32551e77cea0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉 結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42080","source":"vndb"}]},{"characterId":"char_vndb_c10395","characterName":"春日野 三咲","sourceIds":{"vndbCharacterId":"c10395"},"originalCharacterName":"春日野 三咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shigure's classmate who is a popular girl. Her friendly and honest personality gave Misaki the popularity she currently has. When she is embarrassed, she has a habit of flailing her fists around. She also tends to sometimes run away when she's teased, but that's also part of her overall charm."},{"spoiler":false,"text":"Because of her personality and for the fact she is extremely cute, the guys around her think she must have a boyfriend and which is why nobody attempts to confess to her. However, because of that fact, her relationships with her classmates have never become anything deeper or genuine like \"friendship\". She becomes interested in Shigeru after he told her about gojoken, and survived through their tests thanks to the cheat sheets she bought from there."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c10395"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3996cd4184adf3dcf5897ffd4755a48e3f3ca5c8564011b0b1ffae86a3964383.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/400e35f65f6146456428b90d3d3a8800b0b8cae86431e1edbef59df4538f8dca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あじ 秋刀魚","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42079","source":"vndb"}]},{"characterId":"char_vndb_c10396","characterName":"住吉 奈々","sourceIds":{"vndbCharacterId":"c10396"},"originalCharacterName":"住吉 奈々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"source-only","source":"vndb","value":"142"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shigure's childhood friend and the treasurer of gojoken. She is popular with the boys due to her \"cute, tiny and child-like\" appearance, but Nana herself hates being treated like a child, and yearns to be a fine adult. Contrary to her appearance and for the fact she refers to herself in third person, Nana is mature but also very blunt, especially towards Misaki whom she thinks is getting too close with Shigure. She is also bad at cooking."},{"spoiler":false,"text":"Shizuku's best friend and classmate. Due to being childhood friends, Nana has known Shigure for a long time and often hangs out with him, but despite this, they seem more like a brother and sister having fun together rather than a couple."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c10396"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/389aa2c159c32200754fb08bd8837e43b8bf7cfc1117c10c7beb5944ba315d8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/828cc53761ec7162252c235458e66129823fd00b4ae39c272321d453d0f9bcd1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪都 さお梨","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42081","source":"vndb"}]},{"characterId":"char_vndb_c10397","characterName":"御影 しずく","sourceIds":{"vndbCharacterId":"c10397"},"originalCharacterName":"御影 しずく","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nana's best friend and classmate who is a member of the broadcasting committee. She is extremely shy and has even trouble shopping unless Nana is with her. To Shizuku, Nana is \"small but very reliable\", and the two are almost always seen together. Due to her kind personality and beautiful appearance, Shizuku is popular with the boys."},{"spoiler":false,"text":"Shizuku is a bit of a sheltered girl and panics easily. Just in case, she carries around a crime prevention buzzer which she almost always takes out and presses when she is about to have or has a panic attack. When it comes to the topic of love and ideal types, she would want a man who is not only handsome but also has a strong personality."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c10397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/983bf959d15d6c9219a1183a46102ded2cc8fe71279a3212e153731d03e83d7f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97d414894d60c09150af116b1ca4e437b04dada968dc5d33c951e21821528e73.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田 まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42082","source":"vndb"}]},{"characterId":"char_vndb_c49861","characterName":"塚口 麻耶","sourceIds":{"vndbCharacterId":"c49861"},"originalCharacterName":"塚口 麻耶","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73fcde4f76da667788d22eaec3a039748f8a2f731b7f6f7dc41301f2d8e8a30d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/498930d6709c88d1bbb44147d6c31b681d79270a693affd6e55fcc6c753fe269.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 理々","creatorId":"vndb:s1977","sourcePersonId":"vndb:s1977","canonicalEntityId":"vndb:s1977","name":"田中 理々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42085","source":"vndb"}]},{"characterId":"char_vndb_c49862","characterName":"中津 幸太郎","sourceIds":{"vndbCharacterId":"c49862"},"originalCharacterName":"中津 幸太郎","characterNameSource":nul