{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"2791","model":{"presentationWorkId":"vndb:v3539","staff":{"artwork":[{"creditedName":"ナカムラモンド","creatorId":"vndb:s5073","sourcePersonId":"egs:creator:5263","canonicalEntityId":"vndb:s5073","name":"ナカムラモンド","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21118","source":"egs"},{"creditedName":"神凪かるま","creatorId":"egs:creator:2759","sourcePersonId":"egs:creator:2759","canonicalEntityId":"egs:creator:2759","name":"神凪かるま","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:8531","source":"egs"}],"scenario":[{"creditedName":"渡部ばんり","creatorId":"egs:creator:4675","sourcePersonId":"egs:creator:4675","canonicalEntityId":"egs:creator:4675","name":"渡部ばんり","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:17282","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c2111","characterName":"時田 有紀","sourceIds":{"vndbCharacterId":"c2111"},"originalCharacterName":"時田 有紀","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tokita Yuuki (called \"Yuki\" by close friends) applied to Souryou to be reunited with his childhood friend, Mitsui Takumi. Because his family has moved frequently since he was young, Yuuki had a hard time making friends, until he befriended Takumi. To be able to be with him again, Yuuki worked hard to pass the entrance exam into Souryou, and commutes to school everyday. He's a bright and friendly person, who enjoys watching movies (and crying at them when he can get away with it), putting together plastic models, animals, and sweets. He is not tech-savvy at all, which Takumi often finds amusing."},{"spoiler":false,"text":"Voice Actor: Miyata Kouki."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c2111"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e90565465fcf8a484b866a2b576531ff32eb9bd9dbfacfcbbcd470c47cf97b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cefd4b3f75174f0066871a51074e86ffb462e9ed7827bd112f80bd22a71b7f5.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮田 幸季","creatorId":"vndb:s387","sourcePersonId":"vndb:s387","canonicalEntityId":"vndb:s387","name":"宮田 幸季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24065","source":"vndb"}]},{"characterId":"char_vndb_c2112","characterName":"三井　拓美","sourceIds":{"vndbCharacterId":"c2112"},"originalCharacterName":"三井　拓美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mitsui Takumi (affectionally called \"Taku-chan\" by Yuuki) is in the advanced science and mathematics division at Souryou, and he lives on campus in the dorms. His grandfather, father, and older brother are all doctors, so he studies to become a doctor as well. He is very tech-savvy and enjoys online gaming and fancy cell phones. He also enjoys playing tennis, listening to classical music, and has a great appreciation for coffee."},{"spoiler":false,"text":"Voiced by Suzuki Chihiro."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c2112"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b12afd44447bf13c684d4684feae2ce457485943d679a0c2cb0029359f2ab001.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c7ea776c38144fd4037825fd271caca31ea0c1a9e472ed132dab05394fb25d6.webp","width":148,"height":200,"source":"static-detail"},"actors":[{"creditedName":"鈴木 千尋","creatorId":"vndb:s182","sourcePersonId":"vndb:s182","canonicalEntityId":"vndb:s182","name":"鈴木 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24063","source":"vndb"}]},{"characterId":"char_vndb_c2113","characterName":"西塚　音哉","sourceIds":{"vndbCharacterId":"c2113"},"originalCharacterName":"西塚　音哉","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nishizuka Otoya is a senior at Souryou. Hamana Ryuusuke (whom he calls \"Ryuu\") is his childhood friend, and he is called \"Oto\" by him. During summer vacation, he worked at a clubhouse on the beach with Asou Takayasu, and would enjoy playing the fighting game Limit Breaker with him at Trafalgar, the local arcade. During his time working on the beach, he also encountered a boy who was trying to commit suicide, Serizawa Shiki, and saved him. At the start of the school year, he is reunited with Shiki, who has transfered to Souryou. He is an over-all nice guy, and has many friends. He lives with his parents and younger sister, Haruna, and commutes to school. He enjoys reading manga (particularly from the publication \"Weekly Comic Seiron\"), shooting hoops, and playing Limit Breaker in his free time, and his weak point is academics."},{"spoiler":false,"text":"Voiced by Yoshino Hiroyuki."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c2113"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bbdd9f992de7177477acee0fe016d4efb9a26a515c88343ff4446960d99f41e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f3cc635cf696dfb6ce9cd8543c67c83bd4c82608286599b27a1d8ebf485fa3b.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉野 裕行","creatorId":"vndb:s241","sourcePersonId":"vndb:s241","canonicalEntityId":"vndb:s241","name":"吉野 裕行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24064","source":"vndb"}]},{"characterId":"char_vndb_c2114","characterName":"麻生　隆康","sourceIds":{"vndbCharacterId":"c2114"},"originalCharacterName":"麻生　隆康","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Asou Takayasu transfers to Souryou from Kansai (and naturally, speaks with a Kansai dialect), and stays in the dorms. He is a very energetic person, but also very jealous and selfish. He worked with Otoya at a beach clubhouse during the summer, and would go to play the fighting game \"Limit Breaker\" with him at the local arcade Trafalgar. There he met \"DJ RYU\", the player with scores he could never beat, and he drives him out of the arcade. Upon entering Souryou, Takayasu finds that \"DJ RYU\" is Hamana Ryuusuke, Otoya's friend. He likes going to the movies and playing games at the arcade as well as online games. He also loves cats, and has a pet cat named Cube whom he adores (he even uses \"CUBE\" as his arcade score input name), but he was unable to bring Cube with him since the dormitory does not allow pets."},{"spoiler":false,"text":"Voiced by Suyama Akio."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c2114"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3dce2253f20950a73d6e38c6ac444c334afb336e6dc05be86139c7cd58880314.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be18433b920497c679911aa03c6e9afa7b44f1e1d4112a050ee6288da77bad9e.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"陶山 章央","creatorId":"vndb:s1640","sourcePersonId":"vndb:s1640","canonicalEntityId":"vndb:s1640","name":"陶山章央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24066","source":"vndb"}]},{"characterId":"char_vndb_c2115","characterName":"芹沢　識","sourceIds":{"vndbCharacterId":"c2115"},"originalCharacterName":"芹沢　識","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Serizawa Shiki is a first-time student at Souryou, entering the school after a rough summer vacation in which he tried to commit suicide, but was stopped by Otoya. They reunite at school, but Shiki does not remember him from that time. He is very introverted and passive due to family problems, and because of his introverted character he is the object of bullying at school. He loves to read, and will read books on any subject, making his reading choices very random. He also loves tropical fish, but because he is not allowed to keep a fishtank at home, he frequently goes to the fish shop to watch the fish."},{"spoiler":false,"text":"Voiced by Sakurai Takahiro."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c2115"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f571344c54ee719ffa5e32a03a235b94083a6259e8632eb099bf5bdbac5fba1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6183c45e081ea01f88a40dbd8033ae1d73bd12792114e02376561e3f3734fe0.webp","width":164,"height":200,"source":"static-detail"},"actors":[{"creditedName":"櫻井 孝宏","creatorId":"vndb:s50","sourcePersonId":"vndb:s50","canonicalEntityId":"vndb:s50","name":"櫻井 孝宏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24061","source":"vndb"}]},{"characterId":"char_vndb_c2140","characterName":"浜名 龍介","sourceIds":{"vndbCharacterId":"c2140"},"originalCharacterName":"浜名 龍介","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hamana Ryuusuke is a senior at Souryou and in the same class with Otoya, his childhood friend. His parents are divorced, and he lives with his mother and younger brothers, and since they could not afford to send him to the school, he qualified to attend on a scholarship. He is in the broadcasting department at school, and he loves DJing and is persuing becoming a pro DJ. He also loves playing video games, such as \"Limit Breaker 3\" where he holds the top scores, and music games. He is a very hardworking individual who balances many responsibilities while continuing to be friendly to those around him."},{"spoiler":false,"text":"Voiced by Morikawa Toshiyuki."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c2140"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0f83eea4e467c669bd577f5e8ee4b0e3a7c0a3da9c108d90937c9f9df7649a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9812ad2b1c2b4920fa1bd213f6745d8804e7a1608434bffc327ba5a69ef67243.webp","width":156,"height":200,"source":"static-detail"},"actors":[{"creditedName":"森川 智之","creatorId":"vndb:s53","sourcePersonId":"vndb:s53","canonicalEntityId":"vndb:s53","name":"森川智之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24062","source":"vndb"}]},{"characterId":"char_vndb_c2141","characterName":"石渡 薫","sourceIds":{"vndbCharacterId":"c2141"},"originalCharacterName":"石渡 薫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ishiwata Kaoru is also a member of the advanced science and mathematics division at Souryou, and is Takumi's classmate. They have been going to Souryou together for many years and are good friends, and they often play tennis with each other. He is a very cheerful and sociable person, and is good at a variety of things. He likes playing internet games and dancing games, and also considers himself fashionable."},{"spoiler":false,"text":"Voiced by Umezu Hideyuki."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c2141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ac9006efbb6fa7eededbca89b2bb94ff964201c3a5c9eb88d8f297740fe3ae3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40acda5feb9152e350a6a54db59afb8c38aad6147090d759c99cd4f666001c50.webp","width":153,"height":200,"source":"static-detail"},"actors":[{"creditedName":"梅津 秀行","creatorId":"vndb:s8198","sourcePersonId":"vndb:s8198","canonicalEntityId":"vndb:s8198","name":"梅津 秀行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24067","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1132","sourceCompanyId":"egs:brand:952","canonicalEntityId":"vndb:p1132","name":"Katze","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:2791:952","source":"egs"},{"companyId":"vndb:p1132","sourceCompanyId":"vndb:p1132","canonicalEntityId":"vndb:p1132","name":"Katze","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:8092:v3539","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
