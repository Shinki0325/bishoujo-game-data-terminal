ourceCharacterId":"26436","sourceWorkId":"6109","spoiler":false},{"segments":[{"spoiler":false,"text":"経理部の天然娘"},{"spoiler":false,"text":"経理課に所属するドジなＯＬ。本人は一生懸命なのだが、日常的にミスをするため、あまり信頼はされていない。コロコロ変わる表情が愛嬌の、経理部内のマスコット的存在。同じ経理部の部長である麗奈に気に入られ、女同士の性の悦びを教え込まれ、彼女を「お姉さま」と"},{"spoiler":false,"text":"慕っている。"},{"spoiler":false,"text":"なかなか隙を見せない氷川部長を攻略するための足がかりとして、主人公の甘言・策略にはまり、「人間玩具」として調教を施されていく。"}],"source":"bangumi","sourceCharacterId":"148999"}],"profileFacts":[{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"26436","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"26436","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"26436","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"26436","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"26436","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"26436","sourceWorkId":"6109","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbffdc906a4a05ebd78255cd0c08b5b8b1cb2a8fd5fce73e93b496f2b816a09d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26065a1ad3bccb5ffd5dbe83e53c928db29bc2b076333760b2a04a1e177e1a38.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relation