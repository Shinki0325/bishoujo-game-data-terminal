},{"label":"罩杯（本版本）","value":"j","valueContext":null,"source":"egs","sourceCharacterId":"26437","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"26437","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"26437","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"26437","sourceWorkId":"6109","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0ce3ca7228fda91fd5b8fd7c9aeeefccc75dffebf0073c7e6c3b5c547090370c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d08c42b224af7dd6ff30ca993b257631cd525b6200dff4994a60a76bf27c6df8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230375:149000:4956:1","source":"bangumi"}]},{"characterId":"char_c45255","characterName":"柳原　梓","sourceIds":{"bangumi":[{"characterId":"149001","match":"exact-normalized-name-in-linked-work","subjectId":"230375"}],"egsCharacterIds":["26438"],"vndbCharacterId":"c45255"},"originalCharacterName":"柳原　梓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「ミサカコーポレーション」の社長室付き秘書。"},{"spoiler":false,"text":"スケジュール管理だけでなく、実務もこなす有能な女性。"},{"spoiler":false,"text":"オトコを見る目は厳しく、情けないオトコには容赦がない。"},{"spoiler":false,"text":"秘書という仕事柄、会社の裏で行なわれている事業にも勘付き始めているようだが……。"}],"source":"egs","sourceCharacterId":"26438","sourceWorkId":"6109","spoiler":false},{"segments":[{"spoiler":false,"text":"煌びやかな社長秘書"},{"spoiler":false,"text":"ミサカコーポレーションの社長室付きの秘書。スケジュール管理だけではなく、実務もこなす有能な女性。社長や副社長である主人公には温和に接するが、男を見る眼は厳しく、情けない男には容赦なく辛辣な物言いをする。秘書という立場柄、会社の裏社会との癒着に関して勘づき始め、証拠資料をもとに別会社に取り入ろうとする機会を狙っている。しかし、その現場を主人公に抑えられ、肉奴隷の一人として貶められる事を強要されていく。"}],"source":"bangumi","sourceCharacterId":"149001"}],"profileFacts":[{"label":"年龄（本版本）","value":"25 岁","valueContext":null,"source":"egs","sourceCharacterId":"26438","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"26438","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"26438","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"26438","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"26438","sourceWorkId":"6109","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"26438","sourceWorkId":"6109","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2ca8c515de1690c22016cd71b7ff8d0a396a73c4dfca89cca172af7456721eb.webp","fallbackUrl":"https://wiki-asse