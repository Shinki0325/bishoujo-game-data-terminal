value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"年齢＝彼氏いない歴な年下好きなお姉さんで、公安９９課偽書調査室所属の調査員。"},{"spoiler":false,"text":"任務として礼一の担任になり、礼一を狙う。ついでに、年下の子との結婚を夢見る。"},{"spoiler":false,"text":"そんな軽い気持ちで礼一に接近するが、礼一に逃げられ、自分の魅力のなさに凹む毎日。"},{"spoiler":false,"text":"虚勢を張るが、その内面は非常に傷つきやすいナイーブな女性。"},{"spoiler":false,"text":"「寿退社って、キャリアウーマンの夢だと思わない？」"}],"source":"egs","sourceCharacterId":"14453","sourceWorkId":"13016","spoiler":false},{"segments":[{"spoiler":false,"text":"ざっくばらんで適当な年下好きなお姉さん系担任教師。"},{"spoiler":false,"text":"だがその正体は公安99課偽書調査室所属の調査員。"},{"spoiler":false,"text":"しかして実は年齢（25）＝彼氏いない歴な寿退社を夢見る"},{"spoiler":false,"text":"乙女（四捨五入で三十路）"},{"spoiler":false,"text":"「……ううぅ、美人女教師って捨てがたいジャンルだと思うのに」"}],"source":"bangumi","sourceCharacterId":"55063"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"14453","sourceWorkId":"13016","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"14453","sourceWorkId":"13016","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"14453","sourceWorkId":"13016","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"14453","sourceWorkId":"13016","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"14453","sourceWorkId":"13016","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/427276d0927b33854181a7373b521175d32a36b1ae6afef67822ccd9a1af1