oiler":false},{"segments":[{"spoiler":false,"text":"好き：流行りを身に着け周りから称賛されること。新しい化粧を試すこと。"},{"spoiler":false,"text":"嫌い：おしゃれに全く気を使わない人。不健康自慢をする人"},{"spoiler":false,"text":"お洒落や流行に敏感な女子大生。"},{"spoiler":false,"text":"合コンなどには行くものの、一方で大学の単位を取る、アルバイトも責任を持ってこなす、という常識的な一面を持つ。"},{"spoiler":false,"text":"明るい性格ゆえに男女共に友達が多く、兄の遊真とも仲がいい。"},{"spoiler":false,"text":"兄とは血の繋がりがなかったら付き合ってもよかったかな、と思っている。"},{"spoiler":false,"text":"外資系の仕事をする彼氏がいてかなり羽振りがいいことから付き合っている。"},{"spoiler":false,"text":"だが、セックス関しては彼氏が恵那の妊娠を恐れるために、本番はしていない。"},{"spoiler":false,"text":"そのため彼氏が浮気もしくは、本命の彼女がいるのではないかと疑っており、解消されない性欲を持て余した毎日を悶々と過ごしている。"},{"spoiler":false,"text":"「お兄ちゃんさー、ちょっとばかり誤解してない？面識もへったくれもない男女が告白から付き合うと思ってるの？普段から仲がいい男女が、告白して恋人になるんだってば」"}],"source":"bangumi","sourceCharacterId":"144214"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"21971","sourceWorkId":"28132","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"21971","sourceWorkId":"28132","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"21971","sourceWorkId":"28132","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"21971","sourceWorkId":"28132","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"21971","sourceWorkId":"28132","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa1c9c1b7000d1656048f7711f093abe3d174670a398cdb7b5c8f96a6e61cd58.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d25aedbed83dbe45e24b0ec15ee1c403ee400c981dfc8bc94d8743f5e88e047b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"叶一華","creatorId":