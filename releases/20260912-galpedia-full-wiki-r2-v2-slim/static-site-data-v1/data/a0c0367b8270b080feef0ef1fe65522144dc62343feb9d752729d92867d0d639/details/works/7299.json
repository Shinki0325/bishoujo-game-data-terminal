{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7299","model":{"presentationWorkId":"vndb:v1584","staff":{"artwork":[{"creditedName":"坂下吹雪(さかしたふぶき、A-DAT)","creatorId":"vndb:s1955","sourcePersonId":"egs:creator:1998","canonicalEntityId":"vndb:s1955","name":"坂下吹雪(さかしたふぶき、A-DAT)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14869","source":"egs"}],"scenario":[{"creditedName":"慈恩 大","creatorId":"vndb:s2477","sourcePersonId":"vndb:s2477","canonicalEntityId":"vndb:s2477","name":"慈恩 大","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:26443","source":"vndb"},{"creditedName":"ピーナツ 太郎","creatorId":"vndb:s2478","sourcePersonId":"vndb:s2478","canonicalEntityId":"vndb:s2478","name":"ピーナツ 太郎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:26444","source":"vndb"}],"music":[{"creditedName":"谷上純三(CUBE)","creatorId":"egs:creator:3706","sourcePersonId":"egs:creator:3706","canonicalEntityId":"egs:creator:3706","name":"谷上純三(CUBE)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:17355","source":"egs"},{"creditedName":"株式会社キューブ","creatorId":"vndb:s2651","sourcePersonId":"vndb:s2651","canonicalEntityId":"vndb:s2651","name":"CUBE(株式会社キューブ)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:26445","source":"vndb"},{"creditedName":"谷上 純三","creatorId":"vndb:s3956","sourcePersonId":"vndb:s3956","canonicalEntityId":"vndb:s3956","name":"谷上 純三","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:26447","source":"vndb"}],"other":[{"creditedName":"金田 めい","creatorId":"vndb:s2331","sourcePersonId":"vndb:s2331","canonicalEntityId":"vndb:s2331","name":"小橋 知子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:26442","source":"vndb"},{"creditedName":"株式会社キューブ","creatorId":"vndb:s2651","sourcePersonId":"vndb:s2651","canonicalEntityId":"vndb:s2651","name":"CUBE(株式会社キューブ)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26446","source":"vndb"},{"creditedName":"くるぶし","creatorId":"vndb:s10570","sourcePersonId":"vndb:s10570","canonicalEntityId":"vndb:s10570","name":"くるぶし","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:26449","source":"vndb"},{"creditedName":"くるぶし","creatorId":"vndb:s10570","sourcePersonId":"vndb:s10570","canonicalEntityId":"vndb:s10570","name":"くるぶし","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26450","source":"vndb"},{"creditedName":"にくきゅう","creatorId":"vndb:s32381","sourcePersonId":"vndb:s32381","canonicalEntityId":"vndb:s32381","name":"にくきゅう","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26451","source":"vndb"}]},"cast":[{"characterId":"char_c54798","characterName":"シャルロット","sourceIds":{"bangumi":[{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218144"},{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25471"],"vndbCharacterId":"c54798"},"originalCharacterName":"シャルロット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"武力に秀でた国の姫君。"},{"spoiler":false,"text":"姫将軍と謳われる誇り高き戦士の彼女は国民的な英雄であり、その名声は他国にも轟いている。"},{"spoiler":false,"text":"主人公とは面識はなく、また主人公の性格や態度にも、あからさまな不快感を示す。"},{"spoiler":false,"text":"それは彼女自身が、何も知らされないままこの国に連れて来られ、いきなり主人公の妃候補に祭り上げられたことへの怒りを持っているからだ。"},{"spoiler":false,"text":"また主人公とは正反対の性格の許婚もおり、怒りの治まらない彼女は、さっさと国へ戻り、兵をあげて主人公の国へ攻め込むつもりでいるようだ。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"シリーズ最初の『いじってプリンセス』で初登場したプリンセス。"},{"spoiler":false,"text":"以降のシリーズでもその誇り高き姿は健在だが、現在はそのトレードマークである甲冑を脱ぎ捨て主人公の妻として、甘い生活をおくっている。"},{"spoiler":false,"text":"それでもこれまでと変わらず、日々の鍛錬を怠ることなく、主人公の国の軍事力強化にも大いに貢献している。"},{"spoiler":false,"text":"しかし、元許婚の陰謀に巻き込まれてしまい……。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"7299","spoiler":false},{"segments":[{"spoiler":false,"text":"武力の国・ガルランディアの出身の誇り高き姫将軍。"},{"spoiler":false,"text":"最初こそ主人公を毛嫌いしていたが、その心根に触れ、主人公を愛するようになる。"},{"spoiler":false,"text":"現在は、主人公との妻として城で甘い生活を送っているが、日々の鍛錬は怠らず、その剣術の腕前はまったく衰えていない。"},{"spoiler":false,"text":"また彼女が、この国の軍事力強化に大いに貢献していることは間違いなく、兵士たちの錬度は著しく向上している。"},{"spoiler":false,"text":"各国にその名を轟かせる武勇の彼女は、近接攻撃においては無類の強さを発揮し、欠点も少なく、戦場においては最も頼りになる存在。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"武力の国で名を馳せた姫将軍。国民的英雄で他国にもその名声は高い。"},{"spoiler":false,"text":"主人公とは面識はないが、主人公の性格や態度が大嫌い。主人公とまったく正反対の許婚がいる。"},{"spoiler":false,"text":"ある意味だまされて来ているので、この国を憎んでいる。国に帰ったらすぐに攻め込む気でいる。誇り高い戦士。"}],"source":"bangumi","sourceCharacterId":"136635"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f470cdd3ce92707f6ca8d5d52a6dade2177f5c2179e58a4f20aa8d6ec2da4be6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12439b7bbacac27ac770d19d3f23f753ce7084ecbce4df5266fe9e5acfed226d.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小橋知子","creatorId":"vndb:s2331","sourcePersonId":"vndb:s2331","canonicalEntityId":"vndb:s2331","name":"小橋 知子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218144:136635:5224:1","source":"bangumi"}]},{"characterId":"char_c79728","characterName":"ブリジット","sourceIds":{"bangumi":[{"characterId":"136721","match":"exact-normalized-name-in-linked-work","subjectId":"218144"}],"egsCharacterIds":["25732"],"vndbCharacterId":"c79728"},"originalCharacterName":"ブリジット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妻・シャルロットの妹。アレットは双子の妹。"},{"spoiler":false,"text":"知的でおしとやかだが、社交的で王女である気品も感じさせる。"},{"spoiler":false,"text":"姉の元許婚であるエルゾーグの冷淡さをかねてから見抜いていた鋭い観察眼を持ちながら、天然ボケなところも。"},{"spoiler":false,"text":"臆病と思えるくらいに慎重な彼女だが、一度決心するとどこまで意志を貫く強さを持つ。"}],"source":"egs","sourceCharacterId":"25732","sourceWorkId":"7299","spoiler":false},{"segments":[{"spoiler":false,"text":"シャルロットの国の王女であり、王宮衛士長。シャルロットの妹で、双子の姉。知的でおしとやかで社交的な性格で、お嬢さま風にしゃべる。"},{"spoiler":false,"text":"臆病に見えるくらいに慎重だが、一度決心するとどこまでも意志を貫くタイプ。持ち前のパワーで知らず知らずにやりすぎてしまって、周囲をビビらせてしまったりする。"},{"spoiler":false,"text":"双子の会話ではボケ担当。"}],"source":"bangumi","sourceCharacterId":"136721"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f0d54fef070ba21b4fdb167f0c5407724065489f884f874e8306259ebff97f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b778fed2ffed345a7f0eb8e126467abe7abbbfe27cf8b9c391a0d3106321bf75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲良さく","creatorId":"vndb:s7809","sourcePersonId":"vndb:s7809","canonicalEntityId":"vndb:s7809","name":"咲良 さく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218144:136721:92705:1","source":"bangumi"}]},{"characterId":"char_c79729","characterName":"アレット","sourceIds":{"bangumi":[{"characterId":"136722","match":"exact-normalized-name-in-linked-work","subjectId":"218144"}],"egsCharacterIds":["25733"],"vndbCharacterId":"c79729"},"originalCharacterName":"アレット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妻・シャルロットの妹。ブリジットは双子の姉。"},{"spoiler":false,"text":"双子の姉・ブリジットとは対照的に楽観的でアグレッシブな元気娘。"},{"spoiler":false,"text":"考えなしに突っ込んでしまう、やや軽率なところも。"},{"spoiler":false,"text":"時折、お酒に付き合ってくれる姉の元許婚・エルゾーグに好感を抱いていたが、悪人であることを知って、非常にがっかりしている。"}],"source":"egs","sourceCharacterId":"25733","sourceWorkId":"7299","spoiler":false},{"segments":[{"spoiler":false,"text":"シャルロットの国の王女であり、王宮衛士副長。シャルロットの妹で、双子の妹。"},{"spoiler":false,"text":"楽観的で元気な性格。双子の会話ではツッコミ担当。"}],"source":"bangumi","sourceCharacterId":"136722"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f9f5e7525e551635ae392a7f501417984327831071e1fe3d67a048de661b8b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03d800d99affb366cee68dd39929a69c7bf71ff3aa3d4fcf7f0bfed82d22c798.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田依子","creatorId":"vndb:s797","sourcePersonId":"vndb:s797","canonicalEntityId":"vndb:s797","name":"永田 依子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218144:136722:5104:1","source":"bangumi"}]},{"characterId":"char_vndb_c79731","characterName":"イヴァン・ド・エルゾーグ","sourceIds":{"vndbCharacterId":"c79731"},"originalCharacterName":"イヴァン・ド・エルゾーグ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandid