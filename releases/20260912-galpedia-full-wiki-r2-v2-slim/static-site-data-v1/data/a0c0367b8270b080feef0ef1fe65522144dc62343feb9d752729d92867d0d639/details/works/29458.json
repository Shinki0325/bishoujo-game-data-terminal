{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29458","model":{"presentationWorkId":"vndb:v49224","staff":{"artwork":[{"creditedName":"marui","creatorId":"vndb:s808","sourcePersonId":"egs:creator:13428","canonicalEntityId":"vndb:s808","name":"marui","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:219280","source":"egs"}],"scenario":[{"creditedName":"風間ぼなんざ","creatorId":"vndb:s1131","sourcePersonId":"egs:creator:3864","canonicalEntityId":"vndb:s1131","name":"風間ぼなんざ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:219281","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c10367","characterName":"美萩野 綾乃","sourceIds":{"bangumi":[{"characterId":"26027","match":"exact-normalized-name-in-linked-work","subjectId":"46870"}],"egsCharacterIds":["5179"],"vndbCharacterId":"c10367"},"originalCharacterName":"美萩野 綾乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Third-year high school student. At the beginning of the story, she is saved by Haruto during a car accident, and because of that, she goes full deredere mode on him afterwards. In order to repay Haruto, she looked after him during his hospitalization. Because she is a sheltered girl, she doesn't understand much about relationships with boys, and is bad at communicating with them. After Haruto gets discharged from the hospital, she moves in with him as his caretaker."}],"source":"vndb","sourceCharacterId":"c10367"},{"segments":[{"spoiler":false,"text":"知徳学院3年生"},{"spoiler":false,"text":"事故に遭いかけたところを主人公に助けられ、恩返しと面倒を見るために主人公が住む部屋へとやってくる。"},{"spoiler":false,"text":"家事全般得意で、特に料理は上手。"},{"spoiler":false,"text":"主人公の好みに健気に合わせようとするところがあり、隣の部屋に住んでいる「恋愛の大先輩」だと思っている簾に色々と話を聞いたり、ネットでいろいろ調べて偏った知識でご奉仕することも。"},{"spoiler":false,"text":"いい家系のお嬢様のためか、男女関係や、生活習慣など世間とずれているところがあるが、妹の小乃花に対してだけははっきりと分かりやすい形でヤキモチを焼く。"},{"spoiler":false,"text":"「……は、遥人さんの、お隣で……眠らせて、いただきました……」"}],"source":"egs","sourceCharacterId":"5179","sourceWorkId":"17485","spoiler":false},{"segments":[{"spoiler":false,"text":"知徳学院3年生"},{"spoiler":false,"text":"事故に遭いかけたところを主人公に助けられ、"},{"spoiler":false,"text":"恩返しと面倒を見るために主人公が住む部屋へとやってくる。"},{"spoiler":false,"text":"家事全般得意で、特に料理は上手。"},{"spoiler":false,"text":"主人公の好みに健気に合わせようとするところがあり、"},{"spoiler":false,"text":"隣の部屋に住んでいる「恋愛の大先輩」だと思っている簾に色々と話を聞いたり、"},{"spoiler":false,"text":"ネットでいろいろ調べて偏った知識でご奉仕することも。"},{"spoiler":false,"text":"いい家系のお嬢様のためか、男女関係や、生活習慣など世間とずれているところがあるが、"},{"spoiler":false,"text":"妹の小乃花に対してだけははっきりと分かりやすい形でヤキモチを焼く。"}],"source":"egs","sourceCharacterId":"5179","sourceWorkId":"25106","spoiler":false},{"segments":[{"spoiler":false,"text":"知徳学院3年生。"},{"spoiler":false,"text":"事故に遭いかけたところを主人公に助けられ、恩返しと怪我の面倒を見るために部屋へとやってくる。"},{"spoiler":false,"text":"お嬢様なためか男女の関係にうとく、少しズレていたり、生活習慣が世間の常識とやや違うところがある。"},{"spoiler":false,"text":"「遥人さんのお世話を、させていただきたいんです」"}],"source":"bangumi","sourceCharacterId":"26027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc936179672511583082404a8faa6b1b09ad0d159780ad08b21373f4074e2c3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56fbdd28fff7c5c6ade5eb51212daeeffa00210602e24bcc884383a32475da34.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"credi