{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"31270","model":{"presentationWorkId":"vndb:v31570","staff":{"artwork":[{"creditedName":"YU-TA","creatorId":"vndb:s5365","sourcePersonId":"egs:creator:15073","canonicalEntityId":"vndb:s5365","name":"YU-TA","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236279","source":"egs"}],"scenario":[{"creditedName":"えじむら","creatorId":"vndb:s4136","sourcePersonId":"egs:creator:19095","canonicalEntityId":"vndb:s4136","name":"えじむら","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236278","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c98589","characterName":"エロース＝ストローベル","sourceIds":{"bangumi":[{"characterId":"102369","match":"exact-normalized-name-in-linked-work","subjectId":"354611"}],"egsCharacterIds":["23635"],"vndbCharacterId":"c98589"},"originalCharacterName":"エロース＝ストローベル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wizard student from distinguished family. She is proud of her family reputation but the truth is she can't use magic at all. She treats the protagonist crudely but relies on him at the same time as he is her salvation from this hopeless situation."},{"spoiler":false,"text":"Magic type: Wind"}],"source":"vndb","sourceCharacterId":"c98589"},{"segments":[{"spoiler":false,"text":"由緒正しい魔術師の血筋、ストローベル家の娘。魔法学園には主席で入学したものの、魔法が使えないことがわかってからは『落ちこぼれ』と揶揄されることに。"},{"spoiler":false,"text":"結果、学園では人付き合いを避け、友達にはずけずけと物を言う内弁慶になってしまった。"},{"spoiler":false,"text":"ヒロのことは『使い魔』として認識しているのか、基本的には上から目線。"},{"spoiler":false,"text":"あくまで『魔法を使えない』というだけで、魔法学については博識。"},{"spoiler":false,"text":"毎日、夜の10時以降は『儀式の時間』らしく、自室に籠り出てこなくなってしまう。"}],"source":"egs","sourceCharacterId":"23635","sourceWorkId":"31270","spoiler":false},{"segments":[{"spoiler":false,"text":"立てばポンコツ、座ればオナニー。"},{"spoiler":false,"text":"魔法が使えないムッツリスケベな魔法使い。"},{"spoiler":false,"text":"血统纯正的魔术师，"},{"spoiler":false,"text":"ストローベル家的女儿。"},{"spoiler":false,"text":"虽然以首席的身份进入了魔法学园，"},{"spoiler":false,"text":"但是在获悉自己不会使用魔法之后，"},{"spoiler":false,"text":"被调侃为“差生”。"},{"spoiler":false,"text":"结果就是，在学校里，她变成了一个回避社交、"},{"spoiler":false,"text":"对朋友张口就来的“内弁慶（窝里横）”。"},{"spoiler":false,"text":"大概把男主认成了“使魔”，"},{"spoiler":false,"text":"基本上是用对待仆人的态度对待他。其实她只是“不会使用魔法”，"},{"spoiler":false,"text":"理论知识还是很丰富的。"},{"spoiler":false,"text":"好像把每天晚上10点以后当作是“仪式的时间”，"},{"spoiler":false,"text":"会把自己关在房间不出来。"},{"spoiler":false,"text":"「当然ではないですか。"},{"spoiler":false,"text":"あなたはわたしの魔法で召喚されたのですから。」"}],"source":"bangumi","sourceCharacterId":"102369"}],"profileFacts":[{"label":"喜欢","source":"bangumi","sourceCharacterId":"102369","value":"阅读，红茶"},{"label":"种族","source":"bangumi","sourceCharacterId":"102369","value":"人族"},{"label":"讨厌","source":"bangumi","sourceCharacterId":"102369","value":"别人的视线"},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"23635","sourceWorkId":"31270","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"23635","sourceWorkId":"31270","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"23635","sourceWorkId":"31270","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"23635","sourceWorkId":"31270","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6d50f27c74675cd8f48dd65f83aed2d0ef349e896953c71110878dbd6e5f9fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fdfe0299e1e4b6fcf89583d3456d6c990455eb8bf790e28fef9a9d0b90873f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平野有紗","creatorId":"vndb:s4474","sourcePersonId":"vndb:s4474","canonicalEntityId":"vndb:s4474","name":"平野 有紗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:354611:102369:30292:1","source":"bangumi"}]},{"characterId":"char_vndb_c99117","characterName":"メリュジーヌ＝ドラゴネット","sourceIds":{"vndbCharacterId":"c99117"},"originalCharacterName":"メリュジーヌ＝ドラゴネット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"96"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Classmate and roommate of Eros. Since she is from Dragon tribe, she can breathe fire as it's normal for her kind. However, she can't control the power and it causes troubles for surrounding so she also belongs to \"Soundless Club\"."},{"spoiler":false,"text":"Magic type: Fire"}],"source":"vndb","sourceCharacterId":"c99117"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04a5972e1399bd8b9700991fda1e8fbe0aefa0e06ce8b104872f8dcada4ceb0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5470f156093219a0eeda91a3dc1e3544fa1eaecabd303457538bfe510c2bd3f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雲雀 ゆい","creatorId":"vndb:s20887","sourcePersonId":"vndb:s20887","canonicalEntityId":"vndb:s20887","name":"雲雀ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:88409","source":"vndb"}]},{"characterId":"char_vndb_c99706","characterName":"三崎 ヒロ","sourceIds":{"vndbCharacterId":"c99706"},"originalCharacterName":"三崎 ヒロ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As normal and average student in original world, he always wonders why he got summoned to the new world as Hero. He appeared in front of Eros when she was trying summoning magic so he gets treated as her familiar after that."},{"spoiler":false,"text":"After knowing Eros and her friends can only use magic by holding hand with him, he decides to support them while looking for the meaning of his own existence in this world."}],"source":"vndb","sourceCharacterId":"c99706"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p6544","sourceCompanyId":"egs:brand:5195","canonicalEntityId":"vndb:p6544","name":"Casket","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31270:5195","source":"egs"},{"companyId":"vndb:p6544","sourceCompanyId":"vndb:p6544","canonicalEntityId":"vndb:p6544","name":"Casket","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:90700:v31570","source":"vndb"},{"companyId":"vndb:p6544","sourceCompanyId":"vndb:p6544","canonicalEntityId":"vndb:p6544","name":"Casket","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-p