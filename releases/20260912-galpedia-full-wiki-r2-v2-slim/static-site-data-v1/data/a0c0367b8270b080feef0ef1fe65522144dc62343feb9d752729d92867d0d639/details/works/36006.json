EntityId":"egs:creator:36070","name":"鳴神","detail":"システム管理、演出システム素材加工","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:304907","source":"egs"},{"creditedName":"衣笠湧作","creatorId":"egs:creator:36072","sourcePersonId":"egs:creator:36072","canonicalEntityId":"egs:creator:36072","name":"衣笠湧作","detail":"演出スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:304908","source":"egs"},{"creditedName":"天海 向日葵","creatorId":"vndb:s11945","sourcePersonId":"vndb:s11945","canonicalEntityId":"vndb:s11945","name":"天海 向日葵","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:200838","source":"vndb"}]},"cast":[{"characterId":"char_c100752","characterName":"月森 美咲","sourceIds":{"bangumi":[{"characterId":"102207","match":"exact-normalized-name-in-linked-work","subjectId":"354828"}],"egsCharacterIds":["23714"],"vndbCharacterId":"c100752"},"originalCharacterName":"月森 美咲","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The assistant homeroom teacher for the protagonist's class specializes in the modern Japanese language."},{"spoiler":false,"text":"Misaki's a woman of calm demeanor, always composed and reserved. She takes up residence in the dormitory managed by the protagonist's aunt, embarking on a new chapter of shared daily life with the protagonist."},{"spoiler":false,"text":"Misaki firmly believes that she must deeply engage with her students' concerns as a teacher. This conviction makes her particularly receptive when the protagonist seeks advice on \"how to find his future goals.\""},{"spoiler":false,"text":"Though inexperienced in love and somewhat shy, she secretly enjoys shoujo manga and romance novels. Thus, she harbors a deep longing for romantic and affectionate moments."},{"spoiler":false,"text":"But of course, she keeps this part of herself under wraps in her daily life."}],"source":"vndb","sourceCharacterId":"c100752"},{"segments":[{"spoiler":false,"text":"主人公のクラスの副担任の女性教師。担当科目は現代国語。"},{"spoiler":false,"text":"落ちついた物腰で、常に冷静沈着、物静かな女性。"},{"spoiler":false,"text":"主人公の叔母が管理する寮に入り、主人公と共に生活をするようになる。"},{"spoiler":false,"text":"教師として生徒の悩みには親身になって乗らねばならないと考えているため、主人公の「将来の目標を見つけるにはどうすればいいか」の相談にも積極的に乗ることになる。"},{"spoiler":false,"text":"男性経験はなくウブではあるが、密かに少女漫画やロマンス小説を多く読んでいるため、恋愛やイチャイチャに対する憧れはとても強い。"},{"spoiler":false,"text":"当然、普段はそれを表に出したりはしない。"}],"source":"egs","sourceCharacterId":"23714"},{"segments":[{"spoiler":false,"text":"主人公のクラスの副担任の女性教師。担当科目は現代国語。"},{"spoiler":false,"text":"落ちついた物腰で、常に冷静沈着、物静かな女性。"},{"spoiler":false,"text":"主人公の叔母が管理する寮に入り、主人公と共に生活をするようになる。"},{"spoiler":false,"text":"教師として生徒の悩みには親身になって乗らねばならないと考えているため、主人公の「将来の目標を見つけるにはどうすればいいか」の相談にも積極的に乗ることになる。"},{"spoiler":false,"text":"男性経験はなくウブではあるが、密かに少女漫画やロマンス小説を多く読んでいるため、恋愛やイチャイチャに対する憧れはとても強い。当然、普段はそれを表に出したりはしない"}],"source":"egs","sourceCharacterId":"23714","sourceWorkId":"31773","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスの副担任の女性教師。"},{"spoiler":false,"text":"担当科目は現代国語。"},{"spoiler":false,"text":"落ちついた物腰で、常に冷静沈着、物静かな女性。"},{"spoiler":false,"text":"主人公の叔母が管理する寮に入り、主人公と共に生活をするようになる。"},{"spoiler":false,"text":"教師として生徒の悩みには親身になって乗らねばならないと考えているため、"},{"spoiler":false,"text":"主人公の「将来の目標を見つけるにはどうすればいいか」の相談にも積極的に乗ることになる。"},{"spoiler":false,"text":"男性経験はなくウブではあるが、密かに少女漫画やロマンス小説を多く読んでいるため、"},{"spoiler":false,"text":"恋愛やイチャイチャに対する憧れはとても強い。"},{"spoiler":false,"text":"当然、普段はそれを表に出したりはしない。"}],"source":"bangumi","sourceCharacterId":"102207"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fc7a284d0778aec11ae6caa9101a50140dbf6431f281981b16175a4c95dd699.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f52e067a06be580a551255af2394b0459018ec471a4c9e8719ccf4ea2e70672.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田紗記子","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:480798:102207:17079:1","source":"bangumi"}]},{"characterId":"char_c135127","characterName":"荻野 ミウ","sourceIds":{"bangumi":[{"characterId":"160786","match":"exact-normalized-name-in-linked-work","subjectId":"480798"}],"egsCharacterIds":["25556"],"vndbCharacterId":"c135127"},"originalCharacterName":"荻野 ミウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female teacher in charge of Asakura Shinji's class, she teaches mathematics."},{"spoiler":false,"text":"Easy-going and cheerful, she always has a smile on her face. She is sometimes called the Holy Mother, or goddess by the students. In addition to being simply kind and cute, she is also a bit attractive, and is popular with everyone."},{"spoiler":false,"text":"On her way home, after having dinner with her senpai, Tsukimori Misaki, she encounters Shinji going out at night. Then, she learns of his \"sleeping problem\" and wants to do something for him. However, as a teacher, she cannot be with a student in the middle of the night. After much consideration, she finally comes up with a disguise? Calling herself \"Miu,\" she begins to help Shinji solves his problem."},{"spoiler":false,"text":"She cares very much about her students, and wants to get close to them if they are having any trouble. However, the most common problem she gets is getting asked about love by girls, even though she has no experience in it. Nevertheless, she hides her lack of experience because she wants her students to feel assured, and kindly gives them advice."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c135127"},{"segments":[{"spoiler":false,"text":"主人公のクラスの担任の女性教師。担当科目は数学。"},{"spoiler":false,"text":"おっとり朗らかで、いつも笑顔を絶やさない女性。"},{"spoiler":false,"text":"生徒たちからは聖母、または女神と心の中で呼ばれることもある。"},{"spoiler":false,"text":"単純に優しくかわいいことに加え、ちょっとだけ抜けているのも魅力的で、男女問わずに人気がある。"},{"spoiler":false,"text":"先輩である月森美咲と２人で食事をしたあとの深夜の帰り道、深夜に出歩いている主人公を発見。"},{"spoiler":false,"text":"そこで彼の「眠れない」という悩みを聞くことになり、何とかしてあげたいと思う。"},{"spoiler":false,"text":"しかし先生の立場で夜中に教え子と二人きりというわけにはいかず、悩んだ末に精一杯の変装？をし、「ミウ」と名乗って主人公の悩みを解決する手助けをする。"},{"spoiler":false,"text":"大変に生徒思いであり、何かで悩んでいたら徹底的に寄り添ってあげたいと考えるタイプ。"},{"spoiler":false,"text":"なお一番寄せられるのは女子からの恋愛相談であるが、彼女自身は恋愛経験が一切ない。"},{"spoiler":false,"text":"それでも、生徒が安心できないだろうからということで経験がないことは隠しつつ親身に相談に乗る。"}],"source":"egs","sourceCharacterId":"25556","sourceWorkId":"36006","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスの担任の女性教師。担当科目は数学。"},{"spoiler":false,"text":"おっとり朗らかで、いつも笑顔を絶やさない女性。"},{"spoiler":false,"text":"生徒たちからは聖母、または女神と心の中で呼ばれることもある。"},{"spoiler":false,"text":"単純に優しくかわいいことに加え、ちょっとだけ抜けているのも魅力的で、"},{"spoiler":false,"text":"男女問わずに人気がある。"},{"spoiler":false,"text":"先輩である月森美咲と２人で食事をしたあとの深夜の帰り道、"},{"spoiler":false,"text":"深夜に出歩いている主人公を発見。"},{"spoiler":false,"text":"そこで彼の「眠れない」という悩みを聞くことになり、何とかしてあげたいと思う。"},{"spoiler":false,"text":"しかし先生の立場で夜中に教え子と二人きりというわけにはいかず、"},{"spoiler":false,"text":"悩んだ末に精一杯の変装？をし、「ミウ」と名乗って主人公の悩みを解決する手助けをする。"},{"spoiler":false,"text":"大変に生徒思いであり、何かで悩んでいたら徹底的に寄り添ってあげたいと考えるタイプ。"},{"spoiler":false,"text":"なお一番寄せられるのは女子からの恋愛相談であるが、彼女自身は恋愛経験が一切ない。"},{"spoiler":false,"text":"それでも、生徒が安心できないだろうからということで経験がないことは隠しつつ親身に相談に乗る。"}],"source":"bangumi","sourceCharacterId":"160786"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"25556","sourceWorkId":"36006","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"25556","sourceWorkId":"36006","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"25556","sourceWorkId":"36006","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"25556","sourceWorkId":"36006","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"25556","sourceWorkId":"36006","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b10446bcc0a6fbfe802b6625ba079c3bbc008c137dec573b52da8694fb60289e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f8d9defab4ebfab413f1afd0d602fcc606b95ce75178d01f0aff6d0ea28e92d.webp","width":99,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊ヶ崎綾香","creatorId":"vndb:s8564","sourcePersonId":"vndb:s8564","canonicalEntityId":"vndb:s8564","name":"伊ヶ崎綾香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:480798:160786:22078:1","source":"bangumi"}]},{"character