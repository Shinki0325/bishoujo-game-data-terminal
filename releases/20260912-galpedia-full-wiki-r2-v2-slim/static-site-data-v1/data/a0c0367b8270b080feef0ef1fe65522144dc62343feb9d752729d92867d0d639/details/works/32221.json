ginalCharacterName":"園池 桜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"810"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend who has been close to the protagonist since kindergarten and knows him well. She honestly tells the protagonist what she wants and never forgets to stand up for him."},{"spoiler":false,"text":"Currently, her relationship with the protagonist is as follows: \"There is love, but no romantic feelings. There are no romantic feelings, but there is love,\" and no progress has been made."}],"source":"vndb","sourceCharacterId":"c95816"},{"segments":[{"spoiler":false,"text":"主人公とは幼稚園の頃からの仲良し。"},{"spoiler":false,"text":"彼女は主人公には自分の望みを素直に言う。"},{"spoiler":false,"text":"そうした方が主人公も喜んでくれると知っているから。"},{"spoiler":false,"text":"大好きな主人公を立てることを忘れない。"},{"spoiler":false,"text":"半歩下がったところから彼の魅力を引き立てたい。"},{"spoiler":false,"text":"現状、主人公との仲は、「愛はあるけど恋はない。恋はないけど愛がある」といったもの。"},{"spoiler":false,"text":"性知識は学校で教わった程度で、恋愛感情を抱くまでには至っていない。"}],"source":"egs","sourceCharacterId":"23353","sourceWorkId":"30627","spoiler":false},{"segments":[{"spoiler":false,"text":"幼稚園の頃からの仲良しで、主人公のことをよく知る幼なじみ。 主人公には、自分の望みを素直に言い。また主人公を立てることを忘れない。"},{"spoiler":false,"text":"現在、主人公との仲は「愛はあるけど恋はない。恋はないけど愛がある」といったところで進展はない状態が続いている。"}],"source":"bangumi","sourceCharacterId":"91399"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"91399","value":"幼なじみの心を読む"},{"label":"趣味","source":"bangumi","sourceCharacterId":"91399","value":"土いじり"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed34af5c0878418d080b410aae94078aeb9203bf24024536bce76f896fc363c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6d83d2d1eaa4339d6fa52f572523cd7bc196521f2ab3ba93a40a08f9fb667a6.webp","width":94,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鹿瀬紫卯","creatorId":"vndb:s8642","sourcePersonId":"vndb:s8642","canonicalEntityId":"vndb:s8642","name":"鹿瀬紫卯","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:366769:91399:56841:1","source":"bangumi"}]},{"characterId":"char_c95818","characterName":"秤 結衣","sourceIds":{"bangumi":[{"characterId":"91401","match":"exact-normalized-name-in-linked-work","subjectId":"328029"}],"egsCharacterIds":["23355"],"vndbCharacterId":"c95818"},"originalCharacterName":"秤 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1016"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After the trauma of being isolated in the past, she is resolved to use moving up to high school as an opportunity."},{"spoiler":false,"text":"She dresses herself in the ideal \"cute\" and tries to become someone who is liked by everyone."},{"spoiler":false,"text":"As a result of her efforts, she is now the center of the girl's group in her class, and although people around her have come to rely on her more and more, she is also pushing herself too hard and is exhausted every day in the shadows. Because she stays up late communicating on social networking sites, she has bad grades and is hopelessly non-athletic. Recently, her friend group has been inviting her to goukon and to hang out with boys, so she wants a boyfriend urgently in order to reject those invitations."}],"source":"vndb","sourceCharacterId":"c95818"},{"segments":[{"spoiler":false,"text":"中学の修学旅行の班分けで完全に孤立してしまったトラウマから、進学を期に一念発起。"},{"spoiler":false,"text":"理想の「カワイイ」を自らの身に纏い、誰にでも好かれる、仲間はずれにならない自分になろうと決意。"},{"spoiler":false,"text":"その目論見は成功し、一躍クラスの女子グループの中心的存在に。"},{"spoiler":false,"text":"メイクやアクセについて人に頼られ教えるのは楽しいが、相当無理をして取り繕っているので帰宅する時には毎日ヘトヘト。"},{"spoiler":false,"text":"就寝直前まで友達とSNSでのやり取りに勤しみ、当然のように課題をする時間はないので学業の成績は壊滅的。"},{"spoiler":false,"text":"絶望的に運動音痴。圧倒的に非力。人間以前に生物としてザコ。"},{"spoiler":false,"text":"週末は推しの動画を延々と流しながらアクセサリー作りやネットサーフィンに勤しむ。ライブがあれば現場へゴー。"},{"spoiler":false,"text":"最近は友達グループが性への興味に目覚め、普通にエロトークをするためついていこうと必死。"},{"spoiler":false,"text":"合コンや男子を含めた遊びの誘いを断るためにも、切実に彼氏が欲しい。"}],"source":"egs","sourceCharacterId":"23355","sourceWorkId":"30627","spoiler":false},{"segments":[{"spoiler":false,"text":"過去、孤立してしまったトラウマから進学を期に一念発起。"},{"spoiler":false,"text":"理想の「カワイイ」を身にまとい、誰にでも好かれる自分になろうとしている。努力の結果、現在はクラスの女子グループの中心的存在。"},{"spoiler":false,"text":"周囲から頼られる事も増えたが、無理もしているため毎日影でヘトヘトになっている。 夜遅くまでＳＮＳでやり取りをしていたりするため学業成績は壊滅的＋絶望的な運動音痴という“ザコ”な一面を持つ。最近は友達グループから合コンや男子を含めた遊びの誘いを断るためにも、切実に彼氏が欲しい。"}],"source":"bangumi","sourceCharacterId":"91401"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"91401","value":"歌とダンスの完コピ"},{"label":"趣味","source":"bangumi","sourceCharacterId":"91401","value":"アクセサリーづくり"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b844d64fa594ab88dfb770d90c33fad047677f9b88d38e65ae8fc7d086c996bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/termina