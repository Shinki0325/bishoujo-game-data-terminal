{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33269","model":{"presentationWorkId":"vndb:v27225","staff":{"artwork":[{"creditedName":"フェイトリネ-アルファ","creatorId":"vndb:s11936","sourcePersonId":"vndb:s11936","canonicalEntityId":"vndb:s11936","name":"フェイトリネ-アルファ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:162426","source":"vndb"}],"scenario":[{"creditedName":"Waffle","creatorId":"vndb:s29887","sourcePersonId":"vndb:s29887","canonicalEntityId":"vndb:s29887","name":"Waffle","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:162427","source":"vndb"}],"music":[{"creditedName":"REN","creatorId":"vndb:s9370","sourcePersonId":"vndb:s9370","canonicalEntityId":"vndb:s9370","name":"REN","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:162425","source":"vndb"}],"other":[{"creditedName":"Badriel","creatorId":"vndb:s1838","sourcePersonId":"vndb:s1838","canonicalEntityId":"vndb:s1838","name":"Badriel","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:162423","source":"vndb"},{"creditedName":"Inma Ruiz","creatorId":"vndb:s8024","sourcePersonId":"vndb:s8024","canonicalEntityId":"vndb:s8024","name":"Inma Ruiz","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:162424","source":"vndb"},{"creditedName":"Exilim","creatorId":"vndb:s29888","sourcePersonId":"vndb:s29888","canonicalEntityId":"vndb:s29888","name":"Exilim","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:162428","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c64731","characterName":"Tsukiko","sourceIds":{"vndbCharacterId":"c64731"},"originalCharacterName":"Tsukiko","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mischievous, vixen-like girl from Nekohime’s past, infamous for encouraging her elderly grandmother to feed her laptop’s D-Drive rice for a ‘Shinto purification ceremony’."},{"spoiler":false,"text":"Suki flirts with almost everyone, to such an extent it’s hard to tell whether she really means it. She also enjoys teasing people – particularly uptight people like Nekohime who get flustered easily."},{"spoiler":false,"text":"She grew up in a shrine, but is worlds apart from the image of a ‘traditional Japanese beauty’. She can be loud and obnoxious and incredibly pushy, but she’ll apologize when she realizes she’s gone too far."},{"spoiler":false,"text":"She’s also a competent digital artist, who spent a large portion of her life drawing and uploading her pictures online. After all, there’s not much else to do at a shrine."},{"spoiler":false,"text":"From Steam."}],"source":"vndb","sourceCharacterId":"c64731"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d15a567d267a809a8778709b9961256243b7e52732d66d33fb56518a61c40bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/772d5ec6d4cb8243050afc7e143a7527601417a278ee4fa958f25bb7b758d657.webp","width":142,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64732","characterName":"Matsuoka Chika","sourceIds":{"vndbCharacterId":"c64732"},"originalCharacterName":"Matsuoka Chika","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Nekohime’s closest friends. Her real name is Chika."},{"spoiler":false,"text":"Though she loves revealing cosplay and dressing in tightly-fitting spandex, she’s actually an elementary school teacher. She’s warm, cheerful, bubbly, and loves playing around with finger paints, which makes her a surprisingly good fit for her job (and no, she doesn’t dress quite so outlandishly when she’s at work)."},{"spoiler":false,"text":"Being creative, she enjoys experimenting in the kitchen and composing music. She nominates herself as the composer for her video game venture."},{"spoiler":false,"text":"From Steam."}],"source":"vndb","sourceCharacterId":"c64732"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cb484b18a827edf159000b4e609fa5b33e2b756de6ee3606a555cf69394ece1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db0f22908e0652db8f427cf9a9564d8e90d1271097c0f990b42384fea538e29d.webp","width":142,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64841","characterName":"Sayo","sourceIds":{"vndbCharacterId":"c64841"},"originalCharacterName":"Sayo","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The unwilling heroine of the story. Her real name is ‘Sayo’, but her friends refer to her by her internet handle - much to her embarrassment."},{"spoiler":false,"text":"Though she dislikes being referred to by a silly nickname she made up on the spot when she was a kid, she exhibits a lot of catlike traits. She’s always seen in her cat-eared jacket, she likes taking naps, and she can be rather ‘catty’."},{"spoiler":false,"text":"She lacks purpose in life, and is bored by her tedious, unrewarding job. Maybe making a video game is exactly the kind of diversion she needs."},{"spoiler":false,"text":"From Steam."}],"source":"vndb","sourceCharacterId":"c64841"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd9521304a178eadae2e33e8525624fd9d669881eb2e861077b11771ac78eed8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3dbf938ba7bff7f386ff8f6f89eeba0c87c6055a1d4ec83f1f1f8853165f087.webp","width":142,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c89854","characterName":"Kurumi","sourceIds":{"vndbCharacterId":"c89854"},"originalCharacterName":"Kurumi","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kurumi is a brand new character in the Sakura Gamer universe, and she acts as an antagonist towards our three main girls."},{"spoiler":false,"text":"Brash and short-tempered, Kurumi hates MikoMaid with a passion that seems almost personal. She makes quite a poor first impression, but at least she wears cute panties!"},{"spoiler":false,"text":"From Steam."}],"source":"vndb","sourceCharacterId":"c89854"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/968699032c91cc78938d39efbc2649e4b712a9c1378358122e9d44ffcf9195fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/239d0ba692e378e8c223e8e46c2b3efc2d782283ed84f639642a79391f499586.webp","width":153,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4019","sourceCompanyId":"egs:brand:4611","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33269:4611","source":"egs"},{"companyId":"v