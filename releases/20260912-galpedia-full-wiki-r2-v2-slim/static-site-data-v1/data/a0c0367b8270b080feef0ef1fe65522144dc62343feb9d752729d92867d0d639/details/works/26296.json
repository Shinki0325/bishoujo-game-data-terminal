ersonId":"vndb:s32369","canonicalEntityId":"vndb:s32369","name":"Keisuke","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146182","source":"vndb"},{"creditedName":"Mr Poltroon","creatorId":"vndb:s32370","sourcePersonId":"vndb:s32370","canonicalEntityId":"vndb:s32370","name":"Mr Poltroon","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146183","source":"vndb"},{"creditedName":"Ephemeralist","creatorId":"vndb:s32371","sourcePersonId":"vndb:s32371","canonicalEntityId":"vndb:s32371","name":"Ephemeralist","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146184","source":"vndb"},{"creditedName":"雪","creatorId":"vndb:s5005","sourcePersonId":"vndb:s5005","canonicalEntityId":"vndb:s5005","name":"綺良 雪","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:146186","source":"vndb"},{"creditedName":"小手指 若葉","creatorId":"vndb:s22036","sourcePersonId":"vndb:s22036","canonicalEntityId":"vndb:s22036","name":"小手指 若葉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146190","source":"vndb"},{"creditedName":"studio 以心電信","creatorId":"vndb:s26162","sourcePersonId":"vndb:s26162","canonicalEntityId":"vndb:s26162","name":"studio 以心電信","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146191","source":"vndb"},{"creditedName":"新島隆治","creatorId":"vndb:s41986","sourcePersonId":"vndb:s41986","canonicalEntityId":"vndb:s41986","name":"新島隆治","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:146192","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c67272","characterName":"赤木 澪","sourceIds":{"vndbCharacterId":"c67272"},"originalCharacterName":"赤木 澪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"831"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Height: Slightly reaching 160cm"},{"spoiler":false,"text":"Weight: Secret (nurse is a hard worker, so she's quite muscular...)"},{"spoiler":false,"text":"Three size: I will leave it to your imagination *grin*"},{"spoiler":false,"text":"Bust: Secret (F cup—according a colleague nurse)"},{"spoiler":false,"text":"Waist: Secret (Once boasted about being 60cm—according a colleague nurse)"},{"spoiler":false,"text":"Zodiac: Virgo"},{"spoiler":false,"text":"Mio is a \"veteran\" nurse who has been working in the hospital for 2 years. She is very popular with staff and patients, regardless of their age, especially because of her kindness and altruism towards others: Elderly people like her to accompany them for rehabilitation sessions and children love to play with her or annoy her by raising her skirt. However, although it is appreciated by many people and that she is very competent, Mio is very clumsy and is often reprimanded and put back by the head nurse who blames her for her lack of professionalism."},{"spoiler":false,"text":"Mio spent all of her childhood and adolescence with Takuya, her best friend, whether outside or at school because they were often in the same class as well as being neighbors. Average student, Takuya helped her all the time doing her homework because he was a brilliant student who wanted to become a pediatrician. Wanting to follow a similar path as Takuya, Mio then began studying to become a nurse and she was successful in obtaining her diploma after 4 years of intense studies. She hasn't seen Takuya since the end of high school, but that didn't prevent her from recognizing him at first sight when she saw him six years later in the hospital hall."},{"spoiler":false,"text":"Taking advantage of this unexpected chance to see him again, Mio and Takuya renew their ties when they have free time. One day, while they are talking up the stairs, a young boy jostles Mio who loses her balance. Takuya then grasps her hand and accompanies her in her fall, while protecting her in his arms and losing consciousness once down the stairs. He then wakes up in a hospital bed with the right arm and left leg broken. Feeling guilty, Mio asks him to ask her anything in exchange. Takuya then asks her if she can ask to take care of the room where he resides the time of his recovery."},{"spoiler":false,"text":"His request being accepted, Mio and Takuya start together the adventure of their life."}],"source":"vndb","sourceCharacterId":"c67272"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddbecb9b6f701392db9b8260027588f67f9de0d5b3f293f0ae891d2458dea334.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07c59221378bb92d8ef30599513c23ee037dc4ea59ba16cdbc845e0a90d1008b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五行 なずな","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76769","source":"vndb"}]},{"characterId":"char_vndb_c78567","characterName":"白沢 卓也","sourceIds":{"vndbCharacterId":"c78567"},"originalCharacterName":"白沢 卓也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takuya is in his 6th year of medical school and just started practicing at the hospital to become an independent pediatrician. As soon as he arrives in the hospital hall, he sees a crying little girl so he decides to see if she's fine. Arrived at the girl, Takuya suddenly meets a young nurse about his age who has also come to see the little girl. After osculating the girl, Takuya realizes that the young nurse is not unfamiliar to him at all because she is in fact his childhood friend Mio with whom he spent all his youth and adolescence with."},{"spoiler":false,"text":"After 6 years without seeing each other, Takuya and Mio renew their ties as soon as they have the time. One day, while they are talking up the stairs, a young boy jostles Mio who loses her balance. Takuya then grasps her hand and accompanies her in her fall, while protecting her in his arms and losing consciousness once down the stairs. He then wakes up in a hospital bed with the right arm and left leg broken. Feeling guilty, Mio asks him to ask her anything in exchange. Takuya then asks her if she can ask to take care of the room where he resides the time of his recovery."},{"spoiler":false,"text":"His request being accepted, Mio and Takuya start together the adventure of their life."}],"source":"vndb","sourceCharacterId":"c78567"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/924a0bb3240979532beb384c4e870ebfd71a430da14db18239c56caee20ccc26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29c5cb2fb789c7686c01c8d2dd89176b7437c45b0d03cc3548eda08288602206.webp","width":205,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78568","characterName":"Sumiyama Taishi","sourceIds":{"vndbCharacterId":"c78568"},"originalCharacterName":"Sumiyama Taishi","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takuya's friend from university and also a friend of Satou. He too is coming to the hospital to learn with his friends. He is not stupid but he is not very clever either and he does not get much involved in his academic duties. By cons he is very serious and involved in his work, he is very professional."},{"spoiler":false,"text":"When he meets Takuya or Satou, he begins to enter endless conversations with him or her, almost forgetting the rest of the world."}],"source":"vndb","sourceCharacterId":"c78568"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c78569","characterName":"Sasaki Satou","sourceIds":{"vndbCharacterId":"c78569"},"originalCharacterName":"Sasaki Satou","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takuya's friend from university and also a friend of Taishi. She comes to do her apprenticeship at the hospital with her friends. She is a very intelligent girl who is straight and strict with herself, finishing her academic duties in advance and being exemplary at work."},{"spoiler":false,"text":"Since she always finishes her work in advance, she is entitled to longer breaks while the others still have not finished theirs. She loves to charier her friends, Taishi for her academic mediocrity and Takuya thanks to the crisp stories of her childhood told by Mio."}],"source":"vndb","sourceCharacterId":"c78569"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c78570","characterName":"Advisor","sourceIds":{"vndbCharacterId":"c78570"},"originalCharacterName":"Advisor","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The referring doctor of Takuya, Satou and Taishi. It's to him that they must give reports and it's also him who gives them homework to do and missions to accomplish."},{"spoiler":false,"text":"Serious and strict with his students and colleagues at work, he is much more friendly and relaxed during break times."},{"spoiler":true,"text":"Even if he doesn't show it, he is very curious to know with his colleague the head nurse how progresses the romance between Takuya and Mio."}],"source":"vndb","sourceCharacterId":"c78570"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c78571","characterName":"Head Nurse","sourceIds":{"vndbCharacterId":"c78571"},"originalCharacterName":"Head Nurse","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The hierarchical superior of Mio and all the other nurses. Her slogan is \"professionalism, efficiency and rigor\" and beware of those who can't keep these goals."},{"spoiler":false,"text":"Serious and strict with her younger nurse colleagues who only think about marrying young single doctors, she is more friendly during breaks."},{"spoiler":true,"text":"She manages to judge someone right at first sight and she knows that Mio isn't the type of woman to jump on the first single doctor to come. Although she asks her to be more serious at work, she is actually very curious with her doctor colleague about the romance between Takuya and Mio."}],"source":"vndb","sourceCharacterId":"c78571"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c78572","characterName":"Kawakami-obaasan","sourceIds":{"vndbCharacterId":"c78572"},"originalCharacterName":"Kawakami-obaasan","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nice grandmother who is in Mio's care and meets Takuya while Mio makes him visit the hospital. She is currently in rehabilitation."},{"spoiler":false,"text":"She finds Takuya very beautiful, and she makes Mio understand more than once that she has to do something to make him her own."}],"source":"vndb","sourceCharacterId":"c78572"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c78575","characterName":"Hatanaka-san","sourceIds":{"vndbCharacterId":"c78575"},"originalCharacterName":"Hatanaka-san","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hatanaka is a married man and the father of a teenage daughter, he is a construction worker. He broke both legs during a construction site and the chance was that Takuya was his roommate. He is very kind and funny."},{"spoiler":false,"text":"Takuya never had to deal with him as a patient, but he knows him very well because of a rumor saying that Hatanaka's wife and daughter are very pretty."}],"source":"vndb","sourceCharacterId":"c78575"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c78579","characterName":"Hikari","sourceIds":{"vndbCharacterId":"c78579"},"originalCharacterName":"Hikari","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A restless but kind boy who has a habit of tormenting Kaori and peoples he likes a lot, including Mio because he often raises her skirt to see her panties. According to Mio, he has so much charisma that he is the \"head\" of the children hospitalized in the establishment."}],"source":"vndb","sourceCharacterId":"c78579"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c78580","characterName":"Kaori","sourceIds":{"vndbCharacterId":"c78580"},"originalCharacterName":"Kaori","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A calm and kind girl who was crying on the first day Takuya arrived, she immediately fell under his spell. She is one of Mio's protégés, she likes her a lot. She is often the target of Hikari's jokes and she also seems to be his closest friend."}],"source":"vndb","sourceCharacterId":"c78580"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p6978","sourceCompanyId":"egs:brand:5469","canonicalEntityId":"vndb:p6978","name":"プレカノ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26296:5469","source":"egs"},{"companyId":"vndb:p6066","sourceCompanyId":"vndb:p6066","canonicalEntityId":"vndb:p6066","name":"株式会社エンターグラム","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:100069:v22445","source":"vndb"},{"companyId":"vndb:p6978","sourceCompanyId":"vndb:p6978","canonicalEntityId":"vndb:p6978","name":"プレカノ","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:100070:v22445","source":"vndb"},{"companyId":"vndb:p6066","sourceCompanyId":"vndb:p6066","canonicalEntityId":"vndb:p6066","name":"株式会社エンターグラム","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:100584: