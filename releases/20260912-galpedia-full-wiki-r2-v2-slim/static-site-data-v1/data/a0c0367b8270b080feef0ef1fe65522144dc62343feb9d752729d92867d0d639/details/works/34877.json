criptions":[{"segments":[{"spoiler":false,"text":"Ryuji Shiraoka was a college classmate of Kohei and Tsumugi."},{"spoiler":false,"text":"He was originally a friend of Tsumugi's and got acquainted with Kohei through that connection."},{"spoiler":false,"text":"At best, he is cheerful and open-minded; at worst, he is thoughtless and frivolous."},{"spoiler":false,"text":"She is not a bad person at heart and has many friends, both male and female."},{"spoiler":false,"text":"Although he and Tsumugi were not boyfriend and girlfriend for a long time, they had been in a \"deep relationship\" until he started dating Kohei."}],"source":"vndb","sourceCharacterId":"c130509"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/565578aa13e20515c7944af876ea9c388ea7523740ada7fd1f38da96b45e1060.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5da4f45e17aa0384e654927e19c1aafc802036f4ecd54cda705c12fb4992ce8.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1224","sourceCompanyId":"egs:brand:6706","canonicalEntityId":"vndb:p1224","name":"アトリエさくら","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:34877:6706","source":"egs"},{"companyId":"vndb:p1224","sourceCompanyId":"vndb:p1224","canonicalEntityId":"vndb:p1224","name":"アトリエさくら","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:122502:v46765","source":"vndb"},{"companyId":"vndb:p1224","sourceCompanyId":"vndb:p1224","canonicalEntityId":"vndb:p1224","name":"アトリエさくら","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:125025:v46765","source":"vndb"},{"companyId":"vndb:p1224","sourceCompanyId":"vndb:p1224","canonicalEntityId":"vndb:p1224","name":"アトリエさくら","roleCodes":["developer","publisher"],"ident