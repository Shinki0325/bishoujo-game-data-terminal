{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"34877","model":{"presentationWorkId":"vndb:v46765","staff":{"artwork":[{"creditedName":"かれー","creatorId":"vndb:s17689","sourcePersonId":"egs:creator:33501","canonicalEntityId":"vndb:s17689","name":"かれー","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:270367","source":"egs"}],"scenario":[{"creditedName":"づか","creatorId":"vndb:s9838","sourcePersonId":"egs:creator:27056","canonicalEntityId":"vndb:s9838","name":"づか","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:270366","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c130507","characterName":"古賀 紬","sourceIds":{"vndbCharacterId":"c130507"},"originalCharacterName":"古賀 紬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A housewife who has been married for three years."},{"spoiler":false,"text":"She and her husband, Kohei, were university classmates, and it was his strong approach that led to their relationship and marriage."},{"spoiler":false,"text":"Despite such circumstances, she is now deeply in love with her husband."},{"spoiler":false,"text":"She was quite playful during her college days, but now she is consciously trying to speak and act in a calm manner."},{"spoiler":false,"text":"She chooses to dress and style her hair in a way that makes her look ladylike so that she can stand next to the more serious Kohei."},{"spoiler":false,"text":"She is not at all conscious that she is overworking herself, but the small discrepancies and breaks in her appearance are taking their toll on her body."}],"source":"vndb","sourceCharacterId":"c130507"}],"profi