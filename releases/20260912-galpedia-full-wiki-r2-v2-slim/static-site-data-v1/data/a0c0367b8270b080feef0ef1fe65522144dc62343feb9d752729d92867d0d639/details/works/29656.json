roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:221262","source":"egs"},{"creditedName":"真田尚央","creatorId":"vndb:s30848","sourcePersonId":"egs:creator:29175","canonicalEntityId":"vndb:s30848","name":"真田尚央","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:221263","source":"egs"},{"creditedName":"乃亜","creatorId":"vndb:s30854","sourcePersonId":"egs:creator:21993","canonicalEntityId":"vndb:s30854","name":"乃亜","detail":"戦闘アニメーション","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:221271","source":"egs"},{"creditedName":"CAN","creatorId":"vndb:s18082","sourcePersonId":"egs:creator:33292","canonicalEntityId":"vndb:s18082","name":"CAN","detail":"主題歌「Twilight Apostle―宵闇の使者―」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:243894","source":"egs"}]},"cast":[{"characterId":"char_bangumi_137041","characterName":"克莱西娅·贝尔科·维克托","sourceIds":{"bangumi":[{"characterId":"137041","match":"source-roster","subjectId":"301984"}]},"originalCharacterName":"克莱西娅·贝尔科·维克托","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「能做到的话就试试看吧」"},{"spoiler":false,"text":"从小父母双亡，在国立孤儿院长大的精灵少女。"},{"spoiler":false,"text":"使用缠绕魔法的『魔法剑』来战斗。"},{"spoiler":false,"text":"与骑士团学校的同期生的法尔科是同一间孤儿院长大的青梅竹马。"},{"spoiler":false,"text":"两人的争吵被周围的人说成是“互相逗乐”。"},{"spoiler":false,"text":"-------------"},{"spoiler":false,"text":"「说真心话的话，我不想他在勉强自己了。但是，我很清楚法尔科的想法……」"},{"spoiler":false,"text":"曾经隶属于维克托骑士团，从银之贝希摩斯手上拯救国家的英雄。"},{"spoiler":false,"text":"现在她的父亲鲁格成为了国王，而她成为了公主。"},{"spoiler":false,"text":"维克托骑士团的骑士团长法尔科的妻子。"},{"spoiler":false,"text":"为养育两岁的女儿而奋斗着，每天都过着快乐的生活。"},{"spoiler":false,"text":"虽然多少有些平静下来，但偶尔还是会和法尔科争吵。"},{"spoiler":false,"text":"女儿斯特拉会开心看着这一切来笑个不停。"}],"source":"bangumi","sourceCharacterId":"137041"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"137041","value":"特务部队→维克托国·公主"},{"label":"种族","source":"bangumi","sourceCharacterId":"137041","value":"精灵"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edd69bb5676e9c7ea7d0181bc760c2e739e88066e0fd03770489e7ee83b023f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/3886ae49af14d9feecef70b2bddbb48911d73c27fc9ecfaabc3eb9c45e036198.webp","width":238,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤羽えりか","creatorId":"egs:creator:35601","sourcePersonId":"egs:creator:35601","canonicalEntityId":"egs:creator:35601","name":"赤羽えりか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301984:137041:53159:1","source":"bangumi"}]},{"characterId":"char_bangumi_137087","characterName":"Annette Stole","sourceIds":{"bangumi":[{"characterId":"137087","match":"source-roster","subjectId":"301984"}]},"originalCharacterName":"Annette Stole","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"18"},"bust":{"reviewState":"source-only","source":"bangumi","value":"89"},"height":{"reviewState":"source-only","source":"bangumi","value":"173"},"hip":{"reviewState":"source-only","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「我有非完成不可的事情」"},{"spoiler":false,"text":"实用技巧、学习能力都以第一名毕业于骑士团学校。"},{"spoiler":false,"text":"在入学考试对战以来，和克莱西娅成为了好友。"},{"spoiler":false,"text":"虽然有着非完成不可得事情而成为骑士，但没有人知晓她的过去。"}],"source":"bangumi","sourceCharacterId":"137087"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"137087","value":"特务部队"},{"label":"种族","source":"bangumi","sourceCharacterId":"137087","value":"精灵"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22d59819ed0b0686b7985509231ad2383041c9d24e2f4aa3a79534d74e72a2c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4b9aab0962a27d68e4ef6a15cd7b2e63800a9e912e138cce2f8b50e07771fb4.webp","width":232,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚凪","creatorId":"vndb:s2950","sourcePersonId":"vndb:s2950","canonicalEntityId":"vndb:s2950","name":"柚凪","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301984:137087:25046:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p3697","sourceCompanyId":"egs:brand:4219","canonicalEntityId":"vndb:p3697","name":"ONEONE1","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29656:4219","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
