e":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl attending different school than other characters. She lives in a mansion with a large storehouse in the backyard, fitting the oldest family in town."},{"spoiler":false,"text":"Not a child anymore, yet still not an adult, she desperately wishes to become an adult already, metaphorically stretching her back while standing on her tiptoes. However, by doing this she only proves that she's still a child after all."},{"spoiler":false,"text":"She means no harm, but often she ends up pulling people around with her innocent behaviour."},{"spoiler":false,"text":"translated from manual"}],"source":"vndb","sourceCharacterId":"c9961"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b228eff64c053845d8afd8fab09c2d32556ff26fdd3936f4b8e0168f98ba15e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c369e991479f63f2bd00d6714efdf546536f0e080eb28bb3d1e9823b7f4272ef.webp","width":124,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠野 そよぎ","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10039","source":"vndb"}]},{"characterId":"char_vndb_c9962","characterName":"床与 更紗","sourceIds":{"vndbCharacterId":"c9962"},"originalCharacterName":"床与 更紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"If you wanted to sound nice, you'd call her relaxed, gentle person. Or, to put it bluntly, she's just carefree."},{"spoiler":false,"text":"Third year student, preparing for final exams and graduation next year. However she isn't concerned too much about her future. Still unsure, which way would be best."},{"spoiler":false,"text":"One day, after seeing a certain dream, she decided to investigate legends and traditions related to town's shrine as a summer homework assignment. She always carries a charm, which she treasures greatly, even though she doesn't remember when and how she got it."},{"spoiler":false,"text":"Also, she sleeps a lot."},{"spoiler":false,"text":"translated from manual"},{"spoiler":true,"text":"Towa's estranged older sister"}],"source":"vndb","sourceCharacterId":"c9962"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfa9b0605fc00b1f20a0304b9a1ff8466ab6c4f57393ed8f0d7ec2acff02b625.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66b1af4a738f831185df7084cc6616f73062796817bfbc6960b034d45878513b.webp","width":124,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲 かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"藤咲 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10041","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p22","sourceCompanyId":"egs:brand:683","canonicalEntityId":"vndb:p22","name":"Princess Soft","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:5778:683","source":"egs"},{"companyId":"vndb:p502","sourceCompanyId":"vndb:p502","canonicalEntityId":"vndb:p502","name":"Clear","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2488:v1113","source":"vndb"},{"companyId":"vndb:p22","sourceCompanyId":"vndb:p22","canonicalEntityId":"vndb:p22","name":"プリンセスソフト","ro