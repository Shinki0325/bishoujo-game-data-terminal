name":"青谷 鴬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:187398","source":"vndb"},{"creditedName":"SUZUKA","creatorId":"vndb:s1619","sourcePersonId":"vndb:s1619","canonicalEntityId":"vndb:s1619","name":"中原 涼","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:187400","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c124631","characterName":"カナリア","sourceIds":{"vndbCharacterId":"c124631"},"originalCharacterName":"カナリア","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a beautiful appearance and a body that even her father is obsessed with."},{"spoiler":false,"text":"She's born in order to stabilize her mother's place, who was once a prostitute but became a concubine by virtue of her appearance and intelligence."},{"spoiler":false,"text":"From an early age, she was taught how to manipulate men."},{"spoiler":false,"text":"After her mother died of murder, she was pushed out of the center of power."},{"spoiler":false,"text":"She was driven deep into the castle to live in a building originally used to isolate plague patients."}],"source":"vndb","sourceCharacterId":"c124631"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27d93d463ec596b0ec61614a9b8c6e4cf7b33d602348ae0c525b366b0d6a1e1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3f3bd70edb7fb79841927d028a823f4c21e949f8eb823481cf2d05ac5cd1824.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風鈴 みすず","creatorId":"vndb:s12799","sourcePersonId":"vndb:s12799","canonicalEntityId":"vndb:s12799","name":"日向 結希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92088","source":"vndb"}]},{"characterId":"char_vndb_c124632","characterName":"ライナス","sourceIds":{"vndbCharacterId":"c124632"},"originalCharacterName":"ライナス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a knight from a neighboring country that was captured in the war."},{"spoiler":false,"text":"Because of his high self-esteem, his personality is also sharp."},{"spoiler":false,"text":"He has no interest in devoting his loyalty to the king or the god, and the sword in his hand is intended to be wielded only for himself."},{"spoiler":false,"text":"He is a bit misogynistic, so even though people around him advise him to get married early, he still doesn't have a lover yet."},{"spoiler":false,"text":"He wears a \"magic stone\" collar around his neck to prevent him from harming people in the city."},{"spoiler":false,"text":"So no matter how much he cursed, he couldn't really take action."},{"spoiler":false,"text":"It's easy to lose to the pleasure."}],"source":"vndb","sourceCharacterId":"c124632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af8222b74b0174c31541636d4f099cef2f800f73bbdafd86c2b3200a15725570.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87af34d66227bfbb7a76ad130a51119be1fbe0e59cc88eff10fa4c91719ffae4.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"初時 チェリー","creatorId":"vndb:s17968","sourcePersonId":"vndb:s17968","canonicalEntityId":"vndb:s17968","name":"初時 チェリー","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92089","source":"vndb"}]},{"characterId":"char_vndb_c124633","characterName":"アイオラ","sourceIds":{"vndbCharacterId":"c124633"},"originalCharacterName":"アイオラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a member of a certain ethnic group living in a remote area of ​​a small country under the rule of an empire."},{"spoiler":false,"text":"After being spotted by Canaria's mother, he became Canaria's follower."},{"spoiler":false,"text":"Purchasing supplies, preparing food and taking care of Canaria are all his jobs."},{"spoiler":false,"text":"A being who understands Canaria's loneliness and stays by her side."},{"spoiler":false,"text":"Originally, his nation did not have the culture of \"word\"."},{"spoiler":false,"text":"But since he became Canaria's follower, he learned to read and write under her advice, and now he enjoys reading all kinds of books."},{"spoiler":false,"text":"Influenced by Canaria's tone and books, he can use some hard words."},{"spoiler":false,"text":"His special trick is squirting."}],"source":"vndb","sourceCharacterId":"c124633"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64c73c2d12d55c9f3f8d6a436d6bbbadb660c0527ced13bac424682f6f144758.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c289621a2a01fab698198fa6d6f5c6e5b9bbf2d0b9cdad31d83fa75599dc6a16.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井伊 筋肉","creatorId":"vndb:s8318","sourcePersonId":"vndb:s8318","canonicalEntityId":"vndb:s8318","name":"石谷 春貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92090","source":"vndb"}]},{"characterId":"char_vndb_c173890","characterName":"Altinia","sourceIds":{"vndbCharacterI