ative","relationId":"vndb:vn-staff:15583","source":"vndb"},{"creditedName":"MOKA","creatorId":"vndb:s8200","sourcePersonId":"vndb:s8200","canonicalEntityId":"vndb:s8200","name":"MOKA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15587","source":"vndb"},{"creditedName":"Que Seran Pasaran","creatorId":"vndb:s50819","sourcePersonId":"vndb:s50819","canonicalEntityId":"vndb:s50819","name":"Que Seran Pasaran","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:15589","source":"vndb"}]},"cast":[{"characterId":"char_c5573","characterName":"北条 智秋","sourceIds":{"bangumi":[{"characterId":"93638","match":"exact-normalized-name-in-linked-work","subjectId":"41516"}],"egsCharacterIds":["18132"],"vndbCharacterId":"c5573"},"originalCharacterName":"北条 智秋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"候と同じ学校に通う、一学年上のお姉さん的存在。"},{"spoiler":false,"text":"年上なのだが、おっとりぽわぽわした世間知らずで、候がいなかったらどうなってしまうのだろうと、心配されるほど。"},{"spoiler":false,"text":"押しに弱いタイプで、簡単にコントロールできてしまう素直な性格。"},{"spoiler":false,"text":"悪人に目を付けられたら大変そうだが、独特の癒しオーラで、どんな人も和ませ、受け入れられてしまう魅力を持っている。"},{"spoiler":false,"text":"ヒロインの中で、一番の巨乳を誇る。"}],"source":"egs","sourceCharacterId":"18132","sourceWorkId":"10872","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ学校の一学年上に通うお姉さんヒロイン。"},{"spoiler":false,"text":"年上なのだが、主人公がいなかったらどうなってしまうのかと思うほど世間知らずで、ぼんやりさん。"},{"spoiler":false,"text":"幼馴染み同様押しに弱いタイプで、特に悪意はなくても意のままにコントロールできてしまう素直な性格。そのうえあわてんぼさんで、すぐにハワワ！状態になってしまうことも。"},{"spoiler":false,"text":"ただしその癒し系の性格は周囲も認めるところで、どんなシーンでも周りにとけ込み、受け入れられてしまう不思議な魅力の持ち主。主人公のバイト先（飲食店など）にずっと居座っても、バイト仲間からの評判はすこぶるよかったりする。"},{"spoiler":false,"text":"お姉さんキャラなのでもちろん巨乳である。"}],"source":"bangumi","sourceCharacterId":"93638"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bacd9e7be96c6c4eea75c9388967c4b3814fe9a21e97e6342175fff7fae0103.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39ea9b27f4869df3102296e789f4887bb8570fbb091d278e412b5ba9ef5e777e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41516:93638:4489:1","source":"bangumi"}]},{"characterId":"char_c5603","characterName":"東峰 陽奏","sourceIds":{"bangumi":[{"characterId":"93637","match":"exact-normalized-name-in-linked-work","subjectId":"41516"}],"egsCharacterIds":["18131"],"vndbCharacterId":"c5603"},"originalCharacterName":"東峰 陽奏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"寡黙で物静か、感情表現が苦手な少女。候と同じ学校に通っている。"},{"spoiler":false,"text":"読書が好きらしく、図書館に通いつめていて、学術的な知識はかなり豊富。"},{"spoiler":false,"text":"ただし、恋愛に関してはかなりウブで、そういった事柄には、ちょっとしたことでも素直に感動したりする可愛らしい面も見せる。"},{"spoiler":false,"text":"ただし、そういった面は、好きになった候にしか見せないのだ。"}],"source":"egs","sourceCharacterId":"18131","sourceWorkId":"10872","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ学校に通うが、クラスは別のヒロイン。"},{"spoiler":false,"text":"図書館少女。"},{"spoiler":false,"text":"かなり寡黙で、感情表現が苦手なようだ。"},{"spoiler":false,"text":"外にあまり出ないので、社交性は低い。"},{"spoiler":false,"text":"学術的な知識はかなり豊富で物静か。何事にも動じない落ち着いた性格をしている。"},{"spoiler":false,"text":"ただし恋愛に関する出来事に対応することができず、いきなり思考停止になったりもする。"},{"spoiler":false,"text":"そういった事柄に対する知識がまったくないので、ちょっとしたことでも素直に感動したりする可愛い面も併せ持つ。"},{"spoiler":false,"text":"しかしそういう可愛い面は主人公にしか見せないのだった。"}],"source":"bangumi","sourceCharacterId":"93637"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0985b7dd28384ef9dc052a8f380a2458c876a66d2649bc2fa0465a2ea1701c63.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2145ace851490aad03c8de17d4879b20b7da3c9b1db092cf001d047cd66a3c8d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41516:93637:5020:1","source":"bangumi"}]},{"characterId":"char_c5604","characterName":"南雲 榎穂","sourceIds":{"bangumi":[{"characterId":"93635","match":"exact-normalized-name-in-linked-work","subjectId":"41516"}],"egsCharacterIds":["18129"],"vndbCharacterId":"c5604"},"originalCharacterName":"南雲 榎穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"直情型ですぐ突っかかってくる、典型的なツンデレ少女。"},{"spoiler":false,"text":"候とは、バイト先の同僚として知り合う。"},{"spoiler":false,"text":"付き合い始めてからも「学校が同じじゃない」なんて理由で割とつれない態度をとったりするが、それは、候を好きで好きでしょうがない気持ちを上手く表せないことの裏返し。"},{"spoiler":false,"text":"その証拠に、授業中でも可愛いヤキモチメールを送ってくるほど。"},{"spoiler":false,"text":"「一緒に手を繋いで登校」という乙女チックな夢があるが、学校が別なため、なかなか実現できなかったりする。"}],"source":"egs","sourceCharacterId":"18129","sourceWorkId":"10872","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の勤めるバイト先の同僚。学校は別。"},{"spoiler":false,"text":"直情型ですぐに突っかかってくる典型的ツンデレ。"},{"spoiler":false,"text":"ただ個人的な趣味はかなり乙女チックらしい。"},{"spoiler":false,"text":"主人公と付き合い始めてからも学校が同じではないことが理由からか、わりとつれない態度をとったりもするが、実は主人公に対する好きでしょうがないという気持ちを上手く表すことができないでいるだけのようだ。"},{"spoiler":false,"text":"見かけによらず心配性で、授業中などにしょっちゅうメールで「浮気してないでしょうね！？」とかわいいヤキモチメールなどを送ってくる。"},{"spoiler":false,"text":"学校が違うため、実は一緒に手をつないで登校したいという可愛い夢を見ていたりする乙女心があったりする。"}],"source":"bangumi","sourceCharacterId":"93635"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c00095e860688277f5aa8feece49a88a3b2a7fc55bd4e9f18838cf646eb651b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ac5eaaae69a0923ba501523b4d52373e6050043be567799ff2c11d3d89fb42a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41516:93635:4956:1","source":"bangumi"}]},{"characterId":"char_c5605","characterName":"天野 暦","sourceIds":{"bangumi":[{"characterId":"93636","match":"exact-normalized-name-in-linked-work","subjectId":"41516"}],"egsCharacterIds":["18130"],"vndbCharacterId":"c5605"},"originalCharacterName":"天野 暦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お兄ちゃん（候）のことが大好きな妹で、何事にもマイペースで取り組む「ゆるキャラ属性」。"},{"spoiler":false,"text":"アニメやゲームなどに詳しい、いわゆるオタクっ娘で、バイト先も、趣味と実益を兼ねたゲームショップだったりする。"},{"spoiler":false,"text":"ゆるキャラらしく朝は苦手で、候が起こしに行かなくてはならない。"},{"spoiler":false,"text":"その代わり、毎朝一緒に登校できる「妹萌え」には堪らない特典がある。"}],"source":"egs","sourceCharacterId":"18130","sourceWorkId":"10872","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹だが、かなりのヲタク。"},{"spoiler":false,"text":"残念ながら妹はネボスケなので、むしろ兄である主人公が起こしに行かなくてはならない。"},{"spoiler":false,"text":"お兄ちゃんのことは大好きっ娘。"},{"spoiler":false,"text":"学校が同じなので毎朝一緒に登校するが、学年は当然別。"},{"spoiler":false,"text":"バイト先は趣味と実益をかねたゲームショップ。"},{"spoiler":false,"text":"アニメ、ゲームなどに詳しく、とくに8bitゲームの造詣が深い。"},{"spoiler":false,"text":"部屋にはクレーンゲームやプライズゲームの景品のぬいぐるみなどが多数おかれている。"},{"spoiler":false,"text":"どんな事柄に対しても積極的に行動するわけではなく、かなりのゆるキャラである。"}],"source":"bangumi","sourceCharacterId":"93636"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bfb3dc5d3a453229ee6fc29dd6a793ea08ce6f111f4c24ff60902dc3501e94e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70c1eafcba21c20bd164f6a2e4999c1d5bf743a64bec6ba3faa97c972c30b6a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41516:93636:6166:1","source":"bangumi"}]},{"characterId":"char_c5606","characterName":"小西 冬桜","sourceIds":{"bangumi":[{"characterId":"93634","match":"exact-normalized-name-in-linked-work","subjectId":"41516"}],"egsCharacterIds":["18128"],"vndbCharacterId":"c5606"},"originalCharacterName":"小西 冬桜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"寂しがり屋で甘えん坊、子犬っ娘属性を持った同級生。"},{"spoiler":false,"text":"毎朝、候を起こしにきてくれるありがたい幼馴染でもある。"},{"spoiler":false,"text":"ちょっぴり気が弱く、よく候に言い負かされては涙目になったり、起こしにきては、候に押し倒されたりしているが、それでも、候のことが好きで好きで堪らない様子。"},{"spoiler":false,"text":"彼女の幸せは「候と一緒にいること」。"}],"source":"egs","sourceCharacterId":"18128","sourceWorkId":"10872","spoiler":false},{"segments":[{"spoiler":false,"text":"毎朝主人公のことを起こしにきてくれる幼馴染みの女の子。同じ学校の同級生。"},{"spoiler":false,"text":"寂しがり屋でかなりの甘えん坊、属性はどちらかと言えば子犬っぽい。"},{"spoiler":false,"text":"主人公のことが好きで好きでしょうがない様子。"},{"spoiler":false,"text":"ただちょっとぴり気が弱く、よく主人公に言い負かされて涙目になったりもする。"},{"spoiler":false,"text":"押しに弱く、朝お越しに来てグズグズな主人公にそのまま押し倒されたりもする。"},{"spoiler":false,"text":"主人公と一緒にいられることが幸せなかわいい女の子。"}],"source":"bangumi","sourceCharacterId":"93634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91e6f37b4c62265e77b350dbc741faf43ce1c65316bd2881957e72806fda20d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae9d5fae3faa5127b21d074e2fefde979cd2be4a81892bdf4f92c944cace3a6f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41516:93634:4810:1","source":"bangumi"}]},{"characterId":"char_vndb_c133675","characterName":"天野 候","sourceIds":{"vndbCharacterId":"c133675"},"originalCharacterName":"天野 候","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p239","sourceCompanyId":"egs:brand:1991","canonicalEntityId":"vndb:p239","name":"C:drive.","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10872:1991","source":"egs"},{"companyId":"vndb:p1746","sourceCompanyId":"vndb:p1746","canonicalEntityId":"vndb:p1746","name":"株式会社エムトリックス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:162375:v780","source":"vndb"},{"companyId":"vndb:p239","sourceCompanyId":"vndb:p239","canonicalEntityId":"vndb:p239","name":"C:drive.","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:1842:v780","source":"vndb"},{"companyId":"vndb:p239","s