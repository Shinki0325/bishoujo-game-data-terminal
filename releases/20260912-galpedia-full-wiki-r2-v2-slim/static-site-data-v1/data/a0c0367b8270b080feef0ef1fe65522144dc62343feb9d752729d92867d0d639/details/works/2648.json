rce":"vndb"}]},"cast":[{"characterId":"char_c57136","characterName":"桜庭 湊","sourceIds":{"bangumi":[{"characterId":"95225","match":"exact-normalized-name-in-linked-work","subjectId":"229664"},{"characterId":"95225","match":"exact-normalized-name-in-linked-work","subjectId":"229668"}],"egsCharacterIds":["19656"],"vndbCharacterId":"c57136"},"originalCharacterName":"桜庭 湊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"36"},"bust":{"reviewState":"source-only","source":"vndb","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koutaro's step mother."},{"spoiler":false,"text":"She and Misako, Koutarou's biological mother, have known each other since childhood. She married Koutarou's grieving father, after the death of his wife shortly after Nagisa was born."},{"spoiler":false,"text":"Since then, she has been taking care of household responsibilities while making the family supermarket business prosperous."},{"spoiler":false,"text":"She is the ideal mother, perfectly capable of handling all household chores, sometimes kind and sometimes strict. In reality, she is an extremely lonely person who cannot survive without someone's support,"},{"spoiler":false,"text":"However, she only shows this side of herself in front of the man she really loves, Choichiro."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57136"},{"segments":[{"spoiler":false,"text":"主人公の義母。36歳。"},{"spoiler":false,"text":"家事全般を完璧にこなす、時に優しく、時に厳しい理想の母親。"},{"spoiler":false,"text":"さらに床上手。"},{"spoiler":false,"text":"極度の寂しがり屋の彼女だが、そうした面を見せない気丈さを持つ。"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"2648","spoiler":false},{"segments":[{"spoiler":false,"text":"レジェン妻（ゲスト出演）"},{"spoiler":false,"text":"『人妻×人妻3』の主人公、桜庭航太郎の義理の母親で、最終的に彼と結ばれた。"},{"spoiler":false,"text":"現在は航太郎との間に生まれた子供、海人の母親。"},{"spoiler":false,"text":"航太郎は、現在海外の大学で経営を学んでおり、ちょっぴり寂しい。"},{"spoiler":false,"text":"「あっ、あらひのオッ、オ○ンコがっ……！！オ○ンコがっ、こわれちゃうぅぅ！！」"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"7533","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妻。"},{"spoiler":false,"text":"『人妻×人妻3～』では、最愛の夫・長一郎を亡くし、夫の残してくれたスーパー「サクラマート」を義理の息子である主人公と一緒に盛り立ててきた。"},{"spoiler":false,"text":"そうしたなか、主人公と愛が芽生え、そして結婚に至る。"},{"spoiler":false,"text":"家事全般を難なくこなす、優しさと厳しさを同居させる女性。"},{"spoiler":false,"text":"昼は聖母、夜は娼婦の如き卓越した性テクニックを持つ。"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","spoiler":false},{"segments":[{"spoiler":false,"text":"航太郎の義理の母親。"},{"spoiler":false,"text":"実母のみさ子とは幼なじみの間柄である。"},{"spoiler":false,"text":"なぎさが産まれた直後に連れあいを亡くし、悲嘆に暮れていた航太郎の父、長一郎と再婚。"},{"spoiler":false,"text":"以来、家業のスーパーを盛り立てつつ、兄弟三人の面倒を見て来た。"},{"spoiler":false,"text":"家事全般を完璧にこなし、時に優しく、時に厳しい理想の母親。"},{"spoiler":false,"text":"本当は、常に誰かの支えがないと生きていけない極度の寂しがり屋なのだが、"},{"spoiler":false,"text":"その一面を見せるのは本当に好きになった男・・・長一郎の前のみである。"}],"source":"bangumi","sourceCharacterId":"95225"}],"profileFacts":[{"label":"年龄（本版本）","value":"36 岁","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"2648","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6c8e92d90f49785d5e113dfd268607187d4efd0ecbf1a2e3a8bae4083b2bb4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d72be96a686d15bffe5ec1cdd769c44567930230555fa7bb6b3a3be95ec9dee.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅野るり","creatorId":"vndb:s1239","sourcePersonId":"vndb:s1239","canonicalEntityId":"vndb:s1239","name":"浅野 るり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229664:95225:3946:1","source":"bangumi"}]},{"characterId":"char_vndb_c57137","characterName":"桜庭 航太郎","sourceIds":{"vndbCharacterId":"c57137"},"originalCharacterName":"桜庭 航太郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this work."},{"spoiler":false,"text":"After his father dies in an accident, he leaves school and takes over the family business, Sakura Mart, a supermarket."},{"spoiler":false,"text":"The supermarket had been suffering from poor performance due to Kanayu's obstruction of business until then. He even quit the soccer club to help out."},{"spoiler":false,"text":"However, he has never complained about this, and is rather pleased to be able to support the family, even if it is only in a small way."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57137"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c57138","characterName":"桜庭 なぎさ","sourceIds":{"vndbCharacterId":"c57138"},"originalCharacterName":"桜庭 なぎさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koutarou's younger sister."},{"spoiler":false,"text":"When she was little, she was shy and followed her older brother around. At the time, her dream was to become her brother's wife."},{"spoiler":false,"text":"Now that she has grown up and has acquired a certain amount of social common sense, she does not mention such things, but it is still there in the back of her mind."},{"spoiler":false,"text":"In contrast to her childhood, she half unconsciously plays the role of a child full of energy who does not cry when she falls down."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57138"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cd344857d64ffd0c95ed58018a987372e50f7ef85419c290169907772b91e85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9aeb25c255670a9df4ceb76ccb5204759d2b5616405a57d9c455bd5fe810762.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊 るな","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21305","source":"vndb"}]},{"characterId":"char_vndb_c57139","characterName":"金城 清香","sourceIds":{"vndbCharacterId":"c57139"},"originalCharacterName":"金城 清香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Married for two years."},{"spoiler":false,"text":"Wife of Koutaruo's older brother, Taiyo, and youngest daughter of Mami Kaneshiro, president of Kaneyu Co."},{"spoiler":false,"text":"Since there are two older brothers above her, the succession is left to them, She was raised in a relaxed, easygoing, and calm manner."},{"spoiler":false,"text":"Perhaps because of this, she has never learned to doubt anyone, she innocently believes the words of Taiyo, who approached her for his own ambition."},{"spoiler":false,"text":"In fact, in less than two years of marriage, she has been betrayed many times. Even so, she never stops loving him, a spirit of endless generosity and charity."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57139"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d34f1ff4e9d1edd179714bc81edd16494f8219d440c41debfaf0c46050e1543.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb63b688577df33b625f27930d7080cd83c6d45098375cd769d9432791f084ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新出 千晶","creatorId":"vndb:s3657","sourcePersonId":"vndb:s3657","canonicalEntityId":"vndb:s3657","name":"新出 千晶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21308","source":"vndb"}]},{"characterId":"char_vndb_c57140","characterName":"月島 房江","sourceIds":{"vndbCharacterId":"c57140"},"originalCharacterName":"月島 房江","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"34"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koutarou's former homeroom teacher. she specializes in English. She has been married for a short time."},{"spoiler":false,"text":"Her grandmother is French, and she has perfect proportions, fair skin, chestnut hair, and steeple-colored eyes. In addition to her good looks, she is a dedicated educator and takes good care of her students. She is popular among both boys and girls."},{"spoiler":false,"text":"She has recently entered into an arranged marriage with a section chief of a certain trading company on the recommendation of her parents, which has sent many male students into a state of despair."},{"spoiler":false,"text":"According to her, it is a kind of filial piety. Her husband and parents have been telling her to quit her job as soon as possible,"},{"spoiler":false,"text":"But she has no intention to do so."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57140"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24549e1331bb8406dbf73102ef26e62981475c6c6c848fe84ad6b67b6bd80bbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27325e3795a894a45564e5ee5fc56d93b5b0db56651755fd3401aedfc9558200.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝霞 紫","creatorId":"vndb:s13050","sourcePersonId":"vndb:s13050","canonicalEntityId":"vndb:s13050","name":"朝霞 紫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21309","source":"vndb"}]},{"characterId":"char_vndb_c57141","characterName":"蓑輪 瞳子","sourceIds":{"vndbCharacterId":"c57141"},"originalCharacterName":"蓑輪 瞳子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"32"},"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"H"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has been married for 8 years and is a housewife."},{"spoiler":false,"text":"She is a former designer and for a while she continued to work after marriage. Both her parents and in-laws kept asking when she is going to have a baby, she could not win against their nagging and gave birth to her first child, Koutarou."},{"spoiler":false,"text":"Her husband was very supportive in the beginning, but as the months went by, his enthusiasm cooled down, now he leaves all the household chores, including childcare, to her."},{"spoiler":false,"text":"She also believes that her husband is having an affair."},{"spoiler":false,"text":"She is not too pessimistic about the situation and says, \"Well, I don't care what I have to do, as long as he brings home some money for Koutarou. However, if Koutarou's happiness is threatened, she turns into a demon."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f8d79ca5d6b74fb89dc968a857389c74d31c42a05491d019d0b5b19e9ed1870.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f176f11ae0bb9805b1fcfbb14ab26123267b8e95d48f084500a70d81108f38ed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高奈 ゆか","creatorId":"vndb:s492","sourcePersonId":"vndb:s492","canonicalEntityId":"vndb:s492","name":"高森 奈緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21304","source":"vndb"}]},{"characterId":"char_vndb_c57142","characterName":"鮎沢 澪","sourceIds":{"vndbCharacterId":"c57142"},"originalCharacterName":"鮎沢 澪","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"30"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Married for 5 years."},{"spoiler":false,"text":"She teases Koutarou."},{"spoiler":false,"text":"When she was caught shoplifting and asked why she is doing it, she says that it is because her husband is a drunk and has no income. This is complete lie. When asked why she lies, she answers, because of my parents I developed a habit of lying without realizing it (this is also a lie)."},{"spoiler":false,"text":"In fact, she is a married woman who married into the family of a Noh performer, and she is acting like this because of the stress of not being on the same page with her mother-in-law."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57142"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51610b64568340e817f2832cc7a7e50d3022bf287cf6a69b3244a5f00d6affdb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb3bb2a13d7a65274933d84ea0d859c033fdeb98509dab83cdd0172723d87ee4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉 さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21302","source":"vndb"}]},{"characterId":"char_vndb_c57143","characterName":"鷺ノ宮 世津","sourceIds":{"vndbCharacterId":"c57143"},"originalCharacterName":"鷺ノ宮 世津","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"46"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She lives alone with her elderly butler in a Western-style house on the outskirts of town."},{"spoiler":false,"text":"The Saginomiya family is a former samurai family, which fell into its usual decline following the Civil War, but they managed to eke out a living from their hidden private fortune, and for a time enjoyed a certain amount of prosperity, however, with the death of the previous head of the family, Kazumaro Saginomiya (Setsu's husband), the family is now quietly waiting for the end."},{"spoiler":false,"text":"Setsu is nostalgic for her former prosperity and the memory of her late master, It is a complete lie to say that Setsu is quietly living out the rest of her days with her old butler, Kondo... It is Setsu who is directly responsible for the breakup of the family."},{"spoiler":false,"text":"The reality that lurks behind the fragile exterior is a poisonous woman with a superb body, heavenly sexual skills, and a devilish brain."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57143"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6ecf4bfd3eb0c6606fd83ac093741c051c9f467680d874bca3815527ec2ed0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70dd11aef6f55a8ccf3d46da49c9491c4eed37a4b3e5c9d243a209b465fdce72.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c57144","characterName":"野乃 ハナ","sourceIds":{"vndbCharacterId":"c57144"},"originalCharacterName":"野乃 ハナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious peddler who sells fresh (and rare) ingredients directly from the production area."},{"spoiler":false,"text":"Her true identity is that of a descendant of the ninja, a group that has survived to this day in small numbers. However, there seems to be an ironclad rule that to let this fact be known is synonymous with death, She tries desperately to hide it. However, it is obvious that she has a shuriken in her hand."},{"spoiler":false,"text":"She looks young because of her superhuman physical training. And, by the way, she is married. She also knows various erotic ninja techniques as part of her espionage skills, and is a sex professional."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57144"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/345774b678548e71b59b9ff67ecf9ffe9cfde0a43cef0b43c9f456ac0d922093.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d0103ef988027aa703546c58fa14bad2b135edbfd10c726ae8485bb2353edb5.webp","width":213