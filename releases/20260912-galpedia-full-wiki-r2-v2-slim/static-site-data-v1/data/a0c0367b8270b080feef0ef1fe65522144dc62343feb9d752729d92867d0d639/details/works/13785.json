581","sourcePersonId":"vndb:s5581","canonicalEntityId":"vndb:s5581","name":"有限会社codeX","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45748","source":"vndb"},{"creditedName":"Mas Sawada","creatorId":"vndb:s12672","sourcePersonId":"vndb:s12672","canonicalEntityId":"vndb:s12672","name":"沢田昌孝","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45750","source":"vndb"},{"creditedName":"R/B2スタジオ","creatorId":"vndb:s26691","sourcePersonId":"vndb:s26691","canonicalEntityId":"vndb:s26691","name":"R/B2スタジオ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45751","source":"vndb"},{"creditedName":"Ben","creatorId":"vndb:s32287","sourcePersonId":"vndb:s32287","canonicalEntityId":"vndb:s32287","name":"Ben","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45752","source":"vndb"},{"creditedName":"株式会社ビジネスパートナー","creatorId":"vndb:s32292","sourcePersonId":"vndb:s32292","canonicalEntityId":"vndb:s32292","name":"株式会社ビジネスパートナー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45753","source":"vndb"},{"creditedName":"有限会社ロックンバナナ","creatorId":"vndb:s26686","sourcePersonId":"vndb:s26686","canonicalEntityId":"vndb:s26686","name":"ロックンバナナ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45754","source":"vndb"}]},"cast":[{"characterId":"char_c24907","characterName":"シサム＆キサラ","sourceIds":{"bangumi":[{"characterId":"12799","match":"exact-normalized-name-in-linked-work","subjectId":"13445"}],"egsCharacterIds":["12020"],"vndbCharacterId":"c24907"},"originalCharacterName":"シサム＆キサラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名はそれぞれ「シサム」「キサラ」。北海生まれの、一等航海士を二人でつとめる双子の姉妹。"},{"spoiler":false,"text":"二人で、というのは彼女達は常に相手の身体の一部と触れ合っていないと頭がおかしくなるという奇病に取り付かれており、離れる事ができないから。二人が一番落ち着く体勢は、背中合わせに密着した状態で、この体勢の彼女達は、高性能GPSシステム内蔵したような方向感覚と位置感覚を備える。"},{"spoiler":false,"text":"船員達の中でもまともな方ではあるが、密輸、かっぱらい、詐欺などの犯罪行為はいとわない。"},{"spoiler":false,"text":"やむなく離れる場合はお互いを命綱で結び合うが、これで持つのは三時間程度。"},{"spoiler":false,"text":"そろそろ連れ合いを見つけてとっととこの船から脱走したいなあ、とか漠然と願っている。"}],"source":"egs","sourceCharacterId":"12020","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"北海生まれの、一等航海士を二人でつとめる双子の姉妹。"},{"spoiler":false,"text":"二人で、というのは彼女たちが常に相手の身体の一部と触れ合っていないと頭がおかしくなるという奇病に取り付かれており、離れる事ができないから。"},{"spoiler":false,"text":"二人が一番落ち着く体勢は背中合わせに密着した状態で、この体勢の彼女たちは、高性能GPSシステムを内蔵したような方向感覚と位置感覚を備える。"},{"spoiler":false,"text":"船員たちの中でもまともなほうではあるが、密輸、かっぱらい、詐欺などの犯罪行為はいとわない。"},{"spoiler":false,"text":"「――どっちがシサムでキサラか当てて見せて？　当てたら一晩付き合うよ。外したら身ぐるみ剥ぐからね」"}],"source":"bangumi","sourceCharacterId":"12799"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/005e1be33f0032b3da0b3b773e5499ddd33c7d3ddb3a73445411b1222f82fe73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35986ede0035c9bc6d2575b78da35253e80eb26fb560aa0c63b78367840ec501.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"栗原雅子","creatorId":"vndb:s298","sourcePersonId":"vndb:s298","canonicalEntityId":"vndb:s298","name":"野月 まひる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13445:12799:6570:1","source":"bangumi"}]},{"characterId":"char_c24908","characterName":"クロ","sourceIds":{"bangumi":[{"characterId":"12798","match":"exact-normalized-name-in-linked-work","subjectId":"13445"}],"egsCharacterIds":["12018"],"vndbCharacterId":"c24908"},"originalCharacterName":"クロ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"嵐を呼ぶ船長という勇ましい触れ込みの、白子の痩せこけて目ばかりがぎょろぎょろ大きい小娘。"},{"spoiler":false,"text":"船長だと名乗りながら、普段はどうにもおつむが可哀相な状態にあり（思考能力が鈍化し、右と左も判らなくなるなど）、信天翁号の主だった面子は愚か、下級船員にまで馬鹿にされ、ストレス解消にしりとり遊びを強要されるは雑役にこき使われるはで、全く船長らしいところがない。"},{"spoiler":false,"text":"ところが気圧が大幅に下がると（たとえば大時化の前など）、脳の回路がかちんと繋がって、神がかった知性と掌握能力を見せるようになる。"},{"spoiler":false,"text":"その為信天翁号は他の船なら確実に沈むような大嵐などを切り抜けて今に至る訳だが、船員達は皆、船長のスイッチが入るから嵐になるのだと真逆に信じており、彼女が感謝されることは一切無い。"},{"spoiler":false,"text":"今度嵐を呼んだなら、宗右衛門の替わりにあんたを海にぶちこまんじまうぜとか脅されて本泣きになる。"},{"spoiler":false,"text":"でも本当は、みんな船長のことが大好きです。"},{"spoiler":false,"text":"漠然と、自分が何時でも賢くいられる、嵐が常時吹き荒れる海とかあればなあ、とか願っている。"}],"source":"egs","sourceCharacterId":"12018","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"嵐を呼ぶ船長という勇ましい触れ込みの、白子の痩せこけて目ばかりがぎょろぎょろ大きい小娘。"},{"spoiler":false,"text":"船長だと名乗りながら、普段はどうにもおつむが可哀相な状態にあり、全く船長らしいところがない。"},{"spoiler":false,"text":"ところが気圧が大幅に下がると、脳の回路がかちんと繋がって、神がかった知性と掌握能力を見せるようになる。"},{"spoiler":false,"text":"ところが船員達は皆、船長のスイッチが入るから嵐になるのだと真逆に信じており、彼女が感謝されることは一切無い。"},{"spoiler":false,"text":"「痛いのヤだよう。クロが嵐呼ぶんじゃないよう。ぶたないで蹴らないで、船から落とさないで」"}],"source":"bangumi","sourceCharacterId":"12798"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61e6a3f837f54081cdfeb324cb47a1a2fc9f857d4c7674e56418f833515a5c8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be50324a153aa36d13af89fd680c273c0bfedf58e0b7218149fa01c2ef7d183b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13445:12798:6106:1","source":"bangumi"}]},{"characterId":"char_c42844","characterName":"朔屋 直正","sourceIds":{"bangumi":[{"characterId":"12807","match":"exact-normalized-name-in-linked-work","subjectId":"13445"}],"egsCharacterIds":["12019"],"vndbCharacterId":"c42844"},"originalCharacterName":"朔屋 直正","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編の主人公。航海士達の色仕掛けに引っかかり、信天翁号に二等航海士として引きずりこまれる羽目になった、他の船員に比べれば比較的常識人だが、実は躁鬱の起伏激しい困りもので、躁状態時は無敵の海の男となり（ただし全く根拠のない自信なので、結局滅茶苦茶弱い）、鬱状態時には重力にさえ耐えかねて行動不能となる、鬱陶しい芋虫男となる。"},{"spoiler":false,"text":"一言でいってしまうと、助平で、臆病で、面倒くさがりで怠惰なダメ人間。"},{"spoiler":false,"text":"性的欲望に対してはストレートなタイプで、港に着くとひゃっほうとお茶屋（隠語）のお姉ちゃんと自由恋愛しに降りていく（婉曲的表現）。"},{"spoiler":false,"text":"しかし女の子より酒が好きで、優先順位は酒＞女の子となる。"},{"spoiler":false,"text":"信天翁号に乗りこんだ経緯はなし崩しだが、漠然と面白おかしく遊んで呑んで暮らせる国にいければいいなあ、この船はいろんな国に行くようだから、きっとそう言う国もあるに違いないとか駄目人間な願望を抱いている。"}],"source":"egs","sourceCharacterId":"12019","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"航海士たちの色仕掛けに引っかかり、信天翁号に二等航海士として引きずりこまれる羽目になった、"},{"spoiler":false,"text":"他の船員に比べれば比較的常識人だが、実は躁鬱の起伏激しい困りもので、躁状態時は無敵の海の男となり （ただし全く根拠のない自信なので、結局滅茶苦茶弱い）、鬱状態時には重力にさえ耐えかねて行動不能となる、鬱陶しい芋虫男となる。"},{"spoiler":false,"text":"一言で言ってしまうと、助平で、臆病で、面倒くさがりで怠惰なダメ人間。"},{"spoiler":false,"text":"「あああ堪忍してぇっ、その銭まで巻き上げられたら、明日のお酒呑めなくなっちゃうううっ」"}],"source":"bangumi","sourceCharacterId":"12807"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/812bd26ec8f2310f510134fdce2cdc851991d8255c47e38425bd73d00012abe2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/257bf3d8132c70da8485a645ccb0467ef316ebc3b9ed3a3799933cff98e471a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c42848","characterName":"彩久津 泪","sourceIds":{"bangumi":[{"characterId":"12800","match":"exact-normalized-name-in-linked-work","subjectId":"13445"}],"egsCharacterIds":["12021"],"vndbCharacterId":"c42848"},"originalCharacterName":"彩久津 泪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一体なにを血迷ったのか、わざわざ信天翁号を客船に選んで乗りこんできた女性。"},{"spoiler":false,"text":"主人公とは知己。仕草、動きが淑やかで、常に優雅なる怠惰に漂うてあるような貴族的な女で、船員達とは明らかに異なる人種の筈なのに、主人公はこの女がどうしても怖くてたまらない。"},{"spoiler":false,"text":"それは彼女が男を破滅させる類の美女であるからであり、主人公も彼女と初対面時、身に覚えのない痴情のもつれに巻き込まれ、一面識もない男から刺し殺されかかった事がある。それだけではなく、なにかある。きっとある。"},{"spoiler":false,"text":"こいつも絶対奇癖か奇病か異常体質の持ち主なのだ。なのにそれがわからない。"},{"spoiler":false,"text":"船員達も気づいていない。恐ろしい。判らないことが恐ろしい。ちなみに趣味はセックスとカードゲーム。"}],"source":"egs","sourceCharacterId":"12021","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"一体なにを血迷ったのか、わざわざ信天翁号を客船に選んで乗りこんできた女性。"},{"spoiler":false,"text":"主人公とは知己。"},{"spoiler":false,"text":"仕草、動きが淑やかで、常に優雅なる怠惰に漂う貴族的な女。船員たちとは明らかに異なる人種のはずなのに、主人公はこの女がどうしても怖くてたまらない。"},{"spoiler":false,"text":"それは彼女が男を破滅させる類の美女であるからであり、主人公も彼女と初対面時、身に覚えのない痴情のもつれに巻き込まれ、一面識もない男から刺し殺されかかった事がある。"},{"spoiler":false,"text":"趣味はセックスとカードゲーム。"},{"spoiler":false,"text":"「そうよ。その写真は、わたくしの夫『達』 のもの。今の人はええと……十三番目の夫です」"}],"source":"bangumi","sourceCharacterId":"12800"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a0fce96e21c3f27bccf4c0a46c670e6e655ca7f9a13ea43e1ff17dab5fec15a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6dcc97ce08dc6de7040bcfdfe89db10503e6f8342396d8562f17a6b01d39d9f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13445:12800:6019:1","source":"bangumi"}]},{"characterId":"char_c42856","characterName":"水夫長","sourceIds":{"bangumi":[{"characterId":"12801","match":"exact-normalized-name-in-linked-work","subjectId":"13445"}],"egsCharacterIds":["12022"],"vndbCharacterId":"c42856"},"originalCharacterName":"水夫長","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ボースン、掌帆長、とも。通称は「龍（ロン）の親爺」。"},{"spoiler":false,"text":"航海士に港の酒場から適当に水夫をさらってくるよう指示したのが彼。"},{"spoiler":false,"text":"四十がらみの屈強な、顔から肩にかけて龍のある悪鬼の如き異相の男で、顔に相応しい荒くれ者だが、活字中毒で一日一冊は本を読まないとたちまち幼児退行を起こす。"},{"spoiler":false,"text":"劇中では紙不足の時代に当たっており、仕方なくて一冊の本を何回も繰り返し読んでいたりする。"}],"source":"egs","sourceCharacterId":"12022","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"通称は 「龍 （ロン） の親爺」。"},{"spoiler":false,"text":"航海士に港の酒場から適当に水夫（主人公）をさらってくるよう指示したのが彼。"},{"spoiler":false,"text":"四十がらみの屈強な、顔から肩にかけて龍のある悪鬼の如き異相の男で、顔に相応しい荒くれ者だが、活字中毒で一日一冊は本を読まないとたちまち幼児退行を起こす。"},{"spoiler":false,"text":"「ところで貴様、なんでもいいから本を持っておらんか。一冊につき一時間休憩を増やしてやる」"}],"source":"bangumi","sourceCharacterId":"12801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc49ede58efcbb3983f2de99ea84cbdb936ef025c4f7578b91879543dd74fde7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2e8a429ef316096185769bdae1f276f526e5e2a6dd1ef9c883b3e63703ebd53.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c42862","characterName":"智里","sourceIds":{"bangumi":[{"characterId":"12803","match":"exact-normalized-name-in-linked-work","subjectId":"13445"},{"characterId":"12803","match":"exact-normalized-name-in-linked-work","subjectId":"86361"}],"egsCharacterIds":["3043"],"vndbCharacterId":"c42862"},"originalCharacterName":"智里","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公を追って、女客と共に船に乗りこんでいた殺し屋。"},{"spoiler":false,"text":"金田一耕助みたいな衣装の、日本人なのになぜか蒼い眸の優男だが、人には見えないモノが見えてしまっているせいで、喋る言葉が脈絡なく、かつ意味不明で、会話がろくに成り立たない。"},{"spoiler":false,"text":"機関長や宗右衛門とウマが合うらしく、よく三者でチェスや花札を打っている。"},{"spoiler":false,"text":"藤蔓で巻いた、居合い拵えの刀をぶら下げるときもある。"}],"source":"egs","sourceCharacterId":"3043","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"白い単衣の着物に袴を着崩し、雪駄ばきという何処の書生かというなりの青年。"},{"spoiler":false,"text":"整った顔立ちをしているのだが、どこか油断のできない鋭さと、人を食った諧謔を同居させる、朔屋の悪友。"},{"spoiler":false,"text":"藤蔓で巻いた、居合い拵えの刀をぶら下げるときもあり、尋常ならざる剣腕を見せる。"},{"spoiler":false,"text":"黒髪の日本人だが蒼い眸（伝奇、武侠小説で言う破邪の眸、浄眼である）を具え、人には見えないモノが見えてしまっているせいで、ときおり言葉に脈絡をなくし、かつ意味不明で、会話が成り立たなくなる時がある。"},{"spoiler":false,"text":"女子供にも分け隔てなく、そのひねくれた言行を示すため、居合わせた女性陣からは軒並み「最低」との言葉を賜る。"}],"source":"egs","sourceCharacterId":"3043","sourceWorkId":"19696","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公を追って、女客と共に船に乗りこんでいた殺し屋。"},{"spoiler":false,"text":"金田一耕助みたいな衣装の、日本人なのになぜか蒼い眸の優男だが、人には見えないモノが見えてしまっているせいで、喋る言葉が脈絡なく、かつ意味不明で、会話がろくに成り立たない。"},{"spoiler":false,"text":"機関長や宗右衛門とウマが合うらしく、よく三者でチェスや花札を打っている。"},{"spoiler":false,"text":"「お前ね。俺が言うのもアレなんだが、お前―――見事なまでのダメ人間だなあ」"}],"source":"bangumi","sourceCharacterId":"12803"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4ec4621e4b8fa083727c6c6f61d3fff6e01b188813ea1fcede1c2f606089535.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0f1615cf6b7c0aecbea568e12fd52b0b78fc0a58f164fc1e41cacf5ca3f38d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c42863","characterName":"密航者","sourceIds":{"bangumi":[{"characterId":"12804","match":"exact-normalized-name-in-linked-work","subjectId":"13445"}],"egsCharacterIds":["12024"],"vndbCharacterId":"c42863"},"originalCharacterName":"密航者","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"長い黒髪、黒目がちの綺麗な眸に白い肌の美少女にして、信天翁号の常連的密航者。"},{"spoiler":false,"text":"本人は毎回絶対この船だけには乗りこまないと密航者のくせして船を選り好みしつつも、何故か毎回毎回信天翁号に潜りこむ事になり、その都度船員達に締められては港に叩き帰されたり、簀巻きにされて捨てられたりしているのだが、気がつくとまた乗りこんでしまって彼女、船員双方ともにうんざりする羽目になる。"},{"spoiler":false,"text":"ただ本人は否定しているが、極めてアグレッシヴなマゾヒストであるため、適当に虐めてくれる信天翁号あたりがやはり似合いの船なのかも知れない。"},{"spoiler":false,"text":"彼女がそこまで密航に執着するのは、一つところに七日以上留まると精神異常を引き起こすという持病を有しているため、常に移動状態にある船舶が理想の居場所となるから。"},{"spoiler":false,"text":"なお正規乗船しないのは、そんなお金などこれっぽっちも持たないから。"}],"source":"egs","sourceCharacterId":"12024","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"信天翁号の常連密航者。"},{"spoiler":false,"text":"毎回絶対この船だけには乗りこまないと密航者のくせして船を選り好みしつつも、何故か信天翁号に潜りこむ事になり、その都度船員たちに締められては港に叩き帰されたり、簀巻きにされて捨てられたりしているのだが、気がつくとまた乗りこんでしまって彼女、船員双方ともにうんざりする羽目になる。"},{"spoiler":false,"text":"彼女がそこまで密航に執着するのは、一つところに七日以上留まると精神異常を引き起こすという持病を有しているため、常に移動状態にある船舶が理想の居場所となるから。"},{"spoiler":false,"text":"なお正規乗船しないのは、そんなお金などこれっぽっちも持たないから。"},{"spoiler":false,"text":"「ええと……なんでまたこの船なんだろう。今度こそはちゃんとしたお船を選んだつもりだったんだけど」"}],"source":"bangumi","sourceCharacterId":"12804"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5345c271ad6b6848e30726d71e4df15eeabef9ede0be302db52d9fe10b9deae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35a9dc5081740d0d78d80c745f73f5ea48cfea0aaa25ae8d0078f1ae203de6a3.webp","width":213,"height":25