s.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9611e3aab8a34181365270da4331782dcb95abd8bad0fd0164e1aa5eae77643.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三井京子","creatorId":"vndb:s10991","sourcePersonId":"vndb:s10991","canonicalEntityId":"vndb:s10991","name":"三井 京子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185493:47933:61559:1","source":"bangumi"}]},{"characterId":"char_c49775","characterName":"板野 奏","sourceIds":{"bangumi":[{"characterId":"47935","match":"exact-normalized-name-in-linked-work","subjectId":"185493"}],"egsCharacterIds":["12450"],"vndbCharacterId":"c49775"},"originalCharacterName":"板野 奏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious girl who suddenly transfers to the protagonist's class."}],"source":"vndb","sourceCharacterId":"c49775"},{"segments":[{"spoiler":false,"text":"彼女の放つ独特な雰囲気のせいかクラスメイトとも壁が出来てしまい、少し浮いた存在になってしまっている転校生。"},{"spoiler":false,"text":"しかし、本人は全く気にしていないようでブレずに生活をしている。真面目で勤勉ではあるが社会常識に欠けている部分も多く、たまに主人公たちを驚かせてくる。主人公とは隣の席で、麻帆が学園にやってきたことにより主人公に興味を持ち始める。"}],"source":"egs","sourceCharacterId":"12450","sourceWorkId":"23859","spoiler":false},{"segments":[{"spoiler":false,"text":"大人っぽく口数の少ない転校生。"},{"spoiler":false,"text":"その独特な雰囲気から、クラスでも少し浮いた存在になってしまっている。"},{"spoiler":false,"text":"まじめで勤勉だが社会常識に欠けている部分が多く、たまに主人公たちを驚かせる。"},{"spoiler":false,"text":"主人公とは隣の席で、麻帆が学園にやってきたことで主人公に興味を持ち始める。"},{"spoiler":false,"text":"「人が大切にすれば、モノもきっと応えてくれる」"}],"source":"bangumi","sourceCharacterId":"47935"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6caae36e95ffcb037c610fa44bf46a05d4b911ebac52315b63f0e97152d7bc1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98e3db3dc8b85da17b65aec390cd011f4cb144d8e961172eb66d2ef529d02b91.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井菜々絵","creatorId":"vndb:s6525","sourcePersonId":"vndb:s6525","canonicalEntityId":"vndb:s6525","name":"櫻井 菜々絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185493:47935:19126:1","source":"bangumi"}]},{"characterId":"char_c51505","characterName":"２号店","sourceIds":{"bangumi":[{"characterId":"47936","match":"exact-normalized-name-in-linked-work","subjectId":"185493"}],"egsCharacterIds":["12451"],"vndbCharacterId":"c51505"},"originalCharacterName":"２号店","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"AVマニアな兄のせいで周囲から誤解を受けているかわいそうな後輩。"},{"spoiler":false,"text":"感情がすぐ顔に出てしまうため、難しいことを考えると顔が怖いと言われることも。"},{"spoiler":false,"text":"元来の不器用な性格も災いし、常に怒っていると思われますます誤解されてしまう。"},{"spoiler":false,"text":"どこかヌケているが、根は優しい まじめ型不器用タイプ。"}],"source":"egs","sourceCharacterId":"12451","sourceWorkId":"23859","spoiler":false},{"segments":[{"spoiler":false,"text":"AVマニアな兄のせいで周囲から誤解を受けているかわいそうな後輩。"},{"spoiler":false,"text":"感情がすぐ顔に出てしまうため、難しいことを考えると顔が怖いと言われることも。"},{"spoiler":false,"text":"元来の不器用な性格も災いし、常に怒っていると思われますます誤解されてしまう。"},{"spoiler":false,"text":"どこかヌケているが、根は優しい まじめ型不器用タイプ。"},{"spoiler":false,"text":"「ほら、言いたいことがあるならさっさと全部吐き出しなさいよ！」"}],"source":"bangumi","sourceCharacterId":"47936"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fc5a8c3f99654d4aabc1900c1fded47928f464fc0ead742c049c7cb573f81d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccea7c21f98f453d9f0ad08630546abcb67cb48063230f89c6492462b2cc8dc1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185493:47936:6509:1","source":"bangumi"}]},{"characterId":"char_c51506","characterName":"王子様","sourceIds":{"bangumi":[{"characterId":"47937","match":"exact-normalized-name-in-linked-work","subjectId":"185493"}],"egsCharacterIds":["12452"],"vndbCharacterId":"c51506"},"originalCharacterName":"王子様","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A tomboyish junior student. She speaks in a fairytale-esque manner and is charming towards women, earning her the nickname of \"The Prince of Tekugamori Academy\"."}],"source":"vndb","sourceCharacterId":"c51506"},{"segments":[{"spoiler":false,"text":"入学早々女性を立てる振る舞いやメルヘンチックな台詞回しから『手倉森学園の王子様』という異名がついた後輩。明るく活発で初対面の人にも自分から話しかけていくタイプ。成績も比較的優秀で運動神経も抜群と非の打ち所もないが、純粋すぎる性格から一歩間違えれば間違った方向にも一直線に突っ走る危険性がある。主人公に対して同じ『王子様気質』を感じ、興味を持ち懐いてしまう。"}],"source":"egs","sourceCharacterId":"12452","sourceWorkId":"23859","spoiler":false},{"segments":[{"spoiler":false,"text":"女性を立てる振る舞いやメルヘンチックなセリフ回しから、王子様の異名を持つ後輩。"},{"spoiler":false,"text":"明るく活発で、初対面の人にも自分から話し掛けていくタイプ。"},{"spoiler":false,"text":"成績も比較的優秀で、運動神経も抜群と非の打ち所がない。"},{"spoiler":false,"text":"しかし純粋すぎる性格から、間違った方向にも一直線に突っ走る危険性がある。"},{"spoiler":false,"text":"主人公に自分と同じ “王子様気質” を感じ、興味を持ち懐いている。"},{"spoiler":false,"text":"「先輩と私は王子さまとしてライバル同士です！」"}],"source":"bangumi","sourceCharacterId":"47937"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/442d338b70c9fe6a0889224f2149f176589c3f0c63ebda325096657bd0ad7bad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8865c647998dcf0b4eaebbc13b9eb0c00541cc9b0c4102719a7b6037e94d7ee2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185493:47937:13372:1","source":"bangumi"}]},{"characterId":"char_c59562","characterName":"レゾナ","sourceIds":{"bangumi":[{"characterId":"52511","match":"exact-normalized-name-in-linked-work","subjectId":"185493"}],"egsCharacterIds":["12454"],"vndbCharacterId":"c59562"},"originalCharacterName":"レゾナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A personified oven with a motherly personality. She is very good at cooking."}],"source":"vndb","sourceCharacterId":"c59562"},{"segments":[{"spoiler":false,"text":"主人公の家のオーブンの擬人化した姿。お手軽料理から本格料理・冷蔵庫の余り物から作るお手軽料理など、料理に関しては右に出る物はいない。主人公の栄養状態も完璧に把握！"}],"source":"egs","sourceCharacterId":"12454","sourceWorkId":"23859","spoiler":false},{"segments":[{"spoiler":false,"text":"いつも忙しく見えるレゾナに何か出来ることはと聞く怜二。"},{"spoiler":false,"text":"レゾナが深夜にお願いしてきたのは、二人っきりで甘えさせてくれることだった。"},{"spoiler":false,"text":"深夜に甘えてくる密会は度々続き、膝の上に乗ってきたり、ハグをしてくるようになっていき、お昼の皆がいる前でも主人公とくっつくように。"},{"spoiler":false,"text":"どんどんレゾナの甘えん坊が全開になって……。"}],"source":"bangumi","sourceCharacterId":"52511"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a8d3b9ec6b3ccefc56668b693fbcfe85424aafa5096b2582ba863c715b3c21c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c52038f37a91b8ec2d5dd9da06fc702