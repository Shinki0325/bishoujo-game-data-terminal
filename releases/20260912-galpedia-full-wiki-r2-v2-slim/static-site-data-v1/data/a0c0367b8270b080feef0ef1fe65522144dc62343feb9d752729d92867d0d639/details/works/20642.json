":"no-alias-hit","relationId":"egs:work-creator:241607","source":"egs"},{"creditedName":"草壁祭(草香祭)","creatorId":"vndb:s402","sourcePersonId":"egs:creator:660","canonicalEntityId":"vndb:s402","name":"草壁祭(草香祭)","detail":"企画・構成","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242677","source":"egs"},{"creditedName":"茶坊主","creatorId":"egs:creator:37580","sourcePersonId":"egs:creator:37580","canonicalEntityId":"egs:creator:37580","name":"茶坊主","detail":"デスクトップアクセサリープログラム、音声データ編集","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:242889","source":"egs"},{"creditedName":"ひの","creatorId":"vndb:s37461","sourcePersonId":"egs:creator:37581","canonicalEntityId":"vndb:s37461","name":"ひの","detail":"企画・構成、ディレクション、スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242890","source":"egs"},{"creditedName":"二句トミィ","creatorId":"vndb:s37458","sourcePersonId":"egs:creator:37602","canonicalEntityId":"vndb:s37458","name":"二句トミィ","detail":"スクリプト、制作補助","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242972","source":"egs"},{"creditedName":"へび","creatorId":"vndb:s37459","sourcePersonId":"egs:creator:37605","canonicalEntityId":"vndb:s37459","name":"へび","detail":"制作補助","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242973","source":"egs"},{"creditedName":"多鷹りゆ","creatorId":"egs:creator:39570","sourcePersonId":"egs:creator:39570","canonicalEntityId":"egs:creator:39570","name":"多鷹りゆ","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:265733","source":"egs"},{"creditedName":"朝比奈あさひ","creatorId":"egs:creator:39621","sourcePersonId":"egs:creator:39621","canonicalEntityId":"egs:creator:39621","name":"朝比奈あさひ","detail":"スクリプト、制作補助","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:265740","source":"egs"},{"creditedName":"ヤヅチスエタ","creatorId":"vndb:s4275","sourcePersonId":"egs:creator:21132","canonicalEntityId":"vndb:s4275","name":"ヤヅチスエタ","detail":"SE制作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:265742","source":"egs"},{"creditedName":"オンリード","creatorId":"egs:creator:39622","sourcePersonId":"egs:creator:39622","canonicalEntityId":"egs:creator:39622","name":"オンリード","detail":"SE制作、音声収録","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:265744","source":"egs"},{"creditedName":"とこ","creatorId":"vndb:s37457","sourcePersonId":"egs:creator:39726","canonicalEntityId":"vndb:s37457","name":"とこ","detail":"グラフィック、システムCG","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:266954","source":"egs"},{"creditedName":"御剣ヒロ","creatorId":"vndb:s3701","sourcePersonId":"egs:creator:13078","canonicalEntityId":"vndb:s3701","name":"御剣ヒロ","detail":"スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:266955","source":"egs"},{"creditedName":"聖弱音珍学校ハリウッド","creatorId":"egs:creator:39727","sourcePersonId":"egs:creator:39727","canonicalEntityId":"egs:creator:39727","name":"聖弱音珍学校ハリウッド","detail":"テストプレイ","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:266956","source":"egs"},{"creditedName":"VAC creative","creatorId":"egs:creator:39728","sourcePersonId":"egs:creator:39728","canonicalEntityId":"egs:creator:39728","name":"VAC creative","detail":"パッケージ・印刷物デザイン","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:266957","source":"egs"},{"creditedName":"株式会社デジタルハーツ","creatorId":"vndb:s26171","sourcePersonId":"vndb:s26171","canonicalEntityId":"vndb:s26171","name":"株式会社デジタルハーツ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:75633","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c18377","characterName":"マイケル・レヴィ","sourceIds":{"vndbCharacterId":"c18377"},"originalCharacterName":"マイケル・レヴィ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"929"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Why didn’t God save them?! Where was His helping hand?!\""},{"spoiler":false,"text":"Brought up by a loving working-class family, as the son of a faithful pastor. His family consists of his father, mother, younger twin brother, and younger sister. He attends a boarding school seminary (his father’s alma mater) and spends his days in prayer and study in hopes of becoming part of the clergy. He has excellent grades and strong faith, and serves as his grade’s prefect in charge of overseeing other students. He’s an honors student, but still has a strong sense of justice and won’t back down in the face of upperclassmen. He used to be rather rowdy, but became quite well-behaved after being appointed prefect. After the incident, he loses his faith and his interest in studying. He shuns God and openly shows his resentment instead of smiling. In his single-minded drive to discover the truth, he tolerates school life despite it feeling like grinding sand between his teeth."},{"spoiler":false,"text":"From the official website. Translated by Shiroxkagami."}],"source":"vndb","sourceCharacterId":"c18377"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f893fbddac5ca3d1bb7117bfc685b01009e00c40e8557e1d0b86b3148896a74f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03b726065ea774ef12698a72f4397f2a4ea002bf146ba7fbfd1d53a3f807c643.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"東城 直樹","creatorId":"vndb:s387","sourcePersonId":"vndb:s387","canonicalEntityId":"vndb:s387","name":"宮田 幸季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42361","source":"vndb"}]},{"characterId":"char_vndb_c18378","characterName":"ガブリエル・レヴィ","sourceIds":{"vndbCharacterId":"c18378"},"originalCharacterName":"ガブリエル・レヴィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"929"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Wherever you go is wherever I belong, Michael. We’re twins, right?\""},{"spoiler":false,"text":"His facial features and height are identical to Michael’s. Their personalities, however, are exact opposites – he’s childish, mischievous, and easily distracted. He has a hard time concentrating on a single thing and is often found wandering around aimlessly. He’s also fairly optimistic and positive. After the incident, he worries for Michael after seeing his loss of faith in God, and encourages Michael to stay positive. He’s very talkative in front of Michael, but is extremely shy and easily embarrassed in front of other people. He has a knack for giving things odd nicknames."},{"spoiler":false,"text":"From the official website. Translated by Shiroxkagami."}],"source":"vndb","sourceCharacterId":"c18378"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ef21e1a6b61058c42a57492e856768babdc81497b76b5fc36e152ddb73f94c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/131f62e26a91df399bd25533626d2a5df2835e660f2bf3bceea4dc474ba57e39.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"東城 直樹","creatorId":"vndb:s387","sourcePersonId":"vndb:s387","canonicalEntityId":"vndb:s387","name":"宮田 幸季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42362","source":"vndb"}]},{"characterId":"char_vndb_c18379","characterName":"セシル・カワード","sourceIds":{"vndbCharacterId":"c18379"},"originalCharacterName":"セシル・カワード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"212"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You may not know this, but I could never hate you. No matter what happens.\""},{"spoiler":false,"text":"Michael’s best friend, roommate, and classmate. He’s quiet and shy, and will never raise his voice or be antagonistic towards anyone. When other kids are being mischievous, he’ll always smile along with them. However, he is strong at the core and very sound of mind. He has flowing chestnut hair and green eyes, and is a faithful believer in God. He is part of the choir, and has a beautiful voice. It’s said that he resembles the angels depicted in religious paintings. For whatever reason, he doesn’t talk about his family or his life before he came to school."},{"spoiler":false,"text":"From the official website. Translated by Shiroxkagami."}],"source":"vndb","sourceCharacterId":"c18379"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2120b1dd2f81569e40729b27db2652543b7d270820325d02bce8979947029122.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feef8fce445d7b4fdd5ebcf04135a207f3a3ac32a46f40feb3168ba580cd251a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"空乃 太陽","creatorId":"vndb:s88","sourcePersonId":"vndb:s88","canonicalEntityId":"vndb:s88","name":"岸尾 だいすけ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42359","source":"vndb"}]},{"characterId":"char_vndb_c18380","characterName":"ニール・ローウェル","sourceIds":{"vndbCharacterId":"c18380"},"originalCharacterName":"ニール・ローウェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1219"},"height":{"reviewState":"source-only","source":"vndb","value":"187"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Well as they say, what they don’t know can’t hurt ‘em. Number one motto of the Lowell family.\""},{"spoiler":false,"text":"A 6th year student and notorious playboy and delinquent. Has the audacity to smoke on school grounds, and is rumored to frequent bars and other shady areas in town. A misfit for a seminary. Why he doesn’t get expelled is said to be one of the school’s seven wonders. With wild red hair and eyes clear as the sky, he could pass for a handsome Latin American. He always brings up the Lowell family mottoes in his conversations like they’re golden rules of thumb. He’s also good at magic tricks."},{"spoiler":false,"text":"From the official website. Translated by Shiroxkagami."}],"source":"vndb","sourceCharacterId":"c18380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0346aa5f77c868d662651a8ca04146ef73cc8636a389e07c3a4608798373942e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/759804e9893e9cc92882ebc6f9b9f030440d483f4eab5fff46c63f432e077a80.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"スモール 佐藤","creatorId":"vndb:s376","sourcePersonId":"vndb:s376","canonicalEntityId":"vndb:s376","name":"鈴木 達央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42360","source":"vndb"}]},{"characterId":"char_vndb_c18381","characterName":"レオニード・オーウェン","sourceIds":{"vndbCharacterId":"c18381"},"originalCharacterName":"レオニード・オーウェン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"904"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"If you’re lying, then I don’t think I could forgive you.\""},{"spoiler":false,"text":"A 6th year student and senior prefect who governs over the student body. Students who excel in studies, conduct, and character are appointed prefects for their grade, but the senior prefect has authority over all of them. He is given the right to punish other students, and is most certainly in the elite class. His grades of course are perfect, and he’s consistently at the top of his class. Taciturn and prideful, he can be eloquent when he needs to but otherwise barely speaks a word. He has an air about him that makes him difficult to approach. The underclassmen treat him with fear and awe, like a god or an emperor. He is the descendant of a fallen noble who fled from Russia. He has long silver hair and ice blue eyes to go along with his good looks."},{"spoiler":false,"text":"From the official website. Translated by Shiroxkagami."}],"source":"vndb","sourceCharacterId":"c18381"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2abf72a1080ac09bfa442ffa3b340855f20e34bf748986f7ffec81189c25b14c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7db7e20a201add82e3892ce774acd38bfe438a429f9eb6805c7106f467ec56aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷河流","creatorId":"vndb:s73","sourcePersonId":"vndb:s73","canonicalEntityId":"vndb:s73","name":"緑川 光","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42358","source":"vndb"}]},{"characterId":"char_vndb_c18382","characterName":"オーガスト・マクラウド","sourceIds":{"vndbCharacterId":"c18382"},"originalCharacterName":"オーガスト・マクラウド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"606"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Oh, you laughed! It’s been a while since I’ve seen you smile.\""},{"spoiler":false,"text":"An easy-going and friendly priest. His personality sets him apart from most other teachers who are very strict about discipline. He teaches Latin. He has gentle eyes and a playful smile, and likes to crack jokes to get everyone to laugh. He more or less lets kids off the hook when they break the rules, so they appreciate his presence. He enjoys playing football with the students and is more of a brotherly figure to them than a teacher. He gets along well with the serious Father Lazarus, even though they are quite far apart in age. When Michael returns to school following the loss of his family, August occasionally offers Michael counsel."},{"spoiler":false,"text":"From the official website. Translated by Shiroxkagami."}],"source":"vndb","sourceCharacterId":"c18382"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7461b234fe8a3034dc727f89c07b9ebf6f6598e2c8861f3dead7a25ee338651c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2718b977720670808532eed31def8f38babbe83e11c3c8505db163440010814a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青島 刃","creatorId":"vndb:s179","sourcePersonId":"vndb:s179","canonicalEntityId":"vndb:s179","name":"成田剣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42357","source":"vndb"}]},{"characterId":"char_vndb_c26327","characterName":"アベル・ステイプルトン","sourceIds":{"vndbCharacterId":"c26327"},"originalCharacterName":"アベル・ステイプルトン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1102"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Our glory be to God.\""},{"spoiler":false,"text":"A small and delicate 2nd year student, who still has an innocent childlike air about him. He's something like the school's little idol due to his quiet and adorable nature. He's especially popular with the upperclassmen, and often invited to the \"tea parties\" that the younger students dream to attend. He also assists with altar service during worships."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c26327"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94cde8da2eb59764cad7981e56ce7a886165d074bd7e6c57201083e3b8226a45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31436b09c4efe31d2144dbd7caed9030db3705b15c53d1d3decb27acccbf2520.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夕凪 孝","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42364","source":"vndb"}]},{"characterId":"char_vndb_c70766","characterName":"ネヴィル・C・コール","sourceIds":{"vndbCharacterId":"c70766"},"originalCharacterName":"ネヴィル・C・コール","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Discipline yourselves! Shun desire and preserve purity!\""},{"spoiler":false,"text":"The principal of St. John's Seminary. An exceptionally brilliant scholar who was appointed principal at a young age. He's terrifyingly strict and doesn't overlook a breach in discipline. Being a fierce advocate in corporal punishment, he punishes students for even the slightest mistake with spankings and confinement in the reflection room, and is considered a fearsome figure. He’s especially obsessive about abstinence, going to great lengths to make sure the students maintain their chastity and purity."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c70766"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30a84fcdc0e69de39fbf75f649a093a931630b3889afce42454749ad05640a51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d831e07c7a0e99bce523889b991fd2fbf41eda43e4dbaee4dd367f0957d47c5f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c71086","characterName":"ラザラス・ヘイグ","sourceIds":{"vndbCharacterId":"c71086"},"originalCharacterName":"ラザラス・ヘイグ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Everyone has the potential to become a fine tree.\""},{"spoiler":false,"text":"A priest at St. John's Seminary. He teaches pastoral theology. One of the oldest teachers. He's a very caring and compassionate man who patiently listens to any stories and never raises his voice or gives orders in a haughty manner. He's close friends with Father August despite their great difference in age, and they are often seen walking around together."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c71086"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79ad72e5cef26eaf47fd8d97ecf513ecf5480df164bc88292f81d205817a4106.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/6063e69c9f497988342a82ebad823a01349b03d376f118242fadbe15533a2c68.webp","width":219,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c71087","characterName":"ジャック・ホッブス","sourceIds":{"vndbCharacterId":"c71087"},"originalCharacterName":"ジャック・ホッブス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hahaha, come on, Matchstick, try to get it back! Look over here!!\""},{"spoiler":false,"text":"A 4th year student and Michael's roommate, who cohabitates with him in a six-person dorm room. He's cynical and unpleasant. He's specifically mean towards Cecil for some reason, calling him Matchstick (due to his skinny body and round head) at every chance he gets and picking on him in other ways. He also treats Benjamin, their chubby roommate, like a lackey. Despite that, he doesn't seem like a bad person at heart."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c71087"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb57725600f4c3ad12acf2bc416be127e5d86f946dabb5d1e626f988aac6c2fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/621d3c16945229d94461959ec7c23053a5f50cd8a8f4551c6fc4c69150d22854.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c71088","characterName":"ロバート・キャラハン","sourceIds":{"vndbCharacterId":"c71088"},"originalCharacterName":"ロバート・キャラハン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"See ya in the new year. Don't get out of shape, Ace Striker!\""},{"spoiler":false,"text":"A 4th year student and one of Michael's roommates. He used to be the prefect throughout his junior student days up until Michael took over the role. He's handsome and excels in both his studies and in sports. Has a strong sense of justice and speaks his mind without hesitation. Best friends with the quiet Joshua."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c71088"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b330f95a34d78f37ee526c366a292cbcf76fe515ece3e427c1a838391e54363.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b91b29d0bfdb6c944d8d155fc41956a4a705c19aa7eb3a9fc3835c5c8f10fd60.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河村 眞人","creatorId":"vndb:s457","sourcePersonId":"vndb:s457","canonicalEntityId":"vndb:s457","name":"山中 真尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42365","source":"vndb"}]},{"characterId":"char_vndb_c71089","characterName":"ジョシュア・クリフォード","sourceIds":{"vndbCharacterId":"c71089"},"originalCharacterName":"ジョシュア・クリフォード","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"What an awful situation. My condolences.\""},{"spoiler":false,"text":"A 4th year student and one of Michael's roommates. He doesn't talk much. He's an indoor type who loves to read. Prefers to be the referee during football matches since he's not good at sports. He's best friends with Robert, who's an outdoorsy type."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c71089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/205d7208f89bc4e45f8930724987e15027f2125cb7865d2d85c44fc5c7ec254f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf1673892de0864a098ca0651d8b3f79b2a3443169e78491d6ff70bfd6b02250.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蒼葉 優","crea