{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7671","model":{"presentationWorkId":"vndb:v282","staff":{"artwork":[{"creditedName":"天野雨乃(あまのあめの)","creatorId":"vndb:s3719","sourcePersonId":"egs:creator:1810","canonicalEntityId":"vndb:s3719","name":"天野雨乃(あまのあめの)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17796","source":"egs"}],"scenario":[{"creditedName":"有巻洋太","creatorId":"vndb:s2713","sourcePersonId":"egs:creator:2673","canonicalEntityId":"vndb:s2713","name":"有巻洋太","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17797","source":"egs"}],"music":[{"creditedName":"ミリオンバンブー","creatorId":"vndb:s1435","sourcePersonId":"vndb:s1435","canonicalEntityId":"vndb:s1435","name":"ミリオンバンブー","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:7551","source":"vndb"}],"other":[{"creditedName":"楠 ゆういち","creatorId":"vndb:s3558","sourcePersonId":"vndb:s3558","canonicalEntityId":"vndb:s3558","name":"楠 ゆういち","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:7553","source":"vndb"}]},"cast":[{"characterId":"char_c48812","characterName":"奥寺 響子","sourceIds":{"bangumi":[{"characterId":"220101","match":"exact-normalized-name-in-linked-work","subjectId":"280209"}],"egsCharacterIds":["25511"],"vndbCharacterId":"c48812"},"originalCharacterName":"奥寺 響子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman who claims to be the protagonist's real mother. In the past, she gave up the protagonist for unavoidable reasons, but after the death of his father, Shigehisa, she visits the Tachibana family to take the protagonist in as her only living relative."},{"spoiler":false,"text":"She has a deep affection and a calm and gentle personality. She is a cock lover and has a maternal instinct that is stronger than others. She is currently working at a daycare."},{"spoiler":false,"text":"She feels deeply guilty for having abandoned the protagonist, and because she is unable to be happy on her own, she has never had a family with another man and is still single."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c48812"},{"segments":[{"spoiler":false,"text":"情が深く、母性本能に満ち溢れた主人公の実の母。"},{"spoiler":false,"text":"年齢は30代半ばだが、外見は20代後半でも充分に通用するほど。"},{"spoiler":false,"text":"主人公を手放した以後、他の男と関係を持つこともなく、その熟れた肉体を封印していた。"},{"spoiler":false,"text":"今回主人公との情事によって封印が解かれ、"},{"spoiler":false,"text":"秘められたアナル感覚をも開発されていく。"}],"source":"egs","sourceCharacterId":"25511","sourceWorkId":"7671","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の実の母親を名乗る女性。"},{"spoiler":false,"text":"過去にやむを得ない理由から主人公を手放したが、父親である繁久の死後、唯一の肉親として主人公を引き取ろうと橘家を訪れる。"},{"spoiler":false,"text":"情が深く、おっとりと穏やかな性格。子供好きで母性本能は人一倍強い。"},{"spoiler":false,"text":"現在は、保母の仕事をしている。"},{"spoiler":false,"text":"結果的に主人公を捨ててしまったことに対して深い罪悪感を持っており、自分だけ幸せになることが出来ずに他の男と家庭を持つことなく過ごしてきたため、未だに独身。"}],"source":"bangumi","sourceCharacterId":"220101"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46664b23cfb6b454ab05e7a1a87373229282ff3432bd5a6434591d95fdfe9ff1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/980398bece4143d509da18a4c0f5c4842bf64c64b0989871873886594b4e0387.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:280209:220101:4940:1","source":"bangumi"}]},{"characterId":"char_c48813","characterName":"橘 みゆき","sourceIds":{"bangumi":[{"characterId":"220102","match":"exact-normalized-name-in-linked-work","subjectId":"280209"}],"egsCharacterIds":["25512"],"vndbCharacterId":"c48813"},"originalCharacterName":"橘 みゆき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's stepmother. She is a well-bred \"young lady\" type mother. After the death of her husband, in her moment of weaknes is forced into an immoral relationship with the protagonist."},{"spoiler":false,"text":"She comes from a good family and is gentle and honest, but also quiet and timid. Because she is his stepmother, she is somewhat reserved towards him. She tends to be dependent on others who are decisive and dynamic, whether because of her good upbringing or because of her natural timidity. There is a part of her that is dependent on the protagonist who tries to dominate her."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c48813"},{"segments":[{"spoiler":false,"text":"主人公の義母。"},{"spoiler":false,"text":"年齢は20代後半ながら実年齢よりも若く見られ、主人公の姉と言っても通用するほど若々しい。"},{"spoiler":false,"text":"優しく素直ながら極めて気弱な性格で、主人公への依存度が高い。"},{"spoiler":false,"text":"清楚で大人しい彼女だが、敏感なアナル感覚の持ち主で、主人公にアナルの快感を目覚めさせられてから、その虜に……。"}],"source":"egs","sourceCharacterId":"25512","sourceWorkId":"7671","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義理の母親。育ちのいい「お嬢様」タイプの母親。"},{"spoiler":false,"text":"夫の死後、主人公に弱みを握られ、無理矢理押し切られる形で背徳的な関係を持ってしまう。"},{"spoiler":false,"text":"良家の出身らしく、優しく素直ながらも大人しく気弱な性格。義理の母ということからどことなく主人公に遠慮している。"},{"spoiler":false,"text":"また育ちの良さゆえか、それとも生来の気の弱さからか、決断力や行動力のある相手に依存する傾向があり、"},{"spoiler":false,"text":"現在では「義理の息子と関係してしまうなんて……」と思い悩みつつも、心のどこかで自分を支配しようとする主人公に依存している部分がある。"}],"source":"bangumi","sourceCharacterId":"220102"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bcc6a5af90bcc75bdc88d1757811de4f6ab666e2525ca4052ce0856f80bb1fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cba015341a63dd94c1c34c8d615e42ec344d2b34da3b6fd543c2a5dd3631003d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:280209:220102:6409:1","source":"bangumi"}]},{"characterId":"char_vndb_c2510","characterName":"橘 圭一","sourceIds":{"vndbCharacterId":"c2510"},"originalCharacterName":"橘 圭一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a student at an elite school. His father, Shigehisa, was a wealthy man who died a month ago, and he now lives with his stepmother, Miyuki."},{"spoiler":false,"text":"After Shigehisa's death, he somewhat coerced Miyuki into a relationship, whom he had wanted for a long time."},{"spoiler":false,"text":"He is a thin, beautiful boy, and his way of speaking is a bit effeminate, but inside he is cunning and calculating, and he is good at gaining insight into his opponents' psychology and taking advantage of their weaknesses."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c2510"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1953","sourceCompanyId":"egs:brand:1773","canonicalEntityId":"vndb:p1953","name":"BLACK PACKAGE TRY","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationI