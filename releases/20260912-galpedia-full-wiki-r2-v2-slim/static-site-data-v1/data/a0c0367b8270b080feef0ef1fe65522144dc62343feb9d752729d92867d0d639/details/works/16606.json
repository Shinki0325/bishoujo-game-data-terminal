st":[{"characterId":"char_vndb_c196","characterName":"右代宮 戦人","sourceIds":{"vndbCharacterId":"c196"},"originalCharacterName":"右代宮 戦人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"715"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Battler is Rudolf's son. Although stubborn and hotheaded, he is a very compassionate young man. He tends to flirt with young women and has a perpetual fear of \"shaky\" transportation, thinking he may fall out of a plane or boat depending on the turbulence."},{"spoiler":false,"text":"Due to his father's remarriage, Battler rebelled and went to live with his maternal grandparents for the next six years, cutting all ties to the Ushiromiya family. After his grandparents' deaths, he returned to his family, though he had not fully reconciled with his father."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c196"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3af7f8f01cccdc48719d02e5e4aa4866781d3fc4da937628ac06f478b6619388.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc8d350c34eca712e872b309c94b9c2d7520ba0c5b22e771f0bde2e26067de40.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c197","characterName":"右代宮 朱志香","sourceIds":{"vndbCharacterId":"c197"},"originalCharacterName":"右代宮 朱志香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"825"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Krauss and Natsuhi's daughter. Although Jessica is the heiress of the Ushiromiya family after her father, she is an energetic and tomboyish young woman who lacks the more refined behavior expected of such a role. Due to her rebellious nature, she is resentful of her parents for the pressures they place on her regarding the family headship, but still shows concern for them."},{"spoiler":false,"text":"She has a habit of faking asthma attacks as a means of escaping from tense situations. She has a crush on the servant Kanon."},{"spoiler":false,"text":"She is also proficient in the use of brass knuckles."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c197"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11886aa1c2e074d0a1278497c93b7b9dd7c99caa6a871eb3a2f8f4c25a0e4ed9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b3a6f189a9e6acf5bf5afed1d2fb791e45d16fc2e5c710b051d3b8fb4ae20d1.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p82","sourceCompanyId":"egs:brand:1228","canonicalEntityId":"vndb:p82","name":"07th Expansion","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:16606:1228","source":"egs"},{"companyId":"vndb:p15667","sourceCompanyId":"vndb:p15667","canonicalEntityId":"vndb:p15667","name":"Lancher","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107095:v9047","source":"vndb"},{"companyId":"vndb:p82","sourceCompanyId":"vndb:p82","canonicalEntityId":"vndb:p82","name":"07th Expansion","roleCodes":[