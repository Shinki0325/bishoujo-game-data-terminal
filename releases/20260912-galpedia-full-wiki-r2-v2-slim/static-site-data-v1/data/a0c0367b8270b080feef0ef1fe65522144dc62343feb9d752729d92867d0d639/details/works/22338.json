bel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:155259","source":"egs"},{"creditedName":"koishi","creatorId":"vndb:s2780","sourcePersonId":"vndb:s2780","canonicalEntityId":"vndb:s2780","name":"大石 憲一郎","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:125326","source":"vndb"}],"other":[{"creditedName":"御垳葉 ひかる","creatorId":"vndb:s6936","sourcePersonId":"vndb:s6936","canonicalEntityId":"vndb:s6936","name":"御垳葉 ひかる","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:125328","source":"vndb"},{"creditedName":"御垳葉 ひかる","creatorId":"vndb:s6936","sourcePersonId":"vndb:s6936","canonicalEntityId":"vndb:s6936","name":"御垳葉 ひかる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125329","source":"vndb"}]},"cast":[{"characterId":"char_c135635","characterName":"ユピテル","sourceIds":{"bangumi":[],"egsCharacterIds":["17511"],"vndbCharacterId":"c135635"},"originalCharacterName":"ユピテル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuno's fiancée. He is considered to be the next king because he is a man of sufficient capabilities, but he does not possess as much appeal as Yuno, the king's daughter. He thus remains in Thracia to protect her during the war expedition."},{"spoiler":false,"text":"He is calm and mild-mannered, and has no malicious attitude toward Voldo. He is also a skilled swordsman, and no soldier can match his caliber of skill."},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c135635"},{"segments":[{"spoiler":false,"text":"天界の主神。"}],"source":"egs","sourceCharacterId":"17511","sourceWorkId":"25607","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96769759aa6b31235aedd3e72d6bded562b96a23891104bfe79d5c68ad662531.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/871a17d9f87c009fef6bbc11ac6196e4432b870f95f386977c99c512972ce373.webp","width":167,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c135634","characterName":"アーレス","sourceIds":{"vndbCharacterId":"c135634"},"originalCharacterName":"アーレス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the best swordsman in the kingdom and Minerva's husband. Although he is a skilled swordsman, he is not a strategist. He gives up his position as general to Minerva and solely on focus being a warrior."},{"spoiler":false,"text":"Because of his abilities and his position as a warrior, he is assigned to defend the Thracian kingdom during this expedition."},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c135634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ef6e22b1ed06339bd12060961cab78971fa3b2442cbb96128b145ac3ae846bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59b6d265366a9f06f1ba879b18640f37a824092dedcdf918f190426a2bfe0de1.webp","width":180,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c135636","characterName":"ヴォルド","sourceIds":{"vndbCharacterId":"c135636"},"originalCharacterName":"ヴォルド","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An alchemist who suddenly appeared in Thracia several years ago. He has achieved great success with his despicable operations, such as mixing poison in river water and using animals as bombs."},{"spoiler":false,"text":"He has risen through the ranks to become the kingdom's official alchemist and has succeeded in gaining the position of chief of staff for this ongoing expedition."},{"spoiler":false,"text":"Translated from Official site"}],"source":"vndb","sourceCharacterId":"c135636"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b235accc04eba1b019ad034940df8bc54c2bb3ace4970883458c0f2eaa7c3320.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6470bf74c6ac57f60edf77496d11a0d5ec304c6b00e0566aaa5bb664292aa9d7.webp","width":181,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c38526","characterName":"ユーノ","sourceIds":{"vndbCharacterId":"c38526"},"originalCharacterName":"ユーノ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A blonde, dignified, and strong-willed princess of Thracia, she is said to have the purest and most beautiful heart in the kingdom."},{"spoiler":false,"text":"As the symbol of the Thracian army, she personally takes up arms and goes to the front lines to command the soldiers. Although she is a member of the royal family, she does not abuse her position and treats everyone equally, making her an idol among the soldiers."},{"spoiler":false,"text":"She is also a skilled spearman, and her spear technique, which was handed down directly from the royal family, wields a ferocious power. She is a virgin."},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c38526"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/149ab83560a08111c8a315e3aa27188f6777d62721a4c5bc2d5552dbda191b03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be31c406e6f6b79ba1fb0c5a9fdc3723a3765047dc80128aa9f4b62c57c1bfb0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ありかわ 真奈","creatorId":"vndb:s5761","sourcePersonId":"vndb:s5761","canonicalEntityId":"vndb:s5761","name":"ありかわ真奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66834","source":"vndb"}]},{"characterId":"char_vndb_c38527","characterName":"ミネルヴァ","sourceIds":{"vndbCharacterId":"c38527"},"originalCharacterName":"ミネルヴァ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A rough, silver-haired female general who is said to be the best warrior in Thracia. She is feared by her subordinates for her extremely strict character, both towards herself and others."},{"spoiler":false,"text":"She clashes with Voldo whenever she meets him, as she is psychologically incompatible with Voldo, who prefers the sneaky way of doing things, where results mean everything."},{"spoiler":false,"text":"She is the daughter of a prominent family that is on the verge of collapse, and is eager to rebuild her family name. She is the wife of Ares. She promises her husband that they will have children when they return."},{"spoiler":false,"text":"Translated from Official site"}],"source":"vndb","sourceCharacterId":"c38527"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff