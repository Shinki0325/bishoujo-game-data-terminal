oiler":false,"text":"高度な治癒魔術は奴隷となった今も衰えておらず、調教過程で傷を負ったエリシアの治癒したり、処女膜再生の秘術等を用いて調教に参加する。"},{"spoiler":false,"text":"強い意志を持つ心優しい女性だったが、現在は身も心もガルドに心酔しきり、妹のような存在であったエリシアに対しても冷酷な姿を見せる。"},{"spoiler":false,"text":"「ガルド様をお慕いして、早く立派な性奴隷におなりなさい」"}],"source":"bangumi","sourceCharacterId":"61607"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"19821","sourceWorkId":"9534","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"19821","sourceWorkId":"9534","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"19821","sourceWorkId":"9534","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"19821","sourceWorkId":"9534","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"56 kg","valueContext":null,"source":"egs","sourceCharacterId":"19821","sourceWorkId":"9534","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11afc2ff66f81ca9705709a37f6b8cb0c9cbc6856e324ea030a3897e9b93bb34.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/add5367c475d4dceefab4075cb4ca72fcb8151e2b87fcbaa9f40fa38f8def458.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:240071:61607:13512:1","source":"bangumi"}]},{"characterId":"char_c75886","characterName":"イリーナ","sourceIds":{"bangumi":[{"characterId":"61608","match":"exact-normalized-name-in-linked-work","subjectId":"240071"}],"egsCharacterIds":["19822"],"vndbCharacterId":"c75886"},"orig