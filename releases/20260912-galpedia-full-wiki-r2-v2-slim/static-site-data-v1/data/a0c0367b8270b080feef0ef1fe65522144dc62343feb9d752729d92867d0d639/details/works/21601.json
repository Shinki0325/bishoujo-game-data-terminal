ndidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head of a wealthy merchant family and one who bought her nobility with her immense wealth. Her family is powerful enough to influence the life of the country and its people. She is a highly prideful women, but her business acumen is second to none."}],"source":"vndb","sourceCharacterId":"c47257"},{"segments":[{"spoiler":false,"text":"豪商の家柄で、貴族の地位を金で買った成り上がりで一族の当主。"},{"spoiler":false,"text":"一族の力が強大で国や民の生活にも影響を与えるほど。"},{"spoiler":false,"text":"高慢でゴージャスなお嬢様的な性格だが商才は本物。"}],"source":"egs","sourceCharacterId":"6414","sourceWorkId":"21601","spoiler":false},{"segments":[{"spoiler":false,"text":"豪商の家柄で、貴族の地位を金で買った成り上がり一族の当主。"},{"spoiler":false,"text":"一族の力は強大で国や民の生活にも影響を与えるほど。"},{"spoiler":false,"text":"高慢でゴージャスなお嬢様だが、商才は本物。"}],"source":"bangumi","sourceCharacterId":"46995"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc82dee96f8a98154a39e7423102a65174775eeb67667ce4bd513e746a380c75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1743255c0fffadf0592539d98c51892d9a813dfa15c651c667aadfca9322717.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173154:46995:15684:1","source":"bangumi"}]},{"characterId":"char_c47258","characterName":"リナ","sourceIds":{"bangumi":[{"characterId":"46996","match":"exact-normalized-name-in-linked-work","subjectId":"173154"}],"egsCharacterIds":["6415"],"vndbCharacterId":"c47258"},"originalCharacterName":"リナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A solitary swords-woman who works in the arena. She comes from a low-class family, and the sword is her only way of life. She is as skilled as Firia, but she lacks common sense and worldly knowledge."}],"source":"vndb","sourceCharacterId":"c47258"},{"segments":[{"spoiler":false,"text":"闘技場で剣奴をしている孤高で無口なボクっ娘。"},{"spoiler":false,"text":"奴隷身分出身で剣でしか生きる道がなかった。"},{"spoiler":false,"text":"肉体的には頑強で剣の腕はフィリアに勝るとも劣らないが、世事や常識については極端に疎い。"}],"source":"egs","sourceCharacterId":"6415","sourceWorkId":"21601","spoiler":false},{"segments":[{"spoiler":false,"text":"闘技場で剣奴をしている孤高で無口なボクっ娘。"},{"spoiler":false,"text":"奴隷身分出身で、剣でしか生きる道が無かった。"},{"spoiler":false,"text":"肉体的には頑強で剣の腕はフィリアに勝るとも劣らないが、世事や常識については極端に疎い。"}],"source":"bangumi","sourceCharacterId":"46996"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc6cec3bfbcc7b9a903be43646b0193d814e76a59eac4f724fe986e878a92be9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e269d4802a56d4dbde8690b01faf4def907e757c91b6cd17e77789b85c1938f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173154:46996:6558:1","source":"bangumi"}]},{"characterId":"char_c47259","characterName":"アナトリア","sourceIds":{"bangumi":[{"characterId":"46997","match":"exact-normalized-name-in-linked-work","subjectId":"173154"}],"egsCharacterIds":["6416"],"vndbCharacterId":"c47259"},"originalCharacterName":"アナトリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redire