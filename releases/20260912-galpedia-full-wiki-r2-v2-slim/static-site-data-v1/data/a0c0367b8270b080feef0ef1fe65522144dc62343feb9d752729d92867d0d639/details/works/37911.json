9b8a9079be17ae3ddd6d3f7dd7c6dbfdd434bdaf5fd3e86f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c72653fadb0cebbdf189224155bc74d92f2a98c2aabfca382ca5cddb9b90342e.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏和小","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99816","source":"vndb"}]},{"characterId":"char_vndb_c148873","characterName":"朝馬 晴陽","sourceIds":{"vndbCharacterId":"c148873"},"originalCharacterName":"朝馬 晴陽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist’s twin sister and a second-year student at the academy."},{"spoiler":false,"text":"As her name \"Haruhi\" (which means \"clear sun\") suggests, she has a bright personality and is a cheerful, well-liked girl at school."},{"spoiler":false,"text":"Despite being twins, she and the protagonist look so different that people often point it out. Each time, she firmly insists that they are fraternal twins."},{"spoiler":false,"text":"They used to be very close, but at some point, Haruhi began to worry that always relying on her brother might be a burden to him. Troubled by this thought, she has recently started keeping her distance or adopting a more teasing attitude toward him."},{"spoiler":false,"text":"However, deep down, she can’t bring herself to truly dislike or push him away, leaving her stuck in an awkward, conflicted state."},{"spoiler":false,"text":"As a result, to outsiders, she ends up acting like an elementary schooler teasing their crush. This has only made things even more difficult for her brother, though she remains unaware of it."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c148873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45fec953f56f39a50ce0f6357aee04ef6d524418986086d940e42ef0aee4dae7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12d6799c53281ef3824b8a91780b9036422055c244c3a5343745adec3a395eec.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夜夜 るり","creatorId":"vndb:s23782","sourcePersonId":"vndb:s23782","canonicalEntityId":"vndb:s23782","name":"夏吉 ゆうこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99817","source":"vndb"}]},{"characterId":"char_vndb_c148874","characterName":"朝馬 参悟","sourceIds":{"vndbCharacterId":"c148874"},"originalCharacterName":"朝馬 参悟","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b67d6b4315118439865c5644ed8d2280708ca057b97139e79424ff728d42c0a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f227189eb68c6cc012c1f18ace29a30f6d2284a3dd6793a08b22ed004f89d5a7.webp","width":256,"height":206,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p20414","sourceCompanyId":"egs:brand:8103","canonicalEntityId":"vndb:p20414","name":"CloverGAME","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:37911:8103","source":"egs"},{"companyId":"vndb:p20414","sourceCompanyId":"vndb:p20414","canonicalEntityId":"vndb:p20414","name":"CloverGAME","roleCodes":["developer","publisher"],"identityStatus"