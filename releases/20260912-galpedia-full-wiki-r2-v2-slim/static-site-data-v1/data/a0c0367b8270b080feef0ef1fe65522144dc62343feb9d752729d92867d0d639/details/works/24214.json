terIds":["984"],"vndbCharacterId":"c33540"},"originalCharacterName":"スイートリップ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、学園のアイドル的存在。"},{"spoiler":false,"text":"学園生の代表で組織する自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると放っておけない。"},{"spoiler":false,"text":"頭脳明晰、母性的で潔癖症。正義感が強く、"},{"spoiler":false,"text":"スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために尽くしたいと考えている。"},{"spoiler":false,"text":"国際上級官僚を育成する総合部国際科に属している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"2055","spoiler":false},{"segments":[{"spoiler":false,"text":"『魔法戦士スイートナイツ』のヒロイン。"},{"spoiler":false,"text":"清楚で正義感の強いスイートナイツの中心的存在。"},{"spoiler":false,"text":"メッツァーに対して敵同士以上の想いがある。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"第一世代魔法戦士のリーダー格。"},{"spoiler":false,"text":"現在はかつての学び舎である国際教導学園に復学し、外交官となるための勉強を続けながら、特別講師として時折後輩たちのために教鞭を執っている。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"17330","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーの宿敵。"},{"spoiler":false,"text":"清純な容姿と純真な正義の心に、淫らな肉体を併せ持つ美しい戦士。"},{"spoiler":false,"text":"一度覚えてしまった被虐の悦びからは二度と逃げられない……。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"「こんな自分にはもう、魔法戦士の資格なんてないのかも……」"},{"spoiler":false,"text":"スイートナイツの一人。"},{"spoiler":false,"text":"現在地上で活動している魔法戦士たちのリーダー格。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"国際教導学園で特別講師を務めていたが、講師退任後行方が分からなくなっている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士のリーダー格の一人。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"以前の戦いで、悪の野望を防ぐためにゲートに飛び込み、取り込まれたままいまだ帰還していない。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツのリーダー、スイートリップ。本名は七瀬凛々子。"},{"spoiler":false,"text":"世界の支配を企む悪と戦い続けてきた歴戦の魔法戦士。その優しさと悪に屈することない強さで他の魔法戦士たちからも慕われている。"},{"spoiler":false,"text":"以前の戦いでゲートと呼ばれる魔導演算装置に取り込まれ、しばらくの間消息不明となっていたが、仲間たちによって無事救出される。"},{"spoiler":false,"text":"しかし、異空間に長期間囚われたことで、彼女は戦うための力を失ってしまう。 現在は国際教導学園の学生として、自身の次の道を模索している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"スイートナイツの一人、魔法戦士スイートリップ。"},{"spoiler":false,"text":"現在は特別魔法外交官として活躍している。"},{"spoiler":false,"text":"かつて倒した悪の組織の残党が暗躍しているという情報を聞き、調査へと赴く。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"37809","spoiler":false},{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、 学園のアイドル的存在。学園生の代表で組織する 自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると 放っておけない。頭脳明晰、母性的で潔癖症。正義感が強く、スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために 尽くしたいと考えている。国際上級官僚を育成す る総合部国際科に属している。"}],"source":"bangumi","sourceCharacterId":"96131"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a55f22b1500af098caa60ce65d63437402b9533e4ccf14fd5f2b6885b1dece56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93e929f8899aaac84d2e6c72f4e17d6fda8fad73948c4bd180803979c036d637.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:200512:96131:5907:1","source":"bangumi"}]},{"characterId":"char_c47589","characterName":"シンフォニックシュガー","sourceIds":{"bangumi":[{"characterId":"96141","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2314"],"vndbCharacterId":"c47589"},"originalCharacterName":"シンフォニックシュガー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かな天才科学者。シンフォニックリリーに信頼以上の気持ちを寄せいている。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして莉々奈を奪回しようとエクセリウムで活動中。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"冷静沈着ながら敵対した相手には容赦のない攻撃をする。"},{"spoiler":false,"text":"今まで虚勢を張りながらも堕ちきらなかった彼女が心の支えのない中精神を疲労させていき姦計にはまっていく。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「私の声が聞こえたのなら、きっと莉々奈さんが私を呼んでくれたからです」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かで冷静沈着な天才科学者。"},{"spoiler":false,"text":"莉々奈とは厚い信頼関係に結ばれており、理論・技術面から百合瀬財団の活動を支えている。"},{"spoiler":false,"text":"幼げな容姿に似合わない強靭な意思と折れない心を持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"天才的な頭脳を持つ世界的な科学者。"},{"spoiler":false,"text":"シンフォニックリリーとともに国際教導学園から身を引き、自らの魔法研究を進める傍ら魔法戦士として活動を続けている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、シンフォニックナイツの一人。"},{"spoiler":false,"text":"物静かで冷静沈着、数々の魔法理論や技術を開発している天才科学者。"},{"spoiler":false,"text":"現在は異世界ロアにて研究活動を行っており、時折レムティアシータに技術的なアドバイスを与えている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。本名は甘樹菜々芭。"},{"spoiler":false,"text":"優秀な技術者で、魔法戦士たちの新たな力をいくつも開発する。"},{"spoiler":false,"text":"国際教導学園で教師として働きながら、魔法技術の研究も怠らない。"},{"spoiler":false,"text":"シンフォニックリリーである百合瀬莉々奈とは深い絆で結ばれたパートナー。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。優秀な研究者、技術者として、魔法戦士たちの勝利を支えている。同じシンフォニックナイツの一人である莉々奈とは深い絆で結ばれており、彼女の経営する国際教導学園で教師としても働いている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は幼げな、物静かで無表情な天才技術者"},{"spoiler":false,"text":"集中し始めると周りのことが全く目に入らなくなる"},{"spoiler":false,"text":"その明晰な頭脳を巡って両親が争い、挙げ句二人ともが不慮の死を遂げたため、自分の持つ才能に嫌悪感すら持ってしまっていた。そのためか、感情の表現もうまくない。"},{"spoiler":false,"text":"莉々奈に出会ったことでその頭脳を人類のために役立てることに喜びと、両親への贖罪を見いだす。また、自分の力を役立てる道を見つけてくれた莉々奈に対し、信頼関係以上の感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"96141"}],"profileFacts":[{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"39 kg","valueContext":null,"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8609a430ae70cca7f0b6e759a667e02697a36c766f741c77a34be38ffd50cffc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1712c987ff84caddb112cef83a5939ceff92a62c4c53b935d6c40b3f59bc9fff.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:200512:96141:4810:1","source":"bangumi"}]},{"characterId":"char_c47590","characterName":"エリクシル・ローズ","sourceIds":{"bangumi":[{"characterId":"96146","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2315"],"vndbCharacterId":"c47590"},"originalCharacterName":"エリクシル・ローズ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"理知的で強い意志を持つエリクシルナイツの一人。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして"},{"spoiler":false,"text":"エリクシルライムを取り戻そうと、アマギスにてシルヴァと戦い続けている。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"優しく丁寧な言葉づかいのお嬢様だが、やはり正義のためには熱いハートを剥き出しにする。"},{"spoiler":false,"text":"年長者の責任重圧の中、正義と性欲の葛藤に苦しむ。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「今回の事件……シルヴァが関係しているに違いありませんわ」"},{"spoiler":false,"text":"エリクシルナイツの一人。"},{"spoiler":false,"text":"成績優秀、理知的で強い意志を持ち、一見クールで近寄りがたい印象を与えるが、亜梨子がシルヴァに下っていたときも彼女を信じ続けるという友情に厚い一面も併せ持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士エリクシルナイツ」ほか"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士エリクシルナイツの一人、エリクシルローズ。本名は鏡島樹。"},{"spoiler":false,"text":"エリクシルライムこと立花亜梨子とともに、国際教導学園の魔法科で教師として働いている。担当は座学。"},{"spoiler":false,"text":"鞭のように形状を変化させる剣で近距離戦から中距離戦までマルチにこなす万能型。"},{"spoiler":false,"text":"その冷静な判断力で仲間たちの危機を何度も救っている。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"『次世代総合研究学園ネクスト』でもトップクラスの成績を誇る聡明な少女。"},{"spoiler":false,"text":"普段の物腰はやわらかいが、己の正しいと思ったことは、例え意見がぶつかり 合っても押し通す激しさも持っている。"},{"spoiler":false,"text":"エリクシルライムとシルヴァの戦いに巻き込まれ、この世界を侵略する者の存在を知り、エリクシルライムに憧れを抱く。"},{"spoiler":false,"text":"そして再びシルヴァと相まみえた時、変容魔法の素質に開花し、 エリクシルローズに変身する。"}],"source":"bangumi","sourceCharacterId":"96146"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"2315","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"2315","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"2315","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"2315","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"2315","sourceWorkId":"24214","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7f78ae7e5f7ae0dafc81bd670d7a33bea81f18239e2f97cb087b8165ae83ea0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33251a4ec7a044b4b87d92102ee08907490d977e77ce43952d98a7e3cccdc94.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:200512:96146:6083:1","source":"bangumi"}]},{"characterId":"char_c49827","characterName":"立花 亜梨子","sourceIds":{"bangumi":[{"characterId":"96145","match":"exact-normalized-name-in-linked-work","subjectId":"218634"},{"characterId":"96145","match":"exact-normalized-name-in-linked-work","subjectId":"222234"}],"egsCharacterIds":["15748"],"vndbCharacterId":"c49827"},"originalCharacterName":"立花 亜梨子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"優秀な人材を教育・研究する「次世代総合研究学園ネクスト」に通う、元気で明るい少女。"},{"spoiler":false,"text":"ネクストに誘致されただけのことはあり、勉強はできるが、少々、天然ボケな面も垣間見れる。"},{"spoiler":false,"text":"偶然、主人公の空間変容に居合わせた時、彼女の魔法素質が開花し、「エリクシルナイツ」へと変身する。"}],"source":"egs","sourceCharacterId":"15748","sourceWorkId":"9763","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士エリクシルライム"},{"spoiler":false,"text":"がさつでぶっきらぼうだが涙もろい。"},{"spoiler":false,"text":"文武両道に長け、何処のクラブにも所属してない事から助っ人として様々な分野で活躍している。"},{"spoiler":false,"text":"クラス委員長も務めているが本人が好きでなった訳ではなく菜々芭の推薦。"},{"spoiler":false,"text":"彼女とはよく口げんかをするがよくつるんで行動してもいる"},{"spoiler":false,"text":"神志麻姉妹と同じクラス"}],"source":"egs","sourceCharacterId":"15748","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園の教師。"},{"spoiler":false,"text":"魔法科で実技系の授業を担当している。"},{"spoiler":false,"text":"明るくさっぱりした性格で、生徒からの人気も高い。"},{"spoiler":false,"text":"エリクシルナイツの一人、エリクシルライムでもある彼女は、エメロードナイツやイクシードナイツを時に厳しく、時に優しく指導する。"}],"source":"egs","sourceCharacterId":"15748","sourceWorkId":"27830","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく元気が取り柄の少女。"},{"spoiler":false,"text":"優秀な人材を引き入れて教育・研究をしている『次世代総合研究学園ネクスト』に 誘致されて来ているだけのことはあり、勉強は出来る。"},{"spoiler":false,"text":"だが、少し天然なところもある。"},{"spoiler":false,"text":"偶然シルヴァの空間変容の現場に立ち会い、亜梨子の中に眠る変容魔法 『メタモライズ』の素質が開花してしまう。"},{"spoiler":false,"text":"シルヴァから奪ったエリクシルブレスを手に、亜梨子は変容魔法でエリクシルライムに 変身して、彼の野望に立ち向かう。"}],"source":"bangumi","sourceCharacterId":"96145"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/747dbeb6d79b7fc217c6a1b48d4c9b553e0592fa5e051bdd8ccfe6499e419d5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b1851f076012f46e6b68d4ab7755bd8d3bebf561ffc8a85acbf3fbd9fea085e.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:200512:96145:20833:1","source":"bangumi"}]},{"characterId":"char_c49836","characterName":"シンフォニックリリー","sourceIds":{"bangumi":[{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"200512"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222233"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222234"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222242"}],"egsCharacterIds":["15746","16092"],"vndbCharacterId":"c49836"},"originalCharacterName":"シンフォニックリリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"826"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聡明で頭がよく、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢だが、そういったことをひけらかすことのない控えめな性格。"},{"spoiler":false,"text":"しかし、自分の立場や出自が持つ重要性は十分自覚している。"},{"spoiler":false,"text":"人にはない“魔力”という力を自分が持ってしまったことを恐れ、 悩んでいたが、ある日、かつてメッツァーと戦ったスイートナイツの存在を知り、彼女たちのように自分の力を正義のために使って悪と戦うことを決意。"},{"spoiler":false,"text":"魔力を利用した強化変身システムの開発を財閥の研究部門に指示、 自ら被験者となって研究を主導し、同時に運用・管理・バックアップを行う機関「ミネルヴァ・ガード」を創設。"},{"spoiler":false,"text":"完成したシステムを自ら装備し、はびこる悪と戦うためにシンフォニックナイツとなった。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"8708","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックリリー"},{"spoiler":false,"text":"私立白耀魔法学園の生徒会長にして百合瀬財閥の頭取。"},{"spoiler":false,"text":"常に冷静な判断力と柔らかな人当たりで生徒からの信頼も厚い。"},{"spoiler":false,"text":"趣味は音楽鑑賞。"},{"spoiler":false,"text":"特に生徒会室では常にクラシックが流れている。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"百合瀬財団当主として忙しい日々を送りながら、次世代の魔法戦士を育てるために、国際教導学園を買い取って魔法教育に力を入れている。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"聡明、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢。"},{"spoiler":false,"text":"『魔法戦士シンフォニックナイツ』に登場するヒロイン。"},{"spoiler":false,"text":"今作ではファルケの毒牙にかかり、彼を支援する。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"清純可憐な百合瀬財団の当主だったが、そのあまりにも正義に純粋な心を利用されて、ファルケに調教されてしまう。"},{"spoiler":false,"text":"現在はファルケの配下となって彼の野望のために活動中。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"「あなたに身も心も翻弄されていた、以前の私とは違います」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"清純可憐で聡明な、世界的財閥である百合瀬財団の当主。"},{"spoiler":false,"text":"ファルケに調教されて配下となっていたが、今は正義の心を取り戻して平和のために尽くしており、『ゲート計画』の危険性を見抜き、計画を阻止すべく行動している。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"世界的財閥である百合瀬財団の当主。"},{"spoiler":false,"text":"様々な事情から国際教導学園の運営から退き、魔法戦士としての任務を全うするべく日々活動している。"},{"spoiler":false,"text":"現在は魔法犯罪者の大量脱走事件を追っている。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックリリー。本名は百合瀬莉々奈。"},{"spoiler":false,"text":"世界有数の規模を誇る百合瀬財団の総帥。国際教導学園の理事長でもある。"},{"spoiler":false,"text":"生まれ持ったカリスマ性、優れた知力、卓越した戦術眼で、魔法戦士の指揮官のようなポジションとして活躍している。"},{"spoiler":false,"text":"指揮だけでなく、自ら前線で戦うことも珍しくない。"},{"spoiler":false,"text":"財界や政界とのつながりもあり、魔法戦士が十全に活躍できるよう各界と様々な調整を行っている。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"世界有数の財閥である百合瀬財閥の総帥にして、魔法戦士シンフォニックナイツの一人、シンフォニックリリー。魔法戦士が多く集まる国際教導学園の理事長でもある。その卓越した能力とカリスマ性で、前線で戦いながら魔法戦士たちを指揮することも多い。財界や政界とのつながりもあり、魔法戦士の障害にならぬよう各界と様々な調整を行っている。最近、過去の調教の記憶を悪夢としてみるようになり、そのことで悩んでいる。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"聡明で頭がよく、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢だが、そういったことをひけらかすことのない控えめな性格。"},{"spoiler":false,"text":"しかし、自分の立場や出自が持つ重要性は十分自覚している。"},{"spoiler":false,"text":"人にはない“魔力”という力を自分が持ってしまったことを恐れ、 悩んでいたが、ある日、かつてメッツァーと戦ったスイートナイツの存在を知り、彼女たちのように自分の力を正義のために使って悪と戦うことを決意。"},{"spoiler":false,"text":"魔力を利用した強化変身システムの開発を財閥の研究部門に指示、 自ら被験者となって研究を主導し、同時に運用・管理・バックアップを行う機関『ミネルヴァ・ガード』を創設。"},{"spoiler":false,"text":"完成したシステムを自ら装備し、はびこる悪と戦うためにシンフォニックナイツとなった。"}],"source":"bangumi","sourceCharacterId":"96140"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/265b82f2a42d6fc45d4e7fe1bfdd98cf7d11568ff4b703a4ff4ff08f76e8a55f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/968d921c14904fe34f7955a05b9572d701679c10f058cb86ad083c96446f3e0c.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤邑鈴香","creatorId":"vndb:s2309","sourcePersonId":"vndb:s2309","canonicalEntityId":"vndb:s2309","name":"藤邑鈴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:200512:96140:16173:1","source":"bangumi"}]},{"characterId":"char_c49840","characterName":"ファルケ","sourceIds":{"bangumi":[{"characterId":"96143","match":"exact-normalized-name-in-linked-work","subjectId":"200512"},{"characterId":"96143","match":"exact-normalized-name-in-linked-work","subjectId":"222242"}],"egsCharacterIds":["16095"],"vndbCharacterId":"c49840"},"originalCharacterName":"ファルケ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"72"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Punch: 3.5t / Kick: 10t / Jump: 15m (Next Ignition)"}],"source":"vndb","sourceCharacterId":"c49840"},{"segments":[{"spoiler":false,"text":"魔法の力を手にし、野望に燃える男。"},{"spoiler":false,"text":"戦いの際は自らの開発した強化スキンを身に纏い配下を率いて戦いに臨む。"}],"source":"egs","sourceCharacterId":"16095","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"ミネルヴァ・ガードを手中に収め、エクセリウムを拠点として自ら勢力範囲を拡大中。"}],"source":"egs","sourceCharacterId":"16095","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"「さて、これで俺たちの目的がご理解いただけたかな？」"},{"spoiler":false,"text":"元は大企業で魔力を研究していた優秀な技術者。"},{"spoiler":false,"text":"魔力による世界支配という野望を抱き、自ら開発した強化スキンをまとってシンフォニックナイツと戦いを繰り広げたが、メッツァー封印後は居場所を失い、行方をくらましている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"16095","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔力の持つ可能性にいち早く気付いた大企業『インペリオ』の主席研究員。"},{"spoiler":false,"text":"次々と新理論を発表、実用化に大きく貢献したが、彼の名は表に出ることはなかった。"},{"spoiler":false,"text":"自分の持つ才覚の高さと野望の大きさゆえに、自らの立場とのズレにもどかしさを覚えていた彼はある日、『メッツァー・ハインケル』と名乗る男から、野望を実現するための手段をもたらされ、魔力による世界の支配という野望の実現へ向けて戦い始める。"},{"spoiler":false,"text":"普段は研究員として勤務する傍ら、家庭教師として百合瀬莉々奈に接近し、彼女たちの情報を得ようと画策する。"},{"spoiler":false,"text":"戦いの際は自らの開発した強化スキンを身に纏い、魔物達を率いて戦いに臨む。"}],"source":"bangumi","sourceCharacterId":"96143"}],"profileFacts":[{"label":"身高（本版本）","value":"181 cm","valueContext":null,"source":"egs","sourceCharacterId":"16095","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"72 kg","valueContext":null,"source":"egs","sourceCharacterId":"16095","sourceWorkId":"24214","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f45038f33a51972ce1cecb1cb81e4e44df0dbac766dec63f049cf090a101369.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad4322170a4ab1282b889e6212c75d912564a95a6e264ac8dce37ce41dad2545.webp","width":156,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c51658","characterName":"サキュバス","sourceIds":{"bangumi":[{"characterId":"96162","match":"exact-normalized-name-in-linked-work","subjectId":"200512"}],"egsCharacterIds":["16097"],"vndbCharact