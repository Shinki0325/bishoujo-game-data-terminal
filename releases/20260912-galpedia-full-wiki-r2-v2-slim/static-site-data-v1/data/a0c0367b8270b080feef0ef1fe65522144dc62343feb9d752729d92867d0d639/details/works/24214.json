poiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、スイートナイツの一人。 プライドが高く向う気の強い、小悪魔的雰囲気ながら、正義感に溢れる仲間想い。"},{"spoiler":false,"text":"高い身体能力を生かした格闘技術に長けており、スイートキッスとともに時々シータのもとを訪れて、シータに頼まれて戦闘面の訓練を行っている。"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツの一人、スイートパッション。本名は宮守麻由希。"},{"spoiler":false,"text":"高い身体能力を活かした接近戦を得意とし、先陣を切って仲間たちの続く道を作る。"},{"spoiler":false,"text":"勝気な性格をしているが、優しく正義感に溢れている。"},{"spoiler":false,"text":"ジムでトレーナーとして働いている。"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"スイートナイツ四番目の戦士。メッツァーが潜む学園の学生。"},{"spoiler":false,"text":"凛々子の一つ下で、香那葉と同級。"},{"spoiler":false,"text":"身体能力の高さや気の強さなど、戦士としての資質を全て備えている。"},{"spoiler":false,"text":"一人で戦うスイートリップを助けるため、"},{"spoiler":false,"text":"クイーングロリアが純粋な正義の心を持つ彼女に聖涙石の欠片を宿らせ、"},{"spoiler":false,"text":"魔法戦士に生まれ変わらせた。"},{"spoiler":false,"text":"プライドが高く、はっきりとものを言う。"},{"spoiler":false,"text":"自分のルックスやプロポーションに自信を持っていて、"},{"spoiler":false,"text":"男子の視線を浴び、ちやほやされることを当然と思っている小悪魔的美少女。"},{"spoiler":false,"text":"だが実は性的なことに関してはほとんど免疫が無い。"},{"spoiler":false,"text":"ただ一人戦い続けている凛々子を尊敬し、"},{"spoiler":false,"text":"戦えないでいる香那葉を蔑むような態度をとる。"}],"source":"bangumi","sourceCharacterId":"96138"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"986","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"986","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"986","sourceWorkId":"24214","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterI