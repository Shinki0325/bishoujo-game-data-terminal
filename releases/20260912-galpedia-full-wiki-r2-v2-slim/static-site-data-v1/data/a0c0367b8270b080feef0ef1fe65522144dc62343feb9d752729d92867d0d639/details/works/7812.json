ionId":"vndb:vn-staff:61773","source":"vndb"},{"creditedName":"高橋 直樹","creatorId":"vndb:s2917","sourcePersonId":"vndb:s2917","canonicalEntityId":"vndb:s2917","name":"高橋 直樹","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:61777","source":"vndb"}]},"cast":[{"characterId":"char_c52935","characterName":"高岡 幻夢","sourceIds":{"bangumi":[{"characterId":"153091","match":"exact-normalized-name-in-linked-work","subjectId":"187612"}],"egsCharacterIds":["9971"],"vndbCharacterId":"c52935"},"originalCharacterName":"高岡 幻夢","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公たちが通う学園の養護教諭（保健医）。"},{"spoiler":false,"text":"女子生徒たちの相談や、カウンセリングも行っている。"},{"spoiler":false,"text":"彼女は思春期の女の子たちを淫夢に引きずり込む謎の存在であり、異常性欲に悩み相談に訪れた主人公を淫靡な快楽の世界へと誘う。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"4962","spoiler":false},{"segments":[{"spoiler":false,"text":"正体は淫魔。学園に転校してくるが外見はかなり幼い。"},{"spoiler":false,"text":"過去の失敗により魔力を失い、少女の様な外見に自分を固定する事で魔力の消費を抑えている。"},{"spoiler":false,"text":"卵を2人に与え、互いに競わせる事で魔力を吸収し復活しようと企む。"},{"spoiler":false,"text":"魔力の収集を目的としており、何らかの取り立てに追われているようだが、魔力収集ノルマを果たせずに微妙にワープア化している。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"14026","spoiler":false},{"segments":[{"spoiler":false,"text":"特定の嗜好な方々に好まれるような体型を強いられ、ワープア、貧乏一直線。"},{"spoiler":false,"text":"知り合いのツテでネットショップを運営中。"},{"spoiler":false,"text":"不慣れな仕事でのミスの結果、蒔絵と出会い彼女の『妄想の世界』を利用しようと画策する。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"15559","spoiler":false},{"segments":[{"spoiler":false,"text":"『侵蝕』シリーズに登場する淫魔。 外見上はシリーズ最年少に。"},{"spoiler":false,"text":"三姉妹を巻き込んで、遺跡の魔力を回収しようと企んでいる。"},{"spoiler":false,"text":"迷宮の水先案内人を装い、ヒロインたちを騙して誘導したりもする。"}],"source":"bangumi","sourceCharacterId":"153091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76df2e6ab2fcbca767bc649b4598cd067bdd73b23a46d1d5e13242b255abde70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cebc304ee99ccf80c4bec71ca1791e68178026127d16c281783bd4ae54b52fe.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"比未子","creatorId":"vndb:s1499","sourcePersonId":"vndb:s1499","canonicalEntityId":"vndb:s1499","name":"比未子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230341:153091:18171:1","source":"bangumi"}]},{"characterId":"char_c53355","characterName":"鏡 真那","sourceIds":{"bangumi":[{"characterId":"154166","match":"exact-normalized-name-in-linked-work","subjectId":"230341"}],"egsCharacterIds":["25377"],"vndbCharacterId":"c53355"},"originalCharacterName":"鏡 真那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【悪魔使い】"},{"spoiler":false,"text":"父親が理事長を務めるミッション系女子校に通う少女。"},{"spoiler":false,"text":"ワガママ、暴虐を尽くす上に、夢は世界征服という頭の悪いゴスロリ娘。"},{"spoiler":false,"text":"いつも偉そうにしているためクラスでも孤立しており、友達は香織のみ。"},{"spoiler":false,"text":"でも実は極度の寂しがりやである。"},{"spoiler":false,"text":"背が小さく、ツルペタな体型にコンプレックスを持っている。"}],"source":"egs","sourceCharacterId":"25377","sourceWorkId":"7812","spoiler":false},{"segments":[{"spoiler":false,"text":"我侭、暴虐の限りを尽くす上に"},{"spoiler":false,"text":"夢は世界征服という、頭の悪いゴスロリっ子。"},{"spoiler":false,"text":"偉そうにしているが一人になるとさびしく感じるようだ。"},{"spoiler":false,"text":"ツルペタな体型にコンプレックスをもっている"},{"spoiler":false,"text":"「私の世界征服に手を貸しなさい！」"}],"source":"bangumi","sourceCharacterId":"154166"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b310e63ca75888c576999173a339487e6f0a