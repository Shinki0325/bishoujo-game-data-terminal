ource":"vndb"},{"creditedName":"桜沢 大","creatorId":"vndb:s10914","sourcePersonId":"vndb:s10914","canonicalEntityId":"vndb:s10914","name":"桜沢 大","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145591","source":"vndb"},{"creditedName":"mikemike","creatorId":"vndb:s15196","sourcePersonId":"vndb:s15196","canonicalEntityId":"vndb:s15196","name":"mikemike","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145593","source":"vndb"},{"creditedName":"へいろー","creatorId":"vndb:s15484","sourcePersonId":"vndb:s15484","canonicalEntityId":"vndb:s15484","name":"へいろー","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:145595","source":"vndb"},{"creditedName":"フューチャーハンズ","creatorId":"vndb:s15938","sourcePersonId":"vndb:s15938","canonicalEntityId":"vndb:s15938","name":"Future-hands(フューチャーハンズ)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145597","source":"vndb"},{"creditedName":"studio-outline","creatorId":"vndb:s26072","sourcePersonId":"vndb:s26072","canonicalEntityId":"vndb:s26072","name":"橋本 慎一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145598","source":"vndb"},{"creditedName":"ヤマネ","creatorId":"vndb:s27284","sourcePersonId":"vndb:s27284","canonicalEntityId":"vndb:s27284","name":"ヤマネ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145599","source":"vndb"},{"creditedName":"うきひと","creatorId":"vndb:s31207","sourcePersonId":"vndb:s31207","canonicalEntityId":"vndb:s31207","name":"うきひと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145600","source":"vndb"},{"creditedName":"Saturn","creatorId":"vndb:s4161","sourcePersonId":"vndb:s4161","canonicalEntityId":"vndb:s4161","name":"どせい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145601","source":"vndb"},{"creditedName":"橘 エリカ","creatorId":"vndb:s3691","sourcePersonId":"vndb:s3691","canonicalEntityId":"vndb:s3691","name":"橘 エリカ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:145602","source":"vndb"}]},"cast":[{"characterId":"char_c44309","characterName":"アナスタシア","sourceIds":{"bangumi":[{"characterId":"65419","match":"exact-normalized-name-in-linked-work","subjectId":"222336"}],"egsCharacterIds":["10940"],"vndbCharacterId":"c44309"},"originalCharacterName":"アナスタシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"謎の美少女。"},{"spoiler":false,"text":"聖マリス学園の学園長で、妖魔ハンターの組織の長。"},{"spoiler":false,"text":"膨大な霊力を持つ少女。"},{"spoiler":false,"text":"ヒカルが妖魔と戦う際に、助言や力を与える。"},{"spoiler":false,"text":"「昨日付けでこの学園に配属されたアナスタシア・アウグストです」"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"9681","spoiler":false},{"segments":[{"spoiler":false,"text":"W（ダブリュー）が所属するマスタープロのマネージャー。"},{"spoiler":false,"text":"姉妹や主人公を影から支え、導く。　しかしその正体は……。"},{"spoiler":false,"text":"光も闇も人間もすべてを統べる神様の半身。"},{"spoiler":false,"text":"だが力はリュードミラ （黒アナ） に吸われてしまった。"},{"spoiler":false,"text":"冷静沈着で感情を表に出さない。"},{"spoiler":false,"text":"一見子供のような姿だが、明晰な頭脳にはあらゆる知識が詰まっている。"},{"spoiler":false,"text":"なぜか主人公の名前だけは覚えない。"},{"spoiler":false,"text":"戦いおいては参謀的な立場を取るが、姉妹の代わりに敵と戦うことも。"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"14612","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァルハラ兵団、ワルキューレヴァクターの指揮官。六枚の翼を持つ、三つの『ストゥラ』（神聖）の持ち主。"},{"spoiler":false,"text":"プラチナのように輝く銀髪が特徴の美しい少女。見た目は幼く胸の起伏もほとんど目立たない。"},{"spoiler":false,"text":"しかし内面に秘めたオーラは絶大。背中に光る６枚もの翼が桁違いの霊力を示している。最強最高位の女神。"},{"spoiler":false,"text":"冷静でクール。感情の起伏が少ない。"},{"spoiler":false,"text":"幼い頃泉のほとりで倒れていたところをオーディンに拾われた。それ以前の記憶を失っている。"},{"spoiler":false,"text":"オーディンの養女となり、彼を父として慕う。その力を認められ、ヴァルハラ兵団に徴用され、後に指揮官となる。"},{"spoiler":false,"text":"使用人だったロキに対して、侮蔑の感情を強く抱いている。"},{"spoiler":false,"text":"武器は身の丈ほどもある覇剣「ヴィザール」。　トールと同等とも言われる強神ヴィザールの剣。一振りで嵐を呼び、山をも断つと言われる。"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"25697","spoiler":false},{"segments":[{"spoiler":false,"text":"完全新規シナリオのアナザーストーリー『ジャンヌとアナスタシア～蝶の夢』に登場。"},{"spoiler":false,"text":"不思議な夢を見ていたジャンヌはアナスタシアと名乗る謎の美少女と出会う。"},{"spoiler":false,"text":"ふたりは淫靡な夢の迷宮へと足を踏み入れ、新たな〇〇の数々を味わうこととなる"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"33383","spoiler":false},{"segments":[{"spoiler":false,"text":"ソドムの王に囚われ、鳥籠に入れられている謎の美少女。"},{"spoiler":false,"text":"闘技大会の余興として、たびたび観客の前で嬲りものにされる。"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"37149","spoiler":false},{"segments":[{"spoiler":false,"text":"最強最高位の女神"},{"spoiler":false,"text":"「哀れな劣等種族よ神の力を思い知りましたか」"},{"spoiler":false,"text":"ヴァルハラ兵団、ワルキューレヴァクターの指揮官。"},{"spoiler":false,"text":"プラチナのように輝く銀髮が特徴の美しい少女。見た目は幼いが内に秘めた"},{"spoiler":false,"text":"オーラは絶大。背中に光る6枚もの翼が桁違いの霊力を示している。"},{"spoiler":false,"text":"冷静でクール。感情の起伏が少ない。"},{"spoiler":false,"text":"主神オーディンの養女であり、彼を父として慕う。"},{"spoiler":false,"text":"使用人だったロキに対して、侮蔑の感情を強く抱いている。"}],"source":"bangumi","sourceCharacterId":"65419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61bfc651cc113513390918a1947f26d2900cbfb51112f4ea077dc9a9e4882c45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9802e1fc9c3a54d5c9ac23481c3d156c9983a9885d8eec86a0babd80b6994ac9.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:241389:65419:6105:1","source":"bangumi"}]},{"characterId":"char_c70272","characterName":"ブリュンヒルデ","sourceIds":{"bangumi":[{"characterId":"65420","match":"exact-normalized-name-in-linked-work","subjectId":"241389"}],"egsCharacterIds":["11140"],"vndbCharacterId":"c70272"},"originalCharacterName":"ブリュンヒルデ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"旧主神オーディンのお膝元であるヴァルハラ地方を守護する戦女神。"},{"spoiler":false,"text":"アースガルズ皇家の生まれで、主人公ヴァーリとは腹違いの兄妹の関係。"},{"spoiler":false,"text":"ヴァーリが魔族の血を濃く持って生まれたのに対し、彼女は始祖女神の神族の因子を受け継いで生まれた。"},{"spoiler":false,"text":"皇国で暮らす民たちの平和を願い、彼らのために神槍を手に戦う心優しくも高潔な女神。"},{"spoiler":false,"text":"育ちの良さもあり、その気品や佇まいに心奪われる騎士も多い。"}],"source":"egs","sourceCharacterId":"11140","sourceWorkId":"24008","spoiler":false},{"segments":[{"spoiler":false,"text":"アスガルド王国軍の将軍。　オーディンの娘、アスガルドの第一王女。二つのストゥラを持つ、二重神聖。炎と重力。"},{"spoiler":false,"text":"その実力は最高神オーディンをも越えると言われる、神聖アスガルド王国軍最強の女神。"},{"spoiler":false,"text":"同時にその美しさにおいても並ぶものなしと言われ、敵対する巨人族ですら見とれてしまい、闘いを中断してしまったという逸話が残っているほどの美神。"},{"spoiler":false,"text":"真面目な優等生タイプ。明るく強く、優しく美しい。"},{"spoiler":false,"text":"正義感が強く曲がったことが嫌い。厳しいけれど弱いものには優しい。"},{"spoiler":false,"text":"法の秩序と人々を守る使命を何よりも大切に思う。"},{"spoiler":false,"text":"しかし一方で父の期待に応え、喜ばせたいという女の子らしい一面も。"},{"spoiler":false,"text":"責任感が強く自分で抱え込んでしまい苦労することもある。彼女の心を支えるモノは『正義と愛』。"},{"spoiler":false,"text":"ロキには昔からちょっかいを出されていたので好きではない。特に法を無視するような行為には嫌悪感を抱いていた。"},{"spoiler":false,"text":"神託によって決められた許嫁・ジークフリードがいる。"},{"spoiler":false,"text":"武器は　神剣「フォルセティ」　法の神の名を冠する。肉体よりも悪の心そのものを斬ると言われている、断罪の剣。"}],"source":"egs","sourceCharacterId":"11140","sourceWorkId":"25697","spoiler":false},{"segments":[{"spoiler":false,"text":"強く優しい、美神"},{"spoiler":false,"text":"「不埒なる背徳者に正義の裁きを!」"},{"spoiler":false,"text":"アスガルド王国軍の将軍。オーディンの娘、アスガルドの第一王女。"},{"spoiler":false,"text":"その実力は最高神オーディンをも越えると言われる美神。"},{"spoiler":false,"text":"正義感が強く曲がったことが嫌い。厳しいけれど弱いものには優しい。"},{"spoiler":false,"text":"法の秩序と人々を守る使命を何よりも大切に思う。"},{"spoiler":false,"text":"ロキには昔からちょっかいを出されていたので好きではない。"},{"spoiler":false,"text":"神託にとって決められた許嫁・ジークフリードガいる。"}],"source":"bangumi","sourceCharacterId":"65420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c46edd990fd8dd5a9c0b077cbc7b8172b0a2f513a52458de5039927a897f9ddd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3adc7703a83b84587345644de8656dd7ab94a0dd2a15ddfcdee7d7cafe210e9f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:241389:65420:5924:1","source":"bangumi"}]},{"characterId":"char_c70273","characterName":"スクルド","sourceIds":{"bangumi":[{"characterId":"65423","match":"exact-normalized-name-in-linked-work","subjectId":"241389"}],"egsCharacterIds":["19952"],"vndbCharacterId":"c70273"},"originalCharacterName":"スクルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴァルハラ兵団、ワルキューレヴァクターの一員。アナスタシアの部下。"},{"spoiler":false,"text":"オーディンの命令がなによりも絶対。鎧姿が似合う巨乳キャラ。相当な実力の持ち主。"},{"spoiler":false,"text":"軍人気質のお堅い性格。"},{"spoiler":false,"text":"二つのストゥラを持つ二重神聖。属性は炎と雷。"},{"spoiler":false,"text":"武器は聖剣「テュール」　円盾と片手剣の組み合わせ。盾はあらゆる攻撃を跳ね返し、神々しく光り輝く斬撃が、あらゆる敵を滅する。"},{"spoiler":false,"text":"ロキの奸計により、捕まって洗脳される。闇堕ち後は黒い装束に変化。"}],"source":"egs","sourceCharacterId":"19952","sourceWorkId":"25697","spoiler":false},{"segments":[{"spoiler":false,"text":"高压的な女神"},{"spoiler":false,"text":"「言葉遣いがなってないスクルド様だ、このクズめっ!」"},{"spoiler":false,"text":"ヴァルハラ兵団、ワルキューレヴァクターの一員。"},{"spoiler":false,"text":"アナスタシアの部下。"},{"spoiler":false,"text":"オーディンの命令がなによりも絶対。"},{"spoiler":false,"text":"相当な実力の持ち主。軍人気質のお堅い性格。"},{"spoiler":false,"text":"ロキの奸計により、囚えられ洗脳される。闇堕ち後は黑い装束に変化。"}],"source":"bangumi","sourceCharacterId":"65423"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56e8d8c1e6ebffbc69e327f699f127e51b148dd4c3b9d3a6af56b1088ad43c85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e3adc5ce02327f805326fca7f57a920a24a337b5d66a79960a9102617ad4aff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:241389:65423:10027:1","source":"bangumi"}]},{"characterId":"char_c70275","characterName":"エルルーン","sourceIds":{"bangumi":[{"characterId":"65424","match":"exact-normalized-name-in-linked-work","subjectId":"241389"}],"egsCharacterIds":["19953"],"vndbCharacterId":"c70275"},"originalCharacterName":"エルルーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴァルハラ兵団、ワルキューレヴァクターの一員。アナスタシアの部下。"},{"spoiler":false,"text":"分厚い本を抱えた小柄な少女。無口系キャラ。半眼でボソボソ喋るタイプ。"},{"spoiler":false,"text":"学者タイプのメガネキャラ。ユグドラシルについてもある程度知識がある。"},{"spoiler":false,"text":"ストゥラは一つで属性は木。植物を自在に操る事ができる。"},{"spoiler":false,"text":"武器は神書「ヘイムダル」　本の形をしており、持つ者に知識と広域の視力聴力を授ける。"}],"source":"egs","sourceCharacterId":"19953","sourceWorkId":"25697","spoiler":false},{"segments":[{"spoiler":false,"text":"学者肌の無口な少女"},{"spoiler":false,"text":"「うぅ......やめろ......エルルーンは何も感じてない......!」"},{"spoiler":false,"text":"ヴァルハラ兵団、ワル