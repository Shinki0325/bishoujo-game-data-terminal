":"vndb:s12910","canonicalEntityId":"vndb:s12910","name":"cao.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207372","source":"vndb"},{"creditedName":"クロシン","creatorId":"vndb:s15284","sourcePersonId":"vndb:s15284","canonicalEntityId":"vndb:s15284","name":"クロシン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207373","source":"vndb"},{"creditedName":"カズオ","creatorId":"vndb:s19555","sourcePersonId":"vndb:s19555","canonicalEntityId":"vndb:s19555","name":"カズオ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207375","source":"vndb"},{"creditedName":"まついさん","creatorId":"vndb:s22108","sourcePersonId":"vndb:s22108","canonicalEntityId":"vndb:s22108","name":"松井 章","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207376","source":"vndb"},{"creditedName":"ROMA","creatorId":"vndb:s43647","sourcePersonId":"vndb:s43647","canonicalEntityId":"vndb:s43647","name":"ROMA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207377","source":"vndb"},{"creditedName":"ま～まれぇど","creatorId":"vndb:s53387","sourcePersonId":"vndb:s53387","canonicalEntityId":"vndb:s53387","name":"ま～まれぇど","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207378","source":"vndb"},{"creditedName":"O10","creatorId":"vndb:s53388","sourcePersonId":"vndb:s53388","canonicalEntityId":"vndb:s53388","name":"O10","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:207379","source":"vndb"}]},"cast":[{"characterId":"char_c139112","characterName":"マルマリディア・ドット・フィアバーン","sourceIds":{"bangumi":[{"characterId":"159802","match":"exact-normalized-name-in-linked-work","subjectId":"496152"},{"characterId":"159802","match":"exact-normalized-name-in-linked-work","subjectId":"571443"}],"egsCharacterIds":["26360"],"vndbCharacterId":"c139112"},"originalCharacterName":"マルマリディア・ドット・フィアバーン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"宵闇の1日"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異世界フィアバーン最強の祖竜。"},{"spoiler":false,"text":"実年齢３０００歳を超えたぐらいだが、人間形態では若い女性にしか見えない。"},{"spoiler":false,"text":"素直で明るい性格のポジティブ古竜。"},{"spoiler":false,"text":"世界中から特別扱いされる状況に飽きており、平穏を求めて異世界へとバカンスへ。"},{"spoiler":false,"text":"そこで運命の店――『ツンデレメイドのコンカフェ』と出逢う。"},{"spoiler":false,"text":"非日常を体験できるというコンセプトに心を打ち抜かれ、無事コンカフェにハマる。"},{"spoiler":false,"text":"それどころか、自分も始めたいと言い出す始末。"},{"spoiler":false,"text":"中年サラリーマンが脱サラしてソバを打ち始めたのと似たようなものである。"},{"spoiler":false,"text":"完成された存在であるがゆえ、他種族への関心が希薄なドラゴンにしては、人間である正宗のことを信頼しており、命を分け与えた。"}],"source":"egs","sourceCharacterId":"26360","sourceWorkId":"36586","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界にバカンスに来て、見事にコンカフェにどっぷりハマってしまったドラゴン娘。"},{"spoiler":false,"text":"自分がいた世界 ―― フィアバーンでは世界最高最強だった祖竜の面影はもう無い。"},{"spoiler":false,"text":"タマちゃんというツンデレ妹カフェのキャストがお気に入り。"},{"spoiler":false,"text":"事故に巻き込まれて死んだ正宗に命を分け与え、そのケアと自分の夢のために彼と一緒に住むことに。"},{"spoiler":false,"text":"そこで念願の『ドラ・コンカフェ「リュミエール」』を開き、今はさらに自分好みの店にするべく奮闘している。"},{"spoiler":false,"text":"正宗とは気の良いお姉さん かつ オタク仲間として接していたが、とある一件により、心身共に急速に距離が近づくことに。"},{"spoiler":false,"text":"そしてついには、店のパートナーとして親愛のキスをした。"},{"spoiler":false,"text":"本人は「ドラゴン的にはスキンシップ程度のこと」と言っているが、果たしてその真意はいかに……？。"}],"source":"egs","sourceCharacterId":"26360","sourceWorkId":"39068","spoiler":false},{"segments":[{"spoiler":false,"text":"「マルか……そんなふうに呼ばれるのは初めてだよ。うん、気に入った！採用！」"},{"spoiler":false,"text":"異世界フィアバーン最強の祖竜。"},{"spoiler":false,"text":"実年齢３０００歳を超えたぐらいだが、人間形態では若い女性にしか見えない。"},{"spoiler":false,"text":"素直で明るい性格のポジティブ古竜。"},{"spoiler":false,"text":"世界中から特別扱いされる状況に飽きており、平穏を求めて異世界へとバカンスへ。"},{"spoiler":false,"text":"そこで運命の店――『ツンデレメイドのコンカフェ』と出逢う。"},{"spoiler":false,"text":"非日常を体験できるというコンセプトに心を打ち抜かれ、無事コンカフェにハマる。"},{"spoiler":false,"text":"それどころか、自分も始めたいと言い出す始末。"},{"spoiler":false,"text":"中年サラリーマンが脱サラしてソバを打ち始めたのと似たようなものである。"},{"spoiler":false,"text":"完成された存在であるがゆえ、他種族への関心が希薄なドラゴンにしては、人間である正宗のことを信頼しており、命を分け与えた。"}],"source":"bangumi","sourceCharacterId":"159802"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"159802","value":"コンカフェ巡り・昼寝・デザート（砂糖の塊であればあるほど良し）"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"159802","value":"お説教・過度な期待・しょっぱいもの（ポテトチップスは別）"},{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"26360","sourceWorkId":"36586","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"26360","sourceWorkId":"36586","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"26360","sourceWorkId":"36586","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"26360","sourceWorkId":"36586","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"26360","sourceWorkId":"36586","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"26360","sourceWorkId":"36586","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57a6bf354f52159079a7f1163e7a791654c11ffc3cc34192c898956fbe8562ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84ca7ef652a2abb0f636542b4b48c95d16c1a0fda0dcd19f4757a0c7d5041fec.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚原みう","creatorId":"vndb:s977","sourcePersonId":"vndb:s977","canonicalEntityId":"vndb:s977","name":"柚原 みう","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:496152:159802:15162:1","source":"bangumi"}]},{"characterId":"char_c139113","characterName":"フランカラン・プライディア","sourceIds":{"bangumi":[{"characterId":"159803","match":"exact-normalized-name-in-linked-work","subjectId":"496152"},{"characterId":"159803","match":"exact-normalized-name-in-linked-work","subjectId":"571443"}],"egsCharacterIds":["26361"],"vndbCharacterId":"c139113"},"originalCharacterName":"フランカラン・プライディア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"深閑の19日"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"七王竜の１座、血の王竜。"},{"spoiler":false,"text":"師（マルマリディア）を元の世界に戻すためにやって来た。"},{"spoiler":false,"text":"実年齢２７００歳を超えたぐらいだが、人間形態ではおしとやかな女性にしか見えない。"},{"spoiler":false,"text":"不正やごまかしが嫌いで、生真面目な性格。"},{"spoiler":false,"text":"考えがしっかりしている分どこか傲慢で、柔軟性がないことをいつも師に注意されている。"},{"spoiler":false,"text":"師を何よりも敬愛しており、日頃から身の回りの世話を焼いてきた妹的存在。"},{"spoiler":false,"text":"愛が激重で、ことあるごとに『より親密』になろうと企てている。"},{"spoiler":false,"text":"贅沢は言わないので愛人ぐらいで妥協すると公言している。"},{"spoiler":false,"text":"なので虎視眈々と既成事実を作ろうとしていて、そっとベッドに潜り込むぐらいは当然のようにする。"},{"spoiler":false,"text":"師のような偉大な存在から生命を分け与えられた正宗のことを羨ましく思いつつも、師への馴れ馴れしい態度については快く思っていない。"}],"source":"egs","sourceCharacterId":"26361","sourceWorkId":"36586","spoiler":false},{"segments":[{"spoiler":false,"text":"七王竜が一座、血の王竜。"},{"spoiler":false,"text":"師（マルマリディア）を元の世界に戻すためにやって来た七王竜のひとり。"},{"spoiler":false,"text":"師を敬愛しており、師を中心に世界が回っていると断言するほどに盲目。"},{"spoiler":false,"text":"そんな師が血迷い、コンカフェなるものを始めてしまい戸惑っていたが、マルの本気さに根負けし、自身も店を手伝うことに。"},{"spoiler":false,"text":"師に対して馴れ馴れしい正宗にも少しは慣れたが、まだまだ素直になれないでいる。"},{"spoiler":false,"text":"また七王竜の長であり、一番弟子でもあるために、他の妹弟子たちのまとめ役的ポジションでもある。"},{"spoiler":false,"text":"今回、こちらの世界でドラゴンなトラブルを起こす妹弟子ふたりに、どうしようかと頭を抱えるのであった……。"}],"source":"egs","sourceCharacterId":"26361","sourceWorkId":"39068","spoiler":false},{"segments":[{"spoiler":false,"text":"「至高の存在であるリディア様になんたる態度。やはり人間は不敬の塊ですね。消し炭にします」"},{"spoiler":false,"text":"七王竜の１座、血の王竜。"},{"spoiler":false,"text":"師（マルマリディア）を元の世界に戻すためにやって来た。"},{"spoiler":false,"text":"実年齢２７００歳を超えたぐらいだが、人間形態ではおしとやかな女性にしか見えない。"},{"spoiler":false,"text":"不正やごまかしが嫌いで、生真面目な性格。"},{"spoiler":false,"text":"考えがしっかりしている分どこか傲慢で、柔軟性がないことをいつも師に注意されている。"},{"spoiler":false,"text":"師を何よりも敬愛しており、日頃から身の回りの世話を焼いてきた妹的存在。"},{"spoiler":false,"text":"愛が激重で、ことあるごとに『より親密』になろうと企てている。"},{"spoiler":false,"text":"贅沢は言わないので愛人ぐらいで妥協すると公言している。"},{"spoiler":false,"text":"なので虎視眈々と既成事実を作ろうとしていて、そっとベッドに潜り込むぐらいは当然のようにする。"},{"spoiler":false,"text":"師のような偉大な存在から生命を分け与えられた正宗のことを羨ましく思いつつも、師への馴れ馴れしい態度については快く思っていない。"}],"source":"bangumi","sourceCharacterId":"159803"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"159803","value":"師（至高にて偉大なる祖竜マルマリディア・ドット・フィアバーン様）・お米"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"159803","value":"師への不敬・不正・だらしないもの・甘い物（だが作るのは上手）"},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"