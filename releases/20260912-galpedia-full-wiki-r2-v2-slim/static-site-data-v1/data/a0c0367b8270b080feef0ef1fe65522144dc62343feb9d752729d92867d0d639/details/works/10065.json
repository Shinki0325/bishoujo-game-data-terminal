,"subjectId":"226756"}],"egsCharacterIds":["4568"],"vndbCharacterId":"c5794"},"originalCharacterName":"高峰 沙耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's homeroom teacher whose subject is math. She always keeps a close eye on the protagonist."},{"spoiler":false,"text":"She is an excellent teacher with an arrogant attitude. But she isn't used to being passive and is not good at receiving punishment."},{"spoiler":false,"text":"Every since birth, she's been educated to be superior to others, so she has a dominant attitude, despite this, she comes across as childish."},{"spoiler":false,"text":"Although a beautiful woman, she is feared by her students due to her high standards that doesn't hesitate to look down on students who don't meet them."},{"spoiler":false,"text":"When it comes to sex, she is completely innocent. She never even masturbated before."},{"spoiler":false,"text":"She is Takamine Miyu's older sister."}],"source":"vndb","sourceCharacterId":"c5794"},{"segments":[{"spoiler":false,"text":"【学生を見下すお嬢様教師】"},{"spoiler":false,"text":"主人公のクラス担任で数学教師。"},{"spoiler":false,"text":"自分に従わない主人公を目の敵にしている。"},{"spoiler":false,"text":"優秀な教師で常に高圧的な態度をとるが、逆に受け身に回る事には慣れておらず、打たれ弱い。"},{"spoiler":false,"text":"人の上に立つ者としての教育を受けてきた為、他人を見下す傾向がある女王様気質の女性。"},{"spoiler":false,"text":"子供っぽい権威主義者。"},{"spoiler":false,"text":"美人だが、あまりにも厳しい授業内容と、大半の学生達を成績不良者として見下しているのを隠そうとしない態度から、学生達からは恐れられている。"},{"spoiler":false,"text":"性に関してはとことん純情で奥手。自慰行為すらした事が無い。"}],"source":"egs","sourceCharacterId":"4568","sourceWorkId":"10065","spoiler":false},{"segments":[{"spoiler":false,"text":"【生徒を見下すエリート数学教師】"},{"spoiler":false,"text":"生意気でツンツン尖った性格の高慢なお嬢様数学教師。新体操部顧問。"},{"spoiler":false,"text":"名家に生まれ、徹底した英才教育を受けて育った令嬢。"},{"spoiler":false,"text":"正式な教師ではあるが留学先の学校で2年ほど飛び級しているため、教員の中で一番若い。"},{"spoiler":false,"text":"その教育方針は冷酷で、成績の振るわない学生は完全に見捨て、指導の対象外と考えている。"},{"spoiler":false,"text":"それは彼女が、伝統ある学園の学力低下、素行の悪化を憂えた教師たちが組織した “学生品質管理委員会” の一員であるが故の所行。"},{"spoiler":false,"text":"主人公はその組織に目を付けられた学生の筆頭で、彼に対してはとりわけ手厳しい。"}],"source":"egs","sourceCharacterId":"4568","sourceWorkId":"20580","spoiler":false},{"segments":[{"spoiler":false,"text":"【学生を見下すお嬢様教師】"},{"spoiler":false,"text":"主人公のクラス担任で数学教師。"},{"spoiler":false,"text":"自分に従わない主人公を目の敵にしている。"},{"spoiler":false,"text":"優秀な教師で常に高圧的な態度をとるが、逆に受け身に回る事には慣れておらず、打たれ弱い。"},{"spoiler":false,"text":"人の上に立つ者としての教育を受けてきた為、他人を見下す傾向がある女王様気質の女性。"},{"spoiler":false,"text":"子供っぽい権威主義者。"},{"spoiler":false,"text":"美人だが、あまりにも厳しい授業内容と、大半の学生達を成績不良者として見下しているのを隠そうとしない態度から、学生達からは恐れられている。"},{"spoiler":false,"text":"性に関してはとことん純情で奥手。自慰行為すらした事が無い。"}],"source":"egs","sourceCharacterId":"4568","sourceWorkId":"20631","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラス担任で数学教師。自分に従わない主人公を目の敵にしている。"},{"spoiler":false,"text":"優秀な教師で常に高圧的な態度をとるが、逆に受け身に回る事には慣れておらず、打たれ弱い。"},{"spoiler":false,"text":"人の上に立つ者としての教育を受けてきた為、他人を見下す傾向がある女王様気質の女性。子供っぽい権威主義者。"},{"spoiler":false,"text":"美人だが、あまりにも厳しい授業内容と、大半の学生達を成績不良者として見下しているのを隠そうとしない態度から、学生達からは恐れられている。"},{"spoiler":false,"text":"性に関してはとことん純情で奥手。自慰行為すらした事が無い。"}],"source":"bangumi","sourceCharacterId":"60784"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"4568","sourceWorkId":"10065","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"4568","sourceWorkId":"10065","sourceFiel