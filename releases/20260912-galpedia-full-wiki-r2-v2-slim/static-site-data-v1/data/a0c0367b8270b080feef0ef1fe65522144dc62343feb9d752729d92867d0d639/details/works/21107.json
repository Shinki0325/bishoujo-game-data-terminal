{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21107","model":{"presentationWorkId":"vndb:v16093","staff":{"artwork":[{"creditedName":"斎藤なつき","creatorId":"vndb:s2566","sourcePersonId":"egs:creator:105","canonicalEntityId":"vndb:s2566","name":"斎藤なつき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138737","source":"egs"},{"creditedName":"ジェントル佐々木","creatorId":"vndb:s1223","sourcePersonId":"egs:creator:87","canonicalEntityId":"vndb:s1223","name":"ジェントル佐々木","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138738","source":"egs"},{"creditedName":"夕暮ぱいろ","creatorId":"vndb:s3720","sourcePersonId":"egs:creator:9124","canonicalEntityId":"vndb:s3720","name":"夕暮ぱいろ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138739","source":"egs"},{"creditedName":"緑木邑","creatorId":"vndb:s832","sourcePersonId":"egs:creator:12954","canonicalEntityId":"vndb:s832","name":"緑木邑","detail":"ソニア","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138740","source":"egs"},{"creditedName":"Jambread","creatorId":"vndb:s9847","sourcePersonId":"vndb:s9847","canonicalEntityId":"vndb:s9847","name":"Jambread","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:114157","source":"vndb"}],"scenario":[{"creditedName":"ZEQU(壱里塚不空、睦月弓弦、ののじ)","creatorId":"vndb:s641","sourcePersonId":"egs:creator:2033","canonicalEntityId":"vndb:s641","name":"ZEQU(壱里塚不空、睦月弓弦、ののじ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:138741","source":"egs"},{"creditedName":"野山 風一郎","creatorId":"vndb:s8747","sourcePersonId":"vndb:s8747","canonicalEntityId":"vndb:s8747","name":"野山 風一郎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:114156","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c47579","characterName":"雪待 ヤクモ","sourceIds":{"bangumi":[{"characterId":"96268","match":"exact-normalized-name-in-linked-work","subjectId":"222247"}],"egsCharacterIds":["5343"],"vndbCharacterId":"c47579"},"originalCharacterName":"雪待 ヤクモ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Since I'm not suit to be a princess, I'll aim to become a prince!\""},{"spoiler":false,"text":"A boyish girl who is extremely positive and hates crookedness."},{"spoiler":false,"text":"She is so passionate that it can burn others, but she cares about her friends even more."},{"spoiler":false,"text":"She fights alongside the Divine Skeleton Princess Icona."},{"spoiler":false,"text":"She's the type who genuinely acts for others' sake."},{"spoiler":false,"text":"She never looks down on anyone as “pitiful,” always approaching them with sincere feelings."}],"source":"vndb","sourceCharacterId":"c47579"},{"segments":[{"spoiler":false,"text":"私立星那女学園に通う学生。"},{"spoiler":false,"text":"他の友人と共に、アドリファの先兵たるファミリアの生み出す異常空間に引きずり込まれた際、精神を神骸魂装姫イコナに明け渡そうとしたが、イコナの力を逆に吸収してしまい、神骸魂装姫としても変身能力を得ることになる。"}],"source":"egs","sourceCharacterId":"5343","sourceWorkId":"21107","spoiler":false},{"segments":[{"spoiler":false,"text":"とことん前向きで、曲がったことが嫌いな女の子。"},{"spoiler":false,"text":"他人がヤケドしてしまうほどのオセッカイ焼きで、それ以上に友達思い。"},{"spoiler":false,"text":"神骸魂装姫のイコナと共に戦うことになる。"},{"spoiler":false,"text":"真剣に他人のために動けるタイプ。"},{"spoiler":false,"text":"どんな相手でも 「かわいそう」 と見下したりせず、真摯な気持ちで接する。"}],"source":"bangumi","sourceCharacterId":"96268"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9fa4699bd3d0406f052b2e7d15e32a5b03f821fbf1c9c155fb96dd934a6257d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba972c38d07308dc3730180fd880b9ea133bcc41dbcca78a7fc60cd822a6ed51.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八幡七味","creatorId":"vndb:s1988","sourcePersonId":"vndb:s1988","canonicalEntityId":"vndb:s1988","name":"八幡 七味","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222247:96268:21494:1","source":"bangumi"}]},{"characterId":"char_c47580","characterName":"マリオン \"O\" ダンジェルマイア","sourceIds":{"bangumi":[{"characterId":"96270","match":"exact-normalized-name-in-linked-work","subjectId":"222247"}],"egsCharacterIds":["5344"],"vndbCharacterId":"c47580"},"originalCharacterName":"マリオン \"O\" ダンジェルマイア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cool girl who doesn't particularly seek out interaction with others."},{"spoiler":false,"text":"She believes bringing emotion into battle is irrational, but gradually becomes influenced after meeting Yakumo."},{"spoiler":false,"text":"She often finds herself being hugged by Yakumo, who exclaims, “You're so cute, like a doll!”"},{"spoiler":false,"text":"Possessed by the Divine Skeleton Princess Nahato, her personality becomes tsundere."},{"spoiler":false,"text":"She seems to frequently disagree with Rachel on various matters."}],"source":"vndb","sourceCharacterId":"c47580"},{"segments":[{"spoiler":false,"text":"私立星那女学園に通う学生。"},{"spoiler":false,"text":"科学者を両親に持ち、その研究の関係で今まで様々な国を転々としてきて、最近になって、日本に落ち着いた少女。"}],"source":"egs","sourceCharacterId":"5344","sourceWorkId":"21107","spoiler":false},{"segments":[{"spoiler":false,"text":"あまり他者との交流を持ちたがらないクールな少女。"},{"spoiler":false,"text":"戦闘に感情を持ち込むことは不合理と考えているが、ヤクモと知り合い少しづつ感化されていく。"},{"spoiler":false,"text":"「お人形さんみたいでカワイイッ！」 とヤクモに抱きつかれることもしばしば。"},{"spoiler":false,"text":"神骸魂装姫のナハトが憑依し、性格がツンデレ化する。"},{"spoiler":false,"text":"レイチェルとは何かと意見の相違がある模様。"}],"source":"bangumi","sourceCharacterId":"96270"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/329e30712860b3dc3d8a2b4c23490f8f9d7b27ebc356867ea5c13b8f935a68c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3f9f1f331d769572f4e896a7338ced1bdf6afa58fd7d425ec9388f7f32a7386.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤田しずく","creatorId":"vndb:s937","sourcePersonId":"vndb:s937","canonicalEntityId":"vndb:s937","name":"藤田 しずく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222247:96270:16178:1","source":"bangumi"}]},{"characterId":"char_c47584","characterName":"ソニア \"S\" インチェスター","sourceIds":{"bangumi":[{"characterId":"96272","match":"exact-normalized-name-in-linked-work","subjectId":"222247"}],"egsCharacterIds":["5345"],"vndbCharacterId":"c47584"},"originalCharacterName":"ソニア \"S\" インチェスター","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The student council president at Yakumo's academy and her senior by one year."},{"spoiler":false,"text":"Her parents are diplomats, and she is a noble lady descended from ancient Indian royalty."},{"spoiler":false,"text":"She has a strong sense of responsibility, yet treats everyone equally kindly, holding an “older sister” position within the academy."},{"spoiler":false,"text":"She can be a bit intimidating, but Yakumo, who doesn't mind that, feels like a somewhat troublesome little sister to her."},{"spoiler":false,"text":"After being possessed by the Divine Skeleton Princess Sukanaha, her personality becomes knightly."},{"spoiler":false,"text":"She transforms into a strict, high-and-mighty persona towards both herself and others, often clashing with Yakumo."},{"spoiler":false,"text":"However, this stems from her resolve to protect her comrades, even at the cost of her own sacrifice."}],"source":"vndb","sourceCharacterId":"c47584"},{"segments":[{"spoiler":false,"text":"私立星那女学園に通う学生。ヤクモのひとつ上の先輩。"},{"spoiler":false,"text":"両親は外交官であり、古くはインド系王族の血を引く貴族のお嬢様。責任感が強く、そのクセ誰に対しても等しく優しく接する、学園内では\"お嬢様\"的ポジション。"}],"source":"egs","sourceCharacterId":"5345","sourceWorkId":"21107","spoiler":false},{"segments":[{"spoiler":false,"text":"ヤクモが通う学園の生徒会長であり、一つ上の先輩。"},{"spoiler":false,"text":"両親は外交官で、古くはインド系王族の血を引く貴族のお嬢様。"},{"spoiler":false,"text":"責任感が強く、そのくせ誰に対しても等しく優しく接する、学園内では “お姉様” 的ポジション。"},{"spoiler":false,"text":"少し近寄りがたいが、そんなことを気にしないヤクモは少々世話の掛かる妹のような感じ。"},{"spoiler":false,"text":"神骸魂装姫 スカナハの憑依後は騎士然とした性格に。"},{"spoiler":false,"text":"自他ともに厳しくタカビーな雰囲気に変わり、ヤクモと衝突することもしばしば。"},{"spoiler":false,"text":"しかしそれは、自分を犠牲にしてでも仲間を守ろうとする気概のためでもある。"}],"source":"bangumi","sourceCharacterId":"96272"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a0300154d58ede9920eac6834a7ae984e9f24c1e8d689d1ba7c0251301dfca1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/560486817c40866f2e2ca4ef490a3aeab472c2d0b5bca18e012fcc7ef9ad1b19.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222247:96272:6349:1","source":"bangumi"}]},{"characterId":"char_c47585","characterName":"レイチェル ターナー","sourceIds":{"bangumi":[{"characterId":"96271","match":"exact-normalized-name-in-linked-work","subjectId":"222247"}],"egsCharacterIds":["5346"],"vndbCharacterId":"c47585"},"originalCharacterName":"レイチェル ターナー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who came to Japan alone to study, drawn by her admiration for Japanese samurai and ninja."},{"spoiler":false,"text":"With a typically Western frank personality, she seems to click with Yakumo and wants to hang out with her after school too."},{"spoiler":false,"text":"She fights possessed by the Divine Skeleton Princess Berid."},{"spoiler":false,"text":"Her approach is pretty haphazard and her attack methods are sloppy. While she has the highest firepower among the members, her collateral damage is also high."}],"source":"vndb","sourceCharacterId":"c47585"},{"segments":[{"spoiler":false,"text":"私立星那女学園に通う学生。"},{"spoiler":false,"text":"サムライやニンジャに憧れて単身で留学してきた。"},{"spoiler":false,"text":"本来は欧米人らしい気さくでフランクな性格で、フィーリングが合うのか、ヤクモと放課後も一緒に行動しており、バスで痴漢にあうヤクモを助けるカッコいいクラスメイト。"}],"source":"egs","sourceCharacterId":"5346","sourceWorkId":"21107","spoiler":false},{"segments":[{"spoiler":false,"text":"日本のサムライやニンジャに憧れて、単身で日本に留学してきた少女。"},{"spoiler":false,"text":"欧米人らしいフランクな性格で、フィーリングが合うのかヤクモと放課後も一緒に行動したがる。"},{"spoiler":false,"text":"神骸魂装姫 ベリッドが憑依して戦う。"},{"spoiler":false,"text":"色々といい加減で攻撃方法は雑。 火力はメンバー最強だが、周囲への被害も大きい。"}],"source":"bangumi","sourceCharacterId":"96271"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b0508024ddb09a63ec0b43eb982c8df12271326db4aa6a0739cca15b68af2cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e17b7be0f88e689520373a144702f63dc6cbe0aec6204bdcdb8b8a95434f1e2.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"credited