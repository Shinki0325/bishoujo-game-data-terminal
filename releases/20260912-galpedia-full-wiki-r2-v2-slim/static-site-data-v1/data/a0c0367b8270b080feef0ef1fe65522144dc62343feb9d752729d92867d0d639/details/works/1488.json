{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"1488","model":{"presentationWorkId":"vndb:v109","staff":{"artwork":[{"creditedName":"志水直隆(志水なおたか)","creatorId":"vndb:s2213","sourcePersonId":"egs:creator:71","canonicalEntityId":"vndb:s2213","name":"志水直隆(志水なおたか)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:101","source":"egs"}],"scenario":[{"creditedName":"渡辺ヒロシ","creatorId":"vndb:s2192","sourcePersonId":"egs:creator:184","canonicalEntityId":"vndb:s2192","name":"渡辺ヒロシ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:102","source":"egs"},{"creditedName":"シナリオ制作チームさるさる","creatorId":"egs:creator:5656","sourcePersonId":"egs:creator:5656","canonicalEntityId":"egs:creator:5656","name":"シナリオ制作チームさるさる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:272928","source":"egs"}],"music":[{"creditedName":"ミリオンバンブー(有限会社バンブー)","creatorId":"vndb:s1435","sourcePersonId":"egs:creator:2670","canonicalEntityId":"vndb:s1435","name":"ミリオンバンブー(有限会社バンブー)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11863","source":"egs"},{"creditedName":"わさび","creatorId":"vndb:s2357","sourcePersonId":"vndb:s2357","canonicalEntityId":"vndb:s2357","name":"笹原 延介","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:4087","source":"vndb"}],"other":[{"creditedName":"齋藤紀子","creatorId":"vndb:s2345","sourcePersonId":"egs:creator:22478","canonicalEntityId":"vndb:s2345","name":"齋藤紀子","detail":"テーマソング「LOVE PARADISE」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:272929","source":"egs"},{"creditedName":"志水 直隆","creatorId":"vndb:s2213","sourcePersonId":"vndb:s2213","canonicalEntityId":"vndb:s2213","name":"志水 なおたか","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:4084","source":"vndb"},{"creditedName":"齋藤 紀子","creatorId":"vndb:s2345","sourcePersonId":"vndb:s2345","canonicalEntityId":"vndb:s2345","name":"齋藤 紀子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:4086","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c27885","characterName":"桜木 貴司","sourceIds":{"vndbCharacterId":"c27885"},"originalCharacterName":"桜木 貴司","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takashi is Takuya's older cousin who was kind enough to let Takuya stay at his apartment. He's in charge of running his family's cake shop, called \"Sakuragi\" by his family name. The cake shop is very successful, mostly because many female fans of Takashi's frequent the establishment. Despite all this adoration, Takashi remains devoted to his wife Silk."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c27885"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87d63e59cf253131e349dd8ccdf708f725f302da797e11312ede276c071820d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96b49efbdf10c01e6c499f04275b1290d57ee895e5b32bbd4df086fd05c5ddab.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂井 光明","creatorId":"vndb:s2618","sourcePersonId":"vndb:s2618","canonicalEntityId":"vndb:s2618","name":"坂井 光明","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1282","source":"vndb"}]},{"characterId":"char_vndb_c27886","characterName":"桜木 拓也","sourceIds":{"vndbCharacterId":"c27886"},"originalCharacterName":"桜木 拓也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sakuragi Takuya's life is going well; he's moving to the big city to attend university. Not being able to afford a place of his own, Takuya has arranged to move in with his cousin, Takashi, and his wife, Silk. In return, he's helping out at Takashi's cake shop, where he meets some beautiful women, employees and customers alike. All these girls seem to have huge crushes on Takashi, which works out well for Takuya since he resembles his cousin. Before Takuya can even consider making a move, though, something extraordinary occurs."},{"spoiler":false,"text":"The first night in the Sakuragi apartment, a beautiful girl materializes out of thin air. Her name is also Silk, and she's been cursed to jump between worlds for all of eternity. But she has a plan, a way to reach her homeland. If she can collect different types of magic, she can cast a spell to break the curse. Unfortunately for her, the most plentiful source of this magic is young girls, and in order to get it, one must have sex with them! This is where Takuya comes in. Obviously, Silk can't gather the magic alone, so she enlists Takuya as her servant. Casting a spell on Takuya that greatly enhances his natural attractiveness, Silk sends him out to collect the magic she needs."},{"spoiler":false,"text":"From Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c27886"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da352e5580edb75b4514e4eed307675f157d9c85c49e08201ce9179c79e743e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/986be28cf379ec414c4c6dd65e5bfd04f0a8f9ecac9f4ae8e23b1953fd5478ff.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c27887","characterName":"桜木 シルク","sourceIds":{"vndbCharacterId":"c27887"},"originalCharacterName":"桜木 シルク","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Silk is Takashi's wife and they have been married for 3 years so far. She certainly looks Japanese, but her true origin is actually that of a totally another world. Neither Silk nor Takashi have let slip the secret of her true origin in their time spent together. But that is about to change once a new Silk appears before Takuya and the happily married couple."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c27887"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d0a54b5ac78b0833c675e06c140fb39b034e8bf1c2ac27eea5168d576ebb349.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bd2fd3804008a5e574a9cfb927965ffbc7bbf00005dbc8feb034d8fe4e58a5d.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 ほのか","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1278","source":"vndb"}]},{"characterId":"char_vndb_c27888","characterName":"松原 沙奈","sourceIds":{"vndbCharacterId":"c27888"},"originalCharacterName":"松原 沙奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sana is a part-time waitress at the Sakuragi's cake shop. She's still in high school and she's a year younger than Takuya. Most of the time she's a very down-to-earth girl. However, she has a massive crush on her boss Takashi, and she gets very emotional and protective when other women come around asking for him. Other than that, she is a very energetic and honest girl."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and JAST USA"}],"source":"vndb","sourceCharacterId":"c27888"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/718877388788e1dd2401e4e923635da78fc000797c6930647fe11f9b3f12aa23.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b48fd976cfd13aef0efc8e7297f454ae3726f40ca06ed0505fb6d6acc30ef6ba.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内村 みるく","creatorId":"vndb:s1015","sourcePersonId":"vndb:s1015","canonicalEntityId":"vndb:s1015","name":"池田 千草","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1276","source":"vndb"}]},{"characterId":"char_vndb_c27889","characterName":"綱島 えりか","sourceIds":{"vndbCharacterId":"c27889"},"originalCharacterName":"綱島 えりか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Erika is an old friend of Takashi and his wife. In fact she has known them for so long that they think of her as their little sister. She has just returned from studying abroad. Erika was always a bit childish and pampered, but it seems that her trip abroad has helped her to grow up a bit. She's a very cheerful and happy girl. However, she's also hurting on the inside because of her unrequited feelings for Takashi. When she met Takuya, who looks a lot like Takashi, she became more than a little interested in him."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and JAST USA"}],"source":"vndb","sourceCharacterId":"c27889"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce449593d00ce2021dad56fa424a40bab2fbfd1e2c670f0dfa7cd67961495ba7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8ea0d257f456e8a24c2993254c62000899e15f031d1d5d13e1bc473337ccdd5.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城 みづほ","creatorId":"vndb:s2068","sourcePersonId":"vndb:s2068","canonicalEntityId":"vndb:s2068","name":"武政 弘子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1281","source":"vndb"}]},{"characterId":"char_vndb_c27891","characterName":"宮坂 かおり","sourceIds":{"vndbCharacterId":"c27891"},"originalCharacterName":"宮坂 かおり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaori seems to be a very sexy and glamorous girl. She comes by the Sakuragi cake shop on a regular basis to feed her sweet tooth, but she also tries to tempt Takashi to come visit her establishment. She works as a hostess in a bunny bar called \"Carrot\". This bunny bar is also located in the shopping mall where Sakuragi's cake shop is. The hostesses must wear certain uniforms - bunny costumes! Kaori has always been a very quiet and introverted girl, but recently, she's started to like the idea of being looked at."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and JAST USA"}],"source":"vndb","sourceCharacterId":"c27891"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a5d1822e2e48b69f9a36dc03ca08f4a5af53f6032aaa6b3dc80659ca01b69f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04605ebf0ff39cd1008a87914bcdd4e48edca36be8d301087f5665ccfdde414c.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原島 瑠璃子","creatorId":"vndb:s1010","sourcePersonId":"vndb:s1010","canonicalEntityId":"vndb:s1010","name":"原島 瑠璃子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1275","source":"vndb"}]},{"characterId":"char_vndb_c27892","characterName":"シルク","sourceIds":{"vndbCharacterId":"c27892"},"originalCharacterName":"シルク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"This beautiful, blonde magical girl from another dimension suddenly showed up in the Sakuragi's family living room. It seems that she has been cursed to wander throughout all existence for all of eternity, but she remains hopeful that one day she will be able to return to her homeworld. She hopes that Takuya will be able to help her in her goal. Her spirit certainly isn't crushed. She's very demanding and forceful, even haughty at times."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and JAST USA"}],"source":"vndb","sourceCharacterId":"c27892"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0354e702147d9a94b963d47f2a912cfb7b91410d23cec1fd08a6350e337c0da1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c53ba56f1d7326f187c0b577dec8aa40ceecee159df93c1890733b14440f9f92.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 ほのか","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1279","source":"vndb"}]},{"characterId":"char_vndb_c29281","characterName":"美穂","sourceIds":{"vndbCharacterId":"c29281"},"originalCharacterName":"美穂","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miho is working in a bakery shop, \"Marine\", together with Ayumi, therefore they are coworkers. Due to Takuya's irresistible pheromone charming power, she won't be able to control her lust once she meets him for the first time."}],"source":"vndb","sourceCharacterId":"c29281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5e0b4524c1ca46735568b02137f0c0997ad2940ab7dd4456073affc469039a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7630f5c5034ea520a29572b0d146790c9ad833fae722c995680f56fb72761e2c.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c61100","characterName":"ミニシルク","sourceIds":{"vndbCharacterId":"c61100"},"originalCharacterName":"ミニシルク","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Silk has an ability to transform into a fairy-like creature. While in this form, she is following Takuya around on his mission to collect energy necessary for her spell."}],"source":"vndb","sourceCharacterId":"c61100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a00799035720f36dcf41babaa33ae17811c933579d14f44640d65a1eed5c9bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4beccd110bf5764336c86e50118da631aa94a72efa3a603571ced6f9137d1fa6.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c6241","characterName":"山下 久美","sourceIds":{"vndbCharacterId":"c6241"},"originalCharacterName":"山下 久美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kumi is a more refined specimen. She works as a salesgirl at the candy shop \"Taishido\". She usually wears a traditional kimono which, combined with her calm and relaxed air, makes her seem more mature than the other girls. She often comes by the shop specifically to visit Takashi but will also get interested in Takuya later on aswell."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c6241"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/779ddf1ebf52e29c1b7d6a7fde1b204d00c555fe0a9feafc037ba59aaed0bb14.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/9437ce11d7d9f5c7ad0e7ea7e4a907267287e43ff292ce95c47d8cf5434d22ce.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真姫 澪香","creatorId":"vndb:s2067","sourcePersonId":"vndb:s2067","canonicalEntityId":"vndb:s2067","name":"真姫 澪香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1280","source":"vndb"}]},{"characterId":"char_vndb_c6242","characterName":"若林 あゆみ","sourceIds":{"vndbCharacterId":"c6242"},"originalCharacterName":"若林 あゆみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayumi works in a bakery shop, \"Marine\", which is located near Takashi's cake shop. She's Sana's best friend and they are classmates. She looks very young and tends to act in a childish manner. However, her illusion of innocence is both contradicted and enhanced by her frank talk about shocking subjects. Even though she says that she has a boyfriend, she seems to be rather interested in Takuya."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and JAST USA"}],"source":"vndb","sourceCharacterId":"c6242"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3df33e103b68fcdd7b45bcab49635ceb586c3fa30197b0dbbc530d2882108a8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e568ded8e08a68f039cc77d3985856d1666bb3087b6ee247b523b64aeb13ef6.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹澤 綾","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1277","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p89","sourceCompanyId":"egs:brand:210","canonicalEntityId":"vndb:p89","name":"トラヴュランス","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:1488:210","source":"egs"},{"companyId":"vndb:p89","sourceCompanyId":"vndb:p89","canonicalEntityId":"vndb:p89","name":"トラヴュランス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:12612:v109","source":"vndb