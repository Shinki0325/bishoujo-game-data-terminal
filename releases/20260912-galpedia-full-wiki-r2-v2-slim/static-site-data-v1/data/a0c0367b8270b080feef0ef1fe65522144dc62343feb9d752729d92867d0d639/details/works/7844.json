}]},"originalCharacterName":"噬死者","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"210"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"125"}},"descriptions":[{"segments":[{"spoiler":false,"text":"移动尸体。没有意志的杀人机器。"},{"spoiler":false,"text":"不算干部在内的8人之中最强，但无法单体行动，只能像道具一样被驱使。"},{"spoiler":false,"text":"被圣遗物吞噬后的人类的末路，在他的身体内没有一块能被称为灵魂的碎片。"},{"spoiler":false,"text":"在肉体被完全破坏之前能保持行动的怪物。"},{"spoiler":false,"text":"称号：死を喰らう者"},{"spoiler":false,"text":"黒円卓：二位"},{"spoiler":false,"text":"ルーン：力"},{"spoiler":false,"text":"大アルカナ：法皇"},{"spoiler":false,"text":"占星術：金牛宮"},{"spoiler":false,"text":"形態：武装具現型"},{"spoiler":false,"text":"位階：創造"}],"source":"bangumi","sourceCharacterId":"43383"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c06dd04fe9e1c081433c13b7bfaee5e6b498ccf2e648796e7bde41cc516feb8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0df88f8fe3d3c461457b62b350c4e8dae1a5e9dccb83f8e3344a46abcb261cb4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安元洋貴","creatorId":"vndb:s377","sourcePersonId":"vndb:s377","canonicalEntityId":"vndb:s377","name":"安元 洋貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:43383:4483:1","source":"bangumi"}]},{"characterId":"char_bangumi_43384","characterName":"Valerian Trifa","sourceIds":{"bangumi":[{"characterId":"43384","match":"source-roster","subjectId":"156122"},{"characterId":"43384","match":"source-roster","subjectId":"16849"},{"characterId":"43384","match":"source-roster","subjectId":"187085"},{"characterId":"43384","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"Valerian Trifa","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"干部不在的现骑士团中拥有最高指挥权的司令官，负责其所执行的仪式的祭祀的圣职者。"},{"spoiler":false,"text":"因为是参与圣战的司祭般的存在，并非慈爱的使徒而是疯狂的信徒。"},{"spoiler":false,"text":"在平稳的笑容下谋划着冷酷无情的策略，指挥煽动麾下的团员。"},{"spoiler":false,"text":"称号：神を運ぶ者"},{"spoiler":false,"text":"黒円卓：三位"},{"spoiler":false,"text":"ルーン：保護"},{"spoiler":false,"text":"大アルカナ：恋人"},{"spoiler":false,"text":"占星術：双児宮"},{"spoiler":false,"text":"形態：特殊発現型"},{"spoiler":false,"text":"位階：創造"}],"source":"bangumi","sourceCharacterId":"43384"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65b8ebf40c0bba709b8714d0508f428fd7298dd8fbc73b33e1a428b967622137.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56c59bc6d21cae81e3d5ae1e5643459fb0402dba08d5da9e470fe6dadc91756c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成田剣","creatorId":"vndb:s179","sourcePersonId":"vndb:s179","canonicalEntityId":"vndb:s179","name":"成田 剣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:43384:3897:1","source":"bangumi"}]},{"characterId":"char_bangumi_43385","characterName":"太阳之神子（Zonnenkind）","sourceIds":{"bangumi":[{"characterId":"43385","match":"source-roster","subjectId":"16849"},{"characterId":"43385","match":"source-roster","subjectId":"187085"},{"characterId":"43385","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"太阳之神子（Zonnenkind）","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0831"},"height":{"reviewState":"source-only","source":"bangumi","value":"141"},"weight":{"reviewState":"source-only","source":"bangumi","value":"30"}},"descriptions":[{"segments":[{"spoiler":false,"text":"第一代Zonnenkindト。"},{"spoiler":false,"text":"在45年以柏林进行人祭，施法让被称为“城”的莱因哈德的创造位阶永久展开。"},{"spoiler":false,"text":"二十年后死去，但他的灵魂作为“城”的心脏，如文字所示，成为了人祭祭品。"},{"spoiler":false,"text":"只要有他存在一天就无法打倒莱因哈德，有莱因哈德存在一天就无法将他从万劫不复之中解放。"},{"spoiler":false,"text":"里扎的儿子，父亲不详。"},{"spoiler":false,"text":"没有危害别人的恶意和战斗力，但因为本体是“城”，说是最危险的人也不过分。"},{"spoiler":false,"text":"称号：太陽の御子"},{"spoiler":false,"text":"黒円卓：六位"},{"spoiler":false,"text":"ルーン：復活"},{"spoiler":false,"text":"大アルカナ：隠者"},{"spoiler":false,"text":"占星術：処女宮"},{"spoiler":false,"text":"形態：事象展開型"}],"source":"bangumi","sourceCharacterId":"43385"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a826591d4629105ca3135ff6744f686200f764dd8f565e6fa6d7c8532452eef0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58add28d8a1f232a041b17732a0a5c799977b2fa939f363e2d382a3dc9c62190.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_43386","characterName":"Göetz Von Berlichingen","sourceIds":{"bangumi":[{"characterId":"43386","match":"source-roster","subjectId":"156122"},{"characterId":"43386","match":"source-roster","subjectId":"16849"},{"characterId":"43386","match":"source-roster","subjectId":"187085"},{"characterId":"43386","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"Göetz Von Berlichingen","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"186"}},"descriptions":[{"segments":[{"spoiler":false,"text":"曾经隶属于武装親衛隊第一師団。"},{"spoiler":false,"text":"虽然团内有几个名义上的死人，但他却是真的死过一次，因而作为亡灵、被诅咒者而让同胞感到害怕。"},{"spoiler":false,"text":"另外，在死去时失去了原名，ベルリッヒンゲン也只不过是个称号。"},{"spoiler":false,"text":"几个亲近者称呼他为“マキナ”，但那也似乎不是原名。"},{"spoiler":false,"text":"现状是在柏林沦陷时失踪。"},{"spoiler":false,"text":"称号：鋼鉄の腕"},{"spoiler":false,"text":"黒円卓：七位"},{"spoiler":false,"text":"ルーン：流動"},{"spoiler":false,"text":"大アルカナ：正義"},{"spoiler":false,"text":"占星術：天秤宮"},{"spoiler":false,"text":"形態：特殊発現型"}],"source":"bangumi","sourceCharacterId":"43386"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/940d6b8193252401053e8460b323f9dbbde6cb2112b7772bed5efcc28695a707.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89d243e86fc86603be1e343bda0266720cdbda16f2a35ebd59e6c098c41d14d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安元洋貴","creatorId":"vndb:s377","sourcePersonId":"vndb:s377","canonicalEntityId":"vndb:s377","name":"安元 洋貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:43386:4483:1","source":"bangumi"}]},{"characterId":"char_bangumi_43387","characterName":"魔女的铁锤（Melleus Maleficarum）","sourceIds":{"bangumi":[{"characterId":"43387","match":"source-roster","subjectId":"156122"},{"characterId":"43387","match":"source-roster","subjectId":"16849"},{"characterId":"43387","match":"source-roster","subjectId":"187085"},{"characterId":"43387","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"魔女的铁锤（Melleus Maleficarum）","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"75"},"hip":{"reviewState":"source-only","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"德意志古代遗产继承局的局长，在加入骑士团前踏入魔道的纯正魔女。"},{"spoiler":false,"text":"外表是个少女，但其实际年龄在团员之中属于年长者。"},{"spoiler":false,"text":"因此内里老奸巨猾，表面却装可爱，作为人来说是相当坏的性格。"},{"spoiler":false,"text":"喜欢拷问，很是喜怒无常。虽然不是武斗派，其残忍度却与威廉不分胜负。"},{"spoiler":false,"text":"称号：魔女の鉄槌"},{"spoiler":false,"text":"黒円卓：八位"},{"spoiler":false,"text":"ルーン：束縛"},{"spoiler":false,"text":"大アルカナ：死神"},{"spoiler":false,"text":"占星術：天蠍宮"},{"spoiler":false,"text":"形態：事象展開型"},{"spoiler":false,"text":"位階：創造"},{"spoiler":false,"text":"聖遺物：血の伯爵夫人"}],"source":"bangumi","sourceCharacterId":"43387"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/805490fc6850b851e6df5e2d07e35dd1eb4f637cb2e920f64b686410ad9a2dde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fc46fe93826df03bda92037db4ca798f108fbaf7f881d52877b261941977603.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:43387:4490:1","source":"bangumi"}]},{"characterId":"char_bangumi_43388","characterName":"魔炮兵（Samiel Zentaur）","sourceIds":{"bangumi":[{"characterId":"43388","match":"source-roster","subjectId":"156122"},{"characterId":"43388","match":"source-roster","subjectId":"16849"},{"characterId":"43388","match":"source-roster","subjectId":"187085"},{"characterId":"43388","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"魔炮兵（Samiel Zentaur）","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"bangumi","value":"87"},"height":{"reviewState":"source-only","source":"bangumi","value":"180"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"64"},"weight":{"reviewState":"source-only","source":"bangumi","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"武装亲卫队第二师团的大队长。军人贵族出身的精英，为骑士团首领相关的魔道而着迷。"},{"spoiler":false,"text":"随着他的暗杀事件一起隐藏在暗处，为建立骑士团而尽力。"},{"spoiler":false,"text":"严格而苛烈的性格源于其正统派军人的身份，思想与行动都与玩乐无缘。"},{"spoiler":false,"text":"因此只要她有所行动，最后的结果都不会半吊子。"},{"spoiler":false,"text":"现状是在柏林沦陷时失踪。"},{"spoiler":false,"text":"称号：魔操砲兵"},{"spoiler":false,"text":"黒円卓：九位"},{"spoiler":false,"text":"ルーン：勝利"},{"spoiler":false,"text":"大アルカナ：節制"},{"spoiler":false,"text":"占星術：人馬宮"},{"spoiler":false,"text":"形態：武装具現型"}],"source":"bangumi","sourceCharacterId":"43388"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e92a41265be0d9690493e42913b73ea66d47e0ee4fdbcf1f4896c940b64c0103.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08b3fc7f93262568c6e534866ecac13f403e79c3af218f9a40432e28d5f120b3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"矢口アサミ","creatorId":"vndb:s7969","sourcePersonId":"vndb:s7969","canonicalEntityId":"vndb:s7969","name":"矢口 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:43388:10834:1","source":"bangumi"}]},{"characterId":"char_bangumi_43389","characterName":"Rot Spinne","sourceIds":{"bangumi":[{"characterId":"43389","match":"source-roster","subjectId":"156122"},{"characterId":"43389","match":"source-roster","subjectId":"16849"},{"characterId":"43389","match":"source-roster","subjectId":"187085"},{"characterId":"43389","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"Rot Spinne","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0117"},"height":{"reviewState":"source-only","source":"bangumi","value":"179"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在各地的收容所或者灭绝设施中，重复进行人体实验的疯狂科学家。"},{"spoiler":false,"text":"战后从属于军人的逃亡机关，在团内最公开活动的人。"},{"spoiler":false,"text":"因此，现在专门从事间谍活动，而没有参加螢或者ヴィルヘルム等战斗部队。"},{"spoiler":false,"text":"比起战斗，虐杀弱者更合乎他的兴趣。"},{"spoiler":false,"text":"称号：紅蜘蛛"},{"spoiler":false,"text":"黒円卓：十位"},{"spoiler":false,"text":"ルーン：獲得"},{"spoiler":false,"text":"大アルカナ：悪魔"},{"spoiler":false,"text":"占星術：磨羯宮"},{"spoiler":false,"text":"形態：人器融合型"},{"spoiler":false,"text":"位階：形成"}],"source":"bangumi","sourceCharacterId":"43389"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b314cbfba9e9cce63847f2dcc164ab91fa5b29b25f96307f3a59255b4fdcec6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06f2dc4f94524a0e5c603ae274f326994d37af87a18bd45d69c2d8098254f591.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"はらさわ晃綺","creatorId":"vndb:s2401","sourcePersonId":"vndb:s2401","canonicalEntityId":"vndb:s2401","name":"はらさわ晃綺(原沢勝広)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:43389:4516:1","source":"bangumi"}]},{"characterId":"char_bangumi_43390","characterName":"大淫妇（Babylon Magdalena）","sourceIds":{"bangumi":[{"characterId":"43390","match":"source-roster","subjectId":"156122"},{"characterId":"43390","match":"source-roster","subjectId":"16849"},{"characterId":"43390","match":"source-roster","subjectId":"187085"},{"characterId":"43390","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"大淫妇（Babylon Magdalena）","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"93"},"height":{"reviewState":"source-only","source":"bangumi","value":"174"},"hip":{"reviewState":"source-only","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"60"},"weight":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"与トリファ相识已久，在团内属于辅佐他的立场。"},{"spoiler":false,"text":"在人格缺陷者云集的骑士团中比较有良心的人，属于正常人一类。"},{"spoiler":false,"text":"只是，从巴比伦这个称号就能看出她有产生凶恶之物的特性，她的附属物要比她自身更危险。"},{"spoiler":false,"text":"与圣枪十三骑士团为敌的时候，在某种意义上，是首先得击倒的对手。"},{"spoiler":false,"text":"称号：大淫婦"},{"spoiler":false,"text":"黒円卓：十一位"},{"spoiler":false,"text":"ルーン：輪廻"},{"spoiler":false,"text":"大アルカナ：星"},{"spoiler":false,"text":"占星術：宝瓶宮"},{"spoiler":false,"text":"形態：事象展開型"},{"spoiler":false,"text":"位階：形成"}],"source":"bangumi","sourceCharacterId":"43390"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9ebb21841a3215fad9e2e5a74f14ce05cec02cef454732c66ca4132e19178a3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1da5bfa583fb02393fef6320aa72b5df02e7080aa2aa8ee64c3c21d79b4f7f5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:43390:6547:1","source":"bangumi"}]},{"characterId":"char_bangumi_43391","characterName":"恶名远扬的狼（Hrozvitnir）","sourceIds":{"bangumi":[{"characterId":"43391","match":"source-roster","subjectId":"156122"},{"characterId":"43391","match":"source-roster","subjectId":"16849"},{"characterId":"43391","match":"source-roster","subjectId":"187085"},{"characterId":"43391","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"恶名远扬的狼（Hrozvitnir）","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"武装亲卫队第三师团、骷髅的大队长。兼东部战线游击部队、Einsatzgruppen特别行动部队长。"},{"spoiler":false,"text":"无主义无主张无信念的杀人狂，本来因为无法控制的凶残而遭到肃清，却因为被骑士团所救而活了下来。"},{"spoiler":false,"text":"虽然性格上很有问题，但因为对于杀戮方面异常优秀，所以在实力至上主义的骑士团内地位毫不动摇。"},{"spoiler":false,"text":"现状是在柏林沦陷时失踪。"},{"spoiler":false,"text":"称号：悪名高き狼"},{"spoiler":false,"text":"黒円卓：十二位"},{"spoiler":false,"text":"ルーン：狼"},{"spoiler":false,"text":"大アルカナ：月"},{"spoiler":false,"text":"占星術：双魚宮"},{"spoiler":false,"text":"形態：人器融合型"}],"source":"bangumi","sourceCharacterId":"43391"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b29e5e99c41dabd2ecffa693dd957a3871e106a9a22f83c2572726e6be459be7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/575bc67b1cbf1004c3c0f8a5c1da162a60d416bbba1529e22287a18fd57cef86.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"環有希","creatorId":"vndb:s1849","sourcePersonId":"vndb:s1849","canonicalEntityId":"vndb:s1849","name":"環 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:43391:5488:1","source":"bangumi"}]},{"characterId":"char_bangumi_43392","characterName":"Valkyria","sourceIds":{"bangumi":[{"characterId":"43392","match":"source-roster","subjectId":"156122"},{"characterId":"43392","match":"source-roster","subjectId":"16849"},{"characterId":"43392","match":"source-roster","subjectId":"187085"},{"characterId":"43392","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"Valkyria","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"159"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"先代圣枪十三骑士团第五位。樱井萤的前任者，埃莱奥诺的直属部下。"},{"spoiler":false,"text":"被称为战斗少女的德苏交战的英雄，其实本人是个不张扬的、安分守己的女性。"},{"spoiler":false,"text":"其阳光气质，在全都持有各自的阴暗事迹或者精神障碍的团员中完全是个特例。"},{"spoiler":false,"text":"实际上，只有她一个没有向黒圆桌双首领出卖灵魂，站在与本性不乎的立场是因为某个目的，也因此而在95年香消玉殒。"},{"spoiler":false,"text":"因为她的死而受到影响的人很多。"}],"source":"bangumi","sourceCharacterId":"43392"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3b8a87384f6ab8425105fccabdf3ad9096e4b9786fea59059f1de75a034f927.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5261b761d5a28f3a9bac6caf2217a74c0dff1ba18b4d37358e45db5139edffc.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c22061","characterName":"ラインハルト・トリスタン・オイゲン・ハイドリヒ","sourceIds":{"bangumi":[{"characterId":"40064","match":"source-roster","subjectId":"156122"},{"characterId":"40064","match":"exact-normalized-name-in-linked-work","subjectId":"16849"},{"characterId":"40064","match":"source-roster","subjectId":"16849"},{"characterId":"40064","match":"source-roster","subjectId":"187085"},{"characterId":"40064","match":"exact-normalized-name-in-linked-work","subjectId":"43372"},{"characterId":"40064","match":"source-roster","subjectId":"43372"}],"egsCharacterIds":["13336"],"vndbCharacterId":"c22061"},"originalCharacterName":"ラインハルト・トリスタン・オイゲン・ハイドリヒ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"307"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader of the Longinus Dreizehn Orden. Originally a high-ranking official in Germany, regarded as highly dangerous due to his seemingly boundless talent in all fields. Later, he bowed out of the public eye through the guise of a staged assassination, and formed the Obsidian Round Table alongside Mercurius."},{"spoiler":false,"text":"Their subordinate members acted behind the scenes of WW2 and kept on destroying friend and foe alike. His acts of destruction reached their climax during the fall of Berlin. However, he and his three direct subordinates disappeared shortly afterwards, leaving their current whereabouts a mystery."},{"spoiler":false,"text":"\"You would do well not to disappoint me.\""},{"spoiler":false,"text":"From Dies irae's Kickstarter Campaign Page"}],"source":"vndb","sourceCharacterId":"c22061"},{"segments":[{"spoiler":false,"text":"聖槍十三騎士団黒円卓第一位“愛すべからざる光（メフィスト・フェレス）”。"},{"spoiler":false,"text":"黄金の獣と呼ばれるナチスドイツの高官だったが、あまりに有能すぎたために危険視されるようになる。"},{"spoiler":false,"text":"後、彼は自身が暗殺されたと偽装して闇に潜り、副首領と共に騎士団を結成。"},{"spoiler":false,"text":"配下の団員達を戦争の裏で暗躍させ、敵といわず味方といわず滅ぼし続け、壊し続ける。"},{"spoiler":false,"text":"彼の破壊工作はベルリン陥落時に頂点を迎えるが、その後は直属の部下3名と共に消息を絶ち、現在に至るも行方不明。"},{"spoiler":false,"text":"彼が戻ってきた時に、世界は破滅すると言われている。"}],"source":"egs","sourceCharacterId":"13336","sourceWorkId":"12972","spoiler":false},{"segments":[{"spoiler":false,"text":"圣枪十三骑士団的首领。"},{"spoiler":false,"text":"本来是德意志的高官，因为过于有才能而被处处提防。"},{"spoiler":false,"text":"之后，他以被暗杀作为掩护躲了起来，与メルクリウス一起建立了骑士团。"},{"spoiler":false,"text":"麾下的团员们暗中在战争中活跃，不论敌友一律歼灭破坏。"},{"spoiler":false,"text":"他的破坏工作在柏林沦陷时迎来顶峰，之后与直属部下3名一起失去了消息，直到现在依旧行踪不明。"},{"spoiler":false,"text":"称号：愛すべからざる光"},{"spoiler":false,"text":"黒円卓：一位"},{"spoiler":false,"text":"ルーン：破壊"},{"spoiler":false,"text":"大アルカナ：皇帝"},{"spoiler":false,"text":"占星術：白羊宮"}],"source":"bangumi","sourceCharacterId":"40064"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5797373e741eb306e787d178a1da9fa48472f1b17ac7c83479181748823a532d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25320bbf32a761c5ec642e121cf16a095a2357b64dd1a6085bcc7c6f8cce99d9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:40064:3864:1","source":"bangumi"}]},{"characterId":"char_c28990","characterName":"Kazıklı Bey","sourceIds":{"bangumi":[{"characterId":"40065","match":"exact-normalized-name-in-linked-work","subjectId":"156122"},{"characterId":"40065","match":"source-roster","subjectId":"156122"},{"characterId":"40065","match":"source-roster","subjectId":"16849"},{"characterId":"40065","match":"source-roster","subjectId":"187085"},{"characterId":"40065","match":"source-roster","subjectId":"43372"}],"egsCharacterIds":["7910"],"vndbCharacterId":"c28990"},"originalCharacterName":"Kazıklı Bey","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"710"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"73"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man with a long criminal record who served as a First Lieutenant for the infamous 36th Waffen Grenadier Division of the SS. An albino, he shuns all light, especially that of the sun. In return, all of his senses magnify in the darkness, almost as if he was a vampire. Having embraced that nature of his as part of his identity. Wilhelm's designation and fondness for vampiric characteristics is no coincidence."},{"spoiler":false,"text":"\"State your name, kid. Don't you know anything about proper manners on the battlefield?\""},{"spoiler":false,"text":"From Dies irae's Kickstarter Campaign Page"}],"source":"vndb","sourceCharacterId":"c28990"},{"segments":[{"spoiler":false,"text":"聖槍十三騎士団黒円卓第四位、カズィクル・ベイの異名を持つ男。"},{"spoiler":false,"text":"第二次大戦中から一切歳を取らずに存在し続けており、世界中の紛争地帯に現れては暴虐の限りを尽くす吸血鬼として戦場の伝説となっている。"},{"spoiler":false,"text":"そして現在、長年待ち続けた黄金練成という儀式のために日本へ向かう直前の彼は、接触してきたインタビュアーに己の過去を語り始める。"}],"source":"egs","sourceCharacterId":"7910","sourceWorkId":"22875","spoiler":false},{"segments":[{"spoiler":false,"text":"拥有犯罪者的经历，恶名远扬的隶属于第38SS的武装擲弾兵師団的原中尉。"},{"spoiler":false,"text":"白化病患者，对光线尤其阳光很是避忌。"},{"spoiler":false,"text":"反过来，所有感觉器官会在夜间得到加强的吸血鬼体质。"},{"spoiler":false,"text":"本人也引以为豪，甚至连称号也明显带有吸血鬼的属性。（“穿刺公”是著名的吸血鬼“德古拉伯爵”的原型——弗拉德三世·采佩什的称号。）"},{"spoiler":false,"text":"称号：串刺し公"},{"spoiler":false,"text":"黒円卓：四位"},{"spoiler":false,"text":"ルーン：茨棘"},{"spoiler":false,"text":"大アルカナ：戦車"},{"spoiler":false,"text":"占星術：巨蟹宮"},{"spoiler":false,"text":"形態：人器融合型"},{"spoiler":false,"text":"位階：創造"},{"spoiler":false,"text":"聖遺物：闇の賜物"}],"source":"bangumi","sourceCharacterId":"40065"}],"profileFacts":[],"metadataCandidateConflict