ter","subjectId":"187085"},{"characterId":"27797","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"綾瀬 香純","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0909"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"86"},"height":{"reviewState":"source-only","source":"bangumi","value":"161"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"60"},"weight":{"reviewState":"source-only","source":"bangumi","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女子剑道部部长。好胜加上男人味，与莲是互你耍我我耍你的关系。"},{"spoiler":false,"text":"与以坏名声而出名的莲不同，以明快而亲切的好人性格，以及全国级别的剑技得到很高的知名度。"},{"spoiler":false,"text":"基本上是个大大咧咧的人，但也有着很紧张莲的体贴入微的一面。"},{"spoiler":false,"text":"总是装着一副大姐姐的模样，但其实并不合称。"}],"source":"bangumi","sourceCharacterId":"27797"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fa750c48e09206e9693b9cfe2ff073c17029e9ef183be60b4e608a22ddd8663.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbed41024111784842bfba789c46091079ea185c757d4dfcb029394ae74d3fae.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187085:27797:4705:1","source":"bangumi"}]},{"characterId":"char_bangumi_27798","characterName":"Leonhard August","sourceIds":{"bangumi":[{"characterId":"27798","match":"source-roster","subjectId":"16849"},{"characterId":"27798","match":"source-roster","subjectId":"187085"},{"characterId":"27798","match":"source-roster","subjectId":"43372"}]},"originalCharacterName":"Leonhard August","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0422"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"83"},"height":{"reviewState":"source-only","source":"bangumi","value":"168"},"hip":{"reviewState":"source-only","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"},"weight":{"reviewState":"source-only","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"群集于诹访原市的圣枪十三骑士团中的一员。黑圆桌第五位“狮心剑”。以月乃泽学园2年级学生的身份转入。 第五位是黄道十二宫的狮子座，塔罗牌是象征者力量和斗争的刻印之力。象征战争与荣光、勇气和行动力者。表面上性格冷淡，其实却是心直口快型的激情家。顽固且不听劝告的死脑子。"},{"spoiler":false,"text":"她和ルサルカ以转校生的身份出现为开端，莲的日常开始崩坏。"},{"spoiler":false,"text":"称号：獅子心剣"},{"spoiler":false,"text":"黒円卓：五位"},{"spoiler":false,"text":"ルーン：闘争"},{"spoiler":false,"text":"大アルカナ：力"},{"spoiler":false,"text":"占星術：獅子宮"},{"spoiler":false,"text":"形態：武装具現型"},{"spoiler":false,"text":"位階：創造"},{"spoiler":false,"text":"聖遺物：緋々色金"}],"source":"bangumi","sourceCharacterId":"27798"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a81ef4a5cd8d52b5c1c2196ca83022aeec9f93958d801d978c0c0944463a8c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/581210d617be58988454d5684f21e83573c7345fcdce87205ae93a158440e619.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 