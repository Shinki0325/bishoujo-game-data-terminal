:false,"text":"屋敷を取り仕切っていて、鈴などの上役を務める。"},{"spoiler":false,"text":"雅也の母親の妹で、雅也は彼女の甥に当たる。"},{"spoiler":false,"text":"とにかく村のことを第一に考え、当主である雅也の父の亡き後、陰に日なたに村を支えてきた人物。"},{"spoiler":false,"text":"雅也を呼び寄せようと考えたのも彼女らしいのだが……。"},{"spoiler":false,"text":"「雅也さんにはできるだけ早くお嫁さんを決めてもらわないと……」"}],"source":"bangumi","sourceCharacterId":"47270"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8886a8a78bf485dc024654f048651f5c177e393b1bf38a7dbf651a64eef354b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd583c874b3a6b3791fec9b9ba2dad03afa2315aea98a5dd540760bf14c491e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:120319:47270:6380:1","source":"bangumi"}]},{"characterId":"char_c18642","characterName":"七和 優雨","sourceIds":{"bangumi":[{"characterId":"47272","match":"exact-normalized-name-in-linked-work","subjectId":"105288"},{"characterId":"47272","match":"exact-normalized-name-in-linked-work","subjectId":"120319"}],"egsCharacterIds":["3489"],"vndbCharacterId":"c18642"},"originalCharacterName":"七和 優雨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"雪希の妹。"},{"spoiler":false,"text":"村内唯一の学園に通っている女子校生。"},{"spoiler":false,"text":"弓道部に所属している。"},{"spoiler":false,"text":"非常に姉想いで、よく役場に来ては雪希の手伝いをしている。"},{"spoiler":false,"text":"雅紀の事は、雪希を狙っている悪い男だと思っていて、最初は敵対視している。"},{"spoiler":false,"text":"気の強いしっかり者。"},{"spoiler":false,"text":"凛とした雰囲気を持っていてしっかりしているが、年相応に甘えたい時もある様子。"}],"source":"egs","sourceCharacterId":"3489","sour