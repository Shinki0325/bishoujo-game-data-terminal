","sourcePersonId":"vndb:s577","canonicalEntityId":"vndb:s577","name":"葵渚","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:71649","source":"vndb"},{"creditedName":"神月 社","creatorId":"vndb:s4003","sourcePersonId":"vndb:s4003","canonicalEntityId":"vndb:s4003","name":"神月 社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:71654","source":"vndb"},{"creditedName":"ayachi","creatorId":"vndb:s4154","sourcePersonId":"vndb:s4154","canonicalEntityId":"vndb:s4154","name":"ayachi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:71655","source":"vndb"},{"creditedName":"朝見 凛","creatorId":"vndb:s14968","sourcePersonId":"vndb:s14968","canonicalEntityId":"vndb:s14968","name":"朝見 凛","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:71657","source":"vndb"}]},"cast":[{"characterId":"char_c52493","characterName":"香住 恋","sourceIds":{"bangumi":[{"characterId":"50062","match":"exact-normalized-name-in-linked-work","subjectId":"18287"}],"egsCharacterIds":["10090"],"vndbCharacterId":"c52493"},"originalCharacterName":"香住 恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の自宅の隣に住んでいる未亡人で、香住愛の母親。"},{"spoiler":false,"text":"両親の反対を押し切る形で、若くして娘である愛を出産するも、その後すぐに夫を亡くしてしまい、以来、地元の商店街などで働きながらひとり娘を育ててきた。"},{"spoiler":false,"text":"海外出張でよく家を留守にしている主人公の両親にかわって、彼の面倒を見ることが多い。頼れる大人の女性。"},{"spoiler":false,"text":"基本的にマイペースで人当たりが良く、のんびりとした穏やかな性格。"},{"spoiler":false,"text":"しかし根本の部分では非常に頑固で意思の強い面も持っており、ときに周囲を驚かせるような突飛な行動に出ることもある。"},{"spoiler":false,"text":"年頃の娘を持つ母親にはとても見えないほど、若々しく綺麗な容姿をしている。"},{"spoiler":false,"text":"そのうえ性格も良く未亡人、ということで地元商店街ではアイドルのような存在であり、求婚者が後を絶たない。"},{"spoiler":false,"text":"特技は料理と買い物、オリジナルの鼻歌作り。"},{"spoiler":false,"text":"苦手なものは虫と、人の頼みを断ること。"}],"source":"egs","sourceCharacterId":"10090","sourceWorkId":"15426","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の自宅の隣に住んでいる未亡人で、香住愛の母親。"},{"spoiler":false,"text":"海外出張でよく家を留守にしている主人公の両親にかわって、彼の面倒を見ることが多い。頼れる大人の女性。"},{"spoiler":false,"text":"基本的にマイペースで人当たりが良く、のんびりとした穏やかな性格。"},{"spoiler":false,"text":"しかし根本の部分では非常に頑固で意思の強い面も持っており、ときに周囲を驚かせるような突飛な行動に出ることもある。"},{"spoiler":false,"text":"年頃の娘を持つ母親にはとても見えないほど、若々しく綺麗な容姿をしている。"},{"spoiler":false,"text":"そのうえ性格も良く未亡人、ということで地元商店街ではアイドルのような存在であり、求婚者が後を絶たない。"},{"spoiler":false,"text":"周囲に対しては完璧とも言える気遣いのできる女性だが、自分のことに関しては興味が薄く、色々と失敗をすることも多い。"},{"spoiler":false,"text":"このため、主人公や娘の愛に助けられることもしばしば。"},{"spoiler":false,"text":"特技は料理と買い物、オリジナルの鼻歌作り。苦手なものは虫と、人の頼みを断ること。"}],"source":"bangumi","sourceCharacterId":"50062"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"10090","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"10090","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"10090","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"10090","sourceWorkId":"15426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cc6baea361c7da4128cdf6f5636c779dba4c81f14fd18f6afd69976c3fca5ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbab5587a3761324207ba120b64a8b1c3c26ed1489efbedea1ee5ee09443e78d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18287:50062:5741:1","source":"bangumi"}]},{"characterId":"char_c52494","characterName":"アイアイ","sourceIds":{"bangumi":[{"characterId":"50063","match":"exact-normalized-name-in-linked-work","subjectId":"18287"}],"egsCharacterIds":["10091"],"vndbCharacterId":"c52494"},"originalCharacterName":"アイアイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1224"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の自宅の隣に住んでいる、幼馴染。香住恋のひとり娘。"},{"spoiler":false,"text":"お隣さんであり、ともにひとりっ子である主人公とは、幼い頃から兄妹のように育ってきた。"},{"spoiler":false,"text":"父親の死の影響もあり、小さい頃には暗く落ち込んでいることも多かったが、主人公が川で溺れた事件をきっかけに変わり、以来、男子などに積極的に混じって遊ぶことも多くなった。"},{"spoiler":false,"text":"その頃の経験が、現在でも異性に対して壁を作ることのない性格にあらわれている。"},{"spoiler":false,"text":"女手ひとつで自分を育ててくれた母親、恋との絆は非常に深い。"},{"spoiler":false,"text":"おっとりした性格の母、恋とは逆に、非常に快活で活動的な性格をしている。"},{"spoiler":false,"text":"勉強やスポーツなど、どんなことにでも常に本気で、優秀な成績を残している。"},{"spoiler":false,"text":"その容姿と相まって学園内ではアイドル的な存在であり、男女を問わず人気がある。"},{"spoiler":false,"text":"部活動では水泳部に所属しており、県の強化認定選手に選ばれるほどの成績を収めている。"}],"source":"egs","sourceCharacterId":"10091","sourceWorkId":"15426","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の自宅の隣に住んでいる、幼なじみ。香住恋のひとり娘。"},{"spoiler":false,"text":"お隣さんであり、ともにひとりっ子である主人公とは、幼い頃から兄妹のように育ってきた。"},{"spoiler":false,"text":"おっとりした性格の母・恋とは逆に、非常に快活で活動的な性格をしている。"},{"spoiler":false,"text":"勉強やスポーツなど、どんなことにでも常に本気で、優秀な成績を残している。"},{"spoiler":false,"text":"その容姿と相まって学園内ではアイドル的な存在であり、男女を問わず人気がある。"},{"spoiler":false,"text":"部活動では水泳部に所属しており、県の強化認定選手に選ばれるほどの成績を修めている。"},{"spoiler":false,"text":"ただし料理の腕前だけは致命的で、その腕前は主人公をして “化学兵器” と言わしめるほど。"},{"spoiler":false,"text":"女手ひとつで自分を育ててくれた母親・恋との絆は非常に深い。"}],"source":"bangumi","sourceCharacterId":"50063"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10091","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"10091","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"10091","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"10091","sourceWorkId":"15426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd3ec8f1cd578cc7a58094c565cf6e255d51697a0a53158076b3b7ed0ade3f64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e09d74a83a877c63d8ea306782807dd5c4fffd3714abc6fa9064e362ca1362f1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18287:50063:6016:1","source":"bangumi"}]},{"characterId":"char_c52495","characterName":"駆流田 みなと","sourceIds":{"bangumi":[{"characterId":"50064","match":"exact-normalized-name-in-linked-work","subjectId":"18287"}],"egsCharacterIds":["10092"],"vndbCharacterId":"c52495"},"originalCharacterName":"駆流田 みなと","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公、および香住愛の「私立山神学園」入学時からの親友。"},{"spoiler":false,"text":"「霧島重工」の研究員として働いている両親の影響から、理工学系の分野について大人顔負けの知識を持つ、天才肌の女の子。"},{"spoiler":false,"text":"見た目はグラビアアイドル並みの美人で、本人もそのことには自覚的に振舞う。"},{"spoiler":false,"text":"しかし多趣味すぎることもあって異性にはたいして興味を持っておらず、せいぜい異性の親友である主人公をからかう程度である。"},{"spoiler":false,"text":"現在は愛と同じ水泳部に所属しながら、「ひとり写真同好会」を名乗って独自に活動をしたり、愛車の自転車を魔改造したりと、彼女なりに充実しきった毎日を送っている。"},{"spoiler":false,"text":"好奇心が旺盛で、とにかく面白いことが大好き。"},{"spoiler":false,"text":"その実践のために色々と無茶なことをするため、主人公や愛たちの平穏な学園生活は常に彼女によっておびやかされている。"},{"spoiler":false,"text":"さばさばとした性格で、年齢性別の分け隔てなく人に接することができる。"},{"spoiler":false,"text":"話し上手にして聞き上手。"}],"source":"egs","sourceCharacterId":"10092","sourceWorkId":"15426","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公、および香住愛とは入学時からの親友。"},{"spoiler":false,"text":"愛と同じ水泳部に所属しつつ、『ひとり写真同好会』 を名乗って独自に活動をしたり、愛車の自転車を魔改造したりと、彼女なりに充実しきった毎日を送っている。"},{"spoiler":false,"text":"さばさばとした性格で、年齢性別の分け隔てなく人に接することが出来、話し上手にして聞き上手。"},{"spoiler":false,"text":"基本的にはボケ担当でエッチな話題なども好き。"},{"spoiler":false,"text":"愛用の電動付自転車 ワイルド・オンスロート壱号機、略して “ワオン号” は数年前からの相棒。"},{"spoiler":false,"text":"本人の改造によりターボ機能やステルス機能など様々な機能が付加されている。"},{"spoiler":false,"text":"好奇心が旺盛で、とにかく面白いことが大好き。"},{"spoiler":false,"text":"彼女の無茶な行動に、主人公や愛たちの平穏な学園生活は常におびやかされている。"},{"spoiler":false,"text":"特技は話すことと理数系の分野全般、それにトラブルを起こすこと。"},{"spoiler":false,"text":"好きなものは機械いじりや写真、水泳、アニメなど多数。苦手なことはじっとしていること。"}],"source":"bangumi","sourceCharacterId":"50064"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"10092","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"10092","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"10092","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"10092","sourceWorkId":"15426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0177c5c32fb89d0f2dd12300e603de5758165bd177c96c2bea0f644518273c56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3da6be7161179d0cd769162a05f4297f9a4ba401c45fa15a69a2a50a3fbb289a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18287:50064:5906:1","source":"bangumi"}]},{"characterId":"char_c52496","characterName":"山下 朱莉","sourceIds":{"bangumi":[{"characterId":"50065","match":"exact-normalized-name-in-linked-work","subjectId":"18287"}],"egsCharacterIds":["10093"],"vndbCharacterId":"c52496"},"originalCharacterName":"山下 朱莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の親友である山下輝（友人）の、2歳年下の妹。"},{"spoiler":false,"text":"５年ほど前に家族とともに「山神町」へと引っ越してきて、その直後に主人公や香住愛たちと知り合う。"},{"spoiler":false,"text":"生まれつき呼吸器系が弱く、幼い頃や、引っ越してきた直後にはずっと病院への入退院を繰り返していた。"},{"spoiler":false,"text":"ただし、現在では愛とともに水泳の練習をするなどして体質改善を重ね、病気の症状が出ることはほとんどなくなっている。"},{"spoiler":false,"text":"２歳という年齢差のためにこれまで主人公たちと同じ学園に通うことはなかったが、この春から、晴れて同じ「私立山神学園」の１年生として主人公や愛、兄の輝とともに通学をすることになった。"},{"spoiler":false,"text":"身体の弱い自分へのコンプレックスから、内向的で臆病な性格をしていたが、主人公らと出会い、その後の経験を通じて最低限の社交性は身につけている。"},{"spoiler":false,"text":"それでもまだ赤の他人と話すことは苦手であり、生来の無口さも手伝って彼女と親しくない者の目には暗い性格と映ることも多い。"}],"source":"egs","sourceCharacterId":"10093","sourceWorkId":"15426","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の親友である山下輝の、2歳年下の妹。"},{"spoiler":false,"text":"5年ほど前に家族と共に山神町へと引越してきて、その直後に主人公や香住愛たちと知り合う。"},{"spoiler":false,"text":"生まれつき呼吸器系が弱く、幼い頃はずっと病院の入退院を繰り返していたが、愛と共に水泳の練習などで体質改善を重ね、現在では病気の症状が出ることはなくなっている。"},{"spoiler":false,"text":"身体の弱い自分へのコンプレックスから、内向的で臆病な性格をしていたが、主人公らとの出会いやその後の経験を通じて、最低限の社交性は身につけることができた。"},{"spoiler":false,"text":"それでもまだ赤の他人と話すことは苦手であり、生来の無口さも手伝って彼女と親しくない者には暗い性格と映ることも多い。"},{"spoiler":false,"text":"特技は家事全般、好きなことは人の話を聞くことと、猫を観察すること。苦手なものは過度な運動と、埃。"}],"source":"bangumi","sourceCharacterId":"50065"}],"profileFacts":[{"label":"胸围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"10093","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"144 cm","valueContext":null,"source":"egs","sourceCharacterId":"10093","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"10093","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"10093","sourceWorkId":"15426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/005c2270ea1d7ac9cb3ac5af6297805db539eb0ffcce6413b5b8a34733a1cb88.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e27f63f5233df94aaa01356aa0aa483cd5686a8c3d47bb6bf11d1ee6202ef0bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18287:50065:4830:1","source":"bangumi"}]},{"characterId":"char_c52497","characterName":"姫っち","sourceIds":{"bangumi":[{"characterId":"50066","match":"exact-normalized-name-in-linked-work","subjectId":"18287"}],"egsCharacterIds":["10094"],"vndbCharacterId":"c52497"},"originalCharacterName":"姫っち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公、および香住愛のクラスメイト。"},{"spoiler":false,"text":"主人公たちとは1年時、2年時と別クラスであったためほとんど関わることはなかったが、駆流田みなととは住んでいる家も近く、学園入学以前から親友の間柄だった。"},{"spoiler":false,"text":"生来の読書好きがこうじて、学園では1年時からずっと図書委員をしている。"},{"spoiler":false,"text":"3年になり主人公や愛と同じクラスとなった後は、主人公と一緒にクラス委員としての仕事もすることになる。"},{"spoiler":false,"text":"物事の道理やモラルを重視しており、生真面目で融通の利かない性格。"},{"spoiler":false,"text":"頭は良いが価値観の幅が狭く、自分の意見はきちんと主張するタイプなため、他人に対してはやや押し付けがましい面がある。"},{"spoiler":false,"text":"一方で好いた相手（これは同性、異性を問わず）には甘い一面があり、自分とはまったく正反対な親友のみなとの性格についても、内心では羨ましいとさえ思っている。"},{"spoiler":false,"text":"自分の胸が同世代の女性徒に比べて大きいことに対してコンプレックスを抱いており、もとより性的な話題が苦手であることも相まって、エッチなこと全般にかなりの読書家であり、想像力が豊かで感性も優れている反面、思い込みが激しかったり、また運命を信じてしまったりもするタイプ。"}],"source":"egs","sourceCharacterId":"10094","sourceWorkId":"15426","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公、および香住愛のクラスメイト。"},{"spoiler":false,"text":"主人公たちとは1年時、2年時と別クラスであったためほとんど関わることはなかったが、駆流田みなととは住んでいる家も近く、学園入学以前から親友の間柄だった。"},{"spoiler":false,"text":"物事の道理やモラルを重視しており、生真面目で融通の利かない性格。"},{"spoiler":false,"text":"頭は良いが価値観の幅が狭く、自分の意見はきちんと主張するタイプなため、他人に対してはやや押し付けがましい面がある。"},{"spoiler":false,"text":"一方で好いた相手 （同性、異性を問わず） には甘い一面があり、自分とはまったく正反対な親友のみなとの性格についても、内心では羨ましいとさえ思っている。"},{"spoiler":false,"text":"自分の胸が同世代の女子学生に比べて大きいことにコンプレックスを抱いており、もとより性的な話題が苦手であることも相まって、エッチなこと全般について否定的な意見を持っている。"},{"spoiler":false,"text":"かなりの読書家であり、想像力が豊かで感性も優れている反面、思い込みが激しかったり、また運命を信じてしまったりもするタイプ。"},{"spoiler":false,"text":"特技は速読と地獄耳、好きなことは掃除をすること。苦手なものは好色な視線（主に胸への）。"}],"source":"bangumi","sourceCharacterId":"50066"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"10094","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"10094","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"10094","sourceWorkId":"15426","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"10094","sourceWorkId":"15426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/924331e06b1cfd479aa6fed8dfbf4d65c48f45c54f577a2d092b04f7e2e8cd0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80360239c808de3bd2a1c4c23216db8487ac5d032df61a12101cfaef01fd4f14.webp","width":213,"height":256,"