: some names may change the dialogs between the protagonist and Sylvie"}],"source":"vndb","sourceCharacterId":"c55634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04e6beafa06d2c371589e3f5aad870ca3bb032ec18f097a62b4521496454b01b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e44783d2d8fc3b1e1fb90cb0d7dec4b96d1926eec461d0e905001886e39d5f7.webp","width":107,"height":178,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c55635","characterName":"シルヴィ","sourceIds":{"vndbCharacterId":"c55635"},"originalCharacterName":"シルヴィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A little orphan who was enslaved by a cruel man. Her body is full of scars from abuse and torture to which she was subjected for years; the former owner only abused her physically, for some strange reason she was never raped."},{"spoiler":false,"text":"She is given to protagonist by Ferrum, initially she expected to be subjected to torture but instead, she receives something new in her life... love."}],"source":"vndb","sourceCharacterId":"c55635"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b4f3a4a5171aae54b2d888a7e5ad33fc08a7e22d6b59ecde1cb1dc56775c15e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae84345cc827be1e6e92711fc6665a466a18ef4590d6ab03a20acfe45378b993.webp","width":112,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c55639","characterName":"Ferrum","sourceIds":{"vndbCharacterId":"c55639"},"originalCharacterName":"Ferrum","characterNameSource":null,"role":"side","stat