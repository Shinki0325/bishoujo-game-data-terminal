identityStatus":"source-native","relationId":"vndb:vn-staff:111715","source":"vndb"},{"creditedName":"劇情テノール","creatorId":"vndb:s10462","sourcePersonId":"vndb:s10462","canonicalEntityId":"vndb:s10462","name":"劇情テノール","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:111723","source":"vndb"},{"creditedName":"れもたろ","creatorId":"vndb:s10721","sourcePersonId":"vndb:s10721","canonicalEntityId":"vndb:s10721","name":"れもたろ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:111724","source":"vndb"},{"creditedName":"木野 寧","creatorId":"vndb:s14580","sourcePersonId":"vndb:s14580","canonicalEntityId":"vndb:s14580","name":"木野 寧","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:111726","source":"vndb"},{"creditedName":"新城 歌澄","creatorId":"vndb:s41499","sourcePersonId":"vndb:s41499","canonicalEntityId":"vndb:s41499","name":"新城 歌澄","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:111728","source":"vndb"},{"creditedName":"鬼頭えん","creatorId":"vndb:s41950","sourcePersonId":"vndb:s41950","canonicalEntityId":"vndb:s41950","name":"鬼頭えん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:111729","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c19371","characterName":"田村媛命","sourceIds":{"vndbCharacterId":"c19371"},"originalCharacterName":"田村媛命","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The same as Hanyuu, the leader of those that are not human. Lived in \"that place\" for a long time, even in the past, where she once fought with Hanyuu."},{"spoiler":false,"text":"Relations with Hanyuu are cold and have not been exchanged for more than 100 years. Hanyuu is not kind to her either. They don't want to see each other again. The troubles of the gods... bring unfortunate disasters to the world..."},{"spoiler":false,"text":"......The story is about a tragedy again."},{"spoiler":false,"text":"From Tamurahime no Mikoto on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c19371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14249d8d2c9623c63ed9e98d894eb0fc14f32f512e3e7dc452ede1d09634a4af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d665959c8a81a8fb5e79b1e3b2af26b899de5285581d939cfdc562024d7fb0b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條 愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59715","source":"vndb"}]},{"characterId":"char_vndb_c32092","characterName":"采","sourceIds":{"vndbCharacterId":"c32092"},"originalCharacterName":"采","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An unfortunate girl who happened to be in Hinamizawa while a tragedy was brewing. Was she unhappy because she was in Hinamizawa that day? Or maybe it's because she met them..."},{"spoiler":false,"text":"From Une on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c32092"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae90dc95e84d41eafa1fcccc60de8cddc4e589950303f73c501b5518a27ccb23.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e0a5b2c687402cb36ddbcd43a9d4cfbc6d641d328462ef9dde2da6a15457a1b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"洲崎 綾","creatorId":"vndb:s3893","sourcePersonId":"vndb:s3893","canonicalEntityId":"vndb:s3893","name":"洲崎 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59726","source":"vndb"}]},{"characterId":"char_vndb_c3786","characterName":"前原 圭一","sourceIds":{"vndbCharacterId":"c3786"},"originalCharacterName":"前原 圭一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"413"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this story."},{"spoiler":false,"text":"He is temperamental and hot blooded, but at the same time he's also indecisive. He gets shy around girls easily... He is the sort of character you would find in the lead role of a love story."},{"spoiler":false,"text":"As a matter of course, he's not very honest about himself. And of course, he's also quite popular with the girls."},{"spoiler":false,"text":"Unfortunately this isn't a love story, so his personality won't do him much good. Quite the opposite, in fact..."},{"spoiler":true,"text":"At his old school, Keiichi grew bored of getting good grades and bought a BB gun, entertaining himself by shooting at younger kids as they were walking home. His parents determined that they were also at fault for not realizing Keiichi's unhappiness and struggles, and so they moved to Hinamizawa to help Keiichi get a fresh start."},{"spoiler":false,"text":"From Keiichi Maebara on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3786"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa20bc09c71f234538acb5c5a42e6ba5204107d2b1e1c601eeda51ba937523fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85a22143c63022a1d43fc52afafd857e20118bb47e66c70cba032d5a799bb282.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"保志 総一朗","creatorId":"vndb:s114","sourcePersonId":"vndb:s114","canonicalEntityId":"vndb:s114","name":"保志 総一朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59717","source":"vndb"}]},{"characterId":"char_vndb_c3787","characterName":"竜宮 レナ","sourceIds":{"vndbCharacterId":"c3787"},"originalCharacterName":"竜宮 レナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"birthday":{"reviewState":"source-only","source":"vndb","value":"728"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rena is a classmate of Keiichi's. She is quite interested in his everyday life, possibly because of an inherent urge to look after people."},{"spoiler":false,"text":"She comes with the standard-issue honesty, earnesty and blushes that you find in many heroines."},{"spoiler":false,"text":"However, her only reward for taking care of Keiichi is an incessant series of pranks. It really is unfortunate for her."},{"spoiler":false,"text":"She likes anything and everything she considers adorable, and this is also a very typical trait in a heroine."},{"spoiler":false,"text":"But that is also her greatest weakness..."},{"spoiler":true,"text":"Rena originally called herself Ryuuguu Reina, being born and raised in Hinamizawa. Her family moved to Ibaraki for her mother's work. After her parents divorced, Reina's mental state deteriorated to the point where in 1982 she went on a rampage destroying windows in her school and attacked three students, permanently blinding one of them in one eye. She claimed to hear Oyashiro-sama telling her to return to Hinamizawa, believing she was cursed for leaving the village in the first place."},{"spoiler":false,"text":"Edited from Rena Ryuugu on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf35df8acbb7c44d3ee9c1cb85f85aa8c8d0645c291074fdebd1388be0db569c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfc60f301111244e680dcc6c3fe2ecdd82297e284fba78ca5c212d7944ed6282.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中原 麻衣","creatorId":"vndb:s444","sourcePersonId":"vndb:s444","canonicalEntityId":"vndb:s444","name":"中原 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59718","source":"vndb"}]},{"characterId":"char_vndb_c3788","characterName":"園崎 魅音","sourceIds":{"vndbCharacterId":"c3788"},"originalCharacterName":"園崎 魅音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"710"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mion is one grade higher than Keiichi. She is the class representative."},{"spoiler":false,"text":"She is the active class representative type, which is the second most common type."},{"spoiler":false,"text":"She is a leader, someone who makes friends with everyone, regardless of gender or age."},{"spoiler":false,"text":"Because of her high-strung, easy-going, hyperactive personality, those around her never have to be bored. She is about the best kind of friend anyone could wish for."},{"spoiler":false,"text":"Her personality is somewhat marred by a tendency to sound like an old man, but that's something to be forgiven."},{"spoiler":false,"text":"Mion likes games of all kinds, be they card games, board games or video games. Because of who she is, her games tend to be high-tension. It's to be expected."},{"spoiler":false,"text":"She plays with her friends in the context of club activity."},{"spoiler":true,"text":"Mion was born under the name \"Sonozaki Shion\", but had swapped places with her twin sister on the day that the heir to the family head was to be given the demon tattoo, and as such permanently assumed the role of \"Sonozaki Mion\". She denies knowing about the tattoo arrangement beforehand."},{"spoiler":false,"text":"Edited from Mion Sonozaki on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3788"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a84dd566cafb3ca9dc70dfa69196f71e7cb2ae21341d50801f9dd200753e69c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd15e73b7f679668810252bb1d950b8b1c272e4d5c960a02664c3d4f21226b81.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野 五月","creatorId":"vndb:s474","sourcePersonId":"vndb:s474","canonicalEntityId":"vndb:s474","name":"ゆきの さつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59719","source":"vndb"},{"creditedName":"小市 眞琴","creatorId":"vndb:s21729","sourcePersonId":"vndb:s21729","canonicalEntityId":"vndb:s21729","name":"小市 眞琴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59728","source":"vndb"}]},{"characterId":"char_vndb_c3789","characterName":"北条 沙都子","sourceIds":{"vndbCharacterId":"c3789"},"originalCharacterName":"北条 沙都子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"11"},"birthday":{"reviewState":"source-only","source":"vndb","value":"624"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl one grade lower than Keiichi."},{"spoiler":false,"text":"She is usually very polite, but because she is still young she sometimes has difficulty with grammar."},{"spoiler":false,"text":"However, behind her innocent exterior lies a personality that loves setting traps for other people. You could call her a trickster. She tries her utmost to snare Keiichi, but she has only limited success."},{"spoiler":false,"text":"Although the result of failure is easily imaginable, Satoko doesn't like to lose, and she doesn't learn from experience. That is why she keeps confronting him, with all due consequences."},{"spoiler":false,"text":"Even when she realizes her skills are insufficient, her smile never wavers."},{"spoiler":true,"text":"In 1980, Satoko developed terminal symptoms of Hinamizawa Syndrome, stemming from her dislike of her parents. When they went to the observation platform at the park, Satoko pushed her parents off and killed them. Satoko had no memory of the event."},{"spoiler":false,"text":"Edited from Satoko Houjou on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8020e1e80789b11916467bb8eaa84bdec3ea7e1faa3357ad9ba3b0c8226f22fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dc7121051d5703908f30bd90322ae97656a9d40f8c55f7b25ed6518ca3db040.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かない みか","creatorId":"vndb:s1818","sourcePersonId":"vndb:s1818","canonicalEntityId":"vndb:s1818","name":"かない みか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59724","source":"vndb"}]},{"characterId":"char_vndb_c3790","characterName":"古手 梨花","sourceIds":{"vndbCharacterId":"c3790"},"originalCharacterName":"古手 梨花","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"11"},"birthday":{"reviewState":"source-only","source":"vndb","value":"821"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rika is a grade lower than Keiichi, and thus is a classmate of Satoko's."},{"spoiler":false,"text":"She is very quiet and reserved for her age, which makes her almost the polar opposite of Satoko. However, the two of them can often be found in each other's company."},{"spoiler":false,"text":"Whenever Satoko is in tears after losing against Keiichi, it is Rika who cheers her up. When Satoko wins, Rika comforts Keiichi instead. When Keiichi teases Rena, Rika comforts her."},{"spoiler":false,"text":"In fact, Rika comforts whomever is in need of comfort."},{"spoiler":false,"text":"She seems happy with it."},{"spoiler":true,"text":"When by herself or with Hanyuu, Rika completely drops her cutesy and child-like personality and displays a much more cynical, mature, apathetic, serious and occasionally hostile personality, developed as a result of her 100 years of traveling through the Sea of Fragments."},{"spoiler":false,"text":"From Rika Furude on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5a7406a56252303677b71dd3e1a7b48268cb50cd7d95b24312492b43982de3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9140e480b0ef1fc04ab136a643fe3edf39b041dcefcd2dcb3471fbbb22e5b4e3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村 ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59716","source":"vndb"},{"creditedName":"青木 志貴","creatorId":"vndb:s21728","sourcePersonId":"vndb:s21728","canonicalEntityId":"vndb:s21728","name":"青木 志貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59727","source":"vndb"}]},{"characterId":"char_vndb_c3814","characterName":"園崎 詩音","sourceIds":{"vndbCharacterId":"c3814"},"originalCharacterName":"園崎 詩音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"710"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The twin sister of Sonozaki Mion."},{"spoiler":false,"text":"Like her older sister, she has a crafty personality and may be even more adept at worldly affairs than Mion."},{"spoiler":true,"text":"She has a soft spot for Satoshi and wanted to help him out, so she took the job of manager of the Hinamizawa Fighters."},{"spoiler":false,"text":"She usually lives in Okinomiya and doesn't go to and from the village often."},{"spoiler":true,"text":"Shion was actually born the older sister. On the day she was supposed to get her demon tattoo signifying her status as the family successor, the twins switched. Thus, the younger sister received the tattoo and was forced to become Mion while the older sister started to live as Shion."},{"spoiler":true,"text":"As the perceived younger twin, Shion was eventually sent to the boarding school St. Lucia, remaining there for years before getting tired of it and escaping with the help of Kasai Tatsuyoshi in 1982 to live in Okinomiya."},{"spoiler":false,"text":"Edited from Shion Sonozaki on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3814"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32832cbaa688fc0e9a1e1ed4ffffcae5110c8ec668f1a20864d0e7388e8a4364.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1788d8aa14f74d4a2f3b68ea9f922e7d8293de945fd8085aa368f4ecb1619809.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野 五月","creatorId":"vndb:s474","sourcePersonId":"vndb:s474","canonicalEntityId":"vndb:s474","name":"ゆきの さつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59720","source":"vndb"}]},{"characterId":"char_vndb_c3817","characterName":"古手 羽入","sourceIds":{"vndbCharacterId":"c3817"},"originalCharacterName":"古手 羽入","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"801"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her favorite food is cream puffs and she doesn't like horns growing on her head. She was timid and easy to tease, and she was able to quickly get to know each other in the village and enjoy the long-awaited \"school\" life..."},{"spoiler":false,"text":"For her, this event was a big event that she had never expected."},{"spoiler":false,"text":"Hinamizawa is wrapped in a tragedy again."},{"spoiler":true,"text":"Hanyuu is Furude Rika's ancestor and the true form of Oyashiro-sama. With her powers, Rika is able to travel between Fragments every time she dies and experience different events in an attempt to escape fate."},{"spoiler":false,"text":"Edited from Hanyuu on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83b3359076ab82871dd98c60b6b68d054dd457e37d4b17a8aa12a20fc651f074.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88e61ad26b6cf0924050c01ac1ff1752b0ef11a6eb42d055b39caba9a8fbab95.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59714","source":"vndb"}]},{"characterId":"char_vndb_c3828","characterName":"入江 京介","sourceIds":{"vndbCharacterId":"c3828"},"originalCharacterName":"入江 京介","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1203"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a doctor at the Hinamizawa clinic and is a very respectable man, except for his perversion."},{"spoiler":false,"text":"On his days off, he is also the manager of the Hinamizawa Fighters, and is taken care of and very well respected by the villagers."},{"spoiler":true,"text":"The Irie Institute was established in Hinamizawa where he and Takano worked together on researching Hinamizawa Syndrome, having experimented on various people that were kidnapped under the guise of Oyashiro-sama's curse."},{"spoiler":false,"text":"From Kyousuke Irie on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3828"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ede29117251634f32d1f5b1969d992948b22563b218318a59fc0369d3bbaaa9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90c47858cfb81c54e8f2346ee89b7e0a89435e7c44f6f3ee2929a316569b21a2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"関 俊彦","creatorId":"vndb:s741","sourcePersonId":"vndb:s741","canonicalEntityId":"vndb:s741","name":"関 俊彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59722","source":"vndb"}]},{"characterId":"char_vndb_c3838","characterName":"葛西 辰由","sourceIds":{"vndbCharacterId":"c3838"},"originalCharacterName":"葛西 辰由","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1223"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An executive of the Sonozaki Corps."},{"spoiler":false,"text":"He often works for Shion as a chaperone."},{"spoiler":false,"text":"He looks mild-mannered, but rumor says he's got many heroic stories from his youth."},{"spoiler":false,"text":"He has a sweet tooth and is a heavy drinker."},{"spoiler":true,"text":"It's suggested that Kasai was in a love triangle with Akane and the twins' father in the past, and though he lost in the end, Kasai still stuck around as their dad's friend. During the dam war Kasai went to get sniper training."},{"spoiler":false,"text":"From Tatsuyoshi Kasai on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3838"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f5e1280ec36fd9958958e048bb59c18e33a449b89c9c4195fa59353b6312b3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a951a39c92df720502d8d6074287506a7f1e9c54bcd483b849a8b6291db6b3f9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立木 文彦","creatorId":"vndb:s1943","sourcePersonId":"vndb:s1943","canonicalEntityId":"vndb:s1943","name":"立木 文彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59725","source":"vndb"}]},{"characterId":"char_vndb_c3848","characterName":"富竹 ジロウ","sourceIds":{"vndbCharacterId":"c3848"},"originalCharacterName":"富竹 ジロウ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"914"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A freelance photographer who visits Hinamizawa for the purpose of shooting wild birds. He seems to visit every year, and it's shown that he's on friendly terms with Mion and Rena. He seems to be interested in Takano, and he's always asking her to date and form a relationship."},{"spoiler":true,"text":"Tomitake served as a sniper in the army. After he suffered from an eye injury, he was moved to the position of sniping instructor. He holds the rank of First Lieutenant in the JSDF."},{"spoiler":false,"text":"From Jirou Tomitake on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/608287fd37e693b67d5240666fbc64149a548a613320923627467b75a4eb126b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce178983db2b8eeb06d4b04b95361d02037a5f44448aae4b4b70780912918530.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大川 透","creatorId":"vndb:s551","sourcePersonId":"vndb:s551","canonicalEntityId":"vndb:s551","name":"大川 透","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59721","source":"vndb"}]},{"characterId":"char_vndb_c3861","characterName":"鷹野 三四","sourceIds":{"vndbCharacterId":"c3861"},"originalCharacterName":"鷹野 三四","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"620"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nurse at the Irie Clinic, loved by everyone in the village. She has a somewhat mysterious atmosphere and always has a meaningful smile. In occult mania, she seems to be very interested in the \"Oyashiro-sama\" faith in Hinamizawa."},{"spoiler":true,"text":"Takano Miyo was born Tanashi Miyoko and is the mastermind behind the Great Hinamizawa Disaster, involving the murder of Tomitake Jirou, Furude Rika, Irie Kyousuke, and later the entire village of Hinamizawa."},{"spoiler":false,"text":"Edited from Miyo Takano on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3861"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eb3ce875509783f07883edbfc7bfb90a93b278431fda704c670981e399704d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b8a291a390c3cb622390b1073d959a823c64a147a8943f807b4e7e7643b69c9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 美紀","creatorId":"vndb:s886","sourcePersonId":"vndb:s886","canonicalEntityId":"vndb:s886","name":"伊藤 美紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59723","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p82","sourceCompanyId":"egs:brand:1228","canonicalEntityId":"vndb:p82","name":"07th Expansion","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:32062:1228","source":"egs"},{"companyId":"vndb:p82","sourceCompanyId":"vndb:p82","canonicalEntityId":"vndb:p82","name":"07th Expansion","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:106632:v15523","source":"vndb"},{"companyId":"vndb:p6066","sourceCompanyId":"vndb:p6066","canonicalEntityId":"vndb:p6066","name":"株式会社エンターグラム","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106633:v15523","source":"vndb"},{"companyId":"vndb:p15667","sourceCompanyId":"vndb:p15667","canonicalEntityId":"vndb:p15667","name":"Lancher","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107097:v15523","source":"vndb"},{"companyId":"vndb:p82","sourceCompanyId":"vndb:p82","canonicalEntityId":"vndb:p82","name":"07th Expansion","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:118935:v15523","source":"vndb"},{"companyId":"vndb:p6066","sourceCompanyId":"vndb:p6066","canonicalEntityId":"vndb:p6066","name":"株式会社エンターグラム","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:118936:v15523","source":"vndb"},{"companyId":"vndb:p8907","sourceCompanyId":"vndb:p