oleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:101185","source":"egs"},{"creditedName":"CRUCCU","creatorId":"vndb:s2032","sourcePersonId":"vndb:s2032","canonicalEntityId":"vndb:s2032","name":"CRUCCU","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:66061","source":"vndb"},{"creditedName":"キド カヲル","creatorId":"vndb:s3056","sourcePersonId":"vndb:s3056","canonicalEntityId":"vndb:s3056","name":"キド カヲル","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:66066","source":"vndb"},{"creditedName":"山本 周防","creatorId":"vndb:s10248","sourcePersonId":"vndb:s10248","canonicalEntityId":"vndb:s10248","name":"山本 周防","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:66071","source":"vndb"},{"creditedName":"山本 周防","creatorId":"vndb:s10248","sourcePersonId":"vndb:s10248","canonicalEntityId":"vndb:s10248","name":"山本 周防","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66072","source":"vndb"}]},"cast":[{"characterId":"char_c50809","characterName":"長谷部 桜花","sourceIds":{"bangumi":[{"characterId":"145859","match":"exact-normalized-name-in-linked-work","subjectId":"229213"}],"egsCharacterIds":["18743"],"vndbCharacterId":"c50809"},"originalCharacterName":"長谷部 桜花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の上司で「特警」の長官。"},{"spoiler":false,"text":"若くして長官に任命された切れ者……なのだが、普段は、ほんわかした雰囲気を醸し出すのんびりした女性。"},{"spoiler":false,"text":"しかし、事に臨むときは信じられないほどの果断速攻を見せ、自ら先陣を切って敵中に飛び込み、刀を振るう。"}],"source":"egs","sourceCharacterId":"18743","sourceWorkId":"10454","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が所属する特警の長官。一見ほわわんとした印象で、初めて会う人間からは「なんでこんなのがとっぷ!?」と驚かせるが、実際は実力でその地位に任命された切れ者。"},{"spoiler":false,"text":"先祖伝来の宝刀を操り、現場では鬼神のごとき強さを発揮する。が、普段は人懐っこい性格で部下である主人公とも気軽に話す。"},{"spoiler":false,"text":"そのような彼女が、なぜ特警長官という激務についているのかが物語の重要なテーマとなるようだが？"}],"source":"bangumi","sourceCharacterId":"145859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d29faf0b6cac4ed3ff0d8856e0deb4cea5bd97bbba60c1f48fbbc87ab479753.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f8efb33298320a7c32c365a410c2df9972000d99027aedddc866c060d961108.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229213:145859:5890:1","source":"bangumi"}]},{"characterId":"char_c50810","characterName":"斎賀 栞","sourceIds":{"bangumi":[{"characterId":"145860","match":"exact-normalized-name-in-linked-work","subjectId":"229213"}],"egsCharacterIds":["18744"],"vndbCharacterId":"c50810"},"originalCharacterName":"斎賀 栞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、親友の妻。"},{"spoiler":false,"text":"おっとりしているが芯が強いタイプ。"},{"spoiler":false,"text":"主人公の「知られたくない部分」を最も知っている人物で、何気ない一言で、主人公に精神的ダメージを与えることもあり、何気に頭が上がらなかったりする。"},{"spoiler":false,"text":"勘が異常に鋭く、亭主と主人公が良からぬことを企んでいると、極めて明敏に察知する特技を持つ。"}],"source":"egs","sourceCharacterId":"18744","sourceWorkId":"10454","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、相棒同心の妻。おっとりとしているが芯が強い。"},{"spoiler":false,"text":"主人公の知られたくない部分（子ども時代の他愛も無い思い出）を最も知っている存在。天然なところがあり、知らず知らずに主人公に精神的ダメージを与えていることも。"},{"spoiler":false,"text":"亭主とは親の薦めで結婚した。主人公とは同い年だが月単位でお姉ちゃんで、姉弟のような感情で接する。"}],"source":"bangumi","sourceCharacterId":"145860"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e0e36c1c538624f13b7039be52f1dee2c016785bf5e1a68d19021128792e68b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3b2cc665e8743478f940847a52529faee5f19ae2e97de975040c3035232e64a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229213:145860:4463:1","source":"bangumi"}]},{"characterId":"char_c50811","characterName":"内田 結衣","sourceIds":{"bangumi":[{"characterId":"145861","match":"exact-normalized-name-in-linked-work","subjectId":"229213"}],"egsCharacterIds":["18745"],"vndbCharacterId":"c50811"},"originalCharacterName":"内田 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に仕える密偵。"},{"spoiler":false,"text":"彼の手足となり、賊の動きを探るため屋敷に忍び込んだり、時には、あえて賊と寝たりと、様々な情報収集活動を行う。"},{"spoiler":false,"text":"主人公のことをまだ信頼しておらず、ぶつかることもしばしば。"},{"spoiler":false,"text":"また、女になれていない主人公をからかっては、楽しんでいることも。"}],"source":"egs","sourceCharacterId":"18745","sourceWorkId":"10454","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が使う、元盗賊の密偵。まだ信頼関係は築けておらず、ぶつかることもしばしば。"},{"spoiler":false,"text":"主人公に対しては、やんちゃな少年のような態度をとるが、情報収集の仕事の中では初心な娘を演じてみたり、妖艶な娼婦を演じてみたりと様々な表情を見せる。"},{"spoiler":false,"text":"胸元の大きく開いた大胆な服を好み、女性に慣れていない主人公をよくからかう。"}],"source":"bangumi","sourceCharacterId":"145861"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/term