s22108","name":"松井 章","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:172026","source":"vndb"},{"creditedName":"やけざけ","creatorId":"vndb:s24012","sourcePersonId":"vndb:s24012","canonicalEntityId":"vndb:s24012","name":"やけざけ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:172027","source":"vndb"}]},"cast":[{"characterId":"char_c77587","characterName":"イヴ","sourceIds":{"bangumi":[{"characterId":"68137","match":"exact-normalized-name-in-linked-work","subjectId":"267514"}],"egsCharacterIds":["20682"],"vndbCharacterId":"c77587"},"originalCharacterName":"イヴ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eve is a young woman who was found unconscious by Yuuma outside his home on a snowy January day. After being taken in and cared for by Yuuma, Eve told him that she would now be at his service as his maid to thank him for his kindness and to finally stop him from living a life full of loneliness and bitterness."},{"spoiler":false,"text":"Eve is a very serious young woman and takes her job very much to heart by doing all the domestic chores, shopping and cooking. Having a rather maternal character, she even manages to be already on the doorstep when Yuuma comes home late at night from work to give her a warm welcome, which makes Yuuma melt with happiness."}],"source":"vndb","sourceCharacterId":"c77587"},{"segments":[{"spoiler":false,"text":"主人公・北見佑馬の下にやってきたメイドさん。"},{"spoiler":false,"text":"日々の暮らしに疲れていた佑馬に『癒し』を与えたいと、佑馬の家で住み込みで仕事をし始める。"},{"spoiler":false,"text":"自分を住まわせてくれた佑馬に恩義を感じていて、精一杯尽そうとしている。"},{"spoiler":false,"text":"見た目に反して知識不足なことが多く、特に自分の感情のことはよくわかっていない。"},{"spoiler":false,"text":"容姿も性格もまさに『理想のメイドさん』だが、実は本人も知らない大きな秘密を抱えている。"}],"source":"egs","sourceCharacterId":"20682","sourceWorkId":"27427","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・北見佑馬の下にやってきたメイドさん。"},{"spoiler":false,"text":"日々の暮らしに疲れていた佑馬に『癒し』を与えたいと、"},{"spoiler":false,"text":"佑馬の家で住み込みで仕事をし始める。"},{"spoiler":false,"text":"自分を住まわせてくれた佑馬に恩義を感じていて、"},{"spoiler":false,"text":"精一杯尽そうとしている。"},{"spoiler":false,"text":"見た目に反して知識不足なことが多く、"},{"spoiler":false,"text":"特に自分の感情のことはよくわかっていない。"},{"spoiler":false,"text":"容姿も性格もまさに『理想のメイドさん』だが、"},{"spoiler":false,"text":"実は本人も知らない大きな秘密を抱えている。"},{"spoiler":false,"text":"「これからも、ご主人様を癒やして差し上げたいと思います。ぜひ、ご遠慮なく、どんなことでもお申し付けくださいませ」"}],"source":"bangumi","sourceCharacterId":"68137"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f60f863b2c23ef2a084b13384fc4a39531c57ada2ea0198bcbc8eebe58ded989.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9bad3dc36551d9c5f8333dddbbf1546f71cfed9d8fe7fe8c807fd25bdc926a5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:323787:68137:4937:1","source":"bangumi"}]},{"characterId":"char_c95370","characterName":"桜沢 舞雪","sourceIds":{"bangumi":[{"characterId":"90640","match":"exact-normalized-name-in-linked-work","subjectId":"323787"}],"egsCharacterIds":["23222"],"vndbCharacterId":"c95370"},"originalCharacterName":"桜沢 舞雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year in the same school as the protagonist."},{"spoiler":false,"text":"She's frequently hug the protagonist in some kind of \"Recharging Hug\" since she was a child, and even now she still hugs him once in the morning and evening almost everyday."},{"spoiler":false,"text":"Her athletic and academic faculties are average, but she's very good at housework, and her classmates say she's the \"No. 1 Girl You Want as a Wife\"."},{"spoiler":false,"text":"Ever since she misunderstood Kazuki's declaration of affection as a confession of love when she was in elementary school, she has been under the misapprehension that she and Kazuki were already some kind of lovers."},{"spoiler":false,"text":"\"Then, 5 more seconds~♪ Gyuuu~~~♪\""},{"spoiler":false,"text":"Edited from Official Website"}],"source":"vndb","sourceCharacterId":"c95370"},{"segments":[{"spoiler":false,"text":"学園２年。主人公と同じ学園に通っている。"},{"spoiler":false,"text":"一緒にいるだけで癒やし効果のありそうな、ふわふわした雰囲気が特徴的な女の子。"},{"spoiler":false,"text":"幼い頃から主人公に抱きついてエネルギーを充電する癖があり、今でもほぼ毎日、朝晩一度ずつ、主人公にぎゅっと抱きついてくる。"},{"spoiler":false,"text":"運動や勉強は平均的だが、家事全般はものすごく得意で、クラスメイトの女の子いわく「お嫁さんにしたい女の子No.1」である。"},{"spoiler":false,"text":"小学生の頃に和樹から好意を伝えられたことを『愛の告白』だと早とちりして以来、和樹とは恋人同士の関係だと勘違いしている。"}],"source":"egs","sourceCharacterId":"23222","sourceWorkId":"30548","spoiler":false},{"segments":[{"spoiler":false,"text":"学園2年。主人公と同じ学園に通っている。"},{"spoiler":false,"text":"一緒にいるだけで癒やし効果のありそうな、ふわふわした雰囲気が特徴的な女の子。"},{"spoiler":false,"text":"幼い頃から主人公に抱きついてエネルギーを充電する癖があり、"},{"spoiler":false,"text":"今でもほほ毎日、朝晩一度ずつ、主人公にぎゅっと抱きついてくる。"},{"spoiler":false,"text":"運動や勉強は平均的だか、家事全般はものすごく得意で、"},{"spoiler":false,"text":"クラスメイトの女の子いわく「お嫁さんにしたい女の子No.1」である。"},{"spoiler":false,"text":"小学生の頃に和樹から好意を伝えられたことを『愛の告白』だと早とちりして以来、和樹とは恋人同士の関係だと勘違いしている。"}],"source":"bangumi","sourceCharacterId":"90640"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"23222","sourceWorkId":"30548","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"23222","sourceWorkId":"30548","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"23222","sourceWorkId":"30548","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"23222","sourceWorkId":"30548","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"23222","sourceWorkId":"30548","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb3804d8f856f335eec5e9cd52e7b42b956f73ac0247406ebd118ba0bc1fc3bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50670be18f9ea0c3f18fd2c01ce5a31d0b2720f286f7d17c8c67eb1a42670516.webp","width":137,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:323787:90640:20696:1","source":"bangumi"}]},{"characterId":"char_vndb_c101301","characterName":"相川 和樹","sourceIds":{"vndbCharacterId":"c101301"},"originalCharacterName":"相川 和樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c82113","characterName":"相川","sourceIds":{"vndbCharacterId":"c82113"},"originalCharacterName":"相川","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aikawa is a young adult who is hardly younger or older than Yuuma who hangs around her house. She seems to have a connection with Eve and her work as a maid but we don't really know."},{"spoiler":true,"text":"Aikawa is the scientist who created Eve, she considers herself as Eve's mother and even wrote her name in her family notebook."}],"source":"vndb","sourceCharacterId":"c82113"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8b42cdf469808b6fcdeda9bd75f55fb5a8bf5439e4e676fcd5a2ad6a4d8881d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb701b6f18b6e6ee4918bcdc3d954e3b037120bd3c1d941638097a61a1216f9e.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82647","characterName":"北見 佑馬","sourceIds":{"vndbCharacterId":"c82647"},"originalCharacterName":"北見 佑馬","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuma is a young man who is an office worker. He is quite tired of his daily routine, which can only be reduced to work and the time it takes to get home from work. He starts to despair because he is tired of loneliness and wants to fall in love."},{"spoiler":