eviewState":"no-conflict","source":"bangumi","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: People with pure hearts"},{"spoiler":false,"text":"Dislikes: Speaking only with words"},{"spoiler":false,"text":"The school's most well-known Yamato nadeshiko, who is very refined, kind and friendly. Despite her appearance, she is actually a foreigner and only acts like the ideal Japanese woman. In spite of her popularity, she likes being alone and is a bit weird as well. Due to her parents being away, she lives together with her older brother. She is exceptionally good at all kinds of housework."}],"source":"vndb","sourceCharacterId":"c36687"},{"segments":[{"spoiler":false,"text":"品行方正、成績優秀な完璧美少女。"},{"spoiler":false,"text":"なのだが、なぜか周囲と一線を引いている。"},{"spoiler":false,"text":"そのせいで、一人でいる事が多いという少し変わった女の子。"},{"spoiler":false,"text":"家事全般が得意であり、基本的に高スペック。"},{"spoiler":false,"text":"けれど、私服センスは絶望的なまでにないらしい。"}],"source":"egs","sourceCharacterId":"7081","sourceWorkId":"22162","spoiler":false},{"segments":[{"spoiler":false,"text":"品行方正・成績優秀な完璧美少女。"},{"spoiler":false,"text":"なぜか周囲と一線を引いて、一人でいることが多いという少し変わった女の子。"},{"spoiler":false,"text":"家事全般が得意であり、基本的に高スペック。 だけど私服のセンスは絶望的らしい。"},{"spoiler":false,"text":"「おはよう一樹くんっ！　えへへ、朝一番で会いたくなって……、迎えに来ちゃった♪」"}],"source":"bangumi","sourceCharacterId":"35595"}],"profileFacts":[{"label":"喜欢","source":"bangumi","sourceCharacterId":"35595","value":"心の綺麗な人"},{"label":"讨厌","source":"bangumi","sourceCharacterId":"35595","value":"口先だけの言葉"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5edea35e4d70bf9030a5e295a4e90f2b90b517705d3a97839eb82cdef1eb2669.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b82ede7ec2b4bad143e03c79dfa949918181fa535ecdaf44fa3672fb2a1a0a2f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145394:35595:5936:1","source":"bangumi"}]},{"characterId":"char_c36688","characterName":"椿 萌黄","sourceIds":{"bangumi":[{"characterId":"35596","match":"exact-normalized-name-in-linked-work","subjectId":"145394"}],"egsCharacterIds":["7082"],"vndbCharacterId":"c36688"},"originalCharacterName":"椿 萌黄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"929"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Ii-kun (the protagonist), her older sister Amane"},{"spoiler":false,"text":"Dislikes: Bugs"},{"spoiler":false,"text":"Itsuki's hyperactive childhood friend. She's the kind of cliched childhood friend who comes to Itsuki's room to wake him up every day. Moegi has had feelings for Itsuki for a long time already, but she's not quite good at expressing her feelings. Unlike Rushia, she is not good at cooking or cleaning."}],"source":"vndb","sourceCharacterId":"c36688"},{"segments":[{"spoiler":false,"text":"優しく元気な天真爛漫幼馴染"},{"spoiler":false,"text":"毎朝、部屋まで一樹起こしに来る幼馴染の鏡。"},{"spoiler":false,"text":"だが、恋愛に対しては案外奥手で不器用なところがある。"},{"spoiler":false,"text":"料理、洗濯などの家事スキルは高くない。"},{"spoiler":false,"text":"昔から今に至るまでずっと一樹に片想いをしている。"},{"spoiler":false,"text":"とっても一途な女の子。"}],"source":"egs","sourceCharacterId":"7082","sourceWorkId":"22162","spoiler":false},{"segments":[{"spoiler":false,"text":"優しく元気な天真爛漫幼なじみ。"},{"spoiler":false,"text":"毎朝 部屋まで一樹を起こしに来る幼なじみの鑑。"},{"spoiler":false,"text":"昔からずっと一樹に片想いしているが、恋愛に対しては奥手で不器用なところがある。"},{"spoiler":false,"text":"また料理や洗濯などの家事スキルも高くない。"},{"spoiler":false,"text":"「いーくんっ！ 今日も元気にがんばろーっ！」"}],"source":"bangumi","sourceCharacterId":"35596"}],"profileFacts":[{"label":"喜欢","source":"bangumi","sourceCharacterId":"35596","value":"いーくん、お兄ちゃん"},{"label":"讨厌","source":"bangumi","sourceCharacterId":"35596","value":"おじゃま虫"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c15ad59331d2726bd9a9fec4f46151fd8a619e612ad156d36875a9e9594ee45e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76eec7c4f04b3fb6fb311895c9788b28a535e3b056015f954e68d39096b8647a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145394:35596:5939:1","source":"bangumi"}]},{"characterId":"char_c36689","characterName":"架月院 乃蒼","sourceIds":{"bangumi":[{"characterId":"35597","match":"exact-normalized-name-in-linked-work","subjectId":"145394"}],"egsCharacterIds":["7083"],"vndbCharacterId":"c36689"},"originalCharacterName":"架月院 乃蒼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"401"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","sou