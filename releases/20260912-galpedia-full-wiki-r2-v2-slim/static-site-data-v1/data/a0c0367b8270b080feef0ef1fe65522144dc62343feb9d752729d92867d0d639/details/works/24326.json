 Otoge Blog"}],"source":"vndb","sourceCharacterId":"c49569"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e29af376d5ca9a6c8f9d3745b94547d6895d4acb3df0c30d21c826cbbfda864e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74ea1be0ce3c2f963aeeb50c2717382f6756e3dbf16521239637d39de78bde20.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c49570","characterName":"エルトクリード・ヴァーレンティン","sourceIds":{"vndbCharacterId":"c49570"},"originalCharacterName":"エルトクリード・ヴァーレンティン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"621"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Character theme: Charity"},{"spoiler":false,"text":"The head of the bank Valentin which has control over Liberalitas, an area of The Earth. He speaks formally to everyone around him, and approaches all in gentlemanly fashion. He jokes around very often, but is trusted by those that he rules."},{"spoiler":false,"text":"\"Once I desire something, I will do whatever it takes to get it. Power, honour——and you……even you.\""},{"spoiler":false,"text":"From Rie's Otoge Blog"}],"source":"vndb","sourceCharacterId":"c49570"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b4f4edddb6683766d8dc9e110bed531bed8ddee6b9a9bf309c15b3b8021d45a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4871ac9d2ed6259151de1d477da51813f541babae70bef8d391a10b66982c281.webp","widt