s/v1/images/cb/cba3f7110cd136d52176241424a36fbd7de1623fbb46184f5767c2d1a617ddf8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265113:145967:5936:1","source":"bangumi"}]},{"characterId":"char_c45584","characterName":"天道 灯","sourceIds":{"bangumi":[{"characterId":"145968","match":"exact-normalized-name-in-linked-work","subjectId":"265113"}],"egsCharacterIds":["14901"],"vndbCharacterId":"c45584"},"originalCharacterName":"天道 灯","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"173"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"旧姓五藤灯。主人公の異母妹。天道医院の院長・光太郎の妻。"},{"spoiler":false,"text":"天道医院は、裏ではさまざまな事情により（借金や、密入国した外国人、時には拉致）表世界から転落した男女を監禁し、"},{"spoiler":false,"text":"調教や洗脳、肉体改造を行い、国内外の好事家に『ペット』と称し売り飛ばす商売をしている。"},{"spoiler":false,"text":"夫の裏ビジネスにおいては主導的役割を果たしており、『ペット』の調教は主に彼女の仕事。"},{"spoiler":false,"text":"社交的で華やかな美人だが、兄や父とも関係を結ぶ淫蕩な性質で、さらにドS。"},{"spoiler":false,"text":"「お兄様。五藤家のおきてを忘れたの？　獲物はみんなで分け合い、楽しむ事。」"}],"source":"egs","sourceCharacterId":"14901","sourceWorkId":"12794","spoiler":false},{"segments":[{"spoiler":false,"text":"公孝の異母妹で、天道医院の院長・光太郎の妻。旧姓五藤灯。"},{"spoiler":false,"text":"倒錯的性癖を持つ者のための秘密倶楽部 『DDC』 を夫婦で主催しており、天道医院の地下にある一室で様々な “ショー” を披露している。"},{"spoiler":false,"text":"また、夫の裏ビジネスにおいては主導的役割を果たしており、『DDC』 で飼われている “ペットの躾” は主に彼女の仕事。"},{"spoiler":false,"text":"社交的で華やかな美人だが、誰とでも関係を結ぶ淫蕩な性質で、さらにドS。"},{"spoiler":false,"text":"夫婦仲は良好で、お互い「ダーリン」「ハニー」と呼び合っている。"}],"source":"bangumi","sourceCharacterId":"145968"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"14901","sourceWorkId":"12794","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"173 cm","valueContext":null,"source":"egs","sourceCharacterId":"14901","sourceWorkId":"12794","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"14901","sourceWorkId":"12794","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"14901","sourceWorkId":"12794","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"58 kg","valueContext":null,"source":"egs","sourceCharacterId":"14901","sourceWorkId":"12794","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c9da9c755dba9bd16e1e85942addeae1a4349de6e80d5aa3f2c810726812760.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14aec4587e78e83b918575fa5d7ae39949f175b3259637b4054194f7a04d0031.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265113:145968:13773:1","source":"bangumi"}]},{"characterId":"char_c45585","characterName":"五藤 小百合","sourceIds":{"bangumi":[{"characterId":"145969","match":"exact-normalized-name-in-linked-work","subjectId":"265113"}],"egsCharacterIds":["14902"],"vndbCharacterId":"c45585"},"originalCharacterName":"五藤 小百合","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"玩弄の犠牲となった、公孝の前妻。"},{"spoiler":false,"text":"表向きは「不治の病で天道医院に長らく入院し、病死した」事にされているが、実際には病院地下の『DDC』で性奴隷として飼われている。"},{"spoiler":false,"text":"すでに半ば正気を失って都合の良い情報を刷り込まれており、"},{"spoiler":false,"text":"公孝を裏切ったのは小百合の方であり、与えられる加虐は公孝への償いだと信じている。"},{"spoiler":false,"text":"「ごめんさない、わかっています。私が弱い女だってことは……」"}],"source":"egs","sourceCharacterId":"14902","sourceWorkId":"12794","spoiler":false},{"segments":[{"spoiler":false,"text":"公孝の “玩弄” の犠牲となり、廃人化した前妻。"},{"spoiler":false,"text":"表向きは「不治の病で天道医院に長らく入院し、病死した」事にされているが、実際には病院地下の 『DDC』 で “ペット” として飼われている。"},{"spoiler":false,"text":"「加虐を与えられているのは公孝を裏切った自分への罰」"},{"spoiler":false,"text":"という公孝にとって都合の良い情報を刷り込まれ、それを信じている。"},{"spoiler":false,"text":"いつか “償い” が終った時、再び公孝と共に暮らせる日が来ると思っているが……"}],"source":"bangumi","sourceCharacterId":"145969"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"14902","sourceWorkId":"12794","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"14902","sourceWorkId":"12794","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"14902","sourceWorkId":"12794","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"14902","sourceWorkId":"12794","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacter