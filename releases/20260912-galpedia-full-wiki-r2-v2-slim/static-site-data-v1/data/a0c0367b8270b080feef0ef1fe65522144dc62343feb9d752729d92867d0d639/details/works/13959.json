tor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14501:131195:6173:1","source":"bangumi"}]},{"characterId":"char_c7176","characterName":"サンデー・クノウ","sourceIds":{"bangumi":[{"characterId":"131243","match":"exact-normalized-name-in-linked-work","subjectId":"92174"}],"egsCharacterIds":["418"],"vndbCharacterId":"c7176"},"originalCharacterName":"サンデー・クノウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Underestimated for her size (chest notwithstanding,) Sandy more than makes up for it in acute wit and powers of perception. A constant foil to Bakaito, but her caustic tongue tends to make bad situations worse."}],"source":"vndb","sourceCharacterId":"c7176"},{"segments":[{"spoiler":false,"text":"【モンローハート：神出鬼没の不思議少女】"},{"spoiler":false,"text":"『プリスター武闘専門養成学区』の生徒……かもしれない女の子。"},{"spoiler":false,"text":"神出鬼没でいつも空ばかり見ている。"},{"spoiler":false,"text":"授業を受けている姿を誰も見たことがないので、真実は闇の中となっている。"},{"spoiler":false,"text":"いつの間にか大会に出場するカイトのチームに潜り込んできていた。"},{"spoiler":false,"text":"少なからずマホウ少女には興味があるらしい。"},{"spoiler":false,"text":"人を小馬鹿にするのが大好きという、かなり歪んだ一面を持っている。"},{"spoiler":false,"text":"「…………………………ふっ、ばーか」"}],"source":"egs","sourceCharacterId":"418","sourceWorkId":"11920","spoiler":false},{"segments":[{"spoiler":false,"text":"【モンローハート：神出鬼没の不思議少女】"},{"spoiler":false,"text":"『プリスター武闘専門養成学区』の生徒……かもしれない女の子。"},{"spoiler":false,"text":"神出鬼没でいつも空ばかり見ている。"},{"spoiler":false,"text":"授業を受けている姿を誰も見たことがないので、真実は闇の中となっている。"},{"spoiler":false,"text":"いつの間にか大会に出場するカイトのチームに潜り込んできていた。"},{"spoiler":false,"text":"少なからずマホウ少女には興味があるらしい。"},{"spoiler":false,"text":"人を小馬鹿にするのが大好きという、かなり歪んだ一面を持っている。"},{"spoiler":false,"text":"「…………………………ふっ、ばーか」"}],"source":"bangumi","sourceCharacterId":"131243"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/306e314649c3fa55dbd9eb7a0106cd0ffba8ee7a2ba4ed0311f1e211375b585b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72dc46b13bcc8acd1ad9018b31c631015f6328a60f526a2a149f9798a7307117.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14501:131243:6558:1","source":"bangumi"}]},{"characterId":"char_c7178","characterName":"ランカ・シロガネ","sourceIds":{"bangumi":[{"characterId":"131241","match":"exact-normalized-name-in-linked-work","subjectId":"92174"}],"egsCharacterIds":["416"],"vndbCharacterId":"c7178"},"originalCharacterName":"ランカ・シロガネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A talented yet indecisive student, good at many things but not particularly apt at many. She bemoans her lack of personality, but never quite develops one, and doesn't become the roaring dragon that her Prister can."}],"source":"vndb","sourceCharacterId":"c7178"},{"segments":[{"spoiler":false,"text":"【モンローハート：明るく積極的な女の子】"},{"spoiler":false,"text":"『プリスター武闘専門養成学区』の生徒。"},{"spoiler":false,"text":"自分のプリスターにマホウを与え、マホウ少女になることを目指している。"},{"spoiler":false,"text":"今回の大会に出場するために、サモンディレクターを募集している。"},{"spoiler":false,"text":"明るく快活な性格をしており、成績もおおむね悪くない。色々と万能にこなせる（器用貧乏とも言う）。"},{"spoiler":false,"text":"何事にも積極的で、自分が目指したもののために努力と行動は忘れない。"},{"spoiler":false,"text":"しかしエロいことには奥手で、少しの話題でも耳まで真っ赤になってしまう。"},{"spoiler":false,"text":"「カイト君、一緒にマホウ少女決定大会で優勝目指そう！」"}],"source":"egs","sourceCharacterId":"416","sourceWorkId":"11920","spoiler":false},{"segments":[{"spoiler":false,"text":"【モンローハート：明るく積極的な女の子】"},{"spoiler":false,"text":"『プリスター武闘専門養成学区』の生徒。"},{"spoiler":false,"text":"自分のプリスターにマホウを与え、マホウ少女になることを目指している。"},{"spoiler":false,"text":"今回の大会に出場するために、サモンディレクターを募集している。"},{"spoiler":false,"text":"明るく快活な性格をしており、成績もおおむね悪くない。色々と万能にこなせる（器用貧乏とも言う）。"},{"spoiler":false,"text":"何事にも積極的で、自分が目指したもののために努力と行動は忘れない。"},{"spoiler":false,"text":"しかしエロいことには奥手で、少しの話題でも耳まで真っ赤になってしまう。"},{"spoiler":false,"text":"「カイト君、一緒にマホウ少女決定大会で優勝目指そう！」"}],"source":"bangumi","sourceCharacterId":"131241"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d4b5929536d170d4c8bb3727ea16692ddf5de2182ca8bd3693740cf6aa438f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8929f664049428d2128b6a6a97dcf0ae2b5e115a5760e333d4cc262ddf43ffe6.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14501:131241:4463:1","source":"bangumi"}]},{"characterId":"char_c7179","characterName":"メイリン・マシロ","sourceIds":{"bangumi":[{"characterId":"131242","match":"exact-normalized-name-in-linked-work","subjectId":"92174"}],"egsCharacterIds":["417"],"vndbCharacterId":"c7179"},"originalCharacterName":"メイリン・マシロ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Innocent and warm-hearted, May Lin goes out of her way to help others, at any personal expense. She always expects the best of others, and surprisingly always brings out the best in others when the more jaded observer would expect her to get taken advantage of. Even Kaito hesitates to molest her, because she's too pure to be believable."}],"source":"vndb","sourceCharacterId":"c7179"},{"segments":[{"spoiler":false,"text":"【モンローハート：超が付くほどお人好し】"},{"spoiler":false,"text":"『プリスター武闘専門養成学区』の生徒。"},{"spoiler":false,"text":"超が付くほどのお人好し。"},{"spoiler":false,"text":"困っている人を見過ごすことができない性格で、世のため人のために働くマホウ少女に憧れを抱いている。"},{"spoiler":false,"text":"変な格好をしているので、非常に目立つのだが、本人は全く気づいていない。"},{"spoiler":false,"text":"貧しい環境で育ったため、異常に節約スキルに長けている。"},{"spoiler":false,"text":"「マホウ少女になれば、もっと人の役に立てるんですよね？」"}],"source":"egs","sourceCharacterId":"417","sourceWorkId":"11920","spoiler":false},{"segments":[{"spoiler":false,"text":"【モンローハート：超が付くほどお人好し】"},{"spoiler":false,"text":"『プリスター武闘専門養成学区』の生徒。"},{"spoiler":false,"text":"超が付くほどのお人好し。"},{"spoiler":false,"text":"困っている人を見過ごすことができない性格で、世のため人のために働くマホウ少女に憧れを抱いている。"},{"spoiler":false,"text":"変な格好をしているので、非常に目立つのだが、本人は全く気づいていない。"},{"spoiler":false,"text":"貧しい環境で育ったため、異常に節約スキルに長けている。"},{"spoiler":false,"text":"「マホウ少女になれば、もっと人の役に立てるんですよね？」"}],"source":"bangumi","sourceCharacterId":"131242"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9cc66623bcb6128aa9090b1598cc1470d15c60e7a07769b172d763968acb69a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/900187edfc63a3231537ed9b65c1166ae3f62dea57641ae2ddd4a4c7e805d7be.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14501:131242:4489:1","source":"bangumi"}]},{"characterId":"char_c7181","characterName":"リーブル セネア","sourceIds":{"bangumi":[{"characterId":"131196","match":"exact-normalized-name-in-linked-work","subjectId":"92174"}],"egsCharacterIds":["407"],"vndbCharacterId":"c7181"},"originalCharacterName":"リーブル セネア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Even for a knight Libre has an uncommon level of discipline and devotion, and expects the same from her Prister, so she never notices how starved for affection it is. Bokkuko by nature but a sucker for cuteness, and ashamed of her secret love for girly things."}],"source":"vndb","sourceCharacterId":"c7181"},{"segments":[{"spoiler":false,"text":"【マリアンロード：真面目で努力家の騎士】"},{"spoiler":false,"text":"タカシの上司。"},{"spoiler":false,"text":"騎士道精神まっしぐらな真面目人間。"},{"spoiler":false,"text":"自分の信じた道を突き進む努力家で、人を寄せ付けないクールさを持つ。"},{"spoiler":false,"text":"そのためあまり人付き合いが得意ではない。"},{"spoiler":false,"text":"プリスターでの戦闘行為には、賛成的ではないが、ジュリエッタ姫の護衛のために渋々大会に参加することになる。"},{"spoiler":false,"text":"実は可愛いもの好きで、少しだけマホウ少女の衣装にも憧れている。"},{"spoiler":false,"text":"真面目すぎて、色々と不憫。"},{"spoiler":false,"text":"「貴様とならたどりつけるのか、騎士としての高みに……」"}],"source":"egs","sourceCharacterId":"407","sourceWorkId":"11920","spoiler":false},{"segments":[{"spoiler":false,"text":"【マリアンロード：真面目で努力家の騎士】"},{"spoiler":false,"text":"タカシの上司。"},{"spoiler":false,"text":"騎士道精神まっしぐらな真面目人間。"},{"spoiler":false,"text":"自分の信じた道を突き進む努力家で、人を寄せ付けないクールさを持つ。"},{"spoiler":false,"text":"そのためあまり人付き合いが得意ではない。"},{"spoiler":false,"text":"プリスターでの戦闘行為には、賛成的ではないが、ジュリエッタ姫の護衛のために渋々大会に参加することになる。"},{"spoiler":false,"text":"実は可愛いもの好きで、少しだけマホウ少女の衣装にも憧れている。"},{"spoiler":false,"text":"真面目すぎて、色々と不憫。"},{"spoiler":false,"text":"「貴様とならたどりつけるのか、騎士としての高みに……」"}],"source":"bangumi","sourceCharacterId":"131196"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/819c09e263242f57be569a0a140d4d73ed2723c4ee63d4ff85249c583fbe1dbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/479b484e704a33f4576b29f54c8a2d2cab7c