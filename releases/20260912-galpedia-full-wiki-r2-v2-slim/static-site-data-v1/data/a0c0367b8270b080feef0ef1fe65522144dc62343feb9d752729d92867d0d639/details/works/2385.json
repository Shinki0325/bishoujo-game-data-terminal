{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"2385","model":{"presentationWorkId":"vndb:v6616","staff":{"artwork":[{"creditedName":"トシぞー","creatorId":"vndb:s3065","sourcePersonId":"egs:creator:1339","canonicalEntityId":"vndb:s3065","name":"トシぞー","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:3287","source":"egs"},{"creditedName":"丹下ゲンタ(氷雨げんた)","creatorId":"vndb:s4217","sourcePersonId":"egs:creator:1483","canonicalEntityId":"vndb:s4217","name":"丹下ゲンタ(氷雨げんた)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:3288","source":"egs"}],"scenario":[{"creditedName":"黒崎将弘","creatorId":"vndb:s3066","sourcePersonId":"egs:creator:231","canonicalEntityId":"vndb:s3066","name":"黒崎将弘","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:3289","source":"egs"},{"creditedName":"鬼影姚二","creatorId":"vndb:s206","sourcePersonId":"egs:creator:1484","canonicalEntityId":"vndb:s206","name":"鬼影姚二","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:3290","source":"egs"}],"music":[{"creditedName":"m.c.TOM","creatorId":"vndb:s6343","sourcePersonId":"egs:creator:2622","canonicalEntityId":"vndb:s6343","name":"m.c.TOM","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7892","source":"egs"}],"other":[{"creditedName":"け～まる","creatorId":"vndb:s6704","sourcePersonId":"egs:creator:13819","canonicalEntityId":"vndb:s6704","name":"け～まる","detail":"企画・ディレクション","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112134","source":"egs"},{"creditedName":"け～まる","creatorId":"vndb:s6704","sourcePersonId":"vndb:s6704","canonicalEntityId":"vndb:s6704","name":"け～まる","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:65662","source":"vndb"}]},"cast":[{"characterId":"char_c79512","characterName":"貴城 芙柚香","sourceIds":{"bangumi":[{"characterId":"142611","match":"exact-normalized-name-in-linked-work","subjectId":"230347"}],"egsCharacterIds":["27472"],"vndbCharacterId":"c79512"},"originalCharacterName":"貴城 芙柚香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の屋敷で働くメイド。"},{"spoiler":false,"text":"主人公の乳母のひとりだった女性の一人娘で、彼女の家系は代々本間家に仕えてきた。"},{"spoiler":false,"text":"そのため主人公とは幼い頃から一緒で、姉弟のような間柄。"},{"spoiler":false,"text":"彼女にとって、主人公は手のかかる弟のような存在だが、メイドとしての自分をわきまえ、主人公に傅く。"},{"spoiler":false,"text":"しかしながら、主人公にほのかな恋心を抱いているようだ。"},{"spoiler":false,"text":"傍から見ると、冷たく素っ気ない印象を受けるが、素はのほほんとした雰囲気の女の子。"},{"spoiler":false,"text":"開発した淫具を改良するときには、恥かしながらもモニターとしてお手伝いを……。"}],"source":"egs","sourceCharacterId":"27472","sourceWorkId":"2385","spoiler":false},{"segments":[{"spoiler":false,"text":"宗一郎とは幼い頃から姉弟の様に育てられ、同時に 彼に仕える為の教育も受けている。形式上、宗一郎とは主従の間柄にあたるが現在では 昔の様な上下関係もとっくに風化してしまっていて二人の関係も幼い頃とあまり変わっていない。 可愛いモノも大好きという少女の様な一面もあり、こっそりそういう小物やぬいぐるみを集めていたりもする。"}],"source":"bangumi","sourceCharacterId":"142611"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dc0c9e1fc48af043d645b11a3a8348e30b9494035034173f9d7924bac76fac6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fcd0256be38665c58e70b7a727bae51701dd97ffb015f31e0ff9da7bf417d58.webp","width":185,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木菜穂子","creatorId":"vndb:s1014","sourcePersonId":"vndb:s1014","canonicalEntityId":"vndb:s1014","name":"鈴木 菜穂子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230347:142611:4496:1","source":"bangumi"}]},{"characterId":"char_c79513","characterName":"本間 愛依","sourceIds":{"bangumi":[{"characterId":"142612","match":"exact-normalized-name-in-linked-work","subjectId":"230347"}],"egsCharacterIds":["27471"],"vndbCharacterId":"c79513"},"originalCharacterName":"本間 愛依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本間家の祖先が残した「本間機巧書（オゲレツ大百科）」に記されていた設計図を元に開発したロボット。"},{"spoiler":false,"text":"動力源は変なゼンマイだが、現代の科学水準を軽く飛び越えており、感情もあり、エッチも可能。"},{"spoiler":false,"text":"外見は10代前半の少女で、性格は大人しく、基本的に従順。"},{"spoiler":false,"text":"また好奇心は旺盛で、知識への欲求は高い。"},{"spoiler":false,"text":"しかしながら、まだまだお子様。"},{"spoiler":false,"text":"「オゲレツ大百科」の解読機能を備えており、淫具開発の際は、主人公の助手として働く。"}],"source":"egs","sourceCharacterId":"27471","sourceWorkId":"2385","spoiler":false},{"segments":[{"spoiler":false,"text":"本間の祖先が残した図面を基に制作されたロボット。 性格は大人しいが、外向的。 頭はよいが知識と知恵のバランスが取れていないため、必要以上に幼い部分とそうでない部分があるが、おおむねお子様。 本間の祖先が残した『本間機巧書』を解読する機能を持つため、主人公の助手として、また、メイドとして働く。"}],"source":"bangumi","sourceCharacterId":"142612"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1728b100316424da3356c6a1dd1db0bebf7fd021a544751ba26637089ad322c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f35667ef063dc6db78705c592e1ef5b87fa7e944ad2d27e795ddcadd10321bf6.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みずき みらい","creatorId":"vndb:s17873","sourcePersonId":"vndb:s17873","canonicalEntityId":"vndb:s17873","name":"みずき みらい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36777","source":"vndb"}]},{"characterId":"char_vndb_c91394","characterName":"本間 宗一郎","sourceIds":{"vndbCharacterId":"c9