racterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"123"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"O"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The heroine of this work, a foreign exchange student. She's currently staying at her grandparents' house, three stations away from the protagonist."},{"spoiler":false,"text":"Her defining features are her un-Japanese physique and mature appearance that belies her age, though her mental age is a bit young. She's bright, open, and easygoing, but also extremely gullible."},{"spoiler":false,"text":"She learned Japanese from anime and manga, so her knowledge is a bit skewed, but she's fluent. Her proud bust size is ○ cup. She's fascinated by Japan's HENTAI culture and takes an interest in the protagonist's (penis), reputed to be the largest in the academy."},{"spoiler":false,"text":"However, she gets outmaneuvered every time, and eventually becomes captivated by his (penis)."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c88060"},{"segments":[{"spoiler":false,"text":"本作のヒロインで留学生の女の子。"},{"spoiler":false,"text":"現在は主人公の3つ先の駅にある祖父母の家に居候中。"},{"spoiler":false,"text":"日本人離れした体型、それと同年代に見えない大人びた容姿が特徴だが精神年齢は少し幼く、明るく開放的で大雑把、それと非常に騙されやすい性格。"},{"spoiler":false,"text":"日本語はアニメや漫画で覚えたとのことで、若干知識に偏りがあるものの堪能。自慢のバストはOカップ。"},{"spoiler":false,"text":"日本のHENTAI文化に興味津々で学園で一番大きいと言われている主人公（のチンコ）の興味をもつ。"},{"spoiler":false,"text":"しかし毎回、返り討ちにされてしまいそのうち、彼の（チンコ）に魅せられてしまう。"}],"source":"egs","sourceCharacterId":"23492","sourceWorkId":"29058","spoiler":false},{"segments":[{"spoiler":false,"text":"前作のヒロイン。"},{"spoiler":false,"text":"最近は恋人の智哉と若干マンネリ気味ながらも仲良くやっている。"},{"spoiler":false,"text":"たまたま、智哉とエッチをしているところを母親に見られてしまい、健全なお付合いを突きつけられて彼とのエッチを禁止される。"}],"source":"egs","sourceCharacterId":"23492","sourceWorkId":"38493","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロインで留学生の女の子。"},{"spoiler":false,"text":"現在は主人公の3つ先の駅にある祖父母の家に居候中。"},{"spoiler":false,"text":"日本人離れした体型、それと同年代に見えない大人びた容姿が特徴だが精神年齢は少し幼く、"},{"spoiler":false,"text":"明るく開放的で大雑把、それと非常に騙されやすい性格。"},{"spoiler":false,"text":"日本語はアニメや漫画で覚えたとのことで、若干知識に偏りがあるものの堪能。自慢のバストはOカップ。"},{"spoiler":false,"text":"日本のHENTAI文化に興味津々で学園で一番大きいと言われている主人公（のチンコ）の興味をもつ。"},{"spoiler":false,"text":"しかし毎回、返り討ちにされてしまいそのうち、彼の（チンコ）に魅せられてしまう。"}],"source":"bangumi","sourceCharacterId":"74793"}],"profileFacts":[{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"74793","value":"納豆、強引な人"},{"label":"趣味","source":"bangumi","sourceCharacterId":"74793","value":"乗馬、芸術鑑賞"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b121f33c3ad16a7d8319242da80a042b60a9b5355c96bb5c1a7a6d53f932965.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54d19e2f5ef6690d54b200f2474da683efa4aa10fc280a552ee30fd31fbbf994.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298463:74793:20833:1","source":"bangumi"}]},{"characterId":"char_vndb_c100559","characterName":"篠崎 智哉","sourceIds":{"vndbCharacterId":"c100559"},"originalCharacterName":"篠崎 智哉","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only