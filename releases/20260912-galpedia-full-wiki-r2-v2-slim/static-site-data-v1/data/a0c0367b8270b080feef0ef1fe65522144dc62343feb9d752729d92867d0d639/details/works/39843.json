1"},{"segments":[{"spoiler":false,"text":"学園の三年生で、学生会の副会長。"},{"spoiler":false,"text":"一色家に代々仕える家に生まれ、双子の妹である空と共に、奏命を慕い支えてきた。"},{"spoiler":false,"text":"明るく朗らかな性格だが、誰が相手でも物怖じしない豪胆さを併せ持っている。"}],"source":"egs","sourceCharacterId":"26062","sourceWorkId":"35179","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の三年生で、学生会の副会長。"},{"spoiler":false,"text":"一色家に代々仕える家に生まれ、"},{"spoiler":false,"text":"双子の妹である空と共に、奏命を慕い支えてきた。"},{"spoiler":false,"text":"明るく朗らかな性格だが、"},{"spoiler":false,"text":"誰が相手でも物怖じしない豪胆さを併せ持っている。"}],"source":"bangumi","sourceCharacterId":"153700"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61eada7429cf27ce82aa05d0ffa6b4e72ddcdd082128dcf57048149504496fc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/033c1488d6b8b753189bc09659d7cfdf517981b2fdc11e9e5b626ddab1d3cf68.webp","width":152,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天知遥","creatorId":"vndb:s16012","sourcePersonId":"vndb:s16012","canonicalEntityId":"vndb:s16012","name":"天知 遥","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:456680:153700:35180:1","source":"bangumi"}]},{"characterId":"char_vndb_c133476","characterName":"蓼科 イウヴァリー マクブライド","sourceIds":{"vndbCharacterId":"c133476"},"originalCharacterName":"蓼科 イウヴァリー マクブライド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1220"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Aikido Master: Police Agency's Secret Trickster"},{"spoiler":false,"text":"This second-year powerhouse serves as the Athletic Director, commanding all sports clubs on campus. Though she's clinched national championships in Aikido, Eve