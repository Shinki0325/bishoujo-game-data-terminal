vndb:s7503","name":"Amane","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:135612","source":"vndb"},{"creditedName":"冬乃 桜","creatorId":"vndb:s12797","sourcePersonId":"vndb:s12797","canonicalEntityId":"vndb:s12797","name":"冬乃 桜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:135613","source":"vndb"}]},"cast":[{"characterId":"char_c40598","characterName":"常磐 久遠","sourceIds":{"bangumi":[{"characterId":"38753","match":"exact-normalized-name-in-linked-work","subjectId":"155705"}],"egsCharacterIds":["8283"],"vndbCharacterId":"c40598"},"originalCharacterName":"常磐 久遠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"824"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhoodfriend of Yoshito and Rin, as well as the Vice President of the Student Council. Not having seen each other for quite some time, she uses the club under the cover of \"supervision\" to spend more time with him again."}],"source":"vndb","sourceCharacterId":"c40598"},{"segments":[{"spoiler":false,"text":"私立芦ノ宮学園の２年生。生徒会副会長。"},{"spoiler":false,"text":"主人公の同級生で幼なじみなお嬢様。バイリンガルで英語も話せる。"},{"spoiler":false,"text":"宝石商を営む資産家の娘で、親の仕事関係で主人公とは幼い頃から知り合っており家族ぐるみの付き合いがある。"},{"spoiler":false,"text":"幼い頃から、主人公と同じくらいのゲーム好き。パズルゲームが得意。"},{"spoiler":false,"text":"学園では家柄と優秀な成績、お嬢様としての振る舞いで生徒会副会長をしている為、ゲーム好きの側面は隠している。"},{"spoiler":false,"text":"新設された電脳研究部の動向を調査する名目で電脳研究部に入部する。"}],"source":"egs","sourceCharacterId":"8283","sourceWorkId":"22847","spoiler":false},{"segments":[{"spoiler":false,"text":"立芦ノ宮学園の 2年生。 生徒会副会長。"},{"spoiler":false,"text":"宝石商を営む資産家の娘で、主人公とは幼い頃から家族ぐるみの付き合いがある。"},{"spoiler":false,"text":"昔から主人公と同じくらいのゲーム好き。 パズルゲームが得意。"},{"spoiler":false,"text":"学園では優秀なお嬢様として生徒会副会長をしているため、ゲーム好きの側面は隠している。"},{"spoiler":false,"text":"新設された電脳研究部の動向を調査する名目で電脳研究部に入部した。"},{"spoiler":false,"text":"「嘉人は黙って私の相手をしてればいいのよ」"},{"spoiler":false,"text":"―――――――――――――――――"},{"spoiler":false,"text":"電脳アバター： クオン"},{"spoiler":false,"text":"久遠の電脳世界での姿。 お姫様のような姿をしている。"},{"spoiler":false,"text":"清純派で、おとなしく優しい女の子。 主人公にウブな反応を見せる。"},{"spoiler":false,"text":"「そ…その……、男の人と手を繋ぐの…初めてで……」"}],"source":"bangumi","sourceCharacterId":"38753"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e172f7137795e0d06de1171c214d4a670630a6626771a20d951141f14e2983ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b37325cedc4e9005bf0c6674053e0a7130081be502a092a7a7cd437f985fdeed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水美紗","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197099:38753:21151:1","source":"bangumi"}]},{"characterId":"char_c40599","characterName":"臣苗 鈴","sourceIds":{"bangumi":[{"characterId":"38754","match":"exact-normalized-name-in-linked-work","subjectId":"155705"}],"egsCharacterIds":["8284"],"vndbCharacterId":"c40599"},"originalCharacterName":"臣苗 鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1203"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yoshito's sister, who is a closet Brocon. She became that way to be a reliable sister, but her digital avatar shows her true self, one that still wants to be spoiled. Also a classmate & friend of Kotone."}],"source":"vndb","sourceCharacterId":"c40599"},{"segments":[{"spoiler":false,"text":"私立芦ノ宮学園の１年生。左利き。"},{"spoiler":false,"text":"主人公の実の妹。料理や洗濯などの家事をそつなくこなす、しっかり者。"},{"spoiler":false,"text":"ウエストポーチを常備していて、ソーイングセットや絆創膏など、いざという時のために準備している。鈴のアクセサリーをつけてる。"},{"spoiler":false,"text":"家事があるため部活にはいって居なかったが、兄に進められたことも有り電脳研究部に入部する。ゲームは得意では無い。"}],"source":"egs","sourceCharacterId":"8284","sourceWorkId":"22847","spoiler":false},{"segments":[{"spoiler":false,"text":"私立芦ノ宮学園の 1年生。 主人公の実の妹。 鈴のアクセサリーを付けている。"},{"spoiler":false,"text":"料理や洗濯などの家事をそつなくこなす しっかり者。 左利き。"},{"spoiler":false,"text":"ウエストポーチにソーイングセットや絆創膏などを入れ、いざという時のために備えている。"},{"spoiler":false,"text":"家事があるため部活には入っていなかったが、兄に勧められたので電脳研究部に入部する。"},{"spoiler":false,"text":"ゲームは得意ではない。"},{"spoiler":false,"text":"「お兄ちゃん。 夏休みだからって、いつまでも寝てちゃ駄目だよ」"},{"spoiler":false,"text":"―――――――――――――――――"},{"spoiler":false,"text":"電脳アバター： リン"},{"spoiler":false,"text":"鈴の電脳世界での姿。 ナース服のような衣装を着ている。"},{"spoiler":false,"text":"甘えん坊の妹キャラで、主人公に遠慮なく甘えてくる。"},{"spoiler":false,"text":"「あの…、お兄ちゃんって、呼んでも良いですか？」"}],"source":"bangumi","sourceCharacterId":"38754"}],"profileFacts":[],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1203","source":"vndb","sourceCharacterId":"c40599","value":"1203"},{"comparisonValue":"0123","source":"bangumi","sourceCharacterId":"38754","value":"12月3日（射手座）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b3b1adabaac02eb1c15c363527f97fd5835541549545d75d97c026f3b940528.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/835cb4febf1532173231a3147794c613e3cdc108c4026e7247923e480d5b4ba6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鹿野 まなか","creatorId":"vndb:s8057","sourcePersonId":"vndb:s8057","canonicalEntityId":"vndb:s8057","name":"熊乃 可菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71643","source":"vndb"}]},{"characterId":"char_c40600","characterName":"名城 綺新","sourceIds":{"bangumi":[{"characterId":"38757","match":"exact-normalized-name-in-linked-work","subjectId":"155705"}],"egsCharacterIds":["8285"],"vndbCharacterId":"c40600"},"originalCharacterName":"名城 綺新","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"324"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 3rd year at the school, and leader of the computer club. She semi-forces Yoshito into the club via an online competition. For obvious reasons, she is loved in the martial arts clubs for fighting in her school uniform, which she visits regularly to hone her skills."}],"source":"vndb","sourceCharacterId":"c40600"},{"segments":[{"spoiler":false,"text":"私立芦ノ宮学園の３年生。電脳研究部の部長。"},{"spoiler":false,"text":"電脳研究部を作る為に、主人公を部に引き入れた。"},{"spoiler":false,"text":"電脳世界ではＮＤ型格闘ゲームのトップランカー『ナギ』。主人公をあっさり倒すほどの腕前。"},{"spoiler":false,"text":"※数十万人規模のユーザー数のゲームで２０位以内がトップランカー"},{"spoiler":false,"text":"現実世界でも有名な格闘技道場の娘で、本人も格闘技が強く学園の生徒達からも一目置かれている。"}],"source":"egs","sourceCharacterId":"8285","sourceWorkId":"22847","spoiler":false},{"segments":[{"spoiler":false,"text":"私立芦ノ宮学園の 3年生。 電脳研究部の部長。"},{"spoiler":false,"text":"電脳研究部を作るために主人公を部に引き入れた。"},{"spoiler":false,"text":"電脳世界では ND型格闘ゲームのトップランカー・ナギ。 主人公をあっさり倒すほどの腕前。"},{"spoiler":false,"text":"現実世界でも有名な格闘技道場の娘で、本人も格闘技が強い。"},{"spoiler":false,"text":"「良い動きだが甘いな。 私が鍛えてやろうか？」"},{"spoiler":false,"text":"―――――――――――――――――"},{"spoiler":false,"text":"電脳アバター： キサラ"},{"spoiler":false,"text":"綺新の電脳世界での姿。 服装はゴスロリメイド風なフリフリ衣装。"},{"spoiler":false,"text":"性格は依存型のヤンデレマゾ気質。 男に甘えて誘惑する。"},{"spoiler":false,"text":"実験として “本音変換ツール” を搭載しており、感情を必要以上に汲みとってしまうため、かなり危ないキャラに仕上がっている。"},{"spoiler":false,"text":"「申し訳ありません、ご主人様……。 キサラは悪い子です～」"}],"source":"bangumi","sourceCharacterId":"38757"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c95d9b70412d44c69e19d735c41faf04c70353934f892a9c0620654f182b2ba0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2eca287bb04b84128cb44dbecc076b2d4eab52bd561de60f7b65466992a8338.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かわしま りの","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71640","source":"vndb"}]},{"characterId":"char_c40601","characterName":"七国 小都音","sourceIds":{"bangumi":[{"characterId":"38755","match":"exact-normalized-name-in-linked-work","subjectId":"155705"}],"egsCharacterIds":["8286"],"vndbCharacterId":"c40601"},"originalCharacterName":"七国 小都音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"610"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The shy kouhai of Yoshito, and Rin's classmate. Loves gardening and also took a liking to worms and slugs."},{"spoiler":false,"text":"Her digital avatar is the famous idol \"Lie\"."}],"source":"vndb","sourceCharacterId":"c40601"},{"segments":[{"spoiler":false,"text":"私立芦ノ宮学園の１年生。"},{"spoiler":false,"text":"臣苗鈴のクラスメイトで友人。無口で大人しく、花を育てるのが好きな女の子。"},{"spoiler":false,"text":"友人の鈴に誘われて、一緒に電脳研究部に入部してくる。"},{"spoiler":false,"text":"好きな花は「オシロイバナ」"}],"source":"egs","sourceCharacterId":"8286","sourceWorkId":"22847","spoiler":false},{"segments":[{"spoiler":false,"text":"私立芦ノ宮学園の 1年生。 臣苗鈴のクラスメイトで友人。"},{"spoiler":fal