{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29177","model":{"presentationWorkId":"vndb:v27748","staff":{"artwork":[{"creditedName":"にじはしそら","creatorId":"vndb:s20433","sourcePersonId":"egs:creator:34689","canonicalEntityId":"vndb:s20433","name":"にじはしそら","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:216364","source":"egs"}],"scenario":[{"creditedName":"屑美たけゆき","creatorId":"vndb:s585","sourcePersonId":"egs:creator:460","canonicalEntityId":"vndb:s585","name":"屑美たけゆき","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:216365","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c88338","characterName":"二川 啓司","sourceIds":{"bangumi":[{"characterId":"155308","match":"exact-normalized-name-in-linked-work","subjectId":"298755"}],"egsCharacterIds":["22195"],"vndbCharacterId":"c88338"},"originalCharacterName":"二川 啓司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story."},{"spoiler":false,"text":"He is active as a professional gamer while attending school."},{"spoiler":false,"text":"Although he has a slightly nervous and sensitive side, he is a straightforward and good-natured person at heart."},{"spoiler":false,"text":"However, he is somewhat shy and is awkward around real-life women."},{"spoiler":false,"text":"He lives alone due to his work, but ends up living together with Kanata, who suddenly appeared from his monitor one day."},{"spoiler":false,"text":"From Official Website"}],"source":"vndb","sourceCharacterId":"c88338"},{"segments":[{"spoiler":false,"text":"物語の主人公。"},{"spoiler":false,"text":"学園に通いながらプロゲーマーとして活動している。"},{"spoiler":false,"text":"少々神経質で繊細な面はあるが、性根のまっすぐなお人よし。"},{"spoiler":false,"text":"ただ、やや人見知りなところがあり、リアル女性は苦手。"},{"spoiler":false,"text":"仕事の関係で一人暮らしをしているが、ある日突然モニターから現れたカナタと一緒に生活することになる。"}],"source":"egs","sourceCharacterId":"22195","sourceWorkId":"29177","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af5140d72887205806eb2e2fa534937899772aef2b85f542444eb7cb778e8b28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c788333e3d07895e0a7839b3f500128d37932a9f22a6d390199122837e747d61.webp","width":252,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c88339","characterName":"牧島 勇人","sourceIds":{"bangumi":[{"characterId":"155309","match":"exact-normalized-name-in-linked-work","subjectId":"298755"}],"egsCharacterIds":["22197"],"vndbCharacterId":"c88339"},"originalCharacterName":"牧島 勇人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A professional gamer who belongs to a different team than Keiji."},{"spoiler":false,"text":"Ever since playing against Keiji in a game before going pro and losing, he has viewed Keiji as a rival."},{"spoiler":false,"text":"He is highly self-confident, haughty, and arrogant—having what is known as a domineering (\"ore-sama\") personality. However, he is strict with both himself and others, and due to his uncompromising words and actions, he has gained popularity as a professional gamer in a villainous (heel) role."},{"spoiler":false,"text":"He is strictly gay."},{"spoiler":false,"text":"From Official Website"}],"source":"vndb","sourceCharacterId":"c88339"},{"segments":[{"spoiler":false,"text":"啓司とは別のチームに所属するプロゲーマー。"},{"spoiler":false,"text":"かつてプロ入り前の啓司とゲームで対戦し敗北しており、以来、啓司のことをライバル視している。"},{"spoiler":false,"text":"自信家、尊大で傲慢という所謂オレ様系な性格だが、他人にも自分にも厳しく、徹底した言動ゆえに、悪役的ポジションのプロゲーマーとして人気を博している。"},{"spoiler":false,"text":"純然たるゲイ。"}],"source":"egs","sourceCharacterId":"22197","sourceWorkId":"29177","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73fc2d3709a8567f082423d9594b394b0db2952db875978b0c124a63c2b9a7a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a782205966b22882ae04f72261bc8998b49df00a7019558bce36e8901991da8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林優希","creatorId":"vndb:s21651","sourcePersonId":"vndb:s21651","canonicalEntityId":"vndb:s21651","name":"小林 優希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:298755:155309:56076:1","source":"bangumi"}]},{"characterId":"char_vndb_c88337","characterName":"遥 カナタ","sourceIds":{"vndbCharacterId":"c88337"},"originalCharacterName":"遥 カナタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who, one day, popped right out of the monitor in Keiji's room."},{"spoiler":false,"text":"She has a highly energetic, upbeat, and innocent personality, along with boundless curiosity."},{"spoiler":false,"text":"According to her, the most fitting description for her existence is an \"electronic lifeform,\" or to put it simply, an alien."},{"spoiler":false,"text":"Although she possesses a flesh-and-blood physical body no different from a human's, her abilities allow her to do just about anything, from diving into monitors to freely manipulating electronic devices."},{"spoiler":false,"text":"She is currently active as a virtual idol under the name \"Haruka Kanata.\""},{"spoiler":false,"text":"From Official Website"}],"source":"vndb","sourceCharacterId":"c88337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/404cf42c62a1eece17e15ef09b760e54faa1b9f4c2646bbab5bdc40723061d3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fb03525e6c619fa97366d3b5a2a0db523bb8880de55a42a7dd5ddab4b25db37.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"琉花 あか","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"藤咲ウサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:83963","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p56","sourceCompanyId":"egs:brand:1387","canonicalEntityId":"vndb:p56","name":"あかべぇそふとつぅ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29177:1387","source":"egs"},{"companyId":"vndb:p56","sourceCompanyId":"vndb:p56","canonicalEntityId":"vndb:p56","name":"あかべぇそふとつぅ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:77460:v27748","source":"vndb"},{"companyId":"vndb:p56","sourceCompanyId":"vndb:p56","canonicalEntityId":"vndb:p56","name":"あかべぇそふとつぅ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:78839:v27748","source":"vndb"},{"companyId":"vndb:p56","sourceCompanyId":"vndb:p56","canonicalEntityId":"vndb:p56","name":"あかべぇそふとつぅ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:79908:v27748","source":"vndb"},{"companyId":"vndb:p29724","sourceCompanyId":"vndb:p29724","canonicalEntityId":"vndb:p29724","name":"如月雫","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:87285:v27748","source":"vndb"}],"missingStates":[],"so