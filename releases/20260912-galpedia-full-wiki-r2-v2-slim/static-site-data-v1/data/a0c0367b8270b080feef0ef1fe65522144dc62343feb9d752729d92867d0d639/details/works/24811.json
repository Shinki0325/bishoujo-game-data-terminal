ceCharacterId":"14908","sourceWorkId":"24811","spoiler":false},{"segments":[{"spoiler":false,"text":"下町で銭湯を経営する美人未亡人。"},{"spoiler":false,"text":"夫を早くに亡くし、女手一つで 2人の娘を育ててきた。"},{"spoiler":false,"text":"しかし銭湯の経営は上手くいかず、赤字が続く日々を送っている。"},{"spoiler":false,"text":"主人公には仕事を手伝ってもらったり助言をもらったりで、徐々に好意を抱いていく。"},{"spoiler":false,"text":"また娘たちのためにお金を稼ぎたい一心で、主人公の手ほどきを受けていく。"},{"spoiler":false,"text":"そして徐々にソープのようなサービスをしていく内に、物足りなさを感じていく。"},{"spoiler":false,"text":"「女性の魅力は、やっぱり…… 包容力なんじゃないかしら」"}],"source":"bangumi","sourceCharacterId":"50765"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"14908","sourceWorkId":"24811","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"14908","sourceWorkId":"24811","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"14908","sourceWorkId":"24811","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"14908","sourceWorkId":"24811","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/023040a237795b2a9b51333eed03079a1c985b7ad45e5c422b0a88e4a22a2919.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/657b1b60be49fde4587b3553c53c9bed53e929f1c81a7fdc18001ef52e256466.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:207840:50765:5924:1","source":"bangumi"}]},{"characterId":"char_c60647","characterName":"門倉 愛実","sourceIds":{"bangumi":[{"characterId":"50766","match":"exact-normalized-na