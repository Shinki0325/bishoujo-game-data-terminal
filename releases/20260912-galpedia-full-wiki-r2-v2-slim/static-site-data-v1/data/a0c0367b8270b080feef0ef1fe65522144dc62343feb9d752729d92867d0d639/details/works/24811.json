xt":"性知識を学校や母親、姉から教わっていて純粋にどういうのか興味があり、隠れて銭湯に来る男性の裸などを覗くこともある。"},{"spoiler":false,"text":"体が非常に柔らかく、新体操部に誘われたことがあるほど。"}],"source":"egs","sourceCharacterId":"14910","sourceWorkId":"24811","spoiler":false},{"segments":[{"spoiler":false,"text":"門倉家の次女。 姉と同じ学園に通っている一年生。"},{"spoiler":false,"text":"姉同様、少しでも母の手伝いができればと考えている。"},{"spoiler":false,"text":"性知識には興味深々で、銭湯に来る男性の裸を隠れて覗き見ることもある。"},{"spoiler":false,"text":"姉のことを慕い、よく一緒にいることが多い。"},{"spoiler":false,"text":"身体が非常に柔らかく、新体操部に誘われたことがあるほど。"},{"spoiler":false,"text":"「私たち、もう子供じゃないんだから！」"}],"source":"bangumi","sourceCharacterId":"50767"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"14910","sourceWorkId":"24811","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"14910","sourceWorkId":"24811","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"14910","sourceWorkId":"24811","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"14910","sourceWorkId":"24811","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e5e59967d3b6f870d84bf9dc6a454081100e9694884a8c9ebe37af619d2991b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19c18dcd0d0acb96b7607a0624240de932ac73b150ee8ee3f7b45bb26f1bb1d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮瀬 ゆゆ","creatorId":"vndb:s14284","sourcePersonId":"vndb:s14284","canonicalEntityId":"vndb:s14284","name":"宮瀬ゆゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73018","source":"vndb"}]},{"characterId":"char_vndb_c60649","characterName":"神崎 紅葉","sourceIds":{"vndbCharacterId":"c60649"},"ori