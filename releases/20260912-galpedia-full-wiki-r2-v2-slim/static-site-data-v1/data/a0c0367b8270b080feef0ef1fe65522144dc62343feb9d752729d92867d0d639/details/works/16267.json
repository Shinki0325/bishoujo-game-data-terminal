魅玲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruna Mirei is a girl who transferred into Murasame's class from Finland. Her great looks immediately make her the center of attention for the male students. Acting thoughtlessly and poorly informed about life in modern day Japan, she relies on Murasame for many things. Approaching Murasame using her beautiful appearance as a weapon, she seeks his love, but..."},{"spoiler":false,"text":"Haruna Mirei's true form is Miretto, princess of the ancient mamano known as succubi which the maou's army excavated from an underground fort. She seems to hate the Zau kingdom's royal family for some reason. She is a powerful existence in her capacity of working for the maou army's general, and her loyalty to the maou is also great."}],"source":"vndb","sourceCharacterId":"c9781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6963e97354cc144a3b9fb0b4d842ada24af90c3f6f0d307e8d45c257841db4fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c950cc9036ff8cbd59bf83e70a7ce7d3d50910f2004267d909d42cf87a0c4de3.webp","width":152,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキ カナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50283","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:3452","sourceCompanyId":"egs:brand:3452","canonicalEntityId":"egs:brand:3452","name":"ソンム製作所","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:16267:3452","source":"egs"},{"companyId":"vndb:p310