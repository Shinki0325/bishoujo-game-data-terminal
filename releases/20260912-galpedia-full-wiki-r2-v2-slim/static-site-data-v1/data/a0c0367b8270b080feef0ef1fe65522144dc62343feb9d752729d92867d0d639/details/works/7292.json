cterIds":["25754"],"vndbCharacterId":"c28757"},"originalCharacterName":"平山 深雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"両親を亡くした主人公の前に、突然現れたミステリアスな女性。"},{"spoiler":false,"text":"主人公の姉を名乗り、以来、主人公の実家で暮らすようになり、冬になると帰ってくる主人公を出迎えるようになる。"},{"spoiler":false,"text":"主人公よりも三つ年上で、優しくおっとりしていて、それでいて気丈な一面も。"},{"spoiler":false,"text":"主人公に対しては、何かと甘く、過保護。"},{"spoiler":false,"text":"何故か、あまり外に出たがらず、他人と接することを避けている。"}],"source":"egs","sourceCharacterId":"25754","sourceWorkId":"7292","spoiler":false},{"segments":[{"spoiler":false,"text":"突然出现在父母双亡的修二面前，自称是姐姐的女性。"},{"spoiler":false,"text":"从那以来，在上山市的修二的老家等候着只在冬季期间回来的修二。"},{"spoiler":false,"text":"温柔、稳重，但也有着坚强的一面。对修二总有点溺爱、过度保护。"},{"spoiler":false,"text":"不知出于什么原因，不太想出去，回避着和周围人接触。也包括这方面，神秘的一面多处可见。"},{"spoiler":false,"text":"和修二的关系靠着只在冬季再开，姐弟的羁绊越来越强烈深刻。"}],"source":"bangumi","sourceCharacterId":"11428"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8614b0e6b0f4e1b4712fa9c62117bd2ab01ef7fcfc381f96811d62d7bb1a0e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f5e45db0c711409927f7271d47b8110bfe573232d3a971b6ac90d3fa12bdb57.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:882:11428:4809:1","source":"bangumi"}]},{"characterId":"char_c28758","characterName":"鈴間 紫子","sourceIds":{"bangumi":[{"characterId":"281","match":"exact-normalized-name-in-linked-work","subjectId":"882"}],"egsCharacterIds":["25755"],"vndbCharacterId":"c28758"},"originalCharacterName":"鈴間 紫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の友人。田舎町の悪ガキ三人組の一人（紅一点）。"},{"spoiler":false,"text":"上山の鈴間神社の娘。"},{"spoiler":false,"text":"明朗快活で、活動的な性格。また楽観主義者。"},{"spoiler":false,"text":"面倒見もよく、お節介なところも。"},{"spoiler":false,"text":"負けず嫌いで男勝り、幼少の頃は町の男の子たちをなぎ倒し、「上山の鬼娘」とあだ名されていた。"},{"spoiler":false,"text":"化粧っ気もなく、ボーイッシュだった彼女も、ある時を境にして女の子らしさを意識し始める。"}],"source":"egs","sourceCharacterId":"25755","sourceWorkId":"7292","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的友人、坏小孩三人组的一点红。"},{"spoiler":false,"text":"上山市的鈴間神社的女儿。快活。充满活动性。非常乐观。擅长爬树和打雪仗。喜欢跑步。这样子，简直是巾帼不让须眉。不服输，小时候将街道上的男孩子们打得落花流水，得到的绰号是「上山之鬼娘」。"},{"spoiler":false,"text":"完全没有化妆的意思，曾经短发，很男孩子气，但以某时为分界线开始注重着装打扮。"}],"source":"bangumi","sourceCharacterId":"281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/821efd8611152b1f086910ba2302751caf8c3b3554a6cdfd4b0aeac7091b29c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a59e2bf4b22d6265abb5fe060be9f6a569c33f85fd1d8bfec2e9b4ae51eae9b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:882:281:4675:1","source":"bangumi"}]},{"characterId":"char_c28759","characterName":"平山 成美","sourceIds":{"bangumi":[{"characterId":"11429","match":"exact-normalized-name-in-linked-work","subjectId":"882"}],"egsCharacterIds":["25756"],"vndbCharacterId":"c28759"},"originalCharacterName":"平山 成美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の父親の弟の一人娘。主人公の従妹。"},{"spoiler":false,"text":"両親から溺愛されて育ったため、かなりワガママで自分勝手。"},{"spoiler":false,"text":"また即物的で享楽的。"},{"spoiler":false,"text":"支配欲も人一倍強く、思い通りにならないと癇癪を起す。"},{"spoiler":false,"text":"主人公が自分の両親の世話になっていることから、やや主人公を見下し、自分の所有物的な思い込みがある。"},{"spoiler":false,"text":"それでも身近な異性である主人公には兄妹にも似た心象を持っており、それが歪んだ愛情となって現れることも……。"}],"source":"egs","sourceCharacterId":"25756","sourceWorkId":"7292","spoiler":false},{"segments":[{"spoiler":false,"text":"修二的叔父的独生女。因此和修二是堂兄妹的关系。"},{"spoiler":false,"text":"因为被双亲溺爱着长大，野蛮任性。很现实，信奉享乐主义。"},{"spoiler":false,"text":"对主人公抱有好感，但比起主人公的人格，其实更被他的外貌吸引。"},{"spoiler":false,"text":"被自己的双亲收留，因为这层关系，基本上俯视着修二，将他当成自己的所有物摆弄。另一方面，对近在咫尺的异性修二怀有类似兄妹的印象，以扭曲的爱情的形式表现出来。"}],"source":"bangumi","sourceCharacterId":"11429"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f44ad0e635f7626361c45e38e71bdd3a137263e91450d7c725f11cd2600092b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/043b9aecaebbdfcbd22d10a23b15dfdbe648f432f67127c06d32cd7e34d48b93.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:882:11429:4832:1","source":"bangumi"}]},{"characterId":"char_c58957","characterName":"吉祥笹 香里","sourceIds":{"bangumi":[{"characterId":"92291","match":"exact-normalized-name-in-linked-work","subjectId":"882"}],"egsCharacterIds":["25757"],"vndbCharacterId":"c58957"},"originalCharacterName":"吉祥笹 香里","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪ガキ三人組の一人・山鹿友文の親戚。"},{"spoiler":false,"text":"舞台となる田舎町・上山の友人の中では唯一の年下。"},{"spoiler":false,"text":"性格は、内気な恥ずかしがり屋さんで、常に誰かの後ろに隠れている。"}],"source":"egs","sourceCharacterId":"25757","sourceWorkId":"7292","spoiler":false},{"segments":[{"spoiler":false,"text":"かみのやまの友達の中で唯一年下の後輩で、山鹿のいとこ。人見知りでおとなしい。"},{"spoiler":false,"text":"しかし数年ぶりの再会時、態度の変化に主人公は呆気にとられる。"}],"source":"bangumi","sourceCharacterId":"92291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a468990749d87353e2885daa67963705f737adfe62880fb1bbaea06fc6dc2a07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8762d66e40a494836fa1510dc3e26de7926df5b3bfb970b6cb9e47a62cb7bc89.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:882:92291:4689:1","source":"bangumi"}]},{"characterId":"char_c58958","characterName":"山鹿 友文","sourceIds":{"bangumi":[{"characterId":"92288","match":"exact-normalized-name-in-linked-work","subjectId":"882"}],"egsCharacterIds":["25758"],"vndbCharacterId":"c58958"},"originalCharacterName":"山鹿 友文","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪ガキ三人組の一人。"},{"spoiler":false,"text":"都会的なセンスに憧れを持つ、田舎のガキ大将。"},{"spoiler":false,"text":"あまり細かいことにこだわらない、気さくで面倒見のよい性格。"}],"source":"egs","sourceCharacterId":"25758","sourceWorkId":"7292","spoiler":false},{"segments":[{"spoiler":false,"text":"かみのやまの友達。典型的なガキ大将タイプで面倒見はよく、細かいことにはこだわらない性格。"}],"source":"bangumi","sourceCharacterId":"92288"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d951b76c53dd63ee61acb1449d19063216457fc7630e22e5123ff2466fcdf7fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aeeb02a98efef265402f9c69e7133d984ce9d480063d4f7e33190ab4a90fa3b2.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c58960","characterName":"高科 道成","sourceIds":{"bangumi":[{"characterId":"92289","match":"exact-normalized-name-in-linked-work","subjectId":"882"}],"egsCharacterIds":["25759"],"vndbCharacterId":"c58960"},"originalCharacterName":"高科 道成","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪ガキ三人組の一人。四人兄妹の長男。"},{"spoiler":false,"text":"ぽっちゃりタイプでとろそうに見えるが、意外に知恵者で、世渡り上手。"},{"spoiler":false,"text":"常に何かを食べており、片手の食べ物がトレードマーク（？）。"}],"source":"egs","sourceCharacterId":"25759","sourceWorkId":"7292","spoiler":false},{"segments":[{"spoiler":false,"text":"かみのやまの友達。太っちょで常に何か食べている。"},{"spoiler":false,"text":"見たままのキャラでマイペースだが、世渡り上手で意外にめざとい。"}],"source":"bangumi","sourceCharacterId":"92289"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/083522667352298acb32b19f12352fbdf8272e2898d5ca95c01aac810f236a19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb9efc9ec7c7c5d8b9376eedaeec9c85b7c61ed58d22988ae36e327c06fb55b7.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c117389","characterName":"平山 修二","sourceIds":{"vndbCharacterId":"c117389"},"originalCharacterName":"平山 修二","characterNameSource":null,"role":"main","status":"source-only-cand