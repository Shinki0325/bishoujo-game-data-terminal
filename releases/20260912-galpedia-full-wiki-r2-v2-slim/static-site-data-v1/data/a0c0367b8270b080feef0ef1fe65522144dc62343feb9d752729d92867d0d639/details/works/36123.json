,"creatorId":"vndb:s10712","sourcePersonId":"vndb:s10712","canonicalEntityId":"vndb:s10712","name":"鳥の","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116365","source":"vndb"},{"creditedName":"餅介","creatorId":"vndb:s10717","sourcePersonId":"vndb:s10717","canonicalEntityId":"vndb:s10717","name":"餅介","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116366","source":"vndb"},{"creditedName":"となぴょん","creatorId":"vndb:s10623","sourcePersonId":"vndb:s10623","canonicalEntityId":"vndb:s10623","name":"とな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116367","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c39070","characterName":"ティピィ","sourceIds":{"vndbCharacterId":"c39070"},"originalCharacterName":"ティピィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The \"Blue Little Lady\" from the library. She lives in the town's library. For some reason, she is often found crying."},{"spoiler":false,"text":"In the age of digital books, this strangeplace for storing physical copies still exists."},{"spoiler":false,"text":"Shiona calls her \"Blue Girl\"."},{"spoiler":false,"text":"\"Hey, Rei, what book are you looking for today?\""},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c39070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f35ac84128e19399ce10b2315a8c635e7b012c6730fbceaea7ae538ca3b670a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3af7e2a9ac7504412153ffd0890dd05e70b63483657d31ba7e7150e97357a87.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"久野 美咲","creatorId":"vndb:s7388","sourcePersonId":"vndb:s7388","canonicalEntityId":"vndb:s7388","name":"久野 美咲","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62360","source":"vndb"}]},{"characterId":"char_vndb_c39071","characterName":"シオナ","sourceIds":{"vndbCharacterId":"c39071"},"originalCharacterName":"シオナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The girl who sings her feelings."},{"spoiler":false,"text":"Shiona is the young girl who found Rei. She lives in a church located in one of the makeshift towns of the devastated world. Nothing can erase the smile from her face. She's also often found consoling others."},{"spoiler":false,"text":"She frequently refers to the feelings and emotions of people in terms of shapes and colors, which can be difficult to understand."},{"spoiler":false,"text":"She loves to sing and often performs in the church or the town square."},{"spoiler":false,"text":"\"How about Rei? It's a cool name with just a bit a bite of it, don't you think?\""},{"spoiler":false,"text":"From the offcial website"}],"source":"vndb","sourceCharacterId":"c39071"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a73f12eefc0152bf58356b650b120157f20066ea23fe5246b6484543f75931d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9a2dc8046ef2d152ef83a3f25266916c0a38fc119c49ec2b543296fad64263c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水橋 かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62358","source":"vndb"}]},{"characterId":"char_vndb_c39072","characterName":"レイ","sourceIds":{"vndbCharacterId":"c39072"},"originalCharacterName":"レイ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rei is a humanoid feeling robot called Phiroid that is awakened inside an decayed facility. Rei's development probably hasn't finished since his right hand is not covered with artifical skin, and is showing the mechanical parts. He finds out that an important program that responsible for him to show \"feelings\", is missing from him."},{"spoiler":false,"text":"Edited from the official VisualArts English Facebook page"}],"source":"vndb","sourceCharacterId":"c39072"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c52cacca4f6508293a63bb125a4ee72f6dcf97221bb85fb89e7c6d52306c82a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdbb684dfe9f3ac3ba7e938c811d6e4f00e9193fa346fb2edf5f80370dfb45ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西谷 亮","creatorId":"vndb:s26063","sourcePersonId":"vndb:s26063","canonicalEntityId":"vndb:s26063","name":"西谷 亮","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62361","source":"vndb"}]},{"characterId":"char_vndb_c52150","characterName":"マッド","sourceIds":{"vndbCharacterId":"c52150"},"originalCharacterName":"マッド","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The tough and scary looking shopkeeper in town."},{"spoiler":false,"text":"In contrast to his strong body, his speciality is precision work. At the dump site of the abandoned factory, he is scavenging junk which he repairs and sells."},{"spoiler":false,"text":"He tends to getting upset over trivial matters."},{"spoiler":false,"text":"\"You again! Just what did you come here!?\""},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c52150"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f510673c6fb6546b1fa0f95ac322adfb229738f125ec7d8a8321c8e26e95f583.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29fb3ad3accb0f090f9b33e3eec831733e4887ffabb2853ec79e70a0e5ad5546.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三宅 健太","creatorId":"vndb:s2119","sourcePersonId":"vndb:s2119","canonicalEntityId":"vndb:s2119","name":"三宅 健太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62359","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p24","sourceCompanyId":"egs:brand:83","canonicalEntityId":"vndb:p24","name":"Key","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:36123:83","source":"egs"},{"companyId":"vndb:p24","sourceCompanyId":"vndb:p24","canonicalEntityId":"vndb:p24","name":"Key","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:103474:v16510","source":"vndb"},{"companyId":"vndb:p26","sourceCompanyId":"vndb:p26","canonicalEntityId":"vndb:p26","name":"株式会社プロトタイプ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:103475:v16510","source":"vndb"},{"companyId":"vndb:p5862","sourceCompanyId":"vndb:p5862","canonicalEntityId":"vndb:p5862","name":"Vietnam Key FanClub","roleCodes":["publisher"],"identity