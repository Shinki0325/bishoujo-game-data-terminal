{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21268","model":{"presentationWorkId":"vndb:v16778","staff":{"artwork":[{"creditedName":"長頼","creatorId":"vndb:s2491","sourcePersonId":"egs:creator:16045","canonicalEntityId":"vndb:s2491","name":"長頼","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:144759","source":"egs"},{"creditedName":"只野あきら","creatorId":"vndb:s2573","sourcePersonId":"egs:creator:5431","canonicalEntityId":"vndb:s2573","name":"只野あきら","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:144760","source":"egs"}],"scenario":[{"creditedName":"ひらいでらく(かすか量)","creatorId":"vndb:s2502","sourcePersonId":"egs:creator:1235","canonicalEntityId":"vndb:s2502","name":"ひらいでらく(かすか量)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:144761","source":"egs"}],"music":[],"other":[{"creditedName":"ひらいで らく","creatorId":"vndb:s2502","sourcePersonId":"vndb:s2502","canonicalEntityId":"vndb:s2502","name":"ひらいで らく","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117476","source":"vndb"}]},"cast":[{"characterId":"char_c28156","characterName":"三条 真希","sourceIds":{"bangumi":[{"characterId":"45251","match":"exact-normalized-name-in-linked-work","subjectId":"128896"}],"egsCharacterIds":["5879"],"vndbCharacterId":"c28156"},"originalCharacterName":"三条 真希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1022"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名門お嬢様学校・私立桜桃女子学園に通う才女。"},{"spoiler":false,"text":"学生会の副会長を務め、教師からの信用も厚い優等生。"},{"spoiler":false,"text":"しかし本性は、昼は貞操、夜は淫乱を地でいく超淫乱体質。"},{"spoiler":false,"text":"唯一自分の本性を知る主人公にベタ惚れ中。"},{"spoiler":false,"text":"主人公への一途さとラブっぷりは確実にパワーアップしている。"}],"source":"egs","sourceCharacterId":"5879","sourceWorkId":"21268","spoiler":false},{"segments":[{"spoiler":false,"text":"名門お嬢様学校・私立桜桃女子学園に通う、眉目秀麗・容姿端麗な才女。"},{"spoiler":false,"text":"学生会の元会長であり、今でも教師からの信用が厚い優等生。"},{"spoiler":false,"text":"しかし本性は、昼は貞操、夜は淫乱を地でいく “超淫乱体質”。"},{"spoiler":false,"text":"出会いから 1年経っても主人公にベタ惚れで、そのイチャラブ具合は拍車が掛かっている。"},{"spoiler":false,"text":"「んふふー、誠一さんとお出かけ、デート、でぇと♪」"}],"source":"bangumi","sourceCharacterId":"45251"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a350db17d001e298fd02585e691f9414b4a9554cfa7eeaf685c6bc44f9c2be03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80d831bd15338e3d6a297576bd317db104dcc99de45db67f4d1084aa007a1dae.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128896:45251:15687:1","source":"bangumi"}]},{"characterId":"char_c28157","characterName":"御園 由希","sourceIds":{"bangumi":[],"egsCharacterIds":["5880"],"vndbCharacterId":"c28157"},"originalCharacterName":"御園 由希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真希の実妹。本作のもうひとりのヒロイン。"},{"spoiler":false,"text":"内向的で人見知りが激しい、引っ込み思案で恥ずかしがり屋さん。"},{"spoiler":false,"text":"本質は姉と同様の超淫乱体質だが、本人にその自覚はない。"},{"spoiler":false,"text":"主人公&姉の真希への盲目的な信頼ゆえに、緊縛やアナル開発、2穴バイブ、果てはエネマ等、どんな変態プレイも素直に受け入れていく。"}],"source":"egs","sourceCharacterId":"5880","sourceWorkId":"21268","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34b5f1c545bb89bb8806e116154ee03ab9db3ecfe9544591e50082f8e7cfd8ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efa651ba9131389952666fe5fd4c15391d336efc38691ee628264094988967bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花南","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62980","source":"vndb"}]},{"characterId":"char_c29355","characterName":"三条 真由","sourceIds":{"bangumi":[{"characterId":"152136","match":"exact-normalized-name-in-linked-work","subjectId":"128896"}],"egsCharacterIds":["5881"],"vndbCharacterId":"c29355"},"originalCharacterName":"三条 真由","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ファッションデザイナーであり、新進気鋭のファッションブランド『SANJO』の創始者で社長。"},{"spoiler":false,"text":"元モデルで、現在も若さと美貌とむちむちのプロポーションを維持。"},{"spoiler":false,"text":"かなりの享楽主義者で淫乱体質。"},{"spoiler":false,"text":"性に関してはとにかく、フリーダムで奔放。"},{"spoiler":false,"text":"娘ふたりもそこは本人の自由にさせている。"}],"source":"egs","sourceCharacterId":"5881","sourceWorkId":"21268","spoiler":false},{"segments":[{"spoiler":false,"text":"真希と由希の実母。"},{"spoiler":false,"text":"二人の子持ちとは思えないくらいの美貌で"},{"spoiler":false,"text":"「美しすぎるファッションデザイナー」としてかなりの有名人で、真由に憧れる女性は多い。"},{"spoiler":false,"text":"しかしその本性は娘たち以上の『超・超淫乱体質』であり、"},{"spoiler":false,"text":"定期的にセックスで満足しないと実生活にも支障が出るレベル。"},{"spoiler":false,"text":"「義理でも息子は息子だもの。あぁん、想像しただけで子宮がキュンキュンしちゃうわ～♪」"}],"source":"bangumi","sourceCharacterId":"152136"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bi