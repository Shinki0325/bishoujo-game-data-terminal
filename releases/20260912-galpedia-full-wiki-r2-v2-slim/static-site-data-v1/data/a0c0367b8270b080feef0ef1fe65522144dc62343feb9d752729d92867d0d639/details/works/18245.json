":[{"spoiler":false,"text":"【野球少女】"},{"spoiler":false,"text":"野球が大好きな少女。"},{"spoiler":false,"text":"しかし女子なので野球部に入れず、青年団のチームに入りつつ、寂れたバッティングセンターで練習する日々。"},{"spoiler":false,"text":"野球部員に全く打てない事をからかわれていた剛士を見かね、自分の行きつけのバッティングセンターに剛士を連れ出し、バッティングの指導をする。"},{"spoiler":false,"text":"しかし、その教え方は抽象的でよく分からない。"},{"spoiler":false,"text":"【萌乃】「球が来たら、こう腰をクイッとひねって、バットをガッと握り、バシュッと振ればいいの！こう！」"},{"spoiler":false,"text":"一人称は「ボク」。"},{"spoiler":false,"text":"左打ち。"}],"source":"egs","sourceCharacterId":"223","sourceWorkId":"18245","spoiler":false},{"segments":[{"spoiler":false,"text":"野球が大好きな少女。 一人称は “ボク”。"},{"spoiler":false,"text":"しかし女子なので野球部には入れず、青年団のチームに入りつつ、寂れたバッティングセンターで練習する日々。 左打ち。"},{"spoiler":false,"text":"野球部員にまったく打てないことをからかわれていた剛士を見かね、自分の行きつけのバッティングセンターに剛士を連れ出し、バッティングの指導をする。"},{"spoiler":false,"text":"しかし、その教え方は抽象的でよく分からない。"},{"spoiler":false,"text":"【萌乃】「球が来たら、こう腰をクイッとひねって、バットをガッと握り、バシュッと振ればいいの！　こう！」"}],"source":"bangumi","sourceCharacterId":"175482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8efde509c787730b209d477b5bf48f7de5e0295d070244c7dfbb7314d14a3d50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9ee8496ddb4050d4e8a225b527438f8c988d85a0c365046f827ae03b89333ee3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65632:175482:10027:1","source":"bangumi"}]},{"characterId":"char_c22272","characterName":"玉井 優子","sourceIds":{"bangumi":[{"characterId":"175489","match":"exact-normalized-name-in-linked-work","subjectId":"65632"}],"egsCharacterIds":["224"],"vndbCharacterId":"c22272"},"originalCharacterName":"玉井 優子","characterNameSource":null,"role":"primary","status":"source-only-candidate"