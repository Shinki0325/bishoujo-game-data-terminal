{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18245","model":{"presentationWorkId":"vndb:v12303","staff":{"artwork":[{"creditedName":"わざきた","creatorId":"vndb:s4992","sourcePersonId":"egs:creator:474","canonicalEntityId":"vndb:s4992","name":"わざきた","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:115106","source":"egs"},{"creditedName":"おしゃれ教室","creatorId":"vndb:s4991","sourcePersonId":"egs:creator:1311","canonicalEntityId":"vndb:s4991","name":"おしゃれ教室","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:115108","source":"egs"},{"creditedName":"アジシオ","creatorId":"vndb:s5002","sourcePersonId":"egs:creator:18196","canonicalEntityId":"vndb:s5002","name":"アジシオ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:115109","source":"egs"}],"scenario":[{"creditedName":"モルデカイ","creatorId":"vndb:s4993","sourcePersonId":"egs:creator:2638","canonicalEntityId":"vndb:s4993","name":"モルデカイ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:115110","source":"egs"}],"music":[],"other":[{"creditedName":"わざきた","creatorId":"vndb:s4992","sourcePersonId":"egs:creator:474","canonicalEntityId":"vndb:s4992","name":"わざきた","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:115107","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:98020","source":"vndb"}]},"cast":[{"characterId":"char_c22264","characterName":"未来","sourceIds":{"bangumi":[{"characterId":"19940","match":"exact-normalized-name-in-linked-work","subjectId":"65632"}],"egsCharacterIds":["216"],"vndbCharacterId":"c22264"},"originalCharacterName":"未来","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school student Tsuyoshi bumps into with bread in her mouth. She is bright and cheerful, and instead of apologizing, she gives him her half-eaten bread. Tsuyoshi is surprised by the sudden indirect kiss. The same thing happens many times, and the two of them keep getting closer with each other, but..."}],"source":"vndb","sourceCharacterId":"c22264"},{"segments":[{"spoiler":false,"text":"【食パン少女】"},{"spoiler":false,"text":"剛士がある朝、登校中に曲がり角で出会い頭にぶつかってしまう少女。"},{"spoiler":false,"text":"明るく元気な性格。"},{"spoiler":false,"text":"その後も、何度も出会うことになるが、そのたびにぶつかってしまう。"},{"spoiler":false,"text":"口にいつも食パンを咥え、「遅刻、遅刻」と慌てている。"},{"spoiler":false,"text":"はじめて出会った時、謝罪をしなくてはと未来は慌て、思わず自分の食べかけの食パンを剛士の口へと強引に押し込んでくる。"},{"spoiler":false,"text":"剛士は不意に起こった間接キスに戸惑ってしまう。"},{"spoiler":false,"text":"そんな事が何回か続くと、次第に彼女が気になっていく剛士。"},{"spoiler":false,"text":"二人の仲は徐々に近くなっていくが、彼女には何かヒミツがありそう？"}],"source":"egs","sourceCharacterId":"216","sourceWorkId":"18245","spoiler":false},{"segments":[{"spoiler":false,"text":"剛士上学时在转角处突然撞到头的开朗少女。 连谢罪也没有就直接将自己口中的素面包强行塞进剛士的口中。 剛士因为突然间的间接接吻而呆住。"},{"spoiler":false,"text":"这种事情发生了几次后，剛士逐渐开始在意起她来。"},{"spoiler":false,"text":"两人的关系渐渐接近……？"}],"source":"bangumi","sourceCharacterId":"19940"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e0c029167ac59ac023d78b5bbce6c1d728c463eba06f1feb26e1a7f4b652e2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ad0d7ba55172a5762a72f5ae31413f38fdcd96948feb3d5e466a9ed162cde04.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65632:19940:10026:1","source":"bangumi"}]},{"characterId":"char_c22265","characterName":"黒川 麻里子","sourceIds":{"bangumi":[{"characterId":"19941","match":"exact-normalized-name-in-linked-work","subjectId":"65632"}],"egsCharacterIds":["217"],"vndbCharacterId":"c22265"},"originalCharacterName":"黒川 麻里子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader of the group which bullies Tsuyoshi , and who is also a daughter of a major group's CEO. Instead of fighting herself, she sends her underlings, especially Yuuka to deal with Tsuyoshi ."}],"source":"vndb","sourceCharacterId":"c22265"},{"segments":[{"spoiler":false,"text":"【いじめっ娘】"},{"spoiler":false,"text":"剛士をいじめている三人組のうちの主犯格。"},{"spoiler":false,"text":"大手企業の重役の娘。"},{"spoiler":false,"text":"何かにつけ剛士にちょっかいをかけるが、自ら手を下すことはなく、いつも連れている木下優花と高城陽に行動させる。"},{"spoiler":false,"text":"ある時は朝の挨拶がないと凄み、ある時は剛士の弁当を牛乳漬けにする。"},{"spoiler":false,"text":"ある日剛士に難癖をつけ校舎裏に呼び出し、彼の性器を踏みつけようとするが、突如轟いた銃声に恐怖し、剛士の逆襲を受ける事となる。"},{"spoiler":false,"text":"だが、そのイジメにも意外な理由がある様子。"}],"source":"egs","sourceCharacterId":"217","sourceWorkId":"18245","spoiler":false},{"segments":[{"spoiler":false,"text":"欺负剛士的三人组的头头。"},{"spoiler":false,"text":"大手企业中的重要人员的女儿。"},{"spoiler":false,"text":"一有机会就找剛士的茬，但不是自己亲自动手，而是让平时跟在自己身边的木下優花和高城陽实行。"},{"spoiler":false,"text":"某天想要找茬而把剛士叫到校舍背后，想要踩住他的下半身的时候被突然响起的枪声震住，被剛士逆袭。"}],"source":"bangumi","sourceCharacterId":"19941"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b856e75ec6f77b3f044a5d5e614455b4700ac950b082d70f49ef8ac9ea9334c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48efb146270c2400f4a243f68a06282918025d989bcfc68bbddace8f4bc44337.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65632:19941:6359:1","source":"bangumi"}]},{"characterId":"char_c22266","characterName":"木下 優花","sourceIds":{"bangumi":[{"characterId":"19942","match":"exact-normalized-name-in-linked-work","subjectId":"65632"}],"egsCharacterIds":["218"],"vndbCharacterId":"c22266"},"originalCharacterName":"木下 優花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Mariko's underlings who stands out due to being abnormally skinny. She and Tsuyoshi are pretty similar, however, she bullies Tsuyoshi so in exchange, she won't be bullied by Mariko. She is also very insecure of her body and doesn't like people touching it."}],"source":"vndb","sourceCharacterId":"c22266"},{"segments":[{"spoiler":false,"text":"【ガリ少女】"},{"spoiler":false,"text":"麻里子の取り巻きのひとり。"},{"spoiler":false,"text":"裸になればアバラや尾てい骨が浮き出ているほどに異常に痩せている。"},{"spoiler":false,"text":"元来は剛士と同類の大人しい性格だが、実はいじめっ娘に取り入ることで虐められるのを回避している。"},{"spoiler":false,"text":"麻里子の失墜後、今度は剛士に取り入ってこようとするが……"}],"source":"egs","sourceCharacterId":"218","sourceWorkId":"18245","spoiler":false},{"segments":[{"spoiler":false,"text":"麻里子的跟班之一。"},{"spoiler":false,"text":"身体瘦得裸体时肋骨和尾骨会暴露出来。"},{"spoiler":false,"text":"本来和剛士一样是性格内向的人，但其实在通过取悦某个爱欺负人的少女以不让自己被欺负。"},{"spoiler":false,"text":"在麻里子失去威信之后打算奉承剛士……"}],"source":"bangumi","sourceCharacterId":"19942"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcbaa107a70ea9051ec99f7f4625af290406f97197460b49809107a73eb1efa4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85a4f329773e6b6a735be7f79e099478fe9249222822de3c3a3dbe76eedb8c5e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65632:19942:6083:1","source":"bangumi"}]},{"characterId":"char_c22267","characterName":"高城 陽","sourceIds":{"bangumi":[{"characterId":"19943","match":"exact-normalized-name-in-linked-work","subjectId":"65632"}],"egsCharacterIds":["219"],"vndbCharacterId":"c22267"},"originalCharacterName":"高城 陽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Mariko's underlings who is very rude. She wishes to become number one in her class so she could be like Mariko; in reality, she wants to replace Mariko because she actually looks down on her, and acts like one of her underlings in order to take her out."}],"source":"vndb","sourceCharacterId":"c22267"},{"segments":[{"spoiler":false,"text":"【チビ少女】"},{"spoiler":false,"text":"麻里子の取り巻きのひとり。彼女のグループの特攻隊長的役割。"},{"spoiler":false,"text":"チビでとても生意気な少女。"},{"spoiler":false,"text":"麻里子の取り巻きではあるが本心では麻里子を疎ましく思っており、力のある者に付くことで自分の地位を高く見せるようにしている。"},{"spoiler":false,"text":"機会があれば、自分が頂点に立とうと考えている。"},{"spoiler":false,"text":"まずはクラスのナンバーワンを目指し、そこから更なる高みを目指す。"},{"spoiler":false,"text":"麻里子が失墜した今、いよいよ今度は自分が支配者の頂点に立とうと、剛士をいじめようとするが……"}],"source":"egs","sourceCharacterId":"219","sourceWorkId":"18245","spoiler":false},{"segments":[{"spoiler":false,"text":"麻里子的跟班之一。在三人组中充当特攻队长的地位。"},{"spoiler":false,"text":"虽然矮小但极为狂妄自大的少女。"},{"spoiler":false,"text":"虽然是麻里子的跟班但却发自真心地讨厌麻里子，通过依附强者以突显自己的地位。"},{"spoiler":false,"text":"企图寻找机会让自己站立在顶点。"},{"spoiler":false,"text":"首先是以班里的顶点为目标，然后以更高处为目标。"},{"spoiler":false,"text":"在麻里子失去威信后的如今，想着自己总算是可以站立在统治者的顶点了而打算欺辱剛士……"}],"source":"bangumi","sourceCharacterId":"19943"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4da61fbc66f91f22144a4a199703e992065f5d3b38ae0eb2a758201412525c2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58e9dbe8fe50f9dc5756980ab08cf833a1ac7d7b41ce7dabeb4fed6ab7b580be.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65632:19943:13512:1","source":"bangumi"}]},{"characterId":"char_c22268","characterName":"篠崎 栞","sourceIds":{"bangumi":[{"characterId":"173356","match":"exact-normalized-name-in-linked-work","subjectId":"65632"}],"egsCharacterIds":["220"],"vndbCharacterId":"c22268"},"originalCharacterName":"篠崎 栞","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsuyoshi's classmate who is very serious. She is teased by Tsuyoshi every day due to her way too serious attitude."}],"source":"vndb","sourceCharacterId":"c22268"},{"segments":[{"spoiler":false,"text":"【真面目少女】"},{"spoiler":false,"text":"剛士のクラスメイトで、非常に真面目な少女。"},{"spoiler":false,"text":"無遅刻無欠席。成績もそこそこ優秀。"},{"spoiler":false,"text":"非常に度の強いグルグル眼鏡を掛けている。"},{"spoiler":false,"text":"真面目ではあるが、正義感が強いと言うわけではなく、剛士が虐められていても我関せずという立場を取る。"},{"spoiler":false,"text":"ある意味、その真面目さは日々を平穏に暮らすための手段なのかもしれない。"},{"spoiler":false,"text":"それはある種、銃を手にする前の剛士と似ている。"},{"spoiler":false,"text":"だが、その生き方は逆に平凡、平穏を壊す事の素晴らしさを知った剛士に狙われる原因となってしまう。"},{"spoiler":false,"text":"隠れ巨乳。"},{"spoiler":false,"text":"着痩せをしているため分からないが、脱ぐとすごい。"}],"source":"egs","sourceCharacterId":"220","sourceWorkId":"18245","spoiler":false},{"segments":[{"spoiler":false,"text":"剛士のクラスメイトで、非常にまじめな少女。"},{"spoiler":false,"text":"まじめではあるが正義感が強いというわけではなく、剛士が虐げられていても我関せずという立場を取る。"},{"spoiler":false,"text":"ある意味、そのまじめさは日々を平穏に暮らすための手段なのかもしれない。"},{"spoiler":false,"text":"だがその生き方は逆に、平凡・平穏を壊すことの素晴らしさを知った剛士に狙われる原因となってしまう。"},{"spoiler":false,"text":"隠れ巨乳。"},{"spoiler":false,"text":"着痩せをしているため判らないが、脱ぐとすごい。"}],"source":"bangumi","sourceCharacterId":"173356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d0f5853e669dcd2878304b081a0e6634b36dd544510a2b8d3518d68e8e4bfe2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7385c852fe272bc02ff659faa2e36bf7d38c79511f81dc565eb160dc66d86e35.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65632:173356:15684:1","source":"bangumi"}]},{"characterId":"char_c22269","characterName":"杉本 留璃帆","sourceIds":{"bangumi":[{"characterId":"175480","match":"exact-normalized-name-in-linked-work","subjectId":"65632"}],"egsCharacterIds":["221"],"vndbCharacterId":"c22269"},"originalCharacterName":"杉本 留璃帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsuyoshi's cousin and Jurina's older sister. She works part-time as a shop clerk. She has a very older sister-type personality, and tries to stop the people who bully Tsuyoshi."}],"source":"vndb","sourceCharacterId":"c22269"},{"segments":[{"spoiler":false,"text":"【いとこ姉】"},{"spoiler":false,"text":"剛士のいとこ姉妹の姉。"},{"spoiler":false,"text":"フリーター。アパレル系ショップ店員。"},{"spoiler":false,"text":"非常にサバサバした性格で、剛士とは真逆の性格。"},{"spoiler":false,"text":"幼い頃から付き合いがあるため、剛士の姉貴分的な存在。"},{"spoiler":false,"text":"それゆえに、剛士は彼女の事を苦手に感じている。"},{"spoiler":false,"text":"ウワサで剛士が学校でイジメにあっている事を聞きつけ、それは剛士に原因があると説教じみた話をしてくる。"},{"spoiler":false,"text":"だが、すでに以前の彼ではない事には気付けず……"}],"source":"egs","sourceCharacterId":"221","sourceWorkId":"18245","spoiler":false},{"segments":[{"spoiler":false,"text":"剛士のいとこ姉妹の姉。"},{"spoiler":false,"text":"フリーター。アパレル系ショップ店員。"},{"spoiler":false,"text":"非常にサバサバした性格で、剛士とは真逆の性格。"},{"spoiler":false,"text":"幼い頃から付き合いがあるため、剛士の姉貴分的な存在。 それゆえに剛士は彼女のことを苦手に感じている。"},{"spoiler":false,"text":"ウワサで剛士が学園でイジメにあっていることを聞きつけ、それは剛士に原因があると説教じみた話をしてくる。"},{"spoiler":false,"text":"だが、すでに以前の彼ではないことに気付けず……"}],"source":"bangumi","sourceCharacterId":"175480"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79efd371b4f5e24b61cf9179385aa767a1e9913a870437ecd4a0986ccee9cdce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f829ba6964f00d6202508070503243c4dd06519826de942627f883886f28ff6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65632:175480:4744:1","source":"bangumi"}]},{"characterId":"char_c22270","characterName":"杉本 珠理奈","sourceIds":{"bangumi":[{"characterId":"175481","match":"exact-normalized-name-in-linked-work","subjectId":"65632"}],"egsCharacterIds":["222"],"vndbCharacterId":"c22270"},"originalCharacterName":"杉本 珠理奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsuyoshi's cousin and Ruriho's younger sister. She is always cosplaying a character called \"Magical Girl Milk\". She spends her time playing with her friends due to her mother and older sister always working."}],"source":"vndb","sourceCharacterId":"c22270"},{"segments":[{"spoiler":false,"text":"【いとこ妹】"},{"spoiler":false,"text":"剛士のいとこ姉妹の妹。"},{"spoiler":false,"text":"明るく元気な少女。"},{"spoiler":false,"text":"「魔法少女ミルク」というキャラが今のブームらしく、衣装もそのキャラのものを身に着けている。"},{"spoiler":false,"text":"彼女たちの父親はすでに他界しており、今は女手ひとつで育てられている。"},{"spoiler":false,"text":"母親と姉は働きに出ているため、留璃帆が迎えに来るまで剛士の家に預けられる事もある。"},{"spoiler":false,"text":"しかし姉の留璃帆が犯されてからは、剛士の家に預けられる事もなくなり、お友達やお友達の保護者もいるため公園で遊ぶ事が多くなった。"},{"spoiler":false,"text":"日が暮れ、お友達が皆帰った後も姉が迎えに来るまで一人で遊ん