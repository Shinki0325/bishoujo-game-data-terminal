,{"creditedName":"さんきち","creatorId":"vndb:s2812","sourcePersonId":"vndb:s2812","canonicalEntityId":"vndb:s2812","name":"さんきち","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:6115","source":"vndb"}]},"cast":[{"characterId":"char_c28715","characterName":"リリア エーベルヴァイン","sourceIds":{"bangumi":[{"characterId":"94373","match":"exact-normalized-name-in-linked-work","subjectId":"80604"}],"egsCharacterIds":["26125"],"vndbCharacterId":"c28715"},"originalCharacterName":"リリア エーベルヴァイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公である“ディルク”の義妹にして、北部の辺境国ルーフェン王国の王女。"},{"spoiler":false,"text":"母親譲りの気品のある凛とした美しさと、武人としての強さも兼ね備え、近年、隣国から侵略を受けたクローヴィス戦役では勝利のきっかけとなる活躍を演じ、その美しい白衣の衣装と容姿から「白の姫騎士」と呼ばれ、先祖、聖人クリストフ・エーベルヴァインの血を最も受け継いだ聖姫とまで賞賛される稀代のお姫様。"}],"source":"egs","sourceCharacterId":"26125","sourceWorkId":"6574","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公ディルクの義妹。ルーフェンの王女。凛とした美しさと、涼やかな顔立ちの誇り高い美少女。"},{"spoiler":false,"text":"美しいその白衣の衣裳と容姿から「白の姫騎士」と謳われている。"},{"spoiler":false,"text":"戦場を駆け抜けてきたためか、男勝りなところがあり、少女に思えないくらいしっかりしている。"},{"spoiler":false,"text":"ディルクの悪い噂を知っている彼女は、彼を軽蔑しており、言い争うこともしばしばあった。"}],"source":"bangumi","sourceCharacterId":"94373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8eab149ac898ae161d53ba834f546786e0249c76dafc67c275e3b924e10df61b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be276eafbbad7e3271c44ecfb27c6e79fd1da7efd6c2e886aa76f388284fea38.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80604:94373:4744:1","source":"bangumi"}]},{"characterId":"char_c28716","characterName":"レイラ エーベルヴァイン","sourceIds":{"bangumi":[{"characterId":"94374","match":"exact-normalized-name-in-linked-work","subjectId":"80604"}],"egsCharacterIds":["26126"],"vndbCharacterId":"c28716"},"originalCharacterName":"レイラ エーベルヴァイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公である“ディルク”の義母にして、ルーフェンの王妃（後妻）。"},{"spoiler":false,"text":"社交界では「辺境の至宝」と絶賛されるほどの抜群のプロポーションと美貌の持ち主。"},{"spoiler":false,"text":"一見、その容姿と柔和な笑顔から、おっとりとした女性に見られがちだが、その実、芯の通った聡明な女性である。"}],"source":"egs","sourceCharacterId":"26126","sourceWorkId":"6574","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公ディルクの義母。ルーフェンの王妃（後妻）。"},{"spoiler":false,"text":"抜群のプロモーションと美しく長い金髪の持ち主で、社交界では「辺境の至宝」と謳われている。"},{"spoiler":false,"text":"容姿からはおっとりとした印象を受けるが、実は芯のとおった聡明な人である。性善説を強く信じており、悪い噂が絶えないディルクにも誠意を持って接している。"}],"source":"bangumi","sourceCharacterId":"94374"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30af8644d32dd0a9def98cf012d19fdf842103c9cbd31e31dd06f72e9c94e8e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3d0696ea4dfe9d3ce5c00c5678fa3ae5aace31266a01b607681e06f512f2173.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80604:94374:4918:1","source":"bangumi"}]},{"characterId":"char_c28717","characterName":"キリコ","sourceIds":{"bangumi":[{"characterId":"94375","match":"exact-normalized-name-in-linked-work","subjectId":"80604"}],"egsCharacterIds":["26127"],"vndbCharacterId":"c28717"},"originalCharacterName":"キリコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"娼館「黒の楽園館」の謎多き魔族の女主。"},{"spoiler":false,"text":"依頼されれば、たとい敬虔な修道女であろうと性に狂うメス奴隷に調教する敏腕調教師でもある。"},{"spoiler":false,"text":"そんな彼女が、娼館に頻繁に出入りしていた主人公に気に入られ、参謀に抜擢される。"},{"spoiler":false,"text":"彼女は、数千の私兵を抱えているとの噂があるのだが……。"}],"source":"egs","sourceCharacterId":"26127","sourceWorkId":"6574","spoiler":false},{"segments":[{"spoiler":false,"text":"魔族。娼館「黒の楽園館」の女調教師にして館の主。"},{"spoiler":false,"text":"館に頻繁に訪れていたディルクに接近、彼の参謀に抜擢される。"},{"spoiler":false,"text":"赤紫の瞳に銀髪の妖艶な美女。人間とくに貴族や豪商との関係が深く、依頼に応じて例え敬虔な修道女でも牝奴隷に調教すると言われている。"},{"spoiler":false,"text":"娼館の主ながら魔族数千の私兵を有しているという噂があり、その背景は謎に包まれている。"}],"source":"bangumi","sourceCharacterId":"94375"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/638d4f5b5c7491918f5a26f64ffa44d5349ba819a524f8c9b91397b898ac7090.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a134f0d549e5de23aa0fefed8a732215e884d44604ddc713d224953e9c3f5972.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80604:94375:24747:1","source":"bangumi"}]},{"characterId":"char_vndb_c33797","characterName":"魔族の使者","sourceIds":{"vndbCharacterId":"c33797"},"originalCharacterName":"魔族の使者","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative"