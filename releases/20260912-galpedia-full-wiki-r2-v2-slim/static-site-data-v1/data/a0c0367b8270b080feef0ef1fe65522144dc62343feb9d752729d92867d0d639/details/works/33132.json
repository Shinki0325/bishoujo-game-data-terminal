{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33132","model":{"presentationWorkId":"vndb:v49525","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c25791","characterName":"劉備 玄徳","sourceIds":{"bangumi":[{"characterId":"1625","match":"source-roster","subjectId":"129020"},{"characterId":"1625","match":"source-roster","subjectId":"135172"},{"characterId":"1625","match":"source-roster","subjectId":"144422"},{"characterId":"1625","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"1625","match":"source-roster","subjectId":"14463"},{"characterId":"1625","match":"source-roster","subjectId":"162447"},{"characterId":"1625","match":"source-roster","subjectId":"18333"},{"characterId":"1625","match":"source-roster","subjectId":"214099"},{"characterId":"1625","match":"source-roster","subjectId":"216765"},{"characterId":"1625","match":"source-roster","subjectId":"216766"},{"characterId":"1625","match":"exact-normalized-name-in-linked-work","subjectId":"2409"},{"characterId":"1625","match":"source-roster","subjectId":"2409"},{"characterId":"1625","match":"source-roster","subjectId":"364764"},{"characterId":"1625","match":"source-roster","subjectId":"375912"},{"characterId":"1625","match":"source-roster","subjectId":"409322"},{"characterId":"1625","match":"source-roster","subjectId":"430332"},{"characterId":"1625","match":"source-roster","subjectId":"450504"},{"characterId":"1625","match":"source-roster","subjectId":"520555"}],"egsCharacterIds":["12026"],"vndbCharacterId":"c25791"},"originalCharacterName":"劉備 玄徳","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the main female protagonists and main heroines in the Koihime†Musou series and first introduced in Shin Koihime†Musou, she is the young queen of Shoku Kingdom. Being quite young she is naive, often reluctant to go to war, and hates paperwork (much to the chagrin of Kan'u who as a result often scolds the young queen and reminds her of her duties), but has a lot of confidence on her subordinates. She falls in love with Kazuto, causing Kan'u to feel a bit of jealousy."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25791"},{"segments":[{"spoiler":false,"text":"関羽と張飛を引き連れて、動乱に怯える庶人たちの暮らしを守ろうと各地を旅していた。"},{"spoiler":false,"text":"限りない優しさと懐の大きさを持つが、極彩色の天然ボケタイプ。"}],"source":"egs","sourceCharacterId":"12026","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"蜀の君主にして、『真・恋姫†無双』 のメイン級ヒロインの一人。"},{"spoiler":false,"text":"天然ボケッとした雰囲気だが、案外強かな一面を持つ。"},{"spoiler":false,"text":"今作では蜀本国の運営は若手に任せ、他の仲間たちと共に、都の運営に四苦八苦している一刀の補佐をしている。"},{"spoiler":false,"text":"ただいま華琳の下で料理の修業中。"}],"source":"egs","sourceCharacterId":"12026","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"字玄德（げんとく）。"},{"spoiler":false,"text":"蜀路线中一刀的主要同伴。"},{"spoiler":false,"text":"带领着关羽与张飞，为了守护惧怕战争的庶人们的生活，旅行于各地。正当其时，眼前忽现白光，回过神时就看到了眼前失去意识的一刀的身影。"},{"spoiler":false,"text":"相信突然出现的一刀就是上天的使者，奉一刀为主人，登上了乱世的舞台。"},{"spoiler":false,"text":"拥有无限的温柔与宽大的胸怀，色彩缤纷的天然呆类型。"},{"spoiler":false,"text":"作为关羽与张飞的义姐，爱摆大姐的架子，提醒注意她们的不检点，施展吐槽绝技。可惜无一例外吐错了槽令人对其无可奈何或是受到无情的反击，结果到头来自挖墓穴在墙角画圈。"}],"source":"bangumi","sourceCharacterId":"1625"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"1625","value":"北乡军(蜀军)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5aff8e8e467527bdab29092b14edb582e1e2d68a0d6f93ab70158260e33f122a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd0bfdb7d94ad4b2c9f42a4a6817fcc9b2ac4540aef5e1eda17a47b6fc66abe0.webp","width":153,"height":256,"source":"static-d