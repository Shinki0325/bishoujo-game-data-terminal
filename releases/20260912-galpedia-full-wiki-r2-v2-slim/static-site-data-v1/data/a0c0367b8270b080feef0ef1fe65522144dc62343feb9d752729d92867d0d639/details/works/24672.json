e","relationId":"vndb:vn-staff:120361","source":"vndb"},{"creditedName":"安田 みずほ","creatorId":"vndb:s3219","sourcePersonId":"vndb:s3219","canonicalEntityId":"vndb:s3219","name":"安田 みずほ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:120363","source":"vndb"}]},"cast":[{"characterId":"char_c34107","characterName":"ななくら　ティナ","sourceIds":{"bangumi":[{"characterId":"96277","match":"exact-normalized-name-in-linked-work","subjectId":"136382"},{"characterId":"96277","match":"exact-normalized-name-in-linked-work","subjectId":"507761"}],"egsCharacterIds":["6275","26672"],"vndbCharacterId":"c34107"},"originalCharacterName":"ななくら　ティナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A princess who fled from Arkthrone Kingdom of Edda World to take refuge in human world. She is a neat and clean lovely girl whose appearance seems ephemeral like the brightest smile before fading away. Although she is a strong willed person, she is humble and can be an air-head sometimes. Her alias when she is at school is Nanakura Tina who was said to be a transfer student from abroad. She lives with Setsu and is a member of gymnastic club."},{"spoiler":false,"text":"「The soul that has been distorted by sorcery, I shall cleanse it and purify you!」"}],"source":"vndb","sourceCharacterId":"c34107"},{"segments":[{"spoiler":false,"text":"異世界であるエッダ界のアークスローネ王国の姫。"},{"spoiler":false,"text":"とある理由で亡命して来た。清楚で可憐、はかなげな見た目。"},{"spoiler":false,"text":"物事に奥手ではあるが、大切な所はゆずらない強さと気高さも持つ。"},{"spoiler":false,"text":"王国の力の源である光の剣“アールヴ”から供給される魔力を基にして呼び寄せられる“幻獣”の力を得て、セイクリッドクレールに変身する。"},{"spoiler":false,"text":"その力は強大だが、ティエルナ自身までうまくその力を制御できないでいる。"}],"source":"egs","sourceCharacterId":"6275","sourceWorkId":"21658","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界であるエッダ界に存在するアークスローネ王国の姫。"},{"spoiler":false,"text":"清楚で可憐、はかなげな見た目。"},{"spoiler":false,"text":"物事に奥手ではあるが芯が通っており、大切な所はゆずらない強さも持つ。"},{"spoiler":false,"text":"王国の力の源である光の剣アールヴによって呼び出される幻獣の力で変身する。"}],"source":"egs","sourceCharacterId":"26672","sourceWorkId":"36830","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界「エッダ界」のアークスローネ王国から亡命してきた姫。清楚で可憐、はかなげな見た目。"},{"spoiler":false,"text":"控えめな態度で少々天然の気はあるが芯が通っており、大切な所はゆずらない強さと気高さも持つ。"},{"spoiler":false,"text":"学園では七座　ティナ（ななくら　ティナ）と名乗り、海外からの留学生ということになっている。"},{"spoiler":false,"text":"現在は雪の家で共に生活している。学園では新体操部に所属。"},{"spoiler":false,"text":"「魔術にねじ曲げられし憐れな魂よ、私が浄化します！」"}],"source":"bangumi","sourceCharacterId":"96277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29be0d962fb436d35cad223f51b9b2cf08c2ed8269c2bc5a49bdaf9f8e031ca1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d4cc0200b7ffd81690c5deffb5d6b5af78cf84e34cf21a95936aeb1f7888752.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:136382:96277:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64202","source":"vndb"}]},{"characterId":"char_c34108","characterName":"セイクリッドノワール","sourceIds":{"bangumi":[{"characterId":"96278","match":"exact-normalized-name-in-linked-work","subjectId":"136382"},{"characterId":"96278","match":"exact-normalized-name-in-linked-work","subjectId":"507761"}],"egsCharacterIds":["6276"],"vndbCharacterId":"c34108"},"originalCharacterName":"セイクリッドノワール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who is often misunderstood because of her cool attitude and words, but she is actually a very passionate girl. To prepare for an unforeseen incident that may happen to the royal family, her ancestors has come to human world. When Tierna came to human world, she was deployed as the princess's bodyguard. However, her body is cursed, so her power and action are restricted."},{"spoiler":false,"text":"「There is no reason to give my name to the evildoers!」"}],"source":"vndb","sourceCharacterId":"c34108"},{"segments":[{"spoiler":false,"text":"クールな態度と言葉遣いで誤解されやすいが、心の内には熱い思いを秘めている少女。"},{"spoiler":false,"text":"王家不測の事態に備える為、遥か昔に人間界にやってきた一族を祖先に持つ。"},{"spoiler":false,"text":"一族が築いた財団からティエルナの護衛として派遣されている。"},{"spoiler":false,"text":"しかしその身にはさる者達によって呪いをかけられており、力や行動に枷を嵌められている。"}],"source":"egs","sourceCharacterId":"6276","sourceWorkId":"21658","spoiler":false},{"segments":[{"spoiler":false,"text":"クールな外見とは裏腹に、熱い情熱を秘めた少女。"},{"spoiler":false,"text":"はるか昔に、不測の事態に備えてエッダ界から派遣された者たちを祖に持つ。"},{"spoiler":false,"text":"一族が築き上げた財団から、ティエルナの護衛として派遣されていた。"},{"spoiler":false,"text":"幻獣ジェイドの力で変身する。"}],"source":"egs","sourceCharacterId":"6276","sourceWorkId":"36830","spoiler":false},{"segments":[{"spoiler":false,"text":"下級レベルの魔物であれば生身でも戦う事ができるほどの身体能力と剣の腕の持ち主。"},{"spoiler":false,"text":"学園内では女子から人気があるが、専ら本人には悩みの種である模様。"},{"spoiler":false,"text":"文芸部所属。"},{"spoiler":false,"text":"「悪に名乗る名などない」"}],"source":"bangumi","sourceCharacterId":"96278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8e8cf766947e0adfa83d5b741fb13c9932c7231bfdf2aad22260c6fe9d95467.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c5478b1140696e44d51f