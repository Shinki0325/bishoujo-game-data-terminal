:"vndb:s31207","canonicalEntityId":"vndb:s31207","name":"うきひと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:187005","source":"vndb"},{"creditedName":"カツヨシ","creatorId":"vndb:s31209","sourcePersonId":"vndb:s31209","canonicalEntityId":"vndb:s31209","name":"カツヨシ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:187006","source":"vndb"},{"creditedName":"せんや","creatorId":"vndb:s31211","sourcePersonId":"vndb:s31211","canonicalEntityId":"vndb:s31211","name":"せんや","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:187007","source":"vndb"},{"creditedName":"Masa","creatorId":"vndb:s31213","sourcePersonId":"vndb:s31213","canonicalEntityId":"vndb:s31213","name":"masa","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:187008","source":"vndb"},{"creditedName":"ウエダデザイン室","creatorId":"vndb:s36086","sourcePersonId":"vndb:s36086","canonicalEntityId":"vndb:s36086","name":"ウエダデザイン室","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:187010","source":"vndb"},{"creditedName":"Rebecca","creatorId":"vndb:s36087","sourcePersonId":"vndb:s36087","canonicalEntityId":"vndb:s36087","name":"Rebecca","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:187011","source":"vndb"},{"creditedName":"あかべぇそふとつぅ","creatorId":"vndb:s37751","sourcePersonId":"vndb:s37751","canonicalEntityId":"vndb:s37751","name":"あかべぇそふとつぅ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:187012","source":"vndb"}]},"cast":[{"characterId":"char_c113236","characterName":"ナイトチャージャー","sourceIds":{"bangumi":[{"characterId":"131513","match":"exact-normalized-name-in-linked-work","subjectId":"393816"}],"egsCharacterIds":["24296"],"vndbCharacterId":"c113236"},"originalCharacterName":"ナイトチャージャー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A lone wolf villain walking the line in the crime-ridden metropolis."},{"spoiler":false,"text":"She's made a name for herself, robbing banks, swiping art, and taking on mercenary gigs."},{"spoiler":false,"text":"She also targets criminal organizations like the mafia, hitting them where it hurts."},{"spoiler":false,"text":"Trust issues and a sharp tongue keep her at odds with other villains, and she'll turn on former allies in a heartbeat if it serves her interests."},{"spoiler":false,"text":"The twist? Her actions have inadvertently helped the underdogs, earning her a hidden fan base among some citizens."},{"spoiler":false,"text":"Superpower"},{"spoiler":false,"text":"Night Charger is a human battery with perks – using electricity to heal faster, sense more, and hit harder."},{"spoiler":false,"text":"Her tech suit lets her channel stored energy like a living lightning rod."},{"spoiler":false,"text":"The catch? She needs to stay charged to keep her superpower."},{"spoiler":false,"text":"A quick zap to the skin or a jolt to the innards, and she's back in the game."}],"source":"vndb","sourceCharacterId":"c113236"},{"segments":[{"spoiler":false,"text":"魔都にて単独で犯罪活動をしている一匹狼のヴィラン。"},{"spoiler":false,"text":"マフィアなど犯罪組織を標的にした銀行強盗や美術品などの強奪・傭兵活動を行っている。"},{"spoiler":false,"text":"誰も信じず、その行動と歯に衣着せぬ性格ゆえ、他のヴィランと対立する事も多く、自身の利益の為なら、かつて協力した勢力と敵対する事もいとわない。"},{"spoiler":false,"text":"一方で、結果的に彼女によって救われた弱者も多く、市民の一部で、強い人気を博している。"}],"source":"egs","sourceCharacterId":"24296","sourceWorkId":"32999","spoiler":false},{"segments":[{"spoiler":false,"text":"mask真名：Samantha Russo/mask"},{"spoiler":false,"text":"魔都にて単独で犯罪活動をしている一匹狼のヴィラン。"},{"spoiler":false,"text":"マフィアなど犯罪組織を標的にした銀行強盗や美術品などの強奪・傭兵活動を行っている。"},{"spoiler":false,"text":"誰も信じず、その行動と歯に衣着せぬ性格ゆえ、他のヴィランと対立する事も多く、"},{"spoiler":false,"text":"自身の利益の為なら、かつて協力した勢力と敵対する事もいとわない。"},{"spoiler":false,"text":"一方で、結果的に彼女によって救われた弱者も多く、市民の一部で、強い人気を博している。"},{"spoiler":false,"text":"『電気エネルギーによる超回復・超感覚・肉体強化』"},{"spoiler":false,"text":"更に、体内に蓄えたエネルギーを着用しているスーツで制御し放出する事が出来る。"},{"spoiler":false,"text":"ただし、電気や雷などからのエネルギー充電が必要で、バッテリーが切れるとスーパーパワーを失ってしまう。"},{"spoiler":false,"text":"エネルギーの充電は、素肌や内臓での接触で行う事が出来る。"}],"source":"bangumi","sourceCharacterId":"131513"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/080dd7aea08ba11c8c7c38020b44dc07da04e4edd7c202cc41328f0c9e5764d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68e14ac9c9921aacfcfe460f734d6166553fc558c4a4eccd3ba9fd8230c7ac6b.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:393816:131513:6380:1","source":"bangumi"}]},{"characterId":"char_c113237","characterName":"バッドローション","sourceIds":{"bangumi":[{"characterId":"131514","match":"exact-normalized-name-in-linked-work","subjectId":"393816"}],"egsCharacterIds":["24297"],"vndbCharacterId":"c113237"},"originalCharacterName":"バッドローション","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The boss of the \"Lotions,\" a gang ruling the magic city's slums."},{"spoiler":false,"text":"This former working girl played her cards right, climbing from rock bottom to the top of the heap."},{"spoiler":false,"text":"Starting as a brothel worker, she charmed her way up, eventually becoming the gang's leader."},{"spoiler":false,"text":"She thinks she's the hottest thing since sliced bread and loves being fawned over by her loyal minions. But she's got no love for men, looking down on them with disgust. Even her own crew isn't safe from her wrath when she's in a bad mood."},{"spoiler":false,"text":"Superpower"},{"spoiler":false,"text":"\"Living, breathing slime factory\""},{"spoiler":false,"text":"She oozes a special goo that she can shape and control, from watery to rubber-like."},{"spoiler":false,"text":"This slippery skill has more uses than you can shake a stick at - from bedroom shenanigans to taking down enemies."},{"spoiler":false,"text":"She's not a bottomless well, though - she needs to chow down regularly to keep her goo reserves topped up."}],"source":"vndb","sourceCharacterId":"c113237"},{"segments":[{"spoiler":false,"text":"魔都のスラム街を支配するギャング「ローションズ」のリーダー。"},{"spoiler":false,"text":"貧困層に生まれ、親に売られて娼婦となったが、自身の能力と魅力を駆使して自分を買った男達を手玉に取り、娼館を牛耳ったのち、ギャングのリーダーにまで上り詰めた。"},{"spoiler":false,"text":"自分がこの世で一番可愛いと思っており、奴隷として従える配下達にチヤホヤされるのが好きだが、大の男嫌いで見下しており、時には配下にさえも容赦なく暴力をふるう。"}],"source":"egs","sourceCharacterId":"24297","sourceWorkId":"32999","spoiler":false},{"segments":[{"spoiler":false,"text":"mask真名：Kitty Letelier/mask"},{"spoiler":false,"text":"魔都のスラム街を支配するギャング「ローションズ」のリーダー。"},{"spoiler":false,"text":"貧困層に生まれ、親に売られて娼婦となったが、自身の能力と魅力を駆使して自分を買った男達を手玉に取り、"},{"spoiler":false,"text":"娼館を牛耳ったのち、ギャングのリーダーにまで上り詰めた。"},{"spoiler":false,"text":"自分がこの世で一番可愛いと思っており、○○として従える配下達にチヤホヤされるのが好きだが、"},{"spoiler":false,"text":"大の男嫌いで見下しており、時には配下にさえも容赦なく○○をふるう。"},{"spoiler":false,"text":"『身体から粘液を分泌し、意のままに操作できる』"},{"spoiler":false,"text":"その粘液の硬度を操り、物体を作ることも可能で、粘液の硬度は液体からシリコン程度まで自由自在。"},{"spoiler":false,"text":"その能力は、ローションやオナホールなどの性戯、果ては戦闘や拘束など様々な用途で使う事が出来る。"},{"spoiler":false,"text":"分泌には限界があり、食物などから養分を摂取、ゲルエネルギーとして貯える事が出来る。"}],"source":"bangumi","sourceCharacterId":"131514"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84192b5b4f3bbf0cd15c05620f3b3351446bd38e9939d4eb058312510c4e1353.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cdfcb4d8ac415a2379e124fdaaf869fce27fc836023a85a606a0ad45f235105.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:393816:131514:8055:1","source":"bangumi"}]},{"characterId":"char_c113238","characterName":"マダムヴェノム","sourceIds":{"bangumi":[{"characterId":"131515","match":"exact-normalized-name-in-linked-work","subjectId":"393816"}],"egsCharacterIds":["24298"],"vndbCharacterId":"c113238"},"originalCharacterName":"マダムヴェノム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The undisputed leader of a crime empire in the magical metropolis, known by everyone from civilians to career criminals."},{"spoiler":false,"text":"This ambitious woman dethroned the \"Twin Tower Witch\" - formerly the most powerful figure in the city - and now aims to rule the roost herself."},{"spoiler":false,"text":"Even inmates in the \"Asylum\" rehabilitation center count themselves among her loyal followers."},{"spoiler":false,"text":"Superpower"},{"spoiler":false,"text":"Venom is a living, breathing poison factory with an arsenal of toxic tricks up her sleeve."},{"spoiler":false,"text":"Her repertoire includes lethal concoctions, mind-bending aphrodisiacs, and sensory enhancers - if you can imagine it, she can brew it."},{"spoiler":false,"text":"Her speciality is crafting the perfect blend to bend anyone to her will. A kiss, a touch, or even a whiff of her presence can put you under her spell."},{"spoiler":false,"text":"Venom can turn ordinary objects into deadly weapons with just a lick. And here's the kicker - we've yet to see the full extent of her capabilities."}],"source":"vndb","sourceCharacterId":"c113238"},{"segments":[{"spoiler":false,"text":"魔都で大きな勢力を持ち、市民からヴィランまで誰もが知っている巨大マフィアのボス。"},{"spoiler":false,"text":"魔都最大勢力である「ツインタワーの魔女」を倒し、新たな魔都の支配者として勢力拡大を目論む野心家。"},{"spoiler":false,"text":"更生施設「アサイラム」内にも彼女を支持する犯罪者達は多い。"},{"spoiler":false,"text":"自分がこの世で一番美しいと思っており、その美貌と凶悪な能力と尊大な態度で男達を従える。"},{"spoiler":false,"text":"勿論、そのテクニックは一級品である。"}],"source":"egs","sourceCharacterId":"24298","sourceWorkId":"32999","spoiler":false},{"segments":[{"spoiler":false,"text":"mask真名：Natasha Snyder/mask"},{"spoiler":false,"text":"魔都で大きな勢力を持ち、市民からヴィランまで誰もが知っている巨大マフィアのボス。"},{"spoiler":false,"text":"魔都最大勢力である「ツインタワーの魔女」を倒し、新たな魔都の支配者として勢力拡大を目論む野心家。"},{"spoiler":false,"text":"更生施設「アサイラム」内にも彼女を支持する犯罪者達は多い。"},{"spoiler":false,"text":"『様々な効果を持つ毒を体内で作り、分泌できる』"},{"spoiler":false,"text":"致死、精神性媚薬、感度向上、○○――"},{"spoiler":false,"text":"考え得る「従わせる」為の毒を精製、唾液や体液、吐息や汗の気化からも発現し、キスや性行為で注入する。"},{"spoiler":false,"text":"武器なども舐めれば毒武器になるなど、その能力は底知れず、少なくとも今まで限界に達した事は無い。"}],"source":"bangumi","sourceCharacterId":"131515"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bf5380c8190ff2c10a1d936fdbfe7ad4cefaf6243c0f087709208d78087abcc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a68bfdc7e0f118d4bf1a1e34cb279c8437e937bac0a7ed50604be57e1369a247.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:393816:131515:13773:1","source":"bangumi"}]},{"characterId":"char_c113239","characterName":"ジャストピア","sourceIds":{"bangumi":[{"characterId":"131516","match":"exact-normalized-name-in-linked-work","subjectId":"393816"}],"egsCharacterIds":["24299"],"vndbCharacterId":"c113239"},"originalCharacterName":"ジャストピア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A globally-renowned superhero who doubles as the mayor of Justopian City."},{"spoiler":false,"text":"This caped crusader has won hearts globally with his million-dollar smile, heart of gold, and burning passion for justice."},{"spoiler":false,"text":"Superpowers"},{"spoiler":false,"text":"\"Built like a tank, flies like a bird, and packs a sexual punch!\""},{"spoiler":false,"text":"His rock-hard body can take a licking and keep ticking, with the strength to turn boulders into pebbles."},{"spoiler":false,"text":"But here's the kicker – his super-sperm is the ultimate knockout punch. One shot and even the coldest fish will ride the waves of pleasure straight to cloud nine."},{"spoiler":false,"text":"His love juice is so potent, it'll make you see fireworks with just a drop. Unless you've got nerves of steel, you'll be over the moon in no time."}],"source":"vndb","sourceCharacterId":"c113239"},{"segments":[{"spoiler":false,"text":"世界的に有名なスーパーヒーローであり、 ジャストピアンシティの市長も務める。"},{"spoiler":false,"text":"笑顔を絶やさず温厚な性格と熱い正義感で世界中で人気を集めている。"},{"spoiler":false,"text":"誠実で心優しい博愛主義者ながらも、一方で、悪の道へと堕ちた異能犯罪者「ヴィラン」に対しては容赦が無く、その力と精力を持って、男女問わず愛を持って犯し倒す。"},{"spoiler":false,"text":"ヴィラン達からは「出会ったら終わり」と畏怖されている。"}],"source":"egs","sourceCharacterId":"24299","sourceWorkId":"32999","spoiler":false},{"segments":[{"spoiler":false,"text":"世界的に有名なスーパーヒーローであり、ジャストピアンシティの市長も務める。"},{"spoiler":false,"text":"笑顔を絶やさず温厚な性格と熱い正義感で世界中の人気を集めている。"},{"spoiler":false,"text":"『無敵の身体、飛行、最強の精力！』"},{"spoiler":false,"text":"鍛え抜かれた鋼の身体はどんな攻撃も通さず、岩をも砕くパワーを持つ。"},{"spoiler":false,"text":"中でも、彼の持つスーパー精子は射精されるとどんな不感な内臓器官でも必ず絶頂快楽と共に失神してしまう。"},{"spoiler":false,"text":"その精液は触れただけでも非常に強い快感をもたらし、余程強い精神力が無ければイッてしまうほど。"}],"source":"bangumi","sourceCharacterId":"131516"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c86659dd3a69dcf9dd1238e548cf3d94d6499577b3112c169e31c61a3c322cd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a633e6ef280f7ee8ca3539f763a0d5040fee222cd1b81b4101062ff51b354b0a.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いなりうづき","creatorId":"vndb:s21345","sourcePersonId":"vndb:s21345","canonicalEntityId":"vndb:s21345","name":"川上晃二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91966","source":"vndb"}]},{"characterId":"char_c118540","characterName":"ザ・ジャスティス","sourceIds":{"bangumi":[{"characterId":"131517","match":"exact-normalized-name-in-linked-work","subjectId":"393816"}],"egsCharacterIds":["24301"],"vndbCharacterId":"c118540"},"originalCharacterName":"ザ・ジャスティス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"n"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The AI system overseeing Justopian City."},{"spoiler":false,"text":"It manages all city facilities, including the Asylum, and guides citizens towards comfortable living and improved reproductive activities. This includes breeding programs using beneficial genes that produce heroes, or more precisely, selecting \"Best Partners.\""},{"spoiler":false,"text":"The AI set its sights on building a utopia, and the folks are all in."}],"source":"vndb","sourceCharacterId":"c118540"},{"segments":[{"spoiler":false,"text":"ジャストピアンシティを管理しているシティＡＩ。"},{"spoiler":false,"text":"アサイラムを含む、シティ内の全設備の管理のほか、市民を快適な生活、より良い生殖活動に導くべく、ヒーローを生み出す良性遺伝子を用いた繁殖、もとい「ベストパートナー」の選出を行ったりと、ユートピアを生み出す為の様々な管理を行っており、市民もそれを受け入れている。"}],"source":"egs","sourceCharacterId":"24301","sourceWorkId":"32999","spoiler":false},{"segments":[{"spoiler":false,"text":"ジャストピアンシティを管理しているシティAI。"},{"spoiler":false,"text":"アサイラムを含む、シティ内の全設備の管理のほか、"},{"spoiler":false,"text":"市民を快適な生活、より良い生殖活動に導くべく、"},{"spoiler":false,"text":"ヒーローを生み出す良性遺伝子を用いた繁殖、"},{"spoiler":false,"text":"もとい「ベストパートナー」の選出を行ったりと、"},{"spoiler":false,"text":"ユートピアを生み出す為の様々な管理を行っており、市民もそれを受け入れている。"}],"source":"bangumi","sourceCharacterId":"131517"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92720a5c7d332da1d36853d1c89f2b753d45e92cd532b93fd2f9e6e0f9f86e74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbf7e71ef9eb3da38cbfcecdc6c88ad4b3eee723801b74ad8c931d62a3e55885.webp","width":256,"height":245,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:393816:131517:6558:1","source":"bangumi"}]},{"characterId":"char_vndb_c113240","characterName":"JJ","sourceIds":{"vndbCharacterId":"c113240"},"originalCharacterName":"JJ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young director of the \"Asylum\" rehabilitation facility."},{"spoiler":false,"text":"Under the watchful eye of the city AI, \"The Justice,\" he takes on the tough job of reforming villains."},{"spoiler":false,"text":"His life was wrecked by a ruthless villain, leaving him with a deep-seated hatred for villains and a strong sense of justice. Living in a world of superpowers, he often feels frustrated and powerless due to his lack of heroic abilities. However, his sharp mind and exceptional fit with the facility's operations won him the director position."},{"spoiler":false,"text":"He profoundly respects Justopia, who recognises and nurtures his potential."}],"source":"vndb","sourceCharacterId":"c113240"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c124629","characterName":"マスクド・ニンフォ","sourceIds":{"vndbCharacterId":"c124629"},"originalCharacterName":"マスクド・ニンフォ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1ff9b513d0e95e49e223810e08fec180099cca792248d8d8d68b02d43ec892f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf12d31e5ac52845de8849a46ed0f41c4986c145ed2046d55a5454ab33062f8a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"姫川 あいり","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91964","source":"vndb"}]},{"characterId":"char_vndb_c124630","characterName":"クリームパイ","sourceIds":{"vndbCharacterId":"c124630"},"originalCharacterName":"クリームパイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a57336787b1c82010f17543356779dcaf6b4e1591cb5af7050e5f84c88d7605.web