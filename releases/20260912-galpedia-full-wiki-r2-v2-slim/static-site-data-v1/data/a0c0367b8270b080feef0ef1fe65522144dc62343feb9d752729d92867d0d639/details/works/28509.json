{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"28509","model":{"presentationWorkId":"vndb:v26417","staff":{"artwork":[{"creditedName":"吉飛雄馬","creatorId":"vndb:s2148","sourcePersonId":"egs:creator:14666","canonicalEntityId":"vndb:s2148","name":"吉飛雄馬","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:212184","source":"egs"}],"scenario":[{"creditedName":"HARE","creatorId":"vndb:s1473","sourcePersonId":"egs:creator:1666","canonicalEntityId":"vndb:s1473","name":"HARE","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:212185","source":"egs"},{"creditedName":"難波 一一","creatorId":"vndb:s12645","sourcePersonId":"vndb:s12645","canonicalEntityId":"vndb:s12645","name":"難波 一一","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:159604","source":"vndb"}],"music":[],"other":[{"creditedName":"ざくそん","creatorId":"vndb:s9317","sourcePersonId":"vndb:s9317","canonicalEntityId":"vndb:s9317","name":"ざくそん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:159603","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c90985","characterName":"鉢山 載正","sourceIds":{"vndbCharacterId":"c90985"},"originalCharacterName":"鉢山 載正","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fortune had never favored him as a child. He rose by scraping through the dirt, swallowing filth as he went. He trusts no one and is driven by an overpowering thirst for wealth and power. To acquire Rei's family enterprise - the Sakuragaoka Group - he used threats and money to bring the chairman of the academy under his control, becoming Special Advisor (acting chairman)."}],"source":"vndb","sourceCharacterId":"c90985"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c90986","characterName":"宇田川 京一","sourceIds":{"vndbCharacterId":"c90986"},"originalCharacterName":"宇田川 京一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eldest son of a founding family of an enterprise comparable in scale to the Sakuragaoka Group. Like Rei, he is without flaw in appearance, academics, and physical ability, and serves as president of the student council. He has known Rei since childhood, and they became engaged due to their wishes and the consent of both families."}],"source":"vndb","sourceCharacterId":"c90986"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c90987","characterName":"桜ヶ丘 怜泉","sourceIds":{"vndbCharacterId":"c90987"},"originalCharacterName":"桜ヶ丘 怜泉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only daughter of the president of the Sakuragaoka Group's core enterprise."},{"spoiler":false,"text":"Possesses striking beauty and exemplary academic performance. Serves as vice president of the student council. She holds a strong sense of justice and despises those who engage in underhanded deeds. Her personality leans sharp, which tends to divide those around her clearly into allies and adversaries. While she does not outwardly display it to any great degree, she is utterly smitten with her fiancé, Utagawa Keiichi."}],"source":"vndb","sourceCharacterId":"c90987"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"h