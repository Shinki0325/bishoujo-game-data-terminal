y","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"甚九郎のお気に入りの遊女。彼の手元に留め置かれる前は、魔界を渡り歩いていた。長い旅暮らしの影響か、自分の名前以外の記憶がほとんどない。戦いには参加しないが、ノリの良い気さくな性格で、挙兵後の甚九郎を明るくサポートする。"}],"source":"egs","sourceCharacterId":"6758","sourceWorkId":"21961","spoiler":false},{"segments":[{"spoiler":false,"text":"ノリの良い気さくな性格で、甚九郎お気に入りの遊女。"},{"spoiler":false,"text":"彼の手元に留め置かれる前は魔界を渡り歩いていた。"},{"spoiler":false,"text":"長い旅暮らしの影響か、自分の名前以外の記憶がほとんど無い。"},{"spoiler":false,"text":"戦いには参加しないが、挙兵後の甚九郎を明るくサポートする。"}],"source":"bangumi","sourceCharacterId":"44476"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0ee3972b44e688df748e63022ebfb8a6e1d170ed6eb80d058b8c233a8fbf9c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dad4c3e491558790895fd152236c4d6fa0cee08124aaf6c1398aef3a20d9a73d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山口瑞樹","creatorId":"vndb:s338","sourcePersonId":"vndb:s338","canonicalEntityId":"vndb:s338","name":"山口 瑞樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:137716:44476:16462:1","source":"bangumi"}]},{"characterId":"char_c33781","characterName":"天々","sourceIds":{"bangumi":[{"characterId":"44477","match":"exact-normalized-name-in-linked-work","subjectId":"137716"}],"egsCharacterIds":["6759"],"vndbCharacterId":"c33781"},"originalCharacterName":"天々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"自身を祀る神社を訪れる人間がいなくなり、困窮して天界から舞い降りた天女。その美貌とベタベタの関西弁を駆使して、甚九郎達に怪しげなグッズを売りさばく守銭奴。自身を祀る神社を通って自由に人間界へ行き来する事が出来、商品は主に日本橋で仕入れている。"}],"source":"egs","sourceCharacterId":"6759","sourceWorkId":"21961","spoiler":false},{"segments":[{"spoiler":false,"text":"自身を祀る神社を訪れる人間がいなくなり、困窮して天界から舞い降りた天女。"},{"spoiler":false,"text":"その美貌とベタベタの関西弁を駆使して、甚九郎たちに怪しげなグッズを売りさばく守銭奴。"},{"spoiler":false,"text":"自身を祀る神社から人間界へ行き来することができ、商品は主に日本橋で仕入れている。"}],"source":"bangumi","sourceCharacterId":"44477"}],"profileFacts":[{"label":"種族","source":"bangumi","sourceCharacterId":"44477","value":"天女"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34951c8c334d23e45cb29038de3518010e308375fe83e06726cee567ae6a58c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e00adea6a84fae70f32f6404e6e607eb12543e73d2e67eb4987491c61cb42be.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:137716:44477:22331:1","source":"bangumi"}]},{"characterId":"char_c33782","characterName":"末森 お通","sourceIds":{"bangumi":[{"characterId":"44478","match":"exact-normalized-name-in-linked-work","subjectId":"137716"}],"egsCharacterIds":["6760"],"vndbCharacterId":"c33782"},"originalCharacterName":"末森 お通","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"甚九郎の元許嫁。甚九郎の廃嫡後は、弟・勘十郎と婚約する。婚約解消の経緯から、甚九郎に対してわだかまりを抱えており、煩悩寺の変後、甚九郎の誘いを断って独自に挙兵。結果的に甚九郎の挙兵を妨げる形となり、それを恨んだ甚九郎に最初の標的にされる。"},{"spoiler":false,"text":"お嬢様育ちの為、勝ち気で口うるさく、焼きもち焼き。ＮＧワードは「貧乳」。"}],"source":"egs","sourceCharacterId":"6760","sourceWorkId":"21961","spoiler":false},{"segments":[{"spoiler":false,"text":"甚九郎の元許嫁。 甚九郎の廃嫡後は、弟・勘十郎と婚約する。"},{"spoiler":false,"text":"婚約解消の経緯から甚九郎に対してわだかまりを抱えており、煩悩寺の変後、甚九郎の誘いを断って独自に挙兵。"},{"spoiler":false,"text":"結果的に甚九郎の挙兵を妨げる形となり、