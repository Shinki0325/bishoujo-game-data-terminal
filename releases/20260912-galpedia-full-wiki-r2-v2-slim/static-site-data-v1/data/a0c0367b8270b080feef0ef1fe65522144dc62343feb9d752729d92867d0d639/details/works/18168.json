nicalEntityId":"vndb:s4008","name":"柳麻美(MAMI)","detail":"ED曲 「星の下、羽根をとじて」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:126271","source":"egs"},{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:96539","source":"vndb"},{"creditedName":"柳 麻美","creatorId":"vndb:s4008","sourcePersonId":"vndb:s4008","canonicalEntityId":"vndb:s4008","name":"柳 麻美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:96540","source":"vndb"}]},"cast":[{"characterId":"char_c25073","characterName":"一羽 ニア","sourceIds":{"bangumi":[{"characterId":"70018","match":"exact-normalized-name-in-linked-work","subjectId":"62537"}],"egsCharacterIds":["773"],"vndbCharacterId":"c25073"},"originalCharacterName":"一羽 ニア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"路地裏でバッタリ出会った不思議な雰囲気の女の子。"},{"spoiler":false,"text":"明るく健気で、何事にもポジティブシンキング。"},{"spoiler":false,"text":"その上まったくの世間知らずで主人公・彰人を戸惑わせてばかり。"},{"spoiler":false,"text":"素直で懐っこい性格は、まるで小動物のよう。"},{"spoiler":false,"text":"誰かに追われているらしく、ただいま絶賛逃亡中。"},{"spoiler":false,"text":"「アキト君は、普通に困っている人を助けてしまう、ステキな人です！」"}],"source":"egs","sourceCharacterId":"773","sourceWorkId":"18168","spoiler":false},{"segments":[{"spoiler":false,"text":"在后巷突然遇见的给人不可思议气氛的女孩子。"},{"spoiler":false,"text":"开朗坚强，面对任何事情都是乐观派。"},{"spoiler":false,"text":"而且完全不懂世事，尽是让主人公・彰人为难。"},{"spoiler":false,"text":"率直爱亲近人，就像是小动物一样。"},{"spoiler":false,"text":"似乎是被某人追赶着，现正绝赞逃亡中。"},{"spoiler":false,"text":"「アキト君是会很自然地去帮助困难中的人，很棒的人！」 1"}],"source":"bangumi","sourceCharacterId":"70018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7a1a46973ffd506ccefc2bb116a02b89966c4363956a4627db5e804bfd75bb5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f62fe4ed297daf236a5493fd235afcd2f729c7f49099ba8a086242bb9af0d6f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤田しずく","creatorId":"vndb:s937","sourcePersonId":"vndb:s937","canonicalEntityId":"vndb:s937","name":"藤田 しずく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:62537:70018:16178:1","source":"bangumi"}]},{"characterId":"char_c25076","characterName":"ノルム・ロスリスバーグ","sourceIds":{"bangumi":[{"characterId":"70020","match":"exact-normalized-name-in-linked-work","subjectId":"62537"}],"egsCharacterIds":["775"],"vndbCharacterId":"c25076"},"originalCharacterName":"ノルム・ロスリスバーグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"突然現れた謎の外国人。あからさまに怪しい。"},{"spoiler":false,"text":"カタコトの日本語で主人公・彰人に突然言い寄ってきて「ダーリン」などと一方的に呼ぶが、その意図はまったくの不明。"},{"spoiler":false,"text":"おっぱいを押し付けられても、やっぱり怪しいものは怪しい。"},{"spoiler":false,"text":"なぜか身の危険を感じるのは、気のせいだろうか……？"},{"spoiler":false,"text":"「ダーリン……フタリキリ、ナリタイ、デス」"}],"source":"egs","sourceCharacterId":"775","sourceWorkId":"18168","spoiler":false},{"segments":[{"spoiler":false,"text":"突然出现的谜之外国人。可疑得太明显了。"},{"spoiler":false,"text":"用生硬的日语突然向彰人打招呼，还单方面地叫他“达令”，其意图是完全不明。"},{"spoiler":false,"text":"尽管是用胸部压过来，但可疑就是可疑。"},{"spoiler":false,"text":"不知为什么让他感到自身有危险，是错觉吗……"},{"spoiler":false,"text":"「达令……想要、两人、独处」"}],"source":"bangumi","sourceCharacterId":"70020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f52b6053bbe2330c017a1e6ab4bf6cd53e281754e6bc7dc8023ff58b832e32d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/827063dd8324ad1d3a1541d783b215a79eb1b0c1dbf4ebb82ba9b2fe61e5b6c7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:62537:70020:8055:1","source":"bangumi"}]},{"characterId":"char_c25077","characterName":"天井 心音","sourceIds":{"bangumi":[{"characterId":"70021","match":"exact-normalized-name-in-linked-work","subjectId":"62537"}],"egsCharacterIds":["777"],"vndbCharacterId":"c25077"},"originalCharacterName":"天井 心音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ぶらり気ままな一人旅を続けている変わり者のお嬢様。"},{"spoiler":false,"text":"道に迷っているところを助ける形でふたりは出会う。"},{"spoiler":false,"text":"多感でおしゃべりが大好きな彼女は、独自の哲学を繰り広げながら主人公・彰人に色々な疑問や提案を投げかける。"},{"spoiler":false,"text":"そんな彼女は、何を求めて旅をしているのだろう？"},{"spoiler":false,"text":"「わたし、俄然あなたのことに興味を持ちました！　はいっ」"}],"source":"egs","sourceCharacterId":"777","sourceWorkId":"18168","spoiler":false},{"segments":[{"spoiler":false,"text":"持续进行漫无目的想去哪就去哪的独自旅行的怪人大小姐。"},{"spoiler":false,"text":"在她迷路的时候出手帮助而相遇。"},{"spoiler":false,"text":"多感爱说话的她是展现出独自的哲学并向彰人提出各种各样的疑问和提案。"},{"spoiler":false,"text":"这样的她到底是追求着什么而独自旅行着的呢？"},{"spoiler":false,"text":"「我是突然对你的事感兴趣起来了！ 就这样」"}],"source":"bangumi","sourceCharacterId":"70021"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c2e89b8b186c9326c0ea4dcfff290f941e276caa4e7aa8aa8eacc5b99f7ceec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98b3d8cc64f643cd16f562792f76f141e7d8b7a813616c745680b01c3b7d649a.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"武石あゆ実","creatorId":"vndb:s1745","sourcePersonId":"vndb:s1745","canonicalEntityId":"vndb:s1745","name":"武石 あゆ実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:62537:70021:16168:1","source":"bangumi"}]},{"characterId":"char_c25079","characterName":"みりちー","sourceIds":{"bangumi":[{"characterId":"70022","match":"exact-normalized-name-in-linked-work","subjectId":"62537"}],"egsCharacterIds":["776"],"vndbCharacterId":"c25079"},"originalCharacterName":"みりちー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公・彰人の実の妹。両親と共に自宅で暮らしている。"},{"spoiler":false,"text":"放任主義な母親に代わり、兄である彰人に対して何かと手厳しい態度を取るが、同時に言葉遣いはとても丁寧であり、決して兄を嫌っているわけでもない様子。"},{"spoiler":false,"text":"どうやら兄を想うその気持ちは、心中複雑そう。"},{"spoiler":false,"text":"「それとも兄さんは、あたしと歩くのがそんなに嫌なんですか？」"}],"source":"egs","sourceCharacterId":"776","sourceWorkId":"18168","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・彰人的亲妹妹。和双亲一起在自家生活着。"},{"spoiler":false,"text":"代替放任主义的母亲，对哥哥彰人的态度总是很严厉，但同时对他的语气措辞却十分尊敬礼貌，看样子绝不是讨厌哥哥似的。"},{"spoiler":false,"text":"看来这份为哥哥着想的心意是挺复杂的。"},{"spoiler":false,"text":"「还是说哥哥你就那么讨厌和我一起走吗？」"}],"source":"bangumi","sourceCharacterId":"70022"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f70b92f0cd2014e43c3cf92ff276ffb662b1999227b3751e83063d72108c770b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/106dbf2d1f88f51664a5bf731123601d7c1c0e37c86c4fc53bba2913c32aa213.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤崎紗矢香","creatorId":"vndb:s6