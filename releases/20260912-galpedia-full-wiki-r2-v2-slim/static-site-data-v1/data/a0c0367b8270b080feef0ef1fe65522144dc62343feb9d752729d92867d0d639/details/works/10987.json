ments":[{"spoiler":false,"text":"アルバードの研究によって作り出されたレプリカント。美しき反逆の女戦士。"},{"spoiler":false,"text":"人間を滅ぼそうとしているアルバートに疑問を抱き研究所を脱走。現在は、人間側のレジスタンスに属している。"},{"spoiler":false,"text":"諸悪の根源であるアルバートを殺す事が、全てを解決する方法であると知りながらも、親ともいえる存在のアルバートを殺す事には躊躇いを覚えている。"},{"spoiler":false,"text":"そんな彼女の元に、人類が長年追い続けていた夢の結晶『タイムマシン』の開発にアルバートが成功したとの情報が舞い込む。これをキッカケにベレッタは行動を開始、タイムマシンをアルバートから強奪し、過去に戻ってアルバートの研究成果を全て破壊する事を計画する。"}],"source":"bangumi","sourceCharacterId":"94294"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c88857fac573ccd2c85e0dd77a9c0fafa47810d155fc77c827b6fbe990ac6791.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67be6779fed420ff99d2936de334457c9806fd3f4fbbe46878aefbe2b29eaf3c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨津 さえ","creatorId":"vndb:s1653","sourcePersonId":"vndb:s1653","canonicalEntityId":"vndb:s1653","name":"雨津 さえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13216","source":"vndb"}]},{"characterId":"char_c29604","characterName":"ルージュ","sourceIds":{"bangumi":[{"characterId":"94295","match":"exact-normalized-name-in-linked-work","subjectId":"266086"}],"egsCharacterIds":["17957"],"vndbCharacterId":"c29604"},"originalCharacterName":"ルージュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アルバートを「お父様」と呼ぶ美少女戦士。"},{"spoiler":false,"text":"アルバートに褒められる事を至上の悦びとし、そのためならば、どんな残虐行為でも躊躇いなく行う。"},{"spoiler":false,"text":"「お父様」が興味を抱くベレッタに、激しい嫉妬を抱き、生け捕りを命じられながら、隙あらば抹殺しようとする。"}],"source":"egs","sourceCharacterId":"17957","sourceWorkId":"10987","spoiler":false},{"segments":[{"spoiler":false,"text":"ベレッタ脱走後にアルバートによって作られたレプリカント。"},{"spoiler":false,"text":"アルバートの事を『お父様』と呼び、アルバートの喜ぶ事であればどんな残虐な行為でも躊躇いなく行う美少女戦士。"},{"spoiler":false,"text":"アルバートに褒められる事に至上の悦びを感じている。極度のファザコン。ゆえに、アルバートがベレッタに対して興味を持つ事に激しい嫉妬を抱いている。"},{"spoiler":false,"text":"アルバートの気持ちを自分に向けさせる為、今回侵入してきたベレッタを隙あらば抹殺してしまおうと思っていたが、アルバートからは生け捕りにするよう命じられている。"}],"source":"bangumi","sourceCharacterId":"94295"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb08130ffd387e5c47171a463be997462b90007de67ee1e062e0c2ca7e209c95.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76ebcfb4829b465801cdfab3f49fe9890ecf2172be0871bcccdc0d4c1b825d92.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266086:94295:19213:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1413","sourceCompanyId":"egs:brand:1023","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10987:1023","source":"egs"},{"companyId":"vndb:p1413","sourceCompanyId":"vndb:p1413","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3535:v1504","source":"vndb"},{"companyId":"vndb:p1413","sourceCompanyId":"vndb:p1413","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3536:v1504","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
