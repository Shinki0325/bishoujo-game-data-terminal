criptions":[{"segments":[{"spoiler":false,"text":"頭の固い姉を持つ、一年歳下の“姫路麻衣”です。"},{"spoiler":false,"text":"常に優秀な姉と比較されて困っています。"},{"spoiler":false,"text":"別に気にしてませんけどね。"},{"spoiler":false,"text":"だって、私は私ですもん。"},{"spoiler":false,"text":"そんな私はアニメが大好きです。"},{"spoiler":false,"text":"コスプレはまだー……体験したことありません。"},{"spoiler":false,"text":"あれって勇気が必要ですよ。"},{"spoiler":false,"text":"あ？　水泳の話でしたね、ゴメンナサイ。"},{"spoiler":false,"text":"水泳自体は好きですが、姉のようには泳げません。"},{"spoiler":false,"text":"ノビノビと平泳ぎするのは気持ちいいですよね～。"},{"spoiler":false,"text":"水泳といえば最近……気になる先輩がいます。"},{"spoiler":false,"text":"幸次先輩、……って言う名前だったかなぁ？"},{"spoiler":false,"text":"先日、私が大変な目にあったところを必死に守ってくださった先輩♪"},{"spoiler":false,"text":"あの人って、水泳部の人？"}],"source":"egs","sourceCharacterId":"5124","sourceWorkId":"17584","spoiler":false},{"segments":[{"spoiler":false,"text":"頭の固い姉を持つ、一年歳下の“姫路麻衣”です。"},{"spoiler":false,"text":"常に優秀な姉と比較されて困っています。別に気にしてませんけどね。"},{"spoiler":false,"text":"だって、私は私ですもん。そんな私はアニメが大好きです。"},{"spoiler":false,"text":"コスプレはまだー……体験したことありません。あれって"},{"spoiler":false,"text":"勇気が必要ですよ。あ？　水泳の話でしたね、ゴメンナサイ。"},{"spoiler":false,"text":"水泳自体は好きですが、姉のようには泳げません。"},{"spoiler":false,"text":"ノビノビと平泳ぎするのは気持ちいいですよね～。"},{"spoiler":false,"text":"水泳といえば最近……気になる先輩がいます。"},{"spoiler":false,"text":"幸次先輩、……って言う名前だったかなぁ？"},{"spoiler":false,"text":"先日、私が大変な目にあったところを必死に守ってくださった先輩♪"},{"spoiler":false,"text":"あの人って、水泳部の人？"}],"source":"bangumi","sourceCharacterId":"157425"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c062103e3745c993cd187f8a3fcdaf8f111479e27f6c4c01eaf9bbfb4c4164e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbea70f3c92bc0f725b964c8c7fed4b5462e2e48facab2138b73e4046a4cd259.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声