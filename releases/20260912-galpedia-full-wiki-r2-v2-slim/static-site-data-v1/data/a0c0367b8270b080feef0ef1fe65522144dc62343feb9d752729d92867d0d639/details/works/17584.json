racters/v1/images/3d/3da8c7ad8468cc9373df2e531578bf18ff11b428e8fa11273d72f6fe17937877.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c113740","characterName":"白乃 幸次","sourceIds":{"bangumi":[{"characterId":"157428","match":"exact-normalized-name-in-linked-work","subjectId":"224236"}],"egsCharacterIds":["5127"],"vndbCharacterId":"c113740"},"originalCharacterName":"白乃 幸次","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"――･･･最初は誰が見ても頼りなさげな本編の主人公。"},{"spoiler":false,"text":"面倒なことを嫌い、何ごともテキトー。"},{"spoiler":false,"text":"さらには明や実花の命令でしか動けず、意気地なし。"},{"spoiler":false,"text":"だが、しかし･･････。"},{"spoiler":false,"text":"水泳部員の成長とともに、幸次も蘭香学園水泳部のコーチとして『頼れる男』へ成長していく。"}],"source":"egs","sourceCharacterId":"5127","sourceWorkId":"17584","spoiler":false},{"segments":[{"spoiler":false,"text":"最初は誰が見ても頼りなさげな本編の主人公。"},{"spoiler":false,"text":"面倒なことを嫌い、何ごともテキトー。 さらには明や実花の命令でしか動けない意気地なし。"},{"spoiler":false,"text":"だが、しかし……"},{"spoiler":false,"text":"水泳部員の成長と共に、幸次も蘭香学園水泳部のコーチとして “頼れる男” に成長していく。"}],"source":"bangumi","sourceCharacterId":"157428"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c25861","characterName":"松島 亜美","sourceIds":{"bangumi":[{"characterId":"157421","match":"exact-normalized-name-in-linked-work","subjectId":"224236"}],"egsCharacterIds":["5120"],"vndbCharacterId":"c25861"},"originalCharacterName":"松島 亜美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっとりした口調が特徴の少々天然？　な女の子。"},{"spoiler":false,"text":"面倒くさいことは苦手で、キャンプでの炊事もそれとなく交わす。"},{"spoiler":false,"text":"自分が巨乳なことを自覚していて、男子に対してのアピールポイントなのも知っている案外計算高いのかも？"},{"spoiler":false,"text":"セックスは好きで比較的知識も豊富。"}],"source":"egs","sourceCharacterId":"5120","sourceWorkId":"15012","spoiler":false},{"segments":[{"spoiler":false,"text":"え～と…。両親の都合で蘭香学園に転入した、“松島亜美”と申します。"},{"spoiler":false,"text":"私は自分でも、オットリした女のコだと思います。"},{"spoiler":false,"text":"とくに面倒ごとは、大の苦手で～す。"},{"spoiler":false,"text":"え？　……私、オッパイが大きいですかぁ？"},{"spoiler":false,"text":"実はですねぇ～。"},{"spoiler":false,"text":"自分のオッパイが男子へのアピールポイントってことも…知っていま～す。"},{"spoiler":false,"text":"私、ちょっと計算高いかも、ですよｗ"},{"spoiler":false,"text":"実花とは幼馴染なんです。また再会できました。"},{"spoiler":false,"text":"でも最近の実花は『水泳部に入ってくれ』って、しつこくて…正直、困っています。"},{"spoiler":false,"text":"はい？"},{"spoiler":false,"text":"私、いちおう泳げますよぉ？　クロールが得意かもで～すっ♪"}],"source":"egs","sourceCharacterId":"5120","sourceWorkId":"17584","spoiler":false},{"segments":[{"spoiler":false,"text":"え～と…。両親の都合で蘭香学園に転入した、“松島亜美”と申します。"},{"spoiler":false,"text":"私は自分でも、オットリした女のコだと思います。"},{"spoiler":false,"text":"とくに面倒ごとは、大の苦手で～す。"},{"spoiler":false,"text":"え？　……私、オッパイが大きいですかぁ？"},{"spoiler":false,"text":"実はですねぇ～。"},{"spoiler":false,"text":"自分のオッパイが男子へのアピールポイントってことも…知っていま～す。"},{"spoiler":false,"text":"私、ちょっと計算高いかも、ですよｗ"},{"spoiler":false,"text":"実花とは幼馴染なんです。また再会できました。"},{"spoiler":false,"text":"でも最近の実花は『水泳部に入ってくれ』って、"},{"spoiler":false,"text":"しつこくて…正直、困っています。"},{"spoiler":false,"text":"はい？"},{"spoiler":false,"text":"私、いちおう泳げますよぉ？　クロールが得意かもで～すっ♪"}],"source":"bangumi","sourceCharacterId":"157421"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18c13f0257a5cbc2c9e533544b3550f3c3a85934b0c4d3938bd4635ce9504ada.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2e258e5f5f2d5974d1e63dd41cabf33498ac46ebfe8cd0cdd7e70e56f83e59e.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渡会ななせ","creatorId":"vndb:s988","sourcePersonId":"vndb:s988","canonicalEntityId":"vndb:s988","name":"渡会 ななせ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224236:157421:36059:1","source":"bangumi"}]},{"characterId":"char_c25862","characterName":"秋篠 実花","sourceIds":{"bangumi":[{"characterId":"157422","match":"exact-normalized-name-in-linked-work","subjectId":"224236"}],"egsCharacterIds":["5121"],"vndbCharacterId":"c25862"},"originalCharacterName":"秋篠 実花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私は蘭香学園水泳部の部長で、“秋篠実花”っていいます!"},{"spoiler":false,"text":"転入してきた亜美を、なんとしてでも水泳部に入部させたいんです!"},{"spoiler":false,"text":"とにかく！　アタマ数を揃えないと廃部しちゃうんですよ～～っ!"},{"spoiler":false,"text":"あ?　ビックリさせてすいません…。"},{"spoiler":false,"text":"まぁ、自分で言うのもなんですがぁ～。"},{"spoiler":false,"text":"私って責任感が強くて、明るい性格なんですよ。"},{"spoiler":false,"text":"誰とでも仲良く出来るタイプだと思っています。"},{"spoiler":false,"text":"ただ…。あとで自分の犯した行動を思い悩み、後悔することも…はい。"},{"spoiler":false,"text":"あれ？　いっつも反省しているような気が…??"},{"spoiler":false,"text":"あ、はいっ!　皆さんも入部して、私と一緒に泳ぎませんかっ!?"},{"spoiler":false,"text":"全国大会優勝を目指しましょう!"},{"spoiler":false,"text":"私が得意な泳ぎはバタフライですっ!"}],"source":"egs","sourceCharacterId":"5121","sourceWorkId":"17584","spoiler":false},{"segments":[{"spoiler":false,"text":"私は蘭香学園水泳部の部長で、“秋篠実花”っていいます!"},{"spoiler":false,"text":"転入してきた亜美を、なんとしてでも水泳部に入部させたいんです!"},{"spoiler":false,"text":"とにかく！　アタマ数を揃えないと廃部しちゃうんですよ～～っ!"},{"spoiler":false,"text":"あ?　ビックリさせてすいません…。"},{"spoiler":false,"text":"まぁ、自分で言うのもなんですがぁ～。"},{"spoiler":false,"text":"私って責任感が強くて、明るい性格なんですよ。"},{"spoiler":false,"text":"誰とでも仲良く出来るタイプだと思っています。"},{"spoiler":false,"text":"ただ…。あとで自分の犯した行動を思い悩み、後悔することも…はい。"},{"spoiler":false,"text":"あれ？　いっつも反省しているような気が…??"},{"spoiler":false,"text":"あ、はいっ!　皆さんも入部して、私と一緒に泳ぎませんかっ!?"},{"spoiler":false,"text":"全国大会優勝を目指しましょう!"},{"spoiler":false,"text":"私が得意な泳ぎはバタフライですっ!"}],"source":"bangumi","sourceCharacterId":"157422"}],"