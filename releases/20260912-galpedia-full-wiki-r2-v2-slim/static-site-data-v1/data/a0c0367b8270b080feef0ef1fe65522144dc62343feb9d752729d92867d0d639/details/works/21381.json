れを食い止める為、そして、伝統ある店を守る為、ひいては両親を助ける為、雅と二人でお店の宣伝活動を始める。"}],"source":"egs","sourceCharacterId":"5633","sourceWorkId":"21381","spoiler":false},{"segments":[{"spoiler":false,"text":"大正時代から続く老舗和菓子屋の娘。 まだ学生ではあるが店番を務める、将来の若女将。"},{"spoiler":false,"text":"おしとやかで和服の似合う、いわゆる日本風美少女。"},{"spoiler":false,"text":"お人形のような見た目と健気でひたむきな性格に、周囲はある種のカリスマ性を感じている。"},{"spoiler":false,"text":"和菓子に詳しい人なら誰でも知っている有名店だが、敷居の高さ故か客は減少していく一方。"},{"spoiler":false,"text":"伝統ある店を守るため、そして両親を助けるため、雅と二人でお店の宣伝活動を始めていく。"},{"spoiler":false,"text":"「和菓子って可愛いですよね、丸くて、紅くて。 見ているだけでほわ～ってします」"}],"source":"bangumi","sourceCharacterId":"31092"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"5633","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"5633","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"5633","sourceWorkId":"21381","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4ff1bb8cbcc3ec1bbb412236f6a2b218a0cf5ccd35a7131bdbc14502e53d267b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2bfa928d0fd3605f0e7f9eb8644b4730d062315700abad4df97f2f151f95104.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122763:31092:5906:1","source":"bangumi"}]},{"characterId":"char_c27516","characterName":"桜庭 佳織","sourceIds":{"bangumi":[{"characterId":"31093","match":"exact-normalized-name-in-linked-work","subjectId":"122763"}],"egsCharacterIds":["5634"],"vndbCharacterId":"c27516"},"or