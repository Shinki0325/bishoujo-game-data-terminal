jo.date/terminal-wiki/v1/characters/v1/images/f2/f21f8991c6398b5c6845909df52a7991d9de896d3f0165f44a38e542b2114568.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf8b2fbdba27eca31b83a2620bf66806672216f0508b1ef9e91fd56c1e4ee330.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122763:31097:19213:1","source":"bangumi"}]},{"characterId":"char_c27521","characterName":"舞原 弥生","sourceIds":{"bangumi":[{"characterId":"31098","match":"exact-normalized-name-in-linked-work","subjectId":"122763"}],"egsCharacterIds":["5651"],"vndbCharacterId":"c27521"},"originalCharacterName":"舞原 弥生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商店街の少し外れにある旅館の女将。"},{"spoiler":false,"text":"おっとりしている割には、意外と積極的で行動的。両親が遺した旅館を、妹の奏と二人きりで切り盛りしている。"},{"spoiler":false,"text":"だが、最近進出してきた大手ビジネスホテルによって、客が激減してしまい家賃の滞納を起こしてしまう。"},{"spoiler":false,"text":"じつは雅の学生時代の同級生。"},{"spoiler":false,"text":"当時から、主人公に対して思いを寄せていた。"},{"spoiler":false,"text":"普段はおっとりしているが、本気で怒らせると怖いタイプ。"}],"source":"egs","sourceCharacterId":"5651","sourceWorkId":"21381","spoiler":false},{"segments":[{"spoiler":false,"text":"商店街の少し外れにある旅館の女将。"},{"spoiler":false,"text":"おっとりしているが、意外と積極的で行動的な一面もある。"},{"spoiler":false,"text":"そして本気で怒らせると怖いタイプ。"},{"spoiler":false,"text":"両親が遺した旅館を、妹の奏と二人きりで切り盛りしている。"},{"spoiler":false,"text":"だが、最近進出してきた大手ビジネスホテルによって客が激減してしまい、ついに家賃の滞納を起こしてしまう。"},{"spoiler":false,"text":"実は雅の学生時代の同級生で、当時から雅に対して想いを寄せていた。"},{"spoiler":false,"text":"「今でもあなたの事、好きでいてもいいよね？」"}],"source":"bangumi","sourceCharacterId":"31098"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"5651","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"5651","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"5651","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"5651","sourceWorkId":"21381","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79b08097f55c5b4f87b2a388afcf2baa706ce055858164a25cb8cae3a01325c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b97ff18495a79a596b3ab44a68e94c9e70b93bc249ad56cba2674c69eaeff73.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122763:31098:12718:1","source":"bangumi"}]},{"characterId":"char_c27522","characterName":"舞原 奏","sourceIds":{"bangumi":[{"characterId":"31099","match":"exact-normalized-name-in-linked-work","subjectId":"122763"}],"egsCharacterIds":["5652"],"vndbCharacterId":"c27522"},"originalCharacterName":"舞原 奏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商店街の少しはずれにある旅館の娘。"},{"spoiler":false,"text":"お姉ちゃん大好きでややシスコン気味"},{"spoiler":false,"text":"行動力があり、勢いで動く傾向が強い。"},{"spoiler":false,"text":"だが、最近進出してきた大手ビジネスホテルによって、客が激減してしまう。"},{"spoiler":false,"text":"その結果収入の目処が立たず、管理費用が捻出できなくなってしまう。"},{"spoiler":false,"text":"自分に何かできないかと常に考えているが、いいアイデアが出ない。"},{"spoiler":false,"text":"初対面の男性には素直になれない性格で、主人公に対しては少しキツい接し方をするが、顔を合わせていくうちに、打ち解けられる。"},{"spoiler":false,"text":"しずくとは友達で同じ学園に通っている。"}],"source":"egs","sourceCharacterId":"5652","sourceWorkId":"21381","spoiler":false},{"segments":[{"spoiler":false,"text":"姉の弥生と、両親が遺した旅館を切り盛りしている女子学生。"},{"spoiler":false,"text":"お姉ちゃん大好きでややシスコン気味。 行動力があり勢いで動く傾向が強い。"},{"spoiler":false,"text":"初対面の男性には素直になれない性格で、最初は雅に対しても少しキツく接してくる。"},{"spoiler":false,"text":"姉とは違って色々と ちっちゃい ことを気にしている。"},{"spoiler":false,"text":"旅館のために何かできないかと常に考えているが、なかなか良いアイデアが出ない。"},{"spoiler":false,"text":"木野しずくとは友達で、同じ学園に通っている。"},{"spoiler":false,"text":"「おっ……お姉ちゃんにしたこと、わたしにもしてみなさいよッ！」"}],"source":"bangumi","sourceCharacterId":"31099"}],"profileFacts":[{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"5652","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"5652","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"5652","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"5652","sourceWorkId":"21381","sourceField":null,"scoped":true}],"metadataCandidateCon