理が得意。 でも慌てると少しドジになる。"},{"spoiler":false,"text":"お願いされると断れず、よく貧乏くじを引くことになる。"},{"spoiler":false,"text":"人の役立ちたいという気持ちが強く、ボランティア活動に積極的に参加している。"},{"spoiler":false,"text":"趣味はテニスで、近所のサークルでは無償でコーチもしている。"},{"spoiler":false,"text":"自己管理ができないタイプではなく、対価を正当に請求できないタイプの貧乏さん。"},{"spoiler":false,"text":"見かねた雅に、アシスタントして雇われることになる。"},{"spoiler":false,"text":"「わたし、困っている人がいるとほっとけないんです」"}],"source":"bangumi","sourceCharacterId":"31090"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"5631","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"5631","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"5631","sourceWorkId":"21381","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"5631","sourceWorkId":"21381","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/251156d7893fdf3783df95815c952ccef2d7b90594c8c25bc270fb988e664749.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1e859e37bbe0a61d2015e61a29e593c2d68b88c09e5396e30a547629a6ba65e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122763:31090:10662:1","source":"bangumi"}]},{"characterId":"char_c27514","characterName":"双葉 伊織","sourceIds":{"bangumi":[{"characterId":"31091","match":"exact-normalized-name-in-linked-work","subjectId":"122763"}],"egsCharacterIds":["5632"],"vndbCharacterId":"c27514"},"originalCharacterName":"双葉 伊織