:"char_vndb_c50716","characterName":"花蒔 イチコ","sourceIds":{"vndbCharacterId":"c50716"},"originalCharacterName":"花蒔 イチコ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An average girl who attends college in the city."},{"spoiler":false,"text":"She’s searching for her older brother, who went missing a year ago. Her childhood friend, Hino, invited her to go with him to Okunezato, where her brother was last seen."}],"source":"vndb","sourceCharacterId":"c50716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2869be9bd8ed3ffe243955d1b89f8ec9d26cd6867ff7f7a0ede82bf5b8367e05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99b73f555b464a6a2969e4b9207a2c9c5e95e5e3ae4e3f73152f37bfb3844388.webp","width":223,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c50717","characterName":"迦具土 ヒノ","sourceIds":{"vndbCharacterId":"c50717"},"originalCharacterName":"迦具土 ヒノ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"814"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"When something happens, let me know.\""},{"spoiler":false,"text":"\"Don't be so considerate in front of me.\""},{"spoiler":false,"text":"A childhood friend who attends the same college."},{"spoiler":false,"text":"He’s always optimistic and hates to lose. He has outstanding reflexes and leads the college’s futsal club. He has a lot of secret admirers at school, and a number of girls have confessed their love to him."},{"spoiler":false,"text":"He always turns them down gently, apologizing and saying that he already has someone he likes."},{"spoiler":false,"text":"Unfortunately, this gentlemanly gesture seems to have the opposite effect, upsetting a lot of the girls, who scream at him that they won’t soon forget the rejection."},{"spoiler":false,"text":"His hobby is collecting cute merchandise. Being a guy, though, he’s slightly embarrassed about it and tries his best to keep it a secret."}],"source":"vndb","sourceCharacterId":"c50717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a24eb6b20ed3d4562aa6bf40195d822572f0ec51875feed09fcde942ae9be85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82b007a6ad75ce0171fb359e17749dd3b70623241cf847d984258db79a76d2f7.webp","width":223,"height":256,"source":"static-detail"},"actors":[{"creditedName":"島﨑 信長","creatorId":"vndb:s1248","sourcePersonId":"vndb:s1248","canonicalEntityId":"vndb:s1248","name":"島﨑 信長","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66016","source":"vndb"}]},{"characterId":"char_vndb_c50718","characterName":"甘梨 イソラ","sourceIds":{"vndbCharacterId":"c50718"},"originalCharacterName":"甘梨 イソラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"505"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"It's fine. Actually, you're more than welcome. We need more cute girls!\""},{"spoiler":false,"text":"A temporary chef working at the Fuurin Cafe. He was specifically chosen for the job a few weeks ago. His skills surpass those of his predecessor."},{"spoiler":false,"text":"…At least, that’s what Yuki Hirasaka says. While he has already obtained his chef license, he remains ambitious, continuing his training and studying international culinary techniques."},{"spoiler":false,"text":"He’s first and foremost a patissier and strives to be the very best in the world."}],"source":"vndb","sourceCharacterId":"c50718"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9657ae032cc5092fb9c3fa5cfb46e9ae9216b6fcd572f318af791167d3e6718e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79c59df0e3d9db187e55d71db75f29fd83ecb7fcca708a617f808591d82c0c49.webp","width":224,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柿原 徹也","creatorId":"vndb:s80","sourcePersonId":"vndb:s80","canonicalEntityId":"vndb:s80","name":"柿原 徹也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66009","source":"vndb"}]},{"characterId":"char_vndb_c50719","characterName":"櫛奈雫 トア","sourceIds":{"vndbCharacterId":"c50719"},"originalCharacterName":"櫛奈雫 トア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"609"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Cats are the only one who willingly come to me after all.\""},{"spoiler":false,"text":"A nerdy young man who has a deep love of movies, comics, and cats. He has difficulty interacting with people, so he tends to speak politely and avoid making eye contact."},{"spoiler":false,"text":"As the poster child of the unathletic, he often trips over thin air, scattering whatever items happen to be in his bulging pockets."},{"spoiler":false,"text":"He’s extremely nearsighted, so he has thick glasses, and he insists on wearing his favorite padded dotera kimono, even in the summer."}],"source":"vndb","sourceCharacterId":"c50719"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b290a90ade9ebdaf3596d1c2d0269be0db20e8e706f0c4ce66bee79b9c1f57e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4f400af5d3d355910ec49469171c8a93764d03e93e64d998217796147f48168.webp","width":222,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森久保 祥太郎","creatorId":"vndb:s381","sourcePersonId":"vndb:s381","canonicalEntityId":"vndb:s381","name":"森久保 祥太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66013","source":"vndb"},{"creditedName":"笹本 菜津枝","creatorId":"vndb:s11698","sourcePersonId":"vndb:s11698","canonicalEntityId":"vndb:s11698","name":"笹本 菜津枝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66019","source":"vndb"}]},{"characterId":"char_vndb_c50728","characterName":"建比良 ソウスケ","sourceIds":{"vndbCharacterId":"c50728"},"originalCharacterName":"建比良 ソウスケ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1224"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"184"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I guess that was a bit complicated for you.\""},{"spoiler":false,"text":"\"Just forget about what I said\""},{"spoiler":false,"text":"A tall med student first encountered at the bookstore in Okunezato. While he’s rather taciturn and approaches life in an exceedingly logical manner, he’s also surprisingly outdoorsy and has confidence in his athletic abilities."},{"spoiler":false,"text":"He tackles any and every problem through the lens of reason. He’s philosophical and has absolutely no sense of humor. When he tells a joke, he has to announce that he’s doing so, lest the punchline be lost on everyone listening."},{"spoiler":false,"text":"He’s obsessed with secret licenses and currently holds sixty-four different types of them. He also has a penchant for internet auctions and is constantly looking for goods online."}],"source":"vndb","sourceCharacterId":"c50728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70206e2e95bda2a868958a52565b4c8a09a86ed83d1593583941af1d83efd46c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/252d47a50bbe50dbb217c4df61c6df2fc912f803e9f6a84a60e170c95f9c9a54.webp","width":224,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城 千春","creatorId":"vndb:s8016","sourcePersonId":"vndb:s8016","canonicalEntityId":"vndb:s8016","name":"沢城 千春","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66017","source":"vndb"}]},{"characterId":"char_vndb_c50733","characterName":"叢雲 ユヅキ","sourceIds":{"vndbCharacterId":"c50733"},"originalCharacterName":"叢雲 ユヅキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"606"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Here my words are absolute.\""},{"spoiler":false,"text":"\"If you don't like it hurry and get out now\""},{"spoiler":false,"text":"The owner of the Fuurinkan Hotel and son of the distinguished Murakumo family. His father has put him through rigorous training ever since he was a kid, which has made him rather prideful."},{"spoiler":false,"text":"He’s extremely athletic and played tennis during his school days. However, he’s not a team player and never did very well in doubles matches."},{"spoiler":false,"text":"He lives in a separate residence located somewhere on the hotel premises."}],"source":"vndb","sourceCharacterId":"c50733"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8ec5875a00f01a534e94610a335f4ea0458e21cb9bb83a5a08a4b8f9fe0f22f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1272f9dab44dff4cbc72446e073265363a06f2a37a3e6dbe6444349b272f998.webp","width":223,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三木 眞一郎","creatorId":"vndb:s252","sourcePersonId":"vndb:s252","canonicalEntityId":"vndb:s252","name":"三木 眞一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66011","source":"vndb"}]},{"characterId":"char_vndb_c50905","characterName":"比良坂 ユキ","sourceIds":{"vndbCharacterId":"c50905"},"originalCharacterName":"比良坂 ユキ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"12"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Sorry if I'm a kid, but calling me like that is unpleasant”"},{"spoiler":false,"text":"“I can hear everything.”"},{"spoiler":false,"text":"A middle schooler who lives in Okunezato and is widely recognized as a genius."},{"spoiler":false,"text":"He’s quick-witted and silver-tongued, making him seem cheeky at first. However, the locals warmly regard him as their hope for the future."},{"spoiler":false,"text":"Although he’s just in his first year of middle school, he was elected student council president and has read every book in the library."},{"spoiler":false,"text":"During his summer vacation, he’s helping out at the short-staffed Fuurinkan Hotel. He wants to grow up as fast as he can, and he absolutely loathes being treated like a child."}],"source":"vndb","sourceCharacterId":"c50905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1abbd2873415872dc7531185d37df6ecbf058f30909f73f5b514e89adfa2b502.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c28f754ea9a7ef3ca2958ef50e3ca1d91b5c9a9095369ab196c5f6ac2facc47e.webp","width":223,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 沙苗","creatorId":"vndb:s479","sourcePersonId":"vndb:s479","canonicalEntityId":"vndb:s479","name":"小林沙苗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66015","source":"vndb"}]},{"characterId":"char_vndb_c50906","characterName":"須沙野 ユア","sourceIds":{"vndbCharacterId":"c50906"},"originalCharacterName":"須沙野 ユア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“How about working at Furinkan?”"},{"spoiler":false,"text":"“Just while you’re in this village.”"},{"spoiler":false,"text":"A young woman who works at the Fuurinkan Hotel."},{"spoiler":false,"text":"She’s a genuine local, having been born and raised in Okunezato. While she has an extremely cheerful and positively endearing personality, she’s also a bit of a klutz and is always asking people if they’ve seen her cell phone."},{"spoiler":false,"text":"She loves video games and plays everything from current-gen games with realistic graphics to 8-bit classics from thirty years ago. She’s so far gone, she’s practically made of pixels."}],"source":"vndb","sourceCharacterId":"c50906"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a72b579473e04cf1102b48fb7dd7a88f6af4f644db3a8f88ee702faa07378bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a71b62022754b64b996279c555525e564e3707f5bcb6a21b8ad66e9554f5ccde.webp","width":222,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎藤 千和","creatorId":"vndb:s475","sourcePersonId":"vndb:s475","canonicalEntityId":"vndb:s475","name":"斎藤千和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66014","source":"vndb"}]},{"characterId":"char_vndb_c50907","characterName":"久々