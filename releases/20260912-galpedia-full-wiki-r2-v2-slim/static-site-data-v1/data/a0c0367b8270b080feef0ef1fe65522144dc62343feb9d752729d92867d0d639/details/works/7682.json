{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7682","model":{"presentationWorkId":"vndb:v4403","staff":{"artwork":[{"creditedName":"Moo℃団(なべち、てってち、ぎんぱち、渡辺義弘","creatorId":"vndb:s1891","sourcePersonId":"egs:creator:98","canonicalEntityId":"vndb:s1891","name":"Moo℃団(なべち、てってち、ぎんぱち、渡辺義弘)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22174","source":"egs"}],"scenario":[{"creditedName":"兄丸","creatorId":"vndb:s1892","sourcePersonId":"egs:creator:1690","canonicalEntityId":"vndb:s1892","name":"兄丸","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22175","source":"egs"},{"creditedName":"片塚あき","creatorId":"egs:creator:5070","sourcePersonId":"egs:creator:5070","canonicalEntityId":"egs:creator:5070","name":"片塚あき","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:36314","source":"egs"},{"creditedName":"南風","creatorId":"vndb:s6131","sourcePersonId":"vndb:s6131","canonicalEntityId":"vndb:s6131","name":"南風","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:49620","source":"vndb"}],"music":[],"other":[{"creditedName":"rena","creatorId":"vndb:s58","sourcePersonId":"vndb:s58","canonicalEntityId":"vndb:s58","name":"雪絵 れな","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:49621","source":"vndb"}]},"cast":[{"characterId":"char_c3652","characterName":"英 つぐみ","sourceIds":{"bangumi":[{"characterId":"90265","match":"exact-normalized-name-in-linked-work","subjectId":"167744"},{"characterId":"90265","match":"exact-normalized-name-in-linked-work","subjectId":"271211"}],"egsCharacterIds":["22718"],"vndbCharacterId":"c3652"},"originalCharacterName":"英 つぐみ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二年生・弓道部副主将。"},{"spoiler":false,"text":"主人公の幼なじみにして、学園のもうひとりのマドンナ。"},{"spoiler":false,"text":"昨年の学園祭のミスコンで、一年生にしては初の"},{"spoiler":false,"text":"「黒薔薇の君」の称号を得るほどの純・和風美人。"}],"source":"egs","sourceCharacterId":"22718","sourceWorkId":"2170","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の元級友にしてライバル。"},{"spoiler":false,"text":"純・和風美人の武闘派。"},{"spoiler":false,"text":"※「学艶～狙われた痴態～ 」に登場"}],"source":"egs","sourceCharacterId":"22718","sourceWorkId":"7682","spoiler":false},{"segments":[{"spoiler":false,"text":"キャンバスの新一年生歓迎祭にて、ミスコン第3位に輝いた純・和風美人。 異性に対してキツい性格で、怠惰や貪欲・肉欲などにはことのほか厳しい。か つて学園祭の余興で男装したとき、女装した主人公に電撃的な一目惚れをした 挙げ句、一方的にフラれた（と思いこんだ）ことがある。以来、恋はしないこ とに決めている。古風なしゃべり方をするため、年齢以上に見られることが最 近の悩み。弥生と違い、女の子より男にモテるのも最近の悩み。"}],"source":"bangumi","sourceCharacterId":"90265"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf844c7b88f8a550ab3faa884ca5378bfaecfa87e42d0dab91da7d4b6effec38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81ecaaf7fa3643edc93f98a7c5875e0b5381dc3426209e65006737553d5fcdf9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茉莉奈","creatorId":"vndb:s58","sourcePersonId":"vndb:s58","canonicalEntityId":"vndb:s58","name":"雪絵 れな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27529","source":"vndb"}]},{"characterId":"char_c36671","characterName":"桐澤 弥生","sourceIds":{"bangumi":[{"characterId":"90263","match":"exact-normalized-name-in-linked-work","subjectId":"271211"},{"characterId":"90263","match":"exact-normalized-name-in-linked-work","subjectId":"271216"}],"egsCharacterIds":["22719"],"vndbCharacterId":"c36671"},"originalCharacterName":"桐澤 弥生","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"笑顔のかわいい女の子。"},{"spoiler":false,"text":"学年トップの優等生でお嬢様。"},{"spoiler":false,"text":"細かい事にはこだわらないため"},{"spoiler":false,"text":"おおざっぱな面が目立つ。"},{"spoiler":false,"text":"又、人当たりは良いが負けず嫌い。"}],"source":"egs","sourceCharacterId":"22719","sourceWorkId":"4558","spoiler":false},{"segments":[{"spoiler":false,"text":"舞桜の親友で主人公の後輩。"},{"spoiler":false,"text":"飾らない性格の優等生。"},{"spoiler":false,"text":"※「い・い・な・り」に登場"}],"source":"egs","sourceCharacterId":"22719","sourceWorkId":"7682","spoiler":false},{"segments":[{"spoiler":false,"text":"舞桜の親友。強気な性格で、自分自身を飾らない女の子。常におおざっぱで 自由奔放。お嬢様らしくないお嬢様。優等生っぽく見えないが学年でトップ。 舞桜と違い、去年のウチに推薦で大学入試を終わらせてしまったので、いまは 悠々自適。男顔負けの気っぷの良さで、男子より女子人気が高い。アンディと も幼なじみでもあり、何故か付き合っているらしいが……？"}],"source":"bangumi","sourceCharacterId":"90263"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f01d5d306a8fe5fe40bc7ce7347e5ebb3f7d7f0cb19cc3653e30325225930b01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d008bf9be8b13ffeb32077aecd8b3235def1fcc38016e01c79d9ae70fd8a162.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c37280","characterName":"メルティ","sourceIds":{"bangumi":[{"characterId":"145999","match":"exact-normalized-name-in-linked-work","subjectId":"269344"}],"egsCharacterIds":["26517"],"vndbCharacterId":"c37280"},"originalCharacterName":"メルティ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女性の天使。天界の名家の娘。"},{"spoiler":false,"text":"「PLUS」で追加された新規ヒロイン。"},{"spoiler":false,"text":"追加シナリオに登場。"}],"source":"egs","sourceCharacterId":"26517","sourceWorkId":"5998","spoiler":false},{"segments":[{"spoiler":false,"text":"女性の天使。天界の名家の娘。"},{"spoiler":false,"text":"「PLUS」で追加された新規ヒロイン。"},{"spoiler":false,"text":"追加シナリオに登場。"}],"source":"bangumi","sourceCharacterId":"145999"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0d132a67a1e35ed6e38cd7e64833e9de2a5c12125e7ccae2cb889c88b9ba6fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f242715cb01f22d3d8e1f749a451508a2eaf0c9cb5f78867f9f7345e5d6c39e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c51181","characterName":"雪野 ちとせ","sourceIds":{"bangumi":[{"characterId":"13313","match":"exact-normalized-name-in-linked-work","subjectId":"212672"},{"characterId":"13313","match":"exact-normalized-name-in-linked-work","subjectId":"271211"}],"egsCharacterIds":["4738"],"vndbCharacterId":"c51181"},"originalCharacterName":"雪野 ちとせ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine of the story. She steps in as the young proprietress of the Kinhou-rou, the hot spring inn that the protagonist visits."},{"spoiler":false,"text":"Due to the original proprietress eloping with a younger man for the seventh time, Chitose, who happened to be on winter break, is called in to fill the role. Currently a student preparing for her entrance exams, she is under considerable stress, balancing her duties as an innkeeper with her studies, as the exams are less than a month away. Despite her youth, her directions as the proprietress are precise, earning her the respect and fondness of most of the inn's employees. She tends to be stubborn and obstinate when corrected by others, yet she does not resist changing her own opinions. She is somewhat egotistical and determined to thwart the protagonist's lecherous misdeeds at every turn."}],"source":"vndb","sourceCharacterId":"c51181"},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"主人公の訪れる温泉の若女将。"},{"spoiler":false,"text":"宿の従業員からも、好意的に受け止められている。"},{"spoiler":false,"text":"主人公のスケベな悪事をことごとく邪魔しようとする。"}],"source":"egs","sourceCharacterId":"4738","sourceWorkId":"3375","spoiler":false},{"segments":[{"spoiler":false,"text":"温泉旅館・金峰館の若女将。"},{"spoiler":false,"text":"しっかりものだが根はお人好し。"},{"spoiler":false,"text":"※「秘湯めぐり～欲情蹂躙温泉記」に登場"}],"source":"egs","sourceCharacterId":"4738","sourceWorkId":"7682","spoiler":false},{"segments":[{"spoiler":false,"text":"【一般宿泊客】"},{"spoiler":false,"text":"薫の代理人として主人公へ定期的に接触してくる謎の女性。"},{"spoiler":false,"text":"柳条組のフロント企業・金峰ファイナンスの女社長。"},{"spoiler":false,"text":"途中からは宿泊客として桂城荘へやってくる。今年で28歳。"}],"source":"egs","sourceCharacterId":"4738","sourceWorkId":"17832","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。主人公の訪れる温泉宿・金峰楼（キンホウロウ）の若女将。"},{"spoiler":false,"text":"本来の女将が若い男と７回目の蒸発をしてしまったため、たまたま冬休みだった彼女が呼ばれた。現在、受験生。試験まであと１ヶ月ないため、女将の仕事と受験勉強とで、かなりピリピリきている。若いながら、女将としての指図は的確で、宿の従業員からも、一部を除いてかなり好意的に受け止められている。人かのら注意には、頑固で意固地な性格を発揮するが、自分から意見を変えることにはあまり抵抗がない。唯我独尊タイプ。主人公のスケベな悪事をことごとく邪魔しようとする。"}],"source":"bangumi","sourceCharacterId":"13313"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/106a9f2a72af7e964d1846a7fa2715625d0bf4f0197fa4d642593495754f9310.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57f43e2a1380c4bed1ed0775ba87e6bc7c9f6eac57f7b803c8c5f6d23dd4d45b.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271211:13313:5890:1","source":"bangumi"}]},{"characterId":"char_c65194","characterName":"藤井 冴子","sourceIds":{"bangumi":[{"characterId":"32721","match":"exact-normalized-name-in-linked-work","subjectId":"134048"}],"egsCharacterIds":["22721"],"vndbCharacterId":"c65194"},"originalCharacterName":"藤井 冴子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"164cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公。英語教師。"},{"spoiler":false,"text":"今年短大を卒業し、英語教師としてこの学院に赴任したばかり。"},{"spoiler":false,"text":"笑顔の素敵な美女だが、芯の弱い性格。"},{"spoiler":false,"text":"男に馴れていない処女。"}],"source":"egs","sourceCharacterId":"22721","sourceWorkId":"1952","spoiler":false},{"segments":[{"spoiler":false,"text":"温泉旅行に来ていた女教師。"},{"spoiler":false,"text":"気弱で、騙されやすい性格。"},{"spoiler":false,"text":"※「女教師冴子～媚肉授業～ 」に登場"}],"source":"egs","sourceCharacterId":"22721","sourceWorkId":"7682","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。英語教師。"},{"spoiler":false,"text":"今年短大を卒業し、英語教師としてこの学院に赴任したばかり。"},{"spoiler":false,"text":"笑顔の素敵な美女だが、芯の弱い性格。"},{"spoiler":false,"text":"男に馴れていない処女。"}],"source":"bangumi","sourceCharacterId":"32721"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e4f0a503ec3f02c0dca8eaa8719ab81c808b54de8f1776aef7f395822301985.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/688bbd3249d7590ba63df145085bb83f565904c193d27b47190d3a4a9fd7545f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c65621","characterName":"藍澤 くるみ","sourceIds":{"bangumi":[{"characterId":"90264","match":"exact-normalized-name-in-linked-work","subjectId":"271211"}],"egsCharacterIds":["22720"],"vndbCharacterId":"c65621"},"originalCharacterName":"藍澤 くるみ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"獅之宮家のメイド。"},{"spoiler":false,"text":"4姉妹の次女。"},{"spoiler":false,"text":"4人とも獅之宮家のメイドとして"},{"spoiler":false,"text":"奉公しているが他の3人は休暇中。"},{"spoiler":false,"text":"素朴で率直な性格。"}],"source":"egs","sourceCharacterId":"22720","sourceWorkId":"6652","spoiler":false},{"segments":[{"spoiler":false,"text":"温泉旅館の別館で働くメイドさん。"},{"spoiler":false,"text":"素直でほがらかだが怒ると怖い。"},{"spoiler":false,"text":"※「ZeBRa-ゼブラ-　虜囚の館」に登場"}],"source":"egs","sourceCharacterId":"22720","sourceWorkId":"7682","spoiler":false},{"segments":[{"spoiler":false,"text":"鈴峰グランドリゾートの5号棟、洋風の建物のメイド館で働くメイドさん。 仕事内容は仲居さんと同じ。素直でほがらかなな性格だが、怒るとかなり怖い。 機械とは相性問題がよく起きて、結構な頻度でモノを壊してしまうのが最大の 悩み。つぐみとは旧知の仲だが、信頼しあうような関係ではない（つぐみ談）。 彼女がこの街にいることに、何か秘密があるらしい。"}],"source":"bangumi","sourceCharacterId":"90264"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68caa7eb2f4705a291e15c3a6e0178041fa077e92d0d89e79e47c7f002a2d33c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef85c3c4135424a740327a3b5fd6d4a7043444edd713416048f28f313b051ea8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"唐沢 けい","creatorId":"vndb:s15054","sourcePersonId":"vndb:s15054","canonicalEntityId":"vndb:s15054","name":"唐沢 けい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27533","source":"vndb"}]},{"characterId":"char_vndb_c51000","characterName":"神奈川 健子","sourceIds":{"vndbCharacterId":"c51000"},"originalCharacterName":"神奈川 健子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68df17cb4ca28103c716f16a87858b55a0338cc5a407b5d25f64f95117fcbd7d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa291357a03da8544765d4fa7b413bb743720d76bc86aa974d3e65392f9692be.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千愛","creatorId":"vndb:s6169","sourcePersonId":"vndb:s6169","canonicalEntityId":"vndb:s6169","name":"千愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27532","source":"vndb"}]},{"characterId":