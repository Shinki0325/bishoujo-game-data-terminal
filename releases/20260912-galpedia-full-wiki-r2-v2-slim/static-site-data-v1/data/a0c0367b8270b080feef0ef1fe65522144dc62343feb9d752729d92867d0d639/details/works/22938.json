oiler":false,"text":"滅多なことには動じないクールな性格ではあるが……。"},{"spoiler":false,"text":"「お邪魔します。 私、殿方の部屋に入るのって初めて」"}],"source":"bangumi","sourceCharacterId":"25393"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"25393","value":"お米"},{"label":"特技","source":"bangumi","sourceCharacterId":"25393","value":"裁縫"},{"label":"趣味","source":"bangumi","sourceCharacterId":"25393","value":"刺繍"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ade9e6a3dafcf0cdf535f13482425fb741814c8f425fa2d1bb769726ba09bb5f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80e82918896f329444d82b1d7c54cae086dea0cbdb30e3267e0224191cba8e85.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:96474:25393:11646:1","source":"bangumi"}]},{"characterId":"char_c18836","characterName":"壬生 棗","sourceIds":{"bangumi":[{"characterId":"25394","match":"exact-normalized-name-in-linked-work","subjectId":"96474"}],"egsCharacterIds":["3699"],"vndbCharacterId":"c18836"},"originalCharacterName":"壬生 棗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"518"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","sourc