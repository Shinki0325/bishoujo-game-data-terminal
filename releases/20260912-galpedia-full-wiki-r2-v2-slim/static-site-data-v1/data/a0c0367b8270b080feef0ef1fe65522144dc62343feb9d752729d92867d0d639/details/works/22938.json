ght":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Interests: cooking, making sweets"},{"spoiler":false,"text":"Skills: Can prepare notes to deal with any situation"},{"spoiler":false,"text":"Favorite food: curry"},{"spoiler":false,"text":"A transfer student that moved next door to the protagonist's apartment. Suffers from social anxiety resulting from constantly having to transfer schools before having enough time to make friends. She always carries around a notebook filled with notes on how to respond in different kinds of situations when communicating with others. However, over time it has become a sort of a manual on the topic of \"How to play the role of a honor student\"."}],"source":"vndb","sourceCharacterId":"c18833"},{"segments":[{"spoiler":false,"text":"主人公の住むマンションの隣に引っ越してきた転校生。"},{"spoiler":false,"text":"あがり症で友達を作る間もなく転校を繰り返すうちに、いつしかそれ自体を諦め友達が作れない、という思い込みから、お堅い優等生を演じている。"},{"spoiler":false,"text":"持ち歩いている手帳"},{"spoiler":false,"text":"はコミュニケーションのためにと用意したものだったが、いつの間にかそれが優等生を演じるためのマニュアルになっている。"}],"source":"egs","sourceCharacterId":"3696","sourceWorkId":"20173","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の住むマンションの隣に引っ越してきた転校生。"},{"spoiler":false,"text":"あがり症で、友達を作る間もなく転校を繰り返すうち、いつしかそれ自体を諦め友達が作れない、という思い込みからお堅い優等生を演じている。"},{"spoiler":false,"text":"持ち歩いている手帳はコミュニケーションのためにと用意したものだったが、いつの間にかそれが優等生を演じるためのマニュアルになっている。"},{"spoiler":false,"text":"「ふ、普通よ、これくらい…… ふ、普通なんだから」"}],"source":"bangumi","sourceCharacterId":"25391"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"25391","value":"カレー"},{"label":"特技","source":"bangumi","sourceCharacterId":"25391","value":"何にでも対応できるメモの用意"},{"label":"趣味","source":"bangumi","sourceCharacterId":"25391","value":"料理・お菓子作り"}],"meta