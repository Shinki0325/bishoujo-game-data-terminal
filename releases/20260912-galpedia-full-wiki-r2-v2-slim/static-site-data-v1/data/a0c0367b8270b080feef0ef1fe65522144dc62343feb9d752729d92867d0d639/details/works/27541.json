e first woman the protagonist raped was her sister."},{"spoiler":false,"text":"She's unaware of his existence as the protagonist was blacklisted from his family. It's just a coincidence that she met him."},{"spoiler":false,"text":"Because of her resemblance to her sister, she reignited the protagonist's memories and regained his true nature as a tormentor."}],"source":"vndb","sourceCharacterId":"c78286"},{"segments":[{"spoiler":false,"text":"可愛らしくも大人びた雰囲気を漂わせる少女。"}],"source":"egs","sourceCharacterId":"20669","sourceWorkId":"27541","spoiler":false},{"segments":[{"spoiler":false,"text":"転校生として学園に転校してきたばかりの、"},{"spoiler":false,"text":"誰に対しても丁寧に対応するしっかり者で優しい少女。"},{"spoiler":false,"text":"本人は知らないが雄吾とは親戚関係であり、"},{"spoiler":false,"text":"雄吾が初めて能力を使って襲った女性の妹。"},{"spoiler":false,"text":"雄吾の存在は家族から知らされておらず、"},{"spoiler":false,"text":"彼がいる学園に転校してきたのはただの不幸な偶然。"},{"spoiler":false,"text":"姉に外見が酷似しているため、雄吾の封じられた過去の記憶を刺激し、"},{"spoiler":false,"text":"彼の凌辱者としての本性を取り戻させてしまうこととなる。"}],"source":"bangumi","sourceCharacterId":"69207"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"20669","sourceWorkId":"27541","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"20669","sourceWorkId":"27541","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"20669","sourceWorkId":"27541","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"20669","sourceWorkId":"27541","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"20669","sourceWorkId":"27541","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4141ea68970dbee4d35b260f660be366fc63da211fc28e34e3915ea9f3258