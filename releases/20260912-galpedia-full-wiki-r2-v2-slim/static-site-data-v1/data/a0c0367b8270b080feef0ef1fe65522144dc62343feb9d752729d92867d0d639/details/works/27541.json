se,"text":"気が強い性格で、率先して周囲を引っ張っていくリーダー気質のある少女。"},{"spoiler":false,"text":"よく気が利く上に行動的なため、クラスの人間から慕われている。"},{"spoiler":false,"text":"しかしその実態は自己中心的で常に他人を見下し、"},{"spoiler":false,"text":"裏で気に入らない人間をストレス発散と称してイジメるサディスト。"},{"spoiler":false,"text":"周囲を引っ張っているのも、"},{"spoiler":false,"text":"他の人に自分を持ち上げさせるためという利己的な目的から。"},{"spoiler":false,"text":"かなりの見栄っ張りで困っていても虚勢を張って強がってしまうことが多々ある。"}],"source":"bangumi","sourceCharacterId":"69208"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"20670","sourceWorkId":"27541","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"20670","sourceWorkId":"27541","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"20670","sourceWorkId":"27541","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"20670","sourceWorkId":"27541","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"20670","sourceWorkId":"27541","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33b3fe1ced85268fcd3a6e8674c70fae358bf22757ad03054ef5a4f9814015e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e67fb2e8d8f19a4be94768da71043f3f2b1c260e52ad781dbafdb359881ab40.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274775:69208:5907:1","source":"bangumi"}]},{"characterId":"char_c78288","characterName":"宝月 のえる","sourceIds":{"bangumi":[{"character