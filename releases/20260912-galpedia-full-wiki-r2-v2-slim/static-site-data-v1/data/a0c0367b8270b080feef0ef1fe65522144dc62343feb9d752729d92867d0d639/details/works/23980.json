,"sourcePersonId":"vndb:s10375","canonicalEntityId":"vndb:s10375","name":"すなすな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132387","source":"vndb"},{"creditedName":"シマエナガ","creatorId":"vndb:s13956","sourcePersonId":"vndb:s13956","canonicalEntityId":"vndb:s13956","name":"シマエナガ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:132388","source":"vndb"}]},"cast":[{"characterId":"char_c51221","characterName":"篠田 遥佳","sourceIds":{"bangumi":[{"characterId":"86218","match":"exact-normalized-name-in-linked-work","subjectId":"265096"}],"egsCharacterIds":["10619"],"vndbCharacterId":"c51221"},"originalCharacterName":"篠田 遥佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's sister in law."},{"spoiler":false,"text":"Before marriage she was childhood friends with Touya and Shuugo."},{"spoiler":false,"text":"Her husband often isn't around due to work so her sex life isn't that active and they don't have children."},{"spoiler":false,"text":"She is a little lonely due to her husband's constant absence so she is often hanging around Touya, however she doesn't see him as the opposite sex so she is always defenseless around him."}],"source":"vndb","sourceCharacterId":"c51221"},{"segments":[{"spoiler":false,"text":"兄嫁。主人公兄弟とは幼馴染。"},{"spoiler":false,"text":"しっかり者で明るく活発。"},{"spoiler":false,"text":"夫がいなくて寂しいのと、弟を頼まれたのもあってやや張り切り気味で主人公を何かと気にかけてくれる。"},{"spoiler":false,"text":"幼馴染であるがゆえに主人公を弟のようにしか思っておらず、異性として意識していないため少しだけ無防備な所がある。"},{"spoiler":false,"text":"夫が長期で不在になることが多いため、性生活はあまりなく、子供もまだいない。"},{"spoiler":false,"text":"仕事を理解した上でプロポーズを受け入れ結婚したものの、少し寂しいとは思っている。"}],"source":"egs","sourceCharacterId":"10619","sourceWorkId":"23980","spoiler":false},{"segments":[{"spoiler":false,"text":"兄嫁。 主人公兄弟とは幼なじみ。 しっかり者で明るく活発。"},{"spoiler":false,"text":"夫がいなくて寂しいのもあって、やや張り切り気味に主人公を気に掛けてくれる。"},{"spoiler":false,"text":"主人公を異性としては意識していないため、少しだけ無防備なところがある。"},{"spoiler":false,"text":"夫が長期不在になることが多いため性生活はあまりなく、子供もまだいない。"},{"spoiler":false,"text":"仕事を理解した上で結婚したものの、少し寂しいとは思っている。"},{"spoiler":false,"text":"「今日からしばらく二人暮らしだね。 改めてよろしくね、冬哉君」"}],"source":"bangumi","sourceCharacterId":"86218"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"10619","sourceWorkId":"23980","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"10619","sourceWorkId":"23980","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"10619","sourceWorkId":"23980","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"10619","sourceWorkId":"23980","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1748afb8c0598342366941d8fc767207982343d57e5ab9b8f432aec3dcdea51c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb481653d4f2ccc062ac4e4c654c3d0b22aafc6da1d035007bd68fad528caf27.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265096:86218:15637:1","source":"bangumi"