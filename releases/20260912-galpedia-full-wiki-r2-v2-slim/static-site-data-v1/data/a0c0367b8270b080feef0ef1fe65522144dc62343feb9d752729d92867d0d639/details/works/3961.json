{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3961","model":{"presentationWorkId":"vndb:v2136","staff":{"artwork":[{"creditedName":"ぶぶづけ","creatorId":"vndb:s4581","sourcePersonId":"egs:creator:2384","canonicalEntityId":"vndb:s4581","name":"ぶぶづけ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6157","source":"egs"}],"scenario":[{"creditedName":"猫にた","creatorId":"vndb:s3042","sourcePersonId":"egs:creator:2030","canonicalEntityId":"vndb:s3042","name":"猫にた","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6158","source":"egs"},{"creditedName":"りりあん嬢","creatorId":"vndb:s3043","sourcePersonId":"egs:creator:2192","canonicalEntityId":"vndb:s3043","name":"りりあん嬢","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6159","source":"egs"},{"creditedName":"蒼夜","creatorId":"vndb:s3044","sourcePersonId":"egs:creator:2385","canonicalEntityId":"vndb:s3044","name":"蒼夜","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6160","source":"egs"}],"music":[{"creditedName":"影武者","creatorId":"vndb:s17369","sourcePersonId":"egs:creator:4395","canonicalEntityId":"vndb:s17369","name":"影武者","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16302","source":"egs"}],"other":[{"creditedName":"莉子","creatorId":"vndb:s4848","sourcePersonId":"vndb:s4848","canonicalEntityId":"vndb:s4848","name":"莉子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:32192","source":"vndb"}]},"cast":[{"characterId":"char_c45237","characterName":"篝火","sourceIds":{"bangumi":[{"characterId":"39084","match":"exact-normalized-name-in-linked-work","subjectId":"169502"}],"egsCharacterIds":["19245"],"vndbCharacterId":"c45237"},"originalCharacterName":"篝火","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"３月２７日"},"bloodType":{"reviewState":"no-conflict","source":"bangumi","value":"4"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"１１０"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８５"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５７"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本を影から守る秘密機関のエージェント（＝乳忍者/くノ一）。20歳。"},{"spoiler":false,"text":"身寄りのなかった彼女は、今は亡き師匠・疾風斉に拾われ、幼い頃から忍術を仕込まれた。"},{"spoiler":false,"text":"くノ一としての腕前は優秀で、自らの巨乳やお色気を使った特殊忍法を得意とする。"},{"spoiler":false,"text":"明朗快活でアクティブな性格。頭で考えるより行動が先に出てしまうタイプ。"},{"spoiler":false,"text":"やや大雑把で、熱くなり過ぎるきらいはあるが、任務には至極忠実。"},{"spoiler":false,"text":"普段は会社の事務員として働いている。"}],"source":"egs","sourceCharacterId":"19245","sourceWorkId":"3961","spoiler":false},{"segments":[{"spoiler":false,"text":"力の1号。乳忍者。「乳忍法」の使い手。"},{"spoiler":false,"text":"伊賀忍者の系譜を組む水野忍群の忍者の中でも、五指にはいる能力の持ち主であることは、宗家惣領も認めるところ。"},{"spoiler":false,"text":"ただし性格に難ありで、ムラ気があり、実力が生かし切れてない面は否定できず、いろんな意味で呆れられてる。"},{"spoiler":false,"text":"「外務省国際情報統括部隠密室」付き。"},{"spoiler":false,"text":"普段は「株式会社LGT」の第二総務課でOLをしている。"},{"spoiler":false,"text":"わりと豪放な性格で、大食らい。じつは……隠れオ○ク？不知火とはいいコンビ。ボケ担当。"}],"source":"egs","sourceCharacterId":"19245","sourceWorkId":"9839","spoiler":false},{"segments":[{"spoiler":false,"text":"明るくて行動的。頭が悪いわけではないが、考えるより先に行動に移すコトが多い。また、少々おおざっぱなところがある。任務には忠実だが、熱くなりやすいところがあるため、ついついやりすぎることも多い。"},{"spoiler":false,"text":"外務省　国際情報統括官組織／第二国際情報官室所属／忍者部隊に所属。"},{"spoiler":false,"text":"今は亡き師匠に育てられ、幼少の頃から忍術を仕込まれていた。くのいちとしては凄腕で、自らの巨乳を使った、特殊な忍法を駆使する。また、普通のくのいちのように、お色気を使った術も得意。どんな拷問にかけられても、乗り切れるような訓練を受けている。"}],"source":"bangumi","sourceCharacterId":"39084"}],"profileFacts":[{"label":"年龄（本版本）","value":"20 岁","valueContext":null,"source":"egs","sourceCharacterId":"19245","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"110 cm","valueContext":null,"source":"egs","sourceCharacterId":"19245","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"19245","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"19245","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"19245","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"43 kg","valueContext":null,"source":"egs","sourceCharacterId":"19245","sourceWorkId":"3961","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49ffac6bb6a1176290b5c3b64cf14a241431558f35cb56c891a4f5fbdcaec654.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/159ceaf02312d54eee2f10385bfbc7b3a5be73759242167a1b21ad30eb884509.webp","width":125,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杏露花梨","creatorId":"vndb:s2925","sourcePersonId":"vndb:s2925","canonicalEntityId":"vndb:s2925","name":"杏露 花梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:169502:39084:21538:1","source":"bangumi"}]},{"characterId":"char_c45238","characterName":"不知火","sourceIds":{"bangumi":[{"characterId":"39317","match":"exact-normalized-name-in-linked-work","subjectId":"169502"}],"egsCharacterIds":["19246"],"vndbCharacterId":"c45238"},"originalCharacterName":"不知火","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"１月１２日"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８５"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"９８"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５５"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本を影から守る秘密機関のエージェント（＝乳忍者/くノ一）。20歳。"},{"spoiler":false,"text":"篝火と同じく、幼少の頃から忍術を仕込まれた優秀なくノ一。"},{"spoiler":false,"text":"お尻を使った尻忍法を得意とし、また篝火との合体技は強烈無比。"},{"spoiler":false,"text":"熱血な篝火とは違い思慮深く、慎重なところがあり、むやみに行動に移したりはしない。"},{"spoiler":false,"text":"しかし、篝火に引きずられて、結局、二人でやり過ぎてしまうことが多い。"}],"source":"egs","sourceCharacterId":"19246","sourceWorkId":"3961","spoiler":false},{"segments":[{"spoiler":false,"text":"技の2号。尻忍者。「尻忍法」の使い手。"},{"spoiler":false,"text":"篝火同様、水野忍群の忍者のなかでも、五指にはいる能力の持ち主であることは、宗家惣領も認めるところ。"},{"spoiler":false,"text":"本人はまともなつもりだが、客観的に見れば、やはり性格に問題がいろいろ……。"},{"spoiler":false,"text":"本人は、真面目で冷静でクールなつもり。負けず嫌い。"},{"spoiler":false,"text":"「外務省国際情報統括部隠密室」付き。"},{"spoiler":false,"text":"普段は株式会社LGTの第二総務課でOLをしている。"},{"spoiler":false,"text":"篝火とはいいコンビ。ツッコミ担当。"}],"source":"egs","sourceCharacterId":"19246","sourceWorkId":"9839","spoiler":false},{"segments":[{"spoiler":false,"text":"【身長】　　　１６０cm　　体重４２ｋｇ"},{"spoiler":false,"text":"【３サイズ】　Ｂ８５・Ｗ５５・Ｈ９８"},{"spoiler":false,"text":"【誕生日】　　１月１２日（山羊座）"},{"spoiler":false,"text":"【血液型】　　Ｂ型"},{"spoiler":false,"text":"【趣味】　　　旅行"},{"spoiler":false,"text":"【性格】　クールと言うほどではないが、篝火と比べると、普段から落ち着いている。思慮深く、慎重なところがあり、むやみに行動に移したりはしない。優柔不断ではなく、決断力も兼ね備えている。もっとも思慮深いのは、篝火を押さえると言う役回りのためで、本質はそれほどでもないようである。そのため、結局篝火に引きずられて、２人でやりすぎてしまうことも多い。"},{"spoiler":false,"text":"篝火と同じく、幼少の頃から忍術を仕込まれている。不知火は自らのお尻を使った尻忍法を駆使する。みずからの尻の重さを調節し敵にダメージを与える「ヒップスタンプ」などの尻忍法がある。また、篝火と合体してより強烈な攻撃を仕掛けることも可能。篝火も知らないことだが、組織を裏切った兄弟子『早瀬』とは、昔恋人同士だった。"}],"source":"bangumi","sourceCharacterId":"39317"}],"profileFacts":[{"label":"年龄（本版本）","value":"20 岁","valueContext":null,"source":"egs","sourceCharacterId":"19246","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"19246","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"19246","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"19246","sourceWorkId":"3961","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"19246","sourceWorkId":"3961","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/440bb0e5624523833390da27bdec9982772c99fc8430158e1d70bdb8c0c0a585.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/316150a59108bad4613a2792bfe4293e2b18f16d35f9df77ea2c00fa8c143cfb.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森山葵","creatorId":"vndb:s2926","sourcePersonId":"vndb:s2926","canonicalEntityId":"vndb:s2926","name":"森山 葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:169502:39317:22079:1","source":"bangumi"}]},{"characterId":"char_vndb_c45239","characterName":"天頼 南美","sourceIds":{"vndbCharacterId":"c45239"},"originalCharacterName":"天頼 南美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb