staff:131027","source":"vndb"},{"creditedName":"にぃと","creatorId":"vndb:s9454","sourcePersonId":"vndb:s9454","canonicalEntityId":"vndb:s9454","name":"にぃと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131028","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c92780","characterName":"北村 奏時","sourceIds":{"vndbCharacterId":"c92780"},"originalCharacterName":"北村 奏時","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1968"}],"source":"vndb","sourceCharacterId":"c92780"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c92781","characterName":"秋澄","sourceIds":{"vndbCharacterId":"c92781"},"originalCharacterName":"秋澄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1968"},{"spoiler":false,"text":"Main character of \"1985-1994 scenario\""},{"spoiler":false,"text":"Souji's close friend. Sakurako's boyfriend."},{"spoiler":true,"text":"Sumire's father."},{"spoiler":false,"text":"A good-looking boy who is also decent in studying. Akisumi is currently working as a caretaker in an orphanage where he used to spend his life as an orphan before."},{"spoiler":false,"text":"Loves raising all kinds of vegetables, to the point of thinking about marriage with one."},{"spoiler":false,"text":"Later on,"},{"spoiler":true,"text":"his death was revealed on 22 Mar 1995, due to an accident in the laboratory that he is working for."}],"source":"vndb","sourceCharacterId":"c92781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8344e90967eca9cf11925e050ff4f8f51d3d825687a3afd6296dd142805a6460.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bf0a2dba031a0858995d8563daa82ecd87494cfb92d29248fadc8941c3b3336.webp","width":158,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92782","characterName":"桜恋","sourceIds":{"vndbCharacterId":"c92782"},"originalCharacterName":"桜恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1968"},{"spoiler":false,"text":"Main character of \"1985-1994 scenario\""},{"spoiler":false,"text":"Souji's close friend. Akisumi's girlfriend."},{"spoiler":true,"text":"Sumire's mother."},{"spoiler":false,"text":"A girl who is keen on raising flowers, believing that they will save the world from any disasters. Despite her assertive personality, she could be pretty childish at times."},{"spoiler":true,"text":"Similar to Souji, Sakurako also possesses the ability to perceive \"irregular\" matters."},{"spoiler":false,"text":"Later on,"},{"spoiler":true,"text":"Sakurako becomes pregnant with Akisumi's child and conceives Sumire afterward. Her death is revealed on 22 Mar 1995, due to an accident in the laboratory that she is working for."}],"source":"vndb","sourceCharacterId":"c92782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c36a3b19650b809c395f046ebf897f189073f8b267ec7c1a6c65e56675749ff1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1c767ef15ebe218411505edb8e2793f5254dade44ba3c1fe885424c1fd648f1.webp","width":143,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92847","characterName":"射水すみれ","source