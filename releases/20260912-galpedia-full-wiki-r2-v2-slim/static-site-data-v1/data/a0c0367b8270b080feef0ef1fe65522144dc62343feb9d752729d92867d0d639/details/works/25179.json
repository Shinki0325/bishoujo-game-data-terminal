:"vndb:s17624","canonicalEntityId":"vndb:s17624","name":"透月 ハジメ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:91156","source":"vndb"},{"creditedName":"よしな","creatorId":"vndb:s37145","sourcePersonId":"vndb:s37145","canonicalEntityId":"vndb:s37145","name":"よしな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:91159","source":"vndb"},{"creditedName":"株式会社インクルード・インク","creatorId":"vndb:s37452","sourcePersonId":"vndb:s37452","canonicalEntityId":"vndb:s37452","name":"株式会社インクルード・インク","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:91160","source":"vndb"},{"creditedName":"黒瀬 ゆづき","creatorId":"vndb:s39321","sourcePersonId":"vndb:s39321","canonicalEntityId":"vndb:s39321","name":"黒瀬 ゆづき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:91161","source":"vndb"}]},"cast":[{"characterId":"char_c12596","characterName":"アメリア＝ローズ＝ブレッティンガム","sourceIds":{"bangumi":[{"characterId":"18225","match":"exact-normalized-name-in-linked-work","subjectId":"46862"}],"egsCharacterIds":["5435"],"vndbCharacterId":"c12596"},"originalCharacterName":"アメリア＝ローズ＝ブレッティンガム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"601"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"171"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"leader of the \"Cinq roses\""}],"source":"vndb","sourceCharacterId":"c12596"},{"segments":[{"spoiler":false,"text":"類い希なる美貌と才能の持ち主で、王室内ではもちろん、社交界の花形と言われている。"},{"spoiler":false,"text":"また運動神経も良くフェンシングや乗馬など貴族の嗜み大会ではすべて優勝し、数々の栄光を手にしている。"},{"spoiler":false,"text":"自分に厳しく、他人にも厳しい。左利き。"},{"spoiler":false,"text":"自分と同程度の優秀さを執事にも求める。"},{"spoiler":false,"text":"よって執事が失敗すると容赦なく罵倒する。"},{"spoiler":false,"text":"何事も完璧にこなすことが出来るので、優秀過ぎて本人自身が毎日退屈している。"},{"spoiler":false,"text":"周囲から羨望の眼差しと恐れの意味を込めて、「冷血の薔薇姫」などと言われている。"},{"spoiler":false,"text":"「私が許可したときだけ喋りなさい」"}],"source":"egs","sourceCharacterId":"5435","sourceWorkId":"17412","spoiler":false},{"segments":[{"spoiler":false,"text":"16世紀に英国王室から分かれたブレッティンガム王国の第一王女。"},{"spoiler":false,"text":"由緒正しい王室貴族で、遠縁ながら英国王位継承権を持つプリンセス。"},{"spoiler":false,"text":"類い希なる美貌と才能の持ち主で、特に運動神経が良く、フェンシングや乗馬など貴族の嗜みといえる大会ではすべて優勝し、数々の栄光を手にしている。"},{"spoiler":false,"text":"あらゆることを完璧にこなしてしまう優秀さのため、アメリアは学園での生活に退屈している。"},{"spoiler":false,"text":"完璧主義者で他人にも自分にも厳しい。"},{"spoiler":false,"text":"執事にも自分と同じ優秀さを求めるため、些細な失敗も許さず容赦なく罵倒する。"},{"spoiler":false,"text":"周囲から羨望の眼差しと恐れの意味を込めて “冷血の薔薇姫” などと言われている。"}],"source":"bangumi","sourceCharacterId":"18225"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ceccc305e4a173198036a7528838a39d1ea852f3ed321f798f501f5204c200b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/250f74ddde1f5346574257cbb233455832ab892c0b1773a06af66bd7d7231ee8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:46862:18225:5741:1","source":"bangumi"}]},{"characterId":"char_c12598","characterName":"桂ノ宮 沙耶","sourceIds":{"bangumi":[{"characterId":"18226","match":"exact-normalized-name-in-linked-work","subjectId":"46862"}],"egsCharacterIds":["5439"],"vndbCharacterId":"c12598"},"originalCharacterName":"桂ノ宮 沙耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"普段はクールなＳお嬢様だが、幼馴染で年上の主人公と二人っきりになると甘え始める妹キャラ。"},{"spoiler":false,"text":"一見すると二重人格と思えるくらいに性格が切り替わる。"},{"spoiler":false,"text":"今年から自分も「桂ノ宮学園」の生徒になったので、誰にも負けない一流のレディになろうと張り切っている。"},{"spoiler":false,"text":"元々Ｓ気質だが、主人公の前だけワガママ甘えん坊Ｍになる。表と裏のギャップが激しい。"},{"spoiler":false,"text":"周囲から「太陽と月の薔薇姫」と呼ばれるほどのギャップ。"},{"spoiler":false,"text":"なんでもできる（アメリアのような天才気質と違って、努力家タイプの天才）が、主人公と二人っきりだと何もできないと言い張る。"},{"spoiler":false,"text":"そして主人公に全てやってもらって、甘えて、構ってもらうことを至高としている。"},{"spoiler":false,"text":"だが、そこへ誰かがやってくると、急にしゃんとして表の顔になる。"},{"spoiler":false,"text":"「お兄様、お願いそばにいて。沙耶、もっといい子になるから」"}],"source":"egs","sourceCharacterId":"5439","sourceWorkId":"17412","spoiler":false},{"segments":[{"spoiler":false,"text":"代々身分の高い女子をエリート教育して、国内はもちろん世界でも通用する一人前のレディに育て上げる伝統と格式ある 『桂ノ宮学園』 の創始者である桂ノ宮家の一人娘。"},{"spoiler":false,"text":"普段はクールなお嬢様だが、幼なじみでもある主人公と二人っきりになると二重人格と思えるくらいに甘えてくる。"},{"spoiler":false,"text":"時々主人公に甘えすぎて、急に誰かがやってきても表の顔が間に合わない時がある。"},{"spoiler":false,"text":"周囲から “太陽と月の薔薇姫” と呼ばれているのは、沙耶の気性である表と裏のギャップが激しいためとか。"}],"source":"bangumi","sourceCharacterId":"18226"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a243c9439adf1e8e03f3f71a883295ea70583a1a51cb2f3004cbaddfc00af0c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e44ef49627d54ad31de32496e20448ac3c5e8bbf101c37310f7c4693cd30868.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:46862:18226:5020:1","source":"bangumi"}]},{"characterId":"char_c12599","characterName":"真姫＝ゴールド＝ウィーンバーグ","sourceIds":{"bangumi":[{"characterId":"18227","match":"exact-normalized-name-in-linked-work","subjectId":"46862"}],"egsCharacterIds":["5436"],"vndbCharacterId":"c12599"},"originalCharacterName":"真姫＝ゴールド＝ウィーンバーグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"808"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼い頃から父親の影響で武道を嗜み、時代劇や侍魂を勝手に身につけていた。"},{"spoiler":false,"text":"（父親も好きだし、実際侍役で時代劇ドラマにも出演していたのでそういったドラマを見るのも好きだった）"},{"spoiler":false,"text":"だが10歳くらいに母親のような女優になりたいと志す。母親も大賛成。"},{"spoiler":false,"text":"しかし、身についているのは武道やら侍魂だけで女優になるスキルは何も持っていない。"},{"spoiler":false,"text":"（お嬢様ではあるので、それなりにプライドはある）"},{"spoiler":false,"text":"そこで、母親がこの学校に入学させた。"},{"spoiler":false,"text":"もともと覚えはいいので、きちんと習えばすぐに習得できるのだが、染みついた習慣（言い方や物の考えなど）はすぐには直らない。"},{"spoiler":false,"text":"凛とした立ち姿や物腰から『秀麗の薔薇姫』と呼ばれている。"},{"spoiler":false,"text":"「私としたことが、なんたる失態。かくなる上は切腹して詫びるしか……！」"}],"source":"egs","sourceCharacterId":"5436","sourceWorkId":"17412","spoiler":false},{"segments":[{"spoiler":false,"text":"母親は誰もがその名前を知っている世界的にも有名な大物映画女優、父親も世界最強と名高い日本の武道家。"},{"spoiler":false,"text":"幼い頃から武道を嗜み、時代劇が好きで侍魂を持つ大和撫子お嬢様。"},{"spoiler":false,"text":"将来は母親のような女優になりたいと考えており、その過程として学園へと入学した。"},{"spoiler":false,"text":"一本気でマジメ。 凛として格好良いスタイルから “秀麗の薔薇姫” と呼ばれており、女子学生たちから “お姉様” と慕われ人気がある （真姫に本気で恋心を抱く女子学生多数）。"},{"spoiler":false,"text":"自らにも周囲にも厳しいSな人だと周囲から思われているが……。"}],"source":"bangumi","sourceCharacterId":"18227"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be3bc278c2540f08c0e4175259ef7d6d8fbe621e2203bcfab07f1ecea3d7109c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29717a6016915a902babd80fe46757ad78e1d77fd048a4175cc010a9fa99c61b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:46862:18227:4832:1","source":"bangumi"}]},{"characterId":"char_c12600","characterName":"ベロニカ＝ルーベンシュタット","sourceIds":{"bangumi":[{"characterId":"18228","match":"exact-normalized-name-in-linked-work","subjectId":"46862"}],"egsCharacterIds":["5437"],"vndbCharacterId":"c12600"},"originalCharacterName":"ベロニカ＝ルーベンシュタット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"512"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"昔から男性が苦手で家に執事がいない。メイドのみ。"},{"spoiler":false,"text":"だが、それでは立派なレディになれないということで、ほぼ強制的に親にこの学校に入れられた。"},{"spoiler":false,"text":"男性に半径2メートル以内に近づかれると、過剰に反応してしまい、磁石の同じ極を近づけたときのように、つい逃げてしまう。"},{"spoiler":false,"text":"そこにお嬢様というプライドもあって、テンパると言い方がきつくなってしまう。"},{"spoiler":false,"text":"そんな自分に気づき、しょんぼりしてしまう。"},{"spoiler":false,"text":"周囲から「戒律の薔薇姫」と呼ばれ、少々敬遠する人もいる。"},{"spoiler":false,"text":"「どうして……椿さんに言われると、身体が甘く痺れてゾクゾクしてしまう……私は悪い子です」"}],"source":"egs","sourceCharacterId":"5437","sourceWorkId":"17412","spoiler":false},{"segments":[{"spoiler":false,"text":"法王の血を引く母と大司教である父を持ち、本人も敬虔なクリスチャンであるお嬢様。"},{"spoiler":false,"text":"幼い頃より父以外の男性が苦手で、2メートル以内に近づかれると逃げ出してしまう。"},{"spoiler":false,"text":"それでは立派なレディになれないということで、男性嫌いを治し、レディとしての品格をより磨くため強制的に両親によって学園に入学させられた。"},{"spoiler":false,"text":"努力家で、異性に対する過剰反応を自分でもなんとかしたいと思っている。"},{"spoiler":false,"text":"信心深く、マジメで堅物で、まるで融通が利かない。"},{"spoiler":false,"text":"周囲から “戒律の薔薇姫” と呼ばれており、敬遠する人もいる。"}],"source":"bangumi","sourceCharacterId":"18228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f96089c1504595b89a9de33d7001b49386713dbd53b26ae2e61a5b8fdc15aed0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e399b8022a3b4a3f93133b269d9a8eff3c539face31d0f21e5aee2f5a91c4a87.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:46862:18228:5922:1","source":"bangumi"}]},{"characterId":"char_c12601","characterName":"一乗寺 由良","sourceIds":{"bangumi":[{"characterId":"18229","match":"exact-normalized-name-in-linked-work","subjectId":"46862"}],"egsCharacterIds":["5438"],"vndbCharacterId":"c12601"},"originalCharacterName":"一乗寺 由良","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"915"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only daughter of one of Japan's three major financial conglomerates, \"Ichiouji Zaibatsu\". The Ichijouji family has a high status and history, being the founder of the Ichijouji Bank which has countless branches overseas."},{"spoiler":false,"text":"Yura is a pampered girl who likes being a little mischievous."},{"spoiler":false,"text":"While walking around school with the protagonist, she suddenly grabs his arm which surprises the students around them. Since the protagonist got a bit worried, she starts to mischievously get a bigger reaction out of him by getting even physically closer to him."},{"spoiler":false,"text":"She is a pampered girl who is very cheerful and goes at her own pace. She's also known and idolized as the \"Whimsy Rose Princess\"."},{"spoiler":false,"text":"\"I like Tsubaki-san's troubled gentle smile. I want to trouble you even more. Am I not allowed to?\""}],"source":"vndb","sourceCharacterId":"c12601"},{"segments":[{"spoiler":false,"text":"ちょっとしたいたずたらが好き（他人を傷つけるようないたずらはしない）。"},{"spoiler":false,"text":"学園内を主人公と歩いていて周りの注目を浴びている時、突然主人公と腕を組んで、周りにいる生徒たちを驚かせたりする。"},{"spoiler":false,"text":"その時の困った顔を浮かべた主人公を（自分でもなぜかわからないが）気に入ってしまい、主人公を困らせるために、スキンシップの激しいイタズラをしてくる。"},{"spoiler":false,"text":"「太ももを虫に刺されてしまったようなんです」とガーターベルト太ももをちらりと見せたり……。"},{"spoiler":false,"text":"良く笑う明るいマイペースお嬢様。"},{"spoiler":false,"text":"周囲から「気まぐれの薔薇姫」と呼ばれ慕われている。"},{"spoiler":false,"text":"「椿さんの困ったような優しい笑顔、好きです。もっと困らせてしまいたくなります。いけませんか？」"}],"source":"egs","sourceCharacterId":"5438","sourceWorkId":"17412","spoiler":false},{"segments":[{"spoiler":false,"text":"国内三大財閥の一つ 『一乗寺財閥』 の一人娘。"},{"spoiler":false,"text":"一乗寺家は歴史と格式ある一族で、現在は海外にも数えきれないほどの支店がある一乗寺銀行の創始者。"},{"spoiler":false,"text":"由良お嬢様は、ちょっとしたイタズラが好き。"},{"spoiler":false,"text":"学園内を主人公と歩いていて周りの注目を浴びている時、突然主人公と腕を組んで周りにいる学生たちを驚かせたりする。"},{"spoiler":false,"text":"その時の困った顔を浮かべた主人公を気に入ってしまい、主人公を困らせるためにスキンシップの激しいイタズラをしてくる。"},{"spoiler":false,"text":"よく笑う明るいマイペースお嬢様で、周囲から “気まぐれの薔薇姫” と呼ばれ慕われている。"}],"source":"bangumi","sourceCharacterId":"18229"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a301cd4f7f12aee40d6bf673d44bdd9dc130f7f2b73152d6f936a5fcb9a77c44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87e5e046b5d176d3ce4711b71ebd23d5b69d559ad099fee8605d8a207d445a2a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:46862:18229:4956:1","source":"bangumi"}]},{"characterId":"char_vndb_c12602","characterName":"椿 尚弥","sourceIds":{"vndbCharacterId":"c12602"},"originalCharacterName":"椿 尚弥","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c12603","characterName":"ドリス＝バターカップ","sourceIds":{"vndbCharacterId":"c12603"},"originalCharacterName":"ドリス＝バターカップ","characterNameSo