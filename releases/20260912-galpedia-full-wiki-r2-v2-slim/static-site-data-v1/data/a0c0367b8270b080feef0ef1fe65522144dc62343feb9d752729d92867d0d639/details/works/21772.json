oiler":false,"text":"たまに変な仮面で現れる。"},{"spoiler":false,"text":"「わたしが、天使？　あははは…… んー、半分正解。 でも、半分ハズレかな」"}],"source":"bangumi","sourceCharacterId":"34381"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/eddf29652a09dcf2c8ff28825cefc296c980b3f99c67263e3cce76bd40b501ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d202038b5e3cad9bcaec8939dcb5e819f780a04bf76c5f2a017403ad2b88c5f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安藤知花","creatorId":"vndb:s2001","sourcePersonId":"vndb:s2001","canonicalEntityId":"vndb:s2001","name":"早崎 千香子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128764:34381:19106:1","source":"bangumi"}]},{"characterId":"char_c31682","characterName":"陽下弦 ヨワメ","sourceIds":{"bangumi":[{"characterId":"34382","match":"exact-normalized-name-in-linked-work","subjectId":"128764"}],"egsCharacterIds":["6304"],"vndbCharacterId":"c31682"},"originalCharacterName":"陽下弦 ヨワメ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも無表情でなんでも出来るイメージのある、メガネの生徒会書記"},{"spoiler":false,"text":"仕事がない限り、生徒会室にはいない、無駄なことはしないタイプ"},{"spoiler":false,"text":"なゆの従姉で、生徒会の用事が無い時は、大黒天神社で巫女をしている"},{"spoiler":false,"text":"なゆが大好き"}],"source":"egs","sourceCharacterId":"6304","sourceWorkId":"21772","spoiler":false},{"segments":[{"spoiler":false,"text":"いつも無表情で、何でもできるイメージのあるメガネの生徒会書記。"},{"spoiler":false,"text":"無駄なことはしないタイプで、仕事がなければ生徒会室にはいない。"},{"spoiler":false,"text":"なゆの従姉で、生徒会の用事がない時は大黒天神社で巫女をしている。"},{"spoiler":false,"text":"なゆが大好き。"},{"spoiler":false,"text":"「……三ヶ月君、あなたの運命は、とても面白いわ」"}],"source":"bangumi","sourceCharacterId":"34382"}],"profileFacts":[],"metadataCand