204402","source":"vndb"},{"creditedName":"月見山 みち","creatorId":"vndb:s25971","sourcePersonId":"vndb:s25971","canonicalEntityId":"vndb:s25971","name":"月見山 みち","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204405","source":"vndb"},{"creditedName":"浅黄 アキ","creatorId":"vndb:s26587","sourcePersonId":"vndb:s26587","canonicalEntityId":"vndb:s26587","name":"浅黄 アキ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204407","source":"vndb"},{"creditedName":"ねこ","creatorId":"vndb:s32372","sourcePersonId":"vndb:s32372","canonicalEntityId":"vndb:s32372","name":"ねこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204409","source":"vndb"},{"creditedName":"井上","creatorId":"vndb:s32378","sourcePersonId":"vndb:s32378","canonicalEntityId":"vndb:s32378","name":"井上","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204410","source":"vndb"},{"creditedName":"鳥島 烏","creatorId":"vndb:s36268","sourcePersonId":"vndb:s36268","canonicalEntityId":"vndb:s36268","name":"鳥島烏","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204411","source":"vndb"},{"creditedName":"カズタ シンヤ","creatorId":"vndb:s36904","sourcePersonId":"vndb:s36904","canonicalEntityId":"vndb:s36904","name":"カズタシンヤ(数田伸也)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204412","source":"vndb"},{"creditedName":"タハラ 白樹","creatorId":"vndb:s21315","sourcePersonId":"vndb:s21315","canonicalEntityId":"vndb:s21315","name":"タハラ 白樹","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204414","source":"vndb"}]},"cast":[{"characterId":"char_c135123","characterName":"スレン・アイリーク","sourceIds":{"bangumi":[{"characterId":"152578","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25741"],"vndbCharacterId":"c135123"},"originalCharacterName":"スレン・アイリーク","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Leave it to me. I'm a Great Sorcerer (Wizard) in a league of my own—\""},{"spoiler":false,"text":"Sreng is a fresh face at Einsel Magic Academy. Though unremarkable as a mage, he's got a razor-sharp tactical mind and a knack for thinking outside the box."},{"spoiler":false,"text":"Driven by a desire to become a hero and protect what he holds dear, Sreng earned the right to contract with Lia, one of the \"Fairy Brides.\" This achievement has thrust him into the spotlight, attracting a mix of intrigue and envy from his peers across the academy."},{"spoiler":false,"text":"Typically, Sreng exudes confidence and affability, with a sunny disposition that draws others to him. However, he occasionally surprises himself with flashes of cold detachment, moments that leave him perplexed by the complexities of his own nature."},{"spoiler":false,"text":"Translated and edited from the official website"},{"spoiler":true,"text":"Alard is Sreng's alternative persona, Lumiaria's loved one before she was turned into the Bride, Ria."}],"source":"vndb","sourceCharacterId":"c135123"},{"segments":[{"spoiler":false,"text":"エインセル魔術学院に入学したばかりの学生。"},{"spoiler":false,"text":"魔術士としては凡庸ながら、優れた戦術眼と奇策を打ち出す頭脳を持つ。"},{"spoiler":false,"text":"大切なものを守るために英雄になることを志しており、「妖精の花嫁」であるリアの契約者となる権利を勝ち取った。"},{"spoiler":false,"text":"そのために学院中から好奇と嫉妬の目で見られるようになる。"},{"spoiler":false,"text":"普段は明朗快活な自信家で人当たりがよいが、不意に冷めた態度を覗かせる自分自身に戸惑うことがある。"}],"source":"egs","sourceCharacterId":"25741","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"「任せておけ。この万夫不当の《大魔術士（ウィザード）》にな？」"},{"spoiler":false,"text":"エインセル魔術学院に入学したばかりの学生。"},{"spoiler":false,"text":"魔術士としては凡庸ながら、優れた戦術眼と奇策を打ち出す頭脳を持つ。"},{"spoiler":false,"text":"大切なものを守るために英雄になることを志しており、"},{"spoiler":false,"text":"「妖精の花嫁」であるリアの契約者となる権利を勝ち取った。"},{"spoiler":false,"text":"そのために学院中から好奇と嫉妬の目で見られるようになる。"},{"spoiler":false,"text":"普段は明朗快活な自信家で人当たりがよいが、"},{"spoiler":false,"text":"不意に冷めた態度を覗かせる自分自身に戸惑うことがある。"}],"source":"bangumi","sourceCharacterId":"152578"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93d6b4c3173f66fe0e10100a6b9eb7d78e35a081f5a0bd778eef366d512ddabd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ca2b58f63a0bb0dabf59fe13eba6b3df270a5cc8bf4276f90f83598e3d05469.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北山恭祐","creatorId":"vndb:s5570","sourcePersonId":"vndb:s5570","canonicalEntityId":"vndb:s5570","name":"北山 恭祐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152578:20510:1","source":"bangumi"}]},{"characterId":"char_c135124","characterName":"リア","sourceIds":{"bangumi":[{"characterId":"152575","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25738"],"vndbCharacterId":"c135124"},"originalCharacterName":"リア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Yeah. I wish to remain by your side, walking together with you, forever.\""},{"spoiler":false,"text":"Lia stands among the \"Fairy Brides,\" guardians of the Midyr Holy Church. Her battle prowess is second to none, earning her the title \"Bride of the Rising Sun.\" True to her moniker, Lia commands powerful magic that radiates with blinding brilliance."},{"spoiler":false,"text":"This girl's as straight as an arrow - earnest, just, and wears her heart on her sleeve. Yet, with her past a blank slate, Lia's a bit out of touch with the world. After losing her previous contractor in battle, she fell into a deep slumber within her ring. Now she's back in action, tagging along with Sreng, who's proved he's got what it takes to be her new partner."},{"spoiler":false,"text":"Translated and edited from the official website"},{"spoiler":true,"text":"Her true name is Lumiaria."}],"source":"vndb","sourceCharacterId":"c135124"},{"segments":[{"spoiler":false,"text":"ミディール聖教会の守護者である「妖精の花嫁」の一人。"},{"spoiler":false,"text":"最も優れた戦果を誇り、「旭光の花嫁」の二つ名を持つ。"},{"spoiler":false,"text":"二つ名の通り、鮮烈な光による強大な魔法を得意とする。"},{"spoiler":false,"text":"生真面目で正義感が強く、とても真っ直ぐな性格。"},{"spoiler":false,"text":"過去の記憶を持っていないせいか、少し浮世離れしている。"},{"spoiler":false,"text":"先の契約者が戦死したため指輪の中で眠りに就いていたが、資格を得たスレンと契約することで、以降は彼に付き従う。"}],"source":"egs","sourceCharacterId":"25738","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"「うん。いつまでも貴方の傍で、一緒に歩いていきたいの」"},{"spoiler":false,"text":"ミディール聖教会の守護者である「妖精の花嫁」の一人。"},{"spoiler":false,"text":"最も優れた戦果を誇り、「旭光の花嫁」の二つ名を持つ。"},{"spoiler":false,"text":"二つ名の通り、鮮烈な光による強大な魔法を得意とする。"},{"spoiler":false,"text":"生真面目で正義感が強く、とても真っ直ぐな性格。"},{"spoiler":false,"text":"過去の記憶を持っていないせいか、少し浮世離れしている。"},{"spoiler":false,"text":"先の契約者が戦死したため指輪の中で眠りに就いていたが、"},{"spoiler":false,"text":"資格を得たスレンと契約することで、以降は彼に付き従う。"}],"source":"bangumi","sourceCharacterId":"152575"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0bf1423cc931e7f66a2ff562b3b2ce0b42d435698e5e2621e3f35c4ae221b86.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0be05b67808b5c0e406f55eaa2677a56a4fb60691a9202a42b3de56f48858dde.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎未來","creatorId":"vndb:s986","sourcePersonId":"vndb:s986","canonicalEntityId":"vndb:s986","name":"尾崎 未來","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152575:13776:1","source":"bangumi"}]},{"characterId":"char_c135125","characterName":"クロエ・ルーアン","sourceIds":{"bangumi":[{"characterId":"152576","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25739"],"vndbCharacterId":"c135125"},"originalCharacterName":"クロエ・ルーアン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Eek!? D-Do you need something from me......?\""},{"spoiler":false,"text":"Chloe's the youngest student in the magic academy's history, and she's got a full plate. She's not just hitting the books - she's also Princess Fine's shadow, playing the role of a loyal attendant. When it comes to people, Chloe's as shy as they come, with a timid streak a mile wide. Looks like she drew the short straw in the health department too, often seeming under the weather."},{"spoiler":false,"text":"But don't let that fool you - this girl's got her nose in the books more than most. She's a walking encyclopedia on magic and old legends. In class, she flies under the radar, but word on the street is she might be keeping her true skills under wraps."},{"spoiler":false,"text":"Translated and edited from the official website"},{"spoiler":true,"text":"Her true name is Croche."}],"source":"vndb","sourceCharacterId":"c135125"},{"segments":[{"spoiler":false,"text":"魔術学院に通う、学院史上最年少の学生。"},{"spoiler":false,"text":"常に王女フィーネに付き従う、忠実な付き人でもある。"},{"spoiler":false,"text":"非常に人見知りが激しく、とても臆病な性格。"},{"spoiler":false,"text":"身体が弱いらしく、頻繁に具合が悪そうにしている。"},{"spoiler":false,"text":"人一倍勉強家で、魔術や古い伝承への造詣が深い。"},{"spoiler":false,"text":"授業では目立たないが、一部では実力を隠しているとも噂されている。"}],"source":"egs","sourceCharacterId":"25739","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"「ひゃいっ！？　わ、わたしなんかに何か御用ですか……？」"},{"spoiler":false,"text":"魔術学院に通う、学院史上最年少の学生。"},{"spoiler":false,"text":"常に王女フィーネに付き従う、忠実な付き人でもある。"},{"spoiler":false,"text":"非常に人見知りが激しく、とても臆病な性格。"},{"spoiler":false,"text":"身体が弱いらしく、頻繁に具合が悪そうにしている。"},{"spoiler":false,"text":"人一倍勉強家で、魔術や古い伝承への造詣が深い。"},{"spoiler":false,"text":"授業では目立たないが、一部では実力を隠しているとも噂されている。"}],"source":"bangumi","sourceCharacterId":"152576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7de4b653f8f1b7678f2b1fd8dab0adc12e6d17f78ee9105a06bb4ed94c37f153.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed949511646f3a8763e5cca1d9751581486ce17c56fbccf9d314a3f6dad3d7ab.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152576:32998:1","source":"bangumi"}]},{"characterId":"char_c135126","characterName":"アルフィーネ・ミディール","sourceIds":{"bangumi":[{"characterId":"152577","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25740"],"vndbCharacterId":"c135126"},"originalCharacterName":"アルフィーネ・ミディール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Geez, how mean. Despite everything, I'm still a proper princess, you know?\""},{"spoiler":false,"text":"Meet Fine, the nickname of Princess Midyr, who's making waves at the magic academy. She's got royal blood running through her veins, with connections in high places - her aunt's the Archbishop Mira, and she goes way back with her cousin Henrietta (Mira's daughter). Fine's not just any student; she's the cream of the crop, especially when it comes to healing magic - the royal family's claim to fame."},{"spoiler":false,"text":"Growing up in a monastery left her with deep faith, but don't let that fool you. She's mature and graceful one minute, friendly and mischievous the next. As a princess, she's a bit off the beaten path. Her unique take on things earns respect, but keeps people at arm's length. In the end, Fine's admired but hard to pin down - a royal enigma in a class of her own."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c135126"},{"segments":[{"spoiler":false,"text":"愛称はフィーネ。"},{"spoiler":false,"text":"魔術学院に通う学生であり、ミディール王女。"},{"spoiler":false,"text":"同じく王族の血筋である大司教ミラは叔母にあたり、ミラの娘で従姉妹であるアンリエッタとは旧知の仲。"},{"spoiler":false,"text":"優秀な模範生で、王族の象徴とされる治癒魔術の随一の使い手。"},{"spoiler":false,"text":"幼い頃から大修道院で育ったため、とても信心深い。"},{"spoiler":false,"text":"大人びていて気品に溢れていながら、気さくで悪戯っぽい性格。"},{"spoiler":false,"text":"王女としては風変わりなところがあり、独特の感性を持つせいか、人々からは尊敬されながらも一定の距離を置かれている。"}],"source":"egs","sourceCharacterId":"25740","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"「あん、ひどい。これでもちゃんと王女なのよ？」"},{"spoiler":false,"text":"愛称はフィーネ。"},{"spoiler":false,"text":"魔術学院に通う学生であり、ミディール王女。"},{"spoiler":false,"text":"同じく王族の血筋である大司教ミラは叔母にあたり、"},{"spoiler":false,"text":"ミラの娘で従姉妹であるアンリエッタとは旧知の仲。"},{"spoiler":false,"text":"優秀な模範生で、王族の象徴とされる治癒魔術の随一の使い手。"},{"spoiler":false,"text":"幼い頃から大修道院で育ったため、とても信心深い。"},{"spoiler":false,"text":"大人びていて気品に溢れていながら、気さくで悪戯っぽい性格。"},{"spoiler":false,"text":"王女としては風変わりなところがあり、独特の感性を持つせいか、"},{"spoiler":false,"text":"人々からは尊敬されながらも一定の距離を置かれている。"}],"source":"bangumi","sourceCharacterId":"152577"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9df38ec5a6b078c2706b5ee2cf9d7b4f17ed0f175be1830c44f9e86ebe8d62d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1d54d8094a4981f717a3f2b7ace1b367aa428ad295f774e13943838e01ec304.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152577:20696:1","source":"bangumi"}]},{"characterId":"char_c135513","characterName":"ミラ・ローゼス","sourceIds":{"bangumi":[{"characterId":"152865","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25742"],"vndbCharacterId":"c135513"},"originalCharacterName":"ミラ・ローゼス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I ask of you, from now on, please cultivate your bond.\""},{"spoiler":false,"text":"The Archbishop and head of the Holy Church, and the principal of the Academy of Magic. Her title is equal to the King of Midir, more important than him even."},{"spoiler":false,"text":"She is kind and compassionate like a saint, but also merciless when punishing the foreign enemies who threaten the Holy Church."},{"spoiler":false,"text":"After learning of Sreng's ability, she sees him as a Hero of the next generation, and entrusts him with the Bride Lia."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c135513"},{"segments":[{"spoiler":false,"text":"聖教会の最高指導者である大司教にして、魔術学院の学長。"},{"spoiler":false,"text":"ミディール聖教国にとって国王と並ぶか、それ以上の重要人物。"},{"spoiler":false,"text":"穏やかで慈悲深い聖母のような性格だが、聖教会を脅かす外敵に対しては容赦なく処断する苛烈さも持つ。"},{"spoiler":false,"text":"実力を示したスレンのことを次代の英雄として目に掛けており、妖精の花嫁であるリアを託す。"}],"source":"egs","sourceCharacterId":"25742","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"聖教会の最高指導者である大司教にして、魔術学院の学長。"},{"spoiler":false,"text":"ミディール聖教国にとって国王と並ぶか、それ以上の重要人物。"},{"spoiler":false,"text":"穏やかで慈悲深い聖母のような性格だが、"},{"spoiler":false,"text":"聖教会を脅かす外敵に対しては容赦なく処断する苛烈さも持つ。"},{"spoiler":false,"text":"実力を示したスレンのことを次代の英雄として目に掛けており、"},{"spoiler":false,"text":"妖精の花嫁であるリアを託す。"}],"source":"bangumi","sourceCharacterId":"152865"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79fc2389d9e9b71f35c65ab549afe4d507381cfcbaa1d95eb6986da27f516b09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35ea0d5b0baeff6d33533fc6493d779329270e8125dced2e2aabb7e301283932.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152865:8493:1","source":"bangumi"}]},{"characterId":"char_c135514","characterName":"ルシエラ・リーガル","sourceIds":{"bangumi":[{"characterId":"152867","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25743"],"vndbCharacterId":"c135514"},"originalCharacterName":"ルシエラ・リーガル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Those who defy the Archbishop, no matter who they are, I'll kill them.\""},{"spoiler":false,"text":"The partner of Lavi the Bride, and a teacher at the academy."},{"spoiler":false,"text":"She is the leader of the Order of Mages affiliated with the Holy Church, and serves as an assistant to the Archbishop as well. A strict female knight, absolutely loyal to the Archbishop."},{"spoiler":false,"text":"Having achieved success on many battlefields, accompanied by her bride, she is regarded as a Hero. The Archbishop has complete trust in her, and she is also known as the \"Silver's Left Arm.\""},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c135514"},{"segments":[{"spoiler":false,"text":"妖精の花嫁であるラヴィのパートナーで、学院の教師。"},{"spoiler":false,"text":"聖教会が擁する魔術士団の団長であり、大司教補佐も務める。"},{"spoiler":false,"text":"大司教に絶対の忠誠を捧げる厳格な騎士のような女性。"},{"spoiler":false,"text":"戦場で花嫁を伴い多大な戦果を挙げた英雄として有名。"},{"spoiler":false,"text":"大司教からも信頼を置かれており、「銀の左腕」の二つ名を持つ。"}],"source":"egs","sourceCharacterId":"25743","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"妖精の花嫁であるラヴィのパートナーで、学院の教師。"},{"spoiler":false,"text":"聖教会が擁する魔術士団の団長であり、大司教補佐も務める。"},{"spoiler":false,"text":"大司教に絶対の忠誠を捧げる厳格な騎士のような女性。"},{"spoiler":false,"text":"戦場で花嫁を伴い多大な戦果を挙げた英雄として有名。"},{"spoiler":false,"text":"大司教からも信頼を置かれており、「銀の左腕」の二つ名を持つ。"}],"source":"bangumi","sourceCharacterId":"152867"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/961f75cc48affed860e66063675741ff129c446eea8fe97160a28c681fd3c588.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25664105c982feb638daf870faefa102a898b8872191f58d149d183e740fb535.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加々美澪","creatorId":"vndb:s17936","sourcePersonId":"vndb:s17936","canonicalEntityId":"vndb:s17936","name":"加々美澪","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152867:33435:1","source":"bangumi"}]},{"characterId":"char_c135515","characterName":"メル","sourceIds":{"bangumi":[{"characterId":"152868","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25744"],"vndbCharacterId":"c135515"},"originalCharacterName":"メル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Here, there's one. Leave this to me!\""},{"spoiler":false,"text":"One of the Brides. She is partnered with the teacher Clive."},{"spoiler":false,"text":"Crushing the enemies with her raging flame, the wielder of \"Hellfire.\" She has outstanding fight skills, dashing across the battlefield with her agile and daring movements."},{"spoiler":false,"text":"Cheerful and lively, no opposite personalities so to speak, she is very much a pleasant woman. But she tends to get emotional, a meathead type, not good at using her head. She and Clive have a sibling-like relationship, and he is under her thumb."},{"spoiler":false,"text":"She cares about Lia, who has just woken up, and also has a good relationship Lia's bearer Sreng."},{"spoiler":false,"text":"Translated and edited from the official website"},{"spoiler":true,"text":"Her true name is Melty."}],"source":"vndb","sourceCharacterId":"c135515"},{"segments":[{"spoiler":false,"text":"妖精の花嫁の一人。"},{"spoiler":false,"text":"教師クライヴのパートナーである花嫁。"},{"spoiler":false,"text":"苛烈な炎で敵を粉砕する「業火」の使い手。"},{"spoiler":false,"text":"体術も得意としており、俊敏かつ大胆な動きで戦場を駆ける。"},{"spoiler":false,"text":"明るく活発、裏表がなく大雑把という、すこぶる気持ちのいい性格。"},{"spoiler":false,"text":"感情的になりやすい脳筋タイプで、頭を使うのは苦手。"},{"spoiler":false,"text":"クライヴとは兄妹のような関係で、彼を尻に敷いている。"},{"spoiler":false,"text":"目覚めたばかりのリアのことを気にかけており、"},{"spoiler":false,"text":"リアの担い手であるスレンとも良好な関係を築く。"}],"source":"egs","sourceCharacterId":"25744","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"妖精の花嫁の一人。"},{"spoiler":false,"text":"教師クライヴのパートナーである花嫁。"},{"spoiler":false,"text":"苛烈な炎で敵を粉砕する「業火」の使い手。"},{"spoiler":false,"text":"体術も得意としており、俊敏かつ大胆な動きで戦場を駆ける。"},{"spoiler":false,"text":"明るく活発、裏表がなく大雑把という、すこぶる気持ちのいい性格。"},{"spoiler":false,"text":"感情的になりやすい脳筋タイプで、頭を使うのは苦手。"},{"spoiler":false,"text":"クライヴとは兄妹のような関係で、彼を尻に敷いている。"},{"spoiler":false,"text":"目覚めたばかりのリアのことを気にかけており、"},{"spoiler":false,"text":"リアの担い手であるスレンとも良好な関係を築く。"}],"source":"bangumi","sourceCharacterId":"152868"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19afabc6d81cb11b6025f3dd1e91c15dd39e896d4078d58572a7c00a8dfc4b7a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab583efbb54940d625df13c9ffbfae3072a7119a7b7bb9a19c0bcd7c07299d07.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ふじたまみ","creatorId":"vndb:s7951","sourcePersonId":"vndb:s7951","canonicalEntityId":"vndb:s7951","name":"ふじた まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152868:23302:1","source":"bangumi"},{"creditedName":"八ッ橋 しなもん","creatorId":"vndb:s11591","sourcePersonId":"vndb:s11591","canonicalEntityId":"vndb:s11591","name":"八ッ橋しなもん(朔白)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97216","source":"vndb"}]},{"characterId":"char_c135516","characterName":"ラヴィ","sourceIds":{"bangumi":[{"characterId":"152870","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25745"],"vndbCharacterId":"c135516"},"originalCharacterName":"ラヴィ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Such an annoying insect. Wouldn't it be better if it is crushed.\""},{"spoiler":false,"text":"One of the Brides. She is partnered with the teacher Luciela."},{"spoiler":false,"text":"Laying waste to her surroundings, manipulating the \"Gravity\" at her disposal. Wielding a huge hammer that exceeds her height, she is not afraid of anything."},{"spoiler":false,"text":"Like a doll, she looks pretty and quiet, but she is actually rather sharp-tongued, not opening up to others, and does not want to interact with them."},{"spoiler":false,"text":"However, she is very fond of her bearer Luciela, without hesitation, she would do anything for her."},{"spoiler":false,"text":"Translated and edited from the official website"},{"spoiler":true,"text":"Her true name is Flavia."}],"source":"vndb","sourceCharacterId":"c135516"},{"segments":[{"spoiler":false,"text":"妖精の花嫁の一人。"},{"spoiler":false,"text":"教師ルシエラのパートナーである花嫁。"},{"spoiler":false,"text":"周囲を圧壊するほどの「重力」を自在に操る。"},{"spoiler":false,"text":"身の丈を超える巨大な戦鎚を振るい、何者をも恐れない。"},{"spoiler":false,"text":"人形のように物静かで可憐だが、その実はかなりの毒舌。"},{"spoiler":false,"text":"他人に心を開かず、交流を持とうとしない。"},{"spoiler":false,"text":"唯一、担い手であるルシエラにだけはよく懐いており、彼女のためなら躊躇なく何でもやってのける。"}],"source":"egs","sourceCharacterId":"25745","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"妖精の花嫁の一人。"},{"spoiler":false,"text":"教師ルシエラのパートナーである花嫁。"},{"spoiler":false,"text":"周囲を圧壊するほどの「重力」を自在に操る。"},{"spoiler":false,"text":"身の丈を超える巨大な戦鎚を振るい、何者をも恐れない。"},{"spoiler":false,"text":"人形のように物静かで可憐だが、その実はかなりの毒舌。"},{"spoiler":false,"text":"他人に心を開かず、交流を持とうとしない。"},{"spoiler":false,"text":"唯一、担い手であるルシエラにだけはよく懐いており、"},{"spoiler":false,"text":"彼女のためなら躊躇なく何でもやってのける。"}],"source":"bangumi","sourceCharacterId":"152870"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5978f5ee8d919d4f029bacda8bb34c3547a6617021534c435525cb3e2518926f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c900f6cc6f2ac9a856f638f722d18d3c38b8186bb22732698d1c44ff32e29562.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152870:6509:1","source":"bangumi"}]},{"characterId":"char_c135517","characterName":"アンリエッタ・ローゼス","sourceIds":{"bangumi":[{"characterId":"152871","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25746"],"vndbCharacterId":"c135517"},"originalCharacterName":"アンリエッタ・ローゼス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Sreng Ileach! Just you wait......!"},{"spoiler":false,"text":"Henrietta is a student at the magic academy and the daughter of Archbishop Mira, boasting a noble lineage tied to the royal family. Though she goes way back with Princess Fine, Henrietta keeps her at arm's length these days. While she can be a stickler for rules and somewhat inflexible, Henrietta has a heart of gold."},{"spoiler":false,"text":"She's a top-notch student, widely favored to win the academy's dueling tournament. This victory would have qualified her to become Lia's new partner, a prestigious position. However, her dreams were dashed when Sreng crashed the party and snatched the qualification from under her nose. Henrietta has since harbored a grudge against Sreng, constantly finding ways to butt heads with him."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c135517"},{"segments":[{"spoiler":false,"text":"魔術学院の学生。"},{"spoiler":false,"text":"大司教ミラの娘であり、王族に連なる高貴な身分。"},{"spoiler":false,"text":"とても優秀な成績で、学院での決闘戦における本来の優勝者。"},{"spoiler":false,"text":"お堅く融通が利かない性格だが、かなりのお人好し。"},{"spoiler":false,"text":"王女であるフィーネとは旧知の仲だが距離を置いている。"},{"spoiler":false,"text":"リアの新たな担い手になるはずだったが、突如乱入してきたスレンに敗れて資格を奪われてしまう。"},{"spoiler":false,"text":"以来、スレンを目の敵にして何かと突っかかってくる。"}],"source":"egs","sourceCharacterId":"25746","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"魔術学院の学生。"},{"spoiler":false,"text":"大司教ミラの娘であり、王族に連なる高貴な身分。"},{"spoiler":false,"text":"とても優秀な成績で、学院での決闘戦における本来の優勝者。"},{"spoiler":false,"text":"お堅く融通が利かない性格だが、かなりのお人好し。"},{"spoiler":false,"text":"王女であるフィーネとは旧知の仲だが距離を置いている。"},{"spoiler":false,"text":"リアの新たな担い手になるはずだったが、"},{"spoiler":false,"text":"突如乱入してきたスレンに敗れて資格を奪われてしまう。"},{"spoiler":false,"text":"以来、スレンを目の敵にして何かと突っかかってくる。"}],"source":"bangumi","sourceCharacterId":"152871"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfa8e520a70cfab3f08939f8ce00afea5ef1f22dfa5b2f4a5f2c78138ecc9622.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4072fbd488a16c9cb4b2504455a428ff10822fd8cfd8c3788df5f05dca8840b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152871:17078:1","source":"bangumi"}]},{"characterId":"char_c135518","characterName":"クライヴ・バークレイ","sourceIds":{"bangumi":[{"characterId":"152873","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25747"],"vndbCharacterId":"c135518"},"originalCharacterName":"クライヴ・バークレイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Even a good-for-nothing like me once had something to protect.\""},{"spoiler":false,"text":"Clive, partner to Mel, one of the Fairy Brides, moonlights as an instructor at the academy. He's a key player in the Holy Church and second-in-command of the Mage Order. Despite these lofty credentials, Clive comes across as a diamond in the rough - a bit rough around the edges and not always reliable, but with a charm that wins people over."},{"spoiler":false,"text":"Yet there's more to Clive than meets the eye. Behind this unassuming facade lies a tactical genius known as the \"Clever General.\" While his magical abilities are nothing to write home about, leaving him a mediocre mage at best, Clive's true talent shines on the battlefield. There, he orchestrates victory through a masterful blend of unconventional strategies, weaving intricate tactical tapestries that often leave his adversaries outmaneuvered."},{"spoiler":false,"text":"Translated and edited from the official website"},{"spoiler":true,"text":"His true name is Clive Ascott, revealed at the start of Ria route."}],"source":"vndb","sourceCharacterId":"c135518"},{"segments":[{"spoiler":false,"text":"妖精の花嫁であるメルのパートナーで、学院の教師。"},{"spoiler":false,"text":"聖教会の幹部で、魔術士団の副団長も務める。"},{"spoiler":false,"text":"立場に似合わず、少々だらしがなく頼りないが、気さくで親しみやすい性格をしている。"},{"spoiler":false,"text":"その実は「智将」の二つ名を持つ戦術家にして英雄。"},{"spoiler":false,"text":"魔術が不得手で魔術士としては二流もいいところだが、戦術指揮および絡め手を用いた変則的な戦いを得意としている。"}],"source":"egs","sourceCharacterId":"25747","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"妖精の花嫁であるメルのパートナーで、学院の教師。"},{"spoiler":false,"text":"聖教会の幹部で、魔術士団の副団長も務める。"},{"spoiler":false,"text":"立場に似合わず、少々だらしがなく頼りないが、"},{"spoiler":false,"text":"気さくで親しみやすい性格をしている。"},{"spoiler":false,"text":"その実は「智将」の二つ名を持つ戦術家にして英雄。"},{"spoiler":false,"text":"魔術が不得手で魔術士としては二流もいいところだが、"},{"spoiler":false,"text":"戦術指揮および絡め手を用いた変則的な戦いを得意としている。"}],"source":"bangumi","sourceCharacterId":"152873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a702b7ed07f825bc9cc0dc33d27ac2db756482cab352713cbbdb68e6470d9032.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb6ec2a4e5dcc2f548649b910602f228c0767a2fcc1a7a801910c34d5ee16424.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やまなか正之","creatorId":"vndb:s23805","sourcePersonId":"vndb:s23805","canonicalEntityId":"vndb:s23805","name":"やまなか正之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152873:33083:1","source":"bangumi"}]},{"characterId":"char_c135519","characterName":"オンベルト・バランタイン","sourceIds":{"bangumi":[{"characterId":"152875","match":"exact-normalized-name-in-linked-work","subjectId":"479896"}],"egsCharacterIds":["25748"],"vndbCharacterId":"c135519"},"originalCharacterName":"オンベルト・バランタイン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Good. Now, let me give you a lecture.\""},{"spoiler":false,"text":"An academy instructor and senior member of the Holy Church. His unmatched expertise in magic and fairies has made him the most renowned \"Wizard\" of his generation. Yet he's also remarkably virtuous—perhaps the most devout person you'll find."},{"spoiler":false,"text":"He takes his teaching role to heart and, surprisingly, has a genuine fondness for children and looks after them well. The only problem is he tends to get carried away with his lectures, often oblivious to whether his audience is keeping up or has had enough."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c135519"},{"segments":[{"spoiler":false,"text":"学院で教鞭をとる教師であり、聖教会の幹部。"},{"spoiler":false,"text":"魔術と妖精への尋常ならざる造詣の深さから、当代最高の「大魔術士（ウィザード）」として名高い。"},{"spoiler":false,"text":"同時に、誰よりも善良で敬虔すぎる宗教者でもある。"},{"spoiler":false,"text":"教師としての役割に忠実で、意外にも子供好きかつ面倒見が良いが、相手の都合は目に入らないことが多く、独りよがりな講義を与えることが多々ある。"}],"source":"egs","sourceCharacterId":"25748","sourceWorkId":"36003","spoiler":false},{"segments":[{"spoiler":false,"text":"学院で教鞭をとる教師であり、聖教会の幹部。"},{"spoiler":false,"text":"魔術と妖精への尋常ならざる造詣の深さから、"},{"spoiler":false,"text":"当代最高の「大魔術士（ウィザード）」として名高い。"},{"spoiler":false,"text":"同時に、誰よりも善良で敬虔すぎる宗教者でもある。"},{"spoiler":false,"text":"教師としての役割に忠実で、意外にも子供好きかつ"},{"spoiler":false,"text":"面倒見が良いが、相手の都合は目に入らないことが多く、"},{"spoiler":false,"text":"独りよがりな講義を与えることが多々ある。"}],"source":"bangumi","sourceCharacterId":"152875"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/973255aca6a14e861843ea1f33edd9b9d1250e770133733010f29141955bb598.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ad237d680af6a65056ecdbb55d4465090a0499f91a21b557ab28e85053cd0c4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"善財達也","creatorId":"vndb:s19762","sourcePersonId":"vndb:s19762","canonicalEntityId":"vndb:s19762","name":"善財 達也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:479896:152875:32915:1","source":"bangumi"}]},{"characterId":"char_vndb_c141723","characterName":"アルフィーネ・ミディール","sourceIds":{"vndbCharacterId":"c141723"},"originalCharacterName":"アルフィーネ・ミディール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b93e5e118164e846b0a3f3b6268298d5e4993971ebf4e537b01bbafaf6482865.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9e302ad051cac06c8cab8ce02251f76abfcdf1a954a0a1575b0f2ef1d8cb27f.webp","width":218,"height":256,"source":"static-detail"},"actors