:"exact-normalized-name-in-linked-work","subjectId":"99061"}],"egsCharacterIds":["27041"],"vndbCharacterId":"c32727"},"originalCharacterName":"一ノ瀬 美穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の恋人。"},{"spoiler":false,"text":"小学校のときに大きな犬に絡まれているときに主人公に助けられ、飴玉を貰ってから主人公に好意を寄せるようになった。"},{"spoiler":false,"text":"おとなしく控えめな性格で、優しくマジメであることから、先生や同級生からの評価も高く、学級委員に推されることも。"},{"spoiler":false,"text":"時折、せつなそうな顔で空を見上げているが、その理由を話そうとはしない。"}],"source":"egs","sourceCharacterId":"27041","sourceWorkId":"4114","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の恋人。"},{"spoiler":false,"text":"小学校三年生のときに引っ越してきた際、大きな犬に絡まれて、"},{"spoiler":false,"text":"そのときに助けられた主人公から飴をもらってから、主人公に思いを寄せ、"},{"spoiler":false,"text":"中学の頃から徐々に付き合うようになり、現在に到る。"},{"spoiler":false,"text":"大人しく、全てにおいて控えめ。それで周囲からの評価が良くて、"},{"spoiler":false,"text":"例えば学級副委員に推されたりする。主人公のことが本当に好きだが、"},{"spoiler":false,"text":"一面、時折空を見て祈る、押しつぶされそうなその横顔の理由だけは、"},{"spoiler":false,"text":"決して話そうとはしない。"}],"source":"bangumi","sourceCharacterId":"137196"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbd7e3fa23e9603b15cd1f8d1a6222d0e946a14dcf5dbec454c0304fe34a75ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fae76ec0cf69ed50b54bced350b618a7b88e7e17a5ec1a04a2512ef3b9b01ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99061:137196:4810:1","source":"bangumi"},{"creditedName":"安玖深 音","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11055","source":"vndb"}]},{"characterId":"char_c32728","characterName":"千堂 さやか","sourceIds":{"bangumi":[{"characterId":"137197","match":"exact-normalized-name-in-linked-work","subjectId":"99061"}],"egsCharacterIds":["27043"],"vndbCharacterId":"c32728"},"originalCharacterName":"千堂 さやか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"元気快活で、笑顔が自慢の彼女。"},{"spoiler":false,"text":"愛犬が死んでしまったとき、主人公から飴玉を差し出され、慰められるも、それを拒否したことが、彼女のそれからを変えてしまった。"},{"spoiler":false,"text":"主人公のことを好きなのに、自分は主人公に相応しくないと思い込み、“美穂”と主人公の交際の手助けをしてしまうなど、自分の本当の気持ちをずっと偽り続けてきたが……。"}],"source":"egs","sourceCharacterId":"27043","sourceWorkId":"4114","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"明るく活発でいつも主人公を引き回して遊んでいた。"},{"spoiler":false,"text":"ある日、可愛がっていた飼い犬が死んでしまい、泣いてきたときに"},{"spoiler":false,"text":"主人公から慰めで飴をもらったが、彼女はそれを撥ね付けてしまい、"},{"spoiler":false,"text":"さらにそのすぐ後で、主人公の飴を美穂が素直に受け取ってしまったことで、"},{"spoiler":false,"text":"以降ずっと、自分は主人公に相応しくないと思うようになってしまい、"},{"spoiler":false,"text":"主人公に対して、素直に感情を表現できなくなってしまう。"},{"spoiler":false,"text":"やがて美穂とも仲良くなった彼女は、"},{"spoiler":false,"text":"主人公と美穂をくっつけるように動くようになってしまうが、"},{"spoiler":false,"text":"明るく活発という自分のイメージが好きだし、"},{"spoiler":false,"text":"だからそれを崩すわけにもいかず、現在に到る。"},{"spoiler":false,"text":"学校ではずっとチア部に所属しており、そんなことからか、笑顔が自慢。"}],"source":"bangumi","sourceCharacterId":"137197"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bac68e5d17a1f329691c91ca217a5e37a8942f5d41d6b456ca2a21686216c4e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/291f81725e31bbc1b1c5a5ea37159ff878a0eb9acb884ca87ead61d2161ea8ef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99061:137197:4675:1","source":"bangumi"}]},{"characterId":"char_c32729","characterName":"一ノ瀬 美沙","sourceIds":{"bangumi":[{"characterId":"137198","match":"exact-normalized-name-in-linked-work","subjectId":"99061"}],"egsCharacterIds":["27042"],"vndbCharacterId":"c32729"},"originalCharacterName":"一ノ瀬 美沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が別世界にシフトしまったときに出会う、美穂の妹。"},{"spoiler":false,"text":"主人公よりひとつ年下で、主人公と同じ学園に進学できるよう、主人公に家庭教師をしてもらっているらしい。"},{"spoiler":false,"text":"この別世界では美穂は、美沙をかばって交通事故死したことになっているようだ。"},{"spoiler":false,"text":"純真無垢で、ひたむきまっすぐな性格。"},{"spoiler":false,"text":"主人公のことが好きなようで、果敢にアタックしてくるのだが……。"}],"source":"egs","sourceCharacterId":"27042","sourceWorkId":"4114","spoiler":false},{"segments":[{"spoiler":false,"text":"別世界にシフト後に登場する、美穂の妹。"},{"spoiler":false,"text":"主人公の一年下で、主人公と同じ学校に進学できるように、"},{"spoiler":false,"text":"主人公が家庭教師をしている、という状態でいきなり関係が始まる。"},{"spoiler":false,"text":"姉の美穂は、彼女をかばって交通事故で死んだということになっている。"},{"spoiler":false,"text":"まっすぐでひたむきで、純真。主人公に憧れており、全力でアタックしてくる。"},{"spoiler":false,"text":"子ども扱いすると膨れるが、めげずに健気に主人公についていこうとする。"}],"source":"bangumi","sourceCharacterId":"137198"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6947d12ce829b4bd49493c822af8e8d2aec43d0281128e8bb1f8f64f6c867150.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c10cde951dcc11518def81da1fdea0a4da0295e061de2d3f9cc3ad59594d6269.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99061:137198:4809:1","source":"bangumi"},{"creditedName":"成瀬 未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11056","source":"vndb"}]},{"characterId":"char_c32730","characterName":"市井 まどか","sourceIds":{"bangumi":[{"characterId":"137199","match":"exact-normalized-name-in-linked-work","subjectId":"99061"}],"egsCharacterIds":["27044"],"vndbCharacterId":"c32730"},"originalCharacterName":"市井 まどか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"別世界で主人公のクラスの学級委員を務める女の子。"},{"spoiler":false,"text":"家庭の事情から、非常にテキパキなんでもこなし、周囲からの信望も厚い。"},{"spoiler":false,"text":"小学生のときに、美穂と同じく、主人公に飴玉を貰った経緯を持ち、表には出さないものの、それ以来、ずっと主人公のことを想っていた。"},{"spoiler":false,"text":"別世界にシフトしてきた主人公の手助けをしたいと接してきたが、徐々に彼女のなかの主人公への想いが抑えきれなくなって……。"}],"source":"egs","sourceCharacterId":"27044","sourceWorkId":"4114","spoiler":false},{"segments":[{"spoiler":false,"text":"シフト後、美穂の代わりに学級副委員長として登場する。"},{"spoiler":false,"text":"美穂と同じく、小学校三年生のときのタイミングで、"},{"spoiler":false,"text":"主人公から飴をもらって慰められて、表には出さないが、それ以降、"},{"spoiler":false,"text":"ずっと主人公のことを好きだったということになっている。"},{"spoiler":false,"text":"家庭の事情から否応なしに器用になっており、また、"},{"spoiler":false,"text":"必要以上に他人と関わることをしないが、"},{"spoiler":false,"text":"実際に器用で何でも卒なくこなしてしまうので、"},{"spoiler":false,"text":"みんなにあてにされており、彼女もまた、無駄にモメることを嫌うので、"},{"spoiler":false,"text":"テキパキと、しかも１人で片付けてしまう。"},{"spoiler":false,"text":"シフトしてきた主人公の相談にのるカタチで、"},{"spoiler":false,"text":"彼女は主人公に恩返しをしようとするが、"},{"spoiler":false,"text":"美穂の想い出ばかりを語る主人公に、"},{"spoiler":false,"text":"やがて抑えていた自分の気持ちが走り出すのを、"},{"spoiler":false,"text":"抑えきれなくなっていってしまう。"}],"source":"bangumi","sourceCharacterId":"137199"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a549e0dabd4c39fa39f2fc8a015c44fb16467ce0539a505731c3a6450f63d2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50e17b11d881313c9752a745ac1e0aaed02d71223feb7493846af96d966c8853.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"当麻 明日奈","creatorId":"vndb:s6754","sourcePersonId":"vndb:s6754","canonicalEntityId":"vndb:s6754","name":"当麻 明日奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11058","source":"vndb"}]},{"characterId":"char_c32731","characterName":"榊 つかさ","sourceIds":{"bangumi":[{"characterId":"137200","match":"exact-normalized-name-in-linked-work","subjectId":"99061"}],"egsCharacterIds":["27045"],"vndbCharacterId":"c32731"},"originalCharacterName":"榊 つかさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"別世界に迷い込んだ主人公の前に現れては、意味深な言葉を投げかけては消える謎の少女。"},{"spoiler":false,"text":"時の御使いである彼女は、全ての謎を握っているらしいのだが……。"},{"spoiler":false,"text":"「想いが時を揺らがせることがある。"},{"spoiler":false,"text":"揺らぎがない世界に変化はない。"},{"spoiler":false,"text":"変化がない世界に時間はない。"},{"spoiler":false,"text":"時間とは変化を促すための要素の一つ。"},{"spoiler":false,"text":"変化し、し続けていくものとともにある者。"},{"spoiler":false,"text":"それが私……」"}],"source":"egs","sourceCharacterId":"27045","sourceWorkId":"4114","spoiler":false},{"segments":[{"spoiler":false,"text":"シフト後、要所要所で現れては主人公