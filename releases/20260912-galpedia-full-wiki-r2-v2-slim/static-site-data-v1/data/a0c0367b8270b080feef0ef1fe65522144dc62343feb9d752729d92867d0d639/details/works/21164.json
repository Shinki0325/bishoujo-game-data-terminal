staff:114669","source":"vndb"},{"creditedName":"ZERO1","creatorId":"vndb:s31353","sourcePersonId":"vndb:s31353","canonicalEntityId":"vndb:s31353","name":"たなか れい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114670","source":"vndb"}]},"cast":[{"characterId":"char_c28146","characterName":"道明寺 萌美","sourceIds":{"bangumi":[{"characterId":"27603","match":"exact-normalized-name-in-linked-work","subjectId":"115976"}],"egsCharacterIds":["6202"],"vndbCharacterId":"c28146"},"originalCharacterName":"道明寺 萌美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のバイト先の同僚。明るくお茶目なお店のムードメーカー的存在。"},{"spoiler":false,"text":"下ネタや自虐ネタノリつっこみも華麗に使いこなす勢いの強さを持ち最早女としての自分を捨てている。"},{"spoiler":false,"text":"能力は高く、何でもそつなくこなす事ができ、特に料理は大の得意。"},{"spoiler":false,"text":"基本バイト漬けの日々で、母に代わって幼い弟と妹たちのお世話もしているのでプライベートの時間や空間をほとんど持っていない。"}],"source":"egs","sourceCharacterId":"6202","sourceWorkId":"21164","spoiler":false},{"segments":[{"spoiler":false,"text":"恋愛のスタンス： 恋をするのは恥ずかしい"},{"spoiler":false,"text":"主人公への感情： 一緒に面白い時間を提供できる友人"},{"spoiler":false,"text":"主人公のバイト先の同僚。 明るくてお茶目なお店のムードメーカー的存在。"},{"spoiler":false,"text":"下ネタや自虐ネタ、ノリつっこみも綺麗にこなし、もはや女としての自分を捨てている。"},{"spoiler":false,"text":"そして何でもそつなくこなすことができ、特に料理は大の得意。"},{"spoiler":false,"text":"基本バイト漬けの日々で、母に代わって幼い弟と妹たちの世話もしている。"},{"spoiler":false,"text":"そのためプライベートの時間や空間をほとんど持っていない。"},{"spoiler":false,"text":"「誰かに恋している自分なんて笑えるよね」"}],"source":"bangumi","sourceCharacterId":"27603"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d8b6ced724b4b16872456cae9c6b47b66e1644370bf3d593f2628f2568b5f9f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84bc77fb447eded46f79df9ad8d59170e6392eaef40b87918f28235defa587d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古川かおり","creatorId":"vndb:s5013","sourcePersonId":"vndb:s5013","canonicalEntityId":"vndb:s5013","name":"新山ゆうき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:115976:27603:5190:1","source":"bangumi"}]},{"characterId":"char_c28147","characterName":"一ノ瀬 空","sourceIds":{"bangumi":[{"characterId":"27602","match":"exact-normalized-name-in-linked-work","subjectId":"115976"}],"egsCharacterIds":["6201"],"vndbCharacterId":"c28147"},"originalCharacterName":"一ノ瀬 空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく元気な自由人。感情より論理的な思考の方が強く、集団のまとめ役になる事も多い。"},{"spoiler":false,"text":"そしてそのために割を食う事もしばしば。"},{"spoiler":false,"text":"主人公とは産まれたときから一緒に育ってきた幼馴染の関係だが、主人公より主人公の母親と仲が良い。"},{"spoiler":false,"text":"そのため主人公関係無く主人公宅をうろついており、最早その事に違和感を感じないほど馴染みきってしまっている。"}],"source":"egs","sourceCharacterId":"6201","sourceWorkId":"21164","spoiler":false},{"segments":[{"spoiler":false,"text":"恋愛のスタンス： 自分の恋に興味が無く、他人の恋に興味がある"},{"spoiler":false,"text":"主人公への感情： いるのも当たり前、いないのも当たり前な家族みたいなもの"},{"spoiler":false,"text":"主人公と同じ大学に通う明るく元気な自由人。"},{"spoiler":false,"text":"感情より論理的な思考のほうが強く、集団のまとめ役になることも多い。"},{"spoiler":false,"text":"そしてそのために わりを食うこともしばしば。"},{"spoiler":false,"text":"主人公とは産まれた時から一緒に育ってきた幼なじみの関係。 主人公よりも主人公の母親と仲が良い。"},{"spoiler":false,"text":"そのため主人公に関係なく主人公宅をうろついており、そのことに違和感を感じないほど馴染みきってしまっている。"},{"spoiler":false,"text":"「二人の間に恋なんて、今更過ぎて正直困る」"}],"source":"bangumi","sourceCharacterId":"27602"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef72bbd5ae6c98082ab61c4600c8995f39f057c049ed08e84bfe660b2551279c.webp","fallbackUrl":"https://wiki-as