:"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63741f581e137ab37f793eec2d53d83a4e844124a8b1b0e9ab48bfbd9b1b4478.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99901001846cc5ebc84c4e54549774bf5745c54af80cae5db1c46481f7218117.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤祐記","creatorId":"vndb:s1412","sourcePersonId":"vndb:s1412","canonicalEntityId":"vndb:s1412","name":"近藤 祐記","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:115976:27604:5904:1","source":"bangumi"}]},{"characterId":"char_c32332","characterName":"紺野 彩里沙","sourceIds":{"bangumi":[{"characterId":"27605","match":"exact-normalized-name-in-linked-work","subjectId":"115976"}],"egsCharacterIds":["6204"],"vndbCharacterId":"c32332"},"originalCharacterName":"紺野 彩里沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のバイト先の後輩。何をやらせても必死にこなし能力を高めていく"},{"spoiler":false,"text":"真面目な努力家タイプだが、周りからは才能の一言で片付けられてしまっている。"},{"spoiler":false,"text":"クォーターな上に母親が元モデルという肩書きと実際のルックスも相まって同級生から頼りにされ大人扱いされる存在。"},{"spoiler":false,"text":"けれど本人的には特別扱いされる事に疲れを感じている。"},{"spoiler":false,"text":"ありのままの自分を受け入れてくれる空に懐き、すぐふざける萌美が天敵。"},{"spoiler":false,"text":"真面目だからこそ融通が利かせられない欠点を持つ。"}],"source":"egs","sourceCharacterId":"6204","sourceWorkId":"21164","spoiler":false},{"segments":[{"spoiler":false,"text":"恋愛のスタンス： 恋を自覚すると自分を止められない"},{"spoiler":false,"text":"主人公への感情： ことあるごとに自分の視界に入ってきて目障りなヤツ"},{"spoiler":false,"text":"主人公のバイト先の後輩。"},{"spoiler":false,"text":"何をやらせても必死にこなし、徐々に能力を高めていくまじめな努力家タイプ。"},{"spoiler":false,"text":"だが周りからは、そんな努力も “才能” の一言で片付けられてしまっている。"},{"spoiler":false,"text":"まじめだからこそ融通が利かせられないのが欠点。"},{"spoiler":false,"text":"クォーターで母親が元モデルという肩書き、そして実際のルックスも相まって同級生から頼りにされ、大人扱いされている。"},{"spoiler":false,"text":"けれど本人的には特別扱いされることに疲れを感じている。"},{"spoiler":false,"text":"ありのままの自分を受け入れてくれる空に懐き、すぐふざける萌美は天敵。"},{"spoiler":false,"text":"「私だって、誰かに頼りたい」"}],"source":"bangumi","sourceCharacterId":"27605"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05bfe7fe027ca6c5f07b716ce0ec25869056a7e02f968fd65102f53b157accfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc991329c7d4aa2a98a97505deb1281276226fa42f32bff7f539c82ab20b2fd9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田真弓","creatorId":"vndb:s944","sourcePersonId":"vndb:s944","canonicalEntityId":"vndb:s944","name":"吉田 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:115976:27605:5926:1","source":"bangumi"}]},{"characterId":"char_c32333","characterName":"篠崎 あゆみ","sourceIds":{"bangumi":[{"characterId":"27606","match":"exact-normalized-name-in-linked-work","subjectId":"115976"}],"egsCharacterIds":["6205"],"vndbCharacterId":"c32333"},"originalCharacterName":"篠崎 あゆみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"事情により主人公の家に預けられる事になった年下の従兄妹。"},{"spoiler":false,"text":"おっとりとした性格で引っ込み思案。"},{"spoiler":false,"text":"何事にも一生懸命に頑張るタイプで争い事を好まない。"},{"spoiler":false,"text":"男に対する警戒心が強いが、一度懐くと甘えん坊になる。"},{"spoiler":false,"text":"綺麗でカッコイイ女性に憧れがあるので、彩里沙や志帆に羨望の眼差しを向けている。"}],"source":"egs","sourceCharacterId":"6205","sourceWorkId":"21164","spoiler":false},{"segments":[{"spoiler":false,"text":"恋愛のスタンス： 自分が好きにならないと恋愛にならない"},{"spoiler":false,"text":"主人公への感情： 優しい従兄妹のお兄ちゃん"},{"spoiler":false,"text":"とある事情により、主人公の家に預けられることになった年下の従兄妹。"},{"spoiler":false,"text":"おっとりした性格で引っ込み思案。 