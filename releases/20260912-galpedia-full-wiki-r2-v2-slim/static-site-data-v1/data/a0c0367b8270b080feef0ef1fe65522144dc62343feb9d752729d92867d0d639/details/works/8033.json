ndb","value":"67"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桜坂荘の隣に住んでいる心優しいお姉さん。"},{"spoiler":false,"text":"しっかり者で常に温和。正に欠点が見当たらない完璧な女性。"},{"spoiler":false,"text":"彼女の日課ともいうべき庭掃除は、桜坂荘の名物風景でもある。"},{"spoiler":false,"text":"家族同然のように育ってきた茜を実の妹の様に思っており、婚約を破棄してまで桜坂荘で作り上げた思い出を大切にしている。"}],"source":"egs","sourceCharacterId":"25284","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"桜坂荘の隣に住んでいる心優しいお姉さん。しっかり者で常に温和。正に欠点が見当たらない完璧超人。"},{"spoiler":false,"text":"家族同然のように育ってきた茜を実の妹の様に思っており、婚約を破棄してまで桜坂荘で作り上げた思い出を大切にしている。"},{"spoiler":false,"text":"林太郎の事に好感を持っているが、好きかどうかは顔や行動にあまり出さないので不明である。"},{"spoiler":false,"text":"恋敵として現れる真琴とは正反対のような性格で、真っ向から違う意見を言いあってぶつかりあう事も。"},{"spoiler":false,"text":"真琴のように行動的ではないので、真琴の事を少し羨ましく思っている事もあるようだ。"},{"spoiler":false,"text":"林太郎の恋は果たして実るのだろうか…。"}],"source":"bangumi","sourceCharacterId":"146164"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28a49b0603320381acbc6d94f02e8804f7f7a5796de739b4e886906fa0f97d8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f1424056be5e1eae2eb9b1d12f69204495b94a2ddc0b083758fd0ccdcda8cef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146164:4463:1","source":"bangumi"}]},{"characterId":"char_c55164","characterName":"桜坂 茜","sourceIds":{"bangumi":[{"characterId":"146163","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25285"],"vndbCharacterId":"c55164"},"originalCharacterName":"桜坂 茜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"66"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学生の身でありながら桜坂荘の大家もこなす苦労人。"},{"spoiler":false,"text":"幼くして両親が桜坂荘から姿を消してしまって以来、響子と一緒に思い出の詰まっている桜坂荘を守ってきた。"},{"spoiler":false,"text":"困っている人を放っておけない性格でおせっかい焼きな一面もある。"},{"spoiler":false,"text":"窮地を救ってくれた林太郎に恋心を抱くも響子と比べて子供扱いされる事に嫉妬している。"}],"source":"egs","sourceCharacterId":"25285","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"学生の身でありながら桜坂荘の大家もこなす苦労人。"},{"spoiler":false,"text":"幼くして両親が桜坂荘から姿を消してしまって以来、響子と一緒に想い出の詰まっている桜坂荘を守ってきた。"},{"spoiler":false,"text":"多額の借金債務の期限が近づいて来てた時に、公園で林太郎を拾ってくる事で、一時的に窮地を脱出する事が出来た。"},{"spoiler":false,"text":"窮地を救ってくれた林太郎に恋心を抱いているが、○○に興味の無い林太郎にいつも軽くあしなわれたり、あからさまに響子との接し方が違うのが少々気にかかっている。"},{"spoiler":false,"text":"果たして今作では、自分の本音が林太郎に伝わるのだろうか……？"}],"source":"bangumi","sourceCharacterId":"146163"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ceccf8321d14bc84fcb57fd872464640ba806eb7d4831ca22cf4d219b44ff1ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7214fe457d1c018cd2b3d64c1c140956108cb413e98b2708cce21d4440c3301c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146163:5890:1","source":"bangumi"}]},{"characterId":"char_c55173","characterName":"草加 真琴","sourceIds":{"bangumi":[{"characterId":"146172","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25286"],"vndbCharacterId":"c55173"},"originalCharacterName":"草加 真琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"林太郎のコンサルタント業時代の元同僚でありながら元恋人。"},{"spoiler":false,"text":"物事の展開をかなり先まで読む戦略家タイプ。"},{"spoiler":false,"text":"付近の開発事業のコンサルタントを任され周辺地区の宿泊施設の状況を調査さる為に来た。"},{"spoiler":false,"text":"活発で明るく、周りの人間から好かれるような魅力を持っている。"},{"spoiler":false,"text":"ファッションセンスに関してはかなり五月蝿く露出が少々多めの服を好んで着ている。"},{"spoiler":false,"text":"お金が大好きで、ダサいモノが大嫌い。"}],"source":"egs","sourceCharacterId":"25286","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"林太郎の元同僚で元恋人。物事の展開をかなり先まで頭の中で組み立てられる戦略家タイプな女性。"},{"spoiler":false,"text":"今回桜坂荘を訪れたのは、駅前開発事業のコンサルタントを任され、周辺地区の宿泊施設の状況を調査する為に来た。"},{"spoiler":false,"text":"彼女の中で唯一、自分の全てを話したのは林太郎だけであり、彼女にとって安心できる存在が林太郎である。すなわち、林太郎は彼女の中で特別な存在。それなのにも関わらず、林太郎は恋敵の響子ばかり見ていて、彼女の事を何1つ見ようとしなかった。"},{"spoiler":false,"text":"その為に、沸々と沸きあがるやり場のない思いだけが心の中に溜まっていく。そして、彼女は林太郎に……。"}],"source":"bangumi","sourceCharacterId":"146172"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8a72fe01e635ffbc5b6a7af3c4ab9f1ec8b69490547746ea08ac591c6785ec9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5b4cbedad3e1163ef633e14cb30b217c429e3968f13f375ea649896799882b2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"歌織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146172:12717:1","source":"bangumi"}]},{"characterId":"char_c55176","characterName":"イヴ・バウワー","sourceIds":{"bangumi":[{"characterId":"146173","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25287"],"vndbCharacterId":"c55176"},"originalCharacterName":"イヴ・バウワー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"茜の学校に転校してきた留学生。"},{"spoiler":false,"text":"他人の前では猫を被って良い子を演じているがその本性は勝気な性格で、汚い言葉を使ったりする二面性な性格の持ち主。"},{"spoiler":false,"text":"口の悪さと小悪魔的な行動で、作為的に林太郎にハプニングを運んでくる。"},{"spoiler":false,"text":"家庭の事情で桜坂荘に入居する事になるのだが大人を一切信用してない背景がある。"},{"spoiler":false,"text":"幼い容姿ながらも、外国人ならではの透き通った肌と碧い瞳が特徴で、将来が楽しみではある。"}],"source":"egs","sourceCharacterId":"25287","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"茜のクラスに留学してきた生意気な娘。他人の前では猫をかぶって良い子を演じているが、普段は勝気な性格で、汚い言葉を使ったりする二面性な性格。その口の悪さと小悪魔的な行動で、作為的に林太郎に、ハプニングを運んで来る。家庭の諸事情で桜坂荘に入居してくる事になる。"},{"spoiler":false,"text":"彼女は大人を信用する事が出来ないのだが、茜から聞いた『林太郎』の存在に何故か興味が沸く。"},{"spoiler":false,"text":"頭がかなりキレるのだが、その頭脳も悪知恵の方に働いてしまう。"},{"spoiler":false,"text":"その為、林太郎を振り向かす為に、無茶な事をやらかしたり女の色気全快で迫ってきたりする事も。"},{"spoiler":false,"text":"小悪魔的な表情とは別に、1人の乙女としての寂しい表情を見せる。だが、その寂しい表情の理由を誰にも打ち明けようとは全くしない。"}],"source":"bangumi","sourceCharacterId":"146173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44c76709e4b1a9b652b0653600c2c50446cace4ecbf09e7ebc9e1a83e8f86663.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aa294909769f0a8739e8ccf010d5a4edc3f14f3b30872d451f4afa8dc57b544.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146173:4956:1","source":"bangumi"}]},{"characterId":"char_c55177","characterName":"深津 静乃","sourceIds":{"bangumi":[{"characterId":"146174","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25288"],"vndbCharacterId":"c55177"},"originalCharacterName":"深津 静乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"夫を桜ヶ丘で亡くしてしまった未亡人。"},{"spoiler":false,"text":"夫が亡くなった桜ヶ丘を傷心旅行中で、宿泊施設として桜坂荘を利用する事になる。"},{"spoiler":false,"text":"長い黒髪に、その妖艶な雰囲気を醸し出すかのように暗い色で纏めた服を着ている。"},{"spoiler":false,"text":"夫が亡くなったのは自分の所為ではないかと思っており自分を不幸を運ぶ女性と思い込み時折、アパート内で自殺を図ろうとしている。"}],"source":"egs","sourceCharacterId":"25288","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"夫を桜ヶ丘で亡くしてしまった未亡人。夫が亡くなった桜ヶ丘を傷心旅行中で、宿泊場所として桜坂荘を利用する事になる。"},{"spoiler":false,"text":"長い髪に、和服が似合いそうな顔立ちの彼女は、その妖艶な雰囲気を醸し出すかのように、暗い色で纏めた服を着ている。"},{"spoiler":false,"text":"その妖艶な大人の色香は寄ってくる男を皆彼女の虜にしてしまう魔性の力を発している。そして虜になってしまった男には必ず不幸が訪れるらしい。"},{"spoiler":false,"text":"その為なのか、夫が亡くなった理由が彼女が夫に不幸を齎したのではないかと思い深く落ち込んでしまっている。夫のいない生活に耐え切れなくなったのか、何度も何度も夫の後を追って、アパート内で自殺を図ろうとする。だが、その度に運良く林太郎に止められる。"},{"spoiler":false,"text":"最愛の人と一緒に歩んでいた夢の様な時間は終わり、もう生きていく意味がないような事まで口にし始める。"}],"source":"bangumi","sourceCharacterId":"146174"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07596732cd792dbb678289bb93fdebf7f788217481b449399c486ea07ae5463a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/774f8dfa8b709f910c4be6b6d4c5bc053f89f549223a5b717298987caf4e0874.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146174:6131:1","source":"bangumi"}]},{"characterId":"char_c55178","characterName":"朝倉 芽衣","sourceIds":{"bangumi":[{"characterId":"146175","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25289"],"vndbCharacterId":"c55178"},"originalCharacterName":"朝倉 芽衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『自分さえ良ければ全て良し』な精神の自称売れっ子アイドル。"},{"spoiler":false,"text":"スキャンダルが原因で、身を隠す為に桜坂荘に入居してくる。"},{"spoiler":false,"text":"アイドルという身分を隠す為に、帽子にサングラスと素性を隠す反面、自己中心っぷりは隠す事が出来ずアパート内でも度々周囲に迷惑を及ぼす。"},{"spoiler":false,"text":"素性を隠す為に、あまり肌を露出する機会は無いが隠された服の下には、アイドルらしく均整の取れた身体を持っている。"}],"source":"egs","sourceCharacterId":"25289","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"『自分さえ良ければ全て良し』な精神の自称売れっ子アイドル。あるスキャンダルが原因で、アイドルの姿を偽る事って桜坂荘に入居してくる。"},{"spoiler":false,"text":"帽子にサングラス、コートにマフラーの重装備な風貌を見て、他国からのスパイやら、桜坂荘を潰しにかかる第三勢力やら、といろいろ怪しまれる様なハプニングもあったりする。 そんな彼女も重装備を外すと、自称アイドルと言うだけあって、顔立ち、スタイルも良く、素質は十分に感じられる。だがそんな自称アイドルも一皮剥けば、その容姿とは裏腹に自意識過剰で、口から出る言葉は毒そのもので、他人が傷つく事を平気で言ってしまう。"},{"spoiler":false,"text":"アイドルなら顔だけでじゃなくて、『歌』や『演技』と思っているのか、時折部屋から聞こえてくる彼女の歌声はまるでジャ○アニズム並で、部屋がミシミシと音を立てていたりする。また、極度の上がり症なのか他人の前では全く歌を歌わない様だ。"},{"spoiler":false,"text":"そんな自分の考えを分かって貰えなくなった彼女は、味方と呼べる人たちが次第に居なくなってしまう。そんな自称アイドルの行く末は……。"}],"source":"bangumi","sourceCharacterId":"146175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a028e48b831cc9dca47ebc85e4f1daf948f50b1ae3167463b9b059695d3598a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ada98efff3556f0b193aa78607050626d747275b72e3fa6394bbd1155ce885ab.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146175:5922:1","source":"bangumi"}]},{"characterId":"char_c55179","characterName":"幸田 岬","sourceIds":{"bangumi":[{"characterId":"146177","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25291"],"vndbCharacterId":"c55179"},"originalCharacterName":"幸田 岬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"類まれなる天才水泳選手。"},{"spoiler":false,"text":"桜ヶ丘で開かれる水泳大会に参加する為近くの桜坂荘を宿泊施設として利用する事になる。"},{"spoiler":false,"text":"本来は他の選手達と同じ宿泊施設を利用するのだが他の選手達にから、とある秘密を隠す為、個人で桜坂荘を利用してくる。"},{"spoiler":false,"text":"見た目ボーイッシュで、他人に厳しく自分にはさらに厳しい性格をしている。"},{"spoiler":false,"text":"その為、自分の弱点や相談事等を他人に話す事等は一切しない。"},{"spoiler":false,"text":"また、スポーツマンとしては若干背が低くその小柄な身体の割りには巨乳の持ち主で、彼女の容姿目的のファンも多い。"}],"source":"egs","sourceCharacterId":"25291","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"類稀なる天才スポーツ選手。未来の水泳界を背負って立つとも噂される程の実力の持ち主。"},{"spoiler":false,"text":"周りや新聞は彼女を『天才』と取り上げるが、彼女自身ははそうは思っていないようだ。『天才』の裏には努力を惜しまない一人のスポーツ選手の顔があるからだ。『努力を惜しまなければ結果は必ず付いて来る』が彼女の信条である。規律やルールを守らない人。努力しない人。だらしが無い人。彼女の信条と逆方向の考えの人間は生理的に受け付けない。"},{"spoiler":false,"text":"見た目のようにボーイッシュで、他人に厳しく自分にはさらに厳しい。厳格で硬派な人柄とは裏腹に、ガラスのような繊細な心を持っている。そして、そのガラスの心は脆く傷つき易い。その為、自分に起きた事を他人に話す事はなく、自分の中に閉じ込めてしまったりする一面がある。他人に頼らず自分だけで何とかしようとする性格。"},{"spoiler":false,"text":"そんな彼女は、桜ヶ丘の水泳大会に参加するに、会場の近くの桜坂荘を宿泊施設として選んで顔を出しにくる。"}],"source":"bangumi","sourceCharacterId":"146177"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f21e063646c5c6ba0370026fc7ce2816a31d2b2852d8fcec349840af697eedd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43a6ff648196c3279349fa88ae14030c46688604ee3a24051af0b8b3f44ad09d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あえか","creatorId":"vndb:s9085","sourcePersonId":"vndb:s9085","canonicalEntityId":"vndb:s9085","name":"あえか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:38880","source":"vndb"}]},{"characterId":"char_c55180","characterName":"秋原 怜奈","sourceIds":{"bangumi":[{"characterId":"146176","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25290"],"vndbCharacterId":"c55180"},"originalCharacterName":"秋原 怜奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"公園で倒れていた所を茜に拾われてくる無口な引き篭もり娘。"},{"spoiler":false,"text":"極度の引き篭もりで、入居後もあまり外出せず無愛想な人柄。"},{"spoiler":false,"text":"他人との接触を極端に嫌い、何かしら秘密を隠しているらしい。"},{"spoiler":false,"text":"一日中、部屋でパソコンと向き合いネット三昧な毎日だがネット上ではちょっとした有名人らしい。"}],"source":"egs","sourceCharacterId":"25290","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"公園で倒れていた所を茜に拾われてくる無口な引き篭もり娘。とにかく現実世界では通称ヒッキーと言われる部類に属する。しかし、インターネット上ではネットアイドルとして、多くの人から慕われている顔を持っていたりする。2～3日インターネットをしないと禁断症状が出るようだ。"},{"spoiler":false,"text":"とにかくダラシが無い生活をしていて、部屋の中の布団はひきっ放し。布団の上にゴロゴロと横になりながら、一日中パソコンと睨めっこをしている。"},{"spoiler":false,"text":"私服として着ているのが緑色のジャージを着ているようで、とにかくダサい。時折部屋から出て来たとしても、便所か風呂か食料の買出し程度。太陽の光を浴びると溶けてしまうのではないかと思えるくらいに、不健康体だと思われる。"},{"spoiler":false,"text":"そんな彼女は、面を見て人と話す事が出来ないのか、自ら他人との間に壁を作ってしまう。インターネット上ではアイドルとして慕われているのなら、自分にもっと自信を持つ事が出来ないだろうか。 彼女を見ていると、どうも他の女性と違って、違和感を感じる。"}],"source":"bangumi","sourceCharacterId":"146176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9f7357c16ce6b522c64c27daef2a9f3329470b620f884f1b895800a7679942b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cb92f7181cbb40ea1a8ee4a00a2cffea0d996c92edf690a94a52ea4bdeaef2c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146176:6379:1","source":"bangumi"}]},{"characterId":"char_c55181","characterName":"遠野 宏美","sourceIds":{"bangumi":[{"characterId":"146178","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25292"],"vndbCharacterId":"c55181"},"originalCharacterName":"遠野 宏美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"単身田舎から上京してきた貧乏OL研修生。"},{"spoiler":false,"text":"田舎には妹と弟を残してきており、養うために上京してきたものの会社の研修時で、宿泊施設の手配ミスに遭い、急遽桜坂荘にやってくる。"},{"spoiler":false,"text":"いつでも明るく前向きで、元気だがやる気がだけが空回りしてしまい、よくドジを踏んでしまう。"},{"spoiler":false,"text":"それでも笑顔を絶やさない彼女だが時に周囲の人間から、それが疎ましく思われしまう事もある。"},{"spoiler":false,"text":"ふくよかな体型で、スーツの上からでも形状、状態が分かる張りのある巨乳の持ち主。"}],"source":"egs","sourceCharacterId":"25292","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"自ら単身で田舎から上京して来た貧乏OL研修生。幼い頃に兄弟3人を残して両親は他界してしまい、その為、多額の借金を背負ってしまい家計は火の車状態。田舎で暮らしている妹と弟にお腹いっぱい食べさせる為に、上京して来るのだが、会社側の宿泊施設の手配ミスで、急遽桜坂荘にやって来るお客さんである。"},{"spoiler":false,"text":"真面目で素直で、世の中の黒い部分を知らないような感じだ。明るい性格で、興奮すると方言が飛び出す。妹弟の為なら、例え自分の身がどうなっても構わないというくらいに妹弟想い。仕事が終わった後でも、隠れてアルバイトをして、お金を稼いでいたりするのである。だが、気持ちだけが先走ってしまい体が付いていかず、良くドジをしてしまうが、本人は努力でカバー出来ると思っている。"},{"spoiler":false,"text":"しかし、ドジの数が多い為か会社からはあまりいい目では見られていない。 落ち込んでいてもプラス思考で切り抜けたり、他人の前ではそんな表情をあまり見せたりしない強い女性だ。"}],"source":"bangumi","sourceCharacterId":"146178"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d90d882053fa5d1f31cfe2919f54b434c437a6ca578a03cebc4d84e3af2d686.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/931582ceaf03e95614ecdf7c204c9c9531c420c175e399fffe3961730caec485.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146178:19333:1","source":"bangumi"}]},{"characterId":"char_c55182","characterName":"凪宮 杏樹","sourceIds":{"bangumi":[{"characterId":"146179","match":"exact-normalized-name-in-linked-work","subjectId":"305012"}],"egsCharacterIds":["25293"],"vndbCharacterId":"c55182"},"originalCharacterName":"凪宮 杏樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桜坂荘に憑いた悪霊を払う為に入居してくる聖女（シスター）。"},{"spoiler":false,"text":"幼い頃から修道院暮らしをしている為、世間や異性との付き合い方を知らずに育ってきた。"},{"spoiler":false,"text":"おしとやかで礼儀正しく、とても丁寧な口調で話す。"},{"spoiler":false,"text":"『恋愛』に免疫が無く、周囲で人がイチャイチャしてたりキス等を目撃すると顔を真っ赤にして、同様してしまう。"},{"spoiler":false,"text":"修道着であまりスタイルが分かり難かったりするが、それは、未だ男性の目に触れた事のない身体の証拠。"}],"source":"egs","sourceCharacterId":"25293","sourceWorkId":"8033","spoiler":false},{"segments":[{"spoiler":false,"text":"桜坂荘に取り憑いた悪霊を払う為に入居してくる聖女（シスター）。幼い頃から修道院暮らしている為に、世間や異性との付き合い方を全く知らずに育ってきてしまった。その為、『恋愛』という言葉にとても敏感に反応する。"},{"spoiler":false,"text":"おしとやかで礼儀正しく、とても丁寧な口調で話す。普段は気が弱く、争い事が大嫌いで、ちょっと天然気味で、かなり極端過ぎる考え方しかできない。"},{"spoiler":false,"text":"手先が不器用なのだが、藁人形を編むのは得意らしい。部屋の中では踊り狂うように、悪霊払いをする。しかし善意でやっている悪霊払いも、時には周りの人に○○を齎している事を彼女は知らない。"},{"spoiler":false,"text":"修道女の服であまりスタイルが分かり難かったりするが、実は脱ぐとかなりエロイ身体つきだったりする。しかし桜坂荘内で彼女を見かけても、修道女の服を着ている姿しか見る事がない。彼女の私服姿や、裸姿を拝む事が出来るだろうか……。"}],"source":"bangumi","sourceCharacterId":"146179"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/870df873c14aa2f5eeafe5d74da7f5f59872cff31b97057d29e55dfc1643292c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/663a378f1fa38800617c3d7881e54a950f83bb7b8916946a76c9b32d8fe29ef4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305012:146179:4489:1","source":"bangumi"}]},{"characterId":"char_vndb_c55165","characterName":"桜坂 文隆","sourceIds":{"vndbCharacterId":"c55165"},"originalCharacterName":"桜坂 文隆","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0ca5360e02d6d19f6755d9717695fb8ed3446fdc8b5a7cd22694fdb64ca1c554.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8198c503b242e8982fcc1de2eefc87c38ddf074a6f932faee76f84ac591ee2cb.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c55166","characterName":"嘉門 達郎","sourceIds":{"vndbCharacterId":"c55166"},"originalCharacterName":"嘉門 達郎","cha