:s11348","name":"jolly","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:102296","source":"vndb"},{"creditedName":"asu","creatorId":"vndb:s12331","sourcePersonId":"vndb:s12331","canonicalEntityId":"vndb:s12331","name":"asu","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:102297","source":"vndb"},{"creditedName":"こずみっく","creatorId":"vndb:s16407","sourcePersonId":"vndb:s16407","canonicalEntityId":"vndb:s16407","name":"こずみっく","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:102298","source":"vndb"},{"creditedName":"Naynit Kcalb Studio","creatorId":"vndb:s7472","sourcePersonId":"vndb:s7472","canonicalEntityId":"vndb:s7472","name":"たいにゃん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:102300","source":"vndb"},{"creditedName":"有限会社ファミリーワーク","creatorId":"vndb:s45122","sourcePersonId":"vndb:s45122","canonicalEntityId":"vndb:s45122","name":"有限会社ファミリーワーク","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:102301","source":"vndb"},{"creditedName":"まふゆ 飴","creatorId":"vndb:s45123","sourcePersonId":"vndb:s45123","canonicalEntityId":"vndb:s45123","name":"まふゆ 飴","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:102302","source":"vndb"},{"creditedName":"alford","creatorId":"vndb:s45124","sourcePersonId":"vndb:s45124","canonicalEntityId":"vndb:s45124","name":"alford","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:102303","source":"vndb"}]},"cast":[{"characterId":"char_c43540","characterName":"佐倉 一果","sourceIds":{"bangumi":[{"characterId":"89658","match":"exact-normalized-name-in-linked-work","subjectId":"70196"}],"egsCharacterIds":["7935"],"vndbCharacterId":"c43540"},"originalCharacterName":"佐倉 一果","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You can’t tell anyone else about us kissing and sleeping together, okay? It’s our little secret.\""},{"spoiler":false,"text":"A kind, responsible girl with endless patience, Ichika is an exemplary student and a member of the Student Council. More down-to-earth than Futaba, she tends to stubbornly consider only the facts rather than consulting her feelings when making decisions."},{"spoiler":false,"text":"Taking care of Futaba has long since become part of Ichika's daily routine, and the sight of Futaba's smile is always enough to make Ichika smile in return."},{"spoiler":false,"text":"Although Futaba and Ichika are twins, Ichika sees herself as the older sister. Since she mostly acts on logic rather than her own feelings, she has trouble facing her love for Futaba."},{"spoiler":false,"text":"Ichika has secretly been fretting that, even though she and Futaba are twins, they won’t be able to stay together forever, so her mother's warning sets Ichika on a path of distancing herself from Futaba."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c43540"},{"segments":[{"spoiler":false,"text":"おだやかで優しい性格。双葉に比べてしっかりしているように見られる。"},{"spoiler":false,"text":"成績もそこそこ優秀で、どちらかというと真面目で頑固な常識人。"},{"spoiler":false,"text":"双葉の世話を焼いている姿はもはや日常の一部となっており、"},{"spoiler":false,"text":"一果自身もそうすることで双葉が喜ぶことに幸せを感じている。"},{"spoiler":false,"text":"双葉とは双子ではあるが、自分が姉だという自覚のようなものがあり、理性的に行動しようとすることが多く、そのため双葉への好意に関して素直に表に出せない部分がある。"},{"spoiler":false,"text":"特に将来のことに関しては、ずっと一緒にいることはできないだろうという漠然とした予想や気持ちがあるため、母からはっきりとその点について指摘された後は双葉との関係に無理に一線を引こうとする。"},{"spoiler":false,"text":"生徒会に所属している。"}],"source":"egs","sourceCharacterId":"7935","sourceWorkId":"18071","spoiler":false},{"segments":[{"spoiler":false,"text":"「そう、いい？　キスしたり、えっちなことをしたりっていうのは、"},{"spoiler":false,"text":"ふたりだけの秘密」"},{"spoiler":false,"text":"おだやかで優しい性格。双葉に比べてしっかりしているように見られる。"},{"spoiler":false,"text":"成績もそこそこ優秀で、どちらかというと真面目で頑固な常識人。"},{"spoiler":false,"text":"双葉の世話を焼いている姿はもはや日常の一部となっており、"},{"spoiler":false,"text":"一果自身もそうすることで双葉が喜ぶことに幸せを感じている。"},{"spoiler":false,"text":"双葉とは双子ではあるが、自分が姉だという自覚のようなものがあり、"},{"spoiler":false,"text":"理性的に行動しようとすることが多く、"},{"spoiler":false,"text":"そのため双葉への好意に関して素直に表に出せない部分がある。"},{"spoiler":false,"text":"特に将来のことに関しては、ずっと一緒にいることはできないだろう"},{"spoiler":false,"text":"という漠然とした予想や気持ちがあるため、"},{"spoiler":false,"text":"母からはっきりとその点について指摘された後は双葉との関係に無理に一線を引こうとする。"},{"spoiler":false,"text":"生徒会に所属している。"}],"source":"bangumi","sourceCharacterId":"89658"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22ece060edb4dc30abcd131d42066690abdf1eb0a8b063ed79279daeedee7f94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9d865d4a42ca41b52987e26b61dfe37eef854b4aac2b8980ed64ea603ea67b5.webp","width":69,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:70196:89658:15637:1","source":"bangumi"}]},{"characterId":"char_c43541","characterName":"佐倉 双葉","sourceIds":{"bangumi":[{"characterId":"89659","match":"exact-normalized-name-in-linked-work","subjectId":"70196"}],"egsCharacterIds":["7936"],"vndbCharacterId":"c43541"},"originalCharacterName":"佐倉 双葉","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I’m going to show you just how much I love you, so don’t take your eyes off me, okay?\""},{"spoiler":false,"text":"A happy-go-lucky ball of energy who doesn’t let common sense get in the way of her feelings, Futaba is not the brightest bulb in the box."},{"spoiler":false,"text":"Futaba always trusts her emotions, so she makes no attempt to hide her love for Ichika, showing it in word and deed. Whether in the privacy of their house or in the school hallways, Futaba will hold Ichika’s hand, or give her a hug, or even lick her ear at times. Fortunately, Futaba's friends and family tend to dismiss that as part of her outgoing nature, so they don’t think much of it."},{"spoiler":false,"text":"Futaba is a natural athlete and a member of the tennis club. Her grades aren’t the best, but that doesn’t bother her much since she can always rely on Ichika for help."},{"spoiler":false,"text":"Ichika starts to distance herself from Futaba after their mother’s warning, but this only leaves Futaba confused. Why is Ichika acting so weird? Futaba makes it her mission to get their relationship back on track."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c43541"},{"segments":[{"spoiler":false,"text":"人懐っこく素直で騒がしくて元気で、直感で生きるあほの子。"},{"spoiler":false,"text":"あまり常識にとらわれず思ったとおりに行動するタイプ。成績はあまりよくない。"},{"spoiler":false,"text":"むしろ一果ができるからいいやくらいに思っている。"},{"spoiler":false,"text":"一果のことが大好きであることを公言してはばからず、また元来スキンシップ過剰気味なタイプで、クラスメートや友人に対する友情からのスキンシップはもちろん、家・学校内問わず一果に飛びつく・抱きつく・手をつなぐ・ちょっと舐める等積極的な行動が目立つが、その素直な性格から、そういった行動もある程度周囲に自然に受け入れられている部分がある。"},{"spoiler":false,"text":"母の言葉をきっかけに、自分と少し距離を置こうとする一果に対して「なんでそんなことする必要があるのかわからない」と、より関係を詰める行動に出る。"},{"spoiler":false,"text":"運動神経はよく、テニス部に所属している。"}],"source":"egs","sourceCharacterId":"7936","sourceWorkId":"18071","spoiler":false},{"segments":[{"spoiler":false,"text":"「双葉がどれだけ一果のことが大好きか……今から、目の前で証明する。"},{"spoiler":false,"text":"…………だから、見てて、ね？」"},{"spoiler":false,"text":"人懐っこく素直で騒がしくて元気で、直感で生きるあほの子。"},{"spoiler":false,"text":"あまり常識にとらわれず思ったとおりに行動するタイプ。成績はあまりよくない。"},{"spoiler":false,"text":"むしろ一果ができるからいいやくらいに思っている。"},{"spoiler":false,"text":"一果のことが大好きであることを公言してはばからず、また元来スキンシップ過剰気味なタイプで、"},{"spoiler":false,"text":"クラスメートや友人に対する友情からのスキンシップはもちろん、"},{"spoiler":false,"text":"家・学校内問わず一果に飛びつく・抱きつく・手をつなぐ・ちょっと舐める等積極的な行動が目立つが、"},{"spoiler":false,"text":"その素直な性格から、そういった行動もある程度周囲に自然に受け入れられている部分がある。"},{"spoiler":false,"text":"母の言葉をきっかけに、自分と少し距離を置こうとする一果に対して"},{"spoiler":false,"text":"「なんでそんなことする必要があるのかわからない」と、より関係を詰める行動に出る。"},{"spoiler":false,"text":"運動神経はよく、テニス部に所属している。"}],"source":"bangumi","sourceCharacterId":"89659"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b83bd15e478c3ffc5912a2aec23f2dcc1f606bc9e8740ba54d275e8e6d764fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/3885e7c40a918899ce023b59d8a46d23870b657376cb1fb4d1770d401713f2b3.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松平美波穂","creatorId":"vndb:s601","sourcePersonId":"vndb:s601","canonicalEntityId":"vndb:s601","name":"松平 美波穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:70196:89659:15488:1","source":"bangumi"}]},{"characterId":"char_c43542","characterName":"御影 百合","sourceIds":{"bangumi":[{"characterId":"89660","match":"exact-normalized-name-in-linked-work","subjectId":"70196"}],"egsCharacterIds":["7937"],"vndbCharacterId":"c43542"},"originalCharacterName":"御影 百合","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Saki and I have been best friends with you two since kindergarten. So, you know, we pick up on these things.\""},{"spoiler":false,"text":"The twins’ childhood friend and a classmate of Ichika', Yuri is the easygoing, freewheeling sort, though her jokes make her sound like a dirty old man."},{"spoiler":false,"text":"She enjoys ogling girls' panties and takes great pride in her role helping along the development of Saki's breasts. Gifted with keen intuition, Yuri is always there for her friends when they need her, even if they themselves don’t know it."},{"spoiler":false,"text":"She’s a smart girl, but she conks out after the slightest bit of exercise. Yuri is a member of the literature club and something of an otaku."},{"spoiler":false,"text":"Yuri is the darling of their all-girls school, especially to the underclassmen, and often finds love letters in her locker. She enjoys--no, she revels in being so popular."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c43542"},{"segments":[{"spoiler":false,"text":"一果・双葉の幼馴染で現在も友人。一果と同じクラス。"},{"spoiler":false,"text":"女子校内で特に下級生から人気があり、ラブレターをたくさんもらう（女子から）。"},{"spoiler":false,"text":"そういうモテモテな自分を楽しんでるし大好き。"},{"spoiler":false,"text":"軽めで飄々とした、ちょっとおっさんも入った性格で、女子のぱんつを楽しみにしたり、「沙希のおっぱいはわたしが育てた」などと豪語する。"},{"spoiler":false,"text":"なんだかいろいろとお見通しのような、敏い人で、頭はいい。"},{"spoiler":false,"text":"基本的にノリは軽く飄々としているが、やるときはやる。"},{"spoiler":false,"text":"運動はできない。文芸部所属。ただのオタクという話もある。"}],"source":"egs","sourceCharacterId":"7937","sourceWorkId":"18071","spoiler":false},{"segments":[{"spoiler":false,"text":"「わたしと沙希だって、一果や双葉とは幼稚園からの腐れ縁だからね。"},{"spoiler":false,"text":"いろんなことを察するもんさ」"},{"spoiler":false,"text":"一果・双葉の幼馴染で現在も友人。一果と同じクラス。"},{"spoiler":false,"text":"女子校内で特に下級生から人気があり、ラブレターをたくさんもらう（女子から）。"},{"spoiler":false,"text":"そういうモテモテな自分を楽しんでるし大好き。"},{"spoiler":false,"text":"軽めで飄々とした、ちょっとおっさんも入った性格で、"},{"spoiler":false,"text":"女子のぱんつを楽しみにしたり、「沙希のおっぱいはわたしが育てた」などと豪語する。"},{"spoiler":false,"text":"なんだかいろいろとお見通しのような、敏い人で、頭はいい。"},{"spoiler":false,"text":"基本的にノリは軽く飄々としているが、やるときはやる。"},{"spoiler":false,"text":"運動はできない。文芸部所属。ただのオタクという話もある。"}],"source":"bangumi","sourceCharacterId":"89660"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2ea936b55019cb23592c85070df58c4c9ac8fb633de642544bfba391f7abc8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d557fe6a6c7d3f475859b03587142576006affb20552fdbbd2af9104708234f.webp","width":82,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:70196:89660:10027:1","source":"bangumi"}]},{"characterId":"char_c43543","characterName":"小日向 沙希","sourceIds":{"bangumi":[{"characterId":"89661","match":"exact-normalized-name-in-linked-work","subjectId":"70196"}],"egsCharacterIds":["7938"],"vndbCharacterId":"c43543"},"originalCharacterName":"小日向 沙希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"It's not every day you see such close sisters. You two look more like a pair of lovers.\""},{"spoiler":false,"text":"The twins' childhood friend and a classmate of Futaba's, Saki is a talented cook who pampers her friends with all the love and warmth of a new bride. Her deep concern for her friends leads her to being overprotective, and she can be as fierce as a mother cat with her kittens when it comes to any perceived threat."},{"spoiler":false,"text":"Saki is a member of the tennis club, and despite her docile appearance, she’s a gifted athlete."},{"spoiler":false,"text":"Since they're in both the same club and the same class, Saki looks out for Futaba when Ichika isn’t around."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c43543"},{"segments":[{"spoiler":false,"text":"一果・双葉の幼馴染で現在も友人。双葉と同じクラス。"},{"spoiler":false,"text":"割烹着とかフリルのついた白いエプロンが似合いそうな、ほんわかとした妻っぽい、嫁って感