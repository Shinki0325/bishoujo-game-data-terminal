r childhood friend."}],"source":"vndb","sourceCharacterId":"c77387"},{"segments":[{"spoiler":false,"text":"同じ学園に通う１学年上の先輩。"},{"spoiler":false,"text":"モデルのようなルックスで学園内にファンが多いが、独特の会話のテンポのせいかクラスでは浮いているらしい。"},{"spoiler":false,"text":"実際は世話好きなお姉ちゃんタイプで、とことん甘やかしてくれる。"}],"source":"egs","sourceCharacterId":"20701","sourceWorkId":"27478","spoiler":false},{"segments":[{"spoiler":false,"text":"趣味：弓道、読書　好きな食べ物：お祖母様の作った煮物"},{"spoiler":false,"text":"あなたとしたいこと：全部をお世話したいわ。もちろん○○もね、ふふっ。"},{"spoiler":false,"text":"同じ学園に通う1学年上の先輩。"},{"spoiler":false,"text":"モデルのようなルックスで学園内にファンが多いが、"},{"spoiler":false,"text":"独特の会話のテンポのせいかクラスでは浮いているらしい。"},{"spoiler":false,"text":"実際は世話好きなお姉ちゃんタイプで、とことん甘やかしてくれる。"},{"spoiler":false,"text":"「もうしょうがないわね。いい子いい子してあげるから」"}],"source":"bangumi","sourceCharacterId":"67334"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4250a02afec9a333db17c192e0e9c0fc9674ee688ac8fb90e37327c1e83b4974.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c20ba8a95b0fb5a5124e64d3b28c04e0a2a7ecae45c254a9d49724f14258ba5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331293:67334:8493:1","source":"bangumi"}]},{"characterId":"char_vndb_c85449","characterName":"まあま れいど","sourceIds":{"vndbCharacterId":"c85449"},"originalCharacterName":"まあま れいど","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p391","sourceCompanyId":"egs:brand:1221","can