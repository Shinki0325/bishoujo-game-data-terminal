{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"27646","model":{"presentationWorkId":"vndb:v12705","staff":{"artwork":[],"scenario":[{"creditedName":"黒川 海","creatorId":"vndb:s11917","sourcePersonId":"vndb:s11917","canonicalEntityId":"vndb:s11917","name":"黒川 海","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:100283","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c150759","characterName":"エイト","sourceIds":{"vndbCharacterId":"c150759"},"originalCharacterName":"エイト","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70eb3d81e2c57193dcab950b58a7268231cf212ee6b6f09bb507a35bb002cb75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2b63aa01d4c2bede8446e348620048894dca0fb19d7c9ce755a0d048c5dc8bd.webp","width":241,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 利奈","creatorId":"vndb:s360","sourcePersonId":"vndb:s360","canonicalEntityId":"vndb:s360","name":"佐藤 利奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53539","source":"vndb"}]},{"characterId":"char_vndb_c150760","characterName":"天の声","sourceIds":{"vndbCharacterId":"c150760"},"originalCharacterName":"天の声","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"若本 規夫","creatorId":"vndb:s8","sourcePersonId":"vndb:s8","canonicalEntityId":"vndb:s8","name":"若本 規夫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53534","source":"vndb"}]},{"characterId":"char_vndb_c69759","characterName":"綾崎 ハヤテ","sourceIds":{"vndbCharacterId":"c69759"},"originalCharacterName":"綾崎 ハヤテ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1111"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Violin"},{"spoiler":false,"text":"Dislikes: Kotetsu Segawa, anyone who hurts Nagi, his parents"},{"spoiler":false,"text":"Hayate has had to work to support his parent's bad habits since the age of eight, always moving from job to job, as he is fired when he is discovered to be underage. Hayate's dad is unemployed and his mother is a compulsive gambler, which leads inevitably to their bankruptcy."},{"spoiler":false,"text":"Hayate is a very selfless and generous person, always trying to help others in need even if it means causing harm to himself. He is very independent and skilled in many things, i.e being a good cook, housekeeper, and he can even identify fake works of art with one glimpse (thanks to one of his father's con jobs in the past) among many others. He has super human strength, tremendous speed, retaliation, and endurance allowing him to do things which are normally impossible. However, Hayate is rather dense when it comes to love. His poor empathy is always troubling him as he always misunderstands the feelings of people around him."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69759"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce0d6eff456c88d5e397d166eff7f518aa6e5f25eee6c48f9c41bad5e7a73ca2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b6ef4d9b4d73cfa0042b5a65b8efac7bc215e4e0a56a15b98db0c5c997997b4.webp","width":241,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 利奈","creatorId":"vndb:s360","sourcePersonId":"vndb:s360","canonicalEntityId":"vndb:s360","name":"佐藤 利奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53538","source":"vndb"}]},{"characterId":"char_vndb_c69760","characterName":"三千院 ナギ","sourceIds":{"vndbCharacterId":"c69760"},"originalCharacterName":"三千院 ナギ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1203"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"138"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"29"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Manga (reading, drawing, and writing), anime, video games"},{"spoiler":false,"text":"Dislikes: School, spicy food, dark places, finance, learning, being kidnapped, losing to anyone, being alone"},{"spoiler":false,"text":"Nagi is the only heir to the Sanzenin fortune. She isn't just your average \"rich girl.\" Calling her \"rich\" would be selling her short. The \"Sanzenin fortune\" is so large, throwing away 20 trillion yen in a red herring investment is considered a prank."},{"spoiler":false,"text":"Nagi is a short-tempered, spoiled, anti-social or socially withdrawn, hates to lose and to admit her faults, has a considerably hard time confessing her true feelings towards Hayate or anything in the fact of the matter, she acts immature a large portion of the time but is ultimately a good, educated girl. She is good at finance and likes to learn. Her mind is possessed with her own. She cares for her family and friends, but she doesn't want to show her concern directly. Since going outside is very dangerous because of her status, Nagi favors staying at home. Not liking company in general, she lives away from her grandfather in a \"small\" (compared to the main Sanzenin estate) mansion with minimal staff. Despite her Otaku NEET-like lifestyle, she is intelligent enough to skip 3 grades at school, which even turns out to be one of Tokyo's most prestigious academies."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69760"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b88a1dc0261c846b14fbd64e9778c0818c0603574fb683e364d6e7325aa19dd3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0920de7823ecf616dd1ac152b7e97afab86c3b727c33ebf8f0b3d1ed3d0d236.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"釘宮 理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53540","source":"vndb"}]},{"characterId":"char_vndb_c69761","characterName":"マリア","sourceIds":{"vndbCharacterId":"c69761"},"originalCharacterName":"マリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1224"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: General housework, singing and karaoke, games (video games, chess, billiards), teasing people"},{"spoiler":false,"text":"Dislikes: Cockroaches"},{"spoiler":false,"text":"Maria is Nagi's maid and surrogate older sister/mother, both appearing and acting in a manner more mature than people typical of her age. Because of this, even people near to her speak of her as if she is older than she really is, a pet peeve for her. A phrase she commonly responds back with is \"I'm still a fresh seventeen year old.\""},{"spoiler":false,"text":"Maria is highly intelligent, somewhat devious, good at general housework and likes games of all kinds, though she's deadly afraid of cockroaches, which she refers to as \"the dark life-form that exists in the kitchen and other places.\" She has also proved capable of self-defense techniques in times of need. Maria also placed her mark in Hakuou by being the youngest student council president at the age of 10 in her first year. Despite this, she has no clue about the \"normal life.\""},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69761"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63792d9eabd84448e269af6fa3f5b69cbb4fdef8d94ef77c0bc94086e0a97aec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d223ba6b0191793de0ca06a3587a528cc7ff2a5ec06a45125ae22437c179ce7d.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 理恵","creatorId":"vndb:s1665","sourcePersonId":"vndb:s1665","canonicalEntityId":"vndb:s1665","name":"田中理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53545","source":"vndb"}]},{"characterId":"char_vndb_c69762","characterName":"渡良瀬 ミカゲ","sourceIds":{"vndbCharacterId":"c69762"},"originalCharacterName":"渡良瀬 ミカゲ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c86e2dc99f9dc034fc0bc112c5e01017cd6efc88f0b44bbe51a380c9dbd4fd1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/1079438612c96e96ba4953b5d842f6608e94885f42b8ce188c78e99531ca20e8.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島 愛","creatorId":"vndb:s15801","sourcePersonId":"vndb:s15801","canonicalEntityId":"vndb:s15801","name":"中島 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53551","source":"vndb"}]},{"characterId":"char_vndb_c69763","characterName":"桂 ヒナギク","sourceIds":{"vndbCharacterId":"c69763"},"originalCharacterName":"桂 ヒナギク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"303"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Family, studying, cooking, kendo"},{"spoiler":false,"text":"Dislikes: High places, aircrafts, losing, ghosts, scary stories"},{"spoiler":false,"text":"Hinagiku is the current student council president, and kendo club president at Hakuou Academy, and an expert with swords, specifically kendo swords."},{"spoiler":false,"text":"Hinagiku is very capable in everything. It seems that whatever she turns her hand to, she will excel at it. Despite not being a senior or the most wealthy student, she was elected as president of the student council. She is deeply respected by both her juniors and seniors. In addition to all of that, Hinagiku is admired by many male and female students (due to her beauty and her quality to excel in almost everything). Thus, she is seen and adored as a school idol in Hakuo Academy."},{"spoiler":false,"text":"Hinagiku is usually seen by others as possessing heavy masculine qualities, since Hinagiku often acts tough in front of others. However, it can be seen that the reason she acts like this (being tough) is to keep her image as the president of the student council (or of the entire academy as well) who has everything under control."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69763"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e753b6fb4aa21c808a96ca7e3d8162b640f4e853e69de67f2d36422a183b0cd7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3278db52783db540d25c943f072e7cfbb6ab6b04cafedd5385a6c967753c044.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53541","source":"vndb"}]},{"characterId":"char_vndb_c69764","characterName":"愛沢 咲夜","sourceIds":{"vndbCharacterId":"c69764"},"originalCharacterName":"愛沢 咲夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"12"},"birthday":{"reviewState":"source-only","source":"vndb","value":"403"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"31"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Comedy, looking after kids, horse-riding"},{"spoiler":false,"text":"Dislikes: People who can't take jokes or don't like comedy, any life-form that eats fermented soy beans"},{"spoiler":false,"text":"Sakuya is Nagi's cousin from Kansai. Like Nagi, Sakuya is very rich and has a similar personality — loud, arrogant, abusive of servants, and unwilling to accept defeat in anything; Nagi is one of the few people who can stand up to her wrath, as Sakuya is the one who has known Nagi the longest."},{"spoiler":false,"text":"Sakuya is obsessed with stand-up comedy especially in Manzai style. She encouraged Hayate to become a comedian because she believes that Hayate's life up to now is nothing more than a comedy."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69764"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4e2aedda79d6282bd7e8d66b2ad0ee52468f2d7c2b785870228d29e0a4cd11a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c7b37f7724df737e30e4b74e1d8a109596e867897d5af95d9d8e3d21d0796c5.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"植田 佳奈","creatorId":"vndb:s17","sourcePersonId":"vndb:s17","canonicalEntityId":"vndb:s17","name":"植田 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53535","source":"vndb"}]},{"characterId":"char_vndb_c69872","characterName":"鷺ノ宮 伊澄","sourceIds":{"vndbCharacterId":"c69872"},"originalCharacterName":"鷺ノ宮 伊澄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"birthday":{"reviewState":"source-only","source":"vndb","value":"924"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"30"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Cooking, sewing, harp, tea ceremonies, calligraphy, flower arrangement, Nagi, Nagi's manga, cats"},{"spoiler":false,"text":"Dislikes: Wearing modern clothes, monsters, getting wet"},{"spoiler":false,"text":"Nagi's best friend who is soft-spoken, kind and a good cook, and on top of that likes Nagi's manga. While she does not have an awful sense of direction, she constantly gets lost due to the fact that she is apt to forget her destination and route while exterminating demons. Also, the fact that she can disappear from peoples' eyes instantaneously only complicates the matter. However, she believes herself to be reliable and independent (a belief further enforced by the flighty nature of her mother and grandmother). She also has a habit of saying that a machine is broken when she doesn't understand how to use a machine or an electronic device such as a cell phone or a vending machine."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69872"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1587af7f2fd45a854201729ae3ff07f9da236e68672a16ffc0737bf3cf6a88e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca93597d4f8f78c5dc14b8366d8f9adff16f0359abb6fbab064293e46c7485db.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松来 未祐","creatorId":"vndb:s1667","sourcePersonId":"vndb:s1667","canonicalEntityId":"vndb:s1667","name":"松来未祐(松木美愛子)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53546","source":"vndb"}]},{"characterId":"char_vndb_c69873","characterName":"西沢 歩","sourceIds":{"vndbCharacterId":"c69873"},"originalCharacterName":"西沢 歩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"515"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Delicious and sweet food"},{"spoiler":false,"text":"Dislikes: Unknown"},{"spoiler":false,"text":"Ayumu is a girl from Hayate's previous school, Shiomi High School. She has had a crush on Hayate ever since their first meeting, but could never get the courage to confess while he was around at school. She violently lashes out at anyone who badmouths her and Hayate despite her kind appearance."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/baded707d8ce1402698590ac2945d32d7612a26548364b132a60a07103f4fbbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc252daae8cca0476d079d347cb48f3ac5b5b3f6c6bb13e3bbe0fbbb7d773192.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋 美佳子","creatorId":"vndb:s1866","sourcePersonId":"vndb:s1866","canonicalEntityId":"vndb:s1866","name":"高橋美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53548","source":"vndb"}]},{"characterId":"char_vndb_c69874","characterName":"橘 ワタル","sourceIds":{"vndbCharacterId":"c69874"},"originalCharacterName":"橘 ワタル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"birthday":{"reviewState":"source-only","source":"vndb","value":"830"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"139"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"32"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Anime, cats"},{"spoiler":false,"text":"Dislikes: Nothing"},{"spoiler":false,"text":"Wataru is Nagi's fiance who is actually in love with Isumi. The engagement was set by Enkyou Tachibana, Wataru's grandfather and current head of the Tachibana family and its assets. Wataru owns and lives in a video rental shop, and wholeheartedly believes that if he works untiringly, he will someday be able to surpass the Sanzenin fortune."},{"spoiler":false,"text":"Wataru can be both strong headed and stubborn like Nagi. He was initially hostile when first encountering Hayate at Nagi's mansion. However after seeing his kind and considerate personality at work various times, he warms up to him and vowed to become more like Hayate one day. Despite being 13, he can be both kind and responsible."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69874"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33bb3d9603ddb4bea9f673b91565c6541851b291792979d5472873de253d4b20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23e796a390982c647cf29dccbff2bbdc7dc1ae63028ff5267f7bbc963124b8cf.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 麻里奈","creatorId":"vndb:s1774","sourcePersonId":"vndb:s1774","canonicalEntityId":"vndb:s1774","name":"井上 麻里奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53547","source":"vndb"}]},{"characterId":"char_vndb_c69875","characterName":"貴嶋 サキ","sourceIds":{"vndbCharacterId":"c69875"},"originalCharacterName":"貴嶋 サキ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"617"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Coffee, maid outfits, making small accessories, Wataru, her grandmother"},{"spoiler":false,"text":"Dislikes: Men touching her, adult videos"},{"spoiler":false,"text":"Saki is Wataru's maid and his employee for the video rental shop. She is significantly older than Wataru and lives with him in his video rental store. Her biggest fear is that Wataru will start watching porn when he reaches puberty, which he denies. She takes a mixture of a servant and elder sister role to Wataru, often changing from being subservient to scolding him depending on the situation."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69875"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d9869859c428103e4dd9d30cf44d9a92dd7c0e8ba9764398a9b9b5c74293fad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0a945444ca8f995cfe0fbf1c99bc45e642f652a08cea41670032834b1201e2f.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島 沙樹","creatorId":"vndb:s44","sourcePersonId":"vndb:s44","canonicalEntityId":"vndb:s44","name":"中島 沙樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53536","source":"vndb"}]},{"characterId":"char_vndb_c69876","characterName":"瀬川 泉","sourceIds":{"vndbCharacterId":"c69876"},"originalCharacterName":"瀬川 泉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"621"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Everyone"},{"spoiler":false,"text":"Dislikes: Nothing"},{"spoiler":false,"text":"Izumi is the class president of Hayate's class at Hakuo Academy and a part of The Hakuo Three Amiga with Miki and Risa. Izumi is a lively and bubbly person who is always seen with a smile and has a cheerful disposition. Like her friends, she addresses Hayate as \"Hayata\"."},{"spoiler":false,"text":"From Hayate no Gotoku Wiki"}],"source":"vndb","sourceCharacterId":"c69876"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/cha