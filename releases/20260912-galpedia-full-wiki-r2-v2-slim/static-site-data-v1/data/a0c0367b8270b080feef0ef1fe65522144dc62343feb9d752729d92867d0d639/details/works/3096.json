:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:17295","source":"vndb"}]},{"characterId":"char_vndb_c45173","characterName":"阿国 あかね","sourceIds":{"vndbCharacterId":"c45173"},"originalCharacterName":"阿国 あかね","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"36"},"bust":{"reviewState":"source-only","source":"vndb","value":"107"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"I"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Midori's older sister."},{"spoiler":false,"text":"It is said that her ancestors were tayu (highest ranking courtesan) of Yoshiwara."},{"spoiler":false,"text":"She graduated at the top of her class from the medical department of Jonan University and was a legendary doctor, but at some point in her life she gave up the scalpel and became a school doctor at Shuuya's school. She is a good woman with a big sisterly heart."},{"spoiler":false,"text":"She is quite the glutton and she likes to say \"My stomach is the universe\"."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c45173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b9fb9467588571d2a99eabd875cc343e12ed369214dd434702cf3a09d74a4cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/939e4578cc5320d33ecde85ad7f4989264d5385d3a58bdc60704919492ae7e82.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":