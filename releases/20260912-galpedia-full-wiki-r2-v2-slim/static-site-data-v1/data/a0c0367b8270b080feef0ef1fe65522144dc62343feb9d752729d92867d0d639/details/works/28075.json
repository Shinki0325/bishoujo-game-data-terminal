s":"source-native","relationId":"vndb:vn-staff:157968","source":"vndb"},{"creditedName":"うさぎいンく","creatorId":"vndb:s38017","sourcePersonId":"vndb:s38017","canonicalEntityId":"vndb:s38017","name":"うさぎいンく","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157975","source":"vndb"}]},"cast":[{"characterId":"char_c83843","characterName":"種村 小柚子","sourceIds":{"bangumi":[{"characterId":"70642","match":"exact-normalized-name-in-linked-work","subjectId":"285076"}],"egsCharacterIds":["21717"],"vndbCharacterId":"c83843"},"originalCharacterName":"種村 小柚子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's senior by 1 year who goes to the same school. She's not bad at being docile, but she prefers to be active and often visits the batting center."},{"spoiler":false,"text":"Good at taking care of others, she's through and through a virtuous person who, above all else, feels happy helping others in their times of need."},{"spoiler":false,"text":"A former student council president, she is beloved by both males and females because of her powerful and lively personality which pulls in those around her."},{"spoiler":false,"text":"And yet, due to her model-like appearances, there is a rumor that she was confessed to by 99 guys since she entered the school."},{"spoiler":false,"text":"However, because of her dynamic and powerful personality, she doesn't have any confidence in herself as a female, so she secretly puts great effort into increasing her femininity."}],"source":"vndb","sourceCharacterId":"c83843"},{"segments":[{"spoiler":false,"text":"主人公の通う学園の１つ上の先輩。"},{"spoiler":false,"text":"大人しくしていることは苦手ではないが、体を動かすことが好きでよくバッティングセンターに通っている。 面倒見がよく、誰かを助けて喜んでくれることがなにより嬉しいと感じる根っからの善人。 元生徒会長であり、 周囲を引っ張っていく豪快さと力強さから男女問わず慕われている。 それでいてビジュアル的にもモデルのような美人タイプのため、 学園に入学して以来９９人の男子に告られているという噂がある。 しかし、その豪快で力強い性格から、本人は女性としての自信を持っておらず、密かに女子力を上昇させようと努力している。"}],"source":"egs","sourceCharacterId":"21717","sourceWorkId":"28075","spoiler":false},{"segments":[{"spoiler":false,"text":"面倒見のいい先輩。豪快さと力強さを持ち、男女問わず周りから慕われている。入学以来、９９人の男子から告白されたと噂されるほど。"}],"source":"bangumi","sourceCharacterId":"70642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b9fbed5281efda4a5dc477f8ef704135d8b28f079b50c8da524cb9c4c2e4ec6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cace9c75237a84af37ac889e8f9c088c8c1fc4c47d2069023cdd398dcf8e2438.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石上静香","creatorId":"vndb:s7852","sourcePersonId":"vndb:s7852","canonicalEntityId":"vndb:s7852","name":"石上 静香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285076:70642:14414:1","source":"bangumi"}]},{"characterId":"char_c83844","characterName":"上ノ山 芽愛","sourceIds":{"bangumi":[{"characterId":"70643","match":"exact-normalized-name-in-linked-work","subjectId":"285076"}],"egsCharacterIds":["21718"],"vndbCharacterId":"c83844"},"originalCharacterName":"上ノ山 芽愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's junior who goes to the same school as him. She is a hit with the juniors at her part time job and is one of the few fondly remembered seniors there."},{"spoiler":false,"text":"She is a bright and positive mood maker, so the more she's bullied, the more she shines. She finds her identity in being messed with, so if she's not bullied, then she'll find a way to bully herself."},{"spoiler":false,"text":"She's prone to feeling lonely, so she has a habit of thrusting into any place where people are gathered. She often looks like she is seriously listening to what people are saying, but in truth she has very little brain capacity, so she rarely remembers what was said. Due to that, she fails many times, but tries very hard in secret to improve."},{"spoiler":false,"text":"And yet, she is a genius when it comes to getting easily carried away and then looking smug about it, which, naturally, irritates those around her."}],"source":"vndb","sourceCharacterId":"c83844"},{"segments":[{"spoiler":false,"text":"主人公の通う学園の後輩であり、バイト先でも後輩に当たることもあり数少ない年上の先輩として懐かれている。"},{"spoiler":false,"text":"とにかく明るくボジティブで、イジられればイジられるほど輝きを増すムードメーカー。 本人としてもイジられることにアイデンティティを見出しており、むしろイジられないと自分からイジられにいく。 寂しがりやで人が集まっているところに突っ込んで行く習性がある。 根は真面目で人の話もきちんと聞いているように見えるが、実は脳内のキャパは小さいため話の内容はほとんど頭に入らない。 そのため失敗することも多く、人知れず影で努力している。 それでいて調子に乗りやすくすぐにドヤっては、周囲の人間をナチュラルにイラつかせる天才。"}],"source":"egs","sourceCharacterId":"21718","sourceWorkId":"28075","spoiler":false},{"segments":[{"spoiler":false,"text":"学園やバイト先で懐かれている後輩。イジられることが好きで、寂しがりやな性格も相まって人が集まるところに突っ込んでいく。"}],"source":"bangumi","sourceCharacterId":"70643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c0c1fdc0ceb9ec822f021ceb9c87381c3bdaff611a7d4c8d046ed299f658ca0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fd068c3ee6a9c82f2f08d5552a30b76e2c90d30869f003fd0c588b7e9cbf9e1.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小澤みのり","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285076:70643:32659:1","source":"bangumi"}]},{"characterId":"char_c83845","characterName":"四谷・グレンジャー・ハンナ","sourceIds":{"bangumi":[{"characterId":"70644","match":"exact-normalized-name-in-linked-work","subjectId":"285076"}],"egsCharacterIds":["21719"],"vndbCharacterId":"c83845"},"originalCharacterName":"四谷・グレンジャー・ハンナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Of the heroines, she is the only one to have gone to a prestigious all-girls school and to have come from Finland."},{"spoiler":false,"text":"Due to having a sister with a leg disability, she aims to be a strong big sister for her. With a pure personality, she treats everyone equally. Because of her kindness, she was given the nickname \"Princess\"."},{"spoiler":false,"text":"It's often thought that she is someone who likes to be indoors, but she has an extremely strong curiosity, so she enjoys discovering new things and strolling on unknown paths."}],"source":"vndb","sourceCharacterId":"c83845"},{"segments":[{"spoiler":false,"text":"ヒロインの中で唯一お嬢様学校に通う、フィンランドからきたお嬢様。"},{"spoiler":false,"text":"足の不自由な妹がいるため姉としてしっかり者でいようと心がけている。 ピュアな性格と、誰に対しても平等に接する優しさから姫というあだ名で噂されることも。 インドア派に思われがちだが、好奇心が非常に強く新しい発見を求めて知らない道を散歩するのが好き。"}],"source":"egs","sourceCharacterId":"21719","sourceWorkId":"28075","spoiler":false},{"segments":[{"spoiler":false,"text":"日本に来て間もない海外出身のお嬢様。ピュアな性格で、誰に対しても平等に接する優しさから、\"姫\"というあだ名で噂されることも。"}],"source":"bangumi","sourceCharacterId":"70644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4a541d38ebaa9f842548179cdc4c612c9d674f854c39b76aa421d3274591c33.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13cc8051ba64cd66afef04c14592fc7d29e1c5b40f229e0ba15a6edc4c565773.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285076:70644:13368:1","source":"bangumi"}]},{"characterId":"char_c83850","characterName":"ドS会長","sourceIds":{"bangumi":[{"characterId":"70645","match":"exact-normalized-name-in-linked-work","subjectId":"285076"}],"egsCharacterIds":["21720"],"vndbCharacterId":"c83850"},"originalCharacterName":"ドS会長","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"810"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The current student council president of the school the protagonist goes to. Due to her personality which doesn't allow for compromise when it comes to getting results, she is called a sadist by those around her. Since Maya is fundamentally a sadist, she does not show any interest in anyone who is not fun to toy with."},{"spoiler":false,"text":"In any case, she is a perfectionist who hates losing, but is a kind person who is able to show compassion towards others. She doesn't drop her cool behavior for anyone except for the person with whom she decides let her guard down. With this person, her playful and mischievous side is shown. The complex with her is that you can be laughing while also being scared."}],"source":"vndb","sourceCharacterId":"c83850"},{"segments":[{"spoiler":false,"text":"主人公の通う学園の現生徒会長。"},{"spoiler":false,"text":"成果をあげるためなら一切の妥協を許さない性格のため、周囲からはそこだけを見てドＳと言われている。 しかし摩耶は根本的にＳ気質なので、イジっても面白くない相手にはむしろ一切興味を示さない。 とにかく負けず嫌いで、完璧主義者だが基本的には相手を思いやれる優しい子。 誰に対してもクールな態度を崩さないが、気を許した相手にだけはイタズラをしかけたりと茶目っ気のある一面も持つ。 笑うと怖がられることがコンプレックス。"}],"source":"egs","sourceCharacterId":"21720","sourceWorkId":"28075","spoiler":false},{"segments":[{"spoiler":false,"text":"成果を上げるためなら一切の妥協を許さない生徒会長。とにかく負けず嫌いで完璧主義だが、基本的には相手を思いやれる優しい性格。"}],"source":"bangumi","sourceCharacterId":"70645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fd4764676499614c0ea5afc72a5ede06a7285500ff3d1a665bc8ec72bab2665.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd94484d241698acb80c4593f8d1920863756db35861dac6d5041ec4951c6e37.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川育美","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285076:70645:30858:1","source":"bangumi"}]},{"characterId":"char_c83852","characterName":"辻堂 忠臣","sourceIds":{"bangumi":[{"characterId":"207348","match":"exact-normalized-name-in-linked-work","subjectId":"285076"}],"egsCharacterIds":["21721"],"vndbCharacterId":"c83852"},"originalCharacterName":"辻堂 忠臣","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"有数の進学校『私立豪傑館学園』に通うため、実家を離れアパートで一人暮らしをしている本作の主人公。 予備校では成績優秀者として特待生枠で一部の授業料の免除を受けつつ、休日は生活費を補填するためにもアルバイトをするというストイックな一面を持つ。 性格は極めて社交的で、 男に生まれたからには一度くらい女子にモテたいと考え、女子ウケする『イイ男』を目指して努力してきた。 しかし結果はいつも『イイ人』止まり。 そこでこの夏こそは――と奮起して、彼女を作るため一大決心をする。"}],"source":"egs","sourceCharacterId":"21721","sourceWorkId":"28075","spoiler":false},{"segments":[{"spoiler":false,"text":"有数の進学校『私立豪傑館学園』に通うため、実家を離れアパートで一人暮らしをしている本作の主人公。"},{"spoiler":false,"text":"予備校では成績優秀者として特待生枠で一部の授業料の免除を受けつつ、休日は生活費を補填するためにもアルバイトをするというストイックな一面を持つ。 性格は極めて社交的で、 男に生まれたからには一度くらい女子にモテたいと考え、女子ウケする『イイ男』を目指して努力してきた。 しかし結果はいつも『イイ人』止まり。 そこでこの夏こそは――と奮起して、彼女を作るため一大決心をする。"}],"source":"bangumi","sourceCharacterId":"207348"}],"profileFacts":[],"metadataCandidateConflicts":{},"i