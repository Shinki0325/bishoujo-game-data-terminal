se,"text":"学生時代に単純だった性格にはさらに磨きがかかって、"},{"spoiler":false,"text":"半ば豪快の域にまで達している。"}],"source":"egs","sourceCharacterId":"14493","sourceWorkId":"16344","spoiler":false},{"segments":[{"spoiler":false,"text":"近代未来工科学園新入生。惚れっぽい性格に流されるまま、弱小野球部のマネージャーになってしまったいわゆるフツーの女の子。"},{"spoiler":false,"text":"軽そうな外見とは裏腹に意外としっかりモノで、男所帯の野球部を1人で切り盛りしています。"},{"spoiler":false,"text":"年相応にエッチなことには興味津々。"},{"spoiler":false,"text":"そんな性格が相まって、“エッチなご褒美”はどんどんエスカレートしていくことに……"}],"source":"bangumi","sourceCharacterId":"103740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df075efe40d23e0444a06263d7eb775eaea83e983eb619fb96b4df9ce1a7c96c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d682cec11dd7e288cc0acf9639bf3b5e62c515571839e39dac0ff513b95d005.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223726:103740:6351:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p314","sourceCompanyId":"egs:brand:2093","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10890:2093","source":"egs"},{"companyId":"vndb:p314","sourceCompanyId":"vndb:p314","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:1852:v788","source":"vndb"},{"companyId":"vndb:p908","sourceCompanyId":"vndb:p908","canonicalEntityId":"vndb:p908","name":"劇團近未来","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:1853:v788","source":"vndb"},{"companyId":"vndb:p314","sourceCompanyId":"vndb:p314","canonicalEntityId":"vndb:p314","name"