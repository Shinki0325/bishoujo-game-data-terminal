86","sourcePersonId":"vndb:s2886","canonicalEntityId":"vndb:s2886","name":"神代 あみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:20633","source":"vndb"}]},"cast":[{"characterId":"char_c70699","characterName":"神無月 静","sourceIds":{"bangumi":[{"characterId":"140097","match":"exact-normalized-name-in-linked-work","subjectId":"460985"}],"egsCharacterIds":["13351"],"vndbCharacterId":"c70699"},"originalCharacterName":"神無月 静","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無表情でぼそぼそ喋る、ダウナー系の女の子。"},{"spoiler":false,"text":"趣味は読書で、いつもこむずかしい本を読んでいる。"},{"spoiler":false,"text":"恨んでいる相手に悪夢を見せてしまう能力を持っているが、"},{"spoiler":false,"text":"今の彼女ではコントロールできず、無意識に使ってしまう様子。"},{"spoiler":false,"text":"そのことで、人を傷つけてしまったことがトラウマになっているようで……。"}],"source":"egs","sourceCharacterId":"13351","sourceWorkId":"10875","spoiler":false},{"segments":[{"spoiler":false,"text":"相手に悪夢を見せてしまう能力を持つ。"},{"spoiler":false,"text":"悪意に基づくものではなく、本人の意思では制御できないものであるため、もう半ば諦めていて、なるべく他人と距離をとって暮らそうと心に決めている。"},{"spoiler":false,"text":"力に振り回されているだけで、本当は心優しい女の子。"}],"source":"bangumi","sourceCharacterId":"140097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74e2c38d0c67b012c0081a75646398a3b3c06ee654c0f70a9ef39a740cfa0d04.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/776e9e78da8f546494119e28b389a4b7997bf8f8158948f767861c1fe5633b4b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水城 昴","creatorId":"vndb:s17999","sourcePersonId":"vndb:s17999","canonicalEntityId":"vndb:s17999","name":"水城 昴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10445","source":"vndb"}]},{"characterId":"char_c70700","characterName":"古森 明人","sourceIds":{"bangumi":[{"characterId":"140098","match":"exact-normalized-name-in-linked-work","subjectId":"460985"}],"egsCharacterIds":["13352"],"vndbCharacterId":"c70700"},"originalCharacterName":"古森 明人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"喋り方がぶっきらぼうで、目つきが悪く、"},{"spoiler":false,"text":"頬の下に深い傷があるおかげで、ワルそうに見えるが、"},{"spoiler":false,"text":"その実、困った人、寂しそうな人を放っておけないタイプ。"},{"spoiler":false,"text":"両親がおらず、年の離れた姉と二人暮しで、"},{"spoiler":false,"text":"家計の足しにするべくアルバイトをしている。"},{"spoiler":false,"text":"ひょんな事から静に興味を持ち、友達になるべく奮闘する。"}],"source":"egs","sourceCharacterId":"13352","sourceWorkId":"10875","spoiler":false},{"segments":[{"spoiler":false,"text":"ぶっきらぼうなしゃべり方と、目つきの悪さ、頬の下の深い傷のせいでワルそうな雰囲気を持っているが、特に不良というわけではない。"},{"spoiler":false,"text":"両親はおらず、肉親は年の離れた姉だけ。家計の足しにするべくバイトをしている。"},{"spoiler":false,"text":"困った人、寂しそうな人をみるとほうっておけない性格。"}],"source":"bangumi","sourceCharacterId":"140098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdfd88fa64029ae7daefd5826087b126a794657f459f35ae009acf591c451939.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da35f0ddfad2f6e2ebe746ee6223505985366911579850a1db560beca4039e5d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三枝 剣","creatorId":"vndb:s37126","sourcePersonId":"vndb:s37126","canonicalEntityId":"vndb:s37126","name":"三枝 剣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10447","source":"vndb"}]},{"characterId":"char_c70701","characterName":"蜂須賀 華蓮","sourceIds":{"bangumi":[{"characterId":"140099","match":"exact-normalized-name-in-linked-work","subjectId":"460985"}],"egsCharacterIds":["13353"],"vndbCharacterId":"c70701"},"originalCharacterName":"蜂須賀 華蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"浅黒で長身なスポーツ系の美少女。ソフトボール部所属。"},{"spoiler":false,"text":"運動神経が良い分、頭の方はからっきしで、"},{"spoiler":false,"text":"ちえりと一緒に、よくバカをやっては叱られている。"},{"spoiler":false,"text":"しかし、そこには一片の悪意もなく、"},{"spoiler":false,"text":"今時めずらしい、「無垢なバカ」として、幸広と仲良くなっていく。"}],"source":"egs","sourceCharacterId":"13353","sourceWorkId":"10875","spoiler":false},{"segments":[{"spoiler":false,"text":"浅黒で長身のスポーツ系美少女。ソフトボール部所属。"},{"spoiler":false,"text":"運動神経抜群だが、頭は悪く、ちえり（第1話ヒロイン）と共によく馬鹿をやっては叱られる。"},{"spoiler":false,"text":"名前で呼ばれるのが嫌いな為、周囲からはハチと呼ばれる。"}],"source":"bangumi","sourceCharacterId":"140099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf398e7a2726f3c7781c62e6012489f00ed79cee9894fda42d9bfc4fe14d7e25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac81d423c02e7be251c610c72f3d79b1632c20e48618d370115c2994cf184e11.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"唐沢 けい","creatorId":"vndb:s15054","sourcePersonId":"vndb:s15054","canonicalEntityId":"vndb:s15054","name":"唐沢 けい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10443","source":"vndb"}]},{"characterId":"char_c70702","characterName":"日比野 幸広","sourceIds":{"bangumi":[{"characterId":"140100","match":"exact-normalized-name-in-linked-work","subjectId":"460985"}],"egsCharacterIds":["13354"],"vndbCharacterId":"c70702"},"originalCharacterName":"日比野 幸広","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"怠惰で無気力、だらしない雰囲気を持った少年。"},{"spoiler":false,"text":"人の悪意を感じ取れる、「悪意限定」のテレパシストで、"},{"spoiler":false,"text":"幼い頃より、人の悪意ばかりを見てきたため、誰も愛せないでいた。"},{"spoiler":false,"text":"しかし、愛すべきバカ・華蓮と出会ったことにより……。"}],"source":"egs","sourceCharacterId":"13354","sourceWorkId":"10875","spoiler":false},{"segments":[{"spoiler":false,"text":"他人の負の情念が見える能力を持つ。そのせいか、斜に構えたところがある。"},{"spoiler":false,"text":"無気力でだらしない印象を受けるが、根は善良。"}],"source":"bangumi","sourceCharacterId":"140100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b004c6145f8891eb11301eeb9be411b104c9743ebe646fc65ef91256a886abc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed4d5ef40762a0cf81b607a656fe636a06b43e8a80ec2cdbbd5d115ad1cee65c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星野 佑","creatorId":"vndb:s37127","sourcePersonId":"vndb:s37127","canonicalEntityId":"vndb:s37127","name":"星野 佑","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10448","source":"vndb"}]},{"characterId":"char_c70703","characterName":"九条 恭子","sourceIds":{"bangumi":[{"characterId":"140101","match":"exact-normalized-name-in-linked-work","subjectId":"460985"}],"egsCharacterIds":["13355"],"vndbCharacterId":"c70703"},"originalCharacterName":"九条 恭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"非常に好戦的な、「台風」のような性格。"},{"spoiler":false,"text":"前を大きく開けたライダースーツに真っ赤なマフラー、"},{"spoiler":false,"text":"巨大なオールで、今日もチーマー狩りに精を出す。"},{"spoiler":false,"text":"とあるチームを叩きのめした際、護衛されていた白衣の男を見逃すが、"},{"spoiler":false,"text":"これをきっかけに、乱道と出会うことになる。"}],"source":"egs","sourceCharacterId":"13355","sourceWorkId":"10875","spoiler":false},{"segments":[{"spoiler":false,"text":"第3話の大変好戦的なヒロイン。性格は一言で言えば「台風」。"},{"spoiler":false,"text":"前を開けたライダースーツに、赤いマフラー装備。巨大なオールを武器とする。"},{"spoiler":false,"text":"チーマー狩りの賞金稼ぎ。"}],"source":"bangumi","sourceCharacterId":"140101"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21a8100ad531661d71e231237e0363df6d4338eac396a60e2715445415ae97ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/9464f550de392903eda56aa03cb1d558b33016d519214215c0282d9b2dbbdd57.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥田 梨々香","creatorId":"vndb:s15055","sourcePersonId":"vndb:s15055","canonicalEntityId":"vndb:s15055","name":"奥田 梨々香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10444","source":"vndb"}]},{"characterId":"char_c70704","characterName":"長居 乱道","sourceIds":{"bangumi":[{"characterId":"140102","match":"exact-normalized-name-in-linked-work","subjectId":"460985"}],"egsCharacterIds":["13356"],"vndbCharacterId":"c70704"},"originalCharacterName":"長居 乱道","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"くたびれた背広姿のフリー追跡者。"},{"spoiler":false,"text":"椎散製薬会社社長からの依頼で、"},{"spoiler":false,"text":"失踪した同社の研究員・中津修を捜している。"},{"spoiler":false,"text":"その捜査途中で恭子と出会い……。"}],"source":"egs","sourceCharacterId":"13356","sourceWorkId":"10875","spoiler":false},{"segments":[{"spoiler":false,"text":"くたびれた背広姿をしたフリーの追跡者。通称ランドー。"},{"spoiler":false,"text":"椎散製薬社長の依頼で、失踪した椎散製薬の研究員・中津修（なかつ　しゅう）を捜している。"}],"source":"bangumi","sourceCharacterId":"140102"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets