p","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4afab15f2262853490b8deef163a034f339ce0a0ea82d27e8a0b29aa5d2218e7.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"泉 菊之介","creatorId":"vndb:s399","sourcePersonId":"vndb:s399","canonicalEntityId":"vndb:s399","name":"三浦 祥朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50752","source":"vndb"}]},{"characterId":"char_vndb_c154404","characterName":"弧白","sourceIds":{"vndbCharacterId":"c154404"},"originalCharacterName":"弧白","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2180512c911cd3b31cbe0e114cab47e83d2a58928605ff9a49e62d9aa831a6b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b13b685e85d114952eba3d7dabe40defb887c040262ff6cbb0590848bd91de1.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ルネッサンス 山田","creatorId":"vndb:s990","sourcePersonId":"vndb:s990","canonicalEntityId":"vndb:s990","name":"前田 剛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50755","source":"vndb"}]},{"characterId":"char_vndb_c22106","characterName":"天現寺橋 怜","sourceIds":{"vndbCharacterId":"c22106"},"originalCharacterName":"天現寺橋 怜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"birthday":{"reviewState":"source-only","source":"vndb","value":"909"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Type: human"},{"spoiler":false,"text":"Skills: exorcising ayakashi"},{"spoiler":false,"text":"Occupation: onmyoji"},{"spoiler":false,"text":"Location: Shinjuku"},{"spoiler":false,"text":"\"Because I'm an onmyoji... It's my job to exorcise ayakashi.\""},{"spoiler":false,"text":"A young man who comes a strict family background, making a living as an onmyoji in the back alleys of Tokyo. He has the power to seal ayakashi and even destroy them if absolutely necessary."},{"spoiler":false,"text":"He takes things at his own pace while avoiding anything he deems too flashy, completely unashamed of his openness to sexual relationships. Times when he is deep in contemplation and scheming, his expression rarely reveals what he is truly thinking."},{"spoiler":false,"text":"Having an aversion to doing tedious work, he leaves the house chores to Basara and prefers to pass the time painting on sliding screens."},{"spoiler":false,"text":"Edited from Moonchime Localization"}],"source":"vndb","sourceCharacterId":"c22106"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78175e0b5202b27ecfe4529c735a79fcfbf21570b2f5f862080a9d16e6c5f83f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23cb413500c71b1c36d170b29216a6063f7c34f5faae1ae720522324630c147f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大鳥 遊二","creatorId":"vndb:s14656","sourcePersonId":"vndb:s14656","canonicalEntityId":"vndb:s14656","name":"高梨 謙吾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50760","source":"vndb"}]},{"characterId":"char_vndb_c22107","characterName":"上大崎 優","sourceIds":{"vndbCharacterId":"c22107"},"originalCharacterName":"上大崎 優","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"birthday":{"reviewState":"source-only","source":"vndb","value":"529"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Type: human"},{"spoiler":false,"text":"Skills: exorcising ayakashi, healing"},{"spoiler":false,"text":"Occupation: onmyoji, running a company, etc."},{"spoiler":false,"text":"Location: Harajuku"},{"spoiler":false,"text":"\"You really like rice, don't you? That's great and all, but you should also be keeping up on fish and meat...\""},{"spoiler":false,"text":"A young man who works as an onmyoji and makes regular appearances on television and in magazines due to his popularity."},{"spoiler":false,"text":"He attended the same junior high and high school as Tengenjibashi, and while he is not as skilled in the art of sealing and destroying ayakashi as his old friend, he does possess the ability to heal."},{"spoiler":false,"text":"He has a tendency to mother others, often fussing over Tengenjibashi―sometimes even scolding him, but he does so for his sake. He makes sure to keep up appearances while on the job as a manager but is an honest and devoted man with a cheerful disposition at heart."},{"spoiler":false,"text":"Edited from Moonchime Localization"}],"source":"vndb","sourceCharacterId":"c22107"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e2a5e19c6413d90fc13ec199514f8d91878de224132adf5f3fb573dd6d907ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1867308a490642a3b9c81d7f943a4a84f78042b0dbc995d3645b8bb62da4270e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"式神雀","creatorId":"vndb:s88","sourcePersonId":"vndb:s88","canonicalEntityId":"vndb:s88","name":"岸尾 だいすけ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50761","source":"vndb"}]},{"characterId":"char_vndb_c22108","characterName":"目黒 将人","sourceIds":{"vndbCharacterId":"c22108"},"originalCharacterName":"目黒 将人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"32"},"birthday":{"reviewState":"source-only","source":"vndb","value":"112"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Type: human"},{"spoiler":false,"text":"Skills: exorcising ayakashi"},{"spoiler":false,"text":"Occupation: onmyoji (for illegal purposes)"},{"spoiler":false,"text":"Location: Kabukicho"},{"spoiler":false,"text":"\"It's been a long time since I've been asked that. I murder any ayakashi in my way, so it's no surprise.\""},{"spoiler":false,"text":"A mysterious man who is a skilled onmyoji but appears to only take commissions through criminal channels. He acts as a lone wolf, coming and going as he pleases, and annihilates any ayakashi he lays his eyes on without hesitation."},{"spoiler":false,"text":"He puts on airs of superiority and confidence, but has the skills to back it up and only knows how to use brute force. There are times he will do anything―even resorting to dirty tactics―to get what he wants, but other times he neglects his job."},{"spoiler":false,"text":"His aggressive, merciless tactics have not only earned scorn from the people around him, but brought him to the attention of the ayakashi."},{"spoiler":false,"text":"Edited from Moonchime Localization"}],"source":"vndb","sourceCharacterId":"c22108"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72b7f1eb71efec7884d22da7106b631086fba2ce8b123055e1b959e59b3b052f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7cb899a056dd4a03f9eadb3814510726e28e90df0b2defaae408a1af3f08fbd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鷹取 玲","creatorId":"vndb:s254","sourcePersonId":"vndb:s254","canonicalEntityId":"vndb:s254","name":"坪井 智浩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50750","source":"vndb"}]},{"characterId":"char_vndb_c22109","characterName":"バサラ","sourceIds":{"vndbCharacterId":"c22109"},"originalCharacterName":"バサラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Type: human"},{"spoiler":false,"text":"Skills: paper form, onmyodo"},{"spoiler":false,"text":"Occupation: shikigami"},{"spoiler":false,"text":"Height: 150~300 cm (can vary)"},{"spoiler":false,"text":"Age: unknown"},{"spoiler":false,"text":"Location: Tengenjibashi Agency"},{"spoiler":false,"text":"\"Hey, wake up, Master! If you don't, I might have to do something naughty...\""},{"spoiler":false,"text":"He is Tengenjibashi's shikigami who has the power to change between a human form and a paper form and is skilled in onmyoji techniques."},{"spoiler":false,"text":"Much like his master, he’s insatiably lusty and solicits him every day, only succeeding around half the time. He has a bubbly personality and openly conveys his wide range of emotions."},{"spoiler":false,"text":"He constantly dotes on his master—who is also his creator—and has a deep affection for him, both emotionally and physically. He courts and tops him whenever he gets the chance, but when he happens to upset him..."},{"spoiler":false,"text":"Edited from Moonchime Localization"}],"source":"vndb","sourceCharacterId":"c22109"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/350cdd609a3684168d49e16fcca6a367f6a76e907bd863695a06eb9ff7e54018.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b9e133268bd3c78251ab50c627623c5cfb9697a54b9fec4bd87baa91ea9ca1b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かとう いつき","creatorId":"vndb:s929","sourcePersonId":"vndb:s929","canonicalEntityId":"vndb:s929","name":"石井 一貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50757","source":"vndb"}]},{"characterId":"char_vndb_c22110","characterName":"バサラ","sourceIds":{"vndbCharacterId":"c22110"},"originalCharacterName":"バサラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/869d4a7cf6e84b8e3a41b1097cba41d1d9223f77f9482ce2d8edc3632e82acee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4e37e46a542bfb4fa0cbb913abbf8a6f9c45533b0735cda6bbc7c15a1f454de.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c22111","characterName":"四谷","sourceIds":{"vndbCharacterId":"c22111"},"originalCharacterName":"四谷","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"188"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Type: ayakashi"},{"spoiler":false,"text":"Skills: binding, curses"},{"spoiler":false,"text":"Occupation: Haori (clan leader)"},{"spoiler":false,"text":"Age: around 800 years old"},{"spoiler":false,"text":"Location: Yotsuya"},{"spoiler":false,"text":"\"Is that how you address a Haori? Such an insolent whelp.\""},{"spoiler":false,"text":"He is the one and only ayakashi with the highest rank of Haori in Yotsuya and takes ayakashi who have caused trouble in the past under his wing. He is benevolent and cherishes his friendships, but is also intimidating when angered."},{"spoiler":false,"text":"He is capable of binding, commanding, and killing with curses. Deeply invested in Tengenjibashi’s view of ayakashi, he keeps a close watch on him and sometimes ends up playfully teasing him."},{"spoiler":false,"text":"He is willing to lend a hand when asked, but demands to be paid back in return. At times, he gives Tengenjibashi various tasks to do, amusing himself with the way he reacts."},{"spoiler":false,"text":"Edited from Moonchime Localization"}],"source":"vndb","sourceCharacterId":"c22111"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/615e532f195642160182d1c410cb0aad262ddaf9c3ec028c6ec8278a32988d1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c50b5db3fec48fc0b3655413df9dedafa2761a9abfcb4bdd28ceed566e5d7800.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"四ツ谷 サイダー","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50753","source":"vndb"}]},{"characterId":"char_vndb_c22114","characterN