:"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96426","source":"vndb"}]},"cast":[{"characterId":"char_c13950","characterName":"七森 胡桃","sourceIds":{"bangumi":[{"characterId":"24337","match":"exact-normalized-name-in-linked-work","subjectId":"62177"}],"egsCharacterIds":["5200"],"vndbCharacterId":"c13950"},"originalCharacterName":"七森 胡桃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"320"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The alternate reality version of Miruku she lives with her brother Akira while their mother is away on business. She is extremely jealous for her brother and wants to be his only girl. This causes her to be at odds with Miruku especially."},{"spoiler":false,"text":"For some reason she is especially bad at magic and cannot keep her transformation for more than a few seconds."}],"source":"vndb","sourceCharacterId":"c13950"},{"segments":[{"spoiler":false,"text":"主人公の妹で、最初に「魔法少女」として覚醒した少女。"},{"spoiler":false,"text":"「もう一人の自分」とも言える存在の「みるく」と出会ったことをキッカケに魔法少女に覚醒するが、魔法少女に変身する際に必要な「歌」が極度の音痴のため上手く歌えず、最初は満足に変身もできないある意味不器用で不幸な女の子。"},{"spoiler":false,"text":"素直で誰からも好かれる性格で、ちょっぴり恥ずかしがり屋の一面も持っている。"},{"spoiler":false,"text":"子供の頃から兄さんが大好きで、マイペースな兄の世話を焼くのが日課……なのだが、しっかり者の反面、兄に対しては際限なく甘くてどんなお願いでも聞いてしまう。"},{"spoiler":false,"text":"みるくと言う新たな妹の登場に終始振り回されながらも、異世界からやってきた彼女を何かと気遣う優しさも見せる。"}],"source":"egs","sourceCharacterId":"5200","sourceWorkId":"18138","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹で、最初に魔法少女として覚醒した少女。"},{"spoiler":false,"text":"もう一人の自分とも言える存在の “みるく” と出会ったことをキッカケに魔法少女に覚醒する。"},{"spoiler":false,"text":"魔法少女に変身する際に必要な “歌” が極度の音痴のため上手く歌えず、最初は満足に変身も出来ない、ある意味不器用で不幸な女の子。"},{"spoiler":false,"text":"素直で誰からも好かれる性格で、ちょっぴり恥ずかしがり屋の一面も持っている。"},{"spoiler":false,"text":"子供の頃から兄さんが大好きで、マイペースな兄の世話を焼くのが日課……なのだが、しっかり者の反面、兄に対しては際限なく甘くてどんなお願いでも聞いてしまう。"},{"spoiler":false,"text":"みるくという新たな妹の登場に終始振り回されながらも、異世界からやってきた彼女をなにかと気遣う優しさも見せる。"},{"spoiler":false,"text":"「兄さんが……兄さんが……わたしに隠れて妹を作ってたぁぁぁっっっっっっ!!」"}],"source":"bangumi","sourceCharacterId":"24337"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"5200","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"5200","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"5200","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"5200","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"5200","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"5200","sourceWorkId":"18138","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/3209203a22aba76dbd94b02eac2547216c4e0635a91909d7efa1dd83d3faefad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bbfd3604ec86d471ec6ccf551fdd46e24306e1626680e1d65ed698a5db4e30e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:62177:24337:6046:1","source":"bangumi"}]},{"characterId":"char_c13951","characterName":"夏目 咲久耶","sourceIds":{"bangumi":[{"characterId":"24338","match":"exact-normalized-name-in-linked-work","subjectId":"62177"}],"egsCharacterIds":["5201"],"vndbCharacterId":"c13951"},"originalCharacterName":"夏目 咲久耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"621"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akira and Kurumi's childhood friend. She took care of them both after their father died while their mother went to work to support them. Because of this, they both often call her Nee-san. She is strict toward Akira, so Kurumi will often tattle on him to her. Her alternate reality self is good friends with Miruku and is also a magical girl."},{"spoiler":false,"text":"She has strong magical powers, but doesn't know how to control them well. This often leads to unintended side effects to her magic."}],"source":"vndb","sourceCharacterId":"c13951"},{"segments":[{"spoiler":false,"text":"学園内で「美しすぎる先輩」と噂される主人公の先輩。"},{"spoiler":false,"text":"後に「魔法少女」として覚醒する。"},{"spoiler":false,"text":"主人公兄妹とは幼なじみの間柄で、二人にとっては憧れのお姉さん的な存在だった。"},{"spoiler":false,"text":"容姿端麗、文武両道、品行方正などなど、歩く完璧四文字熟語の女の子。"},{"spoiler":false,"text":"非常に物腰が柔らかくて、周囲には大人の女性の雰囲気すら漂わせているが、実は人見知りするタイプで、そのくせ寂しがり屋というちょっと困った性格の持ち主。"},{"spoiler":false,"text":"主人公兄妹のことが大好きで、魔法少女に覚醒した後も良き相談役として二人の力になる。"}],"source":"egs","sourceCharacterId":"5201","sourceWorkId":"18138","spoiler":false},{"segments":[{"spoiler":false,"text":"学園内で “美しすぎる先輩” と噂される主人公の先輩。 後に魔法少女として覚醒する。"},{"spoiler":false,"text":"主人公兄妹とは幼なじみの間柄で、ふたりにとっては憧れのお姉さん的な存在だった。"},{"spoiler":false,"text":"容姿端麗、文武両道、品行方正などなど、歩く完璧四文字熟語の女の子。"},{"spoiler":false,"text":"非常に物腰が柔らかく、周囲には大人の女性として見られている。"},{"spoiler":false,"text":"しかし実は人見知りするタイプで、そのくせ寂しがり屋というちょっと困った性格の持ち主。"},{"spoiler":false,"text":"主人公兄妹のことが大好きで、魔法少女に覚醒した後も良き相談役としてふたりの力になる。"},{"spoiler":false,"text":"「彰ちゃん、そういうこと言ったらダメだよ？"}],"source":"bangumi","sourceCharacterId":"24338"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"5201","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"5201","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"5201","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"5201","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"5201","sourceWorkId":"18138","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"5201","sourceWorkId":"18138","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1