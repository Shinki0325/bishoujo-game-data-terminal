Id":"vndb:s9183","canonicalEntityId":"vndb:s9183","name":"黒衣","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:120796","source":"vndb"}]},"cast":[{"characterId":"char_c34045","characterName":"月島 沙織","sourceIds":{"bangumi":[{"characterId":"33666","match":"exact-normalized-name-in-linked-work","subjectId":"134488"}],"egsCharacterIds":["7160"],"vndbCharacterId":"c34045"},"originalCharacterName":"月島 沙織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the student council president of Seiou Academy and the only daughter of the chairman of the Tsukishima Group, a world-famous large corporation."},{"spoiler":false,"text":"She is attractive, intelligent, proper, good-natured, and good with people. She is considered the ideal \"oujo-sama\" and is popular among students of both schools, regardless of gender."},{"spoiler":false,"text":"However, in reality, she is a bit sloppy and troublesome. She'll sometimes lie down and eat sweets when no one's looking."},{"spoiler":false,"text":"\"Ren-kun, you always go along with my selfishness, don't you?\""}],"source":"vndb","sourceCharacterId":"c34045"},{"segments":[{"spoiler":false,"text":"世界的にも有名な大企業「月島グループ」を経営するの会長の一人娘にして清桜学園の学生会長。"},{"spoiler":false,"text":"来年度の学園統合に向けて、二校の学生間の架け橋になるよう、清桜学園理事長である凜に頼まれ、蓮と共に従事する。"},{"spoiler":false,"text":"容姿端麗、頭脳明晰、礼儀作法を心得ており、気だてがよくて、人当たりもよい。"},{"spoiler":false,"text":"清桜学園内のみならず、白羽学園の学生からも男女問わず人気のある高嶺の花のお嬢様を絵に描いたような女性。"},{"spoiler":false,"text":"しかし、本当はずぼらな面があり、少々面倒くさがり屋。"},{"spoiler":false,"text":"誰も見ていないときは、ねっ転がってお菓子を食べてることも。"}],"source":"egs","sourceCharacterId":"7160","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"清桜学園の学生会長。 世界的にも有名な大企業・月島グループの会長の一人娘。"},{"spoiler":false,"text":"容姿端麗・頭脳明晰で、礼儀作法を心得ており、気立てが良く人当たりも良い。"},{"spoiler":false,"text":"高嶺の花のお嬢様を絵に描いたような女性で、両校の学生から男女問わず人気がある。"},{"spoiler":false,"text":"しかし本当は少しずぼらで面倒くさがり屋。 寝転がってお菓子を食べていることも。"},{"spoiler":false,"text":"理事長に頼まれ、統合される両校の学生間の架け橋になるよう、蓮と行動を共にする。"},{"spoiler":false,"text":"「蓮くんって、いっつもわたしの我がままに付き合ってくれるよね」"}],"source":"bangumi","sourceCharacterId":"33666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f0649473587b2bc54081847dc1abc3f1ef46901ed00490e9c029f52e1b4262d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b1d6291e11376c446261569448bcdbdfbf02da22d6e9e5e92242040b6658523.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134488:33666:8580:1","source":"bangumi"}]},{"characterId":"char_c34046","characterName":"柊 美桜","sourceIds":{"bangumi":[{"characterId":"33667","match":"exact-normalized-name-in-linked-work","subjectId":"134488"}],"egsCharacterIds":["7161"],"vndbCharacterId":"c34046"},"originalCharacterName":"柊 美桜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of Miki Hiiragi, Shiraba Academy's Board Chairman."},{"spoiler":false,"text":"She is serious and has a strong sense of responsibility, and because she is the younger sister of the Board Chairman, she tends to give off a prickly first impression. However, when you talk to her in person, she treats everyone equally, regardless of gender."},{"spoiler":false,"text":"She is an ordinary, cheerful girl, albeit also having a bit of an airheaded side. Since entering Shiraba Academy, she has been living in a dormitory away from her parents. She's also is bewildered by the school's integration because she thought she would become the president of Shiraba Academy in the future."},{"spoiler":false,"text":"\"I like this school. That's all.\""}],"source":"vndb","sourceCharacterId":"c34046"},{"segments":[{"spoiler":false,"text":"白羽学園の理事長・柊美紀の実妹。"},{"spoiler":false,"text":"将来的に自分が白羽学園の理事長になると思っていたので学園統合の話が持ち上がり困惑している。"},{"spoiler":false,"text":"責任感が強く、真面目で、さらには理事長の妹ということもあり、初対面では棘のあるイメージを持たれがち。"},{"spoiler":false,"text":"しかし実際に話すと、男女問わず、誰に対しても分け隔てなく接することができる。"},{"spoiler":false,"text":"明るくて笑顔の絶えない至って普通の女の子。"},{"spoiler":false,"text":"やや天然で抜けたところも。"},{"spoiler":false,"text":"白羽学園入学時より、親元を離れて学生寮に住んでいる。"}],"source":"egs","sourceCharacterId":"7161","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"白羽学園の理事長・柊美紀の実妹。"},{"spoiler":false,"text":"マジメで責任感が強く、理事長の妹であるためか初対面で棘のある印象を持たれがち。"},{"spoiler":false,"text":"しかし実際に話すと、男女問わず誰に対しても分け隔てなく接してくれる。"},{"spoiler":false,"text":"明るくて笑顔の絶えない普通の女の子で、やや天然で抜けたところも。"},{"spoiler":false,"text":"白羽学園に入学してからは親元を離れ、学生寮に住んでいる。"},{"spoiler":false,"text":"将来は自分が白羽学園の理事長になると思っていたので、学園統合には困惑している。"},{"spoiler":false,"text":"「あたしはこの学園が好きなの。 それだけ」"}],"source":"bangumi","sourceCharacterId":"33667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d2c16f146adab5a9ce5ff853c1438358af7ceb52809e1b4682dec2a23c5abe6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/383312225caa433c9eefbd722f1d02713bcd6c656ac63eabe61e9aaa1cae85d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134488:33667:6016:1","source":"bangumi"}]},{"characterId":"char_c34047","characterName":"鳴海 朱子","sourceIds":{"bangumi":[{"characterId":"33668","match":"exact-normalized-name-in-linked-work","subjectId":"134488"}],"egsCharacterIds":["7162"],"vndbCharacterId":"c34047"},"originalCharacterName":"鳴海 朱子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The captain of the beach volleyball team at Shiraba Academy. That said, she actually has not participated in any official volleyball matches, but practices hard everyday for the upcoming beach volleyball tournament."},{"spoiler":false,"text":"She is a serious and passionate person who is determined to win, and works hard at everything she does. On the other hand, she tends to be brutally honest and gullible. She's close friends with Mio, a fellow classmate and dormmate."},{"spoiler":false,"text":"She is distressed to learn that she will no longer be able to participate in beach volleyball activities due to the integration of the schools."},{"spoiler":false,"text":"\"I want you to be my helper!　Let's beat the boys' volleyball team together!\""}],"source":"vndb","sourceCharacterId":"c34047"},{"segments":[{"spoiler":false,"text":"白羽学園のバレー部に所属するビーチバレーメンバーのキャプテン。"},{"spoiler":false,"text":"バレー部には籍を置いているだけで、バレー部の試合には一切出場せず、ビーチバレーの大会に向けて、日々練習に励んでいる。"},{"spoiler":false,"text":"勝ち気でまっすぐ、何事にもひたむきに取り組む真面目で熱血なタイプ。"},{"spoiler":false,"text":"反面、愚直すぎて信じ込みやすい。"},{"spoiler":false,"text":"美桜とはクラスメイトで親友。寮仲間でもある。"},{"spoiler":false,"text":"学園統合により、ビーチバレーの活動が出来なくなると知り思い悩んでいる。"}],"source":"egs","sourceCharacterId":"7162","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"白羽学園のバレー部に所属する、ビーチバレーメンバーのキャプテン。"},{"spoiler":false,"text":"バレーの試合には一切出場せず、ビーチバレーの大会に向けて日々練習に励んでいる。"},{"spoiler":false,"text":"勝ち気で真っ直ぐ、何事にもひたむきに取り組むまじめな熱血タイプ。"},{"spoiler":false,"text":"その反面、愚直すぎて騙されやすい一面もある。"},{"spoiler":false,"text":"美桜はクラスメイトで親友。 寮仲間でもある。"},{"spoiler":false,"text":"学園統合により、ビーチバレーの活動ができなくなると知って思い悩んでいる。"},{"spoiler":false,"text":"「あんたに助っ人を依頼したいの！　一緒に男子バレー部を倒しましょう！」"}],"source":"bangumi","sourceCharacterId":"33668"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d74fbfa05f2c1f2211a1f428d89d48e8b724a48987f629f899bcc644a5672565.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7b84f81cd428b7eda72514d7f23907a2523cb01d862e8e6c80b710c8d985985.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134488:33668:5052:1","source":"bangumi"}]},{"characterId":"char_c34048","characterName":"久遠寺 ひより","sourceIds":{"bangumi":[{"characterId":"33669","match":"exact-normalized-name-in-linked-work","subjectId":"134488"}],"egsCharacterIds":["7163"],"vndbCharacterId":"c34048"},"originalCharacterName":"久遠寺 ひより","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the daughter of the president of Kuonji Corporation, a major general trading company run by her father."},{"spoiler":false,"text":"Her mother died when she was very young and so she was only raised by her dad, resulting in her being relatively naïve. She tends to be reserved and shy, but once she gets used to people, she becomes a friendly rabbit-like girl. She is also a clumsy girl who sometimes spins out of control when she rushes forward. Her hobby is making coffee, and is very particular about the beans and blends."},{"spoiler":false,"text":"Her dream is to become a certified barista and open a coffee shop with a wonderful husband. While studying for her certification, she works part-time at the cafeteria of Shiraba Academy, but is not good at serving customers."},{"spoiler":false,"text":"She has been best friends with Ichika for a long time and has a crush on her brother, Ren. She sometimes has girly delusions of falling in love, causing her to blush heavily."},{"spoiler":false,"text":"\"Senpai, I will become a good bride! ...Ah! T-T-That was just a joke!\""}],"source":"vndb","sourceCharacterId":"c34048"},{"segments":[{"spoiler":false,"text":"父親が経営する大手総合商社「久遠寺商事」の社長令嬢。"},{"spoiler":false,"text":"幼い頃に母親が他界しており、男手一つで育てられた一人娘のため、割と世間知らずの箱入り娘。"},{"spoiler":false,"text":"控えめでやや人見知りがちだが、慣れると人懐っこいウサギ系女子。"},{"spoiler":false,"text":"突っ走ると空回りすることがある、どじっ子。"},{"spoiler":false,"text":"コーヒーを入れるのが趣味で、豆やブレンドに特別なこだわりを持っており、将来はバリスタの資格を取って、素敵な旦那様と喫茶店を開くのが夢。"},{"spoiler":false,"text":"白羽学園のカフェテリアでバリスタの勉強がてらアルバイトをしている。"},{"spoiler":false,"text":"控えめで、恥ずかしがり屋さんなので、接客は苦手。"},{"spoiler":false,"text":"一花とは昔からの親友で、その兄である蓮に憧れを抱いている。"},{"spoiler":false,"text":"時々妄想して一人もだえたり、赤面してしまう、恋に恋する乙女。"}],"source":"egs","sourceCharacterId":"7163","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"父親が経営する大手総合商社・久遠寺商事の社長令嬢。"},{"spoiler":false,"text":"幼い頃に母が他界し、男手一つで育てられたおかげか世間知らずな箱入り娘。"},{"spoiler":false,"text":"控えめで人見知りがちだが、慣れると人懐っこいウサギ系女子。"},{"spoiler":false,"text":"また、突っ走ると空回りすることがある ドジっ子。"},{"spoiler":false,"text":"コーヒーを淹れるのが趣味で、豆やブレンドに特別なこだわりを持っている。"},{"spoiler":false,"text":"将来の夢はバリスタの資格を取って、素敵な旦那様と喫茶店を開くこと。"},{"spoiler":false,"text":"資格の勉強がてら白羽学園のカフェテリアでアルバイトをしているが、接客は苦手。"},{"spoiler":false,"text":"一花とは昔からの親友で、その兄である蓮に憧れを抱いている。"},{"spoiler":false,"text":"時々妄想して ひとり悶えたり赤面してしまう、恋に恋する乙女。"},{"spoiler":false,"text":"「先輩っ、わたしイイお嫁さんになりますっ！　……はっ！ い、い、今のナシです、冗談ですっ！」"}],"source":"bangumi","sourceCharacterId":"33669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b81d6cf45cd58e873fbb6f468ca2117ac8b2c28bd70ed63417a015da5319c29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58a0bbfd4ed7a82fe38d809768a4552fc9444c738a946d520bd7bd036eaff655.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹内仁美","creatorId":"vndb:s978","sourcePersonId":"vndb:s978","canonicalEntityId":"vndb:s978","name":"羽鳥いち","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134488:33669:15924:1","source":"bangumi"}]},{"characterId":"char_c34049","characterName":"鏑木 由希江","sourceIds":{"bangumi":[{"characterId":"33670","match":"exact-normalized-name-in-linked-work","subjectId":"134488"},{"characterId":"33670","match":"source-roster","subjectId":"134488"},{"characterId":"33670","match":"source-roster","subjectId":"172774"},{"characterId":"33670","match":"source-roster","subjectId":"356280"}],"egsCharacterIds":["7164"],"vndbCharacterId":"c34049"},"originalCharacterName":"鏑木 由希江","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Known to Ren and Ichika as the \"Kind Older Sister\" who lives next door to the Ougi house."},{"spoiler":false,"text":"Although they go to different schools, the three of them sometimes go to school together when time allows it. Yukie also loves Ren and Ichika as if they were her younger siblings."},{"spoiler":false,"text":"In particular, she shows a playful side to Ren, and likes to tease him sometimes. She is the student council president of Shiraba Academy, and is well respected by the students for her accurate and reliable execution of all tasks."},{"spoiler":false,"text":"\"Hehe. You've changed a lot, haven't you, Ren-kun? ...You've gotten a lot cooler.\""}],"source":"vndb","sourceCharacterId":"c34049"},{"segments":[{"spoiler":false,"text":"皇城家の隣の家に住んでいる、蓮や一花にとっては“お隣りの優しいお姉さん”。"},{"spoiler":false,"text":"由希江も、蓮や一花を弟や妹のように可愛がっており、特に蓮に対しては、時に連に対しては、時にからかったり、悪戯心を出してみたりと、お茶目な一面を見せる。"},{"spoiler":false,"text":"学園は違うが、時間が合えば三人一緒に登校することもある。"},{"spoiler":false,"text":"白羽学園の学生会長をしており、何事にも的確かつ確実に実行するため、学生達からも一目置かれている。"}],"source":"egs","sourceCharacterId":"7164","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"皇城家の隣家に住んでいる、蓮や一花にとっては “お隣りの優しいお姉さん”。"},{"spoiler":false,"text":"学園は違うが、時間が合えば三人一緒に登校することもある。"},{"spoiler":false,"text":"由希江も蓮や一花を弟妹のように可愛がっている。"},{"spoiler":false,"text":"特に蓮に対しては、イタズラ心からからかうなど、お茶目な一面を見せることも。"},{"spoiler":false,"text":"白羽学園では学生会長を務めていて、"},{"spoiler":false,"text":"何事も的確かつ確実に実行するため、学生たちから一目置かれている。"},{"spoiler":false,"text":"「ふふっ。 そういう蓮君だってかなり変わったよ？　……すっごくカッコよくなった」"}],"source":"bangumi","sourceCharacterId":"33670"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1814d23637381819fdc81e54241f67dcb70b24d9f75328391e5df63e838e5b63.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9a15456165476582da8e3e5d8d15a2e307902c682624bc23de5574d08e1224e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134488:33670:11646:1","source":"bangumi"}]},{"characterId":"char_c34050","characterName":"皇城 一花","sourceIds":{"bangumi":[{"characterId":"33671","match":"exact-normalized-name-in-linked-work","subjectId":"134488"},{"characterId":"33671","match":"source-roster","subjectId":"134488"},{"characterId":"33671","match":"source-roster","subjectId":"172774"},{"characterId":"33671","match":"source-roster","subjectId":"197438"}],"egsCharacterIds":["7165"],"vndbCharacterId":"c34050"},"originalCharacterName":"皇城 一花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ren and Rin's younger stepsister. Their mother's (Ren's father's second marriage partner)'s child from another spouse. The kids met when they were in elementary school after their parents remarried."},{"spoiler":false,"text":"A reliable person who handles all of the household chores. She is also an excellent honors student. She is shy, and has a hard time talking to the opposite gender. When she's just with Ren she likes to call him \"Onii-chan\" and fawn on him."}],"source":"vndb","sourceCharacterId":"c34050"},{"segments":[{"spoiler":false,"text":"蓮と凛の義理の妹。母親（蓮の父親の再婚相手）の連れ子。"},{"spoiler":false,"text":"小学生の頃に、互いの両親が再婚し知り合う。"},{"spoiler":false,"text":"家では家事全般をこなすしっかり者。"},{"spoiler":false,"text":"学校では成績優秀な優等生。"},{"spoiler":false,"text":"内気な性格で、異性と話すのは少々苦手。"},{"spoiler":false,"text":"蓮と二人っきりの時は「お兄ちゃん」と呼んで、甘えてくることも。"}],"source":"egs","sourceCharacterId":"7165","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"蓮と凛の義理の妹。 母親（蓮たちの父の再婚相手）の連れ子。"},{"spoiler":false,"text":"小学生の頃に互いの両親が再婚して知り合った。"},{"spoiler":false,"text":"家では家事全般をこなすしっかり者。 学園では成績優秀な優等生。"},{"spoiler":false,"text":"内気な性格なので、異性と話すのは少し苦手。"},{"spoiler":false,"text":"蓮とふたりっきりの時は 「お兄ちゃん」 と呼んで、甘えてくることも。"},{"spoiler":false,"text":"「兄さんはわたし一筋ですもんね？」"}],"source":"bangumi","sourceCharacterId":"33671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e25fcd81f7314c13b3d565e19544e89a38eb3696882205e23a9577d734a76e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cad1a5185bff3d741b8e31a0fb57902dab28cd307a6ffc17343610c6c987317.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134488:33671:10662:1","source":"bangumi"}]},{"characterId":"char_c34171","characterName":"りんりん","sourceIds":{"bangumi":[{"characterId":"33674","match":"exact-normalized-name-in-linked-work","subjectId":"134488"}],"egsCharacterIds":["7166"],"vndbCharacterId":"c34171"},"originalCharacterName":"りんりん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is Ren's older brother and Mio's brother-in-law. He is the president of Seiou Academy and also the president of the Ougi Group. He is a theoretical type, a rationalist and perfectionist who only focuses on efficiency and results."},{"spoiler":false,"text":"He always makes decisions and takes actions with the best interest of his employees and students in mind, and always leads them in the right direction. He is sometimes accused of being ruthless and has many enemies, but there are also many people who respect and admire him. He also cares about his family and shows a gentle side in front of his younger siblings."},{"spoiler":false,"text":"He is going to marry his fiancé, Miki Hiiragi, in the spring of next year. After getting to know Miki, his personality gradually softened, which surprised Ren and Ichika."}],"source":"vndb","sourceCharacterId":"c34171"},{"segments":[{"spoiler":false,"text":"蓮の実兄、一花にとっては義理の兄。"},{"spoiler":false,"text":"清桜学園の理事長にして、皇城グループの社長を務めている。"},{"spoiler":false,"text":"効率や結果のみを重視する合理主義で完璧主義者。"},{"spoiler":false,"text":"理論派タイプ。"},{"spoiler":false,"text":"族を大切に思っており、弟妹の前では優しい一面を垣間見せる。"},{"spoiler":false,"text":"仕事では敵も多く、時には冷酷だと陰口を叩かれることもあるが、いつでも社員や学生達のことを一番に考えて行動、決断し、必ず良い方向に導く。"},{"spoiler":false,"text":"敵も多いが、尊敬し慕っている人も多い。"},{"spoiler":false,"text":"普段はクールで無表情。"},{"spoiler":false,"text":"来年春に、婚約者の柊美紀と結婚することになっている。"},{"spoiler":false,"text":"美紀と知り合ったことで、次第に角が取れて丸くなり、蓮や一花を驚かせた。"}],"source":"egs","sourceCharacterId":"7166","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"蓮の実兄、一花にとっては義理の兄。"},{"spoiler":false,"text":"清桜学園の理事長にして、皇城グループの社長を務めている。"},{"spoiler":false,"text":"理論派タイプで、効率や結果のみを重視する合理主義で完璧主義者。"},{"spoiler":false,"text":"いつでも社員や学生たちのことを一番に考えて決断・行動し、必ず良い方向に導く。"},{"spoiler":false,"text":"時には冷酷だと陰口を叩かれることがあり敵も多いが、尊敬し慕っている人も多い。"},{"spoiler":false,"text":"また家族を大切に思っており、弟妹の前では優しい一面を垣間見せる。"},{"spoiler":false,"text":"来年春に、婚約者の柊美紀と結婚することになっている。"},{"spoiler":false,"text":"美紀と知り合ったことで次第に角が取れて丸くなり、蓮や一花を驚かせた。"},{"spoiler":false,"text":"「まあ、仕事も大事だが、家族サービスも大切にしないとな」"}],"source":"bangumi","sourceCharacterId":"33674"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a23d741fe8d1a60f0de04b93186541e60e955573b03b2c6f245e7cc72872e68d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac073eeefa2b89c3d68ed6d05b275c5f64058fb519db522c221dc27d7e729f3d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北山恭祐","creatorId":"vndb:s5570","sourcePersonId":"vndb:s5570","canonicalEntityId":"vndb:s5570","name":"北山 恭祐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134488:33674:20510:1","source":"bangumi"}]},{"characterId":"char_c34172","characterName":"みきぴー","sourceIds":{"bangumi":[{"characterId":"33675","match":"exact-normalized-name-in-linked-work","subjectId":"134488"}],"egsCharacterIds":["7167"],"vndbCharacterId":"c34172"},"originalCharacterName":"みきぴー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Mio's older sister and the president of Shiraba Academy. She took over the position after her mother retired a few years ago. She has a keen eye for cute things, and is especially fond of Mio."},{"spoiler":false,"text":"She is often perceived as unreliable because she calmly goes at her own pace. However, she is able to switch personalities between her private and public life, and when she has to make a decision, she makes it decisively."},{"spoiler":false,"text":"She is engaged to Rin Ougi, the president of Seiou Academy, and is planning to get married next spring."}],"source":"vndb","sourceCharacterId":"c34172"},{"segments":[{"spoiler":false,"text":"美桜の姉で、白羽学園の理事長。"},{"spoiler":false,"text":"数年前に前理事長の母親が理事長職を退任したため、職を継ぐ。"},{"spoiler":false,"text":"清桜学園理事長の皇城凛とは婚約関係にあり、来年春に入籍予定。"},{"spoiler":false,"text":"可愛いものに目がなく、特に妹の美桜を溺愛している。"},{"spoiler":false,"text":"おっとりしていてマイペースなため、頼りない印象を持たれるが、きちんと公私の切り替えが出来るので、決める時はびしっと決める。"}],"source":"egs","sourceCharacterId":"7167","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"美桜の姉で、白羽学園の理事長。"},{"spoiler":false,"text":"母が数年前に理事長職を退任したため、その後を継いだ。"},{"spoiler":false,"text":"可愛いものに目がなく、特に美桜を溺愛している。"},{"spoiler":false,"text":"おっとりしていてマイペースなため頼りない印象を持たれることが多いが、"},{"spoiler":false,"text":"きちんと公私の切り替えが出来るので、決める時はビシッと決める。"},{"spoiler":false,"text":"清桜学園の理事長・皇城凛とは婚約関係にあり、来年春に入籍予定。"},{"spoiler":false,"text":"「私 可愛いものに目がなくって、ぬいぐるみとか見ると、ついぎゅっとしたくなっちゃう……」"}],"source":"bangumi","sourceCharacterId":"33675"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd13c4eba83ff3d797c818c0715beab15773afe306ff12584fc9b72fd4d85ddf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eb80fdd662bd58b8f7aa10494ca50dabce4a9a34cc43568a89a8c1dbab82738.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青木紀子","creatorId":"vndb:s268","sourcePersonId":"vndb:s268","canonicalEntityId":"vndb:s268","name":"青木 紀子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:134488:33675:10343:1","source":"bangumi"}]},{"characterId":"char_vndb_c34170","characterName":"皇城 蓮","sourceIds":{"vndbCharacterId":"c34170"},"originalCharacterName":"皇城 蓮","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"506"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story. The second son of the Ougi family, whose father is the chairman of one of the largest companies in Japan, the \"Ougi Group\". Because he has excellent grades, is athletic, and has a good personality, he tends to be popular with the female students."},{"spoiler":false,"text":"He is serious, pragmatic, and the type of person who thinks before he acts. He acts older than his age, and treats his superiors with courtesy, no matter who they are."},{"spoiler":false,"text":"He respects his older brother Rin, and a lot of his pragmatic personality was due to Rin's influence. His step-sister Ichika sometimes tells him \"You should follow your dreams and ideals\"."},{"spoiler":false,"text":"Although he's not a member of the student council, he tends to help out Saori, the student council president, after school."}],"source":"vndb","sourceCharacterId":"c34170"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c4888022b354ffae80115312b7de748cfa951c0fd9c3e943187aa3685b68ee8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/100b356460fa6d38b430c2524b95f257685507e8a52a84a03ada912b22c92cc2.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2612","sourceCompanyId":"egs:brand:2612","canonicalEntityId":"egs:brand:2612","name":"ensemble","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:22063:2612","source":"egs"},{"companyId":"vndb:p628","sourceCompanyId":"vndb:p628","canonicalEntityId":"vndb:p628","name":"ensemble","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:130917:v17632","source":"vndb"},{"companyId":"vndb:p628","sourceCompanyId":"vndb:p628","canonicalEntityId":"vndb:p628","name":"ensemble","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131103:v17632","source":"vndb"},{"companyId":"vndb:p628","sourceCompanyId":"vndb:p628","canonicalEntityId":"vndb:p628","name":"ensemble","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:159556:v17632","source":"vndb"},{"companyId":"vndb:p23771","sourceCompanyId":"vndb:p23771","canonicalEntityId":"vndb:p23771","name":"Kagami Games","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:159557:v17632","source":"vndb"},{"companyId":"vndb:p628","sourceCompanyId":"vndb:p628","canonicalEntityId":"vndb:p628","name":"ensemble","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:159586:v17632","source":"vndb"},{"companyId":"vndb:p23771","sourceCompanyI