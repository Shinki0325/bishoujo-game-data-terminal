":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12842","source":"vndb"}]},"cast":[{"characterId":"char_c17132","characterName":"雨森望","sourceIds":{"bangumi":[{"characterId":"45479","match":"exact-normalized-name-in-linked-work","subjectId":"5395"}],"egsCharacterIds":["13940"],"vndbCharacterId":"c17132"},"originalCharacterName":"雨森望","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very mysterious character who shows her mysterious side right from the beginning. She officially works as an office lady but is rather antisocial and emotional at times. Even though she is another member of the group she appears to have her own internal demons as well as some connection to the Forest from before the events of the present began. What this connection is however is not known and only time can reveal what is going on between her and the strange land that is Forest."},{"spoiler":false,"text":"From The Other Side of Anime"}],"source":"vndb","sourceCharacterId":"c17132"},{"segments":[{"spoiler":false,"text":"ネクラで惰弱な眼鏡ッ娘OL。"},{"spoiler":false,"text":"親のコネクションで大企業に就職したものの、失敗が多いことから干されている。"},{"spoiler":false,"text":"小動物のようなオドオドした雰囲気の彼女だが、追い込まれるとキレて暴走することも。"}],"source":"egs","sourceCharacterId":"13940","sourceWorkId":"3294","spoiler":false},{"segments":[{"spoiler":false,"text":"ライアーソフト第１１弾「Forest」のヒロイン。"},{"spoiler":false,"text":"内向的で要領の悪い性格のため、なかなか人と打ち解けない。"}],"source":"egs","sourceCharacterId":"13940","sourceWorkId":"9637","spoiler":false},{"segments":[{"spoiler":false,"text":"根暗で惰弱なＯＬ。通称アマモリ。"},{"spoiler":false,"text":"親のコネで大企業に就職するも、失態続きで若くして窓際族。"},{"spoiler":false,"text":"趣味は猫の写真集をながめること。"}],"source":"bangumi","sourceCharacterId":"45479"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad9b0a68f8f4d38561169ebc121b0b09d022925586a75504f902b45d859758f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8192df19180f033d27b7802d81e29a98f76bea198059c17208ef1b8118faa742.webp","width":155,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5395:45479:5741:1","source":"bangumi"}]},{"characterId":"char_c17133","characterName":"黛薫","sourceIds":{"bangumi":[{"characterId":"45480","match":"exact-normalized-name-in-linked-work","subjectId":"5395"}],"egsCharacterIds":["13941"],"vndbCharacterId":"c17133"},"originalCharacterName":"黛薫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A spitfire medical student that is dragged into the strange world that is Forest. She has a very short temper and can be very harsh at times."},{"spoiler":false,"text":"Edited from The Other Side of Anime"}],"source":"vndb","sourceCharacterId":"c17133"},{"segments":[{"spoiler":false,"text":"路上シンガーもこなす医大生。"},{"spoiler":false,"text":"性格は、天真爛漫でおてんば。"},{"spoiler":false,"text":"他の4人に比べ現実主義者だが、妻子持ちの医大の教授と不倫している。"}],"source":"egs","sourceCharacterId":"13941","sourceWorkId":"3294","spoiler":false},{"segments":[{"spoiler":false,"text":"フラッパーで路上シンガーな医大生。"},{"spoiler":false,"text":"現在、大学教授と不倫中。"}],"source":"bangumi","sourceCharacterId":"45480"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4eaec54dfd0eda0b0c5fca519efe18818acd06dc5af28096f8c162d58edae222.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce18c9be536bfe06667cd48fe0490b850f0dd04237ccf8149bece33bd1d25a95.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5395:45480:4832:1","source":"bangumi"}]},{"characterId":"char_c17134","characterName":"刈谷 真季","sourceIds":{"bangumi":[{"characterId":"45481","match":"exact-normalized-name-in-linked-work","subjectId":"5395"}],"egsCharacterIds":["13942"],"vndbCharacterId":"c17134"},"originalCharacterName":"刈谷 真季","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very mature and pragmatic women who acts as a parental figure for the group. She also has a past of her own that she will not reveal without some effort. She seeks to understand the mysteries of the Forest so that everyone can escape from this strange land alive and continue with their lives."},{"spoiler":false,"text":"Edited from The Other Side of Anime"}],"source":"vndb","sourceCharacterId":"c17134"},{"segments":[{"spoiler":false,"text":"人気イタリア料理店のフロアマネージャー。"},{"spoiler":false,"text":"真面目で面倒見の良い、落ち着いた雰囲気の大人の女性。"},{"spoiler":false,"text":"遺憾ながら自由奔放に動き回る他の4人をまとめ役となる。"}],"source":"egs","sourceCharacterId":"13942","sourceWorkId":"3294","spoiler":false},{"segments":[{"spoiler":false,"text":"まじめで面倒見のよい大人の女性。"},{"spoiler":false,"text":"マイペースな周囲にふりまわされる。"},{"spoiler":false,"text":"予約でいっぱいのイタリア料理店フロアマネージャー。"}],"source":"bangumi","sourceCharacterId":"45481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc98b41021ca28ba69ed6d04a378ec42e42b909d9b3aa1e9a2f09c9ce530580e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5af5a7194c77734e4b55a038f547e3b8ea18452b68261c34eb573de9a7513ef3.webp","width":97,"height":256,"source":"static-detail"},"actors":[{"creditedName":"栗原雅子","creatorId":"vndb:s298","sourcePersonId":"vndb:s298","canonicalEntityId":"vndb:s298","name":"野月 まひる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5395:45481:6570:1","source":"bangumi"}]},{"characterId":"char_c17135","characterName":"黒いアリス","sourceIds":{"bangumi":[{"characterId":"45483","match":"exact-normalized-name-in-linked-work","subjectId":"5395"}],"egsCharacterIds":["13944"],"vndbCharacterId":"c17135"},"originalCharacterName":"黒いアリス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious girl that seems to know a lot more about what’s going on than the other main characters and appears to have an agenda of her own. She appears as a gothic Lolita type and does in fact go by the name Alice."},{"spoiler":false,"text":"Edited from The Other Side of Anime"}],"source":"vndb","sourceCharacterId":"c17135"},{"segments":[{"spoiler":false,"text":"［森］の代弁者として主人公らの前に現れ、様々な挑発を繰り返す謎の少女。"},{"spoiler":false,"text":"彼女の正体はいったい……？"}],"source":"egs","sourceCharacterId":"13944","sourceWorkId":"3294","spoiler":false},{"segments":[{"spoiler":false,"text":"不思議の国のアリス。"},{"spoiler":false,"text":"“森”の代弁者として主人公たちの前に現れ、さまざまな挑発を繰り返す。"}],"source":"bangumi","sourceCharacterId":"45483"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f6b55bec6b692a00c7621dd9e2ec032ca4d5678a14461a27006a5e63771fcc4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1fd2f46aaa0bc9bc271d13805ed089f199823a73f94f0642cb650d03cd5a3b8.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5395:45483:4675:1","source":"bangumi"}]},{"characterId":"char_c17136","characterName":"九月周","sourceIds":{"bangumi":[{"characterId":"45482","match":"exact-normalized-name-in-linked-work","subjectId":"5395"}],"egsCharacterIds":["13943"],"vndbCharacterId":"c17136"},"originalCharacterName":"九月周","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman of the streets who has been dragged into this strange world. She is actually a very carefree and outgoing individual and acts kind of like the groups anchor in the storm. She tries to see the better things to come but also has some inner demons of her own that she does not share right away with everyone."},{"spoiler":false,"text":"From The Other Side of Anime"}],"source":"vndb","sourceCharacterId":"c17136"},{"segments":[{"spoiler":false,"text":"一般他者とはちょっと違った思考回路を持つソープ嬢。"},{"spoiler":false,"text":"ざっくばらんでマイペースな性格。"},{"spoiler":false,"text":"新宿ジャンキーで怪しい知人も多く、新宿から離れると廃人同然になってしまう。"}],"source":"egs","sourceCharacterId":"13943","sourceWorkId":"3294","spoiler":false},{"segments":[{"spoiler":false,"text":"新宿中毒であるソープランド嬢。少々独創的な思考回路と世界観を持つ。『ディプロマシー』や『カタン』など、テーブルゲームのファンでもある。リドルに巻き込まれたこと自体を楽しんでいる節があり、奔放かつマイペースに物語世界を引っかき回すこともしばしば。喫煙者であり、銘柄はチェリー、無ければホープを愛飲している。"}],"source":"bangumi","sourceCharacterId":"45482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e32a5d6d8ef232b31e1533d8302fbc5d094fab1f6c5d66cdf1b6e0bfb95f0b5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6271731fd9407601f9f22357e837f049688c0339541b955a11ed2b96c06ad188.webp","width":103,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5395:45482:4830:1","source":"bangumi"}]},{"characterId":"char_c3731","characterName":"城之崎灰流","sourceIds":{"bangumi":[{"characterId":"45478","match":"exact-normalized-name-in-linked-work","subjectId":"5395"}],"egsCharacterIds":["13939"],"vndbCharacterId":"c3731"},"originalCharacterName":"城之崎灰流","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A drifter by admission and a very mysterious individual overall. He gives very little information about himself and seems to want to have as little to do with everyone in the group as possible. He seems to have a strange connection to the events going on in Forest but what exactly that connection is will not be explained by him."},{"spoiler":false,"text":"From The Other Side of Anime"}],"source":"vndb","sourceCharacterId":"c3731"},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"新宿の繁華街や路地裏をうろつく放蕩者。"},{"spoiler":false,"text":"モグリの家庭教師で生計を立てているらしいが、ジャグラーを気取って路上でパフォーマンスすることも。"},{"spoiler":false,"text":"愛煙する煙草の銘柄は「GOLDEN BAT」。"}],"source":"egs","sourceCharacterId":"13939","sourceWorkId":"3294","spoiler":false},{"segments":[{"spoiler":false,"text":"ライアーソフト第１１弾「Forest」の主人公。"},{"spoiler":false,"text":"詩人。潜りの家庭教師で生計を立てる。"},{"spoiler":false,"text":"皮肉屋で、なかなか自らの本心を明かさない。"}],"source":"egs","sourceCharacterId":"13939","sourceWorkId":"9637","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"詩人とうそぶき、新宿の繁華街や路地をうろつく、スノッブな放蕩者。"},{"spoiler":false,"text":"モグリの家庭教師業で生計を立てる。"},{"spoiler":false,"text":"ジャグラーを気取って路上に立つことも。"},{"spoiler":false,"text":"煙草はGOLDEN BAT。"}],"source":"bangumi","sourceCharacterId":"45478"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c08213935079b310875592c447f8c79ceb78b1add559b328f45200862fa4e533.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/599445d4d88c01eff41b40eebf513192b2532b7885892169ec2ed0f5dd4a23e6.webp","width":98,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c13236","characterName":"橘 けーこ","sourceIds":{"vndbCharacterId":"c13236"},"originalCharacterName":"橘 けーこ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3f5a2ee80bd7a80727e44a75af706aea9283a2814940bb2ab2ca5aa05b9434b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/071e169d74e43807e0ce0e1077a4dafb97f09fba882123baff7cc98825bf852d.webp","width":240,"height":248,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:307","sourceCompanyId":"egs:brand:307","canonicalEntityId":"egs:brand:307","name":"Liar-soft(ビジネスパートナー)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:3294:307","source":"egs"},{"companyId":"vndb:p29","sourceCompanyId":"vndb:p29","canonicalEntityId":"vndb:p29","name":"Liar-soft","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-produ