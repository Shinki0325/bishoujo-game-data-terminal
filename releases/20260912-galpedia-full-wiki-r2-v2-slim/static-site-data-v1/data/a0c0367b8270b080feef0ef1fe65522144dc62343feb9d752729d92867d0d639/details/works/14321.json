良家のお嬢様を演じている。"},{"spoiler":false,"text":"そのような鬱憤を溜め込む生活を続けていたため、ストレス解消法としてSMにハマってしまう。"},{"spoiler":false,"text":"実はドがつくほどのサドで、1人になると打って変わって女王様のような言動になる。"}],"source":"bangumi","sourceCharacterId":"56518"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"11467","sourceWorkId":"14321","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"11467","sourceWorkId":"14321","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"11467","sourceWorkId":"14321","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e68a2402a1c7976e2d161e20d64424bf1e937788e07e3cb26baddefc7cfeff52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86b0cd3b7a6bf0ca1b3a07709d2cc4a0bb9f9f8c125a13b016c70b52a3c3fb7b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50374:56518:11511:1","source":"bangumi"}]},{"characterId":"char_c18353","characterName":"小水瀬 秋","sourceIds":{"bangumi":[{"characterId":"56519","match":"exact-normalized-name-in-linked-work","subjectId":"50374"}],"egsCharacterIds":["11469"],"vndbCharacterId":"c18353"},"originalCharacterName":"小水瀬 秋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful lady, and the main character’s target. After marrying, her husband was transferred overseas, and she has lived alone ever since."},{"spoiler":false,"text":"Her husband shows no signs of coming back and she has had no sexual relations in many years, so she spends her days obsessed with masturbation."},{"spoiler":false,"text":"She is somewhat thick-headed, but fundamentally a steady person."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c18353"},{"segments":[{"spoiler":false,"text":"主人公のターゲットになる人妻。"},{"spoiler":false,"text":"結婚後、夫が海外赴任となってしまい、ずっと1人暮らしをしている。"},{"spoiler":false,"text":"夫はなかなか帰ってこないので性交渉は何年もしておらず、自慰行為にふける日々を過ごしている。"},{"spoiler":false,"text":"性格は鈍感なところもあるが、基本的にしっかりしている。"}],"source":"egs","sourceCharacterId":"11469","sourceWorkId":"14321","spoiler":false},{"segments":[{"spoiler":false,"text":"伴斗のターゲットになる人妻。"},{"spoiler":false,"text":"結婚してすぐに夫が長期の海外赴任になり、なかなか会えない状態になってしまう。"},{"spoiler":false,"text":"それからの秋は野菜を邪な目で見てしまうほど欲求不満になり、ネット通販で大人の玩具を買い漁り、自慰行為にふける日々を過ごしている。"}],"source":"bangumi","sourceCharacterId":"56519"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"11469","sourceWorkId":"14321","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"11469","sourceWorkId":"14321","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"11469","sourceWorkId":"14321","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b19beb574cc9919609fbd6f12720ef7259fb0c888b88fafdf45d8b651fc75b62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6295db31a7ef7a2c19a7e017dcd7c49d37eff75cb126f7a3f1dfc0aa