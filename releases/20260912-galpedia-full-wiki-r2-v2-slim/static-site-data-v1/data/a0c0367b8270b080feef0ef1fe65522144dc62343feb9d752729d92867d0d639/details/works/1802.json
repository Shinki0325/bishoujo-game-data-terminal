egsCharacterIds":["13577"],"vndbCharacterId":"c114309"},"originalCharacterName":"蓬莱 藍華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の兄・圭介の妻で、良家のお嬢様。ワイン好きだが、酒癖はあまり良くない。"},{"spoiler":false,"text":"かつて悠弥の家庭教師を務め、悠弥の初恋＆横恋慕の相手。ただ彼の告白は断っている。"},{"spoiler":false,"text":"専業主婦で、家族を大切に思っている。悠弥の想いに気付きながらも良い姉弟であろうと接しているが…。"}],"source":"egs","sourceCharacterId":"13577","sourceWorkId":"1802","spoiler":false},{"segments":[{"spoiler":false,"text":"悠弥の兄・圭介の貞淑な妻"},{"spoiler":false,"text":"身長162cm、体重48kg、B85cm、W57cm、H82cm"},{"spoiler":false,"text":"現在、屋敷で主婦業に専念している。誰よりも夫の圭介を深く愛しており、また、家族に対しても深い愛情を注いでいる。女の盛りでありながら色々な事情により、夜の生活は決して満たされてはいない・・・"}],"source":"bangumi","sourceCharacterId":"108954"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/645f8a1efb35ecd172034d64c4c17322935b081d8f9872c9c4e3e5da5929a1b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fe69a90a66eae232e66f7ed34af51a48d44a97f120bb9eaac3c2ac0e53531ac.webp","width":133,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c114310","characterName":"蓬莱 くるみ","sourceIds":{"bangumi":[{"characterId":"108955","match":"exact-normalized-name-in-linked-work","subjectId":"227082"}],"egsCharacterIds":["13578"],"vndbCharacterId":"c114310"},"originalCharacterName":"蓬莱 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"28"}},"descriptions":[{"segments":[{"spoiler":false,"text":"藍華の歳が離れた妹。すぐに悠弥に懐き、「お兄ちゃん」と呼んで慕ってくる。"},{"spoiler":false,"text":"コンピュータ好きで、その勉強も好き。明るく元気な子だが、実は…？"},{"spoiler":false,"text":"悠弥も結婚式のときですら彼女を見たことがないらしい…？"},{"spoiler":false,"text":"エッチにも興味津々らしい。"}],"source":"egs","sourceCharacterId":"13578","sourceWorkId":"1802","spoiler":false},{"segments":[{"spoiler":false,"text":"藍華の歳の離れた妹"},{"spoiler":false,"text":"身長142cm、体重28kg"},{"spoiler":false,"text":"なぜか、いつも家に居る。悠弥に懐いていて、「お兄ちゃん」と慕っている。元気で明るい娘だが、実は・・・"}],"source":"bangumi","sourceCharacterId":"108955"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37402a4ea6e91f6fc04e71676f7dff5e32efe3d35cf2991f98f8c99cf9f402fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e458ffcf3cc19221d45cb58d1d3f3359eb11a42fe663a93734eb35c9116d62b.webp","width":149,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c114311","characterName":"九条 菫","sourceIds":{"bangumi":[{"characterId":"108956","match":"exact-normalized-name-in-linked-work","subjectId":"227082"}],"egsCharacterIds":["13579"],"vndbCharacterId":"c114311"},"originalCharacterName":"九条 菫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"35"}},"descriptions":[{"segments":[{"spoiler":false,"text":"葵の口利きで蓬莱家のメイドをしている。料理や洗濯、掃除など家事全般をそつなくこなし、よく気が付く。"},{"spoiler":false,"text":"あまり感情を表に出さないため、何を考えているのか良く分からない。が、時折それらしい感情が表に出ることもある。"},{"spoiler":false,"text":"存在感が希薄な女性だが彼女への印象は人によって違うらしい。くるみとは特に仲良し。"}],"source":"egs","sourceCharacterId":"13579","sourceWorkId":"1802","spoiler":false},{"segments":[{"spoiler":false,"text":"蓬莱家のメイド"},{"spoiler":false,"text":"身長152cm、体重35kg、B78cm、W53cm、H72cm"},{"spoiler":false,"text":"感情の起伏が表に出ず、また存在感が希薄だが、気配りのきくできた女性である。だが、彼女に対する印象は、不思議なことに、人によって大きく違っている。"}],"source":"bangumi","sourceCharacterId":"108956"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cd3596e5f22bbe85a4fd4ee272e825e9fd875313d04bfc8da2bde9eeaa583e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f3db249ba6073cfe57921b3d863aab9a360d491f7856483a2faa80c85e2f24f.webp","width":142,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c114312","characterName":"御堂 葵","sourceIds":{"bangumi":[{"characterId":"108957","match":"exact-normalized-name-in-linked-work","subjectId":"227082"}],"egsCharacterIds":["13580"],"vndbCharacterId":"c114312"},"originalCharacterName":"御堂 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"蓬莱家に居候する、謎多き妖艶な女性。館に住む理由も含め、京都あたりにいたらしいこと以外は、いろいろ謎が多い。"},{"spoiler":false,"text":"だが屋敷内での信頼はあつく、背筋が凍りつくほどの美貌と不思議な雰囲気で人を魅了する。"},{"spoiler":false,"text":"出会ったばかりの悠弥に積極的に絡んでくるが、その理由は…？"}],"source":"egs","sourceCharacterId":"13580","sourceWorkId":"1802","spoiler":false},{"segments":[{"spoiler":false,"text":"屋敷に住む着物姿の妖艶な美女"},{"spoiler":false,"text":"身長165cm、体重49kg、B88cm、W59cm、H91cm"},{"spoiler":false,"text":"屋敷に住んでいる理由を含め、何かと謎の多い女性である。色々と悠弥に、ちょっかいをかけてくる理由は・・・"}],"source":"bangumi","sourceCharacterId":"108957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a15f9d9fbc3a8f84e95d212a30dde2a92274c2e5e6b9a8fb59280bfb39b40816.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96ed3ff04b8ba30288122e4c3ffc8f9c20f4c06816a9eac134c0feee5ea07e5f.webp","width":133,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c114313","characterName":"葉月 美里","sourceIds":{"bangumi":[{"characterId":"108958","match":"exact-normalized-name-in-linked-work","subjectId":"227082"}],"egsCharacterIds":["13581"],"vndbCharacterId":"c114313"},"originalCharacterName":"葉月 美里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"102"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悠弥の大学時代からの悪友にしてセックスフレンド。大学卒業後は父親の会社にコネで入りＯＬをしている。悠弥のことはまんざらでもないが結婚までは考えていない。"},{"spoiler":false,"text":"性格は軽く、イタズラ好きで意地悪。そのくせ甘えたがりでもある。"},{"spoiler":false,"text":"エッチは大好きでスポーツ感覚。現在は悠弥オンリー。"},{"spoiler":false,"text":"異常なまでに勘が鋭く、特に悠弥の考えていることはほぼ予想がつくほど。そのため悠弥の複雑な運命に巻き込まれてしまう。"}],"source":"egs","sourceCharacterId":"13581","sourceWorkId":"1802","spoiler":false},{"segments":[{"spoiler":false,"text":"悠弥の大学時代からのセックスフレンド"},{"spoiler":false,"text":"身長158cm、体重42kg、B102cm、W57cm、H92cm"},{"spoiler":false,"text":"ちょっとばかりいたずら好きで鋭い勘の持ち主である。その故に、彼女も複雑な運命に巻き込まれることになる。"}],"source":"bangumi","sourceCharacterId":"108958"}],"profileFacts":[],"metadataCandidateConflicts":{"height":[{"comparisonValue":"158","source":"vndb","sourceCharacterId":"c114313","value":"158"},{"comparisonValue":"58","source":"bangumi","sourceCharacterId":"108958","value":"58cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99b16fe02b8fd2e934d15722f849525fc56bb31961b13075896c5674ff3fd071.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d5a9a5df871e84ece739799481b1d456651e169cd795c683e106db31399c767.webp","width":150,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c114307","characterName":"来生 悠弥","sourceIds":{"vndbCharacterId":"c114307"},"originalCharacterName":"来生 悠弥","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"71"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/3874d17ae76e6672f3eb42615debe26051833821a08a5f6d3a777810c02ae92f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16ebc5ed47c344ec254deace2a0b82af28d40e0d830bd6c142192c79cdf2d2f4.webp","width":131,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c114308","characterName":"蓬莱 圭介","sourceIds":{"vndbCharacterId":"c114308"},"originalCharacterName":"蓬莱 圭