e":"vndb"},{"creditedName":"Erizo","creatorId":"vndb:s46187","sourcePersonId":"vndb:s46187","canonicalEntityId":"vndb:s46187","name":"Erizo","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:143921","source":"vndb"},{"creditedName":"FibYar","creatorId":"vndb:s46871","sourcePersonId":"vndb:s46871","canonicalEntityId":"vndb:s46871","name":"FibYar","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:143922","source":"vndb"},{"creditedName":"Dan Salvato","creatorId":"vndb:s14740","sourcePersonId":"vndb:s14740","canonicalEntityId":"vndb:s14740","name":"Dan Salvato","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:143925","source":"vndb"},{"creditedName":"Dan Salvato","creatorId":"vndb:s14740","sourcePersonId":"vndb:s14740","canonicalEntityId":"vndb:s14740","name":"Dan Salvato","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:143926","source":"vndb"},{"creditedName":"Satchely","creatorId":"vndb:s14741","sourcePersonId":"vndb:s14741","canonicalEntityId":"vndb:s14741","name":"Satchely","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:143927","source":"vndb"},{"creditedName":"Jillian Ashcraft","creatorId":"vndb:s14743","sourcePersonId":"vndb:s14743","canonicalEntityId":"vndb:s14743","name":"Jillian Ashcraft","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:143930","source":"vndb"},{"creditedName":"David Evelyn","creatorId":"vndb:s27805","sourcePersonId":"vndb:s27805","canonicalEntityId":"vndb:s27805","name":"David Evelyn","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:143931","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c64502","characterName":"モニカ","sourceIds":{"vndbCharacterId":"c64502"},"originalCharacterName":"モニカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"922"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Monika is noted by the other characters to be smart, beautiful, confident and athletic. She is not as talkative as the other girls, but this is implied to not be through choice. She always has a calm, gentle expression and is portrayed as mature and hard-working."},{"spoiler":false,"text":"Monika had previously been a part of the Debate Club but left due to all the inner politics and drama, highlighting a desire for order, freedom of topics and friendliness. The Literature Club, which she founded after leaving the Debate Club, is very important to her. She aspires for it to be a place to showcase and grow everyone's passion for literature. Monika openly displays care and concern for her club mates, praising each member's writing style and even comparing them to famous authors and poets."},{"spoiler":true,"text":"Starting from Act 2, she shows a much more manipulative personality. It is revealed that Monika was self-aware all along and resented from being made into a minor role. She becomes infatuated with the player and urges them to spend more time with her. Monika begins trying to dispose of her club mates so the player is forced to choose her, after her attempts to make the other girls unlikable fail. Her desire and ambition lead her to become obsessive in this goal, highlighted by the fact that all of her poems are about the player or her epiphany."},{"spoiler":true,"text":"Despite Monika's upbeat attitude in the Literature Club, it becomes increasingly obvious that she is really sad and lonely, as a result of being aware that her whole world is just a simulation; a simulation in which she can't even achieve what is considered \"happiness\" (i.e. having her route completed). She fixates on the player so much because they're the only \"real\" thing in her life. It also does not help that, whenever someone quits the game, Monika is trapped in a hellish void of noise, lights, colors, and screams and despite not even being able to form coherent thoughts, she remembers all of it whenever the player turns on the game again."},{"spoiler":true,"text":"Later in the game, the player will be able to read Monika's Talk where she talks directly to the player, instead of the protagonist. It is shown that nothing about Monika's apparent kindness and politeness is an act, and she even offers the player some genuinely good advice from time to time."},{"spoiler":false,"text":"From DDLC Wiki"}],"source":"vndb","sourceCharacterId":"c64502"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7cd410e1e4ba45cdfdd3cce0d6fe3d6bb57434f4ddadd58d7ec01ac7f0495b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0ff66509e848c86b43a4e8f0d869115e5a4ab13ebb16295743b1f57a881af86d.webp","width":175,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64503","characterName":"サヨリ","sourceIds":{"vndbCharacterId":"c64503"},"originalCharacterName":"サヨリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"511"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sayori is portrayed as a talkative person, being very cheerful and kind and the archetype of a Genki Girl. She is very clumsy and notorious for finding ways to accidentally hurt herself or to drop things. However, despite being airheaded, she is rather cunning, being able to trick others just to get food. She is usually the only character, other than the protagonist, capable of breaking up arguments, and she is described as being paramount to keeping a relaxing atmosphere in the Literature Club, which becomes even more apparent"},{"spoiler":true,"text":"after her suicide."},{"spoiler":false,"text":"Monika notes that while she may look like a good leader, Sayori is usually better when it comes to dealing with people."},{"spoiler":true,"text":"She tries her best to help everyone be happy and dislikes attention directed at her well-being because she feels unworthy of anything that others have to offer her."},{"spoiler":true,"text":"Sayori's depression makes her disorganized, and she often \"cannot find a reason to get out of bed in the morning\"; her room, which the protagonist regularly cleaned for her, is also noted to be untidy. The protagonist notes how there hasn't been much change in her, and the changes the protagonist notices in her later are due to Monika's interference, amplifying her depression and suicidal tendencies. Sayori also doesn't seem to think highly of herself. Her relationship with the Protagonist and other people's happiness are her main coping mechanisms since she believes that if she makes everyone else happy, she will not have a reason whatsoever to be unhappy."},{"spoiler":false,"text":"Edited From DDLC Wiki"}],"source":"vndb","sourceCharacterId":"c64503"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03305bc92a53246716b58a9de5c49b584752ae547b2505019d44ec873af787ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5567ba7edec1496cd89722d6e2107ff5a90ae3f288829e98a185287e417895ba.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64504","characterName":"ユリ","sourceIds":{"vndbCharacterId":"c64504"},"originalCharacterName":"ユリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuri is mature, shy, and has trouble with social interactions. She normally thinks carefully about what she says, but she is easily flustered and will impulsively blurt things out due to nervousness then repeatedly apologize for her outbursts."},{"spoiler":false,"text":"Yuri prefers to write using complex language and layer meaning under metaphors that require detailed interpretation. Yuri's writing and reading preferences greatly contrast with Natsuki's, which can create tension between them."}],"source":"vndb","sourceCharacterId":"c64504"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/013917f6095b8c42222fb4ee392cc5ef24e160c3f8dde6e9db1d2fcb2fe7b6fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12c5f0b9b83c04b8a0d544215ad74cb962285ce0f23999a63aeb1b7f9d37bbd3.webp","width":202,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64505","characterName":"ナツキ","sourceIds":{"vndbCharacterId":"c64505"},"originalCharacterName":"ナツキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"730"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Natsuki is a brash, blunt, cranky, seemingly arrogant girl with a cute, softer interior as a result of insecurity, convincing Monika enough to class Natsuki as the embodiment of a tsundere. While she is impulsive and can speak without thinking, she truly cares about her friends and, even when she has obvious anger issues, doesn't enjoy fights or arguments with people."},{"spoiler":true,"text":"Over the course of the game, we see that she worries about Yuri and on one occasion, gives the Protagonist a note asking him to help Yuri, fearing that if she spoke out then it would cause more arguments."},{"spoiler":false,"text":"She is very stubborn and has a hard time expressing how she feels and what she wants. When repeatedly challenged, she often becomes awkward and tongue-tied, then aggressive, and then simply bursts into tears."},{"spoiler":false,"text":"Her cute interior also involves a love of manga and anime, particularly those in the slice-of-life genre, and baking."},{"spoiler":true,"text":"She has been known to store her manga collection in the Literature Club out of embarrassment, another reason is (hinted at) her father would be angry while the rest of the club obviously knows about her interest, she is still hesitant to talk about it."},{"spoiler":false,"text":"Natsuki also likes cute things, like cupcakes with cat faces. She also likes poems with cuter, happier words, though her own poems are still about sad things, such as being persecuted for your hobbies. she believes that it's important to be able to express something deep with few words. Her simplistic writing style puts her at odds with Yuri, who has a more extravagant style."},{"spoiler":false,"text":"Natsuki dislikes being called \"cute,\" even when she acts as such or does cute things, and will deny any claims from others relating to this; nevertheless, she is much more comfortable exposing her sweet side once she knows people aren't going to tease her about it. she hates it if she isn't taken seriously, whether it's her writing, her hobbies, or just her overall demeanor."},{"spoiler":true,"text":"It is likely she learned to be ashamed of herself and her hobbies, because her classmates judge her and her implied abusive father, making her abrasive nature a coping mechanism. This is also implied in a secret poem, \"Things I Like About Papa\", which is most likely written by her."},{"spoiler":true,"text":"It is shown that she is a very lonely person who desperately craves affection. One example is during the third poetry-sharing session. If she has liked all your poems to date, she outright asks the protagonist if he thinks her poems are the best, which swiftly shifts to her begging him to say they are, even if he hates them."},{"spoiler":false,"text":"Edited From DDLC Wiki"}],"source":"vndb","sourceCharacterId":"c64505"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9123bab39bccf22dfc6aa73e5ab53c26cd42310fda3112537fed0fcdfaa0ecbb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca4670faf4352a970725e2d50306547b6f0b0decf41414a7db7d73ab4884dabe.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64506","characterName":"Protagonist","sourceIds":{"vndbCharacterId":"c64506"},"originalCharacterName":"Protagonist","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The newest member of the literature club and childhood friend of Sayori. He seems to have little interest in literature, but he is willing to try his best for the sake of the club. He has an incredibly attractive presence that seems to have caught the eyes of everyone in the club."}],"source":"vndb","sourceCharacterId":"c64506"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f718ed248875a83f54f1fb21b67def5e0c6f102f226bef49315c690922954e08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74ee36cfd2ae92439ccd7d469fdb8808fd999c8a6d04b83faf3ab93c665c30e9.webp","width":256,"height":144,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p7209","sourceCompanyId":"egs:brand:5688","canonicalEntityId":"vndb:p7209","name":"TEAM SALVATO","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31208:5688","source":"egs"},{"companyId":"vndb:p6209","sourceCompanyId":"vndb:p6209","canonicalEntityId":"vndb:p6209","name":"BakaYume Çeviri Ekibi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:103579:v21905","source":"vndb"},{"companyId":"vndb:p11330","sourceCompanyId":"vndb:p11330","canonicalEntityId":"vndb:p11330","name":"passionplus","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:103580:v21905","source":"vndb"},{"companyId":"vndb:p15893","sourceCompanyId":"vndb:p15893","canonicalEntityId":"vndb:p15893","name":"Cimosoft Codelicious","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:108080:v21905","source":"vndb"},{"companyId":"vndb:p15893","sourceCompanyId":"vndb:p15893","canonicalEntityId":"vndb:p15893","name":"Cimosoft Codelicious","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:108106:v21905","source":"vndb"},{"companyId":"vndb:p15893","sourceCompanyId":"vndb:p15893","canonicalEntityId":"vndb:p15893","name":"Cimosoft Codelicious","roleCodes":["publisher"],"identityStatus":"source-n