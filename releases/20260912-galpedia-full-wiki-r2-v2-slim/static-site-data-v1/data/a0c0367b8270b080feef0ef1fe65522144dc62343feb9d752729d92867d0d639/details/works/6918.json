て完璧なわけでもなく、時々妙に慌てたりもするところが、かわいいところ？"}],"source":"bangumi","sourceCharacterId":"27157"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff06c3fe696ea0d58cdbf9b48518817ef139898f65a36df7894b877d2f4d1929.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/326955c36077274e00ecf89ffff0710d3c3b8b550454b0d9c86baf4658dc1740.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森川陽子","creatorId":"vndb:s5135","sourcePersonId":"vndb:s5135","canonicalEntityId":"vndb:s5135","name":"森川 陽子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24997:27157:34685:1","source":"bangumi"}]},{"characterId":"char_c3043","characterName":"フェイ","sourceIds":{"bangumi":[{"characterId":"27158","match":"exact-normalized-name-in-linked-work","subjectId":"24997"}],"egsCharacterIds":["25941"],"vndbCharacterId":"c3043"},"originalCharacterName":"フェイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A patient of the clinic. A Siamese cat."},{"spoiler":false,"text":"Her condition causes emotional instability, her moods going up and down quickly, like she has two different personalities?"},{"spoiler":false,"text":"Though she's usually a confident (if manic) type of person, she can quickly become paranoid and depressed, refusing to interact with anyone."},{"spoiler":false,"text":"Self-conscious about going into heat. Will refuse treatment until she's almost driven mad by her condition."},{"spoiler":false,"text":"description from Getchu"}],"source":"vndb","sourceCharacterId":"c3043"},{"segments":[{"spoiler":false,"text":"診