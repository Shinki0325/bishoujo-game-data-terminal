":false,"text":"知識では知っていて、大好きな人になら……とは思っている。"},{"spoiler":false,"text":"オナニーは、月に1回するかしないかくらい。"}],"source":"egs","sourceCharacterId":"11595","sourceWorkId":"14121","spoiler":false},{"segments":[{"spoiler":false,"text":"属性：幼なじみ、貧乳、大和撫子、清楚、恥ずかしがりや、コスプレ"},{"spoiler":false,"text":"主人公の幼なじみで、「清楚」 「清純」 といった言葉が似合う、大和撫子な雰囲気を持つ女の子。"},{"spoiler":false,"text":"誰に対しても 「です・ます」 口調で話す。"},{"spoiler":false,"text":"恥ずかしがりやで内向的、本を読むのが好きで、講義のない時は大学の図書館や木陰で読書をしている。"},{"spoiler":false,"text":"大学近くにある喫茶店 『ろまん亭』 でアルバイトをしている。"},{"spoiler":false,"text":"性的なことは奥手。"},{"spoiler":false,"text":"知識では知っていて、大好きな人になら……とは思っている。"},{"spoiler":false,"text":"オナニーは、月に1回するかしないかくらい。"},{"spoiler":false,"text":"「あ……。か、和也くん……おはようございます……。きょ、今日はいい天気ですね……」"}],"source":"bangumi","sourceCharacterId":"145652"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"11595","sourceWorkId":"14121","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"11595","sourceWorkId":"14121","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"11595","sourceWorkId":"14121","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"11595","sourceWorkId":"14121","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"11595","sourceWorkId":"14121","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"41 kg","valueContext":null,"source":"egs","sourceCharacterId":"11595","sourceWorkId":"14121","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/baaa3220cb9f5d150ebdc9644fb51e30332bc2747aa041131e5b1c9df103caf1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93d8