vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65779","source":"vndb"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"vndb:s720","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65781","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65783","source":"vndb"}]},"cast":[{"characterId":"char_c29686","characterName":"荒本 那美","sourceIds":{"bangumi":[{"characterId":"48324","match":"exact-normalized-name-in-linked-work","subjectId":"197596"}],"egsCharacterIds":["15484"],"vndbCharacterId":"c29686"},"originalCharacterName":"荒本 那美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学校の寮の管理人をしている優しくて綺麗なお姉さん。"},{"spoiler":false,"text":"スタイルも抜群で、特に豊満なバストは男子生徒を魅了してやまない。"},{"spoiler":false,"text":"和矢が通っている学校の卒業生で、今は寮の管理人をしながら水泳部のコーチもしている。"},{"spoiler":false,"text":"その競泳水着姿でも男子生徒を魅了しまくっている。那美目当てで入部した男子も多いのだとか。"},{"spoiler":false,"text":"和矢とは元々ご近所さんで、幼い頃から知っている。"},{"spoiler":false,"text":"結婚していたが、婚約者とは死別している。"},{"spoiler":false,"text":"その後で、丁度祖母がしていた学校の寮の管理人を任されることになる。"},{"spoiler":false,"text":"婚約者と死別し、そこから立ち直らせてくれた和矢に想いを寄せているものの、生徒みんなに慕われているので、和矢だけ特別扱いできないことと、年の差を気にして、なかなかいい仲になれないのを悩んでいる。"}],"source":"egs","sourceCharacterId":"15484","sourceWorkId":"12296","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"学校の寮の管理人をしている優しくて綺麗なお姉さん。スタイルも抜群で、特に豊満なバストは男子生徒を魅了してやまない。"},{"spoiler":false,"text":"和矢が通っている学校の卒業生で、今は寮の管理人をしながら水泳部のコーチもしている。その競泳水着姿でも男子生徒を魅了しまくっている。"},{"spoiler":false,"text":"那美目当てで入部した男子も多いのだとか。"},{"spoiler":false,"text":"学校ではアイドル的なお姉さんとして、男子はもちろんのこと女子にも慕われている。親衛隊がいる程の人気。"},{"spoiler":false,"text":"和矢とは元々ご近所さんで、幼い頃から知っている。"},{"spoiler":false,"text":"結婚していたが、婚約者とは死別している。その後、丁度祖母がしていた学校の寮の管理人を任されることになる。"},{"spoiler":false,"text":"婚約者と死別してそこから立ち直らせてくれた和矢に想いを寄せているものの、生徒みんなに慕われているので和矢だけ特別扱いできないことと、年の差を気にしてなかなかいい仲になれないのを悩んでいる。"},{"spoiler":false,"text":"そこへ登場した死神・瑠音に和矢の死を告げられて一大決心。和矢を助けるためという名目で、自身の想いを遂げるべく和矢の子供を妊娠しようと奔走する。"}],"source":"bangumi","sourceCharacterId":"48324"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08ddcac2d93fe0714b9dae43c131d8109bed07cea3985bcba836044b0e83b9d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46bc363a3c3ab5b921821a4a801346d45933eeb970d94aac40f64561bc6d8fbf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197596:48324:6036:1","source":"bangumi"},{"creditedName":"梅里 ミーオ","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36846","source":"vndb"}]},{"characterId":"char_c29688","characterName":"瑠音","sourceIds":{"bangumi":[{"characterId":"48325","match":"exact-normalized-name-in-linked-work","subjectId":"197596"}],"egsCharacterIds":["15485"],"vndbCharacterId":"c29688"},"originalCharacterName":"瑠音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"和矢の命を奪いに魔界からやってきた死神。"},{"spoiler":false,"text":"美少女ではあるが、口調も態度も尊大で、しかもおっちょこちょい。"},{"spoiler":false,"text":"死神としてもまだまだ未熟で、和矢の魂を狩ってやっと一人前になれるらしい。"},{"spoiler":false,"text":"綺麗なお姉さんが大好き。レズッ気があり那美に一目惚れ。"},{"spoiler":false,"text":"和矢から那美を奪おうと必死に作戦を練るが、おっちょこちょいなために失敗したり和矢にやり込められたりする。"},{"spoiler":false,"text":"死神になった暁には、綺麗なお姉さんばかりを集めたハーレムを作るのが夢らしい。"},{"spoiler":false,"text":"そこに那美も加えようと考えている。"}],"source":"egs","sourceCharacterId":"15485","sourceWorkId":"12296","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のサブヒロイン。"},{"spoiler":false,"text":"和矢の命を奪いに魔界からやってきた死神。"},{"spoiler":false,"text":"美少女ではあるが、口調も態度も尊大で、しかもおっちょこちょい。"},{"spoiler":false,"text":"死神としてもまだまだ未熟で、和矢の魂を狩ってやっと一人前になれるらしい。"},{"spoiler":false,"text":"綺麗なお姉さんが大好き。レズッ気があり那美に一目惚れ。"},{"spoiler":false,"text":"和矢から那美を奪おうと必死に作戦を練るが、おっちょこちょいなために失敗したり和矢にやり込められたりする。"},{"spoiler":false,"text":"死神になった暁には、綺麗なお姉さんばかりを集めたハーレムを作るのが夢らしい。そこに那美も加えようと考えている。"}],"source":"bangumi","sourceCharacterId":"48325"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0890e2bf7ecf700f1085e0cd5a3a0cd99a2ee8eb24a4c180c378ee19620a2399.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a44ef6f9e7d20612fd6fb0bbf59de11016143880837651101b5e712ae572d088.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197596:48325:5922:1","source":"bangumi"}]},{"characterId":"char_vndb_c155981","characterName":"高井田 和矢","sourceIds":{"vndbCharacterId":"c155981"},"originalCharacterName":"高井田 和矢","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritati