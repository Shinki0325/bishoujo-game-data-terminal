"sourcePersonId":"vndb:s16974","canonicalEntityId":"vndb:s16974","name":"株式会社トライデントワークス","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160131","source":"vndb"},{"creditedName":"まついさん","creatorId":"vndb:s22108","sourcePersonId":"vndb:s22108","canonicalEntityId":"vndb:s22108","name":"松井 章","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160135","source":"vndb"},{"creditedName":"とらら","creatorId":"vndb:s22109","sourcePersonId":"vndb:s22109","canonicalEntityId":"vndb:s22109","name":"とらら","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:160136","source":"vndb"},{"creditedName":"榧夜","creatorId":"vndb:s43839","sourcePersonId":"vndb:s43839","canonicalEntityId":"vndb:s43839","name":"榧夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160139","source":"vndb"}]},"cast":[{"characterId":"char_c85348","characterName":"夜空","sourceIds":{"bangumi":[{"characterId":"71891","match":"exact-normalized-name-in-linked-work","subjectId":"291000"}],"egsCharacterIds":["21874"],"vndbCharacterId":"c85348"},"originalCharacterName":"夜空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1205"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist, Takumi Mizukami's, imouto who adores her onii-chan. After losing both their parents in a disaster, due to adult circumstances, they were separated half-way through their upbringing. She lives in Sendai."},{"spoiler":false,"text":"Even after being separated, she never forgets about her onii-chan and constantly brags about how stoic but kind he is. Despite being a natural beauty, she has not had any relationships with the opposite sex due to setting her onii-chan as her standard. Due to this, her friends tease her for having a brother complex."},{"spoiler":false,"text":"One day while browsing the Aikotoba app, she stumbles across a user with the alias \"Takumi\" who she has a \"99% compatibility score\" with. Using the alias \"Yozora\", she takes a gamble on destiny and slides into his DMs. Their communications carry on until one day, \"Takumi\" tells her that he'll be in Sendai for business. Seizing the opportunity, she proposes the two should meet up."},{"spoiler":false,"text":"After 7 years of harboring her feelings of adoration for onii-chan, her adoration escalates into a passionate love. As she begins to pursue her onii-chan more and more aggressively, worries surmount."}],"source":"vndb","sourceCharacterId":"c85348"},{"segments":[{"spoiler":false,"text":"主人公・水上拓未の妹。"},{"spoiler":false,"text":"７年前の大きな災害の際に両親を亡くし、兄・拓未とは別の親戚の元に引き取られ、半ば生き別れのようになっていた。"},{"spoiler":false,"text":"昔からお兄ちゃん子で、いまだに兄の話をするので友人達からはブラコンとからかわれることも。"},{"spoiler":false,"text":"また「兄よりカッコイイ人」という基準で男子を見てしまうため、 恋愛経験は一切ない。"},{"spoiler":false,"text":"『夜空』として接していた『タクミ』に対しては『アイコトバ』で相性９９％と診断されたことに運命を感じ、似た境遇への共感ともに、惹かれる想いを感じていた。"},{"spoiler":false,"text":"７年振りに再会を果たした拓未に対し、兄妹としての親愛以上の感情を抱いてしまい、思い悩む。"}],"source":"egs","sourceCharacterId":"21874","sourceWorkId":"28646","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・水上拓未の妹。"},{"spoiler":false,"text":"７年前の大きな災害の際に両親を亡くし、"},{"spoiler":false,"text":"兄・拓未とは別の親戚の元に引き取られ、半ば生き別れのようになっていた。"},{"spoiler":false,"text":"昔からお兄ちゃん子で、いまだに兄の話をするので"},{"spoiler":false,"text":"友人達からはブラコンとからかわれることも。"},{"spoiler":false,"text":"また「兄よりカッコイイ人」という基準で男子を見てしまうため、"},{"spoiler":false,"text":"恋愛経験は一切ない。"},{"spoiler":false,"text":"『夜空』として接していた『タクミ』に対しては"},{"spoiler":false,"text":"『アイコトバ』で相性９９％と診断されたことに運命を感じ、"},{"spoiler":false,"text":"似た境遇への共感ともに、惹かれる想いを感じていた。"},{"spoiler":false,"text":"７年振りに再会を果たした拓未に対し、"},{"spoiler":false,"text":"兄妹としての親愛以上の感情を抱いてしまい、思い悩む。"}],"source":"bangumi","sourceCharacterId":"71891"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"21874","sourceWorkId":"28646","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"21874","sourceWorkId":"28646","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"21874","sourceWorkId":"28646","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"21874","sourceWorkId":"28646","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d8d7d50a4b397a3088377633712ca9bf71d0393d89a6f6968b281d4d008a0e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4434a0d84d59d95dc2acc94a68ac853a49079ff96d3eccf6e449a9f0f566a605.webp","width":80,"height":256,"source":"static-detail"},"actors":[{"creditedName":"末柄里恵","creatorId":"vndb:s6837","sourcePersonId":"vndb:s6837","canonicalEntityId":"vndb:s6837","name":"実羽ゆうき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:291000:71891:12356:1","source":"bangumi"}]},{"characterId":"char_vndb_c85347","characterName":"水上 拓未","sourceIds":{"vndbCharacterId":"c85347"},"originalCharacterName":"水上 拓未","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflict