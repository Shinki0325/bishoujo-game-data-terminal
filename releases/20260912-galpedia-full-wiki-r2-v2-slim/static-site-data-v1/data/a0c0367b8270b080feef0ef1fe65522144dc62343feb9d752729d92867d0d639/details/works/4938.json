ityId":"egs:creator:19614","name":"MA・TANKI","detail":"エグゼクティブプロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:133263","source":"egs"},{"creditedName":"安藤夏","creatorId":"vndb:s8220","sourcePersonId":"egs:creator:25019","canonicalEntityId":"vndb:s8220","name":"安藤夏","detail":"OP曲「私のReason」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:178433","source":"egs"},{"creditedName":"SATOMI","creatorId":"vndb:s3057","sourcePersonId":"vndb:s3057","canonicalEntityId":"vndb:s3057","name":"SATOMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:26438","source":"vndb"},{"creditedName":"安藤 夏","creatorId":"vndb:s8220","sourcePersonId":"vndb:s8220","canonicalEntityId":"vndb:s8220","name":"安藤 夏","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:26441","source":"vndb"}]},"cast":[{"characterId":"char_c54796","characterName":"アイリ","sourceIds":{"bangumi":[{"characterId":"136633","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136633","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25470"],"vndbCharacterId":"c54796"},"originalCharacterName":"アイリ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl adopted into the royal family who has grown up with Al. She is the first in line candidate for marrying Al and calls him 'Onii-sama' because they grew up together."}],"source":"vndb","sourceCharacterId":"c54796"},{"segments":[{"spoiler":false,"text":"主人公の国の姫君。"},{"spoiler":false,"text":"父王の養女で、父王の親友の娘らしいが詳細は不明。"},{"spoiler":false,"text":"主人公とは幼い頃から一緒で、彼女にとって主人公は「兄」のような存在。"},{"spoiler":false,"text":"誰にでも優しく、楚々とした可憐なお姫様で、主人公や王など比ではない程、国民からの支持が高く、他国からも絶賛されている。"},{"spoiler":false,"text":"ヒーリング系の魔法を得意とする魔法の使い手でもある。"}],"source":"egs","sourceCharacterId":"25470","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"自国の姫君。"},{"spoiler":false,"text":"父王が親友の娘を養女として引き取り、主人公と兄妹同然に育てられた。"},{"spoiler":false,"text":"優しく慈愛に満ち溢れた彼女は、国民から、王や主人公とは比較にならないほど絶大な支持を得ており、それは敵対する他国においても変わらない。"},{"spoiler":false,"text":"現在は主人公の妻として、他の姫君たちと甘く幸せな生活を営んでいる。"},{"spoiler":false,"text":"民の声を聞き、それを宮廷で進言するなど内政面でも活躍している。"},{"spoiler":false,"text":"幼い頃から魔法も嗜んでおり、火や水の魔法を操る。"}],"source":"egs","sourceCharacterId":"25470","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"自国の姫。父王の養女である。父王の親友の娘らしいが詳細は明らかでない。魔法（ヒーリング系）の使い手でもある。幼い時から主人公と一緒にいるので主人公の事をお兄様と呼び慕っている。"},{"spoiler":false,"text":"しおらしく、清楚で可憐で美しい。優しく誰もから愛されるこの姫は、国のヒロインであり、主人公や王など比ではない程の人望を持っている。また、敵対する他国などでもこの姫だけは例外で人気が高い。"}],"source":"bangumi","sourceCharacterId":"136633"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23d4b18c1043d60fad3f606d3de6fa3583fe9eef40c1d9658032dadcc8551b9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81ea4da743c5b83afdd5bc41403c58adde421b83d68334a41eecf6fda5aa0cd0.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石松千恵美","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218161:136633:4273:1","source":"bangumi"}]},{"characterId":"char_c54797","characterName":"かぐや","sourceIds":{"bangumi":[{"characterId":"136634","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136634","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25472"],"vndbCharacterId":"c54797"},"originalCharacterName":"かぐや","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遠い東方の国の姫君。"},{"spoiler":false,"text":"彼女の国は、非常に商業が盛んな経済大国として世界的に有名。"},{"spoiler":false,"text":"幼さを残す容姿ではあるが、さすがは一国の姫君という気品を感じさせる。"},{"spoiler":false,"text":"性格は、物静かでおっとりしているが、時折、物事をズバッと射抜くところも。"},{"spoiler":false,"text":"彼女には「巫女」としての力があり、神聖な存在として祀られている。"},{"spoiler":false,"text":"また彼女には小鳥と会話する不思議な力がある。"}],"source":"egs","sourceCharacterId":"25472","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の国から東に遠く離れた商業に秀でた国の姫君。"},{"spoiler":false,"text":"幼さを残す容姿ではあるが、さすがは一国の姫君という気品を感じさせる。"},{"spoiler":false,"text":"性格は、物静かでおっとりしているが、時折、物事をズバッと射抜くところも。"},{"spoiler":false,"text":"彼女には「巫女」としての力があり、神聖な存在として祀られている。"},{"spoiler":false,"text":"また彼女には動物と会話する不思議な力がある。"},{"spoiler":false,"text":"彼女を妻として娶ってからは、主人公の国と彼女の国の貿易が盛んになり、経済援助も得られるようになった。"}],"source":"egs","sourceCharacterId":"25472","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"遠い東の国の姫。商業に関しては右に出るものがなく、頭も良い民族であることは世界的に有名である。また、この姫は巫女の能力を持ち国の神聖な人物として祀られている。主人公とは面識がなく、父の言いつけでここに来た。"},{"spoiler":false,"text":"見た目は若干幼いが黒い髪が美しく品がある。性格はおっとりとしたボケ系なので少しトロいところもあるが、物事をズバッと言うところもある。打解けると、意外にアグレッシブな性格であることがわかるかも。小鳥と話せる特殊能力を持っている。"}],"source":"bangumi","sourceCharacterId":"136634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30e9a5d2f63300faad73b7fb136619665e70cca6597f5c78a53330ef48069e22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb43df4384aee9ab6d47c96ac4484c80a537cecef37976e26204e30fd32f23fb.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"〆野潤子","creatorId":"vndb:s5676","sourcePersonId":"vndb:s5676","canonicalEntityId":"vndb:s5676","name":"〆野 潤子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218161:136634:5080:1","source":"bangumi"}]},{"characterId":"char_c54798","characterName":"シャルロット","sourceIds":{"bangumi":[{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218144"},{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25471"],"vndbCharacterId":"c54798"},"originalCharacterName":"シャルロット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"武力に秀でた国の姫君。"},{"spoiler":false,"text":"姫将軍と謳われる誇り高き戦士の彼女は国民的な英雄であり、その名声は他国にも轟いている。"},{"spoiler":false,"text":"主人公とは面識はなく、また主人公の性格や態度にも、あからさまな不快感を示す。"},{"spoiler":false,"text":"それは彼女自身が、何も知らされないままこの国に連れて来られ、いきなり主人公の妃候補に祭り上げられたことへの怒りを持っているからだ。"},{"spoiler":false,"text":"また主人公とは正反対の性格の許婚もおり、怒りの治まらない彼女は、さっさと国へ戻り、兵をあげて主人公の国へ攻め込むつもりでいるようだ。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"シリーズ最初の『いじってプリンセス』で初登場したプリンセス。"},{"spoiler":false,"text":"以降のシリーズでもその誇り高き姿は健在だが、現在はそのトレードマークである甲冑を脱ぎ捨て主人公の妻として、甘い生活をおくっている。"},{"spoiler":false,"text":"それでもこれまでと変わらず、日々の鍛錬を怠ることなく、主人公の国の軍事力強化にも大いに貢献している。"},{"spoiler":false,"text":"しかし、元許婚の陰謀に巻き込まれてしまい……。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"7299","spoiler":false},{"segments":[{"spoiler":false,"text":"武力の国・ガルランディアの出身の誇り高き姫将軍。"},{"spoiler":false,"text":"最初こそ主人公を毛嫌いしていたが、その心根に触れ、主人公を愛するようになる。"},{"spoiler":false,"text":"現在は、主人公との妻として城で甘い生活を送っているが、日々の鍛錬は怠らず、その剣術の腕前はまったく衰えていない。"},{"spoiler":false,"text":"また彼女が、この国の軍事力強化に大いに貢献していることは間違いなく、兵士たちの錬度は著しく向上している。"},{"spoiler":false,"text":"各国にその名を轟かせる武勇の彼女は、近接攻撃においては無類の強さを発揮し、欠点も少なく、戦場においては最も頼りになる存在。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"武力の国で名を馳せた姫将軍。国民的英雄で他国にもその名声は高い。"},{"spoiler":false,"text":"主人公とは面識はないが、主人公の性格や態度が大嫌い。主人公とまったく正反対の許婚がいる。"},{"spoiler":false,"text":"ある意味だまされて来ているので、この国を憎んでいる。国に帰ったらすぐに攻め込む気でいる。誇り高い戦士。"}],"source":"bangumi","sourceCharacterId":"136635"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f470cdd3ce92707f6ca8d5d52a6dade2177f5c2179e58a4f20aa8d6ec2da4be6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12439b7bbacac27ac770d19d3f23f753ce7084ecbce4df5266fe9e5acfed226d.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小橋知子","creatorId":"vndb:s2331","sourcePersonId":"vndb:s2331","canonicalEntityId":"vndb:s2331","name":"小橋 知子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218161:136635:5224:1","source":"bangumi"}]},{"characterId":"char_c54799","characterName":"ニーナ","sourceIds":{"bangumi":[{"characterId":"136636","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136636","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25476"],"vndbCharacterId":"c54799"},"originalCharacterName":"ニーナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とある貧しい国の姫君だったが、主人公の国に攻め滅ぼされ、現在はメイドとして主人公の身の回りの世話をしている。"},{"spoiler":false,"text":"彼女の国は、国民が常に明るく太陽の国と呼ばれ、そのためか、彼女自身も明朗快活で、いつも笑顔を絶やさず、常にポジティブ思考。"}],"source":"egs","sourceCharacterId":"25476","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の国に責め滅ぼされた貧しい国の姫君。"},{"spoiler":false,"text":"現在は主人公の身の回りの世話をするメイドになっている。"},{"spoiler":false,"text":"彼女の国は、国民が常に明るく太陽の国と呼ばれ、そのためか、彼女自身も明朗快活で、いつも笑顔を絶やさず、常にポジティブシンキング。"},{"spoiler":false,"text":"現在も主人公のメイドとして甲斐甲斐しくお世話をしている。"}],"source":"egs","sourceCharacterId":"25476","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"昔、攻め落とした国の貧乏な国の姫らしい。その国は太陽の国と言われ国民は常に明るかった。そのためなのか、彼女の性格は元気があって活発。つねに前向き思考。"},{"spoiler":false,"text":"現在はこの国のメイドさんで主人公のお世話をしている。"}],"source":"bangumi","sourceCharacterId":"136636"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de634702da951882dbea561c346fbca67f95aa7f98b602e2f28840af653fc1cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bf9c0e767e7d56d290fd7443f8afa7d5453990ae63ead190474f3c5e747ef25.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南川のりこ","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218161:136636:20327:1","source":"bangumi"}]},{"characterId":"char_c54800","characterName":"オーレリア","sourceIds":{"bangumi":[{"characterId":"136714","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25473"],"vndbCharacterId":"c54800"},"originalCharacterName":"オーレリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"宗教国家から来たシスターのお姫様。"},{"spoiler":false,"text":"敬虔な宗教家で、妄信的に神を敬っている。"},{"spoiler":false,"text":"周囲で起こることは全て神の御心と信じており、全てをポジティブに考える楽観的な性格。"},{"spoiler":false,"text":"それゆえ、人を疑うことを知らず、何事も受け入れ、熱心に神に祈りを捧げている。"},{"spoiler":false,"text":"主人公と妻になってからは、彼女の魅力によって教会に通う民が増えた。"},{"spoiler":false,"text":"戦場では、当然、回復系の魔法を使い、傷ついた仲間たちを癒す。"}],"source":"egs","sourceCharacterId":"25473","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"宗教国家から来たシスターのお姫様。"},{"spoiler":false,"text":"敬虔な宗教家で信ずる神を妄信的に敬っている。"},{"spoiler":false,"text":"神のご加護を信じるあまり周囲で起こる出来事は"},{"spoiler":false,"text":"全て神の御心と信じこみ、"},{"spoiler":false,"text":"そのおかげでかなり楽観的な性格になっている。"},{"spoiler":false,"text":"疑うことを知らず全てをよい方に考えてしまうオーレリアは、"},{"spoiler":false,"text":"今日も教会で熱心に祈りを捧げている。"}],"source":"bangumi","sourceCharacterId":"136714"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61f12eec9de251125dbf97e0c0a1f4d168b9d1f11e8a6fd30a47bfbea73ea0bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50be4da8ead6fa534674aaf369f439c956d72b732de02020c81b5a5a4dad5f9b.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"廣瀬仁美","creatorId":"vndb:s2330","sourcePersonId":"vndb:s2330","canonicalEntityId":"vndb:s2330","name":"廣瀬 仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218161:136714:6303:1","source":"bangumi"}]},{"characterId":"char_c54801","characterName":"レンファ","sourceIds":{"bangumi":[{"characterId":"136715","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25474"],"vndbCharacterId":"c54801"},"originalCharacterName":"レンファ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"歴史の深い神秘的な東方の国から来たお姫様。"},{"spoiler":false,"text":"幼い頃から武術を嗜み、その腕は達人級。"},{"spoiler":false,"text":"好奇心旺盛なお国柄から、彼女自身も様々なことに興味を示し、色々なことを実践しようとするチャレンジ精神旺盛。"},{"spoiler":false,"text":"精神的にはまだまだ未熟な部分が多く、故郷を思い出してはノスタルジックな気分になることもあったが、主人公の妻となってからは、そうした思いも忘れて、幸せな生活を営んでいる。"},{"spoiler":false,"text":"戦場では、彼女の持つ、高い機動力と攻撃力で、敵の出鼻を挫く。"}],"source":"egs","sourceCharacterId":"25474","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"長い歴史を誇る神秘的な東方の国のお姫様。"},{"spoiler":false,"text":"幼い頃からたしなみで武術を学んでおりその腕前は達人クラス。"},{"spoiler":false,"text":"また国民性からか好奇心が旺盛で、様々なことに興味を持ち"},{"spoiler":false,"text":"実践しようと試みる色んな意味でアグレッシブな性格。"},{"spoiler":false,"text":"しかしまだまだ精神的には未熟な部分が多く、"},{"spoiler":false,"text":"レンファは時々一人ノスタルジックになっている。"}],"source":"bangumi","sourceCharacterId":"136715"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe0174699a8e1987f4f6f5fd3944b3fb98857ee25400ebfa8701a6ea40f0ee47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d900c04e990c3ead863dfd866d52549131f77b4a15e567856b773a326961d689.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"足立友","creatorId":"vndb:s1165","sourcePersonId":"vndb:s1165","canonicalEntityId":"vndb:s1165","name":"足立 友","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218161:136715:4858:1","source":"bangumi"}]},{"characterId":"char_c54802","characterName":"ルゥ","sourceIds":{"bangumi":[{"characterId":"136716","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25475"],"vndbCharacterId":"c54802"},"originalCharacterName":"ルゥ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"芸術と踊りが盛んな国から来た踊りに踊るお姫様。"},{"spoiler":false,"text":"女王が国政を取り仕切るお国柄、女性上位的な風潮があり、男性は取るに足らない存在と思っていたが、主人公の妻となった現在は、そうした面も目立たなくなり、主人公との生活に幸せを感じている。"},{"spoiler":false,"text":"彼女が主人公の妻になったことによって、民の芸術に対する関心度も高まり、あまり使用されていなかった大劇場に活気を与えることとなった。"}],"source":"egs","sourceCharacterId":"25475","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"芸術と踊りの国からやって来た踊りを踊るお姫様。"},{"spoiler":false,"text":"国政は代々女王が取りしきっており、"},{"spoiler":false,"text":"その影響で女性上位のお国柄なため"},{"spoiler":false,"text":"男性は取るに足らない存在だと思っている。"},{"spoiler":false,"text":"ルゥのつんけんした態度は男性を低く見ているということもあるが、"},{"spoiler":false,"text":"他国に来た不安も影響している。"}],"source":"bangumi","sourceCharacterId":"136716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e2a3ef82339ceff7811089c553f33b30ab843b7dda344580726cf47223e432f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66ce26c1b716082e71833a663a105b52980d2ac798a3e0e701ef6eba06260afc.webp","width":145,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤村歩","creatorId":"vndb:s1703","sourcePersonId":"vndb:s1703","canonicalEntityId":"vndb:s1703","name":"藤村 歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218161:136716:4783:1","sour