9","sourcePersonId":"vndb:s4499","canonicalEntityId":"vndb:s4499","name":"タスク","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18617","source":"vndb"}]},"cast":[{"characterId":"char_c135303","characterName":"高槻 裕次郎","sourceIds":{"bangumi":[{"characterId":"91282","match":"exact-normalized-name-in-linked-work","subjectId":"126269"},{"characterId":"91282","match":"exact-normalized-name-in-linked-work","subjectId":"467435"}],"egsCharacterIds":["10517"],"vndbCharacterId":"c135303"},"originalCharacterName":"高槻 裕次郎","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"やはり相変わらず副車掌を務めている冴えない男。"},{"spoiler":false,"text":"現在では精治の片腕とも呼べる存在であり、美樹では不可能な仕事はこの男の役目である。"}],"source":"egs","sourceCharacterId":"10517","sourceWorkId":"14988","spoiler":false},{"segments":[{"spoiler":false,"text":"【満潮】で知り合って以来、精治の忠実な部下として様々な局面で暗躍する食えない副車掌。"},{"spoiler":false,"text":"元々組織から精治の監査役として派遣されていたが、精治のカリスマ性に魅せられ、己の人生をかけて組織を裏切り、精治がのし上がる手助けをした。"},{"spoiler":false,"text":"見た目は冴えないただの男だが、裏社会に君臨する重鎮達を出し抜けるほどの独自のコミュニティを持つ経歴不詳の謎の男。"},{"spoiler":false,"text":"【夜鷹】においても副車掌の一人として精治に振り回されながら補佐を行い続ける日々を送る"}],"source":"egs","sourceCharacterId":"10517","sourceWorkId":"35509","spoiler":false},{"segments":[{"spoiler":false,"text":"やはり相変わらず副車掌を務めている冴えない男。"},{"spoiler":false,"text":"現在では精治の片腕とも呼べる存在であり、美樹では不可能な仕事はこの男の役目である。"}],"source":"bangumi","sourceCharacterId":"91282"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32885269a61e6f939a200387858f7762d4e4d74f5b814d89bac1307b1eeb805c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47042e6ef969fe69e2d4e363c1429b7c9236da107b6c43098d32b1c3c88f73ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c23032","characterName":"今里 美樹","sourceIds":{"bangumi":[{"characterId":"91269","match":"exact-normalized-name-in-linked-work","subjectId":"126269"},{"characterId":"91269","match":"exact-normalized-name-in-linked-work","subjectId":"171969"},{"characterId":"91269","match":"exact-normalized-name-in-linked-work","subjectId":"41608"}],"egsCharacterIds":["2750"],"vndbCharacterId":"c23032"},"originalCharacterName":"今里 美樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「特急 満潮」の副車掌。"},{"spoiler":false,"text":"精治が手を回して配属させた、期待の助手。"},{"spoiler":false,"text":"スタイル抜群、職務もきわめて優秀。乗客にも好印象。"},{"spoiler":false,"text":"ただ、負けん気が強いところがあり、プライドを刺激される思わぬ行動にでることも。"}],"source":"egs","sourceCharacterId":"2750","sourceWorkId":"11004","spoiler":false},{"segments":[{"spoiler":false,"text":"精治と同じく、今作でも『満潮』において副車掌を務める優秀なメス奴隷助手。"},{"spoiler":false,"text":"相変わらず公私共にいいように使われている。"}],"source":"egs","sourceCharacterId":"2750","sourceWorkId":"14988","spoiler":false},{"segments":[{"spoiler":false,"text":"能力：【臨時特急（レールガン）】"},{"spoiler":false,"text":"かつて寝台特急【満潮】および【松葉】で副車掌を勤めていた才媛。"},{"spoiler":false,"text":"少々生真面目過ぎる点と、負けん気の強いところが玉に瑕ではあるものの、容姿端麗・頭脳明晰で行動力があり、よく気がつくため年齢問わず人望がある。"},{"spoiler":false,"text":"【神の鉄槌】による被害で交通機関は麻痺し、失職。"},{"spoiler":false,"text":"代わりに能力者として覚醒した美樹は、動かなくなった寝台特急【満潮】の車両を根城にして集落を形成、その高いカリスマ性と人材運用で機能的な集団行動を取っていた。"},{"spoiler":false,"text":"だが愛ほどではないものの、同じく本来はサポート向きな性格のため、大抵のことはそつなくこなすもののリーダーとしての活動は段々限界に近づきつつあり、現状維持からの脱却に移ろうとしない美樹への不満が徐々に集落内へ蔓延し始めている。"},{"spoiler":false,"text":"そんな状況を肌で感じ取っている美樹は内心焦りを覚え、自分の代わりにリーダーとなってくれる人物を探している。"}],"source":"egs","sourceCharacterId":"2750","sourceWorkId":"19639","spoiler":false},{"segments":[{"spoiler":false,"text":"【満潮】【松葉】に引き続き【夜鷹】でも精治の補佐を務める副車掌であり、公私共に精治の女房役でメス奴隷筆頭。"},{"spoiler":false,"text":"これまでの例に漏れず【夜鷹】も長距離を長時間で運行するため、美樹を始め数名の車掌と運転手が業務を分担している。"},{"spoiler":false,"text":"均整の取れたスタイルと美貌の持ち主で、大抵のことは卒なくこなすきわめて優秀な女性。"},{"spoiler":false,"text":"生真面目な性格だが、場数をこなした事で今では裏業務もある程度淡々とこなす。"}],"source":"egs","sourceCharacterId":"2750","sourceWorkId":"35509","spoiler":false},{"segments":[{"spoiler":false,"text":"助手を欲した精治が手を回し、新しく特急【満潮】に配属されてしまった副車掌。"},{"spoiler":false,"text":"車掌である精治の補佐的な存在で、非常にスタイルのいい美貌の持ち主。"},{"spoiler":false,"text":"きわめて優秀だが、少々生真面目すぎるきらいがある。"},{"spoiler":false,"text":"接客態度がよく、誰に対しても悪印象を与えない。勤務態度もよく、上司や同僚に対しても気が回る。"},{"spoiler":false,"text":"ただし負けん気の強いところがあるせいか、プライドを刺激されるような発言に対してはやや過剰気味な反応を見せる場合もある。"}],"source":"bangumi","sourceCharacterId":"91269"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c35fb184cee04dd70521f1b2bc81b18fb943cd8c00ef4261156733c04272e1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf2fbc817903dd2d3c93cf866733efa928abab391e655d4f1809cac71d0c58f7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤麻衣","creatorId":"vndb:s2574","sourcePersonId":"vndb:s2574","canonicalEntityId":"vndb:s2574","name":"伊藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41608:91269:25038:1","source":"bangumi"}]},{"characterId":"char_c23072","characterName":"蒲生 仁美","sourceIds":{"bangumi":[{"characterId":"91275","match":"exact-normalized-name-in-linked-work","subjectId":"126269"},{"characterId":"91275","match":"exact-normalized-name-in-linked-work","subjectId":"41608"}],"egsCharacterIds":["10516"],"vndbCharacterId":"c23072"},"originalCharacterName":"蒲生 仁美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"新米車内販売員。"},{"spoiler":false,"text":"真面目な正確だが、仕事はドジばかり。"},{"spoiler":false,"text":"気が弱く、いつも謝ってばかり。"},{"spoiler":false,"text":"普段の愛想はよく、可愛らしい印象がある。"}],"source":"egs","sourceCharacterId":"10516","sourceWorkId":"11004","spoiler":false},{"segments":[{"spoiler":false,"text":"メス奴隷助手その2。"},{"spoiler":false,"text":"現在も『満潮』において車内販売員を務めており、やはり美樹と同じく身の回りから下の世話まで、精治にこき使われている。"}],"source":"egs","sourceCharacterId":"10516","sourceWorkId":"14988","spoiler":false},{"segments":[{"spoiler":false,"text":"美樹と同じく、引き続き【夜鷹】でも車内販売員を務める女性。"},{"spoiler":false,"text":"精治の裏業務の助手その二。"},{"spoiler":false,"text":"気弱な性格で何かと失敗を引き起こす頼りない女ではあるものの環境適応能力は案外高く、今では意外と図太い一面も垣間見える。"},{"spoiler":false,"text":"【夜鷹】においても車掌や運転手と同じく複数の車内販売員が搭乗することになっており、仁美はその中のチーフを務めている。"},{"spoiler":false,"text":"部下より危なっかしいのは相変わらずだが、それも愛嬌として受け止められており、最近は面倒見が良いと言われる事も。"}],"source":"egs","sourceCharacterId":"10516","sourceWorkId":"35509","spoiler":false},{"segments":[{"spoiler":false,"text":"まだ歳若い新米車内販売員。"},{"spoiler":false,"text":"一生懸命仕事に取り組む真面目な女性。"},{"spoiler":false,"text":"ただし有能かというと話は別で、荷物を落として商品をダメにしたり、車内で転倒して乗客と衝突するなど、いわゆるドジっ子である。"},{"spoiler":false,"text":"また少々気の弱いところがあり、横柄な態度の乗客などには腰が引けてしまう。"},{"spoiler":false,"text":"いつも謝ってばかりいるが、普段は愛想よくかわいらしい女性である。"},{"spoiler":false,"text":"副車掌の美樹同様、精治の手伝いをさせられることになる。"}],"source":"bangumi","sourceCharacterId":"91275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b769f413477f6dfe5288f930781129d647b3f7bd838520181388d6c9651deff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd21439f4ae98c21a28d90caa70dd1abf428bb0113ddb4c117299aada369d008.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41608:91275:7169:1","source":"bangumi"}]},{"characterId":"char_c23078","characterName":"海堂 精治","sourceIds":{"bangumi":[{"characterId":"91268","match":"exact-normalized-name-in-linked-work","subjectId":"41608"},{"characterId":"91268","match":"exact-normalized-name-in-linked-work","subjectId":"467435"}],"egsCharacterIds":["17825"],"vndbCharacterId":"c23078"},"originalCharacterName":"海堂 精治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He was secretly raised by powerful people in the underworld through the Special Sex Man Creation Plan and eventually rose to the top of the organization, becoming the worst and worst conductor."},{"spoiler":false,"text":"Although he has a very strong sexual desire, he also has the rationality to carefully pursue and kill his prey."},{"spoiler":false,"text":"Even though he is the top of the organization, he never lets go of his job of securing female slaves through his duties as a conductor, and leaves all the complicated matters to his partner Takatsuki and other trusted members of the organization."}],"source":"vndb","sourceCharacterId":"c23078"},{"segments":[{"spoiler":false,"text":"「特急 満潮」の車掌。主人公。"},{"spoiler":false,"text":"裏社会の権力者によって【特別性奴創造計画】の駒として育成された男。"},{"spoiler":false,"text":"元は孤児で、幼少から性の技術を鍛錬させられた調教のプロフェッショナル。"},{"spoiler":false,"text":"満潮の車掌に甘んじているが、権力掌握を伺う野心家の心を隠し持つ。"},{"spoiler":false,"text":"“欲・即・姦”がポリシー。しかし、目的のために自制するしたたかさも。"}],"source":"egs","sourceCharacterId":"17825","sourceWorkId":"11004","spoiler":false},{"segments":[{"spoiler":false,"text":"【特別性奴創造計画】によって裏社会の権力者達が秘密裏に育て上げ、結果的に組織の頂点に立った最凶最悪の車掌。"},{"spoiler":false,"text":"非常に性欲が強いが、狙った獲物は慎重に追い込んで仕留めようとする理性的な周到さも持ち合わせている。"},{"spoiler":false,"text":"組織のトップでありながらも車掌業務によってメス奴隷を確保するという自身の仕事は決して手放さず、煩雑な事はすべて相棒の高槻や信頼の置ける組織の人員に一任している。"}],"source":"egs","sourceCharacterId":"17825","sourceWorkId":"35509","spoiler":false},{"segments":[{"spoiler":false,"text":"鉄道会社を有する裏社会の出資者たちが、【特別性奴創造計画】のため自分たちにとって都合のいいように作り上げた男。"},{"spoiler":false,"text":"元々は孤児である。計画に関わる者にその身柄を引き取られた後、幼い頃から性的技術を仕込まれ、生来の才能や身体能力にも恵まれた精治は、計画実行のため【満潮】の車掌に任命された。"},{"spoiler":false,"text":"精治を育てた者たちは気づいていないが、実は天性の野心家である。"},{"spoiler":false,"text":"精治はこの計画を逆に利用し、機会を見て一気に権力を掌握することを考えている。"},{"spoiler":false,"text":"己の欲望に忠実な性格で、【欲・即・姦】がポリシーだが、実現のためには必要なだけ欲望を我慢することもできる計画的な一面も持つ。"},{"spoiler":false,"text":"二面性があり、人のいい爽やかな車掌と、邪悪な○辱鬼のふたつの顔を巧みに使い分ける。"}],"source":"bangumi","sourceCharacterId":"91268"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d668a802a9e194351f5239df358d7643f9e0f7bf9cfa4997bd7b689b1a575635.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a38fb59b86c1b504c3b73d7414dfd99a9b35fe9d7c0b8482353f4d9050442b5d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c99568","characterName":"永堀 林檎","sourceIds":{"bangumi":[{"characterId":"91270","match":"exact-normalized-name-in-linked-work","subjectId":"41608"}],"egsCharacterIds":["17826"],"vndbCharacterId":"c99568"},"originalCharacterName":"永堀 林檎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人気グラビアイドル＆女優。通称“ほりりん”。"},{"spoiler":false,"text":"タレント活動から女優、モデルまで幅広くこなすパーフェクトなアイドル。"},{"spoiler":false,"text":"アクティブかつ健康的、それでいて女性的な柔らかさも併せもつ。"},{"spoiler":false,"text":"しかし中身は普通の少女で、相当な努力家。"},{"spoiler":false,"text":"最近のハードな仕事量に疲れ気味。"},{"spoiler":false,"text":"オフを利用して「満潮」で旅行中。"}],"source":"egs","sourceCharacterId":"17826","sourceWorkId":"11004","spoiler":false},{"segments":[{"spoiler":false,"text":"人気の若手グラビアアイドル兼女優。通称【ほりりん】。"},{"spoiler":false,"text":"活動の幅が広く、タレントからファッションモデルまで、ありとあらゆる芸能活動を精力的にこなす。"},{"spoiler":fals