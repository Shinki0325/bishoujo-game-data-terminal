4862","name":"こごめ さくら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139359","source":"vndb"}]},"cast":[{"characterId":"char_c67764","characterName":"いろは","sourceIds":{"bangumi":[{"characterId":"52833","match":"exact-normalized-name-in-linked-work","subjectId":"212079"}],"egsCharacterIds":["16563"],"vndbCharacterId":"c67764"},"originalCharacterName":"いろは","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"母子家庭に生まれたが、母親に虐待されて育つ。"},{"spoiler":false,"text":"賢い子で学校でも優秀だったが、教師に虐待を疑われて、母親が登校させなくなる。"},{"spoiler":false,"text":"相談所の面談や担任の訪問にも立ち会わずにいるうちに、病気で母親が死亡。"},{"spoiler":false,"text":"そのときには、既に数年間の不登校期間が出来上がっていた。"},{"spoiler":false,"text":"黒髪のきれいな子だが、今は伸び放題に伸びていて、身体には虐待の跡が残されている。"},{"spoiler":false,"text":"母親が男を連れ込んでいたため、セックスについて知識があり、男はセックスがしたいと思っている。"},{"spoiler":false,"text":"処女でオナニー経験も無いが、大好きなおじさんに、身体を使って欲しいと願っている。"}],"source":"egs","sourceCharacterId":"16563","sourceWorkId":"25116","spoiler":false},{"segments":[{"spoiler":false,"text":"母子家庭に生まれたが、母親に虐待されて育った少女。"},{"spoiler":false,"text":"数年間に及ぶ軟禁で きれいな黒髪は伸び放題になり、"},{"spoiler":false,"text":"身体には虐待の跡が残されている。"},{"spoiler":false,"text":"母親が男を連れ込んでいたためセックスに関する知識があり、"},{"spoiler":false,"text":"男はセックスがしたいものと思っている。"},{"spoiler":false,"text":"処女でオナニー経験も無いが、大好きなおじさんに身体を使ってほしいと思っている。"}],"source":"bangumi","sourceCharacterId":"52833"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bc6e8fc0d8d8a6e243618f335b4b600a20aafe4c23d4942ae999bcbaa734ed2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d58d92946a92f4c6f2dc5561a9a48ff4f6de7d80eac4a3f3a7f706c1223f512.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香"