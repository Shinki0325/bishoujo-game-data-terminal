o.date/terminal-wiki/v1/characters/v1/images/fe/fea90d5f0c7a00acb05ea9005a1c1bdb209d4ef223b71f2ca57e7a71598aff42.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c34378217efb8c56f2bea946810bfe0a29962226058f49169384e1b8371b536.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"犬飼あお","creatorId":"vndb:s942","sourcePersonId":"vndb:s942","canonicalEntityId":"vndb:s942","name":"犬飼 あお","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37484:77430:32277:1","source":"bangumi"}]},{"characterId":"char_c31373","characterName":"キルシェ","sourceIds":{"bangumi":[{"characterId":"77431","match":"exact-normalized-name-in-linked-work","subjectId":"37484"}],"egsCharacterIds":["8893"],"vndbCharacterId":"c31373"},"originalCharacterName":"キルシェ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本で神格化しようとしている いぶき に敵対し、その力を吸い上げてしまおうとしている木錬。"},{"spoiler":false,"text":"強気で怖いもの知らず、子供らしい冷酷さを持つ。"},{"spoiler":false,"text":"「キルシェ＝さくらんぼ」 で、本体である樹木もさくらんぼのなる木。"},{"spoiler":false,"text":"ドイツの “黒い森” の主要樹木で、さくらんぼのリキュールやケーキは現地の名産品。"}],"source":"egs","sourceCharacterId":"8893","sourceWorkId":"16728","spoiler":false},{"segments":[{"spoiler":false,"text":"日本で神格化しようとしている いぶき に敵対し、その力を吸い上げてしまおうとしている木錬。"},{"spoiler":false,"text":"強気で怖いもの知らず、○○らしい冷酷さを持つ。"},{"spoiler":false,"text":"「キルシェ＝さくらんぼ」 で、本体である樹木もさくらんぼのなる木。"},{"spoiler":false,"text":"ドイツの “黒い森” の主要樹木で、さくらんぼのリキュールやケーキは現地の名産品。"},{"spoiler":false,"text":"日本の樹木の多くが人々と共存するようにして神格化したのに対し、恐れられも崇められもしてきた彼女は、そうした人間との関係に対して甘いと嫌いつつも、強い憧れを抱いている。"},{"spoiler":false,"text":"彼女のパートナーは、ドイツ生まれの狼・フローズ（フローズヴィトニル＝フェンリル）。"},{"spoiler":false,"text":"「……貴方は私に忠誠を誓うのかしら？」"}],"source":"bangumi","sourceCharacterId":"77431"}],"profileFacts":[],"metad