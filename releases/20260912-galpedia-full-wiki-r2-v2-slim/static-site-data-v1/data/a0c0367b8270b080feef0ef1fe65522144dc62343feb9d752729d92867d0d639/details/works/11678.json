e":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の近所に住む美人姉妹の妹。主人公と姉妹は幼馴染同士。"},{"spoiler":false,"text":"姉を反面教師に育ち、喋り方や仕草などは非常にクールだが、本当は喜怒哀楽がわかりやすいタイプ。性格は、負けず嫌いで、ヤキモチやき、照れ屋で、頭は良いがその行動は子供っぽく、無意味に虚勢を張ったりもする。そして、自分の気持ちに素直になれないツンデレ。"},{"spoiler":false,"text":"エッチに関しては知識はあるが、基本的に奥手。"},{"spoiler":false,"text":"「だ、ダメに決まってるじゃない！馬鹿なこと言わないで！」"}],"source":"egs","sourceCharacterId":"16038","sourceWorkId":"11678","spoiler":false},{"segments":[{"spoiler":false,"text":"近所に住む幼なじみ姉妹の妹。"},{"spoiler":false,"text":"自由人で何でもできる姉を反面教師に育ち、喋り方や仕草などは冷静沈着な優等生タイプ。"},{"spoiler":false,"text":"しかし本当は、姉に似て喜怒哀楽が分かりやすい。"},{"spoiler":false,"text":"頭はいいが行動が子供っぽく、無意味に虚勢を張ったりする。"},{"spoiler":false,"text":"エッチに関しては知識しかないため、やや奥手。"}],"source":"bangumi","sourceCharacterId":"204476"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"16038","sourceWorkId":"11678","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"16038","sourceWorkId":"11678","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"16038","sourceWorkId":"11678","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"16038","sourceWorkId":"11678","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"16038","sourceWorkId":"11678","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68fb62d82fa19095dcf5198a9b95011bf34405fb57e3071f87cfd730dc9499ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d67a055e6f2229ee680143f900c49a908a263eddbda0b2bc5f