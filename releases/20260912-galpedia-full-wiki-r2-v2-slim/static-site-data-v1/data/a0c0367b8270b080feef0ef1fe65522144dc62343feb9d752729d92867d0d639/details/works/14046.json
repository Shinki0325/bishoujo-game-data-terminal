{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"14046","model":{"presentationWorkId":"egs:14046","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"KEI","creatorId":"vndb:s35468","sourcePersonId":"egs:creator:5027","canonicalEntityId":"vndb:s35468","name":"KEI","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:91913","source":"egs"}]},"cast":[{"characterId":"char_bangumi_10452","characterName":"はつね ミク","sourceIds":{"bangumi":[{"characterId":"10452","match":"source-roster","subjectId":"1667"},{"characterId":"10452","match":"source-roster","subjectId":"21553"},{"characterId":"10452","match":"source-roster","subjectId":"223159"},{"characterId":"10452","match":"source-roster","subjectId":"23090"},{"characterId":"10452","match":"source-roster","subjectId":"285772"},{"characterId":"10452","match":"source-roster","subjectId":"7291"},{"characterId":"10452","match":"source-roster","subjectId":"78407"}]},"originalCharacterName":"はつね ミク","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"16"},"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"初音ミク是CRYPTON FUTURE MEDIA以Yamaha的VOCALOID 2语音合成引擎为基础，开发贩售的虚拟女性歌手软件，角色主唱系列的第一作、VSTi规格的电子乐器；或此软件的印象角色（这只是软件的象征，不会在实际使用时出现）。"},{"spoiler":false,"text":"2007年8月31日发售，开放价格，官方估计系列软件实际价格约15,750日圆。原只可用于Microsoft Windows，2008年3月19日随CrossOver Mac 6.1发表而可用于Mac OS X，2014发布的VOCALOID3版本的软件已经原生支持OS X。在GNU/Linux系统上通过修改过的wine也能够正确运行初音未来。发售后大受欢迎，并出现大量用户制作的翻唱歌曲、原创曲等。官方表示初音未来擅长由1980年代至最新的流行歌曲。"},{"spoiler":false,"text":"2010年4月30日发售初音Append，追加6个不同音质（表情）的声音数据库，分别为sweet（小孩声、甜美）、dark（比较成熟的声音、深沉）、solid（发音力度加强、立体）、light（活泼清爽系、明亮）、vivid（滑舌明了化、鲜明）、soft（高音部分减弱、柔和）。初音Append需要有初音主程式才能运作。"},{"spoiler":false,"text":"2013年8月31日开放下载初音ミクV3 English声库，并于2013年9月26日与初音ミクV3一起正式发售。"},{"spoiler":false,"text":"2013年9月26日初音ミクV3正式发售，有6个不同音质的声音数据库（包含英语），分别为Original、sweet、dark、solid、soft、English。初音V3完全支持Mac OS X（Vocaloid NEO）。"}],"source":"bangumi","sourceCharacterId":"10452"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"10452","value":"Vocaloid"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/767f0a29adcbf1bb0a6108af51da69468b0254c076c09b93b5330c8fc484caf6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3289128f8b03c843bce362d8a0d6be8fa118ab50c52355da948bd924eca65e3.webp","width":195,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:628","sourceCompanyId":"egs:brand:628","canonicalEntityId":"egs:brand:628","name":"SEGA(セガゲームス)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:14046:628","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
