b:s4421","canonicalEntityId":"vndb:s4421","name":"やど","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132944","source":"vndb"},{"creditedName":"綾瀬","creatorId":"vndb:s5123","sourcePersonId":"vndb:s5123","canonicalEntityId":"vndb:s5123","name":"綾瀬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132945","source":"vndb"},{"creditedName":"榎本 覚","creatorId":"vndb:s13290","sourcePersonId":"vndb:s13290","canonicalEntityId":"vndb:s13290","name":"榎本 覚","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132947","source":"vndb"},{"creditedName":"X壱型改","creatorId":"vndb:s46659","sourcePersonId":"vndb:s46659","canonicalEntityId":"vndb:s46659","name":"X壱型改","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132949","source":"vndb"},{"creditedName":"鶏野郎","creatorId":"vndb:s46660","sourcePersonId":"vndb:s46660","canonicalEntityId":"vndb:s46660","name":"鶏野郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132950","source":"vndb"}]},"cast":[{"characterId":"char_c54081","characterName":"南雲 七海","sourceIds":{"bangumi":[{"characterId":"50876","match":"exact-normalized-name-in-linked-work","subjectId":"188484"}],"egsCharacterIds":["14561"],"vndbCharacterId":"c54081"},"originalCharacterName":"南雲 七海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1019"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Prime Minister's darling daughter. A second year student and is a classmate of Hajime."},{"spoiler":false,"text":"Skilled in both school and sports, Nanami is the perfect honours student."},{"spoiler":false,"text":"As the daughter of a politician, she has been surrounded by the adult world ever since she was young. This taught her to be wary of how her actions affect how people look at her. Even at the worst of times, she never loses her composure."},{"spoiler":false,"text":"Although she tries to hide it, she has a fondness for the cute things and sweet things that girls her age typically love, but she’s so self-conscious about it that she wouldn’t dare reveal that to anybody."},{"spoiler":false,"text":"When it comes to romance, too, she's well-informed and twice as curious... and that runs in such contrast with her image that she won't admit it."},{"spoiler":false,"text":"As you can see, she’s not very open about herself."},{"spoiler":false,"text":"Her high social status and stoic personality make her popular with masochistic guys, and even the girls, as well."},{"spoiler":false,"text":"People always treat her with respect, careful never to be too loud and obnoxious around her, as a consequence of which she has become a bit of a loner."},{"spoiler":false,"text":"She often spends her time on the school rooftop during her lunch breaks and after school. Everybody knows that's her territory, so only a few dare tread its ‘sacred ground.’ The rest of the students stay far away."},{"spoiler":false,"text":"She's starting to get tired of all the special treatment..."},{"spoiler":false,"text":"From steam"}],"source":"vndb","sourceCharacterId":"c54081"},{"segments":[{"spoiler":false,"text":"いついかなる時も冷静さを忘れない文武両道の才女。"},{"spoiler":false,"text":"政治家の娘ということもあって、幼い頃から大人の世界に身を置く機会が多かった。"},{"spoiler":false,"text":"そのため、自分がどう見られてどのように思われるのかを把握して動く、完璧な優等生。"},{"spoiler":false,"text":"クールなオーラと威光によって、M系学生のファンが多い。"},{"spoiler":false,"text":"また、女性人気も高い。"},{"spoiler":false,"text":"隠してはいるものの、年相応の感性も持ち合わせていて、いわゆる可愛いものや甘いものが好きだが人目を気にして、おおっぴらにすることはない。"},{"spoiler":false,"text":"恋愛に関しては耳年増系。"},{"spoiler":false,"text":"興味はあるものの、口に出すことでもない上に、自分のキャラとも違うために隠している。"},{"spoiler":false,"text":"いわゆる\"むっつり\"。"},{"spoiler":false,"text":"昼休みや放課後などは屋上にいることが多い。"},{"spoiler":false,"text":"彼女が使うからという理由で他の学生の足は遠のき、数名しか足を踏み入れない『聖域』となっている。"},{"spoiler":false,"text":"騒がしくしてはいけないという思いやりから始まった集団心理によって、特別扱いされるという孤独。"},{"spoiler":false,"text":"だが、特別扱いされる続けることに少し疲れを感じている。"}],"source":"egs","sourceCharacterId":"14561","sourceWorkId":"24029","spoiler":false},{"segments":[{"spoiler":false,"text":"いついかなる時も冷静さを忘れない文武両道の才女。"},{"spoiler":false,"text":"政治家の娘で幼い頃から大人の世界に身を置く機会が多かったため、"},{"spoiler":false,"text":"自分がどう見られてどのように思われるのかを把握して動ける完璧な優等生。"},{"spoiler":false,"text":"隠してはいるものの年相応の感性も持ち合わせていて、いわゆる可愛いものや"},{"spoiler":false,"text":"甘いものが好きなのだが、人目を気にしておおっぴらにすることはない。"},{"spoiler":false,"text":"クールなので M系男子や女子からも人気が高いが、彼女の周りで騒がしくしては"},{"spoiler":false,"text":"いけないという気遣いから距離を置かれ、特別扱い（孤独に）されてしまっている。"},{"spoiler":false,"text":"「公人ではありませんから。 あくまで単なる学生でしかないんです。私は」"}],"source":"bangumi","sourceCharacterId":"50876"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50876","value":"2年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f182be42c40322f61ce2019b466134bab8623e770db8627d5aced0d6998e58b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d508e47ce4233566bf5a951c559ae04ea4abad98b1c62728cef9b14cc1c2c5a5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本希望","creatorId":"vndb:s1455","sourcePersonId":"vndb:s1455","canonicalEntityId":"vndb:s1455","name":"山本 希望","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:188484:50876:7147:1","source":"bangumi"}]},{"characterId":"char_c54082","characterName":"赤城 鈴奈","sourceIds":{"bangumi":[{"characterId":"50877","match":"exact-normalized-name-in-linked-work","subjectId":"188484"}],"egsCharacterIds":["14562"],"vndbCharacterId":"c54082"},"originalCharacterName":"赤城 鈴奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"808"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A top-ranking entertainment personality"},{"spoiler":false,"text":"A third year at the protagonist's school who works as an idol."},{"spoiler":false,"text":"Her specialties include cooking and making people forget their inhibitions."},{"spoiler":false,"text":"With her friendly smile, her open-mindedness and her revitalizing words, Suzuna has a tight grasp on her adoring audience's hearts. While she has many fans at school, they all keep each other in check, meaning nobody can make a move on her."},{"spoiler":false,"text":"She has such a bright and bubbly personality, you'd never think she was older. Working in entertainment has not tarnished her innocence. She's just a hard-working girl with no dark side whatsoever. People call her an angel, and even a miracle."},{"spoiler":false,"text":"When it comes to romance, it's something she deeply yearns for, but feels it's not for her."},{"spoiler":false,"text":"She reveres the concept of love so much that she can't allow herself to admit those feelings."},{"spoiler":false,"text":"She's also the kind of girl whose face turns bright red at the very notion of a kiss."},{"spoiler":false,"text":"As she's not comfortable with that kind of attention, she's never taken so much as a risqué modelling job in her entire career."},{"spoiler":false,"text":"Suzuna is one of those few students who has breached the sacred ground of the rooftop."},{"spoiler":false,"text":"As she is often away from school due to work, she went up to the rooftop completely unaware of its significance, which led her to meeting Nanami."},{"spoiler":false,"text":"She is very insecure about her ability and her future..."},{"spoiler":false,"text":"From steam"}],"source":"vndb","sourceCharacterId":"c54082"},{"segments":[{"spoiler":false,"text":"特技はお料理と”気配を消せる”こと。"},{"spoiler":false,"text":"人懐っこい笑顔と、抱擁力のある癒し系トークでファンの心を鷲掴み。"},{"spoiler":false,"text":"裏表のない性格で努力家。"},{"spoiler":false,"text":"年上であることを感じさせない、ふわふわとした空気。"},{"spoiler":false,"text":"芸能界にいるにも関わらず、黒に染まることのない純真さ。"},{"spoiler":false,"text":"天使か、あるいは奇跡の産物とまで言われる。"},{"spoiler":false,"text":"学園内にもファンは多いが、ファン同士がお互いに牽制しあっているため、誰も出し抜けない状況。"},{"spoiler":false,"text":"恋愛に関しては憧れを抱いているものの、自分がそんなことをするなんて恐れ多いとすら思っている。"},{"spoiler":false,"text":"恋というものを神格化するせいで、恋心に気付けないタイプ。"},{"spoiler":false,"text":"セクシーな話題になると、真っ赤になって俯く系。"},{"spoiler":false,"text":"自分自身に対してそういう目を向けられることにも慣れていないためか、グラビアを今まで一枚も撮ったことがない。"},{"spoiler":false,"text":"屋上の『聖域』に足を踏み入れる数少ない一人。"},{"spoiler":false,"text":"仕事のため学園を休むことがたびたびあり、屋上が聖域となっていることを知らずに入り、七海に出会う。"},{"spoiler":false,"text":"自分の才能と未来に関して不安を持っている。"}],"source":"egs","sourceCharacterId":"14562","sourceWorkId":"24029","spoiler":false},{"segments":[{"spoiler":false,"text":"人懐っこい笑顔と癒し系トークでファンの心を鷲掴みにする学生アイドル。"},{"spoiler":false,"text":"特技はお料理と “気配を消せる” こと。 芸能界にいながらも純真さを失っていない。"},{"spoiler":false,"text":"学園内にもファンは多いが、ファン同士で牽制し合って誰も出し抜けない状況。"},{"spoiler":false,"text":"セクシャルな話題になると、真っ赤になって俯いてしまう。"},{"spoiler":false,"text":"そういう目を向けられることに慣れておらず、グラビアも撮ったことがない。"},{"spoiler":false,"text":"自分のアイドルとしての才能と未来に関して不安を持っている。"},{"spoiler":false,"text":"「わたし、ずっと思っていたんです。 アイドルを続けていけるのかなって」"}],"source":"bangumi","sourceCharacterId":"50877"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50877","value":"3年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac00d96538617981f88d5e71ec00a334ff5091e4b2f77401ceebc8193927dd16.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2e9daa2abd7ce1e0ab97928dd8e51f0a01e869337d9c6028ff1936bb29c6dc1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々木未来","creatorId":"vndb:s3660","sourcePersonId":"vndb:s3660","canonicalEntityId":"vndb:s3660","name":"佐々木 未来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:188484:50877:7277:1","source":"bangumi"}]},{"characterId":"char_c54083","characterName":"周防 由香里","sourceIds":{"bangumi":[{"characterId":"50878","match":"exact-normalized-name-in-linked-work","subjectId":"188484"}],"egsCharacterIds":["14563"],"vndbCharacterId":"c54083"},"originalCharacterName":"周防 由香里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"703"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Japan's greatest detective"},{"spoiler":false,"text":"A girl who is said to have helped the police crack many difficult cases in the past."},{"spoiler":false,"text":"Unfortunately they haven’t been requesting her help much in recent days, so things have been pretty mundane for her lately."},{"spoiler":false,"text":"Yukari speaks casually to anybody, regardless of their age. She can be pretty sarcastic at times, but she has a good attitude and is easy to talk to."},{"spoiler":false,"text":"However, her powers of observation are so sharp, they border on the level of a mind-reader. She's so accurately able to guess what people are thinking that people tend to keep their distance from her."},{"spoiler":false,"text":"But she doesn't let that bother her, and spends her time immersing herself in the world of books."},{"spoiler":false,"text":"Her abilities of deduction also extend to guessing the content of every test in advance, so she also has excellent grades."},{"spoiler":false,"text":"She's the kind of girl who walks her own way, and doesn't let herself be constrained by anybody."},{"spoiler":false,"text":"This too means she tends to struggle to get close to others."},{"spoiler":false,"text":"She's aware of the sacred nature of the rooftop, but is one of the few who can stand upon its hallowed ground. She'll go there to observe Nanami and Suzuna, but mainly just spend her time reading."},{"spoiler":false,"text":"She finds the place's strange alone-together atmosphere very interesting."},{"spoiler":false,"text":"She's growing very tired of her peaceful everyday life..."},{"spoiler":false,"text":"From steam"}],"source":"vndb","sourceCharacterId":"c54083"},{"segments":[{"spoiler":false,"text":"以前は警察に協力していくつもの難事件を解決したと言われている少女。"},{"spoiler":false,"text":"最近では協力を仰がれることも減ったために退屈な日々を送る。"},{"spoiler":false,"text":"中世的な口調で、年の差は気にしないタメ口。"},{"spoiler":false,"text":"皮肉屋な部分もあるが、人当たりは良くて気楽に話せる。"},{"spoiler":false,"text":"だが、読心術クラスまでに卓越した観察眼によって内心の全てを言い当てられるために、人があまり寄り付かない。"},{"spoiler":false,"text":"本人はそれを苦にすることもなく、趣味の読書に没頭する日々。"},{"spoiler":false,"text":"テストのヤマは百発百中なので成績は良い。"},{"spoiler":false,"text":"誰に気兼ねすることもなく我が道を行くタイプ。"},{"spoiler":false,"text":"その半面、他人との距離感があまり掴めない。"},{"spoiler":false,"text":"Hなことに対しては知識しかなく経験したことがないので、興味津々系。"},{"spoiler":false,"text":"なんだったら、自分から迫る方。"},{"spoiler":false,"text":"屋上が『聖域』となっていることを知って足を踏み入れる数少ない一人。"},{"spoiler":false,"text":"七海と鈴奈の観察と言いながら、読書に没頭していることが多い。"},{"spoiler":false,"text":"孤独を共有するという少し不思議な関係性を面白く感じている。"},{"spoiler":false,"text":"そして、平穏な日常に退屈しきっている。"}],"source":"egs","sourceCharacterId":"14563","sourceWorkId":"24029","spoiler":false},{"segments":[{"spoiler":false,"text":"以前は警察に協力して いくつもの難事件を解決したと言われている少女。"},{"spoiler":false,"text":"皮肉屋な面もあるが、人当たりは良くて気楽に話せる。"},{"spoiler":false,"text":"ただ卓越した観察眼で内心を読まれてしまうため、寄り付こうとする人はいない。"},{"spoiler":false,"text":"我が道を行くタイプで、他人との距離感があまり掴めない。"},{"spoiler":false,"text":"趣味の読書に没頭する毎日を送り、平穏な日常に退屈しきっている。"},{"spoiler":false,"text":"「たまたま、この耳が勝手に声を拾ってしまっただけさ。 まったくいけない耳だな」"}],"source":"bangumi","sourceCharacterId":"50878"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50878","value":"1年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74132e34e8d210a7a1f510d041df0c07a10caff320202d64c793b01b852071cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a5b87e0591c7a07f0999b5d598737f296580c2f505071839bdaab74df001964.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎真実","creatorId":"vndb:s199","sourcePersonId":"vndb:s199","canonicalEntityId":"vndb:s199","name":"尾崎 真実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:188484:50878:8165:1","source":"bangumi"}]},{"characterId":"char_c59075","characterName":"神林 真央","sourceIds":{"bangumi":[{"characterId":"50881","match":"exact-normalized-name-in-linked-work","subjectId":"188484"}],"egsCharacterIds":["14662"],"vndbCharacterId":"c59075"},"originalCharacterName":"神林 真央","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"606"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hajime's younger cousin who lives in his neighbourhood. She calls the protagonist 'onii-chan'."},{"spoiler":false,"text":"She used to live in Hajime’s neighbourhood when they were elementary students until her family moved away. Since then, they've been separated, until they were reunited when Hajime transferred to her school. Mao is almost positive this was an act of fate."},{"spoiler":false,"text":"Naive and honest, she yearns for Hajime’s attention."},{"spoiler":false,"text":"As she’s of the age for love, she sometimes finds herself swept up in fantasies of doing all sorts of things with him."},{"spoiler":false,"text":"At first, she warns him not to breach the sacred ground of the rooftop, but when she realizes he’s serious about going up there, she gradually encourages him to do so."},{"spoiler":false,"text":"Right before she moved when she was young, they swore they would get married."},{"spoiler":false,"text":"Does Hajime still feel that way about her...?"},{"spoiler":false,"text":"From johren.games"}],"source":"vndb","sourceCharacterId":"c59075"},{"segments":[{"spoiler":false,"text":"小学生の頃。始の実家の近所に住んでいた従姉妹。"},{"spoiler":false,"text":"その後しばらく離れていたが、始が転入してきたことで再会。"},{"spoiler":false,"text":"本人はきっと運命に違いないと思っている。"},{"spoiler":false,"text":"天真爛漫で素直。始のことを「お兄ちゃん」と慕って甘えてくる。"},{"spoiler":false,"text":"恋に恋するお年ごろで、たまに始とのあんなことやこんなことを妄想して暴走してしまう。"},{"spoiler":false,"text":"『聖域』に入ろうとする始を最初は止めるも、本気であることを察して、次第に応援する立場に。"},{"spoiler":false,"text":"幼い頃に引っ越す間際、始と将来結婚する約束を交わしており、もしかしたら、まだ縁が残っているのかも……？"}],"source":"egs","sourceCharacterId":"14662","sourceWorkId":"24029","spoiler":false},{"segments":[{"spoiler":false,"text":"小学生の頃、実家の近所に住んでいた従姉妹。"},{"spoiler":false,"text":"その後しばらく離れていたが、始が転入してきたことで再会。"},{"spoiler":false,"text":"きっと運命に違いないと思っている。"},{"spoiler":false,"text":"恋に恋するお年頃で妄想が暴走しがち。 「お兄ちゃん」と慕って甘えてくる。"},{"spoiler":false,"text":"天真爛漫で素直な性格。"},{"spoiler":false,"text":"幼い頃に引っ越す間際、将来結婚をする約束を交わしており、もしかしたらまだ縁が残っているのかも……？"},{"spoiler":false,"text":"「お兄ちゃんそそっかしいから、わたしの知らない場所にいると不安だしね」"}],"source":"bangumi","sourceCharacterId":"50881"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50881","value":"2年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef9f90f5416bb423ce262033fdfc74c8dfcc87a1b51f647c1cc19db9f99f3ecd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5e5d106b97885496ad568815e9a078df49d227dd73ec8bd688d8389ee2cc752.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:188484:50881:13372:1","source":"bangumi"}]},{"characterId":"char_c59076","characterName":"坂白 花夜","sourceIds":{"bangumi":[{"characterId":"50880","match":"exact-normalized-name-in-linked-work","subjectId":"188484"}],"egsCharacterIds":["14661"],"vndbCharacterId":"c59076"},"originalCharacterName":"坂白 花夜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"925"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nanami’s childhood friend and self-proclaimed strongest ‘SP’"},{"spoiler":false,"text":"A third-year student and Nagumo Nanami's bodyguard."},{"spoiler":false,"text":"What SP stands for changes depending on the situation. Right now, it stands for ‘sexy physique.’"},{"spoiler":false,"text":"Hanayo has a plain and polite manner of speaking, and doesn’t reveal her emotions much."},{"spoiler":false,"text":"She has a tendency to change the topic completely, and it can be hard to grasp what she’s trying to say."},{"spoiler":false,"text":"As an SP, she behaves in such a way that you can never guess what she’s thinking either."},{"spoiler":false,"text":"She may be small, but she’s an expert at self-defense, and is the strongest student in the entire school. She claims she could give Br*ce Wi*lis a run for his money."},{"spoiler":false,"text":"Hanayo understands how Nanami feels, but still feels she has to give her special treatment due to her position."},{"spoiler":false,"text":"From johren.games"}],"source":"vndb","sourceCharacterId":"c59076"},{"segments":[{"spoiler":false,"text":"SPが何の略なのかはその時々によって変わる。"},{"spoiler":false,"text":"今はセクシー・フィジカルの略という事になっている。"},{"spoiler":false,"text":"あまり感情を表に出すことはせずに淡々とした丁寧口調で話す。"},{"spoiler":false,"text":"脈絡のない会話の飛び方などをしたり、掴みどころがない性格。"},{"spoiler":false,"text":"SPとして考えを悟らせないための立ち振る舞いらしい。"},{"spoiler":false,"text":"小柄ながらも、護身術の達人、学園最強の一角。"},{"spoiler":false,"text":"ブ〇ース・ウィ〇スといい勝負が出来る。（本人談）"},{"spoiler":false,"text":"七海の心情を汲みながらも、彼女を特別扱いしなければいけない立ち位置。"}],"source":"egs","sourceCharacterId":"14661","sourceWorkId":"24029","spoiler":false},{"segments":[{"spoiler":false,"text":"あまり感情を表に出さず、淡々とした丁寧口調で話す先輩。"},{"spoiler":false,"text":"小柄ながらも護身術の達人。 学園内最強の一角。"},{"spoiler":false,"text":"脈略のない会話の飛び方をするなど、掴み所がない性格。"},{"spoiler":false,"text":"SPとして考えを悟らせないための立ち振る舞いらしい。"},{"spoiler":false,"text":"“SP”が何の略なのかはその時々によって変わる。"},{"spoiler":false,"text":"今は “セクシー・フィジカル” の略ということになっている。"},{"spoiler":false,"text":"七海の心情を汲みながらも、彼女を特別扱いしなければいけない立ち位置。"},{"spoiler":false,"text":"「ほほぅ。 お嬢様がむっつりだと知って、そのチョイスですか？」"}],"source":"bangumi","sourceCharacterId":"50880"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50880","value":"3年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76540bbbcb3b742b177b409ecd390d0756c8f3dec8620d249e93754e589e95c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/502d7b095bc9061f6275d04c93c9393a1ccfea72f64d5fbbf267a6c464813d5f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"仙台エリ","creatorId":"vndb:s195","sourcePersonId":"vndb:s195","canonicalEntityId":"vndb:s195","name":"仙台 エリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:188484:50880:4749:1","source":"bangumi"}]},{"characterId":"char_vndb_c59077","characterName":"神林 麗","sourceIds":{"vndbCharacterId":"c59077"},"originalCharacterName":"神林 麗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"101"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Goddess of Matchmaking"},{"spoiler":false,"text":"A young goddess of fate and future who suddenly appeared before Hajime and warned him that he was going to be a virgin for life. She is bright, lively, and always smiling. She’s also a real chatterbox, and her mouth runs a mile a minute."},{"spoiler":false,"text":"Urara has been assigned to closely observe the unprecedented case of a person who used so many love charms that he managed to break causality."},{"spoiler":false,"text":"She possesses a wide range of divine powers, such as the ability to fly, turn invisible, walk through walls, and communicate via telepathy. In order for her to observe Hajime closely, she also uses her powers to convince people that she’s his younger sister, so she can watch over him while he chooses his future bride."},{"spoiler":true,"text":"She was actually supposed to be born as Hajime's sister but a change of fate caused her to never be born and Urara became a goddess instead. Using her goddess powers makes the world the way it was supposed to be, with her being Hajime's true sister again."},{"spoiler":false,"text":"Her legal documents are obviously fake, but she’s a goddess, so she’s not bound by the laws of our world."},{"spoiler":false,"text":"Though she gave Hajime the gift of destiny count and pulled a few strings to help him transfer schools, her job is primarily to observe him. Beyond that, she only gives him advice when she feels so inclined."},{"spoiler":false,"text":"When it comes to sex, she’s up for anything."},{"spoiler":false,"text":"She can be seductive and cheeky, but that’s only because she doesn’t see herself as a potential love interest. She’s the kind of girl who’d fold easily if you got serious with her."},{"spoiler":false,"text":"She has no insecurities, no complaints, and no fears."},{"spoiler":false,"text":"Modified from johren.games"}],"source":"vndb","sourceCharacterId":"c59077"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b3ac3c8c12ff4807a5d129ad3add09a15ab13130ac587907bac3f5ff6b63925.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa02b507f50e5f871859e729a906c064feb9401dbaace05fd5c12df3cdd39cfa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南美 優","creatorId":"vndb:s4393","sourcePersonId":"vndb:s4393","canonicalEntityId":"vndb:s4393","name":"巽悠衣子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70519","source":"vndb"}]},{"characterId":"char_vndb_c61091","characterName":"神林 始","sourceIds":{"vndbCharacterId":"c61091"},"originalCharacterName":"神林 始","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"531"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this story, who happened to pray too much to unload the wrath of a certain goddess onto him."}],"source":"vndb","sourceCharacterId":"c61091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7073b6d7f45a9e1b01e467faa14abaa55a067fcb62fc251e93836c0aaddec7a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8dcdf30dec43a250e65ecb57b0e0847a2a89261145c35aeae79e009729ea