tatus":"auto-confirmed","relationId":"egs:work-creator:303401","source":"egs"},{"creditedName":"夕凪 セシナ","creatorId":"vndb:s1091","sourcePersonId":"vndb:s1091","canonicalEntityId":"vndb:s1091","name":"夕凪 セシナ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:223074","source":"vndb"},{"creditedName":"天都","creatorId":"vndb:s1092","sourcePersonId":"vndb:s1092","canonicalEntityId":"vndb:s1092","name":"天都","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:223076","source":"vndb"},{"creditedName":"相良 心","creatorId":"vndb:s4225","sourcePersonId":"vndb:s4225","canonicalEntityId":"vndb:s4225","name":"相良 心","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:223077","source":"vndb"},{"creditedName":"冬壱 もんめ","creatorId":"vndb:s4883","sourcePersonId":"vndb:s4883","canonicalEntityId":"vndb:s4883","name":"冬壱 もんめ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:223079","source":"vndb"},{"creditedName":"朝霧 はやと","creatorId":"vndb:s8821","sourcePersonId":"vndb:s8821","canonicalEntityId":"vndb:s8821","name":"朝霧 隼翔","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:223082","source":"vndb"},{"creditedName":"夏月 まりな","creatorId":"vndb:s15391","sourcePersonId":"vndb:s15391","canonicalEntityId":"vndb:s15391","name":"夏月 まりな","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:223083","source":"vndb"},{"creditedName":"さくらねこ","creatorId":"vndb:s16130","sourcePersonId":"vndb:s16130","canonicalEntityId":"vndb:s16130","name":"さくらねこ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:223085","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c166984","characterName":"むぎ","sourceIds":{"vndbCharacterId":"c166984"},"originalCharacterName":"むぎ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strange maid who always marches to the beat of her own drum. She is Hajime's childhood friend and has served him for a long time. She always loves to eat until she's full, and, according to Mugi herself, she always burns off the excessive calories through cleaning her master's unnecessarily large mansion. She is nearly useless when it comes to maid-related activities other than cleaning and serving, to the point where one might even think \"What are maids supposed to be like?\" while looking at her."},{"spoiler":false,"text":"She loves her master a lot, but doesn't act on her feelings because she's absolutely sure that he will pursue after her some day."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c166984"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38469e71c6742341a5ea2af1d024b07dcceac4723e0e4a1b3a50e70b0676b791.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5d59c56a67141b9911ee540ac7d8f94d80bcc104867ded20647557b3b341a3b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲 ウサ","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"桜咲 千依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102438","source":"vndb"}]},{"characterId":"char_vndb_c166985","characterName":"佐藤 緋華","sourceIds":{"vndbCharacterId":"c166985"},"originalCharacterName":"佐藤 緋華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A headstrong girl who was hired by Hajime to work as a part-time maid at his mansion. Her life goes completely upside down as she is forced to be at the whims of the high-class rich girls and guys around her, and she often reacts to the chaotic antics by acting as the group's straight man. She has rather strong convictions for a commoner and tends to lament the absurdities of the world. She also has a habit of trying to reach past her limits."},{"spoiler":false,"text":"Because her mother wasn't good at taking care of her, Hibana taught herself how to cook, and as a result she is a talented cook."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c166985"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20c6ae66f137c2a53128dcd71c707e2edddf6c13e86753ac0d6ccd550387bda6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd14867d233ca5cf624c5df557d63243d800c79b947790af2e59d8fc33286dce.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春乃 いろは","creatorId":"vndb:s2258","sourcePersonId":"vndb:s2258","canonicalEntityId":"vndb:s2258","name":"三宅 麻理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102443","source":"vndb"}]},{"characterId":"char_vndb_c166986","characterName":"高宮 来葉","sourceIds":{"vndbCharacterId":"c166986"},"originalCharacterName":"高宮 来葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Hajime's childhood friend and fiancee who is a very high-class lady. At the same time, because she was raised in a rather sheltered environment, she barely has any common sense. These facts have led to Kureha being a very curious girl who enthusiastically jumps into everything that excites her. However, because she's been so spoiled since she was young, Kureha can't live without her butler Angelina."},{"spoiler":false,"text":"Her knowledge of sexual things is also very limited, as she believes that one could make a baby by kissing someone."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c166986"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63fbbb93eec3b827def471a563e28a26a29242e9ea758ee80be3acb1d6d8d3ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1dcbf9231b09486b0ce343c4dc3cbaca6928c8dc3264918ff96c5389f7ff165.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋野 花","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102440","source":"vndb"}]},{"characterId":"char_vndb_c166987","characterName":"アンジェリーナ・クラウン","sourceIds":{"vndbCharacterId":"c166987"},"originalCharacterName":"アンジェリーナ・クラウン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful girl who serves as Kureha's personal butler, who is also her childhood friend. Angelina was born into a family of butlers and as a result, has always worked as a butler instead of being a maid. Because she has known Kureha for so long, Angelina easily gets carried away when she's around rich girls. Ever since she started working at the Takamiya family's mansion, she has been at the whims of her boarish lady and the haughty guy who keeps hitting on her."},{"spoiler":false,"text":"In private, she behaves like a \"typical girl\"."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c166987"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ad7d9b1234f210c7ea9c478d02d1e6558b34c3d06a2d0b617ea0042e0667302.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eea3f01455caba202f19a525459dd1979560896a9552b4fd53ae92ff859720f1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しましまはかせ","creatorId":"vndb:s44624","sourcePersonId":"vndb:s44624","canonicalEntityId":"vndb:s44624","name":"和久野 愛佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102447","source":"vndb"}]},{"characterId":"char_vndb_c166988","characterName":"雨雲 黒依","sourceIds":{"vndbCharacterId":"c166988"},"originalCharacterName":"雨雲 黒依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hajime's bodyguard who he hired because he got annoyed by a certain conspiracy theorist around him telling him that he won't survive for long. She always laughs in a creepy \"ihihihi\" way. Kuroe is an extremely gloomy girl who constantly wants to die and wouldn't even mind dying for the sake of others, whether it be her acting as a human shield or through other ways. At the same time, she is quite rational in comparison to the others around her."},{"spoiler":false,"text":"Apparently, she started being a bodyguard because she's good at investigating things... and because her nipples are very sensitive. Her defenseless-looking sexy body, combined with her extremely low self-esteem, is constantly making Hajime horny when he glances at her, standing next to him."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c166988"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57ed03a4e2e10a55994c796c877e53f26fe265eb804fa231b1138e993ae367d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78e4bcdb261de026f22cec9c03589cd1e0684588f4f56bdf09dc320d4dbca432.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"碓氷 珊瑚","creatorId":"vndb:s34488","sourcePersonId":"vndb:s34488","canonicalEntityId":"vndb:s34488","name":"木南 向葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102446","source":"vndb"}]},{"characterId":"char_vndb_c166989","characterName":"真琴 凛々","sourceIds":{"vndbCharacterId":"c166989"},"originalCharacterName":"真琴 凛々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A rich girl who is childhood friends with both Hajime and Kureha. She looks relatively normal at first glance, but deep down, she's a twisted girl who hates people who act lovey-dovey and virgins, and constantly fantasizes about being raped. However, she doesn't want any stranger to do it to her, rather the only person she wants to be raped by is Hajime, who also has twisted sex fantasies of his own."},{"spoiler":false,"text":"She's the type of a heroine who shouldn't exist in a pure love eroge."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c166989"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c1f2083ba801e0c9cf07d4737fa6bba932660376fd490097c2d0c9fcf33386d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94224280c0b42adb3fc6f7e90add0810d48213f94800dfa5b1c4af5278e98149.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"歩 サラ","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102439","source":"vndb"}]},{"characterId":"char_vndb_c166990","characterName":"天王 伊知花","sourceIds":{"vndbCharacterId":"c166990"},"originalCharacterName":"天王 伊知花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hajime's younger half-sister. She shares her brother's arrogant nature, but perhaps because she's still so young, her dignified nature is very lacking in contrast to her brother. She loves her older brother and shows hostility towards anyone else who has feelings for him. However, her brother doesn't regard her as a woman due to her immaturity, which is why Ichika wants to become a mature and refined lady as quickly as possible."},{"spoiler":false,"text":"She loves receiving headpats and hates being spanked."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c166990"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f4107a17da9026a58e826190059c67886b79f4b7a7d6a50cb178f25b2833158.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebcdae4f7436fcd3a158e66d408fb0015e121e79d277c7a3fbc44696c7c02a25.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅木 ちはる","creatorId":"vndb:s18362","sourcePersonId":"vndb:s18362","canonicalEntityId":"vndb:s18362","name":"高木 遥香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102445","source":"vndb"}]},{"characterId":"char_vndb_c166991","characterName":"藤ヶ丘 菖蒲","sourceIds":{"vndbCharacterId":"c166991"},"originalCharacterName":"藤ヶ丘 菖蒲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hibana's best and childhood friend who lives nearby. After hearing that Hajime made Hibana one of his maids, they start arguing about various things. Ayame sees herself as a perfectly normal girl, when in reality the fact that she's Hibana's best friend leads to Ayame seeming a bit odd as well."},{"spoiler":false,"text":"Because of her very caring nature, Ichika quickly becomes attached to her... but unfortunately, at the same time, Hajime keeps htting on her because he finds her cute and the fact that she hates him eggs him on."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c166991"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f4fede40824980e918d4819a316fb7621e65345cb5c9dc9bb0f9c1ff3295017.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e577dad3182d7a5140f8e35618a8e6a465f3a4107e17fef785ce3ac228568773.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃山 いおん","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102441","source":"vndb"}]},{"characterId":"char_vndb_c167744","characterName":"天王 肇","sourceIds":{"vndbCharacterId":"c167744"},"originalCharacterName":"天王 肇","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main protagonist who is the heir of one of Japan's most prestigious families. Because of his innate talent and endless efforts, Hajime secured a high status at a young age. His appearance gives off the image that he's very arrogant, something he doesn't bother hiding, especially because he sees himself as a king. He rather enjoys situations that don't go his way."},{"spoiler":false,"text":"He is a truly perverted guy who prefers when his partners resist him and act reluctant. Not once in his life has he masturbated because he has never seen a reason for it."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c167744"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c170837","characterName":"佐藤 焔花","sourceIds":{"vndbCharacterId":"c170837"},"originalCharacterName":"佐藤 焔花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"そらまめ。","creatorId":"vndb:s2143","sourcePersonId":"vndb:s2143","canonicalEntityId":"vndb:s2143","name":"そらまめ。(和鳴るせ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102442","source":"vndb"}]},{"characterId":"char_vndb_c170838","characterName":"坂本 小唄","sourceIds":{"vndbCharacterId":"c170838"},"originalCharacterName":"坂本 小唄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState"