"value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が住んでいるアパートの管理人。"},{"spoiler":false,"text":"主人公にご飯を作ってあげたり、色々な面倒をみてくれる美人女性。"},{"spoiler":false,"text":"主人公を可愛い弟のように思っており、色々と教えてあげなくちゃとも思っている。"},{"spoiler":false,"text":"気弱だが、芯はしっかりしている。何事に対しても寛容で、怒らない。"}],"source":"egs","sourceCharacterId":"13799","sourceWorkId":"13453","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が住んでいるアパートの管理人。"},{"spoiler":false,"text":"元々は父親がアパートの管理人だったが、子供の頃よくアパートを遊び場にしていたため、父親から思い出が詰まったアパートを譲り受けて管理人になった。"},{"spoiler":false,"text":"住人にご飯を作ってあげたりと、面倒見のいい性格。芯はしっかりしているが、気は弱め。"},{"spoiler":false,"text":"主人公に襲われた後も、「それは駄目なことなんだと私がちゃんと教えてあげなくちゃ」 と思い説教をしようとするが、勢いに飲まれてまた襲われる。"},{"spoiler":false,"text":"主人公のことを可愛い弟のように思っている。"},{"spoiler":false,"text":"貞操感が強く男性経験も無い。"},{"spoiler":false,"text":"主人公が王様になったこと等は一切知らない。"},{"spoiler":false,"text":"基本的に寛容で滅多なことがない限り順応する。"}],"source":"bangumi","sourceCharacterId":"48328"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"13799","sourceWorkId":"13453","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"13799","sourceWorkId":"13453","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"13799","sourceWorkId":"13453","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc01bfe01d4ca111bdbcdf2703a0d6cf178cba2ea4b32f062c1ebc416055db10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a41bbfed7f26d61aed3c0014fbf337c731540fde764c74a8bf3176e00b358143.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かがみもえ","creatorId":"vndb:s10418","sourcePersonId":"vndb:s10418","canonicalEntityId":"vndb:s10418","name":"かがみもえ","roleCode":"voice-actor","roleLabel":"声优","identity