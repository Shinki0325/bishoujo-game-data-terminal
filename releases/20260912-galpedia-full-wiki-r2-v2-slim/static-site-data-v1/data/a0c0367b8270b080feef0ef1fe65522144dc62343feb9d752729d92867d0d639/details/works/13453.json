91","characterName":"マリア・ビットナー","sourceIds":{"bangumi":[{"characterId":"48331","match":"exact-normalized-name-in-linked-work","subjectId":"50357"}],"egsCharacterIds":["13802"],"vndbCharacterId":"c18891"},"originalCharacterName":"マリア・ビットナー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴィオラ・フォン・ベリオローズ専属のメイド。"},{"spoiler":false,"text":"ヴィオラの来日時に、連れて来られた。"},{"spoiler":false,"text":"基本的に不器用なドジッ娘の彼女は、簡単なことしか出来ず、それでもヴィオラの無茶な要求をなんとかこなそうとそれこそ一生懸命に奮闘し、結局、何もできず、ヴィオラに叱責され、苛められる、そんな微笑ましい女の子。"},{"spoiler":false,"text":"性格は明るく天然。一応、真面目で努力家。自虐が得意。"},{"spoiler":false,"text":"来日前に、事前に日本のことを調べてくるが、覚えた事柄はすべからく間違っている。"}],"source":"egs","sourceCharacterId":"13802","sourceWorkId":"13453","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴィオラ・フォン・ベリオローズ専属のメイド。ヴィオラが来日する時、共に連れて来られた。"},{"spoiler":false,"text":"無茶な命令をされてもキャパシティが追いつかず、お茶を入れること等簡単なことしかできない。"},{"spoiler":false,"text":"とろい天然なドジっ子で、すぐヴィオラに怒られるが、どれだけ怒られてもヴィオラが好きで傍についている。"},{"spoiler":false,"text":"いつもヴィオラにいじめられているように見えるので主人公が優しくしても、その場面をヴィオラに見られると怒られるのでびくびくする。"},{"spoiler":false,"text":"主人公が蓉子の所へ性行為をしに行く時は全力で阻止するように言われている。"},{"spoiler":false,"text":"子供の頃からヴィオラと育ったため、昔からヴィオラの無茶な要求に振り回され、一生懸命要求に答えようとするが実際は微塵も役に立たない、へっぽこ。"},{"spoiler":false,"text":"なるべく明るく振舞おうとする。たまに落ち込んだ時でも優しくされるのに慣れておらず慌てて自虐に入る。"},{"spoiler":false,"text":"真面目なので来日する前に日本のことを調べてきているが、へっぽこなので間違った知識で覚えている。"}],"source":"bangumi","sourceCharacterId":"48331"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"13802","sourceWorkId":"13453","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"13802","sourceWorkId":"13453","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"13802","sourceWorkId":"13453","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52f8f3dcbcb3da699693cf867e48a3a077f01f9e2bdd85c09912a875c896d1d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c2a0ec7f528820d5fc06324b372c23662587001acc55787bbd91752065c1bdf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"有河春花","creatorId":"vndb:s877","sourcePersonId":"vndb:s877","canonicalEntityId":"vndb:s877","name":"春河 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50357:48331:19159:1","source":"bangumi"}]},{"characterId":"char_c18894","characterName":"リコ・フラン・フライン","sourceIds":{"bangumi":[{"characterId":"48329","match":"exact-normalized-name-in-linked-work","subjectId":"50357"}],"egsCharacterIds":["13800"],"vndbCharacterId":"c18894"},"originalCharacterName":"リコ・フラン・フライン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の母が結婚した東欧はラトリア王国の国王の娘。主人公の義妹にあたる。"},{"spoiler":false,"text":"幼い頃から主人公の母に、日本にいる兄のことを聞かされて育ち、見たことのない主人公に恋心を育んできた。"},{"spoiler":false,"text":"純粋培養のお姫様で、疑うことを知らず、騙されやすい。"},{"spoiler":false,"text":"庶民的なことを知らず、そうした庶民的なことに対して、旺盛な好奇心を見せる。"},{"spoiler":false,"text":"幼い頃よりずっと礼儀礼節をしっかりと教え込まれているため、とても優雅で上品。"},{"spoiler":false,"text":"性についてはまったく知らず、孕むことについてもその意味を理解していない。"}],"source":"egs","sourceCharacterId":"13800","sourceWorkId":"13453","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の母が結婚した王の娘で、主人公の義理の妹にあたる。"},{"spoiler":false,"text":"幼い頃から母に主人公のことを聞かされていて、見たこともない主人公に恋心を抱いていた。"},{"spoiler":false,"text":"父親が国外に出ることを許さず主人公に会えずにいたが、父親が死んでしまったので来日して主人公に会いに行くことにする。"},{"spoiler":false,"text":"主人公を一目見て、思い描いていた以上の兄だったことに感激し、純粋に結婚したくて主人公の子供を孕もうとする。"},{"spoiler":false,"text":"性については詳しくなく、孕むことの意味もあまり理解していない。"},{"spoiler":false,"text":"また、主人公をものすごく美化しているので出鱈目や嘘をつかないと思っているから騙されやすい。"},{"spoiler":false,"text":"幼少より教育を受けていたので礼儀礼節はしっかりしているが、好きな人には我慢できずに身体でスキンシップをとる。"},{"spoiler":false,"text":"庶民的なものは見たことがなく全く知らない。好奇心旺盛で新しい発見には興味津々になる。"}],"source":"bangumi","sourceCharacterId":"48329"}],"profileFacts":[{"label":"胸围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"13800","sourceWorkId":"13453","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"13800","sourceWorkId":"13453","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"13800","sourceWorkId":"13453","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82543434630f262e5bb4e6532eb60bf46ffe4a2c05a7689e4dbedb49dd051db4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/400ee260628eeca68ff8e80f57a41f9b3aa64a966cea8edcc4e9dd96069be77d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紅月 ことね","creatorId":"vndb:s1649","sourcePersonId":"vndb:s1649","canonicalEntityId":"vndb:s1649","name":"琴音 有波","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22936","source":"vndb"}]},{"characterId":"char_c18895","characterName":"ヴィオラ・フォン・ベリオローズ","sourceIds":{"bangumi":[{"characterId":"48330","match":"exact-normalized-name-in-linked-work","subjectId":"50357"}],"egsCharacterIds":["13801"],"vndbCharacterId":"c18895"},"originalCharacterName":"ヴィオラ・フォン・ベリオローズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が王になったラトリア王国の隣国の王女様。"},{"spoiler":false,"text":"容姿端麗で、頭も良いが、迂闊な性格が災いし、失敗することが多い。"},{"spoiler":false,"text":"生まれてからずっと蝶よ花よと可愛がられ、それが当たり前だと思って生きてきた。"},{"spoiler":false,"text":"全て自分の思い通りになると思っており、さらにナルシストで、プライドも高く、考え方も自己中心的であり、何事にも強気。"},{"spoiler":false,"text":"本当は元庶民である主人公とセックスすることに抵抗があるが、父王の命令で仕方なく、それに従っていた。しかし生まれて初めて、ないがしろにされたり、無視されたり、自分の思い通りにならない主人公が許せず、逆に積極的にセックスを迫る。"}],"source":"egs","sourceCharacterId":"13801","sourceWorkId":"13453","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が王になった国の隣国の王女様。"},{"spoiler":false,"text":"容姿端麗にして領地も統治できる程の頭脳も持っている。しかし迂闊で結果的にダメダメな感じ。"},{"spoiler":false,"text":"箱入り娘で庶民的な生活を全く知らず、事ある毎に驚く。"},{"spoiler":false,"text":"また、性的な知識はあるものの実体験がないので、戸惑いながらも表には出さないようにする。"},{"spoiler":false,"text":"元庶民の主人公に処女を捧げ性行為をする事は内心嫌で嫌悪感があるが、父親の命令なのでしょうがないと思っていた。"},{"spoiler":false,"text":"しかし、その主人公に自分がないがしろにされ、元庶民の癖に許せないと主人公に子供を孕まさせようとする。"},{"spoiler":false,"text":"産まれてからご機嫌取りに囲まれる生活を送っていたので、産まれて初めて迫ったのに拒否する主人公に興味を持っていく。"},{"spoiler":false,"text":"子供の頃から命令1つで何でもできていたので、常に強気。"},{"spoiler":false,"text":"ナルシストでプライドが高く、行動については「やらせてあげている」「やってあげている」という自己中心的な考えをしている。"},{"spoiler":false,"text":"日本特有のものはマリア・ビットナーの情報のせいで間違った知識を持っているが、知ったかぶりを色々と披露して主人公にツッコまれる。"}],"source":"bangumi","sourceCharacterId":"48330"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCha