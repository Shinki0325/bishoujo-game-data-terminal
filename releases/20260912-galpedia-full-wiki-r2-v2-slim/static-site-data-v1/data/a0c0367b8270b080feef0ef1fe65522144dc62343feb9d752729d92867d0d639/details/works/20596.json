urce-native","relationId":"vndb:vn-staff:110396","source":"vndb"},{"creditedName":"NATSUMI","creatorId":"vndb:s43763","sourcePersonId":"vndb:s43763","canonicalEntityId":"vndb:s43763","name":"NATSUMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:110402","source":"vndb"}]},"cast":[{"characterId":"char_c10132","characterName":"蓬莱泉 麗奈","sourceIds":{"bangumi":[{"characterId":"17530","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"17530","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["565"],"vndbCharacterId":"c10132"},"originalCharacterName":"蓬莱泉 麗奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new teacher at St. Michael's who is also Runa's older sister and Takako's former tutor. Stylish and stunningly beautiful — the perfect woman. Outgoing and easygoing. Although she’s blunt and untidy, for some reason she has the kind of likable personality that’s impossible to hate."},{"spoiler":false,"text":"Rena is an alumnus of St. Michael's, and at the time, the teachers all praised her for being a well-behaved lady. But in actuality, she was chasing skirts left and right, regardless if they were seniors or juniors. It’s rumored her lovers numbered at nearly a hundred."},{"spoiler":false,"text":"Translated from Getchu and Yurin Yurin"}],"source":"vndb","sourceCharacterId":"c10132"},{"segments":[{"spoiler":false,"text":"ミカ女の新任教師。瑠奈の実姉にして、貴子の元家庭教師。"},{"spoiler":false,"text":"格好良い系の颯爽とした超美人で完璧超人。"},{"spoiler":false,"text":"性格は奔放にして自由闊達。あけすけでだらしがないが、何故か憎めず人に好かれる得な性格。"},{"spoiler":false,"text":"ミカ女出身（女子短大卒）のOGで、当時の彼女を知る教師達は「究極の淑女」と褒め称えるも……"},{"spoiler":false,"text":"その実、上下級生関わらず手を出しまくっていた超ナンパ体質で、3桁近い恋人が居たともウワサされる。"}],"source":"egs","sourceCharacterId":"565","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"瑠奈の実姉にして、貴子の元家庭教師。格好良い系の颯爽とした超美人で完璧超人。"},{"spoiler":false,"text":"海外を飛び回る実業家で、この春まではミカ女で教師をしていたという謎の才女。"},{"spoiler":false,"text":"性格は奔放にして自由闊達。あけすけでだらしがないが、何故か憎めず人に好かれる得な性格。"},{"spoiler":false,"text":"ミカ女出身のＯＧでもあり、当時「究極の淑女」と呼ばれるも、３桁を超す恋人がいたと噂される。"}],"source":"egs","sourceCharacterId":"565","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の新任教師。瑠奈の実姉にして、貴子の元家庭教師。格好良い系の颯爽とした超美人で完璧超人。"},{"spoiler":false,"text":"性格は奔放にして自由闊達。あけすけでだらしがないが、何故か憎めず人に好かれる得な性格。"},{"spoiler":false,"text":"ミカ女出身（女子短大卒）のＯＧで、当時の彼女を知る教師達は「究極の淑女」と褒め称えるも……"},{"spoiler":false,"text":"その実、上下級生関わらず手を出しまくっていた超ナンパ体質で、３桁近い恋人が居たともウワサされる。"},{"spoiler":false,"text":"声：真鶴　コウ (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"17530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91451322712d1789bf69040e562a939cbd4009e5af9408a935e1a68d7eb3f0af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5e00c25657e3a8497ca522afc6718bcbaf4c468c4003f6086f2e6b20fbe6788.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真鶴 コウ","creatorId":"vndb:s3864","sourcePersonId":"vndb:s3864","canonicalEntityId":"vndb:s3864","name":"真鶴 コウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59058","source":"vndb"}]},{"characterId":"char_c3034","characterName":"蓬莱泉 瑠奈","sourceIds":{"bangumi":[{"characterId":"16615","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16615","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["564"],"vndbCharacterId":"c3034"},"originalCharacterName":"蓬莱泉 瑠奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"819"},"bust":{"reviewState":"source-only","source":"vndb","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fifth/sixth grade primary school student and recent transfer at St. Michael's. Smart, mature and highly charismatic for her age, Runa has won many fans in her class but she is very interested with her teacher Takako and declares she belongs to her."},{"spoiler":true,"text":"Runa harbors resentment over her older sister Rena, yet unseen in the story, who frequently leaves her alone while she goes out on business trips. Runa's older sister is Takako's former crush, which leads to the relationship between Runa and Takako once they meet for the first time in St. Michael's."},{"spoiler":false,"text":"Edit from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3034"},{"segments":[{"spoiler":false,"text":"ミカ女初等部にやって来た転校生で貴子の恋人。"},{"spoiler":false,"text":"高圧的で高飛車な女王様タイプで、大人びた態度と物言いで、周囲を振り回す。"},{"spoiler":false,"text":"「せんせいはわたしのモノ」と公言してはばからず、そのくせ人の意見は聞かない自己中心的性格。"},{"spoiler":false,"text":"こと貴子に関してはかなりの嫉妬深さだが、直情的に激高するのではなく、静かに脅し文句を言う感じ。"},{"spoiler":false,"text":"基本的にサドっぽく、なにかと自分の都合の良い様に解釈しては、Ｓっぽく婉然と微笑む。"}],"source":"egs","sourceCharacterId":"564","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女附属の中等部１年生で貴子の恋人。高圧的で高飛車な女王様タイプで、大人びた態度と物言いで周囲を振り回す。"},{"spoiler":false,"text":"「せんせいはわたしのモノ」と公言してはばからず、そのくせ人の意見は聞かない自己中心的性格。"},{"spoiler":false,"text":"基本的にドエスで、なにかと自分の都合の良い様に解釈しては、婉然と微笑む女王様体質。"},{"spoiler":false,"text":"中等部に進学するも、相変わらずのリーダーシップとカリスマで、クラスに君臨している模様。"}],"source":"egs","sourceCharacterId":"564","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"初等部六年级学生（网络小说版为五年级），得知贵子是姊姊唯一保持柏拉图关系的学妹后，为接近她而回到日本转读米卡女校。表面上是高傲任性而嗜虐的女王型性格，面对身分和年龄差极大的贵子仍公然宣布“老师属于我的”…游戏版设定上回日本和贵子同居前处于独居状态，某程度是全主角中家庭环境最恶劣的一人。就连有如遗传的天才级学力、领导才能及待人处事方式也是她努力学会，精神年龄和外表相反地非常成熟，只有和贵子独处时生活习惯才会像一名约10岁的小孩。"},{"spoiler":false,"text":"对贵子的称呼是“老师”，但文字上有如为了显出年龄和性格特征而用平假名的“せんせい”。身材数值全是比玲绪略高。"},{"spoiler":false,"text":"声：上田幸姫 (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16615"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3098e41418d49626603a9853cb34ab3521017294614dbb76d66addd1e2e303c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/eceb8ec46ed1ba1ac5df106f24be44f18d28e81f712dc0b36566ff2abbec9b9c.webp","width":90,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116739:16615:5052:1","source":"bangumi"}]},{"characterId":"char_c3035","characterName":"墨廼江 貴子","sourceIds":{"bangumi":[{"characterId":"16614","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16614","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["563"],"vndbCharacterId":"c3035"},"originalCharacterName":"墨廼江 貴子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"316"},"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A former graduate of St. Michael's who is now a teacher at the school's primary division. Takako is very embarrassed that Runa can easily dominate her while stealing her first kiss."},{"spoiler":true,"text":"She was once in love with Runa's older sister, Rena."},{"spoiler":false,"text":"Edit from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3035"},{"segments":[{"spoiler":false,"text":"「聖ミカエル女子学園、初等部の教師。"},{"spoiler":false,"text":"キャリア数年目にして初担任を持ち、教え子の瑠奈とは恋人同士。"},{"spoiler":false,"text":"現在瑠奈とは同棲中で、大人としてあれこれ子供らしい振る舞いを教えようとするも、逆に振り回されっぱなし。"},{"spoiler":false,"text":"とはいえ押しの強い瑠奈に迫られ悪い気はせず、瑠奈の外見、高貴な立ち振る舞いに見惚れる事しばし。"},{"spoiler":false,"text":"むしろカミングアウトしたい気持ちを「あの娘は私の教え子なのよ～っ!?」と必死に堪えている。"}],"source":"egs","sourceCharacterId":"563","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"「聖ミカエル女子学園、附属部の教師。かつての教え子の瑠奈とは恋人同士。"},{"spoiler":false,"text":"今も瑠奈とは同棲中で、大人としてあれこれ子供らしい振る舞いを教えようとするも、逆に振り回されっぱなし。"},{"spoiler":false,"text":"とはいえ押しの強い瑠奈に迫られ悪い気はせず、瑠奈の外見、高貴な立ち振る舞いに見惚れる事しばし。"},{"spoiler":false,"text":"瑠奈の進学に伴い担任から外れてしまったが、その分私生活でべったりになってしまっている模様。"}],"source":"egs","sourceCharacterId":"563","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"曾是米卡女校旧生的初等部教师，初时性格懦弱而冒失。被神秘转校生琉奈突然吻过后，虽被她玩弄于鼓掌中，但又对她一见钟情。后来得知琉奈就是贵子学生时代单恋的学姊的妹妹…二人关系有进展以后，贵子对琉奈的称呼视乎场合为“蓬莱泉同学”或“琉奈”，不过对琉奈愈来愈着迷的贵子于第九作课堂剧情中时常差点直说名字。"},{"spoiler":false,"text":"声：あずまゆい (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16614"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8fa62f56161dd3b6ad88731dbf167c850d53479fa990761298540be1b8d56c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3621ac91c48ecd6970279b9ca5b821e8197b1df663aa508d0dd1451136d02322.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿久津加菜","creatorId":"vndb:s75","sourcePersonId":"vndb:s75","canonicalEntityId":"vndb:s75","name":"阿久津 加菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116739:16614:4884:1","source":"bangumi"}]},{"characterId":"char_c7197","characterName":"粢 エリス","sourceIds":{"bangumi":[{"characterId":"16916","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16916","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["562"],"vndbCharacterId":"c7197"},"originalCharacterName":"粢 エリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1206"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A half-Japanese and half-European third year high school student. She has come to Japan to learn Japanese culture at St. Michael's, where she has attracted many girls due to her looks, including Shizuku."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c7197"},{"segments":[{"spoiler":false,"text":"3年生で、雫のクラスメイト。"},{"spoiler":false,"text":"ミカ女に転入してきた留学生で、北欧系の血を引くハーフ。"},{"spoiler":false,"text":"日本語は堪能で、物怖じしない博愛精神の持ち主という天然ジゴロ体質。"},{"spoiler":false,"text":"その魅力に魅了される女子が続出し、一時校内が騒然となるも、当人にはまったく自覚ナシ。"},{"spoiler":false,"text":"衆人環視も全く気にせず、熱く情愛を語っては、雫にツンデレられる事しばし。"}],"source":"egs","sourceCharacterId":"562","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女短大の１年生で、雫の恋人。かつてミカ女に転入してきた留学生で、北欧系の血を引くハーフ。"},{"spoiler":false,"text":"日本語は堪能で、かつて「リリ・プラチナム」というファンクラブを持つ有名人。"},{"spoiler":false,"text":"現在は雫の家にホームステイしつつ、一緒に短大に通っている模様。"},{"spoiler":false,"text":"相変わらず衆人環視もなんのそので、熱く情愛を語っては、雫にツンデレられる事しばし。"}],"source":"egs","sourceCharacterId":"562","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"雫の恋人。高等部3年生。"},{"spoiler":false,"text":"緩やかなウェーブのかかったプラチナブロンドの髪をポニーテルにし、ガラス玉を埋め込んだような碧眼の美少女。母親が北欧人で父親が日本人のハーフ。自由で気ままな性格だが女の子には優しい天然ジゴロ。日本の文化が大好き。"},{"spoiler":false,"text":"日本に留学してきて初めての友達になった雫を好きになり告白をする。直接的に愛を告げては雫をとまどわせている。"},{"spoiler":false,"text":"現在は一人暮らしで家の中では裸で過ごしている。学園では『リリ・プラチナム』というファンクラブがある。"},{"spoiler":false,"text":"一人称は「ワタシ」、雫のことは「シズク」と呼んでいる。"}],"source":"bangumi","sourceCharacterId":"16916"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/392bfe94f564f1a7ed863603a9d6ed0d5e283e8018e0c7306318ce1e448898e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dbf6a6e211f38785f11118aa2f4abc9fbeba405fe226358c8131714ba85eb7d.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116739:16916:5906:1","source":"bangumi"}]},{"characterId":"char_c7198","characterName":"霧島 雫","sourceIds":{"bangumi":[{"characterId":"16917","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16917","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["561"],"vndbCharacterId":"c7198"},"originalCharacterName":"霧島 雫","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"621"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very traditional Japanese girl in her third year of high school. Having traits of a Yamato nadeshiko, she is very skilled at calligraphy and flower arrangement. She falls in love with Eris after meeting her."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c7198"},{"segments":[{"spoiler":false,"text":"3年生で、幼稚舎からミカ女に通っている、生粋のミカ女育ちの和風美少女。"},{"spoiler":false,"text":"書道家の父を持ち、当人もミカ女一の祐筆「雫御前」として名高い。"},{"spoiler":false,"text":"性格は生真面目で優秀だが、カタカナ言葉に極端に弱い。"},{"spoiler":false,"text":"留学生であるエリスと晴れて恋仲になるも、自分の感情に素直なエリスに、人の目があるにもかかわらず、雫はいつでも振り回されっぱなし。"},{"spoiler":false,"text":"もちろんそんなエリスを嫌いになれるはずもなく、苦労が絶えない様子。"}],"source":"egs","sourceCharacterId":"561","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女短大の１年生、幼稚舎からミカ女に通っている、生粋のミカ女育ちの和風美少女。"},{"spoiler":false,"text":"書道家の父を持ち、かつてミカ女一の祐筆「雫御前」として名高い。"},{"spoiler":false,"text":"性格は生真面目で優秀だが、カタカナ言葉に極端に弱い。"},{"spoiler":false,"text":"かつて留学生であったエリスと晴れて恋仲になり、現在は共にミカ女短大に通っている。"}],"source":"egs","sourceCharacterId":"561","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"『その花びらにくちづけを 天使の花びら染め』と『その花びらにくちづけを リリ・プラチナム』の主人公。エリスの恋人。高等部3年生。"},{"spoiler":false,"text":"琥珀色の瞳に長い黒髪を姫カットにした純和風な美少女。成績優秀でスポーツ万能、教師からの信頼も厚い優等生。完璧主義者である一方で性格的には不器用で融通が利かない。努力家だが努力をしているところを見られるのは嫌い。父親が書道家、母親が華道家の芸術一家で本人も書が得意である。家にはお手伝いさんがいる。周りからは「雫御前」と呼ばれている。外来語が苦手でカタカナ語は「ひらがな」で表記されている。"},{"spoiler":false,"text":"留学してきたエリスの世話役を任されるが最初は人気者の座を奪ったエリスに嫉妬に近い感情を抱いていた。しかし、実はエリスに一目惚れをしていた。エリスに告白されてつき合うようになっても素直になれず憎まれ口を叩いては後悔している。自然と女の子をくどいてしまうエリスにやきもきしている。"},{"spoiler":false,"text":"伝統遊戯研究会の所属しているが、エリスが入部するまでは一人きりの部活だった。"},{"spoiler":false,"text":"一人称は「わたくし」、エリスのことは「エリス」と呼び捨てにしている。"},{"spoiler":false,"text":"声：未瑛 (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16917"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb7011f9f6d3f8b96da9023fc81ab7f33297d84f8b0f27ff0763a2521e70430b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74c59ac1b879c887ee9f6577f658a57739d3849b9859a34476abb3fc0d131269.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡田栄美","creatorId":"vndb:s599","sourcePersonId":"vndb:s599","canonicalEntityId":"vndb:s599","name":"岡田 栄美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116739:16917:15740:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p437","sourceCompanyId":"egs:brand:1942","canonicalEnti