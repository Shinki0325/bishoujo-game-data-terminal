{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11852","model":{"presentationWorkId":"vndb:v25742","staff":{"artwork":[{"creditedName":"大野哲也","creatorId":"vndb:s2932","sourcePersonId":"egs:creator:400","canonicalEntityId":"vndb:s2932","name":"大野哲也","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74127","source":"egs"}],"scenario":[{"creditedName":"亜麻矢幹(まろにぃ)","creatorId":"vndb:s5695","sourcePersonId":"egs:creator:1736","canonicalEntityId":"vndb:s5695","name":"亜麻矢幹(まろにぃ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74128","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c58889","characterName":"不死の巫女","sourceIds":{"bangumi":[{"characterId":"4355","match":"exact-normalized-name-in-linked-work","subjectId":"16989"}],"egsCharacterIds":["19335"],"vndbCharacterId":"c58889"},"originalCharacterName":"不死の巫女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"プリーシア護衛の任を受け、和の国から派遣された巫女。"},{"spoiler":false,"text":"強力な治癒魔法を使い、“不死の巫女”と呼ばれる。"},{"spoiler":false,"text":"［■アフターストーリー］"},{"spoiler":false,"text":"戦乱が終わり復興へと進み始めた世界で、プリーシア護衛の任を完遂した神楽は、和の国へ帰ることになった。"},{"spoiler":false,"text":"寂しいクセに素直になれず、彼女との別れに動揺するプリーシアは、送別会でなんとか神楽に別れを告げようとするが……？"}],"source":"egs","sourceCharacterId":"19335","sourceWorkId":"9747","spoiler":false},{"segments":[{"spoiler":false,"text":"プリーシアの護衛のため、和の国から派遣されてきた巫女。"},{"spoiler":false,"text":"○力な治癒魔法を使うことが出来、和の国では「不死の巫女」と呼ばれていた。"},{"spoiler":false,"text":"無口な性格で、話をする時も必要最低限の言葉しか話さない。"},{"spoiler":false,"text":"恋愛のスキルは全くゼロ。"},{"spoiler":false,"text":"和之国的巫女，擅长治疗魔法。母性本能强，性格沉默而贪吃。与平常人的神经不太一样，但也有逗趣的一面。"},{"spoiler":false,"text":"mask当故乡蔓延著传染病的时候，母亲让她服下她们一族代代守护、村里不外传的“不老不死药”而得到了接近不死的惊人回复力（俗称“不死的巫女”）。而年幼的神乐即使到了村民全部往生、尸体腐化的情况，仍然无法接受残酷的现实，直到偶然路过的破戒僧出现为止都还以为“大家仍然活着”。破戒僧将她带到前作神弥无率领的组织当中，终于让她接受现实。但是亦由于这个原因，失去了以前的开朗，变得沉默寡欢。神乐路线的结局里，从不死的力量解脱后回到故乡，供养家族与村人。/mask"}],"source":"bangumi","sourceCharacterId":"4355"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcaadfa4b805e4b0623458fca7e49805994891c19c3305c76bf7f3e4f52874b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52369d7049ee8a9e05792ee71165ed12737de76e281fa00c6cdcdd12e8de1fb7.webp","width":211,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p144","sourceCompanyId":"egs:brand:225","canonicalEntityId":"vndb:p144","name":"ぱじゃまソフト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:11852:225","source":"egs"},{"companyId":"vndb:p144","sourceCompanyId":"vndb:p144","canonicalEntityId":"vndb:p144","name":"ぱじゃまソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:71684:v25742","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
