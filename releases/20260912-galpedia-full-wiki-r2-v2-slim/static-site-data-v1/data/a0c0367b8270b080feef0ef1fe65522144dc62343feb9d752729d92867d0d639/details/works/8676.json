:"vndb:s43203","sourcePersonId":"vndb:s43203","canonicalEntityId":"vndb:s43203","name":"kanoko","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10638","source":"vndb"}]},"cast":[{"characterId":"char_c11251","characterName":"涼風 あすか","sourceIds":{"bangumi":[{"characterId":"45876","match":"exact-normalized-name-in-linked-work","subjectId":"22614"}],"egsCharacterIds":["1402"],"vndbCharacterId":"c11251"},"originalCharacterName":"涼風 あすか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【友達以上、恋人未満の腐れ縁】"},{"spoiler":false,"text":"主人公の隣の家の娘。"},{"spoiler":false,"text":"荘介が0～3、10歳から現在までの幼なじみ。"},{"spoiler":false,"text":"ヒロイン中で一番、荘介と多い時間を過ごしている仲。"},{"spoiler":false,"text":"料理、お洗濯、掃除と家事手伝い好きでお世話焼きな王道幼なじみ。"},{"spoiler":false,"text":"離れて暮らしていた時期はあるが昔からの幼なじみで気の合う仲。"},{"spoiler":false,"text":"家族のような近い存在なのでなかなか恋愛感情までには発展せず。"},{"spoiler":false,"text":"だが琴音とエミリーが荘介の家に住むことになり"},{"spoiler":false,"text":"幼なじみという間柄も同じ二人に今まで思いもしなかった嫉妬心が生まれる。"},{"spoiler":false,"text":"やきもち焼きなのだがそんな自分を認めたくない性格で荘介の事を気にする自分の心に言い訳ばかりしている純な乙女である（可愛いところ）。"},{"spoiler":false,"text":"真面目な性格なので騙されやすくからかいがいがある。"},{"spoiler":false,"text":"挑発にもノリやすいのでついつい売り言葉に買い言葉といった討論に陥りやすい。"}],"source":"egs","sourceCharacterId":"1402","sourceWorkId":"8676","spoiler":false},{"segments":[{"spoiler":false,"text":"荘介が0～3、10歳から現在までの幼なじみ。ヒロイン中で一番、荘介と過ごした時間が長い仲。"},{"spoiler":false,"text":"料理、お洗濯、掃除と家事手伝い好きでお世話焼きな王道幼なじみ。離れて暮らしていた時期はあるが昔からの幼なじみで気の合う仲。家族のような近い存在なのでなかなか恋愛感情までには発展しない。だが琴音とエミリーが荘介の家に住むことになり、幼なじみという間柄も同じ二人に今まで思いもしなかった嫉妬心が生まれる。"},{"spoiler":false,"text":"やきもち焼きなのだがそんな自分を認めたくない性格で荘介の事を気にする自分の心に言い訳ばかりしている純な乙女。"}],"source":"bangumi","sourceCharacterId":"45876"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae3115d7714a4a2455f9f2c79614d895295cb110b2148f61938840ef467a96d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35eb4e9aaf21cfa3f92b9372d9a08adc9aed45e4b4d901eae343c43c2c51ce45.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22614:45876:4489:1","source":"bangumi"}]},{"characterId":"char_c11252","characterName":"御堂 琴音","sourceIds":{"bangumi":[{"characterId":"45877","match":"exact-normalized-name-in-linked-work","subjectId":"22614"}],"egsCharacterIds":["1404"],"vndbCharacterId":"c11252"},"originalCharacterName":"御堂 琴音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【夢はお嫁さんのオットリ系】"},{"spoiler":false,"text":"主人公と小学校低学年のときの幼なじみ（3年間）。"},{"spoiler":false,"text":"荘介が7～9歳の頃幼なじみだった女の子。"},{"spoiler":false,"text":"親同士が仲がよく許婚のような扱いを受けている。"},{"spoiler":false,"text":"琴音本人はそれを本気に思っているところがあり一途で一生懸命な女の子。"},{"spoiler":false,"text":"家がヤクザの組で父親が組長である、琴音は一人娘。"},{"spoiler":false,"text":"大人し目な性格だが幼少時から武道を習い家柄の環境もあってか格闘能力が非常に高い。"},{"spoiler":false,"text":"本人的には戦う意思がまったくないのだが防衛本能が強く後ろに立たれると反射的に手が出てしまう困った特徴を持つ。"},{"spoiler":false,"text":"（女性には反応せず男性のみで荘介だけは後ろに立たれても手が出ない）"},{"spoiler":false,"text":"出身が大阪なので関西弁の方言を喋り、ゆったりとした口調。"},{"spoiler":false,"text":"親戚には京都の包帯問屋である「ナースにおまかせ」で登場した御堂鈴がいる。"},{"spoiler":false,"text":"幼少時の主人公との遊びは、組員が所持していたSMのエロ本を隠し見わけがわからないが何だか楽しいとした興味本意で遊んでいた。"}],"source":"egs","sourceCharacterId":"1404","sourceWorkId":"8676","spoiler":false},{"segments":[{"spoiler":false,"text":"荘介が7～9歳の頃幼なじみだった女の子。"},{"spoiler":false,"text":"親同士が仲がよく許婚のような扱いを受けている。琴音本人もそれを本気だと思っている。"},{"spoiler":false,"text":"ヤクザの組長の一人娘で、大人し目な性格ながら幼少時から武道を習っていることと家柄もあって、格闘能力が非常に高い。本人的には戦う意思がまったくないのだが、後ろに立たれると反射的に手が出てしまう（ただし、女性と荘介だけには手が出ない）。"},{"spoiler":false,"text":"出身が大阪なので、ゆったりとした口調の関西弁で喋る。"}],"source":"bangumi","sourceCharacterId":"45877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/6889951bbcbd88479e3a5364989d095114397186e469340b809337a311e9c26f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc2c63d7376b93ea8aeb5f0a16f309748ebd68f52bb8f779d130874fa35af7de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22614:45877:4675:1","source":"bangumi"}]},{"characterId":"char_c50917","characterName":"エミリー・ウィンスレット","sourceIds":{"bangumi":[{"characterId":"45878","match":"exact-normalized-name-in-linked-work","subjectId":"22614"}],"egsCharacterIds":["1403"],"vndbCharacterId":"c50917"},"originalCharacterName":"エミリー・ウィンスレット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【活動的なアメリカ娘】"},{"spoiler":false,"text":"主人公と幼稚園（キンダー）のときの幼なじみ　5歳の頃（2年間）。"},{"spoiler":false,"text":"アメリカでは家も隣同士だった。明るくオープンで大胆な性格。"},{"spoiler":false,"text":"荘介が5～6歳の昔、海外（アメリカ）で2年間暮らしていた頃、隣に住み一緒に遊んでいた女の子でアメリカ人の幼なじみ。"},{"spoiler":false,"text":"エミリーは荘介に会うため日本語を覚えてこちらに留学してくる（荘介宅へホームステイ）。"},{"spoiler":false,"text":"文化の違いもあり、特にスキンシップでは荘介に抱きついたりキス（ほっぺ）したりと大胆な行為が多い。"},{"spoiler":false,"text":"昔の遊びを記録した日記についてもエッチなものであれ関係なく積極的な姿勢を見せる。"},{"spoiler":false,"text":"性格はサバサバで思った事は口に出す行動的な体育会系である。"},{"spoiler":false,"text":"エミリーは幼なじみとしてあすかと琴音に最初から対抗意識がある。"}],"source":"egs","sourceCharacterId":"1403","sourceWorkId":"8676","spoiler":false},{"segments":[{"spoiler":false,"text":"荘介が5～6歳頃、アメリカで暮らしていた頃、隣に住み一緒に遊んでいたアメリカ人の幼なじみ。荘介に会うため、日本語を覚えて日本に留学。荘介宅へホームステイすることになる。"},{"spoiler":false,"text":"文化の違いからか、主人公に抱きついたりキス（ほっぺ）したりと大胆なスキンシップを取って来る。昔の遊びを記録した日記についても、エッチなものでも関係なく積極的な姿勢を見せる。"},{"spoiler":false,"text":"性格はサパサパで思った事は口に出す行動的な体育会系。幼なじみとして、自分以外の幼なじみである明日香と琴音に対抗意識がある。"}],"source":"bangumi","sourceCharacterId":"45878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/eff3354ad1a4d4a3f8272926a5aca6224b051dfed7e423ff387ae5667546f030.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae91db07bc03003bf3d6352895c6e4bc90fb741fb4cce103e9e59bcdbefe2dc0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22614:45878:4809:1","source":"bangumi"}]},{"characterId":"char_vndb_c113674","characterName":"後藤 荘介","sourceIds":{"vndbCharacterId":"c113674"},"originalCharacterName":"後藤 荘介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c54338","characterName":"浅野 康晴","sourceIds":{"vndbCharacterId":"c54338"},"originalCharacterName":"浅野 康晴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"ht