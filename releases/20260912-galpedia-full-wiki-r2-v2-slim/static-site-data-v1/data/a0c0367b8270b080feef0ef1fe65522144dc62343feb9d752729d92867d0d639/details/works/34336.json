lue":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukiko is the first female student to attend Seigetsu Academy and is often pursued by many of the other male students. She is part of the Student Council, the Archery Club, and is also on clinic duty. She always strives to do her best, which sometimes results in overworking herself to the point of collapsing."},{"spoiler":false,"text":"She has a total of 12 potential love interests, although this number increases in the After Season games due to the introduction of new characters and the ability to date minor characters."},{"spoiler":false,"text":"From Starry☆Sky Wikia"},{"spoiler":false,"text":"Tsukiko is drawn without eyes in the original Starry☆Sky. After the release of After series and all game releases, player have the option to have Tsukiko's eyes included in CGs or not."}],"source":"vndb","sourceCharacterId":"c4788"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56442d5ec2d3d139ee3fa7ce0cfcb83a11c0827d0445725cce9141550cdd0b55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6b3d37e06d6198ec9f8d50605237831f4813355a655dfdd2459b0d564eeb45f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4789","characterName":"土萌 羊","sourceIds":{"vndbCharacterId":"c4789"},"originalCharacterName":"土萌 羊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"112"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"You represents the Capricorn. His French name is Henri Samuel Jean Aimée. Likewise, he is half-French and was often teased for that as a kid. He met Tsukiko when he was young, and because she was the only person who didn't make fun of him for being half-French, he fell in love with her and asked his father to let him transfer to Seigatsu Academy in order to pursue her. Initially disdainful to everyone except Tsukiko, eventually, he learns the importance of having friends. His father hopes to work in America to develop a special astronomy project. He is a second year."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc698b668e8fc22af5a2499b0727b79015979f871582f3b0e430f46ef57b1f10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19dc6155eba329c4acf89057aaf99b69dd70b7a13026b2afae062248d7da77c2.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緑川 光","creatorId":"vndb:s73","sourcePersonId":"vndb:s73","canonicalEntityId":"vndb:s73","name":"緑川 光","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:16333","source":"vndb"}]},{"characterId":"char_vndb_c4790","characterName":"七海 哉太","sourceIds":{"vndbCharacterId":"c4790"},"originalCharacterName":"七海 哉太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"318"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kanata represents the Pisces. Brash and impulsive, he has been friends with Tsukiko since childhood and has developed feelings for her. He does not get along very well with Yoh. Kanata suffers from a terminal illness that leaves him in a lethargic state, which is why he often skips classes and faints without reason. However, he refuses to seek medical help and often gets into school fights that worsen his health to protect Tsukiko. He is a second year."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cf3c30f62819f22ab96b4f777c94f9d9c53b0c6348ad211cea178aa4cf894f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c32853866d1c07b7643a2a44dda026f5708bb3d98a97f7159bcca0e2795c04ee.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田 智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:16335","source":"vndb"}]},{"characterId":"char_vndb_c4791","characterName":"東月 錫也","sourceIds":{"vndbCharacterId":"c4791"},"originalCharacterName":"東月 錫也","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"701"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Suzuya represents the Cancer. Calm and friendly, he was friends with Tsukiko and Kanata since childhood and often watches out for them like an older brother. He is very good at cooking and often uses the school's kitchen to prepare food for his friends. Suzuya is also in love with Tsukiko, but because he knows that Kanata also loves her, he held back. He is a second year."},{"spoiler":true,"text":"Beneath his warm exterior, Suzuya has a dark side and worries about Tsukiko constantly."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4791"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8b579e07e6a24e6f41f41b49c316e43518bb979855ee0680668ede48e6127c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b4dde45a21b5bcbbcfa9f3bdd4c06b6cb41180381cbf47bef2b070c2b3df8ca.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野 大輔","creatorId":"vndb:s103","sourcePersonId":"vndb:s103","canonicalEntityId":"vndb:s103","name":"小野 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:16334","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p776","sourceCompanyId":"egs:brand:4417","canonicalEntityId":"vndb:p776","name":"honeybee","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:34336:4417","source":"egs"},{"companyId":"vndb:p776","sourceCompanyId":"vndb:p776","canonicalEntityId":"vndb:p776","name":"honeybee","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11795:v2021","source":"vndb"},{"companyId":"vndb:p1765","sourceCompanyId":"vndb:p1765","canonicalEntityId":"vndb:p1765","name":"OGE","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:13182:v2021","source":"vndb"},{"companyId":"vndb:p776","sourceCompanyId":"vndb:p776","canonicalEntityId":"vndb:p776","name":"honeybee","roleCodes":["developer