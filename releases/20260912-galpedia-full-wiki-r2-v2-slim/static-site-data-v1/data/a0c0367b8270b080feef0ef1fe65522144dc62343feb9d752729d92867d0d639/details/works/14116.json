nts":[{"spoiler":false,"text":"A transfer student who enrolled at the academy on the same day as the protagonist."},{"spoiler":false,"text":"With a gentle smile, she exudes a refined and soft aura, and her bright demeanor toward everyone from day one quickly earns her the title of the academy’s princess."},{"spoiler":false,"text":"Chinatsu is always surrounded by a crowd, making it impossible to talk to her alone, but a chance encounter leads to working the same part-time job together."},{"spoiler":false,"text":"“W-Would someone like me really be okay? I’m kind of a hopeless girl, you know?”"}],"source":"vndb","sourceCharacterId":"c10399"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26e376fafde9a8a52d2871c2dde5a78489ff49ee79465fe7cc97274be7e68569.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/859a98ed4613f85492ab1a1f54da45f2ec4e277fbb6356ab80d1452b768725a6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33094","source":"vndb"}]},{"characterId":"char_vndb_c10401","characterName":"愛沢 花穂","sourceIds":{"vndbCharacterId":"c10401"},"originalCharacterName":"愛沢 花穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist’s genuine younger sister by blood, attending a different academy."},{"spoiler":false,"text":"Exceptional in intellect, looks, and athletic ability."},{"spoiler":false,"text":"Fully aware of her own charm and popularity, she enjoys teasing and flustering the protagonist by seducing him playfully."},{"spoiler":false,"text":"With a straightforward personality, she dislikes pretense and always speaks her mind clearly."},{"spoiler":false,"text":"While she takes great pride in her femininity and meticulously maintains her appearance in public, she’s surprisingly laid-back and sloppy at home."},{"spoiler":false,"text":"“If I can make you jealous, that alone makes me really happy, Oniisan.”"}],"source":"vndb","sourceCharacterId":"c10401"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83f26a200aa7da653388b7f2a36956a1371d1a468d905cfe6776bad2e64fd420.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87a4cbe98ac1208c5912ca1f3711be5d37c795f22826d356864a5a2441db8b55.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33100","source":"vndb"}]},{"characterId":"char_vndb_c10402","characterName":"姫野 つぐみ","sourceIds":{"vndbCharacterId":"c10402"},"originalCharacterName":"姫野 つぐみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A junior one year younger than the protagonist, belonging to the home economics club at the academy, she’s a homely girl."},{"spoiler":false,"text":"Lacking athletic ability, she’s clumsy, prone to mistakes, and easily flustered with a tendency to blush."},{"spoiler":false,"text":"Despite her frequent failures, her earnest and unyielding nature makes her well-liked by those around her."},{"spoiler":false,"text":"At their part-time job, she’s technically the protagonist's senpai and tasked with guiding him, but often ends up being the one helped by him instead."},{"spoiler":false,"text":"“Next time, I’ll sneak a kiss and totally surprise you!”"},{"spoiler":true,"text":"In Dousei, Tsugumi is now a 3rd year student and Haruki is a university student. 2 years has passed."}],"source":"vndb","sourceCharacterId":"c10402"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89a797fe4fb34951d17dcc0e38adfcaf8bcfa9501e2c72811bdea823dc59778c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4814ed4a13ab183bb4c787ef47a37ba29befa60fe46e8c82854c46c41a118d54.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠野 そよぎ","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33096","source":"vndb"}]},{"characterId":"char_vndb_c10403","characterName":"三枝 奈々子","sourceIds":{"vndbCharacterId":"c10403"},"originalCharacterName":"三枝 奈々子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An older sister figure who works at the café where the protagonist is employed."},{"spoiler":false,"text":"A mood-maker who lightens the atmosphere with her perfect blend of humor and wit, she always takes the time to comfort the protagonist at the end of a tough, exhausting workday."},{"spoiler":false,"text":"Handling both the kitchen and the floor, she’s essentially the backbone that keeps the café running."},{"spoiler":false,"text":"“Huh!? Why me!? But… thank you…”"}],"source":"vndb","sourceCharacterId":"c10403"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bcc4ed602c4a4bcda4f8cf9292580e20de69e87bc5531ac6ee251c493eedbaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ea190d966189d9264f76b44df958e9c000723662be7c9e5b0f92a16c923f4a5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚木 かなめ","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33095","source":"vndb"}]},{"characterId":"char_vndb_c10404","characterName":"柳瀬 さつき","sourceIds":{"vndbCharacterId":"c10404"},"originalCharacterName":"柳瀬 さつき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A quiet girl who sits next to the protagonist in class."},{"spoiler":false,"text":"Her short responses like “Yeah” or “I guess” make her seem cold, but she means no harm."},{"spoiler":false,"text":"Though her expressions are subtle, she’s actually very curious, and her eyes light up when something catches her interest."},{"spoiler":false,"text":"Highly capable, she handles everything with ease."},{"spoiler":false,"text":"“Kisses should be once a day. But I’m fine with doing them a lot more.”"}],"source":"vndb","sourceCharacterId":"c10404"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08bfca0c04c245c6255af3b6b5509af8f439762a61f70b821d591989321b472d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0eb833665e0992e79c7808ca616cbed6835d4a08352f9fbf6d7e08cb77420