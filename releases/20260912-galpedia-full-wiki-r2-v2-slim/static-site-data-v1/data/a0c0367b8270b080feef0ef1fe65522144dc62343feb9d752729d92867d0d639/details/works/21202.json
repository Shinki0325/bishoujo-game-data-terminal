bp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122762:29896:4432:1","source":"bangumi"}]},{"characterId":"char_c29457","characterName":"サシィアーネ","sourceIds":{"bangumi":[{"characterId":"29897","match":"exact-normalized-name-in-linked-work","subjectId":"122762"}],"egsCharacterIds":["5604"],"vndbCharacterId":"c29457"},"originalCharacterName":"サシィアーネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young aristocratic who usually go to Gin's store to bother him. Although she usually bothers Gin, she feels very in love with him. She has vowed not lose to anyone."},{"spoiler":false,"text":"She is always accompanied by her butler Sevastius."}],"source":"vndb","sourceCharacterId":"c29457"},{"segments":[{"spoiler":false,"text":"実家の後継者問題から自身で商会を立ち上げた商人。"},{"spoiler":false,"text":"ギンの店の近くに商会を構えた事によりギンの店の流通に関わる事になる。"},{"spoiler":false,"text":"一見、普通のお嬢様だがギンに負けず劣らずのトラブルメーカー体質しかも周囲を巻き込む系なので、色々と困り困らせられる。"},{"spoiler":false,"text":"「なんだかんだあったけど、最終的に儲けが出ればＯＫ」"}],"source":"egs","sourceCharacterId":"5604","sourceWorkId":"21202","spoiler":false},{"segments":[{"spoiler":false,"text":"実家の後継者問題から、自身で商会を立ち上げた商人。"},{"spoiler":false,"text":"ギンの店の近くに商会を構えたことにより、お店の流通に関わることになる。"},{"spoiler":false,"text":"一見普通のお嬢様だが、ギンに負けず劣らずのトラブルメーカー体質。"},{"spoiler":false,"text":"しかも周囲を巻き込む系なので、ギンも色々と困り困らせられることに。"},{"spoiler":false,"text":"「なんだかんだあったけど、最終的に儲けが出れば OK」"}],"source":"bangumi","sourceCharacterId":"29897"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b59013526599d