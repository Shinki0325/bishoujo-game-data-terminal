identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The wife of the protagonist. Works as the shop's clerk and waitress. Because she is a demon, she does not mind sharing her husband with other women."},{"spoiler":false,"text":"The only man who can touch her is Gin; if a man dares to touch her she'll hit him with her incredible strength."}],"source":"vndb","sourceCharacterId":"c29452"},{"segments":[{"spoiler":false,"text":"魔族の娘。"},{"spoiler":false,"text":"実家を家出中にギンと遭遇、一戦（殴り合い）した後、意気投合。"},{"spoiler":false,"text":"ギンと共にお店の経営を行う事になった。"},{"spoiler":false,"text":"お店では事務担当兼ウェイトレス長。"},{"spoiler":false,"text":"価値観は人間とそう変わらないのだが恋愛感に関してだけはギンと大きく違い色々と揉める事になる。"},{"spoiler":false,"text":"「夫は側室を持って一人前。お父様のように四桁を持てとは言わないから、三桁……いえ、二桁で我慢するわ」"}],"source":"egs","sourceCharacterId":"5600","sourceWorkId":"21202","spoiler":false},{"segments":[{"spoiler":false,"text":"家出をしている魔族の娘。"},{"spoiler":false,"text":"偶然遭遇したギンと拳で一戦交え、意気投合。"},{"spoiler":false,"text":"店を立ち上げるというギンと共に、その経営を行うことになった。"},{"spoiler":false,"text":"魔族ではあるが、その価値観は人間とそう変わらない。"},{"spoiler":false,"text":"ただ恋愛観に関してだけは大きく違い、色々と揉めることになる。"},{"spoiler":false,"text":"「夫は側室を持って一人前。 お父様のように四桁を持てとは言わないから、三桁……いえ、二桁で我慢するわ」"}],"source":"bangumi","sourceCharacterId":"29892"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d8d600ff3289abdcdf84090a7b3a5c139d9cd3b414566a5c4f08ef2eb4497e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2777cfea13a21d68d3b1257a67fa40e46027ab998fc2a00b07ac0a1d95c0b0a3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-v