{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11515","model":{"presentationWorkId":"vndb:v3150","staff":{"artwork":[{"creditedName":"田丸まこと","creatorId":"vndb:s2324","sourcePersonId":"egs:creator:338","canonicalEntityId":"vndb:s2324","name":"田丸まこと","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71899","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c58923","characterName":"ジェニファ","sourceIds":{"bangumi":[{"characterId":"215607","match":"exact-normalized-name-in-linked-work","subjectId":"224353"}],"egsCharacterIds":["16312"],"vndbCharacterId":"c58923"},"originalCharacterName":"ジェニファ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「紅」の国の王妃。21歳。"},{"spoiler":false,"text":"元々は「金」の国の出身で、最近嫁いできたばかり。"},{"spoiler":false,"text":"武勇に優れ、並みの武将よりも腕が立つため、臆病な王に代わって、治安の維持に自ら務めることも珍しくない。そうしたことから男勝りと思われがちだが、容姿は薔薇のように美しく、気品に溢れ、淑やかな口調で話す。"},{"spoiler":false,"text":"世継ぎを産むため、一週間に一度は、夫である王とセックスしているものの、まだ子宝に恵まれていない。また王とのセックスは彼女自身がおざなりであるため、性に関してはまったく開発されていない。"}],"source":"egs","sourceCharacterId":"16312","sourceWorkId":"11515","spoiler":false},{"segments":[{"spoiler":false,"text":"金の国から嫁いできたばかりの王妃。"},{"spoiler":false,"text":"勇敢で武道に優れ女だてらに剣を振るい、並の武将よりも強いため、おっとりとした臆病な王に変わって治安維持のために出陣する。"},{"spoiler":false,"text":"しかし、口調はお淑やかで育ちの良さが見られる、美しさと強さの両方を持つ美女。"},{"spoiler":false,"text":"王である夫との間に子供はおらず、世継ぎを産むための週一回程度のセックスはおざなりである。"},{"spoiler":false,"text":"そのため性に関しては無垢で未開発。"}],"source":"bangumi","sourceCharacterId":"215607"}],"profileFacts":[{"label":"年龄（本版本）","value":"21 岁","valueContext":null,"source":"egs","sourceCharacterId":"16312","sourceWorkId":"11515","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"16312","sourceWorkId":"11515","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"16312","sourceWorkId":"11515","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"16312","sourceWorkId":"11515","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"16312","sourceWorkId":"11515","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a424182cd17a1ce30ae2778813b6a70a1b7022b4d1e1602546803ee7b37f52e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee27d3a28f4a9e1f99876d240e3838a94f241aae750761860c514a2605ef5d2c.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224353:215607:6036:1","source":"bangumi"}]},{"characterId":"char_c58924","characterName":"ファウラ","sourceIds":{"bangumi":[{"characterId":"215608","match":"exact-normalized-name-in-linked-work","subjectId":"224353"}],"egsCharacterIds":["16313"],"vndbCharacterId":"c58924"},"originalCharacterName":"ファウラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「紅」の国の親衛隊長。23歳。"},{"spoiler":false,"text":"王妃ジェニファが「紅」の国に嫁いできたその日に親衛隊長に任命される。"},{"spoiler":false,"text":"先祖代々、親衛隊の隊長に任命されてきた家柄に生まれ、そうしたことからも国王からの信頼も厚い。"},{"spoiler":false,"text":"彼女の代では、男性が生まれずに両親は苦悩したが、彼女は男性に負けない非凡な才能を見せ、さらには天才的な剣の使い手だったこともあり、女性ながら、また若くして親衛隊の隊長に選ばれる。"},{"spoiler":false,"text":"基本的に真面目で厳格。そのため性的な経験はなく、オナニーすらない。"}],"source":"egs","sourceCharacterId":"16313","sourceWorkId":"11515","spoiler":false},{"segments":[{"spoiler":false,"text":"王妃ジェニファが紅の国に嫁いできたその日から、親衛隊長に任命される。"},{"spoiler":false,"text":"力で押し切るというよりも、技と俊敏さで敵を倒す戦士。カミソリのように鋭い切っ先で、敵を切り刻む。"},{"spoiler":false,"text":"先祖代々、親衛隊長という家柄に生まれる。ファウラの代で、女性しか生まれず両親とも苦悩していたが、ファウラの驚くほどの剣の才能で親衛隊長に選ばれる天才的な戦士。"},{"spoiler":false,"text":"セックスどころかオナニーもした事がない。"}],"source":"bangumi","sourceCharacterId":"215608"}],"profileFacts":[{"label":"年龄（本版本）","value":"23 岁","valueContext":null,"source":"egs","sourceCharacterId":"16313","sourceWorkId":"11515","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"16313","sourceWorkId":"11515","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"16313","sourceWorkId":"11515","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"16313","sourceWorkId":"11515","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"16313","sourceWorkId":"11515","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal