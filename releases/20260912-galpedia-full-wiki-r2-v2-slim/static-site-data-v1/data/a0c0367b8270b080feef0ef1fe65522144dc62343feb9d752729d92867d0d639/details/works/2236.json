inalCharacterName":"篠原智裕","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chihiro just started working as a part-time waiter at Cafe Lindbergh after being recruited by Touno. He is an artist and the son of the owner of a food company, and has just returned to Japan from studying in the United States. Though the youngest he is very adult mentally, and fits into his job well because he always has a smile, is a gentle person, and likes to help others. Because of this he does not let others see his own troubles, unless he finds someone he feels he can open up to."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26157"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbd1e4b58af8e8c20ff2bfeaa3c8f414c8efc86ea5b3f2aa46a9fab62cbd0a35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f4cfc2dfe48f5c559d842e8d40d6b9937f2b3b6dc7f7866f64e6d7e2e092ab3.webp","width":130,"height":150,"source":"static-detail"},"actors":[{"creditedName":"マイケル 田中","creatorId":"vndb:s16174","sourcePersonId":"vndb:s16174","canonicalEntityId":"vndb:s16174","name":"加藤木 賢志","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18561","source":"vndb"}]},{"characterId":"char_vndb_c26158","characterName":"一ノ瀬 進哉","sourceIds":{"vndbCharacterId":"c26158"},"originalCharacterName":"一ノ瀬 進哉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shinya is a part-time waiter at Cafe Lindbergh. He had just graduated from university the previous spring and found employment with a company, but they shortly went out of business, leaving him unemployed and without a place to stay. He spent some time traveling on his motorcycle, and by chance ended up at Cafe Lindbergh, where he was offered a part-time job and a room in Itsuki's apartment. He is a very quiet and shy person who doesn't speak much, and is also very serious and single-minded."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26158"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39a3f28810b92233a1a75388db738383347ab17855717d8064135261d4d5886a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84c2830b4ecebec599f0512a8185bba406a28c86d5fc4432f5425b9e9ac543ff.webp","width":130,"height":150,"source":"static-detail"},"actors":[{"creditedName":"緑川 光","creatorId":"vndb:s73","sourcePersonId":"vndb:s73","canonicalEntityId":"vndb:s73","name":"緑川 光","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18555","source":"vndb"}]},{"characterId":"char_vndb_c26159","characterName":"三原 拓実","sourceIds":{"vndbCharacterId":"c26159"},"originalCharacterName":"三原 拓実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takumi is the cook for Cafe Lindbergh. Because he had an interest in cake making, after high school he went into a special culinary arts school where he studied to become a patissier. After this he worked in a workshop producing pastries that are distributed to a number of restaurants, but left to take the job as the chef of Cafe Lindbergh. He has a powerful personality and expresses his feelings straight. He has an older-brother disposition to take care of others."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26159"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2153e0cfe56501201e79061edcec62fa38fc759a8676d2fd3facff0520a4cbb0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/997549ab82cd37525af145f2109f265958a077d866f28765b1b8f00549105fd3.webp","width":130,"height":150,"source":"static-detail"},"actors":[{"creditedName":"請一郎","creatorId":"vndb:s89","sourcePersonId":"vndb:s89","canonicalEntityId":"vndb:s89","name":"伊藤健太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18558","source":"vndb"}]},{"characterId":"char_vndb_c26160","characterName":"高見沢司","sourceIds":{"vndbCharacterId":"c26160"},"originalCharacterName":"高見沢司","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"32"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukasa is a full-time waiter at Cafe Lindbergh. He is exceptional at serving customers and acts as Itsuki's right-hand man with running the shop. He has a calm personality and appearance, always wearing a reserved smile. He is a strong person within, though he is not very strong with self-assertiveness and distances himself from others because he has trouble becoming emotionally close. He is also basically a lacto-vegetarian for mental reasons (though he doesn't like to, he will still eat fish)."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26160"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e46d9affe17adce31420b7fcc20c890d027e8e835ce4b95e506cf2e12434df6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/774ee974cbdd1a95948f1ace4f99c10fa527eab8176ae5fc25564cc265e8519b.webp","width":130,"height":150,"source":"static-detail"},"actors":[{"creditedName":"プログレス","creatorId":"vndb:s400","sourcePersonId":"vndb:s400","canonicalEntityId":"vndb:s400","name":"千葉進歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18557","source":"vndb"}]},{"characterId":"char_vndb_c26161","characterName":"桐野逸樹","sourceIds":{"vndbCharacterId":"c26161"},"originalCharacterName":"桐野逸樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"43"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itsuki is the manager (referred to as the \"Master\") of Cafe Lindbergh. He is long-term friends with Ryuuji Watanabe, the owner, and was asked by him to manage the shop. He always wears a faint smile, never allowing the true feelings beneath his skin to be seen. He always speaks with honorifics and in a calm, curteous manner, no matter how much younger the person he is speaking to may be."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26161"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5a5798754b4538e976d64104653389749485d9d8f54f6808e55f3a13cd22033.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22a7f9bf87e13a0d64f4ad835cc1ccccfcd874d3e3ab386c0a946e796be9e31b.webp","width":130,"height":150,"source":"static-detail"},"actors":[{"creditedName":"一条 和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18556","source":"vndb"}]},{"characterId":"char_vndb_c26162","characterName":"渡辺隆之","sourceIds":{"vndbCharacterId":"c26162"},"originalCharacterName":"渡辺隆之","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"45"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryuuji is the owner of Cafe Lindbergh. He is the second-generation leader of the Watanabe Group which runs a chain of Italian bistros. He has been friends with Itsuki since school days and having high trust in Itsuki's abilities and thinking of him as a personal advisor, he asked him to manage Cafe Lindbergh. He occassionally stops by to check on the shop."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26162"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27c27cdfc8612c2b09163ebb7c64d1805c19cf0091f2cbb1545ff22ad853428e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8b0e71111a0dbf3cb4b8c46a2360297d9f43010d31740dd15d555a4df0f68a9.webp","width":130,"height":150,"source":"static-detail"},"actors":[{"creditedName":"増谷 康紀","creatorId":"vndb:s2112","sourcePersonId":"vndb:s2112","canonicalEntityId":"vndb:s2112","name":"増谷 康紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18560","source":"vndb"}]},{"characterId":"char_vndb_c26163","characterName":"少年A","sourceIds":{"vndbCharacterId":"c26163"},"originalCharacterName":"少年A","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shounen A is thought to be about 20 years old (though no one knows for certain), and is a frequent customer of Cafe Lindbergh, so much so that he is considered their shop \"mascot\" and has a special reserved table where he reads and writes. Even though he is familiar with the staff, he has never told them his name, using instead the psuedonym \"Shounen A\" for unknown reasons."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"},{"spoiler":true,"text":"Real name: Shimazaki Haruna (島崎榛名)."}],"source":"vndb","sourceCharacterId":"c26163"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/331d83e6896112861f175343a665035c7f041e11f16fa2f16e89b2aaffa025cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f8805a2244a329fd124186e0f580c30c6c3173986160a7daa420d38aa1eef3e.webp","width":130,"height":150,"source":"static-detail"},"actors":[{"creditedName":"眞嶋 リョウ","creatorId":"vndb:s1699","sourcePersonId":"vndb:s1699","canonicalEntityId":"vndb:s1699","name":"眞嶋 リョウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18559","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p748","sourceCompanyId":"egs:brand:564","canonicalEntityId":"vndb:p748","name":"アイン","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:2236:564","source":"egs"},{"companyId":"vndb:p22","sourceCompanyId":"vndb:p22","canonicalEntityId":"vndb:p22","name