le":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man from the barely-populated Fresh Fish Island, he was raised by a pair of beautiful twins named Kinou and Kyou . Seeking to have sex with both of the sisters by becoming a Knight, he decides to go on a journey. His primary goal, and one that the sisters encourage, is to become a great enough man to marry lots of women."},{"spoiler":true,"text":"He is the prince of Kingdom of Arthur, and is a half-dragon. His father Tram was a human, while his mother Ruto was a dragon and a member of the Witch of the Round Table."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c32069"},{"segments":[{"spoiler":false,"text":"魚鮮島という過疎の島で双子の美人姉妹に育てられた青年。"},{"spoiler":false,"text":"双子の姉妹とエッチするために騎士となるべく旅に出る。"},{"spoiler":false,"text":"双子姉妹の後押しも有り、お嫁さんをたくさんもらえる立派な男になるのが当面の目的である。"}],"source":"egs","sourceCharacterId":"6004","sourceWorkId":"21531","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法剑士，在人烟稀少的小岛上长大，对异性有超出常人的兴趣。"}],"source":"bangumi","sourceCharacterId":"68789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b12e4f47116cff3f6742fc311a584dc8290c5013cec9caf507de0d6f0be0463.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2452d697d5a53e53c4e814940fda6412cf2d08e3b53e4212837830b48954534.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c80489","characterName":"ラミアス","sourceIds":{"bangumi":[],"egsCharacterIds":["6006"],"vndbCharacterId":"c80489"},"originalCharacterName":"ラミアス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb",