":false},{"segments":[{"spoiler":false,"text":"実家の裏の家の、一人娘。"},{"spoiler":false,"text":"小さい頃から姉妹や主人公と一緒に育ち、主人公を兄と慕っていた。"},{"spoiler":false,"text":"夕希と同じ女子学園に通い仲が良く、二人の時は夕希をお姉ちゃんと呼んでいる。"},{"spoiler":false,"text":"一般的な身長なので、主人公にとっては癒しとなる存在…… だったのだが、幼い頃から男性は兄一筋でそのまま育ってしまったらしく、妄想と思い込みが激しいことが後に分かる。"},{"spoiler":false,"text":"ストラップは手作りの主人公人形で、自分の部屋には自作の主人公グッズがあふれている。"},{"spoiler":false,"text":"「昔みたいに、お兄ちゃん、って呼んでいい……ですか？」"}],"source":"bangumi","sourceCharacterId":"45662"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"142","sourceWorkId":"16529","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"142","sourceWorkId":"16529","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"142","sourceWorkId":"16529","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"cupSize":[{"comparisonValue":"c","source":"vndb","sourceCharacterId":"c26056","value":"C"},{"comparisonValue":"c","scope":"sourceWork","source":"egs","sourceCharacterId":"142","sourceWorkId":"16529","value":"C"},{"comparisonValue":"83cm(cカップ)","source":"bangumi","sourceCharacterId":"45662","value":"83cm（Cカップ）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79daea81990c1b43ac4c741cbdef2c83a2eef8ec60d479ad27ffe46295868562.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/1185de97232a94c771b7282d33e40cbb52feed21012ccbb9f70093f35f6bb923.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:90786:45662:5939:1","source":"bangumi"}]},{"characterId":"char_vndb_c26053","characterName