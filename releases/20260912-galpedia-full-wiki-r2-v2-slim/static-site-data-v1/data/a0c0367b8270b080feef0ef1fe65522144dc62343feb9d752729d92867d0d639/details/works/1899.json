e","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student in the violin department at Shukusei Music Academy. A girl with Peter Pan syndrome who loves stuffed toys and sweets. Perhaps due to her overprotective upbringing, she is a very demanding and a very spoiled young lady. She"},{"spoiler":false,"text":"is still afraid to go to the bathroom alone at night. A timid girl who cries easily for any reason."},{"spoiler":false,"text":"Translated from the the game's website, archived"}],"source":"vndb","sourceCharacterId":"c52994"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/470aa02c70b2e99ed09ad9d4c316bd9a07936e1979d91aeec7800228b5cc0009.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ae0a08ad18203726bd6b5d53c239b82f33293dc4eb6a7ce6cb11882c348395c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"馬場 澄江","creatorId":"vndb:s12739","sourcePersonId":"vndb:s12739","canonicalEntityId":"vndb:s12739","name":"馬場 澄江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10247","source":"vndb"}]},{"characterId":"char_vndb_c52995","characterName":"高部 絵里","sourceIds":{"vndbCharacterId":"c52995"},"originalCharacterName":"高部 絵里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a first-year student in the violin department of Shukusei Music Academy. Her grandfather was the founder of a major department store, and her father is the chairman of the Takabe Group. She is a rich lady among rich ladies, but she is by no means a naive girl."},{"spoiler":false,"text":"She doesn't like being thought of as a rich lady by others, and she always wanted to be an ordinary girl. She is a talented girl with a strong sense of justice, who is both kind and strict. Her intuition is outstanding."},{"spoiler":false,"text":"Translated from the the game's website, archived"}],"source":"vndb","sourceCharacterId":"c52995"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d8ca58eefa14542e329b9f3ec53b4a7d32a1d203f645a539f5c0359c5ca465c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4753dda9b8c4d0a725848102624fadd013f736b9ec8aba01864d4140a121e636.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原 えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10241","source":"vndb"},{"creditedName":"永野 愛","creatorId":"vndb:s4984","sourcePersonId":"vndb:s4984","canonicalEntityId":"vndb:s4984","name":"永野愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10244","source":"vndb"}]},{"characterId":"char_vndb_c52996","characterName":"栗原 朝美","sourceIds":{"vndbCharacterId":"c52996"},"originalCharacterName":"栗原 朝美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a second-year student in the violin department of Shukusei Music Academy. Her father is the director of a large municipal hospital."},{"spoiler":false,"text":"She is assertive and has a manly tone of voice. She calls Shuusaku \"old man.\" Perhaps because she has a big sister personality, she teases Chiaki but is also concerned about her."},{"spoiler":false,"text":"She has outstanding proportions among the dorm residents and has a model-like figure."},{"spoiler":false,"text":"Translated from the the game's website, archived"}],"source":"vndb","sourceCharacterId":"c52996"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85f090002bdbb348de702dd1ae91d146adccb906505d5b63d4e7b0c966ce8ac0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1f5d6b4db391172e5434492706f82b24665e92e3748cd757cc4a9230a631791.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松下 美由紀","creatorId":"vndb:s9079","sourcePersonId":"vndb:s9079","canonicalEntityId":"vndb:s9079","name":"松下 美由紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10246","source":"vndb"}]},{"characterId":"char_vndb_c52997","characterName":"藤間 萌子","sourceIds":{"vndbCharacterId":"c52997"},"originalCharacterName":"藤間 萌子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second-year piano student at the Shukusei Music Academy. Her father is a former real estate agent who made his fortune during the bubble era. Shukusei Music Academy is a school that places importance on bloodlines, but Moeko is enrolled because of her good looks and financial resources."},{"spoiler":false,"text":"Because of her father's huge annual donations to the academy, Moeko is unable to quit the boring academy. She often return to the dormitory after curfew because she was playing with her boyfriend."},{"spoiler":false,"text":"She calls Shuusaku ‘Ojii~san’ in an offhanded way."},{"spoiler":false,"text":"Translated from the game's website, archived"}],"source":"vndb","sourceCharacterId":"c52997"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9950d10314796631e4db5b4efa48fad9a54dc373ed345eb8242d01c32b2b7ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e40c4570125e1357102ef83b44db4cf4d1ce36918741dfc5c0c5dc4b90a4913.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"香川 葉月","creatorId":"vndb:s19172","sourcePersonId":"vndb:s19172","canonicalEntityId":"vndb:s19172","name":"香川 葉月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10249","source":"vndb"}]},{"characterId":"char_vndb_c52998","characterName":"水無月 志保","sourceIds":{"vndbCharacterId":"c52998"},"originalCharacterName":"水無月 志保","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student in the Japanese Music Department at Shukusei Music Academy. Her father is a famous potter and her mother is the head of the Minazuki school of tea ceremony, so she is a young lady born into a purely Japanese family. She"},{"spoiler":false,"text":"has a quiet and reserved personality. She always tries to keep herself one step behind others. She likes to wear clean clothes."},{"spoiler":false,"text":"Translated from the the game's website, archived"}],"source":"vndb","sourceCharacterId":"c52998"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7579365543156c714a76cf62007abc46bf5bd32bbaf33e9a4a4a12d283181c17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e065f0e393f6cf3d8663fdca8a2aca0a9e0765f159d4317218a3a9fc7bc25c7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅田 葉子","creatorId":"vndb:s2162","sourcePersonId":"vndb:s2162","canonicalEntityId":"vndb:s2162","name":"浅田 葉子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10243","source":"vndb"}]},{"characterId":"char_vndb_c52999","characterName":"前島 香織","sourceIds":{"vndbCharacterId":"c52999"},"originalCharacterName":"前島 香織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a third-year student at Shukusei Music Academy, and like Nagisa, is a student in the piano department."},{"spoiler":false,"text":"She is also the granddaughter of the chairman of Shukusei Music Academy, and despite her young age, she loves \"money and power\" and always asserts that she is the chairman's granddaughter."},{"spoiler":false,"text":"She has a very harsh personality and a haughty attitude, and sometimes calls Shusaku \"Katou.\""},{"spoiler":false,"text":"She is a proud young lady type. She is quite beautiful and likes to dress in mature clothes."},{"spoiler":false,"text":"For some reason, she dislikes teacher Minami Ayaka."},{"spoiler":false,"text":"Translated the game's website, archived"}],"source":"vndb","sourceCharacterId":"c52999"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb75e227d0202d890edfa9f42bf4cef54ce8aad4ce057a8d4904f2bcf2f369e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/837dc97fe0b30a3fe565d0f3409295f2a8acd297f2639bd6442eaf4666161ad9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"百々 麻子","creatorId":"vndb:s1023","sourcePersonId":"vndb:s1023","canonicalEntityId":"vndb:s1023","name":"百々 麻子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10242","source":"vndb"}]},{"characterId":"char_vndb_c53000","characterName":"近藤 渚","sourceIds":{"vndbCharacterId":"c53000"},"originalCharacterName":"近藤 渚","characterNameSource":null,"role":"primary","status":"source-only-candidate","i