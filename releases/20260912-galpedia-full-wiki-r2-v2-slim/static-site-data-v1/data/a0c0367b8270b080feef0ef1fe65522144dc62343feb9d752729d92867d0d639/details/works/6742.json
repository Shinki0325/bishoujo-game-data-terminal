iler":false,"text":"しかし、旦那が事業に失敗したことから一念発起し、旦那と家庭を守るためにアルバイトを始めるが……。"}],"source":"egs","sourceCharacterId":"26021","sourceWorkId":"6742","spoiler":false},{"segments":[{"spoiler":false,"text":"女子校育ちでそのまま見合い結婚という世間知らずの若妻。"},{"spoiler":false,"text":"最近事業に失敗した夫を助けようとアルバイトを計画。"},{"spoiler":false,"text":"夫に対して愛情はあるが、あくまで夫婦は互いに"},{"spoiler":false,"text":"愛し合うべきだという固定観念からくる想いとは気付いていない。"},{"spoiler":false,"text":"知っている男性は夫だけだったのだが・・・"}],"source":"bangumi","sourceCharacterId":"42665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34d0267e2e81f3d1f8fae6460b335f3f3c2adc1a2f9255b61e87d4b710337690.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46ce100bdb3598ee75c10426d5ec3384b0f60ff3bb7e92b2ca18efec63588a6e.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185376:42665:4727:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p392","sourceCompanyId":"egs:brand:1513","canonicalEntityId":"vndb:p392","name":"アンダーリップ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6742:1513","source":"egs"},{"companyId":"vndb:p392","sourceCompanyId":"vndb:p392","canonicalEntityId":"vndb:p392","name":"アンダーリップ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:19827:v8261","source":"vndb"},{"companyId":"vndb:p392","sourceCompanyId":"vndb:p392","canonicalEntityId":"vndb:p392","name":"アンダーリップ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:19828:v8261","source":"vndb"},{"companyId":"vndb:p392","sourceCompanyId":"vndb:p392","canonicalEntityId":"vnd