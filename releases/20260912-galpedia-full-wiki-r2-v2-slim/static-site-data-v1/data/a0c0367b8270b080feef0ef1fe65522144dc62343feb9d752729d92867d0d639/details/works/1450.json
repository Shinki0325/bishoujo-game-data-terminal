nts":[{"spoiler":false,"text":"Haruka was born with a weak body, and has to stay in the hospital regularly because of this. He is a bright and intelligent boy, and enjoys reading lots of books, mainly because he has nothing else to do in all his time spent in a sickroom. He yearns to know more about the outside world, feeling stuck behind the white hospital walls. He's from a rich family, but his parents never have the time to visit him, instead sending him gifts, but he longs to have someone around to talk to, and Reiji fills in this role."}],"source":"vndb","sourceCharacterId":"c80378"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89a31e610f378284bdb5eae3c74ff68467810ac416d3e699d5ad59c050c6db56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d48534c981afb378ff7f78ec5870e25c287e706213b43dc8cd2469732149477.webp","width":92,"height":117,"source":"static-detail"},"actors":[{"creditedName":"小倉 結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24007","source":"vndb"}]},{"characterId":"char_vndb_c80379","characterName":"瀬田 薫","sourceIds":{"vndbCharacterId":"c80379"},"originalCharacterName":"瀬田 薫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaoru is a mysterious boy who appears at night in Reiji's room, mistaking him for someone called \"Junichiro,\" and asking him to visit him in the old abandoned C Ward of the hospital. Nobody knows much about him, or why he is there."}],"source":"vndb","sourceCharacterId":"c80379"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a7f560ed3d8012aad859610b5a402c0a175a748539abb41787df371c779d0d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2c07d33de08cf8b27d46dfe895e9470ced18ca210369b07e12a7267f12668a5.webp","width":92,"height":117,"source":"static-detail"},"actors":[{"creditedName":"波多野 和俊","creatorId":"vndb:s6865","sourcePersonId":"vndb:s6865","canonicalEntityId":"vndb:s6865","name":"波多野 和俊","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24009","source":"vndb"}]},{"characterId":"char_vndb_c80380","characterName":"三井 拓也","sourceIds":{"vndbCharacterId":"c80380"},"originalCharacterName":"三井 拓也","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Dr. Mitsui is the head of the pediactrics division at the hospital. He is an elite doctor whom grandfather is a chairman on the Board of Directors for the hospital. Although he has many women admirers due to his appearance and status, he treats them very coldly; he seems to have more of a liking for the young boys he sees in the hospital ward."}],"source":"vndb","sourceCharacterId":"c80380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/629b4e06373392b116a4996b1e469cf03688d46a06435fc3f934e584678ccb6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/519c9e7d9ba77a2a384fbbd3d39d668b5791674a10b0ee528ccbeb9eeb79720d.webp","width":92,"height":117,"source":"static-detail"},"actors":[{"creditedName":"緑川 光","