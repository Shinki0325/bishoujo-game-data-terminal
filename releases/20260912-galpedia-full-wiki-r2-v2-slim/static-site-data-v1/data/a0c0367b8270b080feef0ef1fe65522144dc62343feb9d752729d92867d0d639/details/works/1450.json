tityId":"vndb:s10851","name":"水城 ありさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24011","source":"vndb"}]},{"characterId":"char_vndb_c80376","characterName":"粟津 晶","sourceIds":{"vndbCharacterId":"c80376"},"originalCharacterName":"粟津 晶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akira is a very serious, courteous boy, who has a strong sense of obligation. He is the student chairman and also manages the drama club of his school, writing the script for the school play for the cultural festival. He visits his mother in the hospital's mental ward often, where she is staying from going mad over the death of Akira's father. He has a strong sense of responsibility, since he takes care of his younger siblings due to the absense of their parents."}],"source":"vndb","sourceCharacterId":"c80376"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d757efc38ac038bae17c9499d6df738b1801fda6f82aaa417955cb3838a4c8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be84382f81b2b4e57287d583e6b45ec777988ae275cbcb5fb79e17a06b03b78f.webp","width":92,"height":117,"source":"static-detail"},"actors":[{"creditedName":"児玉 さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24006","source":"vndb"}]},{"characterId":"char_vndb_c80377","characterName":"唐崎 啓介","sourceIds":{"vndbCharacterId":"c80377"},"originalCha