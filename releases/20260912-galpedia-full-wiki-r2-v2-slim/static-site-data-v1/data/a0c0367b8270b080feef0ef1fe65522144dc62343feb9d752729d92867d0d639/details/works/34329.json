ative","relationId":"vndb:vn-staff:102940","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c21634","characterName":"姉崎 希美","sourceIds":{"vndbCharacterId":"c21634"},"originalCharacterName":"姉崎 希美","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Being the idol of the school and vice president of the student council, Nozomi uses a lot of time and effort to appear as admirable and likable to other people. She is very particular about the way she wants herself seen by others. Nozomi is straightforward and able to stand up to herself and to others when needed, without being needlessly cold either."},{"spoiler":false,"text":"From Maiden Kingdom"}],"source":"vndb","sourceCharacterId":"c21634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/355fd072e26a9700cab56e6813067d4f3652e7a079edd29ba6636e3b76024aea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00d8893c4368378a5f2093f087ef47071eb934cd40c835141988482bfef3353e.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c21635","characterName":"姉崎 隼","sourceIds":{"vndbCharacterId":"c21635"},"originalCharacterName":"姉崎 隼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nozomi’s stepbrother who’s a first-year and the only one who knows her real personality. He’s aiming to become a beautician in the future and because of this he also repeatedly gets pestered by Nozomi to reassure she looks fine every time she leaves the house. Their parents, like all proper game/anime parents, are traveling abroad, leaving them bickering alone in the house."},{"spoiler":false,"text":"From Maiden Kingdrom"}],"source":"vndb","sourceCharacterId":"c21635"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/483ca22e0889bdf64ae8e8a5668875b7481c5eb814b98918c0abd81541db323a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/802e41f984f0d2fb81b00462097c44fcc694ac42bf911388fa26d5a518fda2a9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大黒 雄斗","creatorId":"vndb:s26570","sourcePersonId":"vndb:s26570","canonicalEntityId":"vndb:s26570","name":"大黒 雄斗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55023","source":"vndb"}]},{"characterId":"char_vndb_c21636","characterName":"倉口 歩","sourceIds":{"vndbCharacterId":"c21636"},"originalCharacterName":"倉口 歩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"723"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nozomi’s only friend from middle school, who suddenly transfers to her class. An otaku who’s particularly fond of all kinds light novels and noticeably distanced from others in the class because of his hobby. He doesn’t approach her in public, since he’s afraid that would result in her being treated by their classmates the same way he is."},{"spoiler":false,"text":"From Maiden Kingdom"}],"source":"vndb","sourceCharacterId":"c21636"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9aba30773e9fbba1cdc2638381f