tative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"827"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuu's cousin and Touka's elder sister. Yuu was always looking up to her, so he was very happy when she adopted him after he lost his parents."},{"spoiler":false,"text":"Mizuha also works as a teacher at the school characters attend (出水城学園), where she's very popular (especially among boys)."},{"spoiler":false,"text":"On the other hand, her housekeeping skills are nothing but a disaster. Whenever she tries to cook, it ends up in lots of smoke, and when she tried to clean the bathroom, allegedly the bathtub had exploded."},{"spoiler":false,"text":"She wields deadly 48 variations of dekopin (poke in the forehead), and uses this killer technique to solve most of family disputes and problems."},{"spoiler":false,"text":"Her hobby is teasing Yuu with seductive attempts, which causes him lots of headaches recently."},{"spoiler":false,"text":"adapted from character introduction in manual"}],"source":"vndb","sourceCharacterId":"c33479"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa3022d5e0e9a68037c0b7e1def1107f7f29e0c63add7b18a50c438a6c2b0ce9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4f2f9b0683b489786697db313d20d5767f02c0d21757f3303aaf05ee9cc3a74.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大波 こなみ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7782","source":"vndb"}]},{"characterId":"char_vndb_c33481","characterName":"南野 七海","sourceIds":{"vndbCharacterId":"c33481"},"originalCharacterName":"南野 七海","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ojousama who suddenly moved into house next to the protagonist's. She's one year younger."},{"spoiler":false,"text":"She came back from America, and she calls Yuu her \"oniichan\", claiming that she knows him from childhood, but he doesn't remember anything."},{"spoiler":false,"text":"She acts very bright around Yuu, waving her blonde twin-tails and emitting love beams, playing a role of the cute little sister-like character, but whenever any other girl gets close to Yuu, she gets very hostile, and transforms into a ferocious monster."},{"spoiler":false,"text":"She has a speech quirk of making \"Kyuun!\" sound effect whenever she's worried or embarrased."},{"spoiler":false,"text":"By the way Modern and Classical Japanese are her bane at school."},{"spoiler":false,"text":"adapted from character introduction in manual"}],"source":"vndb","sourceCharacterId":"c33481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6eaa0e3b2b7ba94552855c02bc8301283f63a4eb67904b94ed79423d28ee623a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10e55243c2575c96c9a3bad03772eb035561544f81fbe2417d4e64f731ba2f52.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7780","source":"vndb"}]},{"characterId":"char_vndb_c33482","characterName":"桜井 真奈","sourceIds":{"vndbCharacterId":"c33482"},"originalCharacterName":"桜井 真奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1018"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuu's classmate - they get along since middle school."},{"spoiler":false,"text":"Being unusually gifted, she keeps getting top scores from all exams."},{"spoiler":false,"text":"She seems to be unfit for this school, often crossing the borders, which gives lots of headaches to the teachers, making her kind of \"problem child\" despite her stellar grades. When asked why she chose this school, she replied \"Because it was close\"."},{"spoiler":false,"text":"She often speaks like a man, which makes her seem rather unapproachable, but for some reasons she gets along with Yuu very smoothly."},{"spoiler":false,"text":"And thus, being class president, she kind of dragged him into role of vicepresident, much to his dismay."},{"spoiler":false,"text":"adapted from character introduction in manual"}],"source":"vndb","sourceCharacterId":"c33482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44301592a7c8f346d4efec0bced74c9f5fd395d8e270221b465a6b51222b6ed3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fd4a8ac3c39917d74c8a2afdc33e68d9598591eba24f32da255e7c8af9061cc.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"韮井 叶","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7796","source":"vndb"}]},{"characterId":"char_vndb_c33483","characterName":"立原 一音","sourceIds":{"vndbCharacterId":"c33483"},"originalCharacterName":"立原 一音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Science teacher, as well as homeroom teacher for Yuu, Touka and Mana."},{"spoiler":false,"text":"Since she just started her work as a techer, she still very much resembles a student."},{"spoiler":false,"text":"That's why many students affectionately call her \"Kazune-chan\", although for Yuu, who as a class vice-president has often to cover up for her and deal with her immaturity, she's just a source of headaches."},{"spoiler":false,"text":"Her family runs a Shinto shrine, so by all means she should become a miko, but she chose teaching instead, and burns with passion for it."},{"spoiler":false,"text":"adapted from character introduction in manual"}],"source":"vndb","sourceCharacterId":"c33483"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-as