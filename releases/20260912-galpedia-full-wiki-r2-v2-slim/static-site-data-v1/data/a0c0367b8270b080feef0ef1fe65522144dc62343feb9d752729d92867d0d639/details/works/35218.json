","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:200389","source":"vndb"}]},"cast":[{"characterId":"char_c133995","characterName":"マロンカ","sourceIds":{"bangumi":[{"characterId":"142653","match":"exact-normalized-name-in-linked-work","subjectId":"464524"}],"egsCharacterIds":["24985"],"vndbCharacterId":"c133995"},"originalCharacterName":"マロンカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"塔の不法居住者『流民』のリーダーを務める女性。"},{"spoiler":false,"text":"塔の軌条を走るカラコル号という特殊車両の運転を引き受けてくれる、カイル達にとっては欠かせないバックアップ役。"},{"spoiler":false,"text":"その医療技術と竜奴に関する知識が、彼女がタダ者でないことを示している。周囲にはマロンカ先生と呼ばせており、姐さんと呼ぶと怒る。"}],"source":"egs","sourceCharacterId":"24985","sourceWorkId":"35218","spoiler":false},{"segments":[{"spoiler":false,"text":"塔の不法居住者『流民』のリーダーを務める女性。"},{"spoiler":false,"text":"塔の軌条を走るカラコル号という特殊車両の運転を引き受けてくれる、カイル達にとっては欠かせないバックアップ役。"},{"spoiler":false,"text":"その医療技術と竜奴に関する知識が、彼女がタダ者でないことを示している。"},{"spoiler":false,"text":"周囲にはマロンカ先生と呼ばせており、姐さんと呼ぶと怒る。"}],"source":"bangumi","sourceCharacterId":"142653"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b77bdb6ccc775b703474104d450c7a15e7c93a26182e920477a3b0ddce8b87f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e05425e6b1d0d954e3b4f916f3ce4c52b9c00d77b3a7e6fd5d97002eee82ddbf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:464524:142653:4490:1","source":"bangumi"}]},{"characterId":"char_c156707","characterName":"カイル","sourceIds":{"bangumi":[{"characterId":"205741","match":"exact-normalized-name-in-linked-work","subjectId":"464524"}],"egsCharacterIds":["24973"],"vndbCharacterId":"c156707"},"originalCharacterName":"カイル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"代々塔の技師をしてきた地上人の血筋。幼い頃、住んでいた街を皇国の真竜に焼かれ、理不尽にも負けない力と、何者にも侵せない自由を求めるようになる。"},{"spoiler":false,"text":"過酷な生い立ちから精神的に成熟している。ぶっきらぼうに見えて根は優しく、女の子に対しても包容力があり面倒見がいい。"},{"spoiler":false,"text":"伝説の叛竜の力を継ぎ、塔に挑む戦いを通じて、世界の秘密に触れ成長していく。"}],"source":"egs","sourceCharacterId":"24973","sourceWorkId":"35218","spoiler":false},{"segments":[{"spoiler":false,"text":"自然界や生物が蓄えるマナをエネルギーに変換、出力する装置。旧文明の遺産で、カイルは発掘したものを独自に修復して使っている。戦闘時、射出口のアタッチメントによりブレード・モードとガン・モードを切り換えることができる。拡張性に優れ、マナの属性や用途、出力などの調整も自在だが、その分、使用者への負担が大きい。"}],"source":"bangumi","sourceCharacterId":"205741"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/631879c3001fb74c5e1a59883ad6ffb3e889cf53741dbe25011c7d3b5c3a609c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cf436b90e33267f092e6d780de3e533836a4bee48f9ac4314147c978c71727e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷井 ムロ","creatorId":"vndb:s50217","sourcePersonId":"vndb:s50217","canonicalEntityId":"vndb:s50217","name":"谷井ムロ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96207","source":"vndb"}]},{"characterId":"char_c156708","characterName":"リム","sourceIds":{"bangumi":[{"characterId":"142646","match":"exact-normalized-name-in-linked-work","subjectId":"464524"}],"egsCharacterIds":["24974"],"vndbCharacterId":"c156708"},"originalCharacterName":"リム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"災厄の竜の因子と掛け合わせて生み出された人間兵器『竜奴』の少女。特殊なΩ（オメガ）コードのレガリア（刻印）を刻まれている。感情が欠落した戦闘マシーンだったが、叛逆の竜リベリオと接触したことで人間性を獲得する。"},{"spoiler":false,"text":"目覚めたばかりの感情は無邪気で純粋。色々なことに興味を持ち、まるで兄妹のようにカイルに懐いている。"},{"spoiler":false,"text":"リベリオに見せられた緑に満ちた大地は、彼女の魂の原風景であり、そのために戦う。"}],"source":"egs","sourceCharacterId":"24974","sourceWorkId":"35218","spoiler":false},{"segments":[{"spoiler":false,"text":"災厄の竜の因子と掛け合わせて生み出された人間兵器『竜奴』の少女。"},{"spoiler":false,"text":"特殊なΩ（オメガ）コードのレガリア（刻印）を刻まれている。"},{"spoiler":false,"text":"感情が欠落した戦闘マシーンだったが、叛逆の竜リベリオと接触したことで人間性を獲得する。"},{"spoiler":false,"text":"目覚めたばかりの感情は無邪気で純粋。"},{"spoiler":false,"text":"色々なことに興味を持ち、まるで兄妹のようにカイルに懐いている。"},{"spoiler":false,"text":"リベリオに見せられた緑に満ちた大地は、彼女の魂の原風景であり、そのために戦う。"}],"source":"bangumi","sourceCharacterId":"142646"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c0d2b3b6c9d124342c23310c73485e788d0244c961d8717a2dc177b9bf62d0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90ff3f8a993d4b4bd6bf0c1b19da471312abf85a1b55fe98be14e6ea69c0ebba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"空賀花","creatorId":"vndb:s15476","sourcePersonId":"vndb:s15476","canonicalEntityId":"vndb:s15476","name":"空賀 花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:464524:142646:34089:1","source":"bangumi"}]},{"characterId":"char_c156709","characterName":"オタク姫","sourceIds":{"bangumi":[{"characterId":"142647","match":"exact-normalized-name-in-linked-work","subjectId":"464524"}],"egsCharacterIds":["24975"],"vndbCharacterId":"c156709"},"originalCharacterName":"オタク姫","characterNameSource":null,"role":"primary","status":"source-only-