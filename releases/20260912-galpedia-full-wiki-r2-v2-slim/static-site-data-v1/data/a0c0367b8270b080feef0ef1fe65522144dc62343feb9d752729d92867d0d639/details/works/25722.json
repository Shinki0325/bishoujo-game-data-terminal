{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25722","model":{"presentationWorkId":"vndb:v21726","staff":{"artwork":[{"creditedName":"空中幼彩","creatorId":"vndb:s3327","sourcePersonId":"egs:creator:1414","canonicalEntityId":"vndb:s3327","name":"空中幼彩","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:190727","source":"egs"}],"scenario":[{"creditedName":"まるさん","creatorId":"vndb:s7728","sourcePersonId":"egs:creator:14543","canonicalEntityId":"vndb:s7728","name":"まるさん","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:190728","source":"egs"}],"music":[],"other":[{"creditedName":"SION","creatorId":"vndb:s4166","sourcePersonId":"egs:creator:17975","canonicalEntityId":"vndb:s4166","name":"SION","detail":"主題歌「眠れる森の棘姫」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:190729","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142964","source":"vndb"},{"creditedName":"SION","creatorId":"vndb:s4166","sourcePersonId":"vndb:s4166","canonicalEntityId":"vndb:s4166","name":"SION","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:142966","source":"vndb"}]},"cast":[{"characterId":"char_c132081","characterName":"延母 武也","sourceIds":{"bangumi":[],"egsCharacterIds":["18020"],"vndbCharacterId":"c132081"},"originalCharacterName":"延母 武也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"画家兼イラストレーター兼漫画家兼同人作家。"},{"spoiler":false,"text":"絵の仕事ならたいていの事はするマルチなフリーランス。"},{"spoiler":false,"text":"郊外の広めの一戸建て（二階建て）に住んでいて、部屋のひとつをアトリエに改造している。年齢は４０前。"},{"spoiler":false,"text":"ゆかりは妻の忘れ形見という事もあり、何よりも優先すべき対象と見ている。"},{"spoiler":false,"text":"若いころは趣味などがなかったわけではないが、妻が死んでからは、幼い娘に片親の苦労を背負わせてなるものかと、仕事の時以外は全て娘の事だけを考えて生きるようになった。"},{"spoiler":false,"text":"娘には趣味のひとつもないと自分が出て行った時に一気に老け込むよと釘をさされてしまっている。"}],"source":"egs","sourceCharacterId":"18020","sourceWorkId":"25722","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c63898","characterName":"延母 ゆかり","sourceIds":{"bangumi":[{"characterId":"140839","match":"exact-normalized-name-in-linked-work","subjectId":"222859"}],"egsCharacterIds":["18019"],"vndbCharacterId":"c63898"},"originalCharacterName":"延母 ゆかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Since her mother passed away a few years ago, she has lived with her father. She is a good daughter who volunteers to do household chores and try to reduce her father's burden as much as possible. She has excellent grades and is an excellent athlete. She is popular with male students and has received confessions from them, but she politely turns them all down."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c63898"},{"segments":[{"spoiler":false,"text":"女子学生。成績優秀で運動神経抜群。"},{"spoiler":false,"text":"しかし、本人は他人からの評価など特に気にしていないという様子。"},{"spoiler":false,"text":"といっても人として冷たいわけではなく、物腰や人当たりは悪くなく、誰とでも分け隔てなく接する。"},{"spoiler":false,"text":"友人も結構いて、彼女たちと休日にはショッピングにでかけたり、学校帰りにファーストフードでおしゃべりしたりするなど、人付き合いも良い。"},{"spoiler":false,"text":"男子生徒からも人気で何人かから告白を受ける事もあったが、全て丁寧に断っている。"},{"spoiler":false,"text":"小説家志望。しかしそれは漠然とした夢ではなく、実際に在学中にいくつもの作品で出版社の賞などを受賞しており、卒業後は専属の担当がついて正式に作家となる算段までついている。"},{"spoiler":false,"text":"数年前に母を亡くしてから、父と二人暮らし。"},{"spoiler":false,"text":"だが、母がいない事での不便を感じたのは、女性特有の悩み（初潮・初ブラ）に直面した時くらい。"},{"spoiler":false,"text":"それは父は在宅仕事で、しかも一人暮らしが長かったために家事も得意であり、娘に苦労をかけさせられないと懸命に努力したため。"},{"spoiler":false,"text":"とはいえ、彼女自身子どもながらそういった父の姿を見ては平然と遊び呆けてはいられないのか、自ら家の用事などを買って出て、少しでも父の負担を減らそうとする出来た娘。"}],"source":"egs","sourceCharacterId":"18019","sourceWorkId":"25722","spoiler":false},{"segments":[{"spoiler":false,"text":"女子学生。成績優秀で運動神経抜群。"},{"spoiler":false,"text":"しかし、本人は他人からの評価など特に気にしていないという様子。"},{"spoiler":false,"text":"といっても人として冷たいわけではなく、物腰や人当たりは悪くなく、誰とでも分け隔てなく接する。"},{"spoiler":false,"text":"友人も結構いて、彼女たちと休日にはショッピングにでかけたり、学校帰りにファーストフードでおしゃべりしたりするなど、人付き合いも良い。"},{"spoiler":false,"text":"男子生徒からも人気で何人かから告白を受ける事もあったが、全て丁寧に断っている。"},{"spoiler":false,"text":"小説家志望。しかしそれは漠然とした夢ではなく、実際に在学中にいくつもの作品で出版社の賞などを受賞しており、卒業後は専属の担当がついて正式に作家となる算段までついている。"},{"spoiler":false,"text":"数年前に母を亡くしてから、父と二人暮らし。"},{"spoiler":false,"text":"だが、母がいない事での不便を感じたのは、女性特有の悩み（初潮・初ブラ）に直面した時くらい。"},{"spoiler":false,"text":"それは父は在宅仕事で、しかも一人暮らしが長かったために家事も得意であり、娘に苦労をかけさせられないと懸命に努力したため。"},{"spoiler":false,"text":"とはいえ、彼女自身子どもながらそういった父の姿を見ては平然と遊び呆けてはいられないのか、自ら家の用事などを買って出て、少しでも父の負担を減らそうとする出来た娘。"}],"source":"bangumi","sourceCharacterId":"140839"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"18019","sourceWorkId":"25722","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"18019","sourceWorkId":"25722","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"18019","sourceWorkId":"25722