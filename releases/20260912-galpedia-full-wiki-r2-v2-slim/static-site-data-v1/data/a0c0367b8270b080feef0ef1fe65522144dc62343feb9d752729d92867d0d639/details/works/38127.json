{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"38127","model":{"presentationWorkId":"vndb:v55360","staff":{"artwork":[{"creditedName":"みづきことら(あかつきまお)","creatorId":"vndb:s1700","sourcePersonId":"egs:creator:1665","canonicalEntityId":"vndb:s1700","name":"みづきことら(あかつきまお)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290600","source":"egs"},{"creditedName":"森山しじみ","creatorId":"vndb:s2456","sourcePersonId":"egs:creator:16565","canonicalEntityId":"vndb:s2456","name":"森山しじみ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290601","source":"egs"}],"scenario":[{"creditedName":"Titan22","creatorId":"vndb:s14519","sourcePersonId":"egs:creator:31449","canonicalEntityId":"vndb:s14519","name":"Titan22","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290602","source":"egs"},{"creditedName":"ウィム","creatorId":"vndb:s33065","sourcePersonId":"egs:creator:39198","canonicalEntityId":"vndb:s33065","name":"ウィム","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290603","source":"egs"},{"creditedName":"ルトニャー・ハウニャー(ルトニャー=ハウニャー)","creatorId":"vndb:s33064","sourcePersonId":"egs:creator:39197","canonicalEntityId":"vndb:s33064","name":"ルトニャー・ハウニャー(ルトニャー=ハウニャー)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290604","source":"egs"}],"music":[],"other":[{"creditedName":"天翔狗","creatorId":"vndb:s5399","sourcePersonId":"egs:creator:12089","canonicalEntityId":"vndb:s5399","name":"天翔狗","detail":"プロデュース","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290608","source":"egs"},{"creditedName":"天翔 狗","creatorId":"vndb:s5399","sourcePersonId":"vndb:s5399","canonicalEntityId":"vndb:s5399","name":"天翔 狗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:214826","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_172889","characterName":"スピカ・A・ヴァージニス","sourceIds":{"bangumi":[{"characterId":"172889","match":"source-roster","subjectId":"543714"}]},"originalCharacterName":"スピカ・A・ヴァージニス","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"ラティウム王国ヴァージニス王朝の王⼥にして、第⼀王位継承者（アルファ）。"},{"spoiler":false,"text":"王家の⼥性に稀に⽣まれる『神還り』―神祖の現し⾝―として誕⽣したことで、国⺠から崇められ、愛される⼀⽅、スピカ個⼈としての⾃由は皆無だった。"},{"spoiler":false,"text":"そんな⽇々にストレスを溜めていたある⽇、かつて魔族が⽀配していた暗⿊⼤陸に触⼿型の怪物『這い寄る混沌』が出現。⽣物を取り込みながら⻄⽅諸国に侵攻を始める。"},{"spoiler":false,"text":"各国は抵抗するも、その凄まじい勢いに抗いきれず⼀国、また⼀国と陥落していく。"},{"spoiler":false,"text":"やがて混沌はラティウム王国に迫り、国王の命によってスピカは遠戚である⻄の海の向こうにある『アルビオン』に脱出することになった。"},{"spoiler":false,"text":"しかし脱出の最中、押し寄せる混沌に捕捉されてしまい護衛の騎⼠たちを失ってしまう。"},{"spoiler":false,"text":"だが絶体絶命の彼⼥の前に『勇者』を名乗る少⼥が現れたことで物語が動き始める……。"},{"spoiler":false,"text":"⼦供ほどの背丈に不釣り合いの巨乳という、いわゆる○リ巨乳体型。"},{"spoiler":false,"text":"⽗や国⺠に対しては王⼥に相応しい姿を⾒せていたが、その実は我が儘放題のメ○ガキ。"},{"spoiler":false,"text":"共に旅をすることになるサツキを事あるごとに『ざこざこ勇者』と⼩⾺⿅にするが、それも⾁親や故国を失った悲しみを隠すための強がりである。"}],"source":"bangumi","sourceCharacterId":"172889"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dbafe5494aefa8f551917d00cabd4e5c61877569c70e99d633e01c8d6ba4eec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/916018b0a981aeedc59f4c2a24bb5e58ecab4b968caa4b923d6d5bfa824b3b91.webp","width":122,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平松真奈実","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:543714:172889:19253:1","source":"bangumi"}]},{"characterId":"char_bangumi_172890","characterName":"アマホシ・サツキ","sourceIds":{"bangumi":[{"characterId":"172890","match":"source-roster","subjectId":"543714"}]},"originalCharacterName":"アマホシ・サツキ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『東国の⼥神』によって異世界から召喚された勇者で、呼び名はサツキ。"},{"spoiler":false,"text":"這い寄る混沌によって存亡の危機にある世界を救うべく⼥神に召喚されるが、早々に触⼿の怪物に襲われて⼤ピンチに陥ってしまう。"},{"spoiler":false,"text":"しかし⼥神に与えられた『神剣フツノミタマ』の⼒でなんとか難を逃れると、『世界の運命』を左右するという『王⼥スピカ』の元に送り込まれることになった。"},{"spoiler":false,"text":"異世界では『⽇本』と呼ばれる極東の国に住む⼀介のアラサー⼥⼦だったが、召喚された際に⾝体が若返りしたらしく、⾒た⽬は王⼥スピカと同年代。"},{"spoiler":false,"text":"アニメやゲームが⼤好きなオタクで、特に異世界転⽣系の作品が⼤好物。"},{"spoiler":false,"text":"密かにコスプレをしてなりきったりしていたので、まさに夢が叶ったという状況。"},{"spoiler":false,"text":"さらに可愛いメ○ガキ姫と旅が出来るので、事あるごとに⼥神に感謝する始末である。"},{"spoiler":false,"text":"転⽣ボーナスで⾝体能⼒は⾮常に⾼いものの、戦闘経験がないため危機に陥ることも。"},{"spoiler":false,"text":"「わっ、わたしはサツキ！ 異世界転⽣の勇者ですっ！」"}],"source":"bangumi","sourceCharacterId":"172890"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a85990bb0c9078855ee04d98ee2dbcab3503c5aa962d28de5f1ae4c484b4431.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d54f3cf45d69a45da068219799eb39c1e51d05be2f1f5e85c9af27bc94d5e8b7.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山口瑞樹","creatorId":"vndb:s338","sourcePersonId":"vndb:s338","canonicalEntityId":"vndb:s338","name":"山口 瑞樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:543714:172890:16462:1","source":"bangumi"}]},{"characterId":"char_bangumi_172891","characterName":"デネボラ","sourceIds":{"bangumi":[{"characterId":"172891","match":"source-roster","subjectId":"543714"}]},"originalCharacterName":"デネボラ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"這い寄る混沌がラティウム王国を襲った際に⽬撃された、謎の少⼥。"},{"spoiler":false,"text":"⾏く先々でスピカたちの前に現れ、ふたりを『遊び』に誘おうとする。"},{"spoiler":false,"text":"どうやら混沌と何らかの関係があるようだが、その⽬的も含めて⼀切不明。"},{"spoiler":false,"text":"童⼥のように純真無垢でヒマワリのような笑顔が特徴。"},{"spoiler":false,"text":"およそ悪意というものを感じさせないが、底知れない妖しさを覚えることも。"},{"spoiler":false,"text":"なお彼⼥の⾔う『遊び』とは主に性⾏為を指しており、その無邪気な姿からは想像もできないような卑猥な⾔動することも少なくない。"},{"spoiler":false,"text":"「えへへっ、お姉ちゃんたちもいっしょにあそぼ？」"}],"source":"bangumi","sourceCharacterId":"172891"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/382d6ec49cc2f8ff8ba829aa2b7e373f6696fba567c6f8e428e79c827899ce58.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ce436cd09c48faa490a9ef2a88eee8d34bc90f79ec3e558d12c77b5e5301e57.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:543714:172891:19213:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p7501","sourceCompanyId":"egs:brand:5692","canonicalEntityId":"vndb:p7501","name":"CHAOS-R","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:38127:5692","source":"egs"},{"companyId":"vndb:p7501","sourceCompanyId":"vndb:p7501","canonicalEntityId":"vndb:p7501","name":"CHAOS-R","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:144526:v55360","source":"