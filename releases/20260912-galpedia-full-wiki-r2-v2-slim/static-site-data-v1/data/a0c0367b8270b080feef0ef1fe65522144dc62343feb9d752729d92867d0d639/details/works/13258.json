:"bangumi","value":"84"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染にしてクラスメイト。"},{"spoiler":false,"text":"真面目で気が弱く、さらにドジでドン臭いが、食事の腕前は超一流。"},{"spoiler":false,"text":"主人公に淡い恋心を抱いているが、主人公が鈍感なこともあって、まったく気付いて貰えない。"},{"spoiler":false,"text":"今回の発掘も本当は乗り気ではなかったが、主人公に無理やり連れ出される。"}],"source":"egs","sourceCharacterId":"14219","sourceWorkId":"13258","spoiler":false},{"segments":[{"spoiler":false,"text":"直史の幼なじみ兼、クラスメイト。"},{"spoiler":false,"text":"真面目で気が弱く、直史に振り回される可愛そうなヒロイン。"},{"spoiler":false,"text":"今回の遺跡発掘作業もあまり乗り気ではなかったが、半ば直史に強引に連れ出されることになった。"},{"spoiler":false,"text":"乗り気でなかったのは、遺跡発掘作業はかなり危険な事が多いので、直史に怪我をしてほしくないため。"},{"spoiler":false,"text":"また、自分自身も運動神経が全然ないので、直史の足を引っ張ってしまうのが怖いため。"},{"spoiler":false,"text":"幼少の頃はドジでドン臭いため遊び仲間に入れてもらえず、一人で遊んでいた所へ直史が来ては、口では 「しょうがない」 と言いつつも遊んでくれていた。"},{"spoiler":false,"text":"そんな、自分をなにかと構ってくれる直史に淡い恋心を抱いているが、直史はそういう事に鈍感なため、気付いてもらえない。"}],"source":"bangumi","sourceCharacterId":"204572"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"14219","sourceWorkId":"13258","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"14219","sourceWorkId":"13258","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"14219","sourceWorkId":"13258","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c55a6c1896bd58f829fe8992782c44d34e063d9a2f3c3b1eee8aa51c5b715368.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c14bdc8bfd9071f0ddfa3723d43e766547ee0f8c475b25761ea269f332b95c1c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50356:204572:6351:1","source":"bangumi"}]},{"characterId":"char_c21741","characterName":"睦月 佳奈","sourceIds":{"bangumi":[{"characterId":"204574","match":"exact-normalized-name-in-linked-work","subjectId":"50356"}],"egsCharacterIds":["14221"],"vndbCharacterId":"c21741"},"originalCharacterName":"睦月 佳奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の後輩で、考古学研究部員。"},{"spoiler":false,"text":"やるからには徹底的にやるをモットーとする真面目で、負けず嫌いな性格の女の子。"},{"spoiler":false,"text":"部員の中では常識的な意見の持ち主であり、暴走気味の主人公たちに巻き込まれては、いつも酷い目に遭っている。"}],"source":"egs","sourceCharacterId":"14221","sourceWorkId":"13258","spoiler":false},{"segments":[{"spoiler":false,"text":"古い文化に興味があり、考古学研究部は真面目に考古学を研究する部活だと思い入部する。"},{"spoiler":false,"text":"実際入部してみると自分が考えていたものとは大幅に違い、現代では見向きもされない分野の考古学だったためすぐに部活を辞めようとするが、「入部してすぐ辞めるとは意気地がない」 などと直史に言われ、負けず嫌いの性格からそのまま部活に籍を置いている。"},{"spoiler":false,"text":"また真面目な性格のため、やるからには徹底的にするをモットーに部活に勤しむ。"},{"spoiler":false,"text":"そのため他の学生からは、佳奈が考古学研究部の部長だと思われている節もある。"},{"spoiler":false,"text":"直史にいつも巻き込まれてひどい目にあっているが、陽や静香に宥められ、ズルズルと順応していく自分にちょっと戸惑っている部分もある。"}],"source":"bangumi","sourceCharacterId":"204574"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"14221","sourceWorkId":"13258","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"14221","sourceWorkId":"13258","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"14221","sourceWorkId":"13258","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f68c43b4763853d221432b88788f427d6d0a9d49d1099c7ee5c6639f57f77478.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe7e99aa7f65cc81ccc1cb461c897207869e2b1d5b3b9675269238e4e06c24ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永見はるか","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50356:204574:4674:1","source":"bangumi"}]},{"characterId":"char_c21742","characterName":"神無月 美沙都","sourceIds":{"bangumi":[{"characterId":"204575","match":"exact-normalized-name-in-linked-work","subjectId":"50356"}],"egsCharacterIds":["14222"],"vndbCharacterId":"c21742"},"originalCharacterName":"神無月 美沙都","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の同級生。"},{"spoiler":false,"text":"過去に発掘現場で知り合い、考古学研究会に籍を置くことになった女の子。しかし、好奇心旺盛な性格もあって、色んな事に目移ししてしまい、ほとんど部活には顔を出さず、幽霊部員状態。"},{"spoiler":false,"text":"天真爛漫。素直で他人を疑うことを知らない純朴な少女。"},{"spoiler":false,"text":"幼い容姿から、年齢よりも低く見られがち。"}],"source":"egs","sourceCharacterId":"14222","sourceWorkId":"13258","spoiler":false},{"segments":[{"spoiler":false,"text":"昔、直史が発掘現場で知り合った同学年の女の子。"},{"spoiler":false,"text":"他人を疑うことを知らず、何事にも興味津々な天真爛漫な性格。"},{"spoiler":false,"text":"その性格からか色々なものに目が移ってしまい、なかなか部活には来ない幽霊部員。"},{"spoiler":false,"text":"歳のわりに身長が低く、胸のサイズも小さめなため年下に見られることが多々あり、それが嫌で大人ぶった行動を取る。"}],"source":"bangumi","sourceCharacterId":"204575"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"14222","sourceWorkId":"13258","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"14222","sourceWorkId":"13258","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"14222","sourceWorkId":"13258","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"waist":[{"comparisonValue":"58","source":"vndb","sourceCharacterId":"c21742","value":"58"},{"comparisonValue":"55","scope":"sourceWork","source":"egs","sourceCharacterId":"14222","sourceWorkId":"13258","value":"55"},{"comparisonValue":"55","source":"bangumi","sourceCharacterId":"204575","value":"55"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a053a8922347dcdf8d509c19bf912082ef10766644375b5cc2a5f33d0b7d8bbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74cedac13542843219d3bfea15304d03cbcba41aafdbd432d164e5295990861c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紅月 ことね","creatorId":"vndb:s1649","sourcePersonId":"vndb:s1649","canonicalEntityId":"vndb:s1649","name":"琴音 有波","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20719","source":"vndb"}]},{"characterId":"char_c21743","characterName":"文月 葉子","sourceIds":{"bangumi":[{"characterId":"204576","match":"exact-normalized-name-in-linked-work","subjectId":"50356"}