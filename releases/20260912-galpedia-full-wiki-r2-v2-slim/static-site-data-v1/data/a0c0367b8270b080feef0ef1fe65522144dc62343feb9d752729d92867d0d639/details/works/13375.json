66644","match":"exact-normalized-name-in-linked-work","subjectId":"226776"}],"egsCharacterIds":["890"],"vndbCharacterId":"c13270"},"originalCharacterName":"竜巳 麻希乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と幼なじみのメインヒロイン。"},{"spoiler":false,"text":"「催眠術が全く効かない」という、数万人に一人の珍しい体質の持ち主。"},{"spoiler":false,"text":"家では世話好きで他人を放って置けないお節介少女なのだが、学園ではエキセントリックな行動をこれでもかと連発し、周囲からは名前をもじって「天神学園の竜巻（トルネード）」と恐れられ距離を置かれている。"},{"spoiler":false,"text":"主人公がいなかった間に、お節介な性格が災いして裏切られ、孤立してしまったトラウマがあり、無意識に派手な奇行とも取れる行動に出ている。"},{"spoiler":false,"text":"「ホラ！　これでようやく解ったでしょ？　催眠術なんて無いの！"},{"spoiler":false,"text":"嘘！　デマ！　まぎらわしい！　そんなものなの！」"}],"source":"egs","sourceCharacterId":"890","sourceWorkId":"13375","spoiler":false},{"segments":[{"spoiler":false,"text":"“催眠術が全く効かない” という、数万人に一人の珍しい体質の持ち主。"},{"spoiler":false,"text":"家では世話好きで他人を放って置けないお節介少女なのだが、学園ではエキセントリックな行動をこれでもかと連発し、周囲からは名前をもじって 「天神学園の竜巻（トルネード）」 と恐れられ距離を置かれている。"},{"spoiler":false,"text":"主人公がいなかった間に、お節介な性格が災いして裏切られ孤立してしまったトラウマがあり、無意識に派手な奇行とも取れる行動に出ている。"}],"source":"bangumi","sourceCharacterId":"66644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/261509671a87cb7b7b1b96f03ee43dc1dc9537c11e0be3ab4fb322dfb7c40409.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa7366520a00b203830ef6db2933f5cf7b7a2bd8a71c0f856fa3bbf9300b3dde.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:226776:66644:5922:1","source":"bangumi"}]},{"characterId":"char_c13271","character