i"}]},{"characterId":"char_c13272","characterName":"陽明里 遥","sourceIds":{"bangumi":[{"characterId":"66646","match":"exact-normalized-name-in-linked-work","subjectId":"226776"}],"egsCharacterIds":["892"],"vndbCharacterId":"c13272"},"originalCharacterName":"陽明里 遥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園に入ってから麻希乃の信頼を勝ち取った「竜巻対策係」の一人。"},{"spoiler":false,"text":"明るく成績優秀、教師にもクラスの誰からも信頼されてるような、“万能良い子ちゃん”タイプなので基本的に後始末の外相担当。"},{"spoiler":false,"text":"一見、誰の期待も徹底的に裏切らないが、周囲の人間に合わせる事に病的なまでに固執している。"},{"spoiler":false,"text":"実家が桁外れにお金持ちのお嬢様。"},{"spoiler":false,"text":"家では籠の鳥で、自己の積極性の無さは此処からも形成された。"},{"spoiler":false,"text":"「うふふ、それは……ちょっと……うれしいかも…？"},{"spoiler":false,"text":"麻希乃ちゃんにそこまで想われてるんだったら、"},{"spoiler":false,"text":"血の雨が降ってもいいですね――」"}],"source":"egs","sourceCharacterId":"892","sourceWorkId":"13375","spoiler":false},{"segments":[{"spoiler":false,"text":"学園に入ってから麻希乃の信頼を勝ち取った 『竜巻対策係』 の一人。"},{"spoiler":false,"text":"明るく成績優秀、教師にもクラスの誰からも信頼されてるような “万能良い子ちゃん” タイプなので基本的に後始末の外相担当。"},{"spoiler":false,"text":"一見、誰の期待も徹底的に裏切らないが、周囲の人間に合わせることに病的なまでに固執している。"},{"spoiler":false,"text":"実家が桁外れにお金持ちのお嬢様。家では籠の鳥で、自己の積極性の無さはここからも形成された。"}],"source":"bangumi","sourceCharacterId":"66646"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c12068b28bd8927ae6c979c0cc7b116d01efaf3595aebf9521fdc6592042b896.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97af2457547323d692cb23f2b2d5d3cdd6fbe95f27967e83095195d326126165.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:226776:66646:6016:1","source":"bangumi"}]},{"characterId":"char_c13273","characterName":"岩清水 鴇子","sourceIds":{"bangumi":[{"characterId":"66647","match":"exact-normalized-name-in-linked-work","subjectId":"226776"}],"egsCharacterIds":["893"],"vndbCharacterId":"c13273"},"originalCharacterName":"岩清水 鴇子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クラス委員長にして鬼の風紀委員長。"},{"spoiler":false,"text":"通称「鋼鉄の処女（アイアンメイデン）」。"},{"spoiler":false,"text":"なんだかんだと言いながら事件に真っ先に駆けつけて、「風紀委員長の岩清水鴇子よ！　何があったのか説明しなさい！」"},{"spoiler":false,"text":"と自分の役職と名を叫ばなければ気がすまない辺りが、結局竜巻一派と大して変わらない目立ちたがり屋である。"},{"spoiler":false,"text":"規律や常識を何よりも重んじる性格で風紀委員と言う役職もあいまって、周囲の学生の評判は麻希乃と同じくらい悪い。"},{"spoiler":false,"text":"内心では常識を守ることで周囲と溶け込もうと努力している。"},{"spoiler":false,"text":"「な、……竜巻ぃ。キサマは……"},{"spoiler":false,"text":"このわたくしの完っ璧な仕事に……"},{"spoiler":false,"text":"ケチをつけようというのですか!?」"}],"source":"egs","sourceCharacterId":"893","sourceWorkId":"13375","spoiler":false},{"segments":[{"spoiler":false,"text":"クラス委員長にして鬼の風紀委員長。通称 「鋼鉄の処女（アイアンメイデン）」。"},{"spoiler":false,"text":"なんだかんだと言いながら事件に真っ先に駆けつけて、「風紀委員長の岩清水鴇子よ！　何があったのか説明しなさい！」 と自分の役職と名を叫ばなければ気がすまない辺りが、結局竜巻一派と大して変わらない目立ちたがり屋である。"},{"spoiler":false,"text":"規律や常識を何よりも重んじる性格で、風紀委員と言う役職もあいまって周囲の学生の評判は麻希乃と同じくらい悪い。"},{"spoiler":false,"text":"内心では常識を守ることで周囲と溶け込もうと努力している。"}],"source":"bangumi","sourceCharacterId":"66647"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb9541e6a81fa5bffb318ba76cac55775bcfadd3189ecdcaa33b55aad784d002.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/782b9abd15659bcd04dedae133bce548b4a1dd87bbb04c53da90085f42606eb7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:226776:66647:6166:1","source":"bangumi"}]},{"characterId":"char_c13274","characterName":"卯月 小姫","sourceIds":{"bangumi":[{"characterId":"66648","match":"exact-normalized-name-in-linked-work","subjectId":"226776"}],"egsCharacterIds":["894"],"vndbCharacterId":"c13274"},"originalCharacterName":"卯月 小姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"麻希乃、奈津美、遥らの担任教師。"},{"spoiler":false,"text":"竜巻の被害をド正面から受け止め、いつも麻希乃を叱ろうとするのだが、いつもその役目を鴇子に奪われ、性格もあってむしろ鴇子をなだめる側に回ってしまう。"},{"spoiler":false,"text":"いつもぽやーっとしている、おっとり系のお姉さんタイプの為、学生達からは「姫先生」だの「姫ちゃん」だのと呼ばれてナメられ切っている。"},{"spoiler":false,"text":"一見振り回されているだけに見えるが学生達の自己判断と自己解決力を信じるという強い信念の元に、大人の横槍を防ぐため影で孤軍奮闘をしていたりする。"},{"spoiler":false,"text":"「もうっ！　オトナをからかうんじゃ、ありませーんっ！」"}],"source":"egs","sourceCharacterId":"894","sourceWorkId":"13375","spoiler":false},{"segments":[{"spoiler":false,"text":"麻希乃、奈津美、遥らの担任教師。"},{"spoiler":false,"text":"竜巻の被害をド正面から受け止め、いつも麻希乃を叱ろうとするのだがその役目を鴇子に奪われ、性格もあってむしろ鴇子をなだめる側に回ってしまう。"},{"spoiler":false,"text":"いつもぽやーっとしている おっとり系のお姉さんタイプなため、学生たちからは 「姫先生」 だの 「姫ちゃん」 だのと呼ばれてナメられ切っている。"},{"spoiler":false,"text":"一見振り回されているだけに見えるが、職員室では孤軍奮闘をしていたりする。"}],"source":"bangumi","sourceCharacterId":"66648"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a23eef342907cca322c6309938d99fc50db9c323e2b376899292b4a0963cbdff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f85b5d10bb06257041750e7dae8e546a0a27ae70b83f1fd2052d47d78b59ae3.webp","width"