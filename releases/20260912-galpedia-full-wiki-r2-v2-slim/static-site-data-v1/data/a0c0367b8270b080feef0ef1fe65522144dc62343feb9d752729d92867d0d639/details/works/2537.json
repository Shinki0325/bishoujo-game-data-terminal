-detail"},"actors":[{"creditedName":"みちる","creatorId":"vndb:s1663","sourcePersonId":"vndb:s1663","canonicalEntityId":"vndb:s1663","name":"吉川 由弥","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1454","source":"vndb"}]},{"characterId":"char_vndb_c26928","characterName":"桂木 朋絵","sourceIds":{"vndbCharacterId":"c26928"},"originalCharacterName":"桂木 朋絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tomoe is one of Asumi's roommates. She's kind and responsible girl every schoolmate dreaming about. At the same time, she's terribly shy and lacks of self-confidence (especially when it comes to the boys). That's why she was forced to accept Asumi's dictatorship and became a good friend of hers."}],"source":"vndb","sourceCharacterId":"c26928"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e7e4bd0f510ab232c65cc14f6b4670e4e753eef459dcd081a7cd8ee921f611c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69315699841770b44dae05cecd54f2b9416cae53de318ec6be41f65bc673a05f.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まき いづみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1450","source":"vndb"}]},{"characterId":"char_vndb_c26929","characterName":"本庄 なみき","sourceIds":{"vndbCharacterId":"c26929"},"originalCharacterName":"本庄 なみき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb"