{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25876","model":{"presentationWorkId":"vndb:v19516","staff":{"artwork":[{"creditedName":"Badriel","creatorId":"vndb:s1838","sourcePersonId":"vndb:s1838","canonicalEntityId":"vndb:s1838","name":"Badriel","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:131400","source":"vndb"},{"creditedName":"Wanaca","creatorId":"vndb:s5464","sourcePersonId":"vndb:s5464","canonicalEntityId":"vndb:s5464","name":"Wanaca","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:131402","source":"vndb"},{"creditedName":"kauru","creatorId":"vndb:s11131","sourcePersonId":"vndb:s11131","canonicalEntityId":"vndb:s11131","name":"kauru","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:131404","source":"vndb"},{"creditedName":"MMrailgun","creatorId":"vndb:s11132","sourcePersonId":"vndb:s11132","canonicalEntityId":"vndb:s11132","name":"MMrailgun","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:131405","source":"vndb"},{"creditedName":"フェイトリネ-アルファ","creatorId":"vndb:s11936","sourcePersonId":"vndb:s11936","canonicalEntityId":"vndb:s11936","name":"フェイトリネ-アルファ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:131406","source":"vndb"}],"scenario":[{"creditedName":"Liberty","creatorId":"vndb:s9369","sourcePersonId":"vndb:s9369","canonicalEntityId":"vndb:s9369","name":"Liberty","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:131403","source":"vndb"}],"music":[{"creditedName":"Zack Parrish","creatorId":"vndb:s12287","sourcePersonId":"vndb:s12287","canonicalEntityId":"vndb:s12287","name":"Zack Parrish","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:131407","source":"vndb"}],"other":[{"creditedName":"Wanaca","creatorId":"vndb:s5464","sourcePersonId":"vndb:s5464","canonicalEntityId":"vndb:s5464","name":"Wanaca","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:131401","source":"vndb"},{"creditedName":"Exilim","creatorId":"vndb:s29888","sourcePersonId":"vndb:s29888","canonicalEntityId":"vndb:s29888","name":"Exilim","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131408","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c135989","characterName":"Spear Warrior","sourceIds":{"vndbCharacterId":"c135989"},"originalCharacterName":"Spear Warrior","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"A tired and bored guardsman, quite gifted with a spear.\" - In-game description"},{"spoiler":false,"text":"Spear Warrior is a type of monster encountered early on in the dungeon. They take their guard duty quite seriously, with the one captured by the player admitting to having stood guard at a previous post for several years. However, she has a clear desire for battle, accepting Yomi's recruitment offer due to severe boredom with her current work."},{"spoiler":false,"text":"Floor(s): 5-7"}],"source":"vndb","sourceCharacterId":"c135989"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aabb6ad5a9cd9b55f3c29ac21aed7d567760af0f12fa70c4847a3ab785212d74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6219efd1b45205a6e876bb21f568253dcda7921cbd0accf50fc7c64caa57e9c.webp","width":235,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c136533","characterName":"Abyssal Cow","sourceIds":{"vndbCharacterId":"c136533"},"originalCharacterName":"Abyssal Cow","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Changed by the Abyss and armed with a strange backpack, this cow girl is a dangerous monster.\" - In-game description"},{"spoiler":false,"text":"The Abyssal Cow is the first type of demon encountered in the dungeon, their appearances altered by high concentrations of magic and the Abyss. They are laid-back and rude, with one calling Yomi's party \"losers\" before their fight. Despite this, the Abyssal Cow captured by the player will readily join the party out of boredom and wanting to be on the winning side."},{"spoiler":false,"text":"In order to proceed to the Abyssal Gateways, the player must capture three Abyssal Cows and milk them. The milk then needs to be given to Anubis, who will inform Yomi's party on how to advance to the lower floors."},{"spoiler":false,"text":"Floor(s): 20-23, 25"}],"source":"vndb","sourceCharacterId":"c136533"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1024609c020e4e457f5268dfb404b40a69ef686613a0b8648a1e082d4839bbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26e83e75cab70fbb9ba122ac3e39c9a5aa3e371d6c077ac39815b86f5f1af777.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c173356","characterName":"Panda","sourceIds":{"vndbCharacterId":"c173356"},"originalCharacterName":"Panda","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Fuzziness bestowed upon the most ill fitting creature it could be, the panda is far from docile.\" - In-game description"},{"spoiler":false,"text":"Panda is a monster encountered around mid-way through the dungeon. Upon seeing her, Ceri is incredibly enamored by her cuteness, to the point where she later personally recruits her into the party; fortunately, she is rather easily won over with the promise of all the bamboo she can eat. Yomi notes that Ceri's attempt to persuade Panda to join their side has left her the most nervous she's ever seen her."},{"spoiler":false,"text":"If the player chooses to walk around the Bamboo Forest outside of town, Yomi and the party will encounter a Panda who has been robbing unfortunate travelers. Upon her defeat, plant fibers are obtained to create a new outfit for Ceri."}],"source":"vndb","sourceCharacterId":"c173356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ade023397ad799e01a629d990872c147a6807a985cdbd78d9a7028e082083ad3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2296af35cfe9bc8939eec2e8963fd1b07881341f7ed0362e3c8c7c06a4e35249.webp","width":217,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48304","characterName":"Yomi","sourceIds":{"vndbCharacterId":"c48304"},"originalCharacterName":"Yomi","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After awakening from a deep sleep, she finds herself powerless and her dungeon taken away from her. With the help of a knight who awakened her, she sets off to reclaim her dungeon."}],"source":"vndb","sourceCharacterId":"c48304"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bfaf3a4447779b580c74b60b3768e5f7d149e578d8b12a65869d7a222d55e84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e295849c4cbfb94e7ceb5a4a1e077d5419edf8db74042b902959dfbf57facf3.webp","width":228,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48306","characterName":"Ceri","sourceIds":{"vndbCharacterId":"c48306"},"originalCharacterName":"Ceri","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An adventurer who was tasked to clear out a dungeon of its monsters. Forced to work with Yomi, the former dungeon keeper, the two set off on a common goal to explore the dungeon taken from Yomi."}],"source":"vndb","sourceCharacterId":"c48306"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/830da642d9d556dd106563895415a06dd922807d92a507f03f134af171fbbb9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63282504a8d9aa1f41a4651d3245782b6f32e2a53af99e0d12c52adfb5945797.webp","width":217,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48307","characterName":"Isabella","sourceIds":{"vndbCharacterId":"c48307"},"originalCharacterName":"Isabella","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The innkeeper of a local inn above the dungeon. She knows Yomi."}],"source":"vndb","sourceCharacterId":"c48307"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee20a6d70140afcfe36fd45bf968eee2a57a5d8e354eef27c8a1354bfab3e27d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7454583aa9eb8ac9dc38496d16e4f28877c70ef4cfe2a5dc0b2b377350502917.webp","width":207,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48318","characterName":"Charlotte","sourceIds":{"vndbCharacterId":"c48318"},"originalCharacterName":"Charlotte","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Welcome back, my humble master!\""},{"spoiler":false,"text":"Charlotte is the shopkeeper in Yomi's town, as well as a craftsperson. Having known Yomi for so long, she is used to her master's perverted and unusual ways and possesses quite a calm demeanor. The only time Charlotte truly expresses anger towards anyone is when a Warrior teleports into her shop and endangers her merchandise. Her loyalty to Yomi runs considerably deep, even making her feel the need to"},{"spoiler":true,"text":"hide her love for Isabella; when Yomi eventually discovers their relationship, the two express immense guilt over slacking off from their work before Yomi reassures them."},{"spoiler":true,"text":"She is a devoted follower to the goddess Fortuna, lamenting that unlike her other followers long ago, she has still not abandoned her."}],"source":"vndb","sourceCharacterId":"c48318"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc53cfcaf0bbc691391f99bcb42595cf0c5d12234a612b2acb8c772613d5f419.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9bc555b4c514233cfe7bb29562415be6ddea7ba6fe836e053b1754808293eb5.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48451","characterName":"Sylvi","sourceIds":{"vndbCharacterId":"c48451"},"originalCharacterName":"Sylvi","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A well-read, albeit inexperienced, magician from the Elven Metropolis."}],"source":"vndb","sourceCharacterId":"c48451"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05b022d33a6390c94a95ddea619155968e08f61a1f673ede5e3474d7d0e54bae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbb36b0caf87a89f285a4abf4f2688d633c3319bfcdabd67e6b632913ebcb6c6.webp","width":256,"height":232,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4019","sourceCompanyId":"egs:brand:4611","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25876:4611","source":"egs"},{"companyId":"vndb:p11862","sourceCompanyId":"vndb:p11862","canonicalEntityId":"vndb:p11862","name":"Gamuzumi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:119086:v19516","source":"vndb"},{"companyId":"vndb:p9801","sourceCompanyId":"vndb:p9801","canonicalEntityId":"vndb:p9801","name":"FaceOff","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:145749:v19516","source":"vndb"},{"companyId":"vndb:p162","sourceCompanyId":"vndb:p162","canonicalEntityId":"vndb:p162","name":"Sekai Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:53278:v19516","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEnt