gumi":[{"characterId":"95323","match":"exact-normalized-name-in-linked-work","subjectId":"116852"}],"egsCharacterIds":["9271"],"vndbCharacterId":"c59594"},"originalCharacterName":"阿部 泰親","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"height":{"reviewState":"no-conflict","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在憲と同じ、私立W大学人文学科2年生。民俗学の源ゼミに席を置く。"},{"spoiler":false,"text":"ひと言で言えば「変人」。それも「超」のつくような変人である。"},{"spoiler":false,"text":"恐ろしいほどの記憶力と博覧強記を誇り、国際政治からアニメや音楽などのサブカルチャーに至るまで、泰親に尋ねて答えが戻ってこないことはない。"},{"spoiler":false,"text":"普段はいつでも、強烈な皮肉かふざけているような事しか言わないという毒舌の持ち主。"},{"spoiler":false,"text":"かなりの人見知りであり、初対面の人間に対しては、よほどのことがない限り敵意、あるいは不信感といった「ネガティブアプローチ」から入る。"},{"spoiler":false,"text":"在憲は、泰親にとって唯一「親友」と呼べる人間であり、そのせいか泰親は在憲の言葉だけには、あまり強く反応しない。"},{"spoiler":false,"text":"これだけ性格に難のある人間であるにもかかわらず、外見だけはとにかく恵まれているので、女性に不自由したことがない。"}],"source":"egs","sourceCharacterId":"9271","sourceWorkId":"16306","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：178cm　 体重：63kg　 血液型：AB型"},{"spoiler":false,"text":"在憲の友人で、在憲と同じ私立W大学人文学科2年生。民俗学の源ゼミに席を置く。"},{"spoiler":false,"text":"ひと言で言えば “変人”。それも “超” のつくような変人である。"},{"spoiler":false,"text":"恐ろしいほどの記憶力と博覧強記を誇り、大学での特待生の地位をやすやすと手に入れた程の男だが、いつもふざけたことか皮肉しか言わないという強烈な毒舌の持ち主。"},{"spoiler":false,"text":"おまけにかなりの人見知りで、在憲は泰親にとって唯一 “親友” と呼べる人間。"},{"spoiler":false,"text":"これだけ性格に難のある人間だが、外見はとにかく良いので女性に不自由したことがなく、女性への対応は手慣れている。"},{"spoiler":false,"text":"ただし、付き合いが長続きしたためしはない。"},{"spoiler":false,"text":"泰親の最大の弱点はスポーツで、見ている人間が哀れに思うほど壮絶な運動音痴。"},{"spoiler":false,"text":"そのため、根性や気合いといった体育会的メンタリティや、スポーツ感動系の事物を親の敵のように嫌っている。"},{"spoiler":false,"text":"「人類の半分は女性なんだぜ。それで、どうして彼女ができないなんてことがあり得るのか、俺には理解できないね」"}],"source":"bangumi","sourceCharacterI