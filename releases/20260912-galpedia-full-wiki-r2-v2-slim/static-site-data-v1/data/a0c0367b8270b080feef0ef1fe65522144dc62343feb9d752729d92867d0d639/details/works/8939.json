b:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:972","source":"vndb"}]},{"characterId":"char_vndb_c1203","characterName":"青砥 正則","sourceIds":{"vndbCharacterId":"c1203"},"originalCharacterName":"青砥 正則","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"115"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Masanori is the homeroom teacher of Kouhei, Haruna, Kiriha and Tsukasa's class, as well as the one in-charge of the male side of the school dormitory. He teaches Chemistry. Has a mild personality. Takes towards an independence and autonomy approach in education. He is usually known by the nickname \"Aonori\", while Kanade calls him \"Noripii\". Was known to be a troublemaker during his younger days."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c1203"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/406cc16e9a38ddf1a5eb38dc74a8fef8c9da72c2f727c0898f31fe4bc3d47920.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa371c9732ab03b92a08019f51571a0ff3c43d3f9f2c09842adcc099eb3a6601.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一条 和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:975","source":"vndb"}]},{"characterId":"char_vndb_c1204","characterNam