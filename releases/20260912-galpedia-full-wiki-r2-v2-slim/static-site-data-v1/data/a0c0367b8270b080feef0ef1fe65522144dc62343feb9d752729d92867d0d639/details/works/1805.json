wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b3b578fbd287643e5fa3634de1ff03d0ac7d21ba100d237edf1939ad1ee8605.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c11943","characterName":"田中 美沙","sourceIds":{"bangumi":[{"characterId":"36105","match":"exact-normalized-name-in-linked-work","subjectId":"20346"},{"characterId":"36105","match":"exact-normalized-name-in-linked-work","subjectId":"317476"}],"egsCharacterIds":["23034"],"vndbCharacterId":"c11943"},"originalCharacterName":"田中 美沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"417"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A star track-team member and all-around athletic ace. While not the girliest of girls, her positive attitude and refusal to back down make her a master at trading barbs with the protagonist. Hardworking to a fault, she puts her all into everything. From time to time, that drive spins out of control…"},{"spoiler":false,"text":"from Gematsu"}],"source":"vndb","sourceCharacterId":"c11943"},{"segments":[{"spoiler":false,"text":"陸上部所属。抜群の運動神経で、エースとして活躍する。"},{"spoiler":false,"text":"男勝りの性格で、陽気で勝ち気。主人公とは喧嘩友達のような関係。"},{"spoiler":false,"text":"努力家でもあり、常に物事に全力で取り組むが、それが空回りしてしまうことも…。"}],"source":"egs","sourceCharacterId":"23034","sourceWorkId":"30157","spoiler":false},{"segments":[{"spoiler":false,"text":"体育大学に通う、スポーツ万能な女の子。"},{"spoiler":false,"text":"親友に会うため八十八町を訪れた際、偶然主人公と出会う。"}],"source":"egs","sourceCharacterId":"23034","sourceWorkId":"36044","spoiler":false},{"segments":[{"spoiler":false,"text":"著名游戏《同级生》的女主角之一，由于其受欢迎程度超越了原设定中第一女主角樱木舞，于是在续集《同级生2》作为女主角之一出现，与《同级生2》女主角鸣泽唯一样在游戏系列中有极高的人气。外貌特征为棕色单马尾发型，属于“运动型”的阳光美少女，在《同级生》中是“先负学园”学生，在《同级生2》中是体育大学（官方未设定校名）二年级学生。"}],"source":"bangumi","sourceCharacterId":"36105"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99c87d77d60c0574248d21439fb30ee15c480e80054a58bbdd08c1f14ec12d4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0374428271dbc47445c2444d4cd01ce029f787d763615c71a62e0ff33770de08.webp","width":180,"height":225,"source":"static-detail"},"actors":[]},{"characterId":"char_c12369","characterName":"仁科 くるみ","sourceIds":{"bangumi":[{"characterId":"100621","match":"exact-normalized-name-in-linked-work","subjectId":"20346"},{"characterId":"100621","match":"exact-normalized-name-in-linked-work","subjectId":"317476"}],"egsCharacterIds":["23037"],"vndbCharacterId":"c12369"},"originalCharacterName":"仁科 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"811"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８３"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８４"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５６"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As the girlfriend of Kazuya—the protagonist’s buddy—Kurumi is on good terms with the protagonist, too. Raised by an overprotective father, she believes that her relationships should always be “pure,” which puts her on bad terms with Kazuya’s blue balls. She turns to the protagonist to get another male perspective…"},{"spoiler":false,"text":"from Gematsu"}],"source":"vndb","sourceCharacterId":"c12369"},{"segments":[{"spoiler":false,"text":"主人公の悪友と付き合っており、主人公とも面識がある。"},{"spoiler":false,"text":"厳格な考え方の両親に育てられ、清い交際をするべきと信じている。"},{"spoiler":false,"text":"しかし恋人はそう考えておらずすれ違いが発生。"},{"spoiler":false,"text":"主人公にその悩みを相談しようとするが…。"}],"source":"egs","sourceCharacterId":"23037","sourceWorkId":"30157","spoiler":false},{"segments":[{"spoiler":false,"text":"坂上一哉の彼女。"},{"spoiler":false,"text":"厳格な両親に育てられており、純粋で恋愛にも奥手と少々幼い。"},{"spoiler":false,"text":"同学年の主人公を先輩と呼ぶことが時々ある。"},{"spoiler":false,"text":"一哉とは清らかな恋愛関係を築きたいが、"},{"spoiler":false,"text":"早く肉体関係を持ちたい一哉との考えの違いから関係が疎遠になっている。"},{"spoiler":false,"text":"恋人との関係を改善するため、主人公に相談したことがきっかけで、彼に惹かれていく。"}],"source":"bangumi","sourceCharacterId":"100621"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"80","source":"vndb","sourceCharacterId":"c12369","value":"80"},{"comparisonValue":"83","scope":"sourceWork","source":"egs","sourceCharacterId":"23037","sourceWorkId":"30157","value":"83"},{"comparisonValue":"83","source":"bangumi","sourceCharacterId":"100621","value":"８３"}],"height":[{"comparisonValue":"155","source":"vndb","sourceCharacterId":"c12369","value":"155"},{"comparisonValue":"156","scope":"sourceWork","source":"egs","sourceCharacterId":"23037","sourceWorkId":"30157","value":"156"},{"comparisonValue":"156","source":"bangumi","sourceCharacterId":"100621","value":"１５６㎝"}],"hip":[{"comparisonValue":"81","source":"vndb","sourceCharacterId":"c12369","value":"81"},{"comparisonValue":"84","scope":"sourceWork","source":"egs","sourceCharacterId":"23037","sourceWorkId":"30157","value":"84"},{"comparisonValue":"84","source":"bangumi","sourceCharacterId":"100621","value":"８４"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c22706126333b58366c63ddd92befa6fc933eeb6c08a677bdd205e79c36d52e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7855d26cd3510ce093539d563d40f541cc2949a1968b55ec8988a9c1146424d2.webp","width":200,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_c43224","characterName":"桜木 舞","sourceIds":{"bangumi":[{"characterId":"100620","match":"exact-normalized-name-in-linked-work","subjectId":"20346"},{"characterId":"100620","match":"exact-normalized-name-in-linked-work","subjectId":"317476"}],"egsCharacterIds":["23033"],"vndbCharacterId":"c43224"},"originalCharacterName":"桜木 舞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８３"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"１５８㎝"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８６"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５６"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A sheltered rich girl from an upstanding family. Through no choice of her own, Mai seldom socializes with the other students due to her busy extracurricular schedule—even during the summer break. Her perfect posture and high-class manners hide a fierce passion and determination underneath. Despite her many male admirers, she seems uncomfortable with her reputation as the campus sweetheart."},{"spoiler":false,"text":"from Gematsu"}],"source":"vndb","sourceCharacterId":"c43224"},{"segments":[{"spoiler":false,"text":"良家のお嬢様で箱入り娘。"},{"spoiler":false,"text":"習い事でとても忙しい日々を送っており、あまり学園で見かけることはない。"},{"spoiler":false,"text":"淑女であり、控えめでおしとやかな言動が目立つが、芯が強く秘めた情熱は激しい。"},{"spoiler":false,"text":"学園中の男子の憧れであるが、本人はそう見られることを好ましく思っていないようだ。"}],"source":"egs","sourceCharacterId":"23033","sourceWorkId":"30157","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。水泳部所属。"},{"spoiler":false,"text":"各種の稽古事が忙しく、部には滅多に顔を出さない。"},{"spoiler":false,"text":"良家のお嬢様でいわゆる淑女。"},{"spoiler":false,"text":"学園のマドンナ的存在でもあるが、そう見られたくないと思っている。"},{"spoiler":false,"text":"芯が強いお嬢様。箱入り娘。"},{"spoiler":false,"text":"秘めた情熱はとても強く、一途。"}],"source":"bangumi","sourceCharacterId":"100620"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cdf8406c085d463e0e8351f3b5449b1292ba884c195ceede3f88d11bd94b480.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5509e3ce4e7ef399c47050f1ad83d241aa6a0dcb3d28004776f73450b7e974e.webp","width":200,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_c53060","characterName":"伊頭 鬼作","sourceIds":{"bangumi":[{"characterId":"96106","match":"exact-normalized-name-in-linked-work","subjectId":"283397"}],"egsCharacterIds":["21401"],"vndbCharacterId":"c53060"},"originalCharacterName":"伊頭 鬼作","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伊頭家の三男でかつて杉本製薬で登り詰めた男。"},{"spoiler":false,"text":"その後、間宮財閥の美容関連の部門を統べる麗亜と政略結婚した。"},{"spoiler":false,"text":"今はその女性の経営する高級フィットネスクラブで管理人をしながら鬼畜道に邁進している。"},{"spoiler":false,"text":"管理人職は片手間で、盗聴、盗撮はお手の物。"},{"spoiler":false,"text":"肉壺たちの弱味を掴むために日々努力を惜しまない。"}],"source":"egs","sourceCharacterId":"21401","sourceWorkId":"27967","spoiler":false},{"segments":[{"spoiler":false,"text":"伊頭家の三男でかつて杉本製薬で登り詰めた男。"},{"spoiler":false,"text":"その後、間宮財閥の美容関連の部門を統べる麗亜と政略結婚した。"},{"spoiler":false,"text":"今はその女性の経営する高級フィットネスクラブで管理人をしながら鬼畜道に邁進している。"}