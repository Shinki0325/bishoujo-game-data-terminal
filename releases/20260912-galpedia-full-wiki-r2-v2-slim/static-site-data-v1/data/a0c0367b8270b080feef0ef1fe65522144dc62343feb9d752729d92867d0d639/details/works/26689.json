:[{"segments":[{"spoiler":false,"text":"Yuka is Himeko's long time best friend. She is a bit of a not-true-to-herself type and often dresses in frilly kind of clothing. Unlike Himeko, Yuka is more girlish."},{"spoiler":false,"text":"Edited from Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c33254"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aee010f779cbe709586be9e8887fc73cfb9fad1e6a9aa5a21cc290ea54bc30f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/704644d8caf5da32c034461896f1dbc7b5cc3989a2efaae956d9abb60c4f9765.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩居 由希子","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67697","source":"vndb"}]},{"characterId":"char_vndb_c6579","characterName":"篠原 千尋","sourceIds":{"vndbCharacterId":"c6579"},"originalCharacterName":"篠原 千尋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Himeko's younger sister. She is a devout Christian believer with a kind personality and a hospice volunteer on hospital's 7th floor."},{"spoiler":false,"text":"From Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c6579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2139665e8ea3d58c9e20da083002002631db1e92dbcb6b5a9bed84aac15b82b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a89fac3370a4d058d9dc656a68640cd8706923181e8e3ec729fc1a8e94297963.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67695","source":"vndb"}]},{"characterId":"char_vndb_c81017","characterName":"日下 陽子","sourceIds":{"vndbCharacterId":"c81017"},"originalCharacterName":"日下 陽子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9ce6b5ab3b331214733cf5035f0fedd791b6e2cac0eea75f5209147a77a320a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6de1d63bcca8546978cb197bbe388963bd2f8b112e826c61080b2e2a41748541.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永 朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67694","source":"vndb"}]},{"characterId":"char_vndb_c939","characterName":"佐倉 瀬津美","sourceIds":{"vndbCharacterId":"c939"},"originalCharacterName":"佐倉 瀬津美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age in Narcissu: 22"},{"spoiler":false,"text":"Age in Narcissu Side 2nd: 15"},{"spoiler":false,"text":"Setsumi has a childlike physique. She has a taciturn and stoic kind of personality. She loves cars and is knowledgeable about them. Because of her terminal illness, she has no friends and is always seen alone. After many years of receiving treatment, she became totally desperate about everything - life or time, or each day passing doesn't matter to her anymore. It is just like she stated once: \"My time came to a halt\". Everything is very painful to her because she was left behind alone as the world around her continued to move on."},{"spoiler":false,"text":"In Narcissu, she met Atou Yuu, a new resident of the hospital's 7th floor, the hospice, and for a short moment did she come to know something like hope."},{"spoiler":true,"text":"They escaped together and headed to Awajishima, to watch the beautiful blooming narcissus. Along the way, they grew attached to each other and the girl found herself emotional again, happy with her new skirt, blushing... At the end of their journey, she asked for a bikini, and after a long day of playing at the beach, she went into the sea and ended her very life."},{"spoiler":false,"text":"In Narcissu Side 2nd, when she was still an outpatient at her age of 15, she met a resident of the hospital's 7th floor, one of hospice's patients, called Himeko. Their bond grew quickly as Himeko and Setsumi enjoyed their summer days together."},{"spoiler":false,"text":"Edited from Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c939"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d18ea2711d1d8f535320647cfc1a7bad8f75cb127bac98ca9ea1821e5df4711c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17658a11a43db493bdd09d34617ce272a3a69ec19c984e759876933ce488dde7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾川 りの","creatorId":"vndb:s1054","sourcePersonId":"vndb:s1054","canonicalEntityId":"vndb:s1054","name":"綾川 りの","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67696","source":"vndb"}]},{"characterId":"char_vndb_c940","characterName":"阿東 優","sourceIds":{"vndbCharacterId":"c940"},"originalCharacterName":"阿東 優","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man, 20 years of age. Your typical university student. Attends a technical institute, and has just taken (and passed) his driver's license examination. Lives with his family—a taciturn and unsupportive mother and father and a little sister who only ever has harsh words for him. Has never really been sick in his entire life. Has never really had much of an aim for his entire life, either."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c940"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d35f9b59892049172ad1dbb11af49db0219c42cace4298355834fba52ef5551.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73ac81c09af112fb159a15f9d7c2ab094f6c2694c8bdf4f0be8f0c62d8a19d5c.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p11","sourceCompanyId":"egs:brand:1351","canonicalEntityId":"vndb:p11","name":"ステージ☆なな","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26689:1351","source":"egs"},{"companyId":"vndb:p2998","sourceCompanyId":"vndb:p2998","canonicalEntityId":"vndb:p2998","name":"风铃汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:119894:v18738","source":"vndb"},{"companyId":"vndb:p2998","sourceCo