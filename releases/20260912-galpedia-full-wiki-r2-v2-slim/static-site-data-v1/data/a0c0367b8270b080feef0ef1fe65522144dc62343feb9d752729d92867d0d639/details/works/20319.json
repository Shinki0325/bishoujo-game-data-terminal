iewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71a1dded66175fba3a227f4a49576eb5cadf9f241461a1154866d77fd6bc0460.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/106ec1d97089c9f28c7b61f7ed58b7fbfe3c0ff434ea9fbea53b834d6ab6860a.webp","width":166,"height":222,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c21384","characterName":"椿 灯吾","sourceIds":{"vndbCharacterId":"c21384"},"originalCharacterName":"椿 灯吾","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsubaki is a high school boy who hates the red flowers he was named after. He lives with his dad and his younger sister Hina in a house surrounded by camellia. At the winter festival, Tsubaki stood out from all the faceless people and caught Yue’s interest. Both Tsubaki and Kurogitsune seemed nervous about this encounter, but Tsubaki quickly recollected himself. Aloof to a fault, Tsubaki keeps everyone at a comfortable distance. Sagano offhandedly commented that Tsubaki is a liar, even to himself."}],"source":"vndb","sourceCharacterId":"c21384"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04f9313c73dd5161e500e9cd70335dded7632a6529ea9b5996b31eaef3a0c5f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/355a8f1876679645b6da6f0be5fac624097ded1759c962063e060dfe252975e5.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水島 大宙","creatorId":"vndb:s52","sourcePersonId":"vndb:s52","canonicalEntityId":"vndb:s52","name":"水島 大宙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33520","source":"vndb"}]},{"characterId":"char_vndb_c21386","characterName":"嵯峨野","sourceIds":{"vndbCharacterId":"c21386"},"originalCharacterName":"嵯峨野","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious man with elaborate facial markings who casually dons what appears to be a bloody fox tail muffler. Sagano seemingly knows a good deal about both Yue’s identity and the source of Yue’s troubled dreams, but he discloses no information. Sagano is often seen with a cold smirk on his face. Kurogitsune notes that the only time Sagano doesn’t appear dangerous or threatening is when he's eating."},{"spoiler":true,"text":"His real name is Tsubaki Akashi."}],"source":"vndb","sourceCharacterId":"c21386"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d417d1040bf820cbf717bbc79e08a642610bdb3645fa65d02e9a7252b43d643.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bdeceea45f4461f0e1b2499eb8f43fab6e934e4981a579f67407a5951a0ce16.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33516","source":"vndb"}]},{"characterId":"char_vndb_c21387","characterName":"ミコトの主","sourceIds":{"vndbCharacterId":"c21387"},"originalCharacterName":"ミコトの主","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"112"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The god of the temple. Although she looks like a young girl, Mikoto is an old, powerful spirit. She has 8 tails visible, one short of being a nine-tailed fox spirit. Mikoto’s orders are absolute to the temple residents. However, she dotes on Yue. When she learned Yue found people of interest after he snuck to town, Mikoto retracted her ban. Her new orders are for Yue to become close to those people, ominously stating they are a necessity to Yue."}],"source":"vndb","sourceCharacterId":"c21387"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0b5db5d3742d61062fb5879c7e3353791612590bb40d637d8fe69d90d208b73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4232b489b25e8bb49f40555996936e5f890a46abf831be85e89f999ccd2ba3a.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城 みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33514","source":"vndb"}]},{"characterId":"char_vndb_c21389","characterName":"朔","sourceIds":{"vndbCharacterId":"c21389"},"originalCharacterName":"朔","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Saku is mischievous and teasing. While she and Nagi appear to be cute, young girls, these two are strong spirits who will forcibly drive anyone out of their territory. Altho