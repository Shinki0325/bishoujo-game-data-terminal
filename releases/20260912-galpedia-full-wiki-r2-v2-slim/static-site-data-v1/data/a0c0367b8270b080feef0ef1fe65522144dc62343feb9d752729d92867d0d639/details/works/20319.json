urceCharacterId":"c3487"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46f81938820958f018fe5439ed137d51169c7d460b91a93bdd92e21d25b18f61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c999abf417ebfca2bd203e156defc336b06efacd98ca3ebe79e97ae97a26869c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花 慎之介","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33522","source":"vndb"}]},{"characterId":"char_vndb_c3488","characterName":"黒狐","sourceIds":{"vndbCharacterId":"c3488"},"originalCharacterName":"黒狐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kurogitsune (literally “black fox”) is a feisty and excitable fox spirit usually found in the company of Yue. He can take either a fox or human form, although he retains his ears and tail. As a resident of the temple, Kurogitsune’s role is to protect Yue. He clearly knows something about Yue’s past, but casually deflects any questions. Unlike Yue, Kurogitsune occasionally descends from the mountain into town alone. However, he is not fond of humans, only their food."}],"source":"vndb","sourceCharacterId":"c3488"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf09aeb0a0252ab59ef204dcece3558f8b4afb65a5f6816446beafb3c5515812.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dde3b768c55abc0de7b071896db2