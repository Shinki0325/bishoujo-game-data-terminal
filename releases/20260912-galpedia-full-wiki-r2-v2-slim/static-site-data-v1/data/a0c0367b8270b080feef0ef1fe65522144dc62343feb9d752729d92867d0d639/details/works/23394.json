e-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A princess that was born from a concubine of the king of Veke."},{"spoiler":false,"text":"Even though she is a princess, from the moment she was born she was treated badly and confined in a tower at the northern part of the castle."},{"spoiler":false,"text":"A rumor spread through all the people in the castle that it was because the true queen hated her."},{"spoiler":false,"text":"But Julia herself doesn't think that her life in the tower is unfortunate at all, she spends her days leisurely with her animal friends working on her sewing."}],"source":"vndb","sourceCharacterId":"c43763"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7954d7cc907cc9e4678219bbe2471585bb0005a988295f153b015e8f8dd071e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c74a3f249a744776692cee110b9b7be3dbba5f1b2ccfbf3ba339d5998ade4d52.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c43764","characterName":"リシャルト","sourceIds":{"vndbCharacterId":"c43764"},"originalCharacterName":"リシャルト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"When other people are talking to you there are times when you want to say something back. You don't need to be humble.\""},{"spoiler":false,"text":"A white horse that was offered to the Veke Kingdom."},{"spoiler":false,"text":"The king and nobles all had high praise for his lineage, but he was stubborn and wouldn't let people ride him so he was set to be disposed of."},{"spoiler":false,"text":"On one of her once a month outings the princess Julia was allowed she saved him and he started living in the tower."},{"spoiler":false,"text":"He is greatly indebted to the protagonist for saving him, but he rarely shows those feelings."}],"source":"vndb","sourceCharacterId":"c43764"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f99a495d5822dc69c6ac0cb523b7c2a2cba5b796619e89c2436006716a3d53b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/053e372316da3ddd6d8e0e489ad6a496e1954a3e6320df2e071225c39ad025bd.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部 順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68133","source":"vndb"}]},{"characterId":"char_vndb_c43765","characterName":"ルドヴィク","sourceIds":{"vndbCharacterId":"c43765"},"originalCharacterName":"ルドヴィク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Princess! Can I do anything for you!? I'll do anything if it's for your sake. You don't need to hold back, give me any orders you like!\""},{"spoiler":false,"text":"A hunting dog that came to Rozum castle four years ago."},{"spoiler":false,"text":"He wasn't attached to his violent master and one time when his master was being rough with him the princess Julia saved him."},{"spoiler":false,"text":"He's quite wary and doesn't warm up to strangers, but he swore loyalty to Julia who he accepts as his new master."},{"spoiler":false,"text":"When it comes to Julia he has a bad habit to act without thinking of the consequences."}],"source":"vndb","sourceCharacterId":"c43765"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2eb1d3a14b33224d13f7e2968ccd82b2b3625ea3cec4f22badffd79834fd805.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf7c854974173446bb7eeb78a1e627ea94ec05bb8d8d6a67aa0af2d12c66d01b.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日野 聡","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68134","source":"vndb"}]},{"characterId":"char_vndb_c43766","characterName":"ミアーシュ","sourceIds":{"vndbCharacterId":"c43766"},"originalCharacterName":"ミアーシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Yay! Food Food~! What kind of flavors do human foods have? I'll enjoy this!\""},{"spoiler":false,"text":"A canary that was attacked by wild animals and collapsed inside the grounds of Rozum castle. There he was saved by the princess Julia."},{"spoiler":false,"text":"Even after his injuries healed and he was able to fly again he stayed by Julia's side."},{"spoiler":false,"text":"He's naive, but always making a fuss, he easily opens up to anyone."},{"spoiler":false,"text":"His favorite things are singing and boiled eggs."}],"source":"vndb","sourceCharacterId":"c43766"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01239b21d45a000757a3ca808d2a1e9e05be5e1e5a0bce74a71ca1792649f51d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a441ac6b7e4d9c5df4a23e3e54800014b4e3186006a6ca40ecc545b7a5eecd4.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"代永 翼","creatorId":"vndb:s291","sourcePersonId":"vndb:s291","canonicalEntityId":"vndb:s291","name":"代永 翼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68136","source":"vndb"}]},{"characterId":"char_vndb_c43767","characterName":"ユゼフ","sourceIds":{"vndbCharacterId":"c43767"},"originalCharacterName":"ユゼフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm... so glad that I became a human. Now I can be of help to you, if only a little.\""},{"spoiler":false,"text":"A bear that ended up lost inside the grounds of Rozum castle after he got separated from his mother at a young age."},{"spoiler":false,"text":"When he was about to be killed by the soldiers of the castle he was saved by Julia."},{"spoiler":false,"text":"Since he was raised by her since he was young he adores Julia like his own mother."},{"spoiler":false,"text":"Contrary to his appearance he is a kind person who hates violence. But when he is cornered he shows his true strength and goes into berserk mode."},{"spoiler":false,"text":"He loves dark confined spaces and has a special skill to eat even rotten food without getting sick."}],"source":"vndb","sourceCharacterId":"c43767"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e99da9c9c25d1db2f899d6c080b31de0c28cc6431428cdda6581a4157d06cecb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bce0403fa2de92fc6197180b44b2241e11446273e8dcfd0e139ba6a86b8860bb.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽多野 渉","creatorId":"vndb:s60","sourcePersonId":"vndb:s60","canonicalEntityId":"vndb:s60","name":"春野風","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68132","source":"vndb"}]},{"characterId":"char_vndb_c45761","characterName":"ヘンリク","sourceIds":{"vndbCharacterId":"c45761"},"originalCharacterName":"ヘンリク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"...Ah, you are truly as kind as an angel. I must give you a hug for our reunion.\""},{"spoiler":false,"text":"The son of Hubert who killed the king and queen of Veke."},{"spoiler":false,"text":"He's the protagonist's older cousin, but he thinks of her like a true younger sister that he adores."},{"spoiler":false,"text":"He received training by Hubert in order to become king, but he understands that if you don't understand the common people that your assets and political power cant solve anything."},{"spoiler":false,"text":"For some reason he was transformed into a swan."}],"source":"vndb","sourceCharacterId":"c45761"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c5a644faca4a6bb81f4aa0c69b8c48e1fad38faa92a2204379d711de79e61fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/994d9c37f1ede4a19e2f7418e55b40c7bb0cab3741f69e9fddb11ceca87fc8fc.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 良平","creatorId":"vndb:s382","sourcePersonId":"vndb:s382","canonicalEntityId":"vndb:s382","name":"木村 良平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68137","source":"vndb"}]},{"characterId":"char_vndb_c45762","characterName":"魔術師","sourceIds":{"vndbCharacterId":"c45762"},"originalCharacterName":"魔術師","characterNameSource":null,"role":"primary","status":"source-only-candid