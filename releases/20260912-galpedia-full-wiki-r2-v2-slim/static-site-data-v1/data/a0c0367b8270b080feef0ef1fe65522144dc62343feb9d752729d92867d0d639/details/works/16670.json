{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"16670","model":{"presentationWorkId":"egs:16670","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"岸田メル","creatorId":"egs:creator:29993","sourcePersonId":"egs:creator:29993","canonicalEntityId":"egs:creator:29993","name":"岸田メル","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"alias-only-review","relationId":"egs:work-creator:181925","source":"egs"}]},"cast":[{"characterId":"char_bangumi_198253","characterName":"Hom","sourceIds":{"bangumi":[{"characterId":"198253","match":"source-roster","subjectId":"19494"},{"characterId":"198253","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"Hom","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"142"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ロロナの従者。身長：142cm。この身長は背が低い事を気にしているクーデリアをからかうため、アストリッドがわざとクーデリアより少しだけ大きく作った。"},{"spoiler":false,"text":"寡黙で無表情だが、ロロナやアストリッドの命令には忠実に従い、そつなくこなす。幼い外見の割に、大人びた口調で話す。実はアストリッドが作り出した、世にも珍しいホムンクルスの成功例である。"},{"spoiler":false,"text":"なお、性別はホム誕生の少し前のイベントで選択可能であり、その際のロロナの回答によって決定される。アストリッドからロロナの弟（妹）となっているが、ホムはロロナを「マスター」と呼ぶ為、あまり姉弟（姉妹）という感じではない。運動能力と知能は、ロロナを遥かに上回るらしい。一人称は男女共に「ホム」。"}],"source":"bangumi","sourceCharacterId":"198253"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbfb660141d3c6ca6c1d94f11e04caaa4136e4efd7d7dbb7ccca49dbfc2be034.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/673e9c7fb3a7d552747e00786d82289b342a92390a170faf805564ce2712a81a.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城アイラ","creatorId":"vndb:s512","sourcePersonId":"vndb:s512","canonicalEntityId":"vndb:s512","name":"結城 アイラ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:198253:5873:1","source":"bangumi"}]},{"characterId":"char_bangumi_218071","characterName":"フアナ","sourceIds":{"bangumi":[{"characterId":"218071","match":"source-roster","subjectId":"19494"}]},"originalCharacterName":"フアナ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アールズの露店雑貨屋を一人で切り盛りしている。"},{"spoiler":false,"text":"細かいことは気にしない性格で、メルルとは友人の間柄。"}],"source":"bangumi","sourceCharacterId":"218071"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e17a56ea05afd377e121701fd6d4963353aaee26b0ea152a0ec7143d8c64318.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/779867a882ac50efba8b702697f088c48c7d0c2e550fbb2915ff85762aa2a3b2.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林沙苗","creatorId":"vndb:s479","sourcePersonId":"vndb:s479","canonicalEntityId":"vndb:s479","name":"小林沙苗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:218071:4428:1","source":"bangumi"}]},{"characterId":"char_bangumi_218072","characterName":"ジオ","sourceIds":{"bangumi":[{"characterId":"218072","match":"source-roster","subjectId":"19494"}]},"originalCharacterName":"ジオ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アーランド共和国国主で大陸最強の剣士。"},{"spoiler":false,"text":"相変わらずの放浪癖だが、最近はアールズ付近を拠点に活動中。"}],"source":"bangumi","sourceCharacterId":"218072"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/494301914f614aa522ac64a2dcee22c4934bafabc8074f25cf00573bd46d6495.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3a60fee571cf2c99cd99b1785696d67fb4a8cf3abf4ed3c470689fe7b535c88.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大塚明夫","creatorId":"vndb:s1085","sourcePersonId":"vndb:s1085","canonicalEntityId":"vndb:s1085","name":"大塚 明夫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:218072:3832:1","source":"bangumi"}]},{"characterId":"char_bangumi_36074","characterName":"帕梅拉·伊碧斯","sourceIds":{"bangumi":[{"characterId":"36074","match":"source-roster","subjectId":"11436"},{"characterId":"36074","match":"source-roster","subjectId":"138202"},{"characterId":"36074","match":"source-roster","subjectId":"19494"},{"characterId":"36074","match":"source-roster","subjectId":"2250"},{"characterId":"36074","match":"source-roster","subjectId":"249447"},{"characterId":"36074","match":"source-roster","subjectId":"283338"},{"characterId":"36074","match":"source-roster","subjectId":"310881"},{"characterId":"36074","match":"source-roster","subjectId":"41265"},{"characterId":"36074","match":"source-roster","subjectId":"41271"},{"characterId":"36074","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"帕梅拉·伊碧斯","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"工作室系列的吉祥物之一。"},{"spoiler":false,"text":"在不同的世界观下，身世、性格稍有不同。"},{"spoiler":false,"text":"--------------------------------------------------"},{"spoiler":false,"text":"A4"},{"spoiler":false,"text":"最早登场是在メッテルブルグ宿屋的某房间，是在那里住了几十年的幽灵。以前那个房间因为有幽灵的传说，所以没人敢住。不过，后来尤蒂入住其中，并告诉大家帕梅拉并不是什么可怕东西的事实，于是那个房间又变得格外受欢迎了起来。"},{"spoiler":false,"text":"A5"},{"spoiler":false,"text":"25年后，原来的幽灵房间要事先预约也变得非常困难。但随着尤蒂回到自己的时代之后，帕梅拉渐渐开始有些觉得寂寞了，表情也没有以前看起来那么快乐。她也正在寻找新的朋友。"},{"spoiler":false,"text":"A6"},{"spoiler":false,"text":"アレーキア洞窟封印龙的祭品，后来成为幽灵后住过下水道、古堡、图书馆……虽然遇见过炼金很多代主角了、经历过很多冒险了，不过总是失忆的特性使得她仍如小白一般单纯天真。"},{"spoiler":false,"text":"A9"},{"spoiler":false,"text":"资料馆的幽灵，以惊吓学生为乐，剧情中加入了主角维恩所在的炼金工房，曾和现任校长是同学。"},{"spoiler":false,"text":"拥有该作最强技能，而且使用门槛很低。"},{"spoiler":false,"text":"A11"},{"spoiler":false,"text":"ロロナが拾ったクマのヌイグルミに宿っていた幽霊。悲壮感を感じさせないおっとりとした性格で後に自分のお店「パメラ屋さん」をオーブンする。"},{"spoiler":false,"text":"A12"},{"spoiler":false,"text":"トトリが住むアランヤ村にあるパメラ屋さんの店主。"},{"spoiler":false,"text":"何年か前にアーランドからやって来て、気づいたら店を開いていた。"},{"spoiler":false,"text":"のんびりぽや～っとした性格で、あまり物事を深く考えたりしない。"},{"spoiler":false,"text":"お店の管理もちゃんとできているのか、やや怪しいところがある。"},{"spoiler":false,"text":"見た目は若いが、年齢は不詳。"},{"spoiler":false,"text":"どうやら昔のことはあまり覚えていないらしい。"},{"spoiler":false,"text":"A13"},{"spoiler":false,"text":"经营量贩店，DLC可加入为战斗角色。"},{"spoiler":false,"text":"A17"},{"spoiler":false,"text":"教会のシスター。"},{"spoiler":false,"text":"おっとり、ほんわかとした性格。"},{"spoiler":false,"text":"常に間延びした口調でしゃべり、周囲を無意識に和ませる。"},{"spoiler":false,"text":"教会の仕事をほぼ一人で切り盛りしている他、街の子供たちを預かる託児所を開いているなど、わりと働き屋。"},{"spoiler":false,"text":"街の老人に対しても子供のように接するなど、彼女の年齢は謎。"},{"spoiler":false,"text":"A18"},{"spoiler":false,"text":"為了修女研修，離開家鄉基爾亨‧貝爾，出來旅行的修女。"},{"spoiler":false,"text":"但是在結束修女的培訓之後，因為買了太多土產導致盤纏都花完的關係，她不得不在萊森貝格經營店鋪工作賺錢。"},{"spoiler":false,"text":"總是從容不迫，也令人摸不著頭緒的個性。"},{"spoiler":false,"text":"A19"},{"spoiler":false,"text":"キルヘン・ベルでシスターを務めていた女性。今はヴェーニュ教会で、グレースとともにシスターの仕事に励んでいる。"},{"spoiler":false,"text":"キルヘン・ベルに戻るはずがなぜかメルヴェイユ行きの馬車に乗ってしまい、今は故郷に帰ることを目標に路銀を貯めている。"},{"spoiler":false,"text":"ぽわわんとした性格で、シスターとしての実力もある、教会でもかなりの人気者。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"在亚尔兹经营【帕梅拉的店】的女性。"},{"spoiler":false,"text":"因为个性温和又带着轻飘飘的感觉，让她的店成为亚尔兹的观光景点之一。似乎是萝乐娜的旧识。"},{"spoiler":false,"text":"A21"},{"spoiler":false,"text":"在库肯港初次登场。主线剧情后期，帕梅拉会作为旅行者在库肯港出现，并伴随一系列相关的支线任务。"},{"spoiler":false,"text":"A22"},{"spoiler":false,"text":"本作在王都初次登场。带着大量布丁，想把布丁推广到全世界。 机缘巧合加入了朵拉莉亚“盗贼”团，帮助盗贼团找到装满金币的宝箱分给了穷人们，盗贼团也帮助了帕梅拉推广布丁的愿望。"}],"source":"bangumi","sourceCharacterId":"36074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2304ac8c4bcdb34ff998c6c80281fdb7c6fa967e31baa0fc9baf2219a49d3c1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc34afc0557da8bf2a66c4a771137c06db970ca0d77810b85834ceeddb1208e.webp","width":187,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷井あすか","creatorId":"vndb:s657","sourcePersonId":"vndb:s657","canonicalEntityId":"vndb:s657","name":"谷井 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:36074:4593:1","source":"bangumi"}]},{"characterId":"char_bangumi_49541","characterName":"Rorolina Frixell","sourceIds":{"bangumi":[{"characterId":"49541","match":"source-roster","subjectId":"11436"},{"characterId":"49541","match":"source-roster","subjectId":"19494"},{"characterId":"49541","match":"source-roster","subjectId":"2250"},{"characterId":"49541","match":"source-roster","subjectId":"249447"}]},"originalCharacterName":"Rorolina Frixell","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"148"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A11　　14歳"},{"spoiler":false,"text":"本作的主角，突然被师傅强迫而接下经营炼金工房重任的少女，时而迷糊还少根筋的的新人炼金术士。通称：“萝洛娜”（ロロナ）"},{"spoiler":false,"text":"受到亚斯特丽德帮助，治疗了罹患流行病的双亲，却没钱付医药费，而以成为亚斯特丽德的弟子兼打杂小妹来代替还钱。"},{"spoiler":false,"text":"A12　　22歳"},{"spoiler":false,"text":"前作の主人公。基本的な性格は変わっていないが、色んな経験を積んで、精神的に大分逞しくなっている。"},{"spoiler":false,"text":"弟子の可愛がり方とかには、師匠成分も少々入っている。"},{"spoiler":false,"text":"あれからしばらく、錬金術士としてアーランドで活躍した後、色んな人に錬金術を教えるために各地を旅して周っている。"},{"spoiler":false,"text":"ついでに、ホムをつれてどこかに逃げてしまった師匠を探している。"},{"spoiler":false,"text":"A13　　??歳"},{"spoiler":false,"text":"前々作の主人公にしてトトリの錬金術の先生。"},{"spoiler":false,"text":"性格は相も変わらず、天然で抜けていてトトリが大好き。"},{"spoiler":false,"text":"しかし錬金術に関しては理屈で説明できない天才的な才能を持っている。"},{"spoiler":false,"text":"物語の冒頭、アールズを錬金術で発展させるために、ジオに頼まれて派遣されるはずだったが、突然横槍が入りアーランドに留まることになった。"},{"spoiler":false,"text":"その後アールズを訪れた時には、既にこの姿となっていた。"},{"spoiler":false,"text":"その理由は、未だ明らかにされていない…。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"アーランドの中でもトップクラスの実力をもつ錬金術士。ただ錬金術を独自のぐるぐる理論で理解しているため、人に教えるのは苦手。ルルアのお母さんではあるが、錬金術についてはピアニャに任せている。"},{"spoiler":false,"text":"仕事で各地を転々としており、大事なときにいない。"},{"spoiler":false,"text":"パイへの情熱は未だ衰えを知らず、今も日々、"},{"spoiler":false,"text":"より美味しく珍しいパイを作るべく奮闘している。"}],"source":"bangumi","sourceCharacterId":"49541"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"49541","value":"炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c541e92bde2c4d12e49bd731a24dc103f57bb0c4d4c3f5baae7b7fbad85474e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b44c6f8d34fa14fb1027e0736f5767bcc7c2e241b2a8fc1947883c841e8aa6d.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"門脇舞以","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"門脇 舞以","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:49541:4402:1","source":"bangumi"}]},{"characterId":"char_bangumi_49542","characterName":"库迪利亚·冯·费尔巴哈","sourceIds":{"bangumi":[{"characterId":"49542","match":"source-roster","subjectId":"11436"},{"characterId":"49542","match":"source-roster","subjectId":"19494"},{"characterId":"49542","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"库迪利亚·冯·费尔巴哈","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"139.8"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"罗洛娜儿时的玩伴，被罗洛娜亲切的称为「小库」。以前经常来工房找罗洛娜玩，不过总是会对罗洛娜说教，然后找借口照顾她（醉翁之意不在酒）。在《罗罗娜的工作室》中作为可参战人物登场，而《托托莉的工作室》中不知道什么原因当起了阿兰德冒险者协会的接待员工作（家道中落），全权负责冒险者资格的办理手续，每天都忙于工作中。虽然过了三年但除了年龄各方面都没什么成长的样子——性格也和过去一样易怒并且不够率直，被周围的人看来依旧像个小孩子（尤其是身高）——但是多少给人了一点可靠的感觉。"}],"source":"bangumi","sourceCharacterId":"49542"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db73013bb64266075952235bb5420f33d33e8de3cbc6c4da3cd9f7735161d022.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38a0ebfe2383abd9a00e876923ed15f2a7f70cb1d6fa1e45e3bd3b60af28cf2b.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:49542:4251:1","source":"bangumi"}]},{"characterId":"char_bangumi_59698","characterName":"ハゲル","sourceIds":{"bangumi":[{"characterId":"59698","match":"source-roster","subjectId":"11436"},{"characterId":"59698","match":"source-roster","subjectId":"19494"},{"characterId":"59698","match":"source-roster","subjectId":"2250"},{"characterId":"59698","match":"source-roster","subjectId":"24106"},{"characterId":"59698","match":"source-roster","subjectId":"28755"},{"characterId":"59698","match":"source-roster","subjectId":"41259"},{"characterId":"59698","match":"source-roster","subjectId":"41271"},{"characterId":"59698","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"ハゲル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"190"}},"descriptions":[{"segments":[{"spoiler":false,"text":"工作室系列中多次登场的秃头铁匠。"},{"spoiler":false,"text":"在不同的世界观中都很在意自己的秃头。"},{"spoiler":false,"text":"--------------------------------------------------"},{"spoiler":false,"text":"A19　　43歳"},{"spoiler":false,"text":"メルヴェイユで鍛冶屋を営んでいる大柄な男性。その名のとおり、頭頂部は光り輝いている。"},{"spoiler":false,"text":"代々鍛冶屋を生業とする家系で、自らの鍛冶屋を守っていくことにかけては並々ならぬ情熱を注いでいる。"},{"spoiler":false,"text":"陽気で気の良い性格をしており、その名物っぷりは観光ガイドブックにも載るほどである。"}],"source":"bangumi","sourceCharacterId":"59698"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"59698","value":"铁匠"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee4837113b5bf8050b2792d9d9974fb1b119caf50aec519e469167df306d887a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fbf71ce9d57dbf5cca0bea4b28df2233fe85c137c92674d4751caf65de0e7fe.webp","width":132,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立木文彦","creatorId":"vndb:s1943","sourcePersonId":"vndb:s1943","canonicalEntityId":"vndb:s1943","name":"立木 文彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:59698:4112:1","source":"bangumi"}]},{"characterId":"char_bangumi_61666","characterName":"托托莉","sourceIds":{"bangumi":[{"characterId":"61666","match":"source-roster","subjectId":"11436"},{"characterId":"61666","match":"source-roster","subjectId":"19494"},{"characterId":"61666","match":"source-roster","subjectId":"249447"}]},"originalCharacterName":"托托莉","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A12　　13歳"},{"spoiler":false,"text":"物語の主人公。生まれつき内気で気弱な性格だったが、錬金術を始めてから多少自分に自信がついたのか、じょじょに改善されつつある。"},{"spoiler":false,"text":"アーランドの外れにある漁村で、姉、父と三人で暮らしている。"},{"spoiler":false,"text":"母親は凄腕の冒険者として名を馳せていたが、数年前より行方不明。"},{"spoiler":false,"text":"いつかは自分も母と同じ冒険者になって色んなところを旅したり、母親を探しに行きたいと思っている。"},{"spoiler":false,"text":"A13　　19歳"},{"spoiler":false,"text":"母親探しの旅を経て、一流の錬金術士へと成長した前作の主人公。アーランドではそれなりに名の知れた存在になっている。"},{"spoiler":false,"text":"当初、発展事業の一環としてロロナがアールズに行く予定だったが、急きょ代理として派遣されることになった。"},{"spoiler":false,"text":"相変わらず、悪気の無い厳しいツッコミは健在だが、最近は自分でも気をつけるようにしているらしい。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"ロロナの弟子である錬金術士。錬金術の腕前はロロナに並ぶほどで、アーランドでも屈指の実力者。ピアニャとは実の姉妹のように仲が良く、共に錬金術を世界に広める活動を行っている。"},{"spoiler":false,"text":"昔から無自覚に毒舌を発することが多かったが、最近はだいぶ気にしているようだ。"}],"source":"bangumi","sourceCharacterId":"61666"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"61666","value":"炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/849d7f12d7e2ba43b8f1f41d827d6de2b89fb8ddc41426fd1a9969a13544af27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88bda2ae83adfde0420945b2fcc84f64687d17a1b4711a3bee3d5ab020764e50.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"名塚佳織","creatorId":"vndb:s2232","sourcePersonId":"vndb:s2232","canonicalEntityId":"vndb:s2232","name":"名塚佳織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:61666:3922:1","source":"bangumi"}]},{"characterId":"char_bangumi_63733","characterName":"咪咪","sourceIds":{"bangumi":[{"characterId":"63733","match":"source-roster","subjectId":"11436"},{"characterId":"63733","match":"source-roster","subjectId":"19494"},{"characterId":"63733","match":"source-roster","subjectId":"249447"}]},"originalCharacterName":"咪咪","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A12　　14歳"},{"spoiler":false,"text":"アーランドのとある名家のお嬢様。自分の家名、生まれに誇りを持っているが、近年のアーランドでは、古臭い価値観として扱われている。"},{"spoiler":false,"text":"それが我慢ならず、自分の名を国中に響かせてやろうと決意し、冒険者となる。"},{"spoiler":false,"text":"プライドが高く高飛車で、人を見下したような態度をとるが、実際は努力家で卑怯なことは嫌いという実直な性格。他人を寄せ付けず孤高に生きてきたので、主人公にふと友達とか言われるとおろおろ戸惑ってしまう。"},{"spoiler":false,"text":"A13　　20歳"},{"spoiler":false,"text":"ギルドの冒険者でトトリの親友。"},{"spoiler":false,"text":"トトリが派遣されて残された後、あとを追うようにやって来る。"},{"spoiler":false,"text":"冒険者として様々な経験を積み、かなりの腕前に成長している。性格は、普段は淑女の皮を被るくらいにはなっているが、トトリの話になるとすぐに化けの皮がはがれる。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"トトリの護衛を務めている女性。冒険者の中でも有数の実力者で、彼女の槍術の腕前はアーランドで1、2を争うほど。一緒に旅をしていたトトリとは親友同士で、ミミにとってトトリはかけがえのない人。"},{"spoiler":false,"text":"元々貴族の出身ということもあり、プライドの高い勝気な性格。"}],"source":"bangumi","sourceCharacterId":"63733"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"63733","value":"冒险家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe2677aaef65d024e66b7535ee2541e9bb569780f67591d4c5007a6b9b481c49.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e201e846c42707f4e4b4691ad241f57c5f64aae955d3ea7c0e5b3e55d845373.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井口裕香","creatorId":"vndb:s3971","sourcePersonId":"vndb:s3971","canonicalEntityId":"vndb:s3971","name":"井口 裕香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:63733:4851:1","source":"bangumi"}]},{"characterId":"char_bangumi_68543","characterName":"史特尔布鲁克·库拉哈","sourceIds":{"bangumi":[{"characterId":"68543","match":"source-roster","subjectId":"11436"},{"characterId":"68543","match":"source-roster","subjectId":"19494"},{"characterId":"68543","match":"source-roster","subjectId":"2250"},{"characterId":"68543","match":"source-roster","subjectId":"249447"}]},"originalCharacterName":"史特尔布鲁克·库拉哈","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A11　　25歳"},{"spoiler":false,"text":"アーランド王国に仕える騎士。剣の腕が立つ真面目な青年だが不器用で口数が少ない為怖い人と思われている。ロロナに王国依頼を出す窓口役兼、保護者のような立場でもある。"},{"spoiler":false,"text":"A12　　33歳"},{"spoiler":false,"text":"相変わらず生真面目で苦労性。"},{"spoiler":false,"text":"前作からの五年で色々あったので、顔つきが更に不機嫌で怖くなっているが、中身はまったく変わってない。（ちょっと愚痴が多くなった程度）"},{"spoiler":false,"text":"アーランドが共和国になったため、今は正式な騎士ではなくなっている。"},{"spoiler":false,"text":"無責任に国をほったらかしてどこかに消えた前国王を探して、各地を旅して周っている。"},{"spoiler":false,"text":"その先々で新米冒険者の救出やら尻拭いやらをついついしているので、なんだかんだで冒険者の現場監督のような認識をされている。"},{"spoiler":false,"text":"A13　　39歳"},{"spoiler":false,"text":"アーランドの元騎士で自称騎士。冒険者たちの現場監督的立場を続けており、放浪する元王を追い続ける。"},{"spoiler":false,"text":"アールズではメルル姫に出会うことで、騎士熱が再燃する。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"かつてアーランド王国で騎士を務めていた男性。現在はアーランド全域の警備を仕事とする『警備団』の団長を務め、各地を転々としている。"},{"spoiler":false,"text":"堅物かつ真面目な人物で自己を律しようとする気持ちが強い。しかし心の奥底には熱いものが渦巻いており、時としてその感情が表出することも。"}],"source":"bangumi","sourceCharacterId":"68543"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"68543","value":"警备团团长"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/284bd851a733362156794599c80cadda593af94a1c7fb779ee21a91a62d26563.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/876a62afee353f92481802402f16dde145c9b2ad20a11af208d322eb72e5dbfd.webp","width":152,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小杉十郎太","creatorId":"vndb:s743","sourcePersonId":"vndb:s743","canonicalEntityId":"vndb:s743","name":"小杉 十郎太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:68543:4302:1","source":"bangumi"}]},{"characterId":"char_bangumi_69108","characterName":"Merurulince Rede Arls","sourceIds":{"bangumi":[{"characterId":"69108","match":"source-roster","subjectId":"19494"},{"characterId":"69108","match":"source-roster","subjectId":"249447"}]},"originalCharacterName":"Merurulince Rede Arls","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A13　　15歳"},{"spoiler":false,"text":"アールズ王国の姫で、トトリの押し掛け弟子。"},{"spoiler":false,"text":"性格は明るく前向きで、考えるより先に行動しがち。"},{"spoiler":false,"text":"都会のアーランドに憧れているが、自国を豊かにしたいという気持ちもあり、錬金術で開拓事業に乗り出す。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"かつてのアールズ王国の姫。『メルルのアトリエ ～アーランドの錬金術士３～』では、アールズ王国をアーランド共和国に合併するにふさわしい場所とすべく、錬金術を使って奮闘した。"},{"spoiler":false,"text":"現在はその大役を終えて、自由に各地を旅している。もともと天真爛漫だったが、姫の責務から解放されてさらに拍車がかかった様子。"}],"source":"bangumi","sourceCharacterId":"69108"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"69108","value":"炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b67a11a4ee9eb05ed235296c31c4bbfe9a8c1344367509aabd7d7b995c2973a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/076e63ad247fdd353914616d7103f8377873ba44fd6b6b06ddd627ff193c7d4b.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"明坂聡美","creatorId":"vndb:s5177","sourcePersonId":"vndb:s5177","canonicalEntityId":"vndb:s5177","name":"明坂 聡美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:69108:4698:1","source":"bangumi"}]},{"characterId":"char_bangumi_69109","characterName":"Kaena Swaya","sourceIds":{"bangumi":[{"characterId":"69109","match":"source-roster","subjectId":"19494"}]},"originalCharacterName":"Kaena Swaya","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A13　　14歳"},{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"メイドと侍女の中間のようなことをしている。"},{"spoiler":false,"text":"メルルお付きの世話係。幼馴染でもあり無二の親友。"},{"spoiler":false,"text":"いつも振り回されている分、しっかり者。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"メルルの幼馴染であり、元お世話係。現在はアールズの役人となり役場を取り仕切っている。また、お世話係時代に鍛えられた戦闘能力は今も健在という噂。"},{"spoiler":false,"text":"メルルと一緒により良いアールズを作っていきたいと思い、精一杯仕事に取り組んでいる。"}],"source":"bangumi","sourceCharacterId":"69109"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"69109","value":"公务员"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97dff6f2da351c213f33e5ba7c4449c46233cb7d8b87a2e5af556b747680be66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f06474d9463bb7bb89e470da074743adca5290f5df670e7dc46a7437d4bab951.webp","width":101,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_78193","characterName":"ティファナ・ヒルデブランド","sourceIds":{"bangumi":[{"characterId":"78193","match":"source-roster","subjectId":"11436"},{"characterId":"78193","match":"source-roster","subjectId":"19494"},{"characterId":"78193","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"ティファナ・ヒルデブランド","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"31"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"}},"descriptions":[{"segments":[{"spoiler":false,"text":"阿兰德某杂货店店主。很多年前这还是一所夫妻店，后来自从丈夫辞世后就变成了她独自一人打理小店所有的事情。作为一个寡妇总给人以红颜薄命的体弱美人的感觉，虽然年过而立但是相貌依旧美丽可爱。在城里的男性之中人气高涨，店内时常是大叔云集。本人的性格很和善，生意也做得很红火。,PS：雖然個性和善，但喝醉酒之后发酒疯是很厉害的……,,声优与菲丽·艾哈特是同一人（都是大垣理香。当然不看声优表很难听出）。"}],"source":"bangumi","sourceCharacterId":"78193"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cddce338a76acab34f27815051a0ee518eba5602d5d0f290d958c421c364772c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9efbee8da03c6bb251a358d52449b04bf3e5fd246fca552aae9e8b6dfc08849e.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大垣理香","creatorId":"vndb:s2986","sourcePersonId":"vndb:s2986","canonicalEntityId":"vndb:s2986","name":"大垣 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:78193:19056:1","source":"bangumi"}]},{"characterId":"char_bangumi_78194","characterName":"エスティ・エアハルト","sourceIds":{"bangumi":[{"characterId":"78194","match":"source-roster","subjectId":"11436"},{"characterId":"78194","match":"source-roster","subjectId":"19494"},{"characterId":"78194","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"エスティ・エアハルト","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"165"}},"descriptions":[{"segments":[{"spoiler":false,"text":"最早登场于《罗罗娜的工作室》，是一个非常努力工作的冒险者公会的接待员，也是个非常善良并乐于助人的好人。但随着故事的发展，艾斯蒂害怕自己再也嫁不出去的恐惧与日俱增，终于在《托托莉的工作室》（快奔三）剧情开始前夕，辞去了工作满大陆寻找她那命中注定但不知是否存在的丈夫去了，接待员的工作则由她的妹妹接任。,在《梅露露的工作室》中，已经40岁的艾斯蒂似乎已经放弃了结婚的念头，并专注于她的事业。但她本人显然闷闷不乐，尤其是喝醉酒的时候，经常对妹妹大吐苦水。,不过听闻了罗罗娜制做了返老还童药水后，重燃了希望？,"}],"source":"bangumi","sourceCharacterId":"78194"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64ba4eae9a4d6263d6e39cc0c086ed9172fada565ee521dfc761380469d8a663.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a337fa43f82ffe1e9409752ad2f0113cb198f865aec1f738a5e777c91e99569a.webp","width":174,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤利奈","creatorId":"vndb:s360","sourcePersonId":"vndb:s360","canonicalEntityId":"vndb:s360","name":"佐藤 利奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:78194:4670:1","source":"bangumi"}]},{"characterId":"char_bangumi_78195","characterName":"アストリッド・ゼクセス","sourceIds":{"bangumi":[{"characterId":"78195","match":"source-roster","subjectId":"11436"},{"characterId":"78195","match":"source-roster","subjectId":"19494"},{"characterId":"78195","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"アストリッド・ゼクセス","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"40"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"162"}},"descriptions":[{"segments":[{"spoiler":false,"text":"阿兰德系列最伟大的炼金师，也是罗罗娜的老师。虽然被称为一个极端的天才，但因为她的懒惰和刻薄以及诡秘，更多的人视她为魔女，在阿兰德王国算得上是臭名昭著。,阿斯特里德曾经有一个极其敬爱的老师，不过那个人并没有多少炼金天赋，因此被人们看不起，之后更是被辞退，在失业后不久死去。至此阿斯特里德开始仇视大多数人，尽管拥有极强的炼金能力，她也只会接自己感兴趣的工作。,阿斯特里德曾在几年前医治过罗罗娜的父母，并收罗罗娜为徒。但是阿斯特里德无疑是个差劲的老师，睡觉+调戏罗罗娜成为了她的主要活动，炼金术方面基本上只丢给罗罗娜一些书和笔记让她自学，为日后罗罗娜独有的“罗罗娜式教学法”埋下了伏笔。不过在《新*罗罗娜的工作室》里面，必须承认，大老师带着罗罗娜去湖边踏青真是goodjob！,在《罗罗娜的工作室》剧情开始后，见习骑士斯特克前来传达阿斯特里德工房将被关闭的消息。对此并不上心的阿斯特里德当即拍板决定——阿斯特里德工房改名罗罗娜工房，之后的一系列业绩审查任务也都由罗罗娜全权负责，结果刚刚得到工房的主角就不得不为拯救自己的工房而东奔西走，大老师则是充分发挥其尖锐的观察力，谋定而动恶意围观。不过为了弥补罗罗娜没有妖精帮忙的短板，大老师制造了人造人“霍姆”来帮助罗罗娜收集材料（在《托托莉的工作室》中罗罗娜则用同样的技术制造了小人造人“吉姆”来收集复制材料），在炼金术士大赛（剧情结束）后，阿斯特里德带着霍姆前往了她老师的故乡阿鲁兹王国开了家炼金术商店。,PS：为了刺激罗罗娜的好姬友库迪利亚，霍姆的身高为142cm，仅比库迪利亚高2cm，因此当罗罗娜制造出身高仅有60cm的吉姆时……感动ing,《梅露露的工作室》中，罗罗娜找到了12年未曾谋面的恩师和霍姆。此时恰逢阿斯特里德在研究青春药水，于是师徒两人一起试验，但后喝下药水的罗罗娜却产生了副作用，原本打算恢复成14岁的身体缩水到了8岁，闹得众人还得研究青春药水的反向药水——成长药水"}],"source":"bangumi","sourceCharacterId":"78195"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25099885b3273dcfc1b1fb621bbcc5b1201e76e51034109be29d4d2313107613.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44ce3e6630f2d32ef38ea690ad58501c591bd9bec21b639c6c3f3fdde092acd0.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中敦子","creatorId":"vndb:s78","sourcePersonId":"vndb:s78","canonicalEntityId":"vndb:s78","name":"田中 敦子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:78195:3873:1","source":"bangumi"}]},{"characterId":"char_bangumi_78212","characterName":"ツェツィーリア・ヘルモルト","sourceIds":{"bangumi":[{"characterId":"78212","match":"source-roster","subjectId":"11436"},{"characterId":"78212","match":"source-roster","subjectId":"19494"}]},"originalCharacterName":"ツェツィーリア・ヘルモルト","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"18"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"156"}},"descriptions":[{"segments":[{"spoiler":false,"text":"托托莉的姐姐，代替外出冒险一去不回的母亲操持全部家务的坚强少女（父亲生活懒散不检点，在女儿们心目中没啥地位并且存在感稀薄，甚至到了在家一天却根本不被孩子们发现的情况也屡次发生，是个没什么工作成天在家呆着的大人）。待人认真，很喜欢自己的妹妹，相对的也经常为妹妹操心而对妹妹说教。不过在训完妹妹以后看到她垂头丧气的样子自己也会很失落。总之她们吵起架来就像小孩子拌嘴一样，并且一闹别扭就是好几天（汗）…对于妹妹要成为冒险者这件事情不怎么支持，但还是提供了活动经费；虽然总是对妹妹炼金引起爆炸而不满，但打扫卫生的都是她。确定，发现妹控一枚、傲娇一只！,被托托莉的青梅竹马基诺的哥哥、舒适屋的伙计裴达暗恋着，不过因为运气太差又害羞，“背时鬼”裴达总是没有合适的机会提升好感，反而被塞希误会裴达其实讨厌自己。,在村子里有巨大的人气，因此在去古兰鲁特先生的酒店当服务生以后，酒店也开始变得有客人了……,高端绅士级妹控，在托托莉为办理冒险者资格证而坐裴达的破马车前往阿兰德的第10天起就天天发挥自己优秀的厨艺做美食等着妹妹回家，为了妹妹连父亲都可以顶撞。（喂，就算是好马车也要跑两星期的路，裴达的破马车怎么可能做得到！）,拿手料理：母亲基萨拉教的《蒸鱼派》，后来也教给了托托莉。,托托莉：怎、怎么了呢、姐姐？一直盯着我看……,塞希：嗯，重新看了遍，这衣服真可爱啊。,托托莉：谢、谢谢……那个，但是为什么这么生气的表情呀？,塞希：因为这衣服不是我做的。最近托托莉酱几乎不穿我做的衣服。,托托莉：这是，因为炼金术士一定要穿这种衣服，老师说的……但是，姐姐也说过很可爱啊，这不就行了吗？,塞希：可爱只是多余的后悔而已。哼！总有一天我一定会做出比这更可爱的衣服！,托托莉（叹气）：结果还是不知道姐姐为什么生气，看来还是偶尔穿穿别的衣服比较好。"}],"source":"bangumi","sourceCharacterId":"78212"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df85dc1044b30c8caf024a799337c507a9888022c4c56996703add960814bb46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c58ca50c738de57469e554b50fb5cac97a299a53be708ced6a49d9fc3896383.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今井麻美","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:78212:4061:1","source":"bangumi"}]},{"characterId":"char_bangumi_78213","characterName":"小姆","sourceIds":{"bangumi":[{"characterId":"78213","match":"source-roster","subjectId":"11436"},{"characterId":"78213","match":"source-roster","subjectId":"19494"},{"characterId":"78213","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"小姆","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"0"},"height":{"reviewState":"source-only","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"罗罗娜瞒着托托莉偷偷制造的人造人自动组装装置“小人造人来来”的产品，不过和学园都市的饮料机一样，吞了材料后不工作，必须用力敲打，然后就会掉落一地的人造人易拉罐……,同罗罗娜那位师傅制作的人造人的不同点在于不会说话只会叫“吉姆”，相对的表情就比较丰富了。不过这些小鬼头是不是能充分领会主人的意图这是一个问题（汗）。食物就是派，吃不到的话就会丧失干劲，真正的nopies,no gains。,制造材料需要用到一种神秘的人造人生命之元……游戏中一共可以拥有5只吉姆，算是替代以前工房作品中的小精灵来帮助玩家收集材料。,PS：身高139.8cm的库酱对吉姆酱的身高很满意，感动得都哭了— —！,PS2：在制作人造人之前，罗罗娜会问托托莉喜欢的是男孩子还是女孩子，这直接关系到第一只吉姆的性别。,A20中长大的小姆是托托莉让小姆们成长，作为小姆战队的一员支援各地的炼金术士，A20中琵亚妮雅的小姆叫小姆龙。小姆龙称呼托托莉为大主人(Grand Master)，琵亚妮雅为主人，露露亚为小小主人(Nano Master)。长大后会说话并逐渐获得情感的小姆们十分尊敬托托莉，除了她命名的品味，以及仍然喜欢吃派。,,"}],"source":"bangumi","sourceCharacterId":"78213"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d09d44ca5953605b941e43391fa1c643479c1a70895582ef17115119ad20111e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/672f0291ff0042da42d2e323f3cab01d18f78f8943d751ddc8acdb9e3bc7f573.webp","width":179,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_78214","characterName":"ジーノ・クナープ","sourceIds":{"bangumi":[{"characterId":"78214","match":"source-roster","subjectId":"11436"},{"characterId":"78214","match":"source-roster","subjectId":"19494"}]},"originalCharacterName":"ジーノ・クナープ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"}},"descriptions":[],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"78214","value":"冒险者"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37002598125e61cd450596b40fe2485b2c6a02e647dedea0ab2de0c01c1bc27c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/968d8e287d24c22bc86d3137dae80d2acfce0a4c8759b9ed5da6cd22e8570214.webp","width":164,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三瓶由布子","creatorId":"vndb:s952","sourcePersonId":"vndb:s952","canonicalEntityId":"vndb:s952","name":"三瓶 由布子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:78214:4667:1","source":"bangumi"}]},{"characterId":"char_bangumi_78390","characterName":"Filly Erhard","sourceIds":{"bangumi":[{"characterId":"78390","match":"source-roster","subjectId":"11436"},{"characterId":"78390","match":"source-roster","subjectId":"19494"},{"characterId":"78390","match":"source-roster","subjectId":"2250"}]},"originalCharacterName":"Filly Erhard","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"156"}},"descriptions":[{"segments":[{"spoiler":false,"text":"《罗罗娜的工作室》中的接待员艾斯蒂的妹妹，因为挺中意接待员工作的姐姐辞掉工作为了寻找丈夫出去旅行了而被迫继承了她的工作。从相貌上看和她的姐姐也几乎没什么分别，甚至和她姐姐一样喜欢打探别人的桃色新闻。不过性格就差很多了，刚开始工作时（21岁）因为自身怕生胆小，工作上经常犯错，给外人的感觉就是工作比较勉强不怎么认真。经过六年锻炼后，现在已经不再害羞了，工作方面也有了很大进步，在《梅露露的工作室》中还陪同托托莉一起转战阿鲁兹王国。不过喜爱妄想的个性却愈演愈烈，不管什么都能作为妄想的题材……,有很强的妄想癖。只要看到两个人——尤其是两个女孩子在交谈，都会幻想她们是在谈情说爱（百合妄想）。,"}],"source":"bangumi","sourceCharacterId":"78390"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70e525e4e327b35d91bfc4b1588ac8b5bf557ce3eb206db0a6b9f3dfbcef0687.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41702a8fa81f5a947d91770335c011558748460c9bb0bcdd7a3af9cf17a694cf.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大垣理香","creatorId":"vndb:s2986","sourcePersonId":"vndb:s2986","canonicalEntityId":"vndb:s2986","name":"大垣 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:78390:19056:1","source":"bangumi"}]},{"characterId":"char_bangumi_78434","characterName":"ルーフェス・フォールケン","sourceIds":{"bangumi":[{"characterId":"78434","match":"source-roster","subjectId":"19494"}]},"originalCharacterName":"ルーフェス・フォールケン","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"25"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"185"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在阿鲁兹王国担任管家一职。,非常有才干，上至执政管理，,下至梅露露的家教等数个工作。,对此梅露露感到他带来的压力是巨大的，,同时也是一个很难应付的管家,没有过度地保护梅露露，但对梅露露非常严格,牵扯到钱的问题会很唠叨，性格死板，,为人外表沉着冷静，但很少表达自己的感情。,"}],"source":"bangumi","sourceCharacterId":"78434"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"78434","value":"管家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/6102cbdabfd30be99331cd1c743f5ae3d08c7602b16a8f6eddb1ddf159589c3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42a5672ef3049a8bd3abfe4cd7e47788bca589de0d5b81647eb052d5295d53ac.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"子安武人","creatorId":"vndb:s10","sourcePersonId":"vndb:s10","canonicalEntityId":"vndb:s10","name":"子安 武人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:78434:1096:1","source":"bangumi"}]},{"characterId":"char_bangumi_78435","characterName":"ライアス・フォールケン","sourceIds":{"bangumi":[{"characterId":"78435","match":"source-roster","subjectId":"19494"}]},"originalCharacterName":"ライアス・フォールケン","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"16"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"173"}},"descriptions":[{"segments":[{"spoiler":false,"text":"此人讨厌蘑菇,在阿鲁兹王国担任城门守卫一职。,非常崇拜哥哥鲁菲斯，,但是并不是知道哥哥对梅露露的事情很在意。,因此，非常嫉妒梅露露甚至都忘了梅露露是公主，,但又不得不接受兄长的委托成为梅露露的保护人"}],"source":"bangumi","sourceCharacterId":"78435"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"78435","value":"守卫"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93da0abcc956466a9b0774f93016f98f724d7c37377d576a86d2f23b1e299ad1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29b307a77a0982bed5d36d71e0ff7dde466c9cc45f6bb62f71e814f3c163d011.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"市来光弘","creatorId":"vndb:s959","sourcePersonId":"vndb:s959","canonicalEntityId":"vndb:s959","name":"市来 光弘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19494:78435:4480:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p910","sourceCompanyId":"egs:brand:766","canonicalEntityId":"vndb:p910","name":"ガスト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:16670:766","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
