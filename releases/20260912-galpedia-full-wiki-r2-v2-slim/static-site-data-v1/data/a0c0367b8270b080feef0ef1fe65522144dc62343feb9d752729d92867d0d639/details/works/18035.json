idth":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"姫川 あいり","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51009","source":"vndb"}]},{"characterId":"char_vndb_c21008","characterName":"七瀬 理々奈","sourceIds":{"vndbCharacterId":"c21008"},"originalCharacterName":"七瀬 理々奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"99"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"I"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Brotherly term of endearment: \"Nii-san\""},{"spoiler":false,"text":"The daughter of Souichirou and Rio. She’s loudmouthed, but also caring."},{"spoiler":false,"text":"A studious girl, Ririna takes charge both at school and in the home, acting to organize the rest of the siblings. Germophobic and hateful toward men, she’s frequently harsh on her slovenly and perverted elder brother."},{"spoiler":false,"text":"Her typical reaction to hearing a dirty joke is to deliver a swift kick to its teller. Despite all her complaints, she can’t bring herself to hate her brother, and deep down, she truly loves him."},{"spoiler":false,"text":"As Ririna cannot outwardly condone sexual behavior, she must make absolutely sure nobody ever finds out about her masturbation habit."}],"source":"vndb","sourceCharacterId":"c21008"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aac8def23