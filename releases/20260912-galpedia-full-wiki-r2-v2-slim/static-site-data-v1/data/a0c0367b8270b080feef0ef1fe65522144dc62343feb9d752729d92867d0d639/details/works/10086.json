:null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼少時から拓都の事を慕っていた少女。"},{"spoiler":false,"text":"「誠心誠意のご奉仕」がモットーで、拓都のためならどんなことでも……な、一途で献身的なメイド。"},{"spoiler":false,"text":"「えっと……その、私と拓都さんだけの秘密、ということでいいですか？」"}],"source":"egs","sourceCharacterId":"19112","sourceWorkId":"10086","spoiler":false},{"segments":[{"spoiler":false,"text":"幼き日から主人公を慕う少女。"},{"spoiler":false,"text":"誠心誠意のご奉仕がモットーの癒し系。"},{"spoiler":false,"text":"拓都のためならどんなことも……な、"},{"spoiler":false,"text":"一途＆完璧な献身メイドさん。"},{"spoiler":false,"text":"「えっと……その、私と拓都さんだけの秘密、"},{"spoiler":false,"text":"ということでいいですか？」"}],"source":"bangumi","sourceCharacterId":"66820"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91fa59ae7332217a9af6b783c374b966e6d4742824a0b11fbd4576aa1e51ce6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb9ba857dabdffe25fc458de8c5e4b408065682b896cdc0c0e832bae62a656d6.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:264298:66820:6349:1","source":"bangumi"}]},{"characterId":"char_c49908","characterName":"戸鳩 茉莉菜","sourceIds":{"bangumi":[{"characterId":"66821","match":"exact-normalized-name-in-linked-work","subjectId":"264298"}],"egsCharacterIds":["19113"],"vndbCharacterId":"c49908"},"originalCharacterName":"戸鳩 茉莉菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"親しみやすくて頼りになるお姉さまタイプのメイド。"},{"spoiler":false,"text":"ウィンクが似合う大人の魅力溢れる彼女だが、内面は照れ屋で、三人の中で一番の“女の子”だったり。"},{"spoiler":false,"text":"「あ、あの……そういうことは面と向かって言わないでください。反応に困ります」"}],"source":"egs","sourceCharacterId":"19113","sourceWorkId":"10086","spoiler":false},{"segments":[{"spoiler":false,"text":"親しみやすく頼りになる、大人の魅力に溢れた女性。"},{"spoiler":false,"text":"ウインクが似合う、かしましお姉さまだが、"},{"spoiler":false,"text":"素顔は照れ屋で一番の“女の子”である……"},{"spoiler":false,"text":"「あ、あの……そういうことは面と"},{"spoiler":false,"text":"向かって言わないでください。反応に困ります」"}],"source":"bangumi","sourceCharacterId":"66821"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a51e8eb091af79ee66b5057fddf1612698bd462c9e54deb74880b49751f3e8ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90bac5ee0fe3d9312ef9e9a5cb33c230b2b0495adad677a743eeb117b3558c88.webp","width":108,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永井ちひろ","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"逢川奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:264298:66821:18652:1","source":"bangumi"}]},{"characterId":"char_c49909","characterName":"とばり","sourceIds":{"bangumi":[{"characterId":"66822","match":"exact-normalized-name-in-linked-work","subjectId":"264298"}],"egsCharacterIds":["19114"],"vndbCharacterId":"c49909"},"originalCharacterName":"とばり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無口で不思議系な女の子で、会計担当の天才頭脳派メイド。"},{"spoiler":false,"text":"意外と人情に厚く、拓都と息の合うところも。"},{"spoiler":false,"text":"「がんばー」"}],"source":"egs","sourceCharacterId":"19114","sourceWorkId":"10086","spoiler":false},{"segments":[{"spoiler":false,"text":"放っておけない無口不思議系女の子。"},{"spoiler":false,"text":"会計担当の頭脳派メイドさんである。"},{"spoiler":false,"text":"意外と義理人情には厚く、そういうところは拓都と息があう。"},{"spoiler":false,"text":"「がんばー」"}],"source":"bangumi","sourceCharacterId":"66822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0de546e76ae21adfa0ac1a66042b491744fd621f63bb1f63550c0d372af7618e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c414c84c883840db24b06e1ab78003e2e52e754b224e077338b5357b16b086c.webp","width":102,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:264298:66822:4956:1","source":"bangumi"}]},{"characterId":"char_c49910","characterName":"藍沢 美瓶子","sourceIds":{"bangumi":[{"characterId":"66823","match":"exact-normalized-name-in-linked-work","subjectId":"264298"}],"egsCharacterIds":["19115"],"vndbCharacterId":"c49910"},"originalCharacterName":"藍沢 美瓶子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"親友の妹で、お節介焼きの少女。"},{"spoiler":false,"text":"実家は小さな家具屋だが、自分は社長令嬢だと豪語する、外見と自称だけの「お嬢様」"},{"spoiler":false,"text":"なぜか拓都のそばを離れたがらず、自らもメイドに……？"},{"spoiler":false,"text":"「魅力というものは、自分を卑下するほどに逃げていくものですわよ？」"}],"source":"egs","sourceCharacterId":"19115","sourceWorkId":"10086","spoiler":false},{"segments":[{"spoiler":false,"text":"親友の妹で、通称『カメ子』。"},{"spoiler":false,"text":"外見だけが『お嬢様』な、おせっかい焼き少女である。"},{"spoiler":false,"text":"実家は小さな家具屋さんだが、『自分は社長令嬢』と豪語する。"},{"spoiler":false,"text":"悪気はなく、些細なことは考えない。"},{"spoiler":false,"text":"目立ちたがり屋の愛すべきトラブルメーカーだが、"},{"spoiler":fals