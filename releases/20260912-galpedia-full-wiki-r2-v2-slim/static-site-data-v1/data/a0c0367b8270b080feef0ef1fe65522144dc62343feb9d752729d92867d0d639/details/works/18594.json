{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18594","model":{"presentationWorkId":"vndb:v12434","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c4037","characterName":"朝宮 静姫","sourceIds":{"bangumi":[{"characterId":"30975","match":"exact-normalized-name-in-linked-work","subjectId":"128057"},{"characterId":"30975","match":"exact-normalized-name-in-linked-work","subjectId":"222169"}],"egsCharacterIds":["268"],"vndbCharacterId":"c4037"},"originalCharacterName":"朝宮 静姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大人しくて気弱な学生。"},{"spoiler":false,"text":"清楚で可憐な乙女という雰囲気を出しており、それなりに見栄えはよい。"},{"spoiler":false,"text":"ただ押しに弱く、強く頼まれると断る事が出来ない。"},{"spoiler":false,"text":"――肛虐好き"},{"spoiler":false,"text":"以前座***を入れたときに感じていまい、それ以来アナルに興味が出てくる。"},{"spoiler":false,"text":"嫌悪感もあるがやめられず、自慰の時はつい触ってしまう。"}],"source":"egs","sourceCharacterId":"268","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"『肛虐願望の少女』のヒロイン。"},{"spoiler":false,"text":"ア○ルが敏感な女子学生。"},{"spoiler":false,"text":"普段は、おっとりしていて人当たりがよく、彼女が○ナルフェチであることを誰も知らない。"},{"spoiler":false,"text":"酷い風邪で座薬を使用したとき、朦朧とする意識の中で、アナ○に吸い込まれた座薬の快感に酔ってしまい、それが覚醒に繋がった。"}],"source":"egs","sourceCharacterId":"268","sourceWorkId":"9797","spoiler":false},{"segments":[{"spoiler":false,"text":"学生・ヒロイン。"},{"spoiler":false,"text":"主人公と同じ学園の学生で同級生。"},{"spoiler":false,"text":"おっとりとしており、どちらかというと天然系である。"},{"spoiler":false,"text":"そんな見かけによらず、学年で１・２を争う才女である。"},{"spoiler":false,"text":"交友関係も人気も学園でもトップクラスである。"},{"spoiler":false,"text":"ひたむきな主人公のことが大好きで、彼女から告白した。"},{"spoiler":false,"text":"付き合い始めて半年ほどが経過する。"},{"spoiler":false,"text":"主人公の様子がおかしいことに気がつきながらも強く指摘できない押しの弱さがある。"}],"source":"egs","sourceCharacterId":"268","sourceWorkId":"18594","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の生徒で、気弱そうな女の子。大人しくて、押しに弱い。"},{"spoiler":false,"text":"実はアナルに興味があり、座薬を入れたときに感じてしまう。 それ以来、自慰の時にはつい触ってしまう。嫌悪もあるのだが、やめられない。"}],"source":"bangumi","sourceCharacterId":"30975"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2d6fbc0cc0727be9671828ac1b94d2ea0be8029348f4804583ea1113d56384a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da7f9406d3d0fb70a19dec3399969404e658a79b176bd2922e15524f9036afac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"霧島 はるな","creatorId":"vndb:s2698","sourcePersonId":"vndb:s2698","canonicalEntityId":"vndb:s2698","name":"霧島はるな(水無月じゅん)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:52652","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p826","sourceCompanyId":"egs:brand:1885","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18594:1885","source":"egs"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30812:v12434","source":"vndb"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:81006:v12434",