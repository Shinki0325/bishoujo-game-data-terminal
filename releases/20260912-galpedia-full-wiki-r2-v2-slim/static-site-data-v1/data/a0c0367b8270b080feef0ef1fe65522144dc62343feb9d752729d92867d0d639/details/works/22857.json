"vndb:s2434","sourcePersonId":"vndb:s2434","canonicalEntityId":"vndb:s2434","name":"華憐","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:126613","source":"vndb"},{"creditedName":"華憐","creatorId":"vndb:s2434","sourcePersonId":"vndb:s2434","canonicalEntityId":"vndb:s2434","name":"華憐","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126614","source":"vndb"},{"creditedName":"gram6design","creatorId":"vndb:s4347","sourcePersonId":"vndb:s4347","canonicalEntityId":"vndb:s4347","name":"gram6design","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126617","source":"vndb"}]},"cast":[{"characterId":"char_c41384","characterName":"西原 代歩","sourceIds":{"bangumi":[{"characterId":"37876","match":"exact-normalized-name-in-linked-work","subjectId":"155757"}],"egsCharacterIds":["7895"],"vndbCharacterId":"c41384"},"originalCharacterName":"西原 代歩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Shoujo manga (loves a lot), okonomiyaki, yakisoba, shopping, cooking"},{"spoiler":false,"text":"Dislikes: Drunk people, insects in general"},{"spoiler":false,"text":"Kazuya's childhood friend and classmate who is a member of the Intergender Relations Normalization Committee. Kaho has liked Kazuya for a long time but cannot tell him because she's a typical childhood friend tsundere girl who thinks he can't get anything done without her. Having good grades, good skills at all kinds of housework and attractive looks, she's popular with the other male students."}],"source":"vndb","sourceCharacterId":"c41384"},{"segments":[{"spoiler":false,"text":"昔から主人公が好きだが幼馴染みツンデレなので言い出せない。周囲の雰囲気でさらに言いづらくなっている。"},{"spoiler":false,"text":"主人公と幼馴染みであるという理由で、女子の男女交際正常化委員に抜擢される。一応、男女対立に対し親交派筆頭。"},{"spoiler":false,"text":"家はすぐ近所で主人公の家にも勝手に上がり込むも、周囲にはあくまでも幼馴染としてであり、恋人ではないとツンデレ。"},{"spoiler":false,"text":"主人公の前でこそツンデレ化して舞い上がるも、基本的に女らしく気配りも出来る常識人。成績・家事能力はそこそこ。"},{"spoiler":false,"text":"奈々緒とは親友同士で仲良しだが、クラスの女王様気取りの璃歌とは口論が絶えず喧嘩友達。"}],"source":"egs","sourceCharacterId":"7895","sourceWorkId":"22857","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、幼なじみの女の子。 成績も家事もそこそこ。"},{"spoiler":false,"text":"主人公の幼なじみだからと男女交際正常化委員に抜擢され、一応は親交派の筆頭。"},{"spoiler":false,"text":"昔から主人公が好きだけど、今の状況とツンデレな性格が邪魔をして言い出せずにいる。"},{"spoiler":false,"text":"基本的には女の子らしく気配りも出来る常識人だが、"},{"spoiler":false,"text":"主人公の前だと舞い上がってツンデレをこじらせてしまうことがしばしば。"},{"spoiler":false,"text":"家がすぐ近所で勝手に上がり込む仲だけど、周囲には 「あくまで幼なじみ」 と言い張っている。"},{"spoiler":false,"text":"奈々緒とは親友同士。 女王様気取りの璃歌とは口論が絶えないケンカ友達。"},{"spoiler":false,"text":"「わ、わたしはやっぱり、告白は男の子にしてもらいたいし、そうでないとイヤ……かも」"}],"source":"bangumi","sourceCharacterId":"37876"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"37876","value":"少女漫画（恋愛もの）、お好み焼き＆ソース焼きそば、買い物、料理"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"37876","value":"酔っ払い、虫全般（特にイニシャルG）"},{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"7895","sourceWorkId":"22857","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"7895","sourceWorkId":"22857","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"7895","sourceWorkId":"22857","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"7895","sourceWorkId":"22857","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6fd20334ef91862b8135cb31fc07c2b2b16c09f3e764c1cecf2218392daf6a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad20256655c4e49a9c8c7086300af2be73b2620fd0bf1118d9c3aacc42e02ec7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米山有佳子","creatorId":"vndb:s3866","sourcePersonId":"vndb:s3866","canonicalEntityId":"vndb:s3866","name":"米山 有佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155757:37876:19139:1","source":"bangumi"}]},{"characterId":"char_c41385","characterName":"舞原 雪菜","sourceIds":{"bangumi":[{"characterId":"37877","match":"exact-normalized-name-in-linked-work","subjectId":"155757"}],"egsCharacterIds":["7896"],"vndbCharacterId":"c41385"},"originalCharacterName":"舞原 雪菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Cooking and eating dumplings, miscellaneous trivia"},{"spoiler":false,"text":"Dislikes: Sleazy men, umeboshi (doesn't really like sour food)"},{"spoiler":false,"text":"The class president of Kazuya's class who is also a member of the Intergender Relations Normalization Committee. Though she acts like a leader, takes everything seriously and has a tendency to aim for perfection, she is completely neutral to whether guys and girls get along or not. In reality, Yukina only became the class president and a member of the committee to avoid trouble with a girl who was jealous of her. Her family runs a coffee shop, and Yukina works part-time there as well. She is also best friends with Moegi."}],"source":"vndb","sourceCharacterId":"c41385"},{"segments":[{"spoiler":false,"text":"クラス委員長で学業優秀な美人。なりゆき女子のリーダー格として男女対立派の旗振り役。実家は喫茶店経営。"},{"spoiler":false,"text":"集団時は女の子達の代表としてキツい事も言うが、対立派女子達の代弁的な要素が強く、本人は正直男女対立には無関心。"},{"spoiler":false,"text":"実のところ、美人で学業優秀という点が女子の一部の嫉妬を買い、面倒事として委員長を押しつけられているのだが、合理主義者である故に「やる気のない人にだらだらやらせるよりマシ」「波風立てずに引き受けた方が面倒が無い」と、割り切っているイメージ。何事も引き受けたからには完璧にこなすが、もちろん彼女の責任感と努力の賜。"}],"source":"egs","sourceCharacterId":"7896","sourceWorkId":"22857","spoiler":false},{"segments":[{"spoiler":false,"text":"学業優秀なクラスの委員長。 女子のリーダー格で、対立派の旗振り役。"},{"spoiler":false,"text":"女子代表としてキツいことも言うが、実は代弁的な要素が強く、本人は男女対立に無関心。"},{"spoiler":false,"text":"実のところ、対立派もクラス委員長も、彼女に嫉妬した女子から面倒事を押しつけられただけ。"},{"spoiler":false,"text":"“やる気のない人にやらせるよりマシ”、“波風立てないほうが楽” と割り切っている。"},{"spoiler":false,"text":"そして持ち前の責任感から、何事も引き受けたからには努力して完璧にこなす。"},{"spoiler":false,"text":"実家は喫茶店を経営している。"},{"spoiler":false,"text":"「クラス女子代表として、あなたたちに申し伝えることがあります。 異議は後ほど受け付けますので、まずは発言を禁止します」"}],"source":"bangumi","sourceCharacterId":"37877"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"37877","value":"餃子作り、餃子の食べ歩き、雑学トリビア"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"37877","value":"だらしない男、梅干し（酸っぱいのはあまり好きじゃない）"},{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"7896","sourceWorkId":"22857","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"7896","sourceWorkId":"22857","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"7896","sourceWorkId":"22857","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"7896","sourceWorkId":"22857","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2834c6f89ae0e732472b363426f4cce4c162b973300369503778a398d66f918.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/948b84768ea10f7dbf4ae78d0012eb11fb7bfc316a9011ab33aa77d213731913.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村桜","creatorId":"vndb:s3644","sourcePersonId":"vndb:s3644","canonicalEntityId":"vndb:s3644","name":"中村 桜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155757:37877:16171:1","source":"bangumi"}]},{"characterId":"char_c41386","characterName":"高杉 奈々緒","sourceIds":{"bangumi":[{"characterId":"37878","match":"exact-normalized-name-in-linked-work","subjectId":"155757"}],"egsCharacterIds":["7897"],"vndbCharacterId":"c41386"},"originalCharacterName":"高杉 奈々緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Candy, karaoke, games, manga, tonkotsu ramen"},{"spoiler":false,"text":"Dislikes: Raw peppers, menstruation, bras"},{"spoiler":false,"text":"Kaho's energetic best friend and Kazuya's classmate who is also a member of the Intergender Relations Normalization Committee. She has both an older and a younger brother so she's used to being around guys, and as a result can stay chill and crack perverted jokes together with them. Due to this she is popular with the other male students, however she has turned down every guy who has confessed to her."}],"source":"vndb","sourceCharacterId":"c41386"},{"segments":[{"spoiler":false,"text":"代歩の親友で、気さくで気っ風のいいハイテンション娘。いわゆるギャグ担当で、奇っ怪な行動に走る事しばし。"},{"spoiler":false,"text":"兄と弟に挟まれている上に、共学経験者（高２の春に転入している）なので、男女対立に関しては中立派。"},{"spoiler":false,"text":"他の男子にも挨拶くらいはするので、勘違いされ告られまくるが「ゴメンね」を連発する、自称「魔性の女」。"},{"spoiler":false,"text":"兄弟がアニメヲタク＆ゲームヲタクで、当人も自然と染まり男子と平気でヲタ談義する程に。ネットにも詳しく、ＶＩＰネタも通じる。"},{"spoiler":false,"text":"少女漫画に興味は無く、むしろ二次元美少女萌え（が百合では無い）で、ギャルゲ＆エロゲ共に有名タイトルは一通りこなす。"}],"source":"egs","sourceCharacterId":"7897","sourceWorkId":"22857","spoiler":false},{"segments":[{"spoiler":false,"text":"代歩の親友でクラスメイト。 気さくで気風の良いハイテンション娘。"},{"spoiler":false,"text":"いわゆるギャグ担当で、奇っ怪な行動に走ることしばしば。"},{"spoiler":false,"text":"兄と弟がいるうえに共学経験者なので、男女対立に関しては中立派。"},{"spoiler":false,"text":"兄弟がアニメ＆ゲームヲタクで、当人も自然と染まり男子と平気でヲタ談義するほど。"},{"spoiler":false,"text":"ネットにも詳しく、VIPネタも通じる。"},{"spoiler":false,"text":"男子にも挨拶をするので、勘違いされて告られては 「ゴメンね」 を連発する、自称・魔性の女。"},{"spoiler":false,"text":"二次元美少女萌え（百合ではない）で、有名な ギャルゲ＆エロゲ は一通りこなす。"},{"spoiler":false,"text":"「気付いたら兄貴たちのエロ本があちこちに隠してあったし、憶えちゃったのも早かったな～」"}],"source":"bangumi","sourceCharacterId":"37878"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"37878","value":"駄菓子、カラオケ、ゲーム、マンガ、とんこつラーメン"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"37878","value":"生のピーマン、生理、ブラジャー"},{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"7897","sourceWorkId":"22857","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"7897","sourceWorkId":"22857","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"