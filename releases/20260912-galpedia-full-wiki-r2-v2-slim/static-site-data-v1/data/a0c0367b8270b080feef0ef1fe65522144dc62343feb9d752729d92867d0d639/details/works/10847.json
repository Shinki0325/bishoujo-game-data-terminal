 小枝","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12578","source":"vndb"},{"creditedName":"MeeK","creatorId":"vndb:s35139","sourcePersonId":"vndb:s35139","canonicalEntityId":"vndb:s35139","name":"MeeK","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12580","source":"vndb"},{"creditedName":"モリト ミキト","creatorId":"vndb:s39323","sourcePersonId":"vndb:s39323","canonicalEntityId":"vndb:s39323","name":"モリト ミキト","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12581","source":"vndb"}]},"cast":[{"characterId":"char_c1549","characterName":"小石川 小羽","sourceIds":{"bangumi":[{"characterId":"118885","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18189"],"vndbCharacterId":"c1549"},"originalCharacterName":"小石川 小羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"114"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A shy but kind angel girl, Kohane trusts everyone without reserve. She's also a member of the student council."}],"source":"vndb","sourceCharacterId":"c1549"},{"segments":[{"spoiler":false,"text":"【Episode02】"},{"spoiler":false,"text":"生徒会役員を務める天使の羽を持った女の子。"},{"spoiler":false,"text":"自分の願いよりも相手の願いを叶えることを優先してしまう優しい性格の小羽。"},{"spoiler":false,"text":"そんな天使のような彼女も、主人公・光樹の前ではひとりの女の子に戻ることができる。"},{"spoiler":false,"text":"それは、光樹が頼っていい存在だから。自分だけの――恋人だから。"},{"spoiler":false,"text":"天使学校編入辞退の騒動の後、小羽は誰にも言えなかった将来の夢を誰よりも信頼する光樹にだけ話しだす。"},{"spoiler":false,"text":"「私も――光樹さんの顔を見ているだけで、幸せな気持ちになれます」"}],"source":"egs","sourceCharacterId":"18189","sourceWorkId":"10847","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"18189","sourceWorkId":"10847","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"39 kg","valueContext":null,"source":"egs","sourceCharacterId":"18189","sourceWorkId":"10847","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01da81d3aa433e83cdca09a236d2f86220e82c5dce28239c81b16d1fe214603c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d45830849cd685c23bf6677cf87edf7f2fe227d0cd86fa8fefbd631dc283b62.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118885:5940:1","source":"bangumi"}]},{"characterId":"char_c1550","characterName":"小野寺 朝姫","sourceIds":{"bangumi":[{"characterId":"118887","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18188"],"vndbCharacterId":"c1550"},"originalCharacterName":"小野寺 朝姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"504"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【Episode01】"},{"spoiler":false,"text":"主人公・天宮光樹の幼馴染みの女の子・朝姫。"},{"spoiler":false,"text":"気が強く何かと光樹の世話を焼こうとするお姉さん気質な朝姫と光樹は、友達以上恋人未満だった関係から、すれ違いを乗り越えようやく恋人同士の関係に。"},{"spoiler":false,"text":"しかし、恋人には恋人同士なりの問題があって――"},{"spoiler":false,"text":"２人が落ち着く日はまだまだ先のことになりそう？"},{"spoiler":false,"text":"「……か、彼女としての義務よ、義務」"}],"source":"egs","sourceCharacterId":"18188","sourceWorkId":"10847","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"18188","sourceWorkId":"10847","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"??","valueContext":"原文","source":"egs","sourceCharacterId":"18188","sourceWorkId":"10847","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/836685c177843b036efeb455754750b93092bbdda8a7f4d4af8dcc464855ef0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dc3ff629d2427e9e7b2e0dab8b6059fa8172e12eeb961f8061ce9d494411382.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118887:6558:1","source":"bangumi"}]},{"characterId":"char_c1551","characterName":"弥月 美由","sourceIds":{"bangumi":[{"characterId":"118890","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18190"],"vndbCharacterId":"c1551"},"originalCharacterName":"弥月 美由","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"213"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although her timid personality and frail physique wouldn't suggest this, Miyu is the representative of Mitsuki's class. Miyu is proficient at cooking and a member of the school's Cooking Club. Due to her nature, she often ends up overworking herself. She gets on well with Asahi."},{"spoiler":false,"text":"Miyu enjoys collecting all sorts of curios, like ornamented teacups and spoons."}],"source":"vndb","sourceCharacterId":"c1551"},{"segments":[{"spoiler":false,"text":"【Episode03】"},{"spoiler":false,"text":"主人公・光樹たちのクラスの委員長を務める女の子。"},{"spoiler":false,"text":"気が弱い反面、一度こうと決めたら納得いくまで頑張ってしまう"},{"spoiler":false,"text":"一途なところがある美由は、長年の片思いの気持ちを実らせ、光樹と付き合うことに。"},{"spoiler":false,"text":"ストーカーから身を挺して護ってもらったり、さまざまな困難を乗り越えて結ばれた２人。"},{"spoiler":false,"text":"今まで以上に光樹を大好きになってしまった美由は、ある日光樹に言われた冗談を真に受けてしまい……。"},{"spoiler":false,"text":"「見ていいのは……光樹くんだけだもん……」"}],"source":"egs","sourceCharacterId":"18190","sourceWorkId":"10847","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"18190","sourceWorkId":"10847","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"37 kg","valueContext":null,"source":"egs","sourceCharacterId":"18190","sourceWorkId":"10847","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b45d5b2902bfee3cffeab16ff27e535bdc3179af54076f12f2d7969112c3f71a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/306bc6d1391457f4042642b141b108dbdea10b1198236abeef8ad2e660b2fae6.webp","width":76,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118890:4490:1","source":"bangumi"}]},{"characterId":"char_c1552","characterName":"水原 つづみ","sourceIds":{"bangumi":[{"characterId":"118886","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18192"],"vndbCharacterId":"c1552"},"originalCharacterName":"水原 つづみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious girl that transfers into Mitsuki's class. She seems completely ignorant about the most ordinary of things, constantly asking others for advice. She moves into the dormitory where Mituski lives, and starts a habit of barging into his room without asking, usually through a window."},{"spoiler":false,"text":"Tsuzumi absolutely loves ice cream and enjoys it in every chance she gets."},{"spoiler":true,"text":"Tsuzumi is actually a non-human sent on a mission to capture a wanted man."}],"source":"vndb","sourceCharacterId":"c1552"},{"segments":[{"spoiler":false,"text":"【Episode05】"},{"spoiler":false,"text":"夏の始まりとともに主人公・光樹のクラスに現れた謎の転校生。"},{"spoiler":false,"text":"任務終了後、故郷を飛び出してまで光樹の元へ戻ってきてくれたつづみ。"},{"spoiler":false,"text":"力を使い果たし小さな姿になったつづみとの秘密の同棲生活が始まって1年後――"},{"spoiler":false,"text":"つづみのとあるひと言をきっかけに、「大きくなるまで我慢」をスローガンに抑えてきた光樹のリビドーが遂に破裂する!?"},{"spoiler":false,"text":"「『とーま』でも、『えらん・えーく』でも……私は私だ。あなたが遠慮することなど、なにもない」"}],"source":"egs","sourceCharacterId":"18192","sourceWorkId":"10847","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"18192","sourceWorkId":"10847","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"18192","sourceWorkId":"10847","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/868e7f45558a61f612dc740d054cde33b582915f7c0287346a3f77b7b96c4cd8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/869f84e040c1899868416caa77cfdf80b013c2183a223e9d4e39566bc2953215.webp","width":118,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118886:4832:1","source":"bangumi"}]},{"characterId":"char_c1553","characterName":"加賀宮 鈴","sourceIds":{"bangumi":[{"characterId":"118883","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18194"],"vndbCharacterId":"c1553"},"originalCharacterName":"加賀宮 鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"327"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mitsuki's kouhai. She is often seen reading books in the library or doing work in the student council room. Rin has a brash and aburpt personality, though she acts sweetly around those she trusts. She's very close to Shigehisa's little sister, Chitose."},{"spoiler":true,"text":"Due to a heart disease, Rin has spent the majority of her life in a hospital bed, and has only recently been discharged, thus she is experiencing many things for the first time. She's also a writer under the pen name of \"Yagami Karin\"."}],"source":"vndb","sourceCharacterId":"c1553"},{"segments":[{"spoiler":false,"text":"【Episode07】"},{"spoiler":false,"text":"主人公・光樹の後輩で、生徒会を手伝う西校舎の女の子。"},{"spoiler":false,"text":"もしもあの時、違った選択をしていたら？"},{"spoiler":false,"text":"本編とは違った結末へと進む、アナザーエピソード。"},{"spoiler":false,"text":"恋愛小説を書くためのお試しの恋人関係を続けていた光樹と鈴。"},{"spoiler":false,"text":"いよいよ大詰めとなる光樹を部屋に迎えての初体験の日、高まる緊張に耐え切れなくなった鈴は急遽予定を変更、2人で学院の図書館へと行くことになったのだが…？。"},{"spoiler":false,"text":"「……あの、先輩。私と……キス、してみませんか？」"}],"source":"egs","sourceCharacterId":"18194","sourceWorkId":"10847","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"??","valueContext":"原文","source":"egs","sourceCharacterId":"18194","sourceWorkId":"10847","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"39 kg","valueContext":null,"source":"egs","sourceCharacterId":"18194","sourceWorkId":"10847","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0b25ef220690bfad83de49e246942395920105a4bcf0482ab41331453e786b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e20d6f415f0c52d2ad9201a2c6f84a865bd24e57230d776635ce59f1726a5c26.webp","width":132,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷井あすか","creatorId":"vndb:s657","sourcePersonId":"vndb:s657","canonicalEntityId":"vndb:s657","name":"谷井 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118883:4593:1","source":"bangumi"}]},{"characterId":"char_c1554","characterName":"河崎 幸奈","sourceIds":{"bangumi":[{"characterId":"118884","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18193"],"vndbCharacterId":"c1554"},"originalCharacterName":"河崎 幸奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"926"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【Episode06】"},{"spoiler":false,"text":"主人公・光樹をからかうのが大好きな元生徒会長。"},{"spoiler":false,"text":"白鳩学院始まって以来の才媛と呼ばれ、国内はもとより海外の一流大学ですら思いのままと言われていた"},{"spoiler":false,"text":"幸奈先輩の進学先は、意外にも学院と隣接する白鳩大学だった。"},{"spoiler":false,"text":"折を見ては学院に顔を出す幸奈、それを迎える小羽たち生徒会メンバー。"},{"spoiler":false,"text":"変わらない日常、でもどこか違う毎日。"},{"spoiler":false,"text":"そして光樹と幸奈の関係にも新しい変化の兆しが見え始める。"},{"spoiler":false,"text":"「……でも、そこに私がいないっていうのが、ちょっと寂しいかな……なんて」"}],"source":"egs","sourceCharacterId":"18193","sourceWorkId":"10847","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"18193","sourceWorkId":"10847","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"44 kg","valueContext":null,"source":"egs","sourceCharacterId":"18193","sourceWorkId":"10847","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/600b03c268c3d6f55d3c07f78033be85159dcca0132515e9a2146c8fdde5aaf9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9999e9e204301bc929724ec92cdd6a663732019cc27215ba4200864422192b8c.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118884:6018:1","source":"bangumi"}]},{"characterId":"char_c1555","characterName":"沢渡 琴","sourceIds":{"bangumi":[{"characterId":"118889","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18195"],"vndbCharacterId":"c1555"},"originalCharacterName":"沢渡 琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"701"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【Episode08】"},{"spoiler":false,"text":"白鳩学院の保健養護教諭にして葵の実姉。"},{"spoiler":false,"text":"琴先生の心の傷を癒し、本当の笑顔を得ることができた光樹。"},{"spoiler":false,"text":"そして2人は、先生と生徒という関係を超え、新たなるステップへと前進……しすぎていた。"},{"spoiler":false,"text":"白鳩大に進学してからもOBとして保健室に入り浸る光樹。"},{"spoiler":false,"text":"ある放課後、うっかり琴先生と初実先生の酒盛りに参加してしまった光樹が見たものとは……？"},{"spoiler":false,"text":"「違うもん、光樹くんが……誘ってきたんだもん！」"}],"source":"egs","sourceCharacterId":"18195","sourceWorkId":"10847","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"1●9","valueContext":"原文","source":"egs","sourceCharacterId":"18195","sourceWorkId":"10847","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"6 kg","valueContext":null,"source":"egs","sourceCharacterId":"18195","sourceWorkId":"10847","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a38aae0254971f42e0519d7c5c3cd919f7aa370cdce96332bc3a514d6137eaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68c3d510e6aaecabd9168740b6a84797e8b5b49517e04a74a395f7a301ede404.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118889:4714:1","source":"bangumi"}]},{"characterId":"char_c1556","characterName":"大城 千歳","sourceIds":{"bangumi":[{"characterId":"118894","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18198"],"vndbCharacterId":"c1556"},"originalCharacterName":"大城 千歳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shigehisa's younger sister. Thanks to her upbringing, she is a polite and caring girl. Chitose holds her brother in high regard, and aspires to be like him someday. She and Rin are best friends."}],"source":"vndb","sourceCharacterId":"c1556"},{"segments":[{"spoiler":false,"text":"主人公との関係：後輩、親友の妹"},{"spoiler":false,"text":"【Episode11】"},{"spoiler":false,"text":"主人公・光樹の親友・大城重久の妹。"},{"spoiler":false,"text":"引っ込み思案だけれども、優しく誰からも好かれる千歳。"},{"spoiler":false,"text":"そんな彼女の尊敬する人は、人見知りが強い自分をいつも守ってくれた兄・重久。"},{"spoiler":false,"text":"千歳は日ごろの感謝を込め、重久に秘密で誕生日プレゼントを渡す計画を立て、兄以外で唯一普通に話せる光樹に協力を求めてくる。"},{"spoiler":false,"text":"しかし、そんな事情を知らない重久は……??"},{"spoiler":false,"text":"「優しいところ、どこか兄に似てるなって。でも今は、一番――」"}],"source":"egs","sourceCharacterId":"18198","sourceWorkId":"10847","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/1639df328c731144f415ab2ae669392a3df4cd72032b5b9e9d34aad34f7b2757.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23f81b242cddd2c71f850d01d1192dc4a10d93a61d288168aaf6bfe9243f52c8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118894:6105:1","source":"bangumi"}]},{"characterId":"char_c1557","characterName":"鍋島 亜理紗","sourceIds":{"bangumi":[{"characterId":"118892","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18197"],"vndbCharacterId":"c1557"},"originalCharacterName":"鍋島 亜理紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"924"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The sister of the student council president, she is hostile to pretty much anyone (except Aoi) and holds a grudge against angels. She seems to be in love with Aoi and regularly tries to get her feelings across, but is always met with refusal."},{"spoiler":true,"text":"In reality, she and Tsunaki aren't related by blood, as she was adopted to his family."}],"source":"vndb","sourceCharacterId":"c1557"},{"segments":[{"spoiler":false,"text":"主人公との関係：後輩・葵を巡るライバル"},{"spoiler":false,"text":"【Episode10】"},{"spoiler":false,"text":"沢渡葵ラブ！　な後輩の女の子。"},{"spoiler":false,"text":"葵と仲がよい主人公・光樹が大嫌い。"},{"spoiler":false,"text":"吹奏楽部の発表会へ向け、ひとり屋上で練習に励む亜理紗。"},{"spoiler":false,"text":"そんな亜理紗の真剣な姿を偶然見掛けた光樹は、なんとなく放課後のぞきに行くことが日課となってしまう。"},{"spoiler":false,"text":"その姿に苛立ちながらも、からかうでもなく自分を見つめる光樹が気になりだす亜理紗。"},{"spoiler":false,"text":"そんな折、当の葵から2人にある提案が持ちかけられる……。"},{"spoiler":false,"text":"「初めは葵ちゃんへのあてつけだったのに……」"}],"source":"egs","sourceCharacterId":"18197","sourceWorkId":"10847","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6499214d7ed3c92c7fc70741fbd3ea65598a0e218155bfa4585395d1d8069cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58c12ebb52e98e146a277f8a07eb43ebb16c09f9112835b5accff997ac533f0c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118892:4463:1","source":"bangumi"}]},{"characterId":"char_c1558","characterName":"高坂 初実","sourceIds":{"bangumi":[{"characterId":"118891","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18196"],"vndbCharacterId":"c1558"},"originalCharacterName":"高坂 初実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公との関係：図書館の司書先生"},{"spoiler":false,"text":"【Episode09】"},{"spoiler":false,"text":"主人公・光樹がよく昼寝に使う白鳩学院併設の図書館で司書を務めるお姉さん。"},{"spoiler":false,"text":"暦の上では秋を迎えた9月、夏の盛りは過ぎたとはいえまだまだ残暑は厳しく光樹は今日も図書館へ涼みに向かう。"},{"spoiler":false,"text":"さぼりをたしなめながらもいつも微笑んでくれる初実先生。"},{"spoiler":false,"text":"いつまでもあると思っていた大切な場所。"},{"spoiler":false,"text":"しかし光樹は初実が学院を去るかもしれないということを知ってしまい…"},{"spoiler":false,"text":"「一番欲しい物は、いつだって手に入らない。だから――私は欲しがらないの」"}],"source":"egs","sourceCharacterId":"18196","sourceWorkId":"10847","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e804c7e3f3bfb35a39350b910fcba69a5ad18660f97ec5cd694ab1793049d9f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a018b6e43ea2445db8b8cb6b961d2c3d5fbb7df4f1af6c7800baf00d2f51fde3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118891:4177:1","source":"bangumi"}]},{"characterId":"char_c6899","characterName":"沢渡 葵","sourceIds":{"bangumi":[{"characterId":"118888","match":"exact-normalized-name-in-linked-work","subjectId":"183852"}],"egsCharacterIds":["18191"],"vndbCharacterId":"c6899"},"originalCharacterName":"沢渡 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1231"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aoi is one of Mitsuki's classmates and a good friend of his. She is popular with both the boys and girls of the school thanks to her outgoing personality."}],"source":"vndb","sourceCharacterId":"c6899"},{"segments":[{"spoiler":false,"text":"【Episode04】"},{"spoiler":false,"text":"主人公・光樹とは西校舎のころからの付き合いでサボり仲間。"},{"spoiler":false,"text":"ノリがよく同性異性を問わず好かれる性格の葵。"},{"spoiler":false,"text":"だけど、こと勝負事になると熱くなって自分を見失ってしまうことも。"},{"spoiler":false,"text":"親友から恋人へとその関係を変えた今も、葵のそんなはた迷惑なところは変わらない。"},{"spoiler":false,"text":"いつも巻き込まれる光樹はそんな現状を打破すべく、ある秘策を企てるのだが……？"},{"spoiler":false,"text":"「特訓？　これがいったい、なんの特訓だって言うのよ～!!」"}],"source":"egs","sourceCharacterId":"18191","sourceWorkId":"10847","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"18191","sourceWorkId":"10847","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"??","valueContext":"原文","source":"egs","sourceCharacterId":"18191","sourceWorkId":"10847","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"bloodType":[{"comparisonValue":"o","source":"vndb","sourceCharacterId":"c6899","value":"o"},{"comparisonValue":"o","source":"egs","sourceCharacterId":"18191","value":"O"},{"comparisonValue":"a","source":"bangumi","sourceCharacterId":"118888","value":"A型"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89426d37aec6cd58bccc0198490b674e4dcce9363604f38f9542d880542b8f65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee5de1cb0060ce7579072ea7aa8887d0d7942e4be00c3a95e6a6d1a59cb4d3e7.webp","width":88,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮沢ゆあな","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183852:118888:5915:1","source":"bangumi"}]},{"characterId":"char_vndb_c42250","characterName":"天宮 光樹","sourceIds":{"vndbCharacterId":"c42250"},"originalCharacterName":"天宮 光樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d51d287fcd9fe4