rceCharacterId":"5956","sourceWorkId":"21238","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で明るくやんちゃな性格。"},{"spoiler":false,"text":"猪突猛進、思い立ったら即行動。 勢い任せで主人公に猛烈アピールをかける。"},{"spoiler":false,"text":"たまに勢い余って予想外の展開になり、主人公がフォローする場面もちらほら。"}],"source":"bangumi","sourceCharacterId":"88270"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be7034af81a8cc958b426a6ba7a365fd27a85437cf4559153e7a9fe4be915016.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/805cb7640ca4f6dbb4488596ec601a38bc51cca8f08fd9501f869776980c4dc3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"英 みらい","creatorId":"vndb:s996","sourcePersonId":"vndb:s996","canonicalEntityId":"vndb:s996","name":"英みらい(大山チロル、ひつじまる)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61417","source":"vndb"}]},{"characterId":"char_c24621","characterName":"柚木 鈴音","sourceIds":{"bangumi":[{"characterId":"88271","match":"exact-normalized-name-in-linked-work","subjectId":"224142"}],"egsCharacterIds":["5957"],"vndbCharacterId":"c24621"},"originalCharacterName":"柚木 鈴音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger of the sisters, she is calm but determined. She is a very clever and manipulative girl, who pretends to be well behaved while setting up naughty events."},{"spoiler":false,"text":"She likes to push the protagonist around all whilst pretending to not know a thing just so she can get closer to him."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c24621"},{"segments":[{"spoiler":false,"text":"姉妹の妹の方、おっとりしているがしっかり者。"},{"spoiler":false,"text":"天然を装いつつえっち