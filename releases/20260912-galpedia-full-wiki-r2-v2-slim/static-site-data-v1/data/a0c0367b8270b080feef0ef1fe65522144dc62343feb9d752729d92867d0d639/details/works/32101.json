{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"32101","model":{"presentationWorkId":"egs:32101","staff":{"artwork":[{"creditedName":"KERORIN","creatorId":"egs:creator:29153","sourcePersonId":"egs:creator:29153","canonicalEntityId":"egs:creator:29153","name":"KERORIN","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:244872","source":"egs"},{"creditedName":"マカマカ","creatorId":"egs:creator:29154","sourcePersonId":"egs:creator:29154","canonicalEntityId":"egs:creator:29154","name":"マカマカ","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:244873","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_91458","characterName":"艾莉絲","sourceIds":{"bangumi":[{"characterId":"91458","match":"source-roster","subjectId":"295470"}]},"originalCharacterName":"艾莉絲","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"バル王国の第一王女。"},{"spoiler":false,"text":"3姉妹の長女で国民を守るのは王族の義務と考え、"},{"spoiler":false,"text":"日々剣術の腕を磨く。"},{"spoiler":false,"text":"バル王国はグルテル王国と一番の友好国であり主人公とは"},{"spoiler":false,"text":"幼い頃から晩餐会や狩り等で交流を深めていたが主人公の"},{"spoiler":false,"text":"女好きな行動や、国王の意思を汲み取らない姿を見て"},{"spoiler":false,"text":"落胆し、主人公とは暫く距離を置いていた。"},{"spoiler":false,"text":"父親であるバル国王から主人公と共にアイノーリを探す旅に"},{"spoiler":false,"text":"同行せよとの命を受け戸惑うが、自分が主人公を変えるという"},{"spoiler":false,"text":"強い決意を持ち共に旅を始める。"}],"source":"bangumi","sourceCharacterId":"91458"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7dc8a0924dc48e92bdbaa4d5eb86e1c9a82d7e05ca13e74557e430b82776bcc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50f3dac280e1a417a80aa4e18b01a19571ebca632e55814f3a49136b23c27ec4.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"陽向葵ゅか","creatorId":"vndb:s15712","sourcePersonId":"vndb:s15712","canonicalEntityId":"vndb:s15712","name":"陽向葵ゅか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295470:91458:34935:1","source":"bangumi"}]},{"characterId":"char_bangumi_91459","characterName":"娜迪亞","sourceIds":{"bangumi":[{"characterId":"91459","match":"source-roster","subjectId":"295470"}]},"originalCharacterName":"娜迪亞","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ルビー王国の王女。"},{"spoiler":false,"text":"国土の80%が砂漠と言うルビー王国は、グルテル王国から"},{"spoiler":false,"text":"もたらされる水と食料を無くしては存在出来ない国である。"},{"spoiler":false,"text":"その為、大陸一の貧困国ではあるがそれを感じさせない程、"},{"spoiler":false,"text":"国民は明るく、歌と踊りが国民のアイデンティティだった。"},{"spoiler":false,"text":"ナディアも歌と踊りが得意で国民みなから愛される存在である。"},{"spoiler":false,"text":"主人公とは幼い頃に晩餐会で出逢った事しかなかったが、"},{"spoiler":false,"text":"その時に主人公の優しさに触れ、密かに想いを寄せている。"},{"spoiler":false,"text":"主人公がアイノーリを探すと言う一報を受け、グルテル国王の"},{"spoiler":false,"text":"申し出より先に主人公に同行する為、ルビー王国を旅立った。"}],"source":"bangumi","sourceCharacterId":"91459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43b3c268134f631bb302f041baa73290fc6ab6db86435b02e0b0f89559700fdd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7a65f2f7e9bc4e9cfc0006a02a34515352853468604f46410f7a3f3f6628bbc.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"英みらい","creatorId":"vndb:s996","sourcePersonId":"vndb:s996","canonicalEntityId":"vndb:s996","name":"英みらい(大山チロル、ひつじまる)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295470:91459:8069:1","source":"bangumi"}]},{"characterId":"char_bangumi_91460","characterName":"蘇菲","sourceIds":{"bangumi":[{"characterId":"91460","match":"source-roster","subjectId":"295470"}]},"originalCharacterName":"蘇菲","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シーガルズ王国の王女。"},{"spoiler":false,"text":"水の都として栄えるシーガルズ王国は、ソフィーの母である"},{"spoiler":false,"text":"エミリー女王と女王を支える4人の女性神官が国を治めている。"},{"spoiler":false,"text":"とても穏やかな国民性で、争いごとは好まず常に平和であった。"},{"spoiler":false,"text":"聡明・博識で国民から次の女王へと期待されているソフィーは"},{"spoiler":false,"text":"幼少の頃グルテル王国へ1ヶ月程勉強の為に訪れた。"},{"spoiler":false,"text":"その中で主人公から幾度となく聞かされた冒険話が忘れられず"},{"spoiler":false,"text":"いつかは自身も冒険に行きたいと願っていたが、"},{"spoiler":false,"text":"叶うはずのない願いだと、その思いを胸の奥へ閉じ込めていた。"},{"spoiler":false,"text":"主人公が旅に出ると言う話を聞いた時、閉じ込めていた"},{"spoiler":false,"text":"冒険への想いがふつふつと湧き上がるのを密かに感じていた。"}],"source":"bangumi","sourceCharacterId":"91460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15746ba89b675220106a1bdfd89d07fd679e5950eea18366f1c7387fb80533fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec88aa579f0d53be656fbf22434c417d084847cc295c12fbcd9afa1f5c53a322.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和鳴るせ","creatorId":"vndb:s2143","sourcePersonId":"vndb:s2143","canonicalEntityId":"vndb:s2143","name":"和鳴 るせ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295470:91460:32794:1","source":"bangumi"}]},{"characterId":"char_bangumi_91461","characterName":"櫻花","sourceIds":{"bangumi":[{"characterId":"91461","match":"source-roster","subjectId":"295470"}]},"originalCharacterName":"櫻花","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国全体が海に囲まれた島国ゆえに"},{"spoiler":false,"text":"独自の文化を築いてきた。"},{"spoiler":false,"text":"奇妙な術を使い人々を惑わすと言う噂が他国に流れている為、"},{"spoiler":false,"text":"必要最低限以外の交流は無い。"},{"spoiler":false,"text":"サクラ自身好奇心が強く活発な性格で冒険心に溢れ"},{"spoiler":false,"text":"いつかは世界中を自らの足で回りたいと言う夢を持っている。"},{"spoiler":false,"text":"今回の旅で主人公とは初対面だが、冒険好きの主人公の事は"},{"spoiler":false,"text":"幼少の頃から知っていて、同じ価値観を持つ対象として"},{"spoiler":false,"text":"興味を持っている。"}],"source":"bangumi","sourceCharacterId":"91461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cf743c3d62690aa9e060bf4b4d6984db64a689ddf496c7723ca199e1d219cc4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12e8279386478de0ea3675a93b9891f7b8e81ca798db2d2c6ceb7fc0362d434c.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐月ユーリ","creatorId":"vndb:s18699","sourcePersonId":"vndb:s18699","canonicalEntityId":"vndb:s18699","name":"佐月ユーリ(ユーリ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295470:91461:35490:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p18133","sourceCompanyId":"egs:brand:5251","canonicalEntityId":"vndb:p18133","name":"神乳","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:32101:5251","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
