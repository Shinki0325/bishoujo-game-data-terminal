eCharacterId":"139970"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bdb159391365de239c64ecf3f28f0b5eb8fc553d7d27458eb89d56dd72fd227.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2b9a06e0a286bf758acb1eefca2e3a74a206075de76ad2845f2117a0da40999.webp","width":99,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c46674","characterName":"世葉州さん","sourceIds":{"bangumi":[{"characterId":"139971","match":"exact-normalized-name-in-linked-work","subjectId":"177698"}],"egsCharacterIds":["8613"],"vndbCharacterId":"c46674"},"originalCharacterName":"世葉州さん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"腰を痛めてうずくまっているところを真咲に助けてもらった、白髪のおじいさん。"},{"spoiler":false,"text":"その正体は、織山家に仕える執事さんだった。"},{"spoiler":false,"text":"織山家にはいまの真咲と同じくらいの歳で入り、使用人からはじめて執事まで出世した。"},{"spoiler":false,"text":"屋敷に関するすべてのことを任されており、主であるおばあちゃんの信頼は厚い。"},{"spoiler":false,"text":"執事としての実力は業界でもかなり有名で、世界各国のセレブからのオファーが絶えない。"},{"spoiler":false,"text":"しかし、本人は生涯織山家に仕えると誓いを立てているので、そのすべてを断っている。"},{"spoiler":false,"text":"非常に温厚で、普段は好々爺としての雰囲気を崩さないが、有事の際は人が変わったかのように鋭い面持ちを見せる。"},{"spoiler":false,"text":"プロフェッショナルとして自分に厳しく、主の要望には必ず応える実力とコネクションを持っている。"}],"source":"egs","sourceCharacterId":"8613","sourceWorkId":"23428","spoiler":false},{"segments":[{"spoiler":false,"text":"腰を痛めていたところを真咲に助けてもらった、白髪のおじいさん。"},{"spoiler":false,"text":"その正体は織山家に仕える執事さん。"},{"spoiler":false,"text":"屋敷に関するすべてのことを任されており、主であるおばあちゃんの信頼は厚い。"},{"spoiler":false,"text":"執事としての実力はかなり有名で、世界各国のセレブからオファーが絶えない。"},{"spoiler":false,"text":"しかし本人は生涯織山家に仕えると誓いを立てているので、そのすべてを断っている。"},{"spoiler":false,"text":"非常に温厚で、普段は好々爺としての雰囲気を崩さないが、有事の際は人が変わったかのように鋭い面持ちを見せる。"},{"spoiler":false,"text":"プロフェッショナルとして自分に厳しく、主の要望に