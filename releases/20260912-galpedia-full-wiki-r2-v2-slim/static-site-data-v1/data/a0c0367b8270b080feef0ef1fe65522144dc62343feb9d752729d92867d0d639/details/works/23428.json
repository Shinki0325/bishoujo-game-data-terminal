rce":"vndb"},{"creditedName":"灰墨 イノリ","creatorId":"vndb:s4545","sourcePersonId":"vndb:s4545","canonicalEntityId":"vndb:s4545","name":"灰墨 イノリ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:129331","source":"vndb"},{"creditedName":"灰墨 イノリ","creatorId":"vndb:s4545","sourcePersonId":"vndb:s4545","canonicalEntityId":"vndb:s4545","name":"灰墨 イノリ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129332","source":"vndb"}]},"cast":[{"characterId":"char_c45861","characterName":"月宮 明日香","sourceIds":{"bangumi":[{"characterId":"40367","match":"exact-normalized-name-in-linked-work","subjectId":"177698"}],"egsCharacterIds":["8607"],"vndbCharacterId":"c45861"},"originalCharacterName":"月宮 明日香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grand daughter of Oriyama Hanami and friend of Misaka Sumire. Not having much experience being around boys her own age has quick encounter with protagonist leaving her slightly attached to him."}],"source":"vndb","sourceCharacterId":"c45861"},{"segments":[{"spoiler":false,"text":"真咲が新しく仕える屋敷のお嬢様。"},{"spoiler":false,"text":"明るくて誰にでも優しく、自然と人が集まってくるような魅力を持っている。"},{"spoiler":false,"text":"お嬢様でありながらも飾ったところがなく、強い責任感でみんなをまとめるリーダー気質。"},{"spoiler":false,"text":"でも本人にその自覚はなかったりする。"},{"spoiler":false,"text":"紅茶が好きで、ティーセットを集めるのが趣味。"},{"spoiler":false,"text":"忙しく海外を飛び回る両親に代わって、おばあちゃんに面倒を見てもらっている。"},{"spoiler":false,"text":"幼少の頃からお嬢様学園に通っていたこともあって、同年代の男性に免疫がない。"},{"spoiler":false,"text":"新しく使用人として仕えることとなった真咲とは、最初上手く接することができなかった。"},{"spoiler":false,"text":"誰かのためには一生懸命になれるのに、自分のこととなると途端に不器用になってしまう、ピュアな乙女心の持ち主。"}],"source":"egs","sourceCharacterId":"8607","sourceWorkId":"23428","spoiler":false},{"segments":[{"spoiler":false,"text":"真咲が新しく仕えることになった屋敷のお嬢様。"},{"spoiler":false,"text":"明るく誰にでも優しく、自然と人が集まってくるような魅力を持っている。"},{"spoiler":false,"text":"お嬢様だけど飾ったところはなく、強い責任感でみんなをまとめるリーダー気質。"},{"spoiler":false,"text":"しかし本人にその自覚はなかったりする。"},{"spoiler":false,"text":"紅茶が好きで、ティーセットを集めるのが趣味。"},{"spoiler":false,"text":"忙しく海外を飛び回る両親に代わって おばあちゃんに面倒を見てもらっている。"},{"spoiler":false,"text":"幼少の頃からお嬢様学園に通っていたこともあって、同年代の男性に免疫がない。"},{"spoiler":false,"text":"そのため真咲とも最初は上手く接することができない。"},{"spoiler":false,"text":"「私が頑張ることで、誰かが笑顔になってくれるのなら、躊躇うことなんかなにもないと思う」"}],"source":"bangumi","sourceCharacterId":"40367"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"40367","value":"聖キキリア学園 2年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9afa724a105e84774c7b135b28042cd7cf293f08650efc42fe505f56f11b2739.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/745849a1a153c4e26dfbead5562b2d4521548649f3611d6fac4cc73e6e44e24a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:177698:40367:11646:1","source":"bangumi"}]},{"characterId":"char_c45862","characterName":"水坂 澄恋","sourceIds":{"bangumi":[{"characterId":"40368","match":"exact-normalized-name-in-linked-work","subjectId":"177698"}],"egsCharacterIds":["8608"],"vndbCharacterId":"c45862"},"originalCharacterName":"水坂 澄恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Friend of Tsukimiya Asuka. Is very friendly and open mind almost like a happy child happy to experience new things all the time. Went to live with Asuka and her grandmother because she wanted more freedom and less restraint."}],"source":"vndb","sourceCharacterId":"c45862"},{"segments":[{"spoiler":false,"text":"織山家に居候させてもらっている、明日香の幼なじみ。"},{"spoiler":false,"text":"父親は華道、母親が舞踊の家元という名家のお嬢様。"},{"spoiler":false,"text":"織山家とは家族ぐるみのつきあいで、両親が海外に行ってしまい寂しがっている明日香を見かねて、自ら一緒に住まわせてもらえないかとお願いした。"},{"spoiler":false,"text":"華道、舞踊のどちらも英才教育を受けており、すでに師範レベルの技術を持っている。"},{"spoiler":false,"text":"物腰は柔らかく、恥じらいを知る控えめなお嬢様。"},{"spoiler":false,"text":"学園ではいつも明日香と一緒に行動しており、なにかと頼られがちな彼女を陰ながらサポートしている。"},{"spoiler":false,"text":"舞うことが好きで、織山家に来てからも時間があれば一人で練習をしている。"},{"spoiler":false,"text":"それともう一つ、彼女には誰にも話していない趣味があったのだが、ひょんなことから真咲にそれを知られてしまう。"},{"spoiler":false,"text":"秘密の趣味は、澄恋の持つ小さな願望の現れでもあった。"},{"spoiler":false,"text":"真咲と秘密を共有できたことで、二人の距離が少しずつ縮まっていく。"},{"spoiler":false,"text":"一般的な女の子と比べると若干控えめな胸がコンプレックス。"}],"source":"egs","sourceCharacterId":"8608","sourceWorkId":"23428","spoiler":false},{"segments":[{"spoiler":false,"text":"織山家に居候させてもらっている、明日香の幼なじみ。"},{"spoiler":false,"text":"物腰は柔らかく、恥じらいを知る控えめなお嬢様。"},{"spoiler":false,"text":"父親は華道、母親が舞踊の家元という名家で、自身も師範レベルの腕前。"},{"spoiler":false,"text":"織山家とは家族ぐるみの付き合いで、両親が不在の明日香を見かねて居候を志願した。"},{"spoiler":false,"text":"学園でも明日香と一緒で、なにかと頼られがちな彼女を陰ながらサポートしている。"},{"spoiler":false,"text":"舞うことが好きで、織山家に来てからも時間があれば一人で練習をしている。"},{"spoiler":false,"text":"それともう一つ秘密の趣味があり、ひょんなことから真咲にそれを知られてしまう。"},{"spoiler":false,"text":"そして秘密を共有できたことで、ふたりの距離が少しずつ縮まっていく。"},{"spoiler":false,"text":"一般的な女の子と比べると若干控えめな胸がコンプレックス。"},{"spoiler":false,"text":"「踊ってると落ち着くんです、身体の動きに心を重ねて…… 余計なモノが流れ落ちていくような、そんな気がして」"}],"source":"bangumi","sourceCharacterId":"40368"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"40368","value":"聖キキリア学園 2年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/839cfbc41d176e840396467ce5e6f7810e345a880704c1176fd0bfd8b43cf578.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77faa1497176c9f2792fa925b10b38fb37