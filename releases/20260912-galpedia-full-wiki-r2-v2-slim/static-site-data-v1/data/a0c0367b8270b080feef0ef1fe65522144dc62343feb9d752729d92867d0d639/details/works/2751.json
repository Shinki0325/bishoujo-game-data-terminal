vndb:vn-staff:18373","source":"vndb"},{"creditedName":"ばん だいすけ","creatorId":"vndb:s6564","sourcePersonId":"vndb:s6564","canonicalEntityId":"vndb:s6564","name":"ばん だいすけ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18374","source":"vndb"},{"creditedName":"夕凪二葉","creatorId":"vndb:s9051","sourcePersonId":"vndb:s9051","canonicalEntityId":"vndb:s9051","name":"夕凪二葉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18375","source":"vndb"},{"creditedName":"湯","creatorId":"vndb:s10605","sourcePersonId":"vndb:s10605","canonicalEntityId":"vndb:s10605","name":"湯","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18376","source":"vndb"},{"creditedName":"株式会社フェザード","creatorId":"vndb:s37208","sourcePersonId":"vndb:s37208","canonicalEntityId":"vndb:s37208","name":"株式会社フェザード","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18377","source":"vndb"},{"creditedName":"吉成 鋼","creatorId":"vndb:s41884","sourcePersonId":"vndb:s41884","canonicalEntityId":"vndb:s41884","name":"吉成 鋼","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18378","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c2898","characterName":"皐槻","sourceIds":{"vndbCharacterId":"c2898"},"originalCharacterName":"皐槻","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Satsuki is the second girl to whom Takashi allowed to live with him. She is a catgirl. Takashi found her on his way back from school and offered her a shelter from the rain because she has been standing still stunned from the it. After this he allowed her to stay with him since she didn't have a place to go as well."},{"spoiler":false,"text":"At first she was stubbornly closed minded, later she opens her heart slowly after she saw how Choko and Takashi get along good. She is now helping out around the house. Satsuki is modest, quiet and extremely shy, to the point she would look down and turn red when praised."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia"}],"source":"vndb","sourceCharacterId":"c2898"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc3477afbb285e58666b9bfb1680da6a7f0ad116d6f8458cc717fb81da9f721a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/982708cc57993fa4fa6d697f85476a32bc86fab3360a8006697eb26d6e25d1e6.webp","width":221,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎 津久世","creatorId":"vndb:s802","sourcePersonId":"vndb:s802","canonicalEntityId":"vndb:s802","name":"こおろぎ さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8988","source":"vndb"}]},{"characterId":"char_vndb_c2899","characterName":"雪乃","sourceIds":{"vndbCharacterId":"c2899"},"originalCharacterName":"雪乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yukino is the third girl to whom Takashi allowed to live with him. She is a goldfish who was turned into a girl, but her long, pointed ears make her look more like a fairy. Takashi found her sitting at his door wearing only a school swimsuit. She was named after Takashi's goldfish he was keeping a while ago, whom he also called Yukino. Since that day, she is living with him in a body of a girl."},{"spoiler":false,"text":"She is the youngest among the four heroines, she has an innocent personality and appearance, she has the role of a mascot of Takashi's household. It should be noted that she cannot speak a single word except for \"Au\" because there were no parts in her goldfish body that fitted to be transformed into vocal cords."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia"}],"source":"vndb","sourceCharacterId":"c2899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe7b0ecd9ce3d015a2c09dcec07d094d3515d6b4d7c984b3a7de704b4d133c31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ce0931ae58629cc60ce3e3286141b5167bbf78d8100f8b7344543578b74e971.webp","width":217,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海原 エレナ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8986","source":"vndb"}]},{"characterId":"char_vndb_c2900","characterName":"ほのか","sourceIds":{"vndbCharacterId":"c2900"},"originalCharacterName":"ほのか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Honoka is the fourth girl to whom Takashi allowed to live in his house. Honoka is a crane-girl (like a doggirl or a catgirl) who at first glance looks just like an ordinary human, but her long, weird-shaped black hair is actually a pair wings she can open and close."},{"spoiler":false,"text":"She has a very impatient personality. Takashi has suffered a great displeasure from her rudeness, but this was reconciled later. Despite her fierce temper, she can also show Takashi her honest side sometimes. Since she is the oldest of Takashi's 4 cohabitants, she often takes on herself the coordinator role."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia"}],"source":"vndb","sourceCharacterId":"c2900"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/242d4263c0cda3b30c560bd73979dfe6e7dd193a5296789092ff7a9a6a631996.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eb3846e9af1a91cd645c5757c65899d921935a69938c1991a21293e01a740e2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川部 法子","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8990","source":"vndb"}]},{"characterId":"char_vndb_c2902","characterName":"魔女","sourceIds":{"vndbCharacterId":"c2902"},"originalCharacterName":"魔女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a perpetrator who humanized the four girls who now live with Takashi. She also knows all of the places where Takashi found the four girls because she planned to leave them there. She claims to be 100,024-year-old, her real name unknown, she suddenly leaves and suddenly appears. In short, she is a very mysterious woman."},{"spoiler":false,"text":"The witch has a bright and carefree personality."},{"spoiler":false,"text":"It should be noted that in \"Happy Breeding Imasara Fandisc\" she starts to live in Takashi's house as well."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia"}],"source":"vndb","sourceCharacterId":"c2902"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d0a72a3aabfc246ea9190f69d213413b819a19e165ecfa6c0b70777c4e063f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b90c628fdcbbd6a8fe936bd4fa86756e98e06fcb5b5acb67d193c3d92daf211d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥居 花音","creatorId":"vndb:s563","sourcePersonId":"vndb:s563","canonicalEntityId":"vndb:s563","name":"森山 理来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8987","source":"vndb"}]},{"characterId":"char_vndb_c2903","characterName":"チョコ","sourceIds":{"vndbCharacterId":"c2903"},"originalCharacterName":"チョコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Choko is a dog-girl who lives with Takashi. She is the first girl who starts living together with him. One day, when he got home from school, he saw her when she was sneaking into his kitchen in order to eat a croquette. He allowed her to live with him since she had no other place to go."},{"spoiler":false,"text":"Choko has a bright and childish personality, she is to be a glutton with a bottomless stomach, a mood maker and a trouble maker."},{"spoiler":false,"text":"She is looking for a boy with whom she made friends after she met him in the time when she was still a puppy, who just disappeared into the woodwork."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia"}],"source":"vndb","sourceCharacterId":"c2903"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9a84a155b5068f1bd2567dd54c12c91fb6e880a0fbff5c6ee0ad68308d87600.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fd727603b3aabf968e42ec8e3ab407ad64a431fff9c24f294c8e5ff66ca8da5.webp","width":217,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉沢 結花","creatorId":"vndb:s1078","sourcePersonId":"vndb:s1078","canonicalEntityId":"vndb:s1078","name":"今井由香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8989","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p132","sourceCompanyId":"egs:brand:666","canonicalEntityId":"vndb:p132","name":"Purple software","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:2751:666","source":"egs"},{"companyId":"vndb:p132","sourceCompanyId":"vndb:p132","canonicalEntityId":"vndb:p132","name":"パープルソフトウェア","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2270:v982","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
