nicalEntityId":"vndb:s37208","name":"株式会社フェザード","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11807","source":"vndb"},{"creditedName":"吉成 鋼","creatorId":"vndb:s41884","sourcePersonId":"vndb:s41884","canonicalEntityId":"vndb:s41884","name":"吉成 鋼","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11808","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c10542","characterName":"戸倉 翼","sourceIds":{"vndbCharacterId":"c10542"},"originalCharacterName":"戸倉 翼","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1120"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsubasa is a brave girl who is always bright and cheerful. Even though she is Mayu's (younger) sister, her personality is the exact opposite of Mayu's."},{"spoiler":false,"text":"Because Tsubasa has a lot of superficial knowledge about sex, she wants to know everything about any love affairs that are going around, or at least to hear and spread rumors about them. She worried that Mayu still doesn't have a boyfriend."},{"spoiler":false,"text":"Tsubasa's hobby is playing video games. Even though they almost don't own any games, she is very at playing any video game."},{"spoiler":false,"text":"Hobbies: Gaming."},{"spoiler":false,"text":"Favorite Food: Her older sister's home cooking."},{"spoiler":false,"text":"Translated from Akiiro Renka's official website."}],"source":"vndb","sourceCharacterId":"c10542"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2efd0c743fd62bbf1332acfd9c2fd8c6beffc196892b2910f8e98c126d2158c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b14135e56ed3337a50ce0f495f30fff6b42601d2863fd2063aed2ede29969d6a.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"文月 かな","creatorId":"vndb:s54","sourcePersonId":"vndb:s54","canonicalEntityId":"vndb:s54","name":"文月 かな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5422","source":"vndb"}]},{"characterId":"char_vndb_c10543","characterName":"小暮 史佳","sourceIds":{"vndbCharacterId":"c10543"},"originalCharacterName":"小暮 史佳","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"725"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aoi's manager in the entertainment industry. Even though she looks like a tough career woman, her personality is soft and trusting. Aoi can always use this trait of hers in order to skip events by telling Fumika that her stomach hurts."},{"spoiler":false,"text":"Hobbies: Reading."},{"spoiler":false,"text":"Favorite Food: Edible wild plant dishes."},{"spoiler":false,"text":"Translated from Akiiro Renka's official website."}],"source":"vndb","sourceCharacterId":"c10543"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3631569903351072cde72fb6525c6598ec97e7166dd1d222fe464dfe047b724f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f44c992bb3eab5739575fce36ac9f7d1c2a241d41545aed5845d3734231e2537.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"如月 美琴","creatorId":"vndb:s1012","sourcePersonId":"vndb:s1012","canonicalEntityId":"vndb:s1012","name":"如月 美琴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5428","source":"vndb"}]},{"characterId":"char_vndb_c10544","characterName":"生方 蘭子","sourceIds":{"vndbCharacterId":"c10544"},"originalCharacterName":"生方 蘭子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"229"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ibuki's personal tennis coach."},{"spoiler":false,"text":"She once was a legendary professional tennis player. At that time she were called \"Queen of the Far East\". Now they call her \"The Uncrowned Queen\", but she never wanted to have any of those titles in the first place."},{"spoiler":false,"text":"Her tennis tactics are refreshing and smart, but many fans said that in the latest games she wasn't all that good. Due to that she had retired from tennis, then she has been recognized as a retired coach after accepting Ibuki as her trainee. However, even after receiving the title of an \"adviser\" (or coach), she still wants to resume her tennis career someday."},{"spoiler":false,"text":"Hobbies: Tennis"},{"spoiler":false,"text":"Favourite Food: Cheese fondue"},{"spoiler":false,"text":"Translated from Akiiro Renka's official website."}],"source":"vndb","sourceCharacterId":"c10544"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bea8378851e37d07d999b51bc6f5a20d7c234cfcc97a69a601d656ec657ea770.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27bd804cad3de6ca8a476fa32af582a43a4faca78a9675705bbc66305a7bb9e6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深井 晴花","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5424","source":"vndb"}]},{"characterId":"char_vndb_c1080","characterName":"南条 伊吹","sourceIds":{"vndbCharacterId":"c1080"},"originalCharacterName":"南条 伊吹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"610"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A tennis player who always travels around the world, but now she temporarily returned to Japan to take care of her injured hand. Due to this, she transfers to Shinobu's high school and becomes his classmate. Her personality is bright and energetic. However, she is quite boyish comparing to Aoi, Shinobu's sister-in-law."},{"spoiler":false,"text":"Hobbies: Collecting cute things"},{"spoiler":false,"text":"Favorite Food: Onigiri"},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c1080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d10f900559d043bcd079805a65596e162ad2a562e367da139ca14ff3db0e7371.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c268fed123fc1fb97b1c83e645ae7083c90a7c26936f550fc2c174c44354805d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々 留美子","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおきさやか(青木静香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5423","source":"vndb"}]},{"characterId":"char_vndb_c1081","characterName":"世良 香澄","sourceIds":{"vndbCharacterId":"c1081"},"originalCharacterName":"世良 香澄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1010"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of millionaire celebrity in the city."},{"spoiler":false,"text":"When on campus, she holds the image of a neat and refined young lady with gentle manners. Her usual greeting word is \"Gokigenyou\" (a very polite and feminine greeting)."},{"spoiler":false,"text":"But this is not who she really is. Strangely enough, she is a rude but shy bully. When she is embarrassed, she would disguise it as a complaint. In other words, she is a kind of a tsundere."},{"spoiler":false,"text":"Hobbies: Piano (real hobby: buying (and immediately consuming) sweets)"},{"spoiler":false,"text":"Favourite Food: Mille-feuille (it is also her real favourite food)"},{"spoiler":false,"text":"Roughly translated from Getchu."}],"source":"vndb","sourceCharacterId":"c1081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/717e91b1a6b69283b58510969d7903fbfe24711d0ac56b48c232ee947b8d4d11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d30c25b8da18128801a5d50ac9e1a8e050b2f75ebe06b26186e6a5be42f4869.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"AYA","creatorId":"vndb:s662","sourcePersonId":"vndb:s662","canonicalEntityId":"vndb:s662","name":"茂呂田 かおる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5426","source":"vndb"}]},{"characterId":"char_vndb_c1082","characterName":"戸倉 真由","sourceIds":{"vndbCharacterId":"c1082"},"originalCharacterName":"戸倉 真由","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"315"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mayu is the protagonist's classmate. Because her family is poor, she has to work in a Gyuudon store after school as part-time job in order to help providing for her family. She also has a second part time job - she sells food at the school's cafeteria."},{"spoiler":false,"text":"Mayu lives alone only with her beloved younger sister Tsubasa. Due to this this she has to do all the chores at home like if she were the mother of the family."},{"spoiler":false,"text":"She's often quiet, and her facial expressions can be hard to read."},{"spoiler":false,"text":"Hobbies: cooking, taking care of her little sister"},{"spoiler":false,"text":"Favorite food: Food that gets discounted"},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c1082"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02cdd4d6cc90fb5824a7038e0cf63e1aa93ed6198b0550251ba4f676b3f5d041.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2ace3cdd954de6e49d2722801c77361a0d714c18a2237d48f705867b1ec54b7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大花 どん","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"大花どん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5427","source":"vndb"}]},{"characterId":"char_vndb_c1083","characterName":"佐川 英里子","sourceIds":{"vndbCharacterId":"c1083"},"originalCharacterName":"佐川 英里子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1212"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eriko is a childhood friend of the protagonist, Shinobu, and lives in his neighborhood. She works as a teacher at Shinobu's school, also she happens to be his homeroom teacher too. In order to reduce his household chores burden as he is staying alone most of the time, Eriko always takes care of him and prepares meals for him everyday. She is a kind teacher, and quite popular at school. Also, she has lot of free time."},{"spoiler":false,"text":"Hobbies: Taking care of the protagonist"},{"spoiler":false,"text":"Favorite food: The protagonist's favorite food"},{"spoiler":false,"text":"Roughly translated from Getchu."}],"source":"vndb","sourceCharacterId":"c1083"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a3107f7be4c26b38404c6705bc9ec659baac3db3c528af812756a2da2630862.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00e16f186d1644e618a5eeeef558479ae21759a0103e31e2cde2992d5eafbf0b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"美咲 ゆうか","creatorId":"vndb:s1239","sourcePersonId":"vndb:s1239","canonicalEntityId":"vndb:s1239","name":"浅野 るり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5429","source":"vndb"}]},{"characterId":"char_vndb_c1084","characterName":"新山 葵","sourceIds":{"vndbCharacterId":"c1084"},"originalCharacterName":"新山 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"325"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shinobu's stepsister. Working as a newbie idol and attending high school at the same time, she lives in the same apartment with him. Because of her busy work as an idol, she doesn't come to school often. Despite that, she is able to spend her nightly time on watching TV programs. Sometimes she will easily get angry at Shinobu when he teases her."},{"spoiler":false,"text":"Hobbies: Window-shopping"},{"spoiler":false,"text":"Favorite Food: Meat and potato stew (Nikujaga)"},{"spoiler":false,"text":"Roughly translated from Getchu."}],"source":"vndb","sourceCharacterId":"c1084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1254a18a7d13a28e41635767fdf7e05dba04f9dea570e127b0be595c09dccfd1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18d83a7e483099b7cd7d105e7a52be817008869ceca9fd8ff1dd38e875f0a162.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 あやか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5425","source":"vndb"}]},{"characterId":"char_vndb_c1089","characterName":"新山 志伸","sourceIds":{"vndbCharacterId":"c1089"},"originalCharacterName":"新山 志伸","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shinobu is the protagonist of this story. He has a stepsister, Aoi, who is an idol. His childhood friend Eriko is living in the same neighborhood with him and works as a teacher in his school, she is also his homeroom teacher. She cooks for him meals at home every day. Shinobu's parents are not at home often due to their work. Most of time he stays alone when Aoi is away for her job."},{"spoiler":false,"text":"Translated and edited from Getchu."}],"source":"vndb","sourceCharacterId":"c1089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a479e7485ff95abd08b74c65f4c9d375c4a7073c5177d18bea293e47e54e60fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afb5f1af264c8eeed780f2dc7fc566d0fa25c91ae5275201ec134746a4358541.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10907","characterName":"結城 隼人","sourceIds":{"vndbCharacterId":"c10907"},"originalCharacterName":"結城 隼人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shinobu's classmate and friend since elementary school. His looks are quite good, so girls confess to him often, but he turns each of them down within a single week. Shinobu is not as popular with girls as Hayato, so he teaches Shinobu how to pick up girls."},{"spoiler":false,"text":"Roughly translated from the Japanese Wikipedia."}],"source":"vndb","sourceCharacterId":"c10907"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec01bd1bc6c295b94506ef6f4300ae7c6b76e69da9216635583a16108f7f3e1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7767c74c0c0014ebd5d40455bbfaa285654ba0e12c4dd87d4d6