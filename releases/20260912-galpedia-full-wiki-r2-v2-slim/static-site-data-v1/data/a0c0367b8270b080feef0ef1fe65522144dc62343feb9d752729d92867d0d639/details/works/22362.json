el":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:50955","source":"vndb"},{"creditedName":"こだま さおり","creatorId":"vndb:s7729","sourcePersonId":"vndb:s7729","canonicalEntityId":"vndb:s7729","name":"こだま さおり","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50958","source":"vndb"},{"creditedName":"織田 かおり","creatorId":"vndb:s7853","sourcePersonId":"vndb:s7853","canonicalEntityId":"vndb:s7853","name":"織田 かおり","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:50959","source":"vndb"},{"creditedName":"中村 和騎","creatorId":"vndb:s16404","sourcePersonId":"vndb:s16404","canonicalEntityId":"vndb:s16404","name":"中村 和騎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:50962","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c39736","characterName":"ティアナ","sourceIds":{"vndbCharacterId":"c39736"},"originalCharacterName":"ティアナ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl living in Cattleya Kingdom. Her dream is to become a beastmaster, just like her mother. She roams around the city, looking for animals to be tamed. By blowing the whistle her father made for her, any animal can be tamed."},{"spoiler":false,"text":"from Official site"}],"source":"vndb","sourceCharacterId":"c39736"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c6371efc2482acbeadcacc37d04483f80eee3d5911b3853643f85362c9727bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af42f0620f664bcba2a88fad89f0f6dc742f2297327a1f43272e5b8aa0ed9c27.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c39737","characterName":"マティアス","sourceIds":{"vndbCharacterId":"c39737"},"originalCharacterName":"マティアス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first prince of the Fasan Kingdom. Due to a witch's curse, he's transformed into a lion."},{"spoiler":false,"text":"Not only he's strong, but he also has a good head above his shoulders and is recognized as a brilliant strategist who can skillfully turn the tide of an overwhelmingly disadvantageous war situation."},{"spoiler":false,"text":"He loves women and his motto is, \"Don't reject those who come to you, don't pursue those who leave you\". On the other hand, he hates men so much he doesn't let even his own brothers touch him."},{"spoiler":false,"text":"Translated from Official site"}],"source":"vndb","sourceCharacterId":"c39737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80dba0860577be7a6798f45df04fd7797e2339081723fb57921e6ec88c34c761.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c80f44f6269e2cfeb2c495d0d84f6e82c7018d71cb35a4974326ef2675bede8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緑川 光","creatorId":"vndb:s73","sourcePersonId":"vndb:s73","canonicalEntityId":"vndb:s73","name":"緑川 光","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28214","source":"vndb"}]},{"characterId":"char_vndb_c39738","characterName":"アルフレード","sourceIds":{"vndbCharacterId":"c39738"},"originalCharacterName":"アルフレード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second prince of the Fasan Kingdom. The Witch's Curse makes him transform into a wolf. He lost one eye when he was very young, in an incident that makes him resent Matheus at the beginning. He's more physically developed than Matheus, and he considers the only important thing is training his body. He doesn't usually interfere with other people's businesses, and he has barely had any experience with women."},{"spoiler":false,"text":"from Official site"}],"source":"vndb","sourceCharacterId":"c39738"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36f951d395cce79e876a78fd107efaa17d4996b93ec690e754928399f79fa532.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c4dc0100b2a09311367965c3d4f73fc6a745cd58f44a9ab481c4f8af63b060e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28211","source":"vndb"}]},{"characterId":"char_vndb_c39739","characterName":"ルシア","sourceIds":{"vndbCharacterId":"c39739"},"originalCharacterName":"ルシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third prince of the Fasan Kingdom. The Witch's Curse makes him transform into a duck. He's a quick thinker who's specialty is being able to get out of quarrels simply by using words. His motor skills aren't that good, unless it comes to escaping from combat. Because he's prone to being overweight, he's on a permanent diet."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c39739"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67c40a94802063c0ca78f91da0b31034e386e315bf6dce35f343a5a881e6e8b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/7058ca17a9aedb74400543e39c1d1f72bd793cbe5f44c6f4218dbce7a6ee8437.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"下野 紘","creatorId":"vndb:s70","sourcePersonId":"vndb:s70","canonicalEntityId":"vndb:s70","name":"下野 紘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28213","source":"vndb"}]},{"characterId":"char_vndb_c39740","characterName":"エリク","sourceIds":{"vndbCharacterId":"c39740"},"originalCharacterName":"エリク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The fourth prince of the Fasan Kingdom. The Witch's Curse makes him transform into a rabbit. His mental age is about half of what his appearance makes him look, and the stuffed frog he carries with him at all times is his only friend. Although he's not very useful in combat, he excels with arts such as music or drawing. Since the magic wore off, he always follows his favourite brother Lucia."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c39740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48b06195a291f1c28c7be58abd6ceebbc345e65cf8c90705d98d8b43a2479d8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33cc7c5d7835b7b1037f7a5160ca2768595903a650a4e43fcf0b8999a4cf1022.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶 裕貴","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28215","source":"vndb"}]},{"characterId":"char_vndb_c39741","characterName":"クラウス","sourceIds":{"vndbCharacterId":"c39741"},"originalCharacterName":"クラウス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend of Tiana. She considers him a big brother, who since she was little scolded her and took care of her since her parents dissapeared. Klaus graduated with honors from the Royal Academy of Zarudine, and became the vice-director of the Cattleya Royal Library. He and Matheus were classmates at school, and they thought of each other as rivals."}],"source":"vndb","sourceCharacterId":"c39741"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87a1bd9ee8b4b67420197bba72ab7904bebf2168b205ee3145a6006e5493929d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd1c798a417da8e59b4dbc88f356c6b9c51e1de1619015e97c2e62071effcb3e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安元 洋貴","creatorId":"vndb:s377","sourcePersonId":"vndb:s377","canonicalEntityId":"vndb:s377","name":"安元 洋貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28216","source":"vndb"}]},{"characterId":"char_vndb_c39743","characterName":"シルビオ","sourceIds":{"vndbCharacterId":"c39743"},"originalCharacterName":"シルビオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bright boy working in the Cattleya Pharmacy. His good social graces and persuasive tongue attract many female customers to the shop. He has very good physical abilities and is very flexible. He also has a brave side to him by assisting the unreliable Gerda."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c39743"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac6f0a884bda6943c3941724b29c7eb4c5b671f1360e0faae069e206784c0e32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02a469bb23c7988978e343fde1d4b4a55209a3b61ae719412525764e4630eb32.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺島 拓篤","creatorId":"vndb:s63","sourcePersonId":"vndb:s63","canonicalEntityId":"vndb:s63","name":"寺島 拓篤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28212","source":"vndb"}]},{"characterId":"char_vndb_c39797","characterName":"ロッテ","sourceIds":{"vndbCharacterId":"c39797"},"originalCharacterName":"ロッテ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A friend of Tiana's, her family owns a bakery shop."},{"spoiler":false,"text":"Her specialty is making jams."},{"spoiler":false,"text":"She completely believes that Tiana can become the best animal tamer in the world."}],"source":"vndb","sourceCharacterId":"c39797"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/321d2b4976c0690d19c651d232