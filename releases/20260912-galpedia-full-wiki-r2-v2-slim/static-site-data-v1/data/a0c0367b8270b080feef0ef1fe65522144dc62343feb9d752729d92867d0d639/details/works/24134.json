abel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133640","source":"vndb"},{"creditedName":"SION","creatorId":"vndb:s4166","sourcePersonId":"vndb:s4166","canonicalEntityId":"vndb:s4166","name":"SION","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:133643","source":"vndb"},{"creditedName":"SION","creatorId":"vndb:s4166","sourcePersonId":"vndb:s4166","canonicalEntityId":"vndb:s4166","name":"SION","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133644","source":"vndb"}]},"cast":[{"characterId":"char_c54787","characterName":"ヒメ","sourceIds":{"bangumi":[{"characterId":"53239","match":"exact-normalized-name-in-linked-work","subjectId":"212774"}],"egsCharacterIds":["13632"],"vndbCharacterId":"c54787"},"originalCharacterName":"ヒメ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Reading, making sweets"}],"source":"vndb","sourceCharacterId":"c54787"},{"segments":[{"spoiler":false,"text":"誠一郎の彼女。女子学生。誠一郎の事は「誠一郎君」と呼ぶ。"},{"spoiler":false,"text":"健気で淑やかで笑顔が可愛らしく、そこにいるだけで場が和むようなタイプ。"},{"spoiler":false,"text":"女友達からは「ユキ」や「ヒメ」などと呼ばれている。"},{"spoiler":false,"text":"出る所はしっかり出て、引っ込む所は引っ込む官能的なスタイル。"},{"spoiler":false,"text":"両親は海外で仕事をしており、現在は自宅マンションで一人暮らし。"},{"spoiler":false,"text":"そのため家事は得意。"},{"spoiler":false,"text":"料理やお菓子作りが得意で親友からは「いい嫁になれる」と絶賛されている。"},{"spoiler":false,"text":"昼食のお弁当を作ってくれるなど、愛する誠一郎のために甲斐甲斐しい姿を見せる。"},{"spoiler":false,"text":"図書委員を務めており、また放送部にも所属している。"},{"spoiler":false,"text":"本好きで、誠一郎とは互いのオススメする図書を貸し借りする仲。"},{"spoiler":false,"text":"誠一郎との関係はキスまで。しかし、恋愛についてはしっかりと手順を踏んでいきたいと考えており、処女は彼に捧げる気持ちでいる。"},{"spoiler":false,"text":"年相応に性への感心は高く、いけないと思いながらも誰もいない実家では彼を想いながら、自慰で火照った体を紛らわす事も。"}],"source":"egs","sourceCharacterId":"13632","sourceWorkId":"24134","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"13632","sourceWorkId":"24134","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"13632","sourceWorkId":"24134","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"13632","sourceWorkId":"24134","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"13632","sourceWorkId":"24134","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"13632","sourceWorkId":"24134","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"13632","sourceWorkId":"24134","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1921e21ad988f70eeffe375bde1b5d24f983374b6dcf92ec7875ebded9598e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4596ca125051c234038cbb0302dfdc782fa4c966aca10266e4645195b6be8eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212774:53239:6351:1","source":"bangumi"}]},{"characterId":"char_c54788","characterName":"橘 誠一郎","sourceIds":{"bangumi":[{"characterId":"53238","match":"exact-normalized-name-in-linked-work","subjectId":"212774"}],"egsCharacterIds":["13634"],"vndbCharacterId":"c54788"},"originalCharacterName":"橘 誠一郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"寝取られ男。雪姫の彼氏。男子学生。"},{"spoiler":false,"text":"勉強も運動もそつなくこなす、爽やかな好青年。"},{"spoiler":false,"text":"男女問わずに友人が多く、友人に宿題写させてと頼まれたら、渋々ながらも見せてあげたりと人あたりもよい。"},{"spoiler":false,"text":"雪姫は特別な存在であり、彼女が人生初の彼女。"},{"spoiler":false,"text":"デートを何度か重ね、キスまで関係を進展させている。"},{"spoiler":false,"text":"彼女と知り合ったきっかけは、内申点を上げるために図書室の書架整理を手伝った事。"},{"spoiler":false,"text":"彼女の美貌や人柄に惹かれたのはもちろん、両親が共働きである点など共通項も多かった事も重なり、誠一郎の方から告白した。"},{"spoiler":false,"text":"雪姫に対しては、日々愛しさを募らせ、「俺にはこの子しかいない」、「守ってあげないと」と感じている。"}],"source":"egs","sourceCharacterId":"13634","sourceWorkId":"24134","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70e221c4a0f4d725f27743d498cd1a23575a2454f0a5460a2aee0f58490b054f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f75921a6c7da484c5b086730d078f75c85f4e4a58282ec183cd7d746055861bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c54790","characterName":"金園 清志","sourceIds":{"bangumi":[{"characterId":"53240","match":"exact-normalized-name-in-linked-work","subjectId":"212774"}],"egsCharacterIds":["13633"],"vndbCharacterId":"c54790"},"originalCharacterName":"金園 清志","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"寝取り男。誠一郎と雪姫のクラスメート。"},{"spoiler":false,"text":"勉強も運動も得意ではない小太りな男子学生。"},{"spoiler":false,"text":"クラスでは、飄々としたお調子者的なポジションの人間。"},{"spoiler":false,"text":"性欲は旺盛で、巨根。"},{"spoiler":false,"text":"実家はラブホテル関係の経営事業を行っており、自身の庭同然のホテルに盗撮カメラを仕掛けては、他人の情事を覗いて楽しむのが趣味。"}],"source":"egs","sourceCharacterId":"13633","sourceWorkId":"24134","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddbde1f4e851106b800aad58dd7496b98e6b3ba929732fe4e84a625d422102f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0381f9a4f7bead65790099f330f45b4d2a3415634354a6f0673c9ad4a3b734be.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p765","sourceCompanyId":"egs:brand:1121","canonicalEntityId":"vndb:p765","name":"わるきゅ～れ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:24134:1121","source":"egs"},{"companyId":"vndb:p765","sourceCompanyId":"vndb:p765","canonicalEntityId":"vndb:p765","name":"わるきゅ～れ","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:164809:v19908","source":"vndb"},{"companyId":"vndb:p5934","sourceCompanyId":"vndb:p5934","canonicalEntityId":"vndb:p5934","name":"いいね！","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:164810:v19908","source":"vndb"},{"companyId":"vndb:p765","sourceCompanyId":"vndb:p765","canonicalEntityId":"vndb:p765","name":"わるきゅ～れ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:54479:v19908","source":"vndb"},{"companyId":"vndb:p765","sourceCompanyId":"vndb:p765","canonicalEntityId":"vndb:p765","name":"わるきゅ～れ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-prod