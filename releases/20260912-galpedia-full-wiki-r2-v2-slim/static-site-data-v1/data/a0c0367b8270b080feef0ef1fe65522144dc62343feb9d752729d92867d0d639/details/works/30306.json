{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30306","model":{"presentationWorkId":"egs:30306","staff":{"artwork":[{"creditedName":"浮丸つぼね(kyokutyo)","creatorId":"vndb:s16224","sourcePersonId":"egs:creator:32546","canonicalEntityId":"vndb:s16224","name":"浮丸つぼね(kyokutyo)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:229622","source":"egs"}],"scenario":[{"creditedName":"倉骨治人(骨折王子)","creatorId":"vndb:s16225","sourcePersonId":"egs:creator:32544","canonicalEntityId":"vndb:s16225","name":"倉骨治人(骨折王子)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:229621","source":"egs"}],"music":[{"creditedName":"yusuke","creatorId":"vndb:s45125","sourcePersonId":"egs:creator:24846","canonicalEntityId":"vndb:s45125","name":"yusuke","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:229620","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_71836","characterName":"Kusumoto Mikoto","sourceIds":{"bangumi":[{"characterId":"71836","match":"source-roster","subjectId":"144880"},{"characterId":"71836","match":"source-roster","subjectId":"216380"},{"characterId":"71836","match":"source-roster","subjectId":"487104"},{"characterId":"71836","match":"source-roster","subjectId":"531089"}]},"originalCharacterName":"Kusumoto Mikoto","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"74"},"height":{"reviewState":"source-only","source":"bangumi","value":"143"},"hip":{"reviewState":"source-only","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"矢矧樱学园2年生。"},{"spoiler":false,"text":"突然从教室里的杂物柜里出现的“自称，神”&“自称，助人角色”。"},{"spoiler":false,"text":"一言谓之放在物语里就和那只蓝色的怕老鼠的机器猫差不多的便利角色。"},{"spoiler":false,"text":"整体娇小，却是容貌姣好能够一眼就抓住他人眼球的谓之美少女的存在。"},{"spoiler":false,"text":"到底有着什么目的仍是谜团，但现在正全力为了達也的“想要成为主人公”的愿望努力着。"},{"spoiler":false,"text":"并不断催促着仍然没有下定决心去夺取（NTR）哪位“女主角”的達也。"},{"spoiler":false,"text":"无论何时何地都能够呼啦一下子突然出现的不可思议的迷之少女，達也至今也没搞清楚她的真实身份到底是？"},{"spoiler":false,"text":"PS：目前还以“世界第一容易攻略的软女主”自称，意义不明。"},{"spoiler":false,"text":"【那还不简单，那就从“主人公”手里去把“女主角”横刀夺爱（NTR）不就好了】"}],"source":"bangumi","sourceCharacterId":"71836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73d0327dc7cc75b73536a6c8e12bc1a60239e0f7617d78784e7f55651154ba11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec512b1f41b13d83d44a3fb5a36693ced79a13aa102b4f0cf006281357968151.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_71844","characterName":"KAZAMICHI RINKO","sourceIds":{"bangumi":[{"characterId":"71844","match":"source-roster","subjectId":"144880"},{"characterId":"71844","match":"source-roster","subjectId":"487104"},{"characterId":"71844","match":"source-roster","subjectId":"531089"}]},"originalCharacterName":"KAZAMICHI RINKO","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"矢矧樱学园2年生."},{"spoiler":false,"text":"唯一知道達也的所扮演“友人角色”真相的女学生。学园中的女生们绝对信赖的存在，同时亦是学园中几乎无所不知的情报家。"},{"spoiler":false,"text":"亦如“故事中的情节一般”同“主人公”的彰和達也是儿时便交往起的青梅竹马的关系，彰的“女主角”的一人。知道達也所扮演的“友人角色”帮助他人的同时，亦是对那种近乎自我牺牲程度“奉献”感到不快，甚至是反感。因而对于達也总是报以辛辣的毒舌口吻催促他，放弃那样的行为。"},{"spoiler":false,"text":"总是利用手里的情报网为来找她吐露恋爱烦恼和困惑的女生排忧解难，因而有着“热心大妈”这般的诨名。"},{"spoiler":false,"text":"【整天顾着那种愚蠢到爆的事情，自我牺牲也要有个限度，这样下去到死都脱不了处也没关系？】"}],"source":"bangumi","sourceCharacterId":"71844"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/093e63b8bfac4d5500882525b2fdf843fec57e38a714b737375100a9522bb0e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e046cc37a1bccd8f8ad5b9b5ca61658d8f738292086454fea1e0c96c4ae9362.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_71846","characterName":"HIGA NANAMI","sourceIds":{"bangumi":[{"characterId":"71846","match":"source-roster","subjectId":"144880"},{"characterId":"71846","match":"source-roster","subjectId":"487104"},{"characterId":"71846","match":"source-roster","subjectId":"531089"}]},"originalCharacterName":"HIGA NANAMI","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"89"},"hip":{"reviewState":"source-only","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"矢矧樱学园1年生。"},{"spoiler":false,"text":"元气作为卖点的开朗可爱巨乳系后辈的“女主角”的一人。"},{"spoiler":false,"text":"总是积极是对“主人公”的彰展开攻势、而对于“友人角色”的達也则是“恰如友人”般的安逸随性的相处对待。"},{"spoiler":false,"text":"从棒球大联盟这种大众文化到生冷的地下文化种种精通，对于達也抛出来的NETA段子都能准确无误对上的博识亦或者说是杂识小机灵。"},{"spoiler":false,"text":"亦如“故事中情节一般”同“主人公”的彰儿时便有过接触，并因此定下了十分重要的约定的样子似乎。"},{"spoiler":false,"text":"并且“自称，魔法使”来着，化为魔法之物便能操使（恩，至少本人是这么说的）。"},{"spoiler":false,"text":"对于，“神”和“神所定下的规矩”，似乎知道什么重要的秘密的样子....？"},{"spoiler":false,"text":"【放心交给我把，辈前（前辈）！别看小那波这样、在伦理协会上可是十八岁以上的人物哦，这样，那样的事情，都是可，以，的，哟！”】"}],"source":"bangumi","sourceCharacterId":"71846"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d84ae44dc710fbc6d07c438b9206e1e92dec4dc82318537de875103febf53a32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5d16084a9f2471ea230724a48cdace1b170ac6523372d5644f44e5d38b21ba0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_71848","characterName":"TOMOCHIKA TATSUYA","sourceIds":{"bangumi":[{"characterId":"71848","match":"source-roster","subjectId":"144880"},{"characterId":"71848","match":"source-roster","subjectId":"487104"},{"characterId":"71848","match":"source-roster","subjectId":"531089"}]},"originalCharacterName":"TOMOCHIKA TATSUYA","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"178"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"矢矧樱学园2年生。"},{"spoiler":false,"text":"金发，高挑的身材，轻浮的态度，青梅竹马三人组中，另外一对男女却是邻居一个人被隔离开来。"},{"spoiler":false,"text":"友人，亲友，配角。"},{"spoiler":false,"text":"演绎着这种“亲友”角色一直到今天的矢矧樱学园二年生。"},{"spoiler":false,"text":"友近達也，参加了许多亲友友人的社团和圈子。"},{"spoiler":false,"text":"平常都恰如其分的表演着有点小色的工口轻浮黄毛角色，暗中做着各种工作帮助眼前的“主人公”和“女主角”们宛如“故事中”般幸福结合。"},{"spoiler":false,"text":"但，那是被神所定下的“规矩”所束缚的人生。"},{"spoiler":false,"text":"但，那却是绝对不允许被大破的绝对制度。"},{"spoiler":false,"text":"但，直到，令这样的人生齿轮发狂的，“世界第一容易攻略的软女主”的出现。"},{"spoiler":false,"text":"【不将“亲友”扮演下去的话，立刻就会被倒计时、1、2最后会被怎么样想都不敢……啊， 哟！hello大将！最近过得如何啊！？】"}],"source":"bangumi","sourceCharacterId":"71848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/114fd63b886396d4ad51a227bbae7b13d6c49ea3944ad179f76d5d322328d9d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b444cedd1fec7e890ace4d96a8257e8f86192966f8018f83fdcec4696df034ff.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p5512","sourceCompanyId":"egs:brand:4684","canonicalEntityId":"vndb:p5512","name":"はとのす式製作所","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:30306:4684","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
