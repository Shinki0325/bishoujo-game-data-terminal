{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"32608","model":{"presentationWorkId":"vndb:v35582","staff":{"artwork":[{"creditedName":"斎藤なつき","creatorId":"vndb:s2566","sourcePersonId":"egs:creator:105","canonicalEntityId":"vndb:s2566","name":"斎藤なつき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:248921","source":"egs"},{"creditedName":"JAMBREAD","creatorId":"vndb:s9847","sourcePersonId":"egs:creator:27657","canonicalEntityId":"vndb:s9847","name":"JAMBREAD","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:248922","source":"egs"}],"scenario":[{"creditedName":"反事象桂林","creatorId":"vndb:s3722","sourcePersonId":"egs:creator:106","canonicalEntityId":"vndb:s3722","name":"反事象桂林","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:248923","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c104630","characterName":"メルフィーネ・レオニス","sourceIds":{"bangumi":[{"characterId":"99771","match":"exact-normalized-name-in-linked-work","subjectId":"347354"},{"characterId":"99771","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["23877"],"vndbCharacterId":"c104630"},"originalCharacterName":"メルフィーネ・レオニス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異世界ロアの女神近衛団から、レムティアシータの援護と監視のために新たに地上に派遣された魔法戦士。"},{"spoiler":false,"text":"由緒ある家系に生まれ、魔法や武器の扱いにも長けたエリート。"},{"spoiler":false,"text":"自信家で使命感が強く能力は一級品だが、融通が利かないところがあり、実戦経験は乏しく、敵の狡猾さにたびたび翻弄されてしまう。"},{"spoiler":false,"text":"教養があり芸術などにも造詣が深い。"}],"source":"egs","sourceCharacterId":"23877","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士レムティアナイツの一人、レムティアイオタ。本名はメルフィーネ・レオニス。"},{"spoiler":false,"text":"由緒ある家に生まれたエリート。レムティアシータとともに難局を乗り越えたことで、心のつながったパートナーとなる。"},{"spoiler":false,"text":"生真面目でお堅く見えるが、ぬいぐるみを集めるのが趣味など、可愛らしい一面もある。"},{"spoiler":false,"text":"レムティアシータとともに魔法療法士として医療機関で働いている。"}],"source":"egs","sourceCharacterId":"23877","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界ロアの女神近衛団から、レムティアシータの援護と監視のために新たに地上に派遣された魔法戦士。"},{"spoiler":false,"text":"由緒ある家系に生まれ、魔法や武器の扱いにも長けたエリート。"},{"spoiler":false,"text":"自信家で使命感が強く能力は一級品だが、融通が利かないところがあり、実戦経験は乏しく、敵の狡猾さにたびたび翻弄されてしまう。"},{"spoiler":false,"text":"教養があり芸術などにも造詣が深い。"}],"source":"bangumi","sourceCharacterId":"99771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7541eb4a73ff95330782ed8d5ad95ef124cbae91a85e812d03d76551cefd7ce2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae2562d5d28f73923dd4d3291a1989075af2c58af09d311761967859e475fcf0.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽崎 浮木","creatorId":"vndb:s33125","sourcePersonId":"vndb:s33125","canonicalEntityId":"vndb:s33125","name":"羽崎 浮木","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91167","source":"vndb"}]},{"characterId":"char_c33542","characterName":"彩姫 くるみ","sourceIds":{"bangumi":[{"characterId":"96151","match":"exact-normalized-name-in-linked-work","subjectId":"222234"}],"egsCharacterIds":["15750"],"vndbCharacterId":"c33542"},"originalCharacterName":"彩姫 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔法戦士レムティアシータ"},{"spoiler":false,"text":"私立白耀学園の生徒会執行部員にして白耀学園最強の魔法戦士。"},{"spoiler":false,"text":"昔その力をコントロールできず放出してしまい街を一時的に機能停止させた事から、その力を使う事を拒んでいた。"},{"spoiler":false,"text":"しかし学園執行部員の説得と協力により今では執行部が持つ切り札としての抑止力となる。"},{"spoiler":false,"text":"学園執行部員達を心から尊敬している。"}],"source":"egs","sourceCharacterId":"15750","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園・現代文学科に通う学生。"},{"spoiler":false,"text":"清楚な雰囲気、丁寧で優しげな物腰、黙っていても目立ってしまう端麗な容姿を持つ聡明な少女。"},{"spoiler":false,"text":"魔法戦士の存在を噂程度には知っていて、秘かに憧れを持っていた。"},{"spoiler":false,"text":"正義感や人の役に立ちたいという思いが強く、クイーンティアナに与えられた力と白薔薇の助力によって魔法戦士となる。"}],"source":"bangumi","sourceCharacterId":"96151"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e66a3d7aeb9bc45d84e30aee81b2e3e1601ed43a2c62f32d4c2cf2ccd9009878.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ab609ad9384029a7de08822ce5f629596553e24ed25d8e60f8ee430ce21a40b.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c47589","characterName":"シンフォニックシュガー","sourceIds":{"bangumi":[{"characterId":"96141","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2314"],"vndbCharacterId":"c47589"},"originalCharacterName":"シンフォニックシュガー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かな天才科学者。シンフォニックリリーに信頼以上の気持ちを寄せいている。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして莉々奈を奪回しようとエクセリウムで活動中。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"冷静沈着ながら敵対した相手には容赦のない攻撃をする。"},{"spoiler":false,"text":"今まで虚勢を張りながらも堕ちきらなかった彼女が心の支えのない中精神を疲労させていき姦計にはまっていく。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「私の声が聞こえたのなら、きっと莉々奈さんが私を呼んでくれたからです」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かで冷静沈着な天才科学者。"},{"spoiler":false,"text":"莉々奈とは厚い信頼関係に結ばれており、理論・技術面から百合瀬財団の活動を支えている。"},{"spoiler":false,"text":"幼げな容姿に似合わない強靭な意思と折れない心を持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"天才的な頭脳を持つ世界的な科学者。"},{"spoiler":false,"text":"シンフォニックリリーとともに国際教導学園から身を引き、自らの魔法研究を進める傍ら魔法戦士として活動を続けている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、シンフォニックナイツの一人。"},{"spoiler":false,"text":"物静かで冷静沈着、数々の魔法理論や技術を開発している天才科学者。"},{"spoiler":false,"text":"現在は異世界ロアにて研究活動を行っており、時折レムティアシータに技術的なアドバイスを与えている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。本名は甘樹菜々芭。"},{"spoiler":false,"text":"優秀な技術者で、魔法戦士たちの新たな力をいくつも開発する。"},{"spoiler":false,"text":"国際教導学園で教師として働きながら、魔法技術の研究も怠らない。"},{"spoiler":false,"text":"シンフォニックリリーである百合瀬莉々奈とは深い絆で結ばれたパートナー。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。優秀な研究者、技術者として、魔法戦士たちの勝利を支えている。同じシンフォニックナイツの一人である莉々奈とは深い絆で結ばれており、彼女の経営する国際教導学園で教師としても働いている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は幼げな、物静かで無表情な天才技術者"},{"spoiler":false,"text":"集中し始めると周りのことが全く目に入らなくなる"},{"spoiler":false,"text":"その明晰な頭脳を巡って両親が争い、挙げ句二人ともが不慮の死を遂げたため、自分の持つ才能に嫌悪感すら持ってしまっていた。そのためか、感情の表現もうまくない。"},{"spoiler":false,"text":"莉々奈に出会ったことでその頭脳を人類のために役立てることに喜びと、両親への贖罪を見いだす。また、自分の力を役立てる道を見つけてくれた莉々奈に対し、信頼関係以上の感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"96141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8609a430ae70cca7f0b6e759a667e02697a36c766f741c77a34be38ffd50cffc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1712c987ff84caddb112cef83a5939ceff92a62c4c53b935d6c40b3f59bc9fff.webp","width":156,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c125391","characterName":"甘樹 菜々芭","sourceIds":{"vndbCharacterId":"c125391"},"originalCharacterName":"甘樹 菜々芭","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"606"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"source-only","source