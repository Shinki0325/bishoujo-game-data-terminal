source":"vndb"}]},"cast":[{"characterId":"char_vndb_c3209","characterName":"藤守 要","sourceIds":{"vndbCharacterId":"c3209"},"originalCharacterName":"藤守 要","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Is becoming a knight to fulfill a childhood oath. He always puts others before himself, people always say that he is too reckless even though he don't realize it himself."},{"spoiler":false,"text":"He is a little bit perverted just like a normal boy."}],"source":"vndb","sourceCharacterId":"c3209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a6d43c0b3b40f5f887d0f1375757e72157158a96e9342c4dc2ca0724d97ab42.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b3eaa909442d19e0af9330b6d0b7aef505d34a5bf6ca486ec81cd72126c3ca0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c3211","characterName":"エルシア＝ハーヴェンス","sourceIds":{"vndbCharacterId":"c3211"},"originalCharacterName":"エルシア＝ハーヴェンス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Coming from the knight-rich Villeburg Kingdom, Elcia is an exchange student in a league of her own. She's a first-year in the Esquire knight order but not in Kaname's class. Born into a noble knight family, she epitomizes grace and dignity. Known for her impressive sword skills, she's even solved a robbery single-handedly."},{"spoiler":false,"text":"Her goal is to be the kind of knight people look up to. Determined and calm on the surface, she's pretty competitive and fiery deep down. With a life devoted to rigorous training, romance isn't really her thing. However, she has a girlie side, adoring stuffed animals and cute lingerie."},{"spoiler":false,"text":"Elcia's passionate about swordplay, pushing her limits, and has a soft spot for collecting stuffed toys. Her likes include adorable accessories, fancy underwear, and people with genuine hearts. She's no fan of bad guys, ghosts, or horror flicks."},{"spoiler":false,"text":"\"It's quite the coincidence, Fujimori Kaname. Seems like fate's tied us together in a strange way.\""},{"spoiler":false,"text":"Translated and edited from the official site."}],"source":"vndb","sourceCharacterId":"c3211"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/903fb4876e29e723e682d8a5ae98f4bc35cf7c8408abb5c6cd5ed72438617124.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69d19c65c7c887f23d78644913ca9f9aa4eb07f738f8898554b0ea519b78c138.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39238","source":"vndb"}]},{"characterId":"char_vndb_c3212","characterName":"獅堂 真奈","sourceIds":{"vndbCharacterId":"c3212"},"originalCharacterName":"獅堂 真奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mana, a freshman at Shiromiya Academy and a fellow Esquire member with Kaname, hails from the influential Shido Group, a corporate giant."},{"spoiler":false,"text":"While proud of her distinguished family, she's also aware of her own shortcomings as a Shidou. Her journey to knighthood is driven by a desire to grow and live up to her family's esteemed reputation. Beneath her kind and nurturing exterior lies a hint of timidity and self-doubt. Yet, she constantly endeavors to uphold her family's honor, often putting up a brave front."},{"spoiler":false,"text":"While Mana doesn't excel in any one area, she's hardworking and meets expectations in her studies and sports through her relentless effort."},{"spoiler":false,"text":"Her view of men is a bit unusual due to the influence of her family's maid, making her somewhat cautious and clean-conscious. Contrary to typical expectations of a young lady of her status, Mana is skilled in practical tasks like cooking, laundry, and cleaning. She's particularly good at cooking, almost at a professional level, thanks to learning from her family's chefs."},{"spoiler":false,"text":"In addition to cooking, she also loves building detailed bottle ships, enjoying seeing small efforts come together. Mana has a taste for Western sweets but is not a fan of bitter things like black coffee or alcohol."},{"spoiler":false,"text":"\"It's not just about me; it's about the Shido family's status, which feels too grand for who I am right now.\""},{"spoiler":false,"text":"Translated and edited from the official site."}],"source":"vndb","sourceCharacterId":"c3212"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86243dce37220f116b6f4b6a78ec51b6c778183e0fefc3de46ce4485501ca784.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d38ac068572ab642ef3bcf1e0903b21444969fcb6bdaa9ecdced5663604c854c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひなき 藍","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39242","source":"vndb"}]},{"characterId":"char_vndb_c3213","characterName":"風間 明莉","sourceIds":{"vndbCharacterId":"c3213"},"originalCharacterName":"風間 明莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student at Shiromiya Academy and Kaname's classmate in the Esquire order."},{"spoiler":false,"text":"She entered the academy on a scholarship after dedicating herself to intense study. As the eldest daughter of a large, impoverished family, she aims to become a knight, leveraging her athletic abilities to support her family financially, seeing it as a stable source of income."},{"spoiler":false,"text":"Having taken care of her younger brothers and sisters, she's skilled at handling children. She also possesses domestic skills like sewing and cooking, although, with cooking, it’s more about quantity than quality."},{"spoiler":false,"text":"Akari is a bright, positive, and energetic girl who acts impulsively and in the heat of the moment without overthinking. She doesn't mind being poor; instead, she accepts it and enjoys her life with an easygoing attitude. Growing up in a lively, large family, she dislikes being alone and tends to feel lonely easily."},{"spoiler":false,"text":"Her hobbies include running, playing with kids, sewing, and being thrifty."},{"spoiler":false,"text":"She loves children and food (she's not picky and loves anything delicious and affordable) and dislikes gloomy moods and being alone."},{"spoiler":false,"text":"“Kaname, your back resembles that of my father. When I hug you like this, I feel at ease.”"},{"spoiler":false,"text":"Translated and edited from the official site."}],"source":"vndb","sourceCharacterId":"c3213"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a808be041627785f30db747cee5d8071f712e0031edbc0178a66fe718426248.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83ffb3ce023a89b04b4449fa4840c0d9055bde47b1cba4c48f9e47ebd7a02335.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉 結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39241","source":"vndb"}]},{"characterId":"char_vndb_c3214","characterName":"藤守 由宇","sourceIds":{"vndbCharacterId":"c3214"},"originalCharacterName":"藤守 由宇","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuu, Kaname's younger sister, advanced grades to join her brother in the same year and class at school. She's also a member of the Esquire Knight order."},{"spoiler":false,"text":"Deeply devoted to her brother, Yuu's world revolves around him. A self-taught genius, she's always managed to grasp complex theories and knowledge without any mentor. Inspired by Kaname's dream of knighthood, she sets her sights on becoming a knight, aiming to support and aid her somewhat reckless brother."},{"spoiler":false,"text":"Yuu's demeanor is marked by her politeness and quiet nature, showing respect and good sense in her interactions with others. However, her composure tends to waver around her brother, revealing a more emotional and reactive side. While Yuu can maintain the appearance of a typical sibling relationship in public, she becomes noticeably more affectionate and clingy to Kaname in private."},{"spoiler":false,"text":"Yuu enjoys collecting items related to Kaname, reading, and surfing the internet. Her favorites include her brother and extra-strong black coffee, while she strongly dislikes anything occult, finding unscientific phenomena frightening."},{"spoiler":false,"text":"\"It's just the affection you'd expect between close siblings. When it's just us, there's nothing odd about it.\""},{"spoiler":false,"text":"Edited from the official site."}],"source":"vndb","sourceCharacterId":"c3214"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6630f1c9dfcf9f7d0dd7045e77e65dfeddb7927d6ef3870ff2e4bdbcd5017349.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6bb27df095184dee477f2577f4b3af8397dfc73770f9c7d10a26d1f390b0141.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪都 さお梨","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39243","source":"vndb"}]},{"characterId":"char_vndb_c3216","characterName":"国中 佳織","sourceIds":{"vndbCharacterId":"c3216"},"originalCharacterName":"国中 佳織","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As a third-year at Shiromiya Academy, Kaori leads the Esquire knight order. Not only has she already achieved her knight qualifications during her studies, but she was also part of a formal knight order before the arrival of the new students. Her talents are extraordinary; she's a natural genius with superior physical abilities, effortlessly excelling at anything new. This versatility, however, leaves her without any specific hobbies to pursue."},{"spoiler":false,"text":"Kaori's approach to leadership in Esquire is to provide thoughtful guidance from behind the scenes, helping to unite and shape the less experienced members."},{"spoiler":false,"text":"She's always the epitome of calm and gentleness, frequently seen with a soft smile. While Kaori is a model of dependability in her school and professional life, she's known for being somewhat lax in her private life. She is particularly not good in the mornings; usually groggy upon waking, often engaging in problematic behavior such as sleepwalking around the dorm naked."},{"spoiler":false,"text":"Kaori doesn't have any specific hobbies but loves her naps. She's not a fan of bugs, though."},{"spoiler":false,"text":"\"Remember, once you wear that armor, you're representing Esquire. Tackle your roles with focus and dedication.\""},{"spoiler":false,"text":"Translated and edited from the official site."}],"source":"vndb","sourceCharacterId":"c3216"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbb5af204382daa83e18efb1d46bc6e6b5cf5722de5e912bbd9febb229e1a23d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c898e51490430023ae32b0780a16b084dbee43797ff3b2301cd182b1fdc4cde.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"楠 鈴音","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39240","source":"vndb"}]},{"characterId":"char_vndb_c3217","characterName":"ベルナデット＝ヴィルブルグ","sourceIds":{"vndbCharacterId":"c3217"},"originalCharacterName":"ベルナデット＝ヴィルブルグ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"source-only","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Bernadette is a princess from the Villeburg Kingdom. Though lower in the line of succession, she's the most active in regal duties among the Villeburg royals. She fully understands her role and responsibilities as an influential figure and doesn't mind them, but she's tired of being shadowed by bodyguards all the time."},{"spoiler":false,"text":"She's intelligent and cunning, with plenty of initiative, but still has a childlike personality. Bernadette's emotions are an open book – she laughs when happy and pouts when upset. She's self-conscious about her small stature and, in an attempt to sound more dignified, picked up old-fashioned Japanese lordly language from period dramas, giving her speech a bit of a retro flair. She's visiting Shiromiya City for a specific reason..."},{"spoiler":false,"text":"Her hobbies include watching period dramas and strolls. She's got a thing for junk food, especially Japanese cup noodles, but she's not a fan of hotels - finds them too impersonal."},{"spoiler":false,"text":"\"As for myself, thou mayst call me Bel, a nickname it be. In turn, I shall address thee as Kaname.\""},{"spoiler":false,"text":"Translated and edited from the official site."}],"source":"vndb","sourceCharacterId":"c3217"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/476676307846ff40347de5edfc36dde6a2c381192686d83f22f5bd281618f3ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e895963ebf7c9f7fd7ae87f5f3c10049be708c8dccf14229ce4cc91079f5165.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大花 どん","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"浅井 清己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39244","source":"vndb"}]},{"characterId":"char_vndb_c3218","characterName":"松下 良平","sourceIds":{"vndbCharacterId":"c3218"},"originalCharacterName":"松下 良平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A freshman at Shiromiya Academy and Kaname's best buddy."},{"spoiler":false,"text":"Ryouhei is easygoing with everyone and a great guy who doesn't see people through biased lenses."},{"spoiler":false,"text":"He ends up in a different knight order than Kaname, but his duties are limited to filing paperwork and running errands."},{"spoiler":false,"text":"Ryohei becomes the ultimate helpful friend, sneakily sharing valuable bits of info he picks up from his paperwork tasks with Kaname."},{"spoiler":false,"text":"He's a bit envious of the protagonist's life among only ladies but also offers comfort, knowing that the reality is much more complex than one might imagine."},{"spoiler":false,"text":"\"It's funny, right? Here I am in the knight order, and all I get stuck with are errands, even after they called me a promising talent.\""}],"source":"vndb","sourceCharacterId":"c3218"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24308355d2f0fd9c571613df93942c5e9861ab4e0549003c691e14ca1a60a31e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c789a411bc73336377b2864c2080382bd97d4805fae0719f3e7f168992592376.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田 友貴","creatorId":"vndb:s34","sourcePersonId":"vndb:s34","canonicalEntityId":"vndb:s34","name":"原田 友貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39239","source":"vndb"}]},{"characterId":"char_vndb_c3219","characterName":"南雲 宗善","sourceIds":{"vndbCharacterId":"c3219"},"originalCharacterName":"南雲 宗善","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The principal of Shiromiya Academy and still an active civilian defense knight despite stepping back from the front lines."},{"spoiler":false,"text":"Muneyoshi is renowned for having earned every one of the prestigious Chivalry Ten Honors, making him a legend among knights nationally and an inspiration to many students."},{"spoiler":false,"text":"He's the hero who rescued young Kaname from a dangerous situation, and their bond grew stronger as he trained the protagonist in knighthood. Beyond their mentor-student relationship, they share a bond close to family, thanks to years of personal connection."},{"spoiler":false,"text":"Muneyoshi's larger-than-life personality means he doesn't get bogged down by details. He's known for his hearty laughter and playful teasing, yet he's decisive when it matters. As a strict and fair educator, he champions hands-on learning, believing real-world practice is vital, making his training both practical and demanding."},{"spoiler":false,"text":"As the principal, he's committed to nurturing young talent. He is the brain behind revising the knight order selection for student squires, mentoring Kaname and the group \"Esquire.\""},{"spoiler":false,"text":"\"Being the only guy among five girls might sound daunting, but nah, I know you've got this!\""}],"source":"vndb","sourceCharacterId":"c3219"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6735a0ee4cccd11b339ef4c2d7577f40bd3d5f2eb2cba47718013823bfb1a4a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df5d062ed2a04d4bd330b7ea13f30a52b814c908d92c4ec64f682014d2455f9e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"こんつ","creatorId":"vndb:s2130","sourcePersonId":"vndb:s2130","canonicalEntityId":"vndb:s2130","name":"根津 貴行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39245","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p2060","sourceCompanyId":"egs:brand:3285","canonicalEntityId":"vndb:p2060","name":"エフォルダムソフト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15431:3285","source":"egs"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:110319:v7260","source":"vndb"},{"companyId":"vndb:p2060","sourceCompanyId":"vndb:p2060","canonicalEntityId":"vndb:p2060","name":"エフォルダムソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:17076:v7260","source":"vndb"},{"companyId":"vndb:p2060","sourceCompanyId":"vndb:p2060","canonicalEntityId":"vndb:p2060","name":"エフォルダムソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:18341:v7260","source":"vndb"},{"companyId":"vndb:p2060","sourceCompanyId":"vndb:p2060","canonicalEntityId":"vndb:p2060","name":"エフォルダムソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:23000:v7260","source":"vndb"},{"companyId":"vndb:p6087","sourceCompanyId":"vndb:p6087","canonicalEntityId":"vndb:p6087","name":"心愿屋汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:41068:v7260","source":"vndb"},{"companyId":"vndb:p2060","sourceCompanyId":"vndb:p2060","canonicalEntityId":"vndb:p2060","name":"エフォルダムソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:79191:v7260","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
