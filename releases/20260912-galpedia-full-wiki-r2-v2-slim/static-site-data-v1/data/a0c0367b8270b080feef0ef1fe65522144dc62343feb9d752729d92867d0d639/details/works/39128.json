"spoiler":false,"text":"とはいえ基本的にそれを自分から口に出したりしない。"}],"source":"bangumi","sourceCharacterId":"188880"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b85616ebac1dbc13502f4b36f9e14cd058374374013311787aa7fcecd175510.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d9e731af72b66300cc618f60724c1ec7ee99db3b7156a39ffb781d3cd121a3b.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七種結花","creatorId":"vndb:s22881","sourcePersonId":"vndb:s22881","canonicalEntityId":"vndb:s22881","name":"佐藤 詩乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:574099:188880:56606:1","source":"bangumi"}]},{"characterId":"char_c158952","characterName":"丸森 環奈","sourceIds":{"bangumi":[{"characterId":"188881","match":"exact-normalized-name-in-linked-work","subjectId":"574099"}],"egsCharacterIds":["28294"],"vndbCharacterId":"c158952"},"originalCharacterName":"丸森 環奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"複数ある人格の中の１人。"},{"spoiler":false,"text":"基本的に振る舞いは落ちついており、どことなく大人びた印象を与える少女。"},{"spoiler":false,"text":"物腰やわらか――ながらも堂々としており、リルカがやりづらいこと、たとえば交渉や提案といったものを彼女に代わっておこなったりもする。"},{"spoiler":false,"text":"何かしらの質問を受けたときには『答えはイエス』『答えはノー』という言い回しをよく使う。"},{"spoiler":false,"text":"望みは“何かを遺すこと”。"},{"spoiler":false,"text":"問題はその何かがまったく思いついていない点。"},{"spoiler":false,"text":"性的な意味で身体を使うことには躊躇ナシ。"},{"spoiler":false,"text":"それどころか手を出すように誘導してくることも。"}],"source":"egs","sourceCharacterId":"28294","sourceWorkId":"39128","spoiler":false},{"segments":[{"spoiler":false,"text":"「年下かって？ 答えはノーよ。"},{"spoiler":false,"text":"見た目はともかく精神年齢はどうか分からないでしょ？」"},{"spoiler":false,"text":"複数ある人格の中の１人。"},{"spoiler":false,"text":"基本的に振る舞いは落ちついており、"},{"spoiler":false,"text":"どことなく大人びた印象を与える少女。"},{"spoiler":false,"text":"物腰やわらか――ながらも堂々としており、"},{"spoiler":false,"text":"リルカがやりづらいこと、たとえば交渉や提案といったものを"},{"spoiler":false,"text":"彼女に代わっておこなったりもする。"},{"spoiler":false,"text":"何かしらの質問を受けたときには"},{"spoiler":false,"text":"『答えはイエス』『答えはノー』という言い回しをよく使う。"},{"spoiler":false,"text":"望みは“何かを遺すこと”。"},{"spoiler":false,"text":"問題はその何かがまったく思いついていない点。"},{"spoiler":false,"text":"性的な意味で身体を使うことには躊躇ナシ。"},{"spoiler":false,"text":"それどころか手を出すように誘導してくることも。"}],"source":"bangumi","sourceCharacterId":"188881"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/054012168bbb06b22e863b2736cd0cd4ea2fcea8aa35daa62e3e8a3f0155e48d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8194f5b06c6e7be179fc8b39aa97f9dafd6195f9a4f5fbac4362a466ccbd5c76.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七種結花","creatorId":"vndb:s22881","sourcePersonId":"vndb:s22881","canonicalEntityId":"vndb:s22881","name":"佐藤 詩乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:574099:188881:56606:1","source":"bangumi"}]},{"characterId":"char_c158953","characterName":"丸森 七星","sourceIds":{"bangumi":[{"characterId":"188882","match":"exact-normalized-name-in-linked-work","subjectId":"574099"}],"egsCharacterIds":["28295"],"vndbCharacterId":"c158953"},"originalCharacterName":"丸森 七星","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"複数ある人格の１人。"},{"spoiler":false,"text":"天真爛漫……というか、割とお調子者。"},{"spoiler":false,"text":"小生意気で積極的、スキンシップも結構多め。"},{"spoiler":false,"text":"まるでナメているかのようにも思える態度を取り、誰に対しても似たような振る舞いをするかと思いきや、相手によっては変なところでビビって無駄にテンパるという一面も。"},{"spoiler":false,"text":"人格が表に出ているときは、大体遊んでいる。"},{"spoiler":false,"text":"家事等の建設的なことは全然しない。"},{"spoiler":false,"text":"望みは“友達をつくり、一緒に何かをすること”。"},{"spoiler":false,"text":"社交的っぽい性格に反して、まったくいないとのこと。"},{"spoiler":false,"text":"また、その“何か”に関しても、全然思いついていない。"},{"spoiler":false,"text":"エロいことに関しては、それはもう積極的。"},{"spoiler":false,"text":"ちょっとした遊び感覚でグイグイと迫ってくる。"},{"spoiler":false,"text":"……だが実は押されることに弱い。"}],"source":"egs","sourceCharacterId":"28295","sourceWorkId":"39128","spoiler":false},{"segments":[{"spoiler":false,"text":"「ってかさあ……見ず知らずの女の子連れ込むってことは、"},{"spoiler":false,"text":"そーゆースケベな気持ちもあったってことじゃん？」"},{"spoiler":false,"text":"複数ある人格の１人。"},{"spoiler":false,"text":"天真爛漫……というか、割とお調子者。"},{"spoiler":false,"text":"小生意気で積極的、スキンシップも結構多め。"},{"spoiler":false,"text":"まるでナメているかのようにも思える態度を取り、"},{"spoiler":false,"text":"誰に対しても似たような振る舞いをするかと思いきや、"},{"spoiler":false,"text":"相手によっては変なところでビビって"},{"spoiler":false,"text":"無駄にテンパるという一面も。"},{"spoiler":false,"text":"人格が表に出ているときは、大体遊んでいる。"},{"spoiler":false,"text":"家事等の建設的なことは全然しない。"},{"spoiler":false,"text":"望みは“友達をつくり、一緒に何かをすること”。"},{"spoiler":false,"text":"社交的っぽい性格に反して、まったくいないとのこと。"},{"spoiler":false,"text":"また、その“何か”に関しても、全然思いついていない。"},{"spoiler":false,"text":"エロいことに関しては、それはもう積極的。"},{"spoiler":false,"text":"ちょっとした遊び感覚でグイグイと迫ってくる。"},{"spoiler":false,"text":"……だが実は押されることに弱い。"}],"source":"bangumi","sourceCharacterId":"188882"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12cee935bfb144ee208438e69f333495fb23f37ec82a0b7cc9448e89e6dd53e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0d7741fd4d1fd0b2c39069297419f1980e3e5e0a70fb4ca09cd6bdddcd73da5.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七種結花","creatorId":"vndb:s22881","sourcePersonId":"vndb:s22881","canonicalEntityId":"vndb:s22881","name":"佐藤 詩乃","roleCode":"voice-actor","roleLabel":"声优","identitySta