{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3891","model":{"presentationWorkId":"vndb:v272","staff":{"artwork":[{"creditedName":"い～ぐる(igul)","creatorId":"vndb:s1771","sourcePersonId":"egs:creator:1189","canonicalEntityId":"vndb:s1771","name":"い～ぐる(igul)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6464","source":"egs"},{"creditedName":"七尾奈留(九尾、奈留)","creatorId":"egs:creator:13","sourcePersonId":"egs:creator:13","canonicalEntityId":"egs:creator:13","name":"七尾奈留(九尾、奈留)","roleCode":"artwork","roleLabel":"原画","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:6465","source":"egs"},{"creditedName":"七尾 奈留","creatorId":"vndb:s1102","sourcePersonId":"vndb:s1102","canonicalEntityId":"vndb:s1102","name":"七尾 奈留","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:7386","source":"vndb"}],"scenario":[{"creditedName":"よこよこ","creatorId":"vndb:s1772","sourcePersonId":"egs:creator:1430","canonicalEntityId":"vndb:s1772","name":"よこよこ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6463","source":"egs"}],"music":[{"creditedName":"猫野 こめっと","creatorId":"vndb:s1050","sourcePersonId":"vndb:s1050","canonicalEntityId":"vndb:s1050","name":"猫野 こめっと","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:7385","source":"vndb"}],"other":[{"creditedName":"tororo","creatorId":"vndb:s1216","sourcePersonId":"vndb:s1216","canonicalEntityId":"vndb:s1216","name":"松村 和俊","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:7387","source":"vndb"},{"creditedName":"恋純 ほたる","creatorId":"vndb:s1908","sourcePersonId":"vndb:s1908","canonicalEntityId":"vndb:s1908","name":"恋純 ほたる","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:7390","source":"vndb"},{"creditedName":"恋純 ほたる","creatorId":"vndb:s1908","sourcePersonId":"vndb:s1908","canonicalEntityId":"vndb:s1908","name":"恋純 ほたる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:7391","source":"vndb"}]},"cast":[{"characterId":"char_c4012","characterName":"朝倉 音夢","sourceIds":{"bangumi":[{"characterId":"20250","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"20250","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["18098"],"vndbCharacterId":"c4012"},"originalCharacterName":"朝倉 音夢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1228"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nemu is Jun'ichi's adopted sister. She is actually in love with Jun'ichi and becomes mad when any other girl shows affection to him and uses \"accidental\" violence to stop the affection between him and another person. She wears a bell as an accessory, given to her by Jun'ichi when they were young. When her mood turns sour, she becomes excessively polite and antisocial, a condition that Jun'ichi calls \"hidden Nemu\". Her cooking is described as lethal, to the point that Jun'ichi quietly calls her the \"Murderous Chef\"."}],"source":"vndb","sourceCharacterId":"c4012"},{"segments":[{"spoiler":false,"text":"主人公と同じ誕生日、同い年の双子のクラスメイトと、ありえないような話だが……、実際のところは血が繋がっていない、子供のころに朝倉家に引き取られた少女。"},{"spoiler":false,"text":"家事万能にみせかけて、食事を作ると殺し屋が通販を申し込んできそうなまずい物を生み出す特殊な才能を持つ。"},{"spoiler":false,"text":"ちなみに、兄のずぼらさに頭を悩ませているが、そのずぼらさに胸をときめかせている節もある、多感なお年頃。"}],"source":"egs","sourceCharacterId":"18098","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義理の妹。"},{"spoiler":false,"text":"兄さんの世話を焼くのが大好きなのだが、実は兄さんを頼りにしている世話のかかる妹。"},{"spoiler":false,"text":"二人とも、その掛け合いを楽しんでいる節も。"}],"source":"egs","sourceCharacterId":"18098","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・朝倉の義妹。"},{"spoiler":false,"text":"世話焼きだが、ヤキモチ焼きでもある。"},{"spoiler":false,"text":"現在は看護士を目指し、本島の看護学校へ通っている。"},{"spoiler":false,"text":"「兄さん……なんだか違う人みたい」"}],"source":"egs","sourceCharacterId":"18098","sourceWorkId":"10905","spoiler":false},{"segments":[{"spoiler":false,"text":"父母早年因车祸丧生，之后被朝仓家收养。"},{"spoiler":false,"text":"与纯一同一天出生，但称纯一为兄（「兄さん」）。因为身体虚弱，经常发热，所以纯一经常帮她检查体温。"},{"spoiler":false,"text":"在学校担任风纪委员，成绩优秀，性格活泼可爱，所以在学校很受欢迎。其料理水平实在不敢恭维，甚至连纯一也畏惧，因此多以便当与外卖解决，很少下厨。"},{"spoiler":false,"text":"非常在意纯一，对纯一抱有超越兄妹的感情，见到纯一跟其他女生一起会动用暴力镇压。也嫉妒纯一跟樱的关系，将樱在美国写给纯一的信全部丢掉。后前往护理学校实习。"},{"spoiler":false,"text":"几经波折,在D.C.S.S中的结局,因为纯一和她各自的情侣表而想起一切,后与纯一结婚.D.C II的故事以音梦与纯一结婚为基础，二代女主角朝仓音姬和朝仓由梦为纯一和音梦的孙女。"}],"source":"bangumi","sourceCharacterId":"20250"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d33d0dbab5448e7891e3f7f4e1bdf2cd4d0ed5f25adc5bed2e442acd330f939.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0d1a6849235bf1decc5d17800a93de798d521fce1741c22ac95d36a9edbec50.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥居 花音","creatorId":"vndb:s563","sourcePersonId":"vndb:s563","canonicalEntityId":"vndb:s563","name":"森山 理来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2913","source":"vndb"}]},{"characterId":"char_c4013","characterName":"さくらんぼ","sourceIds":{"bangumi":[{"characterId":"10717","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"10717","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["17877"],"vndbCharacterId":"c4013"},"originalCharacterName":"さくらんぼ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"904"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"31"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jun'ichi's cousin and first love. She is a very lively girl who shows great affection towards Jun'ichi, much to Nemu's dismay. She is sometimes seen with Utamaru, a white cat. Actually older than Jun'ichi. She inherited her grandmother's magical ability, and despite the passing of several years, her appearance remains largely unchanged from what Jun'ichi and Nemu remember. Has an IQ of 180."}],"source":"vndb","sourceCharacterId":"c4013"},{"segments":[{"spoiler":false,"text":"主人公と音夢の幼馴染で、従姉で、隣の家に住んでいた女の子。"},{"spoiler":false,"text":"六年前の春に海外に引っ越してしまったきり音信不通だったのだが、最近よく夢に現れては騒いでいなくなる迷惑極まりない存在……、夢だけど。"},{"spoiler":false,"text":"生来から甘えん坊で、お気楽極楽トンボな性格で、マスコットか珍獣のように可愛がられる。"},{"spoiler":false,"text":"主人公にベタ惚れしていて、義理の妹となった音夢に対抗して、主人公を「お兄ちゃん」と呼んでは 足や腰にへばりつく癖をもつ。"},{"spoiler":false,"text":"どのような成長を遂げたにしろ、再び出会う時に 主人公に訪れるのは、すごい迷惑か、ものすごい迷惑かのどちらかであろう……。"}],"source":"egs","sourceCharacterId":"17877","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従姉にして、幼馴染でお兄ちゃん子。"},{"spoiler":false,"text":"甘えん坊でお気楽極楽な性格をしている。"},{"spoiler":false,"text":"珍獣かマスコット的な存在。"}],"source":"egs","sourceCharacterId":"17877","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"風見学園で講師を勤める天才少女。"},{"spoiler":false,"text":"朝倉のいとこで、感情表現が豊か。"},{"spoiler":false,"text":"IQ180を誇り、何でも完璧にこなすが、アメリカ帰りのためか、漢字の読み書きは苦手な様子。"},{"spoiler":false,"text":"「最初からボクのせいだったんだ！　ボクのせいでみんないなくなっちゃったんだよ!!」"}],"source":"egs","sourceCharacterId":"17877","sourceWorkId":"10905","spoiler":false},{"segments":[{"spoiler":false,"text":"立夏や清隆と深い縁で結ばれた女性。初音島や魔法について詳しい。"}],"source":"egs","sourceCharacterId":"17877","sourceWorkId":"25266","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と音夢の幼馴染。また従姉でもあり、隣の家に住んでいた女の子でもある。"},{"spoiler":false,"text":"６年前の春に海外に引っ越してしまったのだが、最近よく夢に現れては騒いでいなくなる迷惑極まりない存在……夢だけど。"},{"spoiler":false,"text":"生来から、甘えん坊でお気楽極楽トンボな性格で、 マスコットか珍獣のように可愛がられる。"},{"spoiler":false,"text":"主人公にベタ惚れしていて、義理の妹となった音夢に対抗して、主人公を「お兄ちゃん」と呼んでは 足や腰にへばりつく癖をもつ。"},{"spoiler":false,"text":"どのような成長を遂げたにしろ、再び出会う時に 主人公に訪れるのは、すごい迷惑か、ものすごい迷惑かのどちらかであろう……。"}],"source":"bangumi","sourceCharacterId":"10717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa80b7cb2d81a368b947bacf33f67787c30200f990d114d29a8d5cf3c07c753a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96d37bf8817f06516a7ecaba62fe698b836b4db3ac7c64d9819721e08f3d4b52.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2912","source":"vndb"}]},{"characterId":"char_c4015","characterName":"水越 萌","sourceIds":{"bangumi":[{"characterId":"54840","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"54840","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["18102"],"vndbCharacterId":"c4015"},"originalCharacterName":"水越 萌","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1009"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Moe is a gentle girl who is often seen throughout the series sitting on the roof at lunchtime cooking and eating nabe with her younger sister, Mako. She is very polite, but can be dim-witted at times, and can fall asleep anywhere at any time, even when she's walking. Sometimes she carries a small xylophone, although it's not because she wants to be a good player of said instrument. She is very knowledgeable about nabe, and can talk for hours about said subject."},{"spoiler":true,"text":"In reality, the reason why she sleeps so often is due to her taking sleeping pills to see her deceased childhood friend, Keiichi, in her dreams."}],"source":"vndb","sourceCharacterId":"c4015"},{"segments":[{"spoiler":false,"text":"風見学園本校生で、主人公や音夢たちの先輩にあたる少女。"},{"spoiler":false,"text":"ぼけぼけというか、ぽや～っとした天然色のお嬢様で、寝るのが好きというか、歩いている最中にもに寝てしまうこともしばしば……、ただしお裁縫などは、作業が遅いけど意外と得意。"},{"spoiler":false,"text":"鍋に一家言があるらしい。"},{"spoiler":false,"text":"音楽部に所属していて木琴を担当していたりと（腕はともかく）、朗らかな先輩。"},{"spoiler":false,"text":"あまりにも朗らかで、遅刻してしまい、誰もいない桜並木を木琴を叩きながら歩いているという不思議な姿も目撃 されている。"},{"spoiler":false,"text":"実は、彼女を知らない学生には学園七不思議に間違えられている節もあるとかないとか……。"},{"spoiler":false,"text":"彼女の妹である眞子は、全く逆の性格で、主人公のクラスメイトだとか。"}],"source":"egs","sourceCharacterId":"18102","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"学園七不思議に登録されているほど、寝ながら生活している先輩。"},{"spoiler":false,"text":"目を覚ましていても寝言のようなことしか言わないボケっぷりを発揮する。"}],"source":"egs","sourceCharacterId":"18102","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"おっとりポケポケした性格で、どこででも寝てしまう。"},{"spoiler":false,"text":"音楽部に所属しており、いつも携帯している木琴で、不思議な音色を奏でるのが得意。"},{"spoiler":false,"text":"「――大切な人を失った辛さ、私もよくわかりますから」"}],"source":"egs","sourceCharacterId":"18102","sourceWorkId":"10905","spoiler":false},{"segments":[{"spoiler":false,"text":"風見学園本校生で、主人公や音夢たちの先輩にあたる。"},{"spoiler":false,"text":"ぼけぼけというか、ぽや～っとした天然色のお嬢様で、寝るのが好き。というか、歩いている最中に寝てしまうこともしばしば……。ただしお裁縫などは、作業が遅いけど意外と得意。"},{"spoiler":false,"text":"音楽部で木琴を担当。しかし腕前は…？マーク。　あまりにもマイペースで、遅刻しているというのに、桜並木を木琴を叩きながら歩いているという不思議な姿も目撃されている。"},{"spoiler":false,"text":"彼女の妹水越眞子が主人公のクラスメイトにいるが、眞子はまったく逆の性格で、姉をフォローしている。"},{"spoiler":false,"text":"昼休みには妹と一緒に屋上でお鍋をつついているが、お鍋には一家言があるらしい。"}],"source":"bangumi","sourceCharacterId":"54840"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eeffa963a9a81690463f5759439315c5fad357c8d91795557ddf85b698f9fcd9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b410b5bf9d9aa72e7aac76b723e64bd13f1f6565849090294225c3ec37ca04c.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 向日葵","creatorId":"vndb:s855","sourcePersonId":"vndb:s855","canonicalEntityId":"vndb:s855","name":"瀬那 歩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2914","source":"vndb"}]},{"characterId":"char_c4016","characterName":"水越 眞子","sourceIds":{"bangumi":[{"characterId":"2498","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"2498","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["18104"],"vndbCharacterId":"c4016"},"originalCharacterName":"水越 眞子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"214"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mako is a close friend of Nemu and is often concerned about her. She can be angered easily. She has been rivals with Suginami ever since elementary school and they often quarrel. During lunch, she can often be found on the rooftop with her sister, Moe, enjoying some nabe. She and her sister Moe are the daughters of a wealthy hospital director, and they also have a younger brother."}],"source":"vndb","sourceCharacterId":"c4016"},{"segments":[{"spoiler":false,"text":"主人公や音夢のクラスメイト。"},{"spoiler":false,"text":"勝気で快活、クラスの女子のリーダー的な存在。"},{"spoiler":false,"text":"フルートがとても上手く、演奏中の凛々しい姿は男女ともにファンが多い……、実は毎年のバレンタインデーには同性から大量のチョコレートをもらったりする。"},{"spoiler":false,"text":"朝倉兄妹とも友人で、騒がしくて馬鹿ばかりする主人公には口うるさく注意を飛ばすが、時折みせる妹への優しさに気づいているので好感を持っている。"},{"spoiler":false,"text":"杉並に関しては問題ばかり起こしているので、そこそこ敵対意識をもっているが、彼からは逆に好かれていたりする。"},{"spoiler":false,"text":"萌とは年子の姉妹で、同じ音楽部に入っている。"},{"spoiler":false,"text":"仲が良いように見えるのだが、希にキツイ視線で見つめていることもあるのだが……。"}],"source":"egs","sourceCharacterId":"18104","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"勝気で快活なクラスメイト。"},{"spoiler":false,"text":"音楽部に所属し、フルート担当としてかなりの腕前を持つ。"},{"spoiler":false,"text":"特に同性に好かれていて、バレンタインは下駄箱が大変なことになる。"}],"source":"egs","sourceCharacterId":"18104","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"朝倉のクラスメイトで、萌の妹。"},{"spoiler":false,"text":"音楽部に所属し、フルートの腕は相当なもの。"},{"spoiler":false,"text":"昼休みには、屋上でよく、姉・萌と鍋をつついている。"},{"spoiler":false,"text":"「……演奏が思い通りにいかないの」"}],"source":"egs","sourceCharacterId":"18104","sourceWorkId":"10905","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4ac4ed23e7dd0280434e73e835d71014f7b2bff8f42fee259181f6823e06d0dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f02db6f1794ff31f43e2bf4a4a9b92557e44c2b1d859d619cc4bd0b41b12b888.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎 みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2916","source":"vndb"}]},{"characterId":"char_vndb_c4019","characterName":"杉並","sourceIds":{"vndbCharacterId":"c4019"},"originalCharacterName":"杉並","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Suginami is Jun'ichi and Nemu's classmate and often gives Jun'ichi advice about relationships with girls. Although he is an excellent athlete, a top student, and good-looking, his oddly disturbing personality causes most people to keep their distance from him. He enjoys teasing Mako and dragging Jun'ichi into various situations."}],"source":"vndb","sourceCharacterId":"c4019"}],"profileFacts":[],"metadata