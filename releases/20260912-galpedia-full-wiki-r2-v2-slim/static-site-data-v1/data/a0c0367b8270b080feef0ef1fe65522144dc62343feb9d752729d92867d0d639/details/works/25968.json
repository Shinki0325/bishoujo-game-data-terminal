":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"辰也の実家の近くに住む幼馴染で大学生。"},{"spoiler":false,"text":"小柄でやや幼い外見とおとなしく控えめな性格から、気が弱く見られがちだが、実は芯が強く、マイペース。"},{"spoiler":false,"text":"現在は辰也と会うこともほぼなく、近所付き合い程度の関係。"}],"source":"egs","sourceCharacterId":"16816","sourceWorkId":"25298","spoiler":false},{"segments":[{"spoiler":false,"text":"辰也の実家の近くに住む幼なじみで大学生。"},{"spoiler":false,"text":"やや幼い外見と控えめな性格から気が弱く見られがちだが、実は芯が強くマイペース。"},{"spoiler":false,"text":"現在は辰也と会うこともほぼなく、近所付き合い程度の関係。"},{"spoiler":false,"text":"「辰也くんと一緒にいて……恥ずかしいなんて思ったことないよ」"}],"source":"bangumi","sourceCharacterId":"56175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6f9c795200d6f6464a81eababded17e139df284bfb4ec666c856db6cefca00d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/434d40b5eff003cf7b7e8cfa3293358d22e1c8665ed728a79c8d98894aad7296.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:214353:56175:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74177","source":"vndb"}]},{"characterId":"char_c66428","characterName":"滝川 辰也","sourceIds":{"bangumi":[{"characterId":"56174","match":"exact-normalized-name-in-linked-work","subjectId":"214353"}],"egsCharacterIds":["16815"],"vndbCharacterId":"c66428"},"originalCharacterName":"滝川 辰也","characterNameSource":null,"role":"main","status":"source-only-candidate","identity