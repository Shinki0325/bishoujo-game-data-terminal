{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9011","model":{"presentationWorkId":"vndb:v1243","staff":{"artwork":[{"creditedName":"水原優","creatorId":"vndb:s5166","sourcePersonId":"egs:creator:3387","canonicalEntityId":"vndb:s5166","name":"水原優","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:23138","source":"egs"}],"scenario":[{"creditedName":"春日森(家宇治森)","creatorId":"vndb:s594","sourcePersonId":"egs:creator:2484","canonicalEntityId":"vndb:s594","name":"春日森(家宇治森)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:23139","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c46459","characterName":"リーゼロッテ・ランズベルグ","sourceIds":{"bangumi":[{"characterId":"205583","match":"exact-normalized-name-in-linked-work","subjectId":"223532"}],"egsCharacterIds":["22424"],"vndbCharacterId":"c46459"},"originalCharacterName":"リーゼロッテ・ランズベルグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遊馬に召喚された魔王の娘。通称、リーゼ。"},{"spoiler":false,"text":"外見ではわからないが実年齢は150才。"},{"spoiler":false,"text":"魔王の娘として育ったので、プライドが相当高い。"},{"spoiler":false,"text":"箱入り娘なので世間知らずで性に関しても何もしらない。"},{"spoiler":false,"text":"だからエッチの対しての羞恥心も人一倍。"}],"source":"egs","sourceCharacterId":"22424","sourceWorkId":"9011","spoiler":false},{"segments":[{"spoiler":false,"text":"魔王ゲルトの次女。次期魔王候補。遊馬の祖父・一馬とゲルトが交わした契約により、遊馬に召喚される。"},{"spoiler":false,"text":"魔王の娘としてのプライドが高く、またそれに見合うだけの責任感を持ち、日々鍛錬を怠らない。"},{"spoiler":false,"text":"魔王には溺愛され箱入り娘として育ったため、人界の常識は皆無だが興味は強い。"},{"spoiler":false,"text":"また秘薬等によって魔力の補給を行ってきたため、性知識にも乏しく羞恥心も人一倍強い。"}],"source":"bangumi","sourceCharacterId":"205583"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce9185023925a539cd2a943dd33c3f6e6a832283594747ef74c36ecf0360f6ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ead17b98673e62ed6d989343b39f89ee343e0fa78444f1dfbb161758457aa53b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223532:205583:13512:1","source":"bangumi"}]},{"characterId":"char_c46502","characterName":"ヘレーネ・ランズベルグ","sourceIds":{"bangumi":[{"characterId":"205584","match":"exact-normalized-name-in-linked-work","subjectId":"223532"}],"egsCharacterIds":["22425"],"vndbCharacterId":"c46502"},"originalCharacterName":"ヘレーネ・ランズベルグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"リーゼの姉で、魔王の長女。"},{"spoiler":false,"text":"実年齢は300才。"},{"spoiler":false,"text":"次期魔王として将来を嘱望されていたが、ある事件でリーゼを庇って、魔力の根源である角の片方を折ってしまい、魔王後継者の資格を喪失。それでも、魔界には彼女の魔力を上回る者は、魔王を除いて存在しない。"},{"spoiler":false,"text":"リーゼを魔界に連れ戻しにやってくる。"}],"source":"egs","sourceCharacterId":"22425","sourceWorkId":"9011","spoiler":false},{"segments":[{"spoiler":false,"text":"リーゼの姉。魔王ゲルトの長女。父を超えるほどの資質を備えていると、次期魔王としての将来を嘱望をされていた。"},{"spoiler":false,"text":"今回、帰りの遅いリーゼを連れ戻しに魔界よりやって来る。"},{"spoiler":false,"text":"冷静で知性にも優れ、とある事情で次期魔王の資格を失うも、魔王の補佐とリーゼの後見役を務めるほどの実力を持つ。"}],"source":"bangumi","sourceCharacterId":"205584"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c749ec1177532a7e7f3e911a0abe3248124e05c8514c577311bfaf4b67d655de.webp","fallbackUrl":"http