erId":"132032","match":"exact-normalized-name-in-linked-work","subjectId":"17827"}],"egsCharacterIds":["20586"],"vndbCharacterId":"c8648"},"originalCharacterName":"ヴィクトリア・ザ・キングクリムゾン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マギ（賢者）の像から現れた少女の一人。"},{"spoiler":false,"text":"武の名門家の生まれで、メキメキと頭角を現し、「キングクリムゾン（朱星の真王）」の称号と共に、マギに選ばれる。"},{"spoiler":false,"text":"星震戦争時には、ミューと共に多くのディアブロを倒した英雄。"}],"source":"egs","sourceCharacterId":"20586","sourceWorkId":"10360","spoiler":false},{"segments":[{"spoiler":false,"text":"・装備：エタニティ・ギア「ヴァリアント」"},{"spoiler":false,"text":"・能力：「魂に繋がれした器物（チェインド）」"},{"spoiler":false,"text":"・必殺技：「グングニル」"},{"spoiler":false,"text":"マギ（賢者）の像から現れた女の子の1人。"},{"spoiler":false,"text":"武の名門の生まれだけあって、その方面でメキメキと頭角を現わし、瞬く間にマギに選ばれて「キングクリムゾン（朱星の真王）」の称号を与えられる。"},{"spoiler":false,"text":"星震戦争では、ミューリウスと共に前線に出て、最も多くのディアブロ達を屠った英雄とされている。"}],"source":"bangumi","sourceCharacterId":"132032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e913a046ad4c9099f93218da05620efcbbf7fbff9daa04d1baafc618eed719f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad17715f6d9b37059c53982cdb8000e869b1291eb24b1c5d5c8a803ac45ae487.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17827:132032:8055:1","source":"bangumi"}]},{"characterId":"char_c8649","characterName":"リズ","sourceIds":{"bangumi":[{"characterId":"132034","match":"exact-normalized-name-in-linked-work","subjectId":"17827"}],"egsCharacterIds":["20587"],"vndbCharacterId":"c8649"},"originalCharacterName":"リズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マギ（賢者）の像から現れた少女の一人。"},{"spoiler":false,"text":"星煌教会の研究機関「星錬省」に属する両親の元に生まれ、誕生と同時に洗礼を受けた、生粋の星皇の御遣い。"},{"spoiler":false,"text":"他の者にはない独創的な発想と手法で、多くの星の秘蹟をカタチにした。"}],"source":"egs","sourceCharacterId":"20587","sourceWorkId":"10360","spoiler":false},{"segments":[{"spoiler":false,"text":"・装備：エタニティ・ギア　「ワイスマン」（リズの通称：わーくん）"},{"spoiler":false,"text":"ボーパル・ギア　「モータルサイズ」（リズの通称：もーくん）"},{"spoiler":false,"text":"・能力：「星識彩る無限の煌めき（カレイドスコープ）」"},{"spoiler":false,"text":"・必殺技：「やっちゃえ、わーくん」"},{"spoiler":false,"text":"マギ（賢者）の像から現れた女の子の1人。"},{"spoiler":false,"text":"伝承によれば、星煌教会の研究機関である「星練省」に所属する両親の元に生まれ、誕生と同時に洗礼を受けた生粋の星皇の御遣い。"},{"spoiler":false,"text":"幼いながらも他の追随をゆるさない独創的な発想と手法で、数多くの星の秘蹟をカタチにしたという。"}],"source":"bangumi","sourceCharacterId":"132034"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcdfaee9f246b832c71a1900caf99ff437b2dfec3bb16d5a70fefe3fd9e1b5e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abdf45073768217cd7e6f5b7dfcd76db2c7070a2104c043bc1852cc385f5d0d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田ゆきえ","creatorId":"vndb:s790","sourcePersonId":"vndb:s790","canonicalEntityId":"vndb:s790","name":"前田 ゆきえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17827:132034:3952:1","source":"bangumi"}]},{"characterId":"char_c8650","characterName":"ティア","sourceIds":{"bangumi":[{"characterId":"132035","match":"exact-normalized-name-in-linked-work","subjectId":"17827"}],"egsCharacterIds":["20588"],"vndbCharacterId":"c8650"},"originalCharacterName":"ティア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"何かとカズマの世話を焼く幼馴染。"},{"spoiler":false,"text":"凄まじい魔力の持ち主で、カズマのそばにいても制御できる数少ない人物。"},{"spoiler":false,"text":"だが、一度キレるとカズマがいようがお構いなしに、その魔力を思う存分、暴走させる爆弾娘。"},{"spoiler":false,"text":"にも関わらず、一度も怪我人を出さず身綺麗でいることから、「クレイジーダイヤモンド」との通り名を付けられるが、本人は不服らしい。"}],"source":"egs","sourceCharacterId":"20588","sourceWorkId":"10360","spoiler":false},{"segments":[{"spoiler":false,"text":"・通称：ティア・ザ・クレージーダイアモンド"},{"spoiler":false,"text":"・装備：ドラグゥーン「アストレイ」"},{"spoiler":false,"text":"・能力：「撃ち刻む浄火の刻印（ショットガン・バースト）」"},{"spoiler":false,"text":"・必殺技：「超弩級封滅陣吶喊蹴（ブリューナク・ドライバー）」"},{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"主人公とは打って変わって凄まじい魔力の持ち主で、かつ主人公のそばにいてもその制御が狂うことのない数少ない人物。"},{"spoiler":false,"text":"しかし、それも平常時の事で、一度キレると主人公がいようがいまいが、その凄まじい魔力を暴走させる。"},{"spoiler":false,"text":"にも関わらず、今まで一人の怪我人・死者も出さず「綺麗な」身のままでいることから、マギのそれにあやかって「クレージーダイアモンド」という通り名をつけられた。本人はそんな呼ばれ方をするのは不本意なご様子。"}],"source":"bangumi","sourceCharacterId":"132035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf6a7d95b79f4caa9bc8a26ebe175fcd12a69903e76497a7949467f0bbf8e728.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9b72c726adb3b7e02fc3fa2f8fc8b21d8ba8410dc1564b82728c04e08614c34.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17827:132035:5906:1","source":"bangumi"}]},{"characterId":"char_vndb_c8647","characterName":"ミューリウス・ザ・ゴールドエクスペリアンス","sourceIds":{"vndbCharacterId":"c8647"},"orig