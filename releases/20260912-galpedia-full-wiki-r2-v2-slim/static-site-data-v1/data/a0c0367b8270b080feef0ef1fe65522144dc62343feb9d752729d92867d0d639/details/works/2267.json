 with this one…"},{"spoiler":false,"text":"Edited from a review by Warum"}],"source":"vndb","sourceCharacterId":"c503"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/302921fbaed8cba41ea96950f71348101a831c4569ecf743591b0dde26b56e25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee53402ce5a6c17a90ec3cfa4736f95fe75fff509a44202fc108fd5d6a7b65af.webp","width":256,"height":236,"source":"static-detail"},"actors":[{"creditedName":"鳥居 花音","creatorId":"vndb:s563","sourcePersonId":"vndb:s563","canonicalEntityId":"vndb:s563","name":"森山 理来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4435","source":"vndb"}]},{"characterId":"char_vndb_c54966","characterName":"みここちゃん","sourceIds":{"vndbCharacterId":"c54966"},"originalCharacterName":"みここちゃん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fbade0b2829c233edc71a66d894705395bf0d53ada9273c013fc7e35792d563.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dafcc10fe641011984970fd3c17c7d01d460a4d0fe5976e398b4ed2e31b511d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c54969","characterName":"そあら","sourceIds":{"vndbCharacterId":"c54969"},"originalCharacterName":"そあら","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kageyama Kishin's assistant."}],"source":"vndb","sourceCharacterId":"c54969"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce9aa9f75f75b5e0ad02234343dac7ff2977cac616189d7ae902e1e124cff50b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a464abebe1237d8380941962ad9ba41c88652c0a8449ed0b3dc5350dcdd5cf93.webp","width":256,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c551","characterName":"久我山 若佳菜","sourceIds":{"vndbCharacterId":"c551"},"originalCharacterName":"久我山 若佳菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Homeroom teacher for Kazuki's class, also teaches Language Arts even though she is one of the top software engineers in the country. She drives a red GT2 sports car manually (despite that pretty much everyone else just puts the cars on autopilot by then). Normally she's quite gentle and graceful but her character takes a 180 when she grips the wheel of her car."},{"spoiler":false,"text":"Older sister of Mika, for her sake Wakana tries to replace their mother who died in the past."},{"spoiler":false,"text":"Edited from Warum's review"}],"source":"vndb","sourceCharacterId":"c551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85511964a4727d0b93ca19676b833f9ffde3e052f70a8e653bbb76ebc35a2ca5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2f09bcd4038e3aad8751722071b5e19af742b8980c046665ca60751ad9fa2ec.webp","width":256,"height":236,"source":"static-detail"},"actors":[{"creditedName":"岬 友美","creatorId":"vndb:s128","sourcePersonId":"vndb:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4434","source":"vndb"}]},{"characterId":"char_vndb_c570","characterName":"笹ヶ瀬薫","sourceIds":{"vndbCharacterId":"c570"},"originalCharacterName":"笹ヶ瀬薫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuki's classmate, she's the athlete of the group. Kaoru is the school swim team ace who competes at national level. While at first look she seems to be the cool beauty type, she’s actually quite the trouble maker type and pranks Natsumi all the time. She can be described as being short-tempered and frank, who's rather boyish both inside and outside. Due to all that she is quite popular as a net-idol celebrity."},{"spoiler":false,"text":"She has an awesome petrobot called Ni-gi."},{"spoiler":false,"text":"Edited from a review by Warum"}],"source":"vndb","sourceCharacterId":"c570"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/592cfd29f3836a6a53ea6d4b57e2196cf40d31316e10ad34d3765377447d98d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67faeca39b7e74b91a2c6d1bbcaaec027767a0371ddeb1434a218d44bcc128c0.webp","width":256,"height":236,"source":"static-detail"},"actors":[{"creditedName":"須本 綾奈","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4439","source":"vndb"}]},{"characterId":"char_vndb_c585","characterName":"入間 佐知美","sourceIds":{"vndbCharacterId":"c585"},"originalCharacterName":"入間 佐知美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-