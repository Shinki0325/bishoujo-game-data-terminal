{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"37245","model":{"presentationWorkId":"egs:37245","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_42263","characterName":"Slime","sourceIds":{"bangumi":[{"characterId":"42263","match":"source-roster","subjectId":"221638"}]},"originalCharacterName":"Slime","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"本来のスライムはアメーバ状のどろどろした得体の知れない怪物であり、第1作『ドラゴンクエスト』の制作時に堀井雄二によって描き起こされたスライムのラフスケッチも、そのようなアメーバ状のスライムであった。しかし、「ドラゴンクエストシリーズ」のキャラクターデザインを担当した鳥山明は、「どろどろしたものはデザインしにくい」という理由から、水滴状（タマネギ型とも言われる）の体にグミ状の物質を持ち、大きな丸い目と笑っているかのようなU字型の口を与えて親しみやすいデザインとした。"},{"spoiler":false,"text":"見た目がたいへん愛らしいことからこのシリーズのマスコットキャラクター的存在となり、同シリーズおよび関連作品には必ずこのスライムが登場する。この人気は鳥山にとって予想外であり、「数あるモンスターのなかで、凄い人気が出ちゃったスライム。実は描いたときそんなに入れ込んだキャラじゃなかったんすよね。スライムってドロドロでペシャンコのイメージがあって、それが嫌だから立体に描いた。それだけで人気者になるとは思わなかったっす（笑）。」と語っている。"}],"source":"bangumi","sourceCharacterId":"42263"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10078383ead63e9d2f0e1a18e3dcfa233712130d854d6e73c2ca9f0a7780133e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98d6401b80cfec0ca05abc61c9772315c5bbcbd9435cabcdc1b07a7b377499ab.webp","width":241,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1455","sourceCompanyId":"egs:brand:1015","canonicalEntityId":"vndb:p1455","name":"スクウェア・エニックス(SQUARE ENIX)","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:37245:1015","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mappin