.webp","width":200,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_c70594","characterName":"村井 裕美","sourceIds":{"bangumi":[{"characterId":"149282","match":"exact-normalized-name-in-linked-work","subjectId":"230345"}],"egsCharacterIds":["27633"],"vndbCharacterId":"c70594"},"originalCharacterName":"村井 裕美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる旅館「明星」の従業員のひとり。"},{"spoiler":false,"text":"人付き合いが下手で、誰とも会話を交わそうとしない無口で無感動、常に無表情な少女。"},{"spoiler":false,"text":"従業員同士とも話すことも少なく、当然、主人公とも接しようとしない。"}],"source":"egs","sourceCharacterId":"27633","sourceWorkId":"2026","spoiler":false},{"segments":[{"spoiler":false,"text":"旅館『明星』で働く少女。 無口でほとんど主人公と会話をしようとしません。 感情をほとんど表に出す事もなく、常に無表情です。"},{"spoiler":false,"text":"水鏡京華と良く似たタイプですが、決定的に違うのは京華が意図的に感情を押し殺しているのに対し、裕美は自分の感情を上手く表現する 事が出来ないという点です。"}],"source":"bangumi","sourceCharacterId":"149282"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bb197c471b86c1dcbec93c8b8f3d1d8b65d39ed65077acf0d5c80919c9737fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f8187c7bcd81d191c9944d4bfd8724232beb61b0a607a57cd1d07424cebe573.webp","width":200,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105254","characterName":"水鏡 志郎","sourceIds":{"vndbCharacterId":"c105254"},"originalCharacterName":"水鏡 志郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p339","sourceCompanyId":"egs:brand:557","canonic