,"descriptions":[{"segments":[{"spoiler":false,"text":"学園に通う二年生。"},{"spoiler":false,"text":"学内切っての秀才であり、加えて人望も備えた努力型の優等生。"},{"spoiler":false,"text":"そんな絵に描いたような学生像を、本人は意図して演じてみせている。"},{"spoiler":false,"text":"性格は物事を広く見渡す俯瞰型で、人当たりがよく几帳面。"},{"spoiler":false,"text":"人前では明るく社交的に振る舞いつつも、内心では過ぎゆく日々に空しさと不安を捨てきれない。"},{"spoiler":false,"text":"幼馴染である麻衣子と和泉、その二人との距離の取り方に悩み、もどかしさを感じている。"}],"source":"egs","sourceCharacterId":"11000","sourceWorkId":"14551","spoiler":false},{"segments":[{"spoiler":false,"text":"学園に通う二年生。"},{"spoiler":false,"text":"学内きっての秀才であり、加えて人望も備えた努力型の優等生。"},{"spoiler":false,"text":"そんな絵に描いたような学生像を、本人は意図して演じてみせている。"},{"spoiler":false,"text":"性格は物事を広く見渡す俯瞰型で、人当たりがよく几帳面。"},{"spoiler":false,"text":"人前では明るく社交的に振る舞いつつも、内心では過ぎゆく日々に空しさと不安を捨てきれない。"},{"spoiler":false,"text":"幼なじみである麻衣子と和泉、そのふたりとの距離の取り方に悩み、もどかしさを感じている。"},{"spoiler":false,"text":"「おうよ、ばっちり決めてやるさ。任せとけって」"}],"source":"bangumi","sourceCharacterId":"12130"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a3b32f8ddd626e4ba792a272edaa5962d462ddad2c8ead24980ef3cbc830f2e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a9a01bdfa657a7a37942d7571c9f34e0fff119c1d759f1a4ffb74cd53dc2559.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 一郎","creatorId":"vndb:s7952","sourcePersonId":"vndb:s7952","canonicalEntityId":"vndb:s7952","name":"田中 一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32880","source":"vndb"}]},{"characterId":"char_c75958","characterName":"月島 碧","sourceIds":{"bangumi":[{"characterId":"12129","match":"exact-normalized-name-in-linked-work","subjectId":"11540"}],"egsCharacterIds":["10999"],"vndbCharacterId":"c75958"},"originalCharacterName":"月島 碧","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":