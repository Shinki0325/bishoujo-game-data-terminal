70","canonicalEntityId":"vndb:s4170","name":"兼清 みわ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:123503","source":"vndb"},{"creditedName":"やど","creatorId":"vndb:s4421","sourcePersonId":"vndb:s4421","canonicalEntityId":"vndb:s4421","name":"やど","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:123506","source":"vndb"},{"creditedName":"X壱型改","creatorId":"vndb:s46659","sourcePersonId":"vndb:s46659","canonicalEntityId":"vndb:s46659","name":"X壱型改","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:123507","source":"vndb"},{"creditedName":"鶏野郎","creatorId":"vndb:s46660","sourcePersonId":"vndb:s46660","canonicalEntityId":"vndb:s46660","name":"鶏野郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:123508","source":"vndb"}]},"cast":[{"characterId":"char_c38566","characterName":"間宮 八雲","sourceIds":{"bangumi":[{"characterId":"37698","match":"exact-normalized-name-in-linked-work","subjectId":"143837"}],"egsCharacterIds":["7686"],"vndbCharacterId":"c38566"},"originalCharacterName":"間宮 八雲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"505"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"What she calls the protagonist: Ryou-chan"},{"spoiler":false,"text":"The oldest daughter of the Mamiya quintuplets and a very outgoing and popular girl, she always has a group of people around her. She also has excellent grades and is good at all sports, but she loves swimming the most, especially swimming in the ocean. She does have her clumsy side too. In fact, Yakumo is a very clumsy girl, but she does her best to hide this fact from Ryouta, and look like the perfect older sister in his eyes."},{"spoiler":false,"text":"Like Tamane, Yakumo is not part of any club and instead, spends most of her free time working as a waitress at Seamore. Thanks to her assistance, the sales have raised up and she is quite popular with the customers as well, offering lively and good service to them."},{"spoiler":false,"text":"Like her sisters, she also has a some kind of a kink related to Ryouta. Yakumo has the voice kink, meaning that she immediately turns on whenever Ryouta whispers anything or just sweet nothings to her."}],"source":"vndb","sourceCharacterId":"c38566"},{"segments":[{"spoiler":false,"text":"五つ子の長女で一番のお姉さん的存在。"},{"spoiler":false,"text":"成績優秀・スポーツ万能。"},{"spoiler":false,"text":"特に水泳が得意で、海で遊ぶのが大好き。"},{"spoiler":false,"text":"明るく活発で、人を惹きつける魅力を持っている。"},{"spoiler":false,"text":"そのため、周囲にはいつも人が集まっていて賑やか。"},{"spoiler":false,"text":"学園では部活や委員会には所属していないものの、高いスポーツ能力を買われて色々な部活動から助っ人を依頼されている。"},{"spoiler":false,"text":"『カフェシーモア』ではウェイトレスをしており、人当たりの良い明るい接客で人気を博している。"},{"spoiler":false,"text":"……なのだが、実はドジっ子。"},{"spoiler":false,"text":"しかし、良太の前では完璧なお姉ちゃんとして振る舞おうと努力しているので、良太は八雲がドジっ子であることを知らない。"}],"source":"egs","sourceCharacterId":"7686","sourceWorkId":"22475","spoiler":false},{"segments":[{"spoiler":false,"text":"五つ子の長女で、一番のお姉さん的存在。"},{"spoiler":false,"text":"明るく活発で人を惹きつける魅力があり、周囲にはいつも人が集まっていて賑やか。"},{"spoiler":false,"text":"成績優秀・スポーツ万能。 特に水泳が得意で、海で遊ぶのが大好き。"},{"spoiler":false,"text":"部活には所属していないものの、運動神経を買われて助っ人をすることも。"},{"spoiler":false,"text":"シーモアではウエイトレスをしていて、人当たりの良い明るい接客で人気。"},{"spoiler":false,"text":"実はドジっ子だけど、良太の前では完璧なお姉ちゃんとして振る舞う努力をしている。"},{"spoiler":false,"text":"そのため良太は、八雲がドジっ子であることを知らない。"},{"spoiler":false,"text":"良太を独占するためエッチに積極的。 新技を開発・研究し、思い付いたら即実行。"},{"spoiler":false,"text":"さらに良太の声フェチで、良太に囁かれるだけで濡らしてしまう。"},{"spoiler":false,"text":"「良ちゃんが愛しくて愛しくて、お姉ちゃん胸が苦しいな」"}],"source":"bangumi","sourceCharacterId":"37698"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"37698","value":"2年"},{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"7686","sourceWorkId":"22475","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"7686","sourceWorkId":"22475","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"7686","sourceWorkId":"22475","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"7686","sourceWorkId":"22475","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"7686","sourceWorkId":"22475","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a433512e233f7beb8e1d972d32f3493584ef3431787ed3c56efa84866cd22f2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8060e08869d9235eee8f91b84f9ad9f28e8b6052939e08f12feee06dfacf687b.webp","width":80,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:143837:37698:7302:1","source":"bangumi"}]},{"characterId":"char_c38567","characterName":"間宮 萌莉","sourceIds":{"bangumi":[{"characterId":"37699","match":"exact-normalized-name-in-linked-work","subjectId":"143837"}],"egsCharacterIds":["7687"],"vndbCharacterId":"c38567"},"originalCharacte