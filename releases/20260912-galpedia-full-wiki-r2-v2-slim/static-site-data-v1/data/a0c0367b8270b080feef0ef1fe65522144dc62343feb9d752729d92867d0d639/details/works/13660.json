poiler":false,"text":"窓からも入らず玄関から入る。甘い関係は一切なし。"},{"spoiler":false,"text":"最近ではテニスに没頭し、舞い戻ってきた主人公とも疎遠気味である。"}],"source":"egs","sourceCharacterId":"2867","sourceWorkId":"13660","spoiler":false},{"segments":[{"spoiler":false,"text":"団地のお隣さん幼なじみ。"},{"spoiler":false,"text":"だが甘い関係は一切なし。"},{"spoiler":false,"text":"幼い頃は、衛・モモとの3人で一緒に過ごしていたが、最近ではテニスに没頭して遊ぶことは一切ない。"},{"spoiler":false,"text":"しかし最近はスランプのようで、すこぶる不機嫌。"},{"spoiler":false,"text":"衛をからかっては、ストレス発散をしている。"},{"spoiler":false,"text":"「3年だよ。 思い出づくりも悪くないじゃない」"}],"source":"bangumi","sourceCharacterId":"23407"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"23407","value":"鎌鞍学園3年生"},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"2867","sourceWorkId":"13660","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"2867","sourceWorkId":"13660","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0897b56a64b53c3c6ab56b08194cbcf94133eee49c78189dba3ed63d38616b39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caaffbb6ddd952be8dbb270b2724ec46f4b148cf0395e1fe7cb1b23970650fa0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94397:23407:20696:1","source":"bangumi"}]},{"characterId":"char_c3379","characterName":"こもも","sourceIds":{"bangumi":[{"characterId":"23406","match":"exact-normalized-name-in-linked-work","subjectId":"94397"}],"egsCharacterIds":["2866"],"vndbCharacterId":"c3379"},"originalCharacterName":"こもも","characterNameSource":null,"role":"primary","status":"source-only-candidate","identi