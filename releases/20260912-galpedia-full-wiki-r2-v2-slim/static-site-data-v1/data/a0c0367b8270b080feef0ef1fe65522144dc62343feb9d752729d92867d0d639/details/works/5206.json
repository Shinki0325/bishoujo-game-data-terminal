rId":"485"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"485","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"主要是在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"作为博丽巫女的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"操纵灵气的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33007c417ade7c73b7ee78244285c2ff601da86919605a6f56c0570deb01c0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc26d83763ce8144e0a342eaeb5a41bf3e1756ec782d0268170ef9bac39c8489.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_486","characterName":"霧雨魔理沙","sourceIds":{"bangumi":[{"characterId":"486","match":"source-roster","subjectId":"104009"},{"characterId":"486","match":"source-roster","subjectId":"1146"},{"characterId":"486","match":"source-roster","subjectId":"1148"},{"characterId":"486","match":"source-roster","subjectId":"1150"},{"characterId":"486","match":"source-roster","subjectId":"1151"},{"characterId":"486","match":"source-roster","subjectId":"1153"},{"characterId":"486","match":"source-roster","subjectId":"1155"},{"characterId":"486","match":"source-roster","subjectId":"1157"},{"characterId":"486","match":"source-roster","subjectId":"1160"},{"characterId":"486","match":"source-roster","subjectId":"12696"},{"characterId":"486","match":"source-roster","subjectId":"131875"},{"characterId":"486","match":"source-roster","subjectId":"1395"},{"characterId":"486","match":"source-roster","subjectId":"2134"},{"characterId":"486","match":"source-roster","subjectId":"329342"},{"characterId":"486","match":"source-roster","subjectId":"430567"},{"characterId":"486","match":"source-roster","subjectId":"5752"},{"characterId":"486","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"霧雨魔理沙","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"居住于魔法森林的人类魔法使，常骑着扫把，「霧雨店」的独生女。會使用魔法森林的蘑菇調製火藥，所使用的魔法幾乎只有把東西破壞的效果，而且燃料需要長時間準備，但是其效果非常強力，在Spell Card規則成立下，純粹的破壞力在人類當中屬於最高等級。此外在幻想乡是出了名的小偷，帕邱莉的图书馆、香霖堂，如果不是古明地觉会读心术，甚至连地灵殿都会惨遭毒手。"}],"source":"bangumi","sourceCharacterId":"486"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"486","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"486","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e00e4df671f5f80d5733c44e4b69596b901aad88177fc335789c2dd5ea6b2d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bd6c6ab5c1df20f216ccf8f7e1581841d4fed04fe2cad0f92ce726df7fb8d1.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_488","characterName":"知识与避世的少女","sourceIds":{"bangumi":[{"characterId":"488","match":"source-roster","subjectId":"1146"},{"characterId":"488","match":"source-roster","subjectId":"1148"},{"characterId":"488","match":"source-roster","subjectId":"1150"},{"characterId":"488","match":"source-roster","subjectId":"1151"},{"characterId":"488","match":"source-roster","subjectId":"1153"},{"characterId":"488","match":"source-roster","subjectId":"1155"},{"characterId":"488","match":"source-roster","subjectId":"2134"}]},"originalCharacterName":"知识与避世的少女","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大概有100岁的魔女，平常待在红魔馆里面的图书馆的知识分子，有气喘的毛病。擅长操纵七曜（火水木金土日月），名言是“凡物都有属性。所谓的属性，跟弱点是一样的东西”。"},{"spoiler":false,"text":"Patchouli→广藿香（一种香草，因此她有“帕琪”“香草”一类的昵称），Knowledge→知识"}],"source":"bangumi","sourceCharacterId":"488"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"488","value":"魔女、魔法使"},{"label":"能力","source":"bangumi","sourceCharacterId":"488","value":"使用魔法程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"488","value":"使用魔法（主要是属性）程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"488","value":"使用魔法（主要是精灵魔法）的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"488","value":"操纵火+水+木+金+土+日+月的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8493e88bcc7680de30e8b9e6e66890ad487612a220d97d4b7f4da9fa8fe97d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de86334f8179285b5b96f03c533ec39d91050913e666646d4b78d3ba0862f3c0.webp","width":151,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_491","characterName":"萃集的梦想、虚幻、以及百鬼夜行","sourceIds":{"bangumi":[{"characterId":"491","match":"source-roster","subjectId":"1153"},{"characterId":"491","match":"source-roster","subjectId":"1155"},{"characterId":"491","match":"source-roster","subjectId":"2134"},{"characterId":"491","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"萃集的梦想、虚幻、以及百鬼夜行","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伊吹萃香是不知为何会出现在幻想乡的鬼，由于幻想乡有相当长的时间没出现过鬼，对于驱鬼的方法已经失传许久，没人会退治鬼，大家都感到为难。因此萃香和其他的鬼才能定居下来。"},{"spoiler":false,"text":"虽然外表是一个小女孩，看上去并不吓人，但她是一只已活了几百年的鬼，拥有将事物集结与分散程度的能力，和着让人害怕的怪力。她曾夸下海口，只要她想，就能凭一人之力将妖怪之山推倒。"},{"spoiler":false,"text":"萃香十分喜欢喝酒，常带着一个酒葫芦并喝得醉醺醺的，在东方的三款格斗游戏中，都可以看到她走路是摇摇晃晃的。其原形来自于鬼头目之中的“酒吞童子”。"},{"spoiler":false,"text":"性格豪爽，喜欢酒与宴会，天真而且单纯，喜欢和人一较高下，像是小孩子的性格。"},{"spoiler":false,"text":"其名字“萃香”与“西瓜”的日文发音相同，故昵称为“西瓜”。"}],"source":"bangumi","sourceCharacterId":"491"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"491","value":"鬼"},{"label":"能力","source":"bangumi","sourceCharacterId":"491","value":"操纵疏和密程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b26c2b4a7516dd3021fca524fbac36766a3a15ac6c0f0608e8985f863fd908e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cf3c4a5114c940dc5fe2dbcd5a1e16e20ce962712501a7e576be5ba0e14de42.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_891","characterName":"中国","sourceIds":{"bangumi":[{"characterId":"891","match":"source-roster","subjectId":"1146"},{"characterId":"891","match":"source-roster","subjectId":"1151"},{"characterId":"891","match":"source-roster","subjectId":"1153"},{"characterId":"891","match":"source-roster","subjectId":"2134"}]},"originalCharacterName":"中国","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"红魔馆的门卫，外表和人类一样，身穿中国风的服装，身手敏捷，擅长武术，很少使用奇怪的妖术。"}],"source":"bangumi","sourceCharacterId":"891"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"891","value":"妖怪"},{"label":"能力","source":"bangumi","sourceCharacterId":"891","value":"运用气程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89eb0b92b5535ad1b1d26f43e6a8b3f7aa420498af3bc36262c7bacddbe9d2d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c77ddb506dcd6dddad5701b208b0e10e4902210cb7a30d86a578a52d2228f52.webp","width":126,"height":254,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:1774","sourceCompanyId":"egs:brand:1774","canonicalEntityId":"egs:brand:1774","name":"黄昏フロンティア","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:5206:1774","source":"egs"}],"missingStates":["confirmed-character-relation-missing","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
