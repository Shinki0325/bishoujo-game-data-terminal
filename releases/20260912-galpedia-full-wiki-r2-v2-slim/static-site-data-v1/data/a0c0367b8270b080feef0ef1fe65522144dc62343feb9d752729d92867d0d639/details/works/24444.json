s":[{"segments":[{"spoiler":false,"text":"新人である冬馬の面倒を見てくれる先輩社員。冬馬と同年代だがセントレアード株式会社に先に入社している。"},{"spoiler":false,"text":"入社した時から優秀で、一歩一歩堅実に仕事をこなしていた事もあり、最近新プロジェクトを任されている。"},{"spoiler":false,"text":"人当たりも良く、気が利いて可愛らしいのだが、実は彼女の本質は……。ぐーたらで面倒くさがり屋。"},{"spoiler":false,"text":"休日はテレビの前から動かなくて良いように準備し、だらだらと一日を過ごす事が生きがい。"},{"spoiler":false,"text":"そんな彼女だから恋をしたこともないし、興味も無かった。他人に明かせない姿を冬馬に知られてしまったことで、彼女の気持ちに変化が起きはじめる。"}],"source":"egs","sourceCharacterId":"13238","sourceWorkId":"24444","spoiler":false},{"segments":[{"spoiler":false,"text":"新人である冬馬の面倒を見てくれる先輩社員。"},{"spoiler":false,"text":"入社した時から優秀で、現在は新プロジェクトを任されている。"},{"spoiler":false,"text":"人当たりが良く、気が利いて可愛らしいのだが、実は彼女の本質は……。"},{"spoiler":false,"text":"休日はテレビの前から動かなくていいように準備して、だらだら過ごしている。"},{"spoiler":false,"text":"そんな彼女だから恋をしたこともないし、興味も無かった。"},{"spoiler":false,"text":"しかし冬馬に本性を知られてしまったことで、気持ちに変化が起きはじめる。"},{"spoiler":false,"text":"「面倒くさがりじゃなくて、必要なことしかしないだけ。 勘違いしちゃダメだからね」"}],"source":"bangumi","sourceCharacterId":"48575"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/948954e6302e3fe70bdfc1e1152a33fa94845d7c76d1c311e7c6a94df114e6b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bc26d1fc2f135dc16c6740eccb3924393f6a3e263ad637a99035b7d0cb8ca7c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197097:48575:5936:1","source":"bangumi"}]},{"characterId":"char_c54793","characterName":"瀬良 忍","sourceIds":{"bangumi":[{"characterId":"48576","match":"exact-normalized-name-in-linked-work","subjectId":"197097"}],"egsCharacterIds":["13239"],"vndbCharacterId":"c54793"},"originalCharacterName":"瀬良 忍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"営業統括部のナンバー2で、皆からの信頼も厚い。"},{"spoiler":false,"text":"約1年前に若さに似合わぬポジションを用意され、ヘッドハンティングされた逸材。"},{"spoiler":false,"text":"当時は特別扱いの忍への風当たりも強かったが、実力と人柄で周囲を納得させた努力型の秀才。"},{"spoiler":false,"text":"人柄も含め非常に優秀すぎるので、昔から高嶺の花と思われがち。そのせいで浮ついた話は一切なく、恋愛経験もゼロに等しい。"},{"spoiler":false,"text":"食事などの誘いもあまり無かったが、新入社員の冬馬が気さくに誘ってきてくれて嬉しい様子。"},{"spoiler":false,"text":"なお、休みの日にはアニメショップに通っているという……。"}],"source":"egs","sourceCharacterId":"13239","sourceWorkId":"24444","spoiler":false},{"segments":[{"spoiler":false,"text":"営業統括部のNo.2で、皆からの信頼も厚い女性。"},{"spoiler":false,"text":"1年ほど前にヘッドハンティングされた逸材で、"},{"spoiler":false,"text":"当時は社内の風当たりも強かったが、実力と人柄で周囲を納得させた努力型の秀才。"},{"spoiler":false,"text":"優秀すぎるため高嶺の花と思われがちで、浮ついた話はなく恋愛経験はゼロ。"},{"spoiler":false,"text":"食事などのお誘いもあまりなかったが、冬馬が気さくに誘ってきてくれて嬉しい様子。"},{"spoiler":false,"text":"なお、休みの日にはアニメショップに通っているらしい……。"},{"spoiler":false,"text":"「あら、ふふふ。 もう少しがんばってみましょ？」"}],"source":"bangumi","sourceCharacterId":"48576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/794ed2fc65240ead46b8ff9e15ffd8832134b3496333ab7ffaa4bb5a7ef94f85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2229f4e00b0bdac1a690e66ee5e30fba6ad143dd056b6ae8932785b819ebfd6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197097:48576:5741:1","source":"bangumi"}]},{"characterId":"char_c54794","characterName":"双葉 みこと","sourceIds":{"bangumi":[{"characterId":"48578","match":"exact-normalized-name-in-linked-work","subjectId":"197097"}],"egsCharacterIds":["13240"],"vndbCharacterId":"c54794"},"originalCharacterName":"双葉 みこと","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冬馬の会社の近くにある小さなお弁当屋『いこい』で働く学生。"},{"spoiler":false,"text":"母と妹と暮らしている。"},{"spoiler":false,"text":"小さなお弁当屋「いこい」は、実家兼店舗で、母が店主を務めている。決して裕福ではないが、愛情深き家庭で育つ。"},{"spoiler":false,"text":"育ててくれた父母へ感謝の気持ちで、仕事と学業を頑張っている。恋愛など年相応な興味を持ち「いつか素敵な人が現れないかな……」と思っている。"},{"spoiler":false,"text":"最近の悩みは仕事や家事が忙しく、勉強が追いつかなくなってきたこと。"}],"source":"egs","sourceCharacterId":"13240","sourceWorkId":"24444","spoiler":false},{"segments":[{"spoiler":false,"text":"会社の近くにある小さなお弁当屋『いこい』で働く学生。"},{"spoiler":false,"text":"母・妹と3人で暮らしていて、『いこい』は実家 兼 店舗。"},{"spoiler":false,"text":"母が店主を務め、裕福ではないが愛情深い家庭を築いている。"},{"spoiler":false,"text":"育ててくれた父母へ感謝の気持ちを抱き、仕事と学業を頑張っている。"},{"spoiler":false,"text":"恋愛にも年相応な興味を持ち、「いつか素敵な人が現れないかな……」と思っている。"},{"spoiler":false,"text":"最近の悩みは仕事や家事が忙しく、勉強が追いつかなくなってきたこと。"},{"spoiler":false,"text":"「も、もう、私がいないとダメなんだから。 な、なーんて…… きゃっ」"}],"source":"bangumi","sourceCharacterId":"48578"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a68a1564ee6c0edac64c420ccfc9153aba83d2352a9dbf469a018df3b7d29446.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/059a8939af5433a13099e0216c105ffaba2227fc2ca8ad5a13ff6aa90423797d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹内仁美","creatorId":"vndb:s978","sourcePersonId":"vndb:s978","canonicalEntityId":"vndb:s978","name":"羽鳥いち","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:c