d":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:948","source":"vndb"}]},{"characterId":"char_vndb_c12333","characterName":"樋口 三郎","sourceIds":{"vndbCharacterId":"c12333"},"originalCharacterName":"樋口 三郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Saburou is Masaomi's fellow Special High Class Individual cadet."},{"spoiler":true,"text":"He is Ken's step-father and Ririko's father."}],"source":"vndb","sourceCharacterId":"c12333"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5e5791fb2bdd2816f281b618baf819e8bd80e364e3644771fe92e2b82eff8c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/732b7ca2f2ede073a44058accf4897a874aced0c8d0b506eb2226469f05a2dda.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後野 祭","creatorId":"vndb:s1067","sourcePersonId":"vndb:s1067","canonicalEntityId":"vndb:s1067","name":"中國 卓郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:954","source":"vndb"}]},{"characterId":"char_vndb_c1374","characterName":"三ツ廣 さち","sourceIds":{"vndbCharacterId":"c1374"},"originalCharacterName":"三ツ廣 さち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sachi is a girl with an energetic and vibrant personality, at odds with her habits of dozing off at school and procrastinating whenever an opportunity to do work presents itself. She is hardly fazed by Kenichi's exterior and is the first to become friends with him. An orphan, she earns money through internet speculation, and shares her apartment in the school dormitory with a little girl from the Southern Country named Mana. In the past, she had a hobby of painting, but she has not done this since her parents died."},{"spoiler":false,"text":"Her obligation is to have a \"12 Hour Day\" - after being awake for twelve hours, she must 'stop' by taking medicine which knocks her unconscious for another twelve hours. This medicine is not particularly effective at relieving fatigue, and she often naps for a good portion of the remaining hours."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1374"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/950a2a0642b26e4df572f15aafab48a818521504c090fe270902b82791eefc36.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcd9bcb99d23a1c16dacd3e32b1902236107459b119815a18b07c6907108ef9d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:947","source":"vndb"}]},{"characterId":"char_vndb_c1375","characterName":"樋口 璃々子","sourceIds":{"vndbCharacterId":"c1375"},"originalCharacterName":"樋口 璃々子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Ririko is Kenichi's elder sister, though not by blood. After their father's failed rebellion, she was captured and, due to the Involvement Clause (which visits the sins of the parent upon the child), given the \"Maximum Penalty\", the obligation to 'go unrecognized by the world'."},{"spoiler":true,"text":"Any contact with her is prohibited, be it verbal or physical, and violators will be sent to a concentration camp. The only individual permitted to interact with her in any way is her supervising Special High Class Individual, Houzuki Masaomi. Kenichi's ultimate goal in passing his Exam is to become the new Special High Class Individual to be placed in charge of her, allowing him to interact with her and giving her a kind of reprieve from her 'obligation'."},{"spoiler":true,"text":"She was Touka's neighbour for a short time, and is largely responsible for molding her current tsundere personality."}],"source":"vndb","sourceCharacterId":"c1375"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cba1369f34fc3616f62b3d9f83f355977720b7484c9598b3f8a8494d3a9d03eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f893e52b741c8057554eee62082d5a0cc7ef51102ca04ad5dce7e16e472a06c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"籐野 らん","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤 邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:951","source":"vndb"}]},{"characterId":"char_vndb_c1383","characterName":"森田 賢一","sourceIds":{"vndbCharacterId":"c1383"},"originalCharacterName":"森田 賢一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kenichi is the protagonist of Sharin no Kuni. Despite being the youngest person to ever become a Special High Class Individual cadet, he has already distinguished himself as a CEO and a combatant in the Southern Country's foreign legion. Often considered slightly unhinged from the latter experience, he has a habit of talking to himself and making jokes other people rarely find funny. Despite his arrogant exterior, he has a strong sense of justice, which often clashes with the values of the country he serves. Being an SHCI candidate, Kenichi is a multitalented genius who is highly skilled in many areas such as Small Arms combat, Martial Arts, Business and Moneymaking, and even Spelunking, and possesses near-superhuman endurance and a charisma which endears him to nearly all whom he meets. He also has a habit of breaking the fourth wall when speaking to himself, referring to \"you\""},{"spoiler":true,"text":", but in reality he is actually speaking with his sister Higuchi Ririko."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1383"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/465d560c299ffd9dcc32350744d6f6f75f504b4c5bc38d493f954b82a5d63ef3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c2a3c2158b5b577df0fdafe15c115855e6750d0d3bb45c2f695814cfa384bda.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1385","characterName":"磯野 一郎太","sourceIds":{"vndbCharacterId":"c1385"},"originalCharacterName":"磯野 一郎太","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A classmate of Kenichi's, Sepia is the one person able to outdo his eccentricity. He claims to be able to talk to fairies and often speaks about bizarre subjects, inevitably incurring Touka's wrath. A fanatical devotee of Higuchi Saburou, leader of the civil uprising in the past, he resents Kenichi for being a 'dog of the nation'. He is romantically infatuated with Touka's mother, Kyouko."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1385"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2219a9e85fc6965cf65c511be02d3008a900aacdf3d8960b23b5f7198962b444.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5eb50eaed9d89dc2814c68aac5fc6ee2623076afbcaa463af22db6bc908b35a0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"盛 啓介","creatorId":"vndb:s1056","sourcePersonId":"vndb:s1056","canonicalEntityId":"vndb:s1056","name":"盛啓介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:953","source":"vndb"}]},{"characterId":"char_vndb_c1386","characterName":"大音 京子","sourceIds":{"vndbCharacterId":"c1386"},"originalCharacterName":"大音 京子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A teacher at the school Kenichi attends. She has a mild personality and is popular among her students, but can be harshly over-protective when it comes to her daughter, Touka. She is hypersensitive to words with a \"dog\" connotation."}],"source":"vndb","sourceCharacterId":"c1386"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93163a69c1b63803358f53bb7e732d5f30708390b3c3304b12ac00b427d4947b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4db863da722f3e44856f09e57b6a081d45388dd79e3419ada11b931aca830e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:945","source":"vndb"}]},{"characterId":"char_vndb_c1387","characterName":"法月 将臣","sourceIds":{"vndbCharacterId":"c1387"},"originalCharacterName":"法月 将臣","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Houzuki is the Special High Class Individual supervising Kenichi's examination. Despite being lame in one leg from a war injury and walking with a cane, he is an intimidating individual who unnerves even Kenichi. Relentlessly dedicated to society, he is not above manipulating anyone—even his own protégé—to produce what he perceives as the most favorable result for the future of the country."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1387"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44f8f0c4cf9248b7707c114da341ba521a5a4fb51cff9565364df787d49e8535.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b86dc957b17a0618cf73d02c12deb2b5ece7a7f8004b36d0c6d186bb4a41d57a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さとう 雅義","creatorId":"vndb:s8","sourcePersonId":"vndb:s8","canonicalEntityId":"vndb:s8","name":"若本 規夫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:944","source":"vndb"}]},{"characterId":"char_vndb_c15692","characterName":"アンテリアム・ド・ムァヌー","sourceIds":{"vndbCharacterId":"c15692"},"originalCharacterName":"アンテリアム・ド・ムァヌー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mana after having separated from Sachi for several years. She has changed her name along with her station in life."}],"source":"vndb","sourceCharacterId":"c15692"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/634c0817048d3786354b0331df2af95718b3e707b8a00cf03fc00cd1d2fcb961.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3c44267d9cef030f9141d3ceb0627f97aec36cb3104a7bff49ea5d584ae16e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神月 あおい","creatorId":"vndb:s454","sourcePersonId":"vndb:s454","canonicalEntityId":"vndb:s454","name":"亜城 めぐ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:946","source":"vndb"}]},{"characterId":"char_vndb_c15779","characterName":"アリィ・ルルリアント・法月","sourceIds":{"vndbCharacterId":"c15779"},"originalCharacterName":"アリィ・ルルリアント・法月","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ari Ruruliant Houzuki is the Special High Class Individual supervising Higuchi Saburou and Akutsu Masaomi."}],"source":"vndb","sourceCharacterId":"c15779"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05059605b03c3424da9529a05d8828b3eca398f5a6687071ed2b3af3dbb84197.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca0fad33ea74ea22a8c577b3faeaebe727db9acd9c583f86468421779a559811.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篠崎 双葉","creatorId":"vndb:s752","sourcePersonId":"vndb:s752","canonicalEntityId":"vndb:s752","name":"折笠 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:950","source":"vndb"}]},{"characterId":"char_vndb_c191","characterName":"大音 灯花","sourceIds":{"vndbCharacterId":"c191"},"originalCharacterName":"大音 灯花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Touka is the class president, an outspoken and brash girl who has no patience for Kenichi's behavior and often acts violently towards him. She is the worst student in the class due to being prone to careless mistakes, and this clumsiness is physical as well. Due to her obligation, she has a tenuous relationship with her mother Kyouko. She secretly wants to become a cook, but is prohibited from entering the kitchen due to an accident when she was young."},{"spoiler":false,"text":"Her obligation is \"Prohibited from Becoming an Adult\" - meaning that she must obey every order given to her by her parental figure, Kyouko. Burdened with unreasonable restrictions such as an hour-by-hour daily schedule, and a prohibition from watching TV or reading books except for studying, she often seeks small ways to rebel."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c191"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85e093b6276768de45ddf861760667b37cde36d4fb47648fd699c40c1377df4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4ab0af25362a2f1bb87cb46432f86aa7edebbaafd36b5795af6245b79007b34e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紫華 すみれ","creatorId":"vndb:s1055","sourcePersonId":"vndb:s1055","canonicalEntityId":"vndb:s1055","name":"神崎 ちろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:952","source":"vndb"}]},{"characterId":"char_vndb_c26373","characterName":"阿久津 将臣","sourceIds":{"vndbCharacterId":"c26373"},"originalCharacterName":"阿久津 将臣","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c6d9e1ec03749f9687318386819704382049b9e51ca9c836b91dab343b73f68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7964a127d54db6196604a5b5d5c5c0241ae26f271fe06b0635b285329be459a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c30087","characterName":"南雲 えり","sourceIds":{"vndbCharacterId":"c30087"},"originalCharacterName":"南雲 えり","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25df374bf7164712ee8d8ada6bde0a0f39210a2bd307e48885dc1bd7a9adbb29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3091302a85c434ecb8856d0888d7a0ba667302a46e64da96209fccacb12e7fb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田 まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:949","source":"vndb"}]},{"characterId":"char_vndb_c506","characterName":"日向 夏咲","sourceIds":{"vndbCharacterId":"c506"},"originalCharacterName":"日向 夏咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first person Kenichi meets upon his return to the town, Natsumi is an extremely shy girl who is prone to stuttering and spacing out in the midst of conversations. She is often concerned that she is a bother to other people, making it difficult for her 'friends' - Sachi and Isono - to involve her in anything. She is an orphan as well, and has few hobbies of her own except for taking strolls around the sunflower field outside of town. She is the main heroine of the story."},{"spoiler":false,"text":"Her obligation is \"Prohibited from Falling in Love\" - considered one of the most severe obligations, she cannot have any physical contact with the opposite sex. Due to her introverted personality, she is hardly inconvenienced by this, and seems to have a fear of being touched above and beyond the consequences of violating her obligation..."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c506"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a7a36ae7593723ddc5fdcc2558bba9b3eb2ce2699f8d912eece464891291b0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd22db8af759d44b188f37aaf659d64fa6c4da9154962584a8d1c936fc6da770.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新城 麻奈","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relation