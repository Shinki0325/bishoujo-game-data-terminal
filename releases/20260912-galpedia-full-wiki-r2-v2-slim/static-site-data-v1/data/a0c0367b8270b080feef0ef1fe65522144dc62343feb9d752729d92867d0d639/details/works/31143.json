acterId":"c120129"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"空賀 花","creatorId":"vndb:s15476","sourcePersonId":"vndb:s15476","canonicalEntityId":"vndb:s15476","name":"空賀 花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87906","source":"vndb"}]},{"characterId":"char_vndb_c97599","characterName":"湊 汐里","sourceIds":{"vndbCharacterId":"c97599"},"originalCharacterName":"湊 汐里","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"519"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: Chrysanthemum, First Year"},{"spoiler":false,"text":"Club Affiliation: Sewing Club"},{"spoiler":false,"text":"A quiet, gentle, nondescript girl. However, she's quick-thinking and has a strong sense of self. She enjoys sewing and crocheting, and has a tendency to get lost in her own little world. When Mikoto asks her out, she senses something guarded about her that intrigues her. Although she doesn't understand Mikoto's true intentions, she decides to do her best to make things work between them. Aoi seems to like her and often talks to her, but she doesn't know what her intentions might be, either."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c97599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4b72ffb393acd6b6201145f375dfe05730ddf38f592fa2bd4a869464a6083a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d773771d9f2ff3427ff077bf986c6da1bdaa542b51e69251a42cbdfee0dadf02.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"門脇 舞以","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"門脇 舞以","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87904","source":"vndb"}]},{"characterId":"char_vndb_c97600","characterName":"倉橋 海琴","sourceIds":{"vndbCharacterId":"c97600"},"originalCharacterName":"倉橋 海琴","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"811"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: Camellia, Second Year"},{"spoiler":false,"text":"Club Affiliation: None"},{"spoiler":false,"text":"One of the prettiest and most popular girls in school. She receives a lot of love letters, but dislikes how many people ask her out based on her looks alone. Cool and aloof, she prefers to be on her own, and isn’t often found hanging out with other girls. She cares deeply for her sickly younger sister, Yumi, and has always felt a strong duty to protect her. However, she herself seems to rely on Yumi in some ways. She starts dating Shiori in order to keep Yumi safe, despite suspecting that Shiori is her blackmailer."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c97600"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffe7a54b903ce4ab631080319a63f7d21bbce2a9f72e8edfa1fabc3ff2c7cd7d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0703ca2fba41720f77fdacd4b92ea5d4e10c46cdd285a1b997be229e2a1d2b29.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉知 玲鳳","creatorId":"vndb:s23819","sourcePersonId":"vndb:s23819","canonicalEntityId":"vndb:s23819","name":"倉知 玲鳳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87908","source":"vndb"}]},{"characterId":"char_vndb_c97601","characterName":"倉橋 結海","sourceIds":{"vndbCharacterId":"c97601"},"originalCharacterName":"倉橋 結海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"315"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: Lily, First Year"},{"spoiler":false,"text":"Club Affiliation: None"},{"spoiler":false,"text":"Mikoto's younger sister. She's been sick from a very young age. When at school, she spends most of her time in Infirmary Room 2, studying on her own, although she's often absent from school altogether due to hospitalizations and appointments. Since no one else spends as much time in the infirmary as she does, she treats the room as her own, decorating it with her personal things. She usually has her nose in a book and, having had to grapple with her own mortality, has a more mature personality than her elder sister and a more philosophical outlook on life."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c97601"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43ba336d7d1aa0da940e9edf182efac1f83a4f751f18d0c59d30ffadd47db73a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df17377e5180846044c5f5398e2c8bf5764ab734cb7fbae8991b9849611700cb.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春岡 沙和","creatorId":"vndb:s5545","sourcePersonId":"vndb:s5545","canonicalEntityId":"vndb:s5545","name":"春岡 沙和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87907","source":"vndb"}]},{"characterId":"char_vndb_c97602","characterName":"相場 真帆","sourceIds":{"vndbCharacterId":"c97602"},"originalCharacterName":"相場 真帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"215"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: Chrysanthemum, First Year"},{"spoiler":false,"text":"Club Affiliation: Social Issues Society"},{"spoiler":false,"text":"Shiori's good friend and classmate, she's a kind and caring girl with a bubbly personality and a penchant for gossip. She puts others before herself and is a late bloomer when it comes to romance. As Yumi's confidante, she sometimes visits her in the infirmary and delivers letters on her behalf."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c97602"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60730c8d148e56de1beec8997e3a8f0c608e77970219cfb36b266b07e90a0e3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ece15bb35d6334611e2bb706d22efb9ae9a2cdbfe238b23bfbdb5ab7328f523.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"戸坂 美月","creatorId":"vndb:s23820","sourcePersonId":"vndb:s23820","canonicalEntityId":"vndb:s23820","name":"戸坂 美月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87909","source":"vndb"}]},{"characterId":"char_vndb_c97603","characterName":"立花 碧","sourceIds":{"vndbCharacterId":"c97603"},"originalCharacterName":"立花 碧