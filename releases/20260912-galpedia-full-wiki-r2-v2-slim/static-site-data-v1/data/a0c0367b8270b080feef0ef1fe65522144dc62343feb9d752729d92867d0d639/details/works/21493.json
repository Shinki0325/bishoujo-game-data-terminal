dentityStatus":"source-native","relationId":"vndb:vn-staff:127737","source":"vndb"},{"creditedName":"Yoshiro","creatorId":"vndb:s38356","sourcePersonId":"vndb:s38356","canonicalEntityId":"vndb:s38356","name":"Yoshiro","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:127738","source":"vndb"},{"creditedName":"炭谷 一郎","creatorId":"vndb:s52311","sourcePersonId":"vndb:s52311","canonicalEntityId":"vndb:s52311","name":"炭谷 一郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:127739","source":"vndb"}]},"cast":[{"characterId":"char_c70673","characterName":"ヨツバ","sourceIds":{"bangumi":[{"characterId":"154569","match":"exact-normalized-name-in-linked-work","subjectId":"185559"}],"egsCharacterIds":["12413","25955"],"vndbCharacterId":"c70673"},"originalCharacterName":"ヨツバ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ユリと同じくして未来から現代に時間飛行した。"},{"spoiler":false,"text":"よつばが完成した後に、人類が滅亡してしまったため、性行為の経験はない。"},{"spoiler":false,"text":"また、人と交流したこともないので、人に対してどう接すれば良いのかわからず、人見知りな部分(常に緊張している感じ？)があるが、動物や植物等は大好き。"},{"spoiler":false,"text":"また、性的な行為を受け入れやすい(感じやすい)身体に作られているが、知識はほとんどなく、未経験でもあるので行為には戸惑うことが多い。"},{"spoiler":false,"text":"基本的にまじめで、未来を何とかしようと、経験もないのに奮闘する。"},{"spoiler":false,"text":"現代では、姉にあたるユリと一緒に学校内の宿舎に住んでいて、学園の生徒として通っている。"},{"spoiler":false,"text":"唯一の身寄りであること、性行為の経験が豊富であることから、ユリの事を尊敬し、姉として慕っている。"},{"spoiler":false,"text":"周りには他人行儀で緊張しているが、ユリだけには緊張を解いて接する。"}],"source":"egs","sourceCharacterId":"12413","sourceWorkId":"13753","spoiler":false},{"segments":[{"spoiler":false,"text":"プロトタイプのミミック。"},{"spoiler":false,"text":"衰弱のため、1日1時間程度しか活動できないが、非常に高い能力を持つ。"},{"spoiler":false,"text":"穏やかで優しい性格。"}],"source":"egs","sourceCharacterId":"25955","sourceWorkId":"6886","spoiler":false},{"segments":[{"spoiler":false,"text":"足元まで届くほどの長い白髪に優しげな瞳。"},{"spoiler":false,"text":"服装は、長い丈のワンピース。"},{"spoiler":false,"text":"衰弱のため、一日に1時間程度しか目覚めることがないが、かなり高度な能力を持つ。"},{"spoiler":false,"text":"本来は優しい性格で、ミツルギのしていることに胸をいためている。"}],"source":"bangumi","sourceCharacterId":"154569"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c70673","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"12413","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"12413","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"25955","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"25955","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"154569","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cf7df19c8e73b070a37b19053cd58248b0851588250cec2a5e4bd4f5a4ef387.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8fb95b491632753b36c05e9696e32795cd5ccc1f7a7b02062a1d66b389aef6f.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c70674","characterName":"ハル・シオン","sourceIds":{"vndbCharacterId":"c70674"},"originalCharacterName":"ハル・シオン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f53ea2ff21bafe7b454adc033dbd4e45fcc9effa6e5a19e0ee8a6540c67465f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04bb0ae974dbee611c3fba07e22b5ae6e77a980230cd4ada91017a6adee26929.webp","width":221,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c706