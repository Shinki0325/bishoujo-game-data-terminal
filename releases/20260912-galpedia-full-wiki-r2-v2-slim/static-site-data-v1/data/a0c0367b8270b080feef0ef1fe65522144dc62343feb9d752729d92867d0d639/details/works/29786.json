6781","name":"高岡 嘉子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:168537","source":"vndb"},{"creditedName":"「あ」の人","creatorId":"vndb:s43179","sourcePersonId":"vndb:s43179","canonicalEntityId":"vndb:s43179","name":"「あ」の人","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:168538","source":"vndb"},{"creditedName":"「あ」の人","creatorId":"vndb:s43179","sourcePersonId":"vndb:s43179","canonicalEntityId":"vndb:s43179","name":"「あ」の人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:168539","source":"vndb"}]},"cast":[{"characterId":"char_c13965","characterName":"音羽 初花","sourceIds":{"bangumi":[{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"310182"},{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8365"],"vndbCharacterId":"c13965"},"originalCharacterName":"音羽 初花","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second heroine of Natsu Kagura and younger daughter of Minamori shrine. Hatsuka has black hair with pony tail. A bright, active, cheerful, and innocent personality."},{"spoiler":false,"text":"There is no right or wrong side in her mind. She has a behaviour to straight out her emotions over action. And... noisy anyway. Because of that, she is often scolded by Keika, her older sister."},{"spoiler":false,"text":"A freshman who attends school at the bottom of the mountain."},{"spoiler":false,"text":"Hatsuka is skilled in archery."}],"source":"vndb","sourceCharacterId":"c13965"},{"segments":[{"spoiler":false,"text":"天真爛漫な水杜神社の次女。 姉と同じく麓の学園に通う一年生。"},{"spoiler":false,"text":"運動神経はそこそこ良いが、それ以上に頭が良く手先が器用。"},{"spoiler":false,"text":"感情に裏表がなく活動的……というか、とにかく騒々しい。"},{"spoiler":false,"text":"しょっちゅう桂香に叱られている。"},{"spoiler":false,"text":"主人公に対しても遠慮がなく、後ろから抱き付いてきたりする。"},{"spoiler":false,"text":"桂香より胸が小さいのを気にしている。"}],"source":"egs","sourceCharacterId":"8365","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"水社神社の次女として生まれ、巫女の修行をしている元気いっぱいの少女。"},{"spoiler":false,"text":"その明るく裏表の無い性格は誰からも好かれるが、時には騒々しいと叱られることも。"},{"spoiler":false,"text":"得意の弓を手にして、妖怪達に立ち向かっていく。"}],"source":"egs","sourceCharacterId":"8365","sourceWorkId":"29786","spoiler":false},{"segments":[{"spoiler":false,"text":"水社神社の次女として生まれ、巫女の修行をしている元気いっぱいの少女。"},{"spoiler":false,"text":"その明るく裏表の無い性格は誰からも好かれるが、時には騒々しいと叱られることも。"},{"spoiler":false,"text":"得意の弓を手にして、妖怪達に立ち向かっていく。"}],"source":"bangumi","sourceCharacterId":"78080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22730f29c923878fd38f52f0e43ebd103d0b12aa3f52f377cfbcc5d05ccdffe1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efee0670cfe136f90f5547e2aab16729e40f1cf164175c419d389d2823ea88c9.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:310182:78080:5940:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2720","sourceCompanyId":"egs:brand:2720","canonicalEntityId":"egs:brand:2720","name":"でぼの巣製作所","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29786:2720","source":"egs"},{"companyId":"vndb:p9483","sourceCompanyId":"vndb:p9483","canonicalEntityId":"vndb:p9483","name":"Shiravune","roleCodes":["publisher"],"identityStatus":"source-native