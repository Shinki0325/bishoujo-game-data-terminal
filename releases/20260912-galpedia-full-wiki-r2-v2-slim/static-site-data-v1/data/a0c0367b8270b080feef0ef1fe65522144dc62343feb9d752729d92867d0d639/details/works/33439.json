{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33439","model":{"presentationWorkId":"vndb:v39339","staff":{"artwork":[{"creditedName":"みづきことら(あかつきまお)","creatorId":"vndb:s1700","sourcePersonId":"egs:creator:1665","canonicalEntityId":"vndb:s1700","name":"みづきことら(あかつきまお)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:257236","source":"egs"},{"creditedName":"森山しじみ","creatorId":"vndb:s2456","sourcePersonId":"egs:creator:16565","canonicalEntityId":"vndb:s2456","name":"森山しじみ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:257237","source":"egs"}],"scenario":[{"creditedName":"天翔狗","creatorId":"vndb:s5399","sourcePersonId":"egs:creator:12089","canonicalEntityId":"vndb:s5399","name":"天翔狗","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:257235","source":"egs"}],"music":[],"other":[{"creditedName":"天翔狗","creatorId":"vndb:s5399","sourcePersonId":"egs:creator:12089","canonicalEntityId":"vndb:s5399","name":"天翔狗","detail":"プロデュース","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:257238","source":"egs"},{"creditedName":"天翔 狗","creatorId":"vndb:s5399","sourcePersonId":"vndb:s5399","canonicalEntityId":"vndb:s5399","name":"天翔 狗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:190579","source":"vndb"}]},"cast":[{"characterId":"char_c72174","characterName":"ビアンカ","sourceIds":{"bangumi":[{"characterId":"64001","match":"exact-normalized-name-in-linked-work","subjectId":"279276"}],"egsCharacterIds":["20988"],"vndbCharacterId":"c72174"},"originalCharacterName":"ビアンカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A saint destined to give birth to the Child of God, the future savior of humanity against the looming demon threat. However, when she is suddenly abducted by a demon lord, she is forced into becoming a pawn in their scheme to have the Child of God be sired not by a man but by a demon."},{"spoiler":false,"text":"Edited from noisy pixel"}],"source":"vndb","sourceCharacterId":"c72174"},{"segments":[{"spoiler":false,"text":"かつての聖女。"},{"spoiler":false,"text":"三年前、魔王たちに代わる代わる凌辱されて、最後には幼なじみの青年エドワードでもあった大魔王アスモデウスの正妃となり、彼の子でもある『神の子』を受胎している。"},{"spoiler":false,"text":"魔王妃となってからは、胎内の『神の子』の力で、惜しみなく回復魔法を使うことで魔族や魔王たちからも信頼されるようになった。"},{"spoiler":false,"text":"しかし未だ『神の子』は出産する兆しを見せず、なぜか見た目にも変化がない。"},{"spoiler":false,"text":"修道院で自分をいじめたミリアムに対しては、繰り返される彼女への凌辱を言葉の上でだけ哀れみ、同情するふりをして、ぶざまにあがく姿を楽しんでいる。"}],"source":"egs","sourceCharacterId":"20988","sourceWorkId":"27780","spoiler":false},{"segments":[{"spoiler":false,"text":"聖都市において、神の子を宿すといわれる「運命の子」として生まれる。"},{"spoiler":false,"text":"その立ち位置故に施された英才教育によって、典型的な「妄信者」として育てあげられた。"},{"spoiler":false,"text":"自身、将来はその身を神に捧げるものと信じて疑っていなかったが…"},{"spoiler":false,"text":"突如襲来した悪魔の軍勢になす術もなく拉致され、彼らの野望「魔神受胎」の道具に成り下がる。"}],"source":"bangumi","sourceCharacterId":"64001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51dbe1ae2d52bc4b20c954962764827890a154e919dcf95148077730297ab392.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/577f00165e48a391cbf8f8f7a733b36bc9eea1f1336b49429d11a093573aebe6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かずな さやか","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93333","source":"vndb"}]},{"characterId":"char_c83316","characterName":"ノエイン","sourceIds":{"bangumi":[{"characterId":"129222","match":"exact-normalized-name-in-linked-work","subjectId":"279276"}],"egsCharacterIds":["20989"],"vndbCharacterId":"c83316"},"originalCharacterName":"ノエイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ビアンカの双子の妹で、出生時に里子に出され、旅芸人の一座で働いていた。"},{"spoiler":false,"text":"一座の解散後は、ひとりで旅をしていたが、ビアンカが魔王たちの手に落ちたことで、天使ラファエルによって拘束され、新たな聖女となる。"},{"spoiler":false,"text":"本来は明るく元気で異種族にも偏見がない少女だったが、天使ラファエルにより、唯一神の教えに忠実で、自分の欲望に忠実、魔族を忌み嫌う、という別人格を設定されて、それに心を上書きされてしまい、わがままなお姫様となっている。"},{"spoiler":false,"text":"『神の子』を受胎したビアンカには劣るが、ほぼ万能で強大な魔法の力を備えているために、誰も逆らうことができない。"}],"source":"egs","sourceCharacterId":"20989","sourceWorkId":"27780","spoiler":false},{"segments":[{"spoiler":false,"text":"ビアンカとは双子の妹。"},{"spoiler":false,"text":"生まれて直ぐに『双子の聖女は凶』との言い伝えにより殺害される所だったが、とある地方の部族に匿われる事となった。"},{"spoiler":false,"text":"ノエインとは異なり聖女としての教育は受けていないが、神の子の器としての能力は見た目同様ビアンカと同じ。"},{"spoiler":false,"text":"「シェイラァ」と呼ばれる少女を引き連れている。"},{"spoiler":false,"text":"ビアンカとは異なり、ノエインは『天使』に犯され天使の子を生み続ける事となっていく。"}],"source":"bangumi","sourceCharacterId":"129222"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dab72d31272f02dc19dc2b461ddcc4c74bdf153285f73cf029e3ce7f39529c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc2f37f602471f2bd0277770d86278b4db821d55dcd1a2ecf85db6892db9240d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:415635:129222:19213:1","source"