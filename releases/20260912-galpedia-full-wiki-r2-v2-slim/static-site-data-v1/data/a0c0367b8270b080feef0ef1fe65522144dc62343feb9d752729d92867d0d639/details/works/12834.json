ve","relationId":"vndb:vn-staff:39031","source":"vndb"},{"creditedName":"浅海 朝美","creatorId":"vndb:s3101","sourcePersonId":"vndb:s3101","canonicalEntityId":"vndb:s3101","name":"浅海朝美(浅美朝海)","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:39032","source":"vndb"},{"creditedName":"三舛 啓","creatorId":"vndb:s4596","sourcePersonId":"vndb:s4596","canonicalEntityId":"vndb:s4596","name":"三舛 啓","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39035","source":"vndb"},{"creditedName":"後藤 聡一朗","creatorId":"vndb:s5254","sourcePersonId":"vndb:s5254","canonicalEntityId":"vndb:s5254","name":"後藤聡一朗(HD後藤)","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:39036","source":"vndb"}]},"cast":[{"characterId":"char_c33590","characterName":"東 由利","sourceIds":{"bangumi":[{"characterId":"34904","match":"exact-normalized-name-in-linked-work","subjectId":"16549"}],"egsCharacterIds":["14779"],"vndbCharacterId":"c33590"},"originalCharacterName":"東 由利","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【ほっと出来るのに気の抜けないお隣さん】"},{"spoiler":false,"text":"主人公の隣に住むお姉さん。お酒が大好きで、その仕事も酒造り。"},{"spoiler":false,"text":"学生時代は生物学のエリートだったらしく、その知識や技術でもって今の仕事をしているらしい。"},{"spoiler":false,"text":"ついでに飲み屋でも働いてるから朝帰り上等、酒の匂いをぷんぷんさせて、部屋の前で力尽きて寝こけてる事もある困ったお姉さん。"},{"spoiler":false,"text":"いつもニコニコしているけれど、その笑顔にだまされてというか、勝手に乗っかって由利さんの\"お願い\"を安請け合いすると、時々酷い目にあう。"},{"spoiler":false,"text":"会わない時もあるから見極め方が難しい。"},{"spoiler":false,"text":"無防備過ぎて、危険だとか、いつか襲われても知りませんよと主人公が注意すれば。"},{"spoiler":false,"text":"「んー……千尋くんが童貞じゃなくなったら、我慢できないときは襲われてもしょうがないかなー」"}],"source":"egs","sourceCharacterId":"14779","sourceWorkId":"12834","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公宅の隣に住むお姉さん。お酒が大好きで、その仕事も酒造り。"},{"spoiler":false,"text":"学生時代は生物学のエリートだったらしく、その知識や技術でもって今の仕事をしているらしい。"},{"spoiler":false,"text":"ついでに飲み屋でも働いてるから朝帰り上等、酒の匂いをぷんぷんさせて、部屋の前で力尽きて寝こけてる事もある困ったお姉さん。"},{"spoiler":false,"text":"いつもニコニコしているけれど、その笑顔にだまされてというか、勝手に乗っかって由利さんの“お願い”を安請け合いすると、時々酷い目にあう。会わない時もあるから見極め方が難しい。"},{"spoiler":false,"text":"無防備過ぎて危険だとか、いつか襲われても知りませんよと主人公が注意すれば。"},{"spoiler":false,"text":"「んー……千尋くんが童貞じゃなくなったら、我慢できないときは襲われてもしょうがないかなー」"},{"spoiler":false,"text":"いや、だから。気をつけて下さい。"}],"source":"bangumi","sourceCharacterId":"34904"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a951ce9f25d7b3e6e2d59b5a1787866d18299bd7923e10c209b21bcbd6de44cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d07d972a7c9e77b00a817b0a2e68e59af18b69caf5fc7770c63415b4879aca2b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16549:34904:13512:1","source":"bangumi"}]},{"characterId":"char_c861","characterName":"織倉 莉音","sourceIds":{"bangumi":[{"characterId":"34899","match":"exact-normalized-name-in-linked-work","subjectId":"16549"}],"egsCharacterIds":["14776"],"vndbCharacterId":"c861"},"originalCharacterName":"織倉 莉音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She’s Chihiro’s childhood friend and classmate. She’s also great in her studies. She’s Orikura Renji’s only daughter. Rio, Chihiro and Akira were always together when they were kids. Rio always lashes at Chihiro for not studying and tries to push him forward. But she herself is somewhat lacking in other parts, as Chihiro goes over to her place to clean up her room, wake her up and even cook sometimes."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c861"},{"segments":[{"spoiler":false,"text":"【“今”を大事にする、街の中の少女】"},{"spoiler":false,"text":"主人公、千尋とは同い年の幼馴染でこっちは学校では優等生。"},{"spoiler":false,"text":"毎日毎日ふらふらと遊び歩く主人公を叱り付けるしっかり者――お人よしとも言う。ちなみに巨乳。"},{"spoiler":false,"text":"けれどもその生活態度はグダグダで、こっちは逆に主人公が朝仕方なく起こしたり部屋の掃除をしたり…。"},{"spoiler":false,"text":"そんな主人公とは、父親同士が親友でそれこそ生まれた頃からの間柄。"},{"spoiler":false,"text":"恋人でも姉弟でもなく幼馴染であった２人だけど、あるきっかけから、その関係が変わっていってしまった。"},{"spoiler":false,"text":"名の通り、今は亡きフライト王者「織倉練児」の一人娘なのだけど、フライトそのものが苦手だったりする。"},{"spoiler":false,"text":"「ねえ、ちゃんと私の話聞いてるかしら？」"}],"source":"egs","sourceCharacterId":"14776","sourceWorkId":"12834","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・千尋とは同い年の幼馴染で、主人公と違い学校では優等生。"},{"spoiler":false,"text":"毎日毎日ふらふらと遊び歩く主人公を叱り付けるしっかり者――お人よしとも言う。ちなみに巨乳。"},{"spoiler":false,"text":"けれどもその生活態度はグダグダで、こちらは逆に主人公が朝仕方なく起こしたり部屋の掃除をしたり、食事の世話をしたりもしている。"},{"spoiler":false,"text":"そんな主人公とは、父親同士が親友でそれこそ生まれた頃からの関係。恋人でも姉弟でもなく幼馴染であったふたりだけど、あるきっかけから、その関係が変わっていってしまった。"},{"spoiler":false,"text":"名の通り、今は亡きフライト元王者「織倉練児」の一人娘なのだけど、フライトそのものが苦手だったりする。"},{"spoiler":false,"text":"「ねえ、ちゃんと私の話聞いてるかしら？」"}],"source":"bangumi","sourceCharacterId":"34899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7e0959a4b38bfd4ba742949d7e1d94cb4faf39f2d4d7890a786b3712a960ff8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bfa1ba6a712829bbc5ca580bc3acee1d0ad0db7b21a0ab2e8d29b05ea8aeb2d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16549:34899:4956:1","source":"bangumi"}]},{"characterId":"char_c862","characterName":"勇那 春子","sourceIds":{"bangumi":[{"characterId":"34900","match":"exact-normalized-name-in-linked-work","subjectId":"16549"}],"egsCharacterIds":["14777"],"vndbCharacterId":"c862"},"originalCharacterName":"勇那 春子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She was Chihiro’s rival in flight school. They made a promise to settle things in the skies but because of the accident, they lost contact. She continued on even without knowing where Chihiro went, going into competitive flying. She’s more of the cool type character. But, as she only concentrated on flying, there are quite some things she doesn’t know about. Complex about her nonexistent breasts."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c862"},{"segments":[{"spoiler":false,"text":"【ライバルを失った若きエース】"},{"spoiler":false,"text":"フライトの訓練生時代に主人公と競い合っていたライバル。"},{"spoiler":false,"text":"訓練やシミュレーターではなくいつか実際に空の上で決着をつけようと約束していたが、主人公が事故を起こしドロップアウトしたことで、その約束は果たされないままになってしまった。"},{"spoiler":false,"text":"その後、フライトの世界か消えた主人公が何処に居るかも知らぬままに、今日も彼女は閉ざされた空の中で、その頂点を目指している。"},{"spoiler":false,"text":"フライトでは、華麗かつ紳士的な飛行技術をスタイルとし、そのクールな外見も含め（多くの女性ファンも含めて）確固たる人気を築きつつある。"},{"spoiler":false,"text":"現在、天原のフライト選手全体の中でも３位に位置し、今シーズンのトップ争いに食い込んでいる。"},{"spoiler":false,"text":"「……まさか、それでいいと思っているのか？」"}],"source":"egs","sourceCharacterId":"14777","sourceWorkId":"12834","spoiler":false},{"segments":[{"spoiler":false,"text":"フライトの訓練生時代に主人公と競い合っていたライバル。"},{"spoiler":false,"text":"訓練やシュミレーターではなく、いつか実際に空の上で決着をつけようと約束していたが、主人公が事故を起こしドロップアウトしたことで、その約束は果たされないままになってしまった。"},{"spoiler":false,"text":"その後、フライトの世界から消えた主人公が何処にいるかも知らぬままに、今日も彼女は閉ざされた空の中で、その頂点を目指している。"},{"spoiler":false,"text":"フライトでは、華麗かつ紳士的な飛行技術をスタイルとし、そのクールな外見も含め（多くの女性ファンも含めて）確固たる人気を築きつつある。"},{"spoiler":false,"text":"現在、天原のフライト選手全体の中でも3位に位置し、今シーズンのトップ争いに食い込んでいる。"},{"spoiler":false,"text":"「……まさか、それでいいと思っているの？」"}],"source":"bangumi","sourceCharacterId":"34900"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b309db71f6aefb189e4a8fa54ac17b12ccfe657fbda909bcf6f890174f40c982.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/697fe6a5131b8a67dfd370759e3c99c53af1449e834cc15318dc0fb6296774af.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16549:34900:5940:1","source":"bangumi"}]},{"characterId":"char_c863","characterName":"天御 輝","sourceIds":{"bangumi":[{"characterId":"34901","match":"exact-normalized-name-in-linked-work","subjectId":"16549"}],"egsCharacterIds":["14778"],"vndbCharacterId":"c863"},"originalCharacterName":"天御 輝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akira is a daughter of the bloodline that is technically ruling over Amahara. Even so, she really doesn’t look as important as she should be. Goes over to Chihiro’s from time to time after changing her clothes and looks. She’s very energetic and loves erotic stuff. But when she goes to serious mode, her attitude takes a 180 degrees change and she turns into Amami Akira, the princess."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c863"},{"segments":[{"spoiler":false,"text":"【アーコロジーを象徴する血統、その一族】"},{"spoiler":false,"text":"アーコロジーの中でも頂点に位置する象徴たる血族、天御。"},{"spoiler":false,"text":"その直系長女であるのが彼女だ。"},{"spoiler":false,"text":"――とはいえ、そんな立場はなんのその。"},{"spoiler":false,"text":"とてもそうは見えない私服（通称お忍びモード）に着替え、幼馴染である莉音と主人公の所に唐突に現れては２人を連れまわし遊びまわって帰っていく人間台風のような少女。"},{"spoiler":false,"text":"ちなみに歳相応なのかエロトークが大好き。"},{"spoiler":false,"text":"けれど、天御の「輝」としての時はそんな態度はおくびにも出さず、誰もが納得する姫としての立ち振る舞いを完璧にこなして見せている。"},{"spoiler":false,"text":"天御としての「輝」も、幼馴染としての「あきら」を器用に使い分けるが、それは彼女の今まで生きてきた中で培ってきたものであり、どちらがウソとかではなく、どちらも本当の「彼女」である。"},{"spoiler":false,"text":"「ふっふーん、あれぇーあたしが来て嬉しくないっていうのかにゃー？」"}],"source":"egs","sourceCharacterId":"14778","sourceWorkId":"12834","spoiler":false},{"segments":[{"spoiler":false,"text":"アーコロジーの中でも頂点に位置する象徴たる血族・天御。その直系長女である少女。"},{"spoiler":false,"text":"――とはいえ、そんな立場はなんのその。とてもそうは見えない私服（通称・お忍びモード）に着替え、幼馴染である莉音と主人公の所に唐突に現れては、ふたりを連れまわし遊びまわって帰っていく人間台風のような少女。ちなみに歳相応なのかエロトークが大好き。"},{"spoiler":false,"text":"けれど、天御の「輝」としての時はそんな態度はおくびにも出さず、誰もが納得する姫としての立ち振る舞いを完璧にこなして見せている。"},{"spoiler":false,"text":"天御としての「輝」も、幼馴染としての『あきら』も器用に使い分けるが、それは彼女の今まで生きてきた中で培ってきたものであり、どちらがウソとかではなく、どちらも本当の「彼女」である。"},{"spoiler":false,"text":"「ふっふーん、あれぇーあたしが来て嬉しくないっていうのかにゃー？」"}],"source":"bangumi","sourceCharacterId":"34901"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9932fb2205af4119b17cc3b19df2a28357ea8abe49d20b1fc563348c1f2d3d21.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df7a9d48cf2e371018f1ba388159da26d0ffad738bf193be37f939f32508c43b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16549:34901:6509:1","source":"bangumi"}]},{"characterId":"char_c864","characterName":"ノエル","sourceIds":{"bangumi":[{"characterId":"34902","match":"exact-normalized-name-in-linked-work","subjectId":"16549"}],"egsCharacterIds":["14780"],"vndbCharacterId":"c864"},"originalCharacterName":"ノエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Noel isn’t ANY ordinary cat. She’s a cyborg and she talks. She came together with Line to help her with her mission. But mostly as a supporter. She’s pretty much a very my-pace cat too, doing whatever she wants whenever she wants."}],"source":"vndb","sourceCharacterId":"c864"},{"segments":[{"spoiler":false,"text":"【猫だけどお姉さん】"},{"spoiler":false,"text":"レティと共に天原を訪れた猫。"},{"spoiler":false,"text":"生体技術、機械技術の両方で調整されたサイボーグ猫で、人と同じような思考や知力にそれを上回る機械ならではのいくつもの特殊な能力を持っている。"},{"spoiler":false,"text":"レティの相棒にして姉。ペットではなく対等以上のパートナー。"},{"spoiler":false,"text":"けれどいくらサイボーグになっても猫は猫。気まぐれで気の向かない事や、自分にとってどうでもいいことは放置しがち。"},{"spoiler":false,"text":"隠されているものがあると、見たくなるという悪い癖があるのが玉に瑕。"},{"spoiler":false,"text":"好奇心は猫を殺すか？"},{"spoiler":false,"text":"「ただの猫ならね。危険な所は避けて通るのが当たり前でしょ？」"}],"source":"egs","sourceCharacterId":"14780","sourceWorkId":"12834","spoiler":false},{"segments":[{"spoiler":false,"text":"レティと共に天原を訪れた猫。"},{"spoiler":false,"text":"生体技術、機械技術の両方で調整されたサイボーグ猫で、人と同じような思考や知力に加え、それを上回る機械ならではのいくつもの特殊な能力を持っている。"},{"spoiler":false,"text":"レティの相棒にして姉。ペットではなく対等以上のパートナー。"},{"spoiler":false,"text":"けれどいくらサイボーグになっても猫は猫。気まぐれで気の向かない事や、自分にとってどうでもいいことは放置しがち。"},{"spoiler":false,"text":"隠されているものがあると見たくなるという悪い癖があるのが玉に瑕。"},{"spoiler":false,"text":"好奇心は猫を殺すか？"},{"spoiler":false,"text":"「ただの猫ならね。危険な所は避けて通るのが当たり前でしょ？」"}],"source":"bangumi","sourceCharacterId":"34902"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c30875dc7ab09f3137064ab95b23e6bcc41aff4a88cd5b7b4b9926d77f904438.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47f0ead4882087ad6c47bb7d4932b346a603b4e5a25a9f3bc1f84ad667f205e0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16549:34902:5075:1","source":"bangumi"}]},{"characterId":"char_vndb_c859","characterName":"ライン・T・ミラー","sourceIds":{"vndbCharacterId":"c859"},"originalCharacterName":"ライン・T・ミラー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She was the girl who fell from the sky into Amahara after 500 years of isolation. As her hair and complexion is different than the people of Amahara, she attracts much attention. She’s somewhat naughty and my pace. Reasons for her arrival is unknown and she roams around with her talking cat Noel."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0610da2a790305471c631d2e45f30a4f174cade4c99c277e1acd60c026888076.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31421028ce55d9651ec3c3633606587a4266150f36e02d369fd3510cd9b84b77.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柊 あかね","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21211","source":"vndb"}]},{"characterId":"char_vndb_c860","characterName":"日高 千尋","sourceIds":{"vndbCharacterId":"c860"},"originalCharacterName":"日高 千尋","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He has a passion for flying and he’s in love with the sky. He’s the only disciple of Orikura Renji, the champion of flying and hero of Amahara. But because of an accident, he quit flying as he has trauma of flight. Because of that, he now wonders aimlessly as he has lost the only goal in his life. And yes, he’s the kind of \"kind to every girl but never made a move\" kinda guy."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c860"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07ecc476b1c308eb49c9a41f26b30180790f500161bc6cb36e1890e66f3ef0b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b97bf01eb22f7a686a66ac82928737d4d04d3630962631df14ea643cd3f7f2fc.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c91494","characterName":"白浦 海","sourceIds":{"vndbCharacterId":"c91494"},"originalCharacterName":"白浦 海","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc94063521447fc092e96292ddd9fcfa58d4ae268b0a64c5a53cdac7975ca052.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/554f83feb6f11699bdc3e1cb9ca9fdb7a83fd4b20c00e4d050719eb89fcf616a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田 友貴","creatorId":"vndb:s34