ode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:54821","source":"vndb"},{"creditedName":"上松 範康","creatorId":"vndb:s2311","sourcePersonId":"vndb:s2311","canonicalEntityId":"vndb:s2311","name":"上松 範康","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54823","source":"vndb"},{"creditedName":"水月 紅葉","creatorId":"vndb:s4238","sourcePersonId":"vndb:s4238","canonicalEntityId":"vndb:s4238","name":"水月 紅葉","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:54825","source":"vndb"},{"creditedName":"やまさきともや","creatorId":"vndb:s4239","sourcePersonId":"vndb:s4239","canonicalEntityId":"vndb:s4239","name":"やまさきともや","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:54826","source":"vndb"},{"creditedName":"感電注意","creatorId":"vndb:s43602","sourcePersonId":"vndb:s43602","canonicalEntityId":"vndb:s43602","name":"感電注意","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54830","source":"vndb"}]},"cast":[{"characterId":"char_c26113","characterName":"帆村 淡雪","sourceIds":{"bangumi":[{"characterId":"115251","match":"exact-normalized-name-in-linked-work","subjectId":"139080"}],"egsCharacterIds":["25784"],"vndbCharacterId":"c26113"},"originalCharacterName":"帆村 淡雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。沙緒の親友。"},{"spoiler":false,"text":"勝気な性格で、常に上から目線で話すお姉さん気取りの女の子。"},{"spoiler":false,"text":"この春から地元の大学に通うことになっているが、彼女自身、田舎暮らしが嫌いで、***卒業後は、上京したいと思っていた。そのため、すっきりしない気持で今の季節を過ごしている。"},{"spoiler":false,"text":"実家は商店を経営しており、時間があれば店の手伝いをしている。"}],"source":"egs","sourceCharacterId":"25784","sourceWorkId":"7221","spoiler":false},{"segments":[{"spoiler":false,"text":"通明の幼馴染で、沙緒とは親友。思わせぶりな事を言うがどこまで本気なのかわからない。この春、札幌の帝大に入学が決まっている。田舎が嫌いで、学園を卒業したら東京へ出るつもりだったが、札幌で妥協してしまった事に心中密に忸怩たる思いを抱えている。"}],"source":"bangumi","sourceCharacterId":"115251"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ecb7153b90f225e2b23ada8923e4e6cde16db1d8766f1964d0792b5ab55e136.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27a4fa61ed7ae49e0e30b186ba67212322011a803675c56d687003737b3ddfbc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茶谷 やすら","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30449","source":"vndb"}]},{"characterId":"char_c26114","characterName":"藤川 りるけ","sourceIds":{"bangumi":[{"characterId":"115250","match":"exact-normalized-name-in-linked-work","subjectId":"139080"}],"egsCharacterIds":["25783"],"vndbCharacterId":"c26114"},"originalCharacterName":"藤川 りるけ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist's cousin who is two years younger than him, and Fujikawa Haine's daughter."}],"source":"vndb","sourceCharacterId":"c26114"},{"segments":[{"spoiler":false,"text":"主人公の二つ年下の従妹。"},{"spoiler":false,"text":"能天気で明るく元気な田舎娘。"},{"spoiler":false,"text":"主人公を「お兄ちゃん」と呼んで、慕っている。"},{"spoiler":false,"text":"今回、主人公が自宅に短期滞在（居候）することになって喜んでいる。"},{"spoiler":false,"text":"母親に似て非常に容姿端麗で、将来が期待される。また栄養の全てが胸に吸い取られたと噂されるほどの巨乳の持ち主。"},{"spoiler":false,"text":"料理が得意。しかし、ネギが大好きな彼女の料理には、必ずネギが入っている。"}],"source":"egs","sourceCharacterId":"25783","sourceWorkId":"7221","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の2つ下の後輩であり従兄弟の妹。通明をお兄ちゃんと呼び慕う。祭りが終わるまでりるけの家に居候することになり現在同居中。学園の成績は中の下だが、それはそうととにかく能天気。おっぱいに栄養を吸い取られてしまったのではないかと心配されてしまう。"}],"source":"bangumi","sourceCharacterId":"115250"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/875b81c84771b875674a218fb1739d10048360944de5d4654d3a0000ba4705d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/083e1539699ae6849a7ebe2e8bd9c0185c2d074fcd7832118d78f2bd16abfd95.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まき いづみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30450","source":"vndb"}]},{"characterId":"char_c92102","characterName":"藤川 灰音","sourceIds":{"bangumi":[{"characterId":"219161","match":"exact-normalized-name-in-linked-work","subjectId":"139080"}],"egsCharacterIds":["25785"],"vndbCharacterId":"c92102"},"originalCharacterName":"藤川 灰音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist's aunt and Fujikawa Riruke's mother."}],"source":"vndb","sourceCharacterId":"c92102"},{"segments":[{"spoiler":false,"text":"りるけの実母。主人公の叔母さん。"},{"spoiler":false,"text":"美人でスタイルもよく、年齢を感じさせない若々しさに溢れており、初代能都萌にも輝いた過去を持つ。"},{"spoiler":false,"text":"能都萌町の公務員として働いており、この春開催される祭りの準備に追われている。"},{"spoiler":false,"text":"最近、りるけの教育を間違ってしまったのではと頭を抱えている。"},{"spoiler":false,"text":"ビジュアル系バンドチェックが趣味と、こちらも若々しい。"}],"source":"egs","sourceCharacterId":"25785","sourceWorkId":"7221","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3adcfd5bc177b45854215fb61340a53e4ead95509b62506b0d5f5fbf50713b09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17d823153b770c4af2a00c980be73a0cb85142132019fab4cc401c9edbf9c7c5.webp","width":256,"height":205,"source":"static-detail"},"actors":[{"creditedName":"この かなみ","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30451","source":"vndb"}]},{"characterId":"char_vndb_c152928","characterName":"大西 明子","sourceIds":{"vndbCharacterId":"c152928"},"originalCharacterName":"大西 明子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b137d0553df9ee85017631c0f8e4f77d6b8c3d889e0c0e19232060086153b4fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2eab00400698a0f213c06ff00c92