","source":"vndb"},{"creditedName":"瀬川 一郎","creatorId":"vndb:s54576","sourcePersonId":"vndb:s54576","canonicalEntityId":"vndb:s54576","name":"瀬川 一郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49831","source":"vndb"}]},"cast":[{"characterId":"char_c1843","characterName":"円井 晶","sourceIds":{"bangumi":[{"characterId":"99041","match":"exact-normalized-name-in-linked-work","subjectId":"217252"},{"characterId":"99041","match":"source-roster","subjectId":"217252"},{"characterId":"99041","match":"source-roster","subjectId":"217253"},{"characterId":"99041","match":"exact-normalized-name-in-linked-work","subjectId":"217255"},{"characterId":"99041","match":"source-roster","subjectId":"217255"}],"egsCharacterIds":["27485"],"vndbCharacterId":"c1843"},"originalCharacterName":"円井 晶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"この部の部長でありキャプテンでありエース。"},{"spoiler":false,"text":"プレイヤーとしての技術は全国レベル。校内には彼女の隠れファンクラブがある。"},{"spoiler":false,"text":"実は子供の頃からの元浦ファンで、いつも妹の玖美とテレビで応援していた。"},{"spoiler":false,"text":"辛抱強く、弱音をなかなか吐かない。どんなことがあっても元浦の味方である。"}],"source":"egs","sourceCharacterId":"27485","sourceWorkId":"279","spoiler":false},{"segments":[{"spoiler":false,"text":"みんなのヒロイン（今回は“表のヒロイン”とも言われているらしい）"},{"spoiler":false,"text":"円井晶は、バレーボールからソフトボールへと種目が変わっても"},{"spoiler":false,"text":"プレイヤーとしてのポテンシャルは全国水準、投げるボールは野球並みのスピードだというからさすがである。"},{"spoiler":false,"text":"変わらぬ責任感と豊かな母性で、今回もチームの扇の要として主人公を支えてくれるらしい。"},{"spoiler":false,"text":"これまで明かされなかった彼女の意外な一面が見られるかも、というウワサも……？？"}],"source":"egs","sourceCharacterId":"27485","sourceWorkId":"2222","spoiler":false},{"segments":[{"spoiler":false,"text":"この部の部長でありキャプテンでありエース。プレイヤーとしての技術は全国レベル。校内には彼女の隠れファンクラブがある。実は子供の頃からの元浦ファンで、いつも妹の玖美とテレビで応援していた。辛抱強く、弱音をなかなか吐かない。どんなことがあっても元浦の味方である。"},{"spoiler":false,"text":"（性格） くじけない、一本気。何よりも元気である。笑顔よし、”和を重んじる”タイプ。責任感が強いが優等生タイプではない。"},{"spoiler":false,"text":"（コンプレックス） 彼女は”体型コンプレックス”である。ずっとバレーをしてきたためバレープレイヤー特有の体型をしている。身長が高く胴が長い。胸もうすくモモも太い。そんな点から”男に女の子扱いされない”と自分で思い込んでしまっている。事実、女の子にはもてており、”校内ファンクラブ”が設けられており、実はこれにより男からガードさせられている事を本人は気づいていない。元浦に対する愛情は一番だが、こんな自分では愛されないとのあきらめもある。結構”悲劇のヒロイン”が入っている。"}],"source":"bangumi","sourceCharacterId":"99041"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f3b9e3b3c0b1b5aa22ea20e18f26a1a3e280d9a5f34ce563cb68288ec9faabb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03ebdf9e91f6952ace1de93592b1d1962ce3568ff8356f2fff2f069557487598.webp","width":240,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_c1844","characterName":"松田 未依","sourceIds":{"bangumi":[{"characterId":"99045","match":"exact-normalized-name-in-linked-work","subjectId":"217252"},{"characterId":"99045","match":"source-roster","subjectId":"217252"},{"characterId":"99045","match":"source-roster","subjectId":"217253"},{"characterId":"99045","match":"exact-normalized-name-in-linked-work","subjectId":"217255"},{"characterId":"99045","match":"source-roster","subjectId":"217255"}],"egsCharacterIds":["27489"],"vndbCharacterId":"c1844"},"originalCharacterName":"松田 未依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Note: weight includes her doll \"Biga☆ju\" that she always has on her"}],"source":"vndb","sourceCharacterId":"c1844"},{"segments":[{"spoiler":false,"text":"女子ハンド部で、補欠キーパーをしていたが、ちょっとボケていて、使いあぐねていたのを見てブロック要員として元浦が拾ってくる。"},{"spoiler":false,"text":"性格は暗く、何を考えているか解らないような節もある。"},{"spoiler":false,"text":"ただ、一度はまると周りが見えなくなる見えなくなるタイプでちょっと恐い。"},{"spoiler":false,"text":"アニメ・マンガが大好きで、実はフィギアコレクションという趣味がある。"},{"spoiler":false,"text":"いつも手元にぬいぐるみのビガ☆ジューを置いている。"}],"source":"egs","sourceCharacterId":"27489","sourceWorkId":"279","spoiler":false},{"segments":[{"spoiler":false,"text":"ほよほよモード全開の未依が、今回も夢に見そうなオトボケぶりで迫る！"},{"spoiler":false,"text":"おなじみの相棒“ビガ☆ジュー”がバージョンアップ（！？）し、未依の相手役を賭けて主人公と張り合う。彼女に興味を持つと、あなたも知らず知らずの内に、その不思議な世界へ足を踏み入れる事になるかも・・・？"}],"source":"egs","sourceCharacterId":"27489","sourceWorkId":"2222","spoiler":false},{"segments":[{"spoiler":false,"text":"女子ハンド部で、補欠キーパーをしていたが、ちょっとボケていて、使いあぐねていたのを見てブロック要員として元浦が拾ってくる。性格は暗く、何を考えているか解らないような節もある。ただ、一度はまると周りが見えなくなる見えなくなるタイプでちょっと恐い。アニメ・マンガが大好きで、実はフィギアコレクションという趣味がある。いつも手元にぬいぐるみのビガ☆ジューを置いている。"},{"spoiler":false,"text":"（性格）くらい。引込み思案。声が小さい。アニメ・マンガが大好きで、その手（？）のフィギアコレクションが趣味。いじめられっ子色の強い女。人形集めをしている喜多嶋麻由美を同類と勘違いする。"},{"spoiler":false,"text":"（コンプレックス）円井玖美、伊那部尚とは全く逆の方向の二種の”対人コンプレックス”。自分の存在自体に疑問を感じ、少々”鬱”の傾向がある。自信を持てない自分に悩んでいるので、自分の個性を認められた時、パワーが増大する。"}],"source":"bangumi","sourceCharacterId":"99045"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b99dd7c6adcf14df92f17adb470f473b0ef29756e55c6cc8e055578b42834d3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39fd7b17b57ccb3e78f195c2c9d52f94b2746dcc6e5b09e119e73d4b82b238c9.webp","width":240,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_c1845","characterName":"音胡田 こずえ","sourceIds":{"bangumi":[{"characterId":"99048","match":"exact-normalized-name-in-linked-work","subjectId":"217252"},{"characterId":"99048","match":"source-roster","subjectId":"217252"},{"characterId":"99048","match":"source-roster","subjectId":"217253"},{"characterId":"99048","match":"exact-normalized-name-in-linked-work","subjectId":"217255"},{"characterId":"99048","match":"source-roster","subjectId":"217255"}],"egsCharacterIds":["27492"],"vndbCharacterId":"c1845"},"originalCharacterName":"音胡田 こずえ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元浦に惚れて入部したため、何でも言う事を聞く。"},{"spoiler":false,"text":"部活動なぞそっちのけで元浦の気を引こうとモーションをかける。"},{"spoiler":false,"text":"しかしそういった行動や、男に媚びるようなスーパーぶりっ子ぶりから"},{"spoiler":false,"text":"メンバー達からはあまりよく思われておらず、なんとなく孤立している。しかし男にはよくもてるタイプ。"},{"spoiler":false,"text":"よく円井玖美と衝突する。"}],"source":"egs","sourceCharacterId":"27492","sourceWorkId":"279","spoiler":false},{"segments":[{"spoiler":false,"text":"かつてのアンケートで人気ワーストワンに輝いた（！？）音胡田こずえ。"},{"spoiler":false,"text":"わがままな仔猫のような性格は今回も健在だ。"},{"spoiler":false,"text":"元来ワイルドな男を好むが、正直者で小心者の愛すべき主人公にも興味を抱き、モーションをかけてくる。"},{"spoiler":false,"text":"今度こそ人気ワーストワンの汚名を返上できるかも？"}],"source":"egs","sourceCharacterId":"27492","sourceWorkId":"2222","spoiler":false},{"segments":[{"spoiler":false,"text":"元浦に惚れて入部したため、何でも言う事を聞く。部活動なぞそっちのけで元浦の気を引こうとモーションをかける。しかしそういった行動や、男に媚びるようなスーパーぶりっ子ぶりからメンバー達からはあまりよく思われておらず、なんとなく孤立している。しかし男にはよくもてるタイプ。よく円井玖美と衝突する。"},{"spoiler":false,"text":"（性格） スーパーぶりっ子。男の前では（特に元浦の前では）かわいくひ弱な女になる。魔性の女系。常に擦り寄ってくるのだが、放っておくとすねるので、”つかず離れず”的な、それなりの飼い方（？）をしないと駄目。周りの女達にあまりよく思われていないので、ひいきをすると周囲の反感をかいます。注意。"},{"spoiler":false,"text":"（コンプレックス）ほとんど無いが、あるとすれば”元浦コンプレックス”。元浦が自分の方を向いている事だけを頼りにしている（というか、自分が元浦を好きでいる事に酔っている）ので、完全に元浦から相手にされなくなると、（精神的に）廃人になる。気を付けましょう。"}],"source":"bangumi","sourceCharacterId":"99048"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86e876fdc531a8170643fede00b1968e525a0a837d720accec9ca0d754f4fc06.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecfab4a522e94978964a5a601cd0551e99b6f455167b9c89df9c10208b886464.webp","width":240,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_c1846","characterName":"潮乃木 葛葉","sourceIds":{"bangumi":[{"characterId":"99047","match":"exact-normalized-name-in-linked-work","subjectId":"217252"},{"characterId":"99047","match":"source-roster","subjectId":"217252"},{"characterId":"99047","match":"source-roster","subjectId":"217253"},{"characterId":"99047","match":"exact-normalized-name-in-linked-work","subjectId":"217255"},{"characterId":"99047","match":"source-roster","subjectId":"217255"}],"egsCharacterIds":["27491"],"vndbCharacterId":"c1846"},"originalCharacterName":"潮乃木 葛葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"基本的にバレーセンスがあるオールラウンドプレーヤーなのだが、必要以上に男に対し嫌悪感を見せる。"},{"spoiler":false,"text":"そのため元浦も扱いかねていたが、伊那部尚が入部してきてから、俄然やる気を出すようになる(少なくとも本人の前では)。"},{"spoiler":false,"text":"いつも伊那部尚の帰り時間を見計らって帰ろうとする。"}],"source":"egs","sourceCharacterId":"27491","sourceWorkId":"279","spoiler":false},{"segments":[{"spoiler":false,"text":"スタッフ間では“影のヒロイン”と呼ばれているらしい今回の葛葉。"},{"spoiler":false,"text":"彼女は想像を絶するトラウマに苛まれ、心身ともに深く傷ついた存在として登場するようだ。"},{"spoiler":false,"text":"重度の男性恐怖症に陥って、硬く閉ざされてしまった彼女の心の扉を、果たして主人公は開く事ができるのだろうか？"}],"source":"egs","sourceCharacterId":"27491","sourceWorkId":"2222","spoiler":false},{"segments":[{"spoiler":false,"text":"基本的にバレーセンスがあるオールラウンドプレーヤーなのだが、必要以上に男に対し嫌悪感を見せる。そのため元浦も扱いかねていたが、伊那部尚が入部してきてから、俄然やる気を出すようになる（少なくとも本人の前では）。いつも伊那部尚の帰り時間を見計らって帰ろうとする。"},{"spoiler":false,"text":"（性格） 過去のトラウマ（小・中時代のチカン行為）により男に対し完全に心を閉ざす。男に媚びない強い女性のイメージを持つ伊那部尚に強い憧れを持つようになる。行動は普通の女性で、男っぽくは全然無い。"},{"spoiler":false,"text":"（コンプレックス） ”男性コンプレックス”。知識では解っているが、どうしても男の存在を認める事が出来ない。それが高じてレズ（扱い）になってしまっている。実際それだと男が寄ってこないので”楽”なため、その立場を変える気がしないでいる。しかし内部的には相当な男性への興味を持っており、そのタガが外れた時には一気に爆発する。一番いやらしいタイプ。"}],"source":"bangumi","sourceCharacterId":"99047"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c134043abf990cd6cd5a74f39a946723a99ad2d0c2c5179a4ced33f5115e205.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/271b48edbed25178aa7a4a8ae25ed641ec26a1aa565eab50665bc651b3acf326.webp","width":240,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_c1848","characterName":"伊那部 尚","sourceIds":{"bangumi":[{"characterId":"99043","match":"exact-normalized-name-in-linked-work","subjectId":"217252"},{"characterId":"99043","match":"source-roster","subjectId":"217252"},{"characterId":"99043","match":"source-roster","subjectId":"217253"},{"characterId":"99043","match":"exact-normalized-name-in-linked-work","subjectId":"217255"},{"characterId":"99043","match":"source-roster","subjectId":"217255"}],"egsCharacterIds":["27487"],"vndbCharacterId":"c1848"},"originalCharacterName":"伊那部 尚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Precise weight: 54.5 kg."}],"source":"vndb","sourceCharacterId":"c1848"},{"segments":[{"spoiler":false,"text":"バスケ部にいたが、個人プレーばかりしていた為に周りと衝突。"},{"spoiler":false,"text":"そこを元浦に拾われる。スポーツセンスはピカイチで、目立つポジションで最大の効果を発揮するタイプ。"},{"spoiler":false,"text":"負けず嫌いで自分が常に一番でいたいと思っているため、一番の実力者である円井晶とポジション争い等で衝突する。"},{"spoiler":false,"text":"その性格から、校内では”女王様”というあだ名をつけられている。"},{"spoiler":false,"text":"プロポーションもスポーツ体型でなく抜群のスタイル。"},{"spoiler":false,"text":"しかし、それゆえ周りが距離を置いているという事もわかっており、その事に影で悩んでいる。"}],"source":"egs","sourceCharacterId":"27487","sourceWorkId":"279","spoiler":false},{"segments":[{"spoiler":false,"text":"今回の尚は、バスケとソフトを本場アメリカで経験している帰国子女という設定。"},{"spoiler":false,"text":"プライドが高く負けず嫌いで歯に衣着せないキャラは相変らずだが、プレイ次第では彼女が普段見せない女の子らしさをイロイロと垣間見ることができるらしい。"},{"spoiler":false,"text":"前作同様よろしくない女教師・緒谷馬との仲が、果たして今度は和解へ至るのかどうかというのも興味あるところ。"}],"source":"egs","sourceCharacterId":"27487","sourceWorkId":"2222","spoiler":false},{"segments":[{"spoiler":false,"text":"バスケ部にいたが、個人プレーばかりしていた為に周りと衝突。そこを元浦に拾われる。スポーツセンスはピカイチで、目立つポジションで最大の効果を発揮するタイプ。負けず嫌いで自分が常に一番でいたいと思っているため、一番の実力者である円井晶とポジション争い等で衝突する。その性格から、校内では”女王様”というあだ名をつけられている。プロポーションもスポーツ体型でなく抜群のスタイル。しかし、それゆえ周りが距離を置いているという事もわかっており、その事に影で悩んでいる。"},{"spoiler":false,"text":"（性格） 自己中心派。開放的。魅力的。アメリカンで、強い女性である。常にポジティブな思考をもち、失敗をうまく経験に転換できる。但し負けず嫌いなので、常にトラブルを巻き起こす。"},{"spoiler":false,"text":"（コンプレックス） これまた性格の強さによる対人（？）コンプレックス。自分の周りにいるのは、常に自分の下（の立場）の人間ばかりな点にちょっとブルーになっている。その為、自分を恐れずあしらう元浦を気に入る。本当は自分と対等に接してくれる信頼できる仲間が欲しいが、今までの生き方に引きずられて、うまくコミュニケーションが取れずやきもきしている。その為か強い相手を探してはケンカを吹っ掛けると"}],"source":"bangumi","sourceCharacterId":"99043"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbb20850ce24cc04caadcbe12c38c977bc97a9710fb1260e447731095b11f69b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6944890ccb502ce17a3b16512b7594ca3a0831c35d68f8e120536ab67ed2f31.webp","width":240,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_c1849","characterName":"円井 玖美","sourceIds":{"bangumi":[{"characterId":"99042","match":"exact-normalized-name-in-linked-work","subjectId":"217252"},{"characterId":"99042","match":"source-roster","subjectId":"217252"},{"characterId":"99042","match":"source-roster","subjectId":"217253"},{"characterId":"99042","match":"exact-normalized-name-in-linked-work","subjectId":"217255"},{"characterId":"99042","match":"source-roster","subjectId":"217255"}],"egsCharacterIds":["27486"],"vndbCharacterId":"c1849"},"originalCharacterName":"円井 玖美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"晶の妹。元浦ファンだったが、腐っていた元浦に嫌気がさし退部。"},{"spoiler":false,"text":"姉の説得で部に戻るが、元浦に距離を置いて接するようになる。"},{"spoiler":false,"text":"冷静で論理的な思考をもち、つじつまの合わない事は認めない。"},{"spoiler":false,"text":"常に元浦の行動をチェックしている。しかし今でも隠れ元浦ファン。"},{"spoiler":false,"text":"バレーに豪快さはないが、細かい配慮と戦略思考を持つ点で、セッターをしてゲームメイキングをする。"}],"source":"egs","sourceCharacterId":"27486","sourceWorkId":"279","spoiler":false},{"segments":[{"spoiler":false,"text":"このソフトボール編では、晶と姉妹バッテリーを組む玖美。"},{"spoiler":false,"text":"かつてないほど姉への思慕が強く、シスコン度を増して描かれる今回の玖美だが、主人公の接し方により、そんな玖美の“初恋”を卒業させることができる……かも知れない。"},{"spoiler":false,"text":"ちなみに、ユニフォームがミニスカなので“しゃがむポジション”であるキャッチャーはかなりやりにくいらしい?"}],"source":"egs","sourceCharacterId":"27486","sourceWorkId":"2222","spoiler":false},{"segments":[{"spoiler":false,"text":"晶の妹。元浦ファンだったが、腐っていた元浦に嫌気がさし退部。姉の説得で部に戻るが、元浦に距離を置いて接するようになる。冷静で論理的な思考をもち、つじつまの合わない事は認めない。常に元浦の行動をチェックしている。しかし今でも隠れ元浦ファン。バレーに豪快さはないが、細かい配慮と戦略思考を持つ点で、セッターをしてゲームメイキングをする。"},{"spoiler":false,"text":"（性格） 懐疑的。責任感が強く優等生タイプ。自分に結構自信があるので、その自信を崩された時には結構もろい。自分をひたすら隠しまくる。実は一途。時々自分を持て余し、姉に泣き付くようなかわいい面もある。"},{"spoiler":false,"text":"（コンプレックス） 強いて言えば、性格の強さから来る”懐疑コンプレックス”。責任感の強さのあまり、常に裏を考えるような姿勢が出来てしまう。ネガティブタイプ。それゆえにあまり人を信用できなく、友達も少ない（逆に姉はすぐ友達が出来るタイプ）。信用しているのは口の固さもあって唯一姉だけ。ある意味”シスターコンプレックス”でもある。弱さを必死に隠している。"}],"source":"bangumi","sourceCharacterId":"99042"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4811f82f106750adcde8a1cca96bc42dd1d8ad3347d006986457eaa27ea3492a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c951bcc9cb50fef2208233dec8a5e6957fca4ab250de1346c80e1d0404165d7.webp","width":240,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_c1850","characterName":"喜多嶋 麻由美","sourceIds":{"bangumi":[{"characterId":"99046","match":"exact-normalized-name-in-linked-work","subjectId":"217252"},{"characterId":"99046","match":"source-roster","subjectId":"217252"},{"characterId":"99046","match":"source-roster","subjectId":"217253"},{"characterId":"99046","match":"exact-normalized-name-in-linked-work","subjectId":"217255"},{"characterId":"99046","match":"source-roster","subjectId":"217255"}],"egsCharacterIds":["27490"],"vndbCharacterId":"c1850"},"originalCharacterName":"喜多嶋 麻由美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"個性無し。"},{"spoiler":false,"text":"昔から従うのに慣れており、部活崩壊の危機になっても、なんとなく部活にいる。"},{"spoiler":false,"text":"実はお人形集めというかわいい趣味があり、この点で松田未依と意気投合することになる。"}],"source":"egs","sourceCharacterId":"27490","sourceWorkId":"279","spoiler":false},{"segments":[{"spoiler":false,"text":"無個性キャラのレッテルを返上すべく頑張ったりもするらしい今回のまゆたん。"},{"spoiler":false,"text":"だが、次第に未依に感化され、『スポ根』のことを『すこぽん』などと言ってしまっている自分に気づかないほど最近はほよほよになりつつあり、存在感自体は増している感もある。"},{"spoiler":false,"text":"そんな彼女に、なんと今回は“男の影”も見え隠れするという。"},{"spoiler":false,"text":"まゆたん、意外と注目株かも知れない……!?"}],"source":"egs","sourceCharacterId":"27490","sourceWorkId":"2222","spoiler":false},{"segments":[{"spoiler":false,"text":"個性無し。昔から従うのに慣れており、部活崩壊の危機になっても、なんとなく部活にいる。実はお人形集めというかわいい趣味があり、この点で松田未依と意気投合することになる。"},{"spoiler":false,"text":"（性格） 特別特徴無し。唯一の趣味として人形・ぬいぐるみ集めというお・と・めＴＩＣ！な趣味がある。周りに流され易いタイプなので、特別個人的に気を配る必要は無し。"},{"spoiler":false,"text":"（コンプレックス） なし。"}],"source":"bangumi","sourceCharacterId":"99046"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46ae6278e44d13d7932eaba96eb6ca746d92a521cda2ed8ec79e3580c79eac3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49146bf4af401787407a9a17ff3462722c6e36ec66d966a759e9e68e5a3093a7.webp","width":240,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1759","characterName":"元浦 央","sourceIds":{"vndbCharacterId":"c1759"},"originalCharacterName":"元浦 央","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/428b12443659e8f60f769071023104e70fa05e065574375feaa0df422763fb19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18bce22d85efa844ae828680fde3968b67cf1fdacc932686b12023b0d3725f80.webp","width":136,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1851","characterName":"白鳥ふみえ  &  木戸ひとみ","sourceIds":{"vndbCharacterId":"c1851"},"originalCharacterName":"白鳥ふみえ  &  木戸ひとみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Two friends never seen apart."}],"source":"vndb","sourceCharacterId":"c1851"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/133ecde7f2f4f8243757867877d72a510d1c9fa900fea0cb991c2561ca9