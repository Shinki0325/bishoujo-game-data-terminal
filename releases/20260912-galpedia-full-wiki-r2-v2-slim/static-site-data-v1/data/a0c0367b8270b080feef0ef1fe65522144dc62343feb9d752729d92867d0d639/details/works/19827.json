{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19827","model":{"presentationWorkId":"vndb:v13913","staff":{"artwork":[{"creditedName":"ぬい","creatorId":"vndb:s5427","sourcePersonId":"egs:creator:5082","canonicalEntityId":"vndb:s5427","name":"ぬい","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:126717","source":"egs"}],"scenario":[{"creditedName":"葉山こよーて","creatorId":"vndb:s746","sourcePersonId":"egs:creator:5081","canonicalEntityId":"vndb:s746","name":"葉山こよーて","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:126719","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c15721","characterName":"堀部 安兵衛","sourceIds":{"bangumi":[],"egsCharacterIds":["4789"],"vndbCharacterId":"c15721"},"originalCharacterName":"堀部 安兵衛","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"江戸急進派のリーダー。 その実直な性格から主君の死の直後から仇討ちを主張、内蔵助とも何度となく対立したが、"},{"spoiler":false,"text":"内蔵助の懐の深さを理解して最終的には和解する。"},{"spoiler":false,"text":"自分を厳しく律し、普段から剣の稽古も欠かさない。"},{"spoiler":false,"text":"また、頭脳明晰で達筆であるが寝起きは悪い。 酒は一滴も飲めず、甘いモノを好む。"},{"spoiler":false,"text":"浅野家に仕官する前、刀の鞘の色が朱色だったことから “朱鞘の安兵衛” と呼ばれていた。"},{"spoiler":false,"text":"主人公の直刃と二回目のループで恋に落ちたが、吉良邸で死別。"},{"spoiler":false,"text":"愛刀は備前長船康光。"}],"source":"egs","sourceCharacterId":"4789","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2ee6a2c63ff16640ab6b1fee423ec35da1c831197f3a273d5dda6cb2cc0e7f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/310b1830330c82048d152cb73d514c2802d9c59c06dd13b31ca88e51f44e7774.webp","width":172,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c15722","characterName":"大石 主税","sourceIds":{"bangumi":[],"egsCharacterIds":["4790"],"vndbCharacterId":"c15722"},"originalCharacterName":"大石 主税","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Official Position: Adolescent Dependent on Parents"},{"spoiler":false,"text":"Estate: None"},{"spoiler":false,"text":"Beloved daughter of Kuranosuke"},{"spoiler":false,"text":"She is impatient with her mother for allowing people to call her useless behind her back."},{"spoiler":false,"text":"Perhaps because of this, she sometimes tries a little too hard to beome a great samurai herself."},{"spoiler":false,"text":"She hates spiders and frogs"},{"spoiler":false,"text":"Her Childhood name was Matsunojou"}],"source":"vndb","sourceCharacterId":"c15722"},{"segments":[{"spoiler":false,"text":"内蔵助を母に持ち、幼くして論語を学ぶなど藩のサラブレットとして育てられた。"},{"spoiler":false,"text":"まじめ過ぎる性格から昼行灯の内蔵助とは時々言い争いをするが、内蔵助を心の底より信頼している。"},{"spoiler":false,"text":"男性に関してはオクテなものの、好きになったら一直線で直刃にも猛烈アタックを敢行した。"},{"spoiler":false,"text":"梅の花をこよなく愛している。"},{"spoiler":false,"text":"三回目のループで精神崩壊した直刃を命懸けで助け、その後、恋人になるが内蔵助と同じく仇討ち成功後に泉岳寺で別れた。"},{"spoiler":false,"text":"愛刀は共国。 脇差は主君・浅野内匠頭から下賜されたものである。"}],"source":"egs","sourceCharacterId":"4790","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/929f5b6f3d0569746842087090620d20cba683eb6c67c0a4471cf7d2d72afe18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90bf033954f106412d0e6bc9077089703868d3fbf343967887a5ba6c2e86e1e8.webp","width":246,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c15723","characterName":"矢頭 右衛門七","sourceIds":{"bangumi":[],"egsCharacterIds":["4791"],"vndbCharacterId":"c15723"},"originalCharacterName":"矢頭 右衛門七","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Official Position: Adolescent Dependent on Parents"},{"spoiler":false,"text":"Estate: None"},{"spoiler":false,"text":"The eldest of Yatou Chousuke's four daughters."},{"spoiler":false,"text":"She is learning accounting from her father who works as an accountant in the castle."},{"spoiler":false,"text":"She privately worries about being bad with the sword and having small breasts."},{"spoiler":false,"text":"She falls over a lot."}],"source":"vndb","sourceCharacterId":"c15723"},{"segments":[{"spoiler":false,"text":"直刃の義妹。 優しい性格で誰からも愛される赤穂浪士のマスコット的存在。"},{"spoiler":false,"text":"貧しい暮らしながら、父である長助の遺志を継ぎ、仇討ちへの参加を熱望する。"},{"spoiler":false,"text":"内蔵助には再三 義盟参加を断られるが、浅右衛門との厳しい修行で一人前の武士へと成長、義盟参加を認められる。"},{"spoiler":false,"text":"五回目のループで直刃とは恋人中？"},{"spoiler":false,"text":"武器は師匠の浅右衛門から勧められ槍を使用。"}],"source":"egs","sourceCharacterId":"4791","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83bc7cca4f3bd951ab479d32a4d729b89169733e65ef7619444217c9ac3b6f46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a132a8538043996a10727e86a44eaf4be2db2ac7eb8beaa4533e0832186a333.webp","width":173,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c15724","characterName":"深海 直刃","sourceIds":{"bangumi":[],"egsCharacterIds":["4802"],"vndbCharacterId":"c15724"},"originalCharacterName":"深海 直刃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"呪いにより、元禄時代にタイムスリップした現代人。"},{"spoiler":false,"text":"だが、生まれついての剣の才能と赤穂浪士を身近に触れることで、立派な武士として成長を果たす。"},{"spoiler":false,"text":"前作で黒幕を倒し、見事に江戸の窮地救ったのも束の間、島では新たな問題が発生する。"},{"spoiler":false,"text":"そして、空白の1年間でもかつて経験したことのないような難題を突き付けられていた。"},{"spoiler":false,"text":"この 2つの窮地を直刃は、どうやって切り抜けるのだろうか。いよう、ひそかに予防線を"},{"spoiler":false,"text":"張り巡らせたりしている。"}],"source":"egs","sourceCharacterId":"4802","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24c66f113daf863e04ed312992a76df4048cb612965ad2cb174b88137bc3d5cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bba5820d97751b14ea4b9885595e03f05230fc260c40a80bc6aa21d186f8b73.webp","width":143,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c16519","characterName":"不破 数右衛門","sourceIds":{"bangumi":[],"egsCharacterIds":["4792"],"vndbCharacterId":"c16519"},"originalCharacterName":"不破 数右衛門","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"赤穂浪士きっての暴れん坊で切り込み隊長。"},{"spoiler":false,"text":"剣に関しては誰よりも自信を持っており、その自信を裏付けするように比類なき強さを誇っている。"},{"spoiler":false,"text":"討ち入り時は持ち場を離れて邸内へと斬り込み、敵を倒すという活躍をした。"},{"spoiler":false,"text":"安兵衛との犬猿の仲は続行中で、何かとすぐに喧嘩をふっかけるのは変わらない。"},{"spoiler":false,"text":"ただ内蔵助だけには唯一頭が上がらず、それでいて影のように付き従っている。"},{"spoiler":false,"text":"愛刀は末備前則光。"}],"source":"egs","sourceCharacterId":"4792","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7c4ae44ebd8fbc4d24406df79d3e7b969d555c81af9587d0122a89e7f6aae90.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c109c6393433fa17d9e8488dbb1547e0fa2a5a090502d092b65d3222cdf9f44.webp","width":205,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c16520","characterName":"間 新六","sourceIds":{"bangumi":[],"egsCharacterIds":["4794"],"vndbCharacterId":"c16520"},"originalCharacterName":"間 新六","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Status: Ronin"},{"spoiler":false,"text":"Fiefdom: None"},{"spoiler":false,"text":"Formerly with the Ako clan, she knows Edo like the back of her hand. She joined the retainers' cause at Yasubee's request, acting as an informant relaying information about Kira to the others. While normally a woman of few words, she can be quite acrimonious when she does speak. She also possesses a sweet tooth."},{"spoiler":false,"text":"\"I... really want some manjuu...\""}],"source":"vndb","sourceCharacterId":"c16520"},{"segments":[{"spoiler":false,"text":"普段は無口で喋り方もスローテンポ。 それでいて毒舌家。"},{"spoiler":false,"text":"剣の腕前は天流剣術を学んでおり、なかなかの使い手と評価されている。"},{"spoiler":false,"text":"一度 他家に養子に出されたのが原因なのか、当初は泉岳寺に墓が無かったという珍しい人物。"},{"spoiler":false,"text":"安兵衛のことが大好きで、直刃と安兵衛が恋仲になることを快く思ってない。"},{"spoiler":false,"text":"甘いモノが大好物。"},{"spoiler":false,"text":"愛刀は国助。"}],"source":"egs","sourceCharacterId":"4794","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4177d3df12d7a7bdc36ea770a4300e9ab3d472723c3a7fc77666b8361e851652.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42d580e45dfc5044d1f1adb9a5bf412ea7b9394e3cc056155acaaf2a0fe0171e.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c16521","characterName":"武林 唯七","sourceIds":{"bangumi":[],"egsCharacterIds":["4796"],"vndbCharacterId":"c16521"},"originalCharacterName":"武林 唯七","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"単純な性格でお調子者。"},{"spoiler":false,"text":"だが、お家断絶後は徹頭徹尾 仇討ち主張を貫いており、直刃は一定の信頼を置いている。"},{"spoiler":false,"text":"討ち入り時には三番隊の組頭を務め、剣の腕前は上級者。"},{"spoiler":false,"text":"怨敵の吉良に一番槍をつけた殊勲者である。"},{"spoiler":false,"text":"愛刀は広国。"}],"source":"egs","sourceCharacterId":"4796","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db4d726b90aba8f0341787945e4543539ae486957ed86b568023cea953721fb0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5eadea107fe75fd0bac965155eae42e0c05f2d93ae561244af616538acacf1b.webp","width":173,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c16522","characterName":"奥田 孫太夫","sourceIds":{"bangumi":[],"egsCharacterIds":["4793"],"vndbCharacterId":"c16522"},"originalCharacterName":"奥田 孫太夫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名門・堀内道場の四天王の一人に数えられる剣豪。"},{"spoiler":false,"text":"討ち入り時は遊撃隊として吉良邸内を縦横無尽に駆け回り、敵を倒した。"},{"spoiler":false,"text":"安兵衛とは道場の同門で、安兵衛が浅野家に仕官する前からの付き合い。"},{"spoiler":false,"text":"普段は高飛車な態度だが、それは梅干しの効力のおかげで、効力が切れるとか弱い女の子になってしまう。"},{"spoiler":false,"text":"こけしをこよなく愛している。 どのように使用しているかは不明。"},{"spoiler":false,"text":"愛刀は国高。"}],"source":"egs","sourceCharacterId":"4793","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97f448b49785c02272b41869f395b8575dce5bd4bff9538c76e24248c69d6fe0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa67dc943330e5844120e97378448ee2c9183162349ef49d6f94c3778b822013.webp","width":240,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c16543","characterName":"矢頭 小夜","sourceIds":{"bangumi":[],"egsCharacterIds":["4803"],"vndbCharacterId":"c16543"},"originalCharacterName":"矢頭 小夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Official Position: None"},{"spoiler":false,"text":"Estate: None"},{"spoiler":false,"text":"Second eldest girl in the Yatou household."},{"spoiler":false,"text":"Her personality is less ditzy and she is more reliable than her sister Emoshichi."},{"spoiler":false,"text":"Sometimes she tries to seduce Suguha but it is hard to tell if she is serious or just teasing."},{"spoiler":false,"text":"She quietly brags about how her chest has recently grown larger than Emoshischi's"}],"source":"vndb","sourceCharacterId":"c16543"},{"segments":[{"spoiler":false,"text":"矢頭家の次女。 直刃と右衛門七の妹。"},{"spoiler":false,"text":"勝ち気な性格で、姉の右衛門七よりもしっかりしている面が多々ある。"},{"spoiler":false,"text":"マセた言動で直刃をよく困らせている。"},{"spoiler":false,"text":"具体的な例は直刃の妙技？ ちんちん踊り をせがむなど。"},{"spoiler":false,"text":"地獄修羅子との異名を持つ。 ただし、その名は他人には浸透していない模様。"}],"source":"egs","sourceCharacterId":"4803","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35840217af362a7cd57427587845baf9f1336eb558cb0f0100a8bde15727fec4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1