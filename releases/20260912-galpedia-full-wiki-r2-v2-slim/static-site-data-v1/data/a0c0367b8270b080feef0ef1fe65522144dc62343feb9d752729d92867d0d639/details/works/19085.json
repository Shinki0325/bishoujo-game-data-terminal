a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1748613aed3d28954823d4e7029f9ab525efd9792c6ba21da832c59fd5803eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73741:32734:5936:1","source":"bangumi"}]},{"characterId":"char_c20681","characterName":"水谷 さくら","sourceIds":{"bangumi":[{"characterId":"32735","match":"exact-normalized-name-in-linked-work","subjectId":"73741"}],"egsCharacterIds":["1484"],"vndbCharacterId":"c20681"},"originalCharacterName":"水谷 さくら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小さな背丈の中には、これ以上ないというほどの情熱が詰め込まれている、まさに「淡波のミニマム台風」。その気さくな性格ゆえ、琴音といい勝負をするほど顔が広く、ただでさえ在校生が少ない学園において、彼女のことを知らない学生はいない。"},{"spoiler":false,"text":"類まれな裁縫の技術を持っており、それがきっかけで「アクア」との関係が生まれる。"},{"spoiler":false,"text":"ちなみに作るのも好きだが、着せるのはもっと好きだったりするコスプレの趣味もアリ。"}],"source":"egs","sourceCharacterId":"1484","sourceWorkId":"19085","spoiler":false},{"segments":[{"spoiler":false,"text":"小さな背丈にこれ以上ないほどの情熱が詰め込まれている、まさに “淡波のミニマム台風”。"},{"spoiler":false,"text":"その気さくな性格ゆえ琴音といい勝負をするほど顔が広く、ただでさえ在校生が少ない学園において彼女のことを知らない学生はいない。"},{"spoiler":false,"text":"類まれな裁縫の技術を持っており、それがきっかけでアクアとの関係が生まれる。"},{"spoiler":false,"text":"ちなみに作るのも好きだが、着せるのはもっと好きだったりするコスプレの趣味もアリ。"},{"spoiler":