rcePersonId":"vndb:s4003","canonicalEntityId":"vndb:s4003","name":"神月 社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:199634","source":"vndb"},{"creditedName":"かつらぎ","creatorId":"vndb:s4147","sourcePersonId":"vndb:s4147","canonicalEntityId":"vndb:s4147","name":"かつらぎ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:199635","source":"vndb"},{"creditedName":"URA","creatorId":"vndb:s12796","sourcePersonId":"vndb:s12796","canonicalEntityId":"vndb:s12796","name":"URA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:199640","source":"vndb"},{"creditedName":"らいれす","creatorId":"vndb:s13804","sourcePersonId":"vndb:s13804","canonicalEntityId":"vndb:s13804","name":"らいれす","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:199641","source":"vndb"},{"creditedName":"鬼ごはん","creatorId":"vndb:s12253","sourcePersonId":"vndb:s12253","canonicalEntityId":"vndb:s12253","name":"鬼ごはん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:199643","source":"vndb"},{"creditedName":"ぐらしおん","creatorId":"vndb:s34584","sourcePersonId":"vndb:s34584","canonicalEntityId":"vndb:s34584","name":"ぐらしおん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:199644","source":"vndb"},{"creditedName":"鶏さん","creatorId":"vndb:s35096","sourcePersonId":"vndb:s35096","canonicalEntityId":"vndb:s35096","name":"鶏さん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:199646","source":"vndb"},{"creditedName":"鳥島 烏","creatorId":"vndb:s36268","sourcePersonId":"vndb:s36268","canonicalEntityId":"vndb:s36268","name":"鳥島烏","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:199647","source":"vndb"},{"creditedName":"河奈 ナミ","creatorId":"vndb:s36282","sourcePersonId":"vndb:s36282","canonicalEntityId":"vndb:s36282","name":"河奈 ナミ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:199648","source":"vndb"}]},"cast":[{"characterId":"char_c130648","characterName":"春日 蛍","sourceIds":{"bangumi":[{"characterId":"138869","match":"exact-normalized-name-in-linked-work","subjectId":"455944"}],"egsCharacterIds":["24915"],"vndbCharacterId":"c130648"},"originalCharacterName":"春日 蛍","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruki works as an exclusive model under the alias \"Kasuga Hotaru\" for a fashion brand owned by his older sister Chizuru. Although he initially does not want to cross-dress, he eventually accepts his position as a model, hoping to help with his household income even a little. He also comes to like wearing cute outfits made by his sister."},{"spoiler":false,"text":"Kind-hearted, earnest and caring, he has a strong sense of justice and responsibility, and cannot ignore those who are in trouble. He dreams of being strong, imposing, and muscular like a hero in a movie, but in reality, the exact opposite, since he is slim and meek like a maiden in a flower garden. Due to his complexity, when his girlish self is pointed out, he gets depressed."},{"spoiler":false,"text":"Even though he disapproves of it, his womanly nature is quite strong as he has been taking care of his lazy sister for a long time. Particularly, he is good at doing housework and can cook, clean and do laundry easily. Perhaps because of his work as a model, his gestures and behavior have become more feminine over the years, if he is dressed up like a girl, no one would notice his true gender."},{"spoiler":false,"text":"As for his cross-dressing, he was asked by his sister to do it daily from an early age. Maybe because of this, he has little resistance to cross-dressing itself (but this does not mean that he fully embrace it). The name \"Kasuga Hotaru\" is a stage name given to him by his sister for an idol audition when he was young. When he begins working as a model, he retains the name."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c130648"},{"segments":[{"spoiler":false,"text":"主人公。姉のファッションブラド女性モデル「春日蛍」として活躍おり、 女装は好まないが受け入れてる男の娘。"},{"spoiler":false,"text":"性格は心優しく真面目で、正義感や責任が強い外見女の子らことにコンプレックスを抱いる。"},{"spoiler":false,"text":"家事が得意で、女装時には性別分からないほどし仕草をする。"},{"spoiler":false,"text":"女装は幼少期からの姉趣味で経験させれている。"}],"source":"egs","sourceCharacterId":"24915","sourceWorkId":"35169","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。姉のファッションブランドの女性モデル「春日蛍」として活躍しており、女装は好まないが受け入れている男の娘。"},{"spoiler":false,"text":"性格は心優しく真面目で、正義感や責任感が強いが、外見は女の子らしいことにコンプレックスを抱いる。家事が得意で、女装時には性別が分からないほど女性らしい仕草をする。"},{"spoiler":false,"text":"女装は幼少期からの姉の趣味で経験させられている。"}],"source":"bangumi","sourceCharacterId":"138869"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06635ca77b799492c3a21b41cbf2c897ccc40b719de6a1a620f6ae9b387ffdb1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c279c71bb0581f5ec6caaec3651f3769c5bb0050ba069762c8d1c56c114b2494.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"餅梨あむ","creatorId":"vndb:s27125","sourcePersonId":"vndb:s27125","canonicalEntityId":"vndb:s27125","name":"餅梨 あむ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:455944:138869:57381:1","source":"bangumi"}]},{"characterId":"char_c130649","characterName":"楠 清佳","sourceIds":{"bangumi":[{"characterId":"138878","match":"exact-normalized-name-in-linked-work","subjectId":"455944"}],"egsCharacterIds":["24916"],"vndbCharacterId":"c130649"},"originalCharacterName":"楠 清佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only daughter of the world-renowned Kusunoki Group and a young businesswoman. Despite being a student, Kiyoka herself is the president of a famous cosmetics company and is a wealthy person."},{"spoiler":false,"text":"She met Haruki (who was cross-dressing at the time) when she was young, and even though they were separated due to some circumstances, such as Haruki moving away, she always has feelings for him."},{"spoiler":false,"text":"\"Standing beautifully like a peony, sitting beautifully like a peony, walking beautifully like a lily.\" Like an embodiment of these words, attractive, beautiful, smart, well-mannered, and soft-spoken, a perfect ojousama. ――Other people tend to feel that way judging from her appearance, but the truth is, she tends to do what her heart desires. Often behaves strangely, doing whatever she feels like to achieve her goal, a wasted beauty."},{"spoiler":false,"text":"She is honest and hard-working. \"If it's something that you really wants, no matter what the others say, you should be honest with your own heart.\" This is what she believes, and her behavior is also based on it."},{"spoiler":false,"text":"At an early age, she had to closed off her heart in order to fulfill her role as the \"Daughter of Kusunoki Group.\" Hiding her true feelings and faking herself were things that she had to do everyday. Eventually, they became normal for her, but all of those changed during the summer of her sixth grade, when she met Haruki after his idol audition."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c130649"},{"segments":[{"spoiler":false,"text":"楠グループの一人娘で、若き実業家資金に不自由しない。"},{"spoiler":false,"text":"蛍と幼少期に出会い、常彼女思を寄せてた。"},{"spoiler":false,"text":"見た目は完璧なお嬢様で、才色兼備しとやかだが、実際はパワフルで奇天烈な一面もあり、目的のために手段を選ばない残念美人。 彼女は素直で一生懸命あり、自分の信念に従って行動する。"},{"spoiler":false,"text":"幼少期は自己を抑え、 表向き「楠グループの令嬢」として振る舞っいたが、小学６年生の夏に蛍と出会ったこで意識が変わった。"}],"source":"egs","sourceCharacterId":"24916","sourceWorkId":"35169","spoiler":false},{"segments":[{"spoiler":false,"text":"楠グループの一人娘で、若き実業家で資金に不自由しない。"},{"spoiler":false,"text":"蛍と幼少期に出会い、常に彼女に思いを寄せていた。"},{"spoiler":false,"text":"見た目は完璧なお嬢様で、才色兼備でおしとやかだが、実際はパワフルで奇天烈な一面もあり、目的のために手段を選ばない残念な美人。"},{"spoiler":false,"text":"彼女は素直で一生懸命であり、自分の信念に従って行動する。"},{"spoiler":false,"text":"幼少期は自己を抑え、表向きは「楠グループの令嬢」として振る舞っていたが、小学6年生の夏に蛍と出会ったことで意識が変わった。"}],"source":"bangumi","sourceCharacterId":"138878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19d5e1bbf9b7bd7a45476467308dc7b63ba776fe55dd521d1f3c8b9a6c6e2773.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73a20e143ee87fb075037507c2e6660e747c821d481a96c88bf6f34d6050436d.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:455944:138878:8493:1","source":"bangumi"}]},{"characterId":"char_c130650","characterName":"蛍乃 千鶴","sourceIds":{"bangumi":[{"characterId":"138867","match":"exact-normalized-name-in-linked-work","subjectId":"455944"}],"egsCharacterIds":["24917"],"vndbCharacterId":"c130650"},"originalCharacterName":"蛍乃 千鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruki's sister who is four years older than him. She is a fashion designer for the brand \"HOTATURU\" which she founded herself. Although her brand is well-known overseas, it is still relatively unknown in Japan."},{"spoiler":false,"text":"At work, she looks like a dignified, attractive, and mature adult, but at home, she becomes a lazy, good-for-nothing woman. Since she cannot wake up by herself in the morning, and unable to do housework, she relies on Haruki most of the time. When she is occupied with work, she sometimes throws a tantrum, and wants Haruki to spoil her like a child. Even so, she likes to play prank and is full of mischief, fond of teasing and agitating other people. She does not have the dignity of a grown-up at all."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c130650"},{"segments":[{"spoiler":false,"text":"主人公の姉。ファッションデザイナーで、自身のブランド「HOTATURU（ホタツル）」を立ち上げたが、日本ではまだ知名度が低い。"},{"spoiler":false,"text":"仕事では凜々しく格好いが、家ぐーたら面倒さり。朝起きられず、家事も苦手で弟の春樹に頼り切っている。"},{"spoiler":false,"text":"仕事が忙しいと子供っぽ一面を見せ、悪戯好きで茶目っ気もあるが、威厳はない。"}],"source":"egs","sourceCharacterId":"24917","sourceWorkId":"35169","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の姉。ファッションデザイナーで、自身のブランド「HOTATURU（ホタツル）」を立ち上げたが、日本ではまだ知名度が低い。"},{"spoiler":false,"text":"仕事では凜々しく格好いいが、家ではぐーたらで面倒くさがり。朝起きられず、家事も苦手で、弟の春樹に頼り切っている。"},{"spoiler":false,"text":"仕事が忙しいと子供っぽい一面を見せ、悪戯好きで茶目っ気もあるが、威厳はない。"}],"source":"bangumi","sourceCharacterId":"138867"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a20017b1f9bb9b3f7ee8f02d5d3787685fac683c1293c6444d387b1131624d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb4c589dcee38f7193898f59080c5d090ee9d6ae9e58b64d22d58b44a8316d7c.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤色せりな","creatorId":"vndb:s36406","sourcePersonId":"vndb:s36406","canonicalEntityId":"vndb:s36406","name":"藤色 せりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:455944:138867:60556:1","source":"bangumi"}]},{"characterId":"char_c130651","characterName":"藤堂 愛","sourceIds":{"bangumi":[{"characterId":"138868","match":"exact-normalized-name-in-linked-work","subjectId":"455944"}],"egsCharacterIds":["24918"],"vndbCharacterId":"c130651"},"originalCharacterName":"藤堂 愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kiyoka's personal maid. A half-English girl with blonde hair, she is the only daughter of the Toudou family, which has served the Kusunoki family for generations."},{"spoiler":false,"text":"Because she grew up together with Kiyoka like sisters, she is one of the few people Kiyoka can show her weakness to. Ai herself cares about Kiyoka more than her position as a maid. However, she often makes fun of Kiyoka (her own way of expressing affection). But at heart, she deeply trusts and respects Kiyoka, and wishes for her to be happy."},{"spoiler":false,"text":"For the most part, she is rude to everyone, a cold girl who rarely shows emotion, quick-witted, and can calmly handle any situation without losing her composure. She is also very observant and shrewd. Since she has been taking care of Kiyoka who tends to be out of control, her abilities have been cultivated. Sharp-tongued and a realist, she is the opposite of the straightforward Kiyoka. She shows a sadistic side to those close to her. On the other hand, she also has an overly caring and meddlesome side, perhaps due to her being a maid. She gets uncomfortable when someone shows her appreciation."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c130651"},{"segments":[{"spoiler":false,"text":"清佳のメイドで、楠家に代々仕える藤堂一人娘。"},{"spoiler":false,"text":"清佳とは姉妹同然に育ち、 信頼と尊敬を抱いてるが、基本的には毒舌で冷静な性格。"},{"spoiler":false,"text":"感情を表に出さず、冷徹無情な印象を持っており、頭の回転が速く観察力高い。"},{"spoiler":false,"text":"親しい人にはドSで、お節介焼きな一面もある。"}],"source":"egs","sourceCharacterId":"24918","sourceWorkId":"35169","spoiler":false},{"segments":[{"spoiler":false,"text":"清佳のメイドで、楠家に代々仕える藤堂家の一人娘。"},{"spoiler":false,"text":"清佳とは姉妹同然に育ち、信頼と尊敬を抱いているが、基本的には毒舌で冷静な性格。"},{"spoiler":false,"text":"感情を表に出さず、冷徹無情な印象を持っており、頭の回転が速く観察力が高い。"},{"spoiler":false,"text":"親しい人にはどSで、お節介烧きな一面もある。"}],"source":"bangumi","sourceCharacterId":"138868"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/857a3e7d228fef41f351505ecdc15332971da8def198066a5b6f481723f4ae3f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/1996631f34c4d656a4895d91d1e3d20e148631aea9a4319e3c3fe36af94e413b.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:455944:138868:6509:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p4304","sourceCompanyId":"egs:brand:4252","canonicalEntityId":"vndb:p4304","name":"ensemble SWEET","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:35169:4252","source":"egs"},{"companyId":"vndb:p4304","sourceCompanyId":"vndb:p4304","canonicalEntityId":"vndb:p4304","name":"ensemble SWEET","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:123733:v47155","source":"vndb"},{"companyId":"vndb:p4304","sourceCompanyId":"vndb:p4304","canonicalEntityId":"vndb:p4304","name":"ensemble SWEET","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-pr