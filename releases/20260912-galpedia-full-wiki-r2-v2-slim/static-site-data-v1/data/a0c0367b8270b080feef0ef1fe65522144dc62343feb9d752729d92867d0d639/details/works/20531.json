mi"}]},{"characterId":"char_c21309","characterName":"新田 瑠璃","sourceIds":{"bangumi":[{"characterId":"26239","match":"exact-normalized-name-in-linked-work","subjectId":"103136"}],"egsCharacterIds":["3880"],"vndbCharacterId":"c21309"},"originalCharacterName":"新田 瑠璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"The protagonist and Yuu's older sister. Some time ago, she consumed her twin brother in order to become a seigyo."}],"source":"vndb","sourceCharacterId":"c21309"},{"segments":[{"spoiler":false,"text":"イズミのクラスメイトで、委員長を務めている。"},{"spoiler":false,"text":"真面目で芯の強い、絵に描いたような優等生。"},{"spoiler":false,"text":"クラスでの人望も厚いが、時折謎めいた言動があり、イズミを困惑させている。"},{"spoiler":false,"text":"問題児である悠のことを気にかけている様子で、“飼育”されはじめたイズミにも忠告をする。"}],"source":"egs","sourceCharacterId":"3880","sourceWorkId":"20531","spoiler":false},{"segments":[{"spoiler":false,"text":"イズミのクラスメイトで、委員長を務めている。"},{"spoiler":false,"text":"まじめで芯の強い、絵に描いたような優等生。"},{"spoiler":false,"text":"クラスでの人望も厚いが、時折謎めいた言動があり、イズミを困惑させている。"},{"spoiler":false,"text":"問題児である悠のことを気にかけている様子で、“飼育” されはじめたイズミにも忠告をする。"},{"spoiler":false,"text":"「本気で、あのコのことを思うなら、殺してあげなさい、加納君」"}],"source":"bangumi","sourceCharacterId":"26239"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cd1eab98f325720f4ab1a4de94ec698544b154b4516597ce0ec1e0ac2806bdc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bd36d8a3b46e026b3ae27773b21d17d8f940896b4aeccf19fe940315c1411c2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId