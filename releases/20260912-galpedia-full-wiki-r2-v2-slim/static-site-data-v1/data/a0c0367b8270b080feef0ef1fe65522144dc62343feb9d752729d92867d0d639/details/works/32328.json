133","canonicalEntityId":"vndb:s14133","name":"小沢 悠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181161","source":"vndb"},{"creditedName":"明羽 杏子","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:181162","source":"vndb"},{"creditedName":"土井 潤一","creatorId":"vndb:s14540","sourcePersonId":"vndb:s14540","canonicalEntityId":"vndb:s14540","name":"土井 潤一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181163","source":"vndb"},{"creditedName":"rapiecage","creatorId":"vndb:s16605","sourcePersonId":"vndb:s16605","canonicalEntityId":"vndb:s16605","name":"rapiecage","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181165","source":"vndb"},{"creditedName":"ニライカナイスタジオ","creatorId":"vndb:s10409","sourcePersonId":"vndb:s10409","canonicalEntityId":"vndb:s10409","name":"株式会社ニライカナイ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181167","source":"vndb"},{"creditedName":"株式会社アルカディア・プロジェクト","creatorId":"vndb:s21015","sourcePersonId":"vndb:s21015","canonicalEntityId":"vndb:s21015","name":"株式会社アルカディア・プロジェクト(ARCADIA PROJECT","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181168","source":"vndb"},{"creditedName":"かたひと","creatorId":"vndb:s22130","sourcePersonId":"vndb:s22130","canonicalEntityId":"vndb:s22130","name":"かたひと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181169","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c104590","characterName":"八坂 かのん","sourceIds":{"vndbCharacterId":"c104590"},"originalCharacterName":"八坂 かのん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"505"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"......Clothes, it's a hassle to put them on. Help me put them on, Yuuki.\""},{"spoiler":false,"text":"Yuuki's twin sister and classmate."},{"spoiler":false,"text":"A beautiful girl who has excellent grades and motor skills. She can do basic household chores, but often becomes listless when she does them. She is usually absent-minded and doesn't talk much, making it difficult for someone to understand what she is thinking."},{"spoiler":false,"text":"She is attached and obedient to Yuuki, often following him everywhere he goes, and has no interest in anyone else other than him. When she sleeps, she likes to sleep naked."},{"spoiler":false,"text":"Her magic is primarily for healing and support, but this must be kept secret since no one outside of the Yasaka family should know that they can use magic."},{"spoiler":false,"text":"Translated and edited from the Official website"},{"spoiler":true,"text":"It is revealed later in the story that Yuuki, Kanon, and Hiiragi came from another world. Their father was a hero and their mother was a princess of a certain kingdom. When Yuuki and Kanon were infants, their kingdom was besieged by the demon lord's army, so their parents entrusted them to Hiiragi who is the hero's best friend, and sacrificed themselves in order to sent them to another world, along with the building that is now Minato Dormitory. However, their souls still reside in their children."},{"spoiler":true,"text":"In the end, they are able to go back to their world and defeat the demon lord, but leave Yuuki and Kanon behind in the current world because both of them choose to stay there, and wishing them happiness in their new lives."}],"source":"vndb","sourceCharacterId":"c104590"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2df053405189c8638b286cff43bcce48ec82f5fcbf229e4884254589c28dabe9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bfe00e3fd76b44437b41b2570730ba5356d24a318fb1e3ceddaa40b34230d49.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"明羽 杏子","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90263","source":"vndb"}]},{"characterId":"char_vndb_c104591","characterName":"橘 晴華","sourceIds":{"vndbCharacterId":"c104591"},"originalCharacterName":"橘 晴華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Yasaka-kun! That ability the other day, what on earth did you do!?\""},{"spoiler":false,"text":"Yuuki's classmate, and the school's student council vice-president."},{"spoiler":false,"text":"She was born and raised in a wealthy family."},{"spoiler":false,"text":"Although pretending to be a serious young lady, she is actually clumsy and mostly messing up at the crucial moments. She is an otaku, and always likes fantasy novels, video games, and anime since she was a child. She also aims to become a creator herself, and had participated in the related activities."},{"spoiler":false,"text":"After Yuuki used his magic to save her, she became interest in him and moved into Minato Dormitory. She tries to trick Yuuki into using his magic again at every opportunity."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c104591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/111b0577a32a3754441711fd3f259727641e54e38085a21eca56f81bd80435c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb0c9b836ad093a4ea9d41d32fe4ed50838b86cc2ede98940667fbc325abfcd0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月野 きいろ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90261","source":"vndb"}]},{"characterId":"char_vndb_c104592","characterName":"紅葉 あきら","sourceIds":{"vndbCharacterId":"c104592"},"originalCharacterName":"紅葉 あきら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"404"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Please, enjoy your time at the café......Eh? That's so unlike me?\""},{"spoiler":false,"text":"Yuuki's kouhai, doesn't participate in school extra-curricular activities and a resident of Minato Dormitory. Her room number is 205."},{"spoiler":false,"text":"She is Seika's childhood friend and best friend."},{"spoiler":false,"text":"Unlike Seika whose upbringing was wholesome and clean, Akira was the opposite with her free-spirit and gyaru-like demeanour. Perhaps it was because she took a shine to the cafe work, or because her name was ever-present on the shift roster, but she was shortly appointed leader despite only recently starting her first year of high school."},{"spoiler":false,"text":"Her outfit in the dormitory is not much different from just underwear. One of her hobbies is teasing Yuuki for laughs, Yuuki and Hiiragi in turn either tell her off or are in shock at her antics."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c104592"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cbe40cbc5b70f99b9585460e8785a3a13950425df6619a26d8abf2b814da0c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/788da189308182d2d097a4c4eeca2fc8adc2921a87f31334656180d59d0be940.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃山 いおん","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90260","source":"vndb"}]},{"characterId":"char_vndb_c104593","characterName":"桧葉 美月","sourceIds":{"vndbCharacterId":"c104593"},"originalCharacterName":"桧葉 美月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"909"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Here, you can sleep on my lap. I'll even clean your ears for you.\""},{"spoiler":false,"text":"Yuuki's senpai, and a resident of Minato Dormitory. Her room number is 202."},{"spoiler":false,"text":"Since she is short-sighted, she usually wears contact lenses."},{"spoiler":false,"text":"She has a strong maternal instinct, and always longing for someone to be like her little brother. For that reason, she likes to spoil Yuuki a lot. She is good at everything she does and used to be a member of the school's student council."},{"spoiler":false,"text":"Because her hobby is making sweets, she likes to eat them as well;"},{"spoiler":false,"text":"Surely all of the calories that she gained must have been absorbed into that chest of hers."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c104593"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fc528eac861f7c2a8b7f582e27ba825d22b8cfb8cba5cdf1cc4130df8ee73a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d0107feb2741de87a5f46c08c5f7685849a39ca484da61f5b3d623e4acac470.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小波 すず","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90262","source":"vndb"}]},{"characterId":"char_vndb_c104594","characterName":"八坂 柊","sourceIds":{"vndbCharacterId":"c104594"},"originalCharacterName":"八坂 柊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"303"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I may be small, but I'm still the manager of this dormitory!\""},{"spoiler":false,"text":"Yuuki and Kanon's cousin, she is the manager of Minato Dormitory and Neko King Café."},{"spoiler":false,"text":"A bright and cheerful woman. Despite her small appearance, she handles her work flawlessly. She is popular with the neighbors and students living in the dormitory, and is a person that everyone can relied on, but becomes weak when she is drunk. She loves Yuuki and Kanon very much, and likes to make Yuuki help out with the dormitory work (an act of affection)."},{"spoiler":false,"text":"She is able to use magic to some extent, but rarely use it because she doesn't want anyone to find out that the Yasaka family can use magic."},{"spoiler":false,"text":"Translated and edited from the Official website"},{"spoiler":true,"text":"It is revealed later in the story that Hiiragi is not actually blood-related to Yuuki and Kanon, but is their father's childhood friend and best friend, and she also has feelings for him. Their parents entrusted Yuuki and Kanon to her, and sent them to another world, along with the building that is now Minato Dormitory (which used to be an inn run by Hiiragi's family), and she has been taking care of them ever since."}],"source":"vndb","sourceCharacterId":"c104594"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2110b49a7783e13df71cd21cf04d81fc0307ef5295bf67da54cd2c728e354278.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b6cc571ce8a6026e1152fe6e1c39f87e7a2a4028b9335c0cd073208da8c4f2e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月白 まひる","creatorId":"vndb:s17075","sourcePersonId":"vndb:s17075","canonicalEntityId":"vndb:s17075","name":"星谷 美緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90265","source":"vndb"}]},{"characterId":"char_vndb_c104595","characterName":"きんぐ","sourceIds":{"vndbCharacterId":"c104595"},"originalCharacterName":"きんぐ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Fumiaaaaa a nice day today.......)\""},{"spoiler":false,"text":"A black cat who resides on the cat tower in the common room of Minato Dormitory."},{"spoiler":false,"text":"He is a cat of the Yasaka family, and is loved by everyone in the dormitory, especially Kanon. He usually roams around the Yasaka's house and the dormitory, and rarely goes beyond these areas. However, he often appears by Yuuki's side, whenever something happens to him."},{"spoiler":false,"text":"Translated and edited from the Official website"},{"spoiler":true,"text":"It is revealed later in the story that King was sent from another world to watch over the Yasaka family, particularly Yuuki."}],"source":"vndb","sourceCharacterId":"c104595"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c46dfb58c7d5d08cff2e99e37c04f7d00f684b400d11de804cbd9cdb324f396e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1c3652de5d8ea161f6f8c48b01dc1be428c0a2e587286ee239f8f13282e66be.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幕張 天人","creatorId":"vndb:s15693","sourcePersonId":"vndb:s15693","canonicalEntityId":"vndb:s15693","name":"幕張天人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90264","source":"vndb"}]},{"characterId":"char_vndb_c104596","characterName":"八坂 勇気","sourceIds":{"vndbCharacterId":"c104596"},"originalCharacterName":"八坂 勇気","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"505"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kanon's twin brother, and the only male member of the Yasaka family after their father passed away."},{"spoiler":false,"text":"He has been helping with the dormitory work since he was a child. Because he was surrounded by women his whole life, he is used to dealing with them. He can use a little bit of magic, but this must be kept secret since no one outside of the Yasaka family should know that they can use magic."},{"spoiler":false,"text":"Due to his strong sense of justice, whenever he sees someone in trouble, he always reaching out to them, even though this is sometimes opposed by Hiiragi."},{"spoiler":false,"text":"Translated and edited from the Official website"},{"spoiler":true,"text":"It is revealed later in the story that Yuuki, Kanon, and Hiiragi came from another world. Their father was a hero and their mother was a princess of a certain kingdom. When Yuuki and Kanon were infants, their kingdom was besieged by the demon lord's army, so their parents entrusted them to Hiiragi who is the hero's best friend, and sacrificed themselves in order to sent them to another world, along with the building that is now Minato Dormitory. However, their souls still reside in their children."},{"spoiler":true,"text":"In the end, they are able to go back to their world and defeat the demon lord, but leave Yuuki and Kanon behind in the current world because both of them choose to stay there, and wishing them happiness in their new lives."}],"source":"vndb","sourceCharacterId":"c104596"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1deae4c0224421e9a33ca319e0077b6d6979ab684421c439236ffb6de682e10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd38304d421a4a2a35c69ea8bc398dd86854c4a1824bd6d9163cbc2e7a7ebe42.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p735","sourceCompanyId":"egs:brand:2715","canonicalEntityId":"vndb:p735","name":"CUBE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:32328:2715","source":"egs"},{"companyId":"vndb:p17423","sourceCompanyId":"vndb:p17423","canonicalEntityId":"vndb:p17423","name":"诗蓝汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:114707:v33494","source":"vndb"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:126938:v33494","source":"vndb"},{"companyId":"vndb:p735","sourceCompanyId":"vndb:p735","canonicalEntityId":"vndb:p735","name":"CUBE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:96455:v33494","source":"vndb"},{"companyId":"vndb:p735","sourceCompanyId":"vndb:p735","canonicalEntityId":"vndb:p735","name":"CUBE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:97774:v33494","source":"vndb"},{"companyId":"vndb:p735","sourceCompanyId":"vndb:p735","canonicalEntityId":"vndb:p735","name":"CUBE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:98598:v33494","source":"vndb"},{"companyId":"vndb:p735","sourceCompanyId":"vndb:p735","canonicalEntityId":"vndb:p735","name":"CUBE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:98679:v33494","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
