dbCharacterId":"c76125"},"originalCharacterName":"神代 澄香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"97"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Magia: Sacred Law, a power that allows the user to heal wounds."},{"spoiler":false,"text":"Sumika is a kind and open-hearted young woman who wants desperately for Magia Saucers and normal humans to get along, and she works hard to achieve that."},{"spoiler":false,"text":"She can often be found baking cakes and making other sweets in her club's room."},{"spoiler":true,"text":"Sacred Law is actually a power that can grant wishes, if enough people wish for the same thing or the wish is strong enough. Sumika saved the protagonist's life in the past, during an incident where his parents died."}],"source":"vndb","sourceCharacterId":"c76125"},{"segments":[{"spoiler":false,"text":"一年生。総司郎と同じクラスで委員長。"},{"spoiler":false,"text":"学園創設一族の生まれで裕福であるにも関わらず偉ぶらず威張らず、相手に共感し親身になる。純粋で裏表がほとんど無い為、危なっかしく見えることもあるがまっすぐで芯が強い女の子。"},{"spoiler":false,"text":"心が読める総司郎にとっては裏表の無い澄香はかなり特異な人物となる。"},{"spoiler":false,"text":"能力者と非能力者の仲取り持ちを目的とした『特設学生部』の部長でもある。"}],"source":"egs","sourceCharacterId":"20952","sourceWorkId":"27331","spoiler":false},{"segments":[{"spoiler":false,"text":"一年生。総司郎と同じクラスで委員長。"},{"spoiler":false,"text":"学園創設一族の生まれで裕福であるにも関わらず偉ぶらず威張らず、"},{"spoiler":false,"text":"相手に共感し親身になる。純粋で裏表がほとんど無い為、"},{"spoiler":false,"text":"危なっかしく見えることもあるがまっすぐで芯が強い女の子。"},{"spoiler":false,"text":"心が読める総司郎にとっては裏表の無い澄香はかなり特異な人物となる。"},{"spoiler":false,"text":"能力者と非能力者の仲取り持ちを目的とした『特設学生部』の部長でもある。"},{"spoiler":false,"text":"治癒能力と目されているが重傷者を治療することもあるし、"},{"spoiler":false,"text":"かすり傷すら治せないこともあるなどよくわかっていない能力。"},{"spoiler":false,"text":"そのほかにも不思議な事が身の回りに起きるようで、"},{"spoiler":false,"text":"「下着がずれたり……」と恥ずかしい体験もある謎の能力。"},{"spoiler":false,"text":"「いたいの、いたいの、とんでけー……♪」"}],"source":"bangumi","sourceCharacterId":"67897"}],"profileFacts":[{"label":"胸围（本版本）","value":"97 cm","valueContext":null,"source":"egs","sourceCharacterId":"20952","sourceWorkId":"27331","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"20952","sourceWorkId":"27331","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"20952","sourceWorkId":"27331","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"20952","sourceWorkId":"27331","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b47059c1cccdb4ce783d632f4287e609d88c096a02912e189f990f259884da74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f69513095d63950b8dedea5a88e817e64634709cb7845ca8ef2fcaf66b1c6e5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:264182:67897:7302:1","source":"bangumi"}]},{"characterId":"char_c76126","characterName":"小町谷 菜砂","sourceIds":{"bangumi":[{"characterId":"67898","match":"exact-normalized-name-in-linked-work","subjectId":"264182"}],"egsCharacterIds":["20953"],"vndbCharacterId":"c76126"},"originalCharacterName":"小町谷 菜砂","characterNameSource":null,"role":"primary","status":"source-onl