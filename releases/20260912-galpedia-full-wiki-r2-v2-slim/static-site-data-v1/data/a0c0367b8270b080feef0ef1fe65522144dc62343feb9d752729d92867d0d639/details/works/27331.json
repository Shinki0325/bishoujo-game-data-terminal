!?後輩なのにっ!?」"}],"source":"bangumi","sourceCharacterId":"67898"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"20953","sourceWorkId":"27331","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"20953","sourceWorkId":"27331","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"20953","sourceWorkId":"27331","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"20953","sourceWorkId":"27331","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc40b31d1cbce8ace78efd0b18bc54e584270846eab368688679a3dd404e6b83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cc61d0ba0b2a6aef89e7744112ad9738e68099bede23201864bba4ba6c7f7d9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:264182:67898:8493:1","source":"bangumi"}]},{"characterId":"char_c76127","characterName":"帯刀 千早","sourceIds":{"bangumi":[{"characterId":"67899","match":"exact-normalized-name-in-linked-work","subjectId":"264182"}],"egsCharacterIds":["20954"],"vndbCharacterId":"c76127"},"originalCharacterName":"帯刀 千早","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"