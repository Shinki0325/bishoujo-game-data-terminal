-in-linked-work","subjectId":"18499"}],"egsCharacterIds":["21200"],"vndbCharacterId":"c13509"},"originalCharacterName":"小日向 羽音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"汐美学園二年生。"},{"spoiler":false,"text":"恋愛部部員。"},{"spoiler":false,"text":"気が弱く、いつもオドオドとしている女の子。"},{"spoiler":false,"text":"また男性恐怖症気味で、男性を前にするとパニック状態になる。"},{"spoiler":false,"text":"その男性恐怖症を克服するために恋愛部に入った。"},{"spoiler":false,"text":"いつもハート型のロケットを身に付けており、その中には大切な人の写真が入っているらしいが……。"}],"source":"egs","sourceCharacterId":"21200","sourceWorkId":"8960","spoiler":false},{"segments":[{"spoiler":false,"text":"汐美学園二年生。恋愛部部員。 気が弱く、おどおどと自信なさそうにしているおとなしい女の子。"},{"spoiler":false,"text":"いつも首からロケットを吊るしている。中には大切な人の写真が 入っているらしいが、詳細は本人しか知らない。"},{"spoiler":false,"text":"男を前にすると緊張して挙動不審になることが多い。いわゆる男性恐怖症。 それを克服するために、恋愛部に所属している。"}],"source":"bangumi","sourceCharacterId":"27156"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc10137af026238a26a242cfec72991fbf65de91b0f89b5cc3f94e2a3d349cdc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02cf94c2f37bfb6eb13230d6ec44bfbf4911b726eb9f4ccabcfabd177e7f3baa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18499:27156:6549:1","source":"bangumi"}]},{"characterId":"char_c13510","characterName":"浅香 小萌","sourceIds":{"bangumi":[{"characterId":"27154","match":"exact-normalized-name-in-linked-work","subjectId":"18499"}],"egsCharacterIds":["21201"],"vndbCharacterId":"c13510"},"originalCharacterName":"浅香 小萌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"汐美学園一年生。"},{"spoiler":false,"text":"主人公の幼馴染で、うたはや海とも仲が良い。"},{"spoiler":false,"text":"明朗快活で、さっぱりした性格。"},{"spoiler":false,"text":"陸上部に所属し、ホープとして期待されているが、片想いの主人公が恋愛部に入部したことから、それを追って恋愛部に入部し、陸上部と兼任することとなった。"}],"source":"egs","sourceCharacterId":"21201","sourceWorkId":"8960","spoiler":false},{"segments":[{"spoiler":false,"text":"汐美学園一年生。遊の幼なじみで、うたはや海とも仲が良い。 明るく活発、さばさばした性格で、誰からも好かれている。"},{"spoiler":false,"text":"前の学校では陸上部に所属していて、県大会で賞を取った こともある。"},{"spoiler":false,"text":"汐美学園でも陸上部に所属しているが、遊が恋愛部に入った ため、それを追うかたちで恋愛部にも兼部することになった。"},{"spoiler":false,"text":"小萌のほうはいつか遊に自分の気持ちを告白しようとチャンスを 狙っているのだが、いつもうまくいかずにやきもきする日々を 送っている。"}],"source":"bangumi","sourceCharacterId":"27154"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a982a6180a3281e9e6331d5543c4f88cda23a69031e1c2efaf5a9f18086446c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54eec59d8c89d464773baccdb92c8c25ea591aa8221f07164b2d0dca3bb5d8d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18499:27154:5890:1","source":"bangumi"}]},{"characterId":"char_c13511","characterName":"鹿子木 ゆう","sourceIds":{"bangumi":[{"characterId":"27152","match":"exact-normalized-name-in-linked-work","subjectId":"18499"}],"egsCharacterIds":["21198"],"vndbCharacterId":"c13511"},"originalCharacterName":"鹿子木 ゆう","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"汐美学園三年生。"},{"spoiler":false,"text":"恋愛部の創設者であり部長。"},{"spoiler":false,"text":"帰宅部だった主人公を無理やり恋愛部に入部させた張本人。"},{"spoiler":false,"text":"学園にも利強力のある地元の有名な家柄の娘で、その権威を利用して恋愛部を創設した。"},{"spoiler":false,"text":"自由奔放な上にアグレッシブな性格で、周囲を巻き込んで盛り上がるムードメーカー的存在。"},{"spoiler":false,"text":"背が低く、童顔であることにコンプレックスを抱いているらしく、それを指摘されると烈火の如く怒る。"}],"source":"egs","sourceCharacterId":"21198","sourceWorkId":"8960","spoiler":false},{"segments":[{"spoiler":false,"text":"恋愛部創設者にして現・部長。そして、ラブロワの賞品。"},{"spoiler":false,"text":"遊を帰宅部という理由だけで無理やり恋愛部に勧誘した張本人。部活内ではムードメーカー的存在で、「無理やり」「強引」 と言われながらも、にぎやかで行動力があり、周囲を 巻き込むパワーを持っている。"},{"spoiler":false,"text":"地元では有名な家柄のひとり娘で、恋愛部が存続できているのもその影響ではないかと、もっぱらの噂。"},{"spoiler":false,"text":"背が低く童顔なため、どちらかというと年下に見えるが コンプレックスを抱いているらしく、指摘すると激しく怒る。"}],"source":"bangumi","sourceCharacterId":"27152"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c434a2013bdc37b8f66bd9fb55e6e468214daf65dff19ac9bdb85f153f2db7c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5daa5aa7ab4a5c4a23c1be39681d42d18b8f3e0f4b02e5e3e5c6a6064087ef9b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前川優子","creatorId":"vndb:s1064","sourcePersonId":"vndb:s1064","canonicalEntityId":"vndb:s1064","name":"前川 優子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18499:27152:6321:1","source":"bangumi"}]},{"characterId":"char_vndb_c13472","characterName":"渡会 俊之","sourceIds":{"vndbCharacterId":"c13472"},"originalCharacterName":"渡会 俊之","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFac