iki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1365e45504376e88302fad8a33ac04c68a3823b1c1acb4abcfc251f2c3bff52e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蓮 岳大","creatorId":"vndb:s15695","sourcePersonId":"vndb:s15695","canonicalEntityId":"vndb:s15695","name":"蓮 岳大","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31098","source":"vndb"}]},{"characterId":"char_vndb_c101247","characterName":"密林の虎","sourceIds":{"vndbCharacterId":"c101247"},"originalCharacterName":"密林の虎","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4845c492f74c8b00a95a7bc5946901bd180e1003f009f1f93ffa8be8445c214.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e56c78cd0b9f6a4165dff18919f856700f8eefd3bab9b5be62bd4b1752880063.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさぎ 夕","creatorId":"vndb:s245","sourcePersonId":"vndb:s245","canonicalEntityId":"vndb:s245","name":"鈴木 裕斗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31095","source":"vndb"}]},{"characterId":"char_vndb_c14485","characterName":"JJ","sourceIds":{"vndbCharacterId":"c14485"},"originalCharacterName":"JJ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"301"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Residence: Since he moved from the metropolitan area, he now lives in a prefabricated abandoned building."},{"spoiler":false,"text":"Nationality: Japan."},{"spoiler":false,"text":"Weapons: An old fashioned M16A2 rifle, Beretta M92F."},{"spoiler":false,"text":"JJ is a cold-blooded hitman who is known by the name of \"Death Scythe\" or Shinigami (God of Death) for he always ensures that his victims really are dead. Although he is reticent and blunt, JJ also has a good side."},{"spoiler":false,"text":"When he was little, he have lost his parents in a plane crash caused by a certain gang. The boss of that gang has raped him countless times before he made him into a child soldier of his gang. He was treated so badly every day, he even forgot his real name. He was then called JJ, which is short for \"Jap. Junior\". After that group has been taken down, JJ was taken back to Japan, where he was put into rehab. While wondering why is he still alive, JJ realizes that he's been a soldier for so long, that the only thing he knows and can think about is killing. He then finds a himself a town when he becomes a serial killer. During one of his jobs he meets Azusa, who is a son of his target whom he failed to kill."},{"spoiler":false,"text":"Summarized from a translation of the Japanese Wikipedia combined with Sandeian's blog post."}],"source":"vndb","sourceCharacterId":"c14485"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/747c2749a5888fd9557335b8564f63579a4cf9912513b01753b03892c566930e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b4152ed957c518dbadcd5ead05765a161ab419c82cf42f9065b9d7c4867b49d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"城ヶ崎 仁","creatorId":"vndb:s4805","