{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9797","model":{"presentationWorkId":"vndb:v2240","staff":{"artwork":[],"scenario":[{"creditedName":"蒼夜","creatorId":"vndb:s3044","sourcePersonId":"vndb:s3044","canonicalEntityId":"vndb:s3044","name":"蒼夜","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:33070","source":"vndb"},{"creditedName":"影花","creatorId":"vndb:s6488","sourcePersonId":"vndb:s6488","canonicalEntityId":"vndb:s6488","name":"影花","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:33071","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c4033","characterName":"佐々山 深雪","sourceIds":{"bangumi":[{"characterId":"30977","match":"exact-normalized-name-in-linked-work","subjectId":"128057"},{"characterId":"30977","match":"exact-normalized-name-in-linked-work","subjectId":"222171"}],"egsCharacterIds":["572"],"vndbCharacterId":"c4033"},"originalCharacterName":"佐々山 深雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おおざっぱでいい加減なところがあるが、肉感的で色っぽい大人の女性。"},{"spoiler":false,"text":"学生達から恋愛相談を持ちかけられることもある。十彦のことを嫌っていて監視している。"},{"spoiler":false,"text":"――視姦趣味"},{"spoiler":false,"text":"実は男性経験が全くない処女。欲求不満で玩具を使い自らを慰めている。"},{"spoiler":false,"text":"男性に視姦されるのは嫌だが、意識すると興奮してしまう。"}],"source":"egs","sourceCharacterId":"572","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"魅惑の女教師。"},{"spoiler":false,"text":"スタイル抜群な上に美人とあって、男からいやらしい視線を浴び続けている。"},{"spoiler":false,"text":"最初は嫌だったが、徐々に視られることに快感を覚えるようになった。"},{"spoiler":false,"text":"現在では、自慰のときも誰かに視られていることを想像しながら耽るようになってしまった。"}],"source":"egs","sourceCharacterId":"572","sourceWorkId":"9799","spoiler":false},{"segments":[{"spoiler":false,"text":"【主人公の担任／数学の教師】"},{"spoiler":false,"text":"学園の数学の教師。学生に対して厳しく接するも面倒見は良い。"},{"spoiler":false,"text":"教師という仕事に強い誇りを持っている。"},{"spoiler":false,"text":"堅物な性格で厳しい面があるため、美人の割に言い寄ってくる男少ない。"},{"spoiler":false,"text":"教職の仕事を最優先に考えており、恋愛にまで手が回らない状態である。"},{"spoiler":false,"text":"主人公はそんな深雪のことがすきで、彼女にアプローチを掛けるが深雪はあくまで学生のひとりとして主人公を扱う。"}],"source":"egs","sourceCharacterId":"572","sourceWorkId":"18592","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の教師。おおざっぱで、いい加減なところがあるが、学生から恋愛相談を持ちかけられることも。 主人公をとても嫌っていて監視している。"},{"spoiler":false,"text":"実はまだ処女。男性経験もまったくなく、欲求不満でおもちゃを購入している。 昔から男に視姦されており、意識するように。嫌だったが、見られて興奮することに気づく。"}],"source":"bangumi","sourceCharacterId":"30977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98457883213828a6ac6d13db57ddfab49359a6130794fd81a963f16ce792f8b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4acca1c9fec7c127040b066db19d9b03944c971fb57aede9519c25e453261377.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森山葵","creatorId":"vndb:s2926","sourcePersonId":"vndb:s2926","canonicalEntityId":"vndb:s2926","name":"森山 葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222171:30977:22079:1","source":"bangumi"}]},{"characterId":"char_c4036","characterName":"上月 里香子","sourceIds":{"bangumi":[{"characterId":"30982","match":"exact-normalized-name-in-linked-work","subjectId":"128057"}],"egsCharacterIds":["19281"],"vndbCharacterId":"c4036"},"originalCharacterName":"上月 里香子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学級委員を務める真面目な学生。"},{"spoiler":false,"text":"男嫌いな上、清潔感があり、近寄りがたい雰囲気を出している。"},{"spoiler":false,"text":"――痴漢待ち"},{"spoiler":false,"text":"電車の中での痴漢行為に反応してしまう。"},{"spoiler":false,"text":"以来、痴漢行為で感じてしまうようになった。"}],"source":"egs","sourceCharacterId":"19281","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"『痴漢好き』のヒロイン。"},{"spoiler":false,"text":"真面目な優等生。"},{"spoiler":false,"text":"通学途中の電車の中で女性に痴漢されて以来、電車に乗るたびに身体が疼くようになってしまった。"}],"source":"egs","sourceCharacterId":"19281","sourceWorkId":"9802","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の痴漢のターゲットとなった女の子。"},{"spoiler":false,"text":"主人公と学園が違い女学園に通っている。"},{"spoiler":false,"text":"男が大嫌いというわけではないが苦手意識はかなり強い。"},{"spoiler":false,"text":"主人公に痴漢されて初めて感じてしまう。"},{"spoiler":false,"text":"自分の性癖をかなり嫌悪している。"},{"spoiler":false,"text":"性格はおとなしいが、男と話すときは"},{"spoiler":false,"text":"少し口調がこわばってしまう。"}],"source":"egs","sourceCharacterId":"19281","sourceWorkId":"20445","spoiler":false},{"segments":[{"spoiler":false,"text":"学級委員で真面目な眼鏡っ子。清潔感があり、近寄りがたい雰囲気。 校則にはとても厳しく、特に男女交際は対応がキツイ。"},{"spoiler":false,"text":"元々男嫌いだったが、実は痴漢行為に興奮する。身体を触られたが、痴漢ではなくて痴女だった。 そのとき、男でないとわかって、安心してしまう。結果、男でも女でも痴漢で感じる性癖になる。"}],"source":"bangumi","sourceCharacterId":"30982"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/249d94df7cd8c8824311d16ff469b64a6cff987bff68a9ce8a11cab07ad9d59d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bfb99cc03d60258d028666b0e41af42c72aedfa7f25cb4544116f2c41bdb468.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篁 瑞帆","creatorId":"vndb:s3539","sourcePersonId":"vndb:s3539","canonicalEntityId":"vndb:s3539","name":"篁 瑞帆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:17628","source":"vndb"}]},{"characterId":"char_c4037","characterName":"朝宮 静姫","sourceIds":{"bangumi":[{"characterId":"30975","match":"exact-normalized-name-in-linked-work","subjectId":"128057"},{"characterId":"30975","match":"exact-normalized-name-in-linked-work","subjectId":"222169"}],"egsCharacterIds":["268"],"vndbCharacterId":"c4037"},"originalCharacterName":"朝宮 静姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大人しくて気弱な学生。"},{"spoiler":false,"text":"清楚で可憐な乙女という雰囲気を出しており、それなりに見栄えはよい。"},{"spoiler":false,"text":"ただ押しに弱く、強く頼まれると断る事が出来ない。"},{"spoiler":false,"text":"――肛虐好き"},{"spoiler":false,"text":"以前座***を入れたときに感じていまい、それ以来アナルに興味が出てくる。"},{"spoiler":false,"text":"嫌悪感もあるがやめられず、自慰の時はつい触ってしまう。"}],"source":"egs","sourceCharacterId":"268","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"『肛虐願望の少女』のヒロイン。"},{"spoiler":false,"text":"ア○ルが敏感な女子学生。"},{"spoiler":false,"text":"普段は、おっとりしていて人当たりがよく、彼女が○ナルフェチであることを誰も知らない。"},{"spoiler":false,"text":"酷い風邪で座薬を使用したとき、朦朧とする意識の中で、アナ○に吸い込まれた座薬の快感に酔ってしまい、それが覚醒に繋がった。"}],"source":"egs","sourceCharacterId":"268","sourceWorkId":"9797","spoiler":false},{"segments":[{"spoiler":false,"text":"学生・ヒロイン。"},{"spoiler":false,"text":"主人公と同じ学園の学生で同級生。"},{"spoiler":false,"text":"おっとりとしており、どちらかというと天然系である。"},{"spoiler":false,"text":"そんな見かけによらず、学年で１・２を争う才女である。"},{"spoiler":false,"text":"交友関係も人気も学園でもトップクラスである。"},{"spoiler":false,"text":"ひたむきな主人公のことが大好きで、彼女から告白した。"},{"spoiler":false,"text":"付き合い始めて半年ほどが経過する。"},{"spoiler":false,"text":"主人公の様子がおかしいことに気がつきながらも強く指摘できない押しの弱さがある。"}],"source":"egs","sourceCharacterId":"268","sourceWorkId":"18594","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の生徒で、気弱そうな女の子。大人しくて、押しに弱い。"},{"spoiler":false,"text":"実はアナルに興味があり、座薬を入れたときに感じてしまう。 それ以来、自慰の時にはつい触ってしまう。嫌悪もあるのだが、やめられない。"}],"source":"bangumi","sourceCharacterId":"30975"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"268","sourceWorkId":"9797","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"268","sourceWorkId":"9797","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"268","sourceWorkId":"9797","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"268","sourceWorkId":"9797","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"44 kg","valueContext":null,"source":"egs","sourceCharacterId":"268","sourceWorkId":"9797","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2d6fbc0cc0727be9671828ac1b94d2ea0be8029348f4804583ea1113d56384a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da7f9406d3d0fb70a19dec3399969404e658a79b176bd2922e15524f9036afac.webp","width":213,"height":256,"sourc