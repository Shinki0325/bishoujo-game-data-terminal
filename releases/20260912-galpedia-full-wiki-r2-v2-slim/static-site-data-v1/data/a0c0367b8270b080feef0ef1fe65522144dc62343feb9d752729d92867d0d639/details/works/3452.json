{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3452","model":{"presentationWorkId":"vndb:v4297","staff":{"artwork":[{"creditedName":"ズンダレぽん","creatorId":"vndb:s1072","sourcePersonId":"egs:creator:187","canonicalEntityId":"vndb:s1072","name":"ズンダレぽん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5476","source":"egs"}],"scenario":[{"creditedName":"そのだまさき","creatorId":"vndb:s596","sourcePersonId":"egs:creator:900","canonicalEntityId":"vndb:s596","name":"そのだまさき","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5477","source":"egs"},{"creditedName":"さんきち","creatorId":"vndb:s2812","sourcePersonId":"vndb:s2812","canonicalEntityId":"vndb:s2812","name":"さんきち","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:48955","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c28710","characterName":"桜庭 真里乃","sourceIds":{"bangumi":[{"characterId":"94363","match":"exact-normalized-name-in-linked-work","subjectId":"266108"},{"characterId":"94363","match":"exact-normalized-name-in-linked-work","subjectId":"595175"}],"egsCharacterIds":["26955"],"vndbCharacterId":"c28710"},"originalCharacterName":"桜庭 真里乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の担任。"},{"spoiler":false,"text":"清楚で落ち着きがあり、年齢が20代後半なものの、純粋さを失わず、可憐という言葉が良く似合う女性。"},{"spoiler":false,"text":"躾に厳しい家庭に育ったせいか、性知識、経験とも貞操観念も強い。"},{"spoiler":false,"text":"優しく思いやりのある彼女は、良き相談相手として学生からも人気。"},{"spoiler":false,"text":"同じ学園で校医をしている和実は学生時代からの友人。"},{"spoiler":false,"text":"奔放な和実に誘われ、派手な遊びも経験したが、あまり馴染めなかったようだ。"}],"source":"egs","sourceCharacterId":"26955","sourceWorkId":"4194","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の担任。落ち着きのある清楚な雰囲気の中に、純粋さからくる可憐さをも含んだ美貌をもつ。好きになった人間には、誠心誠意尽くすタイプ。躾の厳しい良家の出のため、性の知識・経験はそれほどなく、貞操観念も強い。"},{"spoiler":false,"text":"学生からは親身になって相談にのってくれる優しい先生と見られている。和実とは学生時代からの友人。真里乃とは対照的に奔放なところのある和実に連れられて、一折、遊びというものも体験しているが、あまり馴染んでいなかった。逆にともすればハメをはずしすぎる和実をよく諌めた。それでも、自分の世界を広げてくれた存在として、和実には感謝の念も抱いている。"}],"source":"bangumi","sourceCharacterId":"94363"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/343c71f9d9e087fce6578aad46434bb87f4d73ac0910d9176b78b2d5dd188e17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2dc2c139ce50d5b1f80f2541666a9e6e4c30e69730b14187d8aaf0ba52c1295.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しまだかおり","creatorId":"vndb:s2665","sourcePersonId":"vndb:s2665","canonicalEntityId":"vndb:s2665","name":"しまだ かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266108:94363:18664:1","source":"bangumi"}]},{"characterId":"char_c28711","characterName":"佐伯 和実","sourceIds":{"bangumi":[{"characterId":"94364","match":"exact-normalized-name-in-linked-work","subjectId":"266108"},{"characterId":"94364","match":"exact-normalized-name-in-linked-work","subjectId":"595175"}],"egsCharacterIds":["26956"],"vndbCharacterId":"c28711"},"originalCharacterName":"佐伯 和実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の通う学園の校医。"},{"spoiler":false,"text":"物静かな性格の真里乃とは対照的に、奔放で派手な性格。"},{"spoiler":false,"text":"学園では人当たりがよく、気さくなこともあって、学生からは男女問わず人気がある。"},{"spoiler":false,"text":"その美貌と冗談ともつかない話をすることから、彼女にはエッチな噂が、枚挙にいとまがない。"},{"spoiler":false,"text":"学生時代からの友人・真里乃を連れ出し、派手な遊びに興じることもあるが、時に破目を外し過ぎて真里乃から諌められることも……。"}],"source":"egs","sourceCharacterId":"26956","sourceWorkId":"4194","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の学校の校医。白衣のイメージとは相反する蠱惑的な瞳の輝きを湛えた美女。その性格も、容貌同様に派手で刹那的な部分が多い。人当たりもよく陽気に振舞っているため、男子女子問わず学生たちに人気もある。"},{"spoiler":false,"text":"その一方で言動の端々に頭の回転の速さを示すような言葉や、何か意味深なものを相手に感じさせる。また学生を誘惑した、一夜を共にしたというような噂もちらほら聞こえてくる。 真里乃とは、学生時代からの友人。世間知らずだった真里乃を遊びに連れ出すことがしばしばあった。ハメをはずしすぎるところを真里乃に諌められることもしばしばあった。"}],"source":"bangumi","sourceCharacterId":"94364"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/081bb3f783a1cdb115edfff9228548a4984d04cc2ad95da77b98da4ce124c3f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/191e7fb47bd90347ac56315517b6e17b0774ed3bb3a45f6d391a5192c42cdabc.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155990","characterName":"山岡 伸也","sourceIds":{"vndbCharacterId":"c155990"},"originalCharacterName":"山岡 伸也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1413","sourceCompanyId":"egs:brand:1023","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3452:1023","source":"egs"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["publisher"],"identityStatus