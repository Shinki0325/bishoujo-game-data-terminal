","subjectId":"26441"}],"egsCharacterIds":["27005"],"vndbCharacterId":"c10732"},"originalCharacterName":"高月 未依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"43kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"12年前に彼女の母親が再婚し、主人公・一海の義妹となった。"},{"spoiler":false,"text":"主人公らと一緒に暮らす前は「社」で生活していた。"},{"spoiler":false,"text":"ぽけーっとしているが、何事にも一生懸命で、明るく天真爛漫。"},{"spoiler":false,"text":"とっても純粋で、将来の夢は「お嫁さん」。"}],"source":"egs","sourceCharacterId":"27005","sourceWorkId":"2105","spoiler":false},{"segments":[{"spoiler":false,"text":"１２年前に母親が再婚して、主人公の義妹になる。"},{"spoiler":false,"text":"それまでは『社』で生活していた。"},{"spoiler":false,"text":"物心ついた頃から主人公と一緒に遊んだりしており、"},{"spoiler":false,"text":"本当の兄妹のように仲がいい。"},{"spoiler":false,"text":"明るくて天真爛漫。"},{"spoiler":false,"text":"ちょっとぽけーっとしている。"},{"spoiler":false,"text":"おまけに世話好き。"},{"spoiler":false,"text":"毎日のように主人公を起こしにくる。"},{"spoiler":false,"text":"何事にも一生懸命。"},{"spoiler":false,"text":"なので、常人より体力の消耗が早い。"},{"spoiler":false,"text":"料理大好き。でも和食しか作れない。"},{"spoiler":false,"text":"背が小さいのを気にしている。"},{"spoiler":false,"text":"胸が小振りなのを気にしている。"},{"spoiler":false,"text":"色気がないのを気にしている。"},{"spoiler":false,"text":"……その筋の人にはたまらないのになぁ（ぼそ）。"}],"source":"bangumi","sourceCharacterId":"139917"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c00bae6eed9cb7fb906955c9b896488a21fd68b22aaa6cb143b6cbe3b4fa4bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9a38e779ed964e0f8ddc60343d492ad23de616d485029323f321a8073203991.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜井ミウ","creatorId":"vndb:s22552","sourcePersonId":"vndb:s22552","canonicalEntityId":"vndb:s22552","name":"桜井ミウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32630","source":"vndb"}]},{"characterId":"char_c10737","characterName":"桜井 知絵","sourceIds":{"bangumi":[{"characterId":"139918","match":"exact-normalized-name-in-linked-work","subjectId":"153682"},{"characterId":"139918","match":"exact-normalized-name-in-linked-work","subjectId":"26441"}],"egsCharacterIds":["27006"],"vndbCharacterId":"c10737"},"originalCharacterName":"桜井 知絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"喫茶店「Oasis」の一人娘。"},{"spoiler":false,"text":"未依の親友にして、主人公の幼馴染。"},{"spoiler":false,"text":"母親を早くに亡くし、喫茶店のマスターの父と二人暮らし。"},{"spoiler":false,"text":"生まれつき右足が悪く、いつも杖を持ち歩いている。"},{"spoiler":false,"text":"明朗快活で、ポジティブな性格。"},{"spoiler":false,"text":"電話が大好きで、携帯電話の月額通信料は3万円……。"}],"source":"egs","sourceCharacterId":"27006","sourceWorkId":"2105","spoiler":false},{"segments":[{"spoiler":false,"text":"未依の親友＆主人公の幼馴染み。"},{"spoiler":false,"text":"未依とは同級生でもある。"},{"spoiler":false,"text":"喫茶店『Ｏａｓｉｓ』の一人娘。"},{"spoiler":false,"text":"そこのマスターである父親と二人暮らし。"},{"spoiler":false,"text":"母親は物心つく前に家を離れており、詳しいことはよく知らない。"},{"spoiler":false,"text":"生まれつき右脚に病気を抱えていて、いつも杖をついて歩いている。"},{"spoiler":false,"text":"とても明るくて、さわやかさんな性格。"},{"spoiler":false,"text":"何事に対してもポジティブ（脚のことは除く） 。"},{"spoiler":false,"text":"主人公とは仲が良く、性格もなんだか似ている"},{"spoiler":false,"text":"（口より先に手が出るところとか）。"},{"spoiler":false,"text":"小さい頃から、未依を含めて３人でいることが多かった。"},{"spoiler":false,"text":"自分の体に行動制限があるため、もの凄く電話好き。"},{"spoiler":false,"text":"月の携帯通信料、しめて３万円也。"},{"spoiler":false,"text":"端末を取られると死んじゃう。"},{"spoiler":false,"text":"もちろん杖を取られても死んじゃう。"},{"spoiler":false,"text":"……何げに弱点多いねキミ。"},{"spoiler":false,"text":"自分を生んでくれた母親を尊敬している。"},{"spoiler":false,"text":"お父さんは別にどうでもいい（こらこら）。"}],"source":"bangumi","sourceCharacterId":"139918"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d158d14b4ba3872b0a2e87ab5d67067f75533b24529e53130025e15b4f66bcb0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1a93b49ae5a551af7aa5c0d800afc6ae5624fe11ab86486478535fa6c476dd8.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川崎恵理子","creatorId":"vndb:s121","sourcePersonId":"vndb:s121","canonicalEntityId":"vndb:s121","name":"川崎 恵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153682:139918:4034:1","source":"bangumi"}]},{"characterId":"char_c10738","characterName":"有坂 まつり","sourceIds":{"bangumi":[{"characterId":"139919","match":"exact-normalized-name-in-linked-work","subjectId":"153682"},{"characterId":"139919","match":"exact-normalized-name-in-linked-work","subjectId":"26441"}],"egsCharacterIds":["27007"],"vndbCharacterId":"c10738"},"originalCharacterName":"有坂 まつり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"未依の母親が巫女の任期を終えたことから、その入れ替わりで「社」にやってきた巫女さん。"},{"spoiler":false,"text":"人懐っこく、いつもぽやぽやした笑顔を絶やさない、まったり娘。"},{"spoiler":false,"text":"運動神経がないのか、何もないところでもよく転ぶ。"},{"spoiler":false,"text":"「社」の巫女さんは「結界」を守る役割があることから、結界の外に出ることが許されないが、本人は、あまり苦にしていない様子で、のほほんと役割を果たしているようだ。"}],"source":"egs","sourceCharacterId":"27007","sourceWorkId":"2105","spoiler":false},{"segments":[{"spoiler":false,"text":"『社』に住んでいる当代の巫女さん。"},{"spoiler":false,"text":"１２年前、未依の母親が巫女の任期を終了したときに、"},{"spoiler":false,"text":"入れ替わりでやって来た。"},{"spoiler":false,"text":"幼いながらも巫女さんとして『社』に住むことになる。"},{"spoiler":false,"text":"主人公とは同い年。"},{"spoiler":false,"text":"どことなく犬っぽい。"},{"spoiler":false,"text":"……なもんで、とても人なつっこい。"},{"spoiler":false,"text":"いつもぽやぽやした笑みを浮かべている。"},{"spoiler":false,"text":"ひなたぼっこが日課。"},{"spoiler":false,"text":"いつ見ても暇そう。"},{"spoiler":false,"text":"まったり娘。"},{"spoiler":false,"text":"何もないところで転ぶ。"},{"spoiler":false,"text":"何かあっても転ぶ。"},{"spoiler":false,"text":"七つの巫術が使える……という触れ込み。"},{"spoiler":false,"text":"ちなみに、誰も見たことはない。"}],"source":"bangumi","sourceCharacterId":"139919"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29adcff22dd2ac97d607a7ff1f532db76cda8f4c10492d48e2b56d5a64210e6b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e72b90b45ed144ca44acbf5bdaacb7c64f4904adfd9c035b2c194b4514b7347.webp","width":230,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153682:139919:6036:1","source":"bangumi"}]},{"characterId":"char_c10739","characterName":"有坂 詩奈","sourceIds":{"bangumi":[{"characterId":"139920","match":"exact-normalized-name-in-linked-work","subjectId":"153682"},{"characterId":"139920","match":"exact-normalized-name-in-linked-work","subjectId":"26441"}],"egsCharacterIds":["27008"],"vndbCharacterId":"c10739"},"originalCharacterName":"有坂 詩奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"まつりの妹。"},{"spoiler":false,"text":"巫女の任期が終わる姉を故郷に連れ戻すためにやってきた。"},{"spoiler":false,"text":"無口で、無愛想で、お堅い感じの女の子。"},{"spoiler":false,"text":"実は人付き合いがよくわからず、クールを装っているが、かなりのお姉ちゃん子で甘えん坊。"},{"spoiler":false,"text":"また箱入り娘で世間知らずなことから、なんでも鵜呑みいしてしまうところも。"}],"source":"egs","sourceCharacterId":"27008","sourceWorkId":"2105","spoiler":false},{"segments":[{"spoiler":false,"text":"まつりの妹。"},{"spoiler":false,"text":"巫女の任期を終える姉を、故郷へ連れ戻すために『社』にやって来た。"},{"spoiler":false,"text":"まじめでお堅い感じの女の子。"},{"spoiler":false,"text":"無口で無愛想（照れ屋さんなんだからこいつぅ）。"},{"spoiler":false,"text":"人付き合いの仕方がよく分からない。"},{"spoiler":false,"text":"かなりのお姉ちゃんっ子で、甘えん坊。"},{"spoiler":false,"text":"箱入り娘なもんで、世情に疎い。"},{"spoiler":false,"text":"適当なことを教えると、それを鵜呑みにする。"},{"spoiler":false,"text":"常に食べ物のことを考えている。"},{"spoiler":false,"text":"食い気は多いくせに、今まで経験がないため料理はまったく作れない。"},{"spoiler":false,"text":"というか素質がない。"}],"source":"bangumi","sourceCharacterId":"139920"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/affd3d7ba621f6ca44bbdc75d78834d62dee54c26c8151465064b48efcb8ca0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c62ed4db9d9ee0f1bb186cd43ceb05e2378250e96be6ca2492c4269f7b24b03.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日向裕羅","creatorId":"vndb:s562","sourcePersonId":"vndb:s562","canonicalEntityId":"vndb:s562","name":"日向 裕羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153682:139920:4673:1","source":"bangumi"}]},{"characterId":"char_c10934","characterName":"菅原 里美","sourceIds":{"bangumi":[{"characterId":"139921","match":"exact-normalized-name-in-linked-work","subjectId":"153682"},{"characterId":"139921","match":"exact-normalized-name-in-linked-work","subjectId":"26441"}],"egsCharacterIds":["27009"],"vndbCharacterId":"c10934"},"originalCharacterName":"菅原 里美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"知絵が通う病院の美人女医。"},{"spoiler":false,"text":"最近、この街に赴任してきたばかりだが、昔、この街に住んでいたことがあるらしく、すっかり馴染んでいる。"},{"spoiler":false,"text":"落ち着いた雰囲気のある理知的な女性だが、非常に気さくで親しみやすいお姉さん。"},{"spoiler":false,"text":"外科手術の分野では権威的な腕前。"},{"spoiler":false,"text":"さんまが大好物で、1日1食はさんまを食べないと死んじゃう（笑）。"}],"source":"egs","sourceCharacterId":"27009","sourceWorkId":"2105","spoiler":false},{"segments":[{"spoiler":false,"text":"知絵の担当医。"},{"spoiler":false,"text":"最近、要町に赴任してきたばかり。"},{"spoiler":false,"text":"昔、この町に住んでいたことがあるらしく、すっかり馴染んでいる。"},{"spoiler":false,"text":"外科手術の分野では、権威的な存在。"},{"spoiler":false,"text":"その実力は、一部で魔法の手と言わしめるほど。"},{"spoiler":false,"text":"落ち着いていて、理知的。"},{"spoiler":false,"text":"でも気さくでいいお姉さん。"},{"spoiler":false,"text":"実は、かわいいものに目がない。"},{"spoiler":false,"text":"さんま定食にも目がない。"},{"spoiler":false,"text":"一日一食は食べないと死んじゃう。"}],"source":"bangumi","sourceCharacterId":"139921"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9376b602eefca4daad240b50f1d3a5416f7584acd1bd3d319f070767153df2a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfef15e5a3eb614df192982f806f0abaa6e1d423617decc61d060154f9569eae.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤代奈央","creatorId":"vndb:s2717","sourcePersonId":"vndb:s2717","canonicalEntityId":"vndb:s2717","name":"藤代 奈央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153682:139921:7782:1","source":"bangumi"}]},{"characterId":"char_c10935","characterName":"高月 琳","sourceIds":{"bangumi":[{"characterId":"139922","match":"exact-normalized-name-in-linked-work","subjectId":"153682"},{"characterId":"139922","match":"exact-normalized-name-in-linked-work","subjectId":"26441"}],"egsCharacterIds":["27010"],"vndbCharacterId":"c10935"},"originalCharacterName":"高月 琳","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"未依の母親で、主人公にとっては継母。"},{"spoiler":false,"text":"まつりの先代の巫女さんで、12年前までは「社」で暮らしていた。"},{"spoiler":false,"text":"年齢を感じさせない若々しさで、主人公と同い年程度にしか見えない。"},{"spoiler":false,"text":"家事全般を完璧にこなす、元気ハツラツなお母さんで、商店街に出れば「値切り交渉人」として恐れられている。"}],"source":"egs","sourceCharacterId":"27010","sourceWorkId":"2105","spoiler":false},{"segments":[{"spoiler":false,"text":"未依の母親で、主人公の継母"},{"spoiler":false,"text":"（未依の父親は、１８年前に亡くなっている）。"},{"spoiler":false,"text":"まつりの先代の巫女さんで、１２年前まで社に住んでいた。"},{"spoiler":false,"text":"巫女さん時代は、とても清楚で儚げな女の子でした。"},{"spoiler":false,"text":"今からは、とても想像できません。"},{"spoiler":false,"text":"商店街の人々から『値切り交渉人』と言われ、恐れられている。"},{"spoiler":false,"text":"実質、高月家の主。"},{"spoiler":false,"text":"ラス