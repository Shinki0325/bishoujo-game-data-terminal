te":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Harunobu’s older sister. Highly intelligent, sociable and attractive, Kanami has found little time for a serious relationship. She is committed to employment, often working long unrewarding hours into the night, to ensure her brother has a roof to sleep under and food to eat. Kanami can be overprotective of Harunobu at times, but thoroughly places his wellbeing before her own."},{"spoiler":false,"text":"From Nargrakhan's review."}],"source":"vndb","sourceCharacterId":"c697"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47782e58722e1a53a79ae1cf7541a84df4c5da91435da281e10b97126d15ff31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13f1dbb65836ecb97287d8e46ab76c84ca8871528b7026f68c5b8c10c0da7122.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古天条 花寿乃","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:38331","source":"vndb"}]},{"characterId":"char_vndb_c698","characterName":"小篠 梢恵","sourceIds":{"vndbCharacterId":"c698"},"originalCharacterName":"小篠 梢恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Working part-time as an amusement attendant, Kozue trudged through high school with poor academic performance. Unable to pass college entrance exams, her life has generally spiraled into an idle dead stop. Kozue often dreams about finding a sugar daddy to take care of her, and is quite the genius at gourmet cooking thanks to her mother’s culinary experience."},{"spoiler":false,"text":"From Nargrakhan's review."}],"source":"vndb","sourceCharacterId":"c698"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/723a1594dd94f0a520ec1e8e0f76d1907c4dc024e4cd0f80dfb45912637dbf4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a241ac66bb091f42a01a7e980071bc934895a778b8a69481edbada7a7bd83aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴音 華月","creatorId":"vndb:s931","sourcePersonId":"vndb:s931","canonicalEntityId":"vndb:s931","name":"飯野 ユウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:38332","source":"vndb"}]},{"characterId":"char_vndb_c699","characterName":"堀倉 幸乃","sourceIds":{"vndbCharacterId":"c699"},"originalCharacterName":"堀倉 幸乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yukino occupies the multimillion penthouse mansion atop the skyscraper. Though married to an incredibly wealthy technologist, she has grown disenfranchised with his repeated infidelity and rejection of her sexual advances. Spoiled by monetary riches, Yukino is the iconic example of an arrogant, domineering, and egotistical woman. Spends most of her free time purchasing designer merchandise."},{"spoiler":false,"text":"From Nargrakhan's review."}],"source":"vndb","sourceCharacterId":"c699"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e9cfd79362a301ad1fb23c7a5f7eb1627dbe0e4f7e7af6104faa95892c93d51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/2512dcab06c4bc4b379b62dada16cafd40ae542ea290700d2ddb466b646612fd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"美澄 すい","creatorId":"vndb:s2697","sourcePersonId":"vndb:s2697","canonicalEntityId":"vndb:s2697","name":"美澄すい(三角すい)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:38335","source":"vndb"}]},{"characterId":"char_vndb_c700","characterName":"高輪 あやめ","sourceIds":{"vndbCharacterId":"c700"},"originalCharacterName":"高輪 あやめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayame is an old classmate of Harunobu. Unable to cope with the trauma of her parent’s divorce and remarriages, Ayame dropped out of school to find refuge with a violent street gang. She had always been envious of the familial harmony Harunobu enjoyed, and became sadden by the tragedy they suffered."},{"spoiler":false,"text":"From Nargrakhan's review."}],"source":"vndb","sourceCharacterId":"c70