nts":[{"spoiler":false,"text":"A second-year general education student at Laikask Academy. Her nickname is Sofi."},{"spoiler":false,"text":"Her aptitude for magic never developed at a young age like it was supposed to, but recently, she's started to find it. She's very insecure about how talentless she is, and hopes to learn magic now so she can regain some of her confidence."},{"spoiler":false,"text":"She's a very shy, silent type, but if the topic is something she's interested in, she becomes quite talkative."},{"spoiler":false,"text":"Her overly large breasts are something she agonizes about often."}],"source":"vndb","sourceCharacterId":"c94599"},{"segments":[{"spoiler":false,"text":"ライカスク学園普通科の２年生。愛称はソフィー。"},{"spoiler":false,"text":"幼少期のうちに発現するはずの魔法の才能が最近になって見つかった。"},{"spoiler":false,"text":"何の取り柄もない自分にコンプレックスを抱いており、今からでも魔法を学び、自信を持ちたいと思っている。 恥ずかしがり屋で口下手だが、趣味の話になると饒舌になる。"},{"spoiler":false,"text":"自身の大きすぎる胸に悩んでいる。"}],"source":"egs","sourceCharacterId":"23228","sourceWorkId":"30375","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"23228","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"23228","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"23228","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"23228","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"23228","sourceWorkId":"30375","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/924fcb70529e453c67d8a00d8f4804aa41f8aae124d757ffe701238492e32f7a.webp",