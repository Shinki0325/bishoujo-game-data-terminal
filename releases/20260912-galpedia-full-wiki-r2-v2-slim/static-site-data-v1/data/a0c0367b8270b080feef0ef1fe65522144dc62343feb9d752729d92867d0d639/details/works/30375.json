Id":"c94600"},{"segments":[{"spoiler":false,"text":"ライカスク学園芸術科音楽コースの２年生で、ヴァイオリン奏者。愛称はカーチャ。"},{"spoiler":false,"text":"旧貴族で、音楽の名家でもあるヴェリーベル家当主の一人娘。"},{"spoiler":false,"text":"幼いころから英才教育を受けており、既にプロ以上の技術を身に付けている。"},{"spoiler":false,"text":"その名声は学園内だけでなく、国内中に響いているほど。"},{"spoiler":false,"text":"独りぼっちで、機械のようにひたすらヴァイオリンを弾いてきたこれまでの人生に疑問を抱いていたが……"}],"source":"egs","sourceCharacterId":"23229","sourceWorkId":"30375","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"23229","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"23229","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"23229","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"23229","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"23229","sourceWorkId":"30375","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21708259bac30a43ac7c50b7c36608a53d1a42dd74bed923a3246084fcb14307.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31180919b057631299af2080395b84cc62b51b33f16a521374cdbc74222c6c79.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤田 なつ","creatorId":"vndb:s362","sourcePersonId":"vndb:s362","canonicalEntityId":"vndb:s362","name":"福圓 美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86311","source":"vndb"}]},{"characterId":"char_c94601","characterName":"ルー・マオ","sourceIds":{"bangumi":[{"characterId":"89123","match":"exact-normalized-name-in-linked-work","subjectId":"323154"}],"egsCharacterIds":["23230"],"vndbCharacterId":"c94601"},"originalCharacterName":"ルー・マオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"902"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year general education student at Laikask Academy and a street performer. Both of her parents are Khitans."},{"spoiler":false,"text":"From juggling to tightrope walking, to even pantomiming, she has a vast array of skills at her disposal. She's often performing on campus, and has many fans and friends in the area."},{"spoiler":false,"text":"She has a very enthusiastic and optimistic personality. The second an idea comes to mind, she's doing it. She doesn't like complicated things, studying, or long-winded explanations."},{"spoiler":false,"text":"Additionally, she has absolutely no interest in love, fashion, and most other things that typical girls her age enjoy."}],"source":"vndb","sourceCharacterId":"c94601"},{"segments":[{"spoiler":false,"text":"ライカスク学園普通科の１年生で、大道芸人。"},{"spoiler":false,"text":"両親は共にキタン人。"},{"spoiler":false,"text":"ジャグリングや綱渡り、パントマイムなど、幅広い芸を身に付けている。"},{"spoiler":false,"text":"ライカスク公園でよく活動していて、地域にファンや顔馴染みの人も多い。"},{"spoiler":false,"text":"明るく前向きな性格で、思い立ったらすぐに行動する。"},{"spoiler":false,"text":"深く考えることや勉強、他人に言葉で説明することが苦手。"},{"spoiler":false,"text":"また、恋愛やオシャレなど、女の子らしいことには一切興味がない。"}],"source