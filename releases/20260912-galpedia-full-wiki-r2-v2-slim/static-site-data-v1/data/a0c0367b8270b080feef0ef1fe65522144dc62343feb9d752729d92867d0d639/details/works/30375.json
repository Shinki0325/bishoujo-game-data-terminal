r":false,"text":"非常に真面目な性格で努力家。いつも人一倍熱心に練習をこなしている。"},{"spoiler":false,"text":"バレエに対して一直線で、他のことへの関心が薄い。"},{"spoiler":false,"text":"極度の男性恐怖症で、克服したいと思っている。"}],"source":"egs","sourceCharacterId":"23231","sourceWorkId":"30375","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"23231","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"23231","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"169 cm","valueContext":null,"source":"egs","sourceCharacterId":"23231","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"23231","sourceWorkId":"30375","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"23231","sourceWorkId":"30375","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dac17f7571524a0ca66dd9556683451c9a10a0273943b2c94d1961b79f6f316b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98cd14f4b4806a98f71ab81c3bbb36b25554a8a1cc59a784f0b4d2129a7a8bf7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森崎 乃々華","creatorId":"vndb:s23319","sourcePersonId":"vndb:s23319","canonicalEntityId":"vndb:s23319","name":"森崎 乃々華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86319","source":"vndb"}]},{"characterId":"char_c94603","characterName":"ペチカ・モニカ","sourceIds":{"bangumi":[{"characterId":"89125","match":"exact-normalized-name-in-linked-work","subjectId":"323154"}],"egsCharacterIds":["23232"],"vndbCharacterId":"c94603"},"originalCharacterName":"ペチカ・モニカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"215"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year general education student at Laikask Academy and the president of the school's drama club."},{"spoiler":false,"text":"She has a short temper, so due to the way she acts and talks, every other member of the drama club aside from her has quit. The regret she feels because of this has affected her passion for theater, and even caused her to lose sight of her dream to one day become an actress. She idles away the days in the clubroom by herself, doing nothing."},{"spoiler":false,"text":"She stands out a lot due to her rough manner of speaking and dramatic personality, but beneath that, she's a caring person whom you can depend on."},{"spoiler":false,"text":"One of her greatest insecurities is her childish appearance, and if you touch upon it, she'll get mad."}],"source":"vndb","sourceCharacterId":"c94603"},{"segments":[{"spoiler":false,"text":"ライカスク学園普通科の３年生で、演劇部部長。"},{"spoiler":false,"text":"頭に血が上りやすい性格で、自身の言動のために、自分以外の演劇部員が全員退部をしてしまった。"},{"spoiler":false,"text":"そのことをずっと悔いており、演劇への情熱や、役者になるという夢も失っている。 何もせずに、一人で部室に入り浸り、ダラダラと毎日を過ごしている。"},{"spoiler":false,"text":"粗暴な口調や横柄な態度が目立つが、実は面倒見が良く、頼りになる一面も。"},{"spoiler":false,"text":"自身の子供のような見た目に強いコンプレックスがあり、そのことに触れると怒る。"}],"source":"egs","sourceCharacterId":"23232","sourceWorkId":"30375","spoiler":false},{"segments":[{"spoiler":fa