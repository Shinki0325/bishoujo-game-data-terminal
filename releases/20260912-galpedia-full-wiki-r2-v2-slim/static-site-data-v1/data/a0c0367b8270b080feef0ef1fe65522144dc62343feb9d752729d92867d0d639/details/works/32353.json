/wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1f554c4ac9dca88b1ebe6b5241550a23a338da7da868d2dda6640054464731a.webp","width":201,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城 元気","creatorId":"vndb:s487","sourcePersonId":"vndb:s487","canonicalEntityId":"vndb:s487","name":"高城 元気","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90605","source":"vndb"}]},{"characterId":"char_vndb_c123216","characterName":"メレニス・レヴィン","sourceIds":{"vndbCharacterId":"c123216"},"originalCharacterName":"メレニス・レヴィン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fortune teller who's become the talk of social media. He sets up shop in the up-and-coming tourist hotspot on 8th Avenue, though you have to be lucky to find him. He loves donuts from \"Mow Donuts\" on 7th Avenue and even incorporates them into his readings. His days were predictable, unfolding without any surprises. But when he meets our heroine, he's stumped by his inability to see her future. This mysterious void sets his own predestined journey into motion. Drawn to her, he joins Cupid Corp. But for every matchmaking tip she offers, he remains steadfast in his belief that destiny cannot be changed. Soon, whispers spread that he'll join the notorious ranks of the Parasite 5."}],"source":"vndb","sourceCharacterId":"c123216"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a17613ff3706aa8d7794cfb59a874dbab9db415056616ae9f966835c14d32b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e290b9e00594b5afc21cddecd903405515fff126f4dacb5