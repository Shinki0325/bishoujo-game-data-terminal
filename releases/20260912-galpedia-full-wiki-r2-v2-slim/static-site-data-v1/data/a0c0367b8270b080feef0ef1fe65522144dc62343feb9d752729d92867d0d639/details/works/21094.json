"}],"source":"egs","sourceCharacterId":"5416","sourceWorkId":"21094","spoiler":false},{"segments":[{"spoiler":false,"text":"麗花お付きのメイド兼秘書。"},{"spoiler":false,"text":"ハーフで金髪で巨乳。 非常にクールな性格。"},{"spoiler":false,"text":"年齢的には麗花の1つ上でしかないが、大人びて落ち着きのある娘。"},{"spoiler":false,"text":"麗花の私室ではメイド服姿、探偵事務所の事務室ではスーツ姿で過ごしている。"},{"spoiler":false,"text":"風間家は、代々白陽院家に仕える “元忍者”・“御庭番” といった類の家柄。"},{"spoiler":false,"text":"麗花の護衛として役に立つよう育てられたため、体術が常人なレベルではない。"},{"spoiler":false,"text":"忠実である一方、主人の考えがおかしいと思った時には冷静に注意する役目も担う。"},{"spoiler":false,"text":"創志に対しては辛辣な言葉でしか話さないが、きちんと評価はしている様子。"},{"spoiler":false,"text":"お嬢様を助けた恩返しと称して身体を差し出してくることも……。"},{"spoiler":false,"text":"「お嬢様の安全が第一だ。 貴様が囮になれ。」"}],"source":"bangumi","sourceCharacterId":"146722"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"5416","sourceWorkId":"21094","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"5416","sourceWorkId":"21094","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"5416","sourceWorkId":"21094","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"5416","sourceWorkId":"21094","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bde0b548f7e97d9ec80d4fdb4bca423ae220494be961301f5ee23102831320f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3972c990bab24f298f6361ca1fd6aa306b9321c907a9e39e99b006fd34afa835.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122872:146722:8055:1","source":"bangumi"}]},{"characterId":"char_c23433","characterName":"水瀬 優香里","sourceIds":{"bangumi":[{"characterId":"146723","match":"exact-normalized-name-in-linked-work","subjectId":"122872"}],"egsCharacterIds":["5417"],"vndbCharacterId":"c23433"},"originalCharacterName":"水瀬 優香里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"薄幸系メガネっ娘ＪＫ"},{"spoiler":false,"text":"勤労少女なＪＫ。"},{"spoiler":false,"text":"創志とはバイト先のパン屋の客と店員という関係。"},{"spoiler":false,"text":"ふとしたきっかけで仲良くなっているが友人関係レベル。"},{"spoiler":false,"text":"いつも笑顔で大人しい印象。バイトが忙しく学校での友人が少ないので気軽に話が出来る創志は貴重な存在だと思っている。"},{"spoiler":false,"text":"恋愛には縁がなかっため、創志に対する気持ちが自分では理解出来ていない。"},{"spoiler":false,"text":"優香里の出生に関わる秘密のせいで大きな事件に巻き込まれ、これが原因で創志と急接近する。"},{"spoiler":false,"text":"普段は隠そうとしているが立派な巨乳。"}],"source":"egs","sourceCharacterId":"5417","sourceWorkId":"21094","spoiler":false},{"segments":[{"spoiler":false,"text":"勤労少女なJK。 いつも笑顔でおとなしい印象の女の子。"},{"spoiler":false,"text":"普段は隠そうとしているが立派な巨乳の持ち主。"},{"spoiler":false,"text":"創志とはバイト先のパン屋の客と店員という関係。"},{"spoiler":false,"text":"ふとしたきっかけで仲良くなったが、まだ友人関係レベル。"},{"spoiler":false,"text":"仕事が忙しく友人も少ないので、気軽に話ができる創志は貴重な存在だと思っている。"},{"spoiler":false,"text":"これまで恋愛に縁がなかっため、創志に対する気持ちを自分では理解できていない。"},{"spoiler":false,"text":"出生に関わる秘密のせいで大きな事件に巻き込まれ、これが原因で創志と急接近する。"},{"spoiler":false,"text":"「創志さん、今日もいつもので良いんですか？」"}],"source":"bangumi","sourceCharacterId":"146723"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"5417","sourceWorkId":"21094",