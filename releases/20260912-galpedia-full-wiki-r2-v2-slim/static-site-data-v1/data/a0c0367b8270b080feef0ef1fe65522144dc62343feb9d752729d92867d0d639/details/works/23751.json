itedName":"門 葡蘭子","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:87784","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c12222","characterName":"成川 姫","sourceIds":{"vndbCharacterId":"c12222"},"originalCharacterName":"成川 姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1112"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hime is a cheerful girl from the protagonist’s class. She’s pretty popular and gets on well with everybody. She works part-time in the beachside restaraunt called \"Jellyfish\". Her hobbies include listening to music and playing games."},{"spoiler":false,"text":"As a child, she often played outside with boys. Consequently, Hime developed a competitive personality and due to this, everyone considers her a tomboy. Currently, she’s trying to act more ladylike. Hime is very friendly and gets along with just about anyone."},{"spoiler":false,"text":"From Liemyx's Eroge Blog & From Amaenbou Dane~"}],"source":"vndb","sourceCharacterId":"c12222"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08877c1dceb87d735c631184661fb0feaeb6c1bfa044a3feeadb7f876b12fa96.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/691b988e76ab5525d6551b38e23a7fd170686bddf3518dc21674a24ef7e58385.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46600","source":"vndb"}]},{"characterId":"char_vndb_c12590","characterName":"韮崎 日向","sourceIds":{"vndbCharacterId":"c12590"},"originalCharacterName":"韮崎 日向","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"123"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hinata lives with her father in the same apartment block as the protagonist and is his kouhai. She’s an energetic girl and loves running, in fact, she’s the star of the track club at school. She’s a pretty good cook too since she normally has to cook for herself since her father works long hours."},{"spoiler":false,"text":"As her looks suggest, she isn’t very good at studying. She is very energetic and friendly, but is shy around strangers. Since her mother died when she was young, she learned how to do housework to lessen the burden on her father. She is very reserved and rarely acts selfishly."},{"spoiler":false,"text":"From Liemyx's Eroge Blog & From Amaenbou Dane~"}],"source":"vndb","sourceCharacterId":"c12590"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e06415d46cbc04ad71308fc222b2eab0b4eacda5d3480ede6d8ba89b3e6c9d78.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ead7c37ce2f7b8b78f54ad7bcd924645314da613bb4f7ed228d7ebbb2b64d96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠野 そよぎ","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46602","source":"vndb"}]},{"characterId":"char_vndb_c12591","characterName":"吉野谷 星音","sourceIds":{"vndbCharacterId":"c12591"},"originalCharacterName":"吉野谷 星音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"610"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seine is a very quiet girl who's in her second year of high school. She loves pets and can usually be found with the cat that seems to live at the school. She also loves drama but is unable to show any emotions so normally practices by herself."},{"spoiler":false,"text":"Consequently, people struggle in interacting with her and end up avoiding her. She is interested in theatre, but doesn’t know where to start since she’s bad around people. As a result, she continues to practice alone on a regular basis. Seine also loves food, animals, and otaku subculture."},{"spoiler":false,"text":"From Liemyx's Eroge Blog & From Amaenbou Dane~"}],"source":"vndb","sourceCharacterId":"c12591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dc067971d97e64d18e5d7cb351cdf8b6ab71caf193776e1a44e62e1ab950353.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e01af8c8ec8d1d51670002da88452eb60793987e4edc179c4e7f07a6d3104151.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"門 葡蘭子","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46605","source":"vndb"}]},{"characterId":"char_vndb_c12592","characterName":"出水 和琴","sourceIds":{"vndbCharacterId":"c12592"},"originalCharacterName":"出水 和琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"904"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Izumi is a 3rd-year student at high school and a calm and intelligent beauty. She is extremely popular since she’s always willing to lend a hand to anyone who needs help. Her hobbies include reading and listening to classical music."},{"spoiler":false,"text":"Wakoto is a senpai that everyone admires and is often surrounded by people asking for her help or advice. Due to her popularity, she receives many confessions from boys… and rejects every one of them. As a result, students call 