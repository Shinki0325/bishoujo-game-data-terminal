:"27600","match":"exact-normalized-name-in-linked-work","subjectId":"1122"}],"egsCharacterIds":["5886"],"vndbCharacterId":"c26649"},"originalCharacterName":"天沢 郁未","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"17"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"113"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main protagonist of the story, Amasawa Ikumi joined FARGO in the hope of finding out clues about her mother's death, who was a member of the organization. A young girl with a strong will, she became friends with Haruka and Yui at Day 1 and helped them achieve their goals while reaching her own. She was assigned to Class A along with Youko and shares her room with the Shounen."},{"spoiler":true,"text":"It was revealed during the Elpod scenes that she was a perverted woman who constantly seeks comfort from the opposite sex, which stemmed from periods of loneliness she suffered during the time her mother was gone."},{"spoiler":false,"text":"Ultimately, she blames FARGO for the death of her mother and embarked on a bloody quest for revenge with the Shounen."}],"source":"vndb","sourceCharacterId":"c26649"},{"segments":[{"spoiler":false,"text":"物語の主人公。"},{"spoiler":false,"text":"母の死の理由を知るべく宗団の隔離施設に単身乗り込む。"},{"spoiler":false,"text":"しかし真実を求める日々は、同時に過去の痛みと凄惨な現実に直面し続ける、試練の旅でもあった。"},{"spoiler":false,"text":"その試練の先には何が待っているのか……。"}],"source":"egs","sourceCharacterId":"5886","sourceWorkId":"21520","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。为了给离奇死亡的母亲复仇潜入了母亲曾经生活过的FARGO的隔离设施。A栋，编号为A-12。性格认真、强势。运动神经拔群，是田径部的王牌。小学的时候父亲死亡，母亲失踪后维持生计方式不明。"}],"source":"bangumi","sourceCharacterId":"27600"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ebc738df146ed7442afdd5a16ccc27b8c60873d795d2dd8dce6b345a3300f9f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbe0378e263c26440f2f30b92ccb9b2463a09e58ddea6e444b04594bbee2fb1c.webp","width":189,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笹島かほる","creatorId":"vndb:s1017","sourcePersonId":"vndb:s1017","canonicalEntityId":"vndb:s1017","name":"神無月ほのか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1122:27600:3944:1","source":"bangumi"}]},{"characterId":"char_c26650","characterName":"名倉 由依","sourceIds":{"bangumi":[{"characterId":"27811","match":"exact-normalized-name-in-linked-work","subjectId":"1122"}],"egsCharacterIds":["5888"],"vndbCharacterId":"c26650"},"originalCharacterName":"名倉 由依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The noisy girl with the cellphone at Day 1, Nakura Yui was befriended by Haruka and Ikumi after they got off the truck at the facility. A cheerful girl with a warm smile, she joined FARGO to search for her older sister who also joined a few months ago. She was assigned at Class B."},{"spoiler":true,"text":"During her training at the Minmes, it was revealed that she had a traumatic experience that resulted in the separation of her family."},{"spoiler":false,"text":"Despite the hardships she endured at FARGO, she was still able to maintain her cheerful nature."}],"source":"vndb","sourceCharacterId":"c26650"},{"segments":[{"spoiler":false,"text":"FARGOの隔離施設に向かうトラックの中で知り合う少女。"},{"spoiler":false,"text":"脳天気だけれども、いつも前向きに頑張る女の子。"},{"spoiler":false,"text":"FARGO集団に入ったきり戻らない姉を連れ戻すために、郁未と行動を共にする。"},{"spoiler":false,"text":"無邪気な笑顔からは想像がつかないほどの壮絶な過去を秘めている。"}],"source":"egs","sourceCharacterId":"5888","sourceWorkId":"21520","spoiler":false},{"segments":[{"spoiler":false,"text":"为了寻找离家出走的姐姐和而主人公共同行动。性格乐观，却有着悲惨的过去。但是她自己对过去痛苦的事情没有记忆。B栋，编号为B-73。"},{"spoiler":false,"text":"随着和郁未接触的深入变得越来越能够直面苦难，精神上获得了成长。"}],"source":"bangumi","sourceCharacterId":"27811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cd6bff143b7e070fcbf1095178462a95fba682f03c7747ec629bf882878035b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86f4137beed0fdcd4194c5f66ffb01e9552314b3e3ab943a644b536eb988d907.webp","width":151,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1122:27811:5890:1","source":"bangumi"}]},{"characterId":"char_c26778","characterName":"名倉 友里","sourceIds":{"bangumi":[{"characterId":"151134","match":"exact-normalized-name-in-linked-work","subjectId":"1122"}],"egsCharacterIds":["5890"],"vndbCharacterId":"c26778"},"originalCharacterName":"名倉 友里","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yui's older sister, Nakura Yuri joined FARGO a few months ago prior to the story due to traumatic experiences. She shows cold behavior towards her younger sister to the point of denying her existence."},{"spoiler":true,"text":"It was revealed that she was seeking the power offered by the organization to reunite her family but realized too late that it was useless for that."},{"spoiler":false,"text":"Ultimately she died when the power she held in went out of control."}],"source":"vndb","sourceCharacterId":"c26778"},{"segments":[{"spoiler":false,"text":"FARGOの信者の一人。由依の実姉。ランクは『Class　C』。"},{"spoiler":false,"text":"数年前に、妹を置いて宗団に入信。"},{"spoiler":false,"text":"『不可視の力』を欲しているが、その理由は不明。"}],"source":"egs","sourceCharacterId":"5890","sourceWorkId":"21520","spoiler":false},{"segments":[{"spoiler":false,"text":"FARGOの信者の一人。由依の実姉。ランクは『Class　C』。"},{"spoiler":false,"text":"数年前に、妹を置いて宗団に入信。"},{"spoiler":false,"text":"『不可視の力』を欲しているが、その理由は不明。"}],"source":"bangumi","sourceCharacterId":"151134"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/019523985e1cbcf179d0428b146c4592ac2d0050bc8325e0dcf99aa657dfb451.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0dc8f0fb935e2ad65fd7427c3c0397269fe59e1c0969113cf6448114dd111bb1.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1122:151134:6045:1","source":"bangumi"}]},{"characterId":"char_c26787","characterName":"巳間 晴香","sourceIds":{"bangumi":[{"characterId":"27612","match":"exact-normalized-name-in-linked-work","subjectId":"1122"}],"egsCharacterIds":["5887"],"vndbCharacterId":"c26787"},"originalCharacterName":"巳間 晴香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first person Ikumi talked to on the way to the FARGO facility, Mima Haruka later revealed to Ikumi that her goal in joining FARGO was to seek her brother who is working there. A cool girl with an attitude, she was assigned to Class C"},{"spoiler":true,"text":"due to her lack of traumatic experiences and as a result, she suffered through deplorable conditions but managed to preserve her sanity until at a later point"},{"spoiler":false,"text":". She often picks on Yui and says funny comments about her, usually about her breasts' small size."}],"source":"vndb","sourceCharacterId":"c26787"},{"segments":[{"spoiler":false,"text":"FARGOの隔離施設に向かうトラックの中で知り合う少女。"},{"spoiler":false,"text":"行動力があって冷静な物事の考え方をするしっかり者。"},{"spoiler":false,"text":"考え方にガサツなところは多々認められるが、芯の通ったものの言い方をする。"},{"spoiler":false,"text":"FARGOの一員として働く義兄を連れ戻しに乗り込んだ。"}],"source":"egs","sourceCharacterId":"5887","sourceWorkId":"21520","spoiler":false},{"segments":[{"spoiler":false,"text":"为了劝说在FARGO工作的哥哥回家潜入了设施。和主人公相遇并共同行动。C栋，编号为C-219。"}],"source":"bangumi","sourceCharacterId":"27612"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9061578b170610b5a2dcf580138e81ce662af2b50ca7bb6e5b07abe96ba78396.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86124faa6cc3150ff332b251131132859f604107e4ecd53f3a2ea0e720404c99.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茂呂田かおる","creatorId":"vndb:s662","sourcePersonId":"vndb:s662","canonicalEntityId":"vndb:s662","name":"茂呂田 かおる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1122:27612:4073:1","source":"bangumi"}]},{"characterId":"char_c26842","characterName":"鹿沼 葉子","sourceIds":{"bangumi":[{"characterId":"27823","match":"exact-normalized-name-in-linked-work","subjectId":"1122"}],"egsCharacterIds":["5889"],"vndbCharacterId":"c26842"},"originalCharacterName":"鹿沼 葉子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"22"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only other person in training at Class A, Kanuma Youko was already at the FARGO facility a long time ago before the start of the story. A quiet girl and a strong believer in FARGO's cause, her ascetic behavior inspired both pity and awe from Ikumi. When not training, she spends her time meditating and isolates herself to the point of being ignorant about the outside world; the console game Ikumi gave her is evidence of that."},{"spoiler":true,"text":"She revealed that she was Class C once; an event involving her mother got her promoted to Class A."}],"source":"vndb","sourceCharacterId":"c26842"},{"segments":[{"spoiler":false,"text":"『Class　A』に所属している、敬虔なFARGO教信者。"},{"spoiler":false,"text":"施設へ郁未が来るまで、たった一人の『Class　A』であった。"},{"spoiler":false,"text":"長い間施設にいるので、世間とのギャップが多々ある。"}],"source":"egs","sourceCharacterId":"5889","sourceWorkId":"21520","spoiler":false},{"segments":[{"spoiler":false,"text":"虔诚的FARGO信徒。内心深处有关于自己母亲的阴暗的回忆。和企图探寻FARGO的秘密的主人公对立。小时候就和母亲一起进入了FARGO。当时是在C栋，编号是C-112。后来因为和母亲之间发生的事情，被移居到了A栋。编号为A-9。"}],"source":"bangumi","sourceCharacterId":"27823"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cf8b44ab18bf89fba2173a04288e3a95faf9bf14a0895066f687bf16c0193b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/393e089b8e8c9a427febb651011c6c2bef43506e5a7bde9688ee2fbfff4be9b5.webp","width":206,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1122:27823:15954:1","source":"bangumi"}]},{"characterId":"char_vndb_c126659","