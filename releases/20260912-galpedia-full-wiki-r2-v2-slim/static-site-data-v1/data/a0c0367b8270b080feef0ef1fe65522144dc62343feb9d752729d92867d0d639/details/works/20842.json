ts":[{"spoiler":false,"text":"後輩の女の子で、温泉街の甘味処 『こはるびより』 の看板娘。"},{"spoiler":false,"text":"人懐っこく、いつでも元気で誰とでもすぐ打ち解ける。"},{"spoiler":false,"text":"感情が豊かで、嬉しいことや悲しいことは全身で表現する。 嬉しさから相手に抱きついたりすることもしばしば。"},{"spoiler":false,"text":"（ただし信じきっている相手に対してだけで、同年代は主人公のみ）"},{"spoiler":false,"text":"考えるのが苦手なタイプだが、基本的にセンスはかなり良く、和菓子作りの腕は一級品。"},{"spoiler":false,"text":"本人はまだ恋をよく分かっていない女の子で、誰かの恋愛話を聞くのは好きだが、自分に起こるとは考えていない。"},{"spoiler":false,"text":"おっぱいが大きいことを自覚しており、それで困った経験ばかりなので、大きな胸については否定的。"},{"spoiler":false,"text":"「えへへ……やったぁ！　ね、ね？　見てくれました？」"}],"source":"bangumi","sourceCharacterId":"28652"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"28652","value":"1年A組"},{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"5219","sourceWorkId":"20842","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"5219","sourceWorkId":"20842","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"5219","sourceWorkId":"20842","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"5219","sourceWorkId":"20842","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"5219","sourceWorkId":"20842","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/661bf22c8ea05e24c1643c7a96f0854064db649aa4e6339592cf6ed2c9a02831.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/349440501dcc57936496b5eb92e3620b58b6310beec03c7ee9ac972858b0b4dd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114735:28652:11646:1","source":"bangumi"}]},{"characterId":"char_c35681","characterName":"図書館の座敷童","sourceIds":{"bangumi":[{"characterId":"36662","match":"exact-normalized-name-in-linked-work","subjectId":"137782"},{"characterId":"36662","match":"exact-normalized-name-in-linked-work","subjectId":"221745"}],"egsCharacterIds":["7296"],"vndbCharacterId":"c35681"},"originalCharacterName":"図書館の座敷童","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"209"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 2-A"},{"spoiler":false,"text":"The protagonist's classmate who is called \"the library's zashiki-warashi\". She is very shy and whenever she's in a hurry, she writes her thoughts into a notebook instead of talking. Loves both knowledge and books, and has a habit of having delusions. Yuzuka usually doesn't speak because she is almost always holed up in the library and wants to follow its rules, however, in reality, she'd like to have somebody to have leisure chats with. She is the younger daughter to the town's famous Takayashiki Temple, where she works as a shrine maiden."},{"spoiler":false,"text":"In Amakano ~Second Season~+:"},{"spoiler":false,"text":"Bust-Waist-Hips: 94-57-89cm"}],"source":"vndb","sourceCharacterId":"c35681"},{"segments":[{"spoiler":false,"text":"「図書館の座敷童」と呼ばれる図書委員の同級生。物静かで引っ込み思案。"},{"spoiler":false,"text":"恥ずかしがり屋のはにかみ屋で赤面症。焦るとカミカミになるため、焦った時は持っているノートで会話することもある。"},{"spoiler":false,"text":"無口だが、本当は感情豊かで、考えすぎて言いたいことを言えなくなっている。"},{"spoiler":false,"text":"さらに涙もろく、感情が高ぶるとすぐ泣いてしまう性格もあり、普段は図書室にこもって、人とはあまり接しないようにしている。"},{"spoiler":false,"text":"だが心の奥底では、のんびりおしゃべりしたいと思っている。"},{"spoiler":false,"text":"本が大好きで知識も多いためか、妄想が突っ走る一面もある。"},{"spoiler":false,"text":"家は、街で有名な高社神社であり、一つ上の姉がいる。"}],"source":"egs","sourceCharacterId":"7296","sourceWorkId":"22177","spoiler":false},{"segments":[{"spoiler":false,"text":"卒業後、あなたと結婚。司書の資格をとるために大学に進学。"},{"spoiler":false,"text":"二人で白鷺市内にアパートを借りて暮らしている。"},{"spoiler":false,"text":"相変わらずの本好きだが、だんなさまと一緒にする新体験はいつでもワクワクしている。"},{"spoiler":false,"text":"学生なのに新妻ということが嬉しい様子。妻としての自覚をもっているものの、少し突っ走るいつもの可愛らしさも健在。"}],"source":"egs","sourceCharacterId":"7296","sourceWorkId":"23565","spoiler":false},{"segments":[{"spoiler":false,"text":"“図書館の座敷童” と呼ばれている図書委員の同級生。"},{"spoiler":false,"text":"物静かで引っ込み思案。 恥ずかしがり屋で、焦るとカミカミになるためノートで会話することも。"},{"spoiler":false,"text":"本が大好きで知識も多いため、妄想が突っ走る一面もある。"},{"spoiler":false,"text":"普段は図書室にこもって人とあまり接しないようにしているが、"},{"spoiler":false,"text":"本当は誰かとのんびりおしゃべりしたいと思っている。"},{"spoiler":false,"text":"家は町で有名な 高社神社 で、一つ上の姉がいる。"},{"spoiler":false,"text":"「図書館では静かにして…… うぅっ、ばかぁ……」"}],"source":"bangumi","sourceCharacterId":"36662"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e6d6a9d11c82f0aa255b1a3cd08e6e193fc773acadafde885c2c411134117b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b2db1f66616393cda5ce95f714dc18f17f0ad82b37213d192886de15ae916f8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155348","characterName":"高社 浩司","sourceIds":{"vndbCharacterId":"c155348"},"originalCharacterName":"高社 浩司","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":