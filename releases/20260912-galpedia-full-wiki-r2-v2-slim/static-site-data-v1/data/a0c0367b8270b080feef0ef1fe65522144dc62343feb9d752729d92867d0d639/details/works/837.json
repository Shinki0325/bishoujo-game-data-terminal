e},{"segments":[{"spoiler":false,"text":"主人公のいとこのお姉さん。昔は街でも有名なガキ大将だったが、今ではすっかり女性らしい物腰になり、そんな雰囲気は微塵も感じさせない。この街に来て右も左もわからない主人公をやさしく見守ってくれる。舞うように剣を振るう凄腕の剣士で、傭兵隊長としての地位・人望もすでに確立している。"}],"source":"bangumi","sourceCharacterId":"151027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c47655af300b99aef49f6471966e78c5f15f71efcebcd6911a6e0fbc8e6cd314.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7686cb338d98539d7a7a8b29d75407be630d506cbf9074cb4ae661d6affbb994.webp","width":81,"height":180,"source":"static-detail"},"actors":[]},{"characterId":"char_c67620","characterName":"いさな","sourceIds":{"bangumi":[{"characterId":"151028","match":"exact-normalized-name-in-linked-work","subjectId":"325668"}],"egsCharacterIds":["27932"],"vndbCharacterId":"c67620"},"originalCharacterName":"いさな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人を探して旅をしている異国の少女。"},{"spoiler":false,"text":"慣れない異国の地に戸惑い、主人公に助けられることもしばしばである。"},{"spoiler":false,"text":"ただ、異国においても工夫により自国での衣食住を実現させてしまう生活能力には驚くべきものがある。"},{"spoiler":false,"text":"弓の腕はかなり立つのだが、性格はおとなしく控えめ。"}],"source":"egs","sourceCharacterId":"27932","sourceWorkId":"837","spoiler":false},{"segments":[{"spoiler":false,"text":"人を探して旅をしている異国の少女。慣れない異国の地に戸惑い、主人公に助けられることもしばしばである。ただ、異国においても工夫により自国での衣食住を実現させてしまう生活能力には驚くべきものがある。弓の腕はかなり立つのだが、性格はおとなしく控えめ。"}],"source":"bangumi","sourceCharacterId":"151028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59ec9508c4c349d8f525672fccd0b885f4d757c2c6140722ebff9b0d36467533.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8c11c86fd73314cd9e945a9768e20cb11e571b6d2bb705f8ec915a0b8860515.webp","width":125,"height":170,"source":"static-detail"},"actors":[{"creditedName":"森山葵","creatorId":"vndb:s2926","sourcePersonId":"vndb:s2926","canonicalEntityId":"vndb:s2926","name":"森山 葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:325668:151028:22079:1","source":"bangumi"}]},{"characterId":"char_c67621","characterName":"アンリエッタ","sourceIds":{"bangumi":[{"characterId":"151029","match":"exact-normalized-name-in-linked-work","subjectId":"325668"}],"egsCharacterIds":["27931"],"vndbCharacterId":"c67621"},"originalCharacterName":"アンリエッタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"失われた魔法の研究をしている少女。"},{"spoiler":false,"text":"街から少し離れた屋敷に使い魔のメイドと二人で暮らしており、"},{"spoiler":false,"text":"街の魔法屋によく遊びに来ている。"},{"spoiler":false,"text":"気が強く真面目、というよりは生意気で頭でっかちなお子様。"},{"spoiler":false,"text":"だが、猫をかぶっているので、その本性を知る人はそれほど多くはない。"},{"spoiler":false,"text":"自分が少し子供っぽいことを気にしているためか、魔法屋のヴァレリアに憧れている"}],"source":"egs","sourceCharacterId":"27931","sourceWorkId":"837","spoiler":false},{"segments":[{"spoiler":false,"text":"失われた魔法の研究をしている少女。街から少し離れた屋敷に使い魔のメイドと二人で暮らしており、街の魔法屋によく遊びに来ている。気が強く真面目、というよりは生意気で頭でっかちなお子様。だが、猫をかぶっているので、その本性を知る人はそれほど多くはない。自分が少し子供っぽいことを気にしているためか、魔法屋のヴァレリアに憧れている。"}],"source":"bangumi","sourceCharacterId":"151029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9426e458a3d7fbe48584ec64f8cabe8423a3e125a6824ca5c9401756d507b23.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3c5f98d814309a961bb2bd648a15f3f206465f0a7e064f68627c4602e37792a.webp","width":154,"height":170,"source":"static-detail"},"actors":[{"creditedName":"武島あや","creatorId":"vndb:s5765","sourcePersonId":"vndb:s5765","canonicalEntityId":"vndb:s5765","name":"武島 あや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:325668:151029:18187:1","source":"bangumi"}]},{"characterId":"char_c67622","characterName":"チェヌカ","sourceIds":{"bangumi":[{"characterId":"151032","match":"exact-normalized-name-in-linked-work","subjectId":"325668"}],"egsCharacterIds":["27934"],"vndbCharacterId":"c67622"},"originalCharacterName":"チェヌカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"森コボルトの族長の娘。"},{"spoiler":false,"text":"ニンゲンに興味を持っている。"},{"spoiler":false,"text":"人間とは少し物事に対する感覚が違うがゆえに、主人公が振り回されることも多い。"},{"spoiler":false,"text":"「明るく元気」といえば聞こえはいいが、むしろ「何を考えているのかよくわからない」というのが正しい。"}],"source":"egs","sourceCharacterId":"27934","sourceWorkId":"837","spoiler":false},{"segments":[{"spoiler":false,"text":"森のコボルドの族長の娘。ニンゲンに興味を持っている。我々人間とは少し物事に対する感覚が違うがゆえに、主人公が振り回されることも多い。「明るく元気」といえば聞こえはいいが、むしろ「何を考えているのかよくわからない」というのが正しい。"}],"source":"bangumi","sourceCharacterId":"151032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02d76a100c367686cda43a0bd188aa2009887252d6fafa14690660224f30842c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51ded09527a62221589bb9691e900cab5a96e167dbcc5d3f496441d3563ea6c3.webp","width":118,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_c67623","characterName":"ヴィヴィ","sourceIds":{"bangumi":[{"characterId":"151031","match":"exact-normalized-name-in-linked-work","subjectId":"325668"}],"egsCharacterIds":["27933"],"vndbCharacterId":"c67623"},"originalCharacterName":"ヴィヴィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アンリエッタに仕えている魔族のメイド。"},{"spoiler":false,"text":"魔族はニンゲンよりも一段高い種族であると自負してはいるのだが、お気楽でどこかヌケているため、あまりそうは感じさせない。"},{"spoiler":false,"text":"主人であるアンリエッタから命じられた用事をさぼるのみならず、いつも彼女をからかって楽しんでいる。"}],"source":"egs","sourceCharacterId":"27933","sourceWorkId":"837","spoiler":false},{"segments":[{"spoiler":false,"text":"アンリエッタに仕えている魔族のメイド。サバサバしたボーイッシュな性格。魔族はニンゲンよりも一段高い種族であると自負してはいるのだが、お気楽でどこかヌケているため、あまりそうは感じさせない。主人であるアンリエッタから命じられた用事をさぼるのみならず、いつも彼女をからかって楽しんでいる。"}],"source":"bangumi","sourceCharacterId":"151031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6aa24e45baad54596741a6ee7ef7070bef83fa9e7b2fe878b59fd8fcfdbdaad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95b6805780e0f131099b3f092ede00ab07ad03002ca50a24936b38104003289d.webp","width":126,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_c67624","characterName":"ルカ","sourceIds":{"bangumi":[{"characterId":"151033","match":"exact-normalized-name-in-linked-work","subjectId":"325668"}],"egsCharacterIds":["27936"],"vndbCharacterId":"c67624"},"originalCharacterName":"ルカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界中を旅しているエルフの吟遊詩人。"},{"spoiler":false,"text":"路銀が尽きたので、今は街に逗留してせっせと稼ぐことに専念している。"},{"spoiler":false,"text":"表向きはへらへら笑って愛想がいいのだが、実際のところはしたたかで醒めている。"},{"spoiler":false,"text":"商人のほうが吟遊詩人よりもよほど向いているとよく言われるが、本人は職を変える気はない。"},{"spoiler":false,"text":"いさなとは単なる旅仲間だが、お互いに自分に欠けているものを感じるためか妙に馬が合っている。"}],"source":"egs","sourceCharacterId":"27936","sourceWorkId":"837","spoiler":false},{"segments":[{"spoiler":false,"text":"世界中を旅しているエルフの吟遊詩人。路銀が尽きたので、今は街に逗留してせっせと稼ぐことに専念している。表向きはへらへら笑って愛想がいいのだが、実際のところはしたたかで醒めている。商人のほうが吟遊詩人よりもよほど向いているとよく言われるが、本人は職を変える気はない。いさなとは単なる旅仲間だが、お互いに自分に欠けているものを感じるためか妙に馬が合っている。"}],"source":"bangumi","sourceCharacterId":"151033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f8f66603df15a05cb12cca124671a3b646c3e885495cf043a2f3cc83c438640.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3392c92438d36345bd8f5653eb1d7685d664bde1fa5436737848ed3ef71a2cb.webp","width":118,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_c67625","characterName":"ヴァレリア","sourceIds":{"bangumi":[{"characterId":"151034","match":"exact-normalized-name-in-linked-work","subjectId":"325668"}],"egsCharacterIds":["27935"],"vndbCharacterId":"c67625"},"originalCharacterName":"ヴァレリア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"何があっても笑みを絶やさないオトナなひと。"},{"spoiler":false,"text":"異国の魔術などにも通じていて、その技術を生かして街で魔法屋を経営している。"},{"spoiler":false,"text":"特に恋占いはあたると評判で、女性の恋の悩みの良き相談相手となっている。"}],"source":"egs","sourceCharacterId":"27935","sourceWorkId":"837","spoiler":false},{"segments":[{"spoiler":false,"text":"何があっても笑みを絶やさないオトナなひと。異国の魔術などにも通じていて、その技術を生かして街で魔法屋を経営している。特に恋占いはあたると評判で、女性の恋の悩みの良き相談相手となっている。聡明かつ社交的であるため、男女ともに彼女に憧れている人は多い。"}],"source":"bangumi","sourceCharacterId":"151034"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/271712ff9458046bbb4a501838f77c78c5a3aa747b267ec79107f4ea8a1a9c32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/295c8776473cca57f3a9641602734dcc746f083a9fd837699df4268f8d0772bc.webp","width":139,"height":170,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:214","sourceCompanyId":"egs:brand:214","canonicalEntityId":"egs:brand:214","name":"にくきゅう","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:837:214","source":"egs"},{"companyId":"vndb:p1472","sourceCompanyId":"vndb:p1472","canonicalEntityId":"vndb:p1472","name":"にくきゅう","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10384:v4612","source":"vndb"},{"companyId":"vndb:p1472","sourceCompanyId":"vndb:p1472","canonicalEntityId":"vndb:p1472","name":"にくきゅう","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:39219:v4612","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
