ct","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"八重垣神社の巫女で人間。"},{"spoiler":false,"text":"主人公とは幼馴染であり、気心の知れた関係。"},{"spoiler":false,"text":"同い年であるが何故か主人公のことを弟扱いし、やたらと世話を焼きたがる。"},{"spoiler":false,"text":"他の人とは違い、昔から神様が見えていて、本人曰く、色々とトラブルに巻き込まれていたとのこと。"},{"spoiler":false,"text":"その影響であまり神様のことは快く思っておらず、神様教育法に関しても面倒なことになった……。というのが正直な感想。"}],"source":"egs","sourceCharacterId":"17637","sourceWorkId":"13906","spoiler":false},{"segments":[{"spoiler":false,"text":"人間。八重垣神社の巫女。"},{"spoiler":false,"text":"主人公とは幼なじみであり、気心の知れた関係。"},{"spoiler":false,"text":"同い年であるが、なぜか主人公のことを弟扱いし、やたらと世話を焼きたがる。"},{"spoiler":false,"text":"他の人とは違い昔から神様が見えていて、本人曰く、色々とトラブルに巻き込まれていたとのこと。"},{"spoiler":false,"text":"その影響であまり神様のことは快く思っておらず、カミサマ教育法に関しても 「面倒なことになった……」 というのが正直な感想。"},{"spoiler":false,"text":"ただ、基本的に人間・神様問わず困っている姿は放っておけず、文句を言いつつも主人公たちを助けてしまう。"},{"spoiler":false,"text":"「まったくもう……世話が焼けるんだから、この弟は」"}],"source":"bangumi","sourceCharacterId":"34021"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"17637","sourceWorkId":"13906","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"17637","sourceWorkId":"13906","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"17637","sourceWorkId":"13906","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"17637","sourceWorkId":"13906","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"17637","sourceWorkId":"13906","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1df035d66b604743a0561f9a5c3c6f05d5b4f9ab57525d8d49aab0a401643a24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6ad55db673108bff15778acd92591d03d1a3b28b8a5f5b09822ad93e8f793a3d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島沙樹","creatorId":"vndb:s44","sourcePersonId":"vndb:s44","canonicalEntityId":"vndb:s44","name":"中島 沙樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13214:34021:4500:1","source":"bangumi"}]},{"characterId":"char_c27633","characterName":"稲荷 大神","sourceIds":{"bangumi":[{"characterId":"34022","match":"exact-normalized-name-in-linked-work","subjectId":"13214"}],"egsCharacterIds":["17638"],"vndbCharacterId":"c27633"},"originalCharacterName":"稲荷 大神","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"豊穣のカミサマ(見習い)。"},{"spoiler":false,"text":"トレードマークは稲穂のような金髪と狐耳＆尻尾。"},{"spoiler":false,"text":"自身の夢を成就させるため、神早坂学園にやってくる。"},{"spoiler":false,"text":"なりゆきで園芸部に入部することになり、田んぼの守護神としてそのまま部室に住み着くことに。"},{"spoiler":false,"text":"陽気で気さく、情に厚くて面倒見く頼りにされることも多い。"},{"spoiler":false,"text":"……が、私生活はだらしないなど、ズボラな一面も。"},{"spoiler":false,"text":"豊穣の神は性的に放縦なタイプが多く、本人も奔放かつ享楽的なカミサマになろうと張り切っている。"},{"spoiler":false,"text":"が、実は超がつくほどのウブ。"}],"source":"egs","sourceCharacterId":"17638","sourceWorkId":"13906","spoiler":false},{"segments":[{"spoiler":false,"text":"トレードマークは稲穂のような金髪と狐耳＆尻尾のカミサマ。"},{"spoiler":false,"text":"自身の夢を成就させるため、神早坂学園にやってきたが、なりゆきで園芸部に入部することになり、田んぼの守護神としてそのまま部室に住み着くことに。"},{"spoiler":false,"text":"陽気で気さく、情に厚くて面倒見も良い神様。"},{"spoiler":false,"text":"……が、私生活はだらしないなど、ズボラな一面も。"},{"spoiler":false,"text":"豊穣の神は性的に放縦なタイプが多く、本人ももっと奔放かつ享楽的な神様になろうと張り切っている。"},{"spoiler":false,"text":"が、実は超がつくほどのウブ。"},{"spoiler":false,"text":"「高天原のせ……せせっ、セックスシンボルこと、イナリお姉さん、よー……（尻すぼみ）」"}],"source":"bangumi","sourceCharacterId":"34022"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"17638","sourceWorkId":"13906","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"17638","sourceWorkId":"13906","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"17638","sourceWorkId":"13906","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"17638","sourceWorkId":"13906","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"17638","sourceWorkId":"13906","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f71a7ad4abe50ac51c9117fae76115370358bd65a1bac7e2f449894f68dfa4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bece9e8a317d59ecb72b44b8bce993e64fd4969f4f969a2d58c417945644c79.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13214:34022:4727:1","source":"bangumi"}]},{"characterId":"char_c27634","characterName":"富士宮 サクヤ","sourceIds":{"bangumi":[{"characterId":"34023","match":"exact-normalized-name-in-linked-work","subjectId":"13214"}],"egsCharacterIds":["17639"],"vndbCharacterId"