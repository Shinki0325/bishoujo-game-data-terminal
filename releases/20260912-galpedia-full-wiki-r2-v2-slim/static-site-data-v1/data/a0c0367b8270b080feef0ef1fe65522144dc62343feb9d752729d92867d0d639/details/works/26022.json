ar high school student."},{"spoiler":false,"text":"Star Sign: Aries"},{"spoiler":false,"text":"The most popular student on campus."},{"spoiler":false,"text":"A classmate of Lapis and Mitsuki, the son of a rich family."},{"spoiler":false,"text":"An amateur model who is slightly famous around town."},{"spoiler":false,"text":"He's a little smug, but because he's friendly and bright he's popular with both men and women."},{"spoiler":false,"text":"He's Mitsuki's only friend."}],"source":"vndb","sourceCharacterId":"c64412"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0dc03dbe3db4b8aff97a9cf24098d70f1dff550a7a28ce579ad582862162ce83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f55e2bbf658a73c51ccc6c8de7b6f8e33a7afcd54705501d0cc6f096fa46e3d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶 裕貴","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75659","source":"vndb"}]},{"characterId":"char_vndb_c64413","characterName":"壬生 惣太郎","sourceIds":{"vndbCharacterId":"c64413"},"originalCharacterName":"壬生 惣太郎","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1119"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I... Like it here. Looking at the sea at night makes my mind go blank.\""},{"spoiler":false,"text":"Star Sign: Scorpio"},{"spoiler":fal