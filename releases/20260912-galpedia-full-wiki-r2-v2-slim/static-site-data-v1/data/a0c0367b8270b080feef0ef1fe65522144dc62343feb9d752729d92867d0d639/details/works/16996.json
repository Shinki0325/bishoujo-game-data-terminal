{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"16996","model":{"presentationWorkId":"vndb:v10462","staff":{"artwork":[{"creditedName":"黒田晶見(ちょも山)","creatorId":"vndb:s3559","sourcePersonId":"egs:creator:1064","canonicalEntityId":"vndb:s3559","name":"黒田晶見(ちょも山)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:104785","source":"egs"}],"scenario":[{"creditedName":"坂元星日","creatorId":"vndb:s913","sourcePersonId":"egs:creator:14704","canonicalEntityId":"vndb:s913","name":"坂元星日","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:104786","source":"egs"}],"music":[{"creditedName":"みやた","creatorId":"vndb:s53828","sourcePersonId":"vndb:s53828","canonicalEntityId":"vndb:s53828","name":"みやた","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:88629","source":"vndb"}],"other":[{"creditedName":"cage-low","creatorId":"vndb:s43050","sourcePersonId":"egs:creator:24960","canonicalEntityId":"vndb:s43050","name":"cage-low","detail":"OP曲「Fragile」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197903","source":"egs"},{"creditedName":"坂元星日","creatorId":"vndb:s913","sourcePersonId":"egs:creator:14704","canonicalEntityId":"vndb:s913","name":"坂元星日","detail":"プロット補佐、字コンテ","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:205203","source":"egs"},{"creditedName":"坂元 星日","creatorId":"vndb:s913","sourcePersonId":"vndb:s913","canonicalEntityId":"vndb:s913","name":"坂元 星日","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:88625","source":"vndb"},{"creditedName":"cage-low","creatorId":"vndb:s43050","sourcePersonId":"vndb:s43050","canonicalEntityId":"vndb:s43050","name":"cage-low","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:88627","source":"vndb"},{"creditedName":"cage-low","creatorId":"vndb:s43050","sourcePersonId":"vndb:s43050","canonicalEntityId":"vndb:s43050","name":"cage-low","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:88628","source":"vndb"}]},"cast":[{"characterId":"char_c6234","characterName":"城塚 比奈","sourceIds":{"bangumi":[{"characterId":"44723","match":"exact-normalized-name-in-linked-work","subjectId":"89715"}],"egsCharacterIds":["8582"],"vndbCharacterId":"c6234"},"originalCharacterName":"城塚 比奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She and the protagonist, Kirito Nogami, have been dating since their university days. Initially, it was Hina who developed feelings for Kirito first. However, lacking the courage to confess, they remained in a state of being more than friends but less than lovers for a while. Eventually, Kirito took the initiative to confess and they officially became a couple."},{"spoiler":false,"text":"Currently, she works at a small travel agency. Perhaps due to her good upbringing, she tends to have a somewhat laid-back demeanor but is not excessively reserved, and she expresses her opinions clearly. She has a trusting nature, which sometimes makes her a bit vulnerable, and she often attracts the attention of other men, especially around her chest area or lower body."},{"spoiler":false,"text":"Her likable personality, along with her ability to connect with people without discrimination, has earned her a high level of favorability among those around her. Her only romantic experience is with Kirito, and they always practice safe sex using contraception."},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c6234"},{"segments":[{"spoiler":false,"text":"主人公の野上霧斗とは大学時代から付き合っている。"},{"spoiler":false,"text":"元々は、比奈の方が先に霧斗のことが好きになった。"},{"spoiler":false,"text":"告白する勇気はなく、しばらくは友達以上恋人未満の状態だった。"},{"spoiler":false,"text":"霧斗の方から告白して付き合うようになる。"},{"spoiler":false,"text":"現在は小さい旅行代理店に勤めている。"},{"spoiler":false,"text":"育ちが良いためか、ややおっとりしているが、おとなしいというわけでもなく自分の意見はきちんと言う。"},{"spoiler":false,"text":"他人を疑わないためか、やや無防備な一面もあり、胸元や下半身に他の男性の視線を集める事もしばしば。"},{"spoiler":false,"text":"分け隔てなく周りの人と接するため周りの人たちからの好感度はかなり高い。"},{"spoiler":false,"text":"男性経験は霧斗のみ。避妊は必ずして行なっている。"}],"source":"egs","sourceCharacterId":"8582","sourceWorkId":"16996","spoiler":false},{"segments":[{"spoiler":false,"text":"育ちが良いためかややおっとりしているが、自分の意見はきちんと言う性格。"},{"spoiler":false,"text":"分け隔てなく周りの人と接するため、周囲からの好感度はかなり高い。"},{"spoiler":false,"text":"他人を疑うことを知らずやや無防備な一面もあり、胸元や下半身に男性の視線を集めることもしばしば。"},{"spoiler":false,"text":"主人公の霧斗とは大学時代から付き合っており、比奈から先に霧斗を意識していた。"},{"spoiler":false,"text":"しかし告白する勇気は無く、霧斗から告白してもらい付き合うようになった。"},{"spoiler":false,"text":"現在は小さい旅行代理店に勤めている。"},{"spoiler":false,"text":"「まずは、結婚式が終わってからだよね。それから霧斗くんと一緒に過ごして、それから……それから、考えればいいかな」"}],"source":"bangumi","sourceCharacterId":"44723"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"8582","sourceWorkId":"16996","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"8582","sourceWorkId":"16996","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8582","sourceWorkId":"16996","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"8582","sourceWorkId":"16996","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0a8a2477dc64ee37939cde1b5b6e523ac406acaa09c1784bba5976a3989c474.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94e93b003a4dd5504218932287e879daf85d1caab5ba245ad70b20d4c519483b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89715:44723:5075:1","source":"bangumi"}]},{"characterId":"char_vndb_c127307","characterName":"野上 霧斗","sourceIds":{"vndbCharacterId":"c127307"},"originalCharacterName":"野上 霧斗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He currently lives in Saitama with his mother and older brother, Tokia, at their family home. Unfortunately, his father passed away in an accident when he was still a baby, so he has no memories of him. During his school years, he worked part-time jobs along with his brother to support their livelihood. Like his brother, he initially had no plans to go to university and wanted to start working right after high school. However, his mother and Tokia convinced him that he should pursue a college education. Eventually, he decided to enroll in university. Even during his time at university, he continued to look for part-time jobs with higher hourly wages to support his tuition fees. (Though he had low attendance and barely managed to graduate with passing grades.)"},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c127307"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa0ac91e5c27d8bb05ff1f81ba823036bcc1f56c4ecf162e9a11232e315675d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c641387ca63a2b17bdad2d64df9f0363829b1e6ff2618f9a446f42be80c17b40.webp","width":108,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c127308","characterName":"野上 斗樹亜","sourceIds":{"vndbCharacterId":"c127308"},"originalCharacterName":"野上 斗樹亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【Protagonist's Older Brother】"},{"spoiler":false,"text":"He is a very caring and honest man."},{"spoiler":false,"text":"Their father passed away when they were young, so he took up part-time jobs since his school days to support their family and make life easier for their mother, all while maintaining a clean record at school."},{"spoiler":false,"text":"During his student years, he achieved excellent academic results, but he chose not to pursue higher education and instead started working, all to ensure their mother's comfort as quickly as possible."},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c127308"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a186f3eaaa47adce802deb8376597750a24c563d235c8436d381216e9c361095.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99f0dcc6a87c5ae35d8bef82460e3618d25390d9981bfa1849731a89f740b516.webp","width":125,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒須 珊汰","creatorId":"vndb:s15050","sourcePersonId":"vndb:s15050","canonicalEntityId":"vndb:s15050","name":"黒須珊汰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47071","source":"vndb"}]},{"characterId":"char_vndb_c127309","characterName":"真田 晃司","sourceIds":{"vndbCharacterId":"c127309"},"originalCharacterName":"真田 晃司","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【Hina's Senior Colleague】"},{"spoiler":false,"text":"He excels in his work within the company and is highly respected by everyone."},{"spoiler":false,"text":"His is not very talkative, and he is perceived as having a cool demeanor by those around him."},{"spoiler":false,"text":"From the moment he joined the company, he fell in love at first sight with Hina and has been planning to woo her someday."},{"spoiler":false,"text":"Interestingly, he has quite a bit of experience with women, having successfully captivated many in the past."},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c127309"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2211f61cdb6604982eb5ad88e303a2bc3f8a5bd3ea3261d19241e49681287ebc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72de18a5496827deaa4d2ebff4749fdc84a569f4bfc826ba8be66947ce859804.webp","width":132,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野宮 カヲル","creatorId":"vndb:s2908","sourcePersonId":"vndb:s2908","canonicalEntityId":"vndb:s2908","name":"野宮カヲル","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47069","source":"vndb"}]},{"characterId":"char_vndb_c129958","characterName":"木下 雅臣","sourceIds":{"vndbCharacterId":"c129958"},"originalCharacterName":"木下 雅臣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【Newspaper Delivery Man】"},{"spoiler":false,"text":"He is usually a very friendly old man."},{"spoiler":false,"text":"Thanks to his strong sales skills, he earns a comfortable income and doesn't face financial difficulties."},{"spoiler":false,"text":"He has been married twice before, but his womanizing nature led to infidelity and subsequent divorces."},{"spoiler":false,"text":"Since then, he has lived with various women but hasn't remarried any of them."},{"spoiler":false,"text":"Even as he's grown older, his vitality hasn't waned, and he is quite sadistic in sex."},{"spoiler":false,"text":"A seductive man with a combination of experience and vigor."},{"spoiler":false,"text":"Translated from official site"}],"source":"vndb","sourceCharacterId":"c129958"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f942a3f6e8d5caa88bec7fd8ff8a0550a2f245712c25eb410dd148a6362a9e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95509124015eecb317f1345027f68a5971440c174434ca954e51d69384d6a913.webp","width":189,"height":256,"source":"static-detail"},"actors":[{"creditedName":"邊鴉 凱","creatorId":"vndb:s2909","sourcePersonId":"vndb:s2909","canonicalEntityId":"vndb:s2909","name":"邊鴉凱","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47070","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p980","sourceCompanyId":"egs:brand:1815","canonicalEntityId":"vndb:p980","name":"LiLiM DARKNESS","roleCodes":["brand"],"identityStatus