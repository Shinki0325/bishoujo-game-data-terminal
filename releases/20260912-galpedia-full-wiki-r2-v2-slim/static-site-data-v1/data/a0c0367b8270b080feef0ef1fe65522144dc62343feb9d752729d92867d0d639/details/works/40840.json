db:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102620","source":"vndb"}]},{"characterId":"char_c169460","characterName":"ココ","sourceIds":{"bangumi":[{"characterId":"215026","match":"exact-normalized-name-in-linked-work","subjectId":"661775"}],"egsCharacterIds":["28493"],"vndbCharacterId":"c169460"},"originalCharacterName":"ココ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shouta’s and Eimi’s mother."},{"spoiler":false,"text":"A gentle, sweet, and doting mother on the surface, but this is merely a facade she maintains to play the role of the ideal mother so that her beloved Shouta won’t dislike her."},{"spoiler":false,"text":"In her student days, she was an even wilder gyaru than Eimi, and when she reveals her true self, she still transforms back into a gyaru."},{"spoiler":false,"text":"She ends up going on a trip with her longtime friend Bluette and her junior Yua. After deciding to swim in the sea, she resolves to go on a diet."},{"spoiler":false,"text":"Since Kokona gets bored easily, she believes she’ll be able to stick with the diet if she does it while flirting and getting intimate with her beloved son Shouta. Thus, she boldly offers her body in a dangerous, lewd way to ask for his help."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c169460"},{"segments":[{"spoiler":false,"text":"ヒロインの一人。翔太、瑛巳の母。"},{"spoiler":false,"text":"おっとり甘々お母さんだが、それは溺愛する翔太に嫌われないように理想の母親を演じ続けている仮の姿である。学生時代は瑛巳以上のギャルで、本性を出すと今でもギャル化する。学生時代からの友人であるブリュエットと後輩の雪愛と共に旅行する事になるが、海で泳ぐ事になり、ダイエットを決意。飽き性なので愛する息子の翔太とイチャイチャしながらダイエットすれば成功するまで続けられると考え、危ない意味で体を張ってお願いしてくる。"}],"source":"egs","sourceCharacterId":"28493","sourceWorkId":"40840","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインの一人。翔太、瑛巳の母。"},{"spoiler":false,"text":"おっとり甘々お母さんだが、それは溺愛する翔太に嫌われないように理想の母親を演じ続けている仮の姿である。"},{"spoiler":false,"text":"学生時代は瑛巳以上のギャルで、本性を出すと今でもギャル化する。"},{"spoiler":false,"text":"学生時代からの友人であるブリュエットと後輩の雪愛と共に旅行する事になるが、海で泳ぐ事になり、ダイエットを決意。"},{"spoiler":false,"text":"飽き性なので愛する息子の翔太とイチャイチャしながらダイエットすれば成功するまで続けられると考え、"},{"spoiler":false,"text":"危ない意味で体を張ってお願いしてくる。"}],"source":"bangumi","sourceCharacterId":"215026"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d155374bca247a055a9fa04a97e43c3e48ddb619468d5175a7072592c68f944.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f3edaa4267583d3b57f48c549ca16b8c26b86bc8a569ffad6db3bf1b8e0d3de.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:661775:215026:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102618","source":"vndb"}]},{"characterId":"char_c169461","characterName":"エッテ","sourceIds":{"bangumi":[{"characterId":"215027","match":"exact-normalized-name-in-linked-work","subjectId":"661775"}],"egsCharacterIds":["28495"],"vndbCharacterId":"c169461"},"originalCharacterName":"エッテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shinoa's mother. She is half-French."},{"spoiler":false,"text":"She treats her best friend's children — Kokona's son Shouta and daughter Eimi — like her own."},{"spoiler":false,"text":"She came to Japan as a student and has lived there ever since, so she is highly fluent in Japanese."},{"spoiler":false,"text":"Since their school days, she has been close friends with Kokona. She has adored Shouta, Kokona’s son, ever since he was a little boy. Knowing how Shinoa feels about him, she strongly hopes the two will get married."},{"spoiler":false,"text":"However, because of the upcoming trip, she ends up having to desperately go on a diet. By asking Shouta for help with it, their relationship begins to change dramatically in many ways."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c169461"},{"segments":[{"spoiler":false,"text":"ヒロインの一人。史乃亜の母親でフランス人。"},{"spoiler":false,"text":"学生の頃に来日し、以来ずっと日本に住んでいるので、日本語は堪能である。学生時代から友人、心菜の息子である翔太を幼い頃から、とても気に入っており、史乃亜の想いも知っている事から是非結婚して欲しい、と思っている。"},{"spoiler":false,"text":"しかし、旅行の一件で必死にダイエットしなくてはいけなくなり、それを翔太に頼った事から、色々大きく関係が変化する事になる。"}],"source":"egs","sourceCharacterId":"28495","sourceWorkId":"40840","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインの一人。史乃亜の母親でフランス人。"},{"spoiler":false,"text":"学生の頃に来日し、以来ずっと日本に住んでいるので、日本語は堪能である。"},{"spoiler":false,"text":"学生時代から友人、心菜の息子である翔太を幼い頃から、とても気に入っており、史乃亜の想いも知っている事から是非結婚して欲しい、と思っている。"},{"spoiler":false,"text":"しかし、旅行の一件で必死にダイエットしなくてはいけなくなり、それを翔太に頼った事から、色々大きく関係が変化する事になる。"}],"source":"bangumi","sourceCharacterId":"215027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eea76b722e85b4d4c36729bfd3fdc9a2cc75f6616805513db9eb1625b9a338da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7df29350fff3834ab0a9fd8be3f45af5adc905d49fe848bc02c9590b995dfaad.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:661775:215027:12718:1","source":"bangumi"}]},{"characterId":"char_c169462","characterName":"梨木 雪愛","sourceIds":{"bangumi":[{"characterId":"215025","match":"exact-normalized-name-in-linked-work","subjectId":"661775"}],"egsCharacterIds":["28494"],"vndbCharacterId":"c169462"},"originalCharacterName":"梨木 雪愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ria's mother."},{"spoiler":false,"text":"She has been hit on by countless men over the years, yet possesses an abnormally high ability to avoid danger and has never once gotten into trouble."},{"spoiler":false,"text":"However, she is a bigger troublemaker than her daughter Ria, possessing a bewitching charm and cuteness that allows her to almost certainly seduce anyone she sets her sights on."},{"spoiler":false,"text":"She is Kokona’s junior from their school days, she knows all about Kokona’s true cool and stylish gyaru era. She has been deeply devoted to her ever since, but she feels inwardly dissatisfied with the “façade” Kokona has been putting on since getting married."},{"spoiler":false,"text":"She is quite fond of Shouta. With the mindset that “for Ria to marry Shouta, he needs to become completely obsessed with her mom as well,” she takes full advantage of the protagonists assistance with her diet and relentlessly, without the slightest hesitation, keeps making sexual advances."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c169462"},{"segments":[{"spoiler":false,"text":"ヒロインの一人。莉愛の母親。"},{"spoiler":false,"text":"今まであまたの男性に口説かれてきているが、異常に危険回避能力が高く、トラブルにあった事がない。ただし、自分が狙った相手はほぼ確実に堕とす、魔性の色気と可愛さを持った莉愛以上のトラブルメーカーである。"},{"spoiler":false,"text":"心菜の後輩で、本来の格好良くおしゃれな彼女のギャル時代を知っており、ずっと彼女に心酔しているが、結婚後の猫かぶり姿には内心不満を持っている。"},{"spoiler":false,"text":"翔太の事はかなり気に入っており、莉愛と結婚させる為にはママにも夢中になってもらわないと、という考えで、ダイエットの手伝いに乗じてためらいなくエッチな事を仕掛けまくってくる。"}],"source":"egs","sourceCharacterId":"28494","sourceWorkId":"40840","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインの一人。莉愛の母親。"},{"spoiler":false,"text":"今まであまたの男性に口説かれてきているが、異常に危険回避能力が高く、トラブルにあった事がない。"},{"spoiler":false,"text":"ただし、自分が狙った相手はほぼ確実に堕とす、魔性の色気と可愛さを持った莉愛以上のトラブルメーカーである。"},{"spoiler":false,"text":"心菜の後輩で、本来の格好良くおしゃれな彼女のギャル時代を知っており、"},{"spoiler":false,"text":"ずっと彼女に心酔しているが、結婚後の猫かぶり姿には内心不満を持っている。"},{"spoiler":false,"text":"翔太の事はかなり気に入っており、莉愛と結婚させる為にはママにも夢中になってもらわないと、"},{"spoiler":false,"text":"という考えで、ダイエットの手伝いに乗じてためらいなくエッチな事を仕掛けまくってくる。"}],"source":"bangumi","sourceCharacterId":"215025"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6505e04a723f8eeb73c7c64c112e9d43d7394d9cce660518396ed85d9d3013b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feaf6d5cb2ab6a082081da175cab7ab6c6e7d5735e99d0fe2f830942db4db8ed.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:661775:215025:6359:1","source":"bangumi"}]},{"characterId":"char_c169463","characterName":"武田 夏代子","sourceIds":{"bangumi":[{"characterId":"215028","match":"exact-normalized-name-in-linked-work","subjectId":"661775"}],"egsCharacterIds":["28496"],"vndbCharacterId":"c169463"},"originalCharacterName":"武田 夏代子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young proprietress of the long-established hot spring ryokan chosen as the destination for this trip."},{"spoiler":false,"text":"She first met Shouta by chance when she visited his town for a national hotel industry training seminar before the trip."},{"spoiler":false,"text":"She leads an extremely busy life every day, and on top of that, things aren’t going well with her husband, causing both her mind and body to be exhausted."},{"spoiler":false,"text":"She is a natural leader who handles everything flawlessly and is relied upon by everyone around her. However, deep down, she strongly wishes to be spoiled and pampered by someone."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c169463"},{"segments":[{"spoiler":false,"text":"今回の旅行先に選んだ老舗温泉旅館の若女将。"},{"spoiler":false,"text":"翔太とは旅行前に全国ホテル業界の研修会で彼の住む街を訪れた際に偶然出会う。"},{"spoiler":false,"text":"毎日多忙な日々を送っている上、旦那と上手くいっていない為、心身が疲弊している。"},{"spoiler":false,"text":"何事も卒なくこなし、皆から頼られているリーダー気質だが、本心は誰かにいっぱい甘えたいと強く思っている。"}],"source":"egs","sourceCharacterId":"28496","sourceWorkId":"40840","spoiler":false},{"segments":[{"spoiler":false,"text":"今回の旅行先に選んだ老舗温泉旅館の若女将。"},{"spoiler":false,"text":"翔太とは旅行前に全国ホテル業界の研修会で彼の住む街を訪れた際に偶然出会う。"},{"spoiler":false,"text":"毎日多忙な日々を送っている上、旦那と上手くいっていない為、心身が疲弊している。"},{"spoiler":false,"text":"何事も卒なくこなし、皆から頼られているリーダー気質だが、本心は誰かにいっぱい甘えたいと強く思っている。"}],"source":"bangumi","sourceCharacterId":"215028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fca276c14dcd60c3322727201e03f0918cdf743c51cae83685bad6d9b976d9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b80945714b3f67e5a583361b1de5dc350532b556274582e2925076a4f2ab592.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井まみ","creatorId":"vndb:s939","sourcePersonId":"vndb:s939","canonicalEntityId":"vndb:s939","name":"平井 まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:661775:215028:18547:1","source":"bangumi"}]},{"characterId":"char_vndb_c169626","characterName":"日野 翔太","sourceIds":{"vndbCharacterId":"c169626"},"originalCharacterName":"日野 翔太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shouta is a second-year student at Hounoue Academy."},{"spoiler":false,"text":"After the big uproar surrounding the Literary Club’s survival one year ago, he ended up becoming dangerously intimate with his older sister Eimi, along with her friends Ria and Shinoa."},{"spoiler":false,"text":"Due to various circumstances, he was supposed to spend summer vacation alone, but he happened to stumble upon his mother Kokona, Riai’s mother Yua, and Shinoa’s mother Bluette as they were planning a one-week trip at the end of summer."},{"spoiler":false,"text":"During that moment, Yua arbitrarily decided that everyone would wear swimsuits and swim at the beach, which led all the mothers to start dieting in preparation for the trip. As a result, he ends up helping them with their diets."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c169626"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43cd9c711f97c481f3e4598c76422dfce90aef9b5f958703a13b1c7a90810351.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc2208ec8161ed3331680770284b53de4a5cf60a55cbad2584b9409b414a45a5.webp","width":224,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p171","sourceCompanyId":"egs:brand:413","canonica