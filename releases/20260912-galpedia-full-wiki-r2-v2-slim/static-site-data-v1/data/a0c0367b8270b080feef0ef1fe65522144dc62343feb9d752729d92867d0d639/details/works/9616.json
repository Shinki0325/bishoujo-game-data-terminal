date/terminal-wiki/v1/characters/v1/images/85/851683708b1264341cd76a3812aa240f9e33519b769c0f08624e880440a7465a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮下富三子","creatorId":"vndb:s1097","sourcePersonId":"vndb:s1097","canonicalEntityId":"vndb:s1097","name":"三園あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16993:144558:14968:1","source":"bangumi"}]},{"characterId":"char_c102683","characterName":"ガイ","sourceIds":{"bangumi":[{"characterId":"150995","match":"exact-normalized-name-in-linked-work","subjectId":"16993"}],"egsCharacterIds":["19567"],"vndbCharacterId":"c102683"},"originalCharacterName":"ガイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生真面目で常識人、エンヴィーのお目付役兼ツッコミ役。"},{"spoiler":false,"text":"ぶっきらぼうで、エンヴィーに対しては辛辣なセリフを吐く。"},{"spoiler":false,"text":"ガイも物心が付く前に両親を失っており、「リヒテンブルグ魔法学園」に入学したのもエンヴィーと同じ目的である。"},{"spoiler":false,"text":"エンヴィーと違い、育ての親が意図した事を正確に理解しており、ゆえにエンヴィーが退学にならずにその力の謎を解き明かせるようにと、色々とフォローに回っている。"},{"spoiler":false,"text":"エンヴィーとは兄弟（兄妹にあらず）同然に育ち、周囲にそういった女性がいなかった為に、いわゆる大人っぽく、女性らしい女性に対しての免疫がない。"},{"spoiler":false,"text":"ゆえに、始めて出会った女性らしい女性であるリゼットに憧れを抱いたり、フェロモン全開のレティーシャにドギマギしたりしている。"},{"spoiler":false,"text":"また、アリシア、ユーナに対しては友人として接していて、露骨にモーションをかけてくるユーナの気持ちにまったく気付かない朴念仁。"}],"source":"egs","sourceCharacterId":"19567","sourceWorkId":"9616","spoiler":false},{"segments":[{"spoiler":false,"text":"エンヴィーの幼馴染みで、大地や樹木を操る力を持つ少年。"},{"spoiler":false,"text":"生真面目で常識人、エンヴィーのお目付役兼ツッコミ役。ぶっきらぼうで、エンヴィーに対しては辛辣なセリフを吐く。"},{"spoiler":false,"text":"ガイも物心が付く前に両親を失っており、「リヒテンブルグ魔法学園」に入学したのもエンヴィーと同じ目的である。"},{"spoiler":false,"text":"エンヴィーと違い、育ての親が意図した事を正確に理解しており、ゆえにエンヴィーが退学にならずにその力の謎を解き明かせるようにと、色々とフォローに回っている。"},{"spoiler":false,"text":"レイテンスは、一対のブレスレット「シェル」。"},{"spoiler":false,"te