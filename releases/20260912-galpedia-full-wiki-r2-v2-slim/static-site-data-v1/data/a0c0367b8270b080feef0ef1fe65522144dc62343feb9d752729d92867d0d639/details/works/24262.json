onflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsubasa is a chuunibyuou girl whom believes herself to be the reincarnation of a demon lord. She wants to create a World Domination Club. She likes to help people out (as a demon lord’s work doesn’t end after she’s conquered the world, her kingdom and its people need to prosper!) and is well known around town. Her father plays along with her act but her younger brother finds her embarrassing. She really doesn’t like cats and is terrified of ghosts."},{"spoiler":false,"text":"from Zettai Renai"}],"source":"vndb","sourceCharacterId":"c52654"},{"segments":[{"spoiler":false,"text":"前世は魔王。今は人の身体に封印されている。"},{"spoiler":false,"text":"――真剣にと思いこんでいるらしい1年生。"},{"spoiler":false,"text":"支配領土は徹底管理がモットーの、地域密着型魔王。"},{"spoiler":false,"text":"魔王として『世界征服』と『平和統治』が当面の目標。"},{"spoiler":false,"text":"自分が『魔王』であることに強いこだわりを持ち、魔王話に調子を合わせてくれる主人公に懐いてくる。"}],"source":"egs","sourceCharacterId":"12750","sourceWorkId":"24262","spoiler":false},{"segments":[{"spoiler":false,"text":"前世は魔王で、今は人の身体に封印されている ――と思いこんでいるらしい 1年生。"},{"spoiler":false,"text":"支配領土は徹底管理がモットーの地域密着型で、当面の目標は世界征服と平和統治。"},{"spoiler":false,"text":"“魔王” であることに強いこだわりを持ち、調子を合わせてくれる主人公に懐いている。"},{"spoiler":false,"text":"「魔王と言っても凡夫には信じてもらえまい」と考え、普段は良識ある言動をとるが、"},{"spoiler":false,"text":"一人のときや顔見知りに対して調子に乗ると、途端に魔王モードになってしまう。"},{"spoiler":false,"text":"ただしヘタレなので、相手に引かれたり激しいツッコミを食らうと「ご、ごめんなさい……」としおれてしまう。"},{"spoiler":false,"text":"「わが名は黒瀬つばさ！　この世を一手に統べる魔王であるっ！」"}],"source":"bangumi","sourceCharacterId":"47628"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"47628","value":"世界征服部"},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"12750","sourceWorkId":"24262","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"12750","sourceWorkId":"24262","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"12750","sourceWorkId":"24262","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"12750","sourceWorkId":"24262","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"12750","sourceWorkId":"24262","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"12750","sourceWorkId":"24262","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf4d78ccdc08e8618a7feb4bf331230ed5dc83404f6981d546a7fd6d2b4dee71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/856b46a9855e65bc0ddaae75a17f878fe523629af46c05126708b484106dbb19.webp","width":141,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大橋歩夕","creatorId":"vndb:s1178","sourcePersonId":"vndb:s1178","canonicalEntityId":"vndb:s1178","name":"大橋 歩夕","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:193205:47628:6174:1","source":"bangumi"}]},{"characterId":"char_c52655","characterName":"塚端 みこ","sourceIds":{"bangumi":[{"characterId":"47629","match":"exact-normalized-name-in-linked-work","subjectId":"193205"}],"egsCharacterIds":["12751"],"vndbCharacterId":"c52655"},"originalCharacterName":"塚端 みこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After spending two years as a member of the going home club, Miko is worried about her high school days coming to an end and wants to create a youth club to treasure those precious moments and create new everlasting memories. She’s known Akira since their first year of high school and the two are currently classmates but she is often rude or cold towards him and just refers to him as “class rep”. She often does part-time jobs and is currently works in a pet shop. Miko is popular and has a lot of friends."},{"spoiler":false,"text":"from Zettai Renai"}],"source":"vndb","sourceCharacterId":"c52655"},{"segments":[{"spoiler":false,"text":"派手めな友達に影響を受けバイトや遊びに勤しんでいるうちに、ふと振り返ってみて、部活動 も 文化祭 も初恋 もエンジョイしていなかったことに気付く。"},{"spoiler":false,"text":"学園での、学生服を着ているときの、普通の青春がしたい。そう願って、青春部の設立を宣言。"},{"spoiler":false,"text":"主人公とはクラスメイトで、同じ三年生として個性派な下級生をまとめる苦労を分かち合う仲。"}],"source":"egs","sourceCharacterId":"12751","sourceWorkId":"24262","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、青春部の設立を宣言した女の子。"},{"spoiler":false,"text":"地味でボッチだった過去に別れを告げ、学園デビューを果たしたのも 2年前の話。"},{"spoiler":false,"text":"派手めな友達の影響から、バイトや遊びに勤しんでいるうちに時は過ぎていき、"},{"spoiler":false,"text":"部活動 も 文化祭 も 初恋 もエンジョイしていなかったことに気付く。"},{"spoiler":false,"text":"“学園での、学生服を着ているときの、普通の青春がしたい” と願っている。"},{"spoiler":false,"text":"主人公とは同じ三年生として、個性派な下級生をまとめる苦労を分かち合う仲。"},{"spoiler":false,"text":"上級生として・女子としての先輩風を吹かせたいのだが、いまいち格好がつかない。"},{"spoiler":false,"text":"ひそかな誇りだったバストサイズでも下級生の詩菜に負けてしまい、自信喪失気味。"},{"spoiler":false,"text":"特別なことして目立ちたいと思いながらも、一歩踏み出せずツッコミに回ってしまう、切ない常識人。"},{"spoiler":false,"text":"「もっと学生らしい青春がしたいのっ！」"}],"source":"bangumi","sourceCharacterId":"47629"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"47629","value":"青春部"},{"label":"胸围（本版本