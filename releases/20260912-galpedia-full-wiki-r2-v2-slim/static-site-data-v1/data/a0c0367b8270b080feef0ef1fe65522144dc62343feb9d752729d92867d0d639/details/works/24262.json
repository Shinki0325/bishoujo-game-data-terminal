262","spoiler":false},{"segments":[{"spoiler":false,"text":"陸上部（短距離）と生徒会（広報）を兼任するエネルギッシュ女子。"},{"spoiler":false,"text":"生徒会長である歩鳥とよく絡んでいるためか、主人公とも顔なじみ。"},{"spoiler":false,"text":"歩鳥のことを心の底から慕っているらしく、周囲から「忠犬っぽい」と言われている。"},{"spoiler":false,"text":"「アタシはいつも通り、姉さんのお供っす！」"}],"source":"bangumi","sourceCharacterId":"50858"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"50858","value":"陸上部＆生徒会（広報）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d2b0d51a343e788cd9ff1724e91eac77d29f5780d536ef7720aad5b532c6066.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a19dfece24beb9bd47e9f37ac6a3f3616071d194210244acb6c80e2d55dd4898.webp","width":86,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:193205:50858:15637:1","source":"bangumi"}]},{"characterId":"char_c56319","characterName":"月本 栞","sourceIds":{"bangumi":[{"characterId":"50859","match":"exact-normalized-name-in-linked-work","subjectId":"193205"}],"egsCharacterIds":["12754"],"vndbCharacterId":"c56319"},"originalCharacterName":"月本 栞","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"つばさのクラスの担任で、文芸部の顧問を受け持つ。"},{"spoiler":false,"text":"感激屋だが飽きっぽく、面倒事を章に押し付けることもしばしば。"},{"spoiler":false,"text":"廃部寸前の宣告を受けて章に泣きついていた。"},{"spoiler":false,"text":"学生時代に文芸部だったため、文芸部に思い入れはあるらしい。"}],"source":"egs","sourceCharacterId":"12754","sourceWorkId":"24262","spoiler":false},{"segments":[{"spoiler":false,"text":"つばさのクラスの担任で、文芸部の顧問を受け持つ。"},{"spoiler":false,"text":"感激屋だが飽きっぽく、面倒事を主人公に押し付