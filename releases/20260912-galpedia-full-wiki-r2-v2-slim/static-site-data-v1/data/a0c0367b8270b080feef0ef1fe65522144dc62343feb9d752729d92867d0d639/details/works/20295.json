":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jealousy index: 120%"},{"spoiler":false,"text":"Chest size: Mount Fuji class"},{"spoiler":false,"text":"The main heroine and protagonist's super obsessive brocon little sister. Very smart and good at academics, she is often considered the honor student."}],"source":"vndb","sourceCharacterId":"c17934"},{"segments":[{"spoiler":false,"text":"主人公の実妹。清楚で可憐、学業も優秀。"},{"spoiler":false,"text":"全てが揃った完璧系美少女。"},{"spoiler":false,"text":"昔から重度のブラコン。"},{"spoiler":false,"text":"その愛の大きさは兄の留学がきっかけで精神崩壊したほど。"},{"spoiler":false,"text":"兄にふさわしい淑女になるため勉強もスポーツも真面目に取り組み、バストアップ体操で巨乳になった。"},{"spoiler":false,"text":"実はかなりの頑張り屋（方向性があっているかは謎"}],"source":"egs","sourceCharacterId":"4305","sourceWorkId":"20295","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の実妹。"},{"spoiler":false,"text":"清楚で可憐、学業も優秀。 すべてが揃った完璧系美少女。"},{"spoiler":false,"text":"昔から重度のブラコン。 その愛の大きさは兄の留学がきっかけで精神崩壊したほど。"},{"spoiler":false,"text":"兄にふさわしい淑女になるため勉強もスポーツもまじめに取り組み、バストアップ体操で巨乳になった。"},{"spoiler":false,"text":"実はかなりの頑張り屋 （方向性が合っているかは謎）。"},{"spoiler":false,"text":"「お兄様あぁ……（くんかくんか、すーはーすーはー）」"},{"spoiler":false,"text":"主人公的亲妹妹。清纯可怜，成绩优秀。"},{"spoiler":false,"text":"一切全能的完美系美少女。"},{"spoiler":false,"text":"从以前开始就是重度的兄控。"},{"spoiler":false,"text":"由于对哥哥的爱意深，导致她以主人公留学为转折，彻底精神崩坏。"},{"spoiler":false,"text":"为了能成为配得上哥哥的淑女，他认真学习，锻炼身体，"},{"spoiler":false,"text":"通过丰胸体操成为了巨乳。"},{"spoiler":false,"text":"实际上是非常上进的女孩子（就是努力的方向有些迷）。"}],"source":"bangumi","sourceCharacterId":"26269"}],"profileFacts":[{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"4305","sourceWorkId":"20295","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/168453574be85cb7abe2effb41755fa23e621c357bbeb15eb4dffa97907623eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5d5e3827fe8d50afb76c79bbdeea44e05f01758de0ada94d5efd913494d0a87.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100310:26269:8493:1","source":"bangumi"}]},{"characterId":"char_c17936","characterName":"伊吹 恋羽","sourceIds":{"bangumi":[{"characterId":"26271","match":"exact-normalized-name-in-linked-work","subjectId":"100310"}],"egsCharacterIds":["4307"],"vndbCharacterId":"c17936"},"originalCharacterName":"伊吹 恋羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jealousy index: 80%"},{"spoiler":false,"text":"Chest size: Southern Alps class"},{"spoiler":false,"text":"The protagonist's childhood friend. She moved out in middle school and promised to \"be absolutely cute when they meet again\", she has turned out to be a stunningly beautiful girl after all those years."}],"source":"vndb","sourceCharacterId":"c17936"},{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。中学に上がる時に家庭の事情で引っ越す事になり、とある事情で「次に会う時までに絶対可愛くなる」と決意して、一途な気持ちでイマドキ風美少女に進化した。"},{"spoiler":false,"text":"今年、数年ぶりに主人公と再会。"},{"spoiler":false,"text":"ケンカ友達みたいなポジションに落ち着いているのが悩みの種。"},{"spoiler":false,"text":"恋に恋する乙女で「あいつとこんな恋をしたいな、お姫様って呼ばれたいな」と妄想している。"}],"source":"egs","sourceCharacterId":"4307","sourceWorkId":"20295","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。"},{"spoiler":false,"text":"中学に上がる時に家庭の事情で引っ越すことになり、とある事情で 「次に会う時までに絶対可愛くなる」 と決意して、一途な気持ちでイマドキ風美少女に進化した。"},{"spoiler":false,"text":"今年、数年ぶりに主人公と再会。"},{"spoiler":false,"text":"ケンカ友達みたいなポジションに落ち着いているのが悩みの種。"},{"spoiler":false,"text":"恋に恋する乙女で、「あいつとこんな恋をしたいな、お姫様って呼ばれたいな」 と妄想している。"},{"spoiler":false,"text":"「ちょっと強引くらいなほうが好きっていうか……ごにょごにょ」"},{"spoiler":false,"text":"主人公的青梅竹马。升中学的时候，由于家庭原因搬走，"},{"spoiler":false,"text":"又因为某个理由，下定决心「在下次见面时一定要变得更可爱」后，"},{"spoiler":false,"text":"抱着这毫无动摇的心情，进化成了当下流行系美少女。"},{"spoiler":false,"text":"如今，和主人公实现了再会。"},{"spoiler":false,"text":"只是头疼，自己逐渐被定位成了吵吵闹闹的玩伴。"},{"spoiler":false,"text":"身为向往恋爱的少女，整天抱着「好想和那家伙谈一场这样那样的恋爱呀，"},{"spoiler":false,"text":"好想被叫做公主大人呀」之类的妄想。"}],"source":"bangumi","sourceCharacterId":"26271"}],"profileFacts":[{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"4307","sourceWorkId":"20295","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/493944224abff24a18b11a3e9a07d26463aa97e3653c978a65aabd16ee892bc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b302080818b945b199264d488d5685c97aed5d2df80910332a023cc576fc154.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100310:26271:13372:1","source":"bangumi"}]},{"characterId":"char_c17937","characterName":"雪倉 睦月","sourceIds":{"bangumi":[{"characterId":"26272","match":"exact-normalized-name-in-linked-work","subjectId":"100310"}],"egsCharacterIds":["4308"],"vndbCharacterId":"c17937"},"originalCharacterName":"雪倉 睦月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1026"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jealousy index: 100%"},{"spoiler":false,"text":"Chest size: Kilimanjaro class"},{"spoiler":false,"text":"Mutsuki already knows Takumi even before he transfers to Sana's school."}],"source":"vndb","sourceCharacterId":"c17937"},{"segments":[{"spoiler":false,"text":"主人公の先輩。中学時代からの付き合い。"},{"spoiler":false,"text":"美術家の親の影響で幼少期から数々の絵画コンクールなどを総ナメにしており学業も優秀。"},{"spoiler":false,"text":"しかし、実はオタク全開で萌え系イラストレーターとして活動しているが、周りには隠している（主人公は知ってる）"},{"spoiler":false,"text":"口数が少なく人付き合いを好まないので孤立気味だが、主人公だけは平然と寄っていく。そんな彼につれない態度をとりながらも、本心では好きで好きで仕方ない。"}],"source":"egs","sourceCharacterId":"4308","sourceWorkId":"20295","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の先輩。 中学時代からの付き合い。"},{"spoiler":false,"text":"美術家の親の影響で、幼少期から数々の絵画コンクールなどを総ナメにしており学業も優秀。"},{"spoiler":false,"text":"しかし、実はオタク全開で萌え系イラストレーターとして活動しており、周りには隠している （主人公は知ってる）。"},{"spoiler":false,"text":"口数が少なく人付き合いを好まないので孤立気味だが、主人公だけは平然と寄っていく。"},{"spoiler":false,"text":"そんな彼につれない態度をとりながらも、本心では好きで好きで仕方ない。"},{"spoiler":false,"text":"「ちょっとなにを言ってるかわからないわね。 日本語でお願いできるかしら？」"},{"spoiler":false,"text":"主人公的前辈。从中学起就相互认识。"},{"spoiler":false,"text":"受到艺术家家庭的影响，从很小的时候就荣获过各种绘画大奖赛的奖杯，"},{"spoiler":false,"text":"学习成绩也非常优秀。"},{"spoiler":false,"text":"但是，实际上却有作为一个阿宅属性全开的萌系插画师开展活动，"},{"spoiler":false,"text":"当然对周围所有人都是保密的（除了主人公以外）。"},{"spoiler":false,"text":"话比较少不喜欢和他人交流所以有些孤立，"},{"spoiler":false,"text":"但对主人公却能毫无顾忌的接近。对于主人公虽然采取的是非常毒舌的态度，"},{"spoiler":false,"text":"但内心却是喜欢到不得了。"}],"source":"bangumi","sourceCharacterId":"26272"}],"profileFacts":[{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"4308","sourceWorkId":"20295","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bish