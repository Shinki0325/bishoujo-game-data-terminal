ource-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kotarou's kouhai. She has a reserved and honest disposition. Even if she doesn't speak, she is able to convey herself through her behavior; she has rich facial expressions. Although a member of the Disciplinary Committeee, she rarely acts like one, besides as a pretext for looking after Kotarou. She fawns over her favorite dish, saury."}],"source":"vndb","sourceCharacterId":"c270"},{"segments":[{"spoiler":false,"text":"瑚太朗の後輩で、風紀委員会に所属している。"},{"spoiler":false,"text":"無口で素直な性格。 言葉がなくても振る舞いで伝わる、感情表現の豊かな少女。"},{"spoiler":false,"text":"あまり風紀の活動を行わないが、瑚太朗に構ってほしくて取締りをすることがある。"},{"spoiler":false,"text":"眼帯はオッドアイを隠すためのもので、親しい人の前でしか外すことはない。"},{"spoiler":false,"text":"さんまが好物で溺愛している。"}],"source":"egs","sourceCharacterId":"23706","sourceWorkId":"10917","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的后辈、风纪委员会所属。无口但很直率。"},{"spoiler":false,"text":"虽然不怎么说话但会通过行动来表达、感情表现很丰富的少女。"},{"spoiler":false,"text":"几乎没像样地做过风纪委员的工作、为了让瑚太朗注意自己而对他进行监管。"},{"spoiler":false,"text":"为了隐瞒自己的虹彩异色症而戴着眼罩、只有在亲近的人面前才会拿下。"},{"spoiler":false,"text":"非常喜欢吃秋刀鱼。"}],"source":"bangumi","sourceCharacterId":"12074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4aa0ff740ee3a2bf7dd86badc35d1094fd3e556b44dece263b4268a708c370d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ca94e1bed7d2a587bf2371a51799cb4cc270b314c0b2a1b03ab11d201103255.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c303","characterName":"鳳 ちはや","sourceIds":{"bangumi":[{"characterId":"12065","match":"exact-normalized-name-in-linked-work","subjectId":"4022"}],"egsCharacterIds":["23704"],"vndbCharacterId":"c303"},"originalCharacterName":"鳳 ちはや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"824"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who suddenly transferred to the school Kotarou attends. She has led a sheltered life and is ignorant of the ways of the world. Considerably clumsy and easily getting lost, Kotarou always helps her out, but with her personality that can't stay meek they can't stop quarreling. Called a \"power fighter\" for being really strong physically."}],"source":"vndb","sourceCharacterId":"c303"},{"segments":[{"spoiler":false,"text":"風祭高校に突然転校してきた少女。 世間知らずの箱入り娘で、パワーファイター。"},{"spoiler":false,"text":"かなりのドジっ子で瑚太朗に助けられてばかりだが、素直になれず口論が絶えない。"},{"spoiler":false,"text":"周りからは瑚太朗に気があるようにも本気で嫌っているようにも見える。"}],"source":"egs","sourceCharacterId":"23704","sourceWorkId":"10917","spoiler":false},{"segments":[{"spoiler":false,"text":"突然转学到瑚太朗所在学校的少女。"},{"spoiler":false,"text":"不知人间险恶的深闺大小姐、精力过剩的存在。"},{"spoiler":false,"text":"由于其过分天然呆的属性一直受到瑚太朗的帮助、但由于其别扭的性格总是和瑚太朗争论不休。"},{"spoiler":false,"text":"从周围人看来是又在意瑚太朗又很讨厌他的样子。"}],"source":"bangumi","sourceCharacterId":"12065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/573cf14a9f3351a045fe84d968939b6762f1fb679a24553bb3f2bb1fd1e0d8a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5e40e1dca0403ec7be37f61a1d43e8fa7793c529735c52f4f8c11cd367f7b22.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篠宮沙弥","creatorId":"vndb:s1363","sourcePersonId":"vndb:s1363","canonicalEntityId":"vndb:s1363","name":"篠宮 沙弥","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:227977:12065:6274:1","source":"bangumi"}]},{"characterId":"char_vndb_c267","characterName":"天王寺 瑚太朗","sourceIds":{"vndbCharacterId":"c267"},"originalCharacterName":"天王寺 瑚太朗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"502"},"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"waist":{"reviewState":"source-only","source":"vndb","value":"72"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bit brazen, getting carried away easily. While not aware of it himself, he's a somewhat meddlesome person. Perhaps because of poking his nose into others' affairs, he has recently gotten involved in inexplicable events."}],"source":"vndb","sourceCharacterId":"c267"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dedef54d5b7b47d6a44ea4c06ac4c306d07a767cbfde4426f9185be01fca8b39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da876df3d806e34daf040e5f660762ed5c0f8b42640f8b524bb5284bdb2cc182.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森田 成一","creatorId":"vndb:s176","sourcePersonId":"vndb:s176","canonicalEntityId":"vn