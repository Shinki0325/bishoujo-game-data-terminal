aCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b86f83e1b7e55097e69d6d6304bc20dedf53abceb09b6f352ad0c0d4c2de5e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78f8146b5f646a679770c7449ea640c44e8db24ad943cfba85aed7b5ec8bd0ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千房 こまめ","creatorId":"vndb:s15860","sourcePersonId":"vndb:s15860","canonicalEntityId":"vndb:s15860","name":"千房 こまめ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9005","source":"vndb"}]},{"characterId":"char_c55133","characterName":"ベリー","sourceIds":{"bangumi":[{"characterId":"219194","match":"exact-normalized-name-in-linked-work","subjectId":"348616"}],"egsCharacterIds":["17277"],"vndbCharacterId":"c55133"},"originalCharacterName":"ベリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商店街（？）で罠にはまったところを主人公に助けてもらった兎。"},{"spoiler":false,"text":"兎だけに寂しいと死んでしまうので大変。"},{"spoiler":false,"text":"主人公のことを「パぁパ」と呼んで甘えてくる。"},{"spoiler":false,"text":"基本的に無口だが、ときどき毒を吐く。"},{"spoiler":false,"text":"兎なのに甘いものが大好きで、直ぐに食い散らかすため目が離せない。"},{"spoiler":false,"text":"「パぁパ……。」"}],"source":"egs","sourceCharacterId":"17277","sourceWorkId":"11244","spoiler":false},{"segments":[{"spoiler":false,"text":"元はウサギ。"},{"spoiler":false,"text":"商店街で罠（？）にハマったところを主人公に助けてもらった。"},{"spoiler":false,"text":"甘えるのが大好きで、淋しいと死んでしまう。"},{"spoiler":false,"text":"主人公のことを \"パぁパ\"と呼び、甘えられるように頑張る。"},{"spoiler":false,"text":"恐がりで寂しがり屋。常に縫いぐるみを抱っこしていないと落ち着かない。"},{"spoiler":false,"text":"ウサギのくせに甘いものが大好きで、目を離すと食べ散らかしている。"},{"spoiler":false,"text":"口数は少ないが時々毒を吐く。"},{"spoiler":false,"text":"好きなものはパぁパの抱っこと縫いぐるみ。嫌いなものは寂しいのと声の大きな人。"}],"source":"bangumi","sourceCharact