ast":[{"characterId":"char_c47391","characterName":"如月 嶺衣奈","sourceIds":{"bangumi":[{"characterId":"41656","match":"exact-normalized-name-in-linked-work","subjectId":"181736"}],"egsCharacterIds":["8598"],"vndbCharacterId":"c47391"},"originalCharacterName":"如月 嶺衣奈","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"デビューしてから一年目の新人アイドル。"},{"spoiler":false,"text":"学園に通いながらアイドルとして活動している少女。"},{"spoiler":false,"text":"容姿に優れ文武両道を地で行くが、自分への自信とは裏腹に、デビュー後は泣かず飛ばずでろくな仕事もない状況が続いている。"},{"spoiler":false,"text":"他のアイドルと比べて、自分が劣っているとは思っていないが、それでも自分にはアイドルとして何かが足りないのかと、もやもやした不安と憤りを抱えている。"},{"spoiler":false,"text":"アイドル好きの父の影響でキラキラと輝くアイドルに憧れた結果、実際にアイドルにまでなってしまうなど、夢に向かって一途にがんばれる努力家。"},{"spoiler":false,"text":"しかし同時に、アイドルは売れなければ、人気が出なければ意味がない、と言い切るほどの現実主義者でもある。"},{"spoiler":false,"text":"気が強く、自信過剰気味な性格ではあるが、肝が据わっており、多少のことではへこたれることも諦めることもない。"},{"spoiler":false,"text":"アイドルとして活動する時には明るくにこやかな笑顔を崩さないなど、しっかりとしたプロ意識を持っている。"}],"source":"egs","sourceCharacterId":"8598","sourceWorkId":"23678","spoiler":false},{"segments":[{"spoiler":false,"text":"刚出道第一年的偶像。"},{"spoiler":false,"text":"实现了儿时向往已久的梦想，能够想着目标不断的努力。"},{"spoiler":false,"text":"同时，又是个现实主义者，认为不走红的偶像毫无意义。"},{"spoiler":false,"text":"倔强且有些自负，处变不惊、不容易受打击。"},{"spoiler":false,"text":"心中充满职业意识的她，从不让开朗的笑容从脸上消失。"},{"spoiler":false,"text":"「偶像就是为了出名而站在这里，如果做不到的话就没有意义。」"}],"source":"bangumi","sourceCharacterId":"41656"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a439e44f478efe181952eb68b5c3f22e1a095821212cc2281208dc2eb2dfc052.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a12ca627fa6ea5f3fb4c7bcee6317d920d3593aed69c36b110dc848dc73e68f6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181736:41656:17075:1","source":"bangumi"}]},{"characterId":"char_c47392","characterName":"アンリ","sourceIds":{"bangumi":[{"characterId":"41657","match":"exact-normalized-name-in-linked-work","subjectId":"181736"}],"egsCharacterIds":["8599"],"vndbCharacterId":"c47392"},"originalCharacterName":"アンリ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"嶺衣奈と同じ事務所に所属している先輩アイドル。"},{"spoiler":false,"text":"ほんわかとした優しげな雰囲気、それとは裏腹のスタイルの良さから、エロ可愛いアイドルとして認知されており、人気アイドルとしてバリバリ仕事をこなしている。"},{"spoiler":false,"text":"実は業界関係者と肉体関係を持つことで仕事を得ているが、アンリ自身は気持ちいいし、仕事も貰えて嬉しいという程度の認識のため、むしろそうした行為を含め、本人は楽しくアイドル活動をしている。"},{"spoiler":false,"text":"明るくポジティブ、かつ非常にマイペースで素直な性格だが、物事を深く考えるのが苦手。"},{"spoiler":false,"text":"物事の良い事だけしか見ないため、人の本心を察することができない。"}],"source":"egs","sourceCharacterId":"8599","sourceWorkId":"23678","spoiler":false},{"segments":[{"spoiler":false,"text":"与嶺衣奈所属同一个事务所的前辈偶像。"},{"spoiler":false,"text":"有点色色的、又十分可爱的人气偶像，在各种活动中活跃着。"},{"spoiler":false,"text":"暗地里通过与老板们之间的潜规则而获得工作。"},{"spoiler":false,"text":"自己觉得又能得到工作又能让自己爽一下，因此很高兴的进行着偶像活动。"},{"spoiler":false,"text":"开朗、积极、十分的我行我素，性格天真，不擅长深究事情缘由。"},{"spoiler":false,"text":"遇事总往好的方向去想，不去察觉别人恶意。"},{"spoiler":false,"text":"「嗯，感觉很舒服，又能拿到工作，可谓一石二鸟。」"}],"source":"bangumi","sourceCharacterId":"41657"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4ba946478a0239322b398b8e43dc6bbbe9b84b19b08d8f1fb7bdbda066d1dd97.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0f519a2e1a9df838a6cb3b68c258ea0cf89b958dc42e97