ative","relationId":"vndb:vn-staff:159324","source":"vndb"},{"creditedName":"株式会社クリープ","creatorId":"vndb:s18796","sourcePersonId":"vndb:s18796","canonicalEntityId":"vndb:s18796","name":"株式会社クリープ(cre-p)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:159326","source":"vndb"},{"creditedName":"株式会社 アルトワークス","creatorId":"vndb:s19913","sourcePersonId":"vndb:s19913","canonicalEntityId":"vndb:s19913","name":"株式会社Al't-works(株式会社アルトワークス)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:159327","source":"vndb"}]},"cast":[{"characterId":"char_c15724","characterName":"深海 直刃","sourceIds":{"bangumi":[],"egsCharacterIds":["4802"],"vndbCharacterId":"c15724"},"originalCharacterName":"深海 直刃","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"呪いにより、元禄時代にタイムスリップした現代人。"},{"spoiler":false,"text":"だが、生まれついての剣の才能と赤穂浪士を身近に触れることで、立派な武士として成長を果たす。"},{"spoiler":false,"text":"前作で黒幕を倒し、見事に江戸の窮地救ったのも束の間、島では新たな問題が発生する。"},{"spoiler":false,"text":"そして、空白の1年間でもかつて経験したことのないような難題を突き付けられていた。"},{"spoiler":false,"text":"この 2つの窮地を直刃は、どうやって切り抜けるのだろうか。いよう、ひそかに予防線を"},{"spoiler":false,"text":"張り巡らせたりしている。"}],"source":"egs","sourceCharacterId":"4802","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24c66f113daf863e04ed312992a76df4048cb612965ad2cb174b88137bc3d5cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bba5820d97751b14ea4b9885595e03f05230fc260c40a80bc6aa21d186f8b73.webp","width":143,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c16504","characterName":"山吉 新八郎","sourceIds":{"bangumi":[{"characterId":"26524","match":"exact-normalized-name-in-linked-work","subjectId":"289251"}],"egsCharacterIds":["21734"],"vndbCharacterId":"c16504"},"originalCharacterName":"山吉 新八郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"片目に眼帯、長刀使いの武士。"},{"spoiler":false,"text":"赤穂浪士の討ち入りの際、吉良側で最も反撃したと言われた一人。"},{"spoiler":false,"text":"主人公の直刃とは赤穂浪士の動向を探る途中、偶然に出会って一目惚れする。それ以来、行動を共にすることになった。"},{"spoiler":false,"text":"直刃に甘えながらも、一途に尽くす性格だが反面、疑い深く嫉妬深いところもあり、浮気を疑うときは前置きなく刀を抜いて、しばしば直刃を困らせる。"},{"spoiler":false,"text":"直刃が３００年以上先の時代からタイムスリップしてきたことは知っているが、それに対して気にする素振りは見えない。"},{"spoiler":false,"text":"自分が吉良家の家臣だったことを直刃には伝えておらず、そのことを本人は気にしている。"},{"spoiler":false,"text":"直刃のことを「お兄ちゃん」と呼び、自分のことは「わっち」と言う。"}],"source":"egs","sourceCharacterId":"21734","sourceWorkId":"28456","spoiler":false},{"segments":[{"spoiler":false,"text":"上杉家家臣。单眼的武士。"},{"spoiler":false,"text":"性格亲切明快，一旦拔剑就会将长度堪比晾衣杆的长刀挥舞自如，其强大不会输于安兵衛或者一学。"},{"spoiler":false,"text":"被身为上杉家家老的色部下令暗杀内蔵助。"},{"spoiler":false,"text":"「该说小哥你什么好呢，撩起了我的母性本能哦」"}],"source":"bangumi","sourceCharacterId":"26524"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14770dc683c009c4bf1fee1450bceeff440e65c4f3e8065c30b6acc899a7876f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c42a8ff23a43014ce52afe45b98ef75a30181faca7439fd356893a300ef9888e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:289251:26524:5936:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p6978","sourceCompanyI