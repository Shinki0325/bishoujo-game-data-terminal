"characterId":"char_bangumi_113173","characterName":"加賀広人","sourceIds":{"bangumi":[{"characterId":"113173","match":"source-roster","subjectId":"17651"},{"characterId":"113173","match":"source-roster","subjectId":"17653"},{"characterId":"113173","match":"source-roster","subjectId":"589338"}]},"originalCharacterName":"加賀広人","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf2d99aef6e25e11d0c2a186c7ed13dbc2ea4a1aac62faea08cb9ea0326f3d48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c7facfa1b882c7a7f0c5766ea881dc6aa0064ffdb4462fcd1462c4a9830e03f.webp","width":153,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21407","characterName":"羽山 浩一","sourceIds":{"bangumi":[{"characterId":"21407","match":"source-roster","subjectId":"17651"},{"characterId":"21407","match":"source-roster","subjectId":"486042"},{"characterId":"21407","match":"source-roster","subjectId":"589338"}]},"originalCharacterName":"羽山 浩一","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公。北条大学の本山教授の研究室に所属する大学生。容姿は美青年であるが、女性の顔を認識できないという特殊な病に悩まされている。本山教授の勧めで幼い頃過ごした信州の倉木の山を訪れるが、そこで突然、倉木鈴菜と許婚の間柄であることが判明し、当主となってしまう。極度のヘビースモーカーで強靭な精力の持ち主。"}],"source":"bangumi","sourceCharacterId":"21407"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afdba3d08b83bcb90c1bf8d12cc7de46a079ee88a36f36b5def46b9f46fce5c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d9a83190efb163bf956717ce1da8047f2dcbb8d22c53c3a0eab44c34c5d2a51.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21408","characterName":"倉木 鈴菜","sourceIds":{"bangumi":[{"characterId":"21408","match":"source-roster","subjectId":"114185"},{"characterId":"21408","match":"source-roster","subjectId":"17651"},{"characterId":"21408","match":"source-roster","subjectId":"486042"},{"characterId":"21408","match":"source-roster","subjectId":"589338"}]},"originalCharacterName":"倉木 鈴菜","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メインヒロイン。1982年生まれ。倉木家前当主の倉木 善治郎（くらき ぜんじろう）とその妻の由利子の娘にして、倉木神社の巫女。陰の気が強い。浩一の許婚だが、突然押し付けられた関係には少々戸惑い気味。また、我侭な所があったり、手紙の出し方やファミリーレストランの存在も知らないなど、純粋培養の温室育ちの美少女でもある。浩一のような図々しく荒い言葉を浴びせてくる相手には出会ったことが無かったため、反感を持ちつつも次第に心惹かれ、女性としても目覚めていく。"}],"source":"bangumi","sourceCharacterId":"21408"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/913d2c8fa5faf39f8241444b4392df676190edfcdffdfc12dda37cf6f8797a86.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/542cae1b00a1c56a0247a44517b2cf6829eedcff79f3d125fa16c186370d21c4.webp","width":177,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p164","sourceCompanyId":"egs:brand:324","canonicalEntityId":"vndb:p164","name":"ROOT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:1547:324","source":"egs"},{"companyId":"vndb:p164","sourceCompanyId":"vndb:p164","canonicalEntityId":"vndb:p164","name":"ROOT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:169925:v3666","source