{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7764","model":{"presentationWorkId":"vndb:v396","staff":{"artwork":[{"creditedName":"まめ","creatorId":"vndb:s4449","sourcePersonId":"egs:creator:389","canonicalEntityId":"vndb:s4449","name":"まめ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:18242","source":"egs"}],"scenario":[{"creditedName":"日高真一","creatorId":"vndb:s8035","sourcePersonId":"egs:creator:238","canonicalEntityId":"vndb:s8035","name":"日高真一","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:18243","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c23737","characterName":"上泉 茜","sourceIds":{"bangumi":[{"characterId":"142439","match":"exact-normalized-name-in-linked-work","subjectId":"172046"},{"characterId":"142439","match":"exact-normalized-name-in-linked-work","subjectId":"174543"}],"egsCharacterIds":["3625"],"vndbCharacterId":"c23737"},"originalCharacterName":"上泉 茜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"※初代「野外学習」のヒロイン。"},{"spoiler":false,"text":"学校も学年も違うが里子の頼みで今回の行事に参加することに。"},{"spoiler":false,"text":"容姿、成績共に優秀、面倒見も良いお姉さん的存在。"},{"spoiler":false,"text":"なんでも現在彼氏募集中につき性欲が増しているのだとか。"}],"source":"egs","sourceCharacterId":"3625","sourceWorkId":"16299","spoiler":false},{"segments":[{"spoiler":false,"text":"一作目からの出演。"},{"spoiler":false,"text":"明るくて男女とわず人気のある、優しい女の子。"},{"spoiler":false,"text":"隣のおねえさん的な面倒見のよさが炸裂。"},{"spoiler":false,"text":"鼎のことを気にかけ、何かと声をかけてくれる。"}],"source":"egs","sourceCharacterId":"3625","sourceWorkId":"19990","spoiler":false},{"segments":[{"spoiler":false,"text":"巧のクラスメイト。"},{"spoiler":false,"text":"いまいちクラスに馴染めない巧を、「野外学習」に