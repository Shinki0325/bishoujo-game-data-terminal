{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"4494","model":{"presentationWorkId":"vndb:v5072","staff":{"artwork":[{"creditedName":"しけー","creatorId":"vndb:s6613","sourcePersonId":"egs:creator:1710","canonicalEntityId":"vndb:s6613","name":"しけー","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6413","source":"egs"},{"creditedName":"ことぶきはじめ","creatorId":"vndb:s5180","sourcePersonId":"egs:creator:1885","canonicalEntityId":"vndb:s5180","name":"ことぶきはじめ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6414","source":"egs"},{"creditedName":"ぺこ(かにビーム)","creatorId":"vndb:s1235","sourcePersonId":"egs:creator:1886","canonicalEntityId":"vndb:s1235","name":"ぺこ(かにビーム)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6415","source":"egs"}],"scenario":[{"creditedName":"北側寒囲","creatorId":"vndb:s1415","sourcePersonId":"egs:creator:328","canonicalEntityId":"vndb:s1415","name":"北側寒囲","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6416","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c189","characterName":"橘 沙紀","sourceIds":{"vndbCharacterId":"c189"},"originalCharacterName":"橘 沙紀","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cousin of Tachibana Yuuji. She lives in Hokkaido, a wintery region of Japan, with her dad at a closed-down inn."},{"spoiler":false,"text":"She is a classic tsundere much to the woe of Yuuji. She is good at cooking as well as cleaning and shoveling snow, also has her own patent elbow drop."},{"spoiler":true,"text":"She first met Yuuji during her childhood at a family member's wedding in the local shrine."}],"source":"vndb","sourceCharacterId":"c189"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d38e5d07ff8abc57f5fe2027341be558673765fc90946f3331e220aaa4a645f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30ded035bde2cf26750474bfd9095b9d4c8816639c324aecaf07073df021d292.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30487","source":"vndb"}]},{"characterId":"char_vndb_c22211","characterName":"橘 裕志","sourceIds":{"vndbCharacterId":"c22211"},"originalCharacterName":"橘 裕志","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuji's parents had to leave suddenly for Hawaii on a business transfer so it was arranged by Yuuji's father that he should move to Hokkaido to live with his uncle Takeaki and cousin Saki. For Yuuji, who led an urban lifestyle in Tokyo for so long, the new kind of life in the wintry countryside of Hokkaido might prove to be difficult. What awaits Yuuji at his new residence are sleepless mornings, new friendships, new love interests, and lots of snow shoveling."},{"spoiler":true,"text":"He is the direct descendent of the woman who planted the snow sakura tree."}],"source":"vndb","sourceCharacterId":"c22211"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2df36acd28c842887e824c05fee19a3547ed291af47f07d1a3e591b151839013.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/396d16d5e7d75fcaf33108baf77db9649139646619e70a81a45269dc2113c258.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2486","characterName":"吉岡 奈美","sourceIds":{"vndbCharacterId":"c2486"},"originalCharacterName":"吉岡 奈美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Physique: Smooth and flat childlike form."},{"spoiler":false,"text":"Hobbies: Reading shoujo manga (aimed at young teenagers) with passion and mail ordering (as there are no stores nearby, with focus primarily on cute accessories and clothes)"},{"spoiler":false,"text":"Skills: Karaoke and artistic gymnastics. Also jabbing her moron of a brother."},{"spoiler":false,"text":"Weaknesses: Boredom and her mother (a ryokan hostess with an overbearing attitude, she's powerless before her.)"},{"spoiler":false,"text":"She is the protagonist's junior and a first-year student. She is Toshiaki's sister and also good friends with Jun and Shinobu."},{"spoiler":false,"text":"Her family home is a resort ryokan run by her parents, located in Matsukawaooshima along her residence."},{"spoiler":false,"text":"* Except for Yoshioka siblings, everyone lives in Futabajima."},{"spoiler":false,"text":"Though sick of the hectic everyday of helping out with her parents' fairly popular place, she has never been to the mainland outside of school trips."},{"spoiler":false,"text":"\"One day, a prince will...\""},{"spoiler":false,"text":"She only dreams that someone takes her away from this island. Her brother Toshiaki is a typical otaku whose worthlessness further fuels her high ideals. Meanwhile, she seems to admire something about the relatively decent protagonist."},{"spoiler":false,"text":"Translated in part from the official site and in part from Gyutto"}],"source":"vndb","sourceCharacterId":"c2486"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90de1db743be8ed074271cdabd37a2f39cb17db21a8fbe401f909e5f9291dc62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f2db520b440d3a022ac090ac23198fce164149a2b8ea6341ce06b68a0c58f9d.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 まひる","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30488","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p19","sourceCompanyId":"egs:brand:190","canonicalEntityId":"vndb:p19","name":"D.O.(ディーオー)","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:4494:190","source":"egs"},{"companyId":"vndb:p19","sourceCompanyId":"vndb:p19","canonicalEntityId":"vndb:p19","name":"株式会社ディーオー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11342:v5072","source":"vndb"},{"companyId":"vndb:p19","sourceCompanyId":"vndb:p19","canonicalEntityId":"vndb:p19","name":"株式会社ディーオー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:42547:v5072","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
