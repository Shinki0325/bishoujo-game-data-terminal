nId":"vndb:vn-staff:46925","source":"vndb"}],"other":[{"creditedName":"Rita(理多)","creatorId":"vndb:s102","sourcePersonId":"egs:creator:5819","canonicalEntityId":"vndb:s102","name":"Rita(理多)","detail":"OP曲「千年の絆」、ED曲「ずっとふたりだから」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:145287","source":"egs"},{"creditedName":"宮村優","creatorId":"vndb:s973","sourcePersonId":"egs:creator:567","canonicalEntityId":"vndb:s973","name":"宮村優","detail":"監督","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84120","source":"egs"},{"creditedName":"理多","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:46918","source":"vndb"},{"creditedName":"村上 水軍","creatorId":"vndb:s651","sourcePersonId":"vndb:s651","canonicalEntityId":"vndb:s651","name":"村上 星児","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:46919","source":"vndb"},{"creditedName":"宮村 優","creatorId":"vndb:s973","sourcePersonId":"vndb:s973","canonicalEntityId":"vndb:s973","name":"宮村 優","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:46922","source":"vndb"},{"creditedName":"宮村 優","creatorId":"vndb:s973","sourcePersonId":"vndb:s973","canonicalEntityId":"vndb:s973","name":"宮村 優","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46923","source":"vndb"}]},"cast":[{"characterId":"char_c36556","characterName":"六條院 咲夜","sourceIds":{"bangumi":[{"characterId":"11674","match":"exact-normalized-name-in-linked-work","subjectId":"12906"}],"egsCharacterIds":["13607"],"vndbCharacterId":"c36556"},"originalCharacterName":"六條院 咲夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"魔界のプリンセスにして、次期女王の魔神。"},{"spoiler":false,"text":"即位に際して結婚を義務づけられているため、前世の恋人の生まれ変わりを旦那様として、迎えに来る。"},{"spoiler":false,"text":"強引な手段を好まない彼女は、前世うんぬんの話はせず、1から恋人としての関係を構築しようとする。"},{"spoiler":false,"text":"気高く、品性溢れるお姫様的性格。"},{"spoiler":false,"text":"強引なやり方を嫌い、どうすればよりエレガントかということに重きを置いてる。"},{"spoiler":false,"text":"ゴールを目指すにしても、ただ早くそこへ向かうのではなく、道中の景色を楽しむ……"},{"spoiler":false,"text":"結果はもちろんだが、過程を非常に大切にするタイプ。"}],"source":"egs","sourceCharacterId":"13607","sourceWorkId":"13579","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的女主角，魔界公主，也是即将成为下任女王的魔神。"},{"spoiler":false,"text":"在即位之际，为履行结婚的义务，来到人间界迎接已经转世的前世恋人。"},{"spoiler":false,"text":"不喜欢强硬的手段，也不想对前世说这说那，本人只想从头开始构筑恋人的关系。"},{"spoiler":false,"text":"高贵典雅，有着名符其实的公主性格。"},{"spoiler":false,"text":"因为讨厌强硬的作法，就算无从下手，她还是会保持优雅的行动方针。"},{"spoiler":false,"text":"虽然期望实现目标，但也并不急于前往，依旧尽情享受着途中的乐趣，是那种重视结果也懂得珍惜过程的类型。"}],"source":"bangumi","sourceCharacterId":"11674"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"13607","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"13607","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"13607","sourceWorkId":"13579","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5172a88ed114c832ee8d21a98b6c43190968069293edaf3d509c8d5aa885245.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74c19d05d6dac5a706760ab4383ddb7c551c721aae3edb9b3fd7401f50984257.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12906:11674:4956:1","source":"bangumi"}]},{"characterId":"char_c36557","characterName":"輝夜","sourceIds":{"bangumi":[{"characterId":"11680","match":"exact-normalized-name-in-linked-work","subjectId":"12906"}],"egsCharacterIds":["13614"],"vndbCharacterId":"c36557"},"originalCharacterName":"輝夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sakuya's older sister."}],"source":"vndb","sourceCharacterId":"c36557"},{"segments":[{"spoiler":false,"text":"咲夜の姉で同じく魔神。"},{"spoiler":false,"text":"次期女王候補であったが、跡目争いの際に咲夜に破れ、人間界に鬼として1000年もの間封印されてしまう。"},{"spoiler":false,"text":"長らく封印されていたが、咲夜の魔力を感じ取り眠りから覚め、封印を解こうと画策する。"},{"spoiler":false,"text":"その際に様々な事件が起きる事となる。"},{"spoiler":false,"text":"王家に生まれただけあり、その魔力は絶大。"},{"spoiler":false,"text":"単純なパワー勝負なら妹である咲夜を軽く凌駕する。"},{"spoiler":false,"text":"ただし、難しいことが苦手な輝夜は、その溢れ出す魔力を単純な事にしか使わない。"},{"spoiler":false,"text":"面白おかしく暮らすのが信条で、これまで好き勝手生きてきたため、誰かに興味を示したことがない。"}],"source":"egs","sourceCharacterId":"13614","sourceWorkId":"13579","spoiler":false},{"segments":[{"spoiler":false,"text":"咲夜的姐姐，同样也是魔神。"},{"spoiler":false,"text":"为了继承下任王位而和咲夜反目成仇，在人间界被当作恶鬼封印了足足1000年。"},{"spoiler":false,"text":"虽然被封印着，还是能感觉到咲夜的魔力，一心策划着要解除封印。"},{"spoiler":false,"text":"就此引发了各种各样的事件。"},{"spoiler":false,"text":"就算是在王族中，她的魔力也是首屈一指的。如果单纯以魔力决胜负的话，她能够轻易凌驾于妹妹咲夜。"},{"spoiler":false,"text":"然而，因头脑比较简单，她那强大的魔力也就只是用在一些简单事情上而已。"},{"spoiler":false,"text":"以过上有趣搞笑的生活为信条，至今都是随性地生活着，对谁都一副没兴趣的样子。"}],"source":"bangumi","sourceCharacterId":"11680"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"13614","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"13614","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"13614","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"13614","sourceWorkId":"13579","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"height":[{"comparisonValue":"168","source":"vndb","sourceCharacterId":"c36557","value":"168"},{"comparisonValue":"168","scope":"sourceWork","source":"egs","sourceCharacterId":"13614","sourceWorkId":"13579","value":"168"},{"comparisonValue":"163","source":"bangumi","sourceCharacterId":"11680","value":"163cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01801544449dada3ac873dc25b26c6c32363a73eef811710c2524935273bf56d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d8be5bd0caaab2bcd14255db4ba12f341f0e686edb61180094021299fbb1da4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12906:11680:4832:1","source":"bangumi"}]},{"characterId":"char_c36558","characterName":"弥栄坂 日美子","sourceIds":{"bangumi":[{"characterId":"11676","match":"exact-normalized-name-in-linked-work","subjectId":"12906"}],"egsCharacterIds":["13608"],"vndbCharacterId":"c36558"},"originalCharacterName":"弥栄坂 日美子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼なじみであり、封鬼学園の学園長の孫。そして巫女さん。"},{"spoiler":false,"text":"幼少時よりから高い霊力を持ち、学園では特別クラスに所属する。"},{"spoiler":false,"text":"主人公が唯一女を意識しない相手というか、妹にしか見られていないが、本人は気づかない。"},{"spoiler":false,"text":"また、暴走する主人公を止めようと何度も試みるが、逆に騒動に巻き込まれてしまうといった巻き込まれ型のヒロイン。"},{"spoiler":false,"text":"家事全般が得意で、非常に気が利く、お嫁さんにしたいキャラNO.1。"},{"spoiler":false,"text":"少々ヤキモチ焼きではあるが、争いごとなど好まなく、強い語気で喋ることも滅多にない。"},{"spoiler":false,"text":"が、責任感は誰よりも強く、シッカリ芯の通った女の子。"}],"source":"egs","sourceCharacterId":"13608","sourceWorkId":"13579","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的青梅竹马，封鬼学园校长的孙女，同时也是巫女。"},{"spoiler":false,"text":"从小就拥有相当高的灵力，在学园里隶属特别班级。"},{"spoiler":false,"text":"是唯一不被主人公当女生看的女生，或许只是当作单纯的妹妹来看待，但他本人并没有察觉。"},{"spoiler":false,"text":"经常都会试着去阻止暴走后的主人公，虽说也经常都反倒被卷入混乱中。"},{"spoiler":false,"text":"家务万能，简直就到了强人的地步，堪称最想娶回家当老婆的角色NO.1."},{"spoiler":false,"text":"稍稍有点爱争风吃醋，但并不喜欢争强好胜，语气强硬的话基本上是不会有的。责任感却比谁都要强，是很可靠的女孩子。"}],"source":"bangumi","sourceCharacterId":"11676"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"13608","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"13608","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"13608","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"13608","sourceWorkId":"13579","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b388848f588179a226b49483c6da81e9cbbbc473e3961393ceffcab55a1964a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7a09103d2eeed2b7d76aa1fb7e696cb3ffc918dff004243c52004ca6e0e7dea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12906:11676:4646:1","source":"bangumi"}]},{"characterId":"char_c36559","characterName":"薔薇姫","sourceIds":{"bangumi":[{"characterId":"11679","match":"exact-normalized-name-in-linked-work","subjectId":"12906"}],"egsCharacterIds":["13611"],"vndbCharacterId":"c36559"},"originalCharacterName":"薔薇姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"特別クラスの一員であり、トップクラスの霊力を持つ先輩。"},{"spoiler":false,"text":"成績優秀、生活態度も折り紙付きということから、封鬼学園の生徒会長的ポジションに就いている。"},{"spoiler":false,"text":"彼女の別名は『薔薇姫』。"},{"spoiler":false,"text":"基本的に怒らせなければ、この上ないほど完璧な女性であるが、残念なことに、彼女の沸点は、非常に低い。"},{"spoiler":false,"text":"その為、類い希なる美貌を持ちつつも、異性が寄りつかない。"},{"spoiler":false,"text":"よって、いまだ誰かと付き合った経験はなし。"},{"spoiler":false,"text":"実家は老舗の呉服問屋であり、3人姉妹の次女。"},{"spoiler":false,"text":"華道茶道日舞に琴と多芸。"}],"source":"egs","sourceCharacterId":"13611","sourceWorkId":"13579","spoiler":false},{"segments":[{"spoiler":false,"text":"特别班级的一员，是拥有最顶级灵力的前辈。"},{"spoiler":false,"text":"成绩优秀，加之生活态度也是公认的完美，担任着封鬼学园的学生会长。"},{"spoiler":false,"text":"别名是『蔷薇姫』。"},{"spoiler":false,"text":"基本上只要不发怒的话绝对称得上是毫无瑕疵的完美女性，遗憾的是，她的沸点实在太低。"},{"spoiler":false,"text":"就因为这样，虽然有着出众的美貌，男性还是敬而远之中。目前也还没有和人交往的经验。"},{"spoiler":false,"text":"老家是历史悠久的和服批发商，她在3姐妹中排行第二。插花、茶道、日本舞，弹琴等都很精通，是个多才多艺的少女。"}],"source":"bangumi","sourceCharacterId":"11679"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"13611","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"13611","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"13611","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"13611","sourceWorkId":"13579","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/501ef09d8664308ff11b93147d328e43afab86fd0dc11e6a024af9f4392c0bc3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78b59c283eddbcb5c600521bedc33ecc6e31c9ef366f362f7eac3ef220d33644.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ミルノ純","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12906:11679:6167:1","source":"bangumi"}]},{"characterId":"char_c36560","characterName":"仲條 紗穂","sourceIds":{"bangumi":[{"characterId":"11678","match":"exact-normalized-name-in-linked-work","subjectId":"12906"}],"egsCharacterIds":["13610"],"vndbCharacterId":"c36560"},"originalCharacterName":"仲條 紗穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"普通科の先輩にして、女子剣道部の部長。"},{"spoiler":false,"text":"誰から見てもわかるぐらいの主人公への熱烈アタックに、当の主人公は「そこまで熱烈に思いをぶつけられると……」と、思わず逃げ腰になってしまっている。"},{"spoiler":false,"text":"良くも悪くも一途で融通が利かず、周囲が見えなくなる人。"},{"spoiler":false,"text":"思い込んだらとにかく突っ走ってしまう。"},{"spoiler":false,"text":"普段の彼女は、生真面目でシッカリした頼りになる先輩だが、恋愛ごとに関しては、ひがみっぽく、嫉妬深く、かつ疑り深い束縛系。"},{"spoiler":false,"text":"自分だけを見てくれないと満足せず、その不満は相手にではなく、その周囲にいる人間に向けられる。"},{"spoiler":false,"text":"ちょっとヤンデレ気質なので、近づかない方が身のタメ。"}],"source":"egs","sourceCharacterId":"13610","sourceWorkId":"13579","spoiler":false},{"segments":[{"spoiler":false,"text":"普通的前辈，女子剑道部的部长。"},{"spoiler":false,"text":"对主人公展开的攻势已经到了是人都看得出来的地步，就连当事人的主人公都不禁认为「有必要强烈到这地步吗，要是被逮到的话……」，也因此每次都二话不说马上闪人。"},{"spoiler":false,"text":"好事坏事都会一根筋干到底，不懂随机应变，是会无视周围一切的人。想干的话就会先行动再考虑。"},{"spoiler":false,"text":"平常的话倒也是个一本正经值得依赖的前辈，只是一跟恋爱的事扯上关系，就会变得爱闹别扭、爱争风吃醋、疑心重重。"},{"spoiler":false,"text":"希望对方只看着自己，不然就老是不满足，而且那不满不仅局限于对方，还会波及到周围的人。"},{"spoiler":false,"text":"稍微有点病娇属性，跟她保持距离会更有人身安全。"}],"source":"bangumi","sourceCharacterId":"11678"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"13610","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"13610","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"13610","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"13610","sourceWorkId":"13579","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fb02d8dedbc42f0442069ccc9932f9c94fbdb1269124b9c2f31281302c46fa0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/1030acd4bd9cb57f4eb352fd2d19d69f6cef130cfe01ed6fe8a386d548abef61.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12906:11678:6166:1","source":"bangumi"}]},{"characterId":"char_c36561","characterName":"菜ノ花 深影","sourceIds":{"bangumi":[{"characterId":"11677","match":"exact-normalized-name-in-linked-work","subjectId":"12906"}],"egsCharacterIds":["13609"],"vndbCharacterId":"c36561"},"originalCharacterName":"菜ノ花 深影","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"67"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスの担任。"},{"spoiler":false,"text":"小学生と見間違うかのような外見で、かなりのドジっ娘。"},{"spoiler":false,"text":"普段はぽややんとしているが、地味に毒を吐いたりもする。"},{"spoiler":false,"text":"基本的にいい人なのだが、案外執念深く、いつまでもされたことを覚えていたりする。"},{"spoiler":false,"text":"どこからどう見ても小学生な風貌。背は小さく胸は真っ平ら。"},{"spoiler":false,"text":"顔は幼さが残り可愛らしく、クリクリした大きな瞳が印象的。"},{"spoiler":false,"text":"全体的な雰囲気は子犬を連想させる。"},{"spoiler":false,"text":"幼い外見に反して、かなりの酒豪でありザル。"},{"spoiler":false,"text":"外見どおりやっぱり処女。"}],"source":"egs","sourceCharacterId":"13609","sourceWorkId":"13579","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公所在班级的班主任。"},{"spoiler":false,"text":"一眼看过去绝对会让人错以为是小学生，相当的天然呆。"},{"spoiler":false,"text":"平时基本上是乖乖女形象，但偶尔也会展露毒舌的一面。也算是个老好人，意外地很固执，无论何时都会记得被欺负的事。"},{"spoiler":false,"text":"从哪个角度看都只会是小学生。"},{"spoiler":false,"text":"长得不高，胸部也还是飞机场，脸蛋也是惹人爱的童颜，闪闪发光的大眼睛实在让人印象深刻。"},{"spoiler":false,"text":"就各个方面都会让人联想到可爱的小狗，然而，跟外表相反的是，其实她是个大酒鬼。"},{"spoiler":false,"text":"如外表所见依旧是少女身。"}],"source":"bangumi","sourceCharacterId":"11677"}],"profileFacts":[{"label":"胸围（本版本）","value":"67 cm","valueContext":null,"source":"egs","sourceCharacterId":"13609","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"13609","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"13609","sourceWorkId":"13579","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"13609","sourceWorkId":"13579","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bac7c401d256b2f9f7