s":[{"segments":[{"spoiler":false,"text":"【日々のナタを探す学生マンガ家】"},{"spoiler":false,"text":"学生にしてすでにプロの漫画家。"},{"spoiler":false,"text":"何事にも物怖じしないサバサバとした性格。"},{"spoiler":false,"text":"日々ネタ探しに追われる彼女の今の興味の対象は、主人公？"}],"source":"egs","sourceCharacterId":"9222","sourceWorkId":"16335","spoiler":false},{"segments":[{"spoiler":false,"text":"虽然是学生但已经是专业的漫画家。"},{"spoiler":false,"text":"对任何事情都毫不畏惧的爽快的性格。"},{"spoiler":false,"text":"每天都在寻找题材的她，现在感兴趣的对象，是主人公？"}],"source":"bangumi","sourceCharacterId":"16087"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/718b959bc69bbe3f905a23dab53fe7bfc081daf3a0d415dfb5e72e791e24eb9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/370b03413eab74032282a064ec4d50eea067b15e6b112377faea7623d3bb520c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水霧けいと","creatorId":"vndb:s955","sourcePersonId":"vndb:s955","canonicalEntityId":"vndb:s955","name":"水桐 けいと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27515:16087:6173:1","source":"bangumi"}]},{"characterId":"char_c25719","characterName":"みくりん","sourceIds":{"bangumi":[{"characterId":"16088","match":"exact-normalized-name-in-linked-work","subjectId":"27515"}],"egsCharacterIds":["9223"],"vndbCharacterId":"c25719"},"originalCharacterName":"みくりん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【内気でもの静かな転入生】"},{"spoiler":false,"text":"主人公と一緒に転入してきた少女。"},{"spoiler":false,"text":"美人なのに引っ込み思案。"},{"spoiler":false,"text":"あまり自分を表現することが得意ではないので、クラスに馴染めずにいる。"}],"source":"egs","sourceCharacterId":"9223","sourceWorkId":"16335","spoiler":false},{"segments":[{"spoiler":false,"text":"和主人公一起转校进