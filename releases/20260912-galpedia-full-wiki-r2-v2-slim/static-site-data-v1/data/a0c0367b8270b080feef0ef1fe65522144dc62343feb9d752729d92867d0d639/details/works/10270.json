edName":"神瀬 あから","creatorId":"vndb:s11136","sourcePersonId":"vndb:s11136","canonicalEntityId":"vndb:s11136","name":"神瀬 あから","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58615","source":"vndb"},{"creditedName":"伊庭 尚康","creatorId":"vndb:s12849","sourcePersonId":"vndb:s12849","canonicalEntityId":"vndb:s12849","name":"伊庭 尚康","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58616","source":"vndb"},{"creditedName":"sui","creatorId":"vndb:s19257","sourcePersonId":"vndb:s19257","canonicalEntityId":"vndb:s19257","name":"sui","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58618","source":"vndb"},{"creditedName":"MeeK","creatorId":"vndb:s35139","sourcePersonId":"vndb:s35139","canonicalEntityId":"vndb:s35139","name":"MeeK","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58619","source":"vndb"}]},"cast":[{"characterId":"char_c30962","characterName":"若槻 新菜","sourceIds":{"bangumi":[{"characterId":"42852","match":"exact-normalized-name-in-linked-work","subjectId":"185781"}],"egsCharacterIds":["18950"],"vndbCharacterId":"c30962"},"originalCharacterName":"若槻 新菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公との関係は、年上の幼馴染、新妻、そして担任の教師。"},{"spoiler":false,"text":"子供の頃に主人公と結婚の約束をしていたことから、主人公が学生という身分に関わらず、やや強引に結婚し、夫婦となる。"},{"spoiler":false,"text":"学校では美人教師として男子学生らの憧れの存在。"},{"spoiler":false,"text":"家柄が良かったせいか、真面目でお堅いところがあり、風紀にうるさく、生活指導も厳しい。"},{"spoiler":false,"text":"結婚してから主人公に対する態度が急変し、学校でスパルタ教育、家ではベタ甘え妻の両極端な顔を見せるようになった。"}],"source":"egs","sourceCharacterId":"18950","sourceWorkId":"10270","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスの担任教師。担当教科は数学。主人公とは年上の幼馴染の関係。子供のころに結婚の約束をしていて、少々強引ながらも晴れて結婚。美人女教師として校内では有名で、憧れの先生として生徒に人気がある。家柄が良いせいか頭が固い部分があり、時々、厳しく指導をするのが玉にキズ。"},{"spoiler":false,"text":"主人公にとって真面目な女教師兼優しいお姉さんだったが、結婚を境に激変。スパルタ教育者とベタ甘え新妻という極端な面をぶつけ始める。"}],"source":"bangumi","sourceCharacterId":"42852"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/daa4f36c92203e63c8e3318a3fb69c623dd55b37918edc6095ca2a33f937500a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/844a34c2fb29c887dd54a2725257cb4885bb61775042bfd07f23caf859787602.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185781:42852:5906:1","source":"bangumi"}]},{"characterId":"char_c30963","characterName":"若槻 真冬","sourceIds":{"bangumi":[{"characterId":"42853","match":"exact-normalized-name-in-linked-work","subjectId":"185781"}],"egsCharacterIds":["18951"],"vndbCharacterId":"c30963"},"originalCharacterName":"若槻 真冬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公との関係は、同い年の幼馴染、新菜の妹、同級生。"},{"spoiler":false,"text":"学生結婚はリスクが高いと主人公と姉の結婚には反対していた。"},{"spoiler":false,"text":"主人公と姉が結婚した現在も反対の姿勢は変わらず、主人公にはきつくあたっている。"},{"spoiler":false,"text":"主人公を誘惑し、姉と離婚させようと目論んでいるようだが……。"}],"source":"egs","sourceCharacterId":"18951","sourceWorkId":"10270","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生にして、新菜の妹。姉同様、主人公とは幼馴染の間柄。"},{"spoiler":false,"text":"学生結婚は姉にリスクが高いため、唯1人ずっと反対をしていた。今でも反対していて、口を開けば主人公にきつくあたっている。"},{"spoiler":false,"text":"どうにかして離婚させたくてたまらないが、姉に迷惑をかけたくない為にこれといったことはできないでいる。あることをきっかけに、主人公を誘惑することで離婚させようと企むことに。"}],"source":"bangumi","sourceCharacterId":"42853"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/989b68ce5f54800adb49dbc366c83368b14649e84917846d6435a071e803fcb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee6a01d0175358ce2e444efc24404e58471517380592a56e45c7a10f3cc053de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野梨沙","creatorId":"vndb:s1610","sourcePersonId":"vndb:s1610","canonicalEntityId":"vndb:s1610","name":"雪野 梨沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185781:42853:5903:1","source":"bangumi"}]},{"characterId":"char_c30964","characterName":"手嶋 五穂","sourceIds":{"bangumi":[{"characterId":"42854","match":"exact-normalized-name-in-linked-work","subjectId":"185781"}],"egsCharacterIds":["18952"],"vndbCharacterId":"c30964"},"originalCharacterName":"手嶋 五穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の通う学校の養護教諭。快楽主義者。"},{"spoiler":false,"text":"新菜は大学時代からの親友で、主人公とも顔見知りだが、二人が結婚していることは聞かされていない。"},{"spoiler":false,"text":"フェロモンだだ漏れのナイスバディで性格も優しいことから、男子学生の絶大な支持を得ている。"},{"spoiler":false,"text":"そこら辺も自覚しているらしく、肌の露出度の高い大胆なファッションが多い。"},{"spoiler":false,"text":"新菜に叱られ、傷心の主人公をその肉体で慰めようと……。"}],"source":"egs","sourceCharacterId":"18952","sourceWorkId":"10270","spoiler":false},{"segments":[{"spoiler":false,"text":"保健室を城にもつ養護教諭にして、新菜の大学時代からの親友。"},{"spoiler":false,"text":"主人公とも顔見知りだが、結婚のことは聞かされていない。"},{"spoiler":false,"text":"優しい性格とフェロモンたっぷりの豊満な容姿で、男子生徒から絶大な支持を得ている。本人もその辺りを自覚していて挑発的な格好をしては楽しんでいるらしい。"},{"spoiler":false,"text":"ことあるごとに生徒を誘惑しては、保健室に連れ込んでいるという噂。"},{"spoiler":false,"text":"新菜に叱られている主人公を、体で慰めようと迫ってくる。"},{"spoiler":false,"text":"気持ちよければ全てがよくなっちゃう快楽主義者。"}],"source":"bangumi","sourceCharacterId":"42854"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/941e0d401b31fa02154cf9c513986de50fec4fcae5d560dccaaaab327b27085a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50984206aaa8779aacc6e6fb1845347b1dc4d7c7f19c6a02ac23ae5371384cdd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185781:42854:6469:1","source":"bangumi"}]},{"characterId":"char_c30965","characterName":"有栖川 つゆ美","sourceIds":{"bangumi":[{"characterId":"42855","match":"exact-normalized-name-in-linked-work","subjectId":"185781"}],"egsCharacterIds":["18953"],"vndbCharacterId":"c30965"},"originalCharacterName":"有栖川 つゆ美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の通う学校の生徒会長。主人公の先輩。"},{"spoiler":false,"text":"家柄もよく、品行方正にして才色兼備なお嬢様。"},{"spoiler":false,"text":"真面目さとお嬢様らしいおしとやかさ、やや世間ズレしたところが、教師や学生たちから親しまれ、高い人気を得ている。"},{"spoiler":false,"text":"また思い込みが激しく、ふとしたきっかけで知り合った主人公を、運命の相手と思い込み、交際を申し込むが……。"}],"source":"egs","sourceCharacterId":"18953","sourceWorkId":"10270","spoiler":false},{"segments":[{"spoiler":false,"text":"才色兼備のお嬢様にして生徒会長。主人公にとっては先輩だが、面識はない。真冬とは知り合いらしい。"},{"spoiler":false,"text":"家柄や容姿を鼻にかけず、何事にも自分が率先して取り組むような品行方正の人。"},{"spoiler":false,"text":"よく1人で校内の見回りをしては、掲示物や備品の点検をしている。そんな真面目さやお嬢様らしいおしとやかさ、ちょっと世間ズレしたところも含めて、生徒達から高い人気と信頼を誇っている。"},{"spoiler":false,"text":"ふとしたきっかけで知り合った主人公を、運命の相手として衆人環視の中で告白してしまう。思い込みの激しいタイプ？"}],"sou