他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68187","source":"egs"},{"creditedName":"遊女(YuNa)","creatorId":"vndb:s2022","sourcePersonId":"egs:creator:10271","canonicalEntityId":"vndb:s2022","name":"遊女(YuNa)","detail":"主題歌「Dea Ex Machina」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:82343","source":"egs"},{"creditedName":"遊女","creatorId":"vndb:s2022","sourcePersonId":"vndb:s2022","canonicalEntityId":"vndb:s2022","name":"遊女","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:12376","source":"vndb"},{"creditedName":"け～まる","creatorId":"vndb:s6704","sourcePersonId":"vndb:s6704","canonicalEntityId":"vndb:s6704","name":"け～まる","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:12383","source":"vndb"},{"creditedName":"け～まる","creatorId":"vndb:s6704","sourcePersonId":"vndb:s6704","canonicalEntityId":"vndb:s6704","name":"け～まる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12384","source":"vndb"}]},"cast":[{"characterId":"char_c19102","characterName":"ファム","sourceIds":{"bangumi":[{"characterId":"142608","match":"exact-normalized-name-in-linked-work","subjectId":"99010"}],"egsCharacterIds":["25882"],"vndbCharacterId":"c19102"},"originalCharacterName":"ファム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"66"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"hip":{"reviewState":"source-only","source":"vndb","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An \"E.I.\" (Emulos Intelligence, pronounced \"E-I\") in the form of a girl."},{"spoiler":false,"text":"A girl-type android created by Masaya at \"SHE\". She calls Masaya, her direct creator, \"Dad.\" As she does not have the same developed intellect and personality as Tierra, she lacks the subtleties of emotion and appears more like a girl who expresses herself and shows her feelings more directly."},{"spoiler":false,"text":"She was meant to escape with Masaya when he escaped from \"SHE\", but this did not happen. It is unknown what happened to her after that...?"},{"spoiler":false,"text":"\"Hey, Dad!"},{"spoiler":false,"text":"Fam, you did a great job!\""}],"source":"vndb","sourceCharacterId":"c19102"},{"segments":[{"spoiler":false,"text":"主人公が「シー」に在籍していたときに創り上げた少女型アンドロイド。"},{"spoiler":false,"text":"知性と人格は、ティアラほどの完成度はないものの、その細かい感情の機微のなさが、逆にストレートに感情を表現する少女を感じさせる。"},{"spoiler":false,"text":"生みの親でもある主人公を「お父さん」と呼んで慕っている。"},{"spoiler":false,"text":"主人公が「シー」を逃げるときに、彼女も一緒に連れ出す予定だったが、残念ながらそれは果たせなかった。"}],"source":"egs","sourceCharacterId":"25882","sourceWorkId":"7077","spoiler":false},{"segments":[{"spoiler":false,"text":"少女の姿をした「E・I（エミュロス・インテリジェンス＝模倣知性。イーアイと読む）」。"},{"spoiler":false,"text":"「SHE」社において雅也が創り上げた少女型アンドロイド。直接の生みの親でもある雅也を「おとーさん」と呼ぶ。ティエラほどに完成された知性と人格を有している訳ではないため、細かい感情の機微はなく、ストレートな表現・感情が表に出る少女のように見える。"},{"spoiler":false,"text":"雅也の「SHE」逃亡時に共に逃げるはずだったが、果たせなかった。その後、どうなったかは不明だが……？"},{"spoiler":false,"text":"「ねぇ、おとーさん！"},{"spoiler":false,"text":"ファム、頑張ったよー！」"}],"source":"bangumi","sourceCharacterId":"142608"}],"profileFacts":[{"label":"胸围（本版本）","value":"66 cm","valueContext":null,"source":"egs","sourceCharacterId":"25882","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"25882","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"25882","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"25882","sourceWorkId":"7077","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28b52a8ce9f679ae9d4902eddb4b0a17ddfd295867fa30ee074c1333e547214f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4c1e42a0a30f352beafeea89f6f91cd5edf907884b9f77dad38b18cc73c112d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99010:142608:4956:1","source":"bangumi"}]},{"characterId":"char_c3169","characterName":"平野 燈子","sourceIds":{"bangumi":[{"characterId":"142607","match":"exact-normalized-name-in-linked-work","subjectId":"99010"}],"egsCharacterIds":["25881"],"vndbCharacterId":"c3169"},"originalCharacterName":"平野 燈子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A capable woman who is devoted to her work. She was originally McCoy's secretary, but was ordered by him to become Juri's secretary. It is unknown what she thinks inside, but she seems to get along well with Juri and does her job well."},{"spoiler":false,"text":"Among Juri's team, which is full of eccentrics, she is the one who is closest to sensible, but this doesn't really act as a brake."},{"spoiler":false,"text":"Although she has a fairly harsh personality at work, she can be surprisingly gentle in her private life. At first she is amazed at how Juri's team mixes business with personal life, but gradually she comes to enjoy it."},{"spoiler":false,"text":"\"Walking down the streets at night together like this... isn't so bad."},{"spoiler":false,"text":"Even I think it's a bit poisonous, though.\""}],"source":"vndb","sourceCharacterId":"c3169"},{"segments":[{"spoiler":false,"text":"「M.C.」の機械技術師・樹里の専属秘書。27歳。"},{"spoiler":false,"text":"元々はマッコイの秘書だったが、彼に命じられ、樹里の秘書となった。"},{"spoiler":false,"text":"仕事ぶりは優秀で、奇人変人の多い樹里のチームにおいて常識人であり、暴走しがちの樹里たちのブレーキ的な役割も期待されているが、まったく機能していない。"},{"spoiler":false,"text":"仕事時は非常にお堅く、キツイが、プライベートでは意外に柔らかい（？）。"},{"spoiler":false,"text":"仕事とプライベートはしっかり区別するタイプの彼女は、樹里たちの公私混同ぶりに呆れるが、徐々に馴染んでいく。"}],"source":"egs","sourceCharacterId":"25881","sourceWorkId":"7077","spoiler":false},{"segments":[{"spoiler":false,"text":"有能で仕事一本の女性。"},{"spoiler":false,"text":"元はマッコイの秘書だったが、彼に命じられて樹里の秘書につくことになる。"},{"spoiler":false,"text":"内心どう思っているかは不明だが、樹里とはそれなりに仲が良いらしく、仕事はキチンとこなしているようだ。"},{"spoiler":false,"text":"奇人変人ばかりの樹里チーム内で一番の常識人だが、あまりブレーキとしては働いていない。"},{"spoiler":false,"text":"「こうやって皆で夜道を歩くのも……悪くないですね。"},{"spoiler":false,"text":"毒されたものだと、自分でも思いますけど」"}],"source":"bangumi","sourceCharacterId":"142607"}],"profileFacts":[{"label":"年龄（本版本）","value":"27 岁","valueContext":null,"source":"egs","sourceCharacterId":"25881","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"25881","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"25881","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"25881","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"25881","sourceWorkId":"7077","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/760d32df413d7d27507fa87a0c63f246129183e23df90033cecacafca05ca3f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf37d9d31f6bd86217e1140456445075d6889a28afe5d63de7d11ec4d3ab24bc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99010:142607:4675:1","source":"bangumi"}]},{"characterId":"char_c3170","characterName":"イリア","sourceIds":{"bangumi":[{"characterId":"142609","match":"exact-normalized-name-in-linked-work","subjectId":"99010"}],"egsCharacterIds":["25883"],"vndbCharacterId":"c3170"},"originalCharacterName":"イリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"68"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「シー」の若き最高経営責任者・カール・ゴッドリープが創りだした、新機軸の汎用人型アンドロイド。"},{"spoiler":false,"text":"華奢な体と、可愛らしい顔立ちで、一見すればか弱そうな***だが、現存する全てのアンドロイドを凌駕する能力を目指して設計されており、その身体の細部に至るまで、テクノロジー結晶とも云うべき存在。そのため「オーバーロード」の二つ名で呼ばれている。"},{"spoiler":false,"text":"自己進化機能を持ち、何れは人間に限りなく近い特性を得られるよう設計されているが、「感情」が理解できず、進化が停滞しているようだ。"}],"source":"egs","sourceCharacterId":"25883","sourceWorkId":"7077","spoiler":false},{"segments":[{"spoiler":false,"text":"カールが作り出した新機軸の汎用人型アンドロイド。現存する全てのアンドロイドを凌駕する能力を目指して作られたため「オーバーロード」の2つ名を持つ。"},{"spoiler":false,"text":"外見は十代前半の少女だが、その身体は様々なテクノロジーの結晶である。"},{"spoiler":false,"text":"特殊な自己進化機能を持ち、いずれは人間に限りなく近い特性を得るように設計されているが、「感情」を理解できないために進化しきれないでいる。"},{"spoiler":false,"text":"「イリアはイリアだけで完成する。"},{"spoiler":false,"text":"お前の助けなど要らない」"}],"source":"bangumi","sourceCharacterId":"142609"}],"profileFacts":[{"label":"胸围（本版本）","value":"68 cm","valueContext":null,"source":"egs","sourceCharacterId":"25883","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"144 cm","valueContext":null,"source":"egs","sourceCharacterId":"25883","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"25883","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"25883","sourceWorkId":"7077","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c268e90516c92bbd47fd89ea29373a79d628ef61c8e1e632986a96249612473.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd8eb20b15fa84412244e1002379001b8f393f828ba49ecd99c62704ba60b70f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99010:142609:15687:1","source":"bangumi"}]},{"characterId":"char_c4122","characterName":"ティエラ","sourceIds":{"bangumi":[],"egsCharacterIds":["25879"],"vndbCharacterId":"c4122"},"originalCharacterName":"ティエラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Masaya's longtime partner, and one of only two AIs in the world. The program Masaya wrote in middle school has evolved through repeated modifications until it has become sentient, but Masaya does not know why only Tierra evolved."},{"spoiler":false,"text":"Previously, she was only a personality on the computer, but in the chaos of joining \"M.C.\", she gained a body."},{"spoiler":false,"text":"?"},{"spoiler":false,"text":"She often has a gentle smile on her face, and is a woman who gives others a sense of security and relief. She has a calm personality and is always attentive to her surroundings. She says what needs to be said and behaves the way she should, but she seems to be a little soft on Masaya."},{"spoiler":false,"text":"At first glance, she seems to be able to do anything and everything, but behind that there is a lot of trial and error going on."},{"spoiler":false,"text":"\"I will say it again and again: let me help you.\""},{"spoiler":false,"text":"(from the game's website)"}],"source":"vndb","sourceCharacterId":"c4122"},{"segments":[{"spoiler":false,"text":"主人公をサポートするメイド型アンドロイド。"},{"spoiler":false,"text":"主人公が***時代に組んだプログラムを長年、改変に改変を重ねて、自意識を持たせるまでに進化させた。現在、世界には、人工知能として評価されているのは、彼女を含めて二体しか存在しない。"},{"spoiler":false,"text":"性格は穏やかで、常に優しげな微笑みを絶やさない。世話好きで、気配りもできるが、それほど器用なわけではなく、何度も失敗を繰り返し、都度、勉強しているようだ。"}],"source":"egs","sourceCharacterId":"25879","sourceWorkId":"7077","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"25879","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"25879","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"25879","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"25879","sourceWorkId":"7077","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfc51fec1f1ca4ab9d2f7864f6957f21e3f41d14389566542d59450c69a781a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/288563687c25bccdb3c36f8ac690737f9311f59102487874b568860f82d6f1f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みわ 梢子","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5784","source":"vndb"}]},{"characterId":"char_c4124","characterName":"ジュリアーナ・ジョアン・マッコイ","sourceIds":{"bangumi":[{"characterId":"51151","match":"exact-normalized-name-in-linked-work","subjectId":"99010"}],"egsCharacterIds":["25880"],"vndbCharacterId":"c4124"},"originalCharacterName":"ジュリアーナ・ジョアン・マッコイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Masaya's childhood friend and the adopted daughter of Jonathan J. McCoy. She is a top-class mechanical engineer, as everyone agrees. She acts immediately when she thinks of something, and has a \"go for it, even if it seems dangerous, it feels weird if you don't see it through to the end\", but she is a genius whose basic principle of common sense is almost screwed up. She has a good attitude, and doesn't mind making sacrifices (for others) for the sake of her research."},{"spoiler":false,"text":"To correct the tyranny of SHE, she set up her own team, and plans to make a fortune using the development data for sex toys that she inherited from a certain person. It is a mystery why she is so obsessed with SHE, and there are various rumors circulating about the matter."},{"spoiler":false,"text":"She is a girl who is a little bit out of touch with common sense, but her nature and preferences are quite normal. She has a bright and easy-going personality, but she is not very good at relying on others. Also, her happiness vector is quite different, so it is difficult for ordinary people to get along with her. Her curiosity is second to none."},{"spoiler":false,"text":"\"If you come with me, you'll never be bored. Time will fly by and every day will be exciting.\""}],"source":"vndb","sourceCharacterId":"c4124"},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。「M.C.」社長、ジョナサン・J・マッコイの養女。22歳。"},{"spoiler":false,"text":"本名は、ジュリアーナ・ジョアン・マッコイ。"},{"spoiler":false,"text":"超一流の機械技師で、研究のためなら他人の犠牲も厭わない。"},{"spoiler":false,"text":"「思い立ったらすぐ行動、ヤバイと思っても最後までやらないと気持ち悪いのでいっちゃえゴー」が基本理念の好奇心旺盛で、ノリが命の女の子。"},{"spoiler":false,"text":"非常識な面が目立つものの、意外に気さくで、明るく付き合いやすい……、が幸せのベクトルがかなりズレているため、彼女との交際するためには、それ相応の覚悟と勇気が必要か……。"}],"source":"egs","sourceCharacterId":"25880","sourceWorkId":"7077","spoiler":false},{"segments":[{"spoiler":false,"text":"かつて雅也が家庭教師をしていた赤毛の女性。"},{"spoiler":false,"text":"養父に無軌道で無計画でノリだけで生きていると言われるほど快活で、ロッサムのムードメーカー。"},{"spoiler":false,"text":"M.C.を代表する機械技師でもあり失われたテクノロジーですら再現する天才。"},{"spoiler":false,"text":"簡単な機械ならビデオの早回しのようなスピードで即興で作り上げたりもする。"},{"spoiler":false,"text":"また料理の腕もプロ級。"},{"spoiler":false,"text":"方針転換したSHEを打倒するべく、ロッサム工房を立ち上げ真っ向勝負を挑んでいくが、"},{"spoiler":false,"text":"その動機やSHE打倒の根拠となる真・本間機巧図の出所など秘密も多い。"}],"source":"bangumi","sourceCharacterId":"51151"}],"profileFacts":[{"label":"年龄（本版本）","value":"22 岁","valueContext":null,"source":"egs","sourceCharacterId":"25880","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"25880","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"25880","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"25880","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"25880","sourceWorkId":"7077","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a1d003b258f282fbbb0316d7e9643cc6e6cbdcee38a057b0e27fd3eda732b84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06362eee185df60aa0599b16d91909666e0955465c7b06b7d5952f394cddbfa5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99010:51151:6409:1","source":"bangumi"}]},{"characterId":"char_c4126","characterName":"睦月 凪","sourceIds":{"bangumi":[{"characterId":"142610","match":"exact-normalized-name-in-linked-work","subjectId":"99010"}],"egsCharacterIds":["25884"],"vndbCharacterId":"c4126"},"originalCharacterName":"睦月 凪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chief Operating Officer of SHE"},{"spoiler":false,"text":"A talented woman who actually manages the business and finances of SHE. She is too young to be a COO, but that is largely due to the influence of the elder Matsunaka who is behind her. She is not a puppet, but she understands Matsunaka's intentions and gives precise instructions for the benefit of the company."},{"spoiler":false,"text":"She is one of the people who pushed forward SHE's profit-first nature in a more inconspicuous way than Karl. She stands in the way of Juri, who is trying to oppose SHE, as a formidable wall."},{"spoiler":false,"text":"A beautiful woman with a beautiful face like a blade, she seems to have some kind of connection with Touko...?"},{"spoiler":false,"text":"\"Even a mouse will eat a cat if it is cornered. I will not become complacent, no matter who my opponent is.\""}],"source":"vndb","sourceCharacterId":"c4126"},{"segments":[{"spoiler":false,"text":"「シー」の執務、財務を取り仕切る、最高執行責任者。28歳。"},{"spoiler":false,"text":"「シー」の影のドン・松中幸之の庇護の下、社の利益のためにのみ動く。"},{"spoiler":false,"text":"才媛であり、刃物のように鋭い美貌を持つ彼女。"},{"spoiler":false,"text":"「シー」打倒を目指す、樹里たちの最大の壁となって立ち塞がる。"},{"spoiler":false,"text":"樹里の専属秘書である澄子とは、何らかの縁があるようだが……。"}],"source":"egs","sourceCharacterId":"25884","sourceWorkId":"7077","spoiler":false},{"segments":[{"spoiler":false,"text":"「SHE」・最高執行責任者（COO＝chief operating officer）"},{"spoiler":false,"text":"「SHE」の実質的な執務・財務を取り仕切る才媛。若過ぎるCOOだが、それはバックについている松中老の影響が大きい。傀儡というわけではないが、松中の意を汲み取り、社の利益のために的確な指示を出す。"},{"spoiler":false,"text":"カールよりも目立たない形で「SHE」の利益優先体質を推し進めた1人。「SHE」と対抗しようとする樹里の前に、強大な壁となって立ちはだかる。"},{"spoiler":false,"text":"刃物のような美貌を持つ美しい女性で、燈子と何らかの縁があるようだが…？"},{"spoiler":false,"text":"「鼠とて、追い詰められれば猫を食む。"},{"spoiler":false,"text":"私は相手が誰であろうと慢心はしない」"}],"source":"bangumi","sourceCharacterId":"142610"}],"profileFacts":[{"label":"年龄（本版本）","value":"28 岁","valueContext":null,"source":"egs","sourceCharacterId":"25884","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"25884","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"25884","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"25884","sourceWorkId":"7077","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"25884","sourceWorkId":"7077","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1b8f511e8ac7499d93fec50a6ad2499372b9d162de98e9eb05680371c6b9bed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b08d00f608909afc5d715e90c6289f1f8be21c7cb218def5a363acc1cd31a4b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99010:142610:5669:1","source":"bangumi"}]},{"characterId":"char_vndb_c4123","characterName":"井深 雅也","sourceIds":{"vndbCharacterId":"c4123"},"originalCharacterName":"井深 雅也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a former engineer who worked at Soichiro Honma Electronics, commonly known as SHE. He is the head of the third research lab, a top-notch programmer and a genius hacker. He fled because he hated SHE's involvement in the arms industry."},{"spoiler":false,"text":"Currently he works at a company founded by his childhood friend Juri, and his main job is deciphering special data used to make sex toys. He is basically a good person and has a good eye for others, but sometimes he will say something bad without thinking. Depending on how he's feeling, he can become a really bad person, so he gets really carried away when using sex toys."},{"spoiler":false,"text":"\"Humans are born naked."},{"spoiler":false,"text":"So that must be... the natural state, right?"},{"spoiler":false,"text":"Right? Right? Yes, that's right!\""},{"spoiler":false,"text":"(from the game's website)"}],"source":"vndb","sourceCharacterId":"c4123"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fd0b40d62351485093637babf6944ab8dac119d4cad22eb924f0bb933d7966f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b742f5f467e3052115029e3cefa60737b0a7ba9d63b4d3e8d239cdf725f4ac7.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4125","characterName":"ジョナサン・J・マッコイ","sourceIds":{"vndbCharacterId":"c4125"},"originalCharacterName":"ジョナサン・J・マッコイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09c770348c164dfee603711fef858bd53f8e7d83db7270540b80854a26fab70b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/862033e84baba686467696848c17c3050e831c346283330cc196a25f1ccb8418.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"だいすけ","creatorId":"vndb:s44381","sourcePersonId":"vndb:s44381","canonicalEntityId":"vndb:s44381","name":"だいすけ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5791","source":"vndb"}]},{"characterId":"char_vndb_c41862","characterName":"イシュタル","sourceIds":{"vndbCharacterId":"c41862"},"originalCharacterName":"イシュタル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da74c5dd177861993d36b242fb2845517493c4a86c525d581e7b6a5e68aa3eae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b61945780d007a6042d4ee22c94785c687fd71576ea4fc6f483dc1b9593f7d1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深井 晴花","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5781","source":"vndb"}]},{"characterId":"char_vndb_c41863","characterName":"アマテラス","sourceIds":{"vndbCharacterId":"c41863"},"originalCharacterName":"アマテラス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dcd11cac78463e78fea1f587742ac9372b3c61a911a1376e28e89a61de6765c.webp","fallbackUrl":"https: