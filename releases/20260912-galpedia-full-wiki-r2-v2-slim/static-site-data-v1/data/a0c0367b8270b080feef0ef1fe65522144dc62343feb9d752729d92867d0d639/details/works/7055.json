ource":"static-detail"},"actors":[{"creditedName":"浅野 麻理亜","creatorId":"vndb:s798","sourcePersonId":"vndb:s798","canonicalEntityId":"vndb:s798","name":"友川 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36743","source":"vndb"}]},{"characterId":"char_c2665","characterName":"手塚 咲雪","sourceIds":{"bangumi":[{"characterId":"92148","match":"exact-normalized-name-in-linked-work","subjectId":"77564"}],"egsCharacterIds":["17779"],"vndbCharacterId":"c2665"},"originalCharacterName":"手塚 咲雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小児科の専属ナースで、愛の看護学園時代の後輩。20歳。"},{"spoiler":false,"text":"子供好きで母性溢れる女性だが、何事に対しても器用ではなく、よくドジを踏んでは先輩ナースらに怒鳴られる毎日。"},{"spoiler":false,"text":"父親は事故で他界し、母親は過労で倒れ、三人の弟は育ち盛り。生活は厳しく、社会人である自分が家族を支えなくてはならない、と頑張っている。"}],"source":"egs","sourceCharacterId":"17779","sourceWorkId":"3235","spoiler":false},{"segments":[{"spoiler":false,"text":"小児科の専属ナースで、愛の看護学園時代の後輩。20歳。"},{"spoiler":false,"text":"子供好きで母性溢れる女性だが、何事に対してもドジ・グズ・ノロマで、主任に怒鳴られる毎日だが、めげずに働くがんばり屋。"},{"spoiler":false,"text":"父親は事故で他界し、母親は過労で倒れて床に伏せており、育ち盛りの三人の弟が居る。"},{"spoiler":false,"text":"生活は厳しく、社会人である自分が家族を支えなくてはならない。"},{"spoiler":false,"text":"なぜか先輩である愛を目標としており、事あるごとに意識している。"}],"source":"egs","sourceCharacterId":"17779","sourceWorkId":"11110","spoiler":false},{"segments":[{"spoiler":false,"text":"小児科の専属ナース。愛の看護学園の後輩。"},{"spoiler":false,"text":"ドジでグズなトロイ性格で、主任から良く怒られベソをかいている。子供好きで母性愛が強く、外見によらず頑張り屋。なぜか先輩である愛を目標としており、事あるごとに意識をしている。何時も人を見る時には上目使いで見る、いかにも、『イヂメテ光線』を出しているタイプ。病気で床に伏せている母とまだ小さい弟の三人で暮らしている。父親は数年前に事故で他界し、家庭を支えてきた母親も無理がたたって倒れてしまった。生活は厳しくはっきり言って貧乏。母親が働けなくなった以上、これからは社会人である自分が頑張らねばと思っている。"}],"source":"bangumi","sourceCharacterId":"92148"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1abb23641d2d2d509732585c59eb34add6ad0f8c9aa389af47aed59be2e58fc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd0ca0b64e0281cfccab84790fbca5d7aa30891c6644a8b7647784609e3b2f4c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩田 由貴","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36746","source":"vndb"}]},{"characterId":"char_c2666","characterName":"野上 涼華","sourceIds":{"bangumi":[],"egsCharacterIds":["17778"],"vndbCharacterId":"c2666"},"originalCharacterName":"野上 涼華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"放射線科の専属ナース。20歳。"},{"spoiler":false,"text":"あまり社交的でなく、自分から