":"1231"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Princess of the Netherworld. She came to the surface to destroy it, but fell ill after experiencing the abundant life around her. Luckily Nora was there to save her. Recently she's been reading picture books to children in the neighborhood."},{"spoiler":false,"text":"“It’s wonderful how many legends there are on the surface that still I don't know.”"}],"source":"vndb","sourceCharacterId":"c40407"},{"segments":[{"spoiler":false,"text":"冥界の皇女。"},{"spoiler":false,"text":"地上を滅ぼすためにやって来るが、地上の男の子（ノラ）に恋をしてしまう。"},{"spoiler":false,"text":"己が魔力に絶大な自信を持っており、生者と死者の世界を往還することでさらなる魔力を得ようとしている。"}],"source":"egs","sourceCharacterId":"7666","sourceWorkId":"22474","spoiler":false},{"segments":[{"spoiler":false,"text":"冥界の皇女。地上を滅ぼすためにやって来るが、地上の生気にやられ苦しんでいるところをノラに助けられる。最近では、近所の子どもたちに絵本を読み聞かせている。"}],"source":"egs","sourceCharacterId":"7666","sourceWorkId":"24085","spoiler":false},{"segments":[{"spoiler":false,"text":"冥界の皇女。"},{"spoiler":false,"text":"地上を滅ぼすためにやって来るが、うっかり地上の男の子（ノラ）に恋をしてしまう。"},{"spoiler":false,"text":"己が魔力に絶大な自信を持っており、生者と死者の世界を往復することでさらなる魔力を得ようとしている。"},{"spoiler":false,"text":"好きな獣はネコ。"},{"spoiler":false,"text":"「私に敵う人が、この地上にいるのかしら」"}],"source":"bangumi","sourceCharacterId":"37183"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"37183","value":"魔導書"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9758e40237e40eb6a65015df3ca80a337ab3c5fe7605cb36f68012b4044ff284.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e89bf787d88ce6b8e16f883793aca3b6954e1493f354e4d9d18bac43d1fdaf8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:144518:37183:7302:1","source":"bangumi"}]},{"characterId":"char_c40408","characterName":"黒木 未知","sourceIds":{"bangumi":[{"characterId":"37184","match":"exact-normalized-name-in-linked-work","subjectId":"144518"},{"characterId":"37184","match":"exact-normalized-name-in-linked-work","subjectId":"189550"}],"egsCharacterIds":["7667"],"vndbCharacterId":"c40408"},"originalCharacterName":"黒木 未知","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"508"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The academy monitor and Nora's childhood friend. She is currently studying abroad temporarily to further her education. Without expecting much, she decided to participate in a quiz show and ended up getting an incredibly high score."},{"spoiler":false,"text":"“Everyone! Long time no see! Right now it's nighttime over here!”"}],"source":"vndb","sourceCharacterId":"c40408"},{"segments":[{"spoiler":false,"text":"真面目な性格で学園の風紀委員。"},{"spoiler":false,"text":"男女の交際は取り締まるべきという考えの持ち主。"},{"spoiler":false,"text":"持ち前の容姿から人気はトップクラス。"},{"spoiler":false,"text":"ある日、ひょんなことから、ノラに恋愛相談を持ち掛ける。"}],"source":"egs","sourceCharacterId":"7667","sourceWorkId":"22474","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の風紀委員を務める、ノラの幼馴染。さらなる勉学のため、短期留学をすることに。その留学先で、軽はずみで出場したクイズ大会にて、脅威の成績をたたき出すこととなる。"}],"source":"egs","sourceCharacterId":"7667","sourceWorkId":"24085","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・ノラの幼なじみ。"},{"spoiler":false,"text":"まじめな性格で、学園の風紀委員。 男女恋愛は取り締まるべきという考えの持ち主。"},{"spoiler":false,"text":"持ち前の容姿から人気はトップクラス。"},{"spoiler":false,"text":"母親の影響を大きく受けており、勉強以外に目的が見つけられずにいる。"},{"spoiler":false,"text":"ある日 ひょんなことから、ノラに恋愛相談を持ち掛ける。"},{"spoiler":false,"text":"「またキミは、そうやって逃げようとするんですから」"}],"source":"bangumi","sourceCharacterId":"37184"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"37184","value":"勉強"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87bcd5dd8638adb507a9794597b24a9a3da84548eab5b69ea4fde6457d2da9f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5beb0b047e8706bd5e32090803026c3700c4d197cb1806292e86c6e8373fa71e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"仙台エリ","creatorId":"vndb:s195","sourcePersonId":"vndb:s195","canonicalEntityId":"vndb:s195","name":"仙台 エリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:144518:37184:4749:1","source":"bangumi"}]},{"characterId":"char_c40409","characterName":"夕莉 シャチ","sourceIds":{"bangumi":[{"characterId":"37185","match":"exact-normalized-name-in-linked-work","subjectId":"144518"},{"characterId":"37185","match":"exact-normalized-name-in-linked-work","subjectId":"189550"}],"egsCharacterIds":["7668"],"vndbCharacterId":"c40409"},"originalCharacterName":"夕莉 シャチ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"610"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nora found her on the beach when he was just a child. She's great at all chores and her cooking is very popular with the kids in the neighborhood. Even after Nora turned into a cat, she never stopped taking care of him."},{"spoiler":false,"text":"“I must give Nora his bath today too.”"}],"source":"vndb","sourceCharacterId":"c40409"},{"segments":[{"spoiler":false,"text":"心穏やかな女性。"},{"spoiler":false,"text":"幼い頃、ノラの家に拾われた恩があり、ノラの家で家事全般をこなしている。"},{"spoiler":false,"text":"料理が得意で、彼女の作る食事は、近所の子供たちに大人気。"},{"spoiler":false,"text":"一方、ある事情で気候調節装置として開発された経緯から、地球の天気を予測できるシミュレータを搭載している。"},{"spoiler":false,"text":"彼女が悲しめば雨が降るといわれている。"}],"source":"egs","sourceCharacterId":"7668","sourceWorkId":"22474","spoiler":false},{"segments":[{"spoiler":false,"text":"幼少期にノラが浜辺で見つけた少女。"},{"spoiler":false,"text":"家事全般が得意で、料理は近所の子どもたちにも大人気。ノラがネコになってからも、その世話を欠かさない。"}],"source":"egs","sourceCharacterId":"7668","sourceWorkId":"24085","spoiler":false},{"segments":[{"spoiler":false,"text":"心穏やかな女性。"},{"spoiler":false,"text":"幼い頃にノラの家に拾われた恩があり、反田家で家事全般をこなしている。"},{"spoiler":false,"text":"ベッドメイキング・お風呂沸かし・家庭菜園も作る。"},{"spoiler":false,"text":"料理が得意で、彼女の作る料理は近所の子供たちに大人気。"},{"spoiler":false,"text":"彼女が悲しめば雨が降ると言われている。"},{"spoiler":false,"text":"「あなたは私が護ります」"}],"source":"bangumi","sourceCharacterId":"37185"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"37185","value":"料理"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/824625b271065d08c6e74bcd9781619970b7611f066d836a5e7a83765319e2b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/653c9d955d624b8add8feaace79835a951627300b3d42ac0b320d1917c44f3fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅川悠","creatorId":"vndb:s81","sourcePersonId":"vndb:s81","canonicalEntityId":"vndb:s81","name":"浅川 悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:144518:37185:3958:1","source":"bangumi"}]},{"characterId":"char_c40410","characterName":"明日原 ユウキ","sourceIds":{"bangumi":[{"characterId":"37186","match":"exact-normalized-name-in-linked-work","subjectId":"144518"},{"characterId":"37186","match":"exact-normalized-name-in-linked-work","subjectId":"189550"}],"egsCharacterIds":["7669"],"vndbCharacterId":"c40410"},"originalCharacterName":"明日原 ユウキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nora's childhood friend who has plenty of experience working part-time jobs. Right now she's working at a cat cafe and often invites Nora to join her in his cat form. Recently she's been thinking a lot about the future."},{"spoiler":false,"text":"“Hey, so like, what did you write for that survey thing about what you wanna do in the future?”"}],"source":"vndb","sourceCharacterId":"c40410"},{"segments":[{"spoiler":false,"text":"誰とも分け隔てなく接する明るい女の子。"},{"spoiler":false,"text":"友だちは多く、複数のバイトを掛け持ち。男性によく声を掛けられる。"},{"spoiler":false,"text":"ギャルっぽいと言われることがあるが、本人は自由に生活しているだけだと主張。"},{"spoiler":false,"text":"そろそろ彼氏をつくろうと思っているが、叶うなら、よく相談してくるアイツに捧げたいと思っている。"}],"source":"egs","sourceCharacterId":"7669","sourceWorkId":"22474","spoiler":false},{"segments":[{"spoiler":false,"text":"バイト経験豊富なノラの幼馴染。"},{"spoiler":false,"text":"現在はネコ喫茶でバイトしていることもあり、ネコになったノラをバイトに誘ったこともある。"},{"spoiler":false,"text":"最近、将来について考えるようになった。"}],"source":"egs","sourceCharacterId":"7669","sourceWorkId":"24085","spoiler":false},{"segments":[{"spoiler":false,"text":"誰とでも分け隔てなく接する明るい女の子。"},{"spoiler":false,"text":"友達が多く、複数のバイトを掛け持ち。 平日朝にもシフトを入れる豪快な遅刻魔。"},{"spoiler":false,"text":"ノリの良い性格から男性によく声を掛けられる。"},{"spoiler":false,"text":"ギャルっぽいと言われることがある。 そろそろ彼氏を作ろうと思っている。"},{"spoiler":false,"text":"エッチなものに抵抗はないが、自分のことになると途端に慌てる。"},{"spoiler":false,"text":"「だいじょうぶですよ。 アタシ、ノラパイにしかこういうことしないんで」"}],"source":"bangumi","sourceCharacterId":"37186"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"37186","value":"友達"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eb43d051a662c3a273f40a93d7583e4a18c003c09766244bfc29a8c436a6961.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d28c981980ec68cc74f5a9463749f243b02ce44df6afbf399d22f5afd703795d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"種﨑敦美","creatorId":"vndb:s196","sourcePersonId":"vndb:s196","canonicalEntityId":"vndb:s196","name":"種﨑 敦美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:144518:37186:7575:1","source":"bangumi"}]},{"characterId":"char_c40412","characterName":"高田 ノブチナ","sourceIds":{"bangumi":[{"characterId":"37187","match":"exact-normalized-name-in-linked-work","subjectId":"144518"},{"characterId":"37187","match":"exact-normalized-name-in-linked-work","subjectId":"189550"}],"egsCharacterIds":["7670"],"vndbCharacterId":"c40412"},"originalCharacterName":"高田 ノブチナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"130"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of a Yakuza family. Her words can sometimes be harsh, but that's because she cares for her friends. With her vast array of skills, she's been running the house while her father is away. She also never stops fighting with her sister."},{"spoiler":false,"text":"“Friends don't leave friends behind. They never abandon each other.”"}],"source":"vndb","sourceCharacterId":"c40412"},{"segments":[{"spoiler":false,"text":"地元で有名なヤクザの娘。"},{"spoiler":false,"text":"思ったことをすぐ口にするため、損な役回りになることも。"},{"spoiler":false,"text":"ノラなどとは同じクラスメイトであり、よくつるんでいる。"}],"source":"egs","sourceCharacterId":"7670","sourceWorkId":"22474","spoiler":false},{"segments":[{"spoiler":false,"text":"任侠一家の娘。時に辛辣な事も言うが、仲間を想ってのこと。父親がいない間も家を取りまとめ、その手腕は多岐に渡る。姉とはケンカが絶えない。"}],"source":"egs","sourceCharacterId":"7670","sourceWorkId":"24085","spoiler":false},{"segments":[{"spoiler":false,"text":"ノラのクラスメイト。 地元で有名なヤクザの娘。"},{"spoiler":false,"text":"思ったことをすぐに口にするため、女友達は少ない。"},{"spoiler":false,"text":"背が小さいことを気にしている。"},{"spoiler":false,"text":"並の大人が束になっても敵わないほど強い。"},{"spoiler":false,"text":"「ふん、いっぺん死んでこい」"}],"source":"bangumi","sourceCharacterId":"37187"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"37187","value":"地元"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f26d17d0de374c547a6c2af1ef75c7a4d273bcb00bbab8b581b9c9befe03d849.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd89c99d64f02f654278c3d7e21209b27b5db12efaba8054ec31d33530bbb8ec.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山岡ゆり","creatorId":"vndb:s11656","sourcePersonId":"vndb:s11656","canonicalEntityId":"vndb:s11656","name":"山岡 ゆり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:144518:37187:5645:1","source":"bangumi"}]},{"characterId":"char_c40414","characterName":"ユウラシア・オブ・エンド","sourceIds":{"bangumi":[{"characterId":"37188","match":"exact-normalized-name-in-linked-work","subjectId":"144518"},{"characterId":"37188","match":"exact-normalized-name-in-linked-work","subjectId":"189550"}],"egsCharacterIds":["7671"],"vndbCharacterId":"c40414"},"originalCharacterName":"ユウラシア・オブ・エンド","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"402"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The youngest of the Netherworld sisters. She's a prodigy when it comes to magic. She's really interested in all the things she enjoys and indifferent towards everything else. Recently she's started wanting a cell phone so much that she can't stand it."},{"spoiler":false,"text":"“Feeling like you're having fun is super important!”"}],"source":"vndb","sourceCharacterId":"c40414"},{"segments":[{"spoiler":false,"text":"冥界三姉妹、三女。パトリシアの妹。"},{"spoiler":false,"text":"明るく活発な性格。"},{"spoiler":false,"text":"お姉ちゃんばっかりズルイ、という理由で地上にやって来る。無邪気な性格の一方で、時々トゲのある一面も。"}],"source":"egs","sourceCharacterId":"7671","sourceWorkId":"22474","spoiler":false},{"segments":[{"spoiler":false,"text":"冥界三姉妹の末っ子。魔法に関しては天才肌。自分が楽しいと思うものには興味を示すが、それ以外には無関心。最近、携帯電話が欲しくて仕方がない。"}],"source":"egs","sourceCharacterId":"7671","sourceWorkId":"24085","spoiler":false},{"segments":[{"spoiler":false,"text":"地上を滅ぼしに来たパトリシアの妹。 屈託ない明るい性格。"},{"spoiler":false,"text":"「お姉ちゃんばっかりズルイ」 という理由で地上にやってくる。"},{"spoiler":false,"text":"無邪気な性格の一方で、時々トゲのある一面も。"},{"spoiler":false,"text":"好きなものはお姉ちゃん。"},{"spoiler":false,"text":"お姉ちゃんが恋をしたことに驚いている。"},{"spoiler":false,"text":"「仲良くしてくれると嬉しいなって！　思います！」"}],"source":"bangumi","sourceCharacterId":"37188"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"37188","value":"シュークリーム"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a830b3414dcb9dc05092099337dbf74fd8d085126f28e7193b50ecf017f8495.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50ff412291128fdb7bf2322dfdf138eba0864e4dfba78988482eee2ecbc0775e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大橋歩夕","creatorId":"vndb:s1178","sourcePersonId":"vndb:s1178","canonicalEntityId":"vndb:s1178","name":"大橋 歩夕","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:144518:37188:6174:1","source":"bangumi"}]},{"characterId":"char_c40417","char