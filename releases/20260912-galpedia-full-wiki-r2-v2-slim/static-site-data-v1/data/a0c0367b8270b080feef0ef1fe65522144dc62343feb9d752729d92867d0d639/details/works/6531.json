ce":"egs","sourceCharacterId":"26151","sourceWorkId":"6531","spoiler":false},{"segments":[{"spoiler":false,"text":"何から何まで平凡な女の子。"},{"spoiler":false,"text":"性格はドジでとてもおっちょこちょい。得意技といえば早とちりと、ちょっとだけギターが弾けること。"},{"spoiler":false,"text":"考え事をしている時に鼻の穴がぴくぴくしてしまうなんて変な癖を持つ。"},{"spoiler":false,"text":"誰より何より明るく前向きなのが取り得だと勝手に思っているが、実際は全然前向きじゃなかったりもする。"}],"source":"bangumi","sourceCharacterId":"75029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e646cf05ea214128351957dd71c167ffba14305242479a4f474920a18241ee0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2d6edf86c0c109a014ffb48a3156a8cc763002b541053aaea30df04afdfe064.webp","width":99,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197707:75029:5890:1","source":"bangumi"}]},{"characterId":"char_c77898","characterName":"早見 美佐枝","sourceIds":{"bangumi":[{"characterId":"217238","match":"exact-normalized-name-in-linked-work","subjectId":"197707"}],"egsCharacterIds":["26152"],"vndbCharacterId":"c77898"},"originalCharacterName":"早見 美佐枝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真理奈のクラスメイト。実家は歯医者。"},{"spoiler":false,"text":"真理奈とは学園に入ってからの友人だが、最も付き合いが長く、親友の関係。"},{"spoiler":false,"text":"クラスも一緒。"},{"spoiler":false,"text":"真理奈と変わらず平凡な女の子だが、運動神経が抜群。"},{"spoiler":false,"text":"また噂好きで流行りモノには目がない。"},{"spoiler":false,"text":"性格は姉御肌で、サッパリしているが、かなり単純。"},{"spoiler":false,"text":"バンドではベースを担当。"}],"source":"egs","sourceCharacterId":"26152","sourceWorkId":"6531","spoiler":false},{"segments":[{"spoiler":false,"text":"真理奈のクラスメートで親友で悪友。"},{"spoiler":false,"text":"学園に入ってからの友人で、もっとも付き合いが長い。"},{"spoiler":false,"text":"真理奈と一緒でとても平凡な学生だが、ズバ抜けているのは運動神経と情報屋としての耳の早さ。"},{"spoiler":false,"text":"とにかく噂好きの流行り物好き。そして運動神経がいいので足も早い。よって逃げ足も速い。"},{"spoiler":false,"text":"姉御肌だが、単細胞で単純。竹を割ったようなサッパリした性格。胸のサイズにコンプレックスを持っている。"},{"spoiler":false,"text":"ベース担当。"}],"source":"bangumi","sourceCharacterId":"217238"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d34956aa5868554a0552f540fb5298e2258b2db31c84d09805cea3efe25c479.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b15198e18a19b0a3fc6ccd5427889c016686c66a567ddf178e8ed7d2e0437d8a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197707:217238:12719:1","source":"bangumi"}]},{"characterId":"char_c77900","characterName":"大須賀 法子","sourceIds":{"bangumi":[{"characterId":"217239","match":"exact-normalized-name-in-linked-work","subjectId":"197707"}],"egsCharacterIds":["26153"],"vndbCharacterId":"c77900"},"originalCharacterName":"大須賀 法子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真理奈達仲良し四人組の一人。"},{"spoiler":false,"text":"成績は常に学園のトップクラスの優等生。"},{"spoiler":false,"text":"実家は、函館で有名な大手企業で、彼女は名実ともお嬢様。"},{"spoiler":false,"text":"おっとりしていながらも芯はしっかりしていて、メンバーの中では最も大人っぽい考えを持っている。"},{"spoiler":false,"text":"そんな彼女だが、エッチについては興味津々らしく、経験はないもののその知識はトップクラス。"},{"spoiler":false,"text":"幼い頃からピアノを習っており、バンドではキーボードを担当。"}],"source":"egs","sourceCharacterId":"26153","sourceWorkId":"6531","spoiler":false},{"segments":[{"spoiler":false,"text":"真理奈等の仲良しグループの一人。"},{"spoiler":false,"text":"メンバー中最も大人っぽく、大人しく、そしてしっかりしている。"},{"spoiler":false,"text":"学年でも有数の優等生で、何故真理奈達と付き合いがあるのか疑問視している人も多い。"},{"spoiler":false,"text":"おっとりしているようで芯は○く、実のところはメンバー中最も頑固。"},{"spoiler":false,"text":"実はむっつりスケベで、そう言うことに対する見識や知識、耳年増としてもトップクラス。"},{"spoiler":false,"text":"幼少の頃から習ってきたピアノが得意。キーボード担当。"}],"source":"bangumi","sourceCharacterId":"217239"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b014bce3d1ca3d5b3b6862b5d0446d947e309d38a2a73bf4178947af382f81e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ac1a861337aa3cb22bd8c6f0cf7863323c7c91a92a27a7aba5aee28485cf6c6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MICU","creatorId":"vndb:s5076","sourcePersonId":"vndb:s5076","canonicalEntityId":"vndb:s5076","name":"MICU","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39375","source":"vndb"}]},{"characterId":"char_c77902","characterName":"花井 千里","sourceIds":{"bangumi":[{"characterId":"217240","match":"exact-normalized-name-in-linked-work","subjectId":"197707"}],"egsCharacterIds":["26154"],"vndbCharacterId":"c77902"},"originalCharacterName":"花井 千里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真理奈達仲良し四人組の一人。"},{"spoiler":false,"text":"外見こそ、お子様そのままだが、病気のため学園を留年していることから、年齢的には他のメンバーよりも上。"},{"spoiler":false,"text":"見た目に違わず、言動や振る舞いは子供っぽいが、病気持ちであることから、現実に対してシビアな考えを持っている。"},{"spoiler":false,"text":"故に、時折、現実的な発言で、皆を困惑させたりすることもしばしば。"},{"spoiler":false,"text":"実家は華道の家元で、きちんとした礼儀作法を心得ている。"},{"spoiler":false,"text":"小さい身体ながら、バンドではドラムを担当。"}],"source":"egs","sourceCharacterId":"26154","sourceWorkId":"6531","spoiler":false},{"segments":[{"spoiler":false,"text":"外見は完全にお子様。しかし病気で留年しており、実際は一番生まれが早い。"},{"spoiler":false,"text":"見た目通りで○○っぽい言動が多いが、実は現実に対して最もシビアな考えを持っている。"},{"spoiler":false,"text":"病気は既に完治しており、今の学園生活を最も楽しんでいる。"},{"spoiler":false,"text":"背が小さいのにドラム担当。"}],"source":"bangumi","sourceCharacterId":"217240"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63f9e62fa653b1e28ccb09944c73f883f862782d9122af398f6a3a18d66951ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a24a70c7ac0792f8494ee0db5e797c08bddd02a41daa2231c2ac2f3699985a04.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月山かなる","creatorId":"vndb:s4988","sourcePersonId":"vndb:s4988","canonicalEntityId":"vndb:s4988","name":"月山 かなる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197707:217240:25118:1","source":"bangumi"}]},{"characterId":"char_vndb_c77905","characterName":"柴村 孝之助","sourceIds":{"vndbCharacterId":"c77905"},"originalCharacterName":"柴村 孝之助","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb652f584efac0e37416aa9a64deeec744f500b209fe4908d6f151e9ad3ac7ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e563c1a5d1f0c9cab2118745263451105ecf57024535d9608bd8a25c7bc99c81.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p233","sourceCompanyId":"egs:brand:1312","canonicalEntityId":"vndb:p233","name":"Be