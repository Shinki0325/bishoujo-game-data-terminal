ce":"static-detail"},"actors":[{"creditedName":"静野 ももか","creatorId":"vndb:s2702","sourcePersonId":"vndb:s2702","canonicalEntityId":"vndb:s2702","name":"沖 静香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29643","source":"vndb"}]},{"characterId":"char_c70858","characterName":"ラティア・シェルドン","sourceIds":{"bangumi":[{"characterId":"145973","match":"exact-normalized-name-in-linked-work","subjectId":"265299"}],"egsCharacterIds":["12285"],"vndbCharacterId":"c70858"},"originalCharacterName":"ラティア・シェルドン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"統合宇宙機構軍准尉。士官候補生。ホルベインAMPスクール訓練生。"},{"spoiler":false,"text":"銀河系一の名門財閥・シェルドンカンパニーのお嬢様。"},{"spoiler":false,"text":"のほほんとした天然系の性格で、平坦な人生を嫌い、事件やトラブルが発生することを待ち望んでいるアブナイ思想の女の子。"}],"source":"egs","sourceCharacterId":"12285","sourceWorkId":"4985","spoiler":false},{"segments":[{"spoiler":false,"text":"統合宇宙機構軍准尉。士官候補生。ホルベインＡＭＰスクール訓練生。 お嬢様。銀河系一の名門財閥、シェルドンカンパニーの一人娘。シェルドン財閥は、軍事物資に関する産業や貿易をほぼ独占している。このお嬢様も、訓練生の身でありながら、軍へ納入する艦艇の仕様を自分の好みで左右してしまうという身分。（そのため、最新試作型のAMPが配備されていたり、ラヴェンデュラ号が練習艦とは思えないようなオーバースペック装備だったする）"},{"spoiler":false,"text":"表面的には、天然系のノホホンとした性格。平坦な人生を送ることに恐怖を抱いているため、トラブルは大歓迎。どんな事件でも楽しんでしまう。"}],"source":"bangumi","sourceCharacterId":"145973"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e72ed224b1e02081c448769497284098eabe85c4283735bcc13f1e2436fb0419.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3af5e0331b08c5227ae352d2cb9f2673f0ad13cf0df55f2cae0244c310979e4f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"令泉院 桜子","creatorId":"vndb:s15925","sourcePersonId":"vndb:s15925","canonicalEntityId":"vndb:s15925","name":"令泉院 桜子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29644","source":"vndb"}]},{"characterId":"char_c70859","characterName":"ウィンクル・ヘイル","sourceIds":{"bangumi":[{"characterId":"145974","match":"exact-normalized-name-in-linked-work","subjectId":"265299"}],"egsCharacterIds":["12286"],"vndbCharacterId":"c70859"},"originalCharacterName":"ウィンクル・ヘイル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"統合宇宙機構軍准尉。士官候補生。ホルベインAMPスクール訓練生。"},{"spoiler":false,"text":"無口でおとなしい、典型的な秀才タイプ。"},{"spoiler":false,"text":"沈着冷静でいかなる情況においても自分を見失わない強靭な精神を持つ。"}],"source":"egs","sourceCharacterId":"12286","sourceWorkId":"4985","spoiler":false},{"segments":[{"spoiler":false,"text":"統合宇宙機構軍准尉。士官候補生。ホルベインＡＭＰスクール訓練生。 秀才型美少女。もっとも、この時代の視力矯正は遺伝子レベルででき てしまうため、メガネはかけていない。残念。冷静沈着、いかなる緊急事態でも自分を見失わない。ある意味、恐るべきマイペース娘。さわやかな体育会系のルックスに似合わず、思慮深く、大人しい性格。口数も多くはなく、少々堅苦しいきらいもあるが、ネ暗というわけではない。訓練航海では副艦長を務め、影に日向にケインをサポートする。"}],"source":"bangumi","sourceCharacterId":"145974"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9273f0c00ca5c4b756a1cfcaa77a7792d711dfbdec143b863ca8fabae7cb23d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dafae94865caeee3f026e9f6710ebf799834837ef8822e1900e8b57836e3824b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265299:145974:5890:1","source":"bangumi"}]},{"characterId":"char_c70860","characterName":"デューノ","sourceIds":{"bangumi":[{"characterId":"145975","match":"exact-normalized-name-in-linked-work","subjectId":"265299"}],"egsCharacterIds":["12287"],"vndbCharacterId":"c70860"},"originalCharacterName":"デューノ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"60"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"統合宇宙機構軍操縦士兼、機関士兼、航法士兼、通信士兼、衛生士兼、システム管理士。ホルベインAMPスクール訓練生。"},{"spoiler":false,"text":"半人半獣種族「フェルプ」であるが故に、仕官候補でもなく、軍においても正式な階級はない。"},{"spoiler":false,"text":"同種族は、外見こそ可愛らしいが、知的能力、身体能力とも人間のそれを大幅に上回る。"},{"spoiler":false,"text":"また、同種族はぬいぐるみそっくりの「プライム形態」にメタモルフォーゼすることも可能。"}],"source":"egs","sourceCharacterId":"12287","sourceWorkId":"4985","spoiler":false},{"segments":[{"spoiler":false,"text":"統合宇宙機構軍操縦士・機関士・航法士・通信士・衛生士・システム管理士。ホルベインＡＭＰスクール訓練生。やたらと肩書きを持っているが。士官候補生ではなく、軍における正式な階級もない。それはすべて、彼女の種族のためである。フェルプという半人半獣種。知的能力・身体能力とも人間を大幅に上回る水準で、社会のさまざまなところで活躍している種族である。ついでに愛くるしい外観も人気で、ぬいぐるみそっくりのプライム形態という姿に変身することもできる。"},{"spoiler":false,"text":"訓練においては、戦術ナビゲータとしても活躍する。また、ハッキング能力は神の領域であり、鉄壁を誇る軍のシステムに易々と侵入しては他愛のないイタズラを繰り返す。ところで、フェルプという種には発情期があるらしいが、それがどういう周期なのかは本人にもわからない……"}],"source":"bangumi","sourceCharacterId":"145975"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"70","source":"vndb","sourceCharacterId":"c70860","value":"70"},{"comparisonValue":"60","source":"bangumi","sourceCharacterId":"145975","value":"60"}],"height":[{"comparisonValue":"145","source":"vndb","sourceCharacterId":"c70860","value":"145"},{"comparisonValue":"130","source":"bangumi","sourceCharacterId":"145975","value":"130cm"}],"hip":[{"comparisonValue":"65","source":"vndb","sourceCharacterId":"c70860","value":"65"},{"comparisonValue":"59","source":"bangumi","sourceCharacterId":"145975","value":"59"}],"weight":[{"comparisonValue":"40","source":"vndb","sourceCharacterId":"c70860","value":"40"},{"comparisonValue":"37","source":"bangumi","sourceCharacterId":"145975","value":"37kg"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0aba89314ae5e3369c82f1d5b9de79e01fc100137246e71fa048de52169f17d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5cc49f947ab85d14b42d1225989a4f62ff13f5913a0b67c842551f092f9e520.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小田真ゆみ","creatorId":"vndb:s494","sourcePersonId":"vndb:s494","canonicalEntityId":"vndb:s494","name":"小田 真ゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265299:145975:40660:1","source":"bangumi"}]},{"characterId":"char_c70861","characterName":"リュナ・クリストフ","sourceIds":{"bangumi":[{"characterId":"145976","match":"exact-normalized-name-in-linked-work","subjectId":"265299"}],"egsCharacterIds":["12288"],"vndbCharacterId":"c70861"},"originalCharacterName":"リュナ・クリストフ","characterNameSource":n