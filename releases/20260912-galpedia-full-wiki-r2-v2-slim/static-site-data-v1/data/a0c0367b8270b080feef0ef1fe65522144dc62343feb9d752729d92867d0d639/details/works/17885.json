native","relationId":"vndb:vn-staff:94226","source":"vndb"}],"other":[{"creditedName":"利波創造","creatorId":"vndb:s4272","sourcePersonId":"egs:creator:17824","canonicalEntityId":"vndb:s4272","name":"利波創造","detail":"シナリオ監修","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112115","source":"egs"},{"creditedName":"Prico(PRIKO)","creatorId":"vndb:s2007","sourcePersonId":"egs:creator:20697","canonicalEntityId":"vndb:s2007","name":"Prico(PRIKO)","detail":"OP曲「奇想天外!エブリデイ!」、ED曲「one+love」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:128906","source":"egs"},{"creditedName":"Prico","creatorId":"vndb:s2007","sourcePersonId":"vndb:s2007","canonicalEntityId":"vndb:s2007","name":"Prico","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:94227","source":"vndb"},{"creditedName":"利波 創造","creatorId":"vndb:s4272","sourcePersonId":"vndb:s4272","canonicalEntityId":"vndb:s4272","name":"利波 創造","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:94231","source":"vndb"}]},"cast":[{"characterId":"char_c21755","characterName":"久遠寺 葵","sourceIds":{"bangumi":[{"characterId":"27578","match":"exact-normalized-name-in-linked-work","subjectId":"54193"}],"egsCharacterIds":["23349"],"vndbCharacterId":"c21755"},"originalCharacterName":"久遠寺 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate and the student council president. She is the ojou-sama daughter of a local famous family, looking for a normal school life she transferred to Kamijou Gakuen. Because she grew up in an isolated environment, she is a bit lacking in common sense. She thinks greatly of the protagonist for supporting her in the student council president election, and took the initiative to confess to him. Although they did not exactly declared that they are in an relationship, they consider themselves lovers and dating on the premises of marriage."}],"source":"vndb","sourceCharacterId":"c21755"},{"segments":[{"spoiler":false,"text":"上條学園の学生会長を務める3年生。 隼人のクラスメイト。"},{"spoiler":false,"text":"地元の名家に生まれた箱入り娘。 普通の学生生活に憧れ、上條学園に転入してきた。"},{"spoiler":false,"text":"世俗離れしているため、ちょっと常識に欠けているところがある。"},{"spoiler":false,"text":"学生会選挙まで支えてくれた隼人に好意を持ち、葵からアプローチして関係を持った。"},{"spoiler":false,"text":"お互い 「付き合おう」 と明言はしなかったが、貞操観念の強い葵は自分たちは恋人同士……それも、結婚前提のお付き合いをしているものだと思っている。"},{"spoiler":false,"text":"祖父仕込みの剣術の達人で、居合が得意。"}],"source":"egs","sourceCharacterId":"23349","sourceWorkId":"17885","spoiler":false},{"segments":[{"spoiler":false,"text":"上條学園の学生会長を務める3年生。 隼人のクラスメイト。"},{"spoiler":false,"text":"地元の名家に生まれた箱入り娘。 普通の学生生活に憧れ、上條学園に転入してきた。"},{"spoiler":false,"text":"世俗離れしているため、ちょっと常識に欠けているところがある。"},{"spoiler":false,"text":"学生会選挙まで支えてくれた隼人に好意を持ち、葵からアプローチして関係を持った。"},{"spoiler":false,"text":"お互い 「付き合おう」 と明言はしなかったが、貞操観念の強い葵は自分たちは恋人同士……それも、結婚前提のお付き合いをしているものだと思っている。"},{"spoiler":false,"text":"祖父仕込みの剣術の達人で、居合が得意。"},{"spoiler":false,"text":"「……ふふ、隼人さんはなんでもお見通しなのですね」"}],"source":"bangumi","sourceCharacterId":"27578"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f325b3a1d983ef1cb56ebe572ab729d6ba426e842c78fb8da6c3aa39fa7ee17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d424d725c6f342f4427fdc99ca553c3fb389b7c6d926e7cb5a4fd48e796a8631.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:54193:27578:5936:1","source":"bangumi"}]},{"characterId":"char_c21756","characterName":"片倉 沙希","sourceIds":{"bangumi":[{"characterId":"27579","match":"exact-normalized-name-in-linked-work","subjectId":"54193"}],"egsCharacterIds":["23350"],"vndbCharacterId":"c21756"},"originalCharacterName":"片倉 沙希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend. Very good at cooking and housework. Knows about the slovenly side of the protagonist and will often take care of him. She is a national level tennis player and the tennis club's ace. Once when she was very upset at not being able to participate in a big tournament due to an injury, she was comforted by the protagonist. Attracted by his gentleness, she confessed to him. She is a sports science student in name, but in order to become closer to the protagonist, she secretly took the general science exam. This spring she became a general science student and the protagonist's classmate. Because she is afraid to damage her relationship with the protagonist, she is unable to take the crucial step, and is secretly looking forward to the advancing of their relationship."}],"source":"vndb","sourceCharacterId":"c21756"},{"segments":[{"spoiler":false,"text":"上條学園の3年生。 隼人の幼なじみ。"},{"spoiler":false,"text":"料理上手で家事全般が得意。 隼人のだらしない部分も熟知しており、なにかと世話を焼く。"},{"spoiler":false,"text":"テニス部に所属する全国レベルのエース。"},{"spoiler":false,"text":"ケガでテニスの大会に出場できず落ち込んでいるところを隼人に慰められ、その優しさから関係を持った。"},{"spoiler":false,"text":"スポーツ科に籍を置いていたが、テニス部を辞めてしまった隼人との距離を縮めるべく黙って編入試験を受け、この春から普通科の学生としてクラスメイトに。"},{"spoiler":false,"text":"気の許せる仲を壊すことを怖れ、自分からは肝心の一歩が踏み出せず、できれば隼人に切り出してもらいたいと淡い期待を抱いている。"}],"source":"egs","sourceCharacterId":"23350","sourceWorkId":"17885","spoiler":false},{"segments":[{"spoiler":false,"text":"上條学園の3年生。 隼人の幼なじみ。"},{"spoiler":false,"text":"料理上手で家事全般が得意。 隼人のだらしない部分も熟知しており、なにかと世話を焼く。"},{"spoiler":false,"text":"テニス部に所属する全国レベルのエース。"},{"spoiler":false,"text":"ケガでテニスの大会に出場できず落ち込んでいるところを隼人に慰められ、その優しさから関係を持った。"},{"spoiler":false,"text":"スポーツ科に籍を置いていたが、テニス部を辞めてしまった隼人との距離を縮めるべく黙って編入試験を受け、この春から普通科の学生としてクラスメイトに。"},{"spoiler":false,"text":"気の許せる仲を壊すことを怖れ、自分からは肝心の一歩が踏み出せず、できれば隼人に切り出してもらいたいと淡い期待を抱いている。"},{"spoiler":false,"text":"「心配してるのはこっちよ。ほんと、私が見てないとダメなんだから……」"}],"source":"bangumi","sourceCharacterId":"27579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2f04da0f9e0f02115f68e16f46f09a494859e7c5d5da1a7e6823de3e59b7714.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/daade4dbab48a8427bb06c58c62bac5dcf314e5fd99fd71c9c588e7365a98f7c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小暮英麻","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:54193:27579:4282:1","source":"bangumi"}]},{"characterId":"char_c21757","characterName":"小早川 詩帆","sourceIds":{"bangumi":[{"characterId":"27580","match":"exact-normalized-name-in-linked-work","subjectId":"54193"}],"egsCharacterIds":["23351"],"vndbCharacterId":"c21757"},"originalCharacterName":"小早川 詩帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"New English teacher at Kamijou Gakuen and the student council advisor. A bit natural, usually she is very relaxed, but sometimes she will unsuspectingly show her plump figure. She was previously the protagonist's tutor, and due to certain events they banged each other like animals. After that they have never again contacted one another, their fateful meeting at school is entirely coincidental. She doesn't care about the people around them, and will actively try to flirt with the protagonist by making body contact. Likes classical music and is obsessed with the piano. Her cooking is very bad."}],"source":"vndb","sourceCharacterId":"c21757"},{"segments":[{"spoiler":false,"text":"上條学園の新人教師。 学生会の顧問も兼任する。"},{"spoiler":false,"text":"ゆったりマイペースのお茶目な性格で、豊満な肉体を無防備に見せつけてくる天然さん。"},{"spoiler":false,"text":"隼人の家庭教師をしていた時に、思わぬハプニングから関係を持ってしまう。"},{"spoiler":false,"text":"以降は連絡を取っていなかったが、偶然にも赴任してきた学園で再会。 人目をはばからず積極的にスキンシップを取ってくる。"},{"spoiler":false,"text":"クラシック音楽が好きで、趣味でピアノも嗜む。"},{"spoiler":false,"text":"担当教科は英語。 ただしイントネーションが個性的かつ壊滅的で、周りをズッコケさせる。"},{"spoiler":false,"text":"ついでに料理の腕も致命的。"}],"source":"egs","sourceCharacterId":"23351","sourceWorkId":"17885","spoiler":false},{"segments":[{"spoiler":false,"text":"上條学園の新人教師。 学生会の顧問も兼任する。"},{"spoiler":false,"text":"ゆったりマイペースのお茶目な性格で、豊満な肉体を無防備に見せつけてくる天然さん。"},{"spoiler":false,"text":"隼人の家庭教師をしていた時に、思わぬハプニングから関係を持ってしまう。"},{"spoiler":false,"text":"以降は連絡を取っていなかったが、偶然にも赴任してきた学園で再会。 人目をはばからず積極的にスキンシップを取ってくる。"},{"spoiler":false,"text":"クラシック音楽が好きで、趣味でピアノも嗜む。"},{"spoiler":false,"text":"担当教科は英語。 ただしイントネーションが個性的かつ壊滅的で、周りをズッコケさせる。"},{"spoiler":false,"text":"ついでに料理の腕も致命的。"},{"spoiler":false,"text":"「ふふふ、かわいい～。そういう困った顔、去年と変わってないんだね」"}],"source":"bangumi","sourceCharacterId":"27580"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/097beaebedd7dcefd6e9a36341ce56f08d24877f6538d25259081b2cd31a25f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7221a649ede73551f741bdf4708964f4a20110fcc17a9c7d23a607c040165a5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:54193:27580:6083:1","source":"bangumi"}]},{"characterId":"char_c21758","characterName":"萩原 ひなの","sourceIds":{"bangumi":[{"characterId":"27581","match":"exact-normalized-name-in-linked-work","subjectId":"54193"}],"egsCharacterIds":["23352"],"vndbCharacterId":"c21758"},"originalCharacterName":"萩原 ひなの","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's younger cousin and freshman at Kamijou Gakuen. Her home is very far away; before she could only see her \"onii-chan\" at relative gatherings. She has looked at her onii-chan as a man rather than a relative since very young. She confessed to her onii-chan last summer hoping to become lovers. After that they have only been able to talk to each other through the phone, but she is unable to abandon her feelings for him, so she ended up enrolling at Kamijou Gakuen. Although she is very shy, she is single-minded and outspoken."}],"source":"vndb","sourceCharacterId":"c21758"},{"segments":[{"spoiler":false,"text":"上條学園の1年生。 隼人の2つ下の従妹。"},{"spoiler":false,"text":"遠方に暮らしており、隼人とは親戚の会合で顔を合わせる程度だったが、幼い頃から歳上の異性として憧れていた。"},{"spoiler":false,"text":"去年の夏休みに告白して、「思い出をください」 という申し出から関係を持った。"},{"spoiler":false,"text":"以降は電話でのやり取りだけになっていたが、隼人への気持ちを捨てきれず上條学園を受験し、この春学園にやってきた。"},{"spoiler":false,"text":"引っ込み思案で恥ずかしがり屋だが、一途で素直な性格。"},{"spoiler":false,"text":"隼人については積年の妄想がふくらんでおり、かなり理想化している。"}],"source":"egs","sourceCharacterId":"23352","sourceWorkId":"17885","spoiler":false},{"segments":[{"spoiler":false,"text":"上條学園の1年生。 隼人の2つ下の従妹。"},{"spoiler":false,"text":"遠方に暮らしており、隼人とは親戚の会合で顔を合わせる程度だったが、幼い頃から歳上の異性として憧れていた。"},{"spoiler":false,"text":"去年の夏休みに告白して、「思い出をください」 という申し出から関係を持った。"},{"spoiler":false,"text":"以降は電話でのやり取りだけになっていたが、隼人への気持ちを捨てきれず上條学園を受験し、この春学園にやってきた。"},{"spoiler":false,"text":"引っ込み思案で