rce":"vndb"},{"creditedName":"椋木 尋","creatorId":"vndb:s2928","sourcePersonId":"vndb:s2928","canonicalEntityId":"vndb:s2928","name":"椋木 尋","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:127716","source":"vndb"},{"creditedName":"天ヶ咲 麗","creatorId":"vndb:s4314","sourcePersonId":"vndb:s4314","canonicalEntityId":"vndb:s4314","name":"天ヶ咲 麗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:127718","source":"vndb"}]},"cast":[{"characterId":"char_c42073","characterName":"秋月 優奈","sourceIds":{"bangumi":[{"characterId":"43060","match":"exact-normalized-name-in-linked-work","subjectId":"172329"}],"egsCharacterIds":["8057"],"vndbCharacterId":"c42073"},"originalCharacterName":"秋月 優奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female student who attends the school that the protagonist is on the teaching staff of."},{"spoiler":false,"text":"With good grades in school, she works as the class representative of the class the protagonist is in charge of."},{"spoiler":false,"text":"Because of her polite and earnest personality, she is very obedient despite whatever her feelings may be."},{"spoiler":false,"text":"Despite being a well-together individual, she is fragile against passion, and weak under pressure."},{"spoiler":false,"text":"Her parents divorced when she was very young, and she currently lives together with her mother."},{"spoiler":false,"text":"In place of her mother who returns home late from work, she handles the housework and her cooking is top class."},{"spoiler":false,"text":"She associates with her neighbors, the protagonist and his son Kouichi, as her own family."},{"spoiler":false,"text":"As a result of barely any acquaintance with her own father, she calls the protagonist \"Uncle\" and adores him like a father."},{"spoiler":false,"text":"She grew up with Kouichi as a childhood friend, and they are now boyfriend and girlfriend."},{"spoiler":false,"text":"Although she has already experienced sex with Kouichi, she has never experienced doing it without a condom."}],"source":"vndb","sourceCharacterId":"c42073"},{"segments":[{"spoiler":false,"text":"主人公が教員として勤務する学園に通う女子学生。"},{"spoiler":false,"text":"学園での成績は良く、主人公が受け持つクラスでクラス委員を務めている。"},{"spoiler":false,"text":"礼儀正しくまじめな性格で、それゆえに自分の感情に対して素直になれないことも。"},{"spoiler":false,"text":"しっかり者だが情にはもろく、押しに弱い一面がある。"},{"spoiler":false,"text":"両親は彼女が幼い頃に離婚しており、現在は母親と二人で暮らしている。"},{"spoiler":false,"text":"仕事で帰りが遅い母親に代わって家事をこなしており、特に料理の腕は一級品。"},{"spoiler":false,"text":"お隣さんである主人公とその息子の康一とは、家族ぐるみの付き合い。"},{"spoiler":false,"text":"実の父とほとんど面識がないため、主人公を 「おじさま」 と呼び、父親のように慕っている。"},{"spoiler":false,"text":"康一とは幼なじみとして育ち、現在は恋人同士。"},{"spoiler":false,"text":"すでに康一とセックスの経験があるものの、コンドームなしでの経験は一度もない。"}],"source":"egs","sourceCharacterId":"8057","sourceWorkId":"22886","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：157cm　 スリーサイズ：B90（F）/ W56/ H83"},{"spoiler":false,"text":"主人公が教員として勤務する学園に通う女子学生。"},{"spoiler":false,"text":"学園での成績は良く、主人公が受け持つクラスでクラス委員を務めている。"},{"spoiler":false,"text":"礼儀正しくまじめな性格で、それゆえに自分の感情に対して素直になれないことも。"},{"spoiler":false,"text":"しっかり者だが情にはもろく、押しに弱い一面がある。"},{"spoiler":false,"text":"両親は彼女が幼い頃に離婚しており、現在は母親と二人で暮らしている。"},{"spoiler":false,"text":"仕事で帰りが遅い母親に代わって家事をこなしており、特に料理の腕は一級品。"},{"spoiler":false,"text":"お隣さんである主人公とその息子の康一とは、家族ぐるみの付き合い。"},{"spoiler":false,"text":"実の父とほとんど面識がないため、主人公を 「おじさま」 と呼び、父親のように慕っている。"},{"spoiler":false,"text":"康一とは幼なじみとして育ち