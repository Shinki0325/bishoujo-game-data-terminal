eviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only son of the protagonist, a male student who attends the same school as Yuuna."},{"spoiler":false,"text":"He's the frank type who speaks his mind. He dislikes awry things and has a strong sense of justice."},{"spoiler":false,"text":"He doesn't say it, but he reveres his father who raised him alone from the bottom of his heart."},{"spoiler":false,"text":"With blessed physique and high reflexes, he is good at all sports and strong in a fight."},{"spoiler":false,"text":"He was the ace striker of the soccer club but has now devoted himself to studying."},{"spoiler":false,"text":"He and Yuuna, who is only a month younger than him, were raised like siblings."},{"spoiler":false,"text":"Having been aware of her as a member of the opposite sex for some time, he confessed to and became boyfriend and girlfriend with Yuuna."}],"source":"vndb","sourceCharacterId":"c42075"},{"segments":[{"spoiler":false,"text":"主人公のひとり息子。優奈と同じ学園に通っている男子学生。"},{"spoiler":false,"text":"直情的で、考えがすぐに言動に出るタイプ。曲がったことが嫌いで正義感が強い。"},{"spoiler":false,"text":"体格的に恵まれていることと生来の高い反射神経のためスポーツ全般を得意としており、喧嘩も強い。"},{"spoiler":false,"text":"しかし、幼馴染みである優奈にはまったく頭が上がらなかったりする。"},{"spoiler":false,"text":"優奈に告白し、恋人同士となれたことを心から喜んでいる。"},{"spoiler":false,"text":"普段は口に出さないものの、男手ひとつで自分を育ててくれた父親を心から尊敬している。"}],"source":"egs","sourceCharacterId":"8058","sourceWorkId":"22886","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7de618cc6cdc3eec0e62f5bef13d6ccc51d4ce3194faabff31bad0fe02e787ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/4938ab5bb006c7f66ed371cddb4890fdb0291be6de42406ae998c623911cb6ab.webp","width":92,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c42074","characterName":"宮田 康司","sourceIds":{"vndbCharacterId":"c42074"},"originalCharacterName":"宮田 康司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a middle-aged teacher at the school which his son Kouichi and Yuuna attend."},{"spoiler":false,"text":"He has a rational and calm personality. He normally strives to be a good father and teacher."},{"spoiler":false,"text":"He appears young with an air of freshness, and is very popular for not having a strict attitude at school."},{"spoiler":false,"text":"He is an excellent teacher and serves as a homeroom teacher and also as the person in charge of the science curriculum."},{"spoiler":false,"text":"His wife passed away about 20 years ago, and it's been only him and Kouichi living together ever since."},{"spoiler":false,"text":"He treats the Akidzuki household as family and cherishes and considers Yuuna as his real daughter."},{"spoiler":false,"text":"He spent his days productively as a father and a teacher,"},{"spoiler":false,"text":"but Yuuna and Kouichi's relationship sparked the relation of his own perverted true feelings."}],"source":"vndb","sourceCharacterId":"c42074"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3450","sourceCompanyId":"egs:brand:3994","canonicalEntityId":"vndb:p3450","name":"エロイット","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22886:3994","source":"egs"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:126978:v18812","source":"vndb"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb