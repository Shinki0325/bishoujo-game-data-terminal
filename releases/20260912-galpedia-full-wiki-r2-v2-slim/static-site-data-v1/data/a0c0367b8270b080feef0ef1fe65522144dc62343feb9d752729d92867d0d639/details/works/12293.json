alized-name-in-linked-work","subjectId":"27126"}],"egsCharacterIds":["15488"],"vndbCharacterId":"c21820"},"originalCharacterName":"城之崎 永子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「URABEデザイン」の女性下着デザイン部門の責任者。"},{"spoiler":false,"text":"主人公を自分の部署に引っ張り込んだ張本人で、主人公にとっては上司。"},{"spoiler":false,"text":"ずっとこの街に住んでおり、欲情効果のあるサイレンを理由に社内でつまみ食いして楽しんでいる。"},{"spoiler":false,"text":"ちゃらんぽらんに見えて、仕事はしっかり出来る。"}],"source":"egs","sourceCharacterId":"15488","sourceWorkId":"12293","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の入社した会社での上司。"},{"spoiler":false,"text":"女性下着デザイン部門の責任者にして、新入社員の主人公を部署に引っ張り込んだ張本人。"},{"spoiler":false,"text":"ずっとこの町で暮らしており、サイレンを理由に社内でいろいろつまみ食いしていたりする。"},{"spoiler":false,"text":"ちゃらんぽらんに見えるが仕事は出来る女性。"}],"source":"bangumi","sourceCharacterId":"204627"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42dd2e83d09b962082e0ec949a59cdc4ac300362bcedd6b9c433e7a0390da12e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8258fcd90e475d6282bed8f26e6c9330b6c638d871ca5c6e5b890723668c15b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"貴坂理緒","creatorId":"vndb:s946","sourcePersonId":"vndb:s946","canonicalEntityId":"vndb:s946","name":"貴坂 理緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27126:204627:15550:1","source":"bangumi"}]},{"characterId":"char_c21821","characterName":"黒蜜 里香","sourceIds":{"bangumi":[{"characterId":"204629","match":"exact-normalized-name-in-linked-work","subjectId":"27126"}],"egsCharacterIds":["15490"],"vndbCharacterId":"c21821"},"originalCharacterName":"黒蜜 里香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"この春、「URABEデザイン」に、主人公と同時入社した新入社員。受付嬢。"},{"spoiler":false,"text":"愛想がなく、感情をあまり表に出さないエキセントリックな雰囲気の女の子。"},{"spoiler":false,"text":"また毒舌でもあり、辛辣なことを平気で口にしたり、素っ気ない態度を取るが、逆にそれが彼女の魅力となって、多くの男性を虜にしているらしい。"},{"spoiler":false,"text":"雨戸香澄とは入社式で隣同士だったため、仲の良い間柄。"}],"source":"egs","sourceCharacterId":"15490","sourceWorkId":"12293","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じく今年、会社に入社した、会社の受付嬢。"},{"spoiler":false,"text":"感情をあまり表に出さない、不思議な女の子。"},{"spoiler":false,"text":"愛想があんまり感じられず、毒舌で受付嬢として問題があるように見えるが"},{"spoiler":false,"text":"逆にその素っ気無さが周りの男性を虜にしている。"},{"spoiler":false,"text":"香澄とは入社式で隣同士だったため、仲良くなる。"}],"source":"bangumi","sourceCharacterId":"204629"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e967f5cb5195e4a6b2bab5fbbeebe43469e050a9ee571f3a262fcabc7f15779.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29e9404b7480828df413f1bebf353ca18d64d5350bdf776514582d46f5f8e8f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"津軽 りんご","creatorId":"vndb:s2586","sourcePersonId":"vndb:s2586","canonicalEntityId":"vndb:s2586","name":"津軽 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30648","source":"vndb"}]},{"characterId":"char_c21822","characterName":"渡利 由宇","sourceIds":{"bangumi":[{"characterId":"204628","match":"exact-normalized-name-in-linked-work","subjectId":"27126"}],"egsCharacterIds":["15489"],"vndbCharacterId":"c21822"},"originalCharacterName":"渡利 由宇","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「URABEデザイン」に勤める女性社員。主人公らの先輩。"},{"spoiler":false,"text":"生まれた時から、ずっとこの街に住んでいる。"},{"spoiler":false,"text":"さっぱりした性格で、一見、貞操観念が低いと思われがちだが、どっこいサイレンの影響で見ず知らずの人とエッチするのを拒んで、会社のロッカー室で自慰に耽りつつ、異常性欲を発散している。"}],"source":"egs","sourceCharacterId":"15489","sourceWorkId":"12293","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が入社した会社の先輩。"},{"spoiler":false,"text":"生まれた時から、『サイレン』の鳴るこの街に住んでいる。"},{"spoiler":false,"text":"サバサバした性格で貞操観念が低いと思われがちだが、『サイレン』の影響で見ず知らずの人とHするのを拒み、よく会社のロッカー室で妄想にふけりつつ自慰をしている。"}],"source":"bangumi","sourceCharacterId":"204628"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7d3fe65964e379fea6cd65db92794aa1ce763daf3ed42d9deb9525bf1369a3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/414ffe7859abb8085edd2b552dd2334211c9509700a838e686dbbe22895d3729.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渡邊優佳","creatorId":"vndb:s1040","sourcePersonId":"vndb:s1040","canonicalEntityId":"vndb:s1040","name":"渡邊 優佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27126:204628:24788:1","source":"bangumi"}]},{"characterId":"char_c21823","characterName":"見取 小梅","sourceIds":{"bangumi":[{"characterId":"204630","match":"exact-normalized-name-in-linked-work","subjectId":"27126"}],"egsCharacterIds":["15491"],"vndbCharacterId":"c21823"},"originalCharacterName":"見取 小梅","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「URABEデザイン」に勤める女性社員。主人公とは別部署。"},{"spoiler":false,"text":"物怖じしない気さくで、茶目っ気たっぷりのお姉さん。そのため、誰とでも仲良くなれる。"},{"spoiler":false,"text":"生まれた時からサイレンの鳴るこの街に住んでおり、貞操観念は皆無で、サイレンによる大乱交の日々を満喫している。"}],"