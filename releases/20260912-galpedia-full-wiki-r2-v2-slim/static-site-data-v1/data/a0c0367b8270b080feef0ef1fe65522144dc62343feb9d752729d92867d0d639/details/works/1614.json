itedName":"岩城 由奈","creatorId":"vndb:s3063","sourcePersonId":"vndb:s3063","canonicalEntityId":"vndb:s3063","name":"岩城 由奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36482","source":"vndb"}]},{"characterId":"char_vndb_c12667","characterName":"増田 千穂","sourceIds":{"vndbCharacterId":"c12667"},"originalCharacterName":"増田 千穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"402"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A trained ninja and was once the heir apparent to her family's ninja clan. However, she desires a life of freedom and happiness and thus has run away, becoming a \"Missing-nin.\" She participates in hopes of using the prize money and free real estate to finance her new life."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac3f2a6ec4a80143eb9df1504359f86cbe5115242da5cbd0c0654309d823191a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f62aef24a509feaba63a255914f5cbdebe24121848849170fb6933e21a31bba.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村 友美","creatorId":"vndb:s8241","sourcePersonId":"vndb:s8241","canonicalEntityId":"vndb:s8241","name":"中村 友美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-