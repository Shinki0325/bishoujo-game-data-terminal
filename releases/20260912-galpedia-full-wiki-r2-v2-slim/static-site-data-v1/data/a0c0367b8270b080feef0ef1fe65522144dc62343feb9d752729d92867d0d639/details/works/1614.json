ative","relationId":"vndb:vn-staff:65341","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c12660","characterName":"武内 優香","sourceIds":{"vndbCharacterId":"c12660"},"originalCharacterName":"武内 優香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"807"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birthplace / Origin: Tokyo metropolitan area."},{"spoiler":false,"text":"Occupation: 3rd-year (senior) at city academy \"T\", part-time waitress (Hanna Miller's)."},{"spoiler":false,"text":"Likes / Loves: Fruits, video games."},{"spoiler":false,"text":"A refreshing \"sports girl\" with a strong sense of justice. Yuka is liked both by her classmates and underclassmen. She uses \"Boku\" (a Japanese pronoun) when referring to herself. Yuka has a 4-dan full contact karate skills and a black belt. She won a V.G. tournament in the past."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12660"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca0bebfce94fdcb11fffbc6087773c35d4edc43d17b3de3174ccafcab1f1b840.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb0c4cef1b766f8e8263ba2751d1c976b5cd9490f480fee969cf98991881e5f4.webp","width":180,"height":233,"source":"static-detail"},"actors":[{"creditedName":"成瀬 ゆら","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36478","source":"vndb"}]},{"characterId":"char_vndb_c12662","characterName":"御剣 珠緒","sourceIds":{"vndbCharacterId":"c12662"},"originalCharacterName":"御剣 珠緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1206"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl who dreams of one day being like her idol, Yuka Takeuchi. To that end, she has tirelessly spent her spare time practicing amateur Karate and attempting to copy Yuka's various techniques. She somehow gained the ability to control her energy before her fourteenth birthday. Much like Yuka, Tamao is hard working, honest, and generally outgoing, which allows her to make friends easily. However, she is clumsy, forgetful, and tends to act before thinking things through."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12662"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e06f6c2b3d5683d4785279e8cd4fe8c51360b9c55693f1cdb94db5f252c61af5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/862fd7351bf61056a8f12f084ad69cc245428330e70a95b09cb6af9de575320e.webp","width":180,"height":235,"source":"static-detail"},"actors":[{"creditedName":"椎名 奏子","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36480","source":"vndb"}]},{"characterId":"char_vndb_c12663","characterName":"レイミ・謝華","sourceIds":{"vndbCharacterId":"c12663"},"originalCharacterName":"レイミ・謝華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"227"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Head of the Jahana Group, the organization which supervises the V.G. tournaments. Reimi is wealthy, highly intelligent, and extremely beautiful. She is also a skilled martial artist and a three-time V.G. champion. Reimi initially sees the competitions as a chance to prove herself the strongest and most beautiful warrior of all, and takes a kind of perverse pleasure in watching those who lose against her be humiliated in various ways. After being defeated by Yuka, she reforms and re-enters the tournament with the hopes of regaining her title."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12663"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/731fecba8cfec74a62cd3cec4601b72a572d34a5d67b8a06f2a6661ed23f1138.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cdc20b9ab656fb9da73988125f7b940a8251dd08acf0975d25c18da20a56cce.webp","width":142,"height":256,"source":"static-detail"},"actors":[{"creditedName":"潮田 聖子","creatorId":"vndb:s21257","sourcePersonId":"vndb:s21257","canonicalEntityId":"vndb:s21257","name":"潮田 聖子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36486","source":"vndb"}]},{"characterId":"char_vndb_c12664","characterName":"楠 真奈美","sourceIds":{"vndbCharacterId":"c12664"},"originalCharacterName":"楠 真奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"303"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The youngest competitor in the VG Tournament at age 16. Along with her relative youth, she is also woefully immature, often acting like a girl half her age. Despite this however, she is a surprisingly clever and capable fighter, incorporating the natural energeticness of a child, as well her own vivid imagination into her fighting style. Her reason for entering the competitions is solely to obtain the large cash prize awarded to the winner. She is often the most lighthearted competitor in any given tournament, treating the fights as if they were all a big game."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12664"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2434259fa233f78b771998af2404c6fd9bc733b09c29a04c2e7233f799ccb053.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c11cd9319d3f22d014dd2382e3ddc376ad9b4f8d973aecedb792d121dadab697.webp","width":180,"height":232,"source":"static-detail"},"actors":[{"creditedName":"MIKAKO","creatorId":"vndb:s1137","sourcePersonId":"vndb:s1137","canonicalEntityId":"vndb:s1137","name":"佐藤美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36483","source":"vndb"}]},{"characterId":"char_vndb_c12665","characterName":"久保田 潤","sourceIds":{"vndbCharacterId":"c12665"},"originalCharacterName":"久保田 潤","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1118"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A wrestler with vast amounts of strength, Jun once participated in the Olympics while in high school. However, she was ejected from the games due to repeated unsportsmanlike conduct. She later joins the V.G. competitions because she can treat her opponents as roughly as she pleases. Despite this however, Jun operates by her own personal honor code. She fiercely believes that the use of weaponry in a martial arts bout is unacceptable."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee1679f73aa062ac89137ed8dabb8f7371c682bc70f344705d2b3dfbfdc17341.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/045e7f19bbfeaa7fc53452c4269d4cc5e9f481f90720f36792342566771e2aa9.webp","width":180,"height":238,"source":"static-detail"},"actors":[{"creditedName"