12","source":"vndb"},{"creditedName":"伊武 もいな","creatorId":"vndb:s4389","sourcePersonId":"vndb:s4389","canonicalEntityId":"vndb:s4389","name":"伊武もいな(いぶもいな)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132213","source":"vndb"},{"creditedName":"古囃 ヒロ","creatorId":"vndb:s6839","sourcePersonId":"vndb:s6839","canonicalEntityId":"vndb:s6839","name":"古囃ヒロ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132215","source":"vndb"},{"creditedName":"菊月紅","creatorId":"vndb:s9188","sourcePersonId":"vndb:s9188","canonicalEntityId":"vndb:s9188","name":"菊月紅","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132216","source":"vndb"},{"creditedName":"野田 しゅは","creatorId":"vndb:s10130","sourcePersonId":"vndb:s10130","canonicalEntityId":"vndb:s10130","name":"野田 しゅは","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132217","source":"vndb"},{"creditedName":"小竹 義彦","creatorId":"vndb:s12546","sourcePersonId":"vndb:s12546","canonicalEntityId":"vndb:s12546","name":"小竹 義彦","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132218","source":"vndb"},{"creditedName":"オカザワ","creatorId":"vndb:s12547","sourcePersonId":"vndb:s12547","canonicalEntityId":"vndb:s12547","name":"オカザワ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132219","source":"vndb"},{"creditedName":"りょーちん","creatorId":"vndb:s12940","sourcePersonId":"vndb:s12940","canonicalEntityId":"vndb:s12940","name":"林 亮介","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132220","source":"vndb"},{"creditedName":"合資会社ワムソフト","creatorId":"vndb:s15832","sourcePersonId":"vndb:s15832","canonicalEntityId":"vndb:s15832","name":"WAMSOFT(合資会社ワムソフト)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132222","source":"vndb"},{"creditedName":"インターネットラジオステーション＜音泉＞","creatorId":"vndb:s15840","sourcePersonId":"vndb:s15840","canonicalEntityId":"vndb:s15840","name":"インターネットラジオステーション＜音泉＞","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132223","source":"vndb"}]},"cast":[{"characterId":"char_c50404","characterName":"ハル","sourceIds":{"bangumi":[{"characterId":"45725","match":"exact-normalized-name-in-linked-work","subjectId":"186675"}],"egsCharacterIds":["10615"],"vndbCharacterId":"c50404"},"originalCharacterName":"ハル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second sister of the three sisters working at Famille, a café on the outskirts of town."},{"spoiler":false,"text":"She's also the manager of Famille and is mainly in charge of cakes and sweets."},{"spoiler":false,"text":"She has a relaxed, gentle demeanor and is always smiling, which creates a good impression on Ren and Shou."},{"spoiler":false,"text":"Even with a troubled expression, she goes at her own pace."},{"spoiler":false,"text":"But actually, she's the most strong-willed and stubborn among the sisters."},{"spoiler":false,"text":"She's catastrophically bad at waking up, and it's rarer for her to not be late than to be on time."},{"spoiler":false,"text":"The cause is that she writes too much in her daily diary."},{"spoiler":true,"text":"It’s not long until Shou witnesses Haru collecting a “soul”, however, which is a process where a normal human becomes a flower and is planted near the large tree. This has been the “rule” of this world for as long as Haru can remember, and it was her, and her sister’s jobs to perform this task to stay alive. As an angel of death, Haru is missing “memories” which was replaced by her powers. This includes memories that she shared with a boy named “Akito”, and memories of her sisters as well. The one thing she does not forget, however, is a promise that she made with Akito a long time ago."},{"spoiler":false,"text":"Partially from Visual Novels and Eroge Review"}],"source":"vndb","sourceCharacterId":"c50404"},{"segments":[{"spoiler":false,"text":"街外れにある喫茶店、ファミーユで働く３姉妹の２番目の姉。"},{"spoiler":false,"text":"ファミーユの店長でもあり、主にケーキやお菓子などを担当している。"},{"spoiler":false,"text":"のんびりとした柔らかい物腰でいつも笑顔。"},{"spoiler":false,"text":"困った時も笑顔でマイペース。"},{"spoiler":false,"text":"でも実は姉妹の中で一番芯が硬く頑固者。"},{"spoiler":false,"text":"寝起きが壊滅的に弱く、遅刻しない日の方が珍しい。"},{"spoiler":false,"text":"日課の日記を書きすぎているのが原因。"}],"source":"egs","sourceCharacterId":"10615","sourceWorkId":"23956","spoiler":false},{"segments":[{"spoiler":false,"text":"街外れにある喫茶店『ファミーユ』で働く三姉妹の2番目の姉。"},{"spoiler":false,"text":"ファミーユの店長でもあり、主にケーキやお菓子などを担当している。"},{"spoiler":false,"text":"のんびりとした柔らかい物腰でいつも笑顔。 困った時も笑顔でマイペース。"},{"spoiler":false,"text":"でも実は、姉妹の中で一番芯が硬く頑固者。"},{"spoiler":false,"text":"寝起きが壊滅的に弱く、遅刻しない日のほうが珍しい。"},{"spoiler":false,"text":"日課の日記を書きすぎているのが原因。"},{"spoiler":false,"text":"「私の約束は、もう叶わない約束ですから」"}],"source":"bangumi","sourceCharacterId":"45725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/3221642b9823d56f12dae98d78279b0994370385a7208e5422a3110bbbda8698.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86f0006acf85f07c31dc82ac234bfa65e0c8cf7cc81f6068b8703769d9e495a2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"種﨑敦美","creatorId":"vndb:s196","sourcePersonId":"vndb:s196","canonicalEntityId":"vndb:s196","name":"種﨑 敦美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186675:45725:7575:1","source":"bangumi"}]},{"characterId":"char_c50405","characterName":"コトセ","sourceIds":{"bangumi":[{"characterId":"45726","match":"exact-normalized-name-in-linked-work","subjectId":"186675"}],"egsCharacterIds":["10616"],"vndbCharacterId":"c50405"},"originalCharacterName":"コトセ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eldest daughter of three sisters working at Famille."},{"spoiler":false,"text":"At work, she's mainly in charge of tea and drinks on the floor."},{"spoiler":false,"text":"Like a typical eldest daughter, she's caring and somewhat meddlesome."},{"spoiler":false,"text":"She's a refined beauty with graceful behavior, but she takes teasing seriously, making her an older sister worth picking on."},{"spoiler":false,"text":"She likes reading and is a regular at bookstores."},{"spoiler":false,"text":"She's serious about tea, even cultivating tea plants at home."}],"source":"vndb","sourceCharacterId":"c50405"},{"segments":[{"spoiler":false,"text":"ファミーユで働く３姉妹の長女。"},{"spoiler":false,"text":"仕事では主にフロアで紅茶やドリンクの担当をしている。"},{"spoiler":false,"text":"長女らしく世話焼きでややおせっかい。"},{"spoiler":false,"text":"凛とした美人で、立ち居振る舞いもしなやかだけども、からかうと真に受けるので、イジり甲斐のあるお姉ちゃん。"},{"spoiler":false,"text":"読書が好きで本屋の常連。"},{"spoiler":false,"text":"自宅で紅茶の木を栽培していたりする本格派。"}],"source":"egs","sourceCharacterId":"10616","sourceWorkId":"23956","spoiler":false},{"segments":[{"spoiler":false,"text":"ファミーユで働く三姉妹の長女。"},{"spoiler":false,"text":"仕事は主にフロアで、紅茶やドリンクの担当をしている。"},{"spoiler":false,"text":"長女らしく世話焼きでややおせっかい。"},{"spoiler":false,"text":"凛とした美人で立ち居振る舞いもしなやかだけど、"},{"spoiler":false,"text":"からかうと真に受けるので イジり甲斐のあるお姉ちゃん。"},{"spoiler":false,"text":"読書が好きで本屋の常連。"},{"spoiler":false,"text":"自宅で紅茶の木を栽培している本格派。"},{"spoiler":false,"text":"「好きでこんなこと、してるわけないじゃない」"}],"source":"bangumi","sourceCharacterId":"45726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/793346c6414cc3e01dc2a43b1a512361e783ff922d28355d420bd432c3a57d91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccbf93049fda3602ce5c4de15ff1b179c7305c0753036eb9356f01a9eda96dde.webp","width":141,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井ノ上奈々","creatorId":"vndb:s1808","sourcePersonId":"vndb:s1808","canonicalEntityId":"vndb:s1808","name":"井ノ上奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186675:45726:4745:1","source":"bangumi"}]},{"characterId":"char_c50406","characterName":"ユキナ","sourceIds":{"bangumi":[{"characterId":"45727","match":"exact-normalized-name-in-linked-work","subjectId":"186675"}],"egsCharacterIds":["10617"],"vndbCharacterId":"c50406"},"originalCharacterName":"ユキナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The youngest sister of the three sisters."},{"spoiler":false,"text":"At work, she's in charge of customer service and guidance on the floor, as well as making small crafts."},{"spoiler":false,"text":"She's bright, frank, and fearless."},{"spoiler":false,"text":"She likes fun things and is always friendly/approachable, but she's actually the most level-headed among the sisters and observes her surroundings well."},{"spoiler":false,"text":"She's dexterous and skilled at making bookmarks."},{"spoiler":false,"text":"She has a habit of laughing exaggeratedly while showing her teeth, going \"nishishi.\""}],"source":"vndb","sourceCharacterId":"c50406"},{"segments":[{"spoiler":false,"text":"３姉妹の一番末っ子の妹。"},{"spoiler":false,"text":"仕事はフロアで接客案内と小物作りを担当している。"},{"spoiler":false,"text":"明るくてざっくばらんで物怖じしない。"},{"spoiler":false,"text":"楽しいことが好きでいつも飄々としているが、姉妹の中で一番冷静に周りを良く見てたりする。"},{"spoiler":false,"text":"手先が器用で栞作りが得意。"},{"spoiler":false,"text":"にしし、と歯を見せて大げさに笑う癖がある。"}],"source":"egs","sourceCharacterId":"10617","sourceWorkId":"23956","spoiler":false},{"segments":[{"spoiler":false,"text":"三姉妹の一番の末っ子。"},{"spoiler":false,"text":"仕事はフロアで、接客案内と小物作りを担当している。"},{"spoiler":false,"text":"明るくてざっくばらんで物怖じしない。"},{"spoiler":false,"text":"楽しいことが好きでいつも飄々としているが、姉妹の中で一番冷静に周りを見ている。"},{"spoiler":false,"text":"手先が器用で、しおり作りが得意。"},{"spoiler":false,"text":"にしし、と歯を見せて大げさに笑う癖がある。"},{"spoiler":false,"text":"「そういう仕組みなんだからさ。 仕方ないでしょ」"}],"source":"bangumi","sourceCharacterId":"45727"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d58f6ed32f086c56610f04e70abf331478def3a1c74b4917bc692adf4db69ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e24ff8f751872949972cc66ff856f8a44f482653f54515fec500745654747f37.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186675:45727:4809:1","source":"bangumi"}]},{"characterId":"char_c50407","characterName":"レン","sourceIds":{"bangumi":[{"characterId":"45728","match":"exact-normalized-name-in-linked-work","subjectId":"186675"}],"egsCharacterIds":["10618"],"vndbCharacterId":"c50407"},"originalCharacterName":"レン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The girl who arrived at the town together with Shou."},{"spoiler":false,"text":"She ends up working as a live-in employee at Famille, but she's mainly a mascot-like waitress who's not really part of the actual workforce."},{"spoiler":false,"text":"The phrase \"innocent and naive\" fits her perfectly, and her emotional expressions are very honest."},{"spoiler":false,"text":"Her charm matches her appearance and watching her is soothing."},{"spoiler":false,"text":"She has a habit of apologizing right away, but when she seriously apologizes, the guilt you feel is intense because she's so cute, innocent, and sincere-looking that it makes you feel like you've done something terrible."},{"spoiler":false,"text":"She's attached to Shou like a much younger sister would be."}],"source":"vndb","sourceCharacterId":"c50407"},{"segments":[{"spoiler":false,"text":"ショウと一緒に街を訪れた女の子。"},{"spoiler":false,"text":"ファミーユに住み込みで働くことになるが、主にマスコット的な戦力外ウェイトレス。"},{"spoiler":false,"text":"天真爛漫という言葉がぴったりで感情表現が実に素直。"},{"spoiler":false,"text":"見た目通りな愛嬌の良さで見てると和まされる。"},{"spoiler":false,"text":"すぐに謝る癖があるが、本気で謝られると見た目的な意味で罪悪感がすごい。"},{"spoiler":false,"text":"ショウには年の離れた妹のように懐いている。"}],"source":"egs","sourceCharacterId":"10618","sourceWorkId":"23956","spoiler":false},{"segments":[{"spoiler":false,"text":"ショウと一緒に街を訪れた女の子。"},{"spoiler":false,"text":"ファミーユに住み込みで働くことになるが、主にマスコット的な戦力外ウエイトレス。"},{"spoiler":false,"text":"天真爛漫という言葉がぴったりで感情表現が実に素直。"},{"spoiler":false,"text":"見た目通りな愛嬌の良さで、見てると和まされる。"},{"spoiler":false,"text":"すぐに謝る癖があるが、本気で謝られると見た目的な意味で罪悪感がすごい。"},{"spoiler":false,"text":"ショウには年の離れた妹のように懐いている。"},{"spoiler":false,"text":"「はじめまして、だね。 でも自己紹介は要らないよね。お互いに」"}],"source":"bangumi","sourceCharacterId":"45728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a49d86df3e4b209df95e7d481e7cba984d2056c9276ae044fde96e92e5850224.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76533926dc4bad1314a4b25e17c91f7787f20d05a8211629fbae7294250698c8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalE