orId":"vndb:s2125","sourcePersonId":"vndb:s2125","canonicalEntityId":"vndb:s2125","name":"小林 由美子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:52054","source":"vndb"},{"creditedName":"半場 友恵","creatorId":"vndb:s2163","sourcePersonId":"vndb:s2163","canonicalEntityId":"vndb:s2163","name":"半場友恵","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:52055","source":"vndb"},{"creditedName":"千葉 千恵巳","creatorId":"vndb:s2305","sourcePersonId":"vndb:s2305","canonicalEntityId":"vndb:s2305","name":"千葉 千恵巳","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:52056","source":"vndb"},{"creditedName":"天広 直人","creatorId":"vndb:s6862","sourcePersonId":"vndb:s6862","canonicalEntityId":"vndb:s6862","name":"天広 直人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52058","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c4950","characterName":"可憐","sourceIds":{"vndbCharacterId":"c4950"},"originalCharacterName":"可憐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"923"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sweet and gentle, Karen's personality sometimes seems more suitable for an older (rather than younger) sister. She is a very skilled pianist. In the magazine stories and mini-novels, Karen owns a kitten named Vanilla (who, incidentally, has a thing for vanilla flavored sweets). Like several of the sisters, she refers to herself in the third-person and addresses her brother as Onii-chan (お兄ちゃん), a way to call a brother by a younger sibling, usually a child. In English, she calls him \"Big Brother\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4950"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6fa59c594b807721aa18d73980fa10a1ae09002ccb7fe362c896963471e2a32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/699a79970cef9466d37f9a3e76a468a5354aaf3a461a9588283922ca2fc77460.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"桑谷 夏子","creatorId":"vndb:s1143","sourcePersonId":"vndb:s1143","canonicalEntityId":"vndb:s1143","name":"桑谷 夏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28792","source":"vndb"}]},{"characterId":"char_vndb_c4951","characterName":"花穂","sourceIds":{"vndbCharacterId":"c4951"},"originalCharacterName":"花穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"107"},"height":{"reviewState":"source-only","source":"vndb","value":"143"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Despite being a bit clumsy, Kaho is on her school's cheerleading team and loves to cheer her brother on. She is an accomplished gardener, and frequently grows flowers for and with her brother. She refers to herself in the third-person and addresses her brother as Onii-chama (お兄ちゃま), a childish version of onii-sama. In English, she calls him \"Brother\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4951"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02be6eb9a0e42f3659e35a96ef1052fd74453546f551bdfd3ca4d10925a9a09e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24ef77ccf5cb2d9611331a6a3ce341672674e53134ebe3e97471e958852ae670.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"望月 久代","creatorId":"vndb:s1588","sourcePersonId":"vndb:s1588","canonicalEntityId":"vndb:s1588","name":"望月 久代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28795","source":"vndb"}]},{"characterId":"char_vndb_c4952","characterName":"衛","sourceIds":{"vndbCharacterId":"c4952"},"originalCharacterName":"衛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1018"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The athlete of the group, Mamoru is always trying to get her brother to play sports with her. She is sometimes mistaken for Rinrin due to their similar hairstyles and their penchant for donning their eyewear on their head. As she is a tomboy, Mamoru uses phrases and mannerisms that only boys are expected to. As proof of this, she addresses her brother as Anii (あにぃ), a shorter address used by a male teenager. In English, she calls him \"Big Bro\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4952"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5333ae2e76be87b3e37411ed3e639d81f4849dd86c3196b5b8e50c1562a36fe6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/430195cc6b2f426d34b2472171731c771b8d806da850eb691429dd4cf390a55d.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"小林 由美子","creatorId":"vndb:s2125","sourcePersonId":"vndb:s2125","canonicalEntityId":"vndb:s2125","name":"小林 由美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28796","source":"vndb"}]},{"characterId":"char_vndb_c4953","characterName":"咲耶","sourceIds":{"vndbCharacterId":"c4953"},"originalCharacterName":"咲耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1220"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sakuya behaves very much like a modern teenager and is fashion conscious. She would love for her brother to see her as woman and not just a sister."},{"spoiler":false,"text":"Sakuya claims that she and the brother are connected by the \"red string of fate\" and expresses the desire that she might somehow marry her brother. She is quick to agree it would be impossible when in his presence. Sakuya is arguably the most emotionally vulnerable of all the sisters where the brother is concerned, since she goes through extreme emotional reactions when they are separated—or when she anticipates separation. Sakuya frequently uses double entendres and innuendo when speaking to her brother, dismissing her words as jokes when he becomes really flustered. Sakuya addresses her brother as Onii-sama (お兄様) as her sign of admiration."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4953"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af67ed368ca12c50e4e06930f6294b636e965f93d925ae3d26a64159e6d09baf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d351f02a6a070280ab57666af218cbbc3d287851627d26eb0376c13a2cff62e.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28788","source":"vndb"}]},{"characterId":"char_vndb_c4954","characterName":"雛子","sourceIds":{"vndbCharacterId":"c4954"},"originalCharacterName":"雛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"815"},"height":{"reviewState":"source-only","source":"vndb","value":"132"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The youngest of the sisters, Hinako is very much a child and shows her affection accordingly. Hinako frequently insists on her brother reading to her from picture books."},{"spoiler":false,"text":"Hinako refers to herself in the third-person as \"Hina\", dropping the \"-ko\". She addresses her brother as Onii-tama (おにいたま), a more childish version of Kaho's onii-chama. In English, she calls him \"Bro-bro\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4954"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bd89bf5e96afa713caf79f7a8d3d7e20a852f1caff12e79ebced598484460e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20425df1e734f14e87b9a294dc07a31a94a7ee88b712721cfc7ef576a747e616.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"千葉 千恵巳","creatorId":"vndb:s2305","sourcePersonId":"vndb:s2305","canonicalEntityId":"vndb:s2305","name":"千葉 千恵巳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28798","source":"vndb"}]},{"characterId":"char_vndb_c4955","characterName":"鞠絵","sourceIds":{"vndbCharacterId":"c4955"},"originalCharacterName":"鞠絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"404"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Possessing a weak constitution, the bespectacled Marie has spent a lot of time in the hospital due to her illness. Her pet Michael, a Golden Retriever, acts as her guardian and friend when her brother isn't around. She addresses her brother as Aniue-sama (兄上様), the honorific -uesama (a combination of ue and -sama) being used within the royal family or as a sign of politeness. In English, she calls him \"Brother Mine\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4955"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a5c626d0ccb58ebe66176c925ba0f422612f2afbecc829bf5bb9a7b16fb955e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/718fcfc30a0c3fa6e8d9244c6edbc23459b3eb68ee5c20d1a8a6f4070b96fcee.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"柚木 涼香","creatorId":"vndb:s495","sourcePersonId":"vndb:s495","canonicalEntityId":"vndb:s495","name":"柚木 涼香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28790","source":"vndb"}]},{"characterId":"char_vndb_c4957","characterName":"白雪","sourceIds":{"vndbCharacterId":"c4957"},"originalCharacterName":"白雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"211"},"height":{"reviewState":"source-only","source":"vndb","value":"140"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shirayuki loves to cook, especially for her brother, and is always trying out new recipes for him. She refers to herself in the third-person as \"Hime\" (姫), which translates to \"princess\". This might be because of her name's Western variant: Snow White. She also frequently ends her sentences with the phrase \"desu-no.\" She addresses her brother as Nii-sama (にいさま), which is shorter than Sakuya's, but polite. In English, she calls him \"Elder Brother\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1df5ea32caf6c28e96fa83614a2507c65e37530dfff43e845506121c9ad00594.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de76ee1ed31dcd986c7259dd61975e606592bb463670629829f8174e8090721c.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"横手 久美子","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28789","source":"vndb"}]},{"characterId":"char_vndb_c4959","characterName":"鈴凛","sourceIds":{"vndbCharacterId":"c4959"},"originalCharacterName":"鈴凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"709"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Gifted in the fields of science and technology, Rinrin spends a lot of her time building things but constantly asks her brother for monetary donations to keep her projects going. Lately, she's been constructing a robot duplicate of herself, Mecha-Rinrin (メカ鈴凛). She speaks with a strong Chinese accent and addresses her brother as Aniki (アニキ), another way for a boy to address his brother. In English, she calls him \"Bro\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4959"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf8e3a9954e756569236e5ee8af2a97916010e81386aa39a31a8ba2b0a0fb91a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b84e1fc411ff93ed4be29c71b91981c70c3476da6e367bbe8d63c4f9f31f18c2.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"神崎 ちろ","creatorId":"vndb:s1055","sourcePersonId":"vndb:s1055","canonicalEntityId":"vndb:s1055","name":"神崎 ちろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28791","source":"vndb"}]},{"characterId":"char_vndb_c4961","characterName":"千影","sourceIds":{"vndbCharacterId":"c4961"},"originalCharacterName":"千影","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"306"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mysterious, aloof, and occasionally gothic, Chikage is very much into spellcraft, the occult, and religion. She is an accomplished practitioner of dark magic, but prefers to utilize her sorcery in subtle methods, rather than brute power. Common images associated with her are the Christian cross and butterflies."},{"spoiler":false,"text":"Chikage claims that she and the brother have been together in previous lives, possibly as brother and sister, perhaps as lovers. She expresses a desire to have him for herself somehow, but admits that he has refused the offer or simply slipped from her grasp several times throughout their incarnations. Out of all the sisters, she is the only one who entertains thoughts of somehow taking the brother away from the others, and almost executes plans to do so."},{"spoiler":false,"text":"She calls the brother as Ani-kun (兄くん), the suffix -kun being an address to a boy who has a close relation or is about the same age as the addresser, giving the impression that her age is close to him. In English, she calls him \"Brother Darling\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4961"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9665d0b394f8fc169d7b04ccf9f75515952dbdf1082b7c8d4cb9596d00dbe76.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af9c0a1656f8fc7de8c1a7ed35ee70ea6ba50485da7f0f84622a996c61b60ee1.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"川澄 綾子","creatorId":"vndb:s16","sourcePersonId":"vndb:s16","canonicalEntityId":"vndb:s16","name":"川澄 綾子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28787","source":"vndb"}]},{"characterId":"char_vndb_c4963","characterName":"春歌","sourceIds":{"vndbCharacterId":"c4963"},"originalCharacterName":"春歌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"516"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hailing from Germany, Haruka aspires to become a perfect Japanese lady (Yamato Nadeshiko). She is frequently seen wearing a kimono and can be found learning Japanese tea ceremony (sado) along with other cultural things. Haruka is an expert at handling the daikyu and naginata. Interestingly, training in these weapons is akin to the training given to the brides of samurai; Haruka's training in these weapons may or may not have been inspired due to her desire to be a perfect Japanese bride for a person of high standing—like her brother."},{"spoiler":false,"text":"Haruka addresses the brother as Anigimi-sama (兄君さま), the honorific suffix -kimisama (a combinations of the honofirics kimi or kun and -sama) used to address a venerable person in the same bloodline. In English, she calls him \"Beloved Brother\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4963"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bf09ae156f8341a74591892b4eaf4c57dafbad924b41cf7c673e2833bd155f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb3e2e9d36d1020f62c7e1cb306c5df6ae4effd06a612fad4dd88d549afee5fe.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"かかず ゆみ","creatorId":"vndb:s1144","sourcePersonId":"vndb:s1144","canonicalEntityId":"vndb:s1144","name":"かかず ゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28793","source":"vndb"}]},{"characterId":"char_vndb_c4966","characterName":"四葉","sourceIds":{"vndbCharacterId":"c4966"},"originalCharacterName":"四葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"621"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hailing from England (as evidenced by her occasional penchant for anything with a Union Flag), Yotsuba fancies herself a detective à la Sherlock Holmes. She can often be found with either a digital camera or a magnifying glass in hand, trying to spy on her brother. She refers to herself in the third-person and is fond of using the catchphrase, \"Checky!\" (チェキ! Cheki)."},{"spoiler":false,"text":"She addresses her brother as Ani-chama (兄チャマ), which is a childish address similar to Kaho's, but laced with a British accent. In English, she calls him \"Brother Dearest\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4966"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7fede1e22738c0253f013bbf80055dbd2022193c45afafb31d1b65bacac3b98.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d1a99644602dea9613b5544ca71602a4e520082588cce6142c6aedc860b73c7.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"半場 友恵","creatorId":"vndb:s2163","sourcePersonId":"vndb:s2163","canonicalEntityId":"vndb:s2163","name":"半場友恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28797","source":"vndb"}]},{"characterId":"char_vndb_c4967","characterName":"亞里亞","sourceIds":{"vndbCharacterId":"c4967"},"originalCharacterName":"亞里亞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1102"},"height":{"reviewState":"source-only","source":"vndb","value":"139"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hailing from France, Aria is a rather soft-spoken character who has a tendency to cry whenever there is trouble, uttering the phrase \"kusu\" (an onomatopoeia for sniffling) when doing so. She enjoys sweets, especially parfait, and can usually be found wearing very frilly dresses with plenty of lace and bows. She refers to herself in the third-person, which is considered childish in Japanese culture, and speaks slowly."},{"spoiler":false,"text":"She addresses the brother as Nii-ya (兄や) the most childish name for one's brother. In English, she calls him \"Mon Frère\"."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4967"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f8f1e4849604946a3d6a7529c2eee71e2a2ae864f1a39f94ae2237d3d73db08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f562384f4c329051494e2350dc003943bf9159daa46f596ab50ba1a98361e178.webp","width":150,"height":250,"source":"static-detail"},"actors":[{"creditedName":"水樹 奈々","creatorId":"vndb:s1236","sourcePersonId":"vndb:s1236","canonicalEntityId":"vndb:s1236","name":"水樹奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28794","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p137","sourceCompanyId":"egs:brand:623","canonicalEntityId":"vndb:p137","name":"アスキー・メディアワークス","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6830:623","source":"egs"},{"companyId":"vndb:p1063","sourceCompanyId":"vndb:p1063","canonicalEntityId":"vndb:p1063","name":"有限会社スタック","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:10514:v4683","source":"vndb"},{"companyId":"vndb:p5245","sourceCompanyId":"vndb:p5245","canonicalEntityId":"vndb:p5245","name":"MediaWorks","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10515:v4683","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
