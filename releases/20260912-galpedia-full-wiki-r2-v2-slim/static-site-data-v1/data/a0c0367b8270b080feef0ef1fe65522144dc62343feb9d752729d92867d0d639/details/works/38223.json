{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"38223","model":{"presentationWorkId":"vndb:v6487","staff":{"artwork":[],"scenario":[],"music":[{"creditedName":"SENTIVE","creatorId":"vndb:s1051","sourcePersonId":"vndb:s1051","canonicalEntityId":"vndb:s1051","name":"SENTIVE","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:64912","source":"vndb"},{"creditedName":"TAM Music Factory","creatorId":"vndb:s10270","sourcePersonId":"vndb:s10270","canonicalEntityId":"vndb:s10270","name":"多夢","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:64913","source":"vndb"},{"creditedName":"プロパンモード","creatorId":"vndb:s14504","sourcePersonId":"vndb:s14504","canonicalEntityId":"vndb:s14504","name":"プロパンモード","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:64914","source":"vndb"}],"other":[{"creditedName":"and_is_w","creatorId":"vndb:s28655","sourcePersonId":"vndb:s28655","canonicalEntityId":"vndb:s28655","name":"and_is_w","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:64911","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c1866","characterName":"西村博行","sourceIds":{"vndbCharacterId":"c1866"},"originalCharacterName":"西村博行","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A human who moved away from the village 5 years ago. He currently just moved back to the village after receiving a letter from a friend there."},{"spoiler":false,"text":"He shares his name with the founder and former administrator of 2chan."},{"spoiler":false,"text":"From Wikifur"}],"source":"vndb","sourceCharacterId":"c1866"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c1869","characterName":"大島 虎彦","sourceIds":{"vndbCharacterId":"c1869"},"originalCharacterName":"大島 虎彦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"819"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"85"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first person to greet Hiroyuki after he returns to the village. He's a member of the swim team. His family owns an inn, and he helps out at home by studying to be a great chef. He's in 11th grade, the same grade as Hiroyuki. He is very optimistic by nature, and lives with a \"go with the flow\" mentality."},{"spoiler":false,"text":"From Wikifur"}],"source":"vndb","sourceCharacterId":"c1869"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9638507dcdfd7e186a3e67d3714f216cc8dc3b5cba92f2beb022a7251cea3b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/580f5a3ccb9f95d49ced3a99c5d2bc71beb0a0f64c44bfa331a67e42bf062130.webp","width":224,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1870","characterName":"黒井 深","sourceIds":{"vndbCharacterId":"c1870"},"originalCharacterName":"黒井 深","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"710"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cat that lives on the outskirts of the village in a western styled house. He has a slender and handsome figure, perfect reflexes, and gets good grades, but he has poor physical strength. He can be a little stuck up. He has asthma. He makes sweets to keep his mind off things whenever he feels down."},{"spoiler":false,"text":"From Wikifur and TV Tropes"}],"source":"vndb","sourceCharacterId":"c1870"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fa9011b461c6b02cf7751a606d925016aafc03ccd57f316c9c938da228a53e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7b89dce12b77047d6809f1f623c4418e3a2b463ec1de77cab09f40737450a18.webp","width":224,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1872","characterName":"翠屋辰樹","sourceIds":{"vndbCharacterId":"c1872"},"originalCharacterName":"翠屋辰樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"114"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"210"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"135"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dragon and a gentle giant. He does have wings, but they're too small for flight. His father is a master carpenter; as a result, he wants to be one, too, someday. He's known to be accident prone, and him driving a car leads to disastrous results. Tatsuki gets really horny when he drinks a lot of sake."},{"spoiler":false,"text":"From Wikifur"}],"source":"vndb","sourceCharacterId":"c1872"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/621c4172d9977c345c60e004853fe6bfd51304d9941857ca166265aac47c8e3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75413caa59dce3664a25cb54cd5e242436d3994b4052339790e08a1ce8c3627d.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1876","characterName":"蒼月 洸哉","sourceIds":{"vndbCharacterId":"c1876"},"originalCharacterName":"蒼月 洸哉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"402"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouya is normally calm, but he can get mad quickly. He also is sort of stubborn. He lives by himself at home after separating from his parents, graduating middle school, and makes a living by working. Kouya is also part of a band."},{"spoiler":false,"text":"From Wikifur"}],"source":"vndb","sourceCharacterId":"c1876"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91724a285bba526b5da9fb78255cc47625ddbd3251b7f6b3559b4883f70a50d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/338789fd48756c509b89aea4fc4df4fc271b5fc013fb0abce60be0658544fb48.webp","width":224,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1877","characterName":"古酉峻","sourceIds":{"vndbCharacterId":"c1877"},"originalCharacterName":"古酉峻","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"704"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shun is a wolf that is going to attend his first year of high school after this summer vacation. He tends to cry and/or panic a lot. He also is greatly attached to Hiroyuki. Shun also has a love of video games."},{"spoiler":false,"text":"edited from Wikifur"}],"source":"vndb","sourceCharacterId":"c1877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e019d6dde168c189bcd4e078271616d8c7409e013486ccc8b571668126480493.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6624a338824129c738fcfd9a28682434e9d9c728c9db6706b0571f85bf7a5b28.webp","width":232,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1878","characterName":"橙野宗太郎","sourceIds":{"vndbCharacterId":"c1878"},"originalCharacterName":"橙野宗太郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"921"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Soutarou is a lion who moved to the village 3 years ago. He's introduced to Hiroyuki by Kyouji. He's a little timid, and has grown up without a father. He is close to Kyouji, because he's the captain of his soccer team."},{"spoiler":false,"text":"From Wikifur"}],"source":"vndb","sourceCharacterId":"c1878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/241b9ae02a2b303a2d64a7439a15c68a4d23e030a4b06769c193b67d348ae34d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e73bae88af674630e64073f4ea28c3b79f4d24fd955f0980d2198a3c4280daa.webp","width":248,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1879","characterName":"三日月 柔一","sourceIds":{"vndbCharacterId":"c1879"},"originalCharacterName":"三日月 柔一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"619"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"191"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"111"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Juuichi is a senior in high school. He is also an expert at Judo. Even though his face makes it look like he's in a bad mood all the time, he really isn't. He seems to hate being called fat, remaking such comments as him being \"big-boned\" or that his fat is muscle. Juuichi also has a younger twin brother."},{"spoiler":false,"text":"From Wikifur"}],"source":"vndb","sourceCharacterId":"c1879"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3694442cd3ed00ec8b9ea680fb6ae0ca11a7b2a3f587f6387196330ada246805.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16ded2f820bc5ad3538ff4217e9a7ce3c789dbdbfd7f83059d55f83883001ac2.webp","width":224,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1880","characterName":"高原京慈","sourceIds":{"vndbCharacterId":"c1880"},"originalCharacterName":"高原京慈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"187"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"75"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a dog in his third year of high school. Gentle with everyone, he always finds a way to help out in one way or another. Everybody relies on his calm personality. He also serves as the captain of the soccer club. He does nothing but practice every day in order to dominate the tournament this summer. He is known for his clever tactics. He is not perfect, however. He's not good with thunder and ghosts. He is also a little timid and doesn't always say his honest opinion."},{"spoiler":false,"text":"from TVTropes"}],"source":"vndb","sourceCharacterId":"c1880"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b29a63762d3891d5e796f78e335313d1bff69282dc3b016c466c7e1885b4f9fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdfd06b9c0cfbebfe2c93e64e7b57b00707fa87d4d76455b31e4115eba0703f4.webp","width":224,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1881","characterName":"九狸 孝之助","sourceIds":{"vndbCharacterId":"c1881"},"originalCharacterName":"九狸 孝之助","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1022"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"73"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He easily gets carried away with optimism. He likes to live life in a tempo out of step with everyone else's. Although the things he does might irritate those around him, he means no offense. Thanks to his innocent appearance they just sigh and leave it there. He loves \"new things\" and \"things he has never seen before\". He often returns from the city with lots of stuff he's interested in. He is thinking about living in the city in the future."},{"spoiler":false,"text":"from TVTropes"}],"source":"vndb","sourceCharacterId":"c1881"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a20c63da7e4e003620cfd14d344aba25dc24728183445843edc9803d94b6715.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0af8ef9b7cb72157a82c85bb36ec02b2b0f4ea97cc040ebdc0528b0d07aad1ff.webp","width":248,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c19899","characterName":"二階堂 明","sourceIds":{"vndbCharacterId":"c19899"},"originalCharacterName":"二階堂 明","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the son of a famous architect. When he was 17, he rebelled against his father, left home, and joined the Midoriya Group. Because of this, he is trying to build a relationship with Tatsuki and Tappei. Incidentally, he doesn't like talking to them about running away from home. The other workers don't understand the theories behind his job the way he does, but when he talks about the data and mechanics of construction he gets Tappei's fist. His frankness doesn't mean that he is conceited, but it often leads to misunderstandings. His fellow workers think that he and Tatsuki make good rivals."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c19899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ca0c478ed9edbb49cddd07560fe57bd08533ed85f4ca66dbe09c2559a4a7c67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6626ff24158ad19a58f9422d9ebaed918add4601f7bbca4eb1789879d0a9aedf.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c19900","characterName":"銅牡丹","sourceIds":{"vndbCharacterId":"c19900"},"originalCharacterName":"銅牡丹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"42"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a 42-year-old boar. Because he is the only teacher in the village, he was the main character's teacher. He is a kind teacher, but fearsome when angered. These days he has grown fat, but he used to be an active rugby player. Although he does have a house in the village, he spends so much time keeping watching of the school that the janitor's closet has become his second home. He is Tappei's drinking buddy, but their relationship swings back and forth between public and private."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c19900"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1e22ab280f6306fcbb7a317a9ff6e02dd47609b3869177665ab3cedd360fd85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44e4ce3bb4108b3620ccc2b3ccaf2b5ecd7f6bbd04a8787a726632b1dc0f9ca3.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c19928","characterName":"翠屋 辰平","sourceIds":{"vndbCharacterId":"c19928"},"originalCharacterName":"翠屋 辰平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"43"},"height":{"reviewState":"source-only","source":"vndb","value":"232"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is Tatsuki's father and head of the Midoriya Group. He is an obstinate and domineering husband. A heavy drinker, like a true Tokyo-ite, who gives the impression of a true craftsman. While working outside he is a cheerful and playful old man. At 232 cm (~7′ 7″), he is considerably taller than Tatsuki, so much so that even socks don't fit him. He loves to smoke his pipe and is bad with machines. His wife bosses him around -- he is truly no match for her. He is a lover of both men and women, a bisexual DILF.''"},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c19928"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/563d912b7b791088f31d9dc15bd22edd6536ac6af31174efa6e67f9df888816d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/010c3958a1a1257f098949ee53d4e72ca0900eacdc81cc704dc4434534bdfc6c.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c19929","characterName":"翠屋ゆきの","sourceIds":{"vndbCharacterId":"c19929"},"originalCharacterName":"翠屋ゆきの","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"41"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tatsuki's mother. She is shorter than both Tatsuki and Tappei. Her gentle, big-hearted nature makes it clear that Tatsuki takes care of his mother. As someone capable of skillfully handling Tappei, they make good for a married couple."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c19929"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c19930","characterName":"井上 哲也","sourceIds":{"vndbCharacterId":"c19930"},"originalCharacterName":"井上 哲也","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"36"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a calm veteran carpenter who works for the Midoriya family. Definitely skilled, he is respected by those around him and serves as the senior apprentice. His wife and daughter live at home while he stays with the Midoriya Group. He returns home to visit them every day. Because of his levelheadedness, competency, and gentle nature, newer apprentices to the Midoriya Group are extremely dependent on him. He is usually the one who calms Tappei's temper by using a carrot-and-the-stick routine. To Chuukichi, he is \"Merciful Tetsu-san\"."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c19930"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83911b31d788f5a0ca38061779dc8e5b6ea8cf236f9ab08d81b8f677024297ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7532c7b1d4fcabd649327bdb76b7e774d0d48ad9f39d2ffa059cb2e880aca32.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c19931","characterName":"森忠吉","sourceIds":{"vndbCharacterId":"c19931"},"originalCharacterName":"森忠吉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a 16-year-old mouse. He dove right into society when he graduated from junior high. He has a juvenile habit of saying \"-ssu\". He has a simple and friendly personality, and his job brings out his enthusiasm. He loves the Midoriya Group, but has a bit of bad luck and somehow almost always ends up getting the short end of the stick. Despite this, he doesn't let it get him down. He is the mood maker of the Midoriya Group. He used to be quite mean... He has never seen a human up close before, and his inexperienced hands make his heart thump. Number of times he is beaten throughout the game: 23."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c19931"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7ab16404143abe421ebb19801f16ae35555db6eeb3f2b7c3c66ccc635f0db3f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2db10f62898078e5f8da23baee31d16ee032b9202b727dfbc9a3a533254bf083.webp","width":256,"height":249,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c19932","characterName":"橘時雨","sourceIds":{"vndbCharacterId":"c19932"},"originalCharacterName":"橘時雨","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a 68-year-old dog. He is a person who is aloof from the world. He and Tatsuki's grandfather, Tappei's father, were close friends. Now he is friends with Tappei and Mr. Botan. Tappei's robustness and Shigure's frailty make them completely opposite types. He likes new things, and his hobby is watching TV shopping programs. He is active in restoring the village and attracting new people, and the happiness of the villagers is his number one priority. The current mayor, he gently watches over the people of his village."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c19932"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c79e556c8ce1f2b90e452dd87e757a127ed2598353da2d3742a6e4551ed0e56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3ffba9e0d38ecca30abf7d10d35117e04963b5961fbaf4d585dcdffd2f1eff5f.webp","width":230,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c19933","characterName":"九狸 幸春","sourceIds":{"vndbCharacterId":"c19933"},"originalCharacterName":"九狸 幸春","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is Kounosuke's little brother. They are a few years apart in age. He is currently in his fifth year at Minasato Elementary School. He used to be very shy and reserved, always hiding himself behind Kounosuke. Now he isn't shy at all and is becoming a follow-up to his brother. He has a cheerful personality because of his brother's influence. Recently he has been becoming less dependent on his brother. This seems to make Kounosuke a little lonely."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c19933"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dca8851d30930f02e81d0abc45b4f7cb5bd7cc893356352d008752c41b992652.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6116f2c4f5dd144b9a6c11331acf1eba9f3cc36b950919dc3840b605ea10ab5.webp","width":256,"height":219,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20047","characterName":"古酉巓","sourceIds":{"vndbCharacterId":"c20047"},"originalCharacterName":"古酉巓","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The captain of Juuichi's judo team."}],"source":"vndb","sourceCharacterId":"c20047"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bec0e19fac9c912ca83032afb715ad9b91b9ba4c6ed2bd3cbbdac2449d1d71b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7e53a726e9137f5c90dee185be7197851356782f4a8b0d92fad99c384d1064d.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20048","characterName":"天木 月代","sourceIds":{"vndbCharacterId":"c20048"},"originalCharacterName":"天木 月代","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shin's butler."}],"source":"vndb","sourceCharacterId":"c20048"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2011079aaf152e1777e06c8803e8199953ec06b141c2ae4eeb9ee637ad41572b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f573fdffc97e0c6355fd308be9f6d077888f2cd6c4f6cffd32663f235ecdad1.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20049","characterName":"古酉巌","sourceIds":{"vndbCharacterId":"c20049"},"originalCharacterName":"古酉巌","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shun's grandfather. Old-fashioned and stubborn, values his family's social standing above all else, and current family head of the Minasoto Kodori family."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c20049"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c20050","characterName":"古酉 岳","sourceIds":{"vndbCharacterId":"c20050"},"originalCharacterName":"古酉 岳","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An employee at Kazenari Town's game store. The grandchild of Shun's grandfather's older brother, the equivalent of a so-called cousin, and older brother. His love of games is also a common point and is taken to well."},{"spoiler":false,"text":"With game store abundant with new works and an assortment of products, this wolf beastman works comparatively sullenly. Has bad eyes, lacks sleep, and has an unhealthily thin body. His favorite things are alcohol and cotton swabs. He doesn't blow. He doesn't like environments where Shun cannot find happiness."},{"spoiler":false,"text":"The name of the main character who left 5 years ago, which is brought up by Shun with a smile at each and every opportunity, is troublesome and awfully worrying to him these days."},{"spoiler":false,"text":"From TV Tropes"}],"source":"vndb","sourceCharacterId":"c20050"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf1f04da6d4be4db3f91ccfa8dbe9596b0a9fea8a2e7a820b2e793776c0387f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c414a3ecb675dd8af808dc873e340bffba1c19ec31094a9e9250fbe91746ec55.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1913","sourceCompanyId":"egs:brand:8824","canonicalEntityId":"vndb:p1913","name":"漏れなつプロジェクト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:38223:8824","source":"egs"},{"companyId":"vndb:p13934","sourceCompanyId":"vndb:p13934","canonicalEntityId":"vndb:p13934","name":"Ghinsan","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:105915:v6487","source":"vndb"},{"companyId":"vndb:p18768","sourceCompanyId":"vndb:p18768","canonicalEntityId":"vndb:p18768","name":"Nekojin","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:119607:v6487","source":"vndb"},{"companyId":"vndb:p23688","sourceCompanyId":"vndb:p23688","canonicalEntityId":"vndb:p23688","name":"rtlstien","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:142741:v6487","source":"vndb"},{"companyId":"vndb:p23688","sourceCompanyId":"vndb:p23688","canonicalEntityId":"vnd