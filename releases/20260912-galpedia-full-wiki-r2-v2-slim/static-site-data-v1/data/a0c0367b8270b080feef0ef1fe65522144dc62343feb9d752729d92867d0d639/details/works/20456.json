{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20456","model":{"presentationWorkId":"vndb:v15019","staff":{"artwork":[{"creditedName":"KYO燈弥(京極燈弥)","creatorId":"vndb:s4227","sourcePersonId":"egs:creator:17079","canonicalEntityId":"vndb:s4227","name":"KYO燈弥(京極燈弥)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:131293","source":"egs"}],"scenario":[{"creditedName":"鷹之爪","creatorId":"vndb:s3617","sourcePersonId":"egs:creator:15113","canonicalEntityId":"vndb:s3617","name":"鷹之爪","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:131294","source":"egs"}],"music":[],"other":[{"creditedName":"Barry Bee","creatorId":"vndb:s27727","sourcePersonId":"vndb:s27727","canonicalEntityId":"vndb:s27727","name":"Barry B. Benson","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:109182","source":"vndb"}]},"cast":[{"characterId":"char_c17971","characterName":"謙信","sourceIds":{"bangumi":[{"characterId":"205274","match":"exact-normalized-name-in-linked-work","subjectId":"223551"}],"egsCharacterIds":["3596"],"vndbCharacterId":"c17971"},"originalCharacterName":"謙信","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"骨董品に封じられていた戦国武将の上杉謙信の魂が現世に現れたもの。"},{"spoiler":false,"text":"生真面目で冷静沈着、クールな美少女。"},{"spoiler":false,"text":"自分に対してストイックで常に正々堂々としている。"},{"spoiler":false,"text":"戦上手で武勇の誉れ高く、無益な殺生や卑怯な戦いを嫌う。"},{"spoiler":false,"text":"戦国時代に子を残せなかったのを悔いており、現世で主人公に子作りを頼む。"},{"spoiler":false,"text":"非常に初心で性的知識もなく、子作りをしたいという思いがあるがＨは破廉恥だとして嫌っている。"},{"spoiler":false,"text":"領民への気遣いから普段は少食だが、戦や大事になると大食になる。"},{"spoiler":false,"text":"また実は大酒飲み。しかし戦ばかりしてきたため、料理など女性的なことは苦手。"},{"spoiler":false,"text":"信玄とは永遠のライバルであり犬猿の仲であるが、その実力は認めており、フェアな勝負で雌雄を付けたいと考えている（かつて信玄に塩を送った故事など。"},{"spoiler":false,"text":"勝負にこだわる性質で、子作りにおいても何かと勝負したがる）。"}],"source":"egs","sourceCharacterId":"3596","sourceWorkId":"20456","spoiler":false},{"segments":[{"spoiler":false,"text":"骨董品に封じられていた戦国武将・上杉謙信の魂が現世に現れたもの。"},{"spoiler":false,"text":"生真面目で冷静沈着、クールな美少女。 自分に対してストイックで常に正々堂々としている。"},{"spoiler":false,"text":"戦上手で武勇の誉れ高く、無益な殺生や卑怯な戦いを嫌う。"},{"spoiler":false,"text":"戦国時代に子を残せなかったのを悔いており、現世で主人公に子作りを頼む。"},{"spoiler":false,"text":"非常に初心で性的知識もなく、子作りをしたいという思いがあるがエッチは破廉恥だとして嫌っている。"},{"spoiler":false,"text":"領民への気遣いから普段は少食だが、戦や大事になると大食になる。 また実は大酒飲み。"},{"spoiler":false,"text":"しかし戦ばかりしてきたため、料理など女性的なことは苦手。"},{"spoiler":false,"text":"信玄とは永遠のライバルであり犬猿の仲であるが、その実力は認めており、フェアな勝負で雌雄を決したいと考えている。"}],"source":"bangumi","sourceCharacterId":"205274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15cfe7b1fc19d32bfbafbd9f0081327e881344ce96b96dacd325f2871ecb9102.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a58d8be1608ecc369469dedc26a587dc2addd83139f667da3d62dc32d01b2028.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c17972","characterName":"信玄","sourceIds":{"bangumi":[{"characterId":"205275","match":"exact-normalized-name-in-linked-work","subjectId":"223551"}],"egsCharacterIds":["3597"],"vndbCharacterId":"c17972"},"originalCharacterName":"信玄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"骨董品に封じられていた戦国武将の武田信玄の魂が現世に現れたもの。"},{"spoiler":false,"text":"一見落ち着いた感じのお姉さんだが、実は悪戯で挑発的。"},{"spoiler":false,"text":"また、山国甲斐の生まれのため、海にはしゃぐような天真爛漫な面もある。"},{"spoiler":false,"text":"謙信と並ぶほどの戦上手であり、勇猛果敢なだけでなく大胆な知略も備えている。"},{"spoiler":false,"text":"謙信と同じく子を残せなかったのを悔いており、主人公に子作りを迫る。"},{"spoiler":false,"text":"処女ながらＨには積極的で、戦の時に見せたような大胆さで誘惑してきたりする。"},{"spoiler":false,"text":"一方で戦ばかりに明け暮れたため、恋愛感情には不慣れで乙女っぽく照れたりする。"},{"spoiler":false,"text":"また、意外に勉強家で現代のＨな文化についても貪欲。"},{"spoiler":false,"text":"武田騎馬軍団を率いてきただけあって乗馬の天才であり、騎乗位も得意。"},{"spoiler":false,"text":"戦国時代の癖でトイレで長考する。"},{"spoiler":false,"text":"謙信は良きライバル。"}],"source":"egs","sourceCharacterId":"3597","sourceWorkId":"20456","spoiler":false},{"segments":[{"spoiler":false,"text":"骨董品に封じられていた戦国武将・武田信玄の魂が現世に現れたもの。"},{"spoiler":false,"text":"一見落ち着いた感じのお姉さんだが、実はイタズラで挑発的。"},{"spoiler":false,"text":"また、山国甲斐の生まれのため、海にはしゃぐような天真爛漫な面もある。"},{"spoiler":false,"text":"謙信と並ぶほどの戦上手であり、勇猛果敢なだけでなく大胆な知略も備えている。"},{"spoiler":false,"text":"謙信と同じく子を残せなかったのを悔いており、主人公に子作りを迫る。"},{"spoiler":false,"text":"処女ながらエッチには積極的で、戦の時に見せたような大胆さで誘惑してきたりする。"},{"spoiler":false,"text":"一方で戦ばかりに明け暮れたため、恋愛感情には不慣れで乙女っぽく照れたりする。"},{"spoiler":false,"text":"また意外に勉強家で、現代のエッチな文化についても貪欲。 武田騎馬軍団を率いてきただけあって乗馬の天才であり、騎乗位も得意。"},{"spoiler":false,"text":"戦国時代の癖でトイレで長考する。 謙信は良きライバル。"}],"source":"bangumi","sourceCharacterId":"205275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f2b65caf61e755bf5977143f72a6de7498a8e3fb4ad6bc4e21fdae45780c799.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf686136d3c0a4ec92ff7108be56f8cd34cd8de0f3cbf687146e4c04f679e393.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c90174","characterName":"Jun","sourceIds":{"vndbCharacterId":"c90174"},"originalCharacterName":"Jun","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p314","sourceCo