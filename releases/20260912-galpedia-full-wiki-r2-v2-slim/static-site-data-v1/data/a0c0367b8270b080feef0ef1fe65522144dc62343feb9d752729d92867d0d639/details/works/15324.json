{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15324","model":{"presentationWorkId":"vndb:v7064","staff":{"artwork":[{"creditedName":"鈴平ひろ(一条ジョニー)","creatorId":"vndb:s1348","sourcePersonId":"egs:creator:648","canonicalEntityId":"vndb:s1348","name":"鈴平ひろ(一条ジョニー)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:95840","source":"egs"}],"scenario":[{"creditedName":"あごバリア","creatorId":"vndb:s1130","sourcePersonId":"egs:creator:317","canonicalEntityId":"vndb:s1130","name":"あごバリア","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:95841","source":"egs"}],"music":[{"creditedName":"マッツミュージックスタジオ(M.U.T.S.MusicStudio)","creatorId":"vndb:s414","sourcePersonId":"egs:creator:19409","canonicalEntityId":"vndb:s414","name":"マッツミュージックスタジオ(M.U.T.S.MusicStudio)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:241825","source":"egs"},{"creditedName":"松本 慎一郎","creatorId":"vndb:s4930","sourcePersonId":"vndb:s4930","canonicalEntityId":"vndb:s4930","name":"松本 慎一郎","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:68854","source":"vndb"},{"creditedName":"BAL","creatorId":"vndb:s5190","sourcePersonId":"vndb:s5190","canonicalEntityId":"vndb:s5190","name":"BAL","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:68855","source":"vndb"}],"other":[{"creditedName":"Riryka(みるくくるみ)","creatorId":"vndb:s1847","sourcePersonId":"egs:creator:7436","canonicalEntityId":"vndb:s1847","name":"Riryka(みるくくるみ)","detail":"OP曲 「MEMORY IMPACT」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:110278","source":"egs"},{"creditedName":"あごバリア","creatorId":"vndb:s1130","sourcePersonId":"egs:creator:317","canonicalEntityId":"vndb:s1130","name":"あごバリア","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:110280","source":"egs"},{"creditedName":"あごバリア","creatorId":"vndb:s1130","sourcePersonId":"vndb:s1130","canonicalEntityId":"vndb:s1130","name":"あごバリア","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:68851","source":"vndb"},{"creditedName":"鈴平 ひろ","creatorId":"vndb:s1348","sourcePersonId":"vndb:s1348","canonicalEntityId":"vndb:s1348","name":"鈴平 ひろ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:68852","source":"vndb"},{"creditedName":"Riryka","creatorId":"vndb:s1847","sourcePersonId":"vndb:s1847","canonicalEntityId":"vndb:s1847","name":"Riryka","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:68853","source":"vndb"}]},"cast":[{"characterId":"char_c31021","characterName":"橘 皐月","sourceIds":{"bangumi":[{"characterId":"11272","match":"exact-normalized-name-in-linked-work","subjectId":"12092"},{"characterId":"11272","match":"exact-normalized-name-in-linked-work","subjectId":"16778"}],"egsCharacterIds":["10175"],"vndbCharacterId":"c31021"},"originalCharacterName":"橘 皐月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"331"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と一つ違いの実の妹。"},{"spoiler":false,"text":"勉強や運動に関しては中の中と普通だが、容姿端麗、性格温厚、よく気が付いて家事手伝いが趣味という、男性相手の長所をこれでもかと持つ少女。"},{"spoiler":false,"text":"むろん学園の生徒達にも、一学年～三学年まで問わず人気者。"},{"spoiler":false,"text":"女子にも、その気の付くところが気に入られているらしく、マスコットのように可愛がられている。"},{"spoiler":false,"text":"が、それらのすべての長所を易々と打ち消す重度のブラコンは、もはや周囲の誰もが『だって皐月だし』で納得してしまうレベル。"},{"spoiler":false,"text":"「すみません。重い荷物を持って帰ってきたお兄ちゃんを癒すことのが最優先だって思ったので」"}],"source":"egs","sourceCharacterId":"10175","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・大地の実の妹で、極度のブラコン『妹』。"},{"spoiler":false,"text":"兄の役に立つ、世話をするを人生のすべてとし、家事を始めとするすべてを完璧にこなす完璧少女。"},{"spoiler":false,"text":"周囲に、どうしてこれだけの娘が兄一筋なんて間違った道を……"},{"spoiler":false,"text":"……と悔やまれているがすでにもう諦めた連中が大半なので、どちらかというと風物詩の一種かもしれない。"},{"spoiler":false,"text":"子供の頃から将来の夢は『お兄ちゃんのお嫁さん♪』。"},{"spoiler":false,"text":"それはどんな事件があろうと、どんな娘が大地の前に現れようと、揺らぐことのない彼女の信念。"},{"spoiler":false,"text":"むしろ揺らぐと世界が終わる。"}],"source":"egs","sourceCharacterId":"10175","sourceWorkId":"15324","spoiler":false},{"segments":[{"spoiler":false,"text":"茜桥东学园1年级。比主人公小1岁的实妹。"},{"spoiler":false,"text":"学习与运动虽然很普通，但容姿端丽，性格温厚，又很贴心，以帮助家务为兴趣，堪称拥有贤妻良母的一切优点的少女。"},{"spoiler":false,"text":"在女生中也被当做吉祥物一般疼爱着，不问学年的人气者。虽然有点慢性子，但一直精神无比乐观开朗的气氛制造者。"},{"spoiler":false,"text":"但是，兄控重度到了足以抵消这些所有优点的程度。已经到了周围任何人都能以一句「是那个皐月啊」自我谅解的程度。"},{"spoiler":false,"text":"从前，创造了面对「将来的梦想是？」的询问，立刻回答「哥哥的新娘?」的传说。至于这个梦想有没有改变呢只有神……就算不是神那也是一目了然。"},{"spoiler":false,"text":"「不好意思。我认为治愈拿着重重的行李回来的哥哥是最优先事项」"}],"source":"bangumi","sourceCharacterId":"11272"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11272","value":"帮忙家务、扫除、给房间改头换面"},{"label":"特技","source":"bangumi","sourceCharacterId":"11272","value":"比闹钟正好早5分钟醒来"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0d2d522ea811cf20323838bb59969c5ac3efbc52d75b14afe35eeb4f4c2ae94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1a937ec1a468e76bcae6412b5adf1f9683a4398863ebcfed63395b08ff57c20.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤森 ゆき奈","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:38532","source":"vndb"}]},{"characterId":"char_c31026","characterName":"七色 真白","sourceIds":{"bangumi":[{"characterId":"139737","match":"exact-normalized-name-in-linked-work","subjectId":"16778"}],"egsCharacterIds":["10176"],"vndbCharacterId":"c31026"},"originalCharacterName":"七色 真白","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"茜橋に新たに現われた五人目の十二星座。"},{"spoiler":false,"text":"『蟹座』の称号を持つ。"},{"spoiler":false,"text":"感情を表に出すのが得意ではなく、口数もあまり多くはない。"},{"spoiler":false,"text":"が、運命と宿命という設定に弱く、このキーワードが心の琴線に触れた瞬間、饒舌にして表情豊かな危険人物へと変化する。"},{"spoiler":false,"text":"皐月の大地への愛に運命を感じた彼女は、その星座としての力をもって協力。"},{"spoiler":false,"text":"もっとも、それが吉と出るかどうかは誰も知らない……。"}],"source":"egs","sourceCharacterId":"10176","sourceWorkId":"15324","spoiler":false},{"segments":[{"spoiler":false,"text":"茜橋に新たに現れた五人目の十二星座。 蟹座の称号を持つ。"},{"spoiler":false,"text":"感情を表に出すのが得意ではなく、口数もあまり多くはない。"},{"spoiler":false,"text":"が、運命と宿命という設定に弱く、このキーワードが心の琴線に触れた瞬間、饒舌にして表情豊かな危険人物へと変化する。"},{"spoiler":false,"text":"皐月の大地への愛に運命を感じた彼女は、その星座としての力をもって協力。"},{"spoiler":false,"text":"もっとも、それが吉と出るかどうかは誰も知らない……。"}],"source":"bangumi","sourceCharacterId":"139737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/884e0cd24a0c5e4c8b47da765325c3c710321a70f2cd12a007dfbee151b4f598.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbb5d9be24aef05cfa32f2ae612f24a