abel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16080","source":"vndb"}]},"cast":[{"characterId":"char_c8708","characterName":"一ノ瀬 悠夏","sourceIds":{"bangumi":[{"characterId":"36673","match":"exact-normalized-name-in-linked-work","subjectId":"153710"},{"characterId":"36673","match":"exact-normalized-name-in-linked-work","subjectId":"43337"}],"egsCharacterIds":["17937"],"vndbCharacterId":"c8708"},"originalCharacterName":"一ノ瀬 悠夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"716"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく好奇心旺盛、元気ハツラツな転校生。"},{"spoiler":false,"text":"素直、無邪気、一直線、思ったら即行動し、何にでも反応を示す。"},{"spoiler":false,"text":"冒険大好きっ子な主人公とは、出会ってすぐ意気投合。"},{"spoiler":false,"text":"“ついに巡り合った仲間”という強い想いを抱いて、お互いを唯一無二の相棒と認識、街中を一緒に駆けまわる。"}],"source":"egs","sourceCharacterId":"17937","sourceWorkId":"9124","spoiler":false},{"segments":[{"spoiler":false,"text":"一見、正統派美少女、中身は冒険大好きアクティブ娘。"},{"spoiler":false,"text":"思い立ったら即行動、持ち前の好奇心で突き進む。"},{"spoiler":false,"text":"弘太という生涯のパートナーを得てからは、周囲の人間を照れさせるほどのラブイチャっぷりを日々披露♪"},{"spoiler":false,"text":"もはや、悠夏のアドベンチャー（暴走）を止められるモノなど存在しないのだ!!"}],"source":"egs","sourceCharacterId":"17937","sourceWorkId":"10993","spoiler":false},{"segments":[{"spoiler":false,"text":"弘太たちの学園に転校してきた女のコ。パッと見は落ち着いた正統派お嬢様風だけど、中身は明るく好奇心旺盛で、とにかく生き生きとしたはつらつ少女。"},{"spoiler":false,"text":"素直で無邪気、一直線。感覚のまま即行動し、なんにでもいい反応を示す性格で、いつもキラキラ輝いてるみたいな、最近では珍しいくらいのピュアな女の子。"},{"spoiler":false,"text":"『探検』や『冒険』が大好きで、この街でも引っ越してきて早々、秘密基地を作ったり街の探検マップを作ったり。"},{"spoiler":false,"text":"似たもの同士の弘太とは、出会ってすぐに意気投合。お互い「ついに巡り合った仲間」という思いを抱き、唯一無二の相棒として、街中を一緒に駆け回ることとなる。"}],"source":"bangumi","sourceCharacterId":"36673"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"17937","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"17937","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"17937","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"17937","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"17937","sourceWorkId":"10993","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e59ccf99e69b800b2eeac46886d82df8b1e0cf4e31180f6b03e10a2ff4f13561.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc1d67fa2006eefd7cac7e5b5270b1c6514d2fe25d27ca0b7aa1bcde089d368d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153710:36673:4490:1","source":"bangumi"}]},{"characterId":"char_c8709","characterName":"望月 真穂","sourceIds":{"bangumi":[{"characterId":"36674","match":"exact-normalized-name-in-linked-work","subjectId":"153710"},{"characterId":"36674","match":"exact-normalized-name-in-linked-work","subjectId":"43337"}],"egsCharacterIds":["17938"],"vndbCharacterId":"c8709"},"originalCharacterName":"望月 真穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"609"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっとり気弱な小動物系の幼馴染。"},{"spoiler":false,"text":"コツコツ努力する頑張り屋なのだが、肝心なところで抜けているので、いっつもアワアワしている。"},{"spoiler":false,"text":"小柄なワリにグラマラスなムッチリ体型で、思考形態もエロっちく、人の視線や言葉尻りに、一人でドギマギ赤面することもしばしば。"},{"spoiler":false,"text":"主人公をずっと好きで、同じクラスになった今、密かに意気込んでいるが……。"}],"source":"egs","sourceCharacterId":"17938","sourceWorkId":"9124","spoiler":false},{"segments":[{"spoiler":false,"text":"気弱で小動物チック、受身系だった真穂も、"},{"spoiler":false,"text":"弘太や悠夏に振り回されているうちに、彼女の美点"},{"spoiler":false,"text":"「頑張り屋さん」を表に出せるようになってきた様子。"},{"spoiler":false,"text":"とはいえ、エロエロな妄想癖は健在……ではなく、パワーアップ！"},{"spoiler":false,"text":"弘太との仲も深まった現在では、ますますエロい……いやいやエラい事に!?"}],"source":"egs","sourceCharacterId":"17938","sourceWorkId":"10993","spoiler":false},{"segments":[{"spoiler":false,"text":"弘太の幼なじみ。受身で怖がり、恥ずかしがり屋、おっとり気弱な子犬系。"},{"spoiler":false,"text":"基本的には物事をよく観察し、コツコツ努力する頑張り屋さんだけど、肝心な所でどうも抜けていて、アワアワしがちな女の子。"},{"spoiler":false,"text":"が、そんな小動物感を補ってあまりあるほど、万事において妙にエロっちい彼女。小柄なわりに体型はむっちりグラマラスで、思考形態も妙にエロス。"},{"spoiler":false,"text":"人の視線や言葉尻にも妙に敏感で、よく一人でドギマギ赤面している。周りからすると、いろんな意味でいぢり甲斐があるタイプ。"},{"spoiler":false,"text":"弘太とは数年疎遠だったが、昔から今までずっと好き。つい最近再び一緒にいられるようになったので、密かに意気込んでいるらしい。……だけに、悠夏の存在がとてもとても気になる様子。"}],"source":"bangumi","sourceCharacterId":"36674"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"17938","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"17938","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"17938","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"17938","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"17938","sourceWorkId":"10993","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d65b81881e723d3b273df8fec1bf88c903c977aa4d2185df2060b8c1394170e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f14682bd5b488542b70e102d6dc7c54b4747b122de856fb19094b5a3a42b74db.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153710:36674:4714:1","source":"bangumi"}]},{"characterId":"char_c8713","characterName":"夕凪 樹里","sourceIds":{"bangumi":[{"characterId":"36675","match":"exact-normalized-name-in-linked-work","subjectId":"153710"},{"characterId":"36675","match":"exact-normalized-name-in-linked-work","subjectId":"43337"}],"egsCharacterIds":["17939"],"vndbCharacterId":"c8713"},"originalCharacterName":"夕凪 樹里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"914"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イタズラっぽい笑顔を浮かべ、颯爽と人生をエンジョイする少女。"},{"spoiler":false,"text":"“面白さ”を重要視し、場を好き放題に引っかき回す。"},{"spoiler":false,"text":"しかし基本的には大人で、最後にはしっかりフォローを決めるため、なんだかんだで憎めない人柄をしている。"},{"spoiler":false,"text":"近頃は“弘太”と“真穂”の仲に興味津々の様子。"},{"spoiler":false,"text":"“悠夏”の出現で、彼女的にますます目が離せなくなってきているらしい。"}],"source":"egs","sourceCharacterId":"17939","sourceWorkId":"9124","spoiler":false},{"segments":[{"spoiler":false,"text":"気ままに楽しく、自由奔放、周りのみんなを弄くりまくり。"},{"spoiler":false,"text":"「面白ければいいじゃない」のモットーは、魔法使いになっても相変わらず。"},{"spoiler":false,"text":"お供に「クマ」を従えて、その無敵っぷりには拍車がかかっている。"},{"spoiler":false,"text":"そんな樹里も、弘太の前では乙女モード全開♪"},{"spoiler":false,"text":"しおらしく、かいがいしく、ちょっぴり甘えちゃったりもする……のかも？"}],"source":"egs","sourceCharacterId":"17939","sourceWorkId":"10993","spoiler":false},{"segments":[{"spoiler":false,"text":"「面白ければいいじゃない」を基本姿勢に、気ままに楽しく生きているお茶目さん。"},{"spoiler":false,"text":"人を弄るの大好き。可愛い女の子をからかうのも大好き。いじり甲斐の塊のような親友の真穂などは特にお気に入り。"},{"spoiler":false,"text":"そんな性格のくせに、見た目はお洒落でフェミニンで、モデルみたいにスマートだから始末に負えない。"},{"spoiler":false,"text":"更に根っこの部分はなんだかんだ言っても大人で、場を好き放題に引っかき回しても、フォローをしっかりとするからこれまた憎めない。"},{"spoiler":false,"text":"イタズラっぽい笑顔を浮かべ、今日も颯爽と人生をエンジョイしている。"},{"spoiler":false,"text":"目下最大の関心事は弘太と真穂の仲。悠夏が現れたことにより、彼女的にはますます目が離せなくなってきているらしい。"}],"source":"bangumi","sourceCharacterId":"36675"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"17939","sourceWorkId":"10993","sourceField":null,