db","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ふんわりとした優しい雰囲気を持つ、母性的な女性。"},{"spoiler":false,"text":"デタラメな雫の尻ぬぐいをする、彼女付きのメイドで、その能力は非常に高く、もう“ほとんどなんでもあり”状態。"},{"spoiler":false,"text":"しかし、自分からは出しゃばらず、主の世話をしつつも、それを相手に意識させない、というメイドの鑑。"},{"spoiler":false,"text":"雫を心から愛しており、可愛くて仕方ない様子。"}],"source":"egs","sourceCharacterId":"17941","sourceWorkId":"9124","spoiler":false},{"segments":[{"spoiler":false,"text":"津宮家が誇る、雫お嬢様専属のスーパーメイド。"},{"spoiler":false,"text":"今日も今日とて、お嬢様に全身全霊の（ちょっぴりアブナイ）愛を注ぐ。"},{"spoiler":false,"text":"私生活のだらしなさは相変わらずだが、最愛の人・弘太が許してくれるから問題なし！"},{"spoiler":false,"text":"……って、それでいいのか？　本当に!?"}],"source":"egs","sourceCharacterId":"17941","sourceWorkId":"10993","spoiler":false},{"segments":[{"spoiler":false,"text":"常に雫の側に侍っているお付きのメイドさん。デタラメな主の尻ぬぐい役にして、保護者的なポジション。"},{"spoiler":false,"text":"ふんわりとした優しい雰囲気の女性で、見た目も性格も非常に母性的。能力的にはとても優秀で、ほとんどなんでもありなほど。"},{"spoiler":false,"text":"しかし、自分からは出しゃばらないし、主が快適に生活できるように世話しつつも、それを意識させることはない、というメイドの鑑。"},{"spoiler":false,"text":"弘太たちに対しても物腰は丁重で、人当たりのよいお姉さん。基本的にまっとうな大人。"},{"spoiler":false,"text":"主を心の底から愛しており、可愛らしくて仕方がない。端から見ると振り回されているようではあるが、彼女からするとやんちゃな子供を持った母親に似たような心境らしく、まったく苦にしていないようだ。"}],"source":"bangumi","sourceCharacterId":"36677"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"17941","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"17941","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"17941","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"17941","sourceWorkId":"10993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"17941","sourceWorkId":"10993","sourceField":null,"scoped":tr