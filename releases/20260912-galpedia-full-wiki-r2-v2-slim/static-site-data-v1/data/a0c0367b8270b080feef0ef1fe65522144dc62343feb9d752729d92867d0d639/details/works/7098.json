{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7098","model":{"presentationWorkId":"vndb:v5223","staff":{"artwork":[{"creditedName":"せんばた楼","creatorId":"vndb:s1338","sourcePersonId":"egs:creator:9","canonicalEntityId":"vndb:s1338","name":"せんばた楼","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14059","source":"egs"}],"scenario":[{"creditedName":"大東縛","creatorId":"vndb:s532","sourcePersonId":"egs:creator:3707","canonicalEntityId":"vndb:s532","name":"大東縛","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14060","source":"egs"}],"music":[],"other":[{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:55918","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:55919","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:55920","source":"vndb"}]},"cast":[{"characterId":"char_c28858","characterName":"八神　蘭","sourceIds":{"bangumi":[{"characterId":"94336","match":"exact-normalized-name-in-linked-work","subjectId":"266098"}],"egsCharacterIds":["25554"],"vndbCharacterId":"c28858"},"originalCharacterName":"八神　蘭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ran has a strong sense of responsibility and she is cheerful. Sometime she has some priorities over others and that is personally damaging."},{"spoiler":false,"text":"Her spiritual power is high from the time of birth, and it is said that the Yagami family is one of every 100 people who has it. Her mother, Kasumi, who realized that talent, gave her a spiritual sword that she had put in her spiritual power, and entrusted her to conquer the night with sword. To save my beloved mother who was sacrificed and gave everything, she endured harsh training and waited for the opening of the door to another world with the thought of Kasumi every day."}],"source":"vndb","sourceCharacterId":"c28858"},{"segments":[{"spoiler":false,"text":"八神家120世巫女。"},{"spoiler":false,"text":"母子二代で霊力を蓄え鍛えた霊剣・斬馬刀“霞（かすみ）”の使い手。"},{"spoiler":false,"text":"性格は、明朗快活で裏表がなく、気さくで優しい女の子。"},{"spoiler":false,"text":"また、責任感が強く、人を優先してしまう謙虚過ぎる面も。"},{"spoiler":false,"text":"その霊力は、八神家でも100人に一人の逸材といわれるほど高く、古よりの因果を彼女の代で断ち切ろうと、人ならざる妖魔に挑む。"}],"source":"egs","sourceCharacterId":"25554","sourceWorkId":"7098","spoiler":false},{"segments":[{"spoiler":false,"text":"八神家120世巫女、母子二代で霊力を蓄え鍛えた霊剣・斬馬刀\"霞（かすみ）\"の使い手。"},{"spoiler":false,"text":"責任感が強く、老若男女問わずに裏表なく明るく元気に接する。自分よりも他人優先な部分があり、損する性格。"},{"spoiler":false,"text":"生まれた時から霊力が高く八神家でも100人に一人の逸材と言われている。その才能に気付いた彼女の母・霞（かすみ）は自らが霊力を注ぎ込んだ霊剣を授け、夜刀鬼征伐を託す。自らが犠牲となり、全てを授けてくれた愛する母を救おうと、厳しい修行に耐え、異界の門が開くときを一日千秋の思いで待って来た。"}],"source":"bangumi","sourceCharacterId":"94336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd666d11303e227f8b7eabbf532890b8ac75c45a33a1b7ae478c6f34134b5df5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88cb2b650c4904a407e5ca1b399a8765325337ad871ed7588fa2d4fef3dc74ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しまだかおり","creatorId":"vndb:s2665","sourcePersonId":"vndb:s2665","canonicalE