s":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18a118210cf2dacea86b57624d7bebd7a39fe40a0b3dc68c1e7554ac7b4d92e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e164f335156ee76e948b251a1c5278ffa9fc1bdb63ed014a29e5455614ce169d.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤 雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31190","source":"vndb"}]},{"characterId":"char_vndb_c4788","characterName":"夜久 月子","sourceIds":{"vndbCharacterId":"c4788"},"originalCharacterName":"夜久 月子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukiko is the first female student to attend Seigetsu Academy and is often pursued by many of the other male students. She is part of the Student Council, the Archery Club, and is also on clinic duty. She always strives to do her best, which sometimes results in overworking herself to the point of collapsing."},{"spoiler":false,"text":"She has a total of 12 potential love interests, although this number increases in the After Season games due to the introduction of new characters and the ability to date minor characters."},{"spoiler":false,"text":"From Starry☆Sky Wikia"},{"spoiler":false,"text":"Tsukiko is drawn without eyes in the original Starry☆Sky. After the release of After series and all game releases, player have the option to have Tsukiko's eyes included in CGs or not."}],"source":"vndb","sourceCharacterId":"c4788"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56442d5ec2d3d139ee3fa7ce0cfcb83a11c0827d0445725cce9141550cdd0b55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6b3d37e06d6198ec9f8d50605237831f4813355a655dfdd2459b0d564eeb45f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4789","characterName":"土萌 羊","sourceIds":{"vndbCharacterId":"c4789"},"originalCharacterName":"土萌 羊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"112"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"You represents the Capricorn. His French name is Henri Samuel Jean Aimée. Likewise, he is half-French and was often teased for that as a kid. He met Tsukiko when he was young, and because she was the only person who didn't make fun of him for being half-French, he fell in love with her and asked his father to let him transfer to Seigatsu Academy in order to pursue her. Initially disdainful to everyone except Tsukiko, eventually, he learns the importance of having friends. His father hopes to work in America to develop a special astronomy project. He is a second year."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc698b668e8fc22af5a2499b0727b79015979f871582f3b0e430f46ef57b1f10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19dc6155eba329c4acf89057aaf99b69dd70b7a13026b2afae062248d7da77c2.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緑川 光","creatorId":"vndb:s73","sourcePersonId":"vndb:s73","canonicalEntityId":"vndb:s73","name":"緑川 光","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31184","source":"vndb"}]},{"characterId":"char_vndb_c4790","characterName":"七海 哉太","sourceIds":{"vndbCharacterId":"c4790"},"originalCharacterName":"七海 哉太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"318"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kanata represents the Pisces. Brash and impulsive, he has been friends with Tsukiko since childhood and has developed feelings for her. He does not get along very well with Yoh. Kanata suffers from a terminal illness that leaves him in a lethargic state, which is why he often skips classes and faints without reason. However, he refuses to seek medical help and often gets into school fights that worsen his health to protect Tsukiko. He is a second year."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cf3c30f62819f22ab96b4f777c94f9d9c53b0c6348ad211cea178aa4cf894f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c32853866d1c07b7643a2a44dda026f5708bb3d98a97f7159bcca0e2795c04ee.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田 智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370",