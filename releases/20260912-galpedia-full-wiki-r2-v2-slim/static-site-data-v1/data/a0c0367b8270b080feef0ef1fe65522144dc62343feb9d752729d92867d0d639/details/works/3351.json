tus":"source-native","relationId":"vndb:vn-staff:61904","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c116184","characterName":"魔女っ子クル","sourceIds":{"vndbCharacterId":"c116184"},"originalCharacterName":"魔女っ子クル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Witch Kid. A mirror world resident who looks just like Harukaze Kurumi-chan. A super silly alien from the ‘Dayomon Star’. Refers to herself as ‘Boku’."},{"spoiler":false,"text":"\"My name is Kuro-dayon. I came to save the world like a goldfish~♪\""},{"spoiler":false,"text":"She says things like this in a lisping, sweet voice while using magic to create a space called the Pink Time-Space, dragging everyone into trouble."},{"spoiler":false,"text":"But her actions stem from a ‘good heart’. The mirror world she lives in is the flip side of the world where Alto-kun lives."},{"spoiler":false,"text":"To save the mirror world that has become clouded, she creates a pink-hued space in Alto-kun's world, where feelings of love have grown scarce, trying to make everyone fall in love."},{"spoiler":false,"text":"But somehow, it turns into an erotic space where everyone gets horny..."},{"spoiler":false,"text":"Special Note: Breast Size"},{"spoiler":false,"text":"So big you'll want to bury your face in them while teasing her in a seated position—Marshmallow Boin-chan."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c116184"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d72836eddceeb3c283cbed889e09f8b40efffdc312cd5cbd09a5781cdfe7257e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9c9126bd3c396a2d49947f6f4cff650ee10b802397ed2fa92f8e54fd058