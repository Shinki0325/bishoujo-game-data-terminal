{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23813","model":{"presentationWorkId":"vndb:v19548","staff":{"artwork":[{"creditedName":"nmst_29(ささき咲、naohina_)","creatorId":"vndb:s9862","sourcePersonId":"egs:creator:27481","canonicalEntityId":"vndb:s9862","name":"nmst_29(ささき咲、naohina_)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167268","source":"egs"}],"scenario":[{"creditedName":"ぴよみず","creatorId":"vndb:s2608","sourcePersonId":"egs:creator:3858","canonicalEntityId":"vndb:s2608","name":"ぴよみず","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167269","source":"egs"}],"music":[],"other":[{"creditedName":"相川 なつ","creatorId":"vndb:s15680","sourcePersonId":"vndb:s15680","canonicalEntityId":"vndb:s15680","name":"相川 なつ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:131487","source":"vndb"}]},"cast":[{"characterId":"char_c48598","characterName":"戸野田 美代子","sourceIds":{"bangumi":[{"characterId":"54195","match":"exact-normalized-name-in-linked-work","subjectId":"215717"}],"egsCharacterIds":["12713"],"vndbCharacterId":"c48598"},"originalCharacterName":"戸野田 美代子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mother of the protagonist. A widow."},{"spoiler":false,"text":"She is cheerful and kind, but when it comes to her son, she is a troubled woman who is unstoppable. She is a good provider for the family while loving her son, who is becoming more and more like her husband."},{"spoiler":false,"text":"She is not very good at housework, so she is dependent on her son, and is also mentally dependent on him. When her son comes home, she can't help but hug him."},{"spoiler":false,"text":"Before she knew it, she noticed that her son's physique had grown to look just like her late husband's, and she became conscious of him as a man."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c48598"},{"segments":[{"spoiler":false,"text":"主人公の母親。未亡人。"},{"spoiler":false,"text":"明るくて優しいけれど、息子の事になると行動に歯止めの効かなくなる困った女性。"},{"spoiler":false,"text":"家事は苦手だが、次第に夫に似てきた息子を猫っ可愛がりしつつ、働きに出て立派に家計を支えている。"},{"spoiler":false,"text":"その分、家事ができる息子には依存しっぱなし。精神的にも依存しっぱなし。"},{"spoiler":false,"text":"息子のことが心配で心配でたまらず、家に帰ってくるとハグせずにはいられない。"}],"source":"egs","sourceCharacterId":"12713","sourceWorkId":"23813","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の母親。 未亡人。"},{"spoiler":false,"text":"明るくて優しいが、息子のことになると歯止めが効かなくなる困った女性。"},{"spoiler":false,"text":"次第に夫に似てきた息子を猫っ可愛がりしつつも、立派に家計を支えている。"},{"spoiler":false,"text":"その分 家事は苦手なので息子に依存しっぱなしで、精神的にも依存しまくっている。"},{"spoiler":false,"text":"息子が家に帰ってくるとハグせずにはいられない。"},{"spoiler":false,"text":"いつの間にか息子のムスコが亡き旦那のソレそっくりに成長していることに気がつき、男として意識してしまうようになった。"}],"source":"bangumi","sourceCharacterId":"54195"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae4a2340821c03836532c1a9b5108c576ed258b91373e6d9a5b37754d889219a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa2f4065da420347d6c894376cc5e6de74dd4751ee28340cc8025743cec57346.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"誠樹ふぁん","creatorId":"vndb:s1729","sourcePersonId":"vndb:s1729","canonicalEntityId":"vndb:s1729","name":"誠樹 ふぁん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:215717:54195:31854:1","source":"bangumi"}]},{"characterId":"char_c48599","characterName":"戸野田 真耶","sourceIds":{"bangumi":[{"characterId":"54199","match":"exact-normalized-name-in-linked-work","subjectId":"215717"}],"egsCharacterIds":["12714"],"vndbCharacterId":"c48599"},"originalCharacterName":"戸野田 真耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of the main character."},{"spoiler":false,"text":"She has a very intense temperament and is the type of person who acts first rather than thinks. She lived in a dormitory at an all-girls school for a long time, so she has never had any experience with men. Not only sexual experience, She has not even had her first kiss yet. She has excellent grades and a strong sense of responsibility."},{"spoiler":false,"text":"She is popular among the underclassmen at school. She was once a representative of the students in her dormitory, and she hates to lose."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c48599"},{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"喜怒哀楽がとても激しく、考えるよりまず行動を起こすタイプ。"},{"spoiler":false,"text":"ずっと女子校の寮暮らしだった為、男性とつきあった経験は全くなし。性経験どころかファーストキスもまだ。"},{"spoiler":false,"text":"成績はそれなりに優秀で責任感も強い。"},{"spoiler":false,"text":"学園では下級生に人気がある。"},{"spoiler":false,"text":"寮の中では生徒たちの代表を務めていた事もあり、負けず嫌いなところがある。"}],"source":"egs","sourceCharacterId":"12714","sourceWorkId":"23813","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。 喜怒哀楽がとても激しく、考えるよりもまず行動を起こすタイプ。"},{"spoiler":false,"text":"成績はそれなりに優秀で責任感が強く、学園では下級生に人気がある。"},{"spoiler":false,"text":"ずっと女子校の寮暮らしなため、男性と付き合った経験はない。"},{"spoiler":false,"text":"母と兄の異常に親密な生活ぶりを見て、自分がなんとかしなければと奮闘。"},{"spoiler":false,"text":"母を諭し、兄を自立させようと厳しく臨むものの、逆に巻き込まれてしまう。"}],"source":"bangumi","sourceCharacterId":"54199"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82a1b988e36f9f987d91fecf7cc64572b1aea5b10c5b9ff4