:"vndb:s8643","sourcePersonId":"vndb:s8643","canonicalEntityId":"vndb:s8643","name":"赤月 ゆむ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99485","source":"vndb"}]},{"characterId":"char_vndb_c139529","characterName":"更科 千寿","sourceIds":{"vndbCharacterId":"c139529"},"originalCharacterName":"更科 千寿","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the calm older sister who runs the bar \"Night-owl Kitten\". She is always looking out for Yua, who is new to another world and doesn't know what's right and wrong. She was transferred to this world several years before Yua."},{"spoiler":false,"text":"She had a lot of difficulties in the beginning, but she has grown up enough to set up her own store. She has a generous personality and forgives almost anything."},{"spoiler":false,"text":"She is always in a good mood. However, she puts pressure on those who have done wrong with a smile on her face."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c139529"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/102e736b8dda8af93f81e13ea6a3b2bfcca608c27d444f9dd3e944661f0e9394.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49bdd3a69af72f56a63a7615780561970dc2f4ee4773974ecdad862ac1b83081.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"君島 りさ","creatorId":"vndb:s2310","sourcePersonId":"vndb:s2310","canonicalEntityId":"vndb:s2310","name":"君島 りさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99484","source":"vndb"}]},{"characterId":"char_vndb_c139531","characterName":"桐ケ