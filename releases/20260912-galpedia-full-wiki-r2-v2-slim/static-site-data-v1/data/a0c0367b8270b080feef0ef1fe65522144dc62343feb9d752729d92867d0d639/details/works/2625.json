6"},"originalCharacterName":"土堂 乙女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An elusive girl—hard to pin down—"},{"spoiler":false,"text":"yet strangely, if she’s not around, you really start to notice her absence."},{"spoiler":false,"text":"She has sharp powers of observation and keen eyes that quickly see through secrets and hidden intentions."},{"spoiler":false,"text":"But even when she notices something, she doesn’t press for answers…"},{"spoiler":false,"text":"Instead, she keeps a mysterious, perfectly balanced distance—never too close, never too far—an enigmatic girl with a subtle, almost magical presence."},{"spoiler":false,"text":"Occupation: Unknown"},{"spoiler":false,"text":"Likes: Silence, nature"},{"spoiler":false,"text":"Dislikes: Loud noises, disorder"},{"spoiler":false,"text":"Hobby: Gardening (kind of like bonsai?)"},{"spoiler":false,"text":"\"Nii-ya!\""}],"source":"vndb","sourceCharacterId":"c14166"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b4567a92af607bb28cce96ad38a57eb7ddd36486dcdcd3bfb47b8d9b5138f81.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d34ea9a92834a37ae67137667b41cb57bd4d2b7281e7c66dc7822cc5df6f5ff5.webp","width":256,"height":248,"source":"static-detail"},"actors":[{"creditedName":"吉川 華生","creatorId":"vndb:s807","sourcePersonId":"vndb:s807","canonicalEntityId":"vndb:s807","name":"桜庭 わかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12991","source":"vndb"}]},{"characterId":"char_vndb_c14167","characterName":"葉野 若葉","sourceIds":{"vndbCharacterId":"c14167"},"originalCharacterName":"葉野 若葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/466dbde766129651faedef5797a5c1afd6971153a520953e180508f27841c213.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f1542bc2579aa8dc6583830d4807f3abace3f4ddcf0b8722681765446ad6b1c.webp","width":256,"height":248,"source":"static-detail"},"actors":[{"creditedName":"カンザキ カナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12992","source":"vndb"}]},{"characterId":"char_vndb_c42228","characterName":"大西 小夏","sourceIds":{"vndbCharacterId":"c42228"},"originalCharacterName":"大西 小夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who loves standing out and is crazy about events."},{"spoiler":false,"text":"She tends to charge straight down her own path, but often acts without paying much attention to what’s going on around her."},{"spoiler":false,"text":"Because of that, if the people around her don’t properly watch over her, there’s no telling what she might end up doing."},{"spoiler":false,"text":"She clearly states what she likes and what she hates—no half measures."},{"spoiler":false,"text":"She’s especially weak when it comes to her twin older sister, Koharu."},{"spoiler":false,"text":"And for some reason, even though she’s not from Kansai, she speaks in Kansai dialect…?"},{"spoiler":false,"text":"Occupation: Student + part-time flower shop worker"},{"spoiler":false,"text":"Likes: Chocolate, reptiles"},{"spoiler":false,"text":"Dislikes: Carrots, celery, parsley, butterflies"},{"spoiler":false,"text":"Hobby: Solo comedy routines (studying jokes and punchlines)"},{"spoiler":false,"text":"\"Aniki!\""}],"source":"vndb","sourceCharacterId":"c42228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f58c9b91556e9e82dd43237231ed01ea4f1309e824fc9abcf0a01da19e9f932.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9af7bb35ac9e50204913d18fc38294057ac8ef18cd3e6ac6f3674c14af61620.webp","width":256,"height":248,"source":"static-detail"},"actors":[{"creditedName":"大波 こなみ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12986","source":"vndb"}]},{"characterId"