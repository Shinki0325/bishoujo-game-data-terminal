es: Green peppers, carrots, medicine, the dark"},{"spoiler":false,"text":"Hobby: Being with her big brother"},{"spoiler":false,"text":"\"Nii-nii!\""}],"source":"vndb","sourceCharacterId":"c14154"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0e26f51281fd32abb3136260c17a37e2b676a6a8e876ec5ac274c7c4cefdd70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51262250b6e1e2856d6859c9b44703d3ffa768384a8de0079609812589c72c0d.webp","width":256,"height":248,"source":"static-detail"},"actors":[{"creditedName":"紫苑 みやび","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12989","source":"vndb"}]},{"characterId":"char_vndb_c14163","characterName":"三島 輝","sourceIds":{"vndbCharacterId":"c14163"},"originalCharacterName":"三島 輝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56a2aab4bec63f3aa335c15b657bdcc6257218ce4e4ad92990ac99c39de6f254.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff82cb353b034a59d82b64ef18a5bfdb429968176e23b9db9635b95b69704456.webp","width":256,"height":248,"source":"static-detail"},"actors":[{"cr