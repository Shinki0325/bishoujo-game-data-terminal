poiler":false,"text":"He had passed university entrance examination, but was summoned to this world by Nirmo and others before he could pay the enrollment fee."},{"spoiler":false,"text":"He was perplexed by being suddenly treated as a hero, but since he gets to have sex and it didn't sound so bad, he accepted the role without a second thought."},{"spoiler":false,"text":"But as he gets to spend time and fight alongside the heroines, he gradually awakens to the role of the hero."}],"source":"vndb","sourceCharacterId":"c81258"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ca44d98c377139fc6d459064a2b097124bb843692173070b8917905848c71fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86b018ea0e8a07850322bb636b614ddceecda46995db4f32b62feb2f4dc494f0.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c81259","characterName":"エルダ","sourceIds":{"vndbCharacterId":"c81259"},"originalCharacterName":"エルダ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97efaee9b43e271385827f6e334009890a358d9cb07efaae8faf4eb8eb96b62a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c81517344449d7783915d3f21fd8b22af5cf695d5a1f3149281c7914b53a487.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"楠 鈴音","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36065","source":"vndb"}]},{"charac