":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Nihahahaha, you're such a pervert, Hero ☆ What kind of massage were you imagining?\""},{"spoiler":false,"text":"A bright and positive girl. She won't lose heart nor hope over trifle matters. The type that can make life fun, including naughty things. In general she can handle all sorts of housework, but for some reason only her cooking leaves a lot to be desired."},{"spoiler":false,"text":"To Nirmo, Earl is like a father and a partner."}],"source":"vndb","sourceCharacterId":"c38081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97ac05bc38b683ee70a8d88f06851e461bad65e1186e5c2ff107ba782c9c20c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7fbaaf1416f43084b4f9dde7f78c72008a9a6c65f1c4a2fed7a6891c1dd4811.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 まひる","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36073","source":"vndb"}]},{"characterId":"char_vndb_c38082","characterName":"まるるん","sourceIds":{"vndbCharacterId":"c38082"},"originalCharacterName":"まるるん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Gods... please grant me strength to carry out vengeance. Grant me strength......... gods... gods...\""},{"spoiler":false,"text":"A girl who fights to avenge her parents. She shows no mercy if it's for vengeance. She is taciturn and only speaks with low voice, but sometimes changes her attitude depending on the person. She often prays to gods. The gods reside in her hands when she prays, allowing her to \"massage\" with elegant handiwork."}],"source":"vndb","sourceCharacterId":"c38082"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32f0149a9a402ba5d0957d1bc49a4df592c073521ddc004233eb9fcabf90f73e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70a2c00c94d098c142de9d75da824e0b346ba30c87f5fc7a9f1a29951bc5a4e8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西田 こむぎ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36070","source":"vndb"}]},{"characterId":"char_vndb_c38083","characterName":"ゆぅに","sourceIds":{"vndbCharacterId":"c38083"},"originalCharacterName":"ゆぅに","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I demand a lifelong supply of meals as reparation. So please marry me, my prince~~☆\""},{"spoiler":false,"text":"A self-centered girl who does her own thing without a care of the trouble it causes to those around her. She used to be part of the Circus Group, but fell in love with Asagi at first sight and joined him. Quite a troublemaker."}],"source":"vndb","sourceCharacterId":"c38083"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/731fa0f7e2b60fa9929fd6dec00244536f45946bae2844287cbb16b045da2d84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/042bd72a5c70f0fa5ca882f306cddde00c1c88a0a5916a04af0b5b09bd306ee6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"とろ美","creatorId":"vndb:s5568","sourcePersonId":"vndb:s5568","canonicalEntityId":"vndb:s5568","name":"とろ美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36076","source":"vndb"}]},{"characterId":"char_vndb_c38084","characterName":"るあ","sourceIds":{"vndbCharacterId":"c38084"},"originalCharacterName":"るあ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"While I do think that both love and affection are important, right now we must stop the King... for that I'll do anything\""},{"spoiler":false,"text":"A girl with grown-up woman's modest and levelheaded personality. The only heroine with any common sense and also the mediator of the group. Rua fights to protect world peace. But sometimes she shows an expression of fear... an expression of sorrow..."}],"source":"vndb","sourceCharacterId":"c38084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a14f7f63f384e83eb98966710fc111cac07a756759091a2e0960197837d7c02.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fedfc68e34dc65657d02ca6e4578fb45cf9b067cc765ffa0f4a62f55aeba7a74.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緒田 マリ","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36071","source":"vndb"}]},{"characterId":"char_vndb_c38085","characterName":"ゆりな","sourceIds":{"vndbCharacterId":"c38085"},"originalCharacterName":"ゆりな","characterNameSo