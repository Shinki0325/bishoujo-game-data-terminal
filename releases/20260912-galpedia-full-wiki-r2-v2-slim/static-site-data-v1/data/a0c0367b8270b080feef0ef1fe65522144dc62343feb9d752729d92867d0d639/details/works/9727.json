,"identityStatus":"source-native","relationId":"vndb:vn-staff:22257","source":"vndb"},{"creditedName":"K杉","creatorId":"vndb:s3290","sourcePersonId":"vndb:s3290","canonicalEntityId":"vndb:s3290","name":"金杉 肇","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22258","source":"vndb"},{"creditedName":"ひーこ","creatorId":"vndb:s569","sourcePersonId":"vndb:s569","canonicalEntityId":"vndb:s569","name":"春夏 ひとみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:22259","source":"vndb"}]},"cast":[{"characterId":"char_c44749","characterName":"ゆず","sourceIds":{"bangumi":[{"characterId":"76556","match":"exact-normalized-name-in-linked-work","subjectId":"224883"}],"egsCharacterIds":["19401"],"vndbCharacterId":"c44749"},"originalCharacterName":"ゆず","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪魔っ娘・ティルアに女の子にされてしまった主人公。"},{"spoiler":false,"text":"優しさと正義感を持つ少年（少女？）だが、基本的にはシャイで激しい人見知り。"},{"spoiler":false,"text":"元々は、ウブな雰囲気を持つ中性的な美少年で、女子、女教師たちに人気が高いのだが、"},{"spoiler":false,"text":"性格からか、女の子とまともに話をしたこともなく、ファンがいる事実に気づく事はない。"},{"spoiler":false,"text":"「えっ、えっ、どうして女のコのカラダになってるの!?」"}],"source":"egs","sourceCharacterId":"19401","sourceWorkId":"9727","spoiler":false},{"segments":[{"spoiler":false,"text":"シャイで人見知りの激しい性格ながら、人一倍の優しさと妙な正義感を持っている。部活は手芸部で、多くのコンテストに入賞している。"},{"spoiler":false,"text":"女性との恋愛経験がなく、女のコとまともに話したことさえあまりない。"},{"spoiler":false,"text":"けれども中性的で美少年タイプのため、女性からの人気は高く、ウブな雰囲気から特に年上、教師の中にも彼のファンがいたりする。"},{"spoiler":false,"text":"しかしその事実に本人は気がつく由もない。"},{"spoiler":false,"text":"「えっ、えっ、どうして女のコの体になってるの!?」"}],"source":"bangumi","sourceCharacterId":"76556"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c44749","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"19401","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"19401","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a7cb745d86b5b2319642eced28cfdf6e465c0e257fb81a21432a1204c7b6aec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38fdaafe78d4c3764792d6686fa5c19b1c71c10cb2dc4cac3ff721ed7d8c53f4.webp","width":133,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224883:76556:5922:1","source":"bangumi"}]},{"characterId":"char_c44750","characterName":"ティセア・ルミナス・アルヴァーション","sourceIds":{"bangumi":[{"characterId":"76934","match":"exact-normalized-name-in-linked-work","subjectId":"224883"}],"egsCharacterIds":["19402"],"vndbCharacterId":"c44750"},"originalCharacterName":"ティセア・ルミナス・アルヴァーション","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪魔の少女で、本名は「ティセア・ルミナス・アルバーション」。"},{"spoiler":false,"text":"魔界学校の卒業試験のために地上にやってきたのだが、ひょんなことから柚希を女の子にしてしまう。"},{"spoiler":false,"text":"そのことに、少々凹み気味のようだが、後先考えない、生来のトラブルメーカーなため、なんとかなるだろうと楽観視。"},{"spoiler":false,"text":"柚希の性欲が吸えることを、密かに楽しみにしているフシも。"},{"spoiler":false,"text":"「ゆずの性欲を少しだけ私に吸わせてちょうだい」"}],"source":"egs","sourceCharacterId":"19402","sourceWorkId":"9727","spoiler":false},{"segments":[{"spoiler":false,"text":"魔界学園の卒業試験の為に、地上にやってきた悪魔。"},{"spoiler":false,"text":"「ティルア」は通称であり、本名は「ティセア・ルミナス・アルヴァーション」。だいたい300年くらい生きている。"},{"spoiler":false,"text":"優しい心の持ち主だが、後先考えずに繰り出した自分の魔法で、好きな主人公が元に戻れないかもしれないという事実に少し凹み気味だが、なんとかなるだろうと楽観視もしている。"},{"spoiler":false,"text":"主人公が元に戻るために性欲を溜める協力はしてくれる。そして主人公から性欲を吸える事を、内心楽しみにしている。"},{"spoiler":false,"text":"使い魔「ルミナス」"},{"spoiler":false,"text":"ティルアの羽のように見える物は、彼女の使い魔。悪魔は使い魔と契約をすると自分の名前に、使い魔の名前を加える事になる。"},{"spoiler":false,"text":"ティルアが物心をついた時には、すでにルミナスと契約をしていた。"},{"spoiler":false,"text":"ティルアはルミナスがとこから来て、どういう経緯で自分の使い魔になったのかを知らない。"},{"spoiler":false,"text":"「そんな事を言ってもダメだよ。ゆずの本当の気持ちはお見通しなんだから」"}],"source":"bangumi","sourceCharacterId":"76934"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0126e9934d6feee73b80058631fb18a02dd715457ecc533a7db1cca5492f6e6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4df501ec79ba428ddb016457098e0249e5a8390e7a82b3f853d56b9b024b78bf.webp","width":250,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224883:76934:4463:1","source":"bangumi"}]},{"characterId":"char_c44751","characterName":"愛川 雛衣","sourceIds":{"bangumi":[{"characterId":"76758","match":"exact-normalized-name-in-linked-work","subjectId":"224883"}],"egsCharacterIds":["19403"],"vndbCharacterId":"c44751"},"originalCharacterName":"愛川 雛衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"柚希のクラスの学級委員長。"},{"spoiler":false,"text":"容姿端麗、明るく飾り気のない性格から、非公式ながらファンクラブも存在するほどの慕われぶり。"},{"spoiler":false,"text":"彼女が苦手としている二つの要素のうち、運動音痴は自覚しているが、料理下手は自覚ナシ。"},{"spoiler":false,"text":"調理実習ではみんな雛衣を避けている（ファン曰く「そこがまた良い」）"},{"spoiler":false,"text":"密かに好意を寄せる柚希と、一緒に住めることに内心喜んでいるが……。"},{"spoiler":false,"text":"「あの、やっぱり一緒にお風呂に入るのは……恥ずかしいよ」"}],"source":"egs","sourceCharacterId":"19403","sourceWorkId":"9727","spoiler":false},{"segments":[{"spoiler":false,"text":"クラスで学級委員を務める、容姿端麗な女のコ。料理音痴で運動音痴であり、運動音痴は自分で自覚しているが、料理音痴は自覚していない。"},{"spoiler":false,"text":"主人公とは小学校からの同級生だが、主人公がシャイということもあり言葉を交わした事はあまりなかった。だが、女のコの姿にされてしまった主人公を女子寮に住まわせるためにまわりを説得したりと協力をしてくれる。"},{"spoiler":false,"text":"「あの、やっぱり一緒にお風呂に入るのは……恥ずかしいよ」"}],"source":"bangumi","sourceCharacterId":"76758"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cb41eabf0fc0db94aa0b33d183e4135d763715a7a2647303de9fa417f3ec65b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdb50c11340a3927830b0b209c2f5ef303a92ce126bfdac87d164f9534bb4849.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224883:76758:7169:1","source":"bangumi"}]},{"characterId":"char_c44753","characterName":"桜下 乙女","sourceIds":{"bangumi":[{"characterId":"77120","match":"exact-normalized-name-in-linked-work","subjectId":"224883"}],"egsCharacterIds":["19406"],"vndbCharacterId":"c44753"},"originalCharacterName":"桜下 乙女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"柚希の幼馴染で、一つ年上の姉御肌の少女。"},{"spoiler":false,"text":"容姿端麗、成績優秀、スポーツ抜群と三拍子そろった完璧超人。"},{"spoiler":false,"text":"しかも、それをまったく鼻にかけない所から、彼女の人気は止まることを知らない。"},{"spoiler":false,"text":"元空手部で、数々の大会で優勝するほどの腕の持ち主で通称「鬼部長」。"},{"spoiler":false,"text":"しかし、音速の蹴りが飛んでくるので、彼女の前では禁句である。"},{"spoiler":false,"text":"「ゆずは、お姉ちゃんがちゃんと守ってあげないとね」"}],"source":"egs","sourceCharacterId":"19406","sourceWorkId":"9727","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公よりもひとつ年上の幼なじみ。容姿端麗、成績優秀、運動神経が抜群と非の打ち所がない。しかもそれを鼻にかける事が無いので、彼女のファンは学園中に存在する。"},{"spoiler":false,"text":"主人公のことを弟としか見ておらず、下着を見せたりとからかいの対象でもあった。しかし、女のコにされた主人公を元に戻すために協力していくにつれ、主人公が男としての性欲を持っていることがわかり、意識してしまう。"},{"spoiler":false,"text":"主人公を男に戻したいという一心から、恥ずかしい気持ちを抑え、いつもと変わらぬ顔で色々と協力をしてくれる。"},{"spoiler":false,"text":"「ゆずはやっぱり、お姉ちゃんがちゃんと守ってあげないと」"}],"source":"bangumi","sourceCharacterId":"77120"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/302cb95b9ba8d304288769300c0c97cf5941d07c383f69a0fc9ba1c82a5b1c2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d944cc029eb0e76e13711fd62d4492104f55685be4789da87dcb8b4740b70579.webp","width":174,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224883:77120:6469:1","source":"bangumi"}]},{"characterId":"char_c44757","characterName":"ゆきちゃん","sourceIds":{"bangumi":[{"characterId":"76959","match":"exact-normalized-name-in-linked-work","subjectId":"224883"}],"egsCharacterIds":["19404"],"vndbCharacterId":"c44757"},"originalCharacterName":"ゆきちゃん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ手芸部に所属する少女で、人を寄せ付けない、独特の雰囲気を持つ寡黙な後輩。"},{"spoiler":false,"text":"実はコスプレを筆頭に、フィギュア、同人誌など、ちょっぴり濃い、コアな趣味を持つ彼女。"},{"spoiler":false,"text":"しかし、その趣味を学園ではひた隠しにしており、他人を拒むのも、それがバレないようにするため。"},{"spoiler":false,"text":"夢は、自作したコスプレを誰かに見てもらうことだが……。"},{"spoiler":false,"text":"「先輩は……いえ、なんでもありません」"}],"source":"egs","sourceCharacterId":"19404","sourceWorkId":"9727","spoiler":false},{"segments":[{"spoiler":false,"text":"柚希所在的手艺部的后辈。"}],"source":"bangumi","sourceCharacterId":"76959"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0331e1c3c16e403f531bea80d8bccf5c86183f5b9472dad28ee8f94c02b4e311.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8986625b5068e0f3d576f879a9df31ff9c31c8753d0eecf4f69f6f315ca9a26f.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224883:76959:5741:1","source":"bangumi"}]},{"characterId":"char_c44761","characterName":"ひめちゃん","sourceIds":{"bangumi":[{"characterId":"76970","match":"exact-normalized-name-in-linked-work","subjectId":"224883"}],"egsCharacterIds":["19405"],"vndbCharacterId":"c44761"},"originalCharacterName":"ひめちゃん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"柚希の後輩で、クラスのマスコット的存在。"},{"spoiler":false,"text":"家事全般苦手、虫が嫌い、手先が不器用、ドジで無防備と弱点だらけだが、そこがいいのか、みんなからは、妹のように可愛がられている。"},{"spoiler":false,"text":"他者を超越したプラス思考と笑顔で、どんな困難も乗り越える所も、人気の秘訣かもしれない。"},{"spoiler":false,"text":"とある理由で、柚希を追いかけて女子寮に住みだすが……。"},{"spoiler":false,"text":"「ゆーちゃん先輩こんにちは、本当に女のコになっちゃったんだね」"}],"source":"egs","sourceCharacterId":"19405","sourceWorkId":"9727","spoiler":false},{"segments":[{"spoiler":false,"text":"クラスのマスコット的存在で、クラスメイトからは妹のような感じで可愛がられている。頑張り屋さんで、つねにちょこちょこと走り回っている。料理が苦手、虫が嫌い、お化けは無理、手先は不器用と弱点だらけ。"},{"spoiler":false,"text":"クラスの中で彼女の下着を見た事の無い男は居ないくらい無防備。と言うか、それがどういう影響を与えているのかよくわかっていない。"},{"spoiler":false,"text":"極度の寂しがりやで寮での生活に心が折れそうになっていたが、女子寮に住むことになった主人公の存在で彼女の生活は変わる。一緒にお風呂に入ったり、一緒に登校したり、一緒に寝たり。彼女にとって、楽しくとても幸せな日々となる。水泳部所属。"},{"spoiler":false,"text":"「ゆーちゃん先輩こんにちは、本当に女のコになっちゃったんだね」"}],"source":"bangumi","sourceCharacterId":"76970"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aada97f376b99546b71a20dc427dc9774d344c78beda9871478c2a0b878647b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0486d4a8cf50ea4a99d4734c55baa71799c2508f49eb011514a56c7f9423282c.webp","width":144,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224883:76970:6016:1","source":"bangumi"}]},{"characterId":"char_vndb_c44763","characterName":"椎名 誠","sourceIds":{"vndbCharacterId":"c44763"},"originalCharacterName":"椎名 誠","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db9487d5384653845b4b2d085dc1c892a77e7a31759656c95bbe47be99398e96.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72fd4efeed1aa93743967c67294d586d9027c0eb5f18c20286672d42542d2eb9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜井 雅斗","creatorId":"vndb:s9951","sourcePersonId":"vndb:s9951","canonicalEntityId":"vndb:s9951","name":"沢口 友哉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11320"