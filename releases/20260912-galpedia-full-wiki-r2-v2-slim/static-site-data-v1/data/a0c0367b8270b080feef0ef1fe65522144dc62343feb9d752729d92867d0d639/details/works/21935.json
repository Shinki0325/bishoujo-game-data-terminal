ndbCharacterId":"c77507"},"originalCharacterName":"源 ちずる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"400"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chizuru is second-year female student at Kouta's school. On the outside she appears to be a well endowed teenage girl, but she is in fact a powerful kitsune. When she changes form, her black hair turns blonde, and she gains fox ears and a tail. While it is implied by her brother Tayura that she is 400 years old, it is later revealed that her age may be in the thousands. She has no recollection of her past from before she met her foster mother Tamamo, but over time remembers some things she had forgotten about herself. From the start of the series she has fallen in love with Kouta, and is constantly hanging around him. She very much wants to enter into a \"relationship of sin\" with him and is very forthright in her almost constant sexual suggestions and actions."}],"source":"vndb","sourceCharacterId":"c77507"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c9a302938381e65731d00b8023296caeece73153f35a5f87f00997f5095a3b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65eadbb9a8e8c7e689eece64fc4a3edc2230c7d35bde95aafeb7f1028eece38e.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川澄 綾子","creatorId":"vndb:s16","sourcePersonId":"vndb:s16","canonicalEntityId":"vndb:s16","name":"川澄 綾子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31508","source":"vndb"}]},{"characterId":"char_vndb_c77508","characterName":"犹守 望","sourceIds":{"vndbCharacterId":"c77508"},"originalCharacterName":"犹守 望","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"200"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nozomu is a first-year female transfer student at Kouta's school. She has short light ash blonde hair and is in fact a 200-year-old wolf spirit who lives by herself in an expensive but empty penthouse apartment, where she always sleeps naked on the floor. She has an older brother named Saku who took her in, but after Saku attacks Kouta she decides to go against her brother by following her own path.7 Despite her seemingly detached and emotionless manner, she falls in love with Kouta at first sight and is thus Chizuru's rival for Kouta's affections. She frequently insults Chizuru by calling her a \"Horny Beast\", saying that Chizuru \"smells obscene\" or that her breasts are flabby."}],"source":"vndb","sourceCharacterId":"c77508"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/168e1db633c88851c86919a1975c8606312197cac4a1a4883f730cd8f02071ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c191c92cf099758c49570656e3f0442ef9c30d29c37a388e29475b627896aef7.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹内 美優","creatorId":"vndb:s17538","sourcePersonId":"vndb:s17538","canonicalEntityId":"vndb:s17538","name":"竹内 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31518","source":"vndb"}]},{"characterId":"char_vndb_c77509","characterName":"源 たゆら","sourceIds":{"vndbCharacterId":"c77509"},"originalCharacterName":"源 たゆら","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","