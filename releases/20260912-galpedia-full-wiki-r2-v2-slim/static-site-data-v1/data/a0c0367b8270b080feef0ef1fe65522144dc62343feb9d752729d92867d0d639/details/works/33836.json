{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33836","model":{"presentationWorkId":"vndb:v41944","staff":{"artwork":[{"creditedName":"choco chip","creatorId":"vndb:s3298","sourcePersonId":"egs:creator:1140","canonicalEntityId":"vndb:s3298","name":"choco chip","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:259534","source":"egs"}],"scenario":[{"creditedName":"近江達裕","creatorId":"vndb:s3538","sourcePersonId":"egs:creator:2507","canonicalEntityId":"vndb:s3538","name":"近江達裕","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:260167","source":"egs"},{"creditedName":"七央結日(安堂こたつ)","creatorId":"vndb:s1855","sourcePersonId":"egs:creator:2151","canonicalEntityId":"vndb:s1855","name":"七央結日(安堂こたつ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:260168","source":"egs"},{"creditedName":"風間ぼなんざ","creatorId":"vndb:s1131","sourcePersonId":"egs:creator:3864","canonicalEntityId":"vndb:s1131","name":"風間ぼなんざ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:260169","source":"egs"},{"creditedName":"七歌","creatorId":"vndb:s3400","sourcePersonId":"vndb:s3400","canonicalEntityId":"vndb:s3400","name":"灰黒 七歌","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:193748","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c122749","characterName":"新宮 凛子","sourceIds":{"bangumi":[{"characterId":"125494","match":"exact-normalized-name-in-linked-work","subjectId":"415317"}],"egsCharacterIds":["24599"],"vndbCharacterId":"c122749"},"originalCharacterName":"新宮 凛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"32"},"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"As your mama, I'll take good care of you and pamper you.\""},{"spoiler":false,"text":"The wife of the Ninomiya family who lives next door to the apartment where the Hirose family lives."},{"spoiler":false,"text":"She is very motherly and has a good reputation among her neighbors."},{"spoiler":false,"text":"Rinko has known Ayato since he was a small child, and she is always concerned about him as if she were his own mother."},{"spoiler":false,"text":"Her young son dislikes getting pampered by his mom. Because of that, she has a strong desire to thoroughly pamper Ayato, whom she has been watching since he was little."},{"spoiler":false,"text":"Translated from getchu"}],"source":"vndb","sourceCharacterId":"c122749"},{"segments":[{"spoiler":false,"text":"アパートの隣に住む新宮家の奥さん。"},{"spoiler":false,"text":"母性豊かで、ご近所からも評判の女性。"},{"spoiler":false,"text":"主人公を実の母親のように気に掛けてくれている。"}],"source":"egs","sourceCharacterId":"24599","sourceWorkId":"33836","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインの一人。"},{"spoiler":false,"text":"広瀬家が住むアパートの隣に住む新宮家の奥さん。"},{"spoiler":false,"text":"母性豊かで、ご近所からも評判の女性。"},{"spoiler":false,"text":"小さい頃から彩人の事を知っている為、実の母親のようにいつも気に掛けてくれている。"},{"spoiler":false,"text":"幼い息子が一人いるが、構われるのを嫌がっている為、"},{"spoiler":false,"text":"その反動で小さい頃から目をかけている彩人を徹底的に甘やかしたい強い願望を秘めている。"}],"source":"bangumi","sourceCharacterId":"125494"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20e33429e6bd42f0aa588b1eba7357cbbf102180db582a9d486f491e4a678a05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d39d7e502cf9a2a8c9d5d08e7ede9ba6dee08c6e8fc3b284ce663a9801d5e342.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:415317:125494:5669:1","source":"bangumi"}]},{"characterId":"char_c122750","characterName":"浄土浜 伽奈","sourceIds":{"bangumi":[{"characterId":"125495","match":"exact-normalized-name-in-linked-work","subjectId":"415317"}],"egsCharacterIds":["24600"],"vndbCharacterId":"c122750"},"originalCharacterName":"浄土浜 伽奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"38"},"bust":{"reviewState":"source-only","source":"vndb","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You can only call me mama and no one else.\""},{"spoiler":false,"text":"She is the president of Bunny's Mam."},{"spoiler":false,"text":"If the company is shorthanded, she usually goes out and does the \"mama service\" by herself."},{"spoiler":false,"text":"At first glance, she seems cool and unapproachable, but for some reason she has a soft spot for Ayato and is very kind to him."},{"spoiler":false,"text":"Furthermore she is soft-spoken and understanding of many things."},{"spoiler":false,"text":"Although she can handle household chores, but because of her perfectionism she prefers to ask people who are better than her to teach her."},{"spoiler":false,"text":"Kana has no children, and her husband works overseas and rarely comes back, so she lives alone most of the time."},{"spoiler":false,"text":"Translated from getchu"},{"spoiler":true,"text":"She had a son who died very young. MC looks 1:1 like him. Since the death of her son, she and her husband Kai are more like \"close friends\" than husband and wife. Kai is completly fine with divorce, so both can move on, and entrust the MC to take care of Kana since he is the only one who can fill the hole in her heart."},{"spoiler":true,"text":"She is showing sometimes symptoms of trauma because of her dead son, which is the reason why she is always clingy towards the MC since she is afraid of losing her \"son\" again."}],"source":"vndb","sourceCharacterId":"c122750"},{"segments":[{"spoiler":false,"text":"ママ代行サービス『Bunny's Mam』の社長。"},{"spoiler":false,"text":"一見、クールで近寄りがたいが、主人公には何故か甘々である。"}],"source":"egs","sourceCharacterId":"24600","sourceWorkId":"33836","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインの一人。"},{"spoiler":false,"text":"ママ代行サービス『Bunny's Mam』代表取締役社長。"},{"spoiler":false,"text":"人手が足りない時は、自ら出てサービスを行う。"},{"spoiler":false,"text":"一見クールで近寄りがたい雰囲気はあるが、物腰は柔らかで色々な事に理解はある。"},{"spoiler":false,"text":"家事は一通りこなせるが完ぺき主義な為、自分よりも優れた相手にはすぐに教えを乞う。"},{"spoiler":false,"text":"子供はおらず、旦那は海外で仕事をして滅多に帰ってこない為、ほぼ一人暮らし状態である。"}],"source":"bangumi","sourceCharacterId":"125495"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c241c85156618cd18791e341b482239dba8ee66e2ce07ae73c51ba5f3125639.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bf0e978891aa8d75e6380a5010f520fadb6e861d6e81cba3f0def01906abdf2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:415317:125495:6131:1","source":"bangumi"}]},{"characterId":"char_c122751","characterName":"小田 清子","sourceIds":{"bangumi":[{"characterId":"125496","match":"exact-normalized-name-in-linked-work","subjectId":"415317"}],"egsCharacterIds":["24601"],"vndbCharacterId":"c122751"},"originalCharacterName":"小田 清子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"29"},"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm waiting for your request, my cute son.\""},{"spoiler":false,"text":"The wife of \"Oda Osamuyu\" Onsen, a public bath that has been loved in the city for many years."},{"spoiler":false,"text":"Although she works as a staff member, her husband and her husband's parents do most of the work."},{"spoiler":false,"text":"She works under contract with \"Bunny's Mam\" to help with childcare and to make a little money for the family."},{"spoiler":false,"text":"Ayato and Kiyoko have a relationship like brother and sister, as they have always met on their way to school. Her two daughters also adore Ayato. Their relationship is good."},{"spoiler":false,"text":"However, Kiyoko has always had a strong desire to raise her own son. But she was gifted with 2 daughters instead."},{"spoiler":false,"text":"She always wanted to spoil Ayato, who had no mother, as his mother."},{"spoiler":false,"text":"Translated from getchu"}],"source":"vndb","sourceCharacterId":"c122751"},{"segments":[{"spoiler":false,"text":"街で長年愛される銭湯の奥さん。"},{"spoiler":false,"text":"主人公とは顔なじみで年の離れた姉弟のような関係。"}],"source":"egs","sourceCharacterId":"24601","sourceWorkId":"33836","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインの一人。"},{"spoiler":false,"text":"街で長年愛される銭湯『小田乃湯温泉』の奥さん。"},{"spoiler":false,"text":"一応、スタッフとして仕事はしているが、基本は旦那と旦那父母がほとんどやっている為、"},{"spoiler":false,"text":"子育てと少しでも家計の助けになれば、と『Bunny's Mam』と契約して働いている。"},{"spoiler":false,"text":"彩人は、昔から通学途中に会っていた事から清子とは年の離れた姉弟のような関係。"},{"spoiler":false,"text":"娘二人も彩人を慕っているので、関係は良好である。"},{"spoiler":false,"text":"ただ、清子の中に昔から息子を育てたいという強い願望がある為、"},{"spoiler":false,"text":"母親のいない彩人を自分が母親として甘やかしたいと常々思っている。"}],"source":"bangumi","sourceCharacterId":"125496"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5841382c2d0d29ba3c05d0c3a45d5253a847159f10129b4ced3d16a38d771dc0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f986b194f9d296de35ffec7adbe5e53f7aa24f143c078adfe6709295bb664cf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:415317:125496:12718:1","source":"bangumi"}]},{"characterId":"char_c122752","characterName":"木戸 紬貴","sourceIds":{"bangumi":[{"characterId":"125497","match":"exact-normalized-name-in-linked-work","subjectId":"415317"}],"egsCharacterIds":["24602"],"vndbCharacterId":"c122752"},"originalCharacterName":"木戸 紬貴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"26"},"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Being called mama makes me feel so happy, doesn't it?\""},{"spoiler":false,"text":"She is a young wife in a newly married family but her husband had been transferred away for a year after six months of marriage."},{"spoiler":false,"text":"To distract herself from her loneliness and because she promised her husband to have a baby when he came back."},{"spoiler":false,"text":"She became a contracted staff member of \"Bunny's Mam\" as a rehearsal for raising a child."},{"spoiler":false,"text":"Because she is still a newcomer, and her personality is a bit childish to begin with, she is struggling to become a \"mom\" and has an image of an older sister rather than a mother."},{"spoiler":false,"text":"Translated from getchu"}],"source":"vndb","sourceCharacterId":"c122752"},{"segments":[{"spoiler":false,"text":"新婚家庭の若奥さん。"},{"spoiler":false,"text":"夫が単身赴任中で、寂しさを紛らわせる為、『Bunny's Mam』の契約スタッフとなる。"}],"source":"egs","sourceCharacterId":"24602","sourceWorkId":"33836","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインの一人。"},{"spoiler":false,"text":"新婚家庭の若奥さん――だが、旦那が結婚半年で一年間単身赴任になってしまった。"},{"spoiler":false,"text":"寂しさを紛らわせる為と戻ってきた時に子供を作る約束をしたため、"},{"spoiler":false,"text":"子育ての予行練習として『Bunny's Mam』の契約スタッフとなる。"},{"spoiler":false,"text":"まだ新人の為である事と元々少し子供っぽい性格の為、"},{"spoiler":false,"text":"母親よりも姉のようなイメージで『ママ』になる事に四苦八苦している。"}],"source":"bangumi","sourceCharacterId":"125497"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6ca4bbbe3ca1fd80510bf5d949ff899dd4e51fbecc9971c5afa8855d856cc801.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b464a1949cfc2be90f2ac5678a05ecaa43fcf0942fa5025d8e630937fc56299.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"空賀花","creatorId":"vndb:s15476","sourcePersonId":"vndb:s15476","canonicalEntityId":"vndb:s15476","name":"空賀 花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:415317:125497:34089:1","source":"bangumi"}]},{"characterId":"char_vndb_c122748","characterName":"広瀬 彩人","sourceIds":{"vndbCharacterId":"c122748"},"originalCharacterName":"広瀬 彩人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayato is a second-year student at Okuba Academy."},{"spoiler":false,"text":"His mother passed away when he was a child since then he lives with his father."},{"spoiler":false,"text":"In order to support his busy father, he is in charge of housework and meals."},{"spoiler":false,"text":"Ayato sees his neighbor Rinko as an ideal mother figure and secretly gets the urge to get spoiled by her."},{"spoiler":false,"text":"Because of his young and androgynous appearance, he is loved and adored by men and women of all ages."},{"spoiler":false,"text":"However, Ayato was always a little concerned about that."},{"spoiler":false,"text":"Translated from amazon"}],"source":"vndb","sourceCharacterId":"c122748"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyI