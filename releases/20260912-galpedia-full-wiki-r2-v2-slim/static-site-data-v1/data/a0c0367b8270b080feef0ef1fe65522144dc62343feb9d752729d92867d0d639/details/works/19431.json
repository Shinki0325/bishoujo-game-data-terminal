lationId":"vndb:vn-staff:104484","source":"vndb"},{"creditedName":"曲木 一博","creatorId":"vndb:s34391","sourcePersonId":"vndb:s34391","canonicalEntityId":"vndb:s34391","name":"曲木 一博","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:104485","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c28369","characterName":"篠ノ之 束","sourceIds":{"vndbCharacterId":"c28369"},"originalCharacterName":"篠ノ之 束","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1220"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tabane is Houki's older sister, the creator of IS and a close friend of Chifuyu. Much to everybody's surprise, Tabane is a very energetic person and runs around like a happy child. She often refers herself as \"Tabane the Genius\", hinting to a sense of cockiness. She is very fond of the people she loves and would hug them as many times as she feels like. She states that there are only three people in the world that have any meaning to her (Houki, Chifuyu, and Ichika) and the rest of the humans are the same to her (she can't identify one human from another)."},{"spoiler":false,"text":"From IS Wiki"}],"source":"vndb","sourceCharacterId":"c28369"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0d479fa1832389c93f7dddc88365c66b176a6914075075d2ad37309e3d80038.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2de93fe0d3efbdb7e217f982028a671abe09748c4639623a5dea5fdd3598be9.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村 ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55889","source":"vndb"}]},{"characterId":"char_vndb_c28370","characterName":"更識 簪","sourceIds":{"vndbCharacterId":"c28370"},"originalCharacterName":"更識 簪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"806"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kanzashi is a 1st year student at the IS Academy in Class Four, younger sister of Tatenashi Sarashiki and the IS Representative Candidate of Japan. Kanzashi is the polar opposite of Tatenashi; while her older sister is cheerful, talkative and very forward, Kanzashi herself is far more reserved. She shies unnecessary violence on the grounds that it wastes energy that could be used doing something more productive."},{"spoiler":false,"text":"She likes anime and is a fan of anime heroes. Despite being the IS Representative Candidate of Japan, she doesn't have a personal IS. This is because the lab where her IS was being designed delayed the construction to built Ichika's Byakushiki instead."},{"spoiler":false,"text":"From IS Wiki"}],"source":"vndb","sourceCharacterId":"c28370"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04fef014d7df9ea66195376f7892309b6bf5a6b8f44ba9ce24f4f4ca7ea1ef75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8447c06fb395499028447127782f49bb6b68e95b49381b4eae303abdcf53919.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三森 すずこ","creatorId":"vndb:s627","sourcePersonId":"vndb:s627","canonicalEntityId":"vndb:s627","name":"三森 すずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55895","source":"vndb"}]},{"characterId":"char_vndb_c28371","characterName":"更識 楯無","sourceIds":{"vndbCharacterId":"c28371"},"originalCharacterName":"更識 楯無","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"309"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tatenashi is a 2nd year student at the IS Academy, Student Council President of the IS Academy, and the IS Representative of Russia; this is due her combat skills, which exceed Cadet level. In the light novel, she is said to have very high standards due to her prestigious family, where everything must be done perfectly. Despite that, she has, as Ichika puts it, \"a wild, or rather whimsical, personality with slight cat-like mischief.\" She enjoys teasing people and tickling others (her unfortunate victims are mostly Ichika and Laura). Despite her tendency to tease, Tatenashi has also shown moments of being flustered, mostly as a result of her feelings for Ichika. She does have a serious side, though she tends to talk playfully even when serious so it can be difficult to determine just how seriously she is taking things."},{"spoiler":false,"text":"Tatenashi takes failing rather hard, due to the fact she has many titles that she always prides herself in (Student Council President, Sarashiki family head, and IS Representative of Russia). She is also a little insecure when it comes to her sister, as she wants to help/support her but they do not get along with each other due to their competitive natures - a holdover from their childhood. This is one of the few topic where she show a gloomy side to her normal cheerfulness."},{"spoiler":false,"text":"From IS Wiki"}],"source":"vndb","sourceCharacterId":"c28371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/416b4c625b5fbe5b016e016038977dc0508f793b52fe2d5f8f07dfb168b74b37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9f4101f9d6edab72b59e109d4cea4f31940308788efe9b0977d53ca449741a0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎藤 千和","creatorId":"vndb:s475","sourcePersonId":"vndb:s475","canonicalEntityId":"vndb:s475","name":"斎藤千和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55892","source":"vndb"}]},{"characterId":"char_vndb_c28372","characterName":"ラウラ・ボーデヴィッヒ","sourceIds":{"vndbCharacterId":"c28372"},"originalCharacterName":"ラウラ・ボーデヴィッヒ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"source-only","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 1st year transfer student at the IS Academy in Class One and the IS Representative Candidate of Germany. She is initially seen as a tough person who absolutely despised Ichika for (indirectly) making his sister, Chifuyu Orimura, forfeit the match Laura believed Chifuyu should have rightfully won. She has a major superiority complex surrounding her identity as a super soldier, as she often remarks that surrounding people's abilities are second-rate. She insulted Cecilia Alcott and Lingyin Huang during their first fight, saying that she has a hard time believing people like them possess 3rd Generation IS's. She comments that they come from countries that boasts of numbers but no talent (Lingyin), or whose only redeeming quality is their ancient culture (Cecilia). Having been raised in the army, she does not understand the workings of a normal life, seen as when she calls Ichika her \"Wife\", and when she comments that two hours of seiza is nothing compared to torture. milarly to Houki, Laura is rather shy when it comes to her looks despite her pride. While never having been interested in her looks or clothes before, she started thinking about them more in order to get Ichika's attention. When she does, she becomes very happy and unfocused on everything else except what Ichika has said to her. Strangely, she doesn't mind being naked in front of him."},{"spoiler":false,"text":"From IS Wiki"}],"source":"vndb","sourceCharacterId":"c28372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f92c11ed48fa4a9ac13503670dd360e8765bc78e54d7e4295abd0e0ddde8170b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/166867c86fb0bffff0c30b79c9ca579c68cb3b2c563e35e4fe2aee116aa12538.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 麻里奈","creatorId":"vndb:s1774","sourcePersonId":"vndb:s1774","canonicalEntityId":"vndb:s1774","name":"井上 麻里奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55897","source":"vndb"}]},{"characterId":"char_vndb_c28373","characterName":"シャルロット・デュノア","sourceIds":{"vndbCharacterId":"c28373"},"originalCharacterName":"シャルロット・デュノア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"226"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 1st year transfer student at the IS Academy In Class One and is the IS Representative Candidate of France. Even if her true purpose at the academy was to spy on Ichika, discover how he is able to pilot an IS, and acquire data from his IS, Charlotte is very kind, always maintaining a polite demeanor towards everybody. She has an inherent dislike for lying to anyone, as she mentions that she is relieved she was able to tell Ichika the truth and that she apologizes for having to lie to him all the time. While Charlotte has been shown to be quite mature, she doesn't mind being girly or childish, such as getting Laura and herself cat pajamas and even teasing her with them (although she became very embrarrassed when Ichika saw her in them). She can also be very impulsive, usually creating very awkward and embrarrassing situations for her and Ichika, only realizing what she doing (or has done) when it is too late, such as when she brought him into a changing room to hide him from the other girls, only to start changing her clothes anyway."},{"spoiler":false,"text":"From IS Wiki"}],"source":"vndb","sourceCharacterId":"c28373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/971982d58bc97333ffe1a34c3361ecebbd26b3f2e7cfe235445b99c72c9f1951.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cb341a0f73452f1d607dc5be2657f1a7bde016ae88ddc2adf0cef8970c6f481.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤 香菜","creatorId":"vndb:s237","sourcePersonId":"vndb:s237","canonicalEntityId":"vndb:s237","name":"花澤香菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55890","source":"vndb"}]},{"characterId":"char_vndb_c28374","characterName":"凰 鈴音","sourceIds":{"vndbCharacterId":"c28374"},"originalCharacterName":"凰 鈴音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"source-only","source":"vndb","value":"32"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lingyin is a 1st year transfer student student in Class Two at IS Academy, the 2nd childhood friend of Ichika Orimura, IS Representative Candidate of China, and Class Representative of Class Two. Lingyin is depicted as a very energetic girl with a slight competitive streak. In her middle school year, she was usually the target for pranks due to her nationality. However, Ichika helped protect her from these situations (e.g. when he protected her from four school bullies). Because of this, she developed romantic interests for him and made him promise that if she became an excellent cook, he would become her boyfriend. When she meets Ichika again at IS Academy she becomes disappointed and extremely hostile to him because he had forgotten the details of the promise."},{"spoiler":false,"text":"From IS Wiki"}],"source":"vndb","sourceCharacterId":"c28374"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/528cbbd4621c7771f528e405c16e302b8e34c11b1d043dfb1eb223befa8abd92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5830bca04e84634503b490840989b194a2f3b993997a2435c3bab1af26f57d6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"下田 麻美","creatorId":"vndb:s1597","sourcePersonId":"vndb:s1597","canonicalEntityId":"vndb:s1597","name":"下田 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55896","source":"vndb"}]},{"characterId":"char_vndb_c28375","characterName":"セシリア•オルコット","sourceIds":{"vndbCharacterId":"c28375"},"originalCharacterName":"セシリア•オルコット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1224"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ichika's classmate and the IS Representative Candidate of the United Kingdom. Cecilia is depicted as quite an arrogant person, due to the fact she is a representative of another country. Being the snob from a noble family, she seems to think her country is far superior to other countries, and because of that, Ichika challenged her to a duel. But behind her confident exterior lies a disturbed soul. Due to her father being a very insignificant person who has no role inside or outside the family, she desires to marry someone who is strong. Furthermore, being the sole heir of the family fortune after her family died in a train accident, she was forced to protect it from those who wanted to steal it. She apparently has certain delusions of being alone with Ichika, although she does feel embarrassed about having them nonetheless."},{"spoiler":false,"text":"From IS Wiki"}],"source":"vndb","sourceCharacterId":"c28375"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c55add254a2cc4a868f0f00a58fee17af77a48cfc8573704258558aa1189856.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a7268a4abbe9675e90c6b96bf348d5f4fbe250745a39956f5545fd6aeec4086.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ゆかな","creatorId":"vndb:s51","sourcePersonId":"vndb:s51","canonicalEntityId":"vndb:s51","name":"ゆかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55888","source":"vndb"}]},{"characterId":"char_vndb_c28376","characterName":"篠ノ之 箒","sourceIds":{"vndbCharacterId":"c28376"},"originalCharacterName":"篠ノ之 箒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Houki is the 1st childhood friend of Ichika and a 1st year student at the IS Academy in Class One. Having been raised in a shrine, her personality is of discipline and temperateness. As such, she had a hard time socializing with other kids (other boys made fun of her for being boyish) so she had virtually no friends (until she went to the IS Academy), except for Ichika who thought of her as a cute girl and helped her out by chasing those boys away whenever she was being mocked. She also has a serious emotional problem, not being able to suppress her temper and often resorting to violence. Although she has been training kendo (which emphasizes obtaining self-control as with most other forms of martial arts) she is somewhat emotionally unstable, often resorting to be controlled by her own strength rather than controlling it herself, especially when she gains a new power."},{"spoiler":false,"text":"From IS Wiki"}],"source":"vndb","sourceCharacterId":"c28376"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/fffc3f45ce604553855f2d0576c0f5e3c75f89a0ed99a85b7061919ba073dffc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08ae1a5647ef4f691717d06e261c035a02a2ee8e6b409b52c9a938dab1a5eb21.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日笠 陽子","creatorId":"vndb:s616","sourcePersonId":"vndb:s616","canonicalEntityId":"vndb:s616","name":"日笠 陽子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55894","source":"vndb"}]},{"characterId":"char_vndb_c62443","characterName":"布仏 本音","sourceIds":{"vndbCharacterId":"c62443"},"originalCharacterName":"布仏 本音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Ichika's classmates who loves eating snacks. She is a member of the student council together with her older sister Utsuho."}],"source":"vndb","sourceCharacterId":"c62443"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c07fe6e1033d21d276715c5025d5e5185a562ab8a7bfd52aabbde465a53551eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe220db19036bab77d9d6013b7da1cebf0e9b4d48c58c0bbcd42588249083285.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"門脇 舞以","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"門脇 舞以","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55891","source":"vndb"}]},{"characterId":"char_vndb_c62444","characterName":"織斑 千冬","sourceIds":{"vndbCharacterId":"c62444"},"originalCharacterName":"織斑 千冬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chifuyu is Ichika's older sister, and homeroom teacher of his class at the Academy. She was the Japanese pilot for the first-generation IS machines and was said to be the strongest IS pilot at one point before retiring. During her retirement, she looked after her brother and raised him by herself after their parents abandoned them at a young age. Despite her indifference towards Ichika, Chifuyu deeply cares for her brother, as she sees him as her only family. Chifuyu was also the one who enrolled Ichika to the IS Academy to keep him safe from other countries."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c62444"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a37b49f64fb26e64fd21c183272692b8a24de3a5490bf7ab5c9e2dcc50d2f2c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c5a7e86dff610c267a301fac07db2ee9f80b13ac6db625425af3b8cbb567c8a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊口 めぐみ","creatorId":"vndb:s614","sourcePersonId":"vndb:s614","canonicalEntityId":"vndb:s614","name":"豊口 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55893","source":"vndb"}]},{"characterId":"char_vndb_c62446","characterName":"相川 清香","sourceIds":{"vndbCharacterId":"c62446"},"originalCharacterName":"相川 清香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1015"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Ichika's classmates. She is part of the IS Academy's handball team. Kiyoka loves watching sports and jogging."}],"source":"vndb","sourceCharacterId":"c62446"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f63bdca28c5720c6c0d3bfb22e75fb269de3582e2dec1377f8bcb8446da8a9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac889d3e349e32723e224fe1392e84a608291483d1af849a13ba9c87b60c39dc.webp","width":155,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 有世","creatorId":"vndb:s3827","sourcePersonId":"vndb:s3827","canonicalEntityId":"vndb:s3827","name":"佐藤 有世","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55898","source":"vndb"}]},{"characterId":"char_vndb_c62448","characterName":"黛 薫子","sourceIds":{"vndbCharacterId":"c62448"},"originalCharacterName":"黛 薫子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student who is the vice president of the Newspaper Club."}],"source":"vndb","sourceCharacterId":"c62448"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/230d3d17d9ced88cc886ed9a927afde726d5d95775f8a92dfd393c13e4eb0c82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43e42d1b0bdfe686a84c57de5774ffa5960ffc1ff042162455f4e0efb7d392fc.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"世戸 さおり","creatorId":"vndb:s8690","sourcePersonId":"vndb:s8690","canonicalEntityId":"vndb:s8690","name":"世戸 さおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55899","source":"vndb"}]},{"characterId":"char_vndb_c70457","characterName":"織斑 一夏","sourceIds":{"vndbCharacterId":"c70457"},"originalCharacterName":"織斑 一夏","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"927"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ichika is the protagonist. He is a first year student and class representative, as well as Vice-President of the Student Council at IS Academy. His older sister, Chifuyu, is a legendary IS pilot who raised him when the siblings' parents abandoned them at a young age. During the second Mondo Grosso tournament, he was kidnapped by the Phantom Task, that effectively causes Chifuyu to forfeit the match to rescue him, to which he regrets for being a weak brother. As the first male IS pilot, his new reputation has made him somewhat famous as many scientists and engineers would like to study him."},{"spoiler":false,"text":"He is mainly absent minded and oblivious to the feelings of the girls around him and seems to misunderstand their feelings towards him. Rumor has it that Ichika is aware of the girls' feelings for him, but avoids such affections due being the only male in school, and believes himself to have zero talent for a suitable man."}],"source":"vndb","sourceCharacterId":"c70457"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/078e36e2378257b1a18288877597b8222729bdd4cc39f61ce6faa1a4e2b428e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18b7b68f235c2c175f14443acf4408022595679fa8a0074ccf230914bf9b1906.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内山 昂輝","creatorId":"vndb:s12922","sourcePersonId":"vndb:s12922","canonicalEntityId":"vndb:s12922","name":"内山 昂輝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55900","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2282","sourceCompanyId":"egs:brand:2282","canonicalEntityId":"egs:brand:2282","name":"MAGES.(5pb.)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:19431:2282","source":"egs"},{"companyId":"vndb:p146","sourceCompanyId":"vndb:p146","canonicalEntityId":"vndb:p146","name":"MAGES.","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:34911:v13865","source":"vndb"},{"companyId":"vndb:p146","sourceCompanyId":"vndb:p146","canonicalEntityId":"vndb:p146","name":"MAGES.","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:36240:v13865","source":"vndb"},{"companyId":"vndb:p146","sourceCompanyId":"vndb:p146","canonicalEntityId":"vndb:p146","name":"MAGES.","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:44869: