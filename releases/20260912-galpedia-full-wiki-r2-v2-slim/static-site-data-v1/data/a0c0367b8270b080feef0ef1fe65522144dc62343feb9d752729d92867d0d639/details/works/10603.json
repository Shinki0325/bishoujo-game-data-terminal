。"}],"source":"egs","sourceCharacterId":"13592","sourceWorkId":"8722","spoiler":false},{"segments":[{"spoiler":false,"text":"神話世代の戦乙女。ハガルの姉。"},{"spoiler":false,"text":"彼女自身は旧世界と共に眠りにつき、いくつかの時代に目覚める彼 女の端末的な存在の人物が世界に存在するらしい。"}],"source":"bangumi","sourceCharacterId":"143716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee866d5af70ffd6d56c6e9854ffe1d8fce23267b860e7640b234533b8d335900.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0b929bce1e9902afe28bf2d26601fcdf6c0bb3f64d21937d0e7e9c93b5c48f5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3590:143716:19411:1","source":"bangumi"}]},{"characterId":"char_c11182","characterName":"海良宜 深吾","sourceIds":{"bangumi":[],"egsCharacterIds":["13589"],"vndbCharacterId":"c11182"},"originalCharacterName":"海良宜 深吾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"かつては鴻埜教授の助手で、同じ大学に勤務している助教授。"},{"spoiler":false,"text":"“時の船”遺跡にでの事件は大学側としても不祥事扱いで、その事件を調査する珠子は目を付けられてしまう。"},{"spoiler":false,"text":"海良宜は珠子のお目付役として、琉平達の学園に赴任してくる。性格は何事にも冷めたていて事なかれ主義者。"},{"spoiler":false,"text":"しかし、その心の内は……"}],"source":"egs","sourceCharacterId":"13589","sourceWorkId":"8722","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96fd38aa2d970c423ce3e96fc30f91949a0e20408dcd32d40f9fa9f9f1905948.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characte