{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29866","model":{"presentationWorkId":"egs:29866","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_161581","characterName":"エフェリカ","sourceIds":{"bangumi":[{"characterId":"161581","match":"source-roster","subjectId":"326795"}]},"originalCharacterName":"エフェリカ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メインヒロイン:エフェリカ(CV:緑野らいむ)"},{"spoiler":false,"text":"『魔の先触れ』～魔法の才に溢れた麒麟児～"},{"spoiler":false,"text":"白銀の髪を優雅になびかせる可憐な美少女『エフェリカ』。"},{"spoiler":false,"text":"貴族である両親から高名な魔法使いになるべく大きな期待を寄せられていた。"},{"spoiler":false,"text":"しかし、エフェリカは16歳を超えても一切の魔法を発動させることが出来なかった。"},{"spoiler":false,"text":"両親に見限られ、王都の貴族商人に身売りされそうになりながらも、一人の魔剣の鍛冶師によって救われる。"},{"spoiler":false,"text":"命を救われたことを感謝すると共に生きる気力をなくした少女に男が手を差し伸べた。"},{"spoiler":false,"text":"『私は魔具鍛冶職人、魔力を有するパートナーを探していた、もし良ければ私と共に王都に行かないか?』"},{"spoiler":false,"text":"知らない男に差し伸べられた手はエフェリカが生まれてきてから一度も感じたことのない淡い光のような感情を抱かせた。"},{"spoiler":false,"text":"『わ…わたしでよければ……おねがいします…。』"},{"spoiler":false,"text":"こうして不幸な少女と魔具鍛冶職人の物語が幕を開けるのであった。"},{"spoiler":false,"text":"★★★★★★★★★★★★★★★★★★★★★★★★★★★"},{"spoiler":false,"text":"声優:緑野らいむ　様"},{"spoiler":false,"text":"ツイッター:"},{"spoiler":false,"text":"H　P:"},{"spoiler":false,"text":"★★★★★★★★★★★★★★★★★★★★★★★★★★★"}],"source":"bangumi","sourceCharacterId":"161581"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c8ecb551ce2cf03a123e8498d7c12d8b2974587c07c63ce56d3560db770a870.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e94dd2ca37dc2dd0348eac80cdb29be7458743205fdd2254be3cffff8ee7b867.webp","width":215,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:6710","sourceCompanyId":"egs:brand:6710","canonicalEntityId":"egs:brand:6710","name":"FANTASY・FACTORY","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:29866:6710","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
