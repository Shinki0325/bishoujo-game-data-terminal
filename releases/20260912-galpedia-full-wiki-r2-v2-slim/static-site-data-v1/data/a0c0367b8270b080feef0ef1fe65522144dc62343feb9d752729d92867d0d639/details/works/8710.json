,"characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student of Masaya's, she is an honest, quiet, honor student type of girl. In fact, her grades are good, and combined with her cute appearance, she is treated as a bit of an idol in the school."},{"spoiler":false,"text":"However, she is unaware of this, and at home she plays the big sister to her younger sister, Shiori."},{"spoiler":false,"text":"She has never been with a man and is still a virgin. Perhaps because of this, she has a strong sense of chastity and rejects Masaya as a “man,” but she is manipulated by the power of the notebook and opens her legs in front of a man."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c45772"},{"segments":[{"spoiler":false,"text":"雅也の教え子で、素直でおとなしい優等生タイプの女の子。"},{"spoiler":false,"text":"実際成績は良く、可愛らしい容姿と相まって学園内ではちょっとしたアイドルの扱い。"},{"spoiler":false,"text":"しかし本人はそういった自覚が無く、また家の中では妹の栞（しおり）にお姉さんぶる一面も。"},{"spoiler":false,"text":"男性とつき合ったことはなく、いまだに処女。"},{"spoiler":false,"text":"その所為か貞操観念が強く、“男”としての雅也は拒絶していたが、ノートの力によって操られ、自ら男の前で股を開くのだった……"}],"source":"egs","sourceCharacterId":"23708","sourceWorkId":"8710","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の教え子で、素直で大人しい優等生タイプの女の子。"},{"spoiler":false,"text":"実際成績はよく、容姿と相まって学園内ではちょっとしたアイドルの扱い。"},{"spoiler":false,"text":"しかし本人はそういったことを気にしておらず、家の中では妹の栞にお姉さんぶる一面も。"},{"spoiler":false,"text":"男を知らない無垢な感じが欲情を誘うのだが、本人自身もそういった知識を持っていない。"},{"spoiler":false,"text":"そういった優美がノートの力で操られ、快感の味を覚えてしまったら…堕ちていくのもまた早いのである。"}],"source":"bangumi","sourceCharacterId":"92523"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"23708","sourceWorkId":"8710","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"23708","sourceWorkId":"8710","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"23708","sourceWorkId":"8710","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"23708","sourceWorkId":"8710","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56891d57636eb62b1c2f31bdfe7c5e9d846b4dc06c5d815d3148fef271857f55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/789d2f30fcd8c9a5396819d6597d0f8a7c822d2ed225633fb910de51836ddd05.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230223:92523:4675:1","source":"bangumi"}]},{"characterId":"char_c45773","characterName":"高梨 栞","sourceIds":{"bangumi":[{"characterId":"92524","match":"exact-normalized-name-in-linked-work","subjectId":"230223"}],"egsCharacterIds":["23709"],"vndbCharacterId":"c45773"},"originalCharacterName":"高梨 栞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segm