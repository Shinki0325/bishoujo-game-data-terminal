{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"27947","model":{"presentationWorkId":"egs:27947","staff":{"artwork":[{"creditedName":"梅鳥うりり(福永ユミ、福永由美)","creatorId":"vndb:s1081","sourcePersonId":"egs:creator:15748","canonicalEntityId":"vndb:s1081","name":"梅鳥うりり(福永ユミ、福永由美)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242843","source":"egs"},{"creditedName":"男爵","creatorId":"egs:creator:36516","sourcePersonId":"egs:creator:36516","canonicalEntityId":"egs:creator:36516","name":"男爵","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:270962","source":"egs"},{"creditedName":"ねこまか","creatorId":"vndb:s33849","sourcePersonId":"egs:creator:40959","canonicalEntityId":"vndb:s33849","name":"ねこまか","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:298896","source":"egs"}],"scenario":[{"creditedName":"ねこまか","creatorId":"vndb:s33849","sourcePersonId":"egs:creator:40959","canonicalEntityId":"vndb:s33849","name":"ねこまか","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:279888","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_161385","characterName":"新米神官マリーゼル","sourceIds":{"bangumi":[{"characterId":"161385","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"新米神官マリーゼル","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【新米神官マリーゼル】(CV烏丸そら)"},{"spoiler":false,"text":"良家のお嬢様だったが、霊感を認められて『教会』の総本山ヒエペリオに預けられた元貴族の娘。生まれが良すぎるために、どこか浮き世離れをしており、『英雄』の存在を信じて教会を抜け出し冒険者になる。純粋すぎるために思い込みが激しく、信仰欲と布教欲が暴走することも。"}],"source":"bangumi","sourceCharacterId":"161385"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83d6f940edf6aa69ab03dd3984fbe2d3a964dc07fb768ea03b91ca4cd18de9ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/2651308baf066cf4da3920c1cf548fed205c44c2e051ccef3693b997bd8d6402.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"深雪ゆあ","creatorId":"vndb:s26","sourcePersonId":"vndb:s26","canonicalEntityId":"vndb:s26","name":"深雪 ゆあ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161385:20776:1","source":"bangumi"}]},{"characterId":"char_bangumi_161386","characterName":"鍛冶姫アンジュ","sourceIds":{"bangumi":[{"characterId":"161386","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"鍛冶姫アンジュ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【鍛冶姫アンジュ】(CV月野きいろ)"},{"spoiler":false,"text":"精霊と妖精のハーフと呼ばれ、「地」の守護を得るドワーム族の娘。鍛冶の達人が揃うというドワームの中でも、未来を変える天才とされる『鍛冶姫』。チヤホヤされて可愛がられていたため、変な口調の変な性格の娘になってしまった。"},{"spoiler":false,"text":"背が低いが、種族の特性なので気にしてない。"}],"source":"bangumi","sourceCharacterId":"161386"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a2bf1298694331008224dd83de08a04d7f98136c25c54c8cf45b39d81fb564d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d76869b4a247b989d03a75d4a43d425da31bec6180feb239b6dff10f0bae214.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161386:20696:1","source":"bangumi"}]},{"characterId":"char_bangumi_161387","characterName":"森人の射手エリオルダ","sourceIds":{"bangumi":[{"characterId":"161387","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"森人の射手エリオルダ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【森人の射手エリオルダ】(CV鹿瀬紫卯)"},{"spoiler":false,"text":"精霊と妖精のハーフともいわれ、「風」の守護を得るエルフィード族の女冒険者。超一流の「野伏」であり、同時に超一流の「剣士」でもある。人を避けて修行するのが大好きであり、それゆえ人と接するのは苦手。"},{"spoiler":false,"text":"背が低いと言われると怒る。本人が気にしているだけなのだが。"}],"source":"bangumi","sourceCharacterId":"161387"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cbf47ee5157e0e17f4f4c454e73f05a7be15530731106bec8abb88165db4035.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb0d54deda8863252affb033389b51dcc2fd2e4a4e8c3d761aabcf160a2a2382.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"鹿瀬紫卯","creatorId":"vndb:s8642","sourcePersonId":"vndb:s8642","canonicalEntityId":"vndb:s8642","name":"鹿瀬紫卯","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161387:56841:1","source":"bangumi"}]},{"characterId":"char_bangumi_161388","characterName":"女商人ハーヴェスタ","sourceIds":{"bangumi":[{"characterId":"161388","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"女商人ハーヴェスタ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【女商人ハーヴェスタ】(CVあかしゆき)"},{"spoiler":false,"text":"この世界の商人をとりまとめる組織『商人協会』の幹部の娘として、若くして店を持った才女。経営手腕は優秀で、勢力を広げている。シイネは彼女から金を貸りたことで、彼女に対して大きな借金を背負うことになる。定期的にハーヴェスタの集金イベントが発生し、ノルマを満たせないとゲームオーバー。"}],"source":"bangumi","sourceCharacterId":"161388"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d608f43725a42de2a2291a9a6c0170cb60f315561b223936c523034f8d75310.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/6075c16480831c9996e0cbb4239e0415da3a8d958fde8ecd80a45c4e16d9ec31.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161388:8055:1","source":"bangumi"}]},{"characterId":"char_bangumi_161389","characterName":"女冒険者ファシィ","sourceIds":{"bangumi":[{"characterId":"161389","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"女冒険者ファシィ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【女冒険者ファシィ】(CV姫川あいり)"},{"spoiler":false,"text":"宿屋にふらりとやってきた「親近感のある」少女。盗賊のジョブを持っており、手練れの冒険者。"},{"spoiler":false,"text":"言葉巧みに近寄り、主人公に近い距離で接してくる。主人公と大きな共通点がある少女。えっちなことがとても得意。"}],"source":"bangumi","sourceCharacterId":"161389"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ebd0c1a1b3b0dc3de6e5c20f4ed7a191538fd271cb5e444ae8f54202806c0ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58171da1e5a14f890936f8e4c82ce770078b44fe6480b1e97f3722ab97a578f5.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161389:5939:1","source":"bangumi"}]},{"characterId":"char_bangumi_161390","characterName":"牧場娘キャトリナ","sourceIds":{"bangumi":[{"characterId":"161390","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"牧場娘キャトリナ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【牧場娘キャトリナ】(CV水霧けいと)"},{"spoiler":false,"text":"牧場の娘。おっとりとした物腰の穏やかな少女。年下のお姉ちゃん。豊満で包容力の高い外見で、心も穏やかで優しい。日頃から牛の世話をする農家の娘で、"},{"spoiler":false,"text":"ヒロインの中では唯一の完全な非戦闘員。死の淵に瀕しても抵抗すら想像できないほど。"}],"source":"bangumi","sourceCharacterId":"161390"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c817c2c7fcf6882a351c1fce3d148f2b0f1f049e0103984bbb39a79c3e31d79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fbe4f9ab9f3bc3b723ed5a554e424fc87236b7579f598ae441ae96f86765802.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"水霧けいと","creatorId":"vndb:s955","sourcePersonId":"vndb:s955","canonicalEntityId":"vndb:s955","name":"水桐 けいと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161390:6173:1","source":"bangumi"}]},{"characterId":"char_bangumi_161391","characterName":"狼娘ウルフィナ","sourceIds":{"bangumi":[{"characterId":"161391","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"狼娘ウルフィナ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【狼娘ウルフィナ】(CV蒼依ハル)"},{"spoiler":false,"text":"南国の森で捕獲され、金持ちに売られそうになっていた野生児。暴れ者でワガママ・いうことを聞かない性格。「歩く宝石」と呼ばれる『ケモミミ』は非常に高額で取引される。しかし見た目に反して非常に高い知能と戦闘力を持ち、人間には絶対に懐かない。"}],"source":"bangumi","sourceCharacterId":"161391"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9b5a16fff72f18d1d32bb95d7a10eeefcae387c84572665db0ddcdf5848bcda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f1527e13fe3b0a81cc558d97c7f1073c76c90ef7a68a7bf28d116cb87e48eb9.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161391:11646:1","source":"bangumi"}]},{"characterId":"char_bangumi_161392","characterName":"夢魔ルーシェルーラ","sourceIds":{"bangumi":[{"characterId":"161392","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"夢魔ルーシェルーラ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【夢魔ルーシェルーラ】(CV桜似あかり)"},{"spoiler":false,"text":"『死神』の力をかぎ取って宿屋に押しかけてくる淫魔。主人公をお兄ちゃんと呼び、天真爛漫に甘えてくる。稀少な『サキュバス』の因子を持ち、それを大成させるため、宿で淫魔パワーを集めようと考えている。『死神』の力は淫魔の力の似たようなものなので、彼女の誘いに乗ることは『死神』の力を増す近道とのこと。"}],"source":"bangumi","sourceCharacterId":"161392"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd5992091925b02e480a38c949ff75e87a7b4c73b71d579356a900f902fb344b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/063c3b89d2c25ff33667158753254db6190653b8ea4f2b3bae8d787b37174b44.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"桜似あかり","creatorId":"vndb:s13033","sourcePersonId":"vndb:s13033","canonicalEntityId":"vndb:s13033","name":"桜似あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161392:40313:1","source":"bangumi"}]},{"characterId":"char_bangumi_161393","characterName":"魔女カリスト・ウィルチ","sourceIds":{"bangumi":[{"characterId":"161393","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"魔女カリスト・ウィルチ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【魔女カリスト・ウィルチ】(CV神無月ほのか)"},{"spoiler":false,"text":"魔薬(ドラッグ)の始祖である天才薬師「ウィルチ」の名を冠する、当代最高の『魔女』。主人公の宿にふらりとやってきてが、何が気に入ったのか定住してしまった。彼女たち「ウィルチ」のみ作れる魔薬は権力者垂涎の品。基本的に常識人で頼れる賢者なのだが、天才なので一般人には理解しにくい部分もある。"}],"source":"bangumi","sourceCharacterId":"161393"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bfd0867d8b846e832724235e2017ee82fe221e9b1beaeb3ed48ff864c0884b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7067eceeb847e70dc0059cb3630e2dd95a186bb34ace71d4d360b303098b880.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"笹島かほる","creatorId":"vndb:s1017","sourcePersonId":"vndb:s1017","canonicalEntityId":"vndb:s1017","name":"笹島 かほる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:161393:3944:1","source":"bangumi"}]},{"characterId":"char_bangumi_75912","characterName":"お金大好きな女主人","sourceIds":{"bangumi":[{"characterId":"75912","match":"source-roster","subjectId":"301467"},{"characterId":"75912","match":"source-roster","subjectId":"386269"},{"characterId":"75912","match":"source-roster","subjectId":"386270"}]},"originalCharacterName":"お金大好きな女主人","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"死神の少女。死にやすい運命を持つ主人公の素質に目を付け、自分の力を分け与えて『死神代行』にした張本人。"},{"spoiler":false,"text":"素っ気ない口調だが、主人公を嫌ってるわけではない。本来は冥界に住んでいるらしい。"},{"spoiler":false,"text":"とってもお金大好きだが、商才はゼロ。嫌いな動物はネズミ。"}],"source":"bangumi","sourceCharacterId":"75912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee00bc65c88ad505baa7b20e210bab050434840dcfb5e5d00fdb18f1fd62f718.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30ec7bd16e69ee8943295adeae4dce81fcf2943421430aabe1d9f08546da88f5.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:75912:4830:1","source":"bangumi"}]},{"characterId":"char_bangumi_92132","characterName":"銀灰の魔術師ミルテ","sourceIds":{"bangumi":[{"characterId":"92132","match":"source-roster","subjectId":"301467"}]},"originalCharacterName":"銀灰の魔術師ミルテ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"魔術の名門、ソルシア魔術学院に首席で「入学」した自称「天才」魔術師で、カリストの親友(互いに互い以外の友人がいない)。絶大な魔力を持ち才能も確かなのだが、それゆえに他人を見下すことが多いコミュ障で、学院に馴染めず中退してしまった。魔術のコントロールが下手で暴走させてしまい、それを制御する彼女専用の「禁呪」の伝承を探し求めている。"}],"source":"bangumi","sourceCharacterId":"92132"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27b14ad525dcd3883da4cda914a4d693eecc61d6c35cbc4270ac649b018d2400.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/942fdd4c7b49260e4f9bc1aee9fc62011748818b6051e70bf92f729fc3b5ad72.webp","width":220,"height":180,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301467:92132:5075:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p10289","sourceCompanyId":"egs:brand:5233","canonicalEntityId":"vndb:p10289","name":"サークル冥魅亭","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27947:5233","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
