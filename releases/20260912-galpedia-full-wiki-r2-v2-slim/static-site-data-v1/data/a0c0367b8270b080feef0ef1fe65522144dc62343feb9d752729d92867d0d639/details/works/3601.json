ized-name-in-linked-work","subjectId":"104047"},{"characterId":"138370","match":"exact-normalized-name-in-linked-work","subjectId":"210774"}],"egsCharacterIds":["25694"],"vndbCharacterId":"c149830"},"originalCharacterName":"シャミー・リスニィ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"このゲームの主人公。"},{"spoiler":false,"text":"戦士の家系であるリスニィ家の家職を継ぐために一生懸命修行し、3度も魔術の認定試験に落ちながらも、なんとか戦士として認められた。"},{"spoiler":false,"text":"何事にも持ち前の明るさで「なんとかやってみよう！」と頑張る、元気一杯の女の子。"}],"source":"egs","sourceCharacterId":"25694","sourceWorkId":"7396","spoiler":false},{"segments":[{"spoiler":false,"text":"戦士の家系に生まれたものの、３回も魔法試験に落ち、やっと戦士として認められる。"},{"spoiler":false,"text":"ちょっとドジだけど、何事にも一生懸命なのがとりえ。"},{"spoiler":false,"text":"戦士になって初めての任務が、お姫様達の探索という重大なものに・・・。"}],"source":"bangumi","sourceCharacterId":"138370"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9727465dcdb2260f11d77214c58eb4bfa6f33c58b0746c25eb6ff9c1383c3994.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fabbb95a53d15f6966e2293775f7c10ac4472534aae734ccf4dbf7f55512f4b2.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c149831","characterName":"ヴィガ＝キャステイン","sourceIds":{"bangumi":[{"characterId":"138371","match":"exact-normalized-name-in-linked-work","subjectId":"104047"},{"characterId":"138371","match":"exact-normalized-name-in-linked-work","subjectId":"210774"}],"egsCharacterIds":["25695"],"vndbCharacterId":"c149831"},"originalCharacterName":"ヴィガ＝キャステイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シャミーの幼馴染み。"},{"spoiler":false,"text":"世襲の家職を継ぐのを嫌い、夢である戦士となるべくレジャ島を離れ、各地で武者修行に励んできた。"},{"spoiler":false,"text":"恵まれた体格と天性の運動神経の良さで戦士としての才能を開花させ、テラ大陸でも活躍したらしい。"},{"spoiler":false,"text":"お調子者で綺麗な女性に弱い。"},{"spoiler":false,"text":"ちなみに魔法はじぇんじぇん使えない。"},{"spoiler":false,"text":"かなりHもお盛んとのうわさである。"}],"source":"egs","sourceCharacterId":"25695","sourceWorkId":"7396","spoiler":false},{"segments":[{"spoiler":false,"text":"元気かつスケベ。"},{"spoiler":false,"text":"お調子者で、普段は何も考えていないが、"},{"spoiler":false,"text":"キメる所はキチッとキメる。"},{"spoiler":false,"text":"シャミーの幼馴染み。"}],"source":"bangumi","sourceCharacterId":"138371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f9f8565834a51ebb1fd360ce107a7d8eeca25ce3625ae20ae3a80c38a3c7507.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e426917c513a2d0399c82fc0898dab039f162c835760613b61b9d56518f386a.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c172894","characterName":"シリア＝リスニィ","sourceIds":{"bangumi":[{"characterId":"138372","match":"exact-normalized-name-in-linked-work","subjectId":"104047"},{"characterId":"138372","match":"exact-normalized-name-in-linked-work","subjectId":"210774"}],"egsCharacterIds":["25696"],"vndbCharacterId":"c172894"},"originalCharacterName":"シリア＝リスニィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シャミーの姉で、レジャ島の戦士。"},{"spoiler":false,"text":"温厚で包容力のある性格、グラマラスなボディ、剣術や魔法の才能など、「あたしに無いものをみんな持っているの」とシャミーが言うほどの女性。"},{"spoiler":false,"text":"両親を亡くしてからはシャミーの母親代わりであったらしい。"}],"source":"egs","sourceCharacterId":"25696","sourceWorkId":"7396","spoiler":false},{"segments":[{"