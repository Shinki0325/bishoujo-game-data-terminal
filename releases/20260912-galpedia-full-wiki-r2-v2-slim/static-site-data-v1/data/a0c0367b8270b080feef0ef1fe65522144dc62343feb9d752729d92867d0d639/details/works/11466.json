sed on Wikipedia"}],"source":"vndb","sourceCharacterId":"c8584"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/842a32f968cdb2f8e1f50dbb86a4889637184d75b82c18c73de2f2ee47456aa8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad1f2fbf1d38102044d44c8f5c9d1555ff3291554c054f0817a78b286d1d8337.webp","width":185,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12480","source":"vndb"}]},{"characterId":"char_vndb_c8585","characterName":"桜井 紗希","sourceIds":{"vndbCharacterId":"c8585"},"originalCharacterName":"桜井 紗希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"520"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"source-only","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"source-only","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only member of the handicrafts club that is a junior. She rivals Hikari in clumsiness. She is a troublemaker like Harumi, although she doesn't have any bad intent. She is always cheerful and smiling. She is from a fatherless family so to help with finances she has a part-time job. She respects Hajime because he can easily make crafts."},{"spoiler":false,"text":"Based on Wikipedia"}],"source