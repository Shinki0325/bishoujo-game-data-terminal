oleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:24189","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c8581","characterName":"吾妻 はじめ","sourceIds":{"vndbCharacterId":"c8581"},"originalCharacterName":"吾妻 はじめ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"704"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year student. The only male member of the handicrafts club. He is slightly influenced by his father that loves handicrafts, but he himself has it as a hobby. He is certainly a pro at crafts and can easily make anything. His personality can't be described as serious, he is irresponsible and easily elated by praise. But unexpectedly, he is likely to take action for a member's sake in an emergency. He was diagnosed with an incurable disease and was given half a year to live, but he decided \"I want to have a smile to the last minute\" and didn't tell the handicraft club members. His parents run a handicrafts cafe called Mana."},{"spoiler":false,"text":"Based on Wikipedia"}],"source":"vndb","sourceCharacterId":"c8581"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/281aa6f86a29ca67c183971b6a4091ba73a1cb83df73717504e6e458d2c692b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c03d3092b9af01b572ed701742530fc68dcbbdf53c0bed36a6f6807e009596f5.webp","width":185,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皇 帝","creatorId":"vndb:s55","so