alEntityId":"vndb:s3225","name":"波野夏花(夏花)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:184993","source":"vndb"},{"creditedName":"鳥島 烏","creatorId":"vndb:s36268","sourcePersonId":"vndb:s36268","canonicalEntityId":"vndb:s36268","name":"鳥島烏","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:184994","source":"vndb"},{"creditedName":"らてあと","creatorId":"vndb:s37756","sourcePersonId":"vndb:s37756","canonicalEntityId":"vndb:s37756","name":"らてあと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:184995","source":"vndb"},{"creditedName":"しゆき","creatorId":"vndb:s45596","sourcePersonId":"vndb:s45596","canonicalEntityId":"vndb:s45596","name":"しゆき","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:184996","source":"vndb"},{"creditedName":"高淤龍","creatorId":"vndb:s46711","sourcePersonId":"vndb:s46711","canonicalEntityId":"vndb:s46711","name":"高淤龍","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:184997","source":"vndb"}]},"cast":[{"characterId":"char_c108878","characterName":"山科 一華","sourceIds":{"bangumi":[{"characterId":"111095","match":"exact-normalized-name-in-linked-work","subjectId":"381773"}],"egsCharacterIds":["24127"],"vndbCharacterId":"c108878"},"originalCharacterName":"山科 一華","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Right... I'm gonna be the top maiden at this school. And I'm not letting anyone beat me to it!\""},{"spoiler":false,"text":"Likes: Kabuki"},{"spoiler":false,"text":"Talents: Sewing, martial arts, pretty much anything"},{"spoiler":false,"text":"Dislikes: The latest fashion trends (or rather, doesn't understand or care to understand them)"},{"spoiler":false,"text":"Favourite role: Omitsu in \"Nozuki-Mura\""},{"spoiler":false,"text":"A kabuki actor from a young age, striving to be the most beautiful onnagata of them all. In other words, a guy."},{"spoiler":false,"text":"After suffering a broken nose on stage during a performance, he decided to transfer to an all-girls school in order to improve himself. Born and raised in a strict kabuki family, he has willingly lived his life as a woman; as a result, he is not very conscious of his own male-ness."},{"spoiler":false,"text":"He's a bad liar, but a good smooth-talker, and will use whatever methods he can to get what he wants. But he's happy to cloak this behaviour of his in a gentle, yamato nadeshiko-like facade."}],"source":"vndb","sourceCharacterId":"c108878"},{"segments":[{"spoiler":false,"text":"若くして活躍する歌舞伎俳優。女形として誰よりも美しくなるのが目標。つまり男。舞台の上で鼻っ柱をへし折られ、自分を磨き直すべく女学校に編入する。"},{"spoiler":false,"text":"厳格な歌舞伎の家に生まれ育ち、日常生活でも自ら望んで女らしく過ごしてきた。そのせいで、男である自覚がイマイチ薄い。"},{"spoiler":false,"text":"嘘は苦手だが詭弁は得意。目的のためなら手段はあんまり選ばない。そんな図太さを大和撫子然とした振る舞いで包み隠し、今日も前向きにがんばっている。"}],"source":"egs","sourceCharacterId":"24127","sourceWorkId":"32725","spoiler":false},{"segments":[{"spoiler":false,"text":"若くして活躍する歌舞伎俳優。"},{"spoiler":false,"text":"女形として誰よりも美しくなるのが目標。"},{"spoiler":false,"text":"つまり男。"},{"spoiler":false,"text":"舞台の上で鼻っ柱をへし折られ、"},{"spoiler":false,"text":"自分を磨き直すべく女学校に編入する。"},{"spoiler":false,"text":"厳格な歌舞伎の家に生まれ育ち、"},{"spoiler":false,"text":"日常生活でも自ら望んで女らしく過ごしてきた。"},{"spoiler":false,"text":"そのせいで、男である自覚がイマイチ薄い。"},{"spoiler":false,"text":"嘘は苦手だが詭弁は得意。"},{"spoiler":false,"text":"目的のためなら手段はあんまり選ばない。"},{"spoiler":false,"text":"そんな図太さを大和撫子然とした振る舞いで包み隠し、"},{"spoiler":false,"text":"今日も前向きにがんばっている。"}],"source":"bangumi","sourceCharacterId":"111095"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c108878","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"24127","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"24127","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"111095","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae4ccecda6e5073429d250a108d3a5643aa5c979eeae7ac5c82598b9c1db4134.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28ac637682b66026d6e55d6e7dcbcebf5d7a5fc6223b8d4286740e16a0643d1c.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:381773:111095:15995:1","source":"bangumi"}]},{"characterId":"char_c108879","characterName":"クリス","sourceIds":{"bangumi":[{"characterId":"111096","match":"exact-normalized-name-in-linked-work","subjectId":"381773"}],"egsCharacterIds":["24128"],"vndbCharacterId":"c108879"},"originalCharacterName":"クリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I am not small! I-I've got more on my chest than you do!\""},{"spoiler":false,"text":"Likes: Milk"},{"spoiler":false,"text":"Talents: Speed reading, fencing"},{"spoiler":false,"text":"Dislikes: Handling chopsticks, relying on others, men"},{"spoiler":false,"text":"Favourite stories: Anything with immature heroines"},{"spoiler":false,"text":"British foreign exchange student. Nicknamed \"Chris\" for short. A high-born young lady, she is the biggest obstacle and greatest rival to Rin in the fight for the title of \"Nadeshiko no Kimi\", the highest position in the school."},{"spoiler":false,"text":"She looks delicate, but always carries a dignified air, and is thus extremely popular among the more West-obsessed female students."},{"spoiler":false,"text":"She is stubborn, a bad loser, but always a fair player. While her will is strong, she takes good care of others and is kind to everyone aside from Rin. She doesn't handle men very well, and her mind goes blank whenever she meets one."}],"source":"vndb","sourceCharacterId":"c108879"},{"segments":[{"spoiler":false,"text":"英国からの留学生。愛称クリス。歴史ある名門貴族の家に生まれたお嬢様。"},{"spoiler":false,"text":"女学校の頂点である『撫子の君』の座を巡り、凜にとっての最大の壁にして、良き好敵手となる。"},{"spoiler":false,"text":"可憐な見た目に反して、常に威風堂々とした姿を見せる。そのため、西洋に憧れる女学生たちに抜群の人気を誇る。"},{"spoiler":false,"text":"意地っ張りで負けず嫌い。いつでも正々堂々が信条。男勝りだが面倒見も良く、凜以外にはとても優しい。"},{"spoiler":false,"text":"男性が苦手。相対すると頭が真っ白になってしまう。"}],"source":"egs","sourceCharacterId":"24128","sourceWorkId":"32725","spoiler":false},{"segments":[{"spoiler":false,"text":"英国からの留学生。愛称クリス。"},{"spoiler":false,"text":"歴史ある名門貴族の家に生まれたお嬢様。"},{"spoiler":false,"text":"女学校の頂点である『撫子の君』の座を巡り、"},{"spoiler":false,"text":"凜にとっての最大の壁にして、良き好敵手となる。"},{"spoiler":false,"text":"可憐な見た目に反して、常に威風堂々とした姿を見せる。"},{"spoiler":false,"text":"そのため、西洋に憧れる女学生たちに抜群の人気を誇る。"},{"spoiler":false,"text":"意地っ張りで負けず嫌い。"},{"spoiler":false,"text":"いつでも正々堂々が信条。"},{"spoiler":false,"text":"男勝りだが面倒見も良く、凜以外にはとても優しい。"},{"spoiler":false,"text":"男性が苦手。"},{"spoiler":false,"text":"相対すると頭が真っ白になってしまう。"}],"source":"bangumi","sourceCharacterId":"111096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef87dc106caf2f84e9e44c830e78d7c49f88b348aca4d8061297fd88f14c0f17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f27ade670d919c7f54608e8613219bcb3a7e95b5ca3fdde2368a9e5ea9dca830.webp","width":137,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:381773:111096:4727:1","source":"bangumi"}]},{"characterId":"char_c108880","characterName":"メリッサ・レオーニ","sourceIds":{"bangumi":[{"characterId":"111097","match":"exact-normalized-name-in-linked-work","subjectId":"381773"}],"egsCharacterIds":["24129"],"vndbCharacterId":"c108880"},"originalCharacterName":"メリッサ・レオーニ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Personally, I'd prefer what you'd call a 'naked relationship.' What do you say?\""},{"spoiler":false,"text":"Likes: Being free, natto, any and all liquor, girls"},{"spoiler":false,"text":"Talent: Good with words & with her hands"},{"spoiler":false,"text":"Dislikes: Being held back, being bored"},{"spoiler":false,"text":"Favorite type of girl: Hard to get"},{"spoiler":false,"text":"Italian foreign exchange student, and Chris's best friend. She is the daughter of a lower-class nobleman, and thus her behaviour is not especially \"ladylike.\""},{"spoiler":false,"text":"Although she looks mature and beautiful on the outside, she is actually quite lazy and opulent, marching to her own drummer. She is always in search of things that interest her, strongly disliking both being bored and being held back."},{"spoiler":false,"text":"In addition, she likes cute girls (in a sexual manner as well). She has taken a great interest in new transfer student Rin, and goes out of her way to try to get involved with him (again, sexually)."}],"source":"vndb","sourceCharacterId":"c108880"},{"segments":[{"spoiler":false,"text":"伊国からの留学生。クリスの親友。一応は下級貴族の娘だが、お嬢様らしさがまるでない。"},{"spoiler":false,"text":"見た目だけなら大人びた美女なのに、中身はぐうたらで好き放題する放蕩者。"},{"spoiler":false,"text":"退屈と束縛を嫌い、自由を愛してやまない。いつも面白いことを探してふらふらしている。"},{"spoiler":false,"text":"可愛い女の子が大好き。性的にも好き。編入してきた凜に「面白そう」だと興味を持ち、ことある毎に（性的にも）絡んでくる危険人物。"}],"source":"egs","sourceCharacterId":"24129","sourceWorkId":"32725","spoiler":false},{"segments":[{"spoiler":false,"text":"伊国からの留学生。クリスの親友。"},{"spoiler":false,"text":"一応は下級貴族の娘だが、お嬢様らしさがまるでない。"},{"spoiler":false,"text":"見た目だけなら大人びた美女なのに、中身はぐうたらで好き放題する放蕩者。"},{"spoiler":false,"text":"退屈と束縛を嫌い、自由を愛してやまない。"},{"spoiler":false,"text":"いつも面白いことを探してふらふらしている。"},{"spoiler":false,"text":"可愛い女の子が大好き。性的にも好き。"},{"spoiler":false,"text":"編入してきた凜に「面白そう」だと興味を持ち、"},{"spoiler":false,"text":"ことある毎に（性的にも）絡んでくる危険人物。"}],"source":"bangumi","sourceCharacterId":"111097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2883c0c946237b72989ad59de245302156cd93cbba80286b024e8cfc93c2aaf9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e358812adcbe04d7edd7915c0c06d8a4ce16dd11fac86aaddbad3978a86b4662.webp","width":108,"height":256,"source":"static-detail"},"actors":[{"creditedName":"生天目仁美","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:381773:111097:4394:1","source":"bangumi"}]},{"characterId":"char_c108881","characterName":"衝羽根 しのぶ","sourceIds":{"bangumi":[{"characterId":"111098","match":"exact-normalized-name-in-linked-work","subjectId":"381773"}],"egsCharacterIds":["24130"],"vndbCharacterId":"c108881"},"originalCharacterName":"衝羽根 しのぶ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Y-You mustn't ask such things! Goodness, Rin-chan, you're a pervert.\""},{"spoiler":false,"text":"Likes: Theatre-going, her little brothers"},{"spoiler":false,"text":"Talents: Doing any kind of housework quickly, lulling others to sleep"},{"spoiler":false,"text":"Dislikes: Saying selfish things"},{"spoiler":false,"text":"Favorite times of year: April with its breezes, May with its sunlight filtering through the trees"},{"spoiler":false,"text":"A gentle and kind-hearted classmate. The daughter of a Kobe trader, she is a \"high-collar\" girl with a very open-minded sensibility. Her mere touch can soothe anyone, though she also has a bit of a childish side."},{"spoiler":false,"text":"She will look after Rin to the best of her ability, sheepishly admitting that he reminds her of her little brothers."},{"spoiler":false,"text":"She is kind to Japanese and foreign students alike, and always manages to keep a middle ground between Rin and Chris, who tend to clash with each other."}],"source":"vndb","sourceCharacterId":"c108881"},{"segments":[{"spoiler":false,"text":"穏やかで心優しい同級生。神戸の貿易商の家に生まれ育ったご令嬢で、とても開明的な感性を持つ『ハイカラさん』。"},{"spoiler":false,"text":"触れる者みな癒やされるというほどに癒やし系。"},{"spoiler":false,"text":"少しぽやっとしており、意外と子供っぽいところもある。"},{"spoiler":false,"text":"「なぜか弟たちを思い出すから」という冷や汗ものの理由で、何かと凜の世話を焼いてくれる。"},{"spoiler":false,"text":"日本人にも留学生にも分け隔てなく優しく、衝突しがちな凜とクリスを常に中庸の姿勢で執りなす。"}],"source":"egs","sourceCharacterId":"24130","sourceWorkId":"32725","spoiler":false},{"segments":[{"spoiler":false,"text":"穏やかで心優しい同級生。"},{"spoiler":false,"text":"神戸の貿易商の家に生まれ育ったご令嬢で、"},{"spoiler":false,"text":"とても開明的な感性を持つ『ハイカラさん』。"},{"spoiler":false,"text":"触れる者みな癒やされるというほどに癒やし系。"},{"spoiler":false,"text":"少しぽやっとしており、意外と子供っぽいところもある。"},{"spoiler":false,"text":"「なぜか弟たちを思い出すから」という冷や汗ものの理由で、"},{"spoiler":false,"text":"何かと凜の世話を焼いてくれる。"},{"spoiler":false,"text":"日本人にも留学生にも分け隔てなく優しく、"},{"spoiler":false,"text":"衝突しがちな凜とクリスを常に中庸の姿勢で執りなす。"}],"source":"bangumi","sourceCharacterId":"111098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c83fb421150042e09630d2a35ff0c1c66397b320197328e1bd4772dc554d12de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b68292a3c5d9eac9e21b8dee8de7d6a80b03fc8e9352fb66bc0fec82485bde45.webp","width":109,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:381773:111098:20696:1","source":"bangumi"}]},{"characterId":"char_c108882","characterName":"楪 小春","sourceIds":{"bangumi":[{"characterId":"111099","match":"exact-normalized-name-in-linked-work","subjectId":"381773"}],"egsCharacterIds":["24131"],"vndbCharacterId":"c108882"},"originalCharacterName":"楪 小春","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I-I-If you keep petting me, I'll explode...!\""},{"spoiler":false,"text":"Likes: Shoujo mags, Onee-sama"},{"spoiler":false,"text":"Talent: One-shot speed drinking"},{"spoiler":false,"text":"Dislikes: Being the center of attention"},{"spoiler":false,"text":"Favourite reading material: Shoujo novels, \"letters to the editor\" columns"},{"spoiler":false,"text":"A sheltered classmate and the only child of an old prestigious family. However, she's always kept to herself in the corner. She loves reading shoujo magazines, and has longed for many years for someone to call her \"Onee-sama.\" She feels that meeting Rin was a fateful encounter for her. Despite being in the same grade, she becomes smitten with him and calls him \"Onee-sama.\""},{"spoiler":false,"text":"She has a timid personailty which fits her fragile appearance, and is always shy when meeting people. But she is happy to have met her destined \"Onee-sama.\""}],"source":"vndb","sourceCharacterId":"c108882"},{"segments":[{"spoiler":false,"text":"箱入り娘な同級生。格式高い旧家の一人娘。なのに、いつも隅っこで小さくなっている。"},{"spoiler":false,"text":"少女雑誌が大好きで、憧れの『お姉さま』との出会いを長年ずっと夢見てきた。"},{"spoiler":false,"text":"凜との出会いに運命的なものを感じ、同学年ながら『お姉さま』と呼び慕うようになる。"},{"spoiler":false,"text":"儚げな容姿に違わない気弱な性格で、人見知り。でも今は、お姉さまと出会えて幸せいっぱい。"}],"source":"egs","sourceCharacterId":"24131","sourceWorkId":"32725","spoiler":false},{"segments":[{"spoiler":false,"text":"箱入り娘な同級生。格式高い旧家の一人娘。"},{"spoiler":false,"text":"なのに、いつも隅っこで小さくなっている。"},{"spoiler":false,"text":"少女雑誌が大好きで、憧れの『お姉さま』との出会いを長年ずっと夢見てきた。"},{"spoiler":false,"text":"凜との出会いに運命的なものを感じ、"},{"spoiler":false,"text":"同学年ながら『お姉さま』と呼び慕うようになる。"},{"spoiler":false,"text":"儚げな容姿に違わない気弱な性格で、人見知り。"},{"spoiler":false,"text":"でも今は、お姉さまと出会えて幸せいっぱい。"}],"source":"bangumi","sourceCharacterId":"111099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a281b40686e98c2ef1348b4fb7fc3b9515183b043d52d9d1a753c04b14d3924.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d7e3a50e11d7ecd75b4850d415752feab3d99868c6474431f53d3076747e395.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:381773:111099:13372:1","source":"bangumi"}]},{"characterId":"char_vndb_c109790","characterName":"ブリジット・ルメール","sourceIds":{"vndbCharacterId":"c109790"},"originalCharacterName":"ブリジット・ルメール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/500876523cd161062530762b15149d6db30d9