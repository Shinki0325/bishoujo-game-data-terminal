no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a member of the branch family, who arrives to protect the Keigen Shishin-ryu style successor as a companion. She is very loyal to her future husband, the protagonist and always tries to be by his side."},{"spoiler":false,"text":"She was raised for the sake of the main family, and was taught that \"winning is natural, success is natural\" and her strength is the result of accumulated effort. She has the tendency to abandon everything except the main family and the protagonist."},{"spoiler":false,"text":"She does not involve herself with others unless it is a necessity, and is strict with herself and ruthless with others. She doesn't see this as a problem, since the protagonist is all she needs in her life."}],"source":"vndb","sourceCharacterId":"c17951"},{"segments":[{"spoiler":false,"text":"分家の定めとして本家の慧眼司心流を守るため、その後継者である主人公の伴侶となるべくやって来る。"},{"spoiler":false,"text":"許婚である主人公に忠義を尽くし、常に傍に居ようとする。"},{"spoiler":false,"text":"“御家” のために育てられ、「勝って当たり前、出来て当たり前」 の教育を受けてきており、その強さは積み重ねた努力の結果である。"},{"spoiler":false,"text":"“御家” と “主人公” 以外のことを捨てているフシがあり、必要以上に人と関わろうとせず、自分に厳しく他人に冷酷。"},{"spoiler":false,"text":"が、彼女には主人公がいれば十分なので、問題視していない。"},{"spoiler":false,"text":"「私はあなただけの妻……例え通い妻の様に扱われたとしても私の心は揺るがない程度に純愛よ」"}],"source":"egs","sourceCharacterId":"4709","sourceWorkId":"19032","spoiler":false},{"segments":[{"spoiler":false,"text":"スタイリッシュ爆乳"},{"spoiler":false,"text":"分家の定めとして本家の慧眼司心流を守るため、その後継者である主人公の伴侶となるべくやって来る。"},{"spoiler":false,"text":"許婚である主人公に忠義を尽くし、常に傍に居ようとする。"},{"spoiler":false,"text":"“御家” のために育てられ、「勝って当たり前、出来て当たり前」 の教育を受けてきており、その強さは積み重ねた努力の結果である。"},{"spoiler":false,"text":"“御家” と “主人公” 以外のことを捨てているフシがあり、必要以上に人と関わろうとせず、自分に厳しく他人に冷酷。"},{"spoiler":false,"text":"が、彼女には主人公がいれば十分なので、問題視していない。"},{"spoiler":false,"text":"「私はあなただけの妻……例え通い妻の様に扱われたとしても私の心は揺るがない程度に純愛よ」"}],"source":"bangumi","sourceCharacterId":"42698"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"4709","sourceWorkId":"19032","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"i","valueContext":null,"source":"egs","sourceCharacterId":"4709","sourceWorkId":"19032","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"4709","sourceWorkId":"19032","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"4709","sourceWorkId":"19032","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"4709","sourceWorkId":"19032","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9db281213d398188865c166049472b108bcb0d0f5d79d465047a3396730f7ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88c5847b525d4c33ed8728d9606c5e2f104a3e832f233e56646b462f6ea954d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79498:42698:5741:1","source":"bangumi"}]},{"characterId":"char_c17952","characterName":"くらりん","sourceIds":{"bangumi":[{"characterId":"42700","match":"exact-normalized-name-in-linked-work","subjectId":"79498"}],"egsCharacterIds":["4710"],"vndbCharacterId":"c17952"},"originalCharacterName":"くらりん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"re