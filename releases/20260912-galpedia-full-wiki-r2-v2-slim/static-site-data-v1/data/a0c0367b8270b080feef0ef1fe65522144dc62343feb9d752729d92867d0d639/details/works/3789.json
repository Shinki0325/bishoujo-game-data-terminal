,"match":"exact-normalized-name-in-linked-work","subjectId":"80947"}],"egsCharacterIds":["1859"],"vndbCharacterId":"c3654"},"originalCharacterName":"広田 寛","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A large, middle-aged man, strong enough to defend against 5 Chinese as well as general handyman and a man of many talents. Lost sanity when his wife divorced him and his family disowned him due to debts. He proposes the \"family project\" and takes on the Father role."}],"source":"vndb","sourceCharacterId":"c3654"},{"segments":[{"spoiler":false,"text":"謎多きリストラ中年。"},{"spoiler":false,"text":"カラスと縄張り争いをしつつ路上生活をしていたところ、司が春花を助けているのを目撃し、「不公平だから、自分も助けてもらう権利がある」と強引に司の部屋に乗り込んでくる。"},{"spoiler":false,"text":"その後、行き場を失い高屋敷家に集まった面々に「家族計画」を提案する。"},{"spoiler":false,"text":"外見からは解りにくいが正気を失っている。"},{"spoiler":false,"text":"従軍経験があり、高屋敷家に乗り込んできた中国人マフィア5名を無力化させる程の実力者でもある。"},{"spoiler":false,"text":"父親役。"}],"source":"egs","sourceCharacterId":"1859","sourceWorkId":"19430","spoiler":false},{"segments":[{"spoiler":false,"text":"实力超群的企业战士。家族计划中的父亲。"},{"spoiler":false,"text":"相当古怪的人，用自己奇特的言行和荒诞的行动力把周遭人都卷进事件中。"},{"spoiler":false,"text":"司的天敌。“原企业战士”的头衔可不是随便说说的，不但精通各种战斗技巧，而且还身负各种五花八门的技能(比如一拳打烂了电线杆什么的……)。有着十分复杂的过去……？"}],"source":"bangumi","sourceCharacterId":"20737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caca139b89af134be2181c6f61d1fefa6e424aa098b36310ee59edb7cca331a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cdbf5de086e44aa31ed4a8c290c4d8f9847f0456be449e42869855751ea4429.webp","width":108,"height":256,"source":"static-detail"},"actors":[{"creditedName":"若本規夫","creatorId":"vndb:s8","sourcePersonId":"vndb:s8","canonicalEntityId":"vndb:s8","name":"若本 規夫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:101434:20737:3920:1","source":"bangumi"}]},{"characterId":"char_c7469","characterName":"劉 家輝","sourceIds":{"bangumi":[{"characterId":"20742","match":"exact-normalized-name-in-linked-work","subjectId":"4347"},{"characterId":"20742","match":"exact-normalized-name-in-linked-work","subjectId":"80947"}],"egsCharacterIds":["1860"],"vndbCharacterId":"c7469"},"originalCharacterName":"劉 家輝","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Assistant manager of the LongLong Chinese restaurant where Tsukasa is working. Bisexual and has a favor to Tsukasa."},{"spoiler":false,"text":"He is the one who convinces Tsukasa to help Chunhua."}],"source":"vndb","sourceCharacterId":"c7469"},{"segments":[{"spoiler":false,"text":"司のアルバイト先の中華料理店「龍龍（ろんろん）」の店長代理。"},{"spoiler":false,"text":"「龍龍」のグループ企業は歌舞伎町に多く存在し、日本在住の中国人たちの会合にも使われている。"},{"spoiler":false,"text":"謎多き、司の友人。"}],"source":"egs","sourceCharacterId":"1860","sourceWorkId":"19430","spoiler":false},{"segments":[{"spoiler":false,"text":"中华料理店『龙龙』的店长代理。实际上的经营者就是他，但是作为“代理”的话有很多事都会很方便。两性爱者，对主角有好感。"}],"source":"bangumi","sourceCharacterId":"20742"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cf5005b795ce5ccd24d17afe35bf1260af5493d6e37a552f49fdee0c69cc452.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74219e48ce780fa2c80a086d3073c8a58d1204f5aa2ddc1fa7adbb6880a5b3b7.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"子安武人","creatorId":"vndb:s10","sourcePersonId":"vndb:s10","canonicalEntityId":"vndb:s10","name":"子安 武人","roleCode":"voice-actor","roleLabel":"声优","i