{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"31522","model":{"presentationWorkId":"egs:31522","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_146466","characterName":"ヴァイナー・トゥーラ","sourceIds":{"bangumi":[{"characterId":"146466","match":"source-roster","subjectId":"347465"}]},"originalCharacterName":"ヴァイナー・トゥーラ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴァイナーはルジカが身を置くシシア一派の代表者です。"},{"spoiler":false,"text":"立場上、シナリオに深く関わることになり、"},{"spoiler":false,"text":"仲間として共に行動する場面もあるでしょう。"},{"spoiler":false,"text":"彼女はあらゆる面で秀でた人物です。"},{"spoiler":false,"text":"強く、賢く、それでいて気さくで人当たりがいいです。"},{"spoiler":false,"text":"時折間の抜けたことをする場面もありますが、"},{"spoiler":false,"text":"そういうところも彼女なりの考えがあるのでしょう。"},{"spoiler":false,"text":"彼女との交流は本編クリア後かつクリア後の彼女が関わるイベント達成後かつ"},{"spoiler":false,"text":"実装済みの彼女に関するシーンを全て閲覧すると解放されます。"},{"spoiler":false,"text":"いわゆる裏ボスを撃破する必要があるため条件としてはかなり厳しくなっていますが、"},{"spoiler":false,"text":"演出の都合上、仕方のないことなのでご了承ください。"},{"spoiler":false,"text":"交流の詳細は実際にプレイした時のお楽しみとします。"},{"spoiler":false,"text":"傾向としては実装済みのシーンの流れを引き継ぐような形で、"},{"spoiler":false,"text":"いたずら好きなえっちなお姉さんに翻弄されます。"}],"source":"bangumi","sourceCharacterId":"146466"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7a26c8f5bd058ca02e2a0b748f575b7383747812a4cc5052d0ddc831dde663f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6475c6b528b374a99db3620cfdaa21a7c8ecedb8f7a773016dbae324192e4648.webp","width":182,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156348","characterName":"ヴェルサ・アンシーン","sourceIds":{"bangumi":[{"characterId":"156348","match":"source-roster","subjectId":"312095"},{"characterId":"156348","match":"source-roster","subjectId":"347465"}]},"originalCharacterName":"ヴェルサ・アンシーン","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴェルサ・アンシーンは、遥か昔にマリスと同じようにアサイラムに迷い込んだ女性です。"},{"spoiler":false,"text":"彼女もまた故郷に帰ろうと様々な活動を続けてきたようですが、"},{"spoiler":false,"text":"結局、脱出することはできず今に至っています。"},{"spoiler":false,"text":"ヴェルサは今ではアサイラムの脱出を諦めてしまっており、"},{"spoiler":false,"text":"拠点である宵の聖域でまったり過ごしています。"},{"spoiler":false,"text":"新たにやってきたマリスに助言を与えはしますが、"},{"spoiler":false,"text":"彼女が本当にアサイラムから脱出できるとは思っていないようです。"},{"spoiler":false,"text":"立場"},{"spoiler":false,"text":"宵の聖域の最古参であるヴェルサは、同所の住人の保護者的存在と言えます。"},{"spoiler":false,"text":"見た目こそ幼い少女のようですが、内面はまるで母親のようで、皆に慕われています。"},{"spoiler":false,"text":"マリスもまたヴェルサには気を許します。"},{"spoiler":false,"text":"二人の絆は『アサイラム』のシナリオにおいて重要なものとなります。"},{"spoiler":false,"text":"性格"},{"spoiler":false,"text":"ヴェルサは一言では言い表しがたい性格をしています。"},{"spoiler":false,"text":"基本的には温厚でのんびりとしていますが、どことなくつかみどころがなく、"},{"spoiler":false,"text":"大人のようで子供のような、ある種の神秘性を持つ人物です。"},{"spoiler":false,"text":"ただ、いずれにせよ内面は成熟しており、性の経験も豊富なようです。"},{"spoiler":false,"text":"ヴェルサはシーンが存在するキャラクターですが、"},{"spoiler":false,"text":"その内容は相手を完全に手玉に取ったようなものとなっています。"},{"spoiler":false,"text":"女性上位であることは他と同じですが、苛烈に責めるというよりは、"},{"spoiler":false,"text":"言葉や仕草等で男性を翻弄するタイプです。"}],"source":"bangumi","sourceCharacterId":"156348"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db22d0ada6cd7b26d469c7d2bba14577dc7fc13276d2c631d9281ebd4abf1fb2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b026f2edab010ae785635f6bbd716f40255db926d50c66319c5d2fac5ad9a37.webp","width":256,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5393","sourceCompanyId":"egs:brand:5393","canonicalEntityId":"egs:brand:5393","name":"リーフジオメトリ","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:31522:5393","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
