{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22275","model":{"presentationWorkId":"vndb:v18048","staff":{"artwork":[{"creditedName":"あげきち","creatorId":"vndb:s2953","sourcePersonId":"egs:creator:17136","canonicalEntityId":"vndb:s2953","name":"あげきち","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:154888","source":"egs"}],"scenario":[{"creditedName":"assault(あさのじ)","creatorId":"vndb:s1510","sourcePersonId":"egs:creator:1929","canonicalEntityId":"vndb:s1510","name":"assault(あさのじ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:154889","source":"egs"},{"creditedName":"須々木鮎尾","creatorId":"vndb:s2319","sourcePersonId":"egs:creator:13991","canonicalEntityId":"vndb:s2319","name":"須々木鮎尾","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:154890","source":"egs"}],"music":[{"creditedName":"HIRO.K","creatorId":"vndb:s14053","sourcePersonId":"vndb:s14053","canonicalEntityId":"vndb:s14053","name":"HIRO.K","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:122836","source":"vndb"}],"other":[{"creditedName":"手塚りょうこ","creatorId":"vndb:s646","sourcePersonId":"egs:creator:13556","canonicalEntityId":"vndb:s646","name":"手塚りょうこ","detail":"OP曲「挑め！正義の使者！」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197770","source":"egs"},{"creditedName":"手塚 りょうこ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:122832","source":"vndb"},{"creditedName":"赤奥 刺","creatorId":"vndb:s14054","sourcePersonId":"vndb:s14054","canonicalEntityId":"vndb:s14054","name":"赤奥 刺","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:122837","source":"vndb"}]},"cast":[{"characterId":"char_c36317","characterName":"天野 朱音","sourceIds":{"bangumi":[{"characterId":"135418","match":"exact-normalized-name-in-linked-work","subjectId":"152915"}],"egsCharacterIds":["7270"],"vndbCharacterId":"c36317"},"originalCharacterName":"天野 朱音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"友人以上恋人未満といった微妙な関係(どちらかというと姉弟的な関係)の、主人公の幼馴染み。"},{"spoiler":false,"text":"両親が不在である天野家を切り盛りしたり、同じように両親が不在の主人公の世話を、マリーがやって来るまで、それとなく焼いていた為に、自然とそういった関係に落ち着きつつある。"}],"source":"egs","sourceCharacterId":"7270","sourceWorkId":"22275","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公とは幼なじみで、友人以上恋人未満といった微妙な関係。"},{"spoiler":false,"text":"両親不在な天野家の家事を一手に切り盛りしていて、似た境遇の主人公を気に掛けている。"},{"spoiler":false,"text":"スポーツ万能で、学園では新体操部に所属している。"},{"spoiler":false,"text":"ごく普通の常識人で、マッドサイエンティストである祖父の行動に頭を痛めつつ、周囲にはバレないように気を遣ってきた。"},{"spoiler":false,"text":"悪の組織 “ネオ・ファントム” の女幹部。"},{"spoiler":false,"text":"その正体は、ぎっくり腰に倒れた祖父に悪の女幹部を押し付けられた天野朱音。"},{"spoiler":false,"text":"由緒正しい過激なコスチュームに身を包み、剣・鞭になる武器で新体操の技を駆使して戦う。"},{"spoiler":false,"text":"主な活動は振り込め詐欺の退治や、違法駐輪を集めてクズ鉄として売り払ったりなど。"},{"spoiler":false,"text":"自業自得だが暴走したシルバー・ジャスティスに○○され、以降はその打倒に燃える。"}],"source":"bangumi","sourceCharacterId":"135418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e14cb9f1a6eca422bf687dfad67c19c4b920609d1acbd471927899de041c9118.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97af935300a7ce84b6946ae971892d43182b934ecaeafd8d3d247028ab07ef28.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152915:135418:5075:1","source":"bangumi"}]},{"characterId":"char_c36318","characterName":"天野 菫","sourceIds":{"bangumi":[{"characterId":"135419","match":"exact-normalized-name-in-linked-work","subjectId":"152915"}],"egsCharacterIds":["7271"],"vndbCharacterId":"c36318"},"originalCharacterName":"天野 菫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"朱音の妹で、主人公の幼馴染み。"},{"spoiler":false,"text":"主人公からも妹のように可愛がられているが、最近はそれがちょっと不満だったり。"},{"spoiler":false,"text":"姉に似ず運動神経は良くないが学業成績優秀であり、理科科目、特に工学科学に関しては学生のレベルを大きく上回っている。"}],"source":"egs","sourceCharacterId":"7271","sourceWorkId":"22275","spoiler":false},{"segments":[{"spoiler":false,"text":"朱音の妹で、主人公の幼なじみ。"},{"spoiler":false,"text":"主人公からは妹のように可愛がられているが、最近はそれがちょっと不満なお年頃。"},{"spoiler":false,"text":"姉と違い運動神経は良くないが、学業優秀でマッドサイエンティストの気あり。"},{"spoiler":false,"text":"天野家の収入の大半は、彼女の発明品のアイデア料で賄われている。"},{"spoiler":false,"text":"以前から祖父に頼まれ、悪の組織の戦闘員アンドロイドを開発していた。"},{"spoiler":false,"text":"悪の組織 “ネオ・ファントム” の女幹部。"},{"spoiler":false,"text":"その正体は、祖父の誘いをノリノリで引き受けた天野菫。"},{"spoiler":false,"text":"コスチュームはスカーレットと大差ないが、マントの代わりに白衣を羽織っている。"},{"spoiler":false,"text":"荒事は戦闘員に任せているが、時折 怪しげな発明品でシルバー・ジャスティスを苦しめる。"}],"source":"bangumi","sourceCharacterId":"135419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5d22db100f95111a4693ec0d55bb18cd7eb658aa52a8c4eac16ef78c3c676e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c3cc7da668b02f12fa72333fa8b5944c4e343a6946de35c20e4f86751874e9d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152915:135419:15684:1","source":"bangumi"}]},{"characterId":"char_c36319","characterName":"マリー","sourceIds":{"bangumi":[{"characterId":"135420","match":"exact-normalized-name-in-linked-work","subjectId":"152915"}],"egsCharacterIds":["7272"],"vndbCharacterId":"c36319"},"originalCharacterName":"マリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の父、白銀博士によって作られた、シルバー・ジャスティスのサポートガイノイド。"},{"spoiler":false,"text":"戦闘時の情報分析や、装甲強化服のメンテナンス等、シルバー・ジャスティスの行動を影からサポートしている。"}],"source":"egs","sourceCharacterId":"7272","sourceWorkId":"22275","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の父 白銀秩 によって作られた、シルバー・ジャスティスのサポートアンドロイド。"},{"spoiler":false,"text":"戦闘時の情報分析や、装甲強化服のメンテナンスなどを行ってくれる。"},{"spoiler":false,"text":"しかし制作者の性格を反映してか、目的のためには手段を選ばないところがある。"},{"spoiler":false,"text":"そのため行き過ぎた行動を、主人公が必死になって止めることもしばしば。"},{"spoiler":false,"text":"私生活では家政婦を装っているものの、メイド服なので色々とあらぬ噂を立てられてしまう。"},{"spoiler":false,"text":"が、それらをすべて主人公のせいにして誤魔化してしまう腹黒さがあり、主人公の頭痛のタネとなっている。"}],"source":"bangumi","sourceCharacterId":"135420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2583aa7736184b89b91d0bc1a3acc51f6069199444f34694192ba28c1a03cf6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d248dbd2daa811348a6f7b4c2f0e51ee94fc6cd98f3d676931848a6f3c00782a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","