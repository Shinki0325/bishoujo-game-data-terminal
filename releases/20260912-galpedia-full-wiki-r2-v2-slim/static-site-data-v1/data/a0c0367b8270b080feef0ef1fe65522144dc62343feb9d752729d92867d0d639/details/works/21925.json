ケジュール。"},{"spoiler":false,"text":"遊ぶ内容はその日によって違い、動物と戯れたり、川で遊んだり、冒険に出掛けたり、時にはまったりと昼寝をしていることも。"}],"source":"bangumi","sourceCharacterId":"35039"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"35039","value":"あつあげ"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/005798d30427fc3320521f5dbde860c73f9f518ad726d49cf9c40d76f6cf2a3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff3a0068cdaaf0008eeed35abb8f99fa787777a35cb5f3b925f5227fe8544020.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131325:35039:15995:1","source":"bangumi"}]},{"characterId":"char_c32036","characterName":"みけ","sourceIds":{"bangumi":[{"characterId":"35040","match":"exact-normalized-name-in-linked-work","subjectId":"131325"}],"egsCharacterIds":["6731"],"vndbCharacterId":"c32036"},"originalCharacterName":"みけ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"白の姉であり実家に住むもう一人の狐娘。"},{"spoiler":false,"text":"白同様、正式な名前がなく、不便だと思った主人公に狐（こん）と命名される。"},{"spoiler":false,"text":"少し主人公に対していらずら癖と茶目っ気がある。"},{"spoiler":false,"text":"遊びに行くことも少なく、散歩をするか、家事をするか、涼むかというのが日課。"},{"spoiler":false,"text":"腰の悪い祖父母に変わり、よく家事の手伝いをしているしっかりもの。"},{"spoiler":false,"text":"祖父母との暮らしは長いが、野生での暮らしも長かったために時々野生のときの癖がでる。"},{"spoiler":false,"text":"そのためか、今だに朝は苦手。"}],"source":"egs","sourceCharacterId":"6731","sourceWorkId":"21925","spoiler":false},{"segments":[{"spoiler":false,"text":"ちょっといたずら好きで、優しくてお世話が大好きな狐娘のお姉さん"},{"spoiler":false,"text":"白の姉であり、実家に住むもう一人の狐娘。"},{"spoiler":false,"text":"白同様 正式な名前がなく、不便だからと主人公に 狐（こん） と命名される。"},{"spoiler":false,"text":"少し主人公に対していたずら癖と茶目っ気がある。"},{"spoiler":false,"text":"腰の悪い祖父母に代わり、よく家事の手伝いをしているしっかり者。"},{"spoiler":false,"text":"遊びに行くことは少なく、散歩をするか、家事をするか、涼むかというのが日課。"},{"spoiler":false,"text":"祖父母との暮らしは長いが野生での暮らしも長かったため、時々野生の時の癖が出る。 朝は苦手。"}],"source":"bangumi","sourceCharacterId":"35040"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"35040","value":"肉"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be59c14db749928dbcf7722f44ae66dba51efc33abd412bd7746ca818168d6a4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96d985c0cc7290bda7bccd8b041e97a754f0d4bc87d9ff0461393bcdae34196e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131325:35040:10026:1","source":"bangumi"}]},{"characterId":"char_vndb_c36174","characterName":"宮下 碧","sourceIds":{"vndbCharacterId":"c36174"},"originalCharacterName":"宮下 碧","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1089","sourceCompanyId":"egs:brand:2863","canonicalEntityId":"vndb:p1089","name":"ぐみそふと","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21925:2863","source":"egs"},{"companyId":"vndb:p1089","sourceCompanyId":"vndb:p1089","canonicalEntityId":"vndb:p1089","name":"ぐみそふと","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId"