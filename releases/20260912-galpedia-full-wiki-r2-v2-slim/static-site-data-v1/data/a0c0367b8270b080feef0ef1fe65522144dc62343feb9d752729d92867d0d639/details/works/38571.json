{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"38571","model":{"presentationWorkId":"vndb:v57458","staff":{"artwork":[{"creditedName":"山本和枝(やまもと☆かずえ)","creatorId":"vndb:s2266","sourcePersonId":"egs:creator:168","canonicalEntityId":"vndb:s2266","name":"山本和枝(やまもと☆かずえ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:292571","source":"egs"}],"scenario":[{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"egs:creator:2171","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:292572","source":"egs"}],"music":[{"creditedName":"Angel Note","creatorId":"vndb:s758","sourcePersonId":"egs:creator:2558","canonicalEntityId":"vndb:s758","name":"Angel Note","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:292573","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c81501","characterName":"鏑木 紫","sourceIds":{"bangumi":[{"characterId":"77007","match":"exact-normalized-name-in-linked-work","subjectId":"227400"},{"characterId":"77007","match":"exact-normalized-name-in-linked-work","subjectId":"279447"},{"characterId":"77007","match":"exact-normalized-name-in-linked-work","subjectId":"305833"},{"characterId":"77007","match":"exact-normalized-name-in-linked-work","subjectId":"554987"}],"egsCharacterIds":["17666"],"vndbCharacterId":"c81501"},"originalCharacterName":"鏑木 紫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元々退魔とは無縁だった稲黍神社の一人娘。"},{"spoiler":false,"text":"背が小さく幼い雰囲気。喋り方やしぐさも子供っぽいので、脳天気に見えるが芯は強い。"},{"spoiler":false,"text":"幼少時はお姉さんぶっていたのだが、成長が止まって、小柄でかわいらしい見た目になったのがコンプレックス。"}],"source":"egs","sourceCharacterId":"17666","sourceWorkId":"25976","spoiler":false},{"segments":[{"spoiler":false,"text":"小柄で可愛いフリーランスの退魔巫女。"},{"spoiler":false,"text":"元々退魔とは無縁だった稲黍神社（いなきびじんじゃ）の一人娘。"},{"spoiler":false,"text":"喋り方やしぐさも子供っぽいので脳天気に見えるが芯は強い。"},{"spoiler":false,"text":"現在は幼馴染の佑馬と一緒に退魔の仕事をしているが両親には内緒にしている。"},{"spoiler":false,"text":"みんなを守れる力があるのなら少しでも役に立てたいと思っているが、それ故に少々危なっかしい所も。"},{"spoiler":false,"text":"小柄で幼い見た目なのがコンプレックス。"}],"source":"egs","sourceCharacterId":"17666","sourceWorkId":"29517","spoiler":false},{"segments":[{"spoiler":false,"text":"小柄で可愛いフリーランスの駆け出し退魔巫女。"},{"spoiler":false,"text":"元々退魔とは無縁だった稲黍いなきび神社の一人娘。"},{"spoiler":false,"text":"喋り方やしぐさも子供っぽいので能天気に見えるが芯は強い。"},{"spoiler":false,"text":"みんなを守れる力があるのなら少しでも役に立てたいと思っている。ただ、それ故に少々危なっかしい所も。"},{"spoiler":false,"text":"ちはやとは大親友でいろいろ教えあう仲。小柄で幼い見た目なのがコンプレックス。お菓子作りやお掃除グッズを集めるのが趣味。"}],"source":"egs","sourceCharacterId":"17666","sourceWorkId":"38571","spoiler":false},{"segments":[{"spoiler":false,"text":"小柄で可愛いフリーランスの退魔巫女。"},{"spoiler":false,"text":"元々退魔とは無縁だった稲黍(いなきび)神社の一人娘。喋り方やしぐさも子供っぽいので脳天気に見えるが芯は強い。"},{"spoiler":false,"text":"現在は幼馴染の佑馬と一緒に退魔の仕事をしているが両親には内緒にしている。みんなを守れる力があるのなら少しでも役に立てたいと思っているが、それ故に少々危なっかしい所も。"},{"spoiler":false,"text":"小柄で幼い見た目なのがコンプレックス。"}],"source":"bangumi","sourceCharacterId":"77007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/008e352ce141d1d6a11baddae6d99ec675afc2af786bfcad39ffcfa14db65586.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fcac2612713204afa058bd113c4990a93f679687c9f0cd5d07bc819680892b0.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:554987:77007:11646:1","source":"bangumi"}]},{"characterId":"char_c83977","characterName":"犬童 ちはや","sourceIds":{"bangumi":[{"characterId":"77010","match":"exact-normalized-name-in-linked-work","subjectId":"230234"},{"characterId":"77010","match":"exact-normalized-name-in-linked-work","subjectId":"274755"},{"characterId":"77010","match":"exact-normalized-name-in-linked-work","subjectId":"305833"},{"characterId":"77010","match":"exact-normalized-name-in-linked-work","subjectId":"554987"}],"egsCharacterIds":["17667"],"vndbCharacterId":"c83977"},"originalCharacterName":"犬童 ちはや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the Kizumori shrine's exorcist shrine maiden."},{"spoiler":false,"text":"She has a friendly and cheerful personality, but she also acts with firm conviction."},{"spoiler":false,"text":"She has been given several years of free time to gain experience outside, while also traveling in pursuit of a rival who left the shrine and became a free agent."},{"spoiler":false,"text":"This time, she will be exterminating monsters in a village she stopped at during her journey."},{"spoiler":false,"text":"Kagura Reimeiki ~Chihaya no Shou~ San Profile"},{"spoiler":false,"text":"A freelance exorcist shrine maiden who loves training."},{"spoiler":false,"text":"She has a friendly and cheerful personality, but acts with firm conviction. She"},{"spoiler":false,"text":"was a former exorcist shrine maiden affiliated with Kizumori Shrine, but due to various circumstances she became a freelancer."},{"spoiler":false,"text":"Her cooking skills used to make incredible objects, but thanks to the guidance of her best friend Murasaki, she has improved to the point where she can still eat them as long as she is careful. She"},{"spoiler":false,"text":"loves to exercise, so her large, voluptuous breasts are a source of concern. She"},{"spoiler":false,"text":"is said to be a descendant of one of the people who once sealed away the Great Tengu at Kizumori Shrine."}],"source":"vndb","sourceCharacterId":"c83977"},{"segments":[{"spoiler":false,"text":"莉音と同じく雉社神社退魔巫女として修行をしている女の子。"},{"spoiler":false,"text":"フレンドリーで明るい性格だが、しっかりとした信念をもって修行に臨んでいる。退魔巫女としての能力も高く、教官からの信頼も厚い。"},{"spoiler":false,"text":"今回、とある目的の為に特別な試験を受けるのだが……"}],"source":"egs","sourceCharacterId":"17667","sourceWorkId":"26116","spoiler":false},{"segments":[{"spoiler":false,"text":"雉社神社の退魔巫女。"},{"spoiler":false,"text":"フレンドリーで明るい性格だが、しっかりとした信念をもって行動する女の子。"},{"spoiler":false,"text":"現在は数年自由な時間をもらい外で経験を積みつつ、神社から抜けてフリーになってしまったライバルを追いかけ旅をしている。"},{"spoiler":false,"text":"今回はその旅路の途中に立ち寄った村の依頼を受けて妖怪退治を行うことになる。"}],"source":"egs","sourceCharacterId":"17667","sourceWorkId":"27652","spoiler":false},{"segments":[{"spoiler":false,"text":"修業が大好きな雉社神社（きじもりじんじゃ）の退魔巫女。"},{"spoiler":false,"text":"フレンドリーで明るい性格だが、しっかりとした信念をもって行動する女の子。"},{"spoiler":false,"text":"雉杜神社から数年自由な時間をもらい、とある目的で修行中の頃からのライバルだった祐馬を追いかけて稲黍村までやってきた。"},{"spoiler":false,"text":"その時に出会った紫とは大親友の間柄で自身の用事が終わると紫の家である稲黍神社に遊びにやってくる。"},{"spoiler":false,"text":"現在は自分自身の用事が無い時は修行の一環として、祐馬や紫の仕事の手伝いをしている。"}],"source":"egs","sourceCharacterId":"17667","sourceWorkId":"29517","spoiler":false},{"segments":[{"spoiler":false,"text":"修業が大好きな雉杜きじもり神社の退魔巫女。"},{"spoiler":false,"text":"フレンドリーで明るい性格だが、しっかりとした信念をもって行動する女の子。"},{"spoiler":false,"text":"紫とは大親友の間柄で自身の用事が終わると紫の家である稲黍神社にしょっちゅう遊びにやって来て自分自身の用事が無い時は修行の一環として祐馬や紫の仕事の手伝いをしている"},{"spoiler":false,"text":"身体を動かすことが好きなので豊満に育った大きな胸が悩みの種。"},{"spoiler":false,"text":"実は料理の腕は壊滅的でとんでもない物体を作成してしまう。"}],"source":"egs","sourceCharacterId":"17667","sourceWorkId":"38571","spoiler":false},{"segments":[{"spoiler":false,"text":"修業が大好きな雉社(きじもり)神社の退魔巫女。"},{"spoiler":false,"text":"フレンドリーで明るい性格だが、しっかりとした信念をもって行動する女の子。雉杜神社から数年自由な時間をもらい、とある目的で修行中の頃からのライバルだった祐馬を追いかけて稲黍村までやってきた。"},{"spoiler":false,"text":"その時に出会った紫とは大親友の間柄で自身の用事が終わると紫の家である稲黍神社に遊びにやってくる。"},{"spoiler":false,"text":"現在は自分自身の用事が無い時は修行の一環として、祐馬や紫の仕事の手伝いをしている。"}],"source":"bangumi","sourceCharacterId":"77010"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b438df4100544b647a00d47e7d4d72b95d9ad9566f390b0cdc27e7318bd1e918.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4362016ca47f8deee2717dd36a8c867afbd1b8cf88c059dde7307c613c892db3.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎未來","creatorId":"vndb:s986","sourcePersonId":"vndb:s986","canonicalEntityId":"vndb:s986","name":"尾崎 未來","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:554987:77010:13776:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2720","sourceCompanyId":"egs:brand:2720","canonicalEntityId":"egs:brand:2720","name":"でぼの巣製作所","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:38571:2720","source":"egs"},{"companyId":"vndb:p709","sourceCompanyId":"vndb:p709","canonicalEntityId":"vndb:p709","name":"でぼの巣製作所","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:149049:v57458","source":"vndb"},{"companyId":"vndb:p709","sourceCompanyId":"vndb:p709","canonicalEntityId":"vndb:p709","name":"でぼの巣製作所","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:149050:v57458","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
