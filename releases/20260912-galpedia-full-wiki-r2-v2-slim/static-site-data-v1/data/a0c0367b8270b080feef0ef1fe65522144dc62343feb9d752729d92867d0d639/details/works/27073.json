2","name":"WAMSOFT(合資会社ワムソフト)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:150134","source":"vndb"},{"creditedName":"モリタ コータ","creatorId":"vndb:s41405","sourcePersonId":"vndb:s41405","canonicalEntityId":"vndb:s41405","name":"モリタ コータ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:150139","source":"vndb"},{"creditedName":"moa","creatorId":"vndb:s43637","sourcePersonId":"vndb:s43637","canonicalEntityId":"vndb:s43637","name":"moa","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:150140","source":"vndb"}]},"cast":[{"characterId":"char_c74093","characterName":"神掛 由岐奈","sourceIds":{"bangumi":[{"characterId":"66903","match":"exact-normalized-name-in-linked-work","subjectId":"255032"}],"egsCharacterIds":["20674"],"vndbCharacterId":"c74093"},"originalCharacterName":"神掛 由岐奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"721"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman with long, black hair and a somewhat mysterious demeanor. Although confident and logical, some part of her still feels lonely. Her sole wish is to always be with her friend Makina. But will she find love one day?"},{"spoiler":false,"text":"Having magical powers that far exceed even our sorcerer protagonist, she is a \"spirit-seer\", someone who can see otherworldly beings. However, she has a hard time fitting in with normal society because of this ability. But after meeting our protagonist, she starts to become interested in magic."},{"spoiler":false,"text":"A former resident of Fukano, she has returned and is searching for something she lost named \"Otsuki\"."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c74093"},{"segments":[{"spoiler":false,"text":"純日本人的な長く黒い髪と、どこかミステリアスな雰囲気をまとう少女。"},{"spoiler":false,"text":"自信家でクールな思考の持ち主だが、実は寂しがり屋な一面も持つ。"},{"spoiler":false,"text":"唯一の友人である蒔奈とは、いつでも一緒にいたいと願っている。"},{"spoiler":false,"text":"魔法使いである主人公さえ上回る桁外れの霊力を持っており、異形の者の姿を見る“鬼見”の力まで持つ。"},{"spoiler":false,"text":"そのため、一般社会には馴染めずにいる。"},{"spoiler":false,"text":"しかし主人公と出会ったことで、魔法に興味を持つようになる。"},{"spoiler":false,"text":"また、オツキサマと呼ばれる、落とし物を探している。"}],"source":"egs","sourceCharacterId":"20674","sourceWorkId":"27073","spoiler":false},{"segments":[{"spoiler":false,"text":"純日本人的な長く黒い髪と、どこかミステリアスな雰囲気をまとう少女。"},{"spoiler":false,"text":"自信家でクールな思考の持ち主だが、実は寂しがり屋な一面も持つ。"},{"spoiler":false,"text":"唯一の友人である蒔奈とは、いつでも一緒にいたいと願っている。"},{"spoiler":false,"text":"魔法使いである主人公さえ上回る桁外れの霊力を持っており、"},{"spoiler":false,"text":"異形の者の姿を見る“鬼見”の力まで持つ。"},{"spoiler":false,"text":"そのため、一般社会には馴染めずにいる。"},{"spoiler":false,"text":"しかし主人公と出会ったことで、魔法に興味を持つようになる。"},{"spoiler":false,"text":"また、オツキサマと呼ばれる、落とし物を探している。"},{"spoiler":false,"text":"「いるのね……こんな田舎町にも、変態って」"}],"source":"bangumi","sourceCharacterId":"66903"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"66903","value":"料理、裁縫など、意外と家庭的"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a778016b73f085e790afa75f7de3ce2ff1ef5050a2569ce72b3a8c3ade4fe27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c02450f0deaf7c8cf03d2a1778bdfbda90a9de7ca24556643a99a0b02630cab6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ふじたまみ","creatorId":"vndb:s7951","sourcePersonId":"vndb:s7951","canonicalEntityId":"vndb:s7951","name":"ふじた まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:255032:66903:23302:1","source":"bangumi"},{"creditedName":"八ッ橋 しなもん","creatorId":"vndb:s11591","sourcePersonId":"vndb:s11591","canonicalEntityId":"vndb:s11591","name":"八ッ橋しなもん(朔白)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78359","source":"vndb"}]},{"characterId":"char_c74094","characterName":"水晶石 みだり","sourceIds":{"bangumi":[{"characterId":"66904","match":"exact-normalized-name-in-linked-work","subjectId":"255032"}],"egsCharacterIds":["20675"],"vndbCharacterId":"c74094"},"originalCharacterName":"水晶石 みだり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1111"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A picture-perfect, high-born woman from a good family. Kind and gentle, she supports our protagonist who has zero ability to take care of himself. Doing everything for him from cooking to cleaning, she is always there for him because she believes he is the best sorcerer around."},{"spoiler":false,"text":"One fateful day, she was saved by the protagonist and decided to support him as his secretary. And in doing so, she might have caught the disease most fatal to her: love."},{"spoiler":false,"text":"From Steam"},{"spoiler":true,"text":"Her real name is Miranda Lust (ミランダ・リュスト)"}],"source":"vndb","sourceCharacterId":"c74094"},{"segments":[{"spoiler":false,"text":"絵に描いたような深窓の令嬢であり、おしとやかなお嬢様。"},{"spoiler":false,"text":"サッキュバスなのにエッチなことが血が手で、少しでもそういう話になると周りから見てわかるほど真っ赤になって俯いてしまう。貞淑なサッキュバス。"},{"spoiler":false,"text":"もともと淫魔界では貴族の出身ながら、一族にとっては落ちこぼれ。"},{"spoiler":false,"text":"サッキュバスにとっては死に至る病\"恋\"に落ちている。"},{"spoiler":false,"text":"以前、とある事件に巻き込まれたとき、主人公に助けられたことがある。"},{"spoiler":false,"text":"それからというもの主人公を偉大な魔法使いと信じて疑わず、押しかけ秘書のようなことをしている。"}],"source":"egs","sourceCharacterId":"20675","sourceWorkId":"27073","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は絵に描いたような深窓の令嬢であり、おしとやかなお嬢様。"},{"spoiler":false,"text":"サキュバスなのにエッチなことが苦手で、"},{"spoiler":false,"text":"少しでもそういう話になると周りから見てもわかるほど真っ赤になって俯いてしまう。"},{"spoiler":false,"text":"貞淑なサキュバス。"},{"spoiler":false,"text":"もともと淫魔界では貴族出身ながら、一族にとっては落ちこぼれ。"},{"spoiler":false,"text":"サキュバスにとっては、死に至る病“恋”に落ちている。"},{"spoiler":false,"text":"以前、とある事件に巻き込まれたとき、主人公に助けられたことがある。"},{"spoiler":false,"text":"それからというもの主人公を偉大な魔法使いと信じて疑わず、"},{"spoiler":false,"text":"押しかけ秘書のようなことをしている。"},{"spoiler":false,"text":"「だって、せ、先生は私の恩人なんですから」"}],"source":"bangumi","sourceCharacterId":"66904"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"66904","value":"ピアノ、読書"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88f7dcec80e626f7fd10ea94823afc697878a36dd5b60943106dbb11c4db59c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7250ce0695b5cc20acdad67da62852ab1c74e87ff2a348cf0faccc90001275a2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:255032:66904:13372:1","source":"bangumi"}]},{"characterId":"char_c74095","characterName":"猫天宮 花子","sourceIds":{"bangumi":[{"characterId":"66905","match":"exact-normalized-name-in-linked-work","subjectId":"255032"}],"egsCharacterIds":["20676"],"vndbCharacterId":"c74095"},"originalCharacterName":"猫天宮 花子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"512"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Always wearing a maid outfit and cleaning restrooms has earned Hanako the moniker “Maid Hanako.” Her usual mode may be being inexpressive in both face and voice, but her actions are often wild and unpredictable."},{"spoiler":false,"text":"She’s actually a spirit called a \"shuihu\". As well as being a water god’s personal messenger, she is the master of the Nekogawa River, leader of a band of red kappa, and kind of a big deal. Thanks to all this, she’s well informed about the goings-on of the area. And when it comes to gossip in the school, she’s got all the facts. The deck brush she carries may be the most powerful weapon in the world."},{"spoiler":false,"text":"How does her constant testing of the protagonist’s mettle fit into her goals?"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c74095"},{"segments":[{"spoiler":false,"text":"学校のトイレを掃除しているだけの妖異、いわゆるトイレの花子さん。"},{"spoiler":false,"text":"ただし、メイド服を着ているせいで『メイドの花子さん』と呼ばれている。"},{"spoiler":false,"text":"本来は水の神である。"},{"spoiler":false,"text":"そのため、水場のあるところなら、どこにでも現れる。"},{"spoiler":false,"text":"いつも眠たげでやる気がなさそうに見えるが、校内の噂話なら、なんでも知っているレベルで詳しい。"},{"spoiler":false,"text":"彼女の持つデッキブラシは、ある意味、最強の武器。"}],"source":"egs","sourceCharacterId":"20676","sourceWorkId":"27073","spoiler":false},{"segments":[{"spoiler":false,"text":"学校のトイレを掃除しているだけの妖異、いわゆるトイレの花子さん。"},{"spoiler":false,"text":"ただメイド服を着てるせいで『メイドの花子さん』と呼ばれている。"},{"spoiler":false,"text":"本来は水の神である。"},{"spoiler":false,"text":"そのため、水場のあるところなら、どこにでも現れる。"},{"spoiler":false,"text":"いつも眠たげでやる気がなさそうに見えるが、校内の噂話なら、"},{"spoiler":false,"text":"なんでも知っているレベルで詳しい。"},{"spoiler":false,"text":"主人公のことは未熟者として軽くみているのか、"},{"spoiler":false,"text":"イタズラを仕掛けてくるなど、お茶目なところもある。かまってちゃん。"},{"spoiler":false,"text":"彼女の持つデッキブラシは、ある意味、最強の武器。"},{"spoiler":false,"text":"「男の子はね、女の子のおトイレに入って来ちゃいけないんだよ？」"}],"source":"bangumi","sourceCharacterId":"66905"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"66905","value":"掃除、噂話の収拾"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/923b2f1a7a70b71e46549d65774cbdf82d58a573b87febe42ece42876d3097dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea0a4f018f8114121f92e850c416e8e564130e0ca96e1fcede3db6315b76dce5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"設楽麻美","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:255032:66905:7904:1","source":"bangumi"}]},{"characterId":"char_c74096","characterName":"小伯 白","sourceIds":{"bangumi":[{"characterId":"66906","match":"exact-normalized-name-in-linked-work","subjectId":"255032"}],"egsCharacterIds":["20677"],"vndbCharacterId":"c74096"},"originalCharacterName":"小伯 白","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"pending-conflict","source":"vndb","value":"1208"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very playful, older sister type... who's really, really small."},{"spoiler":false,"text":"She's a dyed-in-the-wool country girl with an accent to match. However, she thinks she has no accent."},{"spoiler":false,"text":"She can't see spirits and doesn’t understand magic in the slightest. Still, since she's the protagonist's honorary older sister, she's always on his side. She's a soothing presence in his life."},{"spoiler":false,"text":"Lovebird spirits seem to really like her for some reason."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c74096"},{"segments":[{"spoiler":false,"text":"やたらとお姉さんぶってくるお茶目なお姉さん……のはずだが、ちっちゃい。"},{"spoiler":false,"text":"ただし、白姉ちゃんはちっちゃいのにデッカイ！"},{"spoiler":false,"text":"身長にそぐわぬグラマーな体型をしている。"},{"spoiler":false,"text":"生粋の地元っ子で、よく方言が混ざったしゃべり方をする。"},{"spoiler":false,"text":"ただ、本人だけは標準語を話せてるつもり。"},{"spoiler":false,"text":"また、妖異を見ることができず、魔法についてもさっぱりわからない。"},{"spoiler":false,"text":"それでもお姉ちゃんはお姉ちゃんなので、いつでも主人公の味方でいてくれる癒しの存在。"},{"spoiler":false,"text":"なぜか、卯子鳥サマという妖異に好かれる。"}],"source":"egs","sourceCharacterId":"20677","sourceWorkId":"27073","spoiler":false},{"segments":[{"spoiler":false,"text":"お姉さんぶってくるお茶目なお姉さん……のはずだが、ちっちゃい。"},{"spoiler":false,"text":"ただし、白姉ちゃんはちっちゃいのにデッカイ！"},{"spoiler":false,"text":"身長にそぐわぬグラマーな体型をしている。"},{"spoiler":false,"text":"生粋の地元っ子で、よく方言が混ざったしゃべり方をする。"},{"spoiler":false,"text":"ただ、本人だけは標準語を話せてるつもり。"},{"spoiler":false,"text":"また、妖異を見ることができず、魔法についてもさっぱりわからない。"},{"spoiler":false,"text":"それでもお姉ちゃんはお姉ちゃんなので、"},{"spoiler":false,"text":"いつでも主人公の味方でいてくれる癒しの存在。"},{"spoiler":false,"text":"なぜか、卯子鳥サマという妖異に好かれる。"},{"spoiler":false,"text":"「えへ、声かけようと思ったら、急に今日は運命の人と出会うなんて言うから…どっきんこしたべさー」"}],"source":"bangumi","sourceCharacterId":"66906"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"66906","value":"花を育てること、シャボン玉"}],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1208","source":"vndb","sourceCharacterId":"c74096","value":"1208"},{"comparisonValue":"1218","source":"egs","sourceCharacterId":"20677","value":"12/18"},{"comparisonValue":"1218","source":"bangumi","sourceCharacterId":"66906","value":"12月18日"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eeb974e393991174e3bb0b0fa043fed34400c5e297cddb1f049e941dee475490.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/242d44b6405f6a0690fcdd606859788fd69e4377fb08c98aa07fa8bdde24b437.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"門脇舞以","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"門脇 舞以","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:255032:66906:4402:1","source":"bangumi"}]},{"characterId":"char_vndb_c74097","characterName":"夜羽 睦季","sourceIds":{"vndbCharacterId":"c74097"},"originalCharacterName":"夜羽 睦季","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"518"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"In Fukano, he is the 3rd magician but he is becoming young again after know that his life-span is not more than 3 month and at that time he still didn't find a way to save Shiro using making contract with Pheles. His talent to magic is zero and since his life as the 2nd magician, he try to learn, analyze and practice what the 1st left in magician mansion. But, pheles said that no one even devil can open her sealed box while he can open it easily. she said too that the box is created by the 1st magician that can deceive other gods. that's why she give mutsuki the real meaning of his name that become a key to enter reincarnation cycle, because she believe that the current mutsuki is the 1st magician since start"}],"source":"vndb","sourceCharacterId":"c74097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b62134b3324ce4b79f11954c62203116bf410f6b2a5a1d29d03a51b3b13da3f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14f4866daa56e9233b9260489abb8ee06267b6cdbfee674dff0cd57ca263f469.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c74269","characterName":"フェレス","sourceIds":{"vndbCharacterId":"c74269"},"originalCharacterName":"フェレス","character