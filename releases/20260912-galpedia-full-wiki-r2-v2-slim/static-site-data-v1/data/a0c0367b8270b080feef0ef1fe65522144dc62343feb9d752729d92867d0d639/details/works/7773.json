direct","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鏑木の社に祀られている土地神。神格化する前は妖狐だった。"},{"spoiler":false,"text":"現在は神通力のほとんどを失ってしまったため、幼い容姿で存在している。"},{"spoiler":false,"text":"プライドが高くわがままで、どこか人を見下すようなところがあり、"},{"spoiler":false,"text":"何かと虚勢を張ろうとするが、実はかなりの寂しがりや。"},{"spoiler":false,"text":"幼い仁が鏑木の社を訪れた頃から仁を見知っていた。"}],"source":"egs","sourceCharacterId":"17005","sourceWorkId":"7773","spoiler":false},{"segments":[{"spoiler":false,"text":"鏑木の社に祀られている土地神。神格化する前は狐が化生した妖狐だった。"},{"spoiler":false,"text":"現在、神通力のほとんどを失ってしまった為、幼い容姿で存在している。プライドが高くわがままで、何処か人を見下すようなところがあり、何かと虚勢を張ろうとするが、実は結構な寂しがり屋。仁とは彼が幼い頃、鏑木の社を訪れたことがあり、その頃から仁の事は見知っていた。"}],"source":"bangumi","sourceCharacterId":"147344"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcbf68a8c4cb76531ff5fc510082d1ece930e78cfc6dffeddcaa64adf845e195.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/639284d257d34a461be8e022f776ccd8b58baeef4c6806ed2ae60458b988668d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94701:147344:6106:1","source":"bangumi"}]},{"characterId":"char_c41166","characterName":"相楽 美咲","sourceIds":{"bangumi":[{"characterId":"147346","match":"exact-normalized-name-in-linked-work","subjectId":"94701"}],"egsCharacterIds":["17007"],"vndbCharacterId":"c41166"},"originalCharacterName":"相楽 美咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"仁の義理の妹。母親を早くに亡くしている相楽家で、"},{"spoiler":false,"text":"家事全般を一手に引き受ける。"},{"spoiler":false,"text":"優しく思いやりがあり、クラス・ご近所問わずに人気があるが、"},{"spoiler":false,"text":"幼児体型が悩みの種。"},{"spoiler":false,"text":"幼い頃から父・秀真が仕事柄家を空けがちだったので、"},{"spoiler":false,"text":"代わりに面倒を見てくれた仁にかなりなついている。"}],"source":"egs","sourceCharacterId":"17007","sourceWorkId":"7773","spoiler":false},{"segments":[{"spoiler":false,"text":"仁の義理の妹。"},{"spoiler":false,"text":"母親を早くに亡くしている相楽家で、家事全般を一手に引き受け、家庭を切り盛りする小さいお母さん的存在。優しく思いやりがあり、クラス・ご近所問わずに人気があるが、まだ幼さの残る体型が悩みの種。幼い頃から父・秀真は仕事柄家を空けがちだったので、代わりに面倒を見てくれた仁にはかなり懐いている。"}],"source":"bangumi","sourceCharacterId":"147346"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e87e82efb985ed642dc4b84ac8902c57100d30a9e9fffc75bd84929b0a236c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b946b2d7fda21090248102a6412eca872c3253d97e22098d83b2d47670ae840.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永見はるか","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94701:147346:4674:1","source":"bangumi"}]},{"characterId":"char_c41167","characterName":"綺沙羅","sourceIds":{"bangumi":[{"characterId":"147345","match":"exact-normalized-name-in-linked-work","subjectId":"94701"}],"egsCharacterIds":["17006"],"vndbCharacterId":"c41167"},"originalCharacterName":"綺沙羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"狼が化生した妖狼。妖狐時代の霧絵を姉のように慕っていた。"},{"spoiler":false,"text":"過去に退魔師によって封印されていたことがあり、人間を敵対視している。"},{"spoiler":false,"text":"和服が似合う、凛とした美人でスタイル抜群。気立てもよく器量よし。"},{"spoiler":false,"text":"本来穏やかな性格だが敵には容赦しない。"},{"spoiler":false,"text":"だが主と決めた相手には忠誠を誓う。"}],"source":"egs","sourceCharacterId":"17006","sourceWorkId":"7773","spoiler":false},{"segments":[{"spoiler":false,"text":"狼が化生した妖狼。霧絵が神になる前、妖狐の姿をしていた時代に彼女を姉のように慕っていた。"},{"spoiler":false,"text":"過去に退魔師によって封印されていた事があり、人間を敵対視している。和服が似合う凜とした美女でスタイル抜群。また、気だても良くて器量良し。本来、穏やかな性格だが敵と認識した相手には容赦しない。しかし、元が狼の為、主と決めた相手には忠誠を誓う。"}],"source":"bangumi","sourceCharacterId":"147345"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/515f863df83ee4c7c26b245e85377f5a50f3ab4b8b44ca06bb30fdac3104a68c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5aa735a14594e79814f423286cdc008574e26c6cf4b2c5e83105fd943dcca341.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94701:147345:6036:1","source":"bangumi"}]},{"characterId":"char_c41168","characterName":"鏑木 千歳","sourceIds":{"bangumi":[{"characterId":"147347","match":"exact-normalized-name-in-linked-work","subjectId":"94701"}],"egsCharacterIds":["17008"],"vndbCharacterId":"c41168"},"originalCharacterName":"鏑木 千歳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"地元の神社、鏑木の社の一人娘。"},{"spoiler":false,"text":"巫女でもあるが、現在は仁と同じく母校で教職に就いている（担当は古典）。"},{"spoiler":false,"text":"さばさばして頭もよく、抜群のスタイルを誇るが、"},{"spoiler":false,"text":"当人はジャンクフードやスナック菓子が大好き。"},{"spoiler":false,"text":"ひとつ年下の仁とは互いに好意を持っていたが、"},{"spoiler":false,"text":"正式な恋人同士ではなかった。今の関係は良好。"}],"source":"egs","sourceCharacterId":"17008","sourceWorkId":"7773","spoiler":false},{"segments":[{"spoiler":false,"text":"地元の神社、鏑木の社の一人娘。"},{"spoiler":false,"text":"巫女でもあるが、現在は仁と同じく母校で教職に就いている（担当は古典）。さばさばとしていて、頭も良く、抜群のスタイルの持ち主。しかし、ジャンクフードやスナック菓子を好む傾向がある。一つ年下の仁とは学生時代、互いに好意を持っていたが、正式な恋人同士という訳ではなかった。今は仲違いする事もなく良好な関係を築いている。"}],"source":"bangumi","sourceCharacterId":"147347"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/039cc37c43f5d336f3a8720ffccbd576347118f37c323a56d6c0dcad884d6661.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/521db5c942cacf7e18a152344bf1fcd64ed1cd188674e87cc3e400535b75931c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"すずき けいこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94701:147347:6275:1","source":"bangumi"}]},{"characterId":"char_vndb_c41164","characterName":"相楽 仁","sourceIds":{"vndbCharacterId":"c41164"},"originalCharacterName":"相楽 仁","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f039942dca90259eb3e51da414ae7a35bc6a023cf35e731a6c2d4a48bdc933fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb6e7f64d58c0dbb17bb5605cd0949e89a54eb2d9d614175532b34bb01d0e76d.webp","width":225,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c41169","characterName":"日比野 かりん","sourceIds":{"vndbCharacterId":"c41169"},"originalCharacterName":"日比野 かりん","characterNameSource":null,"role":"side","status":"source-only-candidate","i