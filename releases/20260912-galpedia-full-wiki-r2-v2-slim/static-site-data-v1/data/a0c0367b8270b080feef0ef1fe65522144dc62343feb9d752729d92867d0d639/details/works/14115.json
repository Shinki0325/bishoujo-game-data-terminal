ct","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She looks like a man and she sounds like a man. A fellow teacher, she's Jun and Tsubame's coworker. She often has advice for Jun on how to be a great teacher. She enjoys writing poetry."}],"source":"vndb","sourceCharacterId":"c10744"},{"segments":[{"spoiler":false,"text":"わたくしは教頭。つまりみなさんの上司です。"},{"spoiler":false,"text":"この伝統ある羽白女学園の歴史の中で、鴇田準先生は初めての男性教師です。"},{"spoiler":false,"text":"その重大な意味をおわかりですか？"},{"spoiler":false,"text":"まだ教育実習生の身分とはいえ、容赦はいたしません。"},{"spoiler":false,"text":"わたくしたちは決して貴方のことを歓迎しているわけではありませんが、こうして男性が入ってくることも、時代の流れであるということは理解しているつもりです。"},{"spoiler":false,"text":"貴方の印象如何で今後の羽白が決まると言っても過言ではなく、より規律正しく、節度をわきまえ、紳士的に、しかし情熱を持ち、生徒たちの模範となって世の男性の姿に幻滅させることなく……（省略）"}],"source":"egs","sourceCharacterId":"11873","sourceWorkId":"14115","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"11873","sourceWorkId":"14115","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb3e4b19b3b29d6e489b2a267bfa953285b7049d9e4e18d0d2ac6202c0a5707b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f9786d56fabd4039169599eb43f51a5165e6bf696fec2e8a00a8e5b155fed24.webp","width":90,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三原 椎名","creatorId":"vndb:s2142","sourcePersonId":"vndb:s2142","canonicalEntityId":"vndb:s2142","name":"三原 椎名","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29965","source":"vndb"}]},{"characterId":"char_vndb_c10747","characterName":"鴇田　準","sourceIds":{"vndbCharacterId":"c10747"},"originalCharacterName":"鴇田　準","characterNameSource":null,"role":"main","status":"source-o