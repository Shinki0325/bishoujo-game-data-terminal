oleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:302258","source":"egs"},{"creditedName":"野山 風一郎","creatorId":"vndb:s8747","sourcePersonId":"vndb:s8747","canonicalEntityId":"vndb:s8747","name":"野山 風一郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:222931","source":"vndb"},{"creditedName":"和音まりか","creatorId":"vndb:s43176","sourcePersonId":"vndb:s43176","canonicalEntityId":"vndb:s43176","name":"和音まりか","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:222933","source":"vndb"},{"creditedName":"Aintops","creatorId":"vndb:s6186","sourcePersonId":"vndb:s6186","canonicalEntityId":"vndb:s6186","name":"吉田 省吾","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:222935","source":"vndb"}]},"cast":[{"characterId":"char_c49836","characterName":"シンフォニックリリー","sourceIds":{"bangumi":[{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"200512"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222233"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222234"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222242"}],"egsCharacterIds":["15746","16092"],"vndbCharacterId":"c49836"},"originalCharacterName":"シンフォニックリリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"826"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聡明で頭がよく、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢だが、そういったことをひけらかすことのない控えめな性格。"},{"spoiler":false,"text":"しかし、自分の立場や出自が持つ重要性は十分自覚している。"},{"spoiler":false,"text":"人にはない“魔力”という力を自分が持ってしまったことを恐れ、 悩んでいたが、ある日、かつてメッツァーと戦ったスイートナイツの存在を知り、彼女たちのように自分の力を正義のために使って悪と戦うことを決意。"},{"spoiler":false,"text":"魔力を利用した強化変身システムの開発を財閥の研究部門に指示、 自ら被験者となって研究を主導し、同時に運用・管理・バックアップを行う機関「ミネルヴァ・ガード」を創設。"},{"spoiler":false,"text":"完成したシステムを自ら装備し、はびこる悪と戦うためにシンフォニックナイツとなった。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"8708","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックリリー"},{"spoiler":false,"text":"私立白耀魔法学園の生徒会長にして百合瀬財閥の頭取。"},{"spoiler":false,"text":"常に冷静な判断力と柔らかな人当たりで生徒からの信頼も厚い。"},{"spoiler":false,"text":"趣味は音楽鑑賞。"},{"spoiler":false,"text":"特に生徒会室では常にクラシックが流れている。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"百合瀬財団当主として忙しい日々を送りながら、次世代の魔法戦士を育てるために、国際教導学園を買い取って魔法教育に力を入れている。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"聡明、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢。"},{"spoiler":false,"text":"『魔法戦士シンフォニックナイツ』に登場するヒロイン。"},{"spoiler":false,"text":"今作ではファルケの毒牙にかかり、彼を支援する。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"清純可憐な百合瀬財団の当主だったが、そのあまりにも正義に純粋な心を利用されて、ファルケに調教されてしまう。"},{"spoiler":false,"text":"現在はファルケの配下となって彼の野望のために活動中。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"「あなたに身も心も翻弄されていた、以前の私とは違います」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"清純可憐で聡明な、世界的財閥である百合瀬財団の当主。"},{"spoiler":false,"text":"ファルケに調教されて配下となっていたが、今は正義の心を取り戻して平和のために尽くしており、『ゲート計画』の危険性を見抜き、計画を阻止すべく行動している。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"世界的財閥である百合瀬財団の当主。"},{"spoiler":false,"text":"様々な事情から国際教導学園の運営から退き、魔法戦士としての任務を全うするべく日々活動している。"},{"spoiler":false,"text":"現在は魔法犯罪者の大量脱走事件を追っている。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックリリー。本名は百合瀬莉々奈。"},{"spoiler":false,"text":"世界有数の規模を誇る百合瀬財団の総帥。国際教導学園の理事長でもある。"},{"spoiler":false,"text":"生まれ持ったカリスマ性、優れた知力、卓越した戦術眼で、魔法戦士の指揮官のようなポジションとして活躍している。"},{"spoiler":false,"text":"指揮だけでなく、自ら前線で戦うことも珍しくない。"},{"spoiler":false,"text":"財界や政界とのつながりもあり、魔法戦士が十全に活躍できるよう各界と様々な調整を行っている。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"世界有数の財閥である百合瀬財閥の総帥にして、魔法戦士シンフォニックナイツの一人、シンフォニックリリー。魔法戦士が多く集まる国際教導学園の理事長でもある。その卓越した能力とカリスマ性で、前線で戦いながら魔法戦士たちを指揮することも多い。財界や政界とのつながりもあり、魔法戦士の障害にならぬよう各界と様々な調整を行っている。最近、過去の調教の記憶を悪夢としてみるようになり、そのことで悩んでいる。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"聡明で頭がよく、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢だが、そういったことをひけらかすことのない控えめな性格。"},{"spoiler":false,"text":"しかし、自分の立場や出自が持つ重要性は十分自覚している。"},{"spoiler":false,"text":"人にはない“魔力”という力を自分が持ってしまったことを恐れ、 悩んでいたが、ある日、かつてメッツァーと戦ったスイートナイツの存在を知り、彼女たちのように自分の力を正義のために使って悪と戦うことを決意。"},{"spoiler":false,"text":"魔力を利用した強化変身システムの開発を財閥の研究部門に指示、 自ら被験者となって研究を主導し、同時に運用・管理・バックアップを行う機関『ミネルヴァ・ガード』を創設。"},{"spoiler":false,"text":"完成したシステムを自ら装備し、はびこる悪と戦うためにシンフォニックナイツとなった。"}],"source":"bangumi","sourceCharacterId":"96140"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"16092","sourceWorkId":"40423","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null