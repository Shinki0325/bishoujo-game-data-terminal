er":false,"text":"主人公のライバル会社の敏腕スタッフ。 子持ちの人妻。"},{"spoiler":false,"text":"実は主人公の元カノで、婚約までしていたが子供が欲しくないと言われ別れた。"},{"spoiler":false,"text":"よく主人公の事務所に来ては茶々を入れたり、依頼を横取りしたりしているが、"},{"spoiler":false,"text":"本人は恨みを晴らしているつもりで未練たらたら。 足蹴にしてまんざらではない様子。"}],"source":"bangumi","sourceCharacterId":"56224"}],"profileFacts":[{"label":"年龄（本版本）","value":"34 岁","valueContext":null,"source":"egs","sourceCharacterId":"16813","sourceWorkId":"26911","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"16813","sourceWorkId":"26911","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"16813","sourceWorkId":"26911","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"16813","sourceWorkId":"26911","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"16813","sourceWorkId":"26911","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a49742035ed96921f6a78b8cae4a69dd7e496bc030fe5a6b420e836d64613dd5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7705ce05a5dc465da71a92af22c96b515de46d9830974d569e41ae6528d36521.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ありかわ真奈","creatorId":"vndb:s5761","sourcePersonId":"vndb:s5761","canonicalEntityId":"vndb:s5761","name":"ありかわ真奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:249812:56224:21127:1","source":"bangumi"}]},{"characterId":"char_c74168","characterName":"櫛柳 千弦","sourceIds":{"bangumi":[{"characterId":"65246","match":"exact-normalized-name-in-linked-work","subjectId":"249812"}],"egsCharacterIds":["20461"],"vndbCharacterId