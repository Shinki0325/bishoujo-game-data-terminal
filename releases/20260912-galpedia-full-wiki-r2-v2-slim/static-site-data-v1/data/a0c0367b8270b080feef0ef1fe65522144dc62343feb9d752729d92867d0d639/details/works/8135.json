db"},{"creditedName":"上野 洋子","creatorId":"vndb:s8135","sourcePersonId":"vndb:s8135","canonicalEntityId":"vndb:s8135","name":"Yoko","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4030","source":"vndb"},{"creditedName":"Yoko","creatorId":"vndb:s8135","sourcePersonId":"vndb:s8135","canonicalEntityId":"vndb:s8135","name":"Yoko","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:4031","source":"vndb"},{"creditedName":"三杜 シノヴ","creatorId":"vndb:s10611","sourcePersonId":"vndb:s10611","canonicalEntityId":"vndb:s10611","name":"三杜 シノヴ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4032","source":"vndb"},{"creditedName":"もえら","creatorId":"vndb:s11991","sourcePersonId":"vndb:s11991","canonicalEntityId":"vndb:s11991","name":"土居由直","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4033","source":"vndb"},{"creditedName":"りんご キック","creatorId":"vndb:s14208","sourcePersonId":"vndb:s14208","canonicalEntityId":"vndb:s14208","name":"りんご キック","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4034","source":"vndb"},{"creditedName":"ぺはら塗装","creatorId":"vndb:s29090","sourcePersonId":"vndb:s29090","canonicalEntityId":"vndb:s29090","name":"ぺはら工務店","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4035","source":"vndb"},{"creditedName":"BON*NOB","creatorId":"vndb:s11357","sourcePersonId":"vndb:s11357","canonicalEntityId":"vndb:s11357","name":"成田 伸子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4036","source":"vndb"}]},"cast":[{"characterId":"char_c12330","characterName":"ロメオ","sourceIds":{"bangumi":[{"characterId":"16354","match":"exact-normalized-name-in-linked-work","subjectId":"16792"}],"egsCharacterIds":["12214"],"vndbCharacterId":"c12330"},"originalCharacterName":"ロメオ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cool and lax protagonist. He’s an idiot when it comes to locations, never knowing the correct way to go. Knows a lot of stuff that normal people wouldn’t know."},{"spoiler":false,"text":"Romeo is a slack taxi driver who absolutely stinks at going around the city with his taxi. Or that’s what he looks like from the outside. But the truth is, he’s a runaway werewolf from the Oruma Rossa, the only remaining werewolf clan. He lives together with Anna, an antique doll he picked up from the dump after he left the Oruma Rossa. But Oruma Rossa do not feel like ignoring Romeo any longer and the Luparia (Anti werewolf force) is moving behind in the shadows. Romeo will find himself surrounded by both new and old foes."},{"spoiler":false,"text":"Edited from a review by Accany"}],"source":"vndb","sourceCharacterId":"c12330"},{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"「人狼」で構成された犯罪組織オルマ・ロッサの元殺し屋で、彼自身も人狼。"},{"spoiler":false,"text":"ある事件以後、組織との繋がりを断ち、舞台となる都市――ベルモントで新しい生活を始める。"},{"spoiler":false,"text":"現在はタクシードライバーを生業とし、日銭を稼ぎながら地味に暮らしている。"},{"spoiler":false,"text":"ぶっきらぼうで人当たりが悪い上に重度の方向音痴なことから、乗客との喧嘩が絶えない。"}],"source":"egs","sourceCharacterId":"12214","sourceWorkId":"8135","spoiler":false},{"segments":[{"spoiler":false,"text":"ベルモントに住むモグリのタクシードライバーだが人当たりが悪く重度の方向音痴な為、乗客との諍いが絶えない。ヘビースモーカー。正体は人狼であり、かつては犯罪組織オルマ・ロッサで殺し屋として活躍していたが、ある事件をきっかけに組織との縁を切った。しかし、ロメオを狙うオルマ・ロッサは再び彼の前に立ちはだかる。"}],"source":"bangumi","sourceCharacterId":"16354"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bede0478387d0512b0289985e617d999fd36da1c7486ec2456ee71f27fc22c41.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b18b56f0def66385f08e1fbbdbbf5c5ea0d0e5e2b195638130638e6c7b14d42.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16792:16354:4513:1","source":"bangumi"}]},{"characterId":"char_c12331","characterName":"アンナ","sourceIds":{"bangumi":[{"characterId":"16353","match":"exact-normalized-name-in-linked-work","subjectId":"16792"}],"egsCharacterIds":["12215"],"vndbCharacterId":"c12331"},"originalCharacterName":"アンナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Anna is an antique doll Romeo found in a trash dump. She had lost all her memories. She works in Germano’s workshop, fixing machines and making orgels. She’s a bright, lively and hilarious character that takes care of Romeo."},{"spoiler":false,"text":"Edited from a review by Accany"}],"source":"vndb","sourceCharacterId":"c12331"},{"segments":[{"spoiler":false,"text":"主人公がゴミ捨て場から拾った記憶喪失の自動機械人形（オートマタ）。"},{"spoiler":false,"text":"機械の癖に物覚えが悪い。"},{"spoiler":false,"text":"普通のオートマタと違い自由意志を持つ。"},{"spoiler":false,"text":"カラクリ細工の修理を専門とするジェルマーノ工房の助手として、機械では創作できない音楽を奏でるオルゴールを作っている。"}],"source":"egs","sourceCharacterId":"12215","sourceWorkId":"8135","spoiler":false},{"segments":[{"spoiler":false,"text":"ゴミ捨て場でロメオに拾われた記憶喪失のオートマタ。紫水晶の瞳を持つ。偶然の出会いからロメオとの共同生活を始め、ジェルマーノ工房で見習いとして働いている。機械でありながら物覚えが悪いが、他の自動機械人形と違い前向きで自由な意思を持っている。"}],"source":"bangumi","sourceCharacterId":"16353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2017bd31c73de49a2a54400c09bbd699ec646287fbf3e336939a99ea6ff71497.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4762a5849c6a4ab39a386fd1ed29a3f777b3faa947c917d41b9bc41a08529862.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高野直子","creatorId":"vndb:s14","sourcePersonId":"vndb:s14","canonicalEntityId":"vndb:s14","name":"高野 直子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16792:16353:4031:1","source":"bangumi"}]},{"characterId":"char_c12332","characterName":"ノエル","sourceIds":{"bangumi":[{"characterId":"140213","match":"exact-normalized-name-in-linked-work","subjectId":"16792"}],"egsCharacterIds":["12217"],"vndbCharacterId":"c12332"},"originalCharacterName":"ノエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An orphan selling drugs for a gang. She acts like a guy, but does have girlish traits. Currently working as a guide working with Romeo. She knows a lot of Belmonte’s history, which makes her an excellent guide. Stubborn and pretty emotional. Doesn’t agree with Romeo 90% of the time."},{"spoiler":false,"text":"Edited from a review by Accany"}],"source":"vndb","sourceCharacterId":"c12332"},{"segments":[{"spoiler":false,"text":"麻薬売買組織の一員として暮らす孤児。"},{"spoiler":false,"text":"観光客相手にスリを働くこともある。"},{"spoiler":false,"text":"ベルモントの地理に詳しく、またその歴史にも詳しい。"},{"spoiler":false,"text":"他人に自分の弱みを見せることを酷く嫌っている。"}],"source":"egs","sourceCharacterId":"12217","sourceWorkId":"8135","spoiler":false},{"segments":[{"spoiler":false,"text":"麻薬売買組織の一員として暮らす孤児。"},{"spoiler":false,"text":"観光客相手にスリを働くこともある。"},{"spoiler":false,"text":"ベルモントの地理に詳しく、またその歴史にも詳しい。"},{"spoiler":false,"text":"他人に自分の弱みを見せることを酷く嫌っている。"}],"source":"bangumi","sourceCharacterId":"140213"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6ffd0943be1751e4302701956e530493375a371b5cedec98818e16df80715868.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a57e4688a62c880f20cc80ca822c8d669e535e5a5f10ffd6a9038accde6146b8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16792:140213:4810:1","source":"bangumi"}]},{"characterId":"char_c12334","characterName":"ルナリア","sourceIds":{"bangumi":[{"characterId":"16352","match":"exact-normalized-name-in-linked-work","subjectId":"16792"}],"egsCharacterIds":["12216"],"vndbCharacterId":"c12334"},"originalCharacterName":"ルナリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lunaria is an antique doll and works in a circus. Acrobatic and precise tricks are her forte. She also does puppet shows. She hates her master and is jealous of how Anna and Romeo has mutual understanding even though they aren’t bound by anything. She’s a tsundere. A pretty extreme one too."},{"spoiler":false,"text":"Edited from a review by Accany"}],"source":"vndb","sourceCharacterId":"c12334"},{"segments":[{"spoiler":false,"text":"人形曲馬団チルチェンセスで花形を務める自動機械人形（オートマタ）。"},{"spoiler":false,"text":"軽業師。手先も器用なことから、公演の合間に人形劇を演じることも。"},{"spoiler":false,"text":"主人であるダヴィデを嫌っており、主人公とアンナの主従関係とは違った雰囲気の間柄に嫉妬を感じているようだ。"}],"source":"egs","sourceCharacterId":"12216","sourceWorkId":"8135","spoiler":false},{"segments":[{"spoiler":false,"text":"ルナリア　CV：紅野ミア"},{"spoiler":false,"text":"人形曲馬団チルチェンセスで花形を務める自動機械人形（オートマタ）。"},{"spoiler":false,"text":"身のこなしが軽く、軽業が得意。また手先も器用で、公演の合間に人形劇を演じることもある。"},{"spoiler":false,"text":"主人であるダヴィデを心底嫌っており、単なる主従関係とは異なるロメオとアンナの仲に嫉妬している。"},{"spoiler":false,"text":"「――私を連れて逃げてください」"}],"source":"bangumi","sourceCharacterId":"16352"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82b47bfe504995eedd55a747b437e5d63906303ce7820c5a82163a0f793fe6ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4a789da1c0add4bcc8dae9b0d0e4ea65d260be04b70f57061f2c71702a2c56d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16792:16352:3851:1","source":"bangumi"}]},{"characterId":"char_c12335","characterName":"レベッカ","sourceIds":{"bangumi":[{"characterId":"24475","match":"exact-normalized-name-in-linked-work","subjectId":"16792"}],"egsCharacterIds":["12218"],"vndbCharacterId":"c12335"},"originalCharacterName":"レベッカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The werewolf who’s in the management position of the Oruma Rossa. She’s the lover of Silvio, the next head of the Oruma Rossa. She still has feelings for Romeo. Extremely good in shooting. Loves sweet stuff. It’s hard to know what she’s thinking."},{"spoiler":false,"text":"Edited from a review by Accany"}],"source":"vndb","sourceCharacterId":"c12335"},{"segments":[{"spoiler":false,"text":"人狼の犯罪組織オルマ・ロッサで幹部。射撃の名手。"},{"spoiler":false,"text":"現在、副頭領・シルヴィオと愛人関係にある。"},{"spoiler":false,"text":"かつて主人公から血を受けて命を救われたことがあり、また一緒に仕事をしたいと思っている。"},{"spoiler":false,"text":"甘いものが大好物で、デザートが主食。"}],"source":"egs","sourceCharacterId":"12218","sourceWorkId":"8135","spoiler":false},{"segments":[{"spoiler":false,"text":"レベッカ　CV：奥田香織"},{"spoiler":false,"text":"北部をまとめる人狼の犯罪組織オルマ・ロッサで幹部を務める女。現在は副頭領のシルヴィオと愛人関係にある。"},{"spoiler":false,"text":"かつてロメオから人狼の血を受け命を救われたことがあり、また一緒に仕事をしたいと考えている。"},{"spoiler":false,"text":"射撃の名手。甘いものには目がなく、デザートを主食とする。"},{"spoiler":false,"text":"「あなたに殺されるなら、本望よ」"}],"source":"bangumi","sourceCharacterId":"24475"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77a5f43a6b3718b6d48ee2cd7edf48f37aaee73442bcadd5d560e6d73fdef37b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e571502481e194ab001073927cf00a23b4e3eb30283f7d52a9f3d252d2d2ca54.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"百々麻子","creatorId":"vndb:s1023","sourcePersonId":"vndb:s1023","canonicalEntityId":"vndb:s1023","name":"百々 麻子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16792:24475:4767:1","source":"bangumi"}]},{"characterId":"char_vndb_c12336","characterName":"カルメロ","sourceIds":{"vndbCharacterId":"c12336"},"originalCharacterName":"カルメロ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An assassin hired by Silvio, the vice boss of Oruma Rossa. The later had also the one who turned Carmelo into a werewolf. Carmelo always haunts Romeo. He is a drug addict who can easily pick up a fight with anyone. Carmelo goes berserk every time he's intimidated. He is not very good at thinking."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/243fa11bd6d00f05d5a297d3d8b4d43650abba26fba26d6c4b9f1e6865a3e78f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09414707ecbb053bd2fb837ad8371b4d156429e9c904b3a53a508b554fb6afdb.webp","width":206,"height":256,"source":"static-detail"},"actors":[{"creditedName":"保村 真","creatorId":"vndb:s289","sourcePersonId":"vndb:s289","canonicalEntityId":"vndb:s289","name":"保村 真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1233","source":"vndb"}]},{"characterId":"char_vndb_c12337","characterName":"イリス","sourceIds":{"vndbCharacterId":"c12337"},"originalCharacterName":"イリス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An elusive girl who is seldom seen in Belmonte. Iris is an automatic machine doll (Automata) who works for Luparia, an organization that creates weapons against werewolves. She always carries a bunny plush doll with her, whom she treats like her best friend. Her emotions are very intense. If there is something she really wants to do or get, she'll try to accomplish it in every possible way, even by crying."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc356e56ac216dece65a15c259e0d8c8fe3f35f190e00e83798f1cf5d62b3f44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9508e3a409b9845a387386de862570b371bb3fa04ae75ce00339588a8adfb0e0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊 るな","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1236","source":"vndb"}]},{"characterId":"char_vndb_c12338","characterName":"ペルラ","sourceIds":{"vndbCharacterId":"c12338"},"originalCharacterName":"ペルラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An automatic machine doll (Automata) who works as a maid in a mansion in Lemont. Perla also works for Luparia, an organization that creates weapons against werewolves. She doesn't express her emotions, but she can nonchalantly fire off extremely harsh words in your face. Perla is very punctuate, she hates it when others are even slightly late to an appointment with her. She always carries a pocket watch (Saponetta) with her."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4e1080b777af4fc656501d3229deeb589fc33870055f81283289d85b7c12dca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9641996e34f0e352e683abbf5bd8212375afee81c6f7655ce3dc4c20a9e3e35.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新内 紀里","creatorId":"vndb:s81","sourcePersonId":"vndb:s81","canonicalEntityId":"vndb:s81","name":"浅川 悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1239","source":"vndb"}]},{"characterId":"char_vndb_c12349","characterName":"コルナリーナ","sourceIds":{"vndbCharacterId":"c12349"},"originalCharacterName":"コルナリーナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although officially Cornalina's name will be engraved in the history as a chess themed automatic mechanical doll, her real identity is a member of Luparia, an organization that creates weapons against werewolves. As a chess doll, she agrees to associate only with certain people such as very famous people. She is so picky about who she lets to see her that some people even voice the question of her existing. Although she always behaves elegantly like a lady, her true intentions and feelings had been revealed to very few people."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12349"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b472183d0eab8634512a7e982556ea3ecceb7487251cbaef73e4b1346989725.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/ded3d3b2aa02875a8c8c0818193cadf1e42887cba25c198ffedd0a6f63d33b02.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海原 エレナ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1230","source":"vndb"}]},{"characterId":"char_vndb_c12361","characterName":"ジェルマーノ","sourceIds":{"vndbCharacterId":"c12361"},"originalCharacterName":"ジェルマーノ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of Germano studio and Anna's employer, specializes in the repair of karakuri dolls. Germano is a stubborn craftsman with a bad mouth. He pours more love into the machines and dolls he creates than into human beings that surround him. Nevertheless, he is the best mechanical dolls (Automata) craftsman in Belmonte, a title he is very proud of."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12361"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7f49c8de2fec7fb21c3213b138a0258b73ccf11b90de0787ee63d4e8494cde5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df35156cd5b4e93659bc7ad940a1b0c393a56fa394325864d11ff3cdffa28800.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"牛柳 亀三","creatorId":"vndb:s1488","sourcePersonId":"vndb:s1488","canonicalEntityId":"vndb:s1488","name":"宝亀 克寿","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1241","source":"vndb"}]},{"characterId":"char_vndb_c12370","characterName":"パオロ","sourceIds":{"vndbCharacterId":"c12370"},"originalCharacterName":"パオロ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A narcotic investigator who has been assigned to Belmonte. As a second generation member of a hardcore drug fighting and trafficking organization, Paolo can get his hands on a large amount of helpful and accurate information, he is also well known by the public. But at the same time, his attitude which does not permit compromises, had led to antipathy from his family. He always has a concealed liquor bottle in his pocket."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12370"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4eac3e50cad78e01a6d697bcb45f8d9cde4eef92fcd958dbb76fd8527c963199.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/849f396c3adf4259d6238adbda85b48132cd94a2abafd4f26ba686a72808cbc5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋山 樹","creatorId":"vndb:s48","sourcePersonId":"vndb:s48","canonicalEntityId":"vndb:s48","name":"鶴岡 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1244","source":"vndb"}]},{"characterId":"char_vndb_c12371","characterName":"ダヴィデ","sourceIds":{"vndbCharacterId":"c12371"},"originalCharacterName":"ダヴィデ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head of a doll circus troupe who wanders from place to place all over Europe with his dolls. Davide has an obsessive love for dolls, he can even throw away his own life in order to boast his doll Lunaria."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcf2b57cfb7f342c8fb80027c1346e2fabab0f99633950cfbc6c77876f90db64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c93f3b74d3424fd87dd267ca7300d49ac898148495e5763ba369a2376a0a357.webp","width":230,"height":256,"source":"static-detail"},"actors":[{"creditedName":"比留間 京之介","creatorId":"vndb:s8","sourcePersonId":"vndb:s8","canonicalEntityId":"vndb:s8","name":"若本 規夫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1228","source":"vndb"}]},{"characterId":"char_vndb_c12372","characterName":"ピウス","sourceIds":{"vndbCharacterId":"c12372"},"originalCharacterName":"ピウス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head of Luparia, a religious organization that fights against werewolves and magic. Pius lives surrounded by doll associates in an ivory tower in Belmonte, and there are very few of those who know more than that about his identity. Pius hates werewolves; he has a burning obsession to eradicate the Oruma Rossa."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0384b386aff234897951822216d308c7ea4ead59d642e76232cbd69c7956c7f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0b5e137ec08035cf41494c58733b5cc8e546ccd3281aec8153a1b679a229a16.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皇 帝","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"皇帝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1231","source":"vndb"}]},{"characterId":"char_vndb_c12373","characterName":"シルヴィオ","sourceIds":{"vndbCharacterId":"c12373"},"originalCharacterName":"シルヴィオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Silvio is the Vice boss (Vice Capo) of the north werewolf crime organization Oruma Rossa. He used to be Romeo's close friend and a good rival. After Romeo had ran away from the clan, he hired an assassin (Carmelo) to track him down."},{"spoiler":false,"text":"He is the lover of Rebecca, who is also a member of Oruma Rossa. Silvio is an impatient person, he enjoys knocking down others more than anything else."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fb910630021c095619ef47fe55a823bffd7ce491ba76ef5864f86c9f0238a6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6883d3aba17229d22626183822c4e4a94a8cb39b1c9635cd5bbc3390119a004.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松上九郎左衛門","creatorId":"vndb:s24596","sourcePersonId":"vndb:s24596","canonicalEntityId":"vndb:s24596","name":"松上九郎左衛門","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1246","source":"vndb"}]},{"characterId":"char_vndb_c12374","characterName":"ヴァレンティーノ","sourceIds":{"vndbCharacterId":"c12374"},"originalCharacterName":"ヴァレンティーノ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The boss (Capo) of the north werewolf crime organization Oruma Rossa. While being the head of a criminal organization, Valentino is proud to receive the respect of many celebrities. He despises being involved in drug dealership. Valentino was Romeo's guardian once."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c12374"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/471b99f741804cc97f1b9215b1e6c3d480f0f8cc51ad426afaf2fc464da8d589.webp","fallbackUrl":"https://wiki-assets.b