"source":"vndb"},{"creditedName":"湯","creatorId":"vndb:s10605","sourcePersonId":"vndb:s10605","canonicalEntityId":"vndb:s10605","name":"湯","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:21368","source":"vndb"},{"creditedName":"matsuNe","creatorId":"vndb:s4327","sourcePersonId":"vndb:s4327","canonicalEntityId":"vndb:s4327","name":"松根 マサト","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:21369","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c494","characterName":"若宮 明日香","sourceIds":{"vndbCharacterId":"c494"},"originalCharacterName":"若宮 明日香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wakamiya Asuka is Shuuji’s childhood friend. They live together in the Mikaze house along with Rika-nee, and also in the same class. Cheerful and carefree, Asuka is best friends with Nanami and close to Ruriko. Both Asuka and Rika-nee couldn’t cook, so they used to eat raw food before Shuuji came back to the island."},{"spoiler":false,"text":"Edited from Rin's character review."}],"source":"vndb","sourceCharacterId":"c494"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/090b4e1e24c61af2acd2fc9b9687f368cfcd97cd113d69835a02fa05ce8a381f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49fa60b0d7a0c32ef739cf85bcd5df1a1f192a082280f2718235f07a38e588c6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安玖深 音","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10831","source":"vndb"}]},{"characterId":"char_vndb_c495","characterName":"夕霧 瑠璃子","sourceIds":{"vndbCharacterId":"c495"},"originalCharacterName":"夕霧 瑠璃子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1010"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuugiri Ruriko is Shuuji’s kouhai, and also one of his childhood friends. She is a gentle girl who loves making sweets and is kind to everyone. Ruriko’s body is weak ever since she was small, and she lives next door to the Mikaze house. Ruriko’s home is a clinic, and her overprotective brother is a doctor."},{"spoiler":false,"text":"Edited from Rin's character review."}],"source":"vndb","sourceCharacterId":"c495"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c000bce41fc4168024016612052dc3780f6c8b8faa051ab066e7b5b43b611c50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08ea00ea6c6eeb7a0f2b7ee8e569d05edd7342ac253e8cdd542e0d2d0dc65f21.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五行 なずな","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10829","source":"vndb"}]},{"characterId":"char_vndb_c496","characterName":"月野 舞","sourceIds":{"vndbCharacterId":"c496"},"originalCharacterName":"月野 舞","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1115"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukino Mai is the daughter of the owner of Gekka, a popular Chinese restaurant where Shuuji works part-time at. Mai was born and raised in the mainland, and currently she’s attending an all-girls high school there. Though she is technically Shuuji’s boss, she told him to call her by her name since they’re of the same age. A slight tsundere, though according to Nanami she’s more like a villain than a tsundere."},{"spoiler":false,"text":"Edited from Rin's character review."}],"source":"vndb","sourceCharacterId":"c496"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cfb6557c126d9288408a76abf02c48369844021798c7e6052bf82848c11dec4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad48ee2cb030c874d4568d8f917e8f60214337a445d6a22466d504b4ee266217.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢野 みりか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10834","source":"vndb"}]},{"characterId":"char_vndb_c497","characterName":"泉水 小夜","sourceIds":{"vndbCharacterId":"c497"},"originalCharacterName":"泉水 小夜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1212"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Izumi Saya is one of Shuuji’s classmate. A serious and smart tsundere, only losing to Asuka in terms of marks. Even though her grades are top-class, she often show up late at school. Saya is cool and distant, and while she seems to avoid interacting with people generally, Saya especially dislikes Asuka for an unknown reason."},{"spoiler":false,"text":"Edited from Rin's character review."}],"source":"vndb","sourceCharacterId":"c497"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3058999af1242eba15100595dc2fc73579eca0726dbb12b0e6c71dd8af1d8b5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d275ab8982caa48fb7d90a944e694490bd7f0edcc41c4802ed98ceef3e04c85d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"祢乃 照果","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10832","source":"vndb"}]},{"characterId":"char_vndb_c499","characterName":"御風 里佳","sourceIds":{"vndbCharacterId":"c499"},"originalCharacterName":"御風 里佳","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"202"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mikaze Rika is Shuuji’s cousin, though she thinks of Shuuji as her own little brother. The Mikaze family is the owner of the island, and therefore a very powerful family with a big influence. Rika is also the principal of Suzumori Gakuen, Shuuji and Asuka’s school. She likes to drink alcohol, but after Asuka started living with her, the habit seems to have calmed down a bit."},{"spoiler":false,"text":"Edited from Rin's character review."}],"source":"vndb","sourceCharacterId":"c499"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b5e996aed971f8a07da3867bcd607ecafe395483f5f737aff680849556c363a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf3464995c552b1a28685568e788f894c6f8d17206b202d3529ba0f77438bdd1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10828","source":"vndb"}]},{"characterId":"char_vndb_c500","characterName":"八代　修司","sourceIds":{"vndbCharacterId":"c500"},"originalCharacterName":"八代　修司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shuuji was born in Mikazejima. Previously residing in Tokyo, he accepted the transfer school invitation from his cousin sister, Rika, at the Suzumori Acadamy. He's good at cooking."},{"spoiler":false,"text":"Roughly translated from Chinese wikipedia."}],"source":"vndb","sourceCharacterId":"c500"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44c89d0f8bc1c7084799544144de4e864c72ca01cc43a0f96d2f1834066594cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0471adcdea15d5c5264dce30a35797d05be7e4378f9fae0eeac84b6babeb6392.webp","width":256,"height":241,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c502","characterName":"藤崎 あさひ","sourceIds":{"vndbCharacterId":"c502"},"originalCharacterName":"藤崎 あさひ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"402"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"147"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fujisaki Asahi is a 3rd year student in Suzumori Gakuen, making her Shuuji’s senpai. She’s a loli appearance-wise, and also does things on her own pace. As the head of the drama club, Asahi tried getting Shuuji to join ever since their first meeting. Shuuji’s classmate Nanami Mina loves Asahi so much, up to the point where she thinks Asahi is hers alone."},{"spoiler":false,"text":"Edited from Rin's character review."}],"source":"vndb","sourceCharacterId":"c502"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc1964c74c6c7ae0c7bfd226e1285bd6d57315191e8760b74aae85579ef9b5c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aabd83fb97dc779d544c4331663a2cee4c63239611cc59e2cefd49fd862bb2db.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井村屋 ほのか","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10833","source":"vndb"}]},{"characterId":"char_vndb_c504","characterName":"七海 美菜","sourceIds":{"vndbCharacterId":"c504"},"originalCharacterName":"七海 美菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1020"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nanami Mina is one of Shuuji’s classmates. Her parents are busy with work, so she’s the one taking care of her younger siblings. She also works part-time at two places. Delivering milk in the morning and as a waitress at Gekka on afternoon. She is a member of the drama club as well. Nanami hates studying, and usually needs to take extra classes because of her low marks. A cute and cheerful class rep, but her attitude isn’t exactly girly."},{"spoiler":false,"text":"Edited from Rin's character review."}],"source":"vndb","sourceCharacterId":"c504"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddf94ffa1be8c0845705f7517f8c7ca800be7b6f2ff20b74988f69c1eea92333.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/525be66c711c4aac053d6307821a5d617d88e95b0f423de02a48cc3af3d125a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10830","source":"vndb"}]},{"characterId":"char_vndb_c505","characterName":"七海 真奈美","sourceIds":{"vndbCharacterId":"c505"},"originalCharacterName":"七海 真奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nanami Manami is Nanami Mina’s younger sister. She attends the Okihara Girl’s School in the mainland. A talented pianist, Manami is a polite and feminine girl, though at some points she’s really similar to her sister. At first she had a terrible fear of men, which made her a very dangerous girl when equipped with her electric baton. To protect Manami’s delicate fingers, Nanami did all of the housework."},{"spoiler":false,"text":"Edited from Rin's character review."}],"source":"vndb","sourceCharacterId":"c505"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecafe49501efe280a62fdef98b69649c1d90d0a05863b4da556af57890f8de9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b3a2092c080ab2d623aa6d837d31bfd354ae40a8bbbd53757e70c9636d62ea2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10827","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p132","sourceCompanyId":"egs:brand:666","canonicalEntityId":"vndb:p132","name":"Purple software","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:11070:666","source":"egs"},{"companyId":"vndb:p132","sourceCompanyId":"vndb:p132","canonicalEntityId":"vndb:p132","name":"パープルソフトウェア","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:110657:v1190","source":"vndb"},{"companyId":"vndb:p132","sourceCompanyId":"vndb:p132","canonicalEntityId":"vndb:p132","