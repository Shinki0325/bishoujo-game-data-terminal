{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"34477","model":{"presentationWorkId":"egs:34477","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_156354","characterName":"星の旅人","sourceIds":{"bangumi":[{"characterId":"156354","match":"source-roster","subjectId":"312095"},{"characterId":"156354","match":"source-roster","subjectId":"435190"}]},"originalCharacterName":"星の旅人","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イノは『イノセントルール』の主人公となる人物で、男性です。『アサイラム』ではいろいろとあった彼ですが、今では目的のない旅をしており、本作の舞台パーラテスにおいても特に理由なく冒険を始めることになります。"},{"spoiler":false,"text":"イノは無垢な少年といったようなキャラクターで、性の知識、経験共に皆無に等しいです。そんな彼が、とある理由から女性型の魔物たちを仲間にしていくことになりますが、その結果どのような目に遭うのか想像に難くありません……"}],"source":"bangumi","sourceCharacterId":"156354"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a6c53056783815518f7a6684b7e329067d38acd4634dae042ba0299d21e1ad7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ed01c8511163bfd1def30d9efdfa336b8d9c7ae54e567cb01cb16299df2b26b.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156356","characterName":"狩りの獣","sourceIds":{"bangumi":[{"characterId":"156356","match":"source-roster","subjectId":"435190"}]},"originalCharacterName":"狩りの獣","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ミュラッカは配信前より皆様からの反応が良かったキャラクターで、その人気を維持したまま来れた感じです。本人は若干アホな上に太っていますが、その裏にあるものとの落差もよかったのかもしれません。"}],"source":"bangumi","sourceCharacterId":"156356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b45ac7333c07556b8a4ce308d8f96a1598685b2ed0e06d7500a0fcb8c13654a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e46057f422b135a19b59e9ceaac2b12c58c8cf0ea5adedafc6c3da6238c43d16.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156415","characterName":"停滞の巫女","sourceIds":{"bangumi":[{"characterId":"156415","match":"source-roster","subjectId":"435190"}]},"originalCharacterName":"停滞の巫女","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"キルマは5位となりましたが、ご感想の中で取り上げられる頻度はミュラッカを上回っていました。作中の活躍は少ない方だと思いますが、その中で強い印象を残せたのかもしれません。"}],"source":"bangumi","sourceCharacterId":"156415"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49ad93e3ea285c1440ed4281b00cc6daed9e48cf972162822a2d1c8c41cca303.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b06972aa3bf3980008f002ebe9ea482d7d259b67f2022210fbcd9065d093c66.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156416","characterName":"輪廻の賢者","sourceIds":{"bangumi":[{"characterId":"156416","match":"source-roster","subjectId":"435190"}]},"originalCharacterName":"輪廻の賢者","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"今回の結果で一際目を引くのがタイヴァーです。普段の私の作品にはいない（もとい、登場させたくてもさせにくい）キャラクターなので、その新鮮さが功を奏したのかもしれません。"}],"source":"bangumi","sourceCharacterId":"156416"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf3b6c19d94f36313b00198c60a3f46c903905de86f7dee1396f3f36d003a4b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/930fbc2e6301bd062de5898e0d32db8639094503fb00b5c166cfabc7564812fa.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156417","characterName":"小悪魔","sourceIds":{"bangumi":[{"characterId":"156417","match":"source-roster","subjectId":"435190"}]},"originalCharacterName":"小悪魔","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フィーデはイノと共に旅をする小さな悪魔で、女性です。見た目に反して大人びているものの、小憎たらしく、口も悪く、イノとは正反対の性格をしています。しかし、それでいて二人の相性は悪くありません。彼女は仲間の魔物の一人として戦闘に参加することもできますが、他の魔物ほどの力は持っていないかもしれません……"},{"spoiler":false,"text":"フィーデは『SEQUEL』シリーズでいうところのダイアのような立ち位置で、イノの旅をサポートしつつ盛り上げてくれます。基本的に常に共に行動するため、長い付き合いになるでしょう。"},{"spoiler":false,"text":"なお、フィーデのシーンは実装される予定です。"},{"spoiler":false,"text":"フィーデはメインキャラクターの中で唯一魔物として仲間となり、戦闘に参加します。その性能は残念ながら高いとは言えず他の魔物に負けている点も多々ありますが、それでも特に序盤では頼りになる戦力です。"}],"source":"bangumi","sourceCharacterId":"156417"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fccb6e943cb73c0998a712898136db106182927115cf0886b0221406c429f79d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49fdfc9956455ea5dcd66149f36df6ae550d78862ae1795973e8aa2da7ebbe33.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156418","characterName":"手繰り寄せる者","sourceIds":{"bangumi":[{"characterId":"156418","match":"source-roster","subjectId":"435190"}]},"originalCharacterName":"手繰り寄せる者","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"タハティ・メテオロジアは、前回ご紹介した無地のアイノアに住む魔法使いの女性です。昔からパーラテスにいたようで、この世界とは深い関わりを持つようです。"},{"spoiler":false,"text":"その性格はとても気さくで、初対面のイノにも明るく接し、目的を持たない彼にパーラテスの旅を勧めます。また性に奔放とまでは言いませんが開放的であり、可愛らしい少年であるイノに対してセクシャルなハラスメントを繰り広げることがあります。"},{"spoiler":false,"text":"なお、タハティのシーンは実装される予定です。"}],"source":"bangumi","sourceCharacterId":"156418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14c089109b9176e1cb95b06539a3353a6ec64338b2f112209ac90d4935686f6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1ffbc46ba3dbc9b73882ffb6acdc35b9bbbce2c7c612afc2c55cf12e0e6855d4.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156419","characterName":"冒険者","sourceIds":{"bangumi":[{"characterId":"156419","match":"source-roster","subjectId":"435190"}]},"originalCharacterName":"冒険者","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ルオーラ・ベルルスは前回ご紹介した星の一つ、ロントで出会うことになる冒険者の女性です。非常に友好的かつ協力的な人物で、困っている者を助けようとする意志を持ちます。"},{"spoiler":false,"text":"ルオーラはまさに冒険者というべき気質をしており、自身の冒険を楽しんでいます。そのためイノの旅に同行することはありませんが、旅先で出会ったときは協力し合うこともあるでしょう。"},{"spoiler":false,"text":"なお、ルオーラのシーンは実装される予定です。"}],"source":"bangumi","sourceCharacterId":"156419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29e628ad149daad5c66af6c362863a336bc3b3900690f4b2e64bebc528b4ac9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bab8d972fb75a2cb9ab3fd36c39cec9c8067c69e6a0cdfb36d59fa494a4cdba.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5393","sourceCompanyId":"egs:brand:5393","canonicalEntityId":"egs:brand:5393","name":"リーフジオメトリ","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:34477:5393","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
