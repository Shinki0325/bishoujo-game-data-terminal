sCharacterIds":["25635"],"vndbCharacterId":"c67081"},"originalCharacterName":"葉川 鞠乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の叔母。"},{"spoiler":false,"text":"年齢をまるで感じさせない若々しさと、匂い立つほどの色香を漂わせる妖艶な女性。"},{"spoiler":false,"text":"結婚していたが、夫とは五年前に離婚し、現在は音大に通う娘・玲那と湘南にある自宅で二人で暮らしている。"},{"spoiler":false,"text":"かつては英語教師をしていたらしい。"},{"spoiler":false,"text":"主人公を「健太君」と呼んで優しく接してくれていたが、自分の娘の下着の匂いを嗅いでいた主人公を目撃し、以来、主人公に性的な奉仕を***するようになっていく。"}],"source":"egs","sourceCharacterId":"25635","sourceWorkId":"7532","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は二十代といっても通用するほど若々しく、そばにいるだけでくらくらとしてしまうような妖艶な魅力を持っている。"},{"spoiler":false,"text":"玲那の父親とは、5年前に離婚しており、現在は湘南にある自宅に玲那と二人暮らし。"},{"spoiler":false,"text":"主人公を「健太君」と呼ぶ。"}],"source":"bangumi","sourceCharacterId":"147328"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ac1915422faab0fda15b05385632b37d07ccc27f82bcac55e0115debc5da035.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65189add5aeb62b8a57009af9cd4a4f46e9d1a4208b44b6397aa0786b2f4228f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231696:147328:6131:1","source":"bangumi"}]},{"characterId":"char_c67082","characterName":"葉川 玲那","sourceIds":{"bangumi":[{"characterId":"147329","match":"exact-normalized-name-in-linked-work","subjectId":"231696"}],"egsCharacterIds":["25636"],"vndbCharacterId":"c67082"},"originalCharacterName":"葉川 玲那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の従姉。"},{"spoiler":false,"text":"音大に通う女子大生で、ピアノが得意。"},{"spoiler":false,"text":"妖艶さはないものの、美人の母親に似て、非常に整った顔立ちの美少女。"},{"spoiler":false,"text":"母親が年齢不詳で若く見られることから、姉妹に間違われることもしばしば。"},{"spoiler":false,"text":"主人公を「健ちゃん」と呼んで、自分の弟のように感じていたが、ある日、母と主人公がセックスに興じているところを目撃し、以来、心の奥底であるものが芽生え始める。"}],"source":"egs","sourceCharacterId":"25636","sourceWorkId":"7532","spoiler":false},{"segments":[{"spoiler":false,"text":"ピアノが得意な音楽大学に通う大学生。"},{"spoiler":false,"text":"鞠乃のように妖艶ではないが、顔立ちは母親によく似ている。知らない人には姉妹に見えるほど。"},{"spoiler":false,"text":"主人公を「健ちゃん」と呼び、自分の弟のように感じていたが、ある日、主人公と母・鞠乃の痴態を目撃してしまう。"},{"spoiler":false,"text":"そして、彼女の心の中にあるものが芽生えはじめるのだ"}],"source":"bangumi","sourceCharacterId":"147329"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04e24dbab011e32af3868ce3fd1b6a8ad8d2f0dca7a3da4dd9e1bf3bbfffa5dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42b9d97d3f8271ebc9a4f9264532f958fe481de6b4d6f16894f3b20fa76424e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231696:147329:6106:1","source":"bangumi"}]},{"characterId":"char_c67083","characterName":"小見山 瑞穂","sourceIds":{"bangumi":[],"egsCharacterIds":["25637"],"vndbCharacterId":"c67083"},"originalCharacterName":"小見山 瑞穂","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームだけのオリジナルヒロイン。"},{"spoiler":false,"text":"かつて鞠乃の家の近所に住んでいた、鞠乃と玲那の旧知の女性。"},{"spoiler":false,"text":"現在は、IT関連の会社の女社長として、横浜を一望できるオフィスビルの一室に事務所を構え、辣腕を揮っている。"},{"spoiler":false,"text":"玲那の幼い頃は、よく一緒に遊んでくれていた優しいお姉さん。"},{"spoiler":false,"text":"日本人離れしたグラマラスなボディを持ち、その性格は静と動の二面性を持っている。"},{"spoiler":false,"text":"性的にも奔放で、少々露出癖があり、またショタコンの初物喰いが趣味らしい。"}],"source":"egs","sourceCharacterId":"25637","sourceWorkId":"7532","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aadb346c55860b621ba09d5be12f5b643068bcb8df85e01db2c0c2e9a164634.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fad46d2023751fadb5e320b5a962f508e40ea708ed00d48b9e0722f1df7c9145.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"この かなみ","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34691","source":"vndb"}]},{"characterId":"char_vndb_c156422","characterName":"篠原 健太","sourceIds":{"vndbCharacterId":"c156422"},"originalCharacterName":"篠原 健太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p278","sourceCompanyId":"egs:brand:1435","canonicalEntityId":"vndb:p278","name":"PUZZLEBOX","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:7532:1435","source":"egs"},{"companyId":"vndb:p278","sourceCompanyId":"vndb:p278","canonicalEntityId":"vndb:p278","name":"PUZZLEBOX","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:14200:v6115","so