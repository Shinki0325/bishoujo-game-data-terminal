ns":[{"segments":[{"spoiler":false,"text":"周囲から極悪不良と勘違いされている主人公に対して、初めから優しく接してくれたひとつ年上の先輩。"},{"spoiler":false,"text":"主人公の初恋・片想いの相手だったが、想いを伝える前に本土にある別の学園へと転校してしまった。"},{"spoiler":false,"text":"超の付くお嬢様で、美人だけど気取ったところもなく誰にでも優しい。"},{"spoiler":false,"text":"しかし、ある日の夜。島を見渡せる公園で再会した彼女は、これまでの記憶を失ってまったく別人のようになってしまっていた。"},{"spoiler":false,"text":"「誰がお前になんか頼るものか！ 馬鹿にするな！」"}],"source":"egs","sourceCharacterId":"14263","sourceWorkId":"13247","spoiler":false},{"segments":[{"spoiler":false,"text":"对被周围误解成是坏人的主人公，一开始就能温和地接触的前辈。"},{"spoiler":false,"text":"主人公的初恋兼单恋对象，在他要告白之前转学到别处的学校了。"},{"spoiler":false,"text":"不旦是超有名的大小姐，而且人长得好待人接物也很体面。"},{"spoiler":false,"text":"不过，在一个晚上，在公园遇上归岛的她的时候，她好像对以前的事都忘的一干二净的样子。"}],"source":"bangumi","sourceCharacterId":"12305"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"14263","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"14263","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14263","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"14263","sourceWorkId":"13247","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3df48cbfc106c3bfe8f63553d405f2dd523745fb621b4a6599f877242f27d65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cfe45aa1a74e3227726374f1e07971f25947f98c69558ce7ca219b0bd5a925a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14512:12305:4432:1","source":"bangumi"}]},{"characterId":"char_c14845","characterName":"八嶋 恵","sourceIds":{"bangumi":[{"characterId":"12304","match":"exact-normalized-name-in-linked-work","subjectId":"14512"}],"egsCharacterIds":["14262"],"vndbCharacterId":"c14845"},"originalCharacterName":"八嶋 恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"乙女の実妹で、主人公にとっては義理の姉となる。"},{"spoiler":false,"text":"同じ学年だけれど誕生日が1日早いという理由で、ことあるごとに 「お姉ちゃんに頼れ、甘えろ」 と姉風をふかせてくる。"},{"spoiler":false,"text":"だが、実際は超の付くドジ・不幸体質で主人公に頼りっぱなし・甘えっぱなし。"},{"spoiler":false,"text":"昔は不良に絡まれ揉め事が多かった主人公を守ろうと始めた空手を今でも続けていて、部員が2人しかいない超弱小空手部に所属している。"},{"spoiler":false,"text":"「それなら、お姉ちゃんに任せておいて大丈夫！」"}],"source":"egs","sourceCharacterId":"14262","sourceWorkId":"13247","spoiler":false},{"segments":[{"spoiler":false,"text":"乙女的亲妹妹，也是主人公义理上的姐姐。"},{"spoiler":false,"text":"虽然学年一样，但因为早主人公一天出生，摆出衣服姐姐的架子，口头禅是「交给姐姐吧，尽管向我撒娇好了」，实际上做起事来超笨，而且运气很差，到头来都是要向主人公求救。"},{"spoiler":false,"text":"主人公以前被不良学生包围总是惹出麻烦事的时候，因为想保护他呃开始练空手道，（主人公已经够强了，根本用不着保护！）现在也在积继续，参加了只有两名会员的超弱小空手部。"}],"source":"bangumi","sourceCharacterId":"12304"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"14262","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"14262","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"14262","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"14262","sourceWorkId":"13247","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/881694194d535aef28b8cd9f66f2844b257ca2acf0352c24e186f87032c107e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e631e0efa79f2f42c3f811b3f63a2730901572444017dc52630b9e1379796515.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14512:12304:5900:1","source":"bangumi"}]},{"characterId":"char_c14846","characterName":"喜多村 日和","sourceIds":{"bangumi":[{"characterId":"12306","match":"exact-normalized-name-in-linked-work","subjectId":"14512"}],"egsCharacterIds":["14264"],"vndbCharacterId":"c14846"},"originalCharacterName":"喜多村 日和","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"色々と気遣いのできるクラスの女の子。"},{"spoiler":false,"text":"今里真とふたりで人気校内放送のパーソナリティを務めており、ファンクラブもある。"},{"spoiler":false,"text":"大人しい性格で、読書が好き。"},{"spoiler":false,"text":"でも、頼まれると断ることができない性格が災いして、なぜか空手部に所属している。"},{"spoiler":false,"text":"主人公のことをずっとガラの悪い不良だと勘違いしていたが、今では優しくマジメな主人公を理解してくれる数少ない友達のひとり。"},{"spoiler":false,"text":"「あの！ 今日、一緒にお昼ご飯たべませんか？」"}],"source":"egs","sourceCharacterId":"14264","sourceWorkId":"13247","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公班上的女生，八面玲珑的女孩。"},{"spoiler":false,"text":"和今里真一起作为校内放送的播报员，有着官方粉丝团。"},{"spoiler":false,"text":"性格大方得体，爱好读书。"},{"spoiler":false,"text":"不过因为不懂得如何拒绝人的性格而经常惹麻烦，不知为何参加了空手道部。"},{"spoiler":false,"text":"虽然之前一直误会主人公是个大坏蛋，现在则理解到他是善良又上进的人，成为了他为数不多的真心好友中的一人。"}],"source":"bangumi","sourceCharacterId":"12306"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"14264","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"14264","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"765 cm","valueContext":null,"source":"egs","sourceCharacterId":"14264","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"14264","sourceWorkId":"13247","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1873543c0c499b8da025aaa250c34f4c28adb3181acea0b0aaf48ec3daebc92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de94e25afa719eefcf4467d1fee0b733d8a57a26d70f33baa8f2dc166b62cded.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14512:12306:6016:1","source":"bangumi"}]},{"characterId":"char_c14937","characterName":"下柳 月子","sourceIds":{"bangumi":[{"characterId":"12308","match":"exact-normalized-name-in-linked-work","subjectId":"14512"}],"egsCharacterIds":["14266"],"vndbCharacterId":"c14937"},"originalCharacterName":"下柳 月子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"height":{"reviewState":"no-conflict","source":"vndb","value":"135"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"61"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桃華学園の化学担当の先生。"},{"spoiler":false,"text":"子供にしか見えない低い身長に容姿で、学生たちの間でも、「ちびっ子先生」 として有名。"},{"spoiler":false,"text":"しかし、幼い見た目とは違って冷静沈着・独自の論理を行動規範としていて、子供っぽさは微塵も無い。"},{"spoiler":false,"text":"華奢な身体からは到底考えられない位に強く、空手部の顧問をしている。"},{"spoiler":false,"text":"その強さから、表立って月子先生を 「ちびっこ先生」　と呼ぶ人は居ない。"},{"spoiler":false,"text":"主人公にとっては、幼なじみのお姉ちゃん的存在でもある。"},{"spoiler":false,"text":"「お前は、その目つきで本当に損をしているな。」"}],"source":"egs","sourceCharacterId":"14266","sourceWorkId":"13247","spoiler":false},{"segments":[{"spoiler":false,"text":"桃華学園化学老师。"},{"spoiler":false,"text":"身高和样貌看上去和小孩子没什么区别，在学生之间也被称为「小不点老师」而闻名。"},{"spoiler":false,"text":"但是，和外表相反有着冷静沈着的性格和自己一套独特的行动方式，完全不像是小孩子的行为作风。"},{"spoiler":false,"text":"娇小的身躯却有着强大的力量，空手部的顾问老师。在道场里穿着道服的月子先生没人敢称她做「小不点老师」。"},{"spoiler":false,"text":"对主人公来说她是青梅竹马的姐姐一样的存在。"}],"source":"bangumi","sourceCharacterId":"12308"}],"profileFacts":[{"label":"胸围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"14266","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"135 cm","valueContext":null,"source":"egs","sourceCharacterId":"14266","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"61 cm","valueContext":null,"sourc