:"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大学を卒業したばかりの新米教師。"},{"spoiler":false,"text":"少しの間、他の学園で音楽を教えていたが、おっとりボケボケで泣き虫の上、極度の恥ずかしがり屋という性格から長続きしなかった。"},{"spoiler":false,"text":"そんな情けない自分を変えたく思っていた時、主人公たちの通う学園へと赴任することになった。"},{"spoiler":false,"text":"住む場所にボロで人気のない八嶋荘を希望した変わった人だと思っていると、"},{"spoiler":false,"text":"実は数年前に島から出ていった実兄の婚約者だった！"},{"spoiler":false,"text":"「お姉ちゃん、先生だから。甘えるのは我慢です。」"}],"source":"egs","sourceCharacterId":"14261","sourceWorkId":"13247","spoiler":false},{"segments":[{"spoiler":false,"text":"刚刚在大学毕业的新任教师。"},{"spoiler":false,"text":"不久之前还在其他的学校理担任音乐教师，但因为经常发呆和爱哭的性格，加上超级的害羞所以没有积蓄下来。"},{"spoiler":false,"text":"正当她向改变这样子没出息的自己的时候，突然倍通知分配到了主人公的学校里来了。"},{"spoiler":false,"text":"竟然会自己希望住进破旧又没什么人气的八嶋荘来，本来以为是一个相当古怪的人，原来是几年前离开小岛的亲生哥哥的老婆！"}],"source":"bangumi","sourceCharacterId":"12303"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"14261","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"14261","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"14261","sourceWorkId":"13247","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"14261","sourceWorkId":"13247","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/daa3f01f5843c5f4904a4a0f168467b83e149cba37bde3233c6fa86795c5f84c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23214bce7bec786985f7ea0b143b3ebb87144442b7fff1dcd1bb7ef4826ad55f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"