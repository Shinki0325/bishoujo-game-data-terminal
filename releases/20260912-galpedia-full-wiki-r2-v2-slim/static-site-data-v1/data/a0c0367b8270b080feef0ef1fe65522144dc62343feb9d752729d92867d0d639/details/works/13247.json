mi":[{"characterId":"12302","match":"exact-normalized-name-in-linked-work","subjectId":"14512"}],"egsCharacterIds":["9821"],"vndbCharacterId":"c14838"},"originalCharacterName":"八嶋 乙女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お互いが幼い頃、両親が再婚して家族になった、ひとつ年上の義理のお姉ちゃん。"},{"spoiler":false,"text":"ずっと 「弟」 が欲しいと思っていたらしく、弟となった主人公のことを超溺愛している。"},{"spoiler":false,"text":"なにかあるとすぐに家族のスキンシップと言ってキスしてくる困った人。"},{"spoiler":false,"text":"学園では学生たちに人気で教師からも信頼されている学生会長の優等生。"},{"spoiler":false,"text":"だが、寮では色々とだらしなさ全開で料理、掃除、洗濯、なにをやらせてもダメダメで全て主人公に頼りっぱなしの甘えたお姉ちゃん。"},{"spoiler":false,"text":"「家族だよ。キスなんか当たり前当たり前♪」"}],"source":"egs","sourceCharacterId":"9821","sourceWorkId":"13247","spoiler":false},{"segments":[{"spoiler":false,"text":"お互いが幼い頃、両親が再婚して家族になった、ひとつ年上の義理のお姉ちゃん。"},{"spoiler":false,"text":"ずっと 「弟」 が欲しいと思っていたらしく、弟となった主人公のことを超溺愛している。"},{"spoiler":false,"text":"なにかあるとすぐに家族のスキンシップと言ってキスしてくる困った人。"},{"spoiler":false,"text":"学園では学生たちに人気で教師からも信頼されている学生会長の優等生。"},{"spoiler":false,"text":"だが、寮では色々とだらしなさ全開で料理、掃除、洗濯、なにをやらせてもダメダメで全て主人公に頼りっぱなしの甘えたお姉ちゃん。"}],"source":"egs","sourceCharacterId":"9821","sourceWorkId":"15924","spoiler":false},{"segments":[{"spoiler":false,"text":"在小时候因为彼此之间的双亲再婚而和主人公成为义理的姐弟。"},{"spoiler":false,"text":"因为一直想要个弟弟，所以超级溺爱主人公。"},{"spoiler":false,"text":"一有什么值得高兴的事情就马上来个家人之间的亲密接触，借机亲吻主人公的麻烦人物。"},{"spoiler":false,"text":"在学校的时候是学生的偶像，受老师信赖的学生会长的优等生形象，一回到宿舍就会变成颓废靠不住的姐姐，什么事都离不开主人公。"}],"source":"bangumi","sourceCharacterId":"12302"}],"profile