iler":false,"text":"お調子者で、遅刻や無断欠勤も当たり前のプチ不良だが、根は友達思いの素直でいい男。"},{"spoiler":false,"text":"主人公が怖そうな外見とは裏腹に真面目で優しい男であることを知っている数少ない友人。"},{"spoiler":false,"text":"実の姉である、高階なつみが大の苦手。"},{"spoiler":false,"text":"「優しい姉ちゃんがいてずるいぞ！　うちの姉ちゃんと交換してくれ！」"}],"source":"egs","sourceCharacterId":"14267","sourceWorkId":"13247","spoiler":false},{"segments":[{"spoiler":false,"text":"幼い頃からずっと一緒だった幼馴染。"},{"spoiler":false,"text":"お調子者で、遅刻や無断欠勤も当たり前のプチ不良だが、根は友達思いの素直でいい男。"},{"spoiler":false,"text":"主人公が怖そうな外見とは裏腹に真面目で優しい男であることを知っている数少ない友人。"},{"spoiler":false,"text":"実の姉である、高階なつみが大の苦手。"},{"spoiler":false,"text":"「優しい姉ちゃんがいてずるいぞ！　うちの姉ちゃんと交換してくれ！」"}],"source":"bangumi","sourceCharacterId":"165943"}],"profileFacts":[{"label":"身高（本版本）","value":"173 cm","valueContext":null,"source":"egs","sourceCharacterId":"14267","sourceWorkId":"13247","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6641679e4c6f74105ac6fa760ae37c019ff43504db40af753f2a3477e8c38e5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f959df17162efe67366feb123f62f8e20c0a61d3252d5f8d046fda33aefd0e91.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原祐規","creatorId":"vndb:s239","sourcePersonId":"vndb:s239","canonicalEntityId":"vndb:s239","name":"藤原 祐規","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14512:165943:4844:1","source":"bangumi"}]},{"characterId":"char_c14843","characterName":"高階 なつみ","sourceIds":{"bangumi":[{"characterId":"12301","match":"exact-normalized-name-in-linked-work","subjectId":"14512"}],"egsCharacterIds":["9820"],"vndbCharacterId":"c14843"},"originalCharacterName":"高階 なつみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"b