},{"creditedName":"瑞原 奈緒","creatorId":"vndb:s6707","sourcePersonId":"vndb:s6707","canonicalEntityId":"vndb:s6707","name":"瑞原 奈緒","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:42593","source":"vndb"}]},"cast":[{"characterId":"char_c6024","characterName":"リシェル・バーンズ","sourceIds":{"bangumi":[{"characterId":"50264","match":"exact-normalized-name-in-linked-work","subjectId":"17739"}],"egsCharacterIds":["15205"],"vndbCharacterId":"c6024"},"originalCharacterName":"リシェル・バーンズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1107"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在原学園二年生。"},{"spoiler":false,"text":"魔法使いの名門であるバーンズ家の次期当主。"},{"spoiler":false,"text":"幼い頃から魔法使いとしての非凡な才能を発揮し、将来を期待されていた。"},{"spoiler":false,"text":"性格は強気で自信過剰、加えて極度の負けず嫌い。"},{"spoiler":false,"text":"攻撃系の魔法は大得意で、その非凡さの一端を示すが、他がダメダメ。"},{"spoiler":false,"text":"比較されることが多い同じく魔法使い名家・アーシュベルクの娘・エルトリンデは、総合力が高く、魔法勝負を何度か繰り返しているが、一度も勝った試しがない。"},{"spoiler":false,"text":"「エルトリンデ、覚悟しなさい。ヘルムスがいればあんたなんかに絶対に負けないんだから！」"}],"source":"egs","sourceCharacterId":"15205","sourceWorkId":"12577","spoiler":false},{"segments":[{"spoiler":false,"text":"エルトリンデを追いかけてやってきた魔法使い。主人公の家におしかけで同居することになる。"},{"spoiler":false,"text":"魔法使いの間でも一目置かれる名門・バーンズ家の次期当主。"},{"spoiler":false,"text":"幼い頃から魔法の才能を如何なく発揮し、周囲からは同い年で、同じく名家のエルトリンデとなにかと比較されてきた。"},{"spoiler":false,"text":"魔法勝負では現在に至るまで一度もエルトリンデに勝てたことがない。"},{"spoiler":false,"text":"強気で自信過剰だが、本当は弱い自分を隠すための裏返し。極度の負けず嫌いで、自称ライバルのエルトリンデに対しては特に敵意剥き出しにしている。"},{"spoiler":false,"text":"「エルトリンデ、覚悟しなさい。ヘルムスがいればあんたなんかに絶対に負けないんだから！ あれ、奈乃……？」"}],"source":"bangumi","sourceCharacterId":"50264"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50264","value":"2年生"},{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"15205","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"15205","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"15205","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"15205","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"15205","sourceWorkId":"12577","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1107","source":"vndb","sourceCharacterId":"c6024","value":"1107"},{"comparisonValue":"1107","source":"egs","sourceCharacterId":"15205","value":"11/7"},{"comparisonValue":"0117","source":"bangumi","sourceCharacterId":"50264","value":"11月7日（蠍座）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cabac14252d1f597d9c50f947ba0c586ea707d4d8298438d8e72db65e404a5de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99bcb9c4a83ec1af82db8b0becf08aa2303aa4e1a969cc72dc15a678c9778ef9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17739:50264:4810:1","source":"bangumi"}]},{"characterId":"char_c6025","characterName":"エルトリンデ・アーシュベルク","sourceIds":{"bangumi":[{"characterId":"50265","match":"exact-normalized-name-in-linked-work","subjectId":"17739"}],"egsCharacterIds":["15206"],"vndbCharacterId":"c6025"},"originalCharacterName":"エルトリンデ・アーシュベルク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"225"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在原学園一年生。"},{"spoiler":false,"text":"代々続く魔法使いの名家の一人娘で、両親も高名な魔法使いだったというサラブレッド。"},{"spoiler":false,"text":"魔法使いとしての技量は既に一流の域に達し、全ての面で高いレベルの実力を見せる。"},{"spoiler":false,"text":"性格は誇り高く、人に自分を見透かされることを嫌う。強情でもあり、本音を口にすることが苦手。"},{"spoiler":false,"text":"緻密な計算と、冷静な観察眼を持ち、それに基づいてマイペースに物事を進め、行動するタイプ。しかし、計算外のことが起こると、アタフタし、さらに慎重になってしまう。"},{"spoiler":false,"text":"「エルトリンデ・アーシュベルクと申します。以後、お見知りおきを」"}],"source":"egs","sourceCharacterId":"15206","sourceWorkId":"12577","spoiler":false},{"segments":[{"spoiler":false,"text":"御神木の前で出会った不思議な銀髪の少女。"},{"spoiler":false,"text":"代々続く魔法使いの名家の一人娘で、両親も高名な魔法使いだったというサラブレッド。"},{"spoiler":false,"text":"魔法使いとしての技量はすでに一流の域で、全ての面で高レベルにまとまった実力を持っている。"},{"spoiler":false,"text":"魔法に限らず、緻密な計算と冷静な観察力に基づいた自分のペースで物事を進めていくのを得意としているが、その反面、突発的なことの対処に関しては、判断力自体は悪くないのだが非常に慎重な対応を取ってしまうため、受身に回ることも多い。"},{"spoiler":false,"text":"真面目かつ几帳面で、自分が一度決めたことは曲げずに邁進する意志の強さを持ち、そのためには努力も厭わない天才肌の努力家。"},{"spoiler":false,"text":"ただ自分で何とかしようとするあまり、周りが見えなくなる熱いところも。"},{"spoiler":false,"text":"人見知りはしないが、あまり自分から積極的に他人と関わることもしない。"},{"spoiler":false,"text":"ただし一度心を許した相手にはかなりべったりになることも……。根は寂しがり屋。"},{"spoiler":false,"text":"「エルトリンデ・アーシュベルクよ。よろしく」"}],"source":"bangumi","sourceCharacterId":"50265"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50265","value":"2年生"},{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"15206","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"15206","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"15206","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"15206","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"15206","sourceWorkId":"12577","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a12fd7213b1d2555dab2ec81bf2febcc363402b2e03c7462d279f12416a6f8ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/726a802b56295a79635e0b41e87d1358904d9f582865ec7c6ec694144206e1b1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17739:50265:6018:1","source":"bangumi"}]},{"characterId":"char_c6026","characterName":"倉瀬 秋奈","sourceIds":{"bangumi":[{"characterId":"50266","match":"exact-normalized-name-in-linked-work","subjectId":"17739"}],"egsCharacterIds":["15207"],"vndbCharacterId":"c6026"},"originalCharacterName":"倉瀬 秋奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1019"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在原学園三年生。"},{"spoiler":false,"text":"主人公とは家族ぐるみの付き合いのある幼馴染。"},{"spoiler":false,"text":"幼い頃から主人公一筋で、周囲から「許嫁」とからかわれたりしているが、それを満更でもないと思っている。"},{"spoiler":false,"text":"ふんわりとしていて優しく母性を感じさせてくれる、活発で優しい女の子。"},{"spoiler":false,"text":"周囲への気配りも自然に行えるしっかり者。ややうっかりさんなところも。"},{"spoiler":false,"text":"そんな彼女には魔法の能力が……!?"},{"spoiler":false,"text":"「ねぇねぇ広くん、今晩の鬼○犯科帳一緒にみようね♪」"}],"source":"egs","sourceCharacterId":"15207","sourceWorkId":"12577","spoiler":false},{"segments":[{"spoiler":false,"text":"年上の幼なじみ。主人公の家と秋奈の家とは家族ぐるみの付き合い。"},{"spoiler":false,"text":"幼少の頃から主人公一筋。主人公の母親から許嫁と冗談で言われることにも満更ではなく、両親が不在である主人公の世話役にもやる気十分。"},{"spoiler":false,"text":"優しくふんわり、母性を感じるタイプ。"},{"spoiler":false,"text":"しっかり者で気配りもでき、活発さも持ち合わせた完璧っぷり。しかし相当なうっかり者。"},{"spoiler":false,"text":"胸元の開いた服で隠しもせずしゃがんだりと、致命的にガードが緩く無意識のうちに主人公を勝手にドキドキさせている。"},{"spoiler":false,"text":"「むー。……ひろくん、おなかすいたの？ あ、じゃあホットケーキ焼いてあげようか」"}],"source":"bangumi","sourceCharacterId":"50266"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50266","value":"3年生"},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"15207","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"15207","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext