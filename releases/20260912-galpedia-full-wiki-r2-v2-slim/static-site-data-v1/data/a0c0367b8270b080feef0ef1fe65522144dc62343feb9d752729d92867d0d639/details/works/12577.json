:[{"spoiler":false,"text":"在原学園一年生。"},{"spoiler":false,"text":"両親が世界中を飛び回っている医者で、そのため両親の不在が多く、家政婦さん付きの豪邸に一人で暮らしている。"},{"spoiler":false,"text":"性格は内気で大人しく、非常に真面目。"},{"spoiler":false,"text":"常に冷静であろうとしているが、テンパッてしまうと収拾がつかなくなって、普段のとは違った威勢の良い彼女が顔を覗かせる。"},{"spoiler":false,"text":"片想いの主人公に対してもモジモジだったが、エルトリンデの魔法の後押しによって、彼女の中で大きな変化が……。"},{"spoiler":false,"text":"「いえっ、そんな事ないですないです、すっごく元気です！　そ、それじゃあ失礼します！　おいっすです！」"}],"source":"egs","sourceCharacterId":"15208","sourceWorkId":"12577","spoiler":false},{"segments":[{"spoiler":false,"text":"一つ年下の後輩。主人公と同じ風紀委員に所属している。"},{"spoiler":false,"text":"両親は医者で世界中を飛び回っており、彼女は家政婦さん付きの豪邸に一人で暮らしている。"},{"spoiler":false,"text":"従順真面目で大人しい性格の反面、両親不在の孤独を押し隠すように生きてきた女の子。"},{"spoiler":false,"text":"テンパると大抵収拾がつかなくなり、一番の爆弾キャラに豹変する。"},{"spoiler":false,"text":"恋する主人公に対して一歩踏み出せないところを、エルトリンデの魔法が後押しして彼女の中に変化が……？"},{"spoiler":false,"text":"「いえっ、そんな事ないですないです、すっごく元気です！ そ、それでは、その……失礼します！」"}],"source":"bangumi","sourceCharacterId":"50267"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"50267","value":"1年生"},{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"15208","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"15208","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"15208","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"15208","sourceWorkId":"12577","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"15208","sourceWorkId":"12577","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38d6a0a5d827ba651ab4a38026deb9af19e363fe0a23948e55f571c