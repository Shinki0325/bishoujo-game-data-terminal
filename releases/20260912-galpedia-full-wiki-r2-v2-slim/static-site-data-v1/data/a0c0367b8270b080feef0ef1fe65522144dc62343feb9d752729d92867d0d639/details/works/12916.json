,"canonicalEntityId":"vndb:s4356","name":"UNO","detail":"プログラム","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:186684","source":"egs"},{"creditedName":"もちひろ","creatorId":"egs:creator:30877","sourcePersonId":"egs:creator:30877","canonicalEntityId":"egs:creator:30877","name":"もちひろ","detail":"ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:186685","source":"egs"},{"creditedName":"藤井 純生","creatorId":"vndb:s3631","sourcePersonId":"vndb:s3631","canonicalEntityId":"vndb:s3631","name":"藤井 純生","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:36116","source":"vndb"}]},"cast":[{"characterId":"char_c24254","characterName":"結城 明香里","sourceIds":{"bangumi":[{"characterId":"144220","match":"exact-normalized-name-in-linked-work","subjectId":"465770"}],"egsCharacterIds":["14633"],"vndbCharacterId":"c24254"},"originalCharacterName":"結城 明香里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。兄と同じ学園に通う一年生。水泳部に所属。"},{"spoiler":false,"text":"明朗快活な性格で、男女ともに人気がある。"},{"spoiler":false,"text":"学園では多少ネコを被っているが、家に帰るとガサツな面が顔を覗かせる。"},{"spoiler":false,"text":"兄の親友・吉崎康介の妹・綾音とは、兄と同じく幼少の頃からの親友同士。"},{"spoiler":false,"text":"兄に密かに想っているが、素直になれず、気持ちとは逆の行動をとりがち。"},{"spoiler":false,"text":"今回の妹交換も、少しでも兄がやきもちを焼いてくれればと承諾するが……。"}],"source":"egs","sourceCharacterId":"14633","sourceWorkId":"12916","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公である孝道の妹で、兄と同じ学園に通う1年生。"},{"spoiler":false,"text":"水泳部に所属し、明朗快活な性格から男女問わず人気がある。"},{"spoiler":false,"text":"綾音とは、幼少の頃からの親友同士で、内気な彼女をいつも明香里が引っ張りまわしていた。"},{"spoiler":false,"text":"心密かに兄のことを想っているが、気持ちとは逆の行動をとってしまうことが多い。"},{"spoiler":false,"text":"妹を交換するという康介の提案を、兄が少しでも自分を心配したりやきもちを焼いてくれれば……と承諾するのだが。"},{"spoiler":false,"text":"普通の兄妹以上に親密な関係に見える吉崎兄妹に憧れ、孝道も自分にそのように接してくれれば……と、心密かに願っている。"}],"source":"bangumi","sourceCharacterId":"144220"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"14633","sourceWorkId":"12916","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"14633","sourceWorkId":"12916","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"14633","sourceWorkId":"12916","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"14633","sourceWorkId":"12916","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e99939fd884d5094f677f42073aad8ae739797a76764b47bb1126501faa8004b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d565735128e963517fe772f2dfcc094dca3a5ada44ee79b73de619ab9678c2d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:465770:144220:6509:1","source":"bangumi"}]},{"characterId":"char_c24255","characterName":"吉崎 綾音","sourceIds":{"bangumi":[{"characterId":"144222","match":"exact-normalized-name-in-linked-work","subjectId":"465770"}],"egsCharacterIds":["14634"],"vndbCharacterId":"c24255"},"originalCharacterName":"吉崎 綾音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明香里の親友で、主人公の親友・康介の妹。明香里や主人公と同じ学園に通う一年生。"},{"spoiler":false,"text":"人付き合いが苦手でクラブ活動はしていない。"},{"spoiler":false,"text":"口数が少なく、内気で物静かな性格。男性に免疫がなく、兄の康介と主人公以外には心を開いていない。"},{"spoiler":false,"text":"思ったことを行動に移せる明香里を羨ましく思っており、またそんな破天荒な明香里をフォローする主人公を密かに想っている。"}],"source":"egs","sourceCharacterId":"14634","sourceWorkId":"12916","spoiler":false},{"segments":[{"spoiler":false,"text":"明香里の親友で、主人公の親友である康介の妹。"},{"spoiler":false,"text":"明香里や主人公と同じ学園に通う1年生だが、人付き合いが苦手なためかクラブ活動はしていない。"},{"spoiler":false,"text":"内気で口数が少なく男性に対する免疫が皆無な彼女だが、兄の康介と主人公である孝道にだけは心を開いている。"},{"spoiler":false,"text":"思ったことを率直に口にしたり行動に移せる明香里をうらやましく思い、またそんな明香里の言動を正面から受け止めたりフォローしている主人公を密かに慕っている。"},{"spoiler":false,"text":"兄の康介を「兄（にい）さま」と呼ぶ。"}],"source":"bangumi","sourceCharacterId":"144222"}],"profileFacts":[{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"14634","sourceWorkId":"12916","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"14634","sourceWorkId":"12916","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"14634","sourceWorkId":"12916","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"14634","sourceWorkId":"12916","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wi