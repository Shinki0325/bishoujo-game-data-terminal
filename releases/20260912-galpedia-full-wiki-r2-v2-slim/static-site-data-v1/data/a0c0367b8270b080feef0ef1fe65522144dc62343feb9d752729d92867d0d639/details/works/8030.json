acts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c2399","characterName":"黒崎 恵留","sourceIds":{"vndbCharacterId":"c2399"},"originalCharacterName":"黒崎 恵留","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eru is a grade below Hideaki, and acts like his younger sister. Whenever his parents are not home, Eru, who lives in the same neighborhood, comes over to perform domestic chores like cooking and cleaning. She has an obedient and generally quiet personality, but likes to joke with her friends. She is close friends with Minori, who is the same age as her."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c2399"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/633ef0bb46e0fbb63477d390a1ac752c57aae3735f01aa58d113f5b744182929.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73940cc13c8f4e3cfa8e49fcfca45defe6ff45f29cd5ac987b89a69fd547cc4a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2047","source":"vndb"}]},{"characterId":"char_vndb_c2401","characterName":"藤木 咲乃","sourceIds":{"vndbCharacterId":"c2401"},"originalCharacterName":"藤木 咲乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sakino is Hideaki's friend, and another one of his classmates. She is childhood friends with Madoka, and is very close with her. She has a serious personality, wears glasses, and constantly tries to get Madoka to settle down and do her work. Sakino dislikes physical exercise, unlike Madoka. She sometimes is a shy person, but is able to become more sociable, though still generally dislikes speaking to others. This gives her a gloomy appearance, but she is just constantly thinking about things."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c2401"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a99f812f1bfd5b21d4e9e9e4314f4c3d62266b10430ae5a8dfeaa1071fba1510.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2f0d3ee467d0d88fe53ad88fb0aad4507699d001a5507cc2c2baf6a73030ede.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせ ひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2050","source":"vndb"}]},{"characterId":"char_vndb_c2403","characterName":"前原 羽弥","sourceIds":{"vndbCharacterId":"c2403"},"originalChara