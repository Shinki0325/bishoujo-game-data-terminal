Id":"41825"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"8394","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"8394","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"8394","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"8394","sourceWorkId":"23572","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c20e5f15505ef4072768b6e9a62c149606153cb837726bbfb677fc93bcb4b3ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c71b25bec808d5073c107071818865e4e6333276954c33ccee63b690102a28c5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178552:41825:10662:1","source":"bangumi"}]},{"characterId":"char_c45931","characterName":"一ノ瀬 伊織","sourceIds":{"bangumi":[{"characterId":"41824","match":"exact-normalized-name-in-linked-work","subjectId":"178552"}],"egsCharacterIds":["8392"],"vndbCharacterId":"c45931"},"originalCharacterName":"一ノ瀬 伊織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学生会と、部員が2名しかいない料理部に所属するニ年生。"},{"spoiler":false,"text":"秀一の特技を活かすために、学生会の力を使って料理部を作る。"},{"spoiler":false,"text":"成績優秀、容姿端麗を絵に描いたような会長と校内でも有名。"},{"spoiler":false,"text":"絵に描いたような会クールビューティーだが、話すと優しいと男女ともにファンが多い。"},{"spoiler":false,"text":"実はわりとポンコツで、家事全般はまるでダメ。"},{"spoiler":false,"text":"料理部所属なのに料理の腕は上がる気配が全くない。"},{"spoiler":false,"text":"基本ヤキモチヤキな性格。何かに対して急に熱血になる事があるが、大半は空回で終わってしまうやはり少し残念な子。"},{"spoiler":false,"text":"秀一に対する感情を指摘されると、あわあわと慌てて否定しまうため、なかなか秀一との仲が進展できないでいた。"},{"spoiler":false,"text":"意を決して秀一に告白するも、なぜかセックスをしてしまう事に。"}],"source":"egs","sourceCharacterId":"8392","sourceWorkId":"23572","spoiler":false},{"segments":[{"spoiler":false,"text":"学生会の会長であり、部員が 2名しかいない料理部に所属する 2年生。"},{"spoiler":false,"text":"成績優秀で絵に描いたようなクールビューティーだが、話すと優しいと男女ともにファンが多い。"},{"spoiler":false,"text":"実はわりとポンコツで、家事全般はまるでダメ。"},{"spoiler":false,"text":"またヤキモチ焼きな性格で、急に熱血になることもあるが大半は空回りする残念な子。"},{"spoiler":false,"text":"秀一の特技を活かすために、学生会の力を使って料理部を作った。"},{"spoiler":false,"text":"料理部所属なのに料理の腕は上がる気配がまったくない。"},{"spoiler":false,"text":"秀一に対する感情を指摘されると あわあわと慌てて否定しまうため、なかなか秀一との仲が進展できないでいた。"},{"spoiler":false,"text":"そして意を決して秀一に告白するも、なぜかセックスをしてしまうことに。"}],"source":"bangumi","sourceCharacterId":"41824"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"8392","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"8392","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"8392","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"8392","sourceWorkId":"23572","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29996c7505a12a67ed952b29f4e9adf98d697220b8a396a9928f1af7ccc831c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8838aa5a31ae33ed3a20721eb987b685ec8470d7d486a20f57139672a9f955e6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178552:41824:5928:1","source":"bangumi"}]},{"characterId":"char_c45932","characterName":"舞原 まゆこ","sourceIds":{"bangumi":[{"characterId":"41826","match":"exact-normalized-name-in-linked-work","subjectId":"178552"}],"egsCharacterIds":["8395"],"vndbCharacterId":"c45932"},"originalCharacterName":"舞原 まゆこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秀一・伊織と同時に料理部の顧問。"},{"spoiler":false,"text":"明るく社交的であり学生と年齢も近いせいか、学生の悩みを聞く良き相談相手になっているが、恋愛関係の悩みに関しては口を濁す。"},{"spoiler":false,"text":"恋愛を謳歌している学生を見ると、「青春……、若いって良いわね……」 とつぶやいてしまう。"},{"spoiler":false,"text":"プライベートでは、ズボラな性格で、料理部顧問であるが料理はてんでダメ、まるでダメ。しかし伊織ほどではない。"},{"spoiler":false,"text":"男運が悪く、デート初日で別れる率がほぼ100％で、もちろん処女。"},{"spoiler":false,"text":"大好きなお酒が入るととってもダメになり、クダを撒いて周りに絡んでしまう。秀一はひょんなことからこの干物女の酒癖の餌食になってしまう。"}],"source":"egs","sourceCharacterId":"8395","sourceWorkId":"23572","spoiler":false},{"segments":[{"spoiler":false,"text":"秀一や伊織の担任であり、料理部の顧問も務めている先生。"},{"spoiler":false,"text":"明るく社交的で、年齢も近いせいか学生の悩みを聞く良き相談相手になっている。"},{"spoiler":false,"text":"しかし、恋愛関係の悩みに関しては口を濁す。"},{"spoiler":false,"text":"恋愛を謳歌している学生を見ると、「青春……、若いって良いわね……」 とつぶやいてしまう。"},{"spoiler":false,"text":"プライベートではズボラな性格で、料理部顧問だが料理はてんでダメ。 しかし伊織ほどではない。"},{"spoiler":false,"text":"男運も悪く、デート初日で別れる率がほぼ 100％。 もちろん処女。"},{"spoiler":false,"text":"大好きなお酒が入るととってもダメになり、クダを撒いて周りに絡んでしまう。"},{"spoiler":false,"text":"秀一はひょんなことから、この干物女の酒癖の餌食になってしまう。"}],"source":"bangumi","sourceCharacterId":"41826"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8395","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"8395","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"8395","sourceWorkId":"23572","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"8395","sourceWorkId":"23572","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da4e57d4b9acbde48d9964f9e4bac59566abc070498b56ef2b2e5fe432221003.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/812a9402667c8b5c86b5b04749b0dae2759580ec2227c1a109637f3b05fdffe7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178552:41826:6019:1","source":"bangumi"}]},{"characterId":"char_vndb_c46582","characterName":"蒼葉 秀一","sourceIds":{"vndbCharacterId":"c46582"},"originalCharacterName":"蒼葉 秀一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityS