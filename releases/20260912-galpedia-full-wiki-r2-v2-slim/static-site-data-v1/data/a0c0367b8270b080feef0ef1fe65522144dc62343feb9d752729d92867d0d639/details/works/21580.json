{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21580","model":{"presentationWorkId":"vndb:v4141","staff":{"artwork":[{"creditedName":"スミスミ","creatorId":"vndb:s7028","sourcePersonId":"vndb:s7028","canonicalEntityId":"vndb:s7028","name":"スミスミ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:47870","source":"vndb"}],"scenario":[{"creditedName":"高橋 直樹","creatorId":"vndb:s2917","sourcePersonId":"vndb:s2917","canonicalEntityId":"vndb:s2917","name":"高橋直樹(NTak_indies、NTak_hobby)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:47869","source":"vndb"},{"creditedName":"しだれ 桜","creatorId":"vndb:s8729","sourcePersonId":"vndb:s8729","canonicalEntityId":"vndb:s8729","name":"しだれ 桜","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:47871","source":"vndb"},{"creditedName":"月野 影也","creatorId":"vndb:s8732","sourcePersonId":"vndb:s8732","canonicalEntityId":"vndb:s8732","name":"月野 影也","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:47872","source":"vndb"}],"music":[{"creditedName":"仲本オーケストラ","creatorId":"vndb:s3584","sourcePersonId":"vndb:s3584","canonicalEntityId":"vndb:s3584","name":"西野 尚利","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:47873","source":"vndb"}],"other":[{"creditedName":"阿部四百(400、阿部400)","creatorId":"vndb:s3914","sourcePersonId":"egs:creator:15433","canonicalEntityId":"vndb:s3914","name":"阿部四百(400、阿部400","detail":"彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167716","source":"egs"}]},"cast":[{"characterId":"char_c52935","characterName":"高岡 幻夢","sourceIds":{"bangumi":[{"characterId":"153091","match":"exact-normalized-name-in-linked-work","subjectId":"187612"}],"egsCharacterIds":["9971"],"vndbCharacterId":"c52935"},"originalCharacterName":"高岡 幻夢","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公たちが通う学園の養護教諭（保健医）。"},{"spoiler":false,"text":"女子生徒たちの相談や、カウンセリングも行っている。"},{"spoiler":false,"text":"彼女は思春期の女の子たちを淫夢に引きずり込む謎の存在であり、異常性欲に悩み相談に訪れた主人公を淫靡な快楽の世界へと誘う。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"4962","spoiler":false},{"segments":[{"spoiler":false,"text":"正体は淫魔。学園に転校してくるが外見はかなり幼い。"},{"spoiler":false,"text":"過去の失敗により魔力を失い、少女の様な外見に自分を固定する事で魔力の消費を抑えている。"},{"spoiler":false,"text":"卵を2人に与え、互いに競わせる事で魔力を吸収し復活しようと企む。"},{"spoiler":false,"text":"魔力の収集を目的としており、何らかの取り立てに追われているようだが、魔力収集ノルマを果たせずに微妙にワープア化している。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"14026","spoiler":false},{"segments":[{"spoiler":false,"text":"特定の嗜好な方々に好まれるような体型を強いられ、ワープア、貧乏一直線。"},{"spoiler":false,"text":"知り合いのツテでネットショップを運営中。"},{"spoiler":false,"text":"不慣れな仕事でのミスの結果、蒔絵と出会い彼女の『妄想の世界』を利用しようと画策する。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"15559","spoiler":false},{"segments":[{"spoiler":false,"text":"『侵蝕』シリーズに登場する淫魔。 外見上はシリーズ最年少に。"},{"spoiler":false,"text":"三姉妹を巻き込んで、遺跡の魔力を回収しようと企んでいる。"},{"spoiler":false,"text":"迷宮の水先案内人を装い、ヒロインたちを騙して誘導したりもする。"}],"source":"bangumi","sourceCharacterId":"153091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76df2e6ab2fcbca767bc649b4598cd067bdd73b23a46d1d5e13242b255abde70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cebc304ee99ccf80c4bec71ca1791e68178026127d16c281783bd4ae54b52fe.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"比未子","creatorId":"vndb:s1499","sourcePersonId":"vndb:s1499","canonicalEntityId":"vndb:s1499","name":"比未子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26488","source":"vndb"}]},{"characterId":"char_c52936","characterName":"槙村 千紗","sourceIds":{"bangumi":[{"characterId":"153336","match":"exact-normalized-name-in-linked-work","subjectId":"396986"}],"egsCharacterIds":["19343"],"vndbCharacterId":"c52936"},"originalCharacterName":"槙村 千紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本が大好きでちょっぴり内気な少女。"},{"spoiler":false,"text":"図書委員のリーダー・朱鷺坂によくいじられている。"},{"spoiler":false,"text":"将来は絵本作家になりたいようだが、その作風はかなりシュールで、子供が見たら泣きだしそうなモノが多い。"}],"source":"egs","sourceCharacterId":"19343","sourceWorkId":"9804","spoiler":false},{"segments":[{"spoiler":false,"text":"ちょっと内気で本好き。"},{"spoiler":false,"text":"そこをよく朱鷺坂先輩にいじられている。"},{"spoiler":false,"text":"将来絵本作家になりたいようだが、"},{"spoiler":false,"text":"その作風は…"}],"source":"bangumi","sourceCharacterId":"153336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3b3a6346e8d57fd049ec6c44580203c1c3e5ac772967eb134c46abc4f0d5da4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b19a85c8d5761fc6cde224d72b2ba691849ebd8d22afb088b9e77b11167c3c7d.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:396986:153336:18086:1","source":"bangumi"}]},{"characterId":"char_c52937","characterName":"秋沢 くるみ","sourceIds":{"bangumi":[{"characterId":"153337","match":"exact-normalized-name-in-linked-work","subjectId":"396986"}],"egsCharacterI