:[{"segments":[{"spoiler":false,"text":"【恥ずかしすぎて素直な気持ちを表せない幼馴染】"},{"spoiler":false,"text":"つぐみ本人は否定しているが主人公との仲は両親公認。"},{"spoiler":false,"text":"他人の問題にかまけて自分自身のことを二の次に考える、そんな主人公を支えられるのは自分しかいないと思っている。"},{"spoiler":false,"text":"昔は主人公に対して素直に好意をあらわせていたが、ある時その仲を揶揄されてから恥ずかしくなってしまって以来、ツンケンな態度をとってしまうようになった。"},{"spoiler":false,"text":"極度のあがり症で注目されると動けなくなってしまう。"},{"spoiler":false,"text":"陸上部に所属しており短距離のタイムはなかなか。"},{"spoiler":false,"text":"残念ながら、あがり症のため大会には出場していない。"}],"source":"egs","sourceCharacterId":"895","sourceWorkId":"14293","spoiler":false},{"segments":[{"spoiler":false,"text":"つぐみ本人は否定しているが、主人公との仲は両親公認。"},{"spoiler":false,"text":"他人の問題にかまけて自分自身のことを二の次に考える、そんな主人公を支えられるのは自分しかいないと思っている。"},{"spoiler":false,"text":"昔は主人公に対して素直に好意を表せていたが、ある時その仲を揶揄されてから恥ずかしくなってしまい、以来ツンケンな態度をとってしまうようになった。"},{"spoiler":false,"text":"極度のあがり症で、注目されると動けなくなってしまう。"},{"spoiler":false,"text":"陸上部に所属しており短距離のタイムはなかなか。残念ながら、あがり症のため大会には出場していない。"}],"source":"bangumi","sourceCharacterId":"93619"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34fa5c92c62cf559decdea24aef4cabeed87a1347335e0fc4252ceccb1581bd1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12cb72495b0d001bd213f1f4f46ea5fd6ce1b7dca062480dc529d60041f8b1ae.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:38250:93619:4956:1","source":"bangumi"}]},{"characterId":"char_c6783","characterName":"天堂 千鶴","sourceIds":{"bangumi":[{"characterId":"93620","match":"exact-normalized-name-in-linked-work","subjectId":"38250"}],"egsCharacterIds":["896"],"vndbCharacterId":"c6783"},"originalCharacterName":"天堂 千鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【人に頼ることに不慣れなツンデレお嬢様】"},{"spoiler":false,"text":"クラス委員長をしつつ学生会にも所属している。"},{"spoiler":false,"text":"プライドが高くタカビーな面もあるが傲慢ではなく、人づき合いを心得ている。"},{"spoiler":false,"text":"そのため学園での人気も高く特に女子の間にはファンクラブまであるほど。"},{"spoiler":false,"text":"他人に頼ることを善しとしない完璧主義者なため、クラスの仕事と学生会の仕事を受け持っていたが、ある日クラスの仕事を主人公が肩代わりして済ませてしまう。"},{"spoiler":false,"text":"その時は「余計なことを」と罵倒したが、"},{"spoiler":false,"text":"以降も影ながら千鶴の仕事を助けてくれている主人公を頼りにしている自分に気づき戸惑いを抱いていく……"}],"source":"egs","sourceCharacterId":"896","sourceWorkId":"14293","spoiler":false},{"segments":[{"spoiler":false,"text":"クラス委員長をしつつ学生会にも所属している。"},{"spoiler":false,"text":"プライドが高くタカビーな面もあるが傲慢ではなく、人付き合いを心得ている。そのため学園での人気も高く、特に女子の間にはファンクラブまであるほど。"},{"spoiler":false,"text":"他人に頼ることを善しとしない完璧主義者なため、クラスの仕事と学生会の仕事を受け持っていたが、ある日クラスの仕事を主人公が肩代わりして済ませてしまう。"},{"spoiler":false,"text":"その時は 「余計なことを」 と罵倒したが、以降も影ながら千鶴の仕事を助けてくれている主人公を頼りにしている自分に気付き、戸惑いを抱いていく……"}],"source":"bangumi","sourceCharacterId":"93620"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd9f963f225c10c0743feff3c2d67a2e2fdd2f50602a31a61e58ced688ee4fe0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13add6e9a6c8a998eee420305bcc6d37d933401709c8426ddc0b4678c35d97b8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:38250:93620:5741:1","source":"bangumi"}]},{"characterId":"char_c6784","characterName":"野々山 琴子","sourceIds":{"bangumi":[{"characterId":"93621","match":"exact-normalized-name-in-linked-work","subjectId":"38250"}],"egsCharacterIds":["897"]