tus":"auto-confirmed","relationId":"bangumi:character-voice:224226:164700:4675:1","source":"bangumi"}]},{"characterId":"char_c83173","characterName":"奥寺 泉","sourceIds":{"bangumi":[{"characterId":"164701","match":"exact-normalized-name-in-linked-work","subjectId":"224226"}],"egsCharacterIds":["24555"],"vndbCharacterId":"c83173"},"originalCharacterName":"奥寺 泉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"女子の学級委員を務め、クラスの中心的な存在。"},{"spoiler":false,"text":"真面目な性格で、クラスメイトが悪さをすると、しっかり注意する。"},{"spoiler":false,"text":"ややヒステリックな性格。"},{"spoiler":false,"text":"主人公に密かに恋心を抱いているが、告白できずにいる。"},{"spoiler":false,"text":"学園の養護教諭・南條円は実姉。"},{"spoiler":false,"text":"その円と主人公が親しげに接していると、ヤキモチを焼く。"}],"source":"egs","sourceCharacterId":"24555","sourceWorkId":"8463","spoiler":false},{"segments":[{"spoiler":false,"text":"誠のクラスメイト。"},{"spoiler":false,"text":"女子の学級委員でクラスの中心的存在。"},{"spoiler":false,"text":"哲太が掃除をサボったり、悪さをする度に怒っている。"},{"spoiler":false,"text":"少々ヒステリックなところも。"},{"spoiler":false,"text":"誠に想いを寄せているが、そのことを隠している。"},{"spoiler":false,"text":"しかし周囲には結構知られている。"},{"spoiler":false,"text":"冷やかされると、ムキになって否定する。"},{"spoiler":false,"text":"学園の保険医でもある姉の円が誠と親しげに接していると、ヤキモチを焼く。"}],"source":"bangumi","sourceCharacterId":"164701"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d02b9c20a40c929a3f24c60c6ab78e936cb669fe7d903165a94626bc46176a76.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09feeb47db3f62ba8a1c4ccf02d11cee244c1631fabf9c1c187236237ccad4f4.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224226:164701:4490:1","source":"bangumi"}]},{"characterId":"char_c83174","characterName":"星 宏美","sourceIds":{"bangumi":[{"characterId":"164702","match":"exact-normalized-name-in-linked-work","subjectId":"224226"}],"egsCharacterIds":["24556"],"vndbCharacterId":"c83174"},"originalCharacterName":"星 宏美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"気さくでノリの良い女の子。"},{"spoiler":false,"text":"好奇心旺盛で何事にも興味を抱く。"},{"spoiler":false,"text":"学園の情報通を自称し、愛用の携帯電話のカメラで常にスクープを狙っている。"},{"spoiler":false,"text":"控えめなオッパイが大きくしたいと牛乳をよく飲んでいる。"},{"spoiler":false,"text":"性に対してかなりオープンで、得た知識を直ぐに実践しようとする。"}],"source":"egs","sourceCharacterId":"24556","sourceWorkId":"8463","spoiler":false},{"segments":[{"spoiler":false,"text":"誠のクラスメイト。"},{"spoiler":false,"text":"ノリが軽く社交的な女の子。"},{"spoiler":false,"text":"いつも奈緒と一緒に行動している。"},{"spoiler":false,"text":"好奇心が旺盛で何事にも興味深々。"},{"spoiler":false,"text":"学園内の情報通で、何かスクープを見つけると、愛用の携帯電話のカメラで撮影する。"},{"spoiler":false,"text":"貧乳を気にしていて、いつも奈緒から給食の牛乳を貰って飲んでいる。"},{"spoiler":false,"text":"性にもオープンで、得た知識をすぐに試したがる実践派。"},{"spoiler":false,"text":"泉が怒った時のなだめ役。"}],"source":"bangumi","sourceCharacterId":"164702"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22e21921ec436868c7bf27ab516a9eba61bd0e27a86b19e65911f72848593df2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93c9c08dc2a74ab4535a918fb08fea28cfaced66991afca7a203f0a590c91183.webp","width":94,"height":256,"source":"static-detail"},"actors":[{"creditedName":"足立友","creatorId":"vndb:s1165","sourcePersonId":"vndb:s1165","canonicalEntityId":"vndb:s1165","name":"足立 友","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224226:164702:4858:1","source":"bangumi"}]},{"characterId":"char_c83175","characterName":"内山 奈緒","sourceIds":{"bangumi":[{"characterId":"164703","match":"exact-normalized-name-in-linked-work","subjectId":"224226"}],"egsCharacterIds":["24557"],"vndbCharacterId":"c83175"},"originalCharacterName":"内山 奈緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"少々、とぼけたところもあるが、穏やかな性格で、落ち着いた雰囲気を持ち、周囲に比べて大人っぽい。"},{"spoiler":false,"text":"クラスで最もオッパイが大きく、それをクラスの男子からからかわれるが、特に意に介していない。"},{"spoiler":false,"text":"インターネットで仕入れた性知識は、同年代の女の子に比べ抱負。"}],"source":"egs","sourceCharacterId":"24557","sourceWorkId":"8463","spoiler":false},{"segments":[{"spoiler":false,"text":"誠のクラスメイト。"},{"spoiler":false,"text":"クラス一番の巨乳の持ち主。"},{"spoiler":false,"text":"男子から胸のことを冷やかされるが、何故か余裕を持って対応している。"},{"spoiler":false,"text":"穏やかで、落ち着いており、周囲より大人っぽい。"},{"spoiler":false,"text":"性の知識は同年代に比べ豊富で、全てインターネットで得ている。"},{"spoiler":false,"text":"少々とぼけたところがある。"}],"source":"bangumi","sourceCharacterId":"164703"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1eb79cb6dba94d58a9b5069583b64a9404bdb41e1f1fe0f96054c363f6cb58ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ad9b3f563951b814315a8816119c4d18a2cbbc715d2a3023bd19589677747f4.webp","width":99,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relation