{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22164","model":{"presentationWorkId":"vndb:v14558","staff":{"artwork":[{"creditedName":"綱島志朗","creatorId":"vndb:s2096","sourcePersonId":"egs:creator:14913","canonicalEntityId":"vndb:s2096","name":"綱島志朗","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:152999","source":"egs"}],"scenario":[],"music":[],"other":[{"creditedName":"綱島 志朗","creatorId":"vndb:s2096","sourcePersonId":"vndb:s2096","canonicalEntityId":"vndb:s2096","name":"綱島 志朗","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:106987","source":"vndb"}]},"cast":[{"characterId":"char_c15818","characterName":"静野 咲良","sourceIds":{"bangumi":[{"characterId":"64512","match":"exact-normalized-name-in-linked-work","subjectId":"44782"},{"characterId":"64512","match":"exact-normalized-name-in-linked-work","subjectId":"88700"}],"egsCharacterIds":["1016"],"vndbCharacterId":"c15818"},"originalCharacterName":"静野 咲良","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エドが仮想で目覚めた時、最初に遭遇し、彼を保護した女性。"},{"spoiler":false,"text":"入隊2年目で、階級は中尉。"},{"spoiler":false,"text":"非常に明るく能天気だが、勝ち気で男勝り。"},{"spoiler":false,"text":"おしとやかな大和撫子風の外見や仕草を、乱暴な態度と言葉遣いがだいなしにしている。"},{"spoiler":false,"text":"また、かなりのお調子者であり、それが原因で上官に怒られては、あからさまな媚を売っている。"},{"spoiler":false,"text":"映画が好きで、特に前時代の作品の現代編集版、改悪版やB級作品を好んで鑑賞している。"},{"spoiler":false,"text":"その話題で他の隊員と盛り上がることも多い。"},{"spoiler":false,"text":"「おいこら！そこの野郎！まだ死んでねぇなら返事しろ！」"}],"source":"egs","sourceCharacterId":"1016","sourceWorkId":"17371","spoiler":false},{"segments":[{"spoiler":false,"text":"エドが仮想で目覚めた時、最初に遭遇し、エドを保護した少女。"},{"spoiler":false,"text":"非常に明るく能天気だが、勝ち気で男勝り。"},{"spoiler":false,"text":"おしとやかな大和撫子風の外見や仕草を、乱暴な態度と言葉遣いがだいなしにしている。"},{"spoiler":false,"text":"また、かなりのお調子者であり、それが原因で上官に怒られては、あからさまな媚を売っている。"},{"spoiler":false,"text":"ケイやマルタなど、可愛いものに目がない。"}],"source":"egs","sourceCharacterId":"1016","sourceWorkId":"19877","spoiler":false},{"segments":[{"spoiler":false,"text":"逐日之狼的成员，军衔中尉。从虚拟空间救出失忆的爱德华。外表温柔，但一开口就形象尽毁。"}],"source":"bangumi","sourceCharacterId":"64512"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34af0e419cc4fa1f82699acc531d562d593ac106a6a8312ec38dc5065ff8ea9f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2560e8863f7d3e05ceccb7a4bf02774b99cde6abe1effc5e82ce16e8276f1bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笠原あきら","creatorId":"vndb:s11554","sourcePersonId":"vndb:s11554","canonicalEntityId":"vndb:s11554","name":"笠原 あきら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:254771:64512:19656:1","source":"bangumi"},{"creditedName":"池野 ほたる","creatorId":"vndb:s998","sourcePersonId":"vndb:s998","canonicalEntityId":"vndb:s998","name":"池野 ほたる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57391","source":"vndb"}]},{"characterId":"char_c15820","characterName":"シゼル・ステインブレッシェル","sourceIds":{"bangumi":[{"characterId":"27130","match":"exact-normalized-name-in-linked-work","subjectId":"44782"},{"characterId":"27130","match":"exact-normalized-name-in-linked-work","subjectId":"88700"}],"egsCharacterIds":["1019"],"vndbCharacterId":"c15820"},"originalCharacterName":"シゼル・ステインブレッシェル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"????-11-22"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"95kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フェンリル本隊から戦力補充のために出向してきた将校。"},{"spoiler":false,"text":"全身義体であり、階級は少佐。"},{"spoiler":false,"text":"典型的な軍人で、規律を重んじる厳格な性格。"},{"spoiler":false,"text":"緩くなりがちな空気の引き締め役となる。"},{"spoiler":false,"text":"…はずだったが、奔放な隊員たちにその性格を逆手に取られ、叱責が上官いじりに変わっていることもしばしば。"},{"spoiler":false,"text":"また、同州の仮想空間における風土病と相性が悪いようである。"},{"spoiler":false,"text":"TOPである門倉永二大佐の片腕でもあり、フェンリル古参の隊員。"},{"spoiler":false,"text":"スコール隊長のグッドマン中佐とは浅からぬ縁があるらしく、その行状に困り呆れながらも忠実に従う。"},{"spoiler":false,"text":"「フェンリル所属、シゼル・ステインブレッシェル。階級は少佐だ」"}],"source":"egs","sourceCharacterId":"1019","sourceWorkId":"17371","spoiler":false},{"segments":[{"spoiler":false,"text":"フェンリル本隊の所属で、TOPである門倉永二の片腕。"},{"spoiler":false,"text":"分隊への戦力補充と視察を兼ねた出向士官で、作戦の途中で分隊に合流する。"},{"spoiler":false,"text":"典型的な軍人気質で姐御肌、軍隊的男言葉を使う。"},{"spoiler":false,"text":"分隊長や所属隊員のバラエティに富んだ性格から緩くなりがちな部隊の引き締め役となる。"},{"spoiler":false,"text":"…はずだったが、隊長のグッドマンをはじめとするスコールの面子のあまりの奔放さに、いじられ役になる事もしばしば。"},{"spoiler":false,"text":"規律を重んじる厳格な性格だが、時折優しい一面を覗かせる事もある。"},{"spoiler":false,"text":"また、隠してはいるが、可愛いドレスやアクセサリーなどが好き。"},{"spoiler":false,"text":"グッドマンとは昔馴染みであり、浅からぬ縁があるらしく、上官でもあることから彼の言うことには逆らえない。"}],"source":"egs","sourceCharacterId":"1019","sourceWorkId":"19877","spoiler":false},{"segments":[{"spoiler":false,"text":"魔狼的冲锋队长，军衔少校，与门仓永二有将近7年的交情。"},{"spoiler":false,"text":"早年被迫义体化，御姐气质，冷静沉着。非常值得信赖的人。"}],"source":"bangumi","sourceCharacterId":"27130"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f93b6dbbc48229bc914b1c837bbe5dc68c264a32b171026221a392a4e3276ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6312dda31ac078663672237e3cf8f349857aa194056e005836a0d34060fe54d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:254771:27130:22331:1","source":"bangumi"}]},{"characterId":"char_c15836","characterName":"ディオニシオ・ウルセライ","sourceIds":{"bangumi":[{"characterId":"67038","match":"exact-normalized-name-in-linked-work","subjectId":"44782"},{"characterId":"67038","match":"exact-normalized-name-in-linked-work","subjectId":"88700"}],"egsCharacterIds":["1027"],"vndbCharacterId":"c15836"},"originalCharacterName":"ディオニシオ・ウルセライ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルピス社の保有する州政府委託軍『PANDORA』のTOPであり、SASの仮想世界の治安維持活動を行なっている。"},{"spoiler":false,"text":"階級は中将で、全身義体。"},{"spoiler":false,"text":"現実では高級娼館と情報屋を営んでおり、金銭ベースで物事を考える。"},{"spoiler":false,"text":"造られた外見や柔和な態度も含めて、したたかな人物。"},{"spoiler":false,"text":"「戦争は嫌いだが、金になるから大好きだ。金があれば、世の中のほとんどの物は手に入る」"}],"source":"egs","sourceCharacterId":"1027","sourceWorkId":"17371","spoiler":false},{"segments":[{"spoiler":false,"text":"州政府委託軍『PANDORA』の隊長で中将という地位にありながら、娼館ババを営み、情報屋もしているという不思議な人物。"},{"spoiler":false,"text":"物事をすべてお金で考える。"}],"source":"egs","sourceCharacterId":"1027","sourceWorkId":"19877","spoiler":false},{"segments":[{"spoiler":false,"text":"厄尔皮斯公司保有的州政府委托军『PANDORA』的顶级，在SAS的假想（网络）世界进行治安维持活动。"},{"spoiler":false,"text":"阶级是中将，全身义体。"},{"spoiler":false,"text":"在现实经营高级娼馆和情报销售，基本上以金钱来衡量事物。"},{"spoiler":false,"text":"包含被改造的外表和柔和的态度在内，很厉害的人物。"},{"spoiler":false,"text":"「虽然讨厌战争，但是可以变成钱财的话就很喜欢。有钱的话，世界上大部分的东西都能到手了」"}],"source":"bangumi","sourceCharacterId":"67038"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6cee2f59df5aafb9ea27372769bab07e8f32a20ac9da285caf1e53d3761e32a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b29acee3c51e775b501ea93fc48c780c0673004afeb51974e58e50327eb9eeac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本兼平","creatorId":"vndb:s31","sourcePersonId":"vndb:s31","canonicalEntityId":"vndb:s31","name":"山本 兼平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:254771:67038:7559:1","source":"bangumi"}]},{"characterId":"char_c15837","characterName":"エド","sourceIds":{"bangumi":[{"characterId":"64500","match":"exact-normalized-name-in-linked-work","subjectId":"44782"},{"characterId":"64500","match":"exact-normalized-name-in-linked-work","subjectId":"88700"}],"egsCharacterIds":["1015"],"vndbCharacterId":"c15837"},"originalCharacterName":"エド","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mecha pilot and the protagonist who lost his memory."}],"source":"vndb","sourceCharacterId":"c15837"},{"segments":[{"spoiler":false,"text":"記憶を失った状態でフェンリル独立機動分隊「スコール」に保護された青年。"},{"spoiler":false,"text":"冷凍睡眠状態だったが、なぜ彼が（実体を含め）そこに居たのか、なぜ記憶を失ったのかなど一切が不明。"},{"spoiler":false,"text":"眠っていたベッドのプレートに刻まれていた蝶のような記号から、エドワード（バタフライ効果の提唱者の名前）という呼称が付けられた。"},{"spoiler":false,"text":"単にエドと呼ばれることも多い。"},{"spoiler":false,"text":"暫定階級は准尉。"},{"spoiler":false,"text":"戦闘技術だけが自身の手札だと自覚し、それを用いて生きてゆくためにフェンリル入隊を志願。"},{"spoiler":false,"text":"分隊長との交渉の末にこれを許可され、数々の任務へと身を投じていく。"},{"spoiler":false,"text":"記憶はないが、感情は豊かでノリもいい。"},{"spoiler":false,"text":"理知的な性格だが天然さが見え隠れし、大まじめにふざけた言動を取ることが多々ある。"},{"spoiler":false,"text":"同僚のフラン曰く「強い者苛めが好きで、弱い者苛めが嫌い」"},{"spoiler":false,"text":"「……俺は、人は簡単に殺せる　でもきっと、誰かを見捨てるのは駄目だ。理解はしても、慣れないだろうな」"}],"source":"egs","sourceCharacterId":"1015","sourceWorkId":"17371","spoiler":false},{"segments":[{"spoiler":false,"text":"記憶を失った状態でフェンリル分隊スコールに保護された青年。"},{"spoiler":false,"text":"なぜ彼が（実体を含め）そこに居たのか、なぜ記憶を失ったのかなど一切が不明。"},{"spoiler":false,"text":"眠っていたベッドのプレートに刻まれていた蝶のような記号から、エドワード（バタフライ効果の提唱者の名前）という呼称が付けられた。"},{"spoiler":false,"text":"単にエドと呼ばれることも多い。"},{"spoiler":false,"text":"暫定階級は准尉。"},{"spoiler":false,"text":"戦闘技術だけが自身の手札だと自覚し、それを用いて生きてゆくためにフェンリル入隊を志願。"},{"spoiler":false,"text":"分隊長との交渉の末にこれを許可され、数々の任務へと身を投じていく。"},{"spoiler":false,"text":"記憶は無いが、感情は豊かでノリもいい。"},{"spoiler":false,"text":"理知的な性格だが天然さが見え隠れし、大まじめにふざけた言動を取ることが多々ある。"},{"spoiler":false,"text":"上官や目上の人間に対しても平気でからかったり対等な口をきき、それが敵となればさらに容赦ない。"},{"spoiler":false,"text":"同僚のフラン曰く「強い者いじめが好きで、弱い者いじめが嫌い」"}],"source":"egs","sourceCharacterId":"1015","sourceWorkId":"19877","spoiler":false},{"segments":[{"spoiler":false,"text":"又一个在战场上苏醒的失忆主角，被静野咲良救出后，加入逐日之狼分队。"}],"source":"bangumi","sourceCharacterId":"64500"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d91bc3f5923ab0aafe83ed49b4aaa8b98ee562c21e22230a7e090c881edcd800.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4abc8b77f1ad494ed835d72c7e88a39c174370a4d31a55d173720bae9289f826.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西健亮","creatorId":"vndb:s1148","sourcePersonId":"vndb:s1148","canonicalEntityId":"vndb:s1148","name":"和音(声優)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:254771:64500:5219:1","source":"bangumi"}]},{"characterId":"char_c15838","characterName":"フラン","sourceIds":{"bangumi":[{"characterId":"64514","match":"exact-normalized-name-in-linked-work","subjectId":"44782"},{"characterId":"64514","match":"exact-normalized-name-in-linked-work","subjectId":"88700"}],"egsCharacterIds":["1018"],"vndbCharacterId":"c15838"},"originalCharacterName":"フラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スコール隊長であるグッドマン中佐の娘、愛称はフラン。"},{"spoiler":false,"text":"階級は少尉。"},{"spoiler":false,"text":"すました態度が基本だがクールではなく、その性格は掴みどころがないというよりたどたどしい。"},{"spoiler":false,"text":"日常的に単独任務を請ける個人主義者の一面もあれば、積極的に賭け事の輪に加わる協調性もある。"},{"spoiler":false,"text":"誰に対しても毒舌家であるため、咲良とはよく喧嘩している。"},{"spoiler":false,"text":"しかし、プライベートで一対一になると途端に言葉に詰まり、どもってしまう。"},{"spoiler":false,"text":"シャワールームの使用頻度が高く、エドと隣り合わせで浴びることも多い。"},{"spoiler":false,"text":"分隊中最年少で体つきも幼いが、スコールでのキャリアが七年以上に及ぶベテラン隊員。"},{"spoiler":false,"text":"勘が異常に働くため、勝手な行動でも戦果が拡張することが多い。"},{"spoiler":false,"text":"また、ある危険なシュミクラムユニットとその所属部隊に固執している。"},{"spoiler":false,"text":"エドに対しては興味があるのか無いのか、微妙な距離を保っている。"},{"spoiler":false,"text":"また、中佐との親子仲は悪く、職務外での会話は一切ない。"},{"spoiler":false,"text":"「……変態」"}],"source":"egs","sourceCharacterId":"1018","sourceWorkId":"17371","spoiler":false},{"segments":[{"spoiler":false,"text":"スコール隊長の娘。愛称はフラン。"},{"spoiler":false,"text":"個人主義・自由主義的な性格で、単独行動をとることが多く、よく個人で受けてきた依頼を一人でこなしている。"},{"spoiler":false,"text":"直感、ひらめきで行動し命令違反もしばしばだが、その行動は的確で大抵想定以上の戦果を導く。"},{"spoiler":false,"text":"かなりの毒舌家だが、それは他者とのコミュニケーションが苦手な事の表れ。"},{"spoiler":false,"text":"咲良とはなにかにつけて口喧嘩しているが、おそらく仲は良い。"}],"source":"egs","sourceCharacterId":"1018","sourceWorkId":"19877","spoiler":false},{"segments":[{"spoiler":false,"text":"逐日之狼队长古德曼中佐的女儿。对父亲冷淡，只保持基本的上下级关系。"}],"source":"bangumi","sourceCharacterId":"64514"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a618a200c70ad0d3d33dcb6736a206901d12c0c04301db86c92e44473b9e5db3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fbd0f1b7cace68274dda47fbecbbeedc8552b8b19c6db3faf2730ede481c43e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葉月 夏生","creatorId":"vndb:s12001","sourcePersonId":"vndb:s12001","canonicalEntityId":"vndb:s12001","name":"葉月 夏生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57392","source":"vndb"}]},{"characterId":"char_c15839","characterName":"ケイ","sourceIds":{"bangumi":[{"characterId":"64513","match":"exact-normalized-name-in-linked-work","subjectId":"44782"},{"characterId":"64513","match":"exact-normalized-name-in-linked-work","subjectId":"88700"}],"egsCharacterIds":["1017"],"vndbCharacterId":"c15839"},"originalCharacterName":"ケイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"基地に潜伏していたところを捕らえられた少女。"},{"spoiler":false,"text":"目的は不明だが、入隊希望を受け入れられ晴れて正式に隊員に。"},{"spoiler":false,"text":"生まれの事情により名字を持たないが、SASにおいては珍しい話ではない。"},{"spoiler":false,"text":"階級は曹長。"},{"spoiler":false,"text":"ほわほわした雰囲気そのままに、柔らかな人となりをしている。"},{"spoiler":false,"text":"その反面、一度譲らないと決めた事柄に関しては梃子でも動かない。"},{"spoiler":false,"text":"また、よく腹を空かせており、肉を与えると喜んで食いつく。"},{"spoiler":false,"text":"一見、傭兵が似合わないように見えるが、戦闘においてはシビアであり命令にも忠実。 ためらいを一切見せず、敵を撃破していく。"},{"spoiler":false,"text":"軍歴はないようだが、人材産出都市における最高峰の実戦式売り込み大会・マジェスティックオークションの上位入賞者という経歴を持つ。"},{"spoiler":false,"text":"そのため、彼女本来の値段はとてつもなく高額である。"},{"spoiler":false,"text":"「行こ行こっ！行って早くご飯食べようよ！」"}],"source":"egs","sourceCharacterId":"1017","sourceWorkId":"17371","spoiler":false},{"segments":[{"spoiler":false,"text":"基地に潜伏していたところを捕らえられた後、入隊希望を受け入れられる。"},{"spoiler":false,"text":"ほわほわした雰囲気そのままに、柔らかな人となりをしている。"},{"spoiler":false,"text":"その反面、一度譲らないと決めた事柄に関しては梃子でも動かない。"},{"spoiler":false,"text":"よく腹を空かせており、肉を与えると喜んで食いつく。"},{"spoiler":false,"text":"一見、傭兵が似合わないように見えるが、戦闘においてはシビアであり命令にも忠実。"},{"spoiler":false,"text":"マジェスティックオークションの上位入賞者という経歴を持つ。"}],"source":"egs","sourceCharacterId":"1017","sourceWorkId":"19877","spoiler":false},{"segments":[{"spoiler":false,"text":"潜入逐日之狼基地被抓住，顺势入队的少女。"}],"source":"bangumi","sourceCharacterId":"64513"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c5a4a87fdf537c32ea1de5d44ef74ca44b18162ad78a9f9f64303e9dee24a5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28bcddb92fdfcd65845040e34d4b27a77e7a9ab0c1363c8b71b76df99b0c3abe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小嶋めい","creatorId":"vndb:s795","sourcePersonId":"vndb:s795","canonicalEntityId":"vndb:s795","name":"小嶋 めい","roleCode