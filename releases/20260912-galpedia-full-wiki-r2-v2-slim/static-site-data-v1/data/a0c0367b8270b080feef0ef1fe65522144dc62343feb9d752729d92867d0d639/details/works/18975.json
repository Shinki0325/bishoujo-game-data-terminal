-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"円やカナタのクラスメイト。"},{"spoiler":false,"text":"カナタとは別の意味で他者を寄せ付けない雰囲気をまとった少女。"},{"spoiler":false,"text":"スポーツ万能で成績も優秀だが、いつもカナタには及ばずライバル視している。"},{"spoiler":false,"text":"数年前に起こったとある事件を発端に制定された“国際魔法憲章”で定められた「26歳以下の国際免許なしでの魔法使用は禁止」を無視し、独自の魔法体系で違法魔法使いになる程、魔法に心酔している。"}],"source":"egs","sourceCharacterId":"858","sourceWorkId":"18975","spoiler":false},{"segments":[{"spoiler":false,"text":"円やカナタのクラスメイト。"},{"spoiler":false,"text":"カナタとは別の意味で他者を寄せ付けない"},{"spoiler":false,"text":"雰囲気をまとった少女。"},{"spoiler":false,"text":"スポーツ万能で成績も優秀だが、"},{"spoiler":false,"text":"いつもカナタには及ばずライバル視している。"},{"spoiler":false,"text":"数年前に起こったとある事件を発端に"},{"spoiler":false,"text":"制定された”魔法国際憲章”で定められた"},{"spoiler":false,"text":"「２６歳以下の国際免許なしでの魔法使用は禁止」を無視し、"},{"spoiler":false,"text":"独自の魔法体系で違法魔法使いになる程、"},{"spoiler":false,"text":"魔法に心酔している。"}],"source":"bangumi","sourceCharacterId":"166139"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/286fc967d85bda3322cf18f4c04e9dce3e9fd3dd3ae8009ff6c3d14872acd456.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b8369cdba5149e7ad1c02a50c994fe131445443d64ed3d18e2cc38c6172d626.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃也 みなみ","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53031","source":"vndb"}]},{"characterId":"char_c34437","characterName":"賀茂 健一","sourceIds":{"bangumi":[],"egsCharacterIds":["859"],"vndbCharacterId":"c34437"},"originalCharacterName":"賀茂 健一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"sou