{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13260","model":{"presentationWorkId":"vndb:v2875","staff":{"artwork":[{"creditedName":"CRUCCU(鳩)","creatorId":"vndb:s2032","sourcePersonId":"egs:creator:4236","canonicalEntityId":"vndb:s2032","name":"CRUCCU(鳩)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:81632","source":"egs"}],"scenario":[{"creditedName":"有梨 つかさ","creatorId":"vndb:s2030","sourcePersonId":"vndb:s2030","canonicalEntityId":"vndb:s2030","name":"有梨 つかさ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:38527","source":"vndb"}],"music":[{"creditedName":"ミリオンバンブー","creatorId":"vndb:s1435","sourcePersonId":"vndb:s1435","canonicalEntityId":"vndb:s1435","name":"ミリオンバンブー","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:38526","source":"vndb"}],"other":[{"creditedName":"CRUCCU","creatorId":"vndb:s2032","sourcePersonId":"vndb:s2032","canonicalEntityId":"vndb:s2032","name":"CRUCCU","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:38528","source":"vndb"}]},"cast":[{"characterId":"char_c76562","characterName":"モリガン","sourceIds":{"bangumi":[{"characterId":"98290","match":"exact-normalized-name-in-linked-work","subjectId":"224168"}],"egsCharacterIds":["14217"],"vndbCharacterId":"c76562"},"originalCharacterName":"モリガン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The goddess of war in Celtic mythology. She is also known as the “Great Queen” and the “Goddess of Death."},{"spoiler":false,"text":"She is revered by her peers as a goddess who possesses powerful magical powers and leads them to victory in battle. Noble and proud, her beautiful and bewitching body have captivated tens of thousands of men."},{"spoiler":false,"text":"It is said that she has captivated tens of thousands of men, but in reality she is a virgin who is getting older."},{"spoiler":false,"text":"Cú Chulainn is young, beautiful, and strong, and she falls in love with him. She is captured and becomes an outlet for his desires."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c76562"},{"segments":[{"spoiler":false,"text":"“大いなる女王”や”死の女神”の異名を持つ、ケルト神話に登場する戦女神。"},{"spoiler":false,"text":"強大な魔力で、戦を勝利に導くとして周囲から崇められている。"},{"spoiler":false,"text":"性格は、気高く高慢。美しく妖艶な肢体は幾多の男たちを虜にしてきたと噂されるが、実際のところは処女。"},{"spoiler":false,"text":"絶世の美少年であるクーフリンを手懐けて思いのままに玩具にしようと画策するが、逆に捕えられ、復讐としてその肉体を犯される。"}],"source":"egs","sourceCharacterId":"14217","sourceWorkId":"13260","spoiler":false},{"segments":[{"spoiler":false,"text":"ケルト神話に登場する戦女神。"},{"spoiler":false,"text":"“大いなる女王” や “死の女神” の通り名を持つ。"},{"spoiler":false,"text":"強大な魔力をもち、戦を勝利に導く女神として周囲から崇められている。"},{"spoiler":false,"text":"気高く高慢、その美しく妖艶な肢体は幾万もの男を虜にしてきたと言われるが、実際は年増の処女。"},{"spoiler":false,"text":"若く美しく強いクーフリンを手懐けて、自らの性の玩具にしようと画策していたが、逆に捕らわれ彼の欲望の捌け口となってしまう。"}],"source":"bangumi","sourceCharacterId":"98290"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab27ef4a39684dfc04e04a2d1f0165ef433e34e581f44e94519f74de833c90dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e4156b86571f437a80a665bb7c08c86ffdee3ae2092dc8ca972ad98769f3c6d.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224168:98290:6359:1","source":"bangumi"}]},{"characterId":"char_c76563","characterName":"オイフェ","sourceIds":{"bangumi":[{"characterId":"98291","match":"exact-normalized-name-in-linked-work","subjectId":"224168"}],"egsCharacterIds":["14218"],"vndbCharacterId":"c76563"},"originalCharacterName":"オイフェ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female knight under Morrigan's command. She may look petite, but she has the strength that Morrigan trusts in her. She respects Morrigan as a queen."},{"spoiler":false,"text":"She is able to fight even with Cú Chulainn, who is famous for his monstrous strength."},{"spoiler":false,"text":"She is also a man-hater because of her forbidden feelings of homosexuality. On Morrigan's orders, she heads to the city of Evan to capture Cú Chulainn, but..."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c76563"},{"segments":[{"spoiler":false,"text":"モリガンの手下である女騎士。"},{"spoiler":false,"text":"小柄だが、怪力で有名なクーフリンに匹敵する力を持つ。"},{"spoiler":false,"text":"モリガンを女王として崇拝している。また同性愛者。故に男嫌いでもある。"},{"spoiler":false,"text":"モリガンの命によって、クーフリンを捕えに赴くが……。"}],"source":"egs","sourceCharacterId":"14218","sourceWorkId":"13260","spoiler":false},{"segments":[{"spoiler":false,"text":"モリガンの手下の女騎士。"},{"spoiler":false,"text":"見た目は小柄であるが、モリガンが信頼を置くだけの実力を持ち、怪力で有名なクーフリンと互角に戦える。"},{"spoiler":false,"text":"モリガンのことを女王として尊敬するだけでなく、同性愛という禁忌の感情も持っている故に、男嫌い。"},{"spoiler":false,"text":"モリガンの命により、クーフリンを捕らえにエヴァンの街へ向かうが…。"}],"source":"bangumi","sourceCharacterId":"98291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2006f0143fb9433499ea26ec3e8d5ef2179090821d5ae4ce6f6aeb533899575b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edba8eac9ece31a64c99348e5993478712e34a5c9295746ca34fed14b5aba598.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"望月まゆ","creatorId":"vndb:s1020","sourcePersonId":"vndb:s1020","canonicalEntityId":"vndb:s1020","name":"望月 まゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224168:98291:27901:1","source":"bangumi"}]},{"characterId":"char_vndb_c149391","characterName":"クーフリン","sourceIds":{"vndbCharacterId":"c149391"},"originalCharacterName":"クーフリン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A demigod hero in Celtic mythology. He is a young knight (boy) with beautiful features who is courted by many women."},{"spoiler":false,"text":"When he gets into a fight, his beauty is instantly transformed into a monster-like appearance. He is unusually strong, and can manipulate the magic spear “Gaebulg” at will."},{"spoiler":false,"text":"Despite his beauty and lovely appearance, he also has a cruel side due to his young age, as demons eat away at his heart."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c149391"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1571","sourceCompanyId":"egs:brand:1883","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13260:1883","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:172606:v2875","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["develope