egments":[{"spoiler":false,"text":"Childhood friend of Touji and daughter of master of the dojo Touji used to attend when he was young. Her \"Gleam\" is the power to manipulate shadow."}],"source":"vndb","sourceCharacterId":"c24498"},{"segments":[{"spoiler":false,"text":"罪に抗う孤高の魔女"},{"spoiler":false,"text":"ガーデンに収容されている【魔女】"},{"spoiler":false,"text":"人付き合いが苦手ながら、同じ境遇にある仲間を決して見捨てられない心優しい少女。"},{"spoiler":false,"text":"自分が起こした事件のせいで多くの人が傷ついたことに深い自責の念を抱えている。"},{"spoiler":false,"text":"もともとは由緒ある古武術の一門の生まれ。"},{"spoiler":false,"text":"自身の素質と普段の努力の成果もあってか、一門の内でも一二を争う実力者である。"},{"spoiler":false,"text":"幼い頃から修行に打ち込んできたことから一般常識がなく、お嬢さま然とした外見に似合わずかなりの天然。"},{"spoiler":false,"text":"その言動のギャップから、時には周囲を戸惑わせたり苦笑いさせたりすることも……。"},{"spoiler":false,"text":"本来であれば、良家の子女として恵まれた人生を歩むはずだったが、試合中のとある事故によって 【魔女】と認定され、ガーデンに収容されることになる――"},{"spoiler":false,"text":"「はっ、君もつくづく愚かな男だね？」"}],"source":"egs","sourceCharacterId":"927","sourceWorkId":"18020","spoiler":false},{"segments":[{"spoiler":false,"text":"ガーデンに収容されている “魔女”。"},{"spoiler":false,"text":"人付き合いが苦手ながら、同じ境遇にある仲間を決して見捨てられない心優しい少女。"},{"spoiler":false,"text":"自分が起こした事件のせいで多くの人が傷ついたことに深い自責の念を抱えている。"},{"spoiler":false,"text":"もともとは由緒ある古武術の一門の生まれ。"},{"spoiler":false,"text":"自身の素質と普段の努力の成果もあってか、一門の内でも一二を争う実力者である。"},{"spoiler":false,"text":"幼い頃から修行に打ち込んできたことから一般常識がなく、お嬢さま然とした外見に似合わずかなりの天然。"},{"spoiler":false,"text":"その言動のギャップから、時には周囲を戸惑わせたり苦笑いさせたりすることも……。"},{"spoiler":false,"text":"本来であれば、良家の子女として恵まれた人生を歩むはずだったが、試合中のとある事故によって “魔女” と認定され、ガーデンに収容されることになる――"},{"spoiler":false,"text":"「はっ、君もつくづく愚かな男だね？」"}],"source":"bangumi","sourceCharacterId":"40989"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"927","sourceWorkId":"18020","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"927","sourceWorkId":"18020","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterI