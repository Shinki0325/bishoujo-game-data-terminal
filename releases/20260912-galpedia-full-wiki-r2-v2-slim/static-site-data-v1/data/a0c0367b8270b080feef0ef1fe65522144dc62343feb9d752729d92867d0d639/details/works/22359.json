ン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"height":{"reviewState":"source-only","source":"vndb","value":"188"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although he has a suspcious appearance, Ron is a friendly and kind young man. However, he never remembers people's names, so he makes them irritated. Since he doesn't even try to talk about where he's from or his background at all, nobody knows anything about him."},{"spoiler":false,"text":"His route is only accessible when the player selects Nanami as the protagonist."},{"spoiler":false,"text":"Translation of his official website profile"}],"source":"vndb","sourceCharacterId":"c30372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f974921e886fbef0541a86dd5d703bf1733dcb70fc975310a63c7aa0a1a14eaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7becd39d01396ede00a2853f60a7a0b3d7d3a52ce6fa2f6151dafe8b474d16b4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田 智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57124","source":"vndb"}]},{"characterId":"char_vndb_c30373","characterName":"乙丸 平士","sourceIds":{"vndbCharacterId":"c30373"},"originalCharacterName":"乙丸 平士","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1218"},"bloodType":{"reviewState":"source-only