db:s293","name":"斎賀 みつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57122","source":"vndb"}]},{"characterId":"char_vndb_c30370","characterName":"加賀見 一月","sourceIds":{"vndbCharacterId":"c30370"},"originalCharacterName":"加賀見 一月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1101"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"184"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A superficial playboy, Itsuki has a peculiar allure that some regard as \"poisonous\". He repeatedly jokes around and lies; not disclosing his true feelings. Itsuki often plays around by teasing Mikoto. He gets along with Heishi and Nanami, so they often hang out together."},{"spoiler":false,"text":"His route is only accessible when the player selects Mikoto as the protagonist."},{"spoiler":false,"text":"Translation of his official website profile"}],"source":"vndb","sourceCharacterId":"c30370"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd7568d35798a390b4315c0a99bc3b00dae22136232d7202bfec447a6e2d1866.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbf68c09a910024dbe5e4f5aaacde7b81d5f71d60188382b0669dca49e909e49.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遊佐 浩二","creatorId":"vndb:s56","sourcePersonId":"vndb:s56","canonicalEntityId":"vndb:s56","name":"遊佐 浩二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57117","source":"vndb"}]},{"c