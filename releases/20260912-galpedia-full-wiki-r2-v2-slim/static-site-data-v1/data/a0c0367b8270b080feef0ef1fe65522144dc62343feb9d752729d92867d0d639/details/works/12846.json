icalEntityId":"vndb:s41449","name":"渡邊 亜希子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:47847","source":"vndb"},{"creditedName":"Satomi","creatorId":"vndb:s41451","sourcePersonId":"vndb:s41451","canonicalEntityId":"vndb:s41451","name":"Satomi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:47849","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c16817","characterName":"逢坂 大河","sourceIds":{"vndbCharacterId":"c16817"},"originalCharacterName":"逢坂 大河","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine of Toradora! and the classmate of Ryuuji. She has a well-regulated and beautiful appearance though lacking capability of stomaching company of others. Due to her name, tendency to often snap at others in brutal ways and her short stature, she is given the nickname \"Palmtop Tiger\". Essentially, Taiga gets upset easily and is also brutally honest with others, typically when she is lashing out at someone. Due to her cute looks (described as a doll by Ryuuji), she often gets confessions of love by boys, but she turns down every one of them. Despite coming from a well-to-do family, her life with them is very difficult because of various problems. She had lived with her father and step-mother and constantly fought with her parents, but she moved out and since then has taken to living on her own. Since she came from a privileged household, she does not know how to do any domestic chores."}],"source":"vndb","sourceCharacterId":"c16817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/009a1aca595ff02118f2a613665dadcd7992d071f8920ef3f07a644a795117f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e982889c5c4fc000f91cbdd3d6bfb457a96acec15632c205c50d4a06ec5ea3c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"釘宮 理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26476","source":"vndb"}]},{"characterId":"char_vndb_c21062","characterName":"高須 竜児","sourceIds":{"vndbCharacterId":"c21062"},"originalCharacterName":"高須 竜児","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"411"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main protagonist of the story and a student of class 2-C. Due to heredity, his sanpaku eyes make him look like an intimidating delinquent and causes many misunderstandings. He lives in a fatherless family, his father having left before Ryuuji was born, with just his mother. Due to this, Ryuuji has learned to be self-sufficient. He excels at cooking and everything related to housekeeping, to the point of feeling compelled to clean up messes he can find, and also excels at sewing."}],"source":"vndb","sourceCharacterId":"c21062"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/080fd1beb01c30c8aae65def2ec21919e0b8d3f35b75eda9385cae2c579acb4a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charac