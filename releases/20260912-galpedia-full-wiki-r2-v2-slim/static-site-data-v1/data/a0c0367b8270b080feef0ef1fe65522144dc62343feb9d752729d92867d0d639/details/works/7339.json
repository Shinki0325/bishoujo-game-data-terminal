cts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fb4a0de1ab2306ae02e076ad7024b1610406b228520a99f4e7cd296c3e14a92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed47b8e395cfc60de648a73763e96637b4f69743e59ed0ec36ccf88f7d1a219b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13636:11956:4714:1","source":"bangumi"}]},{"characterId":"char_c46690","characterName":"桧林 弥生","sourceIds":{"bangumi":[{"characterId":"11957","match":"exact-normalized-name-in-linked-work","subjectId":"13636"}],"egsCharacterIds":["25725"],"vndbCharacterId":"c46690"},"originalCharacterName":"桧林 弥生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"有希と犬猿の仲だった少女。"},{"spoiler":false,"text":"家柄、能力共に有希にことごとく負けており、生前は幼稚園から続くライバル関係だった様子。"},{"spoiler":false,"text":"事故で死んでしまったのだが、有希より先に死んだ事が我慢ならず、彼女に憑依して、あれこれ悪いことをしようと企むが、彼女自身、お嬢様なため、大したことは出来ない。"},{"spoiler":false,"text":"メイド・亜佳莉曰く「弥生が憑依した有希は悩みの種」"}],"source":"egs","sourceCharacterId":"25725","sourceWorkId":"7339","spoiler":false},{"segments":[{"spoiler":false,"text":"因遭遇事故逝去了，与有希是水火不容关系的女孩子。"},{"spoiler":false,"text":"在家世和能力上全都输给有希，在生前是自幼稚园起就一直是竞敌关系。"},{"spoiler":false,"text":"忍受不了自己竟然先死去了，想要破坏有希的人生而附身到她身上。"},{"spoiler":false,"text":"但是她本人也是个好人家大小姐，做不出什么大坏事来，可爱的小恶魔。"},{"spoiler":false,"text":"她依附到有希身上时是亜佳莉烦恼的根源。"}],"source":"bangumi","sourceCharacterId":"11957"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"25725","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"25725","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"25725","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"25725","sourceWorkId":"7339","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1d1176a49a65a8e2abb082944ee0faa85c536d57abbf1313ef180482559d014.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc183a228431f4feb1637c0dfd77b70044bb4291142e40eaef24a022bd363f2f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13636:11957:4432:1","source":"bangumi"}]},{"characterId":"char_c46691","characterName":"如月 亜佳莉","sourceIds":{"bangumi":[{"characterId":"11955","match":"exact-normalized-name-in-linked-work","subjectId":"13636"}],"egsCharacterIds":["25727"],"vndbCharacterId":"c46691"},"originalCharacterName":"如月 亜佳莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"常に有希と共にいるメイド。"},{"spoiler":false,"text":"彼女の護衛として育てられたこともあり、教育から家事全般、武芸八範、A級ライセンスまで、なんでも揃えている。"},{"spoiler":false,"text":"主の添い寝からお小遣いまでの一切を管理しているため、メイドといえど、有希は微妙に彼女に頭が上がらない。"}],"source":"egs","sourceCharacterId":"25727","sourceWorkId":"7339","spoiler":false},{"segments":[{"spoiler":false,"text":"作为有希的护卫而训练培养出来的同龄女仆。"},{"spoiler":false,"text":"接受了与有希同样的教育不止，还精通全部家务，连八方武艺的A级证书都备齐。"},{"spoiler":false,"text":"因为从有希的零用钱到同寝全都由她一手包办管理，"},{"spoiler":false,"text":"所以即使是女仆，有希在某些时候也是听从她的。"},{"spoiler":false,"text":"对有希的多重人格感到佷痛心，对主人公抱有一丝的希望而下定决心搬到公寓来。"}],"source":"bangumi","sourceCharacterId":"11955"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"25727","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"25727","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"25727","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"25727","sourceWorkId":"7339","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdf855424da4e345df518490d847d2c6a0a241cd04dd6a691a4eccfd764900be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67c847130ac1e6fad41ce43d5aaf35a7cb566975095a90c8566133fb00cef280.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode