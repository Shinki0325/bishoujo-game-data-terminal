","sourceCharacterId":"25726","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"25726","sourceWorkId":"7339","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cbbc55d80cdb5ee8ed235e95277c104be80ae8e496866119da47e9d88d6a490.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95d0caae9e3fdaf5b6785825504ab9f857e8af450a88f6631d375b4f7744718b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉住梢","creatorId":"vndb:s777","sourcePersonId":"vndb:s777","canonicalEntityId":"vndb:s777","name":"吉住 梢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13636:11953:4087:1","source":"bangumi"}]},{"characterId":"char_c46688","characterName":"大宗路 有希","sourceIds":{"bangumi":[{"characterId":"11954","match":"exact-normalized-name-in-linked-work","subjectId":"13636"}],"egsCharacterIds":["25723"],"vndbCharacterId":"c46688"},"originalCharacterName":"大宗路 有希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスに転校してきたお嬢様。"},{"spoiler":false,"text":"自分の思い通りにいくのが当たり前だと思っている人格破綻者だが、実は、世間知らずで騙されやすい、超箱入り娘。"},{"spoiler":false,"text":"二人の幽霊に知らないうちに取り憑かれ、自分の記憶にない所で、色々しでかしている実態に頭を抱えている様子。"},{"spoiler":false,"text":"アパートに転がり込んで初めて庶民の生活を体験するが、セレブ暮らしとのギャップから、どこでも大騒動を巻き起こす。"}],"source":"egs","sourceCharacterId":"25723","sourceWorkId":"7339","spoiler":false},{"segments":[{"spoiler":false,"text":"转校到了主人公班上的大小姐。"},{"spoiler":false,"text":"是认为只要自己想就什么都能实现的人格缺陷者，"},{"spoiler":false,"text":"但实际上是个像大家闺秀一样的不懂世俗，本质老实容易被骗。"},{"spoiler":false,"text":"在不知不觉间被两名幽灵附身了，表面上看就像是多重人格。"},{"spoiler":false,"text":"虽然没有被附身时的那些记忆，但还是察觉到那些事是自己做出来的。"},{"spoiler":false,"text":"为寻求该问题的解决可能性而入住到主人公的公寓。"},{"spoiler":false,"text":"因为第一次的庶民生活和一直以来的有钱人生活差距而在学校和公寓里都引起大骚乱。"}],"source":"bangumi","sourceCharacterId":"11954"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"25723","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"25723","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"25723","sourceWorkId":"7339","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"25723","sourceWorkId":"7339","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e4696ffe9e17566f49e9018db938820b20b998045049e739b346c733f5f8606.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbfb48ede66a69909fea67d677bc1ee991e1f969a10bbc012052c36632193dc1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13636:11954:4956:1","source":"bangumi"}]},{"characterId":"char_c46689","characterName":"大宗路 沙希","sourceIds":{"bangumi":[{"characterId":"11956","match":"exact-normalized-name-in-linked-work","subjectId":"13636"}],