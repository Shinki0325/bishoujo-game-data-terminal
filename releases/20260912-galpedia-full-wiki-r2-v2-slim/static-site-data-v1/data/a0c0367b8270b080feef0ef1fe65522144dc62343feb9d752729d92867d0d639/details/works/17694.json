":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bc91ed481db0a4c6eeffc8c49245c561df746d3541d2eebe5e3088913ab9402.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e2dc57c59c71670cd146fd95045c55fee2d4a2d9ad6981c825ee73f143ebcd7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葉市 憂","creatorId":"vndb:s1219","sourcePersonId":"vndb:s1219","canonicalEntityId":"vndb:s1219","name":"葉市憂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51600","source":"vndb"}]},{"characterId":"char_c31349","characterName":"相崎 美由紀","sourceIds":{"bangumi":[],"egsCharacterIds":["944"],"vndbCharacterId":"c31349"},"originalCharacterName":"相崎 美由紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"職業：学生【岸野原学園】／魔法天使【ジャスティア所属】"},{"spoiler":false,"text":"おしとやかで優しさ溢れるしっかり者の女の子。"},{"spoiler":false,"text":"だが引っ込み思案(人見知り)な部分があり、自分から何かする事は少ない。"},{"spoiler":false,"text":"運動はあまり得意ではないが、それ以外の成績は抜群で、かなりの切れ者。"},{"spoiler":false,"text":"尚、ひかりとはクラスメイトである。"},{"spoiler":false,"text":"魔法少女として覚醒するも、性格上争いが苦手なため、当初はそれを隠し、戦わずにいようと考えていた。"},{"spoiler":false,"text":"だが他の魔法少女達が戦っている所を目の当たりにし、悪を許せないという思いが強くなったため、戦う事を決意する。"},{"spoiler":false,"text":"魔法少女としての能力は平均的だが、秀でた頭脳(判断力)で参謀役として戦いをサポートする。"},{"spoiler":false,"text":"ひかりと同じ理由で他支部へと派遣され、そして呼び戻される。"},{"spoiler":false,"text":"「その程度の作戦、見抜けて当然です!!」"}],"source":"egs","sourceCharacterId":"944","sourceWorkId":"17694","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cadd8af43b3fafc5e4026fd2c888240e53b373b8c84190ac8375c55d0146dd07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bb2abc89ad90719734f6feca0e51e2b34e78f7d9401a164a1e8d12682da25f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃 みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51598","source":"vndb"}]},{"characterId":"char_c31350","characterName":"西城 冴華","sourceIds":{"bangumi":[],"egsCharacterIds":["945"],"vndbCharacterId":"c31350"},"originalCharacterName":"西城 冴華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"職業：学生【岸野原学園】／魔法天使【ジャスティア所属】"},{"spoiler":false,"text":"負けず嫌い・高飛車と典型的なお嬢様。実家は超お金持ち。"},{"spoiler":false,"text":"考えるより先に口が出て、誰に対しても物怖じしない強気な性格の持ち主。"},{"spoiler":false,"text":"自慢癖や気取ったところはあるが、世話焼きな姉御肌の一面もあるせいか意外に友人は多い。"},{"spoiler":false,"text":"尚、ひかり・美由紀とはクラスメイトである。"},{"spoiler":false,"text":"素質は持っていたが、中々覚醒しなかった。"},{"spoiler":false,"text":"しかしフレアとアクアが戦っているのを見て、魔法少女として覚醒する。"},{"spoiler":false,"text":"日が浅いため、経験・知識面は全く持ち合わせていない。"},{"spoiler":false,"text":"魔法少女としての能力は、平均値より少し高い程度。"},{"spoiler":false,"text":"だが身体能力は群を抜いて高く、ひかりを凌駕する。"},{"spoiler":false,"text":"途中からひかり・美由紀と合流し、デスブランドを倒す事に。"},{"spoiler":false,"text":"「この私が、あんな雑魚に負けるはずないじゃない！」"}],"source":"egs","sourceCharacterId":"945","sourceWorkId":"17694","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a11b490608e85db546847a3961e307d2e252e417f820e14890cadbe76f7d023.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d4a441cb6627e91d2648498bd7b2f7dc01093509407229877aa73623abd9711.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vn