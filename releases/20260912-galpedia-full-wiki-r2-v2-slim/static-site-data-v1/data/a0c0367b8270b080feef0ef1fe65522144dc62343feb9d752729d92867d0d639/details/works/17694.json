alse,"text":"「お前達、やっておしまい !!」"}],"source":"bangumi","sourceCharacterId":"49711"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/613e35b77b67f9e1b0af3703dcfbb03502171ac8af5cdcd465431b2885614aec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9cf87a788c73b7a86849bc2cb8f8d94969be7653b22831fdf2c2e2cf83c94b3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66299:49711:22331:1","source":"bangumi"}]},{"characterId":"char_c32909","characterName":"進藤 沙希","sourceIds":{"bangumi":[{"characterId":"49712","match":"exact-normalized-name-in-linked-work","subjectId":"66299"}],"egsCharacterIds":["947"],"vndbCharacterId":"c32909"},"originalCharacterName":"進藤 沙希","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"職業：学生 (岸野原学園)、戦闘員兼事務員 (デスブランド)"},{"spoiler":false,"text":"常に元気で、周囲を明るくしてくれる女の子。"},{"spoiler":false,"text":"何事においても努力する頑張り屋で、周囲もそれを認めているが、若干天然な部分もあり、大事な部分で致命的なドジをする事も多々ある。"},{"spoiler":false,"text":"尚、ひかり・美由紀・冴華とはクラスメイトである。"},{"spoiler":false,"text":"(※お互いの正体には気付いていない)"},{"spoiler":false,"text":"実はデスブランドに勤務する女戦闘員。"},{"spoiler":false,"text":"任務に多少困惑する事があるが、その信念は強く、途中で放棄する事は決してない。"},{"spoiler":false,"text":"運動神経は良く、女戦闘員としては中の上程度の実力。"},{"spoiler":false,"text":"しかし本人は知らないが、将志同様秘められた素質の持ち主である。"},{"spoiler":false,"text":"「今日も訓練頑張ります!　ウーッ!!」"}],"source":"egs","sourceCharacterId":"947","sourceWorkId":"17694","spoiler":false},{"segments":[{"spoiler":false,"text":"女戦闘員。常に元気で周囲を明るくしてくれる女の子。"},{"spoiler":false,"text":"その信念は強く、途中で放棄することは決してない。"},{"spoiler":false,"text":"戦闘能力はそれほど高くないが、怪人としての潜在能力は主人公と同レベル。"},{"spoiler":false,"text":"普段は学生で、ひかりたちとはクラスメイト （お互いの正体には気付いていない）。"},{"spoiler":false,"text":"「今日も訓練頑張ります!　ウーッ!!」"}],"source":"bangumi","sourceCharacterId":"49712"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/091187ed6262d68320b9a140ea7e37249c0236447fe3b2a04ffd822bd087e2fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33f50e8526eedec408341cbfb1d7651e301c75861ce2520b8843c198b19639c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66299:49712:15684:1","source":"bangumi"}]},{"characterId":"char_c32910","characterName":"ヘレン・ケント","sourceIds":{"bangumi":[{"characterId":"49713","match":"exact-normalized-name-in-linked-work","subjectId":"66299"}],"egsCharacterIds":["948"],"vndbCharacterId":"c32910"},"originalCharacterName":"ヘレン・ケント","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"職業：監査官・研究員(女幹部)【デスブランド所属】"},{"spoiler":false,"text":"根っからのサディストで冷酷。"},{"spoiler":false,"text":"目的の為には手段を選ばない過激派で、卑劣な作戦を展開する事も。"},{"spoiler":false,"text":"また選民思想が強く、能力のない人間を見下し、切り捨てる。"},{"spoiler":false,"text":"ラグリアとは、幹部になる際一緒に訓練を受けた同期だが、性格が合わず犬猿の仲。(特にラグリアがヘレンの事を嫌っている)"},{"spoiler":false,"text":"実は、元ジャスティアに所属する魔法少女。"},{"spoiler":false,"text":"(正確には『超能力者(サイキッカー)』)"},{"spoiler":false,"text":"だが上辺だけの正義では何の役にも立たないと、自ら進んで悪へ。"},{"spoiler":false,"text":"デスブランドでは研究員として、改造手術・洗脳技術の部門で成果を出している。"},{"spoiler":false,"text":"また、対象者を監視・調査する『監査官』も務めており、今回上層部の命令で、ラグリアを監査するため派遣される。"},{"spoiler":false,"text":"「良い素質を持っているようだな。研究対象としては悪くない」"}],"source":"egs","sourceCharacterId":"948","sourceWorkId":"17694","spoiler":false},{"segments":[{"spoiler":false,"text":"根っからのサディストで冷酷な性格。"},{"spoiler":false,"text":"改造手術・洗脳技術の部門で成果を出している科学者だが、対象者を監視・調査する “監査官” も務めている。"},{"spoiler":false,"text":"元々は正義の魔法少女だったが、自ら進んで悪に堕ち現在の地位を得た。"},{"spoiler":false,"text":"「良い素質を持っているようだな。研究対象としては悪くない」"}],"source":"bangumi","sourceCharacterId":"49713"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37f0eab106c1f5820663bc1b7eae8cb73acd0a5e3bd1b47b24ca9e5ebf3180c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d492859d2806cb86199f0f5921c1c259aa2da9e340c8dd6f1babb93cc829558.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66299:49713:6480:1","source":"bangumi"}]},{"characterId":"char_c32911","characterName":"ユリ","sourceIds":{"bangumi":[{"characterId":"49714","match":"exact-normalized-name-in-linked-work","subjectId":"66299"}],"egsCharacterIds":["949"],"vndbCharacterId":"c32911"},"originalCharacterName":"ユリ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"職業：魔法少女・監査官補佐(ヘレンの部下)【デスブランド】"},{"spoiler":false,"text":"見た目は幼いが、れっきとした大人。"},{"spoiler":false,"text":"(巨大な魔力の影響を受け、成長が遅くなってしまった)"},{"spoiler":false,"text":"あまり感情を表に出さず話す事も少なく、ゴスロリな服装と相まって人形のよう。"},{"spoiler":false,"text":"だが一旦口を開けばかなりの毒舌で、上司のヘレンをも黙らせる程。"},{"spoiler":false,"text":"人との関わりを持とうとせず、一人(もしくはヘレンと一緒)でいる事が多い。"},{"spoiler":false,"text":"成長に影響を及ぼす程の巨大な魔力の持ち主で、その戦闘能力は一級。"},{"spoiler":false,"text":"下手な魔法少女が束になっても返り討ちにしてしまう。"},{"spoiler":false,"text":"ただ魔力の消費が激しく、たまに喘息発作のような事が起きる。"},{"spoiler":false,"text":"「どうしようもないくらい馬鹿ね。死んだ方が良いんじゃない?」"}],"source":"egs","sourceCharacterId":"949","sourceWorkId":"17694","spoiler":false},{"segments":[{"spoiler":false,"text":"悪の魔法少女。見た目は幼いが、れっきとした大人。"},{"spoiler":false,"text":"あまり感情を表に出さず、また話すことも少ない。"},{"spoiler":false,"text":"だが一旦口を開けばかなりの毒舌で、上司のヘレンをも黙らせるほど。"},{"spoiler":false,"text":"その戦闘力は凄まじく、ひかりと同等以上の力を持っている。"},{"spoiler":false,"text":"「どうしようもないくらい馬鹿ね。死んだ方が良いんじゃない？」"}],"source":"bangumi","sourceCharacterId":"49714"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae578693d02b0431f18955bb1b69fccd2d49dea9168b41e574a5f0e65d9242a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f534273014ab82fe02e47656ffe5b552f0e1d74457798f44d3aadfb64e28179d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞森柚子","creatorId":"egs:creator:36244","sourcePersonId":"egs:creator:36244","canonicalEntityId":"egs:creator:36244","name":"瑞森柚子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66299:49714:25171:1","source":"bangumi"},{"creditedName":"このえ ゆずこ","creatorId":"vndb:s995","sourcePersonId":"vndb:s995","canonicalEntityId":"vndb:s995","name":"このえ ゆずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51599","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p384","sourceCompanyId":"egs:brand:1869","canonicalEntityId":"vndb:p384","name":"HEAT-SOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17694:1869","source":"egs"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","n