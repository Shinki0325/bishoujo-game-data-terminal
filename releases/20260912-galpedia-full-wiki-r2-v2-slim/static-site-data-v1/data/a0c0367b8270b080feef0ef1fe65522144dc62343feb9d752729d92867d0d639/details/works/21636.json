lse,"text":"其美丽的脸孔从不流露一丝感情、向她告白的男性皆被那冰冷的视线刺穿了心房。"},{"spoiler":false,"text":"身缠冷静知性的氛围、可其实是手先出口后动的相当好强的类型。"},{"spoiler":false,"text":"在内心里对随着年龄的增长而逐渐变得可靠的主人公抱有思慕之情。"},{"spoiler":false,"text":"不过却介意着至今的关系与年长者的身份、一直都无法将心意告白。"},{"spoiler":false,"text":"·约定"},{"spoiler":false,"text":"「长大了与你结婚」"}],"source":"bangumi","sourceCharacterId":"38880"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c37efc3154a67d7ebaaca141dba44c316910d8c497ac67e00cf5f93489e5763.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df62b074c6ef2f1bcb8070706a73cac902b9ecdaa9f2c2b2d3d8588b878fd81f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126823:38880:6349:1","source":"bangumi"}]},{"characterId":"char_c29498","characterName":"宮内 アイリス","sourceIds":{"bangumi":[{"characterId":"38882","match":"exact-normalized-name-in-linked-work","subjectId":"126823"}],"egsCharacterIds":["6469"],"vndbCharacterId":"c29498"},"originalCharacterName":"宮内 アイリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"427"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おしかけ婚約者。"},{"spoiler":false,"text":"父が日本人、母がロシア人のハーフ。"},{"spoiler":false,"text":"母に似たために日本人には見えない容貌であり、幼い頃から好奇の目にさらされ、それが原因でからかわれもしたため、すっかりコンプレックスになっている。"},{"spoiler":false,"text":"性格は至って生真面目で、かなり勝ち気で、そしてかなりの天邪鬼。"},{"spoiler":false,"text":"冷静に見せかけて、実はかなり感情的になりやすい。"}],"source":"egs","sourceCharacte