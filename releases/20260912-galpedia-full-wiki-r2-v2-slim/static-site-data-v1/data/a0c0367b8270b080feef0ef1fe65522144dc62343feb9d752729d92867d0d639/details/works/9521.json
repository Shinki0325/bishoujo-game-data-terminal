h":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16345","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["557"],"vndbCharacterId":"c1519"},"originalCharacterName":"北嶋 楓","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1021"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An extremely shy and fairly nerdish girl. She is also Sara's cousin and is very protective of her. Second year student of St. Michael's Girl's Academy. She has been elected as class president two years in a row."}],"source":"vndb","sourceCharacterId":"c1519"},{"segments":[{"spoiler":false,"text":"ミカ女の2年生で、クラス委員長を務める才女。"},{"spoiler":false,"text":"眼鏡に三つ編みという比較的地味なイメージ。"},{"spoiler":false,"text":"性格はおとなしめで地味だが、責任感がありクラスの信頼も高い。"},{"spoiler":false,"text":"背も高く胸も大きいナイスバディの持ち主。"},{"spoiler":false,"text":"眼鏡＆三つ編み無しの姿が実は美少女であることが発覚し、現在は有名人に。"},{"spoiler":false,"text":"従妹の紗良とは校内の公認カップルで、楓からも積極的に愛情表現をする関係に。"}],"source":"egs","sourceCharacterId":"557","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の３年生で、クラス委員長を務める才女。眼鏡に三つ編みという比較的地味なイメージ。"},{"spoiler":false,"text":"性格はおとなしめで地味だが、責任感がありクラスの信頼も高い。背も高く胸も大きいナイスバディの持ち主。"},{"spoiler":false,"text":"従妹の紗良とは校内の公認カップルで、楓からも積極的に愛情表現をする関係に。"},{"spoiler":false,"text":"現在は紗良とペアで芸能活動をするハメになり、テレビにも出演する多忙な日々を送っている模様。"}],"source":"egs","sourceCharacterId":"557","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"二年级学生，性格内向，是个传统意义上的好孩子，也因此而朋友不多。每个学期都会被高票选为班长，但自己却不喜欢引人注目，又反而因自认为过于平庸而自卑，实际上相当受欢迎。一直很细心照顾堂妹纱良。另外，与松原优菜关系良好。"},{"spoiler":false,"text":"声：五行なずな(=小野涼子)"}],"source":"bangumi","sourceCharacterId":"16345"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b2e81feffc951b839f4a720908c3478783ac619fc43ca6f866fec23a137be2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf5bc87f114ac07c93eb837dc484b9a3e67866b896f7fe3c736045680c9b093d.webp","width":86,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5358:16345:4727:1","source":"bangumi"}]},{"characterId":"char_c1521","characterName":"松原優菜","sourceIds":{"bangumi":[{"characterId":"16346","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16346","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["556"],"vndbCharacterId":"c1521"},"originalCharacterName":"松原優菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1104"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year high school student. She is smart, attractive, popular and rich girl who is admired by the students of St. Michael's. Yet she falls in love with the clumsy and average Nanami."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c1521"},{"segments":[{"spoiler":false,"text":"ミカ女の2年生で、実質上の学生会である「環境整備委員会」の委員長で、両親は大病院の院長というお嬢様。"},{"spoiler":false,"text":"ややおっとりはしているものの、知的美人で性格も温厚。"},{"spoiler":false,"text":"スポーツ万能で巨乳の持ち主という正に完璧超人。"},{"spoiler":false,"text":"下級生はもちろん、上級生にまで慕われる学園のアイドル的存在だが、当人にその自覚はなくやや天然体質。"},{"spoiler":false,"text":"ところが……実はかなりの甘えん坊でエロ乙女。"},{"spoiler":false,"text":"で、身も心もめいっぱい尽くさないと気が済まない困った性格。"}],"source":"egs","sourceCharacterId":"556","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の３年生で、実質上の学生会である「環境整備委員会」の委員長で、両親は大病院の院長というお嬢様。"},{"spoiler":false,"text":"ややおっとりはしているものの、知的美人で性格も温厚。スポーツ万能で巨乳の持ち主という正に完璧超人。"},{"spoiler":false,"text":"相変わらずかなりの甘えん坊でエロ乙女。七海の事となると、なりふり構わず取り乱してしまう一面も。"},{"spoiler":false,"text":"委員長の引退を前に、恋人でもある七海相手に、猛スパルタの特訓中の毎日を過ごしているらしい。"}],"source":"egs","sourceCharacterId":"556","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"米卡女校二年级学生，环境整备委员会会长，在同学之间很吸引目光，是个各方面都很完美的大小姐，而内心十分天然呆以及好色。未来的志向是当医生。与织田七海邂逅的同时也喜欢上了她。"}],"source":"bangumi","sourceCharacterId":"16346"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9c072803dc6fbb6f24e92724427bc16b55006ea909060fd3e71c384d64c961c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3558bbc922b5417b53a3a81266db79cd6c97917360352188772a3f0c479c9aba.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩村琴美","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5358:16346:4813:1","source":"bangumi"}]},{"characterId":"char_c5858","characterName":"沢口 麻衣","sourceIds":{"bangumi":[{"characterId":"16343","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16343","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["559"],"vndbCharacterId":"c5858"},"originalCharacterName":"沢口 麻衣","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"918"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very responsible second year high school student who has some tomboy tendencies. She falls in love with Reo after getting to know a different side of her."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c5858"},{"segments":[{"spoiler":false,"text":"2年生で、幼稚舎からミカ女に通っている生粋のミカ女育ちだが、両親はフツーの共働き夫婦。"},{"spoiler":false,"text":"特にクラス委員というわけではないものの、面倒見のいい姉御的性格のせいか、頼りにされる事が多い模様。"},{"spoiler":false,"text":"当人的には「自分は庶民」と自覚。"},{"spoiler":false,"text":"ミカ女暮らしが長いので、天然お嬢様達の扱いは手慣れている。"},{"spoiler":false,"text":"そんな物怖じしない性格と行動的なところが人気で、下級生や上級生からラブレターをもらうことも珍しくない。"}],"source":"egs","sourceCharacterId":"559","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"３年生で、幼稚舎からミカ女に通っている生粋のミカ女育ちだが、両親はフツーの共働き夫婦。"},{"spoiler":false,"text":"特にクラス委員というわけではないものの、面倒見のいい姉御的性格のせいか、頼りにされる事が多い模様。"},{"spoiler":false,"text":"そんな物怖じしない性格と行動的なところが人気で、下級生や上級生からラブレターをもらうことも珍しくない。"},{"spoiler":false,"text":"クラスメイトの玲緒とは恋人同士で、現在は玲緒の部屋にほぼ毎日通っている、いわゆる通い妻状態。"}],"source":"egs","sourceCharacterId":"559","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"二年级学生，学习成绩和运动神经都相当不错，也擅长做家务，不是学生委员却非常有号召力，成为被大家像大姐姐一样依靠的人气焦点，连身为会长的松原优菜也很重视她，但她总是以生活在普通家庭中的“庶民”自嘲。因为帮助难以适应班级生活的玲绪而与她日渐亲密。"}],"source":"bangumi","sourceCharacterId":"16343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36a115cb6928b81254e5e0f9fe3d62942c928937e54307e0a1f3d4c05184559c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98c508a246ceb26b4e4091f8d731c6e973717574f3bdb7ac2eb0cef40dc83f77.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峯香織","creatorId":"vndb:s20187","sourcePersonId":"vndb:s20187","canonicalEntityId":"vndb:s20187","name":"峯香織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5358:16343:5481:1","source":"bangumi"},{"creditedName":"和泉 あやか","creatorId":"vndb:s493","sourcePersonId":"vndb:s493","canonicalEntityId":"vndb:s493","name":"和泉 あやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8717","source":"vndb"}]},{"characterId":"char_c5860","characterName":"川村 玲緒","sourceIds":{"bangumi":[{"characterId":"16344","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16344","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["560"],"vndbCharacterId":"c5860"},"originalCharacterName":"川村 玲緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"322"},"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A short second year high school student. She is antisocial, a tsundere and in love with Mai."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c5860"},{"segments":[{"spoiler":false,"text":"2年生で麻衣の同級生。母方は財閥系の裕福な家庭で、いわゆる箱入りのお嬢様。"},{"spoiler":false,"text":"だが玲緒自身は社交性が薄く、人見知りの激しい性格。"},{"spoiler":false,"text":"背は低めでかなりのちびっ子という幼児体型だが、ふわふわのロングの髪と整った顔立ちのせいで、可愛らしいと人気が高い。"},{"spoiler":false,"text":"が、麻衣以外にはまったく懐かない、ある意味猛獣の様な超ツンデレ少女。"},{"spoiler":false,"text":"両親は海外で暮らしており、一人マンション暮らし。"},{"spoiler":false,"text":"ただし家事は一切出来ず、放っておくとジャンクフードばかりの生活。"},{"spoiler":false,"text":"故に麻衣としては通い妻をする事に。"}],"source":"egs","sourceCharacterId":"560","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"３年生で麻衣の同級生にして恋人。いわゆる箱入りのお嬢様だが、社交性が薄く、人見知りの激しい性格。"},{"spoiler":false,"text":"背は低めで幼児体型だが、ふわふわのロングの髪と整った顔立ちのせいで、可愛らしいと人気が高い。"},{"spoiler":false,"text":"麻衣以外にはまったく懐かない、ある意味猛獣の様な超ツンデレ少女だったが、現在では気を許す友人もチラホラ。"},{"spoiler":false,"text":"両親は海外で暮らしており、一人マンション暮らし。通い妻状態の麻衣とはケンカしつつもラブラブな毎日。"}],"source":"egs","sourceCharacterId":"560","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"二年级学生，因为母亲离婚而转校。身材矮小，面貌也很像小学生。家境优越并且备受溺爱，性格傲娇并且叛逆，做事冒失，因此与同学关系不佳而被孤立。自称接受过知名声乐教师的指导，因此很擅长唱歌。在受到麻衣的帮助后变得越来越在意她。"}],"source":"bangumi","sourceCharacterId":"16344"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f0492c0b507bf30030a404fcf48d95ed3bb644172dd50e50ab3f07aca43a7ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/3410d9fcbed186acc9acd2d63e9ce7fc5f4310597c0980992c61be3c3f73b635.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"設楽麻美","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5358:16344:7904:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p437","sourceCompanyId":"egs:brand:1942","canonicalEntityId":"vndb:p437","name":"ふぐり屋","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9521:1942","source":"egs"},{"companyId":"vndb:p21699","sourceCompanyId":"vndb:p21699","canonicalEntityId":"vndb:p21699","name":"AleksaPsi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:126464:v925","source":"vndb"},{"companyId":"vndb:p21699","sourceCompanyId":"vndb:p21699","canonicalEntityId":"vndb:p21699","name":"AleksaPsi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:126491:v925","source":"vndb"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqd