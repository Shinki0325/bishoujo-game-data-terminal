originalCharacterName":"望月 真琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the protagonist's childhood friends. Also a honor student ojou-sama who is fond of study."}],"source":"vndb","sourceCharacterId":"c81821"},{"segments":[{"spoiler":false,"text":"主人公のもう一人で幼馴染で、勉強が出来る優等生のお嬢様。"},{"spoiler":false,"text":"一見クールな感じですが、情熱を秘めるタイプです。"},{"spoiler":false,"text":"お嬢様で、母親が厳しかったため、引っ込み思案でしたが、翼の明るさと、主人公の優しさで心開くことになりました。"}],"source":"egs","sourceCharacterId":"20736","sourceWorkId":"27481","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のもう一人で幼馴染で、勉強が出来る優等生のお嬢様。"},{"spoiler":false,"text":"一見クールな感じですが、情熱を秘めるタイプ。"},{"spoiler":false,"text":"お嬢様で、母親が厳しかったため、引っ込み思案だったが、"},{"spoiler":false,"text":"翼の明るさと主人公の優しさで心開くことに。"}],"source":"bangumi","sourceCharacterId":"74797"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f28068f8911909b516c6bad0c4b0d15c0b9ff6ef2f7283b673cd9514fdad989.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/877e401bf47414b23e79602885fa861c694f824e12b0b68d5881ba7795ddb752.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:238278:74797:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79868","source":"vndb"}]},{"characterId":"char_c82102","characterName":"古橋 綾菜","sourceIds":{"bangumi":[{"characterId":"74794","match":"exact-normalized-name-in-linked-work","subjectId":"238278"}],"egsCharacterIds":["20733"],"vndbCharacterId":"c82102"},"originalCharacterName":"古橋 綾菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuki's older sister, she serves as a gentle, motherly figure in his life after the death of their parents. She has a thoughtful, modest personality. She runs a coffee shop during the day while also taking care of the house where she, Kazuki, and Suzuna live."}],"source":"vndb","sourceCharacterId":"c82102"},{"segments":[{"spoiler":false,"text":"上の方の姉で、優しく母性の強い女性です。"},{"spoiler":false,"text":"思慮深く、万事控え目でしっかり物事を考えてから喋る性格です。"},{"spoiler":false,"text":"家庭的でもあり、古橋家の家事全般をこなしています。"},{"spoiler":false,"text":"日中は、喫茶店で働いています。"}],"source":"egs","sourceCharacterId":"20733","sourceWorkId":"27481","spoiler":false},{"segments":[{"spoiler":false,"text":"上の方の姉で、優しく母性の強い女性。"},{"spoiler":false,"text":"思慮深く、万事控え目でしっかり物事を考えてから喋る性格。"},{"spoiler":false,"text":"家庭的でもあり、古橋家の家事全般をこなしている。"},{"spoiler":false,"text":"日中は、喫茶店で働いている。"}],"source":"bangumi","sourceCharacterId":"74794"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80b3c73fa686d0f26d38b22fdf26c3f2d7192034e92d4971da3c3fca0e370c2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f0326849a7199dfeb8dcdf0975d844e173856bb054b8b9f501e54bb19d27915.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c82103","characterName":"古橋 涼菜","sourceIds":{"bangumi":[{"characterId":"74795","match":"exact-normalized-name-in-linked-work","subjectId":"238278"}],"egsCharacterIds":["20734"],"vndbCharacterId":"c82103"},"originalCharacterName":"古橋 涼菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The middle sibling, she is active, strong-willed, and intelligent. She has been studious and clever ever since her student days, and she has a serious, plain-spoken personality. She is a working professional who sustains the entire family financially. If Ayana serves as Kazuki's mother figure, Suzuna serve as the father figure. Because of this, Kazuki tends to be at the receiving end of her scoldings."}],"source":"vndb","sourceCharacterId":"c82103"},{"segments":[{"spoiler":false,"text":"下の方の姉で、行動派で気が強く、頭の良い女性です。"},{"spoiler":false,"text":"学生時代から利発で勉強が出来て、物事をハッキリ言う性格です。"},{"spoiler":false,"text":"現在では古橋家の大黒柱としてバリバリ働いていています。"},{"spoiler":false,"text":"綾菜が母親とすれば、涼菜は父親といった役割を担っています。"},{"spoiler":false,"text":"そのためか、少しばかり小言が多かったりもします。"}],"source":"egs","sourceCharacterId":"20734","sourceWorkId":"27481","spoiler":false},{"segments":[{"spoiler":false,"text":"下の方の姉で、行動派で気が強く、頭の良い女性。"},{"spoiler":false,"text":"学生時代から利発で勉強が出来て、物事をハッキリ言う性格。"},{"spoiler":false,"text":"現在では古橋家の大黒柱としてバリバリ働いている。"},{"spoiler":false,"text":"綾菜が母親とすれば、涼菜は父親といった役割を担っている。"},{"spoiler":false,"text":"そのためか、少しばかり小言が多かったりもする。"}],"source":"bangumi","sourceCharacterId":"74795"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8065157abeed9fc0b80ed32119e3f5aea52c658dcc7324e0ce625af5ea59fdb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c34986c951170a4bcab9c9df0712d65021ecd9302e3717e47a978bf2dd18e61.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor"