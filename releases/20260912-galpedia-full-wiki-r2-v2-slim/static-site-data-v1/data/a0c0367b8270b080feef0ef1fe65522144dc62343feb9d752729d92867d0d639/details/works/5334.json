{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"5334","model":{"presentationWorkId":"vndb:v1543","staff":{"artwork":[{"creditedName":"木本 達朗","creatorId":"vndb:s19877","sourcePersonId":"vndb:s19877","canonicalEntityId":"vndb:s19877","name":"木本 達朗","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:26049","source":"vndb"}],"scenario":[{"creditedName":"玉谷 純","creatorId":"vndb:s13491","sourcePersonId":"vndb:s13491","canonicalEntityId":"vndb:s13491","name":"玉谷 純","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:26046","source":"vndb"}],"music":[{"creditedName":"濱田 智之","creatorId":"vndb:s5526","sourcePersonId":"vndb:s5526","canonicalEntityId":"vndb:s5526","name":"濱田 智之","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:26041","source":"vndb"}],"other":[{"creditedName":"TWOFIVE","creatorId":"vndb:s1639","sourcePersonId":"vndb:s1639","canonicalEntityId":"vndb:s1639","name":"ツーファイブ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26040","source":"vndb"},{"creditedName":"貞本 義行","creatorId":"vndb:s6055","sourcePersonId":"vndb:s6055","canonicalEntityId":"vndb:s6055","name":"貞本 義行","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:26042","source":"vndb"},{"creditedName":"赤井 孝美","creatorId":"vndb:s6655","sourcePersonId":"vndb:s6655","canonicalEntityId":"vndb:s6655","name":"赤井 孝美","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26043","source":"vndb"},{"creditedName":"木谷 高明","creatorId":"vndb:s10618","sourcePersonId":"vndb:s10618","canonicalEntityId":"vndb:s10618","name":"木谷 高明","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26044","source":"vndb"},{"creditedName":"高橋 洋子","creatorId":"vndb:s11369","sourcePersonId":"vndb:s11369","canonicalEntityId":"vndb:s11369","name":"高橋 洋子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:26045","source":"vndb"},{"creditedName":"玉谷 純","creatorId":"vndb:s13491","sourcePersonId":"vndb:s13491","canonicalEntityId":"vndb:s13491","name":"玉谷 純","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:26047","source":"vndb"},{"creditedName":"渡辺 直行","creatorId":"vndb:s16289","sourcePersonId":"vndb:s16289","canonicalEntityId":"vndb:s16289","name":"渡辺 直行","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:26048","source":"vndb"},{"creditedName":"松本 仁美","creatorId":"vndb:s37411","sourcePersonId":"vndb:s37411","canonicalEntityId":"vndb:s37411","name":"松木 仁美","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26050","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_12410","characterName":"梅尔菲·樱叶","sourceIds":{"bangumi":[{"characterId":"12410","match":"source-roster","subjectId":"14916"},{"characterId":"12410","match":"source-roster","subjectId":"14917"},{"characterId":"12410","match":"source-roster","subjectId":"14918"},{"characterId":"12410","match":"source-roster","subjectId":"361992"},{"characterId":"12410","match":"source-roster","subjectId":"361993"},{"characterId":"12410","match":"source-roster","subjectId":"363"}]},"originalCharacterName":"梅尔菲·樱叶","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"156"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天使队的成员之一，有着粉红色的长发及灰色瞳孔，头上带着两朵花的饰品，个性善良是个十足的好人，脸上总是带着甜美的微笑，是个活泼又带点天然呆的女孩。"},{"spoiler":false,"text":"据说在军中上级给予极高的评价。"},{"spoiler":false,"text":"拥有宇宙里无人能抵的极端的好运及厄运。"},{"spoiler":false,"text":"兴趣是制作料理，喜欢做甜点类的点心，天使队的成员对于梅尔优的料理几乎都是赞不绝口。"},{"spoiler":false,"text":"与同期的兰花˙法兰波瓦兹从学生时代时就认识了，两人的感情从认识到现在从没变过，依然是非常要好的好朋友。"},{"spoiler":false,"text":"梅尔优˙樱叶还有一个妹妹，艾普莉可˙樱叶。"},{"spoiler":false,"text":"梅尔菲.樱叶的Milfeulle是外来语法文，意思就是西式点心里的千层派；而樱叶Sakuraba则是日式点心和果子里最常出现的材料，樱树叶片再浸渍后通常会拿去包麻糬一类的点心。"},{"spoiler":false,"text":"主题曲为“YOU GET A CHANCE!”"},{"spoiler":false,"text":"Project G.A. 的计划当初，声优是田村ゆかり"}],"source":"bangumi","sourceCharacterId":"12410"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a695aa79d1fb5624d527ebe7e8ab54fe4f20285e633756c31ea5c118911c1d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3edb344c8be4b8a161b295b9e24c956b615512e39ec8ee01a2cddf0bd8c8e109.webp","width":166,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_16110","characterName":"巧克力/ショコラ/Chocola","sourceIds":{"bangumi":[{"characterId":"16110","match":"source-roster","subjectId":"111789"},{"characterId":"16110","match":"source-roster","subjectId":"363"},{"characterId":"16110","match":"source-roster","subjectId":"41577"}]},"originalCharacterName":"巧克力/ショコラ/Chocola","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"148"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本名Chocola（法文：意指巧克力），Di Gi Charat星（数码星）的公主，有著腹黑的性格。可以从眼睛发射出“目からビーム”（眼睛射线／眼部火焰炮）。因为怀念母星Di Gi Charat而改名为与母星同名。说话时句尾会加上“Nyo”（喵）。"},{"spoiler":false,"text":"Di Gi Charat（日语：デ・ジ･キャラット；又译滴骰孖妹（香港无线电视）、铃铛猫娘（香港译名）、叮当小魔女（台湾译名））是Broccoli为其角色精品店所做的角色企画，原作者是小夏钝帆。由于其独特的造型，很快就成为了Broccoli的精品连锁店GAMERS的吉祥物，因大受欢迎亦被多次改编动画、电子游戏等。"},{"spoiler":false,"text":"デ・ジ・キャラット / ショコラ"},{"spoiler":false,"text":"声 - 真田アサミ（初代） / 明坂聡美（2代目）"},{"spoiler":false,"text":"本作の主人公。デ・ジ・キャラット星からやってきた王女様。通称「でじこ」。「フロムゲーマーズ」準備号（平成10年7月発行）で初登場。四コマ漫画「げまげま」に初登場したのは「フロムゲーマーズ」第壱号（平成10年8月発行）。準備号時点では名前がなく、「フロムゲーマーズ」第一号で名前と通称が決定した。"},{"spoiler":false,"text":"白猫の帽子に尻尾。ライトグリーンの髪で、髪飾りに大きな鈴（王家の印）を左右に1つずつ付ける。"},{"spoiler":false,"text":"語尾に「にょ」を付けて話す（ドラマCD版では「にゃ」と言っていたこともある）。この語尾について、ファンの間で「最初期の設定では『〜なんよ』であったが、キーボードで打つ際のミスタイプにより『〜なにょ』になり、それが定着した」という噂があったが、制作側はこの噂の存在を認めつつも、ネーム作成の時点ではパソコンが使用されないことを理由として公式に否定している。【注釈——「Di Gi Charat DVD-BOX すぺしゃるパーティー」 Disc10 Chapter1 において、ファンの間に噂があることを認め、またそれを明確に否定している。】"},{"spoiler":false,"text":"『CDドラマ デ・ジ・キャラットそにょ2』で本名が『ショコラ』だと判明。CDドラマだとデ・ジ・キャラット星から脱出する際に、父から王位継承者の証として『デ・ジ・キャラット』の名を授かっている。地球に降り立った後、ゲーマーズ社長にデ・ジ・キャラットは長いという理由で「でじこ」とあだ名を付けられた。【注釈——「CDドラマそにょ2」の過去の話で「ショコラ」と呼ばれている。ただし地球に降り立ってすぐに（CD「トラック2」の2分45秒進んだ所）ゲマの「待つゲマ～、でじこ～!!」という台詞がある。しかし、その他の過去のシーンでは全て「ショコラ」呼びなので、この段階での「でじこ」という発言は間違いだと考えられる。ちなみに、その後ゲーマーズ社長に「デ・ジ・キャラットは長いから縮めてでじこちゃんに」と言われて、「でじこ!?」と驚いているシーンが存在するので、やはりその前のシーンで「でじこ」呼びしているのは矛盾している。】"},{"spoiler":false,"text":"地球にやって来た目的は「大女優を目指すため」と「アナローグ星のデ・ジ・キャラット星襲撃から逃げるため」の2つあるが、実は両方ともが公式設定であり、作品によって異なる。"},{"spoiler":false,"text":"得意技は「目からビーム」で、好きな食べ物はブロッコリー。"},{"spoiler":false,"text":"外見とは裏腹に生意気、狡猾、そして迂闊な性格が一番の魅力。当初は「巨大化する」という設定があった（原作本等では「公然の裏設定」としてときどき使われる）。『ぱにょぱにょデ・ジ・キャラット』では小悪魔的な性格と打って変わって、好奇心旺盛で人助けに尽力する純粋な善人として描かれている。『デ・ジ・キャラットにょ』ではまねきねこ商店街で暮らす事になっているが、大抵の設定では秋葉原のゲーマーズにて女優を目指しながら働いている。『～ファンタジー』では記憶喪失になった。夏や冬にはコミケに走り、いおりん本を買いあさる。最近では業界に慣れたのか、当人も同人誌を描いていたりする。ワンダフル版アニメ第7話ではムラタクとミナタクをネタにした「やばい同人誌」を描こうとし、ゲマに咎められていた。"},{"spoiler":false,"text":"初代のでじこ（緑色の瞳）はいくつかのパターンがあってそれぞれについての繋がりの矛盾が言及された事は無いが2代目でじこ（赤い瞳）とは明確に別人であり、初代でじこが既にデ・ジ・キャラット星に帰っていてゲーマーズを統括しているという形だが、2代目は初代からアニブロゲーマーズを任された、という展開となっている。"},{"spoiler":false,"text":"2代目の正体は（株）ブロッコリーの女神と名乗る少女「ブロッコデス」。初代でじこが帰郷した際、留守を預かっていた。"},{"spoiler":false,"text":"《panyo panyo》中：思い込みが激しく、人が困っているのを黙って見ていられない性格。でもどこか抜けているので、大体失敗…。信念は｢みんなを幸せにする！｣こと。実はデ・ジ・キャラット星のお姫さま。"}],"source":"bangumi","sourceCharacterId":"16110"}],"profileFacts":[{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"16110","value":"花椰菜"},{"label":"性格","source":"bangumi","sourceCharacterId":"16110","value":"狡猾、狂妄、粗心（狡猾、小生意気、迂闊）"},{"label":"特技","source":"bangumi","sourceCharacterId":"16110","value":"眼睛光束（目からビーム）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cdd7e7966f758639a8f8a0fdbcecd82ed9de340326128ed5a024dfb6502bfbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dac3cc910df50812886e5c5560269aa27fa35bb91dd973c980493f301445df86.webp","width":133,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真田アサミ","creatorId":"vndb:s1712","sourcePersonId":"vndb:s1712","canonicalEntityId":"vndb:s1712","name":"真田 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:363:16110:3847:1","source":"bangumi"}]},{"characterId":"char_bangumi_25524","characterName":"ウォルコット・O・ヒューイ","sourceIds":{"bangumi":[{"characterId":"25524","match":"source-roster","subjectId":"363"}]},"originalCharacterName":"ウォルコット・O・ヒューイ","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"185"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トランスバール軍中佐でエンジェル隊を温かくも取り仕切る老人。エンジェル隊員達には中佐と呼ばれているが第3期55話の「いどうどん」ではエンジェル隊隊長とされている。飄々とした性格で、エンジェル隊を娘達と呼ぶ。エンジェル隊の失態でたびたび上司に怒られている。青年時代は特殊工作部隊F6（通称フェアリー隊）に在籍、奇しくもエンジェル隊の5人とよく似た隊員と行動を共にしていた(フェアリー隊はその後すぐに解散となった)。フォルテとは何かと縁があり、ストリート・チルドレン時代に出会っている。サイレントソルジャー戦ではフォルテを救出したりしている。異名は「白き超新星の狼」。自分の髭に誇りを持っており、けなされると激しく怒り、普段温厚である彼が大戦時代の彼に戻ってしまいその実力はフォルテの撃った弾丸を足で蹴り返すという並外れた力を持っている。現在身寄りはいない。意外に野心家だと思われる一面もある。趣味はチェス。ノーマッドが相手をしている。また少女漫画のコレクターでもあり、自室の隠し棚の中には大量のコレクションが収められている。ラジオドラマでは、今の職場は左遷ではなく志願だと言っている。"},{"spoiler":false,"text":"原作系でのタクトの位置にあたり、趣味はチェス、昼行灯的な行動、実は切れ者という設定など共通性は多く見られる。しかし、年齢、階級、エンジェル隊との関係で区別化が図られている。俳優の藤村俊二をモチーフとして作られ、名称も彼の愛称である「おひょいさん」からつけられた。"},{"spoiler":false,"text":"年齢：55　身長：185cm　階級：中佐"}],"source":"bangumi","sourceCharacterId":"25524"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b90f2515131247606b405234c9b3f0a5e5d1e4dba50c86185b14f807a54a059.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ee64066483d06aa587d3c41cb9e3c9b4d934236fced1847d995f08ade1b1af9.webp","width":209,"height":242,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_25635","characterName":"Normad","sourceIds":{"bangumi":[{"characterId":"25635","match":"source-roster","subjectId":"363"}]},"originalCharacterName":"Normad","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"你们不知拥有无比高度智慧的我何其苦恼。“"}],"source":"bangumi","sourceCharacterId":"25635"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e3a6a2d276dd6357ea56692f03265d74a40c0fa6b0c5e8f539860cbdbf5630f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c51ce99b13c9f81344d71221f453ce3139b478a620b858fc6e515192ee4d2f97.webp","width":256,"height":194,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_303","characterName":"绫波丽","sourceIds":{"bangumi":[{"characterId":"303","match":"source-roster","subjectId":"13534"},{"characterId":"303","match":"source-roster","subjectId":"237067"},{"characterId":"303","match":"source-roster","subjectId":"363"}]},"originalCharacterName":"绫波丽","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0330"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"有着蓝色短发与红色眼睛的瘦弱少女，EVA驾驶员第一适格者，驾驶零号机。EVA零号机启动实验事故中负重伤，初次登场时包扎有大量绷带。过去经历全部被抹消，资料显示为14岁，行为举止特别。"},{"spoiler":false,"text":"出生日期不明，在CD『エヴァンゲリオン THE BIRTHDAY OF Rei AYANAMI』由声优林原惠提议为2001年3月30日。"}],"source":"bangumi","sourceCharacterId":"303"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"303","value":"NERV/EVA零号機専属操縦者、第3新東京市立第壱中学校2年A組"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be971b949bbf37eb4e963f22c7eae3d53c252bf1c18e00cfe0d659fc110578e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12bb3ad28dc14ccaddfab0ddbef06e466ce585c7339bb1abfcf3316dce5b5987.webp","width":140,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_5986","characterName":"卡布奇诺/カプチーノ/Cappuccino","sourceIds":{"bangumi":[{"characterId":"5986","match":"source-roster","subjectId":"363"},{"characterId":"5986","match":"source-roster","subjectId":"41577"}]},"originalCharacterName":"卡布奇诺/カプチーノ/Cappuccino","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0121"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"103"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"18"}},"descriptions":[{"segments":[{"spoiler":false,"text":"プチ・キャラット / カプチーノ（卡布奇诺）"},{"spoiler":false,"text":"声 - 沢城みゆき（初代） / みなかみ菜緒（2代目）"},{"spoiler":false,"text":"でじこの妹分。通称「ぷちこ」。「フロムゲーマーズ」平成11年7月号（6月24日発行）で初登場。当時は名前がなく、翌1998年8月に名前と通称が決定した。デ・ジ・キャラット星の出身。語尾に「にゅ」を付けて話す。"},{"spoiler":false,"text":"『CDドラマ デ・ジ・キャラットそにょ2』で本名が『カプチーノ』だと判明。"},{"spoiler":false,"text":"妹分となった経緯は、昔でじこに穴にはまっていたところを助けられたかららしい。茶色の髪に虎猫の帽子と尻尾。初期ではセーラー服（下はちょうちんブルマー）という設定だったが、「デ・ジ・キャラットにょ」では青いワンピースであり、パンツが丸見えとなっていた。ロングの髪を左右に分けて先でくくっている。口数は少なく、たまに発する一言がすごく毒舌でいざというときは行動派。でじこと同じく「めからびーむ」が出せるが、成功率は低く、謎のゲルや煙や水が出たりと失敗が多い。好物は公式ではレアステーキだが、アニメやアンソロジーでは刺身や納豆などとなっている。大の荒くれ者。"},{"spoiler":false,"text":"2代目の正体は後述のほっけみりん。前述のブロッコデスによって姿を変えられていた。"},{"spoiler":false,"text":"《panyo panyo》中：冷静沈着。あまり感情を外に出さない。ボソッと言った事が、的を得たものだったり、段取りなしで突飛だったりする。実はとっても寂しがりや。"},{"spoiler":false,"text":"在《超次元游戏海王星》系列中，该人设作为Broccoli公司的代表角色登场，名字即为Broccoli（ブロッコリーちゃん），但称自己不是布子。"}],"source":"bangumi","sourceCharacterId":"5986"}],"profileFacts":[{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"5986","value":"纳豆、生牛排（原设）"},{"label":"性格","source":"bangumi","sourceCharacterId":"5986","value":"模糊（ぼんやりさん）"},{"label":"特技","source":"bangumi","sourceCharacterId":"5986","value":"不成熟的眼睛光束（めからびーむ）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46921d3fa1a24dba8a0fb59468eef506d83d63479bbb445da3147b439c405c4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e77bd2d1d8cf15dd890d18a8330a4bd9c804981e97bceb5f94f2bc1031021df4.webp","width":161,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p412","sourceCompanyId":"egs:brand:730","canonicalEntityId":"vndb:p412","name":"ブロッコリー","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:5334:730","source":"egs"},{"companyId":"vndb:p1331","sourceCompanyId":"vndb:p1331","canonicalEntityId":"vndb:p1331","name":"3DM GAMES","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:130