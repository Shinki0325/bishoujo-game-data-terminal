{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"34191","model":{"presentationWorkId":"egs:34191","staff":{"artwork":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:293882","source":"egs"}],"scenario":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"alias-only-review","relationId":"egs:work-creator:293883","source":"egs"}],"music":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"music","roleLabel":"作品音乐","identityStatus":"alias-only-review","relationId":"egs:work-creator:293884","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_102028","characterName":"饕餮 尤魔","sourceIds":{"bangumi":[{"characterId":"102028","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"饕餮 尤魔","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"子羊の姿の神獣。"},{"spoiler":false,"text":"貪欲で大食漢で、実体霊体、有機体無機体問わず、何でも丸呑みし食べてしまう。"},{"spoiler":false,"text":"さらに呑み込んでしまう事で、その物を理解し、自分の力にしてしまう。"},{"spoiler":false,"text":"呑み込んだ物は、性格にも影響を与えるらしい。"},{"spoiler":false,"text":"畜生界の組織、剛欲同盟(ごうよくどうめい)の同盟長である。"},{"spoiler":false,"text":"剛欲同盟は徒党を組んで目立つような事をせず、大局的に物を見て、"},{"spoiler":false,"text":"機が熟したときに、楽して全てを奪おうと企む組織である。モットーは『漁夫の利』。"},{"spoiler":false,"text":"彼女は不誠実で卑怯な手段が大好きだと、他の組織には倦厭されているが、"},{"spoiler":false,"text":"部下には「無敵に等しい能力を持っていて、頼りになりすぎるボス」と慕われている。"},{"spoiler":false,"text":"本人は、部下を持っことには執着せず、何でも自分で行動したがるようだ。"},{"spoiler":false,"text":"そんなボスに感化されてか、剛欲同盟は各々自分達で勝手に行動する者が多い。"},{"spoiler":false,"text":"彼女はああ見えて賢く、そして冷静で、無駄な争いは避ける性質を持っている。"},{"spoiler":false,"text":"敵が、脅しても上手くいかない相手だと判断した場合、抱き込む事を検討する。"},{"spoiler":false,"text":"それも上手くいかないと判断したら、表面的ても協力関係を結ぶことを試みる。"},{"spoiler":false,"text":"それも難しいと判断した場合、早々と撤退を選択する。"},{"spoiler":false,"text":"弱肉強食、暴力こそ正義の畜生界の中では異質の組織である。"},{"spoiler":false,"text":"全面戦争といった選択肢を取るのは、剛欲同盟的には、本当の最後の手段なのだ。"},{"spoiler":false,"text":"今回は動物霊のドタバタ騒ぎの隙をついて、旧血の池地獄に目を付け、"},{"spoiler":false,"text":"畜生界のみならず地上の欲を全て手に入れようと企んでいたが、"},{"spoiler":false,"text":"その企みは地上の秘神の手によって人間にばらされ、"},{"spoiler":false,"text":"そして対饕餮に仕上げられた刺客の手によって、一度破壊されてしまう。"},{"spoiler":false,"text":"再生後、彼女は石油の独占を諦め、秘神と協力関係を結ぶのだった。"}],"source":"bangumi","sourceCharacterId":"102028"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"102028","value":"饕餮"},{"label":"能力","source":"bangumi","sourceCharacterId":"102028","value":"什么都能吸收程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/858b1eb78679c6fc471304a94a35dec5274890222c551f372f8670a44f4df984.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9de12d046723537aa0034ca3fc29ccbd04c9b1fe4a01a82f8b805a4aceaf2c0b.webp","width":256,"height":219,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_135353","characterName":"孫　美天","sourceIds":{"bangumi":[{"characterId":"135353","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"孫　美天","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"135353","value":"猿神"},{"label":"能力[兽王园]","source":"bangumi","sourceCharacterId":"135353","value":"野生の猿を操る程度の能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b