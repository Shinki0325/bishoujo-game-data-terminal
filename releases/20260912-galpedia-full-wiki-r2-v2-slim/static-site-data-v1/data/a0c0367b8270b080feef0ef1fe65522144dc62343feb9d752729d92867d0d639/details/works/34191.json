eight":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_18971","characterName":"缝隙妖怪之式神","sourceIds":{"bangumi":[{"characterId":"18971","match":"source-roster","subjectId":"1148"},{"characterId":"18971","match":"source-roster","subjectId":"1153"},{"characterId":"18971","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"缝隙妖怪之式神","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"八雲紫的式神(妖怪狐)。其名字是紫給她取的。紫睡著的時間代替紫出外活動。雖然是式神，但因為擁有著強大的靈力，所以她也有著名為「橙」的式神。『永夜抄』的Good Ending中，藍因為是人氣較少的妖怪，因此很容易被月光影響，看到久違的滿月後心情有點興奮起來。"},{"spoiler":false,"text":"一方面，對身為主人的紫看到滿月後心境依然顯得十分平靜這一點感到十分敬佩。可是在『文花帖（書籍）』中，因為於『妖妖夢』Extra中擅自挑戰靈夢一行人，而被紫懲罰了。因為式神是根據數式而製造出來的東西，所以同樣擁有式神的藍也是很擅長數學，在『文花帖（書籍）』藍自己的記事中指出，她是以開發求取三途之川的長度的方程式來消遣。根據『求聞史紀』記述，因為狐狸喜歡油豆腐，因此如果碰到她的話，給她油豆腐然後趁機逃跑就可以。"}],"source":"bangumi","sourceCharacterId":"18971"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"18971","value":"妖怪（九尾狐）"},{"label":"能力","source":"bangumi","sourceCharacterId":"18971","value":"使役式神程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd00a996f8ee7b20d6ecd5d9fcbf8fed73f8b584e5fb5d4878dec6d6fb0d79e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30e16fccf61572628d2486fd0988e2048583509460b274e5983b2c67f887a960.webp","width":139,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29687","characterName":"Kaenbyou Rin","sourceIds":{"bangumi":[{"characterId":"29687","match":"source-roster","subjectId":"1155"},{"characterId":"29687","match":"source-roster","subjectId":"430567"},{"characterId":"29687","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"Kaenbyou Rin","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df1127ea2536fc077cfc97b201805aa85d78fdb417050a3e1a21d8d6c38edcdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b08b01f5455839f1e7aa60cb3325c869f048320528e43f56652d6dbeeef39d87.webp","width":201,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_30146","characterName":"ふたついわ まみぞう","sourceIds":{"bangumi":[{"characterId":"30146","match":"source-roster","subjectId":"104009"},{"characterId":"30146","match":"source-roster","subjectId":"12696"},{"characterId":"30146","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"ふたついわ まみぞう","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"从外面的世界到来，非常稀有的妖怪狸。比起在幻想乡内独自进化的妖怪，她拥有着古典的姿态和能力。"},{"spoiler":false,"text":"原本她似乎是妖怪狸的首领，有着相应的威严和领导风范，成为新势力的发源可能性很高。"},{"spoiler":false,"text":"幻想乡原本是栖息了很多妖怪狸的，所以那些野生狸或许有和外来的她联合起来互相关照的必要。"},{"spoiler":false,"text":"虽说变身的能力就是不光是自己的姿态，是甚至可以将其他物体也变化的能力，但因为那是跟幻觉没什么分别的东西，所以她是无法制造出无中生有的幻像。无论想要欺骗谁，还是需要一个原本存在的物体的。即使那个物体在变化后也无法变成与其变化对象十分接近的物体，大概马上会被揭穿。例如说，即使狗变身成鸟，却还是不能飞翔，所以马上就会穿帮了。只是外观看上去不同，但性质是几乎没有变化的。"},{"spoiler":false,"text":"还有，她本人变身时多是无法藏起尾巴的。这说法基本上在全部妖怪狸、妖怪狐狸上都适用，虽然完全藏起尾巴和耳朵是不可能的，但在看不见的位置缩小或是涂上保护色之类伪装成看不见的也是可以。只不过一旦被动摇、紧张或是激动时耳朵和尾巴就会露出来，非常的显眼。"},{"spoiler":false,"text":"此外，尾巴的大小其实就是妖力的计量表，这大抵都是妖兽的宿命吧。"},{"spoiler":false,"text":"这样的她，从最初开始就没有藏起自己尾巴的打算。说是，尾巴大是作为妖兽功力高强的缘故，这样子。"},{"spoiler":false,"text":"有远视并且不时会皱眉头，也会用上了年纪的臭口气说话，说不定这只也是她变身出来的姿态，事实上已经非常的老迈吧（×1 妖怪狸是没有所谓正体的东西）。"}],"source":"bangumi","sourceCharacterId":"30146"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46b3fe8556c71fc8a06c1a2ea47136839b88b35a709ca6fe2f2dbc30f32fded3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34a7ccd1bcc14388ceeeb66f23e889afd1abdf43c4cadd30f41ea9557918a55b.webp","width":119,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_39261","characterName":"Seiran","sourceIds":{"bangumi":[{"characterId":"39261","match":"source-roster","subjectId":"131875"},{"characterId":"39261","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"Seiran","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"浅葱色的Eagle Rabbit"},{"spoiler":false,"text":"名副其实的炮灰。"},{"spoiler":false,"text":"在被称为Eagle Rabbit的地面调查部队之中"},{"spoiler":false,"text":"负责潜伏渗透这项最危险的工作。"},{"spoiler":false,"text":"尽管工作危险，薪水却很低。"},{"spoiler":false,"text":"月兔虽然都有心灵感应能力，"},{"spoiler":false,"text":"但从不会认真进行交谈。"},{"spoiler":false,"text":"似乎是在休息中为伙伴捣年糕时遭到了袭击。"},{"spoiler":false,"text":"虽然漫长地进行着调查，但一直得不到月之民的进攻指示。"},{"spoiler":false,"text":"实在是厌倦了。"}],"source":"bangumi","sourceCharacterId":"39261"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"39261","value":"月兔"},{"label":"能力","source":"bangumi","sourceCharacterId":"39261","value":"从异次元发射子弹程度的能力（绀珠传）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdaff91bc1a6470c51bc7469ccc70bd5bcc84fb1ef3b19a75d7118ef9726d6c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc94767635390b290d7657ff44c74abfd04d0fc3d00f0913b23299c579a33322.webp","width":142,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_485","characterName":"博麗靈夢","sourceIds":{"bangumi":[{"characterId":"485","match":"source-roster","subjectId":"104009"},{"characterId":"485","match":"source-roster","subjectId":"1146"},{"characterId":"485","match":"source-roster","subjectId":"1148"},{"characterId":"485","match":"source-roster","subjectId":"1150"},{"characterId":"485","match":"source-roster","subjectId":"1151"},{"characterId":"485","match":"source-roster","subjectId":"1153"},{"characterId":"485","match":"source-roster","subjectId":"1155"},{"characterId":"485","match":"source-roster","subjectId":"1157"},{"characterId":"485","match":"source-roster","subjectId":"1160"},{"characterId":"485","match":"source-roster","subjectId":"12696"},{"characterId":"485","match":"source-roster","subjectId":"131875"},{"characterId":"485","match":"source-roster","subjectId":"1395"},{"characterId":"485","match":"source-roster","subjectId":"2134"},{"characterId":"485","match":"source-roster","subjectId":"329342"},{"characterId":"485","match":"source-roster","subjectId":"430567"},{"characterId":"485","match":"source-roster","subjectId":"5752"},{"characterId":"485","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"博麗靈夢","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幻想乡境内博丽神社的现有巫女。"},{"spoiler":false,"text":"博丽神社是专门守护幻想乡不可缺少的大结界的神社。博丽的巫女代代以解决异变为事业。"},{"spoiler":false,"text":"她是历代巫女中最缺乏危机感的一位，不知是因为修行不足，还是因为已经拥有足够的实力。"},{"spoiler":false,"text":"她天生地幸运和敏锐，也退治了不少妖怪。"}],"source":"bangumi","sourceCharacterId":"485"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"485","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"主要是在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"作为博丽巫女的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"操纵灵气的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33007c417ade7c73b7ee78244285c2ff601da86919605a6f56c0570deb01c0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc26d83763ce8144e0a342eaeb5a41bf3e1756ec782d0268170ef9bac39c8489.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_486","characterName":"霧雨魔理沙","sourceIds":{"bangumi":[{"characterId":"486","match":"source-roster","subjectId":"104009"},{"characterId":"486","match":"source-roster","subjectId":"1146"},{"characterId":"486","match":"source-roster","subjectId":"1148"},{"characterId":"486","match":"source-roster","subjectId":"1150"},{"characterId":"486","match":"source-roster","subjectId":"1151"},{"characterId":"486","match":"source-roster","subjectId":"1153"},{"characterId":"486","match":"source-roster","subjectId":"1155"},{"characterId":"486","match":"source-roster","subjectId":"1157"},{"characterId":"486","match":"source-roster","subjectId":"1160"},{"characterId":"486","match":"source-roster","subjectId":"12696"},{"characterId":"486","match":"source-roster","subjectId":"131875"},{"characterId":"486","match":"source-roster","subjectId":"1395"},{"characterId":"486","match":"source-roster","subjectId":"2134"},{"characterId":"486","match":"source-roster","subjectId":"329342"},{"characterId":"486","match":"source-roster","subjectId":"430567"},{"characterId":"486","match":"source-roster","subjectId":"5752"},{"characterId":"486","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"霧雨魔理沙","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"居住于魔法森林的人类魔法使，常骑着扫把，「霧雨店」的独生女。會使用魔法森林的蘑菇調製火藥，所使用的魔法幾乎只有把東西破壞的效果，而且燃料需要長時間準備，但是其效果非常強力，在Spell Card規則成立下，純粹的破壞力在人類當中屬於最高等級。此外在幻想乡是出了名的小偷，帕邱莉的图书馆、香霖堂，如果不是古明地觉会读心术，甚至连地灵殿都会惨遭毒手。"}],"source":"bangumi","sourceCharacterId":"486"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"486","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"486","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e00e4df671f5f80d5733c44e4b69596b901aad88177fc335789c2dd5ea6b2d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bd6c6ab5c1df20f216ccf8f7e1581841d4fed04fe2cad0f92ce726df7fb8d1.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_489","characterName":"纳兹琳","sourceIds":{"bangumi":[{"characterId":"489","match":"source-roster","subjectId":"1395"},{"characterId":"489","match":"source-roster","subjectId":"430567"},{"characterId":"489","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"纳兹琳","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"虽然她是寅丸星的使魔鼠妖，但是实际上她是真正的毘沙门天派来的高等级妖怪。是派来帮助和监视寅丸星工作的。"},{"spoiler":false,"text":"她的特技是探宝。所谓的探宝，本意是指搜寻地下埋藏的水脉，但是她的能力并不仅限于此，更多的时候是在探寻财宝。"},{"spoiler":false,"text":"一般的探宝的方法，会到使用探测棒，震动摆探测器等。但是她是使用野生老鼠来作为探测器的。因为无论是多么狭小或者深邃的地方都能钻进去，所以可以通过听声辨位来确认所寻之物的所在处。"},{"spoiler":false,"text":"也并非是什么样的东西都可以找到。那些太大的东西（×1 太大的东西老鼠反而看不见。）、如同饵食一样能吃的东西（×2 会吃掉的。）、活着的动物（×3 猫。），都不是它们擅长寻找的东西。还有，让老鼠收集那些它们无法辨识、无法理解的东西，也是比较困难的。"},{"spoiler":false,"text":"虽然她的身材不大，但是性格却是出奇的骄傲自大。不过这是因为有毘沙门天做她的后盾，其实她的性格是比较胆小的。一旦遇到什么可怕的事情立刻就逃之夭夭了。"}],"source":"bangumi","sourceCharacterId":"489"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"489","value":"鼠妖"},{"label":"能力","source":"bangumi","sourceCharacterId":"489","value":"要搜寻东西就能搜寻到的能力（星莲船、求闻口授）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b6a6f96cfaf5d5063c42785b3e386e769c073e92a6e656678ac6fd1f6328081.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cba464b83875f3464f6b9958ffcc371ddd61b045cb6bad8e4a53ccdb14c960a.webp","width":157,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_491","characterName":"萃集的梦想、虚幻、以及百鬼夜行","sourceIds":{"bangumi":[{"characterId":"491","match":"source-roster","subjectId":"1153"},{"characterId":"491","match":"source-roster","subjectId":"1155"},{"characterId":"491","match":"source-roster","subjectId":"2134"},{"characterId":"491","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"萃集的梦想、虚幻、以及百鬼夜行","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伊吹萃香是不知为何会出现在幻想乡的鬼，由于幻想乡有相当长的时间没出现过鬼，对于驱鬼的方法已经失传许久，没人会退治鬼，大家都感到为难。因此萃香和其他的鬼才能定居下来。"},{"spoiler":false,"text":"虽然外表是一个小女孩，看上去并不吓人，但她是一只已活了几百年的鬼，拥有将事物集结与分散程度的能力，和着让人害怕的怪力。她曾夸下海口，只要她想，就能凭一人之力将妖怪之山推倒。"},{"spoiler":false,"text":"萃香十分喜欢喝酒，常带着一个酒葫芦并喝得醉醺醺的，在东方的三款格斗游戏中，都可以看到她走路是摇摇晃晃的。其原形来自于鬼头目之中的“酒吞童子”。"},{"spoiler":false,"text":"性格豪爽，喜欢酒与宴会，天真而且单纯，喜欢和人一较高下，像是小孩子的性格。"},{"spoiler":false,"text":"其名字“萃香”与“西瓜”的日文发音相同，故昵称为“西瓜”。"}],"source":"bangumi","sourceCharacterId":"491"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"491","value":"鬼"},{"label":"能力","source":"bangumi","sourceCharacterId":"491","value":"操纵疏和密程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b26c2b4a7516dd3021fca524fbac36766a3a15ac6c0f0608e8985f863fd908e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cf3c4a5114c940dc5fe2dbcd5a1e16e20ce962712501a7e576be5ba0e14de42.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_62304","characterName":"こまの あうん","sourceIds":{"bangumi":[{"characterId":"62304","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"こまの あうん","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"狛犬。一个人，拥有狮子和狛犬两种性质。"},{"spoiler":false,"text":"博丽神社、守矢神社、命莲寺，她找出这类可能会聚集人类信仰的场所"},{"spoiler":false,"text":"然后赖在那里，自说自话的开始进行守护。"},{"spoiler":false,"text":"平时不显现出身姿，只有持有敌意的人出现的时候才会发挥她的力量，"},{"spoiler":false,"text":"话虽如此，结果因为并不是很强所以经常输。"},{"spoiler":false,"text":"因为神社的樱花非常漂亮，她在博丽神社赏花的时候这次的骚动开始了。"},{"spoiler":false,"text":"本来想喝点酒放置不理的，但不知道为啥被当成目标发展成了战斗。"},{"spoiler":false,"text":"和巫女战斗对她来说应该是违背意愿的战斗，但不知为何打得很高兴。"},{"spoiler":false,"text":"她发现自己的心中有什么看不见底的灵力，感觉到背上有冰冷的东西流过。"},{"spoiler":false,"text":"她醒悟到在幻想乡里，虽然还不知道在哪里，有什么无比重要的东西被刻意的隐藏了起来。"}],"source":"bangumi","sourceCharacterId":"62304"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"62304","value":"狛犬"},{"label":"能力","source":"bangumi","sourceCharacterId":"62304","value":"发现神佛程度的能力（天空璋）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f4a6b8e86c6444d0e6dbf0eb96f35eadd1d4ff420525145c983b42f30978b0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be24c6a9848e82814b2075f3399bff5e01da36c23eddfbb4507bb410c536c64c.webp","width":123,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_71306","characterName":"くろこま さき","sourceIds":{"bangumi":[{"characterId":"71306","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"くろこま さき","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"劲牙组的组长。"},{"spoiler":false,"text":"还没等动物灵们当初毫无还手之力的灵长园的袿姬被打倒的消息传遍畜生界，她就立刻展开了下一步行动。"},{"spoiler":false,"text":"她认为，只要袿姬不在，自己支配畜生界只是时间的问题，因此在那之前先视察一下人界，"},{"spoiler":false,"text":"如果可能的话就直接支配。"},{"spoiler":false,"text":"她做出决定之后就会立刻行动。"},{"spoiler":false,"text":"她尊重部下的想法和功绩等等，作为一个组织的上司，算是比较受欢迎的（然而工作方面依旧黑心）"},{"spoiler":false,"text":"她喜欢有实力的人才，就算对方与自己为敌也是如此。"},{"spoiler":false,"text":"她虽然和吉吊、袿姬都合不来，但她尊敬她们非凡的实力。"}],"source":"bangumi","sourceCharacterId":"71306"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"71306","value":"骊驹"},{"label":"能力","source":"bangumi","sourceCharacterId":"71306","value":"拥有无与伦比的脚力程度的能力（鬼形兽）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5782d542c6a5a9453f8e54d8f419483c8078b77d9690ba2b0cd90db7983b318.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/eff2d6bff903009d2dba64dde89ca4fcf97dd808177ae2093691418f1285f388.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_71309","characterName":"きっちょう やちえ","sourceIds":{"bangumi":[{"characterId":"71309","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"きっちょう やちえ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"畜生界，是一个究极的弱肉强食的世界。"},{"spoiler":false,"text":"这世界被强者顺着自己的欲望支配着……本应如此，但一些较为狡猾的人开始形成组织，"},{"spoiler":false,"text":"如今已经化作了被几个巨大组织支配着的世界。"},{"spoiler":false,"text":"几乎全部的动物灵靠单体已经没有胜算，只能隶属于某个组织，永远作为奴隶进行战斗，"},{"spoiler":false,"text":"这是生存下去的唯一手段。"},{"spoiler":false,"text":"就算所有人已经疲惫不堪，组织的行动也无法被阻止。"},{"spoiler":false,"text":"以拥有强健的脚力、獠牙和肉体为特征的动物灵们所构成的组织——劲牙组。"},{"spoiler":false,"text":"擅长从土中、水中、阴影中等处进行奇袭的动物灵们所构成的组织——鬼杰组。"},{"spoiler":false,"text":"或是从空中、或是利用压倒性的身体大小，从俯瞰视角进行战斗的动物灵组织——刚欲同盟。"},{"spoiler":false,"text":"擅长陷阱、投毒、寄生、拟态等等各种卑鄙手段的动物灵们所组成的不明组织，诸如此类。"},{"spoiler":false,"text":"这些巨大畜生组织争抢着畜生界的占有率。"},{"spoiler":false,"text":"在此之中，有着一种被所有组织役使着的完完全全的奴隶。"},{"spoiler":false,"text":"力量微小，手头却灵巧的生物——灵长类，也就是人类的灵。"},{"spoiler":false,"text":"这些畜生组织的支配层，为了不让万能奴隶人类断绝，建立了一个保护设施。"},{"spoiler":false,"text":"这个保护设施名为灵长园。"},{"spoiler":false,"text":"唯有在灵长园欣赏这些不具备抵抗手段的人类时，各个组织都会忘记斗争。"},{"spoiler":false,"text":"灵长园也是畜生界的和平的娱乐设施。"},{"spoiler":false,"text":"然而，这成了他们最大的失败。"},{"spoiler":false,"text":"将作为单体完全无力的人类之灵聚集在一处，最终导致了毁灭性组织的诞生。"},{"spoiler":false,"text":"人类的灵诅咒手无缚鸡之力的自己，向神祈求。"},{"spoiler":false,"text":"神也回应了人类的祈求，向人类给予了信仰的偶像。"},{"spoiler":false,"text":"信仰的力量是革命性的。"},{"spoiler":false,"text":"有了信仰心的人类灵不再畏惧动物灵。"},{"spoiler":false,"text":"在原本只能凭借一己之欲进行活动的畜生界中，人类灵变得能够循着利他精神进行活动，是很重要的。"},{"spoiler":false,"text":"然而实际上真正拥有了力量的并非是人类灵，而是偶像。"},{"spoiler":false,"text":"人类灵原本只是皈依于存在于偶像背后的神性，却逐渐开始信仰起偶像本身来。"},{"spoiler":false,"text":"结果，自然而然地，偶像开始支配人类。"},{"spoiler":false,"text":"灵长园受偶像支配，人类灵的地位再次跌落到了谷底。"},{"spoiler":false,"text":"被偶像支配的灵长园，成为了最为凶恶的失控组织。"},{"spoiler":false,"text":"偶像跳出灵长园，也开始支配起畜生界。"},{"spoiler":false,"text":"面对不具备肉体、灵魂、欲望的偶像们，畜生们毫无还手之力。"},{"spoiler":false,"text":"这样下去畜生界就会被偶像所支配，最终化作废墟。"},{"spoiler":false,"text":"然而畜生们也不会坐等自己被支配。"},{"spoiler":false,"text":"擅长奇袭的鬼杰组，为了起死回生建立了打倒偶像的作战计划。"},{"spoiler":false,"text":"那就是“卷入地上的人类，借用人类之手毁灭灵长园”作战。"},{"spoiler":false,"text":"毕竟动物无法创造出宗教，所以就投入拥有与灵长园的偶像崇拜不同的信仰心的人类，"},{"spoiler":false,"text":"开展一场宗教战争——如此大胆的作战。"},{"spoiler":false,"text":"来往畜生界和地上并不简单。"},{"spoiler":false,"text":"但是，畜生界与地狱相邻，来往起来也相对简单一些。"},{"spoiler":false,"text":"如今，地狱也因为权力斗争一片混乱，经由地狱前往人界是很简单的。"},{"spoiler":false,"text":"动物灵们经由地狱前往地上，（抱着要是能成功支配就更好了的心理）假装攻进地上，"},{"spoiler":false,"text":"演了一出好戏。"},{"spoiler":false,"text":"她则是存在于畜生界的四大组织之一鬼杰组的组长。"},{"spoiler":false,"text":"她将动物灵送进人界，寻找着好用的人类。"},{"spoiler":false,"text":"她对任何人都是一副彬彬有礼的样子，但内心里却瞧不起绝大多数人。"},{"spoiler":false,"text":"没有人能够违抗她。"}],"source":"bangumi","sourceCharacterId":"71309"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"71309","value":"吉吊"},{"label":"能力","source":"bangumi","sourceCharacterId":"71309","value":"让人失去反抗意志程度的能力（鬼形兽）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebc5fe9159b599e53118e077a25bfbdd76e5581692b7e4ae726619e353507a88.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf0da72ee4f63bb908066499ea82f505ff56445aaec01f8d7d5e6c3c66e738af.webp","width":124,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_889","characterName":"東風谷 早苗","sourceIds":{"bangumi":[{"characterId":"889","match":"source-roster","subjectId":"104009"},{"characterId":"889","match":"source-roster","subjectId":"12696"},{"characterId":"889","match":"source-roster","subjectId":"131875"},{"characterId":"889","match":"source-roster","subjectId":"1395"},{"characterId":"889","match":"source-roster","subjectId":"2134"},{"characterId":"889","match":"source-roster","subjectId":"329342"},{"characterId":"889","match":"source-roster","subjectId":"430567"},{"characterId":"889","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"東風谷 早苗","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"住在妖怪之山上的守矢神社的巫女。"}],"source":"bangumi","sourceCharacterId":"889"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"889","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"889","value":"引发奇迹程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b1c4cec24100603ccda5fb96eda4303e1cc0ee88841ee32d35f05a2905a1efd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46d80e50773b6c9b14e3ada0d949ea2c94dd248ab95c87a252bcd67ab59d5f22.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95691","characterName":"くだまき　つかさ","sourceIds":{"bangumi":[{"characterId":"95691","match":"source-roster","subjectId":"329342"},{"characterId":"95691","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"くだまき　つかさ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○５面中BOSS"},{"spoiler":false,"text":"耳边低语的邪恶白狐"},{"spoiler":false,"text":"菅牧 典"},{"spoiler":false,"text":"Kudamaki Tsukasa"},{"spoiler":false,"text":"种族：管狐"},{"spoiler":false,"text":"能力：抓住灵魂弱点乘虚而入程度的能力"},{"spoiler":false,"text":"她是饭纲丸龙可靠的助手，能带来超出命令预期的成果……至少是被这样认为的。"},{"spoiler":false,"text":"实际上她则是抓住对手心灵上的弱点乘虚而入，引发混乱的元凶。"},{"spoiler":false,"text":"她不仅要主持大天狗和集市之神之间的交涉，还要向大蜈蚣作出指示，一副很忙的样子。"},{"spoiler":false,"text":"不论大天狗、集市之神还是大蜈蚣，都对她信赖备至，找她询问各种意见。"},{"spoiler":false,"text":"但她的真实身份是管狐。"},{"spoiler":false,"text":"听从她的建议的人都会得到金钱上的恩惠。"},{"spoiler":false,"text":"但也不能忘记，等待着这些人的是毁灭性的结局。"},{"spoiler":false,"text":"不论集市之神还是大蜈蚣，都发展成不得不与灵梦等人战斗的地步，罪魁祸首还是她的教唆。"}],"source":"bangumi","sourceCharacterId":"95691"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95691","value":"管狐"},{"label":"能力","source":"bangumi","sourceCharacterId":"95691","value":"抓住灵魂弱点乘虚而入程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/1965849da6d7d52e83717045fde2f34b0723ed980dc80f58e51acc439c0f0c8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cceed932203169c50bf70305e608483a706d42a0521a756799ceb6bbb3e24ec.webp","width":109,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:997","sourceCompanyId":"egs:brand:997","canonicalEntityId":"egs:brand:997","name":"上海アリス幻樂団","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:34191:997","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
