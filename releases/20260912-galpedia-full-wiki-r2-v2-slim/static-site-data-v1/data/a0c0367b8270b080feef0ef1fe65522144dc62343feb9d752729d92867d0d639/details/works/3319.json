angumi","value":"8月23日"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる「白亜館」の主・蘇我博士の愛娘。"},{"spoiler":false,"text":"脳障害を患っているが、悲観せず、健気にも前向きに生きる淑やかな少女。"},{"spoiler":false,"text":"毎日欠かさず庭にある古びた墓石に祈りを捧げているようだが……。"}],"source":"egs","sourceCharacterId":"24489","sourceWorkId":"3319","spoiler":false},{"segments":[{"spoiler":false,"text":"白亜館の主で名医である蘇我博士の愛娘。"},{"spoiler":false,"text":"脳障害を患い、白亜館で短い時間を送るおしとやかな美少女。"},{"spoiler":false,"text":"毎日欠かさず庭にある古びた墓石に祈りを捧げている。"}],"source":"bangumi","sourceCharacterId":"64779"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b5dbb31c14241a776e93c79c8b9e7d352210642e7f2e8db6ec532348edf8497.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19bc1c8c31f7bd3f14fd56f884e8da7ad30827edfb16ef6556ea37852bed5fbb.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬戸内 仁奈","creatorId":"vndb:s17997","sourcePersonId":"vndb:s17997","canonicalEntityId":"vndb:s17997","name":"瀬戸内 仁奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14273","source":"vndb"}]},{"characterId":"char_c33181","characterName":"羽村 まこと","sourceIds":{"bangumi":[{"characterId":"64780","match":"exact-normalized-name-in-linked-work","subjectId":"28019"}],"egsCharacterIds":["24490"],"vndbCharacterId":"c33181"},"originalCharacterName":"羽村 まこと","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明朗快活なスポーツ少女。"},{"spoiler":false,"text":"交通事故で両足を怪我したことから、舞台となる「白亜館」でリハビリに励んでいる。"},{"spoiler":false,"text":"スポーツ以外にも料理も得意。"}],"source":"egs","sourceCharacterId":"24490","sourceWorkId":"3319","spoiler":false},{"segments":[{"spoiler":false,"text":"3ヶ月前、不慮の交通事故で両足を怪我して以来、"},{"spoiler":false,"text":"白亜館でリハビリに励む明るい少女。水泳以外のスポーツと"},{"spoiler":false,"text":"料理が得意。主人公に淡い思いを抱いている。"}],"source":"bangumi","sourceCharacterId":"64780"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0efeebd0b46c704b39968bfb03c22359042d34abea1369843aaaff6fd6638ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/548ce4d4799899033f46ae5a13d2e11ef896b9e72057106ef8e75857366ab8dd.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c33183","characterName":"小山田 未来","sourceIds":{"bangumi":[{"characterId":"64781","match":"exact-normalized-name-in-linked-work","subjectId":"28019"}],"egsCharacterIds":["24491"],"vndbCharacterId":"c33183"},"originalCharacterName":"小山田 未来","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クールで物静かな眼鏡ッ娘。"},{"spoiler":false,"text":"悪性腫瘍に冒され、両親からも半ば見捨てられるカタチで、舞台となる「白亜館」に引き取られた。"},{"spoiler":false,"text":"そのクールな振る舞いは、やがて彼女自身をさらなる孤独へと……。"}],"source":"egs","sourceCharacterId":"24491","sourceWorkId":"3319","spoiler":false},{"segments":[{"spoiler":false,"text":"半年前に悪性腫瘍が見つかり、両親から半ば見捨てられ、"},{"spoiler":false,"text":"白亜館に引き取られた物静かな薄幸の美少女。"},{"spoiler":false,"text":"冷静沈着な物腰は、彼女を孤独に追い込み、そして・・・・。"}],"source":"bangumi","sourceCharacterId":"64781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb8d90062858b6d7d135de030fff4b3ef924d65d168b26df67fb91e95b84b451.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f946ba9bc6a8b62a65e747b4e2ea7978ec05a3529a4b0e3d9067150e564a9491.webp","width":192,"height":