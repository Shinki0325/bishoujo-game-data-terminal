tatus":"source-native","relationId":"vndb:vn-staff:55210","source":"vndb"}]},"cast":[{"characterId":"char_c41950","characterName":"君島 紀香","sourceIds":{"bangumi":[{"characterId":"100309","match":"exact-normalized-name-in-linked-work","subjectId":"348456"},{"characterId":"100309","match":"exact-normalized-name-in-linked-work","subjectId":"348550"}],"egsCharacterIds":["22774"],"vndbCharacterId":"c41950"},"originalCharacterName":"君島 紀香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『尽くしてあげちゃう2』のヒロインの一人。前作から5ヶ月ほど経っているという設定。"},{"spoiler":false,"text":"大輔（前作の主人公）とはすでに恋人関係で、周囲にも公認されている。"},{"spoiler":false,"text":"長身にメリハリのあるボディラインを持つ美人タイプのキャラクターだが、性格は結構軽く意地っ張り。"},{"spoiler":false,"text":"そのギャップのせいか不思議と異性を感じさせない女の子でもある。"},{"spoiler":false,"text":"モデルクラブにスカウトされていたが、大輔との交際を選び、モデルへの道は断念している。"},{"spoiler":false,"text":"大輔の家の合い鍵を貰い、ほとんど通い妻状態。"},{"spoiler":false,"text":"最近は大輔の愛猫「小雪」とも仲良しさん。小雪相手に不安な胸の内を語ったりしてしまう様だ。"},{"spoiler":false,"text":"好物は大輔の淹れてくれるレモンティー。それを口実に大輔の部屋に行きたがるフシあり。"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"1542","spoiler":false},{"segments":[{"spoiler":false,"text":"お馴染み『尽くしてあげちゃう2』『紀香たんといっしょ☆』のヒロインの一人。"},{"spoiler":false,"text":"大輔（『尽くしてあげちゃう2』の主人公）とはすでに恋人関係で、周囲にも公認されている。"},{"spoiler":false,"text":"長身にメリハリのあるボディラインを持つ美人タイプだが、性格は結構軽く意地っ張り。"},{"spoiler":false,"text":"そのギャップのせいか不思議と異性を感じさせない女の子でもある。"},{"spoiler":false,"text":"モデルクラブにスカウトされていたが、大輔との交際を選び、モデルへの道は断念している。"},{"spoiler":false,"text":"大輔とは相変わらず口喧嘩が絶えない毎日だが、大抵は彼が折れてくれるので上手く収まっている様だ。"},{"spoiler":false,"text":"すでに大輔の両親とは「結婚を前提に」とまで話が進み、彼の部屋でのお泊まりも日常茶飯事のほとんど通い妻状態。"},{"spoiler":false,"text":"最近は大輔の愛猫「小雪」とも仲良しさん。"},{"spoiler":false,"text":"孝之とは以前から友人関係だが、最近では大輔と一緒に３人でつるむ事も多い。"},{"spoiler":false,"text":"なんとか撫子とくっつけようと、彼女なりに張り切っているようだ。"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"2602","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の親友「君島 翔一」の姉。"},{"spoiler":false,"text":"学生ながらも売れっ子モデルで写真集も発売されている。"},{"spoiler":false,"text":"いわゆるボン・キュッ・ボンなちょっとアダルティーなお姉様。"},{"spoiler":false,"text":"興味本位で見舞いに来たのに、朴念仁の彼をすっかり気に入ってしまったらしく、"},{"spoiler":false,"text":"３年生なのに同じ学校に転校してきてしまう……"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"2689","spoiler":false},{"segments":[{"spoiler":false,"text":"「尽くしてあげちゃう」ヒロイン。シリーズ多数に登場。"},{"spoiler":false,"text":"大輔の同級生でむつみの親友。"},{"spoiler":false,"text":"見事大輔と結ばれた紀香は、ラブラブ通い妻の真っ最中。"},{"spoiler":false,"text":"しかしイキナリ大輔の両親に紹介されることになって大慌て！"},{"spoiler":false,"text":"お淑やかな女の子を目指して「身も心もメイドになる」宣言をするが……"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"2756","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトでむつみの親友。"},{"spoiler":false,"text":"前作『尽くしてあげちゃう』にも登場。そのときの1年前という設定。"},{"spoiler":false,"text":"「尽くして」シリーズ中、最も人気の高いヒロイン。"},{"spoiler":false,"text":"メリハリのあるボディラインで、モデルクラブのスカウトに声をかけられている。"},{"spoiler":false,"text":"主人公とは口喧嘩の絶えない仲だが、心の内では憎からず思っている。"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"3684","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の親友「君島 翔一」の姉で、学生ながらも売れっ子モデルで写真集も発売されているというちょっとアダルティーなお姉様。見た目は知的な印象を与えるが、実際のところその性格はたいへん軽い。胸は結構ある。主人公の事は興味本位で見舞いに来たのだが、朴念仁の彼をすっかり気に入ってしまったらしく、最終学年であるにもかかわらず同じ学校に転校してきてしまう。"}],"source":"bangumi","sourceCharacterId":"100309"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/302c7bb09095e40944e22d2086b2bbb5db63da97c1aceefdf36580df37185fe7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6e02f521ee1cb90db9cf6d4c248ddac0be80ecb86e3f7d2ca698f2b943763c7.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一宮桜","creatorId":"vndb:s491","sourcePersonId":"vndb:s491","canonicalEntityId":"vndb:s491","name":"一宮 桜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:348444:100309:44717:1","source":"bangumi"}]},{"characterId":"char_c51907","characterName":"五十嵐 優菜","sourceIds":{"bangumi":[{"characterId":"124638","match":"exact-normalized-name-in-linked-work","subjectId":"397347"}],"egsCharacterIds":["22775"],"vndbCharacterId":"c51907"},"originalCharacterName":"五十嵐 優菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「聖ミカエル総合病院」の看護婦で、現在は看護学校に実習講師として出向している正看護婦。"},{"spoiler":false,"text":"『尽くしてあげちゃう2～なんでもしちゃうの～』にも登場。"},{"spoiler":false,"text":"20代中半で主人公とはほぼ同年代。"},{"spoiler":false,"text":"しかし立ち振る舞いが大人びているので、主人公に対してもちょっとお姉さん風な感じで接する。"},{"spoiler":false,"text":"学生時代、一生を添い遂げようと誓った恋人が居たが、処女を捧げる前に交通事故で他界している。"},{"spoiler":false,"text":"以来失語症寸前の口数の少なさになってしまった。"},{"spoiler":false,"text":"主人公と話すときも、必要最低限の言葉しか話さない。"},{"spoiler":false,"text":"主人公には昔の恋人の面影があるらしく、初めはそれを追いかけるように主人公に接してくる。"},{"spoiler":false,"text":"しかし主人公への思いが特別なものに育つにつれて、愛おしさと同時に心中の悩みも大きくなってしまう。"},{"spoiler":false,"text":"相変わらずの「……（こくこく）」「……（ふるふる）」"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"1991","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の先輩でむつみとも仲がいい。"},{"spoiler":false,"text":"ほっそり清楚な感じだが、着やせするタイプなのか胸は結構ある。"},{"spoiler":false,"text":"物静かでお嬢様然とした雰囲気。"},{"spoiler":false,"text":"声が小さくて、おもわず守ってあげたくなりそう。"},{"spoiler":false,"text":"大の猫好きで、発見すると別人のように興奮する。"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"3684","spoiler":false},{"segments":[{"spoiler":false,"text":"『尽くしてあげちゃう2』、『看護しちゃうぞ2』に登場。"},{"spoiler":false,"text":"原画：志水直隆（トラヴュランス）"},{"spoiler":false,"text":"主人公の一つ年上の先輩で、むつみとも親しい。"},{"spoiler":false,"text":"真っ白い肌と穏やかで柔らかい物腰はいかにも「深窓の令嬢」と言う感じ。"},{"spoiler":false,"text":"中肉中背、胸は大きめ。癖のないストレートロングの黒髪、とろんとした瞳と太めの眉、大きな眼鏡がチャームポイント。"},{"spoiler":false,"text":"声も小さく、下級生である主人公達にも常に敬語を使う。"},{"spoiler":false,"text":"特に主人公に「お願い」をする際は、真っ赤な顔のまま彼の服の裾をつんつん引っ張る様な感じ。"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"3801","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の先輩で、むつみとも仲がいい。学業優秀で、一言でたとえるなら「深窓の令嬢」と言う感じ。"}],"source":"bangumi","sourceCharacterId":"124638"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/440f1d52d92e73cc25e4f360ec8fc1bcd720135f92699fb7c17e6b04156ca485.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28c5e0e22c990a2ccf7f0a65718d2d6fb9473611b9103d07cfa33769ec5fff37.webp","width":183,"height":220,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51958","characterName":"篠原 むつみ","sourceIds":{"vndbCharacterId":"c51958"},"originalCharacterName":"篠原 むつみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42bfc5756777d50ed27148e095afdab296c32fbdb5e8a2a9a79435d575d6bfb0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/026b2452911b116d726d101cef92df10e44b634389a97905f7fcb7889c57dca0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大花 どん","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"浅井 清己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30664","source":"vndb"}]},{"characterId":"char_vndb_c51959","characterName":"月野 サラシア","sourceIds":{"vndbCharacterId":"c51