{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8166","model":{"presentationWorkId":"vndb:v497","staff":{"artwork":[{"creditedName":"牛乳戦車","creatorId":"vndb:s8858","sourcePersonId":"egs:creator:5051","canonicalEntityId":"vndb:s8858","name":"牛乳戦車","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20045","source":"egs"}],"scenario":[{"creditedName":"春日森(家宇治森)","creatorId":"vndb:s594","sourcePersonId":"egs:creator:2484","canonicalEntityId":"vndb:s594","name":"春日森(家宇治森)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20046","source":"egs"},{"creditedName":"安斎兵梧","creatorId":"vndb:s2976","sourcePersonId":"egs:creator:2840","canonicalEntityId":"vndb:s2976","name":"安斎兵梧","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20047","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c158933","characterName":"南崎 貴洋","sourceIds":{"vndbCharacterId":"c158933"},"originalCharacterName":"南崎 貴洋","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c18666","characterName":"南崎 伊鈴々","sourceIds":{"vndbCharacterId":"c18666"},"originalCharacterName":"南崎 伊鈴々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's stepsister. After her mother remarried a month ago, she lives alone with the protagonist in the house while their parents are away."},{"spoiler":false,"text":"She attends an all-girls school and handles all household chores by herself at home. Despite appearances, she's actually a dependable person who takes good care of others."},{"spoiler":false,"text":"Her personality is bright and innocent. She loves cleanliness, especially baths. Since she'd wanted an older brother since she was little, she's become very attached to the protagonist, even though it hasn't been that long."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f99561234ec4ddd4f0442bc683d0607bf4de3b1447e745c47a552565a33bbd32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0747f6a650f0c9c53894295b49c8234bafa8de5737782271c059ae5809f2c3ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青川 ナガレ","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5080","source":"vndb"}]},{"characterId":"char_vndb_c18667","characterName":"星永 詩稀","sourceIds":{"vndbCharacterId":"c18667"},"originalCharacterName":"星永 詩稀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate. A serious, kind, and studious top student."},{"spoiler":false,"text":"While she seems like the type everyone would naturally like, she actually has a very passive personality and is extremely shy around new people."},{"spoiler":false,"text":"Because of this, she tends to be a rather inconspicuous presence in class."},{"spoiler":false,"text":"Seeing the always lively protagonist, she also feel a sense of admiration, thinking “I want to be like that.”"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd44d03d07b2d3a23dab0ce2b4615b04ec64a47c3ced662861ddb9e52df1b0c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa102b267fde39a6bd1edf4549849ee08bb0d6c6f94fee2c472366638ef5be7d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水純 なな歩","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5083","source":"vndb"}]},{"characterId":"char_vndb_c18668","characterName":"ティナ・スターリング","sourceIds":{"vndbCharacterId":"c18668"},"originalCharacterName":"ティナ・スターリング","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The senior student who serves as the student council president. A half-Japanese student with a competitive personality. ...In truth, she's also someone the protagonist admires."},{"spoiler":false,"text":"Her distinctive appearance sets her apart from other students, making her a constant focus of attention, especially among the female students."},{"spoiler":false,"text":"Yet, perhaps due to her personality and her prominent presence within the school, she seems to lack any close friends she can truly connect with."},{"spoiler":false,"text":"Does she occasionally show a lonely expression? She always acts rebellious toward the protagonist, displaying a somewhat condescending attitude, but what are her true feelings...?"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18668"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06c6f65d4a4d04b70eac7c2bd69c5592f7f6bd5ee7951432fb7908d74e384753.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7ae897f6784b095f0c11e8fd89f5d2cd1c45b1fdb8f3af1250d672a2abb3b05.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅里 ミーオ","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5077","source":"vndb"}]},{"characterId":"char_vndb_c18669","characterName":"阿井塚 姫芽","sourceIds":{"vndbCharacterId":"c18669"},"originalCharacterName":"阿井塚 姫芽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A swim club member who has a crush on the protagonist and constantly follows them around, calling out “Senpai!” She's a kouhai."},{"spoiler":false,"text":"Since entering school, she's admired the protagonist and openly confesses her feelings. More than a fan... her behavior borders on stalker-like?"},{"spoiler":false,"text":"When things don't go her way, she throws a fit and immediately starts firing off missiles—a slightly dangerous personality."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0b73078cdf702cb523497b7e483c400ea896b2fd223e5baa8171a6231c71c94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b0bf577abad3f61c784b741ae312aa5b9905662fb75a180535a2f92136d2ba2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜川 未央","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5078","source":"vndb"}]},{"characterId":"char_vndb_c18670","characterName":"高里 らいら","sourceIds":{"vndbCharacterId":"c18670"},"originalCharacterName":"高里 らいら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The homeroom teacher of the protagonist's class. She often acts flirtatiously and suggestively toward the students (especially the protagonist)."},{"spoiler":false,"text":"Many students seem captivated by Laila, thinking about her night after night. The protagonist is also constantly troubled by Laila's overly seductive attitude."},{"spoiler":false,"text":"To Laila, the protagonist is apparently “a cute student who always listens to what I say.”"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18670"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97f0825ee8fa39166ff055cb63a04e9392d515e18f5a8f29c78ad72ee0c0abae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ca7892dc8c594d461e61a3cb98be70b566661b0551e9d91043b199996b1e687.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜川 未央","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5079","source":"vndb"}]},{"characterId":"char_vndb_c18671","characterName":"緒形 心菜","sourceIds":{"vndbCharacterId":"c18671"},"originalCharacterName":"緒形 心菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The junk shop “Junk Pod” clerk who suddenly started quietly dropping by (?) with the heroines."},{"spoiler":false,"text":"A big sister type who's into mechs and a bit of an otaku girl. She's even been made to sell slightly risqué items without knowing their purpose, just because the shop owner recommended them?"},{"spoiler":false,"text":"She frequently appears for tasks like repairing the academy walls or setting up events, so everyone treats her like a “jack-of-all-trades.”"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a99ff69623bb2fb35a97d656f97543b37b49ed136f279b313ec63a8d640b23d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60bf2809f4e15348dc5362906ebea847b8adfb19ac5e43314b10c0961b653ebd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"未来羽","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5082","source":"vndb"}]},{"characterId":"char_vndb_c18672","characterName":"柚木 なーこ","sourceIds":{"vndbCharacterId":"c18672"},"originalCharacterName":"柚木 なーこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The waitress at Ocean Way, the family restaurant the protagonist often visits."},{"spoiler":false,"text":"A girl he's gotten close enough to chat with freely, without any unnecessary fuss, since he started going there a few months ago."},{"spoiler":false,"text":"Even though she's working, whenever she spots the protagonist, she comes over to his table and they can talk about all sorts of silly things—a good friend."},{"spoiler":false,"text":"But gradually, that closeness starts to become a significant obstacle for her...?"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18672"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffcd4119e5b4548ff98fd5a3e05cf75fa2274c2c83842ed11452948de13749a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b4a29a815d11909256fb0d8843a338f08fc8840e032c723f116bed644016b7f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水純 なな歩","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5084","source":"vndb"}]},{"characterId":"char_vndb_c18673","characterName":"EVE AT-01","sourceIds":{"vndbCharacterId":"c18673"},"originalCharacterName":"EVE AT-01","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate who suddenly transferred in. Her speech is unsteady, and they often remain expressionless—perhaps because she struggles to show emotion."},{"spoiler":false,"text":"Though you wouldn't guess it from her appearance (?), between her name, her expressionless face, and her odd way of speaking... it's pretty obvious she's not quite like other humans? (She seems to be trying to hide it, though.)"},{"spoiler":false,"text":"The other students treat her normally, but the protagonist feels more uneasy about her mechanical interactions with others than she does with the other girls."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18673"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/608e7c115086fa90e903ae7c5250a1f75d9b21fc240c09333b02d45c51b2daa4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1db6746ea7b99332850e9f8533f3f80bb06924fe147c540bd1ca23399a125853.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青川 ナガレ","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5081","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p299","sourceCompanyId":"egs:brand:1578","canonicalEntityId":"vndb:p299","name":"OLE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8166:1578","source":"egs"},{"companyId":"vndb:p299","sourceCompanyId":"vndb:p299","canonicalEntityId":"vndb:p299","name":"OLE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:1269:v497","source":"vndb"},{"companyId":"vndb:p299","sourceCompanyId":"vndb:p299","canonicalEntityId":"vndb:p299","name":"OLE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:143091:v497","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
