anonicalEntityId":"vndb:s15938","name":"Future-hands(フューチャーハンズ)","detail":"グラフィック協力","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:226072","source":"egs"},{"creditedName":"Kitty-tama","creatorId":"vndb:s24005","sourcePersonId":"vndb:s24005","canonicalEntityId":"vndb:s24005","name":"Kitty-tama","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:169928","source":"vndb"},{"creditedName":"DS55","creatorId":"vndb:s27612","sourcePersonId":"vndb:s27612","canonicalEntityId":"vndb:s27612","name":"Roman Stuart","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169929","source":"vndb"},{"creditedName":"Eleventacle","creatorId":"vndb:s29602","sourcePersonId":"vndb:s29602","canonicalEntityId":"vndb:s29602","name":"Eleventacle","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169930","source":"vndb"},{"creditedName":"Dr.Octopus","creatorId":"vndb:s52105","sourcePersonId":"vndb:s52105","canonicalEntityId":"vndb:s52105","name":"Dr.Octopus","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169931","source":"vndb"},{"creditedName":"tomsan","creatorId":"vndb:s6343","sourcePersonId":"vndb:s6343","canonicalEntityId":"vndb:s6343","name":"tomsan","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169935","source":"vndb"},{"creditedName":"樋舘 誠","creatorId":"vndb:s7774","sourcePersonId":"vndb:s7774","canonicalEntityId":"vndb:s7774","name":"樋舘 誠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169936","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c31433","characterName":"リグレット","sourceIds":{"vndbCharacterId":"c31433"},"originalCharacterName":"リグレット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The form taken on by the Goddess of Winter, Rigret, after she has succumbed to corruption by Loki."},{"spoiler":false,"text":"Having been thoroughly corrupted, her transient yet pure and innocent personality has completely vanished, and she has become an impish devil who tricks and deceives men."},{"spoiler":false,"text":"Because she seems almost like an innocent kitten, there is nothing more cruel than being faced with the reality of her personality on a battlefield as an enemy soldier."},{"spoiler":false,"text":"After being corrupted by Loki, she now has a strong desire to monopolise, and therefore just about always clings to him, wanting attention. However, he seems to find this annoying, and usually manages to throw her off or give her the slip."},{"spoiler":false,"text":"「Will you praise me more, Loki? Faith is power...My Gjallarhorn can grant blessings, and with that, everyone would willingly, happily die for me」"},{"spoiler":false,"text":"Weapon name: Gjallarjorn"}],"source":"vndb","sourceCharacterId":"c31433"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee8ae9504884ad74a5fd98c0683f63902f6f21e17599cbbac48161078ff7ea92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f6698f841007aec757aa6fe00104400be374b37fcab918dee5bb3506fa77247.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c31435","characterName":"オーディン","sourceIds":{"vndbCharacterId":"c31435"},"originalCharacterName":"オーディン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The form taken on by the Absolute God and protector of the holy sanctuary after she has succumbed to corruption by Loki."},{"spoiler":false,"text":"Having been repeatedly subjected to deep corruption, she has acquired a taste for mortal pleasures. She has completely transformed into a god who repeatedly seeks Loki's attention."},{"spoiler":false,"text":"The fundamental personality trait of hers that decrees for evil to be punished remains the same. However, due to Loki's corruption, the criterion for punishment has changed from what she considers to be evil as a whole, into what she considers evil towards Loki."},{"spoiler":false,"text":"Moreso than adoration, she shows empathy towards Loki's cause and as someone who stands shoulder to shoulder with Loki, she uses her godly power for Loki's sake of her own volition."},{"spoiler":false,"text":"To make an enemy of Loki is to make an enemy of Odin. Simply being an enemy of Loki is enough for her to wield the spear of heaven in that direction."},{"spoiler":false,"text":"「...I see, so this is the feeling of having been stained in the colour of a demon...It actually feels more comfortable than I had imagined」"},{"spoiler":false,"text":"Weapon names: Gungnir (spear); Huginn, Muninn, Geri, Freki (blades)"}],"source":"vndb","sourceCharacterId":"c31435"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcb7d738faee2be073e1d3b949514b4621e61fa3e1203edb3781e60d72d0cd0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65b98dc16c15e1bc462efc2a58c90deb3c87404223550817ff1568256b55316c.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51977","characterName":"ロキ＝ムスペルヘイム","sourceIds":{"vndbCharacterId":"c51977"},"originalCharacterName":"ロキ＝ムスペルヘイム","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The current head of Muspellzheimr, a tributary house to the imperial nobility which once held significant influence within the demon realm."},{"spoiler":false,"text":"He lived his early life peacefully with his parents. However, one day his father was branded a rebel without cause, and was executed for his suspected crimes while his mother was incarcerated."},{"spoiler":false,"text":"Loki was not executed, but was instead forced to give up his demonic armament which is considered a proof of inheritance to the throne."},{"spoiler":false,"text":"After that, Loki was forced to live in the castle, ostracised and branded as the child of a rebel. However, Loki has now decided to participate in the feud for the throne."},{"spoiler":false,"text":"Armed with his skill with the spear and tactical mind left behind by his deceased father, with the knowledge of magic and how to handle women taught to him by his maid, Fena..."},{"spoiler":false,"text":"And finally, primed with his ace in the hole, the power of the 『God of Armageddon』, he fights to win the feud for the throne."},{"spoiler":false,"text":"「I will become the ruler of the demon realm. To that end, I'm willing to destroy every obstacle in my path!」"}],"source":"vndb","sourceCharacterId":"c51977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a6d44ff04c1155a94cd4dd868f3c2d419d5fce2214428b12d4c4819acdc9f3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdac979ed26f2adff3880adf03c48798ef2d6a3c44b06b66abfb55878debd5b5.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c88005","characterName":"オーディン","sourceIds":{"vndbCharacterId":"c88005"},"originalCharacterName":"オーディン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Odin's final form."},{"spoiler":false,"text":"Weapon names: Gungnir (spear); Huginn, Muninn, Geri, Freki (blades)"}],"source":"vndb","sourceCharacterId":"c88005"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3c9324bcf60978649622b7c778686a5f08451631ee7037f319453d178cf7896.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4d789864bc8f28487f40dd2384d711da1ab074137e2a7fa7ed3f3e02dca79eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2058","sourceCompanyId":"egs:brand:2058","canonicalEntityId":"egs:brand:2058","name":"DualTail(DualMage)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:29953:2058","source":"egs"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:84484:v29475","source":"vndb"},{"companyId":"vndb:p102","sourceCompanyId":"vndb:p102","canonicalEntityId":"vndb:p102","name":"JAST USA","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:94156:v29475","source":"vndb"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:94157:v29475","source":"vndb"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":