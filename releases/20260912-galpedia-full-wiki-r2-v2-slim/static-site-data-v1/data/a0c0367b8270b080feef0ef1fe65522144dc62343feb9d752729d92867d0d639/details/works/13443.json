人员","identityStatus":"source-native","relationId":"vndb:vn-staff:40415","source":"vndb"},{"creditedName":"島村 孝一","creatorId":"vndb:s3502","sourcePersonId":"vndb:s3502","canonicalEntityId":"vndb:s3502","name":"島村 孝一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:40416","source":"vndb"}]},"cast":[{"characterId":"char_c4655","characterName":"タク","sourceIds":{"bangumi":[{"characterId":"19944","match":"exact-normalized-name-in-linked-work","subjectId":"1410"}],"egsCharacterIds":["16993"],"vndbCharacterId":"c4655"},"originalCharacterName":"タク","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"621"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at Suimei Academy."},{"spoiler":false,"text":"He is withdrawn and not interested in the 3D world and its inhabitants. He avoids conversations with others whenever possible and only attends school in order to fulfill the minimum attendance requirement for graduation. His interests lie in watching anime, playing eroge, and Empire Sweeper Online, an MMORPG where he's the top player \"Neidhardt\"."},{"spoiler":false,"text":"He suffers from intense delusions as a result of his apparent schizophrenia and the extremely secluded lifestyle he lives as a shut-in."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4655"},{"segments":[{"spoiler":false,"text":"「私立翠明学園」二年生で本作の主人公。"},{"spoiler":false,"text":"人との直接的なコミュニケーションを極端に嫌い、"},{"spoiler":false,"text":"最低限の外出しかしない引きこもり。"},{"spoiler":false,"text":"しかし、本人は引きこもりであることを否定している。"},{"spoiler":false,"text":"妄想癖が激しく、辛い現実から逃避しては自分に都合のいい「妄想」をして、"},{"spoiler":false,"text":"逃げ出した事実を他人に責任転嫁する、いわゆるダメ人間。"}],"source":"egs","sourceCharacterId":"16993","sourceWorkId":"9960","spoiler":false},{"segments":[{"spoiler":false,"text":"本編の主人公。私立翠明学園2年生。人との直接的なコミュニケーションを嫌い、最低限の外出しかしないネット依存症の少年。ナイトハルトというハンドルネームで1日中ネットゲームをし、学校は出席日数を計算して必要以上に登校しない。人と話せばどもってしまい、それが女の子ならばパニックを起こすほど。周囲からは引きこもりと思われているが、本人はそれを否定する。妄想癖があり思いこみが激しく、しばしばネガティブな方向へ暴走する。また、辛い現実から逃避し、ひたすら自分に都合のいい妄想をしてそれに浸っている。辛い現実に直面するとすぐに逃げ出してしまい、しかもそれを他人に責任転嫁する。いわゆるダメ人間。"}],"source":"bangumi","sourceCharacterId":"19944"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca2893759e9265b5f2bd7d3521c58feaf9ce2b532417a767ce0ee02981cc7cfd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31f00fdd09bca7e4534476211d5da86eaad4e130236e70499a09bfd0cd986f30.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉野裕行","creatorId":"vndb:s241","sourcePersonId":"vndb:s241","canonicalEntityId":"vndb:s241","name":"吉野 裕行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13166:19944:3955:1","source":"bangumi"}]},{"characterId":"char_c4656","characterName":"咲畑 梨深","sourceIds":{"bangumi":[{"characterId":"4833","match":"source-roster","subjectId":"13166"},{"characterId":"4833","match":"exact-normalized-name-in-linked-work","subjectId":"1410"},{"characterId":"4833","match":"source-roster","subjectId":"1410"},{"characterId":"4833","match":"source-roster","subjectId":"18708"},{"characterId":"4833","match":"source-roster","subjectId":"3243"},{"characterId":"4833","match":"source-roster","subjectId":"637651"}],"egsCharacterIds":["16994"],"vndbCharacterId":"c4656"},"originalCharacterName":"咲畑 梨深","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"17"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"703"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious pink-haired girl that claims to be Takumi's classmate and friend."},{"spoiler":false,"text":"Takumi, however, has no memory of her, and the circumstances in which he meets her make it even harder for him to trust her."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4656"},{"segments":[{"spoiler":false,"text":"主人公・拓巳の前に現れた謎の少女。"},{"spoiler":false,"text":"拓巳が通う「私立翠明学園」の制服を着ていて、"},{"spoiler":false,"text":"彼に対し、優しく気さくな笑顔を向けてくる。"},{"spoiler":false,"text":"だが、彼女の真意や目的は一切不明。"}],"source":"egs","sourceCharacterId":"16994","sourceWorkId":"9960","spoiler":false},{"segments":[{"spoiler":false,"text":"今作のメインヒロイン。拓巳がニュージェネ第三の事件（張り付け事件）の現場で出会った謎の少女。屈託ない明るさを持つ行動派で口癖は「ビシィッ!」。"}],"source":"bangumi","sourceCharacterId":"4833"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0c23031f80d8a4565bff1886d90cc8d8abf52436b4d19d740997f7864b0cd53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64891a5fe3a7249981a866d259ab324e097b51c5d0a3e9c0b25b8e8a4c812bfc.webp","width":164,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13166:4833:4251:1","source":"bangumi"}]},{"characterId":"char_c4657","characterName":"ナナ","sourceIds":{"bangumi":[{"characterId":"34668","match":"exact-normalized-name-in-linked-work","subjectId":"1410"}],"egsCharacterIds":["16999"],"vndbCharacterId":"c4657"},"originalCharacterName":"ナナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"15"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"217"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takumi's younger sister and a first-year at Suimei Academy."},{"spoiler":false,"text":"She often puts up a strong front and argues with her brother whenever they meet but she is actually really concerned about him."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4657"},{"segments":[{"spoiler":false,"text":"「私立翠明学園」の一年生で、拓巳の妹。"},{"spoiler":false,"text":"強気で活発で口が悪く、拓巳に対しても生意気。"},{"spoiler":false,"text":"だが内心では、一人暮らしをする兄を心配している。"}],"source":"egs","sourceCharacterId":"16999","sourceWorkId":"9960","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインの一人。拓巳の実妹。翠明学園の1年生で、実家から通学している。一人称は「ナナ」。兄である拓巳の事を「おにぃ」と呼び、少々ブラザーコンプレックス気味。"}],"source":"bangumi","sourceCharacterId":"34668"}],"profileFacts":[],"metadataCandidateConflicts":{},"im