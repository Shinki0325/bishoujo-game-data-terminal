her","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:255099","source":"egs"},{"creditedName":"海野凛久","creatorId":"vndb:s37261","sourcePersonId":"egs:creator:38695","canonicalEntityId":"vndb:s37261","name":"海野凛久","detail":"シナリオ協力","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:255100","source":"egs"},{"creditedName":"いっぱんへい","creatorId":"vndb:s21315","sourcePersonId":"vndb:s21315","canonicalEntityId":"vndb:s21315","name":"タハラ 白樹","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:178627","source":"vndb"}]},"cast":[{"characterId":"char_c100992","characterName":"山崎 響","sourceIds":{"bangumi":[{"characterId":"102004","match":"exact-normalized-name-in-linked-work","subjectId":"353950"}],"egsCharacterIds":["23636"],"vndbCharacterId":"c100992"},"originalCharacterName":"山崎 響","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【The Cute and Charming Married Woman Next Door】"},{"spoiler":false,"text":"A married woman whose husband is working elsewhere while she holds the fort down at home."},{"spoiler":false,"text":"Now that she has to handle everything by herself, she is filled with even more love and appreciation for her husband."},{"spoiler":false,"text":"Since she has some more free time on her hands, she has taken to baking sweets recently."},{"spoiler":false,"text":"An earnest and accepting woman."},{"spoiler":false,"text":"「Nice to meet you. My name is Hibiki Yamazaki, from next door」"},{"spoiler":false,"text":"From English DLsite"}],"source":"vndb","sourceCharacterId":"c100992"},{"segments":[{"spoiler":false,"text":"夫婦で暮らしていたが、夫が単身赴任に行ってから一人で暮らしている。"},{"spoiler":false,"text":"今まで夫婦で補いあっていた部分をすべて一人で行うようになって夫のありがたさと愛おしさが日に増すほど愛している。"},{"spoiler":false,"text":"とはいえ、自由にできる時間もあって、お菓子作りにも挑戦している。"},{"spoiler":false,"text":"素直で人からの好意や想いを受け入れやすい。"}],"source":"egs","sourceCharacterId":"23636","sourceWorkId":"31742","spoiler":false},{"segments":[{"spoiler":false,"text":"夫婦で暮らしていたが、"},{"spoiler":false,"text":"夫が単身赴任に行ってから一人で暮らしている。"},{"spoiler":false,"text":"今まで夫婦で補いあっていた部分をすべて一人で行うようになって夫のありがたさと愛おしさが日に增すほど愛している。"},{"spoiler":false,"text":"とはいえ、自由にできる時間もあって、お菓子作りにも挑戦している。"},{"spoiler":false,"text":"素直で人からの好意や想いを受け入れやすい。"}],"source":"bangumi","sourceCharacterId":"102004"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5274474294f59085424b9a9d407687c13a195d0827646e36b5fc87be71821634.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a64fdb72537ff9a013d2a2fc4511a287f48b9847fa699edcb1525fbf88c4add.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:353950:102004:20696:1","source":"bangumi"}]},{"characterId":"char_c100993","characterName":"浅野 ももか","sourceIds":{"bangumi":[{"characterId":"102005","match":"exact-normalized-name-in-linked-work","subjectId":"353950"}],"egsCharacterIds":["23637"],"vndbCharacterId":"c100993"},"originalCharacterName":"浅野 ももか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【The Tough, Meddlesome Oneesan】"},{"spoiler":false,"text":"While living with her husband, she worked hard to always present as a prim and proper wife,"},{"spoiler":false,"text":"But once he moved away for work, she took to taking it easy, and going out for drinks."},{"spoiler":false,"text":"She loves drinking with those she’s comfortable with. Mostly because she is known to get a little tipsy..."},{"spoiler":false,"text":"「Huh? Are you turning red? Hehe, your innocent little reactions are so cute.」"},{"spoiler":false,"text":"From English DLsite"}],"source":"vndb","sourceCharacterId":"c100993"},{"segments":[{"spoiler":false,"text":"夫婦で暮らしていた頃は同僚の妻としての体裁を守ろうと必死に生活していた。"},{"spoiler":false,"text":"夫が単身赴任で居なくなってから友達とお酒を飲みにいったりと、わりかし気楽な生活をしている。"},{"spoiler":false,"text":"自分が気を許した相手と飲んでいるのが好き。"},{"spoiler":false,"text":"お酒を飲むと陽気になり、理性のたかが外れやすくなる。"}],"source":"egs","sourceCharacterId":"23637","sourceWorkId":"31742","spoiler":false},{"segments":[{"spoiler":false,"text":"夫婦で暮らしていた頃は同僚の妻としての体裁を守ろうと必死に生活していた。"},{"spoiler":false,"text":"夫が単身赴任で居なくなってから友達とお酒を飲みにいったりと、わりかし気楽な生活をしている。"},{"spoiler":false,"text":"自分が気を許した相手と飲んでいるのが好き。"},{"spoiler":false,"text":"お酒を飲むと陽気になり、理性のたかが外れやすくなる。"}],"source":"bangumi","sourceCharacterId":"102005"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/753e3880aa192c7a96eb0258b431122bf0cac4b00f0579d5f89765077cb45daf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78fffe6b90a4b3c87bde7ed767fe98647a50d68f533b357062eb01b62b15efee.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波野夏花","creatorId":"vndb:s3225","sourcePersonId":"vndb:s3225","canonicalEntityId":"vndb:s3225","name":"波野夏花(夏花)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:353950:102005:16169:1","source":"bangumi"}]},{"characterId":"char_vndb_c100994","characterName":"小林 翼","sourceIds":{"vndbCharacterId":"c100994"},"originalCharacterName":"小林 翼","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A university student that is living by himself now."},{"spoiler":false,"text":"As he is from the countryside, he’s quite okay with all things nature, including bugs and the like."},{"spoiler":false,"text":"He’s had a great upbringing that has made him a sensible and understanding man who loves to help out. However, he’s not great at house chores, since his parents always did that for him."},{"spoiler":false,"text":"From English DLsite"}],"source":"vndb","sourceCharacterId":"c100994"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p12551","sourceCompanyId":"egs:brand:7203","canonicalEntityId":"vndb:p12551","name":"Guilty'Dash","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31742:7203","source":"egs"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:93899:v32612","source":"vndb"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:95599:v32612","source":"vndb"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:97376:v32612","source":"vndb"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:98075:v32612","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
