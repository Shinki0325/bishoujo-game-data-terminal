e","relationId":"vndb:vn-staff:125087","source":"vndb"},{"creditedName":"亚麻残","creatorId":"vndb:s27642","sourcePersonId":"vndb:s27642","canonicalEntityId":"vndb:s27642","name":"亚麻残","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:125088","source":"vndb"},{"creditedName":"森夜","creatorId":"vndb:s27658","sourcePersonId":"vndb:s27658","canonicalEntityId":"vndb:s27658","name":"森夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125089","source":"vndb"},{"creditedName":"【QZYtoSXY】","creatorId":"vndb:s27659","sourcePersonId":"vndb:s27659","canonicalEntityId":"vndb:s27659","name":"【QZYtoSXY】","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:125090","source":"vndb"},{"creditedName":"艾月新兰","creatorId":"vndb:s27679","sourcePersonId":"vndb:s27679","canonicalEntityId":"vndb:s27679","name":"艾月新兰","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:125091","source":"vndb"},{"creditedName":"靄太郎","creatorId":"vndb:s6860","sourcePersonId":"vndb:s6860","canonicalEntityId":"vndb:s6860","name":"靄太郎","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:125093","source":"vndb"},{"creditedName":"がお","creatorId":"vndb:s8902","sourcePersonId":"vndb:s8902","canonicalEntityId":"vndb:s8902","name":"tetem.","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:125095","source":"vndb"},{"creditedName":"兼宗","creatorId":"vndb:s14392","sourcePersonId":"vndb:s14392","canonicalEntityId":"vndb:s14392","name":"兼宗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125096","source":"vndb"},{"creditedName":"Tattoo","creatorId":"vndb:s26210","sourcePersonId":"vndb:s26210","canonicalEntityId":"vndb:s26210","name":"Tattoo","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125098","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c45457","characterName":"館の女中","sourceIds":{"vndbCharacterId":"c45457"},"originalCharacterName":"館の女中","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"503"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: ???"},{"spoiler":false,"text":"Her age and place of birth are unknown."},{"spoiler":false,"text":"She has long, black hair and jade eyes, and it is she who greets You when You first awaken in the mansion."},{"spoiler":false,"text":"The Maid calls You the \"Master\" of the house, and at her invitation, together You bear witness to a variety of events that took place within these walls."},{"spoiler":false,"text":"Shadows of her presence are visible in each of the tales. At times, she is there, and others... nowhere to be found."},{"spoiler":false,"text":"Though she treats You kindly, her hands are cold as ice, seemingly devoid of life."},{"spoiler":false,"text":"How, then, is she here now, with You?"},{"spoiler":false,"text":"\"No matter what happens, you mustn't let go of my hand.\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"Her real name is Giselle (ジゼル)."}],"source":"vndb","sourceCharacterId":"c45457"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e24fcb6943a5b3feecf274c4d0558b17d40f82bd41299b4a975f462918d83255.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d8ce58ff51f3f62d286374d5c43e4c78dae8d975e3a448148a89d0fac173ae7.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45458","characterName":"ミシェル・ボランジェ","sourceIds":{"vndbCharacterId":"c45458"},"originalCharacterName":"ミシェル・ボランジェ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1231"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1099"},{"spoiler":false,"text":"The youngest son of the Bollinger family."},{"spoiler":false,"text":"He lives all alone in the ill-fated manor."},{"spoiler":false,"text":"All the house's windows are shuttered or boarded up, draping it in darkness. It would seem he has little interest in engaging with the outside world."},{"spoiler":false,"text":"Michel seldom smiles, keeping his emotions locked up inside, but that is scarcely surprising, him having spent so much of his days in solitude."},{"spoiler":false,"text":"A peculiar encounter causes him to begin regaining some liveliness; however..."},{"spoiler":false,"text":"\"Please do not touch the drapes. Or the windows.\""},{"spoiler":false,"text":"From the English official site"}],"source":"vndb","sourceCharacterId":"c45458"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b69a5aeaa8b5ce3ec368b85bb5b5c6c54d5cc628d5072a1dcf73962deb80333d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44ad9f86a8bfd9b0f52f00770cb4fef8db9123e38fafd100dab5849e3c8449c3.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45460","characterName":"メル・ローズ","sourceIds":{"vndbCharacterId":"c45460"},"originalCharacterName":"メル・ローズ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1006"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1603"},{"spoiler":false,"text":"The eldest child of the Rhodes family."},{"spoiler":false,"text":"A mild-mannered young man with flaxen hair. He often finds himself at the behest of his younger sister, Nellie, whom he cares dearly for."},{"spoiler":false,"text":"Although Mell is intelligent, he lacks ambition. The priest at the church where he studies wants him to take up theology, but he has still yet to make up his mind. The time is quickly approaching for him to decide the course of his future, but he himself feels no urgency."},{"spoiler":false,"text":"The performing arts make him fall asleep, and his reaction to paintings is always an indifferent, \"Huh.\""},{"spoiler":false,"text":"While Mell's days are not particularly fulfilling, he is hardly discontent with his situation either. But one day, a young woman appears at his late grandfather's mansion, changing Mell's life drastically."},{"spoiler":false,"text":"\"It's just depressing to find out that someone you've never even met doesn't like you...\""},{"spoiler":false,"text":"From the English official site"}],"source":"vndb","sourceCharacterId":"c45460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c8921444d38049fa56cd826ba38076eb986947c3316452de68e58d5df2962b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94a60a0bd5cfbd44999b08b4257aba2df0f5f1a83b1240b46c1b107a4e91fa6c.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45461","characterName":"ネリー・ローズ","sourceIds":{"vndbCharacterId":"c45461"},"originalCharacterName":"ネリー・ローズ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"404"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1603"},{"spoiler":false,"text":"The second child of the Rhodes family."},{"spoiler":false,"text":"An energetic girl with flaxen hair who—while she can be pushy and self-centered—is also sweetly charming. Nellie has a wide variety of hobbies: from card games to dressing up, foreign sweets to theatre, and—of course—talking. She is also quite the impressionable young girl."},{"spoiler":false,"text":"Nellie is very close to her older brother, Mell, whom she calls her prince—a holdover from the make-believe games they played when they were younger. However, she's at the age where her family is beginning to plan her marriage, which has Nellie feeling rather melancholic."},{"spoiler":false,"text":"And then, one day, something happens to taint the girl's once pure, childlike cheer."},{"spoiler":false,"text":"\"Now, attend to your princess—as a proper prince should!\""},{"spoiler":false,"text":"From the English official site"}],"source":"vndb","sourceCharacterId":"c45461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eed47e7324843004162a8ff741a7a6e3b0fcd0802735f93869c95cce745c3b13.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dd99aaa79220565cce64251618e0c2db54676bb5a3a83097ec94d55689f1ce8.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45462","characterName":"貿易商の男","sourceIds":{"vndbCharacterId":"c45462"},"originalCharacterName":"貿易商の男","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"912"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1707"},{"spoiler":false,"text":"Passed away at the age of twenty-five."},{"spoiler":false,"text":"In life, the Merchant worked on an international trade ship. While he could be somewhat standoffish, he loved Pauline dearly, and though they were often worlds apart, his devotion to her never wavered."},{"spoiler":false,"text":"So how will their relationship change when faced with the ultimate barrier: death?"},{"spoiler":false,"text":"\"Absolutely, Pauline. As much as time allows, I will spend it with you.\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"He is the beast, referred to as Bestia, in year 1707. His real name is Aida Yukimasa (会田 幸正)."}],"source":"vndb","sourceCharacterId":"c45462"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01a449a243bf936e17d3d891065f0c1049ef7d6bf85b4cf9d9522aae05af114b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27e02baea5ce767f2b7bf3b905d25cd68d1258aa276b7d2520617f803c673be4.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45463","characterName":"ポーリーン","sourceIds":{"vndbCharacterId":"c45463"},"originalCharacterName":"ポーリーン","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"828"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1707"},{"spoiler":false,"text":"The daughter of a trader who, predictably, fell in love with a foreign merchant."},{"spoiler":false,"text":"She and her beloved are lucky to see each other more than once a year, but the bonds between them are unbreakable. Though separated by the vast seas, their relationship lives on."},{"spoiler":false,"text":"And then, one fateful day, she receives heartbreaking news: the Merchant has been involved in a fatal shipwreck. Pauline, however, refuses to believe he is dead, so she sets off on a journey in search of him."},{"spoiler":false,"text":"\"I have faith in him. He would never break a promise to me.\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"Her full name is Asama Pauline (浅間・ポーリーン)."}],"source":"vndb","sourceCharacterId":"c45463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/533eeef75680d4ad57b86f195a9f897cb78caf94c0838b19af00044d09c2725b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d5cead8a9c8e0fe6eeb250013a88911110f4408f5d5f9ccb00c71c1d815a23f.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45464","characterName":"ヤコポ・ベアルザッティ","sourceIds":{"vndbCharacterId":"c45464"},"originalCharacterName":"ヤコポ・ベアルザッティ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"310"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1869"},{"spoiler":false,"text":"A businessman who has invested in the budding rail industry."},{"spoiler":false,"text":"Ruthless and proud, Jacopo will readily toss aside anything and take advantage of anyone in order to further his own ambitions."},{"spoiler":false,"text":"Having clawed his way to the top in a world where the language is deceit and manipulation, Jacopo cannot even trust his own wife. There are only two things in life he can believe in: money and power."},{"spoiler":false,"text":"Just where will the rail industry—in which he has staked his entire livelihood—take him?"},{"spoiler":false,"text":"\"How many times are you gonna make me repeat myself, you worthless tramp? Are those ears only for show?\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"In Fata morgana no Yakata -Another Episodes-:"},{"spoiler":true,"text":"A sharp-tongued and somewhat difficult young man."},{"spoiler":true,"text":"Jacopo won’t stand for injustice, and he’s particularly displeased with the lord’s iron-fisted rule. He once assisted in a slave revolt at the lord’s estate."},{"spoiler":true,"text":"Never could he imagine the misfortune that awaits at the end of his path."},{"spoiler":true,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c45464"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ab829a9effaba137d9d4fa82f1852d62976de9a5cda8e327395863099f36b6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b35ac15ecd4f2bffeaba07435521601862e9ba84cfbb1066f213302efc87b3b.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45465","characterName":"マリーア・カンパネッラ","sourceIds":{"vndbCharacterId":"c45465"},"originalCharacterName":"マリーア・カンパネッラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"714"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1869"},{"spoiler":false,"text":"A maid who works in the mansion."},{"spoiler":false,"text":"She's affable and frank, cheerful and lackadaisical—but she never slacks on the job."},{"spoiler":false,"text":"Maria is the only one in the mansion willing to get involved with Jacopo's neglected, mistreated wife, with whom she's begun to form a friendship. She's also the only person who doesn't seem to fear Jacopo, though no one's quite sure why."},{"spoiler":false,"text":"\"If you're having a good time, what does it matter what's between your legs?\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"In Fata morgana no Yakata -Another Episodes-:"},{"spoiler":true,"text":"A caring, supportive young woman."},{"spoiler":true,"text":"She can come off as somewhat detached and impassive, but once you’ve won Maria’s trust, she treats you like family."},{"spoiler":true,"text":"And if you betray that trust, you’ll never get it back."},{"spoiler":true,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c45465"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a33331666cbe943ac0d386b94c7daa388febb81589a9d5ecfca1204986e8092a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5b18921664336e5bf0b3e3461b0bfbbf02d7e6117228d450632c828d4fe4abc.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48420","characterName":"モルガーナ","sourceIds":{"vndbCharacterId":"c48420"},"originalCharacterName":"モルガーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"107"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The victim of unimaginable torture at the hands of the lord."},{"spoiler":false,"text":"She prefers to keep her face hidden so people can’t see the strange marks that cover it."},{"spoiler":false,"text":"Morgana is a doggedly aloof young girl who rarely acts her age."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c48420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48534112ed4d91641bc014aa215c493a0987222363a8259717ff1e106c4b2f59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1da3269bd04f007c57863ab56207dd9b87c79f64838eb570fb75e63479715781.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69685","characterName":"ジェレン","sourceIds":{"vndbCharacterId":"c69685"},"originalCharacterName":"ジェレン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"209"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bright, spirited girl."},{"spoiler":false,"text":"Though she was taken from her home at a young age, Ceren maintains an outwardly positive outlook on life."},{"spoiler":false,"text":"It would also appear a certain someone has caught her eye, though she remains mum about who it is."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c69685"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d1e0b4a81c9d22b6f9a1b8232e907732fbc5ad9d7c1a8b6217550b9c01bb6e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d84bfa4f22baae1cb934f16251796fc662bbff208d2c0810f7e747c17aef8d68.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69686","characterName":"バルニエ","sourceIds":{"vndbCharacterId":"c69686"},"originalCharacterName":"バルニエ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The lord of the land, referred to by many as ”the second coming of the great tyrant of old.”"},{"spoiler":false,"text":"He tortures and murders slaves for his own perverse enjoyment, and he regularly hosts banquets at his estate, inviting other nobles with similar predilections."},{"spoiler":false,"text":"Barnier killed the former lord, as well as all of his close associates and their families."},{"spoiler":false,"text":"From MangaGamer"},{"spoiler":true,"text":"His full name is Jean-François Barnier."}],"source":"vndb","sourceCharacterId":"c69686"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74089345a38d2d2783cfff33ce89b89fa6772a10c9e0c4ec967f0c43fd5808d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24378ad5a16b4ac2e4057a30c3fd0f5d1c64470d2c45322e0d9bad48b3b861bd.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c69687","characterName":"グラシアン","sourceIds":{"vndbCharacterId":"c69687"},"originalCharacterName":"グラシアン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man and former slave who takes up residence in the slums after the revolt at the lord’s estate."},{"spoiler":false,"text":"Gratien, whose ancestors are rumored to have been gladiators, is a rowdy man with unparalleled physical strength, which is what has allowed him to survive so long."},{"spoiler":false,"text":"Like Jacopo, he despises the lord and his tyrannical rule. Over time, the two of them build up a trust for one another, eventually leading to talks of revolution."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c69687"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f3750e6bcfdb840957f18a66877cf65eb7b4bb2c031ed783d05582c02f4ea2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33ca7b26bddea58abaa589f20c52ddb6cf9ae81836336cf8d65daf3fbe5d8cea.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c71436","characterName":"イメオン"