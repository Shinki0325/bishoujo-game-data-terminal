leLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:10622","source":"vndb"},{"creditedName":"ろんじ","creatorId":"vndb:s12368","sourcePersonId":"vndb:s12368","canonicalEntityId":"vndb:s12368","name":"ろんじ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10623","source":"vndb"}]},"cast":[{"characterId":"char_c721","characterName":"児珠 十六夜","sourceIds":{"bangumi":[{"characterId":"53884","match":"exact-normalized-name-in-linked-work","subjectId":"214745"},{"characterId":"53884","match":"exact-normalized-name-in-linked-work","subjectId":"218780"}],"egsCharacterIds":["15446"],"vndbCharacterId":"c721"},"originalCharacterName":"児珠 十六夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界を守る「ステルラ・エクエス」―明星の騎士―として覚醒している女の子。"},{"spoiler":false,"text":"本来、エクエス（＝騎士）は、「人類を平等に扱う」必要があるが、十六夜は、暁だけを助けるため、結果的に一般人を犠牲にしてしまった過去を持つ。"},{"spoiler":false,"text":"その事実に苦しみながらも、自らの宿命を果たすべく、十六夜は、たった一人の戦いに身を投じていく。"}],"source":"egs","sourceCharacterId":"15446","sourceWorkId":"10735","spoiler":false},{"segments":[{"spoiler":false,"text":"体育会系の脳みその持ち主。"},{"spoiler":false,"text":"暁と同じクラスメイトで美少女として一目置かれる存在。"},{"spoiler":false,"text":"なんでも根性で解決しようとする傾向があるが、元々優しい性格なので人から頼まれたり、頼られたりするのは好き。"},{"spoiler":false,"text":"運動神経が良く、フットワークも軽い。"},{"spoiler":false,"text":"ヤると決めたらヤる性格。"},{"spoiler":false,"text":"ステルラとしては新米で、よく氷織に痛いところをつかれてケンカしている。"}],"source":"egs","sourceCharacterId":"15446","sourceWorkId":"12349","spoiler":false},{"segments":[{"spoiler":false,"text":"体育会系の脳みそを持つヒロイン。"},{"spoiler":false,"text":"暁と同じクラスメイトで美少女として一目置かれる存在。"},{"spoiler":false,"text":"なんでも根性で解決しようとする傾向があるが、元々優しい性格なので人から頼まれたり、頼られたりするのは好き。"},{"spoiler":false,"text":"運動神経が良く、フットワークも軽い。"},{"spoiler":false,"text":"やると決めたらヤる性格。"},{"spoiler":false,"text":"ステルラとしては新米で、よく氷織に痛いところをつかれてケンカしている。"}],"source":"bangumi","sourceCharacterId":"53884"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f77f817cf13b522a99b1d950982c38ca056ef9553bca31be98d3e6557211632.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8df7e07d39ad89bb5f46f0ccdf5fb5c1406dbfd410d4b94aba8ce62777c6b5c9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218780:53884:4830:1","source":"bangumi"}]},{"characterId":"char_c802","characterName":"フォーミュラ","sourceIds":{"bangumi":[],"egsCharacterIds":["18324"],"vndbCharacterId":"c802"},"originalCharacterName":"フォーミュラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エクシスの敵「プラクシス」の上位存在"},{"spoiler":false,"text":"「オクタヴァス・ペシシマス―八堕―」の一人。"},{"spoiler":false,"text":"ステルラにとって、暁が最重要存在であることから、特異点だと疑っており、その覚醒を促すため、暁と十六夜に罠を仕掛ける。"}],"source":"egs","sourceCharacterId":"18324","sourceWorkId":"10735","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d930b629ec10cf6a8c7d6a39adbfc0e5686dd14614380b961251f177a26b5f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53d7bd5f43518227a04f06b6e656d69a38481935b1279882d4603e159af6de23.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大波 こなみ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voi