55","name":"有限会社アイピックス","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63158","source":"vndb"},{"creditedName":"MARINE STUDIO","creatorId":"vndb:s50558","sourcePersonId":"vndb:s50558","canonicalEntityId":"vndb:s50558","name":"MARINE STUDIO","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63161","source":"vndb"},{"creditedName":"田口 ヨシハル","creatorId":"vndb:s50559","sourcePersonId":"vndb:s50559","canonicalEntityId":"vndb:s50559","name":"田口 ヨシハル","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63162","source":"vndb"}]},"cast":[{"characterId":"char_c12848","characterName":"春野 一葉","sourceIds":{"bangumi":[{"characterId":"141587","match":"exact-normalized-name-in-linked-work","subjectId":"462769"}],"egsCharacterIds":["26719"],"vndbCharacterId":"c12848"},"originalCharacterName":"春野 一葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"双子の姉。"},{"spoiler":false,"text":"とにかく明るく元気よく、主人公曰く「女らしい所を全部妹に持っていかれた」という位のやんちゃ娘。"},{"spoiler":false,"text":"実際は、細かいところに気が付く、世話好きな彼女。"},{"spoiler":false,"text":"自分よりも徐々に女性的になっていく妹に対して、やや焦りを感じて、冷たく接してしまい、それで自己嫌悪に陥ってしまっている。"},{"spoiler":false,"text":"主人公を妹よりも先に好きになった。"}],"source":"egs","sourceCharacterId":"26719","sourceWorkId":"5029","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく元気な、双子の長女。"},{"spoiler":false,"text":"主人公曰く「女らしい所を全部妹に持っていかれた」という位の やんちゃ娘。運動大好きで、小さな頃から主人公の背中をずっと追いかけ続けてきた。その行動が主人公への愛情によるものだと、本人も気がつかずに。その元気すぎる所から、主人公から見ると弟のような存在に落ち着いている。実際の一葉は男らしいわけではなく、細かい所に気がつくとても世話好きな少女であり、二葉よりも早く主人公への気持に気がついている。"},{"spoiler":false,"text":"その為、ずっと主人公を追いかけていくうちに、どうしてもその行動がやんちゃっぽくなってしまった。（言い換えると、主人公は女の子が一緒でもあまり気を使わないガサツな所がある訳だが） 本人はそんな自分のキャラクターに少し疑問を持ちつつも、 結果的にはそれが主人公のそばに居られる事であると納得している。 だが妹が徐々に女性的になっていく（女である事を自覚していく） のを感じて、少し焦りを感じ始めたり、気がつかない内に冷たく あたってしまって、自己嫌悪に陥ってしまったりする。 当然の事ながら、本当の一葉は妹の事はとても大切に思っていて、 二葉の事を自分の事のように心配している。"}],"source":"bangumi","sourceCharacterId":"141587"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/305290e31b9753ccd7fdc44a5a0f8eb08cd9b0d95aec681d2e6bb16e9801f816.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28f53474662ce8e8c00edc6ed763c712128b3365df3738d9974a71fd0eddd8ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:462769:141587:5020:1","source":"bangumi"}]},{"characterId":"char_c12849","characterName":"藤村 小夜子","sourceIds":{"bangumi":[{"characterId":"141589","match":"exact-normalized-name-in-linked-work","subjectId":"462769"}],"egsCharacterIds":["26721"],"vndbCharacterId":"c12849"},"originalCharacterName":"藤村 小夜子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の大学の先輩。"},{"spoiler":false,"text":"医学部卒で、現在は付属の大学病院の内科医として働いている。"},{"spoiler":false,"text":"主人公とは昔恋仲だったが、現在は友達以上恋人未満の関係を続けている。"},{"spoiler":false,"text":"生真面目でクールを装っているが、実は感情的になりやすいタイプ。"}],"source":"egs","sourceCharacterId":"26721","sourceWorkId":"5029","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の大学の先輩。"},{"spoiler":false,"text":"医学部卒で、現在は付属の大学病院の内科医として働いている。"},{"spoiler":false,"text":"主人公とは昔恋仲だったが、現在は友達以上恋人未満の関係を続けている。生真面目でクールを装っているが実は感情的になりやすいタイプ。"}],"source":"bangumi","sourceCharacterId":"141589"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/205d9900d2fd16154f30f8a663d230bc46659c11c50b2b609cf5b8f2e2114f8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e11768fcfabd85f41da6f7bf7642592c119577f65ceeb346ae9d3f744c9d414.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜庭わかな","creatorId":"vndb:s807","sourcePersonId":"vndb:s807","canonicalEntityId":"vndb:s807","name":"桜庭 わかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:462769:141589:11261:1","source":"bangumi"}]},{"characterId":"char_c12850","characterName":"春野 二葉","sourceIds":{"bangumi":[{"characterId":"141588","match":"exact-normalized-name-in-linked-work","subjectId":"462769"}],"egsCharacterIds":["26720"],"vndbCharacterId":"c12850"},"originalCharacterName":"春野 二葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"双子の妹。"},{"spoiler":false,"text":"元気快活な姉とは対照的に内気で大人しく、人見知りの激しい女の子。"},{"spoiler":false,"text":"主人公には色々と本を読んで聞かせて貰っていたため、本好きな女の子になったが、一人で読んでいても物足りなさを感じている。"},{"spoiler":false,"text":"姉よりも遅れて主人公への想いに気付く。しかし姉が主人公に好意を寄せていることに気付き、その狭間で悩んでいる。"}],"source":"egs","sourceCharacterId":"26720","sourceWorkId":"5029","spoiler":false},{"segments":[{"spoiler":false,"text":"大人しく内気な、双子の次女。"},{"spoiler":false,"text":"人見知りが激しく、いっつも一葉の後ろにヒシッとしがみ付いてい る。主人公を追いかける一葉の背中を、ずっと追いかけ続けてきた。 最初の頃は主人公とも馴染めず、やはり一葉の後ろに隠れていたが 今では打ち解けている。"},{"spoiler":false,"text":"主人公が色々な本を読んで聞かせて居た事から、読書好きな女の子 になった。だが自分で読んでいても何か物足りなさを感じている。 （それが実は本自体への興味ではなく、主人公の読み上げていた 声に心地よさを感じていたんだという事に、後になって気づく） 一葉よりも遅れて異性に目覚め、主人公に対する自分の気持に気 付くと同時に、一葉の主人公への想いにも気が付いて、その狭間で 悩む事になる。"}],"source":"bangumi","sourceCharacterId":"141588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c30a25602b2db6128b00ce3dc300b948cd86d19609496aa892c0312116bae0e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90946c88af635cc4d307e69a2573752454db65eb520139b995c4258f18e96955.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 りか","creatorId":"vndb:s1622","sourcePersonId":"vndb:s1622","canonicalEntityId":"vndb:s1622","name":"春日 りか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35368","source":"vndb"}]},{"characterId":"char_vndb_c12851","characterName":"佐々木　慎","sourceIds":{"vndbCharacterId":"c12851"},"originalCharacterName":"佐々木　慎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1870","sourceCompanyId":"egs:brand:1410","canonicalEntityId":"vndb:p1870","name":"INDIGO","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:5029:1410","source":"egs"},{"companyId":"vndb:p1870","sourceCompanyId":"vndb:p1870","canonicalEntityId":"vndb:p1870","name":"Indigo","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:14613:v6279","source":"vndb"},{"companyId":"vndb:p1208","sourceCompanyId":"vndb:p1208","canonicalEntityId":"vndb:p1208","name":"Ex12","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:20366:v6279","source":"vndb"},{"companyId":"vndb:p1870","sourceCompanyId":"vndb:p1870","canonicalEntityId":"vndb:p1870","name":"Indigo","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:20367:v6279","source":"vndb"}],"missingStates":["current-runtime-cover