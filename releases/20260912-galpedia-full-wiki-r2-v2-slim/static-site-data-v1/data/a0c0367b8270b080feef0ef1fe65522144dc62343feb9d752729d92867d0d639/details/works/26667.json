"}]},"cast":[{"characterId":"char_c41440","characterName":"武村 雄介","sourceIds":{"bangumi":[{"characterId":"35230","match":"exact-normalized-name-in-linked-work","subjectId":"124851"}],"egsCharacterIds":["5847"],"vndbCharacterId":"c41440"},"originalCharacterName":"武村 雄介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fairly ordinary office worker, if a bit on the selfish and anti-social side. After society collapses, he embraces his inner nihilist and does whatever he pleases in the new world of survival of the fittest. For some reason, the zombies don't attack him. In fact, he is unique in that they ignore him completely."},{"spoiler":false,"text":"He lost both his parents, and his surviving relative, his grandfather, passed away in a traffic accident two years earlier."},{"spoiler":false,"text":"From Denpasoft"}],"source":"vndb","sourceCharacterId":"c41440"},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"サラリーマンとしてごく普通の社会生活を送っていたが、利己的で人嫌いの気がある。"},{"spoiler":false,"text":"世界の崩壊後、心の奥に虚無的なものを抱えながらも、好き勝手にサバイバル生活を満喫する。ゾンビに襲われず、完全に無視されるという特徴を持つ。"},{"spoiler":false,"text":"両親はなく、唯一の肉親である祖父は、二年前に交通事故で死亡している。"}],"source":"egs","sourceCharacterId":"5847","sourceWorkId":"21619","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公"},{"spoiler":false,"text":"过着普通社会生活的工薪族，也有着市井自私与厌恶和他人交际的一面。"},{"spoiler":false,"text":"在世界崩坏后，心底虚无一片，十分满足于如今能够随心所欲的幸存者生活。"},{"spoiler":false,"text":"不受僵尸攻击，有着被僵尸完全无视的特征。"},{"spoiler":false,"text":"双亲双亡，而唯一的血亲祖父在二年前因交通事故死亡。"}],"source":"bangumi","sourceCharacterId":"35230"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4deecc41f2f9cf8e19bf19f7ad65a188b9908af4b4c1f9e0859586728c3aad2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ab0ce0ce5913af4ddf8e4c7a94011fe53d79a9c9251dbc38b12ac016c9b4404.webp","width":83,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c41441","characterName":"藤野 深月","sourceIds":{"bangumi":[{"characterId":"35231","match":"exact-normalized-name-in-linked-work","subjectId":"124851"}],"egsCharacterIds":["5848"],"vndbCharacterId":"c41441"},"originalCharacterName":"藤野 深月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An honor student with long brown hair."},{"spoiler":false,"text":"She has a somewhat shy personality, but is blessed with stunning good looks and is always worried about those around her."},{"spoiler":false,"text":"She takes on a rather rude attitude towards Yuusuke, in order to hide her embarrassment."},{"spoiler":false,"text":"Taken and translated from the Official Site"}],"source":"vndb","sourceCharacterId":"c41441"},{"segments":[{"spoiler":false,"text":"ヒロイン。長い黒髪の、優等生然とした少女。"},{"spoiler":false,"text":"性格は素直だが、容姿に恵まれていたことから、周りに気をかけられることが常だった。"},{"spoiler":false,"text":"ぶしつけな態度を取る雄介に、戸惑いを隠せないでいる。"}],"source":"egs","sourceCharacterId":"5848","sourceWorkId":"21619","spoiler":false},{"segments":[{"spoiler":false,"text":"女主人公。"},{"spoiler":false,"text":"一头乌黑青丝，一副优等生样的少女。"},{"spoiler":false,"text":"性格坦率，容姿秀丽。"},{"spoiler":false,"text":"因此经常被周围人所挂怀，照顾着。"},{"spoiler":false,"text":"丝毫不隐藏自己对态度贸然的雄介的困惑。"}],"source":"bangumi","sourceCharacterId":"35231"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/251c9ed80054e16be11a151190b3911f2cbda494d0f86a6c3c0453dc5df72134.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ead6f4702a6b048cd53a355a556c8a4e44bfd15065d8b73fb091d2d1036cc642.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:242779:35231:4809:1","source":"bangumi"}]},{"characterId":"char_c41442","characterName":"黒瀬 時子","sourceIds":{"bangumi":[{"characterId":"35232","match":"exact-normalized-name-in-linked-work","subjectId":"124851"}],"egsCharacterIds":["5849"],"vndbCharacterId":"c41442"},"originalCharacterName":"黒瀬 時子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"23"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tokiko was an office lady who lived on the same floor as Yuusuke’s apartment."},{"spoiler":false,"text":"She has the appearance of a literary girl with a gloomy face and her black loosely braided hair hanging down."},{"spoiler":false,"text":"Because she had been zombified, she is now Yuusuke’s toy."},{"spoiler":false,"text":"Taken and translated from the Official Site"}],"source":"vndb","sourceCharacterId":"c41442"},{"segments":[{"spoiler":false,"text":"雄介のマンションの同じ階に住むOL。"},{"spoiler":false,"text":"根暗な文学少女がそのまま成長したような姿で、黒髪をゆるく三つ編みにして垂らしている。ゾンビ化していたため、雄介の玩具にされる。"}],"source":"egs","sourceCharacterId":"5849","sourceWorkId":"21619","spoiler":false},{"segments":[{"spoiler":false,"text":"和雄介住同一个公寓的OL。"},{"spoiler":false,"text":"有着犹如性格阴沉的文学少女长大后的一副样貌。"},{"spoiler":false,"text":"因为已经被僵尸化，被雄介当成了玩具。"}],"source":"bangumi","sourceCharacterId":"35232"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1239fb24c9a5f973f42f7b41c