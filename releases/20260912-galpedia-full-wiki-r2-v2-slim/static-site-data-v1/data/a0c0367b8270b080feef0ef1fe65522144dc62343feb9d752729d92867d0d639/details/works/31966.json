"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"229"},"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"H"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"hip":{"reviewState":"source-only","source":"vndb","value":"104"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"88"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a nun at the local church, St. Mary's. She has a calm demeanor and a soft smile, and is kind to all people regardless of their background."},{"spoiler":false,"text":"As a nun, she has taken a vow of celibacy for the rest of her life, but perhaps as a reaction to this, she loves to talk about love, and when she hears about the troubles of a young girl in love, she is more than willing to help her, she even willing to offer herself to men caught up in lust."},{"spoiler":false,"text":"She is a good person, but her perception of sex is fatally off, and she is a naturally immoral whorish nun. It seems that she just barely keeps her chastity and exclusively uses her asshole."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c153198"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/131a6fbeeb826c679bc9965ca96aec0d0f141055586da023f432985348ebb17c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a0aa263c5cf2393405a2a6dfbd73bab2527faaa8ac8859b2979b8218d0541b9.webp","width":256,"height":254,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c153199","characterName":"灰島 ライ","sourceIds":{"vndbCharacterId":"c153199"},"originalCharacterName":"灰島 ライ","characterNameSource":