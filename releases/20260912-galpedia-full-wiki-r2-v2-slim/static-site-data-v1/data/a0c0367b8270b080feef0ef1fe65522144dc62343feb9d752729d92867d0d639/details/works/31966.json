eviewState":"source-only","source":"vndb","value":"78"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female student who goes to the same school as Haruki. Although they are classmates, they are in different classes and do not know each other."},{"spoiler":false,"text":"She is an honor student with excellent grades and good conduct, and has won prizes in art clubs and competitions, and is well known within the school. In reality, however, she is a whore with a dark side who lures men into her bed and gets wild in the nightlife."},{"spoiler":false,"text":"She is an M girl who gets off on making herself dirty as an honor student, and an S girl who gets off on dominating men who are inferior to her. She is a bitch in the shadows who slowly destroys her prey. She prefers honest and stupid men."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c153201"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/229049ead1be24aef02228138a1b097c825350ad30e94b4d44ab08a1bad31342.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6687f9125ef3f6ce8cb76406746efa551974e954168a7c5cbb1aabf1e1ea0cd3.webp","width":256,"height":255,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c153202","characterName":"布留見 ちふる","sourceIds":{"vndbCharacterId":"c153202"},"originalCharacterName":"布留見 ちふる","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"924"},"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a deer-like university student who lives in the neighborhood. She's 19 years old. She and Haruki used to go to school together when they were small children, and they still know each other's names and faces. She has a voracious appetite for sex and is very interested in the male body."},{"spoiler":false,"text":"At first glance, she appears mature and calm, but in fact, she has been a serious BL fan since elementary school and is still active as a doujinshi artist as a secret otaku. She is so deeply involved in the otaku world that she creates her own fanzine and participates in events."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c153202"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caae090d9fcaf32ef8eeb075bfe0fe6ca2d36733ed94eec2e3c3e9c6bafe7bea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e7304819134d6c703c2fb464c25238f0fb02e60c954c6237f71aa63315c6580.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c153203","characterName":"とめさん","sourceIds":{"vndbCharacterId":"c153203"},"originalCharacterName":"とめさん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious and enigmatic lady who runs a mysterious inn deep in a mysterious forest. She always speaks respectfully to everyone and is always calm. It is said that she gently welcomes and entertains travelers who wander into or arrive at the inn in the forest."},{"spoiler":false,"text":"She seems to be an eternal 22-year-old who loves sex, food, and sleep, and is faithful to her instincts. She is a hedonist who has no hesitation in committing acts when she knows that her partner wants them."},{"spoiler":false,"text":"She has a laid-back personality that puts the people she talks to at ease, but she can sometimes appear somewhat fragile and lonely. She may or may not have a fox roommate."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c153203"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6d7a9b3104247855fa89e937369dd31062c2985b5b05297aeef46e69b62ef1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7ca47919ab60828db19af254a7cafe2348c503546c81fb1555e5fc78673aa896.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c153204","characterName":"洞辺 みとり","sourceIds":{"vndbCharacterId":"c153204"},"originalCharacterName":"洞辺 みとり","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"birthday":{"reviewState":"source-only","source":"vndb","value":"414"},"bust":{"reviewState":"source-only","source":"vndb","value":"125"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"N"},"height":{"reviewState":"source-only","source":"vndb","value":"184"},"hip":{"reviewState":"source-only","source":"vndb","value":"120"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"94"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is 28 years old and works at a flower shop called \"Dandy Lion\" in a neighboring town. She is very attentive and knowledgeable about flowers, and is very good at choosing the right flowers for the right purpose."},{"spoiler":false,"text":"Her devotion to flowers is also shown to the person she is interested in, but sometimes it becomes too much attention to detail, and in fact, she is a heavy woman physically, personality-wise, and sexually."},{"spoiler":false,"text":"She is currently in a long-distance relationship with a boyfriend, but today at work, something unusual happened in their relationship... Her long-distance boyfriend called to break up with her, and she became extremely depressed."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c153204"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c69bfaf0e540b74a2ac226e8a17484e4ba76ec346804ba88483732c96921d5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d7dfc88aeb22e881e1374a687b77e7421dca77aeafa2a5a1fee112efb02f799.webp","width":256,"height":255,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c153205","characterName":"鈴秋 カエテ","sourceIds":{"vndbCharacterId":"c153205"},"originalCharacterName":"鈴秋 カエテ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1111"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cool, wolf-like female employee of a department store in a neighboring town where Haruki lives, she is 24 years old."},{"spoiler":false,"text":"She is a smart woman with a slender, tall figure, a beautiful face, and a cool demeanor, always attentive like a butler, and is admired and envied not only by the opposite sex but also by her own gender."},{"spoiler":false,"text":"She is a competent clerk who shows great politeness to Haruki when he visits the sales floor to prepare for his date. But she has a secret she can't reveal to anyone, and when he witnesses it, something happens..."},{"spoiler":false,"text":"official website"}],"source":"vndb","sourceCharacterId":"c153205"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57d85852cef9e9da97c6c09397c32e656415831159451b68e5a3cc0df1db10a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a492b9c2c305a13dcf1a9387428193f36c184c06d6a86afebceb38da54c3fb06.webp","width":256,"height":255,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c153206","characterName":"須垣 メイ","sourceIds":{"vndbCharacterId":"c153206"},"originalCharacterName":"須垣 メイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"61"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"127"},"hip":{"reviewState":"source-only","source":"vndb","value":"63"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a cat who works at “Heartland,” a small girl's store for big boys in the city center, far from the town where Haruki and his friends live. Her professional name is Yayoi."},{"spoiler":false,"text":"She is a sassy girl with a foul mouth, and calls herself a tease who makes fun of adults, but on the other hand, she is very sensitive and weak when she herself is teased."},{"spoiler":false,"text":"This is apparently also the secret of her popularity, but what is it that makes Haruki stop by a facility for adults in the first place? In fact, there is a “big sister” that she is in love with."},{"spoiler":false,"text":"official website"}],"source":"vndb","sourceCharacterId":"c153206"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3f7598fd5bb547b954f45fdc889629b378656e735d22ff6614777f7ef5422cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffac16c6aef85fea8cb7fd1c3b8ae1abff832dafecc1f016751a6175a9572c31.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c153207","characterName":"有堂院 ほろび","sourceIds":{"vndbCharacterId":"c153207"},"originalCharacterName":"有堂院 ほろび","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Just after Haruki left home, he was stopped by her on the street, a small-bodied, fox-kid with a pompous attitude. She has mysterious powers and tells Haruki what to watch out for by divining his future and writing a poem about it."},{"spoiler":false,"text":"Her true identity is shrouded in mystery, as she has adult-like words and actions that do not match her appearance, and when she exerts her power, she grows something that looks like a devil's wings. By the way, her hat and glasses are apparently borrowed."},{"spoiler":false,"text":"She collects “soul coins,” which are crystals of strong “will,” and uses them as the price for fortune-telling."},{"spoiler":false,"text":"official website"}],"source":"vndb","sourceCharacterId":"c153207"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6a8f5381cebcce4056dc50b8aa558cf7b7430a3c3179b87644925cc663a61c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e17e67afcad9595791dc02b78ceae3d4bc9c39c498404c1bcf62e415c8393398.webp","width":256,"height":255,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p10357","sourceCompanyId":"egs:brand:4891","canonicalEntityId":"vndb:p10357","name":"トキノコギリ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31966:4891","source":"egs"},{"companyId":"vndb:p7778","sourceCompanyId":"vndb:p7778","canonicalEntityId":"vndb:p7778","name":"FAKKU!","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:125259:v32281","source":"vndb"},{"companyId":"vndb:p7778","sourceCompanyId":"vndb:p7778","canonicalEntityId":"vndb:p7778","name":"FAKKU!","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:153069:v32281","source":"vndb"},{"companyId":"vndb:p7778","sourceCompanyId":"vndb:p7778","canonicalEntityId":"vndb:p7778","name":"FAKKU!","roleCodes":["publish