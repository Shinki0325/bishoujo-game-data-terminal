:"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【シリーズ最強にプリティなメインヒロイン】"},{"spoiler":false,"text":"すっかり一人前の悪魔となったいまでも、どんくさく、すぐに泣く。"},{"spoiler":false,"text":"自分を助けてくれた主人公のことを心から愛している。"},{"spoiler":false,"text":"ヨーグルトや、なれ鮨などの乳酸菌食品を食べると酔っぱらう。"}],"source":"egs","sourceCharacterId":"14389","sourceWorkId":"13072","spoiler":false},{"segments":[{"spoiler":false,"text":"生来の気の弱さと優しさのせいで、悪いことが全くできない新米悪魔。リリムから一人前の悪魔になるべく、大魔王アザゼルの命を受け人間界に来るも、空腹で倒れる。行き倒れのところを主人公に拾われ、何かにつけて自分を大事にしてくれる姿に一遍で恋に落ちてしまう。料理はてんでダメで、得意なものは冷凍食品の解凍。牙があるのを気にしていて、からかわれると泣き出す。"}],"source":"bangumi","sourceCharacterId":"59012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3db53e65468d35d9a8d093ecb8add20e29f894d29e28dde2b5eba5bcd7f8a50d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d7f2767a580703a292965c28b97e4424da7c4379e23ebf912c18e2d53ab1fe7.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229707:59012:4830:1","source":"bangumi"}]},{"characterId":"char_vndb_c118799","characterName":"和倉 創太","sourceIds":{"vndbCharacterId":"c118799"},"originalCharacterName":"和倉 創太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","v