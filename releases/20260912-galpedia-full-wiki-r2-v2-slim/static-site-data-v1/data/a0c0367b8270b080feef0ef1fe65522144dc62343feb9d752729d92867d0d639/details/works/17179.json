":"17179","spoiler":false},{"segments":[{"spoiler":false,"text":"一ノ瀬的手下。以脂肪过多的体格为特征。"},{"spoiler":false,"text":"被其他的成员称呼为“猪”，但本人并没有讨厌。"},{"spoiler":false,"text":"通称“佐猪（和さくた音近）”。和新山一样不打冲锋，只享用一ノ瀬所剩下来的东西。"}],"source":"bangumi","sourceCharacterId":"18781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e408016fc9190c9c38a409c02a598952f41d26702d97e9e7e6e190075602d9ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76cd846a6418713f924864b33d8969b0d114bdcc6c02afb8d49e89957ebd41c7.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c68260","characterName":"舟木 聡詞","sourceIds":{"vndbCharacterId":"c68260"},"originalCharacterName":"舟木 聡詞","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kana's boyfriend."}],"source":"vndb","sourceCharacterId":"c68260"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d94b7f7812e5b2a248dfae5465fbef351bc5ad61b478bb9c9aadf7574db701f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01719f996652f630b0cdae29a63def1b804aa71f4e9a21ed2c1b92b3414cf73d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c68261","characterName":"三上 惣介","sourceIds":{"vndbCharacterId":"c68261"},"originalCharacterName":"三上 惣介","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akira and Mai's father."}],"source":"vndb","sourceCharac