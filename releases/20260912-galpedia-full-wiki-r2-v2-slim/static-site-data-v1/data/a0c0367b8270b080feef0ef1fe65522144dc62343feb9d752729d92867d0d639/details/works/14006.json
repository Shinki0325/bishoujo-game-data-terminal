b","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“S-S-S-Stop saying such stupid things! I-I can’t believe you! I can’t believe you!”"},{"spoiler":false,"text":"A daughter of the Kanemoto Group, which is among the foremost conglomerates in the nation. She’s diligent in character and abides by a strong work ethic, but because she isn’t used to receiving praise from others, she has a surprisingly shy side to her. She absolutely hates hot drinks."},{"spoiler":false,"text":"From The Oxford Comma is Superior Subs"}],"source":"vndb","sourceCharacterId":"c713"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f424148f9005df0f1e19d682cf96c284d9900c622ec000f809168ea2b343c71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88d53f107cf36f1d94bee06348b46b6a680daaadd0be138fab1029cc8b603536.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真中 海","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29423","source":"vndb"}]},{"characterId":"char_vndb_c714","characterName":"藤島 匠","sourceIds":{"vndbCharacterId":"c714"},"originalCharacterName":"藤島 匠","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takumi is the protagonist of this story."},{"spoiler":false,"text":"Because he has lived in poverty for a long time, he has to work very hard to get more allowance to support himself daily at home."},{"spoiler":false,"text":"Basically, he is serious in earning more money for himself."},{"spoiler":false,"text":"Edited and roughly translated from the Getchu's website"}],"source":"vndb","sourceCharacterId":"c714"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef081e35c43bd1cb7c95211b7f5345087cecd3fdc97e7baa40ca79bdded89887.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/396492199cace53678e419c27a783870a7696a99929a5b84ab0c51ac8e1562dd.webp","width":200,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c725","characterName":"月山 瀬奈","sourceIds":{"vndbCharacterId":"c725"},"originalCharacterName":"月山 瀬奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“I certainly am a servant, but… I am not quite suited to that type of sexual work… Hawawa~”"},{"spoiler":false,"text":"A maid employed by the Kanemoto family. Although she doesn’t possess any distinguishing talents as a maid, she carries out all the housework flawlessly. Due to her open imagination, she occasionally runs rampant with arbitrary thoughts. She doesn’t do well with pitch-black darkness and ghost stories, so much so that she could end up crying. Her dream is to become the head maid of the Kanemoto family."},{"spoiler":false,"text":"From The Oxford Comma is Superior Subs"}],"source":"vndb","sourceCharacterId":"c725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/335efd7f5b67d1f24291134a86556491dcb145831a0420d5ec530ce3ce7d2255.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/555cf89b423917d288261f56178b5aa33d059005ad08dc35eef396ed89701909.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五行 なずな","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29419","source":"vndb"}]},{"characterId":"char_vndb_c726","characterName":"国広 ひなた","sourceIds":{"vndbCharacterId":"c726"},"originalCharacterName":"国広 ひなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Buu! Rude, you’re rude! What do you mean I’m ‘small’!?”"},{"spoiler":false,"text":"The protagonist’s upbeat and upfront kouhai. Although she has been connected with a large business from the beginning, she fits into the lowest of the masses as a result of the common lifestyle that her family has lived. She isn’t suited to the world of socialites; for example, eating high-class food gives her a stomach ache."},{"spoiler":false,"text":"From The Oxford Comma is Superior Subs"}],"source":"vndb","sourceCharacterId":"c726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aa178f20966e0cce6de1604345b18c115892ba9e0a79b3b5d574c8b100ba97e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8ae24d6faf11b6a0923074791f5ed324435fccd9c8567dec1b33da4f1dca85a6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々 露香","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29422","source":"vndb"}]},{"characterId":"char_vndb_c727","characterName":"長光 麻夜","sourceIds":{"vndbCharacterId":"c727"},"originalCharacterName":"長光 麻夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"s