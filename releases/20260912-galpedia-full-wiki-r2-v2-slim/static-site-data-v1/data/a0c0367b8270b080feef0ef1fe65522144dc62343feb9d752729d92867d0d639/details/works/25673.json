"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Prince of the Kingdom of Wisteria and Alice's younger brother. Originally he was the only one who had the first right to the throne."},{"spoiler":false,"text":"His body is weak, but he is intelligent, so he's been assisting his father, the king, at a young age. Perhaps because of this, he has a calm and quiet personality for his age, but he has a tough attitude towards Alice."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113615"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3b93b93f9ea49256e91802dae26eedb6bbe12325b9dc39f1a3ea4ed70a0b427.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/232aef5358d38c7e21efaf5111acb9c08e09f1ea9d0b399424848ef73e363d48.webp","width":84,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113616","characterName":"ウェルシュ","sourceIds":{"vndbCharacterId":"c113616"},"originalCharacterName":"ウェルシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1101"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man who runs a bakery in the border town of Avic. He is a childhood friend (?) who has played with Alice several times in the past."},{"spoiler":false,"text":"He has a bright and lively personality, and is a caring older brother with a good temperament. He can't help but feed a hungry child."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113616"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dbbc5535676498312c0da03e7a063833f51e4b4e01705d3203dcd06f21e12ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68e70f326f395652458e60a58567c86d6212838b361d44d28c6c7908088f202c.webp","width":90,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113617","characterName":"ルピナス・エールステッド","sourceIds":{"vndbCharacterId":"c113617"},"originalCharacterName":"ルピナス・エールステッド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"820"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The prince of the neighboring country of Oersted. A boy possessed by the flame fairy Prominence. He has a strong power due to the fairy possessing him."},{"spoiler":false,"text":"He has a free-spirited and elusive personality, and while he often tells Alice that he likes her, he doesn't mind doing terrible things."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113617"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18ff92246caa2c752fbd4e15408424cf3ab43b9122eab5251da9059ba686d7ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d13f35f015bb0e9494cf3fca2d7eaa04fc02187563d7050f431aba130bfb6b2.webp","width":147,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113618","characterName":"リーフ","sourceIds":{"vndbCharacterId":"c113618"},"originalCharacterName":"リーフ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A plant fairy who possesses Alice. She is a good friend of Alice, and often consults and hangs out with her. She dotes on Alice."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113618"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6ab76c821d7c2213e32339b3f05deca7eb5cec75186c11211557e7fa28020b65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a2f04f15e18d58ca103e4377cdc8cbef864982d397465cec294b13e760ec43f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113619","characterName":"プロミネンス","sourceIds":{"vndbCharacterId":"c113619"},"originalCharacterName":"プロミネンス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fire fairy who possesses Lupine. Lupine's actions tend to get swayed by him, but he seems to be affectionate."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113619"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4fe90393840284bdf4502bd7e22116796266b2e37ba85858ee795f173e1dfa8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04b99f4a0f26161eb3c523f376d7154234cc64102c81b4668cb3e63e635c3a25.webp","width":166,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113620","characterName":"フィナンシェ","sourceIds":{"vndbCharacterId":"c113620"},"originalCharacterName":"フィナンシェ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1225"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man who is Alice's knight and at the same time serves as the vice-captain of the subjugation team."},{"spoiler":false,"text":"He is always serious and has a strong loyalty to Alice. He is a versatile person who can do almost anything."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113620"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcce29692892fe97747735772dda459be7472d5a84896f09bdba9097aeec29b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd3655f761fda1952bd87d0fee0f0f171db82832720b0f23aca8995d78a76e2e.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113775","characterName":"王","sourceIds":{"vndbCharacterId":"c113775"},"originalCharacterName":"王","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The father of Alice and Leon. He is the king of Wisteria."},{"spoiler":true,"text":"His true name is Fres (フレス) and he fell in love with Serena, a girl who was possessed by the fairy \"Time.\" Serena, who had the ability to see the future of people she interacted with, offered a contract to him: she would lead him to the happiest future but, in turn, they would need to get married."},{"spoiler":true,"text":"The final part of their contract concerned Alice, their first child. Although Serena was able to tell that Alice would need to make an important decision at the age of 15, she was unable to know which path she would take. Because Serena was destined to die long before then, Fres would need to tell her what decision she made once he died as well."}],"source":"vndb","sourceCharacterId":"c113775"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fe187b2c3c1d6c52fe1e17a708b94643e80ed2621782b472834a6af452114b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25402f1589f006314bab787e92b23df5205ed94cdd23833b5e83d9a948a90f8c.webp","width":170,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113785","characterName":"エナーシャ・エカトリアル","sourceIds":{"vndbCharacterId":"c113785"},"originalCharacterName":"エナーシャ・エカトリアル","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A weak girl possessed by the fairy Aqua. She is in a romantic relationship with Touri."},{"spoiler":true,"text":"She died while giving birth to Lupinus. This was completely willing on her part, as she only had a few years left to live anyways and didn't want Touri to be alone. She never told him that she knew she would die, instead telling Aqua that it was a \"secret.\""}],"source":"vndb","sourceCharacterId":"c113785"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0042411705d604e6919fe417c17bfbfc4a903386e60e834d5368d9a31913913.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/041cf40941c7b2c1861b78a0b569555b247635160cdbe25083418200c5498c9c.webp","width":193,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113786","characterName":"トーリ","sourceIds":{"vndbCharacterId":"c113786"},"originalCharacterName":"トーリ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A shy man who Leaf comes across after telling Alice that she can \"hear the sound of water.\" It turns out the sounds she heard actually came from the pendant Touri carried, which was one of the last things he had left of his wife, Enertia."},{"spoiler":true,"text":"He is Lupinus' father who neglected his son because of the grief he experienced after his wife passed away. His absence from his son's life was one of his greatest regrets. He was happy when Lupinus said he wanted them to be the family they never were before, but is still shown to be a little shy when talking to him."}],"source":"vndb","sourceCharacterId":"c113786"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80be417b02912c6b3fbe17da6f69c33c9363532cdd00906c2b420371e6e607bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f67feb74512e1408b5666a128653f7244a44b52f8d6cbce3cf7ff217e519142.webp","width":174,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113787","characterName":"アクア","sourceIds":{"vndbCharacterId":"c113787"},"originalCharacterName":"アクア","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The kind water fairy who possessed Enertia."}],"source":"vndb","sourceCharacterId":"c113787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9f78e35219054a88c1467f7e550c17644462c462b27ee0d10498d9b0d4b30d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9c1dca0518e6da4e3ff0e3976ad3cc42598700d5458027a56676a7855f81198.webp","width":201,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113920","characterName":"セリナ","sourceIds":{"vndbCharacterId":"c113920"},"originalCharacterName":"セリナ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Serena was a girl possessed by the fairy \"Time.\" Although she could see the future, she could only see the futures of people who regularly interacted with her. She was able to predict her death and tell which path would grant her the longest life."},{"spoiler":true,"text":"This path would lead her to marry Fres, a prince who wanted as happy a future as possible. Upon their very first meeting, she proposed a contract to him: she would lead Fres down the route that would grant him both the throne and a happy future. However, in turn, Fres would need to agree to marry her."},{"spoiler":true,"text":"After their marriage, they had two children. She kept secret about her possession. The final part of their contract concerned their first child, Alice. Serena was able to tell that Alice would make an \"important decision at the age of 15,\" although she couldn't tell what choice she would mkae. Knowing she would die before she could ever find out, Serena requested that Fres tell her once he died as well."}],"source":"vndb","sourceCharacterId":"c113920"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p7481","sourceCompanyId":"egs:brand:5509","canonicalEntityId":"vndb:p7481","name":"ベルカゲ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25673:5509","source":"egs"},{"companyId":"vndb:p7481","sourceCompanyId":"vndb:p7481","canonicalEntityId":"vndb:p7481","name":"ベルカゲ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:72008:v25835","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
