a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223620:205454:6083:1","source":"bangumi"}]},{"characterId":"char_c17890","characterName":"サティー","sourceIds":{"bangumi":[{"characterId":"205455","match":"exact-normalized-name-in-linked-work","subjectId":"223620"}],"egsCharacterIds":["11170"],"vndbCharacterId":"c17890"},"originalCharacterName":"サティー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Goddess of knowledge."}],"source":"vndb","sourceCharacterId":"c17890"},{"segments":[{"spoiler":false,"text":"無口でクールながら優しく、どこか寂しがり屋なところを持つ。"},{"spoiler":false,"text":"エッチには無知だが、健気にいじらしく妻として奉仕しようとする。"}],"source":"egs","sourceCharacterId":"11170","sourceWorkId":"14453","spoiler":false},{"segments":[{"spoiler":false,"text":"無口でクールながら優しく、どこか寂しがり屋な女神。"},{"spoiler":false,"text":"他の女神や愛するあなたにだけ懐き、普段は見せない甘えん坊なところも見せる。"},{"spoiler":false,"text":"妻として、愛するあなたにも健気に尽くそうとする。"},{"spoiler":false,"text":"「サティーも……奥さんとして、頑張る」"}],"source":"bangumi","sourceCharacterId":"205455"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d45da37bd86998b0ae2d76877ee82273a447d50e2b9688a0b32f03cf1ec6ac2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d3be056abd40e825a6b29067b14f92e8af0f6a33102ff311296fd4c7c29f557.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223620:205455:15684:1","source":"bangumi"}]},{"characterId":"char_c17891","characterName":"シャル","sourceIds":{"bangumi":[{"characterId":"205453","match":"exact-normalized-name-in-linked-work","subjectId":"223620"}],"egsCharacterIds":["11168"],"vndbCharacterId":"c17891"},"originalCharacterName":"シャル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Goddess of the weather."}],"source":"vndb","sourceCharacterId":"c17891"},{"segments":[{"spoiler":false,"text":"甘えん坊で照れ屋だが素直になれずツンツンしてしまうところがあり、主人公に対しては見下すような態度やキツつく当たる。"},{"spoiler":false,"text":"しかし、内面では彼にベタ惚れ状態。"}],"source":"egs","sourceCharacterId":"11168","sourceWorkId":"14453","spoiler":false},{"segments":[{"spoiler":false,"text":"素直になれない甘えた照れ屋のツンツン女神。"},{"spoiler":false,"text":"過激な言動であなたをなじる事もあるが、それは全て強すぎる愛情の裏返し。"},{"spoiler":false,"text":"内心ではあなたのことが大好きで、愛情も嫉妬も人一倍。"},{"spoiler":false,"text":"「バカ！ 絶対殺す！　…私だけ見てられるように枯れ死にさせてやるんだから！」"}],"source":"bangumi","sourceCharacterId":"205453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/283e77492660defbdace5952f8d08c8cbaebe82ea244691d4352e16bbed792fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7351423f880211795bd336c2d5239ce134ed965fd247bc68a8df55673d7cea4d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223620:205453:10026:1","source":"bangumi"}]},{"characterId":"char_c17892","characterName":"アイラ","sourc