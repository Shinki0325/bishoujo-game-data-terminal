60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"富士原家の長女。"},{"spoiler":false,"text":"神社を管理していた両親が二年前に事故死（実は敵対する蘇我乃一族により暗殺された）してから、富士原家の当主として神社を護ってきた。"},{"spoiler":false,"text":"性格はおっとり優しく穏やかだが、真面目でしっかりしている。"},{"spoiler":false,"text":"「姫武者」として戦うときは、弓を武器に遠距離からの後方支援的な役割を担う。"}],"source":"egs","sourceCharacterId":"26231","sourceWorkId":"6365","spoiler":false},{"segments":[{"spoiler":false,"text":"富士原家の長女。おっとり優しいしっかり者のお姉さん。"},{"spoiler":false,"text":"神社の管理をしていた両親が２年前に蘇我乃一族によって暗殺されてからは、富士原家の当主として、神社を護り続けている。"},{"spoiler":false,"text":"性格は穏やかで、わりと何でも許してしまうタイプ。…ではあるが、富士原家の当主として家を護り、主人公を護っていかなければならないという重責を担っている。"},{"spoiler":false,"text":"マジメなので、その使命を自覚し、遂行することにやぶさかではないが、そういう運命を受け入れ、覚悟して事にあたっている潔さはある。"},{"spoiler":false,"text":"…しかし時おり、その重さに打ちひしがれてしまうことも…。"}],"source":"bangumi","sourceCharacterId":"219485"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"26231","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"26231","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"26231","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"26231","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"26231","sourceWorkId":"6365","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16abdbd7863dfd1608bc5a715f39f92b60188667d64c875162288f908150ad20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3df08a94496cb29caf0cc9c19ccb8e89d259541b