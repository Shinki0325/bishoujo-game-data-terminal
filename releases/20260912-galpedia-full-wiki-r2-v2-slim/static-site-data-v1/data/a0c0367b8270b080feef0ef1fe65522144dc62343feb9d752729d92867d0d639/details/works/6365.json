」というよりは、自分の大好きなお兄ちゃんに何か悪さをしようとするヤツがいるのは許せない！ といった感じ。"},{"spoiler":false,"text":"お兄ちゃんが大好き。姫武者としての戦闘も大好き。TV等で注目されているのも好き。"},{"spoiler":false,"text":"こんな毎日がずっと続くといいなァ、そしたらあたし、ずっと楽しいままなのに…と、能天気に毎日を楽しんでいる。"}],"source":"bangumi","sourceCharacterId":"219487"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"26233","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"26233","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"26233","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"26233","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"26233","sourceWorkId":"6365","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/461a2dc649826e89130d39d8708f34fd45503dfd2cc04745a15bfaa747a9788a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9530c81bf847a5a1e6fbe4ad4e17157b35f52fc55b764fd875bc519dca97026f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:348618:219487:4689:1","source":"bangumi"}]},{"characterId":"char_c44091","characterName":"蘇我乃 水鶏","sourceIds":{"bangumi":[{"characterId":"219489","match":"exact-normalized-name-in-linked-work","subjectId":"348618"}],"egsCharacterIds":["26235"],"vndbCharacterId":"c44091"},"originalCharacterName":"蘇我乃 水鶏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“金の種子（精）”を持つ尼友一族が子孫である主人公を狙う蘇我乃一族の末裔の一人。"},{"spoiler":false,"text":"子猫に可愛らしい女の子だが、計算高く狡猾な少女。"},{"spoiler":false,"text":"彼女のその容姿や振る舞いに騙され、酷い目に遭った人も多い。"},{"spoiler":false,"text":"幼く見えてセックスは大好きで、“金の種子（精）”の受精のときは、どんな快感が得られるか、とワクワクしている。"},{"spoiler":false,"text":"ビームライフルを巧みに使い、遠距離から獲物を狙う。"}],"source":"egs","sourceCharacterId":"26235","sourceWorkId":"6365","spoiler":false},{"segments":[{"spoiler":false,"text":"非常に頭が良く、性悪仔猫のようなかわいらしさを持つ。常に無表情。いつも何かを企んでいるような、油断のならない目をしている。"},{"spoiler":false,"text":"心の底では誰も信じていないが、それでも媚びることだけはうまい。泣き真似なんかも年季が入っていて、周囲の誰もが騙されて、いつもヒドい目に遭わされている。"},{"spoiler":false,"text":"幼く見えるその容姿とはうらはらに、セックスが大好き。快楽を追求したいタイプ。"},{"spoiler":false,"text":"黄金の種子受精時の快感は果たしてどんなものだろうと今からワクワクと期待している。"}],"source":"bangumi","sourceCharacterId":"219489"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"26235","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"26235","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"26235","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"26235","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"