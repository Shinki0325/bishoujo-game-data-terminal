":"26234","sourceWorkId":"6365","spoiler":false},{"segments":[{"spoiler":false,"text":"”黄金の種子”の受精に一番意欲を燃やしている、とにかく「全てが欲しい」女性。"},{"spoiler":false,"text":"次世代の支配者を生みたいし、自分も世界を支配してみたい。”黄金の種子”を受精するなら当然そのセックスも気持ち良いだろうから味わってみたいし、目の上のタンコブの姫武者なんてメチャクチャに蹴散らしちゃってリョージョクしちゃいたいし…と、自分の思い付く欲望は全て実現したいし、実際今までもその妖艶さを武器に、そうしてきた。"},{"spoiler":false,"text":"最近は、政府要人暗殺計画を次々と姫武者たちに阻止されて、イライラが募っている。"},{"spoiler":false,"text":"次々と仕掛けられる妖しい魅力たっぷりの誘惑から主人公は逃れられるのか？"}],"source":"bangumi","sourceCharacterId":"219488"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"26234","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"26234","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"26234","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"26234","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"26234","sourceWorkId":"6365","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fbbf1cf21435ca94df40a99530647533082d3f5d6af51c11d4095bbc70c1b2e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b5dd6b14279c04964728e7021addbef4a5045c32bd890383147c2524ddfc540.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:348618:219488:6409:1","source":"bangumi"}]},{"characterId":"char_c44093","characterName":"大海 花菜","sourceIds":{"bangumi":[{"characterId":"219490","match":"exact-normalized-name-in-linked-work","subjectId":"348618"}],"egsCharacterIds":["26236"],"vndbCharacterId":"c44093"},"originalCharacterName":"大海 花菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が通う飛鳥学園に編入してきた女の子。"},{"spoiler":false,"text":"その立ち居振る舞いは礼儀正しく丁寧で、清純さと可憐さを兼ね備え、その可愛らしい容姿と相俟って、編入して早々、男子学生のアイドル的存在になる。"},{"spoiler":false,"text":"主人公に一目惚れし、素直な愛情を表現するが……。"}],"source":"egs","sourceCharacterId":"26236","sourceWorkId":"6365","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の学園に編入してきた清純派美少女。"},{"spoiler":false,"text":"学園に編入してきて以来、男子生徒にアイドル視されている。その立居振舞いや言葉使いは清純そのもの。おとなしく丁寧で礼儀正しく、適度に恥ずかしがりやで、いつも花のような笑顔を浮かべている。清純で汚れを知らないようであるが…。"},{"spoiler":false,"text":"主人公に一目惚れし、素直な愛情を寄せている。"},{"spoiler":false,"text":"----しかし、主人公も彼女が気になり始めた矢先、ある出来事が……"}],"source":"bangumi","sourceCharacterId":"219490"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"26236","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"26236","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"26236","sourceWorkId":"6365","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacter