onId":"vndb:vn-staff:41621","source":"vndb"},{"creditedName":"Marshan","creatorId":"vndb:s12034","sourcePersonId":"vndb:s12034","canonicalEntityId":"vndb:s12034","name":"MARSHAN","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:41623","source":"vndb"},{"creditedName":"イナヅキ ススム","creatorId":"vndb:s23115","sourcePersonId":"vndb:s23115","canonicalEntityId":"vndb:s23115","name":"イナヅキ ススム","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:41624","source":"vndb"},{"creditedName":"アユシェアイア","creatorId":"vndb:s23118","sourcePersonId":"vndb:s23118","canonicalEntityId":"vndb:s23118","name":"アユシェアイア","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:41625","source":"vndb"},{"creditedName":"アユシェアイア","creatorId":"vndb:s23118","sourcePersonId":"vndb:s23118","canonicalEntityId":"vndb:s23118","name":"アユシェアイア","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:41626","source":"vndb"}]},"cast":[{"characterId":"char_c41640","characterName":"ミリィ","sourceIds":{"bangumi":[{"characterId":"61588","match":"exact-normalized-name-in-linked-work","subjectId":"240067"}],"egsCharacterIds":["13797"],"vndbCharacterId":"c41640"},"originalCharacterName":"ミリィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【天使？　悪魔？　二律背反のメイド】"},{"spoiler":false,"text":"メイドに仕えるメイド。"},{"spoiler":false,"text":"家事全般のみならず護身術なども叩き込まれている。"},{"spoiler":false,"text":"また、夜伽の手ほどきも受けており、性奉仕や調教の手助けも行う。"},{"spoiler":false,"text":"いつも笑顔を絶やさぬメイドの姿と裏腹に性奴に対しては冷酷無比な調教を施す。"},{"spoiler":false,"text":"それは主人公への想いの強さが生んだ激しい嫉妬心ゆえである。"},{"spoiler":false,"text":"「どうぞご遠慮なく淫らに達してくださいませ」"}],"source":"egs","sourceCharacterId":"13797","sourceWorkId":"12229","spoiler":false},{"segments":[{"spoiler":false,"text":"幼い頃に主人公の家に拾われ、主人公付きのメイド（＝従者）となった女性。"},{"spoiler":false,"text":"主人公の世話のため、家事全般のみならず護身術も叩き込まれ、さらには夜伽の手解きまでも受けており、性奉仕や調教のサポートも行う。"},{"spoiler":false,"text":"主人公に心から想いを寄せており、主人公が調教者に対して心を向ければ向けるほど、彼女の中で嫉妬心が燃え上がり、その調教者に対しての責めがエスカレートする。"}],"source":"egs","sourceCharacterId":"13797","sourceWorkId":"13457","spoiler":false},{"segments":[{"spoiler":false,"text":"幼少の頃に親に捨てられ、主人公の家に拾われて育ちメイドとなった。"},{"spoiler":false,"text":"主人公を世話するため、家事全般のみならず護身術なども叩き込まれている。"},{"spoiler":false,"text":"また、夜伽の手ほどきも受けており、主人公に性の奉仕をするだけでなく調教の手助けも行う。"},{"spoiler":false,"text":"主人公を心の底から慕うあまり、調教対象に少しでも心が向けばその嫉妬心は残虐な陵辱行為として調教対象に向けられる。"},{"spoiler":false,"text":"穏やかなメイドとしての微笑の中に、時おり冷静沈着な調教師助手としての残忍さが顔を出す。"},{"spoiler":false,"text":"「どうぞご遠慮なく淫らに達してくださいませ」"}],"source":"bangumi","sourceCharacterId":"61588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af606b716314b027d2ba76f11a0af250daee049e0ed30aad8db948c5edab663c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2206da738e9e248a6395234f681489e7a16b32d95ed853b508fb77521d50fa06.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金松 由花","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22801","source":"vndb"}]},{"characterId":"char_vndb_c41609","characterName":"アレク・フォブレ","sourceIds":{"vndbCharacterId":"c41609"},"originalCharacterName":"アレク・フォブレ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9