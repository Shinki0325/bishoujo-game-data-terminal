oleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:142333","source":"vndb"},{"creditedName":"永原 さくら","creatorId":"vndb:s4523","sourcePersonId":"vndb:s4523","canonicalEntityId":"vndb:s4523","name":"永原 さくら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142334","source":"vndb"},{"creditedName":"佐々木 詩織","creatorId":"vndb:s10369","sourcePersonId":"vndb:s10369","canonicalEntityId":"vndb:s10369","name":"佐々木 詩織","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:142335","source":"vndb"},{"creditedName":"SONO MAKERS","creatorId":"vndb:s15045","sourcePersonId":"vndb:s15045","canonicalEntityId":"vndb:s15045","name":"SONO MAKERS","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142337","source":"vndb"},{"creditedName":"ユウカ","creatorId":"vndb:s15046","sourcePersonId":"vndb:s15046","canonicalEntityId":"vndb:s15046","name":"ユウカ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:142338","source":"vndb"},{"creditedName":"つゑふ","creatorId":"vndb:s23462","sourcePersonId":"vndb:s23462","canonicalEntityId":"vndb:s23462","name":"つゑふ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142343","source":"vndb"}]},"cast":[{"characterId":"char_c62882","characterName":"小鳥遊 亜子","sourceIds":{"bangumi":[{"characterId":"56371","match":"exact-normalized-name-in-linked-work","subjectId":"220369"}],"egsCharacterIds":["17258"],"vndbCharacterId":"c62882"},"originalCharacterName":"小鳥遊 亜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Everything you would want in a wife!"},{"spoiler":false,"text":"A very housewife-esque little sister."},{"spoiler":false,"text":"Ako is the protagonist's adoptive sister. They've been together since they were kids, and now the two of them are like two peas in a pod. She can come off as rather childish, but she only acts that way around her family or close friends. In reality, she is an understanding and down-to-earth person who can hold her own."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c62882"},{"segments":[{"spoiler":false,"text":"兄である主人公とは血の繋がりを持たない義理の妹。主人公である兄とは子供の頃からずっと一緒に育ってきたため、お互い言いたいことを平気で言い合えるほど仲が良い。 表面上は子供っぽいイメージが強いが、それは基本的に家族や仲の良い友達にだけ。"}],"source":"egs","sourceCharacterId":"17258","sourceWorkId":"25613","spoiler":false},{"segments":[{"spoiler":false,"text":"兄である主人公とは血の繋がりを持たない義理の妹。"},{"spoiler":false,"text":"子供の頃からずっと一緒に育ってきたため、"},{"spoiler":false,"text":"互いに言いたいことを平気で言い合えるほど仲が良い。"},{"spoiler":false,"text":"表面上は子供っぽいイメージが強いが、それは家族や仲の良い友達に対してだけ。"},{"spoiler":false,"text":"本来は非常に包容力のあるしっかりとした性格をしている。"},{"spoiler":false,"text":"「私、お兄ちゃんとキスしたい……」"}],"source":"bangumi","sourceCharacterId":"56371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/907c1a725ce4d5d8d86684e3a72ff7d44d77f62631d25e08e5405f35ae8ddcdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/cec779c63c75207ef079c7bd7b9480b866b33c73c35f8d8443bacca990fab74d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹内仁美","creatorId":"vndb:s978","sourcePersonId":"vndb:s978","canonicalEntityId":"vndb:s978","name":"羽鳥いち","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:220369:56371:15924:1","source":"bangumi"}]},{"characterId":"char_c62889","characterName":"鳴瀬 咲","sourceIds":{"bangumi":[{"characterId":"56372","match":"exact-normalized-name-in-linked-work","subjectId":"220369"}],"egsCharacterIds":["17259"],"vndbCharacterId":"c62889"},"originalCharacterName":"鳴瀬 咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"28"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Inexperienced with dating."},{"spoiler":false,"text":"Works as a weather forecaster."},{"spoiler":false,"text":"A beautiful over-achiever who was born and raised in a family where everyone boasts impressive academic achievements."},{"spoiler":false,"text":"Saki carries with her an air of grace and refinement. This sophistication tends to scare people off, but those who get to know her realize she is actually a bit of a pushover and is very easy to talk to. She has no experience dating whatsoever."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c62889"},{"segments":[{"spoiler":false,"text":"容姿端麗、成績優秀、家族や親戚もまとめて高学歴な家庭で生まれ育ったお嬢様。"},{"spoiler":false,"text":"お嬢様と言っても堅苦しい生活は大嫌いで、自分のしたいことを素直に実行してきた大人の女性。外見は真面目そうでも、近寄りがたい感じは一切なく、可愛らしいお姉さん。恋愛の話が絡むと一歩引いてしまう臆病なところがあるため、誰も知らないだけで非常に押しに弱い。"}],"source":"egs","sourceCharacterId":"17259","sourceWorkId":"25613","spoiler":false},{"segments":[{"spoiler":false,"text":"容姿端麗、成績優秀。 家族や親戚もまとめて高学歴な家庭で生まれ育ったお嬢様。"},{"spoiler":false,"text":"コミュニケーション能力が高く、言動はラフでもちょっとした仕草に気品があり、"},{"spoiler":false,"text":"気軽には声を掛けられない雰囲気を持つ。"},{"spoiler":false,"text":"誰も知らないだけで本当は押しに弱く、男性との交際経験もない。"},{"spoiler":false,"text":"「先に帰って待ってるわ。 今晩は何が食べたい？」"}],"source":"bangumi","sourceCharacterId":"56372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f3e68c7164dc1f311ed2ca5b4e792f7bc107d56c9f9f89b19b6ab6a8c2184f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/562c794b274e895632734d2d4fb08e0a1e228355e9e964f7bf0b1e540456c639.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:220369:56372:20696:1","source":"bangumi"}]},{"characterId":"char_c62890","characterName":"北大路 可憐","sourceIds":{"bangumi":[{"characterId":"56374","match":"exact-normalized-name-in-linked-work","subjectId":"220369"}],"egsCharacterIds":["17260"],"vndbCharacterId":"c62890"},"originalCharacterName":"北大路 可憐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Can't be honest with her feelings."},{"spoiler":false,"text":"Went to college with the protagonist."},{"spoiler":false,"text":"Back in college, she used to be in the same club as the protagonist. They frequently ran into each other but never grew particularly close. Karen is very prideful and hates being told what she is supposed to do. However, that's just her way of compensating for her lack of self-confidence. Deep down, she's really a very kind and warm person."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c62890"},{"segments":[{"spoiler":false,"text":"サークルが同じで大学時代は接点も多かったが、特別仲の良い関係にはならなかった。それどころか中途半端にお互いを知っている分、恋愛感情的にはマイナススタート。"},{"spoiler":false,"text":"性格は非常に真面目で融通の利かないところがあり、特に恋愛になると素直になれない特徴を持つ。"}],"source":"egs","sourceCharacterId":"17260","sourceWorkId":"25613","spoiler":false},{"segments":[{"spoiler":false,"text":"大学時代、主人公と同じサークルに所属していた女性。"},{"spoiler":false,"text":"特別仲の良い関係にはならなかったものの、接点は多かった。"},{"spoiler":false,"text":"人から指図されるのが嫌いで、人一倍プライドが高い。"},{"spoiler":false,"text":"しかしそれは自分への自信の無さの裏返しで、本来は非常に温厚な性格をしている。"},{"spoiler":false,"text":"「ちょっと！ エッチの前にお風呂洗うのが先って約束したでしょ!?」"}],"source":"bangumi","sourceCharacterId":"56374"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c527fc2cbed342c797f4252fb4328a1a7726b2246b08ebedcdf12eae23b3658.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e45639f8f886e282a229528bd5eb48083c52911756c6de15c0c9f30a9888a24.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:220369:56374:4727:1","source":"bangumi"}]},{"characterId":"char_c62891","characterName":"鹿目 レイナ","sourceIds":{"bangumi":[{"characterId":"56373","match":"exact-normalized-name-in-linked-work","subjectId":"220369"}],"egsCharacterIds":["17261"],"vndbCharacterId":"c62891"},"originalCharacterName":"鹿目 レイナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shows her love with everything she has."},{"spoiler":false,"text":"Works as a model while still going to school."},{"spoiler":false,"text":"Reina is still a student, but that doesn't stop her from working as a fashion model for many magazines. She possesses both the sweetness of a child and an air of maturity, giving her a unique personality. When it comes to work, Reina is deeply serious and stoic, but in her private life, she's surprisingly easygoing. After a chance meeting with the protagonist, she takes a great liking to him and actively tries to seduce him."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c62891"},{"segments":[{"spoiler":false,"text":"子供の可愛らしさと大人びた雰囲気、その両方を合わせ持つ同世代女子の憧れの的。自分の容姿を自覚し、頭で考え行動する。"},{"spoiler":false,"text":"非常に社交的で友達も多く、言動の節々からは男性に尽くすタイプに見える一面も。"}],"source":"egs","sourceCharacterId":"17261","sourceWorkId":"25613","spoiler":false},{"segments":[{"spoiler":false,"text":"女性誌を中心に活躍する現役学生モデル。"},{"spoiler":false,"text":"子供の可愛らしさと大人びた雰囲気の両方を併せ持つ不思議な魅力がある。"},{"spoiler":false,"text":"仕事に関しては非常にストイックだが、プライベートでは逆にラフな生活をしている。"},{"spoiler":false,"text":"主人公と出会ってからは一方的に気に入り、あらゆる手段で誘惑してくる。"},{"spoiler":false,"text":"「今晩は先輩の部屋で一緒に寝ますね？　もうみんなには言っちゃいました」"}],"source":"bangumi","sourceCharacterId":"56373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a66eb3549622235a5f4fe7ba47d7c5bb14745b0f25766e6862982a6c2b2d647.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efc7b1fc14f5ab405433253ca54aff29c00a762fda37f2d3018f90f21365a337.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田真弓","creatorId":"vndb:s944","sourcePersonId":"vndb:s944","canonicalEntityId":"vndb:s944","name":"吉田 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:220369:56373:5926:1","source":"bangumi"}]},{"characterId":"char_c62892","characterName":"月野 ましろ","sourceIds":{"bangumi":[{"characterId":"56375","match":"exact-normalized-name-in-linked-work","subjectId":"220369"}],"egsCharacterIds":["17262"],"vndbCharacterId":"c62892"},"originalCharacterName":"月野 ましろ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Strange girl with unique values,"},{"spoiler":false,"text":"who is living next door."},{"spoiler":false,"text":"Mashiro is the same age as the protagonist and is working as a waitress in the boat restaurant Leviathan. Although reticent by nature, she knows how to talk to people. She is an indoor person, with her hobbies consisting of things like gaming and watching TV. Mashiro is satisfied with her current life, but her first love becomes an impetus for change."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c62892"},{"segments":[{"spoiler":false,"text":"主人公とは同い年で、独自の価値観を持つちょっと不思議な女の子。"},{"spoiler":false,"text":"コミュニケーション能力はきちんとあるが、頭の中で話がまとまってからようやく話し始めるため、会話のテンポが周りと比べると少しのんびりしている。恋愛経験はゼロで、異性を前にそう言った話題になると照れて一歩引いてしまうところが特徴。"}],"source":"egs","sourceCharacterId":"17262","sourceWorkId":"25613","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公とは同い年で、船上レストラン『リヴァイアサン』で働くウエイトレス。"},{"spoiler":false,"text":"口数は少ないが、コミュニケーション能力はしっかりとある女の子。"},{"spoiler":false,"text":"趣味はゲームにテレビとインドア派。"},{"spoiler":false,"text":"今の生活に満足はしているが、初めての恋愛を機に変わってゆく。"},{"spoiler":false,"text":"「ビビっときた。 恋は理屈じゃない。感じるモノ」"}],"source":"bangumi","sourceCharacterId":"56375"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49f88eb9b7bfd1310eefcea59a7704d4b7aa0bf5ae54f23a50498488d96266fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee3a3f562b655bbe496898758db351d59b6963ba37b1ba35b2c932ec7c10971b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山田奈都美","creatorId":"vndb:s11904","sourcePersonId":"vndb:s11904","canonicalEntityId":"vndb:s11904","name":"山田 奈都美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:220369:56375:19457:1","source":"bangumi"}]},{"characterId":"char_vndb_c149141","characterName":"ベッキー","sourceIds":{"vndbCharacterId":"c149141"},"originalCharacterName":"ベッキー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of the flower shop named \"Annie\" in the mall. He comes across as flamboyant and effeminate, which stands in contrast to his tough appearance. He is counted as one of the \"Four Heavenly Kings\", a unique group of regulars at the restaurant \"Leviathan\". His real name is Takeo Saitou but he does like being referred to as such due it sounding \"too cool.\""}],"source":"vndb","sourceCharacterId":"c149141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9310809979bbfd9d333fefe445da649ae4476951b88aba033f5e4669d5f9a94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5068b13c2d16e8c31ecdc955800d5d053bfd5ebe65489ba00a92c8273858bee.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c65184","characterName":"小鳥遊 和馬","sourceIds":{"vndbCharacterId":"c65184"},"originalCharacterName":"小鳥遊 和馬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of Making Lovers; extremely bad with romance, he has no interest in finding a girlfriend, claiming that he's waiting for a \"destined meeting\"."},{"spoiler":false,"text":"His biological parents tragically passed away in an accident when he was young, and was adopted by Ako's parents."},{"spoiler":false,"text":"After being scolded by everyone in his social-circle (including his parents) but being supported by his sister (Ako) , he reluctantly took a step forward, and accepts his friend's invitation to mixer-event."}],"source":"vndb","sourceCharacterId":"c65184"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5c72a52e3cd9eef9c400a553a81038087eae