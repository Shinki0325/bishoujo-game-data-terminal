alse,"text":"小さい頃に、川で溺れたことがきっかけとなって、天井の世界から来た姫の霊が見えるようになった。"},{"spoiler":false,"text":"それが彼女にとって大きなショックとなり、徐々に活発さが失われ、気弱で臆病な性格になってしまった。"},{"spoiler":false,"text":"あんみつが大好物で、毎朝、欠かさない。"}],"source":"egs","sourceCharacterId":"27377","sourceWorkId":"2823","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公許婚に当たる女の子で、彼よりも年下なことから、主人公の事を『お兄ちゃん』と呼ぶ。"},{"spoiler":false,"text":"子供の頃は活発な子だったが、川に溺れた事故により天上の世界から来た姫の霊が見えるようになり、あまりの恐怖に誰にもそのことを言えなかったことから、徐々に気が弱くなり他の人に強くモノを言えない性格になってしまった。胸が小さいことが最近の悩み。大好きな食べ物はあんみつで、朝のおめざには必ず食べている。主人公の優しい性格に惹かれている。"}],"source":"bangumi","sourceCharacterId":"149089"}],"profileFacts":[{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"27377","sourceWorkId":"2823","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"27377","sourceWorkId":"2823","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2061cd4fe057b5e5b6ac7f494dde2756a011effa39990dff05cc862872f2b5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcf9e4b031082d6c0ced42b1f325c3a742608d83ed36505dc7f34cd663fd9d58.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c70596","characterName":"芦屋 千夏","sourceIds":{"bangumi":[{"characterId":"149090","match":"exact-normalized-name-in-linked-work","subjectId":"230351"}],"egsCharacterIds":["27378"],"vndbCharacterId":"c70596"},"originalCharacterName":"芦屋 千夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"9月15日"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"村の御三家の一つ、芦屋家の長女。"},{"spoiler":false,"text":"真夕と同じく、主人公の正妻、または妾としての将来を生まれながらに背負っている少女。"},{"spoiler":false,"text":"主人公よりも年下なのは真夕と変わらず、「兄さま」と呼んで慕っている。"},{"spoiler":false,"text":"竹を割ったようなカラッとした明朗快活な性格で、対照的な真夕とは意外にウマが合うらしい。"}],"source":"egs","sourceCharacterId":"27378","sourceWorkId":"2823","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のもう一人の許婚で、村の良家の長女。"},{"spoiler":false,"text":"彼女もまた、満月と同じく主人公より年下で、しかも同じ日に誕生している。主人公の事は、『兄さま』と呼ぶ。満月とは反対の竹を割ったような性格で、彼女とは互いにない部分を持っている為か、気が合う存在。素振り500回が毎日の日課。"}],"source":"bangumi","sourceCharacterId":"149090"}],"profileFacts":[{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"27378","sourceWorkId":"2823","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"27378","sourceWorkId":"2823","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0401c0ce3729e5664d4b0ac43bf8c6ee7df8cc4e3cb2c6a3f5aaa4fc3e629ecb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7e90df9d4cdb4f444b4b6f6645f3a603b35d083e7a9640f7cbc2bdc90cbd66b.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c70597","characterName":"犬守 深冬","sourceIds":{"bangumi":[{"characterId":"149092","match":"exact-normalized-name-in-linked-work","subjectId":"230351"}],"egsCharacterIds":["27379"],"vndbCharacterId":"c70597"},"originalCharacterName":"犬守 深冬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"3月5日"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"村にある氷月神社の一人娘。"},{"spoiler":false,"text":"非常に霊力が強く、天上界から来た姫とも何度か会ったことがあるという、不思議な雰囲気の少女。"},{"spoiler":false,"text":"巫女として神職に就いているが、隠し巫女のためか、その存在を知る人は少ない。"},{"spoiler":false,"text":"少女っぽい容姿とは対照的に、その口調は大人びていて、非常に落ち着いている。"},{"spoiler":false,"text":"折り紙遊びが好きらしい。"}],"source":"egs","sourceCharacterId":"27379","sourceWorkId":"2823","spoiler":false},{"segments":[{"spoiler":false,"text":"村にある氷月神社の一人娘で、巫女をしている。"},{"spoiler":false,"text":"隠し巫女の為か、主人公や満月、姫もその存在を今まで知らず、ゲームが開始されてから知る存在となる。非常に強い霊力の持ち主で、天上の世界から来た姫の霊とも度々会っているという。幼い頃からそうだったため、容姿の割りに大人びた言葉遣いをする。年齢は不祥だが、満月や姫とさほど変わらないように見える。折り紙遊びが好きらしい。主人公のことを『剣持さん』と呼ぶ。"}],"source":"bangumi","sourceCharacterId":"149092"}],"profileFacts":[{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"27379","sourceWorkId":"2823","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"27379","sourceWorkId":"2823","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d318642bc0967118a52eb8bd0add668636b9a1b3b91a4f0beb55a0a01291d7df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d1cf32b8335b3dffca67b5b21777cf0996225959731ccfe5589df87fca17ea7.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105266","characterName":"剣持 彬","sourceIds":{"vndbCharacterId":"c105266"},"originalCharacterName":"剣持 彬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":