"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"極めて冷静、極めて独善的な少女。"},{"spoiler":false,"text":"思ったことをそのまま口にし、さらには手まで出してしまう。"},{"spoiler":false,"text":"一見、何でもできる天才肌だが、実は並々ならぬ努力家。"},{"spoiler":false,"text":"今の実力も、百倍の努力と研鑚を積んだ賜物なのである。"},{"spoiler":false,"text":"ちなみに、ちょっぴり広めのおデコがコンプレックスとか。"},{"spoiler":false,"text":"「そう、わからないの――ゴガッ!!（笑顔でパンチ）」"}],"source":"egs","sourceCharacterId":"19850","sourceWorkId":"9474","spoiler":false},{"segments":[{"spoiler":false,"text":"三門学園2年生。学園に王国を設立しようとする少女。"},{"spoiler":false,"text":"極めて冷静、そして極めて独善的な性格の持ち主。思ったことをそのまま口にし、さらには手まで出てしまう極めて直球な性質を持っている。"},{"spoiler":false,"text":"拳で殴ることは日常茶飯事であり、「わかりませんか？　これでもですか？」と笑みを浮かべながらガシガシと兵馬に頭突きすることは少なくない。"},{"spoiler":false,"text":"表面的には、できないことは何もない天才肌のように見えるが、実は極めて努力家。今の実力は、人の百倍の努力と研鑚を積んだ上で得たものに他ならない。"},{"spoiler":false,"text":"ちなみにそれなりに発達した前頭葉――というかおデコの広いことが軽いコンプレックス。"},{"spoiler":false,"text":"「そう、わからないの――」ゴガッ!!（笑顔でパンチ）"}],"source":"bangumi","sourceCharacterId":"65203"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19850","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"19850","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"19850","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"19850","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"19850","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"53 kg","valueContext":null,"s