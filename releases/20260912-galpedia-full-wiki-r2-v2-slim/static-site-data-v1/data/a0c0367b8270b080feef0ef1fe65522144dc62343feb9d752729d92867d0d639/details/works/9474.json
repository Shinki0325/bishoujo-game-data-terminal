Id":"19851","sourceWorkId":"9474","spoiler":false},{"segments":[{"spoiler":false,"text":"三門学園3年生。兵馬の実家から寄越された彼の護衛役。"},{"spoiler":false,"text":"いたるところに大小様々な銃火器を仕込み、強行突破から狙撃まで確実かつ完璧にこなす銃火器戦闘の天才である。"},{"spoiler":false,"text":"兵馬よりも1つ年上であり、彼にとっては幼馴染であり、初恋の人であり、そして身内同然の存在となっている。"},{"spoiler":false,"text":"常に冷淡かつ冷徹であり、その顔に表情らしいものが出ることはない。だが、唯一その顔に感情が表れるのは、兵馬に接するときである。"},{"spoiler":false,"text":"「おまえが主様の嫁御とな？　……うちは絶対に認めませんえ！」"}],"source":"bangumi","sourceCharacterId":"65204"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"19851","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"19851","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"19851","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"19851","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"19851","sourceWorkId":"9474","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"19851","sourceWorkId":"9474","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ae41ee6c85952420bcd0b489082be5bd563a964ba8725ce759da6b78fc035c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce11a63520f10e68c56d2f6e1979b8fa41030f3adf3a13aa428b79005f309f1a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","ident