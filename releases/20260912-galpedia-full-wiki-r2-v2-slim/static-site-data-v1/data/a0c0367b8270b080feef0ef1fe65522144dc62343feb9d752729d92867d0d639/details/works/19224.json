d":"c29205"},{"segments":[{"spoiler":false,"text":"主人公が女装した姿。"},{"spoiler":false,"text":"“はるか”はアイドルネーム（芸名）。"},{"spoiler":false,"text":"あかるとのコンビで、スクールアイドル“Qてぃくル”として活動する。"},{"spoiler":false,"text":"Qてぃくルの語源である「キュート＆クール」のうち「クール」を担当。"},{"spoiler":false,"text":"元々は目標もなく怠惰な学生生活を送っており、アイドルには全く興味がなかった。"},{"spoiler":false,"text":"が、愛矢の強引な勧誘によってアイドル部に入部、女装アイドルとして活動させられる羽目になる。"},{"spoiler":false,"text":"活動当初は女装になじめず、愛矢の厳しい指導についていくのが精一杯。"},{"spoiler":false,"text":"しかしパートナーのあかると絆を育んだり、愛矢のレッスンやセクハラを耐え忍ぶことで、次第に成長し、正体不明のスクールアイドル“はるか”として人気を得ていく。"},{"spoiler":false,"text":"「“Qてぃくル”のクールな方、はるかだよっ☆"},{"spoiler":false,"text":"みんなのメラメラハートをヒエヒエダンスで冷やしちゃうぞ♪"},{"spoiler":false,"text":"悟してね☆（も、もう帰りたい……）」"}],"source":"egs","sourceCharacterId":"3990","sourceWorkId":"19224","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が女装した姿。"},{"spoiler":false,"text":"“はるか” はアイドルネーム（芸名）。"},{"spoiler":false,"text":"あかる とのコンビで、スクールアイドル・Qてぃくル として活動する。"},{"spoiler":false,"text":"Qてぃくルの語源である “キュート＆クール” のうち “クール” を担当。"},{"spoiler":false,"text":"「ぁ、あかるちゃんっ!?　わ、私たち、男同士……いや、男の娘同士だしっ!?」"}],"source":"bangumi","sourceCharacterId":"62720"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"3990","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"aaa","valueContext":null,"source":"egs","sourceCharacterId":"3990","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"3990","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"3990","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"3990","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"52 kg","valueContext":null,"source":"egs","sourceCharacterId":"3990","sourceWorkId":"19224","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c29205","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"3990","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"3990","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"62720","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6471cd92c15822b3c2fef8b1945a670057ecc0e9ff86102fa72f5cebdaa27aaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d979ded0f88ef5ae12e1a3144a6e7c6103cdd7de300954049f228bccaf557b9.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c29206","characterName":"吉川 あかる","sourceIds":{"bangumi":[{"characterId":"62721","match":"exact-normalized-name-in-linked-work","subjectId":"80298"}],"egsCharacterIds":["3991"],"vndbCharacterId":"c29206"},"originalCharacterName":"吉川 あかる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"407"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AAA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Enrolling in the academy as a female, Akaru is every bit a woman in both her outward appearance and personality. A woman of few words, she can sound a bit disinterested when she speaks. She doesn’t leave much of an impression on people."},{"spoiler":false,"text":"Fearful that her guise will be revealed, she tends to stay at an arm’s length from others."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c29206"},{"segments":[{"spoiler":false,"text":"県立百万石学園の1年生。"},{"spoiler":false,"text":"主人公が女装した“はるか”の相棒となり、スクールアイドル“Qてぃくル”として活動することになる。"},{"spoiler":false,"text":"Qてぃくルの語源である「キュート＆クール」のうち「キュート」を担当。"},{"spoiler":false,"text":"女子生徒になりすまして学園に通う真性の「男の娘」で、外見はまったくもって女子にしか見えず、精神的にも女性そのもの。"},{"spoiler":false,"text":"物静かで口数は少なめ、淡々とした話し方をする。存在感が非常に薄い。"},{"spoiler":false,"text":"女装の発覚を恐れ、なるべく他人とは関わらないようにしていたが、わけあってアイドル部に入部。"},{"spoiler":false,"text":"主人公や愛矢と接し絆を深めるうち、次第にアイドル部活動にのめり込み、感情を表に出すようになっていく。"},{"spoiler":false,"text":"「怖い、けど……はるかちゃん（女装した主人公）とだったら、ボク……」"}],"source":"egs","sourceCharacterId":"3991","sourceWorkId":"19224","spoiler":false},{"segments":[{"spoiler":false,"text":"アイドル部の一員。"},{"spoiler":false,"text":"女装して学園に通っている真性の “男の娘” で、外見は女子にしか見えず、精神的にも女性そのもの。"},{"spoiler":false,"text":"“はるか” と共に、スクールアイドル・Qてぃくル として活動することになる。"},{"spoiler":false,"text":"Qてぃくルの語源である “キュート＆クール” のうち “キュート” を担当。"},{"spoiler":false,"text":"「怖い、けど……はるかちゃんとだったら、ボク……」"}],"source":"bangumi","sourceCharacterId":"62721"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"3991","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"aaa","valueContext":null,"source":"egs","sourceCharacterId":"3991","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"3991","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"3991","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"3991","sourceWorkId":"19224","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"3991","sourceWorkId":"19224","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c29206","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"3991","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"3991","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"62721","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f39717063ce86f60bbdc31596717739b1407f2de825f51b11058974b72245973.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b1ce0fecbb584c0b8079eeb432da19535333463c80d152380de9ee4141cb48f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80298:62721:10027:1","source":"bangumi"}]},{"characterId":"char_c29207","characterName":"栗山 愛矢","sourceIds":{"bangumi":[{"characterId":"62722","match":"exact-normalized-name-in-linked-work","subjectId":"80298"}],"egsCharacterIds":["3992"],"vndbCharacterId":"c29207"},"originalCharacterName":"栗山 愛矢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"804"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Always smiling, she conveys a calm, cool personality. However, deep down she possesses a sharp tongue and has a penchant for vulgar things. She loves cute girls and sexually harassing them, our hero in particular falling prey to her schemes time and time again."},{"spoiler":false,"text":"From writing songs to creating costumes and editing music videos, she is a multi-talented producer for the duo."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c29207"},{"segments":[{"spoiler":false,"text":"県立百万石学園の2年生。"},{"spoiler":false,"text":"アイドル部の部長。"},{"spoiler":false,"text":"主人公たちをスカウトし、スクールアイドル“Qてぃくル”として活動させるプロデューサー。"},{"spoiler":false,"text":"通称「まーやP」。いつもニコニコと微笑んでおり、おっとりとした物柔らかな雰囲気の持ち主。"},{"spoiler":false,"text":"しかしその言動は強引かつハチャメチャで、毒舌やエゲツない行動を繰り広げ、周囲を翻弄する。"},{"spoiler":false,"text":"可愛いコが大好きで、しばしばセクハラを仕掛け、主人公はたびたび被害に遭っている。"},{"spoiler":false,"text":"作詞作曲から衣装作成、PV撮影などの作業もこなしてのけるなど、多芸多才。"},{"spoiler":false,"text":"自分がステージに立ちたいという気はなく、裏方で可愛いコをプロデュースすることに情熱を注いでいる。"},{"spoiler":false,"text":"まず自ら表舞台に立つことはしない、ボス的存在。"},{"spoiler":false,"text":"「うふふふ♪　まかせておいてね～♪"},{"spoiler":false,"text":"悪いようには～、しないから～♪　たぶんだけど」"}],"source":"egs","sourceCharacterId":"3992","sourceWorkId":"19224","spoiler":false},{"segments":[{"spoiler":false,"text":"アイドル部の部長。"},{"spoiler":false,"text":"主人公たちをスカウトし、スクールアイドル・Qてぃくル を結成させたプロデューサー。"},{"spoiler":false,"text":"作詞作曲から衣装作成、PV撮影などの作業もこなしてのけるなど、多芸多才。"},{"spoiler":false,"text":"可愛いコにセクハラするのが大好きで、主人公はたびたび被害に遭っている。"},{"spoiler":false,"text":"「うふふふ♪　まかせておいてね～♪　悪いようには～、しないから～♪　たぶんだけど」"}],"source":"bangumi","sourceCharacterId":"62722"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source"