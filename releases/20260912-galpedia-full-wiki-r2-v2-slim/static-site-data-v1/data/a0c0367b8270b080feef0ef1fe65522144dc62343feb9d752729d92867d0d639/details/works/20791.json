rcePersonId":"vndb:s9599","canonicalEntityId":"vndb:s9599","name":"渡部 紫緒","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:107608","source":"vndb"},{"creditedName":"吉田 詩織","creatorId":"vndb:s9603","sourcePersonId":"vndb:s9603","canonicalEntityId":"vndb:s9603","name":"吉田 詩織","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:107612","source":"vndb"},{"creditedName":"三浦 誠司","creatorId":"vndb:s9605","sourcePersonId":"vndb:s9605","canonicalEntityId":"vndb:s9605","name":"三浦 誠司","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:107614","source":"vndb"},{"creditedName":"橘 公司","creatorId":"vndb:s11255","sourcePersonId":"vndb:s11255","canonicalEntityId":"vndb:s11255","name":"橘 公司","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:107615","source":"vndb"},{"creditedName":"横山 一希","creatorId":"vndb:s53852","sourcePersonId":"vndb:s53852","canonicalEntityId":"vndb:s53852","name":"横山 一希","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:107619","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c14291","characterName":"時崎 狂三","sourceIds":{"vndbCharacterId":"c14291"},"originalCharacterName":"時崎 狂三","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Nightmare\""},{"spoiler":false,"text":"Angel: Zafkiel"},{"spoiler":false,"text":"Astral Dress: Elohim"},{"spoiler":false,"text":"Kurumi is the third spirit who appeared after Tohka and Yoshino, and the most brutal so far. She has a split personality: that of a gentle, mysterous highschool girl with a slow talking pattern, and that of a psychopathic killer. She is very aggressive in her actions which makes it harder for Shidou to capture her."},{"spoiler":true,"text":"Kurumi has the archangel Zafkiel, and has the power to control over time. The reason why she keeps appearing after being killed by Mana countless times was because of her powers. For example, she can heal herself by turning back the time. She uses a gunblade as her weapon. The twelve Roman numerals on the clock in her left eye have different powers that only the original Kurumi can use, but by using their powers, it will cause her life to be eaten away. In order to avoid this, she kills people to obtain 'time'."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f651f2d5c6490c2483be44e81034a798b97a5e1252ca56c1bd9446522a43f808.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d77c80cb528368eb97840481445bedaa4bde4f5ab7bae8be35e03b3a13bf69d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真田 アサミ","creatorId":"vndb:s1712","sourcePersonId":"vndb:s1712","canonicalEntityId":"vndb:s1712","name":"真田 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57628","source":"vndb"}]},{"characterId":"char_vndb_c14341","characterName":"五河 士道","sourceIds":{"vndbCharacterId":"c14341"},"originalCharacterName":"五河 士道","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itsuka Shidou is a student of Raizen High School. He was adopted into the Itsuka family when he was \"abandoned\" by his mother."},{"spoiler":false,"text":"Shidou has the ability to seal a spirit's power. However, the reason why he possesses it is shrouded in mystery. Due to this power which was already known by Itsuka Kotori he was recruited -- or rather forced -- to join \"Ratatoskr\" to help and save Spirits. Instead of killing Spirits to prevent spacequake from happening, he has to seal the Spirit's powers with a kiss in order for them to co-exist with humans. Once the power of a Spirit is sealed within Shidou, he has the ability to use some portion of it, thus his resurrection power is from Kotori's abilities when he sealed Kotori's Spirit 5 years ago."},{"spoiler":false,"text":"From MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14341"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21a7de4b4740aeb8d17439f519e8196ecef4c02983a878ca94b0cadd72567986.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ec98147f356b1cc164ac14f114242f9e2f5558162ea0b5df978fe512a91b694.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"島﨑 信長","creatorId":"vndb:s1248","sourcePersonId":"vndb:s1248","canonicalEntityId":"vndb:s1248","name":"島﨑 信長","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57625","source":"vndb"}]},{"characterId":"char_vndb_c14357","characterName":"夜刀神 十香","sourceIds":{"vndbCharacterId":"c14357"},"originalCharacterName":"夜刀神 十香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Princess\""},{"spoiler":false,"text":"Angel: Sandalphon"},{"spoiler":false,"text":"Astral Dress: Adonai Melek"},{"spoiler":false,"text":"Yatogami Tooka's name is given by Shidou when they first met. Due to being a spirit, she is always being targeted by the AST and is aiming for the kill, because of that she hated humans for always shunning her and thinking that she wasn't allowed to live in this world, but her whole life changed when she met Shidou."},{"spoiler":false,"text":"Even with that high and cool presence, Tooka lacks some common sense and loves food very much."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/191f25b31d942bf6b4705ca231b87f0cf42b7bcf33e98997c487b9d4e6de5e70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97fe3b02c1b3dd16943e18ef0b175a46db4fb9d69373f85cd46c6785aef7f31b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 麻里奈","creatorId":"vndb:s1774","sourcePersonId":"vndb:s1774","canonicalEntityId":"vndb:s1774","name":"井上 麻里奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57630","source":"vndb"}]},{"characterId":"char_vndb_c14371","characterName":"鳶一 折紙","sourceIds":{"vndbCharacterId":"c14371"},"originalCharacterName":"鳶一 折紙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1111"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tobiichi Origami is a student of Raizen High School. She is known for having the highest grades in school, including P.E. She is also a member of AST (Anti-Spirit Team) as one of the most skilled members."},{"spoiler":false,"text":"Origami has a great hatred towards Spirits. This is because five years ago when the first great spacequake happened,"},{"spoiler":true,"text":"her parents died in a fire caused by an unknown Spirit. She joined the AST for a chance for revenge."},{"spoiler":false,"text":"Origami is in love with Shidou, so much so that she frequently stalks him."},{"spoiler":true,"text":"Origami originally met Shidou five years ago when the first great spacequake happened. However, Shidou does not remember this."},{"spoiler":false,"text":"From MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99a74cff9a0c02fd5cb20f091a28245aef6bc189ae3edee6926b51ebf2678e46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/389ba6bead6190f0df3c20122e6a57a2e8fbad9c22ca112c32fed970b8ec8bab.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富樫 美鈴","creatorId":"vndb:s3947","sourcePersonId":"vndb:s3947","canonicalEntityId":"vndb:s3947","name":"富樫 美鈴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57632","source":"vndb"}]},{"characterId":"char_vndb_c14372","characterName":"五河 琴里","sourceIds":{"vndbCharacterId":"c14372"},"originalCharacterName":"五河 琴里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"803"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Efreet\""},{"spoiler":false,"text":"Angel: Camael"},{"spoiler":false,"text":"Astral Dress: Elohim Gibor"},{"spoiler":false,"text":"Kotori is Shido's foster sister and the head commander of Ratatoskr."},{"spoiler":false,"text":"Kotori's character changes according to the color of the ribbons she's wearing. While wearing white ribbons she is that of her \"weak self\", a delicate little sister who is very dependent upon her big brother; and when wearing black ribbons, she becomes her \"strong self\", a charismatic and sometimes cynical leader able to successfully command the airship, Fraxinus. In her Spirit form, Kotori acts the same as her ribbons' current color indicates. But if she stays in her spirit form for too long, her third, \"Spirit personality,\" takes over and she becomes an aggressive and merciless killing machine, who only cares about battling enemies to death."},{"spoiler":false,"text":"In all three cases, Kotori seems to have a sadistic side. Her deep feelings for Shidou are always present, regardless of her current personality and help her remember who she truly is. No matter what the situation is, she will always be Shido's little sister."},{"spoiler":false,"text":"Kotori is a Fire Spirit and she became one 5 years prior to the main events after being turned into one by Phantom. Her powers are centered on the manipulation of flames that erupt from her body and can be used in close or ranged combat. Her angel Camael comes in the form of a large red halberd but can be dismantled into Megiddo, a cannon powered by Kotori's own flames. Megiddo fires powerful energy beams that can overwhelm even the defenses of other Spirits. Kotori also has a powerful regeneration ability, which Shidou uses/borrows on many occasions when he is trying to make spirits fall for him."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c14372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b05e8c45da01607e8b4a30c942b705588ddbac9404d617cc25eeb19a81598ee6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da0b0327f45fec76beccda9b1a99b346356160097d093e37d805df1f5d3996cf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹達 彩奈","creatorId":"vndb:s1767","sourcePersonId":"vndb:s1767","canonicalEntityId":"vndb:s1767","name":"竹達 彩奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57629","source":"vndb"}]},{"characterId":"char_vndb_c14373","characterName":"氷芽川 四糸乃","sourceIds":{"vndbCharacterId":"c14373"},"originalCharacterName":"氷芽川 四糸乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Hermit\""},{"spoiler":false,"text":"Angel: Zadkiel"},{"spoiler":false,"text":"Astral Dress: El"},{"spoiler":false,"text":"Second Spirit to appear, and the kindest spirit up to date. She's very shy and relies on her Hand Puppet Yoshinon to communicate with others. She causes rain to fall whenever she appears, which is part of her ability to control the three states of water. Mainly uses ice attacks though."},{"spoiler":false,"text":"Taken from TVTropes"}],"source":"vndb","sourceCharacterId":"c14373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/508b845562949e81b7866c8c27d727c80a3dafedc4a290cd249400f2019f57d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d523965a1c2da49c6dc215d1745b9f8a31cb632c2807d97f4f4da4ea44e9f2e5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野水 伊織","creatorId":"vndb:s1775","sourcePersonId":"vndb:s1775","canonicalEntityId":"vndb:s1775","name":"野水 伊織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57631","source":"vndb"}]},{"characterId":"char_vndb_c14376","characterName":"村雨 令音","sourceIds":{"vndbCharacterId":"c14376"},"originalCharacterName":"村雨 令音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Reine is highly intelligent and the Analysis Officer of Ratatosk's Fraxinus Crew."},{"spoiler":false,"text":"She can be ranked the Vice-Commander of the crew rather than Kannazuki Kyouhei, as it is usually her at Kotori's side, managing things around the crew. She transferred to Raizen Highschool as a Physics teacher and an assistant homeroom teacher at Shidou's class. She has big eyebags which are a result of her not having had enough sleep. In fact, Reine stated at one point that \"for the last 30 years, she hasn't been able to sleep properly.\""},{"spoiler":false,"text":"At some points, she can be reliable and take Command of the directions which Shidou needs to do when dating a spirit. She acts like the \"mother\" of Shidou and the other Spirits to help them with their troubles and such."},{"spoiler":false,"text":"Reine has a habit of calling Shido \"Shin\", because she can never pronounce his name right."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14376"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f18538974bb0796fa3911b70a7b8ced0760a109186b072a140a48abf80719a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06e0389df0ede32cc78b6a872e8b22c182fee177af5422cf326369a65ab130aa.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠藤 綾","creatorId":"vndb:s5699","sourcePersonId":"vndb:s5699","canonicalEntityId":"vndb:s5699","name":"遠藤 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57636","source":"vndb"}]},{"characterId":"char_vndb_c25888","characterName":"八舞 耶倶矢","sourceIds":{"vndbCharacterId":"c25888"},"originalCharacterName":"八舞 耶倶矢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code Name: Berserk"},{"spoiler":false,"text":"Astral Dress: Elohim Tzabaoth"},{"spoiler":false,"text":"Angel: Raphael"},{"spoiler":false,"text":"Yamai was originally one Spirit, but for some unknown reasons that may be related with her teleporting between dimensions sometime in the past; she was split into two bodies and minds. The original personality of Yamai is now gone, as well as what type of personality she used to have is unknown to the split Yamais. The Yamai Sisters have been well known to the people who knew about the existence of spirits because they often cause a major storm in an area, that occur every time they come to Earth."},{"spoiler":false,"text":"Outgoing and out-spoken, one can say that she is childish or immature. Kaguya often speaks rather unrealistically, as if she is acting. It is later revealed that it really is acting. Kaguya believes she must speak like this because she is a spirit, and therefore \"super awesome\", and therefore must act appropriately. Her main weapon is El Re'em, a lance."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c25888"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cf12ce21df2e5783c74d0ec6e62b239853272202ec380453a6287e1ac5f8105.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bf78ad9e903ffc4ca16b803ec5d4b3857e26320d81bbaa316bb49c5af518d80.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内田 真礼","creatorId":"vndb:s1326","sourcePersonId":"vndb:s1326","canonicalEntityId":"vndb:s1326","name":"内田 真礼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57626","source":"vndb"}]},{"characterId":"char_vndb_c25889","characterName":"誘宵 美九","sourceIds":{"vndbCharacterId":"c25889"},"originalCharacterName":"誘宵 美九","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Codename: Diva"},{"spoiler":false,"text":"Astral Dress: Shaddai El Chai"},{"spoiler":false,"text":"Angel: Gabriel"},{"spoiler":false,"text":"Miku is a Spirit and an idol. She hates men to the point that Shidou even had to crossdress in order to interact with her. Her Angel, Gabriel has the ability to manipulate and brainwash people."},{"spoiler":false,"text":"Miku is very flirty, both before and after warming up to Shidou, she expresses this towards most women who fit her type (and Shidou) and is very blunt about it. After warming up to Shidou, she doesn't hesitate to flirt with both him and the other Spirits and does not even mind Shido having a harem, in fact, she pretty much encourages it. Shidou describes her current personality as \"very childish\", and she is very affectionate."},{"spoiler":false,"text":"Just like Kotori, Miku was a normal human before she became a Spirit. Ever since she was little, Miku loved singing. She wasn't good at studying or sports, but she could sing better than anyone else around her. As an aspiring singer, she had always dreamed of performing on the big stage. That dream came true when she debuted as an idol singer at the age of 15 under the stage name Tsukino Yoimachi. It was the best thing that Miku could have wished for, doing the very thing she loved and being adored by her fans."},{"spoiler":false,"text":"Her career, however, came to an abrupt end just after about a year when she refused to have sex with a hotshot TV producer. Before Miku knew it, false scandals about her began to appear and she soon fell out of favor with her agency along with her fans beginning to hate her. Miku thought that she could reconnect everything back with her singing, but then suddenly lost her voice."},{"spoiler":false,"text":"As Miku contemplated suicide, Phantom appeared before her and turned her into a Spirit. Afterwards, she used her spirit powers, regained her lost voice, and debuted again using the name Miku Izayoi. She became famous due to her voice that is was known as 'sound anesthetic' and released several super popular tracks. However, she never appeared in magazines, television, or any public media. Miku held only private concerts and the only ones who were invited were her loyal female fans due to her hatred for men."}],"source":"vndb","sourceCharacterId":"c25889"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/5660c81835c4f89b1792866bf5c5e47496931098fed5d6df5a15e5c5e38c6c71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33d686c815827fde82a639f12c0deec145bd2148f8b0ef7a43d23595ba5a11c2.webp","width":252,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅原 実里","creatorId":"vndb:s1459","sourcePersonId":"vndb:s1459","canonicalEntityId":"vndb:s1459","name":"茅原 実里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57627","source":"vndb"}]},{"characterId":"char_vndb_c27422","characterName":"八舞 夕弦","sourceIds":{"vndbCharacterId":"c27422"},"originalCharacterName":"八舞 夕弦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code Name: Berserk"},{"spoiler":false,"text":"Astral Dress: Elohim Tzabaoth"},{"spoiler":false,"text":"Angel: Raphael"},{"spoiler":false,"text":"Yamai was originally one Spirit, but for some unknown reasons that may be related with her teleporting between dimensions sometime in the past; she was split into two bodies and minds. The original personality of Yamai is now gone, as well as what type of personality she used to have is unknown to the split Yamais. The Yamai Sisters have been well known to the people who knew about the existence of spirits because they often cause a major storm in an area, that occur every time they come to Earth."},{"spoiler":false,"text":"Yuzuru often speaks in a robot-like speech pattern; when arguing with Kaguya, she always sneers at her and points out the flaw in Kaguya’s argument. She tells the point of comment before speaking the rest. For example, \"Confirm; Shido\". She also speaks in a third-person perspective sometimes."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c27422"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/694fa0d12a7636401e354caeb5e4497290c3e4413a8b1653d9b5296281e83fdb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f07634ebfa73305bc556bade24e39019ac37b1059842f771ed407ff6be26c4f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ブリドカット・セーラ・恵美","creatorId":"vndb:s3948","sourcePersonId":"vndb:s3948","canonicalEntityId":"vndb:s3948","name":"ブリドカット・セーラ・恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57633","source":"vndb"}]},{"characterId":"char_vndb_c27423","characterName":"或守 鞠亜","sourceIds":{"vndbCharacterId":"c27423"},"originalCharacterName":"或守 鞠亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"When Maria first presented herself to Shido, she appeared to be nothing more than a curious girl who simply wanted to know the definition of \"love\" at first."},{"spoiler":false,"text":"Maria observed Shido's interaction with the Spirits throughout the game, and not only did she understood the meaning of \"love\" through her observation, but her true personality slowly resurfaced. Her personality seemed to be a combination of Tohka and Origami altogether. She can easily become interested in common things found in our daily lives, with Shido introducing hot buns to her as an example of this. Unlike Tohka, however, she is as knowledgeable as Origami due to having access to the Fraxinus database."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c27423"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/990a57f7f9ef43463409031b5bd65f74764b7d1082e703819df508e199b03386.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3b254d21a363198d2dc322d72cda2309cecbd2f9ce9fc4b314f85c4c2937f86.webp","width":217,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三森 すずこ","creatorId":"vndb:s627","sourcePersonId":"vndb:s627","canonicalEntityId":"vndb:s627","name":"三森 すずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57623","source":"vndb"}]},{"characterId":"char_vndb_c27424","characterName":"或守 鞠奈","sourceIds":{"vndbCharacterId":"c27424"},"originalCharacterName":"或守 鞠奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has shown to be a little bit harsh and mean, as she always removes NPCs that are in her way without much thought. But as time went, she began to show signs that \"she’s beginning to change\" by helping an elderly NPC in the street. As a reward, Shido gives her a meat bun in a park at night, and at some other time, pats her head as a reward."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c27424"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc545fda378750106e5b615e38935d44a49535dbd751d0ca13bf39e0adda8094.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/441852123acb69fdd154b191a4550714b807d38e97f68483c0545a3ac71ffe23.webp","width":229,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三森 すずこ","creatorId":"vndb:s627","sourcePersonId":"vndb:s627","canonicalEntityId":"vndb:s627","name":"三森 すずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57624","source":"vndb"}]},{"characterId":"char_vndb_c81465","characterName":"崇宮 真那","sourceIds":{"vndbCharacterId":"c81465"},"originalCharacterName":"崇宮 真那","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A temporary Second Lieutenant of the AST, Mana works for the DEM Industries based out of England as a Wizard. Revealed to be the biological sister of Shido, she is unable to remember her time with Shido but possesses just a picture which was her only proof that she had a brother."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c81465"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdf476d6c81f256f6e14c3e5a369afa522832be09af9edc8299baf57c8bdee69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2878472bcd1fab6f0b5772333c0940e0e8c2f6d7f5701ece78f58c469525cef2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"味里","creatorId":"vndb:s11254","sourcePersonId":"vndb:s11254","canonicalEntityId":"vndb:s11254","name":"味里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57637","source":"vndb"}]},{"characterId":"char_vndb_c81466","characterName":"岡峰 美紀恵","sourceIds":{"vndbCharacterId":"c81466"},"originalCharacterName":"岡峰 美紀恵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Holding the rank of Private, Mikie is described as having brown eyes and hair, with her hair tied in pigtails. She is in Origami's and Shido's year but she skipped a grade, making her one year younger. Her age being close to Origami's leads her to have a strange attraction to Origami. Her dedication to Origami is shown by the fact that she was willing to resign from the AST when she thought Origami was going to have a disciplinary discharge."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c81466"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b61f95934f2ea4180379fb30509da68c8e4fd339f3deb2159a07325f0e12bbf8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f98e17ac0a3a96ebf566995380feb63d8ee3605fe569e27cc548be8af2a6ecf2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 奏美","creatorId":"vndb:s18230","sourcePersonId":"vndb:s18230","canonicalEntityId":"vndb:s18230","name":"佐藤 奏美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57638","source":"vndb"}]},{"characterId":"char_vndb_c81467","characterName":"殿町 宏人","sourceIds":{"vndbCharacterId":"c81467"},"originalCharacterName":"殿町 宏人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shido's classmate."}],"source":"vndb","sourceCharacterId":"c81467"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6a0e9db4e554ef78e4fc2d99ece6f60ec21f5310e39315f51d5c188e2c9697a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7da78125d4b38408e31f15f7beada8876ea9093db7d2f60d0281496f8675e6e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"勝 杏里","creatorId":"vndb:s4899","sourcePersonId":"vndb:s4899","canonicalEntityId":"vndb:s4899","name":"勝 杏里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57634","source":"vndb"}]},{"characterId":"char_vndb_c81468","characterName":"神無月 恭平","sourceIds":{"vndbCharacterId":"c81468"},"originalCharacterName":"神無月 恭平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kyouhei is the vice-commander of Ratatoskr crewing the Fraxinus, a ship located 15,000 meters above Tengu City. Kyouhei is described to be a nice individual with elegant manners. However, he is also a masochist and often let his masochistic antics make his coworkers question his authority and reliability. He constantly likes angering Kotori who always punishes him over these actions, which he satisfies his masochistic tendencies. Despite his fetishes, when in danger or when the situation truly calls for it, Kyouhei has shown to be highly perceptive and analytical in various situations and it is because of these qualities that earned respect from his coworkers as well."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c81468"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8922ee09f7922bc45f02c83393939be04ff3e8f6a180208ec6bd776bb2f1432e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1737cd6113da9ce6b7d76bd8bbf105e016b8c948c5877e3105f0e24e38e382c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"子安 武人","creatorId":"vndb:s10","sourcePersonId":"vndb:s10","canonicalEntityId":"vndb:s10","name":"子安 武人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57622","source":"vndb"}]},{"characterId":"char_vndb_c81469","characterName":"岡峰 珠恵","sourceIds":{"vndbCharacterId":"c81469"},"originalCharacterName":"岡峰 珠恵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Homeroom teacher for Shido's class, she is called Tama-chan by her students. As she is 29 years old and still single, she is very anxious to get married."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c81469"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b9aa29a7f87c4d8a455415183a652c2f3b756f3b967e4a94a9840b8c5bbc11a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06d9ac59b93c6626cda100867e5328644e075900dd2a8afbaef7bd3b5e3b3469.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐土原 かおり","creatorId":"vndb:s4970","sourcePersonId":"vndb:s4970","canonicalEntityId":"vndb:s4970","name":"佐土原 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57635","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1463","sourceCompanyId":"egs:brand:2567","canonicalEntityId":"vndb:p1463","name":"コンパイルハート","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:20791:2567","source":"egs"},{"companyId":"vndb:p352","sourceCompanyId":"vndb:p352","canonicalEntityId":"vndb:p352","name":"アイディアファクトリー株式会社","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:134516:v14706","source":"vndb"},{"companyId":"vndb:p1463","sourceCompanyId":"vndb:p1463","canonicalEntityId":"vndb:p146