67"},"originalCharacterName":"ロキ・ディズン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Younger Prince of the Black Kingdom. He is hot-blooded and violent. Unlike his older brother, who has the ambition to rule the world, he doesn't care as long as his desires are fulfilled"},{"spoiler":false,"text":"However, if he doesn't control himself, he will crush even his older brother."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c26967"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c1a58f676595bfa0f9ca3946ea56c6d5912b8243211b909031b89938068a791.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a46d20176c0fdd95941c25982ce53c97eb8e23f83eccad90f1ab314b8e0949f4.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c26968","characterName":"コア","sourceIds":{"vndbCharacterId":"c26968"},"originalCharacterName":"コア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first mysterious boy Altraud meets when he is sent outside the castle."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c26968"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/812e47ab769f0d377693beb4db1a347f7fa1a82d742b3b0fbc442431384ce15e.webp","fallbackUrl":"https://wiki-assets.bishojo.da