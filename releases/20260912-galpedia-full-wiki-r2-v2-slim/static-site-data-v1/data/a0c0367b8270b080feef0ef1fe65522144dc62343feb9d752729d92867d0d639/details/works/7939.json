"identityStatus":"source-native","relationId":"vndb:vn-staff:22580","source":"vndb"},{"creditedName":"一般市民","creatorId":"vndb:s44007","sourcePersonId":"vndb:s44007","canonicalEntityId":"vndb:s44007","name":"一般市民","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22581","source":"vndb"},{"creditedName":"とりさん","creatorId":"vndb:s35096","sourcePersonId":"vndb:s35096","canonicalEntityId":"vndb:s35096","name":"鶏さん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22583","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c26370","characterName":"ユナン","sourceIds":{"vndbCharacterId":"c26370"},"originalCharacterName":"ユナン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's cousin and the king's servant."},{"spoiler":false,"text":"In his route, he saves and travels with Ashe to the human world."},{"spoiler":false,"text":"You can unlock him unlocking all of Leni's and Seizh's content"},{"spoiler":true,"text":"He is the real son of the maou, but he changed Unan for Ashe, who is the maou's niece, because she was more powerful than him. He was raised as a servant of the castle."},{"spoiler":true,"text":"He knows everything about this, and that is why he tells that to Ashe in his route."}],"source":"vndb","sourceCharacterId":"c26370"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9247a0d6b93d6a06b3ad6411324b46edce7b8d66d72f732464c7117cd2243e9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e99810fea450477aefff9fc5ac78d8971120aec230d099266c139abb097a5212.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedN