cePersonId":"vndb:s27122","canonicalEntityId":"vndb:s27122","name":"SATOSHI(庄司智)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160321","source":"vndb"},{"creditedName":"ダリオスサウム","creatorId":"vndb:s27568","sourcePersonId":"vndb:s27568","canonicalEntityId":"vndb:s27568","name":"鈴木 規夫","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160322","source":"vndb"},{"creditedName":"緑葉 みんと","creatorId":"vndb:s34093","sourcePersonId":"vndb:s34093","canonicalEntityId":"vndb:s34093","name":"よしだ みんと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160323","source":"vndb"}]},"cast":[{"characterId":"char_c85515","characterName":"舞羽 ナナ","sourceIds":{"bangumi":[{"characterId":"71977","match":"exact-normalized-name-in-linked-work","subjectId":"290343"},{"characterId":"71977","match":"exact-normalized-name-in-linked-work","subjectId":"325937"},{"characterId":"71977","match":"exact-normalized-name-in-linked-work","subjectId":"413620"}],"egsCharacterIds":["22072"],"vndbCharacterId":"c85515"},"originalCharacterName":"舞羽 ナナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"807"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"With an unfeminine, casual way of talking, she tends to be frank with people she meets the first time. Although proud to be a beastfolk, she prefers to be thought of as \"cool\" rather than \"cute\". She is into videogames and plays them extensively regardless of genre. For the longest time, guys would always come to hit on Ichika and like a dutiful mama cat, Nana will chase away any that get too close to her."},{"spoiler":false,"text":"Slightly edited from the official website"}],"source":"vndb","sourceCharacterId":"c85515"},{"segments":[{"spoiler":false,"text":"女の子らしくない砕けた口調で、初対面の相手でもフランクに接する。"},{"spoiler":false,"text":"獣人であることに誇りを持っているものの、「かわいい」よりも「かっこいい」と思われたいので、「かわいい」と言われると「かわいくねーし！」と反発するのがお決まり。"},{"spoiler":false,"text":"ゲームが趣味で、ジャンルや媒体を問わず幅広くプレイしている。"},{"spoiler":false,"text":"苺華は昔から異性に言い寄られることが多く、彼女に近づく悪い虫を親猫のように追い払ってきた。"},{"spoiler":false,"text":"アメリカンショートヘアらしく元気で活発、そして強気な少女。"}],"source":"egs","sourceCharacterId":"22072","sourceWorkId":"28581","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で活発な女の子。誰でもフランクに接するので打ち解けやすい。「かわいい」よりも「かっこいい」と思われたい。"}],"source":"egs","sourceCharacterId":"22072","sourceWorkId":"30553","spoiler":false},{"segments":[{"spoiler":false,"text":"アメリカンショートヘアの獣人で、"},{"spoiler":false,"text":"誰とでも打ち解けられるフランクな性格。"},{"spoiler":false,"text":"「かわいい」よりも「かっこいい」と思われたい派。"},{"spoiler":false,"text":"そのため「かわいい」と言われると「かわいくねーし！」と怒る。"},{"spoiler":false,"text":"ゲームが趣味で、主人公や寮の住人と一緒にゲームをすることも。"},{"spoiler":false,"text":"お菓子作りが大の得意で、その腕前はプロ並み。"}],"source":"egs","sourceCharacterId":"22072","sourceWorkId":"34671","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で活発、そして強気な少女"},{"spoiler":false,"text":"女の子らしくない砕けた口調で、初対面の相手でもフランクに接する。獣人であることに誇りを持っているものの、「かわいい」よりも「かっこいい」と思われたいので、「かわいい」と言われると「かわいくねーし！」と反発するのがお決まり。ゲームが趣味で、ジャンルや媒体を問わず幅広くプレイしている。苺華は昔から異性に言い寄られることが多く、彼女に近づく悪い虫を親猫のように追い払ってきた。"}],"source":"bangumi","sourceCharacterId":"71977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2b6158c7f09f3c33cbebf0b2e3affa7628cbe6aca6480a066b1eeaa1ff3ad5d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3aa4161d88ab3283922dc0e3179852422bb826acd7aed7becb64740db1bfad8f.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原嶋あかり","creatorId":"vndb:s20815","sourcePersonId":"vndb:s20815","canonicalEntityId":"vndb:s20815","name":"原嶋 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:290343:71977:20973:1","source":"bangumi"}]},{"characterId":"char_c85516","characterName":"御園 苺華","sourceIds":{"bangumi":[{"characterId":"71976","match":"exact-normalized-name-in-linked-work","subjectId":"290343"},{"characterId":"71976","match":"exact-normalized-name-in-linked-work","subjectId":"325937"},{"characterId":"71976","match":"exact-normalized-name-in-linked-work","subjectId":"413620"}],"egsCharacterIds":["22071"],"vndbCharacterId":"c85516"},"originalCharacterName":"御園 苺華","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"409"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Though a complete opposite to the headstrong Nana, they've actually been best friends for a long time. Both Setaria and Sweet Tail are owned by Ichika's mother and she works part-time at both of them. She loves romance novels and shoujo manga but also has a secret she can't tell anyone about..."},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c85516"},{"segments":[{"spoiler":false,"text":"柔らかくふわりとした雰囲気で、守ってあげたくなるような女の子。"},{"spoiler":false,"text":"強気なナナとは正反対な性格だが、昔からの親友同士。"},{"spoiler":false,"text":"セタリアとスイートテイルはどちらも苺華の母のお店で、両方にアルバイトとして勤務している。"},{"spoiler":false,"text":"恋愛小説や少女漫画を愛好しているが、実は人に言えない趣味があるとか……"},{"spoiler":false,"text":"賢いプードルらしく、優しく気配りのできる性格。"}],"source":"egs","sourceCharacterId":"22071","sourceWorkId":"28581","spoiler":false},{"segments":[{"spoiler":false,"text":"控えめな性格だが、ちょっぴりお茶目なところも。恋愛小説を手に「王子様」を待っていると語る、恋に憧れる乙女な一面もある。"}],"source":"egs","sourceCharacterId":"22071","sourceWorkId":"30553","spoiler":false},{"segments":[{"spoiler":false,"text":"プードルの獣人で、ふわふわな雰囲気ながらしっかり者。"},{"spoiler":false,"text":"優しく気配りのできる性格で、みんなから慕われている。"},{"spoiler":false,"text":"母は獣人社会の実力者であり、苺華がその代理を務めることも。"},{"spoiler":false,"text":"ナナとは昔からの親友。"},{"spoiler":false,"text":"お姫様に憧れる乙女な一面とは裏腹に、実はアブノーマルな趣味も持っている。"},{"spoiler":false,"text":"甘いものに目がない食いしん坊でもある。"}],"source":"egs","sourceCharacterId":"22071","sourceWorkId":"34671","spoiler":false},{"segments":[{"spoiler":false,"text":"柔らかくふわりとした雰囲気で、守ってあげたくなるような女の子。"},{"spoiler":false,"text":"柔らかくふわりとした雰囲気で、守ってあげたくなるような女の子。強気なナナとは正反対な性格だが、昔からの親友同士。セタリアとスイートテイルはどちらも苺華の母のお店で、両方にアルバイトとして勤務している。恋愛小説や少女漫画を愛好しているが、実は人に言えない趣味があるとか...。"}],"source":"bangumi","sourceCharacterId":"71976"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/257eed190c03d4d233cb6ba77304eef15e0f52f866269af3edc6d6c6efdbba0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5fa9582c1d873b280528733ed74487bb1b9e2da0052bb03e78f78e04c4f0e0d.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星谷美緒","creatorId":"vndb:s17075","sourcePersonId":"vndb:s17075","canonicalEntityId":"vndb:s17075","name":"星谷 美緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:290343:71976:33987:1","source":"bangumi"}]},{"characterId":"char_c85517","characterName":"天宮 みくり","sourceIds":{"bangumi":[{"characterId":"71975","match":"exact-normalized-name-in-linked-work","subjectId":"290343"},{"characterId":"71975","match":"exact-normalized-name-in-linked-work","subjectId":"325937"},{"characterId":"71975","match":"exact-normalized-name-in-linked-work","subjectId":"413620"}],"egsCharacterIds":["22070"],"vndbCharacterId":"c85517"},"originalCharacterName":"天宮 みくり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1110"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who lives in the \"beastman homeland\" where only beastmen live."},{"spoiler":false,"text":"She is the same year as the protagonist. She came to the town as the same time and got a part-time job at the cafe alongside the protagonist. Full of innocent positivity and curiosity, she is someone who proactively charges forward with her tail swinging back and forth. She is a shrine maiden in the beastman homeland and said to be able to hear the voices of the gods. It's said that she came to Yuunagicho because of a divine message."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c85517"},{"segments":[{"spoiler":false,"text":"獣人だけが住むという“獣人の里”からやってきた女の子。"},{"spoiler":false,"text":"主人公とは同学年。同じ時期に町にやってきて一緒にアルバイトを始めることになった。"},{"spoiler":false,"text":"無邪気で積極的、かつ好奇心旺盛で、尻尾をフリフリ振りながら前のめりに突っ込んでいく。"},{"spoiler":false,"text":"獣人の里では巫女をしていて、神様の声を聞くことができるらしい。"},{"spoiler":false,"text":"夕渚町にやってきたのも、神のお告げが理由だとか。"},{"spoiler":false,"text":"特徴を持っている犬種はポメラニアンで、その性質の中でも、元気さや人懐っこさが強く表れている。"}],"source":"egs","sourceCharacterId":"22070","sourceWorkId":"28581","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で人懐っこく、世間知らずなせいもあって無邪気で好奇心旺盛な女の子。"}],"source":"egs","sourceCharacterId":"22070","sourceWorkId":"30553","spoiler":false},{"segments":[{"spoiler":false,"text":"“獣人の里”の出身で、ポメラニアンの獣人。"},{"spoiler":false,"text":"主人公と同じ日に夕渚町にやってきて同時にアルバイトを始めた。"},{"spoiler":false,"text":"無邪気で人懐っこく、好奇心旺盛でポメラニアンらしい性格の持ち主。"},{"spoiler":false,"text":"巫女でもあり、神様の声を聞くことができるという。"},{"spoiler":false,"text":"夕渚町にやってきたのも神様のお告げによるものだが、今作では神様の正体が明らかに……！？"}],"source":"egs","sourceCharacterId":"22070","sourceWorkId":"34671","spoiler":false},{"segments":[{"spoiler":false,"text":"獣人だけが住むという“獣人の里”からやってきた女の子。"},{"spoiler":false,"text":"主人公とは同学年。同じ時期に町にやってきて一緒にアルバイトを始めることになった。無邪気で積極的、かつ好奇心旺盛で、尻尾をフリフリ振りながら前のめりに突っ込んでいく。獣人の里では巫女をしていて、神様の声を聞くことができるらしい。夕渚町にやってきたのも、神のお告げが理由だとか。"}],"source":"bangumi","sourceCharacterId":"71975"}],"profileFacts":[],"metadataCandidateConflicts":{"hip":[{"comparisonValue":"86","source":"vndb","sourceCharacterId":"c85517","value":"86"},{"comparisonValue":"86","scope":"sourceWork","source":"egs","sourceCharacterId":"22070","sourceWorkId":"28581","value":"86"},{"comparisonValue":"86","scope":"sourceWork","source":"egs","sourceCharacterId":"22070","sourceWorkId":"30553","value":"86"},{"comparisonValue":"86","scope":"sourceWork","source":"egs","sourceCharacterId":"22070","sourceWorkId":"34671","value":"86"},{"comparisonValue":"76","source":"bangumi","sourceCharacterId":"71975","value":"76"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d60de81c790e6568d6964612e7bd6acbf194ac876150ac885df9706c9d4f4ece.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e033ec411e47e5c31346a79d7d803de3d57060f5678d5d653c181194b2266941.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ふじたまみ","creatorId":"vndb:s7951","sourcePersonId":"vndb:s7951","canonicalEntityId":"vndb:s7951","name":"ふじた まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:290343:71975:23302:1","source":"bangumi"},{"creditedName":"八ッ橋 しなもん","creatorId":"vndb:s11591","sourcePersonId":"vndb:s11591","canonicalEntityId":"vndb:s11591","name":"八ッ橋しなもん(朔白)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:82647","source":"vndb"}]},{"characterId":"char_c85518","characterName":"雪村 千絵莉","sourceIds":{"bangumi":[{"characterId":"71974","match":"exact-normalized-name-in-linked-work","subjectId":"290343"},{"characterId":"71974","match":"exact-normalized-name-in-linked-work","subjectId":"325937"},{"characterId":"71974","match":"exact-normalized-name-in-linked-work","subjectId":"413620"}],"egsCharacterIds":["22069"],"vndbCharacterId":"c85518"},"originalCharacterName":"雪村 千絵莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"222"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Russian Blue beastfolk who's the veteran waitress."},{"spoiler":false,"text":"Though she's one year younger than the protagonist, she is serious with a sense of responsibility. She started working part-time to become a respectable adult as soon as possible. Though short, with an adorable outward appearance; she gets upset if treated like a child. Due to her independence and seriousness, she tends to say \"I'm fine\" when responding to the kindness of others."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c85518"},{"segments":[{"spoiler":false,"text":"アルバイトの先輩で、ロシアンブルーの獣人。"},{"spoiler":false,"text":"学年は主人公より１つ下だが、生真面目で責任感があり、早く立派な大人になりたくてアルバイトをしている。"},{"spoiler":false,"text":"背が小さく愛らしい外見だが、子ども扱いされると不機嫌になる。"},{"spoiler":false,"text":"自立心と真面目さゆえに、人の好意に対しても、つい「大丈夫です」と言ってしまいがち。"},{"spoiler":false,"text":"ロシアンブルーは猫の中でも気難しい種類で、独占欲があり、少しジェラシーを見せることも。"}],"source":"egs","sourceCharacterId":"22069","sourceWorkId":"28581","spoiler":false},{"segments":[{"spoiler":false,"text":"人間なのに獣人の耳が見える主人公を警戒していたが、今では信頼している。"}],"source":"egs","sourceCharacterId":"22069","sourceWorkId":"30553","spoiler":false},{"segments":[{"spoiler":false,"text":"猫の獣人で、品種はロシアンブルー。"},{"spoiler":false,"text":"主人公が夕渚町で初めて出会った獣人であり、セタリアに連れてきたのも彼女である。"},{"spoiler":false,"text":"真面目で責任感のある性格だが、時には真面目すぎて融通が利かないことも。"},{"spoiler":false,"text":"自分のめんどくさい面と向かいながら大人になっていく最中。"},{"spoiler":false,"text":"ロシアンブルーは嫉妬心が強いと言われる品種であり、"},{"spoiler":false,"text":"千絵莉もロシアンブルーらしくやきもちを焼くこともしばしば。"}],"source":"egs","sourceCharacterId":"22069","sourceWorkId":"34671","spoiler":false},{"segments":[{"spoiler":false,"text":"アルバイトの先輩で、ロシアンブルーの獣人。"},{"spoiler":false,"text":"学年は主人公より１つ下だが、生真面目で責任感があり、早く立派な大人になりたくてアルバイトをしている。背が小さく愛らしい外見だが、子ども扱いされると不機嫌になる。自立心と真面目さゆえに、人の好意に対しても、つい「大丈夫です」と言ってしまいがち。"}],"source":"bangumi","sourceCh