","name":"MOKA","detail":"プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70999","source":"egs"},{"creditedName":"MOSAIC.WAV","creatorId":"vndb:s1739","sourcePersonId":"vndb:s1739","canonicalEntityId":"vndb:s1739","name":"MOSAIC.WAV","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:22000","source":"vndb"},{"creditedName":"なるみ すずね","creatorId":"vndb:s4338","sourcePersonId":"vndb:s4338","canonicalEntityId":"vndb:s4338","name":"なるみ すずね","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:22002","source":"vndb"},{"creditedName":"unMOMENT","creatorId":"vndb:s7518","sourcePersonId":"vndb:s7518","canonicalEntityId":"vndb:s7518","name":"unMOMENT","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:22005","source":"vndb"},{"creditedName":"MOKA","creatorId":"vndb:s8200","sourcePersonId":"vndb:s8200","canonicalEntityId":"vndb:s8200","name":"MOKA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22006","source":"vndb"},{"creditedName":"KEN-ZO","creatorId":"vndb:s9713","sourcePersonId":"vndb:s9713","canonicalEntityId":"vndb:s9713","name":"KEN-ZO","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:22007","source":"vndb"}]},"cast":[{"characterId":"char_c51374","characterName":"鮎並 千里","sourceIds":{"bangumi":[{"characterId":"95769","match":"exact-normalized-name-in-linked-work","subjectId":"335210"}],"egsCharacterIds":["25570"],"vndbCharacterId":"c51374"},"originalCharacterName":"鮎並 千里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と交際を始めたクラスメイトの女の子。"},{"spoiler":false,"text":"主人公も男女交際初体験だが、彼女も同じく初体験。"},{"spoiler":false,"text":"自分が美少女であることをあまり意識しておらず、周囲もそれを理解し、彼女と接している。しかし、主人公と交際を始めてからどんどん綺麗になっていく。"},{"spoiler":false,"text":"性格は超が付くほど天然。それ以外は普通の女の子と変わらない。"},{"spoiler":false,"text":"お姉ちゃん（万里奈）仕込みエロネタをしっかりと頭に記憶し、それを先走り気味の主人公を結果的にフォローしちゃったり。"}],"source":"egs","sourceCharacterId":"25570","sourceWorkId":"7542","spoiler":false},{"segments":[{"spoiler":false,"text":"同じ学園に通う主人公のクラスメート。"},{"spoiler":false,"text":"性格は超がつく程の天然だが、他の部分は至って普通の女の子。甘いもの好き。可愛いもの好き。優しい話好き。お姉ちゃん仕込みの本やビデオで覚えた知識通りに行動し、主人公の先走りを結果的にフォローしちゃったりするので、焦り過ぎの主人公とは相性がよい。"}],"source":"bangumi","sourceCharacterId":"95769"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f39bbf0b15ff8b4b9fbd2b32393c253061fe78f5b3f25ac86381c14e681f3595.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f7e265546e680ba6e5df42fdc86d3ad8243c72533d0b02dfce64cd30bbdb267.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:335210:95769:6045:1","source":"bangumi"}]},{"characterId":"char_c51375","characterName":"鮎並 万里奈","sourceIds":{"bangumi":[{"characterId":"95770","match":"exact-normalized-name-in-linked-work","subjectId":"335210"}],"egsCharacterIds":["25572"],"vndbCharacterId":"c51375"},"originalCharacterName":"鮎並 万里奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"千里の姉にして、主人公たちが通う学園の養護教諭。"},{"spoiler":false,"text":"おっとりして優しい外見に似合わず、陰謀や策謀を張り巡らすことが大好きで、毒婦カトリーヌ・ド・メディチの生まれ変わりと呼ばれたりしている。"},{"spoiler":false,"text":"妹コントロールが趣味で、その妹が主人公を交際を始めることになって、遂に自分の壮大な実験が始める、と大喜びしている。"}],"source":"egs","sourceCharacterId":"25572","sourceWorkId":"7542","spoiler":false},{"segments":[{"spoiler":false,"text":"千里の姉にして、主人公たちの学園の保健医。"},{"spoiler":false,"text":"趣味は妹コントロール。保健室での陰謀、策動、実験の数々は、妹に使うための実験らしい。"},{"spoiler":false,"text":"そんな矢先、千里の「主人公に一目ぼれした」という告白を聞き、ついに自分の壮大な実験の始まりと大喜びする。"},{"spoiler":false,"text":"両親が離れて暮らしているので、妹にとって母親がわりの存在でもある。"}],"source":"bangumi","sourceCharacterId":"95770"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f073769aca30c3cd9817db9bc9d7afd52e0f5b5d15be07ba60fabc4e690a3dab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02bc255651307639617c50a20a0418f7d0b425c71e0820ff8e31fc3e81afde2c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:335210:95770:4714:1","source":"bangumi"}]},{"characterId":"char_c51376","characterName":"原田 美春","sourceIds":{"bangumi":[{"characterId":"95771","match":"exact-normalized-name-in-linked-work","subjectId":"335210"}],"egsCharacterIds":["25571"],"vndbCharacterId":"c51376"},"originalCharacterName":"原田 美春","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"主人公は「原田家の大暴君（タイラント）」と呼んでいるが、彼女自身もそれを“当然”と思っている、ある意味「女帝」的な性格の女の子。"},{"spoiler":false,"text":"両親は海外生活しており、兄と二人暮らし。"},{"spoiler":false,"text":"ロハス（＝健康と持続可能な社会に配慮したライフスタイル）的な気分になりたいが、オタクな兄がいてはそうはなれないと考え、早く兄を追い出したいと思っている。"},{"spoiler":false,"text":"その兄が、憧れの先輩・千里と交際を始めたことにショックを受けるとともに絶望する。ならばと兄を真人間に更生させようと奮闘し始める。"}],"source":"egs","sourceCharacterId":"25571","sourceWorkId":"7542","spoiler":false},{"segments":[{"spoiler":false,"text":"原田家の大暴君と兄に呼ばれている妹。本人も、それを「当然」と思っている小君主ならぬ小女帝。"},{"spoiler":false,"text":"ファッションにうるさく、ロハスなライフスタイルに憧れているが、オタクな兄がいてはそんな風になれないので早く兄を追い出したいと切望している。"},{"spoiler":false,"text":"将来の夢は「保母さん」か「花屋さん」。（兄以外には）優しい、割りと乙女な女の子。"},{"spoiler":false,"text":"憧れていた千里が兄と付き合っていることを知り、兄をなんとか真人間にしようと頑張ったりする。"}],"source":"bangumi","sourceCharacterId":"95771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab33581574ac8c7e2a715fa5224365770ecc09b98569abbcf423926103b08c21.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4472873a54334569b971ecd08753df6db833c18fbdaefbb4cda782f5960e2dbb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:335210:95771:6166:1","source":"bangumi"}]},{"characterId":"char_vndb_c51381","characterName":"唐本屋 りあん","sourceIds":{"vndbCharacterId":"c51381"},"originalCharacterName":"唐本屋 りあん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5c7e39ce720d6dd0629cedca01860e3b3bc799fb4da266d2ae3074f7b6ee32b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/127a3c6d0ba8b5bcf74c71765cc9dea3a91238d394249df8068c39fe121de2c8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"み～こ","creatorId":"vndb:s1897","sou