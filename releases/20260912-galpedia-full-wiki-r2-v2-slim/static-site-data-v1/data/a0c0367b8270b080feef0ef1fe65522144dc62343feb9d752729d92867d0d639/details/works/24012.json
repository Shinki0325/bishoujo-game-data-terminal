:"source-native","relationId":"vndb:vn-staff:132658","source":"vndb"},{"creditedName":"陽向たろ","creatorId":"vndb:s15003","sourcePersonId":"vndb:s15003","canonicalEntityId":"vndb:s15003","name":"陽向たろ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:132661","source":"vndb"}]},"cast":[{"characterId":"char_c50478","characterName":"寝子草 きさら","sourceIds":{"bangumi":[{"characterId":"48062","match":"exact-normalized-name-in-linked-work","subjectId":"187471"}],"egsCharacterIds":["10748"],"vndbCharacterId":"c50478"},"originalCharacterName":"寝子草 きさら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite food: Neko-manma"},{"spoiler":false,"text":"Hobbies: Playing retro games"},{"spoiler":false,"text":"Misatoko's older (not actually) twin sister and the older half-sister to all of the other main girls except Hana, and Mizuho, who is her older half-sister."},{"spoiler":true,"text":"At the end of Misatoko's route she marries her sister Misatoko"}],"source":"vndb","sourceCharacterId":"c50478"},{"segments":[{"spoiler":false,"text":"学生会会長にして、勉強もスポーツも常にトップ。一億年に一人に逸材と呼ばれている優秀な女の子。その為、他人に頼られることも多く、学園長の孫（実際には大祖母が学園長）であったこともあり、学生会から学園の経営まで頼られている。"},{"spoiler":false,"text":"もともとは人に弱みを見せないツンデレ系のがんばり屋さん。でも、頑張りすぎて倒れることも……。"},{"spoiler":false,"text":"そんな時に優しくしてくれた主人公に好意を抱くようになり、さらに彼と出会って初めて他人に甘える悦びを知ってしまって……結婚後、数週間でダメ人間モードへ。"},{"spoiler":false,"text":"主人公に唯一負けたレトロゲーに勝つために、日夜引き籠もりゲームで遊ぶ毎日を過ごしている。でも、エッチは大好き。働いたら負け。でも、エッチしてくれるなら頑張る～……と、まったりと日々を過ごしています。"}],"source":"egs","sourceCharacterId":"10748","sourceWorkId":"24012","spoiler":false},{"segments":[{"spoiler":false,"text":"文武両道な学生会会長。 1000年に一人に逸材と呼ばれている。"},{"spoiler":false,"text":"祖母の莫大な財産を継ぐため、借金だらけの名門校の再生に取り組んでいた。"},{"spoiler":false,"text":"しかし主人公と出逢い、彼のひたむきさに 「愛はお金じゃないわ！」 と覚醒。"},{"spoiler":false,"text":"主人公と結婚後は本来の自分に目覚めすぎて、“ダメ人間”に。"},{"spoiler":false,"text":"働いたら負け。でも、主人公とエッチするのは大好き……。"},{"spoiler":false,"text":"「エッチしてくれるなら頑張る～」と、まったり日々を過ごしている。"},{"spoiler":false,"text":"「ふぇ、必要なこと……子作り？　他には何もいらないよぉ。ラブ・アンド・ニート……へへへっ。」"}],"source":"bangumi","sourceCharacterId":"48062"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"48062","value":"ねこまんま"},{"label":"趣味","source":"bangumi","sourceCharacterId":"48062","value":"レトロゲーム（古い海外の筐体が好き）"},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"10748","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"10748","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"10748","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"10748","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"10748","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"57 kg","valueContext":null,"source":"egs","sourceCharacterId":"10748","sourceWorkId":"24012","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14918be18a2b298d94ac3ef44d78ac812a6f5a9e31c939ba4a07047c5c83fd22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15170c2bac234d28387bf9c7e94344234b98c6a344f957e92960b06e6b889ba1.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187471:48062:5928:1","source":"bangumi"}]},{"characterId":"char_c50479","characterName":"百日紅 美郷子","sourceIds":{"bangumi":[{"characterId":"48064","match":"exact-normalized-name-in-linked-work","subjectId":"187471"}],"egsCharacterIds":["10749"],"vndbCharacterId":"c50479"},"originalCharacterName":"百日紅 美郷子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite food: Kisara's leftovers, bananas"},{"spoiler":false,"text":"Hobbies: Watching her Kisara"},{"spoiler":false,"text":"A girl Kisara's met at a party and immediately declared her younger twin sister. The two have treated each other as sisters ever since."},{"spoiler":true,"text":"At the end of her route she marries both Hitoma and Kisara"}],"source":"vndb","sourceCharacterId":"c50479"},{"segments":[{"spoiler":false,"text":"幼い頃に陶芸家の家元、百日紅家へ養子に入り、それ以来その才能を開花させ子供の頃から、天才陶芸家の名を欲しいままにしてきました。"},{"spoiler":false,"text":"また陶芸の他、絵画や日本舞踊、三味線も名取りレベル。万能の天才です。"},{"spoiler":false,"text":"でも何かを極めたいとは思っていません。目標はあくまで“お嫁さん”です。"},{"spoiler":false,"text":"お嬢様と言うこともあり、ツンツン、高飛車な性格です。"},{"spoiler":false,"text":"でも、きさらのことを“きら姉様”と呼び慕って……慕いすぎて、男に興味がありません。ですが、最近変化が……。"},{"spoiler":false,"text":"きさらにまとわりつく主人公のことはもともと大嫌い。以前はダンゴムシ、駄犬、ちゅぱかぶら、等と呼んでいました。"},{"spoiler":false,"text":"しかし、、ある事件を切っ掛けに「義理兄様ぁ（そのまま“ぎりにいさまぁ”と読みます）」と呼ぶように。心なしか頬も赤く、デレ気味になることも？！"}],"source":"egs","sourceCharacterId":"10749","sourceWorkId":"24012","spoiler":false},{"segments":[{"spoiler":false,"text":"きさらの双子の妹。 幼い頃に陶芸家の家元・百日紅家へ養子入りしている。"},{"spoiler":false,"text":"天才陶芸家の名を欲しいままにし、さらに絵画や日本舞踊、三味線も名取りレベル。きさらのことを “きら姉様” と熱烈に慕い、おかげで男には興味がない様子。"},{"spoiler":false,"text":"きさらにまとわり付く主人公のことは大嫌いで、ダンゴムシ、駄犬などと呼んでいる。"},{"spoiler":false,"text":"しかし、ある事件をキッカケに 「義理兄様ぁ」 と呼ぶように……？"},{"spoiler":false,"text":"「この、ダンゴムシ、駄犬～！」"}],"source":"bangumi","sourceCharacterId":"48064"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"48064","value":"きら姉様の食べ残し、バナナ"},{"label":"趣味","source":"bangumi","sourceCharacterId":"48064","value":"きら姉様ウォッチング"},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10749","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"10749","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"10749","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"10749","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"10749","sourceWorkId":"24012","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"10749","sourceWorkId":"24012","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image"