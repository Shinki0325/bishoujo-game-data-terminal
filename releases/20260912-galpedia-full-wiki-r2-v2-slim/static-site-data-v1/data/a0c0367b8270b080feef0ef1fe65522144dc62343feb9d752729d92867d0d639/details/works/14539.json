2a3ce1a04ab771872dd067d6ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dca89fbb06906985895c73223847fae8900a8b1c5c44ddfcfad755b72c7f7efe.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星川 未流来","creatorId":"vndb:s1116","sourcePersonId":"vndb:s1116","canonicalEntityId":"vndb:s1116","name":"原田 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26350","source":"vndb"}]},{"characterId":"char_vndb_c39528","characterName":"小峰 竜樹","sourceIds":{"vndbCharacterId":"c39528"},"originalCharacterName":"小峰 竜樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A classmate of Kaname's."},{"spoiler":false,"text":"He's always teasing her."}],"source":"vndb","sourceCharacterId":"c39528"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3ca963afcff052a6c9dba813e11962e583be96695abb6bc04964a3a2ecbdf647.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8eeb0099f95e635610124e68cbd6e3ac9ff739672610330a855138074334222.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川 ゆうすけ","creatorId":"vndb:s63","sourcePersonId":"vndb:s63","canonicalEntityId":"vndb:s63","name":"寺島 拓篤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26344","source":"vndb"}]},{"characterId":"char_vndb_c823","characterName":"片桐 奏","sourceIds":{"vndbCharacterId":"c823"},"originalCharacterName":"片桐 奏","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"520"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Reading/Delusions/Sleeping"},{"spoiler":false,"text":"Star Sign: Taurus"},{"spoiler":false,"text":"Katagiri Kanade is a hikikomori who spent her days lazing off in her room. Her specialty is her broad imagination which often leads to various wild delusions. One night a weird cowboy guy appeared in her dream, saying that he’s her heart’s hero. Due to his encouragement, Kanade decided to try and go have a haircut the next day. It was then when she met a mysterious guy who cut her hair in the park, giving her courage to resume her school days."},{"spoiler":false,"text":"From Love-colored Sky"}],"source":"vndb","sourceCharacterId":"c823"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c238a4f6ade38359d1e3a6d1c6aeb7335af63f0f60b62d93412bfe19f3d1c9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/012ad4bb14fcd5a8e6451345ca56903c08e13c0e512cc40f54f182f3c61c53ff.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星咲 イリア","creatorId":"vndb:s436","sourcePersonId":"vndb:s436","canonicalEntityId":"vndb:s436","name":"咲乃 藍里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26349","source":"vndb"}]},{"characterId":"char_vndb_c824","characterName":"園村 郁人","sourceIds":{"vndbCharacterId":"c824"},"originalCharacterName":"園村 郁人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"803"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Cooking/Sales/Gardening"},{"spoiler":false,"text":"Star Sign: Leo"},{"spoiler":false,"text":"Ikuto is Kanade’s tsundere younger brother. He’s the son of her mother’s lover, so they’re not related by blood. Since their parents are away, Ikuto was the one who took care of their household. He’s especially good at cooking, in contrary to Kanade’s nonexistent cooking skill. Ikuto is very protective of Kanade, taking care of her everyday and watches over her so that she won’t be harmed. His hobby other than cooking is gardening."},{"spoiler":false,"text":"From Love-colored Sky"}],"source":"vndb","sourceCharacterId":"c824"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/569e5723135dc1f55a17866bd275112d4c9e8680daa91ea5c7647040d16c315e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/218db24ca06e22db8a04af5cba214b6d9cc1f9a9eea5ca3e06dd0e80f7b234b5.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"十利須我里","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26348","source":"vndb"}]},{"characterId":"char_vndb_c825","characterName":"須藤 透央","sourceIds":{"vndbCharacterId":"c825"},"originalCharacterName":"須藤 透央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"701"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Collecting Earrings/Yakiniku/Astrology"},{"spoiler":false,"text":"Star Sign: Cancer"},{"spoiler":false,"text":"Yukio is Kanade’s former classmate, way before she became a hikikomori. They met again when he hit on her after she had a haircut. He was embarrassed to have flirted with a girl he knew, but also encouraged her to go back to school. Yukio went to a different, neighboring high school, but he came to pick her up every morning... much to Ikuto’s dismay. Yukio lives alone in a small apartment, since his home was too far from the school. His parents own a family company."},{"spoiler":false,"text":"From Love-colored Sky"}],"source":"vndb","sourceCharacterId":"c825"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e651c5832c6133bbb3210da50dab724c289ef2c3e1d8725627b11d56f94a87c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82e6f747bedfcc7c47ecabb47d8d770967cef3b9e878624475c6a59c67fb350a.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"先割れスプーン","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26346","source":"vndb"}]},{"characterId":"char_vndb_c826","characterName":"紺野 千紘","sourceIds":{"vndbCharacterId":"c826"},"originalCharacterName":"紺野 千紘","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"220"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Piano/Sweets/Fairy Tales"},{"spoiler":false,"text":"Star Sign: Pisces"},{"spoiler":false,"text":"Konno-sensei is Kanade’s homeroom teacher. Since Kanade was absent for so long, she couldn’t follow the lessons when she started attending school again. Chihiro asked her to come to the counseling room whenever she wanted his help, since he will be there to help her study. Despite his scary face, he actually likes sweets and is very good at cooking. He actually loves kids and wants to write fantasy picture books for children."},{"spoiler":false,"text":"From Love-colored Sky"}],"source":"vndb","sourceCharacterId":"c826"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f9394bb78ac4803bad7b5ea6a47c196456ad253650d2fd5d36f0225f0fa52e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/930c816d8e84af4cd35ffe96509f7dec1cbbab137a47f9b0e7483312a5de8cf6.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井 達矢","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26345","source":"vndb"}]},{"characterId":"char_vndb_c827","characterName":"蓮井 智臣","sourceIds":{"vndbCharacterId":"c827"},"originalCharacterName":"蓮井 智臣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"126"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Decorative Plants/Aromas/Traveling"},{"spoiler":false,"text":"Star Sign: Aquarius"},{"spoiler":false,"text":"Tomoomi is the mysterious hairdresser who gave Kanade a haircut. She was scared when he chased after her and cut her hair by force in the park, but his skills are top-notch. He owns a salon named Azalea in front of the station, and Kanade often came to visit him for hair treatments. He refused to receive any payments though, since she’s his cut model."},{"spoiler":false,"text":"From Love-colored Sky"}],"source":"vndb","sourceCharacterId":"c827"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4e58aff48a14899728c2a368f2c260b9a20e4b5d4da27895ae21f92b2d98b18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a1f64f56495141e7d69ba2605700ae299a724317f16689077ad5769345edb34.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木島 宇太","creatorId":"vndb:s52","sourcePersonId":"vndb:s52","canonicalEntityId":"vndb:s52","name":"水島 大宙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26347","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1344","sourceCompanyId":"egs:brand:3090","canonicalEntityId":"vndb:p1344","name":"little cheese","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14539:3090","source":"egs"},{"companyId":"vndb:p1344","sourceCompanyId":"vndb:p1344","canonicalEntityId":"vndb:p1344","name":"little cheese","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:119478:v4106","source":"vndb"},{"companyId":"vndb:p1310","sourceCompanyId":"vndb:p1310","canonicalEntityId":"vndb:p1310","name":"翼之梦","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:135631:v4106","source":"vndb"},{"companyId":"vndb:p1344","sourceCompanyId":"vndb:p1