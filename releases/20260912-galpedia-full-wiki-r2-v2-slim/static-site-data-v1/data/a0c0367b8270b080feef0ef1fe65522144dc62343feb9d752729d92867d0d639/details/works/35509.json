cb08979c14dbe6366aa57eab5f3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/899f62b33f7d284dc30710873310f76bc49773b8d80f3ce1132149359254ce40.webp","width":108,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c99582","characterName":"扇町 翔子","sourceIds":{"bangumi":[{"characterId":"91278","match":"exact-normalized-name-in-linked-work","subjectId":"41608"}],"egsCharacterIds":["17833"],"vndbCharacterId":"c99582"},"originalCharacterName":"扇町 翔子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鉄道捜査隊の女性捜査官。"},{"spoiler":false,"text":"「満潮」と連続女性失踪事件の関係を嗅ぎ付け、捜査のため乗り込む。"},{"spoiler":false,"text":"正義感のかたまりの、警察官の鑑。"},{"spoiler":false,"text":"ただ性格が荒いため、気配りがきかず、なりふり構わず突進する。"},{"spoiler":false,"text":"身体の線は細いが、意外と強い。"}],"source":"egs","sourceCharacterId":"17833","sourceWorkId":"11004","spoiler":false},{"segments":[{"spoiler":false,"text":"元鉄道捜査官。"},{"spoiler":false,"text":"当時【満潮】で起こる不可解な失踪事件の調査のために乗り込んできたが、精治に捕らわれ調教を受け、メス奴隷となる。"},{"spoiler":false,"text":"【夜鷹】の警備主任として乗車している。"}],"source":"egs","sourceCharacterId":"17833","sourceWorkId":"35509","spoiler":false},{"segments":[{"spoiler":false,"text":"鉄道捜査隊の女性捜査官。"},{"spoiler":false,"text":"女性失踪事件と【満潮】の関係に目を付け、上層部からの圧力にも屈せず単身調査に乗り込んでくる。"},{"spoiler":false,"text":"正義感の強い女性で、己の信念を曲げようとしない性格。"},{"spoiler":false,"text":"困っている人は見捨てておけない。"},{"spoiler":false,"text":"ただし持ち前の強気な性格のせいか、細やかな配慮や気配りができない傾向にあり、時折弱者を傷つける言動を知らずに発してしまったりする。"},{"spoiler":false,"text":"細身の割りにそこそこ腕が立つ。"},{"spoiler":false,"text":"意志の強そうな顔立ちが特徴の美人である。"}],"source":"bangumi","sourceCharacterId":"91278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edb12e79bdd051e0374894750c1d3b3bef525179a7aa5eb5a958de1449886821.webp","fall