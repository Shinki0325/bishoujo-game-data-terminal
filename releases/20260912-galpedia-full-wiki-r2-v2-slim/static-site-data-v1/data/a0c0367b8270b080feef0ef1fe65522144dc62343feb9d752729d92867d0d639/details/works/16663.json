iki/v1/characters/v1/images/32/32dd4d11afa2c922d1d2e17abc562434082d11f7f97bf7ecadbdc4f754eeb21d.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c27293","characterName":"エルナ・シェール","sourceIds":{"vndbCharacterId":"c27293"},"originalCharacterName":"エルナ・シェール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Originally from a prominent family which got bankrupt due to their failure in space research and exploitation. Aiming on going to a space exploitation related school, Erna came to the island and joined the training school to take the training that's connected with space. Though smart and nobody can defeat her in terms of technology, she is an uncooperative person and isn't interested in teamplay."},{"spoiler":false,"text":"Edited from dnandre's review"}],"source":"vndb","sourceCharacterId":"c27293"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b03c739ce756b5a36031ce2f36a03003b9fe6181301487173bae4106154dd0f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd8c63210d161e0e1bd819f689bf9c06406547087ac306030da818647d231052.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45450","source":"vndb"}]},{"characterId":"char_vndb_c27294","characterName":"小倉 みなも","sourceIds":{"vndbCharacterId":"c27294"},"originalCharacterName":"小倉 みなも","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A straight peasant girl who is very emotional, but also simple and gentle, though a bit clumsy. Skillful at swimming but poor with machines. She is nicknamed as the \"Island's Mermaid\" due to her swimming skills. Born into a distinguished family, also the Chief Village's grandchild, she is proud of her long hair that resembles her death mother's. Her parents died in an accident related to the sea."},{"spoiler":false,"text":"Edited from dnandre's review"}],"source":"vndb","sourceCharacterId":"c27294"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/892314eca0281f786a062f7726cd1a7ad9e3f6fe90e4d1c951260c89cc980125.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5afed83c1f3515edfbe4a4938005ba9524a4af8ca34d54689f915ce798d2942f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃井 いちご","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45451","source":"vndb"}]},{"characterId":"char_vndb_c27295","characterName":"八潮 理帆","sourceIds":{"vndbCharacterId":"c27295"},"originalCharacterName":"八潮 理帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl that is very skillful with machines (or should I say, she has a machine fetish). Timid and afraid of talking to people, but once the subject of machines is brought up, she becomes more talkative. She is very detailed in serial numbers and diving suits, not to mention good at maintenance work. Rio's wish is to become an ocean engineer. However, Rio receives the worst times in the training classes and often gets punishments for failing, such as cleaning the pool and bathrooms. Rio, along with the protagonist, are both bad swimmers."},{"spoiler":false,"text":"Edited from dnandre's review"}],"source":"vndb","sourceCharacterId":"c27295"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3c9122565495f3bc9f25b8e9e7dc12c3a0d4c6c3d4cbe33ae1cff0f75c28ff3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f840f42ce009cd0faf57d01b6639b49361c2f7c81abc09695fd15ccc36cf26c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松田 理沙","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45455","source":"vndb"}]},{"characterId":"char_vndb_c27299","characterName":"南郷 月海","sourceIds":{"vndbCharacterId":"c27299"},"originalCharacterName":"南郷 月海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukimi is a delinquent, causes often trouble and a bit of a bullish girl. Though a bit violent, Tsukimi is actually a gentle and friendly girl. She loves driving, with all the experience of driving different vehicles, she calls herself the “Emperor of the Unlicensed”. Because her parents were famous sailors and never came home, she thought they abandoned. She doesn't get along with Erna."},{"spoiler":false,"text":"[Edited from dnandre's review)"}],"source":"vndb","sourceCharacterId":"c27299"}],"profileFacts":[],"m