:vn-staff:198562","source":"vndb"},{"creditedName":"しなもと","creatorId":"vndb:s45970","sourcePersonId":"vndb:s45970","canonicalEntityId":"vndb:s45970","name":"しなもと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198563","source":"vndb"},{"creditedName":"nipper","creatorId":"vndb:s45971","sourcePersonId":"vndb:s45971","canonicalEntityId":"vndb:s45971","name":"nipper","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198564","source":"vndb"},{"creditedName":"Magic Capsule","creatorId":"vndb:s45972","sourcePersonId":"vndb:s45972","canonicalEntityId":"vndb:s45972","name":"マジックカプセル(Magic Capsule)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198565","source":"vndb"},{"creditedName":"Lilium","creatorId":"vndb:s47538","sourcePersonId":"vndb:s47538","canonicalEntityId":"vndb:s47538","name":"Lilium","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198566","source":"vndb"},{"creditedName":"岸田 勇気","creatorId":"vndb:s47539","sourcePersonId":"vndb:s47539","canonicalEntityId":"vndb:s47539","name":"岸田 勇気","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198567","source":"vndb"},{"creditedName":"室屋 光一郎","creatorId":"vndb:s47540","sourcePersonId":"vndb:s47540","canonicalEntityId":"vndb:s47540","name":"室屋 光一郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198568","source":"vndb"},{"creditedName":"Embedded Wings","creatorId":"vndb:s47541","sourcePersonId":"vndb:s47541","canonicalEntityId":"vndb:s47541","name":"Embedded Wings","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198569","source":"vndb"},{"creditedName":"水篠 公範","creatorId":"vndb:s47542","sourcePersonId":"vndb:s47542","canonicalEntityId":"vndb:s47542","name":"水篠 公範","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198570","source":"vndb"},{"creditedName":"其原 健司","creatorId":"vndb:s47543","sourcePersonId":"vndb:s47543","canonicalEntityId":"vndb:s47543","name":"其原 健司","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198571","source":"vndb"},{"creditedName":"BALCOLONY.","creatorId":"vndb:s47544","sourcePersonId":"vndb:s47544","canonicalEntityId":"vndb:s47544","name":"BALCOLONY.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198572","source":"vndb"},{"creditedName":"吉川 史裕","creatorId":"vndb:s47545","sourcePersonId":"vndb:s47545","canonicalEntityId":"vndb:s47545","name":"吉川 史裕","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:198573","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c132127","characterName":"坂下 深菜","sourceIds":{"vndbCharacterId":"c132127"},"originalCharacterName":"坂下 深菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"When I lost my faith in people, I holed myself up in my room and immersed myself in video games and anime. I hoped that, if I ran away from the pain and suffering, someone would come to my rescue eventually, and I would find a place where I could belong."},{"spoiler":false,"text":"After an entire year, just as I began to fear that such a place would never exist, I found a pamphlet in the crack under my door. Clinging to that ray of hope, I decided to go to the place it advertised."},{"spoiler":false,"text":"I never want to return to that room again. I don't want to simply wait and wither away. Instead, I'm going to stop running away and take a step forward."},{"spoiler":false,"text":"At least, that's what I want to believe..."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c132127"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b61c02576c13fcad9c25d6a3bbbd46d67d149f9b22434b3664a3acb9aee3158.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8094fba94dd1461d4a0fb0c1e2b5c1af4268bbfd531cf3419736ecd7c5c0040c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上田 麗奈","creatorId":"vndb:s10841","sourcePersonId":"vndb:s10841","canonicalEntityId":"vndb:s10841","name":"上田麗奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95713","source":"vndb"}]},{"characterId":"char_vndb_c132128","characterName":"星野 蘭","sourceIds":{"vndbCharacterId":"c132128"},"originalCharacterName":"星野 蘭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born into a privileged family, I grew up living the life my parents laid out for me, never questioning if it was really what I wanted. But when my parents started to grow apart, I found myself eating all my meals alone. I started to feel trapped, like I was suffocating."},{"spoiler":false,"text":"I decided to take my life into my own hands. I dyed my hair blonde in an act of rebellion against my parents and my school. I didn't realize at the time that my heart was crying out inside of me. All I knew was that nobody cared for me, so I stopped caring, too. I stopped going to school. I trashed my room. My heart was broken."},{"spoiler":false,"text":"However, everything changed when I went to that one place. I found someone who could hear the true voice of my heart, and the time we spent together healed me. That's why I'll..."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c132128"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4792f143901fa7fcab758326de768dbeab22bff76056e08d677e69b3194ce38e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29401c0fa76a2f5fd922b15f0c057114cff2997e1789d20f90571a3df92f5fde.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Lynn","creatorId":"vndb:s27021","sourcePersonId":"vndb:s27021","canonicalEntityId":"vndb:s27021","name":"Lynn","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95715","source":"vndb"}]},{"characterId":"char_vndb_c132129","characterName":"橘 紗波","sourceIds":{"vndbCharacterId":"c132129"},"originalCharacterName":"橘 紗波","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"At one point in my life, I needed permission for everything. I couldn't even read my favorite books."},{"spoiler":false,"text":"Those wounds on my heart gradually deepened, until I reached my limit. When the one person I'd allowed the tiniest space in my heart for betrayed me, all hope seemed lost."},{"spoiler":false,"text":"However, a lot has changed since then, and now I feel truly glad to be alive."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c132129"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f48c841ad8d8ccbde46e8b8c9e0c6a42ead071a9c0cc533fc2b9fb1a799f767.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f4b1cfd48fb1cd92550050ef50e03f91ce1dbf63f9dbaa73ef405b10301efcf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎藤 千和","creatorId":"vndb:s475","sourcePersonId":"vndb:s475","canonicalEntityId":"vndb:s475","name":"斎藤千和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95712","source":"vndb"}]},{"characterId":"char_vndb_c132130","characterName":"成瀬 陽毬","sourceIds":{"vndbCharacterId":"c132130"},"originalCharacterName":"成瀬 陽毬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"My parents passed away when I was a little kid. I closed my heart to everything. I barely talked at all, and I stopped smiling altogether."},{"spoiler":false,"text":"But when I saw how hard everyone was working, and when I realized how much they cared about me, I remembered how to smile again. Now I'm able to work with the guests myself! I do my best every day for the sake of the lodge and my loved ones."},{"spoiler":false,"text":"When I'm not helping out at the lodge, I like to make herbarium bottles."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c132130"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/762ca9e4394223df99b5ef495465faaca3c8d7b6651939de011448d6e991d89b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e64acca5b575b2878eb39356bc70c24b782a1dc05eefbf606247359cfe802ae3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富田 美憂","creatorId":"vndb:s22553","sourcePersonId":"vndb:s22553","canonicalEntityId":"vndb:s22553","name":"富田 美憂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95714","source":"vndb"}]},{"characterId":"char_vndb_c132132","characterName":"柳瀬 美智子","sourceIds":{"vndbCharacterId":"c132132"},"originalCharacterName":"柳瀬 美智子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Himari's grandmother entrusted Himari and me with running the lodge. However, it's difficult to attract guests this far out, and the building is falling into disrepair. And as time passes, it gradually takes more and more from us."},{"spoiler":false,"text":"Two vulnerable girls will be spending this summer working at the lodge. There's not much I can do for them except spend time with them. I want to help, but I'm powerless."},{"spoiler":false,"text":"I've experienced plenty of pain and hardships myself, yet strangely enough, I've never wanted to quit."},{"spoiler":false,"text":"At the end of the day, the guests' laughter and the girls' smiles are the push I need to keep going. I can't let this place disappear."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c132132"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a91c25e8705c5d2fa1b0910e79e07306438febf2c5a947ebecbcd9cc63e57fe8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4d3cc52d6fed7440db6f60a567dead290092755d009734752321f24feb87f43.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮寺 智子","creatorId":"vndb:s35178","sourcePersonId":"vndb:s35178","canonicalEntityId":"vndb:s35178","name":"宮寺 智子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95716","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1326","sourceCompanyId":"egs:brand:2849","canonicalEntityId":"vndb:p1326","name":"sprite","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:35433:2849","source":"egs"},{"companyId":"vndb:p1326","sourceCompanyId":"vndb:p1326","canonicalEntityId":"vndb:p1326","name":"sprite","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:122001:v46543","source":"vndb"},{"companyId":"vndb:p19498","sourceCompanyId":"vndb:p19498","canonicalEntityId":"vndb:p19498","name":"株式会社ライトウェイ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:122002:v46543","source":"vndb"},{"companyId":"vndb:p22302","sourceCompanyId":"vndb:p22302","canonicalEntityId":"vndb:p22302","name":"flowers.studio","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:122003:v46543","source":"vndb"},{"companyId":"vndb:p1326","sourceCompanyId":"vndb:p1326","canonicalEntityId":"vndb:p1326","name":"sprite","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:122022:v46543","source":"vndb"},{"companyId":"vndb:p19498","sourceCompanyId":"vndb:p19498","canonicalEntityId":"vndb:p19498","name":"株式会社ライトウェイ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:122023:v46543","source":"vndb"},{"companyId":"vndb:p22302","sourceCompanyId":"vndb:p22302","canonicalEntityId":"vndb:p22302","name":"flowers.studio","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:122024:v46543","source":"vndb"},{"companyId":"vndb:p1326","sourceCompanyId":"vndb:p1326","canonicalEntityId":"vndb:p1326","name":"sprite","roleCodes":["developer"],"identityStatus":"source-n