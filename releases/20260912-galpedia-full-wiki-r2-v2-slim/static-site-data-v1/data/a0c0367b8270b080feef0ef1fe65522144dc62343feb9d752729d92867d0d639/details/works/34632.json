,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_128241","characterName":"母","sourceIds":{"bangumi":[{"characterId":"128241","match":"source-roster","subjectId":"489834"}]},"originalCharacterName":"母","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f5398b20ece03f349df241cddc82db89faa2ed1bf4645a0a81a2b05dc6a6a41.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75848ee2fd06faf5f08246fcfb5cd28dde0da6671b3345e14473492e34d149a4.webp","width":110,"height":168,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_128242","characterName":"ユミル","sourceIds":{"bangumi":[{"characterId":"128242","match":"source-roster","subjectId":"489834"}]},"originalCharacterName":"ユミル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d413c7e35fec76b00bcf25f13d9bc3b6b049688e1e4245967bc8aca582500419.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a8bbc8ea5314250d7ce78bb14e04ac486ec9dac4dbba5ccb721bf0e9622cd27.webp","width":217,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_14274","characterName":"西塞尔","sourceIds":{"bangumi":[{"characterId":"14274","match":"source-roster","subjectId":"489834"}]},"originalCharacterName":"西塞尔","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"今晚被夺去生命与记忆的主人公。"},{"spoiler":false,"text":"死后获得了不可思议的“能力”，开始追查自己的死因。"},{"spoiler":false,"text":"因为失忆，对自己的过去一切都想不起来了。"},{"spoiler":false,"text":"主人公。一人称は「私」だが、一回だけ、「ボク」と言った事がある。町はずれのゴミ捨て場で何者かに殺された。死をきっかけに物体に「トリツク」、それを「アヤツル」という「死者のチカラ」を得た。一切の記憶を失っており、自らの「死」の真相を知るために「死者のチカラ」を駆使して奔走することになる。"}],"source":"bangumi","sourceCharacterId":"14274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdb367634e24ecafe27932b68323bf4da0824c9f674585cdda1cfd8e612b6046.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/159b952f33ee2f43aa32f923571afe35162cbba2e8840838ef9e72d0d4b5adb6.webp","width":172,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_14275","characterName":"Lynne","sourceIds":{"bangumi":[{"characterId":"14275","match":"source-roster","subjectId":"489834"}]},"originalCharacterName":"Lynne","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公死亡时也在现场的女刑警，似乎是很容易被卷入各种事件的类型。"},{"spoiler":false,"text":"シセルの死体を発見した女刑事。何かとトラブルに巻き込まれやすい体質らしい。シセルを発見した直後に狙撃者によって命を落としてしまうが、シセルの「死者のチカラ」で運命が変化する。見た目は細いがかなりの大食い。カノンとミサイルと同居している。"}],"source":"bangumi","sourceCharacterId":"14275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/743cf7758358a7614d5439eab01ea6bf4294a9d4140d0aa066fea5d8e1a5b193.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/412702ca4561360f8265729cc782cd88ee85c96ba0a8cf77c6d6caf6d562f519.webp","width":127,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_14276","characterName":"Kanon","sourceIds":{"bangumi":[{"characterId":"14276","match":"source-roster","subjectId":"489834"}]},"originalCharacterName":"Kanon","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"与琳奈住在一起的少女。"},{"spoiler":false,"text":"リンネと同居している少女。音楽を聴くこととドーナツが好き。留守番中にやってきた侵入者によって囚われの身となる。"}],"source":"bangumi","sourceCharacterId":"14276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fe59443b8e4a1aebbb852db1b137242519c4e516da21bf11e83e93c50a5e3b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07414aa3e554c70856dfb0be0ca4ba08925383b24b0321ec940c307f00ed329a.webp","width":148,"height":229,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_14277","characterName":"米赛璐","sourceIds":{"bangumi":[{"characterId":"14277","match":"source-roster","subjectId":"489834"}]},"originalCharacterName":"米赛璐","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"琳奈和卡农饲养的博美拉尼亚犬，以保护主人为己任。"},{"spoiler":false,"text":"リンネとカノンが飼っている2歳のポメラニアン。一生をかけて主人を守ることが「使命」であると考えている。何かあるとすぐに吠えつく癖がある。カノンとの留守番中にやってきた侵入者によって命を落とす。その後シセルに助けられ、部屋を出ていったカノンを守るために「道」を作ろうとがんばっている。巧舟氏の飼い犬がモデル。"}],"source":"bangumi","sourceCharacterId":"14277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b63b3cfc8b368dff941178c51c564bf2486b68f961813ac09f8175a74bf8970.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfb4fbd8d908878ba70dddf41a7fd2fccf958f97656e9764a3640323c3a4c382.webp","width":256,"height":239,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_14278","characterName":"Kuneri","sourceIds":{"bangumi":[{"characterId":"14278","match":"source-roster","subjectId":"489834"}]},"originalCharacterName":"Kuneri","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"附在电灯上的灵魂，传授给西塞路“死者之力”。"},{"spoiler":false,"text":"電気スタンドに宿る魂。ゴミ捨て場でシセルと出会った。シセルに「死者の力」について教える。自分のことについては明かそうとしない。クネクネするのが好き。"}],"source":"bangumi","sourceCharacterId":"14278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7afbee0743f0d192f62b470b0a39aa4bb45e08a736a3b271bd459c87af3f47e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecd717084e00dbdd54ec87184154ce227a2b9d667324cdf7c4f871d61d41291b.webp","width":166,"height":210,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p350","sourceCompanyId":"egs:brand:642","canonicalEntityId":"vndb:p350","name":"CAPCOM","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:34632:642","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
