db:s11945","name":"天海 向日葵","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:168613","source":"vndb"},{"creditedName":"あおきゅん","creatorId":"vndb:s11946","sourcePersonId":"vndb:s11946","canonicalEntityId":"vndb:s11946","name":"あおきゅん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:168614","source":"vndb"},{"creditedName":"ういんどみる","creatorId":"vndb:s11958","sourcePersonId":"vndb:s11958","canonicalEntityId":"vndb:s11958","name":"ういんどみる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:168615","source":"vndb"},{"creditedName":"cao.","creatorId":"vndb:s12910","sourcePersonId":"vndb:s12910","canonicalEntityId":"vndb:s12910","name":"cao.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:168616","source":"vndb"},{"creditedName":"まろたろ","creatorId":"vndb:s13626","sourcePersonId":"vndb:s13626","canonicalEntityId":"vndb:s13626","name":"まろたろ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:168618","source":"vndb"},{"creditedName":"まついさん","creatorId":"vndb:s22108","sourcePersonId":"vndb:s22108","canonicalEntityId":"vndb:s22108","name":"松井 章","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:168622","source":"vndb"}]},"cast":[{"characterId":"char_c92529","characterName":"御空 朔","sourceIds":{"bangumi":[{"characterId":"81273","match":"exact-normalized-name-in-linked-work","subjectId":"313882"}],"egsCharacterIds":["22914"],"vndbCharacterId":"c92529"},"originalCharacterName":"御空 朔","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A longtime childhood friend of the protagonist since before they can even remember."},{"spoiler":false,"text":"A very shy girl, she always covers her eyes with her bangs. Rarely does she express her own opinions, and oftentimes just go along with others. However, even if she doesn't express her thoughts in words, she is always ready to make any comebacks."},{"spoiler":false,"text":"When she's with Youichi, she is able to talk normally, and with a face full of emotions at that."},{"spoiler":false,"text":"\"Even if it's just for a little, I want to make memories with you, You-kun...\""},{"spoiler":false,"text":"Edited from Official Website"}],"source":"vndb","sourceCharacterId":"c92529"},{"segments":[{"spoiler":false,"text":"物心つく前からの幼馴染。"},{"spoiler":false,"text":"恥ずかしがり屋で、人見知りするため、いつも前髪で目を隠している。"},{"spoiler":false,"text":"あまり自分の意見を主張することはなく、相手に合わせる事が多い。"},{"spoiler":false,"text":"しかし、言葉にはしないだけで内心では色々ツッコミを入れたりしている。 仲良くなると普通に話せるようになるため、陽一と話している時は結構感情豊かである。"},{"spoiler":false,"text":"進学直前に父親の転勤が決まり、母親もサポートでついていくことになったため、陽一の母の厚意により、現在は彼の家で居候させてもらっている。"},{"spoiler":false,"text":"居候してからも二人の関係は変わらなかったが、明るくていつも自分を導いてくれる陽一への淡い気持ちは時間の流れとともに大きくなっていくことになる。"},{"spoiler":false,"text":"ただ、そんな陽一に大して自分では釣り合わないと考えていた朔は、一緒にいられるだけで満足だと、想いを伝えることはしなかった。"}],"source":"egs","sourceCharacterId":"22914","sourceWorkId":"29934","spoiler":false},{"segments":[{"spoiler":false,"text":"物心つく前からの幼馴染。"},{"spoiler":false,"text":"恥ずかしがり屋で、人見知りする性格のため、いつも前髪で目を隠している。あまり自分の意見を主張することはなく、相手に合わせる事が多い。"},{"spoiler":false,"text":"しかし、言葉にはしないだけで、内心ではツッコミを入れていたりしている。"},{"spoiler":false,"text":"仲良くなると普通に話せるようになるため、陽一と話している時は感情豊かである。"},{"spoiler":false,"text":"進学直前に父親の転勤が決まり、母親もサポートとしてついていくことになったため、陽一の母の厚意により、現在は彼の家で居候させてもらっている。"},{"spoiler":false,"text":"居候してからも二人の関係は変わらなかったが、明るくていつも自分を導いてくれる陽一への淡い気持ちは時間の流れとともに大きくなっていくことになる。ただ、そんな陽一に対して自分では釣り合わないと考えていた朔は、一緒に居られるだけで満足だと、想いを伝えることはしなかった。"}],"source":"bangumi","sourceCharacterId":"81273"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"22914","sourceWorkId":"29934","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"22914","sourceWorkId":"29934","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"22914","sourceWorkId":"29934","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"22914","sourceWorkId":"29934","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54074ecf993b50fe328dd28427ba64ab4d33547a275ef5c5e15a9e51a395d0a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cebcc136a4e6d1c3e07424ed5d792b3491f6b649a2f4d5bfad3c8bb3c6ae8f7.webp","width":69,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山田奈都美","creatorId":"vndb:s11904","sourcePersonId":"vndb:s11904","canonicalEntityId":"vndb:s11904","name":"山田 奈都美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:313882:81273:19457:1","source":"bangumi"}]},{"characterId":"char_vndb_c100145","characterName":"鴇崎 陽一","sourceIds":{"vndbCharacterId":"c100145"},"originalCharacterName":"鴇崎 陽一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4542","sourceCompanyId":"egs:brand:4340","canonicalEntityId":"vndb:p4542","name":"あ