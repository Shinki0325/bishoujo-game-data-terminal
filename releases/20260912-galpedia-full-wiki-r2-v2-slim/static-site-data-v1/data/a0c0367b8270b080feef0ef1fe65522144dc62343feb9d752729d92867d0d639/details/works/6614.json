native","relationId":"vndb:vn-staff:49521","source":"vndb"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"vndb:s720","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49522","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49523","source":"vndb"}]},"cast":[{"characterId":"char_c15870","characterName":"泉堂 真奈美","sourceIds":{"bangumi":[{"characterId":"92028","match":"exact-normalized-name-in-linked-work","subjectId":"266024"}],"egsCharacterIds":["26054"],"vndbCharacterId":"c15870"},"originalCharacterName":"泉堂 真奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sister of the protagonist. She is a physical education teacher at St. Celine's School."},{"spoiler":false,"text":"She is the advisor of the prestigious tennis club and once won the junior championship herself when she was a student. She is also an excellent teacher, and is popular among the students for her gentle appearance and kind personality."},{"spoiler":false,"text":"However, she is head over heels for the main character, and often goes berserk for him. She is competing with Kaede for his affection in a mature manner."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c15870"},{"segments":[{"spoiler":false,"text":"主人公の姉。"},{"spoiler":false,"text":"テニスの名門「聖セリーヌ学園」の体育教師にして、テニス部の顧問。"},{"spoiler":false,"text":"スタイルも抜群で美人、そんでもって優しく、生徒からの人気も高い。"},{"spoiler":false,"text":"極度のブラコン……というよりも弟を愛しちゃってます！"}],"source":"egs","sourceCharacterId":"26054","sourceWorkId":"6614","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の姉。聖セリーヌ学園の体育教師。"},{"spoiler":false,"text":"名門と名高いテニス部の顧問を務め、自身も学生の時はジュニア選手権で優勝したこともある。"},{"spoiler":false,"text":"教師としても結構優秀で、ほわんとした外見と優しい性格から生徒達に人気がある。"},{"spoiler":false,"text":"しかし、おもっきりなブラコン。主人公のこととなると我を忘れて暴走し、実に大人げなく女生徒(楓)と張り合ったりする。"}],"source":"bangumi","sourceCharacterId":"92028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6ae59b04c02bb57022c55a3c952acb88a2a35d44087237838d2b5ad41a8c4e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be08f6893b8e6fc356214def931008c0005e23ca32ceb82eb16796959f4a0b53.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266024:92028:4918:1","source":"bangumi"}]},{"characterId":"char_c15871","characterName":"向居堂 楓","sourceIds":{"bangumi":[{"characterId":"92029","match":"exact-normalized-name-in-linked-work","subjectId":"266024"}],"egsCharacterIds":["26055"],"vndbCharacterId":"c15871"},"originalCharacterName":"向居堂 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at St. Celine's School. She is the daughter of a large conglomerate, and is an extremely well-known young lady."},{"spoiler":false,"text":"She is the captain of the prestigious St. Celine's tennis club and a promising ace. She is also a proven competitor, and is considered a candidate to win the Inter-High School Championships."},{"spoiler":false,"text":"She has been told that she is a noble person and has never been treated as an equal by the people around her, so she has an ultra standoffish personality and is very stubborn. However, she is quite pure-hearted at heart. She is also a spoiled brat."},{"spoiler":false,"text":"She is attracted to the main character who talks to her as an equal even though she knows that she is the daughter of a big conglomerate."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c15871"},{"segments":[{"spoiler":false,"text":"「聖セリーヌ学園」のテニス部主将。"},{"spoiler":false,"text":"インターハイの優勝候補に挙げれるほどの実力の持ち主。"},{"spoiler":false,"text":"向居堂財閥の娘で、昔から庶民とは違うと躾けられていたことから、お嬢様然とした性格。"},{"spoiler":false,"text":"高飛車で素直じゃないが、根は純情で甘えん坊。"}],"source":"egs","sourceCharacterId":"26055","sourceWorkId":"6614","spoiler":false},{"segments":[{"spoiler":false,"text":"聖セリーヌ学園の生徒。大財閥の娘で超が付く程のお嬢様。"},{"spoiler":false,"text":"名門と名高い聖セリーヌ学園テニス部の主将で期待のエース。実力も折り紙付きでインターハイの優勝候補に挙げられる程の実力の持ち主。"},{"spoiler":false,"text":"自分は高貴な人間であると言い聞かされたうえ、周りの人達からは対等に扱われたことがないため、超タカビーな性格で意地っ張り。しかし根は結構純情。甘えんぼなところもある。"},{"spoiler":false,"text":"大財閥の娘と知った上でも自分と対等な立場で話をしてくる主人公に惹かれてしまう。"}],"source":"bangumi","sourceCharacterId":"92029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05ebbb88146fbcd275283e642f7c68069d1bb67eb28e6eeb94c0ebaa4db0b55a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d29f06fac79c11cfb2a048b60c2d279a02e5824ca28aad3029beb22153dda26b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266024:92029:6409:1","source":"bangumi"}]},{"characterId":"char_vndb_c15868","characterName":"野田 丸子","sourceIds":{"vndbCharacterId":"c15868"},"originalCharacterName":"野田 丸子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at St. Celine's Academy, she is Kaede's crony. She is always with Kaede and makes her happy."},{"spoiler":false,"text":"She is the one who has been feeding Kaede incorrect knowledge. She has the ability to appear out of nowhere."},{"spoiler":false,"text":"She has an older brother at Seifu Academy near St. Celine School."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c15868"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab11b8c4ee738228da412c2eb39152d574d0c02b4cfaa1ddb3d115d4ea742f68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b82c9bf74e5482993f7794594e1572a9c255aea0ac60c935aad6e7a620138fbf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渋谷 ひめ","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27454","source":"vndb"}]},{"characterId":"char_vndb_c15869","characterName":"泉堂 彰","sourceIds":{"vndbCharacterId":"c15869"},"originalCharacterName":"泉堂 彰","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main character. A former professional tennis player."},{"spoiler":false,"text":"Through the arrangement of his older sister Manami, he is called in as a temporary coach at St. Celine's Academy, a prestigious tennis school."},{"spoiler":false,"text":"Although he is not at all keen on the job, he reluctantly accepts the offer because Manami is pressing him and he has nowhere to live and no money to spend."},{"spoiler":false,"text":"However, he is quite anxious about it, as he has little experience teaching others and has not been on the court since he retired, much less working in a tennis-related job"},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c15869"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:1036","sourceCompanyId":"egs:brand:1036","canonicalEntityId":"egs:brand:1036","name":"LiLiTH","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:6614:1036","source":"egs"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:16836:v4385","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:16839:v4385","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:9918:v4385","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:9919:v4385","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
