":{"bangumi":[],"egsCharacterIds":["8919"],"vndbCharacterId":"c121149"},"originalCharacterName":"滝沢 庸介","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園の理事長を務める初老の男性。"},{"spoiler":false,"text":"大阪商人の血をひく銀行家であり、こてこての関西弁と恰幅のよい身体つきが特徴的。"},{"spoiler":false,"text":"フランクなおっさんという印象とは裏腹に、老獪な策士の一面を隠し持っている。"},{"spoiler":false,"text":"和彦は彼の一人息子。"}],"source":"egs","sourceCharacterId":"8919","sourceWorkId":"16709","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c121149","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"8919","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"8919","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97ef74b6fb63cf319f61b8ad8c49d43aabbdda5cc67128708c03720ccd0d2c5f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e18a3c5149e6ddfa81b4314bb7c91bea7ead29fb1d2ab0b6df718e31af92662c.webp","width":162,"height":215,"source":"static-detail"},"actors":[{"creditedName":"氷室 省吾","creatorId":"vndb:s11408","sourcePersonId":"vndb:s11408","canonicalEntityId":"vndb:s11408","name":"氷室省吾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45582","source":"vndb"}]},{"characterId":"char_c6835","characterName":"渚坂 白亜","sourceIds":{"bangumi":[{"characterId":"65599","match":"exact-normalized-name-in-linked-work","subjectId":"34254"}],"egsCharacterIds":["8913"],"vndbCharacterId":"c6835"},"originalCharacterName":"渚坂 白亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【特区ファンドを統べる天才少女】"},{"spoiler":false,"text":"本作の正ヒロイン。"},{"spoiler":false,"text":"作品の舞台となる「経済特区」最強のファンドを率いる天才少女。"},{"spoiler":false,"text":"主人公より年齢・社会的地位は上。主人公にとって常に一歩先を行く存在。"},{"spoiler":false,"text":"ビジネスにおいては並み居る経営者を前にしても毅然と振る舞う。"},{"spoiler":false,"text":"まるで実の姉のような態度で接してくるが、クールでぶっきらぼうな裏の顔も持つ。"}],"source":"egs","sourceCharacterId":"8913","sourceWorkId":"16709","spoiler":false},{"segments":[{"spoiler":false,"text":"経済特区最大のファンドを率いる天才少女。"},{"spoiler":false,"text":"ビジネスの世界においては、並みいる経営者を前にしても毅然とふるまうが、律也に対してはまるで姉のような態度で接してくる。"},{"spoiler":false,"text":"幼なじみとはいえ、今では律也の一歩先を行く存在であり、他の仲間たちとも疎遠になっている。"},{"spoiler":false,"text":"「律也なら私に並び立てる。そう信じてるのに――」"}],"source":"bangumi","sourceCharacterId":"65599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1272955b19c29a142e25925fd154da27f0847419e11025f29c9de0bf8609139f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/069f7d71aac24793fea29887d0bc995e7e237226dcd9d590e2fb1a9270094183.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:34254:65599:10026:1","source":"bangumi"}]},{"characterId":"char_c6836","characterName":"若草 つぐみ","sourceIds":{"bangumi":[{"characterId":"65600","match":"exact-normalized-name-in-linked-work","subjectId":"34254"}],"egsCharacterIds":["8914"],"vndbCharacterId":"c6836"},"originalCharacterName":"若草 つぐみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【思い出を守り続ける今川焼き屋】"},{"spoiler":false,"text":"メインヒロイン。「経済特区」で今川焼き屋を経営する少女。"},{"spoiler":false,"text":"主要キャラの多くが幼馴染である本作のなかでも、もっとも「幼馴染度」の高い女の子。"},{"spoiler":false,"text":"マイペースでおっとりした、いわゆる天然キャラ。"},{"spoiler":false,"text":"主人公とのかけあい漫才もそつなくこなすが、自分の考えを簡単に曲げない頑固さも。"},{"spoiler":false,"text":"そのあたりは祖父の男手ひとつで育てられたことが影響しているようだ。"}],"source":"egs","sourceCharacterId":"8914","sourceWorkId":"16709","spoiler":false},{"segments":[{"spoiler":false,"text":"経済特区で今川焼き屋を経営する少女。"},{"spoiler":false,"text":"今も昔もマイペースでおっとりした天然素材の女の子で、特区に帰ってきた律也にとって子供時代を思い出させてくれる存在。"},{"spoiler":false,"text":"また、自分の考えを簡単に曲げない頑固さも持っている。"},{"spoiler":false,"text":"そのあたりは祖父に男手ひとつで育てられたことも影響しているようだ。"},{"spoiler":false,"text":"「大人になっても思い出が大切なのは変わらないでしょ？」"}],"source":"bangumi","sourceCharacterId":"65600"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/129941c0e71a19787c4c9d88530ffb855ecb09d53865f745e1706dcacba30110.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6561e2cca3eb1abbcf6da6ea1a1f67d91ec94711158c4a44239f43afd7030f9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真中桂子","creatorId":"vndb:s4378","sourcePersonId":"vndb:s4378","canonicalEntityId":"vndb:s4378","name":"真中 桂子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:34254:65600:5205:1","source":"bangumi"}]},{"characterId":"char_c6837","characterName":"早乙女 凪","sourceIds":{"bangumi":[{"characterId":"65601","match":"exact-normalized-name-in-linked-work","subjectId":"34254"}],"egsCharacterIds":["8915"],"vndbCharacterId":"c6837"},"originalCharacterName":"早乙女 凪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【一匹狼の高利貸し】"},{"spoiler":false,"text":"メインヒロイン。"},{"spoiler":false,"text":"幼なじみ仲間のなかで、かつては一匹狼的なアウトローだった少女。"},{"spoiler":false,"text":"進学したビジネス学校をドロップアウトして始めた貸金業で大成功を収め、莫大な資産を手にした。"},{"spoiler":false,"text":"表向きは街のごろつきを束ね、あこぎな高利貸しで蓄財した守銭奴キャラだが、じつはある目的のために金を稼いでいたことがやがて明らかになる。"}],"source":"egs","sourceCharacterId":"8915","sourceWorkId":"16709","spoiler":false},{"segments":[{"spoiler":false,"text":"律也たち幼なじみ仲間のなかで、一匹狼的なアウトローだった少女。"},{"spoiler":false,"text":"学園をドロップアウトして始めた貸金業で大成功を収め、莫大な資金を手にした。"},{"spoiler":false,"text":"街のゴロツキを束ね、あこぎな高利貸しで蓄財した守銭奴。"},{"spoiler":false,"text":"3年前、律也が自分たちを残して去ったことを根に持っており、ことあるごとに突っかかってくる。"},{"spoiler":false,"text":"「律也、お前は嫌いだがビジネスなら話は別だ。オレが必要なんだろ？」"}],"source":"bangumi","sourceCharacterId":"65601"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c68c215ed62d418431492ca88661483e4faf115b206b92a71462534741b48a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1dd99018110e335e074042e17f995a42900fa0c6f91cd866136b30bfbab5c1f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:34254:65601:10027:1","source":"bangumi"}]},{"characterId":"char_c6839","characterName":"綴 カナタ","sourceIds":{"bangumi":[{"characterId":"65603","match":"exact-normalized-name-in-linked-work","subjectId":"34254"}],"egsCharacterIds":["8917"],"vndbCharacterId":"c6839"},"originalCharacterName":"綴 カナタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Applying the Otoko no Ko patch will turn Kanata into a male."}],"source":"vndb","sourceCharacterId":"c6839"},{"segments":[{"spoiler":false,"text":"経済特区に戻ってきたばかりの律也が雇うことになる秘書。"},{"spoiler":false,"text":"仕事ぶりは有能だがマイペースで、空気を読まない天然発言が多い。"},{"spoiler":false,"text":"律也には男だというふれこみで紹介され、本人もそう強く主張している、が実際は……？"}],"source":"egs","sourceCharacterId":"8917","sourceWorkId":"16709","spoiler":false},{"segments":[{"spoiler":false,"text":"経済特区に戻ってきたばかりの律也が雇うことになる秘書。"},{"spoiler":false,"text":"仕事ぶりは有能だがマイペースで、空気を読まない天然発言が多い。"},{"spoiler":false,"text":"律也には男だというふれこみで紹介され、本人も強くそう主張している、が実際は……？"},{"spoiler":false,"text":"「ご奉仕メイドに劣らぬ忠実なしもべとして律也さんに尽くしますよ！」"}],"source":"bangumi","sourceCharacterId":"65603"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"f","source":"vndb","sourceCharacterId":"c6839","value":"f"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"8917","value":"男性"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"8917","value":"男性"},{"source":"bangumi","sourceCharacterId":"65603","value":"女（有男の娘パッチ）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b29a122be172e0a3e223b4098d90d2c05d3794ec7762be88b07fdd6086e72da2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44b041f06a56958e9b0d8bfc354425ccb98f253757cc8d04c8f2357c8bdb76d5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藍川珪","creatorId":"vndb:s872","sourcePersonId":"vndb:s872","canonicalEntityId":"vndb:s872","name":"藍川珪","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:34254:65603:14421:1","source":"bangumi"}]},{"characterId":"char_vndb_c121146","characterName":"結城 律也","sourceIds":{"vndbCharacterId":"c121146"},"originalCharacterName":"結城 律也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandi