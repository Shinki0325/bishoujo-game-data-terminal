,"name":"星リルカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85038","source":"vndb"}]},{"characterId":"char_vndb_c102758","characterName":"淡雪 麻衣子","sourceIds":{"vndbCharacterId":"c102758"},"originalCharacterName":"淡雪 麻衣子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"広深 香菜","creatorId":"vndb:s5646","sourcePersonId":"vndb:s5646","canonicalEntityId":"vndb:s5646","name":"広深 香菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85043","source":"vndb"}]},{"characterId":"char_vndb_c102759","characterName":"朱鷺野","sourceIds":{"vndbCharacterId":"c102759"},"originalCharacterName":"朱鷺野","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"花寺 香蓮","creatorId":"vndb:s4474","sourcePersonId":"vndb:s4474","canonicalEntityId":"vndb:s4474","name":"平野 有紗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85042","source":"vndb"}]},{"characterId":"char_vndb_c102760","characterName":"砂原","sourceIds":{"vndbCharacterId":"c102760"},"originalCharacterName":"砂原","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"蒼樹 勇人","creatorId":"vndb:s12663","sourcePersonId":"vndb:s12663","canonicalEntityId":"vndb:s12663","name":"西森 千豊","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85045","source":"vndb"}]},{"characterId":"char_vndb_c102762","characterName":"タマ","sourceIds":{"vndbCharacterId":"c102762"},"originalCharacterName":"タマ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b925dec366b823797bc47694064be4a40d4ae59f8b32315553f3a260c69daeb8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd2a068a102f6f32f97005eda66fdeee45c9e00efe4bf35171afd5f300aa762f.webp","width":218,"height":124,"source":"static-detail"},"actors":[{"creditedName":"七凪 るとろ","creatorId":"vndb:s13959","sourcePersonId":"vndb:s13959","canonicalEntityId":"vndb:s13959","name":"七凪るとろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85046","source":"vndb"}]},{"characterId":"char_vndb_c92093","characterName":"風見 蒼空","sourceIds":{"vndbCharacterId":"c92093"},"originalCharacterName":"風見 蒼空","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sora works at Saika Girls' School as a temporary school nurse and counselor. Despite his lack of certification, he is a skilled medical professional."},{"spoiler":false,"text":"Besides the health expertise, Sora has solid spiritual senses; he can detect the presence of souls. Relying on these visions, he travels as an Okuribito* to send souls to the afterlife."},{"spoiler":false,"text":"Unfortunately, he has a terrible sense of direction and gets lost easily."},{"spoiler":false,"text":"Sora belongs to a school of Okuribito called Mutori and is the master of Kotodama (spirits language)."},{"spoiler":false,"text":"*Okuribito (送り人; lit. sender) is a title for those whose profession is to send souls back to the afterlife."},{"spoiler":false,"text":"The existence of Okuribito is unknown to the general public. They are, however, considered to be national civil servants."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c92093"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24adaa61521d72a60a33244e9de8048de6344dda632410a59c3cb46e835ae1f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/195f5f82e69670bb895eda2f2dd57f671914abb24923daeb2c90a804a21cae17.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92094","characterName":"シロバナ","sourceIds":{"vndbCharacterId":"c92094"},"originalCharacterName":"シロバナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"71"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sora's confidant and assistant in the school infirmary."},{"spoiler":false,"text":"Shirobana is a complex blend of whimsy, jealousy, and a sharp tongue. Nonetheless, she is a sweet girl at heart."},{"spoiler":false,"text":"Though deeply fond of Sora, Shirobana tries hard not to show it."},{"spoiler":false,"text":"She often resorts to blowing soap bubbles when emotionally cornered as a distraction."},{"spoiler":false,"text":"Shirobana is not just an ordinary girl; she is a Tamabito, a spiritual being who can wield mysterious powers known as \"Kiseki\" (miracle). To perform these miracles, certain offerings must be presented beforehand. With this power, she stands as a bulwark to protect Sora, particularly against threats from other Tamabito or Okuribito."},{"spoiler":false,"text":"\"Alright, chill out. I'll cool down that hot head of yours with my wind.\""},{"spoiler":false,"text":"\"I'm not the lost one here. Sora's the one who wandered off, so it's his fault.\""},{"spoiler":false,"text":"\"But... when you meet up with your sister, think you can send her off?\""},{"spoiler":false,"text":"(Translated from the official website )"}],"source":"vndb","sourceCharacterId":"c92094"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c664e4d20113b7c01bb2e1b7402182b537f0a13bcee785603edb0de6321a523.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/2623981746d1db1716fca8885bc6e552876dd54a9d42ada075112308890878e5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真宮 ゆず","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85039","source":"vndb"}]},{"characterId":"char_vndb_c92095","characterName":"此花 ゆか","sourceIds":{"vndbCharacterId":"c92095"},"originalCharacterName":"此花 ゆか","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student at Saika Girls' Academy."},{"spoiler":false,"text":"Yuka is Nana's classmate, and both live in the same dormitory."},{"spoiler":false,"text":"She has a sunny disposition and usually smiles, even when upset."},{"spoiler":true,"text":"Her real name is Kazami Yuka (風見 夢歌), the deceased older sister of Kazami Sora."},{"spoiler":true,"text":"She once lived as a Tamabito, but now she is happily departed to the afterlife with the aid of her brother."},{"spoiler":true,"text":"Yuka occasionally appears at Sora's bedside and in his dreams while he sleeps."},{"spoiler":true,"text":"Sora, on the other hand, does not always remember the encounter when he wakes up the next day."}],"source":"vndb","sourceCharacterId":"c92095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db8f39b674df95b0aab89c6c8241bb58b43d7336fc2a84d59db531e184c174bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eded8d40750411e309c5d729bbd4a2629cd1ed41b941a349bba198cc1312e46.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杏 花","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85034","source":"vndb"}]},{"characterId":"char_vndb_c92096","characterName":"月森 鈴","sourceIds":{"vndbCharacterId":"c92096"},"originalCharacterName":"月森 鈴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"H"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rin is a third-year student at Saika Girls' Academy and the daughter of the school's headmaster. She has a playful personality, a passion for cute things, a keen sense of smell, and a deep knowledge of perfumes and aromas. She enjoys soaking in the natural scent of hot springs at the inn where Sora stays."},{"spoiler":false,"text":"Rin holds the position of student council president but doesn't take her role too seriously. Despite this, she is a dependable and trusted figure for her peers during difficult times."},{"spoiler":false,"text":"Rin often skips classes and falls asleep in the infirmary. She has been dealing with nightmares recently but hides her troubles and puts on a brave face for Sora."},{"spoiler":false,"text":"\"Cute, cute, cute! Take-home material!\""},{"spoiler":false,"text":"\"Just call me 'Tsukimorin' as a cute nickname, okay♪.\""},{"spoiler":false,"text":"\"You have a talent for being naughty, don't you, Sensei?\""},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c92096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eac8fa009411a94ef6ce461bcfbf6d0b9f8297125b80a140833985654cc8fe1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bf24e68f44d6e317fa72d5e7ad4596aed6260ab9d7a8606f69f5c30a204df52.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃山 いおん","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85036","source":"vndb"}]},{"characterId":"char_vndb_c92097","characterName":"淡雪 咲羽","sourceIds":{"vndbCharacterId":"c92097"},"originalCharacterName":"淡雪 咲羽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A sophomore at Saika Girls' Academy."},{"spoiler":false,"text":"She also serves as a housemaid at the \"Shikisai Home\" inn with her twin sister Mizumi."},{"spoiler":false,"text":"Sakiha's calm, reserved demeanor and emotionless tone can create the impression of being cold and inapproachable, particularly when interacting with guests like Sora. However, beneath the surface lies a kind, caring individual who takes her responsibilities seriously."},{"spoiler":false,"text":"As a member of the school's health committee, Sakiha is always ready to offer help and support to her fellow students. Her caring nature extends beyond the school grounds, as she also looks after Sora in the school infirmary like she does at the inn."},{"spoiler":false,"text":"\"I serve as your caretaker, Sensei. It's imperative that you comprehend this.\""},{"spoiler":false,"text":"\"You generally exhibit lax behavior in your personal affairs, Sensei. You contemplate skipping breakfast, neglect laundering your lab coat, and embark on nighttime outings without my permission... the list goes on.\""},{"spoiler":false,"text":"\"Don't set such actions as your goals... fool.\""},{"spoiler":false,"text":"Edited from the official website"}],"source":"vndb","sourceCharacterId":"c92097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad521dfcf6f47fb915a8bc27f99be6eb9780dc7fbe4619c1738344f101cc82da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/526b7dd2d62d2d1900f382a4308bb88dbb49bf95b93c0d21b484f9f7df517bf0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五行 なずな","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85032","source":"vndb"}]},{"characterId":"char_vndb_c92098","characterName":"淡雪 瑞海","sourceIds":{"vndbCharacterId":"c92098"},"originalCharacterName":"淡雪 瑞海","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year Saika Girls' Academy student, Mizumi also serves as a waitress at the 'Shikisai Home' Inn, where she works with her twin sister, Sakiha."},{"spoiler":false,"text":"She embodies the role of a comforting presence, characterized by her unwavering dedication and kindness."},{"spoiler":false,"text":"Despite Mizumi's nurturing nature, she carries an air of fragility due to her poor health."},{"spoiler":false,"text":"Her commitment to her duties at the inn is so intense that she often exhausts herself to the point of collapse. This very vulnerability occasionally leads Sora to see her in light of his late sister."},{"spoiler":false,"text":"\"Pardon the intrusion while you're relaxing; I've brought dinner.\""},{"spoiler":false,"text":"\"It's the first time a man has... treated me this way.\""},{"spoiler":false,"text":"\"Kazami-sensei, if I were to describe you in terms of family, you'd be like an older brother.\""}],"source":"vndb","sourceCharacterId":"c92098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26d42e09eebdd51bab1d8166948d2e206ef46b033d61329cc0539a9fe3b1b876.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0a3198281de51f9d48cdba3d6759c1984aaa9961dc31952441180d15f0f4326.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲野 かなで","creatorId":"vndb:s1646","sourcePersonId":"vndb:s1646","canonicalEntityId":"vndb:s1646","name":"又吉 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85041","source":"vndb"}]},{"characterId":"char_vndb_c92099","characterName":"響 七菜","sourceIds":{"vndbCharacterId":"c92099"},"originalCharacterName":"響 七菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student at Saika Girls' School. Yuka and Nana are classmates and live in the same dormitory."},{"spoiler":false,"text":"Nana is a bright and energetic person who is always lively and cheerful. Despite her unlucky and unhappy nature, she never gives up and always wears a bright smile. In reality, however, Nana is lonely and loves to be spoiled."},{"spoiler":false,"text":"She always carries an exorcism stick around her waist. When upset, she may swing the exorcism stick and shout to drive away evil spirits."}],"source":"vndb","sourceCharacterId":"c92099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23ee0784075e50a40bb8c4b4709da2dd0e7e2af2e4b60d59f6053931f466b986.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fae6196f0f2b848e85d287040235209a2002e82df74b95c36024bac0c2c3b8fe.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御柴 いすき","creatorId":"vndb:s23698","sourcePersonId":"vndb:s23698","canonicalEntityId":"vndb:s23698","name":"御柴 いすき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85047","source":"vndb"}]},{"characterId":"char_vndb_c92100","characterName":"オトヒメ","sourceIds":{"vndbCharacterId":"c92100"},"originalCharacterName":"オトヒメ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"140"},"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Otohime, the gothic-lolita-clad doctor of Saika Girls' School, is currently lodging at the same hot spring inn as Sora. As a part of her peculiar offering for performing \"Kiseki\" (miracles), it is rumored that Otohime does not wear bras or panties."},{"spoiler":false,"text":"Her mature speech and behavior often give the impression of sarcasm, resulting in frequent quarrels with Shirobana. Nonetheless, people hold her in high esteem due to her sharp wit and sound advice."},{"spoiler":false,"text":"Otohime is regarded as a Tamabito, a ghostly being, by those around her. However, she is actually a half-breed between a human and a Tamabito. Born in the Meiji era, she has lived for 140 years, and after such an extreme lifespan, her true origins remain a mystery, known only to herself."},{"spoiler":false,"text":"Edited from the official website"}],"source":"vndb","sourceCharacterId":"c92100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43ddc94853815305207c6c91fc4de453aab7de35278c5e219ce008b69ecc91a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e82501a482ba44d6092fcec4a2c4f5c9631b64ed09f86383a209ea48ee317f06.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"卯衣","creatorId":"vndb:s1178","sourcePersonId":"vndb:s1178","canonicalEntityId":"vndb:s1178","name":"大橋 歩夕","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85035","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:5927","sourceCompanyId":"egs:brand:5927","canonicalEntityId":"egs:brand:5927","name":"Citrus","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29743:5927","source":"egs"},{"companyId":"vndb:p12055","sourceCompanyId":"vndb:p12055","canonicalEntityId":"vndb:p12055","name":"Tsukishiro","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-produc