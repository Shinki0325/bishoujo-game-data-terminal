's Oracle」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:228137","source":"egs"},{"creditedName":"ななひら","creatorId":"vndb:s20399","sourcePersonId":"egs:creator:21636","canonicalEntityId":"vndb:s20399","name":"ななひら","detail":"ED曲「STARRY DAYS」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:228786","source":"egs"},{"creditedName":"Takafumi Sakagami","creatorId":"vndb:s16652","sourcePersonId":"vndb:s16652","canonicalEntityId":"vndb:s16652","name":"Takafumi Sakagami","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:167320","source":"vndb"},{"creditedName":"Takafumi Sakagami","creatorId":"vndb:s16652","sourcePersonId":"vndb:s16652","canonicalEntityId":"vndb:s16652","name":"Takafumi Sakagami","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:167321","source":"vndb"},{"creditedName":"Tsukishiro","creatorId":"vndb:s31176","sourcePersonId":"vndb:s31176","canonicalEntityId":"vndb:s31176","name":"Tsukishiro","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:167322","source":"vndb"},{"creditedName":"Tsukishiro","creatorId":"vndb:s31176","sourcePersonId":"vndb:s31176","canonicalEntityId":"vndb:s31176","name":"Tsukishiro","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:167323","source":"vndb"},{"creditedName":"佐咲 紗花","creatorId":"vndb:s396","sourcePersonId":"vndb:s396","canonicalEntityId":"vndb:s396","name":"佐咲 紗花","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:167324","source":"vndb"},{"creditedName":"西又 葵","creatorId":"vndb:s1522","sourcePersonId":"vndb:s1522","canonicalEntityId":"vndb:s1522","name":"西又 葵","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:167325","source":