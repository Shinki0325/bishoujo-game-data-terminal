,"identityStatus":"source-native","relationId":"vndb:vn-staff:75665","source":"vndb"},{"creditedName":"一般市民","creatorId":"vndb:s44007","sourcePersonId":"vndb:s44007","canonicalEntityId":"vndb:s44007","name":"一般市民","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:75666","source":"vndb"}]},"cast":[{"characterId":"char_c37970","characterName":"金谷 美鈴","sourceIds":{"bangumi":[{"characterId":"193075","match":"exact-normalized-name-in-linked-work","subjectId":"269987"}],"egsCharacterIds":["26023"],"vndbCharacterId":"c37970"},"originalCharacterName":"金谷 美鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"宇津呂家の館で働くメイド。"},{"spoiler":false,"text":"普段は、澄ました感じで言葉もそっけなく、事務的にテキパキと仕事をこなす。"},{"spoiler":false,"text":"親しくなってくると、彼女の持つ本来の姿がそこかしこに見えてくる。"},{"spoiler":false,"text":"両親を亡くし、天涯孤独となった彼女に優しく手を差し伸べてくれたのが、彼女の両親と交流のあった静香。"},{"spoiler":false,"text":"自分の居場所と、メイドという仕事を与えてくれた静香とは主従の絆でしっかり結ばれている。"}],"source":"egs","sourceCharacterId":"26023","sourceWorkId":"6651","spoiler":false},{"segments":[{"spoiler":false,"text":"宇津呂家の館で働くメイド。"},{"spoiler":false,"text":"仕事はしっかりこなす働き者。しかし、物事に対してすました顔をしている。内面は奥様である静香の影響を受けて優しいが、外面はすました顔をして、言葉もそっけないものがある。優しくするというよりは、メイドとして接してくれる感じ。宇津呂家で働くきっかけになったのは、亡くなった両親が宇津呂家のお世話になっていたため。身よりがなく途方にくれていた美鈴に、奥様はメイドという仕事と居場所を与えてくれた。セレナや奥様に対しては、メイドらしくしっかり主従と立場の違いをわきまえて接する。"}],"source":"bangumi","sourceCharacterId":"193075"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3ec721f69c7355ba237b8dc6e45efe783df224f04c98e98a99589e355aa4f86.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d4aef3834fe53b7a12069779b44eb0a6d2f4e87f914d6c669c7d990cabc3687.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269987:193075:6045:1","source":"bangumi"}]},{"characterId":"char_c37971","characterName":"大藪 セレナ","sourceIds":{"bangumi":[{"characterId":"193076","match":"exact-normalized-name-in-linked-work","subjectId":"269987"}],"egsCharacterIds":["26024"],"vndbCharacterId":"c37971"},"originalCharacterName":"大藪 セレナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"宇津呂家で家庭教師をしている女性。"},{"spoiler":false,"text":"大学院を主席で卒業したほどの英才ではあるが、のんびり働きたいという理由から宇津呂家にやってきた。"},{"spoiler":false,"text":"穏やかで優しい性格ではあるが、その優しさをどこか計算して演じているきらいがある。"}],"source":"egs","sourceCharacterId":"26024","sourceWorkId":"6651","spoiler":false},{"segments":[{"spoiler":false,"text":"今は海外留学で館を留守にしている祐平坊ちゃんの家庭教師。"},{"spoiler":false,"text":"内面的には奥様である静香の影響を受けて穏やかだが、生来の成熟したボディにものを言わせて、淫靡に優しさを伝えてくる。甘えているような雰囲気さえある。優しさを持っているが、その優しさを理詰めで計算するタイプ。"},{"spoiler":false,"text":"有名大学院をトップの成績で卒業し、キャリアウーマンの道を進んでいたが、せかせか働くよりもゆっくり働きたいという希望で宇津呂家に来た。"},{"spoiler":false,"text":"美鈴との関係は、セレナのほうが少しうるさい小姑という感じである。"}],"source":"bangumi","sourceCharacterId":"193076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ab1b7c585d5aa437b1de401565b2ae63cebea69ea76e272850ff0d7161c5d9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b90a35d1650367d616335853520250403c3b8323c2ea26ea149a1c1016f3398.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269987:193076:6038:1","source":"bangumi"}]},{"characterId":"char_vndb_c53791","characterName":"毒島 音露","sourceIds":{"vndbCharacterId":"c53791"},"originalCharacterName":"毒島 音露","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83a9982bb3e8477d7cf09b3961a759383caaddf4ea80b8bf99df0a4cf549d6b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb452c382035d265a3f22d6295285c3dad39d976c955393d9822ca367269f823.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p341","sourceCompanyId":"egs:brand:334","canonicalEntityId":"vndb:p341","name":"Waffle","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6651:334","source":"egs"},{"companyId":"vndb:p187","sourceCompanyId":"vndb:p187","canonicalEntityId":"vndb:p187","name":"アイチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:153608:v8078","source":"vndb"},{"companyId":"vndb:p7538","sourceCompanyId":"vndb:p7538","canonicalEntityId":"vndb:p7538","name":"GAOH","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:153609:v8078","source":"vndb"},{"companyId":"vndb:p341","sourceCompanyId":"vndb:p341","canonicalEntityId":"vndb:p341","name":"Waffle","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:19257:v8078","source":"vndb"},{"companyId":"vndb:p341","sourceCompanyId":"vndb:p341","canonicalEntityId":"vndb:p341","name":"Waffle","roleC