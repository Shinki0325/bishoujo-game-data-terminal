d":"25174","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"94320","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3985c647884333b7d29172b8ccddec87d5daaecd1f8ce0730c2dc8b9f25fb6c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37f4b7cb9c94e3243cae94455e87c780a030cecc79b322c4e7e4e3bcd961c0bc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266094:94320:13512:1","source":"bangumi"}]},{"characterId":"char_c29109","characterName":"ローゼ ブライテンライトナー","sourceIds":{"bangumi":[{"characterId":"94321","match":"exact-normalized-name-in-linked-work","subjectId":"266094"}],"egsCharacterIds":["25175"],"vndbCharacterId":"c29109"},"originalCharacterName":"ローゼ ブライテンライトナー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ミエルの従者。"},{"spoiler":false,"text":"元来、知略に長けた参謀タイプであることから、長槍の名手ではあるものの、ミエルらよりも武勇は劣る。"},{"spoiler":false,"text":"青い甲冑を纏っていることから「青騎士」と恐れられている。"},{"spoiler":false,"text":"自分よりも年若いミエルやマリーのお姉さん的な存在で、良き理解者。"},{"spoiler":false,"text":"ザクセンの名門騎士団・聖鋼騎士団団長であるボルト・ブライテンライトナーの妻。"},{"spoiler":false,"text":"その夫とはおしどり夫婦として知られ、ミエルらから茶化されることもしばしば。"}],"source":"egs","sourceCharacterId":"25175","sourceWorkId":"7936","spoiler":false},{"segments":[{"spoiler":false,"text":"ミエルの従者。長槍の名手。戦闘においてはミエルやマリーより劣るが、知略に長けた参謀タイプでもある。青い甲冑を纏っていることから「青騎士」と恐れられている。"},{"spoiler":false,"text":"ザクセンの名門騎士団、聖鋼騎士団団長、ボルト・ブライテンライトナーの妻。夫とは、おしどり夫婦で知られている。"},{"spoiler":false,"text":"若いミエルやマリーに助言する優しいお姉さんといった感じ。"}],"source":"bangumi","sourceCharacter