{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"38152","model":{"presentationWorkId":"egs:38152","staff":{"artwork":[],"scenario":[{"creditedName":"山本尚基","creatorId":"egs:creator:41689","sourcePersonId":"egs:creator:41689","canonicalEntityId":"egs:creator:41689","name":"山本尚基","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:290949","source":"egs"}],"music":[{"creditedName":"桜庭統","creatorId":"egs:creator:41690","sourcePersonId":"egs:creator:41690","canonicalEntityId":"egs:creator:41690","name":"桜庭統","roleCode":"music","roleLabel":"作品音乐","identityStatus":"alias-only-review","relationId":"egs:work-creator:290950","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_101092","characterName":"時を司る大精霊","sourceIds":{"bangumi":[{"characterId":"101092","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"時を司る大精霊","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オリジン、マクスウェルとともに「原初の三霊」と称される強力な大精霊。"},{"spoiler":false,"text":"その実態は謎に包まれているが、伝説では「カナンの地の番人」と呼ばれている。"},{"spoiler":false,"text":"分史世界の誕生に関わっており、クルスニクの一族とは浅からぬ因縁をもっているらしい。"}],"source":"bangumi","sourceCharacterId":"101092"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa9d6cac729998e1e0bb268d538463f3f9098df758af0506805daa8749c174d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e07d4787769c67fd44bac2551a1420f0c337a41bd6bf014ab9b3e88fa81b98a6.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:101092:3864:1","source":"bangumi"}]},{"characterId":"char_bangumi_18737","characterName":"Jude Mathis","sourceIds":{"bangumi":[{"characterId":"18737","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Jude Mathis","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"15"},"height":{"reviewState":"source-only","source":"bangumi","value":"163"}},"descriptions":[{"segments":[{"spoiler":false,"text":"为了成为医师，在非常年幼的时候就离开了故乡进入王都伊尔·芬医学院学习，过着忙碌充实的平静生活。不过有一天，这里接待了一名由于精灵术施展失败而受伤的病人，渐渐的这样的病人多了起来，看起来精灵们的情况有些怪异，为了去向教授问询情况，裘德前往了军队的研究所。"}],"source":"bangumi","sourceCharacterId":"18737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c41563117ce1eaa5eb18b8c2e5c8e0a6baffda5b62ad5950e491a71e25fc3669.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cddc2decb34b2291dd8873c606cc3d86f003d69926d12cb74098ef1af0bba491.webp","width":152,"height":256,"source":"static-detail"},"actors":[{"creditedName":"代永翼","creatorId":"vndb:s291","sourcePersonId":"vndb:s291","canonicalEntityId":"vndb:s291","name":"代永 翼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:18737:4874:1","source":"bangumi"}]},{"characterId":"char_bangumi_18738","characterName":"Milla Maxwell","sourceIds":{"bangumi":[{"characterId":"18738","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Milla Maxwell","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"20"},"height":{"reviewState":"source-only","source":"bangumi","value":"168"}},"descriptions":[{"segments":[{"spoiler":false,"text":"掌管地水火风四大精灵、自称麦斯维尔精灵主的神秘女性。栖 身于山中神社关注着人间动向的她，突然感知到王都伊尔·芬周边大"},{"spoiler":false,"text":"量精灵被杀死的情况。米拉做出了人类和精灵都面临巨大灾难的判断"},{"spoiler":false,"text":"，但是为了确认真伪，她前往王都伊尔·芬、侵入了可能的根源——"},{"spoiler":false,"text":"军队研究所。在那里，她遇到了一位少年。"}],"source":"bangumi","sourceCharacterId":"18738"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d33b5c1b37703df3afd8d9a4637153d667abc024f73f12662ef724f735ca102.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0602e2240bd3987295e766cade74efe2fe34bce933a256c9e8352ddb6650929.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:18738:4244:1","source":"bangumi"}]},{"characterId":"char_bangumi_26392","characterName":"Leia Rolando","sourceIds":{"bangumi":[{"characterId":"26392","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Leia Rolando","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"15"},"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/924d5f3bd4e3ca86fba4f37cc630689cff245ab3f7583b67ebcb3991724d9108.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22e88b4646a4f51810070b5a6ca97e02127c7d2d63b778b00a7b3cfc4f46456a.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早見沙織","creatorId":"vndb:s1871","sourcePersonId":"vndb:s1871","canonicalEntityId":"vndb:s1871","name":"早見 沙織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:26392:4895:1","source":"bangumi"}]},{"characterId":"char_bangumi_26413","characterName":"アルフレド・ヴィント・スヴェント","sourceIds":{"bangumi":[{"characterId":"26413","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"アルフレド・ヴィント・スヴェント","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"26"},"height":{"reviewState":"source-only","source":"bangumi","value":"182"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38950a1f9272b37f374da45bf4df59a0e8456c6b03fdcb3ca95d073c8aff9b27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32777e55f6a12f3b833a7e5a2a7912b9cb244a48e0e91513fc123d20c8c351ec.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:26413:4513:1","source":"bangumi"}]},{"characterId":"char_bangumi_45964","characterName":"Elise Lutus","sourceIds":{"bangumi":[{"characterId":"45964","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Elise Lutus","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"12"},"height":{"reviewState":"source-only","source":"bangumi","value":"145"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高度な精霊術を使いこなす少女。「ティポ」という喋るぬいぐるみを連れている。国にとって彼女は最高機密の存在であるため、ア・ジュール政府によってハ・ミル村に隔離・管理されている。"},{"spoiler":false,"text":"行きがかりでジュードとミラの手助けをしたことが出会いのきっかけとなり、後に彼女の境遇を不憫に思ったジュードに連れ出され、同行するようになる。ドロッセルと心を通わせ、後にローエンの計らいで生活の拠点をカラハ・シャールのシャール家に置いた。"},{"spoiler":false,"text":"純粋で健気な少女だが、その裏側には孤独故の腹黒さも兼ね備えている。孤独な生涯を過ごしてきたため「友達」に憧れている。同時に、「友達は率先して自分を助けてくれる」という誤解もしており、自分のことが優先されないと拗ねてしまうことも。他者との接触や感情表現が苦手だが、旅を続けるにつれ人間らしい感情が芽生えていく。ミラと同じように感覚的に術式を構築して精霊術を使っているため、理論や詳しいことは知らない。また満足な教育も受けていなかったので、一般的な常識にも欠けている。"},{"spoiler":false,"text":"ア・ジュールが開発した増霊極（ブースター）の第三世代型・ティポの被験体。4歳の頃に両親を亡くし、人身売買を行っていたイスラによってア・ジュールの研究所に売られた。ティポとこれ以上にないほどまで適合しており、彼女とティポのデータは増霊極の実用化には欠かせない存在であったが、研究の中座によって情報漏洩を恐れた政府による監禁の憂き目にあっていた。"},{"spoiler":false,"text":"幼くして大人でも扱うのが困難な精霊術を使えるのはティポの影響で、ティポがいないと戦うことができない。主に広範囲の回復術と闇属性の精霊術を使いこなす。秘奥義は「リベールゴーランド」。ミラの次に食いしん坊で、ノーマルな料理から渋い和食、少し変わったものなど何でも食べるが、肉が一番好き。"}],"source":"bangumi","sourceCharacterId":"45964"}],"profileFacts":[{"label":"武器","source":"bangumi","sourceCharacterId":"45964","value":"杖"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e76afbee1e0bf3045d1cacfbe31e29cf9a07be17b65935ddac234bb05e6b0a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9fe32cdf866969d6e4fb25bfd0188399e49f304cc21b5288b645121d70809cc.webp","width":184,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀中優希","creatorId":"vndb:s15517","sourcePersonId":"vndb:s15517","canonicalEntityId":"vndb:s15517","name":"堀中優希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:45964:5157:1","source":"bangumi"}]},{"characterId":"char_bangumi_66934","characterName":"路德卡·威尔·库鲁斯尼克","sourceIds":{"bangumi":[{"characterId":"66934","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"路德卡·威尔·库鲁斯尼克","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"170"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界の均衡を崩す’’黒匣’’という技術を生み出した人間に課せられた’’オリジンの審判’’。審判の結末は、人間の破滅か進化か――。"},{"spoiler":false,"text":"人間を代表する一族として選ばれた、クルスニク一族。2000年もの月日が流れ、審判の期限が迫る中、その一族の末裔たる彼の選択に、世界と一人の少女の運命が託される。"}],"source":"bangumi","sourceCharacterId":"66934"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ab438c4ac4cbc0476f16ceddada689792c2f9d8cfbd2f47d8905cd7975d7828.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/7907f2930287e75e5a5bd49c32348ec7b2aecd8935dc258e364dfecec7aed735.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤隆","creatorId":"vndb:s72","sourcePersonId":"vndb:s72","canonicalEntityId":"vndb:s72","name":"近藤 隆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:66934:4265:1","source":"bangumi"}]},{"characterId":"char_bangumi_72442","characterName":"Elle Mel Mata","sourceIds":{"bangumi":[{"characterId":"72442","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Elle Mel Mata","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"130"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"しっかり者で口が減らない、活発な少女。"},{"spoiler":false,"text":"父親の言いつけを守り、願いを叶えてくれるという伝説の「カナンの地」を目指す一人旅をしていたが、偶然ルドガーと出会い、共に「カナンの地」へ行くという約束を交わすことになる。"}],"source":"bangumi","sourceCharacterId":"72442"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/028db15e83eb09faa4467b1fbd4bc15df857adfd9d1009ab5a63ba1c36c88ef3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb66c4fb1e5a57051229c8e9bc412135f093c4c957983ba31fe4e1515ec747b0.webp","width":152,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊瀬茉莉也","creatorId":"vndb:s4898","sourcePersonId":"vndb:s4898","canonicalEntityId":"vndb:s4898","name":"伊瀬 茉莉也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72442:4769:1","source":"bangumi"}]},{"characterId":"char_bangumi_72450","characterName":"ティポ","sourceIds":{"bangumi":[{"characterId":"72450","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"ティポ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"幼少時よりエリーゼが所持しているぬいぐるみ。エリーゼのことを「エリー」、他の人物は老若男女問わず「君」付けで呼ぶ。"},{"spoiler":false,"text":"自律し、自動で動き、サイズをある程度自在に変えられるという謎の生命体。エリーゼ本人も気づいていないが、増霊極として以外の付属機能によって全てはエリーゼの心を代弁しているだけである。途中でメモリを引き抜かれたことで口調や他称がすべてリセットされ露見、事実を知ったエリーゼが傷心を乗り越えたあとは、彼女の半身として行動する。たまにエリーゼの腹黒い部分がティポを介して垣間見えることも。"}],"source":"bangumi","sourceCharacterId":"72450"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10b884d5880fc5d3346b5d2d561c82aad3cf0290bf7e6e3eaef9ba7ae2a12320.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5be40c19ab8f9ce208d027e63361b14790864686a12eb8cac677214b9cd5e97c.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"池澤春菜","creatorId":"vndb:s6220","sourcePersonId":"vndb:s6220","canonicalEntityId":"vndb:s6220","name":"池澤 春菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72450:4230:1","source":"bangumi"}]},{"characterId":"char_bangumi_72451","characterName":"Rowen J. Ilbert","sourceIds":{"bangumi":[{"characterId":"72451","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Rowen J. Ilbert","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"62"},"height":{"reviewState":"source-only","source":"bangumi","value":"175"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ラ・シュガルの大貴族、シャール家の老執事。行き場をなくした自分を迎え入れたクレインとドロッセルに忠誠を誓っている。"},{"spoiler":false,"text":"沈着冷静で聡明な男。気さくで心優しいユーモア溢れる紳士。自らを「ジジイ」と称するものの、女性への興味はまだまだ現役。非常に博学で、軍事的知識においては右に出る者はそういない。感覚で術を操っていたエリーゼやミラに理論の手ほどきをした。"},{"spoiler":false,"text":"六家のひとつイルベルト家の分家出身で、20歳の頃に衰退していた生家に見切りをつけ、軍に入った。かつてはラ・シュガル軍の参謀総長として、ナハティガルの右腕として活躍した名軍師。その芸術的な采配と、術式を紡ぐ際の独特な動きから「指揮者（コンダクター）」の異名で知れ渡っていた。暴走したナハティガルを止めることが出来ずに、彼から離れて一人逃げた自分を悔いていたが、例え傷ついてでも自らの成すべきことを成そうとするミラの強さに心を動かされ、友としてナハティガルを止めるためにミラたちに同行するようになる。"},{"spoiler":false,"text":"優れた精霊術の使い手であらゆる属性の精霊術を使いこなすが、中でも水と土の精霊術を得意とする。秘奥義は「グランドフィナーレ」。好物はマーボーカレーで、料理は一番上手。"}],"source":"bangumi","sourceCharacterId":"72451"}],"profileFacts":[{"label":"武器","source":"bangumi","sourceCharacterId":"72451","value":"サーベル&ナイフ"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/521e747d7af504d48c3cbb6092d651f4c3e6f804b85a48b47506aaf4f741f828.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/175294c6ffac14b22046bf06fadc8006d6bdbc267876db90f180afc482e98c8e.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"麦人","creatorId":"vndb:s2887","sourcePersonId":"vndb:s2887","canonicalEntityId":"vndb:s2887","name":"麦人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72451:4162:1","source":"bangumi"}]},{"characterId":"char_bangumi_72452","characterName":"Gaius","sourceIds":{"bangumi":[{"characterId":"72452","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Gaius","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"32"},"height":{"reviewState":"source-only","source":"bangumi","value":"185"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"黎明王とも呼ばれる真紅の甲冑に身を包んだア・ジュールの若き王。"}],"source":"bangumi","sourceCharacterId":"72452"}],"profileFacts":[{"label":"武器","source":"bangumi","sourceCharacterId":"72452","value":"長刀"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5b99ded97fbca0e774e460ec53379528d340b6049987f1c4f81dfcbcd986769.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d3e830ad367df662e93f45b9be8198f0bbba6ebfd008b22c9c29ee19582363a.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72452:3976:1","source":"bangumi"}]},{"characterId":"char_bangumi_72453","characterName":"Musee","sourceIds":{"bangumi":[{"characterId":"72453","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Musee","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"20"},"height":{"reviewState":"source-only","source":"bangumi","value":"168"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ジュードたちの前に突如として現れたマクスウェルの使いを名乗る謎の精霊。"}],"source":"bangumi","sourceCharacterId":"72453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/116af5a4a3bc74554a329405ef103c5ac05403e07b14749bd7aeba5c0a58e115.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/335902456cb01897ffd7811c69523abe81dffa0a51dd88642398e89e17b9d6e5.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真田アサミ","creatorId":"vndb:s1712","sourcePersonId":"vndb:s1712","canonicalEntityId":"vndb:s1712","name":"真田 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72453:3847:1","source":"bangumi"}]},{"characterId":"char_bangumi_72454","characterName":"Wingul","sourceIds":{"bangumi":[{"characterId":"72454","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Wingul","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"28"},"height":{"reviewState":"source-only","source":"bangumi","value":"175"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"四象刃のリーダー格。ウィンガルという名は翼を意味する称号。"},{"spoiler":false,"text":"国王ガイアスの片腕となってア・ジュールの行政を仕切り、軍事面でも"},{"spoiler":false,"text":"参謀として全作戦を立案している。ふだんは物静かで、知性的な物言いをするが、"},{"spoiler":false,"text":"戦闘時は一変して粗暴な性格になり、セリフに出身部族の言語が混じるようになる。"}],"source":"bangumi","sourceCharacterId":"72454"}],"profileFacts":[{"label":"武器","source":"bangumi","sourceCharacterId":"72454","value":"剣"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dab48b1e7b4981a26805a365cdd183ba08208ffaa3310dca9c85265e0d657d01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f686f56301715740df7896218b0156660738e462b44c575f3f47c7cc3772b14.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木内秀信","creatorId":"vndb:s4559","sourcePersonId":"vndb:s4559","canonicalEntityId":"vndb:s4559","name":"木内 秀信","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72454:4762:1","source":"bangumi"}]},{"characterId":"char_bangumi_72457","characterName":"Agria","sourceIds":{"bangumi":[{"characterId":"72457","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Agria","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"15"},"height":{"reviewState":"source-only","source":"bangumi","value":"153"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ガイアス直属の部下「四象刃(フォーヴ)」の一人。アグリアとは「針」を意味する称号である。"},{"spoiler":false,"text":"強力な精霊術を使いこなす天才児。過去の経験から、他人の真剣さや努力を見下し、あざ笑う。"},{"spoiler":false,"text":"怒りと嘲笑でしか感情を表現する事ができず、その心は世界への憎しみに満ち満ちている。"},{"spoiler":false,"text":"大抵の事には無関心だが、自分の邪魔をする者、侮る者は絶対に許さない。"},{"spoiler":false,"text":"一旦キレると制御が利かず、作戦や状況をメチャクチャにしてしまうトラブルメーカー。"}],"source":"bangumi","sourceCharacterId":"72457"}],"profileFacts":[{"label":"武器","source":"bangumi","sourceCharacterId":"72457","value":"仕込み杖"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1814852acf8f726386abe6b1ec92b4022cf415001dde2c953cda6a7d572821a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a748a6cc434fceeb8d91def5aa78ba2295bddd38844939544ff88fe59ac45f9b.webp","width":176,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂本真綾","creatorId":"vndb:s5174","sourcePersonId":"vndb:s5174","canonicalEntityId":"vndb:s5174","name":"坂本 真綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72457:3877:1","source":"bangumi"}]},{"characterId":"char_bangumi_72708","characterName":"Celsius","sourceIds":{"bangumi":[{"characterId":"72708","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Celsius","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"「氷」の大晶霊。長髪で人間の少女に近い外見。暑苦しいアプローチをしてくるイフリートが苦手で毛嫌いしているが、大晶霊としてそんな苦手意識を持ってしまう自分を恥じる一面もある。グランドフォールの影響で我を失い町を凍り漬けにしていたが、本来は雪山に迷い込んだ人を助けるなど、人間を大切に思っている。"}],"source":"bangumi","sourceCharacterId":"72708"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dac7357a15ae01ef045005c41b34164dc7e6df5bd3d9c216fba055885044a5a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/131420b6d686bbc73f9b3174801bbafb66a86c37549017155c6587cd67ff01e3.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平田宏美","creatorId":"vndb:s1058","sourcePersonId":"vndb:s1058","canonicalEntityId":"vndb:s1058","name":"平田 宏美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72708:5439:1","source":"bangumi"}]},{"characterId":"char_bangumi_72713","characterName":"Julius Will Kresnik","sourceIds":{"bangumi":[{"characterId":"72713","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"Julius Will Kresnik","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"28"},"height":{"reviewState":"source-only","source":"bangumi","value":"180"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クルスニク一族にかけられた呪い。果てなき一族の闘争の螺旋。彼はそこに幼くして身を置いていた。しかし、彼は知っていた。弟ルドガーの優しさは、闘争に向かないことを。そして同時に、それが誰かの魂を救う、唯一の強さであることも。"},{"spoiler":false,"text":"それを守るため、彼は自らの命を賭し、全てを敵に回すことも厭わない。"}],"source":"bangumi","sourceCharacterId":"72713"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7cd49442421149b7cca26233688a0c16862a81a9b0129355380f333103b1f0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00c9a4d01b8abc801c0536d23dcacb818c7a30a2e6cf4394d81546e8c958db22.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大川透","creatorId":"vndb:s551","sourcePersonId":"vndb:s551","canonicalEntityId":"vndb:s551","name":"大川 透","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72713:4131:1","source":"bangumi"}]},{"characterId":"char_bangumi_72714","characterName":"维克托尔","sourceIds":{"bangumi":[{"characterId":"72714","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"维克托尔","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"30"},"height":{"reviewState":"source-only","source":"bangumi","value":"170"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"絶望に沈む彼を救ったのは、のちに伴侶となる一人の女性であった。妻娘との三人の幸せな日々に心の傷は癒え始めるも、愛娘の持つ特別な力を狙う者たちによって彼の運命は再び狂い始める。"},{"spoiler":false,"text":"誰であろうと容赦はしない。たとえその相手がかつての仲間、兄、父親であっても。"},{"spoiler":false,"text":"こうして最強の骸殻能力者の称号『ヴィクトル』を継承した彼は大いなる野望へと邁進する。自らの運命を変えるために。"}],"source":"bangumi","sourceCharacterId":"72714"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/479b5c91c28dc42096ea790b1d3febfb6785c460a908f7a1e90d928e755bbcaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/342166c4bc58f52d46aa0b335ffcbb5a5e38cb5d2f933b809b5bea4b26ce7ead.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤隆","creatorId":"vndb:s72","sourcePersonId":"vndb:s72","canonicalEntityId":"vndb:s72","name":"近藤 隆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:72714:4265:1","source":"bangumi"}]},{"characterId":"char_bangumi_78901","characterName":"分史ミラ","sourceIds":{"bangumi":[{"characterId":"78901","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"分史ミラ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"168"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"優しかった姉は変わってしまった。最愛の人物に虐げられる孤独な日々。だが彼女はさらなる地獄に突き落とされる。そこは断界殻のない黒匣に溢れた俄には信じがたい世界。マクスウェルとして大勢の人々を犠牲にしてでも使命を果たしたかつての自分、その全てを否定する正史世界であった。世界のためとはいえ、死ぬのは怖い。だが目の前にいる少女のためならば……。"},{"spoiler":false,"text":"死の淵に立たされた、彼女の選択は――"}],"source":"bangumi","sourceCharacterId":"78901"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8389ce1e5d6c96ef2bcf85520a623b74be3af0c5c70a9be36fc53800e8977d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0ed65726149c52fc8589a93a610f0912af867f533819068b2e4c4caa1862a5b.webp","width":133,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:53390:78901:4244:1","source":"bangumi"}]},{"characterId":"char_bangumi_89576","characterName":"イバル","sourceIds":{"bangumi":[{"characterId":"89576","match":"source-roster","subjectId":"53390"}]},"originalCharacterName":"イバル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"165"}},"descriptions":[{"segments":[{"spoiler":false,"text":"存在価値の消失、焦り、嫉妬がイバルの人生を大きく狂わせた。かつて精霊の主マクスウェルであるミラに仕えた巫子は、最も尊ばれる存在であった。ミラが彼方へと姿を消すと、その役割は終焉を迎えた。己の価値を認めさせる為、泥水をすすり、嘲笑に晒されようと元巫子はクランスピア社のエージェントとなる道を進んだ。名もなき者たちの列に並ばされ、都合よく組織に使われる。冠を奪われ、幾度となく自分の名すら忘れそうになりながらも、己を消さぬよう刻み込んだ。俺はイバルだ、と。"}],"source":"bangumi","sourceCharacterId":"89576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9302c0abe2f33e026f0e4bdcb3bc5c0ba99075523746766b7f757fd4ee597fea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22cd3987df5e9c90f1651451507309f2ec764325a29b31d9f126b89ca2140f0a.webp","width":187,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2224","sourceCompanyId":"egs:brand:2224","canonicalEntityId":"egs:brand:2224","name":"バンダイナムコエンターテインメント(バンダイナムコゲームス)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:38152:2224","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
