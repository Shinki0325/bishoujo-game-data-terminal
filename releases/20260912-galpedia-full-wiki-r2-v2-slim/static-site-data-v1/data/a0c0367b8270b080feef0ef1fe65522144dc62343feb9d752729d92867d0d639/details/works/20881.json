{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20881","model":{"presentationWorkId":"vndb:v15740","staff":{"artwork":[{"creditedName":"椎咲雛樹","creatorId":"vndb:s1999","sourcePersonId":"egs:creator:1780","canonicalEntityId":"vndb:s1999","name":"椎咲雛樹","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:135713","source":"egs"}],"scenario":[{"creditedName":"生田あわる","creatorId":"vndb:s2935","sourcePersonId":"egs:creator:5491","canonicalEntityId":"vndb:s2935","name":"生田あわる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:135714","source":"egs"},{"creditedName":"高坂ヒロト","creatorId":"vndb:s2936","sourcePersonId":"egs:creator:12747","canonicalEntityId":"vndb:s2936","name":"高坂ヒロト","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:135715","source":"egs"}],"music":[{"creditedName":"AZ-MIX","creatorId":"vndb:s2509","sourcePersonId":"vndb:s2509","canonicalEntityId":"vndb:s2509","name":"AZ-MIX","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:112721","source":"vndb"}],"other":[{"creditedName":"ねこの手スタジオ","creatorId":"egs:creator:29877","sourcePersonId":"egs:creator:29877","canonicalEntityId":"egs:creator:29877","name":"ねこの手スタジオ","detail":"ボイスレコーディング","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:181118","source":"egs"},{"creditedName":"高坂 ヒロト","creatorId":"vndb:s2936","sourcePersonId":"vndb:s2936","canonicalEntityId":"vndb:s2936","name":"高坂 ヒロト","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112724","source":"vndb"}]},"cast":[{"characterId":"char_c27327","characterName":"小山 由紀","sourceIds":{"bangumi":[{"characterId":"27320","match":"exact-normalized-name-in-linked-work","subjectId":"110514"}],"egsCharacterIds":["6115"],"vndbCharacterId":"c27327"},"originalCharacterName":"小山 由紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本来は小山家次男のヨシノリなのだが、現在はユキと名乗り、小山家長女だと思われている男の娘。"},{"spoiler":false,"text":"一人称は「私」。背丈は同年代の女子としてはやや高いが男子としては低い。"},{"spoiler":false,"text":"体型はスレンダーで足が綺麗なのだが、恥ずかしがってミニスカートなどを穿く事はほとんどない。"},{"spoiler":false,"text":"髪は胸の下まであるストレート。普段は縛っていないが動きにくい時は纏める事もある。"},{"spoiler":false,"text":"真面目で勉強への取り組みも熱心なしっかり者。"},{"spoiler":false,"text":"しかし家事全般が苦手で手伝いでも壊滅的な事が起こる。"},{"spoiler":false,"text":"学校が標準服制に移行した３年前から女装を始めた。"},{"spoiler":false,"text":"現在はすっかり男の娘としての生活が身につき、学校でも本物の女の子だと思っている生徒も多い。"},{"spoiler":false,"text":"他の子にお兄ちゃんを取られたくないと思っていて、たまに兄を取り合って小さな子供みたいに拗ねてしまう事がある。"}],"source":"egs","sourceCharacterId":"6115","sourceWorkId":"20881","spoiler":false},{"segments":[{"spoiler":false,"text":"本来は小山家次男の “ヨシノリ” なのだが、現在はユキと名乗り、小山家長女だと思われている男の娘。"},{"spoiler":false,"text":"体型はスレンダーで足が綺麗なのだが、恥ずかしがってミニスカートなどを穿くことはほとんどない。"},{"spoiler":false,"text":"まじめで勉強への取り組みも熱心なしっかり者。"},{"spoiler":false,"text":"しかし家事全般が苦手で、手伝いだけでも壊滅的な事件が起こる。"},{"spoiler":false,"text":"3年前から女装を始め、現在はすっかり男の娘としての生活が身についている。"},{"spoiler":false,"text":"学園でも本物の女の子だと思っている学生は多い。"},{"spoiler":false,"text":"他の子にお兄ちゃんを取られたくないと思っていて、たまに兄を取り合って小さな子供みたいに拗ねてしまうことがある。"}],"source":"bangumi","sourceCharacterId":"27320"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bad28dc18277b16b50546b579d26814f8434836abebfdc1a2d47f59f362dabb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a2d21125d13c9e625e1c1c326bf36a6866dc7c3aed8da2d080baa4e2cb55f07.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天川みるく","creatorId":"vndb:s573","sourcePersonId":"vndb:s573","canonicalEntityId":"vndb:s573","name":"天川 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:110514:27320:25801:1","source":"bangumi"}]},{"characterId":"char_c27328","characterName":"小山 真理","sourceIds":{"bangumi":[{"characterId":"27321","match":"exact-normalized-name-in-linked-work","subjectId":"110514"}],"egsCharacterIds":["6116"],"vndbCharacterId":"c27328"},"originalCharacterName":"小山 真理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本来は小山家三男のマサミチなのだが、昔からよくマリと名乗り、とりあえず小山家の末っ子として小さな頃から認識されている男の娘。"},{"spoiler":false,"text":"一人称は「アタシ」。背丈はユキと同程度で、女子よりやや高いが男子としては低い感じ。"},{"spoiler":false,"text":"体型はややスレンダーで、スポーツをしやすい格好としてそれなりに露出もする。"},{"spoiler":false,"text":"髪はストレートで、サイドテールが基本。"},{"spoiler":false,"text":"明るく元気で体育や音楽などの勉強以外が得意なややお調子者。"},{"spoiler":false,"text":"褒められるとやる気が出てくるタイプだが、褒めすぎると図に乗ってしまう事も。"},{"spoiler":false,"text":"家事はそこそこ出来るが面倒がってお兄ちゃんに甘えている。"},{"spoiler":false,"text":"兄と一緒に柔道を習っていた事があり結構強いのだが、筋肉が付きすぎて男らしくなるのが嫌だと今はやっていない。"},{"spoiler":false,"text":"標準服制に移行する前から男女の制服どちらも着こなしていて、現在は女装一本。"},{"spoiler":false,"text":"皆で仲良く出来れば良いなと思っている。"}],"source":"egs","sourceCharacterId":"6116","sourceWorkId":"20881","spoiler":false},{"segments":[{"spoiler":false,"text":"本来は小山家三男の “マサミチ” なのだが、昔からマリと名乗っていた末っ子の男の娘。"},{"spoiler":false,"text":"動きやすい服装を好むので、それなりに露出の多い格好をしている。"},{"spoiler":false,"text":"明るく元気で、体育や音楽などの勉強以外が得意なややお調子者。"},{"spoiler":false,"text":"褒められるとやる気が出てくるタイプだが、褒め過ぎると図に乗ってしまうことも。"},{"spoiler":false,"text":"家事はそこそこ出来るが、面倒がってお兄ちゃんに甘えている。"},{"spoiler":false,"text":"兄と一緒に柔道を習っていたことがあり結構強いのだが、筋肉が付いて男らしくなるのが嫌で今はやっていない。"},{"spoiler":false,"text":"皆で仲良く出来れば良いなと思っている。"}],"source":"bangumi","sourceCharacterId":"27321"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/502b85b941f5d07630be9efe3b1e3761f5006ec638a5bd8f17b275f51fdddf86.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5249faaa8089544da9b0b727a9a6297fc808605d9eb02708ef44a46a0f82c847.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"犬飼あお","creatorId":"vndb:s942","sourcePersonId":"vndb:s942","canonicalEntityId":"vndb:s942","name":"犬飼 あお","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:110514:27321:32277:1","source":"bangumi"}]},{"characterId":"char_c27329","characterName":"仲立 明","sourceIds":{"bangumi":[{"characterId":"27322","match":"exact-normalized-name-in-linked-work","subjectId":"110514"}],"egsCharacterIds":["6117"],"vndbCharacterId":"c27329"},"originalCharacterName":"仲立 明","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"隣に住む男の娘"},{"spoiler":false,"text":"本来は仲立家長男のアキラなのだが、母からメイさんと呼ばれ周囲もメイと呼び、小さな頃から女装だったため小山家次女だと思われている。"},{"spoiler":false,"text":"遥が物心ついてから着てくれなくなったゴスロリを嫌がる事なく着てくれるのが嬉しいと母がゴスロリを着せ続け、本人も自分が男だと気付かずに育っていた。"},{"spoiler":false,"text":"年頃になる前に自分が男だと気付いて男の子らしくしてみようかとチャレンジした事もあったけれど、違和感を覚えてしまうので３日で元に戻った。"},{"spoiler":false,"text":"一人称は「メイ」。背丈は女子と同程度で姉よりは少し高い。"},{"spoiler":false,"text":"体型は胸のない女の子そのもので、あまり男の子っぽい所がない。"},{"spoiler":false,"text":"髪はウェーブがかかっていて低めの位置でのツインテールが多い。"},{"spoiler":false,"text":"主人公の事を幼いころから想っていて、好きだと伝えているのだが小さい頃から言い過ぎたせいか主人公にはLOVEでなくLIKEなのだと思われている。"},{"spoiler":false,"text":"一般の服はもちろん、自分の着ているゴスロリも仕立ててしまうほど裁縫が得意。"},{"spoiler":false,"text":"ただし裁縫以外の家事は得意ではない。"}],"source":"egs","sourceCharacterId":"6117","sourceWorkId":"20881","spoiler":false},{"segments":[{"spoiler":false,"text":"隣に住む男の娘。 本来は仲立家長男の “アキラ” なのだが、母や周囲からメイと呼ばれ、小山家次女だと思われている。"},{"spoiler":false,"text":"長女が着てくれなくなったゴスロリを嫌がることなく着てくれるのが嬉しいと、母がゴスロリを着せ続け、本人も自分が男だと気付かずに育っていた。"},{"spoiler":false,"text":"自分が男だと気付いて男の子らしくしてみようかとチャレンジしたこともあったが、違和感を覚えてしまうので 3日で元に戻った。"},{"spoiler":false,"text":"ゴスロリ服を自分で仕立ててしまうほど裁縫が得意。 ただし裁縫以外の家事は得意ではない。"},{"spoiler":false,"text":"姉と違って控えめで心優しい子だが、血は争えないのかまれに暴走する。"},{"spoiler":false,"text":"主人公のことを幼い頃から想っていて、好きだと伝えているが、言い過ぎたせいか主人公には LOVE でなく LIKE だと思われている。"},{"spoiler":false,"text":"姉のテキトーな言葉を真に受けてトンデモナイ行動をしたり、姉の持っている本から得た知識で主人公に迫る。"}],"source":"bangumi","sourceCharacterId":"27322"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/464f4dcc6300570e2766f22c2e8b460236e86ac98238f4699c3856614c021daf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/9409454207165de3f6b8f8025ceacee8b06b7de461eaf69d24fe56c44531ab71.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:110514:27322:7890:1","source":"bangumi"}]},{"characterId":"char_c27330","characterName":"仲立 遥","sourceIds":{"bangumi":[{"characterId":"27323","match":"exact-normalized-name-in-linked-work","subjectId":"110514"}],"egsCharacterIds":["6118"],"vndbCharacterId":"c27330"},"originalCharacterName":"仲立 遥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大学３年生。授業の出席数はギリギリだがテスト点は良く、実験も完璧。"},{"spoiler":false,"text":"一人称は「ワタシ」。背は低めだが態度がデカイのであまり小さく見えない。"},{"spoiler":false,"text":"髪は天然ウェーブもしくは癖っ毛。"},{"spoiler":false,"text":"ミディアムショートくらいのやや短めの髪をバレッタなどを使ってサイドアップなどにまとめている。"},{"spoiler":false,"text":"理系女子の中ではオシャレな方。"},{"spoiler":false,"text":"胸が大きくて綺麗な顔立ちをしているため良く言い寄られるようだが、本人は年下のカワイイ男の娘にしか興味がないためことごとく振っている。"},{"spoiler":false,"text":"ワガママだが姉御肌でカリスマ性と決定力があったので、高校時代は頼りになる生徒会長として君臨していた。"},{"spoiler":false,"text":"隣に住む主人公とずっと同じ学校に通い、大学も学部こそ違えど同じ所に通っている腐れ縁。"},{"spoiler":false,"text":"年齢は主人公よりも１つ上なので同じクラスになった事は無い。"},{"spoiler":false,"text":"ただし、部活や生徒会活動、その他日常生活などで主人公を有効に使い倒している。"},{"spoiler":false,"text":"最近、自分の事は自分でしないとダメだと言うようになった主人公を生意気だと思っている。"},{"spoiler":false,"text":"弟のメイが孝美を好きでアタックを掛ける事については本人の自由だと思っている。"},{"spoiler":false,"text":"メイと孝美がくっついたら、自分はユキやマリと簡単にイチャイチャ出来るかも知れないとやや応援もしている。"},{"spoiler":false,"text":"遥なりにメイの事は大事にしていて、メイが悲しんでいると姉らしく振る舞ったりする。"},{"spoiler":false,"text":"※当然ですが攻略できません。"}],"source":"egs","sourceCharacterId":"6118","sourceWorkId":"20881","spoiler":false},{"segments":[{"spoiler":false,"text":"大学3年生。 授業の出席数はギリギリだがテストの点は良く、実験も完璧。"},{"spoiler":false,"text":"胸が大きくて綺麗な顔立ちをしているため言い寄られることも多いが、本人は年下のカワイイ男の娘にしか興味がないためことごとくフっている。"},{"spoiler":false,"text":"ワガママだが、姉御肌でカリスマ性と決断力があったので、高校時代は頼りになる生徒会長として君臨していた。"},{"spoiler":false,"text":"主人公とずっと同じ学園に通い、大学も学部こそ違えど同じ所に通っている腐れ縁。"},{"spoiler":false,"text":"おかげで日常生活から学園生活まで、便利な主人公を有効に使い倒している。"},{"spoiler":false,"text":"弟のメイが主人公にアタックを掛けることについては、本人の自由だと思っている。"},{"spoiler":false,"text":"メイと主人公がくっついたら、自分はユキやマリと簡単にイチャイチャ出来るかも知れないとやや応援もしている。"},{"spoiler":false,"text":"遥なりにメイのことは大事にしていて、メイが悲しんでいると姉らしく振る舞ったりする。"}],"source":"bangumi","sourceCharacterId":"27323"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/975a019fcba8b9c51283aceebe3b0ca4bde52ddc73364d8b0b4f8d6d426537dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb21cff5a240aeec040d8a396af61a693d96ceae070d1b9df210a5254859895c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"誠樹ふぁん","creatorId":"vndb:s1729","sourcePersonId":"vndb:s1729","canonicalEntityId":"vndb:s1729","name":"誠樹 ふぁん","roleCode":"vo