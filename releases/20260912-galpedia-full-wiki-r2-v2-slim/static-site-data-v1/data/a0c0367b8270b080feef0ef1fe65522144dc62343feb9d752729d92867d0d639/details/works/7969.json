,{"spoiler":false,"text":"He is involved with assassinations and other bloody missions."},{"spoiler":false,"text":"He enjoys killing people and hearing that he could kill people for money without being punished he joined the Shinsengumi."},{"spoiler":false,"text":"He's always looking down on people and being superficially polite with a fearless smile on his face."},{"spoiler":false,"text":"He thinks trusting people is foolish and has no friends."}],"source":"vndb","sourceCharacterId":"c47219"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2908682ab5c5c718bddfd9211a4915e2ee11de62cc85ecf4adf215f4f8d37ef0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3a7a7e3f7b5b00df60064e36a0f30a655f6958befe260431b2db0b8bfa8e188.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤木 賢志","creatorId":"vndb:s16174","sourcePersonId":"vndb:s16174","canonicalEntityId":"vndb:s16174","name":"加藤木賢志","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41121","source":"vndb"}]},{"characterId":"char_vndb_c47224","characterName":"芹沢 鴨","sourceIds":{"vndbCharacterId":"c47224"},"originalCharacterName":"芹沢 鴨","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Early leader of the Shinsengumi, Serizawa is fond of drinking, and his iron fan will strike without warning to anyone who crosses him."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c47224"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/949b8d6dce27fc44d71585beb6e0dd45c5d7226aca8053180c9ec365b52c5