vndb"},{"creditedName":"浅乃 一","creatorId":"vndb:s3627","sourcePersonId":"vndb:s3627","canonicalEntityId":"vndb:s3627","name":"浅乃一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:73198","source":"vndb"},{"creditedName":"Toko","creatorId":"vndb:s3832","sourcePersonId":"vndb:s3832","canonicalEntityId":"vndb:s3832","name":"Toko","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:73199","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c1457","characterName":"桜庭 鈴花","sourceIds":{"vndbCharacterId":"c1457"},"originalCharacterName":"桜庭 鈴花","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born in Aizu, Suzuka’s father ran a dojo and she learned the sword from an early age. After her father died, leaving the dojo with heavy debts, Suzuka decided that she should use her skill and asked Teruhime, the princess of Aizu, to help her get into the Shinsengumi. She is a passionate and dedicated girl, who wants to be accepted for her skill rather than stand out for being a girl."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1457"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/831606a108551615186b9db8e1a63a94d8a3955017acaabf90301c349fe54231.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a896a6b741722bcedd6a181c382f24f33a9ae8659e52ff3be5956a98360ba1e.webp","width":137,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1458","characterName":"近藤 勇","sourceIds":{"vndbCharacterId":"c1458"},"originalCharacterName":"近藤 勇","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very direct person, Kondou is also known as a womanizer and some see him as frivolous, even insincere. However, beyond that light-hearted persona is a very deep sense of justice and duty and devotion to \"Makoto\", the code of the Shinsengumi and the way of the samurai."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1458"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/795b82b9c6dd52d24478cc8478c8cff9f2c4e61823966f4583ffea0516edd07a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbbfddef81fc5c38eb35dd85ee324fafdc30841070828bc2bfc5a07264ffccd8.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森田 成一","creatorId":"vndb:s176","sourcePersonId":"vndb:s176","canonicalEntityId":"vndb:s176","name":"森田 成一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41112","source":"vndb"}]},{"characterId":"char_vndb_c1459","characterName":"土方 歳三","sourceIds":{"vndbCharacterId":"c1459"},"originalCharacterName":"土方 歳三","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A calm and calculating man, but he is devoted to Kondou and works hard for him. Serious and somewhat formal, speaking without caution around him will arise his suspicions. However, in those he trusts he trusts completely."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3364638464541da71812293cf4e80bacfcbeaada29035094fd4ca2f60affa558.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/1037ee1e91fc3d2d345b594da810415f0c2604df85ee3a59f08d62027c8b38da.webp","width":151,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41117","source":"vndb"}]},{"characterId":"char_vndb_c1460","characterName":"沖田 総司","sourceIds":{"vndbCharacterId":"c1460"},"originalCharacterName":"沖田 総司","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A kind young man who always seems to be smiling, but there is more than that to him. The one who fights with great skill with his sword is the same one that plays with neighborhood children. Totally devoted to the Shinsengumi."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bf31ea8cdf0f1d4a5bcb80361fdfe1af2dad90981540a8a0ec9abc2b4e5becf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85d0ecfbaf5a384abfe94008ce6c894aad0dfc5ee8b58271475c6ad06a52c2b7.webp","width":141,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石田 彰","creatorId":"vndb:s74","sourcePersonId":"vndb:s74","canonicalEntityId":"vndb:s74","name":"石田 彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41111","source":"vndb"}]},{"characterId":"char_vndb_c1461","characterName":"山南 敬助","sourceIds":{"vndbCharacterId":"c1461"},"originalCharacterName":"山南 敬助","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kind and gentle, Yamanami does not get angry easily, however dishonestly will cause him to be upset. Although he is skilled with the sword, his talents in the Shinsengumi are better used for teaching literature and military arts."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4269cf67ab57fbb8940ca840c6a85f01fcec6b528a4483f508fdf537db6b59f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0231e17a15b799f87fd233537c8948ab3995a42fe40107187aa81526678b3ca4.webp","width":151,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小西 克幸","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41110","source":"vndb"}]},{"characterId":"char_vndb_c1462","characterName":"永倉 新八","sourceIds":{"vndbCharacterId":"c1462"},"originalCharacterName":"永倉 新八","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dependable person with a big, if sometimes rough, personality. He is fond of money. An ideal partner for him would be someone who wouldn't shrink away from such a bold man."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1462"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/374743674cb3be33e628036e81439e1af579e07ea3da3efe0d399377d4138066.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fe70abb417245d244ff247235be8399ebdee74c317dc3f4f50af928d6689167.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森久保 祥太郎","creatorId":"vndb:s381","sourcePersonId":"vndb:s381","canonicalEntityId":"vndb:s381","name":"森久保祥太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41115","source":"vndb"}]},{"characterId":"char_vndb_c1463","characterName":"斎藤 一","sourceIds":{"vndbCharacterId":"c1463"},"originalCharacterName":"斎藤 一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hard to read because he doesn’t show a lot of emotion, the lone wolf of the group is considered one of the best in the Shinsengumi. Although he does seem to be distant, when he does become close to someone he shows his good nature."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b88f1cfc21341b8c67dfbb857fe4915aa557b45b264a1b38828b9f302db8cfce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6dd63e462bcfcbe2e2ffb50562d11d6446912701cfda63689c54d09c275f660.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三木 眞一郎","creatorId":"vndb:s252","sourcePersonId":"vndb:s252","canonicalEntityId":"vndb:s252","name":"三木眞一郎","roleCode":"vo