oleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:166640","source":"vndb"},{"creditedName":"古月 瓜","creatorId":"vndb:s11178","sourcePersonId":"vndb:s11178","canonicalEntityId":"vndb:s11178","name":"古月瓜","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:166641","source":"vndb"},{"creditedName":"古月 瓜","creatorId":"vndb:s11178","sourcePersonId":"vndb:s11178","canonicalEntityId":"vndb:s11178","name":"古月瓜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:166642","source":"vndb"},{"creditedName":"らめぇ男","creatorId":"vndb:s12630","sourcePersonId":"vndb:s12630","canonicalEntityId":"vndb:s12630","name":"トクナガ(らめぇ男)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:166644","source":"vndb"},{"creditedName":"まついさん","creatorId":"vndb:s22108","sourcePersonId":"vndb:s22108","canonicalEntityId":"vndb:s22108","name":"松井 章","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:166648","source":"vndb"},{"creditedName":"とらら","creatorId":"vndb:s22109","sourcePersonId":"vndb:s22109","canonicalEntityId":"vndb:s22109","name":"とらら","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:166649","source":"vndb"},{"creditedName":"華見 酒","creatorId":"vndb:s22110","sourcePersonId":"vndb:s22110","canonicalEntityId":"vndb:s22110","name":"華見 酒","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:166650","source":"vndb"}]},"cast":[{"characterId":"char_c75879","characterName":"テイル","sourceIds":{"bangumi":[{"characterId":"68139","match":"exact-normalized-name-in-linked-work","subjectId":"263739"},{"characterId":"68139","match":"exact-normalized-name-in-linked-work","subjectId":"297767"},{"characterId":"68139","match":"exact-normalized-name-in-linked-work","subjectId":"301834"}],"egsCharacterIds":["20384"],"vndbCharacterId":"c75879"},"originalCharacterName":"テイル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious girl Eito finds and awakens in a bleak and empty world. She immediately latches on to him as her \"Prince Charming\" and shortly after they are transported to the Great Library. As she has amnesia and remembers nothing about herself, Eito names her \"Tale\" and resolves to stay at the Library until he helps her recover her memories and the story she is the main character of."},{"spoiler":false,"text":"Tale stays by Eito's side during his adventures and shares a room with him when they rest for the night. She starts a diary soon after she arrives in the hopes it will help to recover her memories as her encounters and experiences with Eito increase."},{"spoiler":true,"text":"Friendly, optimistic, positive and easily excited by new things, Tale acts as Eito's emotional support during his adventures. After meeting other characters and registers, she usually attaches the \"chan\" suffix to their first names after meeting them for the first time. Because she has no memory of her past, she is unprejudiced and is always on the lookout to make more friends. She frequently asks Eito and the others about unfamiliar terms and concepts, including those which are inappropriate for someone with the mental age and innocence of a young child."},{"spoiler":true,"text":"Tale is really the \"Prima\" of the story Historia wrote with help from Shiori. Grimoire (as Iris) created her based on the template of \"Sleeping heroines awakened by their Prince Charming\". She adores Eito and is physically affectionate with him from the outset."},{"spoiler":true,"text":"Although Tale does not have the combat ability of the other characters, her experiences written down in her diary prove to be the solution to the problem of maintaining a story without robbing pages from other stories."},{"spoiler":true,"text":"As her story is all about visits to other tales and her experiences, she is allowed to work as a Librarian and enter other stories as a guest because her tale lacks a significant \"mental imprint\" which could negatively impact the host story if she stays for an excessive period."},{"spoiler":true,"text":"In the end, she stays and work by Eito's side in his editorial job and can return freely to the Great Library and her own story via Eito's Colette."}],"source":"vndb","sourceCharacterId":"c75879"},{"segments":[{"spoiler":false,"text":"白い砂漠のような世界で拾った女の子。"},{"spoiler":false,"text":"テイルというのは詠斗がつけてあげた名前。"},{"spoiler":false,"text":"記憶喪失状態であり、自分の名前もわからない。"},{"spoiler":false,"text":"にもかかわらず、それを全く気にした様子は無い。"},{"spoiler":false,"text":"とにかく天真爛漫で、好奇心旺盛かつ能天気。"},{"spoiler":false,"text":"見るものすべてが新鮮で刺激的。"},{"spoiler":false,"text":"なぜか詠斗のことを王子さまと呼び、人目も憚らず、常に密着しているほどに慕っている。"}],"source":"egs","sourceCharacterId":"20384","sourceWorkId":"27360","spoiler":false},{"segments":[{"spoiler":false,"text":"司書を務める主人公の相棒。様々な物語を巡って成長したが、いつも幸せそうなのは相変わらず。"}],"source":"egs","sourceCharacterId":"20384","sourceWorkId":"29051","spoiler":false},{"segments":[{"spoiler":false,"text":"CV：歩サラ"},{"spoiler":false,"text":"原画：繭咲悠"},{"spoiler":false,"text":"出典：不明"},{"spoiler":false,"text":"身長：154cm"},{"spoiler":false,"text":"カップサイズ：D"},{"spoiler":false,"text":"好きなもの：詠斗、知らないもの、珍しいもの"},{"spoiler":false,"text":"白い砂漠のような世界で拾った女の子。"},{"spoiler":false,"text":"テイルというのは詠斗がつけてあげた名前。"},{"spoiler":false,"text":"記憶喪失状態であり、自分の名前もわからない。"},{"spoiler":false,"text":"にもかかわらず、それを全く気にした様子は無い。"},{"spoiler":false,"text":"とにかく天真爛漫で、好奇心旺盛かつ能天気。"},{"spoiler":false,"text":"見るものすべてが新鮮で刺激的。"},{"spoiler":false,"text":"なぜか詠斗のことを王子さまと呼び、"},{"spoiler":false,"text":"人目も憚らず常に密着しているほどに慕っている。"},{"spoiler":false,"text":"「王子さまだー！」"}],"source":"bangumi","sourceCharacterId":"68139"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/135970ae381f968b4656f7cd7c1df82a85b078b0d84e71c5ded41445e4b3e8f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5f1d566dbe2f1bb32b414a80d972a43adafcb275805d331b0568495a5331dbc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301834:68139:13368:1","source":"bangumi"}]},{"characterId":"char_c75925","characterName":"イストリア","sourceIds":{"bangumi":[{"characterId":"68140","match":"exact-normalized-name-in-linked-work","subjectId":"263739"},{"characterId":"68140","match":"exact-normalized-name-in-linked-work","subjectId":"297767"},{"characterId":"68140","match":"exact-normalized-name-in-linked-work","subjectId":"301834"}],"egsCharacterIds":["20385"],"vndbCharacterId":"c75925"},"originalCharacterName":"イストリア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Head Librarian of the Great Library, Historia was created around the same time homo sapiens evolved the ability to tell stories from the imagination. Initially she executed her role alone as part of the \"system\" governing the maintenance of the collective gestalt that is the world of stories, but repeated interaction with the characters in stories and the occasional human guest Librarian allowed her to develop human emotions and a personality."},{"spoiler":false,"text":"Historia has the important role of coalescing stories in their published form from the wellspring of human imagination into books for the Great Library. In addition, she can give form to the fragments of imagination which have not yet been published as stories and materialise them in the Great Library. In this way, she can literally summon food from thin air and obtain the latest entertainment devices from the human world."},{"spoiler":true,"text":"When Shiori is summoned as a Librarian, Historia has recently become acquainted with the new gamut of human emotions but is unsure how to understand them. At Shiori's urging, she endeavours to write her own story which will allow her to understand and cope with human emotions better. Unfortunately her story does not take off and the Register she created, Iris, eventually fades from her consciousness and is presumably destroyed by the worms."},{"spoiler":true,"text":"When Iris and Historia reunite again after the former was thought lost to oblivion, the latter almost succeeds in killing her daughter were it not for the intervention of Eito, Tale and Shiori. After reconciliation, Historia rewards Eito and Shiori for their contributions by making an exception for the pair with regards to their Colletes which are normally returned to the Great Library before humans are sent back."}],"source":"vndb","sourceCharacterId":"c75925"},{"segments":[{"spoiler":false,"text":"“大図書館”の館長。"},{"spoiler":false,"text":"“現実世界”で物語が発生するのを察知し、それを本の形に結晶化して取り出す能力を持つ。"},{"spoiler":false,"text":"フルネームはイストリア・エーナス・パラティリティス・アナグノースティス・ギデマン・エディトール（フォント小さくしても良いかも）という。自分でつけた。カッコイイから。"},{"spoiler":false,"text":"でも誰も呼ばない。"},{"spoiler":false,"text":"大図書館の管理人として機械的に仕事をこなすだけだったが、多くの司書との出会いを経て、永い年月をかけて人間らしさを獲得してきた。"},{"spoiler":false,"text":"しかし最近ではそれが行き過ぎて、司書に多くの仕事を任せて自分はぐーたらしてばかり。"},{"spoiler":false,"text":"最近のお気に入りは携帯ゲーム。"}],"source":"egs","sourceCharacterId":"20385","sourceWorkId":"27360","spoiler":false},{"segments":[{"spoiler":false,"text":"物語を本の形に結晶化する能力を持つ、大図書館の館長。司書に仕事を任せ、自分はぐーたらしている。"}],"source":"egs","sourceCharacterId":"20385","sourceWorkId":"29051","spoiler":false},{"segments":[{"spoiler":false,"text":"CV：卯衣"},{"spoiler":false,"text":"原画：ぎん太郎"},{"spoiler":false,"text":"出典：なし"},{"spoiler":false,"text":"身長：144cm"},{"spoiler":false,"text":"カップサイズ：A"},{"spoiler":false,"text":"好きなもの：現実世界の最新知識、詩織の作るお菓子"},{"spoiler":false,"text":"“大図書館” の館長。"},{"spoiler":false,"text":"“現実世界” で物語が発生するのを察知し、"},{"spoiler":false,"text":"それを本の形に結晶化して取り出す能力を持つ。"},{"spoiler":false,"text":"フルネームはイストリア・エーナス・パラティリティス・アナグノースティス・ギデマン・エディトールという。"},{"spoiler":false,"text":"自分でつけた。カッコイイから。でも誰も呼ばない。"},{"spoiler":false,"text":"大図書館の管理人として機械的に仕事をこなすだけだったが、"},{"spoiler":false,"text":"多くの司書との出会いを経て、永い年月をかけて人間らしさを獲得してきた。"},{"spoiler":false,"text":"しかし最近ではそれが行き過ぎて、司書に多くの仕事を任せて自分はぐーたらしてばかり。"},{"spoiler":false,"text":"最近のお気に入りは携帯ゲーム。"},{"spoiler":false,"text":"「妾はこの図書館そのものじゃ。すごかろう？」"}],"source":"bangumi","sourceCharacterId":"68140"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b720c37a4ec8dbbb747820c2082db43bc02d0450969578ecb7dd69bdd92ecc66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32891944fee7ddc701d0e928b317a6fc2270c332dae00221f333b76f377f34d1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大橋歩夕","creatorId":"vndb:s1178","sourcePersonId":"vndb:s1178","canonicalEntityId":"vndb:s1178","name":"大橋 歩夕","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301834:68140:6174:1","source":"bangumi"}]},{"characterId":"char_c78195","characterName":"ハワード・フィリップス・ラヴクラフト","sourceIds":{"bangumi":[{"characterId":"68157","match":"exact-normalized-name-in-linked-work","subjectId":"263739"},{"characterId":"68157","match":"exact-normalized-name-in-linked-work","subjectId":"301834"}],"egsCharacterIds":["20966"],"vndbCharacterId":"c78195"},"originalCharacterName":"ハワード・フィリップス・ラヴクラフト","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Register for the story world selected by Historia for the vacation by the sea. She runs the hotel together with the fishmen staff. Extremely shy, she prefers to write down her thoughts at high speed before presenting them to someone to read on her behalf. If she's not talking to someone face to face, she can speak normally and with a much higher pitch (for instance if she's voice-recording for the hotel reception)."},{"spoiler":true,"text":"The Register AND main character of \"The Shadow over Innsmouth\", H.P Lovecraft's sole published full work. Her problems with interpersonal connection lead her to reach out to her pen friend Historia for assistance. Historia was looking for a place to vacation, so took the opportunity to bring the Librarians over in a bid to help Lovie out. Lovecraft eventually reenacts the closing scenes of the work and acts the part of Dagon to get a piece of Eito for herself. Although \"causing an incident\" was suggested by Historia as an idea to help Lovecraft get physically intimate with Eito as he did with all of the other characters, it seems Lovecraft was both playing the part in jest and for keeps, because of the story setting."},{"spoiler":true,"text":"Lovecraft eventually gives her bookmark to Eito, and she joins the chat group with the other characters where her strange Cthulhu fixation gives her a unique charm in an easygoing chat environment."}],"source":"vndb","sourceCharacterId":"c78195"},{"segments":[{"spoiler":false,"text":"“インスマウスの影”の。"},{"spoiler":false,"text":"ボーッと宇宙的電波を受信する不思議ちゃん。"},{"spoiler":false,"text":"自分に自信がなく、弱気で引っ込み思案。"},{"spoiler":false,"text":"対面して話すのがとても苦手で、どうしても上手く言葉が出てこない。"},{"spoiler":false,"text":"――が、お手紙の中ではリミッターが外れてスーパーハイテンションになる。"},{"spoiler":false,"text":"とっても寂しがり屋さんでもあり、対等な関係のおともだちに飢えている。"},{"spoiler":false,"text":"イストリアは文通相手で、時折相談に乗ってもらっている。"}],"source":"egs","sourceCharacterId":"20966","sourceWorkId":"27360","spoiler":false},{"segments":[{"spoiler":false,"text":"CV：飴川紫乃"},{"spoiler":false,"text":"原画：神剣桜花"},{"spoiler":false,"text":"モチーフ：ハワード・フィリップス・ラヴクラフト"},{"spoiler":false,"text":"身長：151cm"},{"spoiler":false,"text":"カップサイズ：G"},{"spoiler":false,"text":"好きなもの：アイス、海、覗き"},{"spoiler":false,"text":"“インスマウスの影” の。"},{"spoiler":false,"text":"ボーッと宇宙的電波を受信する不思議ちゃん。"},{"spoiler":false,"text":"自分に自信がなく、弱気で引っ込み思案。"},{"spoiler":false,"text":"対面して話すのがとても苦手で、どうしても上手く言葉が出てこない。"},{"spoiler":false,"text":"――が、お手紙の中ではリミッターが外れてスーパーハイテンションになる。"},{"spoiler":false,"text":"とっても寂しがり屋さんでもあり、対等な関係のおともだちに飢えている。"},{"spoiler":false,"text":"イストリアは文通相手で、時折相談に乗ってもらっている。"},{"spoiler":false,"text":"「……海のものは、うねうね、ぬるぬる。きらい」"}],"source":"bangumi","sourceCharacterId":"68157"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28338560718c9c39f265339d8395ba0678aa3fe184e7d46d26141cbe50f90ec0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/830901c3da3215c989aa9d120f9bc254c8535054ac85e8bfdca626ec01c7422b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小澤みのり","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301834:68157:32659:1","source":"bangumi"}]},{"characterId":"char_c90613","characterName":"いばら","sourceIds":{"bangumi":[{"characterId":"76110","match":"exact-normalized-name-in-linked-work","subjectId":"301834"}],"egsCharacterIds":["22477"],"vndbCharacterId":"c90613"},"originalCharacterName":"いばら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character of one of Grimm's Fairy Tales: \"Little Briar Rose\"."},{"spoiler":false,"text":"A sleepy girl who has been given a role to fall asleep anytime and anywhere, a unique heroine who can be seen unconscious more often than awake."},{"spoiler":false,"text":"Only princes or those who are recognized as princes are allowed to wake her up. The small moments she spent awake are used for her private time."},{"spoiler":false,"text":"Has been seen napping everywhere."},{"spoiler":false,"text":"\"Waiting around all the time is boring... I want to experience the newlywed life with the prince...\""},{"spoiler":false,"text":"Edited from Official Website"}],"source":"vndb","sourceCharacterId":"c90613"},{"segments":[{"spoiler":false,"text":"グリム童話集『いばら姫』のプリマ。"},{"spoiler":false,"text":"いつでもどこでもうたた寝してしまうおやすみお姉さん。"},{"spoiler":false,"text":"その役割を果たすため、普段はずっと眠り続けている、他のプリマとは異なる特殊な存在。"},{"spoiler":false,"text":"そんないばらを起こせるのは王子様、あるいはそれと認められたもののみに限られる。"},{"spoiler":false,"text":"役割として眠っている時以外は基本プライベートな時間となるが、普段の生活でもうたた寝していることが多く、いたるところでお昼寝している姿が目撃されている。"}],"source":"egs","sourceCharacterId":"22477","sourceWorkId":"29053","spoiler":false},{"segments":[{"spoiler":false,"text":"どこでもすやすや。眠れるお姉さん"},{"spoiler":false,"text":"「ずーっと待ってるばっかりじゃつまらないしー、王子様との新婚生活が、したいなー」"},{"spoiler":false,"text":"グリム童話集『いばら姫』のプリマ。いつでもどこでもうたた寝してしまうおやすみお姉さん。"},{"spoiler":false,"text":"その役割を果たすため、普段はずっと眠り続けている、他のプリマとは異なる特殊な存在。"},{"spoiler":false,"text":"そんないばらを起こせるのは王子様、あるいはそれと認められたもののみに限られる。"},{"spoiler":false,"text":"役割として眠っている時以外は基本プライベートな時間となるが、普段の生活でもうたた寝していることが多く、"},{"spoiler":false,"text":"いたるところでお昼寝している姿が目撃されている。"}],"source":"bangumi","sourceCharacterId":"76110"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bd1d8cc75dfa7113c7c8e7691b383c547804eb621f57a69e356230efa91af92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/600c2fed75a7ce51de2c295f74ea5573b4ebe30600d9526754b76ee7902c2473.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:301834:76110:10026:1","source":"bangumi"}]},{"characterId":"char_vndb_c76014","characterName":"久里 詠斗","sourceIds":{"vndbCharacterId":"c76014"},"originalCharacterName":"久里 詠斗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school student who loves stories of all kinds. He even daydreams about old tales and puts his emotions into roleplaying as the characters in a story."},{"spoiler":false,"text":"One afternoon, he is told to think about his career path after graduating from high school. As he is not talented and doesn't have any distinguishing traits besides a love of stories, he goes to the school library, his favourite haunt, to think things over. The teaching assistant Hanami recounts her own experiences about dreams and a career path, and shortly after they part ways Eito is summoned to the Great Library to be the latest Librarian."},{"spoiler":true,"text":"Through his experiences as a Librarian, Eito eventually charts his future career path as an editor. He is allowed to keep his Colette, which allows him to retain the connections he made during his stay at the Great Library."}],"source":"vndb","sourceCharacterId":"c76014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/1500ee7550b599ae072abca3b0bf89dc8f2de1f9bf27e893fe15ada86403c84a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d66dd7c2fe464cd32fe7b7b8b8a4134ae8373a54f836529b31b01c8481fc48b.webp","width":154,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c87631","characterName":"グリム","sourceIds":{"vndbCharacterId":"c87631"},"originalCharacterName":"グリム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Register based on the Grimm Brothers, the authors of the original stories within the collection of Grimm's Fairy Tales. She's in charge of all the stories in the collection. Has a dual personality."},{"spoiler":false,"text":"The personality \"Jacob\" has a boyish air around her and is a bit of a fickle. She's loyal to her desires, likes to play pranks, and is always getting into trouble."},{"spoiler":false,"text":"\"Haaa... I wonder whether this Librarian actually doesn't know anything.\""},{"spoiler":false,"text":"The other personality, \"Wilhelm\", is a bit unreliable. Serious, kind, and gentle, she's a character that symbolizes the stories of Grimm's Fairy Tales. Has a strong desire to do something for others."},{"spoiler":false,"text":"However, she tends to shoulder problems on her own and doesn't care much about herself."},{"spoiler":false,"text":"\"...Recently, I noticed that you've been feeling a little down.\""},{"spoiler":false,"text":"Edited from Official Website"}],"source":"vndb","sourceCharacterId":"c87631"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69060eae1874c32ff1769136bc6e63384ccb22ff4afb748591524f27b9752285.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee83cbf64bb250f97fa32f7f039bd6a74c31136c1275dc778f535c9596c2feb8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あじ 秋刀魚","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84672","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p8074","sourceCompanyId":"egs:brand:5899","canonicalEntityId":"vndb:p8074","name":"ユメミル","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29053:5899","source":"egs"},{"companyId":"vndb:p8074","sourceCompanyId":"vndb:p8074","canonicalEntityId":"vndb:p8074","name":"ユメミル","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:76551:v28482","source":"vndb"},{"companyId":"vndb:p8074","sourceCompanyId":"vndb:p8074","canonicalEntityId":"vndb:p8074","name":"ユメミル","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:84814:v28482","source":"vndb"},{"companyId":"vndb:p8074","sourceCompanyId":"vndb:p8074","canonicalEntityId":"vndb:p8074","name":"ユメミル","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:84815:v28482","source":"vndb"},{"companyId":"vndb:p8074","sourceCompanyId":"vndb:p8074","canonicalEntityId":"vndb:p8074","name":"ユメミル","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:84816:v28482","source":"vndb"},{"companyId":"vndb:p8074","sourceCompanyId":"vndb:p8074","canonicalEntityId":"vndb:p8074","name":"ユメミル","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:88463:v28482","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
