"roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:107839","source":"egs"},{"creditedName":"水夏える(L-Minatsu)","creatorId":"vndb:s710","sourcePersonId":"egs:creator:17413","canonicalEntityId":"vndb:s710","name":"水夏える(L-Minatsu","detail":"効果音","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:229415","source":"egs"},{"creditedName":"風麟","creatorId":"vndb:s3560","sourcePersonId":"vndb:s3560","canonicalEntityId":"vndb:s3560","name":"風麟","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:90102","source":"vndb"}]},"cast":[{"characterId":"char_c14587","characterName":"護","sourceIds":{"bangumi":[{"characterId":"48725","match":"exact-normalized-name-in-linked-work","subjectId":"47261"}],"egsCharacterIds":["23"],"vndbCharacterId":"c14587"},"originalCharacterName":"護","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young boy who survived a catastrophic event that devastated his village."},{"spoiler":false,"text":"Fortuitously discovered by the Kamishiro family, he was taken in and raised as one of their own, eventually becoming a loyal servant to the household."},{"spoiler":false,"text":"Having forged strong bonds with the three main heroines throughout their shared upbringing, Mamoru is fiercely committed to safeguarding them from any foes they may face."}],"source":"vndb","sourceCharacterId":"c14587"},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"過去に村を襲った大火災の生存者。"},{"spoiler":false,"text":"たまたま居合わせた神代家の家族に拾われ、神代家の家族同様に育てられる。"},{"spoiler":false,"text":"現在は、神代家の使用人として働いている。"}],"source":"egs","sourceCharacterId":"23","sourceWorkId":"14862","spoiler":false},{"segments":[{"spoiler":false,"text":"过去袭击村子的大火灾中的幸存者。"},{"spoiler":false,"text":"被偶然在场的神代家的人给捡到，被当成神代家的人般养育着。"},{"spoiler":false,"text":"长大后作为神代家的佣人而工作着。"}],"source":"bangumi","sourceCharacterId":"48725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31df1ea71db6b35d019ec1e7fcd50d9d7248d68213d050bb6a203b6c469bc839.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eea3538611ee398c7ac889242ace8514440d12fa18b82ccb4b7f8d0d72026554.webp","width":250,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_c23011","characterName":"神代 琴音","sourceIds":{"bangumi":[{"characterId":"16818","match":"exact-normalized-name-in-linked-work","subjectId":"47261"}],"egsCharacterIds":["20"],"vndbCharacterId":"c23011"},"originalCharacterName":"神代 琴音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mamoru's older sister, who survived the village fire and was adopted by the Kamishiro family alongside Mamoru, becomes the \"pearl\" among them."},{"spoiler":false,"text":"Kotone is an amiable girl who treats everyone equally and spends most of her time in the garden admiring flowers. She loves her family and is willing to go to any length to protect them, especially her beloved little brother, whom she cherishes the most."},{"spoiler":true,"text":"It is later revealed that Mamoru and Kotone are not related by blood, which Kotone is well aware of."}],"source":"vndb","sourceCharacterId":"c23011"},{"segments":[{"spoiler":false,"text":"名門神代家の長女。名家の令嬢として非の打ち所のない、誰からも愛されるやさしい女性。主人公弟のように溺愛している。"},{"spoiler":false,"text":"過去に行われた、ある行事によって、心と身体を蝕まれてしまう。"},{"spoiler":false,"text":"主人公のおかげで体調が回復するも、再び、その行事が開かれることに……。"},{"spoiler":false,"text":"「２人だけのときは、いつも通りでいいのよ？"},{"spoiler":false,"text":"護に敬語を使われると、何だか寂しい気持ちになるわ」"}],"source":"egs","sourceCharacterId":"20","sourceWorkId":"14862","spoiler":false},{"segments":[{"spoiler":false,"text":"名门・神代家的长女。"},{"spoiler":false,"text":"作为名门千金完美无缺的每个人都对其仰慕不已的温柔女性。"},{"spoiler":false,"text":"将主人公当做弟弟般地溺爱。"},{"spoiler":false,"text":"因为过去进行的某个仪式的原因，心和身体遭到侵蚀。"},{"spoiler":false,"text":"虽然多亏了主人公的原因身体得到了恢复，但是那个仪式又会再次召开……。"},{"spoiler":false,"text":"「只有两个人的时候，和平时一样就可以了哦？護用敬语来对我说话，总感觉有些寂寞呢」"}],"source":"bangumi","sourceCharacterId":"16818"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"20","sourceWorkId":"14862","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"20","sourceWorkId":"14862","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"20","sourceWorkId":"14862","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd8f90c762edeac1800a0b9bb3d4bbe2c17262c85819df6dcd3e23d09a37e357.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4710cefe3e116ae906ffed43556aafbdb2f2251b99cb4a5843060ef76e75c97b.webp","width":105,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星野千寿子","creatorId":"vndb:s128","sourcePersonId":"vndb:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:47261:16818:4210:1","source":"bangumi"}]},{"characterId":"char_c23012","characterName":"神代 紗夜","sourceIds":{"bangumi":[{"characterId":"16819","match":"exact-normalized-name-in-linked-work","subjectId":"47261"}],"egsCharacterIds":["21"],"vndbCharacterId":"c23012"},"originalCharacterName":"神代 紗夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"97"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Saya, the wife of Kamishiro Ikki and mother to Ririko, cherishes Mamoru and Kotone as if they were her own. Shouldering the weight of the Kamishiro family in place of her sickly husband, she traverses across the country offering her support. In the face of a looming deadline to produce a male heir, Saya grapples with mounting desperation."}],"source":"vndb","sourceCharacterId":"c23012"},{"segments":[{"spoiler":false,"text":"神代家の当主・神代一騎の妻。琴音と莉々子の母。"},{"spoiler":false,"text":"病床にある夫・一騎に代わり、神代家を支えるため、各地を飛び回っている。"},{"spoiler":false,"text":"男子の跡取りの問題で悩んでいるが、そこに付け込まれてしまうことに……。"},{"spoiler":false,"text":"主人公を我が子のように愛している、包容力にあふれる大人の女性。"},{"spoiler":false,"text":"「護さん……あなたは、私にとって大切な家族よ。"},{"spoiler":false,"text":"たとえ使用人になっても、それは変わらない……。"},{"spoiler":false,"text":"娘達だって、きっとそう思っているわ」"}],"source":"egs","sourceCharacterId":"21","sourceWorkId":"14862","spoiler":false},{"segments":[{"spoiler":false,"text":"神代家当主・神代一騎的妻子。琴音和莉々子的母亲。"},{"spoiler":false,"text":"为了代替病榻上的丈夫・一騎支撑神代家而在各地到处巡回。"},{"spoiler":false,"text":"因为男性子嗣的问题处于苦恼之中，但这一点被乘机利用……。"},{"spoiler":false,"text":"对待主人公宛如儿子一般爱护，充满包容力的成熟女性。"},{"spoiler":false,"text":"「護……你对我来说也是重要的家人哦。就算是佣人也好，这一点也完全没变……。 女儿们也一定这么想的」"}],"source":"bangumi","sourceCharacterId":"16819"}],"profileFacts":[{"label":"胸围（本版本）","value":"97 cm","valueContext":null,"source":"egs","sourceCharacterId":"21","sourceWorkId":"14862","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"21","sourceWorkId":"14862","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"21","sourceWorkId":"14862","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39e6403d212da92f9812d1af1d634a7f5b7ff0aa515c646db9374b2856014cf4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d012a8370451fac7bca3392bdc9bd10e6a31dd9ff03529863bb91b7a2dae95d.webp","width":105,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊東もえ","creatorId":"vndb:s3678","sourcePersonId":"vndb:s3678","canonicalEntityId":"vndb:s3678","name":"伊東 もえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:47261:16819:25372:1","source":"bangumi"}]},{"characterId":"char_c23013","characterName":"神代 莉々子","sourceIds":{"bangumi":[{"characterId":"16820","match":"exact-normalized-name-in-linked-work","subjectId":"47261"}],"egsCharacterIds":["22"],"vndbCharacterId":"c23013"},"originalCharacterName":"神代 莉々子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second daughter of the Kamishiro family, she adores Mamoru like her own older brother. Ririko is a young girl with an underdeveloped body. She prefers to wear kimono, tabi socks, and sandals."}],"source":"vndb","sourceCharacterId":"c23013"},{"segments":[{"spoiler":false,"text":"次女。和装を好む純朴なお嬢様。"},{"spoiler":false,"text":"生まれつき体が弱く、屋敷から外に出ることは少ない。"},{"spoiler":false,"text":"主人公のことを「兄さま」と呼んで慕っている。"},{"spoiler":false,"text":"性の知識に疎いので、そこを付け入られてしまうことに……。"},{"spoiler":false,"text":"「どうして？"},{"spoiler":false,"text":"莉々子が兄さまと仲良くすることは、"},{"spoiler":false,"text":"いけないことなの……？」"}],"source":"egs","sourceCharacterId":"22","sourceWorkId":"14862","spoiler":false},{"segments":[{"spoiler":false,"text":"次女。喜欢穿和服的纯朴大小姐。"},{"spoiler":false,"text":"天生身体虚弱，很少走出房邸。"},{"spoiler":false,"text":"称呼主人公为「哥哥大人」并爱慕着。"},{"spoiler":false,"text":"对性的知识很疏远，这一点被乘隙而入……。"},{"spoiler":false,"text":"「为什么？　莉々子和哥哥大人变得亲密起来，是不好的事情吗……？」"}],"source":"bangumi","sourceCharacterId":"16820"}],"profileFacts":[{"label":"胸围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"22","sourceWorkId":"14862","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"22","sourceWorkId":"14862","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"22","sourceWorkId":"14862","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/930f33abf0c19bbb1d6145dcd50bf52d6bd3a301855b5111d5bb48f74748baf5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fe80025443aea7000bbcbba0c9ecaea45616296c3723b135e02f651c6971c5b.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡田純子","creatorId":"vndb:s1120","sourcePersonId":"vndb:s1120","canonicalEntityId":"vndb:s1120","name":"岡田 純子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:47261:16820:4947:1","source":"bangumi"}]},{"characterId":"char_vndb_c32384","characterName":"兼田 響子","sourceIds":{"vndbCharacterId":"c32384"},"originalCharacterName":"兼田 響子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Saya's attractive friend. Despite being married with a son, she can't resist the temptation of pursuing a passionate liaison with Mamoru."}],"source":"vndb","sourceCharacterId":"c32384"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08dfd87a42629bb82616791ffca96416dcdb9c644969218514d4b4fefbcd00e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/743f9dd95596f5a123c336adcaa61abde6c19c05a4eed0d9b3e5e9ff39ce4027.webp","width":250,"height":250,"source":"static-detail"},"actors":[{"creditedName":"今井 美月","creatorId":"vndb:s462","sourcePersonId":"vndb:s462","canonicalEntityId":"vndb:s462","name":"藤原 美央子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47849","source":"vndb"}]},{"characterId":"char_vndb_c32385","characterName":"雪乃","sourceIds":{"vndbCharacterId":"c32385"},"originalCharacterName":"雪乃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Kamishiro household's silver-haired maid."},{"spoiler":false,"text":"Yukino is a remarkably skilled and efficient worker despite her relatively young age compared to Mamoru. She manages the lion's share of the domestic tasks, ensuring the smooth operation of the household."},{"spoiler":false,"text":"Yukino is known for her reserved nature, often maintaining a cold demeanor and engaging in limited interactions with others."},{"spoiler":true,"text":"Depending on the choices made, she may fall for Mamoru and bear his child or be targeted by villagers and face dire consequences."}],"source":"