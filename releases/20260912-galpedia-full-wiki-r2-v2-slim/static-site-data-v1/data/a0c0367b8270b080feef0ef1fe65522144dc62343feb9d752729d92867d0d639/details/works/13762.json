"originalCharacterName":"宝井 恵里子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"40"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"More than ten years ago, when her daughter was still young, she lost her husband. Since then, she has raised her daughter with only the slender arms of a woman."},{"spoiler":false,"text":"Dedicated to her daughter she had abandoned her womanhood without even realizing it. Recently, her daughter got married and moved out, bringing a sense of closure to her life."},{"spoiler":false,"text":"The appearance of the protagonist, who is the same age as her daughter, stimulates her motherhood and her womanhood."},{"spoiler":false,"text":"Although she is now seen by others as an old lady, her youth, though short, was spent at the height of the bubble economy, and she was a cheerful girl who enjoyed the night life."},{"spoiler":false,"text":"She is reclusive and timid, but gradually regains her true self as she takes care of the main character, who has a positive attitude, and as they soon become man and woman."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c30573"},{"segments":[{"spoiler":false,"text":"同じ団地に住む独りぼっちの未亡人。"},{"spoiler":false,"text":"元々は明るく派手好きだったが、長い母子生活が女性としてズボラにしてしまった。"},{"spoiler":false,"text":"絵に対して前向きな主人公と世話好きなメインヒロインに背中を押されて、徐々に本来の自分を取り戻していく。"},{"spoiler":false,"text":"最初は奥底に眠る母性本能が復活し、夫が死んでからの子育てはただ忙しいといった感じだけだったため、じっくりと愛情を注ぎ込む母性に気持ちよさを覚えことになる。"}],"source":"egs","sourceCharacterId":"12259","sourceWorkId":"13762","spoiler":false},{"segments":[{"spoiler":false,"text":"同じ団地に住む独りぼっちの未亡人。"},{"spoiler":false,"text":"元々は明るく派手好きだったが、長い母子生活が女性としてズボラにしてしまった。"},{"spoiler":false,"text":"絵に対して前向きな主人公と世話好きなメインヒロインに背中を押されて、徐々に本来の自分を取り戻していく。"},{"spoiler":false,"text":"最初は奥底に眠る母性本能が復活し、夫が死んでからの子育てはただ忙しいといった感じだけだったため、じっくりと愛情を注ぎ込む母性に気持ちよさを覚えことになる。"}],"source":"bangumi","sourceCharacterId":"49707"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"49707","value":"主婦（近所のスーパーでパート）"},{"label":"年龄（本版本）","value":"40 岁","valueContext":null,"source":"egs","sourceCharacterId":"12259","sourceWorkId":"13762","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"12259","sourceWorkId":"13762","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"12259","sourceWorkId":"13762","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"12259","sourceWorkId":"13762","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"12259","sourceWorkId":"13762","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"12259","sourceWorkId":"13762","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e14e99fd95871cf1b55b6b7de8659b59126d47e904a3d4155707f3f3ee72dc5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ea97a2b00514ad6dfff6263db37efa7f43ac385c3cc98b04904c4278b08315c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vn