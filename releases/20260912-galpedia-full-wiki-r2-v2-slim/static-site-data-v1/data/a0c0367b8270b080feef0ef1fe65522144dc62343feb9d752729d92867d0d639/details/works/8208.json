4d4b403bb1f12394243afc762565433c6d3b886e52b18d90b1a5fbb4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:447072:140202:4490:1","source":"bangumi"}]},{"characterId":"char_c84018","characterName":"春日 朱美","sourceIds":{"bangumi":[{"characterId":"140203","match":"exact-normalized-name-in-linked-work","subjectId":"447072"}],"egsCharacterIds":["25095"],"vndbCharacterId":"c84018"},"originalCharacterName":"春日 朱美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公ラブなひとつ年上の幼なじみ。毎朝あの手この手で主人公にアタックを仕掛けてくる。"},{"spoiler":false,"text":"明朗快活で押しが強い性格。"},{"spoiler":false,"text":"弓道部の主将だが、主人公の好きなタイプ＝大和撫子を追求しようと、わざわざ「巫女部」を立ち上げる。巫女にした理由は、主人公が巫女に憧れているから…らしい。"},{"spoiler":false,"text":"料理は壊滅的にヘタ"}],"source":"egs","sourceCharacterId":"25095","sourceWorkId":"8208","spoiler":false},{"segments":[{"spoiler":false,"text":"明朗快活で、押しの強い幼馴染。"},{"spoiler":false,"text":"主人公のことが大好きで、日々誘惑に余念がない。"},{"spoiler":false,"text":"弓道部の主将だが、主人公の好きな女性のタイプ＝大和撫子を追求しようと、わざわざ巫女部を立ち上げた。"},{"spoiler":false,"text":"なぜ「巫女部」なのかは、主人公が密かに巫女に憧れているから…らしい。"}],"source":"bangumi","sourceCharacterId":"140203"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08ede8a76c4ebd52201af8e3a4dd558593722ba5fa78e071d1433f3639d3adf5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e754b19f500bd8db21c47608f61c43314d0c2c5dc66df2daaa4f341318124399.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"〆野潤子","creatorId":"vndb:s5676","sourcePersonId":"vndb:s5676","canonicalEntityId":"vndb:s5676","name":"〆野 潤子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:447072:140203:5080:1","source":"bangumi"}]},{"characterId":"char_c84019","characterName":"高千穂 五十鈴","sourceIds":{"bangumi":[{"characterId":"140204","match":"exact-normalized-name-in-linked-work","subjectId":"447072"}],"egsCharacterIds":["25096"],"vndbCharacterId":"c84019"},"originalCharacterName":"高千穂 五十鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、一途な性格の眼鏡っ娘。奥手で、言いたいことをはっきり言えないわりに、口を開くといらんことまでしゃべる天然自爆ドジ娘。"},{"spoiler":false,"text":"自分から巫女部への入部を志願した。現在は会計兼お茶係。図書委員も兼任している。"},{"spoiler":false,"text":"家はかなり裕福で、毎朝黒塗りのリムジンに乗って登校するが学園から離れた場所で他の生徒に見つからないよう乗り降りしている。"}],"source":"egs","sourceCharacterId":"25096","sourceWorkId":"8208","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生で、一途な眼鏡っ娘。"},{"spoiler":false,"text":"巫女に憧れて巫女部に入部した、会計兼お茶係。"},{"spoiler":false,"text":"言いたい事がはっきりと言えないわりに、口を開けば言わなくていいような事まで喋ってしまう、天然自爆娘。"}],"source":"bangumi","sourceCharacterId":"140204"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7189f610a25740d8cbf489eb9c4a083eaeb7c395476381844e48baf3541cb6e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd338029655c61186366d5e60d7146424faa1ec2441913e456f0d3861e1f8557.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南川のりこ","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:447072:140204:20327:1","source":"bangumi"}]},{"characterId":"char_c84020","characterName":"出海 藍","sourceIds":{"bangumi":[{"characterId":"140206","match":"exact-normalized-name-in-linked-work","subjectId":"447072"}],"egsCharacterIds":["25097"],"vndbCharacterId":"c84020"},"originalCharacterName":"出海 藍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"朱美がその評判を聞きスカウトしてきた後輩。寡黙で表情に乏しいが、主人公の前では顔を赤らめたりする。"},{"spoiler":false,"text":"妖怪や幽霊のたぐいが見える霊感少女で、そのせいで周囲から浮いており、巫女部に入るまではひとりの時間を過ごすことが多かった。"},{"spoiler":false,"text":"人付き合いが苦手だが、朱美いわく「コミュニケーションが下手」なだけ。意外に面倒見は良い。"},{"spoiler":false,"text":"石像を軽々と持ち上げるなど謎な面も多い。"}],"source":"egs","sourceCharacterId":"25097","sourceWorkId":"8208","spoiler":false},{"segments":[{"spoiler":false,"text":"表情に乏しい、寡黙な後輩。"},{"spoiler":false,"text":"朱美にスカウトされて巫女部に入部した。"},{"spoiler":false,"text":"妖怪や幽霊のたぐいを見てしまう霊感少女で、そのせいで周囲からは遠巻きにされている。"},{"spoiler":false,"text":"人付き合いは苦手だが、以外に面倒見が良い。"}],"source":"bangumi","sourceCharacterId":"140206"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf865d694f70056d0ec55a17d3fd091423c28b963d3ffc7ee3400880499fc2e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbad3863f26b9cebe5290e1babfb3ea2ae71f8f38b05a68b09f5bd46a1442ed9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田依子","creatorId":"vndb:s797","sourcePersonId":"vndb:s797","canonicalEntityId":"vndb:s797","name":"永田 依子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:447072:140206:5104:1","source":"bangumi"}]},{"characterId":"char_c84021","characterName":"竹野 まどか","sourceIds":{"bangumi":[{"characterId":"140207","match":"exact-normalized-name-in-linked-work","subjectId":"447072"}],"egsCharacterIds":["25098"],"vndbCharacterId":"c84021"},"originalCharacterName":"竹野 まどか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスの担任で国語教師、「巫女部」の顧問。お茶・お花・日本舞踊の師範代で、絵に描いたような大和撫子。実家が神社であることもあって、巫女としての外枠はほぼ完璧。"},{"spoiler":false,"text":"常に微笑を絶やさないが、その実態は海千山千で、相手を煙に巻くのが大好きな困った人。"},{"spoiler":false,"text":"主人公たちに「儀式」を提案する。ミサキについてもいろいろ知っているらしいが…？"}],"source":"egs","sourceCharacterId":"25098","sourceWorkId":"8208","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の担任にして「巫女部」の顧問、常に微笑を絶やさない国語教師。"},{"spoiler":false,"text":"お茶・お花・日本舞踊の師範代で、絵に描いたような大和撫子。"},{"spoiler":false,"text":"実家が神社であることもあって、巫女としての外枠は、ほぼ完璧。"},{"spoiler":false,"text":"しかし、その実態は海千山千で、相手を煙に巻くのが大好きな困った人。"}],"source":"bangumi","sourceCharacterId":"140207"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df979e385d9ed97728eb560cc6dc341b1970ea2fb5758f024f8ba2a81c66ae04.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/550030b88ddaedc3054a66ef6149c7a60999eb73662eb66e6be015fcfccab595.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:447072:140207:4937:1","source":"bangumi"}]},{"characterId":"char_vndb_c84022","characterName":"黒命婦","sourceIds":{"vndbCharacterId":"c84022"},"originalCharacterName":"黒命婦","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions"