-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0823"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヘーメラー最後の切り札にして、"},{"spoiler":false,"text":"上層部トップ2の一人。"},{"spoiler":false,"text":"アイ病の第一人者であり、"},{"spoiler":false,"text":"世界で初めてワールドトラベルを行った。"},{"spoiler":false,"text":"仕事が早いドライな性格で、演技派。"},{"spoiler":false,"text":"全てを完璧にこなせるあまり"},{"spoiler":false,"text":"化け物・神様などと言われている。"},{"spoiler":false,"text":"海と人魚、"},{"spoiler":false,"text":"全ての人間を愛している。"}],"source":"bangumi","sourceCharacterId":"91418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da8a87a819155da19fe20eafa34fbbcb92e4ad925fcfb509543293320e0f3a33.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/5140bde8d3a252c3deace9e50bd0748da8c0d6fdc1a3a7e06b484260a8307b55.webp","width":256,"height":196,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_91427","characterName":"モコモコ","sourceIds":{"bangumi":[{"characterId":"91427","match":"source-roster","subjectId":"314825"},{"characterId":"91427","match":"source-roster","subjectId":"322273"},{"characterId":"91427","match":"source-roster","subjectId":"327158"},{"characterId":"91427","match":"source-roster","subjectId":"446754"}]},"originalCharacterName":"モコモコ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"17"},"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ある雪の日、山中で迷子になっていた女性。"},{"spoiler":false,"text":"身元不明、絢爛の家で保護される。"},{"spoiler":false,"text":"彼に誘われて赤音高校の捜査部に入部する。"},{"spoiler":false,"text":"正義心が強く、自分の正義が"},{"spoiler":false,"text":"揺らぎそうになれば"},{"spoiler":false,"text":"すぐに相手を挑発する。"},{"spoiler":false,"text":"自分自身の記憶があいまいであり、"},{"spoiler":false,"text":"どうして自分が山中にいたのか"},{"spoiler":false,"text":"分かっていない。"}],"source":"bangumi","sourceCharacterId":"91427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81c8eedda48bcafaa74c4f8199f45504bf9ddbf52f04770858f1fc0b1e36e2bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec4689555e267e5ac195df9a4f857e363570063fc955af877d19b74e51ff93a2.webp","width":256,"height":196,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_91428","characterName":"店长","sourceIds":{"bangumi":[{"characterId":"91428","match":"source-roster","subjectId":"314825"},{"characterId":"91428","match":"source-roster","subjectId":"322273"},{"characterId":"91428","match":"source-roster","subjectId":"327158"},{"characterId":"91428","match":"source-roster","subjectId":"330516"},{"characterId":"91428","match":"source-roster","subjectId":"446754"}]},"originalCharacterName":"店长","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0222"},"height":{"reviewState":"source-only","source":"bangumi","value":"174"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"mask唯白卫合/mask"},{"spoiler":false,"text":"並行世界で初めてアイ病が発症した"},{"spoiler":false,"text":"1600年世界からやってきた。"},{"spoiler":false,"text":"浮世離れした男性。"},{"spoiler":false,"text":"アイ病のカラクリを全世界で"},{"spoiler":false,"text":"初めて解いたが、魔女狩りに遭い"},{"spoiler":false,"text":"別世界ヘワールドトラベルする。"},{"spoiler":false,"text":"英雄と深い因縁があり、"},{"spoiler":false,"text":"ありとあらゆる世界の"},{"spoiler":false,"text":"英雄を殺している。"},{"spoiler":false,"text":"有关名字：mask结代依拷/唯白卫合=ゆいしろえごう重新排