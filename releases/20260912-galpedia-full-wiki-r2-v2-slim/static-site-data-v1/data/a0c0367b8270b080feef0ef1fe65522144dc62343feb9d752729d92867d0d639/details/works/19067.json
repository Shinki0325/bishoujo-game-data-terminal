"identityStatus":"auto-confirmed","relationId":"egs:work-creator:152339","source":"egs"},{"creditedName":"Luna","creatorId":"vndb:s1202","sourcePersonId":"vndb:s1202","canonicalEntityId":"vndb:s1202","name":"水谷 瑠奈","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:99708","source":"vndb"},{"creditedName":"こうぐち もと","creatorId":"vndb:s4088","sourcePersonId":"vndb:s4088","canonicalEntityId":"vndb:s4088","name":"こうぐち もと","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:99709","source":"vndb"}]},"cast":[{"characterId":"char_c16092","characterName":"櫻木 文香","sourceIds":{"bangumi":[{"characterId":"22431","match":"exact-normalized-name-in-linked-work","subjectId":"233844"},{"characterId":"22431","match":"exact-normalized-name-in-linked-work","subjectId":"73980"}],"egsCharacterIds":["1658"],"vndbCharacterId":"c16092"},"originalCharacterName":"櫻木 文香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruki's classmate. Beautiful, smart, popular and athletic, she is every boy's dream girl."}],"source":"vndb","sourceCharacterId":"c16092"},{"segments":[{"spoiler":false,"text":"メインヒロインの一人。"},{"spoiler":false,"text":"一見するとしっかり者のクラス委員だが、実はドジで天然なところも多い。"},{"spoiler":false,"text":"男子からの人気は高いが、高嶺の花だと思われて、あまり告白を受ける機会は無かった。"},{"spoiler":false,"text":"潜在的なＭ気質があり、特に精神的な辱めに悦楽を感じる。"},{"spoiler":false,"text":"■好きなもの■"},{"spoiler":false,"text":"ウサギ、およびウサギのキャラクターグッズ。"},{"spoiler":false,"text":"食べ物では和食、あっさりした物が好き。"},{"spoiler":false,"text":"■将来の夢■"},{"spoiler":false,"text":"誰かに愛されたい、必要とされる家族の一員になりたい。"}],"source":"egs","sourceCharacterId":"1658","sourceWorkId":"19067","spoiler":false},{"segments":[{"spoiler":false,"text":"晴樹のクラスメートで、男子からも非常に人気が高いクラス委員長。"},{"spoiler":false,"text":"エッチに対する恥ずかしさは強いが、晴樹に言われたことは頑張ってやろうとする。"},{"spoiler":false,"text":"潜在的なＭ気質があり、特に精神的な辱めの悦楽を感じる。"},{"spoiler":false,"text":"『キュートリゾート』ではいつもより開放的なエッチで、より辱められる興奮を感じる。"}],"source":"egs","sourceCharacterId":"1658","sourceWorkId":"26258","spoiler":false},{"segments":[{"spoiler":false,"text":"一見するとしっかり者のクラス委員だが、実はドジで天然なところも多い。"},{"spoiler":false,"text":"男子からの人気は高いが高嶺の花だと思われて、あまり告白を受ける機会は無かった。"},{"spoiler":false,"text":"潜在的なM気質があり、特に精神的な辱めに悦楽を感じる。"},{"spoiler":false,"text":"「私たちって付き合ってるように見えるのかな？　私は嫌じゃないよ……」"}],"source":"bangumi","sourceCharacterId":"22431"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a8dc1267a461ea85fb1e37deb9718b888bfc5116a0e42f75af8d7b37d11cc37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00de36f37f0386bf747b37e8c08b1d8e67b460395b1ab5d294fba3d9e8ad66ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73980:22431:11646:1","source":"bangumi"}]},{"characterId":"char_c16093","characterName":"青柳 夏弥","sourceIds":{"bangumi":[{"characterId":"22432","match":"exact-normalized-name-in-linked-work","subjectId":"233844"},{"characterId":"22432","match":"exact-normalized-name-in-linked-work","subjectId":"73980"}],"egsCharacterIds":["1659"],"vndbCharacterId":"c16093"},"originalCharacterName":"青柳 夏弥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hazuki's another classmate who is also very popular. Very lively and energetic, many of the boys from school want her as their girlfriend."}],"source":"vndb","sourceCharacterId":"c16093"},{"segments":[{"spoiler":false,"text":"メインヒロインの一人。"},{"spoiler":false,"text":"交友関係が広く、男女関係なく気軽に付き合うノリの良い子。"},{"spoiler":false,"text":"しかし特定の彼氏がいたことはなく、Ｈな経験は皆無。"},{"spoiler":false,"text":"Ｈなことに興味自体はあるので、いろいろ見たり調べたりはしている。"},{"spoiler":false,"text":"■好きなもの■"},{"spoiler":false,"text":"おしゃれや、それに伴う雑誌やウインドウショッピング。"},{"spoiler":false,"text":"マンゴー関係のお菓子。"},{"spoiler":false,"text":"■将来の夢■"},{"spoiler":false,"text":"ラフに過ごして、人並みに恋をして、気楽に楽しく暮らしたい"}],"source":"egs","sourceCharacterId":"1659","sourceWorkId":"19067","spoiler":false},{"segments":[{"spoiler":false,"text":"晴樹のクラスメートで、文香と並んで男子からの人気が高い小悪魔女子生徒。"},{"spoiler":false,"text":"エッチなことに興味関心があり、晴樹に言われることにも積極的な姿勢を見せる。"},{"spoiler":false,"text":"ただし経験自体はゼロだったので、童貞だった晴樹と一緒に楽しみながら色々と経験していく。"},{"spoiler":false,"text":"『キュートリゾート』でも、リゾート旅行とエッチの両方を晴樹と一緒に楽しんでいる。"}],"source":"egs","sourceCharacterId":"1659","sourceWorkId":"26258","spoiler":false},{"segments":[{"spoiler":false,"text":"交友関係が広く、男女関係なく気軽に付き合うノリの良い子。"},{"spoiler":false,"text":"しかし特定の彼氏がいたことはなく、エッチな経験は皆無。"},{"spoiler":false,"text":"エッチなことへの興味はあるので、いろいろ見たり調べたりはしている。"},{"spoiler":false,"text":"「あ、開き直っちゃった。 エッチでもいいんだよ。あたしのパートナーなんだから」"}],"source":"bangumi","sourceCharacterId":"22432"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/427a954f66bb61c2056d7d6185f9dba9327dd0d91f2acef6808903acd2f58367.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23696359797de9ebc409e9426738eacbd1cc3e7fbbd20f66d55e5592e5389e8b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73980:22432:15684:1","source":"bangumi"}]},{"characterId":"char_c16094","characterName":"水谷 通草","sourceIds":{"bangumi":[{"characterId":"22433","match":"exact-normalized-name-in-linked-work","subjectId":"233844"},{"characterId":"22433","match":"exact-normalized-name-in-linked-work","subjectId":"73980"}],"egsCharacterIds":["1660"],"vndbCharacterId":"c16094"},"originalCharacterName":"水谷 通草","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruki's twin sister. They look like a normal brother and sister, but in fact, she is in love with him."}],"source":"vndb","sourceCharacterId":"c16094"},{"segments":[{"spoiler":false,"text":"晴樹とは二卵性双生児の妹。"},{"spoiler":false,"text":"小さい頃から両親は仕事で忙しかったので、寂しくてよく晴樹にくっついて行動していた。"},{"spoiler":false,"text":"今はもうそんなことは無いが、でも仲が良く、じゃれついたりするのは相変わらず。"},{"spoiler":false,"text":"二人を知らない人からは、たまに恋人だと間違われる。"},{"spoiler":false,"text":"■好きなもの■"},{"spoiler":false,"text":"あまり悩まず、手軽に楽しめるもの全般。"},{"spoiler":false,"text":"和洋にかかわらず、甘いお菓子が好き。"},{"spoiler":false,"text":"■将来の夢■"},{"spoiler":false,"text":"晴樹と仲良し兄妹であれば、今のところ希望はない。"}],"source":"egs","sourceCharacterId":"1660","sourceWorkId":"19067","spoiler":false},{"segments":[{"spoiler":false,"text":"晴樹とは双子だが性別は違う妹。"},{"spoiler":false,"text":"元々仲は良かったが、思い切って晴樹に告白をしてからは、人には言えない擬似恋人同士になって、より仲良く、エッチもしている。"},{"spoiler":false,"text":"しかし兄妹なので、エッチはアナルプレイ止まりで、通草の処女はまだ守られている。"},{"spoiler":false,"text":"この旅行で、晴樹が文香や夏弥と親密にしているのを見て、通草もいつもより一歩積極的になろうとする。"}],"source":"egs","sourceCharacterId":"1660","sourceWorkId":"26258","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・晴樹の二卵性双生児の妹。"},{"spoiler":false,"text":"小さい頃から両親は仕事で忙しかったので、寂しくてよく晴樹にくっついて行動していた。"},{"spoiler":false,"text":"今はもうそんなことは無いが、それでも仲が良く、じゃれついたりするのは相変わらず。"},{"spoiler":false,"text":"ふたりを知らない人からは、たまに恋人だと間違われる。"},{"spoiler":false,"text":"「いーじゃんいーじゃん！　みんなで遊びにいこーじぇー！」"}],"source":"bangumi","sourceCharacterId":"22433"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"ur