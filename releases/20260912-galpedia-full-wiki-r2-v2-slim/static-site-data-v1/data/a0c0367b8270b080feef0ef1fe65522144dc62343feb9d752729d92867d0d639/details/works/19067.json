-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/693d0ed51747af0e7293cabe38b1c1c691bb71f4a97e495cf0b4eee0e331cca4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6f79b7c6fb05742fb606f2febfd0dba1c05d7af0bc52211abfe5b26543c0d7c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73980:22434:6359:1","source":"bangumi"}]},{"characterId":"char_c16122","characterName":"涼城 小梅","sourceIds":{"bangumi":[{"characterId":"22436","match":"exact-normalized-name-in-linked-work","subjectId":"73980"}],"egsCharacterIds":["1663"],"vndbCharacterId":"c16122"},"originalCharacterName":"涼城 小梅","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruki's HR teacher. A.K.A Iron Lady"}],"source":"vndb","sourceCharacterId":"c16122"},{"segments":[{"spoiler":false,"text":"男女交際について厳しい考えを持つ担任教師。"},{"spoiler":false,"text":"セックスを汚らわしく思い、彼女自身もこれまで男性と付き合ったことは無い。"},{"spoiler":false,"text":"しかしそうやって長年抑圧してきた反動で、彼女の女性の本能は性的な刺激を渇望している。"},{"spoiler":false,"text":"■好きなもの■"},{"spoiler":false,"text":"気の緩みが生活の乱れの第一歩。"},{"spoiler":false,"text":"ということで、特別熱中したり執着するものは無い。"},{"spoiler":false,"text":"でも内緒で、コスメ・美容関係には少し興味はある。"}],"source":"egs","sourceCharacterId":"1663","sourceWorkId":"19067","spoiler":false},{"segments":[{"spoiler":false,"text":"男女交際について厳しい考えを持つ担任教師。"},{"spoiler":false,"text":"セックスを汚らわしく思い、彼女自身もこれまで男性と付き合ったことは無い。"},{"spoiler":false,"text":"しかしそうやって長年抑圧してきた反動で、彼女の本能は性的な刺激を渇望している。"},{"spoiler":false,"text":"晴樹の行動に不審を感じると、たびたび警告してくる。"},{"spoiler":false,"text":"しかし彼の持つバイブに気付いた時、その興味が隠せなくなる……。"},{"spoiler":false,"text":"「校内での不純異性交遊は禁止！　無論校外でも禁止！　不純同性交友も禁止ですよっ！」"}],"source":"bangumi","sourceCharacterId":"22436"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d57be473c8323b5d2b05aec524c1abd6bd9ca40cdd90d712091d9e23b1668942.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b073d65fd8ea28bf9446d5c1dc2f4c4788b758daf4c0987707ef772b77986a99.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73980:22436:11511:1","source":"bangumi"}]},{"characterId":"char_c42082","characterName":"水谷 晴樹","sourceIds":{"bangumi":[{"characterId":"57003","match":"exact-normalized-name-in-linked-work","subjectId":"73980"}],"egsCharacterIds":["1657"],"vndbCharacterId":"c42082"},"originalCharacterName":"水谷 晴樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"アダルトグッズの収集が趣味で、特に〝新藤明名（しんどうあくめ）〟のバイブには人一倍こだわりを持っている。"},{"spoiler":false,"text":"エロに関する知識も豊富だが、残念ながらそれを活用する機会は今まで無かった。"},{"spoiler":false,"text":"日常生活では地味なタイプだが、一度エロの情熱が滾ると、行動が大胆になる。"},{"spoiler":false,"text":"■好きなもの■"},{"spoiler":false,"text":"バイブを中心としたアダルトグッズ。"},{"spoiler":false,"text":"ゲーム。"},{"spoiler":false,"text":"■将来の夢■"},{"spoiler":false,"text":"自分の趣味を理解し、気持ち的にも肉体的にも受け入れてくれる彼女が欲しい。"}],"source":"egs","sourceCharacterId":"1657","sourceWorkId":"19067","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6afdfccd916f26eb4b48641556d1c18d