{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"35803","model":{"presentationWorkId":"egs:35803","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_13043","characterName":"サクラバ ネク","sourceIds":{"bangumi":[{"characterId":"13043","match":"source-roster","subjectId":"219"},{"characterId":"13043","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"サクラバ ネク","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0421"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。渋谷生まれ渋谷育ちの15歳の少年。他人と分かり合うことに疑問を感じ、一人でいることを好むと同時に他人と関わることを極度に嫌っている。常にヘッドフォンを着けているのは、自分と周りの世界を遮断していることの表れである。趣味は音楽や「グラフィティ」と呼ばれるストリートアート。シブヤで「CAT」と呼ばれる、グラフィティやデザインで有名な人物を尊敬している。バッジを利用したサイキックに長けている。"}],"source":"bangumi","sourceCharacterId":"13043"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2840014e0f4ee52d32e8dde487964a1134ca2f2f15f968c608ac437170480cc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aded7926e1bc11301d7a0276faf4f12a67621b8affb37b5593c6d897b14261f.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内山昂輝","creatorId":"vndb:s12922","sourcePersonId":"vndb:s12922","canonicalEntityId":"vndb:s12922","name":"内山 昂輝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:13043:5768:1","source":"bangumi"}]},{"characterId":"char_bangumi_13044","characterName":"ミサキ シキ","sourceIds":{"bangumi":[{"characterId":"13044","match":"source-roster","subjectId":"219"},{"characterId":"13044","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ミサキ シキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1012"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"15歳の少女。落ち着いた雰囲気だが、やや天然なところもある。死神のゲーム初参加なのにネクと初めて会った時「契約すればノイズを倒せる」など死神のゲームに少し詳しいところがある。おしゃれ好きで、へそ出しファッションに身を包み、手作りの黒ネコのぬいぐるみ“にゃんタン”をよく持ち歩いている。裁縫が得意で、着ている服は自分で作ったもの。将来の夢はファッションデザイナー。にゃんタンを操る「サイコマンス」が主戦法（本作中でシキは自らの能力を「テレキネシス」と言っていたが、実際は自我を与える「サイコマンス」である）。"}],"source":"bangumi","sourceCharacterId":"13044"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8277b5ba833c5ea6d178cc36e04005b1e3c9c1d33f5e70069719c831a1508fd9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd790a4d6a26962afb5efe4888c7865b163694d7504798f5899d6ee6adca9900.webp","width":82,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_13045","characterName":"キリュウ ヨシヤ","sourceIds":{"bangumi":[{"characterId":"13045","match":"source-roster","subjectId":"219"},{"characterId":"13045","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"キリュウ ヨシヤ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1101"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"15歳の少年。生意気で偉そうな態度をとる。"},{"spoiler":false,"text":"頭の回転が速くずる賢こく、どこか飄々としていて、"},{"spoiler":false,"text":"別の世界や者が視える。ネクと手を組むことになるが、"},{"spoiler":false,"text":"様々なこと詳しいため、信頼できそうな反面、どことなく"},{"spoiler":false,"text":"信用ができない部分もある。"}],"source":"bangumi","sourceCharacterId":"13045"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff2f13ca164fa8ed7a2e6dae5d6f7f758d41fd15b30fe25476abf3c706859b14.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08cfe5a2a8028c7ea419980357d6b985fdaad71c884739eba64c9599c3f90130.webp","width":85,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村良平","creatorId":"vndb:s382","sourcePersonId":"vndb:s382","canonicalEntityId":"vndb:s382","name":"木村 良平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:13045:4994:1","source":"bangumi"}]},{"characterId":"char_bangumi_13046","characterName":"ビトウ ダイスケノジョウ","sourceIds":{"bangumi":[{"characterId":"13046","match":"source-roster","subjectId":"219"},{"characterId":"13046","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ビトウ ダイスケノジョウ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0801"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"15歳の少年。パートナーのライムと行動を共にしている。頑固で熱く、思いついた事をそのまま実行する短絡的で直情的な性格で、よくライムにたしなめられている。自分と正反対の性格のネクに対して少々熱くなることも多い。本名を呼ばれる事を嫌がる。スケボーが得意で、主戦法はスケボーに乗っての白兵戦。"}],"source":"bangumi","sourceCharacterId":"13046"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12be2d9ccf300a6abb7adfdf18f92cb5f35cae9e490ba14e2d61b78e3e87a454.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/7079d3daccdba632dc3ffb215e38a3b395b70f252d40eb2b391e7325493727a6.webp","width":97,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村昴","creatorId":"vndb:s8109","sourcePersonId":"vndb:s8109","canonicalEntityId":"vndb:s8109","name":"木村 昴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:13046:6787:1","source":"bangumi"}]},{"characterId":"char_bangumi_13047","characterName":"ビトウ ライム","sourceIds":{"bangumi":[{"characterId":"13047","match":"source-roster","subjectId":"219"},{"characterId":"13047","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ビトウ ライム","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0120"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ビイトといつも一緒にいる、明るくひたむきな少女。一人称はボク（ボク少女）。ビイトと揃いのドクロマークのニットキャップを被っている。冷静な判断力を持ち、暴走しがちなビイトをサポートしている。頻繁にことわざを使う癖がある。"}],"source":"bangumi","sourceCharacterId":"13047"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3fb506ae2f102f2363017e34ca893f7b42987c469e69ac912f8ca49f093d4a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7c45efd077236a439e834d9f80aee4ef18102190913e9d858e6b9f7f64be186.webp","width":79,"height":256,"source":"static-detail"},"actors":[{"creditedName":"生天目仁美","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:13047:4394:1","source":"bangumi"}]},{"characterId":"char_bangumi_88880","characterName":"ハネコマ サナエ","sourceIds":{"bangumi":[{"characterId":"88880","match":"source-roster","subjectId":"219"}]},"originalCharacterName":"ハネコマ サナエ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"自称「ゲームの監視者」。死神のゲームについて詳しく、ネク達に何かとアドバイスや手助けをしてくれる。死神とは違う立場にいて、ネク達を見守るような存在。"}],"source":"bangumi","sourceCharacterId":"88880"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd06fd45326e44d064a15a0a6b17ee87bbd3e128e7381d1f7123a117bc8d2439.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1081fa8e1b03aa16f2e197fc5b3a294bee0adc64dcde532afea5d648a586074.webp","width":100,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_88881","characterName":"ヤシロ ウヅキ","sourceIds":{"bangumi":[{"characterId":"88881","match":"source-roster","subjectId":"219"},{"characterId":"88881","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ヤシロ ウヅキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0702"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"組織の下っ端に位置する17歳の女性。常に仕事にやりがいを求めており、その為なら嘘のミッションを吹っかけるなどどんな手段も選ばない。通称ピンク頭。自身の実力は高く、ゲームマスター代行に指名される程の力を持つが、感情的で向こう見ずな性格から、制御が足らず失敗してしまうことが多い。同僚の狩谷とよくつるんでいるが、組織に入ってからの日は彼より浅いため一応後輩である。狩谷が幹部入りを断っていたのを知り、足手まといになるのを嫌がっていたが、狩谷に「自分のペースでやればいいのサ」「俺はこの雑多なシブヤが好きなのサ」などと言われて、自分を見つめなおすようになる。"}],"source":"bangumi","sourceCharacterId":"88881"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e87fa4887c4d7aa1d12800f6e3481e09d55e20115e165e4c2845a499d5ba1c45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adb41640b6134bc0ce270769a5e3f75b8244147e1fcfbb965d02563cc8719b38.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新井里美","creatorId":"vndb:s1324","sourcePersonId":"vndb:s1324","canonicalEntityId":"vndb:s1324","name":"新井 里美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:88881:4625:1","source":"bangumi"}]},{"characterId":"char_bangumi_88883","characterName":"カリヤ コウキ","sourceIds":{"bangumi":[{"characterId":"88883","match":"source-roster","subjectId":"219"},{"characterId":"88883","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"カリヤ コウキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0926"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"常に気だるげでやる気も無さそうだが、硬派でプライドが高く、仕事に誇りを持っている19歳の青年。通称アメ玉。八代と行動を共にしており、度々ラーメンの奢りを賭けたゲームを提案している。組織での位置は彼女と同程度。しかし実は幹部クラスの実力を持っており、実際に昇進の話も出たことがあるが、それを蹴って現場での仕事を選んだ。常に変化する渋谷を眺めることを好むためである。棒付きキャンディー（彼曰く「ロリポップではなくあんこ玉」）をいつも持っている。話す時は「だヨ」など、いつも語尾がカタカナ調。"}],"source":"bangumi","sourceCharacterId":"88883"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9051045cf97691a1a952750714c06bce6c51a1868bdac7fa353f305430d6f8e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf6b82b2fea16853f1c8194350cb87af085b0fcf611d04ce27469e315d19641e.webp","width":132,"height":256,"source":"static-detail"},"actors":[{"creditedName":"勝杏里","creatorId":"vndb:s4899","sourcePersonId":"vndb:s4899","canonicalEntityId":"vndb:s4899","name":"勝 杏里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:88883:9447:1","source":"bangumi"}]},{"characterId":"char_bangumi_88885","characterName":"ヒガシザワ ヨウタ","sourceIds":{"bangumi":[{"characterId":"88885","match":"source-roster","subjectId":"219"}]},"originalCharacterName":"ヒガシザワ ヨウタ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ドレッドロックスで怪力自慢の20歳の青年。そのパワーは拳で地面を叩き割れる程。右目が白、左目が黄色のオッドアイ。シキ編でのゲームマスター。物事を調理用語で比喩する癖がある。能力のすべてが理想値を上回っているため、北虹からゲームマスター代行を任された(そのため、正式には幹部ではない)。とくに協調性が秀でて高い。観察眼も高く、シキの中に潜んでいた嫉妬心を見抜いていた。"}],"source":"bangumi","sourceCharacterId":"88885"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c253abdbb4cc31cf7d35d73065de41fb31c34d360bea230df385493617558d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4757c80f8ee96926720ca3691430fdd8609ae07ca299b93378ddd0757698322.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋研二","creatorId":"vndb:s1679","sourcePersonId":"vndb:s1679","canonicalEntityId":"vndb:s1679","name":"高橋 研二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:88885:4944:1","source":"bangumi"}]},{"characterId":"char_bangumi_88886","characterName":"ミナミモト ショウ","sourceIds":{"bangumi":[{"characterId":"88886","match":"source-roster","subjectId":"219"},{"characterId":"88886","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ミナミモト ショウ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0223"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冷酷で凶暴な一面を持つが、高い知能を持つ18歳の青年。よく巨大なオブジェを造る（見た目は完全にゴミの山である）ため、ネクにオブジェ死神と呼ばれる。最年少で大出世を果たした過去を持つが、協調性は0に等しい。数学マニアで会話には数学用語が頻出し、「ゼタ遅ぇ」「このヘクトパスカルが！」などが口癖。又、「お前ら全員ここで4ね（しね）！」等と、数字を誤字として用いられる場合も見られる。たまにメガホンで叫ぶ。"}],"source":"bangumi","sourceCharacterId":"88886"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c909e1833e7cf9aa0c9f78f56c9e84c61f4b5c164304ce69a64af5eb723c8c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12d3864a0ac1e1b691fb46b107007232c33cc299e03f2722677d2a506a80c9eb.webp","width":91,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_88888","characterName":"キタニジ メグミ","sourceIds":{"bangumi":[{"characterId":"88888","match":"source-roster","subjectId":"219"}]},"originalCharacterName":"キタニジ メグミ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神メンバーを束ねる指揮者を勤める26歳の男性死神。自分が最も優れていると自負している。あらゆる戦略で相手を徹底的に追い詰める。通称グラサン。"}],"source":"bangumi","sourceCharacterId":"88888"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a19e0ed0cb0bad23366ef2d8dd890ab7dcd8c540a204b8ab5908035b72786363.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cba643a6beecd930e043e1d9fc83f9d1f2b0971ba0c7c79c30d99466f7caaea6.webp","width":96,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白熊寛嗣","creatorId":"vndb:s503","sourcePersonId":"vndb:s503","canonicalEntityId":"vndb:s503","name":"白熊 寛嗣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:88888:4607:1","source":"bangumi"}]},{"characterId":"char_bangumi_88899","characterName":"コニシ ミツキ","sourceIds":{"bangumi":[{"characterId":"88899","match":"source-roster","subjectId":"219"}]},"originalCharacterName":"コニシ ミツキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"几帳面な性格で何事もキッチリこなす策士。その性格には冷酷な一面もある。南師・狩谷には鉄仮面と呼ばれる。しかし、狩谷と卯月は本人の前ではコニシさん。"}],"source":"bangumi","sourceCharacterId":"88899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1ae96e6ec3aac49de95cf1e4150118921dcae34628a47143ee729e0b661351a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0e9312b02d0720594bfaf198517df0be87f997b38caeb0408e04b7553040070.webp","width":71,"height":256,"source":"static-detail"},"actors":[{"creditedName":"生天目仁美","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219:88899:4394:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1455","sourceCompanyId":"egs:brand:1015","canonicalEntityId":"vndb:p1455","name":"スクウェア・エニックス(SQUARE ENIX)","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:35803:1015","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
