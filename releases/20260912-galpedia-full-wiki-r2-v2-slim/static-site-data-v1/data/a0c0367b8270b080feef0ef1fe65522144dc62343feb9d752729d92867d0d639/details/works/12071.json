":"12071","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"15702","sourceWorkId":"12071","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16fac7ed14bfa2d9361b7c2837fb204c09ef93b7058386899ff26c8c52979a82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f68c7881e85502ca725a0ff99556a11f00065ac3dcb3ef32efcd922402d74d35.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79365:92479:6018:1","source":"bangumi"}]},{"characterId":"char_c2739","characterName":"藤眞 由梨絵","sourceIds":{"bangumi":[{"characterId":"92484","match":"exact-normalized-name-in-linked-work","subjectId":"79365"}],"egsCharacterIds":["15706"],"vndbCharacterId":"c2739"},"originalCharacterName":"藤眞 由梨絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園の国語教師で、主人公が副担任をしているクラスの担任でもある。"},{"spoiler":false,"text":"普段はとてものんびりした感じの優しい教師。"},{"spoiler":false,"text":"滅多な事がな限り学生を叱ることがない。"},{"spoiler":false,"text":"そのため、学生からの人気は高い。"},{"spoiler":false,"text":"だが、普段ニコニコとしている分、その裏では何を考え、何を腹の中で思っているのかが、読めない教師でもある。"},{"spoiler":false,"text":"「可哀想だとは思うけれど、校則を破ったのはあなたなの。ごめんなさいね」"}],"source":"egs","sourceCharacterId":"15706","sourceWorkId":"12071","spoiler":false},{"segments":[{"spoiler":false,"text":"礼儀正しく和やかな、学園の古典教師。"},{"spoiler":false,"text":"主人公が副担当を受け持つクラスの担任教師でもある。"},{"spoiler":false,"text":"滅多なことがない限りは学生を叱ることのない穏やかな性格から、学生に好かれている。"},{"spoiler":false,"text":"だが一方で、腹の中で何を考えているかわからないと不気味がられている面もある。"}],"source":"bangumi","sourceCharacterId":"92484"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"15706","sourceWorkId":"12071","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"15706","sourceWorkId":"12071","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"15706","sourceWorkId":"12071","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"15706","sourceWorkId":"12071","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"54 kg","valueContext":null,"source":"egs","sourceCharacterId":"15706","sourceWorkId":"12071","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be63810cfe71deb3d59234565db73163a0db7eba649f03be6b0764e2f6b13174.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5eaba028aee51e9947f2f999cfe95f0c290a0f1ccb87a8083f15607e136212c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79365:92484:5924:1","source":"bangumi"}]},{"characterId":"char_c2740","characterName":"立川 紫","sourceIds":{"ba