ull,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Senagava is a novice designer and has many other hidden talents. However, she leads a \"boy in the skirt\" lifestyle, and doesn't like to go to school. It would seem that she is unknown to such term as \"Lady\", and she can even kick your ass, when she gets pissed off. But love can change a person incredibly. And even Satsuki has her feminine side."}],"source":"vndb","sourceCharacterId":"c12237"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"クラスではやや浮いていて、"},{"spoiler":false,"text":"１人でいることが多い。"},{"spoiler":false,"text":"実際には気さくで、話しやすい女友達タイプ。"}],"source":"egs","sourceCharacterId":"12878","sourceWorkId":"7342","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"クラスではやや浮いていて、"},{"spoiler":false,"text":"１人でいることが多い。"},{"spoiler":false,"text":"実際には気さくで、話しやすい女友達タイプ。"}],"source":"bangumi","sourceCharacterId":"143157"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da826ee638d7b456a243ef0489f916eb1e5ec242ca90ce606a2b6f8b28935b6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16ce3ef4fb3639fa2e7aa9387a5906aa9ab215efa280ef1143c6809f41fa6d38.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11253:143157:6045:1","source":"bangumi"}]},{"characterId":"char_c12238","characterName":"棗 秋奈","sourceIds":{"bangumi":[{"characterId":"143158","match":"exact-normalized-name-in-linked-work","subjectId":"11253"}],