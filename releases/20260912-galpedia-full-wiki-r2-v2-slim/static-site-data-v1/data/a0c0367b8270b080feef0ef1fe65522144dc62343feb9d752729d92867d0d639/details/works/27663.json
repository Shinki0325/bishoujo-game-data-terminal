3","match":"exact-normalized-name-in-linked-work","subjectId":"202143"}],"egsCharacterIds":["20822"],"vndbCharacterId":"c80105"},"originalCharacterName":"和倉 繭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mayuko, the foster mother of Isamu, embodies both beauty and serenity. She is a graceful widow who also happens to be the proprietor of a coffee house."},{"spoiler":false,"text":"A decade ago, tragedy struck when her beloved husband was murdered. Overwhelmed by grief, Mayuko found herself teetering on the brink of despair. During this dark period, Isamu entered her life, saving her from the abyss and kindling a profound connection that would forever alter their fates. This event became a turning point in their relationship, ultimately leading to Mayuko taking Isamu away from the orphanage."},{"spoiler":false,"text":"Having both experienced the loss of their loved ones, they find solace in one another, and their connection grows stronger with each passing day. She adores Isamu and considers him her own flesh and blood."},{"spoiler":false,"text":"Nevertheless, she finds herself facing troubles as the recollections of her deceased spouse gradually diminish with each passing day..."}],"source":"vndb","sourceCharacterId":"c80105"},{"segments":[{"spoiler":false,"text":"伊佐武の義母。"},{"spoiler":false,"text":"喫茶店を営む、美しく、物静かな未亡人。"},{"spoiler":false,"text":"十年前に、心から愛していた夫を殺され、 自殺しようとしたところを伊佐武に助けられる。 それを切っ掛けに、彼を施設から引き取った。"},{"spoiler":false,"text":"大切な人を失くした者同士が、互いを支えあい、 生きていくことで、二人の絆は深くなった。"},{"spoiler":false,"text":"伊佐武のことを溺愛しており、本当の息子のように思っている。"},{"spoiler":false,"text":"日々、亡夫との記憶が薄れていくことに苦悩している。"}],"source":"egs","sourceCharacterId":"20822","sourceWorkId":"27663","spoiler":false},{"segments":[{"spoiler":false,"text":"伊佐武の義母。"},{"spoiler":false,"text":"喫茶店を営む、美しく、物静かな未亡人。"},{"spoiler":false,"text":"十年前に、心から愛していた夫を殺され、自殺しようとしたところを伊佐武に助けられる。"},{"spoiler":false,"text":"それを切っ掛けに、彼を施設から引き取った。"},{"spoiler":false,"text":"大切な人を失くした者同士が、互いを支えあい、生きていくことで、二人の絆は深くなった。"},{"spoiler":false,"text":"伊佐武のことを溺愛しており、本当の息子のように思っている。"},{"spoiler":false,"text":"日々、亡夫との記憶が薄れていくことに苦悩している。"}],"source":"bangumi","sourceCharacterId":"68553"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"20822","sourceWorkId":"27663","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"20822","sourceWorkId":"27663","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"20822","sourceWorkId":"27663","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"20822","sourceWorkId":"27663","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"20822","sourceWorkId":"27663","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f680e8cd38229c6e02d9280636c039cbe5e9c181a13b1288bb9d34fdb6d32ce9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34a81a29b4edf80e7e57ff60d3a94814fd5353465d5a8645db5cf0767048b3e0.webp","width":65,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name