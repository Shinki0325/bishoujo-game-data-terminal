itedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267823:203091:4799:1","source":"bangumi"}]},{"characterId":"char_c14008","characterName":"霜月 双葉","sourceIds":{"bangumi":[{"characterId":"203092","match":"exact-normalized-name-in-linked-work","subjectId":"267823"}],"egsCharacterIds":["25164"],"vndbCharacterId":"c14008"},"originalCharacterName":"霜月 双葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The middle of the sisters who is also Hajime's classmate. After her father amassed a debt of a billion yen, she and her sisters were about to be sold as sex slaves to the yakuza before Mariko saved them and suggested they become Hajime's maids, as the former maid left a month before. Despite this Futaba does not like Hajime and in fact, thinks that she needs to protect her sisters from him. Even after her life was turned upside down, Futaba does her best to pull through with her stubbornness and energetic personality. She is bad at doing household chores, and everything she cooks turns into a biochemical weapon."}],"source":"vndb","sourceCharacterId":"c14008"},{"segments":[{"spoiler":false,"text":"三姉妹の次女。あさやけ学園2年生。"},{"spoiler":false,"text":"父親が社長だった会社が莫大な借金を背負って経営破綻し、その借金のかたで風俗店に売られそうになっていたところを主人公の秘書に救われ、美間作家のメイドとして雇われる。"},{"spoiler":false,"text":"明るく元気で、雑草のような強くしぶとい逆境にも負けない精神力の持ち主で、ハッキリした物言いをする女の子。"},{"spoiler":false,"text":"またあまり素直ではなく、主人公にはツンツンしている。"},{"spoiler":false,"text":"綺麗好きで掃除は得意だが、他の家事はてんで駄目。"}],"source":"egs","sourceCharacterId":"25164","sourceWorkId":"8160","spoiler":false},{"segments":[{"spoiler":false,"text":"三姉妹の次女。"},{"spoiler":false,"text":"容姿は可愛く、常識的な学園生活が突然破綻したにも関わらず、持ち前の明るさと雑草のような精神力で逆境をはねのけ、"},{"spoiler":false,"text":"はじめからなんとか逃げ出そうと考えながら、言うことをしぶしぶ聞いている。 姉の一美や、妹の三代をはじめの毒牙から守るのは自分だと考えている。"},{"spoiler":false,"text":"家事はあまり得意ではない。料理はダメ（食材を生物化学兵器に変質させる）。唯一の得意な家事は掃除。かなりきれい好き。"},{"spoiler":false,"text":"はじめのクラスメート。"},{"spoiler":false,"text":"「い、今に見てなさいよっ！　あたしは、"},{"spoiler":false,"text":"こんなことじゃ負けないからねっ！」"}],"source":"bangumi","sourceCharacterId":"203092"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"25164","sourceWorkId":"8160","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"25164","sourceWorkId":"8160","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"25164","sourceWorkId":"8160","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d20b8ebd1b9fd09e3095bbea063c1bc69fc416c230d3c6ad968cbcdad019854.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c79f95d8db936324e83011f1098b16fdaabadae3de02cf317d7f47206ca007f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267823:203092:4432:1","source":"bangumi"}]},{"characterId":"char_c14009","characterName":"霜月 三代","sourceIds":{"bangumi":[{"characterId":"203093","match":"exact-normalized-name-in-linked-work","subjectId":"267823"}],"egsCharacterIds":["25165"],"vndbCharacterId":"c14009"},"originalCharacterNa