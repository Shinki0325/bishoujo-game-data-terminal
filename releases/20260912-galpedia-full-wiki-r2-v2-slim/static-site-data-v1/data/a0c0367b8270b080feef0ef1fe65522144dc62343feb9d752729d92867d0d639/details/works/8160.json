":"8160","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"25165","sourceWorkId":"8160","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebb63eb90a3c70efffbc8cbadc4d1b6b77ba0fc59d63d829c47d482c2456175d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fba2182fb521b681f7374b1c93dac3b7107083c65bcf3ef0726a0962682179d3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"苺野あいす","creatorId":"vndb:s7529","sourcePersonId":"vndb:s7529","canonicalEntityId":"vndb:s7529","name":"苺野 あいす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267823:203093:88534:1","source":"bangumi"}]},{"characterId":"char_c14011","characterName":"榊原 真理子","sourceIds":{"bangumi":[{"characterId":"203094","match":"exact-normalized-name-in-linked-work","subjectId":"267823"}],"egsCharacterIds":["25166"],"vndbCharacterId":"c14011"},"originalCharacterName":"榊原 真理子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美間作家の敏腕施設秘書。"},{"spoiler":false,"text":"先代である主人公の父親の代から仕えてきた女性。"},{"spoiler":false,"text":"そのため、はじめの唯一の理解者であり、何事も彼女に相談する。"},{"spoiler":false,"text":"性格は常に冷静沈着。"},{"spoiler":false,"text":"美間作家に身も心も捧げ、はじめを絶対に裏切らない。"},{"spoiler":false,"text":"はじめには将来、もっと大きな人間になって貰いたいと常々願っている。"},{"spoiler":false,"text":"仕事については、才を発揮する彼女だが、家事はまるで駄目。"}],"source":"egs","sourceCharacterId":"25166","sourceWorkId":"8160","