irmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Head of the Intelligence Department of KOKON. She is an intelligent and motherly woman who has risen to the position of Graham's right-hand at a young age. She was once in a relationship with Tsunakawa, but they are now friends, perhaps because she hates to be restrained by others."}],"source":"vndb","sourceCharacterId":"c12762"},{"segments":[{"spoiler":false,"text":"若くして古痕の頭脳とも言える情報部部長を務める才媛。"},{"spoiler":false,"text":"個人主義で、人に束縛されることを嫌うタイプ。"},{"spoiler":false,"text":"過去に 津名川と交際していたが、現在はなんとなく距離をおいている。"}],"source":"egs","sourceCharacterId":"16126","sourceWorkId":"2138","spoiler":false},{"segments":[{"spoiler":false,"text":"若くして古痕の頭脳とも言える情報部部長を務める才媛。"},{"spoiler":false,"text":"個人主義で、人に束縛されることを嫌うタイプ。"},{"spoiler":false,"text":"過去に 津名川と交際していたが、現在はなんとなく距離をおいている。"},{"spoiler":false,"text":"「100年も100日も変わらないよ。"},{"spoiler":false,"text":"終わりの日を考えて生きれば、痛いほど今の大事さがわかるの……」"}],"source":"bangumi","sourceCharacterId":"50653"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7de0d138e0e2b0d0dad31b4699257af13fc528a47a188c8e2bb00d31af412f6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8ab61609e1f86cd94bc3374cb0413150bc2aad62ddca64d22e6354182e05265.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c12765","characterName":"グラハム・ヘゼル","sourceIds":{"bangumi":[{"characterId":"50658","match":"exact-normalized-name-in-linked-work","subjectId":"7977"}],"egsCharacterIds":["16128"],"vndbCharacterId":"c12765"},"originalCharacterName":"グラハム・ヘゼル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":f