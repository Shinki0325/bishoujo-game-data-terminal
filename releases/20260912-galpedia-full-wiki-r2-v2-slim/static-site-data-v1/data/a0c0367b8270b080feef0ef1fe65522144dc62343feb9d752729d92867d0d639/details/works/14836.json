,"value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a student teacher who came to Kouga Academy in the new term as a math teacher. With the exception of university, she has never been to a school with boys (having always attended all-girls' schools). Since she has a rather upbeat personality, her students often call her informally, which she does not object to and therefore naturally results in her high popularity among the student body. Like Yuko and Ruu, Momoko is an unlockable character."}],"source":"vndb","sourceCharacterId":"c61021"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b3350f968606e6f5c5b90eb56dde512b569b194b52c39fecba763898b66d567.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/545d060523435813c2ddb4c25369744b8a23a3f8f6e13cc3b9e7f72804b0c4ce.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠藤 綾","creatorId":"vndb:s5699","sourcePersonId":"vndb:s5699","canonicalEntityId":"vndb:s5699","name":"遠藤 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48713","source":"vndb"}]},{"characterId":"char_vndb_c70458","characterName":"成田 瑠宇","sourceIds":{"vndbCharacterId":"c70458"},"originalCharacterName":"成田 瑠宇","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"317"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Ruu is the up and coming star of the volleyball club. She joined Kōga Academy in order to play with Katsumi, the object of her admiration, but Katsumi was forced to retire due to injury. Disappointed but unable to erase her feelings for Katsumi, she also joined the Photo Club. She is an unlockable character in the game."}],"source":"vndb","sourceCharacterId":"c70458"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/741987192e9a31f5bfcf2adfb42d2b2effe996778eaa991b04bef830606d5c84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1763dae5b599208279077f01a04b640f055142985b40423874fffd417b061c1e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川 明子","creatorId":"vndb:s1140","sourcePersonId":"vndb:s1140","canonicalEntityId":"vndb:s1140","name":"長谷川 明子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48706","source":"vndb"}]},{"characterId":"char_vndb_c70459","characterName":"紅林 かつみ","sourceIds":{"vndbCharacterId":"c70459"},"originalCharacterName":"紅林 かつみ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"426"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Katsumi was the ace of the volleyball club until she injured her ankle during her freshman year, forcing her to retire. She is now the president of the Photo Club (not to be confused with the Photography Club), which takes all of the school's official photos. Katsumi created the Photo Club because she was rejected by Hiromichi for membership in the Photography Club (likely due to disagreeing with him on the issue of erotic photography). Since her 