B"},{"spoiler":false,"text":"Kanon is the protagonist's younger sister. She loves to sing and dance and dreams of becoming an idol. She often poses or reenacts scenes she has seen in shoujo manga or anime. She has average grades but is athletic. She joined the tennis club since she looks up to Haruka. She is rarely seen without a smile on her face."}],"source":"vndb","sourceCharacterId":"c50212"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d177ac6d9c0e78cb3cd7cd7e917d363454f96bdc9b53e0fc9932ca3f5fedbd5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa6c1420b857baf847fa6f618c1302e6432f658d5d7c2f09031b6990a90ae9ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊瀬 茉莉也","creatorId":"vndb:s4898","sourcePersonId":"vndb:s4898","canonicalEntityId":"vndb:s4898","name":"伊瀬 茉莉也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48712","source":"vndb"}]},{"characterId":"char_vndb_c50213","characterName":"間咲 ののか","sourceIds":{"vndbCharacterId":"c50213"},"originalCharacterName":"間咲 ののか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"401"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Sports, eating, having fun with everyone"},{"spoiler":false,"text":"Dislikes: Studying, boredom, BB"},{"spoiler":false,"text":"Class: 2-A"},{"spoiler":false,"text":"Nonoka has below average grades, is extremely athletic and has an upbeat personality that allows her to have a lot of friends of both genders. She is