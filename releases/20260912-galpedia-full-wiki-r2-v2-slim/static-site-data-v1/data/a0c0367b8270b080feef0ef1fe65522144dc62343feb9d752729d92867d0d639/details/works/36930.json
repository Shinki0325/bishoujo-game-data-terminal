{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36930","model":{"presentationWorkId":"vndb:v52279","staff":{"artwork":[],"scenario":[{"creditedName":"吉村りりか","creatorId":"vndb:s5118","sourcePersonId":"egs:creator:26495","canonicalEntityId":"vndb:s5118","name":"吉村りりか","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:283212","source":"egs"}],"music":[{"creditedName":"月蝕會議","creatorId":"vndb:s20031","sourcePersonId":"egs:creator:36037","canonicalEntityId":"vndb:s20031","name":"月蝕會議","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:283213","source":"egs"}],"other":[{"creditedName":"立松文悦","creatorId":"vndb:s19091","sourcePersonId":"egs:creator:37746","canonicalEntityId":"vndb:s19091","name":"立松文悦","detail":"ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:283211","source":"egs"},{"creditedName":"月蝕會議","creatorId":"vndb:s20031","sourcePersonId":"egs:creator:36037","canonicalEntityId":"vndb:s20031","name":"月蝕會議","detail":"OP曲「桃源輪舞曲」、ED曲「天空夜想曲」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:298041","source":"egs"},{"creditedName":"寺嶋 桃子","creatorId":"vndb:s8239","sourcePersonId":"vndb:s8239","canonicalEntityId":"vndb:s8239","name":"寺嶋 桃子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:209666","source":"vndb"},{"creditedName":"うみの","creatorId":"vndb:s15157","sourcePersonId":"vndb:s15157","canonicalEntityId":"vndb:s15157","name":"青谷 鴬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:209667","source":"vndb"},{"creditedName":"立松 文悦","creatorId":"vndb:s19091","sourcePersonId":"vndb:s19091","canonicalEntityId":"vndb:s19091","name":"立松文悦","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:209668","source":"vndb"},{"creditedName":"月蝕會議","creatorId":"vndb:s20031","sourcePersonId":"vndb:s20031","canonicalEntityId":"vndb:s20031","name":"月蝕會議","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:209670","source":"vndb"},{"creditedName":"月蝕會議","creatorId":"vndb:s20031","sourcePersonId":"vndb:s20031","canonicalEntityId":"vndb:s20031","name":"月蝕會議","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:209671","source":"vndb"},{"creditedName":"関 真央","creatorId":"vndb:s23242","sourcePersonId":"vndb:s23242","canonicalEntityId":"vndb:s23242","name":"関 真央","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:209672","source":"vndb"},{"creditedName":"蓮本リョウ","creatorId":"vndb:s34330","sourcePersonId":"vndb:s34330","canonicalEntityId":"vndb:s34330","name":"蓮本リョウ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:209673","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c130196","characterName":"ナーヤ","sourceIds":{"vndbCharacterId":"c130196"},"originalCharacterName":"ナーヤ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl living in the village of Matsurika."},{"spoiler":false,"text":"She was born with \"Keigan\" to distinguish valuable gemstones from rough ones, and is entrusted with the responsibility of being a Gem Appraiser."},{"spoiler":false,"text":"She is in charge of her family's destiny, as gem is necessary for trade to obtain \"fire,\" which is indispensable for daily life. She is loved by the villagers for her honesty, kindness, and sense of responsibility."}],"source":"vndb","sourceCharacterId":"c130196"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/644e95b61bb840e91bf62d3b51aba6051d8af87e09bd02bcb89f92e2dc874b1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f70217cd5dc046968ec0ba6175af651d5e94b286211b47590f800412dee1b576.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c130197","characterName":"フェイ","sourceIds":{"vndbCharacterId":"c130197"},"originalCharacterName":"フェイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"704"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the son of Agedo, the chief of Matsurika Village."},{"spoiler":false,"text":"He has a straightforward personality, is dependable, and very popular among the village girls."},{"spoiler":false,"text":"He and the main character grew up together and can talk about anything, but he also has his mission as the son of the chief and the feelings that he keeps bottled up in his heart."},{"spoiler":false,"text":"His beloved horse is Kalu, the older brother of the protagonist's beloved horse, Naru."},{"spoiler":false,"text":"The nine fluorescent towers in the village are used to collect \"fireflies,\" which are used to expand the light and brighten the village."},{"spoiler":false,"text":"He and Ruwo, a trader who comes once every third month to trade in gems, do not see eye to eye."},{"spoiler":false,"text":"—— Love Theme: Loss × First Love ——"},{"spoiler":false,"text":"The young man Fey, the heir to the clan chief, has a secret mission."},{"spoiler":false,"text":"Another hidden tradition that has been passed down from generation to generation only to the direct male descendants of the Matsurika Village chief family."},{"spoiler":false,"text":"For that mission, Fey hides his faint first love for the protagonist within his heart and tries to live alone."},{"spoiler":false,"text":"However, when the protagonist learns the hidden truth, the story takes a big turn."},{"spoiler":false,"text":"Tradition, destiny, and unchanging feelings tear apart a young love..."}],"source":"vndb","sourceCharacterId":"c130197"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94f7df2fa51bef1155aafab14ebd1b245908b7a3f8f7a3836f6fee36eea3f080.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e668cf59462ce91b36156b31870ddfc83ad15a24a41dd0b938cf36e455f30d01.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本 信彦","creatorId":"vndb:s550","sourcePersonId":"vndb:s550","canonicalEntityId":"vndb:s550","name":"岡本 信彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98725","source":"vndb"}]},{"characterId":"char_vndb_c130198","characterName":"玖 燕來","sourceIds":{"vndbCharacterId":"c130198"},"originalCharacterName":"玖 燕來","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"birthday":{"reviewState":"source-only","source":"vndb","value":"909"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the current head of the Ku Clan, a prominent family in the Moonlight Country, and the Taifu (teacher) of the next king, Prince Seirin."},{"spoiler":false,"text":"Although he has an elder brother, he is a shrewd man who won the position of head of the family on his own merits."},{"spoiler":false,"text":"He is a man of both literary and military skills, and his quick thinking sometimes causes him to speak harshly when confronted with those who do not understand him, but he is also skilled at dealing with matters calmly."},{"spoiler":false,"text":"While carrying the fate of the Ku Clan on his shoulders, he spends his days trying to become the Taifu of Prince Seirin, in order to have him become a respectable king."},{"spoiler":false,"text":"Although he is slender and petite, he is a gluttonous eater to the surprise of everyone."},{"spoiler":false,"text":"—— Love Theme: Loneliness × Devotion ——"},{"spoiler":false,"text":"Enrai, the First Prince Taifu, had a wish that he must fulfill as the head of the Ku family."},{"spoiler":false,"text":"Enrai, who has been taught to always be calm and to abandon feelings and choose only the means for the sake of his earnest desire, has lived without ever knowing peace, and as he spends time with the protagonist, he comes to know peace."},{"spoiler":false,"text":"However, at that time, he already had intentions that were moving away from his will."},{"spoiler":false,"text":"Taboos that they must not ignore creep in, and the roles they were given from birth begin to eat away at them."}],"source":"vndb","sourceCharacterId":"c130198"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b970be07cf0fcaa34ca6765f72f5b328572f0aae4e4888fbbfd2271c2d1ccce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9eda06cff39a835c46e09024d8debba2e3bde964970ad90e8e3ce5e205c14dcb.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 瞬","creatorId":"vndb:s10306","sourcePersonId":"vndb:s10306","canonicalEntityId":"vndb:s10306","name":"堀江 瞬","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98729","source":"vndb"}]},{"characterId":"char_vndb_c130199","characterName":"胡 青凛","sourceIds":{"vndbCharacterId":"c130199"},"originalCharacterName":"胡 青凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"117"},"height":{"reviewState":"source-only","source":"vndb","value":"184"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Prince of the Moonlight Country."},{"spoiler":false,"text":"He is the son of the current king and the next king."},{"spoiler":false,"text":"He had a half-brother, but due to an unexpected separation, Seirin is the only male heir to the throne."},{"spoiler":false,"text":"Raised at court to be a butterfly and a flower, he is a naive son in a box."},{"spoiler":false,"text":"He has a beautiful heart, a refined way of thinking about things, and is unquestioning of others."},{"spoiler":false,"text":"Because he loves to spend time with birds, he has a large cage-like birdhouse in the court, where he spends most of his time."},{"spoiler":false,"text":"He learns martial arts and academics and the art of courtly behaviour from Enrai, the Prince Taifu, which he will need when he eventually becomes king."},{"spoiler":false,"text":"—— Love Theme: Transition × Adoration ——"},{"spoiler":false,"text":"Seirin, the first prince of the Moonlight Country, has his own reasons for not taking a wife."},{"spoiler":false,"text":"Although he is the next king, he has no fiancée and only loves birds every day, but when he sneaks out of the court, their destiny begins to revolve."},{"spoiler":false,"text":"Seirin, who wonders what he was born for - and is in agony about his life - meets the protagonist and for the first time makes a wish."},{"spoiler":false,"text":"However, a rare encounter awakens the darkness that lies dormant in the court, and the two are led to a mysterious destiny."},{"spoiler":false,"text":"This is a story of an earnest and wholesome love."}],"source":"vndb","sourceCharacterId":"c130199"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4a22ad9b71e393cbf3edc3a9ee5955bc3297733be06434b4db05cda2ef22654.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fa1fdb0258ff5962a7ebdb697c777a091586554213f03dd6d618ce6737d77b0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花 慎之介","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98722","source":"vndb"}]},{"characterId":"char_vndb_c130200","characterName":"ゼベネラ","sourceIds":{"vndbCharacterId":"c130200"},"originalCharacterName":"ゼベネラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"211"},"height":{"reviewState":"source-only","source":"vndb","value":"187"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the king of the White Wolf Tribe, living in a world confined by snow."},{"spoiler":false,"text":"He is a man of few words, but he is decisive and respected by the pack he works with."},{"spoiler":false,"text":"He calls wolves with his whistle and hunts with them."},{"spoiler":false,"text":"In the harsh environment of the snowy mountains, food is not plentiful, but they live by sharing and helping each other."},{"spoiler":false,"text":"They try not to hunt carelessly."},{"spoiler":false,"text":"To fulfill a promise he made to a certain person, he descends the mountain after nineteen years."},{"spoiler":false,"text":"—— Love Theme: Union × Affection ——"},{"spoiler":false,"text":"All to protect the pack."},{"spoiler":false,"text":"Zebenera, king of the White Wolf Tribe, travels down the mountain in search of a mate. The mate he wants is the protagonist."},{"spoiler":false,"text":"Zebenera tries to take her away, breaking the law of the village of Matsurika. But then the village is attacked by someone. The protagonist is forced to choose to marry Zebenera in return for his defending of Matsurika Village with the wolves..."},{"spoiler":false,"text":"But will the fate that awaits them be a blessing or a curse?"},{"spoiler":false,"text":"A tale of two people quietly nurturing their love in the midst of loneliness and sorrow."}],"source":"vndb","sourceCharacterId":"c130200"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d28b4c1e4ec7c2317d79b822c84e5a28cae46e2cb55ad6c822d9cf7ea3e4d260.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20f76a92d96b2336a8e9445610184fe81db2e94b11a16494df80723b5ee3587c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽多野 渉","creatorId":"vndb:s60","sourcePersonId":"vndb:s60","canonicalEntityId":"vndb:s60","name":"春野風","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98723","source":"vndb"}]},{"characterId":"char_vndb_c130201","characterName":"ルヲ","sourceIds":{"vndbCharacterId":"c130201"},"originalCharacterName":"ルヲ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"birthday":{"reviewState":"source-only","source":"vndb","value":"527"},"height":{"reviewState":"source-only","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a merchant who travels and trades in various places."},{"spoiler":false,"text":"For the past few years, he has been in charge of the fire trade, or fire trading, in which he delivers fire to the village of Matsurika and exchanges it for the gemstones that the main character has appraised."},{"spoiler":false,"text":"He has a broad perspective due to his work and is a good conversationalist, so he easily gets along with people he meets for the first time, but he also has a suspicious air about him that makes it difficult to see his true intentions."},{"spoiler":false,"text":"He is good at puppet shows with masks, and is always happy to perform in front of the girls of Matsurika Village, as he teaches them about the lore of various regions and the origins of the world in an easy-to-understand manner."},{"spoiler":false,"text":"He is always concerned about the main character, but...?"},{"spoiler":false,"text":"—— Love Theme: Fate × Attachment ——"},{"spoiler":false,"text":"Ruwo, the only 'official fire merchant' allowed in and out of Matsurika Village, had one dream."},{"spoiler":false,"text":"--Until he fulfills this dream, he has no intention of living with anyone else."},{"spoiler":false,"text":"Ruwo was supposed to have made up his mind to do so, but he unexpectedly becomes involved in the protagonist's life."},{"spoiler":false,"text":"As they grow closer, Ruwo begins to confront his own heart, but a plot conspires to entangle them both."},{"spoiler":false,"text":"Despite the hardships they face, they reach out for hope..."}],"source":"vndb","sourceCharacterId":"c130201"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/690fff7bf1d6e961e1afafd37c1f8d0ba287e3b4c9d9f6bfcafd20e7372e2a9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c82dd872df18848a91ece8a925d5ad1c5d2ac9f9bcfd8c7748bcfb03578fb4a3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山下 誠一郎","creatorId":"vndb:s4901","sourcePersonId":"vndb:s4901","canonicalEntityId":"vndb:s4901","name":"山下 誠一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98727","source":"vndb"}]},{"characterId":"char_vndb_c130796","characterName":"小蝶","sourceIds":{"vndbCharacterId":"c130796"},"originalCharacterName":"小蝶","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bright and energetic girl who runs a Kadenya (painting patterns on foreheads) shop in the Moonlight Country."},{"spoiler":false,"text":"She is a knowledgeable person, probably because of the variety of customers that come to the store."}],"source":"vndb","sourceCharacterId":"c130796"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbc5d43e65d44a9eda62ddcee5e4a3fe1020e915cdc2ab17226c7f4fc79c8197.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b17900caebce0920dda749f05dc9411ae0b1db9f04720dad1d7fbc8d90040d6.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c130797","characterName":"紫惺","sourceIds":{"vndbCharacterId":"c130797"},"originalCharacterName":"紫惺","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","val