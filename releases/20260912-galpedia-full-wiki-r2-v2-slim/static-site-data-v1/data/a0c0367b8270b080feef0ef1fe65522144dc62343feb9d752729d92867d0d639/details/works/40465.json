metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-class investigator with ADONIS' Cybercrime Division 1, working on the front lines to combat serious cybersecurity incidents brought about by the spread of \"Plant.\""},{"spoiler":false,"text":"Although he's quiet, uncooperative, and often acts on his own, he boasts a top-class case-solving rate."},{"spoiler":false,"text":"However, after becoming embroiled in an incident involving a mysterious piece of hardware called \"Cheat Plant,\" he is demoted to \"OCTA,\" a dead-end position."}],"source":"vndb","sourceCharacterId":"c133159"},{"segments":[{"spoiler":false,"text":"『Plant』の普及がもたらした深刻なサイバーセキュリティ事件に、最前線で立ち向かうADONIS社サイバー犯罪対策第一課の一級捜査官。"},{"spoiler":false,"text":"物静かな反面、協調性がなく独断専行も多いが、トップクラスの事件解決率を誇る。"},{"spoiler":false,"text":"だが、正体不明のハードウェア『チートPlant』の事件に巻き込まれ、閑職の地である『ＯＣＴＡ』に左遷されてしまう。"}],"source":"egs","sourceCharacterId":"28211","sourceWorkId":"35617","spoiler":false},{"segments":[{"spoiler":false,"text":"「当たり前に眼に見えるものを信じるな。"},{"spoiler":false,"text":"それがこの仕事の鉄則だ」"},{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"ARネットワーク内で起こるさまざまなコンピューターセキュリティ事件を取り締まる、ADONIS 社サイバーテロ対策第一課の一級捜査官。"},{"spoiler":false,"text":"物静かな反面、協調性がなく独断専行も多いが、事件解決率ではトップクラスの成績を出しており、選りすぐりの捜査官が集められる一課の中でもエースとして注目されている。"},{"spoiler":false,"text":"しかし担当した『スワンプマン事件』をめぐる陰謀に巻き込まれ、閑職であるOCTAの地に左遷されてしまう。"}],"source":"bangumi","sourceCharacterId":"168633"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b26f91e6cc1eb0b281ed47d6b0fec27222689d9763bad26eceffbad758626ab3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99564ec9ac797706c20545a56885102ab27dd1565d3a19d4005546bcbf855388.webp","width":75,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊東健人","creatorId":"vndb:s13539","sourcePersonId":"vndb:s13539","canonicalEntityId":"vndb:s13539","name":"伊東 健人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:470297:168633:18755:1","source":"bangumi"}]},{"characterId":"char_c133840","characterName":"一華 百花","sourceIds":{"bangumi":[{"characterId":"168632","match":"exact-normalized-name-in-linked-work","subjectId":"470297"}],"egsCharacterIds":["28210"],"vndbCharacterId":"c133840"},"originalCharacterName":"一華 百花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl whom Kuuki played with when he was a child."},{"spoiler":false,"text":"Despite the news that she had passed away from illness, Moka appears before Kuraugi as an AR avatar."},{"spoiler":false,"text":"Kuraugi has almost no memory of the past, so she suggests that they create a flower garden together to remember his memories."}],"source":"vndb","sourceCharacterId":"c133840"},{"segments":[{"spoiler":false,"text":"喰木が幼少の頃一緒に遊んでいた女の子。"},{"spoiler":false,"text":"病気で亡くなったと聞いていたが、ARアバターとして喰木の前に姿を現す。"},{"spoiler":false,"text":"昔の事をほとんど覚えていない喰木に、思い出の花畑を一緒に作ろうと言い出す。"}],"source":"egs","sourceCharacterId":"28210","sourceWorkId":"35617","spoiler":false},{"segments":[{"spoiler":false,"text":"「きっと『お花畑』をもう一度見れば"},{"spoiler":false,"text":"あの頃のことを思い出せると思うの！」"},{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"喰木が幼少の頃一緒に遊んでいた女の子。"},{"spoiler":false,"text":"幼くして病気で亡くなったが何故かARの電子幽霊として喰木の前に姿を現す。"},{"spoiler":false,"text":"本人も幽霊になった理由はわからず、今でも昔と同じように接しようとするため鬱陶しがられている。"},{"spoiler":false,"text":"昔の事をほとんど覚えていない喰木に、無くなってしまった思い出の花畑を作ろうと言い出し巻き込んでいく。"}],"source":"bangumi","sourceCharacterId":"168632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44025157372b7b4da066ccf816c0d76b87e933a46fe89ebd5ee578c62fa1fc22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2368d7628da062a1f524e5abde0049d7901f8f4aebd00a466c1e8660f23cf34.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺澤百花","creatorId":"vndb:s44967","sourcePersonId":"vndb:s44967","canonicalEntityId":"vndb:s44967","name":"寺澤 百花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:470297:168632:49576:1","source":"bangumi"}]},{"characterId":"char_c154338","characterName":"乙原 瑠璃乃","sourceIds":{"bangumi":[{"characterId":"168634","match":"exact-normalized-name-in-linked-work","subjectId":"470297"}],"egsCharacterIds":["28212"],"vndbCharacterId":"c154338"},"originalCharacterName":"乙原 瑠璃乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A rookie investigator at ADONIS Cybercrime Division 1."},{"spoiler":false,"text":"She deeply respects his senior investigator Kuraugi, and constantly tries to get his attention."},{"spoiler":false,"text":"In the case involving ‘Cheat Plant’, she partners with Kuraugi to conduct the investigation."}],"source":"vndb","sourceCharacterId":"c154338"},{"segments":[{"spoiler":false,"text":"ADONIS社サイバー犯罪対策第一課の新人捜査官。"},{"spoiler":false,"text":"捜査官の先輩である喰木に尊敬を抱いており、何かと喰木の気を引こうとする。"},{"spoiler":false,"text":"『チートPlant』を巡る事件では喰木とバディとなり、捜査をする。"}],"source":"egs","sourceCharacterId":"28212","sourceWorkId":"35617","spoiler":false},{"segments":[{"spoiler":false,"text":"「センパイとは初のバディですから、"},{"spoiler":false,"text":"エースのお手並みを見せてもらいます」"},{"spoiler":false,"text":"喰木の後輩。"},{"spoiler":false,"text":"ADONIS社サイバーテロ対策第一課の新人捜査官。"},{"spoiler":false,"text":"もともと本庁勤めの警察官だったがADONIS社にスカウトされ捜査官になるという特殊な経歴を持つ。"},{"spoiler":false,"text":"そのためか、規則やメンバー間のコミュニケーションにうるさく、影で「委員長」と言われからかわれている。"},{"spoiler":false,"text":"『スワンプマン事件』では喰木のバディとなり捜査を共にするが事件解決のために時には手段を選ばない喰木とぶつかることもしばしば。"}],"source":"bangumi","sourceCharacterId":"168634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f49b0cea2163de3d1084e5ab01666c00ca1418144e75128c38dd48321eebecf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fa20f683c50b198c6c05c34a1f0291356f12e85c3baaf948923ee94f66b6a72.webp","width":75,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大和田仁美","creatorId":"vndb:s17876","sourcePersonId":"vndb:s17876","canonicalEntityId":"vndb:s17876","name":"大和田仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:470297:168634:15988:1","source":"bangumi"}]},{"characterId":"char_c154339","characterName":"薄野 尾花","sourceIds":{"bangumi":[{"characterId":"168635","match":"exact-normalized-name-in-linked-work","subjectId":"470297"}],"egsCharacterIds":["28213"],"vndbCharacterId":"c154339"},"originalCharacterName":"薄野 尾花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head of the OCTA branch where Kuraugi was demoted."},{"spoiler":false,"text":"Despite being the head of the branch, she has a lackadaisical attitude towards work and is often seen taking naps on the sofa at work or playing with local amateur baseball teams under the guise of patrols."}],"source":"vndb","sourceCharacterId":"c154339"},{"segments":[{"spoiler":false,"text":"ADONIS社サイバー犯罪対策OCTA支部の支部長。"},{"spoiler":false,"text":"捜査官とは思えない勤務態度であり、よく職場のソファーで昼寝をしている。"}],"source":"egs","sourceCharacterId":"28213","sourceWorkId":"35617","spoiler":false},{"segments":[{"spoiler":false,"text":"「支部長とかやめてよ～。"},{"spoiler":false,"text":"役職で呼ばれるとなんか仕事中みたいじゃん」"},{"spoiler":false,"text":"喰木が左遷されたOCTA 支部の支部長。"},{"spoiler":false,"text":"支部長にもかかわらず勤務態度は不真面目でよく職場のソファーで昼寝をしていたりパトロールと称して地域の草野球に交じって遊んでいる。"}],"source":"bangumi","sourceCharacterId":"168635"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/541dbc15bc528f7baacf8d28f65590edc17670734e39ebe274c62c553964e371.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1194f7e80054a9d92a2512ffe9947b7d3f39b83cffd0af4458fd900818b85cb.webp","width":90,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Marika","creatorId":"vndb:s25821","sourcePersonId":"vndb:s25821","canonicalEntityId":"vndb:s25821","name":"Marika","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:470297:168635:44051:1","source":"bangumi"}]},{"characterId":"char_c154340","characterName":"クロサンドラ サマーキャンドル","sourceIds":{"bangumi":[{"characterId":"168636","match":"exact-normalized-name-in-linked-work","subjectId":"470297"}],"egsCharacterIds":["28214"],"vndbCharacterId":"c154340"},"originalCharacterName":"クロサンドラ サマーキャンドル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of the OCTA branch. Everyone calls her \"Sandra.\""},{"spoiler":false,"text":"She has a unique way of speaking because she learned the language from anime."},{"spoiler":false,"text":"She's not good at desk work, but she's unusually strong physically."}],"source":"vndb","sourceCharacterId":"c154340"},{"segments":[{"spoiler":false,"text":"ＯＣＴＡ支部所属の捜査官の１人。"},{"spoiler":false,"text":"皆から『サンドラ』との愛称で呼ばれている。アニメ好きであり、その影響で独特なしゃべり方をする。"}],"source":"egs","sourceCharacterId":"28214","sourceWorkId":"35617","spoiler":false},{"segments":[{"spoiler":false,"text":"「アニメの事ならお任せを！"},{"spoiler":false,"text":"おまえの萌えは俺の萌え、"},{"spoiler":false,"text":"俺の萌えは俺の萌えであります！」"},{"spoiler":false,"text":"OCTA 支部メンバーの一人。皆には『サンドラ』と呼ばれている。"},{"spoiler":false,"text":"アニメから言葉を学んだため独特なしゃべり方をする。"},{"spoiler":false,"text":"デスクワークは苦手だが異様にフィジカルが高い。"}],"source":"bangumi","sourceCharacterId":"168636"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8887db0e74d7ad9386dc16990f7059a19896dfb2d34ac642ed7249389d41e4b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c553698e6fadbe2584e93d695fe2004d8e07e2d2f755ae64b0904eedf2787c0a.webp","width":108,"height":256,"source":"static-detail"},"actors":[{"creditedName":"湯浅かえで","creatorId":"vndb:s8515","sourcePersonId":"vndb:s8515","canonicalEntityId":"vndb:s8515","name":"湯浅 かえで","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:470297:168636:19533:1","source":"bangumi"}]},{"characterId":"char_c154341","characterName":"芍薬 根々","sourceIds":{"bangumi":[{"characterId":"168637","match":"exact-normalized-name-in-linked-work","subjectId":"470297"}],"egsCharacterIds":["28215"],"vndbCharacterId":"c154341"},"originalCharacterName":"芍薬 根々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the investigators attached to the OCTA branch."},{"spoiler":false,"text":"As a hikkikomori, he always comes to work using an AR avatar."},{"spoiler":false,"text":"Nene was originally a skilled cracker, and his skills were recognized when he was scouted by ADONIS."}],"source":"vndb","sourceCharacterId":"c154341"},{"segments":[{"spoiler":false,"text":"ＯＣＴＡ支部所属の捜査官の１人。"},{"spoiler":false,"text":"引きこもりのため、常にＡＲアバターで出勤している。"},{"spoiler":false,"text":"元々、凄腕のクラッカーだった過去を持っており、その腕を買われてＡＤＯＮＩＳ社にスカウトされた。"}],"source":"egs","sourceCharacterId":"28215","sourceWorkId":"35617","spoiler":false},{"segments":[{"spoiler":false,"text":"「…………ども」"},{"spoiler":false,"text":"OCTA支部メンバーの一人。"},{"spoiler":false,"text":"引きこもりで常にARアバターを使い出勤している。"},{"spoiler":false,"text":"もとはクラッカーだったが実力を買われADONIS社にスカウトされた。"}],"source":"bangumi","sourceCharacterId":"168637"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72f7d3aaba350e50209f54db1ea9b36faf469a536ba1f4d31a181b1e1f84cfd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee058a6d3c57d6eba5032c6c8770638ee7d3159337464fc22fdbb2f272431266.webp","width":71,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松本沙羅","creatorId":"vndb:s25773","sourcePersonId":"vndb:s25773","canonicalEntityId":"vndb:s25773","name":"松本 沙羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:470297:168637:34048:1","source":"bangumi"}]},{"characterId":"char_c154342","characterName":"青年","sourceIds":{"bangumi":[{"characterId":"168638","match":"exact-normalized-name-in-linked-work","subjectId":"470297"}],"egsCharacterIds":["28216"],"vndbCharacterId":"c154342"},"originalCharacterName":"青年","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious young man who confronts Kuraugi, who was investigating the \"Cheat Plants\"."},{"spoiler":false,"text":"He distributes hardware called \"Cheat Plants\" that can disable ADONIS' security, but his purpose is unknown."}],"source":"vndb","sourceCharacterId":"c154342"},{"segments":[{"spoiler":false,"text":"『チートPlant』を追っていた喰木と対峙する謎の青年。"},{"sp