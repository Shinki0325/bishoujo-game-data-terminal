didate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Japanese Youkai\""},{"spoiler":false,"text":"Race: Kyuubi (Nine-tailed fox)"}],"source":"vndb","sourceCharacterId":"c29700"},{"segments":[{"spoiler":false,"text":"【日本妖怪】"},{"spoiler":false,"text":"尻尾が九つある狐の妖怪・九尾"},{"spoiler":false,"text":"北歳妖怪学園3年生。"},{"spoiler":false,"text":"妖学の前会長。"},{"spoiler":false,"text":"実質的な学園のボス。"},{"spoiler":false,"text":"代を譲り龍治が会長になった今でもあごでつかうが、それは龍治を期待しての対応である。"},{"spoiler":false,"text":"幅広い知識を持ちなんでもパーフェクトにこなす。"},{"spoiler":false,"text":"学生たちからの人望も厚く、龍治にとってもお姉さん的存在である。"}],"source":"egs","sourceCharacterId":"12540","sourceWorkId":"13659","spoiler":false},{"segments":[{"spoiler":false,"text":"種族：尻尾が九つある狐の妖怪・九尾　 学年：3年生"},{"spoiler":false,"text":"『妖学』の前会長。実質的な学園のボス。"},{"spoiler":false,"text":"代を譲り龍治が会長になった今でもあごで使うが、それは龍治を期待しての対応である。"},{"spoiler":false,"text":"幅広い知識を持ちなんでもパーフェクトにこなす。"},{"spoiler":false,"text":"学生たちからの人望も厚く、龍治にとってもお姉さん的存在である。"},{"spoiler":false,"text":"龍治の潜在能力に可能性を見出し、次期会長候補としていち早く目をつけた人物。"},{"spoiler":false,"text":"柊子自身も日本妖怪屈指の妖力の持ち主である種族 『九尾』 であるため、周りからの絶対的な存在として認識されていた。"},{"spoiler":false,"text":"自分を越える 『力』 の持ち主を探していたところ龍治を見つける。"},{"spoiler":false,"text":"「これで、私は楽をさせて……"},{"spoiler":false,"text":"いや、龍治には期待しているぞ。はっはっはっはっ！」"}],"source":"bangumi","sourceCharacterId":"166937"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41bea53c6079ef202b6e66f57916a1b08c0133c5754e411bf5ee8879dd76ab44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f782e1fc5d00eb6202d56173018ab0ebad28c43acd8b8f8b356e38643addbb2b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13559:166937:5741:1","source":"bangumi"}]},{"characterId":"char_c29773","characterName":"橘 雪華","sourceIds":{"bangumi":[{"characterId":"166938","match":"exact-normalized-name-in-linked-work","subjectId":"13559"}],"egsCharacterIds":["12543"],"vndbCharacterId":"c29773"},"originalCharacterName":"橘 雪華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Japanese Youkai\""},{"spoiler":false,"text":"Race: Yukionna (Snow Woman)"}],"source":"vndb","sourceCharacterId":"c29773"},{"segments":[{"spoiler":false,"text":"【日本妖怪】"},{"spoiler":false,"text":"雪の精・雪女"},{"spoiler":false,"text":"北歳妖怪学園2年生。"},{"spoiler":false,"text":"妖学書記。"},{"spoiler":false,"text":"超美少女で学園のアイドル。"},{"spoiler":false,"text":"地球温暖化対策についての学科を専攻しているエコ少女。"},{"spoiler":false,"text":"普段はにこにことして穏和だが、嬉しい事や嫌な事があったりして感情が高ぶると触るものすべてを凍らせてしまう。"},{"spoiler":false,"text":"そのことから他人との間に距離を生んでしまうこともある。"}],"source":"egs","sourceCharacterId":"12543","sourceWorkId":"13659","spoiler":false},{"segments":[{"spoiler":false,"text":"種族：雪の精・雪女　 学年：2年生"},{"spoiler":false,"text":"『妖学』 書記。超美少女で学園のアイドル。 地球温暖化対策についての学科を専攻しているエコ少女。"},{"spoiler":false,"text":"普段はにこにことして穏和だが、嬉しい事や嫌な事があったりして感情が高ぶると、触るものすべてを凍らせてしまう。"},{"spoiler":false,"text":"そのことから他人との間に距離を生んでしまうこともある。"},{"spoiler":false,"text":"超美少女と噂され、高値の花には手が出せないと一般学生からは憧れの対象とされているので、恋の噂はほとんど聞かない状態。"},{"spoiler":false,"text":"そんな時、龍治が 『妖学』会長となり身近に話してくれる男の子となり、雪華は興味を持ち始める。"},{"spoiler":false,"text":"「えっ!?　やっぱり龍治様と彩葉様は、そういうご関係っ！」"}],"source":"bangumi","sourceCharacterId":"166938"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6ff629d6a9e7c675d3f83b69d283fea15d4713deca60a6047646269570cd357.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc67efba3c884426c2175a2f2c2114a1ebb643024dfd9a02c665a6cc0dbfe2a7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13559:166938:6016:1","source":"bangumi"}]},{"characterId":"char_c29774","characterName":"猫宮 彩葉","sourceIds":{"bangumi":[{"characterId":"166939","match":"exact-normalized-name-in-linked-work","subjectId":"13559"}],"egsCharacterIds":["12541"],"vndbCharacterId":"c29774"},"originalCharacterName":"猫宮 彩葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Japanese Youkai\""},{"spoiler":false,"text":"Race: Bakeneko"}],"source":"vndb","sourceCharacterId":"c29774"},{"segments":[{"spoiler":false,"text":"【日本妖怪】"},{"spoiler":false,"text":"化け猫・猫娘"},{"spoiler":false,"text":"北歳妖怪学園2年生。"},{"spoiler":false,"text":"妖学副会長"},{"spoiler":false,"text":"元気いっぱいな女の子。"},{"spoiler":false,"text":"龍治とは幼なじみ。あまりにも付き合いが長すぎて腐れ縁気味なため、自分が龍治に抱いている感情が恋愛感情ということに気がついていない！"},{"spoiler":false,"text":"何でも出来るパーフェクトな柊子先輩に憧れており自分もそうなりたいと望むが、ドジ属性があるためなかなかうまくいかない。"}],"source":"egs","sourceCharacterId":"12541","sourceWorkId":"13659","spoiler":false},{"segments":[{"spoiler":false,"text":"種族：化け猫・猫娘　学年：2年生"},{"spoiler":false,"text":"『妖学』 副会長。元気いっぱいな女の子。"},{"spoiler":false,"text":"龍治とは幼なじみ。あまりにも付き合いが長すぎて腐れ縁気味なため、自分が龍治に抱いている感情が恋愛感情ということに気がついていない！"},{"spoiler":false,"text":"なんでも出来るパーフェクトな柊子先輩に憧れており自分もそうなりたいと望むが、ドジ属性があるためなかなかうまくいかない。"},{"spoiler":false,"text":"龍治とは古くからの付き合いなので朝起こしに来てもらったり、起こしに行ったりと幼なじみ街道まっしぐらな関係。"},{"spoiler":false,"text":"当然、恋愛対象としての意識は無いので腕を組んだり、キスしようとからかったりする姿は日常茶飯事。"},{"spoiler":false,"text":"「フヒヒ、リュウくんの腕は組みやすいにゃ」"}],"source":"bangumi","sourceCharacterId":"166939"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f81a3b8799e7a10a0eb79324b03627e4442c4e359d8373605ee960eeab712da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dc2c954bec24c187ded8fdd586823965efd4feb6fb4efab3083f7b6e035db21.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13559:166939:4830:1","source":"bangumi"}]},{"characterId":"char_c29775","characterName":"敷浪 小夏","sourceIds":{"bangumi":[{"characterId":"166940","match":"exact-normalized-name-in-linked-work","subjectId":"13559"}],"egsCharacterIds":["12542"],"vndbCharacterId":"c29775"},"originalCharacterName":"敷浪 小夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Japanese Youkai\""},{"spoiler":false,"text":"Race: Yagami Zashikiwarashi"}],"source":"vndb","sourceCharacterId":"c29775"},{"segments":[{"spoiler":false,"text":"【日本妖怪】"},{"spoiler":false,"text":"家神・座敷わらしの少女"},{"spoiler":false,"text":"北歳妖怪学園1年生。"},{"spoiler":false,"text":"妖学会計"},{"spoiler":false,"text":"「人に幸福を与える」座敷わらしという事に目をつけた柊子により、学園に幸を招くマスコットとして無理やり世渡会に参加させられることになる。"},{"spoiler":false,"text":"人に幸せをあたえるといわれる座敷わらしだが、なぜか小夏は自身の幸せを探している。"},{"spoiler":false,"text":"他人との係わり合いや干渉にはあまり積極的ではないが、龍治にだけは心を開く。"}],"source":"egs","sourceCharacterId":"12542","sourceWorkId":"13659","spoiler":false},{"segments":[{"spoiler":false,"text":"種族：家神・座敷わらし　 学年：1年生"},{"spoiler":false,"text":"『妖学』 会計。 “人に幸福を与える” 座敷わらしということに目をつけた柊子により、学園に幸を招くマスコットとして無理やり 『妖学』 に参加させられることになる。"},{"spoiler":false,"text":"人に幸せを与えると言われる座敷わらしだが、なぜか小夏は自身の幸せを探している。"},{"spoiler":false,"text":"他人との係わり合いや干渉にはあまり積極的ではないが、龍治にだけは心を開く。"},{"spoiler":false,"text":"柊子に誘われた事もあるが、元々頭の回転が速いため、会計という仕事は適任であり小夏自身も嫌なわけではない。"},{"spoiler":false,"text":"座敷わらしとしての運命は、周りを幸せにすることだがあまりその能力を使いすぎると……"},{"spoiler":false,"text":"「では、そろそろ授業なんで、失礼します」"}],"source":"bangumi","sourceCharacterId":"166940"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc05805f1d5cfcae7971fc04bc95dae2e38b05dc3ce5662ec0162254086705a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e35807e697c53222ea35f3e47898c5b5f444d58626068f536eeeb96d1a0dbfc7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13559:166940:5940:1","source":"bangumi"}]},{"characterId":"char_c29776","characterName":"アレシア・D・ロンバルド","sourceIds":{"bangumi":[{"characterId":"166941","match":"exact-normalized-name-in-linked-work","subjectId":"13559"}],"egsCharacterIds":["12544"],"vndbCharacterId":"c29776"},"originalCharacterName":"アレシア・D・ロンバルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Western Youkai\""},{"spoiler":false,"text":"Race: Vampire"}],"source":"vndb","sourceCharacterId":"c29776"},{"segments":[{"spoiler":false,"text":"【西洋妖怪】"},{"spoiler":false,"text":"吸血鬼の真祖"},{"spoiler":false,"text":"西洋からやってきた妖怪たちのリーダー的存在。"},{"spoiler":false,"text":"北歳妖怪学園2年生として転入。"},{"spoiler":false,"text":"世界中の妖怪が通う学園の中で一番発言力・影響力を持