alue":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"代々有名な騎士を輩出してきた由緒ある騎士の家柄に生まれ育った少女。"},{"spoiler":false,"text":"学園では一度も負けたことがない程の圧倒的な実力を持つ“学園最強”の存在。"},{"spoiler":false,"text":"その強さだけでなく、誰にでも分け隔てなく接するところから周囲からもお姉様として敬われている。"},{"spoiler":false,"text":"クールで物静かな雰囲気に学生たちが敬遠し、友達と呼べるほど親しい人がいないことを悩んでいる。"},{"spoiler":false,"text":"自身は普通の女の子だと思っているが……少し世間とズレているところがある。"},{"spoiler":false,"text":"大決闘祭での優勝を目指すアキト達の、最大の敵となって立ちはだかる。"}],"source":"egs","sourceCharacterId":"5261","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"学園に入学してから一度も負けたことがない程の圧倒的な実力を持つ“学園最強”の騎士生……だったが、これまでの功績を評価され、学園で“教師”も兼任することになった。"},{"spoiler":false,"text":"強さだけでなく、クールな性格と優雅さを備えた騎士候補生憧れの存在。"},{"spoiler":false,"text":"アキトとの出会いによって初めての恋心を感じ、もっと距離を近づけたいと想いながらも不器用な性格からなかなかうまくいかないことに悩んでいる。"}],"source":"egs","sourceCharacterId":"5261","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・近衛アキトと正式なお付き合いを始め恋人同士になった、元・学園最強の騎士の一人"},{"spoiler":false,"text":"アキトを従騎士に迎え“円卓の騎士・ランスロット”として学外へと活動の場を移し３年。"},{"spoiler":false,"text":"数々の戦いを経て“新鋭騎士”と呼ばれ、フェーダ界で注目を集めている。"},{"spoiler":false,"text":"実力と謙虚、礼節と気品、まさに現代騎士の肖像……と周囲の見方が変わりこそすれ、彼女自体は変わっておらず、いつも通りちょっと天然で頼れる優しいお姉さん。"},{"spoiler":false,"text":"恋人の影響で、以前よりも少しだけ(えっちに)積極的になり彼の望むことならできるだけシてあげたいと恋人への献身性がマシマシになっている。"}],"source":"egs","sourceCharacterId":"28343","sourceWorkId":"39940","spoiler":false},{"segments":[{"spoiler":false,"text":"代々有名な騎士を輩出してきた由緒ある騎士の家柄に生まれ育った少女。"},{"spoiler":false,"text":"誰にでも分け隔てなく接するため、周囲から “お姉様” と敬われている。"},{"spoiler":false,"text":"大決闘祭で優勝を目指すアキトたちの、最大の敵となって立ちはだかる。"},{"spoiler":false,"text":"クールで物静かな雰囲気のため敬遠されてしまい、友達と呼べるほど親しい者がいないことを悩んでいる。"},{"spoiler":false,"text":"自身は普通の女の子だと思っているが…… 少し世間とズレているところがある。"},{"spoiler":false,"text":"「私に気兼ねなく話しかけてくるのは、君くらいだよ」"}],"source":"bangumi","sourceCharacterId":"32746"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"5261","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"5261","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"5261","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"5261","sourceWorkId":"22496","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/718c60dcbedca5e96e7cdbe5b42833edcd94d7ea95273e8d3e773720849e0c92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f07ae78f45dbb3744fefea48588f1545f7d7d945fb79d6e18860c3fe38381e9e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163121:32746:4810:1","source":"bangumi"}]},{"characterId":"char_c23388","characterName":"マリエル・エステリード","sourceIds":{"bangumi":[{"characterId":"32747","match":"exact-normalized-name-in-linked-work","subjectId":"114734"},{"characterId":"32747","match":"exact-normalized-name-in-linked-work","subjectId":"163121"},{"characterId":"32747","match":"exact-normalized-name-in-linked-work","subjectId":"616627"}],"egsCharacterIds":["5262","28346"],"vndbCharacterId":"c23388"},"originalCharacterName":"マリエル・エステリード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"508"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ユリナが幼い頃から仕えているメイド。"},{"spoiler":false,"text":"いつも朗らかで笑顔を絶やさず、周囲に癒やしをもたらしてくれてみんなを見守ってくれるお姉さん的存在。"},{"spoiler":false,"text":"家事を完璧にこなす一方で、かつての騎士として名を馳せた実力者。"},{"spoiler":false,"text":"大の日本文化好きだが、日本語の言い回しをよく間違える。"},{"spoiler":false,"text":"ユリナから主人公のことを聞いていて、会う前から興味津々で、お世話をするようになってからも何かと気にかける。"}],"source":"egs","sourceCharacterId":"5262","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"いつもニコニコ笑顔の似合うメイドさん。"},{"spoiler":false,"text":"主人のユリナだけでなく、屋敷に住むみんなを癒してくれるお姉さん的存在。"},{"spoiler":false,"text":"あらゆることを知っていて、『困った時のマリエルさん』と呼ばれている。"},{"spoiler":false,"text":"大決闘祭ではユリナに頼まれてアキトの師匠となった。"},{"spoiler":false,"text":"かつてはアキトたちと同じ学園に通っていた学園生で、その頃は『鬼神』と恐れられていた。"},{"spoiler":false,"text":"シルヴェリア、みなもとはその頃からの知り合い。"},{"spoiler":false,"text":"大決闘祭後、学園の教師をすることになって、ちょっと緊張気味。"}],"source":"egs","sourceCharacterId":"5262","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"“メイドと言ったら彼女。彼女と言ったらメイド”と呼ばれるほどに認知されているユリナ付きの万能メイドさん。"},{"spoiler":false,"text":"学園での教師姿も見慣れたものとなり、騎士候補生に慕われるまでに。"},{"spoiler":false,"text":"メイドさんとして、いつも笑顔で朗らか、優しさの体現、でありながら騎士として、かつての豪名が色褪せない実力は保っている。"},{"spoiler":false,"text":"新しい目的と自分の楽しみのためにトゥアーリ・フェーダへの参加要請を受ける。"}],"source":"egs","sourceCharacterId":"28346","sourceWorkId":"39940","spoiler":false},{"segments":[{"spoiler":false,"text":"ユリナに幼い頃から仕えているメイド。"},{"spoiler":false,"text":"いつも朗らかで笑顔を絶やさず、周囲に癒しをもたらしみんなを見守ってくれるお姉さん的存在。"},{"spoiler":false,"text":"家事を完璧にこなす一方で、かつて騎士として名を馳せた実力者。"},{"spoiler":false,"text":"大の日本文化好きだが、日本語の言い回しをよく間違える。"},{"spoiler":false,"text":"ユリナから主人公のことを聞いており会う前から興味津々で、お世話をするようになってからも何かと気にかける。"},{"spoiler":false,"text":"「メイドに不可能なんてないですよ♪」"}],"source":"bangumi","sourceCharacterId":"32747"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"5262","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"5262","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"5262","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"5262","sourceWorkId":"22496","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24f19247aeb87e76d67da6815fcf177de3c44bb46ad9f2c34cd317692a20dd69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70d17bfc84e8d450b43ebfbb1445c67a13aff70aa86cd697200aef7af378b123.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163121:32747:6469:1","source":"bangumi"}]},{"characterId":"char_c23391","characterName":"セレーネ・フィエルデス・三峰","sourceIds":{"bangumi":[{"characterId":"32750","match":"exact-normalized-name-in-linked-work","subjectId":"114734"},{"characterId":"32750","match":"exact-normalized-name-in-linked-work","subjectId":"163121"}],"egsCharacterIds":["5263"],"vndbCharacterId":"c23391"},"originalCharacterName":"セレーネ・フィエルデス・三峰","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1112"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レミリア専属のメイドで子供のころから陰ながら支えている。"},{"spoiler":false,"text":"情感豊かなレミリアと対照的に冷静で物腰も静か。"},{"spoiler":false,"text":"普段は冷静に物事を判断する常識人だが、主人であるレミリアに関しては、長い付き合いで培われた的確なツッコミを入れてくる。"},{"spoiler":false,"text":"何かを育てることに関心が高く、今はレミリアの成長を記録することが日々の楽しみ。"},{"spoiler":false,"text":"レミリアの勧めもあり学園に入学したが騎士としての訓練は受けていない。"}],"source":"egs","sourceCharacterId":"5263","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"情感豊かなレミリアと対照的に冷静で物腰も静かなレミリア専属メイド。"},{"spoiler":false,"text":"子供のころから陰ながら支え、普段は冷静に物事を判断する常識人……なはずの毒舌ドＳメイド。"},{"spoiler":false,"text":"レミリアのはからいで学園生になっており、大決闘祭には当初参加していなかったがレミリアを鍛え直す目的で柳生師団に入り、アキトたちの前に立ちはだかる。"},{"spoiler":false,"text":"何かを育てることに関心が高く、レミリアだけでなく最近はミリィやユノとも仲良く接している。"}],"source":"egs","sourceCharacterId":"5263","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"レミリアが子供の頃から陰ながら支えている専属メイド。"},{"spoiler":false,"text":"情感豊かなレミリアとは対照的に、冷静で物腰も柔らかい常識人。"},{"spoiler":false,"text":"ただしレミリアに対してだけは、長い付き合いで培われた的確なツッコミを入れてくる。"},{"spoiler":false,"text":"何かを育てることに関心が高く、今はレミリアの成長を記録することが日々の楽しみ。"},{"spoiler":false,"text":"「レミリアお嬢様で遊んでいいのは私だけです。 専属メイドとしてこれは譲れません」"}],"source":"bangumi","sourceCharacterId":"32750"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"5263","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"身高（本版