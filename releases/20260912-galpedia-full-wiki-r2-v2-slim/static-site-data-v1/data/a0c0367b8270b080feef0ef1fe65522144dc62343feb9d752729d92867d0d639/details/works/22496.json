in-linked-work","subjectId":"114734"},{"characterId":"32742","match":"exact-normalized-name-in-linked-work","subjectId":"163121"},{"characterId":"32742","match":"exact-normalized-name-in-linked-work","subjectId":"616627"}],"egsCharacterIds":["5257","28344"],"vndbCharacterId":"c23383"},"originalCharacterName":"ユリナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"819"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アルビオン国王位継承権第４７位のお姫様。"},{"spoiler":false,"text":"淑やかな物腰と優しい微笑を湛え、気品を兼ね備えているだけでなく、剣才の無さを戦略で補う知性を併せ持つ"},{"spoiler":false,"text":"賢剣才女。"},{"spoiler":false,"text":"身内の前では年相応な女の子であり、本質はイタズラっぽい性格。"},{"spoiler":false,"text":"子供の頃に主人公と出会い、それ以来ずっと淡い恋心を抱いている。"},{"spoiler":false,"text":"主人公と交わした『約束』を今なお大切にしている。"}],"source":"egs","sourceCharacterId":"5257","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"アルビオン国王位継承権第47位の王女。"},{"spoiler":false,"text":"大人びた淑やかな雰囲気と物腰、気品と優雅さを兼ね備えたお姫様。"},{"spoiler":false,"text":"剣才の無さを知略・戦略で補い戦う賢剣才女。"},{"spoiler":false,"text":"子供の頃にアキトと出会い、それ以来淡い恋心を抱いていた。"},{"spoiler":false,"text":"アキトと昔し交わした『約束』を今なお大切にしている。"},{"spoiler":false,"text":"自らの騎士団にアキトを勧誘し優勝を目指した大決闘祭では、仲間と共に見事優勝を果たした。"}],"source":"egs","sourceCharacterId":"5257","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"少し髪が伸び、体もより女性らしく、少女から大人の女性へと変わりつつあるアルビオン国王位継承権第３９位の王女。"},{"spoiler":false,"text":"皇族公務や学術研究などの成績を認められ継承権位が上がるなど才女としても成長中。"},{"spoiler":false,"text":"現在は公務の傍ら、学園長のお手伝い(という尻拭い)をさせられる日々で常に忙しい。"},{"spoiler":false,"text":"シルヴェリアの恋人であり従騎士になったアキトを陰ながらバックアップするなど“想い人への気持ち”を貫いている。"},{"spoiler":false,"text":"３年ぶりに帰ってきたアキトとシルヴェリアにテンションを上げつつ今回の騒動に巻き込まれていく。"}],"source":"egs","sourceCharacterId":"28344","sourceWorkId":"39940","spoiler":false},{"segments":[{"spoiler":false,"text":"アルビオン国 王位継承権第47位のお姫様。"},{"spoiler":false,"text":"淑やかな物腰と優しい微笑を湛え、気品を兼ね備えているだけでなく、剣才の無さを戦略で補う知性を併せ持つ賢剣才女。"},{"spoiler":false,"text":"普段は落ち着いた雰囲気だが、身内だけになると気取らず、年下の主人公をからかったりする。"},{"spoiler":false,"text":"子供の頃に主人公と出会い、それ以来ずっと淡い恋心を抱いている。"},{"spoiler":false,"text":"主人公と交わした “約束” を今なお大切にしている。"},{"spoiler":false,"text":"「頼りにしてるわよ…… 私のナイトくんっ♪」"}],"source":"bangumi","sourceCharacterId":"32742"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"5257","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"5257","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"5257","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"5257","sourceWorkId":"22496","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1935d18380d3c09a9bd5e634da9306aa99c0dc69ca8cc30dd4af2950b8e0896.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26640d60d008aad8686fbc93d06d881f400d695126c6764e31c26587756753ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163121:32742:15637:1","source":"bangumi"}]},{"characterId":"char_c23384","characterName":"レミリア","sourceIds":{"bangumi":[{"characterId":"32743","match":"exact-normalized-name-in-linked-work","subjectId":"114734"},{"characterId":"32743","match":"exact-normalized-name-in-linked-work","subjectId":"163121"}],"egsCharacterIds":["5258"],"vndbCharacterId":"c23384"},"originalCharacterName":"レミリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"701"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名門貴族のレティアハート家のお嬢様。"},{"spoiler":false,"text":"『民の規範たれ』という貴族主義家訓を胸に育ったため、自信家で気が強い性格となる。"},{"spoiler":false,"text":"しかし、自身の間違いを認める素直さを持ち合わせててい、傲慢ではない。"},{"spoiler":false,"text":"言葉や考えなど、必ず何か一つ『抜けている』ことがあるドジ体質。"},{"spoiler":false,"text":"子供のころからユリナとは面識があり、立場は異なるが、好敵手と見ている。"},{"spoiler":false,"text":"ただし、ひとり相撲の感はある。"},{"spoiler":false,"text":"名誉ある貴族の称号『七薔薇章（セブンローズ）』を得るために今回優勝を目指す。"}],"source":"egs","sourceCharacterId":"5258","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"名門貴族レティアハート家のお嬢様。"},{"spoiler":false,"text":"お嬢様育ち故に自信家で気が強いが、自身の間違いを認める素直さと、必ずどこか“抜けている”ドジ体質。"},{"spoiler":false,"text":"アキトとの戦い後、あっさりと好意を抱くようになる。"},{"spoiler":false,"text":"名誉ある貴族の称号『七薔薇章(セブンローズ)』を得るために優勝を目指した大決闘祭だったが、アキトに負けたのをきっかけにユリナの騎士団に参加。優勝に貢献することになった。"}],"source":"egs","sourceCharacterId":"5258","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"名門貴族・レティアハート家のお嬢様。"},{"spoiler":false,"text":"“民の規範たれ” という貴族主義家訓を胸に育ったため、自信家で気が強い性格となる。"},{"spoiler":false,"text":"しかし、自身の間違いを認める素直さを持ち合わせていて、傲慢ではない。"},{"spoiler":false,"text":"子供の頃からユリナとは面識があり、立場は異なるが好敵手と見ている。 ただし、一人相撲の感はある。"},{"spoiler":false,"text":"名誉ある貴族の称号 “七薔薇章（セブンローズ）” を得るために今回優勝を目指す。"},{"spoiler":false,"text":"実は言葉や考えなど、必ず何か一つ “抜けている” ことがあるドジ体質。"},{"spoiler":false,"text":"騎士として実力はあり、主人公との戦いを通じて好意を抱く。"},{"spoiler":false,"text":"「次にわたくしと踊って（デュエルして）くださるのは…… あなたかしら？」"}],"source":"bangumi","sourceCharacterId":"32743"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"5258","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"5258","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"5258","sourceWorkId":"22496","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"5258","sourceWorkId":"22496","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2099865c6014793599a5b4c8d46c5551812de1561150d270e1fc44053be0410.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21a70593d57bae1d3ba4fb1868d6ef6ed509bea296351df23cfaaf6fff09d5a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163121:32743:10662:1","source":"bangumi"}]},{"characterId":"char_c23385","characterName":"刀條 天音","sourceIds":{"bangumi":[{"characterId":"32744","match":"exact-normalized-name-in-linked-work","subjectId":"114734"},{"characterId":"32744","match":"exact-normalized-name-in-linked-work","subjectId":"163121"}],"egsCharacterIds":["5259"],"vndbCharacterId":"c23385"},"originalCharacterName":"刀條 天音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"110"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ユリナの従者として礼節を重んじる侍娘。"},{"spoiler":false,"text":"忠実でクール、真面目で堅物と、「侍」を表したような性格。"},{"spoiler":false,"text":"日本に古くから伝わる古流剣術の正統後継者で、その実力は学園でも上位に入る。"},{"spoiler":false,"text":"初めは主人公を警戒していたが、しだいに心惹かれていく。"},{"spoiler":false,"text":"実は可愛いもの好きで、こっそりと気に入ったのを集めている。"}],"source":"egs","sourceCharacterId":"5259","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"ユリナの近衛騎士。従者として礼節を重んじる侍娘で、卓越した剣の腕を持つ。"},{"spoiler":false,"text":"古流剣術・刀條流の正統後継者。実力は学園でも上位に入る。"},{"spoiler":false,"text":"忠実で実直。生真面目で堅物と“侍”を表したような性格だが、実は可愛いもの好きで、こっそりと気に入ったのを集めている女の子な面も隠している。"},{"spoiler":false,"text":"初めはアキトを警戒していたが、しだいに心惹かれていき、大決闘祭を共に戦い抜く中で、自身のトラウマ克服を助けてもらうことをきっかけに恋に落ちた。"}],"source":"egs","sourceCharacterId":"5259","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"ユリナの従者として礼節を重んじる侍娘。"},{"spoiler":false,"text":"忠実でクール、真面目で堅物と “侍” を表したような性格。"},{"spoiler":false,"text":"日本に古くから伝わる古流剣術の正統後継者で、その実力は学園でも上位に入る。"},{"spoiler":false,"text":"実は可愛いもの好きで、こっそりと気に入ったのを集めている。"},{"spoiler":false,"text":"ユリナが信頼を置く主人公に初めは警戒心を抱くが、しだいに惹かれていく。"},{"spoiler":false,"text":"「私は認めない…… 姫様の騎士は私ひとりで充分だ！」"}],"source":"bangumi","sourceCharacterId":"32744"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","