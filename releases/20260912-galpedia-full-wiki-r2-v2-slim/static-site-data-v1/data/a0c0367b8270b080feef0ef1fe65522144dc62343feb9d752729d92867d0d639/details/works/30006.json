gments":[{"spoiler":false,"text":"水杜神社に住む犬耳尻尾付きの神様。"},{"spoiler":false,"text":"幹也や音羽姉妹との生活で人見知りは大分なりを潜めた。"},{"spoiler":false,"text":"ただし相変わらず口数は少なく、慣れていない人の前ではあまり感情を出さない。"},{"spoiler":false,"text":"その心根は優しい。"}],"source":"bangumi","sourceCharacterId":"87303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1a3fa8d86b7c52519f01719397a9c54f3787a2b735e7011460ff83a7bb0e9f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75f91d2c9346b59d8f4e858d866472bcbf9176f14772f8d0c4d9fce638f2ec0f.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"静木亜美","creatorId":"vndb:s663","sourcePersonId":"vndb:s663","canonicalEntityId":"vndb:s663","name":"静木 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:315332:87303:8575:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2720","sourceCompanyId":"egs:brand:2720","canonicalEntityId":"egs:brand:2720","name":"でぼの巣製作所","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:30006:2720","source":"egs"},{"companyId":"vndb:p9483","sourceCompanyId":"vndb:p9483","canonicalEntityId":"vndb:p9483","name":"Shiravune","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107302:v29733","source":"vndb"},{"companyId":"vndb:p9483","sourceCompanyId":"vndb:p9483","canonicalEntityId":"vndb:p9483","name":"Shiravune","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:133704:v29733","source":"vndb"},{"companyId":"vndb:p709","sourceCompanyId":"vndb:p709","canonicalEntityId":"vndb:p709","name":"でぼの巣製作所","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:85278:v29733","source":"vndb"},{"companyId":"vndb:p709","sourceCompanyId":"vndb:p709","c