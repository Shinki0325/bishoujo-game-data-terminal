nly","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【雅と姉妹関係を結ぶ、明るく元気な後輩】"},{"spoiler":false,"text":"何事にも直情的な、笑顔が良く似合う後輩。"},{"spoiler":false,"text":"先輩が後輩をマンツーマンで指導する「コンダクト」という関係を雅と結んでおり、いつも雅に付き添っている。"},{"spoiler":false,"text":"スポーツ特進クラス「花組」に所属、優秀なテニスプレーヤーだったが、ある事情のため、長期に渡り、深いスランプに陥っている。"},{"spoiler":false,"text":"出身がごく普通の家のため、晃輔とは気が合うようだ。"}],"source":"egs","sourceCharacterId":"3442","sourceWorkId":"10868","spoiler":false},{"segments":[{"spoiler":false,"text":"笑顔がとてもよく似合う何事にも『直線的』な後輩の女の子。"},{"spoiler":false,"text":"エトワール内特有の風習である『コンダクト』と呼ばれる、後輩が特定の先輩の生活をお世話する、という関係を雅と結んでおり、いつも雅に付き添っている。"},{"spoiler":false,"text":"優秀なテニスの選手だったが、とある事情のために長く深いスランプ状態に陥ってしまっている。"}],"source":"bangumi","sourceCharacterId":"39483"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57a94c9fb7204044885f07c7c362bae5e9d48c834e8b530723ed6a3dd55f041a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bcc51ded81f4a22cfa9e147d51ccad713a2b0d079a0f6e6d55ccbf4c7d6a22e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16337:39483:6038:1","source":"bangumi"}]},{"characterId":"char_c25893","characterName":"桐島 悠","sourceIds":{"bangumi":[{"characterId":"39484","match":"exact-normalized-name-in-linked-work","subjectId":"16337"},{"characterId":"39484","match":"exact-normalized-name-in-linked-work","subjectId":"22612"}],"egsCharacterIds":["3444"],"vndbCharacterId":"c25893"},"originalCharacterName":"桐島 悠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【寡黙な王子様？】"},{"spoiler":false,"text":"久住の親友で「星令会」の副会長。"},{"spoiler":false,"text":"背が高い、中性的で端麗な容姿、一人称は「僕」と、宝○系の美少女で、女子から圧倒的な人気を誇り、「悠様」と呼ばれている。"},{"spoiler":false,"text":"しかし、本人はそれを困ったことだと思っているようで、そっけない態度を見せるが、ファンにはかえって「そこもイイ」らしい。"},{"spoiler":false,"text":"水泳部のエースで、晃輔のことも以前から知っていた。"}],"source":"egs","sourceCharacterId":"3444","sourceWorkId":"10868","spoiler":false},{"segments":[{"spoiler":false,"text":"『プリマ☆ステラ』に登場。"},{"spoiler":false,"text":"みんなからは王子として見られている悠と、エトワールに現れた、本物の男である晃輔。"},{"spoiler":false,"text":"お互いの心が、少しずつ近くなっていくのを感じてる二人。"},{"spoiler":false,"text":"そんな折、悠からクリスマスパーティーに誘われた晃輔は…。"}],"source":"egs","sourceCharacterId":"3444","sourceWorkId":"12733","spoiler":false},{"segments":[{"spoiler":false,"text":"久住の親友にして『星令会』の副会長。久住を影でサポートしている縁の下の力持ち。"},{"spoiler":false,"text":"言われなければ美男子としても通ってしまいそうなほど中性的な容姿をしており、校内での人気は高く、皆からは『悠様』とまるで王子様のような扱いを受けている。"},{"spoiler":false,"text":"エトワール水泳部の中で名実ともにエースの地位にいる。"},{"spoiler":false,"text":"久住つたいに晃輔と知り合いになり、以後頼りになる男友達のような関係になる。"}],"source":"bangumi","sourceCharacterId":"39484"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"3444","sourceWorkId":"12733","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"3444","sourceWorkId":"12733","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"3444","sourceWorkId":"12733","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"3444","sourceWorkId":"12733","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3e4d4e4f0c7c6f427e42ff2462ea6981ac1cc98ca9faf53ec2fe1571b17d719.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/881d4b06bf15ec6ab68ab823fcaba17336ffddd4394084795b7d15821340e0c8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16337:39484:5741:1","source":"bangumi"}]},{"characterId":"char_c5323","characterName":"姫様","sourceIds":{"bangumi":[{"characterId":"39480","match":"exact-normalized-name-in-linked-work","subjectId":"22612"}],"egsCharacterIds":["3440"],"vndbCharacterId":"c5323"},"originalCharacterName":"姫様","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【生粋の箱入りお嬢様】"},{"spoiler":false,"text":"お嬢様が通う「聖エトワール女学園」の中でも、特別なお嬢様だけが集まる「光組」に所属する少女。"},{"spoiler":false,"text":"事故から助けてもらった晃輔の「夢」を奪ったことに責任を感じ、なんとか恩返しできないかと、実家を通じてエトワールへ招き入れる。"},{"spoiler":false,"text":"周囲から高いを評価を受け、「姫」と呼ばれているが、本人は、その評価に恐縮どころか怯えさえしている。"},{"spoiler":false,"text":"そんな彼女にとって、晃輔のエトワール編入は大冒険だったようだ。"}],"source":"egs","sourceCharacterId":"3440","sourceWorkId":"10868","spoiler":false},{"segments":[{"spoiler":false,"text":"聖エトワールの中でもたった1クラスしかない、お嬢様の中のお嬢様だけが集められた特別クラス『光組』に所属しているお嬢様。"},{"spoiler":false,"text":"他の生徒たちから『姫』という二つ名で呼ばれている、名実ともに生粋の洋風お嬢様である。"},{"spoiler":false,"text":"静歌は晃輔の夢を奪ったことに責任を感じ、学園に多大な影響がある実家を通して学園側を動かした。"},{"spoiler":false,"text":"そうして晃輔は静歌の意向によって、エトワールに招かれた……このお話の根幹を担う人物。"},{"spoiler":false,"text":"見事な箱入り娘で、『小動物』という表現がぴったりくる女の子。"},{"spoiler":false,"text":"周囲からの自分の評価に謙遜し、むしろ怯えているほどで、そんな彼女が晃輔をエトワールに招いたのは、彼女にとって大冒険だった。"}],"source":"bangumi","sourceCharacterId":"39480"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/316decf93dcc1f1050794da1fa86e9e41d4adbc6877a9cebd1fb20890983d8b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74b567adef084ca491c07e76861fc403eec13a211632f1c4aba733c1d9bc387b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16337:39480:4830:1","source":"bangumi"}]},{"characterId":"char_c5599","characterName":"くすねぇ","sourceIds":{"bangumi":[{"characterId":"39481","match":"exact-normalized-name-in-linked-work","subjectId":"22612"}],"egsCharacterIds":["3441"],"vndbCharacterId":"c5599"},"originalCharacterName":"くすねぇ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【ちょっぴり困った才女な従姉】"},{"spoiler":false,"text":"才女が集まる「月組」所属、そして学園の生徒会に相当する生徒意思統括組織「星令会」の会長を務める少女。"},{"spoiler":false,"text":"晃輔とは従姉の間柄で、留学を機に久しぶりに再会する。"},{"spoiler":false,"text":"普段は凛とした「会長様」なのだが、晃輔と二人きりになると、素が出て、とんでもない崩れっぷりを披露。"},{"spoiler":false,"text":"色々世話を焼きたがるが、結果的に世話されてしまうタイプで、晃輔は、毎回手を焼かされることに。"}],"source":"egs","sourceCharacterId":"3441","sourceWorkId":"10868","spoiler":false},{"segments":[{"spoiler":false,"text":"エトワール女学院の中でも才女が集まる『月組』に所属し、さらに聖エトワールの生徒会に相当する生徒意思統括組織『星令会』の会長をもつとめる、学生たちから尊敬される偉大な先輩。"},{"spoiler":false,"text":"晃輔とは従姉妹の関係にあたり、留学した後、久しぶりの再会を喜びあうことになる。"},{"spoiler":false,"text":"普段は凛とした『会長様』なのだが、晃輔と二人きりなどになると素が出てしまう。"},{"spoiler":false,"text":"普段の彼女からは想像できない崩れっぷりで、ちょっぴり困った「くす姉モード」の彼女に晃輔は毎回手を焼くことになる。"}],"source":"bangumi","sourceCharacterId":"39481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b57c7e1b4c50b6c8c7987988068302173579d53e6dc89b0cf8540be169