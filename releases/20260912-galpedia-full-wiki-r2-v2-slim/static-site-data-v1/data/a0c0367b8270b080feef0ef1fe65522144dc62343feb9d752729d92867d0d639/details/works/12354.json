","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:76689","source":"egs"}],"music":[{"creditedName":"Angel Note","creatorId":"vndb:s758","sourcePersonId":"vndb:s758","canonicalEntityId":"vndb:s758","name":"Angel Note","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:32723","source":"vndb"}],"other":[{"creditedName":"どせい","creatorId":"vndb:s4161","sourcePersonId":"egs:creator:15665","canonicalEntityId":"vndb:s4161","name":"どせい","detail":"ムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112584","source":"egs"},{"creditedName":"yuiko(ゆいこ)","creatorId":"vndb:s1970","sourcePersonId":"egs:creator:12712","canonicalEntityId":"vndb:s1970","name":"yuiko(ゆいこ)","detail":"OP曲「Devil or Angel」、ED曲「はっぴぃ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:82369","source":"egs"},{"creditedName":"yuiko","creatorId":"vndb:s1970","sourcePersonId":"vndb:s1970","canonicalEntityId":"vndb:s1970","name":"yuiko","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:32727","source":"vndb"},{"creditedName":"織澤 あきふみ","creatorId":"vndb:s3203","sourcePersonId":"vndb:s3203","canonicalEntityId":"vndb:s3203","name":"織澤 明史","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:32729","source":"vndb"}]},"cast":[{"characterId":"char_c38141","characterName":"仲内 知由","sourceIds":{"bangumi":[{"characterId":"109115","match":"exact-normalized-name-in-linked-work","subjectId":"1409"},{"characterId":"109115","match":"exact-normalized-name-in-linked-work","subjectId":"20766"}],"egsCharacterIds":["9484"],"vndbCharacterId":"c38141"},"originalCharacterName":"仲内 知由","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"健介の隣のクラスにいるアイドル。"},{"spoiler":false,"text":"チュチュと合体してアイドルをしている割に庶民的。"},{"spoiler":false,"text":"性格もよく、社交的なのだが健介に対しては攻撃的。"},{"spoiler":false,"text":"しかし、同棲後は健介のためにしぶしぶお弁当を作ってあげたりと、何かと世話を焼いてくれる。"},{"spoiler":false,"text":"「健介もだよ。もうエッチなことは厳禁なんだからねっ」"}],"source":"egs","sourceCharacterId":"9484","sourceWorkId":"8721","spoiler":false},{"segments":[{"spoiler":false,"text":"『Chu×Chuアイドる』 のヒロインで学生。チュチュの相棒。"},{"spoiler":false,"text":"マジメで明るく優しい活発な娘だが、照れると怒ってきたりする。"},{"spoiler":false,"text":"チュチュに巻き込まれて健介ともエッチなことをしてしまったりするが、彼女自身も二人のことを拒むことができない。"},{"spoiler":false,"text":"彼女も呪いを受けてしまったので、歌が音痴になってしまっている。"}],"source":"egs","sourceCharacterId":"9484","sourceWorkId":"15517","spoiler":false},{"segments":[{"spoiler":false,"text":"チュチュとキスして合体しトップアイドル「チューア・チュラム」として活動中の女の子。"},{"spoiler":false,"text":"相変わらずの貧乏性だけど、とてもしっかりした女の子。"},{"spoiler":false,"text":"彼女はチュチュと一緒には飛ばされていないらしい。"}],"source":"egs","sourceCharacterId":"9484","sourceWorkId":"16176","spoiler":false},{"segments":[{"spoiler":false,"text":"健介の隣のクラスにいる人気急上昇中のアイドル。チュチュとキスする事で合体し、アイドル「チューア・チュラム」として活動中。"},{"spoiler":false,"text":"性格は明るく、社交的。アイドルをしている割には、買い物上手だったり節約術を沢山知っていたりと、庶民的な一面も。"},{"spoiler":false,"text":"母親が元気になった今は、お金にはそんなに困っていない。だが、貧乏時代の癖はまるでぬけておらず、節約の鬼。"},{"spoiler":false,"text":"健介の事は苦楽を共にしてきたパートナーとして、とても信頼している。"},{"spoiler":false,"text":"健介はチュチュと付き合い始めたが、いまだに健介の事がちょっと好き。"}],"source":"bangumi","sourceCharacterId":"109115"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7c9c0d72cd72cc0c41085883fc817a33afa49ba7f5bfe3abf69d797b351ed8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dbbfa5f622cc89f7ee6f75d853439a779b9c3c7ff1ef05940447d7f965057a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c38144","characterName":"ヒヨリ・ピクシー","sourceIds":{"bangumi":[{"characterId":"109116","match":"exact-normalized-name-in-linked-work","subjectId":"1409"},{"characterId":"109116","match":"exact-normalized-name-in-linked-work","subjectId":"20766"}],"egsCharacterIds":["10040"],"vndbCharacterId":"c38144"},"originalCharacterName":"ヒヨリ・ピクシー","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"チュチュとうたのマネージャーを務める優しいお姉さん。"},{"spoiler":false,"text":"実は魔族で、チュチュのお母さん探しの最大の理解者。"},{"spoiler":false,"text":"非常に有能なのだが、恋愛ごとが絡んでくると、途端にあたふたしてしまう。"},{"spoiler":false,"text":"「痛みが取れるまで、わたしの膝枕でゆっくり休んでくださいね」"}],"source":"egs","sourceCharacterId":"10040","sourceWorkId":"8721","spoiler":false},{"segments":[{"spoiler":false,"text":"チューアのマネージャーを務める、どくろラビットの頼れる良心。"},{"spoiler":false,"text":"魔界の貴族出身であり、強い魔力を持つピクシーの家系。"},{"spoiler":false,"text":"不甲斐ないアルバートに代わって会社を切り廻すほどの有能な女性なのだが、私生活に戻ると恋愛下手だったりと、いろいろ可愛らしい弱点が。"},{"spoiler":false,"text":"実は結構な年齢のようで（？）、周囲からも嫁き遅れを心配され始めている。"}],"source":"egs","sourceCharacterId":"10040","sourceWorkId":"15517","spoiler":false},{"segments":[{"spoiler":false,"text":"Chu×Chuアイドるユニゾンシフト・アクセント"},{"spoiler":false,"text":"「どくろラビット」のプロデューサーでチューア・チュラムのマネージャー。"},{"spoiler":false,"text":"アイドルグループのプロデュースに力を注ごうとするが、自分もそのメンバーになる羽目に。"},{"spoiler":false,"text":"魔界の貴族出身で有能な女性だが頑張りすぎて婚期を逃してるという噂。酔うと面倒。"}],"source":"egs","sourceCharacterId":"10040","sourceWorkId":"16176","spoiler":false},{"segments":[{"spoiler":false,"text":"どくろラビットに勤める先輩マネージャー。その正体は、魔界の貴族のお嬢様。チュチュの親友で、最大の理解者。"},{"spoiler":false,"text":"仕事をバリバリこなすので出来る人と思われているが私生活に戻ると恋愛下手だったりと、いろいろ弱点が。"},{"spoiler":false,"text":"いい人が現れないかなぁ…と思いながら仕事に励む毎日。子供が大好きで、すこし頼りない健介を子供扱いする反面、たまに見せるシッカリしている所に少しドキドキしてる。"},{"spoiler":false,"text":"チュチュにまで先を越されて、嫁き遅れ感が増した。"}],"source":"bangumi","sourceCharacterId":"109116"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84a650a483f715b83dd24b226a3d0c74604083ed769de7e408ec7e11d730dbfd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aef79641d463ac79f990c5c44f49a5bafcb5e94a7bf0179e65c48d7cc3f32fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c45731","characterName":"マイカ","sourceIds":{"bangumi":[],"egsCharacterIds":["14181","15426"],"vndbCharacterId":"c45731"},"originalCharacterName":"マイカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rena's familiar."}],"source":"vndb","sourceCharacterId":"c45731"},{"segments":[{"spoiler":false,"text":"舞台となる館の女主人。"},{"spoiler":false,"text":"主人公の父親の遠縁の親戚にあたるらしい。"},{"spoiler":false,"text":"いつもほほ笑みを絶やさない、一見温厚に見える美女だが、何を考えているかわからず、何処か謎めいた雰囲気を漂わせている。"}],"source":"egs","sourceCharacterId":"14181","sourceWorkId":"13344","spoiler":false},{"segments":[{"spoiler":false,"text":"【イジめられるのが大好き使い魔】"},{"spoiler":false,"text":"レナの使い魔。"},{"spoiler":false,"text":"主人であるレナを追いかけて、人間界へやってくる。"},{"spoiler":false,"text":"柔らかな雰囲気の容姿に似合わず毒舌家。"},{"spoiler":false,"text":"自分より後輩ペットの遼平に何かと先輩風を吹かせ、遼平をウンザリとさせる。"},{"spoiler":false,"text":"「後輩のくせに生意気ですぅ！」"}],"source":"egs","sourceCharacterId":"15426","sourceWorkId":"12354","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb6f6194700c7910985e72102a9118c799de7f182e860bb2c44ef88c496723fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f330effbee69bdc3a98e03065edc1488bce61d2202207ec2be2f6ffb6b476757.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬 未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","na