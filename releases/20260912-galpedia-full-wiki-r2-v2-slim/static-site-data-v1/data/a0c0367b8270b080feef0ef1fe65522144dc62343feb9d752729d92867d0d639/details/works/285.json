tyStatus":"source-native","relationId":"vndb:vn-staff:48604","source":"vndb"},{"creditedName":"美汐 優","creatorId":"vndb:s3555","sourcePersonId":"vndb:s3555","canonicalEntityId":"vndb:s3555","name":"美汐 優","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48606","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c98451","characterName":"久遠寺 宗治","sourceIds":{"vndbCharacterId":"c98451"},"originalCharacterName":"久遠寺 宗治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Souji is emotionless and detached, most likely as a result of the toxic relationship within his family."},{"spoiler":true,"text":"He has been sexually abused by both parents and his older sister, Kasumi, and currently committing incest with his younger sister, Asuka. The only time he shows any glimmer of emotion is during sex, although he remains stoic when Asuka copulates with him. Memories of being raped still plague him often, and he finds himself being additionally tormented by nightmares of a mysterious woman who tries to both rape and kill him."},{"spoiler":false,"text":"Souji's demeanor during and after intimacy is both coldly dominant and dismissive."},{"spoiler":true,"text":"He flatly dismisses Asuka's friend Mayumi after he takes her virginity, and forces himself on Makoto after she is assaulted by several female members of their kendo club, seeming to revel in dominating her. Sōji's heart begins to thaw after a fateful coupling with Mizuki; fed up with his abuse, she slaps and berates him. He responds by trying to strangle her, stopping only when he gets flashbacks of choking out the dark-haired woman from his nightmares. Completely shaken, Souji releases Mizuki and apologizes tearfully. He later apologizes to Mayumi for the way he had treated her, tries to apologize to Makoto (who ignores him when he calls out to her), and begins a real relationship with Mizuki. By the start of Kokoro II, Sōji and Mizuki had married, and Souji had taken over as president of the family business."},{"spoiler":false,"text":"From au.VVikipedia."}],"source":"vndb","sourceCharacterId":"c98451"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c98452","characterName":"久遠寺 明日香","sourceIds":{"vndbCharacterId":"c98452"},"originalCharacterName":"久遠寺 明日香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"AA"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"source-only","source":"vndb","value":"38"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c1e8e1a58e47a44e74d95179a4136d503c1783fad4664359a799f1d22ac04eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9ffda2d3e8800c5686d8720b92d0e8250e029b587a3950a0ae69e6ab4a2628a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩田 由貴","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26950","source":"vndb"}]},{"characterId":"char_vndb_c98453"