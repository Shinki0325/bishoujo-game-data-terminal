ePersonId":"vndb:s2021","canonicalEntityId":"vndb:s2021","name":"WHITE-LIPS","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:5793","source":"vndb"},{"creditedName":"とろ美","creatorId":"vndb:s5568","sourcePersonId":"vndb:s5568","canonicalEntityId":"vndb:s5568","name":"とろ美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:5795","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c12299","characterName":"クリス","sourceIds":{"vndbCharacterId":"c12299"},"originalCharacterName":"クリス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chris is a slacker who moves to a new city where he is to begin a new part-time job. Completely penniless, he moves in a mansion where three sisters live. The rent is cheap and includes three meals a day. However, he quickly learns he must change his slacker ways."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/036d4ba350e401dcf46208657f67ac443d1c236e091ef0a745482562260a4ffb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c94c6879bc4a1ac13afa5eb2a8f9e825f58720b86b76caf332cfad5430fbb997.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c12300","characterName":"あい","sourceIds":{"vndbCharacterId":"c12300"},"originalCharacterName":"あい","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Oldest sister and the present landlady of the mansion."},{"spoiler":false,"text":"She is near-sighted and needs glasses to see clearly; in addition, she has no sense of direction. Ai is a motherly figure who constantly tries to help people. Her easygoing, caring nature often leads her to fail at things because she cannot muster the resolve to criticize others. This is why she allows Chris to stay with them when she finds out he has nowhere else to go."},{"spoiler":false,"text":"Believing she is ugly and fat, Ai hides herself behind her glasses and by wearing large, loose-fitting clothes. She also seems to be the de facto caretaker of her sisters' pet ferret, Unagi, which often hides under her hat. Ai also loves to take baths, more than once a day if possible. Ai has the ability to speak to plants."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12300"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c03a711b161a462371e8f649b52a3033cf77fd801bb32c6580b9beeed904b19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ede9ac06fa4929f91584f9e59bbe47b602cd447eae9ae63763bcc4e7431c62f1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤崎 まゆ","creatorId":"vndb:s10529","sourcePersonId":"vndb:s10529","canonicalEntityId":"vndb:s10529","name":"藤崎 まゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2083","source":"vndb"}]},{"characterId":"char_vndb_c12301","characterName":"小奈美","sourceIds":{"vndbCharacterId":"c12301"},"originalCharacterName":"小奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chris's childhood friend before left his old town. Konami is a trendy, cheerful and optimistic girl with almost as much energy as Mii and just as much naiveness. She rarely thinks of the consequences of her actions. When she starts attending Mai's school, she and Mai become best friends."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12301"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba8309823910fc5a7cfcf19c45f24a7a65e283297374efac2ef1f9c2b3e3f882.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df3a3fceb2baa05767b3bdc7c10a0926ce5caa8f1d54c27d76afa8d1314b5858.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春瀬 みき","creatorId":"vndb:s1566","sourcePersonId":"vndb:s1566","canonicalEntityId":"vndb:s1566","name":"春瀬 みき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2078","source":"vndb"}]},{"characterId":"char_vndb_c12302","characterName":"まい","sourceIds":{"vndbCharacterId":"c12302"},"originalCharacterName":"まい","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The middle sister."},{"spoiler":false,"text":"Although she is the middle sister, Mai governs household affairs such as the budget. She longs to leave the mansion but does not want to burden Ai whom she knows does not have the willpower to deal with such responsibilities. Mai has a tomboyish personality and is very short-tempered, especially when it comes to Chris, the more so when she thinks she'll lose face. She is the only character who vehemently opposes Chris's staying at the mansion."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12302"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97e693a59e06648c0e939f5bd159428d70e3cc509feacafc3c7acd8431da662e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eb629ae66a37eba8e961949a0547411c4a778b5e5452c8438dca809fcec2222.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜川 美央","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2076","source":"vndb"}]},{"characterId":"char_vndb_c12303","characterName":"メアー","sourceIds":{"vndbCharacterId":"c12303"},"originalCharacterName":"メアー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The sisters' maid."},{"spoiler":false,"text":"She appears to behave like if she had no emotions at all, especially at the beginning of the game, but Mare later proves that she does have her own desires. She also becomes friendlier with Chris as the story progresses to various degrees, depending upon whether it's her scenario or not."},{"spoiler":false,"text":"Is disliked by Mai who calls Mare \"Roboko\" rather than by her name, always threatened to be destroyed or to be disposed of by her"},{"spoiler":true,"text":"though Mai comes to accept Mare in the end of her route, even calling her by her name"},{"spoiler":false,"text":"."},{"spoiler":true,"text":"She is actually a human who was disabled to the point that she was unable to do anything due to her brain being unable to cope with the Popotan-phenomenon."},{"spoiler":true,"text":"She was picked up by Claude who brainwashed her into believing she's an Android, naming her Mare. She is then sent to the house of the three sisters to investigate the cause of their psychic powers under the cover of working as a maid."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c12303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54f93748f5d85a579e41076e245f66b95a1de7d9a8fb130c561c3985849f95bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8247602dc58c24fb59b6f5af57853e1b7363ff7f0c30ffcae5a2a016423e39c0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"乃田 あす実","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2077","source":"vndb"}]},{"characterId":"char_vndb_c12304","characterName":"クロード","sourceIds":{"vndbCharacterId":"c12304"},"originalCharacterName":"クロード","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Leader of the rock band Angelos and Chris's rival. He has reddish-brown hair and wears black clothing with his guitar strapped to his back."},{"spoiler":true,"text":"Depending upon how the story unfolds, Claude's appearance may be closer to that of a minor character in certain scenarios, though he still plays a key role in several endings. In Mii's scenario, one of her several \"Magical Girl Mii\" mini-games involve Claude."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12304"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dcd8e8a120aacd5006c47de7522d77b5c8403045f375a10d393a13aa57ff20b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f1d7614a075158cb466f04e893d313b7883a546fef498e5fbb226961e516655.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷川 将","creatorId":"vndb:s6567","sourcePersonId":"vndb:s6567","canonicalEntityId":"vndb:s6567","name":"谷川 将","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2081","source":"vndb"}]},{"characterId":"char_vndb_c12305","characterName":"みい","sourceIds":{"vndbCharacterId":"c12305"},"originalCharacterName":"みい","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"11"},"bust":{"reviewState":"source-only","source":"vndb","value":"64"},"height":{"reviewState":"source-only","source":"vndb","value":"134"},"hip":{"reviewState":"source-only","source":"vndb","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mii is the youngest sister. She has light purple hair which is often tied in double buns on her head, except when she cosplays \"Magical Girl Mii\"; she then wears it in twintails. Mii goes to the same school as Mai. Mii is the most energetic, perverted and naive of the three. She goes around asking Chris to play with her almost anytime she sees him and loves to cosplay as a magical girl, \"Magical Girl Mii\", trying to help others out around town, though the results often vary."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c12305"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20b3dcdbc6914b240da1964332f198223db3733f8cd61410de359254c3905927.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38dd3e0a5e50b5a66e782071543283ec4d05f0db67c707cdc8a9f07b8caca545.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"とろ美","creatorId":"vndb:s5568","sourcePersonId":"vndb:s5568","canonicalEntityId":"vndb:s5568","name":"とろ美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2080","source":"vndb"}]},{"characterId":"char_vndb_c12306","characterName":"のの","sourceIds":{"vndbCharacterId":"c12306"},"originalCharacterName":"のの","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"height":{"reviewState":"source-only","source":"vndb","value":"136"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A shrine maiden-in-training who takes her training seriously. She cleans and takes care of the shrine. She also tries to do fortune telling in the city, though she is infamous for getting her fortunes wrong."},{"spoiler":false,"text":"She is the first major character Chris is introduced to in the game. At first she does not seem to be fond of him because of his slacker mentality, but eventually she learns to like him."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c12306"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36db2a38ed5e9d8fcd58facff307c638c9f000cb92310e0a4519c9e623e3ed03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93d6b13d716e46fce1ce8a7849bd0f57cffa72ae6bb07cb7c4b3012f35c3561f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2074","source":"vndb"}]},{"characterId":"char_vndb_c12307","characterName":"雫","sourceIds":{"vndbCharacterId":"c12307"},"originalCharacterName":"雫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her calm, mature demeanor contrasts with her youthful appearance, and thus her age is a mystery. Chris meets her on a stroll at night and brings her back to the mansion. She lacks linguistic skills, and at first not much about her is learned. Because Shizuku is unable to take care of herself, Chris offers to pay her rent as well."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c12307"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e082cd91f1f0e11780a7dda9975ee37ee042e67923fe0591c486e3a6036e5be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/830c49952d6d1ae25b5d68620810532ccd1f9fe2fc551f54a95f69ba54cb6e00.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎 みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2075","source":"vndb"}]},{"characterId":"char_vndb_c12308","characterName":"うなぎ","sourceIds":{"vndbCharacterId":"c12308"},"originalCharacterName":"うなぎ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A white female ferret that can transform into a humanoid hybrid; she is the only notable such hybrid of its type in any form of literature. In her humanoid form, Unagi is indistinguishable from a normal human except for her white tail and animal ears. She does not get along with Mii at all as Mii becomes jealous of the time she spends with Chris."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c12308"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e41849275eb60afa2d7b98aaadc93251b0a88a43ce0bfe75bdd262303da45d71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfbbfbeb7a424b2e6a52fe951e21766668747ab368be38aea75ce8376071839c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥居 花音","creatorId":"vndb:s563","sourcePersonId":"vndb:s563","canonicalEntityId":"vndb:s563","name":"森山 理来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2073","source":"vndb"}]},{"characterId":"char_vndb_c13080","characterName":"ここあ","sourceIds":{"vndbCharacterId":"c13080"},"originalCharacterName":"ここあ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kokoa is a manager of a supermarket. She views convenience stores as inferior to supermarkets, and because of this, she comes off quite hostile to Chris at first."},{"spoiler":true,"text":"Kokoa is semi-hidden romanceable character, though her level of interaction otherwise would be indistinguishable from a minor character. She is not listed among the official main characters on sites like Getchu, but does have her own character image and scene reminiscence section."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c13080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://