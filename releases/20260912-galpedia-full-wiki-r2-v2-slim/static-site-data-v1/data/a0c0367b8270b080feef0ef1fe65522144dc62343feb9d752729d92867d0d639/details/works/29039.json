-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An arrogant and uppity sadist, she has absolute confidence in her attractiveness and talent and disdains all others (Fellow Queen members are an exception). Males under her are treated no better than slaves. She wields psychokinetic powers when the power of her Mantle Armament is initiated."},{"spoiler":false,"text":"She has extensive knowledge of abusing males, but her knowledge of sex is shallow as she sees males as no different from toys. A virgin."}],"source":"vndb","sourceCharacterId":"c87652"},{"segments":[{"spoiler":false,"text":"高慢で高飛車な、S系少女"},{"spoiler":false,"text":"自分の魅力と才能に絶対的な自信を持っており、他人を見下している（クイーンだけは例外）"},{"spoiler":false,"text":"配下の男たちを奴隷のように扱う"},{"spoiler":false,"text":"外套型のアーマメントの能力を発動することで、サイコキネシス（念動力）を操る。"},{"spoiler":false,"text":"男性を弄ぶために知識は豊富だが、男はあくまでも玩具と捉えておりまともなセックスの経験はない。"},{"spoiler":false,"text":"処女。"}],"source":"egs","sourceCharacterId":"22099","sourceWorkId":"29039","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a62720986d26f21caaa85a80a782b08b2335d29d47abfc68705d9abc1172e755.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d1ec10f4c03aa12259adf210a47df380c30c07aafc4c72393d6e868d3ece5fb.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐村まり","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:297023:150486:23768:1","source":"bangumi"}]},{"characterId":"char_c87653","characterName":"ジンリー","sourceIds":{"bangumi":[{"characterId":"150483","match":"exact-normalized-name-in-linked-work","subjectId":"297023"}],"egsCharacterIds":["22101"],"vndbCharacterId":"c87653"},"originalCharacterName":"ジンリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A calm and calculating beauty, she always carries a small handgun Armament with her, but when it deploys it transforms into a heavy weapon with multiple turrets which rains burning destruction on all."},{"spoiler":false,"text":"She's extremely interested in pre-Cataclysm novels, comics and movies and is secretly gathering a collection on the side."}],"source":"vndb","sourceCharacterId":"c87653"},{"segments":[{"spoiler":false,"text":"常に冷静かつ理性的な、知的美女"},{"spoiler":false,"text":"小型拳銃型のアーマメントを常に携行しているが、能力を解放することでアーマメントが複数の砲塔を持つ重火器に変化、全てを焼き払う"},{"spoiler":false,"text":"破局以前の小説やコミック、映画などに強い興味を持っており、ひそかにそれらを蒐集している。"}],"source":"egs","sourceCharacterId":"22101","sourceWorkId":"29039","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/845aef1fd902579580b1c59287897984ed01aaa523b1c0d2870b8d5a359a2ec2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b030aa30bf5a9e09378692e42d1403e9dd3b87c0970084bfc67aa3061557383.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:297023:150483:6469:1","source":"bangumi"}]},{"characterId":"char_c87654","characterName":"リオ","sourceIds":{"bangumi":[{"characterId":"150485","match":"exact-normalized-name-in-linked-work","subjectId":"297023"}],"egsCharacterIds":["22100"],"vndbCharacterId":"c87654"},"originalCharacterName":"リオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"co