{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8772","model":{"presentationWorkId":"vndb:v2953","staff":{"artwork":[{"creditedName":"相川亜利砂(あいかわ亜利砂)","creatorId":"vndb:s2040","sourcePersonId":"egs:creator:142","canonicalEntityId":"vndb:s2040","name":"相川亜利砂(あいかわ亜利砂)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22419","source":"egs"}],"scenario":[{"creditedName":"三宅蒼色(蒼色)","creatorId":"vndb:s1519","sourcePersonId":"egs:creator:151","canonicalEntityId":"vndb:s1519","name":"三宅蒼色(蒼色)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22420","source":"egs"}],"music":[{"creditedName":"Funczion SOUNDS","creatorId":"vndb:s1071","sourcePersonId":"egs:creator:2566","canonicalEntityId":"vndb:s1071","name":"Funczion SOUNDS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22421","source":"egs"}],"other":[{"creditedName":"長岡建蔵(美駒)","creatorId":"egs:creator:58","sourcePersonId":"egs:creator:58","canonicalEntityId":"egs:creator:58","name":"長岡建蔵(美駒)","detail":"ロゴ・パッケージデザイン","roleCode":"other","roleLabel":"其他","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:175522","source":"egs"},{"creditedName":"菱野優希(JamJamHouse)","creatorId":"vndb:s2791","sourcePersonId":"egs:creator:14589","canonicalEntityId":"vndb:s2791","name":"菱野優希(JamJamHouse)","detail":"ブランドロゴムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84968","source":"egs"},{"creditedName":"長岡 建蔵","creatorId":"vndb:s404","sourcePersonId":"vndb:s404","canonicalEntityId":"vndb:s404","name":"長岡 建蔵","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39232","source":"vndb"}]},"cast":[{"characterId":"char_c27257","characterName":"成羽 菫","sourceIds":{"bangumi":[{"characterId":"94843","match":"exact-normalized-name-in-linked-work","subjectId":"114016"},{"characterId":"94843","match":"exact-normalized-name-in-linked-work","subjectId":"148412"},{"characterId":"94843","match":"exact-normalized-name-in-linked-work","subjectId":"148414"}],"egsCharacterIds":["13873"],"vndbCharacterId":"c27257"},"originalCharacterName":"成羽 菫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"薊学園三年生で、主人公達の先輩。"},{"spoiler":false,"text":"綺麗だけど、妙な噂が絶えない人。"},{"spoiler":false,"text":"妙な噂とは、部の女子全員を喰ったとかっていうレズな噂を聞いたかと思えば、"},{"spoiler":false,"text":"後輩の男子を摘んでいる等々。"},{"spoiler":false,"text":"そんな艶聞の噂を断固として否定しない意志の強い人物。"},{"spoiler":false,"text":"アロマストラップなる『香油入れ』を常に持ち歩いている。"},{"spoiler":false,"text":"（中身は人を貶めるための睡眠薬だとか媚薬だという噂）"},{"spoiler":false,"text":"登場する女性キャラのなかで、一番大人のキャラ。"},{"spoiler":false,"text":"とかく性に対しては子供のように無邪気という困った人。"},{"spoiler":false,"text":"普段のおっとりした感じからは想像も出来ない"},{"spoiler":false,"text":"ラリー・キングも びっくり官能ハードトークには定評がある。"},{"spoiler":false,"text":"主人公の事を密かに（本人はそう思って）狙っている。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"3181","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園三年生。"},{"spoiler":false,"text":"アンニュイな感じの美少女。"},{"spoiler":false,"text":"しかし、水泳部の女子たちとレズ関係にあるとか、後輩の男子を摘み食いしているとか、妙な噂が絶えない。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"3687","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園三年生。心療クラブ代表。"},{"spoiler":false,"text":"学生らしからぬセクシーさとフェロモンを振りまく女性。"},{"spoiler":false,"text":"セックスについても奔放で、気に入れば男、女関係なく、誰とでも寝る。"},{"spoiler":false,"text":"男を手玉にとって、相手の恥ずかしがる姿を見ることに興奮を覚える。"},{"spoiler":false,"text":"うぶな一年生はクラブの新入生の女の子たちを摘み食いしている彼女は、英田柾や神目楓も狙っているらしいが……。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"6136","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園一年生。"},{"spoiler":false,"text":"家は資産家、門限は夕方という生粋のお嬢様。"},{"spoiler":false,"text":"世間知らずを認めており、親離れをするため、一人暮らしをはじめ薊学園に通っている。"},{"spoiler":false,"text":"早島つばきとは幼馴染みで親友。"},{"spoiler":false,"text":"趣味はアロマセラピー。"},{"spoiler":false,"text":"つばきの側にいる男子が気になるが、友情を気にして言い出せずにいる。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"13025","spoiler":false},{"segments":[{"spoiler":false,"text":"私立薊学園3年。セクシーな外見とエロい心を持つ。"},{"spoiler":false,"text":"決め台詞は「お姉さん変態だから」。"},{"spoiler":false,"text":"男を手玉に取り、相手が恥ずかしがるのが何より興奮するという特殊な性癖。"},{"spoiler":false,"text":"心療クラブという怪しげなサークルの権力者。"}],"source":"bangumi","sourceCharacterId":"94843"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/535e2c2accc1304399288de114e578633ce34c450598605088ef761735bba10e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e11e8e324636095c4a7740e75e87e522f877710add7e2a540ee1612854b7f66c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285910:94843:15954:1","source":"bangumi"}]},{"characterId":"char_c8279","characterName":"美甘 櫻","sourceIds":{"bangumi":[{"characterId":"94844","match":"exact-normalized-name-in-linked-work","subjectId":"213278"}],"egsCharacterIds":["22727"],"vndbCharacterId":"c8279"},"originalCharacterName":"美甘 櫻","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく前向きな水泳部女子。"},{"spoiler":false,"text":"外見はボーイッシュな女の子だけど、中身はしっかり女の子している。"},{"spoiler":false,"text":"がんばり屋さんな性格もあって、水泳はなかなかの実力。"},{"spoiler":false,"text":"でも本番ではいつも巧く行かず、プレッシャーに弱い一面も。妄想癖アリ。"},{"spoiler":false,"text":"憧れの先輩とのファンタスティックドラマを 年がら年中、高速再生中。"},{"spoiler":false,"text":"物事をいい方に捕らえようとして失敗するタイプ。"},{"spoiler":false,"text":"そのせいで空回りすることもあるけど、それでも前向きに頑張る女の子。"},{"spoiler":false,"text":"水泳部だけあって引き締まった体に、 ばいーんとアンバランスな大きな胸。"},{"spoiler":false,"text":"膨らみっぱなしの胸に、密かに危機感を抱いていたりする。"},{"spoiler":false,"text":"自分以外の評価は非常に高いが、本人は気付かない。"}],"source":"egs","sourceCharacterId":"22727","sourceWorkId":"3181","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園の体育教師兼水泳部顧問。"},{"spoiler":false,"text":"三十路ながらも、童顔で年齢よりも若く見える。"},{"spoiler":false,"text":"そのため親しみやすいのか、、生徒たちからも友達感覚で話しかけられる。"},{"spoiler":false,"text":"見事な巨乳が彼女のトレードマーク（？）。"}],"source":"egs","sourceCharacterId":"22727","sourceWorkId":"3687","spoiler":false},{"segments":[{"spoiler":false,"text":"私立坂ノ下学園教師"},{"spoiler":false,"text":"水泳部顧問"},{"spoiler":false,"text":"担当教科：英語"},{"spoiler":false,"text":"教師歴5年"},{"spoiler":false,"text":"明るく頼りになる。"},{"spoiler":false,"text":"異性からはもちろん、同性からも人気の高い教師の見本のような人。"},{"spoiler":false,"text":"稲穂や沙月も、櫻にあこがれて教師を目指している。"},{"spoiler":false,"text":"以前よりも、お姉さん的色気を兼ね備えた。"}],"source":"egs","sourceCharacterId":"22727","sourceWorkId":"7395","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく前向きな女の子。夢見る少女ちゃんっぽい雰囲気がある。"},{"spoiler":false,"text":"つまり、まだまだ思考は中学生あがりのお子ちゃま。"},{"spoiler":false,"text":"しかし膨らみっぱなしの胸に密かに危機感を覚えている。"}],"source":"bangumi","sourceCharacterId":"94844"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68326b18b0affef62c25eee4c51ac0a065824af3c833657223d4ba402f8e8ac1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7031638e4c90eaabcb59fb8ab5d647d7407897cc85bcff77030e88f752d8b28.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜庭わかな","creatorId":"vndb:s807","sourcePersonId":"vndb:s807","canonicalEntityId":"vndb:s807","name":"桜庭 わかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285910:94844:11261:1","source":"bangumi"}]},{"characterId":"char_c8282","characterName":"建部 稲穂","sourceIds":{"bangumi":[{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"148413"},{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"148415"},{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"213278"}],"egsCharacterIds":["22726"],"vndbCharacterId":"c8282"},"originalCharacterName":"建部 稲穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教育実習生。"},{"spoiler":false,"text":"ショートカットで清潔感溢れる美人。"},{"spoiler":false,"text":"まだ学生であるためか、その服装は教師らしくなく、際どい格好が目立つ。"},{"spoiler":false,"text":"そのため、学園の男子たちの熱い視線を集めている。"},{"spoiler":false,"text":"情熱的な性格だが、それが災いして事件に巻き込まれていく。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"4901","spoiler":false},{"segments":[{"spoiler":false,"text":"私立坂ノ下学園教育実習生"},{"spoiler":false,"text":"同学園の卒業生"},{"spoiler":false,"text":"大学四回生"},{"spoiler":false,"text":"担当教科：英語"},{"spoiler":false,"text":"正義感が強く、元気で活発。面倒見も良い。"},{"spoiler":false,"text":"明るい性格で、過ぎたことはクヨクヨと悩まない。"},{"spoiler":false,"text":"一本気で純粋だが、頑固というわけでもない。"},{"spoiler":false,"text":"周りに気を遣うことも忘れないが、"},{"spoiler":false,"text":"その態度から内面を察することができるほど、顔に感情が出る。"},{"spoiler":false,"text":"スレンダーな体型で、学生時代は陸上部でハードル選手として活躍していた。"},{"spoiler":false,"text":"かつての恩師である美甘櫻に憧れて教師を目指す。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"7395","spoiler":false},{"segments":[{"spoiler":false,"text":"私立薊学園新米教師・新聞部顧問。"},{"spoiler":false,"text":"「青春」と「愛」が口癖の新任教師。"},{"spoiler":false,"text":"顧問のいなかった新聞部の顧問をしている。"},{"spoiler":false,"text":"日々大人社会でストレスに苛まれながらも問題児達を温かく見守っているつもり。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"7850","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園を数年前に卒業した、教育実習生。"},{"spoiler":false,"text":"まだまだ学生気分が抜けておらず、"},{"spoiler":false,"text":"先生と生徒というより、友達感覚で接してくれる人間を好む。"},{"spoiler":false,"text":"教師になる理由をいまだ見つけられず、"},{"spoiler":false,"text":"口癖である「愛」について深く考える一面もあるが、"},{"spoiler":false,"text":"基本的には底抜けに明るくノリがいいおねーさん。"},{"spoiler":false,"text":"自分の将来について悩みつつ、"},{"spoiler":false,"text":"同年代の少年少女からそのヒントを貰うために日々努力している。"},{"spoiler":false,"text":"学校に短めのスカートを履いてくるなど、"},{"spoiler":false,"text":"無防備なところもあるが、貞操観念はしっかりしている。"},{"spoiler":false,"text":"スタイルはいい方。胸の大きさは普通。"},{"spoiler":false,"text":"真面目な人だけど、周囲に合わせて明るくなったり暗くなったり。"},{"spoiler":false,"text":"臨機応変になんにでも接する事ができる。"},{"spoiler":false,"text":"教師に向いているが、本人はそれに気付いていない。"}],"source":"bangumi","sourceCharacterId":"94848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa94e9635329b6f255f354adb17f4a4a34f3e7ffa9a2515ddb94d413bc3b9131.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91bd71f1216f0bf496232ba7fd02136c428d3439da290d29942ae9e98fbc0d24.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":