rce-native","relationId":"vndb:vn-staff:8791","source":"vndb"},{"creditedName":"梺乃屋","creatorId":"vndb:s7332","sourcePersonId":"vndb:s7332","canonicalEntityId":"vndb:s7332","name":"梺乃 みこと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8792","source":"vndb"}]},"cast":[{"characterId":"char_c117861","characterName":"倭 真空","sourceIds":{"bangumi":[{"characterId":"138047","match":"exact-normalized-name-in-linked-work","subjectId":"219231"}],"egsCharacterIds":["25760"],"vndbCharacterId":"c117861"},"originalCharacterName":"倭 真空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"倭一族の「武」を司る家柄の後継ぎ。"},{"spoiler":false,"text":"そのため、剣や気を使った武勇に優れ、世界屈指の格闘少女と称される。"},{"spoiler":false,"text":"またその身体能力を活かし、舞や能などの舞踏にも優れた才能を見せる。"},{"spoiler":false,"text":"明朗快活だが、超が付くほど気が強く、ここ一番で素直になれない性格。"},{"spoiler":false,"text":"幼馴染の主人公を強引に引っ張っていく癖があるが、それは主人公のことを弟のように思っているから。"}],"source":"egs","sourceCharacterId":"25760","sourceWorkId":"7291","spoiler":false},{"segments":[{"spoiler":false,"text":"倭一族の『武』を取り仕切る家柄の後継ぎ。 剣の扱いや気を利用した戦闘術にも長ける格闘少女で、 舞や能などの舞踊にも長ける。"},{"spoiler":false,"text":"明るい勝気娘で、気がかなり強い。 幼馴染である主人公を強引に引っ張っていく癖があるが、 それは双子の弟のように思っているから。 ここ一番では素直になれない性格で、 普段が明るく強引な分、照れたり慌てる姿が目に付く。"},{"spoiler":false,"text":"一時期はとある理由で男性として育てられていた事もあり、 かなり女の子っぽい服装や仕草にあこがれる、ボクっ娘。"}],"source":"bangumi","sourceCharacterId":"138047"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5eaae287f13028490bcfe94531461ce735334077feb46496694382250a9c127e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/893fe7e504c78d6c8d66185ba24dc3f023f180691cff24a2cfbe101d63b19188.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219231:138047:4916:1","source":"bangumi"}]},{"characterId":"char_c117862","characterName":"倭 桔梗","sourceIds":{"bangumi":[{"characterId":"138048","match":"exact-normalized-name-in-linked-work","subjectId":"219231"}],"egsCharacterIds":["25761"],"vndbCharacterId":"c117862"},"originalCharacterName":"倭 桔梗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界規模のトップ企業「ヤマトグループ」のお嬢様。"},{"spoiler":false,"text":"傲慢な態度をとるほどでもないが、基本的にプライドが高く、他人と素直に接することが出来ない。本当の自分を見せたいと思っているが、なかなかそれが出来ず、ジレンマを感じている。"},{"spoiler":false,"text":"根は優しく、寂しがり屋で、照れ屋。"},{"spoiler":false,"text":"またマッドサイエンティストであり、色々と発明しているようだ。"}],"source":"egs","sourceCharacterId":"25761","sourceWorkId":"7291","spoiler":false},{"segments":[{"spoiler":false,"text":"「ゆりかごから棺おけまで」・「国家建設から戦争兵器まで」という、 世界規模のトップ企業の『ヤマトグループ』のお嬢様。"},{"spoiler":false,"text":"高飛車にしか主人公に接する事ができない女の子だが、 プライドが傲慢なほど高いわけではなく、 極度の寂しがり屋にして、極度の照れ屋。"},{"spoiler":false,"text":"自分の素直じゃない性格を自覚してはいない。 でも、『本当の自分』を見せたい気持ちは強く、 無意識のジレンマはストレスになっている。 それを発明で発散するマッドサイエンティスト。 ちなみに、いつも側に千歳という助手兼メイドさんが控えている。"}],"source":"bangumi","sourceCharacterId":"138048"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4127e2afcea1e926f80023f6c34fe2723cbf73b787099a8dc20d95016e14616b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db164a07e3a9201bf078528eb2355a6e38095c5320e3954b53b7e0c6ef8eefcf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219231:138048:4809:1","source":"bangumi"}]},{"characterId":"char_c117863","characterName":"倭 瑠璃","sourceIds":{"bangumi":[{"characterId":"138049","match":"exact-normalized-name-in-linked-work","subjectId":"219231"}],"egsCharacterIds":["25762"],"vndbCharacterId":"c117863"},"originalCharacterName":"倭 瑠璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"倭一族本家の正当な後継者。萌黄の姉。"},{"spoiler":false,"text":"おっとりしていて天然気味だが、文武両道の才媛。"},{"spoiler":false,"text":"基本的には「優しいお姉さん」といった感じの女性。"},{"spoiler":false,"text":"いざというときになると、卑弥呼様モードなる絶対的なカリスマを発動させ、何事もテキパキ解決してしまう。"},{"spoiler":false,"text":"先祖の卑弥呼様の魂が、常に傍にいて、彼女を守護している。"}],"source":"egs","sourceCharacterId":"25762","sourceWorkId":"7291","spoiler":false},{"segments":[{"spoiler":false,"text":"倭一族・本家の正当な後継者で、文武両道の才媛。 おっとり＆天然だが、いざという時はビシッと決める性格。 人格は変わらないが、卑弥呼様モードと呼ばれる 凛々しい王女様モードになって、そのカリスマで何でも解決してしまう。"},{"spoiler":false,"text":"ただし、普段は反動でおっとり天然。 大人びている所は変わらず、『優しい隣のお姉さん』といった感じ。 先祖の卑弥呼様の魂がいつも側にいて、瑠璃を守護している。 なので、特技は霊使役。"},{"spoiler":false,"text":"天凛学園では、学園の象徴である凛とした生徒会長。 寮では、皆をまとめる『隣のお姉さん的』寮母さんで、 瑠璃は全学園生達のお姉さんでもある。"}],"source":"bangumi","sourceCharacterId":"138049"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d89507d0120728be361290474b7f278c249ccbaad5d0dbf90f346cdd5ad5325e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1f9246cf01be4c8247406c9930309069d00336f8815bae04736866fb9bfc5ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219231:138049:4675:1","source":"bangumi"}]},{"characterId":"char_c117864","characterName":"倭 萌黄","sourceIds":{"bangumi":[{"characterId":"138050","match":"exact-normalized-name-in-linked-work","subjectId":"219231"}],"egsCharacterIds":["25763"],"vndbCharacterId":"c117864"},"originalCharacterName":"倭 萌黄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"倭一族本家の次女。"},{"spoiler":false,"text":"引っ込み思案で気弱な甘えん坊な女の子。"},{"spoiler":false,"text":"しかし、精神が不安定になると、たちまち狼モードに豹変し、超人的な力を発揮するようになり、性格もまた、普段とは正反対に強気で、思い込んだら一直線の猪突猛進タイプになる。"},{"spoiler":false,"text":"異様な外見と、能力から一族から忌み嫌われ、分家である主人公の一家に引き取られ、兄妹のように一緒に暮らしていた。"},{"spoiler":false,"text":"優しくしてくれた主人公のことが大好きで、ベッタリ懐いている。"}],"source":"egs","sourceCharacterId":"25763","sourceWorkId":"7291","spoiler":false},{"segments":[{"spoiler":false,"text":"一族本家の次女で、神の力を宿した霊媒少女。 普段はちょっと気弱で甘えん坊な子犬属性だが、 怒って精神が不安定になると耳が立ち、 ツリ目の狼モードになって超人的な力を発揮する。"},{"spoiler":false,"text":"性格も強気で、思い込んだら一直線、 恋する乙女は本気で命がけといった感じになる。 狼モードになる時は、いつも主人公を取られそうになった時で、 主人公への淡い想いに全身全霊をかけている一途な子。"},{"spoiler":false,"text":"外見と能力のせいで一族から追い出され、 分家である主人公の一家に引き取られた。 耳や尻尾の事がずっとトラウマで、他人には消極的。 でも、主人公にだけは小さな我がままを言うし、 主人公にはべったりと張り付く、甘えん坊な犬耳娘。"}],"source":"bangumi","sourceCharacterId":"138050"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63af8a2044496ec4ada595eaf6b0ca4d6ac082d6a148e9d70aa3892d1423f8bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/202f071a92a76c4fb8c91b2453c16e4b0434a1f4388144f6926e14262ecc84fc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219231:138050:6106:1","source":"bangumi"}]},{"characterId":"char_c117865","characterName":"高御 千歳","sourceIds":{"bangumi":[{"characterId":"138051","match":"exact-normalized-name-in-linked-work","subjectId":"219231"}],"egsCharacterIds":["25764"],"vndbCharacterId":"c117865"},"originalCharacterName":"高御 千歳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"代々倭一族の側近を務める高御家出身の女性。"},{"spoiler":false,"text":"蘇芳の姉で、桔梗付きのメイド。年齢不詳。"},{"spoiler":false,"text":"柔らかな物腰で、常に笑顔を絶やさないが、その笑顔の裏にはトラブルやお祭り好きの本性が隠されており、コンテスト参加の女の子たちの対立を煽ったり、何か騒ぎを大きくするなど、悪戯好き。"},{"spoiler":false,"text":"ちなみに弟・蘇芳を女装させて、からかうのが趣味。"}],"source":"egs","sourceCharacterId":"25764","sourceWorkId":"7291","spoiler":false},{"segments":[{"spoiler":false,"text":"倭一族の側近を務め、一族の外と中を取り持つ高御家の一員。元々は菖蒲付きのメイドだったが、桔梗が生まれた時に菖蒲が桔梗の世話係りとして仕えるように命じた。その頃から外見はなぜか一切変わっていない。"},{"spoiler":false,"text":"ぱっと見はおしとやかそうな少女だが、決して絶やさないその笑顔の裏にはお祭り好きの裏の顔が潜んでいる。わざと主人公のピンチを作って見せ場を作ったり、ヒロインたちの対立を煽って騒ぎを大きくしたりと、その行為を楽しむある意味とても怖い人。"},{"spoiler":false,"text":"菖蒲を抜かせば学園内で一番大人な人間。主人公やヒロイン達を、時には焚き付けて前に進ませたり、時にはたしなめる事で自分の心に気付かせたりと、本当の意味で見届け人の役割を果たしている。"},{"spoiler":false,"text":"ちなみに蘇芳を女装させてからかうのが趣味。"}],"source":"bangumi","sourceCharacterId":"138051"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d736419aea61bf88726771ff8b786f4e0c0e19ee83f0b93694f969cda638ebb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0330b062625118a12b569bdc1b5998c7a806f3966d6b1b69566366846e2d2655.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219231:138051:5890:1","source":"bangumi"}]},{"characterId":"char_c117866","characterName":"高御 蘇枋","sourceIds":{"bangumi":[{"characterId":"138052","match":"exact-normalized-name-in-linked-work","subjectId":"219231"}],"egsCharacterIds":["25765"],"vndbCharacterId":"c117866"},"originalCharacterName":"高御 蘇枋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"代々倭一族の側近を務める高御家出身の少年。"},{"spoiler":false,"text":"姉・千歳と違い、穏やかな性格で、腰も低く、やや気弱だが仕事ぶりは優秀。"},{"spoiler":false,"text":"主人公の付き人に任命され、一緒に過ごすようになるが、その主人公のまっすぐ強く生きていこうとする姿に感銘を受け、憧れを抱くようになっていく。"},{"spoiler":false,"text":"外見が中世的であることから、よく姉に女性に服を着せられ、からかわれている。"}],"source":"egs","sourceCharacterId":"25765","sourceWorkId":"7291","spoiler":false},{"segments":[{"spoiler":false,"text":"千歳と同じく倭一族に奉仕するように教え込まれて育った少年。"},{"spoiler":false,"text":"性格は千歳と違い、腰が低くて棘もなく、少し気弱だが有能な 秘書といった感じ。だが自分というものを持っていないのではなく、一族に奉仕する事に意義を感じている。"},{"spoiler":false,"text":"最初は倭一族に仕える身であるということで主人公と出会うが、共に過ごすうちに主人公の強くなろうとするまっすぐな心と、実際に強くなっていく姿にあこがれを抱くようになる。同じ歳という事もあってだんだんと一族の壁を越えて仲良くなっていった。主人公とは主従を超えた親友同士。"},{"spoiler":false,"text":"穏やかでのんびりやな性格で、主人公と同じで押しが弱い。 外見は細身の女顔で、主人公が背が低くてからかわれるように、顔の事でからかわれてしまう。"}],"source":"bangumi","sourceCharacterId":"138052"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b7b2a4c633f32ca61c05a81514e7dd7c3a98258201fed4a7a1f34e60f056249.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2aa900ecd4d1902ac93018c62f449773b22d633d1cf065492673d848ee9bdf1b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"すずき けいこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219231:138052:6275:1","source":"bangumi"}]},{"characterId":"char_c117867","characterName":"エクルー","sourceIds":{"bangumi":[{"characterId":"138053","match":"exact-normalized-name-in-linked-work","subjectId":"219231"}],"egsCharacterIds":["25766"],"vndbCharacterId":"c117867"},"originalCharacterName":"エクルー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の守護精霊。愛称・クー。"},{"spoiler":false,"text":"嬉しければ笑い、悲しければ涙を流す、そんな素直に感情を表現する、心優しく穏やかで、何事にも一生懸命な女の子。"},{"spoiler":false,"text":"霊力の小さい主人公には見えない、常に傍におり、見守っている。"}],"source":"egs","sourceCharacterId":"25766","sourceWorkId":"7291","spoiler":false},{"segments":[{"spoiler":false,"text":"愛称・クー。何ごとにも一生懸命ながんばり屋。"},{"spoiler":false,"text":"感情表現が素直で、うれしいとにっこり笑い、悲しければ涙を流す純粋な少女。本当に穏やかな性格で、傷つける事・傷つけられる事を極度に嫌う。"},{"spoiler":false,"text":"主人公が大好きで、常に一緒に居ようとする。学校どころか、寮でも一緒の部屋に居ようとするのでヒロイン達の猛反発を受けたりする。"}],"source":"bangumi","sourceCharacterId":"138053"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e1ad29bfd1d15c7a74540ef4192033b681eaa78b9abbd6dbdf3d64400ca59ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96cd1e898ca091317c78e655e2ed821fa3ca6975e1843ac1af21f5f83cef23c6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"文月かな","creatorId":"vndb:s54","sourcePersonId":"vndb:s54","canonicalEntityId":"vndb:s54","name":"文月 かな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId"