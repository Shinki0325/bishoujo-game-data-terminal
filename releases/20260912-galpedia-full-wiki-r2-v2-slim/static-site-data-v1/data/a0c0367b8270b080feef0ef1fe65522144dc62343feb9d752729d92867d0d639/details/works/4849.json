:[{"segments":[{"spoiler":false,"text":"国語の先生。"},{"spoiler":false,"text":"少し気が弱い所があるが、明るく優しく真面目な性格で世話好き。"},{"spoiler":false,"text":"家庭的な面を持ち、料理がとても得意。"},{"spoiler":false,"text":"だが、「辛さ」方面に置いての味覚単位が一般人とは大分異なっており（つまりは激辛好き）、それがよく一同の悲鳴を呼ぶ。"},{"spoiler":false,"text":"迅とははじめは若干距離を置いているが、本当は優しい彼の性格を一番に見抜き、素直に距離を縮めてくる。"},{"spoiler":false,"text":"全員と仲良しだが、ハーリーと特に仲がいい。"}],"source":"egs","sourceCharacterId":"26872","sourceWorkId":"4849","spoiler":false},{"segments":[{"spoiler":false,"text":"国語の先生。"},{"spoiler":false,"text":"おとなしいが優しい性格で世話好き。"},{"spoiler":false,"text":"少し気が弱い所があるが明るく優しく真面目な性格で世話好き。"},{"spoiler":false,"text":"医師を目指しており、いつも薬や救急セットを持ち歩いている。"},{"spoiler":false,"text":"家庭的な面を持ち、料理がとても得意…"},{"spoiler":false,"text":"だが、「辛さ」方面に置いての味覚単位が一般人とは大分異なっており"},{"spoiler":false,"text":"（つまりは激辛好き）それがよく一同の悲鳴を呼ぶ。"},{"spoiler":false,"text":"迅とははじめは若干距離を置いているが、"},{"spoiler":false,"text":"本当は優しい迅の性格を一番に見抜き、素直に距離を縮めてくる。"},{"spoiler":false,"text":"全員と仲良しだが、ハーリーと特に仲がいい。"}],"source":"bangumi","sourceCharacterId":"137155"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f556f61658a7964dbc19f29719a803ad910066dfb167a1a07c30405aba47aa89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72854fc12393829d92cc86b02364c4662b9cd5b288a0d8a72b0b6e78ff4c0d33.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阪田佳代","creatorId":"vndb:s650","sourcePersonId":"vndb:s650","canonicalEntityId":"vndb:s650","name":"阪田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305595:137155:5133:1","source":"bangumi"}]},{"characterId":"char_c36052","characterName":"ハーリー=サラサ=バスティーユ","sourceIds":{"bangumi":[{"characterId":"137156","match":"exact-normalized-name-in-linked-work","subjectId":"305595"}],"egsCharacterIds":["26873"],"vndbCharacterId":"c36052"},"originalCharacterName":"ハーリー=サラサ=バスティーユ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"英語と数学の先生。"},{"spoiler":false,"text":"淡い金髪と青い瞳、透き通るような白い肌を持つ。"},{"spoiler":false,"text":"向こう気が強く生意気で、かわいくない性格。"},{"spoiler":false,"text":"出来の悪い迅への当たりも強く、なかなか打ち解けない。"},{"spoiler":false,"text":"が、実はなかなか素直になれないだけで、本来は優しいよいこ。"},{"spoiler":false,"text":"仲よくなると、心底素直で従順な子になる。"},{"spoiler":false,"text":"誰かといることを好まないというような事を言うが、ひとりはちょっと苦手な寂しがり屋。"},{"spoiler":false,"text":"科学者を目指しており、たまに部屋にこもって怪しい薬を作っていたりする。"}],"source":"egs","sourceCharacterId":"26873","sourceWorkId":"4849","spoiler":false},{"segments":[{"spoiler":false,"text":"淡い金髪と青い瞳、透き通るような白い肌を持つ。"},{"spoiler":false,"text":"英語と数学を教える。"},{"spoiler":false,"text":"向こう気が強く生意気で、かわいくない性格。"},{"spoiler":false,"text":"出来の悪い迅への当たりも強く、なかなか打ち解けない。"},{"spoiler":false,"text":"ミドルネームの「サラサ」を大事にしており他人には呼ばせようとしない。"},{"spoiler":false,"text":"が、なかなか素直になれないだけで、本当は優しいよいこ。"},{"spoiler":false,"text":"仲よくなると、心底素直で従順な子になる。"},{"spoiler":false,"text":"誰かといることを好まないというような事を言うが、ひとりはちょっと苦手な寂しがり屋。"},{"spoiler":false,"text":"科学者を目指しており、たまに部屋にこもって怪しい薬を作っていたりする。"}],"source":"bangumi","sourceCharacterId":"137156"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7618ee60dd8de2097cfcb0b4754b55e3598e3bb1a08a2b0efafc37110ec14a96.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22276e64e5600472123e8cfdd1056a096470df435bddd4849959d82d051adb59.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:305595:137156:5020:1","source":"bangumi"}]},