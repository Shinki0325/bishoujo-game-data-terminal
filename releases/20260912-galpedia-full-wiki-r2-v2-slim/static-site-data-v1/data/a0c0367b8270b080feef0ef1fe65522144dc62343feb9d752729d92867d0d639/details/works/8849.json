。"},{"spoiler":false,"text":"ただし、平民に対しては、堅いなりに上からものを言う口調になってしまう。そのため、真意や思いやりが相手に伝わりにくく、損をすることも。"}],"source":"egs","sourceCharacterId":"25002","sourceWorkId":"8332","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbdac40151fe5fb4538b54e2ad2d407376e62a2c16bbbd66f1dbff606ae10a52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6228ed3cbec6661441b196920da9da87ecfde940cdfeafed85dd50039db3a760.webp","width":220,"height":204,"source":"static-detail"},"actors":[{"creditedName":"有賀桃","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33399","source":"vndb"}]},{"characterId":"char_vndb_c89503","characterName":"アリシア","sourceIds":{"vndbCharacterId":"c89503"},"originalCharacterName":"アリシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbce79df7bf156166bfc274a86a282c4fd5e1ca6d2a658c23ae2aa93bfa173ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/072601ed397f484a8bf75c8d727e4fa8b4b4a3f550e14ed8ca427be067594051.webp","width":220,"height":200,"source":"static-detail"},"actors":[{"creditedName":"榎津 まお","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33396","source":"vndb"}]},{"characterId":"char_vndb_c89505","characterName":"フェーベ","sourceIds":{"vndbCharacterId":"c89505"},"origina