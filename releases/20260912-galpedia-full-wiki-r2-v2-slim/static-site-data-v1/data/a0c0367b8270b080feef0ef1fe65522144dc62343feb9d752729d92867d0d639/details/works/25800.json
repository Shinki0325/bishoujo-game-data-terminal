165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Species: Invisible Man"},{"spoiler":false,"text":"Good at studying and kind to everyone. In contrast to his cute appearance, he is pretty honest and has self control. But sometimes, he will reveal a gloomy look at a glance."},{"spoiler":false,"text":"\"Can I...... stay in your memories?\""},{"spoiler":false,"text":"Edited from Official site"}],"source":"vndb","sourceCharacterId":"c63572"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/151a64d819aefba847e6799e2f406c318cbb5072d62e8f20ebf3b9c33d6ed075.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8eb3c3ea71cb9f026311d630e50c7084f1d5a0a1b934191ad659e66a0633e7ed.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 瞬","creatorId":"vndb:s10306","sourcePersonId":"vndb:s10306","canonicalEntityId":"vndb:s10306","name":"堀江 瞬","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68748","source":"vndb"}]},{"characterId":"char_vndb_c63573","characterName":"レイ","sourceIds":{"vndbCharacterId":"c63573"},"originalCharacterName":"レイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"424"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ray is a pure-blood vampire from a distinguished family and is the 2nd highest-ranked species in the hierarchy (after mermaids). However, as there are currently no mermaids in attendance at the school, he considers himself to be the most important person at school and has the fan club to prove it. He is good at pretty much everything and is super arrogant about it but has a mean sense of humour and likes to make jokes out of other characters, particularly Shiba. As with all vampires, he loves “beautiful things” and so takes a keen interest in Chloe."},{"spoiler":false,"text":"From Zettai Renai"}],"source":"vndb","sourceCharacterId":"c63573"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/faddc92e18e3767907df2713935b153bdb8577464a2a5d913d4e0e05cb9cc9ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6863e3e85f7f5274b117ed826c41a5b44eb0abf2c4d6ede137475d3d124940f.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"興津 和幸","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68746","source":"vndb"}]},{"characterId":"char_vndb_c63574","characterName":"ナツメ","sourceIds":{"vndbCharacterId":"c63574"},"originalCharacterName":"ナツメ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"915"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Natsume is a mummy and is the most mysterious person Chloe meets. He is very cold and tends to fight easily with others. He has a tendency to either sleep through class or skip it completely, preferring to spend his time in the disused 3rd Music Room playing the piano and singing. He has a cruel sense of humour but maybe there’s more to him under those bandages?"},{"spoiler":false,"text":"From Zettai Renai"}],"source":"vndb","sourceCharacterId":"c63574"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91275394408bc098dda1df10ad7250bd27953a75f82bdbcab70a2cc0c88611fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce66e27854c93860c48b8295c914f464c183b7754997b636f97bb17610255a14.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊永 利行","creatorId":"vndb:s3247","sourcePersonId":"vndb:s3247","canonicalEntityId":"vndb:s3247","name":"豊永 利行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68747","source":"vndb"}]},{"characterId":"char_vndb_c88851","characterName":"エリカ","sourceIds":{"vndbCharacterId":"c88851"},"originalCharacterName":"エリカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Species: Demon"},{"spoiler":false,"text":"The protagonist's friend."},{"spoiler":false,"text":"She loves cute girls."},{"spoiler":false,"text":"She hates to lose and is always fighting with Shiba."}],"source":"vndb","sourceCharacterId":"c88851"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acbf73bc1f3b926020a48fe2195783d50e0feb3e86a55629e1efe19351cacac3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce2d8da02abfa4087dde5889ab31dc5185981fb685be27876dd9f97312635a9f.webp","width":256,"height":252,"source":"static-detail"},"actors":[{"creditedName":"長谷川 育美","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","