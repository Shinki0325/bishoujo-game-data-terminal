,"name":"CUBE(株式会社キューブ)","detail":"音声収録・キャスティング","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:221559","source":"egs"},{"creditedName":"鳩崎亜紋","creatorId":"egs:creator:22207","sourcePersonId":"egs:creator:22207","canonicalEntityId":"egs:creator:22207","name":"鳩崎亜紋","detail":"インターフェイスデザイン","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:221560","source":"egs"},{"creditedName":"株式会社クリープ(cre-p)","creatorId":"vndb:s18796","sourcePersonId":"egs:creator:27621","canonicalEntityId":"vndb:s18796","name":"株式会社クリープ(cre-p)","detail":"背景","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:221561","source":"egs"},{"creditedName":"EorX","creatorId":"vndb:s12344","sourcePersonId":"egs:creator:23401","canonicalEntityId":"vndb:s12344","name":"EorX","detail":"CG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:221562","source":"egs"},{"creditedName":"笠島友貴","creatorId":"egs:creator:35670","sourcePersonId":"egs:creator:35670","canonicalEntityId":"egs:creator:35670","name":"笠島友貴","detail":"CG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:221705","source":"egs"},{"creditedName":"David Evelyn","creatorId":"vndb:s27805","sourcePersonId":"vndb:s27805","canonicalEntityId":"vndb:s27805","name":"David Evelyn","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:154464","source":"vndb"},{"creditedName":"eco*","creatorId":"vndb:s1781","sourcePersonId":"vndb:s1781","canonicalEntityId":"vndb:s1781","name":"eco*","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154466","source":"vndb"},{"creditedName":"ほっしー","creatorId":"vndb:s2082","sourcePersonId":"vndb:s2082","canonicalEntityId":"vndb:s2082","name":"ほっしー","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:154467","source":"vndb"},{"creditedName":"ほっしー","creatorId":"vndb:s2082","sourcePersonId":"vndb:s2082","canonicalEntityId":"vndb:s2082","name":"ほっしー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154468","source":"vndb"},{"creditedName":"薬師 るり","creatorId":"vndb:s2361","sourcePersonId":"vndb:s2361","canonicalEntityId":"vndb:s2361","name":"薬師 るり","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:154470","source":"vndb"},{"creditedName":"薬師 るり","creatorId":"vndb:s2361","sourcePersonId":"vndb:s2361","canonicalEntityId":"vndb:s2361","name":"薬師 るり","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154471","source":"vndb"},{"creditedName":"癸 乙夜","creatorId":"vndb:s2829","sourcePersonId":"vndb:s2829","canonicalEntityId":"vndb:s2829","name":"癸乙夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154472","source":"vndb"},{"creditedName":"アラガー","creatorId":"vndb:s4578","sourcePersonId":"vndb:s4578","canonicalEntityId":"vndb:s4578","name":"アラガー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154475","source":"vndb"}]},"cast":[{"characterId":"char_c55100","characterName":"風魔 ゆら","sourceIds":{"bangumi":[{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["13251"],"vndbCharacterId":"c55100"},"originalCharacterName":"風魔 ゆら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I, Fuuma Yura, in accordance to the contract hereby swear, to serve you, Lord Haruki!\""},{"spoiler":false,"text":"The elder of the Fuuma sisters. A demi cat."},{"spoiler":false,"text":"She walks the path of shinobi and swears loyalty to our hero. But she is absent minded and often foolish."},{"spoiler":false,"text":"An optimistic girl who doesn 't let failure and hardship put her down."},{"spoiler":false,"text":"Her weaknesses are her tail and headpats."},{"spoiler":false,"text":"Though she enjoys showing her master how capable she is, she is unable to resist a good coddling."},{"spoiler":false,"text":"A self-proclaimed martial master."},{"spoiler":false,"text":"Terrible at ninjutsu."},{"spoiler":false,"text":"From Sekai Project"}],"source":"vndb","sourceCharacterId":"c55100"},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた忍び姉妹の姉。"},{"spoiler":false,"text":"猫の亜人。"},{"spoiler":false,"text":"忍道を尊び、主人公に忠誠を誓っているが、天然で隙も多い。"},{"spoiler":false,"text":"失敗してもめげない、若干はた迷惑な前向きキャラ。"},{"spoiler":false,"text":"弱点は尻尾とナデナデ。"},{"spoiler":false,"text":"毅然としたところを見せて主様に褒めていただきたいと思いながらも、徹底できない甘えっ子。"},{"spoiler":false,"text":"自称・体術タイプの忍者で忍法は苦手。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に仕えている猫耳忍者。"},{"spoiler":false,"text":"年こそ若いがれっきとした風魔の上忍で、無類の頑張り屋さん（全て自称）。"},{"spoiler":false,"text":"押しかけ女房的に、現在は主人公の家で暮らしている。"},{"spoiler":false,"text":"主人公の忍びであることに誇りを感じていて、お役に立ちたくて仕方ない。"},{"spoiler":false,"text":"身辺警護的な意味でも主人公の傍を片時も離れたくないし、自慢の可愛さで癒やして差し上げたい。"},{"spoiler":false,"text":"要するに天下無双の甘えんぼ。"},{"spoiler":false,"text":"主人公がマヤを構う様子には忸怩たるものを感じているようで……？"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"体感的にはだいぶ前に主人公の元にやってきた風魔の猫耳忍者。"},{"spoiler":false,"text":"共通の障壁や困難はお互いの愛をますます堅固なものにする的なあれで、鋼鉄の忠誠心にも磨きがかかってきた（自称）。"},{"spoiler":false,"text":"一方で、里見勢とは相変わらずケンカばかり。"},{"spoiler":false,"text":"主人公への愛やご寵愛に関しては、誰にも譲れないのは相変わらず。"},{"spoiler":false,"text":"陽葵たちへの態度は、今のところ決めかねている様子。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた、猫忍姉妹のパワー担当。"},{"spoiler":false,"text":"馬鹿力と大雑把な性格は健在。"},{"spoiler":false,"text":"初めて北条家を訪れたあの日から、はや数年。"},{"spoiler":false,"text":"優しい主の元、平和な日々を謳歌している。"},{"spoiler":false,"text":"いまいち忍びとして働き場がないことについては、あまり考えないことにした模様。とはいえ、雑賀の動乱は気になるようで、「あるいはハルキ殿の天下の予感？」的な妄想したりしている。"},{"spoiler":false,"text":"相変わらずずっと、ハルキ殿のことが大好き。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"「在下風魔由良！遵從約定自今天起，為春希殿下獻上我的忠誠！」"},{"spoiler":false,"text":"來自風魔之里的忍者姊妹中的姊姊。貓咪型亞人。"},{"spoiler":false,"text":"推崇忍道，雖然對主人宣誓效忠，但是個性天然而渾身空隙。"},{"spoiler":false,"text":"遭遇失敗也不屈不撓，是個會稍微對週圍的人帶來困擾的樂觀角色。"},{"spoiler":false,"text":"弱點是尾巴還有摸摸。"},{"spoiler":false,"text":"雖然總是想著要讓主人看看自己的信念讓他誇獎，"},{"spoiler":false,"text":"但總是無法貫徹到底，是愛撒嬌的孩子。"},{"spoiler":false,"text":"自稱是擅長體術類型的忍者，對忍術不拿手。"}],"source":"bangumi","sourceCharacterId":"49095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae199390257854c04f3a65dd3f3e803596a9fd69ea57a27717d16b9c116b4f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/4672b4a46d6cf8ad1eb10c77a3e8f014bafebbcee701f8d1d3d47d02ef34c7c6.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269282:49095:7302:1","source":"bangumi"}]},{"characterId":"char_c55101","characterName":"風魔 たま","sourceIds":{"bangumi":[{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["13252"],"vndbCharacterId":"c55101"},"originalCharacterName":"風魔 たま","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Master, aren't you going to feed us?\""},{"spoiler":false,"text":"The younger of the Fuuma Sisters. A demi cat just like her sister."},{"spoiler":false,"text":"Compared to her (supposedly) serious sister, she has her head in the clouds. She doesn't treat our"},{"spoiler":false,"text":"hero like her master, and instead treats him like her brother. She incessantly begs for coddles."},{"spoiler":false,"text":"She is a poor academic, but a master of ninjutsu."},{"spoiler":false,"text":"She is able to use a wide array of Fuuma Ninjutsu despite her young age."},{"spoiler":false,"text":"She enjoys eating fluffy food."},{"spoiler":false,"text":"Very relaxed. Enjoys basking in the sun."},{"spoiler":false,"text":"From Sekai Project"}],"source":"vndb","sourceCharacterId":"c55101"},{"segments":[{"spoiler":false,"text":"姉のゆら同様、風魔の里からやってきた忍び姉妹の妹。"},{"spoiler":false,"text":"同じく猫の亜人。"},{"spoiler":false,"text":"（表向き）生真面目な姉と比べて、ふわふわと浮世離れした性格。"},{"spoiler":false,"text":"主人公のことも一応は主と見ているものの、完全にお兄ちゃん扱いで全身全霊で甘えてくる。"},{"spoiler":false,"text":"お勉強は苦手だが、忍術は大得意。"},{"spoiler":false,"text":"この若さで大半の風魔忍法を使いこなす。"},{"spoiler":false,"text":"好きな食べ物はふわふわしたもの。"},{"spoiler":false,"text":"基本的にのんびり屋で、ひなたぼっこと昼寝が幸せ。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"姉のゆらと一緒に主人公に仕えている猫耳忍者。"},{"spoiler":false,"text":"活発な姉と比べてだいぶマイペース。"},{"spoiler":false,"text":"相変わらず主人公のことは「おにいちゃん」呼びだが、大好きぶりはますます加速していて、毎日のように主人公の背中や膝を姉と取り合いしている。"},{"spoiler":false,"text":"最近はゴロ寝テレビの術(オリジナル)を習得して、ぐーたらぶりにも磨きがかかってきた。"},{"spoiler":false,"text":"特に子供向けアニメがお気に入り。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"ゆらと一緒に、主人公の家に押しかけてきた猫耳妹。"},{"spoiler":false,"text":"こう見えて風魔の上忍で、風魔忍法の全てを修めた天才……のはずなのだが、誰よりも猫らしい性格は相変わらずで、もはやぐーたらの域。"},{"spoiler":false,"text":"それはそれで手間がかからなくていいと主人公も静観している様子。"},{"spoiler":false,"text":"とはいえ、食べることと主人公のことは別。"},{"spoiler":false,"text":"主人公に仇なす悪い人が現れたりしたら本気出す。多分。"},{"spoiler":false,"text":"特に何もなければゴロ寝テレビの術で。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた、猫忍姉妹の術担当。"},{"spoiler":false,"text":"のんびりおおらかでちゃっかりした性格は、もはやどうにもなりようがない。"},{"spoiler":false,"text":"愛され上手の子猫ちゃん。"},{"spoiler":false,"text":"姉同様、平和な日々をのんびり楽しんでいる。"},{"spoiler":false,"text":"特に何ってほどのことはしていない。"},{"spoiler":false,"text":"雑賀の動乱に対しても、姉ほどは興味がない。"},{"spoiler":false,"text":"相変わらずマイペースで、変わらすにおにいちゃんのことが大好き。"},{"spoiler":false,"text":"みんなで一緒にいられればそれで幸せ。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"「主人，不是會給我們好吃的飯嗎？」"},{"spoiler":false,"text":"和姊姊由良一樣，是來自風魔之里的忍者姊妹中的妹妹。同樣是貓咪型亞人。"},{"spoiler":false,"text":"（表面上）和非常認真的姊姊相較之下，有著飄飄然不食人間煙火的個性。"},{"spoiler":false,"text":"雖然姑且把男主角當成主人，"},{"spoiler":false,"text":"卻完全把他當做哥哥看待，全心全意地對他撒嬌。"},{"spoiler":false,"text":"雖然對學習不大拿手，但是非常擅長忍術。如此年輕就能夠使用大半風魔相傳的忍術。"},{"spoiler":false,"text":"喜歡的食物是軟綿綿的東西。"},{"spoiler":false,"text":"基本上個性很悠閒，對於在日光的照耀下睡午覺感到幸福。"}],"source":"bangumi","sourceCharacterId":"49096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04fb5bad1c084997db4687dcb48cd1fb5bf05affbc64dcc6c91f199448c9574a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/331ba241520ab676eb9fd3b22cc0244680a8655d3e2a9dd04033b13c8104bb9e.webp","width":126,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269282:49096:8580:1","source":"bangumi"}]},{"characterId":"char_c55102","characterName":"彩羽","sourceIds":{"bangumi":[{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"269282"}],"egsCharacterIds":["13253","18485"],"vndbCharacterId":"c55102"},"originalCharacterName":"彩羽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I will just return everything to normal, so just take a breath, everything will come up with a time.\""},{"spoiler":false,"text":"Protagonist's childhood friend who attends the same school as him. Doesn't have any close friends besides the protagonist, behaves cold towards the others."}],"source":"vndb","sourceCharacterId":"c55102"},{"segments":[{"spoiler":false,"text":"主人公と同じ学園に通う同級生だが、鈴木　彩は世を忍ぶ仮の姿。"},{"spoiler":false,"text":"いくつもの忍びの里を出自とする忍者によって構成されている組織において、作戦を指揮する立場にある。"},{"spoiler":false,"text":"主人公が通う学園に先月引っ越してきて、今日に至るまで周辺を調査していたようだが主人公本人は気付いていない。"},{"spoiler":false,"text":"学園ではクールキャラを通しており、親しい友人はいない。"}],"source":"egs","sourceCharacterId":"13253","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と仲間達のお目付け役的な存在。"},{"spoiler":false,"text":"風魔の里に動きがあることを察知し、主(あるじ)格である主人公の元に派遣されてきた。"},{"spoiler":false,"text":"忍び、特に抜け忍が起こす事件の警戒・対応が主な仕事と言っているが、素性はもちろん、所属している組織についてもはっきりとは語っていない。"},{"spoiler":false,"text":"相変わらずクールキャラを貫いているが、ゆらたまのわんぱくぶりに怒りマークを浮かべていることも稀によくある。"},{"spoiler":false,"text":"現在は謎の猫忍者の対応に追われている。"}],"source":"egs","sourceCharacterId":"18485","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"お目付け役も板についてきたクールビューティ。"},{"spoiler":false,"text":"主人公たちとの付き合いも長くなってきたものの、馴れ合う様子は微塵もなく、猫忍たちにニャーニャー威嚇されてもどこ吹く風。"},{"spoiler":false,"text":"所属や素性なども相変わらず謎のまま……でここまできたが、陽葵の巻き添えを食らう形で色々バレそう。"},{"spoiler":false,"text":"最近、ついに漢方系の胃腸薬に手を出した。胃を元気にしたい系女子。"}],"source":"egs","sourceCharacterId":"18485","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"「只不過是回到原本的生活唷。只要一個呼吸之間，我就能解決一切」"},{"spoiler":false,"text":"和男主角同一個學校的同年級學生，以鈴木彩這個身份當做偽裝。"},{"spoiler":false,"text":"和數名同樣是來出身自忍者之里的忍者一同組成組織，"},{"spoiler":false,"text":"並且立於指揮作戰的立場。"},{"spoiler":false,"text":"在男主角進到這所學校前一個月搬過來，"},{"spoiler":false,"text":"似乎至今為止都在調查這周邊一帶，不過男主角完全沒有察覺。"},{"spoiler":false,"text":"在學校裡頭是個帥氣的角色，沒有親暱的友人。"}],"source":"bangumi","sourceCharacterId":"49097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8b466657b40ef62654d79e6f1ca2b12c878f041384c1db0f6891f4abfaad1fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0fab56ffa2fcea14668c779c66f2d7a12080998c7332b3e1f7997a2169861e0.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269282:49097:5928:1","source":"bangumi"}]},{"characterId":"char_c55103","characterName":"なち","sourceIds":{"bangumi":[{"characterId":"49098","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49098","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49098","match":"exact-normalized-name-in-linked-work","subjectId":"269282"}],"egsCharacterIds":["13254"],"vndbCharacterId":"c55103"},"originalCharacterName":"なち","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"What will you do, then? If you have a plan you will surprise me a bit.\""},{"spoiler":false,"text":"A shinobi who serves Saiha."},{"spoiler":false,"text":"A runaway from the Fuuma clan that arbitrarily made Saiha her Master after she saved her from starving. Born as a Fuuma and originally also as Haruki's bodyguard, she has some lingering affection for him that she tries to hide."},{"spoiler":false,"text":"Treated as an Idol by the rest of the Fuuma clan for sending money to them regularly."}],"source":"vndb","sourceCharacterId":"c55103"},{"segments":[{"spoiler":false,"text":"彩羽に仕える忍び。"},{"spoiler":false,"text":"彼女に仕える忍びを総括する四天王の筆頭であり、その実力には信を置かれている様子。"},{"spoiler":false,"text":"男勝りで、がさつなところもあるが面倒見がいい一面も？"},{"spoiler":false,"text":"本人は隠しているつもりでいるが、猫ちゃん好きとして仲間には広く知られている。"},{"spoiler":false,"text":"主人公に仕える風魔の猫忍者二匹が気になる様子。"}],"source":"egs","sourceCharacterId":"13254","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"風魔の里出身の忍びで、ゆらたまの実姉でもある。"},{"spoiler":false,"text":"里の逼迫した財布事情を支えるために妹達よりひと足早く里を出たが、耳を隠してのアルバイトは思うようにいかず、行き倒れかけていたところを彩羽に拾われた。"},{"spoiler":false,"text":"恩義もあって忍びとして彩羽に臣従を誓っている身だが、本来の主であった主人公や可愛い妹達のことは気になる様子。"},{"spoiler":false,"text":"ぶっきらぼうを装いながら、家や学園にもマメに顔を出す。"}],"source":"egs","sourceCharacterId":"13254","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"（主にゆらに）彩羽の元を離れるように言われて一悶着あったが、今は里と決別する形で彩羽の元に身を寄せている。"},{"spoiler":false,"text":"妹たちも自分の決断を尊重してくれていると思っているが、そんなことはない。"},{"spoiler":false,"text":"どこの世界も姉は大変。"},{"spoiler":false,"text":"彩羽が寝てる間に足つぼマッサージをしてあげるのが最近の日課。"}],"source":"egs","sourceCharacterId":"13254","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"「該怎麼做？如果下命令的話我就稍微去吓吓他們」"},{"spoiler":false,"text":"侍奉彩羽的忍者。"},{"spoiler":false,"text":"是侍奉她的忍者中，統領眾人的四天王的首領，"},{"spoiler":false,"text":"她的實力不容質疑。"},{"spoiler":false,"text":"比男性還能幹，雖然細心過頭了，不過也有擅於照顧人的一面？"},{"spoiler":false,"text":"雖然本人想要隱藏起來，"},{"spoiler":false,"text":"不過同伴們卻都知道她喜歡小貓咪。"},{"spoiler":false,"text":"似乎相當在意侍奉著男主角的兩隻風魔的貓忍者。"}],"source":"bangumi","sourceCharacterId":"49098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42276e283de1e5bf0d5067838baddd50ef2abb205158047b436605e8aaecad08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2da484f57e567094512dd38c56d54bfeabc73991534ebef995e2f8c047048928.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269282:49098:15637:1","source":"bangumi"}]},{"characterId":"char_c66437","characterName":"猫飼 律","sourceIds":{"bangumi":[{"characterId":"59693","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"59693","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"59693","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["18483"],"vndbCharacterId":"c66437"},"originalCharacterName":"猫飼 律","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"街に出没する謎の猫忍者。"},{"spoiler":false,"text":"自らが属する組織を『里見八忍（にゃん）』と名乗っているが、詳細は謎に包まれている。"},{"spoiler":false,"text":"多彩な術を駆使する凄腕の忍者で、未だに彩羽とその一派から逃げおおせている。"},{"spoiler":false,"text":"少しがさつで、口調はにゃんにゃんしている。"},{"spoiler":false,"text":"主人公を狙って過去に接触を計ってきたこともあるという。"},{"spoiler":false,"text":"敵意はなさそうだが、一方で風魔を『敵』と断定していたりも。"},{"spoiler":false,"text":"主人公は過去のやりとりから悪い猫ではないと思っているようだが？"}],"source":"egs","sourceCharacterId":"18483","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"前回の騒動後、主人公の家の庭で暮らし始めた猫耳忍者。"},{"spoiler":false,"text":"里見八忍（にゃん）の筆頭の肩書に恥じない、真面目な頑張り屋さん。"},{"spoiler":false,"text":"その分、勢いが大事な局面ではだいたい出遅れる。"},{"spoiler":false,"text":"何かと損をする長女タイプ。"},{"spoiler":false,"text":"仲間のシノが陽葵と共に現れたことには戸惑いを隠せていない。"}],"source":"egs","sourceCharacterId":"18483","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"里見八忍筆頭、みんなの頼れるリーダー。"},{"spoiler":false,"text":"持ち前の世話焼き（あるいはおせっかい）スキルで、仲間達を支えている。"},{"spoiler":false,"text":"言い換えれば苦労性。"},{"spoiler":false,"text":"実妹であるチカとは、性格の不一致などもあって昔から衝突が絶えなかった。"},{"spoiler":false,"text":"主である北条春希は律のそういう性分を察してフォローに余念がない。"},{"spoiler":false,"text":"当然のように心優しい春希様のことが大好き。"},{"spoiler":false,"text":"万能型と称されるほど、忍法・体術・剣技などあらゆるスキルに長じている。"},{"spoiler":false,"text":"まさにリーダー、もしくは器用貧乏型勇者タイプ。"}],"source":"egs","sourceCharacterId":"18483","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"街に出没する謎の猫忍者。"},{"spoiler":false,"text":"自らが属する組織を『里見八忍（にゃん）』と名乗っているが、詳細は謎に包まれている。"},{"spoiler":false,"text":"多彩な術を駆使する凄腕の忍者で、"},{"spoiler":false,"text":"未だに彩羽とその一派から逃げおおせている。"},{"spoiler":false,"text":"少しがさつで、口調はにゃんにゃんしている。"},{"spoiler":false,"text":"主人公を狙って過去に接触を計ってきたこともあるという。"},{"spoiler":false,"text":"敵意はなさそうだが、"},{"spoiler":false,"text":"一方で風魔を『敵』と断定していたりも。"},{"spoiler":false,"text":"主人公は過去のやりとりから"},{"spoiler":false,"text":"悪い猫ではないと思っているようだが？"}],"source":"bangumi","sourceCharacterId":"59693"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba52ccdf990f390265c44c1149be164a26aa0ea920cca7d053bd624821354f8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88e52e89d40fd37322ce46806b808b05a3486d043372163b4787537d849629af.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269282:59693:17075:1","source":"bangumi"}]},{"characterId":"char_c66438","characterName":"猫山 マヤ","sourceIds":{"bangumi":[{"characterId":"59694","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"59694","match":"exact-normalized-name-in-linked-work","subjectId":"441480"},{"characterId":"59694","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["21302"],"vndbCharacterId":"c66438"},"originalCharacterName":"猫山 マヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"律と同じく里見八忍（にゃん）の一員であり、誇り高き猫忍うさぎ。"},{"spoiler":false,"text":"皆から愛されてるのかどうなのか、今日もいじられてはぷりぷり元気に怒っている。"},{"spoiler":false,"text":"自分の実力不足を痛感して日夜修行に励んでいるらしいが、今のところ目立った成長はない模様。"},{"spoiler":false,"text":"当面の目標は腕立て伏せ５０回。道は遠い。"},{"spoiler":false,"text":"シノと律が現状、対立していることには素直に「ひええ」と思っている。"},{"spoiler":false,"text":"具体的にどうこうというのはない。"}],"source":"egs","sourceCharacterId":"21302","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"ぽっちゃりわがままボディがトレードマーク(？)の、うさぎの猫忍。"},{"spoiler":false,"text":"北条に仕える忍者の中では、まあまあ古株。"},{"spoiler":false,"text":"好きな食べ物はおいしい野菜と果物。"},{"spoiler":false,"text":"苦手なものは運動(断言)。"},{"spoiler":false,"text":"日々、ぐーたら食っちゃ寝しているし悪びれる様子もない。"},{"spoiler":false,"text":"可愛いのがお仕事。"},{"spoiler":false,"text":"…のはすが、今回は数合わせ的に首根っこ掴まれて雑賀の調査に連れてこられた。"}],"source":"egs","sourceCharacterId":"21302","sourceWorkId":"34551","spoiler":false},{"segments":[{"spoiler":false,"text":"里見八忍の可愛い担当。師であるサトミ様も認める愛されうさぎ。"},{"spoiler":false,"text":"……もとい、うさぎの猫忍。"},{"spoiler":false,"text":"先日は雑賀の騒乱を受け、はじめてのお使いを無事に完遂した。"},{"spoiler":false,"text":"たぬきのナナコともお友達になった。"},{"spoiler":false,"text":"もうこれで一生働いたと勝手に決めつけて、現在はぐーたら生活に戻っている。"},{"spoiler":false,"text":"そんなマヤのこともおおらかに受け入れてくれる、はるきのことが大好き。"},{"spoiler":false,"text":"戦闘スタイルというか得意技はにゃんにゃんダンス。"},{"spoiler":false,"text":"可愛いは正義、ゆえに最強。"}],"source":"egs","sourceCharacterId":"21302","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"記憶喪失のうさ耳忍者。"},{"spoiler":false,"text":"運動能力は普通の人間以下で、何をさせてもどんくさい。"},{"spoiler":false,"text":"得意忍法はにゃんにゃんダンス。（ただ可愛く踊るだけ）"},{"spoiler":false,"text":"相手次第で上手くいけば魅了の効果を発揮する。"},{"spoiler":false,"text":"野菜か果物しか食べられないが、かなりのグルメ。バナナが大好物。"},{"spoiler":false,"text":"何から何までうさぎなのだが、本人は「自分は猫である」と譲らない。"},{"spoiler":false,"text":"警戒心や不安から家に来た当初はピリピリしているが、"},{"spoiler":false,"text":"次第に主人公の人柄に惹かれていく。"}],"source":"bangumi","sourceCharacterId":"59694"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe0968def344e01ac755b1a5c98f1888b25a096759356a02f53136b670e173fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bcafcee23eab66f7ac18f27472d45ebc3e1779909bfe87489fba48d9008c8e2.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269282:59694:13368:1","source":"bangumi"}]},{"characterId":"char_c82427","characterName":"北条 春希","sourceIds":{"bangumi":[{"characterId":"179913","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["28198"],"vndbCharacterId":"c82427"},"originalCharacterName":"北条 春希","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦国時代からこっそり続いている名門・北条家の一応は当主。"},{"spoiler":false,"text":"両親については謎に包まれている。"},{"spoiler":false,"text":"前章『猫忍えくすはーと』では風魔の里からやってきた、ゆらたまを受け入れ、様々な体験をふまえて立派に成長した（多分）。"},{"spoiler":false,"text":"現在は地元の大学に通いながら、北条の長としての今後に向けた準備を進めている。"},{"spoiler":false,"text":"新章主人公・菊丸達よりほんのちょっと年上。"},{"spoiler":false,"text":"性格は温厚で、ゆらたま達との関係も相変わらず。"},{"spoiler":false,"text":"みんなのことが大好き。"}],"source":"egs","sourceCharacterId":"28198","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"戦国時代からこっそり続いている名門・北条家の一応は当主。"},{"spoiler":false,"text":"両親については謎に包まれている。"},{"spoiler":false,"text":"前章『猫忍えくすはーと』では風魔の里からやってきた、ゆらたまを受け入れ、"},{"spoiler":false,"text":"様々な体験をふまえて立派に成長した（多分）。"},{"spoiler":false,"text":"現在は地元の大学に通いながら、北条の長としての今後に向けた準備を進めている。"},{"spoiler":false,"text":"新章主人公・菊丸達よりほんのちょっと年上。"},{"spoiler":false,"text":"性格は温厚で、ゆらたま達との関係も相変わらず。"},{"spoiler":false,"text":"みんなのことが大好き。"}],"source":"bangumi","sourceCharacterId":"179913"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"179913","value":"北条家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5bce00666776a6c57326d52abf89d99959320c31917c4a5a66ace057fc61d44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cf8d85c08826422242ba357342514d246fb3c243716df572b33316de38bded9.webp","width":236,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c82428","characterName":"雑賀 陽葵","sourceIds":{"bangumi":[{"characterId":"69776","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"69776","match":"exact-normalized-name-in-linked-work","subjectId":"441480"},{"characterId":"69776","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["21299"],"vndbCharacterId":"c82428"},"originalCharacterName":"雑賀 陽葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful yet high-handed young lady who comes to crash at the hero's house in typical (?) fashion. Has a habit of saying things are \"quite exquisite,\" but neither her words nor her actions are very exquisite, to say the least. She is all-around very panicky, which is disappointing. She is, however, a good girl on the inside... one assumes, at least. Somewhat of a junkie for beast-eared girls, in addition to lovingly doting over her two attendants, she has been falling head over heels for Maya's charm as of late. And she also seems to have a rather deep relationship with Saiha."},{"spoiler":false,"text":"“Perhaps this is a more fitting introduction? I am the next leader of the Saiga Clan! Successor to the Magoichi name... Saiga Himari!\""},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c82428"},{"segments":[{"spoiler":false,"text":"例によって（？）主人公の家に押しかけてきたタカビー美少女。"},{"spoiler":false,"text":"「雅ですわ」が口癖だが、言うことややることはそんなに雅じゃない。"},{"spoiler":false,"text":"全体的にドタバタしていてちょっと残念。"},{"spoiler":false,"text":"でも、本当はいい子…のはず。"},{"spoiler":false,"text":"ケモミミジャンキーの気があり、お付きの二人を猫っ可愛がりしてる他、最近はマヤの愛らしさにメロメロ。"},{"spoiler":false,"text":"彩羽とは浅からぬ因縁があるようだが？"}],"source":"egs","sourceCharacterId":"21299","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公同様、雑賀一族に属する猫耳の人。忍者ではないので要注意。"},{"spoiler":false,"text":"雅(みやび)さを尊ぶ上品なケモミミジャンキー。"},{"spoiler":false,"text":"調子に乗りやすいが基本的には善良な性格で、特に亜人には無条件で優しい。"},{"spoiler":false,"text":"以前は北条や雑賀本家(の一部)となんやかんやあったが、今は色々な意味で落ち着いている。"},{"spoiler":false,"text":"雑賀に起きた異変を調査するため、物語の舞台となる町にやってきた。"}],"source":"egs","sourceCharacterId":"21299","sourceWorkId":"34551","spoiler":false},{"segments":[{"spoiler":false,"text":"雑賀の分家に属する、猫耳お嬢様。"},{"spoiler":false,"text":"お嬢様とはいうが、まあ、それなり……というところではある。"},{"spoiler":false,"text":"オホホとは笑う。"},{"spoiler":false,"text":"獣の身体的特徴を持って生まれてきたため不遇な少女時代を送るが、子がない雑賀の分家に引き取られて今に至る。"},{"spoiler":false,"text":"一応、分家（一派閥）の長。"},{"spoiler":false,"text":"雑賀本家とは距離が遠く、今は北条にすっかり入れあげている。"},{"spoiler":false,"text":"「そういう関係ではありませんのよ」とは本人談。"},{"spoiler":false,"text":"アピールが露骨。"},{"spoiler":false,"text":"今日も亜人ジャンキーぶりを発揮しては、みんなに煙たがられている。"}],"source":"egs","sourceCharacterId":"21299","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"例によって（？）主人公の家に押しかけてきたタカビー美少女。"},{"spoiler":false,"text":"「雅ですわ」が口癖だが、言うことややることはそんなに雅じゃない。"},{"spoiler":false,"text":"全体的にドタバタしていてちょっと残念。"},{"spoiler":false,"text":"でも、本当はいい子…のはず。"},{"spoiler":false,"text":"ケモミミジャンキーの気があり、お付きの二人を猫っ可愛がりしてる他、"},{"spoiler":false,"text":"最近はマヤの愛らしさにメロメロ。"},{"spoiler":false,"text":"彩羽とは浅からぬ因縁があるようだが？"}],"source":"bangumi","sourceCharacterId":"69776"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cfae9592b384c46d2559841dbece01e4d1cb535d4b6e3dfb9207e02a4e3fa3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a3f744ef5fe52a82b7e891f1d4d200cdf64b7dd10fe370321b84eb255668ba5.webp","width":164,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夜長桜","creatorId":"vndb:s18157","sourcePersonId":"vndb:s18157","canonicalEntityId":"vndb:s18157","name":"夜長桜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80092","source":"vndb"}]},{"characterId":"char_c82429","characterName":"猫塚 シノ","sourceIds":{"bangumi":[{"characterId":"69777","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"69777","match":"exact-normalized-name-in-linked-work","subjectId":"441480"},{"characterId":"69777","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["21300"],"vndbCharacterId":"c82429"},"originalCharacterName":"猫塚 シノ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A self-proclaimed true cat ninja who wields the Demon Blade Murasame and a member of the Satomi Hachi-nyan Ninjas. She is supposed to be serving the hero in similar fashion to Ritsu and Maya, but she shows up alongside of Himari. Since she is the silent type of very few words, even her comrades think that it is hard to even guess what is on her mind at any given time. When the chips are down and her friends need her, she usually takes an all too galant stance and actively steps to the forefront, but this has the unfortunate result of making people think that she's a combat enthusiast and that the red from fresh blood is her favorite color, among other such misconceptions. Thing is, she is so shy and introverted that she can't even bring it in herself to refute those claims (even ones by her own teammates). She needs kindness and understanding. Also, she is a dog, not a cat. No doubt about it."},{"spoiler":false,"text":"“Mm-hmm.”"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c82429"},{"segments":[{"spoiler":false,"text":"妖刀ムラサメを携える自称・真の猫忍で、里見八忍（にゃん）の一員。"},{"spoiler":false,"text":"律やマヤと同じく主人公に仕えるはずだったが、なぜか陽葵と共に現れる。"},{"spoiler":false,"text":"口数の少ない寡黙なタイプで、仲間達からも「考えが読めない」と思われている。"},{"spoiler":false,"text":"仲間のために有事の際は積極的に前へ出る勇敢すぎる姿勢が、『戦闘狂』『好きな色は血の赤』と不本意な誤解を招いていたりも。"},{"spoiler":false,"text":"それを（仲間に対してすら）否定できないくらい、内気で引っ込み思案。"},{"spoiler":false,"text":"優しさと理解が求められる。"},{"spoiler":false,"text":"あと、どう見ても犬。"}],"source":"egs","sourceCharacterId":"21300","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"妖刀ムラサメを携える犬の猫忍。"},{"spoiler":false,"text":"現在は元々の主である陽葵共々、北条に身を寄せている。"},{"spoiler":false,"text":"たいそう居心地はよさそう。"},{"spoiler":false,"text":"強くて寡黙でとっても忠実な、頼れるわんこ。"},{"spoiler":false,"text":"本当は繊細なので扱いには注意が必要。"},{"spoiler":false,"text":"雑賀の異変を調査する陽葵のお供で、陽葵同様この町にやってきた。"}],"source":"egs","sourceCharacterId":"21300","sourceWorkId":"34551","spoiler":false},{"segments":[{"spoiler":false,"text":"里見八忍に属する犬の猫忍。"},{"spoiler":false,"text":"妖刀ムラサメを使いこなす凄腕の剣士だが、忍者って呼ばないと不機嫌になる。"},{"spoiler":false,"text":"本人的には色々と譲れないこだわりがあるらしい。"},{"spoiler":false,"text":"里見八忍所属時代、相棒のチカが逃走したため（後に師匠の指示と判明）、露頭に迷って雑賀に保護された末、陽葵の元に身を寄せた。"},{"spoiler":false,"text":"今は陽葵に仕えつつ、北条属・里見八忍に派遣されている形らしい。"},{"spoiler":false,"text":"そういう枠組みについては誰も特に気にしていない。"},{"spoiler":false,"text":"寡黙だが傷つきやすいので注意が必要。"},{"spoiler":false,"text":"そんな自分を理解してくれる主に対しては忠犬わんこ。"}],"source":"egs","sourceCharacterId":"21300","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"妖刀ムラサメを携える自称・真の猫忍で、里見八忍（にゃん）の一員。"},{"spoiler":false,"text":"律やマヤと同じく主人公に仕えるはずだったが、なぜか陽葵と共に現れる。"},{"spoiler":false,"text":"口数の少ない寡黙なタイプで、"},{"spoiler":false,"text":"仲間達からも「考えが読めない」と思われている。"},{"spoiler":false,"text":"仲間のために有事の際は積極的に前へ出る勇敢すぎる姿勢が、"},{"spoiler":false,"text":"『戦闘狂』『好きな色は血の赤』と不本意な誤解を招いていたりも。"},{"spoiler":false,"text":"それを（仲間に対してすら）否定できないくらい、内気で引っ込み思案。"},{"spoiler":false,"text":"優しさと理解が求められる。"}],"source":"bangumi","sourceCharacterId":"69777"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27e6f768c2555c9d9e2c9dd92fb71360f1b1b88d9854c13631b0037cd9b1e587.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb02ba9f8a6b4b0f4ded8f4f2a9751bd4a36afbdce8de2284cf414f79e0b1903.webp","width":141,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269282:69777:10026:1","source":"bangumi"}]},{"characterId":"char_c82431","characterName":"石川 沙奈","sourceIds":{"bangumi":[{"characterId":"69778","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"69778","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["21301"],"vndbCharacterId":"c82431"},"originalCharacterName":"石川 沙奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A tiger-eared maid who came along with Himari as her attendant, just like Shino. That is a title that she even gives herself, confirming that maid is the proper nomenclature. She also seems capable of using ninjutsu for the most part. To our hero, she is a breath of fresh air by the way of being the mature older sister type, with a kind and gentle appearance being her defining characteristics. But if one pays careful attention to her, you can sometimes see that she has an almost deadpan nature. In a certain sense, she is the hardest to get a proper gauge on. As a shikigami-user she masters all sorts of creatures, but her favorite is a tiger named Taison."},{"spoiler":false,"text":"\"I'm quite greedy when it comes to this. I always look for the most optimal result♪ Now, prepare yourselves.\""},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c82431"},{"segments":[{"spoiler":false,"text":"シノと同じく陽葵のお付きとしてやってきた虎耳メイド。"},{"spoiler":false,"text":"自分でもそう言っているのでメイドで確定。"},{"spoiler":false,"text":"一応、忍術も使える模様。"},{"spoiler":false,"text":"主人公にとっては新鮮なお姉さんタイプであり、おっとりした優しい佇まいが特徴。"},{"spoiler":false,"text":"でも、よくよく注意して見てみるとたまに目の奥が笑ってない。"},{"spoiler":false,"text":"ある意味、一番本心が読めない人。"},{"spoiler":false,"text":"式神使いとして様々な式を駆使するが、お気に入りは虎の大尊（たいそん）。"}],"source":"egs","sourceCharacterId":"21301","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"現在はメイドとして雑賀陽葵に仕えている、虎の亜人で忍者。"},{"spoiler":false,"text":"雑賀本家と繋がりが深いようだが、本人は周囲に何も説明していない。"},{"spoiler":false,"text":"そういうおおらかさがまかり通る、素敵な職場である。"},{"spoiler":false,"text":"雑賀の総本山でもある京都出身で陰陽の技を使いこなす。"},{"spoiler":false,"text":"特にお気に入りはホワイトタイガーの式神・大尊。"},{"spoiler":false,"text":"忍者……というか？うーん……という感じの存在。"},{"spoiler":false,"text":"本人は「メイド」と名乗っている。"}],"source":"egs","sourceCharacterId":"21301","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"シノと同じく陽葵のお付きとしてやってきた虎耳メイド。"},{"spoiler":false,"text":"自分でもそう言っているのでメイドで確定。"},{"spoiler":false,"text":"一応、忍術も使える模様。"},{"spoiler":false,"text":"主人公にとっては新鮮なお姉さんタイプであり、"},{"spoiler":false,"text":"おっとりした優しい佇まいが特徴。"},{"spoiler":false,"text":"でも、よくよく注意して見てみるとたまに目の奥が笑ってない。"},{"spoiler":false,"text":"ある意味、一番本心が読めない人。"},{"spoiler":false,"text":"式神使いとして様々な式を駆使するが、お気に入りは虎の大尊（たいそん）。"},{"spoiler":false,"text":"あと、どう見ても犬。"}],"source":"bangumi","sourceCharacterId":"69778"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fe6ae37545e80ccbd76a08991d36e506abc7d4d94b2a7d9ec4120c877457009.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/934ceabb1d707cccb5cbabb2b7ef026ec7ff5e130e123903ccb50b2bfd025121.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みたかりん","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269282:69778:25596:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p273","sourceCompanyId":"egs:brand:1888","canonicalEntityId":"vndb:p273","name":"Whirlpool","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"eg