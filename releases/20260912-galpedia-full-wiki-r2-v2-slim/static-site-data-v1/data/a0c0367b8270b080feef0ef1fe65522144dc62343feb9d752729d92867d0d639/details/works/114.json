ate":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second-year piano student at the Shukusei Music Academy. Her father is a former real estate agent who made his fortune during the bubble era. Shukusei Music Academy is a school that places importance on bloodlines, but Moeko is enrolled because of her good looks and financial resources."},{"spoiler":false,"text":"Because of her father's huge annual donations to the academy, Moeko is unable to quit the boring academy. She often return to the dormitory after curfew because she was playing with her boyfriend."},{"spoiler":false,"text":"She calls Shuusaku ‘Ojii~san’ in an offhanded way."},{"spoiler":false,"text":"Translated from the game's website, archived"}],"source":"vndb","sourceCharacterId":"c52997"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9950d10314796631e4db5b4efa48fad9a54dc373ed345eb8242d01c32b2b7ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e40c4570125e1357102ef83b44db4cf4d1ce36918741dfc5c0c5dc4b90a4913.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c53059","characterName":"伊頭 臭作","sourceIds":{"vndbCharacterId":"c53059"},"originalCharacterName":"伊頭 臭作","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7ca84c457585e490c0485d83b27101800213a00fbd6b423d94e2e985bbbbd276.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64be79a50c135a8871df39aa2bb5a4fdebef9dd7948