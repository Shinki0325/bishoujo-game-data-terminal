,"relationId":"egs:work-creator:7263","source":"egs"},{"creditedName":"山本忍","creatorId":"vndb:s7306","sourcePersonId":"egs:creator:1071","canonicalEntityId":"vndb:s7306","name":"山本忍","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:88311","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c20458","characterName":"篠原 いずみ","sourceIds":{"bangumi":[{"characterId":"59789","match":"exact-normalized-name-in-linked-work","subjectId":"10635"},{"characterId":"59789","match":"exact-normalized-name-in-linked-work","subjectId":"481606"}],"egsCharacterIds":["25523"],"vndbCharacterId":"c20458"},"originalCharacterName":"篠原 いずみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"弓道部部長を務める。友美の親友。社長令嬢でもある。"},{"spoiler":false,"text":"主人公とは悪友のような関係で軽口を叩きあう仲だが繊細な一面を見せることも。"}],"source":"egs","sourceCharacterId":"25523","sourceWorkId":"36044","spoiler":false},{"segments":[{"spoiler":false,"text":"TVCMでも有名な工業会社・篠原重工の社長令嬢。弓道部に所属しており、ショートカットヘアでボーイッシュな性格。また、活発で物事をハッキリ言うタイプでもある。機嫌が良い時は無意識の内に爪を噛んでしまう癖を持つ上、背が低いことにコンプレックスを持っており、主人公によくからかわれ、返す言葉が「いつか刺してやる」。主人公との悪友のような関係がいつしか彼への想いに変わるが、親友の友美の想いも自分同様であることを知っているため、彼女を傷付けたくない一心から悩む。温泉旅行中の主人公とのセックスは挿入を試みるも痛くて途中で止めてしまい結ばれなかった。そのため作中では処女のまま。"},{"spoiler":false,"text":"多忙を理由にほとんど登校してこない可憐については、彼女に一歩及ばない自らの容姿やプロポーションを気にしているためもあり、良く思ってはいない。設定の由来は、漫画『機動警察パトレイバー』の登場人物・泉野明と篠原遊馬。"},{"spoiler":false,"text":"OVA版では、友美ではなく唯と親友同士。誠との距離がかなり縮まるが、唯の想いを知り、身を引くこととなる。ゲーム版と違い、お嬢様という面はほとんど出ていない。"}],"source":"bangumi","sourceCharacterId":"59789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/607d1a307c6242305137af89026e5d3fd301b9a6dcfdc4a90710c7c39c5a6225.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c679f9a1d9964000a5d0bd661ce7a137b90be620ba9f54dfc60b00023f542ca.webp","width":175,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c20459","characterName":"鳴沢 唯","sourceIds":{"bangumi":[{"characterId":"36103","match":"exact-normalized-name-in-linked-work","subjectId":"10635"},{"characterId":"36103","match":"exact-normalized-name-in-linked-work","subjectId":"481606"}],"egsCharacterIds":["25521"],"vndbCharacterId":"c20459"},"originalCharacterName":"鳴沢 唯","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl who calls Ryunosuke \"big brother\" and has lived for years with him alongside her mother."}],"source":"vndb","sourceCharacterId":"c20459"},{"segments":[{"spoiler":false,"text":"幼い頃から主人公と同居している、妹的存在。血縁関係はなし。"},{"spoiler":false,"text":"別の学園に通っていたが、主人公を慕って八十八学園へ転入する。"}],"source":"egs","sourceCharacterId":"25521","sourceWorkId":"36044","spoiler":false},{"segments":[{"spoiler":false,"text":"八岁起就和主角住在同一个屋檐下，和主角是没有血缘关系的兄妹，因为这个关系，两人总是被同学拿来开玩笑。"},{"spoiler":false,"text":"唯对学校里的男生从不表示兴趣，经常为主角的事情操心，例如为了帮助主角赢得和天道老师的赌约，连续一周喊主角起床等等。"},{"spoiler":false,"text":"她一度因为西御寺的计策和主角生气，但因为一个色狼袭击的偶然事件，让她和主角都确认了彼此的感情。"},{"spoiler":false,"text":"唯是一个很可爱的普通女孩，不夸张、不矫饰，也不故作矜持。一直偷偷喜欢着主角的她，往往因为主角的钝感和不解风情而生气，却又一直坚持自己的心意。"}],"source":"bangumi","sourceCharacterId":"36103"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"83","source":"vndb","sourceCharacterId":"c20459","value":"83"},{"comparisonValue":"84","scope":"sourceWork","source":"egs","sourceCharacterId":"25521","sourceWorkId":"36044","value":"84"},{"comparisonValue":"84","source":"bangumi","sourceCharacterId":"36103","value":"84"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5b91930ef5fe454b9fa536b543107d15a0144a793be4a429a12e41d238598f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/089f459e51778ef17c2d571f96ff4b07ffd1f07a62b5da6da025b2554c576772.webp","width":163,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c20461","characterName":"長岡 芳樹","sourceIds":{"bangumi":[{"characterId":"99499","match":"exact-normalized-name-in-linked-work","subjectId":"10635"},{"characterId":"99499","match":"exact-normalized-name-in-linked-work","subjectId":"481606"}],"egsCharacterIds":["25538"],"vndbCharacterId":"c20461"},"originalCharacterName":"長岡 芳樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで写真部の部長。"},{"spoiler":false,"text":"部員は彼一人しかいない。いかがわしい写真を撮ることにすべてを捧げている変態。主人公に何故かシンパシーを抱いており、何かと接近してくる。"}],"source":"egs","sou