","relationId":"vndb:vn-staff:116278","source":"vndb"},{"creditedName":"R.Y.O","creatorId":"vndb:s23109","sourcePersonId":"vndb:s23109","canonicalEntityId":"vndb:s23109","name":"吉尾 重治","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116279","source":"vndb"},{"creditedName":"株式会社キルタイムコミュニケーション","creatorId":"vndb:s45011","sourcePersonId":"vndb:s45011","canonicalEntityId":"vndb:s45011","name":"株式会社キルタイムコミュニケーション","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116280","source":"vndb"}]},"cast":[{"characterId":"char_c71750","characterName":"リーゼ・ヘルデブランド","sourceIds":{"bangumi":[{"characterId":"89705","match":"exact-normalized-name-in-linked-work","subjectId":"197447"}],"egsCharacterIds":["12010"],"vndbCharacterId":"c71750"},"originalCharacterName":"リーゼ・ヘルデブランド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"法王庁特務機関に所属する悪魔祓いのエージェント「イバラの姉妹」の一人。"},{"spoiler":false,"text":"極めて意志が強く、性格は勝気で強気。"},{"spoiler":false,"text":"またプライドが高く、攻撃的かつ挑発的な言動が目立つ。"},{"spoiler":false,"text":"反面、少々調子に乗りやすい部分もある。"},{"spoiler":false,"text":"歯に衣着せぬ厳しい言動は辛辣な印象で、近寄り難い雰囲気を漂わせている。"},{"spoiler":false,"text":"だが実際には人間味溢れる性格で、シスターらしい友愛の心を持っている。"},{"spoiler":false,"text":"女と見れば襲う事しか考えない下劣な悪魔は、彼女にとって蔑むべき存在でしかない。"},{"spoiler":false,"text":"そんな下衆を断罪する「イバラの姉妹」の聖務には、使命感以上の優越感を抱いている。"}],"source":"egs","sourceCharacterId":"12010","sourceWorkId":"24227","spoiler":false},{"segments":[{"spoiler":false,"text":"法王庁特務機関に所属する、悪魔祓いのエージェント “イバラの姉妹” の一人。"},{"spoiler":false,"text":"極めて意志が強く、性格は勝気で強気。 プライドが高く挑発的な言動が目立つ。"},{"spoiler":false,"text":"聖務には、使命感以上に優越感を抱いている。"},{"spoiler":false,"text":"その心根は優しいが、人付き合いは苦手で協調性は皆無。"},{"spoiler":false,"text":"親の形見でもある二振りの蛇腹剣・咎人の剣 を用い、抜群の戦闘センスで敵を圧倒する。"},{"spoiler":false,"text":"咎人の剣は悪魔を引き裂くだけでなく空間を歪め魂までも喰らい、"},{"spoiler":false,"text":"12の刃にはそれぞれ人造天使が憑霊されており、各々特殊な力を秘めている。"},{"spoiler":false,"text":"「吠えろ！ 咎人の剣！　罪への裁きすら不要…… 魂までを喰らい殺せ!!」"}],"source":"bangumi","sourceCharacterId":"89705"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2b730a881ccc365dfd9d91a12833dfab2cbb714fce279aa55dc3d78e15972e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d753a41f097f4ec64888edb0e6a763fd130247ab8e15a1a6bb46f55c2f8b7073.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197447:89705:6349:1","source":"bangumi"}]},{"characterId":"char_c71751","characterName":"荒神 光流","sourceIds":{"bangumi":[{"characterId":"89706","match":"exact-normalized-name-in-linked-work","subjectId":"197447"}],"egsCharacterIds":["12011"],"vndbCharacterId":"c71751"},"originalCharacterName":"荒神 光流","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本の退魔組織の中でも中枢に位置する退魔省の大家「荒神」の娘。"},{"spoiler":false,"text":"呪力により調伏した魔物を呪符に封印し、その力を操る術を持つ。"},{"spoiler":false,"text":"現代でもただ魔物を滅ぼすだけでなく、その強大な力を利用しようと考えている先進派。"},{"spoiler":false,"text":"世界中の重篤な魔的災害、強大な力を持つ魔の存在を調査し可能ならばその力を手に入れる事を目的としている。"},{"spoiler":false,"text":"本音を見せず腹黒な部分も垣間見えるが、本当は少女らしい優しさを持っている。"},{"spoiler":false,"text":"だが、荒神家の使命を何よりも重要なものと考え優先し己を殺している。"},{"spoiler":false,"text":"本当はそれは辛いのだがそんな感情も笑顔で隠している。"}],"source":"egs","sourceCharacterId":"12011","sourceWorkId":"24227","spoiler":false},{"segments":[{"spoiler":false,"text":"日本の退魔組織の中でも中枢に位置する退魔省の大家・荒神家の娘。"},{"spoiler":false,"text":"腹黒な部分ばかりが目に付くが、本当は少女らしい優しさを持っている。"},{"spoiler":false,"text":"しかし荒神家の使命を何よりも優先し、弱みを見せないよう己を殺している。"},{"spoiler":false,"text":"古よりまつろわぬ神々に仕え、絶大な力と恩恵を受けてきた巫女の家系であり、"},{"spoiler":false,"text":"調伏した魔物を呪符に封印し、その力を操る術を持つ。"},{"spoiler":false,"text":"そのため魔を滅するだけでなく、可能ならばその力を手に入れようと企てている。"},{"spoiler":false,"text":"「うふふ、わたくしには荒神家の一員として成すべきことがありますの。」"}],"source":"bangumi","sourceCharacterId":"89706"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1403fe75c30a62b58d70affa1176a352b98ba124fade90f9759e94774d74de8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f76303550d8ff8a58b8e712473136f1c651b98396cc852510e6e40dc88199e80.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197447:89706:6351:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p655","sourceCompanyId":"egs:brand:1506","canonicalEntityId":"vndb:p655","name":"ミルフィーユ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:24227:1506","source":"egs"},{"companyId":"vndb:p655","sourceCompanyId":"vndb:p655","canonicalEntityId":"vndb:p655","name":"ミルフィーユ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:43555:v16495","source":"vndb"},{"companyId":"vndb:p655","sourceCompanyId":"vndb:p655","canonicalEntityId":"vndb:p655","name":"ミルフィーユ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:56571:v16495","source":"vndb"},{"companyId":"vndb:p655","sourceCompanyId":"vndb:p655","canonicalEntityId":"vndb:p655","name":"ミルフィーユ","roleCodes":["developer","publisher"],"identityStatu