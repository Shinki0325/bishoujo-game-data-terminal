lue":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend. She believes him to be her destined one because he saved her life before. She is excessively clingy to the protagonist. Excellent grades and good at sports, a cheerful and energetic girl, and is very nice to others, trusted by both students and teachers. She used to be very shy and timid when she was a child."}],"source":"vndb","sourceCharacterId":"c17528"},{"segments":[{"spoiler":false,"text":"主人公にベタ惚れでラブアタック全開な幼なじみ"},{"spoiler":false,"text":"主人公の幼なじみ。"},{"spoiler":false,"text":"命の恩人である主人公を運命の人と信じ、過剰なほど甘えてくる。"},{"spoiler":false,"text":"成績は優秀でスポーツ万能。"},{"spoiler":false,"text":"明るく人当たりのいい性格をしており、他の学生や教師からの信頼も厚い。"},{"spoiler":false,"text":"しかし、昔は人見知りの激しいおとなしい女の子だった。"}],"source":"egs","sourceCharacterId":"934","sourceWorkId":"18830","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。"},{"spoiler":false,"text":"命の恩人である主人公を運命の人と信じ、過剰なほど甘えてくる。"},{"spoiler":false,"text":"成績は優秀でスポーツ万能。"},{"spoiler":false,"text":"明るく人当たりのいい性格をしており、他の学生や教師からの信頼も厚い。"},{"spoiler":false,"text":"しかし、昔は人見知りの激しいおとなしい女の子だった。"}],"source":"bangumi","sourceCharacterId":"20611"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94fbf68ce56ebcb50c1ad15efd742eb0b550bed70f035b674ec5bb1adc839b11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03c087295a92901d258296e85c0fe69a7e74782cda57d6c63b01ba4a989e8c0d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:74813:20611:5936:1","source":"bangumi"}]},{"characterId":"char_c17530","characterName":"夏島 みさき","sourceIds":{"bangumi":[{"characterId":"20612","match":"exact-normalized-name-in-linked-work","subjectId":"74813"}],"egsCharacterIds":["935"],"vndbCharacterId":"c17530"},"originalCharacterName":"夏島 みさき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's cold and serious younger sister. She has loved her onii-chan for a very long time, but in order to suppress these feelings, she is very strict to him. The two of them lives alone together and the housework is entirely handled by Misaki. She has admired Nagisa ever since she was saved by her when she was in some trouble."}],"source":"vndb","sourceCharacterId":"c17530"},{"segments":[{"spoiler":false,"text":"兄に対して毒舌なクール妹"},{"spoiler":false,"text":"クールでまじめな性格な妹。"},{"spoiler":false,"text":"昔から自分を支えてくれる主人公のことが好きなのだが、気持ちを抑えるために無理にキツく当たっている。"},{"spoiler":false,"text":"主人公とは二人暮らし中で、岬が家事全般を担当しているため主人公は頭が上がらない。"},{"spoiler":false,"text":"過去に不良に絡まれた際、渚に助けられたことがあり、それ以来渚に憧れている。"}],"source":"egs","sourceCharacterId":"935","sourceWorkId":"18830","spoiler":false},{"segments":[{"spoiler":false,"text":"クールでまじめな性格な妹。"},{"spoiler":false,"text":"昔から自分を支えてくれる主人公のことが好きなのだが、気持ちを抑えるために無理にキツく当たっている。"},{"spoiler":false,"text":"主人公とは二人暮らし中で、岬が家事全般を担当しているため主人公は頭が上がらない。"},{"spoiler":false,"text":"過去に不良に絡まれた際、渚に助けられたことがあり、それ以来渚に憧れている。"}],"source":"bangumi","sourceCharacterId":"20612"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0012185030bc19ce562cf67800c9d53aaa21c987d0dc10fd123369d38c3a8d84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6be52ae0e025cce8f214160887cc03e94e1cf1cc03c3ac5ba12813aa150703e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEnti