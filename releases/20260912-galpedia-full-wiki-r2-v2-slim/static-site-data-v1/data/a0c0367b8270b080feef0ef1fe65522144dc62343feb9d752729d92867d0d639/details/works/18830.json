,"source":"bangumi","sourceCharacterId":"20614"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f482cc36817e8d6e3af96fc891e12144451cdcfb3ac290023d377f17c2ea548f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42dc740f665f837119dd5a9447bd1c528eacfc7cc270e093c0115316d9782a6f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:74813:20614:6106:1","source":"bangumi"}]},{"characterId":"char_c17534","characterName":"初瀬 湊","sourceIds":{"bangumi":[{"characterId":"20615","match":"exact-normalized-name-in-linked-work","subjectId":"74813"}],"egsCharacterIds":["938"],"vndbCharacterId":"c17534"},"originalCharacterName":"初瀬 湊","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"When you look at her you see a busty beauty, but she is in fact a casual and lazy woman. She is a fujoshi that loves otome and BL games with a tendency to escape marriages. Often pushes troubles to the protagonist, but her character makes you unable to dislike her."}],"source":"vndb","sourceCharacterId":"c17534"},{"segments":[{"spoiler":false,"text":"黙っていればスタイル抜群の美人なのだが、基本グータラでいい加減。"},{"spoiler":false,"text":"乙女ゲー・BLゲーをこよなく愛し、婚期を逃し気味。"},{"spoiler":false,"text":"色々と新十郎に厄介事を押し付けるが、どこか憎めない。"}],"source":"egs","sourceCharacterId":"938","sourceWorkId":"18830","spoiler":false},{"segments":[{"spoiler":false,"text":"黙っていればスタイル抜群の美人なのだが、基本グータラでいい加減。"},{"spoiler":false,"text":"乙女ゲー・BLゲーをこよなく愛し、婚期を逃し気味。"},{"spoiler":false,"text":"色々と新十郎に厄介事を押し付けるが、どこか憎めない。"},{"spoiler":false,"text":"「はいはーい、おはよー。みんないるー？　いない人は手上げてー？　よし。今日も欠席者なし、と」"}],"source":"bangumi","sourceCharacterId":"20615"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6a19eda02dda0ef08f4a3a9d385966f036b8fdfb0075cdffb9eb1e82acf7c6b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebafe4004c693b86ab6b835c04d0c15df9194843db4670f6da4f77547352f137.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:74813:20615:10027:1","source":"bangumi"}]},{"characterId":"char_c17535","characterName":"伊吹 涛子","sourceIds":{"bangumi":[{"characterId":"20616","match":"exact-normalized-name-in-linked-work","subjectId":"74813"}],"egsCharacterIds":["939"],"vndbCharacterId":"c17535"},"originalCharacterName":"伊吹 涛子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The serious student council president. The cultural festival is her last work while she is the president, so she is working very hard to make sure it goes smoothly without any incident. She likes to sing karaoke by herself. Recently she is secretly searching for cute glasses."}],"source":"vndb","sourceCharacterId":"c17535"},{"segments":[{"spoiler":false,"text":"生真面目で口うるさい生徒会長。"},{"spoiler":false,"text":"湘栄祭は彼女の生徒会長としての最後の仕事となるので、なるべく問題を起こさず静かに終わってほしいと考えている。"},{"spoiler":false,"text":"趣味は一人カラオケ。 最近こっそり可愛く見える眼鏡を探している。"}],"source":"egs","sourceCharacterId":"939","sourceWorkId":"18830","spoiler":false},{"segments":[{"spoiler":false,"text":"生真面目で口うるさい生徒会長。"},{"spoiler":false,"text":"湘栄祭は彼女の生徒会長としての最後の仕事となるので、なるべく問題を起こさず静かに終わってほしいと考えている。"},{"spoiler":false,"text":"趣味は一人カラオケ。 最近こっそり可愛く見える眼鏡を探している。"},{"spoiler":false,"text":"「夏島くんも正直どうかと思うけど、あなたと違って暴力沙汰は起こさないでしょうし」"}],"source":"bangumi","sourceCharacterId":"20616"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f733f8a016d26df43925f660f25a8ccd724ed80310a6041917ceefb85f81289.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/585d59ccc3c4d27f0964d9b0c86e05dc0efce347efd006e006e1dc48b10c17ec.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:74813:20616:13512:1","source":"bangumi"}]},{"characterId":"char_c17536","characterName":"日向 真","sourceIds":{"bangumi":[{"characterId":"20617","match":"exact-normalized-name-in-linked-work","subjectId":"74813"}],"egsCharacterIds":["940"],"vndbCharacterId":"c17536"},"originalCharacterName":"日向 真","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate, they often hang out together. He has feelings for him, but he is never taken seriously (because the protagonist isn't a homosexual). When he is praised by him, he becomes very shy."}],"source":"vndb","sourceCharacterId":"c17536"},{"segments":[{"spoiler":false,"text":"主人公の同級生の友達。 大輔も含めて3人でよくつるんでいる。"},{"spoiler":false,"text":"冗談まじりに新十郎にモーションをかけてくるが、わりと相手にされない。"},{"spoiler":false,"text":"たまに新十郎が褒めるとめちゃくちゃ照れる。"}],"source":"egs","sourceCharacterId":"940","sourceWorkId":"18830","spoiler":fals