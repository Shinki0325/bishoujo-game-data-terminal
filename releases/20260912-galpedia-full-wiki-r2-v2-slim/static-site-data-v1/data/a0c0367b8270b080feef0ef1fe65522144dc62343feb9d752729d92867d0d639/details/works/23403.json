{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23403","model":{"presentationWorkId":"egs:23403","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_188739","characterName":"Raguna","sourceIds":{"bangumi":[{"characterId":"188739","match":"source-roster","subjectId":"30103"}]},"originalCharacterName":"Raguna","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伊万与国王是从堂兄弟。拉格纳小时候在一场海难中失踪"},{"spoiler":false,"text":"伊万听说拉格纳在卡尔迪亚出现，便打扮成行商人来探查。"}],"source":"bangumi","sourceCharacterId":"188739"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a59bf1d8936104a25f16f6bb0959a6832b528f977d47c651465db0449944d73c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0761cce1b70a4f097813479899ac04dcf900fc240b005d7df73376aab25ec577.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朴璐美","creatorId":"vndb:s625","sourcePersonId":"vndb:s625","canonicalEntityId":"vndb:s625","name":"朴 璐美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:30103:188739:4027:1","source":"bangumi"}]},{"characterId":"char_bangumi_188740","characterName":"Mist","sourceIds":{"bangumi":[{"characterId":"188740","match":"source-roster","subjectId":"30103"}]},"originalCharacterName":"Mist","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在游戏制作组内部，是人气最高的角色。"},{"spoiler":false,"text":"居住在卡尔迪亚小镇的天然到脱线的少女，救下了失忆的拉格纳并邀请拉格纳经营牧场，虽然本人没有意识到但是却拥有着能够感知精灵以及看到他人看不见的东西的能力，在卡尔迪亚与拉格纳一同粉碎了泽克斯帝国的侵略计划。"},{"spoiler":false,"text":"直到有一天悄无声息的突然消失，拉格纳为了找寻也紧随其后离开了小镇四处搜寻，最终拉格纳在特兰路匹亚再次见到了失踪的密丝特，在特兰路匹亚二人在发生了一系列事件之后，再次拯救了小镇的危机。"},{"spoiler":false,"text":"然而拉格纳的突然失踪，让密丝特踏上了漫长的旅程。"}],"source":"bangumi","sourceCharacterId":"188740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ae297884089f604bea7ac754865cd9e27f290bd69a0d27c29f537e9871aee2e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8aa90b83d769b3c4d38512fee7873797ea47da883437ba191eba15be078d825a.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:30103:188740:4474:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:966","sourceCompanyId":"egs:brand:966","canonicalEntityId":"egs:brand:966","name":"マーベラス(マーベラスエンターテイメント、マーベラスAQL)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:23403:966","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
