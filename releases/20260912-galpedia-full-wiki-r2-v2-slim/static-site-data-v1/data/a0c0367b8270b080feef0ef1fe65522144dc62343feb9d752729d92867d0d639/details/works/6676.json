{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6676","model":{"presentationWorkId":"vndb:v8053","staff":{"artwork":[{"creditedName":"かどつかさ","creatorId":"vndb:s1916","sourcePersonId":"egs:creator:1923","canonicalEntityId":"vndb:s1916","name":"かどつかさ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:18338","source":"egs"},{"creditedName":"夢宮鈴乃","creatorId":"egs:creator:4737","sourcePersonId":"egs:creator:4737","canonicalEntityId":"egs:creator:4737","name":"夢宮鈴乃","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:22042","source":"egs"}],"scenario":[{"creditedName":"神堂 劾","creatorId":"vndb:s1280","sourcePersonId":"vndb:s1280","canonicalEntityId":"vndb:s1280","name":"神堂 劾","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:75552","source":"vndb"}],"music":[],"other":[{"creditedName":"かどつかさ","creatorId":"vndb:s1916","sourcePersonId":"egs:creator:1923","canonicalEntityId":"vndb:s1916","name":"かどつかさ","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:18337","source":"egs"},{"creditedName":"小橋 知子","creatorId":"vndb:s2331","sourcePersonId":"vndb:s2331","canonicalEntityId":"vndb:s2331","name":"小橋 知子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:75555","source":"vndb"},{"creditedName":"沖中 日出光","creatorId":"vndb:s31022","sourcePersonId":"vndb:s31022","canonicalEntityId":"vndb:s31022","name":"沖中 日出光","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:75556","source":"vndb"}]},"cast":[{"characterId":"char_c78875","characterName":"緋川 双葉","sourceIds":{"bangumi":[{"characterId":"154562","match":"exact-normalized-name-in-linked-work","subjectId":"185559"}],"egsCharacterIds":["25949"],"vndbCharacterId":"c78875"},"originalCharacterName":"緋川 双葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"多発するミミックの開発の調査のため、バイオウェル社の開発チームから派遣された調査員。"},{"spoiler":false,"text":"真面目で、落ち着いた雰囲気の女性。"},{"spoiler":false,"text":"祖父がミミックの生みの親的存在だったこともあり、プライドが高く、エリート意識も高い。"},{"spoiler":false,"text":"ミミックに対しては、主人公と同じく親身に接する。"}],"source":"egs","sourceCharacterId":"25949","sourceWorkId":"6886","spoiler":false},{"segments":[{"spoiler":false,"text":"バイオウェル社の開発チームから派遣された調査員。"},{"spoiler":false,"text":"ソラでの立場は新型ミミック担当開発主任。"},{"spoiler":false,"text":"新型を含むミミックの開発に携わっているが、後半に浮き彫りになっていく陰謀などについては知らない。あくまでいち開発員。"},{"spoiler":false,"text":"性格はクールで冷静。プライドやエリート意識も高い。これは自分の祖父がミミックの開発者であるため。"},{"spoiler":false,"text":"祖父である緋川博士がミミックの生みの親でありながら、そのデータの大半を破棄して死亡したことに、トラウマのようなものを抱いている。"},{"spoiler":false,"text":"もともと有能な女性だが、主人公の呑気な言動にイライラしたり、ペースを狂わされたりされてしまう。"},{"spoiler":false,"text":"内面的には冷たい人間ではなく、ことミミックについては主人公と同じほどに親身な接し方をする。"}],"source":"bangumi","sourceCharacterId":"154562"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7c84e8d458d79b75f94b081deddb15640a4fa17d3eb146746c965a4070bf053.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db9d21573fbbbb33b39222d6929a60a7b67292c35b646a373952420c9af2cbbf.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石松千恵美","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185559:154562:4273:1","source":"bangumi"}]},{"characterId":"char_c78876","characterName":"浅葱 夕","sourceIds":{"bangumi":[{"characterId":"154563","match":"exact-normalized-name-in-linked-work","subjectId":"185559"}],"egsCharacterIds":["25950"],"vndbCharacterId":"c78876"},"originalCharacterName":"浅葱 夕","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じく「特殊保険調査公社」の社員。"},{"spoiler":false,"text":"性格は明朗快活。"},{"spoiler":false,"text":"ミミックに対しては、あまり良い感情を持っていないようで、あくまでも“物”として接する傾向がある。"},{"spoiler":false,"text":"主人公に好意を抱いているが故に、主人公がミミックに傾倒していくのを好ましく思わず、さらにミミック嫌いに拍車がかかっていく。"}],"source":"egs","sourceCharacterId":"25950","sourceWorkId":"6886","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同僚だが、いわゆる普通の女の子。"},{"spoiler":false,"text":"考え方も（この時代として）一般的であり、ミミックはあくまで道具としてしか見てない。"},{"spoiler":false,"text":"もっとも、ミミックに雑な扱いをすると主人公が何故か不機嫌になるため、普段は自重しているようだ。"},{"spoiler":false,"text":"物語スタート前から、主人公に好意を抱いている。"},{"spoiler":false,"text":"それゆえ、内面ではミミックに傾倒していく主人公への反動で、ミミックに憎悪に似た感情すらも抱いている。"}],"source":"bangumi","sourceCharacterId":"154563"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8bc5bc990300170b6a1748bc61af1f0a6480bdd9796382fc4e1d812d0584488.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4d01f431639018b95753da0f1463afd23b5712a494b94ee8e31b82e0ab78175.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185559:154563:4490:1","source":"bangumi"}]},{"characterId":"char_c78879","characterName":"プリシラ","sourceIds":{"bangumi":[{"characterId":"154564","match":"exact-normalized-name-in-linked-work","subjectId":"185559"}],"egsCharacterIds":["25951"],"vndbCharacterId":"c78879"},"originalCharacterName":"プリシラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"施設の最深部に厳重に保管されていたミミックの女の子。"},{"spoiler":false,"text":"実験中に偶発的に生まれた、現時点でも最も進化した個体。"},{"spoiler":false,"text":"急激な進化のためか、コミニケーション能力が途上。"},{"spoiler":false,"text":"感情表現が乏しく、口調も機械的で抑揚がない。"},{"spoiler":false,"text":"ミミックは通常二対一組で誕生するものだが、彼女は二人分の胚をひとつの身体に持つ奇形種。"},{"spoiler":false,"text":"物語の鍵を握る存在。"}],"source":"egs","sourceCharacterId":"25951","sourceWorkId":"6886","spoiler":false},{"segments":[{"spoiler":false,"text":"施設の最深部に拘束されて厳重保管されていたミミック。"},{"spoiler":false,"text":"現時点でもっとも進化した個体であるが、あくまで偶発的に生まれたものであるため、施設で研究解析が進められていた。"},{"spoiler":false,"text":"急激な進化のため、当初は主人公たちともろくなコミュニケーションができない。"},{"spoiler":false,"text":"口調そのものは、落ち着いた、感情を感じさせず、抑揚のない口調。"},{"spoiler":false,"text":"物語の鍵を握る存在。"},{"spoiler":false,"text":"ミミックは通常、二体一組で生まれてくるのだが、彼女は二人分の胚をひとつの体に持っている畸形種。"}],"source":"bangumi","sourceCharacterId":"154564"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e215d7aaf07f01b709a4112dd6ea5449a5cd5e3389c7f593c18cb5518243b28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce0d00020a5b7b6a72660a95f90c326966fc781282ce21c5927f4a0f2003f76b.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185559:154564:4675:1","source":"bangumi"}]},{"characterId":"char_vndb_c78877","characterName":"ラピス&ラズリ","sourceIds":{"vndbCharacterId":"c78877"},"originalCharacterName":"ラピス&ラズリ","characterNameSource":null,"role":"