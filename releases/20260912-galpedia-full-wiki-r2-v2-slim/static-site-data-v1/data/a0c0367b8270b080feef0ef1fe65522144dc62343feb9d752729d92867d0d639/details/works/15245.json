 魚","creatorId":"vndb:s3705","sourcePersonId":"vndb:s3705","canonicalEntityId":"vndb:s3705","name":"弘森 魚","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66784","source":"vndb"},{"creditedName":"永月 到","creatorId":"vndb:s4009","sourcePersonId":"vndb:s4009","canonicalEntityId":"vndb:s4009","name":"永月 到","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66785","source":"vndb"}]},"cast":[{"characterId":"char_c13411","characterName":"雛緑 千羽","sourceIds":{"bangumi":[{"characterId":"52448","match":"exact-normalized-name-in-linked-work","subjectId":"15537"}],"egsCharacterIds":["10267"],"vndbCharacterId":"c13411"},"originalCharacterName":"雛緑 千羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"521"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"138"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"62"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公とは幼い頃から一緒に育った妹的な存在。"},{"spoiler":false,"text":"子犬のような性格で甘えん坊。"},{"spoiler":false,"text":"ペットになった後も、痛いのは嫌いなので、逆に優しいご主人様に教育しようと密かに企んでいる様子。"},{"spoiler":false,"text":"でも、もちろんアナタを慕う気持ちは本物！"}],"source":"egs","sourceCharacterId":"10267","sourceWorkId":"15245","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公とは幼い頃から一緒に育った妹的な存在。子犬のような性格で甘えん坊。"},{"spoiler":false,"text":"小さな頃に 「お兄ちゃんのペットになるぅ～！」 と約束し、それ以来、主人公を慕い続けてきた。"},{"spoiler":false,"text":"母の仕事で別れ別れになっている間も、「日本に戻ったらお兄ちゃんと同じ学園に通うの！」 と必死に勉強し、飛び級するくらい行動的な一面も。"},{"spoiler":false,"text":"主人公のペットになった後も、痛いのは嫌いなので、なんとか優しいご主人様に教育しようと密かに企んでいる。"},{"spoiler":false,"text":"もちろん、主人公を慕う気持ちは本物！"},{"spoiler":false,"text":"「千羽は今日からご主人様のペットです！　でも、痛いのと縛るのはダメだよ？　それと、たくさん愛してくれないと泣いちゃうかも」"}],"source":"bangumi","sourceCharacterId":"52448"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"52448","value":"すあま、みたらし団子"},{"label":"特技","source":"bangumi","sourceCharacterId":"52448","value":"集中力、記憶力"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52448","value":"お兄ちゃんと一緒にいること"},{"label":"胸围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"10267","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"138 cm","valueContext":null,"source":"egs","sourceCharacterId":"10267","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"10267","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"38 cm","valueContext":null,"source":"egs","sourceCharacterId":"10267","sourceWorkId":"15245","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ebee98bf9371b393bd7b55d0940377a77e6221c20f5638811bf32d11949198f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27c6aadc18dd686b5cec08bdb80db0b57515d4f7ac5aee0b08e38c55b7b2b6ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15537:52448:5928:1","source":"bangumi"}]},{"characterId":"char_c13412","characterName":"山嶺 聖 バーナード","sourceIds":{"bangumi":[{"characterId":"52449","match":"exact-normalized-name-in-linked-work","subjectId":"15537"}],"egsCharacterIds":["10269"],"vndbCharacterId":"c13412"},"originalCharacterName":"山嶺 聖 バーナード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"923"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学生自治会の会長を務め、美しい容姿と学園トップの学力で、まさに女王様的存在。さらに性格は完璧に女王様系。"},{"spoiler":false,"text":"似たような性格のアナタとは衝突が絶えず、喧嘩友達的な間柄。"},{"spoiler":false,"text":"しかし、ある件をきっかけに二人は急接近することに。"}],"source":"egs","sourceCharacterId":"10269","sourceWorkId":"15245","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。学生自治会の会長を務めている。"},{"spoiler":false,"text":"父親は日本人、母親はスイス人。美しい容姿と学園トップクラスの学力で、まさに学園の女王様……そして性格も女王様タイプ？"},{"spoiler":false,"text":"そのため、似たような性格の主人公とは衝突が絶えず、喧嘩友達的な間柄。"},{"spoiler":false,"text":"やれば出来るハズなのにさぼってばかりな主人公の、そのいい加減な態度が許せない様子。"},{"spoiler":false,"text":"しかし、ある事件をきっかけにふたりは急接近。今度はプレイを通じて “特別な関係” となってしまう。"},{"spoiler":false,"text":"「私は脅しになんて屈しないからっ！　で、ちなみに聞くけど…… 私に何をさせる気なのかしら？」"},{"spoiler":false,"text":"↑期待した目でこちらを見てる……"}],"source":"bangumi","sourceCharacterId":"52449"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"52449","value":"ラクレット、食べ放題系"},{"label":"特技","source":"bangumi","sourceCharacterId":"52449","value":"太らない"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52449","value":"格闘技全般（空手・総合系"},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"10269","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"10269","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"10269","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"10269","sourceWorkId":"15245","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4021a353daeab49a68be2b5ff2a1cf0492dba5c62990ad6507769b9f6cb494ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c05d9ab1dfc6fdd84428cab9cb8c697515bbf4a4580648d47faf79fa1de4934d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15537:52449:6019:1","source":"bangumi"}]},{"characterId":"char_c13413","characterName":"華円 柴乃","sourceIds":{"bangumi":[{"characterId":"52450","match":"exact-normalized-name-in-linked-work","subjectId":"15537"}],"egsCharacterIds":["10268"],"vndbCharacterId":"c13413"},"originalCharacterName":"華円 柴乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1107"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"不良達に絡まれていたところを助けられて以来、"},{"spoiler":false,"text":"アナタに好意をよせている。"},{"spoiler":false,"text":"学年は一つ上で、優しく誰からも好かれるお嬢様タイプの女の子。"},{"spoiler":false,"text":"また、昨年の自治会長と言うことで、聖も彼女には頭が上がらない。"}],"source":"egs","sourceCharacterId":"10268","sourceWorkId":"15245","spoiler":false},{"segments":[{"spoiler":false,"text":"以前、不良たちに絡まれていたところを主人公に助けられて以来、主人公に好意を寄せてくれている。"},{"spoiler":false,"text":"学年は一つ上で、華道部の部長を務め、その腕前はプロレベル。料理も得意で、主人公に届けるお弁当はおせち料理のレベル。"},{"spoiler":false,"text":"少しドジなところはあるが、誰にでも慕われる性格。"},{"spoiler":false,"text":"また、昨年の自治会長ということもあり、聖も彼女には頭が上がらない。"},{"spoiler":false,"text":"後輩である主人公たちに自治会の仕事を教えながら、なんとか主人公と親しくなりたいと思っていた彼女に偶然、そのチャンスが……"},{"spoiler":false,"text":"「あっ、あのぉ、興味があるんです…… そ、そんな顔で見ないでください。本当はそんな趣味なんて……」"}],"source":"bangumi","sourceCharacterId":"52450"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"52450","value":"このは丼、きざみあげのカレーうどん"},{"label":"特技","source":"bangumi","sourceCharacterId":"52450","value":"生花、着物を一人で着られること"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52450","value":"料理やお菓子を作ること"},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10268","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"10268","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"10268","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"10268","sourceWorkId":"15245","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1107","source":"vndb","sourceCharacterId":"c13413","value":"1107"},{"comparisonValue":"1107","source":"egs","sourceCharacterId":"10268","value":"11/7"},{"comparisonValue":"0117","source":"bangumi","sourceCharacterId":"52450","value":"11月7日（さそり座）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1300b9f40d6c261f2b9898d7d9defb914a8a5e46adeadd76ea6b34de55db1eef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1888546b9ee893c9a473f77568cf3e03e00906255b26a1fc20a28cb64f1e7b07.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15537:52450:7169:1","source":"bangumi"}]},{"characterId":"char_c13414","characterName":"戸井 風花","sourceIds":{"bangumi":[{"characterId":"52451","match":"exact-normalized-name-in-linked-work","subjectId":"15537"}],"egsCharacterIds":["10270"],"vndbCharacterId":"c13414"},"originalCharacterName":"戸井 風花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"319"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クラスメイト。弱気なくせに一言多い困った性格の娘。"},{"spoiler":false,"text":"アナタの学園に転校した千羽とは、直ぐに友達になり、アナタとの接点も何かと増えているようなのだが……？"}],"source":"egs","sourceCharacterId":"10270","sourceWorkId":"15245","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と千羽のクラスメイト。気が弱く引っ込み思案。おとなしい性格かと思えば、いつも一言多い困った性格の女の子。"},{"spoiler":false,"text":"そのせいか、クラスメイトからは主人公と聖の “近づきがたいコンビ” と同じ班や役職を押しつけられることが多く、なにかと不幸な境遇にいる。"},{"spoiler":false,"text":"千羽が転校後は千羽と友人になり、前よりも主人公との距離も近づいてきた。"},{"spoiler":false,"text":"しかし、今のところはその関係に変化はなく、今日も変わらず主人公の前でビクビクしている。"},{"spoiler":false,"text":"「麻黄君は悪い人じゃないと思うんです。ただ、目つきが悪くて態度が大きくて、ときどき恐くて…… はっ!?　いいところ見つかりません……」"}],"source":"bangumi","sourceCharacterId":"52451"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"52451","value":"たこ焼き、明石焼き"},{"label":"特技","source":"bangumi","sourceCharacterId":"52451","value":"たこ焼きをまん丸に焼ける"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52451","value":"ひなたぼっこ"},{"label":"胸围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"10270","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"10270","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"10270","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"10270","sourceWorkId":"15245","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bf25054015fa48976da02b79f28bab4adc6b45b506a922c2a64cb5f8f1aea1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c15b790f38698a2a6e4d0b8c48abd25f457ddabac368fb6db896fbd5f6f831e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15537:52451:11646:1","source":"bangumi"}]},{"characterId":"char_c13415","characterName":"雛緑 蝶子","sourceIds":{"bangumi":[{"characterId":"52452","match":"exact-normalized-name-in-linked-work","subjectId":"15537"}],"egsCharacterIds":["10271"],"vndbCharacterId":"c13415"},"originalCharacterName":"雛緑 蝶子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"901"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"101"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"千羽の母親。アナタにとっても母親的な存在だが、父と再婚が決まり、もうすぐ本当のお母さんになってしまうかも?!"},{"spoiler":false,"text":"ちなみに実の子供のようなアナタと、千羽との関係には大反対のようです。"}],"source":"egs","sourceCharacterId":"10271","sourceWorkId":"15245","spoiler":false},{"segments":[{"spoiler":false,"text":"千羽の母。主人公の父とは幼なじみの間柄でお隣さん同士。"},{"spoiler":false,"text":"幼い頃、母のいない主人公にとっての母親代わりであり、主人公の父とはいつ再婚してもおかしくはなかった。"},{"spoiler":false,"text":"しかし、決定的にそっち方面に鈍く、潔癖症ということから再婚には至らず。その後、十数年してやっと再婚が決まった。"},{"spoiler":false,"text":"現在は英国で暮らしている。仕事は有能なのだが家事は苦手。千羽が日本に行ってしまい、なにかと困っている様子。"},{"spoiler":false,"text":"ちなみに千羽と主人公の関係には……大反対。"},{"spoiler":false,"text":"「もぉもぉ、キスは大人になってからですよ？　赤ちゃんができたら困るもの…… それ以上のことは大人でもメッですからね！」"}],"source":"bangumi","sourceCharacterId":"52452"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"52452","value":"小倉トースト、台湾ラーメン"},{"label":"特技","source":"bangumi","sourceCharacterId":"52452","value":"洗濯（それ以外の家事は苦手）"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52452","value":"アンティーク収集"},{"label":"胸围（本版本）","value":"101 cm","valueContext":null,"source":"egs","sourceCharacterId":"10271","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"10271","sourceWorkId":"15245","sourceField":null,"scoped":true},{"label":"臀围（本版本）",