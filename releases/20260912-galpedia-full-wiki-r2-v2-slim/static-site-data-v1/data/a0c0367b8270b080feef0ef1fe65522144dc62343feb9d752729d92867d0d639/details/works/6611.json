y","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year student in Kashima school. Cheerful, vigorous, naive, a girl really knowledgeable about lots of trivia but at the same time failing at her own studies. Commander of the Kasuga Independent Gang."},{"spoiler":false,"text":"Hates things being obscured, and often does her utmost to unravel things forcefully, a really open character. An avid gamer of the game center in town along with her two childhood friends, Teppei and Tatsuya."}],"source":"vndb","sourceCharacterId":"c253"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56cb2fb3fe2460e53b445129a4b93122e37f546c4bb24d1dc9914baaf13687e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f21a18f5478e4fd49c298a2a3377af585fe57d0e86fcbf34e793cc40eec86999.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c254","characterName":"久保 晶子","sourceIds":{"vndbCharacterId":"c254"},"originalCharacterName":"久保 晶子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"908"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Masaru's little sister and Yukinojou's childhood friend. She was the former manager of the boxing club when those two were still active members, even though she did not really enjoy boxing. The thought of her beloved brother and childhood friend \"beating\" each other always filled her with uneasiness."},{"spoiler":false,"text":"Following the accident sending Masaru into coma, she harshly condemned Yukinojou, who was unable to bear this and moved to Kashima city. Short while later Shouko followed him, as she didn't intend to let him off the hook so easily."},{"spoiler":true,"text":"After becoming heartbroken during the first game's course and following Masaru's awakening, she came back to Ryouzuki. Nowadays, it seems she has completely gained back her normal cheerfulness and kindness. She's a reliable girl who takes care of her incompetent older brother and object of admiration for many in Ryouzuki school, especially for Gonzou and Akio."}],"source":"vndb","sourceCharacterId":"c254"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16c461fb7d3204f9736436a3543a514a61831086c0841a764acfcb681af12d22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e875a28e57908396e1c33e3ed19143ada1cc4ee60c914164123cfcab9ec722dd.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c255","characterName":"水島 あきら","sourceIds":{"vndbCharacterId":"c255"},"originalCharacterName":"水島 あきら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"202"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Masaru's classmate who spaces out all the time, and drives him up on the wall by always playing dumb. Her eyes are always droopy and she's a problem child who often has to take supplementary lessons along with Masaru."},{"spoiler":false,"text":"Akira is somehow aloof from the world, which creates discrepancy between her and her surroundings, causing her to be left out from class. Aside from Yumiko, her childhood friend, she doesn't mingle with others. She usually kills time by strolling around town until very late."},{"spoiler":false,"text":"Even though her and Masaru's personalities are poles apart, she claims that they are holding an inseparable relationship with each other, and he has often been caught by Akira during her strolls, whereas she also weasels her way to get treated for food by him."}],"source":"vndb","sourceCharacterId":"c255"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/652b28bee541f8678a6d98262977915e8315579fc01f567e5b80c215ab2e0b6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98a2ecf7b265c7ce912f43f1baef3edf267089e1f08fe6f6a4c20ef292c51b4c.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2565","characterName":"会長","sourceIds":{"vndbCharacterId":"c2565"},"originalCharacterName":"会長","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"609"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"His real name is unknown, but he's the Ryouzuki boxing gym's president, and everyone calls him as such."},{"spoiler":false,"text":"Masaru and Yukinojou's mentor, he was the one 