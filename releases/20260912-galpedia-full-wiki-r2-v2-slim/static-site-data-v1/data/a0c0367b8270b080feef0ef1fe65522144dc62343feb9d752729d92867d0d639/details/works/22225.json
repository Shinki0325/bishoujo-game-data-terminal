ndb:vn-staff:123267","source":"vndb"},{"creditedName":"黒井 弘騎","creatorId":"vndb:s6852","sourcePersonId":"vndb:s6852","canonicalEntityId":"vndb:s6852","name":"黒井 弘騎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:123269","source":"vndb"}]},"cast":[{"characterId":"char_c23308","characterName":"来須 麻希奈","sourceIds":{"bangumi":[{"characterId":"88782","match":"exact-normalized-name-in-linked-work","subjectId":"165552"}],"egsCharacterIds":["7047"],"vndbCharacterId":"c23308"},"originalCharacterName":"来須 麻希奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A transforming heroine who secretly fights against Millennium, a secret organization that plans to rule over the world. Her true identity is a black-haired beautiful girl with a dignified atmosphere and an indomitable passion. In her previous work, she defeated Mido, the murderer of Makina's father and her arch-nemesis. She has destroyed many of the organization's branches, but she is finally captured by the enemies this time. While she is being captured, Ark which is her source power for transformation is being bombarded with dark energy of degradation..."}],"source":"vndb","sourceCharacterId":"c23308"},{"segments":[{"spoiler":false,"text":"凜とした雰囲気に不屈の情熱を宿す、黒髪の美少女。"},{"spoiler":false,"text":"悪の結社《ミレニアム》に誘拐され、脳を除く全身を最終兵器として改造されてしまった。"},{"spoiler":false,"text":"しかし父親の手引きによって組織から逃亡した彼女は《ミレニアム》を壊滅させるべく、創世の秘宝《ディバインアーク》によって《ディバインハート・マキナ》に変身し、敵対する怪人たちと戦い続けている。"},{"spoiler":false,"text":"大人びた麗貌、立体的なDカップの美乳、女神のような完璧なプロポーションの持ち主。"}],"source":"egs","sourceCharacterId":"7047","sourceWorkId":"15132","spoiler":false},{"segments":[{"spoiler":false,"text":"凜とした雰囲気に不屈の情熱を宿す、黒髪の美少女。"},{"spoiler":false,"text":"悪の結社『ミレニアム』に拐かされ、脳を除く全身を最終兵器として改造されてしまった過去をもつ。"},{"spoiler":false,"text":"前作では、自らの手で父親殺しを経験させられ、最兇の暗黒ヒロイン『ハート・オブ・ダークネス』として覚醒。"},{"spoiler":false,"text":"しかし、カレンの献身的な説得により、正義を愛する心を取り戻した。"},{"spoiler":false,"text":"大人びた麗貌、立体的なＤカップの美乳、女神のような完璧なプロポーションの持ち主。"}],"source":"egs","sourceCharacterId":"7047","sourceWorkId":"22489","spoiler":false},{"segments":[{"spoiler":false,"text":"世界の支配を企む秘密結社・ミレニアムと、人知れず戦い続ける変身ヒロイン。"},{"spoiler":false,"text":"正体は、凜とした雰囲気に不屈の情念を宿す黒髪の美少女。"},{"spoiler":false,"text":"前作 では、父殺しの仇敵といえる御堂を倒し、その後も日本中を回り、いくつかの支部を破壊してきた。"},{"spoiler":false,"text":"だが、今回はついに後れを取り、敵に捕獲される。"},{"spoiler":false,"text":"堕落のダークエナジーを、変身を司るアークに注がれることに……。"}],"source":"bangumi","sourceCharacterId":"88782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acb63bc0d14feb162807c556cc766db7819cad6584f5d2a74621a96d0d938137.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3bc69f8e098b15de3c1934d2c22ff5a5f87cfbef61684497246b76436517522.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c23310","characterName":"来須 亜里亜","sourceIds":{"bangumi":[{"characterId":"88781","match":"exact-normalized-name-in-linked-work","subjectId":"165552"},{"characterId":"88781","match":"exact-normalized-name-in-linked-work","subjectId":"185555"}],"egsCharacterIds":["4998"],"vndbCharacterId":"c23310"},"originalCharacterName":"来須 亜里亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aria is a sister and a battlefield comrade of Machina, and she is also the user of Demonic Ark that controls destruction. Aria's characteristics are that of uneven temper and seductress. She loves doing lewd stuff to her sister. She is Karen's senior but refuses to fight along side her because she believes Karen is an indirect cause to Machina's loss."}],"source":"vndb","sourceCharacterId":"c23310"},{"segments":[{"spoiler":false,"text":"主人公・麻希奈の妹。"},{"spoiler":false,"text":"彼女もまた悪の結社《ミレニアム》に誘拐され、姉は洗脳手術を受ける前に組織から逃げ出すが、彼女は逃げ出せず、淫靡な洗脳手術が施されてしまった。"},{"spoiler":false,"text":"そのため《ディバインアーク》のレプリカを用いて《デモニックギア・アリア》に変身し、姉の前に立ちはだかる。"},{"spoiler":false,"text":"サドにしてマゾ、露出狂、未成熟で愛らしい小娘のような仕草。"},{"spoiler":false,"text":"あらゆる性技を身につけた、まさに小悪魔のようなニンフォマニアに変貌してしまっている。"}],"source":"egs","sourceCharacterId":"4998","sourceWorkId":"15132","spoiler":false},{"segments":[{"spoiler":false,"text":"【姉の意志を継ぐ悪魔少女】"},{"spoiler":false,"text":"マキナと共に転戦してきた妹で、破壊を司るデモニックアークの使い手。"},{"spoiler":false,"text":"気まぐれ、小悪魔な性格で、お姉ちゃんとエッチがとっても大好き。"},{"spoiler":false,"text":"カレンにとっては先輩戦士であるが、姉が負ける遠因を作った相手を認められず、カレンとの共闘を拒絶する。"},{"spoiler":false,"text":"「アリアさんじゃないでしょ？　ふふ、頂くわよ、カレン……♪」"}],"source":"egs","sourceCharacterId":"4998","sourceWorkId":"17675","spoiler":false},{"segments":[{"spoiler":false,"text":"マキナと共に転戦してきた妹で、破壊を司るデモニックアークの使い手。"},{"spoiler":false,"text":"気まぐれ、小悪魔な性格で、お姉ちゃんとカレンと、男と女と、エッチがとっても大好き。"},{"spoiler":false,"text":"生真面目すぎて悲観的になりがちな、マキナやカレンに間に立って、場を盛り上げる、変身ヒロインチームに欠かせないムードメーカー。"}],"source":"egs","sourceCharacterId":"4998","sourceWorkId":"22489","spoiler":false},{"segments":[{"spoiler":false,"text":"アークの力で亜里亜が変身した姿。"},{"spoiler":false,"text":"マキナ以上に躊躇いがなく敵を屠るサディスティックな戦闘スタイルは、各地のミレニアム構成員を震え上がらせている。"},{"spoiler":false,"text":"主な武器は、悪魔のような尻尾から無数の鞭を生やす、デモニックナインテイル。"}],"source":"bangumi","sourceCharacterId":"88781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bfbce79be01fa047f21725e4825a1796f72e7b0d30d05ff67c831a2466067da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8041746a639cce993aed310323039c5c2315f94a5bbdbcdcc85d6bbb79fa78b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c23312","characterName":"レディ・アストレア","sourceIds":{"bangumi":[{"characterId":"88783","match":"exact-normalized-name-in-linked-work","subjectId":"185555"}],"egsCharacterIds":["5001"],"vndbCharacterId":"c23312"},"originalCharacterName":"レディ・アストレア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female executive of Millennium who concurs with the organization's vision of \"creating a new world.\" She is a brawling type and recognizes Makina as her lifelong rival. Her previous base was destroyed and what will become of her? She is a virtuous warrior, but she has a past of being trained as a slave."}],"source":"vndb","sourceCharacterId":"c23312"},{"segments":[{"spoiler":false,"text":"監察官として秘密結社《ミレニアム》日本支部に派遣されている女幹部。"},{"spoiler":false,"text":"金持ちに慰み者として虐げられる、淫惨な子供時代を経験。"},{"spoiler":false,"text":"〈新たな世界を創造する〉という《ミレニアム》の思想に賛同し構成員となる。"},{"spoiler":false,"text":"高潔な武人タイプの女性だが、開発され尽くした豊潤な牝の肉体を味わいたい、という不埒者が、組織内でも後を絶たない。"}],"source":"egs","sourceCharacterId":"5001","sourceWorkId":"15132","spoiler":false},{"segments":[{"spoiler":false,"text":"【裁雷の女監察官】"},{"spoiler":false,"text":"『新たな世界を創造する』という組織の思想に賛同する、ミレニアムの女幹部。"},{"spoiler":false,"text":"マキナを終生のライバルと認める、根っからの武闘派。"},{"spoiler":false,"text":"前作で所属基地を破壊され、左遷されたはずの彼女の役割とは……？"},{"spoiler":false,"text":"高潔な武人だが、かつて肉奴隷として調教された過去がある。"},{"spoiler":false,"text":"「ふうむ、その心意気やよし。ならばもう手加減する必要はあるまい」"}],"source":"egs","sourceCharacterId":"5001","sourceWorkId":"17675","spoiler":false},{"segments":[{"spoiler":false,"text":"“新たな世界を創造する” という組織の思想に賛同する、ミレニアムの女幹部。"},{"spoiler":false,"text":"マキナを終生のライバルと認める、根っからの武闘派。"},{"spoiler":false,"text":"前作で所属基地を破壊され、左遷されたはずの彼女の役割とは……？"},{"spoiler":false,"text":"高潔な武人だが、かつて肉奴○として調教された過去がある。"}],"source":"bangumi","sourceCharacterId":"88783"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4109bd11d5474a6376ecb911b9db9fc81d8e58a8978a7cbf0d28d1d367cfa4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec226ebe9e2ae458e4829eb710e7e903d43c04f95ab6025e731ec2f972b9daba.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c23313","characterName":"成神 可憐","sourceIds":{"bangumi":[{"characterId":"88779","match":"exact-normalized-name-in-linked-work","subjectId":"165552"},{"characterId":"88779","match":"exact-normalized-name-in-linked-work","subjectId":"185555"}],"egsCharacterIds":["4996"],"vndbCharacterId":"c23313"},"originalCharacterName":"成神 可憐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new member chosen by Ark to replace Machina. Karen is normally a reserved and humble person, but if it is for her friends and people she trust, she would become a selfless person that could sacrifice herself. Until the moment, she lived her life peacefully in the Academy. Her bust and ass are well developed."}],"source":"vndb","sourceCharacterId":"c23313"},{"segments":[{"spoiler":false,"text":"【もう１人の運命の少女】"},{"spoiler":false,"text":"リタイアしたマキナの代わりに、新たにアークに選ばれた少女。"},{"spoiler":false,"text":"ともすると控えめだが、友達思いで、信頼した人のためなら我が身を省みず助けようとする芯の強さ、責任感も兼ね備えている。"},{"spoiler":false,"text":"目立たない、平凡をモットーにこれまでアカデミー生活を送ってきたが……。"},{"spoiler":false,"text":"バストとお尻が発育した、隠れトランジスタグラマー。"},{"spoiler":false,"text":"「麻希奈さんに貰った力と勇気……大切なみんなを守るために、使わせてもらいます！」"}],"source":"egs","sourceCharacterId":"4996","sourceWorkId":"17675","spoiler":false},{"segments":[{"spoiler":false,"text":"一時、リタイアしたマキナの代わりに、新たにアークに選ばれた少女。"},{"spoiler":false,"text":"ともすると控えめだが、友達思いで、信頼した人のためなら我が身を省みず助けようとする芯の強さ、責任感も兼ね備えている。"},{"spoiler":false,"text":"ミレニアムに人生を狂わされた人々を救うために、先輩にあたるマキナとアリアとともに戦い、タクティクス・心得を学んでいる。"},{"spoiler":false,"text":"バストとお尻が発育した、隠れトランジスタグラマー。"}],"source":"egs","sourceCharacterId":"4996","sourceWorkId":"22489","spoiler":false},{"segments":[{"spoiler":false,"text":"創世の力に感応して変身した、可憐のもう1つの姿。"},{"spoiler":false,"text":"双剣・アークエッジ、二丁拳銃・アークシューターを駆使し、蝶のように素早く舞い、嵐のような連撃を繰り出す。"},{"spoiler":false,"text":"劣勢に陥るたびに、新たな技や戦術を体得。"},{"spoiler":false,"text":"レクリスシティを護る、最強の変身ヒロインへと成長してゆく。"}],"source":"bangumi","sourceCharacterId":"88779"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/646b0aa94d738e6c075ff0b221d438414e3811c5009db115245d2e464d0023c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56123e6bb19efc1fb888e509a728b6263a3b28e47223dc65a9920a84f18543cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c23315","characterName":"カレン・スチュアート","sourceIds":{"bangumi":[{"characterId":"88819","match":"exact-normalized-name-in-linked-work","subjectId":"110517"}],"egsCharacterIds":["4468"],"vndbCharacterId":"c23315"},"originalCharacterName":"カレン・スチュアート","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レクリス修道会に所属する、正一級退魔シスター。"},{"spoiler":false,"text":"自らの拳や、敵に巻きつけた鎖から聖なる力を流しこむことにより、荒ぶる霊をはじめ、あらゆる邪悪を打倒してきた。"},{"spoiler":false,"text":"気取らない献身的な性格や、修道衣の下に隠された肉感的な体から、信者の内外を問わず、人気が高い。"},{"spoiler":false,"text":"通称『拳聖』『撲殺シスター』。"}],"source":"egs","sourceCharacterId":"4468","sourceWorkId":"20827","spoiler":false},{"segments":[{"spoiler":false,"text":"カレンが、宝珠・ルミナスアーク の力で変身した姿。"},{"spoiler":false,"text":"霊的次元の高い存在に一時的になることで、より効率良く大気中の霊素を取り込む術を手に入れる。"},{"spoiler":false,"text":"ただし、自らの魂を消耗する行為のため、使うほど寿命が急速に縮まる。"},{"spoiler":false,"text":"またこのモードで受けたダメージは、彼女の魂に直接反映される。 諸刃の剣とも言うべき闘法。"}],"source":"bangumi","sourceCharacterId":"88819"}],"profileFacts":[],"metadataCandidateConfl