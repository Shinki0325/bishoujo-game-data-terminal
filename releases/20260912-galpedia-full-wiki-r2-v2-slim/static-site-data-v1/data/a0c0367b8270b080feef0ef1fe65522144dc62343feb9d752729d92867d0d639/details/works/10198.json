rce":"static-detail"},"actors":[]},{"characterId":"char_bangumi_10999","characterName":"げんじい","sourceIds":{"bangumi":[{"characterId":"10999","match":"source-roster","subjectId":"1157"},{"characterId":"10999","match":"source-roster","subjectId":"1160"}]},"originalCharacterName":"げんじい","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"种族：龟(?)"},{"spoiler":false,"text":"职业：马"},{"spoiler":false,"text":"前五作时灵梦的座驾(?)"},{"spoiler":false,"text":"灵梦在修行途中把他抓回来当坐骑"},{"spoiler":false,"text":"因为前五作的灵梦不能飞，所以作为魔法少女吉祥物（误）辅助角色出场"},{"spoiler":false,"text":"乘坐方式是以大字型趴上去(无误)"},{"spoiler":false,"text":"第二作时很多话说,但之后再没有说话了"},{"spoiler":false,"text":"很明显的大M（误）"},{"spoiler":false,"text":"神主于2004年明治大学中的talk show「东方の夜明け」曾说过，「现在它大概是在那个神社的池中静静地生活着。」，也成为了神主承认的第三个在现今幻想乡中生活着的旧作人物？ ！"}],"source":"bangumi","sourceCharacterId":"10999"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67765c8ebf91a54a4d8455234a88af441fcd8100eb6b159a54b0bc9d046ff790.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/786adee570c9a691f3c8f43d107e56590d2da490d627282523bec4402c070a42.webp","width":64,"height":64,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_11000","characterName":"Engineer","sourceIds":{"bangumi":[{"characterId":"11000","match":"source-roster","subjectId":"1157"}]},"originalCharacterName":"Engineer","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"战车技师。天才少女。乘坐自己亲手制作的战车进行弹幕。"},{"spoiler":false,"text":"作品有封魔录1面的「ふらわ～戦车」及EX面的「飞行型戦车　EVIL EYE Σ」。还附带制作了1面道中BOSS。据说封魔录里那些鬼怪杂兵什么的也是她的作品。EX时与一面的服装不同。在EX面与灵梦再次见面时被叫做「一面的杂鱼」。说话时句尾会加上「～なのです」的口癖，有时会误将「いくなのです」说成「逝くなのです」。"}],"source":"bangumi","sourceCharacterId":"11000"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2aec7c8b6506cc22d1f1e2976a6a4d817595644929cdeef5a33ad9f3e57dc44e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d593b3c738b1495f4ea959bb50171709a02845333c69c783767b9f3f12a0d925.webp","width":64,"height":64,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_485","characterName":"博麗靈夢","sourceIds":{"bangumi":[{"characterId":"485","match":"source-roster","subjectId":"104009"},{"characterId":"485","match":"source-roster","subjectId":"1146"},{"characterId":"485","match":"source-roster","subjectId":"1148"},{"characterId":"485","match":"source-roster","subjectId":"1150"},{"characterId":"485","match":"source-roster","subjectId":"1151"},{"characterId":"485","match":"source-roster","subjectId":"1153"},{"characterId":"485","match":"source-roster","subjectId":"1155"},{"characterId":"485","match":"source-roster","subjectId":"1157"},{"characterId":"485","match":"source-roster","subjectId":"1160"},{"characterId":"485","match":"source-roster","subjectId":"12696"},{"characterId":"485","match":"source-roster","subjectId":"131875"},{"characterId":"485","match":"source-roster","subjectId":"1395"},{"characterId":"485","match":"source-roster","subjectId":"2134"},{"characterId":"485","match":"source-roster","subjectId":"329342"},{"characterId":"485","match":"source-roster","subjectId":"430567"},{"characterId":"485","match":"source-roster","subjectId":"5752"},{"characterId":"485","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"博麗靈夢","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幻想乡境内博丽神社的现有巫女。"},{"spoiler":false,"text":"博丽神社是专门守护幻想乡不可缺少的大结界的神社。博丽的巫女代代以解决异变为事业。"},{"spoiler":false,"text":"她是历代巫女中最缺乏危机感的一位，不知是因为修行不足，还是因为已经拥有足够的实力。"},{"spoiler":false,"text":"她天生地幸运和敏锐，也退治了不少妖怪。"}],"source":"bangumi","sourceCharacterId":"485"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"485","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"主要是在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"作为博丽巫女的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"操纵灵气的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33007c417ade7c73b7ee78244285c2ff601da86919605a6f56c0570deb01c0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc26d83763ce8144e0a342eaeb5a41bf3e1756ec782d0268170ef9bac39c8489.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_486","characterName":"霧雨魔理沙","sourceIds":{"bangumi":[{"characterId":"486","match":"source-roster","subjectId":"104009"},{"characterId":"486","match":"source-roster","subjectId":"1146"},{"characterId":"486","match":"source-roster","subjectId":"1148"},{"characterId":"486","match":"source-roster","subjectId":"1150"},{"characterId":"486","match":"source-roster","subjectId":"1151"},{"characterId":"486","match":"source-roster","subjectId":"1153"},{"characterId":"486","match":"source-roster","subjectId":"1155"},{"characterId":"486","match":"source-roster","subjectId":"1157"},{"characterId":"486","match":"source-roster","subjectId":"1160"},{"characterId":"486","match":"source-roster","subjectId":"12696"},{"characterId":"486","match":"source-roster","subjectId":"131875"},{"characterId":"486","match":"source-roster","subjectId":"1395"},{"characterId":"486","match":"source-roster","subjectId":"2134"},{"characterId":"486","match":"source-roster","subjectId":"329342"},{"characterId":"486","match":"source-roster","subjectId":"430567"},{"characterId":"486","match":"source-roster","subjectId":"5752"},{"characterId":"486","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"霧雨魔理沙","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"居住于魔法森林的人类魔法使，常骑着扫把，「霧雨店」的独生女。會使用魔法森林的蘑菇調製火藥，所使用的魔法幾乎只有把東西破壞的效果，而且燃料需要長時間準備，但是其效果非常強力，在Spell Card規則成立下，純粹的破壞力在人類當中屬於最高等級。此外在幻想乡是出了名的小偷，帕邱莉的图书馆、香霖堂，如果不是古明地觉会读心术，甚至连地灵殿都会惨遭毒手。"}],"source":"bangumi","sourceCharacterId":"486"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"486","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"486","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e00e4df671f5f80d5733c44e4b69596b901aad88177fc335789c2dd5ea6b2d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bd6c6ab5c1df20f216ccf8f7e1581841d4fed04fe2cad0f92ce726df7fb8d1.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_70310","characterName":"めいら","sourceIds":{"bangumi":[{"characterId":"70310","match":"source-roster","subjectId":"1157"}]},"originalCharacterName":"めいら","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明罗是《东方封魔录》中的二面BOSS。由于其外表偏中性，名字也是，很容易令玩家产生他是个男人的错觉。"},{"spoiler":false,"text":"游戏中，她的身形飘忽不定，会在玩家前方划过几道刀光化成弹幕攻击。"},{"spoiler":false,"text":"她有着和魅魔一样的野心，为了获得博丽的力量而去挑战灵梦，却被灵梦当成了求婚者的悲剧少女。被灵梦打败后，一时动弹不得还差点被灵梦活埋掉，不过还是从灵梦的魔掌中逃走了。"}],"source":"bangumi","sourceCharacterId":"70310"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aa127893e2a1667968b709eacc78f95f2c7f95643dd27a110d2d1b09a2aee48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4ff838c6135a9e7e9022c179d185a8ff3fee0b9bf213409b63afb8aae9762423.webp","width":64,"height":64,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_70311","characterName":"４面中ボス","sourceIds":{"bangumi":[{"characterId":"70311","match":"source-roster","subjectId":"1157"}]},"originalCharacterName":"４面中ボス","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"因为造型像天使，二设中一般称呼为魔天使"}],"source":"bangumi","sourceCharacterId":"70311"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/340457fb7c81bed15d6a61bffc77bada5e153624e3be6d6c18a5b4554dcb96cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15dbff65639030f57793577f12afc771ce9200ad7265bf577e5825b051dcf52a.webp","width":64,"height":51,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_70312","characterName":"イビルアイ∑","sourceIds":{"bangumi":[{"characterId":"70312","match":"source-roster","subjectId":"1157"}]},"originalCharacterName":"イビルアイ∑","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"邪眼西格玛的外观为一颗大大的眼睛，红色的眼珠子还带了很多血丝，拥有两个紫色的蝙蝠类翅膀，一个天使常备的光环，和两个肥触手。在它的下面是青色的东西（可能是叶子）。在眼皮下面则有个红色的∑标志。"}],"source":"bangumi","sourceCharacterId":"70312"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":