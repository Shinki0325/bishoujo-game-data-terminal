nal-wiki/v1/characters/v1/images/15/1537994aeb465ba2393548468eb23b8c240f8c4eae370c4563f323d2163dd5a4.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴谷 まや","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71131","source":"vndb"}]},{"characterId":"char_vndb_c53854","characterName":"カグヤ・セツナ","sourceIds":{"vndbCharacterId":"c53854"},"originalCharacterName":"カグヤ・セツナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at First Royal Knights Academy, Kaguya is training to someday become a knight alongside her classmates, Mikage and Arisa. As her instructor, Reika, sends the three out to hunt monsters, the trio become close friends."},{"spoiler":false,"text":"Like Arisa, many of Kaguya's actions are centered around making her family happy. Kaguya, however, is focused on bringing honor to hers, and less so providing for them. This determination is shown in her willingness to work hard and perfect herself. She shows little concern towards expressing her emotions, coming off as calm and indifferent. Her candid way of speaking only emphasizes this."}],"source":"vndb","sourceCharacterId":"c53854"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d0a72644b22b404e67cf771c1248367d670417c55b4c07ecf7a8c0f500b087c.webp","fallbackUrl":"https