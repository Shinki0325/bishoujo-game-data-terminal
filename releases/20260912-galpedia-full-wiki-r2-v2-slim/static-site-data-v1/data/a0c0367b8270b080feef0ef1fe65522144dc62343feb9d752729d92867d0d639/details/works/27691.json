 blast of energy."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c93176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bd78687ab417a4b84abc34dc67986f3016780f4fe248e0b1177f3d20b84027b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/979025f7f9f3daadcd42ba86c4a91fb12520ceb966ac143f75d400e2826967c3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮 天","creatorId":"vndb:s7409","sourcePersonId":"vndb:s7409","canonicalEntityId":"vndb:s7409","name":"雨宮 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80559","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1463","sourceCompanyId":"egs:brand:2567","canonicalEntityId":"vndb:p1463","name":"コンパイルハート","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27691:2567","source":"egs"},{"companyId":"vndb:p352","sourceCompanyId":"vndb:p352","canonicalEntityId":"vndb:p352","name":"アイディアファクトリー株式会社","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:128993:v25185","source":"vndb"},{"companyId":"vndb:p1463","sourceCompanyId":"vndb:p1463","canonicalEntityId":"vndb:p1463","name":"株式会社コンパイルハート","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:128994:v25185","source":"vndb"},{"companyId":"vndb:p4153","sourceCompanyId":"vndb:p4153","canonicalEntityId":"vndb:p4153","name":"スティング","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:128995:v25185","source":"vndb"},{"companyId":"vndb:p22931","sourceCompanyId":"vndb:p22931","canonicalEntityId":"vndb:p22931","name":"Shy projects","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:139030:v25185","source":"vndb"},{