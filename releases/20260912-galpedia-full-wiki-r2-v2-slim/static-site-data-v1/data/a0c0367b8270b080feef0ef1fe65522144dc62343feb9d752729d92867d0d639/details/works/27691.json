{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"27691","model":{"presentationWorkId":"vndb:v25185","staff":{"artwork":[{"creditedName":"つなこ","creatorId":"vndb:s4946","sourcePersonId":"vndb:s4946","canonicalEntityId":"vndb:s4946","name":"つなこ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:155452","source":"vndb"}],"scenario":[],"music":[{"creditedName":"坪田 修平","creatorId":"vndb:s21970","sourcePersonId":"vndb:s21970","canonicalEntityId":"vndb:s21970","name":"坪田 修平","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:155454","source":"vndb"}],"other":[{"creditedName":"野水 伊織","creatorId":"vndb:s1775","sourcePersonId":"vndb:s1775","canonicalEntityId":"vndb:s1775","name":"野水 伊織","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:155449","source":"vndb"},{"creditedName":"野水 伊織","creatorId":"vndb:s1775","sourcePersonId":"vndb:s1775","canonicalEntityId":"vndb:s1775","name":"野水 伊織","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:155450","source":"vndb"},{"creditedName":"つなこ","creatorId":"vndb:s4946","sourcePersonId":"vndb:s4946","canonicalEntityId":"vndb:s4946","name":"つなこ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:155451","source":"vndb"},{"creditedName":"sweet ARMS","creatorId":"vndb:s4969","sourcePersonId":"vndb:s4969","canonicalEntityId":"vndb:s4969","name":"sweet ARMS","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:155453","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c14291","characterName":"時崎 狂三","sourceIds":{"vndbCharacterId":"c14291"},"originalCharacterName":"時崎 狂三","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Nightmare\""},{"spoiler":false,"text":"Angel: Zafkiel"},{"spoiler":false,"text":"Astral Dress: Elohim"},{"spoiler":false,"text":"Kurumi is the third spirit who appeared after Tohka and Yoshino, and the most brutal so far. She has a split personality: that of a gentle, mysterous highschool girl with a slow talking pattern, and that of a psychopathic killer. She is very aggressive in her actions which makes it harder for Shidou to capture her."},{"spoiler":true,"text":"Kurumi has the archangel Zafkiel, and has the power to control over time. The reason why she keeps appearing after being killed by Mana countless times was because of her powers. For example, she can heal herself by turning back the time. She uses a gunblade as her weapon. The twelve Roman numerals on the clock in her left eye have different powers that only the original Kurumi can use, but by using their powers, it will cause her life to be eaten away. In order to avoid this, she kills people to obtain 'time'."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f651f2d5c6490c2483be44e81034a798b97a5e1252ca56c1bd9446522a43f808.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d77c80cb528368eb97840481445bedaa4bde4f5ab7bae8be35e03b3a13bf69d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真田 アサミ","creatorId":"vndb:s1712","sourcePersonId":"vndb:s1712","canonicalEntityId":"vndb:s1712","name":"真田 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80549","source":"vndb"}]},{"characterId":"char_vndb_c14341","characterName":"五河 士道","sourceIds":{"vndbCharacterId":"c14341"},"originalCharacterName":"五河 士道","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itsuka Shidou is a student of Raizen High School. He was adopted into the Itsuka family when he was \"abandoned\" by his mother."},{"spoiler":false,"text":"Shidou has the ability to seal a spirit's power. However, the reason why he possesses it is shrouded in mystery. Due to this power which was already known by Itsuka Kotori he was recruited -- or rather forced -- to join \"Ratatoskr\" to help and save Spirits. Instead of killing Spirits to prevent spacequake from happening, he has to seal the Spirit's powers with a kiss in order for them to co-exist with humans. Once the power of a Spirit is sealed within Shidou, he has the ability to use some portion of it, thus his resurrection power is from Kotori's abilities when he sealed Kotori's Spirit 5 years ago."},{"spoiler":false,"text":"From MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14341"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21a7de4b4740aeb8d17439f519e8196ecef4c02983a878ca94b0cadd72567986.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ec98147f356b1cc164ac14f114242f9e2f5558162ea0b5df978fe512a91b694.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c14344","characterName":"園神 凜祢","sourceIds":{"vndbCharacterId":"c14344"},"originalCharacterName":"園神 凜祢","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new character in the PS3 game, Date A Live: Rinne Utopia. Rinne is introduced as Shido's childhood friend, although he does not remember her. Rinne is a calm and gentle girl who acts like a traditional childhood friend who goes every morning to the Itsuka House to wake Shido up and prepare his lunch."},{"spoiler":true,"text":"Code name: Ruler"},{"spoiler":true,"text":"The truth is, Rinne (or Ruler) was never Shido's childhood friend, nor was she a human. She was born as a result of a large amount of spirit energy suddenly forming a consciousness of its own. One day, Shido's massive amount of stress caused by his dangerous life made the powers of the sealed spirits return to their owners, and on the school's rooftop, Tohka's power went berserk and accidentally killed him. At this moment, Rinne activated the Eden in order to save him. Her Eden engulfed the entire Tengu City and she slipped inside Shido's life as his childhood friend. Her objective was to continue this Eden forever and hoped that Shido would never discover the truth of Eden and have a happy life with his chosen partner."}],"source":"vndb","sourceCharacterId":"c14344"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91a80b8229053a76b6952c3d42615bbef510e9077e9bddd1121761e8663b3470.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cc9ace6cc4ae27096c8633adba9142717b990b3a9b3c6e7c75cce4b8fce32ad.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤 香菜","creatorId":"vndb:s237","sourcePersonId":"vndb:s237","canonicalEntityId":"vndb:s237","name":"花澤香菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80544","source":"vndb"}]},{"characterId":"char_vndb_c14357","characterName":"夜刀神 十香","sourceIds":{"vndbCharacterId":"c14357"},"originalCharacterName":"夜刀神 十香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Princess\""},{"spoiler":false,"text":"Angel: Sandalphon"},{"spoiler":false,"text":"Astral Dress: Adonai Melek"},{"spoiler":false,"text":"Yatogami Tooka's name is given by Shidou when they first met. Due to being a spirit, she is always being targeted by the AST and is aiming for the kill, because of that she hated humans for always shunning her and thinking that she wasn't allowed to live in this world, but her whole life changed when she met Shidou."},{"spoiler":false,"text":"Even with that high and cool presence, Tooka lacks some common sense and loves food very much."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/191f25b31d942bf6b4705ca231b87f0cf42b7bcf33e98997c487b9d4e6de5e70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97fe3b02c1b3dd16943e18ef0b175a46db4fb9d69373f85cd46c6785aef7f31b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 麻里奈","creatorId":"vndb:s1774","sourcePersonId":"vndb:s1774","canonicalEntityId":"vndb:s1774","name":"井上 麻里奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80551","source":"vndb"}]},{"characterId":"char_vndb_c14372","characterName":"五河 琴里","sourceIds":{"vndbCharacterId":"c14372"},"originalCharacterName":"五河 琴里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"803"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Efreet\""},{"spoiler":false,"text":"Angel: Camael"},{"spoiler":false,"text":"Astral Dress: Elohim Gibor"},{"spoiler":false,"text":"Kotori is Shido's foster sister and the head commander of Ratatoskr."},{"spoiler":false,"text":"Kotori's character changes according to the color of the ribbons she's wearing. While wearing white ribbons she is that of her \"weak self\", a delicate little sister who is very dependent upon her big brother; and when wearing black ribbons, she becomes her \"strong self\", a charismatic and sometimes cynical leader able to successfully command the airship, Fraxinus. In her Spirit form, Kotori acts the same as her ribbons' current color indicates. But if she stays in her spirit form for too long, her third, \"Spirit personality,\" takes over and she becomes an aggressive and merciless killing machine, who only cares about battling enemies to death."},{"spoiler":false,"text":"In all three cases, Kotori seems to have a sadistic side. Her deep feelings for Shidou are always present, regardless of her current personality and help her remember who she truly is. No matter what the situation is, she will always be Shido's little sister."},{"spoiler":false,"text":"Kotori is a Fire Spirit and she became one 5 years prior to the main events after being turned into one by Phantom. Her powers are centered on the manipulation of flames that erupt from her body and can be used in close or ranged combat. Her angel Camael comes in the form of a large red halberd but can be dismantled into Megiddo, a cannon powered by Kotori's own flames. Megiddo fires powerful energy beams that can overwhelm even the defenses of other Spirits. Kotori also has a powerful regeneration ability, which Shidou uses/borrows on many occasions when he is trying to make spirits fall for him."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c14372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b05e8c45da01607e8b4a30c942b705588ddbac9404d617cc25eeb19a81598ee6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da0b0327f45fec76beccda9b1a99b346356160097d093e37d805df1f5d3996cf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹達 彩奈","creatorId":"vndb:s1767","sourcePersonId":"vndb:s1767","canonicalEntityId":"vndb:s1767","name":"竹達 彩奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80550","source":"vndb"}]},{"characterId":"char_vndb_c14373","characterName":"氷芽川 四糸乃","sourceIds":{"vndbCharacterId":"c14373"},"originalCharacterName":"氷芽川 四糸乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Hermit\""},{"spoiler":false,"text":"Angel: Zadkiel"},{"spoiler":false,"text":"Astral Dress: El"},{"spoiler":false,"text":"Second Spirit to appear, and the kindest spirit up to date. She's very shy and relies on her Hand Puppet Yoshinon to communicate with others. She causes rain to fall whenever she appears, which is part of her ability to control the three states of water. Mainly uses ice attacks though."},{"spoiler":false,"text":"Taken from TVTropes"}],"source":"vndb","sourceCharacterId":"c14373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/508b845562949e81b7866c8c27d727c80a3dafedc4a290cd249400f2019f57d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d523965a1c2da49c6dc215d1745b9f8a31cb632c2807d97f4f4da4ea44e9f2e5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野水 伊織","creatorId":"vndb:s1775","sourcePersonId":"vndb:s1775","canonicalEntityId":"vndb:s1775","name":"野水 伊織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80552","source":"vndb"}]},{"characterId":"char_vndb_c14376","characterName":"村雨 令音","sourceIds":{"vndbCharacterId":"c14376"},"originalCharacterName":"村雨 令音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Reine is highly intelligent and the Analysis Officer of Ratatosk's Fraxinus Crew."},{"spoiler":false,"text":"She can be ranked the Vice-Commander of the crew rather than Kannazuki Kyouhei, as it is usually her at Kotori's side, managing things around the crew. She transferred to Raizen Highschool as a Physics teacher and an assistant homeroom teacher at Shidou's class. She has big eyebags which are a result of her not having had enough sleep. In fact, Reine stated at one point that \"for the last 30 years, she hasn't been able to sleep properly.\""},{"spoiler":false,"text":"At some points, she can be reliable and take Command of the directions which Shidou needs to do when dating a spirit. She acts like the \"mother\" of Shidou and the other Spirits to help them with their troubles and such."},{"spoiler":false,"text":"Reine has a habit of calling Shido \"Shin\", because she can never pronounce his name right."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14376"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f18538974bb0796fa3911b70a7b8ced0760a109186b072a140a48abf80719a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06e0389df0ede32cc78b6a872e8b22c182fee177af5422cf326369a65ab130aa.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠藤 綾","creatorId":"vndb:s5699","sourcePersonId":"vndb:s5699","canonicalEntityId":"vndb:s5699","name":"遠藤 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80558","source":"vndb"}]},{"characterId":"char_vndb_c25888","characterName":"八舞 耶倶矢","sourceIds":{"vndbCharacterId":"c25888"},"originalCharacterName":"八舞 耶倶矢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code Name: Berserk"},{"spoiler":false,"text":"Astral Dress: Elohim Tzabaoth"},{"spoiler":false,"text":"Angel: Raphael"},{"spoiler":false,"text":"Yamai was originally one Spirit, but for some unknown reasons that may be related with her teleporting between dimensions sometime in the past; she was split into two bodies and minds. The original personality of Yamai is now gone, as well as what type of personality she used to have is unknown to the split Yamais. The Yamai Sisters have been well known to the people who knew about the existence of spirits because they often cause a major storm in an area, that occur every time they come to Earth."},{"spoiler":false,"text":"Outgoing and out-spoken, one can say that she is childish or immature. Kaguya often speaks rather unrealistically, as if she is acting. It is later revealed that it really is acting. Kaguya believes she must speak like this because she is a spirit, and therefore \"super awesome\", and therefore must act appropriately. Her main weapon is El Re'em, a lance."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c25888"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cf12ce21df2e5783c74d0ec6e62b239853272202ec380453a6287e1ac5f8105.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bf78ad9e903ffc4ca16b803ec5d4b3857e26320d81bbaa316bb49c5af518d80.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内田 真礼","creatorId":"vndb:s1326","sourcePersonId":"vndb:s1326","canonicalEntityId":"vndb:s1326","name":"内田 真礼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80547","source":"vndb"}]},{"characterId":"char_vndb_c25889","characterName":"誘宵 美九","sourceIds":{"vndbCharacterId":"c25889"},"originalCharacterName":"誘宵 美九","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Codename: Diva"},{"spoiler":false,"text":"Astral Dress: Shaddai El Chai"},{"spoiler":false,"text":"Angel: Gabriel"},{"spoiler":false,"text":"Miku is a Spirit and an idol. She hates men to the point that Shidou even had to crossdress in order to interact with her. Her Angel, Gabriel has the ability to manipulate and brainwash people."},{"spoiler":false,"text":"Miku is very flirty, both before and after warming up to Shidou, she expresses this towards most women who fit her type (and Shidou) and is very blunt about it. After warming up to Shidou, she doesn't hesitate to flirt with both him and the other Spirits and does not even mind Shido having a harem, in fact, she pretty much encourages it. Shidou describes her current personality as \"very childish\", and she is very affectionate."},{"spoiler":false,"text":"Just like Kotori, Miku was a normal human before she became a Spirit. Ever since she was little, Miku loved singing. She wasn't good at studying or sports, but she could sing better than anyone else around her. As an aspiring singer, she had always dreamed of performing on the big stage. That dream came true when she debuted as an idol singer at the age of 15 under the stage name Tsukino Yoimachi. It was the best thing that Miku could have wished for, doing the very thing she loved and being adored by her fans."},{"spoiler":false,"text":"Her career, however, came to an abrupt end just after about a year when she refused to have sex with a hotshot TV producer. Before Miku knew it, false scandals about her began to appear and she soon fell out of favor with her agency along with her fans beginning to hate her. Miku thought that she could reconnect everything back with her singing, but then suddenly lost her voice."},{"spoiler":false,"text":"As Miku contemplated suicide, Phantom appeared before her and turned her into a Spirit. Afterwards, she used her spirit powers, regained her lost voice, and debuted again using the name Miku Izayoi. She became famous due to her voice that is was known as 'sound anesthetic' and released several super popular tracks. However, she never appeared in magazines, television, or any public media. Miku held only private concerts and the only ones who were invited were her loyal female fans due to her hatred for men."}],"source":"vndb","sourceCharacterId":"c25889"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/5660c81835c4f89b1792866bf5c5e47496931098fed5d6df5a15e5c5e38c6c71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33d686c815827fde82a639f12c0deec145bd2148f8b0ef7a43d23595ba5a11c2.webp","width":252,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅原 実里","creatorId":"vndb:s1459","sourcePersonId":"vndb:s1459","canonicalEntityId":"vndb:s1459","name":"茅原 実里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80548","source":"vndb"}]},{"characterId":"char_vndb_c27422","characterName":"八舞 夕弦","sourceIds":{"vndbCharacterId":"c27422"},"originalCharacterName":"八舞 夕弦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code Name: Berserk"},{"spoiler":false,"text":"Astral Dress: Elohim Tzabaoth"},{"spoiler":false,"text":"Angel: Raphael"},{"spoiler":false,"text":"Yamai was originally one Spirit, but for some unknown reasons that may be related with her teleporting between dimensions sometime in the past; she was split into two bodies and minds. The original personality of Yamai is now gone, as well as what type of personality she used to have is unknown to the split Yamais. The Yamai Sisters have been well known to the people who knew about the existence of spirits because they often cause a major storm in an area, that occur every time they come to Earth."},{"spoiler":false,"text":"Yuzuru often speaks in a robot-like speech pattern; when arguing with Kaguya, she always sneers at her and points out the flaw in Kaguya’s argument. She tells the point of comment before speaking the rest. For example, \"Confirm; Shido\". She also speaks in a third-person perspective sometimes."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c27422"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/694fa0d12a7636401e354caeb5e4497290c3e4413a8b1653d9b5296281e83fdb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f07634ebfa73305bc556bade24e39019ac37b1059842f771ed407ff6be26c4f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ブリドカット・セーラ・恵美","creatorId":"vndb:s3948","sourcePersonId":"vndb:s3948","canonicalEntityId":"vndb:s3948","name":"ブリドカット・セーラ・恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80555","source":"vndb"}]},{"characterId":"char_vndb_c27423","characterName":"或守 鞠亜","sourceIds":{"vndbCharacterId":"c27423"},"originalCharacterName":"或守 鞠亜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"When Maria first presented herself to Shido, she appeared to be nothing more than a curious girl who simply wanted to know the definition of \"love\" at first."},{"spoiler":false,"text":"Maria observed Shido's interaction with the Spirits throughout the game, and not only did she understood the meaning of \"love\" through her observation, but her true personality slowly resurfaced. Her personality seemed to be a combination of Tohka and Origami altogether. She can easily become interested in common things found in our daily lives, with Shido introducing hot buns to her as an example of this. Unlike Tohka, however, she is as knowledgeable as Origami due to having access to the Fraxinus database."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c27423"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/990a57f7f9ef43463409031b5bd65f74764b7d1082e703819df508e199b03386.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3b254d21a363198d2dc322d72cda2309cecbd2f9ce9fc4b314f85c4c2937f86.webp","width":217,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三森 すずこ","creatorId":"vndb:s627","sourcePersonId":"vndb:s627","canonicalEntityId":"vndb:s627","name":"三森 すずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80545","source":"vndb"}]},{"characterId":"char_vndb_c27424","characterName":"或守 鞠奈","sourceIds":{"vndbCharacterId":"c27424"},"originalCharacterName":"或守 鞠奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has shown to be a little bit harsh and mean, as she always removes NPCs that are in her way without much thought. But as time went, she began to show signs that \"she’s beginning to change\" by helping an elderly NPC in the street. As a reward, Shido gives her a meat bun in a park at night, and at some other time, pats her head as a reward."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c27424"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc545fda378750106e5b615e38935d44a49535dbd751d0ca13bf39e0adda8094.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/441852123acb69fdd154b191a4550714b807d38e97f68483c0545a3ac71ffe23.webp","width":229,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三森 すずこ","creatorId":"vndb:s627","sourcePersonId":"vndb:s627","canonicalEntityId":"vndb:s627","name":"三森 すずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80546","source":"vndb"}]},{"characterId":"char_vndb_c30725","characterName":"凜緒","sourceIds":{"vndbCharacterId":"c30725"},"originalCharacterName":"凜緒","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rank: A-class Spirit"},{"spoiler":false,"text":"Rio is a character exclusively to the game Date A Live Twin Edition: Rio Reincarnation and the novel version of the game. Rio has a very childlike, yet also kind personality. She restarted Eden in order to try to help Shido, who she views as her father, find happiness."}],"source":"vndb","sourceCharacterId":"c30725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd62ffe4b1636d6562222c487842a2843d1b711349ef3a733a908128c14259c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30a2458bed4e9574a94983446d094fdabb67e7eebdf0284fd959b57312872fe5.webp","width":256,"height":255,"source":"static-detail"},"actors":[{"creditedName":"佐倉 綾音","creatorId":"vndb:s3892","sourcePersonId":"vndb:s3892","canonicalEntityId":"vndb:s3892","name":"佐倉 綾音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80553","source":"vndb"}]},{"characterId":"char_vndb_c80997","characterName":"鏡野 七罪","sourceIds":{"vndbCharacterId":"c80997"},"originalCharacterName":"鏡野 七罪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Witch\""},{"spoiler":false,"text":"Angel: Haniel"},{"spoiler":false,"text":"Adult Form Height & 3-Sizes: 170 cm & 94/62/90"},{"spoiler":false,"text":"Natsumi is the seventh Spirit who appears in the series. She first appears as a slender woman whose age should be slightly past 20 years old. However, it is later revealed that her true form is a little girl with the appearance of a child with unkempt hair and clothing."},{"spoiler":false,"text":"Natsumi is very pessimistic and has a major inferiority complex. She is prone to be jealous of others, especially of their bodies. Due to her power to transform and shapeshift, she tries to act and take on the persona of that form with a twist of her personality to do some mischievous deeds. The Onee-san personality she takes on in her transformed form is what Natsumi perceives as the perfect image of herself."},{"spoiler":false,"text":"Her Angel Haniel takes the form of a broomstick. Its ability can transform the target into any form Natsumi wants. This can be people, objects, whatever she desires. The angel has a gem on the tip that can turn into a mirror which can entrap anyone inside. Her power can also be used on Haniel itself to mimic another Spirit's Angel and its abilities, but to a lesser degree."},{"spoiler":false,"text":"From Wikipedia and Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c80997"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfbeb410ea57c132afd5e6ea47de3e7896d93d26a80636de08d82694c5590a29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d695b1b98c95eb687e484b4e750addadc828c3fb689611b72422e0dea81c0df.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真野 あゆみ","creatorId":"vndb:s18145","sourcePersonId":"vndb:s18145","canonicalEntityId":"vndb:s18145","name":"真野 あゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80562","source":"vndb"}]},{"characterId":"char_vndb_c80998","characterName":"蓮","sourceIds":{"vndbCharacterId":"c80998"},"originalCharacterName":"蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Born 30 years ago from Phantom hatred but sealed right away by Phantom. She hold grudge to Phantom from what Phantom do to her, that's why she make a wish to her angel Samael to kill Shidou or so what she believe until now. Rinne, Mayuri, Maria, Marina and Rio make her remember what is her first wish to make to Samael, that is to let her meet \"him\""}],"source":"vndb","sourceCharacterId":"c80998"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c536fe9fb0002cfeb548276f37a9542921bb24fe5fb98ee9062fad88fdd18b4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e3e74d862e07b84a508d912d4e457d80c0ebd94b9e6eea4d7932230de7501cf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋 李依","creatorId":"vndb:s10632","sourcePersonId":"vndb:s10632","canonicalEntityId":"vndb:s10632","name":"高橋 李依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80560","source":"vndb"}]},{"characterId":"char_vndb_c81465","characterName":"崇宮 真那","sourceIds":{"vndbCharacterId":"c81465"},"originalCharacterName":"崇宮 真那","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A temporary Second Lieutenant of the AST, Mana works for the DEM Industries based out of England as a Wizard. Revealed to be the biological sister of Shido, she is unable to remember her time with Shido but possesses just a picture which was her only proof that she had a brother."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c81465"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdf476d6c81f256f6e14c3e5a369afa522832be09af9edc8299baf57c8bdee69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2878472bcd1fab6f0b5772333c0940e0e8c2f6d7f5701ece78f58c469525cef2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"味里","creatorId":"vndb:s11254","sourcePersonId":"vndb:s11254","canonicalEntityId":"vndb:s11254","name":"味里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80561","source":"vndb"}]},{"characterId":"char_vndb_c81467","characterName":"殿町 宏人","sourceIds":{"vndbCharacterId":"c81467"},"originalCharacterName":"殿町 宏人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shido's classmate."}],"source":"vndb","sourceCharacterId":"c81467"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6a0e9db4e554ef78e4fc2d99ece6f60ec21f5310e39315f51d5c188e2c9697a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7da78125d4b38408e31f15f7beada8876ea9093db7d2f60d0281496f8675e6e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"勝 杏里","creatorId":"vndb:s4899","sourcePersonId":"vndb:s4899","canonicalEntityId":"vndb:s4899","name":"勝 杏里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80556","source":"vndb"}]},{"characterId":"char_vndb_c81469","characterName":"岡峰 珠恵","sourceIds":{"vndbCharacterId":"c81469"},"originalCharacterName":"岡峰 珠恵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Homeroom teacher for Shido's class, she is called Tama-chan by her students. As she is 29 years old and still single, she is very anxious to get married."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c81469"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b9aa29a7f87c4d8a455415183a652c2f3b756f3b967e4a94a9840b8c5bbc11a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06d9ac59b93c6626cda100867e5328644e075900dd2a8afbaef7bd3b5e3b3469.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐土原 かおり","creatorId":"vndb:s4970","sourcePersonId":"vndb:s4970","canonicalEntityId":"vndb:s4970","name":"佐土原 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80557","source":"vndb"}]},{"characterId":"char_vndb_c84454","characterName":"鳶一 折紙","sourceIds":{"vndbCharacterId":"c84454"},"originalCharacterName":"鳶一 折紙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"r