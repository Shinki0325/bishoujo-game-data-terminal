{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8547","model":{"presentationWorkId":"vndb:v9836","staff":{"artwork":[{"creditedName":"たにはらなつき","creatorId":"vndb:s1779","sourcePersonId":"egs:creator:1634","canonicalEntityId":"vndb:s1779","name":"たにはらなつき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21787","source":"egs"},{"creditedName":"かゆらゆか","creatorId":"vndb:s1211","sourcePersonId":"egs:creator:1913","canonicalEntityId":"vndb:s1211","name":"かゆらゆか","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21789","source":"egs"},{"creditedName":"秋蕎麦","creatorId":"vndb:s1210","sourcePersonId":"egs:creator:1912","canonicalEntityId":"vndb:s1210","name":"秋蕎麦","detail":"ゆんゆん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:29755","source":"egs"}],"scenario":[{"creditedName":"雨野智晴","creatorId":"vndb:s1783","sourcePersonId":"egs:creator:4068","canonicalEntityId":"vndb:s1783","name":"雨野智晴","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21786","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c4049","characterName":"月島 小恋","sourceIds":{"bangumi":[{"characterId":"1210","match":"exact-normalized-name-in-linked-work","subjectId":"3903"}],"egsCharacterIds":["15645"],"vndbCharacterId":"c4049"},"originalCharacterName":"月島 小恋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1111"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Fashion magazines, good fortune telling results"},{"spoiler":false,"text":"Dislikes: Arguing and fighting, bad fortune telling results"},{"spoiler":false,"text":"Koko is Yoshiyuki's childhood friend who is in love with him. But what prevents her to confess her feelings is just her own shyness. Using this trait of hers, her best friends Akane and Anzu love to tease Koko and try to make her look like a pervert. Koko is also a member of the band, along with Nanaka and Wataru. She can play the bass guitar, synthesizer and piano, and has even tried her hand at composing music."}],"source":"vndb","sourceCharacterId":"c4049"},{"segments":[{"spoiler":false,"text":"好きなもの：ファッション雑誌、良い時の占い"},{"spoiler":false,"text":"嫌いなもの：争いごと、悪い時の占い"},{"spoiler":false,"text":"クラス：風見学園付属3年3組"},{"spoiler":false,"text":"「ちょ、ちょっと待って～！　そんなの無理、無理ー～！」"}],"source":"egs","sourceCharacterId":"15645","sourceWorkId":"6353","spoiler":false},{"segments":[{"spoiler":false,"text":"ななかの幼馴染で、義之とも小学校以来同じクラス。"},{"spoiler":false,"text":"軽音楽部に所属。ベースを担当するほか作曲もこなす。"},{"spoiler":false,"text":"「さっさと」という言葉は、小恋流だと「たったと」になる。"},{"spoiler":false,"text":"「ちょ、ちょっと待って～！　そんなの無理、無理ー～！」"}],"source":"egs","sourceCharacterId":"15645","sourceWorkId":"11556","spoiler":false},{"segments":[{"spoiler":false,"text":"【雪月花】"},{"spoiler":false,"text":"義之の幼なじみで恋心をよせるちょっと内気な女の子。"},{"spoiler":false,"text":"軽音楽部に所属している。"},{"spoiler":false,"text":"クラスメイトの杏、茜の様子が気になっているご様子。"},{"spoiler":false,"text":"「そんなことないよ。わたし、ふたりのこと信用してるもん！」"}],"source":"egs","sourceCharacterId":"15645","sourceWorkId":"12105","spoiler":false},{"segments":[{"spoiler":false,"text":"学生時代からの杏の親友で『雪月花三人娘』の月。癒し系。"}],"source":"egs","sourceCharacterId":"15645","sourceWorkId":"25266","spoiler":false},{"segments":[{"spoiler":false,"text":"风见学园附属中学三年三班学生，与义之同班，对义之有好感，为轻音乐社的社员，贝斯手，是把义之暂时拉入轻音乐社的元凶，不坦率，有点胆小，对于义之太过帮助其他女性非常烦恼，不善于表达自己的意见，所以一直跟义之原地踏步。在游戏中除攻略方向外最后选择与涉交往。"}],"source":"bangumi","sourceCharacterId":"1210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22c2f74794d76a0625bc86191a99a15cb976db98a289377307b501835a16e7bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfa03fa2724b414d41ff5a23691c7514749bad7153ab1b59d0de83324bace48b.webp","width":105,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花 あや","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45093","source":"vndb"}]},{"characterId":"char_c4053","characterName":"朝倉 音姫","sourceIds":{"bangumi":[{"characterId":"1189","match":"exact-normalized-name-in-linked-work","subjectId":"19049"},{"characterId":"1189","match":"exact-normalized-name-in-linked-work","subjectId":"19079"},{"characterId":"1189","match":"exact-normalized-name-in-linked-work","subjectId":"3903"}],"egsCharacterIds":["15640"],"vndbCharacterId":"c4053"},"originalCharacterName":"朝倉 音姫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"617"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Wagashi, acting like the ideal older sister"},{"spoiler":false,"text":"Dislikes: Perverted things, ghosts"},{"spoiler":false,"text":"Yume's older sister and non-blood-related older sister of Yoshiyuki. In contrast to the withdrawn and sullen character in her childhood, now Otome has turned into a sweet and caring girl. However, she sometimes switches to the \"moralist mode\" and lectures her carefree brother, but only does so with good intentions."},{"spoiler":false,"text":"Otome is upset of the fact that Yoshiyuki is too shy to take baths with her as they used to when they were younger. The way she sometimes straightens Yoshiyuki's collar in front of others looks more like a wife's care rather than a sister's. Therefore, some funny people never miss a chance to tease them."},{"spoiler":false,"text":"Otome is a proactive and responsible girl, so it's not surprising that she became the head of the Student Council. But in addition to other troubles, a more serious burden will fall on her shoulders. One day, she'll have to make the most difficult and dramatic choice in her life."}],"source":"vndb","sourceCharacterId":"c4053"},{"segments":[{"spoiler":false,"text":"好きなもの：お姉さんぶること、和菓子"},{"spoiler":false,"text":"嫌いなもの：えっちなこと、おばけ"},{"spoiler":false,"text":"クラス：風見学園本校２年３組"},{"spoiler":false,"text":"「生徒会長さんをなめたらダメだよ。弟くんの情報は全部筒抜けだから♪」"}],"source":"egs","sourceCharacterId":"15640","sourceWorkId":"6353","spoiler":false},{"segments":[{"spoiler":false,"text":"完全無欠のお姉ちゃん。"},{"spoiler":false,"text":"成績優秀、容姿端麗、そして風見学園の生徒会長を務める全校生徒憧れの的。"},{"spoiler":false,"text":"ひとつだけ問題があるとすれば、それは弟くんを甘やかしすぎること。"},{"spoiler":false,"text":"でも、本人にはその自覚がまったくなかったり。"}],"source":"egs","sourceCharacterId":"15640","sourceWorkId":"8352","spoiler":false},{"segments":[{"spoiler":false,"text":"由夢の姉。また、義之にとっても姉のような存在。"},{"spoiler":false,"text":"その容姿や誰にでも優しい性格で学園の人気者。"},{"spoiler":false,"text":"特別に義之に対して甘アマで、「弟くん」と呼んでベタベタに可愛がる。"},{"spoiler":false,"text":"「生徒会長さんをなめたらダメだよ。情報は全部筒抜けなんだから♪」"}],"source":"egs","sourceCharacterId":"15640","sourceWorkId":"11556","spoiler":false},{"segments":[{"spoiler":false,"text":"【紫陽花～現代編～】"},{"spoiler":false,"text":"風見学園付属3年。容姿端麗で成績優秀、その上優しい性格と、付属生にしてすでに風見学園生徒会の中心人物でもある。"},{"spoiler":false,"text":"義之のことを弟くんと呼び溺愛するのは相変わらず。"},{"spoiler":false,"text":"「そんなこと考えてるから、最近、お姉ちゃんと一緒にお風呂、入ってくれなくなっちゃったんだね？」"}],"source":"egs","sourceCharacterId":"15640","sourceWorkId":"12105","spoiler":false},{"segments":[{"spoiler":false,"text":"风见学园本部二年三班的学生，也是学生会会长。由梦的姊姊，义之称她为“音姊（おとねえ）”。自小与义之一起生活，故对义之来说有如亲姊一般。"},{"spoiler":false,"text":"动画的回忆：在小时后与义之约定了（无论何时都要在一起）。"},{"spoiler":false,"text":"因为处事冷静、待人公平公正而受全校男女学生欢迎。但义之是唯一的例外，不论场合，音姬都亲昵地以“弟弟（弟くん）”来称呼义之。虽然义之曾经想制止，但每次音姬都一边看着天花板一边看着义之（义之称为“真的不能说‘弟弟’吗？”光线），结果连义之自己也不再制止了。由此可见音姬是一个喜欢撒娇的姊姊。"},{"spoiler":false,"text":"缺点是感情非常丰富，遇到感人的事情就会落泪。"},{"spoiler":false,"text":"非常讨厌色色的事，甚至会叱骂“色情的事情是不可以的！”（接下来是一小时的说教）。义之藏着的色情漫画被音姬发现而全数被烧毁。虽然如此，但自己对这些事却没有自觉，常常对义之做出过份亲昵的行为（这点让由梦非常在意）。"},{"spoiler":false,"text":"自称“正义的魔法使”，从母亲继承了魔法使的身分和力量。与义之和纯一一样，拥有徒手变出和果子的能力，但D.C.II S.C.开始则变为变出洋果子。但非常怕鬼，连说话也会转为悲鸣的语调。非常擅长烹饪，常常与义之做饭。喜欢看时代剧。"},{"spoiler":false,"text":"平常以连身洋装或是长裙为主。"},{"spoiler":false,"text":"在动画中能感觉到有某些事物准备发生，但是无法知道来源而拼命找寻答案。"}],"source":"bangumi","sourceCharacterId":"1189"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2be86c3f7ba0cebb6f7129144b94985bf18e8fda52267915494d48a0e88fafa4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6e119d856286ae4a4f6d0494f6b6726f7255f23848ec721bd74aa289a56b101.webp","width":86,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひなき 藍","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45094","source":"vndb"}]},{"characterId":"char_c4054","characterName":"朝倉 由夢","sourceIds":{"bangumi":[{"characterId":"1190","match":"exact-normalized-name-in-linked-work","subjectId":"19079"},{"characterId":"1190","match":"exact-normalized-name-in-linked-work","subjectId":"3903"}],"egsCharacterIds":["15641"],"vndbCharacterId":"c4054"},"originalCharacterName":"朝倉 由夢","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"102"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Bathing, jerseys"},{"spoiler":false,"text":"Dislikes: Stubborn people, high places"},{"spoiler":false,"text":"Otome's younger sister and non-blood-related younger sister of Yoshiyuki, who looks very much like Nemu in her youth, which isn't surprising, considering that Nemu is her grandmother. As a child, Yume was friendly and cheerful girl, but after growing up she became lazy and grumpy, having inherited a habit of saying \"What a pain in the neck\" from her grandfather, Jun'ichi. However, she acts like that only at home."},{"spoiler":false,"text":"At school, she is popular among the boys. Maybe her character is influenced by the special feelings that she has for her brother, but can't reveal them to him. And the magic cherry tree gave her a special gift, which eats her from the inside."}],"source":"vndb","sourceCharacterId":"c4054"},{"segments":[{"spoiler":false,"text":"好きなもの：お風呂、ジャージ"},{"spoiler":false,"text":"嫌いなもの：しつこい人、高いところ"},{"spoiler":false,"text":"クラス：風見学園付属2年1組"},{"spoiler":false,"text":"「や、こんな恰好どうせ兄さんくらいにしか見ませんから、なんの問題もないよ」"}],"source":"egs","sourceCharacterId":"15641","sourceWorkId":"6353","spoiler":false},{"segments":[{"spoiler":false,"text":"いじっぱりで不器用な妹。"},{"spoiler":false,"text":"家ではぐーたらでだらしなく、外では凛とした姿と二面性を持つ女の子。"},{"spoiler":false,"text":"兄さんのことなんか気にしていませんよ、……といった態度を装いながらも、その本心は……。"}],"source":"egs","sourceCharacterId":"15641","sourceWorkId":"8352","spoiler":false},{"segments":[{"spoiler":false,"text":"音姫の妹。"},{"spoiler":false,"text":"学園では優等生だが、家ではジャージ姿のめんどくさがり屋に。ギャップが激しい。"},{"spoiler":false,"text":"口癖は「かったるい」。主人公のことを「兄さん」と呼ぶ。"},{"spoiler":false,"text":"「や、こんな格好どうせ兄さんくらいにしか見せませんから、何の問題もないよ」"}],"source":"egs","sourceCharacterId":"15641","sourceWorkId":"11556","spoiler":false},{"segments":[{"spoiler":false,"text":"【紫陽花～現代編～】"},{"spoiler":false,"text":"来年、風見学園に入学予定の音姫の妹。"},{"spoiler":false,"text":"義之とは兄妹のような関係で「兄さん」と呼ぶ。"},{"spoiler":false,"text":"不器用で面倒くさがりな性格は来年の風見学園入学までに直るのだろうか？"},{"spoiler":false,"text":"「部屋に着替え取りに行ってからお風呂に入るなんて、めんどくさいでしょ？」"}],"source":"egs","sourceCharacterId":"15641","sourceWorkId":"12105","spoiler":false},{"segments":[{"spoiler":false,"text":"立夏から紹介された風見学園の卒業生。実はとある魔法に詳しいらしい。"}],"source":"egs","sourceCharacterId":"15641","sourceWorkId":"25266","spoiler":false},{"segments":[{"spoiler":false,"text":"风见学园附属中学二年一班学生，为音姬的妹妹，从来没有试过睡梦，因为所谓的“梦”是日后的将来，拥有预知的能力。对于义之也有好感，但是由于自己的个性，所以非常的不坦率，行动模式就有如音梦一样，非常会吃醋，料理的等级跟音梦有过之而无不及，有时也对用暴力解决一切（针对义之），跟音姬算是完全相反的人，称主角义之为“哥哥”（典型的傲娇）。"},{"spoiler":false,"text":"有预知的能力（朝仓家的遗传？）。"},{"spoiler":false,"text":"平常家中穿着为绿色运动服，外出逛街则是短裙（家中与户外穿着完全天差地远）。"}],"source":"bangumi","sourceCharacterId":"1190"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65a84c3a9c861400b3925658323003f79da6a7e0227802455349ffc29ccccabd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80454410d78fe768ec2ca69cedb6244a0dcbeb6e2ecc9c67c831adf27ea0100e.webp","width":110,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きのみ 聖","creatorId":"vndb:s569","sourcePersonId":"vndb:s569","canonicalEntityId":"vndb:s569","name":"春夏 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45095","source":"vndb"}]},{"characterId":"char_c4055","characterName":"杉並","sourceIds":{"bangumi":[{"characterId":"18280","match":"exact-normalized-name-in-linked-work","subjectId":"19079"},{"characterId":"18280","match":"exact-normalized-name-in-linked-work","subjectId":"3903"}],"egsCharacterIds":["21012"],"vndbCharacterId":"c4055"},"originalCharacterName":"杉並","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"4/1"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Suginami is a classmate and one of Yoshiyuki's male friends. However, you can call it a fatal friendship, as Suginami constantly pulls the protagonist to the various kind of troubles, what makes him angry. This mysterious guy is often comes up with some tricks, testing the patience of the Student Council. Suginami has an interest in paranormal phenomena and tries to investigate it. He happens to look and act almost exactly like Suginami from D.C.I."}],"source":"vndb","sourceCharacterId":"c4055"},{"segments":[{"spoiler":false,"text":"好きなもの：『ヌー』、ロマン"},{"spoiler":false,"text":"嫌いなもの：秘密"},{"spoiler":false,"text":"クラス：風見学園付属3年3組"},{"spoiler":false,"text":"「……ふふん、なぁに。想定の範囲内さ」"}],"source":"egs","sourceCharacterId":"21012","sourceWorkId":"6353","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、自称名探偵の悪友。"},{"spoiler":false,"text":"名探偵の名に恥じることがないほど、情報収集能力や推理力に長けているが、傍から見れば突飛な行動や奇抜な言動をすることも多く、学園では近付いていけない人物として認識されている。"}],"source":"egs","sourceCharacterId":"21012","sourceWorkId":"27278","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4395e88409f6acfdc14601031beb7246e0e2fd2548b9a22e6e810210d86d1d73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88a3b78bf78517d2022807e02da4417691a8d61d806ac91210bac980b51952dc.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"空乃 太陽","creatorId":"vndb:s88","sourcePersonId":"vndb:s88","canonicalEntityId":"vndb:s88","name":"岸尾 だいすけ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45091","source":"vndb"}]},{"characterId":"char_c4056","characterName":"板橋 渉","sourceIds":{"bangumi":[{"characterId":"177358","match":"exact-normalized-name-in-linked-work","subjectId":"19079"}],"egsCharacterIds":["26237"],"vndbCharacterId":"c4056"},"originalCharacterName":"板橋 渉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"814"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An idiot, a pervert, and a hopelessly frivolous guy who sometimes participates in Suginami's pranks. At the same time, he is a good friend and classmate of Yoshiyuki. Wataru is always jealous of his popularity with the girls and complains about it pretty often. He is also in a band together with Nanaka and Koko, where he plays the drums. In addition, he is secretly in love with Tsukishima."}],"source":"vndb","sourceCharacterId":"c4056"},{"segments":[{"spoiler":false,"text":"好きなもの：ドラム、Ｈなこと"},{"spoiler":false,"text":"嫌いなもの：テスト"},{"spoiler":false,"text":"クラス：風見学園付属3年3組"},{"spoiler":false,"text":"「いいんだよ。マジメに音楽をやらない奴は俺は嫌いなんだ」"}],"source":"egs","sourceCharacterId":"26237","sourceWorkId":"6353","spoiler":false},{"segments":[{"spoiler":false,"text":"身長／体重：163cm／55kg"},{"spoiler":false,"text":"誕生日：8月14日"},{"spoiler":false,"text":"所属：軽音楽部"},{"spoiler":false,"text":"好きなもの：ドラム、Hなこと"},{"spoiler":false,"text":"嫌いなもの：テスト"},{"spoiler":false,"text":"クラス：風見学園付属3年3組"},{"spoiler":false,"text":"「いいんだよ。マジメに音楽をやらない奴は、俺は嫌いなんだ」"}],"source":"bangumi","sourceCharacterId":"177358"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8511062addc40ba7eb499c56f5ce0d15f0cc1b9bd60cdf33c7a14ead778baf18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24ccba5359de7f1f1f8b661e416173cd1c6f156cfe9779bd923ff6249833a5c3.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福山潤","creatorId":"vndb:s393","sourcePersonId":"vndb:s393","canonicalEntityId":"vndb:s393","name":"福山 潤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:520583:177358:3818:1","source":"bangumi"}]},{"characterId":"char_vndb_c14317","characterName":"咲倉 ゆん","sourceIds":{"vndbCharacterId":"c14317"},"originalCharacterName":"咲倉 ゆん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characte