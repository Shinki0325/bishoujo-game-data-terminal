","source":"vndb"},{"creditedName":"MeeK","creatorId":"vndb:s35139","sourcePersonId":"vndb:s35139","canonicalEntityId":"vndb:s35139","name":"MeeK","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34920","source":"vndb"},{"creditedName":"kanoko","creatorId":"vndb:s43203","sourcePersonId":"vndb:s43203","canonicalEntityId":"vndb:s43203","name":"kanoko","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34921","source":"vndb"},{"creditedName":"あく","creatorId":"vndb:s4117","sourcePersonId":"vndb:s4117","canonicalEntityId":"vndb:s4117","name":"姫ノ木 あく","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34922","source":"vndb"},{"creditedName":"スタジオティンクル","creatorId":"vndb:s7417","sourcePersonId":"vndb:s7417","canonicalEntityId":"vndb:s7417","name":"株式会社キューン・プラント(quunplant)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34923","source":"vndb"}]},"cast":[{"characterId":"char_c10760","characterName":"神岐 すずめ","sourceIds":{"bangumi":[{"characterId":"146664","match":"exact-normalized-name-in-linked-work","subjectId":"99045"}],"egsCharacterIds":["26479"],"vndbCharacterId":"c10760"},"originalCharacterName":"神岐 すずめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An energetic girl and the protagonist's little sister."},{"spoiler":false,"text":"Even though he teases her, she is always clinging to her older brother."},{"spoiler":false,"text":"Despite the fact that she's the same age as her brother, her position is more like that of a younger sister."},{"spoiler":false,"text":"She secretly waits for a chance to counterattack her brother."}],"source":"vndb","sourceCharacterId":"c10760"},{"segments":[{"spoiler":false,"text":"明るく元気いっぱいの主人公の妹様。"},{"spoiler":false,"text":"年齢は兄と同じだけど、立場的には「年下の妹」的な存在。"},{"spoiler":false,"text":"兄からからかわれながらも、なんだかんだでお兄ちゃんにべったり。"},{"spoiler":false,"text":"どうやら彼女は兄への反撃のチャンスを狙っているようだけど……。"}],"source":"egs","sourceCharacterId":"26479","sourceWorkId":"6046","spoiler":false},{"segments":[{"spoiler":false,"text":"元気一杯の女の子で主人公の妹。"},{"spoiler":false,"text":"兄にいじめられながらも、いつも一緒のお兄ちゃんっ娘。"},{"spoiler":false,"text":"兄とは同い年でありながらも、立場的には「年下の妹」的存在。"},{"spoiler":false,"text":"ひそかに兄への反撃のチャンスを狙っている。"}],"source":"bangumi","sourceCharacterId":"146664"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7638548d1b54632446690d3659a9d15c9174c3a541ad97a2a61516a2864e0dd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0da5150f8ad2f7c8d78659017da0e48b01c70942654d717f10c2a467ff6a3f75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤 邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99045:146664:4514:1","source":"bangumi"}]},{"characterId":"char_c10761","characterName":"笠原 智恵理","sourceIds":{"bangumi":[{"characterId":"146668","match":"exact-normalized-name-in-linked-work","subjectId":"99045"}],"egsCharacterIds":["26480"],"vndbCharacterId":"c10761"},"originalCharacterName":"笠原 智恵理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend and next door neighbor."},{"spoiler":false,"text":"She's friendly with him and his sister Suzume and always goes to and from school with them."},{"spoiler":false,"text":"She's clumsy and akward and always seems to be shouldering some misfortune, the type you can't leave alone because they might get in trouble."},{"spoiler":false,"text":"Some years ago her parents died so she lives alone."}],"source":"vndb","sourceCharacterId":"c10761"},{"segments":[{"spoiler":false,"text":"主人公宅のお隣さんで、幼馴染の眼鏡ッ娘。"},{"spoiler":false,"text":"主人公と、その妹“すずめ”と、いつも一緒に登下校する仲良しさん。"},{"spoiler":false,"text":"かなりのドジッ娘で幸が薄く、しょっちゅう不幸な目に合っている彼女。"},{"spoiler":false,"text":"数年前に両親が他界し、身寄りもなく、ひとり暮らしをしている。"}],"source":"egs","sourceCharacterId":"26480","sourceWorkId":"6046","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の一家が桃陽町に引っ越してきて以来のお隣さんで、幼馴染。"},{"spoiler":false,"text":"主人公、すずめとは、いつも一緒に登下校する仲良し関係。"},{"spoiler":false,"text":"ドジで間が悪くいつも不幸を背負い込んでいる。"},{"spoiler":false,"text":"見ていて放っておけなくなる危うさを持つ。"},{"spoiler":false,"text":"何年か前に両親を亡くしており、主人公の隣の家で一人暮らしをしている。"}],"source":"bangumi","sourceCharacterId":"146668"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c03f2c9e0a35c7690bd5f8c8f33316a9bc57909d88c4402b0529d9ebe821c799.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7223472253b3c1bb2c28ee13142213f83849f682cf48fe014b327af14da276f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99045:146668:4463:1","source":"bangumi"}]},{"characterId":"char_c10762","characterName":"神岐 雪来","sourceIds":{"bangumi":[{"characterId":"146669","match":"exact-normalized-name-in-linked-work","subjectId":"99045"}],"egsCharacterIds":["26481"],"vndbCharacterId":"c10762"},"originalCharacterName":"神岐 雪来","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A distant relative of the protagonist who was living at the protagonist's grandfathers house, but because of some circumstance she transfers to a school in the city."},{"spoiler":false,"text":"Because she was raised in the country she isn't used to the crowds and noise of the city."},{"spoiler":false,"text":"A quiet girl who makes you think of a bell ringing."},{"spoiler":false,"text":"She seems to have some of the same memories as the protagonist but..."}],"source":"vndb","sourceCharacterId":"c10762"},{"segments":[{"spoiler":false,"text":"主人公の祖父とともに田舎で暮らしていたが、事情により都心の学校に転校してきた物静かな女の子。"},{"spoiler":false,"text":"田舎育ちの彼女は、都会の喧騒や人込みが苦手。"},{"spoiler":false,"text":"鈴の音が印象的な彼女。"},{"spoiler":false,"text":"いつしか、主人公と同じ記憶を共有するようになるのだが……。"}],"source":"egs","sourceCharacterId":"26481","sourceWorkId":"6046","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の遠縁にあたる。"},{"spoiler":false,"text":"主人公の祖父の家で暮らしていた。事情により都心の学校に転校してくることになる。"},{"spoiler":false,"text":"田舎育ちなこともあり、人混みや騒々しいところを苦手とする。"},{"spoiler":false,"text":"鈴の音が印象に残る、物静かな女の子。"},{"spoiler":false,"text":"主人公とは、同じ記憶を共有するようだが……。"}],"source":"bangumi","sourceCharacterId":"146669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f05b94d5d25c284ae6bbb1511dcc4b56595fbd239f87dfaef58ed45d8c5df1ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cf9551286479a1436d6e4b5379265eb50d30191b0dc6be4bf90f8186fc4fc5b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅野るり","creatorId":"vndb:s1239","sourcePersonId":"vndb:s1239","canonicalEntityId":"vndb:s1239","name":"浅野 るり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99045:146669:3946:1","source":"bangumi"}]},{"characterId":"char_c10763","characterName":"神岐 みあ","sourceIds":{"bangumi":[{"characterId":"146670","match":"exact-normalized-name-in-linked-work","subjectId":"99045"}],"egsCharacterIds":["26482"],"vndbCharacterId":"c10763"},"originalCharacterName":"神岐 みあ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Because of circumstances relating to her parents, she comes to live in the protagonist's home."},{"spoiler":false,"text":"In stark contrast to Setsura, she dislikes quiet places with no people and instead likes lively places."},{"spoiler":false,"text":"She is the type to liven up places that have a solemn mood to them."},{"spoiler":false,"text":"It may not show on her face, but she is delighted to have become part of a new family."},{"spoiler":false,"text":"She doesn't have a complex about her under-developed body and she has an energetic, positive personality."}],"source":"vndb","sourceCharacterId":"c10763"},{"segments":[{"spoiler":false,"text":"大人の事情で主人公の家で引き取ることになった女の子。"},{"spoiler":false,"text":"元気快活で、いつもポジティブシンキング、みんなでワイワイ騒ぐことが大好き。"},{"spoiler":false,"text":"場が沈んでいれば、進んで盛り上げようと振舞うムードメーカー。"},{"spoiler":false,"text":"今回、新しい家族が出来たことが、とても嬉しいようだ。"}],"source":"egs","sourceCharacterId":"26482","sourceWorkId":"6046","spoiler":false},{"segments":[{"spoiler":false,"text":"大人の事情により、主人公の家にやってくることになる。"},{"spoiler":false,"text":"雪来とは対照的で、静かで誰もいない環境を嫌う。"},{"spoiler":false,"text":"にぎやかな場所を好み、場が沈んでいると盛り上げようとするムードメーカー。"},{"spoiler":false,"text":"顔には出さないが、新しい家族が出来て、とても嬉しい様子。"},{"spoiler":false,"text":"未発達な体にコンプレックスを持ったりせず、常に前向きな元気娘。"}],"source":"bangumi","sourceCharacterId":"146670"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13219d9c0342dab3ad8d98865b719783384f66d3f2015cd9bb95aaffbc2c9