{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22902","model":{"presentationWorkId":"vndb:v19682","staff":{"artwork":[{"creditedName":"vogue","creatorId":"vndb:s5228","sourcePersonId":"vndb:s5228","canonicalEntityId":"vndb:s5228","name":"佐藤 茂夫","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:132291","source":"vndb"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c49935","characterName":"柚子崎 碧","sourceIds":{"vndbCharacterId":"c49935"},"originalCharacterName":"柚子崎 碧","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Student Council President"},{"spoiler":false,"text":"The school chairman's granddaughter. Has a gentle and kind personality. Her friendly personality makes her very popular especially to the male students."},{"spoiler":false,"text":"She is very considerate and service minded, so she's loved by the students."},{"spoiler":false,"text":"The teachers also trust her a lot, so she works hard as the student council president."},{"spoiler":false,"text":"She likes black tea, so she frequently visits a specialty store and buys different brands to taste. It's her private recreation time."},{"spoiler":false,"text":"At the student council room, she often brings handmade cakes to serve together with tea for her fellow student council members."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c49935"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fc7916b7eaf67787991e68481a7b35221582691661767a5ae282e43784128f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d5edd6fb534796c591da48c9fb0132119af0d3e4a7258bfd4d1df4af91d290d.webp","width":113,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葵 時緒","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70122","source":"vndb"}]},{"characterId":"char_vndb_c49936","characterName":"栢森 莉乃","sourceIds":{"vndbCharacterId":"c49936"},"originalCharacterName":"栢森 莉乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Student Council Vice President"},{"spoiler":false,"text":"A classmate of the protagonist. She's gentle, kind, and mild mannered."},{"spoiler":false,"text":"She's a very diligent girl, and is the top honor student in her class. Doesn't have much self-assertion, so she's good at untiringly doing favors for others."},{"spoiler":false,"text":"Quite shy, so she's a woman of few words. Her class teacher and friends pushed her to run for student council vice presidency."},{"spoiler":false,"text":"To change her introverted personality even by a little, she endeavors herself in her student council work."},{"spoiler":false,"text":"She likes cooking, so she often makes sweets and brings them to the student council room."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c49936"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1d2aa6f6fb1b6b74641158118625818b2c03be07c09e8313ed1177d8ec9ae4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e84d38a62ec6ab1a2ed04785e6a071fe768672ee0bf4fca15a2da319c3b10e14.webp","width":113,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青井 美海","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70121","source":"vndb"}]},{"characterId":"char_vndb_c49938","characterName":"小美野 由祐葉","sourceIds":{"vndbCharacterId":"c49938"},"originalCharacterName":"小美野 由祐葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Student Council Accountant"},{"spoiler":false,"text":"A bright and cheerful girl who does things assertively. Because she's straightforward and isn't two-faced, she has lots of friends from both genders."},{"spoiler":false,"text":"Not particularly good at her studies, especially Math and English. She usually asks the protagonist to help her with her homework."},{"spoiler":false,"text":"She talks to her friends over the phone for hours. Likes fashion as well."},{"spoiler":false,"text":"Because she always comes to the protagonist for advice, she's treated by him like a little sister."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c49938"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7ddead4e35355a6be1c8d0cc556ed664eecc293615308b576dc5d7d5e310c16d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03225f6d624cfd8e21a3729fe06074eaf61ae33bcfff4dcff1d477f9331f5595.webp","width":107,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷 皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70123","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:4771","sourceCompanyId":"egs:brand:4771","canonicalEntityId":"egs:brand:4771","name":"voguish(VOGUE)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:22902:4771","source":"egs"},{"companyId":"vndb:p6225","sourceCompanyId":"vndb:p6225","canonicalEntityId":"vndb:p6225","name":"Voguish","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:53811:v19682","source":"vndb"},{"companyId":"vndb:p6225","sourceCompanyId":"vndb:p6225","canonicalEntityId":"vndb:p6225","name":"Voguish","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:67828:v19682","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
