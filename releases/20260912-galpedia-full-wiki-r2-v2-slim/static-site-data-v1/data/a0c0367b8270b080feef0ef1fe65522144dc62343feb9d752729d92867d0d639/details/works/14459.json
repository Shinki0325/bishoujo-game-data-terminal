6/f650572c7b9e11077f152d4e682b4109c77d93d8bb9c7de2024b2f01046f3b4e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中美幸","creatorId":"vndb:s3698","sourcePersonId":"vndb:s3698","canonicalEntityId":"vndb:s3698","name":"田中 美幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14234:25452:17076:1","source":"bangumi"}]},{"characterId":"char_c35918","characterName":"フランチェスカ・カルディナーレ","sourceIds":{"bangumi":[{"characterId":"25453","match":"exact-normalized-name-in-linked-work","subjectId":"14234"}],"egsCharacterIds":["11162"],"vndbCharacterId":"c35918"},"originalCharacterName":"フランチェスカ・カルディナーレ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イタリアで一大勢力を誇るマフィア『カルディナーレ・ファミリー』のボスの娘。"},{"spoiler":false,"text":"父親であるボスの命に従い、極堂院家の用心棒をするためにやってくる。"},{"spoiler":false,"text":"凄腕の銃使い（ガンナー）で、二丁の拳銃であらゆるものを蜂の巣にしてしまう。"},{"spoiler":false,"text":"なぜか常に白い鳩を連れている。"}],"source":"egs","sourceCharacterId":"11162","sourceWorkId":"14459","spoiler":false},{"segments":[{"spoiler":false,"text":"直率又酷的笨拙少女。"},{"spoiler":false,"text":"性格总之就是一本正经的，但有时耿直过头显得超迟钝就是了。"},{"spoiler":false,"text":"因为只想着作为一名黑手党以成为BOSS的左右手为目标，所以对恋爱情色事不熟悉。"},{"spoiler":false,"text":"基本是缺乏欲望，因此自己感兴趣的事物很少，不过相应的是对自己喜欢的，不管是事物或人都彻底地执着。"},{"spoiler":false,"text":"对自己认同作为BOSS的人所说的话会绝对服从。"},{"spoiler":false,"text":"「既然是伤害了我的家族，那就要受到应当的惩罚」"}],"source":"bangumi","sourceCharacterId":"25453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3fbecda89ca097bcbbe32e1faaeab5cdb1f6f1e5337bf28b69c15a3b1223500.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/324d9f17de68d3bf97dd469b3ffb1a2a15957d5ab2308a132b4bf0b2acdb66e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅川悠","creatorId":"vndb:s81","sourcePersonId":"vndb:s81","canonicalEntityId":"vndb:s81","name":"浅川 悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14234:25453:3958:1","source":"bangumi"}]},{"characterId":"char_c35919","characterName":"蘇芳院 更紗","sourceIds":{"bangumi":[{"characterId":"25454","match":"exact-normalized-name-in-linked-work","subjectId":"14234"}],"egsCharacterIds":["11163"],"vndbCharacterId":"c35919"},"originalCharacterName":"蘇芳院 更紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"極堂院の分家のひとつ蘇芳院の娘で、悠一とは従妹にあたる（親が母の兄妹）。"},{"spoiler":false,"text":"幼いころから悠一のことを兄のように慕い、懐いている。悠一にとっては可愛い妹のような存在。"},{"spoiler":false,"text":"……しかしその実態は、関東の不良グループや暴走族を実力で仕切る女ヘッド。"},{"spoiler":false,"text":"小柄な身体からは想像もつかないような怪力を発揮する。"},{"spoiler":false,"text":"そのパワーはまさに凄腕。さらに足癖が悪い。"}],"source":"egs","sourceCharacterId":"11163","sourceWorkId":"14459","spoiler":false},{"segments":[{"spoiler":false,"text":"披着羊皮的双马尾萝莉少女。"},{"spoiler":false,"text":"非常冷酷的性格，对手下们是实施着恐怖政治，但唯一对悠一是会放开心怀坦率地撒娇。"},{"spoiler":false,"text":"将来的梦想是当悠一的新娘子。虽然期望着可以组织两人的幸福家庭，但是悠一完全只把她当作妹妹来看待是烦恼根源。"},{"spoiler":false,"text":"「嘿嘿～……能让我这样撒娇的也只有哥哥一人喔」"}],"source":"bangumi","sourceCharacterId":"25454"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a25ef0c7f9544ca21106c40bb5b070355cd0dd50e3abc155112667e1f4454f30.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e85d1deb0fa43bf207d56cb2aecf494cca072b9755dc61f5949e7e34a9f9a16.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14234:25454:4675:1","source":"bangumi"}]},{"characterId":"char_c35920","characterName":"極堂院 朱鷺子","sourceIds":{"bangumi":[{"characterId":"25456","match":"exact-normalized-name-in-linked-work","subjectId":"14234"}],"egsCharacterIds":["11165"],"vndbCharacterId":"c35920"},"originalCharacterName":"極堂院 朱鷺子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悠一の義理の姉で、母亡きあとの極堂院組を執り仕切る、実質的なトップ。"},{"spoiler":false,"text":"弟の悠一を極道の危険な世界には関わらせたくないと考えているため、家の再興には消極的。"},{"spoiler":false,"text":"戦闘力は先代である母仕込み。"},{"spoiler":false,"text":"その強さは朝緋とフランチェスカを同時に相手をしても渡りあえるほどの凄腕。"}],"source":"egs","sourceCharacterId":"11165","sourceWorkId":"14459","spoiler":false},{"segments":[{"spoiler":false,"text":"文静，有偏爱弟弟倾向的义姐。"},{"spoiler":false,"text":"话很少，但说话黑白分明，实质管理着组内事务的是她。"},{"spoiler":false,"text":"但对悠一有过分偏爱的倾向，教给不懂世事的悠一偏离常理的知识。"},{"spoiler":false,"text":"不是直接的，而是为自己这间接的爱苦闷得偏狂了。"},{"spoiler":false,"text":"「既然我已经回来了，那悠一就由我来保护。不需要你们的帮助」"}],"source":"bangumi","sourceCharacterId":"25456"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1be44092ef91182ad3e80edce2665995403c80afcbe5517c99debb35486ea1aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/732eccbccef2461f772c1d3d14b84a6a79f7801632bec76207e41ee7e342bb80.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14234:25456:4937:1","source":"bangumi"}]},{"characterId":"char_c35925","characterName":"極堂院 悠一","sourceIds":{"bangumi":[],"egsCharacterIds":["11166"],"vndbCharacterId":"c35925"},"originalCharacterName":"極堂院 悠一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"極道一家『極堂院一家』の跡取り息子。"},{"spoiler":false,"text":"本人はごく普通の学生で、自分が極道の家系だという認識は薄い。"},{"spoiler":false,"text":"物心つく前に、祖父と交わした『盃』。"},{"spoiler":false,"text":"伝説と呼ばれた祖父との盃の所為で全世界を巻き込んだ跡目争いに巻き込まれていく。"},{"spoiler":false,"text":"極道ヒロイン達との同棲生活でだんだんと「漢気」を開花させていく。"},{"spoiler":false,"text":"母親不在の為、家事全般と料理が得意。"}],"source":"egs","sourceCharacterId":"11166","sourceWorkId":"14459","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19d16df51984c907af63bb4c7b65401205b9224a6cb67a2a8f304e87ad5eb4be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/6152e852a73b11256088f21be6167cb27c5bbb3e8e2d0879d011a3082a05f79d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c35926","characterName":"アメリア・カメリア","sourceIds":{"bangumi":[{"characterId":"25455","match":"exact-normalized-name-in-linked-work","subjectId":"14234"}],"egsCharacterIds":["11164"],"vndbCharacterId":"c35926"},"originalCharacterName":"アメリア・カメリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wears a puppet on her left hand."}],"source":"vndb","sourceCharacterId":"c35926"},{"segments":[{"spoiler":false,"text":"特定の組織には所属せず、一匹狼的に仕事をしている凄腕のヒットマン。"},{"spoiler":false,"text":"極堂院家とはどこか遠いところで血が繋がっているらしい。"},{"spoiler":false,"text":"あらゆる戦闘技術に優れているが、本職は凄腕のスナイパーである。"}],"source":"egs","sourceCharacterId":"11164","sourceWorkId":"14459","spoiler":false},{"segments":[{"spoiler":false,"text":"开朗快活的美国黑帮。"},{"spoiler":false,"text":"如外表一样的开放性格，喜欢亲密接触。"},{"spoiler":false,"text":"喜欢上了的话，就会比用语言先用行动来表达的类型。"},{"spoiler":false,"text":"只是在没带手套布偶的状态就会完全变成了个内向只会说「对不起」的角色。"},{"spoiler":false,"text":"「悠一真的是个好人……嗯嗯，就像是神一样的人！」"}],"source":"bangumi","sourceCharacterId":"25455"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/744b3dded7ec78dbc18c4e8cf0c113e09f9dd221591e815e3a145076e9ae6623.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0eba305eeb2e6268ed58516ee734c44df1f4c14302c5bdf66f34759c36586b7e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14234:25455:5020:1","source":"bangumi"}]},{"characterId":"char_vndb_c35921","characterName":"黄 明梅","sourceIds":{"vndbCharacterId":"c35921"},"originalCharacterName":"黄 明梅","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53d737ba828d9b0ce24383fd0dfa17d3f62299d62fcf33c7b5382ddd3af249fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e11f9fa59d1542d0f3833d109c8b6888b77b6b5f01da7fd68e819d239bd76a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かわしま りの","creatorId":"vndb:s28","sourcePerso