hojo.date/terminal-wiki/v1/characters/v1/images/6c/6cd3b945141b0f728ae2a9f01b6b8c04881034bb532d1002d2fba86961c53783.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井 理子","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13421","source":"vndb"}]},{"characterId":"char_vndb_c59745","characterName":"イリス","sourceIds":{"vndbCharacterId":"c59745"},"originalCharacterName":"イリス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Iris as a teenager"}],"source":"vndb","sourceCharacterId":"c59745"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d79a2b8085b38515bbe3112700aa198c17ef43cf491c7d18338439f9dbfabac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7806a311c524052d48d8ff3f0e5c75d668de2da842fe9b69ca70e7158862c99c.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井 理子","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13422","source":"vndb"}]},{"characterId":"char_vndb_c59795","characterName":"ヨハン","sourceIds":{"vndbCharacterId":"c59795"},"originalCharacterName":"ヨハン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Little Iris chapter."}],"source":"vndb","sourceCharacterId":"c59795"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f37c01719dc3087f68faa9c5ac24ec144333b50a06214edecbf269744c619c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57c957697f9ed15afa691affbefaeb446b31f60d8560126d62f74375c365e971.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山田 亮","creatorId":"vndb:s10042","sourcePersonId":"vndb:s10042","canonicalEntityId":"vndb:s10042","name":"山田 亮","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13424","source":"vndb"}]},{"characterId":"char_vndb_c939","characterName":"佐倉 瀬津美","sourceIds":{"vndbCharacterId":"c939"},"originalCharacterName":"佐倉 瀬津美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age in Narcissu: 22"},{"spoiler":false,"text":"Age in Narcissu Side 2nd: 15"},{"spoiler":false,"text":"Setsumi has a childlike physique. She has a taciturn and stoic kind of personality. She loves cars and is knowledgeable about them. Because of her terminal illness, she has no friends and is always seen alone. After many years of receiving treatment, she became totally desperate about everything - life or time, or each day passing doesn't matter to her anymore. It is just like she stated once: \"My time came to a halt\". Everything is very painful to her because she was left behind alone as the world around her continued to move on."},{"spoiler":false,"text":"In Narcissu, she met Atou Yuu, a new resident of the hospital's 7th floor, the hospice, and for a short moment did she come to know something like hope."},{"spoiler":true,"text":"They escaped together and headed to Awajishima, to watch the beautiful blooming narcissus. Along the way, they grew attached to each other and the girl found herself emotional again, happy with her new skirt, blushing... At the end of their journey, she asked for a bikini, and after a long day of playing at the beach, she went into the sea and ended her very life."},{"spoiler":false,"text":"In Narcissu Side 2nd, when she was still an outpatient at her age of 15, she met a resident of the hospital's 7th floor, one of hospice's patients, called Himeko. Their bond grew quickly as Himeko and Setsumi enjoyed their summer days together."},{"spoiler":false,"text":"Edited from Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c939"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d18ea2711d1d8f535320647cfc1a7bad8f75cb127bac98ca9ea1821e5df4711c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17658a11a43db493bdd09d34617ce272a3a69ec19c984e759876933ce488dde7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾川 りの","creatorId":"vndb:s1054","sourcePersonId":"vndb:s1054","canonicalEntityId":"vndb:s1054","name":"綾川 りの","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13423","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p11","sourceCompanyId":"egs:brand:1351","canonicalEntityId":"vndb:p11","name":"ステージ☆なな","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:12431:1351","source":"egs"},{"companyId":"vndb:p17547","sourceCompanyId":"vndb:p17547","canonicalEntityId":"vndb:p17547","name":"CygnusX74","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:115187:v1542","source":"vndb"},{"companyId":"vndb:p2998","sourceCompanyId":"vndb:p2998","canonicalEntityId":"vndb:p299