{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15928","model":{"presentationWorkId":"egs:15928","staff":{"artwork":[],"scenario":[],"music":[{"creditedName":"ZIZZ STUDIO(ジズスタジオ、ZIZZ)","creatorId":"vndb:s167","sourcePersonId":"egs:creator:2573","canonicalEntityId":"vndb:s167","name":"ZIZZ STUDIO(ジズスタジオ、ZIZZ)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134680","source":"egs"}],"other":[{"creditedName":"虚淵玄","creatorId":"vndb:s1","sourcePersonId":"egs:creator:452","canonicalEntityId":"vndb:s1","name":"虚淵玄","detail":"企画協力・シナリオ監修","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:98267","source":"egs"},{"creditedName":"SHAFT(シャフト)","creatorId":"egs:creator:16089","sourcePersonId":"egs:creator:16089","canonicalEntityId":"egs:creator:16089","name":"SHAFT(シャフト)","detail":"アニメーション制作","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:98268","source":"egs"},{"creditedName":"劇団イヌカレー","creatorId":"egs:creator:16090","sourcePersonId":"egs:creator:16090","canonicalEntityId":"egs:creator:16090","name":"劇団イヌカレー","detail":"デザイン協力","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:98269","source":"egs"}]},"cast":[{"characterId":"char_bangumi_10439","characterName":"鹿目圆香","sourceIds":{"bangumi":[{"characterId":"10439","match":"source-roster","subjectId":"24923"},{"characterId":"10439","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"鹿目圆香","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1003"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"152"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「如果——如果哟，如果有人告诉你，你的任何愿望都可以通过魔法实现，你会怎么办？」"},{"spoiler":false,"text":"一个普通的初二学生，关心朋友，心地善良。"},{"spoiler":false,"text":"「もしも――もしも、だよ？魔法でどんな願い事でも叶えてもらえる、って言われたら、どうする？」"},{"spoiler":false,"text":"どこにでもいる平凡な中学二年生。友達想いで心優しい性格の持ち主。"}],"source":"bangumi","sourceCharacterId":"10439"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"10439","value":"见泷原市"},{"label":"学校","source":"bangumi","sourceCharacterId":"10439","value":"见泷原中学校"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb0aa38b1c13bdfb55b819cab41925ee9fad48d18e6536645cb169d3db0ec075.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b64ca257862286d359d9d81f399d2de1c5f4372d15395b9a65e8048a883d082e.webp","width":211,"height":245,"source":"static-detail"},"actors":[{"creditedName":"悠木碧","creatorId":"vndb:s1321","sourcePersonId":"vndb:s1321","canonicalEntityId":"vndb:s1321","name":"悠木 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10439:5076:1","source":"bangumi"}]},{"characterId":"char_bangumi_10440","characterName":"晓美炎","sourceIds":{"bangumi":[{"characterId":"10440","match":"source-roster","subjectId":"24923"},{"characterId":"10440","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"晓美炎","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「你只要保持你本身的样子就好，像一直以来那样，今后也是。」"},{"spoiler":false,"text":"转学到鹿目圆所在中学的少女。容貌端丽，成绩优秀，运动全能，性格冷静。似乎是魔法少女，但充满谜团。"},{"spoiler":false,"text":"「あなたは、鹿目まどかのままでいればいい。今まで通りに、これからも」"},{"spoiler":false,"text":"まどかの通う中学校に転校してきた少女。容姿端麗、成績優秀、スポーツ万能。クールな性格。魔法少女のようだが、その言動には謎が多い。"}],"source":"bangumi","sourceCharacterId":"10440"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"10440","value":"东京→见泷原市"},{"label":"学校","source":"bangumi","sourceCharacterId":"10440","value":"见泷原中学校"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/600215c85f409b79e878841d40d6e8b6f09e18439b9495774befb832ddff59bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e1bc974227e1c2c87487601c3728ebab939e42372fd6b64d3aec4a597191f9d.webp","width":155,"height":213,"source":"static-detail"},"actors":[{"creditedName":"斎藤千和","creatorId":"vndb:s475","sourcePersonId":"vndb:s475","canonicalEntityId":"vndb:s475","name":"斎藤千和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10440:4249:1","source":"bangumi"}]},{"characterId":"char_bangumi_10441","characterName":"巴 マミ","sourceIds":{"bangumi":[{"characterId":"10441","match":"source-roster","subjectId":"24923"},{"characterId":"10441","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"巴 マミ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「――刚才好危险呢。不过，现在已经没事了」"},{"spoiler":false,"text":"是鹿目圆学校三年级的前辈，像大姐姐一样善于照顾人。与丘比签订契约的现役魔法少女。"},{"spoiler":false,"text":"「已经没什么好害怕的了」"},{"spoiler":false,"text":"「――危なかったわね。でも、もう大丈夫」"},{"spoiler":false,"text":"まどか達の通う中学校の3年生。面倒見の良いお姉さん的存在。キュゥべえと契約した現役の魔法少女。"},{"spoiler":false,"text":"「もう何も怖くない」"}],"source":"bangumi","sourceCharacterId":"10441"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"10441","value":"见泷原市"},{"label":"学校","source":"bangumi","sourceCharacterId":"10441","value":"见泷原中学校"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db1057727bcdb9e29898d18a0b17211a7137e99cb846d97f5fc68244df8e3130.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/326160eab1a4ad9caa9727d12c3a8f007995cdde45d1bf783e23cf5bd75f5b7b.webp","width":195,"height":203,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10441:3851:1","source":"bangumi"}]},{"characterId":"char_bangumi_10445","characterName":"美树沙耶加","sourceIds":{"bangumi":[{"characterId":"10445","match":"source-roster","subjectId":"24923"},{"characterId":"10445","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"美树沙耶加","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「那家伙要是敢来找麻烦，看我不揍飞他。反正还有麻美姐在呢」"},{"spoiler":false,"text":"是鹿目圆的同班同学。性格活泼开朗，和圆是很好的朋友。"},{"spoiler":false,"text":"「あいつが何かちょっかい出してきたら、あたしがぶっとばしてやるからさ。マミさんだってついてるんだし」"},{"spoiler":false,"text":"まどかのクラスメイト。いつも元気で活発な性格で、まどかとは大の仲良し。"}],"source":"bangumi","sourceCharacterId":"10445"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"10445","value":"见泷原市"},{"label":"学校","source":"bangumi","sourceCharacterId":"10445","value":"见泷原中学校"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb49dddc7911d473bb5354a90fa472b927643dbae2a1acb08485f4fecac6247a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca3d1452f6d50e90cad0bf40633a1af2bec9d87abcc32f685cddbb821f0e756e.webp","width":151,"height":239,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10445:4251:1","source":"bangumi"}]},{"characterId":"char_bangumi_10446","characterName":"孵化者","sourceIds":{"bangumi":[{"characterId":"10446","match":"source-roster","subjectId":"24923"},{"characterId":"10446","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"孵化者","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"「和我签订契约，成为魔法少女吧！」"},{"spoiler":false,"text":"可以实现少女的一个愿望的魔法使者。"},{"spoiler":false,"text":"「僕と契約して、魔法少女になってほしいんだ」"},{"spoiler":false,"text":"少女の願い事をひとつだけ叶えてくれる魔法の使者。"},{"spoiler":false,"text":"〴( ◕‿‿◕ )〵"}],"source":"bangumi","sourceCharacterId":"10446"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"10446","value":"Top Sales"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b145e05c867f06a87b0e6cdf48ed4cbbfb7a0daa8cfde77e8f106f82a609cd91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78dd71749a2b8efba44bfdf61f00f5f1af739c5819758dc730d0ced1e5fe5090.webp","width":256,"height":135,"source":"static-detail"},"actors":[{"creditedName":"加藤英美里","creatorId":"vndb:s1190","sourcePersonId":"vndb:s1190","canonicalEntityId":"vndb:s1190","name":"加藤 英美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10446:4850:1","source":"bangumi"}]},{"characterId":"char_bangumi_10672","characterName":"佐倉 杏子","sourceIds":{"bangumi":[{"characterId":"10672","match":"source-roster","subjectId":"24923"},{"characterId":"10672","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"佐倉 杏子","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"14"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「总之，干掉她就行了吧？」"},{"spoiler":false,"text":"觊觎麻美地盘而从其他城市前来的魔法少女。总是吃着零食。不顾周边受损的利己主义者。"},{"spoiler":false,"text":"「要するに、ブッ潰しちゃえばいいんでしょ？」"},{"spoiler":false,"text":"マミの縄張りを狙い、別の町からやってきた魔法少女。いつも何かを食べている。周囲の被害を鑑みない利己主義者。"}],"source":"bangumi","sourceCharacterId":"10672"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"10672","value":"风见野市"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab40d2cf00ecd621d0b7575a0371bb358ddbc5bd2caab217c6ef0b6c6861c240.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52373e4807a3811562e4f4a06c91e7c4b9b724a5b62634ed56dda907c554ab41.webp","width":161,"height":252,"source":"static-detail"},"actors":[{"creditedName":"野中藍","creatorId":"vndb:s1187","sourcePersonId":"vndb:s1187","canonicalEntityId":"vndb:s1187","name":"野中 藍","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10672:4371:1","source":"bangumi"}]},{"characterId":"char_bangumi_10682","characterName":"上條恭介","sourceIds":{"bangumi":[{"characterId":"10682","match":"source-roster","subjectId":"24923"},{"characterId":"10682","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"上條恭介","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美树沙耶香的青梅竹马。原本是一位很有前途的小提琴手，但一场事故让他无法再演奏。被沙耶香所暗恋。"},{"spoiler":false,"text":"さやかの幼馴染。将来有望なヴァイオリン奏者だったが、事故により二度と演奏のできない体となる。さやかの思い人。"}],"source":"bangumi","sourceCharacterId":"10682"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1e36cada71f87749dc59b70621e419892862ec9db077fa57d8b4cdcd020adaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f2bf7e3015da7b1dc51c4bf1080778f9ae99a6a4ea05b383b294cff94ecb61e.webp","width":68,"height":249,"source":"static-detail"},"actors":[{"creditedName":"吉田聖子","creatorId":"vndb:s1323","sourcePersonId":"vndb:s1323","canonicalEntityId":"vndb:s1323","name":"吉田 聖子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10682:4883:1","source":"bangumi"}]},{"characterId":"char_bangumi_10684","characterName":"鹿目詢子","sourceIds":{"bangumi":[{"characterId":"10684","match":"source-roster","subjectId":"24923"}]},"originalCharacterName":"鹿目詢子","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鹿目圆的母亲。她是一位职场女强人，但同时是起床困难户。她和圆的关系很好，能够谈论恋爱话题。"},{"spoiler":false,"text":"まどかの母親。バリバリのキャリアウーマンだが、朝は弱い。まどかとは恋の話をするほど仲良し。"}],"source":"bangumi","sourceCharacterId":"10684"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74bd46dc1a6b32f2730b04e2763b4b86f2d66883fa85bba11b0a74f64ad69af8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b8ec365cf618750c4bba2487d65b98170995ccd06d46e8e158ddb4570d6917d.webp","width":125,"height":197,"source":"static-detail"},"actors":[{"creditedName":"後藤邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10684:4514:1","source":"bangumi"}]},{"characterId":"char_bangumi_10688","characterName":"志筑 仁美","sourceIds":{"bangumi":[{"characterId":"10688","match":"source-roster","subjectId":"24923"},{"characterId":"10688","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"志筑 仁美","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鹿目圆和美树沙耶香的挚友。爱好广泛，包括钢琴、日本舞蹈和茶道，是有钱人家的大小姐。"},{"spoiler":false,"text":"まどか、さやかの親友。ピアノ、日本舞踊、お茶など、多くの習い事をこなす、お金持ちのお嬢様。"}],"source":"bangumi","sourceCharacterId":"10688"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06a850282ba73e8cd1fede1c237c082e02fc87524e3b81a49ce63c11846c6952.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e491e011f90c3cf1764d6d8664658e0a23323ae57a7fc84ae0c80c436b714ab.webp","width":122,"height":173,"source":"static-detail"},"actors":[{"creditedName":"新谷良子","creatorId":"vndb:s3626","sourcePersonId":"vndb:s3626","canonicalEntityId":"vndb:s3626","name":"新谷 良子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10688:4305:1","source":"bangumi"}]},{"characterId":"char_bangumi_10690","characterName":"Tatsuya Kaname","sourceIds":{"bangumi":[{"characterId":"10690","match":"source-roster","subjectId":"24923"}]},"originalCharacterName":"Tatsuya Kaname","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鹿目圆的弟弟，活泼的3岁幼儿园小孩。"},{"spoiler":false,"text":"まどかの弟。幼稚園に通う、元気いっぱいの3歳児。"}],"source":"bangumi","sourceCharacterId":"10690"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/982eead6b1b124f0f1d876836c3d5919f4105739a19ebba108110f83a648fc74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df708ebe29793f9762713c2dd61f9b92942ab34c9c13dd1d3f49b21205e9e4b8.webp","width":101,"height":133,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:10690:3851:1","source":"bangumi"}]},{"characterId":"char_bangumi_12950","characterName":"爱咪","sourceIds":{"bangumi":[{"characterId":"12950","match":"source-roster","subjectId":"24923"}]},"originalCharacterName":"爱咪","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"特典ドラマCD『Memories of you』に登場。ほむらが魔法少女になる前の、まどかと知り合った最初の時間軸で、ほむらが見滝原中学校に初めて登校する途中で出会った黒い野良猫。ほむらが出会う以前からまどかはこの猫のことを知っており、名前はまどかが付けたものである（まどかの飼い猫ではない）。この時間軸ではエイミーがまどかの目の前で車に撥ねられてしまい、まどかが「エイミーを助けてほしい」という願い事で魔法少女の契約を結んだため、元気な姿に戻っている。"},{"spoiler":false,"text":"アニメのオープニングにも姿を見せている。脚本の虚淵は雑誌のインタビューで、「自分はオープニング映像には関わっておらず、黒い猫は制作のシャフトが勝手に描いた物で、本編に関係することはない。しかし、せっかくなので後から作るドラマCDに登場させる考えがある」といった趣旨の発言をしている。"},{"spoiler":false,"text":"なお、まどか役を演じる悠木碧が飼っている黒い猫の名前はエイミーで、オープニングの絵コンテに携わった板村智幸も、悠木からこの猫はうちの猫なのかと尋ねられて肯定したという逸話を披露している。"}],"source":"bangumi","sourceCharacterId":"12950"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5973d9795e42658f7177917d68205e082ce9b9e8c49f9ce60a940aeb82f99e8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b05b2bdbc1f67a2f09a6b269dc1ea1c93caf42ee0355b186966a7666823620c8.webp","width":188,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_22397","characterName":"点心的魔女","sourceIds":{"bangumi":[{"characterId":"22397","match":"source-roster","subjectId":"24923"},{"characterId":"22397","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"点心的魔女","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"零食的魔女。其性质是执着。"},{"spoiler":false,"text":"欲求得到全部。怎么样也不会死心。"},{"spoiler":false,"text":"尽管能无限地制造零食，却独独无法由自身制造最为喜爱的奶酪。若是持有奶酪，大概便能轻易使其露出破绽吧。"},{"spoiler":false,"text":"お菓子の魔女。その性質は執着。"},{"spoiler":false,"text":"欲しいものは全部。絶対に諦めない。"},{"spoiler":false,"text":"お菓子を無限に生み出せるが、大好物のチーズだけは自分で作ることができない。チーズさえ持っていれば簡単に隙をつくことが出来ただろう。"}],"source":"bangumi","sourceCharacterId":"22397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/499d06f261c7b9fb723537b44c7296d0855f7f6cb3b0dd5c29af801ee4645f23.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8dbd28ffa3afdc4f663c61b79746c55aa5d5971842ed76d6d6658c372e42532.webp","width":256,"height":144,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_28115","characterName":"アナウンサー","sourceIds":{"bangumi":[{"characterId":"28115","match":"source-roster","subjectId":"115812"},{"characterId":"28115","match":"source-roster","subjectId":"118566"},{"characterId":"28115","match":"source-roster","subjectId":"24923"},{"characterId":"28115","match":"source-roster","subjectId":"343"},{"characterId":"28115","match":"source-roster","subjectId":"56949"},{"characterId":"28115","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"アナウンサー","characterNameSource":null,"role":"闲角","status":"source-only-candidate","identitySt