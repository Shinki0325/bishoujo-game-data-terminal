racterId":"40696","match":"source-roster","subjectId":"24923"}]},"originalCharacterName":"早乙女 和子","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"30"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鹿目圆的班主任。她和男朋友的恋情都不太长久。"},{"spoiler":false,"text":"まどか達のクラスの担任教師。彼氏とはなかなか長続きしない。"}],"source":"bangumi","sourceCharacterId":"40696"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfb74f507fb8db741d6dc960d4de491f55388ffd99bba2a34bbf886312d8b6f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2728d24ee7ac158ab3bf38aa25810a95ba77cafe162e87f86183397bded3d688.webp","width":102,"height":178,"source":"static-detail"},"actors":[{"creditedName":"岩男潤子","creatorId":"vndb:s1591","sourcePersonId":"vndb:s1591","canonicalEntityId":"vndb:s1591","name":"岩男潤子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:40696:3916:1","source":"bangumi"}]},{"characterId":"char_bangumi_40712","characterName":"なかざわ","sourceIds":{"bangumi":[{"characterId":"40712","match":"source-roster","subjectId":"24923"}]},"originalCharacterName":"なかざわ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"早乙女和子から質問された、最前列のほむらの左隣の席の男子生徒。"}],"source":"bangumi","sourceCharacterId":"40712"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df59da436d4f68b61dae122f00c677b7addb4eb3eed0fbbf031dda24e49f28fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c0561c840f798bbf09a884ed8273854615d8cb85c2af82ca5ad956417f20cbc.webp","width":170,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松岡禎丞","creatorId":"vndb:s748","sourcePersonId":"vndb:s748","canonicalEntityId":"vndb:s748","name":"松岡 禎丞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:40712:5764:1","source":"bangumi"}]},{"characterId":"char_bangumi_72524","characterName":"瓦尔普吉斯之夜","sourceIds":{"bangumi":[{"characterId":"72524","match":"source-roster","subjectId":"24923"},{"characterId":"72524","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"瓦尔普吉斯之夜","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台装置的魔女（通称：魔女之夜 / 本名不明）。其性质是无力。"},{"spoiler":false,"text":"不断回旋的愚者的象征。在历史中被不断传述的谜之魔女。"},{"spoiler":false,"text":"无规律地在世界上徘徊，直到将此世的一切都变成戏曲。"},{"spoiler":false,"text":"当平时处于颠倒位置的人偶转到上部时，就会以暴风般的速度飞行瞬间将地表的文明颠覆。"},{"spoiler":false,"text":"欲消除所有命运的不幸，欲将地上以魔法埋葬，"},{"spoiler":false,"text":"将全人类卷入戏曲中，为此行动的舞台装置。"},{"spoiler":false,"text":"倘若此世间一切皆是戏曲，便不再有什么事值得悲伤。"},{"spoiler":false,"text":"就算那或许会是个悲剧，但也只是按照这样的剧本演出。"},{"spoiler":false,"text":"在魔女之夜，戏剧停止，地球早已连一圈都不再转。"},{"spoiler":false,"text":"故事不再转换。"},{"spoiler":false,"text":"明天、后天，皆是魔女之夜。"},{"spoiler":false,"text":"舞台装置の魔女（通称・ワルプルギスの夜 / 本名不明）。その性質は無力。"},{"spoiler":false,"text":"回り続ける愚者の象徴。歴史の中で語り継がれる謎の魔女。"},{"spoiler":false,"text":"この世の全てを戯曲へ変えてしまうまで無軌道に世界中を回り続ける。"},{"spoiler":false,"text":"普段逆さ位置にある人形が上部へ来た時、暴風の如き速度で飛行し瞬く間に地表の文明をひっくり返してしまう。"},{"spoiler":false,"text":"全ての運命の不幸を無くそうとする、地上をマホウで埋め尽くし、"},{"spoiler":false,"text":"全人類を戯曲の中へ取り込もうとする、動く舞台装置。"},{"spoiler":false,"text":"この世の全てが戯曲ならば悲しい事など何もない。"},{"spoiler":false,"text":"悲劇ではあるかもしれないけれど、ただ、そういう脚本を演じただけ。"},{"spoiler":false,"text":"ワルプルギスの夜で芝居は止まって、もう地球は一周だって回転しない。"},{"spoiler":false,"text":"物語は転換しない。"},{"spoiler":false,"text":"明日も明後日も、ワルプルギスの夜。"}],"source":"bangumi","sourceCharacterId":"72524"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb435da7b35f0814e867290b4deda0463b12cb7dd4f8290ad39509effc07ea62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e67758668b06cdf30bfb648f9524db2fbe91ddd924c2c247f90719177f1f079b.webp","width":219,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_74959","characterName":"佐倉杏子の父","sourceIds":{"bangumi":[{"characterId":"74959","match":"source-roster","subjectId":"24923"}]},"originalCharacterName":"佐倉杏子の父","characterNameSource":null,"role":"闲角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88e3f1ae30a06046fd2727c5288deeca27138c6b0521325d2cec81cb4fa1fed8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6541cafb3d6fa55731f04115d4adc7ca8583cb45637144952069c4d1407a62b.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"銀河万丈","creatorId":"vndb:s9595","sourcePersonId":"vndb:s9595","canonicalEntityId":"vndb:s9595","name":"銀河 万丈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24923:74959:4140:1","source":"bangumi"}]},{"characterId":"char_bangumi_74960","characterName":"佐倉杏子の母","sourceIds":{"bangumi":[{"characterId":"74960","match":"source-roster","subjectId":"24923"}]},"originalCharacterName":"佐倉杏子の母","characterNameSource":null,"role":"闲角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"re