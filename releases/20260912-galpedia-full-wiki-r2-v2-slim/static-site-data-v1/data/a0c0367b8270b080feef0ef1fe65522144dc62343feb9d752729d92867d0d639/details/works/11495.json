tyId":"vndb:s536","name":"EDEN","detail":"監督、演出","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:219969","source":"egs"},{"creditedName":"巫浄スウ","creatorId":"vndb:s644","sourcePersonId":"egs:creator:15520","canonicalEntityId":"vndb:s644","name":"巫浄スウ","detail":"演出","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:219970","source":"egs"},{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74117","source":"egs"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:34113","source":"vndb"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34114","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34115","source":"vndb"},{"creditedName":"チーム・陸ガメ先輩","creatorId":"vndb:s624","sourcePersonId":"vndb:s624","canonicalEntityId":"vndb:s624","name":"チーム・陸ガメ先輩","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34116","source":"vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34119","source":"vndb"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"vndb:s720","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:34121","source":"vndb"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"vndb:s720","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34122","source":"vndb"}]},"cast":[{"characterId":"char_c29641","characterName":"朱雀 夏姫","sourceIds":{"bangumi":[{"characterId":"90377","match":"exact-normalized-name-in-linked-work","subjectId":"43336"}],"egsCharacterIds":["16318"],"vndbCharacterId":"c29641"},"originalCharacterName":"朱雀 夏姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「平案学園」に通う東悟の上級生。水泳部所属。文武両道に優れ、容姿もグラマラスな美人と非の打ち所のない女性。"},{"spoiler":false,"text":"規律を重んじるタイプで、正義感が強い。性格的に少し堅い。いつも凜としていて近寄りがたい高嶺の花。"},{"spoiler":false,"text":"話し方もきついのだが、言葉遣いが時代錯誤な感じなので、これが逆に受けて人気がある。"},{"spoiler":false,"text":"家が空手道場で、本人も本人も空手と四ッ神(よつかみ)流の武術の使い手。"},{"spoiler":false,"text":"東悟と同じ、四ッ神流四家の一つ、朱雀の遺伝子を受け継いでいる。"},{"spoiler":false,"text":"ただ、朱雀の遺伝子は薄れていて、力も昔から比べるとかなり衰えてしまっている。"},{"spoiler":false,"text":"朱雀の遺伝子が絶えてしまうことを恐れた両親に、家の命運は東悟との婚約にかかっていると言われていて、主人公を巡るバトルに参戦する。"},{"spoiler":false,"text":"「放課後には子作りを始めるとしよう。プールに必ず来い、でなければお前を亡きものにする」"}],"source":"egs","sourceCharacterId":"16318","sourceWorkId":"11495","spoiler":false},{"segments":[{"spoiler":false,"text":"文武両道な本編のヒロイン。平案学園に通う東悟の上級生。"},{"spoiler":false,"text":"規律を重んじるタイプで、正義感が強い。いつも凜としていて近寄りがたい高嶺の花。"},{"spoiler":false,"text":"話し方もきついのだが、言葉遣いが時代錯誤な感じなので、これが逆に受けて人気がある。"},{"spoiler":false,"text":"学園では水泳部に所属しているが、家は空手道場を開いていて、本人も空手と四ッ神（よつかみ）流という武術の使い手。"},{"spoiler":false,"text":"前回の平案武術大会では圧倒的な強さで優勝。それ以来その容姿と雰囲気も相まって、周りからは朱雀様と呼ばれている。"},{"spoiler":false,"text":"東悟と同じく四神のひとつ・朱雀の遺伝子を受け継いでいるが、その遺伝子は薄れていて、普通の人間に毛が生えたくらいの武力しかない。"},{"spoiler":false,"text":"両親から東悟と婚約してこいと言い渡され、本人も嫌がることなく、両親の言いつけを守ろうと奮闘することになる。"}],"source":"bangumi","sourceCharacterId":"90377"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a7bc2c9d4b30d652cbed3f2a412c511eec1c3ad11dd3bed13b7b15dfb1a42d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/260e04a6ee4d5d5d3aceb4574bef61a94933e7c278c1dee1f0ecd627dad1a823.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:43336:90377:13773:1","source":"bangumi"}]},{"characterId":"char_c29642","characterName":"白虎 秋葉","sourceIds":{"bangumi":[{"characterId":"90378","match":"exact-normalized-name-in-linked-work","subjectId":"43336"}],"egsCharacterIds":["16319"],"vndbCharacterId":"c29642"},"originalCharacterName":"白虎 秋葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"東悟と同じ平案学園に通う同級生で、東悟に想いを寄せる幼なじみ。"},{"spoiler":false,"text":"お淑やかで地味な感じの女の子。料理上手で尽くすタイプ。"},{"spoiler":false,"text":"しかし、ひとたび怒らせると黒いオーラを纏い、口と手の暴力で相手を叩き潰してしまうという怖い一面も。"},{"spoiler":false,"text":"現在は閉めているが、元は道場の娘。東悟や夏姫同様、四神のうちの一人、白虎の遺伝子を受け継いでいる。武術の強さは夏姫と互角との噂。"},{"spoiler":false,"text":"東悟は想いを寄せている相手なので願ったり叶ったり……といきたいところだが、引っ込み思案な性格が邪魔をして、なかなか上手くアタックできないでいる。"},{"spoiler":false,"text":"学校の中にある「Ｃｕｒｅ」というカフェでアルバイトをしている。。"},{"spoiler":false,"text":"「一番に子供を孕ませて貰うのは……わ、私なんですから！」"}],"source":"egs","sourceCharacterId":"16319","sourceWorkId":"11495","spoiler":false},{"segments":[{"spoiler":false,"text":"本編のヒロイン。東悟と同じ平案学園に通う同級生で、東悟に想いを寄せる幼なじみ。"},{"spoiler":false,"text":"お淑やかで引っ込み思案なところがあるが、料理上手で尽くしてくれるタイプの美少女。"},{"spoiler":false,"text":"学園の中にある『Cure』というカフェでアルバイトをしていて、そこではアイドルとしてマニアックな学生たちから人気がある。"},{"spoiler":false,"text":"しかし、かわいい顔をしてわりと容赦のない性格の持ち主。"},{"spoiler":false,"text":"普段はおとなしいが、怒らせると黒いオーラを発して相手を口と手の暴力で叩き潰してしまうという、恐ろしい一面も持っている。"},{"spoiler":false,"text":"元々家が道場を開いていたが、今は閉めている。夏姫同様、四ッ神流という武術の使い手。"},{"spoiler":false,"text":"その強さは前回優勝者の夏姫と互角という噂で、今大会での優勝候補のひとりとして注目されている。"},{"spoiler":false,"text":"東悟や夏姫同様、四神のひとつ・白虎の遺伝子を受け継いでいる。"},{"spoiler":false,"text":"だがこの家も血が薄れていて、東悟と婚約し、子供を作るよう両親に言われる。"},{"spoiler":false,"text":"想いを寄せる相手なので願ったり叶ったり……なのだが、引っ込み思案な性格が邪魔をして、なかなか上手くアタックできないでいる。"}],"source":"bangumi","sourceCharacterId":"90378"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f9df79751bf970553811923e62a8dd49a4452e5e8fc2c6947ede95886d00264.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d87e803fbd933f989625a02b1958a92da157241f65a27cec3dc79616a33c8ddf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:43336:90378:5075:1","source":"bangumi"}]},{"characterId":"char_c29643","characterName":"玄武 北海","sourceIds":{"bangumi":[{"characterId":"90379","match":"exact-normalized-name-in-linked-work","subjectId":"43336"}],"egsCharacterIds":["16320"],"vndbCharacterId":"c29643"},"originalCharacterName":"玄武 北海","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"東悟と秋葉の同級生にして、同じく平案学園に通う幼なじみ。美少女にしか見えないが、性別は男。"},{"spoiler":false,"text":"女装癖があり、制服もなぜか女子のものを着ている。本人によると心も女子だとか。"},{"spoiler":false,"text":"東悟にぞっこんで、他の男子女子には目もくれない。積極的なアプローチをかける日々。"},{"spoiler":false,"text":"無論、東悟にその趣味はないのでうまくいかない。"},{"spoiler":false,"text":"四ッ神流武術の使い手で四ッ神流四家の一つ、玄武の家の者だが、遺伝子は受け継いではいない。"},{"spoiler":false,"text":"北海の親を最後に、玄武の血はついに絶えてしまった。"},{"spoiler":false,"text":"平案武術大会の実行委員をしている。"},{"spoiler":false,"text":"「ねえねえ東悟君、今日もおべんと一緒に食べよ♪」"}],"source":"egs","sourceCharacterId":"16320","sourceWorkId":"11495","spoiler":false},{"segments":[{"spoiler":false,"text":"東悟と秋葉の同級生にして、同じく平案学園に通う幼なじみ。美少女にしか見えないが、性別は男。"},{"spoiler":false,"text":"顔や体格まで女の子にしか見えない上に、制服も女子のものを着るという女装癖のある男子。"},{"spoiler":false,"text":"女装ばかりでなく、中身（心）も女子だというのは本人の談。"},{"spoiler":false,"text":"東悟にぞっこんで、他の男子女子には目もくれない。普段から東悟を振り向かせようと知恵を絞っているが、東悟にはそっちの趣味はないため上手くいった試しはない。"},{"spoiler":false,"text":"四ッ神流武術の使い手で、四神・玄武の家の者だが遺伝子は受け継いではいない。北海の親を最後に、玄武の血はついに絶えてしまった。"},{"spoiler":false,"text":"平案武術大会の実行委員をしている。"}],"source":"bangumi","sourceCharacterId":"90379"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c29643","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16320","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16320","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"90379","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c560c7b7429a12719fcd2b7ed7e60cde1a69a24c9373f59628b7b90c84782e89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06b3e5536f0fbff1df87fe7e7a96d1a4d1c9db0ffc14ad08b7a6baef9405e439.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:43336:90379:4810:1","source":"bangumi"}]},{"characterId":"char_vndb_c155982","characterName":"青龍 東悟","sourceIds":{"vndbCharacterId":"c155982"},"originalCharacterName":"青龍 東悟","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:1036","sourceCompanyId":"egs:brand:1036","canonicalEntityId":"egs:brand:1036","name":"LiLiTH","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:11495:1036","source":"egs"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:164376:v2350","source":"vndb"},{"companyId":"vndb:p6036","sourceCompanyId":"vndb:p6036","canonicalEntityId":"vndb:p6036","name":"プチチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:164377:v2350","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:18877:v2350","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:5505:v2350","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
