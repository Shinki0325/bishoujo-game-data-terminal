{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20198","model":{"presentationWorkId":"egs:20198","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_156538","characterName":"神崎シオリ","sourceIds":{"bangumi":[{"characterId":"156538","match":"source-roster","subjectId":"92129"}]},"originalCharacterName":"神崎シオリ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"落ちついた性格ながらも、明るさと芯のつよさをもつ女子大生。"},{"spoiler":false,"text":"都会で平穏な暮らしをしていたが、両親を交通事故で亡くし、天涯孤独の身に。"},{"spoiler":false,"text":"両親の面影を求め、二人の故郷と思われる阿座河村へと足を踏み入れた。"},{"spoiler":false,"text":"しかし――幼少期に村にいた痕跡があるのに、その記憶がない。やがてシオリは戸惑いを覚えていく。"}],"source":"bangumi","sourceCharacterId":"156538"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/498fca227b54837c53673a959febcebfbdf2d22d51fca603cb344431e5787533.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fc5b433dbd3cb0802a8e11a8e81e20c55c3967e0a16d18bc83f02e8e0019010.webp","width":95,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156539","characterName":"須賀孝太郎","sourceIds":{"bangumi":[{"characterId":"156539","match":"source-roster","subjectId":"92129"}]},"originalCharacterName":"須賀孝太郎","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"阿座河村の資料館で管理人をしている、不気味な青年。"},{"spoiler":false,"text":"全身黒づくめで表情にとぼしく、いつも模造刀を持ちあるく姿はどこか恐ろしい。しかも、なぜかしゃべらずに、いつも筆談で会話する。"},{"spoiler":false,"text":"幼い頃からシオリの祖父である神崎敬一郎と過ごしてきたらしいが、シオリのことは歓迎せず、むしろ彼女が自由に出歩くことを禁じた。"}],"source":"bangumi","sourceCharacterId":"156539"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff28c4a711b364acdcef9b67c8c715c1f9dea3b42f505e340228e443752c563e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d0263b28568cfb5a19719d8a77c3bb00ec802bebe36f11ab8727a681f55c146.webp","width":67,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156540","characterName":"佐久間美夜子","sourceIds":{"bangumi":[{"characterId":"156540","match":"source-roster","subjectId":"92129"}]},"originalCharacterName":"佐久間美夜子","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"感受性が強く生意気ざかりな、14歳の中学生。"},{"spoiler":false,"text":"感情を表に出す性格なのに、周囲に対して「壁」をきずいており、誰とも打ち解けられない。実はこの阿座河村の有力者の娘なのだが、家にも学校にもなじめず、ひとり資料館に入りびたる毎日を送っていた。"},{"spoiler":false,"text":"そんな彼女が、シオリには本心を打ち明けるようになっていく。だが、そんなある日……。"}],"source":"bangumi","sourceCharacterId":"156540"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53ba51d9582949bd02c3bec8bbd18f4fee9a90635d5340bc12221b07e1de6ac1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8eecd1659c2980eb270527b176657627c0680b50f3082f5dc0aac2d6774963f3.webp","width":93,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156541","characterName":"望月洋介","sourceIds":{"bangumi":[{"characterId":"156541","match":"source-roster","subjectId":"92129"}]},"originalCharacterName":"望月洋介","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"阿座河村の交番にいる、心優しく熱心な巡査。"},{"spoiler":false,"text":"他の地域からやってきたため、まだ土地には詳しくない。学校から逃げだす佐久間の世話を焼いていたりするが、なかなか打ち解けてもらえない。それでもフレンドリーに接して、けっして放っておかないのは、仕事ゆえか彼の性格ゆえか――。"},{"spoiler":false,"text":"霊感はなく、怪奇現象の話はあまりピンと来ない様子。"}],"source":"bangumi","sourceCharacterId":"156541"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01cc6cd384d7339a5295529c818eee512e0f5f28e26f048a21f6656e72d99ad8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86e226efbf6ba04fc0b82dea1f0eae02a96f0e5be29c52ba43e474f7b066075d.webp","width":75,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:4170","sourceCompanyId":"egs:brand:4170","canonicalEntityId":"egs:brand:4170","name":"星屑KRNKRN","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:20198:4170","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
