"vndb","value":"92"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The matriarch of the Sagara family. She is a widow whose husband died shortly after the birth of her fourth daughter, Ruruka. She is mentally strong, having raised four daughters by herself. In terms of personality, she is very open and easygoing."},{"spoiler":false,"text":"She thinks of the main character as her own son, and because of this, she is sometimes very defenseless towards him. She is still very much in love with her late husband."},{"spoiler":false,"text":"Sexually, since the death of her husband, she has been in a state of abstinence, and in reality, she has accumulated quite a lot of sexual desire (although she is not aware of it...)."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c10458"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/238712c92a31730b2d8ea50e5f7c1875c808fb2479a400af821ef02e55c7e3da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9c9bfa0b893a485e9238a6c217ff8d258f9b40e72032c09ae94702beefd911b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MAYU","creatorId":"vndb:s5582","sourcePersonId":"vndb:s5582","canonicalEntityId":"vndb:s5582","name":"MAYU","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:587","source":"vndb"}]},{"characterId":"char_vndb_c11443","characterName":"相楽 るるか","sourceIds":{"vndbCharacterId":"c11443"},"originalCharacterName":"相楽 るるか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"67"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"139"},"hip":{"reviewState":"source-only","source":"vndb","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"source-only","source":"vndb","value":"35"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fourth daughter of the Sagara family. She attends a school in Tokyo. Her personality is generally vivacious. Recently, she is becoming a little more mature."},{"spoiler":false,"text":"She has a keen eye for observation and her way of thinking is a little mature for her age. Basically, she is a child, but not childish."},{"spoiler":false,"text":"Among her sisters (family members), she is the most confident."},{"spoiler":false,"text":"In terms of her appearance, she is still in the process of developing, with her breasts just beginning to grow, but it is easy to imagine that she will become a beautiful girl in the future."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c11443"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcbc7b3afefd748e961121ae94a730f8a18a70e4ff50e055d8e297e548aefe41.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b19fb46db00c3d987041b5214ffe4b9a037fdd3f0f66e173b5ac72292e40500.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大波 こなみ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:583","source":"vndb"}]},{"characterId":"char_vndb_c11444","characterName":"相楽 えみる","sourceIds":{"vndbCharacterId":"c11444"},"originalCharacterName":"相楽 えみる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third daughter of the Sagara family. She is a first-year student at a school in Tokyo. She is frighteningly quiet and reserved, and even when she is standing next to you, you may not be able to tell she is there."},{"spoiler":false,"text":"Although her presence makes her difficult to notice, she is in fact quite a beautiful girl. She has always had a tendency to be shy, but her father's death seems to have made that tendency even stronger."},{"spoiler":false,"text":"However, as she and the main character get to know each other, her expressions change slightly, to the extent that only her sisters can tell."},{"spoiler":true,"text":"She secretly enjoys cosplay but is too afraid to tell anyone about it because she think they will look at her differently."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c11444"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5c96989b154e71d38febe338d5b731b0fa7aa7f00c69fe0d52b06763fd5f998.webp","fallbackUrl":"https://wiki-assets.bishojo.date/termina