n unlike other robots ..."}],"source":"vndb","sourceCharacterId":"c62018"},{"segments":[{"spoiler":false,"text":"ヨコタインダストリアル製の最新型アンドロイドガール。"},{"spoiler":false,"text":"その肌の質感や触り心地は人間のそれと変わらず、性器も忠実に再現。"},{"spoiler":false,"text":"人間とアンドロイドとの識別用として装備された頭部のアンテナ以外は人間の女性とまったく変わらない。"},{"spoiler":false,"text":"脊髄部の電源コネクターに付属コードを差し込み、家庭用電源から充電可能。"},{"spoiler":false,"text":"学習機能により、日常生活だけでなく、性行為のイロハも貪欲に吸収する。"}],"source":"egs","sourceCharacterId":"18070","sourceWorkId":"10925","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"18070","sourceWorkId":"10925","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"18070","sourceWorkId":"10925","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f3d69bfbe7a7176a6bed6c3c651b74847b8cd068a289683ab9ac2f812658704.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5020adfcd1c5c2fdcc9b071246f7eabf1059fc5993f1fc9602afc610e9ab23b1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水純 なな歩","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50644","source":"vndb"}]},{"characterId":"char_vndb_c62019","characterName":"飯田 勝","sourceIds":{"vndbCharacterId":"c62019"},"originalCharacterName":"飯田 勝","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Suguru is the protagonist of the game. He ordered the latest model of android after having a conversation with his boss. Shy and affluent, he spends his free days reading Manga, playing video games, surfing on the net and watching porn. He has had no contact with women for a long time and quickly loses his means. After buying Nanami, Suguru had a hard time coping with such a pretty girl."},{"spoiler":false,"text":"Suguru is quite funny as a character. He doesn't hesitate to ask Nanami to have sex with him from the day of their meeting, but he also doesn't hesitate to try to commit suicide because of his embarrassment by wanting to jump out the window when Nanami viewed his browsing history."}],"source":"vndb","sourceCharacterId":"c62019"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc7b96c0ed1e22074e919a9f7325dad6c2d702b384f5055b2dd30dafd92de89a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/787084269bb730dd654a596da92ed454f1318c90b4e3ecdc35a871e6dbba6d59.webp","width":256,"height":185,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p983","sourceCompanyId":"egs:brand:1771","canonicalEntityId":"vndb:p983","name":"FlyingShine寿","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10925:1771","source":"egs"},{"companyId":"vndb:p983","sourceCompanyId":"vndb:p983","canonicalEntityId":"vndb:p983","name":"FlyingShine寿","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:28354:v11716","source":"vndb"},{"companyId":"vndb:p983","sourceCompanyId":"vndb:p983","canonicalEntityId":"vndb:p983","name":"FlyingShine寿","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:47435:v11716","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
