poiler":false,"text":"てとらの幼馴染の女の子。"},{"spoiler":false,"text":"カワイイ顔してしっかり者。"},{"spoiler":false,"text":"男嫌いだけどてとらのことは"},{"spoiler":false,"text":"そこそこ好き。"},{"spoiler":false,"text":"わかりやすいA型女子。"},{"spoiler":false,"text":"趣味はオセロ。"},{"spoiler":false,"text":"ローラに負けそうになり台をひっくり返したが"},{"spoiler":false,"text":"磁石製のオセロなので意味がなかった。"}],"source":"bangumi","sourceCharacterId":"160817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6599fd1808921683271a109c1e49c08e07284b806b581cd42259243dfe4e65d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/110f3c936967157af5ac970d8568b91e0362d32aae0e048ab2449708a55780d4.webp","width":158,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160818","characterName":"ローラちゃん","sourceIds":{"bangumi":[{"characterId":"160818","match":"source-roster","subjectId":"225259"},{"characterId":"160818","match":"source-roster","subjectId":"502979"}]},"originalCharacterName":"ローラちゃん","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シティのお嬢様。"},{"spoiler":false,"text":"1歳年上なのを良いことに"},{"spoiler":false,"text":"すぐにお姉さんぶろうとする。"},{"spoiler":false,"text":"でもバスト(胸)は貧相。"},{"spoiler":false,"text":"実は漫画が好き。"},{"spoiler":false,"text":"そして、すぐに影響を受けて漫画のマネをする。"},{"spoiler":false,"text":"好きな食べ物は最後に食べるタイプだが"},{"spoiler":false,"text":"大好物の巨大シュークリームを残していたら"},{"spoiler":false,"text":"てとらに食べられてしまった。"},{"spoiler":false,"text":"……死ぬほど悲しかったが、"},{"spoiler":false,"text":"てとらが美味しいと思って食べてくれたのなら"},{"spoiler":false,"text":"良いと思うことにした。"}],"source":"bangumi","sourceCharacterId":"160818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aeec1e4e3