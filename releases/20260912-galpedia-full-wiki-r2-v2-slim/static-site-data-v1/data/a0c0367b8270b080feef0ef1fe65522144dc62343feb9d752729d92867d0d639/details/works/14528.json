人员","identityStatus":"source-native","relationId":"vndb:vn-staff:60853","source":"vndb"},{"creditedName":"黒崎 朔夜","creatorId":"vndb:s5137","sourcePersonId":"vndb:s5137","canonicalEntityId":"vndb:s5137","name":"黒崎 朔夜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:60854","source":"vndb"},{"creditedName":"平瀬 まり","creatorId":"vndb:s52122","sourcePersonId":"vndb:s52122","canonicalEntityId":"vndb:s52122","name":"平瀬 まり","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:60858","source":"vndb"}]},"cast":[{"characterId":"char_c20627","characterName":"淡島 茜","sourceIds":{"bangumi":[{"characterId":"12844","match":"exact-normalized-name-in-linked-work","subjectId":"13602"}],"egsCharacterIds":["11042"],"vndbCharacterId":"c20627"},"originalCharacterName":"淡島 茜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「おかあさん」的存在感のヒロイン・・・なおかつ天然ボケな幼馴染。"},{"spoiler":false,"text":"周囲の人が幸せに、あるいは楽しく暮らせるが第一と考える奥ゆかしい女の子。"},{"spoiler":false,"text":"そのため自分の好みや意思を後回しにしてしまう傾向がある。"},{"spoiler":false,"text":"でも本人はいたって幸せである。"},{"spoiler":false,"text":"そのことを親友である咲に、ときどきそれを指摘されるが、理解不能といった感じで日々、ぽやぽや～とした生活している。"},{"spoiler":false,"text":"まるでお日様のような人間性。"},{"spoiler":false,"text":"ただし、家事、料理に関することは妻の勤めであるという強固な覚悟をもっており、主人公がキッチンにはいってくるとプンプンしだす。"}],"source":"egs","sourceCharacterId":"11042","sourceWorkId":"14528","spoiler":false},{"segments":[{"spoiler":false,"text":"母亲一般的同班同学，天然呆属性的青梅竹马。"},{"spoiler":false,"text":"以周围人们的幸福为第一考量，衷心希望大家快乐的谦逊女孩子。"},{"spoiler":false,"text":"只是因此总是压抑着自己的意愿和想法，虽然本人依旧乐在其中。"},{"spoiler":false,"text":"对于这一点，身为好友的咲总会吐槽她几句，但她还是置若罔闻，每天悠哉悠哉地生活着。"},{"spoiler":false,"text":"一句话，太阳似的家伙。"},{"spoiler":false,"text":"只要和家务、料理扯上，她就会展现身为妻子的强烈执着，要是主人公插手厨房事宜，她立马就撅嘴抗议。"}],"source":"bangumi","sourceCharacterId":"12844"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/208999ecab7ad049c0bb47ddc47ede91e8a066025c4e7c48e6e80b2e742954a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8963e7881b10e51cff9944a968b0e32a2ea1254be96251ddae5e837dfd230419.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13602:12844:5939:1","source":"bangumi"}]},{"characterId":"char_c20628","characterName":"佐渡 咲","sourceIds":{"bangumi":[{"characterId":"12845","match":"exact-normalized-name-in-linked-work","subjectId":"13602"}],"egsCharacterIds":["11043"],"vndbCharacterId":"c20628"},"originalCharacterName":"佐渡 咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いわゆるツンデレなヒロイン。"},{"spoiler":false,"text":"学園のアイドル的存在。"},{"spoiler":false,"text":"茜とは親友である。"},{"spoiler":false,"text":"流行やファッション事柄に詳しいいかにもイマドキな女の子。"},{"spoiler":false,"text":"親友である茜のことを心配しつつも、実は主人公のことも気になっていた。"},{"spoiler":false,"text":"茜の手前自分の恋心に封印していた。"},{"spoiler":false,"text":"ところが、茜が主人公と一夫多妻婚することを知り、自分も嫁にしろと主人公にせまる。"},{"spoiler":false,"text":"いろいろなことを平均以上にこなせる万能タイプだが、コレ！"},{"spoiler":false,"text":"といった得意なことがなく他の奥さんたちに対して、少し引け目を感じることも。"},{"spoiler":false,"text":"実は父親に、結婚を反対されている。"}],"source":"egs","sourceCharacterId":"11043","sourceWorkId":"14528","spoiler":false},{"segments":[{"spoiler":false,"text":"学园偶像般的存在，傲娇双马尾同学。"},{"spoiler":false,"text":"和茜是很要好的朋友，对流行的时兴事物很了解，颇具现代感的女孩子。"},{"spoiler":false,"text":"总是为茜而操心，同时也对主人公相当在意，只是因为有茜在，才压抑着自己的爱恋之意罢了。"},{"spoiler":false,"text":"可是在知道茜已经成为主人公妻子之后，她硬是掺了进来成为妻子。"},{"spoiler":false,"text":"无论什么都有平均以上的水平，可说是万能型天才，只是并没有某一方面的突出特长，结果跟其他妻子比起来反倒显得有些逊色。"}],"source":"bangumi","sourceCharacterId":"12845"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec183181230ab9cfffc84c0598b23b7a79c3e15baff6afe92d794a023b6df225.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66bd0b010396f26c5cda715e91b7ece03e02f4fd2f259e4fe63c117c182af91e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13602:12845:4830:1","source":"bangumi"}]},{"characterId":"char_c20629","characterName":"桜島 萌","sourceIds":{"bangumi":[{"characterId":"12847","match":"exact-normalized-name-in-linked-work","subjectId":"13602"}],"egsCharacterIds":["11045"],"vndbCharacterId":"c20629"},"originalCharacterName":"桜島 萌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の父方の従姉。"},{"spoiler":false,"text":"主人公の会社を実質経営しているキャリアウーマン。"},{"spoiler":false,"text":"主人公の父親の秘書もつとめていた経緯もあり社長職を引き継いだ主人公をサポートしていく。"},{"spoiler":false,"text":"主人公とは子供のころから本当の姉弟のように過ごしてきたが萌自身は昔から主人公のことを好きだった。"},{"spoiler":false,"text":"結婚した後も、自分の部屋に仕事デスクを持ち込み、公私混同してしまうほどのワーカホリックである。"},{"spoiler":false,"text":"家事や自分のプライベートも一応こなそうとするが、どうしても会社の仕事を優先してしまいがちで、自分でもそれをどうにかしないと……と考えているがままならない。"},{"spoiler":false,"text":"ただ私生活に関しては意外に抜けているところもあるおちゃめさん。"}],"source":"egs","sourceCharacterId":"11045","sourceWorkId":"14528","spoiler":false},{"segments":[{"spoiler":false,"text":"实际上公司基本都是由她经营着的，典型的职业女性。"},{"spoiler":false,"text":"家务和自己的私事也处理得头头是道，实在没什么是她办不到的。"},{"spoiler":false,"text":"因为她是主人公父亲的堂姐，也因此两人从小就像姐弟一样。"},{"spoiler":false,"text":"由于本来就是已逝社长的秘书，非常擅长公司的经营管理。"},{"spoiler":false,"text":"哪怕结婚后，她还是把办公桌搬进自己房间努力工作，重度的工作狂。"},{"spoiler":false,"text":"意外的是在个人私生活上挺放得开，难免淘气一番。"}],"source":"bangumi","sourceCharacterId":"12847"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30de3d973a96cd8aabb031e78f8c025ecbf9e6d30d535299b6a7a2ef2889e11b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52d20c19a1eff30357f13308920a127904646e9a3882ae80e0661e07a963d58a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13602:12847:5741:1","source":"bangumi"}]},{"characterId":"char_c20630","characterName":"神島 楓","sourceIds":{"bangumi":[{"characterId":"12846","match":"exact-normalized-name-in-linked-work","subjectId":"13602"}],"egsCharacterIds":["11044"],"vndbCharacterId":"c20630"},"originalCharacterName":"神島 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無表情、寡黙、感情をあまり表にださない少女。"},{"spoiler":false,"text":"主人公の学園の1学年後輩で図書委員。"},{"spoiler":false,"text":"主人公が結婚することを知り自分の秘めた思いを伝え妻にしてもらう。"},{"spoiler":false,"text":"古風な性格でもあり、主人公を旦那様として立てようとする傾向が強い。"},{"spoiler":false,"text":"結婚前は両親を早くに亡くし、祖母にきひとられて育てられていた。"},{"spoiler":false,"text":"それゆえに、生活面でいろいろと遠慮がちな部分もあり、お金のかからない読書を趣味にしていた。"}],"source":"egs","sourceCharacterId":"11044","sourceWorkId":"14528","spoiler":false},{"segments":[{"spoiler":false,"text":"就读于1年级的学妹，也是图书委员。"},{"spoiler":false,"text":"传说中的三无少女。"},{"spoiler":false,"text":"在得知主人公必须结婚之后，她就不再隐瞒地向他表示好感，嫁给了他。"},{"spoiler":false,"text":"为人古朴，把丈夫摆在首位地侍奉着。"},{"spoiler":false,"text":"因双亲早逝，她是由祖母抚养长大的，兴许是这个原因，生活上她总是毕恭毕敬。"},{"spoiler":false,"text":"以不用啥开支的读书为兴趣。"}],"source":"bangumi","sourceCharacterId":"12846"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5056bea82da9e8374bd6df0a982cc2763ba921fa1b1404f1444baa880318166.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e96daf9e8dd81c3063798702f5be090e4865b9a650b74cae778487d5d7480658.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13602:12846:5020:1","source":"bangumi"}]},{"characterId":"char_c20631","characterName":"八丈 椿","sourceIds":{"bangumi":[{"characterId":"12848","match":"exact-normalized-name-in-linked-work","subjectId":"13602"}],"egsCharacterIds":["11046"],"vndbCharacterId":"c20631"},"originalCharacterName":"八丈 椿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Same age as Kaede"}],"source":"vndb","sourceCharacterId":"c20631"},{"segments":[{"spoiler":false,"text":"上から目線でものをいう、大型ネット掲示板にゴロゴロいそうなネットジャンキー。"},{"spoiler":false,"text":"主人公とはネットゲームでいっしょにつるんで遊ぶ仲間。"},{"spoiler":false,"text":"歯に衣着せぬものいいと、物事を俯瞰でとらえる考え方に共感し、主人公としては親友としての付き合いをしている。"},{"spoiler":false,"text":"実は、リアルであったことがなく主人公は椿のことを男だと思っていた。"},{"spoiler":false,"text":"ひょんなことから、結婚の話になり、押しかけ女房として主人公の元に訪れたトラブルメイカー。"},{"spoiler":false,"text":"学園生活になじめず引き篭もりのネオニートとして生活しているが、実はデイトレードなどで莫大な財産をもっている。"}],"source":"egs","sourceCharacterId":"11046","sourceWorkId":"14528","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公在网游上结识的玩家。"},{"spoiler":false,"text":"经常和主人公组团玩网游。"},{"spoiler":false,"text":"因主人公被她那直言不讳的言行和居高临下的态度所折服，从此成了挚友。"},{"spoiler":false,"text":"实际上两人从没有见过面，主人公一直都以为椿是男孩子。"},{"spoiler":false,"text":"无意中聊到一夫多妻的事，结果她立马强硬地以妻子的身份登门拜访，可说是一个麻烦制造者。"},{"spoiler":false,"text":"不喜欢三次元的校园生活，简而言之：NEET。事实上她可是拥有巨大财产的大富翁。"}],"source":"bangumi","sourceCharacterId":"12848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f02052b6571da1da2632b55fc3ebdff1e05a9d78641955b385ca1867da1b6ac9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76d6bd5ff2f3b5af2aac8311a22704db4b8f8cebd3671e045f382591d30e0730.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13602:12848:6166:1","source":"bangumi"}]},{"characterId":"char_vndb_c20632","characterName":"桜島 春木","sourceIds":{"vndbCharacterId":"c20632"},"originalCharacterName":"桜島 春木","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1810","sourceCompanyId":"egs:brand:3088","canonicalEntityId":"vndb:p1810","name":"onomatope*","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14528:3088","source":"egs"},{"companyId":"vndb:p8681","sourceCompanyId":"vndb:p8681","canonicalEntityId":"vndb:p8681","name":"希月学园汉化组","roleCodes":["publisher"],"identityStatus":"source-nativ