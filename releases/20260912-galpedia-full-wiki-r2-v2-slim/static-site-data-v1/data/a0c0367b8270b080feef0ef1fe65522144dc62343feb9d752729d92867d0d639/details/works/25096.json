"25096","spoiler":false},{"segments":[{"spoiler":false,"text":"勝気で高飛車、お転婆だが国と民を想い剣を振るう姫騎士。"},{"spoiler":false,"text":"国民からも親しみを向けられ愛されている。"},{"spoiler":false,"text":"素早く流麗な剣技の持ち主。"}],"source":"bangumi","sourceCharacterId":"53184"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/539f8ab2e3c2d7369ab21765ddfd509de571e779d14a2a7cf9354da4d0bb4aac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0363904e75abc9ef3b0423d4ea0a91fbdf73f7fc7eba5373faa7e2a965189a16.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八ッ橋きなこ","creatorId":"vndb:s353","sourcePersonId":"vndb:s353","canonicalEntityId":"vndb:s353","name":"八ッ橋きなこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212683:53184:16170:1","source":"bangumi"}]},{"characterId":"char_c59930","characterName":"エマ","sourceIds":{"bangumi":[{"characterId":"53185","match":"exact-normalized-name-in-linked-work","subjectId":"212683"}],"egsCharacterIds":["16049"],"vndbCharacterId":"c59930"},"originalCharacterName":"エマ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The most knight-like Princess. She is serious and polite. She will take the high road in order to end any conflict quickly. Due to her immense strength, many people follow her in spite of her strictness."}],"source":"vndb","sourceCharacterId":"c59930"},{"segments":[{"spoiler":false,"text":"真面目で礼節もある生粋の騎士気質な姫騎士。争いを早く終わらせるため覇道を進む。"},{"spoiler":false,"text":"物理的な強さでは無敵を誇る。その強さとカリスマ性で厳しくとも民は率先し従っている。"}],"source":"egs","sourceCharacterId":"16049","sourceWorkId":"25096","spoiler":false},{"segments":[{"spoiler":false,"text":"真面目で礼節を知る生粋の騎士気質な姫騎士。"},{"spoiler":false,"text":"争いを早く終わらせるため覇道を進む。"},{"spoiler":false,"text":"物理的な強さでは無敵を誇る。"},{"spoiler":false,"text":"その強さとカリスマ性で、厳しくとも民は率先し従っている。"}],"source":"bangumi","sourceCharacterId":"53185"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d48ed23f1095581ee2cbdfe4b793e633a4e4923dae6c1e3467203f0a7067d64a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74e80bd0f103313920a76406f2c3b5dc847826c0f0f5324b701aba58420f8f91.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212683:53185:6131:1","source":"bangumi"}]},{"characterId":"char_c59931","characterName":"ロゼッタ","sourceIds":{"bangumi":[{"characterId":"53186","match":"exact-normalized-name-in-linked-work","subjectId":"212683"}],"egsCharacterIds":["16050"],"vndbCharacterId":"c59931"},"originalCharacterName":"ロゼッタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A princess knight with a kind and pure heart, many worship her as a saint. She is a holy knight who excels in healing and support. She dislikes fighting and prefer using her words. She has the inner strength to confront anyone bringing harm to her people."}],"source":"vndb","sourceCharacterId":"c59931"},{"segments":[{"spoiler":false,"text":"優しく清らかな心を持つ姫騎士。人々から聖女として崇拝される。"},{"spoiler":false,"text":"剣より回復、補助魔法を得意とする聖騎士タイプ。争いを好まず話し合いで物事を解決しようとするが、"},{"spoiler":false,"text":"民や神に害をなすものがあれば姫騎士として対峙する芯の強さもある。"}],"source":"egs","sourceCharacterId":"16050","sourceWorkId":"25096","spoiler":false},{"segments":[{"spoiler":false,"text":"優しく清らかな心を持つ姫騎士。人々から聖女として崇拝されている。"},{"spoiler":false,"text":"剣より回復・補助魔法を得意とする聖騎士タイプ。"},{"spoiler":false,"text":"争いを好まず話し合いで物事を解決しようとするが、"},{"spoiler":false,"text":"民や神に害を成すものがあれば姫騎士として対峙する芯の強さもある。"}],"source":"bangumi","sourceCharacterId":"53186"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20883ca01b080187b271f34485b6c6b50a76e04f7c67c1d30317b36c079e47b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13aabe00ec2a25f2a1438161c64c6cb2d552c7aef6c87a1112bb1e7b1408b1ef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212683:53186:5928:1","source":"bangumi"}]},{"characterId":"char_c59932","characterName":"エリザ","sourceIds":{"bangumi":[{"characterId":"53188","match":"exact-normalized-name-in-linked-work","subjectId":"212683"}],"egsCharacterIds":["16051"],"vndbCharacterId":"c59932"},"originalCharacterName":"エリザ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The high elf princess Knight. Calm and proud. She considers herself to be of a superior race to humans and detest them. She carries a sword, but uses it more for magic and the use of the Holy Spirit."}],"source":"vndb","sourceCharacterId":"c59932"},{"segments":[{"spoiler":false,"text":"ハイエルフの姫騎士。冷静沈着で高慢。自分たちを高等種族と自負し人間を下等と見下し、嫌悪をしている。"},{"spoiler":false,"text":"剣を携えているが攻撃魔法や聖霊を使役するための儀礼、術式用。肉体を使うこと自体下等なこと考えている。"}],"source":"egs","sourceCharacterId":"16051","sourceWorkId":"25096","spoiler":false},{"segments":[{"spoiler":false,"text":"ハイエルフの姫騎士。冷静沈着で高慢。"},{"spoiler":false,"text":"自分たちを高等種族と自負し人間を下等と見下し、嫌悪している。"},{"spoiler":false,"text":"剣を携えているが、攻撃魔法や聖霊を使役するための儀礼・術式用。"},{"spoiler":false,"text":"肉体を使うことは下等なことと考えている。"}],"source":"bangumi","sourceCharacterId":"53188"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7ea12c1fe8453db3fc00d321bcfad243b669c579a26f4fd0a57f7363e186c95.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/926b2444052fc6022d76841e50efa733fae40101b8ccd74fb464059705e256c8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212683:53188:20833:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p918","sourceCompanyId":"egs:brand:2797","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25096:2797","source":"egs"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:57961:v20967","source":"vndb"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:57962:v20967","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
