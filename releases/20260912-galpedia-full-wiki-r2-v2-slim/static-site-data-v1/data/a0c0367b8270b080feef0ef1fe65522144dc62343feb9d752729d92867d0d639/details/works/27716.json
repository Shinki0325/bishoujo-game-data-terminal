:"vndb:vn-staff:155589","source":"vndb"},{"creditedName":"浜田 遊歩","creatorId":"vndb:s18788","sourcePersonId":"vndb:s18788","canonicalEntityId":"vndb:s18788","name":"浜田 遊歩","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:155590","source":"vndb"},{"creditedName":"made in harutoshi","creatorId":"vndb:s5350","sourcePersonId":"vndb:s5350","canonicalEntityId":"vndb:s5350","name":"ハルトシ(made in harutoshi)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:155591","source":"vndb"},{"creditedName":"株式会社エモ","creatorId":"vndb:s26674","sourcePersonId":"vndb:s26674","canonicalEntityId":"vndb:s26674","name":"株式会社エモ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:155592","source":"vndb"},{"creditedName":"雨音","creatorId":"vndb:s32714","sourcePersonId":"vndb:s32714","canonicalEntityId":"vndb:s32714","name":"雨音","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:155593","source":"vndb"},{"creditedName":"黒鳥","creatorId":"vndb:s37137","sourcePersonId":"vndb:s37137","canonicalEntityId":"vndb:s37137","name":"黒鳥","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:155594","source":"vndb"}]},"cast":[{"characterId":"char_c82416","characterName":"吉沢 加奈","sourceIds":{"bangumi":[{"characterId":"94200","match":"exact-normalized-name-in-linked-work","subjectId":"279408"}],"egsCharacterIds":["21152"],"vndbCharacterId":"c82416"},"originalCharacterName":"吉沢 加奈","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An ex-Taimanin who left after getting married. Her husband and son do not know of her past."},{"spoiler":false,"text":"She used to be a power type Taimanin. She loves her family more than anything in the world."}],"source":"vndb","sourceCharacterId":"c82416"},{"segments":[{"spoiler":false,"text":"結婚以前は対魔忍として活躍していた。"},{"spoiler":false,"text":"現在の夫である慎吾と恋に落ち交際を経て結婚した事により対魔忍を引退。"},{"spoiler":false,"text":"現在は、ごくごく普通の主婦として生活している。"},{"spoiler":false,"text":"夫や息子は加奈が対魔忍であった事は知らない。"},{"spoiler":false,"text":"悪戯好きの息子に手を焼きながらも、家族と一緒に平穏に暮らせる今の生活に幸せを感じている。"},{"spoiler":false,"text":"夫との性交渉も多くは無いが普通にある。"},{"spoiler":false,"text":"面倒見が良い明るい性格の為、息子の友達からは慕われている。"},{"spoiler":false,"text":"対魔忍時代は強気なパワータイプだった。"},{"spoiler":false,"text":"引退後は戦う必要も無くなった為、現役時代よりは血の気は少なくなっている。"},{"spoiler":false,"text":"元対魔忍だった事もあり正義感は人一倍強い。"},{"spoiler":false,"text":"弱い者を守らなければという使命感は、引退後も持っている。"},{"spoiler":false,"text":"家族であれ他人であれ、誰かが悪い事をした時にはきっちりと叱る事が出来る。"},{"spoiler":false,"text":"家族を何よりも大切で愛しく思っている"}],"source":"egs","sourceCharacterId":"21152","sourceWorkId":"27716","spoiler":false},{"segments":[{"spoiler":false,"text":"与家族三人安稳生活的退役对魔忍"},{"spoiler":false,"text":"因为结婚而退役的原对魔忍。"},{"spoiler":false,"text":"自己的身份对丈夫和儿子都进行了隐瞒。"},{"spoiler":false,"text":"过程普普通通的家庭主妇生活。"},{"spoiler":false,"text":"虽说对喜欢恶作剧的儿子有点头疼，但一家三口平和的日子让她倍感幸福。"},{"spoiler":false,"text":"与丈夫之间的同房不多，属于比较普通的。"},{"spoiler":false,"text":"因为很会照顾人外加性格开朗，受到儿子的朋友的仰慕。"},{"spoiler":false,"text":"是个强硬的力量型对魔忍，在退役后变得不需要战斗了，因此血性有所减弱。"},{"spoiler":false,"text":"因为原来是对魔忍，因此正义感很强。"},{"spoiler":false,"text":"有着守护弱者的使命感，退役之后也一直保持着。"},{"spoiler":false,"text":"不论是家族成员还是外人，只要是做错事情都会去斥责他。"},{"spoiler":false,"text":"无比爱着家族成员。"}],"source":"bangumi","sourceCharacterId":"94200"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e4823ae46ab8e0321b0db4f0956ed50a0f20e607c2d25928c66e6440d0481c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7fdf499611a1d52adb486406ccc2ac28907ab03855df7aa2dc93d64dd623a12.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279408:94200:6351:1","source":"bangumi"}]},{"characterId":"char_c82417","characterName":"杉田 夏鈴","sourceIds":{"bangumi":[{"characterId":"94202","match":"exact-normalized-name-in-linked-work","subjectId":"279408"}],"egsCharacterIds":["21153"],"vndbCharacterId":"c82417"},"originalCharacterName":"杉田 夏鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An active Taimanin who is on the case of missing married ex-Taimanins."},{"spoiler":false,"text":"Highly elite, with a cool and calculated personality and extensive experience."}],"source":"vndb","sourceCharacterId":"c82417"},{"segments":[{"spoiler":false,"text":"現役対魔忍。"},{"spoiler":false,"text":"結婚して引退した元対魔忍達が連続失踪している事件を調査している。"},{"spoiler":false,"text":"元対魔忍達の失踪という難事件を任されるだけあって実力派折り紙付き。"},{"spoiler":false,"text":"どんな危地に陥っても冷静かつ的確に判断して、難事件を解決してきた。"},{"spoiler":false,"text":"また任務への責任感も人一倍強い。"},{"spoiler":false,"text":"その為上層部の信頼も厚い。"},{"spoiler":false,"text":"任務には私情を挟まないクールな性格。"}],"source":"egs","sourceCharacterId":"21153","sourceWorkId":"27716","spoiler":false},{"segments":[{"spoiler":false,"text":"调查连续失踪案件的现役对魔忍"},{"spoiler":false,"text":"现役对魔忍。"},{"spoiler":false,"text":"正在调查结婚后退役的对魔忍连续失踪事件。"},{"spoiler":false,"text":"实力很强而被委以此重任。"},{"spoiler":false,"text":"不论面对何种危险场景，都能进行冷静判断，将各种疑难事件解决，深受高层信赖。"},{"spoiler":false,"text":"责任感很强，在任务中不会夹杂私情，十分帅气。"}],"source":"bangumi","sourceCharacterId":"94202"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0d9a2766fc4ac5505ee3b53b0ca3958def057d155750b39f68c246fac65a30f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e7abdea2166fe73c24e60b579cab86ac0da6a8eb70ad0dfe9a467446a272c84.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279408:94202:6359:1","source":"bangumi"}]},{"characterId":"char_vndb_c82418","characterName":"謎の男","sourceIds":{"vndbCharacterId":"c82418"},"originalCharacterName":"謎の男","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious person who is involved in the disappearance case of former Taimanins"}],"source":"vndb","sourceCharacterId":"c82418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50e5f2b29bbb3eab568212d5bf650cc58946d592e6a04fcd7912ab66bfc08bcc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de748e6d619707bb536f8a61ae16124a2fe1e17bc7e5f3db0721d8a9e644e3c3.webp","width":2