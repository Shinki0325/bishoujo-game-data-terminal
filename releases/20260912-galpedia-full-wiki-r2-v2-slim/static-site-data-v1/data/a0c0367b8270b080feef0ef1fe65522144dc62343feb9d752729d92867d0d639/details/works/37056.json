ext":"From Official site"}],"source":"vndb","sourceCharacterId":"c142219"},{"segments":[{"spoiler":false,"text":"都市伝説「トバコリボックス」を元に、キラザキによって顕現されたヒトガタ。"},{"spoiler":false,"text":"顕現第４号。"},{"spoiler":false,"text":"冴えない小太りの中年男性。"},{"spoiler":false,"text":"いつもニタニタと笑っている。不気味な感じ。"},{"spoiler":false,"text":"自分より弱い者にはとても強い。"},{"spoiler":false,"text":"並外れた呪いの力で女子供をいたぶり、追い詰めるのが好き。"},{"spoiler":false,"text":"冴えない容姿とは裏腹に歩く厄災。"},{"spoiler":false,"text":"地球のすべての女子供を殺して、根絶やしにして、地球を破滅させたい。"},{"spoiler":false,"text":"ボックスはトバコリの武器。"},{"spoiler":false,"text":"トバコリの呪いの能力はボックスを通して発揮される。"},{"spoiler":false,"text":"対象者がトバコリを怖いと思うと呪いの力が発動する。怖いと思わなければ発動しない。"},{"spoiler":false,"text":"ボックスから溢れる黒い靄が対象者が恐れるものに具現化される。"},{"spoiler":false,"text":"「この男に包丁で刺されたらどうしよう」と対象者が思うと、靄は包丁となり、トバコリが手にして対象者を殺すことができる。"}],"source":"egs","sourceCharacterId":"26983","sourceWorkId":"37056","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"26983","sourceWorkId":"37056","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"78 kg","valueContext":null,"source":"egs","sourceCharacterId":"26983","sourceWorkId":"37056","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b51847941b01a9c02f0b678bc68abedb8dc77b9a519381272d23d9aa3fbba52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0046e9337797c28609e17723b582f635735ce0a75cfb5f06e20ac00b7742c444.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夜空 ナガメ","creatorId":"vndb:s37972","sourcePersonId":"vndb:s37972","canonicalEntityId":"vndb:s37972","name":"夜空 ナガメ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98982","source":"vndb"}]},{"characterId":"char_c142220","characterName":"ネクト","sourceIds":{"bangumi":[{"characterId":"189258","match":"exact-normalized-name-in-linked-work","subjectId":"513789"}],"egsCharacterIds":["26984"],"vndbCharacterId":"c142220"},"originalCharacterName":"ネクト","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A humanoid brought into existence by Professor Kirazaki based on urban legends."},{"spoiler":false,"text":"He is pure and innocent, and does not realize that he is a humanoid."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c142220"},{"segments":[{"spoiler":false,"text":"都市伝説「クニャクニャ」を元に、キラザキによって顕現されたヒトガタ。"},{"spoiler":false,"text":"顕現第３号。"},{"spoiler":false,"text":"主人公と同い年。"},{"spoiler":false,"text":"何を見ても「これは何？」と、無垢な赤ちゃんのような感じ。"},{"spoiler":false,"text":"ネクト自身、自分がヒトガタとはわかっていない。"},{"spoiler":false,"text":"周囲も気づかず、みんな仲良しになる。"},{"spoiler":false,"text":"刷り込みのような感覚で、主人公のことはなんでも真似をする。"},{"spoiler":false,"text":"交流していくうちに、「主人公が好きな来夢」を好きになるネクト。"}],"source":"egs","sourceCharacterId":"26984","sourceWorkId":"37056","spoiler":false},{"segments":[{"spoiler":false,"text":"\"以都市传说「扭来扭去」为原型，经绮拉崎之手显现的拟人体。"},{"spoiler":false,"text":"显现第3号。"},{"spoiler":false,"text":"无论看到什么都会好奇询问道「这是什么？」，宛若无邪的婴儿。"},{"spoiler":false,"text":"涅克特本人对自己是拟人体的事实一无所知，在周围人也未曾察觉的情况下和众人打成一片。"},{"spoiler":false,"text":"仿效主人公的所有行为，随着交流渐深，也喜欢上了主人公倾心的来梦。"},{"spoiler":false,"text":"「名字吗...该如何是好呢...嗯~...那，我就叫......涅克特，嗯，涅克特。就叫涅克特吧」\""}],"source":"bangumi","sourceCharacterId":"189258"}],"profileFacts":[{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"26984","sourceWorkId":"37056","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"26984","sourceWorkId":"37056","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbdbdbd1de80ee90669bdb42481a446d5a1ad1f9122d7d251bab90e94d721370.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8329c9c5e354a23f6ba7aceaeb238c55375ca2de5f0212f3d4de5985b9c8149a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐村まり","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:513789:189258:23768:1","source":"bangumi"}]},{"characterId":"char_c142221","characterName":"メリィ・メィリィ","sourceIds":{"bangumi":[{"characterId":"189259","match":"exact-normalized-name-in-linked-work","subjectId":"513789"}],"egsCharacterIds":["26985"],"vndbCharacterId":"c142221"},"originalCharacterName":"メリィ・メィリィ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A humanoid brought into existence by Professor Kirazaki based on urban legends."},{"spoiler":false,"text":"He is deeply compassionate and caring, always looking out for others."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c142221"},{"segments":[{"spoiler":false,"text":"都市伝説「メリィの電話」を元に、キラザキによって顕現されたヒトガタ。"},{"spoiler":false,"text":"顕現第５号。"},{"spoiler":false,"text":"情が深く、面倒見の良いオネエ。"},{"spoiler":false,"text":"女言葉で喋る。"},{"spoiler":false,"text":"性別関係なく可愛い子が大好き。"},{"spoiler":false,"text":"可愛いと思う気持ちが限界突破すると無茶苦茶にしたくなり、実際に加害を加えてしまう。"},{"spoiler":false,"text":"来夢と主人公をとても可愛いと思っている。"},{"spoiler":false,"text":"地球征服には興味がない。可愛いと思う子をさらっては可愛がりたい。だが可愛がりすぎて殺してしまう。"},{"spoiler":false,"text":"自分の好みの子を集めてハーレムを作りたいが、地球人はすぐ死んでしまうので、人数が集まらないのが悩みのタネ。"}],"source":"egs","sourceCharacterId":"26985","sourceWorkId":"37056","spoiler":false},{"segments":[{"spoiler":false,"text":"\"以都市传说「玛莉的电话」为原型，经绮拉崎之手显现的拟人体。"},{"spoiler":false,"text":"显现第5号。"},{"spoiler":false,"text":"深情厚谊、为人体贴的男大姐。喜欢可爱的孩子且无关性别。"},{"spoiler":false,"text":"当疼爱对方的心意太过强烈时就会做出无可挽回之事，造成实质上的伤害。此外也认为来梦和主人公十分可爱。"},{"spoiler":false,"text":"渴望收集自己喜欢的孩子并组成后宫，但因地球人的生命太过脆弱而一直无法凑齐人数，为此倍感苦恼。"},{"spoiler":false,"text":"「嗨，我是玛莉・梅里，就在你背后。」\""}],"source":"bangumi","sourceCharacterId":"189259"}],"profileFacts":[{"label":"身高（本版本）","value":"180 cm","valueContext":null,"source":"egs","sourceCharacterId":"26985","sourceWorkId":"37056","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"65 kg","valueContext":null,"source":"egs","sourceCharacterId":"26985","sourceWorkId":"37056","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf542584c48ee16642bc50f94d506f6791d2061c09701786138ed7a93b11e8f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66c775393307b0cf216b510c04074545c69f5223e27990e6d33b48ce8afc150e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:513789:189259:6131:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p281","sourceCompanyId":"egs:brand:322","canonicalEntityId":"vndb:p281","name":"LiLiM","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:37056:322","source":"egs"},{"companyId":"vndb:p281","sourceCompanyId":"vndb:p281","canonicalEntityId":"vndb:p281