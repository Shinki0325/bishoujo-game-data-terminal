{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18046","model":{"presentationWorkId":"vndb:v11992","staff":{"artwork":[{"creditedName":"あいのせりん","creatorId":"vndb:s8376","sourcePersonId":"egs:creator:14174","canonicalEntityId":"vndb:s8376","name":"あいのせりん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:113419","source":"egs"}],"scenario":[{"creditedName":"草刈元","creatorId":"vndb:s5643","sourcePersonId":"egs:creator:15124","canonicalEntityId":"vndb:s5643","name":"草刈元","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:113420","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c44935","characterName":"篠宮 柚香","sourceIds":{"bangumi":[{"characterId":"57045","match":"exact-normalized-name-in-linked-work","subjectId":"222843"}],"egsCharacterIds":["548"],"vndbCharacterId":"c44935"},"originalCharacterName":"篠宮 柚香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An innocent housewife with a cute face and nice body. She used to work in the same company as the protagonist, through that affinity she started dating and marry the protagonist. While she was still working in the company, she has been acquainted with Ryuichi before her marriage with Hiroaki. She is a secret fan of Ryuichi's written articles."}],"source":"vndb","sourceCharacterId":"c44935"},{"segments":[{"spoiler":false,"text":"可愛い顔の割にナイスバディな肉体を持つ無邪気な奥さん。"},{"spoiler":false,"text":"かつては主人公と同じ会社に勤めており、その縁で主人公と付き合い結婚することに。"},{"spoiler":false,"text":"また会社の仕事繋がりで隆一とも宏明との結婚前から面識がある。"},{"spoiler":false,"text":"隆一の書く記事の密かなファンだったりする。"}],"source":"egs","sourceCharacterId":"548","sourceWorkId":"18046","spoiler":false},