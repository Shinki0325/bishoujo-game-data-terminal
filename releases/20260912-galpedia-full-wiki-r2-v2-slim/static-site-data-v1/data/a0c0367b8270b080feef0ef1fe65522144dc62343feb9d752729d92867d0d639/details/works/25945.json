tityId":"vndb:s37458","name":"二句トミィ","detail":"スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:244191","source":"egs"},{"creditedName":"U3","creatorId":"egs:creator:37603","sourcePersonId":"egs:creator:37603","canonicalEntityId":"egs:creator:37603","name":"U3","detail":"スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:244192","source":"egs"},{"creditedName":"茶坊主","creatorId":"egs:creator:37580","sourcePersonId":"egs:creator:37580","canonicalEntityId":"egs:creator:37580","name":"茶坊主","detail":"音声データ","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:244193","source":"egs"},{"creditedName":"へび","creatorId":"vndb:s37459","sourcePersonId":"egs:creator:37605","canonicalEntityId":"vndb:s37459","name":"へび","detail":"制作補助","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:244194","source":"egs"},{"creditedName":"片霧 烈火","creatorId":"vndb:s419","sourcePersonId":"vndb:s419","canonicalEntityId":"vndb:s419","name":"片霧 烈火","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:140635","source":"vndb"},{"creditedName":"神月 社","creatorId":"vndb:s4003","sourcePersonId":"vndb:s4003","canonicalEntityId":"vndb:s4003","name":"神月 社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:140637","source":"vndb"},{"creditedName":"金山 じゅん","creatorId":"vndb:s21693","sourcePersonId":"vndb:s21693","canonicalEntityId":"vndb:s21693","name":"金山 じゅん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:140640","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c155886","characterName":"成嶋清真","sourceIds":{"vndbCharacterId":"c155886"},"originalCharacterName":"成嶋清真","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eldest of Ayako’s twin brothers, a detective with the Metropolitan Police Department. Married with five-year-old twin sons. Honest, hot-blooded, and driven by a strong sense of justice, he is very fond of his younger sister. He also worries deeply about his twin brother Renji, whose personality changed completely after the war and whose life has since fallen into disorder."},{"spoiler":false,"text":"\"You really are just a kid. Can’t you say something with a bit more charm?\""},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c155886"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"機知 通","creatorId":"vndb:s35","sourcePersonId":"vndb:s35","canonicalEntityId":"vndb:s35","name":"岡崎 雅紘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74325","source":"vndb"}]},{"characterId":"char_vndb_c155887","characterName":"成嶋廉次","sourceIds":{"vndbCharacterId":"c155887"},"originalCharacterName":"成嶋廉次","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayako’s second eldest brother. Though he is Seimasa’s twin, his lazy, irresponsible demeanor makes him seem like a completely different person. Once an excellent student with a promising future, he injured one eye during the war, leading to mental instability and a drastic change in personality. He has since moved out and now works as a revue manager in Shinjuku, though there are hints he may be involved in shady dealings. He loves his sister but avoids her, knowing how far he has fallen."},{"spoiler":false,"text":"\"You’re still not interested in love and romance, and you’re dependable enough as it is.\""},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c155887"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"深川 緑","creatorId":"vndb:s5570","sourcePersonId":"vndb:s5570","canonicalEntityId":"vndb:s5570","name":"北山 恭祐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74330","source":"vndb"}]},{"characterId":"char_vndb_c64781","characterName":"成嶋 綾子","sourceIds":{"vndbCharacterId":"c64781"},"originalCharacterName":"成嶋 綾子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1022"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only daughter of a sweets shop in Asakusa. Having worked hard to earn her qualifications, she now works as a typist in Marunouchi. She has a strong desire to help her father, who single-handedly runs their small shop through sheer perseverance. Independent, serious, and reliable, she has no interest whatsoever in romance or marriage, and believes she could live her entire life single without regret. Her mother died in the Great Kantō Earthquake, leaving her to live alone with her father. She has twin brothers seven years older than her: the elder twin is married, and the younger has also moved out."},{"spoiler":false,"text":"\"I’m sure I’m just not someone who can fall in love with anyone.\""},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c64781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcfd0c114835c20bd562afa5b63a8fa5e48394e4a1d7e84b519832fe23eddea4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7355bb9b07033e82732f8075dea5660bdf7d19986c09abc8e316d135d7f3d759.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64782","characterName":"蒲生 龍彦","sourceIds":{"vndbCharacterId":"c64782"},"originalCharacterName":"蒲生 龍彦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"924"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The lawyer."},{"spoiler":false,"text":"Despite his youth, he already runs his own private law office and is considered a capable, ambitious man. In business, he maintains a smart, professional demeanor, but having climbed the ranks so young, he is confident, forceful, persuasive, and rather smooth-talking. He is also quite self-assured. Rumor has it he has considerable experience in romance and is well-versed in dealing with women. After graduating from the Imperial University and obtaining his law license, he opened his private office in Yanaka, Tokyo. He serves as the executor of the current inheritance case, sending the letter to the heroine at the instruction of his client, the late Onuma."},{"spoiler":false,"text":"\"You’ll see right away… from the very start, you were mine.\""},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c64782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ecdbb0220db74204e10abf25b40b0afac1e22e1170478075be4a24fb6e277b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c3797de2642b115d193f7d6e22a6fdfdd4d9592d2aaec6fc1d023000ab68c49.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳩マン 軍曹","creatorId":"vndb:s1351","sourcePersonId":"vndb:s1351","canonicalEntityId":"vndb:s1351","name":"川原 慶久","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74329","source":"vndb"}]},{"characterId":"char_vndb_c64783","characterName":"佐伯 潤一","sourceIds":{"vndbCharacterId":"c64783"},"originalCharacterName":"佐伯 潤一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"birthday":{"reviewState":"source-only","source":"vndb","value":"216"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The doctor."},{"spoiler":false,"text":"A childhood friend of the heroine Ayako, living in her neighborhood and a former classmate of her brother. Sincere and gentle-natured, he used to play with Ayako often when they were children, calling each other “Jun-kun” and “Ayako-chan.” He now works as a surgeon, though his specialty is psychiatry. After graduating from a medical university in Hakata, he was assigned to the Imperial University Hospital in Nezu, recently returning to Tokyo."},{"spoiler":false,"text":"\"Don’t worry about it. Just be yourself—that’s all that matters.\""},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c64783"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dea896c50289f9d46832718773e808c5ffef14fc88348d204197ffbd50ca59a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f76e3e0d586e826e0e9d200acb0e4d014d7f298c55884ef247a986af0b74c929.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河村 眞人","creatorId":"vndb:s457","sourcePersonId":"vndb:s457","canonicalEntityId":"vndb:s457","name":"山中 真尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74327","source":"vndb"}]},{"characterId":"char_vndb_c64784","characterName":"巽","sourceIds":{"vndbCharacterId":"c64784"},"originalCharacterName":"巽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"birthday":{"reviewState":"source-only","source":"vndb","value":"101"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A native of the Kingdom of Sarawak in Southeast Asia. Because his grandfather was Japanese, he can speak the language. He is pure and entirely untouched by malice or corruption. Since Sarawakians have no family names, his grandfather gave him a Japanese-style name that could be used as either a surname or a given name."},{"spoiler":false,"text":"\"I’m very happy to meet you.\""},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c64784"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b7e3e182b7a4a6231702e1e19e3c4e14a58f758fe944fac372a9336ea993e6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e012f24adda967ef8528105f214c819e82d52e8a15ffcb4f356bee295cb1f3b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やじま のぼる","creatorId":"vndb:s4816","sourcePersonId":"vndb:s4816","canonicalEntityId":"vndb:s4816","name":"やじまのぼる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74331","source":"vndb"}]},{"characterId":"char_vndb_c64785","characterName":"松ヶ枝 史弥","sourceIds":{"vndbCharacterId":"c64785"},"originalCharacterName":"松ヶ枝 史弥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"602"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The talented young scholar."},{"spoiler":false,"text":"Brilliant since childhood, he entered the Imperial University without difficulty, a beautiful youth blessed with both brains and looks. Extremely shy and reserved, his gentle nature and striking appearance make him liked by everyone. Well-versed in economics and gifted at reading the markets, he dabbles in stock trading as a hobby."},{"spoiler":false,"text":"\"I’m still inexperienced, but I’d be delighted if we could get along.\""},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c64785"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5c31ce064619daff8587b201665640b07e28fcd5a0d85b84498db5961a321b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/i