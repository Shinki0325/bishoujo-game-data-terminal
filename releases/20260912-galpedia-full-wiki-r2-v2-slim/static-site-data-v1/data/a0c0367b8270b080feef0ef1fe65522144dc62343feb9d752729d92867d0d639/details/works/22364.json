ePersonId":"vndb:s14543","canonicalEntityId":"vndb:s14543","name":"樋口誠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108916","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c26354","characterName":"オルフェ","sourceIds":{"vndbCharacterId":"c26354"},"originalCharacterName":"オルフェ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"302"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Knight of the West country Œillet."},{"spoiler":false,"text":"Born as a orphan, he travelled the land as a minstrel."},{"spoiler":false,"text":"He has a bright attitude with a little bit of mischievousness."},{"spoiler":false,"text":"He is very friendly, but on the inside he has a side of loneliness"},{"spoiler":false,"text":"His mansion is surrounded by nature and a beautiful lake. The living room is lined with plants and a stylish round window. All in all a refreshing"},{"spoiler":false,"text":"from cannonette"}],"source":"vndb","sourceCharacterId":"c26354"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14fe5ed94ca3f813a6bbed04def04a30b22bdfb7275c8515b3a2bcc62eb0622d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7511cb82cad0b5eec6b3b2f2c977d18db93efb8ed0834259a86117cfdbe9ce99.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"KENN","creatorId":"vndb:s372","sourcePersonId":"vndb:s372","canonicalEntityId":"vndb:s372","name":"KENN","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58374","source":"vndb"}]},{"characterId":"char_vndb_c26355","characterName":"レオン","sourceIds":{"vndbCharacterId":"c26355"},"originalCharacterName":"レオン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"804"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A knight from Pivoine. He acts recklessly according to his feelings and, although he is a noble, he acts without restraint and gives himself up to self-indulgent pleasures. He fell in love at first sight with a portrait of the heroine that he saw by chance. He became one of the chosen knights after forcibly stealing the position from the original knight."},{"spoiler":false,"text":"His mansion is impressive and the walls are the color of red bricks. The living room is decorated with glittering gold ornaments and suits his noble"}],"source":"vndb","sourceCharacterId":"c26355"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f76a3cb4dbc1509a79871ad9af9fdb00aa63df0494b7bd3cec4b44067b7005b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee800f4ca975823442ac552890e645e80c75c9f21f30391008ca24de3b98270d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"興津 和幸","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58371","source":"vndb"}]},{"characterId":"char_vndb_c26356","characterName":"ルイ","sourceIds":{"vndbCharacterId":"c26356"},"originalCharacterName":"ルイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"211"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A knight from Campanule. He was born as an illegitimate prince and lives as he pleases; he is a man with a calm atmosphere. At first glance, he is the embodiment of a charming \"ideal prince\" but inside and away from the surface there is a part of him drowning in deep weariness."},{"spoiler":false,"text":"His mansion has an enormous garden at the front of it. The living room is lined with delicate details."},{"spoiler":false,"text":"from otome-jikan"}],"source":"vndb","sourceCharacterId":"c26356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2668a9a1b529f4bc03e13f38c27b9c07469fdccdb9a67346d9b4a6e298dc569.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/436c93981cb30308216364f352eea8d95b3ee577cf8178c5f1b249689301e00a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浪川 大輔","creatorId":"vndb:s135","sourcePersonId":"vndb:s135","canonicalEntityId":"vndb:s135","name":"浪川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58372","source":"vndb"}]},{"characterId":"char_vndb_c26357","characterName":"ギスラン","sourceIds":{"vndbCharacterId":"c26357"},"originalCharacterName":"ギスラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"430"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A knight from Chrysantheme. In his motherland he holds the nickname of \"The Feared Blade of Chrysantheme\" amongst the soldiers for all of his numerous military deeds. He has a fastidious and strict nature to himself and others, but he will definitely devote his loyalty to a liege that he has recognized."},{"spoiler":false,"text":"His mansion can be reached by going up a long set of captivating stairs. The living room has a solemn atmosphere and the walls are adorned with weapons. The interior is suited for a soldier like him."},{"spoiler":false,"text":"from otome-jikan"}],"source":"vndb","sourceCharacterId":"c26357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00fe7a3f154d768ea84aead2c63f963eb1238badfb9bafaf11ee01dfab1a3b1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0162cf5ea11b24d833e7c4d3fe42004a11788b08243c87e6c0513344e95dc7c.webp","width":220,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤 隆","creatorId":"vndb:s72","sourcePersonId":"vndb:s72","canonicalEntityId":"vndb:s72","name":"近藤 隆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58370","source":"vndb"}]},{"characterId":"char_vndb_c26487","characterName":"ヴィオレット","sourceIds":{"vndbCharacterId":"c26487"},"originalCharacterName":"ヴィオレット","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl who rules over Parterdeame and is the proxy, \"Reine\", of the sleeping goddess. She doesn't express many emotions and has a calm and wise personality. Due to being raised in such an isolated location she is unfamiliar with human nature."},{"spoiler":false,"text":"Her house is a little distance away from the home of her instructor, Hubert. It is surrounded by plenty of nature and vivid blooming flowers. Her living room comes across as feminine and florid with its pink interior."},{"spoiler":false,"text":"from otome-jikan"}],"source":"vndb","sourceCharacterId":"c26487"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02b50d3a8efe9a056032d3692e74a79ec1a75aa4a38388767921cbcdc632ae0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4891a71e49c8216ab5e41a4e67a58585dc014609c1ba7903672ef1378b745c75.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c26489","characterName":"ユベール","sourceIds":{"vndbCharacterId":"c26489"},"originalCharacterName":"ユベール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a prime minister who is resourceful and proficient at schemes. He is also 27 years old (age of his outward appearance) and known as the walking dictionary in Parterdeame. Being in charge of the heroine's lessons, he exists closely as an older brother figure. He is basically sweet towards the heroine but he is strict when he treats her as the Reine. He is not the type to mix business with personal matters."},{"spoiler":false,"text":"His mansion has calm colors and scores perfect in conveying an adult-like feeling for an intellectual like him. The lights produce a subdued Japanese taste."},{"spoiler":false,"text":"from otome-jikan"}],"source":"vndb","sourceCharacterId":"c26489"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52b4af69a876ed86704f2b23e7819a0cdef1b8d4624812d07416ca6c17c5c3ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64eac8d409f543ca8ecc62ef804078578b83dee3eb9a628e21eb2373ad15e822.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田 智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58373","source":"vndb"}]},{"characterId":"char_vndb_c26491","characterName":"茜","sourceIds":{"vndbCharacterId":"c26491"},"originalCharacterName":"茜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"The Princess’ enemies are also Akane’s enemies!\""},{"spoiler":false,"text":"\"I’ll gather them all up and take care of it ♡\""},{"spoiler":false,"text":"She is the half life of the butterfly of the Reine."},{"spoiler":false,"text":"Her special features are crying after lying."},{"spoiler":false,"text":"She’s a girly girl and her ideas are always radical."},{"spoiler":false,"text":"from cannonette"}],"source":"vndb","sourceCharacterId":"c26491"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url