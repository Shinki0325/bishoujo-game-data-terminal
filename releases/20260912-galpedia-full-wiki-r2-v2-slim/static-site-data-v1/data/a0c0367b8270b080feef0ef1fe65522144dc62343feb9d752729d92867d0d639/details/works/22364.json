"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"To see the Princess so flustered, it was definitely worth it to come and see\""},{"spoiler":false,"text":"The guardian of the Japanese Bell flower Kamon, and the Butterfly under Louis."},{"spoiler":false,"text":"The relationship he and Louis shares is not so friendly."},{"spoiler":false,"text":"They look friendly but are very wary of each other"},{"spoiler":false,"text":"from cannonette"}],"source":"vndb","sourceCharacterId":"c26494"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9769d9e27af23be856ccbe7d96965265a65d5947544818bdacd9de5d20bbe3fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b53129fb9e3f312ea41a3c93ff950bd6f4f8ffdc3327cc70da4618859ba65a0e.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"村上 和也","creatorId":"vndb:s447","sourcePersonId":"vndb:s447","canonicalEntityId":"vndb:s447","name":"村上和也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58378","source":"vndb"}]},{"characterId":"char_vndb_c26503","characterName":"揚羽","sourceIds":{"vndbCharacterId":"c26503"},"originalCharacterName":"揚羽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You idiot! you can’t touch the Princess without permission!!\""},{"spoiler":false,"text":"The guardian of the Red Peony Kamon, and the Butterfly under Leon."},{"spoiler":false,"text":"In a daring reverse relationship of Master and support with Leon."},{"spoiler":false,"text":"Like a wild beast tamer, she tames Leon."},{"spoiler":false,"text":"from cannonette"}],"source":"vndb","sourceCharacterId":"c26503"}],"profileFacts":[],"metadataCandi