{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13044","model":{"presentationWorkId":"vndb:v2699","staff":{"artwork":[{"creditedName":"YUKIRIN(ゆきりん、優希燐)","creatorId":"vndb:s7517","sourcePersonId":"egs:creator:2183","canonicalEntityId":"vndb:s7517","name":"YUKIRIN(ゆきりん、優希燐)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80692","source":"egs"}],"scenario":[],"music":[],"other":[{"creditedName":"Marica","creatorId":"vndb:s111","sourcePersonId":"vndb:s111","canonicalEntityId":"vndb:s111","name":"Marica","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:37070","source":"vndb"}]},"cast":[{"characterId":"char_c12465","characterName":"堀添 凛","sourceIds":{"bangumi":[{"characterId":"55380","match":"exact-normalized-name-in-linked-work","subjectId":"4236"}],"egsCharacterIds":["242"],"vndbCharacterId":"c12465"},"originalCharacterName":"堀添 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Your neighbour and childhood friend."}],"source":"vndb","sourceCharacterId":"c12465"},{"segments":[{"spoiler":false,"text":"三年生。通称「ぞえ」。"},{"spoiler":false,"text":"面倒見が良く、前向きでハツラツな元気系女の子。"},{"spoiler":false,"text":"コミュニケーション研究会の会長（自称）。"},{"spoiler":false,"text":"いろいろなことを提案し、盛り上げることを己の使命としている。"}],"source":"egs","sourceCharacterId":"242","sourceWorkId":"7641","spoiler":false},{"segments":[{"spoiler":false,"text":"優真の幼馴染にしてお隣さん。"},{"spoiler":false,"text":"とても面倒見が良く活発。"},{"spoiler":false,"text":"思いつきというか感情で動くタイプで、自分の意見を曲げないため、周囲に迷惑がかかることもしばしば。"},{"spoiler":false,"text":"もともと忠文が部長だった園芸部を「コミュニケーション研究会」と改名した張本人である。"}],"source":"egs","sourceCharacterId":"242","sourceWorkId":"13044","spoiler":false},{"segments":[{"spoiler":false,"text":"通称「ぞえ」。"},{"spoiler":false,"text":"面倒見が良く、前向きでハツラツな元気系女の子。コミュニケーション研究会の会長（自称）。"},{"spoiler":false,"text":"いろいろなことを提案し、盛り上げることを己の使命としている。"}],"source":"bangumi","sourceCharacterId":"55380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/549acc7d3baf494935e36bb43c4e7f3ed4c287955232c686b6d092119bd4f61b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d59f51823ff1f7d3ab884782d7ba49bf1b211442edc7a6129b905ac1ee6e48e8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c39532","characterName":"柴森 海音","sourceIds":{"bangumi":[{"characterId":"56207","match":"exact-normalized-name-in-linked-work","subjectId":"4236"}],"egsCharacterIds":["243"],"vndbCharacterId":"c39532"},"originalCharacterName":"柴森 海音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三年生。通称「しばもー」。"},{"spoiler":false,"text":"極度の人見知りで、いつもどこかおどおどしている小動物系。"},{"spoiler":false,"text":"コミュニケーション研究会のマスコット的存在で、堀添に懐いており、いつも一緒に行動している。"}],"source":"egs","sourceCharacterId":"243","sourceWorkId":"7641","spoiler":false},{"segments":[{"spoiler":false,"text":"凛と優真の幼馴染。"},{"spoiler":false,"text":"あまり感情を顔に表さない。"},{"spoiler":false,"text":"ゆったりとしたテンポの不思議な喋り方をする。"},{"spoiler":false,"text":"しかし内容は結構毒舌で、優真に対しては容赦ない。"},{"spoiler":false,"text":"その振る舞いから、他人との接触を避けているように周囲から思われているが、本人はおかまい無しである。"},{"spoiler":false,"text":"凛に子ども扱いされているのが少々不満らしい。"}],"source":"egs","sourceCharacterId":"243","sourceWorkId":"13044","spoiler":false},{"segments":[{"spoiler":false,"text":"通称「しばもー」。極度の人見知りで寡黙だが、凛には懐いており、常に彼女と行動を共にしている。"},{"spoiler":false,"text":"大概の人間の名前は縮めて呼んでいる（例：堀添凛→ぞえ 等）。一人称は「柴森」。ドライな言動が多い。既に自立している姉が二人いる。"},{"spoiler":false,"text":"過去にいじめを受けていたが、凛に助けられている。それ故、凛を強く慕っているものの、自分を助けた事でいじめの矛先が凛に向けられてしまったために、彼女に負い目を感じている。"}],"source":"bangumi","sourceCharacterId":"56207"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3c1eb9f097a5acc7c542fa5d61a33356fff6cd1f764397a9f044d6d5462b479.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4db0a0f7badaaa5d0e95a46943f98820543beb1d0684948d1ee2bf56734e4b5.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c39533","characterName":"百合川 真冬","sourceIds":{"bangumi":[{"characterId":"202992","match":"exact-normalized-name-in-linked-work","subjectId":"4236"}],"egsCharacterIds":["247"],"vndbCharacterId":"c39533"},"originalCharacterName":"百合川 真冬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三年生。"},{"spoiler":false,"text":"捉えどころが無く、いつもぼんやりとして何処を見て何を考えているのか判らない不思議系少女。"},{"spoiler":false,"text":"ときおり、一同を驚かせるようなショッキングな言動もしてみたりする。"},{"spoiler":false,"text":"何をするでもないが度々部室に姿を見せる。"}],"source":"egs","sourceCharacterId":"247","sourceWorkId":"7641","spoiler":false},{"segments":[{"spoiler":false,"text":"優真のクラスにやって来た転校生。"},{"spoiler":false,"text":"無口で常にぼーっとしている。"},{"spoiler":false,"text":"自分の事を語らず窓の外を眺めたり、校舎をさまよう謎多き人物。"},{"spoiler":false,"text":"コミュニケーション部（のメンバー）に興味があるようではあるが…。"}],"source":"egs","sourceCharacterId":"247","sourceWorkId":"13044","spoiler":false},{"segments":[{"spoiler":false,"text":"いつもぼんやりとしていて、何を考えているのか解らない、解らせない、ちょっと不思議な女の子。"},{"spoiler":false,"text":"しかし時折、その普段の言動からは想像もできないショッキングな発言をしたりして、一同を驚かすこともしばしば。"},{"spoiler":false,"text":"コミュニケーション研究会では、いつの間にか名誉会長の役職を賜っており、いつの間にか研究会の部屋の片隅に居たりする。"}],"source":"bangumi","sourceCharacterId":"202992"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b152362a33e8061452369f58513d1c892c4e79f19feffbfee7e05873de5e954c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c95cbc15e8dc0a7d97d531b813d32ced09c2da9c7ffeca30ff4ab92fd17ab5f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c39534","characterName":"桃井 恵子","sourceIds":{"bangumi":[{"characterId":"202994","match":"exact-normalized-name-in-linked-work","subjectId":"4236"}],"egsCharacterIds":["245"],"vndbCharacterId":"c39534"},"originalCharacterName":"桃井 恵子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三年生。"},{"spoiler":false,"text":"沢口に付き合う形でコミュニケーション研究会に関わっていく少女。"},{"spoiler":false,"text":"いつもどこかツンケンした態度を見せ、刺々しい言動からトラブルを引き起こすことも少なくない。"},{"spoiler":false,"text":"コミュニケーション研究会を内心快く思っていないようで、ことに國枝に対しては妙に意地になってしまうところがあるみたいだが……？"},{"spoiler":false,"text":"沢口とは幼馴染みでボケとツッコミのような間柄（当然、桃井がツッコミ）。"}],"source":"egs","sourceCharacterId":"245","sourceWorkId":"7641","spoiler":false},{"segments":[{"spoiler":false,"text":"優真の同級生で、美晴とは親友。"},{"spoiler":false,"text":"理性派できっちりしないと気がすまない性格と、生徒会役員という立場から、活動実績が不明なコミュニケーション研究会のメンバーとはそりが合わない。"},{"spoiler":false,"text":"特に感情で動く凛とは犬猿の仲である。"}],"source":"egs","sourceCharacterId":"245","sourceWorkId":"13044","spoiler":false},{"segments":[{"spoiler":false,"text":"沢口にひっぱり込まれるようにコミュニケーション研究会に関わることになる…幸か不幸かわからない女の子。"},{"spoiler":false,"text":"素直ではなく、いつもツンケンした態度である。"},{"spoiler":false,"text":"そのせいかトラブルを起こすこともたびたびあり、幼なじみの沢口美晴がフォローに入ることで事なきを得ることもしばしば。"},{"spoiler":false,"text":"むりやり入れられたコミュニケーション研究会を、内心快く思っていないようである。"}],"source":"bangumi","sourceCharacterId":"202994"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/213fe43b6527bf3bd222a11292e6af135e2badba2fd3dd1a23a1c25bddcf7c6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab9ae9a60a87d891476235df47095ba560046b5146e4d6afa8b7c4410aea9369.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c39535","characterName":"沢口 美晴","sourceIds":{"bangumi":[{"characterId":"202993","match":"exact-normalized-name-in-linked-work","subjectId":"4236"}],"egsCharacterIds":["246"],"vndbCharacterId":"c39535"},"originalCharacterName":"沢口 美晴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三年生。"},{"spoiler":false,"text":"ひょんなことから國枝と仲良くなってコミュニケーション研究会にも顔を出すようになる少女。"},{"spoiler":false,"text":"乙女ちっくな天然系。"},{"spoiler":false,"text":"いつも夢見がちな言動で周囲を和ませたり、ときに引かせたりもする。"},{"spoiler":false,"text":"桃井とは幼馴染みでいつもコンビで行動している。"}],"source":"egs","sourceCharacterId":"246","sourceWorkId":"7641","spoiler":false},{"segments":[{"spoiler":false,"text":"恵子の親友にして優真の同級生。"},{"spoiler":false,"text":"柔らかな物腰でいつも笑顔を絶やさない。"},{"spoiler":false,"text":"実はコミュニケーション研究会に入りたがっているものの恵子が許してくれないらしい。"}],"source":"egs","sourceCharacterId":"246","sourceWorkId":"13044","spoiler":false},{"segments":[{"spoiler":false,"text":"ひょんなことからコミニュケーション研究会の男子部員のひとり・國枝と仲良くなり、以降、しばしばコミュニケーション研究会に顔を出すようになる。"},{"spoiler":false,"text":"夢見がちで、その言動は周囲を和ませたり、ときには周囲をおおいにヒかせることを言う場合も…。"},{"spoiler":false,"text":"桃井とは幼なじみで、いつもコンビで行動している。"}],"source":"bangumi","sourceCharacterId":"202993"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b68ae3d29f5cc6fc3250d888c609f7bb6df5b5228e5790a331bcf4022eaa732.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/112a4ec864715642f1f896906d608b40f65aa4f510555ae78c33f030b3c1f506.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49759","characterName":"國枝 優真","sourceIds":{"bangumi":[{"characterId":"202995","match":"exact-normalized-name-in-linked-work","subjectId":"4236"}],"egsCharacterIds":["241"],"vndbCharacterId":"c49759"},"originalCharacterName":"國枝 優真","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三年生。"},{"spoiler":false,"text":"真っ直ぐで一本気。誰からも好かれるムードメーカータイプ。"},{"spoiler":false,"text":"内面的には真面目なところもあり、たまにどうでもいいように見えるところのこだわって足踏みをしてしまうこともある。"},{"spoiler":false,"text":"両親と歳の離れた妹がいる。"}],"source":"egs","sourceCharacterId":"241","sourceWorkId":"7641","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"本人には自覚も仕切るつもりも無いが、クラスのムードメーカーの一人として女子にもそこそこ人気はあるらしい。"},{"spoiler":false,"text":"コミュニケーション研究会（というよりもっぱら凛個人）へのクレームの窓口的な役も務めるプチ苦労人である。"}],"source":"egs","sourceCharacterId":"241","sourceWorkId":"13044","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"とてもまっすぐな性格で、別の言い方をすると単純明快。"},{"spoiler":false,"text":"その分かりやすい性格のせいもあり、人には好かれる傾向にある。"},{"spoiler":false,"text":"また、本人は気にはしていないがムードーメーカー的なポジションにいる。"},{"spoiler":false,"text":"変なところで真面目さを出して、どうでもいいように見えるところをこだわってしまうのが珠にキズである。"}],"source":"bangumi","sourceCharacterId":"202995"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a760f58c32a70430888fd7b81ebd57bc87332550c2945b34b97b68bef158578f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42d4124b30db2a9a85955989032e5a8539092cf4d6716f4c31493eb5cae99420.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p237","sourceCompanyId":"egs:brand:1940","ca