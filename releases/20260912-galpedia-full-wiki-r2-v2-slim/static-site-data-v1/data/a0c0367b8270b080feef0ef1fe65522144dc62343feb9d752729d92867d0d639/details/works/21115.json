iler":false,"text":"実際にはデザイナーとは名ばかりの雑務ばかりで、"},{"spoiler":false,"text":"ストレスが溜まっていて、性的にも欲求不満気味。"},{"spoiler":false,"text":"そんな毎日のため、ストレスを発散できるものが何かないか、新しい刺激を探している。"}],"source":"bangumi","sourceCharacterId":"199090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f22e1d3c2a650ae695078427bae653f78e1c00e4b882a7af6e1647a38708d42.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36d3001a143963101d85109e6c118ee9cbdba107a454a9d16734d80bd1578942.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133641:199090:17075:1","source":"bangumi"}]},{"characterId":"char_vndb_c119071","characterName":"克明","sourceIds":{"vndbCharacterId":"c119071"},"originalCharacterName":"克明","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"At first glance, he appears to be an ordinary businessman, but he is a genuine pervert who lives to molest."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c119071"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1571","sourceCompanyId":"egs:brand:1883","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21115:1883","source":"egs"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb: