eak, named Hiyakishi (Rekishi) (冷軋)."},{"spoiler":false,"text":"CV: Misaki Rina -三咲里奈"}],"source":"vndb","sourceCharacterId":"c17191"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c81625d31fe07abf2046d64aa3143291c95871a434713e8b4966ba0c8aa99153.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/6728dc27885352a7acd8b56e847ea13b34ce2319e6637eef34db15dcb328122b.webp","width":189,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c17192","characterName":"高円寺 空","sourceIds":{"vndbCharacterId":"c17192"},"originalCharacterName":"高円寺 空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d00cb437031202380a0ce640af8437602902317bb8ff884e01e263eed8c10278.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/151b452aa867c9ff0a55c1496f0744afbb88c82682fead2590a1cf47fe4d3c71.webp","width":189,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:148","sourceCompanyId":"egs:brand:148","canonicalEntityId":"egs:brand:148","name":"Studio e.go!","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21331:148","source":"egs"},{"companyId":"vndb:p8432","sourceCompanyId":"vndb:p8432","canonicalEntityId":"vndb:p8432","name":"雪飘工作室","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:127574:v57464","source":"vndb"},{"companyId":"vndb:p17","sourceCompanyId":"vndb:p17","canonicalEntityId":"vndb:p17","name":"Studio e.go!","roleCodes":["developer","publisher"],"identityStatus":