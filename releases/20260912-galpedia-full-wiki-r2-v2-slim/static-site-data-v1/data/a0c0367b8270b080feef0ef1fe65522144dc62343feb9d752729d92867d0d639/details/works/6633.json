327","name":"空中 幼彩","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19613","source":"vndb"},{"creditedName":"こうたろ","creatorId":"vndb:s3381","sourcePersonId":"vndb:s3381","canonicalEntityId":"vndb:s3381","name":"こうたろ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19614","source":"vndb"},{"creditedName":"服部 道知","creatorId":"vndb:s9649","sourcePersonId":"vndb:s9649","canonicalEntityId":"vndb:s9649","name":"服部 道知","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19617","source":"vndb"},{"creditedName":"上野 研太郎","creatorId":"vndb:s9957","sourcePersonId":"vndb:s9957","canonicalEntityId":"vndb:s9957","name":"上野 研太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19618","source":"vndb"},{"creditedName":"まゆき","creatorId":"vndb:s10649","sourcePersonId":"vndb:s10649","canonicalEntityId":"vndb:s10649","name":"まゆき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19619","source":"vndb"},{"creditedName":"刀神 真咲","creatorId":"vndb:s12825","sourcePersonId":"vndb:s12825","canonicalEntityId":"vndb:s12825","name":"刀神 真咲","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19620","source":"vndb"},{"creditedName":"有限会社フルール","creatorId":"vndb:s22158","sourcePersonId":"vndb:s22158","canonicalEntityId":"vndb:s22158","name":"有限会社フルール","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19623","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c2670","characterName":"桐沢 伊織","sourceIds":{"vndbCharacterId":"c2670"},"originalCharacterName":"桐沢 伊織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student. Unlike Kyou, she's a popular student with an overall positive reputation."},{"spoiler":false,"text":"Almost all students, both male and female, have some sort of crush on her; she could be described as an ideal schoolgirl."},{"spoiler":false,"text":"She's both beautiful and talented, with a polite and gentle demeanor, and has absolutely no traits that would offend other people. As a result, her perfect image almost appears artificial."},{"spoiler":false,"text":"She seems to harbor unspoken feelings for Naoya..."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c2670"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0030a3b5a80b21515af4f120c4889f13ea796b9701d058c3f41395a6d452967.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75fc975c889d0d564c5a7343f1ba7051201456ebd8a74409a4a841dff2e20001.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安玖深 音","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9703","source":"vndb"}]},{"characterId":"char_vndb_c2671","characterName":"一之瀬 響","sourceIds":{"vndbCharacterId":"c2671"},"originalCharacterName":"一之瀬 響","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year student. An infamous figure at the academy, who is known to everyone, but possesses an overall negative reputation."},{"spoiler":false,"text":"She's a cat-like girl with no friends and no tendency to flatter anyone, but her striking looks attract attention wherever she goes and whatever she does. However, she doesn't seem to care about this. Because of this, she's the target of jealousy and envy from other girls, and avoided by boys who find her uncontrollable."},{"spoiler":false,"text":"Regardless, her reputation amongst those around her is far from passive, and there are rumors that she sells her body for 5,000 yen."},{"spoiler":false,"text":"She's an outcast at the academy and always alone. However, her personality is cheerful despite this."},{"spoiler":false,"text":"Because of the rumors, she tends to give off a scary impression, but if you talk to her, she's easygoing and has a charming personality."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c2671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1bdb479d7752e0c671f6defecdd4c0c51a7a49a760c64176ba9163694a3aa44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05a9df021be8fa144db6ec2eb321cc2e036ded447bf02748c0bbcbcaa0712e3d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9702","source":"vndb"}]},{"characterId":"char_vndb_c2672","characterName":"園村 円香","sourceIds":{"vndbCharacterId":"c2672"},"originalCharacterName":"園村 円香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student who is reserved and introverted, possessing a quiet, caring personality. She also has a slight fear of men."},{"spoiler":false,"text":"Due to certain circumstances, she has feelings for Itsuki, but she is unable to take the initiative and merely watches from afar. That alone makes her stand out, but her admiration for Kyou and her aversion to Iori make her truly unique within the school."},{"spoiler":false,"text":"She is also one of the few girls who are not swayed by Naoya, and in that sense, she can be considered unusual still. Perhaps because she is aware of this, she has a somewhat self-deprecating side."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c2672"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a04016936b671c16370d65869a1b636f85fc46186bc82b45118fdf5993c031d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a769d8045ecfb6baf7f5e1990a97275d4be7d725d2618ba6fb814cd4739a70e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬 未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9704","source":"vndb"}]},{"characterId":"char_vndb_c2673","characterName":"城戸 尚也","sourceIds":{"vndbCharacterId":"c2673"},"originalCharacterName":"城戸 尚也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student. A playboy with a reputation for having affairs both inside and outside the school."},{"spoiler":false,"text":"He's had relationships with well over 100 girls, most of whom have ended up heartbroken. However, he's not the type to have a committed relationship; he claims he's just taking advantage of opportunities presented to him."},{"spoiler":false,"text":"While generally a passive person and not the type to take pleasure in exploiting women, he's hopelessly lacking in kindness and consideration towards those who show him affection."},{"spoiler":false,"text":"At best, he's neutral. At worst, he's insensitive. He doesn't mean any harm, but he doesn't understand the nuances of romantic feelings, having never experienced true love."},{"spoiler":false,"text":"He's an all-rounder when it comes to playing, studying, and sports, but his emotional side is underdeveloped. The only exception he makes is with Itsuki, his long-time friend; he's kind to him to the point of making girls jealous."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c2673"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8f3ff6152988041aeddfab30c0a614b837aa7a1dea1bcc8ccbd340496f041e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7b52ed1986c37c9813954785783fcb5f56c770098a37d9b1a6ad9adf74eb734.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壬生 浪士","creatorId":"vndb:s10","sourcePersonId":"vndb:s10","canonicalEntityId":"vndb:s10","name":"子安 武人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9700","source":"vndb"}]},{"characterId":"char_vndb_c2674","characterName":"来栖 樹","sourceIds":{"vndbCharacterId":"c2674"},"originalCharacterName":"来栖 樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character of the story. A second-year student."},{"spoiler":false,"text":"He's inconspicuous, unremarkable, and practically unrecognizable by his classmates. He's never bullied, but most students view him as an appendage of Naoya."},{"spoiler":false,"text":"He has good grades, but he doesn't take pride in them; He simply has nothing else to do but study. Therefore, he lacks confidence and has low self-esteem."},{"spoiler":false,"text":"He's the complete opposite of Naoya in both appearance and personality, but they are very similar in one respect: neither attempt to make friends through flattery."},{"spoiler":false,"text":"He has feelings for Iori, but considers her unattainable and has no intention of trying to impress her. He only wishes to avoid causing any trouble, be left alone, and be treated like air."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c2674"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccc1bbd7084ff9a3d32f3eccae538c2a8ff3634c3229bf88d124dc2335c2b64f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d78f3de255383d01a600eac39a2decb80196bee29c43b2fc44c9fa145a78e21.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笠原 准","creatorId":"vndb:s109","sourcePersonId":"vndb:s109","canonicalEntityId":"vndb:s109","name":"久保田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9701","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p242","sourceCompanyId":"egs:brand:309","canonicalEntityId":"vndb:p242","name":"light","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6633:309","source":"egs"},{"companyId":"vndb:p242","sourceCompanyId":"vndb:p242","canonicalEntityId":"vndb:p242","name":"light","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2430:v1074","source":"vndb"},{"companyId":"vndb:p242","sourceCompanyId":"vndb:p242","canonicalEntityId":"vndb:p242","name":"light","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2431:v1074","source":"vndb"},{"companyId":"vndb:p242","sourceCompanyId":"vndb:p242","canonicalEntityId":"vndb:p242","name":"light","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2761:v1074","source":"vndb"},{"companyId":"vndb:p242","sourceCompanyId":"vndb:p242","canonicalEntityId":"vndb:p242","name":"light","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:42820:v1074","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
