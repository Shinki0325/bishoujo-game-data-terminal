e,"text":"男性経験は、友幸のみ。"}],"source":"egs","sourceCharacterId":"5654","sourceWorkId":"21426","spoiler":false},{"segments":[{"spoiler":false,"text":"高崎友幸の再婚相手。 優しく前向きな良妻。"},{"spoiler":false,"text":"世話好きで、困っている人を放っておけない性格。"},{"spoiler":false,"text":"ただ、大事なことを言い出せずに悶々としてしまうところもある。"},{"spoiler":false,"text":"大学時代に家庭教師のバイトがきっかけで友幸と出会い、卒業後に彼と結婚した。"},{"spoiler":false,"text":"一回りほど年の差はあるが、「ともクン」 と呼ぶほどラブラブな関係。"},{"spoiler":false,"text":"専業主婦になってからは運動しなくなったためか、ぽっちゃりとしてきた。 男性経験は友幸のみ。"}],"source":"bangumi","sourceCharacterId":"29919"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"5654","sourceWorkId":"21426","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"5654","sourceWorkId":"21426","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"5654","sourceWorkId":"21426","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"5654","sourceWorkId":"21426","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"5654","sourceWorkId":"21426","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"43 kg","valueContext":null,"source":"egs","sourceCharacterId":"5654","sourceWorkId":"21426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6968e461ff75db1f45bf245d976060a5cfcaff46d1e81a2021979cbf9a54b11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d2b7939cb7616eda29953ce3ff590a33f1e25621bc4d4365fdbea6f87cc6987.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 め