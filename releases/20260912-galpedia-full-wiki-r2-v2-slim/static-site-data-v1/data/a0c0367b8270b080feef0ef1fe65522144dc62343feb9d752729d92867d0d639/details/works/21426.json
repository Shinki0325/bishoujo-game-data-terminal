eviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商社に勤めるサラリーマン。食品３課の主任。"},{"spoiler":false,"text":"大学生時代に結婚しており、娘が生まれて１年で離婚している。"},{"spoiler":false,"text":"その後、娘を両親に預けて大学に通い、卒業。"},{"spoiler":false,"text":"娘が小学校にあがる時期には、新居に引っ越して娘との生活を始めて、娘の高校受験に備えて雇った、家庭教師、明日香と出会い、その後、彼女と再婚。"},{"spoiler":false,"text":"現在に至る。"}],"source":"egs","sourceCharacterId":"5653","sourceWorkId":"21426","spoiler":false},{"segments":[{"spoiler":false,"text":"商社に勤めるサラリーマン。 まじめで不器用な性格。"},{"spoiler":false,"text":"表裏がなく駆け引きが苦手。 身体は大きいが小心者で、コツコツ努力を重ねるタイプ。"},{"spoiler":false,"text":"学生時代に一度は結婚したものの、美穂が生まれて 1年で離婚している。"},{"spoiler":false,"text":"その後は娘を両親に預けて大学に通い卒業。 美穂が小学生に上がる頃には二人暮らしを始めた。"},{"spoiler":false,"text":"そして美穂の受験に備えて雇った家庭教師・明日香と出会い、彼女と再婚する。"}],"source":"bangumi","sourceCharacterId":"29921"}],"profileFacts":[{"label":"身高（本版本）","value":"180 cm","valueContext":null,"source":"egs","sourceCharacterId":"5653","sourceWorkId":"21426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b5b85fe077e9c74b3db498c501e0dc051a8c09f961b38d94b831173b42f5d50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bf996c9ae58eed8acf42b9735f3c38afae4b7c50cb61aebdfd3a24d838fd626.webp","width":256,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_c55680","characterName":"師岡 啓人","sourceIds":{"bangumi":[{"characterId":"29922","match":"exact-normalized-name-in-linked-work","subjectId":"124240"}],"egsCharacterIds":["5656"],"vndbCharacterId":"c55680"},"originalCharacterName":"師岡 啓人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"入社３年目、主人公の出身大学の後輩。"},{"spoiler":false,"text":"就職活動時期にＯＢ訪問で面接していらい、主人公のことを「先輩」と呼んで慕っている。"},{"spoiler":false,"text":"入社後、主人公の職場に配属されて、主人公が教育係を務めて、何かと世話を焼いている。"},{"spoiler":false,"text":"主人公再婚後の家にも何度かつれてきていて妻の明日香、娘の美穂とも顔見知り。"},{"spoiler":false,"text":"しかし、社内には明かしていないが精神を病み、心の中に別人格が同居している。"},{"spoiler":false,"text":"現在、主人格は普段から表に出ている、明るい人付き合いの良い青年だが、その他に、「狡猾な紳士」「暴力を好む乱暴な青年」「偏執的なマニア」の３人の副人格が存在している。"}],"source":"egs","sourceCharacterId":"5656","sourceWorkId":"21426","spoiler":false},{"segments":[{"spoiler":false,"text":"友幸の出身大学の後輩。 明るく人付き合いの良い青年。"},{"spoiler":false,"text":"就職活動時にOB訪問で面接して以来、友幸のことを先輩と呼び 慕っている。"},{"spoiler":false,"text":"入社後も同じ職場に配属され、教育係となった友幸が何かと世話を焼いている。"},{"spoiler":false,"text":"家にも何度か訪れており、明日香や美穂とも顔見知り。"},{"spoiler":false,"text":"しかし実は精神を病んでおり、心の中に 3つの副人格が存在している。"},{"spoiler":false,"text":"・狡猾な紳士：暴力や野蛮な手段を嫌い、女を精神的に辱めることを好む。"},{"spoiler":false,"text":"・乱暴な青年： 単純な実力行使を好む肉体派。 手っ取り早くクスリに頼ることも。"},{"spoiler":false,"text":"・偏執的な青年： 3次元よりも2次元を愛するロマンチスト。 年上よりも年下が好み。"}],"source":"bangumi","sourceCharacterId":"29922"}],"profileFacts":[{"label":"身高（本版本）","value":"175 cm","valueContext":null,"source":"egs","sourceCharacterId":"5656","sourceWorkId":"21426","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"67 kg","valueContext":null,"source":"egs","sourceCharacterId":"5656","sourceWorkId":"21426","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af7c84636d2efe83f94dfe0d41d1755da3a7c1f6987cb3f9e678c3ccc50e244e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79b598f4d8a112bad32a348924ce4b5a6537ba304304ae0e1f9dab68f5bcc7cb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4763","sourceCompanyId":"egs:brand:4408","canonicalEntityId":"vndb:p4763","name":"シルキーズSAKURA","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21426:4408","source":"egs"},{"companyId":"vndb:p15756","sourceCom