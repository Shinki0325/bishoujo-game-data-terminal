s","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Zion is the manifestation of Zion National Park. She has a deep, almost spiritual connection with nature, and often attracts a variety of animals to her location wherever she's at. Zion may seem meek and scared at first, but if one were to look deeper they'd realize her childlike appearance belies her serene wisdom. Memories and knowledge from times long ago echo in her head, but unlike Yosemite, Zion welcomes the change times brings to her. She has a sisterly bond with Yellowstone, and more often than not ends up taking care of her rather than the other way around."}],"source":"vndb","sourceCharacterId":"c76478"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d6cf5d7b1b75a6b6556ef47f76abb7c411b94c3622098d75069023be8a171e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce4477a0182b4d846eaba80157dc665b336bf03747736ddb371bbde211c36697.webp","width":195,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Lisa Reimold","creatorId":"vndb:s16630","sourcePersonId":"vndb:s16630","canonicalEntityId":"vndb:s16630","name":"Lisa Reimold","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66707","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:9371","sourceCompanyId":"egs:brand:9371","canonicalEntityId":"egs:brand:9371","name":"Stadio Elan","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:39882:9371","source":"egs"},{"companyId":"vndb:p7226","sourceCompanyId":"vndb:p7226","canonicalEntityId":"vndb:p7226","name":"Studio Élan","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:rele