images/71/71b634e16a1551aed31fae87538506d1f3dafb3808a63150c2e21c90f3ccc178.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5728b4a1b3535cc44ef2cf94d767789215f8c7d3c65895bbdc6c2101004a814.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"姫川 あいり","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54163","source":"vndb"}]},{"characterId":"char_vndb_c15015","characterName":"九々津 那琴","sourceIds":{"vndbCharacterId":"c15015"},"originalCharacterName":"九々津 那琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruka's youngest daughter and Souchi's niece. From a young age, she despised Souchi because she noticed that her mother loved him instead of her father. Despite being a girl, she is the living image of her father."},{"spoiler":true,"text":"Her greatest ambition is to rebuild her father's business, for this she has offered her body to her uncle in exchange for teaching her how to run a company, despite this she has been rejected on many occasions."}],"source":"vndb","sourceCharacterId":"c15015"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2452b6c6b4e392df9f2fd9a6248985ca0ce15f728eb0da9f32c4db3f5b27448c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4bf37b408ca7dc6b7f88db81498d43235bec53fda592f64b96eac2998c0adde.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vndb:s278","sourcePer