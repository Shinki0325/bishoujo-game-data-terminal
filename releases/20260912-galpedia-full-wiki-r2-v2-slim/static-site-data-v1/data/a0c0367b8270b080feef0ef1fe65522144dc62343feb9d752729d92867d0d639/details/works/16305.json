":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オラクルナイツに所属する、将軍の１人。"},{"spoiler":false,"text":"二刀流剣士かつ、オラクルナイツを束ねるリーダー格。"},{"spoiler":false,"text":"忠義と騎士道を重んじる。"},{"spoiler":false,"text":"部下からの信頼も厚く、有能な将軍として名を馳せるが、どこか他人と距離を置いている。"},{"spoiler":false,"text":"それが何故なのか、彼女は誰にも語ることはない。"}],"source":"egs","sourceCharacterId":"9279","sourceWorkId":"15066","spoiler":false},{"segments":[{"spoiler":false,"text":"かつてアゾォートと敵対したオラクルナイツの将軍の１人。"},{"spoiler":false,"text":"二刀流剣士で、オラクルナイツを束ねるリーダー格だった。"},{"spoiler":false,"text":"忠義と騎士道を重んじ、部下からの信頼も厚い有能な将軍。"},{"spoiler":false,"text":"その出生から他人との距離を置いていたものの、達也の自由気ままな性格に触れ軟化傾向にある。"},{"spoiler":false,"text":"シエロ・パンタジアに平和が訪れ、もはや自分の剣は必要ないと感じる日々を送っていた。"},{"spoiler":false,"text":"しかし魔王争奪戦が開かれることを知り、最後に達也の仲間ではなく一介の剣士として全力で戦うために戦いに参加する。"}],"source":"egs","sourceCharacterId":"9279","sourceWorkId":"16305","spoiler":false},{"segments":[{"spoiler":false,"text":"オラクルナイツに所属する将軍の1人。"},{"spoiler":false,"text":"炎剣と氷剣を使った二刀流剣士かつ、オラクルナイツを束ねるリーダー格。"},{"spoiler":false,"text":"忠義と騎士道を重んじる。"},{"spoiler":false,"text":"部下からの信頼も厚く、有能な将軍として名を馳せるが、どこか他人と距離を置いている。"},{"spoiler":false,"text":"それが何故なのか、彼女は誰にも語ることはない。"}],"source":"bangumi","sourceCharacterId":"12775"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa8ab4d3e9b12e1e4ad9a2e61e0cab247e11ed44f73f693d82e28cdfee479647.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47dd12fb7940e473c17d87c44e021929240dfd655916a5a4983d88488bc81390.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":