けられることはなく、そのほとんどが彼女を通して伝えられる。"},{"spoiler":false,"text":"気が弱く、おどおどとしているが、メルティマの命令には逆らうことなく力を振るう"}],"source":"bangumi","sourceCharacterId":"12777"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c35e9dd2d05f8c730a540fdac5a4b2ba580d6850c5f4d4e3540d4767ff822d62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68a7ca8edd2ea3ca9dc9c1d32dcc36e7b27401dc0464e91c8ded8171bcd8f77a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222155:12777:5922:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1968","sourceCompanyId":"egs:brand:3199","canonicalEntityId":"vndb:p1968","name":"Chariot","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:16305:3199","source":"egs"},{"companyId":"vndb:p1968","sourceCompanyId":"vndb:p1968","canonicalEntityId":"vndb:p1968","name":"Chariot","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:23002:v9676","source":"vndb"},{"companyId":"vndb:p1968","sourceCompanyId":"vndb:p1968","canonicalEntityId":"vndb:p1968","name":"Chariot","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:23003:v9676","source":"vndb"},{"companyId":"vndb:p1968","sourceCompanyId":"vndb:p1968","canonicalEntityId":"vndb:p1968","name":"Chariot","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:60918:v9676","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
