{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"27527","model":{"presentationWorkId":"vndb:v25673","staff":{"artwork":[{"creditedName":"鷹乃ゆき(たかのゆき、朱音流架)","creatorId":"vndb:s685","sourcePersonId":"egs:creator:12946","canonicalEntityId":"vndb:s685","name":"鷹乃ゆき(たかのゆき、朱音流架)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:205216","source":"egs"},{"creditedName":"またたび丸。","creatorId":"vndb:s23598","sourcePersonId":"egs:creator:30524","canonicalEntityId":"vndb:s23598","name":"またたび丸。","detail":"SD原画","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:220606","source":"egs"}],"scenario":[{"creditedName":"近江谷宥","creatorId":"vndb:s4352","sourcePersonId":"egs:creator:20596","canonicalEntityId":"vndb:s4352","name":"近江谷宥","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:205214","source":"egs"}],"music":[],"other":[{"creditedName":"ほっしー","creatorId":"vndb:s2082","sourcePersonId":"egs:creator:13151","canonicalEntityId":"vndb:s2082","name":"ほっしー","detail":"ディレクター、スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:220607","source":"egs"},{"creditedName":"アラガー","creatorId":"vndb:s4578","sourcePersonId":"egs:creator:23406","canonicalEntityId":"vndb:s4578","name":"アラガー","detail":"プロデューサー、広報・営業","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:220608","source":"egs"},{"creditedName":"eco*(えこ)","creatorId":"vndb:s1781","sourcePersonId":"egs:creator:4871","canonicalEntityId":"vndb:s1781","name":"eco*(えこ)","detail":"CG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:220609","source":"egs"},{"creditedName":"癸乙夜","creatorId":"vndb:s2829","sourcePersonId":"egs:creator:12718","canonicalEntityId":"vndb:s2829","name":"癸乙夜","detail":"ムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:220610","source":"egs"},{"creditedName":"(有)クラスレーベルデザイン(CLASSLABEL DESIGN LIMITED)","creatorId":"egs:creator:19452","sourcePersonId":"egs:creator:19452","canonicalEntityId":"egs:creator:19452","name":"(有)クラスレーベルデザイン(CLASSLABEL DESIGN LIMITED)","detail":"ロゴデザイン","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:220611","source":"egs"},{"creditedName":"段林","creatorId":"egs:creator:19573","sourcePersonId":"egs:creator:19573","canonicalEntityId":"egs:creator:19573","name":"段林","detail":"WEB","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:220612","source":"egs"},{"creditedName":"CUBE(株式会社キューブ)","creatorId":"vndb:s2651","sourcePersonId":"egs:creator:4321","canonicalEntityId":"vndb:s2651","name":"CUBE(株式会社キューブ)","detail":"音声収録・キャスティング","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:220613","source":"egs"},{"creditedName":"鳩崎亜紋","creatorId":"egs:creator:22207","sourcePersonId":"egs:creator:22207","canonicalEntityId":"egs:creator:22207","name":"鳩崎亜紋","detail":"インターフェイスデザイン","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:220614","source":"egs"},{"creditedName":"株式会社クリープ(cre-p)","creatorId":"vndb:s18796","sourcePersonId":"egs:creator:27621","canonicalEntityId":"vndb:s18796","name":"株式会社クリープ(cre-p)","detail":"背景","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:220615","source":"egs"},{"creditedName":"David Evelyn","creatorId":"vndb:s27805","sourcePersonId":"vndb:s27805","canonicalEntityId":"vndb:s27805","name":"David Evelyn","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:157038","source":"vndb"}]},"cast":[{"characterId":"char_c55100","characterName":"風魔 ゆら","sourceIds":{"bangumi":[{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"49095","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["13251"],"vndbCharacterId":"c55100"},"originalCharacterName":"風魔 ゆら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I, Fuuma Yura, in accordance to the contract hereby swear, to serve you, Lord Haruki!\""},{"spoiler":false,"text":"The elder of the Fuuma sisters. A demi cat."},{"spoiler":false,"text":"She walks the path of shinobi and swears loyalty to our hero. But she is absent minded and often foolish."},{"spoiler":false,"text":"An optimistic girl who doesn 't let failure and hardship put her down."},{"spoiler":false,"text":"Her weaknesses are her tail and headpats."},{"spoiler":false,"text":"Though she enjoys showing her master how capable she is, she is unable to resist a good coddling."},{"spoiler":false,"text":"A self-proclaimed martial master."},{"spoiler":false,"text":"Terrible at ninjutsu."},{"spoiler":false,"text":"From Sekai Project"}],"source":"vndb","sourceCharacterId":"c55100"},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた忍び姉妹の姉。"},{"spoiler":false,"text":"猫の亜人。"},{"spoiler":false,"text":"忍道を尊び、主人公に忠誠を誓っているが、天然で隙も多い。"},{"spoiler":false,"text":"失敗してもめげない、若干はた迷惑な前向きキャラ。"},{"spoiler":false,"text":"弱点は尻尾とナデナデ。"},{"spoiler":false,"text":"毅然としたところを見せて主様に褒めていただきたいと思いながらも、徹底できない甘えっ子。"},{"spoiler":false,"text":"自称・体術タイプの忍者で忍法は苦手。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に仕えている猫耳忍者。"},{"spoiler":false,"text":"年こそ若いがれっきとした風魔の上忍で、無類の頑張り屋さん（全て自称）。"},{"spoiler":false,"text":"押しかけ女房的に、現在は主人公の家で暮らしている。"},{"spoiler":false,"text":"主人公の忍びであることに誇りを感じていて、お役に立ちたくて仕方ない。"},{"spoiler":false,"text":"身辺警護的な意味でも主人公の傍を片時も離れたくないし、自慢の可愛さで癒やして差し上げたい。"},{"spoiler":false,"text":"要するに天下無双の甘えんぼ。"},{"spoiler":false,"text":"主人公がマヤを構う様子には忸怩たるものを感じているようで……？"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"体感的にはだいぶ前に主人公の元にやってきた風魔の猫耳忍者。"},{"spoiler":false,"text":"共通の障壁や困難はお互いの愛をますます堅固なものにする的なあれで、鋼鉄の忠誠心にも磨きがかかってきた（自称）。"},{"spoiler":false,"text":"一方で、里見勢とは相変わらずケンカばかり。"},{"spoiler":false,"text":"主人公への愛やご寵愛に関しては、誰にも譲れないのは相変わらず。"},{"spoiler":false,"text":"陽葵たちへの態度は、今のところ決めかねている様子。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた、猫忍姉妹のパワー担当。"},{"spoiler":false,"text":"馬鹿力と大雑把な性格は健在。"},{"spoiler":false,"text":"初めて北条家を訪れたあの日から、はや数年。"},{"spoiler":false,"text":"優しい主の元、平和な日々を謳歌している。"},{"spoiler":false,"text":"いまいち忍びとして働き場がないことについては、あまり考えないことにした模様。とはいえ、雑賀の動乱は気になるようで、「あるいはハルキ殿の天下の予感？」的な妄想したりしている。"},{"spoiler":false,"text":"相変わらずずっと、ハルキ殿のことが大好き。"}],"source":"egs","sourceCharacterId":"13251","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"「在下風魔由良！遵從約定自今天起，為春希殿下獻上我的忠誠！」"},{"spoiler":false,"text":"來自風魔之里的忍者姊妹中的姊姊。貓咪型亞人。"},{"spoiler":false,"text":"推崇忍道，雖然對主人宣誓效忠，但是個性天然而渾身空隙。"},{"spoiler":false,"text":"遭遇失敗也不屈不撓，是個會稍微對週圍的人帶來困擾的樂觀角色。"},{"spoiler":false,"text":"弱點是尾巴還有摸摸。"},{"spoiler":false,"text":"雖然總是想著要讓主人看看自己的信念讓他誇獎，"},{"spoiler":false,"text":"但總是無法貫徹到底，是愛撒嬌的孩子。"},{"spoiler":false,"text":"自稱是擅長體術類型的忍者，對忍術不拿手。"}],"source":"bangumi","sourceCharacterId":"49095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae199390257854c04f3a65dd3f3e803596a9fd69ea57a27717d16b9c116b4f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/4672b4a46d6cf8ad1eb10c77a3e8f014bafebbcee701f8d1d3d47d02ef34c7c6.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231797:49095:7302:1","source":"bangumi"}]},{"characterId":"char_c55101","characterName":"風魔 たま","sourceIds":{"bangumi":[{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"49096","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["13252"],"vndbCharacterId":"c55101"},"originalCharacterName":"風魔 たま","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Master, aren't you going to feed us?\""},{"spoiler":false,"text":"The younger of the Fuuma Sisters. A demi cat just like her sister."},{"spoiler":false,"text":"Compared to her (supposedly) serious sister, she has her head in the clouds. She doesn't treat our"},{"spoiler":false,"text":"hero like her master, and instead treats him like her brother. She incessantly begs for coddles."},{"spoiler":false,"text":"She is a poor academic, but a master of ninjutsu."},{"spoiler":false,"text":"She is able to use a wide array of Fuuma Ninjutsu despite her young age."},{"spoiler":false,"text":"She enjoys eating fluffy food."},{"spoiler":false,"text":"Very relaxed. Enjoys basking in the sun."},{"spoiler":false,"text":"From Sekai Project"}],"source":"vndb","sourceCharacterId":"c55101"},{"segments":[{"spoiler":false,"text":"姉のゆら同様、風魔の里からやってきた忍び姉妹の妹。"},{"spoiler":false,"text":"同じく猫の亜人。"},{"spoiler":false,"text":"（表向き）生真面目な姉と比べて、ふわふわと浮世離れした性格。"},{"spoiler":false,"text":"主人公のことも一応は主と見ているものの、完全にお兄ちゃん扱いで全身全霊で甘えてくる。"},{"spoiler":false,"text":"お勉強は苦手だが、忍術は大得意。"},{"spoiler":false,"text":"この若さで大半の風魔忍法を使いこなす。"},{"spoiler":false,"text":"好きな食べ物はふわふわしたもの。"},{"spoiler":false,"text":"基本的にのんびり屋で、ひなたぼっこと昼寝が幸せ。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"姉のゆらと一緒に主人公に仕えている猫耳忍者。"},{"spoiler":false,"text":"活発な姉と比べてだいぶマイペース。"},{"spoiler":false,"text":"相変わらず主人公のことは「おにいちゃん」呼びだが、大好きぶりはますます加速していて、毎日のように主人公の背中や膝を姉と取り合いしている。"},{"spoiler":false,"text":"最近はゴロ寝テレビの術(オリジナル)を習得して、ぐーたらぶりにも磨きがかかってきた。"},{"spoiler":false,"text":"特に子供向けアニメがお気に入り。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"ゆらと一緒に、主人公の家に押しかけてきた猫耳妹。"},{"spoiler":false,"text":"こう見えて風魔の上忍で、風魔忍法の全てを修めた天才……のはずなのだが、誰よりも猫らしい性格は相変わらずで、もはやぐーたらの域。"},{"spoiler":false,"text":"それはそれで手間がかからなくていいと主人公も静観している様子。"},{"spoiler":false,"text":"とはいえ、食べることと主人公のことは別。"},{"spoiler":false,"text":"主人公に仇なす悪い人が現れたりしたら本気出す。多分。"},{"spoiler":false,"text":"特に何もなければゴロ寝テレビの術で。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"風魔の里からやってきた、猫忍姉妹の術担当。"},{"spoiler":false,"text":"のんびりおおらかでちゃっかりした性格は、もはやどうにもなりようがない。"},{"spoiler":false,"text":"愛され上手の子猫ちゃん。"},{"spoiler":false,"text":"姉同様、平和な日々をのんびり楽しんでいる。"},{"spoiler":false,"text":"特に何ってほどのことはしていない。"},{"spoiler":false,"text":"雑賀の動乱に対しても、姉ほどは興味がない。"},{"spoiler":false,"text":"相変わらずマイペースで、変わらすにおにいちゃんのことが大好き。"},{"spoiler":false,"text":"みんなで一緒にいられればそれで幸せ。"}],"source":"egs","sourceCharacterId":"13252","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"「主人，不是會給我們好吃的飯嗎？」"},{"spoiler":false,"text":"和姊姊由良一樣，是來自風魔之里的忍者姊妹中的妹妹。同樣是貓咪型亞人。"},{"spoiler":false,"text":"（表面上）和非常認真的姊姊相較之下，有著飄飄然不食人間煙火的個性。"},{"spoiler":false,"text":"雖然姑且把男主角當成主人，"},{"spoiler":false,"text":"卻完全把他當做哥哥看待，全心全意地對他撒嬌。"},{"spoiler":false,"text":"雖然對學習不大拿手，但是非常擅長忍術。如此年輕就能夠使用大半風魔相傳的忍術。"},{"spoiler":false,"text":"喜歡的食物是軟綿綿的東西。"},{"spoiler":false,"text":"基本上個性很悠閒，對於在日光的照耀下睡午覺感到幸福。"}],"source":"bangumi","sourceCharacterId":"49096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04fb5bad1c084997db4687dcb48cd1fb5bf05affbc64dcc6c91f199448c9574a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/331ba241520ab676eb9fd3b22cc0244680a8655d3e2a9dd04033b13c8104bb9e.webp","width":126,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231797:49096:8580:1","source":"bangumi"}]},{"characterId":"char_c55102","characterName":"彩羽","sourceIds":{"bangumi":[{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"201102"},{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"49097","match":"exact-normalized-name-in-linked-work","subjectId":"269282"}],"egsCharacterIds":["13253","18485"],"vndbCharacterId":"c55102"},"originalCharacterName":"彩羽","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I will just return everything to normal, so just take a breath, everything will come up with a time.\""},{"spoiler":false,"text":"Protagonist's childhood friend who attends the same school as him. Doesn't have any close friends besides the protagonist, behaves cold towards the others."}],"source":"vndb","sourceCharacterId":"c55102"},{"segments":[{"spoiler":false,"text":"主人公と同じ学園に通う同級生だが、鈴木　彩は世を忍ぶ仮の姿。"},{"spoiler":false,"text":"いくつもの忍びの里を出自とする忍者によって構成されている組織において、作戦を指揮する立場にある。"},{"spoiler":false,"text":"主人公が通う学園に先月引っ越してきて、今日に至るまで周辺を調査していたようだが主人公本人は気付いていない。"},{"spoiler":false,"text":"学園ではクールキャラを通しており、親しい友人はいない。"}],"source":"egs","sourceCharacterId":"13253","sourceWorkId":"24608","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と仲間達のお目付け役的な存在。"},{"spoiler":false,"text":"風魔の里に動きがあることを察知し、主(あるじ)格である主人公の元に派遣されてきた。"},{"spoiler":false,"text":"忍び、特に抜け忍が起こす事件の警戒・対応が主な仕事と言っているが、素性はもちろん、所属している組織についてもはっきりとは語っていない。"},{"spoiler":false,"text":"相変わらずクールキャラを貫いているが、ゆらたまのわんぱくぶりに怒りマークを浮かべていることも稀によくある。"},{"spoiler":false,"text":"現在は謎の猫忍者の対応に追われている。"}],"source":"egs","sourceCharacterId":"18485","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"お目付け役も板についてきたクールビューティ。"},{"spoiler":false,"text":"主人公たちとの付き合いも長くなってきたものの、馴れ合う様子は微塵もなく、猫忍たちにニャーニャー威嚇されてもどこ吹く風。"},{"spoiler":false,"text":"所属や素性なども相変わらず謎のまま……でここまできたが、陽葵の巻き添えを食らう形で色々バレそう。"},{"spoiler":false,"text":"最近、ついに漢方系の胃腸薬に手を出した。胃を元気にしたい系女子。"}],"source":"egs","sourceCharacterId":"18485","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"「只不過是回到原本的生活唷。只要一個呼吸之間，我就能解決一切」"},{"spoiler":false,"text":"和男主角同一個學校的同年級學生，以鈴木彩這個身份當做偽裝。"},{"spoiler":false,"text":"和數名同樣是來出身自忍者之里的忍者一同組成組織，"},{"spoiler":false,"text":"並且立於指揮作戰的立場。"},{"spoiler":false,"text":"在男主角進到這所學校前一個月搬過來，"},{"spoiler":false,"text":"似乎至今為止都在調查這周邊一帶，不過男主角完全沒有察覺。"},{"spoiler":false,"text":"在學校裡頭是個帥氣的角色，沒有親暱的友人。"}],"source":"bangumi","sourceCharacterId":"49097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8b466657b40ef62654d79e6f1ca2b12c878f041384c1db0f6891f4abfaad1fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0fab56ffa2fcea14668c779c66f2d7a12080998c7332b3e1f7997a2169861e0.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231797:49097:5928:1","source":"bangumi"}]},{"characterId":"char_c66437","characterName":"猫飼 律","sourceIds":{"bangumi":[{"characterId":"59693","match":"exact-normalized-name-in-linked-work","subjectId":"232395"},{"characterId":"59693","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"59693","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["18483"],"vndbCharacterId":"c66437"},"originalCharacterName":"猫飼 律","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"街に出没する謎の猫忍者。"},{"spoiler":false,"text":"自らが属する組織を『里見八忍（にゃん）』と名乗っているが、詳細は謎に包まれている。"},{"spoiler":false,"text":"多彩な術を駆使する凄腕の忍者で、未だに彩羽とその一派から逃げおおせている。"},{"spoiler":false,"text":"少しがさつで、口調はにゃんにゃんしている。"},{"spoiler":false,"text":"主人公を狙って過去に接触を計ってきたこともあるという。"},{"spoiler":false,"text":"敵意はなさそうだが、一方で風魔を『敵』と断定していたりも。"},{"spoiler":false,"text":"主人公は過去のやりとりから悪い猫ではないと思っているようだが？"}],"source":"egs","sourceCharacterId":"18483","sourceWorkId":"26216","spoiler":false},{"segments":[{"spoiler":false,"text":"前回の騒動後、主人公の家の庭で暮らし始めた猫耳忍者。"},{"spoiler":false,"text":"里見八忍（にゃん）の筆頭の肩書に恥じない、真面目な頑張り屋さん。"},{"spoiler":false,"text":"その分、勢いが大事な局面ではだいたい出遅れる。"},{"spoiler":false,"text":"何かと損をする長女タイプ。"},{"spoiler":false,"text":"仲間のシノが陽葵と共に現れたことには戸惑いを隠せていない。"}],"source":"egs","sourceCharacterId":"18483","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"里見八忍筆頭、みんなの頼れるリーダー。"},{"spoiler":false,"text":"持ち前の世話焼き（あるいはおせっかい）スキルで、仲間達を支えている。"},{"spoiler":false,"text":"言い換えれば苦労性。"},{"spoiler":false,"text":"実妹であるチカとは、性格の不一致などもあって昔から衝突が絶えなかった。"},{"spoiler":false,"text":"主である北条春希は律のそういう性分を察してフォローに余念がない。"},{"spoiler":false,"text":"当然のように心優しい春希様のことが大好き。"},{"spoiler":false,"text":"万能型と称されるほど、忍法・体術・剣技などあらゆるスキルに長じている。"},{"spoiler":false,"text":"まさにリーダー、もしくは器用貧乏型勇者タイプ。"}],"source":"egs","sourceCharacterId":"18483","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"街に出没する謎の猫忍者。"},{"spoiler":false,"text":"自らが属する組織を『里見八忍（にゃん）』と名乗っているが、詳細は謎に包まれている。"},{"spoiler":false,"text":"多彩な術を駆使する凄腕の忍者で、"},{"spoiler":false,"text":"未だに彩羽とその一派から逃げおおせている。"},{"spoiler":false,"text":"少しがさつで、口調はにゃんにゃんしている。"},{"spoiler":false,"text":"主人公を狙って過去に接触を計ってきたこともあるという。"},{"spoiler":false,"text":"敵意はなさそうだが、"},{"spoiler":false,"text":"一方で風魔を『敵』と断定していたりも。"},{"spoiler":false,"text":"主人公は過去のやりとりから"},{"spoiler":false,"text":"悪い猫ではないと思っているようだが？"}],"source":"bangumi","sourceCharacterId":"59693"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba52ccdf990f390265c44c1149be164a26aa0ea920cca7d053bd624821354f8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88e52e89d40fd37322ce46806b808b05a3486d043372163b4787537d849629af.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231797:59693:17075:1","source":"bangumi"}]},{"characterId":"char_c66438","characterName":"猫山 マヤ","sourceIds":{"bangumi":[{"characterId":"59694","match":"exact-normalized-name-in-linked-work","subjectId":"269282"},{"characterId":"59694","match":"exact-normalized-name-in-linked-work","subjectId":"441480"},{"characterId":"59694","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["21302"],"vndbCharacterId":"c66438"},"originalCharacterName":"猫山 マヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"律と同じく里見八忍（にゃん）の一員であり、誇り高き猫忍うさぎ。"},{"spoiler":false,"text":"皆から愛されてるのかどうなのか、今日もいじられてはぷりぷり元気に怒っている。"},{"spoiler":false,"text":"自分の実力不足を痛感して日夜修行に励んでいるらしいが、今のところ目立った成長はない模様。"},{"spoiler":false,"text":"当面の目標は腕立て伏せ５０回。道は遠い。"},{"spoiler":false,"text":"シノと律が現状、対立していることには素直に「ひええ」と思っている。"},{"spoiler":false,"text":"具体的にどうこうというのはない。"}],"source":"egs","sourceCharacterId":"21302","sourceWorkId":"27895","spoiler":false},{"segments":[{"spoiler":false,"text":"ぽっちゃりわがままボディがトレードマーク(？)の、うさぎの猫忍。"},{"spoiler":false,"text":"北条に仕える忍者の中では、まあまあ古株。"},{"spoiler":false,"text":"好きな食べ物はおいしい野菜と果物。"},{"spoiler":false,"text":"苦手なものは運動(断言)。"},{"spoiler":false,"text":"日々、ぐーたら食っちゃ寝しているし悪びれる様子もない。"},{"spoiler":false,"text":"可愛いのがお仕事。"},{"spoiler":false,"text":"…のはすが、今回は数合わせ的に首根っこ掴まれて雑賀の調査に連れてこられた。"}],"source":"egs","sourceCharacterId":"21302","sourceWorkId":"34551","spoiler":false},{"segments":[{"spoiler":false,"text":"里見八忍の可愛い担当。師であるサトミ様も認める愛されうさぎ。"},{"spoiler":false,"text":"……もとい、うさぎの猫忍。"},{"spoiler":false,"text":"先日は雑賀の騒乱を受け、はじめてのお使いを無事に完遂した。"},{"spoiler":false,"text":"たぬきのナナコともお友達になった。"},{"spoiler":false,"text":"もうこれで一生働いたと勝手に決めつけて、現在はぐーたら生活に戻っている。"},{"spoiler":false,"text":"そんなマヤのこともおおらかに受け入れてくれる、はるきのことが大好き。"},{"spoiler":false,"text":"戦闘スタイルというか得意技はにゃんにゃんダンス。"},{"spoiler":false,"text":"可愛いは正義、ゆえに最強。"}],"source":"egs","sourceCharacterId":"21302","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"記憶喪失のうさ耳忍者。"},{"spoiler":false,"text":"運動能力は普通の人間以下で、何をさせてもどんくさい。"},{"spoiler":false,"text":"得意忍法はにゃんにゃんダンス。（ただ可愛く踊るだけ）"},{"spoiler":false,"text":"相手次第で上手くいけば魅了の効果を発揮する。"},{"spoiler":false,"text":"野菜か果物しか食べられないが、かなりのグルメ。バナナが大好物。"},{"spoiler":false,"text":"何から何までうさぎなのだが、本人は「自分は猫である」と譲らない。"},{"spoiler":false,"text":"警戒心や不安から家に来た当初はピリピリしているが、"},{"spoiler":false,"text":"次第に主人公の人柄に惹かれていく。"}],"source":"bangumi","sourceCharacterId":"59694"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe0968def344e01ac755b1a5c98f1888b25a096759356a02f53136b670e173fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bcafcee23eab66f7ac18f27472d45ebc3e1779909bfe87489fba48d9008c8e2.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231797:59694:13368:1","source":"bangumi"}]},{"characterId":"char_c82427","characterName":"北条 春希","sourceIds":{"bangumi":[{"characterId":"179913","match":"exact-normalized-name-in-linked-work","subjectId":"571760"}],"egsCharacterIds":["28198"],"vndbCharacterId":"c82427"},"originalCharacterName":"北条 春希","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦国時代からこっそり続いている名門・北条家の一応は当主。"},{"spoiler":false,"text":"両親については謎に包まれている。"},{"spoiler":false,"text":"前章『猫忍えくすはーと』では風魔の里からやってきた、ゆらたまを受け入れ、様々な体験をふまえて立派に成長した（多分）。"},{"spoiler":false,"text":"現在は地元の大学に通いながら、北条の長としての今後に向けた準備を進めている。"},{"spoiler":false,"text":"新章主人公・菊丸達よりほんのちょっと年上。"},{"spoiler":false,"text":"性格は温厚で、ゆらたま達との関係も相変わらず。"},{"spoiler":false,"text":"みんなのことが大好き。"}],"source":"egs","sourceCharacterId":"28198","sourceWorkId":"39070","spoiler":false},{"segments":[{"spoiler":false,"text":"戦国時代からこっそり続いている名門・北条家の一応は当主。"},{"spoiler":false,"text":"両親については謎に包まれている。"},{"spoiler":false,"text":"前章『猫忍えくすはーと』では風魔の里からやってきた、ゆらたまを受け入れ、"},{"spoiler":false,"text":"様々な体験をふまえて立派に成長した（多分）。"},{"spoiler":false,"text":"現在は地元の大学に通いながら、北条の長としての今後に向けた準備を進めている。"},{"spoiler":false,"text":"新章主人公・菊丸達よりほんのちょっと年上。"},{"spoiler":false,"text":"性格は温厚で、ゆらたま達との関係も相変わらず。"},{"spoiler":false,"text":"みんなのことが大好き。"}],"source":"bangumi","sourceCharacterId":"179913"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"179913","value":"北条家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5bce00666776a6c57326d52abf89d99959320c31917c4a5a66ace057fc61d44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cf8d85c08826422242ba357342514d246fb3c243716df572b33316de38bded9.webp","width":236,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p273","sourceCompanyId":"egs:brand:1888","canonicalEntityId":"vndb:p273","name":"Whirlpool","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27527:1888","source":"egs"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:132167:v25673","source":"vndb"},{"companyId":"vndb:p24514","sourceCompanyId":"vndb:p24514","canonicalEntityId":"vndb:p24514","name":"Kuroneko Hashimoto","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:150275:v25673","source":"vndb"},{"companyId":"vndb:p273","sourceCompanyId":"vndb:p273","canonicalEntityId":"vndb:p273","name":"ワールプール","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:166137:v25673","source":"vndb"},{"companyId":"vndb:p273","sourceCompanyId":"vndb:p273","canonicalEntityId":"vnd