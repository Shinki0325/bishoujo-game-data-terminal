iptions":[{"segments":[{"spoiler":false,"text":"A regular girl living in a peaceful mountain village with her sister Miria. Has a slightly tomboyish, slightly spoiled personality. One day when returning from collecting herbs in the mountains, she finds a mysterious brooch and a fairy. The fairy bestows on her the power to transform into God's chosen warrior, the \"holy knight\", so she can face monsters in heated battles."},{"spoiler":false,"text":"From DLSite"}],"source":"vndb","sourceCharacterId":"c104318"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d906e3813fb6e2741b0d208ae5e7cc650b64f07e8d8a3acbda0b36b3821853c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96dfafa288a0276d000a7e25c3ce636e9f5ddd0694d8c1b9234ea4f60c8c989b.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋山 はるる","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90435","source":"vndb"}]},{"characterId":"char_vndb_c104319","characterName":"イーリス","sourceIds":{"vndbCharacterId":"c104319"},"originalCharacterName":"イーリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A servant of God from the village of fairies, Iris is the partner of the new holy knight, Ricca. Strong-willed, cool-headed and wise. She holds the power that enters the holy knight's body, and supports Ricca in combat."},{"spoiler":false,"text":"From DLSite"}],"source":"vndb","sourceCharacterId":"c104319"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b25dab835567ecb64e724b7e0a6c2ddcde802a938a28daef2b2b2aedbd574dbd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee2409e077d223dbeae30f8e25f15967a87353c911733e5d8e08da81c5d5aea3.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"涼貴 涼","creatorId":"vndb:s519","sourcePersonId":"vndb:s519","canonicalEntityId":"vndb:s519","name":"涼貴 涼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90433","source":"vndb"}]},{"characterId":"char_vndb_c104320","characterName":"ミリア","sourceIds":{"vndbCharacterId":"c104320"},"originalCharacterName":"ミリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ricca's sister, who is a fair bit older than her. Kindhearted, and the most beautiful woman in the village. She is prone to worrying, and finds it hard to let Ricca be independent. While Ricca is away collecting herbs, the village is attacked and Miria is captured by monsters and transformed into a succubus. Now a demon, and the natural foe of the holy knight, Miria captures Ricca and attempts to sexually subdue her."},{"spoiler":false,"text":"From DLSite"}],"source":"vndb","sourceCharacterId":"c104320"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4d0fc23d62101d6dcebfa18f03ca9db1c64da943d9cc5f66e1b0d637d6dc5ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6715f32dabdad78cd321fda5a43705deddbfa098cde315491e19f56620304c7.webp","width":172,"height":256,"sou