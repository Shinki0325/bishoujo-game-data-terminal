t","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"4?kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She uses 美姫 alias when streaming."}],"source":"vndb","sourceCharacterId":"c148413"},{"segments":[{"spoiler":false,"text":"妹、JK1年。勉強・運動そこそこな普通の子。胸はクラスで大きい方。"},{"spoiler":false,"text":"かなりの面倒くさがり屋で、家のことはすべて兄任せ状態。"},{"spoiler":false,"text":"将来、働かないでお金儲けできたら最高！と考えているダメ人間。"},{"spoiler":false,"text":"リアル友達を作るのもメンドイと思っておりネットフレンドの方が多いくらいの、ニート気質。"},{"spoiler":false,"text":"「エッチ生配信」を思いついて、配信者としてがんばるうちに、「他人に見られること」がだんだん楽しくなっていき…？"},{"spoiler":false,"text":"チャンネルでは「ミキたん」と呼ばれている。"},{"spoiler":false,"text":"おだてられるのに弱いお調子者な一面があり、「やって」と言われると結構やっちゃう。"},{"spoiler":false,"text":"配信中、実の兄妹であることを明言「は」していない。"}],"source":"egs","sourceCharacterId":"28078","sourceWorkId":"37843","spoiler":false},{"segments":[{"spoiler":false,"text":"「目指せ、みんなのいもうと！ 目指せ、トップエロ配信者！」"},{"spoiler":false,"text":"女子校生（現役？）エロ系配信者。"},{"spoiler":false,"text":"リスナーをお兄ちゃんと呼び、「みんなのいもうと」を目指している。"},{"spoiler":false,"text":"可愛くてノリが良くて、ちょっぴり抜けてる甘えん坊。"},{"spoiler":false,"text":"まだまだ成長してるエロカワボディをたっぷりご堪能ください。"},{"spoiler":false,"text":"今日も「みんなのいもうと」になるべく、エッチなライブ配信がんばるよ。"},{"spoiler":false,"text":"たくさんシコシコして、たくさんチャマネしてくれると嬉しいな～（ｖ）えへへっ（ｖ）"}],"source":"bangumi","sourceCharacterId":"171856"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"28078","sourceWorkId":"37843","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"28078","sourceWorkId":"37843","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"28078","sourceWorkId":"37843","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"28078","sourceWorkId":"37843","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https: