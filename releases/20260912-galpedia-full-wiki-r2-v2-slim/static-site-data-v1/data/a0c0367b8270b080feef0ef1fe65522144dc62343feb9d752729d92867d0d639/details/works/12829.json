v1/characters/v1/images/d7/d7734a003287518b99e030241a9ddc16709703e4dcf4c5b0d24df8d7e577b8b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a58bd4a86dc59ffe236743c501c1bd55218d91a10fb42f8ed631264bcd136da.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星野千寿子","creatorId":"vndb:s128","sourcePersonId":"vndb:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151031:143827:4210:1","source":"bangumi"}]},{"characterId":"char_c65810","characterName":"江口 茜","sourceIds":{"bangumi":[{"characterId":"143825","match":"exact-normalized-name-in-linked-work","subjectId":"151031"}],"egsCharacterIds":["14797"],"vndbCharacterId":"c65810"},"originalCharacterName":"江口 茜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の親友・江口誠の妹。"},{"spoiler":false,"text":"性格は明るく、社交的で友達も多い。さらにその可愛らしい容姿から先輩、後輩、そして同級生からと、全校の男子から人気がある。"},{"spoiler":false,"text":"兄との仲は非常に良好。"},{"spoiler":false,"text":"兄を通して主人公とは面識があり、幼い頃から主人公に密かに恋心を抱いていたが、未だに想いを伝えられないでいる。そのため、昔は普通に話せた主人公とは、照れと恥ずかしさで、まったく話せなくなってしまった。"},{"spoiler":false,"text":"学園の先輩でもある高千穂若葉を女性として憧れていて、若葉の所属する陸上部に入部した。"}],"source":"egs","sourceCharacterId":"14797","sourceWorkId":"12829","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の親友・江口誠の妹。"},{"spoiler":false,"text":"性格は明るく、社交的で友達も多い。さらにその可愛らしい容姿から先輩、後輩、そして同級生からと、全校の男子から人気がある。"},{"spoiler":false,"text":"兄との仲は非常に良好。"},{"spoiler":false,"text":"兄を通して主人公とは面識があり、幼い頃から主人公に密かに恋心を抱いていたが、未だに想いを伝えられないでいる。そのため、昔は普通に話せた主人公とは、照れと恥ずかしさで、まったく話せなくなってしまった。"},{"spoiler":false,"text":"学園の先輩でもある高千穂若葉を女性として憧れていて、若葉の所属する陸上部に入部した。"}],"source":"bangumi","sourceCharacterId":"143825"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14797","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"14797","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"14797","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"14797","sourceWorkId":"12829","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ae825c7c6b485959e5c034a6a41dd12758322d8c86b57cec32d214990d38557.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db52be1f36ef61b330901a8869e17fade63a4c9eb9c8aedcd039ff319052a9f0.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151031:143825:4830:1","source":"bangumi"}]},{"characterId":"char_c973","characterName":"山城 美琴","sourceIds":{"bangumi":[{"characterId":"143821","match":"exact-normalized-name-in-linked-work","subjectId":"151031"}],"egsCharacterIds":["14795"],"vndbCharacterId":"c973"},"originalCharacterName":"山城 美琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mikoto is the elder of Yuuichi's two older sisters. She initially comes off as a very gentle girl that has taken it upon herself to look after the house as well as Yuuichi and Haruna. Because of this, she is responsible for the cooking and cleaning, giving her two younger siblings the time they need to focus on school and work. Incidentally, she has foregone the chance to go to college."},{"spoiler":false,"text":"Mikoto has come to occasionally rely on Yuuichi to help her with some of the household chores, particularly ones that involve machinery (something she admittedly is not very good with). Still, she seems to enjoy being the homemaker, and is known for her great cooking."},{"spoiler":false,"text":"While she is kind to everyone that crosses paths with her, Mikoto is generally nicer to Yuuichi than most, and often hints that she may look at him as something more than just her little brother. Out of the two sisters, she is the more forward one in terms of making advances on our protagonist. Along with her nice side, Mikoto is the deadlier of the Yamashiro sisters, as she has a tendency to punish Yuuichi in much harsher ways than anyone else."},{"spoiler":false,"text":"Much like Yuuichi puts his sisters above everything else, Mikoto puts Yuuichi's happiness above everything else. Still, she is driven by her attraction to the protagonist and her intense desire to always look after him."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c973"},{"segments":[{"spoiler":false,"text":"主人公の姉で、春奈の双子の姉。"},{"spoiler":false,"text":"とても面倒見が良いしっかりとした性格で、事故で亡くなった両親に代わって家事を中心に春奈と主人公の面倒を見ている。"},{"spoiler":false,"text":"家事は得意中の得意。努力家で、何事にも一生懸命。"},{"spoiler":false,"text":"ただし機械との相性は最悪らしく、かなりの機械オンチ。"},{"spoiler":false,"text":"いつも笑顔を絶やさない穏和な人柄だが、時々、思いも寄らぬ大胆な行動を取ることも多い。さらに怒らせるとやっかいな性格らしい。"},{"spoiler":false,"text":"「あら、おはよう、優くん。うふふ、大きなあくび……もしかして寝不足？」"}],"source":"egs","sourceCharacterId":"14795","sourceWorkId":"12829","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の姉で、春奈の双子の姉。"},{"spoiler":false,"text":"とても面倒見が良いしっかりとした性格で、事故で亡くなった両親に代わって家事を中心に春奈と主人公の面倒を見ている。"},{"spoiler":false,"text":"家事は得意中の得意。努力家で、何事にも一生懸命。"},{"spoiler":false,"text":"ただし機械との相性は最悪らしく、かなりの機械オンチ。"},{"spoiler":false,"text":"いつも笑顔を絶やさない穏和な人柄だが、時々、思いも寄らぬ大胆な行動を取ることも多い。さらに怒らせるとやっかいな性格らしい。"},{"spoiler":false,"text":"「あら、おはよう、優くん。うふふ、大きなあくび……もしかして寝不足？」"}],"source":"bangumi","sourceCharacterId":"143821"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"14795","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"14795","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"14795","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"14795","sourceWorkId":"12829","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8ace48d9ed6a53f0280eb98b86dbd7488a4311aef178d8d9e951e73e8442395.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/461586a8cb9b2951520489f6e0963a54ff8beed09dc030b9cac73d325fe9cef6.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151031:143821:4490:1","source":"bangumi"}]},{"characterId":"char_c974","characterName":"山城 春奈","sourceIds":{"bangumi":[{"characterId":"143822","match":"exact-normalized-name-in-linked-work","subjectId":"151031"}],"egsCharacterIds":["14796"],"vndbCharacterId":"c974"},"originalCharacterName":"山城 春奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruna is the younger of the Yamashiro sisters, and is introduced to the player as a girl whose self-imposed duty is to keep Yuuichi in check. She is a student at Chihara University (the same university attended by AneImo2's Kirishima Mizuki) and occupies the rest of her time with her part-time job as a waitress."},{"spoiler":false,"text":"Unlike her older sister, Haruna is more level-headed when it comes to dealing with Yuuichi. She has spent so much time around our protagonist that she has mastered the ability to read him. She's especially critical of Yuuichi's tendency to look at the women in his life with slightly ecchi eyes, and often calls him out on it as soon as she notices it. She also criticizes the protagonist due to his severe indecisiveness, especially when it comes to his relationship with Wakaba."},{"spoiler":false,"text":"Despite the strong and aggressive front she puts on around the protagonist, Haruna has a softer side that is very much in love with Yuuichi, but knows her attraction to him is unnatural due to them being siblings."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c974"},{"segments":[{"spoiler":false,"text":"主人公の姉で、美琴とは双子の妹。"},{"spoiler":false,"text":"美空学園卒業後、姉である美琴の強い進めもあり大学に進学した。現在、千原大学の2年生。"},{"spoiler":false,"text":"双子とはいえ二卵性のためか、大人しく控えめな雰囲気の美琴とは違い、非常に活発で、さばさばした性格。"},{"spoiler":false,"text":"社交上手で交友関係も広いが、ややシャイな部分があり、愛情を素直に表現できない所がある。"},{"spoiler":false,"text":"特に弟である優一には、ついつい意地悪な言動や暴力的な行動を取ったりしてしまうが、何だかんだで優一の面倒を見たり、助けたりしている。"},{"spoiler":false,"text":"「も～う、なにやってるのよ。ほら、ここ、口元にご飯粒がついてるわよ？　たく、子供たいなんだから」"}],"source":"egs","sourceCharacterId":"14796","sourceWorkId":"12829","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の姉で、美琴とは双子の妹。"},{"spoiler":false,"text":"美空学園卒業後、姉である美琴の強い進めもあり大学に進学した。現在、千原大学の2年生。"},{"spoiler":false,"text":"双子とはいえ二卵性のためか、大人しく控えめな雰囲気の美琴とは違い、非常に活発で、さばさばした性格。"},{"spoiler":false,"text":"社交上手で交友関係も広いが、ややシャイな部分があり、愛情を素直に表現できない所がある。"},{"spoiler":false,"text":"特に弟である優一には、ついつい意地悪な言動や暴力的な行動を取ったりしてしまうが、何だかんだで優一の面倒を見たり、助けたりしている。"},{"spoiler":false,"text":"「も～う、なにやってるのよ。ほら、ここ、口元にご飯粒がついてるわよ？　たく、子供たいなんだから」"}],"source":"bangumi","sourceCharacterId":"143822"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"14796","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"14796","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"14796","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"14796","sourceWorkId":"12829","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a80a489056e5df8ca3971d48697c96563792c62def9965247839555f4f1667a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/628a1b86cd14d2b897a5fab0f16e6bb3a3bd7055c5e553e56e4e4be9a96771b5.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒河奈美","creatorId":"vndb:s1062","sourcePersonId":"vndb:s1062","canonicalEntityId":"vndb:s1062","name":"黒河 奈美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151031:143822:4754:1","source":"bangumi"}]},{"characterId":"char_c975","characterName":"高千穂 若葉","sourceIds":{"bangumi":[{"characterId":"143824","match":"exact-normalized-name-in-linked-work","subjectId":"151031"},{"characterId":"143824","match":"exact-normalized-name-in-linked-work","subjectId":"271169"}],"egsCharacterIds":["9468"],"vndbCharacterId":"c975"},"originalCharacterName":"高千穂 若葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wakaba is a half-British, half-Japanese girl that has known Yuuichi since she started high school. She is easily recognizable given the fact that she's taller than most girls her age, not to mention her blonde hair."},{"spoiler":false,"text":"This heroine starts off as an athletic girl that has something of a crush on Yuuichi. This comes from the fact that she used to be someone who kept to herself all the time, and Yuuichi's friendship was pivotal to helping Wakaba find her own place in the school hierarchy. At present, however, she has a tendency to say what's on her mind, causing Yuuichi in particular to note that her words are usually straight and true without any frills."},{"spoiler":false,"text":"Due to her unique appearance and friendly disposition, Wakaba is seen as the \"school idol\". This image is further reinforced by her being a member of the school's track team, and even has a bit of a fan following attend track meets to see her. Interestingly, Wakaba wishes that her appearance wouldn't make her stand out so much, as she wants to be like everyone else."},{"spoiler":false,"text":"She is also the only character to truly see how our protagonist feels about his older sisters, and is admittedly envious of the special relationship Mikoto and Haruna have with Yuuichi."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c975"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"ボーイッシュな雰囲気を持ったハーフの女の子。"},{"spoiler":false,"text":"その美しい金髪と抜群のスタイルは学園でも一際目立っているが、本人はそういう部分で目立つことをあまり快く思っていない。"},{"spoiler":false,"text":"入学当初は、その日本人離れした容姿が何かと注目され、学校に馴染めずにいたが、主人公と交流のおかげで、元来の明るく活発な性格に取り戻し、男女を問わない人気者になった。"},{"spoiler":false,"text":"運動神経抜群の彼女だが、勉強はかなり苦手らしく、補習授業の常連となってしまっている。"},{"spoiler":false,"text":"「あは、ありがと。他の誰よりも、優一にそう言って貰えるのが…あたしは一番、嬉しいかも……」"}],"source":"egs","sourceCharacterId":"9468","sourceWorkId":"12829","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"ボーイッシュな雰囲気を持った日本人の父とイギリス人の母親を持つハーフ。"},{"spoiler":false,"text":"元気が良く活発な性格で学園でも男女問わずに人気があり、誰とでも気軽に話すことができるタイプ。"},{"spoiler":false,"text":"運動神経は抜群で学園では陸上部に所属していて走り高飛びの選手として活躍している。"},{"spoiler":false,"text":"ただし勉強はかなり苦手らしく、補習授業の常連となってしまっている。"},{"spoiler":false,"text":"体育会系少女ながらも家庭的な一面も強く、料理はかなり得意で、最近では大好きな優一の為に、毎日早起きして健気に手作りお弁当を作ってあげている。"},{"spoiler":false,"text":"夏休み前に優一の好きだという想いを告白し、お試し期間ということで二人は付き合うことになった。"},{"spoiler":false,"text":"そして屈曲紆余の果て、優一から恋人として付き合いたいと言われ、二人は仮ではなく正式に交際することとなった。"}],"source":"egs","sourceCharacterId":"9468","sourceWorkId":"16196","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"ボーイッシュな雰囲気を持った日本人の父とイギリス人の母親を持つハーフ。"},{"spoiler":false,"text":"元気が良く活発な性格で学園でも男女問わずに人気があり、誰とでも気軽に話すことができるタイプ。"},{"spoiler":false,"text":"運動神経は抜群で学園では陸上部に所属していて走り高飛びの選手として活躍している。"},{"spoiler":false,"text":"ただし勉強はかなり苦手らしく、補習授業の常連となってしまっている。"},{"spoiler":false,"text":"体育会系少女ながらも家庭的な一面も強く、料理はかなり得意で、最近では大好きな優一の為に、毎日早起きして健気に手作りお弁当を作ってあげている。"},{"spoiler":false,"text":"夏休み前に優一の好きだという想いを告白し、お試し期間ということで二人は付き合うことになった。"},{"spoiler":false,"text":"そして屈曲紆余の果て、優一から恋人として付き合いたいと言われ、二人は仮ではなく正式に交際することとなった。"}],"source":"bangumi","sourceCharacterId":"143824"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"9468","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"9468","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"9468","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"9468","sourceWorkId":"12829","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4d190c718d623db997494df761f13485c8c6ec7abfad85acf33a1682bf9a447.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca951e44499b53f32c4b7cb76810e30243d00ada820f4ee5c27b43f4f7b3b140.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永見はるか","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151031:143824:4674:1","source":"bangumi"}]},{"characterId":"char_c976","characterName":"藤枝 あやめ","sourceIds":{"bangumi":[{"characterId":"143823","match":"exact-normalized-name-in-linked-work","subjectId":"151031"},{"characterId":"143823","match":"exact-normalized-name-in-linked-work","subjectId":"271169"}],"egsCharacterIds":["9469"],"vndbCharacterId":"c976"},"originalCharacterName":"藤枝 あやめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayame is introduced as Haruna and Mikoto's former senpai from their days in high school. From the beginning, Yuuichi notices that Ayame is a very attractive woman, and is surprised to find out that she is actually a divorcee. Haruna and Mikoto are also surprised by this, commenting that Ayame had gotten married right after graduating high school."},{"spoiler":false,"text":"Having next to no experience when it comes to living on her own, Ayame eventually starts relying on the protagonist to help her with the basics. She also has him show her around town, and with his help has a very easy time getting used to her new home."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c976"},{"segments":[{"spoiler":false,"text":"お隣に引っ越してきた女性。"},{"spoiler":false,"text":"長く美しい黒髪が目立つ和風美人。"},{"spoiler":false,"text":"学園卒業後、大学に進学することなく結婚したが、徐々に夫との間に距離が開き、最終的に離婚してしまった。"},{"spoiler":false,"text":"美琴と春奈の二人とは、美空学園時代のテニス部の先輩、後輩で、今でも非常に親しい間柄。"},{"spoiler":false,"text":"奥ゆかしく、献身的な性格で、他人を思いやり、尽くすのが得意。反面、物事に消極的な一面もあり、物事をあれこれ考えすぎてストレスを溜め込むタイプでもある。そのせいか人付き合いは苦手で友人もあまり多くない。"},{"spoiler":false,"text":"「あの、本当にありがとうございました。その……優一さんがすぐ側にいてくれてよかったです……」"}],"source":"egs","sourceCharacterId":"9469","sourceWorkId":"12829","spoiler":false},{"segments":[{"spoiler":false,"text":"お隣に引っ越してきた元人妻。長く美しい黒髪が目立つ和風美人。"},{"spoiler":false,"text":"学園卒業後、大学に進学することなく結婚したが、家庭を顧みない夫との間に距離が開く。"},{"spoiler":false,"text":"さらに不妊症がだめ押しとなり旦那とは離婚してしまった元人妻。"},{"spoiler":false,"text":"あれこれと優一に世話を焼いてもらった結果、恋心が芽生えてしまい、ある日、ふとした偶然から優一と身体を重ね合ってしまう。"},{"spoiler":false,"text":"その後、互いに気持ちをハッキリさせないまま、関係を続けてしまうが、ダラダラとした関係を嫌った優一から想いを告白され、交際を申し込まれる。"},{"spoiler":false,"text":"しかし、あやめは自分が不妊症を患っていることを告げ、優一との交際を拒否。"},{"spoiler":false,"text":"それでも諦めきれずにアタックし続ける優一。"},{"spoiler":false,"text":"そんな優一の強い想いが伝わり、あやめは優一を受け入れ二人は正式に交際することになった。"},{"spoiler":false,"text":"恋人同士になった以降は、毎日のようにあやめの部屋を訪れ、愛の営み……子作りに励んでいる毎日を送っている。"}],"source":"egs","sourceCharacterId":"9469","sourceWorkId":"16196","spoiler":false},{"segments":[{"spoiler":false,"text":"お隣に引っ越してきた元人妻。長く美しい黒髪が目立つ和風美人。"},{"spoiler":false,"text":"学園卒業後、大学に進学することなく結婚したが、家庭を顧みない夫との間に距離が開く。"},{"spoiler":false,"text":"さらに不妊症がだめ押しとなり旦那とは離婚してしまった元人妻。"},{"spoiler":false,"text":"あれこれと優一に世話を焼いてもらった結果、恋心が芽生えてしまい、ある日、ふとした偶然から優一と身体を重ね合ってしまう。"},{"spoiler":false,"text":"その後、互いに気持ちをハッキリさせないまま、関係を続けてしまうが、ダラダラとした関係を嫌った優一から想いを告白され、交際を申し込まれる。"},{"spoiler":false,"text":"しかし、あやめは自分が不妊症を患っていることを告げ、優一との交際を拒否。"},{"spoiler":false,"text":"それでも諦めきれずにアタックし続ける優一。"},{"spoiler":false,"text":"そんな優一の強い想いが伝わり、あやめは優一を受け入れ二人は正式に交際することになった。"},{"spoiler":false,"text":"恋人同士になった以降は、毎日のようにあやめの部屋を訪れ、愛の営み……子作りに励んでいる毎日を送っている。"}],"source":"bangumi","sourceCharacterId":"143823"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"9469","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"9469","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"9469","sourceWorkId":"12829","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"9469","sourceWorkId":"12829","source