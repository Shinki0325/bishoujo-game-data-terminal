色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:149253","source":"vndb"}]},"cast":[{"characterId":"char_c71862","characterName":"みーたん","sourceIds":{"bangumi":[],"egsCharacterIds":["20080"],"vndbCharacterId":"c71862"},"originalCharacterName":"みーたん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"絶大なカリスマ性を持つ生徒会長。"},{"spoiler":false,"text":"学園では一ノ瀬美麗を名乗っているが、正体は双子の妹・雪亜。"},{"spoiler":false,"text":"本物の美麗は入学以来、一度も学園に来ていない。"},{"spoiler":false,"text":"台本があれば何者でも演じられるという特技を持ち、訳あって学園では姉の美麗に成り代わっている。そのため、表向きは「雪亜」が休学していることになっている。"},{"spoiler":false,"text":"素の雪亜は完全ぼっちのコミュ障で、日陰が大好き。"},{"spoiler":false,"text":"友達など皆無だったが、成り行きと持ち前の優しさから六花に「雪亜」としての身分を貸し与えて女装させ、「美麗」としては六花と主従関係を結んだパートナーとなる。"},{"spoiler":false,"text":"六花の主として、学園では彼と行動を共にすることが多く、灰からの熱い嫉妬を買っている。"}],"source":"egs","sourceCharacterId":"20080","sourceWorkId":"26943","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e1ff2120f70ed2a0b8c4682e08787132cadf4993a7b46cacbb2d1b59ff57f8e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2c42362a1396d110ff9b10c0962876b8d2a9222f35f9be18acdd73a27eed321.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杏 花","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77939","source":"vndb"}]},{"characterId":"char_c71863","characterName":"桜木 灰","sourceIds":{"bangumi":[{"characterId":"64191","match":"exact-normalized-name-in-linked-work","subjectId":"251030"}],"egsCharacterIds":["20081"],"vndbCharacterId":"c71863"},"originalCharacterName":"桜木 灰","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"自由奔放、賑やかすぎるやんちゃ娘。"},{"spoiler":false,"text":"六花とは従兄妹の関係で幼い頃に一目惚れして以来、「お兄様」と呼び慕い、一途な恋心を抱いている。"},{"spoiler":false,"text":"お兄様と結ばれるためなら手段を選ばず、脱獄、恐喝、陰謀も辞さない熱いハートの持ち主。"},{"spoiler":false,"text":"六花と出会った時に寝込んでいたせいで、病弱清楚なお嬢様だと誤解されてしまい、彼に嫌われぬようにと必死なってお嬢様を装っている。"},{"spoiler":false,"text":"ユキに六花との仲を取り持つようにと頼み、恋愛成就のための策謀にも毎回巻き込むが、相談相手がご本人だとはまるで気づいていない。"}],"source":"egs","sourceCharacterId":"20081","sourceWorkId":"26943","spoiler":false},{"segments":[{"spoiler":false,"text":"自由奔放、賑やかすぎるやんちゃ娘。"},{"spoiler":false,"text":"六花とは従兄妹の関係で幼い頃に一目惚れして以来、"},{"spoiler":false,"text":"「お兄様」と呼び慕い、一途な恋心を抱いている。"},{"spoiler":false,"text":"お兄様と結ばれるためなら手段を選ばず、"},{"spoiler":false,"text":"脱獄、恐喝、陰謀も辞さない熱いハートの持ち主。"},{"spoiler":false,"text":"六花と出会った時に寝込んでいたせいで、"},{"spoiler":false,"text":"病弱清楚なお嬢様だと誤解されてしまい、"},{"spoiler":false,"text":"彼に嫌われぬようにと必死なってお嬢様を装っている。"},{"spoiler":false,"text":"ユキに六花との仲を取り持つようにと頼み、"},{"spoiler":false,"text":"恋愛成就のための策謀にも毎回巻き込むが、"},{"spoiler":false,"text":"相談相手がご本人だとはまるで気づいていない。"}],"source":"bangumi","sourceCharacterId":"64191"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7c2f8044b0a04e5a8a8f1316dbddb00a5943ba52b52e0338bee180a6334fc6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0bdc85123232e9690d69362ee494a9106041206361847a3050b47b1b94b52fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:251030:64191:4727:1","source":"bangumi"}]},{"characterId":"