256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:251030:64192:10662:1","source":"bangumi"}]},{"characterId":"char_c71865","characterName":"夢乃 有珠","sourceIds":{"bangumi":[{"characterId":"64193","match":"exact-normalized-name-in-linked-work","subjectId":"251030"}],"egsCharacterIds":["20083"],"vndbCharacterId":"c71865"},"originalCharacterName":"夢乃 有珠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"飛び級入学してきた年下の先輩。六花を「おにいちゃん」と呼び慕う天真爛漫で純真無垢なラブリーガール。"},{"spoiler":false,"text":"高い高いや頭ナデナデをよくねだってきてくれる。"},{"spoiler":false,"text":"しかし難しいお年頃なのか、初対面の人には無愛想でぶっきらぼうなオールウェイズ不機嫌ガールに早変わり。"},{"spoiler":false,"text":"本人の希望もあり、監獄では看守役を務めている。"},{"spoiler":false,"text":"機械工学やプログラミングが得意なことを活かし、自作のドローンなどを使って脱走を防いだりする――が、心を開いた後は、みんなと一緒についつい遊んでしまう。"},{"spoiler":false,"text":"性知識がなく恥じらいもないので、パンツが見えても気にしない。"}],"source":"egs","sourceCharacterId":"20083","sourceWorkId":"26943","spoiler":false},{"segments":[{"spoiler":false,"text":"飛び級入学してきた年下の先輩。"},{"spoiler":false,"text":"六花を「おにいちゃん」と呼び慕う"},{"spoiler":false,"text":"天真爛漫で純真無垢なラブリーガール。"},{"spoiler":false,"text":"高い高いや頭ナデナデをよくねだってきてくれる。"},{"spoiler":false,"text":"しかし難しいお年頃なのか、初対面の人には無愛想で"},{"spoiler":false,"text":"ぶっきらぼうなオールウェイズ不機嫌ガールに早変わり。"},{"spoiler":false,"text":"本人の希望もあり、監獄では看守役を務めている。"},{"spoiler":false,"text":"機械工学やプログラミングが得意なことを活かし、"},{"spoiler":false,"text":"自作のドローンなどを使って脱走を防いだりする――が、"},{"spoiler":false,"text":"心を開いた後は、みんなと一緒についつい遊んでしまう。"},{"spoiler":false,"text":"性知識がなく恥じらいもないので、パンツが見えても気にしない。"}],"source":"bangumi","sourceCharacterId":"64193"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f43edf48bbc07666cbbd8ef67f05b23bb3f179e595fd408de110279c3695bd4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a63e5c7c00d330f8f820e14ce4615185a531abfc668e12c8ba62884449b7095b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:251030:64193:15995:1","source":"bangumi"}]},{"characterId":"char_c71866","characterName":"ユキ","sourceIds":{"bangumi":[{"characterId":"64189","match":"exact-normalized-name-in-linked-work","subjectId":"251030"}],"egsCharacterIds":["20079"],"vndbCharacterId":"c71866"},"originalCharacterName":"ユキ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"501"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"学園では執事を目指す男子生徒「伊吹六花」、監獄ではメイドの「ユキ」としての二重生活を送る。"},{"spoiler":false,"text":"入学以来ずっと休学している少女「一ノ瀬雪亜」の身分を借りて、女装メイドとして監獄に潜入した。"},{"spoiler":false,"text":"監獄のみんなからは「ユキ」と愛称で呼ばれている。"},{"spoiler":false,"text":"使用人としてはハイスペックで、4人のお嬢様のお世話をしながら家事までこなしている。"},{"spoiler":false,"text":"しかし、おっちょこちょいでビビり。反射的に謝ってしまうタイプ。"},{"spoiler":false,"text":"女装生活を続けているうちに心までも女子化しつつあるが、本人はそんな自分に気づいていない。"}],"source":"egs","sourceCharacterId":"20079","sourceWorkId":"26943","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公（ヒロイン）。"},{"spoiler":false,"text":"学園では執事を目指す男子生徒「伊吹六花」、"},{"spoiler":false,"text":"監獄ではメイドの「ユキ」としての二重生活を送る。"},{"spoiler":false,"text":"入学以来ずっと休学している少女「一ノ瀬雪亜」の身分を借りて、"},{"spoiler":false,"text":"女装メイドとして監獄に潜入した。"},{"spoiler":false,"text":"監獄のみんなからは「ユキ」と愛称で呼ばれている。"},{"spoiler":false,"text":"使用人としてはハイスペックで、"},{"spoiler":false,"text":"4人のお嬢様のお世話をしながら家事までこなしている。"},{"spoiler":false,"text":"しかし、おっちょこちょいでビビり。反射的に謝ってしまうタイプ。"},{"spoiler":false,"text":"女装生活を続けているうちに心までも女子化しつつあるが、"},{"spoiler":false,"text":"本人はそんな自分に気づいていない。"}],"source":"bangumi","sourceCharacterId":"64189"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6985e23b9eb1007c9ac462e69923878adb47b17ffcead2fd2c9f81016675b370.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00a6ce814be389f6fcfe61da791861e2fb990f303f725ea68a03cc6133a0ab76.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:251030:64189:13372:1","source":"bangumi"}]},{"characterId":"char_c71867","characterName":"あかり","sourceIds":{"bangumi":[{"characterId":"64194","match":"exact-normalized-name-in-linked-work","subjectId":"251030"}],"egsCharacterIds":["20084"],"vndbCharacterId":"c71867"},"originalCharacterName":"あかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人との距離感がちょお近い学園唯一のギャル。"},{"spoiler":false,"text":"芸術一家の出身で画家の卵。人知れず趣味で漫画を描いている。"},{"spoiler":false,"text":"ボディタッチが多い割にピュアな性格で、ハレンチな話題になるとすぐに顔を真っ赤にして照れる。"},{"spoiler":false,"text":"実は二重人格で「あかり」というもう一人の人格がいる。"},{"spoiler":false,"text":"コロナが眠った後に目覚め、全裸になって発情しながらえっちなイラストを描いている真性の変態。"},{"spoiler":false,"text":"なお、コロナはあかりの存在を知らない。"},{"spoiler":false,"text":"唐突な眠気の後、目が覚めたら「アレ？ 全裸？」状態。"},{"spoiler":false,"text":"そんな自分を「ちょおヤバくね……」と思いつつも、「ま、バレなきゃいっか」と数秒後には立ち直る。"},{"spoiler":false,"text":"割と深刻なことのはずなのにちょお軽い。流石ギャル。"}],"source":"egs","sourceCharacterId":"20084","sourceWorkId":"26943","spoiler":false},{"segments":[{"spoiler":false,"text":"人との距離感がちょお近い学園唯一のギャル。"},{"spoiler":false,"text":"芸術一家の出身で画家の卵。人知れず趣味で漫画を描いている。"},{"spoiler":false,"text":"ボディタッチが多い割にピュアな性格で、"},{"spoiler":false,"text":"ハレンチな話題になるとすぐに顔を真っ赤にして照れる。"},{"spoiler":false,"text":"けれど興味はあるのか、エッチに対する妄想力はとても高い。"},{"spoiler":false,"text":"実は二重人格で「あかり」というもう一人の人格がいる。"},{"spoiler":false,"text":"コロナが眠った後に目覚め、全裸になって発情しながら"},{"spoiler":false,"text":"18禁イラストを描いている真性の変態。おっぱい大好き星人。"},{"spoiler":false,"text":"なお、コロナはあかりの存在を知らない。"},{"spoiler":false,"text":"唐突な眠気の後、目が覚めたら「アレ？ 全裸？」状態。"},{"spoiler":false,"text":"そんな自分を「ちょおヤバくね……」と思いつつも、"},{"spoiler":false,"text":"「ま、バレなきゃいっか」と数秒後には立ち直る。"},{"spoiler":false,"text":"割と深刻なことのはずなのにちょお軽い。流石ギャル。"}],"source":"bangumi","sourceCharacterId":"64194"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0de691b0b30322dde83ec0ccced8a7670cd58b744aa5be69fd1e06d75325377.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e531e7a8d5a2dba2ce3efd1b2cd8463cecfb8c3279b7cfa204bb01724c6b297.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"京亜耶奈","creatorId":"vndb:s14782","sourcePersonId":"vndb:s14782","canonicalEntityId":"vndb:s14782","name":"京 亜耶奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:251030:64194:27805:1","source":"bangumi"}]},{"characterId":"char_vndb_c75547","characterName":"一ノ瀬 美麗","sourceIds":{"vndbCharacterId":"c75547"},"originalCharacterName":"一ノ瀬 美麗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://w