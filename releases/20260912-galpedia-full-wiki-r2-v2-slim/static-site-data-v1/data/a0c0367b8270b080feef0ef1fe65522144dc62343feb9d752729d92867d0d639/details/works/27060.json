Source":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪党退治が趣味の美少女剣客。"},{"spoiler":false,"text":"その正体は、江都幕府八代将軍・ 徳河吉宗。"},{"spoiler":false,"text":"清廉潔白で気高く、正義感が強い道徳者。"},{"spoiler":false,"text":"伝家の宝刀「雷刀・ 成敗」を振るい、江都にはびこる悪を斬る！"},{"spoiler":false,"text":"恋も愛も破廉恥なことも知らずに育ったため、跡継ぎ問題が浮上中。"}],"source":"egs","sourceCharacterId":"17720","sourceWorkId":"25912","spoiler":false},{"segments":[{"spoiler":false,"text":"悪党退治が趣味の美少女剣客。"},{"spoiler":false,"text":"その正体は、江都幕府八代将軍・ 徳河吉宗。"},{"spoiler":false,"text":"清廉潔白で気高く、正義感が強い道徳者。"},{"spoiler":false,"text":"伝家の宝刀「雷刀・ 成敗」を振るい、江都にはびこる悪を斬る！"},{"spoiler":false,"text":"恋も愛も破廉恥なことも知らずに育ったため、跡継ぎ問題が浮上中。"},{"spoiler":false,"text":"「私の顔を見忘れましたか？」"}],"source":"bangumi","sourceCharacterId":"59369"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e347e96d672dfe5b161f88189d952d2010c07288c982d9766c83cea35341ecf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/533cfeb5dad3c735677fcce3ee28acc875678987032367ce34967fed3c085913.webp","width":145,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:241835:59369:17075:1","source":"bangumi"}]},{"characterId":"char_c65042","characterName":"宮本 信行","sourceIds":{"bangumi":[{"characterId":"68744","match":"exact-normalized-name-in-linked-work","subjectId":"221987"}],"egsCharacterIds":["17719"],"vndbCharacterId":"c65042"},"originalCharacterName":"宮本 信行","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A normal High School student in the modern years, who died in a traffic accident. He ends up reincarnating into the past in the body of a samurai warrior in the Edo period. He retains all memories of his previous life, but also attains a secret katana technique from the samurai that makes him an unstoppable warrior. Under his new life in Japan's past, he meets pretty girls and strange people on his journey to uncover the mystery of a 'hidden treasure.'"},{"spoiler":true,"text":"in Tamaki route, it's reveal Nobuyuki and Tamaki came to Edo period via body swap method with hidden treasure \"Soul reflection mirror (反魂鏡)\"."},{"spoiler":true,"text":"and switch between Real Kamiizuki Nobuyuki and Mitsui Tama's soul."},{"spoiler":true,"text":"They did total 3 time."},{"spoiler":true,"text":"1. in Kamikakushi case and traffic accident."},{"spoiler":true,"text":"2. in last fight with Muramasa, Tamaki switch herself and Nobuyuki 's soul."},{"spoiler":true,"text":"3. Back to their original periods."},{"spoiler":true,"text":"After back to modern years he join Kendo club and meet Retsuzan again."}],"source":"vndb","sourceCharacterId":"c65042"},{"segments":[{"spoiler":false,"text":"秘宝の力で江都時代にタイムスリップした、穏やかな物腰の青年。"},{"spoiler":false,"text":"意思を持つチート刀「 霊刀・ 烈斬」を手に、江都最強の剣客として大活躍することに。"},{"spoiler":false,"text":"ヒーロー願望があり、巻き込まれ体質。"},{"spoiler":false,"text":"貧乏くじを引くことが多いが、本人は気にしていない。"}],"source":"egs","sourceCharacterId":"17719","sourceWorkId":"25912","spoiler":false},{"segments":[{"spoiler":false,"text":"秘宝の力で江都時代にタイムスリップした、穏やかな物腰の青年。"},{"spoiler":false,"text":"意思を持つチート刀「 霊刀・ 烈斬」を手に、"},{"spoiler":false,"text":"江都最強の剣客として大活躍することに。"},{"spoiler":false,"text":"ヒーロー願望があり、巻き込まれ体質。"},{"spoiler":false,"text":"貧乏くじを引くことが多いが、本人は気にしていない。"}],"source":"bangumi","sourceCharacterId":"68744"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bis