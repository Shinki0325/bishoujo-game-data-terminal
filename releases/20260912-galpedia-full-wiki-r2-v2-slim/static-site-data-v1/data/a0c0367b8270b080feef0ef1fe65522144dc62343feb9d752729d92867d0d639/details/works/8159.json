:[{"spoiler":false,"text":"A great magician and phantom thief."},{"spoiler":false,"text":"He heard the protagonist holds the greatest gem in the world so he appears to steal it."},{"spoiler":false,"text":"Ignoring the protagonist's pleas that she doesn't have the stone he forcibly stays close to her in order to find a chance to obtain it."},{"spoiler":false,"text":"An arrogant guy who easily makes assumptions about things and only thinks in ways that are convenient for him, but somehow you just can't hate him."}],"source":"vndb","sourceCharacterId":"c45553"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89b6ffec4d8cbd0191f0c544ae8d34259af9f206132cc9fea20b5f2d0a78e60b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5465dc57a7a2108994b22c970a2b1d6acb6a133533e90c6b351cbaf346fba6ad.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮野 真守","creatorId":"vndb:s242","sourcePersonId":"vndb:s242","canonicalEntityId":"vndb:s242","name":"宮野真守","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24119","source":"vndb"}]},{"characterId":"char_vndb_c45554","characterName":"森泉 晴音","sourceIds":{"vndbCharacterId":"c45554"},"originalCharacterName":"森泉 晴音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"His voice, uniform, and behavior is completely feminine, but he is 100% just a guy that is obsessed with cross-dressing."},{"spoiler":false,"text":"Surprisingly he's actually a high ranked cadet in a certain country's army."},{"spoiler":false,"text":"By orders of the top brass of his homeland he is supposed to assassinate the protagonist and take possession of the 'bewitching pyroxene' stone."},{"spoiler":false,"text":"But after he infiltrated close to her his perplexingly quick approach made the fact that he is actually a guy become known."}],"source":"vndb","sourceCharacterId":"c45554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10d02988851d5cff9bfcf3dce348fc9cb5215dd50f705e41dfd0a3e3a9a1c8a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a437f25cbaf7d9e5677031941bb82cb422535b2f68ff83d51e1812be6ff9d0bd.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水 亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24122","source":"vndb"}]},{"characterId":"char_vndb_c45555","characterName":"瑞穂 昴","sourceIds":{"vndbCharacterId":"c45555"},"originalCharacterName":"瑞穂 昴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Appears 17~ years old."},{"spoiler":false,"text":"An angel that appears before the protagonist to warn her that some demons are after her."},{"spoiler":false,"text":"He was supposed to return to heaven right away, but because he was worried about the protagonist being attacked he stayed behind to look after her."},{"spoiler":false,"text":"He has a kind and angelic personality and he treats everybody fairly."}],"source":"vndb","sourceCharacterId":"c45555"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4e14c94d7774c827599db08f62a69b0fc07099982