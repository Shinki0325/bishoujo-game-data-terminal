"spoiler":false,"text":"由宇からは幼い頃にイジメを受けており、それが今日の彼の人格形成に大きな影響を及ぼしている。"}],"source":"bangumi","sourceCharacterId":"58980"}],"profileFacts":[{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"15200","sourceWorkId":"12589","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"65 kg","valueContext":null,"source":"egs","sourceCharacterId":"15200","sourceWorkId":"12589","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5e35a1f1dff37e3e3099a9189758fd341d39ae2778d021515a0b064dad318c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61191f45ac1dd1c332e39cf9c5097ad52a7c62d32821fca52d146ee0ca4c2fa5.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c23876","characterName":"柏原 由宇","sourceIds":{"bangumi":[{"characterId":"58979","match":"exact-normalized-name-in-linked-work","subjectId":"78761"}],"egsCharacterIds":["15199"],"vndbCharacterId":"c23876"},"originalCharacterName":"柏原 由宇","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"214"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"進学のため、田舎から上京してきた主人公の従妹。"},{"spoiler":false,"text":"主人公の部屋に下宿することになる。"},{"spoiler":false,"text":"幼い頃から良家のお嬢様として、周囲の大人たちに愛想を振りまき、良い子を演じ続けてきたため、本当の自分を誰にもさらせないようになってしまった。"},{"spoiler":false,"text":"主人公は自分の本当の姿をさらし、ワガママを聞いてくれる存在であるが、特に恋心を抱いているわけでもなく、ペット程度の認識でしかない。"},{"spoiler":false,"text":"幼い頃に両親にほとんどかまって貰えず、寂しい思いをしてきた。そのため、表面上は強がっているが、本当は寂しがり屋で、誰かに甘えたい。"}],"source":"egs","sourceCharacterId":"15199","sourceWorkId":"12589","spoiler":false},{"segments":[{"spoiler":false,"text":"春から進学するために、田舎から東京にやってきた女の子。"},{"spoiler":false,"text":"幼い頃から良家のお嬢様として大人の中で生活しているうちに、誰にでも愛想を振りまき、自"},{"spoiler":false,"text":"分の本心を内にしまい続ける女の子になってしまった。"},{"spoiler":false,"text":"藤四郎だけが自分の我侭を聞いてくれる唯一の存在であるが、だからといって恋心などはなく、ペット程度の認識しかない。"},{"spoiler":false,"text":"幼い頃に両親に殆ど構ってもらえなかったことから、強がってはいるが寂しがり屋な面ももつ。"}],"source":"bangumi","sourceCharacterId":"58979"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"15199","sourceWorkId":"12589","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"15199","sourceWorkId":"12589","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"15199","sourceWorkId":"12589","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"15199","sourceWorkId":"12589","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"15199","sourceWorkId":"12589","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9f0c15ed6493b355c6c195a7ac58b297f63ec7e39f6152638246362eb3006c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d27b42879dda72f29bd514491eadf3e5c29f6c416b4f6b2116010c3261d2002.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s