oiler":false},{"segments":[{"spoiler":false,"text":"レシーバーを務める3年生。"},{"spoiler":false,"text":"紗織が入部した時からの仲良しで、あまり先輩らしくない。"},{"spoiler":false,"text":"勘が鋭いが、それを活かす能力が未発達で活かし切れていない。"},{"spoiler":false,"text":"料理が得意だが、奇妙なミックスドリンクに凝っていて、よく部員たちが餌食になっている。"},{"spoiler":false,"text":"本人曰く 「すごい力がつく」 らしいが、効果はまったく無い？"},{"spoiler":false,"text":"「それでしたら、この『やよいスペシャルドリンクNo3』を……」"}],"source":"bangumi","sourceCharacterId":"45820"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"1923","sourceWorkId":"19365","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"1923","sourceWorkId":"19365","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"1923","sourceWorkId":"19365","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"1923","sourceWorkId":"19365","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45c9643956a2d1d120530ad049a0d9c53136885395ed8985b8b39e7f096da16e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9748a1302d336ec35dc65d418ea36cf9e172f0c935a64dc7c07c41552bbcb04b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54446","source":"vndb"}]},{"characterId":"char_c15937","characterName":"雛森 杏","sourceIds":{"bangumi":[{"characterId":"45821","match":"exact-normalized-name-in-linked-work","subjectId":"83273"}],"egsCharacterIds":["1924"],"vndbCharacterId":"c15937"},"originalCharacterName":"雛森 杏","characterNameSour