"identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"犬耳・尻尾付きの神様。 無口で感情表現が乏しい。"},{"spoiler":false,"text":"非常に人見知りが激しく、主人公が近付いても最初は怯えられるだけ。"},{"spoiler":false,"text":"葉子にだけ懐いている。"},{"spoiler":false,"text":"そのくせ好奇心旺盛という、ややこしい性格の持ち主。"},{"spoiler":false,"text":"神様というより座敷わらしに近い？　一度懐くと、それこそ犬のようにどこにでもついてくる。"},{"spoiler":false,"text":"水杜神社に祀られている神様で、付近の霊や妖怪の力を “殺生石” に封じている。"},{"spoiler":false,"text":"そのため妖怪たちは、この “殺生石” を狙っている。"}],"source":"egs","sourceCharacterId":"8368","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社に住む犬耳尻尾付きの神様。"},{"spoiler":false,"text":"幹也や音羽姉妹との生活で人見知りは大分なりを潜めた。"},{"spoiler":false,"text":"ただし相変わらず口数は少なく、慣れていない人の前ではあまり感情を出さない。"},{"spoiler":false,"text":"その心根は優しい。"}],"source":"egs","sourceCharacterId":"8368","sourceWorkId":"30006","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社に住む犬耳尻尾付きの神様。"},{"spoiler":false,"text":"幹也や音羽姉妹との生活で人見知りは大分なりを潜めた。"},{"spoiler":false,"text":"ただし相変わらず口数は少なく、慣れていない人の前ではあまり感情を出さない。"},{"spoiler":false,"text":"その心根は優しい。"}],"source":"bangumi","sourceCharacterId":"87303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1a3fa8d86b7c52519f01719397a9c54f3787a2b735e7011460ff83a7bb0e9f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75f91d2c9346b59d8f4e858d866472bcbf9176f14772f8d0c4d9fce638f2ec0f.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"静木亜美","creatorId":"vndb:s663","sourcePersonId":"vndb:s663","canonicalEntityId":"vndb:s663","name":"静木 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:431863:87303:8575:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2720","sourceCompanyId":"egs:brand:2720","canonicalEnti