:"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“亮”の妹。"},{"spoiler":false,"text":"優しい、朗らか、成績優秀、おしとやかな外見、運動も得意と何でもできる優等生。"},{"spoiler":false,"text":"しかしそれは演じている姿でしかなく、その本質は黒い。"},{"spoiler":false,"text":"幼少の頃より甘やかされて育ち、わがままな性格に育っている。"},{"spoiler":false,"text":"しかし幼少の頃から計算だかく、両親の前では大人しくしていた方がいろいろと捗ることに気づき、親の前であってもいい子を演じていた。"},{"spoiler":false,"text":"唯一、兄である主人公に対して自分を偽ってもメリットが少ないため、他人の見ていないところでは“亮”に対して強気に出ることでストレスを発散していた。"},{"spoiler":false,"text":"独占欲が強く嫉妬深いところもあり“亮”に彼女を作らせない。"},{"spoiler":false,"text":"物語開始時点では“亮”に対して恋愛感情を抱いているわけではなく、ストレス＆性欲発散用のおもちゃ（所有物）といった認識。"},{"spoiler":false,"text":"性的知識は同年代と比べても豊富。"},{"spoiler":false,"text":"処女。"}],"source":"egs","sourceCharacterId":"1943","sourceWorkId":"19242","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"1943","sourceWorkId":"19242","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"1943","sourceWorkId":"19242","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"1943","sourceWorkId":"19242","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"1943","sourceWorkId":"19242","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"1943","sourceWorkId":"19242","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49e5d6a0eaff687c3997ab0fdacde5c159ed99b32ec65f87ecab97d6cff9bdbd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fd05d43f73c25516ef8b0385c38c50fb9fc63f19aeda3237515c569ad37de6d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笹塚 真琴","creatorId":"vndb:s7113","sourcePers