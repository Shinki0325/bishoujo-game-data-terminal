b"}]},"cast":[{"characterId":"char_c19533","characterName":"ハルカ","sourceIds":{"bangumi":[{"characterId":"46675","match":"exact-normalized-name-in-linked-work","subjectId":"104336"}],"egsCharacterIds":["3759"],"vndbCharacterId":"c19533"},"originalCharacterName":"ハルカ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"214"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Status: Succubus"},{"spoiler":false,"text":"Hobbies: Flirting with girls (only in delusions)"},{"spoiler":false,"text":"Likes: Girls"},{"spoiler":false,"text":"Dislikes: Ghosts and other paranormal things, thunder, screams"}],"source":"vndb","sourceCharacterId":"c19533"},{"segments":[{"spoiler":false,"text":"女の子が大好きで、女の子の精気を吸うために人間界にやってきたサキュバスの少女。"},{"spoiler":false,"text":"なかなか目当ての女の子に出会えず力尽きてしまったところを、優奈、紗奈の姉妹に偶然助けられて、なんだかんだで打ち解けることになる。"},{"spoiler":false,"text":"その後、勝手に居候なんかすることになったり。"},{"spoiler":false,"text":"最初は２人から精気を吸ってやろうと色々画策していたが、仲良くなるうちに、気持ちの伴わない触れ合いは、魅力がないと感じるようになる。"},{"spoiler":false,"text":"それはいつしか、淡い恋心に変わってゆくことに……。"},{"spoiler":false,"text":"基本は欲望の赴くままに生きている。アホっぽいけれど、意外と根は真面目。"},{"spoiler":false,"text":"自分勝手に見えて、実は口下手なだけで、内心では意外とテンパっている時が多いへたれちゃん。"},{"spoiler":false,"text":"魔界ではそれなりにいいところのお嬢様。"}],"source":"egs","sourceCharacterId":"3759","sourceWorkId":"19725","spoiler":false},{"segments":[{"spoiler":false,"text":"女の子が大好きで、女の子の精気を吸うために人間界にやってきたサキュバスの少女。"},{"spoiler":false,"text":"なかなか目当ての女の子に出会えず力尽きてしまったところを、優奈・紗奈の姉妹に偶然助けられて、なんだかんだで打ち解けることになる。 その後、勝手に居候なんかすることになったり。"},{"spoiler":false,"text":"基本は欲望の赴くままに生きている。 アホっぽいけれど意外と根はまじめ。"},{"spoiler":false,"text":"自分勝手に見えて実は口下手なだけで、内心では意外とテンパっている時が多いへたれちゃん。"},{"spoiler":false,"text":"魔界ではそれなりにいいところのお嬢様。"},{"spoiler":false,"text":"「じゃあ、ちょっとだけ、ぎゅってしていい……？　そしたらなんか、変われる気がする、から……///」"}],"source":"bangumi","sourceCharacterId":"46675"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"46675","value":"女の子"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"46675","value":"お化け、雷、絶叫系"},{"label":"趣味","source":"bangumi","sourceCharacterId":"46675","value":"女の子といちゃいちゃ（妄想だけ）"},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"3759","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"3759","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"3759","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"3759","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"44 kg","valueContext":null,"source":"egs","sourceCharacterId":"3759","sourceWorkId":"19725","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39aa230d63ab2ba26f64cf420614c0eea46262c9a8dbbecc830f5cbfb8444afd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bacf7db29b5bfc1b0bbbb680576cd456c954abab3f897957374328eda16fbd86.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:104336:46675:6046:1","source":"bangumi"}]},{"characterId":"char_c19534","characterName":"広瀬 優奈","sourceIds":{"bangumi":[{"characterId":"46676","match":"exact-normalized-name-in-linked-work","subjectId":"104336"}],"egsCharacterIds":["3760"],"vndbCharacterId":"c19534"},"originalCharacterName":"広瀬 優奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"415"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Status: Human"},{"spoiler":false,"text":"Likes: Sana"}],"source":"vndb","sourceCharacterId":"c19534"},{"segments":[{"spoiler":false,"text":"紗奈の姉。"},{"spoiler":false,"text":"明るくて誰とでも仲良くなれる、ふんわり天然系よい子ちゃん。時々腹黒く見えるのは気のせい。"},{"spoiler":false,"text":"男子からも女子からも人気があるが、本人はそれを鼻にかけたりしない。"},{"spoiler":false,"text":"ハルカのことは、最初こそただの人助け感覚で接していたものの、なんだかんだで自分たちを気遣い心を開いてくれた彼女の態度を気に入り、いつの間にか親友扱いしていたり。"},{"spoiler":false,"text":"また、妹の紗奈のことも溺愛していて、割とぼんやりしている自分のフォロー役として信頼しきっている。"},{"spoiler":false,"text":"が、紗奈本人からは、若干うざがられ気味。でもめげない。"},{"spoiler":false,"text":"マイペースながらも、これと決めたら一直線に我が道を行くタイプ。"},{"spoiler":false,"text":"何かに一生懸命なハルカの姿を、ずっと応援していてあげたいと思いつつ、その気持ちには名前をつけられないまま、まぁいっか、というノリでいる。"}],"source":"egs","sourceCharacterId":"3760","sourceWorkId":"19725","spoiler":false},{"segments":[{"spoiler":false,"text":"紗奈の姉。 明るくて誰とでも仲良くなれる、ふんわり天然系よい子ちゃん。 時々腹黒く見えるのは気のせい。"},{"spoiler":false,"text":"男子からも女子からも人気があるが、本人はそれを鼻にかけたりしない。"},{"spoiler":false,"text":"ハルカのことは、最初こそただの人助け感覚で接していたものの、なんだかんだで自分たちを気遣い心を開いてくれた彼女の態度を気に入り、いつの間にか親友扱いしていたり。"},{"spoiler":false,"text":"妹の紗奈も溺愛していて、わりとぼんやりしている自分のフォロー役として信頼しきっている。"},{"spoiler":false,"text":"が、紗奈本人からは若干ウザがられ気味。でもめげない。"},{"spoiler":false,"text":"マイペースながらも、これと決めたら一直線に我が道を行くタイプ。"},{"spoiler":false,"text":"「ねぇねぇ、ハルカちゃん、今日はどこ寄って帰る？　わたしは、ハルカちゃんと一緒ならどこでもいいよ？」"}],"source":"bangumi","sourceCharacterId":"46676"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"46676","value":"甘いもの、紗奈をかわいがる"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"46676","value":"苦いもの、辛いもの"},{"label":"趣味","source":"bangumi","sourceCharacterId":"46676","value":"お菓子作り"},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"3760","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"3760","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"3760","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"3760","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"3760","sourceWorkId":"19725","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/003710ab0636ced1caed55e086d7359489311f90f3963b5a858d5ec9cd8d2eb9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6548e72ecb63a392c9970f90dcb819bec6fbe7ae6903a66e3421535f0a5690a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早瀬弥生","creatorId":"vndb:s936","sourcePersonId":"vndb:s936","canonicalEntityId":"vndb:s936","name":"早瀬 弥生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:104336:46676:11647:1","source":"bangumi"}]},{"characterId":"char_c19535","characterName":"広瀬 紗奈","sourceIds":{"bangumi":[{"characterId":"46677","match":"exact-normalized-name-in-linked-work","subjectId":"104336"}],"egsCharacterIds":["3761"],"vndbCharacterId":"c19535"},"originalCharacterName":"広瀬 紗奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1009"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Status: Human"},{"spoiler":false,"text":"Hobbies: Sewing"},{"spoiler":false,"text":"Likes: Cute things"},{"spoiler":false,"text":"Dislikes: Talking with unknown people"}],"source":"vndb","sourceCharacterId":"c19535"},{"segments":[{"spoiler":false,"text":"優奈の妹。"},{"spoiler":false,"text":"普段の言動は大人しくて、やや人見知り気味。"},{"spoiler":false,"text":"しかし、表に出すのが苦手なだけで、内心では意外と感情的だったりする。"},{"spoiler":false,"text":"意外と行動力があったり、時々小悪魔的な一面も。"},{"spoiler":false,"text":"ベタベタと構ってくる優奈のことは、鬱陶しいからと邪険に扱うものの、本当は大好き。"},{"spoiler":false,"text":"それを伝えることは、なかなかしないけれど。"},{"spoiler":false,"text":"ハルカに対しては、最初こそそれなりに警戒する部分があったものの、一度迫られて以降は彼女に興味津々で、いわゆる一目惚れしてしまった状態。"},{"spoiler":false,"text":"元々かわいいものが好きで～、というところから、いつしか彼女自身に憧れを抱くようになり、その想いは恋心と呼べる気持ちにまで発展してゆく。"},{"spoiler":false,"text":"優奈からかわいい系の衣装を着せられてよく嫌がっているのだが、かなり似合う。"},{"spoiler":false,"text":"別に自分がかわいい格好したいわけじゃなくて、見ているのが好きなだけなんだけど……。"}],"source":"egs","sourceCharacterId":"3761","sourceWorkId":"19725","spoiler":false},{"segments":[{"spoiler":false,"text":"優奈の妹。 普段の言動はおとなしくて、やや人見知り気味。"},{"spoiler":false,"text":"しかし表に出すのが苦手なだけで、内心では意外と感情的だったりする。"},{"spoiler":false,"text":"意外と行動力があったり、時々小悪魔的な一面も。"},{"spoiler":false,"text":"ベタベタと構ってくる優奈のことは鬱陶しいからと邪険に扱うものの、本当は大好き。"},{"spoiler":false,"text":"それを伝えることは、なかなかしないけれど。"},{"spoiler":false,"text":"ハルカに対しては、最初こそそれなりに警戒する部分があったものの、一度迫られて以降は彼女に興味津々で、いわゆる一目惚れしてしまった状態。"},{"spoiler":false,"text":"元々かわいいものが好きで～、というところから、いつしか彼女自身に憧れを抱くようになり、その想いは恋心と呼べる気持ちにまで発展してゆく。"},{"spoiler":false,"text":"「たまには、お姉ちゃんばかりじゃなく、私のことも構ってくれていいんですよ……///」"}],"source":"bangumi","sourceCharacterId":"46677"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"46677","value":"かわいいもの全般（隠している）"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"46677","value":"知らない人と話す"},{"label":"特技","source":"bangumi","sourceCharacterId":"46677","value":"裁縫、細かい作業"},{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"3761","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"3761","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"3761","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"3761","sourceWorkId":"19725","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"41 kg","valueContext":null,"source":"egs","sourceCharacterId":"3761","sourceWorkId":"19725","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a69e354f7a2ae8ec31151afe8f5bfe5b211bd0581eb42cca69c444e4d737e03.webp","fallbackUrl":"https://wiki-assets.bishojo.da