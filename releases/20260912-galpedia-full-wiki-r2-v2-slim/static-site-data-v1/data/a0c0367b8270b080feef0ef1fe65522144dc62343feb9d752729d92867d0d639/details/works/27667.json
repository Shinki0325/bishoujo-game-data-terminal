ate":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a serious person who wears a uniform and is the school council president where Aoki transferred to."},{"spoiler":false,"text":"Despite her strict personality, she is popular among both men and women."},{"spoiler":false,"text":"She is especially popular among the boys, partly because of her strange and lewd behavior when she eats."},{"spoiler":false,"text":"However, when she is alone and out of the public eye, she is rather careless."},{"spoiler":false,"text":"If she is not careful, her tongue tends to loll out on its own."},{"spoiler":false,"text":"Her true identity is that of a ghost, Youkai."},{"spoiler":false,"text":"She likes to clean up the grime in the men's restroom."},{"spoiler":false,"text":"When the main character comes to do his business, he witnesses the scene and has relations with her in order to keep her appearance in the school without saying a word."}],"source":"vndb","sourceCharacterId":"c82199"},{"segments":[{"spoiler":false,"text":"真面目が制服を着た性格で、青樹が転入してきた先の生徒会長をしている。"},{"spoiler":false,"text":"厳しい性格だが男女問わずに人気。"},{"spoiler":false,"text":"特に男子から絶大な人気を博し、理由の一つが食事の際に妙にエロい仕草であるため。"},{"spoiler":false,"text":"しかし人目がない一人の時は、わりとズボラで隙が多い。"},{"spoiler":false,"text":"気を張っていないと、勝手に舌が出てしまうのが悩み。"},{"spoiler":false,"text":"正体は妖怪の垢嘗。"},{"spoiler":false,"text":"一般的な風呂や桶等に溜まった垢を嘗め取るのと違い、同属からもそれはないだろ、と思われているくらい、男子便所の垢を嘗めるのが好き。"},{"spoiler":false,"text":"用を足しに来た主人公に現場を目撃されてしまい、学園内での体面を黙ってて貰う為に関係を持つ。"}],"source":"egs","sourceCharacterId":"20943","sourceWorkId":"27667","spoiler":false},{"segments":[{"spoiler":false,"text":"真面目が制服を着た性格で、青樹が転入してきた先の生徒会長をしている。"},{"spoiler":false,"text":"厳しい性格だが男女問わずに人気。"},{"spoiler":false,"text":"特に男子から絶大な人気を博し、理由の一つが食事の際に妙にエロい仕草であるため。"},{"spoiler":false,"text":"しかし人目がない一人の時は、わりとズボラで隙が多い。"},{"spoiler":false,"text":"気を張っていないと、勝手に舌が出てしまうのが悩み。"},{"spoiler":false,"text":"正体は妖怪の垢嘗。"},{"spoiler":false,"text":"一般的な風呂や桶等に溜まった垢を嘗め取るのと違い、同属からもそれはないだろ、と思われているくらい、男子便所の垢を嘗めるのが好き。"},{"spoiler":false,"text":"用を足しに来た主人公に現場を目撃されてしまい、学園内での体面を黙ってて貰う為に関係を持つ。"}],"source":"bangumi","sourceCharacterId":"188498"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"20943","sourceWorkId":"27667","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"20943","sourceWorkId":"27667","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"20943","sourceWorkId":"27667","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"20943","sourceWorkId":"27667","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3598c41616da8bdcc27b415c78705d766c7b4773f957b57be22f8a7ea99cdde8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e1a946cc88fd6aa6593181e40ce667bcae90babe57265990bb78eb6d4810e84.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野上結生","creatorId":"vndb:s3364","sourcePersonId":"vndb:s3364","canonicalEntityId":"vndb:s3364","name":"野上結生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279396:188498:31794:1","source":"bangumi"}]},{"characterId":"char_c82200","characterName":"川屋 華","sourceIds":{"bangumi":[{"characterId":"188499","match":"exact-normalized-name-in-linked-work","subjectId":"279396"}],"egsCharacterIds":["20944"],"vndbCharacterId":"c82200"},"originalCharacterName":"川屋 華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"701"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aoki and Kokoro's classmate who wears a very small nari."},{"spoiler":false,"text":"She is a very high spirit. While others wear school uniforms, she is the only one who wears gothic lolita fashion, and often skips class."},{"spoiler":false,"text":"She is a very neat and clean person, and is a living wife that loves to clean the school building when it is empty."},{"spoiler":false,"text":"Her true identity is Hanako-san of Shimoiire, the school's yokai."},{"spoiler":false,"text":"She resembles Zashiki Doji, and it is said that the school will prosper when she is around."}],"source":"vndb","sourceCharacterId":"c82200"},{"segments":[{"spoiler":false,"text":"非常に小さいナリをした、青樹とこころの同級生。"},{"spoiler":false,"text":"かなり自由人で、他が制服を着る中、一人ゴスロリなファッションを身につけていたり、授業もサボる事が多い。"},{"spoiler":false,"text":"非常に綺麗好きで、マメで気配り上手であり、人がいなくなった校舎内を掃除をするのが生き甲斐。"},{"spoiler":false,"text":"正体は学校の妖怪トイレの花子さん。"},{"spoiler":false,"text":"座敷童子に似ており彼女がいつく学校は栄えるという。"}],"source":"egs","sourceCharacterId":"20944","sourceWorkId":"27667","spoiler":false},{"segments":[{"spoiler":false,"text":"非常に小さいナリをした、青樹とこころの同級生。"},{"spoiler":false,"text":"かなり自由人で、他が制服を着る中、一人ゴスロリなファッションを身につけていたり、授業もサボる事が多い。"},{"spoiler":false,"text":"非常に綺麗好きで、マメで気配り上手であり、人がいなくなった校舎内を掃除をするのが生き甲斐。"},{"spoiler":false,"text":"正体は学校の妖怪トイレの花子さん。"},{"spoiler":false,"text":"座敷童子に似ており彼女がいつく学校は栄えるという。"}],"source":"bangumi","sourceCharacterId":"188499"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","va