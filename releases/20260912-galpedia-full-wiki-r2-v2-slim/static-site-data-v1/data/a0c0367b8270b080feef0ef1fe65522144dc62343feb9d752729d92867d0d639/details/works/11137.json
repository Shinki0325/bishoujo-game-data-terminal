idate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"公立鉢ヶ谷学園の保険医兼菅凪神社の非常勤の巫女。"},{"spoiler":false,"text":"双葉の母・一葉の年の離れた妹（叔母さん）。"},{"spoiler":false,"text":"非常におしとやかな女性で、ミチルや双葉の姉のような存在。"},{"spoiler":false,"text":"しっかり者で聡明だが酒癖が悪く、お酒が入ると別人のように荒れた性格になる上、淫乱な女性になってしまう。本人は変貌後のことは記憶にない。"},{"spoiler":false,"text":"小鳥遊母子との関係は良好で、双葉とも仲がいい。"},{"spoiler":false,"text":"だが、双葉はミチルが千鳥と親しくしてたりすると嫉妬の炎を燃やす。"},{"spoiler":false,"text":"双葉は学校外では「千鳥おばちゃん」と呼んで、あくまでも「貴方みたいな年増はミチルの対象外」という意識付けを行っている。"},{"spoiler":false,"text":"千鳥はおばちゃんと呼ばれるたびに苦い顔をする。"},{"spoiler":false,"text":"自分に彼氏がいないのは、こんな田舎で暮らしてるせいだ、と思っているが、実際は酒癖の悪さによるもの。"},{"spoiler":false,"text":"おしとやかな外見に似合わず、合気道の有段者。"}],"source":"egs","sourceCharacterId":"17764","sourceWorkId":"11137","spoiler":false},{"segments":[{"spoiler":false,"text":"公立鉢ヶ谷学園の保険医兼、菅凪神社の非常勤の巫女。"},{"spoiler":false,"text":"双葉の母・一葉の年の離れた妹（叔母さん）。"},{"spoiler":false,"text":"非常におしとやかな女性で、ミチルや双葉の姉のような存在。"},{"spoiler":false,"text":"しっかり者で聡明だが酒癖が悪く、お酒が入ると別人のように荒れた性格になる上、淫乱な女性になってしまう。本人は変貌後のことは記憶にない。"},{"spoiler":false,"text":"小鳥遊母子との関係は良好で、双葉とも仲がいい。"},{"spoiler":false,"text":"だが、双葉はミチルが千鳥と親しくしていたりすると嫉妬の炎を燃やす。"},{"spoiler":false,"text":"双葉は学園外では「千鳥おばちゃん」と呼んで、あくまでも『貴方みたいな年増はミチルの対象外』という意識付けを行っている。千鳥はおばちゃんと呼ばれるたびに苦い顔をする。"}],"source":"bangumi","sourceCharacterId":"38894"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"17764","sourceWorkId":"11137","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"17764","sourceWorkId":"11137","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"17764","sourceWorkId":"11137","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"17764","sourceWorkId":"111