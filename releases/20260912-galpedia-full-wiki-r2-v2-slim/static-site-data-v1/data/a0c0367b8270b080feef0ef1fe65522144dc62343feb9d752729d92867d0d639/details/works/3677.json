{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3677","model":{"presentationWorkId":"vndb:v2354","staff":{"artwork":[{"creditedName":"林原ひかり","creatorId":"vndb:s6712","sourcePersonId":"egs:creator:2640","canonicalEntityId":"vndb:s6712","name":"林原ひかり","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7970","source":"egs"}],"scenario":[{"creditedName":"木全 伸治","creatorId":"vndb:s534","sourcePersonId":"vndb:s534","canonicalEntityId":"vndb:s534","name":"木全 伸治","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:34160","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c37727","characterName":"観月 りんね","sourceIds":{"bangumi":[{"characterId":"143911","match":"exact-normalized-name-in-linked-work","subjectId":"181323"},{"characterId":"143911","match":"exact-normalized-name-in-linked-work","subjectId":"181342"}],"egsCharacterIds":["14462"],"vndbCharacterId":"c37727"},"originalCharacterName":"観月 りんね","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『いもうと妊娠』のヒロイン。"},{"spoiler":false,"text":"観月家の長女。学生。主人公・智之の年の離れた妹。"},{"spoiler":false,"text":"天真爛漫で明るくやんちゃな女の子。"},{"spoiler":false,"text":"胸も膨らみ始め、ようやく自分が女であることを認識し出した。それにともなって性についても興味が抱き始めている。"},{"spoiler":false,"text":"しかし、まだ無邪気な年頃ゆえに、無防備な格好をしてしまう。"},{"spoiler":false,"text":"主人公が毎夜自分の部屋に忍び込んで、自分をオカズにしてオチン○ンを弄っていることに対して見て見ぬふりをしていた。それは彼女自身も主人公を愛してしまっていたから……。"}],"source":"egs","sourceCharacterId":"14462","sourceWorkId":"13011","spoiler":false},{"segments":[{"spoiler":false,"text":"セミロングの髪にサイドで三つ編みを作っており、"},{"spoiler":false,"text":"それを束ねるリボンのよく似合う少女。"},{"spoiler":false,"text":"胸はようやく膨らみかけてきた。陰毛はちょぼちょぼ。"},{"spoiler":false,"text":"普段は明るく、兄にいたづらやちょっかいを出してくる、軽いおてんば。"},{"spoiler":false,"text":"兄が毎夜自分の部屋に忍び込み、オナニーをしているのを見てみぬフリをしている。"},{"spoiler":false,"text":"しかし、彼女は自分を思ってくれてる兄を愛しく思っている。"},{"spoiler":false,"text":"性については拙いながらも、学校の保健の授業程度の知識は有。"}],"source":"bangumi","sourceCharacterId":"143911"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05e0244dcf4a49d0a82333ec6ff76287782bb9ddaeec4e0241342c2bb0bacc15.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68ba37ab238725f98f42df74d2a57e5d0f645e988a1eec815f630a5ed65eda0d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しまだかおり","creatorId":"vndb:s2665","sourcePersonId":"vndb:s2665","canonicalEntityId":"vndb:s2665","name":"しまだ かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181342:143911:18664:1","source":"bangumi"}]},{"characterId":"char_vndb_c77755","characterName":"観月 智之","sourceIds":{"vndbCharacterId":"c77755"},"originalCharacterName":"観月 智之","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55628dc4a06a119e4ce24743b2c36efbf99fe0735a329af16f5c7b2d27552bd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29fa9449114f7ddb8b8126236d684baf7cc58cc170559c908bab8701d719b90d.webp","width":206,"height":221,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p765","sourceCompanyId":"egs:brand:1121","canonicalEntityId":"vndb:p765","name":"わるきゅ～れ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3677:1121","source":"e