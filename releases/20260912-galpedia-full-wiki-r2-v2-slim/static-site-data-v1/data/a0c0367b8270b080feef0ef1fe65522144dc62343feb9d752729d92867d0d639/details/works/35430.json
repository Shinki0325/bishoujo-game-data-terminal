r":false,"text":"Favorite food: Gâteau au chocolat (her true love is takoyaki)"},{"spoiler":false,"text":"Relationship goal: “I’d be happy if we could always be together.”"},{"spoiler":false,"text":"Translated and edited from the official website"},{"spoiler":false,"text":"In Fandisc: Height: 156cm, B93-W57-H87cm, G cup"}],"source":"vndb","sourceCharacterId":"c100706"},{"segments":[{"spoiler":false,"text":"同じ学園に通うクラスメイトで幼なじみ。"},{"spoiler":false,"text":"理事長の孫娘。プリンセスの愛称でみんなから慕われている。"},{"spoiler":false,"text":"人前ではおしとやかなレディーを演じているが、実際は明るくて活発な女の子。"}],"source":"egs","sourceCharacterId":"23837","sourceWorkId":"31752","spoiler":false},{"segments":[{"spoiler":false,"text":"同じ学園に通うクラスメイトで幼なじみ。"},{"spoiler":false,"text":"理事長の孫娘。プリンセスの愛称でみんなから慕われている。"},{"spoiler":false,"text":"人前ではおしとやかなレディーを演じているが、"},{"spoiler":false,"text":"実際は明るくて活発な女の子。"}],"source":"bangumi","sourceCharacterId":"101967"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2419ed62f990df663feba7150c74884b86d2e01fe2256f6ab09c9d7cdaa372b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/773e87dfd90dc5e3653461aa3d5e71b23619adc16f65e209cb2236dff418acf6.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:465811:101967:13368:1","source":"bangumi"}]},{"characterId":"char_c100707","characterName":"八重沢 やえ","sourceIds":{"bangumi":[{"characterId":"101966","match":"exact-normalized-name-in-linked-work","subjectId":"337543"}],"egsCharacterIds":["23838"],"vndbCharacterId":"c100707"},"originalCharacterName":"八重沢 やえ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bir