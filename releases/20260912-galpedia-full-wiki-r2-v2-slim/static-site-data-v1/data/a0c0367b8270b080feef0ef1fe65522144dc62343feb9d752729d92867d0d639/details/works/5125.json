{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"5125","model":{"presentationWorkId":"vndb:v4639","staff":{"artwork":[{"creditedName":"あるて","creatorId":"vndb:s2663","sourcePersonId":"egs:creator:2284","canonicalEntityId":"vndb:s2663","name":"あるて","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:8887","source":"egs"}],"scenario":[{"creditedName":"春日森(家宇治森)","creatorId":"vndb:s594","sourcePersonId":"egs:creator:2484","canonicalEntityId":"vndb:s594","name":"春日森(家宇治森)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:8888","source":"egs"},{"creditedName":"安斎兵梧","creatorId":"vndb:s2976","sourcePersonId":"egs:creator:2840","canonicalEntityId":"vndb:s2976","name":"安斎兵梧","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:9050","source":"egs"}],"music":[],"other":[{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:51765","source":"vndb"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:51766","source":"vndb"}]},"cast":[{"characterId":"char_c28817","characterName":"若宮 恭子","sourceIds":{"bangumi":[{"characterId":"94339","match":"exact-normalized-name-in-linked-work","subjectId":"266100"}],"egsCharacterIds":["26667"],"vndbCharacterId":"c28817"},"originalCharacterName":"若宮 恭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が閑職に配置転換される前の女上司。既婚者。一児の母。"},{"spoiler":false,"text":"バリバリのキャリアウーマンで、男に負けることを嫌い、女を見下すような男にはあからさまな嫌悪な態度を示す。"},{"spoiler":false,"text":"女を卑下しているように感じる主人公も好ましく思っていない。"},{"spoiler":false,"text":"同じ会社に勤める夫は、若手の有望株として期待され、おしどり夫婦として会社内外でも評判。"}],"source":"egs","sourceCharacterId":"26667","sourceWorkId":"5125","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の上司にあたる女性。"},{"spoiler":false,"text":"男に負けじとバリバリと働いている。気が強く言いたい事をズケズケというため、男性社員からのウケは大きく二つに分かれている。 女性を性の対象としか見ない男性には強い嫌悪を抱き、何度か男性社員達とセクハラに関わるトラブルを起こしている。主人公の言動の端々から女性を卑下するようなものを感じ、強い嫌悪を抱いている。 彼女は結婚しており一児の母でもある、夫は同じ会社で若手の有望株として期待されている。夫はおしどり夫婦として近所でも会社でも評判の仲のいい夫婦。"}],"source":"bangumi","sourceCharacterId":"94339"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca1c69d459bea5528c19f06c6853922f0dcae3e2f6e6a290cdec4bbe5725abec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9231be54a37533f241955aefd701dbd150860fe896637012d9a9026b921bf08.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c28818","characterName":"水谷 美緒","sourceIds":{"bangumi":[{"characterId":"94340","match":"exact-normalized-name-in-linked-work","subjectId":"266100"}],"egsCharacterIds":["26668"],"vndbCharacterId":"c28818"},"originalCharacterName":"水谷 美緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公を罠に陥れた同僚・沼田正裕の婚約者。"},{"spoiler":false,"text":"新入社員として入社し、その育ちの良いお嬢様然とした優しい性格とか可愛らしい容姿から、社内ではアイドル的な人気を博している。"},{"spoiler":false,"text":"沼田にいい様に利用され、主人公を罠に陥れるも、良心の呵責と罪悪感に苛まれている。"}],"source":"egs","sourceCharacterId":"26668","sourceWorkId":"5125","spoiler":false},{"segments":[{"spoiler":false,"text":"新人社員。同僚の沼田と婚約している。"},{"spoiler":false,"text":"よい所のお嬢様のせいか優しい性格、世間知らずでおっとりとした所が目立つ。会社の皆からはアイドル的な扱いをされている。想いを抱くと一途な性格で、沼田にいいように利用されている側面があっても大抵の事は呑んでしまう。本編中では、不承不承ながら沼田のために主人公を陥れる策略に協力し、強い罪悪感を抱くことに……。"}],"source":"bangumi","sourceCharacterId":"94340"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3b5a3fce5a1c275f9486efe0ce8c35732544a07f79f35b71d2d61f2285b1eef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3642207ef1e5638d8ce46b8ab6dcb100c0f4bdbf26e4aa359bcc718abd72c382.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266100:94340:24747:1","source":"bangumi"}]},{"characterId":"char_vndb_c155989","characterName":"高城 和之","sourceIds":{"vndbCharacterId":"c155989"},"originalCharacterName":"高城 和之","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1413","sourceCompanyId":"egs:brand:1023","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:5125:1023","source":"egs"},{"companyId":"vndb:p1413","sourceCompanyId":"vndb:p1413","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10438:v4639","source":"vndb"},{"companyId":"vndb:p1413","sourceCompanyId":"vndb:p1413","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["developer","publisher"],"identityStatus":"sour