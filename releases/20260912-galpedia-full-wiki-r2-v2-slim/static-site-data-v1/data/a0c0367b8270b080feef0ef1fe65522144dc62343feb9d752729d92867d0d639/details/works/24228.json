{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"24228","model":{"presentationWorkId":"vndb:v20285","staff":{"artwork":[{"creditedName":"そらモチ","creatorId":"vndb:s2740","sourcePersonId":"egs:creator:21860","canonicalEntityId":"vndb:s2740","name":"そらモチ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:171805","source":"egs"}],"scenario":[{"creditedName":"曠日弥久","creatorId":"vndb:s11657","sourcePersonId":"egs:creator:28380","canonicalEntityId":"vndb:s11657","name":"曠日弥久","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:172440","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c54362","characterName":"クレオパトラ 7世","sourceIds":{"bangumi":[{"characterId":"48430","match":"exact-normalized-name-in-linked-work","subjectId":"197685"}],"egsCharacterIds":["11753"],"vndbCharacterId":"c54362"},"originalCharacterName":"クレオパトラ 7世","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"紀元前69年 1月 （70年 12月の説もあり）"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界で初めてフェラチオをした女性であり、百人の護衛を相手にヌキまくったという逸話も。"},{"spoiler":false,"text":"さらに女王でありながら売春でも大人気。"},{"spoiler":false,"text":"時のローマ帝国の権力者であるカエサルを籠絡するため自らを使ったことも……。"}],"source":"egs","sourceCharacterId":"11753","sourceWorkId":"24228","spoiler":false},{"segments":[{"spoiler":false,"text":"古代エジプトにおいて絶大なる権勢を誇った伝説の女王様。 愛称はパトラ。"},{"spoiler":false,"text":"世界三大美女と称えられるだけの美貌と巨乳の持ち主だが、性格は極めて自分勝手。"},{"spoiler":false,"text":"身の回りの世話を全て召使い任せにしていたので、自分ひとりでは何も出来ない。"},{"spoiler":false,"text":"かつては100人の男を相手にフェラで抜いたとされ、エッチに対してはかなり積極的。"},{"spoiler":false,"text":"自殺したと伝えられていたが、実はエジプトの秘儀で転生していた。"},{"spoiler":false,"text":"しかし彼女が転生した先は、しがないサラリーマンのワンルームマンションだった。「よいか、そなたはわらわの召使いなのじゃ。 己が立場を忘れるでないぞ！」"}],"source":"bangumi","sourceCharacterId":"48430"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8324a4fe3462920b2973426ccb05b359ecbe7037628b366cdc4d5a1d6236f6a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b822985ca80885a3529adb2faf3a62d7ceaeccba1f3ed65e45e228397c415f75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71695","source":"vndb"}]},{"characterId":"char_vndb_c54363","characterName":"文月 史矢","sourceIds":{"vndbCharacterId":"c54363"},"originalCharacterName":"文月 史矢","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2738","sourceCompanyId":"egs:brand:3544","canonicalEntityId":"vndb:p2738","name":"Atelier G/H","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:24228:3544","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:rele