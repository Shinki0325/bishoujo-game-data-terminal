Id":"vndb:vn-staff:39517","source":"vndb"},{"creditedName":"エチゴヤ","creatorId":"vndb:s14902","sourcePersonId":"vndb:s14902","canonicalEntityId":"vndb:s14902","name":"エチゴヤ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39518","source":"vndb"},{"creditedName":"佐藤 輝政","creatorId":"vndb:s14905","sourcePersonId":"vndb:s14905","canonicalEntityId":"vndb:s14905","name":"佐藤 輝政","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39519","source":"vndb"},{"creditedName":"ZERO1","creatorId":"vndb:s31353","sourcePersonId":"vndb:s31353","canonicalEntityId":"vndb:s31353","name":"たなか れい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39520","source":"vndb"},{"creditedName":"チドウ","creatorId":"vndb:s37396","sourcePersonId":"vndb:s37396","canonicalEntityId":"vndb:s37396","name":"チドウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39521","source":"vndb"},{"creditedName":"ななほし","creatorId":"vndb:s38370","sourcePersonId":"vndb:s38370","canonicalEntityId":"vndb:s38370","name":"ななほし","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39522","source":"vndb"}]},"cast":[{"characterId":"char_c29470","characterName":"月丘 あゆみ","sourceIds":{"bangumi":[{"characterId":"204663","match":"exact-normalized-name-in-linked-work","subjectId":"50346"}],"egsCharacterIds":["16006"],"vndbCharacterId":"c29470"},"originalCharacterName":"月丘 あゆみ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編主人公兼ヒロイン。"},{"spoiler":false,"text":"近代未来工科学園に通う一年生。自称日本一不幸な少女。"},{"spoiler":false,"text":"母親はなく、まるで働かない父と二人きりの貧乏生活を送っていた。"},{"spoiler":false,"text":"しかしその父親が借金を残したまま急逝し、その借金返済のため、舞台となる裏風俗店「バニーハウス・ウサミ」で働くことになった。"},{"spoiler":false,"text":"苦労してきただけあって、年不相応にしっかりしており、真面目だが、何処か抜けている。"},{"spoiler":false,"text":"セックス経験はないが、小学生の頃からオナニーしていたほどのスケベ娘で、そのエッチのキャパシティは底が見えない。"},{"spoiler":false,"text":"夜の仕事を通じて、徐々に露見していく自分の性癖に戦々恐々としている。"}],"source":"egs","sourceCharacterId":"16006","sourceWorkId":"11757","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公兼ヒロイン。近代未来工科学園に入学したばかりの1年生。"},{"spoiler":false,"text":"『母親がいない』 『父親が働かない』 『家が超貧乏』と、3重苦を背負っている。"},{"spoiler":false,"text":"苦労してきた分、年の割に真面目でしっかりしているが、どこか抜けているため色々と翻弄されることも。"},{"spoiler":false,"text":"エッチの経験はなく処女。ただし小学生の頃からオナニーをしていたほどのスケベ娘で、エッチのキャパは底なし。"},{"spoiler":false,"text":"夜の仕事で徐々に露見していく自分の性癖に戦々恐々。"}],"source":"bangumi","sourceCharacterId":"204663"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52bdd0fa7cc06b7bc20f8621ca1cbd41407e745eceb33221d2661dd295fa01a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c401364fa2d51a767765d2a9832799a2d7608f34f4fdf8e8ea27ee25c015710d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50346:204663:6351:1","source":"bangumi"}]},{"characterId":"char_c29471","characterName":"宇佐美 皆兎","sourceIds":{"bangumi":[{"characterId":"204664","match":"exact-normalized-name-in-linked-work","subjectId":"50346"}],"egsCharacterIds":["16008"],"vndbCharacterId":"c29471"},"originalCharacterName":"宇佐美 皆兎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"あゆみが働く裏風俗店「バニーハウス・ウサミ」の店長。"},{"spoiler":false,"text":"実は、あゆみの通う近代未来工科学園の先輩でもある。"},{"spoiler":false,"text":"あゆみを気に入り、親身になって相談に乗ってくれる。"},{"spoiler":false,"text":"しかしその一方であゆみを苛めて楽しむ、サディストの顔を持つ。"},{"spoiler":false,"text":"あゆみは、そんな彼を「鬼畜」「笑顔が蛇」と罵りながらも、彼独特の愛情表現を甘んじて（？）"},{"spoiler":false,"text":"受けているようだが……。"}],"source":"egs","sourceCharacterId":"16008","sourceWorkId":"11757","spoiler":false},{"segments":[{"spoiler":false,"text":"『バニーハウス・ウサミ』の店長であり、あゆみの通う学園の先輩でもあるという得体の知れない人物。"},{"spoiler":false,"text":"あゆみのことを気に入っており、親身になって相談に乗ったりもするが、ありとあらゆる手段でイジめてくる一面も。"},{"spoiler":false,"text":"おそらくは愛情表現の一種であり、つまりはそういうタイプの人間。"},{"spoiler":false,"text":"主にあゆみを翻弄する張本人。"}],"source":"bangumi","sourceCharacterId":"204664"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2a6cd8bfcb4ee1229722d2277e0e0b4d0895bf6e88bc392b00752c2356b828e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d92a9ef49c977eaebd66e1b45b775c4830ade16a1e4179af9133ae7cad7c34f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c29472","characterName":"宇佐美 みどり","sourceIds":{"bangumi":[{"characterId":"204665","match":"exact-normalized-name-in-linked-work","subjectId":"50346"}],"egsCharacterIds":["16007"],"vndbCharacterId":"c29472"},"originalCharacterName":"宇佐美 みどり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"あゆみが働く裏風俗店「バニーハウス・ウサミ」の店長・皆兎の姉で、宇佐美金融の社長。"},{"spoiler":false,"text":"あゆみの父が、彼女の会社から金を借りたことが発端になっている。"},{"spoiler":false,"text":"金貸しではあるものの、悪い人間ではなく、あゆみの境遇に同情し、色々と便宜を図ってくれる人情家。"},{"spoiler":false,"text":"女だてらに豪快な性格だが、レズの性癖があり、「バニーハウス・ウサミ」にあゆみを買いにくることも……!?"}],"source":"egs","sourceCharacterId":"16007","sourceWorkId":"11757","spoiler":false},{"segments":[{"spoiler":false,"text":"皆兎の姉で宇佐美金融の社長。"},{"spoiler":false,"text":"あゆみの父が、みどりの会社から金を借りたのがそもそもの発端。"},{"spoiler":false,"text":"金貸しではあるが悪い人間ではなく、あゆみの境遇に同情して色々と便宜を図ってくれる。豪快な人情家。"},{"spoiler":false,"text":"レズッ気があり、店にあゆみを買いにくることも？"}],"source":"bangumi","sourceCharacterId":"204665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96a08769cbec3e79310e270594f6538d2c4f476b9a0b9749b3a4408e34ca728b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c83739611c1b982779cca98ad2b47ca7883c12a057c235a2f25f6b422260163e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾奈まりあ","creatorId":"vndb:s2895","sourcePersonId":"vndb:s2895","canonicalEntityId":"vndb:s2895","name":"綾奈 まりあ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50346:204665:36058:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p397","sourceCompanyId":"egs:brand:1385","canonicalEntityId":"vndb:p397","name":"softhouse-seal","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:11757:1385","source":"egs"},{"companyId":"vndb:p397","sourceCompanyId":"vndb:p397","canonicalEntityId":"vndb:p397","name":"Softhouse-Seal","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6982:v2980","source":"vndb"},{"companyId":"vndb:p908","sourceCompanyId":"vndb:p908","canonicalEntityId":"vndb:p908","name":"劇團近未来","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:6983:v2980","source":"vndb"},{"companyId":"vndb:p397","sourceCompanyId":"vndb:p397","canonicalEntityId":"vndb:p397","name":"Softhouse-Seal","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6984:v2980","source":"vndb"},{"companyId":"vndb:p908","sourceCompanyId":"vndb:p908","canonicalEntityId":"vndb:p908","name":"劇團近未来","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:6985:v2980","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
