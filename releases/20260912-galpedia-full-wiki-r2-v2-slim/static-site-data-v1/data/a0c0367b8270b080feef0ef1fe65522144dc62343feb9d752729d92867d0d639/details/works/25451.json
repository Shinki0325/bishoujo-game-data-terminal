nalCharacterName":"リーフ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"モン娘の集落にいる女の子。泰然として物腰の柔らかい女性。"},{"spoiler":false,"text":"しかし実際は何を考えているかはよくわからない、つかみどころのない性格。"},{"spoiler":false,"text":"時折変なギャグを言いだしたりいたずらをしたり、お茶目な性格。"},{"spoiler":false,"text":"かなりのグルメで食には並々ならぬこだわりがある。"},{"spoiler":false,"text":"旅の途中で新たな街に寄るたびに名物や評判の店を事前チェックし、必ず寄る。"}],"source":"bangumi","sourceCharacterId":"65291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/947579b9cb0ddd13ee19cfbcd7e5ccdea3df6c433c367226711f9534b5e6041a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94517ac9d9974a32373a5a708977f35828ad43992c27e17dbdcda8ff2f94bd0f.webp","width":256,"height":227,"source":"static-detail"},"actors":[{"creditedName":"茜屋日海夏","creatorId":"vndb:s18910","sourcePersonId":"vndb:s18910","canonicalEntityId":"vndb:s18910","name":"茜屋 日海夏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211069:65291:18076:1","source":"bangumi"}]},{"characterId":"char_bangumi_65292","characterName":"ミコト・バルツァー","sourceIds":{"bangumi":[{"characterId":"65292","match":"source-roster","subjectId":"211069"}]},"originalCharacterName":"ミコト・バルツァー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アレックスと同じ村に住む少女。"},{"spoiler":false,"text":"アレックスとは小さいころからの幼馴染。"},{"spoiler":false,"text":"いわゆるクールビューティー…ではあるがややサドっ気のある冷たい言葉を吐く。"},{"spoiler":false,"text":"しかし実はヤンデレ気質を持っており、内面では常に想いを寄せるアレックスのことばかり考えている。"},{"spoiler":false,"text":"そのためアレックスが女性の集団である姫一行を匿うと知った際には、気が気でなかった。"}],"source":"bangumi","sourceCharacterId":"65292"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f507e3472090a31539bb2e003bd2df73f4b7bc32bf24bc2a92e4a478c66b9bdb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e86e912c4034f883303e8d888e8c3db3d156316f601aedb69a13fae0ee0c6c3.webp","width":256,"height":227,"source":"static-detail"},"actors":[{"creditedName":"小野早稀","creatorId":"vndb:s21346","sourcePersonId":"vndb:s21346","canonicalEntityId":"vndb:s21346","name":"小野 早稀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211069:65292:15470:1","source":"bangumi"}]},{"characterId":"char_bangumi_65293","characterName":"フラウ・ソワーズ","sourceIds":{"bangumi":[{"characterId":"65293","match":"source-roster","subjectId":"211069"}]},"originalCharacterName":"フラウ・ソワーズ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「世界が窮地に陥ると現れ、闇を振り払う」と言い伝えられている伝説の勇者……らしい。"},{"spoiler":false,"text":"純粋で好奇心が旺盛。他人が何かやっているとすぐ興味を示し、自分もやるといいだす。"},{"spoiler":false,"text":"突発的に難解な言いまわしをしたり、妙な知識ばかり知っていたりと時々周囲を不安にさせる。勇者とされているだけあり、戦闘力は大人に引けを取らないどころか圧倒する。"}],"source":"bangumi","sourceCharacterId":"65293"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3f8f9ab195b3426da838e564fe652b66d567e2ebb6ecfd72c537d72de829289.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13d014f9cd080791f6b9b25e1abb9acec13e90b3c105db8d47ef49dc12b89f3b.webp","width":256,"height":227,"source":"static-detail"},"actors":[{"creditedName":"高野麻里佳","creatorId":"vndb:s12286","sourcePersonId":