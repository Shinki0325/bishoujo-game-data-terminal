er-voice:14498:44690:4937:1","source":"bangumi"}]},{"characterId":"char_c22342","characterName":"ダークス","sourceIds":{"bangumi":[{"characterId":"12378","match":"exact-normalized-name-in-linked-work","subjectId":"67221"}],"egsCharacterIds":["672"],"vndbCharacterId":"c22342"},"originalCharacterName":"ダークス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔王の森と呼ばれる迷宮群で構成されるフォーゼロッテ宮の魔王。"},{"spoiler":false,"text":"元は冒険者であったが、魔王であるフォーゼロッテと結婚し、魔王に就任した。"},{"spoiler":false,"text":"その後、天界の侵攻を退け、名実ともに魔王となったはずだったが、マクドゥによってそれを否定され、街を作ることになった。"},{"spoiler":false,"text":"最近では魔力の操作を自在に行えるようになり、触手の塊であるが自身の分身体を作ることに成功した。"},{"spoiler":false,"text":"成功してしまった。"}],"source":"egs","sourceCharacterId":"672","sourceWorkId":"18450","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公"},{"spoiler":false,"text":"冒险者。 尽管抵达魔王面前，却遭到反击。"},{"spoiler":false,"text":"陷入濒死之境被魔王所救，其后作为魔王的手下（魔王军的一员）开始活动。"},{"spoiler":false,"text":"作为冒险者很有能力，但因为被魔王所救时手续出错（失败），在很多方面变得不够成熟了。"},{"spoiler":false,"text":"从冒险者时代开始就好女色，加入魔王军之后更是变本加厉。"}],"source":"bangumi","sourceCharacterId":"12378"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/034b5cfd05f32c23ae1ec2b55f6be545efb1f3e5b07a881bff97e9128d05ddf1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc560dd3abe5dce7c7b38db474c65eafb34dd9911491fe3acebd82150091816c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"関通利","creatorId":"vndb:s3695","sourcePersonId":"vndb:s3695","canonicalEntityId":"vndb:s3695","name":"きせとしみち","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14498:12378:5038:1","source":"bangumi"}]},{"characterId":"char_vndb_c127175"