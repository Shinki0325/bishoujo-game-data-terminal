"relationId":"vndb:vn-staff:52842","source":"vndb"}]},"cast":[{"characterId":"char_c24865","characterName":"秋月 菜留美","sourceIds":{"bangumi":[{"characterId":"92238","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18982"],"vndbCharacterId":"c24865"},"originalCharacterName":"秋月 菜留美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学院生徒会長にして、前理事長の孫。"},{"spoiler":false,"text":"生粋のお嬢様で、プライドが高く孤高を好む。"},{"spoiler":false,"text":"男性嫌いなため、男に対してはよそよそしいが、唯一、尊敬する祖父の話になると、頬を染めたり、可愛らしい一面を見せる。"},{"spoiler":false,"text":"「わたくしも、大人になったということですわ。あの頃のままというわけにもいきませんもの。そうでしょう？」"}],"source":"egs","sourceCharacterId":"18982","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院3年生・水泳部。学院の生徒会会長でもあり、前理事長の孫 （前妻の孫）でもある少女。"},{"spoiler":false,"text":"プライドが高く、欲しいものはなにをしてでも手に入れるという性格。"},{"spoiler":false,"text":"※『汁だく接待 おかわり二杯目』をインストールしていると追加されるヒロイン。"}],"source":"bangumi","sourceCharacterId":"92238"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b946df7ec9ddab9fca0cf2ddaa82cecc33f26da50c695ad93027d64e9f330fce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/384e1c2c104011d16b805e132b033ce126ef53927ee64346f429146cf109b820.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ゆぅ","creatorId":"vndb:s3280","sourcePersonId":"vndb:s3280","canonicalEntityId":"vndb:s3280","name":"ゆぅ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29269","source":"vndb"}]},{"characterId":"char_c24867","characterName":"宮寺 彰","sourceIds":{"bangumi":[{"characterId":"192334","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18983"],"vndbCharacterId":"c24867"},"originalCharacterName":"宮寺 彰","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美少年のような容姿と紳士的な振舞いが魅力的な、生徒会副会長。"},{"spoiler":false,"text":"“男装の麗人”としての要素を完全に満たしているため、女生徒からは「王子様」と呼ばれ、憧れの的になっている。"},{"spoiler":false,"text":"弟を、常に付き人のように引き連れているが……。"},{"spoiler":false,"text":"「僕はきっと、自分が女に生まれたことを、呪っているんだ……」"}],"source":"egs","sourceCharacterId":"18983","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院3年生・生徒会副会長・水泳部。"},{"spoiler":false,"text":"生徒会の副会長で、運動神経が抜群。水泳部の有力選手の一人である。"},{"spoiler":false,"text":"整った顔立ちと、引き締まった体、美男子ばりの容姿で女子生徒からの憧れとなっている。"},{"spoiler":false,"text":"口数は少なく、クールな性格をしている。弟を常に引き連れ、召使いかなにかのように使っている。"},{"spoiler":false,"text":"いつも一緒にいる弟は、実は養子であり、血の繋がりはない。幼い頃より、男性の生まれなかった宮寺家で、跡取りとして育てられてきたため、男性のような性格、振る舞い、口調を徹底されてきた。"}],"source":"bangumi","sourceCharacterId":"192334"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57f7a5a992eefab0fde0271b5ff7d19e0e94c8d2e2bc9516f5db1ce612e603f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1c31d52e6ad34a24b5f36d325b8799c276892044e1ab06d610da91a950ffe77.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杞梨","creatorId":"vndb:s2984","sourcePersonId":"vndb:s2984","canonicalEntityId":"vndb:s2984","name":"杞梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29266","source":"vndb"}]},{"characterId":"char_c24868","characterName":"西条 紅葉","sourceIds":{"bangumi":[{"characterId":"192335","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18984"],"vndbCharacterId":"c24868"},"originalCharacterName":"西条 紅葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっとりとした、温かみのある風紀委員長。"},{"spoiler":false,"text":"周りより少しテンポが遅かったりするが、どんな人でも分け隔てなく接するため、誰からも好かれる。"},{"spoiler":false,"text":"生徒会長、副会長と同じく、水泳部主力メンバーの一人。"},{"spoiler":false,"text":"「こうやってのんびりと音楽を聴いていますと、ついうとうとしてしまいますわね」"}],"source":"egs","sourceCharacterId":"18984","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院3年生・風紀委員長・水泳部。"},{"spoiler":false,"text":"生徒会の風紀委員長を務める金髪の女性。"},{"spoiler":false,"text":"生徒会長、副会長と同じく、水泳部の主力選手の1人でもある。"},{"spoiler":false,"text":"なによりも気持ちいいこと、楽しいことを優先するという快楽主義者。"}],"source":"bangumi","sourceCharacterId":"192335"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94c1ce895a709b53792cb77cd88705fa655cd54a43462320a0344a9812f6be3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/206f5238d022f8d51e75224fb4f033ebd75bc19533d814e6473ae50e2594e9e8.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村恵子","creatorId":"vndb:s282","sourcePersonId":"vndb:s282","canonicalEntityId":"vndb:s282","name":"中村 恵子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269985:192335:6020:1","source":"bangumi"}]},{"characterId":"char_c24870","characterName":"日下部 聖","sourceIds":{"bangumi":[{"characterId":"192336","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18985"],"vndbCharacterId":"c24870"},"originalCharacterName":"日下部 聖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖華・葵女学院の現理事長。"},{"spoiler":false,"text":"ミステリアスで大人の女性の色香を漂わせているが、男に対しては無防備で、ともすれば誘っているかのような行動をする。"},{"spoiler":false,"text":"教師たちからも、少し距離を置かれているようだが……。"},{"spoiler":false,"text":"「――この学園によき風がふきますよう」"}],"source":"egs","sourceCharacterId":"18985","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院理事長。"},{"spoiler":false,"text":"学院の理事長を務める女性。元々は学院の女教師（シスター）であった。前理事長の後妻であり、前理事長が病気で入院したことをきっかけに学院の経営権を譲り受ける。"},{"spoiler":false,"text":"感受性が強く。宗教的思想の持ち主。どうやら人間の背後に色が見えるらしい。"},{"spoiler":false,"text":"普通の人からしてみればたいしたことないことでも一喜一憂し、すぐ涙を流す。少々思い込みも激しい。"},{"spoiler":false,"text":"アメをムチを使い分ける。"}],"source":"bangumi","sourceCharacterId":"192336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/271aafa074220a135f3abda6ca76305e1cdfc1edee0091803dd61469af2c76fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/574715bc2e36b37d1a6cb476fcd9ee49d350cd35cc2f7d7461df770c1da023a5.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269985:192336:4918:1","source":"bangumi"}]},{"characterId":"char_c24871","characterName":"高城 舞香","sourceIds":{"bangumi":[{"characterId":"192337","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18986"],"vndbCharacterId":"c24871"},"originalCharacterName":"高城 舞香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"素朴で、一般市民の感覚を持っている新聞部の一年生。"},{"spoiler":false,"text":"記者をしている姉に憧れており、将来は、姉と共に世界中を走り回る記者になるのが夢。"},{"spoiler":false,"text":"真実を見極めることに強い欲求を持つが……。"},{"spoiler":false,"text":"「そ、それでは、私はこれで……。まだ取材がありますから――」"}],"source":"egs","sourceCharacterId":"18986","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院2年生・新聞部。"},{"spoiler":false,"text":"負けん気が強く、活発な性格をしているが、少々ドジな面も。"},{"spoiler":false,"text":"生徒会の男子の虐めを記事にしようと追っていると本人は語る。"},{"spoiler":false,"text":"音露とは、生徒会役員を出歯亀をしてるところで偶然出会う。"}],"source":"bangumi","sourceCharacterId":"192337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/043c90e46a08e32989951ca1935678b06ea31678aa64657e4726d729ece8705e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30154f3a5db761a09cd23ef12e3c60ecc87208bfa93e82cdd39545dcc9c9a131.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269985:192337:6351:1","source":"bangumi"}]},{"characterId":"char_c24872","characterName":"皆篠 涼子","sourceIds":{"bangumi":[{"characterId":"192338","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18987"],"vndbCharacterId":"c24872"},"originalCharacterName":"皆篠 涼子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Katakana: （みなしの　りょうこ）"}],"source":"vndb","sourceCharacterId":"c24872"},{"segments":[{"spoiler":false,"text":"和やかで優しく、世話好きな管理人。"},{"spoiler":false,"text":"気さくで人当たりが良く、寮の女生徒からは「マリア様」と呼ばれ、親しまれている。"},{"spoiler":false,"text":"海外へ単身赴任中の夫を想って、時折自らを慰めている様子。"},{"spoiler":false,"text":"「好き嫌いはダメですからね。安心してください。島根さんが働いている間に、好きにさせてみせますよ」"}],"source":"egs","sourceCharacterId":"18987","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院学生寮管理人。人妻。"},{"spoiler":false,"text":"学生寮の管理人を任されている女性。和やかで聖母のように包み込む優しさを持つ。そのくせ焼き餅焼きなところが最大の魅力。"},{"spoiler":false,"text":"細やかな気遣いが得意で、世話好きなためか、寮生みんなには『マリア様』というあだ名を受けるほどの人気者。気さくで人当たりがよいので、本当の母親や姉のように寮生からは思われている。"},{"spoiler":false,"text":"人妻だが色恋沙汰には鈍く、男性に免疫がない。夫が現在、海外へ単身赴任中で寂しい思いをしているため、しばしば夫を想い、一人で自慰行為にふけることもしばしば。"},{"spoiler":false,"text":"告白されると、その人のことを意識しすぎてしまい、恋人にもなっていないのに独占欲が沸いてしまうという欠点がある。"},{"spoiler":false,"text":"好き嫌いのある子いは、好き嫌いを直してあげなくてはならないという奇妙な使命感を持っている。怒ると非常に怖い。"}],"source":"bangumi","sourceCharacterId":"192338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d6f21869295b042ab7f6cc6c8b96bb0010180ff9d3da767cc4dda0f29ed209a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d166acd98598484d46d3d1a9f9f7ded5ffd4ab6ed4bd15936e88ea65b1e9353.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢 美月","creatorId":"vndb:s2983","sourcePersonId":"vndb:s2983","canonicalEntityId":"vndb:s2983","name":"藤沢 美月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29265","source":"vndb"}]},{"characterId":"char_c24873","characterName":"如月 綾","sourceIds":{"bangumi":[{"characterId":"192339","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18988"],"vndbCharacterId":"c24873"},"originalCharacterName":"如月 綾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖華・葵女学院の2年生で寮生。"},{"spoiler":false,"text":"頼りない歳の離れた姉・如月朋のおかげで、面倒見がよく、困った人を放っておけないしっかり者へと成長した。"},{"spoiler":false,"text":"だが、そのことでおばさん染みている自分がイヤ。"},{"spoiler":false,"text":"「なにか困ったことがあったら、私か管理人さんに相談してください」"}],"source":"egs","sourceCharacterId":"18988","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院2年生。寮に住む生徒の一人。"},{"spoiler":false,"text":"一応、父親が小さな会社を経営しており、お嬢様である。"},{"spoiler":false,"text":"歳の少し離れた姉（如月朋）がおり、頼りない性格の姉と昔から付き合ってきたため、自然としっかりした性格になってしまった。面倒見がよく、困った人を放っておけない性格。"},{"spoiler":false,"text":"誰からも好かれ、頼りにされるのはいいが、そのことで次第におばさんじみてくる自分がイヤ。なんとかしようと必死になっている。"}],"source":"bangumi","sourceCharacterId":"192339"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/7030793c4a2008795199ff6cf697b159abd49a0b24959bb75b2a60b9946e60d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e905c5b8c17aaccd34c1e89a28d1f7bfcf2eb42ec1f9421b375a18d746a8d22b.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天水るみ","creatorId":"vndb:s2561","sourcePersonId":"vndb:s2561","canonicalEntityId":"vndb:s2561","name":"天水 るみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269985:192339:28735:1","source":"bangumi"}]},{"characterId":"char_c24875","characterName":"結城 沙耶","sourceIds":{"bangumi":[{"characterId":"192343","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18991"],"vndbCharacterId":"c24875"},"originalCharacterName":"結城 沙耶","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無表情で、何を考えているのか読めない少女。"},{"spoiler":false,"text":"しかし好奇心は旺盛で、知らないことには強い興味を示す。"},{"spoiler":false,"text":"実は老舗和服点の令嬢で、大切に育てられた箱入り娘であるため、世間知らずで偏った性格に育ってしまったようである。"},{"spoiler":false,"text":"「……できましたら栄養を摂取しとうございます」"}],"source":"egs","sourceCharacterId":"18991","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院1年生。寮に住む生徒の一人。"},{"spoiler":false,"text":"無表情で、思考の読めない不思議な少女。好奇心旺盛なところがあり、未知なこと、体験には深い興味を示す。"},{"spoiler":false,"text":"合理的な考えの持ち主だが、世間知らずな面も多々あり、そのことも周りを惑わす原因となっている。"},{"spoiler":false,"text":"京都の老舗和服店の令嬢で、大切に大切に育てられた箱入り娘。しかし、それが原因で偏った性格の少女になってしまい、その緩和・社会勉○のために学園での寮暮らしをさせられている。"}],"source":"bangumi","sourceCharacterId":"192343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81962c2200d3eb9068758a6c09178ea54f02c6f26265f9c8d5d3855663eb3ae0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebdfc34ee74c9a6f3e90dfd5ed1738c393f68d15bf5f4d3fbe965278e7989665.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山内 花梨","creatorId":"vndb:s2980","sourcePersonId":"vndb:s2980","canonicalEntityId":"vndb:s2980","name":"山内 花梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29264","source":"vndb"}]},{"characterId":"char_c24876","characterName":"凛堂 まりん","sourceIds":{"bangumi":[{"characterId":"192345","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18992"],"vndbCharacterId":"c24876"},"originalCharacterName":"凛堂 まりん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"貿易会社「凛堂グループ」の一人娘。"},{"spoiler":false,"text":"しかし、堅苦しく過保護な父の元での生活に嫌気が差し、一人で暮らせる聖華・葵女学院の寮に強引に入寮する。"},{"spoiler":false,"text":"亡くなった元モデルの母のように、自由に輝く世界で生きたいと思っているが……。"},{"spoiler":false,"text":"「お、オーディションに落ちたって言うなーっ」"}],"source":"egs","sourceCharacterId":"18992","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院1年生。寮に住む生徒の一人。くるんくるんの髪の毛をしている。"},{"spoiler":false,"text":"凛堂グループという交易会社の一人娘。一見すると、大胆でわがままな性格。しかし、人一倍の努力家であり、現実的考えも持ち合わせている。過保護な父の元での生活に嫌気が差し、寮暮らしを○行した。"},{"spoiler":false,"text":"幼い頃から生かされていた社交パーティや、その堅苦しい付き合いなどが嫌い。"},{"spoiler":false,"text":"亡くなった元モデルの母親のように、自由に輝いた世界で生きたいと思っている。そのためにいまはアイドルを目指している。学園内の音楽室で歌や踊りのレッスンに明け暮れる日々を送っている。"}],"source":"bangumi","sourceCharacterId":"192345"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70b6e37b58d169c8c46e0f467f1f712fddbccda8e12ede9cbfcd6500d4a5ae45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/252ec138c1a18744fa4ab7818c742549b7e8938982f5e439deff25a815332071.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大垣理香","creatorId":"vndb:s2986","sourcePersonId":"vndb:s2986","canonicalEntityId":"vndb:s2986","name":"大垣 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269985:192345:19056:1","source":"bangumi"}]},{"characterId":"char_c24877","characterName":"麻月 るう奈","sourceIds":{"bangumi":[{"characterId":"192346","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18993"],"vndbCharacterId":"c24877"},"originalCharacterName":"麻月 るう奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"寮に住む、謎のお嬢様。"},{"spoiler":false,"text":"家庭環境や出身は不明、そもそもお嬢様なのかすら謎。"},{"spoiler":false,"text":"いつも際どい服装で寮内を歩き回っているが、困ったとき、まっ先に手を差し伸べる、みんなのお姉さん的な存在。"},{"spoiler":false,"text":"「ふふふ、島根さまご冗談を。これでもわたくし箱入りお嬢様ですのよ？」"}],"source":"egs","sourceCharacterId":"18993","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院3年生。寮に住む生徒の一人。"},{"spoiler":false,"text":"家庭環境が謎で、どこのお嬢様なのか、そもそもお嬢様なのかすら不明。"},{"spoiler":false,"text":"楽天的でずぼらな性格の明るい女性で、いつも寮内をきわどい服装で歩き回っている。"},{"spoiler":false,"text":"意外と面倒見がよく、滅多にしないが家事なども得意。自由奔放で気分屋なのだが、なぜだかイヤな感じがしない不思議な少女。"},{"spoiler":false,"text":"学生寮の長女的存在で、寮生のみんなが困ったとき、悩んでいるときには真っ先に手を差し伸べてくれる大人な少女。"},{"spoiler":false,"text":"夜中にこっそり学院のプールで泳ぐのが趣味"}],"source":"bangumi","sourceCharacterId":"192346"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8d700911377615ae5cd92fcb116e0d3bd1f610907423ac40d9b7739eda28b65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c950c69d1131e4511feec047356cdbb30eb7da9c36746625e0a40ee207463f5.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杞梨","creatorId":"vndb:s2984","sourcePersonId":"vndb:s2984","canonicalEntityId":"vndb:s2984","name":"杞梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29267","source":"vndb"}]},{"characterId":"char_vndb_c24874","characterName":"水無月　- まみな／かみな","sourceIds":{"vndbCharacterId":"c24874"},"originalCharacterName":"水無月　- まみな／かみな","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a7e72a4c6dbad7a09ed475b82a90d097dac9a5cf6ae4432a79d276d00025ff0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9e37f66772aa94786845993aa0cffbbaf6cc81bf4a04b12fcd00913abb8e6b6.webp","width":244,"height":256,"source":"static-detail"},"actors":[{"creditedName":"このは","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","iden