Id":"egs:creator:24376","canonicalEntityId":"vndb:s18306","name":"真島こころ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:285494","source":"egs"},{"creditedName":"Room97","creatorId":"vndb:s50715","sourcePersonId":"vndb:s50715","canonicalEntityId":"vndb:s50715","name":"Room97","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:185833","source":"vndb"}],"other":[{"creditedName":"乃花こより(此花瑠璃)","creatorId":"egs:creator:39019","sourcePersonId":"egs:creator:39019","canonicalEntityId":"egs:creator:39019","name":"乃花こより(此花瑠璃)","detail":"主題歌「メモリーガール」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:285446","source":"egs"},{"creditedName":"乃花こより(此花瑠璃)","creatorId":"egs:creator:39019","sourcePersonId":"egs:creator:39019","canonicalEntityId":"egs:creator:39019","name":"乃花こより(此花瑠璃)","detail":"制作、システム","roleCode":"other","roleLabel":"其他","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:285486","source":"egs"},{"creditedName":"Azell(ポケットサウンド)","creatorId":"egs:creator:23572","sourcePersonId":"egs:creator:23572","canonicalEntityId":"egs:creator:23572","name":"Azell(ポケットサウンド)","detail":"効果音","roleCode":"other","roleLabel":"其他","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:285489","source":"egs"},{"creditedName":"笠畑栄樹(On-Jin、音人、E.EFFECT、enas ihos AXIA)","creatorId":"vndb:s18224","sourcePersonId":"egs:creator:27697","canonicalEntityId":"vndb:s18224","name":"笠畑栄樹(On-Jin、音人、E.EFFECT、enas ihos AXIA)","detail":"効果音","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:285490","source":"egs"},{"creditedName":"背景専門店みにくる(みにくる背景CG素材集)","creatorId":"vndb:s334","sourcePersonId":"egs:creator:28992","canonicalEntityId":"vndb:s334","name":"背景専門店みにくる(みにくる背景CG素材集)","detail":"画像素材","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:285491","source":"egs"},{"creditedName":"高峰にっと","creatorId":"vndb:s21836","sourcePersonId":"egs:creator:41376","canonicalEntityId":"vndb:s21836","name":"高峰にっと","detail":"テストプレイ","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:285496","source":"egs"},{"creditedName":"乃花 こより","creatorId":"vndb:s20005","sourcePersonId":"vndb:s20005","canonicalEntityId":"vndb:s20005","name":"乃花 こより","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:185831","source":"vndb"},{"creditedName":"乃花 こより","creatorId":"vndb:s20005","sourcePersonId":"vndb:s20005","canonicalEntityId":"vndb:s20005","name":"乃花 こより","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:185832","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c143589","characterName":"めもり","sourceIds":{"vndbCharacterId":"c143589"},"originalCharacterName":"めもり","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The heroine of a game that someone was playing. While she should've been nothing more than data, she suddenly attained consciousness. After someone who was important to her (perhaps the player?) disappeared without a word, she apparently started searching the remaining game world for \"him\"."},{"spoiler":false,"text":"She's a second-year student at High School A, located near Shibuya. In terms of personality, she's quiet and gentle. She apparently used to have a sharp and focused mind, but something happened to turn her forgetful and sloppy. She's been friends with Messiah since they were young, and they often hang out together after school."},{"spoiler":false,"text":"While she's not the most proactive when it comes to making friends, she gets along with most people easily, whether that's because of her strong social skills or just because she's so easygoing. She can also be a bit odd, resulting in Messiah often struggling to keep up with her."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143589"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/711122d11cdf28126179731c5e86e02d90ce5795718eb35234f44c2786bce681.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23a9eba260fce7896b6138e482ee884a464e6101af08e97829c4ed46838bf342.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"乃花 こより","creatorId":"vndb:s20005","sourcePersonId":"vndb:s20005","canonicalEntityId":"vndb:s20005","name":"乃花 こより","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91545","source":"vndb"}]},{"characterId":"char_vndb_c143590","characterName":"メシア","sourceIds":{"vndbCharacterId":"c143590"},"originalCharacterName":"メシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at High School A, located near Shibuya. She's been close friends with Memory since they were in elementary school. Although you wouldn't expect it from her eye-catching fashion choices, she's a diligent and caring person who often finds herself being dragged around by the forgetful Memory."},{"spoiler":false,"text":"Because of her kind nature, she frequently hides her true feelings out of consideration for others. She loves cute, trendy things and checks the internet daily to stay on top of things. Before high school, she was a plain, ordinary girl who wore long skirts and kept her hair naturally black. She was obsessed with anime and manga, but upon discovering a stylish and inspiring internet idol. That motivated her to study fashion, and she made her high school debut as you see her now."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143590"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42b6b08c39bbe322a1a5f48f2009b7755b4b5611c7bc6e6dd5b2e048017ffed5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecaa7466b28883630b520a4640f7cec88053e22a586f24d6481a6a0d35058af3.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"恋摘 もなか","creatorId":"vndb:s26840","sourcePersonId":"vndb:s26840","canonicalEntityId":"vndb:s26840","name":"恋摘もなか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91548","source":"vndb"}]},{"characterId":"char_vndb_c143591","characterName":"寡頭瑠十","sourceIds":{"vndbCharacterId":"c143591"},"originalCharacterName":"寡頭瑠十","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at High School A. He is a calm and gentle person who maintains an air of nystery due to rarely talking about himself. He is laid back in relationships and never pushes away anyone who approaches him, but will also never bother anyone who's avoiding him, making him seem more mature than other students."},{"spoiler":false,"text":"After school, he puts on piercings, glasses, and a maid uniform, which he even wears at his job at the arcade. No one really knows why he walks around in this strange outfit. He's close friends with Michiaki, and the two are constantly together while at school. He doesn't often join in on his friends' antics, but he does get a kick out of watching from the sidelines."},{"spoiler":false,"text":"Recently, he's become more concerned for Memory and starts talking to her at school in secret. This is because seeing her act so disheartened after losing someone important to her has made him worry about how her condition might worsen in the future, and he feels a sense of obligation to reach out to help incase she breaks down completely."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5632ebd83d1e62636f6ca6d728454f2ce3db98ca2e5d94ebf4ab6cc22e31f5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3a623ad2b11fa3227734d48e85258ffd9b0a395f00bc0dafc9b244ed423b559.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高峰にっと","creatorId":"vndb:s21836","sourcePersonId":"vndb:s21836","canonicalEntityId":"vndb:s21836","name":"高峰にっと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91546","source":"vndb"}]},{"characterId":"char_vndb_c143592","characterName":"三智秋","sourceIds":{"vndbCharacterId":"c143592"},"originalCharacterName":"三智秋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at High School A, located near Shibuya. A classmate of Memory's. He's the tallest person in school, so he stands out anywhere he goes. He's outgoing. cheerful, and full of curiosity. Because of his honesty and open nature, he's bad at lying, and he can't keep a secret for long."},{"spoiler":false,"text":"He has a variety of hobbies including video games, manga, sports, and watching movies. Recently he's gotten into digging up obscure B-rated movies at rental video shops. He and Cult are good friends and constantly together. But ever since Cult started talking to Memory, he's had this feeling that something terrible will happen, so he drops by Cult's job every day to keep an eye on him. He might seem like a stalker, but he does it out of sincere concern."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143592"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5127f90d851d229bb27e94262710bb0b86f984da160ea382ed7d551c7d69ca6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48a991a4e8c3b3cd244d1f9b1b1c9d0988122734617a65d9ec249b2f9c080af6.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐野 裕理","creatorId":"vndb:s19800","sourcePersonId":"vndb:s19800","canonicalEntityId":"vndb:s19800","name":"佐野 裕理","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91544","source":"vndb"}]},{"characterId":"char_vndb_c143593","characterName":"楓","sourceIds":{"vndbCharacterId":"c143593"},"originalCharacterName":"楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student and the student council president at High School A, located near Shibuya. Being as kind and warm-hearted as a saint, and beautiful too, there's no shortage of students who worship her. She has a great memory and knows the faces and names of nearly all of the students."},{"spoiler":false,"text":"She seems to be unaware of her own charisma. Because of her easy, peaceful, and drama-free life, she has a fondness for gossip and crazy stories. She especially loves stories about the darker side of humanity, all the better if they're nonfiction."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143593"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f42a2d2f15167db71edb7685197e39e63eb089691df4b49546fc92b56a0eaa74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e0a34015df837a3b984ccdef8ca210aa6d45912fd11da6615ec0bc60d325132.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢坂 成美","creatorId":"vndb:s27093","sourcePersonId":"vndb:s27093","canonicalEntityId":"vndb:s27093","name":"逢坂成美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91549","source":"vndb"}]},{"characterId":"char_vndb_c143594","characterName":"らいむ","sourceIds":{"vndbCharacterId":"c143594"},"originalCharacterName":"らいむ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An elementary school student who often shows up in the plaza in front of Kyobashi Station. He's reserved. cautious, and shy, but once he determines that someone is kind, he quickly opens up to them, showing some of the trusting naivety you'd expect from a kid of his age. He seems to be waiting for his mom to come pick him up after school."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143594"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11b2dd377a190c2090d0d3827a75b1d83352d0c65931a5f0bf83f4d9cbe851e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68623706cfb203e02eff05ac3c25441fda4fa8f55a890228bd8a6bd478abb2c5.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夜世生宵","creatorId":"vndb:s40266","sourcePersonId":"vndb:s40266","canonicalEntityId":"vndb:s40266","name":"夜世生宵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91551","source":"vndb"}]},{"characterId":"char_vndb_c143596","characterName":"マスター","sourceIds":{"vndbCharacterId":"c143596"},"originalCharacterName":"マスター","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of the café \"Shasha\" located near Kyobashi Station. He inherited the café from his grandfather, and he's able to manage it comfortably on his own. He's friendly, cheerful, and caring towards others in a big sisterly sort of way. Despite his feminine demeanor and looks, he still considers himself to be a man."},{"spoiler":false,"text":"He likes to look after others, so whenever Memory, one of his regulars, pops in, he lets her have a meal or dessert on the house. He follows trends closely and is into beauty and makeup. On his days off, he seems to keep up with Korean idols. Not much is known about his background, but he has a lot of life experience. He's also bisexual and has over 100 ex-partners."},{"spoiler":false,"text":"He seems to have a long-distance boyfriend right now, but no one is sure."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143596"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/695baa724381e007cd072754d626dea5690327a7c1c12d63904d971eaf94d059.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccc8019ff180704677ea411fc9a366de4e34b4d50eb58af1fe95bb54c4199a98.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"控田 まりお","creatorId":"vndb:s29036","sourcePersonId":"vndb:s29036","canonicalEntityId":"vndb:s29036","name":"控田 まりお","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91550","source":"vndb"}]},{"characterId":"char_vndb_c143597","characterName":"鬼丸","sourceIds":{"vndbCharacterId":"c143597"},"originalCharacterName":"鬼丸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A guy from another school whom Memory and her friend meet at Asakusa Station. He runs the occult zine \"Onimaru's Spooky Stories\" by himself as a hobby, posting issues online and advertising them by discretely putting up posters in out-of-the-way places around the city."},{"spoiler":false,"text":"He seems somewhat suspicious at first glance but turns out he's quite friendly, kind, and chill. Due to his constant efforts, the zine is gaining fans at a steady rate, and dreams of turning it into a nationwide phenomenon. He loves ghost stories, science fiction, horror, and other dark topics, often scouring the internet for new tales and concepts."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143597"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/559f09d73b55228b9c561760ad8c7452dc11218181d5edfcf8522458bd4647a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fcb915ddd72408ae3d7db263715178cd1ab9b2518e0e8abb5404dcb41f8f380.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ばるう","creatorId":"vndb:s25136","sourcePersonId":"vndb:s25136","canonicalEntityId":"vndb:s25136","name":"ばるう","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91547","source":"vndb"}]},{"characterId":"char_vndb_c143598","characterName":"ロスト","sourceIds":{"vndbCharacterId":"c143598"},"originalCharacterName":"ロスト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious boy encountered at a construction site near Asakusa Station. He wears a light purple bear mask, so his real face is hidden. Despite meeting Memory for the first time, he acts strangely friendly, as if he's known Memory and her friends for a long time. He appears to be interested in Memory, but any attempts to confirm this result in him dodging the question with jokes."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c143598"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbe9b20571e01bc128219b2733c05fb646060781c4c26d7dc026b191d573a5a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41f4574d0192e3a2e8c9319590a7b1b5a898a14fbaa7e96aab9286313573eaa9.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内村 遥汰郎","creatorId":"vndb:s17637","sourcePersonId":"vndb:s17637","canonicalEntityId":"vndb:s17637","name":"内村 遥汰郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91543","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:6247","sourceCompanyId":"egs:brand:6247","canonicalEntityId":"egs:brand:6247","name":"cream△","roleCodes":["brand"],"identityStatus":"alias-only-review","relationId":"eg