],"source":"vndb","sourceCharacterId":"c56517"},{"segments":[{"spoiler":false,"text":"ダークエルフの少女。"},{"spoiler":false,"text":"行き倒れているところを主人公が助けたところ、恩義を返すためにと押しかけてくる。"},{"spoiler":false,"text":"家庭的で家事全般は得意。人づきあいに馴れていないが、一旦心を許すと尽くして甘えるタイプ。"}],"source":"egs","sourceCharacterId":"16410","sourceWorkId":"24614","spoiler":false},{"segments":[{"spoiler":false,"text":"ダークエルフの少女。"},{"spoiler":false,"text":"行き倒れていたところを主人公が助け、恩義を返すためにと押し掛けてくる。"},{"spoiler":false,"text":"家庭的で家事全般は得意。 人付き合いに馴れていないが、一旦心を許すと尽くして甘えるタイプ。"},{"spoiler":false,"text":"「私にそんなに優しくしてくれた人は……あなたが初めてです。 好きになっても……いいですか？」"}],"source":"bangumi","sourceCharacterId":"50254"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"16410","sourceWorkId":"24614","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"i","valueContext":null,"source":"egs","sourceCharacterId":"16410","sourceWorkId":"24614","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"16410","sourceWorkId":"24614","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"16410","sourceWorkId":"24614","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae84b7c99c3466236b3167bb13abe96d71ded82e246cd391b3c5ba8c4884f3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd55db6cdc4c7d6e869f373e978add38699b39bccb477e506b29cc72f3c5e92a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:207176:50254:6349:1","source":"bangumi"}]},{"characterId":"char_c56518","characterN