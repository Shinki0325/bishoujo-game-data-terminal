{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8739","model":{"presentationWorkId":"vndb:v10085","staff":{"artwork":[{"creditedName":"しかげなぎ","creatorId":"vndb:s2942","sourcePersonId":"egs:creator:699","canonicalEntityId":"vndb:s2942","name":"しかげなぎ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22335","source":"egs"}],"scenario":[{"creditedName":"無頼寿あさむ","creatorId":"vndb:s2972","sourcePersonId":"egs:creator:384","canonicalEntityId":"vndb:s2972","name":"無頼寿あさむ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22336","source":"egs"}],"music":[],"other":[{"creditedName":"無頼寿あさむ","creatorId":"vndb:s2972","sourcePersonId":"egs:creator:384","canonicalEntityId":"vndb:s2972","name":"無頼寿あさむ","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:180760","source":"egs"},{"creditedName":"しかげ なぎ","creatorId":"vndb:s2942","sourcePersonId":"vndb:s2942","canonicalEntityId":"vndb:s2942","name":"しかげ なぎ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:86688","source":"vndb"},{"creditedName":"無頼寿 あさむ","creatorId":"vndb:s2972","sourcePersonId":"vndb:s2972","canonicalEntityId":"vndb:s2972","name":"無頼寿 あさむ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:86691","source":"vndb"}]},"cast":[{"characterId":"char_c24855","characterName":"ラピスラズリ","sourceIds":{"bangumi":[{"characterId":"142593","match":"exact-normalized-name-in-linked-work","subjectId":"269399"}],"egsCharacterIds":["23257"],"vndbCharacterId":"c24855"},"originalCharacterName":"ラピスラズリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"行方不明になった魔術師に仕えていたメイド兼魔術師の助手。"},{"spoiler":false,"text":"彼女自身には魔術師の才能はなく、魔術は使えない。"},{"spoiler":false,"text":"気立ては良いが、かなりの天然。"},{"spoiler":false,"text":"パンは作れるが、それ以外の料理は知らない。"},{"spoiler":false,"text":"よく日なたで居眠りをしているらしい。"}],"source":"egs","sourceCharacterId":"23257","sourceWorkId":"8739","spoiler":false},{"segments":[{"spoiler":false,"text":"通称はラピス。メインヒロイン。"},{"spoiler":false,"text":"行方不明になっている魔術師に仕えていた。"},{"spoiler":false,"text":"メイド兼魔術師の助手。ただし、彼女自身は魔術の才能は無い。"},{"spoiler":false,"text":"気立て良し、しかし天然、料理を知らない（パンしか作れない）、　よく日なたで居眠りしている。"}],"source":"bangumi","sourceCharacterId":"142593"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1988beae3ef85b78b166a5ed441381fd373f4c4ce4951e1ee64b3483fe29033.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d55927038d330884e8a3c25f397aa5cd20aa57ae1d630375214cb1febf044a6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269399:142593:4810:1","source":"bangumi"}]},{"characterId":"char_c24856","characterName":"ティリオ","sourceIds":{"bangumi":[{"characterId":"142594","match":"exact-normalized-name-in-linked-work","subjectId":"269399"}],"egsCharacterIds":["23258"],"vndbCharacterId":"c24856"},"originalCharacterName":"ティリオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公だけに見える謎のメイド。"},{"spoiler":false,"text":"どうやら50年前にメイドとして仕えていた幽霊らしい。"},{"spoiler":false,"text":"幽霊でありながら、どんよりした感じもなく、表情も豊か。"},{"spoiler":false,"text":"さらには昼間も関係なく現れるので、幽霊であることすら怪しい。"},{"spoiler":false,"text":"屋敷に住み着いたのは20年前ほどで、この屋敷に仕えていたのは30年前らしい。"},{"spoiler":false,"text":"それ以前は結婚していたらしく、姓はヴァンデイスだったという。"}],"source":"egs","sourceCharacterId":"23258","sourceWorkId":"8739","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の目の前に現れたメイド。 他の人間には見えないのだが、なぜか主人公にだけ見ることもでき触れることもできる。"},{"spoiler":false,"text":"どうやら幽霊らしく、50年くらい前にメイドとして仕えていたらしい。"},{"spoiler":false,"text":"表情豊かでしかも昼間から現れるので、幽霊であることがかなり怪しい。"},{"spoiler":false,"text":"20年くらい前から住み付いている。更に30年前にこの館に仕えていた。"},{"spoiler":false,"text":"それ以前結婚していたのだが、そのときの姓はヴァンディス。"}],"source":"bangumi","sourceCharacterId":"142594"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80b14c95bd477c3b49ea363f20302eaf879fe3e414a053c732bf2be890b5485c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1991abfeca920d9c7aeaa047c7c0329056a23befaba5a9800da5e692fc5ceb8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269399:142594:5741:1","source":"bangumi"}]},{"characterId":"char_c24857","characterName":"ミナ","sourceIds":{"bangumi":[{"characterId":"142595","match":"exact-normalized-name-in-linked-work","subjectId":"269399"}],"egsCharacterIds":["23260"],"vndbCharacterId":"c24857"},"originalCharacterName":"ミナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学校に通っているが、毎日、授業をボイコットして街をぶらぶらしている登校拒否児。"},{"spoiler":false,"text":"工房にいる母親にしか心を開かず、嫌なことかがあるとすぐに嘘をついて拒絶する。"},{"spoiler":false,"text":"草木の気持ちを理解できる不思議な力を持ち、常に植木鉢を家にする謎の植物（タンポポ）を持ち歩いている。"},{"spoiler":false,"text":"絵の才能と、魔術の才能を持ち、ほんの少しだけ魔術が使える。"}],"source":"egs","sourceCharacterId":"23260","sourceWorkId":"8739","spoiler":false},{"segments":[{"spoiler":false,"text":"町にある工房で暮らす女の子。学校に通っている女の子なのだが、現在は登校拒否中。"},{"spoiler":false,"text":"毎日授業をさぼり、街をぶらぶらしている。嫌なことは嘘で拒絶する。しかしその嘘は見え見えで、いまだかつて 騙された人間はいない。"},{"spoiler":false,"text":"工房にいる母親にしか心を開かない。姉代わりにロボットはよく思っていない。そのため、ちょいちょい拒絶をする。"},{"spoiler":false,"text":"草木の気持ちを理解することができ、いつも植木鉢に植えた謎の植物（タンポポ）を持ち歩いている。"},{"spoiler":false,"text":"紙を見つけると何か絵を描きたくなる体質。しかも結構上手。"},{"spoiler":false,"text":"魔術の素質があり、特に学んでもいないのだがほんの少しだけ使うことができる。"}],"source":"bangumi","sourceCharacterId":"142595"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f7a9f8cde9acbdf6e1bbb26ae09a955838e7a554e2b6681be8bf91615631f9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79551c419d1c45657f0292f77f6fcebbccc4798b96b70666d6a4073d238ed052.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤美佳子","creatorId":"vndb:s1137","sourcePersonId":"vndb:s1137","canonicalEntityId":"vndb:s1137","name":"佐藤 美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269399:142595:6122:1","source":"bangumi"}]},{"characterId":"char_c24858","characterName":"ブリット","sourceIds":{"bangumi":[{"characterId":"142596","match":"exact-normalized-name-in-linked-work","subjectId":"269399"}],"egsCharacterIds":["23259"],"vndbCharacterId":"c24858"},"originalCharacterName":"ブリット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"街のレストランでウェイトレスをしている。"},{"spoiler":false,"text":"普通の人間に見えるが、実はロボット。"},{"spoiler":false,"text":"心臓部には魔術機関が装備されている。"},{"spoiler":false,"text":"その仕組みについては一切不明。"},{"spoiler":false,"text":"ミナの母であるトリーシャ・Ｂ・ホークをオリジナルとし、容姿は彼女の若い頃と瓜二つ。"},{"spoiler":false,"text":"その思考も忠実にサンプリングしているが、人格は彼女よりも従順になっている。"}],"source":"egs","sourceCharacterId":"23259","sourceWorkId":"8739","spoiler":false},{"segments":[{"spoiler":false,"text":"この町にあるレストランでウェイトレスをしていたが、働きが悪いために首になってしまった少女。後に屋敷で働 くようになる。"},{"spoiler":false,"text":"正体はロボットであり、町にある工房で働いていた主人が開発したもの。心臓部には魔術師が作った魔術機関が備 わっている。"},{"spoiler":false,"text":"ただ魔術師も工房の主人も他界しているため、仕組みについては一切不明。"},{"spoiler":false,"text":"オリジナルはミナの母であるトリーシャ・B・ホークであり、ほぼ同じ思考を持ち（トリーシャの思考を忠実にサ ンプリングしている）、見た目はトリーシャの若い頃と瓜二つである。"},{"spoiler":false,"text":"ただし人格はオリジナルよりもやや従者っぽい。"}],"source":"bangumi","sourceCharacterId":"142596"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68dc2ed0dd34cf191df173c29c19db584b0eaf21f5db9fc981d286ff21da7c0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b925b4d7be82329cf8679d80c60f6bf61ec670b52b2c99a904f9cca5382593a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269399:142596:4956:1","source":"bangumi"}]},{"characterId":"char_c24859","characterName":"鶯姫","sourceIds":{"bangumi":[{"characterId":"142597","match":"exact-normalized-name-in-linked-work","subjectId":"269399"}],"egsCharacterIds":["23261"],"vndbCharacterId":"c24859"},"originalCharacterName":"鶯姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔術師に一目惚れし、魔術の勉強を始めた女の子。"},{"spoiler":false,"text":"ただし魔術師と出会ったのは100年以上前で、彼女自身の年齢は120歳。"},{"spoiler":false,"text":"共和制を布く隣国の出身で、孤児として教会に住んでいたが、魔術が見習い程度の腕前になったことから、魔術師の弟子にして貰おうと屋敷にやってきた。"},{"spoiler":false,"text":"見た目は小さく生意気な幼女といった雰囲気の彼女だが、魔術師のことを色々と知っている。"}],"source":"egs","sourceCharacterId":"23261","sourceWorkId":"8739","spoiler":false},{"segments":[{"spoiler":false,"text":"魔術師にひと目惚れし、彼に近付くために魔術の勉強をはじめた女の子。ただし魔術師と出会ったのは100年以 上前のこと。年齢は120歳くらい。"},{"spoiler":false,"text":"隣国（共和国）にて孤児として教会に住んでいたが、見習い程度には腕も付いたので、魔術師の弟子にしてもらう べく館にやってくる。"},{"spoiler":false,"text":"魔術師のことを色々知っている。見た目はちっこく、生意気な○○という雰囲気。東方の出身であり、異国の服を 着ている。"}],"source":"bangumi","sourceCharacterId":"142597"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22bc2aa76780662f87a024eb98d9bfc2bfabf1190e76b192bc1edd6c6fc856a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfe748ef64952863c7ec8d0da8f4e248e4a48a082ff9999a8ac069ff6885d958.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269399:142597:4916:1","source":"bangumi"}]},{"characterId":"char_vndb_c107412","characterName":"タンポポ","sourceIds":{"vndbCharacterId":"c107412"},"originalCharacterName":"タンポポ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"Mina's pet."}],"source":"vndb","sourceCharacterId":"c107412"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c774b8357f17f7aaefe271e015599eae06471bae21727b35ad8116d00938d25b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charact