:[{"characterId":"char_c50104","characterName":"七波 シロネ","sourceIds":{"bangumi":[{"characterId":"46956","match":"exact-normalized-name-in-linked-work","subjectId":"186677"}],"egsCharacterIds":["14030"],"vndbCharacterId":"c50104"},"originalCharacterName":"七波 シロネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"720"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"－kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new model of android developed by Sara called “TRINO,” who resembles Shun's little sister."},{"spoiler":false,"text":"Although she has a human-like exterior, her cognitive abilities are still developing, making it difficult for her to understand social cues. Despite this drawback, she exudes a unique charm that gives those around her a soothing presence, almost like a living mascot."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c50104"},{"segments":[{"spoiler":false,"text":"沙羅が作った新型アンドロイド（ “トリノ” ）で、舜の妹に似ている。"},{"spoiler":false,"text":"見た目は人と変わらないが、中身は学習途中なため、空気が読めない一面も。"},{"spoiler":false,"text":"その独特な愛嬌で、周りを和ませるマスコット的存在。"}],"source":"egs","sourceCharacterId":"14030","sourceWorkId":"23994","spoiler":false},{"segments":[{"spoiler":false,"text":"沙羅所制作的新型智能机器人（トリノ），很像舜的妹妹。"},{"spoiler":false,"text":"虽然外表和人类一模一样，但因为正在学习各种知识，还不会察言观色。"},{"spoiler":false,"text":"正因如此她所独有的可爱感觉让她成为了周围人中吉祥物一般的存在。"}],"source":"bangumi","sourceCharacterId":"46956"}],"profil