eField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"23281","sourceWorkId":"8733","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"23281","sourceWorkId":"8733","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"51 kg","valueContext":null,"source":"egs","sourceCharacterId":"23281","sourceWorkId":"8733","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04dd6ef299986359e3b00d73787266121f08963a356ee703f0505d6440970c35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8fda231c933c0b72858ae93caddbd836fb7c23e3f057a02c2e349037c010f5c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:510725:210686:12719:1","source":"bangumi"}]},{"characterId":"char_c75893","characterName":"キリヤ","sourceIds":{"bangumi":[{"characterId":"210687","match":"exact-normalized-name-in-linked-work","subjectId":"510725"}],"egsCharacterIds":["23282"],"vndbCharacterId":"c75893"},"originalCharacterName":"キリヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"返済される見込みの無い債権を買い取り、あらゆる手段で利益に還元する「回収屋」の女リーダー。"},{"spoiler":false,"text":"綾乃の父親から、綾乃を買い取り「見世物小屋」と呼ばれる施設で金や暇を持て余す人間らに娯楽を提供する。"},{"spoiler":false,"text":"妖艶な美貌の持ち主。"},{"spoiler":false,"text":"その性格は人を人とも思わない冷酷無比でサディスティックな現実主義者。"}],"source":"egs","sourceCharacterId":"23282","sourceWorkId":"8733","spoiler":false},{"segments":[{"spoiler":false,"text":"ブランドもののスーツを颯爽と着こなす妖艶な美貌の持ち主で、男を欲情させずにはいられない毒婦。その実態は委託された借金の回収をありとあらゆる手段を用いて行う『回収屋』のリーダー。"},{"spoiler":false,"text":"綾乃の父親から綾乃を買い取り、借金を回収する為に様々な方法を使って綾乃を凌辱する。"}],"source":"bangumi","sourceCharacterId":"210687"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"23282","sourceWorkId":"8733","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"23282","sourceWorkId":"8733","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"23282","sourceWorkId":"8733","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"23282","sourceWorkId":"8733","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"23282","sourceWorkId":"8733","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"23282","sourceWorkId":"8733","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2be28bf76ac48b09d0a6ab9e936e7236559296387b9263cd3e6314e0eb113a16.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0db16c2a80f30f73ecdf4cbede078bb679efce9c397ce41872957a5535f264b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月山かなる","creatorId":"vndb:s4988","sourcePersonId":"vndb:s4988","canonicalEntityId":"vndb:s4988","name":"月山 かなる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:510725:210687:25118:1","source":"bangumi"}]},{"characterId":"char_vndb_c75894","characterName":"瀬宮 廣人","sourceIds":{"vndbCharacterId":"c75894"},"originalChara