e":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:75257","source":"vndb"},{"creditedName":"HARE","creatorId":"vndb:s1473","sourcePersonId":"vndb:s1473","canonicalEntityId":"vndb:s1473","name":"HARE","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:75258","source":"vndb"}],"music":[{"creditedName":"HT-SOUND","creatorId":"vndb:s184","sourcePersonId":"vndb:s184","canonicalEntityId":"vndb:s184","name":"HT-SOUND","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:75259","source":"vndb"}],"other":[{"creditedName":"阿部四百(400、阿部400)","creatorId":"vndb:s3914","sourcePersonId":"egs:creator:15433","canonicalEntityId":"vndb:s3914","name":"阿部四百(400、阿部400","detail":"彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167683","source":"egs"}]},"cast":[{"characterId":"char_c52935","characterName":"高岡 幻夢","sourceIds":{"bangumi":[{"characterId":"153091","match":"exact-normalized-name-in-linked-work","subjectId":"187612"}],"egsCharacterIds":["9971"],"vndbCharacterId":"c52935"},"originalCharacterName":"高岡 幻夢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公たちが通う学園の養護教諭（保健医）。"},{"spoiler":false,"text":"女子生徒たちの相談や、カウンセリングも行っている。"},{"spoiler":false,"text":"彼女は思春期の女の子たちを淫夢に引きずり込む謎の存在であり、異常性欲に悩み相談に訪れた主人公を淫靡な快楽の世界へと誘う。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"4962","spoiler":false},{"segments":[{"spoiler":false,"text":"正体は淫魔。学園に転校してくるが外見はかなり幼い。"},{"spoiler":false,"text":"過去の失敗により魔力を失い、少女の様な外見に自分を固定する事で魔力の消費を抑えている。"},{"spoiler":false,"text":"卵を2人に与え、互いに競わせる事で魔力を吸収し復活しようと企む。"},{"spoiler":false,"text":"魔力の収集を目的としており、何らかの取り立てに追われているようだが、魔力収集ノルマを果たせずに微妙にワープア化している。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"14026","spoiler":false},{"segments":[{"spoiler":false,"text":"特定の嗜好な方々に好まれるような体型を強いられ、ワープア、貧乏一直線。"},{"spoiler":false,"text":"知り合いのツテでネットショップを運営中。"},{"spoiler":false,"text":"不慣れな仕事でのミスの結果、蒔絵と出会い彼女の『妄想の世界』を利用しようと画策する。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"15559","spoiler":false},{"segments":[{"spoiler":false,"text":"『侵蝕』シリーズに登場する淫魔。 外見上はシリーズ最年少に。"},{"spoiler":false,"text":"三姉妹を巻き込んで、遺跡の魔力を回収しようと企んでいる。"},{"spoiler":false,"text":"迷宮の水先案内人を装い、ヒロインたちを騙して誘導したりもする。"}],"source":"bangumi","sourceCharacterId":"153091"}],"profileFacts":[{"label":"胸围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"9971","sourceWorkId":"15559","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"143 cm","valueContext":null,"source":"egs","sourceCharacterId":"9971","sourceWorkId":"15559","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"9971","sourceWorkId":"15559","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"47 cm","valueContext":null,"source":"egs","sourceCharacterId":"9971","sourceWorkId":"15559","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76df2e6ab2fcbca767bc649b4598cd067bdd73b23a46d1d5e13242b255abde70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cebc304ee99ccf80c4bec71ca1791e68178026127d16c281783bd4ae54b52fe.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飯野ユウ","creatorId":"vndb:s931","sourcePersonId":"vndb:s931","canonicalEntityId":"vndb:s931","name":"飯野 ユウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230339:153091:6377:1","source":"bangumi"}]},{"characterId":"char_c53050","characterName":"笹ヶ見 蒔絵","sourceIds":{"bangumi":[{"characterId":"1530