{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36214","model":{"presentationWorkId":"vndb:v47003","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"Sinical Network","creatorId":"vndb:s34395","sourcePersonId":"vndb:s34395","canonicalEntityId":"vndb:s34395","name":"Sinical Network","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:199301","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c93287","characterName":"Yella Lester","sourceIds":{"vndbCharacterId":"c93287"},"originalCharacterName":"Yella Lester","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A vampire who has lived for so long she can't even remember her age. She came to the new continent in a ship filled with settlers when the new continent was first discovered. She claimed to have accumulated countless wealth, and even possessed supernatural powers far beyond the capacities of any ordinary human. As long as she had Raylan to accompany her, this new world would certainly be an interesting experience for her even though three hundred years have passed..."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c93287"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9202cb453c097a727bdcc0addbf938f6166da623764acabbad37039346506c1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e5ab62b119ff2b6c8138edb3f4a2a754c4e7eddd95e44fb4eebdd4fa01e4928.webp","width":226,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c96582","characterName":"Raylan Monroe","sourceId