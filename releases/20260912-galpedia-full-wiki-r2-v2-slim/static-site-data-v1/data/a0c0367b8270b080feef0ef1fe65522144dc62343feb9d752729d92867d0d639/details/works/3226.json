t","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる学院の一年生。"},{"spoiler":false,"text":"小柄なロリータ少女。"},{"spoiler":false,"text":"彼女の父親は小笠原重工の下請けの会社を営んでおり、昨今の不景気で取引中止をほのめかされているようだ。"}],"source":"egs","sourceCharacterId":"27165","sourceWorkId":"3226","spoiler":false},{"segments":[{"spoiler":false,"text":"小柄なロリータ系の美少女。父が営む桐野製作所は小笠原重工の下請け。"},{"spoiler":false,"text":"高城一派に性的にいじめられているところを主人公が助ける。"},{"spoiler":false,"text":"美奈の実家は小笠原重工の下請けとして零細町工場を営んでいたが、"},{"spoiler":false,"text":"昨今の不景気で取引中止をほのめかされているという。"},{"spoiler":false,"text":"そんな美奈に主人公は、高収入を得られる慰安修道女として働くことを提案する。"}],"source":"bangumi","sourceCharacterId":"66579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77d232d02e7bcef06781a69b51ecee50a4e6c39a69a492824d745e844220e1e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d62d705c475e5cf2581250f53d4f5580555cacabe38264b7699b97f1059f10de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230192:66579:5890:1","source":"bangumi"}]},{"characterId":"char_c52077","characterName":"小笠原 レイナ","sourceIds":{"bangumi":[{"characterId":"66577","match":"exact-normalized-name-in-linked-work","subjectId":"230192"}],"egsCharacterIds":["27163"],"vndbCharacterId":"c52077"},"originalCharacterName":"小笠原 レイナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","sour