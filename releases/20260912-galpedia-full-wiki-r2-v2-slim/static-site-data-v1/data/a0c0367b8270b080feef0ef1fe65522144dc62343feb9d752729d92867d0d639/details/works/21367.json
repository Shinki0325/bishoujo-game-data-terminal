yStatus":"source-native","relationId":"vndb:vn-staff:116461","source":"vndb"},{"creditedName":"株式会社キューブ","creatorId":"vndb:s2651","sourcePersonId":"vndb:s2651","canonicalEntityId":"vndb:s2651","name":"株式会社キューブ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116464","source":"vndb"},{"creditedName":"葵橋 要","creatorId":"vndb:s9776","sourcePersonId":"vndb:s9776","canonicalEntityId":"vndb:s9776","name":"葵橋 要","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116466","source":"vndb"},{"creditedName":"人外 中村","creatorId":"vndb:s11349","sourcePersonId":"vndb:s11349","canonicalEntityId":"vndb:s11349","name":"人外 中村","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:116467","source":"vndb"},{"creditedName":"人外 中村","creatorId":"vndb:s11349","sourcePersonId":"vndb:s11349","canonicalEntityId":"vndb:s11349","name":"人外 中村","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116468","source":"vndb"},{"creditedName":"VAV","creatorId":"vndb:s11464","sourcePersonId":"vndb:s11464","canonicalEntityId":"vndb:s11464","name":"VAV","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116469","source":"vndb"},{"creditedName":"K-1","creatorId":"vndb:s11465","sourcePersonId":"vndb:s11465","canonicalEntityId":"vndb:s11465","name":"K-1","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116470","source":"vndb"},{"creditedName":"RRR","creatorId":"vndb:s11468","sourcePersonId":"vndb:s11468","canonicalEntityId":"vndb:s11468","name":"RRR","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116471","source":"vndb"},{"creditedName":"RUNA","creatorId":"vndb:s3057","sourcePersonId":"vndb:s3057","canonicalEntityId":"vndb:s3057","name":"SATOMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:116472","source":"vndb"}]},"cast":[{"characterId":"char_c32436","characterName":"八女 緑","sourceIds":{"bangumi":[{"characterId":"146751","match":"exact-normalized-name-in-linked-work","subjectId":"131838"}],"egsCharacterIds":["7440"],"vndbCharacterId":"c32436"},"originalCharacterName":"八女 緑","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"430"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"物語の主人公。"},{"spoiler":false,"text":"葉華国際学園（ようかこくさいがくえん）の二年生。"},{"spoiler":false,"text":"「門司　湊太（もじ　そうた）」とは、同じ部活だったことをきっかけとして交際を開始した。"},{"spoiler":false,"text":"しかし、御子や妖神について話してもらったことはなかったため、彼が進学したはずの大学を辞めて、御静屋に就職したことは全く知らなかった。"},{"spoiler":false,"text":"ある日、湊太が「梅枝　杏子（うめえだ　きょうこ）」と歩いているところを発見し、彼の後をついて行ってしまったことから、御子や妖神といった存在と関わりを持つようになってしまう。"},{"spoiler":false,"text":"果たして、自分はどうするべきなのか。"},{"spoiler":false,"text":"その答えを出すために、やがて緑は御静屋と本格的な関わりを持つようになっていく……。"},{"spoiler":false,"text":"「自分が何をやりたいか、かぁ……」"}],"source":"egs","sourceCharacterId":"7440","sourceWorkId":"21367","spoiler":false},{"segments":[{"spoiler":false,"text":"物語の主人公。 学生の時に部活動で知り合った門司湊太と交際している。"},{"spoiler":false,"text":"湊太は先に卒業して大学へと進学しており、以前ほどは会えない日が続いていた。"},{"spoiler":false,"text":"たまにデートもしているが、回数が減っているのが気になっており、大学で他にいい人ができたのではと心配していた。"},{"spoiler":false,"text":"そんなある日、湊太が知らない女性と一緒に歩いているのを目撃。"},{"spoiler":false,"text":"湊太たちを追い掛けたことによって、謎めいた組織・御静屋の存在を知ることになる。"},{"spoiler":false,"text":"「自分が何をやりたいか、かぁ……」"}],"source":"bangumi","sourceCharacterId":"146751"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66b320d96a1b8fa6b7e7cdbe151e8a24ce4468029759a9f0dca1cc34942e6919.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27f71b5de0e88273c4e9431350445b757c28b556a14fa26db11077989d84534a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131838:146751:15687:1","source":"bangumi"}]},{"characterId":"char_c32437","characterName":"梅枝 杏子","sourceIds":{"bangumi":[{"characterId":"146752","match":"exact-normalized-name-in-linked-work","subjectId":"131838"}],"egsCharacterIds":["7442"],"vndbCharacterId":"c32437"},"originalCharacterName":"梅枝 杏子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御静屋・福岡支部に属する女性。"},{"spoiler":false,"text":"御子への変身能力を持っており、主に福岡県内の海での妖神鎮めを担当している。"},{"spoiler":false,"text":"両親が御静屋の関係者であったため、子供の頃より御子になることを目指して成長してきた。"},{"spoiler":false,"text":"二年ほど前に福岡支部に赴任し、現在は重要な戦力として頼りにされている。"},{"spoiler":false,"text":"御子としては十分に一人前のため、後継者を育てることも求められているのだが、今のところ本人にそのつもりはない。"},{"spoiler":false,"text":"妖神鎮めに向かう際も、サポーターはつけず一人で行動している。"},{"spoiler":false,"text":"ある日、同僚の「門司　湊太（もじ　そうた）」と妖神鎮めに向かっているところを「八女　緑（やめ　みどり）」に見られてしまい、浮気相手なのではないかと疑われてしまった。"},{"spoiler":false,"text":"「だったら、時間をかけて話していくしかないんじゃない？」"}],"source":"egs","sourceCharacterId":"7442","sourceWorkId":"21367","spoiler":false},{"segments":[{"spoiler":false,"text":"御静屋・福岡支部に所属する女性。"},{"spoiler":false,"text":"異形である御子への変身能力を持っており、主に福岡県内で活動している。"},{"spoiler":false,"text":"基本的にはサポーターを付けていない。"},{"spoiler":false,"text":"両親も御静屋の関係者で、○○の頃から妖神に接して来た。"},{"spoiler":false,"text":"そのため当然のように “自分は御子になるんだ” と思いながら過ごしてきた。"},{"spoiler":false,"text":"「だったら、時間をかけて話していくしかないんじゃない？」"}],"source":"bangumi","sourceCharacterId":"146752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf0b32ac1cdca6c10c8b1bfba09f371b507745e81faf66522aaef61cba986e67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60e6643776367170bdfbb59985441d0b91c3da59957f2be3d3c637df9fabcd97.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131838:146752:15637:1","source":"bangumi"}]},{"characterId":"char_c32438","characterName":"呼子 伊香","sourceIds":{"bangumi":[{"characterId":"146753","match":"exact-normalized-name-in-linked-work","subjectId":"131838"}],"egsCharacterIds":["7444"],"vndbCharacterId":"c32438"},"originalCharacterName":"呼子 伊香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"緑のクラスメイト。"},{"spoiler":false,"text":"緑とは仲が良く、昼食を一緒にとったり、休日には一緒に遊びに出掛けたりする。"},{"spoiler":false,"text":"一方で、将来についてはしっかりと考えており、緑にプレッシャーを感じさせる一面も。"},{"spoiler":false,"text":"御子や妖神といった存在のことは、一切知らない。"},{"spoiler":false,"text":"「……わかりやすい嘘だけど、必要な時は相談に乗るから」"}],"source":"egs","sourceCharacterId":"7444","sourceWorkId":"21367","spoiler":false},{"segments":[{"spoiler":false,"text":"緑のクラスメイト。"},{"spoiler":false,"text":"緑とは仲が良く、昼食を一緒にとったり、休日には一緒に遊びに出掛けたりする。"},{"spoiler":false,"text":"一方で、将来についてはしっかりと考えており、緑にプレッシャーを感じさせる一面も。"},{"spoiler":false,"text":"御子や妖神といった存在のことは、一切知らない。"},{"spoiler":false,"text":"「……わかりやすい嘘だけど、必要な時は相談に乗るから」"}],"source":"bangumi","sourceCharacterId":"146753"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b4db649c3b2587a14eb5c76600dfd97964df93f4dd82af49daa3a95e5e8ab1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e26d8bb7ee2647513bc729713438943ae48e6a5bbf969f37e3a8a6733df31d75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長月 よつか","creatorId":"vndb:s14756","sourcePersonId":"vndb:s14756","canonicalEntityId":"vndb:s14756","name":"長月 よつか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62395","source":"vndb"}]},{"characterId":"char_c57570","characterName":"門司 湊太","sourceIds":{"bangumi":[{"characterId":"201292","match":"exact-normalized-name-in-linked-work","subjectId":"131838"}],"egsCharacterIds":["7441"],"vndbCharacterId":"c57570"},"originalCharacterName":"門司 湊太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御静屋・福岡支部に属する青年。"},{"spoiler":false,"text":"「八女　緑（やめ　みどり）」の恋人であり、葉華国際学園（ようかこくさいがくえん）の卒業生。"},{"spoiler":false,"text":"御子への変身能力を持っており、「佐瀬　保（させ たもつ）」のサポーターとして妖神鎮めを行っている。"},{"spoiler":false,"text":"もともと両親が御静屋の関係者であったため、子供の頃から御子としての修行を積んできた。"},{"spoiler":false,"text":"一度は大学に進学したものの、自分のやりたいことを見つめ直し中退。"},{"spoiler":false,"text":"福岡支部に所属し、保のサポーターとして活動することを決意した。"},{"spoiler":false,"text":"しかし、様々な事情から緑に言い出すことができず、結果として浮気の疑いをかけられることになってしまった。"},{"spoiler":false,"text":"「緑も覚悟した上で来てもらわないと、きっと後悔することになるから……」"}],"source":"egs","sourceCharacterId":"7441","sourceWorkId":"21367","spoiler":false},{"segments":[{"spoiler":false,"text":"御静屋・福岡支部に所属する男性。"},{"spoiler":false,"text":"修行の末に変身能力を獲得しているが、見習いであるため独断での変身は禁止されている。"},{"spoiler":false,"text":"御静屋では保のサポーターを務めており、プライベートでも仲が良く、人生相談のようなものにも乗ってもらっている。"},{"spoiler":false,"text":"交際相手の緑は同じ学園で部活の後輩だった。"},{"spoiler":false,"text":"以前より御静屋との関わりを持っていたのだが、緑に告げることができずに悩んでいた。"},{"spoiler":false,"text":"「緑も覚悟した上で来てもらわないと、きっと後悔することになるから……」"}],"source":"bangumi","sourceCharacterId":"201292"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26f1f8a36ec2f1a2ddffab3f2e5df8015d6999fa58ea61b47728ee5ff8b17adc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/295b274fb9efe5069453a7db506a7c1ab33c11fb9b22bc4f7d0efd9da36f0d0d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村圭佑","creatorId":"vndb:s924","sourcePersonId":"vndb:s924","canonicalEntityId":"vndb:s924","name":"夏村伊介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131838:201292:19138:1","source":"bangumi"}]},{"characterId":"char_c57571","characterName":"佐瀬 保","sourceIds":{"bangumi":[{"characterId":"201293","match":"exact-normalized-name-in-linked-work","subjectId":"131838"}],"egsCharacterIds":["7443"],"vndbCharacterId":"c57571"},"originalCharacterName":"佐瀬 保","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御静屋・福岡支部に属する男性。"},{"spoiler":false,"text":"御子への変身能力を持っており、主に福岡県内の山での妖神鎮めを担当している。"},{"spoiler":false,"text":"戦闘能力は極めて高く、これまでにも数々の成果を上げている。"},{"spoiler":false,"text":"現在は、湊太をサポーターにつけて活動しており、自分の後継者として教育中。"},{"spoiler":false,"text":"彼が一人前になった時点で、前線からは退こうと考えている。"},{"spoiler":false,"text":"見た目は渋いが、性格はわりと軽い。"},{"spoiler":false,"text":"また、ヒーローもののノリで、変身するときには「変身っ」と叫び、湊太にもそれを教え込んでいるのだが、今のところ受け入れられていない。"},{"spoiler":false,"text":"首に巻いた赤いマフラーは、心の師匠のトレードマークを真似ているとのこと。"},{"spoiler":false,"text":"「変身っ！」"}],"source":"egs","sourceCharacterId":"7443","sourceWorkId":"21367","spoiler":false},{"segments":[{"spoiler":false,"text":"御静屋・福岡支部に所属する男性。"},{"spoiler":false,"text":"御子への変身能力を持っており、戦闘能力は極めて高く、数々の成果を上げている。"},{"spoiler":false,"text":"現在は湊太をサポーターにして活動中。 彼が一人前になったら前線から退こうと考えている。"},{"spoiler":false,"text":"見た目は渋いが、わりと冗談も言うほうでノリはかなり軽い。"},{"spoiler":false,"text":"実際の性格的には三枚目。"},{"spoiler":false,"text":"「変身っ！」"}],"source":"bangumi","sourceCharacterId":"201293"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5c1f24fe6e29aae57a82dbaba5f3ade434efd8e3ed403a62afa8aa92ec88b06.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93574204013dc12e1bd9af26d13319bbf3fff38c12379fa9944132c19127d717.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒木大","creatorId":"vndb:s2273","sourcePersonId":"vndb:s2273","canonicalEntityId":"vndb:s2273","name":"黒木 大","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131838:201293:27368:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p2760","sourceCompanyId":"egs:brand:3572","canonicalEntityId":"vndb:p2760","name":"CYCLET","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21367:3572","source":"egs"},{"companyId":"vndb:p2760","sourceCompanyId":"vndb:p2760","canonicalEntityId":"vndb:p2760","name":"CYCLET","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:43625:v16536","source":"vndb"},{"companyId":"vndb:p2760","sourceCompanyId":"vndb:p2760","canonicalEntityId":"vndb:p2760","name":"CYCLET","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:45707:v16536","source":"vndb"},{"companyId":"vndb:p2760","sourceCompanyId":"vndb:p2760","canonicalEntityId":"vndb:p2760","name":"CYCLET","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:46284:v16536","source":"vndb"},{"companyId":"vndb:p2760","sourceCompanyId":"vndb:p2760","canonicalEntityId":"vndb:p2760","name":"CYCLET","r