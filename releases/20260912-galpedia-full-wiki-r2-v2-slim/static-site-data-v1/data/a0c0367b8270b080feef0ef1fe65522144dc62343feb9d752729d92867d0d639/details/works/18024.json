ndidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"占星術におけるシンボルは獅子座。"},{"spoiler":false,"text":"双子の主人公・総一と総二の幼なじみ。"},{"spoiler":false,"text":"総二と共に学園ごと異次元に飛ばされる。"},{"spoiler":false,"text":"性格は世話焼きでツンデレ。主人公たちだけでなく、一つ下の妹・陽月に対してもあれこれと面倒を見ている。"},{"spoiler":false,"text":"胸がやや小ぶりなのを気にしていて、特に妹（巨乳）と比較されがちなのが密かな悩み。"},{"spoiler":false,"text":"子供の頃に主人公たち双子と家が近所で仲が良かったが、主人公一家が引越ししたため、一度離れ離れとなる。"},{"spoiler":false,"text":"その後永幡学園の普通科に入学し、同学園の特能科に入学した主人公たちと再会を果たした。"},{"spoiler":false,"text":"基本的には強気なタイプだが、学園が異次元に飛ばされた後は、逆境に対する弱さを見せるようになる。"}],"source":"egs","sourceCharacterId":"998","sourceWorkId":"19803","spoiler":false},{"segments":[{"spoiler":false,"text":"占星術におけるシンボル：獅子座"},{"spoiler":false,"text":"双子の主人公・総一と総二の幼なじみ。 総二と共に学園ごと異次元に飛ばされる。"},{"spoiler":false,"text":"性格は世話焼きでツンデレ。 主人公たちだけでなく、一つ下の妹・陽月に対してもあれこれと面倒を見ている。"},{"spoiler":false,"text":"胸がやや小ぶりなのを気にしていて、特に妹 （巨乳） と比較されがちなのが密かな悩み。"},{"spoiler":false,"text":"子供の頃に主人公たちと家が近所で仲が良かったが、主人公一家が引越ししたため、一度離れ離れとなる。"},{"spoiler":false,"text":"その後永幡学園の普通科に入学し、同学園の特能科に入学した主人公たちと再会を果たした。"},{"spoiler":false,"text":"基本的には強気なタイプだが、学園が異次元に飛ばされた後は、逆境に対する弱さを見せるようになる。"},{"spoiler":false,"text":"「あたし… あんたにずっと隠してたことがあるの」"}],"source":"bangumi","sourceCharacterId":"54187"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6850e06cf80f8d99f278a07a761e142a08f0bd34055f8766f5087e3ea528d8e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b1c85eae1efdf0619045c8169b6550641fee16e4a82c37bea6da5c9a17b9f40.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-vo