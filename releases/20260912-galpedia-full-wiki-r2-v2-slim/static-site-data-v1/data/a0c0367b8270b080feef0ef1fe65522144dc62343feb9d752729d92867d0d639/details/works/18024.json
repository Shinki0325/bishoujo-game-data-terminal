3d984d70239e51282.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9b5a9a0b0596d516a5eb58f23c696fd14a8f271525b5b11f5b42423e6487cdc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:58677:54188:6046:1","source":"bangumi"}]},{"characterId":"char_c12352","characterName":"渡会 蒼","sourceIds":{"bangumi":[{"characterId":"54189","match":"exact-normalized-name-in-linked-work","subjectId":"58677"}],"egsCharacterIds":["1000"],"vndbCharacterId":"c12352"},"originalCharacterName":"渡会 蒼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"占星術におけるシンボルは射手座。"},{"spoiler":false,"text":"主人公たちの一つ年上の先輩。"},{"spoiler":false,"text":"ミステリアスな雰囲気を持つ美人さん。"},{"spoiler":false,"text":"近くにある精密機械を無差別に狂わせるという特殊な体質で、その体質の謎を解明するべく学園側に誘われ、特能科三年に在籍している。"},{"spoiler":false,"text":"上記の特殊体質ゆえに携帯電話やパソコンも使えず、周りの人間の携帯も使用不能にしてしまうため、ほとんど友人がいない。"},{"spoiler":false,"text":"何故か大量のフォークとスプーンを常に持ち歩いており、時にはそれが凶器と化す。"},{"spoiler":false,"text":"実は昔、総一と付き合っていた時期があったが、長続きせずにすぐ別れたという。"},{"spoiler":false,"text":"（ちなみに総一が紳士だったため、今も処女らしい。）"},{"spoiler":false,"text":"放課後たまたま学園に残っていた為、事件に巻き込まれる。"}],"source":"egs","sourceCharacterId":"1000","sourceWorkId":"19803","spoiler":false},{"segments":[{"spoiler":false,"text":"占星術におけるシンボル：射手座"},{"spoiler":false,"text":"主人公たちの一つ年上の先輩。 ミステリアスな雰囲気を持つ美人さん。"},{"spoiler":false,"text":"近くにある精密機械を無差別に狂わせるという特殊な体質で、その体質の謎を解明するべく学園側に誘われ、特能科三年に在籍している。"},{"spoiler":false,"text":"上記の特殊体質ゆえに携帯電話やパソコンも使えず、周りの人間の携帯も使用不能にしてしまうため、ほとんど友人がいない。"},{"spoiler":false,"text":"何故か大量のフォークとスプーンを常に持ち歩いており、時にはそれが凶器と化す。"},{"spoiler":false,"text":"実は昔、総一と付き合っていた時期があったが、長続きせずにすぐ別れたという。（ちなみに総一が紳士だったため、今も処女らしい。）"},{"spoiler":false,"text":"放課後たまたま学園に残っていたため、事件に巻き込まれる。"},{"spoiler":false,"text":"「私は、知らなくちゃいけない―― この学園の秘密を」"}],"source":"bangumi","sourceCharacterId":"54189"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9016df4e6f30e5701a6a7ecbeec9b5672f25f7eb7e524645561fb2678d5177f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25e59ae597773b1bd48ef73d597e10687faf26c54490bb44a5123b8ac8380062.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:58677:54189:4689:1","source":"bangumi"}]},{"characterId":"char_c12353","characterName":"山本 テスラ","sourceIds":{"bangumi":[{"characterId":"54190","match":"exact-normalized-name-in-linked-work","subjectId":"58677"}],"egsCharacterIds":["1001"],"vndbCharacterId":"c12353"},"originalCharacterName":"山本 テスラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"占星術におけるシンボルは水瓶座。"},{"spoiler":false,"text":"主人公たちと同じ特能科のクラスメイトで、サヴァン症候群の少女。"},{"spoiler":false,"text":"見たものを一瞬で記憶し、それを正確にスケッチできる能力を持つ。"},{"spoiler":false,"text":"（この為いつもスケッチブックを持ち歩いている）"},{"spoiler":false,"text":"その反面、学習能力やコミュニケーション能力に乏しく、何を考えているのかわかりづらいが、基本的に子供のように無垢で無邪気な性格。"},{"spoiler":false,"text":"何故か主人公たち双子に興味津々な様子で、双子を見ると必ずどちらかの顔に落書きしようとする。"},{"spoiler":false,"text":"学園が消失した跡地に一人だけ取り残されていて、学園の外に居て難を逃れた総一によって保護されるが…"},{"spoiler":false,"text":"彼女は同時に、異次元に飛んだ学園のほうにも存在していた。"},{"spoiler":false,"text":"しかし総一にはそれを知る由もなく――"}],"source":"egs","so