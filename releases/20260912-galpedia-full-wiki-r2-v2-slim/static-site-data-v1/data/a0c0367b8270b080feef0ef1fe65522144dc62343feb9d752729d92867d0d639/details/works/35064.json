{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"35064","model":{"presentationWorkId":"egs:35064","staff":{"artwork":[{"creditedName":"シツジ","creatorId":"egs:creator:22244","sourcePersonId":"egs:creator:22244","canonicalEntityId":"egs:creator:22244","name":"シツジ","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:271677","source":"egs"}],"scenario":[{"creditedName":"藤井リルケ","creatorId":"vndb:s4254","sourcePersonId":"egs:creator:12802","canonicalEntityId":"vndb:s4254","name":"藤井リルケ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:271673","source":"egs"},{"creditedName":"谷一","creatorId":"vndb:s6469","sourcePersonId":"egs:creator:19783","canonicalEntityId":"vndb:s6469","name":"谷一","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:271674","source":"egs"},{"creditedName":"平乃ひら","creatorId":"vndb:s9857","sourcePersonId":"egs:creator:24262","canonicalEntityId":"vndb:s9857","name":"平乃ひら","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:271675","source":"egs"},{"creditedName":"中村亮太","creatorId":"vndb:s4625","sourcePersonId":"egs:creator:19781","canonicalEntityId":"vndb:s4625","name":"中村亮太","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:271676","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_141437","characterName":"エフィー","sourceIds":{"bangumi":[{"characterId":"141437","match":"source-roster","subjectId":"418573"}]},"originalCharacterName":"エフィー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"■エフィー(昼)"},{"spoiler":false,"text":"優しく、大人しい女の子。"},{"spoiler":false,"text":"昼間は街の酒場で、看板娘として働いている。"},{"spoiler":false,"text":"その性格と愛らしい外見のおかげもあって、"},{"spoiler":false,"text":"常連さんからの人気は高い。"},{"spoiler":false,"text":"エッチなことに関する知識が少ないせいで、"},{"spoiler":false,"text":"たまにセクハラされたりも……"},{"spoiler":false,"text":"しかし、こう見えて信念は強い方であり、"},{"spoiler":false,"text":"困っている人は放っておけないところも。"},{"spoiler":false,"text":"■エフィー(夜)"},{"spoiler":false,"text":"夜になると怪盗の姿に変身し、街を駆け回る。"},{"spoiler":false,"text":"昼間とは変わって、明るく元気いっぱいの性格に。"},{"spoiler":false,"text":"性格が変わる理由は本人もよくわかっていないが、"},{"spoiler":false,"text":"あまり気にしている様子はない。"},{"spoiler":false,"text":"昼とは違って勢いだけで突っ走るところがあるせいで、"},{"spoiler":false,"text":"ちょくちょくHなトラップに引っかかったりも……。"},{"spoiler":false,"text":"今夜も『人助けをしたい!』という強い信念の元、"},{"spoiler":false,"text":"ノリノリで悪者から盗られたものを奪い返す。"}],"source":"bangumi","sourceCharacterId":"141437"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8907a07b769309c5d0ba240e84429a3972311f0843a7909e83ad4faf8c5b5e8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/909066784e35897feaab740b0f4934110b3d5a657bad89dca303780275560de8.webp","width":168,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_141438","characterName":"レン","sourceIds":{"bangumi":[{"characterId":"141438","match":"source-roster","subjectId":"418573"}]},"originalCharacterName":"レン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"■レン"},{"spoiler":false,"text":"エフィーを(勝手に)ライバル視している女の子。"},{"spoiler":false,"text":"エフィーの正体が酒場の店員だとは気づいておらず、"},{"spoiler":false,"text":"よく酒場に食事をしにやって来る。"},{"spoiler":false,"text":"かつて名を馳せた『伝説の義賊』に憧れており、"},{"spoiler":false,"text":"義賊になるために本気で行動している。"},{"spoiler":false,"text":"のだが……"},{"spoiler":false,"text":"いつもドジをして、エッチな罠に引っかかっている。"},{"spoiler":false,"text":"その度にエフィーに助けられて、悔しがるポンコツ娘。"},{"spoiler":false,"text":"◆レン(昼)(CV:砂糖しお)"},{"spoiler":false,"text":"夢は悪を倒し、人を救う伝説の怪盗になること。"},{"spoiler":false,"text":"幼い頃に見た怪盗にあこがれ、その姿を追い続けている。"},{"spoiler":false,"text":"昼は目立たないように仮の姿で酒場に入り浸り、"},{"spoiler":false,"text":"悪党の情報を日々収集している。"},{"spoiler":false,"text":"酒場の名物、激辛ソーセージが大好き。"},{"spoiler":false,"text":"◆レン(夜)(CV:砂糖しお)"},{"spoiler":false,"text":"魔法の力で「怪盗ホワイトフォックス」となり、"},{"spoiler":false,"text":"日々悪党たちと戦っている。"},{"spoiler":false,"text":"しかしその行動はスマートとは言えず、"},{"spoiler":false,"text":"何度もエッチなトラップに引っ掛かってしまう。"},{"spoiler":false,"text":"猪突猛進な性格でどこか抜けてる、ちょっと残念な子。"}],"source":"bangumi","sourceCharacterId":"141438"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1a0e434c09840c6afc51313e474d075ac0b4b915aef96163b2ca27168cc6e84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f155bbf1aa55c9953103b53299d4c423606cf3204debba1536ccc282c8829ee.webp","width":169,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p29205","sourceCompanyId":"egs:brand:7987","canonicalEntityId":"vndb:p29205","name":"やまなし娘。","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:35064:7987","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
