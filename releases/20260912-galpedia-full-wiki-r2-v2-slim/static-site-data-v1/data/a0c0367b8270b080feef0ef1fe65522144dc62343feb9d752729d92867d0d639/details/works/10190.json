poiler":false},{"segments":[{"spoiler":false,"text":"トウヤ（大人編主人公）の双子の妹。見た目は強気で男勝りな性格だが、主人公の前ではおしとやかで優しい、心からの笑顔を見せる少女。"},{"spoiler":false,"text":"兄である主人公のことが何よりも大事であり、それが彼女の生きる全て。兄に対する異常なまでの愛情は留まることを知らず、肉体関係を持つまでのものである。"}],"source":"bangumi","sourceCharacterId":"146023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92e8b0494b6e27cacacde3ba2091d014640b2b13e4e48cd8c60df41d91695433.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/212ddd420e15ea5b19354b4833151bf75e31499410f13ea7d303bb10ce2d5a34.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269984:146023:6379:1","source":"bangumi"}]},{"characterId":"char_vndb_c24878","characterName":"リップ・ゲルソーク・ゼングルクル","sourceIds":{"vndbCharacterId":"c24878"},"originalCharacterName":"リップ・ゲルソーク・ゼングルクル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"229"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main protagonist. As a kid, she was selected as the queen candidate and traveled to the human world from the demon world to study magic. She grows up to fight demonic tentacle beasts in the second part of the story."}],"source":"vndb","sourceCharacterId":"c24878"}],"profil