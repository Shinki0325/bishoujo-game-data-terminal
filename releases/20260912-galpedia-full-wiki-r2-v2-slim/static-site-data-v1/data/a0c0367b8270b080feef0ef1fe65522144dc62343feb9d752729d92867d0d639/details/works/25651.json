etadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アイエフ、コンパとともに協会に預けられているもう一人の赤ん坊 素直で明るくg年季でそして何よりもお馬鹿。 どのくらいお馬鹿かというと、ネプテューヌよりも お馬鹿という稀有な存在。 しかし、それゆえかネプテューヌとは波長が合うらしく、 暇さえあれば二人で真剣勝負と言うなのじゃれあいを繰り広げている。"}],"source":"bangumi","sourceCharacterId":"21006"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35ab45974fe9493bb942215419b71c1aa25190531ba4abf542d892ed4d669370.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/336abae5a2e303601ea6cb55aced307cd9be06e097e399ca59d18c551174a92b.webp","width":256,"height":255,"source":"static-detail"},"actors":[{"creditedName":"悠木碧","creatorId":"vndb:s1321","sourcePersonId":"vndb:s1321","canonicalEntityId":"vndb:s1321","name":"悠木 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185731:21006:5076:1","source":"bangumi"}]},{"characterId":"char_bangumi_21008","characterName":"Pluto","sourceIds":{"bangumi":[{"characterId":"21008","match":"source-roster","subjectId":"185731"}]},"originalCharacterName":"Pluto","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神次元のプラネテューヌの女神。 その外見通り、性格はのんびりほわほわの天然系であり考えが読みづらい。ノワールとは友達同士。女神になった理由は、メモリーコア付近にピクニックに行った際、間違って食べてしまったため。"},{"spoiler":false,"text":"女神化した際の見た目はネプテューヌ同様の元の姿と似つかない物へと変化する。プロセッサユニットは歴代セガハード風である(初期コスチュームはメガドライブ風。"},{"spoiler":false,"text":"名前の由来はプルート（冥王星）。また、ネプテューヌ姉妹と同様モデルは「架空ハード」である。なお、アイリスとは虹(＝七色)を意味する。ハードフォームは「戦闘機」。"}],"source":"bangumi","sourceCharacterId":"21008"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80421e6f5c3c14d5882a1ace0fd8dc2ab89f59c20c99bae6aa14752ab8d4656a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19f7f7296cd5b096f6e2607f56a1c9cc1f05d8b4de7680cd45f2a1fcbe91d327.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤香菜","creatorId":"vndb:s237","sourcePersonId":"vndb:s237","canonicalEntityId":"vndb:s237","name":"花澤香菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185731:21008:4765:1","source":"bangumi"}]},{"characterId":"char_bangumi_50736","characterName":"Uzume Tennouboshi","sourceIds":{"bangumi":[{"characterId":"50736","match":"source-roster","subjectId":"185731"}]},"originalCharacterName":"Uzume Tennouboshi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"零次元唯一的守护女神，变身后为橙色之心（Orange Heart），一直为了拯救零次元而努力着。"},{"spoiler":false,"text":"四女神オンライン CYBER DIMENSION NEPTUNE中"},{"spoiler":false,"text":"男勝りでぶっきらぼうな言動だが、根は優しく義理人情に厚い少女。"},{"spoiler":false,"text":"カッコよさへの追及や憧れが人一倍強く、カッコいいと褒められることに弱い。"},{"spoiler":false,"text":"夢見がちで妄想癖が激しかったり女の子っぽい一面も…。"},{"spoiler":false,"text":"ゲーム内での職業は格闘家。武器を持たず、己の肉体だけで戦う姿がカッコいいかららしい。"},{"spoiler":false,"text":"自分磨きのためにソロプレイで攻略を進めている。"}],"source":"bangumi","sourceCharacterId":"50736"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6e05192b28a06d138b433e028ad112ecd4701bcf7957967c8bf1e7dac90f577.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dddd5867ab29190ccd44d109e849ba77ff14f4916221a4ed68b432ad6dbd09e.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本多真梨子","creatorId":"vndb:s5178","sourcePersonId":"vndb:s5178","canonicalEntityId":"vndb:s5178","name":"本多真梨子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185731:50736:5203:1","source":"bangumi"}]},{"characterId":"char_bangumi_63273","characterName":"キリア","sourceIds":{"bangumi":[{"characterId":"63273","match":"source-roster","subjectId":"185731"}]},"originalCharacterName":"キリア","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『四女神オンライン』のβテストに参加している"},{"spoiler":false,"text":"プレイヤー。"},{"spoiler":false,"text":"キザでかっこつけな女の子。"},{"spoiler":false,"text":"根はいい奴で頑張り屋でゲームも上手という一見非の打ちどころがないように見えるが、素直すぎて利用されることが多く、妙に報われない。"},{"spoiler":false,"text":"†黒猫姫†とは他のゲームで知り合い、好意を寄せているのだが構ってもらえないことも。"},{"spoiler":false,"text":"反射神経が優れており、他のゲームでは"},{"spoiler":false,"text":"ランカー『黒の騎士』として名が知れ渡っている。"}],"source":"bangumi","sourceCharacterId":"63273"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/683aa82cfa2b1bebbdc4c93d13a738b3d8d908733e4cae7b09e550dbf72a23fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/6070fd62544834841a304e56fadc60fbf135f4955dca0cdd34ee75f06b1c6510.webp","width":116,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千本木彩花","creatorId":"vndb:s12945","sourcePersonId":"vndb:s12945","canonicalEntityId":"vndb:s12945","name":"千本木 彩花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185731:63273:10838:1","source":"bangumi"}]},{"characterId":"char_bangumi_63275","characterName":"†黒猫姫†","sourceIds":{"bangumi":[{"characterId":"63275","match":"source-roster","subjectId":"185731"}]},"originalCharacterName":"†黒猫姫†","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『四女神オンライン』のβテストに参加しているプレイヤー。"},{"spoiler":false,"text":"周囲から愛されるプリティーな女の子。"},{"spoiler":false,"text":"というのは表面だけ。"},{"spoiler":false,"text":"本性はめちゃくちゃドライであざとい腹黒。"},{"spoiler":false,"text":"自分が大好きで可愛がられるキャラを"},{"spoiler":false,"text":"知り尽くしている。"},{"spoiler":false,"text":"どのゲームでも強い集団に囲われるため今まで苦労を"},{"spoiler":false,"text":"したことはないが、実はゲームの腕はかなりのもの。"},{"spoiler":false,"text":"自分が原因で最近ギルドを崩壊させたばかり。"},{"spoiler":false,"text":"そのため囲いはキリアのみである。"}],"source":"bangumi","sourceCharacterId":"63275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18cd3f00ebb36b3785f03676c37df3f6dc5b55b0888feb6875b2e5f9cb5b7b7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63e61a2065530320d635be2c13f0f2228b7f22d5bbf939a5c6139eb37c8b4b8e.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本彩乃","creatorId":"vndb:s2231","sourcePersonId":"vndb:s2231","canonicalEntityId":"vndb:s2231","name":"山本 彩乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185731:63275:8274:1","source":"bangumi"}]},{"characterId":"char_bangumi_63280","characterName":"タムソフト","sourceIds":{"bangumi":[{"characterId":"63280","match":"source-roster","subjectId":"185731"}]},"originalCharacterName":"タムソフト","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お祭りなどの楽しいことが大好きな巨乳の少女。"},{"spoiler":false,"text":"明るくさっぱりとした性格だが、時折豪快な一面を見せることも。"},{"spoiler":false,"text":"お祭りのクジで『四女神オンライン』のアーリーアクセス権を手に入れ、βテストに参加することとなった。"},{"spoiler":false,"text":"ゲーム内の職業は鍛冶工。武器の生産スキルを活かして他の冒険者の武器を強化をしている。"},{"spoiler":false,"text":"仕事が早く、評判はかなりいい様子。"}],"source":"bangumi","sourceCharacterId":"63280"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1164a8eff650d889e9575b61b36bb909d40ad814857feb14859f290e154cc0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40e008b923fe7226d608915998529f0ac579676f40c72610e95f35299b6b4184.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185731:63280:4474:1","source":"bangumi"}]},{"characterId":"char_bangumi_63302","characterName":"ブーケ","sourceIds":{"bangumi":[{"characterId":"63302","match":"source-roster","subjectId":"185731"}]},"originalCharacterName":"ブーケ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『四女神オンライン』に登場するNPCで"},{"spoiler":false,"text":"会話のための人工知能を搭載している。"},{"spoiler":false,"text":"アルスガルドの秩序を守る"},{"spoiler":false,"text":"守護精霊（ロイヤルガイスト）。"},{"spoiler":false,"text":"様々な場所で冒険者に助言をしてくれる。"},{"spoiler":false,"text":"妹を欲しがっているベールに一目惚れされ、"},{"spoiler":false,"text":"妹候補にロックオンされた。"},{"spoiler":false,"text":"真面目かつ勉強熱心で会話でわからない単語が"},{"spoiler":false,"text":"出てくるとすぐに調べてしまう。"}],"source":"bangumi","sourceCharacterId":"63302"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2395b06ce37e6a4a8abb7b517d607ca3a84ab95b44ea65dbe2690a896395e611.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/ch