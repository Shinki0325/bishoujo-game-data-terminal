s","sourceCharacterId":"20090","sourceWorkId":"27038","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・彗と同じ学園、クラスに通う同級生。"},{"spoiler":false,"text":"周りを引っ張るリーダータイプ。"},{"spoiler":false,"text":"学生会では副会長を務めている。"},{"spoiler":false,"text":"明るい性格で細かな気遣いができるので、"},{"spoiler":false,"text":"誰にでも好かれる学園のカリスマだが、"},{"spoiler":false,"text":"彗の言動にだけは突っかかっていってしまう。"},{"spoiler":false,"text":"その実は、彗の事が気になってしょうがないけど"},{"spoiler":false,"text":"気持ちを知られるのが恥ずかしいから、という裏返し。"},{"spoiler":false,"text":"とある事故がきっかけで彗が住む屋敷でメイドをすることになる。"}],"source":"bangumi","sourceCharacterId":"64806"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f12f8fe1b725d0c668e411c06f1439d90560184700d126b042386ed425bf43d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/965fe0c34180da2b2520cc68fc4fced21213cd668a0748c220b58e64ad378f1e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"戸板優衣","creatorId":"vndb:s10510","sourcePersonId":"vndb:s10510","canonicalEntityId":"vndb:s10510","name":"戸板 優衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:253720:64806:24908:1","source":"bangumi"}]},{"characterId":"char_vndb_c72805","characterName":"津田 彗","sourceIds":{"vndbCharacterId":"c72805"},"originalCharacterName":"津田 彗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p7587","sourceCompanyId":"egs:brand:5716","canonicalEntityId":"vndb:p7587","name":"とこはな","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27038:5716","source":"egs"},{"companyId":"vndb:p20513","sourceCompanyId":"vndb:p20513","ca