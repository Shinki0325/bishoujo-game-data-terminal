roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114482","source":"vndb"},{"creditedName":"まゆき","creatorId":"vndb:s10649","sourcePersonId":"vndb:s10649","canonicalEntityId":"vndb:s10649","name":"まゆき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114483","source":"vndb"}]},"cast":[{"characterId":"char_c42600","characterName":"ヴェティ","sourceIds":{"bangumi":[{"characterId":"29924","match":"exact-normalized-name-in-linked-work","subjectId":"117677"}],"egsCharacterIds":["5594"],"vndbCharacterId":"c42600"},"originalCharacterName":"ヴェティ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Aliases: Eurydice no β, Eurydice no beta, Artemis."}],"source":"vndb","sourceCharacterId":"c42600"},{"segments":[{"spoiler":false,"text":"とある事件においてゼファーとの邂逅により目覚めた謎の少女。愛称はヴェティ。"},{"spoiler":false,"text":"出自、目的、行動理念のすべてが不明というミステリアスな存在であり、意味深な問いかけを口にしたり不可思議な言動で周囲を煙に巻くことが多い。"},{"spoiler":false,"text":"極めて捉えどころのない性格をしているが、決して嫌な人間ではなく、外見にそぐわないまるで母親じみた面倒見の良さを覗かせる場面も。"},{"spoiler":false,"text":"ゼファーには一見辛辣だが、その実好意的な感情を見せている。しかし当の彼は彼女を強く忌避しており、何故か多大な恐怖を感じている。"},{"spoiler":false,"text":"なお、ヴェンデッタという名前はあくまで自称。"},{"spoiler":false,"text":"彼女を知る者たちからは“死想恋歌（エウリュディケ）”とも呼ばれているようだが、はたして……"}],"source":"egs","sourceCharacterId":"5594","sourceWorkId":"21143","spoiler":false},{"segments":[{"spoiler":false,"text":"とある事件においてゼファーと邂逅し目覚めた謎の少女。 愛称はヴェティ。"},{"spoiler":false,"text":"出自・目的・行動理念、すべてが不明というミステリアスな存在。"},{"spoiler":false,"text":"意味深な問いかけを口にしたり、不可思議な言動で周囲を煙に巻いたりする。"},{"spoiler":false,"text":"極めて捉えどころのない性格をしているが、決して嫌な人間ではない。"},{"spoiler":false,"text":"外見にそぐわない、まるで母親じみた面倒見の良さを覗かせる場面もある。"},{"spoiler":false,"text":"ゼファーには一見辛辣だが、その実 好意的な感情を見せている。"},{"spoiler":false,"text":"しかし当の彼は彼女を強く忌避しており、何故か多大な恐怖を感じている。"},{"spoiler":false,"text":"なお、ヴェンデッタという名前はあくまで自称。"},{"spoiler":false,"text":"彼女を知る者たちからは “死想恋歌 （エウリュディケ）” とも呼ばれているようだが……"},{"spoiler":false,"text":"「── “勝利” からは逃げられない。 さあ、逆襲（ヴェンデッタ）を始めましょう」"}],"source":"bangumi","sourceCharacterId":"29924"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9103ae152c16649f0fd52c7c627153553888c310eceaf3815fdb6438c94044ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abd9c489390aa90d32c6884346ee128417f960c29d8d72b396228e190724d4b1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:117677:29924:4490:1","source":"bangumi"}]},{"characterId":"char_c42627","characterName":"ミリアルテ・ブランシェ","sourceIds":{"bangumi":[{"characterId":"29925","match":"exact-normalized-name-in-linked-work","subjectId":"117677"}],"egsCharacterIds":["5595"],"vndbCharacterId":"c42627"},"originalCharacterName":"ミリアルテ・ブランシェ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゼファーと共に暮らしている彼の妹。愛称はミリィ。"},{"spoiler":false,"text":"五年前の大虐殺で両親を失っているが、それを感じさせず性格は気丈で温和。家事万能で家族想い、気立ても良しと、年齢に似合わず非常に器量が良い。そして兄に仄かな恋心を抱く、愛らしいお年頃の女の子である。"},{"spoiler":false,"text":"奏鋼調律師（ハーモナイザー）の卵で、通常の鉄鋼業技術者（エンジニア）とは一線を隔するほど非常に優秀。ただしその意欲ゆえか、専門知識を語らせると止まらなくなるという一面も。"},{"spoiler":false,"text":"ジンを師と仰ぎ、彼の工房で日々修行中。今は過去の傷を乗り越えて充実した毎日を送っている。"},{"spoiler":false,"text":"ゼファーを兄と呼び慕っているが二人に血縁上の繋がりはない。"}],"source":"egs","sourceCharacterId":"5595","sourceWorkId":"21143","spoiler":false},{"segments":[{"spoiler":false,"text":"ゼファーと共に暮らしている彼の妹。 愛称はミリィ。"},{"spoiler":false,"text":"5年前の大虐殺で両親を失っているが、それを感じさせず性格は気丈で温和。"},{"spoiler":false,"text":"家事万能で家族想い、気立ても良しと、年齢に似合わず非常に器量が良い。"},{"spoiler":false,"text":"ゼファーを兄と呼び慕っているが、ふたりに血縁上の繋がりはない。"},{"spoiler":false,"text":"そしてそんな兄に仄かな恋心を抱く、愛らしいお年頃の女の子である。"},{"spoiler":false,"text":"奏鋼調律師 （ハーモナイザー） の卵で、通常の鉄鋼業技術者とは一線を隔するほど優秀。"},{"spoiler":false,"text":"ただしその意欲ゆえか、専門知識を語らせると止まらなくなるという一面も。"},{"spoiler":false,"text":"ジンを師と仰ぎ、彼の工房で日々修行中。 過去の傷を乗り越えて充実した毎日を送っている。"},{"spoiler":false,"text":"「兄さんのプレゼントは、それだけで一生の宝物だもん」"}],"source":"bangumi","sourceCharacterId":"29925"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91c696a875c8310349125c8cde35f2f2f7f03c8b5bb8ec08f0918bb736509884.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d284981c39da42df20c48eb8e5d35ef9789f120465e48b122edbd3ab33a8963.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:117677:29925:4646:1","source":"bangumi"}]},{"characterId":"char_c42764","characterName":"ゼファー・コールレイン","sourceIds":{"bangumi":[{"characterId":"29923","match":"exact-normalized-name-in-linked-work","subjectId":"117677"}],"egsCharacterIds":["5593"],"vndbCharacterId":"c42764"},"originalCharacterName":"ゼファー・コールレイン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Aliases: Hades, 冥王"}],"source":"vndb","sourceCharacterId":"c42764"},{"segments":[{"spoiler":false,"text":"やる気なし、金なし、職業なし。三拍子そろった本作の主人公。"},{"spoiler":false,"text":"やる時にはやれるポテンシャルは備えているものの、長い戦場経験がトラウマになっているせいか、徹底して追い込まれない限り本気を出さないという悪癖を持つ。"},{"spoiler":false,"text":"反面、性格に似合わぬ戦闘力は過去の熾烈な経験に裏打ちされたもの。とりわけ暗殺、奇襲、一撃必殺といった有無を言わせぬ戦い方に対して偏った適性を備えている。"},{"spoiler":false,"text":"大虐殺時に逃げ出した経験があり、軍から見れば脱走兵という立場。そのため自分の存在が帝国にバレることを極度に恐れつつ、妹のミリィとささやかな日常を過ごしている。おかげでわりとシスコンに。"},{"spoiler":false,"text":"過去にヴァルゼライドの戦闘を見たことで“英雄”とは怪物の同義語であると悟った。星辰奏者（エスペラント）の強靭な肉体を持ちながら自分の力を欠片も信じておらず、自己評価が非常に低いのはそれが原因なのだろう。"}],"source":"egs","sourceCharacterId":"5593","sourceWorkId":"21143","spoiler":false},{"segments":[{"spoiler":false,"text":"やる気なし、金なし、職業なし。 三拍子揃った本作の主人公。"},{"spoiler":false,"text":"やる時はやれるが、長い戦場経験がトラウマで、徹底して追い込まれないと本気を出さない。"},{"spoiler":false,"text":"反面、性格に似合わぬ戦闘力は過去の熾烈な経験に裏打ちされたもの。"},{"spoiler":false,"text":"とりわけ暗殺や奇襲など、有無を言わせぬ戦い方に対して偏った適性を備えている。"},{"spoiler":false,"text":"大虐殺時に逃げ出した経験があり、軍から見れば脱走兵という立場。"},{"spoiler":false,"text":"自分の存在が帝国にバレることを極度に恐れ、妹のミリィとささやかな日常を過ごしている。"},{"spoiler":false,"text":"おかげでわりとシスコン気味。"},{"spoiler":false,"text":"過去にヴァルゼライドの戦闘を見たことで、“英雄” とは “怪物” の同義語であると悟った。"},{"spoiler":false,"text":"自身も星辰奏者 （エスペラント） として強靭な肉体を持ちながら、自分の力を欠片も信じていない。"},{"spoiler":false,"text":"「うわ、なんというスパルタ。 未来の儲けは儲けじゃないと申すとは」"}],"source":"bangumi","sourceCharacterId":"29923"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cba4298006a6409c0be223a9548b78c6b6d6e1edb2305f67a95e160c18fdb5c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01fd0b8672388c73e4cd043b51efdfadbb875ea804df51d7816052d8d2c24ddb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田剛","creatorId":"vndb:s990","sourcePersonId":"vndb:s990","canonicalEntityId":"vndb:s990","name":"前田 剛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:117677:29923:4484:1","source":"bangumi"}]},{"characterId":"char_c42832","characterName":"チトセ・朧・アマツ","sourceIds":{"bangumi":[{"characterId":"29926","match":"exact-normalized-name-in-linked-work","subjectId":"117677"}],"egsCharacterIds":["5596"],"vndbCharacterId":"c42832"},"originalCharacterName":"チトセ・朧・アマツ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝国軍の象徴たる黄道十二星座部隊（ゾディアック）が一つ、第七特務部隊・裁剣天秤（ライブラ）の隊長を務める女傑。帝国最高峰の星辰奏者（エスペラント）。"},{"spoiler":false,"text":"日系の血を色濃く継いだ貴種（アマツ）の一人でもあり、特権階級の出身ながら不断の努力を好むなど、優れた向上心を持つ。いわゆる“堅実な天才”。"},{"spoiler":false,"text":"卓越した戦闘技能はそれら意志力で獲得したものであり、才能に胡坐をかいた者では鎧袖一触されるのみ。だが厳然たる能力主義のためか、野心家という側面も。己が成すべき使命のためには現総統であるヴァルゼライドへの背信も辞さないという覚悟があり、そのためアオイとは従姉妹という関係ながら常にその動向を警戒されている状態。"},{"spoiler":false,"text":"五年前の大虐殺では離反した相棒との一戦により、生涯唯一の敗北を喫した。その際に右目を喪失。眼帯を着用しているのはこのためである。"}],"source":"egs","sourceCharacterId":"5596","sourceWorkId":"21143","spoiler":false},{"segments":[{"spoiler":false,"text":"帝国軍の象徴たる黄道十二星座部隊 （ゾディアック） が一つ、第七特務部隊・裁剣天秤 （ライブラ） の隊長を務める女傑。 帝国最高峰の星辰奏者（エスペラント）。"},{"spoiler":false,"text":"日系の血を色濃く継いだ貴種 （アマツ） の一人でもあり、特権階級の出身ながら不断の努力を好むなど、優れた向上心を持つ。 いわゆる “堅実な天才” 。"},{"spoiler":false,"text":"卓越した戦闘技能はそれら意志力で獲得したものであり、才能に胡坐をかいた者では鎧袖一触されるのみ。"},{"spoiler":false,"text":"だが厳然たる能力主義のためか、野心家という側面も。"},{"spoiler":false,"text":"己が成すべき使命のためには、現総統・ヴァルゼライドへの背信も辞さないという覚悟があり、"},{"spoiler":false,"text":"そのためアオイとは従姉妹という関係ながら、常にその動向を警戒されている状態。"},{"spoiler":false,"text":"5年前の大虐殺では離反した相棒との一戦により、生涯唯一の敗北を喫した。"},{"spoiler":false,"text":"その際に右目を喪失し、現在は眼帯を着用している。"},{"spoiler":false,"text":"帝"},{"spoiler":false,"text":"「おまえのすべては五年前から私のモノだよ、ゼファー」"}],"source":"bangumi","sourceCharacterId":"29926"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/703748287d303447cf0be2c014aa71eb86c19755869b832985340053eeabc1e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7aaeb43edff6a65e2d4545192ffafafe7fa206a36f714360b3dd59a53f68813c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:117677:29926:5900:1","source":"bangumi"}]},{"characterId":"char_c42842","characterName":"クリストファー・ヴァルゼライド","sourceIds":{"bangumi":[{"characterId":"29927","match":"exact-normalized-name-in-linked-work","subjectId":"117677"}],"egsCharacterIds":["5597"],"vndbCharacterId":"c42842"},"originalCharacterName":"クリストファー・ヴァルゼライド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Aliases: Zeus, 天頂神, Zeus-γ, ゼウス－No.γ"}],"source":"vndb","sourceCharacterId":"c42842"},{"segments":[{"spoiler":false,"text":"軍事帝国アドラー第三十七代総統。生ける伝説。"},{"spoiler":false,"text":"彼を現すは一言、“英雄”。帝国最強にして始まりの星辰奏者（エスペラント）であり、マルスとウラヌスを単身撃破したことで大虐殺を収束へと導いた。その功績により、当時大佐階級であった彼は軍の頂点まで一気に登りつめることに。"},{"spoiler":false,"text":"元来、大した血筋を持っておらず、生得的な才能それ自体は劣等。しかし驚異的な精神力、常軌を逸する鍛錬で会得した戦闘力は、如何なる者を凌駕した域へと達して他の追随を許さない。"},{"spoiler":false,"text":"帝国の黄金時代を支えるべく、公明正大、滅私奉公を信条としながら彼は今日も誰かのために戦い続ける。壊れるまで、砕け散るまで、それが“勝者”の責務ゆえ。"},{"spoiler":false,"text":"現在、スラムという最底辺層出身ながら総統の椅子へと座った、帝国史上唯一の人物。"}],"source":"egs","sourceCharacterId":"5597","sourceWorkId":"21143","spoiler":false},{"segments":[{"spoiler":false,"text":"軍事帝国アドラー 第三十七代総統。 生ける伝説。"},{"spoiler":false,"text":"彼を現すは一言、“英雄”。 帝国最強にして始まりの星辰奏者 （エスペラント） であり、マルスとウラヌスを単身撃破したことで大虐殺を収束へと導いた。"},{"spoiler":false,"text":"その功績により、当時大佐階級であった彼は軍の頂点まで一気に登りつめることに。"},{"spoiler":false,"text":"スラムという最底辺層出身ながら総統の椅子へと座った、帝国史上唯一の人物。"},{"spoiler":false,"text":"元来、大した血筋を持っておらず、生得的な才能それ自体は劣等。"},{"spoiler":false,"text":"しかし驚異的な精神力、常軌を逸する鍛錬で会得した戦闘力は、如何なる者をも凌駕した域へと達して他の追随を許さない。"},{"spoiler":false,"text":"帝国の黄金時代を支えるべく、公明正大・滅私奉公を信条とし、今日も誰かのために戦い続ける。"},{"spoiler":false,"text":"壊れるまで、砕け散るまで、それが “勝者” の責務ゆえ。"},{"spoiler":false,"text":"「“勝つ” のは俺だ」"}],"source":"bangumi","sourceCharacterId":"29927"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39ddd3a27c7af8a1690c5ae65c9a065f9c9e98d6908471141ee6fafe352df03b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fdd5782a24082eb6a8749c52070c9365e034325f2d6cab566bb5734236186d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠藤大智","creatorId":"vndb:s4505","sourcePersonId":"vndb:s4505","canonicalEntityId":"vndb:s4505","name":"Mr.デリンジャー(ミスター・デリンジャー)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:117677:29927:5057:1","source":"bangumi"}]},{"characterId":"char_c43366","characterName":"カーネイジ","sourceIds":{"bangumi":[{"characterId":"29928","match":"exact-normalized-name-in-linked-work","subjectId":"117677"}],"egsCharacterIds":["5598"],"vndbCharacterId":"c43366"},"originalCharacterName":"カーネイジ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious first-generation Masei, who, together with Uranus, caused the Central's Slaughter. His physical prowess and all-consuming miasmas make him a very dangerous opponent. Despite it, Mars was defeated by Valzelide. Currently, he is considered dead ever since."},{"spoiler":true,"text":"Originally, \"Carnage\" was a young man called Daniel von Valentine, born in the old aristocratic Valentine family, with a defect that made him have strong impulses for killing."},{"spoiler":true,"text":"Despite popular belief, Mars did not die after his defeat by Valzelide but was instead taken to the secret Astral research facility in the depths of Central, where he was once \"reborn.\""}],"source":"vndb","sourceCharacterId":"c43366"},{"segments":[{"spoiler":false,"text":"鬼面を纏った正体不明の怪物。ウラヌスと共に大虐殺を生んだ張本人にして、星辰奏者（エスペラント）をも上回る鋼鉄のアストラル運用兵器。"},{"spoiler":false,"text":"その外見は特徴的で、千年前に滅んだ日本の昔話にある“鬼”を連想させる姿をしている。独特の意匠からカンタベリー聖教国で製造されたと推測されているものの、真相は未だはっきりしていない。"},{"spoiler":false,"text":"かつて絶大な暴力により帝都の一角を地獄へ変えた。"},{"spoiler":false,"text":"口調は姿に似合わず、基本的に冷静、かつ理知的。時に相手の事情を慮るなど高い教養が伺える──かと思えば一転して享楽的な振る舞いを演じるなど、真意を読み取るのが非常に困難。"},{"spoiler":false,"text":"五年前にヴァルゼライドの手で討ち取られたはずだが、しかし──"}],"source":"egs","sourceCharacterId":"5598","sourceWorkId":"21143","spoiler":false},{"segments":[{"spoiler":false,"text":"鬼面を纏った正体不明の怪物。"},{"spoiler":false,"text":"ウラヌスと共に大虐殺を生んだ張本人にして、星辰奏者 （エスペラント） をも上回る鋼鉄のアストラル運用兵器。"},{"spoiler":false,"text":"その外見は特徴的で、日本の昔話にある “鬼” を連想させる姿をしている。"},{"spoiler":false,"text":"独特の意匠から カンタベリー聖教国 で製造されたと推測されているものの、真相は未だハッキリしていない。"},{"spoiler":false,"text":"口調は姿に似合わず、基本的に冷静、かつ理知的。"},{"spoiler":false,"text":"時に相手の事情を慮るなど高い教養が伺える──かと思えば、一転して享楽的な振る舞いを演じるなど、真意を読み取るのが非常に困難。"},{"spoiler":false,"text":"5年前にヴァルゼライドの手で討ち取られたはずだが、しかし──"},{"spoiler":false,"text":"「見極めなければならんだろう。 あんたも、そしてオレたち自身をも」"}],"source":"bangumi","sourceCharacterId":"29928"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d1c8e485f65e284b675beea5b7adafa25302ce4a366e1287443fe42aac2f31f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd555af499296e6e1ddcafc042049f7ce3df5b338937a6e9b6fb931adff4f031.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白熊寛嗣","creatorId":"vndb:s503","sourcePersonId":"vndb:s503","canonicalEntityId":"vndb:s503","name":"白熊 寛嗣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:117677:29928:4607:1","source":"bangumi"}]},{"characterId":"char_c43367","cha