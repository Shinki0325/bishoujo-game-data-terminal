"source":"vndb"}]},"cast":[{"characterId":"char_c12907","characterName":"神楽 勇気","sourceIds":{"bangumi":[{"characterId":"159877","match":"exact-normalized-name-in-linked-work","subjectId":"59714"}],"egsCharacterIds":["124"],"vndbCharacterId":"c12907"},"originalCharacterName":"神楽 勇気","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"710"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お調子者で女好き、しかしその実まじめで熱い男。"},{"spoiler":false,"text":"約束を破るのが何よりも嫌で、一度交わした約束は絶対に果たそうとする。"},{"spoiler":false,"text":"クラスでは意外と人気が高く、自然と人が集まってくる。"},{"spoiler":false,"text":"母親が数年前に病没してから身寄りがなく、バイトを掛け持ちしながら一人で生活をしていた。"},{"spoiler":false,"text":"そんな折、勇気の父親が他界。 それにより次期総裁が不在となった鳳グループが、鳳の血が流れている男子がいないか調査し、勇気に行き着く。"},{"spoiler":false,"text":"貧乏暮らしの一人暮らしだったため、家事全般をこなす。"},{"spoiler":false,"text":"また、もったいないの精神の持ち主で、様々な生活の知恵を発揮する。"}],"source":"bangumi","sourceCharacterId":"159877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/274f9b9a688234462be16e0c3f1f77c59d739dc3e69bdd7e398c9d4d00ac3824.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e07aea17ee684a516bfa2ec72547c1528082c803409d6f262dff1368fe169ed.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c12908","characterName":"鳳 蒼衣","sourceIds":{"bangumi":[{"characterId":"21269","match":"exact-normalized-name-in-linked-work","subjectId":"59714"}],"egsCharacterIds":["123"],"vndbCharacterId":"c12908"},"originalCharacterName":"鳳 蒼衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"303"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【毒舌マスターな妹メイド】"},{"spoiler":false,"text":"勇気の妹で鳳家のお嬢様だがなぜかメイドの姿をしている。"},{"spoiler":false,"text":"口調は丁寧だが、あまり感情を出さずに何かとトゲや毒のある発言をする生粋のドS。"},{"spoiler":false,"text":"身だしなみは完璧。"},{"spoiler":false,"text":"人前に出る時は寝癖ひとつない。"},{"spoiler":false,"text":"きっと、むだ毛の処理も細部に至るまで完璧。"},{"spoiler":false,"text":"あまりの徹底ぶりに、どこか機会のような冷たい雰囲気を醸し出している。"},{"spoiler":false,"text":"「おはようございます、汚物様……おっと、わたくしとしたことが間違えてしまいました。"},{"spoiler":false,"text":"改めましておはようございます、お兄様。"},{"spoiler":false,"text":"お兄様のお顔を拝見したら、汚物という言葉がつい自然に口を吐いてしまいました。"},{"spoiler":false,"text":"ええ、まったく他意はないのです、ただそこにあったのは嘘をつけない純真さだけなのです。"},{"spoiler":false,"text":"ご理解頂けましたでしょうか？」"}],"source":"egs","sourceCharacterId":"123","sourceWorkId":"18072","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・勇気の妹。 鳳家の子女でありながら、なぜかメイドの姿をしている。"},{"spoiler":false,"text":"しかし、勇気をさらった時は思い切り黒服をこき使ったり専用ヘリを飛ばすなど、世界最強のお金持ちのお嬢様なのは間違いない。"},{"spoiler":false,"text":"一般人として育った勇気に学園や鳳家のことなどを教えてくれる。"},{"spoiler":false,"text":"だがとってもドSな性格で、丁寧な口調だがいちいちトゲと毒がある。"},{"spoiler":false,"text":"あまり感情を表に出さず淡々と罵声を浴びせ、誰に対しても物怖じせず ズケズケとものを言う。"},{"spoiler":false,"text":"生粋のドSで、基本デレることはない……？"},{"spoiler":false,"text":"「おはようございます、汚物様……おっと、わたくしとしたことが間違えてしまいました」"}],"source":"bangumi","sourceCharacterId":"21269"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"123","sourceWorkId":"18072","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"123","sourceWorkId":"18072","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"123","sourceWorkId":"18072","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"123","sourceWorkId":"18072","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bac9ccc886f9cbbbf5d250eed6eab1e0bafbc052329045a32d904f6a37af1b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a83f6f4ecc315d092d07e503938dc02e722f7133f75b4ef902bfec24b72a390.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:59714:21269:5900:1","source":"bangumi"}]},{"characterId":"char_c12909","characterName":"澄之院 桜花","sourceIds":{"bangumi":[{"characterId":"21270","match":"exact-normalized-name-in-linked-work","subjectId":"59714"}],"egsCharacterIds":["120"],"vndbCharacterId":"c12909"},"originalCharacterName":"澄之院 桜花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"430"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【没落名家のツンしゅんご令嬢】"},{"spoiler":false,"text":"勇気の嫁候補の1人。"},{"spoiler":false,"text":"真面目な努力家で、どんなことにも手を抜かない。"},{"spoiler":false,"text":"人付き合いが大の苦手で、ついトゲのある言葉をぶつけてしまい、あとで自己嫌悪に陥る事が多い。"},{"spoiler":false,"text":"性格は几帳面で真面目な努力家。どんな事にも手を抜かない女の子。"},{"spoiler":false,"text":"実家はかつては国内における守護者業界で五指に入るほどの名門。"},{"spoiler":false,"text":"しかし数年前の事故のあとに没落。現在は衰退の一途を辿っている。"},{"spoiler":false,"text":"そんな澄之院を盛り立てようと、桜花は今回の話に乗ったらしいのだが……。"},{"spoiler":false,"text":"「なんだ君か、いったいボクになんの用かな？"},{"spoiler":false,"text":"……あっ、いやちょうど今、予定が空いたところなんだ。"},{"spoiler":false,"text":"良かったら、ゆっくりしていかないか？」"}],"source":"egs","sourceCharacterId":"120","sourceWorkId":"18072","spoiler":false},{"segments":[{"spoiler":false,"text":"勇気の嫁候補の一人。"},{"spoiler":false,"text":"澄之院は守護者を操る家柄として かつては鳳家に次ぐ家柄だったが、桜花の両親の死後すっかり没落してしまっている。"},{"spoiler":false,"text":"家を守るためには勇気の嫁に……と考えてはいるようだが、どこかはっきりしない態度が多い。"},{"spoiler":false,"text":"非常に生真面目だが、人付き合いが極めて不得意。"},{"spoiler":false,"text":"心とは裏腹に突き放すようなトゲのある言葉を相手にぶつけてしまう。 そして後でひたすら自己嫌悪に陥る。"},{"spoiler":false,"text":"どんなことにも手を抜かず、コツコツ積み重ねていく努力型。"},{"spoiler":false,"text":"素直じゃないけど、自由人の勇気にはどことなく憧れを持っている様子。"},{"spoiler":false,"text":"「悪いが急用でないならまた今度に……あっ、いやちょうど今、予定が空いたところだから、それでは、よろしくお願いいたします……」"}],"source":"bangumi","sourceCharacterId":"21270"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"120","sourceWorkId":"18072","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"120","sourceWorkId":"18072","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"120","sourceWorkId":"18072","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"120","sourceWorkId":"18072","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/c