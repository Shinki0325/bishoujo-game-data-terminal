{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36410","model":{"presentationWorkId":"egs:36410","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_129303","characterName":"Dorothy","sourceIds":{"bangumi":[{"characterId":"129303","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"Dorothy","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"继承者部队的队长。"},{"spoiler":false,"text":"即使再号称【最强部队】的继承者部队中，她也拥有压倒性的武力。"},{"spoiler":false,"text":"虽然脸上总挂着天使般的笑容，但内心却深不见底。"}],"source":"bangumi","sourceCharacterId":"129303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c5821f74b5e1f6e69b6e7bdbe567e092197b0b4708a0e5abfc7697ce1863852.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/217bc6310a117b4de5997ee42bd519eb1e1c7fcc9403b16e53a1f396d78481a4.webp","width":143,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_129813","characterName":"Scarlet","sourceIds":{"bangumi":[{"characterId":"129813","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"Scarlet","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"沉醉于美酒与风雅，隶属于开拓者部队的流浪剑客。"},{"spoiler":false,"text":"所使用的剑是一种近战专用武器，但在实际战斗中毫无用处。"}],"source":"bangumi","sourceCharacterId":"129813"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64575603610294971274a6fe6707029e446b73587946cf7a3a27801a232fc8d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3d7ca06c708dc37a9fb2851ac876d9545e233007a739f2d714269a0cc27d20d.webp","width":233,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_152912","characterName":"Eve","sourceIds":{"bangumi":[{"characterId":"152912","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"Eve","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"伊芙来自人类避难的外星拓殖区，她在登陆地球的过程中遭遇灾难事件。第7空降小队启动了从孽奇拔手中夺回地球的行动，却在一场猛烈的突袭中全军覆没。"},{"spoiler":false,"text":"在生死关头，一位名叫艾德姆的拾荒者出手相救，并将伊芙带到地球的“仅存之城”希雍。"},{"spoiler":false,"text":"在艾德姆以及后来一位名叫百合的工程师的帮助下，伊芙立誓继续完成她的使命：彻底消灭孽奇拔。"},{"spoiler":false,"text":"被希雍幸存居民唤作“天使”的伊芙探索着这个险境丛生的世界，几乎每走一步都会揭开更多惊天秘密。随着秘密逐渐揭开，她意识到所面临的挑战不仅仅是与强敌交锋……她的价值观和迄今为止坚守的一切都将受到质疑。"}],"source":"bangumi","sourceCharacterId":"152912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5a005ef4350acc73bd6d9295854d6f77269e1d2f21b1ae24dc173f422218d6b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96f2f14910f2eccbcce58c4caa4193d38ee645476fbe907088b7fd0afb6303a4.webp","width":238,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬戸麻沙美","creatorId":"vndb:s1433","sourcePersonId":"vndb:s1433","canonicalEntityId":"vndb:s1433","name":"瀬戸 麻沙美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:283357:152912:5766:1","source":"bangumi"}]},{"characterId":"char_bangumi_152913","characterName":"艾德姆","sourceIds":{"bangumi":[{"characterId":"152913","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"艾德姆","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"艾德姆是在满目疮痍的地球上四处游荡的拾荒者，整天忙于收集各种资源，帮助希雍及残存的人类居民维持生计。"},{"spoiler":false,"text":"他独自在城市外围拾荒，除了偶尔与长老奥尔科联系外，很少与其他幸存者交流。奥尔科希望通过艾德姆找回超能电池，让希雍摆脱湮灭的命运。"},{"spoiler":false,"text":"在第7空降小队登陆地球失败后，艾德姆救下了伊芙。两人随后携手合作，运用各自的技能寻找超能电池、帮助希雍市民，并对抗孽奇拔。"}],"source":"bangumi","sourceCharacterId":"152913"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03e36c48ee4b7f42aeb20d26c7ef92b8246d409ec00870aedbe183dbdcfe8f47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dfe1afdbca89ec94b6305e244e2664fdb4ef6aada36254ee8e2865203fd9e2b.webp","width":256,"height":144,"source":"static-detail"},"actors":[{"creditedName":"川田紳司","creatorId":"vndb:s255","sourcePersonId":"vndb:s255","canonicalEntityId":"vndb:s255","name":"川田紳司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:283357:152913:4246:1","source":"bangumi"}]},{"characterId":"char_bangumi_152914","characterName":"Lily","sourceIds":{"bangumi":[{"characterId":"152914","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"Lily","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"百合是第5空降小队的一名工程师，在之前的一次远征中被派往地球，但在登陆过程中与所属小队失散。"},{"spoiler":false,"text":"她幸存了下来，一直低调潜伏，直到收到伊芙的信号。"},{"spoiler":false,"text":"作为忠诚且熟练的技术人员，百合积极帮助伊芙摧毁孽奇拔。在深入执行任务的过程中，她充分利用自己的才能帮助伊芙升级了设备。"}],"source":"bangumi","sourceCharacterId":"152914"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f453ebd6295e9c42ae761a1f56fb49278ceb1494871c7545c3aa2cdea05fef0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b49260f3f021cf5205d79fdb27f09c66c7b7651ea7a5c074aad2aa57ca1b71c.webp","width":256,"height":144,"source":"static-detail"},"actors":[{"creditedName":"松岡美里","creatorId":"vndb:s27022","sourcePersonId":"vndb:s27022","canonicalEntityId":"vndb:s27022","name":"松岡美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:283357:152914:35731:1","source":"bangumi"}]},{"characterId":"char_bangumi_159581","characterName":"球母","sourceIds":{"bangumi":[{"characterId":"159581","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"球母","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c7c541147a9691f965892250b41fc3f01850fa30cb5a14193b24d412b79b586.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f24a4d5151556c8fffb81b9b0370e905e5505b4e0220e3bd0c9be33424a2e9cf.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大熊和奏","creatorId":"vndb:s41969","sourcePersonId":"vndb:s41969","canonicalEntityId":"vndb:s41969","name":"大熊 和奏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:283357:159581:45762:2","source":"bangumi"}]},{"characterId":"char_bangumi_177491","characterName":"Raven","sourceIds":{"bangumi":[{"characterId":"177491","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"Raven","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e328e8a1e028381b21e4068acdc2b7ed26edad6236a68cac7b7a0052d7f401b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2823dc9a8d69608a4cf309b847193461c2d9465ffe06ded518b19b7375dc9e98.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"行成とあ","creatorId":"vndb:s2369","sourcePersonId":"vndb:s2369","canonicalEntityId":"vndb:s2369","name":"行成 とあ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:283357:177491:8808:1","source":"bangumi"}]},{"characterId":"char_bangumi_180752","characterName":"粉狗","sourceIds":{"bangumi":[{"characterId":"180752","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"粉狗","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Doro是源自游戏《胜利女神：NIKKE》的人气二创角色与迷因，其名字取自角色“多萝西（Dorothy）”，形象则是白色犬型身体配上多萝西的头部。这一形象最初由韩国画师绘制表情包流传开来，并被大量网友使用成为网络梗。Doro的最早原型可追溯至《SoulWorker》角色斯特拉被画成狗形象的同人图，逐步演化为今日模样。"},{"spoiler":false,"text":"它在NIKKE官方Discord表情中初步传播，后因创作者 Musan_Pro 的同人作品走红。这些作品中的Doro会穿衣服，并发出“DoroDoro”的叫声。它拥有与主线剧情中多萝西强烈反差的可爱形象，反差萌带动大量二创扩散，成为NIKKE玩家间的热门梗与文化符号，衍生出大量非官方创作与商品。在2024年愚人节活动中，官方首次使用该梗，让角色舒恩与谢芙蒂以Doro化形态出场，并为其制作了专属技能演出，标志着Doro首次进入官方内容体系。2025年愚人节前夕的官方视频中，更首次让Doro发出“喵～”的猫叫，引发“狗叫成猫”的热议。近期在中文互联网则搭配哦润吉（橙子）变成了苦情角色，成为了网友们对缺爱等心理的一座图腾。"}],"source":"bangumi","sourceCharacterId":"180752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b582bc258eabb7c4f7723268e1283110121a6b9aa5621b4a50bbaba19f92d8aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a0f063afbaf9f28018df7ede15fe3b1197134b5471950f138bef0a74c99d476.webp","width":252,"height":187,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_199557","characterName":"奥尔科","sourceIds":{"bangumi":[{"characterId":"199557","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"奥尔科","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d93be779494a0be9349204dcb1a3dbb19a6712c585f454f0ee484e1e6d46d4f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e007e039bd227f844466bf29ad4b338beeb680dea15ba5d54ecef9ac1caa3823.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"麦人","creatorId":"vndb:s2887","sourcePersonId":"vndb:s2887","canonicalEntityId":"vndb:s2887","name":"麦人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:283357:199557:4162:1","source":"bangumi"}]},{"characterId":"char_bangumi_207274","characterName":"TACHY","sourceIds":{"bangumi":[{"characterId":"207274","match":"source-roster","subjectId":"283357"}]},"originalCharacterName":"TACHY","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"迅驰是第7空降小队的勇敢队长，作为一名功勋卓著的士兵，她以出色的战术才能、战斗技能和生存本领享誉小队。"},{"spoiler":false,"text":"她是带领突击队前往地球与孽奇拔作战的最佳人选。"},{"spoiler":false,"text":"但在执行任务期间，情况急转直下。"},{"spoiler":false,"text":"她们还没来得及呼吸母星的空气，就遭到孽奇拔的奇袭，彼时的战况比噩梦还要恐怖。"}],"source":"bangumi","sourceCharacterId":"207274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41e5982944964e8ec6c433cd8f9cd494cb6005ead297119c0854604c679e75dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f4b8ec8c8b83f5c2eae34b40702b40c660162d9d4958585a49749c31d0f66d8.webp","width":158,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:728","sourceCompanyId":"egs:brand:728","canonicalEntityId":"egs:brand:728","name":"SIEJA(SCEI)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:36410:728","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
