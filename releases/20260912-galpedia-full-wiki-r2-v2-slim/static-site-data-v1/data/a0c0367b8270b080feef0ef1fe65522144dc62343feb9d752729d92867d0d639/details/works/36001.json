{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36001","model":{"presentationWorkId":"vndb:v49569","staff":{"artwork":[{"creditedName":"吉野恵子","creatorId":"vndb:s2157","sourcePersonId":"egs:creator:322","canonicalEntityId":"vndb:s2157","name":"吉野恵子","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:276265","source":"egs"}],"scenario":[{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"egs:creator:2171","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:276266","source":"egs"}],"music":[],"other":[{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"egs:creator:2171","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:276269","source":"egs"},{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"vndb:s2261","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:204599","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c135293","characterName":"村上 康治","sourceIds":{"vndbCharacterId":"c135293"},"originalCharacterName":"村上 康治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He had been changing schools for a long time, but started to get bullied when he entered a junior high school, and has been bullied ever since. His parents are divorced, so he lives with his mother. Feeling cornered and wanting to die, while looking for a way to die comfortably, somehow, he ends up on a website about demon summoning. He is able to summon it, but he gets a monster instead whom he later merges with in order to avoid dying due to an accident. And because of that, he now has the mean to take revenge on the person who bullies him."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c135293"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0633bbed5fee61ac808cb21abeeaee315c4a92fbf0511ccdcdec161919373ee5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/554a2de47965df939e55b0d1709597c232893eb76343888809d03de0d0cce27f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c135294","characterName":"魔物","sourceIds":{"vndbCharacterId":"c135294"},"originalCharacterName":"魔物","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"A monster from another world that looks like a slime with tentacles growing from it. As a monster, it belongs to the lowest tier and only has weak fighting skills, however, due to its special ability, it has overwhelming power against women. It ambushed the Hero near the entrance to the cave leading to the Demon Lord's castle, but it was easily defeated. Instead of dissolving in its world, it gets summoned to modern-day Japan and merges with it summoner. Manipulating 18 tentacles, mimicking its surroundings, a being that deceives women with it body fluids."},{"spoiler":false,"text":"Translated and edited from official website"}],"source":"vndb","sourceCharacterId":"c135294"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f073c50e1aad5d87d2b8feb49b393d8d6d41c7b9ba342f0dafdc20ec4517b25.webp","fallbackUrl":"h