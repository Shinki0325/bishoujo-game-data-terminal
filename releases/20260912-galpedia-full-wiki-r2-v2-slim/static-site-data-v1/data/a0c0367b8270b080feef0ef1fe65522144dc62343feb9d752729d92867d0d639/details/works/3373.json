867b9d9650d6b6d0acbe5e8407.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f34205a261e7981b18ad4c12d0035df91a7b967a3063ede539cd564ca910c6f1.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c51666","characterName":"スイートパッション","sourceIds":{"bangumi":[{"characterId":"96138","match":"exact-normalized-name-in-linked-work","subjectId":"200512"}],"egsCharacterIds":["986"],"vndbCharacterId":"c51666"},"originalCharacterName":"スイートパッション","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小生意気で気の強い、第四のスイートナイツ。"},{"spoiler":false,"text":"抜群の身体能力で経験の浅さをカバーしている。"},{"spoiler":false,"text":"だがその分、心には隙があるようだ。"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"「汚らわしい魔物なんかに好きにさせないんだから！」"},{"spoiler":false,"text":"スイートナイツの一人。"},{"spoiler":false,"text":"プライドが高く向う気の強い、小悪魔的雰囲気ながら、憧れていた先輩への想いを持ち続ける一途な面もある。"},{"spoiler":false,"text":"現在は高い身体能力を生かして諜報的な任務をこなしている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、スイートナイツの一人。 プライドが高く向う気の強い、小悪魔的雰囲気ながら、正義感に溢れる仲間想い。"},{"spoiler":false,"text":"高い身体能力を生かした格闘技術に長けており、スイートキッスとともに時々シータのもとを訪れて、シータに頼まれて戦闘面の訓練を行っている。"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツの一人、スイートパッション。本名は宮守麻由希。"},{"spoiler":false,"text":"高い身体能力を活かした接近戦を得意とし、先陣を切って仲間たちの続く道を作る。"},{"spoiler":false,"text":"勝気な性格をしているが、優しく正義感に溢れている。"},{"spoiler":false,"text":"ジムでトレーナーとして働いている。"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"スイートナイツ四番目の戦士。メッツァーが潜む学園の学生。"},{"spoiler":false,"text":"凛々子の一つ下で、香那葉と同級。"},{"spoiler":false,"text":"身体能力の高さや気の強さなど、戦士としての資質を全て備えている。"},{"spoiler":false,"text":"一人で戦うスイートリップを助けるため、"},{"spoiler":false,"text":"クイーングロリアが純粋な正義の心を持つ彼女に聖涙石の欠片を宿らせ、"},{"spoiler":false,"text":"魔法戦士に生まれ変わらせた。"},{"spoiler":false,"text":"プライドが高く、はっきりとものを言う。"},{"spoiler":false,"text":"自分のルックスやプロポーションに自信を持っていて、"},{"spoiler":false,"text":"男子の視線を浴び、ちやほやされることを当然と思っている小悪魔的美少女。"},{"spoiler":false,"text":"だが実は性的なことに関してはほとんど免疫が無い。"},{"spoiler":false,"text":"ただ一人戦い続けている凛々子を尊敬し、"},{"spoiler":false,"text":"戦えないでいる香那葉を蔑むような態度をとる。"}],"source":"bangumi","sourceCharacterId":"96138"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa27aef812e86430ee6638e91d8b73a5ed2b68f738d3655a81e4a8167e434e2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4ef9d876ac526c544240eef078ae735a2da2ecaf1b0e88ed31d2fe2305d6cd1.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222230:96138:4490:1","source":"bangumi"}]},{"characterId":"char_c53362","characterName":"メッツァー・ハインケル","sourceIds":{"bangumi":[{"characterId":"96152","match":"exact-normalized-name-in-linked-work","subjectId":"222233"},{"characterId":"96152","match":"exact-normalized-name-in-linked-work","subjectId":"222242"}],"egsCharacterIds":["988"],"vndbCharacterId":"c53362"},"originalCharacterName":"メッツァー・ハインケル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"男性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"今作のプレイヤーキャラクター。"},{"spoiler":false,"text":"変身ヒロインを快楽責めで篭絡する。"},{"spoiler":false,"text":"戦闘では後方より間接的に支援する。"}],"source":"egs","sourceCharacterId":"988","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"ロアの半分を掌中に、一気に女神近衛団の殲滅を謀るべく、ある計画を進行中。"},{"spoiler":false,"text":"その一環として地上に再臨した。"},{"spoiler":false,"text":"そこで出会ったレムティアシータを手に入れるべく、自ら戦闘・調教に出向く。"}],"source":"egs","sourceCharacterId":"988","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"世界の王となるべく、立ちはだかる魔法戦士たちを謀略と快楽を以て籠絡していく。"}],"source":"egs","sourceCharacterId":"988","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"ロアの半分を掌中にし、一気に女神近衛団の殲滅を謀るべく、とある計画を進行中。その一環として地上に再臨した。"},{"spoiler":false,"text":"そこで出会ったレムティアシータを手に入れるべく、自ら戦闘・調教に出向く。"}],"source":"bangumi","sourceCharacterId":"96152"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bba400d1b63b623c7a2d3f3bea19ea47b9ff0858c837282985eb66971b8707f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14021db58a4c745c4fe3ae711abef388390c33638e8c0949daa16e2d673402dc.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c135789","characterName":"エルウィン・ヨアヒム・トランシルヴェール","sourceIds":{"vndbCharacterId":"c135789"},"originalCharacterName":"エルウィン・ヨアヒム・トランシルヴェール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"sourc