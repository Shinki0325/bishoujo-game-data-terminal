profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c29173","characterName":"天城 静音","sourceIds":{"bangumi":[{"characterId":"43795","match":"exact-normalized-name-in-linked-work","subjectId":"54517"}],"egsCharacterIds":["257"],"vndbCharacterId":"c29173"},"originalCharacterName":"天城 静音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"3月5日"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真面目で、何に対しても真剣。ただし感情制御が今一つで、自分に嘘がつけない。"},{"spoiler":false,"text":"そのため、つきあいの長い友人達には、すぐにバレてしまう。言い換えるなら、分かりやすい子。"},{"spoiler":false,"text":"世話焼き気質のツッコミ担当。本人のノリはいいのだが、周囲の暴走を止めるため、今日も心を鬼にしてツッコミを入れる。"},{"spoiler":false,"text":"人に害をなす妖怪を調伏する『童子切の巫女』であり、名刀『童子切安綱』を管理している。"},{"spoiler":false,"text":"その気になれば、ありとあらゆる怪異を消滅させられる、まさしく妖怪の天敵。"},{"spoiler":false,"text":"時折、ストレスから周囲の迷惑顧みず安綱を振り回したりもしているらしいが、やめてあげて！"},{"spoiler":false,"text":"周囲の妖怪のＨＰはとっくにゼロよ!!"},{"spoiler":false,"text":"『和登』の幼なじみの一人であり、その和登とのとある約束のため、和登と共に舞台となる研究都市へと引っ越した。"},{"spoiler":false,"text":"二人にとって何よりも大切なその約束は、静音を彼女候補ランキングの一位へと引き上げている。"},{"spoiler":false,"text":"他のヒロイン達が彼女を出し抜くための最大の壁となるであろう。"},{"spoiler":false,"text":"なお、たゆんたゆんな膨らみは勝者の証。走ると揺れる。歩いても揺れる。"}],"source":"egs","sourceCharacterId":"257","sourceWorkId":"17969","spoiler":false},{"segments":[{"spoiler":false,"text":"まじめで、何に対しても真剣。 ただし感情制御がいま一つで、自分に嘘がつけない。"},{"spoiler":false,"text":"世話焼き気質のツッコミ担当。 和登の幼なじみの一人であり、その和登とのとある約束のため、彼と共に研究都市へと引っ越した。"},{"spoiler":false,"text":"ふたりにとって何よりも大切なその約束は、静音を彼女候補ランキング一位へと引き上げている。"},{"spoiler":false,"text":"人に害を成す妖怪を調伏する “童子切の巫女” であり、名刀・童子切安綱を管理している。"},{"spoiler":false,"text":"その気になれば、ありとあらゆる怪異を消滅させられる、まさしく妖怪の天敵。"},{"spoiler":false,"text":"「天城静音、この神社の巫女をやってるわ。ちなみに賽銭箱はあそこよ」"}],"source":"bangumi","sourceCharacterId":"43795"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"257","sourceWorkId":"17969","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"257","sourceWorkId":"17969","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"257","sourceWorkId":"17969","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"257","sourceWorkId":"17969","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"257","sourceWorkId":"17969","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79abfd3711bd8bf098209d7974940fd0fd72b952454162af658b5912bd7fa7cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb1d2f43a000f19722a6942f64abf7517ebcf38726871bc6a074ab5fd1d08532.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:54517:43795:4432:1","source":"bangumi"}]},{"characterId":"char_c29174","characterName":"聖 美琴","sourceIds":{"bangumi":[{"characterId":"43796","match":"exact-normalized-name-in-linked-work","subjectId":"54517"}],"egsCharacterIds":["259"],"vndbCharacterId":"c29174"},"originalCharacterName":"聖 美琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"8月18日"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クールで冷静、表情変化も口数も少なく、どこか近寄りにくい生徒会長……。"},{"spoiler":false,"text":"そんな仮面で隠した裏側には、起伏の激しい感情と、好奇心旺盛な子供っぽさが隠されている。"},{"spoiler":false,"text":"そんな情熱的な彼女を支えてあげれば、きっと好感度アップ間違いなし！"},{"spoiler":false,"text":"ただし、もれなくちょっぴり危険な雪女がオマケでついてくるので気をつけましょう。"},{"spoiler":false,"text":"和登達の先輩にして、学園の生徒会長。"},{"spoiler":false,"text":"その肩書きは伊達ではなく、知力と分析力は折り紙付き。学生や教員からの信頼も非常に厚い。"},{"spoiler":false,"text":"表面上のクールなイメージと小柄な体型、特に可愛らしい『ちっぱい』と相まって、相当数な女性ファンがついている。"},{"spoiler":false,"text":"……その大半が『ゆる』ではなく『ガチ』だったりするのは、果たしていいことなのか悪いことなのか……。"},{"spoiler":false,"text":"なお、その正体は日本有数の知名度を誇る妖狐であり、身体能力では鬼や天狗に劣るものの、妖力に関してはまさしくトップレベル。"}],"source":"egs","sourceCharacterId":"259","sourceWorkId":"17969","spoiler":false},{"segments":[{"spoiler":false,"text":"和登たちの先輩。 クールで冷静、表情変化も口数も少なく、どこか近寄りにくい生徒会長。"},{"spoiler":false,"text":"しかしそんな仮面の裏側には、起伏の激しい感情と、好奇心旺盛な子供っぽさが隠されている。"},{"spoiler":false,"text":"生徒会長の肩書きは伊達ではなく、知力と分析力は折り紙付き。 学生や教員からの信頼も非常に厚い。"},{"spoiler":false,"text":"表面上のクールなイメージと小柄な体型、特に可愛らしい “ちっぱい” と相まって、相当数な女性ファンが付いている。"},{"spoiler":false,"text":"なお、その正体は日本有数の知名度を誇る妖弧であり、身体能力では鬼や天狗に劣るものの、妖力に関してはまさしくトップレベル。"},{"spoiler":false,"text":"さすがに九尾とまではいかないが、その数は彼女の年齢からすれば異例の5本。 ふっさふさのもっふもふである。"},{"spoiler":false,"text":"「聖美琴だ。この学園の生徒会長をしている。以後よろしく頼む」"}],"source":"bangumi","sourceCharacterId":"43796"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"259","sourceWorkId":"17969","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","value