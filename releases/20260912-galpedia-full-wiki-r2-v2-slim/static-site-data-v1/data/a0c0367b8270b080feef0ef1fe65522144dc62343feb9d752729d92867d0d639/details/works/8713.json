ler":false,"text":"明るい性格で元気者。"},{"spoiler":false,"text":"一人暮らしをする主人公の部屋にやって来ては、料理を作ったり掃除をしたりと、かいがいしく世話を焼いてくれる。"}],"source":"bangumi","sourceCharacterId":"219086"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9ee09e23f5cfe979616a12754a4d3aa80bc71bd4b590d12ac6e363110bdff74d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a959a820c4010afddebc3b9d13caaa0ea60c7cc3f1db9feae2019daeb0e68f6.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮園 まりん","creatorId":"vndb:s15874","sourcePersonId":"vndb:s15874","canonicalEntityId":"vndb:s15874","name":"宮園 まりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46759","source":"vndb"}]},{"characterId":"char_c70898","characterName":"真樹 あずさ","sourceIds":{"bangumi":[{"characterId":"219093","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18291"],"vndbCharacterId":"c70898"},"originalCharacterName":"真樹 あずさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「？」"},{"spoiler":false,"text":"主人公の夢に現れる謎の少女。"},{"spoiler":false,"text":"舞台となる学園に通う学生ではあるが、主人公が受け持つクラスの教え子ではなく、ほとんど接点がない。"}],"source":"egs","sourceCharacterId":"18291","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"若菜の親友。"},{"spoiler":false,"text":"若菜よりも先にセミナーに通っていた彼女は、主人公に若菜を洗脳するための道具にされる。"},{"spoiler":false,"text":"主人公に洗脳された彼女は、主人公に絶対服従状態。"},{"spoiler":false,"text":"若菜のためだと思い込まされ、若菜の洗脳に協力させられる。"}],"source":"egs","sourceCharacterId":"18291","sourceWorkId":"10769","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が商店街で出会った、同じセリフを延々と繰り返す"},{"spoiler":false,"text":"正体不明の謎の少女。"},{"spoiler":false,"text":"性格は明るくて元気だが、気が強くて主人公のいうことを"},{"spoiler":false,"text":"聞かず、勝手な行動を取ることもある。"},{"spoiler":false,"text":"意思の疎通が出来ないため、はっきりとはわからないが、"},{"spoiler":false,"text":"記憶が混乱しているようで、自分が誰かもわからないらしい。"},{"spoiler":false,"text":"そのため、成り行きで主人公の部屋へ転がり込んでしまった。"},{"spoiler":false,"text":"性的快感を覚えると、何故かその間は普通に会話できるように"},{"spoiler":false,"text":"なるが、気持ちが良すぎてしまうと、今度は逆に喘いでしまって"},{"spoiler":false,"text":"会話できなくなってしまう。"}],"source":"egs","sourceCharacterId":"18291","sourceWorkId":"20578","spoiler":false},{"segments":[{"spoiler":false,"text":"隣のクラスの学生。"},{"spoiler":false,"text":"受け持ちの教師が急病になり、主人公が代わりに授業を行った。"},{"spoiler":false,"text":"ところがその翌日から、学園に登校しないようになり、引きこもるようになった。"}],"source":"bangumi","sourceCharacterId":"219093"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0e9cfa5715899ac80db43e2f7555526c8df515b70e21918a68c906ad4a5406d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/272b9ffdc1ac2e1dc5b7fd2d9d094e2032140043fbe298c232a9a74264f08593.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篁瑞帆","creatorId":"vndb:s3539","sourcePersonId":"vndb:s3539","canonicalEntityId":"vndb:s3539","name":"篁 瑞帆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217796:219093:25192:1","source":"bangumi"}]},{"characterId":"char_c70917","characterName":"香坂 由南","sourceIds":{"bangumi":[{"characterId":"219089","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18317"],"vndbCharacterId":"c70917"},"originalCharacterName":"香坂 由南","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「拉致監禁」"},{"spoiler":false,"text":"主人公が丸め込まれた自己啓発セミナーの講師。"},{"spoiler":false,"text":"乗り込んできた主人公をその豊満な肉体を使って誘惑し、籠絡する。"},{"spoiler":false,"text":"主人公を陥れたセミナー側の人間だが、彼女にも辛い過去が……。"}],"source":"egs","sourceCharacterId":"18317","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のカウンセリングの助手。"},{"spoiler":false,"text":"学生時代に複数の男たちにレイプされ、心に大きな傷を負っていたが、主人公の洗脳術によって立ち直り、主人公の忠実な助手として働くようになった。"},{"spoiler":false,"text":"しかし、最近になって、不穏な動きが目立つようになってきて……。"}],"source":"egs","sourceCharacterId":"18317","sourceWorkId":"10739","spoiler":false},{"segments":[{"spoiler":false,"text":"常に余裕のある微笑みを浮かべている、啓発セミナーの講師。"},{"spoiler":false,"text":"理知的な話し方をするが、優しいお姉さんといった感じで、冷たい感じは受けない。"},{"spoiler":false,"text":"ただし、彼女の本心は全く見えない。"}],"source":"bangumi","sourceCharacterId":"219089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08d35494475f9274cae436eb4cf9a942300108abda872b0e8501d8ae2a925671.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d9af00a0734bff55fa4ddcaae04a4d98316c516e80f5f109da0e39455ef86a6.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森山葵","creatorId":"vndb:s2926","sourcePersonId":"vndb:s2926","canonicalEntityId":"vndb:s2926","name":"森山 葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217796:219089:22079:1","source":"bangumi"}]},{"characterId":"char_c70918","characterName":"綾瀬 沙紀","sourceIds":{"bangumi":[{"characterId":"219092","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18318"],"vndbCharacterId":"c70918"},"originalCharacterName":"綾瀬 沙紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「メッキ」"},{"spoiler":false,"text":"舞台となる学園に通う女子学生。"},{"spoiler":false,"text":"全てにおいてソツなくこなす、天才肌の少女。"},{"spoiler":false,"text":"全力を出さなくとも、そこそこ成果が上がってしまい、努力してきた人間にさえも優ってしまうことから、気付けば、自分よりも能力のない人間を見下すような人間になってしまったいた。"},{"spoiler":false,"text":"そんな彼女の心の底では、本気になったときの限界を知ることへの恐怖が隠されている。"}],"source":"egs","sourceCharacterId":"18318","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"大抵のことは努力しないでも簡単に極められる器用さを持つ天才少女。"},{"spoiler":false,"text":"主人公のカウンセリングを受けた学友がおかしくなっていることから、その原因がカウンセリングにあると踏んで、主人公のセミナーに乗り込んでくる。"},{"spoiler":false,"text":"しかし、主人公の策略に嵌ってしまい、あえなく彼女自身も淫乱なカウンセリングの餌食に……。"}],"source":"egs","sourceCharacterId":"18318","sourceWorkId":"10739","spoiler":false},{"segments":[{"spoiler":false,"text":"少し力を入れるだけで、何事も人より上手くこなすことができる天才少女。"},{"spoiler":false,"text":"それ故に何事にも本気で取り組むことができず、無気力・無感動な人間になってしまった。"},{"spoiler":false,"text":"授業中なども真面目に聞いてはいないが、才能に一目置かれているため教師達は放置している。"}],"source":"bangumi","sourceCharacterId":"219092"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c63a0647d294bb2a0633fd9212abd9378874ead3a1420d146f936cd52b758e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/259c3891e52a444363536485f0aca5d6b34078454622c4396d128d3082a020ab.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篁瑞帆","creatorId":"vndb:s3539","sourcePersonId":"vndb:s3539","canonicalEntityId":"vndb:s3539","name":"篁 瑞帆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217796:219092:25192:1","source":"bangumi"}]},{"characterId":"char_c70945","characterName":"渡会 静香","sourceIds":{"bangumi":[{"characterId":"219087","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18288"],"vndbCharacterId":"c70945"},"originalCharacterName":"渡会 静香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「裏切り」"},{"spoiler":false,"text":"舞台となる学園に勤める女教師。主人公の同僚。"},{"spoiler":false,"text":"将来の夢は役者になることで、現在の教師の仕事は、あくまでも夢が叶うまでの繋ぎでしかない。"},{"spoiler":false,"text":"しかし、学生たちと接しているうちに情が移り、夢と教師としての仕事の板挟みにあって苦悩している。"}],"source":"egs","sourceCharacterId":"18288","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"学生思いの情熱的な女教師。"},{"spoiler":false,"text":"教師になる前に、女優を志した時期があり、そのとき主人公に恥ずかしい写真を撮られている。"},{"spoiler":false,"text":"その写真をネタに脅され、無理やりAVに出演させられる。"}],"source":"egs","sourceCharacterId":"18288","sourceWorkId":"10770","spoiler":false},{"segments":[{"spoiler":false,"text":"学生や教師の仕事が大好きで、前向きな姿勢を崩さない女性。"},{"spoiler":false,"text":"常に学生や学園のことを考えており、弱音を吐きそうになる主人公をいつも明るく励ましている。"},{"spoiler":false,"text":"流されそうになる主人公も、彼女がいるので頑張ろうと思いとどまっている。"},{"spoiler":false,"text":"昔は女優になるという夢を持っていた。"}],"source":"bangumi","sourceCharacterId":"219087"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/615a3a50a85ded536d93c59d4d3e6f7b6b21db7434e9082cf652ad8ce3ca59aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a4b24d9a60347f9871a59ae832fb8a0f90cf680f2ddae472c42060af0d193e6.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しまだかおり","creatorId":"vndb:s2665","sourcePersonId":"vndb:s2665","canonicalEntityId":"vndb:s2665","name":"しまだ かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217796:219087:18664:1","source":"bangumi"}]},{"characterId":"char_c70946","characterName":"御厨 聡美","sourceIds":{"bangumi":[{"characterId":"219091","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18289"],"vndbCharacterId":"c70946"},"originalCharacterName":"御厨 聡美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「姉の死」"},{"spoiler":false,"text":"舞台となる学園に通う女子学生。"},{"spoiler":false,"text":"彼女に代わってお使いに出た姉が事故に巻き込まれて亡くなったため、それが彼女の大きなトラウマになっている。"},{"spoiler":false,"text":"姉が自分の身代りになったと思い込み、それが彼女の心を苦しめている。"}],"source":"egs","sourceCharacterId":"18289","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"静香が教師として勤める学園の女学生。"},{"spoiler":false,"text":"姉が自分をかばって事故で亡くなったトラウマから自暴自棄になっている。"},{"spoiler":false,"text":"その心理を主人公に巧みに衝かれ、AVに出演させられる。"}],"source":"egs","sourceCharacterId":"18289","sourceWorkId":"10770","spoiler":false},{"segments":[{"spoiler":false,"text":"大人しくて物腰も柔らかく口調も丁寧な、学年一の優等生。"},{"spoiler":false,"text":"しかし、優秀であろうとかなりの無理をしており、今にも壊れそうな危うい雰囲気を纏っている。"},{"spoiler":false,"text":"時々、彼女しかいない場所で誰かと話し合う声などが聞こえたりしている。"}],"source":"bangumi","sourceCharacterId":"219091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df11ae9f433fd7927b8b8f436e9e5110b92e7dca63d634cf6ee83882f982e7d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4db60d5b50f0e141326b335685fc7a95e757ef74074022fe052b46a8323917b.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"mahilo","creatorId":"vndb:s1492","sourcePersonId":"vndb:s1492","canonicalEntityId":"vndb:s1492","name":"眞尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217796:219091:34633:1","source":"bangumi"}]},{"characterId":"char_c70988","characterName":"日凪 朋美","sourceIds":{"bangumi":[{"characterId":"219088","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18286"],"vndbCharacterId":"c70988"},"originalCharacterName":"日凪 朋美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「怪物」"},{"spoiler":false,"text":"舞台となる学園に通う女子学生。"},{"spoiler":false,"text":"生まれつき洞察力と観察力に優れ、無意識の他人の心を読んでしまう、一種の超能力を持つ少女。"},{"spoiler":false,"text":"その異常な能力によって、彼女は周囲から奇異な目で見られ、あまつされ両親からも気味悪がられてしまう。"},{"spoiler":false,"text":"彼女の両親は離婚しており、その能力が原因だと思っている。そのためか、自分が不要な人間だと思い込んでいる節があり、自殺願望が強い。"}],"source":"egs","sourceCharacterId":"18286","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"真理亜にイジメられている女の子。"},{"spoiler":false,"text":"仕草などから相手の考えていることがわかる読心術を持っているが、それが原因で親などから煙たがれ、他人との関わりを避けるようになった。"},{"spoiler":false,"text":"人の顔色をうかがい、オドオドした彼女の態度が、イジメッ子には堪らないのか、彼女はイジメの標的にされることが多い。"},{"spoiler":false,"text":"彼女の読心術を他人を救うために使いたい、と主人公に説かれ、セミナーに通い始めるが……。"}],"source":"egs","sourceCharacterId":"18286","sourceWorkId":"10771","spoiler":false},{"segments":[{"spoiler":false,"text":"内気で弱々しくクラスの中で虐められている少女。"},{"spoiler":false,"text":"虐められていても抵抗することはなく、全てを受け入れてしまっている。"},{"spoiler":false,"text":"誰にも頼らず、助けを求めることすらしない。"},{"spoiler":false,"text":"学園内でも彼女に対する虐めが問題視されている。"}],"source":"bangumi","sourceCharacterId":"219088"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8517600f0b20e62d96550a64146f803f143bba1a272073e1aafc6b02b753e532.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed93d8cf52cedc8c4043f8c06e348b7c4e33e1be10553381be04469e77ac3dce.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217796:219088:22331:1","source":"bangumi"}]},{"characterId":"char_c70989","characterName":"東堂 真里亜","sourceIds":{"bangumi":[{"characterId":"219090","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18287"],"vndbCharacterId":"c70989"},"originalCharacterName":"東堂 真里亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「虐め」"},{"spoiler":false,"text":"舞台となる学園に通う女子学生。"},{"spoiler":false,"text":"自殺をも考えたほどの酷い虐めに遭っていた過去を持つ少女。"},{"spoiler":false,"text":"現在は、逆に虐める立場になってはいるが、苛められている相手の気持ちが痛いほどわかるため、苛めながらも彼女自身も傷ついている。"}],"source":"egs","sourceCharacterId":"18287","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"朋美をイジメている不良娘。"},{"spoiler":false,"text":"過去にイジメに遭っていた、その反動からイジメる側に回ってしまった。"},{"spoiler":false,"text":"自分がイジメられていた過去を知る主人公の出現によって、また自分があの頃のようにイジメられるのではないか、と恐れている。"}],"source":"egs","sourceCharacterId":"18287","sourceWorkId":"10771","spoiler":false},{"segments":[{"spoiler":false,"text":"狡猾な不良学生。表だって問題行為を起こすわけではなく影で他人を操って問題を起こしている。"},{"spoiler":false,"text":"最も多く行っているのが虐め行為で、クラスでターゲットを見つけると、集団で虐め始める。"},{"spoiler":false,"text":"その時も自分だけが悪者にならないように、慎重に行動している。"}],"source":"bangumi","sourceCharacterId":"219090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2738fe3e1f3a42890f41c6e5e1624b6c64a1f8be12b70abbeaf41eb6c0f67e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c669e4b3f3bf2a49830b7919d06b7f07abe079f6129eed125c92c01fa078f2ea.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梨本悠里","creatorId":"vndb:s1650","sourcePersonId":"vndb:s1650","canonicalEntityId":"vndb:s1650","name":"梨本 悠里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217796:219090:11148:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p384","sourceCompanyId":"egs:brand:1869","canonicalEntityId":"vndb:p384","name":"HEAT-SOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8713:1869","source":"egs"},{"companyId":"vndb:p139","sourceCompanyId":"vndb:p139","canonicalEntityId":"vndb:p139","name":"電脳CLUB","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:173461:v10336","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:173462:v10336","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:24649:v10336","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"