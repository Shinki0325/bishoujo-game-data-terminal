relationId":"vndb:vn-staff:34813","source":"vndb"},{"creditedName":"山本 周防","creatorId":"vndb:s10248","sourcePersonId":"vndb:s10248","canonicalEntityId":"vndb:s10248","name":"山本 周防","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34816","source":"vndb"},{"creditedName":"横田 憲一郎","creatorId":"vndb:s31130","sourcePersonId":"vndb:s31130","canonicalEntityId":"vndb:s31130","name":"横田 憲一郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34817","source":"vndb"},{"creditedName":"高淤龍","creatorId":"vndb:s46711","sourcePersonId":"vndb:s46711","canonicalEntityId":"vndb:s46711","name":"高淤龍","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34818","source":"vndb"}]},"cast":[{"characterId":"char_c22148","characterName":"蓮城 未来","sourceIds":{"bangumi":[{"characterId":"91979","match":"exact-normalized-name-in-linked-work","subjectId":"271596"}],"egsCharacterIds":["15036"],"vndbCharacterId":"c22148"},"originalCharacterName":"蓮城 未来","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"39"},"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Biological mother of Renjou Nozomu."},{"spoiler":false,"text":"She is beautiful and has an outstanding figure, and she looks incredibly youthful even though she is almost 40 years old."},{"spoiler":false,"text":"She has a soft demeanor, she is calm and always has a smile on her face."},{"spoiler":false,"text":"Her husband died, and she has been raising her son, the protagonist, on her own. She also shows her understanding of the protagonist's research, and she herself participates in his experiments as a subject."},{"spoiler":false,"text":"Although she appears to be stable on the outside, she is actually very dependent, relying on her parents during her school days and on her husband after her parents died."},{"spoiler":false,"text":"She dotes on the main character, and whenever she sees him, she engages in excessive physical contact with him."},{"spoiler":false,"text":"(Translated from Erogamescape.)"}],"source":"vndb","sourceCharacterId":"c22148"},{"segments":[{"spoiler":false,"text":"主人公の母。39歳。"},{"spoiler":false,"text":"美人でスタイルも抜群、40近い年齢は信じられないほどの若々しさ。"},{"spoiler":false,"text":"物腰も柔らかく、穏やかでいつもニコニコと笑顔を絶やさない。"},{"spoiler":false,"text":"夫を亡くし、息子である主人公を女手一つで育ててきた。主人公の研究にも理解を示し、自らも被験者として実験に参加する。"},{"spoiler":false,"text":"表向きはしっかりしているように見えて、実は依存心が強く、学生時代は両親に、その両親を亡くしてからは夫に依存していた。"},{"spoiler":false,"text":"主人公を溺愛し、ことあるごとに過剰なほどスキンシップをしてくる。"}],"source":"egs","sourceCharacterId":"15036","sourceWorkId":"12726","spoiler":false},{"segments":[{"spoiler":false,"text":"夫を亡くし、女手一つで主人公を育ててきた。"},{"spoiler":false,"text":"柔らかな物腰でいつもニコニコしている。"},{"spoiler":false,"text":"息子だけでなく、周囲の人々に対して面倒見が良い。"},{"spoiler":false,"text":"主人公の研究にも理解を示している。"},{"spoiler":false,"text":"他者に対して極めて一般的な倫理観の持ち主であるが、一方で自身は早婚。"},{"spoiler":false,"text":"天然系いやしキャラだが、息子への過剰なスキンシップが玉に瑕。"}],"source":"bangumi","sourceCharacterId":"91979"}],"profileFacts":[{"label":"年龄（本版本）","value":"39 岁","valueContext":null,"source":"egs","sourceCharacterId":"15036","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"15036","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"15036","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"15036","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"15036","sourceWorkId":"12726","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48d4b2df7b6fde78f51c8b659af5b7bb2583cb449174cab62b2ddcf7d2e81e4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cc82d17d1884233b59cf2ba578548af32ef6bf4ad3af00fbcb24b68b5a30224.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271596:91979:4489:1","source":"bangumi"}]},{"characterId":"char_c22149","characterName":"添田 いずみ","sourceIds":{"bangumi":[{"characterId":"91980","match":"exact-normalized-name-in-linked-work","subjectId":"271596"}],"egsCharacterIds":["15037"],"vndbCharacterId":"c22149"},"originalCharacterName":"添田 いずみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"66"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a long-time friend of Renjou Nozomu and is like a ``neighborhood sister.'' She was actually Nozumu's first love."},{"spoiler":false,"text":"She was an athlete when she was a student, and even now she continues to do exercises such as jogging and fitness, and has a slim and toned body."},{"spoiler":false,"text":"She is cheerful and cheerful, seemingly always having fun, and often hugs Nozomu unexpectedly or engages in excessive physical contact."},{"spoiler":false,"text":"She likes wearing revealing clothes, which seems to be something she does in defiance of her cheating husband."},{"spoiler":false,"text":"(Translated from Erogamescape.)"}],"source":"vndb","sourceCharacterId":"c22149"},{"segments":[{"spoiler":false,"text":"蓮城家の近くに住む人妻。25歳。"},{"spoiler":false,"text":"主人公とも昔馴染みで「近所のお姉さん」的な存在。実は主人公の初恋の相手でもあった。"},{"spoiler":false,"text":"学生時代はアスリートだった彼女は、現在もジョギングやフィットネスなど運動を欠かさず、スラリと引き締まった肉体をしている。"},{"spoiler":false,"text":"明朗快活でノリがよく、一見享楽的に見え、不意に抱きついてきたり、過剰なスキンシップに及ぶこともしばしば。"},{"spoiler":false,"text":"露出度の高い服を好んで着ているが、これは浮気中の夫への当てつけらしい。"}],"source":"egs","sourceCharacterId":"15037","sourceWorkId":"12726","spoiler":false},{"segments":[{"spoiler":false,"text":"蓮城家の近くに住む一見享楽的な人妻、面白半分で実験に参加する。"},{"spoiler":false,"text":"非常に明るく軽いノリ。"},{"spoiler":false,"text":"冗談で抱きついたり過剰なスキンシップに及ぶことも。"},{"spoiler":false,"text":"今の夫とは、恋愛を経ての学生結婚だったが、互いに我が強い性格の為、今では夫婦仲は冷えている。"},{"spoiler":false,"text":"好んで露出度の高い服を着ている。"},{"spoiler":false,"text":"これは実は浮気している夫への当てつけ。"}],"source":"bangumi","sourceCharacterId":"91980"}],"profileFacts":[{"label":"年龄（本版本）","value":"25 岁","valueContext":null,"source":"egs","sourceCharacterId":"15037","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"15037","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"15037","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"15037","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"15037","sourceWorkId":"12726","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99f46fac623730805374bd02a59a3ad8368a6dee6d7246bf3927f84f4ff95751.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f0b997b6a0c34d2ce05393ac3cb9ebb880cab9338eecfd295ea138e2919182e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271596:91980:5890:1","source":"bangumi"}]},{"characterId":"char_c22150","characterName":"柴崎 鏡夏","sourceIds":{"bangumi":[{"characterId":"91978","match":"exact-normalized-name-in-linked-work","subjectId":"271596"}],"egsCharacterIds":["15035"],"vndbCharacterId":"c22150"},"originalCharacterName":"柴崎 鏡夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young wife who is the friend of the protagonist's mother and married into the Shibasaki family, a prominent figure in the town."},{"spoiler":false,"text":"She is a quiet and pure beauty with a soft smile."},{"spoiler":false,"text":"She and her current husband had an arranged marriage, but their relationship is harmonious."},{"spoiler":false,"text":"She has been a close friend of Mirai since their school days, and her first experience was her first night with her husband."},{"spoiler":false,"text":"Because her husband is sexually indifferent, she soon becomes sexless without having a child, and is blamed by her relatives who are expecting her child. She is frustrated and stressed because her husband, who is equally responsible for the situation, does not protect her from the blame of her relatives."},{"spoiler":false,"text":"(Translated from Erogamescape.)"}],"source":"vndb","sourceCharacterId":"c22150"},{"segments":[{"spoiler":false,"text":"主人公の母親・未来の友達で、町内の名士である柴崎家に嫁いだ若妻。"},{"spoiler":false,"text":"柔らかな微笑みをたたえる、大人しく清楚な美人。"},{"spoiler":false,"text":"今の夫とは見合い結婚だが、夫婦仲は円満。"},{"spoiler":false,"text":"学生時代はから奥手で、初体験も夫との初夜だった。"},{"spoiler":false,"text":"夫が性的に淡白なため、程なくして子のないままにセック○レスになってしまい、子供を期待する親族から責められることになる。その責任の一端でもある夫が親族の責めから庇ってくれないことに不満を感じ、ストレスになっている。"}],"source":"egs","sourceCharacterId":"15035","sourceWorkId":"12726","spoiler":false},{"segments":[{"spoiler":false,"text":"柔らかな笑みを湛えた大人しく清楚な美人であり、町内の名士柴崎家へ嫁している若妻。"},{"spoiler":false,"text":"普段からよく夫と連れ立って出かけるなどしており、夫婦仲は至って円満な様子。"},{"spoiler":false,"text":"ただ一人のとき、時折さびしげな表情を見せることがある。"},{"spoiler":false,"text":"現在の夫とは見合い婚。"},{"spoiler":false,"text":"特に好きでも嫌いでもなかったが、両親の強い薦めもあり入籍。"},{"spoiler":false,"text":"学生時代は奥手で初体験は新婚初夜。"},{"spoiler":false,"text":"この初夜以降、夫には相応の愛情を感じているものの、夫が性的に淡白なため、程なく子のないままSEXレス夫婦となっている。"}],"source":"bangumi","sourceCharacterId":"91978"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"15035","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"15035","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"15035","sourceWorkId":"12726","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"15035