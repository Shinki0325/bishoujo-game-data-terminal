alse,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58796"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bff2ecd097a6127201b92d696e382f6460406993d18190ca6325fc7d73979d6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/237e180c80f24a544993ed36b6eede3931909ee045e1e9d5c2dfb70bc0da5231.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキ カナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21092","source":"vndb"}]},{"characterId":"char_vndb_c58797","characterName":"樹 まゆ","sourceIds":{"vndbCharacterId":"c58797"},"originalCharacterName":"樹 まゆ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend in the same grade who lives next door to the main character's house."},{"spoiler":false,"text":"She has a bit of a boyish attitude and tone of voice that seems to make other male classmates shy away from her, on the other hand she is well-liked by younger girls and girls her own age."},{"spoiler":false,"text":"Her hobby is making picture books, and she has a girlish side to her. According to MIku, her lack of honesty is what makes her so cute. She does not like to be treated like a girl."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58797"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bb1469939180dc3c7a53b81dbf7a15062dda3db8b43d3e32d3254edcba63679.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/435f510d3afb06a5371f41aaf576a28ade441ab0945795e84cac119d292f5931.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海原 エレナ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21089","source":"vndb"}]},{"characterId":"char_vndb_c58798","characterName":"春日井 結","sourceIds":{"vndbCharacterId":"c58798"},"originalCharacterName":"春日井 結","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Mayu's junior in club activities and always follows Mayu around. Contrary to expectations, she is not after Mayu, rather there is a boy she is after."},{"spoiler":false,"text":"She always gets nervous and confused when she is in front of the main character, will she ever get a chance to talk to that boy? She is like a little sister to the main character, and this worries her."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58798"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/105c92f1306d4685ddcb3af52709734725208396bc9df6b853812fe7e6fd303e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40ddb9074ad4ec3f302c47211e27dea8ce3c1afa7747f883d83193c3ec2345c0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日向 裕羅","creatorId":"vndb:s562","sourcePersonId":"vndb:s562","canonicalEntityId":"vndb:s562","name":"日向 裕羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21090","source":"vndb"}]},{"characterId":"char_vndb_c58799","characterName":"桐風 朋絵","sourceIds":{"vndbCharacterId":"c58799"},"originalCharacterName":"桐風 朋絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl in the same class as the main character. She is the type of girl who doesn't talk much and is always perceived as demure, according to Miku."},{"spoiler":false,"text":"She acts suspiciously when the main character talks to her. She seems to be the type of person who can be very passionate towards something, and when you think about it, she can get a little out of control."},{"spoiler":false,"text":"The question is. what's she is into now?"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58799"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f340e6bb7a441de0a184a280bcbeebac79eba9f90c42e4190bea295c05738d5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13a94d5a497984cd9c18b4931a7191d192ca7f563d667c8893a300eded45afc2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩田 由貴","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21093","source":"vndb"}]},{"characterId":"char_vndb_c58800","characterName":"佐伯 亜里砂","sourceIds":{"vndbCharacterId":"c58800"},"originalCharacterName":"佐伯 亜里砂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a senior at the school and is loved by all the students because of her energetic, cheerful, and caring personality,"},{"spoiler":false,"text":"She has known the main character and Miku since they served on the school festival committee. It's winter and she is about to graduate, but she still hasn't decided what to do."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58800"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54096cb339a29b33e28cf1f5fd83b1f6a00a6ae406dca5300875833edcc0da43.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e094f63110d5fff4a8b7ba281ded72d14bbbfde9deb9556cc8493d33ad03fbe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"AYA","creatorId":"vndb:s662","sourcePersonId":"vndb:s662","canonicalEntityId":"vndb:s662","name":"茂呂田 かおる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21091","source":"vndb"}]},{"characterId":"char_vndb_c58801","characterName":"チョコ","sourceIds":{"vndbCharacterId":"c58801"},"originalCharacterName":"チョコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A tiny fairy suddenly appeared in the main character's room. She is a self-proclaimed “love cupid” who has come to make the main character's love come true."},{"spoiler":false,"text":"It seems that by making the protagonist's love come true, she can become a human being. Though she may be annoying, she can be a good partner for him."},{"spoiler":false,"text":"Whatever the case may be, to simply put it, she's just a mysterious fairy."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c58801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93ce8710b9a0812f1781b33ad48e0b94a3efaaa77254bc9f6ba3e9785961c9e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fded5fca18d9f429b1c6ef938cf0142c91042f5dd9355c0e436235d9e5bef4ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 みなみ","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21094","source":"vndb"}]},{"characterId":"char_vndb_c89281","characterName":"冬條 陽平","sourceIds":{"vndbCharacterId":"c89281"},"originalCharacterName":"冬條 陽平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character of this work. His trademark is his affable smile and words that can be seen as somewhat timid. He knows it himself, but he also feels that there is no way to cure it."},{"spoiler":false,"text":"Since childhood, he has been friends with his step sister and childhood friends... Perhaps it is because he grew up surrounded by girls that he is not good at boyish behavior!"},{"spoiler":false,"text":"Whether the day will ever come when he can overcome this is also a mystery. (According to his sister)."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c89281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4719c6c0aa4eea5a08278de9c96507c94a60f281d5cedea22534ce88642cfe67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ebbb8fe8a5b7a8