kUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02387bb2911268c9587e3560725b56b195649e1989c2157750ee6e1a1ffe1f0e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西 明日香","creatorId":"vndb:s11043","sourcePersonId":"vndb:s11043","canonicalEntityId":"vndb:s11043","name":"西明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95062","source":"vndb"}]},{"characterId":"char_vndb_c126298","characterName":"天草 響","sourceIds":{"vndbCharacterId":"c126298"},"originalCharacterName":"天草 響","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The youngest of the Amakusa sisters."},{"spoiler":false,"text":"Currently a student at the local community college, Hibiki looked up to Akito like a real brother when they were kids."},{"spoiler":false,"text":"Though she can be sloppy and immature, Hibiki is also shrewd and calculating, often weighing the benefits of the choices presented to her. She is most proactive and energized when things she cares about are involved."},{"spoiler":false,"text":"She is a streamer (to a small audience) with dreams of moving to Tokyo for a big city life though she's unable to broach that topic with her eldest sister Kanami."},{"spoiler":false,"text":"Taken from Official English website"}],"source":"vndb","sourceCharacterId":"c126298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcfef80512c48e790cedc2fa69aab536e7bb0779d3780b27549b6800c81ae69c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7421aeea94d583ac2edab2b67b1cb6fd87294ced5c9332a41eaa19edff2ec0b0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大森 日雅","creatorId":"vndb:s20230","sourcePersonId":"vndb:s20230","canonicalEntityId":"vndb:s20230","name":"大森 日雅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95064","source":"vndb"}]},{"characterId":"char_vndb_c126299","characterName":"天草 亜舞音","sourceIds":{"vndbCharacterId":"c126299"},"originalCharacterName":"天草 亜舞音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The middle child of the Amakusa family."},{"spoiler":false,"text":"A nurse working at the town clinic, she is the same age as the protagonist, Akito."},{"spoiler":false,"text":"Amane and Akito got along and often played together when they were children, but she seems repulsed by him since their reunion."},{"spoiler":false,"text":"Though recognized for her capability at karate, she doesn't have time to dedicate to it since entering the workforce. She now redirects her need to exercise toward running in the mountains nearby. While she has a penchant for sports, she's not great at fishing despite her persistent efforts."},{"spoiler":false,"text":"Taken from Official English website"}],"source":"vndb","sourceCharacterId":"c126299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bf3b853a35adf79903b15e758ccf3a64ae6a2cee71da6fbe323ae1f8126043c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8e8f609edc87bbfd72f0490bb49043f918fdbb9ecd8088f9c30a8f4d805e0a1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪 彩花","creatorId":"vndb:s13437","sourcePersonId":"vndb:s13437","canonicalEntityId":"vndb:s13437","name":"諏訪彩花","roleCode":"voice-actor","roleLabel":"声优","