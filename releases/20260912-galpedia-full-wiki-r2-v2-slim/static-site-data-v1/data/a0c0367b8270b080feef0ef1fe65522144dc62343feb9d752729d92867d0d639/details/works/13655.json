ler":false,"text":"一直都过着快乐自在的生活，然而因为カタリナ的出现使这一切都起了变化。"},{"spoiler":false,"text":"性格春者率直，乐观又好奇心旺盛。"}],"source":"bangumi","sourceCharacterId":"12665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c450a9eae308bc3694d1df72d0a65a050f70cb6f13be0f4a2617484251c2afe2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7cb33288143ca66c2b9b70fa900bd208e57016c09ebf99a604a48b30351ca5a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14464:12665:5936:1","source":"bangumi"}]},{"characterId":"char_c15038","characterName":"エーデルワイス","sourceIds":{"bangumi":[{"characterId":"12666","match":"exact-normalized-name-in-linked-work","subjectId":"14464"}],"egsCharacterIds":["12579"],"vndbCharacterId":"c15038"},"originalCharacterName":"エーデルワイス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ノルドーレンの姫の一人、七姫（ななつひめ）。"},{"spoiler":false,"text":"グトルフォス大陸の北部にあるファムスールを統治している。"},{"spoiler":false,"text":"専従騎士であるカタリナとは幼馴染み。"},{"spoiler":false,"text":"「リナ、いつも守ってくれてありがとうございます」"}],"source":"egs","sourceCharacterId":"12579","sourceWorkId":"13655","spoiler":false},{"segments":[{"spoiler":false,"text":"ノルドーレンの公主之一，七姫。"},{"spoiler":false,"text":"统治着グトルフォス大陆的一个城镇ファムスール。"},{"spoiler":false,"text":"以自己的性格制定政策，在人民当中的人气很高。"},{"spoiler":false,"text":"性格和善而温柔，充满慈悲之心。"},{"spoiler":false,"text":"和专属骑士的カタリナ是青梅竹马的关系。"}],"source":"bangumi","sourceCharacterId":"12666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f5a0d2867478b15b6293d3f7d2bf1105926431b5f51e146855fcc28317ea2b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dde1bfda383eb3dfbdeda3eed76ca0e65d7eb0c5613bd349500f100647401e2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14464:12666:5936:1","source":"bangumi"}]},{"characterId":"char_c15039","characterName":"カタリナ","sourceIds":{"bangumi":[{"characterId":"12667","match":"exact-normalized-name-in-linked-work","subjectId":"14464"}],"egsCharacterIds":["12580"],"vndbCharacterId":"c15039"},"originalCharacterName":"カタリナ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"七姫専従騎士を任じられた女騎士。"},{"spoiler":false,"text":"女っ気がなく、腕っ節も男顔負け。"},{"spoiler":false,"text":"旅の途中、何者かによって襲われ、エーデルワイスと共に逃げるが……。"},{"spoiler":false,"text":"「それ以上、エーデルを愚弄するならば斬る！」"}],"source":"egs","sourceCharacterId":"12580","sourceWorkId":"13655","spoiler":false},{"segments":[{"spoiler":false,"text":"和七姫・エーデルワイスと是多年的青梅竹马。"},{"spoiler":false,"text":"以前两人的关系就像亲姐妹一样，但是エーデル成为了王女之后她也就顺理成章地当了エーデル的专属骑士。"},{"spoiler":false,"text":"巾帼不让须眉，好打不平。"},{"spoiler":false,"text":"令人意外的是做事很规矩，也有不懂临机应变的地方。"}],"source":"bangumi","sourceCharacterId":"12667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/413034eb119fe5ef351e1696566b8726aa2feeef18dad5f95fa72eb12d434775.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/965f91341316b1af5db3182