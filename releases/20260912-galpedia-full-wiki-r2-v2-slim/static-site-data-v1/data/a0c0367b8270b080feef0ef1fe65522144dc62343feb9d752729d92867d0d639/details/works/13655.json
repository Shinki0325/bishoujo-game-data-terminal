le":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二姫シグリット付きのメイド。"},{"spoiler":false,"text":"看護の知識があり、屋敷に住み込んで、シグリットの面倒をみている。"},{"spoiler":false,"text":"融通が利かない部分があり、その点に関してはシグリットも困っている。"},{"spoiler":false,"text":"「わたくしの命はシグリット様のものでございます」"}],"source":"egs","sourceCharacterId":"12584","sourceWorkId":"13655","spoiler":false},{"segments":[{"spoiler":false,"text":"受二姫所雇的住家女仆。"},{"spoiler":false,"text":"作为女仆的工作没话说，连看护方面也颇有心得。"},{"spoiler":false,"text":"完美主义者，做事有条理，喜欢整洁。"},{"spoiler":false,"text":"对二姫绝对服从，为了照顾躺卧病床的二姫可以付出一切。"}],"source":"bangumi","sourceCharacterId":"12671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b5afffebb5acbcdeb75ec223d602fc19bc2629e102fd4f7159980fc56219ec6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5810f4924ba7a5a5b17325e569ce1e64fa92f0258481613a5d557982b0359e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14464:12671:4799:1","source":"bangumi"}]},{"characterId":"char_c15046","characterName":"ロゼフィーヌ","sourceIds":{"bangumi":[{"characterId":"12672","match":"exact-normalized-name-in-linked-work","subjectId":"14464"}],"egsCharacterIds":["12585"],"vndbCharacterId":"c15046"},"originalCharacterName":"ロゼフィーヌ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ノルドーレンの姫の一人、一姫（ひとつひめ）。"},{"spoiler":false,"text":"グトルフォス大陸の南部にあるルイヴィークを統治する。"},{"spoiler":false,"text":"何事に対しても常に冷ややかな態度をとる隙のない女性。"},{"spoiler":false,"text":"「まだ仕事が残っているから、お先に失礼するわ――」"}],"source":"egs","sourceCharacterId":"12585","sourceWorkId":"13655","spoiler":false},{"segments":[{"spoiler":false,"text":"ノルドーレン的公主之一，一姫。"},{"spoiler":false,"text":"统治着グトルフォス大陆南部的都市ルイヴィーク。"},{"spoiler":false,"text":"聖ノルドーレン国实质上的No.1，同时也是二姫・シグリット义姐。"},{"spoiler":false,"text":"对待任何事情都很冷漠的无瑕女性。"},{"spoiler":false,"text":"对エノール的身份持怀疑的态度。"}],"source":"bangumi","sourceCharacterId":"12672"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cac93b2debdc541cafd79e3f31da5cd9b90f5800e6f59410f670b32ee04eaa1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54f7222a2648d0130fa182c21b2c8c60266abbdbb2816c708b44ed94fd18f8c5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14464:12672:5052:1","source":"bangumi"}]},{"characterId":"char_c15048","characterName":"リフィンベル","sourceIds":{"bangumi":[{"characterId":"12673","match":"exact-normalized-name-in-linked-work","subjectId":"14464"}],"egsCharacterIds":["12586"],"vndbCharacterId":"c15048"},"originalCharacterName":"リフィンベル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The princess of Wolfin."},{"spoiler":false,"text":"Clad in a gothic lolita dress, she's always seen with her favorite doll."},{"spoiler":false,"text":"Though she speaks of herself in 3rd person, she is not very childish and actually quite clever."},{"spoiler":false,"text":"She mocks others when talking with them, although only subtle, using their general unwillingness to deal with her to her favor."},{"spoiler":true,"text":"Though she mentions wanting to play with dolls, she actually likes to play with humans as dolls by controlling them as she likes it."},{"spoiler":true,"text":"She generally dislikes humans because half of them are male and thus not cute, though she makes exceptions in the case of Enoru whom she even blackmails into sex and her personal knight."},{"spoiler":true,"text":"This resulted in her having lots of female personal knights in the past, though her ways of controlling them (domination, bondage, sexual advances) broke them all."},{"spoiler":true,"text":"This made her settle for her current personal knight, who doesn't mind licking her feet and the countless insults coming from her."}],"source":"vndb","sourceCharacterId":"c15048"},{"segments":[{"spoiler":false,"text":"ノルドーレンの姫の一人、三姫（みつひめ）。"},{"spoiler":false,"text":"グトルフォス大陸の南西部にあるウルーフィンを統治する"},{"spoiler":false,"text":"何かと怪しい言動が多く、周囲を混乱させて楽しんでいる節も……。"},{"spoiler":false,"text":"「むふふ……なんだか、楽しそうね」"}],"source":"egs","sourceCharacterId":"12586","sourceWorkId":"13655","spoiler":false},{"segments":[{"spoiler":false,"text":"ノルドーレン的公主之一，三姫。"},{"spoiler":false,"text":"统治着グトルフォス大陆西南部的的城镇ウルーフィン。"},{"spoiler":false,"text":"政务在专属骑士的ペイトン的辅助下总算过得去，民众对这也感到惊奇。"},{"spoiler":false,"text":"腹黑又自我中心。"},{"spoiler":false,"text":"古灵精怪的行为也不少，有着让人陷入混乱而自己在一边暗爽的嗜好……"}],"source":"bangumi","sourceCharacterId":"12673"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f3ac013efd60731cd895a72e3cc30d6dcbb68d7468bfea4e95845e566c56cd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d647b1d157a5c34a65e6079222d8b937a97c606c8bb83fa1cc3e9263b73229c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14464:12673:6549:1","source":"bangumi"}]},{"characterId":"char_c15049","characterName":"ペイトン","sourceIds":{"bangumi":[],"egsCharacterIds":["12588"],"vndbCharacterId":"c15049"},"originalCharacterName":"ペイトン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無口で愛想はないが、実直に仕事をこなす。"},{"spoiler":false,"text":"リフィンベルに対して寄せられる苦情の数々に頭を痛めている。"},{"spoiler":false,"text":"「リフィ、いい加減にしろ。仕事をこれ以上増やすな」"}],"source":"egs","sourceCharacterId":"12588","sourceWorkId":"13655","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dd5af46b88b749e529a91bec7f54c11aa2828fd67f0baf2124339a998a2fdfc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2588f7ac76aa50284a63ad894b77a4f40171393bb5046bd01964abcb751bb2a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c15050","characterName":"リズ","sourceIds":{"bangumi":[{"characterId":"12674","match":"exact-normalized-name-in-linked-work","subjectId":"14464"}],"egsCharacterIds":["12587"],"vndbCharacterId":"c15050"},"originalCharacterName":"リズ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヤークレイルの人々の支持を受けて、台頭してきた”救世人”を名乗る少女。"},{"spoiler":false,"text":"手を重ね合わせることで、救われると人々に説いて回っているようだが……。"},{"spoiler":false,"text":"「手を重ね合わせ、それと共に心を通い合わせるのです」"}],"source":"egs","sourceCharacterId":"12587","sourceWorkId":"13655","spoiler":false},{"segments":[{"spoiler":false,"text":"在ヤークレイル的的人们支持下被称为 “救世人”的少女。"},{"spoiler":false,"text":"最初只不过是在路旁宣扬世界毁灭，随着事情的发展扩大，支持者也多起来。"},{"spoiler":false,"text":"向使人宣扬只要把手合在一起就能够得到救赎……"}],"source":"bangumi","sourceCharacterId":"12674"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/578c0e457ed3ab2cc13f222b009d1b1d5f8b63b45c516370dc76db6cbbc79429.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4814f6c0bcc17afee8a2d38dab99ef5e255b4babaa282abef8c5999cf42ece7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14464:12674:6509:1","source":"bangumi"}]},{"characterId":"char_vndb_c15041","characterName":"ロッド","sourceIds":{"vndbCharacterId":"c15041"},"originalCharacterName":"ロッド","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/6894b70ae508d58bf8fc739a93e94c893181843ba939df6aec472e85471bddc5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/941788b16e8e2f73d52ce20a00d43ac495a81d87fcc578ecba104d2108cbf05e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c15043","characterName":"シルバリィ","sourceIds":{"vndbCharacterId":"c15043"},"originalCharacterName":"シルバリィ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af4ddcd5f19d3e3590f6362dcd69d4024c27feec29500d4837ce35a8d1e0223b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3038f0fce9ae182a1a502e242d9aad9988e738fd87868dc729fb7c8dd9d1b292.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c15047","characterName":"クラウディス","sourceIds":{"vndbCharacterId":"c15047"},"originalCharacterName":"クラウディス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/938861af1c82300414836fe2ca0b504f3a4ba23d0c641ccc9f31e1dfba45264b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59c2854995598e6ff6ddb8aaa6cd5b4b715f45a91f010a1a870491d3ac9a304d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c15051","characterName":"キルゴア","sourceIds":{"vndbCharacterId":"c15051"},"originalCharacterName":"キルゴア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The witch of a story that is passed down in the family of Patricia."},{"spoiler":false,"text":"Even Patricia herself does not know if she is identical with the witch of the legend the main story line revolves around."},{"spoiler":false,"text":"She is actually located in a hidden room behind a wall in the storage of Ruiwig Castle where she slept for approximately 1000 years (or, as she corrects herself to go along with the narrative, was sealed in)."},{"spoiler":false,"text":"She was first discovered by Rosefin."},{"spoiler":false,"text":"In her talk with Katarina she refers to herself as \"former witch\" as she reveals that she has lost most of her powers;"},{"spoiler":false,"text":"however she is still able to read the heart/mind of Katarina and answers accordingly."},{"spoiler":false,"text":"If asked, she also reveals that she was not behind the attack on Katarina and Edelweiss, because she ensures that otherwise Katarina would no longer be alive."}],"source":"vndb","sourceCharacterId":"c15051"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e2492e52d7afb7aab33fd67a1b0e56dffd6feb281e45b196214a610d8cd988f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/074dfe506c2282f7667d51437ea9cc990f339b5ac52b91f6313c67225ae3b2b4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紫苑 みやび","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25056","source":"vndb"}]},{"characterId":"char_vndb_c56133","characterName":"ミンタカ","sourceIds":{"vndbCharacterId":"c56133"},"originalCharacterName":"ミンタカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebdc2979818dea77bd39784b0317d234909ced0b430c32129418d73dd91bbd2b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/1684ed20a898f8ba9ad2c66945020b12497b22d221