nflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/539a3861a9af50d6fbd23aead1e46f9b1f6acda1de1e6a2f72d607c95cdc10ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ee65fb2d608f8db58dacd98208c389b12a6f8cca9c4ae027deda7c381c5ec17.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上田真紗子","creatorId":"vndb:s6147","sourcePersonId":"vndb:s6147","canonicalEntityId":"vndb:s6147","name":"上田 真紗子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229709:59016:15252:1","source":"bangumi"}]},{"characterId":"char_c70215","characterName":"七飯 玖玲亜","sourceIds":{"bangumi":[{"characterId":"59017","match":"exact-normalized-name-in-linked-work","subjectId":"229709"}],"egsCharacterIds":["19974"],"vndbCharacterId":"c70215"},"originalCharacterName":"七飯 玖玲亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ地元出身の名士の娘。"},{"spoiler":false,"text":"主人公にとっては、高嶺の花で、憧れのお姉さん的な存在。"},{"spoiler":false,"text":"蝶よ花よと大事に育てられた箱入り娘で、幼稚園から大学まで有名私立で過ごし、見合い結婚で、若手の代議士とゴールイン。"},{"spoiler":false,"text":"茶道や華道、テーブルマナー、芸術鑑賞まで、セレブの嗜みを一通りこなす才女。"},{"spoiler":false,"text":"結婚し、内助の功として代議士である夫を支えている。"}],"source":"egs","sourceCharacterId":"19974","sourceWorkId":"9315","spoiler":false},{"segments":[{"spoiler":false,"text":"茶道華道からテーブルマナーや芸術鑑賞まで、セレブのたしなみは一通りこなす才女。"},{"spoiler":false,"text":"名士の家に長女として生まれ、幼稚園から大学までを有名私立校ですごした。内助の功の担い手として育てられ、今では代議士である夫を支えている。"},{"spoiler":false,"text":"人並みに現代的ではあるが、自分の人生になんの疑いも不安も持っていない。「良家の才女」。その額面どおりの女性。"},{"spoiler":false,"text":"夫は、若い三代目代議士。与党内にクリーンな風を送る議員として、マスコミからも注目されている。見合い結婚だが、夫とは温かな愛情で結ばれている。"}],"source":"bangumi","sourceCharacterId":"59017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ef056917841672ba31ac26a8183c9eb86ee6ecc94d5521468dc3184ac0a8c53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32a1c057bf6e5aad66d254104268129e0b03d3ff24f06e82b1ebf1bc518b6481.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新世 有希乃","creatorId":"vndb:s1723","sourcePersonId":"vndb:s1723","canonicalEntityId":"vndb:s1723","name":"新世 有希乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20092","source":"vndb"}]},{"characterId":"char_c70216","characterName":"米谷 つぐみ","sourceIds":{"bangumi":[{"characterId":"59018","match":"exact-normalized-name-in-linked-work","subjectId":"229709"}],"egsCharacterIds":["19975"],"vndbCharacterId":"c70216"},"originalCharacterName":"米谷 つぐみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が密かに想いを寄せていた幼馴染。"},{"spoiler":false,"text":"主人公の会社の得意先であるIT企業の青年と結婚し、幸せな家庭を築く。"},{"spoiler":false,"text":"明朗快活で、あどけなさを残すベビーフェイスと、それとは不相応の肉感的なボディを持つ彼女。"},{"spoiler":false,"text":"それゆえに周囲からちやほやされ、それが当然と思ってしまっている、やや“勘違い女”なところも。"}],"source":"egs","sourceCharacterId":"19975","sourceWorkId":"9315","spoiler":false},{"segments":[{"spoiler":false,"text":"明朗快活だが、いつまでもあどけなさの残るベビーフェイスの持ち主。"},{"spoiler":false,"text":"可愛い顔とは不相応に育ったボディのために、常に周囲からちやほやされてきた。そのため、自分が優遇されることを当然と思っており、自分の希望が適えられないときには、それは相手の狭量さや手際の悪さが原因であると決めつけてしまうところがある。"},{"spoiler":false,"text":"幸せで暖かい家庭が夢だと簡単に口にし、その反面、そういったものを目指さない人間は、社会の寄生虫ぐらいに思っている。"},{"spoiler":false,"text":"主人公とは幼馴染。当時ひそかに想いを寄せており、つぐみのために走りまわされることもしばしばだったが、 つぐみはその性格から、主人公の好意を当然と思っており、主人公の努力は水泡に帰した。"},{"spoiler":false,"text":"夫は、主人公の会社の得意先である急成長中のIT企業で、役員を務めている。度を過ぎていい人であるが、決して間抜けではない、さわやかな青年。つぐみとは、兄妹のような夫婦関係。"}],"s