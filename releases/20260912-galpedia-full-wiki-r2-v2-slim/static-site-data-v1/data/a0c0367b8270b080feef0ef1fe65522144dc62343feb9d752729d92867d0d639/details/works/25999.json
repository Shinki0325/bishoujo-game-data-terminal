viewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate. Towa is an honor student, who doesn't want to make friends with anyone. She's the only one, whose feelings the protagonist can't read because, as she said, \"there is a wall surrounding her heart\"."}],"source":"vndb","sourceCharacterId":"c24370"},{"segments":[{"spoiler":false,"text":"主人公（宮坂 終）の同級生。"},{"spoiler":false,"text":"物静かな性格だが、言いたいことを言うので学校では孤立しがち。"},{"spoiler":false,"text":"日頃から心を閉ざしており、誰とも親しくしようとしない。"},{"spoiler":false,"text":"成績もよく優等生だが、身体が弱いという設定で通しており、あまり授業には出ない。"},{"spoiler":false,"text":"終の “ 感情を読める能力 ” が通用しない相手。"}],"source":"egs","sourceCharacterId":"5590","sourceWorkId":"20817","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的同级生。"},{"spoiler":false,"text":"性格文静，却有话就说，在学园里茕茕孑立。"},{"spoiler":false,"text":"一直是成绩良好但体弱多病的优等生设定，基本上不怎么出席讲课。"},{"spoiler":false,"text":"素来紧锁心扉，不与任何人亲近。"},{"spoiler":false,"text":"是主人公“感情读取能力”不奏效的对手。"}],"source":"bangumi","sourceCharacterId":"27438"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/608cdba74cdd20d7f2d7943063a66b3eecbf2f9026573fbb1ac75b49053d87db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cffe8296395cd04629fc1f286495f19d65cf731513f5c26f74f0182836ee072d.webp","width":109,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228670:27438:13372:1","source":"bangumi"}]},{"characterId":"char_c50104","characterName":"七波 シロネ","sourceIds":{"bangumi":[{"characterId":"46956","match":"exact-normalized-name-in-linked-work","subjectId":"186677"}],"egsCharacterIds":["14030"],"vndbCharacterId":"c50104"},"originalCharacterName":"七波 シロネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"720"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"－kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new model of android developed by Sara called “TRINO,” who resembles Shun's little sister."},{"spoiler":false,"text":"Although she has a human-like exterior, her cognitive abilities are still developing, making it difficult for her to understand social cues. Despite this drawback, she exudes a unique charm that gives those around her a soothing presence, almost like a living mascot."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c50104"},{"segments":[{"spoiler":false,"text":"沙羅が作った新型アンドロイド（ “トリノ” ）で、舜の妹に似ている。"},{"spoiler":false,"text":"見た目は人と変わらないが、中身は学習途中なため、空気が読めない一面も。"},{"spoiler":false,"text":"その独特な愛嬌で、周りを和ませるマスコット的存在。"}],"source":"egs","sourceCharacterId":"14030","sourceWorkId":"23994","spoiler":false},{"segments":[{"spoiler":false,"text":"沙羅所制作的新型智能机器人（トリノ），很像舜的妹妹。"},{"spoiler":false,"text":"虽然外表和人类一模一样，但因为正在学习各种知识，还不会察言观色。"},{"spoiler":false,"text":"正因如此她所独有的可爱感觉让她成为了周围人中吉祥物一般的存在。"}],"source":"bangumi","sourceCharacterId":"46956"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc7d638f6f1e0c518ef0584ff182066928f0e1eddd3b9e782237fc3b2d1033ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1b2fc44cd8e20f881abf7cef6a8100c969b7242d2686ed6f105b34d4b6138f6.webp","width":107,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤田栞","creatorId":"vndb:s11592","sourcePersonId":"vndb:s11592","canonicalEntityId":"vndb:s11592","name":"澤田 栞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228670:46956:41372:1","source":"bangumi"}]},{"characterId":"char_c50105","characterName":"宮風 夕梨","sourceIds":{"bangumi":[{"characterId":"46957","match":"exact-normalized-name-in-linked-work","subjectId":"186677"}],"egsCharacterIds":["14031"],"vndbCharacterId":"c50105"},"originalCharacterName":"宮風 夕梨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"109"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shun's long-time friend, and the only daughter of a family whom runs a condominium. She suffers from an incurable disease, but that doesn't stop her from living her daily life."},{"spoiler":false,"text":"She likes to think of herself as a delinquent, but serves on the Disciplinary Committee since she isn’t the type who can turn down a request."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c50105"},{"segments":[{"spoiler":false,"text":"舜の幼なじみで、コンドミニアムを経営している家の一人娘。"},{"spoiler":false,"text":"不治の病を患っており、人生を半ば諦めている。"},{"spoiler":false,"text":"不良っぽくありたいと願うものの、頼まれると断れない性格で、風紀委員を務めている。"}],"source":"egs","sourceCharacterId":"14031","sourceWorkId":"23994","spoiler":false},{"segments":[{"spoiler":false,"text":"舜的青梅竹马，房产经营者的独生女。"},{"spoiler":false,"text":"患有不治之症，对人生绝望了一半。"},{"spoiler":false,"text":"虽然想走上不良之路，但却是个不会拒绝别人请求的风纪委员。"}],"source":"bangumi","sourceCharacterId":"46957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bde021c26babe236395d441f0e15cd376b38353857df141a3b4c94df91557fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f5964f175165886986e62e5537efd8b1f3ad82d8799d32192cc39a3c0a6fbce.webp","width":93,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ふじたまみ","creatorId":"vndb:s7951","sourcePersonId":"vndb:s7951","canonicalEntityId":"vndb:s7951","name":"ふじた まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228670:46957:23302:1","source":"bangumi"},{"creditedName":"八ッ橋 しなもん","creatorId":"vndb:s11591","sourcePersonId":"vndb:s11591","canonicalEntityId":"vndb:s11591","name":"八ッ橋しなもん(朔白)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74416","source":"vndb"}]},{"characterId":"char_c50106","characterName":"紬木 沙羅","sourceIds":{"bangumi":[{"characterId":"46958","match":"exact-normalized-name-in-linked-work","subjectId":"186677"}],"egsCharacterIds":["14032"],"vndbCharacterId":"c50106"},"originalCharacterName":"紬木 沙羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"314"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Another long-time friend of Shun's whom has possessed a genius intellect from a young age, and a scientist involved in android development."},{"spoiler":false,"text":"People tend to think of her as a cold-hearted person since she loves experimenting, but she is actually kind at heart. Although she is the same age as Shun, she is much more mentally mature and sometimes toys around with him."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c50106"},{"segments":[{"spoiler":false,"text":"幼いころから天才的な頭脳を持つ舜の幼なじみで、アンドロイド開発に携わる科学者。"},{"spoiler":false,"text":"実験好きで、冷酷な人間と思われがちだが、根は優しい。"},{"spoiler":false,"text":"舜とは同い年だが、精神年齢は高く、小悪魔的に弄ぶことも。"}],"source":"egs","sourceCharacterId":"14032","sourceWorkId":"23994","spoiler":false},{"segments":[{"spoiler":false,"text":"从幼时就拥有天才头脑的舜的青梅竹马，进行着智能机器人开发的科学家。"},{"spoiler":false,"text":"虽然会被认为是喜欢搞实验的冷酷科学家，但其实是个温柔的人。"},{"spoiler":false,"text":"和舜同龄但心理年龄很高，会像小恶魔般玩弄舜。"}],"source":"bangumi","sourceCharacterId":"46958"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee979ebba0fe33573ca174c1069b9dca8bec80a1395b25626611ba02f7f78c22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d111f6c0dec6be7a38d40357c41aec39bcd7a3a8452bacfa380731185dc0238.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId"