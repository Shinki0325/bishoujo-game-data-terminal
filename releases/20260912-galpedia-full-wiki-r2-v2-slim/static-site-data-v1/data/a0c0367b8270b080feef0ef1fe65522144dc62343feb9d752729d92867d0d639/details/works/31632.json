eviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦地を転々としつつ、生き別れた母を探している傭兵。幼いころ、とある事件をきっかけにシンと同調し、以来行動を共にしている。自身の生い立ちから、他者に対する思いやりのある、心優しい女性。"}],"source":"bangumi","sourceCharacterId":"66463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4f435d47ad15381c62353b952ed42b1a06d8a3e449576eabbd7c54ab3b86560.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/cef152e3858cbd6e1a0cea8530b0d73d3b4da117c43c9b9f82431844177d252c.webp","width":174,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早見沙織","creatorId":"vndb:s1871","sourcePersonId":"vndb:s1871","canonicalEntityId":"vndb:s1871","name":"早見 沙織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:250315:66463:4895:1","source":"bangumi"}]},{"characterId":"char_bangumi_66464","characterName":"アデル","sourceIds":{"bangumi":[{"characterId":"66464","match":"source-roster","subjectId":"250315"}]},"originalCharacterName":"アデル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イーラの王位継承権四位の王子であり、メツの脅威に対抗する「抵抗軍」のリーダー。王族らしからぬ気さくな性格で、人望も厚い。“天の聖杯”ヒカリとの同調に成功したことで、メツの討伐の王命を受ける。"}],"source":"bangumi","sourceCharacterId":"66464"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8db6b06b29d9586e6112a9fb9a70d8959bc92a36ed0dac23886a97fc1e879bf9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19c8b3350cb80ec0edb5713b2f66ca72e5ab5e651f6e65adb1558b7338418117.webp","width":145,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_66465","characterName":"ユーゴ","sourceIds":{"bangumi":[{"characterId":"66465","match":"source-roster","subjectId":"250315"}]},"originalCharacterName":"ユーゴ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"新興軍事国家スペルビアの若き皇帝。身を挺して民を守ることを王族の使命と捉え、自らブレイドを率いて戦場に立つ。アデルとは旧知の間柄で、境遇が似ていることにも親近感を抱いている。"}],"source":"bangumi","sourceCharacterId":"66465"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bc5601ed560083a16b522fa8514cc3e45597014a8c0977bb18189904c2f0ce6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27f41731bcb0af4ccbfac515e047ba3cb26f953ac9b347ab25d8108c6c1775c5.webp","width":95,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石田彰","creatorId":"vndb:s74","sourcePersonId":"vndb:s74","canonicalEntityId":"vndb:s74","name":"石田 彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:250315:66465:3927:1","source":"bangumi"}]},{"characterId":"char_bangumi_66466","characterName":"シン","sourceIds":{"bangumi":[{"characterId":"66466","match":"source-roster","subjectId":"205916"},{"characterId":"66466","match":"source-roster","subjectId":"250315"}]},"originalCharacterName":"シン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゼノブレイド2"},{"spoiler":false,"text":"イーラの首魁（しゅかい）。マスクを被っており、その素顔を知るものは少ない。何らかの目的のもと、「天の聖杯」ホムラを狙っている。性格は冷静だが、目的のためなら手段を選ばない、秘めた苛烈（かれつ）さを持つ。"},{"spoiler":false,"text":"ゼノブレイド2 黄金の国イーラ"},{"spoiler":false,"text":"“イーラの秘宝”と呼ばれる強力なブレイドだが、盗み出され、偶然にラウラと同調した。ドライバーであるラウラを守ることを何よりも優先する。剣技に長け、戦闘能力は高いが、無用な争いは好まない。属性は氷。"}],"source":"bangumi","sourceCharacterId":"66466"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28a3caa3684493f50736c6e05fa617b492ac0908f3e448353d47651f60576e45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2442e3b8c5f5ab02f72912f72242d86a0125c680224ce8fd32e409c25f29604c.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井孝宏","creatorId":"vndb:s50","sourcePersonId":"vndb:s50","canonicalEntityId":"vndb:s50","name":"櫻井 孝宏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:250315:66466:4015:1","source":"bangumi"}]},{"characterId":"char_bangumi_66467","characterName":"カスミ","sourceIds":{"bangumi":[{"characterId":"66467","match":"source-roster","subjectId":"205916"},{"characterId":"66467","match":"source-roster","subjectId":"250315"}]},"originalCharacterName":"カスミ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ラウラのブレイド。同調したドライバーの影響が容姿に強くあらわれており、外見はラウラとうりふたつ。戦闘では癒しと風の術を用いるほか、ブレイドの力を抑制する特別な能力も持つ。"}],"source":"bangumi","sourceCharacterId":"66467"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98248cf5909db9566a435e65027ac539370f74128cae06fd373c742340fc2b94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7846be675d37148c387c9c4811ac7bc2c19ee8fe9c7acfafe54a9be7f28b4973.webp","width":144,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早見沙織","creatorId":"vndb:s1871","sourcePersonId":"vndb:s1871","canonicalEntityId":"vndb:s1871","name":"早見 沙織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:250315:66467:4895:1","source":"bangumi"}]},{"characterId":"char_bangumi_66468","characterName":"ミノチ","sourceIds":{"bangumi":[{"characterId":"66468","match":"source-roster","subjectId":"250315"}]},"originalCharacterName":"ミノチ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヒトとブレイドの細胞を融合させた“マンイーター”。属性は闇。本来はアーケディアのマルベーニ助祭のブレイドだが、現在は離別。アデルのブレイドとしてメツ討伐の旅に加わる。"}],"source":"bangumi","sourceCharacterId":"66468"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29d42a52220ec4cf7b0d9335a85b3ac95c45a3f0fa5970bb83fdd8a4e56499d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/daba4b6339f03ac3a55e6452e1abd50dfda296e3a815f1417f979c2993fe62a9.webp","width":144,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三木眞一郎","creatorId":"vndb:s252","sourcePersonId":"vndb:s252","canonicalEntityId":"vndb:s252","name":"三木 眞一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:250315:66468:4101:1","source":"bangumi"}]},{"characterId":"char_bangumi_66469","characterName":"ワダツミ","sourceIds":{"bangumi":[{"characterId":"66469","match":"source-roster","subjectId":"205916"},{"characterId":"66469","match":"source-roster","subjectId":"250315"}]},"originalCharacterName":"ワダツミ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"カグツチと共にユーゴに仕える、水属性のブレイド。常に主君の側に控え、その身を案じている。物腰は穏