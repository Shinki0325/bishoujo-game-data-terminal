ource":"vndb","value":"731"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"bust":{"reviewState":"source-only","source":"vndb","value":"99"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"J"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"97"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「人妻戦隊」を冠するからにはメンバーは三人以上じゃないといけない、ということから美紅の考案で正義の味方を募集したところ、応募してきた外人さん。"},{"spoiler":false,"text":"警察官だった旦那が三年前に殉職し、現在は未亡人。"},{"spoiler":false,"text":"結婚前に星林修道院のシスター見習いをしていたことから、現在は特別に修道院で住み込みで働かせて貰っている。"},{"spoiler":false,"text":"「サイガーイン！」で「サイガーリリー」に変身し、聖なる風の力で邪悪を吹き飛ばす。"},{"spoiler":false,"text":"サイクロン掃除機を模した「サイ＝クリーナー」が専用武器。"}],"source":"egs","sourceCharacterId":"13186","sourceWorkId":"6253","spoiler":false},{"segments":[{"spoiler":false,"text":"警察官の夫を殉職で亡くした、未亡人シスター。"},{"spoiler":false,"text":"天然でぽわぽわした性格は相変わらず。"}],"source":"egs","sourceCharacterId":"13186","sourceWorkId":"8256","spoiler":false},{"segments":[{"spoiler":false,"text":"アイサイガーのムードメーカー、風の戦士“サイガーリリー”。"},{"spoiler":false,"text":"その正体は、修道院で働く見習いシスターをする未亡人。"},{"spoiler":false,"text":"しかし、もしも……梃魔の能力で、"},{"spoiler":false,"text":"夫の殉職が「なかった」ことになるのだとしたら……？"}],"source":"egs","sourceCharacterId":"13186","sourceWorkId":"10079","spoiler":false},{"segments":[{"spoiler":false,"text":"アイサイガーのムードメーカー、風の戦士“サイガーリリー”。"},{"spoiler":false,"text":"その正体は、修道院で働く見習いシスターをする未亡人。"}],"source":"egs","sourceCharacterId":"13186","sourceWorkId":"11476","spoiler":false},{"segments":[{"spoiler":false,"text":"人妻戦隊と言うからには、メンバーは3人いないといけない。というわけで、美紅が深く考えずに作った「正義の味方、ぼしゅー！」ポスターを見てやってきた、のほほんとした外人さん。"},{"spoiler":false,"text":"旦那は警察官だったが、3年前にとある事件で殉職した。"},{"spoiler":false,"text":"結婚前は星林修道院のシスター見習いだった。未亡人となった今ではシスターになることは叶わないが、特別に修道院に住み込みで働いている。"},{"spoiler":false,"text":"変身後は「サイガーアイリス」。"},{"spoiler":fal