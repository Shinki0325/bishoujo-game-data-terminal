d":"vndb:vn-staff:123782","source":"vndb"},{"creditedName":"米倉 千尋","creatorId":"vndb:s4417","sourcePersonId":"vndb:s4417","canonicalEntityId":"vndb:s4417","name":"米倉 千尋","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:123783","source":"vndb"}],"other":[{"creditedName":"米倉千尋","creatorId":"vndb:s4417","sourcePersonId":"egs:creator:18141","canonicalEntityId":"vndb:s4417","name":"米倉千尋","detail":"OP曲「零-ZERO-」、ED曲「シリウスの瞬く空に」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:289796","source":"egs"},{"creditedName":"めろ","creatorId":"vndb:s2182","sourcePersonId":"vndb:s2182","canonicalEntityId":"vndb:s2182","name":"めろ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:123780","source":"vndb"},{"creditedName":"米倉 千尋","creatorId":"vndb:s4417","sourcePersonId":"vndb:s4417","canonicalEntityId":"vndb:s4417","name":"米倉 千尋","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:123784","source":"vndb"},{"creditedName":"谷口 歌奈","creatorId":"vndb:s45860","sourcePersonId":"vndb:s45860","canonicalEntityId":"vndb:s45860","name":"谷口 歌奈","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:123789","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c42683","characterName":"零崎 紘可","sourceIds":{"vndbCharacterId":"c42683"},"originalCharacterName":"零崎 紘可","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"229"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"0: The number which should not exist."},{"spoiler":false,"text":"‘There’s no reason for me to participate in your fight.’"},{"spoiler":false,"text":"High school 2nd year student."},{"spoiler":false,"text":"A girl who transfers to Soyogi Academy in spring. She’s lethargic all the time, and will avoid troublesome things with all her might. She loves sleeping, and hates it when someone disturbs her naps. Though she’s been practicing Kendo since she was young, she did not choose to learn it at her own will, and skips club activities all the time."},{"spoiler":false,"text":"On the day she transfers, she suddenly gains a Kokuinsuu, and becomes involved in the battle between the Suu-ken."},{"spoiler":false,"text":"Description taken from:"}],"source":"vndb","sourceCharacterId":"c42683"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23989c683c17b75024d1056e42339d1a3f7d0f239af723c503729834389a5465.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8f56a3e779b04ad6f023990429d7ee27dab46060104ec78ebf14e663ef2da4a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c42684","characterName":"壱園 央助","sourceIds":{"vndbCharacterId":"c42684"},"originalCharacterName":"壱園 央助","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"101"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"1: The prideful, arrogant number."},{"spoiler":false,"text":"‘As long as I am this number, I will never be forgiven if I lose.’"},{"spoiler":false,"text":"High school 3rd year student."},{"spoiler":false,"text":"Though he’s friendly and gentle, he’s extremely prideful, and will not forgive anyone who makes him inferior."},{"spoiler":false,"text":"Accomplished in both literary and military arts, he is the president of both the student council and the Kendo club, and receives full support from both the student body and teachers."},{"spoiler":false,"text":"Description from:"}],"source":"vndb","sourceCharacterId":"c42684"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a48aacde4a638864b09ea0ffe7b7d9c309e652af6096c7814cdaf44984811d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7442815cf6dd589c2c584b888cc8573082f10a68058ae12be4ff04418fed3cd8.webp","width":253,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遊佐 浩二","creatorId":"vndb:s56","sourcePersonId":"vndb:s56","canonicalEntityId":"vndb:s56","name":"遊佐 浩二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65997","source":"vndb"}]},{"characterId":"char_vndb_c42685","characterName":"弐藤 光","sourceIds":{"vndbCharacterId":"c42685"},"originalCharacterName":"弐藤 光","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"2: The number who yearns for victory."},{"spoiler":false,"text":"‘I’ll prove it to you in this battle — the fact that I’m strong than you.’"},{"spoiler":false,"text":"High school 1st year student."},{"spoiler":false,"text":"Extremely curious and constantly energetic. He’s good at taking care of others, and despite being a 1st year student, he’s very reliable. However, he hates losing, and is very particular about winning in everything. In his free time, he likes making crafts. Though he can put girls to shame with his craft skills, what he actually produces, however, heavily depends his own feelings."},{"spoiler":false,"text":"He created and is currently the chief of the Suu-ken that actually has nothing to do with its name."},{"spoiler":false,"text":"Description from:"}],"source":"vndb","sourceCharacterId":"c42685"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbc1b9f7fd7759564a129736846ccd77db2bb085e48171fa71a5c6f49ca77c7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/894981446db259598b8ed23bbb8cb60556b3838d116d11efb4d6936f32f33271.webp","width":256,"height":241,"source":"static-detail"},"actors":[{"creditedName":"西山 宏太朗","creatorId":"vndb:s8864","sourcePersonId":"vndb:s8864","canonicalEntityId":"vndb:s8864","name":"西山 宏太朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66005","source":"vndb"}]},{"characterId":"char_vndb_c42686","characterName":"肆形 有比","sourceIds":{"vndbCharacterId":"c42686"},"originalCharacterName":"肆形 有比","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"421"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"4: The unlucky number who is hated."},{"spoiler":false,"text":"‘Since I’m so weak I needed to be protected by a girl, I’m a worthless human being……’"},{"spoiler":false,"text":"High school 2nd year student."},{"spoiler":false,"text":"A timid person and a pessimistic thinker. He is often bullied by delinquents like Tomoe in school. He loves the occult, and while he becomes very rarely passionate when talking about it, some consider this side of him creepy."},{"spoiler":false,"text":"A member of Suu-ken."},{"spoiler":false,"text":"Description from:"}],"source":"vndb","sourceCharacterId":"c42686"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7325aa0d37a6c299b25307d946cbba3ea623d5c8c8d1c72e5bb836af9f4d9322.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34876d39f4154c3ccad778343588930f6ed799ab8521f7af611813dfa5ca16e8.webp","width":229,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木 達央","creatorId":"vndb:s376","sourcePersonId":"vndb:s376","canonicalEntityId":"vndb:s376","name":"鈴木 達央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66002","source":"vndb"}]},{"characterId":"char_vndb_c42687","characterName":"陸平 崇樹","sourceIds":{"vndbCharacterId":"c42687"},"originalCharacterName":"陸平 崇樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"618"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"6: The quiet number who rejects conflict."},{"spoiler":false,"text":"‘I won’t fight no matter what. Even if it means that you’ll be in danger.’"},{"spoiler":false,"text":"High school 3rd year student."},{"spoiler":false,"text":"He is extremely quiet, to the point where he can go an entire day without speaking if you leave him alone. He avoids all sorts of arguments or conflict."},{"spoiler":false,"text":"Because he is the oldest in the Suu-ken, he was made the vice president of the club, but he doesn’t actually do any work."},{"spoiler":false,"text":"Description from:"}],"source":"vndb","sourceCharacterId":"c42687"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42db7c5c024c1cdc9caff69964bb2b6f6d51503ddb0e943cf84b29dcfc56d412.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22ab10cc0cf93de66b404766fc53fc30f0f02f3220da33af3879226e56760b6b.webp","width":204,"height":256,"source":"static-detail"},"actors":[{"creditedName":"興津 和幸","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66000","source":"vndb"}]},{"characterId":"char_vndb_c42688","characterName":"漆原 景太郎","sourceIds":{"vndbCharacterId":"c42688"},"originalCharacterName":"漆原 景太郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"702"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"7: The miraculous number who stands out."},{"spoiler":false,"text":"Calling me a miracle is too much. I’m just slightly luckier than the average person, that’s all.’"},{"spoiler":false,"text":"High school 1st year student."},{"spoiler":false,"text":"He has a very refreshing personality, and is an honour student who has the best grades in his year. He is a kind person, and a part of the student council. Among all the members of the student council, he is the only one who is really ordinary and has common sense. He was born with good luck, and has lived until today without having to suffer or worry much."},{"spoiler":false,"text":"Description from:"}],"source":"vndb","sourceCharacterId":"c42688"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8e8097def72608219987af66f7941330550b88a98498e1379fe91d2eca9cb55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/076dd94132f4ae1a5220e60393ac95dc46a70906656457c6dbee29f9b59ef68e.webp","width":243,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前野 智昭","creatorId":"vndb:s64","sourcePersonId":"vndb:s64","canonicalEntityId":"vndb:s64","name":"前野 智昭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65998","source":"vndb"}]},{"characterId":"char_vndb_c42689","characterName":"玖折 巡","sourceIds":{"vndbCharacterId":"c42689"},"originalCharacterName":"玖折 巡","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"924"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"9: The unfair number who excels in tricks."},{"spoiler":false,"text":"It seems that you still don’t understand. It means that you never had a choice from the very beginning.’"},{"spoiler":false,"text":"High school 2nd year student."},{"spoiler":false,"text":"A cruel person who enjoys seeing the misfortune of others. He looks down on everyone except for Ousuke, whom he admires, and will show no mercy to those who try to fight against Ousuke. He is disliked not just by most of the student body, but by many of the Suu-ke students too."},{"spoiler":false,"text":"Description from:"}],"source":"vndb","sourceCharacterId":"c42689"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1d390057584eafddedee6a4c87c7e8a173e8477420a9369676d844351174b25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/990f6488de44ce779fd3b133452308284461d69ea6563582ce97edbe5f914b0f.webp","width":256,"height":240,"source":"static-detail"},"actors":[{"creditedName":"森田 成一","creatorId":"vndb:s176","sourcePersonId":"vndb:s176","canonicalEntityId":"vndb:s176","name":"森田 成一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66001","source":"vndb"}]},{"characterId":"char_vndb_c53561","characterName":"参河 利保子","sourceIds":{"vndbCharacterId":"c53561"},"originalCharacterName":"参河 利保子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"312"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3: The beautiful number, filled with love."},{"spoiler":false,"text":"‘Unsightly beings like men; I’ll erase them for you.’"},{"spoiler":false,"text":"High school 3rd year student."},{"spoiler":false,"text":"A beautiful and elegant ojou-sama. Though she used to be gentle towards everyone, a certain incident made her intensely hate men. She loves flowers, and is taking care of flowerbeds on the school rooftop. However, she has made the rooftop closed to all men."},{"spoiler":false,"text":"She is the secretary in the student council."},{"spoiler":false,"text":"Description from:"}],"source":"vndb","sourceCharacterId":"c53561"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9b88b3d6c1a551960e72d828cc327b43969ee4c49e3b03c28497d0e3ff81861.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79e8174cacc01146991428c6f7845fc8d48fad7031fd5893cb452856d8d6d886.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ゆきの さつき","creatorId":"vndb:s474","sourcePersonId":"vndb:s474","canonicalEntityId":"vndb:s474","name":"ゆきの さつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66006","source":"vndb"}]},{"characterId":"char_vndb_c53562","characterName":"捌沢 暗 & 明","sourceIds":{"vndbCharacterId":"c53562"},"originalCharacterName":"捌沢 暗 & 明","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"831"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"8: The number which possesses contrasting intentions."},{"spoiler":false,"text":"An:"},{"spoiler":false,"text":"‘Why don’t you give up on swinging that sword around, and spend a more meaningful after school with me.~’"},{"spoiler":false,"text":"High school 3rd year student."},{"spoiler":false,"text":"Never serious, and constantly playing around with girls. Mei’s older twin brother. He speaks his mind and sometimes fails to read the atmosphere, and is constantly scolded by Mitsu or Mei as a result."},{"spoiler":false,"text":"Even though he’s a member of the Suu-ken, he rarely shows up."},{"spoiler":false,"text":"Mei:"},{"spoiler":false,"text":"‘I’m not like my stupid older brother. I’ll put in effort in order to win.’"},{"spoiler":false,"text":"High school 3rd year student."},{"spoiler":false,"text":"Very serious and strict personality. An’s younger twin sister. She doesn’t understand jokes, and takes everything seriously. She is constantly berating her brother for being pathetic."},{"spoiler":false,"text":"A member of the Suu-ken, unlike her brother, she makes sure to attend all meetings."},{"spoiler":false,"text":"Description from:"}],"source":"vndb","sourceCharacterId":"c53562"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d18ad791f4ca2f3ba81e7252a35bac1ce3657326b9effacd6d7cb38f25854669.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bd13d9c1d65ec7b9deed34d52fa5260aa4fef1e1228db3a6a584d9d4c433a9c.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内山 夕実","creatorId":"vndb:s5714","sourcePersonId":"vndb:s5714","canonicalEntityId":"vndb:s5714","name":"内山 夕実","ro