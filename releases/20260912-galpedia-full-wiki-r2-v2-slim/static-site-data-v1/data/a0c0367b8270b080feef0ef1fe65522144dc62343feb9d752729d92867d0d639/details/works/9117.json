riptions":[{"segments":[{"spoiler":false,"text":"She is pure and graceful. She is overprotective of her son Mitsuo, but he is not related to him by blood, as she married his father when he was still young (her husband passed away in a car accident when Mitsuo was still young)."},{"spoiler":false,"text":"She has never given birth, so even at her age, she is young and very pretty. She is puzzled by Mitsuo's gradual growth into an adult."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c48868"},{"segments":[{"spoiler":false,"text":"主人公の母親。専業主婦。36歳。"},{"spoiler":false,"text":"主人公が幼いときに、後妻として嫁いできたため、血の繋がりはない。"},{"spoiler":false,"text":"彼女の夫は、既に他界しており、現在は主人公と二人で暮らしている。"},{"spoiler":false,"text":"年齢よりも若く見られ、清純でお淑やか、母性溢れる女性。"},{"spoiler":false,"text":"主人公に対しては過保護で、大人へと成長していく息子に焦りのような、戸惑いのような複雑な思いを抱いている。"}],"source":"egs","sourceCharacterId":"21019","sourceWorkId":"9117","spoiler":false},{"segments":[{"spoiler":false,"text":"清純でおしとやか。"},{"spoiler":false,"text":"過保護なほどに息子の美津雄をかまうが、彼が物心つかない頃に後妻として嫁いできたため、血は繋がっていない。（旦那は、美津雄がまだ幼い頃に交通事故で他界）"},{"spoiler":false,"text":"出産経験がないため、この年齢でも若々しく、たいへん可愛らしい女性。"},{"spoiler":false,"text":"だんだん大人へと成長していく美津雄に、戸惑いを覚える。"},{"spoiler":false,"text":"「みつくんがして欲しいこと、なんでもママがしてあげるから…」"}],"source":"bangumi","sourceCharacterId":"78642"}],"profileFacts":[{"label":"年龄（本版本）","value":"36 岁","valueContext":null,"source":"egs","sourceCharacterId":"21019","sourceWorkId":"9117","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"21019","sourceWorkId":"9117","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"21019","sourceWorkId":"9117","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"21019","sourceWorkId":"9117","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","so