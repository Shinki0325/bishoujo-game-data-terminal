-staff:172829","source":"vndb"},{"creditedName":"カスカベ シシオ","creatorId":"vndb:s1505","sourcePersonId":"vndb:s1505","canonicalEntityId":"vndb:s1505","name":"草壁よしお","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:172831","source":"vndb"}]},"cast":[{"characterId":"char_c95816","characterName":"園池 桜子","sourceIds":{"bangumi":[{"characterId":"91399","match":"exact-normalized-name-in-linked-work","subjectId":"328029"}],"egsCharacterIds":["23353"],"vndbCharacterId":"c95816"},"originalCharacterName":"園池 桜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"810"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend who has been close to the protagonist since kindergarten and knows him well. She honestly tells the protagonist what she wants and never forgets to stand up for him."},{"spoiler":false,"text":"Currently, her relationship with the protagonist is as follows: \"There is love, but no romantic feelings. There are no romantic feelings, but there is love,\" and no progress has been made."}],"source":"vndb","sourceCharacterId":"c95816"},{"segments":[{"spoiler":false,"text":"主人公とは幼稚園の頃からの仲良し。"},{"spoiler":false,"text":"彼女は主人公には自分の望みを素直に言う。"},{"spoiler":false,"text":"そうした方が主人公も喜んでくれると知っているから。"},{"spoiler":false,"text":"大好きな主人公を立てることを忘れない。"},{"spoiler":false,"text":"半歩下がったところから彼の魅力を引き立てたい。"},{"spoiler":false,"text":"現状、主人公との仲は、「愛はあるけど恋はない。恋はないけど愛がある」といったもの。"},{"spoiler":false,"text":"性知識は学校で教わった程度で、恋愛感情を抱くまでには至っていない。"}],"source":"egs","sourceCharacterId":"23353","sourceWorkId":"30627","spoiler":false},{"segments":[{"spoiler":false,"text":"幼稚園の頃からの仲良しで、主人公のことをよく知る幼なじみ。 主人公には、自分の望みを素直に言い。また主人公を立てることを忘れない。"},{"spoiler":false,"text":"現在、主人公との仲は「愛はあるけど恋はない。恋はないけど愛がある」といったところで進展はない状態が続いている。"}],"source":"bangumi","sourceCharacterId":"91399"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"91399","value":"幼なじみの心を読む"},{"label":"趣味","source":"bangumi","sourceCharacterId":"91399","value":"土いじり"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed34af5c0878418d080b410aae94078aeb9203bf24024536bce76f896fc363c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6d83d2d1eaa4339d6fa52f572523cd7bc196521f2ab3ba93a40a08f9fb667a6.webp","width":94,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鹿瀬紫卯","creatorId":"vndb:s8642","sourcePersonId":"vndb:s8642","canonicalEntityId":"vndb:s8642","name":"鹿瀬紫卯","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:328029:91399:56841:1","source":"bangumi"}]},{"characterId":"char_c95817","characterName":"篠原 小唄","sourceIds":{"bangumi":[{"characterId":"91400","match":"exact-normalized-name-in-linked-work","subjectId":"328029"}],"egsCharacterIds":["23354"],"vndbCharacterId":"c95817"},"originalCharacterName":"篠原 小唄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"509"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A petite-figured older sister who takes care of her younger siblings in place of her parents, who are busy taking care of their Izakaya."},{"spoiler":false,"text":"Despite being the same age as the protagonist, she has acquired a maternal nature due to being an older sister. She doesn't have an inferiority complex because of her childish appearance, but she does think that she's not ready for love. She doesn't have much sexual knowledge, but she is very serious and studies hard once she starts dating the protagonist. She doesn't realize that she has a dormant desire to be pampered by someone."}],"source":"vndb","sourceCharacterId":"c95817"},{"segments":[{"spoiler":false,"text":"家が居酒屋をやっていて繁盛し大忙し。"},{"spoiler":false,"text":"弟妹がたくさんいて、忙しい両親の代わりによく面倒を見ている。"},{"spoiler":false,"text":"年の離れた弟妹がいることもあり、「お姉ちゃん」を超えて「ママ」と言うべき母性を身に付け、人の世話をするのは当り前のことだと思っている。"},{"spoiler":false,"text":"自分の中に誰かに甘えたいという思いが眠っているのに気付いていない。"},{"spoiler":false,"text":"甘えたいのは疲れているからではなく、今よりもっと安心したいから。"},{"spoiler":false,"text":"見た目ロリな自分に劣等感がある訳ではないが、こんな見た目では恋愛とは縁遠いだろうと思っている。"},{"spoiler":false,"text":"性知識は学校で教わった程度だったが、付き合うことになってから猛烈に勉強し、エロマンガで授乳手コキのことも知る。"}],"source":"egs","sourceCharacterId":"23354","sourceWorkId":"30627","spoiler":false},{"segments":[{"spoiler":false,"text":"家の居酒屋が繁盛して忙しい両親の代わりに、弟妹たち の面倒を見ている小さなお姉ちゃん。"},{"spoiler":false,"text":"主人公と同級生だが、年の離れた弟妹がいることもあり 「ママ」と言うべき母性を身に付けている。見た目が幼い自分に劣等感は無いが、恋愛とは縁遠いだ ろうと思っている。性知識はあまりないが、付き合うことになってから猛烈に勉強する生真面目さを持つ。 自分の中に、誰かに甘えたいという思いが眠っているのに気付いていない。"}],"source":"bangumi","sourceCharacterId":"91400"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"91400","value":"よしよし"},{"label":"趣味","source":"bangumi","sourceCharacterId":"91400","value":"創作料理"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dd112f457285e20ebd2ef99181dcaa2691cc5f43f6c16fb41b0fa279df5e959.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/617c28f3b7e8735280bc1498dc6ce0d3fae8f2f04336a99c66dd0ec28688a527.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:328029:91400:20696:1","source":"bangumi"}]},{"characterId":"char_c95818","characterName":"秤 結衣","sourceIds":{"bangumi":[{"characterId":"91401","match":"exact-normalized-name-in-linked-work","subjectId":"328029"}],"egsCharacterIds":["23355"],"vndbCharacterId":"c95818"},"originalCharacterName":"秤 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1016"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After the trauma of being isolated in the past, she is resolved to use moving up to high school as an opportunity."},{"spoiler":false,"text":"She dresses herself in the ideal \"cute\" and tries to become someone who is liked by everyone."},{"spoiler":false,"text":"As a result of her efforts, she is now the center of the girl's group in her class, and although people around her have come to rely on her more and more, she is also pushing herself too hard and is exhausted every day in the shadows. Because she stays up late communicating on social networking sites, she has bad grades and is hopelessly non-athletic. Recently, her friend group has been inviting her to goukon and to hang out with boys, so she wants a boyfriend urgently in order to reject those invitations."}],"source":"vndb","sourceCharacterId":"c95818"},{"segments":[{"spoiler":false,"text":"中学の修学旅行の班分けで完全に孤立してしまったトラウマから、進学を期に一念発起。"},{"spoiler":false,"text":"理想の「カワイイ」を自らの身に纏い、誰にでも好かれる、仲間はずれにならない自分になろうと決意。"},{"spoiler":false,"text":"その目論見は成功し、一躍クラスの女子グループの中心的存在に。"},{"spoiler":false,"text":"メイクやアクセについて人に頼られ教えるのは楽しいが、相当無理をして取り繕っているので帰宅する時には毎日ヘトヘト。"},{"spoiler":false,"text":"就寝直前まで友達とSNSでのやり取りに勤しみ、当然のように課題をする時間はないので学業の成績は壊滅的。"},{"spoiler":false,"text":"絶望的に運動音痴。圧倒的に非力。人間以前に生物としてザコ。"},{"spoiler":false,"text":"週末は推しの動画を延々と流しながらアクセサリー作りやネットサーフィンに勤しむ。ライブがあれば現場へゴー。"},{"spoiler":false,"text":"最近は友達グループが性への興味に目覚め、普通にエロトークをするためついていこうと必死。"},{"spoiler":false,"text":"合コンや男子を含めた遊びの誘いを断るためにも、切実に彼氏が欲しい。"}],"source":"egs","sourceCharacterId":"23355","sourceWorkId":"30627","spoiler":false},{"segments":[{"spoiler":false,"text":"過去、孤立してしまったトラウマから進学を期に一念発起。"},{"spoiler":false,"text":"理想の「カワイイ」を身にまとい、誰にでも好かれる自分になろうとしている。努力の結果、現在はクラスの女子グループの中心的存在。"},{"spoiler":false,"text":"周囲から頼られる事も増えたが、無理もしているため毎日影でヘトヘトになっている。 夜遅くまでＳＮＳでやり取りをしていたりするため学業成績は壊滅的＋絶望的な運動音痴という“ザコ”な一面を持つ。最近は友達グループから合コンや男子を含めた遊びの誘いを断るためにも、切実に彼氏が欲しい。"}],"source":"bangumi","sourceCharacterId":"91401"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"91401","value":"歌とダンスの完コピ"},{"label":"趣味","source":"bangumi","sourceCharacterId":"91401","value":"アクセサリーづくり"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b844d64fa594ab88dfb770d90c33fad047677f9b88d38e65ae8fc7d086c996bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b8626de04694626ce8891e854e54a0c04466b36de6bf92bf5fd7a4049b4f141.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五十嵐裕美","creatorId":"vndb:s77","sourcePersonId":"vndb:s77","canonicalEntityId":"vndb:s77","name":"五十嵐 裕美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:328029:91401:5208:1","source":"bangumi"}]},{"characterId":"char_c95819","characterName":"夜舟 初穂","sourceIds":{"bangumi":[{"characterId":"91402","match":"exact-normalized-name-in-linked-work","subjectId":"328029"}],"egsCharacterIds":["23356"],"vndbCharacterId":"c95819"},"originalCharacterName":"夜舟 初穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"107"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her family is an old shrine family that has been enshrining a local deity for generations."},{"spoiler":false,"text":"Usually, she runs a mysterious grocery store that her father had purchased on the grounds of the shrine, and when she's not at the store, she can be found in front of the station with a musical instrument in her hand, performing live on the streets."},{"spoiler":false,"text":"She is often called \"Onee-sama\" at her girls' school and often receives chocolates on Valentine's Day, but she feels that the girls who have feelings for her are only in love with romance and do not see the real her. While having the doubt of \"what is the real me?\", she is always seeking something to be the focal point of her life."}],"source":"vndb","sourceCharacterId":"c95819"},{"segments":[{"spoiler":false,"text":"実家は代々氏神を祀る旧社家。"},{"spoiler":false,"text":"神社の境内には父親が仕入れた謎の雑貨を売る怪しい店があり、初穂が店を開けた時だけ開いている。"},{"spoiler":false,"text":"運良く開店している時間に訪れることができれば、その人が必要としているものが必ず手に入るというジンクスがある。"},{"spoiler":false,"text":"店を開けていない時は楽器を手に駅前でストリートライブに興じている事も。"},{"spoiler":false,"text":"女子校では「お姉様」と呼ばれバレンタインには同性からチョコもらいがち。"},{"spoiler":false,"text":"自分に想いを寄せる少女たちは恋に恋しているだけで本当の自分を見てくれていないと感じるが、「本当の自分って？」という問いかけに、自身が答えを出すことができないでいる。"},{"spoiler":false,"text":"そのため彼女はいつも、自分の軸になってくれる何かを探し求めている。"}],"source":"egs","sourceCharacterId":"23356","sourceWorkId":"30627","spoiler":false},{"segments":[{"spoiler":false,"text":"実家は代々氏神を祀る旧社家。"},{"spoiler":false,"text":"普段は、神社の境内にある父親が仕入れたという謎の雑貨店を営んでいたり、店にいない時は楽器を手に駅前でストリートライブに興じている事も。"},{"spoiler":false,"text":"女子校では「お姉様」と呼ばれバレンタインにはチョコをよくもらうが、自分に想いを寄せる少女たちは恋に恋しているだけで本当の自分を見てくれていないと感じている。「本当の自分って？」と疑問を持ちながら、いつも自分の軸になってくれる何かを探し求めている。"}],"source":"bangumi","sourceCharacterId":"91402"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"91402","value":"ヴァイオリン"},{"label":"趣味","source":"bangumi","sourceCharacterId":"91402","value":"食べ歩き"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eea1cfb5061744b638b7ba245323b599db7869e9bfd7f018137c476563811e48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1888f6c3223bca24ea63e6accbc727170ea06b657f52a28778adbc02a38ff514.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:328029:91402:10662:1","source":"bangumi"}]},{"characterId":"char_vndb_c168470","characterName":"篠原 廻","sourceIds":{"vndbCharacterId":"c168470"},"originalCharacterName":"篠原 廻","characterNameSource":null,"role":"side","status":"s