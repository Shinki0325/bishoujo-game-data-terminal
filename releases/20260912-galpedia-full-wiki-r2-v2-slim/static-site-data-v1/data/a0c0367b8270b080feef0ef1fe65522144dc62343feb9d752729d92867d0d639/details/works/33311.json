tions":[{"segments":[{"spoiler":false,"text":"She and Nozomu live next door to each other, and have grown up together since they were little."},{"spoiler":false,"text":"Compared to Nozomi, she has a bit of a genius side to him, and can do most things with ease."},{"spoiler":false,"text":"On top of that, she works hard, so she's practically invincible."},{"spoiler":false,"text":"She's fairly popular with the guys, but she's not very good at romance and has never had a boyfriend."},{"spoiler":false,"text":"She has competed in various competitions with Nozomu since she was a child, and is quite particular about winning and losing."},{"spoiler":false,"text":"Normally, she is an exemplary student, as befits the student council president, but she tends to let her guard down a little in front of Nozomu."},{"spoiler":false,"text":"Translated from the Official website"}],"source":"vndb","sourceCharacterId":"c115863"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb86a7cbaef46f3c700317721fbfad5515bb9aedb08f4b4b5167bd2b6be691ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b53333e4564c14b29bfda45543812a082aac77132e48ef52746727c19cf37ec.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木多野 あり","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92765","source":"vndb"}]},{"characterId":"char_vndb_c115923","characterName":"尾之上 望","sourceIds":{"vndbCharacterId":"c115923"},"originalCharacterName":"尾之上 望","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nodoka's childhood friend and classmate, a second-year student, and the student council's vice president."},{"spoiler":false,"text":"An earnest person who is good at both sports and studies. Because of his efforts, he always stays at the top of his class. Although he is somewhat popular, he has no interest in romance, and never had a girlfriend."},{"spoiler":false,"text":"He isn't the type of person who has a strong obsession​ with winning or losing, but always goes along with Nodoka."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c115923"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p12551","sourceCompanyId":"egs:brand:7203","canonicalEntityId":"vndb:p12551","name":"Guilty'Dash","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33311:7203","source":"egs"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106389:v38403","source":"vndb"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:109368:v38403","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
