,"source":"vndb"},{"creditedName":"mugicha","creatorId":"vndb:s52107","sourcePersonId":"vndb:s52107","canonicalEntityId":"vndb:s52107","name":"mugicha","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:209082","source":"vndb"},{"creditedName":"tomsan","creatorId":"vndb:s6343","sourcePersonId":"vndb:s6343","canonicalEntityId":"vndb:s6343","name":"tomsan","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:209088","source":"vndb"},{"creditedName":"樋舘 誠","creatorId":"vndb:s7774","sourcePersonId":"vndb:s7774","canonicalEntityId":"vndb:s7774","name":"樋舘 誠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:209089","source":"vndb"}]},"cast":[{"characterId":"char_c24422","characterName":"アノーラ・アルクノア","sourceIds":{"bangumi":[{"characterId":"27691","match":"exact-normalized-name-in-linked-work","subjectId":"116858"}],"egsCharacterIds":["4900"],"vndbCharacterId":"c24422"},"originalCharacterName":"アノーラ・アルクノア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sub-commander of the \"Black Arme Vapula,\" a secret task force unit that serves directly under the Demon Empress."},{"spoiler":false,"text":"She is Leonhardt's cousin, and they share a very close bond, such that she would not hesitate to trade her own life for his."},{"spoiler":false,"text":"When their country was invaded and destroyed, Anora was forcibly turned into a Wraith Unit to be used as a weapon against the gods. Upon becoming one, she gained the ability to interfere with and influence the souls of others, which eventually led to the ability to \"morph\" others. However, the amount of energy required is so massive that it shortens her lifespan every time she uses it. She also has a familiar in the shape of a black cat named Envy."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c24422"},{"segments":[{"spoiler":false,"text":"ヴァルガニア帝国・皇帝直属部隊\"疾黒装隊\"の隊長補佐官。レオンハルトとは従兄妹の関係にあり、互いの為なら命を投げ出すことも躊躇わない程に強い信頼関係で結ばれている。"},{"spoiler":false,"text":"祖国を滅亡させられた後、魔族によって霊想兵器（レイスユニット）と呼ばれる人型の対神族決戦兵器として肉体を作り替えられた。その際に他者の魂に干渉し変質させるという洗脳の力の開花に至ったが、消耗が大きく自らの寿命をも削っている。"},{"spoiler":false,"text":"使い魔の黒猫、エンヴィーを使役している。"},{"spoiler":false,"text":"所有タクティカ、『漆黒宴の礼装（スクレッツァ）』。洗脳を司る。他者の魂と意識に強制的に介入し、精神を侵食・変質させていく。その性質上、潜入・撹乱・隠密工作などを得意とする。"}],"source":"egs","sourceCharacterId":"4900","sourceWorkId":"20852","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァルガニア帝国・皇帝直属部隊 “疾黒装隊” の隊長補佐官。"},{"spoiler":false,"text":"レオンハルトとは従兄妹の関係にあり、互いのためなら命を投げ出すことも躊躇わないほどに強い信頼関係で結ばれている。"},{"spoiler":false,"text":"祖国を滅亡させられた後、魔族によって霊想兵器（レイスユニット）と呼ばれる人型の対神族決戦兵器として肉体を作り替えられた。"},{"spoiler":false,"text":"その際に他者の魂に干渉し変質させるという洗脳の力の開花に至ったが、消耗が大きく自らの寿命をも削っている。"},{"spoiler":false,"text":"使い魔の黒猫・エンヴィーを使役している。"},{"spoiler":false,"text":"「貴方の望む通りに道を作る。 それが私の在り方よ」"},{"spoiler":false,"text":"所有タクティカ：『漆黒宴の礼装（スクレッツァ）』"},{"spoiler":false,"text":"洗脳を司る。 他者の魂と意識に強制的に介入し、精神を侵食・変質させていく。 その性質上、潜入・撹乱・隠密工作などを得意とする。"}],"source":"bangumi","sourceCharacterId":"27691"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"27691","value":"ヴァルガニア帝国"},{"label":"種族","source":"bangumi","sourceCharacterId":"27691","value":"霊想兵器（♀）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bef162c85228e6b1b476afed39ea1eb09660974ff96574bca06ed4f0647d51b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c8ccd13eda7213ef3ba1c72547e47c881e9cbb0a978ba36b6641480cb4e0f06.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c24419","characterName":"シルヴィア＝ハマルティア","sourceIds":{"vndbCharacterId":"c24419"},"originalCharacterName":"シルヴィア＝ハマルティア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of the Demon Empress Karvia, who rules over the Varganian Empire."},{"spoiler":false,"text":"She is known as the Empire's \"White Princess.\" Unlike most demons, she is very kind, caring, and compassionate. Displaying qualities of her human mother, she wishes for man and demon to one day come together and live in harmony and peaceful co-existence."},{"spoiler":false,"text":"Although she maintains a facade of being a dignified, wise demon princess, she is, in reality, still rather young and takes things as they come at her own pace."},{"spoiler":false,"text":"She is a rare being that houses both divine and demonic energy within her. She is rather proficient in healing and purification magic."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c24419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b4723d89442315bbf704ea1f51983a02287893b99dca8c2be8cabae0d37bc3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e8896888ab188c82aa033862445d4975b6fb4d428d7c00e98e73c3fa6dc25e6.