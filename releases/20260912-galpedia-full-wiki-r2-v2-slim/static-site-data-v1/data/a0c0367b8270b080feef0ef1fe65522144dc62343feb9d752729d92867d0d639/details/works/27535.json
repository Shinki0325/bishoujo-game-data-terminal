riptions":[{"segments":[{"spoiler":false,"text":"隆之介の引っ越し先の隣の家に住むお姉さん。"},{"spoiler":false,"text":"身長１６０センチそこそこだが、ややすらりとした印象のある、スマートな雰囲気の持ち主。"},{"spoiler":false,"text":"胸はけっこうある。"},{"spoiler":false,"text":"成績は優秀で、もっとレベルの高いところに入ることも充分に可能だったが、自宅から通える範囲であることなどから地元の名門校を選んだ。"},{"spoiler":false,"text":"ぱっと見でもわかるような華やかさを持つ芸能人ばりの美人だが、今のメイクやファッションは最近になってから周囲に合わせるために身につけたもの。"},{"spoiler":false,"text":"とはいえ、まだまだおっかなびっくり背伸びしているような状態で、女子校＆お嬢さま育ちだったこともあり、性に関してもあまりディープな知識などはない。"},{"spoiler":false,"text":"ずっと目上の人からかわいがられる立場だったこともあり、隆之介に対しては年上の家庭教師として、お姉さんらしさを見せなければ、と気合いを入れている。"}],"source":"egs","sourceCharacterId":"20632","sourceWorkId":"27535","spoiler":false},{"segments":[{"spoiler":false,"text":"隆之介の引っ越し先の隣の家に住むお姉さん。"},{"spoiler":false,"text":"身長160センチそこそこだが、ややすらりとした印象のある、"},{"spoiler":false,"text":"スマートな雰囲気の持ち主。胸はけっこうある。"},{"spoiler":false,"text":"成績は優秀でもっとレベルの高いところに入ることも充分に可能だったが、"},{"spoiler":false,"text":"自宅から通える範囲であることなどから地元の名門校を選んだ。"},{"spoiler":false,"text":"ぱっと見でもわかるような華やかさを持つ芸能人ばりの美人だが、"},{"spoiler":false,"text":"今のメイクやファッションは最近になってから周囲に合わせるために身につけたもの。"},{"spoiler":false,"text":"とはいえ、まだまだおっかなびっくり背伸びしているような状態で、"},{"spoiler":false,"text":"女子校＆お嬢さま育ちだったこともあり性に関してもあまりディープな知識などはない。"},{"spoiler":false,"text":"ずっと目上の人からかわいがられる立場だったこともあり、"},{"spoiler":false,"text":"隆之介に対しては年上の家庭教師として、"},{"spoiler":false,"text":"お姉さんらしさを見せなければ、と気合いを入れている。"}],"source":"bangumi","sourceCharacterId":"67822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2947efe10d2e3f2365d8d5e2eabc95e054c76475eb7d03f26263c2efb66d4735.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65df8008b5dbc257afa9baf847ffdbc8f4de3210f0462dfc624d998ab6ecfa73.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小澤みのり","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"