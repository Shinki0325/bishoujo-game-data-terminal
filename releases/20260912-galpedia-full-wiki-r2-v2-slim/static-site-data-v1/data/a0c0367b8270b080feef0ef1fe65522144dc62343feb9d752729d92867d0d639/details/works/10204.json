A","creatorId":"vndb:s43937","sourcePersonId":"vndb:s43937","canonicalEntityId":"vndb:s43937","name":"ASUKA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18075","source":"vndb"},{"creditedName":"株式会杜ティー・エー・ビー","creatorId":"vndb:s37204","sourcePersonId":"vndb:s37204","canonicalEntityId":"vndb:s37204","name":"TAB act1(TABact1)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18076","source":"vndb"}]},"cast":[{"characterId":"char_c867","characterName":"一条依真","sourceIds":{"bangumi":[{"characterId":"114119","match":"exact-normalized-name-in-linked-work","subjectId":"222119"}],"egsCharacterIds":["18969"],"vndbCharacterId":"c867"},"originalCharacterName":"一条依真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head maid of Toshiya's household, Ema has been serving him since he was very young."},{"spoiler":false,"text":"She is exceedingly loyal to him, and will do anything he commands, regardless of its legality."},{"spoiler":false,"text":"Toshiya trusts her implicitly, and respects her as well."},{"spoiler":false,"text":"As master and servant, they accept everything about one another without question."},{"spoiler":false,"text":"from MangaGamer"}],"source":"vndb","sourceCharacterId":"c867"},{"segments":[{"spoiler":false,"text":"～お姉さんメイド～"},{"spoiler":false,"text":"俊哉にずっと仕えているメイド長ともいえる存在。"},{"spoiler":false,"text":"穏やかな性格だが、俊哉のことになると譲らない面もあり、彼の命令ならば、どんな非合法なことでも実行する。"},{"spoiler":false,"text":"俊哉も彼女には絶対の信頼をおいており、尊敬もしているようで、互いに認め合った、美しい（？）主従関係を築いている。"},{"spoiler":false,"text":"そんな依真だが、出生にはちょっとした秘密があるようで……？"},{"spoiler":false,"text":"「あら。エッチが嫌いなの？　勿体ないわね～」"}],"source":"egs","sourceCharacterId":"18969","sourceWorkId":"10204","spoiler":false},{"segments":[{"spoiler":false,"text":"～お姉さんメイド～"},{"spoiler":false,"text":"俊哉にずっと仕えているメイド長ともいえる存在。"},{"spoiler":false,"text":"穏やかな性格だが、俊哉のことになると譲らない面もあり、"},{"spoiler":false,"text":"彼の命令ならば、どんな非合法なことでも実行する。"},{"spoiler":false,"text":"俊哉も彼女には絶対の信頼をおいており、尊敬もしているようで、"},{"spoiler":false,"text":"互いに認め合った、美しい（？）主従関係を築いている。"},{"spoiler":false,"text":"そんな依真だが、出生にはちょっとした秘密があるようで……？"},{"spoiler":false,"text":"「あら。エッチが嫌いなの？　勿体ないわね～」"}],"source":"bangumi","sourceCharacterId":"114119"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b85d777db3b3e76c6661a432649db22a7fcf586fb91474c110c0d42b6c87672a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c20e5e04e9b518afacd532e2e838031a96466c17edfd75f35e7a9cc4fd625613.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222119:114119:4940:1","source":"bangumi"}]},{"characterId":"char_c868","characterName":"叢雲 さくら","sourceIds":{"bangumi":[{"characterId":"114116","match":"exact-normalized-name-in-linked-work","subjectId":"222119"}],"egsCharacterIds":["18966"],"vndbCharacterId":"c868"},"originalCharacterName":"叢雲 さくら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Toshiya's classmate."},{"spoiler":false,"text":"Cheerful, helpful, and spirited, Sakura is popular with classmates of both sexes."},{"spoiler":false,"text":"Her family has run a restaurant for generations, and Sakura has inherited her naivete from her parents, who are often deceived by others."},{"spoiler":false,"text":"They became co-signers on a loan for an acquaintance, but the acquaintance quickly left town, leaving them with enormous debt."},{"spoiler":false,"text":"In order to help repay their debt, Sakura has taken a part-time job delivering newspapers before school."},{"spoiler":false,"text":"from MangaGamer"}],"source":"vndb","sourceCharacterId":"c868"},{"segments":[{"spoiler":false,"text":"～ツンデレ強気メイド～"},{"spoiler":false,"text":"活発で面倒見がよく、さっぱりした性格で、男女問わず人気があるクラスメイトの少女。"},{"spoiler":false,"text":"家の借金を少しでも減らすため、新聞配達のバイトをしていた。"},{"spoiler":false,"text":"バイト後、急いで学校に向かっている途中で俊哉とぶつかったことが、彼女の人生のターニングポイントだったのかもしれない。"},{"spoiler":false,"text":"「ちょっとあんた。あたしのこと、一体なんだと思っているのよ？」"}],"source":"egs","sourceCharacterId":"18966","sourceWorkId":"10204","spoiler":false},{"segments":[{"spoiler":false,"text":"～ツンデレ強気メイド～"},{"spoiler":false,"text":"活発で面倒見がよく、さっぱりした性格で、"},{"spoiler":false,"text":"男女問わず人気があるクラスメイトの少女。"},{"spoiler":false,"text":"家の借金を少しでも減らすため、新聞配達のバイトをしていた。"},{"spoiler":false,"text":"バイト後、急いで学校に向かっている途中で俊哉とぶつかったことが、"},{"spoiler":false,"text":"彼女の人生のターニングポイントだったのかもしれない。"},{"spoiler":false,"text":"「ちょっとあんた。あたしのこと、一体なんだと思っているのよ？」"}],"source":"bangumi","sourceCharacterId":"114116"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf02a39128f2a95bd8ea8829a010c543b47f6e479e0818cc602bd9b750abc5ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1f0c2313c337dd03f004fa8c1755489670b25ee555772d85d9dba355bf11cce.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222119:114116:5890:1","source":"bangumi"}]},{"characterId":"char_c869","characterName":"空・スピットファイア","sourceIds":{"bangumi":[{"characterId":"114117","match":"exact-nor