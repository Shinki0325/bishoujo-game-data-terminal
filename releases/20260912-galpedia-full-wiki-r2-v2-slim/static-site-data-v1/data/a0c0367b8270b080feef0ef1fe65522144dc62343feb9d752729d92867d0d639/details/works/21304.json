n-staff:115521","source":"vndb"},{"creditedName":"kato.yoshihal","creatorId":"vndb:s5412","sourcePersonId":"vndb:s5412","canonicalEntityId":"vndb:s5412","name":"加藤 義治","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:115522","source":"vndb"},{"creditedName":"MUGICHA","creatorId":"vndb:s9181","sourcePersonId":"vndb:s9181","canonicalEntityId":"vndb:s9181","name":"MUGICHA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:115523","source":"vndb"}]},"cast":[{"characterId":"char_c29346","characterName":"花菱 ほのか","sourceIds":{"bangumi":[{"characterId":"31139","match":"exact-normalized-name-in-linked-work","subjectId":"118104"}],"egsCharacterIds":["5831"],"vndbCharacterId":"c29346"},"originalCharacterName":"花菱 ほのか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"剣二と同じ、魔法使いの里出身の少女。"},{"spoiler":false,"text":"先祖代々、大きな魔力を受け継ぐ一族の娘で、里の中でも誰にも負けない魔力を持つ。"},{"spoiler":false,"text":"それ故に里の中での扱いも特別で、生まれながらにして皆から注目を受ける立場にいる人。"},{"spoiler":false,"text":"しかしその魔力を満足に使いこなすことが出来ず、里では\"落ちこぼれ\"と揶揄されている。"},{"spoiler":false,"text":"それが原因で彼女は里から家出。"},{"spoiler":false,"text":"一般社会へと逃げ出し、それが今回の騒動の発端となる。"},{"spoiler":false,"text":"性格は、一言で言って「負けず嫌い」。"},{"spoiler":false,"text":"だが心の底からそうというわけではなく、どこか強がって強い自分を演じているようなところがある。故によくボロもでたりする。ツンツンしているように見えるが、実際はポーズだけという隠れ弱気な女の子。"},{"spoiler":false,"text":"剣二とは同門の弟子であり、一応彼女のほうが姉弟子。"},{"spoiler":false,"text":"しかし魔法使いとしての出来は剣二のほうが上のところもあり、彼に対してライバル意識と憧れの両方の感情を持っている。"}],"source":"egs","sourceCharacterId":"5831","sourceWorkId":"21304","spoiler":false},{"segments":[{"spoiler":false,"text":"剣二と同じ “魔法使いの里” 出身の少女。"},{"spoiler":false,"text":"先祖代々大きな魔力を受け継ぐ一族の娘で、里では誰にも負けない魔力を持っている。"},{"spoiler":false,"text":"しかしその魔力を満足に使いこなすことができず、落ちこぼれ と揶揄されてきた。"},{"spoiler":false,"text":"性格はとにかく負けず嫌いで、強い自分を演じるものの、よくボロを出してしまう。"},{"spoiler":false,"text":"ツンツンしているように見えるが、実際はポーズだけという隠れ弱気な女の子。"},{"spoiler":false,"text":"剣二とは同門の弟子。 彼女のほうが姉弟子だが、魔法使いとしての出来は剣二のほうが上。"},{"spoiler":false,"text":"そんな剣二に対して、“ライバル意識” と “憧れ” の両方の感情を抱いている。"},{"spoiler":false,"text":"「心配してくれた気持ちは、う、嬉しいけど……。 その、私にも色々あるのよ！」"}],"source":"bangumi","sourceCharacterId":"31139"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"31139","value":"食べ歩き（主にお菓子類）"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"5831","sourceWorkId":"21304","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"5831","sourceWorkId":"21304","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"5831","sourceWorkId":"21304","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"5831","sourceWorkId":"21304","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"5831","sourceWorkId":"21304","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/006318646c4782a431bde65c96453a7153d8697c171af6f72b039dc8454bf558.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55d6aee9d7aa18af99528425555627a9f42bd12866311e8aff433bba9be9b350.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:118104:31139:5936:1","source":"bangumi"}]},{"characterId":"char_c29347","characterName":"黒木 綾芽","sourceIds":{"bangumi":[{"characterId":"31140","match":"exact-normalized-name-in-linked-work","subjectId":"118104"}],"egsCharacterIds":["5832"],"vndbCharacterId":"c29347"},"originalCharacterName":"黒木 綾芽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ほのかと同級生の、黒髪が美しい、中身も外見も清楚な女性。"},{"spoiler":false,"text":"家が神社であるため、その品行方正なところはは筋金入り。"},{"spoiler":false,"text":"性格的に非の打ちどころのない上に、年の割にグラマラス。そんな2つの要因があいまって、男子たちからの支持も高い。"},{"spoiler":false,"text":"なぜか小さな不運に見舞われることが多く、しょっちゅう何かのトラブルに巻き込まれている。"},{"spoiler":false,"text":"だが本人はそれを嫌だと思っておらず、「いつものことですから」と笑顔で乗り切っている。"},{"spoiler":false,"text":"困っている人を放っておけない性格で、そういった時ばかりは普段のおとなしさはどこへやら。"},{"spoiler":false,"text":"かなりの行動力を見せるなど、自己犠牲の精神に満ちあふれた大和撫子である。"}],"source":"egs","sourceCharacterId":"5832","sourceWorkId":"21304","spoiler":false},{"segments":[{"spoiler":false,"text":"ほのかの同級生。 黒髪が美しい、中身も外見も清楚な女の子。"},{"spoiler":false,"text":"家が神社であるため、その品行方正さは筋金入り。 非の打ちどころのない性格。"},{"spoiler":false,"text":"そのうえかなりグラマラスで、男子からの支持も高い。"},{"spoiler":false,"text":"普段はおとなしいが、困っている人を放っておけず、人助けの時にはかなりの行動力を見せる。"},{"spoiler":false,"text":"また小さな不運に見舞われることが多く、しょっちゅうトラブルに巻き込まれている。"},{"spoiler":false,"text":"だが当の本人は特に気にせず、「いつものことですから」 と笑顔で乗り切っている。"},{"spoiler":false,"text":"「私は剣二さんを信じます。 こう見えて人を見る目はあるんですよ？」"}],"source":"bangumi","sourceCharacterId":"31140"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"31140","value":"お団子づくり・食べること"},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"5832","sourceWorkId":"21304","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"5832","sourceWorkId":"21304","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"5832","sourceWorkId":"21304","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"5832","sourceWorkId":"21304","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"5832","sourceWorkId":"21304","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bff789ac09991b9c87d13140dd222e1d42e5430346ef03e67cbdffe6c071de9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc28386ece48263fbadd4361c4c2537af23fe29a5deab29302f73c859831b095.webp","width":144,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:118104:31140:5741:1","source":"bangumi"}]},{"characterId":"char_c29348","characterName":"如月・クレメンテス・七穂","sourceIds":{"bangumi":[{"characterId":"31141","match":"exact-normalized-name-in-linked-work","subjectId":"118104"}],"egsCharacterIds":["5833"],"vndbCharacterId":"c29348"},"originalCharacterName":"如月・クレメンテス・七穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"17"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく社交的なムードメーカー的な存在のほのかたちの同級生。いつも宇顔で転げまわっているような元気な女の子で、その外見とあいまって愛くるしいことこの上ない。"},{"spoiler":false,"text":"性格面は非常に快活なのだが、残念ながら天は二物を与えなかった。"},{"spoiler":false,"text":"人に好かれる性格なのだが、学生としては重要なオツムのほうが少々残念で、いつも試験前になると知恵熱を出して苦しんでいたり。だが、そんな時も彼女を助けてくれる人は多く、学生教職員のどちらからも愛されていたりする。"},{"spoiler":false,"text":"名前から見ても分かるとおり、日本人と外国人のダブル。"},{"spoiler":false,"text":"父方が北欧の方の出身で、彼女にもその血がしっかりと流れている。小さな頃は海外で暮らしていたが、ここ数年は日本で暮らしている。そのため見た目と裏腹に日本語が堪能で、日本人より日本人らしいところも。日本のことが大好きで、海外で暮らす両親に無理を言って日本で一人暮らしをしている、筋金入りの行動派。"},{"spoiler":false,"text":"今日も愛用のカメラ片手に街に繰り出している。"}],"source":"egs","sourceCharacterId":"5833","sourceWorkId":"21304","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく社交的で、人に好かれるムードメーカーな同級生。"},{"spoiler":false,"text":"いつも笑顔で元気がよく、その外見と相まって愛くるしいことこの上ない。"},{"spoiler":false,"text":"ただし、学生として重要なオツムのほうが少々残念。 試験前はいつも知恵熱を出している。"},{"spoiler":false,"text":"そんな時も彼女を助けてくれる人は多く、学生・教職員のどちらからも愛されている。"},{"spoiler":false,"text":"名前からも分かる通り、日本人と外国人のハーフ。 父方が北欧の出身。"},{"spoiler":false,"text":"現在は海外で暮らす両親に無理を言って、日本で一人暮らしをしている。"},{"spoiler":false,"text":"日本のことが大好きで、日本語も堪能。 日本人より日本人らしいところも。"},{"spoiler":false,"text":"今日も愛用のカメラを片手に街へ繰り出している。"},{"spoiler":false,"text":"「うんっ。 体を動かすのは好きかな。 だって汗かくと気持ちいいもんね♪」"}],"source":"bangumi","sourceCharacterId":"31141"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"31141","value":"料理"},{"label":"胸围（本版本）","value":"80 cm",