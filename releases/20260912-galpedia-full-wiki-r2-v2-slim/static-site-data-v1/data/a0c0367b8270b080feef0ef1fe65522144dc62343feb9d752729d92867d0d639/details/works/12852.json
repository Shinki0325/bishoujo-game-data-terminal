ドル的存在。"},{"spoiler":false,"text":"大人しめで清楚、お淑やかな性格だが、ほんのちょっとヤキモチ焼き。優莉とは大の仲良し。"},{"spoiler":false,"text":"その優莉（と徹）が誘ってくれた旅行に潤一とともに参加することに。"},{"spoiler":false,"text":"場面場面で潤一の事に好意を持っているのではないかと思わせるような態度をとるが、そのたびに邪魔が入ってしまいなかなか前に進むことができない。"},{"spoiler":false,"text":"お化け、幽霊などオカルト関係は大の苦手。"}],"source":"egs","sourceCharacterId":"14716","sourceWorkId":"12852","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"14716","sourceWorkId":"12852","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"14716","sourceWorkId":"12852","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"14716","sourceWorkId":"12852","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b2cf724e10bfbc6d8ed0cb335cbcde21581d7a7fb561fabd344dbaaab673b02.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/318f35097a789c43533f92349256e8590f94b75aa258e1593d5997eb47491a34.webp","width":256,"height":249,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16354:219493:4810:1","source":"bangumi"}]},{"characterId":"char_c33629","characterName":"雪谷 綾香","sourceIds":{"bangumi":[{"characterId":"219496","match":"exact-normalized-name-in-linked-work","subjectId":"16354"}],"egsCharacterIds":["14717"],"vndbCharacterId":"c33629"},"originalCharacterName":"雪谷 綾香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"hip