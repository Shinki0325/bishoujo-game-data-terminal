{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6388","model":{"presentationWorkId":"vndb:v5069","staff":{"artwork":[{"creditedName":"久遠路火鷹(天人)","creatorId":"vndb:s2473","sourcePersonId":"egs:creator:3516","canonicalEntityId":"vndb:s2473","name":"久遠路火鷹(天人)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:12165","source":"egs"}],"scenario":[{"creditedName":"カリート・クール","creatorId":"vndb:s6724","sourcePersonId":"egs:creator:3823","canonicalEntityId":"vndb:s6724","name":"カリート・クール","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13743","source":"egs"}],"music":[{"creditedName":"CHRIS","creatorId":"vndb:s3180","sourcePersonId":"egs:creator:5037","canonicalEntityId":"vndb:s3180","name":"CHRIS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:19899","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c10000","characterName":"友部繭美","sourceIds":{"bangumi":[{"characterId":"175627","match":"exact-normalized-name-in-linked-work","subjectId":"181336"}],"egsCharacterIds":["26199"],"vndbCharacterId":"c10000"},"originalCharacterName":"友部繭美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"旅館「由良屋」をきりもりする女将。"},{"spoiler":false,"text":"幼さを残す顔立ちながら、見事なボディ（爆乳）の持ち主。"},{"spoiler":false,"text":"夫に開発され緊縛の性癖に目覚めるも、その夫が他界してしまい欲求不満のご様子。"},{"spoiler":false,"text":"旅館の土産物の組紐細工をみるたびに股間を湿らせているらしい。"}],"source":"egs","sourceCharacterId":"26199","sourceWorkId":"6388","spoiler":false},{"segments":[{"spoiler":false,"text":"旅館の経営者である女将。"},{"spoiler":false,"text":"見た目には若く見えるが、１児の娘の母。"},{"spoiler":false,"text":"実は緊縛癖がある。"},{"spoiler":false,"text":"夫に緊縛プレイを開拓され、性的興奮を満たしていたが、"},{"spoiler":false,"text":"その夫が亡くなってからは欲求不満。"},{"spoiler":false,"text":"旅館内の特産品である組紐を見るたびに、股間を疼かせている。"}],"source":"bangumi","sourceCharacterId":"175627"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/1503c9bbfa7e8ccc7a5a75d101356b294e401be1a0c1fc7e4c8e3648eb844868.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a3d7051b5b54e41cff08ae2dd2def7ae9bd81366fd8c8e5c22cc19eb837cc51.webp","width":65,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181336:175627:4918:1","source":"bangumi"}]},{"characterId":"char_c9999","characterName":"友部 綾","sourceIds":{"bangumi":[{"characterId":"175628","match":"exact-normalized-name-in-linked-work","subjectId":"181336"}],"egsCharacterIds":["26200"],"vndbCharacterId":"c9999"},"originalCharacterName":"友部 綾","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"繭美のひとり娘。"},{"spoiler":false,"text":"勝気で、とっつき難さがある女の子。"},{"spoiler":false,"text":"幼い頃のトラウマから性的潔癖症になってしまっていたが、年頃になり身体が性を求めるようになると、そのトラウマと性的欲求との狭間で思い悩みながらも、いつしか「自縛」の性癖に目覚めてしまう。"}],"source":"egs","sourceCharacterId":"26200","sourceWorkId":"6388","spoiler":false},{"segments":[{"spoiler":false,"text":"繭美の娘。"},{"spoiler":false,"text":"少し気が強く、とっつきにくい感じがある。"},{"spoiler":false,"text":"幼い頃に両親のＳＥＸの声を聞いていたため性的潔癖症となる。"},{"spoiler":false,"text":"しかし、年頃になって湧いてくる性欲、"},{"spoiler":false,"text":"そして性的潔癖症であるが故の反動で、"},{"spoiler":false,"text":"自縛をする性癖に目覚めてしまっている。"}],"source":"bangumi","sourceCharacterId":"175628"}],"profile