onId":"vndb:vn-staff:10607","source":"vndb"}],"other":[{"creditedName":"シコルスキー","creatorId":"vndb:s7337","sourcePersonId":"egs:creator:9256","canonicalEntityId":"vndb:s7337","name":"シコルスキー","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:45170","source":"egs"},{"creditedName":"MOKA","creatorId":"vndb:s8200","sourcePersonId":"egs:creator:2315","canonicalEntityId":"vndb:s8200","name":"MOKA","detail":"プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71000","source":"egs"},{"creditedName":"新堂 真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:10604","source":"vndb"},{"creditedName":"とろ美","creatorId":"vndb:s5568","sourcePersonId":"vndb:s5568","canonicalEntityId":"vndb:s5568","name":"とろ美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:10609","source":"vndb"},{"creditedName":"MOKA","creatorId":"vndb:s8200","sourcePersonId":"vndb:s8200","canonicalEntityId":"vndb:s8200","name":"MOKA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10611","source":"vndb"}]},"cast":[{"characterId":"char_c12","characterName":"河井 空","sourceIds":{"bangumi":[{"characterId":"93641","match":"exact-normalized-name-in-linked-work","subjectId":"24817"}],"egsCharacterIds":["19239"],"vndbCharacterId":"c12"},"originalCharacterName":"河井 空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"引っ越し先のアパートの管理人で、1Fの喫茶店のマスター。"},{"spoiler":false,"text":"どう見ても男装の少女にしか見えない、イノセンスな魅力に、主人公はノックダウン。"},{"spoiler":false,"text":"夢は、大好きだった祖父が経営していた喫茶店を再開させ、昔のような楽しい憩いの場にしたいことらしいが……。"}],"source":"egs","sourceCharacterId":"19239","sourceWorkId":"9851","spoiler":false},{"segments":[{"spoiler":false,"text":"転校してきた主人公のアパートの管理人であり、下の喫茶店のマスター。"},{"spoiler":false,"text":"そして、主人公が一目惚れするショタッ娘ヒロイン。"},{"spoiler":false,"text":"どこからどうみても男装した女の子に見えるイノセントな魅力を持つ。"},{"spoiler":false,"text":"しかし、善良＋朴念仁な性格が災いするのか、口が先に出てしまうタイプで、それが元でトラブルになりやすい。"},{"spoiler":false,"text":"本人の夢は、祖父が経営していた喫茶店を再開させ、昔のように楽しい憩いの場所にしたいというもの。"},{"spoiler":false,"text":"両親は仕事の都合で長らく海外で暮らしていたため、育ててもらった喫茶店マスターだった祖父が大好きだった。"},{"spoiler":false,"text":"その祖父のためにも、閉店されている喫茶店を再開して、盛り立てようとがんばるのだが……!?"}],"source":"bangumi","sourceCharacterId":"93641"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/400e67f9829690f065e02fbe2b874bb4309b897f3fa0a1018db89229ad911d9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e28e2b1695e7b36b83f37184f09b111719270cbd0505fac3e64786fd6599f0c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24817:93641:5940:1","source":"bangumi"}]},{"characterId":"char_c58435","characterName":"河井 海","sourceIds":{"bangumi":[{"characterId":"93643","match":"exact-normalized-name-in-linked-work","subjectId":"24817"}],"egsCharacterIds":["19241"],"vndbCharacterId":"c58435"},"originalCharacterName":"河井 海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"空の双子の妹。正真正銘の女の子。"},{"spoiler":false,"text":"お兄ちゃん大好きっ子という、一見、善良そうな少女。"},{"spoiler":false,"text":"しかし、お兄ちゃん本位が極まっているため、空が良ければどんな悪徳でも平気で行う、ある意味、本作で一番恐ろしい娘である。"}],"source":"egs","sourceCharacterId":"19241","sourceWorkId":"9851","spoiler":false},{"segments":[{"spoiler":false,"text":"空の双子の妹。部活動が無いと喫茶店でアルバイトしている（本当はバイト料はいらないと言っているが、空が無理矢理渡すので、河井家の食費に変えている）。"},{"spoiler":false,"text":"お兄ちゃんが大好きという点では凄まじく善良だが、お兄ちゃん本位であるため、お兄ちゃんが良ければどんな悪徳でも平気で行う怖い娘。"}],"source":"bangumi","sourceCharacterId":"93643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f38d33230994e894b3464f191baf400f3bb84a7916f73a8fdb00f7db351a52c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec740019cebf8c29477325fdb2a50db5a6fff38c24736a4390b601ea1d0b0d36.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24817:93643:4810:1","source":"bangumi"}]},{"characterId":"char_c58436","characterName":"鴎屋 宙","sourceIds":{"bangumi":[{"characterId":"93642","match":"exact-normalized-name-in-linked-work","subjectId":"24817"}],"egsCharacterIds":["19240"],"vndbCharacterId":"c58436"},"originalCharacterName":"鴎屋 宙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"外食産業最大手・スワローJグループのご令嬢。"},{"spoiler":false,"text":"自分のパートナーを探していたおり、主人公と出会い、見初めたのだが、断られる。"},{"spoiler":false,"text":"そのことで、主人公をますます気に入ってしまった彼女は、グループの力を使って引っ越し先を割り出し、空に宣戦布告するため、アパートに越してくる。"},{"spoiler":false,"text":"そんな宙には、とある秘密があるのだが……。"}],"source":"egs","sourceCharacterId":"19240","sourceWorkId":"9851","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が以前暮らしていた街で出会った女の子。"},{"spoiler":false,"text":"その正体は外食産業最大手スワローJグループの令嬢であった。"},{"spoiler":false,"text":"自分のお眼鏡にかなうパートナーを探して、アルバイト店員の真似をしているとき、見初めたのが、主人公であった。"},{"spoiler":false,"text":"だが、主人公は目立つのを嫌って、オファーを拒否。"},{"spoiler":false,"text":"今までそういうことをされたことがなかった宙は、ますます主人公に熱を上げてしまい、耐えきれなくなった主人公は、逃亡。"},{"spoiler":false,"text":"空のアパートに引っ越してきたのである。"},{"spoiler":false,"text":"スワローJグループの力を使い、主人公の居場所を把握した宙は、空に宣戦布告！"},{"spoiler":false,"text":"しかし宙には、ある秘密が存在するのだが……!?"}],"source":"bangumi","sourceCharacterId":"93642"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c58436","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"19240","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"19240","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"93642","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c1ee0687518b6d3c2c583c9a017819f1d17a8fb06371601b2aa198bbea5865b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39a5a6f8f840a3d96ca40b251f700af63fd3793840887b4f75a4fc136dd09666.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24817:93642:6166:1","source":"bangumi"}]},{"characterId":"char_vndb_c58437","characterName":"橋田 陸","sourceIds":{"vndbCharacterId":"c58437"},"originalCharacterName":"橋田 陸","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0a2b6761b9e69aaebf0221f6558235afc