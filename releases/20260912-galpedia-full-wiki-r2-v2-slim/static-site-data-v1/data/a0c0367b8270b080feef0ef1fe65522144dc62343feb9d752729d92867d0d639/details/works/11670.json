"グリモワール帝国の王子である主人公から言い寄られているが、内心、非常に迷惑しているようだ。"},{"spoiler":false,"text":"流石に婚前交渉はなく、処女。"}],"source":"egs","sourceCharacterId":"16111","sourceWorkId":"11670","spoiler":false},{"segments":[{"spoiler":false,"text":"ハムナート王国のプリンセス。"},{"spoiler":false,"text":"気品溢れる美貌の持ち主で、グラマラスボディの持ち主。"},{"spoiler":false,"text":"小国とはいえ王国のプリンセスであるため、プライドが高く気が強い。"},{"spoiler":false,"text":"自分の立場を十分理解しているが、政略結婚については割り切れなさを感じており、ナーバスになっている。"},{"spoiler":false,"text":"自分に言い寄ってくるビクトルをそれとなくあしらっているが、内心ではかなり辟易している。"}],"source":"bangumi","sourceCharacterId":"52454"}],"profileFacts":[{"label":"年龄（本版本）","value":"20 岁","valueContext":null,"source":"egs","sourceCharacterId":"16111","sourceWorkId":"11670","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"16111","sourceWorkId":"11670","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"16111","sourceWorkId":"11670","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"16111","sourceWorkId":"11670","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"16111","sourceWorkId":"11670","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e63259d89de9ffc41217951b15661b756f2a59c26d7d4249e0a920d51d95efc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2a814c8b3819ccc244eb6f54b90263ef4b390ea6e18f34186b2289116512389.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211395:52