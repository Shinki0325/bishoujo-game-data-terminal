{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17242","model":{"presentationWorkId":"vndb:v12931","staff":{"artwork":[],"scenario":[{"creditedName":"四頭","creatorId":"vndb:s14407","sourcePersonId":"egs:creator:23240","canonicalEntityId":"vndb:s14407","name":"四頭","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:147270","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c16738","characterName":"檜生原 雫","sourceIds":{"vndbCharacterId":"c16738"},"originalCharacterName":"檜生原 雫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hisahara is a student who always achieve very high scores. She knows the protagonist when he delivers her homework as she was sick. They became friends, then soon afterwards move to a prestigious high school in Tokyo because their school was damaged by fire. Here, however, they are required to attend training for an unique program called \"naked school\". Since then, Hisahara has to engage in so many embarrassing situations. The protagonist sometimes helps her, sometimes is the one who create these situations (following teacher's instruction). The training brought them close together, and changed their relationship forever."}],"source":"vndb","sourceCharacterId":"c16738"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/aca9c71e3f846f0aa2a1abcd9508f7a9b73682df5285fbeb30e244c189fc9b0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54dc445513130483cb971b72a8fba4d85b89a9795cef6466be55b053