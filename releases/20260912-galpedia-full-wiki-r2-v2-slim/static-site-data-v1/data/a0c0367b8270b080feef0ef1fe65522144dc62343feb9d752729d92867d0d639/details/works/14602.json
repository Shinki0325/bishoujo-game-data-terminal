制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:57496","source":"vndb"}]},"cast":[{"characterId":"char_c10563","characterName":"千曲 一樹","sourceIds":{"bangumi":[{"characterId":"12142","match":"exact-normalized-name-in-linked-work","subjectId":"14117"}],"egsCharacterIds":["10978"],"vndbCharacterId":"c10563"},"originalCharacterName":"千曲 一樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公で見た目はごく普通の学生。"},{"spoiler":false,"text":"かなりのラーメン好きで “ラーメンは週三回まで” と自制しないと主食にしてしまうほど。"},{"spoiler":false,"text":"カップラーメンはラーメンとは認めておらず、食べようとも思わない。"},{"spoiler":false,"text":"コミュニス内のコミュニティ 『人間失格』 に登録していて、登録者の中では古株に入る。"},{"spoiler":false,"text":"『人間失格』 管理者のツクヨミとは直接会ったことはないけどメル友。"}],"source":"egs","sourceCharacterId":"10978","sourceWorkId":"14602","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的主人公，看上去是个极为普通的学生。"},{"spoiler":false,"text":"非常喜欢吃拉面，如果不用 “一周只能吃三次拉面”来控制他的话，他绝对会把拉面当成主食。"},{"spoiler":false,"text":"不承认泡面也是拉面的一种，想都没想过要去吃泡面。"},{"spoiler":false,"text":"在communis中的『人間失格』团体里算是老油条了。"},{"spoiler":false,"text":"和『人間失格』的管理员ツクヨミ虽然没见过面，却是关系不错的网友。"},{"spoiler":false,"text":"「饶了我吧。只要不迟到，卡着时间起床不就好了」"}],"source":"bangumi","sourceCharacterId":"12142"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/654748a48e21f535c31e64e054e4a424d7331078cdc80133ab819df2ba505b6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b5bbb62fe622f49f12c2181e7e0ed9112ee353e15e1fa227bff7bdc0cc10054.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c10564","characterName":"国村 古都音","sourceIds":{"bangumi":[{"characterId":"12136","match":"exact-normalized-name-in-linked-work","subjectId":"14117"}],"egsCharacterIds":["10976"],"vndbCharacterId":"c10564"},"originalCharacterName":"国村 古都音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園では会長を務め、聡明で教員・学生を問わず人望がある。"},{"spoiler":false,"text":"勉強は得意で運動も苦手ではないという、まさに “才色兼備” なすごい人。"},{"spoiler":false,"text":"にも関わらず何故か 『人間失格』 に登録しており、人に言えない何かがあるもよう。"}],"source":"egs","sourceCharacterId":"10976","sourceWorkId":"14602","spoiler":false},{"segments":[{"spoiler":false,"text":"天资聪颖，担任学园的会长。在学生和教师中都很有人望。"},{"spoiler":false,"text":"学习和运动都能得心应手，正是所谓“才色兼備”的强人。"},{"spoiler":false,"text":"但是不知为何却登录了 『人間失格』团体，好像有着不为人知的一面。"},{"spoiler":false,"text":"「接下来要开会，没什么时间……你想说什么？」"}],"source":"bangumi","sourceCharacterId":"12136"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7c7ead431ef18300c88b28c5842d5c2df85c484857c5081993fc7968b678cb2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/176ecc92093587ce67ff5ca4b60807c1d98413db6a21d1506b110185f71ef05f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14117:12136:6016:1","source":"bangumi"}]},{"characterId":"char_c10565","characterName":"星宮 美悠","sourceIds":{"bangumi":[{"characterId":"12138","match":"exact-normalized-name-in-linked-work","subjectId":"14117"}],"egsCharacterIds":["10977"],"vndbCharacterId":"c10565"},"originalCharacterName":"星宮 美悠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一樹の同い年の幼なじみで、明るく非常に面倒見がいい。"},{"spoiler":false,"text":"学力や授業態度は普通で平均的。"},{"spoiler":false,"text":"実は両親とも入院中で、新聞配達をして生活の足しにしつつ両親の介護や学園生活をこなしている頑張り屋。"}],"source":"egs","sourceCharacterId":"10977","sourceWorkId":"14602","spoiler":false},{"segments":[{"spoiler":false,"text":"和一樹同岁的青梅竹马，性格活泼开朗，无微不至地照顾他人。"},{"spoiler":false,"text":"学习成绩和学习态度都很普通。"},{"spoiler":false,"text":"实际上，父母都在住院中，自己一边靠送报纸维持生计一边照顾父母，并坚持上学的努力者。"},{"spoiler":false,"text":"「我一点也不伟大，真的。只是不这样做不行罢了」"}],"source":"bangumi","sourceCharacterId":"12138"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c46dc9dcb1d9388d8835911b04ba8fb6b14ed53bfe10d6933cdbcef1e8590f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29da77b3214191bf24a3addef080272f89de8ea91844a5364a715a995779c351.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大咲茉菜","creatorId":"vndb:s27","sourcePersonId":"vndb:s27","canonicalEntityId":"vndb:s27","name":"大咲 茉菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14117:12138:19137:1","source":"bangumi"}]},{"characterId":"char_c10566","characterName":"南條 怜奈","sourceIds":{"bangumi":[{"characterId":"12140","match":"exact-normalized-name-in-linked-work","subjectId":"14117"}],"egsCharacterIds":["10979"],"vndbCharacterId":"c10566"},"originalCharacterName":"南條 怜奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園にいる間は常に、授業中も保健室で過ごしている。"},{"spoiler":false,"text":"しかし成績は学年トップクラス。"},{"spoiler":false,"text":"とにかく人との接触を避け、会話の際も相手の目を見て話すことはしない。"},{"spoiler":false,"text":"また、できるだけ早く会話を打ち切ろうとするためあまり長くはしゃべらず、言い方もぞんざいに……。"}],"source":"egs","sourceCharacterId":"10979","sourceWorkId":"14602","spoiler":false},{"segments":[{"spoiler":false,"text":"包括上课的所有学院生活几乎都是在保健室度过。"},{"spoiler":false,"text":"但是却就读于全校的尖子生班。"},{"spoiler":false,"text":"避免与人的接触，对话时也从不直视对方的眼睛。"},{"spoiler":false,"text":"而且，总是很快结束对话，因此说话很短，说话方式也很随便……"},{"spoiler":false,"text":"「没事的话就出去。保健室是我的房间。」"}],"source":"bangumi","sourceCharacterId":"12140"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adc18fa0eda0be64ae9614aee69fd3e423c3d6002537abb6e320c0b11d7b59ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e8f3568629a5ce660e66cd0a7121d0fb1486949a8eb0996f7fa50988d2fe99c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田ゆきえ","creatorId":"vndb:s790","sourcePersonId":"vndb:s790","canonicalEntityId":"vndb:s790","name":"前田 ゆきえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14117:12140:3952:1","source":"bangumi"}]},{"characterId":"char_vndb_c10567","characterName":"各務原 いつは","sourceIds":{"vndbCharacterId":"c10567"},"originalCharacterName":"各務原 いつは","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90501a52f4839955c5b3f64a9a9d67fc3e1d2588ff389aa1d651865ce3f8c2bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/471d4f0f6b60ea48b49203379c123eac0f3221ae9248989898a61b69e1ee4682.webp","width":238,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田 まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","ro