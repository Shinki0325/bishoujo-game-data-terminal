し込むが、主人公が夢妃に片想いしてることから断られ、その嫉妬から夢妃を憎悪するようになる。"}],"source":"egs","sourceCharacterId":"24892","sourceWorkId":"8326","spoiler":false},{"segments":[{"spoiler":false,"text":"普通の学生として暮らしているが、実は人造人間。創造者の命を受けて、天使である夢妃を監視している。"},{"spoiler":false,"text":"達也と同じ学園で、同じ剣道部に所属。達也や夢妃よりも学年はひとつ下の後輩である。"},{"spoiler":false,"text":"表面的には気さくでほがらかだが、内面的には非常にネガティブ。とても純粋で思いこみが激しい。"},{"spoiler":false,"text":"創造者に愛されなかったので、劣等感が強く、愛情に飢えている。"}],"source":"bangumi","sourceCharacterId":"99916"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"24892","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"24892","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"24892","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"24892","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"24892","sourceWorkId":"8326","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3099fe13e5420b8a810b9a56e08eb81c5cee4def916c39be407846c10dbaa0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec1cbcb8f00849715a5271a6b7e5c4db5cef40952314db0b12b7e1a16b008498.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南川のりこ","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:347696:99916:20327:1","source":"bangumi"}]},{"characterId":"char_c44544","characterName":"ミネット","sourceIds":{"bangumi":[{"characterId":"99914","match":"exact-normalized-name-in-linked-work","subjectId":"347696"}],"egsCharacterIds":["24893"],"vndbCharacterId":"c44544"},"originalCharacterName":"ミネット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ドクトルの空中要塞を守る魔族の戦士。人造人間。"},{"spoiler":false,"text":"幼い見た目と同様に性格も子供っぽく、戦士ながら内気で主体を持たない大人しい性格。また依存心が強く、優しく頼れる存在を求めている。"},{"spoiler":false,"text":"研究所で働く人間たちと親しくしており、人間には好意的な印象を持っている。"},{"spoiler":false,"text":"それゆえ、ドクトルの世界征服の野望には否定的。"}],"source":"egs","sourceCharacterId":"24893","sourceWorkId":"8326","spoiler":false},{"segments":[{"spoiler":false,"text":"魔族の戦士。魔族の移動要塞を守っている。巨大な笛「ネファーリウス・オーメン」の使い手。"},{"spoiler":false,"text":"非力だが、この笛のメロディで下級の魔物を操ったり、音波攻撃をしかけたりする。"},{"spoiler":false,"text":"非常に内気で主体性がなく子供っぽい性格で、優しく頼れる者を強く求めている。"},{"spoiler":false,"text":"仲良くなると、ぴったりくっついて明るく話しかけてくる。"}],"source":"bangumi","sourceCharacterId":"99914"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"24893","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"24893","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"24893","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"49 cm","valueContext":null,"source":"egs","sourceCharacterId":"24893","sourceWorkId":"8326","sourceField":null,"scoped":true}],"metadat