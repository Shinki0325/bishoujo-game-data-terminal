xt":"ゆえに彼女の思いのままに動かすことができ、身体のなかに収納することもできる。"},{"spoiler":false,"text":"先端には鋭いキバのはえた口があり、多彩な使い方ができる。自尊心が高く、ひがみ根性が強い。"},{"spoiler":false,"text":"野性的でシブみのきいたカッコイイお姉さんだが、実はかなりおっちょこちょいで愛嬌がある。"}],"source":"bangumi","sourceCharacterId":"99915"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"24894","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"24894","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"24894","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"24894","sourceWorkId":"8326","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"24894","sourceWorkId":"8326","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abbfc034e74d27a026513421b7f8a3a4b0b352df331d92c4b0584b52792e765e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21cd8da3c36ad35bd3a661d48c2d471037c6671b8577f2513c84a04998ee4f44.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:347696:99915:5669:1","source":"bangumi"}]},{"characterId":"char_vndb_c44541","characterName":"牧之瀬 達也","sourceIds":{"vndbCharacterId":"c44541"},"originalCharacterName":"牧之瀬 達也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"so