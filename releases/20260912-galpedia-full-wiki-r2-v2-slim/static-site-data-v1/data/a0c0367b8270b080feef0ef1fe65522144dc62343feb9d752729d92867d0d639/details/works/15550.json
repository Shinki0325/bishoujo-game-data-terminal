:{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/815c84daa2dafd634f5bc0024bfa4647e57f2bdc3365d86c83ba9bf1469b4bed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7b702b4eb242c5dee63a50d8dfe11bd7e29ed66cc65adf423d0c4260732659d.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19170:44373:6351:1","source":"bangumi"}]},{"characterId":"char_c21892","characterName":"御厨 左姫","sourceIds":{"bangumi":[{"characterId":"44376","match":"exact-normalized-name-in-linked-work","subjectId":"19170"},{"characterId":"44376","match":"exact-normalized-name-in-linked-work","subjectId":"30484"}],"egsCharacterIds":["9246"],"vndbCharacterId":"c21892"},"originalCharacterName":"御厨 左姫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シンイチの双子の妹ギャーギャーうるさい方。"},{"spoiler":false,"text":"許嫁の件でシンイチにいろいろアドバイスをするが無茶ぶりが多く、アドバイスになっていない。"},{"spoiler":false,"text":"どちらかというと、この状況を楽しんでいる。"},{"spoiler":false,"text":"少しずる賢いところがある。"},{"spoiler":false,"text":"生意気で元気いっぱいの女の子。"}],"source":"egs","sourceCharacterId":"9246","sourceWorkId":"15550","spoiler":false},{"segments":[{"spoiler":false,"text":"種族「女神」"},{"spoiler":false,"text":"シンイチの双子の妹ギャーギャーうるさい方。"},{"spoiler":false,"text":"正体は女神様だが、現在はある事情で身長30ｃｍの妖精に。"}],"source":"egs","sourceCharacterId":"9246","sourceWorkId":"16314","spoiler":false},{"segments":[{"spoiler":false,"text":"慎一の双子の妹のギャーギャーうるさいほう。"},{"spoiler":false,"text":"許嫁の件で慎一に的外れなアドバイスをしては、苦悩する慎一を見て楽しんでいる小生意気な妹。"},{"spoiler":false,"text":"しかし、稀に的を射た発言をすることも。"},{"spoiler":false,"text":"とにかく元気で、見た目モンスターなナージャたちに対しても物怖じしない。"},{"spoiler":false,"text":"むしろ、家の中が人外だらけのこの状況を楽しんでいるようだ。"},{"spoiler":false,"text":"正体は女神様だが、現在はある事情で身長30cmの妖精に。"},{"spoiler":false,"text":"「にーーーちゃーーーんっ！　たいへん！　たいへん！　マジたいへんだーーーっ！」"}],"source":"bangumi","sourceCharacterId":"44376"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"9246","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"9246","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"9246","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"9246","sourceWorkId":"15550","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1a0f4f18d69a5f72b3dae841b87b0484f42d79ed80000e74bfb01274222fb5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b53c52c161d77d986be488e74034bd8446051091d88ea05003b9ac2a1d4903e9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平田由季","creatorId":"vndb:s899","sourcePersonId":"vndb:s899","canonicalEntityId":"vndb:s899","name":"佐藤千幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19170:44376:5501:1","source":"bangumi"}]},{"characterId":"char_c21894","characterName":"御厨 右姫","sourceIds":{"bangumi":[{"characterId":"44377","match":"exact-normalized-name-in-linked-w