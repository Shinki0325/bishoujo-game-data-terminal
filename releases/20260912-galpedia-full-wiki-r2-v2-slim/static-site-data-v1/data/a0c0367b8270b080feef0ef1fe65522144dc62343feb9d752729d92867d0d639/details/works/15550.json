ndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メシエ神聖連合王国の重聖騎士。"},{"spoiler":false,"text":"魔族の軍団を率いる魔王を倒す使命を帯びており、異世界からナージャを追ってきた。"},{"spoiler":false,"text":"ナージャとシンイチが結婚して、帝国にシンイチの父が取りこまれるのを恐れ、自分がシンイチと結婚しようとする。"},{"spoiler":false,"text":"もし結婚できなかったら、“聖なる絶滅手榴弾”を使い、人類すべてを神の御許に送る（人類を滅ぼす）と言っている。"},{"spoiler":false,"text":"性格はまっすぐで、何かに本気になると他のことが何も見えなくなってしまう。"},{"spoiler":false,"text":"ものすごく騙されやすいタイプで、他のヒロインたちからよく騙されている。"}],"source":"egs","sourceCharacterId":"9252","sourceWorkId":"15550","spoiler":false},{"segments":[{"spoiler":false,"text":"種族「ケンタウロス」"},{"spoiler":false,"text":"性格はまっすぐで、何かに本気になると他のことが何も見えなくなってしまう。"},{"spoiler":false,"text":"ものすごく騙されやすいタイプで、他のヒロインたちからよく騙されている。"}],"source":"egs","sourceCharacterId":"9252","sourceWorkId":"16314","spoiler":false},{"segments":[{"spoiler":false,"text":"メシエ神聖連合王国の重聖騎士。"},{"spoiler":false,"text":"因縁の相手であるナージャを倒すべく、同じく異世界からやってきた人馬娘。"},{"spoiler":false,"text":"帝国が力をつけるのを防ぐため、自分が慎一と結婚しようとする。"},{"spoiler":false,"text":"性格は真っ直ぐで、本気になると周りが見えなくなるタイプ。"},{"spoiler":false,"text":"当然ナージャとは犬猿の仲。"},{"spoiler":false,"text":"非常に騙されやすく、間違った情報をよく鵜呑みにする。ある意味ナージャよりも始末に負えない存在。"},{"spoiler":false,"text":"「だが、そうはさせぬ！　貴様とナージャは結婚させぬ！　もし結婚するというのなら、この世界は滅ぼす！」"}],"source":"bangumi","sourceCharacterId":"44371"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"44371","value":"半人马"},{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"9252","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"9252","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"9252","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"9252","sourceWorkI