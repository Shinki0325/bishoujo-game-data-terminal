。"},{"spoiler":false,"text":"他のヒロインたちを騙したり意地悪したりして、シンイチの家で過ごす。"}],"source":"egs","sourceCharacterId":"9250","sourceWorkId":"16314","spoiler":false},{"segments":[{"spoiler":false,"text":"南極に存在する、機械帝国アモルファスの王族機械。"},{"spoiler":false,"text":"許嫁として 《42》 と共にはるばる慎一のもとへやって来た。"},{"spoiler":false,"text":"可愛い外見に似合わず、性悪でいじわるで毒舌。言葉使いだけは丁寧。"},{"spoiler":false,"text":"他の許嫁たちを出し抜くために、常に謀略を重ねる策士。"},{"spoiler":false,"text":"結婚できない場合は、南極の氷をすべて溶かし人類を滅ぼすと言っている。"},{"spoiler":false,"text":"王族機械としての誇りがあるらしく、“ロボット” と言われると怒る。"},{"spoiler":false,"text":"「はい、ごゆるりとお考えを。しかし、いかな選択が論理的か、答えはただ一つだけでしょう」"}],"source":"bangumi","sourceCharacterId":"44372"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"44372","value":"机械"},{"label":"胸围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"9250","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"140 cm","valueContext":null,"source":"egs","sourceCharacterId":"9250","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"9250","sourceWorkId":"15550","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"9250","sourceWorkId":"15550","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d3e62a1688b87c322d32e0e67b3bc1701c6933d3c64880d182787f1630e44bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57fa8ec0263f9a008acdd96d0a637722c01cde5dce94c754da1ca3b7153e70dc.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田依子","creatorId":"vndb:s797","sourcePersonId":"vndb:s797","canonicalEntityId":"vndb:s797","name":"永田依子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19170:44372: