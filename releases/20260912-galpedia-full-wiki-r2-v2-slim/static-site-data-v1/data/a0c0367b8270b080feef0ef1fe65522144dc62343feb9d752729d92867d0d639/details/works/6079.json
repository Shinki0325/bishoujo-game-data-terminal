nked-work","subjectId":"191112"}],"egsCharacterIds":["26441"],"vndbCharacterId":"c2224"},"originalCharacterName":"橘 紗雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"つばめの双子の妹。"},{"spoiler":false,"text":"優秀さは姉には及ばないものの、素直で他人に愛される温厚な性格から、周囲から可愛がられることが多い。"},{"spoiler":false,"text":"姉に対しても優しく振舞ったり、姉を立てようとするところも評価され、それが逆に姉妹の確執を深くする結果へと繋がってしまった。"}],"source":"egs","sourceCharacterId":"26441","sourceWorkId":"6079","spoiler":false},{"segments":[{"spoiler":false,"text":"被害者にして、この物語において最も輪姦される運命にある女性。"},{"spoiler":false,"text":"姉ほど優秀では無いが、何に対しても真摯に受け止めて素直な所が多い分、"},{"spoiler":false,"text":"姉よりも教師に可愛がられやすく、内申点なども高くつけられる事が多い。"},{"spoiler":false,"text":"努力も怠らないが、姉よりも天才肌で飲み込みが早い部分もある。"},{"spoiler":false,"text":"他人に愛されやすく、"},{"spoiler":false,"text":"また姉に対しても優しく振る舞ったり姉を立てようとしている所がある為、"},{"spoiler":false,"text":"ますます紗雪自身は周囲に評価される事となる。"},{"spoiler":false,"text":"それが逆に姉妹の確執を拡げていく原因にもなっている。"}],"source":"bangumi","sourceCharacterId":"63187"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac38b0c1ab6e5b0c7190f9d661ca5398ac4855482e29d3be8e1be0380d2f37e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f3fcd7dcaa59287e7676c1881964324dc2a50daf07bc4425b4ffab21ff2f833.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:191112:63187:5890:1","source":"bangumi"}]},{"characterId":"char_c2225","characterName":"柳生 衛","sourceIds":{"bangumi":[{"characterId":"64412","match":"exact-normalized-name-in-linked-work","subjectId":"191112"}],"egsCharacterIds":["26443"],"vndbCharacterId":"c2225"},"originalCharacterName":"柳生 衛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"紗雪の友人。"},{"spoiler":false,"text":"マイペースでおっとりした雰囲気の可愛らしい女の子。"},{"spoiler":false,"text":"事件が始まってから、様子がおかしくなった紗雪を心配し、相談に乗ろうとするが……。"}],"source":"egs","sourceCharacterId":"26443","sourceWorkId":"6079","spoiler":false},{"segments":[{"spoiler":false,"text":"紗雪の友人で、可愛らしい印象を与えるマイペースな娘。"},{"spoiler":false,"text":"事件が始まってからどこか元気の無い紗雪の事を心配している。"}],"source":"bangumi","sourceCharacterId":"64412"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1b2dd4da6f3e88e53ed37760baf02bebfc87ee198d2ec09c264a3d3486e172f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/378c00229b00690c51bcb62d60eec74b4f97dae0827b5c81c2713deef66f79bb.webp","width":110,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:191112:64412:4854:1","source":"bangumi"}]},{"characterId":"char_c2226","characterName":"橘 つばめ","sourceIds":{"bangumi":[{"characterId":"63974","match":"exact-normalized-name-in-linked-work","subjectId":"191112"}],"egsCharacterIds":["26442"],"vndbCharacterId":"c2226"},"originalCharacterName":"橘 つばめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生徒会副会長を務める紗雪の双子の姉。"},{"spoiler":false,"text":"仮面優等生で、常に他人を見下している歪んだ性格。"},{"spoiler":false,"text":"それは十数年間、他人の愛情が全て妹に注がれ、自分は愛されていない人間だと卑屈に思い込んでしまった結果であった。"},{"spoiler":false,"text":"そして、今回、愛する者を妹に奪われたことによって爆発し、復讐を強いる。"}],"source":"egs","sourceCharacterId":"26442","sourceWorkId":"6079","spoiler":false},{"segments":[{"spoiler":false,"text":"物語の発端である双子の姉。"},{"spoiler":false,"text":"仮面優等生で他人のほとんどを見下すという、"},{"spoiler":false,"text":"性格的に少し歪んだ部分を持ち合わせている。"},{"spoiler":false,"text":"努力家でもあり他人にそういった苦労の部分を見せないという所があるのだが、"},{"spoiler":false,"text":"それはすべて妹一人が周囲から愛されていると感じている為。"},{"spoiler":false,"text":"他人からの真剣な愛情を受けた事が無い為、十数年間かけて性格が歪んだ結果。"},{"spoiler":false,"text":"ただ、他人から見た時は仲の良い姉妹として映るよう、"},{"spoiler":false,"text":"注意を払って普段から接している。"}],"source":"bangumi","sourceCharacterId":"63974"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90bfa0ad5025a0e74cd1611a2091163530bd6083b878b5d04015a655d392a00e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15de20d8a6e83653e8bbd5cf65a81daa67d8691f2f03140d32270710df4ece88.webp","width":107,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:191112:63974:4675:1","source":"bangumi"}]},{"characterId":"char_vndb_c2227","characterName":"天草 時継","sourceIds":{"vndbCharacterId":"c2227"},"originalCharacterName":"天草 時継","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cd5c8112a635a73dd3879770645fefc1f10e5a2ad19933faaad32801a64a6a6.webp","fallback