r":false,"text":"クールな印象だが、決して魅せる戦いを忘れないパフォーマーでもある。"},{"spoiler":false,"text":"自分が戦う事によって誰かを楽しませる事が出来ることに喜びを感じている。"},{"spoiler":false,"text":"プロレスと父親を馬鹿にされるとブチ切れてしまい、典型的で圧倒的なパワーファイターになる。"}],"source":"egs","sourceCharacterId":"5896","sourceWorkId":"21386","spoiler":false},{"segments":[{"spoiler":false,"text":"クールな印象だが、魅せる戦いを忘れないパフォーマー。"},{"spoiler":false,"text":"「プロレスこそが最強である」 という亡き父の意思を継ぎ、それを証明するために学園で頂点を目指す。"},{"spoiler":false,"text":"相手の技を受けきって勝つという信条を持ち、必要以上の武器は使わずクリーンファイトを好むため、周囲からは “白のカリスマ” と呼ばれている。"},{"spoiler":false,"text":"自分が戦うことによって誰かを楽しませることができることに喜びを感じている。"},{"spoiler":false,"text":"しかしプロレスと父親を馬鹿にされるとブチ切れ、典型的で圧倒的なパワーファイターになる。"}],"source":"bangumi","sourceCharacterId":"61613"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"5896","sourceWorkId":"21386","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"5896","sourceWorkId":"21386","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"5896","sourceWorkId":"21386","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"5896","sourceWorkId":"21386","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6ee2339d761aeaea2a1a542d1ce440b52dbb6a28fa2f34b1f038206c40f0fb3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cab41b4cf116ee2927f1fae3283c070ba55504cefec01c82ca64151f32d29ce1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:240075:61613:592