性格で、男子学生から人気を集めている。"}],"source":"bangumi","sourceCharacterId":"44672"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd5ee78968e297920b9a9134bf3ae3fa7b40a35187d40a85195e6834ef2932b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab209586367e9068bec013ec738438679d3e29f617806906e675246959e4a49d.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"戸板優衣","creatorId":"vndb:s10510","sourcePersonId":"vndb:s10510","canonicalEntityId":"vndb:s10510","name":"戸板 優衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190559:44672:24908:1","source":"bangumi"}]},{"characterId":"char_c51311","characterName":"久代 姫夏","sourceIds":{"bangumi":[{"characterId":"44675","match":"exact-normalized-name-in-linked-work","subjectId":"190559"}],"egsCharacterIds":["11783"],"vndbCharacterId":"c51311"},"originalCharacterName":"久代 姫夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Romance, adventures, pizza"},{"spoiler":false,"text":"Dislikes: Animals (especially cats and dogs)"}],"source":"vndb","sourceCharacterId":"c51311"},{"segments":[{"spoiler":false,"text":"白隈学園3年。"},{"spoiler":false,"text":"ちょっぴり変わった先輩で『A-ken部』部長。"},{"spoiler":false,"text":"みんなで楽しむためなら、何でもやる。"},{"spoiler":false,"text":"『遊びは本気で』をモットーにしており、例えばそれが『恋愛』の場合、恋愛小説を大量に読破したり、考察を自分なりに解析したりと本格的。"},{"spoiler":false,"text":"新しいものは説明書を読破するタイプ。"},{"spoiler":false,"text":"そして自分で解説wikiを作るタイプ。"},{"spoiler":false,"text":"映画にハマり、即興で『A-ken部』を設立したが、割と長く続いている。"},{"spoiler":false,"text":"ゆりのとは家族ぐるみの深い付き合いがある親友で、困った時の相談役でもある。"}],"source":"egs","sourceCharacterId":"11783","sourceWorkId":"24021","spoiler":false},{"segments":[{"spoiler":false,"text":"ノリでA-ken部を設立した、ゆりのの親友。楽しいことのためならなんでもやる女の子で、変わり者として知られている。"}],"source":"bangumi","sourceCharacterId":"44675"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3f41ae73e32b0e4e497d7f08e0f576dfb61d204344849dcb40ee8b5405e5c1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a477f9957c00d6a81b2428bd039dd1c0eab0fe0735227a3c4e8628251b9125e9.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190559:44675:5741:1","source":"bangumi"}]},{"characterId":"char_c51312","characterName":"柳木原 翠","sourceIds":{"bangumi":[{"characterId":"44674","match":"exact-normalized-name-in-linked-work","subjectId":"190559"}],"egsCharacterIds":["11782"],"vndbCharacterId":"c51312"},"originalCharacterName":"柳木原 翠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Skills: Cleaning, cooking, doing laundry"},{"spoiler":false,"text":"Likes: Fluffy pets, being spoiled by her brother, pampering him as well"},{"spoiler":false,"text":"Dislikes: Sewing"}],"source":"vndb","sourceCharacterId":"c51312"},{"segments":[{"spoiler":false,"text":"体験留学制度を知り、霧ヶ峰へとやって来た太一の妹。"},{"spoiler":false,"text":"気配り上手なしっかり者で、兄にも普段は敬語を使う。"},{"spoiler":false,"text":"兄妹仲はとてもよく、兄にはいつも大きな愛を向けている。"},{"spoiler":false,"text":"兄もいずれ自分の元を離れ、運命の女性と結ばれるのだろうと考えると、少しやるせない気持ちになったりもする。"},{"spoiler":false,"text":"そのため、兄が他の女の子と仲良くしている場面を目撃すると大きなショックを受け、その日はやけに甘えてくるようになる。"},{"spoiler":false,"text":"時々それが過剰になったりもするが、太一も太一で妹にはド甘いため、端から見るとシスコンに見える。"}],"source":"egs","sourceCharacterId":"11782","sourceWorkId":"24021","spoiler":false},{"segments":[{"spoiler":false,"text":"兄を甘やかすことが大好きで、超ブラコンな主人公の妹。掃除や洗濯、料理などが得意で家庭的な女の子だが、裁縫だけは苦手。"}],"source":"bangumi","sourceCharacterId":"44674"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70ce65c3ef7cde97b829bcf9030cb2b0b3ff0e3bef234628fa34b482410d0a13.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f17b4bab3845e4f0e7acf0206a496f0e0d8aaf7e9a630050c68424ff5f16f765.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190559:44674:6509:1","source":"bangumi"}]},{"characterId":"char_c51313","characterName":"エミリア=カリモフ","sourceIds":{"bangumi":[{"characterId":"44673","match":"exact-normalized-name-in-linked-work","subjectId":"190559"}],"egsCharacterIds":["11781"],"vndbCharacterId":"c51313"},"originalCharacterName":"エミリア=カリモフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirm