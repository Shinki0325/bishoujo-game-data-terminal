,"fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7786529633c4d4167111745aefbf1250303be284eb106db8ed57dcb84b57e490.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"藤咲 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:165418:153775:6105:1","source":"bangumi"}]},{"characterId":"char_c6196","characterName":"林田 律子","sourceIds":{"bangumi":[{"characterId":"153779","match":"exact-normalized-name-in-linked-work","subjectId":"165418"},{"characterId":"153779","match":"exact-normalized-name-in-linked-work","subjectId":"165419"},{"characterId":"153779","match":"exact-normalized-name-in-linked-work","subjectId":"268532"}],"egsCharacterIds":["18908"],"vndbCharacterId":"c6196"},"originalCharacterName":"林田 律子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"閨の作法"},{"spoiler":false,"text":"数年前に主人公の父と電撃結婚した義母（父の後妻）にして、学校の担任教師。犬丸学園の陰の支配者。"},{"spoiler":false,"text":"戦国時代から続く武家の末裔で、天賦の才を持つ剣の達人。"},{"spoiler":false,"text":"不良共のリーダーだった主人公のチームを1日で壊滅させたという「伝説」を持つ。"}],"source":"egs","sourceCharacterId":"18908","sourceWorkId":"6913","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の担任で、英語教師。"},{"spoiler":false,"text":"学園の影の支配者にして、実践向け殺人術の使い手でもあるすごいお方。"},{"spoiler":false,"text":"当人曰く「模造刀だ」という日本刀を、常に持ち歩いているが、どうみても本物くさい。"},{"spoiler":false,"text":"葵と結婚した息子とイメージが重なる主人公を、あれこれ構いたがるのだが……。"}],"source":"egs","sourceCharacterId":"18908","sourceWorkId":"9488","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の担任で、英語教師。"},{"spoiler":false,"text":"学園の影の支配者にして、実践向け殺人術の使い手でもあるすごいお方。"},{"spoiler":false,"text":"当人曰く「模造刀だ」という日本刀を、常に持ち歩いているが、どうみても本物くさい。"},{"spoiler":false,"text":"葵と結婚した息子とイメージが重なる主人公を、あれこれ構いたがるのだが……。"}],"source":"egs","sourceCharacterId":"18908","sourceWorkId":"10317","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公達兄妹の義母（父の後妻）にして学校の英語担任教師。"},{"spoiler":false,"text":"眉目秀麗＆妙齢の美女で犬神学園の影の支配者。実家は戦国時代から続く武家の末裔で、小太刀二刀や棒手裏剣、素手での体術にも秀でた実践向け殺人術の使い手で剣の天才。"},{"spoiler":false,"text":"数年前に、妻に先立たれた主人公の父、矢嶋良一（やじまりょういち）と電撃結婚。若くして2児の母となる。"},{"spoiler":false,"text":"新婚当時、不良共のリーダーとして無類の強さを誇っていた主人公のチームを、単身で乗り込み一日で壊滅させるという「伝説」を持つ。"}],"source":"bangumi","sourceCharacterId":"153779"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab4f2513711d4186baa361bcb4ce01554aef0c8e648b0fa41b9ac0bea30e910b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43517080c925def01bf73fcafe80cc67a9cab9aa31505539820c6afa53fb6091.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:165418:153779:4832:1","source":"bangumi"}]},{"characterId":"char_vndb_c102465","characterName":"矢嶋 良吾","sourceIds":{"vndbCharacterId":"c102465"},"originalCharacterName":"矢嶋 良吾","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c13668","characterName":"祝 菜緒","sourceIds":{"vndbCharacterId":"c13668"},"originalCharacterName":"祝 菜緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileF