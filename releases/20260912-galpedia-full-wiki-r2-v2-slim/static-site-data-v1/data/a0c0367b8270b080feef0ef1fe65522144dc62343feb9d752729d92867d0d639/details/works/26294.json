0","canonicalEntityId":"vndb:s10670","name":"にぃ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:130288","source":"vndb"}]},"cast":[{"characterId":"char_c46471","characterName":"片倉 凪咲","sourceIds":{"bangumi":[{"characterId":"44260","match":"exact-normalized-name-in-linked-work","subjectId":"177079"},{"characterId":"44260","match":"exact-normalized-name-in-linked-work","subjectId":"234178"}],"egsCharacterIds":["8788"],"vndbCharacterId":"c46471"},"originalCharacterName":"片倉 凪咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園３年生ながら、祖父が興した老舗アパレル企業のデザイナーを務める。"},{"spoiler":false,"text":"業界では数十年に一人の天才として尊敬を集める存在。"},{"spoiler":false,"text":"その仕事ぶりは確かなものの、横暴ぶりを発揮する上司であり、秋人の父がアシスタントを務めていたが病気で休職した後、代わりのアシスタントが何人も辞めていった程。"},{"spoiler":false,"text":"時折酷く悲しい表情を見せ、秋人がアシスタントになってからは秋人とただ単に不満を晴らすためのセックスを繰り返していくが……。"}],"source":"egs","sourceCharacterId":"8788","sourceWorkId":"23454","spoiler":false},{"segments":[{"spoiler":false,"text":"虽是高中三年生，但在祖父创办的老店服装公司担任设计师的少女。"},{"spoiler":false,"text":"被业界称为数十年难得一见的天才，集万千宠爱于一身，而她的工作能力也确实厉害，蛮横。"},{"spoiler":false,"text":"秋人的父亲因病退休后，作为代替的助手也有几人辞职了。"},{"spoiler":false,"text":"时不时地会见到她十分悲伤是神情，而秋人作为助手所要做的，"},{"spoiler":false,"text":"只是为了消除她的不满而不断地和她滚床单。"},{"spoiler":false,"text":"「就因为你没本事，好歹在床上起点作用吧。」"}],"source":"bangumi","sourceCharacterId":"44260"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e1d33368ee742504a466eae68020df083858ab497b003fa29c5738c408d0af0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58e059b1e0f57c0f42ebd21d3fe4815d2e2bc3541a8d05932bbad4efd844058e.webp","width":109,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","c