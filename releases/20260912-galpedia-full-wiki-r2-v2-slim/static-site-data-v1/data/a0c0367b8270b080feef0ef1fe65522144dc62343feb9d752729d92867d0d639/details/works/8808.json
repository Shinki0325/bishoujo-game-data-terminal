d":"vndb:s1341","canonicalEntityId":"vndb:s1341","name":"加藤 恒太","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:12952","source":"vndb"}]},"cast":[{"characterId":"char_c35993","characterName":"伊藤 葉鵡","sourceIds":{"bangumi":[{"characterId":"144564","match":"exact-normalized-name-in-linked-work","subjectId":"26439"}],"egsCharacterIds":["22462"],"vndbCharacterId":"c35993"},"originalCharacterName":"伊藤 葉鵡","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"デコ・ロリ・長靴と三拍子（？）揃った少女。"},{"spoiler":false,"text":"主人公から“ハム助”“ハム公”“デコ助”などと呼ばれている。"},{"spoiler":false,"text":"感情、表情共に豊かで、新の強い頑張り屋さん。"},{"spoiler":false,"text":"……なのだが、子供なのでやっぱり泣き虫かも。"},{"spoiler":false,"text":"素足に長靴が彼女のデフォルトであり、屋内外問わず、長靴を脱ぐことはない。"},{"spoiler":false,"text":"テレビアニメ「ホスト☆聖夜」の大ファンで、DVDに録画した物を毎日見ている。"}],"source":"egs","sourceCharacterId":"22462","sourceWorkId":"8808","spoiler":false},{"segments":[{"spoiler":false,"text":"デコ。ロリ。はむちゃん。長靴。"},{"spoiler":false,"text":"主人公にハム助、ハム公、あるいはデコ助と呼ばれる。"},{"spoiler":false,"text":"テレビアニメ『ホスト☆聖夜』の大ファン。毎日毎日なぜ…？　とか思ったらDVDに録画してた。"},{"spoiler":false,"text":"感情、表情ともに豊かだが芯の強い頑張り屋さん。でもやっぱり子どもなので泣き虫。"},{"spoiler":false,"text":"素足に長靴が基本。なぜか長靴を脱がない（屋外は外履き用長靴、屋内は内履き用長靴）。"},{"spoiler":false,"text":"いつも、猫の「ながぐつ」といっしょ。"}],"source":"bangumi","sourceCharacterId":"144564"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7144a3c5f8b8e0cbc21f69c648c00a7bab35d1e6a7f23a03129113706eda4f80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa346662c1532c6a0af854b101a1c7c3d9e43b3c04ef1f74c4737858810d6565.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あおきさやか","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおきさやか(青木静香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:26439:144564:4869:1","source":"bangumi"}]},{"characterId":"char_c35995","characterName":"逢振 加愛","sourceIds":{"bangumi":[{"characterId":"144565","match":"exact-normalized-name-in-linked-work","subjectId":"26439"}],"egsCharacterIds":["22464"],"vndbCharacterId":"c35995"},"originalCharacterName":"逢振 加愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ハムの兄が残した借金を取り立てにやってくる、日本最大手消費者金融業者“鬼富士”の社長令嬢。"},{"spoiler":false,"text":"ハムの兄が立ち寄る可能性から、なんだかんだと伊藤家に居座り続けている。"},{"spoiler":false,"text":"“萩原龍人”“剣技獅堂”の二人のボディーガードを、"},{"spoiler":false,"text":"常に傍らに置いている。"}],"source":"egs","sourceCharacterId":"22464","sourceWorkId":"8808","spoiler":false},{"segments":[{"spoiler":false,"text":"日本最大手消費者金融（サラ金）業者、『鬼富士』社長令嬢。"},{"spoiler":false,"text":"父親より、ハムの兄がした借金の取立てを命じられる。"},{"spoiler":false,"text":"ハムの兄が立ち寄る可能性から、なんだかんだと伊藤家に居座ることに。"},{"spoiler":false,"text":"いつも左右を2人のボディガードに守られている。"},{"spoiler":false,"text":"サラ金、しかも取り立てという仕事については常々悩んでおり気持ちは複雑。"}],"source":"bangumi","sourceCharacterId":"144565"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/581df28a9b9b5e8062f07cd55e67683b6eeab58de76b043a253eb897c60769d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9962050210db40c93335a91e5830017a45dd5a18f263d13ed335be50232060c0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:26439:144565:4916:1","source":"bangumi"}]},{"characterId":"char_c35996","characterName":"御樋代 そあら","sourceIds":{"bangumi":[{"characterId":"144566","match":"exact-normalized-name-in-linked-work","subjectId":"26439"}],"egsCharacterIds":["22465"],"vndbCharacterId":"c35996"},"originalCharacterName":"御樋代 そあら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水を片時も手放さない、自称・家出少女。"},{"spoiler":false,"text":"今時の女子高生とは、ちょっと違った雰囲気を持っており、時折、えげつない言動をさらっと現わしたりすりことも。"},{"spoiler":false,"text":"毎日、伊藤家からどこかへ出かけていくが……？"}],"source":"egs","sourceCharacterId":"22465","sourceWorkId":"8808","spoiler":false},{"segments":[{"spoiler":false,"text":"家出少女（らしい）。"},{"spoiler":false,"text":"今時の女子高生ともちょっと違った雰囲気の少女。"},{"spoiler":false,"text":"ネット関連に傾倒しているのか、時折言動がさらっとえげつなかったりする。"},{"spoiler":false,"text":"伊藤家に出入りし、毎日どこかに出かけて行くが…？（本人は学校と主張）"},{"spoiler":false,"text":"いつも水をもっている。"}],"source":"bangumi","sourceCharacterId":"144566"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8ea8855e369f698bac4afdecb1a868c7a0a1f8870254a57b379da75ebecf6387.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/601cb45c2fcd1b050fdbd722586933778d5f0e461b0e059972cc70547fdef385.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:26439:144566:4830:1","source":"bangumi"}]},{"characterId":"char_c35997","characterName":"伊佐坂 以歩子","sourceIds":{"bangumi":[{"characterId":"144567","match":"exact-normalized-name-in-linked-work","subjectId":"26439"}],"egsCharacterIds":["22466"],"vndbCharacterId":"c35997"},"originalCharacterName":"伊佐坂 以歩子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"巨乳双子、和楓の妹。"},{"spoiler":false,"text":"家事、料理を得意とする、家庭的で優しいお姉さん。"},{"spoiler":false,"text":"おっとりしているように見えるが、深いところで思考するタイプなので、意外としたたかな面もある。"},{"spoiler":false,"text":"ちなみに、怒らせるととても怖い。"}],"source":"egs","sourceCharacterId":"22466","sourceWorkId":"8808","spoiler":false},{"segments":[{"spoiler":false,"text":"のどかの双子の妹。"},{"spoiler":false,"text":"いつも優しいお姉さん。家事や料理を得意とする家庭的な女性。"},{"spoiler":false,"text":"おっとりしているように見えるが、深いところで思考しているタイプの人物で、意外としたたかな面もある。"},{"spoiler":false,"text":"怒らせるととても怖い……？"}],"source":"bangumi","sourceCharacterId":"144567"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d000208d0f95372cf0018ab6178c6bd7a7d22cc6284d913c263e27725acb7388.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7616e1f2fa007ed12d9b14b866c76de78be12ff1b77f926bf3c5d31fe3209bd4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:26439:144567:6036:1","source":"bangumi"}]},{"characterId":"char_c35999","characterName":"伊佐坂 和楓","sourceIds":{"bangumi":[{"characterId":"144568","match":"exact-normalized-name-in-linked-work","subjectId":"26439"}],"egsCharacterIds":["22467"],"vndbCharacterId":"c35999"},"originalCharacterName":"伊佐坂 和楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metad