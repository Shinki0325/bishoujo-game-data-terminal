{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13344","model":{"presentationWorkId":"vndb:v2962","staff":{"artwork":[{"creditedName":"海苔餅太","creatorId":"vndb:s4086","sourcePersonId":"egs:creator:2068","canonicalEntityId":"vndb:s4086","name":"海苔餅太","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:87353","source":"egs"}],"scenario":[{"creditedName":"有梨つかさ","creatorId":"vndb:s2030","sourcePersonId":"egs:creator:10840","canonicalEntityId":"vndb:s2030","name":"有梨つかさ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:261446","source":"egs"},{"creditedName":"沖水ミル","creatorId":"vndb:s4000","sourcePersonId":"egs:creator:4986","canonicalEntityId":"vndb:s4000","name":"沖水ミル","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:261447","source":"egs"}],"music":[{"creditedName":"ミリオンバンブー","creatorId":"vndb:s1435","sourcePersonId":"vndb:s1435","canonicalEntityId":"vndb:s1435","name":"ミリオンバンブー","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:39387","source":"vndb"}],"other":[{"creditedName":"海苔 餅太","creatorId":"vndb:s4086","sourcePersonId":"vndb:s4086","canonicalEntityId":"vndb:s4086","name":"海苔 餅太","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:39390","source":"vndb"}]},"cast":[{"characterId":"char_c60236","characterName":"聖香","sourceIds":{"bangumi":[{"characterId":"38905","match":"exact-normalized-name-in-linked-work","subjectId":"169129"}],"egsCharacterIds":["14182"],"vndbCharacterId":"c60236"},"originalCharacterName":"聖香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The maid of the mansion."},{"spoiler":false,"text":"Possessing skin so clear and translucent plus beauty so overwhelming, her appearance almost resembles that of an actual doll."},{"spoiler":false,"text":"As she's both quiet and expressionless, one too, similar to Maika, cannot read at all what it is that is on her mind."},{"spoiler":false,"text":"Since she only serves Maika, she doesn't listen to any other instructions except hers."},{"spoiler":false,"text":"On the contrary, if Maika is the one giving the orders, she will execute them without ever changing her complexion, making one feel as if she's some kind of artificial doll somehow."},{"spoiler":false,"text":"Translated from the official product page"}],"source":"vndb","sourceCharacterId":"c60236"},{"segments":[{"spoiler":false,"text":"舞台となる館のメイド。"},{"spoiler":false,"text":"非常に美しく、豊満な肉体を持つが、無口な上に無表情で、まるで人形のような冷たさを持ち、鞠香と同じく、何を考えているのかわからない女性。"},{"spoiler":false,"text":"鞠香の命令以外は一切聞かず、また鞠香に命じられればどんなことでやる。"}],"source":"egs","sourceCharacterId":"14182","sourceWorkId":"13344","spoiler":false},{"segments":[{"spoiler":false,"text":"館のメイド。"},{"spoiler":false,"text":"透き通るような透明な肌と美しさを持つ、まるで人形のような美女。"},{"spoiler":false,"text":"無口で無表情なため、鞠香同様何を考えているのかまったく読めない。"},{"spoiler":false,"text":"鞠香にのみ仕えているので、鞠香の命令以外には一切聞く耳を持たない。"},{"spoiler":false,"text":"逆に鞠香が命令であれば顔色一つ変えずに実行するため、どこか人形のような作り物っぽさを感じる。"}],"source":"bangumi","sourceCharacterId":"38905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/342ab8212a03a277accc36e4c78e1df07b44ba90aa946c2a92355aa5b871e985.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d1419cbdab040dfb1a6722544d07f88cd0603afc2421af9cba9e0dd703dff6a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:169129:38905:6349:1","source":"bangumi"}]},{"characterId":"char_vndb_c60237","characterName":"葉月 鞠香","sourceIds":{"vndbCharacterId":"c60237"},"originalCharacterName":"葉月 鞠香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mansion's landlady, wherein this story is set."},{"spoiler":false,"text":"She seems to be a distant relative of Yuuki's father..."},{"spoiler":false,"text":"Lascivious like a prostitute, pure and innocent like Virgin Mary, she's a woman so beautiful she even strikes fear into one's soul."},{"spoiler":false,"text":"Her deep black enchanting eyes can see through just about everything like those of Medusa."},{"spoiler":false,"text":"Essentially a kind person, always seen wearing a smile on her face, though her true personality is shrouded in mystery, and as a result, none can tell what it is she's thinking, giving those"},{"spoiler":false,"text":"around her a feeling that comes very close to \"fear\"."},{"spoiler":false,"text":"Translated from the official product page"}],"source":"vndb","sourceCharacterId":"c60237"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8c83acedd5f11db88344e43987edadca340c6d3005f2ce6bf852dc65573578c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9696cc3559b10e5ac1ffe43ae6dfa29bb54bde92140b3d1c151a9aa747e99177.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-na