alCharacterName":"ナツノ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「你也会陪我一起来，对吧？」"},{"spoiler":false,"text":"高中二年级的少女。"},{"spoiler":false,"text":"离开位于东京的家乡，正在独自旅行。"},{"spoiler":false,"text":"虽然足够坚强，以至于可以凭一己之力生存下去，"},{"spoiler":false,"text":"但对于总是能够轻易适应任何事的自己，她似乎并无好感。"},{"spoiler":false,"text":"高校二年生の少女。"},{"spoiler":false,"text":"故郷の東京を離れ、一人で旅をしている。"},{"spoiler":false,"text":"たった一人で生き延びるたくましさをもっているけれど、"},{"spoiler":false,"text":"どんなことにも慣れてしまう自分のことがあまり好きではない。"}],"source":"bangumi","sourceCharacterId":"98721"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4018f2c52bcfbf410a14e94718134e1a6116ca8e461f4a3e067be58f933fa96f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b8de8703668a0e42eec94c20d58a9b049902e66c3352ef3e672270ab3825709.webp","width":124,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98722","characterName":"アカネ","sourceIds":{"bangumi":[{"characterId":"98722","match":"source-roster","subjectId":"342574"}]},"originalCharacterName":"アカネ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「不要哭成这样嘛，夏乃。」"},{"spoiler":false,"text":"我行我素，难以捉摸的年长女性。"},{"spoiler":false,"text":"与在世界毁灭之前，因某种理由聚集起来的人们生活在一起。"},{"spoiler":false,"text":"对于令世界分崩离析的病毒灾难，"},{"spoiler":false,"text":"她心中似乎有些头绪……？"},{"spoiler":false,"text":"マイペースでつかみどころのない女性。"},{"spoiler":false,"text":"世界の崩壊前にある理由で集められた人々とともに暮らしている。"},{"spoiler":false,"text":"世界を崩壊させたパンデミックについて、"},{"spoiler":false,"text":"何か思うところがあるようだけれど…"}],"source":"bangumi","sourceCharacterId":"98722"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86b634113d5b1eb11cf76c8ed6dd43e213a4c66fd294e834c539e44492f4c175.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8c90554b81bbaece0c97107726d62e0df09ce676d06c494b329d61b36adb858.webp","width":131,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98723","characterName":"キコ","sourceIds":{"bangumi":[{"characterId":"98723","match":"source-roster","subjectId":"342574"}]},"originalCharacterName":"キコ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「哇！对不起！不是这样的！」"},{"spoiler":false,"text":"心地善良的少女，正为了寻找走失的爱犬而独自旅行。"},{"spoiler":false,"text":"生性胆怯，又不擅于表现自己，"},{"spoiler":false,"text":"但却拥有为了寻找爱犬而独自旅行的强韧意志。"},{"spoiler":false,"text":"はぐれてしまった飼い犬を探して、一人旅をする優しい少女。"},{"spoiler":false,"text":"臆病で引っ込み思案だけれど、"},{"spoiler":false,"text":"飼い犬のために一人で旅を続ける意志の強さをもっている。"}],"source":"bangumi","sourceCharacterId":"98723"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/286d03fafcb2e1ef13fa070661f38c420d828b456d0cd584fc509f79f7b8d010.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/414e327c8a1c57350d295d3d2bf81615f788c3b87fe710c996aeb14580d2c5e8.webp","width":121,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98724","characterName":"シノ","sourceIds":{"bangumi":[{"characterId":"98724","match":"source-roster","subjectId":"342574"}]},"originalCharacterName":"シノ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「若非在这种情况下，不是很难得到一个人旅行的机会么？」"},{"spoiler":false,"text":"偶然发现了一张不知出自何人之手的照片，并因此踏上旅途的少女。"},{"spoiler":false,"text":"怀着半玩乐的心态，寻找着这张照片的拍摄地点。"},{"spoiler":false,"text":"总是露出令人印象深刻的明媚笑容，但背后又似乎另有心思——"},{"spoiler":false,"text":"偶然見つけた写真の場所を探して旅をする少女。"},{"spoiler":false,"text":"誰が撮ったのかさえわからない写真に写っている場所を、遊び半分で探している。"},{"spoiler":false,"text":"明るい笑顔が印象的だけれど、その奥に隠れた思いを秘めているようで──"}],"source":"bangumi","sourceCharacterId":"98724"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6de184aa7235064f21def02ebc487ec095b35eb3778acddc81ab0b412b8ec264.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67fa46bbfcfbaed8ea5f70ef9d396eed465a94148aacfaf3f6ad2d79a129331a.webp","width":224,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p13983","sourceCompanyId":"egs:brand:8459","canonicalEntityId":"vndb:p13983","name":"わくわくゲームズ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:36955:8459","source":"egs"},{"companyId":"vndb:p12236","sourceCompanyId":"vndb:p12236","canonicalEntityId":"vndb:p12236","name":"Kazuhide Oka","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:102072:v31854","source":"vndb"},{"companyId":"vndb:p15385","sourceCompanyId":"vndb:p15385","canonicalEntityId":"vndb:p15385","name":"夕凪","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:105680:v31854","source":"vndb"},{"companyId":"vndb:p12236","sourceCompanyId":"vndb:p12236","canonicalEntityId":"vndb:p12236","name":"Kazuhide Oka","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:124244:v31854","source":"vndb"},{"companyId":"vndb:p13983","sourceCompanyId":"vndb:p1