Code":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:47949","source":"vndb"},{"creditedName":"えすゑる","creatorId":"vndb:s7060","sourcePersonId":"vndb:s7060","canonicalEntityId":"vndb:s7060","name":"えすゑる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:47950","source":"vndb"}]},"cast":[{"characterId":"char_c38598","characterName":"美麻坂 七緒","sourceIds":{"bangumi":[{"characterId":"61560","match":"exact-normalized-name-in-linked-work","subjectId":"80911"}],"egsCharacterIds":["19166"],"vndbCharacterId":"c38598"},"originalCharacterName":"美麻坂 七緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The president of the student council at Amagai Academy."},{"spoiler":false,"text":"A young lady who has treated Kaoru like a pet since childhood."},{"spoiler":false,"text":"She is an excellent student, beautiful, and has a princess-like personality, making her a central figure in the academy. She also belongs to the swimming club as a hobby."},{"spoiler":false,"text":"In reality, she has a difficult personality and cannot be honest with those she likes..."},{"spoiler":false,"text":"Translated from erogamescape"}],"source":"vndb","sourceCharacterId":"c38598"},{"segments":[{"spoiler":false,"text":"天貝学園の学生会会長。"},{"spoiler":false,"text":"幼い頃から薫をペット扱いしてきたお嬢様。"},{"spoiler":false,"text":"成績優秀、眉目秀麗、お姫様気質が相まった学園の中心的存在で、趣味の一環として水泳部にも所属している。"},{"spoiler":false,"text":"実は、好きになった相手に素直になれない難儀な性格だったりするが……。"}],"source":"egs","sourceCharacterId":"19166","sourceWorkId":"9978","spoiler":false},{"segments":[{"spoiler":false,"text":"美しく整った外見のうえ、成績優秀な彼女は常に周囲の中心的な存在。"},{"spoiler":false,"text":"幼等部の頃、ひょんなことから薫を好きになるが、好意を素直にあらわすことが出来ず、裏腹な態度をとってばかりいる。"},{"spoiler":false,"text":"決めていた推薦を蹴り、薫を進学先まで追ってきたのだが、薫への行為はエスカレートし、決定的な溝を生むまでになってしまった。"},{"spoiler":false,"text":"性格は勝ち気で完璧主義者。人をいたわる気持ちも持ち合わせているが、薫と対面している時だけ心の安定を崩し、横柄な攻撃性を出してしまう。"}],"source":"bangumi","sourceCharacterId":"61560"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19166","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"19166","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"19166","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"19166","sourceWorkId":"9978","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/1454fbb3d904739d48766ff772f92737d28a849bee6ff788521c11a4e205a61a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9d04e40d791f22708ae46f6c729a6b540a4476f173ba7dfb53f3d0b9ac5f8fa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80911:61560:4675:1","source":"bangumi"}]},{"characterId":"char_c38599","characterName":"水上 まゆ","sourceIds":{"bangumi":[{"characterId":"61561","match":"exact-normalized-name-in-linked-work","subjectId":"80911"}],"egsCharacterIds":["19168"],"vndbCharacterId":"c38599"},"originalCharacterName":"水上 まゆ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Student council treasurer."},{"spoiler":false,"text":"Due to family discord, she grew up constantly watching her parents' expressions, and tends to be timid and shy around others."},{"spoiler":false,"text":"As a result, she can easily fall in love with someone who is even slightly kind to her..."},{"spoiler":false,"text":"Translated from erogamescape"}],"source":"vndb","sourceCharacterId":"c38599"},{"segments":[{"spoiler":false,"text":"学生会会計。"},{"spoiler":false,"text":"家庭不和で、常に親の顔色を窺いながら育ったため、おどおどした態度をとりがちな、対面恐怖症気味の少女。"},{"spoiler":false,"text":"そのため、少し優しくされただけで好きになってしまうことも……。"}],"source":"egs","sourceCharacterId":"19168","sourceWorkId":"9978","spoiler":false},{"segments":[{"spoiler":false,"text":"おとなしく自己主張のない典型的ないじめられっ娘。薫がいなければ学生会での使いっ走りをさせられたであろう気質だが、彼女を誘ったのは会長の七緒自身。"},{"spoiler":false,"text":"苛められている姿に薫と同じものを見て、救済案として手元に置いた。しかしまゆ自身は自分の身代わりのように貶められている薫を見て、助けられない自分をさいなんでいる。"},{"spoiler":false,"text":"性格は内気で対面恐怖症気味。家庭は円満とは程遠く常に両親の顔色を伺いながら生きて来たため、常におどおどした態度をとってしまう。そのため、自分を卑下しており、優しく接してくれるものには好意をもってしまうことも。"}],"source":"bangumi","sourceCharacterId":"61561"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"19168","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"19168","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"19168","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"19168","sourceWorkId":"9978","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5b0774b50134e5d14ead633251b4bdfc2c1df8e3776551b31c960040c4d4392.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/883126c3ee1faa9a7fcccd0665fc7331910e7628343d222158a6805a5dd8608e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80911:61561:4177:1","source":"bangumi"}]},{"characterId":"char_c38600","characterName":"桐生 操","sourceIds":{"bangumi":[{"characterId":"61563","match":"exact-normalized-name-in-linked-work","subjectId":"80911"}],"egsCharacterIds":["19167"],"vndbCharacterId":"c38600"},"originalCharacterName":"桐生 操","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaoru's arch-enemy and Nanao's right-hand woman."},{"spoiler":false,"text":"On the surface, she is known as a “responsible disciplinary committee member,” but in reality, she is a girl who bullies dull-witted people like Kaoru and Mayu."},{"spoiler":false,"text":"She seems to have a younger boyfriend, whom she blindly adores and dotes on."},{"spoiler":false,"text":"Translated from erogamescape"}],"source":"vndb","sourceCharacterId":"c38600"},{"segments":[{"spoiler":false,"text":"薫の天敵で、七緒の取り巻き筆頭。"},{"spoiler":false,"text":"表向きは「しっかり者の風紀委員」で通っているが、その実、薫やまゆのような鈍くさい人間をイジメの対象にする少女。"},{"spoiler":false,"text":"後輩の彼氏がいるらしく、盲目的に貢いだり、甘えたりしているらしい。"}],"source":"egs","sourceCharacterId":"19167","sourceWorkId":"9978","spoiler":false},{"segments":[{"spoiler":false,"text":"七緒の取り巻き筆頭であり薫の天敵。七緒が命令し、操が実行にうつす…憎むべき敵である。操本人は、苛めているという感覚はなく、七緒がそう命令しているからただ実行しているだけといった気持ち。"},{"spoiler":false,"text":"部活には所属しておらず風紀委員としての仕事を最優先にこなしてはいるがきつい物言いのせいもあり一般生徒から嫌われる事が多い。"},{"spoiler":false,"text":"風紀委員として異性との交際を注意したりしているがその実、自分にも彼氏がいるという事でもわかるように自分の事は棚に上げる性格。"}],"source":"bangumi","sourceCharacterId":"61563"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"19167","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"19167","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"19167","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"19167","sourceWorkId":"9978","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63e7a5aca87f724877e8037b860eb5577a94a77cb390505cd2ac897d08e80161.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8dba8a8bdaaf52665c32ff87628b9dd3de9be06e529d2a57a76c3556b9bda01.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田愛理","creatorId":"vndb:s757","sourcePersonId":"vndb:s757","canonicalEntityId":"vndb:s757","name":"如月葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80911:61563:6037:1","source":"bangumi"}]},{"characterId":"char_c38601","characterName":"樋口 潤","sourceIds":{"bangumi":[{"characterId":"61562","match":"exact-normalized-name-in-linked-work","subjectId":"80911"}],"egsCharacterIds":["19169"],"vndbCharacterId":"c38601"},"originalCharacterName":"樋口 潤","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Kaoru's twin sister and the public relations officer of the student council."},{"spoiler":false,"text":"Having grown up constantly being compared to the intelligent Kaoru, she does not have a good impression of her brother, and even though she knows that Nanao is subjecting him to humiliating behavior, she pretends not to notice."},{"spoiler":false,"text":"She is being sexually harassed by the track coach, but for some reason she does not resist..."},{"spoiler":false,"text":"Translated from erogamescape"}],"source":"vndb","sourceCharacterId":"c38601"},{"segments":[{"spoiler":false,"text":"学生会の広報で、薫の双子の姉。"},{"spoiler":false,"text":"頭の良い薫と常に比べられて育ったため、弟にいい印象を持っておらず、七緒に屈辱的な行為を受けているのを知っていながら、見ない振りをしている。"},{"spoiler":false,"text":"陸上部顧問からセクハラ行為を受けているが、何故か抵抗せずにいて……。"}],"source":"egs","sourceCharacterId":"19169","sourceWorkId":"9978","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公、薫の二卵性の双子の姉。頭の良い弟と子供の頃から比べられ育ったため、嫌いとまではいかないが薫に対してはあまり良い印象をもっていない。自分は親に認められるために、スポーツで目立とうと陸上に力を入れている。"},{"spoiler":false,"text":"薫が日常的に七緒から屈辱的な行為を受けているのは知っているが、今は自分の伸び悩んでいる陸上の成績の事で頭が一杯で助けようとはしない。"},{"spoiler":false,"text":"性格は面倒見が良く相手をたてることができるため、後輩・先輩からにも好かれている。一転、一度嫌いになると感情的になるのではなく、相手に対しての興味を失い無視をする。"}],"source":"bangumi","sourceCharacterId":"61562"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"19169","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"19169","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"19169","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"19169","sourceWorkId":"9978","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c96fb09dfc3e84abf1595c3341a5775db8eadf525b6f7dfe06b99c603d0e8a37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99c831e2644d77bb75cacc0307b090eb087957a07e7aae42f19b735b7151f83d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80911:61562:13773:1","source":"bangumi"}]},{"characterId":"char_c38602","characterName":"白河 美月","sourceIds":{"bangumi":[{"characterId":"61564","match":"exact-normalized-name-in-linked-work","subjectId":"80911"}],"egsCharacterIds":["19170"],"vndbCharacterId":"c38602"},"originalCharacterName":"白河 美月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female teacher who is the advisor to the student council and also Kaoru's homeroom teacher."},{"spoiler":false,"text":"She knows about Nanao and Kaoru's relationship, but feels powerless to do anything about it, so she pretends not to notice."},{"spoiler":false,"text":"She is a coward who cannot take action on her own initiative in any situation."},{"spoiler":false,"text":"Translated from erogamescape"}],"source":"vndb","sourceCharacterId":"c38602"},{"segments":[{"spoiler":false,"text":"学生会の顧問で、薫の担任でもある女教師。"},{"spoiler":false,"text":"七緒と薫の関係を知っているが、自分にはどうにも出来ないと、見て見ぬふりをしている。"},{"spoiler":false,"text":"何に対しても、自分からアクションを起こすことができない臆病者。"}],"source":"egs","sourceCharacterId":"19170","sourceWorkId":"9978","spoiler":false},{"segments":[{"spoiler":false,"text":"薫の担任でもあり、学生会の顧問もつとめているのだから当然薫に行われている行為の実態を知っている人物。"},{"spoiler":false,"text":"しかし、行為を行っている七緒達に対して注意をする度胸は無く、一番簡単な薫の責任にして停学にするという形で事態を収拾しようとした。"},{"spoiler":false,"text":"性格は、周りの意見に左右されやすく明確な意見をもっていない。いじめだと理解しても自分にはどうにも出来ないからと見てみぬふりをする。"}],"source":"bangumi","sourceCharacterId":"61564"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"19170","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"19170","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"19170","sourceWorkId":"9978","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"19170","sourceWorkId":"9978","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/te