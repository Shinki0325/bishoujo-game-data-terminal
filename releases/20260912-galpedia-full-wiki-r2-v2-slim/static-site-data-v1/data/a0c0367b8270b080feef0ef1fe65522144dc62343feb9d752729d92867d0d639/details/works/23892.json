:131915","source":"vndb"},{"creditedName":"エイトビット","creatorId":"vndb:s37014","sourcePersonId":"vndb:s37014","canonicalEntityId":"vndb:s37014","name":"エイトビット","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131916","source":"vndb"},{"creditedName":"中嶋 浩平","creatorId":"vndb:s45138","sourcePersonId":"vndb:s45138","canonicalEntityId":"vndb:s45138","name":"中嶋 浩平","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131917","source":"vndb"},{"creditedName":"07th Expansion","creatorId":"vndb:s54158","sourcePersonId":"vndb:s54158","canonicalEntityId":"vndb:s54158","name":"07th Expansion","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131918","source":"vndb"}]},"cast":[{"characterId":"char_c241","characterName":"天王寺 小鳥","sourceIds":{"bangumi":[{"characterId":"12063","match":"exact-normalized-name-in-linked-work","subjectId":"4022"}],"egsCharacterIds":["23703"],"vndbCharacterId":"c241"},"originalCharacterName":"天王寺 小鳥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"726"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kotarou's classmate and childhood friend. They can easily establish a comic rhythm in their dialogue. She is very talented at caring for herbs and plants."}],"source":"vndb","sourceCharacterId":"c241"},{"segments":[{"spoiler":false,"text":"瑚太朗の大親友。 小さくて元気いっぱい、小動物っぽい女の子。"},{"spoiler":false,"text":"ガーデニングの才能と霊感がある。"},{"spoiler":false,"text":"昔からいつも瑚太朗と一緒に行動していたせいか、友達は少ない。"},{"spoiler":false,"text":"持ち前のノリの良さで、瑚太朗とは漫才のようなノリの会話を繰り広げている。"}],"source":"egs","sourceCharacterId":"23703","sourceWorkId":"10917","spoiler":false},{"segments":[{"spoiler":false,"text":"瑚太朗的好朋友。身材娇小但精力充沛、像小动物一样的女孩子。"},{"spoiler":false,"text":"园艺方面很有才能并持有灵感。"},{"spoiler":false,"text":"因为从以前开始就一直和瑚太朗在一起、所以没什么朋友。"},{"spoiler":false,"text":"天性迷糊，总是和瑚太朗进行着像相声一样的迷糊对话。"}],"source":"bangumi","sourceCharacterId":"12063"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f0c528bf35ecdf3da7c5283faa5121f661ae3dd4a5b97aee88ba196c7538f71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28236b61ad0b3a7178e097e7168dda5ba23dfa6af343673e08b0f8fb59b4c711.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎藤千和","creatorId":"vndb:s475","sourcePersonId":"vndb:s475","canonicalEntityId":"vndb:s475","name":"斎藤千和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:328934:12063:4249:1","source":"bangumi"}]},{"characterId":"char_c270","characterName":"中津 静流","sourceIds":{"bangumi":[{"characterId":"12074","match":"exact-normalized-name-in-linked-work","subjectId":"4022"}],"egsCharacterIds":["23706"],"vndbCharacterId":"c270"},"originalCharacterName":"中津 静流","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"618"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kotarou's kouhai. She has a reserved and honest disposition. Even if she doesn't speak, she is able to convey herself through her behavior; she has rich facial expressions. Although a member of the Disciplinary Committeee, she rarely acts like one, besides as a pretext for looking after Kotarou. She fawns over her favorite dish, saury."}],"source":"vndb","sourceCharacterId":"c270"},{"segments":[{"spoiler":false,"text":"瑚太朗の後輩で、風紀委員会に所属している。"},{"spoiler":false,"text":"無口で素直な性格。 言葉がなくても振る舞いで伝わる、感情表現の豊かな少女。"},{"spoiler":false,"text":"あまり風紀の活動を行わないが、瑚太朗に構ってほしくて取締りをすることがある。"},{"spoiler":false,"text":"眼帯はオッドアイを隠すためのもので、親しい人の前でしか外すことはない。"},{"spoiler":false,"text":"さんまが好物で溺愛している。"}],"source":"egs","sourceCharacterId":"23706","sourceWorkId":"10917","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的后辈、风纪委员会所属。无口但很直率。"},{"spoiler":false,"text":"虽然不怎么说话但会通过行动来表达、感情表现很丰富的少女。"},{"spoiler":false,"text":"几乎没像样地做过风纪委员的工作、为了让瑚太朗注意自己而对他进行监管。"},{"spoiler":false,"text":"为了隐瞒自己的虹彩异色症而戴着眼罩、只有在亲近的人面前才会拿下。"},{"spoiler":false,"text":"非常喜欢吃秋刀鱼。"}],"source":"bangumi","sourceCharacterId":"12074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4aa0ff740ee3a2bf7dd86badc35d1094fd3e556b44dece263b4268a708c370d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ca94e1bed7d2a587bf2371a51799cb4cc270b314c0b2a1b03ab11d201103255.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:328934:12074:6275:1","source":"bangumi"}]},{"characterId":"char_c272","characterName":"加島 朱音","sourceIds":{"bangumi":[{"characterId":"12072","match":"exact-normalized-name-in-linked-work","subjectId":"4022"}],"egsCharacterIds":["23705"],"vndbCharacterId":"c272"},"originalCharacterName":"加島 朱音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"217"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The president of the Occult Research Society who is called the \"witch of the academy\". Within the school, she is famous among some of the students for being an existence above the rules."}],"source":"vndb","sourceCharacterId":"c272"},{"segments":[{"spoiler":false,"text":"“学園の魔女” と噂されるオカルト研究会の部長。"},{"spoiler":false,"text":"校内では超法規的な存在として一部生徒には有名。"},{"spoiler":false,"text":"儚げな外面だが、瑚太朗以上に人を食った性格と微妙に地味な内面を持つ。"},{"spoiler":false,"text":"何か裏のありそうな言動が目立つが、その実態は誰も知らない。"}],"source":"egs","sourceCharacterId":"23705","sourceWorkId":"10917","spoiler":false},{"segments":[{"spoiler":false,"text":"被暗地里称作「学园的魔女」的神秘研究会部长。"},{"spoiler":false,"text":"在校内是个我行我素的人在部分学生中很有名。"},{"spoiler":false,"text":"和外表不相称的是比瑚太朗更喜欢捉弄人、内心深处也有着朴实的一面的少女。"},{"spoiler":false,"text":"似乎为了什么目的一举一动都很引人注目、真正的目的谁也无从知晓。"}],"source":"bangumi","sourceCharacterId":"12072"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/499af4e2d528ba15919281fd1403aa9903bb117e8b05c78aabb0e8acf18cb011.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9875897375a9bd5ead66c809ac84163f121cde7bc818aef77fe9490b6278e8fc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:328934:12072:4251:1","source":"bangumi"}]},{"characterId":"char_c302","characterName":"アサヒ・ハルカ","sourceIds":{"bangumi":[],"egsCharacterIds":["23707"],"vndbCharacterId":"c302"},"originalCharacterName":"アサヒ・ハルカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1223"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The talented class president whose name is also well-known to surrounding clubs. With a clean-freak attitude, she strongly lacks tolerance when dealing with boys. As a result of getting rolled up in commotion caused by Kotarou, she delivers him daily punishment."},{"spoiler":true,"text":"Her real name is Asahi Haruka(アサヒ・ハルカ)."}],"source":"vndb","sourceCharacterId":"c302"},{"segments":[{"spoiler":false,"text":"周囲のクラスにもその名が知れ渡るカリスマクラス委員長。"},{"spoiler":false,"text":"潔癖症気味で男子に対する免疫が極端にない。"},{"spoiler":false,"text":"瑚太朗の起こす騒動によく巻き込まれ、結果瑚太朗に制裁を加える日々を送る。"},{"spoiler":false,"text":"凛とした態度と辛い物好きで周囲にはお馴染みだが、本人はあまり目立つのは苦手。"}],"source":"egs","sourceCharacterId":"23707","sourceWorkId":"10917","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efa4bcb25d7e75d4f8609bf47c8fb4fa8a9c14c7626a0e76ff462d84121e5b22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f884ce1b193a7eea6b4b4d93988ce0a7cfbace5eba18fdede8715ac9307b6580.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝樹 りさ","creatorId":"vndb:s476","sourcePersonId":"vndb:s476","canonicalEntityId":"vndb:s476","name":"朝樹 りさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69962","source":"vndb"}]},{"characterId":"char_c303","characterName":"鳳 ちはや","sourceIds":{"bangumi":[{"characterId":"12065","match":"exact-normalized-name-in-linked-work","subjectId":"4022"}],"egsCharacterIds":["23704"],"vndbCharacterId":"c303"},"originalCharacterName":"鳳 ちはや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"824"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who suddenly transferred to the school Kotarou attends. She has led a sheltered life and is ignorant of the ways of the world. Considerably clumsy and easily getting lost, Kotarou always helps her out, but with her personality that can't stay meek they can't stop quarreling. Called a \"power fighter\" for being really strong physically."}],"source":"vndb","sourceCharacterId":"c303"},{"segments":[{"spoiler":false,"text":"風祭高校に突然転校してきた少女。 世間知らずの箱入り娘で、パワーファイター。"},{"spoiler":false,"text":"かなりのドジっ子で瑚太朗に助けられてばかりだが、素直になれず口論が絶えない。"},{"spoiler":false,"text":"周りからは瑚太朗に気があるようにも本気で嫌っているようにも見える。"}],"source":"egs","sourceCharacterId":"23704","sourceWorkId":"10917","spoiler":false},{"segments":[{"spoiler":false,"text":"突然转学到瑚太朗所在学校的少女。"},{"spoiler":false,"text":"不知人间险恶的深闺大小姐、精力过剩的存在。"},{"spoiler":false,"text":"由于其过分天然呆的属性一直受到瑚太朗的帮助、但由于其别扭的性格总是和瑚太朗争论不休。"},{"spoiler":false,"text":"从周围人看来是又在意瑚太朗又很讨厌他的样子。"}],"source":"bangumi","sourceCharacterId":"12065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/573cf14a9f3351a045fe84d968939b6762f1fb679a24553bb3f2bb1fd1e0d8a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5e40e1dca0403ec7be37f61a1d43e8fa7793c529735c52f4f8c11cd367f7b22.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篠宮沙弥","creatorId":"vndb:s1363","sourcePersonId":"vndb:s1363","canonicalEntityId":"vndb:s1363","name":"篠宮 沙弥","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:328934:12065:6274:1","source":"bangumi"}]},{"characterId":"char_vndb_c267","characterName":"天王寺 瑚太朗","sourceIds":{"vndbCharacterId":"c267"},"originalCharacterName":"天王寺 瑚太朗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"502"},"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"waist":{"reviewState":"source-only","source":"vndb","value