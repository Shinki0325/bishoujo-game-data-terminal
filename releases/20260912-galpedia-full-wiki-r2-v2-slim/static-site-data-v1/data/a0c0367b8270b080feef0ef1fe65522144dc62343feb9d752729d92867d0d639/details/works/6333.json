しんでいる程度。"}],"source":"bangumi","sourceCharacterId":"134238"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36a46c175465786374a86993e8fc57bca0febe022f2db3f945b78e255295301e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e7e2ddb66232288f59d89d9ab7391d3984d0ffaf879a0c1b28b9a9974c7b8e9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長月 あげは","creatorId":"vndb:s18303","sourcePersonId":"vndb:s18303","canonicalEntityId":"vndb:s18303","name":"長月 あげは","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45667","source":"vndb"}]},{"characterId":"char_c81727","characterName":"吾妻 千登勢","sourceIds":{"bangumi":[{"characterId":"134239","match":"exact-normalized-name-in-linked-work","subjectId":"229706"}],"egsCharacterIds":["26241"],"vndbCharacterId":"c81727"},"originalCharacterName":"吾妻 千登勢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"71"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹。"},{"spoiler":false,"text":"天真爛漫で子供っぽい性格の女の子。"},{"spoiler":false,"text":"またおっちょこちょいで、最悪感や責任感に欠ける楽観主義的な面も。"},{"spoiler":false,"text":"無自覚ながら女帝気質を秘めており、褒められたり、ちやされると高揚する。"},{"spoiler":false,"text":"父親である修造の血を多く受け継いでいるのか、倫理観に欠け、セックスに関してもアブノーマルな行為を好む。"}],"source":"egs","sourceCharacterId":"26241","sourceWorkId":"6333","spoiler":false},{"segments":[{"spoiler":false,"text":"新学期から二年生。"},{"spoiler":false,"text":"あどけなく天真爛漫で○○っぽく、おっちょこちょいの楽観主義者。"},{"spoiler":false,"text":"……だが、実は無自覚ながら強烈な女帝気質を秘めていて、○○されながら徐々に目覚めていく。"},{"spoiler":false,"text":"美意識が強く、華やかなものを好む。ちやほやされることに慣れていて、寂しいとすぐにヘソを曲げる。"}],"source":"bangumi","sourceCharacterId":"134239"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c66e0e38c39393dd2177918a55dd5a4abe7ef970506826c6778f415956b44e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38920b0b81b27f2e0a503fdf1191e8fcee8d64284e417df2ad2049c45249c303.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひかり","creatorId":"vndb:s2924","sourcePersonId":"vndb:s2924","canonicalEntityId":"vndb:s2924","name":"ひかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45663","source":"vndb"}]},{"characterId":"char_c81728","characterName":"吾妻 阿佐緒","sourceIds":{"bangumi":[{"characterId":"134237","match":"exact-normalized-name-in-linked-work","subjectId":"229706"}],"egsCharacterIds":["26239"],"vndbCharacterId":"c81728"},"originalCharacterName":"吾妻 阿佐緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義母。"},{"spoiler":false,"text":"貞淑な大和撫子でありながら、成熟した大人の色香を発散するグラマラスな女性。"},{"spoiler":false,"text":"19歳のときに41歳の修造（主人公の義父）と政略結婚させられ、様々な房事を教え込まれた。"},{"spoiler":false,"text":"男女交際の経験がなく、本気で男に惚れたことのない彼女は、本当の恋をしたいと年甲斐もなく乙女の憧れを抱いているようだ。"}],"source":"egs","sourceCharacterId":"26239","sourceWorkId":"6333","spoiler":false},{"segments":[{"spoiler":false,"text":"名門の私立高校卒。19歳のときに41歳の修造と政略結婚させられる。"},{"spoiler":false,"text":"ほかの男は知らないが、房事は修造にいろいろと教えこまれている。"},{"spoiler":false,"text":"男女交際の経験がなく、本気で男に惚れたこともない。内心では「一途に誰かを愛してみたい」という憧れを燻らせている。"}],"source":"bangumi","sourceCharacterId":"134237"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4636ae5a283e98bf316b3d21614bfea4836a8767dbf24992c087466343d59cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12e9f9641f79fb1b0f1433a49fd83ebccdde7f81335f5cbe38112fc3e75689e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲良さく","creatorId":"vndb:s7809","sourcePersonId":"vndb:s7809","canonicalEntityId":"vndb:s7809","name":"咲良 さく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229706:134237:92705:1","source":"bangumi"}]},{"characterId":"char_vndb_c125451","characterName":"吾妻 大輔","sourceIds":{"vndbCharacterId":"c125451"},"originalCharacterName":"吾妻 大輔","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dffcf248844279558d4d85b9457e94afd3d0d7a3951f11e21c9b817e495be709.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d569bfad1e8281d68496eb2f298d70a0f6b16fd0f4476a9d1df4ff1ee2646bc.webp","width":233,"height":256,"source":"static-detail"},"actors":[]},{"characterId"