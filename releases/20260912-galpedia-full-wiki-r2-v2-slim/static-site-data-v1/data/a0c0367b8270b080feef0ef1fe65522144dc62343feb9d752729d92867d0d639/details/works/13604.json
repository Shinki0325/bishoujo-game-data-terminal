:[{"spoiler":false,"text":"学とは家が隣同士の幼馴染だったが、約一年ほど前から恋人関係に。"},{"spoiler":false,"text":"家族ぐるみで仲が良いため、気兼ねなく互いの家を行き来でき、学の家に泊まることもしばしば。"},{"spoiler":false,"text":"体育会系の飾らないさっぱりとした性格でノリも良いが、色んな意味で不器用な女の子。"},{"spoiler":false,"text":"自身はまったく料理ができないけれど実家はお惣菜屋さん。"}],"source":"egs","sourceCharacterId":"11992","sourceWorkId":"13876","spoiler":false},{"segments":[{"spoiler":false,"text":"缭乱学园 2年级学生・美术部员。"},{"spoiler":false,"text":"与主人公学是住在隔壁的青梅竹马，也就是所谓的损友。"},{"spoiler":false,"text":"与主人公的妹妹・恋華以及另一个损友悠太4人是从小时候就一起净干傻事的关系。"},{"spoiler":false,"text":"不修边幅体育会系般性格爽朗。但是，在很多意义上是个笨拙的女孩子。"},{"spoiler":false,"text":"手工活儿很笨拙恋爱也很笨拙。顺带一提连胸部的成长也很笨拙……"},{"spoiler":false,"text":"本人虽然完全不会做料理，但本家是副食店。"}],"source":"bangumi","sourceCharacterId":"11726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/512e2489ecef9b1b23b0e93c4771dd489eb3a9fc02b47fe6233edeba9538c3bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/084d9ea77ee568e021fc229b0b8e2530afd565621727099cbd654a7fe0239569.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"たかはし智秋","creatorId":"vndb:s287","sourcePersonId":"vndb:s287","canonicalEntityId":"vndb:s287","name":"たかはし 智秋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1896:11726:4604:1","source":"bangumi"}]},{"characterId":"char_c32634","characterName":"木通 遊佐","sourceIds":{"bangumi":[{"characterId":"11727","match":"exact-normalized-name-in-linked-work","subjectId":"1896"}],"egsCharacterIds":["11991"],"vndbCharacterId":"c32634"},"originalCharacterName":"木通 遊佐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"426"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-confl