":"a"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hiro's childhood friend and Saya's younger twin sister. She is aware of Hiro and Saya's feelings and helps them get together. While she's good at both studying and sports, her only weakness is hot food."}],"source":"vndb","sourceCharacterId":"c640"},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、沙耶の双子の妹。"},{"spoiler":false,"text":"成績優秀、運動神経抜群、明るく社交的な性格で、周囲からの信頼も厚い。"},{"spoiler":false,"text":"おおよそ欠点が見当たらない彼女の唯一の弱点は猫舌。"},{"spoiler":false,"text":"主人公に淡い恋心を抱いているが……。"}],"source":"egs","sourceCharacterId":"19987","sourceWorkId":"9222","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的青梅竹马。虽然队主人公有爱慕之心，却一直对主人公隐瞒着这份思念。"},{"spoiler":false,"text":"性格开朗善于交际，因为是不太在意周围的气氛的类型，所以不容易产生烦恼。"},{"spoiler":false,"text":"运动神经出类拔萃，被看作是下任的女子剑道部的部长，成绩也很优秀。唯一的缺点是猫舌，怕吃烫的东西。"}],"source":"bangumi","sourceCharacterId":"11979"}],"profileFacts":[{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"19987","sourceWorkId":"9222","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"19987","sourceWorkId":"9222","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"height":[{"comparisonValue":"156","source":"vndb","sourceCharacterId":"c640","value":"156"},{"comparisonValue":"156","scope":"sourceWork","source":"egs","sourceCharacterId":"19987","sourceWorkId":"9222","value":"156"},{"comparisonValue":"158","source":"bangumi","sourceCharacterId":"11979","value":"158"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/415a2c90ae7217d897e56c825a8f5f42cd67e39db22c91e0c2f8f542f3ee628e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b34