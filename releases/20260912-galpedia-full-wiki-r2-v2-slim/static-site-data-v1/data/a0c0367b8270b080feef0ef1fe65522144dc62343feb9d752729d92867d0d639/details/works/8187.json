＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:14688","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14689","source":"vndb"}]},"cast":[{"characterId":"char_c26440","characterName":"朧","sourceIds":{"bangumi":[{"characterId":"52201","match":"exact-normalized-name-in-linked-work","subjectId":"126047"},{"characterId":"52201","match":"exact-normalized-name-in-linked-work","subjectId":"194251"},{"characterId":"52201","match":"exact-normalized-name-in-linked-work","subjectId":"195854"},{"characterId":"52201","match":"exact-normalized-name-in-linked-work","subjectId":"303915"},{"characterId":"52201","match":"exact-normalized-name-in-linked-work","subjectId":"523724"}],"egsCharacterIds":["9258"],"vndbCharacterId":"c26440"},"originalCharacterName":"朧","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1024"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"朧忍軍と称し、魑魅魍魎と結託する多国籍複合企業体・ノマドに与するくノ一。"},{"spoiler":false,"text":"アサギによって殺されるが、魑魅魍魎の肉体を借りて復活を遂げる。"},{"spoiler":false,"text":"そして、自分を殺したアサギへ復讐するべく、巧妙な罠を張り巡らすが……。"}],"source":"egs","sourceCharacterId":"9258","sourceWorkId":"7257","spoiler":false},{"segments":[{"spoiler":false,"text":"朧忍軍と称し、魑魅魍魎と結託する多国籍複合企業体・ノマドに与するくノ一。"},{"spoiler":false,"text":"アサギによって殺されるが、魑魅魍魎の肉体を借りて復活を遂げる。"},{"spoiler":false,"text":"そして、自分を殺したアサギへ復讐するべく、巧妙な罠を張り巡らすが……。"}],"source":"egs","sourceCharacterId":"9258","sourceWorkId":"8187","spoiler":false},{"segments":[{"spoiler":false,"text":"傭兵を集めて朧忍軍と称し、魑魅魍魎と結託する多国籍複合企業体・ノマドに与するくノ一。"},{"spoiler":false,"text":"アサギによって一度は殺されるが、魑魅魍魎の肉体を借り、闇の闘技場＜カオス・アリーナ＞の館長として復活するが、復讐の燃える朧はアサギとその妹を姦計に陥れる。"}],"source":"egs","sourceCharacterId":"9258","sourceWorkId":"11375","spoiler":false},{"segments":[{"spoiler":false,"text":"傭兵を集めて朧忍軍と称し、魑魅魍魎と結託する多国籍複合企業体・ノマドに与するくノ一。"},{"spoiler":false,"text":"アサギによって一度は殺されるが、魑魅魍魎の肉体を借り、闇の闘技場＜カオス・アリーナ＞の館長として復活する。"},{"spoiler":false,"text":"復讐の燃える朧はアサギとその妹を姦計に陥れるが、アサギの逆襲に再び撃ち滅ぼされる。"}],"source":"egs","sourceCharacterId":"9258","sourceWorkId":"16312","spoiler":false},{"segments":[{"spoiler":false,"text":"魑魅魍魎と結託する多国籍複合企業体「ノマド」に与し東京キングダムで「マダム」と呼ばれる姫カットの髪型をした元対魔忍。手甲から伸びる片刃の刀身状の鉤爪を得物とし、施されると肌に黒いハートマークの入れ墨のように刻まれる強力な呪術系忍法「催眠刻印」の使い手。フロントジッパー式の赤いレオタードと網柄のボディストッキングが合わさったような忍装束43と、赤ずくめのスリップドレス（英語版）×ハイヒールサンダルを着分けている。3年前41にアサギによって一度は殺されるが、醜い肉腫のような姿の下等妖魔に身を宿して生き延びており、復讐のため恭介に寄生したのち肉体そのものを奪ってかつての姿を取り戻し、恭介の肉体ごと命を人質にする。なお、当項の朧は厳密には肉体がオリジナルだっただけで、元々の朧とはエドウィン・ブラックに滅ぼされた甲河一族のもう1人の生き残り（のちの仮面の対魔忍）のことで、空蝉の術で精神（魂）が離れ空っぽになっていた肉体に邪悪な魂（人格）を入れられて誕生したのが成り立ち注釈 35。デザイナー本人のカガミがお気に入りと述べている44。声は児玉さとみ、榎津まお（『the Nightmare』注釈 37）。"},{"spoiler":false,"text":"『カオス・アリーナ編』"},{"spoiler":false,"text":"素肌にまとった赤ずくめのジャケット×ミニスカート×逆三角形レンズのリムレス眼鏡（英語版）×ハイヒール×茶色系のストッキング姿でアサギを電車に連れ込み、宿主である恭介の性器を実体化させて犯しつつ、スネークレディや多数の男たちと痴漢&SMプレイで凌辱した。"},{"spoiler":false,"text":"『the Nightmare』"},{"spoiler":false,"text":"前半（1作目ごろの過去話）に登場。籠手や脚などがリニューアルされた忍装束45注釈 38姿と、Gストリングの下着だけ穿いての45黒のフロントジッパー式ストラップレスドレス×紫色系のイブニンググローブ×ガーター付き45の茶色系ストッキング姿を着分けており、後者では隠しもった4本のくないを得物に用いた。"},{"spoiler":false,"text":"『アサギ2』"},{"spoiler":false,"text":"朧クローンとは別人であり、1作目と同じ忍装束注釈 39で登場。エドウィン・ブラックの力で“吸血鬼の朧”と化して復活を果たしており、アサギに深手を負わされ逃れてきた朧クローンを自らの手で始末した。"},{"spoiler":false,"text":"『恥虐の暗黒遊戯』"},{"spoiler":false,"text":"スネークレディと組んでアサギとさくらを拘束しノマドの基地やビル内のショーなどで調教するが、最終的には血液を利用したアサギの反撃で首だけになり、スネークレディに回収され撤退した。"},{"spoiler":false,"text":"『アサギ3』"},{"spoiler":false,"text":"仮面の対魔忍とは別人。結城炎美に近付いたさいは両サイドを三つ編みにした髪型の五車学園の女生徒に化けた。分身の術「朧分身」などを駆使して倒したイングリッドを嬲り者にした一方で、組んでいた魔科医フュルストには裏切られて淫獣によって凌辱されるが返り討ちにした。その後は石山兄弟を使って囚えていた甲河アスカの手でアサギを殺させようと画策するが、アスカの策略で人間爆弾にされた石山拓斗の爆発に巻き込まれるという末路を辿った。"},{"spoiler":false,"text":"『決戦アリーナ』"},{"spoiler":false,"text":"原作とほぼ同じくノマド幹部かつブラックの側近で、すでに『アサギ2』以降の“吸血鬼の朧”であり46、姿は『アサギ3』での忍装束や1作目でのスリップドレスの2通りで登場。"}],"source":"bangumi","sourceCharacterId":"52201"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f095c7915a9eae4911b98f4740e84e92776e989a60a9703ba28cdd34c5344a80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5c5ed2c6148e51c28327236ede114101ffe7590360649869fdc2fd1c7ed7012.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126047:52201:15954:1","source":"bangumi"}]},{"characterId":"char_c26443","characterName":"沢木 恭介","sourceIds":{"bangumi":[{"characterId":"93888","match":"exact-normalized-name-in-linked-work","subjectId":"523724"}],"egsCharacterIds":["9260"],"vndbCharacterId":"c26443"},"originalCharacterName":"沢木 恭介","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アサギの幼馴染にして婚約者。"},{"spoiler":false,"text":"朧に肉体を乗っ取られ、それが原因でアサギを窮地に陥れてしまう。"},{"spoiler":false,"text":"アサギの刃に倒れる。享年26歳。"}],"source":"egs","sourceCharacterId":"9260","sourceWorkId":"16312","spoiler":false},{"segments":[{"spoiler":false,"text":"アサギの幼馴染にして婚約者。頼りないぼぅーとした雰囲気だが誠実で芯の強い好人物。"},{"spoiler":false,"text":"妹のさくらからも「沢木兄＜さわきにぃ＞」と慕われている。"}],"source":"bangumi","sourceCharacterId":"93888"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/446b94e52bb309d54da4743d0cdcdf1bbf17a5fe7f45be583c4b5d73667e28f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdf9f815fb389253e7e5470869608c037d385d52404af9f9b10b333ef5b44534.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c26444","characterName":"エドウィン・ブラック","sourceIds":{"bangumi":[{"characterId":"91867","match":"source-roster","subjectId":"126047"},{"characterId":"91867","match":"source-roster","subjectId":"126050"},{"characterId":"91867","match":"source-roster","subjectId":"145539"},{"characterId":"91867","match":"source-roster","subjectId":"157929"},{"characterId":"91867","match":"source-roster","subjectId":"194251"},{"characterId":"91867","match":"source-roster","subjectId":"295256"},{"characterId":"91867","match":"source-roster","subjectId":"330857"},{"characterId":"91867","match":"exact-normalized-name-in-linked-work","subjectId":"523724"},{"characterId":"91867","match":"source-roster","subjectId":"523724"},{"characterId":"91867","match":"source-roster","subjectId":"59663"}],"egsCharacterIds":["9259"],"vndbCharacterId":"c26444"},"originalCharacterName":"エドウィン・ブラック","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ノマドの創始者。吸血鬼の始祖。"},{"spoiler":false,"text":"吸血鬼の始祖とは、生まれながらの吸血鬼であることを意味し、人間が変じた吸血鬼と違い、完全に不死身で伝承にあるように弱点はなく、日光のもとも平気でいることができる。"},{"spoiler":false,"text":"別名、「デイ・ウォーカー」とも言われる。"},{"spoiler":false,"text":"魔界では支配者階級に属する強力な存在。"},{"spoiler":false,"text":"永遠不滅の生命の中で、彼は永劫の虚無にあり、常に刺激や快楽を求めている。"},{"spoiler":false,"text":"陰謀と生死をかけた戦闘こそ唯一彼に生の充足を与えるものとなっている。"}],"source":"egs","sourceCharacterId":"9259","sourceWorkId":"16312","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c75c9bff4925a2122a2dbc878bb008e9b3a21485f0fbde980c95865c0b663e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96c58c0f9ced11f921b70f241ec7b198a80249f5d8ecacf8eb25baa80363f046.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c6809","characterName":"井河 アサギ","sourceIds":{"bangumi":[{"characterId":"46109","match":"exact-normalized-name-in-linked-work","subjectId":"126047"},{"characterId":"46109","match":"exact-normalized-name-in-linked-work","subjectId":"194251"},{"characterId":"46109","match":"exact-normalized-name-in-linked-work","subjectId":"195854"},{"characterId":"46109","match":"exact-normalized-name-in-linked-work","subjectId":"259337"},{"characterId":"46109","match":"exact-normalized-name-in-linked-work","subjectId":"303915"},{"characterId":"46109","match":"exact-normalized-name-in-linked-work","subjectId":"523724"}],"egsCharacterIds":["9255"],"vndbCharacterId":"c6809"},"originalCharacterName":"井河 アサギ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1217"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflic