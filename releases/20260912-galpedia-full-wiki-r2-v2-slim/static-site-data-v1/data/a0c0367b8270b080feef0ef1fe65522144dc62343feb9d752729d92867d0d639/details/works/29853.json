{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29853","model":{"presentationWorkId":"vndb:v28881","staff":{"artwork":[{"creditedName":"谷山さん","creatorId":"vndb:s15128","sourcePersonId":"egs:creator:31366","canonicalEntityId":"vndb:s15128","name":"谷山さん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:223690","source":"egs"}],"scenario":[{"creditedName":"早瀬ゆう","creatorId":"vndb:s3034","sourcePersonId":"egs:creator:14059","canonicalEntityId":"vndb:s3034","name":"早瀬ゆう","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:223691","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c86175","characterName":"シャルローネ・ドーラン","sourceIds":{"vndbCharacterId":"c86175"},"originalCharacterName":"シャルローネ・ドーラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hee hee. I think I warned Your Majesty? My love runs deadly deep...\""},{"spoiler":false,"text":"The daughter of a powerful merchant noble, she is the protagonist's other arranged partner along with Sophia."},{"spoiler":false,"text":"As a child, she was exposed to a variety of places and cultures, along with the world of the rich and powerful. As a result, she has a degree of refinement that goes far beyond the norm for a woman her age. Unfortunately, her experiences in life have left her with a somewhat less than straightforward personality that hides a potential for near-yandere love."},{"spoiler":false,"text":"She is very manipulative, using her elegance and charms to make people (specially men) dance on her strings."}],"source":"vndb","sourceCharacterId":"c86175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/faa1124e539fcdc9907d3a4d8c5858ce016e218b5f422ff8cf004a9e44a3860c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e968c92f3dc60298e62417eb4496c48367d2a59c9a38c097d6e7ee01ad682d6.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85384","source":"vndb"}]},{"characterId":"char_vndb_c86176","characterName":"マルー・アルトウィン","sourceIds":{"vndbCharacterId":"c86176"},"originalCharacterName":"マルー・アルトウィン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"That ought to be enough playing around. You mustn't let me spoil you.\""},{"spoiler":false,"text":"The youngest-ever chancellor of the kingdom of Palretta who runs the kingdom's daily affairs with absolute competence."},{"spoiler":false,"text":"She serves the protagonist, her king, with distinction, as his closest aide in official matters. In her eyes, the country far outweighs her own life, and she has no interest in pursuing love."},{"spoiler":false,"text":"Though imperturbable and unruffled herself, she exhibits considerable kindness and thought for the needs of her new sovereign, to the point of being very tolerant of his foibles, accepting him for who he is from beginning to end."},{"spoiler":false,"text":"Edited from Steam"},{"spoiler":true,"text":"She is the protagonist's older half-sister, born of the same mother. As a child, she took on the task of raising him until he turned eight, when he was transported to Earth. She loves him deeply and intensely to the point of obsession."}],"source":"vndb","sourceCharacterId":"c86176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86e37ef515dd480e8ea225fd2dc741ba69d801a05bce97a490bab4fb0401928b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed01aa081050ed960b16929d9019f5662d7ac7efa24e71094a196ba48ae65b4a.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木住 葵","creatorId":"vndb:s8350","sourcePersonId":"vndb:s8350","canonicalEntityId":"vndb:s8350","name":"木住 葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85385","source":"vndb"}]},{"characterId":"char_vndb_c88192","characterName":"主人公","sourceIds":{"vndbCharacterId":"c88192"},"originalCharacterName":"主人公","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p328","sourceCompanyId":"egs:brand:1937","canonicalEntityId":"vndb:p328","name":"SMEE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29853:1937","source":"egs"},{"companyId":"vndb:p328","sourceCompanyId":"vndb:p328","canonicalEntityId":"vndb:p328","name":"SMEE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107837:v28881","source":"vndb"},{"companyId":"vndb:p328","sourceCompanyId":"vndb:p328","canonicalEntityId":"vndb:p328","name":"SMEE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:156542:v28881","source":"vndb"},{"companyId":"vndb:p328","sourceCompanyId"