なしにいい子。"},{"spoiler":false,"text":"……なのだが、どういうわけか一太郎にだけは、ときおりキツい視 線を向けてくる。"}],"source":"egs","sourceCharacterId":"20157","sourceWorkId":"26855","spoiler":false},{"segments":[{"spoiler":false,"text":"学校と、バイト先であるケーキ屋『Fille et lait（フィーユ・エ・レ）』の後輩。"},{"spoiler":false,"text":"客が来てくれるのがうれしい、と全身で言っているようなニコニコと愛想のいい接客ぶりで、"},{"spoiler":false,"text":"一番の新米ながら客からは人気者。『こじかびより』と呼ばれて親 しまれまくっている。"},{"spoiler":false,"text":"小柄だが胸は大きく、素朴ながら可愛らしい容姿の女の子。"},{"spoiler":false,"text":"素直で人当たりがよく、女の子らしい性格の、文句なしにいい子。"},{"spoiler":false,"text":"……なのだが、どういうわけか一太郎にだけは、ときおりキツい視 線を向けてくる。"}],"source":"bangumi","sourceCharacterId":"64317"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"20157","sourceWorkId":"26855","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"20157","sourceWorkId":"26855","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"20157","sourceWorkId":"26855","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"20157","sourceWorkId":"26855","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"20157","sourceWorkId":"26855","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/eca77a7f6cd82af77cdcfa135ad0f77c0c95c16450bb4ed277045b5224f46368.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c93fc33e3af768d2a00809ff6772ffb4412ea82a4b9d50d8cfc49b52a002bf24.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎未來","creatorId":"vndb:s986","sourcePersonId":"vndb:s986","canonicalEntityId":"vndb:s986","name":"尾崎 未來","roleCode":"voice-actor","roleLabel":"声优","identityStatus":