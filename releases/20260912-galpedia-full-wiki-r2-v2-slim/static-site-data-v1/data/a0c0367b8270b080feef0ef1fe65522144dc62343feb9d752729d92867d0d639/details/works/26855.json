ce":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"303"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yachiyo and Ichitaro have been friends since they were little. While Yachiyo is one year older than him, she doesn't look like it, due to her short stature and childlike looks."},{"spoiler":false,"text":"As the daughter of the shrine's head priest, she carries herself with the grace and beauty expected of a traditional priestess."},{"spoiler":false,"text":"She seems to be very concerned about the recent rumors regarding the \"charm of misfortune\"."},{"spoiler":false,"text":"From English official website"}],"source":"vndb","sourceCharacterId":"c71928"},{"segments":[{"spoiler":false,"text":"幼なじみのお姉さん。"},{"spoiler":false,"text":"ただし外見は年上とは思えないほどに小さく幼い。"},{"spoiler":false,"text":"神社の宮司の娘であり、巫女さんというだけあって、上品で清楚な物腰の大和撫子。"},{"spoiler":false,"text":"『破局のご利益』の評判で、最近は忙しく過ごしている模様。"}],"source":"egs","sourceCharacterId":"20160","sourceWorkId":"26855","spoiler":false},{"segments":[{"spoiler":false,"text":"一太郎の幼なじみで、神社の宮司の娘である巫女さん。 ひとつ上とは思えないほど小柄で幼い容姿の持ち主。 しかし、親の厳しいしつけもあって、物腰は上品で貞淑、清楚そのものの、『小さな大和撫子』と言うにふさわしい女の子。"},{"spoiler":false,"text":"その幼い容姿と特殊な立場で、どうやら学校では浮き気味な模様。 が、本人はそれについて、諦めて受け入れてしまっている。 さらには、神社の娘ではあるが、神様やお守りのことは別に信じていないとのこと。"},{"spoiler":false,"text":"しかし本心では……。"}],"source":"egs","sourceCharacterId":"20160","sourceWorkId":"29735","spoiler":false},{"segments":[{"spoiler":fals