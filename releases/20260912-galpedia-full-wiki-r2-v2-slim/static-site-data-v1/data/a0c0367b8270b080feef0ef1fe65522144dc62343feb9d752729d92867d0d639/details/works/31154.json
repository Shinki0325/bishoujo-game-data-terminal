tive","relationId":"vndb:vn-staff:164940","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c88704","characterName":"天音 愛","sourceIds":{"vndbCharacterId":"c88704"},"originalCharacterName":"天音 愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ai and Nobu were friends when they were kids, but they lost touch after her family moved away."},{"spoiler":false,"text":"She came to Tokyo for college, and offered a helping hand (and her apartment) to her old friend in his time of need."},{"spoiler":false,"text":"A young woman who treats everyone she meets with equal kindness, she practically exudes an aura of purity. Sometimes it's hard to tell if she's really just that nice, or maybe a little naive."},{"spoiler":false,"text":"Smart and athletic, she may seem perfect at first, but she can be surprisingly stubborn at times."},{"spoiler":false,"text":"She also has a more laid-back, casual side that she only shows in private, and to those she truly trusts."},{"spoiler":false,"text":"Ai's kind heart can sometimes get her in trouble. She has a habit of throwing her all into helping people, treating their problems as her own, while forgetting to take care of herself."}],"source":"vndb","sourceCharacterId":"c88704"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/627ca645b9aa45a1f0e0e65c365c32e75cf5b21b4b9f81c088b30ed0c775580b.webp","fallbackUrl":"https://wiki-as