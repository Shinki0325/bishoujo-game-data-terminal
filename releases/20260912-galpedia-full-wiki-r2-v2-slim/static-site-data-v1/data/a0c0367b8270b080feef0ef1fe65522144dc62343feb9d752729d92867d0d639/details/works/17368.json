alue":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takurou and Nanagi's childhood friend, and Takurou's classmate. A second year at Midori Minami Academy. A cheerful girl raised in an ordinary home in Takurou's neighborhood. She sometimes calls Takurou \"Sawatari-san\"."},{"spoiler":false,"text":"Because of that, she's sometimes misunderstood as being together with Takurou, but she and Takurou don't mind. She really liked getting into Takurou's small plays. She has a good figure and looks and is easy to talk to, so she has a lot of secret admirers."},{"spoiler":false,"text":"\"'Kiyaa! Takurou you pervert!\" I can't believe you! Idiooot!'' ...Well, you want to direct a moe childhood friend?\""}],"source":"vndb","sourceCharacterId":"c10716"},{"segments":[{"spoiler":false,"text":"拓郎と七凪の幼馴染で、拓郎のクラスメイト。緑南学園の二年生。"},{"spoiler":false,"text":"拓郎の家の近所に住んでいるごく普通の家庭で生まれ育った明るい少女。"},{"spoiler":false,"text":"拓郎を「沢渡さん」と呼びしょっちゅうちょっかいをかける。"},{"spoiler":false,"text":"拓郎もその時は「真鍋さん」と呼び、ノリノリで会話を展開させるが、ノリが良すぎて周囲が若干引くくらいのコントへと発展することがままある。"},{"spoiler":false,"text":"妹の七凪などはそんな二人のやり取りを見て、「また小芝居ですか」と若干の嫉妬をこめつつ呆れている。"},{"spoiler":false,"text":"小芝居以外の時は拓郎のことを「タク」と呼び、まるで夫婦のごときツーカーの仲である。"},{"spoiler":false,"text":"そのため拓郎と付き合っていると誤解されることもよくあるが、当人達はまるで気にしていない。"},{"spoiler":false,"text":"コンビニのお菓子が大好きで、放送部でちょっとしたメデタイことがあるとすぐ「宴会だー！」と叫んでドコからともなく大量のスナック菓子を召還させてテーブルにぶちまける。"},{"spoiler":false,"text":"でも、体重のことをいつも気にかけて節制しているのでスタイルは良い。"},{"spoiler":false,"text":"ルックスも良く、話しやすいので学園内に隠れファンが多い。"}],"source":"egs","sourceCharacterId":"6675","sourceWorkId":"17368","spoiler":false},{"segments":[{"spoiler":false,"text":"拓郎と七凪の幼なじみで、拓郎のクラスメイト。 緑南学園の二年生。"},{"spoiler":false,"text":"拓郎の家の近所に住んでいる、ごく普通の家庭で生まれ育った明るい少女。"},{"spoiler":false,"text":"時折、拓郎を 「沢渡さん」 と呼びちょっかいをかけたりする。"},{"spoiler":false,"text":"そのため拓郎と付き合っていると誤解されることもたまにあるが、本人も拓郎も気にしない。"},{"spoiler":false,"text":"拓郎の小芝居に一番付き合ってくれるノリの良い子。"},{"spoiler":false,"text":"スタイルもルックスも良く、話しやすいので学園内に隠れファンが多い。"},{"spoiler":false,"text":"「『きゃーっ！ タクのエッチ！　もう信じられない！ 馬鹿ぁっ！』"},{"spoiler":false,"text":"――って、萌え幼なじみを演出したほうがいいでしょうか？」"}],"source":"bangumi","sourceCharacterId":"17964"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"6675","sourceWorkId":"17368","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"6675","sourceWorkId":"17368","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"6675","sourceWorkId":"17368","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"6675","sourceWorkId":"17368","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7656520c55c3cca8452e712a7e9944d2092516e646c3c29a5234e90aefa03ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8377d5097c5e05f05fb766c3d093c0ec92015dc8ffaadb76ce21ae3d83db91cc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"種﨑敦美","creatorId":"vndb:s196","sourcePersonId":"vndb:s196","canonicalEntityId":"vndb:s196","name":"種﨑 敦美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:44770:17964:7575:1","source":"bangumi"}]},{"characterId":"char_c32836","characterName":"田中 流々","sourceIds":{"bangumi":[{"characterId":"17966","match":"exact-normalized-name-in-linked-work","subjectId":"44770"}],"egsCharacterIds":["6676"],"vndbCharacterId":"c32836"},"originalCharacterName":"田中 流々","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict",