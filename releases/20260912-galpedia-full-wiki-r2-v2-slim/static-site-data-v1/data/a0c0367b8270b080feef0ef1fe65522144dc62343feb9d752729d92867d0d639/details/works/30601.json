he girls side."}],"source":"vndb","sourceCharacterId":"c88487"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd252c8f6d61a29a6a6263efa14499f9362abe49873acc8e35c0f3726591f049.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f17b23cbf54aa2e8bd97a599b8cee4cf8886a56cd78af5a8c945f4f8da8c6b64.webp","width":249,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新田 ひより","creatorId":"vndb:s20487","sourcePersonId":"vndb:s20487","canonicalEntityId":"vndb:s20487","name":"新田 ひより","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:83711","source":"vndb"}]},{"characterId":"char_vndb_c88488","characterName":"六条オウガ","sourceIds":{"vndbCharacterId":"c88488"},"originalCharacterName":"六条オウガ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student on the boys side like Minato, who he befriends as his only classmate. He is the son of a distinguished family, who despite his age is the representative of a major company. He believes his muscles are the most beautiful in this world, and immediately tries to put his physical beauty on display. He disliked women, thinking that they are weak, but changes his mind after crossing paths with the Erika’s grandeur."}],"source":"vndb","sourceCharacterId":"c88488"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01f1a029e7d0a0e902c1ea8e88da8cd83e540712bbc68818af3e5f705d3918d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d07f87f1146824544338da058384af84cb5426b965c17079350c7947802439e9.webp","width":25