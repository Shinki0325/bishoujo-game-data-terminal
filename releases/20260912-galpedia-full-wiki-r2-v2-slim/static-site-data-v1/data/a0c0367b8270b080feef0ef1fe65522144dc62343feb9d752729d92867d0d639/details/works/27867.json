tyStatus":"auto-confirmed","relationId":"egs:work-creator:208067","source":"egs"},{"creditedName":"みらくる☆みきぽん(ミラクルみきぽん)","creatorId":"vndb:s10710","sourcePersonId":"egs:creator:12899","canonicalEntityId":"vndb:s10710","name":"みらくる☆みきぽん(ミラクルみきぽん)","detail":"CG監修","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:208071","source":"egs"},{"creditedName":"紫刀","creatorId":"vndb:s8282","sourcePersonId":"egs:creator:23141","canonicalEntityId":"vndb:s8282","name":"紫刀","detail":"CG監修","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:208072","source":"egs"},{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"egs:creator:20500","canonicalEntityId":"vndb:s3053","name":"カサンドラ","detail":"主題歌「ユキノハナ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:208073","source":"egs"},{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"vndb:s3053","canonicalEntityId":"vndb:s3053","name":"カサンドラ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:156756","source":"vndb"},{"creditedName":"紫刀","creatorId":"vndb:s8282","sourcePersonId":"vndb:s8282","canonicalEntityId":"vndb:s8282","name":"紫刀","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:156757","source":"vndb"},{"creditedName":"夏凛とーご","creatorId":"vndb:s10002","sourcePersonId":"vndb:s10002","canonicalEntityId":"vndb:s10002","name":"夏凛とーご","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:156759","source":"vndb"},{"creditedName":"みらくる☆みきぽん","creatorId":"vndb:s10710","sourcePersonId":"vndb:s10710","canonicalEntityId":"vndb:s10710","name":"ミラクル☆みきぽん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:156761","source":"vndb"}]},"cast":[{"characterId":"char_c82312","characterName":"斐川 有希","sourceIds":{"bangumi":[{"characterId":"69780","match":"exact-normalized-name-in-linked-work","subjectId":"280796"}],"egsCharacterIds":["21555"],"vndbCharacterId":"c82312"},"originalCharacterName":"斐川 有希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of the protagonist."}],"source":"vndb","sourceCharacterId":"c82312"},{"segments":[{"spoiler":false,"text":"人見知りが激しい、主人公の妹。"},{"spoiler":false,"text":"小柄で華奢、心優しい少女だが、自分からは何もできず、友達は居ない。"},{"spoiler":false,"text":"突然、兄である主人公の家に居候を希望し、同居することになる。"},{"spoiler":false,"text":"癖は他人から逃げるために染み付いた、謝罪と「へへへ……」という愛想笑い。"},{"spoiler":false,"text":"そんな情けない自分を変えようと、彼女なりに頑張っていく。"}],"source":"egs","sourceCharacterId":"21555","sourceWorkId":"27867","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"地方の村に住む、小柄で心優しい少女。"},{"spoiler":false,"text":"くせっ毛で、ボサボサ頭。"},{"spoiler":false,"text":"極度の人見知りで、"},{"spoiler":false,"text":"身内以外の人間と上手に話せず、"},{"spoiler":false,"text":"学校のクラスでも浮いている存在。"},{"spoiler":false,"text":"いじめを受けた過去から"},{"spoiler":false,"text":"他人と極力関わり合いを持たないようにしており、"},{"spoiler":false,"text":"相手から見られないように……"},{"spoiler":false,"text":"また、相手を見ないで済むように、"},{"spoiler":false,"text":"髪を長く伸ばしている。"},{"spoiler":false,"text":"そのせいで、表情と感情が読み取りにくい。"},{"spoiler":false,"text":"癖はすぐ謝ってしまうことと、"},{"spoiler":false,"text":"「へへへ…」という愛想笑い。"},{"spoiler":false,"text":"他人との会話を早く終わらせるために覚えた行為が、"},{"spoiler":false,"text":"いつのまにか癖として定着してしまった。"},{"spoiler":false,"text":"兄である主人公が居た頃は"},{"spoiler":false,"text":"いつも彼に守られていたため、とても慕っている。"},{"spoiler":false,"text":"なにか兄の役に立ちたいと、いつも思っている。"},{"spoiler":false,"text":"冬休みを利用して、"},{"spoiler":false,"text":"突然、たった一人で兄の住む街にやってくる。"},{"spoiler":false,"text":"情けない自分を変えるために、彼女なりに頑張っていく。"}],"source":"bangumi","sourceCharacterId":"69780"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86f97975222e3c3e3f110b485c7aa0cc846093ec454e432057464cfcb5a3f0df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee8405aeeffbc95b0c88ad31659ccac23fb19f2071a820552086ab49b0ebb6ea.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"よぴこ","creatorId":"vndb:s5259","sourcePersonId":"vndb:s5259","canonicalEntityId":"vndb:s5259","name":"よぴこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81166","source":"vndb"}]},{"characterId":"char_c82313","characterName":"久我 紗英","sourceIds":{"bangumi":[{"characterId":"69781","match":"exact-normalized-name-in-linked-work","subjectId":"280796"}],"egsCharacterIds":["21556"],"vndbCharacterId":"c82313"},"originalCharacterName":"久我 紗英","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The cousin of the protagonist"}],"source":"vndb","sourceCharacterId":"c82313"},{"segments":[{"spoiler":false,"text":"従妹。主人公が街に出てきてからの妹的存在。"},{"spoiler":false,"text":"元気で明るく、少しおつむが緩い。学校では新体操部に所属。"},{"spoiler":false,"text":"主人公の家に入り浸り、勉強を教えてもらっているが、要領が悪くてなかなか成績が上がらない。"},{"spoiler":false,"text":"流されやすい性格で、クラスの子に吹き込まれ、主人公へ恋心をいだく。"},{"spoiler":false,"text":"主人公を取り巻く状況の変化により、「女の子」として見てもらいたいと焦る。"}],"source":"egs","sourceCharacterId":"21556","sourceWorkId":"27867","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従妹。元気で明るい性格。"},{"spoiler":false,"text":"クラスの人気者でムードメーカーなお調子者。"},{"spoiler":false,"text":"斐川兄妹とは幼い頃からの知己。有希の２つ上。"},{"spoiler":false,"text":"少々おつむが緩くて抜けたところがある。"},{"spoiler":false,"text":"主人公が街へ出てくる際に"},{"spoiler":false,"text":"紗英の両親に世話になったのをきっかけとして、"},{"spoiler":false,"text":"よく主人公の家に出入りするようになった。"},{"spoiler":false,"text":"現在の妹的存在。"},{"spoiler":false,"text":"学校の成績がかなり……いや、非常に良くなく、"},{"spoiler":false,"text":"主人公に家庭教師としてついてもらっている。"},{"spoiler":false,"text":"しかし集中力が無いため、"},{"spoiler":false,"text":"思うようにテストの点数は伸びていない。"},{"spoiler":false,"text":"いつもメモ帳を持ち歩いていて、事あるごとにメモしている。"},{"spoiler":false,"text":"本人が間違って受け取ることも多く、"},{"spoiler":false,"text":"あまり役立つことは書かれてないかも。"},{"spoiler":false,"text":"クラスの子に吹き込まれ、主人公に恋心をいだいているが、"},{"spoiler":false,"text":"恋に恋するお年頃であり、深く考えているかは定かではない。"},{"spoiler":false,"text":"学校で新体操部に所属しており、運動神経は抜群。"},{"spoiler":false,"text":"プロポーションも同年代の中では良く、男子の人気も割と高いが、"},{"spoiler":false,"text":"本人は全く気づいていない。"},{"spoiler":false,"text":"そんな「ないないづくし」の彼女だが、"},{"spoiler":false,"text":"主人公との関係を変えたいと、本人なりにドタバタ頑張る。"}],"source":"bangumi","sourceCharacterId":"69781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20b82f362165cbbf9ba659cbc9145b2dbdfdaa4405c6e6d72f3df2951aae689d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf40fe859c32950ab8596e977e9c0c9a62f30b1cc8ca7244b3d6a41cc7638867.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井まみ","creatorId":"vndb:s939","sourcePersonId":"vndb:s939","canonicalEntityId":"vndb:s939","name":"平井 まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:280796:69781:18547:1","source":"bangumi"}]},{"characterId":"char_c82314","characterName":"如月 千佳","sourceIds":{"bangumi":[{"characterId":"69782","match":"exact-normalized-name-in-linked-work","subjectId":"280796"}],"egsCharacterIds":["21557"],"vndbCharacterId":"c82314"},"originalCharacterName":"如月 千佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The former classmate of Yuki."}],"source":"vndb","sourceCharacterId":"c82314"},{"segments":[{"spoiler":false,"text":"正義感が強いけど口が悪い、活発な少女。"},{"spoiler":false,"text":"かつての有希のクラスメイトで、去年引っ越してから交流が途絶えていた。"},{"spoiler":false,"text":"有希と街で偶然、再会する。"},{"spoiler":false,"text":"村にいた頃から、ずっと有希のことが心に引っかかり続けており、この機会にふたたび交流を持とうと、多少強引に近づいてくる。"}],"source":"egs","sourceCharacterId":"21557","sourceWorkId":"27867","spoiler":false},{"segments":[{"spoiler":false,"text":"かつての有希のクラスメイト。"},{"spoiler":false,"text":"目立ちたがりで口が悪い、強気な少女。"},{"spoiler":false,"text":"当時は学級委員長を務め、"},{"spoiler":false,"text":"みんなのリーダーとしてクラスを引っ張っていた。"},{"spoiler":false,"text":"クラスメイトが有希を遠ざけ、"},{"spoiler":false,"text":"有希自身も遠ざかろうとする中、"},{"spoiler":false,"text":"自分と真逆の彼女をずっと気にかけていた。"},{"spoiler":false,"text":"家庭の事情で、"},{"spoiler":false,"text":"今の学年に上がる前に街へ引っ越してしまい、"},{"spoiler":false,"text":"それ以来、有希との交流は途絶えていたのだが……。"},{"spoiler":false,"text":"正義感が強く、オトナコドモ関係なく"},{"spoiler":false,"text":"間違ったことに一言いわないと気がすまないタイプ。"}],"source":"bangumi","sourceCharacterId":"69782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab9331e0fa0077d2e91aa1007d09bad8d76a61b5ac5f979e39167910d10858e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/719c238dc8f6053d0c9cec9adde9b2ab30ddcc8ea5a673fffeb4f764535bea06.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"mahilo","creatorId":"vndb:s1492","sourcePersonId":"vndb:s1492","canonicalEntityId":"vndb:s1492","name":"眞尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:280796:69782:34633:1","source":"bangumi"}]},{"characterId":"char_vndb_c82320","characterName":"斐川 慎吾","sourceIds":{"vndbCharacterId":"c82320"},"originalCharacterName":"斐川 慎吾","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"sour