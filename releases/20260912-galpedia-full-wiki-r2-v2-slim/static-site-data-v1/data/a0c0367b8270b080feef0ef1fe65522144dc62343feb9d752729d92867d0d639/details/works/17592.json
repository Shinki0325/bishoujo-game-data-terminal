914","match":"exact-normalized-name-in-linked-work","subjectId":"135242"}],"egsCharacterIds":["5094"],"vndbCharacterId":"c12723"},"originalCharacterName":"葛城 依理子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuushi's older sister who was disowned by her parents after getting pregnant. Now in her early 30s, she doesn't have a very happy marriage as her husband constantly cheats on her. And so she decides to cheat on him too."}],"source":"vndb","sourceCharacterId":"c12723"},{"segments":[{"spoiler":false,"text":"【音信不通だった大好きな人妻の姉】"},{"spoiler":false,"text":"有史の姉で子持ち人妻。３０代前半。"},{"spoiler":false,"text":"見た目が非常に若く年齢よりも5、6歳若く見られ、プロポーションも抜群。"},{"spoiler":false,"text":"普段は夫の浮気に耐え、明るくノリもいいが、内面は結構傷つき易く、１人の時は泣いていることもしばしば。"},{"spoiler":false,"text":"ブラコンでもあり、初めの内は何かある度に時折外に有史を呼び出し、彼に甘え倒しストレス発散をしていたが、有史が一人暮らしで音信不通となってからはストレス発散方法が無くなり、夫と度々衝突するようになる。"},{"spoiler":false,"text":"やがて、夫の度重なる浮気発覚に耐えかね、とうとう娘を連れて家を飛び出し、有史の家を探し出して押し掛けてくる。"}],"source":"egs","sourceCharacterId":"5094","sourceWorkId":"17592","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・有史の姉で子持ちの人妻。 30代前半。"},{"spoiler":false,"text":"見た目が非常に若く、年齢よりも 5-6歳若く見られ、プロポーションも抜群。"},{"spoiler":false,"text":"明るくノリが良く夫の浮気にも耐えるが、内面はけっこう傷つきやすく、独りの時は泣いていることもしばしば。"},{"spoiler":false,"text":"実はブラコンで、何かある度に有史を呼び出し、彼に甘え倒してストレスを発散していた。"},{"spoiler":false,"text":"だが有史が一人暮らしで音信不通となってからはストレス発散方法が無くなり、夫と度々衝突するようになる。"},{"spoiler":false,"text":"やがて夫のたび重なる浮気発覚に耐えかね、とうとう娘を連れて家を飛び出し、有史の家を探し出して押し掛けてくる。"}],"source":"bangumi","sourceCharacterId":"40914"}],"profileFacts":[{"label":"年龄（本版本）","value":"30 岁","valueContext":null,"source":"egs","sourceCharacterId":"5094","sourceWorkId":"17592","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/445c9caae0e27ab543cac7c18d233e417085b37abf9b79ab4123458408d623f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6d8a2eb539983ed21ba1d98d2aecb2f5d590145ce3cb7736265bbb8f63834ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:135242:40914:13773:1","source":"bangumi"}]},{"characterId":"char_c12724","characterName":"葛城 碧璃","sourceIds":{"bangumi":[{"characterId":"40915","match":"exact-normalized-name-in-linked-work","subjectId":"135242"}],"egsCharacterIds":["5095"],"vndbCharacterId":"c12724"},"originalCharacterName":"葛城 碧璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuushi's niece and Yoriko's daughter. Due to her father constantly cheating on her mother and watching her suffering for a long time now, she became rebellious and has very little trust in men."}],"source":"vndb","sourceCharacterId":"c12724"},{"segments":[{"spoiler":false,"text":"【軽い男性不信だが、Hには興味津々な姉の娘】"},{"spoiler":false,"text":"依理子の娘で有史の姪。"},{"spoiler":false,"text":"父親の浮気性やそれによって母が泣く姿を何度も見ている為、現在軽い男性不信の反抗期。"},{"spoiler":false,"text":"どこか世の中を醒めた目で見てる。"},{"spoiler":false,"text":"彼氏はいるが、父親とは正反対の浮気は一切しない"},{"spoiler":false,"text":"気立ての優しい草食系を選んだ為、未だ手を繋ぐところ止まり。"},{"spoiler":false,"text":"父親のような超肉食は嫌だが、さすがにもう少し強引に迫ってきて欲しい欲求不満気味。"},{"spoiler":false,"text":"エッチには大いに興味あり。"}],"source":"egs","sourceCharacterId":"5095","sourceWorkId":"17592","spoiler":false},{"segments":[{"spoiler":false,"text":"依理子の娘で有史の姪。"},{"spoiler":false,"text":"父親の浮気性や、それによって母が泣く姿を何度も見ているため、現在軽い男性不信の反抗期。"},{"spoiler":false,"text":"どこか世の中を醒めた目で見ている。"},{"spoiler":false,"text":"彼氏はいるが、父親とは正反対の気立ての良い草食系を選んだため、いまだ手を繋ぐ止まり。"},{"spoiler":false,"text":"父親のような超肉食は嫌だが、さすがにもう少し強引に迫ってきてほしい欲求不満気味。"},{"spoiler":false,"text":"エッチには大いに興味あり。"}],"source":"bangumi","sourceCharacterId":"40915"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c04cb9caa3f5d394692d8b41a8e230a0aaf3807e78cb8f13fc090b71c3cc3e5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6edf4d8ab687839464a1c015b4497491d14beba2fb303613d9a4b0b9ea8a614.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:135242:40915:6359:1","source":"bangumi"}]},{"characterId":"char_c12725","characterName":"桐乃木 奏","sourceIds":{"bangumi":[{"characterId":"40916","match":"exact-normalized-name-in-linked-work","subjectId":"135242"}],"egsCharacterIds":["5096"],"vndbCharacterId":"c12725"},"originalCharacterName":"桐乃木 奏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mitsuo's lover and woman whom he cheats on with his wife, a nice and elegant-looking woman. She doesn't feel the guilt from her relationship with Mitsuo, and Kanade constantly requests him to divorce with his wife."}],"source":"vndb","sourceCharacterId":"c12725"},{"segments":[{"spoiler":false,"text":"【姉の夫との不倫に何の罪悪感も覚えない女子大生】"},{"spoiler":false,"text":"依理子の夫、光男の浮気相手。"},{"spoiler":false,"text":"決して主張せず、とにかく尽くし、控えめで見た目清楚な感じの為、男にとって理想的ともいえる女性だが、浮気していることに罪悪感を感じないなど、どこかズレている。"},{"spoiler":false,"text":"しかも、何とか依理子と離婚してもらい自分が妻の座に着こうと光男を時折説得している。"}],"source":"egs","sourceCharacterId":"5096","sourceWorkId":"17592","spoiler":false},{"segments":[{"spoiler":false,"text":"依理子の夫・光男の浮気相手。"},{"spoiler":false,"text":"決して主張せず、とにかく尽くし、控えめで見た目清楚な感じ。"},{"spoiler":false,"text":"男にとって理想的とも言える女性だが、浮気していることに罪悪感を感じないなど、どこかズレている。"},{"spoiler":false,"text":"しかも、なんとか依理子と離婚してもらい自分が妻の座に着こうと、光男を度々説得している。"}],"source":"bangumi","sourceCharacterId":"40916"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa160d198cff35d08b798ad5efba63e191f34891d36c07bbbfe32ddc7d07a8bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3154dcd4e1c8bc41edd4e7274e142b9c99fab7bb99de0d9b72a5f5da683ecff1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:135242:40916:6469:1","source":"bangumi"}]},{"characterId":"char_c12726","characterName":"葛城 光男","sourceIds":{"bangumi":[],"egsCharacterIds":["5097"],"vndbCharacterId":"c12726"},"originalCharacterName":"葛城 光男","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yoriko's unfaithful husband."}],"source":"vndb","sourceCharacterId":"c12726"},{"segments":[{"spoiler":false,"text":"依理子の夫。"},{"spoiler":false,"text":"姉の学生時代の担任であり、受け持ち中に手を出し出来婚した。"},{"spoiler":false,"text":"基本、若い女が大好きな為、最初は上手くいっていた夫婦関係も姉が年齢を重ねるにつれて、態度が素っ気なくなっていき既に何度も浮気を行っている。"},{"spoiler":false,"text":"しかし、独占欲も強い為、妻も浮気相手も手放す気はなくこのままの関係を続けていきたいと都合のいいことを考えている。"}],"source":"egs","sourceCharacterId":"5097","sourceWorkId":"17592","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image"