sic","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:90445","source":"egs"},{"creditedName":"安瀬 聖","creatorId":"vndb:s759","sourcePersonId":"vndb:s759","canonicalEntityId":"vndb:s759","name":"安瀬 聖","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:63554","source":"vndb"}],"other":[{"creditedName":"どせい","creatorId":"vndb:s4161","sourcePersonId":"egs:creator:15665","canonicalEntityId":"vndb:s4161","name":"どせい","detail":"ムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112590","source":"egs"},{"creditedName":"紺野アスタ","creatorId":"vndb:s1641","sourcePersonId":"egs:creator:13862","canonicalEntityId":"vndb:s1641","name":"紺野アスタ","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:90444","source":"egs"},{"creditedName":"Duca","creatorId":"vndb:s386","sourcePersonId":"egs:creator:12492","canonicalEntityId":"vndb:s386","name":"Duca","detail":"OP曲「Snow wish」、ED曲「With you」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:95367","source":"egs"},{"creditedName":"Duca","creatorId":"vndb:s386","sourcePersonId":"vndb:s386","canonicalEntityId":"vndb:s386","name":"Duca","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:63553","source":"vndb"},{"creditedName":"紺野 アスタ","creatorId":"vndb:s1641","sourcePersonId":"vndb:s1641","canonicalEntityId":"vndb:s1641","name":"紺野 アスタ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63557","source":"vndb"},{"creditedName":"どせい","creatorId":"vndb:s4161","sourcePersonId":"vndb:s4161","canonicalEntityId":"vndb:s4161","name":"どせい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63561","source":"vndb"}]},"cast":[{"characterId":"char_c3048","characterName":"ヴィオレッタ・ソレイユ","sourceIds":{"bangumi":[{"characterId":"12872","match":"exact-normalized-name-in-linked-work","subjectId":"14111"}],"egsCharacterIds":["23374"],"vndbCharacterId":"c3048"},"originalCharacterName":"ヴィオレッタ・ソレイユ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"騎士の国・コラングレインからやってきた、名門貴族のお姫様。"},{"spoiler":false,"text":"実直で、ひたすら真っ直ぐ突き進む猪突猛進な性格。"},{"spoiler":false,"text":"プライドが高いので、露骨な嫉妬はなかなか見せない。"},{"spoiler":false,"text":"征斗のフィアンセであり、結婚するために遠路はるばる来日した。"},{"spoiler":false,"text":"ソレイユ家には男子がなく跡取りとして育てられたため、まるで男子のような振る舞いをする。"},{"spoiler":false,"text":"男言葉をしゃべり威風堂々と振る舞う姿は、彼女の美貌と相まって、凛々しき戦の女神を思わせる。"},{"spoiler":false,"text":"幼い頃から磨き続けてきた剣の腕は相当なもので、未だ男子にも負けたことがないというのが自慢。"},{"spoiler":false,"text":"親の決めた相手と結婚するため来日した彼女だが、その胸に秘めたる想いは果たして……？"}],"source":"egs","sourceCharacterId":"23374","sourceWorkId":"14605","spoiler":false},{"segments":[{"spoiler":false,"text":"来自骑士之国·コラングレイン的名门贵族公主。"},{"spoiler":false,"text":"正直、直率、勇往直前、横冲直撞的性格。"},{"spoiler":false,"text":"由于自尊心很强，没有比较露骨的嫉妒行为。"},{"spoiler":false,"text":"身为征斗的未婚妻，为了结婚而不远万里来到日本。"},{"spoiler":false,"text":"由于ソレイユ家没有男子，而把她作为继承人养育，因此她的行为举止像男孩子一样。"},{"spoiler":false,"text":"那用男子口气说话的威风凛凛的身姿，与她的美貌交相辉映，让人不禁联想到凛凛的战女神。"},{"spoiler":false,"text":"从小时候起就开始磨练的剑术已经相当厉害，以至今没有输给过男子为傲。"},{"spoiler":false,"text":"她虽然是为了和父母决定的对象结婚而来到日本，但她心中暗藏的思念到底是……"},{"spoiler":false,"text":"「你就是我的未婚夫吗。那么快举起剑！」"}],"source":"bangumi","sourceCharacterId":"12872"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12182022a9fdd686a007347b55988da3ebccc33b7da58e771415a59eefae7b82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3121ad9042f708c7bb5b6305d3304492405b4d7e2c0057092070594fe145ea6e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14111:12872:6351:1","source":"bangumi"}]},{"characterId":"char_c3064","characterName":"モナ","sourceIds":{"bangumi":[{"characterId":"12873","match":"exact-normalized-name-in-linked-work","subjectId":"14111"}],"egsCharacterIds":["23375"],"vndbCharacterId":"c3064"},"originalCharacterName":"モナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"征斗の幼なじみでクラスメイト。愛称はモナ。"},{"spoiler":false,"text":"身長は女子の平均をやや下回る、そのくせ胸だけは学年1・2を争う巨乳。"},{"spoiler":false,"text":"その絶妙なアンバランスさから、ついたあだ名が 『小さな巨人』。"},{"spoiler":false,"text":"男女問わず憧れの巨乳だが、彼女にとってはコンプレックスでしかない。"},{"spoiler":false,"text":"マメでしっかり者の征斗とは対称に、大雑把な性格でだらしないところがある。"},{"spoiler":false,"text":"一見、女の子らしさが無いように見えるが、中身は極めて乙女。"},{"spoiler":false,"text":"根は征斗以上のお人よし。例えば、ライバルになる子が凹んでいたり傷ついていたりすると、つい慰めてしまったりする面倒見のいい一面がある。"},{"spoiler":false,"text":"家はケーキ屋で、征斗の母が経営するカフェのケーキはすべて萌菜香の店で作ったもの。"},{"spoiler":false,"text":"征斗の家と萌菜香の家は持ちつ持たれつの関係で、まるで親戚のような付き合いをしている。"}],"source":"egs","sourceCharacterId":"23375","sourceWorkId":"14605","spoiler":false},{"segments":[{"spoiler":false,"text":"征斗的青梅竹马兼同班同学。爱称是萌菜。"},{"spoiler":false,"text":"身高比女孩子的平均身高要稍低，但只有胸部是学年数一数二的巨乳。"},{"spoiler":false,"text":"由于这种绝妙的不平衡，被起了『小さな巨人』的外号。"},{"spoiler":false,"text":"那不论男女都无限憧憬的巨乳，对她来说却只是自卑的源泉。"},{"spoiler":false,"text":"与认真能干的征斗相对，性格粗枝大叶还吊儿郎当。"},{"spoiler":false,"text":"一眼看上去一点也没有女孩子气，但内心十分少女。"},{"spoiler":false,"text":"本性比征斗还要老好人。比如，竞争对手正因受打击而消沉的时候，她会不自觉地过去安慰，有着爱照顾人的一面。"},{"spoiler":false,"text":"家里是点心店，征斗的母亲经营的咖啡店的蛋糕都是萌菜香家的店里做的。"},{"spoiler":false,"text":"征斗家和萌菜香家是互相扶持的关系，就像是亲戚般的来往。"},{"spoiler":false,"text":"「迟钝！笨蛋！没神经的家伙!!少看不起少女的纯情！」"}],"source":"bangumi","sourceCharacterId":"12873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f87ad8eb95cc81b3d606816b8f1035768074ed3c7620648ca6b996d4ce328e8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51fd68fd40dbbafe8ee3f13761c14371f9d873baf6d78235f5e3270c81e19abf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14111:12873:5020:1","source":"bangumi"}]},{"characterId":"char_c3065","characterName":"花京院 椿","sourceIds":{"bangumi":[{"characterId":"12874","match":"exact-normalized-name-in-linked-work","subjectId":"14111"}],"egsCharacterIds":["23376"],"vndbCharacterId":"c3065"},"originalCharacterName":"花京院 椿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"紫ノ森学園の3年生で、前の学生会長。通称・椿姫、またはご隠居様。"},{"spoiler":false,"text":"皆の憧れであり、優しく美しいお姉様。"},{"spoiler":false,"text":"穏やかな性格で、誰にも分け隔てなく優しく接し、常に微笑みをたたえている。"},{"spoiler":false,"text":"学生会長時代は穏やかな見た目に似合わぬリーダーシップを発揮し、数々の名采配を振るった。"},{"spoiler":false,"text":"いまだ教師たちへの影響力も強く、紫ノ森学園学生会の生ける伝説と言われている。"},{"spoiler":false,"text":"花京院家は元華族の名家で、椿はその娘。どこに出しても恥ずかしくないお嬢様のはずなのだが、何故かものすごく貧乏。"},{"spoiler":false,"text":"しかし、彼女から惨めさを感じる者はいない。貧乏でも、椿は堂々とつつましく日々を送る。"},{"spoiler":false,"text":"その様子からは、気品さえ感じる。清貧ここに極まれり。"},{"spoiler":false,"text":"紫ノ森学園を住まいとしており、常に学園で暮らしている。"}],"source":"egs","sourceCharacterId":"23376","sourceWorkId":"14605","spoiler":false},{"segments":[{"spoiler":false,"text":"紫之森学园的三年级学生，前任学生会会长。通称椿姫，以及隐居公主。"},{"spoiler":false,"text":"大家憧憬的对象，温柔而美丽的大姐姐。"},{"spoiler":false,"text":"性格稳重大方，对谁都没有毫无隔阂地温柔对待，总是盈面微笑。"},{"spoiler":false,"text":"学生会长时代充分发挥出与那和蔼外表不相称的领导才能，做出各种英明决断。"},{"spoiler":false,"text":"现在对教师们的影响力也很大，被誉为紫之森学园的活传说。"},{"spoiler":false,"text":"花京院家本来是高贵的名门，椿就是这家的女儿。本来是不论放到哪都不会丢人的大小姐，不知为何非常贫穷。"},{"spoiler":false,"text":"但是，从她身上感觉不到一丝凄惨。就算贫穷，椿也堂堂地过着朴实的每一天。"},{"spoiler":false,"text":"从她的身上，甚至能感到尊贵典雅的气质。贯彻清贫作风。"},{"spoiler":false,"text":"以紫之森学园为家，总是生活在学园里。"},{"spoiler":false,"text":"「因此、征斗的未婚妻之位就让给我了」"}],"source":"bangumi","sourceCharacterId":"12874"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aef69d2834f825e3b7f1f0afec25b3133f94898fd5f17450d351211e14170057.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e26abb8d85bfef92622d7755ef824c0604f2d172f679a8008170eb3858dad1e8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14111:12874:4832:1","source":"bangumi"}]},{"characterId":"char_c3066","characterName":"野咲 雛菊","sourceIds":{"bangumi":[{"characterId":"12875","match":"exact-normalized-name-in-linked-work","subjectId":"14111"}],"egsCharacterIds":["23377"],"vndbCharacterId":"c3066"},"originalCharacterName":"野咲 雛菊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Hinagiku is the half blood related younger sister of Yukito."}],"source":"vndb","sourceCharacterId":"c3066"},{"segments":[{"spoiler":false,"text":"征斗をこっそりと慕う後輩の女の子。"},{"spoiler":false,"text":"人見知りで引っ込み思案。恥ずかしがり屋で、人前でしゃべったりするのが大の苦手。"},{"spoiler":false,"text":"憧れの征斗と一言挨拶を交わせただけで、3日は幸せでいられる。"},{"spoiler":false,"text":"実は妄想力たくましいところがあり、勝手な妄想にひたり脳内暴走していることもしばしば。"},{"spoiler":false,"text":"ゆえあって新聞部に籍を置いていて、征斗とは部活の先輩後輩の関係。"},{"spoiler":false,"text":"しかし、肝心の征斗が幽霊部員のため部活動で顔を会わせる機会はほとんどない。"},{"spoiler":false,"text":"萌菜香とも親しく非常に懐いていて、征斗と萌菜香を 「お似合いのふたり」 と思っていた。"},{"spoiler":false,"text":"ところが、そこへヴィオレッタが現れ征斗の女性関係がにわかに混沌としはじめて、"},{"spoiler":false,"text":"「私にもチャンスがあるかも!?」 と淡い期待と誇大妄想を、今日も元気に暴走させている。"}],"source":"egs","sourceCharacterId":"23377","sourceWorkId":"14605","spoiler":false},{"segments":[{"spoiler":false,"text":"暗中仰慕着征斗的后辈女孩子。"},{"spoiler":false,"text":"怕生而胆小怯懦。由于很害羞，非常不擅长在人前说话。"},{"spoiler":false,"text":"只要能和憧憬的征斗打上一句招呼，就能保持幸福3天。"},{"spoiler":false,"text":"实际上妄想能力超强，常常擅自在妄想中暴走。"},{"spoiler":false,"text":"由于某些原因而在籍于新闻部，和征斗是社团的后辈和前辈的关系。"},{"spoiler":false,"text":"但由于关键的征斗是幽灵部员而在社团活动中也没什么机会见面。"},{"spoiler":false,"text":"和萌菜香的关系也非常好，认为征斗和萌菜香是「很般配的一对」。"},{"spoiler":false,"text":"但直到ヴィオレッタ出现、征斗的女性关系开始变得混乱，便抱有了「我或许也是有机会的吧!?」这种淡淡的期待和夸大的妄想，这种期待和妄想现在也在脑中暴走着。"},{"spoiler":false,"text":"「那、那个……征斗前辈……啊、不、没什么！」"}],"source":"bangumi","sourceCharacterId":"12875"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa7ba29f758ee5b40e2ad445c972ebb5569c1da5c8d78cdfbfb2b6269adb805d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b517a8c9fc2678127d022143cc0d296cc1930386a4b0b796c93ec0ac399c3e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14111:12875:4646:1","source":"bangumi"}]},{"characterId":"char_c3067","characterName":"エーリカ・フランベルジュ","sourceIds":{"bangumi":[{"characterId":"12876","match":"exact-normalized-name-in-linked-work","subjectId":"14111"}],"egsCharacterIds":["23378"],"vndbCharacterId":"c3067"},"originalCharacterName":"エーリカ・フランベルジュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"コラングレインの新興貴族・フランベルジュ家の娘。"},{"spoiler":false,"text":"幼少期よりヴィオレッタを目の敵にする、自称ライバル。"},{"spoiler":false,"text":"とにかくゴージャスに、目立つことこそ権威の証明と考えている家風を色濃く受け継いでいるせいか、性格はワガママの負けず嫌い、態度は尊大で常に上から目線。"},{"spoiler":false,"text":"そうまでして存在をアピールしているのに、ヴィオレッタにスルーされ続けることが屈辱の極みである。"},{"spoiler":false,"text":"ヴィオレッタのフィアンセである征斗を奪うため、はるばる日本へやってくる。"},{"spoiler":false,"text":"「打倒ヴィオレッタ！」 を合い言葉に、平らかな胸を成長させるため、日夜努力を欠かさない。"},{"spoiler":false,"text":"いつも部下の黒服たちを連れている。"}],"source":"egs","sourceCharacterId":"23378","sourceWorkId":"14605","spoiler":false},{"segments":[{"spoiler":false,"text":"コラングレイン的新兴贵族フランベルジュ家的女儿。"},{"spoiler":false,"text":"小时候起就把ヴィオレッタ视为敌人，自称是对手。"},{"spoiler":false,"text":"由于深受认为只有奢华、显眼才是权威之象征的这种家风的强烈影响，性格任性而不服输，态度骄傲自大而且总是俯视别人。"},{"spoiler":false,"text":"为了突出存在感明明都做到了这个地步，每次都被ヴィオレッタ无视实在是屈辱至极。"},{"spoiler":false,"text":"为了抢夺ヴィオレッタ的未婚夫征斗而千里迢迢来到日本。"},{"spoiler":false,"text":"以「打倒ヴィオレッタ！」为口号，为了能让平坦的胸部有所成长而日夜不辞努力。"},{"spoiler":false,"text":"总是带着身穿黑衣服的部下们。"},{"spoiler":false,"text":"「决一胜负ヴィオレッタ！这次我一定要……切、少摆出不爽的表情！」"}],"source":"bangumi","sourceCharacterId":"12876"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aefcd9354ceb8b0f1dd54ca7d61c3db00427de6e0a80e14463bd097c6960d2fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccc3268effb51a11a5a4cb12855962d8bbd704317eb1cb080ad8e76d0f501f25.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14111:12876:6509:1","source":"bangumi"}]},{"characterId":"char_c3070","characterName":"志藤 征斗","sourceIds":{"bangumi":[{"characterId":"12877","match":"exact-normalized-name-in-linked-work","subjectId":"14111"}],"egsCharacterIds":["23379"],"vndbCharacterId":"c3070"},"originalCharacterName":"志藤 征斗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Yukito is the half blood older brother of Hinagiku"}],"source":"vndb","sourceCharacterId":"c3070"},{"segments":[{"spoiler":false,"text":"クラスメイトの女子いわく、「お嫁さんにしたい男子ナンバー1」。"},{"spoiler":false,"text":"ルックスが良いのでモテてはいるが、彼と親しい女子からは、 「結婚するにはいいかもだけど、お付き合いするにはちょっと……重い？」 と評されている。"},{"spoiler":false,"text":"微妙にTPOをわきまえない生真面目ぶりは面倒くさくはあるが、その嘘のない彼の態度は皆の信頼を集めている。"},{"spoiler":false,"text":"弱点は女子。女の子相手だと、もの凄く照れる。"},{"spoiler":false,"text":"ただし、幼なじみの萌菜香に対してはとくに照れることもなく、毎朝起こしに行ったりお弁当を作ったりしている。"},{"spoiler":false,"text":"当然、それを知っているクラスメイトは彼らを 「夫婦」 と呼んでからかう。 もちろんお母さん役が征斗である。"},{"spoiler":false,"text":"運動神経抜群のため、あらゆる運動部から勧誘を受けているが、その全てを断って毎日母の手伝いをしている。"},{"spoiler":false,"text":"母の店 『カフェ・ソレイユ』 を守るため、このたびの許嫁騒動に挑む。"}],"source":"egs","sourceCharacterId":"23379","sourceWorkId":"14605","spoiler":false},{"segments":[{"spoiler":false,"text":"据同班的女孩子说是「想要嫁的男孩子No.1」。"},{"spoiler":false,"text":"相貌英俊而很受欢迎，但被与她亲近的女孩子评价说「要结婚的话或许还不错，但要交往的话有些……沉重？」。"},{"spoiler":false,"text":"微妙地做事分不清时间场合的过于认真态度有时会带来麻烦，但他的这种毫无掩饰的态度获得了大家的信赖。"},{"spoiler":false,"text":"弱点是女孩子。在女孩子面前会十分害羞。"},{"spoiler":false,"text":"但是，对青梅竹马的萌菜香并不怎么感到害羞，每天早上去叫她起床、做便当。"},{"spoiler":false,"text":"当然，知道这些的同班同学戏称他们为夫妇。当然当妻子的是征斗。"},{"spoiler":false,"text":"由于运动神经超群，被各种运动部劝诱，但他全都拒绝了，每天在母亲店里帮忙。"},{"spoiler":false,"text":"为了保护母亲的店『café ·soleil』，挑战这次的许婚骚动。"},{"spoiler":false,"text":"「结婚什么的、实在不敢当！」"}],"source":"bangumi","sourceCharacterId":"12877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb3afa3ab46e65f52e268fa82ce4e687623278c5dcd07e118502788c0c07a424.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff6116f0b756517d56e3db62f169620d1adcba72913e3be0b2e0561d67b05ee2.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c3072","characterName":"南 千代子","sourceIds":{"vndbCharacterId":"c3072"},"originalCharacterName":"南 千代子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/6711bba689fdc7251088f161e3c0be3d69b7bee316d6544a4b835e3db2cd4fc0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87b3247a021b1ccbaa6bbb6c8516c8bb9db3b4d2447428fcb0cfcb966443ae59.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大花 どん","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"浅井 清己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35564","source":"vndb"}]},{"characterId":"char_vndb_c3073","characterName":"笹原 杏子","sourceIds":{"vndbCharacterId":"c3073"},"originalCharacterName":"笹原 杏子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aef886d21a73463bc813a03411c055cb7446e07dab5d17f1b95ef31c8573c066.webp"