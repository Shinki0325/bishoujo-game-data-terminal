013","source":"vndb"},{"creditedName":"aomi","creatorId":"vndb:s4615","sourcePersonId":"vndb:s4615","canonicalEntityId":"vndb:s4615","name":"aomi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108014","source":"vndb"},{"creditedName":"木霊","creatorId":"vndb:s7410","sourcePersonId":"vndb:s7410","canonicalEntityId":"vndb:s7410","name":"木霊","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108015","source":"vndb"},{"creditedName":"睦月 山羊","creatorId":"vndb:s19135","sourcePersonId":"vndb:s19135","canonicalEntityId":"vndb:s19135","name":"睦月 山羊","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108017","source":"vndb"},{"creditedName":"桐山 マチ","creatorId":"vndb:s19139","sourcePersonId":"vndb:s19139","canonicalEntityId":"vndb:s19139","name":"桐山 マチ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108018","source":"vndb"},{"creditedName":"5島 縣痔","creatorId":"vndb:s19140","sourcePersonId":"vndb:s19140","canonicalEntityId":"vndb:s19140","name":"5島縣痔","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108019","source":"vndb"},{"creditedName":"タンタン、タタン","creatorId":"vndb:s32386","sourcePersonId":"vndb:s32386","canonicalEntityId":"vndb:s32386","name":"タンタン、タタン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108020","source":"vndb"},{"creditedName":"AG-promotion","creatorId":"vndb:s7205","sourcePersonId":"vndb:s7205","canonicalEntityId":"vndb:s7205","name":"AG-promotion(AGプロモーション)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108021","source":"vndb"}]},"cast":[{"characterId":"char_c22827","characterName":"樗木 綾","sourceIds":{"bangumi":[{"characterId":"58227","match":"exact-normalized-name-in-linked-work","subjectId":"227004"}],"egsCharacterIds":["3564"],"vndbCharacterId":"c22827"},"originalCharacterName":"樗木 綾","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school student council president who attends Suisei Academy, a high school that specializes in preparing its students for higher education."},{"spoiler":false,"text":"A stubborn girl who's acknowledged by everyone, and hates anything that doesn't follow the rules. Has an uncompromising side to her, but is still trusted by teachers and students alike."},{"spoiler":false,"text":"She and the protagonist, who was the previous student council president, has been dating each other for a year. Her respect for the protagonist is what drives her to continue what he established in their school."},{"spoiler":false,"text":"In the present, she's working towards a big event, namely the \"University Town Festival\", together with the current student council vice president Date Souichirou."},{"spoiler":false,"text":"Her sexual experience is only with one man."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c22827"},{"segments":[{"spoiler":false,"text":"学園都市の進学校、泗水学園に通う生徒会長の女子校生。"},{"spoiler":false,"text":"自他共に認めるカタブツであり、ルールから外れることを嫌う性格。"},{"spoiler":false,"text":"融通の利かないところはあるが、教師・学生からの信頼は篤い。"},{"spoiler":false,"text":"主人公である中條貴志とは1年前から交際を続けている。"},{"spoiler":false,"text":"前期の生徒会長である貴志を尊敬しており、彼が築き上げてきたものを自分が引き継ぐという使命感に燃えている。"},{"spoiler":false,"text":"現在は学園都市全体規模の一大イベントである“学園都市祭”の開催に向けて、現生徒会副会長である伊達宗一郎とともに奔走する日々を送っている。"},{"spoiler":false,"text":"男性経験は1人のみ。"}],"source":"egs","sourceCharacterId":"3564","sourceWorkId":"20254","spoiler":false},{"segments":[{"spoiler":false,"text":"学園都市の進学校・泗水学園に通う生徒会長の女子校生。"},{"spoiler":false,"text":"自他共に認めるカタブツであり、ルールから外れることを嫌う性格。"},{"spoiler":false,"text":"融通の利かないところはあるが、教師・学生からの信頼は篤い。"},{"spoiler":false,"text":"主人公である中條貴志とは1年前から交際を続けている。"},{"spoiler":false,"text":"前期の生徒会長である貴志を尊敬しており、彼が築き上げてきたものを自分が引き継ぐという使命感に燃えている。"},{"spoiler":false,"text":"現在は学園都市全体規模の一大イベントである “学園都市祭” の開催に向けて、現生徒会副会長である伊達宗一郎とともに奔走する日々を送っている。"},{"spoiler":false,"text":"男性経験は1人のみ。"}],"source":"bangumi","sourceCharacterId":"58227"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d51eb3f820ec4ef936830a2ed31f2b3a0cc7a31628c0c04c65c99e49b6882c55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64a2e4d3767af51c0c75ad730a5270bfd7885162e2618811b9545b8e2e0aa1ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:227004:58227:17078:1","source":"bangumi"}]},{"characterId":"char_c68227","characterName":"伊達 宗一郎","sourceIds":{"bangumi":[{"characterId":"58228","match":"exact-normalized-name-in-linked-work","subjectId":"227004"}],"egsCharacterIds":["3565"],"vndbCharacterId":"c68227"},"originalCharacterName":"伊達 宗一郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Best friend of Takashi. Due to various problems, he dropped out from previous school and took 2 years to enter same school as Takashi. He is vice president in student council after Takashi graduated."}],"source":"vndb","sourceCharacterId":"c68227"},{"segments":[{"spoiler":false,"text":"生徒会副会長の学生。"},{"spoiler":false,"text":"年齢は綾より一つ上だが、2年留年しているため学年は一つ下。"},{"spoiler":false,"text":"以前は別の学園に通っていたが、素行不良で退学させられている。"},{"spoiler":false,"text":"しばらくフリーターをしていたが、貴志の薦めにより泗水学園へと入学する。"},{"spoiler":false,"text":"現在は心を入れ替えて学生生活を送っている。"},{"spoiler":false,"text":"学園では珍しい体育会系の学生で、とてもサッパリとした性格。"},{"spoiler":false,"text":"体躯はかなりがっちりとしていて逞しい。"},{"spoiler":false,"text":"樗木綾と二人三脚で、学園都市祭開催に向けて頑張っている。"},{"spoiler":false,"text":"主人公である貴志とは幼なじみの仲。"},{"spoiler":false,"text":"女性経験は無し。"}],"source":"egs","sourceCharacterId":"3565","sourceWorkId":"20254","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会副会長の学生。 主人公である貴志とは幼なじみの仲。"},{"spoiler":false,"text":"年齢は綾より一つ上だが、二年留年しているため学年は一つ下。"},{"spoiler":false,"text":"以前は別の学園に通っていたが、素行不良で退学させられている。"},{"spoiler":false,"text":"しばらくフリーターをしていたが、貴志の薦めにより泗水学園へと入学する。"},{"spoiler":false,"text":"現在は心を入れ替えて学生生活を送っている。"},{"spoiler":false,"text":"学園では珍しい体育会系の学生で、とてもサッパリとした性格。"},{"spoiler":false,"text":"体躯はかなりがっちりとしていて逞しい。"},{"spoiler":false,"text":"樗木綾と二人三脚で、学園都市祭開催に向けて頑張っている。"},{"spoiler":false,"text":"女性経験は無し。"}],"source":"bangumi","sourceCharacterId":"58228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/031aaea5299082de598e1e168794ab2b8a14b692fa06825547ebbad0b3c88d00.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec3dcae0522ea911d7a85df044fea3b8f89e4bb9f9f56bd99b12f4e5c542d409.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c68226","characterName":"中條 貴志","sourceIds":{"vndbCharacterId":"c68226"},"originalCharacterName":"中條 貴志","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Considered the best talented student council president and the best couple with Aya after the success of the first \"University Town Festival\". However, he doesn't have much time to meet up with Aya anymore when attending university."}],"source":"vndb"