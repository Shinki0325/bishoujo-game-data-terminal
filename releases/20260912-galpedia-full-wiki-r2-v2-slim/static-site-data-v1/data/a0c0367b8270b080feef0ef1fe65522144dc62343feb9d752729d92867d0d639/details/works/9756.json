roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:98759","source":"egs"},{"creditedName":"綾風 柳晶","creatorId":"vndb:s2462","sourcePersonId":"vndb:s2462","canonicalEntityId":"vndb:s2462","name":"綾風 柳晶","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:70100","source":"vndb"},{"creditedName":"成沢 みなみ","creatorId":"vndb:s8555","sourcePersonId":"vndb:s8555","canonicalEntityId":"vndb:s8555","name":"成沢 みなみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:70102","source":"vndb"}]},"cast":[{"characterId":"char_c68479","characterName":"織田 千明","sourceIds":{"bangumi":[{"characterId":"218671","match":"exact-normalized-name-in-linked-work","subjectId":"218184"}],"egsCharacterIds":["19315"],"vndbCharacterId":"c68479"},"originalCharacterName":"織田 千明","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"落ちこぼれCA候補生その1。"},{"spoiler":false,"text":"真面目で一生懸命、明るく前向きな熱血漢だが、能力が足らないため、やることなすこと空回り気味。"},{"spoiler":false,"text":"しかし、誰よりも奉仕の精神と行動力を持っているので、立派なCAになれる素質は十分ある……、ハズ。"},{"spoiler":false,"text":"ドラマを見てCAに憧れた彼女は、主人公を「教官！」と呼び慕い、言うことを全部鵜呑みにしてしまう。"}],"source":"egs","sourceCharacterId":"19315","sourceWorkId":"9756","spoiler":false},{"segments":[{"spoiler":false,"text":"熱血で真面目で一生懸命な劣等生。黙っていれば可愛いし、性格もいいのだがとにかく不器用で記憶力がない。"},{"spoiler":false,"text":"運動神経も全くと言っていい程なく、CA以前に日常生活が危険。しかし、誰よりも奉仕の心と人のために骨身を惜しまない行動力を持っているため、将来的には立派なCAになる素質はある……はず。"},{"spoiler":false,"text":"好きなものは可愛い小物と占い。時々危ないコトを口走ったりする。虫関係全般苦手で、特に蜘蛛は死ぬほど怖いらしい。"}],"source":"bangumi","sourceCharacterId":"218671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ed49598f5990aa0199831b75d42f44b2856a64efd3002b591d1b00d882008cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/475a4f4c78c7a6d52d2f47627e8af9f49c5b8147726588dc888bed0ae613b7a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218184:218671:6409:1","source":"bangumi"},{"creditedName":"萌原 ぷりん","creatorId":"vndb:s2339","sourcePersonId":"vndb:s2339","canonicalEntityId":"vndb:s2339","name":"萌原ぷりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39394","source":"vndb"}]},{"characterId":"char_c68480","characterName":"高見沢 薫子","sourceIds":{"bangumi":[{"characterId":"218673","match":"exact-normalized-name-in-linked-work","subjectId":"218184"}],"egsCharacterIds":["19316"],"vndbCharacterId":"c68480"},"originalCharacterName":"高見沢 薫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"目を見張るような美貌を持つ候補生。"},{"spoiler":false,"text":"実家が主人公たちの勤める航空会社のオーナーであり、お嬢様である彼女。"},{"spoiler":false,"text":"能力的には問題のないのだが、その類稀なる高飛車な性格で、接客態度も相手を見下したように高慢であり、落ちこぼれる。"},{"spoiler":false,"text":"当初は、教官である主人公も見下していたが、とあるきっかけで、次第に従順な態度をとるようになっていく。"}],"source":"egs","sourceCharacterId":"19316","sourceWorkId":"9756","spoiler":false},{"segments":[{"spoiler":false,"text":"ミス某大学にして、入学時にはパンフレットの表紙にもなった訓練所一の美女。美貌を武器に、看板CAへの道を約束されていた……はずだった。"},{"spoiler":false,"text":"彼女は幼い頃から美貌を武器に大抵のことは苦労もなくこなし、誰かのために何かするなどということは親のためであってもやったことがないというお嬢様育ちの高慢美女だったのだ。"},{"spoiler":false,"text":"性格の問題を除けば特に問題はないのだが、とにかく全てにおいて自分優位であり、お客さんに対する対応など考えもつかないらしい。事故の訓練なんかでは客を置き去りに自分だけが逃げようとしてしかもそれを当然だと思うような人。"}],"source":"bangumi","sourceCharacterId":"218673"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f60982d93b3ca4f36d956d286231edaea46953c2f3115ea85423e3027041d24f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/951e8f96ed1dff971941a3449831ff6e03423cf84f405488903739d5749b7563.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真木碧","creatorId":"vndb:s2000","sourcePersonId":"vndb:s2000","canonicalEntityId":"vndb:s2000","name":"真木 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218184:218673:6130:1","source":"bangumi"}]},{"characterId":"char_c68481","characterName":"本間 有希","sourceIds":{"bangumi":[{"characterId":"218674","match":"exact-normalized-name-in-linked-work","subjectId":"218184"}],"egsCharacterIds":["19317"],"vndbCharacterId":"c68481"},"originalCharacterName":"本間 有希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"知識面はパーフェクトな、ガリ勉系候補生。"},{"spoiler":false,"text":"元々はCAを目指していたワケではないのだが、とある事情でCA採用試験を受けることになったワケ有り少女。"},{"spoiler":false,"text":"優秀で豊富な知識を持っているが、とにかく理屈っぽく、その上、気が強い完璧主義者なため、よく薫子とケンカになる。"},{"spoiler":false,"text":"しかし、実技面では、生真面目で理屈屋の性格が災いし、突発事項にめっぽう弱く、何かとパニックを起こしがち。"}],"source":"egs","sourceCharacterId":"19317","sourceWorkId":"9756","spoiler":false},{"segments":[{"spoiler":false,"text":"チビ、メガネ、幼児体型、と三拍子そろった理屈屋美少女。"},{"spoiler":false,"text":"成績はダントツトップでこれまた期待の新人だったのだが、とにかく理屈っぽく人を見下した態度を取り周囲と軋轢を起こして劣等生となった。気が○くていつも薫子と喧嘩になる完璧主義者。"},{"spoiler":false,"text":"元々パイロットを目指していたが身長と視力が足りずに諦めた過去を持ち、CAならギリギリ可能だったので採用試験を受けて成功したものの、周囲が美人ばかりだったことや自分が生真面目でお上手が言えない性格であることがコンプレックスとなり、何かあるとパニックを起こして真っ白になるという欠点を背負ってしまう。完璧主義者であるが故にちょっとしたことでも真っ白になり、とにかく突発事項に弱い。"},{"spoiler":false,"text":"頭脳の出来に関してはチーム内でもダントツでペーパーは完璧でありみんなの知恵袋となるが実技ではドジっこの千明以上に足を引っ張る困った少女。"}],"source":"bangumi","sourceCharacterId":"218674"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bbc1e49ddb55b76b6d7a717192d6d93ca271bbe24d435b32b90d7604c126ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84d0507178fef8c50753cf31d33c0633a15789c773e841afa5b0085b262bd7d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218184:218674:19333:1","source":"bangumi"}]},{"characterId":"char_c68482","characterName":"松村 樹里","sourceIds":{"bangumi":[{"characterId":"218675","match":"exact-normalized-name-in-linked-work","subjectId":"218184"}],"egsCharacterIds":["19318"],"vndbCharacterId":"c68482"},"originalCharacterName":"松村 樹里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"黙っていればナイスバディの巨乳美少女。"},{"spoiler":false,"text":"しかしその実態は、脳の栄養も胸に回ってしまったような、超天然ボケのポワポワ～ン候補生。"},{"spoiler":false,"text":"CAになろうとした理由も、あやふやでよくわからないが、彼女の両親が、そのあたりに深く関わっている様子。"},{"spoiler":false,"text":"主人公と出会ってからは、CA訓練に真面目に取り組むようになったが……。"}],"source":"egs","sourceCharacterId":"19318","sourceWorkId":"9756","spoiler":false},{"segments":[{"spoiler":false,"text":"ぼややんとして隙だらけで、露出多めの服が好きで昨日のTV番組のことしか話題がなくて活字は新聞のTV欄しか見ない、といったタイプの脳みそポカーンな美女。"},{"spoiler":false,"text":"乳がでかく、顔立ちは身体に反比例するように幼く、上目遣いでナチュラルに媚を発する色気大帝。なぜCAになろうとしたかを聞いても答えられない天然少女。"},{"spoiler":false,"text":"言われたことはそれなりにやろうとするのだが、集中力がなく体力もなく知力もなく、とにかく天然ボケをするためにだけ生まれてきたような存在。しかもむやみに色っぽい。"},{"spoiler":false,"text":"男子学生にはダントツの人気を誇り、告白された数は数知れず、付き合った数も数知れず。告白した男が翌日には天然について行けず別れを切り出すという「一日殺し」の伝説を持つ。"}],"source":"bangumi","sourceCharacterId":"218675"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86b69a5ce13ec6582c62efa21b7531ec79f8e616f0bab24de3aa032c1ce320b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02f0336fea6f18826d011ebb06837ae67124f7a3d626d1f9b154535f21e1bc64.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"平山 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218184:218675:5905:1","source":"bangumi"}]},{"characterId":"char_c68483","characterName":"明石 真梨子","sourceIds":{"bangumi":[{"characterId":"218676","match":"exact-normalized-name-in-linked-work","subjectId":"218184"}],"egsCharacterIds":["19319"],"vndbCharacterId":"c68483"},"originalCharacterName":"明石 真梨子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"落ちこぼれ訓練生の特訓講師となった、才色兼備なエリートCA。"},{"spoiler":false,"text":"主人公とは、入社当時半年間付き合っていたが、度重なる浮気に怒り＆傷ついて別れる。"},{"spoiler":false,"text":"主人公を目の敵にしている彼女は、主人公がCA候補生に少しでもちょっかいを出すと、烈火のごとく怒り出す。"},{"spoiler":false,"text":"基本しっかり者だが、色々思うところがあるらしく……。"}],"source":"egs","sourceCharacterId":"19319","sourceWorkId":"9756","spoiler":false},{"segments":[{"spoiler":false,"text":"怜悧な美貌、冷静な頭脳、完璧な立ち振る舞い。そして花のごとき笑顔。全CA憧れの的にして完璧の麗人。"},{"spoiler":false,"text":"でも、実は入社直後に半年ほど主人公と付き合い、処女もその時に捧げている。無論、彼女はそれを「一生の不覚」と記憶から抹消しているのだが。"},{"spoiler":false,"text":"訓練生たちの現場研修の教官であり、まだ見習い教官である主人公の指導教官でもある才媛。厳しく、冷静で一流のCAを育てるべく行動する。が、流石に主人公に対しては激しい私怨があるため当たりが厳しくなることは否めない。"}],"source":"bangumi","sourceCharacterId":"218676"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12a5964818f946930dc74089854bd671a7e625dc880b22c4e1daad98e2e30a51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6ef92366f25ca542ce753affb3df3fc316a42502c62af339ff335220ec4c530.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月野 きらら","creatorId":"vndb:s22375","sourcePersonId":"vndb:s22375","canonicalEntityId":"vndb:s22375","name":"月野 きらら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39395","source":"vndb"}]},{"characterId":"char_vndb_c123953","characterName":"御手洗 浩平","sourceIds":{"vndbCharacterId":"c123953"},"originalCharacterName":"御手洗 浩平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2075","sourceCompanyId":"egs:brand:2230","canonicalEntityId":"vndb:p2075","name":"ほにゃららPink","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9756:2230","source":"egs"},{"companyId":"vndb:p1746","sourceCompanyId":"vndb:p1746","canonicalEntityId":"vndb:p1746","name":"株式会社エムトリックス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:162386:v7300","source":"vndb"},{"companyId":"vndb:p296","sourceCompanyId":"vndb:p296","canonicalEntityId":"vndb:p296","name":"Honyararado","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:17146:v7300","source":"vndb"},{"companyId":"vndb:p2075","sourceCompanyId":"vndb:p2075","canonicalEntityId":"vndb:p2075","name":"ほにゃららPink","roleCodes":["develope