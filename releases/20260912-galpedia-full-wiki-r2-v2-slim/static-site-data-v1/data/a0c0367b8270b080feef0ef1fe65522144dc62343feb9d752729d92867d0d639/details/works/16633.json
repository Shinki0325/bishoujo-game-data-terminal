4208"},{"segments":[{"spoiler":false,"text":"笑顔が素敵なメイドさんだが、発言はネガティブ。"},{"spoiler":false,"text":"自分から犬と呼んでくださいと必要以上にへりくだる。"},{"spoiler":false,"text":"かつては王族の一員だったか、一族が画策した叛乱に連座して身分が格下げになったらしい。"},{"spoiler":false,"text":"ドナースターク（木曜日）という名前もその時につけられたもので、本名ではない。"},{"spoiler":false,"text":"まったくもって不憫な女の子。"}],"source":"egs","sourceCharacterId":"9008","sourceWorkId":"16633","spoiler":false},{"segments":[{"spoiler":false,"text":"笑顔が素敵なメイドさんだが、発言はネガティブ。"},{"spoiler":false,"text":"自分から犬と呼んでくださいと必要以上にへりくだる。"},{"spoiler":false,"text":"かつては王族の一員だったが、一族が画策した叛乱に連座して身分が格下げになったらしい。"},{"spoiler":false,"text":"ドナースターク（木曜日）という名前もその時に付けられたもので、本名ではない。"},{"spoiler":false,"text":"姫とエーミールの命令には絶対服従。"},{"spoiler":false,"text":"「だって私は奴隷の鎖がないと生きていけない、業の深い女だから！」"}],"source":"bangumi","sourceCharacterId":"44685"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf11de11cf1ef5e6b6423bd2abf26359dd3b91b4e9369e53056100004527403a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b34194f3aa4f81a66b73d37aba8717dca2ed25f7967ea49985ea0de2dac9978e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:31506:44685:6349:1","source":"bangumi"}]},{"characterId":"char_c34210","characterName":"相模 愛華","sourceIds":{"bangumi":[],"egsCharacterIds":["9010"],"vndbCharacterId":"c34210"},"originalCharacterName":"相模 愛華","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"friend of Ikuno. She doesn't get along with Eiji believing he is just using Ikuno to ge