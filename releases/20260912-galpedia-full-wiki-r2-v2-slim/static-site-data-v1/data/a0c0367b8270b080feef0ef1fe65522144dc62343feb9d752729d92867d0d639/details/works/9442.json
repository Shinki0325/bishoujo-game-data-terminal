","source":"vndb"},{"creditedName":"ぴょんも","creatorId":"vndb:s3199","sourcePersonId":"vndb:s3199","canonicalEntityId":"vndb:s3199","name":"ぴょんも","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:13101","source":"vndb"},{"creditedName":"安斎 ゆう子","creatorId":"vndb:s8072","sourcePersonId":"vndb:s8072","canonicalEntityId":"vndb:s8072","name":"安斎 ゆう子","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:13104","source":"vndb"}],"other":[{"creditedName":"中山♥マミ","creatorId":"vndb:s1609","sourcePersonId":"vndb:s1609","canonicalEntityId":"vndb:s1609","name":"中山♡マミ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:13097","source":"vndb"},{"creditedName":"中山♥マミ","creatorId":"vndb:s1609","sourcePersonId":"vndb:s1609","canonicalEntityId":"vndb:s1609","name":"中山♡マミ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:13098","source":"vndb"},{"creditedName":"CANDY","creatorId":"vndb:s3200","sourcePersonId":"vndb:s3200","canonicalEntityId":"vndb:s3200","name":"CANDY","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:13102","source":"vndb"},{"creditedName":"CANDY","creatorId":"vndb:s3200","sourcePersonId":"vndb:s3200","canonicalEntityId":"vndb:s3200","name":"CANDY","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:13103","source":"vndb"}]},"cast":[{"characterId":"char_c56008","characterName":"永峰 陽子","sourceIds":{"bangumi":[{"characterId":"97463","match":"exact-normalized-name-in-linked-work","subjectId":"43081"},{"characterId":"97463","match":"exact-normalized-name-in-linked-work","subjectId":"618759"}],"egsCharacterIds":["26735"],"vndbCharacterId":"c56008"},"originalCharacterName":"永峰 陽子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"永峰和人の実の妹。両親が亡くなった際、兄は祖母のもとへ、そして彼女は神戸の叔父夫婦のもとにあずけられ、兄妹離ればなれで暮らしていた。兄との再会を夢見ていた彼女は、祖母の死と、兄が上京したことを知ったことで、叔父夫婦の反対を押し切り単身横浜へ……。"},{"spoiler":false,"text":"横浜と並ぶ国際都市神戸で暮らしていたこともあり西洋文化に明るく、好奇心も旺盛。自立心も強く、しっかり物の彼女は、幼い頃から叔母から弓道の指導を受けていたため、その腕は確かなもの。また霊感が強く、方術の才にも目を見張るものがある。"}],"source":"egs","sourceCharacterId":"26735","sourceWorkId":"4909","spoiler":false},{"segments":[{"spoiler":false,"text":"永峰和人の実の妹で、両親が死んだときに兄と別れ、"},{"spoiler":false,"text":"神戸の叔父夫婦に預けられました。"},{"spoiler":false,"text":"横浜と並ぶ国際都市で育ったせいか、西洋文化に関する"},{"spoiler":false,"text":"知識も深く、新しい物好き。"},{"spoiler":false,"text":"買い物が趣味。料理も得意です。"},{"spoiler":false,"text":"叔母が弓道をやっており、彼女も幼い頃から弓を手にとって"},{"spoiler":false,"text":"指導を受けていたため、その力はかなりのものです。"},{"spoiler":false,"text":"また、霊感も強く方術の才能もあるようです。"},{"spoiler":false,"text":"いつか兄と再会することを夢見ていましたが、"},{"spoiler":false,"text":"祖母の死と兄の上京を知り、叔父夫婦の反対を"},{"spoiler":false,"text":"押し切って横浜へと旅立ちます。"},{"spoiler":false,"text":"女性陣の中では最年少ですが、実は一番自立心が強く、"},{"spoiler":false,"text":"しっかり者です。"}],"source":"bangumi","sourceCharacterId":"97463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7317e0d0a457e9ea60fabd7a2f6e53fec52b9385bbb019836f6e829f8f6c9892.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e66a691b2e870a10f1b25212006352b9aa28d94812eeaef7c236630a50f8e3a9.webp","width":125,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:43081:97463:4490:1","source":"bangumi"}]},{"characterId":"char_c56013","characterName":"永峰 和人","sourceIds":{"bangumi":[{"characterId":"97462","match":"exact-normalized-name-in-linked-work","subjectId":"43081"},{"characterId":"97462","match":"exact-normalized-name-in-linked-work","subjectId":"618759"}],"egsCharacterIds":["26734"],"vndbCharacterId":"c56013"},"originalCharacterName":"永峰 和人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幕末の動乱で両親を失ってしまいった彼は、田舎の祖母のもとにあずけれたが、その祖母が亡くなり、祖母が最後に残した遺言「桐谷五郎を頼りなさい」という言葉を頼りに横浜へと旅立った。"},{"spoiler":false,"text":"性格は温厚で、一見、頼りなさそうに見えるが、仲間のためなら身を投げ出すほどの勇気を秘めた青年。剣術の才はあるものの、その優しい性格が災いし、本来の力を発揮できていないようだが……。"}],"source":"egs","sourceCharacterId":"26734","sourceWorkId":"4909","spoiler":false},{"segments":[{"spoiler":false,"text":"町医者を営む両親と共に京都で暮らしていましたが、"},{"spoiler":false,"text":"幕末の動乱で両親を失い、田舎の祖母に引き取られました。"},{"spoiler":false,"text":"その祖母も先日亡くなり、「桐谷五郎を頼りなさい」という"},{"spoiler":false,"text":"遺言に従って横浜を訪れます。"},{"spoiler":false,"text":"性格はおっとりとして何かというと「うちのおばあちゃんが」と"},{"spoiler":false,"text":"引き合いに出すので頼りなく見えますが、いざとなると仲間を"},{"spoiler":false,"text":"守るために勇気を振り絞ることが出来ます。"},{"spoiler":false,"text":"剣術の才能はあるものの、優しい性格が災いして普段は力を"},{"spoiler":false,"text":"出し切れていないようです。"},{"spoiler":false,"text":"物語は、彼が横浜に降り立ったところから始まることになります。"}],"source":"bangumi","sourceCharacterId":"97462"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/2506b73cf959c1356e8cdb0eb2cfb7183a538349b803a40d77aaf3d7765c7a79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9291f5b8e1db4e95d03d970258b28de14f6f594f2497dc4fd3994182bfba30dc.webp","width":163,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水島大宙","creatorId":"vndb:s52","sourcePersonId":"vndb:s52","canonicalEntityId":"vndb:s52","name":"水島 大宙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:char