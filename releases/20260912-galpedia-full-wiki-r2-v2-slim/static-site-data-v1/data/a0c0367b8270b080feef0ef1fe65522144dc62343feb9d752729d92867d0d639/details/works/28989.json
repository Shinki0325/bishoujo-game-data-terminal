rce":"vndb","sourceCharacterId":"c72919"},{"segments":[{"spoiler":false,"text":"学園の生徒でもないのに、ちょこちょこ現れては道を訊ねていく謎のちみっ子。"},{"spoiler":false,"text":"と思ったら、どうやら彼女は実は学園の予科生で、本科の敷地に迷い込んでしまっていた模様。"},{"spoiler":false,"text":"「迷ってなどいません」と本人は断固否定しているが……。"},{"spoiler":false,"text":"予科生ながら、その魔法の腕はなんと熾月さえも唸らせるほど。"},{"spoiler":false,"text":"それもそのはず、どうやら彼女の母親は……。"},{"spoiler":false,"text":"そんな彼女のライフワークは地図作り。"},{"spoiler":false,"text":"ノートを片手に、彼女は今日もあちこちをさまよい歩く。"}],"source":"egs","sourceCharacterId":"20567","sourceWorkId":"26002","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の生徒でもないのに、ちょこちょこ現れては"},{"spoiler":false,"text":"道を訊ねていく謎のちみっ子。"},{"spoiler":false,"text":"と思ったら、どうやら彼女は実は学園の予科生で、"},{"spoiler":false,"text":"本科の敷地に迷い込んでしまっていた模様。"},{"spoiler":false,"text":"「迷ってなどいません」と本人は断固否定しているが……。"},{"spoiler":false,"text":"予科生ながら、その魔法の腕はなんと熾月さえも唸らせるほど。"},{"spoiler":false,"text":"それもそのはず、どうやら彼女の母親は……。"},{"spoiler":false,"text":"そんな彼女のライフワークは地図作り。"},{"spoiler":false,"text":"ノートを片手に、彼女は今日もあちこちをさまよい歩く。"},{"spoiler":false,"text":"「……それで、予科の校舎はどちらでしょう？」"}],"source":"bangumi","sourceCharacterId":"65038"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e035c0a5a140272bc2f2d4a18e022aa53a673471a8c78f6d01a79fae0ce065e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5c7101dd356a363ed7dbccdbb8d57a8e0ab4727ad1834a8a182dd92be2ab6f3.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295317:65038:4809:1","source":"bangumi"}]},{"characterId":"char_c74787","characterName":"渡来 菜生","sourceIds":{"bangumi":[{"characterId":"76801","match":"exact-normalized-name-in-linked-work","subjectId":"228301"}],"egsCharacterIds":["20568"],"vndbCharacterId":"c74787"},"originalCharacterName":"渡来 菜生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"923"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"こんなに可愛いのに性別はオトコノコ！？"},{"spoiler":false,"text":"もー、今どきそんなのびっくりすることでも何でもないでしょ？"},{"spoiler":false,"text":"あっけらかんとして笑う彼女（？）は、今となっては稀有な大和撫子で、控えめな性格の男の娘。"},{"spoiler":false,"text":"いつもみんなの一歩後ろを歩き、さりげない気遣いと、ふんわり笑顔で癒やしてくれる。"},{"spoiler":false,"text":"決して華やかでは無いけれど、その当たりの良さと笑顔のせいで実は男子から一番人気でした……"},{"spoiler":false,"text":"なんてことがあっても全く不思議じゃない。"},{"spoiler":false,"text":"いろんな理想を詰め込んだ、れっきとした男の娘なんです！"}],"source":"egs","sourceCharacterId":"20568","sourceWorkId":"26002","spoiler":false},{"segments":[{"spoiler":false,"text":"子供のころからずっと仲の良かった、いわゆる『幼馴染』の男の娘。"},{"spoiler":false,"text":"確かにその子は、普通の女の子より可愛くて、優しくて、健気で、気遣い上手で、"},{"spoiler":false,"text":"女子を差し置いて『彼女にしたいNo.1』に選ばれてしまうような、"},{"spoiler":false,"text":"女の子以上に女の子っぽい男の娘だったけれど……"},{"spoiler":false,"text":"何気ない仕草にドキッとさせられたり、"},{"spoiler":false,"text":"本人がそういうことを全く自覚していなくて困ったり、"},{"spoiler":false,"text":"そんなこともあったけれど……"},{"spoiler":false,"text":"それでも二人の間にあるのは『友情』だった……はず？"},{"spoiler":false,"text":"その気持ちに変化が生まれたのは、果たしてどちらが先だった？"}],"source":"bangumi","sourceCharacterId":"76801"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"76801","value":"桜ヶ丘学園2年"}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c74787","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"20568","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"20568","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"76801","v