oiler":false,"text":"と、思いきや意外と信頼は勝ち取っている、菜生と同じく、ご近所に住む親友の一人である。"},{"spoiler":false,"text":"チョップで電柱を真っ二つにする魔法だったり、街角で美少女とぶつかる魔法だったり、"},{"spoiler":false,"text":"と「なんじゃそりゃ」と呆れるようなオリジナル魔法を編み出すことに生きがいを感じている。"},{"spoiler":false,"text":"もっとも大抵それらは失敗に終わってしまうのだけど……。"},{"spoiler":false,"text":"基本的に幸せになれない星の下に生まれたような六介は、昨日も今日も、きっと明日も報われない!?"},{"spoiler":false,"text":"けれど全くめげずに常に前のめりを貫く姿勢は──"},{"spoiler":false,"text":"もしかしたらカッコいいのかも？"},{"spoiler":false,"text":"「聞いてくれよ！ また新しい魔法のアイデアを思いついたんだ！」"}],"source":"bangumi","sourceCharacterId":"139800"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c1eccb97adaaf57142fbef940d965e956da671ab20ad40f899e4e0ef2cfe3e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f79d4dcf199e939fb95152438007ce0c2c909611039d4df45ad87621084259c7.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石谷春貴","creatorId":"vndb:s8318","sourcePersonId":"vndb:s8318","canonicalEntityId":"vndb:s8318","name":"石谷 春貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295317:139800:2404:1","source":"bangumi"}]},{"characterId":"char_c74789","characterName":"九重 統也","sourceIds":{"bangumi":[{"characterId":"139801","match":"exact-normalized-name-in-linked-work","subjectId":"228301"}],"egsCharacterIds":["20570"],"vndbCharacterId":"c74789"},"originalCharacterName":"九重 統也","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"109"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"１年の時はお家の事情で休みがちだったクラスメイト。"},{"spoiler":false,"text":"その事情とは、病床の母親に代わって御咲神社の宮司を務めること。"},{"spoiler":false,"text":"けれど御咲神社の宮司は魔法使いでない者が選ばれるため、魔法使いの彼は、あくまで代行ということになる。"},{"spoiler":false,"text":"とても真面目な性格で正義感に熱い彼は、姉である楓子の予測不能な行動にいつも振り回されている様子。"},{"spoiler":false,"text":"でも、問題ないでしょう？ だって彼は重度のシスコンだから。"},{"spoiler":false,"text":"きっとそんな日々だって幸せのはず！"}],"source":"egs","sourceCharacterId":"20570","sourceWorkId":"26002","spoiler":false},{"segments":[{"spoiler":false,"text":"1年の時はお家の事情で休みがちだったクラスメイト。"},{"spoiler":false,"text":"その事情とは、病床の母親に代わって御咲神社の宮司を務めること。"},{"spoiler":false,"text":"けれど御咲神社の宮司は魔法使いでない者が選ばれるため、"},{"spoiler":false,"text":"魔法使いの彼は、あくまで代行ということになる。"},{"spoiler":false,"text":"とても真面目な性格で正義感に熱い彼は、"},{"spoiler":false,"text":"姉である楓子の予測不能な行動にいつも振り回されている様子。"},{"spoiler":false,"text":"でも、問題ないでしょう？ だって彼は重度のシスコンだから。"},{"spoiler":false,"text":"きっとそんな日々だって幸せのはず！"},{"spoiler":false,"text":"「一条くん、姉さんのことで相談に乗ってもらえませんか？」"}],"source":"bangumi","sourceCharacterId":"139801"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"139801","value":"桜ヶ丘学園2年"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2323945d4853137ea7b98ff94761708f73e7c8fb80453ae02bff41a0cb8b352.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd45816085814d102150fe5c7f9c14f41f02923e09f86b030c67266724ee5681.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古河徹人","creatorId":"vndb:s299","sourcePersonId":"vndb:s299","canonicalEntityId":"vndb:s299","name":"古河 徹人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295317:139801:6265:1","source":"bangumi"}]},{"characterId":"char_c74790","characterName":"橘 海音","sourceIds":{"bangumi":[{"characterId":"76802","match":"exact-normalized-name-in-linked-work","subjectId":"228301"}],"egsCharacterIds":["20571"],"vndbCharacterId":"c74790"},"originalCharacterName":"橘 海音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"204"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"和綺、熾月、瑞月の母親である美空が亡くなった後、三人を引き取った育ての母。"},{"spoiler":false,"text":"学園では雑貨屋兼、魔道具店兼、カフェ「Oasis」を経営している。"},{"spoiler":false,"text":"お気楽ご気楽なゆる～い性格で、放任主義を称しているため誤解してしまいそうになるけれど、実はこれでかなり面倒見が良かったりする。"},{"spoiler":false,"text":"学生の頃から珠洲子とは親友であり、バラされたくない秘密をいろいろ握られている。"},{"spoiler":false,"text":"……昔はとってもこわ～い人だった？"}],"source":"egs","sourceCharacterId":"20571","sourceWorkId":"26002","spoiler":false},{"segments":[{"spoiler":false,"text":"エプロン姿がトレードマーク。"},{"spoiler":false,"text":"年齢不詳のお気楽ご気楽おかーさん。"},{"spoiler":false,"text":"親友の子である和綺、熾月、瑞月を引き取って、"},{"spoiler":false,"text":"その成長を今日まで温かく見守ってきた。"},{"spoiler":false,"text":"最近、家庭内が妙に色めいているのを感じているけれど、それはそれ！"},{"spoiler":false,"text":"「放任主義」の旗のもと、その行く末も温かく見守るつもりでいるらしい。"},{"spoiler":false,"text":"「だって恋なら止められないよね！」"},{"spoiler":false,"text":"愛があれば大丈夫、と背中を押す、どこまでも懐の深いかーさんなのだった。"}],"source":"bangumi","sourceCharacterId":"76802"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b617f531bb02ea29a04573d03f38184d5ff6703fc23d2fe604aea2698d79266e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/343b71f2ad03f5aa4682b619aed824c05c2762d97f3a1e1fd651be27c24dd46b.webp","width":213,"height":256,"source":"static-detail"},