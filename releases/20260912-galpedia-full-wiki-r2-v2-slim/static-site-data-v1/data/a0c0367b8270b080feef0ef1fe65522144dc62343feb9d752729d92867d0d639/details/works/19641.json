ys spends that time with her brother."},{"spoiler":false,"text":"As a member of the Bishop class, Ririko is basically the team's buffer. She often chants healing and buffing spells instead of attacking."}],"source":"vndb","sourceCharacterId":"c18315"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b12051201b5a98a4f0690d94c687e7f2d957c47532540a22f447d132d22c349.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d6b9bbc94cf0204b5e7ce35990f46b6af9c593184fab2366e6179125dc3c7ad.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋野 花","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55293","source":"vndb"}]},{"characterId":"char_vndb_c18358","characterName":"海棠 秀穂","sourceIds":{"vndbCharacterId":"c18358"},"originalCharacterName":"海棠 秀穂","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Screen Name: Begonia"},{"spoiler":false,"text":"Class: Knight"}],"source":"vndb","sourceCharacterId":"c18358"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76343b7de1ccd913934479cacc68a745802a1d0d23fecfbaf7599ae7a736f678.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78c43190fba79ea43a577273a99b1e1c838565e4d75adfdd47873ac1779a4982.webp","width":256,"height":233,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c18360","characterName":"綿貫 敦盛","sourceIds":{"vndbCharacterId":"c18360"},"originalCharacterName":"綿貫 敦盛","chara