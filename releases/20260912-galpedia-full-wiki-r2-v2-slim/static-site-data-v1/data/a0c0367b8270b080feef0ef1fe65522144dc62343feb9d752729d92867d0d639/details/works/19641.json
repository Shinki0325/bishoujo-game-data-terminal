vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Screen name: Anonym"},{"spoiler":false,"text":"Class: Paladin"},{"spoiler":false,"text":"Transfer student that sits behind Shuuho. Under her sister Ayame's instructions, she bought the game Wizard Generation for him. She looks like a normal transfer student but she is actually a huge game addict. For her interesting things are a top priority, and when faced with troubles she will put it off. In other words, she is quite dumb."},{"spoiler":false,"text":"She plays as the Paladin class in Wizard Generation that can use priest incantations. In order to look \"cool\", she equipped the katana \"Tachibana\" way too early in the game, which is why she had a difficulty playing at first. Because she wears a miko dress in-game, Anon calls herself a Japanese Paladin."},{"spoiler":true,"text":"Anon and Ouka are blood related relatives"}],"source":"vndb","sourceCharacterId":"c18311"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a0735781a648e4d2dad989d1c4d8e375b98651a21c2a7f5e2e71726e5ec9398.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d372c9461340b4ecc417a3344ffed026a0b0ea6103ef405eba6dff17076b5ee.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平内 あや","creatorId":"vndb:s1648","sourcePersonId":"vndb:s1648","canonicalEntityId":"vndb:s1648","name":"中村 繪里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55296","source":"vndb"}]},{"characterId":"char_vndb_c18312","characterName":"星咲 桜花","sourceIds":{"vndbCharacterId":"c18312"},"originalCharacterName":"星咲 桜花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"407"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"96"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Screen name: Cerasus"},{"spoiler":false,"text":"Class: Esper"},{"spoiler":false,"text":"Shuuho's class representative. Diligent and hardworking girl, she often complains because he's always talking about games. She is very close to the new transfer student Anon, and after getting fed up with the talk of Wizard Generation, she declared that she will try it once and that will be it, but ended up getting hooked. Originally she often complained about the vigilant Anon, but ended up becoming friends with her. She is always in distress because of her rashness. Because she barely knew anything about the game, Shuuho taught her how to play it."},{"spoiler":true,"text":"Ouka is blood related to both Anon and Ayame. She is revealed to be their relative. So in a way she is their cousin"}],"source":"vndb","sourceCharacterId":"c18312"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79e4781851739ed8d96906b1b2b360474fceb0cd36372f5535b84279d0de3dd7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2af3f97ff8a5147540e7b86a57a8670e7ef79e141216be0bce7f195ea0c53752.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星咲 イリア","creatorId":"vndb:s436","sourcePersonId":"vndb:s436","canonicalEntityId":"vndb:s436","name":"咲乃 藍里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55292","source":"vndb"}]},{"characterId":"char_vndb_c18313","characterName":"敷島 なつめ","sourceIds":{"vndbCharacterId":"c18313"},"originalCharacterName":"敷島 なつめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"107"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Screen name: YamatoHime"},{"spoiler":false,"text":"Class: Hunter"},{"spoiler":false,"text":"Shuuho's childhood friend and senpai. Because she considers herself a reliable onee-san, she always looks after Shuuho and Ririko because their parents are rarely home, and is like a guardian to them. While she is a carefree girl, she is actually very proficient in all household chores. While her grades are honor student level, she also is a legend at spreading rumors on the internet. She was invited to play Wizard Generation by her online acquaintance Anonym (Anon), but because she knows that Shuuho also plays the game, she is rarely online. Natsume is also bad at cooking."}],"source":"vndb","sourceCharacterId":"c18313"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/4654a7beb52a2c6e1c1fc036c9c3950b6d1f082d0d4dc57a9949fe22d0cf576d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da349abe58b0ccebde5fb264056b7f1576fce8a3f071e87ab1d803d755d9d7a6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55287","source":"vndb"}]},{"characterId":"char_vndb_c18314","characterName":"紅藤 友梨亜","sourceIds":{"vndbCharacterId":"c18314"},"originalCharacterName":"紅藤 友梨亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1013"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Screen name: JuliaDG"},{"spoiler":false,"text":"Class: Magician"},{"spoiler":false,"text":"Shuuho's kouhai and Ririko's classmate. Yuria's parents are French, but married in Japan and naturalized Japanese, so she was born in Japan and grew up without any inconvenience in Japanese culture and language. She and her parents are actual magicians, so naturally she too chose the magician class."},{"spoiler":false,"text":"She saw that Ririko has great qualities in magic, so she always imitates her in a strange ceremony that produces unexpected and sudden fear. Because her level is way too low, she cannot use magic properly in Wizard Generation, which makes her frustrated because she's on the same level as normal people."}],"