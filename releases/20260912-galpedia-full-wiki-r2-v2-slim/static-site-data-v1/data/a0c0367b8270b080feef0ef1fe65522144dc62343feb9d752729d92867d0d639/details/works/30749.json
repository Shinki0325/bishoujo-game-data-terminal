{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30749","model":{"presentationWorkId":"egs:30749","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_154414","characterName":"水瀬慧斗","sourceIds":{"bangumi":[{"characterId":"154414","match":"source-roster","subjectId":"302693"}]},"originalCharacterName":"水瀬慧斗","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"幼い頃に事故で両親を亡くし、叔父の一家に身を寄せている。"},{"spoiler":false,"text":"以来温かな人々に囲まれながらもどこか疎外感と孤独感を抱いている。"},{"spoiler":false,"text":"天体観測が趣味で、小高い山の頂上・星見平の廃天文台で眞都と出会う。"},{"spoiler":false,"text":"眞都との出会いを経て、慧斗の中で何かが少しずつ変わっていく。"},{"spoiler":false,"text":"斜に構えているが、その実人好きで心優しい性格。"}],"source":"bangumi","sourceCharacterId":"154414"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e515212e79ca22885321c5454565fed0e855999180b5eaa4ccccd5dec99e5aad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9eaac683c7fdce5d97e711c41a9d444042a3b24e4e15cc58327cd1d72b0e7a26.webp","width":175,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_154415","characterName":"星渡眞都","sourceIds":{"bangumi":[{"characterId":"154415","match":"source-roster","subjectId":"302693"}]},"originalCharacterName":"星渡眞都","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"夜の廃天文台で慧斗と出会う記憶喪失の少女。透き通った声の持ち主。"},{"spoiler":false,"text":"穏やかで人懐っこい性格だがどこか屈託を抱えており、"},{"spoiler":false,"text":"飄々として蜃気楼のような謎めいた雰囲気を醸し出している。"},{"spoiler":false,"text":"何かを探して「七つの海」を越えてきたと言い、記憶が戻るまで慧斗の住む家に身を寄せ、慧斗たちと交流を深めていく。"}],"source":"bangumi","sourceCharacterId":"154415"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2abdcc1b58f6b7c21bb573280a4fd2f431f78b5b4e73dd54f76d742beb4d2bdb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3610ba3a2c6aee4fb5e0c3a18bbffc8e16b189e02b8d869ec547237debad1e1.webp","width":177,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_154416","characterName":"幣原柳花","sourceIds":{"bangumi":[{"characterId":"154416","match":"source-roster","subjectId":"302693"}]},"originalCharacterName":"幣原柳花","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"慧斗と同じクラスのクラス委員。"},{"spoiler":false,"text":"皆から頼られる姉御肌であり、"},{"spoiler":false,"text":"慧斗をはじめとする周りの人たちの世話を色々と焼いている。"},{"spoiler":false,"text":"さっぱりサバサバとした快活な性格だが、相当な照れ屋さん。"},{"spoiler":false,"text":"古くから御浜町にある神社の家系で、普段から家業を手伝っている。慧斗とは高1から同じクラスで、何かと気になる存在。"}],"source":"bangumi","sourceCharacterId":"154416"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdd33db3ce4aaf6f8372cddc62906b49087b76584e339caae8991e57a8101797.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dece2533483c4303832471c1b382d5ed24354d8dcfb187608c4d0ddeb9333ffa.webp","width":177,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_154417","characterName":"鍵村遠枝","sourceIds":{"bangumi":[{"characterId":"154417","match":"source-roster","subjectId":"302693"}]},"originalCharacterName":"鍵村遠枝","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"慧斗の従姉妹で「稀代のアホふたり」と呼ばれる双子の妹。元気いっぱいで人懐っこく、明るく素直な女の子。"},{"spoiler":false,"text":"なんでも楽しめる気質で、周りの人々を知らぬ間に笑顔にする天才。周りと距離をとろうとする慧斗を元気づけようと、様々なことに巻き込んでは慧斗を呆れさせている。"},{"spoiler":false,"text":"こう見えて引きこもり体質で、お絵かきとゲームが生きがい。"}],"source":"bangumi","sourceCharacterId":"154417"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/722889f74ea28488085120857212ba9216fc3bf9ce328d3533cb2c96d3fbf9a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93062e757eaad6ed1a73ad2271ceef71b2cabc78fa501cc6a38a6d44f03bfd56.webp","width":177,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_154418","characterName":"鍵村久哉","sourceIds":{"bangumi":[{"characterId":"154418","match":"source-roster","subjectId":"302693"}]},"originalCharacterName":"鍵村久哉","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"慧斗の従兄弟で「街一番のアホ」と名高い双子の兄。"},{"spoiler":false,"text":"かなりのお調子者で常識デストロイヤー。"},{"spoiler":false,"text":"慧斗とはライバル兼親友(自称)。"},{"spoiler":false,"text":"ふだんのあまりにアホすぎる言動と時おり垣間見せるヘタレっぷりから、学校では適当な扱いを受けている。"},{"spoiler":false,"text":"演劇部の新進気鋭の演出家(部員二名)。"},{"spoiler":false,"text":"周りの人から酷い目に遭わされることが多い受難の徒。"}],"source":"bangumi","sourceCharacterId":"154418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f56f5aebbb2cd724a63286261e81cab42f652475004771bffe393921746a232.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afb31bf1261cd48b02664e698021ff0e227766b85a9bd3ef22b195fb8235d375.webp","width":177,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_154419","characterName":"海野詩織","sourceIds":{"bangumi":[{"characterId":"154419","match":"source-roster","subjectId":"302693"}]},"originalCharacterName":"海野詩織","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"慧斗が学校の図書室で出会う図書委員の1年生。"},{"spoiler":false,"text":"物憂げな雰囲気を纏う、孤独な少女。"},{"spoiler":false,"text":"いったん標的にした相手にはひたすら毒舌を浴びせかける一面も。"},{"spoiler":false,"text":"辞書は読む派。ラーメンは家系派。"},{"spoiler":false,"text":"昼夜は逆転派。授業は週3でサボる派。"},{"spoiler":false,"text":"この世界を「偽物」と断言し、生きることにどこか怯えを覗かせる。"}],"source":"bangumi","sourceCharacterId":"154419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/883abaf3711ab2c038f71055cd396c669e9eb941809dc2c235b1288119c4b8d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/1420974fc61f77fd58c8f38fa1edfb28cf89588b7a81c16668a97d2e5c963aa4.webp","width":177,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_154420","characterName":"鍵村叙名","sourceIds":{"bangumi":[{"characterId":"154420","match":"source-roster","subjectId":"302693"}]},"originalCharacterName":"鍵村叙名","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"双子の父親で、慧斗の血の繋がらない叔父。"},{"spoiler":false,"text":"ノリがよく何事にも動じない優しいお父さん。だけどたまにアホ。"},{"spoiler":false,"text":"十年前に妻を亡くし、男手ひとつで双子を育て上げた。"},{"spoiler":false,"text":"七年前に天涯孤独の身となった慧斗を引き取る。"},{"spoiler":false,"text":"彼がなんの仕事をしているかは誰も知らない。"},{"spoiler":false,"text":"舞台となる御浜町の出身ではないというが…"}],"source":"bangumi","sourceCharacterId":"154420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/faccdfb6d821737376066c968f4f7263c5e0ad022aa0b68c8348cd8ac8ae4411.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08372a97c7981f41dd575cd7b4be103c5689e898591b9119ff520449f07b8738.webp","width":177,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:6924","sourceCompanyId":"egs:brand:6924","canonicalEntityId":"egs:brand:6924","name":"劇団くじら座","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:30749:6924","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
