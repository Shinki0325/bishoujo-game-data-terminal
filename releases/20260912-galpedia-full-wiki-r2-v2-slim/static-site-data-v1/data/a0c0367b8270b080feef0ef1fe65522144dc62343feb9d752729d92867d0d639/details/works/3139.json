,"canonicalEntityId":"vndb:s19125","name":"身から出た鯖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34596","source":"vndb"}]},"cast":[{"characterId":"char_c51926","characterName":"本木 るい","sourceIds":{"bangumi":[{"characterId":"141117","match":"exact-normalized-name-in-linked-work","subjectId":"348548"}],"egsCharacterIds":["22778"],"vndbCharacterId":"c51926"},"originalCharacterName":"本木 るい","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"金髪が自慢の資産家の娘。"},{"spoiler":false,"text":"子供扱いされのが大嫌いで、プライドも高く、すぐ怒り、すぐ吠える感情表現豊かな女の子。"},{"spoiler":false,"text":"美亜をライバル視し、熾烈な主人公争奪戦を繰り広げる。"},{"spoiler":false,"text":"そのため、美亜に負けたくないばかりに過激なエッチを主人公に求めてくる。"},{"spoiler":false,"text":"常に親友のクマのぬいぐるみ「ラインハルト」を抱いて離さない。"}],"source":"egs","sourceCharacterId":"22778","sourceWorkId":"2557","spoiler":false},{"segments":[{"spoiler":false,"text":"実家は資産家で、縦ロールの金髪が自慢のお嬢様。"},{"spoiler":false,"text":"相変わらず主人公をめぐり、美亜と熾烈な奪い合いを繰り広げる宿命のライバル。"},{"spoiler":false,"text":"身なりはやや少女趣味で、クマのぬいぐるみとかクマグッズが大好き。"},{"spoiler":false,"text":"常に親友のクマのぬいぐるみ「ラインハルト」を抱いて、手放さない。"},{"spoiler":false,"text":"大きくなってもすぐ怒る、すぐ吠えるという激情の持ち主。"},{"spoiler":false,"text":"でもホントは主人公に甘えたかったり。"},{"spoiler":false,"text":"美亜に負けたくないばっかりに、常に主人公に過激なエッチをおねだり。"},{"spoiler":false,"text":"両親に主人公と付合う事の了解を得て、正に「お嫁さんにして！」と切り込んでくる。"}],"source":"egs","sourceCharacterId":"22778","sourceWorkId":"3139","spoiler":false},{"segments":[{"spoiler":false,"text":"『ふくらみかけ りた～んず』、『ふくらみかけ2 ～ブラかえました～』に登場。"},{"spoiler":false,"text":"原画：ごまさとし（トラヴュランス）"},{"spoiler":false,"text":"実家は資産家で、縦ロールの金髪が自慢のお嬢様。"},{"spoiler":false,"text":"相変わらず主人公をめぐり、美亜（『ふくらみかけ』シリーズヒロイン）と熾烈な奪い合いを繰り広げる宿命のライバル。"},{"spoiler":false,"text":"身なりはやや少女趣味で、クマのぬいぐるみとかクマグッズが大好き。"},{"spoiler":false,"text":"常に親友のクマのぬいぐるみ「ラインハルト」を抱いて、手放さない。"}],"source":"egs","sourceCharacterId":"22778","sourceWorkId":"3801","spoiler":false},{"segments":[{"spoiler":false,"text":"実家は資産家で、縦ロールの金髪が自慢のお嬢様。"},{"spoiler":false,"text":"主人公をめぐり、美亜と熾烈な奪い合いを繰り広げる宿命のライバル（？）です。"},{"spoiler":false,"text":"身なりはやや少女趣味で、クマのぬいぐるみとかクマグッズが大好き。"},{"spoiler":false,"text":"常に親友のクマのぬいぐるみ「ラインハルト」を抱いて、手放さない。"},{"spoiler":false,"text":"○○扱いされるが嫌いで、すぐ怒る、すぐ吠えるという激情の持ち主。"},{"spoiler":false,"text":"でもホントは主人公に甘えたかったり・・・。"}],"source":"bangumi","sourceCharacterId":"141117"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bde322d9dce8bfcf50149edca31096093691ed03321c2aadd31ae0e208087d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dab6f180614d5be2da3150925f0c58419163e561b7c74f356026bbdf7dde76c.webp","width":256,"height":228,"source":"static-detail"},"actors":[{"creditedName":"内川藍維","creatorId":"vndb:s197","sourcePersonId":"vndb:s197","canonicalEntityId":"vndb:s197","name":"内川 藍維","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:348548:141117:8167:1","source":"bangumi"}]},{"characterId":"char_vndb_c51925","characterName":"秋葉 美亜","sourceIds":{"vndbCharacterId":"c51925"},"originalCharacterName":"秋葉 美亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d88cdd5d3945813caba911c2256724b38d406f81e7fee20056af37eec3479568.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b498c4c6935203ba7937ddee54cad6083b3e7c0b9ad1167ba614a24d0427d513.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","s