ojo.date/terminal-wiki/v1/characters/v1/images/79/79bad0b2d4d06e9a7d4dcdd07626dc74bd92eef515f576751986459380b188c6.webp","width":200,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c66337","characterName":"田村 千早","sourceIds":{"vndbCharacterId":"c66337"},"originalCharacterName":"田村 千早","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Reserved and weak-willed housewife but always thinking of her family the most. She is strong and reliable mother when it comes to her daughter Hina. Because her husband always works until late and she also has to work to support the family, she relies on the protagonist to take care of Hina without knowing he has feeling for her."}],"source":"vndb","sourceCharacterId":"c66337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7da03b48ee9422c52f1fd3597e867c2a8ddd93a7ec10186ec2e49e2eb4326a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4a187067cace94cc638ae980003d7c88b76ccf562416405bf63ba9d8e98b8af.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"霧島 はるな","creatorId":"vndb:s2698","sourcePersonId":"vndb:s2698","canonicalEntityId":"vndb:s2698","name":"霧島はるな(水無月じゅん)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42841","source":"vndb"}]},{"characterId":"char_vndb_c66338","characterName":"田村 雛","sourceIds":{"vndbCharacterId":"c66338"},"originalCharacterName":"田村 雛","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Chihaya. She loves her mother and the protagonist because he always takes care of her. Because her father neglects her and the family, she wishes the protagonist could be her father instead."}],"source":"vndb","sourceCharacterId":"c66338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0f3c91312c5285cc4af3e44b4c9991ae58b4e82573067360aa0675c74a746e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d4cf5985c04f38dc9353cd20d6dee7c897d7db1f9b664b3e10eb55fb50319b3.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c66339","characterName":"田村 清司","sourceIds":{"vndbCharacterId":"c66339"},"originalCharacterName":"田村 清司","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chihaya's husband and Hina's father. He prioritizes working over his family and always looks tired. He often complains about Chihaya not doing her job well as housewife and even treats his own daughter crudely."}],"source":"vndb","sourceCharacterId":"c66339"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/334ee95c62a8b799b9b008037d196e0e660998ee4c944cd3f9c239aed16ba057.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a66ef3f79fda0a822dc1804b7b6e6a5185fb756d96316cc3a280f0eabf15e326.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2273","sourceCompanyId":"egs:brand:2213","canonicalEntityId":"vndb:p2273","name":"平安亭","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15961