":"19802","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"2960","sourceWorkId":"19802","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"2960","sourceWorkId":"19802","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"2960","sourceWorkId":"19802","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d4d26ff1148df06a5e6329761e4db734c05111808fb5a11d5f61d9a048d1848.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e06e77feaa1a6cad520c076e6c337689816851b713e8b705607a1d78eebd2f8a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉野 裕夏","creatorId":"vndb:s2582","sourcePersonId":"vndb:s2582","canonicalEntityId":"vndb:s2582","name":"吉野裕夏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55943","source":"vndb"}]},{"characterId":"char_c20843","characterName":"佐万 桜子","sourceIds":{"bangumi":[{"characterId":"25434","match":"exact-normalized-name-in-linked-work","subjectId":"99161"}],"egsCharacterIds":["2961"],"vndbCharacterId":"c20843"},"originalCharacterName":"佐万 桜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite sweets: Madeleines"}],"source":"vndb","sourceCharacterId":"c20843"},{"segments":[{"spoiler":false,"text":"優人のクラス担任で、学園にこの春赴任してきた新人教師。"},{"spoiler":false,"text":"可愛らしい見た目と美しいプロポーションを持つ桜子は、前向きで一生懸命な姿も併せ、男性女性・生徒教師を問わずたちまち人気者になった。"},{"spoiler":false,"text":"休み時間や放課後などは女子生徒達に囲まれていて、迂闊に男子が近寄れない状態になっていることも多い。"},{"spoiler":false,"text":"一生懸命で一途な性格をしているが、時折それが行き過ぎて周りが見えなくなってしまうことも……。"},{"spoiler":false,"text":"偶然居合わせたことにより優人の家が焼失したことを知り、彼を自宅で預かる事を決める。"},{"spoiler":false,"text":"可愛いものには目が無く、可愛い系の優人の事を一目見たときから気に入っていたが、同居して身近にいることが多くなると、彼をどうにかしてしまいたいという衝動が胸の奥に芽生えるのだった。"}],"source":"egs","sourceCharacterId":"2961","sourceWorkId":"19802","spoiler":false},{"segments":[{"spoiler":false,"text":"この春から学園に赴任してきた新人教師。"},{"spoiler":false,"text":"一生懸命な性格ゆえに、学生の厄介事にも躊躇無く入ってくる。"},{"spoiler":false,"text":"優人の家が焼失したことを知り、彼を1ヵ月預かることになる。"},{"spoiler":false,"text":"可愛いものには目が無く、可愛い系の優人のこともどうにかしてしまいたいという衝動が胸の奥に芽生える。"},{"spoiler":false,"text":"数年前に両親が他界してから、家の中のことは彼女が取り仕切っている。"}],"source":"bangumi","sourceCharacterId":"25434"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"2961","sourceWorkId":"19802","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"2961","sourceWorkId":"19802","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"2961","sourceWorkId":"19802","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"2961","sourceWorkId":"19802","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be84deedd33702b5331961ffd0d78d43e662664737168394bdebad2e507ff504.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0407100b88b8658bb2cbc7b1bbe20ea621a77531d609a054849c030b3f78bf3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99161:25434:19213:1","source":"bangumi"}]},{"characterId":"char_c20844","characterName":"田町 香里","sourceIds":{"bangumi":[{"characterId":"25435","match":"exact-normalized-name-in-linked-work","subjectId":"99161"}],"egsCharacterIds":["2962"],"vndbCharacterId":"c20844"},"originalCharacterName":"田町 香里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite sweets: Anything"}],"source":"vndb","sourceCharacterId":"c20844"},{"segments":[{"spoiler":false,"text":"優人のクラスメイトの女の子で、いつでもどこでも常に何かを食べている。"},{"spoiler":false,"text":"食べ物があれば幸せ……というか、無いと生きていけない。"},{"spoiler":false,"text":"他のクラスメイトから「こおりの胃袋はブラックホール」と言われる程の大食いだが、身体は健康そのものであり、栄養が全部胸に行っているという噂。"},{"spoiler":false,"text":"あめる時、優人から甘い匂いがすることを知り興味を持つ。"},{"spoiler":false,"text":"実際に舐めてみても特に甘い味はしなかったが、ことあるごとに優人の側について回ったり、匂いを嗅いでは悦に浸っている。"},{"spoiler":false,"text":"家では裸族で、下着を着けるのを忘れたまま学園に来てしまうことがよくあるが本人はあまり気にしていない。"}],"source":"egs","sourceCharacterId":"2962","sourceWorkId":"19802","spoiler":false},{"segments":[{"spoiler":false,"text":"優人と2年連続で同じクラスになったクラスメイト。"},{"spoiler":false,"text":"食べ物があれば幸せ……というか、無いと生きていけない。 いつでもどこでも何かを食べている。"},{"spoiler":false,"text":"甘い匂いがすることから優人に興味を持ったが、舐めてみても無味無臭。"},{"spoiler":false,"text":"その後も、なにかというとすぐ側に居たり、後を付いてきたりするようになった。"},{"spoiler":false,"text":"他のクラスメイトから 「こおりの胃袋はブラックホール」 と言われるほどの大食いで、栄養が全部胸に行っているという噂もある。"},{"spoiler":false,"text":"家では裸族で、下着を着けるのを忘れたまま学園に来てしまうことがよくある （本人はあまり気にしていない）。"}],"source":"bangumi","sourceCharacterId":"25435"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"2962","sourceWorkId":"19802","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"2962","sourceWorkId":"19802","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"2962","sourceWorkId":"19802","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"2962","sourceWorkId":"19802","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fcb8d9a80baa0f143f12ae7b89d940bde015f97179e9d65f7574befd365a294.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/619a3036d114db366d2d44e530ab658c5a72e1aee53586714e385ce7fb00a05e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤田しずく","creatorId":"vndb:s937","sourcePersonId":"vndb:s937","canonicalEntityId":"vndb:s937","name":"藤田 しずく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99161:25435:16178:1","source":"bangumi"}]},{"characterId":"char_c76630","characterName":"佐万 夏江","sourceIds":{"bangumi":[{"characterId":"25437","match":"exact-normalized-name-in-linked-work","subjectId":"99161"}],"egsCharacterIds":["2963"],"vndbCharacterId":"c76630"},"originalCharacterName":"佐万 夏江","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"