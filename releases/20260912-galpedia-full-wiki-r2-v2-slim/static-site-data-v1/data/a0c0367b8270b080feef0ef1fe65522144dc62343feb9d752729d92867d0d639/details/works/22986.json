{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22986","model":{"presentationWorkId":"vndb:v18754","staff":{"artwork":[{"creditedName":"会田孝信","creatorId":"vndb:s3875","sourcePersonId":"egs:creator:13911","canonicalEntityId":"vndb:s3875","name":"会田孝信","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:160458","source":"egs"}],"scenario":[{"creditedName":"JUN","creatorId":"egs:creator:240","sourcePersonId":"egs:creator:240","canonicalEntityId":"egs:creator:240","name":"JUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:160456","source":"egs"},{"creditedName":"日吉ひより","creatorId":"vndb:s3874","sourcePersonId":"egs:creator:21047","canonicalEntityId":"vndb:s3874","name":"日吉ひより","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:160457","source":"egs"},{"creditedName":"JUN","creatorId":"vndb:s1628","sourcePersonId":"vndb:s1628","canonicalEntityId":"vndb:s1628","name":"JUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:127120","source":"vndb"}],"music":[{"creditedName":"E;ROS","creatorId":"vndb:s14355","sourcePersonId":"vndb:s14355","canonicalEntityId":"vndb:s14355","name":"E;ROS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:127124","source":"vndb"}],"other":[{"creditedName":"MAMI","creatorId":"vndb:s4008","sourcePersonId":"vndb:s4008","canonicalEntityId":"vndb:s4008","name":"柳 麻美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:127123","source":"vndb"}]},"cast":[{"characterId":"char_c13132","characterName":"篠崎 六夏","sourceIds":{"bangumi":[{"characterId":"22643","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["1979"],"vndbCharacterId":"c13132"},"originalCharacterName":"篠崎 六夏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student who was accepted into the escalator school of St. Michael's through taking outside entrance exams."},{"spoiler":false,"text":"Shortly after enrolling, she set a new national record in the 100 meter dash and became an instant celebrity on campus."},{"spoiler":false,"text":"She has a kind disposition, and has to intervene when she sees someone in trouble. Because of that tendency, she's earned the nickname, \"Sir Knight\" (騎士様)."},{"spoiler":false,"text":"She serves as vice-representative of her class, and was chosen along with class representative Sayuki as one of the academy’s Best Couples."},{"spoiler":false,"text":"Translated from post with info from Dengeki Hime"}],"source":"vndb","sourceCharacterId":"c13132"},{"segments":[{"spoiler":false,"text":"聖ミカエル女子学園に外部入学してきた１年生。入学早々、全国レベルの１００ｍ記録を出してしまい、一躍有名人になってしまったスポーツ少女。それでいて困っている人を放っておけない性格で、すっかり人気者に。"},{"spoiler":false,"text":"クラス副委員長であり、委員長である沙雪と共にベストカップルに選出され、その頼りになる人柄から「白雪の騎士」と呼ばれている模様。どうやら璃紗とはなにか関係がある様だが……？"}],"source":"egs","sourceCharacterId":"1979","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"聖ミカエル女子学園に外部入学してきた１年生。入学早々、全国レベルの１００ｍ記録を出してしまい、"},{"spoiler":false,"text":"一躍有名人になってしまったスポーツ少女。それでいて困っている人を放っておけない性格で、すっかり人気者に。"},{"spoiler":false,"text":"クラス副委員長であり、委員長である沙雪と共にベストカップルに選出され、その頼りになる人柄から"},{"spoiler":false,"text":"「白雪の騎士」と呼ばれている模様。どうやら璃紗とはなにか関係がある様だが……？"},{"spoiler":false,"text":"声：緑川円 (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"22643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eda9957b96d3488a21ca3180447bdfd4eaa6f4516abcabe4d1830fbebf53e17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7792917f5d64d4bd316b654f159565671324b1b527b81b126ec576f9b88462e4.webp","width":87,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c13133","characterName":"白河 沙雪","sourceIds":{"bangumi":[{"characterId":"22644","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["1980"],"vndbCharacterId":"c13133"},"originalCharacterName":"白河 沙雪","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A classmate of Rikka's. Serving as class representative, she lives with her grandfather, who is apparently descended from samurai who once defended a castle."},{"spoiler":false,"text":"Her name combined with her noble lineage has earned her the nickname \"Snow White\" (白雪姫)."},{"spoiler":false,"text":"Additionally, being both beautiful and brilliant, a scholar and an athlete, she’s been touted by many as the second coming of \"The Perfect Lady\"."},{"spoiler":false,"text":"In no time at all after her enrollment, these abilities result in her being entrusted with the role of Chairman of the Environmental Improvement Committee, which is essentially the academy's student council."},{"spoiler":false,"text":"Translated from post with info from Dengeki Hime"}],"source":"vndb","sourceCharacterId":"c13133"},{"segments":[{"spoiler":false,"text":"六夏の同級生でクラスメイト。才色兼備、文武両道にして環境整備委員会に選出された才媛。"},{"spoiler":false,"text":"中等部時代からその名声は轟き、ＯＧである蓬莱泉麗奈以来の「究極の淑女」との呼び声も高い。"},{"spoiler":false,"text":"実家は祖父が城を所有しているとの噂もある武家の末裔で、その名前から「白雪姫」とあだ名されている。"},{"spoiler":false,"text":"六夏と璃紗のスキャンダル（？）を切っ掛けに、さらに渦中の人になってしまい……？"}],"source":"egs","sourceCharacterId":"1980","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"六夏の同級生でクラスメイト。才色兼備、文武両道にして環境整備委員会に選出された才媛。"},{"spoiler":false,"text":"中等部時代からその名声は轟き、ＯＧである蓬莱泉麗奈以来の「究極の淑女」との呼び声も高い。"},{"spoiler":false,"text":"実家は祖父が城を所有しているとの噂もある武家の末裔で、その名前から「白雪姫」とあだ名されている。"},{"spoiler":false,"text":"六夏と璃紗のスキャンダル（？）を切っ掛けに、さらに渦中の人になってしまい……？"},{"spoiler":false,"text":"声：咲智ゆん (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"22644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34dc7ff725377a372e61d10a8ee5c46e06fd17eafd3437bf0f2a5fbffd7ae1d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a076030fd7de5d68da69c11b192cf686b6c770e26a4583c3be617bd9f7cde1bb.webp","width":89,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c22480","characterName":"君島 藍","sourceIds":{"bangumi":[{"characterId":"29642","match":"exact-normalized-name-in-linked-work","subjectId":"124972"}],"egsCharacterIds":["6371"],"vndbCharacterId":"c22480"},"originalCharacterName":"君島 藍","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aya’s elder twin sister, and the class mascot. While typically meek and docile, she’s actually very willful, and won’t budge once she’s set her mind on something."}],"source":"vndb","sourceCharacterId":"c22480"},{"segments":[{"spoiler":false,"text":"妹にべったりな、クラスのマスコットキャラ。"},{"spoiler":false,"text":"亜弥とは双子の姉妹で、自身は姉。どことなく猫っぽい性格で、クラスではマスコット的キャラクター。"},{"spoiler":false,"text":"妹の転入後、まるで仔猫を守る母猫の様に亜弥を構い続ける様になってしまいっている。"}],"source":"egs","sourceCharacterId":"6371","sourceWorkId":"21546","spoiler":false},{"segments":[{"spoiler":false,"text":"亜弥の双子の姉で、猫っぽい性格なクラスのマスコット。重度のシスコン（？）で、常に亜弥にべったり。"}],"source":"bangumi","sourceCharacterId":"29642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2abf5bf4c1623eb26416afc74b2af83874a20e45591eb27621fca3f6f4e4102f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b91e2faae70606420431c50194fc1fb34fc15719695e952189b13652ae524d14.webp","width":81,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安田奈緒子","creatorId":"vndb:s1036","sourcePersonId":"vndb:s1036","canonicalEntityId":"vndb:s1036","name":"安田 奈緒子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:176136:29642:17130:1","source":"bangumi"}]},{"characterId":"char_c22481","characterName":"三澤 渚","sourceIds":{"bangumi":[{"characterId":"29644","match":"exact-normalized-name-in-linked-work","subjectId":"124972"}],"egsCharacterIds":["6373"],"vndbCharacterId":"c22481"},"originalCharacterName":"三澤 渚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The star of the track and field team, who’s always surrounded by fans. She and Rina have been best friends since they were little, and they can often be spotted together."}],"source":"vndb","sourceCharacterId":"c22481"},{"segments":[{"spoiler":false,"text":"幼馴染みの事をいつも気に掛けている、陸上部の王子様"},{"spoiler":false,"text":"明るい褐色肌のスポーツ少女で、外国人の父と日本人の母のハーフ。莉菜とは幼馴染みの仲。"},{"spoiler":false,"text":"誤解され易い莉菜をついつい甘やかしてしまいがちで、結果振り回される事が多い。"}],"source":"egs","sourceCharacterId":"6373","sourceWorkId":"21546","spoiler":false},{"segments":[{"spoiler":false,"text":"外国人ハーフで陸上部のエース。幼馴染みの莉菜に振り回されるも、つい甘やかしてしまう。"}],"source":"bangumi","sourceCharacterId":"29644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2992e1363699db2032cdc8ea2656edf121ba5946692f8c47cb868046e14d9bc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/ter