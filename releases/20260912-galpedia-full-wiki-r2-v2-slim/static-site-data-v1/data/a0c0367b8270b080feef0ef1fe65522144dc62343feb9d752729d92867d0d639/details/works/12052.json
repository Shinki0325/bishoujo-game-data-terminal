o-confirmed","relationId":"egs:work-creator:135382","source":"egs"},{"creditedName":"カンナユリ","creatorId":"vndb:s9059","sourcePersonId":"egs:creator:4417","canonicalEntityId":"vndb:s9059","name":"カンナユリ","detail":"OP曲「BUBBLE POINT」、ED曲「飛行途中」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:75773","source":"egs"},{"creditedName":"癸乙夜","creatorId":"vndb:s2829","sourcePersonId":"egs:creator:12718","canonicalEntityId":"vndb:s2829","name":"癸乙夜","detail":"OPムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84529","source":"egs"},{"creditedName":"癸 乙夜","creatorId":"vndb:s2829","sourcePersonId":"vndb:s2829","canonicalEntityId":"vndb:s2829","name":"癸乙夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:28398","source":"vndb"},{"creditedName":"カンナユリ","creatorId":"vndb:s9059","sourcePersonId":"vndb:s9059","canonicalEntityId":"vndb:s9059","name":"カンナユリ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:28403","source":"vndb"}]},"cast":[{"characterId":"char_c53609","characterName":"アイシス＝ロレンバック","sourceIds":{"bangumi":[{"characterId":"130503","match":"exact-normalized-name-in-linked-work","subjectId":"219934"}],"egsCharacterIds":["15732"],"vndbCharacterId":"c53609"},"originalCharacterName":"アイシス＝ロレンバック","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"カゼリア王宮に仕える魔法騎士。"},{"spoiler":false,"text":"名門の血筋で伝統や名誉、忠義を重んじる。"},{"spoiler":false,"text":"厳格ではあるが、決して冷たい人間ではなく、部下や肉親を思いやる優しさを持った人物。"},{"spoiler":false,"text":"剣の腕前は王宮でもトップクラスであり、異例の若さながら、今回の捜索隊のリーダーを務める。"},{"spoiler":false,"text":"若さゆえか、直情的な部分や、融通の聞かない面も。"},{"spoiler":false,"text":"そのため、奔放かつ、尊大なクーリエとは衝突することが多い。"},{"spoiler":false,"text":"女性であることから、アイシスは騎士団に入団した直後から近衛としてアウレリア姫の警護を担当していた。"},{"spoiler":false,"text":"姫とは年齢が近く、共に民のことを第一に考えるという王侯貴族としての基本理念に忠実であることから、間をおかず親しい間柄となる。"}],"source":"egs","sourceCharacterId":"15732","sourceWorkId":"12052","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法王国カゼリアに仕える魔法騎士。"},{"spoiler":false,"text":"魔剣レーヴァティンを受け継ぐ名門の血筋で、伝統や名誉、忠義を重んじる。"},{"spoiler":false,"text":"厳格ではあるが、部下や肉親を思いやる優しさを持った人物。"},{"spoiler":false,"text":"剣の腕前は王宮でもトップクラスであり、今回の捜索隊では異例の若さでリーダーを務める。"},{"spoiler":false,"text":"若さゆえに直情的な部分や融通の聞かない面があり、奔放で尊大なクーリエとは衝突することが多い。"},{"spoiler":false,"text":"自身の苦痛や精神的な負荷に強い耐性を持つが、姫や仲間を思いやるあまり、その者たちに危害が及ぶ事柄には逆らうことができない。"}],"source":"bangumi","sourceCharacterId":"130503"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0103b5c630571e39a9ca7226d8e698d9284f4ad80985cee7c44f75d0525a68c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a21c96b27cffbb6bcd4735910926ab3a129c10491a8d05acbb8e713d500f7a29.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219934:130503:6019:1","source":"bangumi"}]},{"characterId":"char_c53610","characterName":"ナナイ","sourceIds":{"bangumi":[{"characterId":"130504","match":"exact-normalized-name-in-linked-work","subjectId":"219934"}],"egsCharacterIds":["15733"],"vndbCharacterId":"c53610"},"originalCharacterName":"ナナイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"カゼリア王国と同盟関係にある「神聖王国アマツ」の巫女にして神聖魔法使い。"},{"spoiler":false,"text":"丁寧な口調と穏やかな物腰とは裏腹に、強い意志と信仰心を持った女性。"},{"spoiler":false,"text":"周辺諸国に広がる宗教の総本山であり、宗教国家である神聖王国の名門一族出身であり、幼き頃より親元を離れ、神殿で巫女としての修行を行ってきた。"},{"spoiler":false,"text":"多くの妹弟子の面倒を見てきたナナイであるが、中でも異国から拾われてきたジュリアとは本当の姉妹のように過ごしていた。"}],"source":"egs","sourceCharacterId":"15733","sourceWorkId":"12052","spoiler":false},{"segments":[{"spoiler":false,"text":"カゼリア王国と同盟関係にある神聖王国の巫女にして、神聖魔法使い。"},{"spoiler":false,"text":"丁寧な口調や穏やかな物腰とは裏腹に、強い意志と信仰心を持った女性。"},{"spoiler":false,"text":"同じ神に仕えていたにも関わらず、意を違えて袂を分かった妹弟子のことをいつも案じており、彼女を見捨てた自分を今も責めている。"},{"spoiler":false,"text":"元より他人を疑うことを知らない性格で、幼い頃から叩き込まれた信仰心はその心に深く根ざしている。"},{"spoiler":false,"text":"常に周囲の見本となるようプレッシャーを自身にかけていたため、強迫観念に近い形で信仰こそが絶対であると思い込んでいる節もある。"},{"spoiler":false,"text":"一歩間違えば狂信へと繋がりかねない危険な心理状態だが、日常では至って敬虔な巫女に過ぎず、誰もそのことに気付かないでいた。"}],"source":"bangumi","sourceCharacterId":"130504"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eab0201263d745f4a851e70434d9b82ecaedc11c54aa6ebd6d1502bc9f02fa7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a4ec814c7145f45c7478e1c713a811acc68d870ecb774c113c465c51d6ee690.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219934:130504:4830:1","source":"bangumi"}]},{"characterId":"char_c53611","characterName":"クーリエ＝ノルン","sourceIds":{"bangumi":[{"characterId":"130505","match":"exact-normalized-name-in-linked-work","subjectId":"219934"}],"egsCharacterIds":["15734"],"vndbCharacterId":"c53611"},"originalCharacterName":"クーリエ＝ノルン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"カゼリア王国と友好関係にあるエルフの王国の戦士。"},{"spoiler":false,"text":"意志を持つ上級精霊と契約を結び、魔法、剣術両方に精通した一流の戦士。"},{"spoiler":false,"text":"老年の者が多く、また、老練であることが美徳とされるエルフ社会の中、クーリエは常に背伸びをして、年齢に不釣合いな言動をすることで大人たちに溶け込もうと努力をする。"},{"spoiler":false,"text":"しかし、当然子供のやる事であるため大人たちがそれを見抜けない訳は無く、いつも温かい目で見られるだけに終わった。"},{"spoiler":false,"text":"気位が高く、同盟関係にある人間を見下している。"},{"spoiler":false,"text":"精霊を操る能力に長けている。"}],"source":"egs","sourceCharacterId":"15734","sourceWorkId":"12052","spoiler":false},{"segments":[{"spoiler":false,"text":"カゼリア王国と友好関係にあるエルフの王国の戦士。"},{"spoiler":false,"text":"意志を持つ上級精霊と契約を結び、魔法・剣術両方に精通した一流の魔法剣士。"},{"spoiler":false,"text":"老年の者が多く、老練であることが美徳とされるエルフ社会の中で、常に背伸びをして年齢に不釣合いな言動をし、大人たちに溶け込もうと努力をしていた。"},{"spoiler":false,"text":"しかし○○のやることとして周囲からは温かい目で見られ、逆に幼いクーリエにとってはそのことが非常に疎ましかった。やがて自然と大人たちを避け、ひとりでいることが多くなっていた。"},{"spoiler":false,"text":"そのせいか気位が高く、同盟関係にある人間を見下している。"},{"spoiler":false,"text":"エルフは種族の純潔を重要視しており、近親相姦を行う習性が古くからある。クーリエもいずれは実の兄と結ばれる予定であり、本人"}],"source":"bangumi","sourceCharacterId":"130505"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42d5c39e650b2ce2ea5c87b1ef24a7c5fe49fb5339bbe2e68c50433d7c286039.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a211b486829ba7ef4d61eaef9a1f381b4c251238ba4627b63b3f9a6f80fdd46.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219934:130505:6379:1","source":"bangumi"}]},{"characterId":"char_c53612","characterName":"アウレリア＝サン＝カゼリア","sourceIds":{"bangumi":[{"characterId":"130506","match":"exact-normalized-name-in-linked-work","subjectId":"219934"}],"egsCharacterIds":["15735"],"vndbCharacterId":"c53612"},"originalCharacterName":"アウレリア＝サン＝カゼリア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヒロインたちの仕える国「カゼリア王国」の王女。"},{"spoiler":false,"text":"友好国であった「ディアスタン王国」へと嫁いだ矢先、消息不明に。"},{"spoiler":false,"text":"王室として、アウレリア自身が指揮を執り、貧民層への援助等の慈善事業をしたり、その慈悲溢れる行いは諸外国にまで知れ渡っており、国の内外、身分の高低を問わず人気が高い。"}],"source":"egs","sourceCharacterId":"15735","sourceWorkId":"12052","spoiler":false},{"segments":[{"spoiler":false,"text":"アイシスたちが仕えるカゼリア王国の王女。"},{"spoiler":false,"text":"友好国であったディアスタン王国へと嫁いだ矢先、消息不明に。"},{"spoiler":false,"text":"王室として、自身が指揮を執り貧民層へ援助等の慈善事業をするなど、その慈悲深い行いは諸外国にも知れ渡っており、国の内外、身分の高低を問わず人気が高い。"}],"source":"bangumi","sourceCharacterId":"130506"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e50bc3a933abe368f0b598c7296ebb882ddd46ce49b5a1afad10f36d1d70d14.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2b15fc5663b4a14616e1e784d56b17d42b98c6d4f7430a2b14b29fb9057c232.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"富山 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219934:130506:12717:1","source":"bangumi"}]},{"characterId":"char_c53613","characterName":"ジュリア","sourceIds":{"bangumi":[{"characterId":"130427","match":"exact-normalized-name-in-linked-work","subjectId":"219934"}],"egsCharacterIds":["15738"],"vndbCharacterId":"c53613"},"originalCharacterName":"ジュリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の腹心の部下。圧倒的な戦闘力を持っている。"},{"spoiler":false,"text":"もともとはナナイと同門の巫女だったが、仕えていた神に絶望し、神殿を破壊して逃走した。"},{"spoiler":false,"text":"現在は自らの意思に加え、主人公の狂気の影響を受け、ややサイコな感じに。"},{"spoiler":false,"text":"もともとナナイとは非情に仲の良い姉妹弟子であり、やや正気とは言えない今でも、深層ではナナイを愛している。"}],"source":"egs","sourceCharacterId":"15738","sourceWorkId":"12052","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・ミハエルの腹心の部下。"},{"spoiler":false,"text":"敵との戦いにおいて、“かすり傷ひとつ負った事がない” というほど圧倒的な戦闘力と魔法力を持っている。"},{"spoiler":false,"text":"現状ではディアスタンの将軍の中にも、彼女に匹敵する腕を持った者はレヴェントンとガヤルドくらいのものである。"},{"spoiler":false,"text":"負ける戦いはしない主義だが、彼女が負けるような相手はほとんどいない。"},{"spoiler":false,"text":"性格はサディスティックで弱いものイジメが大好き。"},{"spoiler":false,"text":"戦闘に関することは、自ら戦うことに加え集団の指揮にも長けており、主人公不在の折には魔物の軍勢の指揮を執っている。"},{"spoiler":false,"text":"好きな言葉は 「皆殺し」。"}],"source":"bangumi","sourceCharacterId":"130427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f2bffeb50e467538ceeca07329934fc78ca797c03eabe4f6f0867953a31bcac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8133446ecb57176527fe88c62478f1974c4d89fedce15ada0df554992d70405d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219934:130427:5905:1","source":"bangumi"}]},{"characterId":"char_c53614","characterName":"アルフレッド=ワイズマン","sourceIds":{"bangumi":[{"characterId":"130508","match":"exact-normalized-name-in-linked-work","subjectId":"219934"}],"egsCharacterIds":["15737"],"vndbCharacterId":"c53614"},"originalCharacterName":"アルフレッド=ワイズマン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アイシスたちが旅の道中で出会った若いカゼリア騎士。"},{"spoiler":false,"text":"辺境警備に当たっていたが、アイシスたちとともにディアスタン城に潜入する。"}],"source":"egs","sourceCharacterId":"15737","sourceWorkId":"12052","spoiler":false},{"segments":[{"spoiler":false,"text":"アイシスたちが旅の道中で出会った、若きカゼリア騎士。"},{"spoiler":false,"text":"辺境警備に当たっていたが、アイシスたちと共にディアスタン城に潜入する。"}],"source":"bangumi","sourceCharacterId":"130508"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88f6a468e7d17c615ef73b97ea591e5d7ed1fcbd5dd2df0119d6ecbc7f87b81d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97c52b281d54340ca9b0e0ee4947821df0d014bf55ada803e4400855d3ae1fd8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古河徹人","creatorId":"vndb:s299","sourcePersonId":"vndb:s299","canonicalEntityId":"vndb:s299","name":"古河 徹人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219934:130508:6265:1","source":"bangumi"}]},{"characterId":"char_c53615","characterName":"リルル","sourceIds":{"bangumi":[{"characterId":"130507","match":"exact-normalized-name-in-linked-work","subjectId":"219934"}],"egsCharacterIds":["15736"],"vndbCharacterId":"c53615"},"originalCharacterName":"リルル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クーリエと契約をしている水の上位精霊。普段はクーリエの腰の袋の中にいる。"},{"spoiler":false,"text":"もともと、精霊は空気中のいたるところに存在する元素と魔力の化合物の様なもので、本来、自我を持たず、術士に使役されるだけの存在なのだが、まれにリルルのような大型で、しかも意志を持った精霊が存在する。それが上級精霊である。"},{"spoiler":false,"text":"性格は明るく、よく喋る。契約を結んではいるが、クーリエとは付き合いが長く、主従と言うよりも友人。"},{"spoiler":false,"text":"明確な意思を持った精霊が周囲に居なかったため、クーリエは数少ない友人であり、クーリエのためならどんなことでもする覚悟でいる。"},{"spoiler":fal