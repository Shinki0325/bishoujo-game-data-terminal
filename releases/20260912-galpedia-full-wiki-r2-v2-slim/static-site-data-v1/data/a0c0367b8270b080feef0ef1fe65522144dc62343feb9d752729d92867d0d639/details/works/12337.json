{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12337","model":{"presentationWorkId":"vndb:v5526","staff":{"artwork":[{"creditedName":"海苔餅太","creatorId":"vndb:s4086","sourcePersonId":"egs:creator:2068","canonicalEntityId":"vndb:s4086","name":"海苔餅太","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:76844","source":"egs"}],"scenario":[{"creditedName":"嘘屋 佐々木酒人","creatorId":"vndb:s4095","sourcePersonId":"egs:creator:1134","canonicalEntityId":"vndb:s4095","name":"嘘屋 佐々木酒人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:76845","source":"egs"}],"music":[],"other":[{"creditedName":"嘘屋 佐々木 酒人","creatorId":"vndb:s4095","sourcePersonId":"vndb:s4095","canonicalEntityId":"vndb:s4095","name":"嘘屋 佐々木 酒人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58013","source":"vndb"}]},"cast":[{"characterId":"char_c82138","characterName":"源 苑","sourceIds":{"bangumi":[{"characterId":"143101","match":"exact-normalized-name-in-linked-work","subjectId":"279512"}],"egsCharacterIds":["15465"],"vndbCharacterId":"c82138"},"originalCharacterName":"源 苑","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a sporty girl who belongs to the synchronized swimming club. She is a cheerful, single-minded girl who does not think too deeply."},{"spoiler":false,"text":"She is a popular person with a cheerful personality and is called \"Osono\" by both men and women around her. She has a nice, toned body, which is due to her membership in the athletic club."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c82138"},{"segments":[{"spoiler":false,"text":"シンクロナイズド・スイミング部所属のスポ根娘。"},{"spoiler":false,"text":"単細胞のノーテンキ娘で、男女問わず周囲から「おソノ」と呼ばれている。"},{"spoiler":false,"text":"鍛えた体は均整のとれたナイスバディ。胸筋の発達により巨乳も見事なカタチ。"},{"spoiler":false,"text":"性格は一も二もなく淫乱。気持ちいい事が大好き。"},{"spoiler":false,"text":"主にに道具を挿入するオナニー歴が長く、男性経験はそんなに数を知らない。"},{"spoiler":false,"text":"そのせいか男性器をぞんざいに扱う悪い癖がある。"},{"spoiler":false,"text":"お気に入りのプレイは玩具を膣肛二本刺しにしたうえで、子宮の真上に電動マッサージ機を当て、それぞれいきなり最大出力で動かすこと。"},{"spoiler":false,"text":"ハードなプレイ慣れしていて、彼女は生身の男を見下す癖がある。"},{"spoiler":false,"text":"ついに主人公が生チンの魅力を教えてあげるときがきたようだ……"}],"source":"egs","sourceCharacterId":"15465","sourceWorkId":"12337","spoiler":false},{"segments":[{"spoiler":false,"text":"シンクロナイズド・スイミング部所属のスポ根娘。"},{"spoiler":false,"text":"明るい性格の人気者で、周囲からは男女問わずに「おソノ」と呼ばれている。"},{"spoiler":false,"text":"とにかく明るい単細胞娘で、深く考えることをはない。"},{"spoiler":false,"text":"さすが運動部なだけに体形は引き締まったナイスバディ。"},{"spoiler":false,"text":"とにかく彼女は淫乱。気持ちいいことが大好きだが、主に道具を挿入するオナニー歴が長く、それほど男性経験は豊富ではない。"}],"source":"bangumi","sourceCharacterId":"143101"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a0bd942136e01868699391bd223a3d37fe5cf2f3820d3430f7d83e466514296.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd0c1a384983aef798b74d34595d69ccbdb6b0ed0744b0704344f1007ee5080e.webp","width":118,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279512:143101:5669:1","source":"bangumi"}]},{"characterId":"char_c82139","characterName":"菊亭 なん乃","sourceIds":{"bangumi":[{"characterId":"143100","match":"exact-normalized-name-in-linked-work","subjectId":"279512"}],"egsCharacterIds":["15464"],"vndbCharacterId":"c82139"},"originalCharacterName":"菊亭 なん乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a young lady who belongs to the synchronized swimming club. She is a so-called \"Butterfly Lady\" and is as gorgeous as a swan swimming without showing her wading legs. As you can imagine from her very unusual surname \"Kikutei,\" she is a young lady of noble blood."},{"spoiler":false,"text":"She is a very neat and mature looking slender girl. She has a straight short bob or semi-long hair style and beautiful A-cup breasts."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c82139"},{"segments":[{"spoiler":false,"text":"シンクロナイズド・スイミング部所属の華麗なるお嬢さま。"},{"spoiler":false,"text":"公家の血を引く生粋のご令嬢。"},{"spoiler":false,"text":"Aカップの美乳を競泳水着に包み、清楚なイメージそのままに優雅に泳ぐ。"},{"spoiler":false,"text":"容姿と性格にギャップはなし。ただし、とてつもなく性欲が旺盛。ド淫乱。"},{"spoiler":false,"text":"当然非処女なのだが、エッチのときはいつも“モジモジ”恥じらう可憐さを見せる。"},{"spoiler":false,"text":"しかし、どんだけヤリまくっても全く“モジモジ”に変化なし。"},{"spoiler":false,"text":"際限なくぶっかけられ、際限なくイキまくる。"},{"spoiler":false,"text":"お気に入りのプレイはアナルセックスで、特に肛内射精がお好み。"},{"spoiler":false,"text":"「もうダメ、直腸がパンクしちゃう！」と言わされるぐらい肛内射精されるのが夢。"},{"spoiler":false,"text":"その夢がついに主人公によって叶えられるのか……"}],"source":"egs","sourceCharacterId":"15464","sourceWorkId":"12337","spoiler":false},{"segments":[{"spoiler":false,"text":"シンクロナイズド・スイミング部所属のお嬢さま。"},{"spoiler":false,"text":"とても珍しい名字「菊亭」から想像されるように、公家の血を引くお嬢さま。"},{"spoiler":false,"text":"掻く脚を見せずに泳ぐ白鳥のように華麗に活躍している。"},{"spoiler":false,"text":"清楚で大人しそうなスレンダースタイルでストレートのセミロング。Aカップの美乳。"},{"spoiler":false,"text":"正統派ヒロインっぽい容姿と清楚で優しい性格だが、その実彼女はとてつもない淫乱オンナ。"},{"spoiler":false,"text":"猫を被っているわけではなく、性欲が人並み外れて強いだけ。"}],"source":"bangumi","sourceCharacterId":"143100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/te