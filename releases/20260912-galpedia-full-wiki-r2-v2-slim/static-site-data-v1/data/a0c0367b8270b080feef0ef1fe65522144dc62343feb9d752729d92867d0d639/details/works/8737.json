oiler":false,"text":"主人公に対して丁寧な口調で話す。"},{"spoiler":false,"text":"エッチに関してはあまり知識がない為、"},{"spoiler":false,"text":"現状の性生活に不満を抱いている訳でもない。"},{"spoiler":false,"text":"ただ、夫に構ってもらえない寂しさは常々感じている。"}],"source":"egs","sourceCharacterId":"22680"},{"segments":[{"spoiler":false,"text":"花屋のバイトに来る人妻。"},{"spoiler":false,"text":"主人公の兄嫁である舞の先輩。"},{"spoiler":false,"text":"優しく母性的で、少し天然。押しに弱いところがある。"},{"spoiler":false,"text":"性格をあわらすように見た目もオットリしている。"},{"spoiler":false,"text":"花屋のバイトという点では主人公の方が先輩という事で、"},{"spoiler":false,"text":"主人公に対して丁寧な口調で話す。"},{"spoiler":false,"text":"エッチに関してはあまり知識がない為、"},{"spoiler":false,"text":"現状の性生活に不満を抱いている訳でもない。"},{"spoiler":false,"text":"ただ、夫に構ってもらえない寂しさは常々感じている。"}],"source":"egs","sourceCharacterId":"22680","sourceWorkId":"8737","spoiler":false},{"segments":[{"spoiler":false,"text":"舞の先輩で、バイトに来る人妻。"},{"spoiler":false,"text":"優しく母性的であるが少し天然的な面もある。押しに弱い性格。"},{"spoiler":false,"text":"性格をあわらすように見た目もオットリしている。"},{"spoiler":false,"text":"花屋のバイトという点では主人公の方が先輩という事で、主人公に対して丁寧な口調で話す。"},{"spoiler":false,"text":"エッチに関してはあまり知識がない為、現状の性生活に不満を抱いている訳でもない。"},{"spoiler":false,"text":"ただ、夫に構ってもらえない寂しさは常々感じている。"}],"source":"bangumi","sourceCharacterId":"59327"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"22680","sourceWorkId":"8737","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"22680","sourceWorkId":"8737","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"22680","sourceWorkId":"8737","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00b95f4ca48346524ef15dbb0394e90418b1bf080de07cfc8983d5f753724d61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4e7c98ae3bb93999fab441d6bee679091bea430655e1a9c9d168b427161a838.webp","wi