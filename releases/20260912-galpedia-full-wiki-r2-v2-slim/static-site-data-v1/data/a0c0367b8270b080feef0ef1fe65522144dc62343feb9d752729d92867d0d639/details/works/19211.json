},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作品のヒロイン。"},{"spoiler":false,"text":"主人公、達彦の姉で、進学校である篠宮学園の3年生。"},{"spoiler":false,"text":"幼い頃に母親が病気で他界しており、親子３人の父子家庭の中、唯一の女性として幼い頃から家事などをこなしてきた。"},{"spoiler":false,"text":"父親が海外に出張している現在は、主人公と自宅で2人暮らしをしている。"},{"spoiler":false,"text":"頭脳明晰、スポーツ万能、容姿端麗と3拍子そろった学園のアイドル的存在。"},{"spoiler":false,"text":"この春までは学園の生徒会長を務めており、引退した今も、その能力や人柄をこわれて生徒会に顔を出している。"},{"spoiler":false,"text":"現在は、かねてよりの希望であった水泳部に所属し、一部員としてその活動に励んでいる。"},{"spoiler":false,"text":"愛称は「姫」「姫センパイ」など。"},{"spoiler":false,"text":"裏表のない、爽やかで人当たりのいい性格。"},{"spoiler":false,"text":"努力家であり何事にも真剣に取り組むが、真面目すぎて融通がきかない一面もある。"},{"spoiler":false,"text":"学園では男女を問わず人気があり、毎日のように告白を受けている。"},{"spoiler":false,"text":"しかし学生の恋愛については否定的で、これをすべて丁重に断り続けている。"}],"source":"egs","sourceCharacterId":"1836","sourceWorkId":"19211","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・達彦の姉で、進学校である篠宮学園の3年生。"},{"spoiler":false,"text":"幼い頃に母親が病気で他界しており、父子家庭で唯一の女性として家事などをこなしてきた。"},{"spoiler":false,"text":"父親が海外に出張している現在は、主人公と自宅で二人暮らしをしている。"},{"spoiler":false,"text":"頭脳明晰、スポーツ万能、容姿端麗と三拍子揃った学園のアイドル的存在。"},{"spoiler":false,"text":"この春までは学園の生徒会長を務めており、今でも乞われて顔を出している。"},{"spoiler":false,"text":"現在はかねてよりの希望であった水泳部に所属し、一部員としてその活動に励んでいる。"},{"spoiler":false,"text":"裏表のない爽やかで人当たりの良い性格。"},{"spoiler":false,"text":"努力家であり何事にも真剣に取り組むが、まじめ過ぎて融通が利かない一面もある。学園では男女を問わず人気があり、毎日のように告白を受けている。"},{"spoiler":false,"text":"しかし学生の恋愛については否定的で、これをすべて丁重に断り続けている。"}],"source":"bangumi","sourceCharacterId":"43061"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"1836","sourceWorkId":"19211","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"1836","sourceWorkId":"19211","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"1836","sourceWorkId":"19211","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"1836","sourceWorkId":"19211","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/200147d1978b75063e6a36e73e40c6c227190a48818b7352ec0302e71b112a92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a24a1041f7a9f3d842ae503b893cb1b1614b19fc6019356523de0c8bd11d2ff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79501:43061:5075:1","source":"bangumi"}]},{"characterId":"char_c47654","characterName":"田上 星児","sourceIds":{"bangumi":[],"egsCharacterIds":["1837"],"vndbCharacterId":"c47654"},"originalCharacterName":"田上 星児","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公、達彦の幼なじみにして親友。"},{"spoiler":false,"text":"彼と同じ篠宮学園に通う１年生。"},{"spoiler":false,"text":"地元の大地主である資産家の家に生まれ、ひとり息子として甘やかされて育った。"},{"spoiler":false,"text":"金銭的には恵まれた生活を送ってきた反面、両親から愛情を注がれた経験は一切なく、家族の情というものに飢えている。"},{"spoiler":false,"text":"主人公や伊織とは自宅が近く、子供の頃にふとしたきかっけで知り合いとなり、以降は兄弟のような間柄となった。"},{"spoiler":false,"text":"悪ガキがそのまま大きくなったような、ヤンチャで感情的なタイプの青年。"},{"spoiler":false,"text":"我慢するということが苦手で、欲しいモノは手段を選ばず手に入れようとする、ワガママな一面がある。"},{"spoiler":false,"text":"真剣に恋愛をしたことは一度もないものの、セックスの経験は豊富。いわゆるヤリチン男。"},{"spoiler":false,"text":"彼にとっても伊織は姉のような存在であり、自分のことを両親以上に心配してくれる彼女に対して、歪んだ愛着を抱いている。"},{"spoiler":false,"text":"本人にもハッキリとした自覚はないものの、伊織をいずれ自分だけのモノにしたいと考えている。"},{"spoiler":false,"text":"趣味は身体を動かすことと、セックス。巨チンが自慢。"}],"source":"egs","sourceCharacterId":"1837","sourceWorkId":"19211","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9fe7145506b722a4bf053d863736be6daa2ae4fb916aa55405d8e3f1d05bb36.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a257fadb7e5debb408024ecee622f262df3d7480c94ee5aba5b547cd3d321523.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c47653","characterName":"姫川 達彦","sourceIds":{"vndbCharacterId":"c47653"},"originalCharacterName":"姫川 達彦","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3450","sourceCompanyId":"egs:brand:3994","canonicalEntityId":"vndb:p3450","name":"エロイット","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:19211:3994","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163666:v12819","source":"vndb"},{"companyId":"vndb:p3450","sourceCompanyId":"vndb:p3450","canonicalEntityId":"vndb:p3450","name":"エロイット","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:163667:v12819","source":"vndb"},{"companyId":"vndb:p3450","sourceCompanyId":"vndb:p3450","canonicalEntityId":"vndb:p3450","name":"エロイット","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:31893:v12819","so