-staff:10924","source":"vndb"},{"creditedName":"ののたん","creatorId":"vndb:s53149","sourcePersonId":"vndb:s53149","canonicalEntityId":"vndb:s53149","name":"ののたん","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:10926","source":"vndb"}]},"cast":[{"characterId":"char_c9899","characterName":"カトレア","sourceIds":{"bangumi":[{"characterId":"774","match":"exact-normalized-name-in-linked-work","subjectId":"471457"},{"characterId":"774","match":"exact-normalized-name-in-linked-work","subjectId":"846"}],"egsCharacterIds":["23141"],"vndbCharacterId":"c9899"},"originalCharacterName":"カトレア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"curio３号店のチーフウェイトレス。"},{"spoiler":false,"text":"ハッキリしたタイプの美人で、外面もよく、お客様の人気も高い。"},{"spoiler":false,"text":"主人公の店に対して敵愾心を燃やし、何かと突っかかってくる。"},{"spoiler":false,"text":"自分にも他人にも厳しい完璧主義者。"},{"spoiler":false,"text":"ライバルのはずのファミーユを目の仇にしながらも、"},{"spoiler":false,"text":"理にかなった的確なアドバイスを残していったりする。"},{"spoiler":false,"text":"あだ名はカトレア（本人は嫌っている）"},{"spoiler":false,"text":"金髪（染めているのでなく天然）、黒の尖った感じのリボン、ツインテール、吊り目。"},{"spoiler":false,"text":"胸はやや小さめのＢカップ。"}],"source":"egs","sourceCharacterId":"23141","sourceWorkId":"30366","spoiler":false},{"segments":[{"spoiler":false,"text":"开业前的半个小时，高村仁碰上了这辈子的魔星、对头、和冤家。这两个人似乎天生合不来，从头到脚，从说话的语气到穿着的服饰……。而更糟糕的是，这两个人不但是门对门的相同类型的咖啡馆的领导者，还是住在相邻隔壁的邻居，似乎战争已经无法避免了。但是玲爱的行为却很奇怪，一顿痛骂之后总会有些温柔的提示 ——当然语气并不温柔——也许还是个温柔的孩子。不过，坦白地说出自己想法对于花鸟玲爱来说可是绝·对·不·行·的，和高村仁是如此，和姐姐也是如此。在工作闲暇的时候，总是向famille那里张望，她到底在寻找什么呢？"}],"source":"bangumi","sourceCharacterId":"774"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c25d99f72e75c8a403c619116d2ea780be90b8e7d5d946ca227abbc06543555e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f92d0f67cc176f359f0bf39873326ef0ec7852f35a7d62d46365fe8f9f4fde7.webp","width":176,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松永 雪希","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4835","source":"vndb"}]},{"characterId":"char_vndb_c10297","characterName":"当真 未亜","sourceIds":{"vndbCharacterId":"c10297"},"originalCharacterName":"当真 未亜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc1e0e7f6034ed5270191fb8f9125d0895519a0b95eac5e24307b12b53a6af0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5461131e64f23a52622b541b3b44fde167f502b709ee5628bc4c1524081186e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"歌織","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"富山 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4849","source":"vndb"}]},{"char