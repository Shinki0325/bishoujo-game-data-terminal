long time ago."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c9952"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58cf5d53f0e35eba53ff3fd257b25c79d2dd93ba378fa9fac45f6d8062c8a185.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e0b20d8869f8e5ac01bf97d32fac37b1506f0bee7cb82ddbbe24e1054ef2b71.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川 乃奈","creatorId":"vndb:s799","sourcePersonId":"vndb:s799","canonicalEntityId":"vndb:s799","name":"森沢 芙美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4845","source":"vndb"}]},{"characterId":"char_vndb_c9954","characterName":"浅倉 奈緒子","sourceIds":{"vndbCharacterId":"c9954"},"originalCharacterName":"浅倉 奈緒子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"318"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student who gets high grades. She is the student council president at Takamizuka High School. She seems to be an excellent and friendly person when she is with teachers and students, but it's all put on. She enjoys teasing the boarders of Tsugumi dorm. She is like a big sister and she is more reliable than Saeri."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c9954"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78b6930fc6d48fc9aa33c88128b132578e2e48083797deecbec7c9942410d66e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97bc4c6e0d6cea1d49b504eff27effebcf56abe801565f4a36ddab639f463df0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篠崎 双葉","creatorId":"vndb:s752","sourcePersonId":"vndb:s752","canonicalEntityId":"vndb:s752","name":"篠崎双葉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4846","source":"vndb"}]},{"characterId":"char_vndb_c9955","characterName":"六条 宮穂","sourceIds":{"vndbCharacterId":"c9955"},"originalCharacterName":"六条 宮穂","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"731"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A freshman who is a granddaughter of previous chairman of the board of directors of Takamizuka High School and owner the Tsugumi dorm; Miyaho is the acting chairman and the owner of it temporarily. She is a girl brought up with tender care in the Rokujou family that is the founder of Demizugawa Heavy Industry, but her fate was changed after she met Wataru at Tsugumi Dorm on last New Year's Day. She is clumsy at everything she does. Has a habit of counting her steps on the stairway to their dormitory as seen in Rinna's Arc."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c9955"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/024d75413dd05750da6c647db43e35156deb32e00feb9581e4d127d482703a42.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1d8d6b67de023f37876fb59145e336520cf178d4e4e6a739f921a0b15330534.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4838","source":"vndb"}]},{"characterId":"char_vndb_c9956","characterName":"藤村 静","sourceIds":{"vndbCharacterId":"c9956"},"originalCharacterName":"藤村 静","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"221"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"},"weight":{"reviewState":"source-only","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new student who is bashful in front of strangers. Her parents left her and she seldom showed her feelings when Wataru met her at first; Saeri stood for her and she began to live on the Tsugumi dorm, and she gradually shows her feeling. She is quiet and small, but she is a good athlete."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c9956"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b29afde96e5e5cb8316620305f8577154282880cd6395977e9b4c36fc189de54.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae6f38515e6f524c34dab6f7eea8945a7614fe448352ff4bcf82e7a604f7084.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4831","source":"vndb"}]},{"characterId":"char_vndb_c9957","characterName":"桐島 沙衣里","sourceIds":{"vndbCharacterId":"c9957"},"originalCharacterName":"桐島 沙衣里","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"908"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Japanese language teacher, the homeroom teacher of the class 2-A, the dormitory manager of the Tsugumi dorm and the adviser of the student council. She is called Sae-chan by her students. She has a sense of rivalry for Naoko because she is more reliable than her."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c9957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/171ce741e24b0c50231d214fba879441fb5e5d27c95c39511fe1e2a04e83da72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f1983072af74ffd71508b4e65a472b4ed4bfba1bc673574f5f7c56754747cc8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紫苑 みやび","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4839","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p119","sourceCompanyId":"egs:brand:84","canonicalEntityId":"vndb:p119","name":"戯画","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10460:84","source":"egs"},{"companyId":"vndb:p119","sourceCompanyId":"vndb:p119","canonicalEntityId":"vndb:p119","name":"戯画","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:1230:v479","source":"vndb"},{"companyId":"vndb:p990","sourceCompanyId":"vndb:p990","canonicalEntityId":"vndb:p990","name":"Team Baldrhead","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:1231:v479","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
