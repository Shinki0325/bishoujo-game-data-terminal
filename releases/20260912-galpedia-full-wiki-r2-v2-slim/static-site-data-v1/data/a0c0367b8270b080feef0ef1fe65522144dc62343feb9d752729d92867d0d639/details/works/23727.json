},"cast":[{"characterId":"char_c48061","characterName":"小森江 七瑠","sourceIds":{"bangumi":[{"characterId":"45040","match":"exact-normalized-name-in-linked-work","subjectId":"183145"}],"egsCharacterIds":["11770"],"vndbCharacterId":"c48061"},"originalCharacterName":"小森江 七瑠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1016"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sousuke's \"current\" younger (step)sister whom he's been with since childhood."},{"spoiler":false,"text":"Nanaru is in her first year in high school. She's cheerful, but innocent too, and she's a free-wheeler. She's pretty silly and weird at times, which you could probably guess from a girl who considers her raison d'etere to be cracking jokes. The vast majority of her brain storage space is used up on jokes and puns."},{"spoiler":false,"text":"She has a fondness for teasing, which amplifies tenfold when her brother is the target. But that's not to say she doesn't also love having him dote on her."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c48061"},{"segments":[{"spoiler":false,"text":"学園１年生。楽しい事や面白い事が大好きな天真爛漫タイプ。"},{"spoiler":false,"text":"ボケとツッコミが脳内の大半を占めるぶっ飛んだ性格をしており、ギャグに生きている。"},{"spoiler":false,"text":"人をからかうのが好きで、兄に対しては特に激しいがそんな一方で甘え上手な面もある。"}],"source":"egs","sourceCharacterId":"11770","sourceWorkId":"23727","spoiler":false},{"segments":[{"spoiler":false,"text":"学園1年生。 面白いことが大好きな天真爛漫タイプ。"},{"spoiler":false,"text":"ボケとツッコミが脳内の大半を占めるぶっ飛んだ性格で、ギャグに生きている。"},{"spoiler":false,"text":"人をからかうのが好きで、兄に対しては特に激しいが、一方で甘え上手な面も。"},{"spoiler":false,"text":"「女子に恥かかしちゃ駄目でしょ？　……さきっちょだけ、入れておいでよ！」"}],"source":"bangumi","sourceCharacterId":"45040"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"11770","sourceWorkId":"23727","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"11770","sourceWorkId":"23727","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"11770","sourceWorkId":"23727","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"11770","sourceWorkId":"23727","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3facd4aa691487a72e07c7fde75482f9640988bb509e69e19b3067ccdb068ebd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da5c93e5e67a3792b13bf0c85e536d7f707d2abee94573754bb4b1baadce7a3a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水愛","creatorId":"vndb:s416","sourcePersonId":"vndb:s416","canonicalEntityId":"vndb:s416","name":"清水 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183145:45040:4064:1","source":"bangumi"}]},{"characterId":"char_c48062","characterName":"小森江 すず","sourceIds":{"bangumi":[{"characterId":"45041","match":"exact-normalized-name-in-linked-work","subjectId":"183145"}],"egsCharacterIds":["11771"],"vndbCharacterId":"c48062"},"originalCharacterName":"小森江 すず","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"201"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sousuke's \"former\" younger (real) sister who he grew up with during his early childhood days."},{"spoiler":false,"text":"Suzu is in her first year, just like Nanaru, and even winds up in her class when she transfers. She's a very devoted sister, who's never stopped loving her brother even after they were seperated during early childhood. She's very docile (much unlike Nanaru), as well as gentle and affectionate. She can be a little bit of an airhead, but she's a great sister, both in terms of looks and brains."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c48062"},{"segments":[{"spoiler":false,"text":"学園１年生で、七瑠と同じクラスに編入する。"},{"spoiler":false,"text":"幼少期に離れ離れになって以降も、ずっと兄のことを慕っていた一途な妹。"},{"spoiler":false,"text":"七瑠とは反対に、大人しい性格で温かい雰囲気を持っている。"},{"spoiler":false,"text":"天然な面があるものの、基本的にはスペックの高い妹。"}],"source":"egs","sourceCharacterId":"11771","sourceWorkId":"23727","spoiler":false},{"segments":[{"spoiler":false,"text":"学園1年生で、七瑠と同じクラスに編入する。"},{"spoiler":false,"text":"幼少期に離れ離れになって以降もずっと兄のことを慕っていた一途な妹。"},{"spoiler":false,"text":"七瑠とは対照的におとなしく、温かい雰囲気を持っている。"},{"spoiler":false,"text":"天然な面があるものの、基本的にはスペックの高い妹。"},{"spoiler":false,"text":"「やっと…… やっと会えたね、兄さん」"}],"source":"bangumi","sourceCharacterId":"45041"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11771","sourceWorkId":"23727","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"11771","sourceWorkId":"23727","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCha