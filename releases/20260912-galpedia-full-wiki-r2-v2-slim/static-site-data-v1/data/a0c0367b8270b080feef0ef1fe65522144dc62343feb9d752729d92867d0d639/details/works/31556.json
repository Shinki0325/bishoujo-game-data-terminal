eLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:173659","source":"vndb"}]},"cast":[{"characterId":"char_c96448","characterName":"アエット","sourceIds":{"bangumi":[{"characterId":"92974","match":"exact-normalized-name-in-linked-work","subjectId":"331474"}],"egsCharacterIds":["23342"],"vndbCharacterId":"c96448"},"originalCharacterName":"アエット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The older of the Okayu sisters."},{"spoiler":false,"text":"She lacks self-confidence and is bad at expressing herself. When not in cosplay, she finds communicating with others difficult."},{"spoiler":false,"text":"However, when with family members or someone who she feels she can let her guard down around, her motherly, caring nature is revealed."},{"spoiler":false,"text":"What's more, she has a strong sex drive, and is a closet pervert. That plus her caring personality makes her desire to sexually service others quite powerful."},{"spoiler":false,"text":"Cosplaying under the pseudonym \"Aeto\", she is well known for cosplaying male characters in tandem with her sister Riru. Although nobody knows her true appearance, her name is famous in cosplaying circles."},{"spoiler":false,"text":"She is a firm believer in cosplaying the entire character, not just their appearance, and so takes great pains to mimic the personality of the characters she cosplays as."},{"spoiler":false,"text":"She cosplays as the character \"Sera\" from the erotic, isekai, harem, fantasy manga the protagonist publishes, \"Torotoro Evoking\"."}],"source":"vndb","sourceCharacterId":"c96448"},{"segments":[{"spoiler":false,"text":"小粥姉妹の姉。"},{"spoiler":false,"text":"自分に自信がなく自己表現が苦手であり、素顔のままで他人とコミュニケーションを取るのが苦手な女の子。"},{"spoiler":false,"text":"ただし、家族や気を許せる相手などには、本来の世話焼き気質で母性的な一面を見せてくれる。"},{"spoiler":false,"text":"なお、性欲はとても強く、実はむっつりドスケベ。生来の気質も相まって、ご奉仕願望が強い。"},{"spoiler":false,"text":"「アエット」という名義でコスプレ活動をしており、妹の莉瑠とセットで姉妹男装レイヤーとして認知されている。"},{"spoiler":false,"text":"素顔は隠しているが、レイヤー界隈では名を知られている。"},{"spoiler":false,"text":"コスプレは完コス派で、衣装だけではなく、内面までなりきろうとするタイプ。"},{"spoiler":false,"text":"主人公がこっそりネット上で公開している異世界ファンタジーエロ漫画『とろとろ★エヴォーキング』の「セーラ」というヒロインのコスプレを行う。"}],"source":"egs","sourceCharacterId":"23342","sourceWorkId":"30818","spoiler":false},{"segments":[{"spoiler":false,"text":"小粥姉妹の姉。"},{"spoiler":false,"text":"自分に自信がなく自己表現が苦手であり、素顔のままで他人とコミュニケーションを取るのが苦手な女の子。"},{"spoiler":false,"text":"ただし、家族や気を許せる相手などには、本来の世話焼き気質で母性的な一面を見せてくれる。"},{"spoiler":false,"text":"なお、性欲はとても強く、実はむっつりドスケベ。生来の気質も相まって、ご奉仕願望が強い。"},{"spoiler":false,"text":"「アエット」という名義でコスプレ活動をしており、妹の莉瑠とセットで姉妹男装レイヤーとして認知されている。"},{"spoiler":false,"text":"素顔は隠しているが、レイヤー界隈では名を知られている。"},{"spoiler":false,"text":"コスプレは完コス派で、衣装だけではなく、内面までなりきろうとするタイプ。"},{"spoiler":false,"text":"主人公がこっそりネット上で公開している異世界ファンタジーエロ漫画『とろとろ★エヴォーキング』の「セーラ」というヒロインのコスプレを行う。"}],"source":"bangumi","sourceCharacterId":"92974"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e76b848c4b1be69e2f571b7a130ae2c828d1c23b874b06982d5f6d825643a502.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c465d26099653beddfed9f4d73dfadd6f5d05939039e7499dbfe8128e26bcd44.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田紗記子","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331474:92974:17079:1","source":"bangumi"}]},{"characterId":"char_c96449","characterName":"リエット","sourceIds":{"bangumi":[{"characterId":"92975","match":"exact-normalized-name-in-linked-work","subjectId":"331474"}],"egsCharacterIds":["23343"],"vndbCharacterId":"c96449"},"originalCha