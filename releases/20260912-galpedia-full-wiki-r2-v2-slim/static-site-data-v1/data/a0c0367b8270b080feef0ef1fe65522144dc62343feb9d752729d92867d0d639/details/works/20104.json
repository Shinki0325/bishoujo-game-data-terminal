413","source":"vndb"},{"creditedName":"田口 亮","creatorId":"vndb:s42296","sourcePersonId":"vndb:s42296","canonicalEntityId":"vndb:s42296","name":"田口 亮","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:28415","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c21866","characterName":"元宮 あかね","sourceIds":{"vndbCharacterId":"c21866"},"originalCharacterName":"元宮 あかね","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"15 or 16 years old."},{"spoiler":false,"text":"The main character, she is a cheerful, forthright high school freshman. This character's default name is Akane, but the player can pick other names for her. Akane is summoned into the world of Kyou and becomes the Ryuujin no Miko, (Priestess of the Dragon God). She is the only person capable of communicating with the Ryuujin, and with the help of the Hachiyou, she can use the powers of the five elements to defeat the onryou that the Oni Clan has unleashed throughout Kyou."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c21866"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bdcd8b2be075f4080ff9d0dc5dac89a68722166b1f9fef81d8063ed0850de3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff1c1575852619d06cd36449a24411868972be18b8f1d157630004abba2d1dfa.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川上 とも子","creatorId":"vndb:s477","sourcePersonId":"vndb:s477","canonicalEntityId":"vndb:s477","name":"川上 とも子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14889","source":"vndb"}]},{"characterId":"char_vndb_c21951","characterName":"源 頼久","sourceIds":{"vndbCharacterId":"c21951"},"originalCharacterName":"源 頼久","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1009"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Hachiyou, he is the Seiryuu of Heaven. Yorihisa is a samurai in the service of the Imperial court. Serious and disciplined, he swears fealty to Akane as his master, and he always obeys Akane's commands. His elemental attribute is Wind, and his dragon jewel is located on his left ear."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c21951"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca83ec4a8d377b8ea3b69a33d6a5c7a3ab0811bf527af4753ce43fe8ffce6941.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f4fc4538dfcf6758b782ea435aa72bf9bca4310e297d76e1e649571fad4d47b.webp","width":256,"height":239,"source":"static-detail"},"actors":[{"creditedName":"三木 眞一郎","creatorId":"vndb:s252","sourcePersonId":"vndb:s252","canonicalEntityId":"vndb:s252","name":"三木 眞一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14886","source":"vndb"}]},{"characterId":"char_vndb_c25790","characterName":"森村 天真","sourceIds":{"vndbCharacterId":"c25790"},"originalCharacterName":"森村 天真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"402"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Hachiyou, he is the Seiryuu of Earth. Tenma is Akane's classmate and friend, who is pulled into Kyou with her. He has little concern for formality and can be abrasive, but he has a strong sense of responsibility to others. Tenma's younger sister has been missing for some time. His elemental attribute is Thunder, and his dragon jewel is located on his left arm."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c8ec6e8000fe5fda5d0ff14ddb575048c98d8fe508dfdff11dbfdb08a4774d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/673c8b5dcf15d83da72fe98813db66e1ab5459d8740a87707339f7420266da8f.webp","width":256,"height":239,"source":"static-detail"},"actors":[{"creditedName":"関 智一","creatorId":"vndb:s249","sourcePersonId":"vndb:s249","canonicalEntityId":"vndb:s249","name":"関智一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14885","source":"vndb"}]},{"characterId":"char_vndb_c25792","characterName":"イノリ","sourceIds":{"vndbCharacterId":"c25792"},"originalCharacterName":"イノリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"818"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Hachiyou, he is the Suzaku of Heaven. Inori is a blacksmith's apprentice. He has a fierce hatred of Oni. Though he can be hot-headed, Inori has an open, honest personality, and he values his family. His elemental attribute is Fire, and his dragon jewel is located on his forehead."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25792"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bc00ca9c1a42f692942891f9b89407c6b5135b367fa41e405854650343f60da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f388b55d62d75ac7e0f2e361448da3dfc222658fc4e86b2be7eb18a8949dc271.webp","width":256,"height":243,"source":"static-detail"},"actors":[{"creditedName":"高橋 直純","creatorId":"vndb:s69","sourcePersonId":"vndb:s69","canonicalEntityId":"vndb:s69","name":"高橋 直純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14881","source":"vndb"}]},{"characterId":"char_vndb_c25794","characterName":"流山 詩紋","sourceIds":{"vndbCharacterId":"c25794"},"originalCharacterName":"流山 詩紋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"225"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Hachiyou, he is the Suzaku of Earth. Shimon is a junior high student and a friend of Akane who also is pulled into Kyou. The Oni Clan is said to have blond hair and blue eyes, and because Shimon has a similar appearance, the people of Kyou often mistake him for an Oni. His elemental attribute is Earth, and his dragon jewel is located on the back of his right hand."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25794"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/955355b3996e8f93e97ac9a598884a76b90df93abdd4a8edc27a4c62b0bce33c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dce7325b553bf0946b1c5b0b735d8bd5573d727d13e23f08c666d7799b5c09f3.webp","width":256,"height":240,"source":"static-detail"},"actors":[{"creditedName":"宮田 幸季","creatorId":"vndb:s387","sourcePersonId":"vndb:s387","canonicalEntityId":"vndb:s387","name":"宮田 幸季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14888","source":"vndb"}]},{"characterId":"char_vndb_c25795","characterName":"藤原 鷹通","sourceIds":{"vndbCharacterId":"c25795"},"originalCharacterName":"藤原 鷹通","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1222"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Hachiyou, he is the Byakko of Heaven. Takamichi is a nobleman, and he works in the government as the Vice Minister of Civil Affairs. He has a serious but calm personality, and a strong sense of justice. His elemental attribute is Heaven, and his dragon jewel is located on the right side of his neck."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25795"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96da1d6cb9fe370503e20d7500297f90461b304ee4c5871a420965015e8f1672.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37beba75ad83ec5329d64f1146e36f55c40f5a9b7fc6fae1dd63dbf5d7358d4b.webp","width":256,"height":244,"source":"static-detail"},"actors":[{"creditedName":"中原 茂","creatorId":"vndb:s754","sourcePersonId":"vndb:s754","canonicalEntityId":"vndb:s754","name":"中原 茂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14891","source":"vndb"}]},{"characterId":"char_vndb_c25796","characterName":"橘 友雅","sourceIds":{"vndbCharacterId":"c25796"},"originalCharacterName":"橘 友雅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"31"},"birthday":{"reviewState":"source-only","source":"vndb","value":"611"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Hachiyou, he is the Byakko of Earth. Like Takamichi, Tomomasa is a nobleman, employed as a Lieutenant of the Left Imperial Guard. He is aloof and easy-going, and though he hides it much of the time, he is a good judge of character. His elemental attribute is Swamp, and his dragon jewel is located between his collar bones."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25796"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcfc8a5c03063d1ed3bea066314ff23c6414a4c1e65cb997a18a83a1cf5baeec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3d7d991357402b28becc6ac4ca280158de89be59f781cf1c22977323acb7782.webp","width":256,"height":241,"source":"static-detail"},"actors":[{"creditedName":"井上 和彦","creatorId":"vndb:s374","sourcePersonId":"vndb:s374","canonicalEntityId":"vndb:s374","name":"井上 和彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14887","source":"vndb"}]},{"characterId":"char_vndb_c25797","characterName":"永泉","sourceIds":{"vndbCharacterId":"c25797"},"originalCharacterName":"永泉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"birthday":{"reviewState":"source-only","source":"vndb","value":"706"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Hachiyou, he is the Genbu of Heaven. Eisen is the Emperor's half-brother who has left the Imperial Family and become a monk. He is a refined youth who hates conflict. He plays the flute skillfully. His elemental attribute is Water, and his dragon jewel is located in the palm of his left hand."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25797"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04ea219fcb3f6d0916c9a1d58f784040d5f7b891a9e6e235d873d5b1a7607ab3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0c3240e65f44546274a1a112d6584ca63f6395dcf18d436ff77490338d472a3.webp","width":256,"height":240,"source":"static-detail"},"actors":[{"creditedName":"保志 総一朗","creatorId":"vndb:s114","sourcePersonId":"vndb:s114","canonicalEntityId":"vndb:s114","name":"保志 総一朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14884","source":"vndb"}]},{"characterId":"char_vndb_c25798","characterName":"安倍 泰明","sourceIds":{"vndbCharacterId":"c25798"},"originalCharacterName":"安倍 泰明","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"924"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Actually only 4 years old."},{"spoiler":false,"text":"One of the Hachiyou, he is the Genbu of Earth. Yasuaki is an Onmyouji, and a disciple to the famous, historical Onmyouji Abe no Seimei. He is cold and analytical."},{"spoiler":true,"text":"Because he is an artificial human created by Abe no Seimei, Yasuaki lacks human emotions."},{"spoiler":false,"text":"His elemental attribute is Mountain, and his dragon jewel is located beneath his right eye."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25798"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d87955744a935eecef5e2f48895a67fdfc4e4eb5c83a9936a257d30e51860f37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7ceb32593644ddbd3c9c8f9dbc833260258048d4289763b292b1ad93b9633aa.webp","width":256,"height":239,"source":"static-detail"},"actors":[{"creditedName":"石田 彰","creatorId":"vndb:s74","sourcePersonId":"vndb:s74","canonicalEntityId":"vndb:s74","name":"石田 彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14882","source":"vndb"}]},{"characterId":"char_vndb_c26558","characterName":"アクラム","sourceIds":{"vndbCharacterId":"c26558"},"originalCharacterName":"アクラム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1204"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"-In Harukanaru 1-"},{"spoiler":false,"