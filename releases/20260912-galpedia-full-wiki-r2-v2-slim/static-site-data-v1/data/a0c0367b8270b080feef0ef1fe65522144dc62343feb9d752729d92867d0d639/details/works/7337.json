{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7337","model":{"presentationWorkId":"egs:7337","staff":{"artwork":[{"creditedName":"浅黄りお","creatorId":"vndb:s3306","sourcePersonId":"egs:creator:5365","canonicalEntityId":"vndb:s3306","name":"浅黄りお","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:50857","source":"egs"}],"scenario":[{"creditedName":"二渡項","creatorId":"egs:creator:15349","sourcePersonId":"egs:creator:15349","canonicalEntityId":"egs:creator:15349","name":"二渡項","roleCode":"scenario","roleLabel":"剧本","identityStatus":"alias-only-review","relationId":"egs:work-creator:92599","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_egs_25423","characterName":"藍川 香緒里","sourceIds":{"egsCharacterIds":["25423"]},"originalCharacterName":"藍川 香緒里","characterNameSource":null,"role":"1","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"和也と\"カップル\"を組む、本編のヒロイン。"},{"spoiler":false,"text":"実家はかなりの資産家でお嬢様なのだが、現在は訳あってアパートに1人暮らし中。"},{"spoiler":false,"text":"頭脳明晰で容姿端麗、"},{"spoiler":false,"text":"おまけに明朗快活のいわゆる完璧超人タイプだが、実はかなりの天然ボケ。"},{"spoiler":false,"text":"保健体育の授業が苦手だったために性に関する知識に乏しく、当然処女。"},{"spoiler":false,"text":"今でも「赤ちゃんはコウノトリが連れてくるんでしょ？」と本気で思っている。"},{"spoiler":false,"text":"無類の焼肉定食好きで、特に行きつけの定食屋特注メニューの「牛タン焼肉定食」がお気に入り。"},{"spoiler":false,"text":"女の子にしては背が高く、胸も大きめ。"},{"spoiler":false,"text":"間が持たなくなると「あ、あはは…」と照れ笑いする癖アリ。"}],"source":"egs","sourceCharacterId":"25423","sourceWorkId":"7337","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/ch