{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"1662","model":{"presentationWorkId":"vndb:v7407","staff":{"artwork":[{"creditedName":"愛媛 みかん","creatorId":"vndb:s7876","sourcePersonId":"vndb:s7876","canonicalEntityId":"vndb:s7876","name":"彩珠子(小娘、愛媛みかん、愛姫みかん、江端里沙)","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:70679","source":"vndb"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c6588","characterName":"本条寺　あきら","sourceIds":{"vndbCharacterId":"c6588"},"originalCharacterName":"本条寺　あきら","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1009"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akira, Anne Mitter's charismatic red-headed waitress, is the heroine of the Rise series. Strong-willed, compassionate and an expert of martial arts - third grade mastery in judo and fourth grade mastery in both karate and aikido - Akira doesn't take well to insincerity, injustice, or imprisonment."}],"source":"vndb","sourceCharacterId":"c6588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/539f50393f786bf1ba070e334613dd76623cd72ae0eada9cd244c4ceb727a3b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99cb34b533c146b069a661844e9654a91d7043b6faa6de2685fdad29acbc4479.webp","width":160,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c6589","characterName":"かりん","sourceIds":{"vndbCharacterId":"c6589"},"origina