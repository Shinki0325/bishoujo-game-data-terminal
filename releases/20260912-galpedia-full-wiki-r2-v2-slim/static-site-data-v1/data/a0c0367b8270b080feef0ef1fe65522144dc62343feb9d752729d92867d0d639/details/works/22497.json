eContext":null,"source":"egs","sourceCharacterId":"7887","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"7887","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"7887","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"7887","sourceWorkId":"22497","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53d0e86fe56f27c96be30fb6aa44cf059f1eed21fe0a77bdaa740cd9c3c4724e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b2c634c41de22e0b13f425a0bd6cbcfb03c500d11dbfbc407b8438f65e1f8f9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"もものはるな","creatorId":"vndb:s3480","sourcePersonId":"vndb:s3480","canonicalEntityId":"vndb:s3480","name":"てんぐまい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155751:38607:15645:1","source":"bangumi"}]},{"characterId":"char_c40165","characterName":"Hasekura Yuiri (支倉 唯梨)","sourceIds":{"bangumi":[{"characterId":"38608","match":"exact-normalized-name-in-linked-work","subjectId":"155751"}],"egsCharacterIds":["7888"],"vndbCharacterId":"c40165"},"originalCharacterName":"Hasekura Yuiri (支倉 唯梨)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year in the school who's in the same class as Mayuri. She looks up to Souji who's very reliable, and fondly calls him \"onii-san\". She is also an old acquaintance because she was Mayuri's friend when they lived in another city in the past."},{"spoiler":false,"text":"Her father has remarried and she has a new family. She strongly looks up to her older step sister Saki who is great at all sports, has great grades and is the club president of the tennis club. She always follows her sister while going all \"onee-chan, onee-chan\", putting her older sister off a little."},{"spoiler":false,"text":"However, Yuiri acts very shy towards everyone except for her older sister, and wants to become more assertive... ending up going a little berserk, then happens to immediately be at her wits' end."}],"source":"vndb","sourceCharacterId":"c40165"},{"segments":[{"spoiler":false,"text":"学園の１年生で、主人公の妹と同級生。"},{"spoiler":false,"text":"頼りになる主人公に憧れの気持ちを抱いており、親しみを込めて「お兄さん」と呼ぶ。"},{"spoiler":false,"text":"父の連れ子。"},{"spoiler":false,"text":"スポーツ万能で成績優秀、クラス委員長とテニス部の部長を務める姉の咲希を強烈に慕っている。"},{"spoiler":false,"text":"義姉が引き気味なのも何のその。「お姉ちゃんお姉ちゃんっ」とまとわりつく。"},{"spoiler":false,"text":"しかし、咲希以外には引っ込み思案。"},{"spoiler":false,"text":"なんとか積極的になろうと、彼女なりに努力するものの、やや暴走気味に。"},{"spoiler":false,"text":"わりとすぐにテンパる。"}],"source":"egs","sourceCharacterId":"7888","sourceWorkId":"22497","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の1年生で、総司の妹と同級生。"},{"spoiler":false,"text":"引っ込み思案な性格で、なんとか積極的になろうと努力するものの、やや暴走気味に。"},{"spoiler":false,"text":"わりとすぐにテンパる。"},{"spoiler":false,"text":"頼りになる総司に憧れの気持ちを抱いており、親しみを込めて 「お兄さん」 と呼ぶ。"},{"spoiler":false,"text":"義姉の咲希は、父の再婚相手の連れ子。"},{"spoiler":false,"text":"咲希のことを強烈に慕っていて、「お姉ちゃんお姉ちゃんっ」 とまとわりつく。"},{"spoiler":false,"text":"「あっ、いえ、大丈夫です！　お兄さんになら見られても！　全然平気です!!」"}],"source":"bangumi","sourceCharacterId":"38608"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"38608","value":"1学年"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ad01540b0a7a4cd6199479f871345b95efc6fb2b56ddb12593b3cec1d40b5df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ebc8a0c04d0ec93b5751fdeab6b59deae7e4363327da088d8dd795906bfcae7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ミルノ純","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155751:38608:6167:1","source":"bangumi"}]},{"characterId":"char_vndb_c47238","characterName":"立石 総司","sourceIds":{"vndbCharacterId":"c47238"},"originalCharacterName":"立石 総司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. Souji is serious, but not too serious and has mediocre grades. After returning with his younger sister Mayuri to the town they used to live in, he reunites with Kanade."},{"spoiler":false,"text":"Fairly kind and fairly blockheaded, he's often in denial when it comes to feelings from women, going \"I'm overthinking it, there's no way she loves me\"."},{"spoiler":false,"text":"He's classmates with Kanade and Saki. Childhood friends with Kanade and Hayane, and Hayane is also his first love."},{"spoiler":false,"text":"Although he was acquainted with Yuiri whom his little sister often brought in, he didn't know she was Saki's little sister."}],"source":"vndb","sourceCharacterId":"c47238"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71023575e34821242a4799ee7723092153d4d78cc04ed76dac9c3d073279c6a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbcf1395cf177d464f7d6ba46adf55563144a966dd94a87abf30c5b748e5fac7.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c55364","characterName":"立石 まゆり","sourceIds":{"vndbCharacterId":"c55364"},"originalCharacterName":"立石 まゆり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Souji's little sister. She quickly picks up rumors, has good social skills and is very informed on stuff. Mayuri calls her older brother \"anii\". She loves Souji for his kindness, but that's ultimately familial love and not a romance one. Still, she declares that \"if I'm to go out with someone, I'd like someone who's like anii\"."},{"spoiler":false,"text":"A sweets lover, her favorite food are crepes with topped with lots of cream, especially Hayane's handmade first class ones."},{"spoiler":false,"text":"A sexual-harassing devil who rubs heroines' boobs and then goes \"jealous, aren't you~\" to her brother."},{"spoiler":false,"text":"Quite the clutz, immediately relies on Souji when in trouble, behaves spoiled. She also tries to do everything possible to put her brother in a romantic relationship with the girl he likes the most."}],"source":"vndb","sourceCharacterId":"c55364"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9ea4a2d83a9f79ac7f9af340375dc1243ce84f294d43e6b1f8b8163691870160.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b82ecc94221e1a1cd0ca6946e4387453a22a209045f7edfe34d64f402dfa3fbf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"空気 無子","creatorId":"vndb:s11621","sourcePersonId":"vndb:s11621","canonicalEntityId":"vndb:s11621","name":"空気 無子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66897","source":"vndb"}]},{"characterId":"char_vndb_c82697","characterName":"平山 圭助","sourceIds":{"vndbCharacterId":"c82697"},"originalCharacterName":"平山 圭助","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Souji's classmate with Kanade and Saki. Apparently, he was also a classmate of Souji's the year he moved and he would have given him a totem pole as a farewell gift but Souji doesn't remember him at all, although he remembers the totem perfectly."}],"source":"vndb","sourceCharacterId":"c82697"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cf1ee5092b99e7b233ad9a192a83dc873dccb9c21007ccef012949995849114.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83efeb334fc90a74260a35203969007c395d516d24fd00f1378a3d70561fa36e.webp","width":211,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雫田 ハヤテ","creatorId":"vndb:s18778","sourcePersonId":"vndb:s18778","canonicalEntityId":"vndb:s18778","name":"雫田ハヤテ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66898","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p119","sourceCompanyId":"egs:brand:84","canonicalEntityId":"vndb:p119","name":"戯画","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22497:84","source":"egs"},{"companyId":"vndb:p119","sourceCompanyId":"vndb:p119","c