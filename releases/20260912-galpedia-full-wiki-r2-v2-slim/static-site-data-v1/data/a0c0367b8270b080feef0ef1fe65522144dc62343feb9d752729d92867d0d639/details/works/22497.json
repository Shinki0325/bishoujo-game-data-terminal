:"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125462","source":"vndb"},{"creditedName":"うなさか","creatorId":"vndb:s5639","sourcePersonId":"vndb:s5639","canonicalEntityId":"vndb:s5639","name":"うなさか","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:125464","source":"vndb"},{"creditedName":"RUCCA","creatorId":"vndb:s4302","sourcePersonId":"vndb:s4302","canonicalEntityId":"vndb:s4302","name":"溝口 貴紀","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:125466","source":"vndb"},{"creditedName":"サイキライダー","creatorId":"vndb:s20061","sourcePersonId":"vndb:s20061","canonicalEntityId":"vndb:s20061","name":"サイキライダー","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:125467","source":"vndb"}]},"cast":[{"characterId":"char_c40162","characterName":"五ヶ谷 奏撫","sourceIds":{"bangumi":[{"characterId":"38605","match":"exact-normalized-name-in-linked-work","subjectId":"155751"}],"egsCharacterIds":["7885"],"vndbCharacterId":"c40162"},"originalCharacterName":"五ヶ谷 奏撫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"213"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Along with Hayane, she has known Souji since they were very young and has been getting along with him until he and his sister Mayuri have moved away. Then one day, with their reunion as the trigger, her feelings of love she has been keeping warm have started acting up."},{"spoiler":false,"text":"Because of her older sister giving her lots of trouble, she has become meddlesome and caring towards everyone. Although she often goes \"good grief\" at people, she doesn't feel displeasure towards helping anyone. Her day starts with waking up her sister."},{"spoiler":false,"text":"Souji is her first love, but she's aware that his first love is her older sister."},{"spoiler":false,"text":"Because she's scared of shampoo getting into her eyes when she's washing her hair, she still can't stop using a shampoo hat."}],"source":"vndb","sourceCharacterId":"c40162"},{"segments":[{"spoiler":false,"text":"主人公との関係は羽耶音と共に幼い頃から始まり、主人公の引っ越しまで家族ぐるみの付き合いになっていた。"},{"spoiler":false,"text":"そんなある日、主人公と再会したのをきっかけに温め続けていた恋心が再び動き出す。"},{"spoiler":false,"text":"姉の手間がかかるせいで、誰に対しても世話焼き気質。"},{"spoiler":false,"text":"「まったくぅ」とは思うものの、それを不満や嫌とは思っていない。朝の日課は、姉を起こすところから始まる。"},{"spoiler":false,"text":"主人公が初恋相手だが、主人公の初恋相手が姉であることも知っている。"},{"spoiler":false,"text":"髪を洗う時は目が痛くなるのを恐れて、未だにシャンプーハットが手放せない。"}],"source":"egs","sourceCharacterId":"7885","sourceWorkId":"22497","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の2年生で、主人公・総司の幼なじみ。"},{"spoiler":false,"text":"姉・羽耶音の手間が掛かるせいで世話焼き気質。 羽耶音を起こすのが朝の日課。"},{"spoiler":false,"text":"「まったくぅ」とは思うものの、それを不満や嫌とは思っていない。"},{"spoiler":false,"text":"髪を洗う時は目が痛くなるのを恐れて、未だにシャンプーハットが手放せない。"},{"spoiler":false,"text":"総司とは幼い頃に出会い、総司が引っ越すまで家族ぐるみの付き合いだった。"},{"spoiler":false,"text":"初恋の相手は総司だが、総司の初恋相手が姉であることを知っている。"},{"spoiler":false,"text":"総司と再会したことをきっかけに、温め続けていた恋心が再び動き出す。"},{"spoiler":false,"text":"「ソウ……くん……!?　ソウくんだよね!?」"}],"source":"bangumi","sourceCharacterId":"38605"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"38605","value":"2年生"},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"7885","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"7885","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"7885","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"7885","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"7885","sourceWorkId":"22497","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79592c13db033216f180f9f3dc892112dcea66b6019ffd86198f3e4c7de55552.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/414f6b06e27ab78d60d24014befe1c10cc2ea381c013512688fbe74626602863.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"巽悠衣子","creatorId":"vndb:s4393","sourcePersonId":"vndb:s4393","canonicalEntityId":"vndb:s4393","name":"巽悠衣子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155751:38605:5124:1","source":"bangumi"}]},{"characterId":"char_c40163","characterName":"五ヶ谷 羽耶音","sourceIds":{"bangumi":[{"characterId":"38606","match":"exact-normalized-name-in-linked-work","subjectId":"155751"}],"egsCharacterIds":["7886"],"vndbCharacterId":"c40163"},"originalCharacterName":"五ヶ谷 羽耶音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"160cm"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third year in the school, is Kanade's older sister and Souji's first love, he's been calling her \"Haya-nee\". Although she's just a year older, she appears to be even older and is like tolerance incarnate. She immediately hugs people close to her and compliments them along with a pat on his head."},{"spoiler":false,"text":"She is bad at cleaning her room and cooking, but her skill at making sweets is on the level of a pro, her crepes are especially good."},{"spoiler":false,"text":"She sometimes staggers and has problems holding her balance, which is blamed on her \"extremely self-asserting big breasts\". She often walks around her home without a bra, or wearing just a towel after coming out of the bath."}],"source":"vndb","sourceCharacterId":"c40163"},{"segments":[{"spoiler":false,"text":"学園の３年生で、主人公の初恋相手。"},{"spoiler":false,"text":"「ハヤ姉」と呼ばれていた。"},{"spoiler":false,"text":"１つ上なのに、それ以上の年上に見える包容力の塊。"},{"spoiler":false,"text":"すぐに抱きしめて「よしよし」と撫でて褒めてくる。"},{"spoiler":false,"text":"部屋の片づけを始め、家事が苦手だが、お菓子作りだけはプロ並で、特にクレープは絶品。"},{"spoiler":false,"text":"ふらついたり、バランスが取れていない理由に、『自己主張激しい巨乳』のせいもある。"},{"spoiler":false,"text":"ノーブラだったり、風呂あがりにバスタオル１枚で家の中をうろついたりする。"}],"source":"egs","sourceCharacterId":"7886","sourceWorkId":"22497","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の3年生で、総司の初恋相手。 総司には “ハヤ姉” と呼ばれていた。"},{"spoiler":false,"text":"実年齢よりも年上に見える包容力の塊。 すぐに抱きしめて 「よしよし」 と撫でて褒めてくる。"},{"spoiler":false,"text":"部屋の片づけを始め家事は苦手だが、お菓子作りだけはプロ並。 特にクレープは絶品。"},{"spoiler":false,"text":"家ではノーブラだったり、風呂あがりにバスタオル 1枚で家の中をうろついたりする。"},{"spoiler":false,"text":"よくふらついているが、その理由に “自己主張の激しい巨乳” がある。"},{"spoiler":false,"text":"「昔はも～っと、ハヤ姉 ハヤ姉って懐いてきてて、可愛かったのに～。」"}],"source":"bangumi","sourceCharacterId":"38606"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"38606","value":"3学年"},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"7886","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"7886","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"7886","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"7886","sourceWorkId":"22497","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"7886","sourceWorkId":"22497","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04a2af109d33daf5bbada2eea6239b8551d431c2f5176ad2ca7c3a017d92a5fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe5d9fee55a6b180a644d281681e2ca3baf6534895667f1f3e5b2b114e64cad8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155751:38606:8580:1","source":"bangumi"}]},{"characterId":"char_c40164","characterName":"双葉 咲希","sourceIds":{"bangumi":[{"characterId":"38607","match":"exact-normalized-name-in-linked-work","subjectId":"155751"}],"egsCharacterIds":["7887"],"vndbCharacterId":"c40164"},"originalCharacterName":"双葉 咲希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-con