board. Often hears about the protagonist from her sister, but has a bad first impression when they actually meet."}],"source":"vndb","sourceCharacterId":"c47932"},{"segments":[{"spoiler":false,"text":"主人公の住む部屋のお隣さんの妹。"},{"spoiler":false,"text":"（自）意識高い系の女子。"},{"spoiler":false,"text":"主人公になにかとつっかかったり、なんでもできちゃう風を装うが、案外ポンコツ。"},{"spoiler":false,"text":"いつも自爆して部屋でジタバタしている。"}],"source":"egs","sourceCharacterId":"13994","sourceWorkId":"23740","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のお隣さんの妹で、（自）意識高い系の女子。主人公になにかとつっかかったり、なんでもできちゃう雰囲気を装うが実際は案外ポンコツ。いつも自爆しては部屋でジタバタしている。"}],"source":"bangumi","sourceCharacterId":"46947"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d43f85845a135dc1e6e4d875675fa7e47efdc4788e3c5d025cc529dd5056052.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7031ec06b5beb0a7a39c66a66ccb1fe63f2138f1e667e835825bd02697ba502.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183287:46947:13372:1","source":"bangumi"}]},{"characterId":"char_vndb_c85493","characterName":"姫野 雅景","sourceIds":{"vndbCharacterId":"c85493"},"originalCharacterName":"姫野 雅景","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29c6222628ac4fb18ccb904dc8b3943fa63b28dd80af4d2086679ff9d915d088.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/323a96c01721ec5