:"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66037","source":"vndb"},{"creditedName":"グレ彦","creatorId":"vndb:s9781","sourcePersonId":"vndb:s9781","canonicalEntityId":"vndb:s9781","name":"グレ彦","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66039","source":"vndb"},{"creditedName":"有限会社アフェス「無月庭」","creatorId":"vndb:s12956","sourcePersonId":"vndb:s12956","canonicalEntityId":"vndb:s12956","name":"有限会社アフェス「無月庭」","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66040","source":"vndb"},{"creditedName":"阪本 海老人","creatorId":"vndb:s15636","sourcePersonId":"vndb:s15636","canonicalEntityId":"vndb:s15636","name":"阪本 海老人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66041","source":"vndb"},{"creditedName":"神楽 陽子","creatorId":"vndb:s34585","sourcePersonId":"vndb:s34585","canonicalEntityId":"vndb:s34585","name":"神楽 陽子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66042","source":"vndb"}]},"cast":[{"characterId":"char_c11662","characterName":"オリオンサンズ","sourceIds":{"bangumi":[{"characterId":"88817","match":"exact-normalized-name-in-linked-work","subjectId":"222097"}],"egsCharacterIds":["16491"],"vndbCharacterId":"c11662"},"originalCharacterName":"オリオンサンズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An innocent, naive girl who can transform into Orion Suns."},{"spoiler":false,"text":"After finishing her battle at the Black Castle, she started a new, peaceful life."},{"spoiler":false,"text":"The beginnings of love begin to stir in her heart for her classmate, Osamu, and the demon Gildart aims to abuse this weakness."},{"spoiler":false,"text":"Yuka falls victim to the demon’s vile plans as she tries to save Osamu, and her best friend Aoi shares the same fame."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c11662"},{"segments":[{"spoiler":false,"text":"正義のスク水セーラー戦士・オリオンハートの一人「オリオンサンズ」へと変身する、天真爛漫な元気少女。"},{"spoiler":false,"text":"普段は通っている、ごく普通の女子校生。"},{"spoiler":false,"text":"現在は戦いが終わって、平和なひと時を過ごしている。"},{"spoiler":false,"text":"同級生の少年・修が好きになるが、復活した魔族・ギルタートによって、その純真な心を踏みにじられる。"}],"source":"egs","sourceCharacterId":"16491","sourceWorkId":"11380","spoiler":false},{"segments":[{"spoiler":false,"text":"オリオンハートの一人オリオンサンズへと変身する、天真爛漫な元気少女。"},{"spoiler":false,"text":"ブラックキャッスルとの戦いを終え、平和な一時に身を置く。"},{"spoiler":false,"text":"同級生の少年 修と淡い恋心を育むが、その心の隙を魔族ギルダートにつけ狙われる。"},{"spoiler":false,"text":"修を助けたいがために奸計に陥り、その身ばかりか親友の葵までも魔族に委ねることに。"}],"source":"bangumi","sourceCharacterId":"88817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/addc09bbc22a98c3b247276511e00c5f8b6092051340ca9e000d69f2c8f6296e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49bbc376ecd04e039d46833213557875512b08889f25160bc30c6f58b0ac8339.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222097:88817:5890:1","source":"bangumi"}]},{"characterId":"char_c11663","characterName":"オリオンムーン","sourceIds":{"bangumi":[{"characterId":"88818","match":"exact-normalized-name-in-linked-work","subjectId":"222097"}],"egsCharacterIds":["16492"],"vndbCharacterId":"c11663"},"originalCharacterName":"オリオンムーン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An intelligent, noble maiden who can transform into Orion Moon."},{"spoiler":false,"text":"She was watching the relationship bloom between Yuka and Osamu with warmth in her eyes, but never in her wildest dreams did she imagine that a demon was creeping between the two."},{"spoiler":false,"text":"When she finally notices, it’s too late, and both she and Yuka fall into Gildart’s trap, corrupting their pure and innocent bodies as he pleases."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c11663"},{"segments":[{"spoiler":false,"text":"正義のスク水セーラー戦士・オリオンハートの一人「オリオンムーン」へと変身する、頭脳明晰な名家の令嬢。"},{"spoiler":false,"text":"優夏とは親友同士で、同じが学園に通っている優等生。"},{"spoiler":false,"text":"優夏が修を好きになり、それを彼女はあたたかく見守っていたが、その二人に魔族の影が忍び寄っていた。気付いた時には遅く、彼女自身もギルダートの罠にかかって……。"}],"source":"egs","sourceCharacterId":"16492","sourceWorkId":"11380","spoiler":false},{"segments":[{"spoiler":false,"text":"オリオンムーンへと変身する、知略を誇る名家の令嬢。"},{"spoiler":false,"text":"優夏と修のことを暖かく見守っていたが、二人に魔族の影が忍び寄っていることはさしもの葵も予想だにしていなかった。"},{"spoiler":false,"text":"気付いた時には、優夏もろともギルダートの罠にかかり、清純な肉体を思うがままに穢されてしまう。"}],"source":"bangumi","sourceCharacterId":"88818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6305b3fe3a61f9fb93ac3ea562d00ccf88ce1624ea016c179f839303b871c394.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07216ea90c05a0d7e57c1fdf3e277a6182eb36605f6cf23f79c813b7219289e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222097:88818:6018:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1955","sourceCompany