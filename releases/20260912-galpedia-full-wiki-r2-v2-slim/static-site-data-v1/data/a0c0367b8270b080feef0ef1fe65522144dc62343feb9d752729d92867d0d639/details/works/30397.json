{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30397","model":{"presentationWorkId":"vndb:v29930","staff":{"artwork":[{"creditedName":"せぼい","creatorId":"vndb:s15162","sourcePersonId":"egs:creator:32015","canonicalEntityId":"vndb:s15162","name":"せぼい","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:230508","source":"egs"}],"scenario":[{"creditedName":"はやさかうたね","creatorId":"vndb:s275","sourcePersonId":"egs:creator:1516","canonicalEntityId":"vndb:s275","name":"はやさかうたね","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:230509","source":"egs"}],"music":[],"other":[{"creditedName":"せぼい","creatorId":"vndb:s15162","sourcePersonId":"vndb:s15162","canonicalEntityId":"vndb:s15162","name":"せぼい","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:171180","source":"vndb"}]},"cast":[{"characterId":"char_c94968","characterName":"高月 美雪","sourceIds":{"bangumi":[{"characterId":"90594","match":"exact-normalized-name-in-linked-work","subjectId":"326554"}],"egsCharacterIds":["23135"],"vndbCharacterId":"c94968"},"originalCharacterName":"高月 美雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"102"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"2年前に主人公と結婚する。"},{"spoiler":false,"text":"一応は恋愛結婚だが、クセが強くなく、自分が主導権を握れて、無能ではない人など、長い目が見てトータルで自分の特になりそうな男性として主人公を選んだ。"},{"spoiler":false,"text":"その為、あまりラブラブな結婚生活ではなく、どこか冷めている関係だが、冷え切っているわけではない。"}],"source":"egs","sourceCharacterId":"23135","sourceWorkId":"30397","spoiler":false},{"segments":[{"spoiler":false,"text":"真司との結婚生活は２年目を迎える人妻。"},{"spoiler":false,"text":"早苗から引き継いだ性格と、早苗が美雪に苦労させないように甘やかしていたため、ややキツ目で少しか我が強い性格。"},{"spoiler":false,"text":"小さい頃、苦労していた早苗を見ているので、早く早苗にラクをさせたいとも思っている。"},{"spoiler":false,"text":"夫・真司とのセックスに関しては、それほど多くなく、積極的でもない。"},{"spoiler":false,"text":"性行為は嫌いではないが、そういう行為に溺れるのは恥ずかしいことだからという羞恥心が強いため。"},{"spoiler":false,"text":"早苗と真司が関係を持っていることがわかったことで、ようやく真司に対して嫉妬したり独占したいと思う感情が燃え上がる。"}],"source":"bangumi","sourceCharacterId":"90594"}],"profileFacts":[{"label":"胸围（本版本）","value":"102 cm","valueContext":null,"source":"egs","sourceCharacterId":"23135","sourceWorkId":"30397","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"23135","sourceWorkId":"30397","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"23135","sourceWorkId":"30397","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"23135","sourceWorkId":"30397","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"hip":[{"comparisonValue":"90","source":"vndb","sourceCharacterId":"c94968","value":"90"},{"comparisonValue":"90","scope":"sourceWork","source":"egs","sourceCharacterId":"23135","sourceWorkId":"30397","value":"90"},{"comparisonValue":"94","source":"bangumi","sourceCharacterId":"90594","value":"94"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7df8db42fd4944ff1fdec7223d7a930c8cd310267fa8557938c79182b81bae8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8ee276bb03200f7ae9153227a4d8e8f3fd1f82160f9918e8b5bd46df6a5d2445.webp","width":83,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤宮 きせき","creatorId":"vndb:s22396","sourcePersonId":"vndb:s22396","canonicalEntityId":"vndb:s22396","name":"藤宮きせき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86409","source":"vndb"}]},{"characterId":"char_c94969","characterName":"高月 早苗","sourceIds":{"bangumi":[{"characterId":"90593","match":"exact-normalized-name-in-linked-work","subjectId":"326554"}],"egsCharacterIds":["23136"],"vndbCharacterId":"c94969"},"originalCharacterName":"高月 早苗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"100"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美雪の母親で、主人公の義母。"},{"spoiler":false,"text":"夫とは15年前に死別。夫の亡き後は、夫が経営していた家具・インテリア会社を引き継ぐ形で社長となる。"},{"spoiler":false,"text":"しかし、会社も大きく傾き、様々な苦難を乗り越えるためにかなり苦労をしたが、奮闘の甲斐あって現在の経営は安定している。"}],"source":"egs","sourceCharacterId":"23136","sourceWorkId":"30397","spoiler":false},{"segments":[{"spoiler":false,"text":"夫とは十数年前に死別している。"},{"spoiler":false,"text":"夫が亡くなってからは、夫が起こした会社を引き継ぐ形で社長となる。"},{"spoiler":false,"text":"社長である夫が亡くなったことで会社も大きく傾いたので、直後からしばらくの間はかなりの苦労をしてきた苦労人。"},{"spoiler":false,"text":"娘婿の真司に対して、とにかく頼りない、早く全てを任せられる一人前の男になって欲しいと思っている。"}],"source":"bangumi","sourceCharacterId":"90593"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"94","source":"vndb","sourceCharacterId":"c94969","value":"94"},{"comparisonValue":"96","source":"bangumi","sourceCharacterId":"90593","value":"96"}],"hip":[{"comparisonValue":"96","source":"vndb","sourceCharacterId":"c94969","value":"96"},{"comparisonValue":"100","source":"bangumi","sourceCharacterId":"90593","value":"100"}],"waist":[{"comparisonValue":"62","source":