racterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"隣国アラディアの皇女。"},{"spoiler":false,"text":"“アラディアの至高の宝”と謳われる美姫。"},{"spoiler":false,"text":"性格は真面目で天真爛漫、しかし世間知らずで、やや羞恥心に欠けるところも。"},{"spoiler":false,"text":"彼女の人気に嫉妬する兄の皇子に政略結婚の駒として、悪名高きバルタージュ公に嫁がされるが、宮廷騎士団長・リッテに助け出され、現在、主人公のホテルに潜伏中。"}],"source":"egs","sourceCharacterId":"19134","sourceWorkId":"10055","spoiler":false},{"segments":[{"spoiler":false,"text":"隣国アラディアの皇女。"},{"spoiler":false,"text":"アラディアの至高の宝と称されるほどの美少女で、その人気を嫉妬する兄の皇子に政略結婚のコマにされかかる。"},{"spoiler":false,"text":"性格は真面目で天真爛漫。しかし今ひとつ世間知らずで、羞恥心の欠けるところがあるいわゆるおひい様。"},{"spoiler":false,"text":"政略結婚に使われるところを宮廷騎士団長のリッテに逃され、逃避行の真っ最中。"}],"source":"bangumi","sourceCharacterId":"47060"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3ccc92b708dd7f30e7db048ad0538812786b1f682fb51d0812f8877cc5a5a189.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d961ffa8bb639e5cce0dbdf50bc15605fa63d1a076471e25a931dc7ff561409.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青木紀子","creatorId":"vndb:s268","sourcePersonId":"vndb:s268","canonicalEntityId":"vndb:s268","name":"青木 紀子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194269:47060:10343:1","source":"bangumi"}]},{"characterId":"char_c129885","characterName":"リッテ","sourceIds":{"bangumi":[{"characterId":"47061","match":"exact-normalized-name-in-linked-work","subjectId":"194269"}],"egsCharacterIds":["19135","19339"],"vndbCharacterId":"c129885"},"originalCharacterName":"リッテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"隣国アラディアの宮廷騎士団団長。"},{"spoiler":false,"text":"腕っ節の強さで女ながらもアラディアの宮廷騎士団の団長の座を射止める。"},{"spoiler":false,"text":"女性も羨む美貌と抜群のスタイルを持つが、それを無骨な兜と鎧、マントで隠している。"},{"spoiler":false,"text":"性格はクールで、忠誠心に厚く、主であるジュエリのためなら、命を賭す覚悟を持っている。"},{"spoiler":false,"text":"反皇子であるジュエリの従兄を頼って逃避行中、主人公のホテルに立ち寄る。"}],"source":"egs","sourceCharacterId":"19135","sourceWorkId":"10055","spoiler":false},{"segments":[{"spoiler":false,"text":"ハヤウェイたちのクラス担任教師。"},{"spoiler":false,"text":"天才的な頭脳を有するが、幼児体型にコンプレックスを持っている。"},{"spoiler":false,"text":"［■アフターストーリー］"},{"spoiler":false,"text":"同棲生活を満喫していたハヤウェイとリッテは、毎夜の営みのせいで遅刻ギリギリな素行をキザーロフに咎められてしまう。"},{"spoiler":false,"text":"現状を改善するため、そしてハヤウェイを立派な教官にするため、特訓を始めた二人だったが、いつの間にか校内エッチへと発展していき……。"}],"source":"egs","sourceCharacterId":"19339","sourceWorkId":"9747","spoiler":false},{"segments":[{"spoiler":false,"text":"隣国アラディアの宮廷騎士団団長。"},{"spoiler":false,"text":"無類の強さと美貌を誇る麗人の騎士。ジュエリを慕い、命に代えても守ると誓っている。"},{"spoiler":false,"text":"常日頃から眼光鋭くクール。普段は無骨なヘルメットとマントに身を包んでいるが、美貌とスタイルはかなりのもの。"},{"spoiler":false,"text":"ジュエリの従兄筋に当たる反皇子の元を頼って二人きりの逃避行中、一時的にこの交易都市に立ち寄った。"}],"source":"bangumi","sourceCharacterId":"47061"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c11f859388b0d5c3c98cbd1cc5c6115e6609177a43da8cbc7eb85a13ef78a95.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0427626043a0c48173a7aadf996356745c83fb734948e41b7a66b306d771409.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194269:47061:4727:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1011","sourceCompanyId":"egs