viewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"郁や美万里の就任先にして、乙姫や他の女の子達が通う香泉女子学園の学園長代行。美万里とは姉妹だったが、両親が離婚してしまったため現在は別々に暮らしている。"},{"spoiler":false,"text":"酒とたばこ、昼寝に夜更かし……、自堕落を絵に描いたような感じの彼女だが、見た目に反して中身はしっかり者。"},{"spoiler":false,"text":"保健室を自分の根城として、学生達や主人公の悩み相談に乗ってあげるなど、気さくな一面もある女性。だが美万里としては姉にもっとしっかりして欲しいらしく、たまにケンカをすることも……。"},{"spoiler":false,"text":"「学生たる者、大和撫子として……、アタシはいいんだ。もう大人なんだからさ♪」"}],"source":"egs","sourceCharacterId":"17317","sourceWorkId":"11232","spoiler":false},{"segments":[{"spoiler":false,"text":"もともとは学園の保険医であり、祖母の築いた学園を継承した学園長代行。"},{"spoiler":false,"text":"別姓になっているが美万里とは姉妹で、現在も仲のいい姉妹愛を育んでいる。"},{"spoiler":false,"text":"一見だらしないが、見た目に反して経営者としての腕は確かで、教員資格の他、医師の資格もちゃんと持っている。"},{"spoiler":false,"text":"しかし \"なんでも人任せ\" がポリシーなのか、家事や料理、洗濯などすべて美万里任せ。「年下で甲斐甲斐しく働く婿がこないかなー。あっ、美万里でもいいや」と、自堕落を絵に描いたような生活を送っている。"},{"spoiler":false,"text":"「香泉女子学園の学生たる者、節度と礼儀を重んじ大和撫子として恥じることのないよう心身共に日々鍛錬……アタシ？ アタシはいいんだ、もう大人の女なんだからさ」"}],"source":"bangumi","sourceCharacterId":"143845"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"17317","sourceWorkId":"11232","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"17317","sourceWorkId":"11232","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"17317","sourceWorkId":"11232","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"17317","sourceWorkId":"11232","sourceField":null,"scoped