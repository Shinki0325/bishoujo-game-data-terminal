rceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"17314","sourceWorkId":"11232","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"17314","sourceWorkId":"11232","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85ee5f5b20a15133feedc2cf0fc885c3d38cbe4caf131b1bb71682d770895692.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d109fcec982f62f21636922a10aa12f6facf67201d70579848e4327c89d27a24.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23560:77515:5922:1","source":"bangumi"}]},{"characterId":"char_c26866","characterName":"鶴ヶ島 有海","sourceIds":{"bangumi":[{"characterId":"143843","match":"exact-normalized-name-in-linked-work","subjectId":"23560"}],"egsCharacterIds":["17315"],"vndbCharacterId":"c26866"},"originalCharacterName":"鶴ヶ島 有海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の従妹でお嫁さん候補の一人。"},{"spoiler":false,"text":"香泉市にある喫茶店の一人娘。乙姫のクラスメイトでもある。"},{"spoiler":false,"text":"あまり感情を表に出さず、ボソボソと喋る無口系だが、言いたいことははっきり言うクールな女の子。"},{"spoiler":false,"text":"主人公のお嫁さん騒動に関しても事情を知った上で「別に良いと思う」とサラリと流すスタンスでいる。"},{"spoiler":false,"text":"父親が経営しているはずの喫茶店はいつ行っても彼女しかおらず、主人公のことをパパと呼ぶことがある。不思議な印象を持った女の子だ。"},{"spoiler":false,"text":"「先生で、従兄で、えっとパパで……なんか禁断の要素がいっぱい。」"}],"source":"egs","sourceCharacterId":"17315","sourceWorkId":"11232","spoiler":false},{"segments":[{"spoiler":false,"text":"『睡猫（れむにゃん）』という喫茶店で働く主人公の教え子。"},{"spoiler":false,"text":"あまり感情を表に出さず物静かだが、言いたいことはハッキリ言うクール系。"},{"spoiler":false,"text":"一応、親戚という関係らしいのだが家族の姿は見えず、なぜかパパと呼んでくるなど、なにかと謎が多い一面も。"},{"spoiler":false,"text":"若干つり上がった瞳や無表情な顔立ちから、なんとなく猫っぽい雰囲気を感じる女の子。"},{"spoiler":false,"text":"「いいのかな。私、先生を好きになっても……いいのかな？　先生で、従兄で、えっとパパで……なんか禁断の要素がいっぱい」"}],"source":"bangumi","sourceCharacterId":"143843"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"17315","sourceWorkId":"11232","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"143 cm","valueContext":null,"source":"egs","sourceCharacterId":"17315","sourceWorkId":"11232","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"17315","sourceWorkId":"11232","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"17315","sourceWorkId":"11232","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"17315","sourceWorkId":"11232","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f8e12d6e42915cca63dcd175403b67a5e5776734e90ffc5242de153c9187c83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e5ebffbb9057bb9af936880a3f20c4c8fa08f23f10b3c7c53c829e6aba1f2d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23560:143843:5928:1","source":"bangumi"}]},{"characterId":"char_c26867","characterName":"入間 美万里","sourceIds":{"bangumi":[{"characterId":"143844","match":"exact-normalized-name-in-linked-work","subjectId":"23560"}],"egsCharacterIds":["17316"],"vndbCharacterId":"c26867"},"originalCharacterName":"入間 美万里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"母方の従姉で、主人公が赴任することになった学園の先生。同僚で先輩。"},{"spoiler":false,"text":"乙姫と会う前、まだ主人公が香泉の町で暮らしていた時に何かと主人公の世話を焼いてくれたお姉ちゃん、それが美万里だ。"},{"spoiler":false,"text":"主人公からすれば姉のような人。美万里も主人公の事を弟と思っているようで、真面目な性格の彼女は時に厳しく主人公に接してくることも。それも全部主人公を思っての言動なのだが……。"},{"spoiler":false,"text":"郷里に帰ってきた主人公は、許婚との同棲生活を真面目なお姉ちゃんに知らせるわけに行かず、内緒の関係が始まる。"},{"spoiler":false,"text":"「女の子って、独占されたい気持ちが強いんだから、私はそういうの……まだ経験したことないけど。」"}],"source":"egs","sourceCharacterId":"17316","sourceWorkId":"11232","spoiler":false},{"segments":[{"spoiler":false,"text":"かわいい顔立ちをした、年上とは思えないお姉ちゃん先生。"},{"spoiler":false,"text":"実は爆乳でエッチな身体つきをしているが、妖艶というよりもかわいい愛され系のキャラが定着してしまっている。"},{"spoiler":false,"text":"主人公のことは本当の弟のように思っており、乙姫との同棲を知っても応援していたのだが……。"},{"spoiler":false,"text":"「女の子って、独占されたい気持ちが強いんだから。私はそういうの……まだ経験したことないけど」"}],"source":"