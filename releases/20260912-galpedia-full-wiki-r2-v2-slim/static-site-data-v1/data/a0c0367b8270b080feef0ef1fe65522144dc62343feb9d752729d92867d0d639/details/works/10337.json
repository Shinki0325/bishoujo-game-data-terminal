ource-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"男勝りで気が強い、体育会系の少女で、本作のメインヒロイン。"},{"spoiler":false,"text":"毎日、授業中に輪姦されるという状況に抵抗するが、結局、力尽き、精液まみれになるまで無理やり犯され続ける。"},{"spoiler":false,"text":"「いやぁっ!!　やめてってば!!　そんな汚いものこすりつけないでよ!!」"},{"spoiler":false,"text":"■ノートの記述"},{"spoiler":false,"text":"「元気で気の強いこの子だけど、実は、無理矢理屈服させられたいに違いない」"}],"source":"egs","sourceCharacterId":"18852","sourceWorkId":"10337","spoiler":false},{"segments":[{"spoiler":false,"text":"男勝りな気の強い女の子。遥の引っ越しが話の発端となる。"},{"spoiler":false,"text":"毎日、授業中に輪○されるという異常な状況に、罵声を浴びせながら抵抗するが、結局力尽きるまで 無理矢理○辱される事になるのだった。"},{"spoiler":false,"text":"＜ノートには……＞"},{"spoiler":false,"text":"元気で気の強い、この子だけど、実は…… 無理矢理屈服させられたいに違いない。"},{"spoiler":false,"text":"……と書かれているようだ。"}],"source":"bangumi","sourceCharacterId":"94029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/897707708cb6183798cb8e6a939d13e11150b31422cf86adb5e50c28ac8ed369.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87d065ad71df8ff14ee67c8dc8a885cd3e79ff0e2f295aac6f64cb2d4184cace.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由宇翼","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"あさり☆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230767:94029:18193:1","source":"bangumi"}]},{"characterId":"char_c60025","characterName":"譲原 由貴","sourceIds":{"bangumi":[{"characterId":"94030","match":"exact-normalized-name-in-linked-work","subjectId":"230767"}],"egsCharacterIds":["18853"],"vndbCharacterId":"c60025"},"originalCharacterName":"譲原 由貴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments"