38","name":"近江 達裕","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72430","source":"vndb"}]},"cast":[{"characterId":"char_c32029","characterName":"甘原 出雲","sourceIds":{"bangumi":[{"characterId":"38718","match":"exact-normalized-name-in-linked-work","subjectId":"23570"},{"characterId":"38718","match":"exact-normalized-name-in-linked-work","subjectId":"23605"}],"egsCharacterIds":["9953"],"vndbCharacterId":"c32029"},"originalCharacterName":"甘原 出雲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"サブキャラ。星乃鷲学園第III学部北校3年生。"},{"spoiler":false,"text":"琴子の友達であり、部活仲間であり、演劇部部長でもある。"},{"spoiler":false,"text":"外見がクールで近寄りがたい印象があるが、普段は落ち着いた面倒見のいい女性。"},{"spoiler":false,"text":"だが、意外に子供っぽい一面もあり、かなり悪戯好きで、琴子も晴貴もまれに被害を受けることがある。"},{"spoiler":false,"text":"学園内で唯一琴子と晴貴の恋人関係を知っており、何かと手助けをしてくれる。"}],"source":"egs","sourceCharacterId":"9953","sourceWorkId":"15352","spoiler":false},{"segments":[{"spoiler":false,"text":"星乃鷲学園第III学部北校3年生。"},{"spoiler":false,"text":"朝霧琴子（前作ヒロイン）の友達であり、部活仲間であり、演劇部部長でもある。"},{"spoiler":false,"text":"外見がクールで近寄りがたい印象があるが、普段は落ち着いた面倒見のいい女性。"},{"spoiler":false,"text":"だが、意外に子供っぽい一面もあり、かなり悪戯好きで、琴子も朝霧晴貴（前作主人公）も稀に被害を受けることがある。"},{"spoiler":false,"text":"学園内で唯一琴子と晴貴の恋人関係を知っており、何かと手助けをしてくれる。"}],"source":"egs","sourceCharacterId":"9953","sourceWorkId":"15592","spoiler":false},{"segments":[{"spoiler":false,"text":"-朝霧姉妹編-："},{"spoiler":false,"text":"星乃鷲学園第III学部北校3年生。"},{"spoiler":false,"text":"琴子の友達であり、部活仲間であり、演劇部部長でもある。"},{"spoiler":false,"text":"外見がクールで近寄りがたい印象を感じさせるが、普段は落ち着いた面倒見のいい女性。"},{"spoiler":false,"text":"意外に子供っぽい一面もあり、かなり悪戯好きで、琴子も晴貴もまれに被害を受けることがある。"},{"spoiler":false,"text":"学園内で唯一琴子と晴貴の恋人関係を知っており、なにかと手助けをしてくれる。"},{"spoiler":false,"text":"星乃鷲学園第III学部北校3年生。"},{"spoiler":false,"text":"琴子的朋友和部里的伙伴，演剧部部长。外表给人一种冷酷令人难以接近的印象，但平时是一个温柔的喜欢照顾人的女性。"},{"spoiler":false,"text":"意外地有着孩子般的一面，喜欢恶作剧，琴子和晴貴都经常被捉弄。"},{"spoiler":false,"text":"学园里唯一一个知道琴子和晴貴的恋人关系的人，经常帮助他们。"},{"spoiler":false,"text":"-甘原出雲編-："},{"spoiler":false,"text":"星乃鷲学園 第III学部北校 3年生。 演劇部部長。"},{"spoiler":false,"text":"前作 ヒロイン・琴子の友達であり、部活仲間でもある。"},{"spoiler":false,"text":"外見がクールで近寄りがたい印象はあるが、普段は落ち着いた面倒見のいい女性。"},{"spoiler":false,"text":"だが意外に子供っぽい一面もあり、かなり悪戯好きで、仲の良い友人たちもまれに被害を受けることがある。"},{"spoiler":false,"text":"星乃鷲学园 第III学部北校 3年生。演剧部部长。"},{"spoiler":false,"text":"前作女主人公・琴子的好友，也是社团的队友。"},{"spoiler":false,"text":"给人以外表冰冷而难于接近的印象，不过实际上平时是个稳重体贴的善良女性。"},{"spoiler":false,"text":"但是也有着意外孩子气的一面，相当地喜欢恶作剧，连关系不错地同学也会偶尔成为其恶作剧的目标。"}],"source":"bangumi","sourceCharacterId":"38718"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48045f5ddab6c8f2a71279167c9e82ec9332bdcecbd449dac7127c1b94d14122.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60c1e42738e0ac1f413e1bd444b3a9e9120a3679207ce41db3ce4844c78b1c09.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23605:38718:6469:1","source":"bangumi"}]},{"characterId":"char_vndb_c41524","characterName":"甘原 健矢","sourceIds":{"vndbCharacterId":"c41524"},"originalCharacterName":"甘原 健矢","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p171","sourceCompanyId":"egs:brand:413","canonicalEntityId":"vndb:p171","name":"アトリエかぐや","roleCodes":["brand"],"identityStatus":"auto-confirmed"