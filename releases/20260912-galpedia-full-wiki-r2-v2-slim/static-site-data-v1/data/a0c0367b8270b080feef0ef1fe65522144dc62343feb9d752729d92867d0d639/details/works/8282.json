{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8282","model":{"presentationWorkId":"vndb:v7360","staff":{"artwork":[{"creditedName":"とり","creatorId":"vndb:s695","sourcePersonId":"vndb:s695","canonicalEntityId":"vndb:s695","name":"六花梨花(とり)","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:70439","source":"vndb"},{"creditedName":"YUKIMI","creatorId":"vndb:s702","sourcePersonId":"vndb:s702","canonicalEntityId":"vndb:s702","name":"宮田 有紀美","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:70440","source":"vndb"}],"scenario":[{"creditedName":"TADA","creatorId":"vndb:s689","sourcePersonId":"vndb:s689","canonicalEntityId":"vndb:s689","name":"TADA","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:70438","source":"vndb"}],"music":[{"creditedName":"一太郎","creatorId":"vndb:s709","sourcePersonId":"vndb:s709","canonicalEntityId":"vndb:s709","name":"DragonAttack","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:70441","source":"vndb"}],"other":[]},"cast":[{"characterId":"char_vndb_c53095","characterName":"来水 美樹","sourceIds":{"vndbCharacterId":"c53095"},"originalCharacterName":"来水 美樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1215"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Level/Level Cap: 1/∞"},{"spoiler":false,"text":"Skill Level(s): Demon King LV1"},{"spoiler":false,"text":"A young girl from a dimension very similar to our own who was chosen by Demon King Gai as his successor against her will. While she was rescued from his clutches by her boyfriend Kentarou, Gai had already successfully transmitted his blood into her, making her the next Demon King."},{"spoiler":false,"text":"Currently, the Demons are caught in a civil war between those who desire to follow Gai's wishes and make her the new Demon King and those who oppose her. Miki herself has no desire to become the Demon King, and travels the continent with Kentarou in search of a way to return her body to normal."},{"spoiler":false,"text":"While she is normally a gentle, timid girl, as the Demon King, she possesses immeasurable power that far surpasses even the strongest demons. In order to keep this power under control, she is required to eat a rare hirami lemon that is only grown at the top of a mountain in rural Helman every three months."}],"source":"vndb","sourceCharacterId":"c53095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6eb8bf7c725442489851f6345e0e4dfafdedd570c229f83bb04e7e10fab02b1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ab1c356ba0ccec1bb222c5cdda4838ed28affe10f171023840afec6eeeb5573.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c53096","characterName":"小川 健太郎","sourceIds":{"vndbCharacterId":"c53096"},"originalCharacterName":"小川 健太郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Level/Level Cap: 25/100"},{"spoiler":false,"text":"Skill Level(s): Sword Combat LV2"},{"spoiler":false,"text":"An ordinary young man from a dimension very similar to our own whose life was changed forever when his girlfriend Miki was kidnapped by the Demon King Gai to become his successor."},{"spoiler":false,"text":"While he was able to successfully follow them to the continent and rescue Miki, he was unable to stop her from becoming the new Demon King, and is now currently in search of a way to reverse it."},{"spoiler":false,"text":"A kendo champion in his home dimension, he is a naturally talented swordsman. He is the wielder of the Holy Sword Nikkou, one of two magical blades capable of piercing the invincibility fields that protect demons from conventional damage."}],"source":"vndb","sourceCharacterId":"c53096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c85f8970ba729d66f3821911454e368a1256cc335b23a17f090345277ae3313a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef1c56daa6507f7be0501a69b488b3581a0045202fd17c8144df9f2f2754c8ed.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c98285","characterName":"アーシー・ジュリエッタ","sourceIds":{"vndbCharacterId":"c98285"},"originalCharacterName":"アーシー・ジュリエッタ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Arcy Julietta is one of the apostles of the now deceased Dark Lord Burksham. Arcy is an individual of great renown due to her extraordinary ability to predict the future. She has an enthusiasm for delicious candy and travels around the world in search of the legendary \"candy maze.\" If met and given a piece of candy, she will predict one's future with 100% accuracy."},{"spoiler":false,"text":"Despite having once served a Dark Lord, Arcy never displays any antagonism towards humans. In fact, she has aided humans in all her appearances. She seems to primarily motivated by her appetite, while remaining pleasantly helpful."},{"spoiler":false,"text":"From AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c98285"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8ddbf4282ec490de5cd4d04e43c0da2376178bdcc9c6500fca22ee7325db53f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7acd6c06d5532fb1a15ef8f6a26db572bc73328e0eda3ed520fb383ca032dc97.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5246","sourceCompanyId":"egs:brand:5246","canonicalEntityId":"egs:brand:5246","name":"チャンピオンソフト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8282:5246","source":"egs"},{"companyId":"vndb:p11935","sourceCompanyId":"vndb:p11935","canonicalEntityId":"vndb:p11935","name":"BabaJeanmel","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:124462:v7360","source":"vndb"},{"companyId":"vndb:p15964","sourceCompanyId":"vndb:p15964","canonicalEntityId":"vndb:p15964","name":"Alpharobo","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:124463:v7360","source":"vndb"},{"companyId":"vndb:p2421","sourceCompanyId":"vndb:p2421","canonicalEntityId":"vndb:p2421","name":"チャンピオンソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native