ntityStatus":"source-native","relationId":"vndb:vn-staff:41667","source":"vndb"},{"creditedName":"ぴら","creatorId":"vndb:s26688","sourcePersonId":"vndb:s26688","canonicalEntityId":"vndb:s26688","name":"平松…ぴら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:41668","source":"vndb"}]},"cast":[{"characterId":"char_c22175","characterName":"外川 キミ江","sourceIds":{"bangumi":[{"characterId":"134707","match":"exact-normalized-name-in-linked-work","subjectId":"224412"}],"egsCharacterIds":["12910"],"vndbCharacterId":"c22175"},"originalCharacterName":"外川 キミ江","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"40"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mother of Jun and Mari, and sister of Yukiko."},{"spoiler":false,"text":"After the death of her husband, she is the deputy chief priestess and miko who runs the shrine. A miko is supposed to be an unmarried virgin, but she is still a miko."},{"spoiler":false,"text":"She always has a smile on her face, and although she is calm, she has a strong spirit. She has huge breasts and a huge ass. She is always being looked at and wooed by the male members of the shrine."},{"spoiler":false,"text":"She is devoted to her husband and does not pay attention to other men, but when her son returns after completing his training, he is transformed into a strong man, and her desire for him begins to grow."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c22175"},{"segments":[{"spoiler":false,"text":"主人公の母で、由紀子の姉。40歳。"},{"spoiler":false,"text":"亡くなった夫に代わって「君ヶ浜神社」を宮司兼巫女として切り盛りしている。"},{"spoiler":false,"text":"本来巫女は、未婚で処女を基本としているが、未だに巫女をやっている。"},{"spoiler":false,"text":"いつもほほ笑みを絶やさない、おっとりとしていて優しい女性。しかし芯は強い。"},{"spoiler":false,"text":"巨乳×巨尻の男好きする体形をしているため、氏子の男たちからエッチな視線を向けられ、言い寄られることもしばしば。"},{"spoiler":false,"text":"亡くなった夫一筋で他の男に目もくれなかったが、修行を終えて逞しくなって変えて来た息子に欲情してしまい……。"}],"source":"egs","sourceCharacterId":"12910","sourceWorkId":"13592","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢：40歳　スリーサイズ：B90/ W62/ H90"},{"spoiler":false,"text":"淳とマリの母で、由紀子の姉。"},{"spoiler":false,"text":"夫の死後、神社を切り盛りする宮司代理兼巫女。"},{"spoiler":false,"text":"本当は巫女は未婚の処女が基本だが、未だに巫女をやっている。"},{"spoiler":false,"text":"いつも笑みを絶やさず、おっとりしているが芯は強い。"},{"spoiler":false,"text":"巨乳と巨尻の持ち主で、氏子の男達から常に嫌らしい視線を向けられ、言い寄られている。"},{"spoiler":false,"text":"本人は夫一筋で他の男には目もくれないのだが、修行を終えて戻ってきた息子の、逞しい変貌ぶりに欲望が芽生えることに。"}],"source":"bangumi","sourceCharacterId":"134707"}],"profileFacts":[{"label":"年龄（本版本）","value":"40 岁","valueContext":null,"source":"egs","sourceCharacterId":"12910","sourceWorkId":"13592","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"12910","sourceWorkId":"13592","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"12910","sourceWorkId":"13592","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"12910","sourceWorkId":"13592","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5577e2d8d901d06058840d07fa65d63262f76c87a5c0d6ea2ff9be8deb0f441b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/687a365eaf9bcfad3dda5d5cea34cb8e686140c65f246b6b02405e1ca50c5043.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","