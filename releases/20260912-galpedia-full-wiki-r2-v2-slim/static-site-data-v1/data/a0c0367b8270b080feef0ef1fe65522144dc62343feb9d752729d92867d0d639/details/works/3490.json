,"sourceIds":{"vndbCharacterId":"c57052"},"originalCharacterName":"宇都妓 千夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"603"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm... useless?\""},{"spoiler":false,"text":"The younger brother of the producer \"Ichiya\". He is taciturn and poor at expressing his emotions, but his parents are musicians, and his singing and dancing skills are both superior to the other candidates."},{"spoiler":false,"text":"His older brother, Ichiya, forced him to enroll in a music school, saying, \"It would be a waste to let his talent be buried.\""},{"spoiler":false,"text":"Hobby: Reading"},{"spoiler":false,"text":"Favorite Food: Nothing special"},{"spoiler":false,"text":"Dislikes: Sweets"},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c57052"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53e0ec980b0ec3aa6002a6cb15ba00c18ce142e463c61a6d341a6f61d93b27ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f5620aa00d3a1671cdc1f715d738e93219799dc6ecf98ba8016509f2b0a3316.webp","width":250,"height":250,"source":"static-detail"},"actors":[{"creditedName":"福島 潤","creatorId":"vndb:s395","sourcePersonId":"vndb:s395","canonicalEntityId":"vndb:s395","name":"福島 潤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23819","source":"vndb"}]},{"characterId":"char_vndb_c57053","characterName":"栖堂 快人","sourceIds":{"vndbCharacterId":"c57053"},"originalCharacterName":"栖堂 快人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"120"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You're a weirdo.\""},{"spoiler":false,"text":"The reason he entered the school was to find his mother, who he had separated from when he was young. He hopes that she will see him on TV and magazines."},{"spoiler":false,"text":"He caught Ichiya's attention at a dance audition one night and entered the school as a scholarship student. Although he may be the most lively and cheerful person in school, his language is a little rough."},{"spoiler":false,"text":"Hobby: Dance, Soccer"},{"spoiler":false,"text":"Favorite Food: Dashi-rolled egg, steamed egg custard"},{"spoiler":false,"text":"Dislikes: Octopus"},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c57053"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c9de4b5adb7ec6454195cadcb2a08b4f43bd228f7e5577604b18ca91a133970.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a18e1befa7857cb51b343dceb1acad06087781ba2a7f2870c8fa906762c550a3.webp","width":250,"height":250,"source":"static-detail"},"actors":[{"creditedName":"児玉 さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23816","sourc