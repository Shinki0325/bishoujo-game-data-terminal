identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"303"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Miki's Ichiyaramon!\""},{"spoiler":false,"text":"Produced by Ichiya during his entertainment debut, he is now an active TV program host for children and a CM model. He thinks that if he works hard, he'll be able to stay by Ichiya's side. He thinks he's Ichiya's lover, but everyone around them thinks they have a parent-child relationship."},{"spoiler":false,"text":"His love rival is Ruka and they don't get along well. He speaks an incomprehensible language because he is not good at vocalization."},{"spoiler":false,"text":"Hobby: Billiards (Being hugged by Ichiya)"},{"spoiler":false,"text":"Likes: Ichiya, pudding, strawberry milk, rabbits"},{"spoiler":false,"text":"Dislikes: Carrots, ghosts"},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c112982"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94c8c66feea6f16c930bb0a477f7f0cc284d0b4d2078f06b446b99ceadbef2a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8529b8dc066e90be12fe55dca400306af84b622124d71b2d8d804b631c5abebc.webp","width":250,"height":250,"source":"static-detail"},"actors":[{"creditedName":"茶谷 やすら","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23818","source":"vndb"}]},{"characterId":"char_vndb_c57051","characterName":"緋月 瑠架","sourceIds":{"vndbCharacterId":"c57051"},"originalCharacterName":"緋月 瑠架","characterNameSource":null,"role":"primary","status":"sourc