"source":"bangumi","sourceCharacterId":"187841"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e78aa5e3e694ef53b0df1ac832a44ffc190384abd06dcbaa69c71f170f434b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd2975874a852261f3ce41306c48a7ea21ba4da07ccd87e6ef89489ba28eb841.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七種結花","creatorId":"vndb:s22881","sourcePersonId":"vndb:s22881","canonicalEntityId":"vndb:s22881","name":"佐藤 詩乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:539640:187841:56606:1","source":"bangumi"}]},{"characterId":"char_bangumi_187843","characterName":"めろん","sourceIds":{"bangumi":[{"characterId":"187843","match":"source-roster","subjectId":"539640"}]},"originalCharacterName":"めろん","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"----"},{"spoiler":false,"text":"夢吉原の外れで迷子になっていたあやかし遊女。夢吉原ではない、別のあやかし世界の出身。"},{"spoiler":false,"text":"大食漢で、人の精以外にも食事を摂る。"},{"spoiler":false,"text":"人見知りで性経験には乏しいものの、一生懸命に性技等を勉強し、一人前の遊女を目指す健気な遊女。"},{"spoiler":false,"text":"小柄な身体に見合わぬ大きな乳房と嗜虐欲を煽る所作で変態客層に大人気。"}],"source":"bangumi","sourceCharacterId":"187843"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3a1fddb747a9ceb2b2db15f2641532722dcd204aa281b558654d1f099c99626.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feabadc4f1ff9dc48fad895b93df993f9aa554aed88307d74b6fa042065fbb54.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"空賀花","creatorId":"vndb:s15476","sourcePersonId":"vndb:s15476","canonicalEntityId":"vndb:s15476","name":"空賀 花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:539640:187843:34089:1","source":"bangumi"}]},{"characterId":"char_bangumi_187844","characterName":"ひめの","sourceIds":{"bangumi":[{"characterId":"187844","match":"source-roster","subjectId":"539640"}]},"originalCharacterName":"ひめの","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"----"},{"spoiler":false,"text":"処女のまま太夫になることを夢見るギャル女郎蜘蛛。"},{"spoiler":false,"text":"『遊女でありながら処女を守り通す』という信念を持っている。"},{"spoiler":false,"text":"そんな信念のせいか紆余曲折あって大江山楼に。"},{"spoiler":false,"text":"処女を守り通す信念のため、どちらかというと自分主導で攻める方が得意。"},{"spoiler":false,"text":"そんなギャルでも、恋に恋する一途な乙女。"}],"source":"bangumi","sourceCharacterId":"187844"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa192884b8ee45549dd602954f1626362ffee537d818b7e0ee4c922d501cd673.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34ddcc31e97ef25b61905f9e001f7b0d11f14f195b415b4e789ee1532b0f6a36.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天知遥","creatorId":"vndb:s16012","sourcePersonId":"vndb:s16012","canonicalEntityId":"vndb:s16012","name":"天知遥","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:539640:187844:35180:1","source":"bangumi"}]},{"characterId":"char_bangumi_187846","characterName":"りんふぁ","sourceIds":{"bangumi":[{"characterId":"187846","match":"source-roster","subjectId":"539640"}]},"originalCharacterName":"りんふぁ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"----"},{"spoiler":false,"text":"ヤンデレ気味の、恋愛体質キョンシー娘。"},{"spoiler":false,"text":"もともとは香蛾屋という別の妓楼に所属していたが、わけあって大江山楼所属となった。"},{"spoiler":false,"text":"楼主である貴方と結んだ『ある約束』を果たすため、日々性技の研鑽に勤しむ。"},{"spoiler":false,"text":"盲目的な恋愛体質、一度惚れ込んだ相手は決して逃さない。"}],"source":"bangumi","sourceCharacterId":"187846"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2ba819f2edba28b0e8346d94d1eb78550ce8c83a65c19a5ff93754f28ead5bee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e476a768873a17f81db8ec6d051507a835fdb8a909770b7b76d69bf375c6d550.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小澤みのり","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:539640:187846:32659:1","source":"bangumi"}]},{"characterId":"char_bangumi_187848","characterName":"ハク","sourceIds":{"bangumi":[{"characterId":"187848","match":"source-roster","subjectId":"539640"}]},"originalCharacterName":"ハク","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"----"},{"spoiler":false,"text":"とある筋から預けられた、妖怪の中でも珍しい白蛇の遊女。"},{"spoiler":false,"text":"それなりに生きてて偉いはずだが偉そうでもなく、単なるわがまま無邪気なあやかし遊女。"}],"source":"bangumi","sourceCharacterId":"187848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b44af84819b4013e37539408969c2179038f20f7a0a01272f01c40e041382646.webp","fallbackUrl":"https://wiki