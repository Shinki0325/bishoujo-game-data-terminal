{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"24986","model":{"presentationWorkId":"egs:24986","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"Dite","creatorId":"egs:creator:30079","sourcePersonId":"egs:creator:30079","canonicalEntityId":"egs:creator:30079","name":"Dite","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"no-alias-hit","relationId":"egs:work-creator:182267","source":"egs"}]},"cast":[{"characterId":"char_bangumi_87801","characterName":"Edward Benett","sourceIds":{"bangumi":[{"characterId":"87801","match":"source-roster","subjectId":"316813"}]},"originalCharacterName":"Edward Benett","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"14"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"今作の主人公は、エドワード・ベネット（Edward Benett）です。"},{"spoiler":false,"text":"伯爵家の次男としての自覚が芽生えつつある優等生ですが、年相応の好奇心を持った14歳の少年です。"},{"spoiler":false,"text":"普段はロンドンの全寮制パブリックスクール、トラオム・カレッジで生活をしていますが、長期休暇で帰省したら、魔法使いの兄・ヒューによって騙し絵に変化してしまった屋敷に足を踏み入れてしまいました。"},{"spoiler":false,"text":"魔法使いで実業家でもある兄のヒューを尊敬し、同じ寮で生活する上級生のミヒャエルやベネット家を担当している高級百貨店の外商のケンを兄のように慕っています。"},{"spoiler":false,"text":"実家の屋敷で飼っている猫のジェラルドをとても可愛がっています。"}],"source":"bangumi","sourceCharacterId":"87801"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_bangumi_87802","characterName":"Hugh Benett","sourceIds":{"bangumi":[{"characterId":"87802","match":"source-roster","subjectId":"316813"}]},"originalCharacterName":"Hugh Benett","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エドワードの兄で、屋敷の一部を騙し絵に変えた張本人です。"},{"spoiler":false,"text":"幼少期よりとても強い魔法の力を持つ魔法使いですが、"},{"spoiler":false,"text":"20代の若さながらベネット家の長男として、父や親戚からいくつかの事業を引き継いでいる優秀な実業家でもあります。"},{"spoiler":false,"text":"非常に多忙で一年のほとんどを海外で過ごし、屋敷にいても仕事や魔法の研究であまり部屋から出てこない日も……"},{"spoiler":false,"text":"少年期は、現在エドワードが学ぶトラオム・カレッジに入学しましたが、一年ほどで日本の魔法学校に転学をしました。"},{"spoiler":false,"text":"魔法学校を卒業後は、またイギリスに戻り、魔法専門ではない一般の名門大でビジネスを学び、優秀な成績で卒業し、今に至ります。"},{"spoiler":false,"text":"エドワードとの兄弟仲は良く、飼い猫のジェラルドとは会話が出来ます。"},{"spoiler":false,"text":"ベネット家担当のケンのことは優秀な外商だと思っています。"}],"source":"bangumi","sourceCharacterId":"87802"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_bangumi_87803","characterName":"エドウィーナ","sourceIds":{"bangumi":[{"characterId":"87803","match":"source-roster","subjectId":"316813"}]},"originalCharacterName":"エドウィーナ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"エドワードが騙し絵の空間に入り込んでしまった時の姿。"},{"spoiler":false,"text":"身体は少女ですが、中身はエドワードのままなので彼は自身を“エドワード”と名乗りますが、騙し絵の空間で出会うとある人物は彼を“エドウィーナ（Edwina）”と呼ぶ。"}],"source":"bangumi","sourceCharacterId":"87803"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_bangumi_87804","characterName":"ミヒャエル・ステュアート","sourceIds":{"bangumi":[{"characterId":"87804","match":"source-roster","subjectId":"316813"}]},"originalCharacterName":"ミヒャエル・ステュアート","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_bangumi_87805","characterName":"ケン・オコナー","sourceIds":{"bangumi":[{"characterId":"87805","match":"source-roster","subjectId":"316813"}]},"originalCharacterName":"ケン・オコナー","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metada