ntityStatus":"source-native","relationId":"vndb:vn-staff:35178","source":"vndb"},{"creditedName":"株式会社ポイント・ピクチャーズ","creatorId":"vndb:s5820","sourcePersonId":"vndb:s5820","canonicalEntityId":"vndb:s5820","name":"株式会社ポイント・ピクチャーズ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:35183","source":"vndb"},{"creditedName":"kanoko","creatorId":"vndb:s43203","sourcePersonId":"vndb:s43203","canonicalEntityId":"vndb:s43203","name":"kanoko","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:35185","source":"vndb"}]},"cast":[{"characterId":"char_c1117","characterName":"星野 真珠","sourceIds":{"bangumi":[{"characterId":"147294","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25815"],"vndbCharacterId":"c1117"},"originalCharacterName":"星野 真珠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う二年生。主人公の幼馴染にして、親友。"},{"spoiler":false,"text":"主人公の古武道の老先生の孫娘であり、その腕前は免許皆伝レベルの達人。"},{"spoiler":false,"text":"根っからの格闘好きで、学園でも合気道をはじめとする様々な武道系の部活に在籍している。"},{"spoiler":false,"text":"自分の腕を試したいという理由から、学園格斗選挙会、通称“学斗”へ参加。"}],"source":"egs","sourceCharacterId":"25815","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の二年生。主人公セイジの幼馴染で、恋人ではなく、親友。セイジが習った古武道の老先生の孫娘であり、真面目に修行したその腕前は免許皆伝レベルの達人。根っからの格闘少女で、学園でも合気道を初め各種の武道系部に在籍している。今回は、楽しそうだから、もしくは腕を試したいからという理由で学斗にエントリー。"}],"source":"bangumi","sourceCharacterId":"147294"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/953208018d54c06c659ace20e4e63b561cc7de500f63ebf205dcfc9500974aef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2df474661ad408f486f96beaa9bb4e4653e1917f911f29a23efcb933fb21ab1b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147294:4490:1","source":"bangumi"}]},{"characterId":"char_c1118","characterName":"胡桃沢 つくし","sourceIds":{"bangumi":[{"characterId":"147299","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25818"],"vndbCharacterId":"c1118"},"originalCharacterName":"胡桃沢 つくし","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う一年生。陸上部に所属。"},{"spoiler":false,"text":"得意種目はハンマー投げだが、まっすぐ飛ばせられれば記録的な飛距離を誇るものの、コントロールが異常に悪いため、トラック競技に回されている。"},{"spoiler":false,"text":"ブルマーと体操服をこよなく愛し、その普及こそが自分の使命と燃えている。"},{"spoiler":false,"text":"そのブルマー＆体操服を全女子生徒の制服として義務付けるべく、その校則改正を目論み、“学斗”に参加。"}],"source":"egs","sourceCharacterId":"25818","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の一年生。陸上部所属。得意種目はハンマー投げで、正面にさえ飛べば記録級の飛距離を誇るが異常にコントロールが悪く、危なくてしょうがないので普段はトラック種目の選手をやっている。なぜかブルマ体操服をひどく愛好し、その普及こそが自分の使命と考えている。ブルマ体操服を全女子生徒の制服に、という校則を制定するため、今回の学斗に参加。"}],"source":"bangumi","sourceCharacterId":"147299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a325bc83dcbfd3d2dcc105a4590ae934b84e0e97c4c86d86c045a44c8fc70eda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e80cc70c300ae772bc40c99da6d5e0ddac47a792f2ffa6c3b6458922ddf6f68.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147299:6106:1","source":"bangumi"}]},{"characterId":"char_c1119","characterName":"進藤 ちせ","sourceIds":{"bangumi":[{"characterId":"147300","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25819"],"vndbCharacterId":"c1119"},"originalCharacterName":"進藤 ちせ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う一年生。スク水シンクロナイズドスイミング部に所属。"},{"spoiler":false,"text":"幼い頃からスク水とシンクロに憧れ、その二つの夢を実現させたこの部の活動を守るべく、日夜、頑張っている（？）。"},{"spoiler":false,"text":"そのため、普段からスク水とプールタオル姿で校内をウロウロしている。"},{"spoiler":false,"text":"“学斗”参加の理由もスク水を女子生徒の制服として義務付けるためで、その主張は一部男子学生から熱狂的な支持を受けているらしい。"}],"source":"egs","sourceCharacterId":"25819","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の一年生。スク水シンクロナイズドスイミング部所属。普段から校内をスクール水着とプールタオル姿でウロウロしている。幼いころからシンクロとスク水に憧れていたちせは、二つの夢を実現させたこの部の活動を守るためならどのような困難も厭わない。学斗出場の動機は、スク水を女子生徒の制服にするためで、その主張は一部の男子生徒から熱烈な支持を受けている。"}],"source":"bangumi","sourceCharacterId":"147300"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/6037cfc44eb927f6e2e8d3da173a593a0e1494c685abc0fa1fbee424a4c2da30.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c474bac79748da856c7810888a0658a0cbf7713bc9e7903497d49de5cbbf966c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147300:6409:1","source":"bangumi"}]},{"characterId":"char_c1120","characterName":"諏訪 あゆ美","sourceIds":{"bangumi":[{"characterId":"147296","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25816"],"vndbCharacterId":"c1120"},"originalCharacterName":"諏訪 あゆ美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う三年生。"},{"spoiler":false,"text":"10万人の生徒が暮らす学園の自治を一人で切り盛りする現職の生徒会長。"},{"spoiler":false,"text":"今回の“学斗”の発起人でもある。"},{"spoiler":false,"text":"智謀の冴える才媛だが、運動神経はゼロに等しく、その体力不足を補うため、主人公に共闘を持ちかけてくる。"}],"source":"egs","sourceCharacterId":"25816","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の三年生。今回の学斗の発起人である現職の生徒会長。10万人の生徒が暮らすこの学園の自治を切り盛りする才女で、溢れ出るような智謀の持ち主だが、運動神経はゼロ。自分の体力不足部分を補うため、セイジに学斗での共闘を持ちかけてくる。そんなあゆ美の計算では、すでにこの学斗の勝利者は決まっているらしい。"}],"source":"bangumi","sourceCharacterId":"147296"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6a99069c0a0575202e71e367f82bf3424b324258e8671063a7559a40b397c31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8f1e23384a0387c2251867db9884c9dfee26182fc97c47cc7fb890487138f5b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147296:4956:1","source":"bangumi"}]},{"characterId":"char_c1121","characterName":"伊則 千早","sourceIds":{"bangumi":[{"characterId":"147303","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25822"],"vndbCharacterId":"c1121"},"originalCharacterName":"伊則 千早","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う一年生。新聞部に所属。"},{"spoiler":false,"text":"動きやすくデザインされた改造制服を振り乱しながら、いつもうるさく校内を走り回り、ネタを集めている。"},{"spoiler":false,"text":"今回の“学斗”のバトルの状況をいち早く生徒たちに伝えるべく、参加者たちに張り付いている。"},{"spoiler":false,"text":"参加者たちにとっては、はた迷惑な女の子。"}],"source":"egs","sourceCharacterId":"25822","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の一年生。学園内をいつもうるさく走り回っている新聞部員。短く切った活動的な髪と、動きやすくデザインされた改造制服がトレードマーク。学斗には参加していないが、そのバトルの状況をいち早く生徒に伝えるため参加者たちに張り付いている、お邪魔虫。"}],"source":"bangumi","sourceCharacterId":"147303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01f89309a8d5205b785956b749a6892f60abef6a0902a0705365f169d0e22c1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/513c2b028db685222b06858de1375892be6ab7148bc5ea32ab04c78c2ca5e5cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147303:4463:1","source":"bangumi"}]},{"characterId":"char_c1122","characterName":"山賀 鏡子","sourceIds":{"bangumi":[{"characterId":"147304","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25823"],"vndbCharacterId":"c1122"},"originalCharacterName":"山賀 鏡子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う三年生。バスケットボール部に所属。"},{"spoiler":false,"text":"健康的にして魅力的なボディラインに男子生徒たちの視線をくぎ付けにするも、姉御肌で男っぽい言動から女子学生のファンも多い。"},{"spoiler":false,"text":"現生徒会長のあゆ美とは旧知の仲だが、現在は互いに反目している。"},{"spoiler":false,"text":"自ら学内の自治を正すべく“学斗”に参加。"}],"source":"egs","sourceCharacterId":"25823","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の三年生。バスケット部部長。アネゴ肌で男っぽい言動から学園内に女子生徒ファン多数。その魅力的なボディラインに男子生徒ファンも多数だが、そういう安っぽい男は眼中に無い。最近の風紀委員の横暴に不満があったため、自ら学内の自治を正すべく学斗に参加。現生徒会長のあゆ美とは旧知の仲だが、互いに反目している。実力を隠しているセイジの能力をちゃんと見抜いていて、セイジに一目置いている、学園内で数少ない人物の一人。"}],"source":"bangumi","sourceCharacterId":"147304"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/162a6fe74cefa505a50aed3cb6284f198f64af2959fd87e869a4f0ddacb743e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27b8bd09c27bcd772e4b46b0d256deb14880d994baccddb2d79a8096651e4981.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"すずき けいこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147304:6275:1","source":"bangumi"}]},{"characterId":"char_c1125","characterName":"近衛 麗華","sourceIds":{"bangumi":[{"characterId":"147301","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25820"],"vndbCharacterId":"c1125"},"originalCharacterName":"近衛 麗華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う二年生。総合格闘部所属。"},{"spoiler":false,"text":"真珠の流派とライバル関係にある、古流の柔術の家柄のお嬢様。"},{"spoiler":false,"text":"真珠をライバル視し、他の“学斗”候補者たちなどには目も暮れず、常に主人公と真珠に戦いを挑んでくる。"},{"spoiler":false,"text":"実家は大財閥で、この全寮制の学園でも特別待遇を受けている。"}],"source":"egs","sourceCharacterId":"25820","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の二年生。総合格闘部所属。真珠の流派とライバル関係にある、古流の柔術の家柄のお嬢様。当然、真珠をライバル視していて、他の学斗立候補者などアウト・オブ・眼中。常にセイジと真珠に戦いを挑んでくる。また実家は大財閥でもあり、全寮制の学園内でも特別な部屋に暮らし、特別な生活をしている。"}],"source":"bangumi","sourceCharacterId":"147301"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee683840e6ec8cec5bca643c7d8c7a9ec61aafffb386ae4aecdac88bab43cc07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/288912a5615bc3457e0686e23375080d4611f4f27075ef7b52d0db7e1001cf2c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147301:18086:1","source":"bangumi"}]},{"characterId":"char_c1126","characterName":"岬 静流","sourceIds":{"bangumi":[{"characterId":"147305","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25824"],"vndbCharacterId":"c1126"},"originalCharacterName":"岬 静流","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う三年生。真剣道部に所属。"},{"spoiler":false,"text":"常に日本刀（＝真剣）を帯刀し、学園の森の奥にある剣道場で、独り技を磨く孤高の女剣士。"},{"spoiler":false,"text":"大和撫子のように淑やかな美しさを持つが、その性格は沈着冷静で、多感な若い女性ながら、何処か達観しているような風情を漂わせている。"},{"spoiler":false,"text":"学内の揉め事に無関心の彼女が、何故、私欲を孕んだ“学斗”に参加を表明したのか、その理由は誰にもわからない。"}],"source":"egs","sourceCharacterId":"25824","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の三年生。真剣道部所属。学園の森の奥にある剣道場で、独り技を磨く孤高の剣士。氷のような美貌を持った美人で、常に日本刀を携帯し、戦いになったら誰も敵わない。生徒でありながら世捨て人同然で、学園内の揉め事に関心が無いはずの静流だが、何故か今回の学斗に参加を表明した。固い決意を胸に戦いに挑むが、その動機は誰にもわからない。もちろん優勝候補NO．1。"}],"source":"bangumi","sourceCharacterId":"147305"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b06beabf3b5d1b3659f816b1616559ef27a299317c17b60661713e55f3b3bb49.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b134490342d02a901e8e1bcfcaa452a3e26b8942a30867f8420afe28a3dc06f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147305:24747:1","source":"bangumi"}]},{"characterId":"char_c1127","characterName":"西田 メアリ","sourceIds":{"bangumi":[{"characterId":"147298","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25817"],"vndbCharacterId":"c1127"},"originalCharacterName":"西田 メアリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園に通う一年生。新体操部に所属。"},{"spoiler":false,"text":"選挙管理委員として、今回の“学斗”の立会役を務め、主人公や他の参加者たちの言動を監視している。"},{"spoiler":false,"text":"病気のために休学していたらしく、最近復学したとの噂が……。"},{"spoiler":false,"text":"一年生にして責任重大の選挙管理委員に抜擢されたのは、何か特別な理由があるらしいが……。"}],"source":"egs","sourceCharacterId":"25817","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の一年生。新体操部員。選挙管理委員でもあり、今回の学斗の立会役として、セイジや他の参加者の言動を監視している。一年生ではあるが、以前から病気のために休学していて、最近復学した生徒であるという噂がある。一年生であるにもかかわらず責任の重い選挙管理委員を務めているのは、そういう何か特別な理由があるかららしい。"}],"source":"bangumi","sourceCharacterId":"147298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b91ed8840428d09a3112b44e4b274adf7235c31b055e6ffafc32441df1c73752.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c80405022e4275ddc0f025d812341ce83a3d652d8e2de445d8691861d9a353f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189186:147298:4675:1","source":"bangumi"}]},{"characterId":"char_c1128","characterName":"京極 薫子","sourceIds":{"bangumi":[{"characterId":"147302","match":"exact-normalized-name-in-linked-work","subjectId":"189186"}],"egsCharacterIds":["25821"],"vndbCharacterId":"c1128"},"originalCharacterName":"京極 薫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"御朱雀学園の養護教諭。"},{"spoiler":false,"text":"穏やかな天然ボケ気味の性格だが、それに似合わぬナイスバディと美脚の持ち主。"},{"spoiler":false,"text":"さらには学園の卒業生で、過去の“学斗”において優勝を経験している猛者。"},{"spoiler":false,"text":"主人公は、彼女に怪我の治療などでお世話になっていることから、頭があがらない。"}],"source":"egs","sourceCharacterId":"25821","sourceWorkId":"7151","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の保険医。穏やかで天然ボケ気味な性格と、それに似合わぬナイスバディ＆美脚の持ち主。怪我の治療などで普段からお世話になっているため、学園内でセイジが頭の上がらない唯一の人。薫子自身もこの学園の卒業生であり、過去の学斗での優勝経験者。今は毎日賑やかに、騒がしく過ごす生徒たちの姿を眩しそうに見守っている。"}],"source":"bangumi","sourceCharacterId":"147302"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55dfd9ca45bd40a5c72aaaca95a8f0f9d13b791504a6dc927a37314de42f4fc5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charac