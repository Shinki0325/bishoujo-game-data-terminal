","sourcePersonId":"vndb:s13205","canonicalEntityId":"vndb:s13205","name":"吉野 ミケ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26428","source":"vndb"},{"creditedName":"casper","creatorId":"vndb:s19229","sourcePersonId":"vndb:s19229","canonicalEntityId":"vndb:s19229","name":"casper","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26429","source":"vndb"},{"creditedName":"にくきゅう","creatorId":"vndb:s32381","sourcePersonId":"vndb:s32381","canonicalEntityId":"vndb:s32381","name":"にくきゅう","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26430","source":"vndb"},{"creditedName":"夜叉","creatorId":"vndb:s42137","sourcePersonId":"vndb:s42137","canonicalEntityId":"vndb:s42137","name":"夜叉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26431","source":"vndb"},{"creditedName":"有限会社アプサラス","creatorId":"vndb:s45044","sourcePersonId":"vndb:s45044","canonicalEntityId":"vndb:s45044","name":"有限会社アプサラス","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26432","source":"vndb"}]},"cast":[{"characterId":"char_c54796","characterName":"アイリ","sourceIds":{"bangumi":[{"characterId":"136633","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136633","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25470"],"vndbCharacterId":"c54796"},"originalCharacterName":"アイリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl adopted into the royal family who has grown up with Al. She is the first in line candidate for marrying Al and calls him 'Onii-sama' because they grew up together."}],"source":"vndb","sourceCharacterId":"c54796"},{"segments":[{"spoiler":false,"text":"主人公の国の姫君。"},{"spoiler":false,"text":"父王の養女で、父王の親友の娘らしいが詳細は不明。"},{"spoiler":false,"text":"主人公とは幼い頃から一緒で、彼女にとって主人公は「兄」のような存在。"},{"spoiler":false,"text":"誰にでも優しく、楚々とした可憐なお姫様で、主人公や王など比ではない程、国民からの支持が高く、他国からも絶賛されている。"},{"spoiler":false,"text":"ヒーリング系の魔法を得意とする魔法の使い手でもある。"}],"source":"egs","sourceCharacterId":"25470","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"自国の姫君。"},{"spoiler":false,"text":"父王が親友の娘を養女として引き取り、主人公と兄妹同然に育てられた。"},{"spoiler":false,"text":"優しく慈愛に満ち溢れた彼女は、国民から、王や主人公とは比較にならないほど絶大な支持を得ており、それは敵対する他国においても変わらない。"},{"spoiler":false,"text":"現在は主人公の妻として、他の姫君たちと甘く幸せな生活を営んでいる。"},{"spoiler":false,"text":"民の声を聞き、それを宮廷で進言するなど内政面でも活躍している。"},{"spoiler":false,"text":"幼い頃から魔法も嗜んでおり、火や水の魔法を操る。"}],"source":"egs","sourceCharacterId":"25470","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"自国の姫。父王の養女である。父王の親友の娘らしいが詳細は明らかでない。魔法（ヒーリング系）の使い手でもある。幼い時から主人公と一緒にいるので主人公の事をお兄様と呼び慕っている。"},{"spoiler":false,"text":"しおらしく、清楚で可憐で美しい。優しく誰もから愛されるこの姫は、国のヒロインであり、主人公や王など比ではない程の人望を持っている。また、敵対する他国などでもこの姫だけは例外で人気が高い。"}],"source":"bangumi","sourceCharacterId":"136633"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23d4b18c1043d60fad3f606d3de6fa3583fe9eef40c1d9658032dadcc8551b9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81ea4da743c5b83afdd5bc41403c58adde421b83d68334a41eecf6fda5aa0cd0.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石松千恵美","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218143:136633:4273:1","source":"bangumi"}]},{"characterId":"char_c54797","characterName":"かぐや","sourceIds":{"bangumi":[{"characterId":"136634","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136634","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25472"],"vndbCharacterId":"c54797"},"originalCharacterName":"かぐや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遠い東方の国の姫君。"},{"spoiler":false,"text":"彼女の国は、非常に商業が盛んな経済大国として世界的に有名。"},{"spoiler":false,"text":"幼さを残す容姿ではあるが、さすがは一国の姫君という気品を感じさせる。"},{"spoiler":false,"text":"性格は、物静かでおっとりしているが、時折、物事をズバッと射抜くところも。"},{"spoiler":false,"text":"彼女には「巫女」としての力があり、神聖な存在として祀られている。"},{"spoiler":false,"text":"また彼女には小鳥と会話する不思議な力がある。"}],"source":"egs","sourceCharacterId":"25472","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の国から東に遠く離れた商業に秀でた国の姫君。"},{"spoiler":false,"text":"幼さを残す容姿ではあるが、さすがは一国の姫君という気品を感じさせる。"},{"spoiler":false,"text":"性格は、物静かでおっとりしているが、時折、物事をズバッと射抜くところも。"},{"spoiler":false,"text":"彼女には「巫女」としての力があり、神聖な存在として祀られている。"},{"spoiler":false,"text":"また彼女には動物と会話する不思議な力がある。"},{"spoiler":false,"text":"彼女を妻として娶ってからは、主人公の国と彼女の国の貿易が盛んになり、経済援助も得られるようになった。"}],"source":"egs","sourceCharacterId":"25472","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"遠い東の国の姫。商業に関しては右に出るものがなく、頭も良い民族であることは世界的に有名である。また、この姫は巫女の能力を持ち国の神聖な人物として祀られている。主人公とは面識がなく、父の言いつけでここに来た。"},{"spoiler":false,"text":"見た目は若干幼いが黒い髪が美しく品がある。性格はおっとりとしたボケ系なので少しトロいところもあるが、物事をズバッと言うところもある。打解けると、意外にアグレッシブな性格であることがわかるかも。小鳥と話せる特殊能力を持っている。"}],"source":"bangumi","sourceCharacterId":"136634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30e9a5d2f63300faad73b7fb136619665e70cca6597f5c78a53330ef48069e22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb43df4384aee9ab6d47c96ac4484c80a537cecef37976e26204e30fd32f23fb.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"〆野潤子","creatorId":"vndb:s5676","sourcePersonId":"vndb:s5676","canonicalEntityId":"vndb:s5676","name":"〆野 潤子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218143:136634:5080:1","source":"bangumi"}]},{"characterId":"char_c54798","characterName":"シャルロット","sourceIds":{"bangumi":[{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218144"},{"characterId":"136635","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25471"],"vndbCharacterId":"c54798"},"originalCharacterName":"シャルロット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"武力に秀でた国の姫君。"},{"spoiler":false,"text":"姫将軍と謳われる誇り高き戦士の彼女は国民的な英雄であり、その名声は他国にも轟いている。"},{"spoiler":false,"text":"主人公とは面識はなく、また主人公の性格や態度にも、あからさまな不快感を示す。"},{"spoiler":false,"text":"それは彼女自身が、何も知らされないままこの国に連れて来られ、いきなり主人公の妃候補に祭り上げられたことへの怒りを持っているからだ。"},{"spoiler":false,"text":"また主人公とは正反対の性格の許婚もおり、怒りの治まらない彼女は、さっさと国へ戻り、兵をあげて主人公の国へ攻め込むつもりでいるようだ。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"シリーズ最初の『いじってプリンセス』で初登場したプリンセス。"},{"spoiler":false,"text":"以降のシリーズでもその誇り高き姿は健在だが、現在はそのトレードマークである甲冑を脱ぎ捨て主人公の妻として、甘い生活をおくっている。"},{"spoiler":false,"text":"それでもこれまでと変わらず、日々の鍛錬を怠ることなく、主人公の国の軍事力強化にも大いに貢献している。"},{"spoiler":false,"text":"しかし、元許婚の陰謀に巻き込まれてしまい……。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"7299","spoiler":false},{"segments":[{"spoiler":false,"text":"武力の国・ガルランディアの出身の誇り高き姫将軍。"},{"spoiler":false,"text":"最初こそ主人公を毛嫌いしていたが、その心根に触れ、主人公を愛するようになる。"},{"spoiler":false,"text":"現在は、主人公との妻として城で甘い生活を送っているが、日々の鍛錬は怠らず、その剣術の腕前はまったく衰えていない。"},{"spoiler":false,"text":"また彼女が、この国の軍事力強化に大いに貢献していることは間違いなく、兵士たちの錬度は著しく向上している。"},{"spoiler":false,"text":"各国にその名を轟かせる武勇の彼女は、近接攻撃においては無類の強さを発揮し、欠点も少なく、戦場においては最も頼りになる存在。"}],"source":"egs","sourceCharacterId":"25471","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"武力の国で名を馳せた姫将軍。国民的英雄で他国にもその名声は高い。"},{"spoiler":false,"text":"主人公とは面識はないが、主人公の性格や態度が大嫌い。主人公とまったく正反対の許婚がいる。"},{"spoiler":false,"text":"ある意味だまされて来ているので、この国を憎んでいる。国に帰ったらすぐに攻め込む気でいる。誇り高い戦士。"}],"source":"bangumi","sourceCharacterId":"136635"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f470cdd3ce92707f6ca8d5d52a6dade2177f5c2179e58a4f20aa8d6ec2da4be6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12439b7bbacac27ac770d19d3f23f753ce7084ecbce4df5266fe9e5acfed226d.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小橋知子","creatorId":"vndb:s2331","sourcePersonId":"vndb:s2331","canonicalEntityId":"vndb:s2331","name":"小橋 知子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218143:136635:5224:1","source":"bangumi"}]},{"characterId":"char_c54799","characterName":"ニーナ","sourceIds":{"bangumi":[{"characterId":"136636","match":"exact-normalized-name-in-linked-work","subjectId":"218143"},{"characterId":"136636","match":"exact-normalized-name-in-linked-work","subjectId":"218148"}],"egsCharacterIds":["25476"],"vndbCharacterId":"c54799"},"originalCharacterName":"ニーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とある貧しい国の姫君だったが、主人公の国に攻め滅ぼされ、現在はメイドとして主人公の身の回りの世話をしている。"},{"spoiler":false,"text":"彼女の国は、国民が常に明るく太陽の国と呼ばれ、そのためか、彼女自身も明朗快活で、いつも笑顔を絶やさず、常にポジティブ思考。"}],"source":"egs","sourceCharacterId":"25476","sourceWorkId":"3770","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の国に責め滅ぼされた貧しい国の姫君。"},{"spoiler":false,"text":"現在は主人公の身の回りの世話をするメイドになっている。"},{"spoiler":false,"text":"彼女の国は、国民が常に明るく太陽の国と呼ばれ、そのためか、彼女自身も明朗快活で、いつも笑顔を絶やさず、常にポジティブシンキング。"},{"spoiler":false,"text":"現在も主人公のメイドとして甲斐甲斐しくお世話をしている。"}],"source":"egs","sourceCharacterId":"25476","sourceWorkId":"7713","spoiler":false},{"segments":[{"spoiler":false,"text":"昔、攻め落とした国の貧乏な国の姫らしい。その国は太陽の国と言われ国民は常に明るかった。そのためなのか、彼女の性格は元気があって活発。つねに前向き思考。"},{"spoiler":false,"text":"現在はこの国のメイドさんで主人公のお世話をしている。"}],"source":"bangumi","sourceCharacterId":"136636"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de634702da951882dbea561c346fbca67f95aa7f98b602e2f28840af653fc1cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bf9c0e767e7d56d290fd7443f8afa7d5453990ae63ead190474f3c5e747ef25.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南川のりこ","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218143:136636:20327:1","source":"bangumi"}]},{"characterId":"char_vndb_c54795","characterName":"アル","sourceIds":{"vndbCharacterId":"c54795"},"originalCharacterName":"アル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The prince of the kingdom. His father the king instructs him to choose a bride for the sake of his country and sends him the maid Niina to prepare him. He doesn't 