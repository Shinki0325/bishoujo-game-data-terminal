onId":"vndb:s23184","canonicalEntityId":"vndb:s23184","name":"ちゃた","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:84911","source":"vndb"},{"creditedName":"ちゃた","creatorId":"vndb:s23184","sourcePersonId":"vndb:s23184","canonicalEntityId":"vndb:s23184","name":"ちゃた","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:84912","source":"vndb"},{"creditedName":"槙野 明","creatorId":"vndb:s53953","sourcePersonId":"vndb:s53953","canonicalEntityId":"vndb:s53953","name":"槙野 明","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:84914","source":"vndb"}]},"cast":[{"characterId":"char_c14555","characterName":"乃木坂 水輝","sourceIds":{"bangumi":[{"characterId":"64036","match":"exact-normalized-name-in-linked-work","subjectId":"36152"}],"egsCharacterIds":["826"],"vndbCharacterId":"c14555"},"originalCharacterName":"乃木坂 水輝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend, who goes to wake up the protagonist, every morning."},{"spoiler":false,"text":"Recognizes the protagonist as a friend but it has not reached the level of romantic interest."},{"spoiler":false,"text":"Has a cute appearance while being concealed in the school, is still popular. The person herself, is not very interested in the matters of love."},{"spoiler":false,"text":"Has a very good personality. Interacts normally with the useless protagonist as well."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c14555"},{"segments":[{"spoiler":false,"text":"主人公が毎朝起こしに行く、幼馴染の女の子。"},{"spoiler":false,"text":"主人公とは初期段階で恋愛にはちょっと遠い幼馴染（友達としか見てない）。"},{"spoiler":false,"text":"学園でも可愛らしく隠れた人気があるのだが、あまり、恋愛ごとには興味がない様子。"},{"spoiler":false,"text":"性格は、すっごい良い子、良い子良い子すぎて、主人公なんかにも普通に対応してくれていた"},{"spoiler":false,"text":"（だからこそ、主人公を恋愛対象にみていなかった感はある）。"}],"source":"egs","sourceCharacterId":"826","sourceWorkId":"16304","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が毎朝起こしに行く、幼なじみの女の子。"},{"spoiler":false,"text":"主人公とは友達という認識をもっていて、恋愛対象には至っていない。"},{"spoiler":false,"text":"可愛らしい容姿で学園でも隠れた人気があるのだが、本人はあまり恋愛ごとには興味がない様子。"},{"spoiler":false,"text":"性格は良い子過ぎて、だめだめな主人公にも普通に対応してくれる。"}],"source":"bangumi","sourceCharacterId":"64036"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/920884c017fbc6b7dcf08a35168f5ca70b5187bb5070e851b288c1838df05085.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77d03fd189e4807eb573f3bd81f7c287cb4dad22a3ece4ed46a4005741dff6d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:36152:64036:5939:1","source":"bangumi"}]},{"characterId":"char_c14557","characterName":"青山 琴春","sourceIds":{"bangumi":[{"characterId":"64037","match":"exact-normalized-name-in-linked-work","subjectId":"36152"}],"egsCharacterIds":["827"],"vndbCharacterId":"c14557"},"originalCharacterName":"青山 琴春","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Younger sister of the protagonist. Goes to the same school, as an underclassman."},{"spoiler":false,"text":"Her relationship with her older brother is not very good, a bit like cold war."},{"spoiler":false,"text":"Actually loves the protagonist very much and doesn't want to hand him over to any other woman."},{"spoiler":false,"text":"Is childhood friends with Miki but due to the case of her older brother, has become somewhat estranged with her."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c14557"},{"segments":[{"spoiler":false,"text":"主人公の妹で同じ学園の下級生。"},{"spoiler":false,"text":"主人公との仲はあまり良くなく、やや冷戦中である。"},{"spoiler":false,"text":"昔は主人公のことが大好きだったのだが、今では、どこにだしても恥ずかしい兄になっており、毎日もやもやしている。"},{"spoiler":false,"text":"現在の心境は部屋にも入ってきて欲しくないＬＶの反抗期状態。"},{"spoiler":false,"text":"学園で会っても「私のことは、かまわないで！」・・・って感じである。"}],"source":"egs","sourceCharacterId":"827","sourceWorkId":"16304","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹で、同じ学園に通う下級生。"},{"spoiler":false,"text":"兄との仲はあまり良くなく、やや冷戦気味。"},{"spoiler":false,"text":"現在の心境は部屋にも入ってきてほしくないレベルの反抗期状態。"},{"spoiler":false,"text":"本心では主人公のことが大好きで、他の女に渡したくないという気持ちでいっぱい。"},{"spoiler":false,"text":"水輝とは幼なじみだが、兄の件もありやや疎遠になっている。"}],"source":"bangumi","sourceCharacterId":"64037"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da3ae89a8a70fecfe1edf6dfb0abec61650a6b4b0fd729978b0c4af6bfa83c48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/531cdaa65efe2f99cebe5418ba726427179cfe17884850f33b8cf9406bbe77d1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:36152:64037:5906:1","source":"bangumi"}]},{"characterId":"char_c14559","characterName":"汐留 日彩","sourceIds":{"bangumi":[{"characterId":"64038","match":"exact-normalized-name-in-linked-work","subjectId":"36152"}],"egsCharacterIds":["828"],"vndbCharacterId":"c14559"},"originalCharacterName":"汐留 日彩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A classmate belonging to the same class as the protagonist, at the school."},{"spoiler":false,"text":"A girl admired by everyone, having a good nature and beautiful."},{"spoiler":false,"text":"There was no gap between her outer and inner self, kind of a superwoman. Due to her specifications being so high, she was not seen as an object of romantic interest by anyone."},{"spoiler":false,"text":"Actually, has no romantic experience and knowledge regarding it, is scarce."},{"spoiler":false,"text":"She is under the impression that she has no charms as a woman."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c14559"},{"segments":[{"spoiler":false,"text":"学園の同じクラスの同級生。"},{"spoiler":false,"text":"みんなの憧れの女の子で気立ても良く美人（可愛い＆美人の感じ）。"},{"spoiler":false,"text":"観察眼が優れている（気がきく）からか、普段から接点のない主人公の変化にも気が付くタイプ。"},{"spoiler":false,"text":"外面も内面も隙のない完璧超人（学業・運動完璧で性格は、嫌味ない性格で男女ともに人気がある）。"},{"spoiler":false,"text":"彼女の周りにはいつも人だかりが（人望ゆえ）。"},{"spoiler":false,"text":"だが、美人＆能力が高すぎて（ハイレベルな高嶺の花ってやつ）誰からも恋愛対象とは見られていない。"},{"spoiler":false,"text":"恋愛経験も皆無で、知識も乏しい。"},{"spoiler":false,"text":"女性としての魅力がないのではないか・・・と思い込んでいる。"}],"source":"egs","sourceCharacterId":"828","sourceWorkId":"16304","spoiler":false},{"segments":[{"spoiler":false,"text":"学園で同じクラスに所属している同級生。"},{"spoiler":false,"text":"みんなの憧れの女の子で、気立ても良く美人。"},{"spoiler":false,"text":"外面も内面も隙のない完璧超人だが、スペックが高すぎて誰からも恋愛対象とは見られていない。"},{"spoiler":false,"text":"実は恋愛経験が皆無で、知識も乏しい。"},{"spoiler":false,"text":"女性としての魅力が無いのではないか……と思い込んでいる。"}],"source":"bangumi","sourceCharacterId":"64038"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55713884604badb6f39b5010dab82b089c521bac637ed2ce225e7fa52da96465.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/981382ed245d91e744a2f083b4548f5ce840bd481e4ddebcd054e6be7ab95a16.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小暮英麻","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:36152:64038:4282:1","source":"bangumi"}]},{"characterId":"char_c14560","characterName":"豊洲 愛留","sourceIds":{"bangumi":[{"characterId":"64039","match":"exact-normalized-name-in-linked-work","subjectId":"36152"}],"egsCharacterIds":["829"],"vndbCharacterId":"c14560"},"originalCharacterName":"豊洲 愛留","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Is the class representative of the protagonist's class. A rich classmate."},{"spoiler":false,"text":"Cannot forgive the protagonist, who does not strive towards becoming something befitting of being called a man."},{"spoiler":false,"text":"Gives off a bit oppressive feeling but that is to hide her weaker inner self. In reality, she is actually a very kind-hearted girl."},{"spoiler":false,"text":"Like a lady, she takes lessons in traditional Japanese dance, tea ceremony, flower arrangement, etc."},{"spoiler":false,"text":"Though she has excellent grades, it is mostly the result of her effort."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c14560"},{"segments":[{"spoiler":false,"text":"主人公のクラスの委員長で、実家はお金持ちなクラスメイト"},{"spoiler":false,"text":"少々嫌味な面があり、主人公のような冴えない男が大嫌い。"},{"spoiler":false,"text":"男子たるもの、目的にむかって努力すべきなのに主人公にはそれが全く見れないのが許せないらしい。"},{"spoiler":false,"text":"初期の状態は、非友好的だが、主人公がリア充自己暗示がかかってくると、見直してくるようになる（その辺りは素直に人を評価してくれる良い面を持っている）。"},{"spoiler":false,"text":"内心、どこか主人公に期待しているところがあったのかもしれない。"}],"source":"egs","sourceCharacterId":"829","sourceWorkId":"16304","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスで委員長をしている、お金持ちな同級生。"},{"spoiler":false,"text":"男子たるもの目的に向かって努力すべきなのに、主人公にはそれが見られないのが許せない様子。"},{"spoiler":false,"text":"やや高圧的な感じもするが、それは弱い自分を隠すため。 本当は心優しい女の子である。"},{"spoiler":false,"text":"お嬢様らしく、日本舞踊やお茶、華道などの習い事をしている。"},{"spoiler":false,"text":"成績優秀なのは本人の素養もあるが、すべて努力による賜物である。"}],"source":"bangumi","sourceCharacterId":"64039"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97d88e76e963deb0dcd2442c1f5ca10992623b67e93cb8127b3cebeb460f6aeb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4427b40816eecb711345a55140069f06f514b94437173c465e60d6d3e522a21a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:36152:64039:6166:1","source":"bangumi"}]},{"characterId":"char_c14561","characterName":"赤坂 まひる","sourceIds":{"bangumi":[{"characterId":"64040","match":"exact-normalized-name-in-linked-work","subjectId":"36152"}],"egsCharacterIds":["830"],"vndbCharacterId":"c14561"},"originalCharacterName":"赤坂 まひる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cousin of the protagonist. Is a teacher at the school where they go."},{"spoiler":false,"text":"As someone far apart in age, from the past, has been admired by the protagonist and Kotoha."},{"spoiler":false,"text":"During the days of absence of the serious and diligent parents, she has cooked meal for both of them, sometimes."},{"spoiler":false,"text":"Is also quite skillful at games and has beaten the protagonist thoroughly, at times. Is something like a \"gamer girl\"."},{"spoiler":false,"text":"Because of being originally from an all-girls high school, doesn't have any relationship with men. Due to having superficial knowledge regarding sex, is very interested in things related to sex."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c14561"},{"segments":[{"spoiler":false,"text":"主人公の従姉妹で、学園の新米教師。"},{"spoiler":false,"text":"親戚ではあるが、学園では教師と学生という立場もあるため、距離をおくためにあえてツンケンしている。"},{"spoiler":false,"text":"主人公がリア充力を発揮してからは、頼りなかったのに立派になって、ドキドキしちゃうという感じに。"}],"source":"egs","sourceCharacterId":"830","sourceWorkId":"16304","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従姉妹で、彼らが通う学園の先生。"},{"spoiler":false,"text":"昔から年の離れたお姉ちゃんとして、主人公と琴春に慕われている。"},{"spoiler":false,"text":"休みの日などは不在がちな両親の代わりとして、ふたりに食事を作ってあげたこともある。"},{"spoiler":false,"text":"こう見えてゲームがかなり上手く、主人公をフルボッコにしたりもできる、いわゆるゲーム女子という一面も。"},{"spoiler":false,"text":"女子高出身なため男子との交際は無かったが、耳年増でエッチなことには興味津々。"},{"spoiler":false,"text":"普段はかけていないが、書類整理をする時などはメガネをかけることもある。"}],"source":"bangumi","sourceCharacterId":"64040"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dae9dcb27a78b5627d23c30676a7324d984be282355dc4e58a2ed93156f5b4a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c849210685add1fa4cafb724479b5a4927652ee6c34327f3427958405228c42e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:36152:64040:5940:1","source":"bangumi"}]},{"characterId":"char_vndb_c52567","characterName":"上野 ひかり","sourceI