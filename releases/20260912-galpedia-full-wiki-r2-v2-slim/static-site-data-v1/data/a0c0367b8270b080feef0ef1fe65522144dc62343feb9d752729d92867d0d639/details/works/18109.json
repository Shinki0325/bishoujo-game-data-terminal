ly-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1201"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"186"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An honor student whose looks are matched only by her brains."},{"spoiler":false,"text":"Though much pursued by many around her, she maintains a friendly personality and bright outlook on life."},{"spoiler":false,"text":"She loves cute things, and part of her dreams about someday falling in love."},{"spoiler":false,"text":"She has a slight complex about being tall."},{"spoiler":false,"text":"She has known our hero since they were kids, and despite being mildly appalled with his lifestyle, she still manages to help him out in any way she can."},{"spoiler":false,"text":"However, she has a difficult time talking about matters of the heart and brushes off questions of ”Are you two dating?” with ”He’s just like a little brother to me!”"},{"spoiler":false,"text":"Though everyone else can see it clearly, she fails to see how close her relationship to our hero is."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c23211"},{"segments":[{"spoiler":false,"text":"容姿端麗・文武両道な優等生。"},{"spoiler":false,"text":"周囲からは憧れの対象だが、気取りのない明るく親しみやすい性格。"},{"spoiler":false,"text":"可愛いものが大好きだったり、ロマンチックな恋愛を夢想したりする乙女な部分がある。"},{"spoiler":false,"text":"背が高いのはちょっとコンプレックスだったりする。"},{"spoiler":false,"text":"主人公とは幼馴染で、昔から好意を寄せており、そのヘタレ加減に呆れながらも何かと世話を焼いている。"},{"spoiler":false,"text":"しかし色恋沙汰は苦手なため、なかなか素直になれず、他人から「付き合ってるの？」とか言われると、彼は弟みたいなものだから～と必死に釈明。"},{"spoiler":false,"text":"周囲からはバレバレだが、肝心の主人公は彼女の気持ちに全然気付いていないのだった。"},{"spoiler":false,"text":"夜な夜な道行く男性が股間を蹴られる『辻蹴り事件』が発生。"},{"spoiler":false,"text":"このチン事件を解決しようとする主人公と聡海だが、思わぬ事態に巻き込まれてしまう……。"}],"source":"egs","sourceCharacterId":"75","sourceWorkId":"16636","spoiler":false},{"segments":[{"spoiler":false,"text":"容姿端麗・文武両道な長身女子大生。"},{"spoiler":false,"text":"主人公とは幼馴染で、昔から好意を寄せており、"},{"spoiler":false,"text":"そのヘタレ加減に呆れながらも何かと世話を焼いている。"},{"spoiler":false,"text":"ある事件に巻き込まれ、特異体質(興奮するとＳっ気が増大し、更にクリトリスが肥大化してペニス状になる)となってしまった。"},{"spoiler":false,"text":"主人公と無事結ばれた……と思いきや、まだまだ幼馴染以上恋人未満な間柄。"},{"spoiler":false,"text":"「もう～、バカなことばっかり言ってぇ……」"}],"source":"egs","sourceCharacterId":"75","sourceWorkId":"18109","spoiler":false},{"segments":[{"spoiler":false,"text":"容姿端麗・文武両道な長身女子大生。"},{"spoiler":false,"text":"主人公のパートナーとして、そのヘタレ加減に呆れつつも何かと世話を焼いている。"},{"spoiler":false,"text":"ある事件に巻き込まれ、特異体質（興奮するとSっ気が増大し、更にクリトリスが肥大化してペニス状になる）となってしまった。"},{"spoiler":false,"text":"以前は助手＆幼馴染という立場だったが、徐々に主人公とより親密な関係になっているようで……？"},{"spoiler":false,"text":"「クッフフフ……貴方には“しつけ”が必要なようねぇ？」"}],"source":"egs","sourceCharacterId":"75","sourceWorkId":"21053","spoiler":false},{"segments":[{"spoiler":false,"text":"容姿端麗・文武両道な優等生。"},{"spoiler":false,"text":"周囲からは憧れの対象とされているが、気取らない明るく親しみやすい性格。"},{"spoiler":false,"text":"ロマンチックな恋愛を夢想したりする乙女な部分がある。"},{"spoiler":false,"text":"背が高いのはちょっとコンプレックスだったりする。"},{"spoiler":false,"text":"主人公とは幼なじみで昔から好意を寄せており、そのヘタレ加減に呆れながらも何かと世話を焼いている。"},{"spoiler":false,"text":"「も～、こんなんじゃいつまで経っても彼女とかできないよ？」"}],"source":"bangumi","sourceCharacterId":"62755"}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"75","sourceWorkId":"18109","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"88 cm","valueContext":