{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22732","model":{"presentationWorkId":"vndb:v18682","staff":{"artwork":[{"creditedName":"じろう","creatorId":"vndb:s6465","sourcePersonId":"vndb:s6465","canonicalEntityId":"vndb:s6465","name":"じろう","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:126446","source":"vndb"}],"scenario":[{"creditedName":"フレーム","creatorId":"vndb:s621","sourcePersonId":"vndb:s621","canonicalEntityId":"vndb:s621","name":"フレーム","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:126445","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c40122","characterName":"篠森 美奈美","sourceIds":{"vndbCharacterId":"c40122"},"originalCharacterName":"篠森 美奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An enthusiastic member of the tennis club who practices every morning, bright and early, her skin healthily tan and her body toned and supple. She's a middle child with three older brothers and a younger brother and sister. Her personality is vigorous, not the shy type. She looks out for her kouhai. Her grades are in the mid-to-low range, focusing instead on tennis where she's won two tournaments already."},{"spoiler":false,"text":"There's an older boy on the boys tennis team that she likes, but for now it's only that. The boys in general are fond of Minami. Getting home from school requires a lonely 1km walk from the bus stop to her house. Her parents warn her not to take the shortcut through the park, but she does without telling them."}],"source":"vndb","sourceCharacterId":"c40122"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76445461ebc7fb34a0c107bade3b21f189cc0c8dcfb128df029224df5be0ab9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee83b3c130b9be6c18b6d4248f418d7e86661618c66f9e6c6c99e7ce1030632d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"つゆり よつば","creatorId":"vndb:s2951","sourcePersonId":"vndb:s2951","canonicalEntityId":"vndb:s2951","name":"つゆりよつば","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67456","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p949","sourceCompanyId":"egs:brand:2329","canonicalEntityId":"vndb:p949","name":"ディーゼルマイン","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22732:2329","source":"egs"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131823:v18682","source":"vndb"},{"companyId":"vndb:p949","sourceCompanyId":"vndb:p949","canonicalEntityId":"vndb:p949","name":"ディーゼルマイン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:50512:v18682","source":"vndb"},{"companyId":"vndb:p949","sourceCompanyId":"vndb:p949","canonicalEntityId":"vndb:p949","name":"ディーゼルマイン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:50823:v18682","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
