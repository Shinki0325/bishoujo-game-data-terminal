61","canonicalEntityId":"egs:creator:31461","name":"YAGI","detail":"CV編集","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:209373","source":"egs"},{"creditedName":"しゃぶしゃぶ","creatorId":"egs:creator:32981","sourcePersonId":"egs:creator:32981","canonicalEntityId":"egs:creator:32981","name":"しゃぶしゃぶ","detail":"CV編集","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:209374","source":"egs"},{"creditedName":"呉","creatorId":"vndb:s507","sourcePersonId":"vndb:s507","canonicalEntityId":"vndb:s507","name":"呉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146087","source":"vndb"},{"creditedName":"恋純 ほたる","creatorId":"vndb:s1908","sourcePersonId":"vndb:s1908","canonicalEntityId":"vndb:s1908","name":"恋純 ほたる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146089","source":"vndb"},{"creditedName":"Rastel","creatorId":"vndb:s4482","sourcePersonId":"vndb:s4482","canonicalEntityId":"vndb:s4482","name":"rastel","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146092","source":"vndb"},{"creditedName":"八月朔日 珈瑠","creatorId":"vndb:s4915","sourcePersonId":"vndb:s4915","canonicalEntityId":"vndb:s4915","name":"八月朔日珈瑠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:146093","source":"vndb"}]},"cast":[{"characterId":"char_c67455","characterName":"ミカン","sourceIds":{"bangumi":[{"characterId":"60221","match":"exact-normalized-name-in-linked-work","subjectId":"231633"}],"egsCharacterIds":["19388"],"vndbCharacterId":"c67455"},"originalCharacterName":"ミカン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Catgirl who came to repay the protagonist's altruism, no. 1."},{"spoiler":false,"text":"She's always cheerful, always energetic, and never seen without a smile on her face. She always tries her best, but can be rather clumsy. However, her frequent blunders do nothing to hinder her resolve; she practically burns with motivation."},{"spoiler":false,"text":"She is terribly fond of the protagonist for helping her out, and knows just how to butter him up when he least expects it."},{"spoiler":false,"text":"Lime & Lemon are like family to her, and she acts rather akin to the youngest of the pack."},{"spoiler":false,"text":"\"Mikan's gonna do her best! So how's about a little head tousling, please♪\""}],"source":"vndb","sourceCharacterId":"c67455"},{"segments":[{"spoiler":false,"text":"恩返しのために主人公のところにやってきたネコ、その1。"},{"spoiler":false,"text":"いつも元気で明るく、笑顔が絶えない性格をしている。"},{"spoiler":false,"text":"がんばりやだけど、わりとドジ。失敗をすることが多いけれど、めげずに諦めない。やる気はたっぷり。"},{"spoiler":false,"text":"助けてくれたこともあり、主人公のことは大好き。隙を見ては甘えようとする。"},{"spoiler":false,"text":"ライムとレモンは家族のような関係。末っ子的ポジション。"},{"spoiler":false,"text":"メインヒロイン。"}],"source":"egs","sourceCharacterId":"19388","sourceWorkId":"26162","spoiler":false},{"segments":[{"spoiler":false,"text":"恩返しのために主人公のところにやってきたネコ、その１。いつも元気で明るく、笑顔が絶えない性格をしている。がんばりやだけど、わりとドジ。失敗をすることが多いけれど、めげずに諦めない。やる気はたっぷり。助けてくれたこともあり、主人公のことは大好き。隙を見ては甘えようとする。ライムとレモンは家族のような関係。末っ子的ポジション。メインヒロイン。"}],"source":"bangumi","sourceCharacterId":"60221"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"19388","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"19388","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"19388","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"19388","sourceWorkId":"26162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f6ec121e7b2028b37bff50623c2a3d6b0bcc969e86ce959c46af46eadeb1e71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1349ba77e46a4264fc95ddba471e531e95a02895f264c8dd7ae04785638d3fce.webp","width":253,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月星 ユナ","creatorId":"vndb:s8713","sourcePersonId":"vndb:s8713","canonicalEntityId":"vndb:s8713","name":"海王茉菜(月星ユナ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76693","source":"vndb"}]},{"characterId":"char_c67456","characterName":"ライム","sourceIds":{"bangumi":[{"characterId":"60222","match":"exact-normalized-name-in-linked-work","subjectId":"231633"}],"egsCharacterIds":["19389"],"vndbCharacterId":"c67456"},"originalCharacterName":"ライム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Catgirl who came to repay the protagonist's altruism, no. 2."},{"spoiler":false,"text":"At first glance, she gives the impression of a relaxed & cool-headed individual, but in actuality, she is quite a mischievous and difficult little thing to deal with. That said, she'll only pull pranks on people she cares about; one could say, she has a heart of gold."},{"spoiler":false,"text":"Being heavily interested in the protagonist, she takes great delight in teasing him."},{"spoiler":false,"text":"Mikan & Lemon are like family to her, and she's rather like the head of the pack."},{"spoiler":false,"text":"\"You're a real cutie, Master... Teehee, just kidding.\""}],"source":"vndb","sourceCharacterId":"c67456"},{"segments":[{"spoiler":false,"text":"恩返しのために主人公のところにやってきたネコ、その2。"},{"spoiler":false,"text":"一見、クールで落ち着いているけれど、中身はいたずら好きという困った性格。"},{"spoiler":false,"text":"ただ、心を許した相手にしかいたずらをしないため、ある意味、親愛の証。相当なひねくれもの。"},{"spoiler":false,"text":"主人公に興味津々で、ちょくちょくからかったりいたずらをしかけたりする。"},{"spoiler":false,"text":"ミカンとレモンは家族のような関係。長女的ポジション。"},{"spoiler":false,"text":"メインヒロイン。"}],"source":"egs","sourceCharacterId":"19389","sourceWorkId":"26162","spoiler":false},{"segments":[{"spoiler":false,"text":"恩返しのために主人公のところにやってきたネコ、その２。一見、クールで落ち着いているけれど、中身はいたずら好きという困った性格。ただ、心を許した相手にしかいたずらをしないため、ある意味、親愛の証。相当なひねくれもの。主人公に興味津々で、ちょくちょくからかったりいたずらをしかけたりする。ミカンとレモンは家族のような関係。長女的ポジション。メインヒロイン。"}],"source":"bangumi","sourceCharacterId":"60222"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"19389","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"19389","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"19389","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"19389","sourceWorkId":"26162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c362ca230f4d1cd6b1e221ee65d6444bf61b9845edac058a672f87f2b9c5213d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/1566a5cbffcfeabde88e93b998c67b77be32f25e03cbecebb0b496a00ba90edb.webp","width":253,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みたかりん","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231633:60222:25596:1","source":"bangumi"}]},{"characterId":"char_c67457","characterName":"レモン","sourceIds":{"bangumi":[{"characterId":"60223","match":"exact-normalized-name-in-linked-work","subjectId":"231633"}],"egsCharacterIds":["19390"],"vndbCharacterId":"c67457"},"originalCharacterName":"レモン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Catgirl who came to repay the protagonist's altruism, no. 3."},{"spoiler":false,"text":"She can't be honest with herself, but accidentally ends up saying what she really thinks a lot. She's really quite easy to read, so there isn't much room for misunderstandings with her."},{"spoiler":false,"text":"She has complex feelings about the protagonist, but can't be honest about those feelings, so she constantly acts condescending towards him. And afterwards, she'll end up fainting in regret."},{"spoiler":false,"text":"Mikan & Lime are like family to her, and she's rather like the second-eldest of the pack."},{"spoiler":false,"text":"\"I-It's not like I want you to take care of me or anything! ...Seriously, though. Don't you dare abandon me.\""}],"source":"vndb","sourceCharacterId":"c67457"},{"segments":[{"spoiler":false,"text":"恩返しのために主人公のところにやってきたネコ、その3。"},{"spoiler":false,"text":"素直になれないところがあり、ついつい、本心とは違うことを口にしてしまうことが。"},{"spoiler":false,"text":"しかし、実にわかりやすい態度なので、周囲に誤解を与えることは少ない。"},{"spoiler":false,"text":"主人公のことが気になるものの、素直になることができず、上から目線になってしまうことも。"},{"spoiler":false,"text":"後でそのことを後悔して、悶絶している。"},{"spoiler":false,"text":"ミカンとライムは家族のような関係。次女的ポジション。"},{"spoiler":false,"text":"メインヒロイン。"}],"source":"egs","sourceCharacterId":"19390","sourceWorkId":"26162","spoiler":false},{"segments":[{"spoiler":false,"text":"恩返しのために主人公のところにやってきたネコ、その３。素直になれないところがあり、ついつい、本心とは違うことを口にしてしまうことが。しかし、実にわかりやすい態度なので、周囲に誤解を与えることは少ない。主人公のことが気になるものの、素直になることができず、上から目線になってしまうことも。後でそのことを後悔して、悶絶している。ミカンとライムは家族のような関係。次女的ポジション。メインヒロイン。"}],"source":"bangumi","sourceCharacterId":"60223"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19390","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"19390","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"19390","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"19390","sourceWorkId":"26162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4beff9cc550180f599c0b2084b6945e8a1533272a51c288627cbce6ce8d96454.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d77e4fd1badde5768453cf803f29a46386791f2b61baa895fbceea85827fa3da.webp","width":253,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井菜々絵","creatorId":"vndb:s6525","sourcePersonId":"vndb:s6525","canonicalEntityId":"vndb:s6525","name":"櫻井 菜々絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:231633:60223:19126:1","source":"bangumi"}]},{"characterId":"char_c67458","characterName":"笹原 涼花","sourceIds":{"bangumi":[{"characterId":"60224","match":"exact-normalized-name-in-linked-work","subjectId":"231633"}],"egsCharacterIds":["19391"],"vndbCharacterId":"c67458"},"originalCharacterName":"笹原 涼花","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's sister."},{"spoiler":false,"text":"Although still a student, she is more than happy to barge in on her brother during summer vacation. She is the model of an ideal honour student, and excels at both studies and physical education. However, she is also a bona-fide brocon who has professed her love for her brother."},{"spoiler":false,"text":"She is initially skeptical about the catgirls, but owing to her love for cats, she quickly overcomes that. After that, she tries to make more time to be with them."},{"spoiler":false,"text":"\"Onii-sama, would you care for some sisterly affection? I'm having a blowout sale on it♪\""}],"source":"vndb","sourceCharacterId":"c67458"},{"segments":[{"spoiler":false,"text":"主人公の妹。まだ学生だけど、夏休みを利用して、主人公のところに押しかけてきた。"},{"spoiler":false,"text":"勉強も運動も家事もなんでもできる、完璧な優等生。"},{"spoiler":false,"text":"しかし、極度のブラコンで、主人公が好きと公言している。"},{"spoiler":false,"text":"ネコたちのことは、最初は警戒するものの、ネコ好きということもあり、すぐに心を許す。"},{"spoiler":false,"text":"以来、妹に接するような態度に。"},{"spoiler":false,"text":"サブヒロイン。攻略はできません。"}],"source":"egs","sourceCharacterId":"19391","sourceWorkId":"26162","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。まだ学生だけど、夏休みを利用して、主人公のところに押しかけてきた。勉強も運動も家事もなんでもできる、完璧な優等生。しかし、極度のブラコンで、主人公が好きと公言している。ネコたちのことは、最初は警戒するものの、ネコ好きということもあり、すぐに心を許す。以来、妹に接するような態度に。サブヒロイン。攻略はできません。"}],"source":"bangumi","sourceCharacterId":"60224"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"19391","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"19391","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19391","sourceWorkId":"26162","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"19391","sourceWorkId":"26162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2738ecb7241772133b62446738e4ad6a1207214d49c8e6db3084de5a16a3f6a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/4531f91088aee6b980e299dae724791ee2f9dff8711a3178817ff1560032344a.webp","width":253,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石雫春","creatorId":"vndb:s15442","sourcePersonId":"vndb:s15442","canonicalEntityId":"vndb:s15442","name":"石雫春","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76694","source":"vndb"}]},{"characterId":"char_vndb_c67454","characterName":"笹原 夏樹","sourceIds":{"vndbCharacterId":"c67454"},"originalCharacterName":"笹原 夏樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"s