[{"characterId":"char_vndb_c144910","characterName":"アルマ","sourceIds":{"vndbCharacterId":"c144910"},"originalCharacterName":"アルマ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A demon summoned by the heroine. Though she’s no stranger to handsome faces, Alma’s striking beauty leaves her utterly speechless."},{"spoiler":false,"text":"He always seems half-asleep and disinterested, often teasing the heroine—but every now and then, he shows a strange flicker of kindness… what could that mean?"},{"spoiler":false,"text":"“I’ll make you the most irresistible woman in the world—a temptress who enchants every man.”"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c144910"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f30d4b6dff4e04b3fcd8c0d3d95da0713432d8342462be7944106632dacd9db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e715f95cc919e4557da82a76bff08551d2a8bea7de588670b126dde0a5c2442d.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八神 仙","creatorId":"vndb:s34034","sourcePersonId":"vndb:s34034","canonicalEntityId":"vndb:s34034","name":"八神仙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99381","source":"vndb"}]},{"characterId":"char_vndb_c144911","characterName":"クリス","sourceIds":{"vndbCharacterId":"c144911"},"originalCharacterName":"クリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The quintessential prince charming every noblewoman dreams of."},{"spoiler":false,"text":"Though he comes from the marquis family and the heroine’s father is an earl, their families share a long friendship, and Chris and the heroine have been childhood friends ever since."},{"spoiler":false,"text":"Known for his flawless looks and calm demeanor, Chris shocked the heroine with an unexpected confession when she pressed him about marriage."},{"spoiler":false,"text":"“I’m not good with virgins… but you are one, aren’t you?”"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c144911"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c0696c66505a76b3b042bf21c113dcb14cc5e107c378ab89a7894034a5114e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dabef67da47ffce59e9f5dcc15d002b3d815a734e2234fd5bef2632cff43ca4.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"彩和矢","creatorId":"vndb:s36705","sourcePersonId":"vndb:s36705","canonicalEntityId":"vndb:s36705","name":"彩和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99382","source":"vndb"}]},{"characterId":"char_vndb_c144912","characterName":"ベリト","sourceIds":{"vndbCharacterId":"c144912"},"originalCharacterName":"ベリト","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high-ranking demon normally beyond human summoning, Berith is one of Alma’s trusted subordinates."},{"spoiler":false,"text":"Called forth to support Alma, he hides a complex agenda. Upon first meeting the heroine, he bluntly declares his hatred for her."},{"spoiler":false,"text":"“I despise your ugly ambition.”"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c144912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f435e3ce5fcbac27289af254d7157474aa19bbd4714dfb800873b720b37f149.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9ec81e0bb9c04deefe52a5401a7b5933739b8b51e1d9638cb92a2c3ca04917ca.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三楽 章","creatorId":"vndb:s1399","sourcePersonId":"vndb:s1399","canonicalEntityId":"vndb:s1399","name":"牧野 秀紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99380","source":"vndb"}]},{"characterId":"char_vndb_c155858","characterName":"セシリア·アンバートン","sourceIds":{"vndbCharacterId":"c155858"},"originalCharacterName":"セシリア·アンバートン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The sole heir of the Amberton Earl family."},{"spoiler":false,"text":"From childhood, she has adored Christopher to the point of ignoring all others, and now she’s found herself left behind in the race for marriage."},{"spoiler":false,"text":"Desperate to secure Christopher’s hand and restore her family’s honor, she even resorted to summoning the demon Alma."},{"spoiler":false,"text":"Bright and determined, Cecilia isn’t foolish—but her sense of what’s “proper” for a noble lady is a little… unconventional."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c155858"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/125abc890a06da8c0cd897