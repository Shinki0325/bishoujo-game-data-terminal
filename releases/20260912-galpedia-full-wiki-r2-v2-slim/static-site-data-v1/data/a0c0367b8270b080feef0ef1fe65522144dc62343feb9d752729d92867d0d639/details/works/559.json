":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:71160","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c6588","characterName":"本条寺　あきら","sourceIds":{"vndbCharacterId":"c6588"},"originalCharacterName":"本条寺　あきら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1009"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akira, Anne Mitter's charismatic red-headed waitress, is the heroine of the Rise series. Strong-willed, compassionate and an expert of martial arts - third grade mastery in judo and fourth grade mastery in both karate and aikido - Akira doesn't take well to insincerity, injustice, or imprisonment."}],"source":"vndb","sourceCharacterId":"c6588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/539f50393f786bf1ba070e334613dd76623cd72ae0eada9cd244c4ceb727a3b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99cb34b533c146b069a661844e9654a91d7043b6faa6de2685fdad29acbc4479.webp","width":160,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c6589","characterName":"かりん","sourceIds":{"vndbCharacterId":"c6589"},"originalCharacterName":"かりん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"While Akira is strong and forthright, Karin is shy, insecure, and easily flustered. These qualities are epitomized most by her smaller stature and younger age compared to her co-workers. Karin is prone to fits of clumsiness while carrying serving trays, and thus is frequently relegated to cashier or greeter duty. She is easily influenced and often becomes an unwilling participant in practical jokes, most often Makoto's. Akira is her best friend and personal hero, both figuratively and literally."}],"source":"vndb","sourceCharacterId":"c6589"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccf302e7a815673e00e68ce30227fdd49a1eb4fc7a805eecbea180a4df144fc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02a55a6c1147b67e1207d0add07b28a95fdfca6b46ecd52b83f5ecfcdf463fae.webp","width":160,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p461","sourceCompanyId":"egs:brand:174","canonicalEntityId":"vndb:p461","name":"SOGNA","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:559:174","source":"egs"},{"companyId":"vndb:p461","sourceCompanyId":"vndb:p461","canonicalEntityId":"vndb:p461","name":"ソニア","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:17740:v7491","source":"vndb"},{"companyId":"vndb:p461","sourceCompanyId":"vndb:p461","canonicalEntityId":"vndb:p461","name":"ソニア","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:37298:v7491","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
