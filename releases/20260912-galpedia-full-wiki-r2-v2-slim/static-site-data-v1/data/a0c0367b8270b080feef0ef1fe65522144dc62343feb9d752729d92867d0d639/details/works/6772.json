ourcePersonId":"vndb:s46467","canonicalEntityId":"vndb:s46467","name":"下田 芳裕","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12979","source":"vndb"}]},"cast":[{"characterId":"char_c164202","characterName":"プレさん","sourceIds":{"bangumi":[{"characterId":"147413","match":"exact-normalized-name-in-linked-work","subjectId":"15970"}],"egsCharacterIds":["13050"],"vndbCharacterId":"c164202"},"originalCharacterName":"プレさん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"egs","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"喋るプレーリードッグ。インチキ関西弁（？）。セクハラ魔人。"},{"spoiler":false,"text":"思考波で頭の中に直接話し掛けてくる模様。"},{"spoiler":false,"text":"至高にして重畳［ちょうじょう］たる高貴の賓［マレビト］。"},{"spoiler":false,"text":"異郷［とこよ］から此方［こなた］に来訪するものにして、"},{"spoiler":false,"text":"人々に祝福と咒［のろ］いとを与えて去る賓位［まろうどい］の支配者。"},{"spoiler":false,"text":"この賓位［せかい］に唯一、ちょう貴重かつ、ちょう高貴な吸血プレーリードッグ（自称）。"},{"spoiler":false,"text":"その正体は謎。"},{"spoiler":false,"text":"一応腐っても草食げっ歯類なのでちょっぴりアイデンティティに悩んでいる。"}],"source":"egs","sourceCharacterId":"13050","sourceWorkId":"6772","spoiler":false},{"segments":[{"spoiler":false,"text":"なぜかエスと行動を共にする、人語を解する謎のプレーリードッグ。"},{"spoiler":false,"text":"自称、“至高にして重畳［ちょうじょう］たる高貴の賓［マレビト］。"},{"spoiler":false,"text":"異郷［とこよ］から此方［こなた］に来訪するものにして、人々に祝福と咒［のろ］いとを与えて去る賓位［まろうどい］の支配者。"},{"spoiler":false,"text":"この賓位［せかい］に唯一、ちょう貴重かつ、ちょう高貴な吸血プレーリードッグ”であると主張するが、その正体、或いはなにか正体に相当するモノがあるのかどうかも不明。"},{"spoiler":false,"text":"インチキ関西弁（？）を繰り話すが、現実に声帯を使って喋る訳ではなく、一種の念波により頭の中に直接話し掛けているらしい。"},{"spoiler":false,"text":"『ワシは、表向きは極端にプリティでアイドル性の高い、ただのプレーリードッグっちゅーことになっとるのや！』"}],"source":"egs","sourceCharacterId":"13050","sourceWorkId":"12357","spoiler":false},{"segments":[{"spoiler":false,"text":"なぜかエスと行動を共にする、人語を解する謎のプレーリードッグ。"},{"spoiler":false,"text":"自称、“至高にして重畳［ちょうじょう］たる高貴の賓［マレビト］。"},{"spoiler":false,"text":"異郷［とこよ］から此方［こなた］に来訪するものにして、人々に祝福と咒［のろ］いとを与えて去る賓位［まろうどい］の支配者。"},{"spoiler":false,"text":"この賓位［せかい］に唯一、ちょう貴重かつ、ちょう高貴な吸血プレーリードッグ”であると主張するが、その正体、或いはなにか正体に相当するモノがあるのかどうかも不明。"},{"spoiler":false,"text":"インチキ関西弁（？）を繰り話すが、現実に声帯を使って喋る訳ではなく、一種の念波により頭の中に直接話し掛けているらしい。"},{"spoiler":false,"text":"手元に“或る真祖の聖乾肉［パン］”というアイテムを持ち、吸血鬼の中でも血統の純粋な貴族種の、心臓の最期の一滴“聖血液［ワイン］”を収集して回っているが、その目的も不明。"},{"spoiler":false,"text":"「ワシは、表向きは極端にプリティでアイドル性の高い、ただのプレーリードッグっちゅーことになっとるのや！」"}],"source":"bangumi","sourceCharacterId":"147413"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d0cf86be8ecf62c971e439c1597c044bc357179f9584da94368878b38ff2e26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eefe9181a7e07e0f65b4ac4d24d6e908c9467dfe2a718764c13049818e3a8ef1.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c29940","characterName":"Einhänder","sourceIds":{"bangumi":[{"characterId":"147395","match":"exact-normalized-name-in-linked-work","subjectId":"15970"},{"characterId":"147395","match":"exact-normalized-name-in-linked-work","subjectId":"16695"}],"egsCharacterIds":["13049"],"vndbCharacterId":"c29940"},"originalCharacterName":"Einhänder","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"科學情報局［DSI］、通称 “店［The Shop］” の一部門、超常現象事務局［OPS］の新米ハンター。"},{"spoiler":false,"text":"師に引き取られ教えを受ける６年以前の記憶が無い。"},{"spoiler":false,"text":"通常時は左腕に擬態した義手を着けており、その義手を利用しての肉弾戦を得意とする。"},{"spoiler":false,"text":"併用して師から伝授された魔術を使用。"},{"spoiler":false,"text":"さらに戦闘に特化した義手・殲滅服──術式破城槌──『ヘルツォ・グロンド（Herzo¨ Grond）』を所持。"},{"spoiler":false,"text":"意外とヌけた性格。"}],"source":"egs","sourceCharacterId":"13049","sourceWorkId":"6772","spoiler":false},{"segments":[{"spoiler":false,"text":"隻腕の少女。"},{"spoiler":false,"text":"かつては合衆国科學情報局、超常現象事務局“OPS”の新米ハンターだったが、初の実戦中、師を失ったところでエスに救われ任務を同道することに。"},{"spoiler":false,"text":"最終的には師の仇をとるも強力な毒物により瀕死の重傷を負い、エスの“抱擁”を受ける。"},{"spoiler":false,"text":"結果として生き残り、そのままOPSからスプークハウスに出向のような形で一時移籍。"},{"spoiler":false,"text":"だが現在のところ、吸血鬼化などの抱擁による影響は確認されていない。"},{"spoiler":false,"text":"平時は左腕に擬態した義手を着けており、その義手を利用しての肉弾戦を得意とする。"},{"spoiler":false,"text":"また師から習得した魔術も併用する場合がある。"},{"spoiler":false,"text":"「受付のおねーさん、ちょーかわいい」"}],"source":"egs","sourceCharacterId":"13049","sourceWorkId":"12357","spoiler":false},{"segments":[{"spoiler":false,"text":"科學情報局［DSI］、通称 “店［The Shop］” の一部門、超常現象事務局［OPS］の新米ハンター。"},{"spoiler":false,"text":"師に引き取られ教えを受ける6年以前の記憶が無い。"},{"spoiler":false,"text":"通常時は左腕に擬態した義手を着けており、その義手を利用しての肉弾戦を得意とする。さらに師から伝授された魔術を併用。"},{"spoiler":false,"text":"さらに戦闘に特化した義手・殲滅服──術式破城槌──『ヘルツォ・グロンド（Herzo¨ Grond）』を所持。"},{"spoiler":false,"text":"意外とヌけた性格。"}],"source":"bangumi","sourceCharacterId":"147395"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/801bdbbccb5ba47ee6aebc91bb06962097ac7e388f0d14066f93f318d5cf1ed1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/783784e96bcfa8cbc0ccf0db9200afb4d86c22863f1196cd7b15f665e1026644.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c29941","characterName":"クリス","sourceIds":{"bangumi":[{"characterId":"147397","match":"exact-normalized-name-in-linked-work","subjectId":"15970"},{"characterId":"147397","match":"exact-normalized-name-in-linked-work","subjectId":"16695"}],"egsCharacterIds":["13051"],"vndbCharacterId":"c29941"},"originalCharacterName":"クリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"蠅声の王” とも称されるヴァクトマイステル血族のサウザンド（貴族種）。"},{"spoiler":false,"text":"彼自身はながらくヒトの血を吸っていない。"},{"spoiler":false,"text":"だが元々長大な寿命を持つヴァンパイアの中でも特に老化速度が遅く、"},{"spoiler":false,"text":"血を吸わずともほとんど経年劣化していない。"},{"spoiler":false,"text":"また、驚異的な身体能力と回復力を併せ持ちあわせる。"},{"spoiler":false,"text":"ハートフォード・ニューモデルアーミー２丁を所持。"}],"source":"egs","sourceCharacterId":"13051","sourceWorkId":"6772","spoiler":false},{"segments":[{"spoiler":false,"text":"クリストフェル・マルカヴィアン・ヴァクトマイステル――“蠅声の王”とも称された。"},{"spoiler":false,"text":"ハートフォード　ニューモデルアーミー2丁を武器とした正確無比な射撃を得意とする。"},{"spoiler":false,"text":"元々長大な寿命を持つヴァンパイアの中でも特に老化速度が遅く、血を吸わずともほとんど経年劣化せず、且つ高度な能力を維持していた強力な吸血鬼。"},{"spoiler":false,"text":"同血族の祖であるウルリーカに死んだ母親の蘇生を約束され、長らく本意ではない人間狩りなどをさせられていたが、エスらとの邂逅の中で自分を取り戻し、最後には自らの手でウルリーカを倒す。"},{"spoiler":false,"text":"その後自分を慕う元メイド、コサチとともに出奔、行方を眩ませる。"},{"spoiler":false,"text":"「紅茶でも珈琲でもなく、お前をもらおう」"}],"source":"egs","sourceCharacterId":"13051","sourceWorkId":"12357","spoiler":false},{"segments":[{"spoiler":false,"text":"クリストフェル・マルカヴィアン・ヴァクトマイステル。蠅声の王とも称された。"},{"spoiler":false,"text":"ハートフォード ニューモデルアーミー2丁を武器とした正確無比な射撃を得意とする。"},{"spoiler":false,"text":"元々長大な寿命を持つヴァンパイアの中でも特に老化速度が遅く、血を吸わずともほとんど経年劣化せず、且つ高度な能力を維持していた強力な吸血鬼。"},{"spoiler":false,"text":"同血族の祖であるウルリーカに死んだ母親の蘇生を約束され、長らく本意ではない人間狩りなどをさせられていたが、エスらとの邂逅の中で自分を取り戻し、最後には自らの手でウルリーカを倒す。"},{"spoiler":false,"text":"その後自分を慕う元メイド、コサチとともに出奔、行方を眩ませる。"},{"spoiler":false,"text":"ウルリーカが死んだ現在では、最後のヴァクトマイステルとなる。"},{"spoiler":false,"text":"ただし母親は人間であり、純血のヴァンパイアではない。"},{"spoiler":false,"text":"「紅茶でも珈琲でもなく、お前をもらおう」"}],"source":"bangumi","sourceCharacterId":"147397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a4ada77f1d94b6dfb996f1c5ea5e656eff82b0419e9b0c5e262b5b5618b0e11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f78884e6e44497e09454cf7388c1c5ae3030c03b401c5fc3c303f5f6293af4fd.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c29942","characterName":"キヨタ","sourceIds":{