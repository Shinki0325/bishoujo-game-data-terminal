{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9587","model":{"presentationWorkId":"vndb:v2952","staff":{"artwork":[{"creditedName":"ガンちゃん","creatorId":"vndb:s3575","sourcePersonId":"egs:creator:172","canonicalEntityId":"vndb:s3575","name":"ガンちゃん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:38070","source":"egs"}],"scenario":[{"creditedName":"はまちょ","creatorId":"vndb:s5175","sourcePersonId":"egs:creator:3511","canonicalEntityId":"vndb:s5175","name":"はまちょ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:38071","source":"egs"}],"music":[{"creditedName":"八乙女 葦菜","creatorId":"vndb:s7016","sourcePersonId":"vndb:s7016","canonicalEntityId":"vndb:s7016","name":"八乙女 葦菜","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:39231","source":"vndb"}],"other":[{"creditedName":"ガンちゃん","creatorId":"vndb:s3575","sourcePersonId":"vndb:s3575","canonicalEntityId":"vndb:s3575","name":"ガンちゃん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:39227","source":"vndb"},{"creditedName":"はまちょ","creatorId":"vndb:s5175","sourcePersonId":"vndb:s5175","canonicalEntityId":"vndb:s5175","name":"はまちょ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:39230","source":"vndb"}]},"cast":[{"characterId":"char_c57136","characterName":"桜庭 湊","sourceIds":{"bangumi":[{"characterId":"95225","match":"exact-normalized-name-in-linked-work","subjectId":"229664"},{"characterId":"95225","match":"exact-normalized-name-in-linked-work","subjectId":"229668"}],"egsCharacterIds":["19656"],"vndbCharacterId":"c57136"},"originalCharacterName":"桜庭 湊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"36"},"bust":{"reviewState":"source-only","source":"vndb","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koutaro's step mother."},{"spoiler":false,"text":"She and Misako, Koutarou's biological mother, have known each other since childhood. She married Koutarou's grieving father, after the death of his wife shortly after Nagisa was born."},{"spoiler":false,"text":"Since then, she has been taking care of household responsibilities while making the family supermarket business prosperous."},{"spoiler":false,"text":"She is the ideal mother, perfectly capable of handling all household chores, sometimes kind and sometimes strict. In reality, she is an extremely lonely person who cannot survive without someone's support,"},{"spoiler":false,"text":"However, she only shows this side of herself in front of the man she really loves, Choichiro."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57136"},{"segments":[{"spoiler":false,"text":"主人公の義母。36歳。"},{"spoiler":false,"text":"家事全般を完璧にこなす、時に優しく、時に厳しい理想の母親。"},{"spoiler":false,"text":"さらに床上手。"},{"spoiler":false,"text":"極度の寂しがり屋の彼女だが、そうした面を見せない気丈さを持つ。"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"2648","spoiler":false},{"segments":[{"spoiler":false,"text":"レジェン妻（ゲスト出演）"},{"spoiler":false,"text":"『人妻×人妻3』の主人公、桜庭航太郎の義理の母親で、最終的に彼と結ばれた。"},{"spoiler":false,"text":"現在は航太郎との間に生まれた子供、海人の母親。"},{"spoiler":false,"text":"航太郎は、現在海外の大学で経営を学んでおり、ちょっぴり寂しい。"},{"spoiler":false,"text":"「あっ、あらひのオッ、オ○ンコがっ……！！オ○ンコがっ、こわれちゃうぅぅ！！」"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"7533","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妻。"},{"spoiler":false,"text":"『人妻×人妻3～』では、最愛の夫・長一郎を亡くし、夫の残してくれたスーパー「サクラマート」を義理の息子である主人公と一緒に盛り立ててきた。"},{"spoiler":false,"text":"そうしたなか、主人公と愛が芽生え、そして結婚に至る。"},{"spoiler":false,"text":"家事全般を難なくこなす、優しさと厳しさを同居させる女性。"},{"spoiler":false,"text":"昼は聖母、夜は娼婦の如き卓越した性テクニックを持つ。"}],"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","spoiler":false},{"segments":[{"spoiler":false,"text":"航太郎の義理の母親。"},{"spoiler":false,"text":"実母のみさ子とは幼なじみの間柄である。"},{"spoiler":false,"text":"なぎさが産まれた直後に連れあいを亡くし、悲嘆に暮れていた航太郎の父、長一郎と再婚。"},{"spoiler":false,"text":"以来、家業のスーパーを盛り立てつつ、兄弟三人の面倒を見て来た。"},{"spoiler":false,"text":"家事全般を完璧にこなし、時に優しく、時に厳しい理想の母親。"},{"spoiler":false,"text":"本当は、常に誰かの支えがないと生きていけない極度の寂しがり屋なのだが、"},{"spoiler":false,"text":"その一面を見せるのは本当に好きになった男・・・長一郎の前のみである。"}],"source":"bangumi","sourceCharacterId":"95225"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48.5 kg","valueContext":null,"source":"egs","sourceCharacterId":"19656","sourceWorkId":"9587","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6c8e92d90f49785d5e113dfd268607187d4efd0ecbf1a2e3a8bae4083b2bb4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters