"value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"24036","sourceWorkId":"8679","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"24036","sourceWorkId":"8679","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1912c80e4212719ebe9211ba0807217b692819b087a1f94d57dddd0a12c5911.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/1520957b84847b1e7288ff3608f1d114b6ed0b69ddd5da533b11b356e5164f2c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:123351:131602:4810:1","source":"bangumi"}]},{"characterId":"char_c33964","characterName":"百合原 サユリ","sourceIds":{"bangumi":[{"characterId":"131603","match":"exact-normalized-name-in-linked-work","subjectId":"123351"}],"egsCharacterIds":["24037"],"vndbCharacterId":"c33964"},"originalCharacterName":"百合原 サユリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るくサッパリしたクラスメイト。"},{"spoiler":false,"text":"美音とは、唯一無二の大親友で、よく二人一緒に行動している。"},{"spoiler":false,"text":"交友関係に男女の垣根が余りないようで、美音の他、優樹や巌（クラスメイト）と遊んだり、昼食を共にすることも多い。"},{"spoiler":false,"text":"豪快な人物に思われがちだが、繊細で女の子らしい一面も……。"}],"source":"egs","sourceCharacterId":"24037","sourceWorkId":"8679","spoiler":false},{"segments":[{"spoiler":false,"text":"サバサバした性格で、男勝り。性根が明るく、些細な事など微塵も気にしない豪放磊落な人物に見られがちだが意外と繊細で脆い一面も持っている。"},{"spoiler":false,"text":"優樹や巌とはウマが合うが、博士とは犬猿の仲で会話の度に噛み付きあっている（といっても某海外アニメの猫と鼠のような、切っても切れない間柄）"},{"spoiler":false,"text":"その容姿と女王様的な性格から、クラスのごく一部の男子からは「踏まれたい」「蹴られたい」「酷い事を言われたい」「ああ、百合原様……」と崇め奉られているらしい。"}],"source":"bangumi","sourceCharacterId":"131603"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"24037","sourceWorkId":"8679","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"24037","sourceWorkId":"8679","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"24037","sourceWorkId":"8679","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"24037","sourceWorkId":"8679","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22032a430d76c3865b7f2bf7af8579eac5eb4859a63b895df0be2251357f3fdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ea038baa1c31acc67d302a63862f611bb714bdee19564583d2c10bb714989d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:123351:131603:5900:1","source":"bangumi"}]},{"characterId":"char_c33965","characterName":"葵塚 智代","sourceIds":{"bangumi":[{"characterId":"131604","match":"exact-normalized-name-in-linked-work","subjectId":"123351"}],"egsCharacterIds":["24038"],"vndbCharacterId":"c33965"},"originalCharacterName":"葵塚 智代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"60"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"63"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"超金持ち一族“葵塚”の一員で、天才ホモ“葵塚博士”の従姉妹"},{"spoiler":false,"text":"葵塚コンツェルン総裁の一人娘でもあり、将来は当主になることが決まっている。"},{"spoiler":false,"text":"家の都合で日本を離れていたが、数年ぶりに帰国。"},{"spoiler":false,"text":"幼馴染である優樹と、幼いころに交わした「約束」を事あるごとに口にするが、当の優樹は覚えていないようで……。"}],"source":"egs","sourceCharacterId":"24038","sourceWorkId":"8679","spoiler":false},{"segments":[{"spoiler":false,"text":"博士の従姉妹で超絶金持ち一族葵塚家の一員にして、一族を統括する葵塚コンツェルン総裁の一人娘。"},{"spoiler":false,"text":"将来葵塚コンツェルンを背負って立つ事が決まっている生まれながらの女帝。金髪縦ロールをぶるんぶるんと揺らしてオホホホホホホと笑う高飛車なお嬢様。"},{"spoiler":false,"text":"優樹の幼馴染であり、幼い頃は優樹の事を年下でありながら「泣き虫桜」と呼んで苛めていたのだが、それは小さな子供にありがちな『好きな子についつい意地悪をしてしまう』という愛情表現の一つであり、加えて『優樹が涙ぐんだりしている顔が大好き』という少し特殊な性癖の持ち主だった為である。"}],"source":"bangumi","sourceCharacterId":"131604"}],"profileFacts":[{"label":"胸围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"24038","sourceWorkId":"8679","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"24038","sourceWorkId":"8679","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"24038","sourceWorkId":"8679","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"24038","sourceWorkId":"8679","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d14e493