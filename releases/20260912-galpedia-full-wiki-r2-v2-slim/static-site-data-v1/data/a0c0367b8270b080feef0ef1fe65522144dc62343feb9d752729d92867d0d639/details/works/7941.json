01","name":"聖 少女","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:41109","source":"vndb"},{"creditedName":"聖 少女","creatorId":"vndb:s1001","sourcePersonId":"vndb:s1001","canonicalEntityId":"vndb:s1001","name":"聖 少女","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:41111","source":"vndb"},{"creditedName":"聖 少女","creatorId":"vndb:s1001","sourcePersonId":"vndb:s1001","canonicalEntityId":"vndb:s1001","name":"聖 少女","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:41112","source":"vndb"}]},"cast":[{"characterId":"char_c5301","characterName":"間宮 麻理絵","sourceIds":{"bangumi":[{"characterId":"44388","match":"exact-normalized-name-in-linked-work","subjectId":"23567"}],"egsCharacterIds":["21403"],"vndbCharacterId":"c5301"},"originalCharacterName":"間宮 麻理絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mistress of the mysterious Mamiya Manor. Having lost her wealthy husband many years ago, she consoles herself by playing with the servants she hires to work in the mansion as sexual slaves. Appearing young for her age, she carefully manages her beauty."},{"spoiler":true,"text":"Being both ruthless and manipulative, Marie takes all benefits as much as possible from the servants that she hired. Should a person catches her interest she will make sure that the person never leaves the mansion alive."},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c5301"},{"segments":[{"spoiler":false,"text":"現間宮家の当主にして麻理華と麻理沙の母親。"},{"spoiler":false,"text":"若くして夫を亡くし、何人もの使用人と家族と共に"},{"spoiler":false,"text":"その巨大な屋敷で暮らす女主人。"},{"spoiler":false,"text":"年齢に似合わず、その容姿は意外なほど若さを保っている。"},{"spoiler":false,"text":"美容には特に気を配っており、その若さと美貌を維持する為として、"},{"spoiler":false,"text":"若い男の精液を毎日欠かさず飲む事を日課としている。"}],"source":"egs","sourceCharacterId":"21403","sourceWorkId":"7941","spoiler":false},{"segments":[{"spoiler":false,"text":"間宮財閥のトップに君臨する女帝。若くして夫を亡くした未亡人だが、たぐいまれなる才能と叡智の持ち主で間宮財閥を不動の地位に押し上げた異質な功労者。"},{"spoiler":false,"text":"年齢に似合わず、その容姿は意外なほど若さを保っている。"},{"spoiler":false,"text":"美容には得に気を配っており、その若さと美貌を維持する為として、若い男の精液を毎日欠かさず飲む事を日課としている。"}],"source":"egs","sourceCharacterId":"21403","sourceWorkId":"27966","spoiler":false},{"segments":[{"spoiler":false,"text":"間宮財閥の総帥にして、妖艶なる美しき未亡人。"},{"spoiler":false,"text":"別荘である黒薔薇館の主であり、本家の方は他の娘達に任せて、ここしばらくは娘の真理亜と共に黒薔薇館にて暮らしている。"}],"source":"egs","sourceCharacterId":"21403","sourceWorkId":"30913","spoiler":false},{"segments":[{"spoiler":false,"text":"間宮財閥の総帥にして、妖艶なる美しき未亡人。"},{"spoiler":false,"text":"別送である黒薔薇館の主であり、本家の方は他の娘達に任せて、ここしばらくは娘の真理亜と共に黒薔薇館にて暮らしている。"}],"source":"egs","sourceCharacterId":"21403","sourceWorkId":"32588","spoiler":false},{"segments":[{"spoiler":false,"text":"現間宮家の当主にして麻理華と麻理沙の母親。"},{"spoiler":false,"text":"若くして夫を亡くし、何人もの使用人と家族と共にその巨大な屋敷で暮らす女主人。"},{"spoiler":false,"text":"年齢に似合わず、その容姿は意外なほど若さを保っている。"},{"spoiler":false,"text":"美容には特に気を配っており、その若さと美貌を維持する為として、若い男の精液を毎日欠かさず飲む事を日課としている。"}],"source":"bangumi","sourceCharacterId":"44388"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc6e273ae123e1c5c1efffa0b5aae4f83a2109a5becd1de1f5dc459d442b1155.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46c48dfc413a544cb7d7c54d2b4d61ed1dd2aaa3276751e024d9a813947e352a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23567:44388:13773:1","source":"bangumi"}]},{"characterId":"