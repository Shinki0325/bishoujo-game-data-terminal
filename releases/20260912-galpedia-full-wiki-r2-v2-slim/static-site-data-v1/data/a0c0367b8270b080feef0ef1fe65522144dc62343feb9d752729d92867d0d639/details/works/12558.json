lict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ大学の経済学部に通う二年生。19歳。"},{"spoiler":false,"text":"内気で大人しく、人見知りする性格。"},{"spoiler":false,"text":"異性に対しては余計に意識してしまい、極度の緊張から会話もままならない。"},{"spoiler":false,"text":"主人公はあまり緊張せずに話せる数少ない男友達。"},{"spoiler":false,"text":"大きい胸にコンプレックスを持ち、故に痴漢に遭うことも多く、痴漢に対して悪いイメージしか持っていない。"},{"spoiler":false,"text":"痴漢から守ってもらおうと主人公に護衛をお願いするが……。"}],"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12430","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ大学に通う女子大生。19歳。"},{"spoiler":false,"text":"内気で人見知りするタイプの女の子だったが、主人公に痴漢の真髄を肉体に刻まれ、自らも痴漢サークルに入会。すっかり痴漢の快感にはまってしまい、主人公と痴漢ライフを満喫している。"},{"spoiler":false,"text":"普通のイイトコのお嬢様風だが、サークル活動中だけその内に秘めるいやらしい本性を見せる。"},{"spoiler":false,"text":"基本はマゾだが、サド的な面も持っている。"}],"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12558","spoiler":false},{"segments":[{"spoiler":false,"text":"私立大学経済学部2年生"},{"spoiler":false,"text":"純一と同じ大学の同じ学部に通う女子大生。内気で人見知りな性格で、特に男性相手だと余計に緊張し、会話もままならなくなってしまうが、純一は唯一話せる数少ない男友達。"},{"spoiler":false,"text":"大きな胸にコンプレックスを持っている割りに、無頓着な部分があり、体のラインが 分かりやすい服を着て、図らずも周囲の注目を集めてしまうことあったりする。"},{"spoiler":false,"text":"胸の大きさと大人しそうな印象のせいか、痴漢に遭遇することも少なくないが、その性格のため助けを求めたりすることができず、痴漢には悪いイメージしか持っていない。"},{"spoiler":false,"text":"痴漢から身を守ってもらおうと、純一に護衛をお願いするのだが…。"}],"source":"bangumi","sourceCharacterId":"210291"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12558","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12558","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"15218","sourceWorkId":"1255