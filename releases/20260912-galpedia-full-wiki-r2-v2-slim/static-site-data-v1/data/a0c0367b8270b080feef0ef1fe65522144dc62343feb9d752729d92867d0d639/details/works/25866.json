leLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:141770","source":"vndb"}]},"cast":[{"characterId":"char_c64336","characterName":"各務原 有栖","sourceIds":{"bangumi":[{"characterId":"57864","match":"exact-normalized-name-in-linked-work","subjectId":"219026"}],"egsCharacterIds":["19367"],"vndbCharacterId":"c64336"},"originalCharacterName":"各務原 有栖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"504"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A rich young lady - with an even richer imagination."},{"spoiler":false,"text":"Reiji's classmate, and the top student at their school. Her father is in the National Diet. Everyone tends to regard her as a model student - she's the student council president, after all. The aura of aloofness she gives off has always discouraged Reiji from talking to her."},{"spoiler":false,"text":"She has a hidden secret, however - she's a hardcore otaku, with a special fondness for kids' anime. The fact that she's always had to hide this from her parents, her father being a leading advocate of manga, anime and game censorship, has only served to make her obsession more all-consuming. And, since she can't be open about her hobbies at school either, she's been forced to completely suppress her otaku desires. Believing anime to be the only way she can truly express herself, she's gotten totally hooked on it!"},{"spoiler":false,"text":"Arisu can be extremely paranoid around Reiji, interpreting every little thing he says as a perverted order or threat."},{"spoiler":false,"text":"Of course, she's actually the one inadvertently seducing him! Reiji is the only person she can talk to about otaku stuff, though, so she's more than willing to comply with his \"dirty\" requests in return for his company."},{"spoiler":false,"text":"From English Official site"}],"source":"vndb","sourceCharacterId":"c64336"},{"segments":[{"spoiler":false,"text":"学園のマドンナ。父親が国会議員。"},{"spoiler":false,"text":"生徒会長であり、模範生徒として学園内で表彰もされている。"},{"spoiler":false,"text":"高飛車で冷たい印象があり、本来、零司との接点はなかった。"},{"spoiler":false,"text":"重度のニチアサアニメの隠れオタ。"},{"spoiler":false,"text":"親にも秘密にしているため、かなりこじらせてしまっている。"},{"spoiler":false,"text":"実は、父親がアニメ漫画ゲームの規制派筆頭であり、学園での体面も守るために、かなりオタク欲が抑圧されている。"},{"spoiler":false,"text":"その反動でアニメにどっぷりハマって、本当の自分が出せるのはそこだけだと思っている。"},{"spoiler":false,"text":"思い込みが激しく、ちょっとしたことでも、『自分への命令ね』『そんなことをさせるなんてこのド変態！』"},{"spoiler":false,"text":"などと、強気で誘い受けな面を見せる残念な子。"},{"spoiler":false,"text":"零司のことは、オタクな話ができる唯一の仲間だと思っている。"},{"spoiler":false,"text":"ときどき、エッチなお願いをしてくるのが玉に瑕だと感じている（本人の勘違い+暴走だが）。"}],"source":"egs","sourceCharacterId":"19367","sourceWorkId":"25866","spoiler":false},{"segments":[{"spoiler":false,"text":"学園のマドンナ。父親が国会議員。"},{"spoiler":false,"text":"生徒会長であり、模範生徒として学園内で表彰もされている。"},{"spoiler":false,"text":"高飛車で冷たい印象があり、本来、零司との接点はなかった。"},{"spoiler":false,"text":"重度のニチアサアニメの隠れオタ。"},{"spoiler":false,"text":"親にも秘密にしているため、かなりこじらせてしまっている。"},{"spoiler":false,"text":"実は、父親がアニメ漫画ゲームの規制派筆頭であり、"},{"spoiler":false,"text":"学園での体面も守るために、かなりオタク欲が抑圧されている。"},{"spoiler":false,"text":"その反動でアニメにどっぷりハマって、本当の自分が出せるのはそこだけだと思っている。"},{"spoiler":false,"text":"思い込みが激しく、ちょっとしたことでも、『自分への命令ね』『そんなことをさせるなんてこのド変態！』"},{"spoiler":false,"text":"などと、強気で誘い受けな面を見せる残念な子。"},{"spoiler":false,"text":"零司のことは、オタクな話ができる唯一の仲間だと思っている。"},{"spoiler":false,"text":"ときどき、エッチなお願いをしてくるのが玉に瑕だと感じている（本人の勘違い+暴走だが）。"}],"source":"bangumi","sourceCharacterId":"57864"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"19367","sourceWorkId":"25866","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"19367","sourceWorkId":"25866","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"19367","sourceWorkId":"25866","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"19367","sourceWorkId":"25866","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"19367","sourceWorkId":"25866","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cac0064c9e2993fc2ba5329fb0c39610602cf7f3f43012a172b95bd7f18ac37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc33107bcde79651b8bb81c6266c1652d97cd9c983a9204374aada9abb51e841.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219026:57864:6359:1","source":"bangumi"}]},{"characterId":"char_c64337","characterName":"坂祝 皋","sourceIds":{"bangumi":[{"characterId":"57865","match":"exact-normalized-name-in-linked-work","subjectId":"219026"}],"egsCharacterIds":["19368"],"vndbCharacterId":"c64337"},"originalCharacterName":"坂祝 皋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"404"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A long-haired delinquent, with a short fuse."},{"spoiler":false,"text":"A rowdy girl with long, blonde hair, who tends to get in trouble a lot at school. Short-tempered, she'll kick off arguments with anyone who bothers her in the slightest."},{"spoiler":false,"text":"Arisu's constant warnings regarding Satsuki's behavior and attendance rate fall on deaf ears. Few things annoy her more than Arisu's persistent nagging."},{"spoiler":false,"text":"Satsuki sits behind Reiji in class, and often borrows manga from him - they get along pretty well."},{"spoiler":false,"text":"Edited from English Official site"}],"source":"vndb","sourceCharacterId":"c64337"},{"segments":[{"spoiler":false,"text":"学園で恐れられている金髪ロングの不良娘。"},{"spoiler":false,"text":"ド短気で、売られた喧嘩はまとめ買いするのが信条。"},{"spoiler":false,"text":"生徒会長のアリスに何度か風紀上の問題+出席日数不足などで注意されるが無視している。"},{"spoiler":false,"text":"しかし、アリスは諦めずにしつこいので、心底ウザイと思っている。"},{"spoiler":false,"text":"零司とはクラスの席が前後なので、漫画を借りたりと仲が良い。"}],"source":"egs","sourceCharacterId":"19368","sourceWorkId":"25866","spoiler":false},{"segments":[{"spoiler":false,"text":"学園で恐れられている金髪ロングの不良娘。"},{"spoiler":false,"text":"ド短気で、売られた喧嘩はまとめ買いするのが信条。"},{"spoiler":false,"text":"生徒会長のアリスに何度か風紀上の問題+出席日数不足などで注意されるが無視している。"},{"spoiler":false,"text":"しかし、アリスは諦めずにしつこいので、心底ウザイと思っている。"},{"spoiler":false,"text":"零司とはクラスの席が前後なので、漫画を借りたりと仲が良い。"}],"source":"bangumi","sourceCharacterId":"57865"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"19368","sourceWorkId":"258