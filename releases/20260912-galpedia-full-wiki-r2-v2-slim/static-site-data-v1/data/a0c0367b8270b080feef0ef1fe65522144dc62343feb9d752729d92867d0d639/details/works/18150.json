nfirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園２年生。"},{"spoiler":false,"text":"容姿端麗の美少女で、明るく少し天然が入っている。"},{"spoiler":false,"text":"正義感が強く、困っている人がいたら助けずにはいられない性格。"},{"spoiler":false,"text":"恋愛に関しては奥手で、年上好き。"},{"spoiler":false,"text":"キューティアと呼ばれる正義のヒロイン達の一員で、キューティアピンクに変身する。"}],"source":"egs","sourceCharacterId":"1190","sourceWorkId":"18150","spoiler":false},{"segments":[{"spoiler":false,"text":"学園2年生。 容姿端麗な美少女で、少し天然系で明るい。"},{"spoiler":false,"text":"正義感が強く、困っている人は見過ごせない。"},{"spoiler":false,"text":"恋愛に関しては奥手で、年上好き。"},{"spoiler":false,"text":"正義のヒロイン 『キューティア』 の一員で、キューティアピンクに変身する。"}],"source":"bangumi","sourceCharacterId":"131560"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c1bc556aefe8f9ed567ae5c6c519c18a3d529d057a42951ebc706a3621ffc39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2d62e732b14d71dee199a611e239a080fcd35aca974b682752e57f3ab507b5e.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267563:131560:6016:1","source":"bangumi"}]},{"characterId":"char_c55912","characterName":"下田 芳裕","sourceIds":{"bangumi":[{"characterId":"89977","match":"exact-normalized-name-in-linked-work","subjectId":"267563"}],"egsCharacterIds":["1191"],"vndbCharacterId":"c55912"},"originalCharacterName":"下田 芳裕","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"今回の主人公。"},{"spoiler":false,"text":"戦闘員歴20ン年のメタボに悩む中年男。"},{"spoiler":false,"text":"学校を出て人材派遣会社に就職したが、実はそこは悪の秘密結社サイアークだった。"},{"spoiler":false,"text":"出来の良いヤツは推薦されたり、志願したりで改造人間として出世していったが、主人公は出来も悪く、戦闘員のまま。"},{"spoiler":false,"text":"ＪＫが好きで素人童貞。"},{"spoiler":false,"text":"たまの風俗通いとエロビデオ鑑賞が趣味。"},{"spoiler":false,"text":"通勤途中に見かけたＪＫの女の子（菜乃花）に一目惚れして、心を奪われているが、釣り合う訳がないと諦めていて、見かけるだけでその日一日がハッピー。"}],"source":"egs","sourceCharacterId":"1191","sourceWorkId":"18150","spoiler":false},{"segments":[{"spoiler":false,"text":"コンビニ店の店長。メタボが気になる中年間近で独身。"},{"spoiler":false,"text":"会社を辞めてぶらぶらしていた時に、級友だったオーナーに誘われてコンビニ店の店長になる。"},{"spoiler":false,"text":"店も一時期は調子が良かったが、街の再開発で郊外にバイパス道路ができてからは人の流れが変わり、売り上げは下がる一方で、オーナーからはいつも売り上げのことで怒られてばかりいる。"},{"spoiler":false,"text":"店内に万引き防止という名目で隠しカメラを仕掛けているが、それは主人公の覗き趣味を満足させるために仕掛けられているもの。"}],"source":"bangumi","sourceCharacterId":"89977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ae0c4896c0382bc4fd4205b994ac65ed2a175468a0c0901a46f291cb8d5c586.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9ab75199171aeec99f09c1fb4d7412c97f7287def070f67c317fc559fdee313.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1604","sourceCompanyId":"egs:brand:2939","canonicalEntityId":"vndb:p1604","name":"ブルゲLIGHT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18150:2939","source":"egs"},{"companyId":"vndb:p1604","sourceCompanyId":"vndb:p1604","canonicalEntityId":"vndb:p1604","name":"ブルゲLIGHT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:164339:v12148","source":"vndb"},{"companyId":"vndb:p182","sourceCompanyId":"vndb:p182","canonicalEntityId":"vndb:p182","name":"Blue Gale","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:29981:v12148","source":"vndb"},{"companyId":"vndb:p16