bp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22731:64160:5924:1","source":"bangumi"}]},{"characterId":"char_c31326","characterName":"一之瀬 心","sourceIds":{"bangumi":[{"characterId":"64159","match":"exact-normalized-name-in-linked-work","subjectId":"22731"}],"egsCharacterIds":["9918"],"vndbCharacterId":"c31326"},"originalCharacterName":"一之瀬 心","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"幼い頃より自らの意思で女装をしていて、女装を続けてきた結果として今では外見は見事な美少女に。"},{"spoiler":false,"text":"服は女物しか持っておらず、女性としての身だしなみも完璧。胸パットなども使用。"},{"spoiler":false,"text":"声も低くならず、たいていの人は女の子だと信じて疑わない。"},{"spoiler":false,"text":"ただし、中身は男のそのままで、女の子大好きで、女子の領域に堂々と入っていったりする変態チックなところがある。"},{"spoiler":false,"text":"完璧な女を目指しているが、男の心も持ち合わせていて、本人としてもそこらへんは複雑な思いを抱えているらしいが……。"}],"source":"egs","sourceCharacterId":"9918","sourceWorkId":"15724","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。幼い頃より自らの意思で女装をしていて、その結果として今では外見は見事な美少女に。"},{"spoiler":false,"text":"服は女物しか持っておらず、女性としての身だしなみも完璧。胸パットなども使用。"},{"spoiler":false,"text":"声も低くならず、たいていの人は女の子だと信じて疑わない。"},{"spoiler":false,"text":"ただし中身は男のそのままで、女の子大好きで、女子の領域に堂々と入っていったりする変態チックなところがある。"},{"spoiler":false,"text":"完璧な女を目指しているが男の心も持ち合わせていて、本人としてもそこらへんは複雑な思いを抱えているらしいが……。"},{"spoiler":false,"text":"元は普通の人間だったが、人間界と魔法界が “リンク” した際、魔法を使えるようになった。"},{"spoiler":false,"text":"そのため、魔法使いを教育する学園・桜月学園にこの春から転入することになり、そこでヒロインたちと知り合うことになる。"},{"spoiler":false,"text":"主人公はその魔法の制御が上手くいかず、たびたび暴走してしまう。"},{"spoiler":false,"text":"クシャミひとつで魔法が暴走。主人公の欲望がそのまま忠実に現れ、周りいた女の子を巻き込み風が吹いてスカートを捲りあげたりも。"},{"spoiler":false,"text":"「ふっ、この完璧な女装なら、すでに女といっても過言じゃないだろう！」"}],"source":"bangumi","sourceCharacterId":"64159"}],"profileFacts":[{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"9918","sourceWorkId":"15724","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bb6b81e096956941cb5d9ef56c3b2f7cf339879f0e9751108a1622de92ea3c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d3a236a5c37a1676b6ded92c76d051a5457988bb9c745e104a1cf5762a0fd4e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22731:64159:5075:1","source":"bangumi"}]},{"characterId":"char_vndb_c31324","characterName":"カヤ","sourceIds":{"vndbCharacterId":"c31324"},"originalCharacterName":"カヤ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07dcce843c8a32e33a495cd1c598b23fff09395cb26ba00e6962f9d3266bf9a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2977b5bb86b91e3bb28c37b40158d7d7c024ee7eea0f6981527a59d5e922343d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤乃 理香","creatorId":"vndb:s945","sourcePersonId":"vndb:s945","canonicalEntityId":"vndb:s945","name":"藤乃 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","re