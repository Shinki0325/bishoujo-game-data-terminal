":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wife of the main character, Hayato."},{"spoiler":false,"text":"She is the only daughter of the Hosei family, which is involved in a number of major corporations."},{"spoiler":false,"text":"When she was a university student, Yuto helped her when she was in trouble on the street, and she fell in love with him at first sight."},{"spoiler":false,"text":"Her fierce attraction to him led to a relationship and marriage, despite the difference in their status."},{"spoiler":false,"text":"She has a strong love for Yuto that never wavers, even when her family and friends speak ill of him."},{"spoiler":false,"text":"She never stops believing that she will be able to overcome her love due to the difference in status."},{"spoiler":false,"text":"She is currently trying to have a baby with Yuto."}],"source":"vndb","sourceCharacterId":"c126482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be48de6edb1af444ae32694adb00627536fbbb0c87162d92bd25362b11ed3f88.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/839a892b769484c3ce986d6cce8e1680c27d5554d5ee9baf4a7bc6e08cfca785.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木崎 彩音","creatorId":"vndb:s26317","sourcePersonId":"vndb:s26317","canonicalEntityId":"vndb:s26317","name":"木崎 綾音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94854","source":"vndb"}]},{"characterId":"char_vndb_c126526","characterName":"宝生 勇人","sourceIds":{"vndbCharacterId":"c126526"},"originalCharacterName":"宝生 勇人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the son-in-law of Kotoko."},{"spoiler":false,"text":"He has a serious and humble personality that is hard to believe that he was born in the Ikushima family, which is full of useless people."},{"spoiler":false,"text":"He was madly attracted to Kotoko and ended up marrying her, but he is hurt by the reality of his status difference love."},{"spoiler":false,"text":"The Hosei family treats him harshly on a daily basis, but he remains undeterred and dreams of a future blessed with a loving wife and a child."}],"source":"vndb","sourceCharacterId":"c126526"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c126527","characterName":"幾島 伊佐緒","sourceIds":{"vndbCharacterId":"c126527"},"originalCharacterName":"幾島 伊佐緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Isao Ikushima is Hayato's father."},{"spoiler":false,"text":"He is an unemployed self-proclaimed professional pachinko player and his wife's pimp."},{"spoiler":false,"text":"The more Yuto learns from him and takes him seriously, the more he annoys those around him with his corrupt lifestyle and human skills."},{"spoiler":false,"text":"He embodies the life of a pimp, making his wife dependent on him with techniques that are unimaginable from the outside."}],"source":"vndb","sourceCharacterId":"c126527"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c3f7c10999418bd5c6a348a83b0eef99fbdacbd310c10788d22b3b28a5e896a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/babd65496a6261a90cd46e67083be3c308c5960e8be2cbcbcb4c0268f9e80e54.webp"