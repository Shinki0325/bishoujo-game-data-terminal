terId":"c32145"},{"segments":[{"spoiler":false,"text":"優しい性格でみんなのお姉さん役。"},{"spoiler":false,"text":"主人公の世話役で、神の御使いである主人公に献身的。"},{"spoiler":false,"text":"ごく当たり前のように主人公の下半身までお世話してしまう。"},{"spoiler":false,"text":"それは山深い田舎で過ごしたため、始めて接する都会の男という存在に激しく誤解を抱いているためでもある。"},{"spoiler":false,"text":"巖神と人を介在する巫女として、村のみんなから祭り上げられている。"},{"spoiler":false,"text":"生まれついての癒しのカリスマで圧倒的な支持を得ている。"},{"spoiler":false,"text":"巫女としての職務を全うするため完全に女の子として育てられている。"},{"spoiler":false,"text":"普段は優しいが一度切れると怖い。"},{"spoiler":false,"text":"特に神社や因習を守らない人間には般若面をかぶってお仕置きモードに変貌する。"}],"source":"egs","sourceCharacterId":"10373","sourceWorkId":"15148","spoiler":false},{"segments":[{"spoiler":false,"text":"優しい性格でみんなのお姉さん役。"},{"spoiler":false,"text":"主人公の世話役で、神の御使いである主人公に献身的。"},{"spoiler":false,"text":"ごく当たり前のように主人公の下半身までお世話してしまう。"},{"spoiler":false,"text":"巖神と人を介在する巫女として、村のみんなから祭り上げられている。"},{"spoiler":false,"text":"生まれついての癒しのカリスマで圧倒的な支持を得ており、巫女としての職務を全うするため完全に女の子として育てられている。"},{"spoiler":false,"text":"普段は優しいが一度キレると怖い。"},{"spoiler":false,"text":"特に神社や因習を守らない人間には、般若面をかぶってお仕置きモードに変貌する。"},{"spoiler":false,"text":"「ご奉仕頑張ります。なんでしたら、妊娠するくらいまで！」"}],"source":"bangumi","sourceCharacterId":"12481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f40964bf7cfec86035533c568cba392e374ae23251956125a5face669fc5b3dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c02723f032c06ec3ad0d4f4776676f9e9d585de3610f43ab8668db351c07c32b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:343053:12481:5936:1","source":"bangumi"}]},{"characterId":"char_c32184","characterName":"宗形 巡","sourceIds":{"bangumi":[{"characterId":"19645","match":"exact-normalized-name-in-linked-work","subjectId":"54842"}],"egsCharacterIds":["854"],"vndbCharacterId":"c32184"},"originalCharacterName":"宗形 巡","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hibiki's nephew who is often causing trouble for him, usually with pranks. Blessed with the gift to see into the future; some people on the island treat him like a god because of it. He's a stoic person that doesn't show much emotion often just going with the flow."}],"source":"vndb","sourceCharacterId":"c32184"},{"segments":[{"spoiler":false,"text":"【ダウナー系男の娘巫女】"},{"spoiler":false,"text":"隠津島神社の男の娘巫女。"},{"spoiler":false,"text":"独特のダウナーな雰囲気を持ち、その空気がカリスマとして箔を与えている。"},{"spoiler":false,"text":"勘が非常に鋭く、神をおろす憑巫としての能力がある。"},{"spoiler":false,"text":"明日の天気や魚群の到来を当てることができるため、村民からは神性の巫女としてかなり重宝されている。"},{"spoiler":false,"text":"その一方で、自分の能力にはあまり好意を抱いてない。"},{"spoiler":false,"text":"巫女としての立場を自分に押し付けてくる村の伝承や神話に価値を見出せずにいる。"},{"spoiler":false,"text":"時々、神としての人格が入れ替わる。"},{"spoiler":false,"text":"そのため、神の代理人として島の連中から崇められるのは自分でも諦めている。"},{"spoiler":false,"text":"島の雑事に構わず、一人で出て行った響のことがちょっと羨ましい。"},{"spoiler":false,"text":"響にとっては姪に当たる存在、家の関係でちょっとしこりが残っているため素直になれない。"}],"source":"egs","sourceCharacterId":"854","sourceWorkId":"17970","spoiler":false},{"segments":[{"spoiler":false,"text":"隠津島神社の男の娘巫女。"},{"spoiler":false,"text":"独特のダウナーな雰囲気を持ち、その空気がカリスマとして箔を与えている。"},{"spoiler":false,"text":"勘が非常に鋭く、神を降ろす憑巫としての能力がある。"},{"spoiler":false,"text":"明日の天気や魚群の到来を当てることが出来るため、村民からは神性の巫女としてかなり重宝されている。"},{"spoiler":false,"text":"その一方で、本人は自分の能力にあまり好意を抱いてない。"},{"spoiler":false,"text":"巫女としての立場を自分に押し付けてくる村の伝承や神話に価値を見出せずにいる。"},{"spoiler":false,"text":"時々、神としての人格が入れ替わる。"},{"spoiler":false,"text":"そのため、神の代理人として島の連中から崇められるのは自分でも諦めている。"},{"spoiler":false,"text":"島の雑事に構わず一人で出て行った響のことがちょっと羨ましい。"},{"spoiler":false,"text":"響とは親戚だが、家の関係で少ししこりが残っているため素直になれない。"}],"source":"bangumi","sourceCharacterId":"19645"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c32184","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"854","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"854","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"19645","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dce211483f033166f86272e8713753fc1a9d2441da1abf31be4ae58a823fb9a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f4fe59ab768273e5d801074fa20316302ca4de6fe6abc60ba44585c973e7459.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:343053:19645:10026:1","source":"bangumi"}]},{"characterId":"char_vndb_c80974","characterName":"雅人","sourceIds":{"vndbCharacterId":"c80974"},"originalCharacterName":"雅人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The chief priest of Kotomusubi shrine."},{"spoiler":false,"text":"Unable to keep up with his sister's advances, he ends up asking for divine intervention, only to end up being courted by a Goddess instead!"},{"spoiler":false,"text":"Our protagonist is between a rock and a hard place. What will he do?"}],"source":"vndb","sourceCharacterId":"c80974"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0b8311cdf61e7f1fa9076921f921c4492c1b2395b7aae05b7ec62786ab82a99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e737736b72fbf50ab10781e3dd6256ce86f01559a4588d1919d07972ffc2cdf3.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c80975","characterName":"円藤 美代","sourceIds":{"vndbCharacterId":"c80975"},"originalCharacterName":"円藤 美代","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's loving (self proclaimed) big sister, perhaps a bit TOO loving at times!"},{"spoiler":false,"text":"Her position as sister is put to the test due to Yui's arrival, and a fierce rivalry ensues."},{"spoiler":false,"text":"A tradition of Kotomusubi states that all shrine maidens should be cross-dressing males in order to not anger the Goddess, Mishiro is one of such maidens."},{"spoiler":false,"text":"For Mishiro, marrying the protagonist is as certain as shooting fish in a barrel."}],"source":"vndb","sourceCharacterId":"c80975"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/461766b7d8cf3f442bd10a77eeedd799b69ae1a0c380e48858f911c3c3e5e124.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a39983bfc7b1315541fa9e2a93615b47ebcd0c4f1be4f8fe5a57aaaf3115c4f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘 美月","creatorId":"vndb:s4602","sourcePersonId":"vndb:s4602","canonicalEntityId":"vndb:s4602","name":"橘 美月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:88588","source":"vndb"}]},{"characterId":"char_vndb_c80976","characterName":"結","sourceIds":{"vndbCharacterId":"c80976"},"originalCharacterName":"結","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Goddess sealed inside Kotomusubi shrine's cave."},{"spoiler":false,"text":"She wields the power to create and strengthen bonds."},{"spoiler":false,"text":"The gods of heaven were afraid she might cause chaos in the world, so they sealed her."},{"spoiler":false,"text":"It took our protagonist's heartfelt wish and a bit of magic to bring her back to this world."},{"spoiler":false,"text":"Seeing the reincarnation of her past love in him, she immediately proclaimed herself as the protagonist's wife."},{"spoiler":false,"text":"Her true name is Kotomusubi Himegami-no-Mikoto."},{"spoiler":false,"text":"Not a woman, but a trap Goddess."},{"spoiler":true,"text":"She is Tamaki's older sister."}],"source":"vndb","sourceCharacterId":"c80976"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7150cbba68a91776d046a62873ae6aecb75eabed81c88dc2148e97361036c80b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de71bacc878ba0ef73cc9796a35b4346ae736d9c5903c321ea00f2880bbd8373.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"麻黒 ほん","creatorId":"vndb:s3372","sourcePersonId":"vndb:s3372","canonicalEntityId":"vndb:s3372","name":"麻黒ほん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:88587","source":"vndb"}]},{"characterId":"char_vndb_c80977","characterName":"緋和","sourceIds":{"vndbCharacterId":"c80977"},"originalCharacterName":"緋和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The incarnation of the Komainu enshrined at Kotomusubi Shrine."},{"spoiler":false,"text":"A glorified errand boy for the gods, so his power isn't particularly exceptional, and despite his usual clumsiness he still claims to be a powerful God."},{"spoiler":false,"text":"His original role is to watch over the sealed Goddess, but since the shrine's going through rough times, he took up a part-time job as a shrine maiden."},{"spoiler":false,"text":"He's a bit of a scatterbrain on all fronts."},{"spoiler":false,"text":"Hinowa has a bit of a sweet tooth, and is accustomed to being fed Mishiro's peerless cuisine."}],"source":"vndb","sourceCharacterId":"c80977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93a469d810cf40f7e30aae6d0bc961953eb51a8820c1e4aa02bbb63cce33dcae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe90930f08652fc85d96f2fe72ee61c6bb5faeaf6d4614855d80d2c4be390748.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"スズナ","creatorId":"vndb:s13137","sourcePersonId":"vndb:s13137","canonicalEntityId":"vndb:s13137","name":"スズナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:88589","source":"vndb"}]},{"characterId":"char_vndb_c91873","characterName":"環","sourceIds":{"vndbCharacterId":"c91873"},"originalCharacterName":"環","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"My powers are not like those of my sister!\""},{"spoiler":false,"text":"Love-Hating Goddess"},{"spoiler":false,"text":"A crossdressing goddess, and sister of Yui. Her true name is Kototama Himegami-no-Mikoto, another kind of Hinky Goddess."},{"spoiler":false,"text":"Descending to Earth with the mission of sealing Yui once more, she's cooperating with Subaru to take over the shrine."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c91873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8aa2628ff8f0cde13e27236956ea33f2446d7a1482c5bb5f3148e42e3252cb5d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5576d192b12a11be2cd0698eaca57642496e268f656e41848fa99749e362f04.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野上 結生","creatorId":"vndb:s3364","sourcePersonId":"vndb:s3364","canonicalEntityId":"vndb:s3364","name":"野上結生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:88586","source":"vndb"}]},{"characterId":"char_vndb_c91874","characterName":"高藤 昴","sourceIds":{"vndbCharacterId":"c91874"},"originalCharacterName":"高藤 昴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"If you have time to talk, then put those hands to work!\""},{"spoiler":false,"text":"Stickler for Discipline"},{"spoiler":false,"text":"The previous chief shrine maiden before Mishiro took over her place."},{"spoiler":false,"text":"Although the shrine's tradition makes her wear women's clothing, she sees it merely as work attire."},{"spoiler":false,"text":"She won't allow love between men and crossdressers under any circumstance, which puts her at odds with Mishiro."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c91874"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf