,"vndbCharacterId":"c84372"},"originalCharacterName":"山綱 芙紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"路線のマスコットキャラクターになりそうな明るい新人女性車掌。"},{"spoiler":false,"text":"鉄道に関する事柄をこよなく愛する趣味が高じ、鉄道会社に就職してしまったほどの電車マニア。"},{"spoiler":false,"text":"そのせいで、可愛いのに彼氏がいない。処女。"},{"spoiler":false,"text":"大好きな「電車」の中での淫らな行為が芙紗に与えたものは…？"},{"spoiler":false,"text":"「はぁんんっ!!　あかんよっ、堪忍して……そ、そない拡げたら……"},{"spoiler":false,"text":"……おツユこぼれて、ズボンびしょ濡れになってまうがなっ……！」"}],"source":"egs","sourceCharacterId":"16024","sourceWorkId":"11725","spoiler":false},{"segments":[{"spoiler":false,"text":"路線の萌えマスコットキャラクターになりそうな外見。だけど『道ちゃん（みっちゃん）』。"},{"spoiler":false,"text":"鉄道会社に就職してしまうほどの電車マニア。そのせいで可愛いのに彼氏がいない。"},{"spoiler":false,"text":"最初は恐怖に身をすくませ拒絶するものの、大好きな 『電車』の中での行為ということに陶酔し、次第に痴漢される悦びを覚えこまされていく。"}],"source":"bangumi","sourceCharacterId":"59031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/624f62e9b2b708dfeb3e5dd842966beb2ce56030d8ec0fa35eae90633d197e08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d61b71484c93c098e1dec9b35829068571f18fc7f1bed7be34b0f00fa552423.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229718:59031:15687:1","source":"bangumi"}]},{"characterId":"char_c84373","characterName":"如月 杏奈","sourceIds":{"bangumi":[{"characterId":"59032","match":"exact-normalized-name-in-linked-work","subjectId":"229718"}],"egsCharacterIds":["16025"],"vndbCharacterId":"c84373"},"originalCharacterName":"如月 杏奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【内向的文学少女】"},{"spoiler":false,"text":"内気でおどおどした感じの文学（特にメルヘンもの）好きな少女。"},{"spoiler":false,"text":"少し妄想癖があるらしく、何をするか解らない雰囲気も合わせ持つ。"},{"spoiler":false,"text":"処女なのだが、官能小説などを読みオナニーに耽るオナニストだとか？"},{"spoiler":false,"text":"「自分が必要とされること」に何か強い思い入れがあるみたいだが……。"},{"spoiler":false,"text":"「（なに、なんなの？　そんな、そんな、やめてぇな、気持ち悪い……"},{"spoiler":false,"text":"……私の股でぐちゅぐちゅしないでぇ……胸もあかん、気持ちよくなる）」"}],"source":"egs","sourceCharacterId":"16025","sourceWorkId":"11725","spoiler":false},{"segments":[{"spoiler":false,"text":"内向的だが何をするか分からないタイプの少女。官能小説などを読みオナニーに耽るオナニスト。"},{"spoiler":false,"text":"最初は見知らぬ男に身体を弄られ恐怖におののくも、痴漢が自分のことを必要としているんだという、生まれて初めて味わう充実感と、オナニー以上の快感に痴漢行為の虜となっていく。"}],"source":"bangumi","sourceCharacterId":"59032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d09134c18f5deb53d97613c806ed5ea6531c6424771f3c9f7425639a3f086460.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79137a31983d187db54505a5866b611930a0be41a426c7d9592dbde289418551.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木下 鈴","creatorId":"vndb:s7535","sourcePersonId":"vndb:s7535","canonicalEntityId":"vndb:s7535","name":"木下 鈴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:17036","source":"vndb"}]},{"characterId":"char_c84374","characterName":"但馬 ひかり","sourceIds":{"bangumi":[{"characterId":"59033","match":"exact-normalized-name-in-linked-work","subjectId":"229718"}],"egsCharacterIds":["16026"],"vndbCharacterId":"c84374"},"originalCharacterName":"但馬 ひかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"企業関連専門の自分の事務所を持つ敏腕弁護士。"},{"spoiler":false,"text":"法律至上主義者で仕事にプライドを持っている。"},{"spoiler":false,"text":"かなりのナイスバディだが、凛とした出で立ちは、隙のない鉄壁ガード女のよう。"},{"spoiler":false,"text":"性感・性欲が異常に強いオナニー好きの処女。"},{"spoiler":false,"text":"最近残業が多くて欲求不満気味のようだ。"},{"spoiler":false,"text":"「ど……どアホっ！　嬉しいわけあらへん！　あんたみたいな……"},{"spoiler":false,"text":"ウジ虫のような痴漢の貧相なモノを入れられて悦ぶ女なんておらへんっ！"},{"spoiler":false,"text":"そもそも、息が臭いんや！」"}],"source":"egs","sourceCharacterId":"16026","sourceWorkId":"11725","spoiler":false},{"segments":[{"spoiler":false,"text":"事務所へ通勤。最近残業が多くてオナニーができず、欲求不満気味。"},{"spoiler":false,"text":"事務所の者はみんな無能で、自分のことを考えてくれる者など誰もいないと憤っている。"},{"spoiler":false,"text":"最初は痴漢をたしなめるつもりだったが、次第に自分の辛さを分かってくれる痴漢の優しさにほだされて、痴漢にのめり込んでいく。"}],"source":"bangumi","sourceCharacterId":"59033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12d0c91dff25e19047a17bfac6a84efbfb4c20b81234064e3a6e7df1a7d8f2d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8175ddb59c2203fe0060bd5fefc0d0a8f0203dcb9d7d2f09126e94c745b121f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229718:59033:5669:1","source":"bangumi"}]},{"characterId":"char_vndb_c125466","characterName":"御堂 明博","sourceIds":{"vndbCharacterId":"c125466"},"originalCharacterName":"御堂 明博","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":