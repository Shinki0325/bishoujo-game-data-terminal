,"source":"vndb"}]},"cast":[{"characterId":"char_vndb_c1005","characterName":"征夜 ましろ","sourceIds":{"vndbCharacterId":"c1005"},"originalCharacterName":"征夜 ましろ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mashiro is Shinya’s neighbor, childhood friend and best friend. She is a pretty normal girl with hidden feelings for Shinya, making her a bit of an underdog. But in spite of overwhelming obstacles and her own lack of self-confidence, she tries her best whether in the pursuit of love or fulfilling the duties of being a “good” Santa. Despite the fact that she was born into a family following the Christmas tradition, she acquired a fear of heights which makes her completely helpless when riding a flying sleigh."},{"spoiler":false,"text":"From m3rryweather's review"}],"source":"vndb","sourceCharacterId":"c1005"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1f1c78075915df2b0448ec92a064e0a8388c4332e4d50b917834fb780bb32c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2932023124ae5cb9a48afe7c1335429d41885b2fc8f0298f74de94ca0d46cf63.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"有栖川 みや美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11873","source":"vndb"}]},{"characterId":"char_vndb_c1006","characterName":"乙樹 キララ","sourceIds":{"vndbCharacterId":"c1006"},"originalCharacterName":"乙樹 キララ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kirara is the tsundere bishoujo from Finland that Shinya meets in the shopping district. She takes great pride in her work as a Santa and finds it insulting that the Seiya family didn’t follow their duties for the past ten years. Because of Mashiro’s inexperience and insistence of becoming a Santa, Kirara “attempts” to train her for the fateful day. If cornered with pressure, Kirara can lose her head and do some pretty crazy stuff."},{"spoiler":false,"text":"From m3rryweather's review"}],"source":"vndb","sourceCharacterId":"c1006"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1aff9ec907fdb80b457be34403690a5b18aa47076a27378cc4ec5f7951ff1fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6ce17e42a9fb4d0fd027300445034fc0eb938ebf037f3e9e2af06fdf3ab5b39.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11874","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p273","sourceCompanyId":"egs:brand:1888","canonicalEntityId":"vndb:p273","name":"Whirlpool","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:11907:1888","source":"egs"},{"companyId":"vndb:p273","sourceCompanyId":"vndb:p273","canonicalEntityId":"vndb:p273","name":"ワールプール","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:166137:v1321","source":"vndb"},{"companyId":"vndb:p273","sourceCompanyId":"vndb:p273","canonicalEntityId":"vndb:p273","name":"ワールプール","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:rele