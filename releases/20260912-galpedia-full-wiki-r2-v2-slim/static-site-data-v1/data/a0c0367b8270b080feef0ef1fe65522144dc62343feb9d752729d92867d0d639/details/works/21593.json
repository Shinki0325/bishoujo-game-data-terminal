aff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104660","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c32583","characterName":"藤枝 ネリ","sourceIds":{"vndbCharacterId":"c32583"},"originalCharacterName":"藤枝 ネリ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"2nd year high school student."},{"spoiler":false,"text":"She used to live in the poor district, but because of her father's sudden disappearance, Neri transferred into the private Kaikyuu Academy. Cheerful and docile, she fights on when faced with difficulties. Since she was raised with a lot of love, she has a straightforward personality and doesn't understand what it means to be doubtful or distrustful of others. She's good at housework."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32583"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79e41d1732e32e539b5de8be9bedf01aa6612aec81154aff38aac971017c02a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf94fa45a96b5677e69b8078f18dd0c89fc545019245fe819c9ad5c859ef7430.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c32584","characterName":"鷹嶺 陸","sourceIds":{"vndbCharacterId":"c32584"},"originalCharacterName":"鷹嶺 陸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"706"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 3rd year student belonging to \"The Roses in Full Bloom\" class."},{"spoiler":false,"text":"The noble son of the Takamine Zaibatsu. Since he's particularly distinguished, Riku is called \"Aka Bara-sama\" (\"Lord Red Rose\"). He's haughty and unskilled in relaying his true feelings. Having extreme pride in himself, he's an authoritarian that takes lineages and forms of address very seriously. Due to this, his propensity to speak to others like he believes they're fools stands out. When it comes to people he takes a liking to, an inept side of him shows as he's overly aggressive towards them."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32584"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e9694e1358571ccd6813cedac2d535dec7561250f4961a54f931106129649ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc0fac7d0588fc7480241039143839c299fd11ae03ce5bb24d5ed2d3612c8ee9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浪川 大輔","creatorId":"vndb:s135","sourcePersonId":"vndb:s135","canonicalEntityId":"vndb:s135","name":"浪川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55998","source":"vndb"}]},{"characterId":"char_vndb_c32585","characterName":"鷺ノ宮 レイ","sourceIds":{"vndbCharacterId":"c32585"},"originalCharacterName":"鷺ノ宮 レイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"610"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 3rd year student belonging to \"The Roses in Full Bloom\" class."},{"spoiler":false,"text":"The second oldest son of the Saginomiya family, whose members have Imperial blood running through their veins. Since Rei, like Riku, has a large profile within the academy, Rei is called \"Haku Bara-sama\" (\"Lord White Rose\"), and is a much-loved figure. He's kind to anybody regardless of their social class, but does not readily show others his true feelings. In spite of his refined appearance, Rei has a large interest in mechanical engineering. As a hobby, he assembles robots."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32585"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4ba9bbf876128a9ac512c3a195131c8a0bf6c9f5e903df57bebb69703ac89844.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a45531d8fdc9c81dd81a69a7f2c97ef417649c43578a2be1158a71bda0e0ebdf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 良平","creatorId":"vndb:s382","sourcePersonId":"vndb:s382","canonicalEntityId":"vndb:s382","name":"木村 良平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56001","source":"vndb"}]},{"characterId":"char_vndb_c32586","characterName":"加地 壱波","sourceIds":{"vndbCharacterId":"c32586"},"originalCharacterName":"加地 壱波","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1022"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 2nd year student belonging to \"The Nameless Honeybees\" class."},{"spoiler":false,"text":"Ichiha has a friendly nature and doesn't shy away from joining in on the fun. Even so, he's a calculating young man and knows how to get by in the world. He's prone to abruptly changing his attitude to suit the situation he's in or who he's around. Ichiha loves girls, and is always surrounded by his \"fans\". There's no telling how many girls he left broken-hearted in his wake as the school's #1 playboy. Belonging to the theatre club, he polishes his acting skills everyday."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32586"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/986aa6fd639cfd0ecb6d46c1ca271cf431b4acdabef480580adcbef5cf93012c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1febae8416ddf0b6a83d5b87b12ad130c438063eda0d11dc5c82173c0da873c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柿原 徹也","creatorId":"vndb:s80","sourcePersonId":"vndb:s80","canonicalEntityId":"vndb:s80","name":"柿原 徹也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55997","source":"vndb"}]},{"characterId":"char_vndb_c32587","characterName":"七瀬 十矢","sourceIds":{"vndbCharacterId":"c32587"},"originalCharacterName":"七瀬 十矢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"808"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 2nd year student belonging to \"The Forgotten Stones\" class."},{"spoiler":false,"text":"The leader of \"The Resistance\", an organisation which goes against the academy's system. A frank and cheerful person, but a little short-tempered. Possessing a firm sense of justice, he can't overlook injustices or those who are troubled. He has his doubts about the school's deeply-rooted caste system and the reason for \"The Ignored Stones'\" existence. Wearing \"The Roses in Full Bloom's\" uniform blazer without permission, he goes against the school's rules head-on with a fearless attitude."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32587"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1d5242eb71510a508dad12d31ba65708c17e8b94f90f1cfb0c82befad3418b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c3255ae83610aa862c586e7529a87b7765bf9c26c675376a13545132b05f587.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前野 智昭","creatorId":"vndb:s64","sourcePersonId":"vndb:s64","canonicalEntityId":"vndb:s64","name":"前野 智昭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55996","source":"vndb"}]},{"characterId":"char_vndb_c32588","characterName":"五十嵐 ハル","sourceIds":{"vndbCharacterId":"c32588"},"originalCharacterName":"五十嵐 ハル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1102"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 1st year student in \"The Ignored Stones\" class."},{"spoiler":false,"text":"Reticent and curt, you can't tell what he's thinking. However, on the occasion that Haru does open his mouth, he proves to be quite sharp-tongued. His \"medieval\" appearance coupled with his low social standing makes him a target of bullying- he is constantly injured. He hardly ever interacts with others, but is often seen with Toya, as Toya comes and talks to him."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0869064fcbfab86008af7e1419fd0262b3cc70ff5f3731036c7d9d917bcd6496.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/438f9f238f4dda12ff932019f05e67826a697dfafb7fe36f4c31d9673c76b721.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川 界人","creatorId":"vndb:s4435","sourcePersonId":"vndb:s4435","canonicalEntityId":"vndb:s4435","name":"石川 界人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56004","source":"vndb"}]},{"characterId":"char_vndb_c32589","characterName":"女王","sourceIds":{"vndbCharacterId":"c32589"},"originalCharacterName":"女王","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"In the school town isolated from the outside world, she sits at the very top of the social hierarchy, wielding absolute power over anybody and everybody else. The students and teachers call her \"Queen\", and they're in awe of her. As well as the students' social classes, the Queen also holds the right to decide anything that goes on in the school. Even teachers aren't able to disobey her. Wearing an extravagent dress and wrapping herself in her veil, her real name or face, as well as everything else about her, is shrouded in mystery."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32589"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd6eee537178cae35287bbe40b28ebe1c45ca569bf96b0418cc14c3415a8afcb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76fff374bdaa3a82821cc94a79c719ead7fd4216717bd1524bec8046e03e7c25.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高口 幸子","creatorId":"vndb:s261","sourcePersonId":"vndb:s261","canonicalEntityId":"vndb:s261","name":"高口 幸子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56000","source":"vndb"}]},{"characterId":"char_vndb_c32590","characterName":"鏑木 蒼一郎","sourceIds":{"vndbCharacterId":"c32590"},"originalCharacterName":"鏑木 蒼一郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The headmaster of Kaikyuu Academy."},{"spoiler":false,"text":"He's at the top of the worldwide enterprise, the Kaburagi Group. Wishing to fulfill his teaching ideals, he founded this academy. Though his work keeps him very busy, he always kindly watches over new student Neri, as well as everyone else. He was an acquaintance of Neri's disappeared father, and also invited her to attend Kaikyuu Academy."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32590"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cf11c1e757d9a962c6401449f7c31beb24d8f15fce4dd67204976590f8ad487.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5cfc7250e970c48527877e55b76daefd22a1df6198faad6a256c8630afa6b15.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56002","source":"vndb"}]},{"characterId":"char_vndb_c32591","characterName":"エドワード 高崎","sourceIds":{"vndbCharacterId":"c32591"},"originalCharacterName":"エドワード 高崎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The school nurse, and also a counselor."},{"spoiler":false,"text":"Friendly and easy to talk to, he's regarded as something of an older brother figure. The students call him \"Ed-sensei\". Since he has a good and open nature regardless of who he's talking to, Edward often finds himself a confidant of many students. Especially soft on female students, he looks out for the newcomer Neri. Edward is half-Chariot, half-Japanese."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c32591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5ba0cf728dc44cfa2d052ce14ed79de4269b116cd54e5a17d49b2ed4029eef18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b96b6915e86ba23cfb8585922ffefd2993b2618b95271dffb2637a6e481d569f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三木 眞一郎","creatorId":"vndb:s252","sourcePersonId":"vndb:s252","canonicalEntityId":"vndb:s252","name":"三木 眞一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55999","source":"vndb"}]},{"characterId":"char_vndb_c32604","characterName":"八木沢 萌花","sourceIds":{"vndbCharacterId":"c32604"},"originalCharacterName":"八木沢 萌花","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 2nd year student in \"The Nameless Honeybees\" class."},{"spoiler":false,"text":"Moeka is the first female student that Neri spoke to when she transferred to the academy. She's also a 2nd year in \"The Nameless Honeybees\" class like Neri, and acts as her helper of sorts. Moeka has a cheerful and positive personality. Good at taking care of others, she helps and supports Neri in various ways, such as helping Neri learn the academy's rules when she was overwhelmed by the sudden changes in her environment, taking her shopping and accompanying her to the café."},{"spoiler":false,"text":"Moeka greatly desires to improve her social standing, and is currently aiming to ascend to the \"Roses in Full Bloom\" rank. She is completely devoted in self-improvement."},{"spoiler":false,"text":"Translation of her official website character profile."}],"source":"vndb","sourceCharacterId":"c32604"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f812ebc342b548e5fb478c52a61cd85d6af3e397c858bae372c39484eaa0059b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5363500ec7f921f4133929e02269c434517dfb56b424c3d31f7cafe5f1770be7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"塙 愛美","creatorId":"vndb:s4580","sourcePersonId":"vndb:s4580","canonicalEntityId":"vndb:s4580","name":"塙 愛美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56005","source":"vndb"}]},{"characterId":"char_vndb_c32605","characterName":"玖珂 参月","sourceIds":{"vndbCharacterId":"c32605"},"originalCharacterName":"玖珂 参月","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 2nd year student belonging to \"The Roses in Full Bloom\" class."},{"spoiler":false,"text":"Mitsuki is a 2nd year student of \"The Roses in Full Bloom\" class whose extraordinary beauty catches everyone's eye. She is Shin'ichi's younger sister. Her exceptional good looks, combined with her eccentric speech and conduct, possess a bewitching allure that has aggressively seized the hearts of many male students. Her fanatical admirers call her \"Princess\" as they revere her from afar. It appears that Mitsuki is infatuated with Takamine Riku. However, at the moment, her approaches to him haven't been successful."},{"spoiler":false,"text":"Translation of her official website character profile."}],"source":"vndb","sourceCharacterId":"c32605"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4888e262d7d5cc2252bb851b9c54f6c6d920f14bbd5248c10d45b2ff374f8dae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa84fecec31aebc451194c1bfb9ab53d33b7dc5be3d6c3904ac3d7743364a5d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"志水 由佳","creatorId":"vndb:s4728","sourcePersonId":"vndb:s4728","canonicalEntityId":"vndb:s4728","name":"志水 由佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56006","source":"vndb"}]},{"characterId":"char_vndb_c32606","characterName":"玖珂 真一","sourceIds":{"vndbCharacterId":"c32606"},"originalCharacterName":"玖珂 真一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 3rd year student in \"The Roses in Full Bloom\" class."},{"spoiler":false,"text":"Shin'ichi is Mistuki's older brother of one year. Since he perceives Takamine Riku as his rival, there are whispers by everyone around him that he's aiming for Riku's \"Red Rose\" spot. He dearly treasures Mitsuki, and is very frank about his unhappiness of Riku not reciprocating his younger sister's romantic interests."},{"spoiler":false,"text":"Translation of his official website character profile."}],"source":"vndb","sourceCharacterId":"c32606"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc0610c362595658dbf7eab0edde5668ef48dcffc55c2b1e19b1c8deb5c9986b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ab1d65b6fdeb39a4460cef3929ee930e24c14aa9fd5ba96a214ddb807908418.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山中 真尋","creatorId":"vndb:s457","sourcePersonId":"vndb:s457","canonicalEntityId":"vndb:s457","name":"山中 真尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56003","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p793","sourceCompanyId":"egs:brand:2399","canonicalEntityId":"vndb:p793","name":"Daisy2","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21593:2399","source":"egs"},{"companyId":"vndb:p7475","sourceCompanyId":"vndb:p7475","canonicalEntityId":"vndb:p7475","name":"欢乐百世","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:152446:v13905","source":"vndb"},{"companyId":"vndb:p7475","sourceCompanyId":"vndb:p7475","canonicalEntityId":"vndb:p7475","name":"欢乐百世","roleCodes":["publisher"