alue":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"別次元から主人公を殺す（？）ためにやってきたエージェント。"},{"spoiler":false,"text":"外見はこちらの次元の女の子と変わらない。"},{"spoiler":false,"text":"真面目で、何事にも一生懸命だが、短絡的で怒りっぽく、思い込みも激しい。"},{"spoiler":false,"text":"さらに頑固で融通が利かず、暴走しやすく、あまり人の話も聞かない、意外に困ったちゃん。"}],"source":"egs","sourceCharacterId":"17824","sourceWorkId":"11010","spoiler":false},{"segments":[{"spoiler":false,"text":"平行世界からやってきた別の世界のエージェント。"},{"spoiler":false,"text":"戦闘と諜報活動に長ける……"},{"spoiler":false,"text":"はずだが重大すぎる任務のプレッシャーからか、"},{"spoiler":false,"text":"おっちょこちょいな失敗を繰り返してしまう。"},{"spoiler":false,"text":"本当は真面目で優しい女の子だが、任務となると別。"},{"spoiler":false,"text":"一生懸命のあまり、短絡的で怒りっぽい性格に変わる。"},{"spoiler":false,"text":"思いこみも激しく、頑固で融通は利かない。"},{"spoiler":false,"text":"おまけに、暴走しやすく、あまり人の話を聞かない。"}],"source":"bangumi","sourceCharacterId":"219064"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c09648b15e431e85ec622c7fa27948f31dbfe9336139dc94b604d5163813c92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df02494b409d75d8d7a04f09b60a1d1d4490de45dc30d029280b255d4c25971c.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217799:219064:22331:1","source":"bangumi"}]},{"characterId":"char_vndb_c62536","characterName":"Nabi","sourceIds":{"vndbCharacterId":"c62536"},"originalCharacterName":"Nabi","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5433c5e5a4d49885bb024f4a6550d026db9ec81d41