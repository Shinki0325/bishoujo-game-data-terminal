ditedName":"こだまプロダクト","creatorId":"vndb:s19962","sourcePersonId":"vndb:s19962","canonicalEntityId":"vndb:s19962","name":"こだまプロダクション","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:40296","source":"vndb"},{"creditedName":"SaQ:Ra","creatorId":"vndb:s23195","sourcePersonId":"vndb:s23195","canonicalEntityId":"vndb:s23195","name":"咲蘭","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:40297","source":"vndb"},{"creditedName":"株式会社メディアフォース","creatorId":"vndb:s35619","sourcePersonId":"vndb:s35619","canonicalEntityId":"vndb:s35619","name":"株式会社メディアフォース","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:40298","source":"vndb"}]},"cast":[{"characterId":"char_c1867","characterName":"クド","sourceIds":{"bangumi":[{"characterId":"361","match":"exact-normalized-name-in-linked-work","subjectId":"125131"},{"characterId":"361","match":"exact-normalized-name-in-linked-work","subjectId":"4502"},{"characterId":"361","match":"exact-normalized-name-in-linked-work","subjectId":"84256"},{"characterId":"361","match":"exact-normalized-name-in-linked-work","subjectId":"845"}],"egsCharacterIds":["605"],"vndbCharacterId":"c1867"},"originalCharacterName":"クド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"612"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kudryavka is a girl who is a quarter Japanese, and three-quarters Russian. Her full Russian name is Kudryavka Anatolyevna Strugatskaya. Her grandmother is Japanese. Her grandfather was crazy about Japanese culture and per his influence on her, she came to know much about Japanese culture too, including the language. Despite having a poor handle on the English language, she was able to skip a year in school due to credits obtained through studying abroad. She is Riki's classmate and is in the newly-formed home economics club due to an invitation of the head of the dormitory she lives at with the other characters. Kudryavka and the dormitory head are the only two members, and since the latter is often too busy, club activities are suspended and Kudryavka is the sole active member of a club on the verge of being disbanded."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1867"},{"segments":[{"spoiler":false,"text":"帰国子女だが、日本びいきの祖父の影響で、ものすごく日本人的。"},{"spoiler":false,"text":"それを気にして無理やり英語でしゃべろうとする。"},{"spoiler":false,"text":"実は年下。周囲にはマスコット的存在として愛され（弄られ）ている。"},{"spoiler":false,"text":"愛称は『クド』。"}],"source":"egs","sourceCharacterId":"605","sourceWorkId":"10488","spoiler":false},{"segments":[{"spoiler":false,"text":"【えきぞちっく（自称）なマスコット】"},{"spoiler":false,"text":"「わふー」が口癖なクォーターの女の子。"},{"spoiler":false,"text":"帰国子女だが、日本びいきの祖父の影響で、ものすごく日本人的。"},{"spoiler":false,"text":"彼女はそれを気にして無理やり英語でしゃべろうとするが…。"},{"spoiler":false,"text":"両親は著名な宇宙開発研究者で、彼女は一人日本で生活している。"},{"spoiler":false,"text":"周囲にはマスコット的存在として愛され（弄られ）ている。愛称は『クド』。"}],"source":"egs","sourceCharacterId":"605","sourceWorkId":"13525","spoiler":false},{"segments":[{"spoiler":false,"text":"エキゾチック（自称）なマスコット"},{"spoiler":false,"text":"「わふー」 が口癖なクォーターの女の子。"},{"spoiler":false,"text":"帰国子女だが、日本びいきの祖父の影響で、ものすごく日本人的。"},{"spoiler":false,"text":"彼女はそのことを気にして、無理やり英語でしゃべろうとするが……。"},{"spoiler":false,"text":"両親は著名な宇宙開発研究者で、彼女はひとり日本で生活している。"},{"spoiler":false,"text":"周囲にはマスコット的存在として愛され（弄られ）ている。"},{"spoiler":false,"text":"愛称は 「クド」。"},{"spoiler":false,"text":"「もうっ、リキ。ひょっとして昨日はちゅっちゅ足りませんでしたかっ」"}],"source":"egs","sourceCharacterId":"605","sourceWorkId":"18643","spoiler":false},{"segments":[{"spoiler":false,"text":"CV：鈴田美夜子"},{"spoiler":false,"text":"异国情调（自称）的吉祥物"},{"spoiler":false,"text":"虽是归国女，但受祖父日本风的影响，十分像地道的日本人"},{"spoiler":false,"text":"很在意这点而强行使用英语讲话"},{"spoiler":false,"text":"实际上年龄很小。被周围人当作吉祥物般宠爱（玩弄）着"},{"spoiler":false,"text":"爱称是『クド』"}],"source":"bangumi","sourceCharacterId":"361"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6a91544136db5f0db3299870da31b199cd6524c741adfacf0a3535a6e9a7e66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0ff09e01ad5cada7c2e8b27f7258e013d0989072f384c7518c75f67dfe65131b.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"若林直美","creatorId":"vndb:s446","sourcePersonId":"vndb:s446","canonicalEntityId":"vndb:s446","name":"若林 直美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4502:361:3934:1","source":"bangumi"}]},{"characterId":"char_c1868","characterName":"かなちゃん","sourceIds":{"bangumi":[{"characterId":"367","match":"exact-normalized-name-in-linked-work","subjectId":"125131"},{"characterId":"367","match":"exact-normalized-name-in-linked-work","subjectId":"845"}],"egsCharacterIds":["18697"],"vndbCharacterId":"c1868"},"originalCharacterName":"かなちゃん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1013"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kanata is a girl at Riki's school and is the public morals chairman, which means when Haruka causes trouble, Kanata must run after her. To help Kanata, Kudryavka offered up her two dogs Strelka and Belka to patrol the school grounds and help in hunting down Haruka when she causes trouble."},{"spoiler":true,"text":"Kanata is Haruka's twin sister, though this is only revealed later. She acts extremely cold to Haruka, although it is later revealed she is forced to treat Haruka coldly by her kinsmen, and actually made efforts to release Haruka from them. Since the only real difference between Haruka and Kanata is their eye color, Kanata uses this to her advantage when she impersonates her sister with colored contacts. Kanata cooks well, while Haruka is very specialized and not as good, and this is one of the few ways to identify her when she is impersonating Haruka."},{"spoiler":true,"text":"In short words, she has the polar opposite personality to Haruka the twin sister."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1868"},{"segments":[{"spoiler":false,"text":"学園の風紀委員長を務める女生徒。"},{"spoiler":false,"text":"融通の利かない無愛想な性格で、冷めたセリフを次々と言い放つ。"},{"spoiler":false,"text":"『風紀を乱す』生徒を執拗に敵対視している。"}],"source":"egs","sourceCharacterId":"18697","sourceWorkId":"10488","spoiler":false},{"segments":[{"spoiler":false,"text":"冷淡、不擅长交际、不客气的风纪委员"},{"spoiler":false,"text":"担任学园风纪委员的女学生"},{"spoiler":false,"text":"不懂通融、不擅交际的性格，接二连三地放出冷淡的话语"},{"spoiler":false,"text":"执拗地敌视『扰乱风纪』的学生"},{"spoiler":false,"text":"在全年龄版中为次要角色，EX中升格为主要角色"}],"source":"bangumi","sourceCharacterId":"367"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bb5cae5d6aee08ab3a936bbc86585741f715b12e1b316529ddb053bd27e5999.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6be8d711bffc674f8fd35972b824125ab842718107c3a544784993b40b3eeb6.webp","width":83,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4502:367:6275:1","source":"bangumi"}]},{"characterId":"char_c192","characterName":"理樹っち","sourceIds":{"bangumi":[{"characterId":"357","match":"exact-normalized-name-in-linked-work","subjectId":"125131"},{"characterId":"357","match":"exact-normalized-name-in-linked-work","subjectId":"4502"},{"characterId":"357","match":"exact-normalized-name-in-linked-work","subjectId":"84256"},{"characterId":"357","match":"exact-normalized-name-in-linked-work","subjectId":"845"}],"egsCharacterIds":["606"],"vndbCharacterId":"c192"},"originalCharacterName":"理樹っち","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"117"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Riki is the fifth member of the Little Busters, and of them, he is seen as the weakest due to his girlish appearance and physical build, but he is the only one that is straightforward and has common sense among them. His parents died when he was very young, and around the same time he was diagnosed with narcolepsy."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c192"},{"segments":[{"spoiler":false,"text":"主人公。少し気弱で友達思いな少年。"},{"spoiler":false,"text":"周囲の騒がしい連中が起こす騒動に巻き込まれてばかりいる。本人はそれがとても楽しい。"},{"spoiler":false,"text":"周りの馬鹿な行動に対するツッコミも重要な役どころ。"}],"source":"egs","sourceCharacterId":"606","sourceWorkId":"10488","spoiler":false},{"segments":[{"spoiler":false,"text":"【異様に賑やかな青春を送る普通の少年】"},{"spoiler":false,"text":"主人公。少し気弱で友達思いな少年"},{"spoiler":false,"text":"。周囲の騒がしい連中が起こす騒動に巻き込まれてばかりいる。"},{"spoiler":false,"text":"本人はそれがとても楽しい。周りの馬鹿な行動に対するツッコミも重要な役どころ。"}],"source":"egs","sourceCharacterId":"606","sourceWorkId":"13525","spoiler":false},{"segments":[{"spoiler":false,"text":"異様に賑やかな青春を送る普通の少年"},{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"少し気弱で友達思いな少年。"},{"spoiler":false,"text":"周囲の騒がしい連中が起こす騒動に巻き込まれてばかりいる。"},{"spoiler":false,"text":"本人はそれがとても楽しい。"},{"spoiler":false,"text":"周りの馬鹿な行動に対するツッコミも重要な役どころ。"},{"spoiler":false,"text":"「僕はクドのそばにいたいし…クドにもそう思って貰いたい」"}],"source":"egs","sourceCharacterId":"606","sourceWorkId":"18643","spoiler":false},{"segments":[{"spoiler":false,"text":"CV：民安ともえ"},{"spoiler":false,"text":"主人公"},{"spoiler":false,"text":"有些懦弱、为朋友着想的少年"},{"spoiler":false,"text":"总是被卷入周围的喧嚣伙伴们引起的骚动中"},{"spoiler":false,"text":"而本人却乐乎其中"},{"spoiler":false,"text":"担任着对周围的愚蠢行动进行吐嘈的重要职务"}],"source":"bangumi","sourceCharacterId":"357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0bde108cddc00bac5ff917f546d46dd1aa86131ad051de857523fca1ec5af71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/840be9d558f521d2d9f8850ada39834405971978f2e208aebfba3d4fbd624d81.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4502:357:5900:1","source":"bangumi"}]},{"characterId":"char_c4857