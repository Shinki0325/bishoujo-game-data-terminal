f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4be9f73f41ff91a9569f27c501fd2081b18f7c5962d5027a391655d33317f6cf.webp","width":162,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20241","characterName":"シィア","sourceIds":{"vndbCharacterId":"c20241"},"originalCharacterName":"シィア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shura's deceased true love. Shea was kidnapped by an evil religious sect and was offered as a sacrifice to give birth to Deirdre. When Shura found her, she was already dead. Shea did not only die, but her soul was also consumed by Deirdre removing her from the cycle of reincarnation. Shea is never coming back."}],"source":"vndb","sourceCharacterId":"c20241"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c08566b3800e787eded045e0ca10ee98e94adeac767f51ec3712a1209e8a2d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/319d91bc1ea6c191a77794fcb6100cc488417242738fd6cc1b5d0a6b760c6a46.webp","width":256,"height":160,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20245","characterName":"桂木 花梨","sourceIds":{"vndbCharacterId":"c20245"},"originalCharacterName":"桂木 花梨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl that looks just like Shura's lost love. She goes to a Catholic private high school andknows magic. Both of her parents died, so she moved in with Arima, who became her foster father. She gets wings later on in the story."},{"spoiler":false,"text":"Karin is kind of stubborn and doesn't always go about things in the most intelligent of ways, but she is still a kind and gentle person overall. When she gets to know Shura, she becomes self-conscious of her resemblance to his lost love and worries that she's a cruel remind of his past. She's the heroine of the story."}],"source":"vndb","sourceCharacterId":"c20245"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c60dcb1cabd59ed25dbe6bc377f39eef6def5dbc3ef6d6303f178421b4dc11d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47fc2a0cfba8b18c37177334306114e065c86e5c63ad732b051ea220796a7ace.webp","width":232,"height":148,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20247","characterName":"草薙丸","sourceIds":{"vndbCharacterId":"c20247"},"originalCharacterName":"草薙丸","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A spirit that lives inside of Shura's sword. She gives him advice and helps him perform magic that can defeat the duendy. She's also a sacred treasure."}],"source":"vndb","sourceCharacterId":"c20247"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/450b28935261570bf635b3b0eed288544b6b713351b03ee87c85743b01e9a693.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2ba711451b1