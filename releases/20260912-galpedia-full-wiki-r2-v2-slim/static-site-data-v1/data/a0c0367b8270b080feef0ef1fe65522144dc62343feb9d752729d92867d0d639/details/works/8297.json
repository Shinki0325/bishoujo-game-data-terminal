とするが…。"}],"source":"egs","sourceCharacterId":"25042","sourceWorkId":"8297","spoiler":false},{"segments":[{"spoiler":false,"text":"戒の家の隣に住む同級生の少女。"},{"spoiler":false,"text":"世話好きということもあるが、一人暮らしの戒を心配して毎朝起こしにくる。"},{"spoiler":false,"text":"スポーツが得意で剣道部に所属しているが、勉強がまるでダメ。ついでに家事（特に料理）もダメ。"}],"source":"bangumi","sourceCharacterId":"55228"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"25042","sourceWorkId":"8297","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"25042","sourceWorkId":"8297","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"25042","sourceWorkId":"8297","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"25042","sourceWorkId":"8297","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf0e6453caecaab570f6699c0072491ab7681a83e2c80d62a2e1ee398fc3ae5f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c64fe317e6a80c748c8868397f8324c4d4af7d418156ae185202a81beb0043c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217675:55228:19411:1","source":"bangumi"}]},{"characterId":"char_c2761","characterName":"アンジェラオルシーニ","sourceIds":{"bangumi":[{"characterId":"55229","match":"exact-normalized-name-in-linked-work","subjectId":"217675"}],"egsCharacterIds":["25043"],"vndbCharacterId":"c2761"},"originalCharacterName":"アンジェラオルシーニ","characterNameSource":null,"role":"primary","status":"source-only-