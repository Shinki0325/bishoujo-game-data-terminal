tityStatus":"source-native","relationId":"vndb:vn-staff:87151","source":"vndb"},{"creditedName":"MEDIAMUSE INC.","creatorId":"vndb:s32617","sourcePersonId":"vndb:s32617","canonicalEntityId":"vndb:s32617","name":"MEDIAMUSE INC.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87152","source":"vndb"},{"creditedName":"HIDEO TAKANO","creatorId":"vndb:s32618","sourcePersonId":"vndb:s32618","canonicalEntityId":"vndb:s32618","name":"高野 秀夫","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87154","source":"vndb"},{"creditedName":"MAKOTO ARAZEKI","creatorId":"vndb:s32619","sourcePersonId":"vndb:s32619","canonicalEntityId":"vndb:s32619","name":"MAKOTO ARAZEKI","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87155","source":"vndb"},{"creditedName":"KOUJI NAKAMURA","creatorId":"vndb:s32621","sourcePersonId":"vndb:s32621","canonicalEntityId":"vndb:s32621","name":"KOUJI NAKAMURA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87157","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_57071","characterName":"Suzune Ayase","sourceIds":{"bangumi":[{"characterId":"57071","match":"source-roster","subjectId":"195600"},{"characterId":"57071","match":"source-roster","subjectId":"83901"}]},"originalCharacterName":"Suzune Ayase","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"10"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"父亲是居住在斯德哥尔摩的大学教授，是动物行动学的权威，"},{"spoiler":false,"text":"玲音和母亲在去找父亲的中途遭遇飞机墬落事故。"},{"spoiler":false,"text":"性格开朗，偶尔有点固执。不知道是否和她父亲的职业有关系。"},{"spoiler":false,"text":"她很会和动物交流，也比较容易适应自然的环境，"},{"spoiler":false,"text":"因为还是小孩子，好奇心较强。"},{"spoiler":false,"text":"好奇心ぉうゼいな活発な女の子。"},{"spoiler":false,"text":"動物と接するのがうまく環境に順応するのも早い。"}],"source":"bangumi","sourceCharacterId":"57071"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"57071","value":"ハンバーガー"},{"label":"趣味","source":"bangumi","sourceCharacterId":"57071","value":"ピアノ、園芸"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/4930473dbf74a2eea3c3599ac2591a10a2e9ef226830b0f62a85466e5563d4ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1cfc6f2b8779a43bb0ac4b61363a75eeb192e759bf948fda3966b20fc9377b2.webp","width":145,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_57072","characterName":"Erina Koyanagi","sourceIds":{"bangumi":[{"characterId":"57072","match":"source-roster","subjectId":"195600"},{"characterId":"57072","match":"source-roster","subjectId":"83901"}]},"originalCharacterName":"Erina Koyanagi","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"24"},"bust":{"reviewState":"source-only","source":"bangumi","value":"36"},"hip":{"reviewState":"source-only","source":"bangumi","value":"38"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"24"}},"descriptions":[{"segments":[{"spoiler":false,"text":"全日航国际线空中小姐"},{"spoiler":false,"text":"是此班坠毁班机上的空中小姐，"},{"spoiler":false,"text":"一看她的模样，就知道她是个会对男生施高压的女生。"},{"spoiler":false,"text":"对语言方面很有才华， 对尖端技术也相当了解。"},{"spoiler":false,"text":"运气特别的好，她现在开的车子也是用彩券的奖金买的。"},{"spoiler":false,"text":"她的祖父是4分之1的法国人，自然卷、咖啡色的长发很受男生的欢迎。"}],"source":"bangumi","sourceCharacterId":"57072"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"57072","value":"マリンスポーツ"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbcf189a5976f7ec32b2ecdba719753c436acffdf77a198df22abdcf099fa104.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd8304f6a935629b453b06bd782782a20e2968124eec34d1d6d83460cca371f5.webp","width":146,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_57073","characterName":"Rika Nakajima","sourceIds":{"bangumi":[{"characterId":"57073","match":"source-roster","subjectId":"195600"},{"characterId":"57073","match":"source-roster","subjectId":"83901"},{"characterId":"57073","match":"source-roster","subjectId":"83902"}]},"originalCharacterName":"Rika Nakajima","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"21"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"理工学系学生，打算利用夏天的暑假岛国外去旅行，"},{"spoiler":false,"text":"因此不幸的遇到坠机事故。她的电脑是自己买零件组装成的，"},{"spoiler":false,"text":"OS也是她独创的东西，可说是一个电脑专家。"},{"spoiler":false,"text":"她有S级的赛车驾照，在国内算是个很有名的赛车选手。"},{"spoiler":false,"text":"她个性固执，不能允许任何的妥协，好强的性格缺少协调性。"},{"spoiler":false,"text":"夏休みの海外バカンスを楽しむ予定で"},{"spoiler":false,"text":"あったが今回の亊故に遭遇してしまう。"},{"spoiler":false,"text":"理論的で妥協を許さない性格で、協調性に若干かける。"}],"source":"bangumi","sourceCharacterId":"57073"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"57073","value":"パソコン通信"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8705d6a638a6a2daa562993cbe3e234387e4c41a9c3363ab431accb49d7bf18a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f2918df19ccf417b0599ee2128101e55d256daeb8c24119916aa64950446a8e.webp","width":135,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_57074","characterName":"Shinichirou Takamochi","sourceIds":{"bangumi":[{"characterId":"57074","match":"source-roster","subjectId":"195600"},{"characterId":"57074","match":"source-roster","subjectId":"83901"}]},"originalCharacterName":"Shinichirou Takamochi","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"49"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国立考古学会荣誉会员，"},{"spoiler":false,"text":"经常发表与古代文明有关的精辟问论文及学说，"},{"spoiler":false,"text":"但属于非主流派，有人干脆称她为“异端学者”，"},{"spoiler":false,"text":"为了到加勒比海挖掘古代遗迹而搭上飞机，"},{"spoiler":false,"text":"个性十分积极，是典型的乐观主义者，"},{"spoiler":false,"text":"每一次的考古行动中，都是冲在最前线的，"},{"spoiler":false,"text":"即使有危机也以笑容面对，但并非不知事理的人，"},{"spoiler":false,"text":"有她额头上的皱纹，依稀可见到她坚毅的一面，"},{"spoiler":false,"text":"由于职业的关系，原始生活对他来说不成问题。"}],"source":"bangumi","sourceCharacterId":"57074"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"57074","value":"ハンティング"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e778fcd155fbc05f503d80384990dbf645b1f67b71ecd708f623035c4bd8e9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1da6cdd38ca70fdf68ac805cf7f505370837d42521717671100096bc04f7dfc2.webp","width":145,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_57075","characterName":"Saori Kurashima","sourceIds":{"bangumi":[{"characterId":"57075","match":"source-roster","subjectId":"195600"},{"characterId":"57075","match":"source-roster","subjectId":"83901"}]},"originalCharacterName":"Saori Kurashima","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"17"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"田径社团主将，女子万米赛跑日本记录第四名保持者。"},{"spoiler":false,"text":"为了夏天的“世界大会”而必须去国外参加集训，因此一个人坐飞机。"},{"spoiler":false,"text":"因为睡过头而错过了期末考，所以必须参加补考，"},{"spoiler":false,"text":"没想到补考的时候居然又迟到了，最后只好自己一个人搭飞机！"},{"spoiler":false,"text":"个性开朗活泼，是个很努力，实在的人，且很有耐心。"},{"spoiler":false,"text":"因是运动员，体力，精神力都极佳。对阿徹很信赖。"}],"source":"bangumi","sourceCharacterId":"57075"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"57075","value":"トレッキング、バードウォッチング"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/772d14c99d9831c05244a37665591f6bf5a62d660ddd10d9919a6e15d449f239.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76a5c1e5426290f044d667c84eabe4774980b918b4d2115925ff6a9a061e1be4.webp","width":145,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_57076","characterName":"中村トオル","sourceIds":{"bangumi":[{"characterId":"57076","match":"source-roster","subjectId":"195600"},{"characterId":"57076","match":"source-roster","subjectId":"83901"}]},"originalCharacterName":"中村トオル","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"17"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小时候父母亲遭遇飞机意外而去世。"},{"spoiler":false,"text":"之后被伯父收养，但彼此之间的关系并不太好。"},{"spoiler":false,"text":"因为这个缘故，他一直想脱离日常的生活，"},{"spoiler":false,"text":"所以在这暑假打算到美国去找父亲的朋友。"},{"spoiler":false,"text":"他的个性有一点拗，不愿意让他人窥视他的内心。"},{"spoiler":false,"text":"年纪虽然较轻，却拥有坚强的意志力及独立精神。"}],"source":"bangumi","sourceCharacterId":"57076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae1ade9cd382ee18aa