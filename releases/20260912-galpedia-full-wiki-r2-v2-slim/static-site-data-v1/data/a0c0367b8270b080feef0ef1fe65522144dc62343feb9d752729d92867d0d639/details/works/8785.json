dentityStatus":"auto-confirmed","relationId":"egs:work-creator:108551","source":"egs"},{"creditedName":"黒崎朔夜","creatorId":"vndb:s5137","sourcePersonId":"egs:creator:13053","canonicalEntityId":"vndb:s5137","name":"黒崎朔夜","detail":"主題歌 「Slave Soul」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85112","source":"egs"},{"creditedName":"黒崎 朔夜","creatorId":"vndb:s5137","sourcePersonId":"vndb:s5137","canonicalEntityId":"vndb:s5137","name":"黒崎 朔夜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:27244","source":"vndb"},{"creditedName":"板皮類","creatorId":"vndb:s5830","sourcePersonId":"vndb:s5830","canonicalEntityId":"vndb:s5830","name":"板皮(板皮類)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:27246","source":"vndb"},{"creditedName":"tomsan","creatorId":"vndb:s6343","sourcePersonId":"vndb:s6343","canonicalEntityId":"vndb:s6343","name":"tomsan","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:27248","source":"vndb"},{"creditedName":"け～まる","creatorId":"vndb:s6704","sourcePersonId":"vndb:s6704","canonicalEntityId":"vndb:s6704","name":"け～まる","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:27249","source":"vndb"}]},"cast":[{"characterId":"char_c31635","characterName":"アルフィナ","sourceIds":{"bangumi":[{"characterId":"168845","match":"exact-normalized-name-in-linked-work","subjectId":"83843"}],"egsCharacterIds":["22407"],"vndbCharacterId":"c31635"},"originalCharacterName":"アルフィナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first princess of the kingdom. She is the leader of the knights and trusts Lenard."}],"source":"vndb","sourceCharacterId":"c31635"},{"segments":[{"spoiler":false,"text":"フォートリンデ聖樹国家　第一王女。戦姫と謳われる軍略家でありながら、『聖騎士』と称されるほどの武芸の達人。国を守る騎士たちを率い、王都を攻めてくる魔物と闘い民を守っている。ブロンドが眩しい秀麗な美貌ではあるが、公人としての立ち場を優先するばかりに、 似つかわしくない武人然とした言葉使いをする。気位が高く生真面目な性格で、参謀を務める主人公レナードのことを厳しく評価しがちだが、同時に表には出さない信頼の念も抱いている。"}],"source":"egs","sourceCharacterId":"22407","sourceWorkId":"8785","spoiler":false},{"segments":[{"spoiler":false,"text":"フォートリンデ聖樹国家　第一王女。戦姫と謳われる軍略家でありながら、『聖騎士』と称されるほどの武芸の達人。国を守る騎士たちを率い、王都を攻めてくる魔物と闘い民を守っている。ブロンドが眩しい秀麗な美貌ではあるが、公人としての立ち場を優先するばかりに、 似つかわしくない武人然とした言葉使いをする。気位が高く生真面目な性格で、参謀を務める主人公レナードのことを厳しく評価しがちだが、同時に表には出さない信頼の念も抱いている。"},{"spoiler":false,"text":"弗德里提圣树国家，第一王女。"},{"spoiler":false,"text":"本名是，阿尔菲妮雅 沃德巴特。"},{"spoiler":false,"text":"除了是个军事家，被大家爱称为弗德里提战姬之外，"},{"spoiler":false,"text":"她高超的武技，也让她获得了『圣骑士』的称号。"},{"spoiler":false,"text":"她领导着守护王国的骑士团，保护人民不受外来魔兽所侵害。"},{"spoiler":false,"text":"虽然有着亮眼的金发、出众的外貌以及高高在上的皇室身份，"},{"spoiler":false,"text":"但是说话时的口气却完全是个武门家的样子。"},{"spoiler":false,"text":"高风亮节以及认真的性格，使得他对于雷纳德的行事作风，"},{"spoiler":false,"text":"常常加以严厉审视。"},{"spoiler":false,"text":"虽然没有表现出来，同时却相当地信赖着他。"}],"source":"bangumi","sourceCharacterId":"168845"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"22407","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"22407","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"22407","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"22407","sourceWorkId":"8785","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89587fc9a6f092cab438faa6baeb7b1e803794ea52ecf80c802ab6399fc1f372.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc8f698a49c0c5016108c81b85103ddd25f2404f133b84ac78c2f4100d41b3a9.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:83843:168845:4799:1","source":"bangumi"}]},{"characterId":"char_c31636","characterName":"ユーフィリア・ヴォーデンバーグ","sourceIds":{"bangumi":[{"characterId":"168846","match":"exact-normalized-name-in-linked-work","subjectId":"83843"}],"egsCharacterIds":["22408"],"vndbCharacterId":"c31636"},"originalCharacterName":"ユーフィリア・ヴォーデンバーグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"148cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second princess of the kingdom. She serves as the sacred symbol of the kingdom."}],"source":"vndb","sourceCharacterId":"c31636"},{"segments":[{"spoiler":false,"text":"フォートリンデ聖樹国家　第二王女。聖なる力で枯れた大地の瘴気を浄化する聖樹に祈りを捧げる管理者であり、 調停者である『神姫』の任につく少女。彼女自身の性格は、箱入り娘のように育てられたため、人を疑うことを知らない純真そのもの。教義を遵守し、一般の国民と感覚がずれている部分があるが、根は素直で優しい。幼い頃から兄代わりとして、仕えてくれたレナードに、ほのかな恋心を抱いている。"}],"source":"egs","sourceCharacterId":"22408","sourceWorkId":"8785","spoiler":false},{"segments":[{"spoiler":false,"text":"フォートリンデ聖樹国家　第二王女。聖なる力で枯れた大地の瘴気を浄化する聖樹に祈りを捧げる管理者であり、 調停者である『神姫』の任につく少女。彼女自身の性格は、箱入り娘のように育てられたため、人を疑うことを知らない純真そのもの。教義を遵守し、一般の国民と感覚がずれている部分があるが、根は素直で優しい。幼い頃から兄代わりとして、仕えてくれたレナードに、ほのかな恋心を抱いている。"},{"spoiler":false,"text":"弗德里提里圣树国家，第二王女。"},{"spoiler":false,"text":"本名是，悠菲妮雅 沃德巴特。"},{"spoiler":false,"text":"是为圣树管理人，奉祀着散发出圣洁之力，"},{"spoiler":false,"text":"净化大地瘴气的圣树，并也奉任名为『神姬』的调停者。"},{"spoiler":false,"text":"因为从小就倍受呵护，使她的性格天真无邪，"},{"spoiler":false,"text":"甚至不太会去怀疑别人。"},{"spoiler":false,"text":"虽然在一般的国民心中对她的认识有些偏离，"},{"spoiler":false,"text":"不过她遵循教义，本性善良纯真。"},{"spoiler":false,"text":"她对于从小有如亲哥哥般，随侍一旁的雷纳德"},{"spoiler":false,"text":"抱着些许的爱慕之心。"}],"source":"bangumi","sourceCharacterId":"168846"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"22408","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"22408","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"22408","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"22408","sourceWorkId":"8785","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba5f84b448bc2b64d908cfaab75b69e1ee03482c4739e2e54938e6c284493d22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06abbf07cc2ea74dff593602f6631be584b5305a24bb11e12cdfe75360732bb5.webp","width":250,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:83843:168846:15687:1","source":"bangumi"}]},{"characterId":"char_c31637","characterName":"レイアー","sourceIds":{"bangumi":[{"characterId":"168847","match":"exact-normalized-name-in-linked-work","subjectId":"83843"}],"egsCharacterIds":["22409"],"vndbCharacterId":"c31637"},"originalCharacterName":"レイアー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"168cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A succubus who gave the power to Lenard."}],"source":"vndb","sourceCharacterId":"c31637"},{"segments":[{"spoiler":false,"text":"主人公の参謀であり、片腕となる妖艶な女悪魔。主人公に『魔族の腕』を与え、王都を魔の楽園へと変貌させる『大奈落堕ち（グランド・フォール）』の策を持ちかけてくる。淫魔サキュバスの枠を大きく外れた強い魔力を持ち、並の人間には太刀打ちが出来ない。しかしながら、謀略と姦計を好み、多くの人間に直接手を下すことを快しとしない。あくまで、人間が同じ人間の手によって堕落していくのを見届けるの好む。気分屋で\"面白いかどうか\"が物事の判断基準。退屈を何よりも嫌う。"}],"source":"egs","sourceCharacterId":"22409","sourceWorkId":"8785","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の参謀であり、片腕となる妖艶な女悪魔。主人公に『魔族の腕』を与え、王都を魔の楽園へと変貌させる『大奈落堕ち（グランド・フォール）』の策を持ちかけてくる。淫魔サキュバスの枠を大きく外れた強い魔力を持ち、並の人間には太刀打ちが出来ない。しかしながら、謀略と姦計を好み、多くの人間に直接手を下すことを快しとしない。あくまで、人間が同じ人間の手によって堕落していくのを見届けるの好む。気分屋で\"面白いかどうか\"が物事の判断基準。退屈を何よりも嫌う。"},{"spoiler":false,"text":"主角的参谋，也是得力助手的妖艳女恶魔。"},{"spoiler":false,"text":"给予主角『魔族之腕』，并强硬地实行"},{"spoiler":false,"text":"『大奈落之沉沦(Grand Falls)』计划"},{"spoiler":false,"text":"企图将王都颠覆为魔族的乐园。"},{"spoiler":false,"text":"有着超越淫魔撒丘巴斯的魔力，普通人类是无法与之对抗的。"},{"spoiler":false,"text":"不过她喜欢谋略与算计，不喜欢对人类直接下手。"},{"spoiler":false,"text":"说白一点，她喜欢看人类自相残杀、腐败堕落的样子。"},{"spoiler":false,"text":"天性随性，判断事物以“好不好玩有不有趣”为基准。"},{"spoiler":false,"text":"最讨厌的事情是无聊。"}],"source":"bangumi","sourceCharacterId":"168847"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"22409","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"22409","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"22409","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"22409","sourceWorkId":"8785","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35e1675ea7b2756805c73249708656f717a2ad48c59ef6a548837c707d8fa071.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/522e04c4663154d721cee1bc4030b77f0551a1f3873b29ee8642af07a84833e5.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:83843:168847:6131:1","source":"bangumi"}]},{"characterId":"char_c31638","characterName":"ファイナ・ヴォーデンバーグ","sourceIds":{"bangumi":[{"characterId":"168849","match":"exact-normalized-name-in-linked-work","subjectId":"83843"}],"egsCharacterIds":["22411"],"vndbCharacterId":"c31638"},"originalCharacterName":"ファイナ・ヴォーデンバーグ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"160cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The queen of the kingdom. Stepmother of Alfina and Yufi. She has a secret relationship with Lenard."}],"source":"vndb","sourceCharacterId":"c31638"},{"segments":[{"spoiler":false,"text":"フォートリンデ聖樹国家　王妃。現国王の妻である。アルフィナとユーフィは、前妻の娘であるため、直接的な血のつながりはない。近年、王女たちとの関係に微妙な距離を感じており、その心の隙をつかれて主人公に篭絡される。穏やかで包容力のある女性だが、王宮の暮らしに孤独感を感じ、人肌の温もりに飢えてもいる。"}],"source":"egs","sourceCharacterId":"22411","sourceWorkId":"8785","spoiler":false},{"segments":[{"spoiler":false,"text":"フォートリンデ聖樹国家　王妃。現国王の妻である。アルフィナとユーフィは、前妻の娘であるため、直接的な血のつながりはない。近年、王女たちとの関係に微妙な距離を感じており、その心の隙をつかれて主人公に篭絡される。穏やかで包容力のある女性だが、王宮の暮らしに孤独感を感じ、人肌の温もりに飢えてもいる。"},{"spoiler":false,"text":"本名是，菲娜 沃德巴特"},{"spoiler":false,"text":"弗德里提里圣树国家，皇后。"},{"spoiler":false,"text":"现任国王之妻。"},{"spoiler":false,"text":"阿尔菲娜和悠菲为国王前妻之女，和她无直接血缘关系。"},{"spoiler":false,"text":"近年来感觉与王女两人的关系有着些许的距离感，"},{"spoiler":false,"text":"就因为被抓住这点内心的阴影，皇后也被主角所笼络。"},{"spoiler":false,"text":"虽然有着的沉稳以及包容力，但却因为皇宫生活的孤寂感，"},{"spoiler":false,"text":"同时也期待着男人的拥抱。"}],"source":"bangumi","sourceCharacterId":"168849"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"22411","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"22411","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"22411","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"22411","sourceWorkId":"8785","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4070892acbbe22c5b49a23b097c872a3bc4ed830e8d6d3b4a9f906ad9f40ef93.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee191259e49177251f6cf21d2d66d5a2a8b014afe532edee1a6c7cbace792961.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:83843:168849:6379:1","source":"bangumi"}]},{"characterId":"char_c43631","characterName":"レナード・ランディア","sourceIds":{"bangumi":[{"characterId":"174720","match":"exact-normalized-name-in-linked-work","subjectId":"83843"}],"egsCharacterIds":["22412"],"vndbCharacterId":"c43631"},"originalCharacterName":"レナード・ランディア","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"180cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story. His parents were killed by the king when he was young. He is seeking his revenge to the kingdom."}],"source":"vndb","sourceCharacterId":"c43631"},{"segments":[{"spoiler":false,"text":"フォートリンデ聖樹国家に仕える、若く才能溢れる司祭。国の聖職者の中でもかなり上の地位で、大神官補佐という肩書きも持つ。表向きは敬虔な聖職者で人当たりもよく、人望のある青年。だが裏では魔族と結託し、王国を転覆させる邪悪な計画に身を投じている。 幼い頃にかかった大病で隻腕になっていたが、サキュバスから『魔族の腕』を得て、人外の触手能力を得た。性格は冷静沈着ながら、心の奥底では享楽的で破滅的な願望が渦巻いている。"}],"source":"egs","sourceCharacterId":"22412","sourceWorkId":"8785","spoiler":false},{"segments":[{"spoiler":false,"text":"フォートリンデ聖樹国家に仕える、若く才能溢れる司祭。国の聖職者の中でもかなり上の地位で、大神官補佐という肩書きも持つ。表向きは敬虔な聖職者で人当たりもよく、人望のある青年。だが裏では魔族と結託し、王国を転覆させる邪悪な計画に身を投じている。 幼い頃にかかった大病で隻腕になっていたが、サキュバスから『魔族の腕』を得て、人外の触手能力を得た。性格は冷静沈着ながら、心の奥底では享楽的で破滅的な願望が渦巻いている。"},{"spoiler":false,"text":"本名是，雷纳德 拉迪亚（主人公）"},{"spoiler":false,"text":"奉任于弗德里提圣树国家，才华洋溢的年轻司祭。"},{"spoiler":false,"text":"就算在国家圣职者当中也是有着相当高的地位，"},{"spoiler":false,"text":"有着次席神官的头衔。"},{"spoiler":false,"text":"表面上是个虔诚的圣职者、人品好人望高的一个好青年。"},{"spoiler":false,"text":"但暗地里却与魔族结盟，主持推翻王国的邪恶计划。"},{"spoiler":false,"text":"因为幼时的大病断腕的手，从撒丘巴斯得到『魔族之腕』后，"},{"spoiler":false,"text":"获得了异于常人的触手能力。"},{"spoiler":false,"text":"性格冷静沉着，但心底却是个不折不扣的破坏狂。"}],"source":"bangumi","sourceCharacterId":"174720"}],"profileFacts":[{"label":"身高（本版本）","value":"180 cm","valueContext":null,"source":"egs","sourceCharacterId":"22412","sourceWorkId":"8785","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/626f5a634ee41323427eb5d71f135a5122c6bb76b6c7bd3377f6123b05676c28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b46f8b74f804756035ac4ab1a688cc1d37b56ec3c0d815892441991d3cadbba3.webp","width":188,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43633","characterName":"ミアン・スチュアート","sourceIds":{"bangumi":[{"characterId":"168848","match":"exact-normalized-name-in-linked-work","subjectId":"83843"}],"egsCharacterIds":["22410"],"vndbCharacterId":"c43633"},"originalCharacterName":"ミアン・スチュアート","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"158cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the personal maid of Yufi. She shows extreme loyalty to her princess."}],"source":"vndb","sourceCharacterId":"c43633"},{"segments":[{"spoiler":false,"text":"ユーフィ付きの侍女。姫の身の周りの世話が主な日課だが、国王に任じられたもうひとつの役割もこなす。スレンダーな体型で寡黙だが、主張すべきことは口にする凛とした印象。ユーフィの幼い頃から侍女として世話をしてきた事もあり、彼女に対して敬愛以上の想いを抱いている。"}],"source":"egs","sourceCharacterId":"22410","sourceWorkId":"8785","spoiler":false},{"segments":[{"spoiler":false,"text":"ユーフィ付きの侍女。姫の身の周りの世話が主な日課だが、国王に任じられたもうひとつの役割もこなす。スレンダーな体型で寡黙だが、主張すべきことは口にする凛とした印象。ユーフィの幼い頃から侍女として世話をしてきた事もあり、彼女に対して敬愛以上の想いを抱いている。"},{"spoiler":false,"text":"本名是，米亚 斯丘亚特"},{"spoiler":false,"text":"服侍悠菲的侍女。"},{"spoiler":false,"text":"虽然体型纤细个性寡言，但是该开口的时候绝不会退缩，"},{"spoiler":false,"text":"给人正直敢言的印象。"},{"spoiler":false,"text":"也许是因为自幼便服侍在悠菲左右，使得她对悠菲的情感，"},{"spoiler":false,"text":"比起敬爱更高了一个层次。"}],"source":"bangumi","sourceCharacterId":"168848"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"22410","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"22410","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"22410","sourceWorkId":"8785","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"22410","sourceWorkId":"8785","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a570a878e2d479b40f774b20299a15960d8570a0c01c07cd58266da7d73d980.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f28598d65add0c22dad5be09d7a51f4e1e14c562bc404163028c81e92d5413dc.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千房 こまめ","creatorId":"vndb:s15860","sourcePersonId":"vndb:s15860","canonicalEntityId":"vndb:s15860","name":"千房 こまめ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14217","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2058","sourceCompanyId":"egs:brand:2058","canonicalEntityId":"egs:brand:20