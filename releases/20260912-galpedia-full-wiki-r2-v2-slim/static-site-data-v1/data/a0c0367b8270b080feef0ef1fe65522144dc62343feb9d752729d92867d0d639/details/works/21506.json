tatus":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"320"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Art appreciation (Secret: Moe anime, gal games, illustrating pretty girls)"},{"spoiler":false,"text":"Eriri is Tomoya's childhood friend. She is a student in class 2-G and the most promising painter on the art club. She was born to a British father and a Japanese mother, and has blond hair. She has small breasts and Utaha sometimes teases Eriri about it. She is an otaku and the representative member of the doujin circle \"Egoistic-Lily\" (stylized as \"egoistic-lily\"). Eriri uses the pseudonym Eri Kashiwagi (柏木 エリ) when she participates in doujin activities. She hides her otaku side and pretends to be a refined young lady at school. Almost all the students in the school don't know her otaku personality and she is very popular with them. She is the illustrator for Blessing Software. Her mother is also a fujoshi and her father an otaku, and she was greatly influenced by them."},{"spoiler":false,"text":"(Source: Wikipedia & Saekano Offical Site)"}],"source":"vndb","sourceCharacterId":"c25934"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c10f1aa375cdde82a2125b307bbc9b22d2badcbb8ba43f0f38d5d0dc03a8bac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4479a2777fad0404ba0fabaab613a49c6fcba7c6527dff1cefb908a25f7dc743.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大西 沙織","creatorId":"vndb:s5887","sourcePersonId":"vndb:s5887","canonicalEntityId":"vndb:s5887","name":"大西 沙織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62473","source":"vndb"}]},{"characterId":"char_vndb_c25935","characterName":"霞ヶ丘 詩羽","sourceIds":{"vndbCharacterId":"c25935"},"originalCharacterName":"霞ヶ丘 詩羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"131"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Reading (Secret: Fantasizing, but she won't admit it)"},{"spoiler":false,"text":"Utaha is an up-and-coming young novelist. She is a student in class 3-C and wearing two hats as a student and a writer. She writes her novels under the pen name of Utako Kasumi (霞 詩子). Her first novel Koisuru Metronome (恋するメトロノーム) was published under the Fushikawa Fantastic Bunko imprint and sold over 500,000 copies. She has both intelligence and beauty, and is the brightest student in the school. Most of the students hold her in awe. She sleeps and reads a lot and usually keeps to herself but when she does open her mouth, everyone is shocked by her sharp tongue."},{"spoiler":false,"text":"(Source: Wikipedia & Saekano Offical Site)"}],"source":"vndb","sourceCharacterId":"c25935"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24da2eccd0a2bf48928095640bd47fb00fab5ceb388823209655bb5aa01a5a67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/761cd12688c0102b5afe091d993e4f3cb43e888e39b5c5f857c9dd75af0b45ae.webp","width":197,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅野 愛衣","creatorId":"vndb:s630","sourcePersonId":"vndb:s630","canonicalEntityId":"vndb:s630","name":"茅野 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62470","source":"vndb"}]},{"characterId":"char_vndb_c26001","characterName":"氷堂 美智留","sourceIds":{"vndbCharacterId":"c26001"},"originalCharacterName":"氷堂 美智留","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1218"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Ballet, Drama, Basketball and other stuff. The band for now. (Secret: Pro-wrestling)"},{"spoiler":false,"text":"Michiru is Tomoya's cousin born on the same day, and at the same hospital as him. She is a student in class 3, in the second year of Tsubaki Girls' Senior High School, an all-girls school. She is a very versatile girl except for her poor performance in school. She is good at almost everything and doesn't stick to anything for long, but she has been absorbed in singing her favorite songs and playing the guitar in the band \"Icy Tail\" for the past year."},{"spoiler":false,"text":"Michiru had a prejudice against otaku culture and wasn't happy about Tomoya being an otaku until her band members told her they were all otaku. Michiru composes the music in the game by Blessing Software. She has a very close relationship with Tomoya and often expresses their understanding for one another physically but neither of them care that they're of the opposite sex."},{"spoiler":false,"text":"(Source: Wikipedia & Saekano Offical Site)"}],"source":"vndb","sourceCharacterId":"c26001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3fb16c7d80e9a54bb0dcd02a74cc90a423d9dbf4f3084d2ed5d40c8ab06bf01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b6540dd79899052b95009b6492f0c921564a5e3df1f6d789c318d2e2f06661b.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"矢作 紗友里","creatorId":"vndb:s670","sourcePersonId":"vndb:s670","canonicalEntityId":"vndb:s670","name":"矢作紗友里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62471","source":"vndb"}]},{"characterId":"char_vndb_c26080","characterName":"加藤 恵","sourceIds":{"vndbCharacterId":"c26080"},"originalCharacterName":"加藤 恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"923"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Shopping (Secret: Um, is it even normal to have a hobby that you can't mention?)"},{"spoiler":false,"text":"Megumi is Tomoya's classmate. Unlike Eriri and Utaha, she is portrayed as an ordinary girl with no distinctive character. She is a good-looking girl but doesn't stand out in class at all; she is very stealthy and it's not unusual to find her checking mobile phone and becoming a part of the background even if she started a conversation. She knows little about otaku culture but never keeps Tomoya at arm's length. Her attitude toward Tomoya is often described as furatto (フラット) and he is often the unfortunate target of snide, deadpan retorts from her. She is the model for Meguri, one of the main heroines of the game being produced by Blessing Software."},{"spoiler":false,"text":"(Source: Wikipedia & Saekano Offical Site)"}],"source":"vndb","sourceCharacterId":"c26080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61251dce6664d057f9b5a3cdea6a26819d19dcb75d794c0bb510a728074da9aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccd9a3d36d9b336542f0f5094e8782ed2ba5cc4d6a6deff1fe03fc2ada3c6d93.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安野 希世乃","creatorId":"vndb:s8118","sourcePersonId":"vndb:s8118","canonicalEntityId":"vndb:s8118","name":"安野 希世乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62475","source":"vndb"}]},{"characterId":"char_vndb_c26081","characterName":"波島 出海","sourceIds":{"vndbCharacterId":"c26081"},"originalCharacterName":"波島 出海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"505"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Otome game series \"Little Love Rhapsody\" (Secret: Watching soccer games (This is due to her past hobbies from elementary school))"},{"spoiler":false,"text":"Izumi is a student in class 3-A of Honoda Junior High School and two years younger than Tomoya. She is an otaku and a member of the doujin circle \"Fancy Wave\" (ファンシーウェーブ). It was through Tomoya's influence that she became interested in otaku culture, and she is deeply grateful to him for this. She has loved Little Love Rhapsody, an otome video game series released by Sonar for the PlayStation Portable, since Tomoya bought her Little Love Rhapsody 2 and a PlayStation Portable console on her birthday. Following her parents' re-location, she moved to Nagoya but never stopped being an otaku. There is rivalry between Eriri and Izumi, then Izumi decided to compete with Eriri in the next Winter Comiket. Izumi made up her mind to be the illustrator for her brother Iori's doujin circle \"Rouge en rouge\"."},{"spoiler":false,"text":"(Source: Wikipedia & Saekano Offical Site)"}],"source":"vndb","sourceCharacterId":"c26081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1ac78aa500de748b5a93e2920f303eaaec7f9d31c65d82736ecad1fa1d0f7a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f61841d4034eb0eba0ef077ec2fdc9747a94bb72d5b4c9aa475b23149b470be0.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤﨑 千夏","creatorId":"vndb:s6132","sourcePersonId":"vndb:s6132","canonicalEntityId":"vndb:s6132","name":"赤﨑千夏(赤崎千夏)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62474","source":"vndb"}]},{"characterId":"char_vndb_c36124","characterName":"安芸 倫也","sourceIds":{"vndbCharacterId":"c36124"},"originalCharacterName":"安芸 倫也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1218"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Anime, light-novels, manga, games"},{"spoiler":false,"text":"One of the 3 most notable students at Toyogasaki Academy. When he was a first year student, he succeeded in convincing the vice-principal to allow an anime screening at the school's Culture Festival. He is extremely tenacious and would do anything to get what he wants. He was a typical consumer otaku who would spend the money he earned at his part-time job on anime and games but..."},{"spoiler":false,"text":"Edited from official website"}],"source":"vndb","sourceCharacterId":"c36124"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44fcdbc3be60c915d105a94b696d4f4daea4f753f6ba6c69140549f23ffeb635.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4ce4c2b9462612d375bba4b444c1980bb68430820e553eba237344ddf0182d49.webp","width":185,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松岡 禎丞","creatorId":"vndb:s748","sourcePersonId":"vndb:s748","canonicalEntityId":"vndb:s748","name":"松岡 禎丞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62472","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2282","sourceCompanyId":"egs:brand:2282","canonicalEntityId":"egs:brand:2282","name":"MAGES.(5pb.)","roleCodes":["