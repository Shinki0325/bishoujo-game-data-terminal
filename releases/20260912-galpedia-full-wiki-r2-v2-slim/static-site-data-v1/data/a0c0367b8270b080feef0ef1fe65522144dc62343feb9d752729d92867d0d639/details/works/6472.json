er":false},{"segments":[{"spoiler":false,"text":"暴行傷害、器物破損の常習犯として送られてくる。"},{"spoiler":false,"text":"刑期は3年で執行猶予5年だったが、執行猶予中に事件を起こす。"},{"spoiler":false,"text":"囚人番号681。"},{"spoiler":false,"text":"暴走族：ナイトエンジェル（Nig／HtAngel）のリーダー。"},{"spoiler":false,"text":"非常に気性の激しいキャラクターで、好戦的。"},{"spoiler":false,"text":"腕っ節に自信があるため、何でも暴力に訴えようとする。"},{"spoiler":false,"text":"しかし、あくまで子供レベルでの話であり、収容所内では全く役に立たないレベルの強さ。"},{"spoiler":false,"text":"立場的にも力的にも武昭に及ばない。"}],"source":"bangumi","sourceCharacterId":"220106"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"26163","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"178 cm","valueContext":null,"source":"egs","sourceCharacterId":"26163","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"99 cm","valueContext":null,"source":"egs","sourceCharacterId":"26163","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"26163","sourceWorkId":"6472","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6ddf9abbb92fe6694c2b8624c9ef4f0604e58a2f761ea20db7f9586ba3e53c2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b0af92738197e3ba7d25ff7400b3f2b6c791ff7df77f1e881a43fd114a806b9.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茂呂田かおる","creatorId":"vndb:s662","sourcePersonId":"vndb:s662","canonicalEntityId":"vndb:s662","name":"茂呂田 かおる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:288327:220106:4073:1","source":"bangumi"}]},{"characterId":"char_c30748","characterName":"西ノ宮 悦子","sourceIds":{"bangumi":[{"characterId":"220107","match":"exact-normalized-name-in-linked-work","subjectId":"288327"}]