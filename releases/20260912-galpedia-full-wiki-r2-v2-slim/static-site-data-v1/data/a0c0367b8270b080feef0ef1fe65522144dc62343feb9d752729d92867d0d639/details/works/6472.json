"bangumi","sourceCharacterId":"220105"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"26162","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"26162","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"26162","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"26162","sourceWorkId":"6472","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5929441c5e6a81e4089beda55989b15c17f8fc82d81cfebaea663c98d0856378.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3cb421ff4b5baa2b4b7ba2309e50c89f6df58faca2d0c99f4b1bd2013bb3d92.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:288327:220105:4832:1","source":"bangumi"}]},{"characterId":"char_c30746","characterName":"梶原 由利子","sourceIds":{"bangumi":[{"characterId":"220104","match":"exact-normalized-name-in-linked-work","subjectId":"288327"}],"egsCharacterIds":["26161"],"vndbCharacterId":"c30746"},"originalCharacterName":"梶原 由利子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"100"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"165cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A married woman who was sent for false charges (murder). Her sentence is 8 years with no probation."},{"spoiler":false,"text":"Prisoner number 674."},{"spoiler":false,"text":"Her husband is Masaomi Kajiwara."},{"spoiler":false,"text":"He is an ordinary company employee, and there is nothing special about him. She has been married for 8 years and has no children, but she would like to have some. She is not dissatisfied with her life and strongly loves her husband."},{"spoiler":false,"text":"While driving a car, she causes an accident that kills the other driver. The dead man was the son of a famous deputy, and the fault lies with the other party, but there were no witnesses, the other party was also a powerful man, so she is sent to a prison camp for gross negligence."},{"spoiler":false,"text":"Her husband is not satisfied with the verdict, but the deputies have been working around the clock and all appeals have been dismissed. While trying to do something about it, Yuriko is sent to an internment camp. Yuriko believes that one day the truth will come out and she will be able to get out of prison."},{"spoiler":false,"text":"She is a chaste woman and is very reluctant to be raped by a man other than her husband. She is not violent, but resists the protagonist with great effort."},{"spoiler":false,"text":"From DLsite"}],"source":"vndb","sourceCharacterId":"c30746"},{"segments":[{"spoiler":false,"text":"冤罪で、舞台となる民間刑務所に収監された人妻。"},{"spoiler":false,"text":"車を運転中に事故を起こし、相手を死なせてしまう。"},{"spoiler":false,"text":"死亡したのが有名な代議士の息子だったため、相手側の過失が多分にあったにも関わらず、重過失として刑に服すことになった。"},{"spoiler":false,"text":"結婚八年目になるが子供はなく、サラリーマンの夫と二人暮らし。"},{"spoiler":false,"text":"夫を深く愛し、生活にも不満を感じていない。"},{"spoiler":false,"text":"貞操観念が強く、夫以外との行為を頑なに拒むが……。"}],"source":"egs","sourceCharacterId":"26161","sourceWorkId":"6472","spoiler":false},{"segments":[{"spoiler":false,"text":"冤罪（殺人罪）で送られてくる人妻。"},{"spoiler":false,"text":"刑期は8年で執行猶予無し。"},{"spoiler":false,"text":"囚人番号674。"},{"spoiler":false,"text":"夫は「梶原政臣」（かじわらまさおみ）"},{"spoiler":false,"text":"ごく普通の会社員で、特に何かあるわけではない。"},{"spoiler":false,"text":"結婚して8年になるが子供はいないが、欲しいとは思っている。"},{"spoiler":false,"text":"特に生活に不満は無く、強く夫を愛している。"},{"spoiler":false,"text":"車を運転中に事故を起こし相手を死亡させてしまう。"},{"spoiler":false,"text":"死んでしまったのは有名な代議士の息子で、過失は相手側にあるのだが、目撃者がおらず、また、相手が権力者でもあったため重過失と言うことで収容所送りになってしまう。"},{"spoiler":false,"text":"夫は判決に納得いかないものの、代議士の手が回っており上告は全て棄却されている。"},{"spoiler":false,"text":"何とか手を打とうとしている内に由利子は収容所に送られる。"},{"spoiler":false,"text":"いつか真実が明らかになると信じている由利子は出獄出来ると思っている。"},{"spoiler":false,"text":"貞操観念が強く、夫以外の男に犯される事を非常に嫌がる。"},{"spoiler":false,"text":"暴力的ではないが、懸命に主人公に対して抵抗する。"}],"source":"bangumi","sourceCharacterId":"220104"}],"profileFacts":[{"label":"胸围（本版本）","value":"100 cm","valueContext":null,"source":"egs","sourceCharacterId":"26161","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"26161","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"26161","sourceWorkId":"6472","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"26161","sourceWorkId":"6472","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82f70d7018eb459679ca149389559203341ce796e28ac96b1d82c579f3109b6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/969dae9d10a88b10e9ae68d948eca0cc8f174156e994ff5133d287e751aceaa9.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"歌織","roleCo