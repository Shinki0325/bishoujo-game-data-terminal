582","sourceWorkId":"15144","spoiler":false},{"segments":[{"spoiler":false,"text":"有紗がアルテミナリングの力で変身した姿。"},{"spoiler":false,"text":"異世界から来た召喚獣に対する送還能力を持つ。"},{"spoiler":false,"text":"弓とレイピアを武器に、ヒット＆アウェイの攻撃を得意とする。"}],"source":"egs","sourceCharacterId":"16582","sourceWorkId":"22180","spoiler":false},{"segments":[{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"１ヶ月前、マグナスと出会いサマナープリンセスとして欲望に忠実な集団グリードとの死闘を繰り広げる。"},{"spoiler":false,"text":"仲間達との協力もあってグリードを壊滅させ、平和な日常を取り戻した。"},{"spoiler":false,"text":"だが、再び召喚獣の魔の手が彼女に襲いかかる。"}],"source":"egs","sourceCharacterId":"16582","sourceWorkId":"27763","spoiler":false},{"segments":[{"spoiler":false,"text":"本編のヒロイン。"},{"spoiler":false,"text":"小さい頃は夢見がちだったが、だらしない兄を持ったせいで、現実感を重視するようになった少し冷めた少女。"},{"spoiler":false,"text":"ある日突然、変身ヒロインになってしまうが、正義や倫理よりも自分の生活を壊されたくないと思い戦うのをためらう。"},{"spoiler":false,"text":"だが、次第に内なる優しさに目覚め、正義の味方として成長していく。"},{"spoiler":false,"text":"「私をわけの分からないことに巻き込まないでくれる？」"}],"source":"bangumi","sourceCharacterId":"160365"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/980a928e53c1573dc3093bf43e33acac8cafd68d04b9fa98f61f2df2b9c6091b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16ad8220edd7ebd4926fd460b0518b2992ad7dfc6a21f7434a25485a2cf0c8ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61565:160365:5890:1","source":"bangumi"}]},{"characterId":"char_c35370","characterName":"ユーリ","sourceIds":{"bangumi":[{"characterId":"160370","match":"exact-normalized-name-in-linked-work","subjectId":"240651"},{"characterId":"160370","match":"exact-normalized-name-in-linked-work","subjectId":"61565"}],"egsCharacterIds":["16584"],"vndbChar