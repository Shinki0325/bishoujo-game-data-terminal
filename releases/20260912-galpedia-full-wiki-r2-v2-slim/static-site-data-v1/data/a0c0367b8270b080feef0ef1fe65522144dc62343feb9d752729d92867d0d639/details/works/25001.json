"vndb:vn-staff:128010","source":"vndb"},{"creditedName":"ズシ トモユキ","creatorId":"vndb:s41548","sourcePersonId":"vndb:s41548","canonicalEntityId":"vndb:s41548","name":"ズシ トモユキ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:128011","source":"vndb"}],"other":[{"creditedName":"A応P","creatorId":"vndb:s20891","sourcePersonId":"egs:creator:30131","canonicalEntityId":"vndb:s20891","name":"A応P","detail":"OP曲「全力バタンキューREMIX」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:182547","source":"egs"},{"creditedName":"アイリー・ヤミ","creatorId":"vndb:s17284","sourcePersonId":"vndb:s17284","canonicalEntityId":"vndb:s17284","name":"AiRyA","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:128006","source":"vndb"},{"creditedName":"A応P","creatorId":"vndb:s20891","sourcePersonId":"vndb:s20891","canonicalEntityId":"vndb:s20891","name":"A応P","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:128007","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c130396","characterName":"チビ太","sourceIds":{"vndbCharacterId":"c130396"},"originalCharacterName":"チビ太","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Former rival of the sextuplets, who now runs an oden stand that the Matsuno brothers frequently visit. Having grown up into a responsible working young man, Chibita is often troubled by the brothers' slacker ways and refusal to pay their tab."},{"spoiler":false,"text":"Chibita has a very rough accent and his pronunciation reflects that. He also has a distinct laugh of 'Kekeke'. In the 1988 anime and subsequent works like -san, he also has phrases he repeats, such as calling people 'baka' (idiot) that he pronounces as 'barou' (a rougher, slangier version of the word) and yelling \"Teyande barou chikusho!\", often translated as \"Dammit idjit, what the hell!?"},{"spoiler":false,"text":"\"From Wikipedia\":["}],"source":"vndb","sourceCharacterId":"c130396"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/284d529bb44f779e69106ab6ebade7946c176862d9ff86e5ad604a06d758be0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/900799c27d0549decea878667044ef32a45e4295d9aa48870a56c310fd018b98.webp","width":256,"height":214,"source":"static-detail"},"actors":[{"creditedName":"國立 幸","creatorId":"vndb:s950","sourcePersonId":"vndb:s950","canonicalEntityId":"vndb:s950","name":"國立 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68246","source":"vndb"}]},{"characterId":"char_vndb_c130397","characterName":"ハタ坊","sourceIds":{"vndbCharacterId":"c130397"},"originalCharacterName":"ハタ坊","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hatabō is usually a simple, kind young man who isn't the brightest, but may bear a rather severe streak or unsettling implications depending on the skit (such as his reign as \"Mr. Flag\"). He retains many childish attributes, such as his habit of riding about on a kids' tricycle, and seeming to live a more child-like existence and longing for friends."},{"spoiler":false,"text":"In both versions, Hatabō often ends his sentences in the tic \"da jo\" or simply a \"jo\"."}],"source":"vndb","sourceCharacterId":"c130397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20d493198304622640a394a94520801888888635726360f52f03772cfc1a6612.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fde7f06cba5f5ab50b8091b5e448fc329348d0cbb15789a5393b13db5c546395.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎藤 桃子","creatorId":"vndb:s5700","sourcePersonId":"vndb:s5700","canonicalEntityId":"vndb:s5700","name":"斎藤桃子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68250","source":"vndb"}]},{"characterId":"char_vndb_c130400","characterName":"デカパン","sourceIds":{"vndbCharacterId":"c130400"},"originalCharacterName":"デカパン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Most commonly, he is a big-hearted, easy-going man who can be anything from a doctor,a millionaire, a policeman, and so on. He may strive to help out others, although he is also quite eccentric,"},{"spoiler":false,"text":"Dekapan often laughs or inserts \"hoe hoe\" as a general verbal tic, and tends to end his speech with \"-dasu\"."}],"source":"vndb","sourceCharacterId":"c130400"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b63c2051d2eb4ea6f527c33d75eb1a369f3e606ef28f4922a4c13fb06b7ba7da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48ebec7259c1c7826b1f609b95a1352cd7d163ac6f118905c04655a4d5654469.webp","width":256,"height":205,"source":"static-detail"},"actors":[{"creditedName":"上田 燿司","creatorId":"vndb:s5990","sourcePersonId":"vndb:s5990","canonicalEntityId":"vndb:s5990","name":"上田 燿司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68251","source":"vndb"}]},{"characterId":"char_vndb_c130401","characterName":"ダヨーン","sourceIds":{"vndbCharacterId":"c130401"},"originalCharacterName":"ダヨーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is often a simple, easy-going man, but his exact personality details and usage are variable with his role and he is officially described by Fujio Pro as an unclear man whose identity cannot be easily understood."},{"spoiler":false,"text":"Dayoon is best known for ending his sentences in \"dayoon\" or simply \"yon\"."}],"source":"vndb","sourceCharacterId":"c130401"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd20ee387f1ba173ad9df7421118c534421c7e17c17553670c6bd9075de5dc7a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d1206bbeb6b84afd7a0fc20804242309c8c2f2d3667a07bd435fa5c58d58d2b.webp","width":256,"height":250,"source":"static-detail"},"actors":[{"creditedName":"飛田 展男","creatorId":"vndb:s351","sourcePersonId":"vndb:s351","canonicalEntityId":"vndb:s351","name":"飛田 展男","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68242","source":"vndb"}]},{"characterId":"char_vndb_c130402","characterName":"松野 松代","sourceIds":{"vndbCharacterId":"c130402"},"originalCharacterName":"松野 松代","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The sextuplet's mother."},{"spoiler":false,"text":"She still loves her sons, however she wishes they would move out and get jobs. She has a strong desire for grandchildren. She still has her motherly instinct and wants to baby her sons from time to time."}],"source":"vndb","sourceCharacterId":"c130402"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c039015b013f47e7ce5d41fc24012c3ab687d251e55614621c064cc2bde25213.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/4947c1f40440fc4b94cd89c601eec67441eb3e4b922a39fbbb332c4505f1b85a.webp","width":222,"height":256,"source":"static-detail"},"actors":[{"creditedName":"くじら","creatorId":"vndb:s290","sourcePersonId":"vndb:s290","canonicalEntityId":"vndb:s290","name":"松本 和香子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68239","source":"vndb"}]},{"characterId":"char_vndb_c130403","characterName":"松野 松造","sourceIds":{"vndbCharacterId":"c130403"},"originalCharacterName":"松野 松造","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Father of sextuplets. He is probably the sole breadwinner of the Matsuno family, as his sons are not independent."}],"source":"vndb","sourceCharacterId":"c130403"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c951bef34c611bb3fca9b87ec505e561d0bb8208f77b1c212405bf3238b90042.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f5455aef4765d44434c3812dcb00884a9f2a57803f9a23fd7616a5a02512c9e.webp","width":256,"height":245,"source":"static-detail"},"actors":[{"creditedName":"井上 和彦","creatorId":"vndb:s374","sourcePersonId":"vndb:s374","canonicalEntityId":"vndb:s374","name":"井上 和彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68243","source":"vndb"}]