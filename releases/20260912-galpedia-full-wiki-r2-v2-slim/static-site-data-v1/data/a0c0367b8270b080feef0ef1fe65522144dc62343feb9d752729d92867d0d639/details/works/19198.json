{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19198","model":{"presentationWorkId":"vndb:v12798","staff":{"artwork":[{"creditedName":"みよし","creatorId":"vndb:s13231","sourcePersonId":"egs:creator:19752","canonicalEntityId":"vndb:s13231","name":"みよし","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:121957","source":"egs"}],"scenario":[{"creditedName":"春河ミライ","creatorId":"vndb:s4127","sourcePersonId":"egs:creator:8942","canonicalEntityId":"vndb:s4127","name":"春河ミライ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:121958","source":"egs"}],"music":[],"other":[{"creditedName":"みよし","creatorId":"vndb:s13231","sourcePersonId":"vndb:s13231","canonicalEntityId":"vndb:s13231","name":"みよし","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:100701","source":"vndb"},{"creditedName":"ゆいな","creatorId":"vndb:s16129","sourcePersonId":"vndb:s16129","canonicalEntityId":"vndb:s16129","name":"_blank","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:100703","source":"vndb"},{"creditedName":"ゆいな","creatorId":"vndb:s16129","sourcePersonId":"vndb:s16129","canonicalEntityId":"vndb:s16129","name":"_blank","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100704","source":"vndb"}]},"cast":[{"characterId":"char_c17705","characterName":"ナナシ","sourceIds":{"bangumi":[],"egsCharacterIds":["1748"],"vndbCharacterId":"c17705"},"originalCharacterName":"ナナシ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a half-elf born from the union of a human and an elf. Innocent and reckless, he is always cheerful and lively, smiling like the sun, which makes him appear very carefree. He has an insatiable curiosity and is fascinated by everything, always eager to try new things."},{"spoiler":false,"text":"He especially loves experiencing things for the first time and approaches them with sparkling eyes, but he is not particularly adept at them."}],"source":"vndb","sourceCharacterId":"c17705"},{"segments":[{"spoiler":false,"text":"人間とのハーフエルフ。無邪気で無鉄砲。"},{"spoiler":false,"text":"常に明るく騒がしく、ニコニコとお日様のように笑っているため、非常に脳天気に見える。"},{"spoiler":false,"text":"好奇心は非常に旺盛で、何にでも感心しなんでもやってみたがる。"},{"spoiler":false,"text":"初めてのことは特に大好きなようで目を輝かせて取り組むがあまり器用ではない。"}],"source":"egs","sourceCharacterId":"1748","sourceWorkId":"19198","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c17705","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"1748","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"1748","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b18e5772a967b284e96020de6f2b450ec721d200078fff99fa10b203025a870.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9c3ef0ee1480c956e4040bdaefd7d7736049c02a860dc84c540eb86d55f0fca.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七瀬 希","creatorId":"vndb:s575","sourcePersonId":"vndb:s575","canonicalEntityId":"vndb:s575","name":"七瀬 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53811","source":"vndb"}]},{"characterId":"char_c17706","characterName":"イバラ","sourceIds":{"bangumi":[{"characterId":"22057","match":"exact-normalized-name-in-linked-work","subjectId":"80308"}],"egsCharacterIds":["1749"],"vndbCharacterId":"c17706"},"originalCharacterName":"イバラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He believes that elves are noble and splendid, while humans are cunning and filthy. He also holds the belief that the superiority of elves is determined by their beauty, which makes him condescending towards other elves. However, deep down, he is sincere and innocent, which leads to his confusion and uncertainty after encountering the human."},{"spoiler":false,"text":"He shows respect and admiration towards elder elves, addressing them as \"elder brother\" or \"brother.\""}],"source":"vndb","sourceCharacterId":"c17706"},{"segments":[{"spoiler":false,"text":"エルフは高貴で素晴らしく、人間はずるく汚らわしく、"},{"spoiler":false,"text":"エルフの優劣は美しさで決まると信じており、他のエルフにも尊大。"},{"spoiler":false,"text":"しかし、根は素直で純真なため、ニンゲンに出会ったことでその価値観が揺らぎそうで戸惑っている。"},{"spoiler":false,"text":"年長者のエルフのことは『兄上』と呼んで慕っている。"}],"source":"egs","sourceCharacterId":"1749","sourceWorkId":"19198","spoiler":false},{"segments":[{"spoiler":false,"text":"エルフは高貴で素晴らしく、人間はずるく汚らわしいと思っている。"},{"spoiler":false,"text":"また、エルフの優劣は美しさで決まると信じており、他のエルフにも尊大。"},{"spoiler":false,"text":"しかし根は素直で純真なため、ニンゲンに出会ったことでその価値観が揺らぎ戸惑っている。"},{"spoiler":false,"text":"年長者のエルフのことは “兄上” と呼んで慕っている。"},{"spoiler":false,"text":"「くっ……おい、ニンゲン！　ボクにも教えろ！」"}],"source":"bangumi","sourceCharacterId":"22057"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c17706","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"1749","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"1749","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"22057","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30fe539213bc83950207a493ace22dfbcca3ff0ecdf7214d991ba451b9998500.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4de433f8f7826a986e3c1a771527b0f4ea4ea5af58ea1822beb373f0636d0a96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80308:22057:6351:1","source":"bangumi"}]},{"characterId":"char_c17707","characterName":"コノミ","sourceIds":{"bangumi":[{"characterId":"22058","match":"exact-normalized-name-in-linked-work","subjectId":"80308"}],"egsCharacterIds":["1750"],"vndbCharacterId":"c17707"},"originalCharacterName":"コノミ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He enjoys pleasure and is highly adaptable. He has a laid-back nature and accepts things as they are. It may appear that he teases others knowingly, but he doesn't mean any harm."},{"spoiler":false,"text":"He approaches both humans and other elves with a somewhat condescending attitude. As a result, he may seem elusive, but he is simply loyal to his own pleasure and desires."}],"source":"vndb","sourceCharacterId":"c17707"},{"segments":[{"spoiler":false,"text":"快楽を好み順応性が高い。のんびりとあるがままを受け入れる。"},{"spoiler":false,"text":"わかっていてからかうような言動をとっているようにも見えるが悪気はない。"},{"spoiler":false,"text":"人間に対しても他のエルフに対しても若干俯瞰しているような姿勢で対峙している。"},{"spoiler":false,"text":"そのためつかみどころがなく感じられるが、自分自身の快感に忠実なだけ。"}],"source":"egs","sourceCharacterId":"1750","sourceWorkId":"19198","spoiler":false},{"segments":[{"spoiler":false,"text":"快楽を好み順応性が高い。 のんびりとあるがままを受け入れる。"},{"spoiler":false,"text":"分かっていてからかうような言動をとっているようにも見えるが、悪気はない。"},{"spoiler":false,"text":"人間に対しても他のエルフに対しても若干俯瞰しているような姿勢で対峙している。"},{"spoiler":false,"text":"そのため掴み所がなく感じられるが、自分自身の快感に忠実なだけ。"},{"spoiler":false,"text":"「口に入れると～気持ちいい～？」"}],"source":"bangumi","sourceCharacterId":"22058"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c17707","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"1750","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"1750","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"22058","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5536cd92c3fe09aaeecf9bce23a615d624aac1fbee489b8c7eddea4ccddba24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c634e7ee9c20d6758a0e22af902975f9dd99e970ce3512a8a92673068b1d6e7e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天川みるく","creatorId":"vndb:s573","sourcePersonId":"vndb:s573","canonicalEntityId":"vndb:s573","name":"天川 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80308:22058:25801:1","source":"bangumi"}]},{"characterId":"char_c17708","characterName":"ツキヨ","sourceIds":{"bangumi":[{"characterId":"22059","match":"exact-normalized-name-in-linked-work","subjectId":"80308"}],"egsCharacterIds":["1751"],"vndbCharacterId":"c17708"},"originalCharacterName":"ツキヨ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a dark elf who is generally not confident in asserting himself, being introverted due to his experiences of being ostracized by other elves. He finds joy in receiving attention and care from others. He is skilled with his hands and excels at drawing and painting. He is intellectually curious and has a keen desire to learn, particularly enjoying reading books that the human shares with him."},{"spoiler":false,"text":"When something troubles him, he tends to retreat into himself, immediately wrapping himself in a piece of cloth and falling silent."}],"source":"vndb","sourceCharacterId":"c17708"},{"segments":[{"spoiler":false,"text":"ダークエルフ。エルフ達に疎外されていたことから、"},{"spoiler":false,"text":"基本的にあまり自己主張が得意でなく内向的で気にかけてもらうとそれだけで喜ぶ。"},{"spoiler":false,"text":"しかし、手先は器用で絵を書くのも得意。"},{"spoiler":false,"text":"向学心に富み、ニンゲンに本を読んでもらうことを好む。"},{"spoiler":false,"text":"何かあるとすぐに持っている布を被って黙り込んでしまう。"}],"source":"egs","sourceCharacterId":"1751","sourceWorkId":"19198","spoiler":false},{"segments":[{"spoiler":false,"text":"ダークエルフ。"},{"spoiler":false,"text":"エルフたちに疎外されていたことから、基本的にあまり自己主張が得意でなく内向的で、気に掛けてもらうとそれだけで喜ぶ。"},{"spoiler":false,"text":"手先が器用で絵を描くのも得意。"},{"spoiler":false,"text":"向学心に富み、ニンゲンに本を読んでもらうことを好む。"},{"spoiler":false,"text":"何かあるとすぐに持っている布を被って黙り込んでしまう。"},{"spoiler":false,"text":"「せっかく、教えてくれたのに、上手にできないです。だから、ごめんなさいです」"}],"source":"bangumi","sourceCharacterId":"22059"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c17708","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"1751","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"1751","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"22059","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/205b5c97fed09e489442c898a1b3322568a5be1a74d95d241c44a922f9e7ccce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04ce2ae88596309e81b01f413dfc2be3a19b68e72a1ba97940d257659b1c4dca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voic