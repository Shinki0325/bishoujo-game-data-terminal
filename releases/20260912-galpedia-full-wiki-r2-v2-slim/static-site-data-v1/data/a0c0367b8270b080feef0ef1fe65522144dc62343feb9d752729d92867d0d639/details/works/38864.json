{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"38864","model":{"presentationWorkId":"vndb:v57107","staff":{"artwork":[{"creditedName":"夕凪セシナ","creatorId":"vndb:s1091","sourcePersonId":"egs:creator:3394","canonicalEntityId":"vndb:s1091","name":"夕凪セシナ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:295005","source":"egs"},{"creditedName":"うなさか","creatorId":"vndb:s5639","sourcePersonId":"egs:creator:16296","canonicalEntityId":"vndb:s5639","name":"うなさか","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:295006","source":"egs"},{"creditedName":"冬壱もんめ","creatorId":"vndb:s4883","sourcePersonId":"egs:creator:22455","canonicalEntityId":"vndb:s4883","name":"冬壱もんめ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:295007","source":"egs"},{"creditedName":"さくらねこ","creatorId":"vndb:s16130","sourcePersonId":"egs:creator:33040","canonicalEntityId":"vndb:s16130","name":"さくらねこ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:295008","source":"egs"}],"scenario":[{"creditedName":"八日なのか","creatorId":"vndb:s4808","sourcePersonId":"egs:creator:21046","canonicalEntityId":"vndb:s4808","name":"八日なのか","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:295009","source":"egs"}],"music":[{"creditedName":"朝霧 はやと","creatorId":"vndb:s8821","sourcePersonId":"vndb:s8821","canonicalEntityId":"vndb:s8821","name":"朝霧 隼翔","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:216716","source":"vndb"}],"other":[{"creditedName":"天都","creatorId":"vndb:s1092","sourcePersonId":"egs:creator:3395","canonicalEntityId":"vndb:s1092","name":"天都","detail":"ディレクション","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:295019","source":"egs"},{"creditedName":"燈華いのり","creatorId":"vndb:s39035","sourcePersonId":"egs:creator:41204","canonicalEntityId":"vndb:s39035","name":"燈華いのり","detail":"OP曲「Precious Days」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:296529","source":"egs"},{"creditedName":"天都","creatorId":"vndb:s1092","sourcePersonId":"vndb:s1092","canonicalEntityId":"vndb:s1092","name":"天都","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:216712","source":"vndb"},{"creditedName":"燈華 いのり","creatorId":"vndb:s39035","sourcePersonId":"vndb:s39035","canonicalEntityId":"vndb:s39035","name":"燈華 いのり","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:216718","source":"vndb"}]},"cast":[{"characterId":"char_c142016","characterName":"天使ちゃん","sourceIds":{"bangumi":[{"characterId":"164239","match":"exact-normalized-name-in-linked-work","subjectId":"512796"}],"egsCharacterIds":["27187"],"vndbCharacterId":"c142016"},"originalCharacterName":"天使ちゃん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An angel who, out of nowhere, began intruding into Iori's life from the moment they met—and, without so much as asking, decided to stay."},{"spoiler":false,"text":"She confidently promises that, in exchange for food, clothing, and a roof over her head, she'll fill Iori’s youth with boundless love and joy. Yet her behavior suggests she’s more like a runaway girl play-acting as an angel than an ethereal being."},{"spoiler":false,"text":"When silent, she has the serene beauty of a true angel. But as soon as she speaks, it’s nothing but sly, playful mischief, spilling over with unsolicited commentary on anything and everything—except herself. Rarely seen in anyone’s company but Iori's, she remains as enigmatic as she is unpredictable."},{"spoiler":true,"text":"She's actually a 22-year-old university graduate who suffers severe depression due to the sudden enormous gap between adolescence and adulthood, and regrets her wasted youth."}],"source":"vndb","sourceCharacterId":"c142016"},{"segments":[{"spoiler":false,"text":"初対面の伊織にいきなり絡んできた挙げ句、勝手に住み着いてしまった自称天使。"},{"spoiler":false,"text":"衣食住を提供する対価として、伊織の青春を恋愛でハッピーにすると豪語し、あれやこれやとお節介を焼いてくるが、やってることはただのコスプレ家出少女。"},{"spoiler":false,"text":"黙っていればまさしく天使と見紛うような容姿だが、ひとたび口を開けば悪魔じみたことしか言わない。"},{"spoiler":false,"text":"聞いてもいないことをペラペラと喋る。なのに自分のことは話そうとはしないし、伊織以外の人間と一緒にいるところもあまり見ない。"}],"source":"egs","sourceCharacterId":"27187","sourceWorkId":"37191","spoiler":false},{"segments":[{"spoiler":false,"text":"「私はきらりんハッピー天使ちゃん！　幸せで溢れる世の中にしたいの！」"},{"spoiler":false,"text":"初対面の伊織にいきなり絡んできた挙げ句、勝手に住み着いてしまった自称天使。"},{"spoiler":false,"text":"衣食住を提供する対価として、伊織の青春を恋愛でハッピーにすると豪語し、あれやこれやとお節介を焼いてくるが、やってることはただのコスプレ家出少女。"},{"spoiler":false,"text":"黙っていればまさしく天使と見紛うような容姿だが、ひとたび口を開けば悪魔じみたことしか言わない。"},{"spoiler":false,"text":"聞いてもいないことをペラペラと喋る。なのに自分のことは話そうとはしないし、伊織以外の人間と一緒にいるところもあまり見ない。"},{"spoiler":false,"text":"mask真名：天音きらり (あまおと きらり)/mask"}],"source":"bangumi","sourceCharacterId":"164239"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fcabfaca6c67e8e6b69f7d728b65c1510db7dadc948c43e5ae8ac9d6589b68a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89c9d7b684aa5bbd834f9c3e6d1dfc0f71ed3a46553667211b6f864471b97632.webp","width":234,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎真実","creatorId":"vndb:s199","sourcePersonId":"vndb:s199","canonicalEntityId":"vndb:s199","name":"尾崎 真実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:565451:164239:8165:1","source":"bangumi"}]},{"characterId":"char_c142017","characterName":"藍沢 紫","sourceIds":{"bangumi":[{"characterId":"164240","match":"exact-normalized-name-in-linked-work","subjectId":"512796"}],"egsCharacterIds":["27188"],"vndbCharacterId":"c142017"},"originalCharacterName":"藍沢 紫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A famous model who appears in numerous TV commercials—and Iori’s classmate."},{"spoiler":false,"text":"She always looks beautiful no matter what she does, giving off a more mature vibe compared to her classmates. However, in reality, she is an eccentric girl who only acts according to her own desires."},{"spoiler":false,"text":"She has a playful and somewhat teasing side, which creates a stark contrast between her image as a model and her true personality. She frequently skips school for her job, but deep down, longs to live a normal student life."},{"spoiler":false,"text":"One of her most distinctive traits is her (almost) complete lack of self-sufficiency, and she often uses her job as an excuse to avoid bothersome tasks."}],"source":"vndb","sourceCharacterId":"c142017"},{"segments":[{"spoiler":false,"text":"ＣＭにたくさん出ている有名なモデルで、伊織のクラスメイト。"},{"spoiler":false,"text":"なにをしていても様になるし、他のクラスメイトたちよりも雰囲気大人っぽく感じるが、中身は極めてマイペースな変わり者。"},{"spoiler":false,"text":"歳相応にイタズラ好きでおちゃめな一面もあるため、モデルである彼女の姿とのギャップに困惑することも。"},{"spoiler":false,"text":"仕事で学校を休んでしまうことも多く、本音を言うともう少しだけ学生らしく過ごしたがっている。"},{"spoiler":false,"text":"ひとり暮らしをしているわりには、生活能力がゼロに近しい。仕事が忙しいから仕方ないとよく言い訳している。"}],"source":"egs","sourceCharacterId":"27188","sourceWorkId":"37191","spoiler":false},{"segments":[{"spoiler":false,"text":"「あ、バレた？　私、人の名前と顔、覚えるの苦手なんだよね」"},{"spoiler":false,"text":"CMにたくさん出ている有名なモデルで、伊織のクラスメイト。"},{"spoiler":false,"text":"なにをしていても様になるし、他のクラスメイトたちよりも雰囲気大人っぽく感じるが、中身は極めてマイペースな変わり者。"},{"spoiler":false,"text":"歳相応にイタズラ好きでおちゃめな一面もあるため、モデルである彼女の姿とのギャップに困惑することも。"},{"spoiler":false,"text":"仕事で学校を休んでしまうことも多く、本音を言うともう少しだけ学生らしく過ごしたがっている。"},{"spoiler":false,"text":"ひとり暮らしをしているわりには、生活能力がゼロに近しい。仕事が忙しいから仕方ないとよく言い訳している。"}],"source":"bangumi","sourceCharacterId":"164240"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fa5c3198a3c8b97f52034a60074c799beaff382b0fcdf27d903e7c7f0d29a87.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2ddb07c084f6ed813a5e927a4237dfbcf8ae49203e7f232f8b31d6b45543d17.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"京亜耶奈","creatorId":"vndb:s14782","sourcePersonId":"vndb:s14782","canonicalEntityId":"vndb:s14782","name":"京 亜耶奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:565451:164240:27805:1","source":"bangumi"}]},{"characterId":"char_c142018","characterName":"犬屋 恋丸","sourceIds":{"bangumi":[{"characterId":"164241","match":"exact-normalized-name-in-linked-work","subjectId":"512796"}],"egsCharacterIds":["27189"],"vndbCharacterId":"c142018"},"originalCharacterName":"犬屋 恋丸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A puppy-like kouhai you just can't resist petting"},{"spoiler":false,"text":"A quite puppy-like kouhai."},{"spoiler":false,"text":"When she is happy, it's so obvious that you could almost hallucinate a non-existent tail wagging behind her."},{"spoiler":false,"text":"Curious and prone to sticking her nose into everything, she loves trying out things she has newly learned."},{"spoiler":false,"text":"She tends to guard her accident-prone best friend, Sachi, like a protective watchdog."},{"spoiler":false,"text":"But beware: if you make her angry, she'll chomp down on you without mercy."},{"spoiler":false,"text":"Translated from official user's manual"}],"source":"vndb","sourceCharacterId":"c142018"},{"segments":[{"spoiler":false,"text":"とってもワンコ感のある後輩。"},{"spoiler":false,"text":"あるはずのない尻尾がフリフリしている幻覚が見えてしまうぐらい、ご機嫌だと分かりやすい。"},{"spoiler":false,"text":"好奇心旺盛ですぐ首を突っ込みがちで、新しく覚えてきたことを試したがる。"},{"spoiler":false,"text":"なにかと危なっかしい親友の沙智を番犬のごとく守ろうとしている。"},{"spoiler":false,"text":"怒らせるとカブっと容赦なく噛み付いてくるので気をつけよう。"}],"source":"egs","sourceCharacterId":"27189","sourceWorkId":"37191","spoiler":false},{"segments":[{"spoiler":false,"text":"「なんですかその目は、噛みますよガルルゥ」"},{"spoiler":false,"text":"とってもワンコ感のある後輩。"},{"spoiler":false,"text":"あるはずのない尻尾がフリフリしている幻覚が見えてしまうぐらい、ご機嫌だと分かりやすい。"},{"spoiler":false,"text":"好奇心旺盛ですぐ首を突っ込みがちで、新しく覚えてきたことを試したがる。"},{"spoiler":false,"text":"なにかと危なっかしい親友の沙智を番犬のごとく守ろうとしている。"},{"spoiler":false,"text":"怒らせるとカブっと容赦なく噛み付いてくるので気をつけよう。"}],"source":"bangumi","sourceCharacterId":"164241"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47c4a0ed5e33ee8326ad04bf1e9019ead23bdbf36fca4794969b2940c74e95fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e158d78d30656ec305106a0e05f1a403beebf95a230d4ad303c7ba8298831ba3.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"湯宮由海","creatorId":"vndb:s5006","sourcePersonId":"vndb:s5006","canonicalEntityId":"vndb:s5006","name":"湯宮 由海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:565451:164241:19558:1","source":"bangumi"}]},{"characterId":"char_c142019","characterName":"Anego (姉御)","sourceIds":{"bangumi":[{"characterId":"164242","match":"exact-normalized-name-in-linked-work","subjectId":"512796"}],"egsCharacterIds":["27190"],"vndbCharacterId":"c142019"},"originalCharacterName":"Anego (姉御)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A senpai who does everything in her power to be admired… Yes, she’s a senpai."},{"spoiler":false,"text":"She carries herself with the airs of a princess yet struggles with social interactions. That said, her proportions are certainly impressive—if you conveniently ignore her height."},{"spoiler":false,"text":"Her complex personality makes her stand out in all the wrong ways, often leaving her isolated. Despite this, she managed to form friendships through online gaming, though one of those bonds eventually took on a sibling-like dynamic rather than one of admiration."},{"spoiler":false,"text":"Determined to prove her worth, she tries her best to impress her friends in-game… but, unfortunately, she’s not exactly skilled at it."}],"source":"vndb","sourceCharacterId":"c142019"},{"segments":[{"spoiler":false,"text":"チヤホヤされることに全力を出している先輩・・・にはとても見えないがちゃんと先輩。"},{"spoiler":false,"text":"コンプレックスの塊で、どこまでも不器用なお姫様。なお本人のスペック（身長以外）はそれなりに高い模様。"},{"spoiler":false,"text":"性格的な面もあり、周りとは馴染まず、ぼっちだった。なんとかできたゲーム友達も、こじれてなぜか舎弟関係になっている。"},{"spoiler":false,"text":"オンラインゲームの中でぐらいは虚勢を張りたい、チヤホヤされたいと思っていたが、それも上手くいかずにいる。"}],"source":"egs","sourceCharacterId":"27190","sourceWorkId":"37191","spoiler":false},{"segments":[{"spoiler":false,"text":"「当たり前じゃないの、守られるべきなのはヒメであるべきよ」"},{"spoiler":false,"text":"チヤホヤされることに全力を出している先輩・・・にはとても見えないがちゃんと先輩。"},{"spoiler":false,"text":"コンプレックスの塊で、どこまでも不器用なお姫様。なお本人のスペック（身長以外）はそれなりに高い模様。"},{"spoiler":false,"text":"性格的な面もあり、周りとは馴染まず、ぼっちだった。なんとかできたゲーム友達も、こじれてなぜか舎弟関係になっている。"},{"spoiler":false,"text":"オンラインゲームの中でぐらいは虚勢を張りたい、チヤホヤされたいと思っていたが、それも上手くいかずにいる。"}],"source":"bangumi","sourceCharacterId":"164242"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a72176d2bfea17351d87cd12742f0885f6ab1df038839c57c920a6eaff734c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc4f0aad61f743755c5fbc15f9aa90e3667afe8dbca15f8630eed6f9ae1ccf75.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和鳴るせ","creatorId":"vndb:s2143","sourcePersonId":"vndb:s2143","canonicalEntityId":"vndb:s2143","name":"和鳴 るせ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:565451:164242:32794:1","source":"bangumi"}]},{"characterId":"char_c144263","characterName":"柏木 すみれ","sourceIds":{"bangumi":[{"characterId":"166352","match":"exact-normalized-name-in-linked-work","subjectId":"512796"}],"egsCharacterIds":["27191"],"vndbCharacterId":"c144263"},"originalCharacterName":"柏木 すみれ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Scary yet warm-hearted part-time job senior"},{"spoiler":false,"text":"A senior at Iori's part-time job."},{"spoiler":false,"text":"She always looks grumpy, but it's just her bad attitude; once you get to know her, she's surprisingly kind."},{"spoiler":false,"text":"She looks a little tough, but when you look closely, you'll see she's quite beautiful."},{"spoiler":false,"text":"She is Yukari's cousin and they get along well, they often hang out together since they live close to each other."},{"spoiler":false,"text":"She loves cute things while worrying that they do not suit her."},{"spoiler":false,"text":"Translated from official user's manual"}],"source":"vndb","sourceCharacterId":"c144263"},{"segments":[{"spoiler":false,"text":"伊織のバイト先の先輩。"},{"spoiler":false,"text":"いつも不機嫌そうな顔をしているが、態度が悪いだけで仲良くなると案外優しい。"},{"spoiler":false,"text":"見た目はちょっと厳ついがよく見るとかなりの美人。"},{"spoiler":false,"text":"紫とは従妹で仲が良く、家が近いこともあってよく一緒にいる。"},{"spoiler":false,"text":"自分には似合わないと思いつつも、可愛いものが大好き。"}],"source":"egs","sourceCharacterId":"27191","sourceWorkId":"37191","spoiler":false},{"segments":[{"spoiler":false,"text":"「パイセンやめろ」"},{"spoiler":false,"text":"伊織のバイト先の先輩。"},{"spoiler":false,"text":"いつも不機嫌そうな顔をしているが、態度が悪いだけで仲良くなると案外優しい。"},{"spoiler":false,"text":"見た目はちょっと厳ついがよく見るとかなりの美人。"},{"spoiler":false,"text":"紫とは従妹で仲が良く、家が近いこともあってよく一緒にいる。"},{"spoiler":false,"text":"自分には似合わないと思いつつも、可愛いものが大好き。"}],"source":"bangumi","sourceCharacterId":"166352"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7825a8d658e15ff5ee092cf64411e6ddc300a2fa2a76029b109de3425e18dba8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4394ce126c01ae08312a4b4aa34035f2e6ec181b7a61a7ffecd2bde883afc4c.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山吹うらら","creatorId":"vndb:s32997","sourcePersonId":"vndb:s32997","canonicalEntityId":"vndb:s32997","name":"山吹 うらら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:565451:166352:54487:1","source":"bangumi"}]},{"characterId":"char_c144264","characterName":"緒方 寧子","sourceIds":{"bangumi":[{"characterId":"166353","match":"exact-normalized-name-in-linked-work","subjectId":"512796"}],"egsCharacterIds":["27192"],"vndbCharacterId":"c144264"},"originalCharacterName":"緒方 寧子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A pampered-pampering crybaby, sweatshop worker, and stepsister"},{"spoiler":false,"text":"Iori's older stepsister. Although the two live together, she works for a sweatshop company with heavy overtime, so she's rarely home during the day."},{"spoiler":false,"text":"On some days, she can't sleep unless she's cuddled and soothed – if she isn't pampered just enough, the work stress will literally kill her."},{"spoiler":false,"text":"She wants Iori to call her \"sis\", but he refuses, so they've compromised on \"Nei-san\" (big sis Nei). She's a major brocon with high dependence on him both emotionally and for daily life."},{"spoiler":false,"text":"On rare occasions, she shows a properly mature side."},{"spoiler":false,"text":"Translated from official user's manual"}],"source":"vndb","sourceCharacterId":"c144264"},{"segments":[{"spoiler":false,"text":"伊織の義姉。ふたりで暮らしているが、ブラック企業で残業が多いため、日中はあまり家にいない。"},{"spoiler":false,"text":"ヨシヨシされないと眠れない日もあるぐらい、適度に甘やかさないと労働のストレスで死んでしまう。"},{"spoiler":false,"text":"伊織にお姉ちゃんと呼んでほしいがイヤがるので、寧さん呼びで妥協している。精神・生活の両面でかなり依存度の高いブラコン。"},{"spoiler":false,"text":"稀にちゃんと大人らしい一面を見せることも。"}],"source":"egs","sourceCharacterId":"27192","sourceWorkId":"37191","spoiler":false},{"segments":[{"spoiler":false,"text":"「ヤダヤダ！お仕事行きたくないもん！このままお布団の中で暮らすの！」"},{"spoiler":false,"text":"伊織の義姉。ふたりで暮らしているが、ブラック企業で残業が多いため、日中はあまり家にいない。"},{"spoiler":false,"text":"ヨシヨシされないと眠れない日もあるぐらい、適度に甘やかさないと労働のストレスで死んでしまう。"},{"spoiler":false,"text":"伊織にお姉ちゃんと呼んでほしいがイヤがるので、寧さん呼びで妥協している。精神・生活の両面でかなり依存度の高いブラコン。"},{"spoiler":false,"text":"稀にちゃんと大人らしい一面を見せることも。"}],"source":"bangumi","sourceCharacterId":"166353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a6f6a4c2d574644dd8c96dd1490f18d1832fb1746ccf8ff7c2b9533c0f0b628.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c5ecf51ec579aa0e36907f02fd76c0b4db0e2ecc2be0d326f6b05b65e38c6bb.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夜空あかり","creatorId":"vndb:s34489","sourcePersonId":"vndb:s34489","canonicalEntityId":"vndb:s34489","name":"夜空 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","rela