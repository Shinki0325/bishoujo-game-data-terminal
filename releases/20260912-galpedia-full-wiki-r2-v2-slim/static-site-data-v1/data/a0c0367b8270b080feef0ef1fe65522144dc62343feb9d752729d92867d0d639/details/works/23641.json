{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23641","model":{"presentationWorkId":"vndb:v19451","staff":{"artwork":[{"creditedName":"薦田ロボ(蜜図帆こも、こもだ)","creatorId":"vndb:s2947","sourcePersonId":"egs:creator:14267","canonicalEntityId":"vndb:s2947","name":"薦田ロボ(蜜図帆こも、こもだ)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:165152","source":"egs"}],"scenario":[{"creditedName":"サブマリン","creatorId":"vndb:s5418","sourcePersonId":"egs:creator:22922","canonicalEntityId":"vndb:s5418","name":"サブマリン","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:165153","source":"egs"}],"music":[],"other":[{"creditedName":"サブマリン","creatorId":"vndb:s5418","sourcePersonId":"egs:creator:22922","canonicalEntityId":"vndb:s5418","name":"サブマリン","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:165180","source":"egs"}]},"cast":[{"characterId":"char_c56406","characterName":"永沢 時子","sourceIds":{"bangumi":[{"characterId":"57895","match":"exact-normalized-name-in-linked-work","subjectId":"217813"}],"egsCharacterIds":["10118"],"vndbCharacterId":"c56406"},"originalCharacterName":"永沢 時子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心優しく面倒見のいい性格をした弟大好きお姉ちゃん。"},{"spoiler":false,"text":"クラスでも人気があるが、本人は気付いていない。"},{"spoiler":false,"text":"離れ離れになった弟のことをずっと思い続け、再会してから、情緒不安定な弟をまともな人生が歩めるようにと、ずっと隣で支えることを誓う。"},{"spoiler":false,"text":"全ては、弟が奪われた大切な時間を一緒に取り戻すために。"}],"source":"egs","sourceCharacterId":"10118","sourceWorkId":"23641","spoiler":false},{"segments":[{"spoiler":false,"text":"誰にでも優しく、面倒見が良い少女。"},{"spoiler":false,"text":"人付き合いは上手だが、弟を溺愛しており他人には興味がない。"},{"spoiler":false,"text":"過去、両親の離婚で弟と離れ離れになってしまい、ずっと悔いていた。"},{"spoiler":false,"text":"父親が亡くなったことで再会を果たすも 弟は情緒不安定になっていて、"},{"spoiler":false,"text":"弟が社会復帰できるようにと全力で面倒をみることを誓う。"},{"spoiler":false,"text":"「つーくん、そろそろまた、学校にいこ？"},{"spoiler":false,"text":"お姉ちゃん、つーくんと一緒に通学したいな」"}],"source":"bangumi","sourceCharacterId":"57895"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24474a660434c1f52536031a9f1dd3d6e4af72ccc5d8e8d772ce932c41b5e20f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ab247beb7cf545626c6c8f88727d6b6bd9675c89f4733dc3438ff02fc10c29f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217813:57895:20833:1","source":"bangumi"}]},{"characterId":"char_vndb_c56407","characterName":"永沢 紡希","sourceIds":{"vndbCharacterId":"c56407"},"originalCharacterName":"永沢 紡希","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p384","sourceCompanyId":"egs:brand:1869","canonicalEntityId":"vndb:p384","name":"HEAT-SOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23641:1869","source":"egs"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:53124:v19451","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonica