"segments":[{"spoiler":false,"text":"秋生の隣の家に住むクールな女教師。学生からの人気は高いが非常に毒舌で、涼しい顔で罵詈雑言を吐く。"}],"source":"egs","sourceCharacterId":"6236","sourceWorkId":"21669","spoiler":false},{"segments":[{"spoiler":false,"text":"隣家に住んでいる美人でスタイル良しのお姉さん。"},{"spoiler":false,"text":"主人公とは幼なじみで、入学した学園の女教師でもある。"},{"spoiler":false,"text":"学生からの人気は高いが非常に毒舌で、涼しい顔で罵詈雑言を吐く。"},{"spoiler":false,"text":"クールに見えるが、実はわりと少女趣味。 好きな男子をついいぢめてしまうタイプ。"},{"spoiler":false,"text":"「いい歳って言わないで下さい、この性犯罪ドエム男」"}],"source":"bangumi","sourceCharacterId":"54708"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7158bc56c3aac246f0da2c687ddbd83dca6aff7f570f2e08eaa85b2f9ac1ea4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44f194a07c50b98a006cf35804933e17ed230dbe62b647e22d3bd2d69da41b8f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"設楽麻美","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:216399:54708:7904:1","source":"bangumi"}]},{"characterId":"char_c33281","characterName":"大石 眞美","sourceIds":{"bangumi":[{"characterId":"54709","match":"exact-normalized-name-in-linked-work","subjectId":"216399"}],"egsCharacterIds":["6237"],"vndbCharacterId":"c33281"},"originalCharacterName":"大石 眞美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秋生の義妹で、学園の１年生。秋生のベッドで自慰行為に耽っていた姿を、彼に目撃されてしまい……!?"}],"source":"egs","sourceCharacterId":"6237","sourceWorkId":"21669","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義妹で、クラスメイトから慕われている明るい少女。"},{"spoiler":false,"text":"主人公にだけ挑発的な態度で接してくるが、やり過ぎたと感じると途端に不安げな口調