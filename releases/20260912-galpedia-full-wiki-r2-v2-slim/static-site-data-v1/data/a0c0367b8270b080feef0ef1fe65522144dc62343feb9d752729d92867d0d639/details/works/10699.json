:52184","source":"vndb"},{"creditedName":"龍牙 翔","creatorId":"vndb:s1115","sourcePersonId":"vndb:s1115","canonicalEntityId":"vndb:s1115","name":"龍牙 翔","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:52185","source":"vndb"},{"creditedName":"ほたか たまごろー","creatorId":"vndb:s6003","sourcePersonId":"vndb:s6003","canonicalEntityId":"vndb:s6003","name":"ほたか たまごろー","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:52189","source":"vndb"},{"creditedName":"ぼみ","creatorId":"vndb:s6933","sourcePersonId":"vndb:s6933","canonicalEntityId":"vndb:s6933","name":"ぼみ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:52191","source":"vndb"},{"creditedName":"いちめどー","creatorId":"vndb:s30410","sourcePersonId":"vndb:s30410","canonicalEntityId":"vndb:s30410","name":"Pセプター","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52194","source":"vndb"}]},"cast":[{"characterId":"char_c77811","characterName":"ミランダ＝グレイス＝アリシューザ","sourceIds":{"bangumi":[{"characterId":"200721","match":"exact-normalized-name-in-linked-work","subjectId":"219235"},{"characterId":"200721","match":"exact-normalized-name-in-linked-work","subjectId":"219236"},{"characterId":"200721","match":"exact-normalized-name-in-linked-work","subjectId":"623348"},{"characterId":"200721","match":"exact-normalized-name-in-linked-work","subjectId":"623350"}],"egsCharacterIds":["18512"],"vndbCharacterId":"c77811"},"originalCharacterName":"ミランダ＝グレイス＝アリシューザ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"王立アルケミスト養成学校の剣術科に所属する女の子。"},{"spoiler":false,"text":"代々、高名な騎士を輩出してきた家系に生まれ、自らも父親のような立派な騎士を目指している。"},{"spoiler":false,"text":"性格は礼儀正しく、聡明で、当然ながら騎士道精神を重んじる。"},{"spoiler":false,"text":"成績も良く、剣の腕前も抜群だが、主人公にはどうしても勝てない。そのため、主人公をライバル視している。"},{"spoiler":false,"text":"誇り高く、普段、まったく練習していないように見えるが、実は誰も見ていないところで人一倍努力している。"}],"source":"egs","sourceCharacterId":"18512","sourceWorkId":"10699","spoiler":false},{"segments":[{"spoiler":false,"text":"剣術科所属。代々高名な騎士を数多く輩出してきた家系の出身。聡明で騎士道精神を重んじる根っからの騎士。"},{"spoiler":false,"text":"成績も良く腕も立つが、剣術だけはレミリスにどうしても勝てないので（トータルの席次は彼女の方が断然上）ライバル視している。"},{"spoiler":false,"text":"一見努力などしていないように見えるが、実は誰も見ていないところで人一倍努力している。"}],"source":"bangumi","sourceCharacterId":"200721"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a453e7117c479cb43a57b228068d1ada58a8ffc813b8463b17d98c82e908246.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42809b30dae087634e88dce7422022b0ee5c23de1a1c58fca6e92c6d7f95ca75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219235:200721:4432:1","source":"bangumi"}]},{"characterId":"char_c77812","characterName":"ガーベラ＝ガーベルハイト","sourceIds":{"bangumi":[{"characterId":"200722","match":"exact-normalized-name-in-linked-work","subjectId":"219235"},{"characterId":"200722","match":"exact-normalized-name-in-linked-work","subjectId":"219236"},{"characterId":"200722","match":"exact-normalized-name-in-linked-work","subjectId":"623348"},{"characterId":"200722","match":"exact-normalized-name-in-linked-work","subjectId":"623350"}],"egsCharacterIds":["18513"],"vndbCharacterId":"c77812"},"originalCharacterName":"ガーベラ＝ガーベルハイト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"王立アルケミスト養成学校の魔術科に所属する女の子。"},{"spoiler":false,"text":"彼女の所属する魔術科は近年、人気を集め、その生徒数を増やしている。その中でも彼女は優秀で、養成学校始まって以来の才媛と呼ばれている。"},{"spoiler":false,"text":"プライドも気位も高く近寄り難い雰囲気を持ち、常に冷静沈着。"},{"spoiler":false,"text":"剣術科のミランダとは犬猿の仲。"},{"spoiler":false,"text":"そんな彼女は大の運動音痴。"}],"source":"egs","sourceCharacterId":"18513","sourceWorkId":"10699","spoiler":false},{"segments":[{"spoiler":false,"text":"魔術科所属。近年生徒数を増やしている魔術科の中でも極め付けに優秀な人物で、養成校始まって以来の才媛と呼ばれている。剣術科・主席のミランダとは犬猿の仲。"},{"spoiler":false,"text":"落ち着いていて滅多なことでは取り乱さない。だけど意外と恋愛は奥手？"},{"spoiler":false,"text":"はじめはレミリスなど目もくれなかったが……。"}],"source":"bangumi","sourceCharacterId":"200722"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb03cd27ed508d106620443454c8ee740b4a69b121c364a47eb3551b91699a9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76421285f08faf00bb18d1182be58eb0af9ebaee2df2b95e468920e6bca0f292.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219235:200722:4799:1","source":"bangumi"}]},{"characterId":"char_c77813","characterName":"ジェシカ＝オルティス","so