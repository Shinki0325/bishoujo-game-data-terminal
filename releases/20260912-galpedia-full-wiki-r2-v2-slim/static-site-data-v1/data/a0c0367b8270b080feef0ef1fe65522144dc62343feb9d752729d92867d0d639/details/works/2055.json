dentityStatus":"source-native","relationId":"vndb:vn-staff:20218","source":"vndb"},{"creditedName":"Minako","creatorId":"vndb:s9414","sourcePersonId":"vndb:s9414","canonicalEntityId":"vndb:s9414","name":"Minako","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:20219","source":"vndb"}]},"cast":[{"characterId":"char_c33540","characterName":"スイートリップ","sourceIds":{"bangumi":[{"characterId":"96131","match":"exact-normalized-name-in-linked-work","subjectId":"222239"}],"egsCharacterIds":["984"],"vndbCharacterId":"c33540"},"originalCharacterName":"スイートリップ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、学園のアイドル的存在。"},{"spoiler":false,"text":"学園生の代表で組織する自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると放っておけない。"},{"spoiler":false,"text":"頭脳明晰、母性的で潔癖症。正義感が強く、"},{"spoiler":false,"text":"スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために尽くしたいと考えている。"},{"spoiler":false,"text":"国際上級官僚を育成する総合部国際科に属している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"2055","spoiler":false},{"segments":[{"spoiler":false,"text":"『魔法戦士スイートナイツ』のヒロイン。"},{"spoiler":false,"text":"清楚で正義感の強いスイートナイツの中心的存在。"},{"spoiler":false,"text":"メッツァーに対して敵同士以上の想いがある。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"第一世代魔法戦士のリーダー格。"},{"spoiler":false,"text":"現在はかつての学び舎である国際教導学園に復学し、外交官となるための勉強を続けながら、特別講師として時折後輩たちのために教鞭を執っている。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"17330","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーの宿敵。"},{"spoiler":false,"text":"清純な容姿と純真な正義の心に、淫らな肉体を併せ持つ美しい戦士。"},{"spoiler":false,"text":"一度覚えてしまった被虐の悦びからは二度と逃げられない……。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"「こんな自分にはもう、魔法戦士の資格なんてないのかも……」"},{"spoiler":false,"text":"スイートナイツの一人。"},{"spoiler":false,"text":"現在地上で活動している魔法戦士たちのリーダー格。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"国際教導学園で特別講師を務めていたが、講師退任後行方が分からなくなっている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士のリーダー格の一人。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"以前の戦いで、悪の野望を防ぐためにゲートに飛び込み、取り込まれたままいまだ帰還していない。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツのリーダー、スイートリップ。本名は七瀬凛々子。"},{"spoiler":false,"text":"世界の支配を企む悪と戦い続けてきた歴戦の魔法戦士。その優しさと悪に屈することない強さで他の魔法戦士たちからも慕われている。"},{"spoiler":false,"text":"以前の戦いでゲートと呼ばれる魔導演算装置に取り込まれ、しばらくの間消息不明となっていたが、仲間たちによって無事救出される。"},{"spoiler":false,"text":"しかし、異空間に長期間囚われたことで、彼女は戦うための力を失ってしまう。 現在は国際教導学園の学生として、自身の次の道を模索している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"スイートナイツの一人、魔法戦士スイートリップ。"},{"spoiler":false,"text":"現在は特別魔法外交官として活躍している。"},{"spoiler":false,"text":"かつて倒した悪の組織の残党が暗躍しているという情報を聞き、調査へと赴く。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"37809","spoiler":false},{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、 学園のアイドル的存在。学園生の代表で組織する 自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると 放っておけない。頭脳明晰、母性的で潔癖症。正義感が強く、スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために 尽くしたいと考えている。国際上級官僚を育成す る総合部国際科に属している。"}],"source":"bangumi","sourceCharacterId":"96131"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a55f22b1500af098caa60ce65d63437402b9533e4ccf14fd5f2b6885b1dece56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93e929f8899aaac84d2e6c72f4e17d6fda8fad73948c4bd180803979c036d637.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222229:96131:4689:1","source":"bangumi"}]},{"characterId":"char_c49543","characterName":"ココノ・アクア","sourceIds":{"bangumi":[{"characterId":"96134","match":"exact-normalized-name-in-linked-work","subjectId":"222229"},{"characterId":"96134","match":"exact-normalized-name-in-linked-work","subjectId":"222230"},{"characterId":"96134","match":"exact-normalized-name-in-linked-work","subjectId":"222233"},{"characterId":"96134","match":"exact-normalized-name-in-linked-work","subjectId":"222242"}],"egsCharacterIds":["989"],"vndbCharacterId":"c49543"},"originalCharacterName":"ココノ・アクア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に忠実で、よく気のつく優秀な副官。"},{"spoiler":false,"text":"もとはスイートナイツと同じく正義を守る戦士だったが、"},{"spoiler":false,"text":"主人公に捕らえられ、調教されて、彼の従順な奴隷となった。"},{"spoiler":false,"text":"冷静な反面、一途で甲斐甲斐しい一面を持つ。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"2055","spoiler":false},{"segments":[{"spoiler":false,"text":"流浪の身となっても、メッツァーに変わらぬ忠誠を誓っている。"},{"spoiler":false,"text":"むしろ、彼と二人きりの時間を多く過ごせる今の方が、"},{"spoiler":false,"text":"彼女にとっては幸せなのかもしれない。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"3373","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーの副官。"},{"spoiler":false,"text":"陰から日なたからメッツァーを助力する。"},{"spoiler":false,"text":"元女神近衛団アップルナイツの魔法戦士。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーをサポートし続ける忠実な副官。"},{"spoiler":false,"text":"冷静、沈着にして有能、家事一般にも秀でる。"},{"spoiler":false,"text":"相変わらずメッツァーに対して一途な気持ちを持ち続けている。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツアーの右腕にして愛らしい性奴隷。"},{"spoiler":false,"text":"メッツアーの初めての獲物でもある。"},{"spoiler":false,"text":"冷静で良く気が利き、全てをメッツァーに捧げる最高の副官。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァー・ハインケルの副官。"},{"spoiler":false,"text":"もともとは女神近衛団第二騎士団アップルナイツの副団長を務める魔法戦士であったが、メッツァーに捕獲された際に調教を受け、彼に忠実な下僕となり果てた。"},{"spoiler":false,"text":"メッツァーのことを心から愛しており、メッツァーもまた、ココノに対し副官以上の感情を抱いている。"},{"spoiler":false,"text":"メッツァーが封印された後、潜伏しながら封印を無効化する方法を探し続けていた。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に忠実で、よく気のつく優秀な副官。 もとはスイートナイツと同じく正義を守る戦士だ ったが、主人公に捕らえられ、調教されて、彼の 従順な奴隷となった。"},{"spoiler":false,"text":"冷静な反面、一途で甲斐甲斐しい一面を持つ。"}],"source":"bangumi","sourceCharacterId":"96134"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e9404b24147e340d10c3aa39f48b8548dda57054ea61d61351247374858bc75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9ce0793bc2c5a49fba998b91f67873e5fb419327e1eb375fe3c9c16264b8cba