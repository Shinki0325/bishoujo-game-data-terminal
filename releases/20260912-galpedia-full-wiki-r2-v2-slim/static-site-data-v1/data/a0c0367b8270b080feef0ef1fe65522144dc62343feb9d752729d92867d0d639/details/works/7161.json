"},{"creditedName":"遠井総良","creatorId":"vndb:s15894","sourcePersonId":"vndb:s15894","canonicalEntityId":"vndb:s15894","name":"Midpine","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8621","source":"vndb"},{"creditedName":"中部 真","creatorId":"vndb:s44319","sourcePersonId":"vndb:s44319","canonicalEntityId":"vndb:s44319","name":"中尾 陽子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8622","source":"vndb"}]},"cast":[{"characterId":"char_c9723","characterName":"高城 麟瞳","sourceIds":{"bangumi":[{"characterId":"65198","match":"exact-normalized-name-in-linked-work","subjectId":"130547"}],"egsCharacterIds":["25871"],"vndbCharacterId":"c9723"},"originalCharacterName":"高城 麟瞳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"224"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立倫応学園の二年生。学園中にある全委員会と中立関係にあり、また委員会同士の争いの調停を行う委員会――、調停委員会の現委員長。"},{"spoiler":false,"text":"一年のほとんどをディスプレイに囲まれた調停委員会のボックス内におり、彼女がそこから出るところを見た者はいない。"},{"spoiler":false,"text":"感情を顔や言動に表すことはない、非常にクールな性格。"},{"spoiler":false,"text":"調停委員の長として、優秀にして有能な彼女は、学園の影の委員長と囁かれている"}],"source":"egs","sourceCharacterId":"25871","sourceWorkId":"7161","spoiler":false},{"segments":[{"spoiler":false,"text":"学園中にある全ての委員会と中立関係にあり、また委員会同士の争いの調停を行う委員会――調停委員会の現在の委員長。"},{"spoiler":false,"text":"1年のほとんどをディスプレイに囲まれた調停委員会のボックスの中で過ごしており、彼女が外出したり、そして寝たりするところを見た者はいない。"},{"spoiler":false,"text":"たまにボックスを抜けたりしても、それは委員会全体の会議のときだけ。"},{"spoiler":false,"text":"彼女の感情が顔や口調に出ることはなく、どの陣営派閥に対しても絶対的な中立を貫くその態度は、高く評価されている。"},{"spoiler":false,"text":"調停委員会はその活動故、学園側も容易に介入できず、またその結論を受け入れざるをえない状態である。"},{"spoiler":false,"text":"今期について、高城麟瞳はその能力により、学園の影の園長とまで囁かれている。"},{"spoiler":false,"text":"「どういう意味か知りませんが……下らないですね」"}],"source":"bangumi","sourceCharacterId":"65198"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"25871","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"25871","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"25871","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"25871","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"25871","sourceWorkId":"7161","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4ae28ce913e51ae7fb012940f432ab1a95fbf86988cd68557d5718e3ff85567c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d5794b092881defbc092e35986400e4bbc4c7b21f626ed3eba8fbad45a26792.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:130547:65198:4432:1","source":"bangumi"}]},{"characterId":"char_c9724","characterName":"診撚 縁","sourceIds":{"bangumi":[{"characterId":"65199","match":"exact-normalized-name-in-linked-work","subjectId":"130547"}],"egsCharacterIds":["25873"],"vndbCharacterId":"c9724"},"originalCharacterName":"診撚 縁","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"503"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立倫応学園の二年生。学園の保健室を管理する保健委員会の現委員長。"},{"spoiler":false,"text":"手先が器用で、怪我の手当てや、介護は得意としているが、勉強は苦手。"},{"spoiler":false,"text":"性格は、おっとりしていて大人しく、誰にでも分け隔てなく優しく接する女の子。"},{"spoiler":false,"text":"また頼まれると断れない性分のため、また委員会の長ということもあって、常に色々な難題を押し付けられている。"},{"spoiler":false,"text":"趣味は昼寝で、学園の穴場を見つけては、そこでまったりぼんやりすることが楽しみ。"}],"source":"egs","sourceCharacterId":"25873","sourceWorkId":"7161","spoiler":false},{"segments":[{"spoiler":false,"text":"保健委員会委員長。 学園の保健室を管理している。"},{"spoiler":false,"text":"将来の夢はもちろん医療関係の仕事～医師か看護婦を目指し、現在猛勉強中。"},{"spoiler":false,"text":"しかし、ケガの手当てをしたり、介護したりするのは得意だが、本人いわく勉強はなりの不得手。"},{"spoiler":false,"text":"こっそりと参考書のすみにパラパラマンガを描いているところからすると、やはりはかどっていない様子。"},{"spoiler":false,"text":"おとなしく、誰に対しても分け隔てなく優しい性格の持ち主。"},{"spoiler":false,"text":"頼まれれば断れない性分であり、また今は委員長という役割であるため、常にいろいろな難題を押し付けられている。"},{"spoiler":false,"text":"実はかなりの耳年増であり、その手の知識について、それなりに知っている。"},{"spoiler":false,"text":"しかし、実体験はなく、あくまで介護の際や、また医学書での知識でしかないため、突っ込まれたりすると、答えに窮してしまう。"},{"spoiler":false,"text":"趣味は昼寝。 日当たりの良いところや涼しいところなど、学園の穴場を見つけ、そこでぼんやりとするのが一番の楽しみ。"},{"spoiler":false,"text":"かなりおっとりとしているため、また言葉をいろいろと選んで話すため、会話のペースはかなり遅い。"},{"spoiler":false,"text":"それもあり無口だと思われているが、実際は時間の遅ささえ考慮にいれなければ、ちゃんとコミュニケーションができる。"},{"spoiler":false,"text":"最近では手先が器用であることもあり、スケッチブックを用いて筆談をすることも多い。"},{"spoiler":false,"text":"「あ……んとぉ…………お熱測ってみる？」"}],"source":"bangumi","sourceCharacterId":"65199"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"25873","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"25873","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"25873","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"25873","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"25873","sourceWorkId":"7161","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc3111c1349b6ad341484bea5a9b74bd5b5a5eae50733afa55d2ae8103efe600.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8ded1377b27c9dd812959f9efbe4bd43abe682c6d7ad47643361bd9ab4c988e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:130547:65199:4714:1","source":"bangumi"}]},{"characterId":"char_c9725","characterName":"経・アダムスミス","sourceIds":{"bangumi":[{"characterId":"65200","match":"exact-normalized-name-in-linked-work","subjectId":"130547"}],"egsCharacterIds":["25872"],"vndbCharacterId":"c9725"},"originalCharacterName":"経・アダムスミス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"7/29"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立倫応学園の一年生。経済委員会の委員長。"},{"spoiler":false,"text":"イギリス人の父親を持つハーフだが、日本生まれの日本育ちであるため、まったく英語は話せない。その父親は経済学者で、娘である経に「経済学とは、金で破綻するような人生を送らないためのもの……本質的に金銭を中心とする人生は愚かしいもの」と教えられて育った。"},{"spoiler":false,"text":"外見や言動、振る舞い全てが子供っぽいが、その学力と知能指数は最も高く、ある種の天才。常に好奇心と気持ちの赴くままに行動している。"}],"source":"egs","sourceCharacterId":"25872","sourceWorkId":"7161","spoiler":false},{"segments":[{"spoiler":false,"text":"経済委員会委員長。"},{"spoiler":false,"text":"委員長は、イギリスの経済学者を父に持つハーフ。"},{"spoiler":false,"text":"委員長の中では最年少であるが、その学力と知能指数は最も高い。"},{"spoiler":false,"text":"しかし、その外見と、普段の言動は年齢以上に子供っぽく、常にその好奇心と気持ちのおもむくままに行動している。"},{"spoiler":false,"text":"経にとって、経済はゲームの一つ。 父いわく、経済学とは、金で破綻するような人生を送らないためのもの……本質的に金銭を中心とする人生は愚かしいものだと教えられている。"},{"spoiler":false,"text":"日本生まれの日本育ちであるため、英語は話せない。"},{"spoiler":false,"text":"この理由は、父が家庭では日本語を使っていたせいであり、また彼女が日本語の響きを好きなため。"},{"spoiler":false,"text":"口調が少し舌ったらずなのは、子供の頃、英語と日本語、ついでに父の赴任先で覚えた外国語を混在して使っていたため。"},{"spoiler":false,"text":"ちなみに、口癖は返事をするときの「あい」。"},{"spoiler":false,"text":"「あい！　経は大好き！　玖郎は大好きかお？」"}],"source":"bangumi","sourceCharacterId":"65200"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"25872","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"sour