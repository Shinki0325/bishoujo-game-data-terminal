tate":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立倫応学園の三年生。「人は皆、知る権利を持つ」を信条とし、学園の全ての出来事を報道しようと奔走する、報道委員会の現委員長。"},{"spoiler":false,"text":"英国貴族の両親を持つ、生粋のイギリス人。"},{"spoiler":false,"text":"英国紳士を父としているためか、礼儀作法にうるさく、曲がったことは許さない、常にクールで、頑固一徹な性格。それ故、自分の信条と相反する者には徹底的に反抗する。"}],"source":"egs","sourceCharacterId":"25874","sourceWorkId":"7161","spoiler":false},{"segments":[{"spoiler":false,"text":"報道委員会委員長。"},{"spoiler":false,"text":"生粋のイギリス人であり、父母は共に英国貴族。"},{"spoiler":false,"text":"「人は皆、知る権利を持つ」を信条とし、学園の全ての出来事を報道しようと尽力している。"},{"spoiler":false,"text":"伝統ある英国紳士を父としているため、礼儀作法にうるさく、また曲がったことは許さない一本気で頑固な性格の持ち主。"},{"spoiler":false,"text":"普段は冷静沈着かつ優しげな言動であるものの、自分の信条に合わない者に対しては徹底的に反抗する。"},{"spoiler":false,"text":"その性格はやはり顔に表れるのか、涼やかで大人びたその容貌は、可愛さではなく、淑女然としたきれいさを備えている。"},{"spoiler":false,"text":"服装の乱れは心の乱れ――そのため、服装が乱れているのを見過ごしては置けない。"},{"spoiler":false,"text":"彼女自身は事実のみしか報道しないようにはしているが、古参および前委員長の一派により、委員会運営のためを口上に、ゴシップまがいの記事報道を許してしまっており、そのことが目下の悩みの種となっている。"},{"spoiler":false,"text":"「真実はそれを求める者以外、全くの無価値……"},{"spoiler":false,"text":"けれど、だからと言って真実の価値は変わらないわ」"}],"source":"bangumi","sourceCharacterId":"65201"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"25874","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"25874","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"25874","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"25874","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"57 kg","valueContext":null,"source":"egs","sourceCharacterId":"25874","sourceWorkId":"7161","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3488db688ea7bbc6ad39a77560baf4042fd96737a3fdb392c0b61b0e06769fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4417c11683a91ee47773651306a6bcad167f8e3ab7e8b93c13715d7133bfa3b4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:130547:65201:4832:1","source":"bangumi"}]},{"characterId":"char_c9727","characterName":"凪 葛刃","sourceIds":{"bangumi":[{"characterId":"65202","match":"exact-normalized-name-in-linked-work","subjectId":"130547"}],"egsCharacterIds":["25875"],"vndbCharacterId":"c9727"},"originalCharacterName":"凪 葛刃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"404"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立倫応学園の一年生。第三剣道委員会に所属する女子学生。"},{"spoiler":false,"text":"調停委員会会長にして幼馴染・麟瞳の命により、主人公の護衛の任に就く。"},{"spoiler":false,"text":"典型的な日本女性で、寡黙で、必要最低限のことしか口にしない。また曲がったことや、自分の信念を曲げることも良しとしない。"},{"spoiler":false,"text":"一年生ながらその剣の腕前は非常に高く、次期会長とも噂されているが、極度のあがり症で、それが原因で昇級試験などでは実力が出し切れず、敗退を繰り返している。"}],"source":"egs","sourceCharacterId":"25875","sourceWorkId":"7161","spoiler":false},{"segments":[{"spoiler":false,"text":"調停委員会会長である高城麟瞳の命に従い、主人公を影ながら護衛することになる。"},{"spoiler":false,"text":"表情は常に凛とした、生真面目そうなものであり、その感情を顔に表すことは滅多に無い。"},{"spoiler":false,"text":"ただし、本人いわく修行が足りないせいか、感情は表情にこそでないが、その口調にはしっかり表れてしまう。"},{"spoiler":false,"text":"性格は典型的な日本女性であり、寡黙で、必要最低限のことしか口にしない。"},{"spoiler":false,"text":"曲がったこと、そして自信の信念を曲げることを良しとしない。"},{"spoiler":false,"text":"また、自分の意志ははっきりと、そして明確に告げるため、時としてそれが軋轢を生むことがある。"},{"spoiler":false,"text":"表に出ることはなく、常に一歩退いた状態に自分を置く。"},{"spoiler":false,"text":"それは婦女子のたしなみ……というわけではなく、極度の上がり性であるため。"},{"spoiler":false,"text":"しかし、人前では、大和撫子は……とか武道に身を置く者は……などと、いろいろな理由をつけてごまかしている。"},{"spoiler":false,"text":"とはいえ、昇段試験の際、周囲の目が気になり、実力を出せずに敗退し続けている状態であるため、実は段はおろか級さえ持っていない。"},{"spoiler":false,"text":"普段は制服だが、放課後あるいは何かの有事になると、巫女の衣装にも似た武道着に着替える（これは神道無念流を祖とする流派に身を置くため）。"},{"spoiler":false,"text":"第三剣道委員会の中では若年ながら手錬れの者の一人であり、次期会長とも噂されている（が、そもそもこの委員会自体が学園では無名であるため、やはり祝刀は全く目立っていない存在のまま）。"},{"spoiler":false,"text":"調停委員会会長高城麟瞳とは、幼馴染（というより、江戸時代から続く主従関係。つまりは姫とお付の者）。"},{"spoiler":false,"text":"「私は…………ただ一本の刃……刃は何も喋らない」"}],"source":"bangumi","sourceCharacterId":"65202"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"25875","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"25875","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"25875","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"25875","sourceWorkId":"7161","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"25875","sourceWorkId":"7161","sourceField":null,"scoped":true}],