nly","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Amelia is a secluded princess. For most of her life she has been living in a cabin tucked away somewhere, and because of that she has all kinds of odd ideas about the outside world (for instance, she thought that sinks were used to take baths in). However, underneath her slightly ditzy exterior is a genius hacker."},{"spoiler":false,"text":"From Choux's review."}],"source":"vndb","sourceCharacterId":"c12986"},{"segments":[{"spoiler":false,"text":"女性・髪 モスグリーン:国籍 スイス"},{"spoiler":false,"text":"職業:無職"},{"spoiler":false,"text":"性格:素直で優しい。微ぽんこつ。"},{"spoiler":false,"text":"特技:コンピュータ関連"},{"spoiler":false,"text":"身長：:159cm、スリーサイズ：B88/W58/H87"},{"spoiler":false,"text":"趣味:投稿・掃除"},{"spoiler":false,"text":"ひっそりとスイスの片田舎で暮らしていたアメリア。"},{"spoiler":false,"text":"ある日、九郎の手によって日本へとやって来ることに。"},{"spoiler":false,"text":"現在は九郎の部屋に一緒に住み、学校へも通っている。"},{"spoiler":false,"text":"『……自分でもちょっとへんかな？　とか思ってたんです……』"}],"source":"egs","sourceCharacterId":"22665"},{"segments":[{"spoiler":false,"text":"女性・髪 モスグリーン:国籍 スイス"},{"spoiler":false,"text":"職業:無職"},{"spoiler":false,"text":"性格:素直で優しい。微ぽんこつ。"},{"spoiler":false,"text":"特技:コンピュータ関連"},{"spoiler":false,"text":"身長：:159cm、スリーサイズ：B88/W58/H87"},{"spoiler":false,"text":"趣味:投稿・掃除"},{"spoiler":false,"text":"ひっそりとスイスの片田舎で暮らしていたアメリア。"},{"spoiler":false,"text":"ある日、九郎の手によって日本へとやって来ることに。"},{"spoiler":false,"text":"現在は九郎の部屋に一緒に住み、学校へも通っている。"},{"spoiler":false,"text":"『……自分でもちょっとへんかな？　とか思ってたんです……』"}],"source":"egs","sourceCharacterId":"22665","sourceWorkId":"7302","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/747b01ee0d092e6545ca2c00bef620c46d9d6c59a2f4dea283426e30ff3def5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c131c2395b36d7c81be9035e05aa9d44ea98f625eb34305b7aae1f2495936024.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口 宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9301","source":"vndb"}]},{"characterId":"char_vndb_c12982","characterName":"大野 明人","sourceIds":{"vndbCharacterId":"c12982"},"originalCharacterName":"大野 明人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akito is a very earnest highschooler and a gun otaku. He dropped out of school a year ago and at the beginning of the story he is camping on a small island off Okinawa, where he went in the forlorn hope that the American military presence would give him a chance to play with real guns. He's constantly searching for adventure, and he found it when he spotted a B2 outside a Californian air base. He's very straightforward, maybe to the point of being simple, but he has a habit of saying the right things in front of Shizuka."},{"spoiler":false,"text":"Edited from a combination of Haeleth's post and Choux's review."}],"source":"vndb","sourceCharacterId":"c12982"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f714c244c015fe509918fc7d44d5443cd5306ab404f855905052d6447737a09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charac