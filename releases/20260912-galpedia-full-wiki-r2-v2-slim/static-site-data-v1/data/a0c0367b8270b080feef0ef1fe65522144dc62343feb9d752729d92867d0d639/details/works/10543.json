Name":"磁油2","creatorId":"vndb:s5265","sourcePersonId":"vndb:s5265","canonicalEntityId":"vndb:s5265","name":"磁油2","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:12675","source":"vndb"},{"creditedName":"みゅらっち","creatorId":"vndb:s5573","sourcePersonId":"vndb:s5573","canonicalEntityId":"vndb:s5573","name":"みゅらっち","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:12677","source":"vndb"}]},"cast":[{"characterId":"char_c58750","characterName":"マスクド上海","sourceIds":{"bangumi":[{"characterId":"57582","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18626"],"vndbCharacterId":"c58750"},"originalCharacterName":"マスクド上海","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元帝国陸軍・特殊工作員で、現在はマスクドシャンハイである主人公。"},{"spoiler":false,"text":"普段は上海租界の日本人居住区で探偵を営んでいる。"},{"spoiler":false,"text":"ポジティブで諦めが悪く、どんなに苦しい状況においても抜けだすための手段を模索し続けるタイプ。"},{"spoiler":false,"text":"軍人をやっていた時に、ひょんなことから悪仙人たちを解放してしまったため、宝貝改造仙人に改造された上、悪仙人の再封印する使命を背負わされる。"}],"source":"egs","sourceCharacterId":"18626","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"【主人公】"},{"spoiler":false,"text":"マスクド上海。"},{"spoiler":false,"text":"普段は上海租界の日本人居住区で探偵を営む。"},{"spoiler":false,"text":"元帝国陸軍の特務工作員。作戦行動中に悪仙人たちを解放してしまったため、宝貝改造仙人に改造されたうえに、上海に逃れた悪仙人たちを再封印する使命を、ほぼ強制的に背負わされた。現在は上海の共同租界で、私立探偵をしながら、街に潜む悪仙人を探して日々を過ごしている。"},{"spoiler":false,"text":"ポジティブで、かつ諦めが悪い。どんな苦しい状況に陥っても、絶対に抜け出す手段があるはずだと信じ、最善手を探し続ける。"},{"spoiler":false,"text":"ピンチが近づくと水虫が猛烈に痒くなる、という超能力の持ち主。"},{"spoiler":false,"text":"ネコっぽい生物は、崑崙から来た神獣「開明獣」である。"}],"source":"bangumi","sourceCharacterId":"57582"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfbc0d4b00ddf606c70cc41b03bd7270b30ae261c56c5ffdfab2ab8b9fd62759.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/432fd568d43e268470dad7fc1fc10a7e284df7f2ae06ae832bd04af1a5e9c91e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎淳","creatorId":"vndb:s32","sourcePersonId":"vndb:s32","canonicalEntityId":"vndb:s32","name":"尾崎 淳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15863:57582:6382:1","source":"bangumi"}]},{"characterId":"char_c58751","characterName":"アイリーン・ワトソン","sourceIds":{"bangumi":[{"characterId":"57583","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18628"],"vndbCharacterId":"c58751"},"originalCharacterName":"アイリーン・ワトソン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"上海で活動する英国人ジャーナリスト。"},{"spoiler":false,"text":"誘惑に弱い、こらえ性が全くない、壊滅的な家事の腕を持つと、そこら辺、社会人の女性としてどうなのだろう？"},{"spoiler":false,"text":"取材中怪人に襲われ、あわやというところをマスクドシャンハイに助けられる。"},{"spoiler":false,"text":"以後、ラブラブ光線全開でマスクドシャンハイを専門に追いかけることに。"}],"source":"egs","sourceCharacterId":"18628","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"上海の小さな新聞社と契約している英国人ジャーナリスト。"},{"spoiler":false,"text":"取材中に怪人に襲われ、あわやというところをマスクド上海に助けられてフォーリンラブ。以後、マスクド上海を専門に追いかける。"},{"spoiler":false,"text":"家事全般は全く駄目で、社会生活が送れるのか心配になるほど「そーいうのは、メイドにやらせるから良いの！」が口癖。"},{"spoiler":false,"text":"誘惑に弱く、こらえ性が全くない。"}],"source":"bangumi","sourceCharacterId":"57583"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd4f8ef3a5ae1c0b0774b303d5b7bcb6912cfd899f40e1f181c1fb4aebff9eb0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe14d3ea691d4bdbcebc8ba9b9f6a05b338aae630631701a7f28fa835c01ee56.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15863:57583:5741:1","source":"bangumi"}]},{"characterId":"char_c58752","characterName":"ヘレーネ・コシュバ","sourceIds":{"bangumi":[],"egsCharacterIds":["18629"],"vndbCharacterId":"c58752"},"originalCharacterName":"ヘレーネ・コシュバ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヨーロッパから逃げてきたユダヤ人の浮浪者。"},{"spoiler":false,"text":"上海に一緒に逃げてきた両親と死別して以来、たった一人で生きてきた様子。"},{"spoiler":false,"text":"ひょんなことから、俊作の変身シーンを目撃し、それをネタに、彼の事務所に転がりこむ。"}],"source":"egs","sourceCharacterId":"18629","sourceWorkId":"10543","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abb954c0661e8a465b7cd583a5f50d074f244435788224a24f9bbff00b0af95f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1ddf7f53e195166b49d6cdfeba13ccb92b85d55214912aac1646aee9c8467fc4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜川 未央","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:6001","source":"vndb"}]},{"characterId":"char_c58753","characterName":"藤谷 日和子","sourceIds":{"bangumi":[{"characterId":"57581","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18630"],"vndbCharacterId":"c58753"},"originalCharacterName":"藤谷 日和子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"左文字と同郷の女医で、彼を「お兄ちゃん」と慕う。"},{"spoiler":false,"text":"正義感が強く、困った人を見過ごせないタイプ。"},{"spoiler":false,"text":"そのため、相手に裏切られたり、危ない状況に陥ったりすることもしばしばだが、本人は、そんな状況にあったことさえ気付いていないとか。"}],"source":"egs","sourceCharacterId":"18630","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"左文字と同じ「富士穴町」出身の女医。正義感が強く、困った人を見捨てることができない。"},{"spoiler":false,"text":"こちらが善意を持って接すれば、相手もそれに応えてくれると堅く信じている。"},{"spoiler":false,"text":"もちろん裏切られることや、危険な目に遭うこともしばしばだが、本人は自分が危険な状況にあったことさえ気がついていない節も。"}],"source":"bangumi","sourceCharacterId":"57581"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f18e84be9242883c37d83003b6710494b56618263339152b82ae37de42469b63.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fc4e96518a4af3d7cd78561e3f2b5e5b401f69177d1f1b46ff4729ed20bd52e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"愛原 瑞生","creatorId":"vndb:s2982","sourcePersonId":"vndb:s2982","canonicalEntityId":"vndb:s2982","name":"愛原 瑞生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:6005","source":"vndb"}]},{"characterId":"char_c58754","characterName":"鄭 蘋茹","sourceIds":{"bangumi":[{"characterId":"57585","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18631"],"vndbCharacterId":"c58754"},"originalCharacterName":"鄭 蘋茹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"中国人の父と日本人の母を持つハーフ系美少女。"},{"spoiler":false,"text":"女学生であったが、日本人の血が流れていることが理由で陰湿ないじめを受け、退学。"},{"spoiler":false,"text":"現在は日華友好のためのボランティアをしている。"},{"spoiler":false,"text":"とあるきっかけで、左文字たちと行動を共にするようになるが……。"}],"source":"egs","sourceCharacterId":"18631","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"上海高等法院主席検察官、鄭鉞を父親に、日本人の母親を持つ、日華混血の美少女。"},{"spoiler":false,"text":"少し前まで女学生だったが、日本人の血が半分入っているという理由で陰湿ないじめを受け、退学している。現在は日華関係が少しでも良くなるようにとボランティア活動中。"},{"spoiler":false,"text":"あるきっかけで左文字に出会ってからは、行動をともにすることが多くなる。"}],"source":"bangumi","sourceCharacterId":"57585"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/898882ffa223a4d27fec8081b7188d7f6376d258987b5e0c97636def97d147fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/227cc04bfb50dfb25f2135f4f85b78d1811945338d351d50ad4a82075bf2ce7f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天水るみ","creatorId":"vndb:s2561","sourcePersonId":"vndb:s2561","canonicalEntityId":"vndb:s2561","name":"天水 るみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15863:57585:28735:1","source":"bangumi"}]},{"characterId":"char_c59780","characterName":"川島 芳子","sourceIds":{"bangumi":[{"characterId":"57587","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18633"],"vndbCharacterId":"c59780"},"originalCharacterName":"川島 芳子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"蒙古安国軍を指揮する、男装の麗人。"},{"spoiler":false,"text":"清王朝の王族で、市井の中国人は全て保護の対象と考えており、可能な限り彼らを守ろうとするが、外人はすべからずスルー。"},{"spoiler":false,"text":"「民を生かすも殺すも自分次第」的な考えで、良くも悪くも貴族なお人。"}],"source":"egs","sourceCharacterId":"18633","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"「満州のジャンヌ・ダルク」とも呼ばれる男装の麗人。蒙古安国軍司令官。清王朝の王族で、現在も王朝再建のため活動する。市井の中国人は保護の対象と考えており、彼らの生命や財産は可能な限り守ろうとする。外人はスルー。"},{"spoiler":false,"text":"「ボクの民になにをする！」「彼らを傷つけて良いのは、このボクだけだ！」とか。良くも悪くも貴族的。"}],"source":"bangumi","sourceCharacterId":"57587"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35e754b64044e27639b8acfaca48aedc845fe57ba7ff62b4f8b750d90e77ba71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab44cd5639b5ade543b3660849eac1cd48a5f321cf06a7a9de6cf2e21efe47fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋奈津江","creatorId":"vndb:s38","sourcePersonId":"vndb:s38","canonicalEntityId":"vndb:s38","name":"高橋 奈津江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15863:57587:15993:1","source":"bangumi"}]},{"characterId":"char_c59781","characterName":"尚 旭東","sourceIds":{"bangumi":[{"characterId":"57586","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18632"],"vndbCharacterId":"c59781"},"originalCharacterName":"尚 旭東","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"満州で有名な馬賊「千山無量観」の大頭目。"},{"spoiler":false,"text":"「千山無量観」は、老師の元で武芸を磨き、官憲では対処できない悪漢を退治する集団である。"},{"spoiler":false,"text":"悪仙人の封印が解かれたと聞き、再封印するため上海へとやってきた。"}],"source":"egs","sourceCharacterId":"18632","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"満州では知らない者のない馬賊の大頭目。"},{"spoiler":false,"text":"千山無量観は葛月老師のもとで武当派拳法との修行をしながら、官憲では対処できない悪漢を退治する日々を送っていたが、左文字が悪仙人の封印を解いたと聞き、彼らを再封印するため上海へとやってくる。"},{"spoiler":false,"text":"千山無量観に伝わる破魔の銃「小白龍」を持つ。"}],"source":"bangumi","sourceCharacterId":"57586"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49914b3a473c3fa10a561dd4abfc2c15a0d562a32f8c850893dd7335d0a9e813.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20ec72f8913fe5820ceb20e7cf1ca606b33673f79275b9b899a769e4df2cb534.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59782","characterName":"饕餮","sourceIds":{"bangumi":[{"characterId":"57589","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18635"],"vndbCharacterId":"c59782"},"originalCharacterName":"饕餮","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪仙人・四凶のひとりで、リーダー的存在。"},{"spoiler":false,"text":"自らの理想に忠実なタイプで、ひとつの正義を貫くために、100万人の人間を犠牲にできる女。"},{"spoiler":false,"text":"劣化した人種が蠢いている世界に我慢ならず、とある儀式によって、地上の人間を一掃し、世界を仙人たちの手に取り戻そうと画策している。"}],"source":"egs","sourceCharacterId":"18635","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"四凶のひとり。4人のリーダー的な存在。"},{"spoiler":false,"text":"長い封印から解放された彼女にとって、劣化した人種が蠢いている世界は非常におぞましいものであった。ゆえに《封禅》と呼ばれる儀式をによって、現在この地上を支配している劣化人種を一掃し、世界を仙人たちの手に取り戻そうと画策する。"},{"spoiler":false,"text":"理想を求めて止まないタイプ。1の正義を実現するために、容赦なく100万の人間を犠牲にすることができる女。"}],"source":"bangumi","sourceCharacterId":"57589"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be203b5fb8eb8382a3b4e40e11d5042099c489ac863113d6cd7a4054761c3428.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52a3221594faef708501ed6db1a33498dc0d8983ca9e9268f4d4cb290f1facbf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15863:57589:5741:1","source":"bangumi"}]},{"characterId":"char_c59783","characterName":"渾沌","sourceIds":{"bangumi":[{"characterId":"57588","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18634"],"vndbCharacterId":"c59783"},"originalCharacterName":"渾沌","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪仙人・四凶のひとり。"},{"spoiler":false,"text":"子供っぽい外見とは裏はらに、天地開闢のころから存在し、人々に混乱のタネをまいてきた。"},{"spoiler":false,"text":"他三人と違い、単純に世の中が混乱しているのを見たいだけ。"},{"spoiler":false,"text":"絶望的な状況で、人間があがいているのを見て楽しむのが好き。"}],"source":"egs","sourceCharacterId":"18634","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"四凶のひとり。封印されていた他の三人（窮奇、饕餮、檮テツ）を解放しようと、いろいろ外で動き回っていた。子供っぽい外見とは裏腹に、天地開闢のころから存在し、人類に混乱のタネを捲き続けてきた。"},{"spoiler":false,"text":"他の三人と違って、単純に世の中が乱れるのが見たいだけ。絶望的な状況に陥った人々があがくのを見て楽しむ。"}],"source":"bangumi","sourceCharacterId":"57588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b22905882783dd83c349ca62e60a9f5cc67bbb983302c50eca23a8a13b2f5cb8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/415c2706d34d59b1f84900ce46886868997a672c1d910dd2acc61eb832d1e906.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天水るみ","creatorId":"vndb:s2561","sourcePersonId":"vndb:s2561","canonicalEntityId":"vndb:s2561","name":"天水 るみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15863:57588:28735:1","source":"bangumi"}]},{"characterId":"char_c59784","characterName":"檮コツ","sourceIds":{"bangumi":[{"characterId":"57591","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18637"],"vndbCharacterId":"c59784"},"originalCharacterName":"檮コツ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪仙人・四凶のひとりで、戦いを求める寡黙な戦士。"},{"spoiler":false,"text":"「弱者に生きる価値なし」と考え、力なき者は歯牙にもかけず、まるでそこに蟻がいるかのように、ただ踏み潰していくだけ。"},{"spoiler":false,"text":"逆に戦士として認めた者には、過剰なまでの礼を尽くす。"}],"source":"egs","sourceCharacterId":"18637","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"四凶のひとり。特に思想などはなく、ただ戦いだけを求める。寡黙な戦士タイプ。"},{"spoiler":false,"text":"戦士としては超一流。自分の実力を正しく把握しており、それゆえ他人には傲慢に映ることも多々ある。力なき者は歯牙にもかけない。まるで路上の蟻のように、ただ踏みつぶしていくのみであり、弱者には生きる価値が無く、ただ強者に侍ることによってのみ、かろうじて生存を許されているのだと考えてる。逆に自分が戦士であると認めた者に対しては、過剰なまでの礼を尽くす。"},{"spoiler":false,"text":"※コツは木偏に兀「木兀」"}],"source":"bangumi","sourceCharacterId":"57591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3f118224d659b84765592c46fd4925873b03316abc74def334a117a5a2c9c6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55f5bc0df77e41c3fe1ef5cfe823ab3c4a300afcd3d49b41b8d46f1d4365a7f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"愛原 瑞生","creatorId":"vndb:s2982","sourcePersonId":"vndb:s2982","canonicalEntityId":"vndb:s2982","name":"愛原 瑞生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:6006","source":"vndb"}]},{"characterId":"char_c59785","characterName":"窮奇","sourceIds":{"bangumi":[{"characterId":"57590","match":"exact-normalized-name-in-linked-work","subjectId":"15863"}],"egsCharacterIds":["18636"],"vndbCharacterId":"c59785"},"originalCharacterName":"窮奇","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪仙人・四凶のひとりで、残忍かつ狡猾な女。"},{"spoiler":false,"text":"人を苦しめることが彼女の快感であり、特に女性の泣き叫ぶ姿が大好物。"},{"spoiler":false,"text":"彼女にとって、現在の人間は「退化したおもちゃ」に過ぎず、饕餮と一緒にいるのも、より多くの「おもちゃ」が手に入りそうだから、という理由のみ。"}],"source":"egs","sourceCharacterId":"18636","sourceWorkId":"10543","spoiler":false},{"segments":[{"spoiler":false,"text":"四凶のひとり。性格は残忍かつ狡猾で、血を見るのを好む。人を苦しめることで快楽を得るタイプ。"},{"spoiler":false,"text":"彼女にとって、現在の人類は退化したおもちゃに過ぎない。特に女が苦痛に泣き叫ぶことによろこびを覚える。"},{"spoiler":false,"text":"饕餮に行動をともにしているのは、彼と一緒にいれば、より多数の「おもちゃ」を手に入れることが出来るから。あまり彼の理念とかを理解しているわけではない。"}],"source":"bangumi","sourceCharacterId":"57590"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/148a6b1798f5d7135f2e130f0e45bcddd1ef5f5c22473b01ef564ebfa987b3c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0f38a4bba29c92d7852c6bcbccc85bfe5476015e16f4f68dc40868f2b8c84b7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"栗原雅子","creatorId":"vndb:s298","sourcePersonId":"vndb:s298","canonicalEntityId":"vndb:s298","name":"野月 まひる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15863:57590:6570:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:307","sourceCompanyId":"egs:brand:307","canonicalEntityId":"egs:brand:307","name":"Liar-soft(ビジネスパートナー)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:10543:307","source":"egs"},{"companyId":"vndb:p3045","sourceCompanyId":"vndb:p3045","canonicalEntityId