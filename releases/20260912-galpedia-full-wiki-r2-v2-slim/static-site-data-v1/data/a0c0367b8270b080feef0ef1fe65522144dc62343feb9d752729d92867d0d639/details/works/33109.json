491513"}],"egsCharacterIds":["17159"],"vndbCharacterId":"c5090"},"originalCharacterName":"瀬名 愛理","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1024"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Airi is a second-year student of Yuihime Girls' Academy and the principal's daughter. She always gets the best grades among all second-year students. At first, she was against the plan for merging of the schools, and rejected male students from Kagamidai Academy, but she began getting along with them several weeks later. She was elected the class representative along with Shingo. She was born and brought up in an upper class family in the Old District, but she has lived by herself in a low-priced apartment in the New District since she started attending Yuihime Girls' Academy. She lives in a simple life and often goes shopping to a local supermarket in the New District named Kume Mart to buy reasonable-priced food and daily necessities."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c5090"},{"segments":[{"spoiler":false,"text":"頭脳明晰、容姿端麗な学園理事長の娘。"},{"spoiler":false,"text":"凛とした立ち居振る舞いから周囲の人気を集めているが、その素顔は無類の意地っ張り＆見栄っ張りで感情に流されやすく、主人公に対して時にキツイ態度を取ることも。"}],"source":"egs","sourceCharacterId":"17159"},{"segments":[{"spoiler":false,"text":"頭脳明晰、容姿端麗な学園理事長の娘。"},{"spoiler":false,"text":"凛とした立ち居振る舞いから周囲の人気を集めているが、その素顔は無類の意地っ張り＆見栄っ張りで感情に流されやすく、主人公に対して時にキツイ態度を取ることも。"},{"spoiler":false,"text":"「あたしのことならほっといて。あんたと馴れ合いたくないの」"}],"source":"egs","sourceCharacterId":"17159","sourceWorkId":"11463","spoiler":false},{"segments":[{"spoiler":false,"text":"私立结姬女子学园的二年级生，也是学园长的独生女。"},{"spoiler":false,"text":"合并试行期间新吾的同班同学。"},{"spoiler":false,"text":"与新吾两人一起负责二年T班的班级代表。"},{"spoiler":false,"text":"学业成绩第一，有领导才能，责任感很强，头脑不灵活。"},{"spoiler":false,"text":"开始时她不欢迎新吾等男学生们，可是其后渐渐地与他们亲密起来了。"},{"spoiler":false,"text":"凛然的言行举止从周围吸引了很高人气，本性是十分爱逞强、爱面子，容易感情用事，对待主人公时总是采取严厉态度。"},{"spoiler":false,"text":"「请不要管我。我可不想和你亲近」"}],"source":"bangumi","sourceCharacterId":"11809"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80a765da49eaf056d5888acd494222f5484b05236f44222c9bb1a399a738f868.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3769a58f7d1f44399b6a987ccf88aef666a9d267aeb16bf7fb82afe0c7c48e5.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:417463:11809:4727:1","source":"bangumi"}]},{"characterId":"char_c5092","characterName":"瓜生 桜乃","sourceIds":{"bangumi":[{"characterId":"10712","match":"exact-normalized-name-in-linked-work","subjectId":"13218"},{"characterId":"10712","match":"exact-normalized-name-in-linked-work","subjectId":"3306"},{"characterId":"10712","match":"exact-normalized-name-in-linked-work","subjectId":"491513"}],"egsCharacterIds":["17160"],"vndbCharacterId":"c5092"},"originalCharacterName":"瓜生 桜乃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"123"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sakuno is Shingo's younger stepsister and first-year student of Kagamidai Academy; her father married Shingo's mother about ten years ago. She has a quiet personality and is good at cooking, but has a poor sense of direction and often gets lost. She was selected as a test student with her brother, and transferred to Yuihime Girls' Academy to participate in 1-T, the first-year test class. She happened to meet Airi at night on September 30, the day before the transferring on October 1. She became close friends with Airi at that time. She often goes shopping to Kume Mart, too. She is youngest but tallest among the main female characters."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c5092"},{"segments":[{"spoiler":false,"text":"主人公に恋心を抱く義妹。"},{"spoiler":false,"text":"家族を大切にしているため、一歩踏みだせないでいる。"},{"spoiler":false,"text":"料理が得意で、家では炊事全般を担当。"},{"spoiler":false,"text":"女の子としては高めの身長に、若干コンプレックスを感じている。"},{"spoiler":false,"text":"「うーんと……あーん、する？」"}],"source":"egs","sourceCharacterId":"17160"},{"segments":[{"spoiler":false,"text":"主人公に恋心を抱く義妹。"},{"spoiler":false,"text":"家族を大切にしているため、一歩踏みだせないでいる。"},{"spoiler":false,"text":"料理が得意で、家では炊事全般を担当。"},{"spoiler":false,"text":"女の子としては高めの身長に、若干コンプレックスを感じている。"},{"spoiler":false,"text":"「うーんと……あーん、する？」"}],"source":"egs","sourceCharacterId":"17160","sourceWorkId":"11463","spoiler":false},{"segments":[{"spoiler":false,"text":"新吾的义妹，各台武学园一年级生。因为约十年前新吾的母亲于樱乃的父亲再婚，所以两人成为了义兄妹。"},{"spoiler":false,"text":"于新吾一样转学到结女学园而进入一年T班。"},{"spoiler":false,"text":"头脑聪明而性格文静，喜欢读书。"},{"spoiler":false,"text":"爱理和樱乃是从初次见面时就非常亲密的朋友。"},{"spoiler":false,"text":"对主人公怀有爱慕之心。"},{"spoiler":false,"text":"由于把家人看得十分重要而没有采取进一步的行动。"},{"spoiler":false,"text":"擅长料理，在家全权担当炊事。"},{"spoiler":false,"text":"作为女孩子稍稍突出的身高让她感到些许自卑。"},{"spoiler":false,"text":"只要是哥哥的亲手料理便都喜欢。"},{"spoiler":false,"text":"「嗯……啊、张嘴？」"}],"source":"bangumi","sourceCharacterId":"10712"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f513a4d79fce872c1fe64fd7f221562031c8c03d8df60fe9453859fd8642666.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/318fb63f4dca4dfe7274212854838d392420d06d96a090cf3c573554659ac465.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:417463:10712:4809:1","source":"bangumi"}]},{"characterId":"char_c5094","characterName":"アンジェ","sourceIds":{"bangumi":[{"characterId":"11810","match":"exact-normalized-name-in-linked-work","subjectId":"13218"},{"characterId":"11810","match":"exact-normalized-name-in-linked-work","subjectId":"3306"},{"characterId":"11810","match":"exact-normalized-name-in-linked-work","subjectId":"491513"}],"egsCharacterIds":["17161"],"vndbCharacterId":"c5094"},"originalCharacterName":"アンジェ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"808"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Angelina, nicknamed Ange, is a second-year student of Yuihime Girls' Academy. Unlike other female students, she does not wear school uniform, but always wears a maid costume. She is a \"stray maid\" and hopes to meet her future master someday. She is in Shingo's class and tries to help the students from Kagamidai Academy assimilate. Her father is Japanese and her mother is British, but she speaks only Japanese because she was born and brought up in Japan. She has a cheerful personality and is very good at housekeeping tasks such as cooking and cleaning, but is weak at general educational subjects such as English and mathematics. Her favorite food is tokoroten."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c5094"},{"segments":[{"spoiler":false,"text":"仕えるべき主人を探している\"野良メイド\"。"},{"spoiler":false,"text":"主人公が通う学園の生徒でありながらメイドとして様々な雑務を引き受けている。"},{"spoiler":false,"text":"非常に明るく前向きな性格だが、少々遠慮知らずで強引なところがタマにキズ。"},{"spoiler":false,"text":"「お茶を淹れましたー！ 飲みますよね？ ねっ!?」"}],"source":"egs","sourceCharacterId":"17161"},{"segments":[{"spoiler":false,"text":"仕えるべき主人を探している\"野良メイド\"。"},{"spoiler":false,"text":"主人公が通う学園の生徒でありながらメイドとして様々な雑務を引き受けている。"},{"spoiler":false,"text":"非常に明るく前向きな性格だが、少々遠慮知らずで強引なところがタマにキズ。"},{"spoiler":false,"text":"「お茶を淹れましたー！ 飲みますよね？ ねっ!?」"}],"source":"egs","sourceCharacterId":"17161","sourceWorkId":"11463","spoiler":false},{"segments":[{"spoiler":false,"text":"结女学园二年级生，昵称为安洁（アンジェ）。"},{"spoiler":false,"text":"新吾于爱理的同班同学也是住在学园里的女仆。"},{"spoiler":false,"text":"于普通学生们不同，她不穿校服，经常穿着女仆装。"},{"spoiler":false,"text":"混血儿，父亲是日本人，母亲是英国人，但是完全不会说英语。"},{"spoiler":false,"text":"个性开朗活泼，擅长烹饪、打扫等家务，但是学业成绩很不好。"},{"spoiler":false,"text":"喜欢的食物是心太。"}],"source":"bangumi","sourceCharacterId":"11810"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfdf280f49cd51a0765ad9b5b276716265926b3eadc21399864fd924160925fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57ab215e8e76bc7b1b0b1cc71c5382b5716e896ed71a735495f6a4ca9c826b32.webp","width":195,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:417463:11810:4830:1","source":"bangumi"}]},{"characterId":"char_c5096","characterName":"天羽 みう","sourceIds":{"bangumi":[{"characterId":"11811","match":"exact-normalized-name-in-linked-work","subjectId":"13218"},{"characterId":"11811","match":"exact-normalized-name-in-linked-work","subjectId":"3306"},{"characterId":"11811","match":"exact-normalized-name-in-linked-work","subjectId":"491513"}],"egsCharacterIds":["17162"],"vndbCharacterId":"c5096"},"originalCharacterName":"天羽 みう","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"222"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miu is a third-year student of Yuihime Girls' Academy. She lives in a house nearby the school with her mother and two cats. She is the founder and president of the Nuko-bu, a school club whose purpose is to care for injured wild animals and then return them to the wild. She works part-time at a maid café named Dolce to earn money for club activities; as the Nuko Club is not an official club, the club's budget is not supplied by the school. She is very kind to Shingo and becomes fond of him. She is eldest but shortest among the main characters."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c5096"},{"segments":[{"spoiler":false,"text":"誰に対しても分け隔てなく柔和な笑みで接する、ひとつ年上の先輩。"},{"spoiler":false,"text":"幼い容姿とは裏腹に、母性豊かで面倒見がいい。"},{"spoiler":false,"text":"動物が大好きで、常にねこに似た不思議な生き物――通称\"ぱんにゃ\"をアタマに乗せている。"},{"spoiler":false,"text":"「うん、いい子いい子」"}],"source":"egs","sourceCharacterId":"17162"},{"segments":[{"spoiler":false,"text":"誰に対しても分け隔てなく柔和な笑みで接する、ひとつ年上の先輩。"},{"spoiler":false,"text":"幼い容姿とは裏腹に、母性豊かで面倒見がいい。"},{"spoiler":false,"text":"動物が大好きで、常にねこに似た不思議な生き物――通称\"ぱんにゃ\"をアタマに乗せている。"},{"spoiler":false,"text":"「うん、いい子いい子」"}],"source":"egs","sourceCharacterId":"17162","sourceWorkId":"11463","spoiler":false},{"segments":[{"spoiler":false,"text":"结女学园三年级生，新吾等的学姐，可是个子很矮。"},{"spoiler":false,"text":"在结女学园附近的房子和母亲两人一起生活着。"},{"spoiler":false,"text":"个性温柔和善，爱好自然与动物，有天然呆倾向。"},{"spoiler":false,"text":"保护野生动物的课外活动小组「喵喵社」的社长。"}],"source":"bangumi","sourceCharacterId":"11811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c126ec335a12c077e0fd13e0d8e90b26be071989ff7881aa88fca3a3b561bc3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a669cd2a7189ad922ed3549291ac9aade83624feef3b6e2713e9dc90dde6bfd.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:417463:11811:4689:1","source":"bangumi"}]},{"characterId":"char_c5103","characterName":"乾 紗凪","sourceIds":{"bangumi":[{"characterId":"11812","match":"exact-normalized-name-in-linked-work","subjectId":"13218"},{"characterId":"11812","match":"exact-normalized-name-in-linked-work","subjectId":"3306"},{"characterId":"11812","match":"exact-normalized-name-in-linked-work","subjectId":"491513"}],"egsCharacterIds":["17163"],"vndbCharacterId":"c5103"},"originalCharacterName":"乾 紗凪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sana is a second-year student of Yuihime Girls' Academy and Airi's childhood friend. She makes an effort to welcome the male students from Kagamidai Academy, but later backtracks. Sana adores Miu and joined the Nuko Club because of her. She dislikes Shingo and often calls him \"kuzu-mushi\" (lit. trash worm). This is exacerbated when she notes the growing closeness between Shingo and Miu."},{"spoiler":false,"text":"While she's a side character in the PC version, she became a heroine in the PSP port after taking first place in a character popularity poll for the game."},{"spoiler":false,"text":"Later on the standalone game of Inui Sana's route was released in the FHD remake on PC."},{"spoiler":false,"text":"In addition, newly written scenes, new CGs, as well H scenes are also added."}],"source":"vndb","sourceCharacterId":"c5103"},{"segments":[{"spoiler":false,"text":"結姫女子学園の生徒で、学園の仮統合により主人公のクラスメートとなる。"},{"spoiler":false,"text":"誰にでも優しく接し、元気で気立てのいい女の子。"},{"spoiler":false,"text":"ひとつ学年が上の天羽みうに憧れを抱き、自分もみう先輩のような女の子になりたいと夢見ている。"},{"spoiler":false,"text":"「各務台のみんなは、わからないことばかりで大変よね～」"}],"source":"egs","sourceCharacterId":"17163"},{"segments":[{"spoiler":false,"text":"結姫女子学園の生徒で、学園の仮統合により主人公のクラスメートとなる。"},{"spoiler":false,"text":"誰にでも優しく接し、元気で気立てのいい女の子。"},{"spoiler":false,"text":"ひとつ学年が上の天羽みうに憧れを抱き、自分もみう先輩のような女の子になりたいと夢見ている。"},{"spoiler":false,"text":"「各務台のみんなは、わからないことばかりで大変よね～」"}],"source":"egs","sourceCharacterId":"17163","sourceWorkId":"11463","spoiler":false},{"segments":[{"spoiler":false,"text":"结女学园二年级生，二年T班成员，爱理的老朋友。"},{"spoiler":false,"text":"对美羽非常憧憬，与她一样属于喵喵社。"},{"spoiler":false,"text":"开始是接待男学生们的态度很好，但实际上那是做戏。"},{"spoiler":false,"text":"本性很粗暴，最讨厌男人，特别敌视新吾。"}],"source":"bangumi","sourceCharacterId":"11812"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7761745129ba065cc4bdf196086a246526ca2f652da2371adb5df8b336ca4ed0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca12a0d177205fe0aa04d4182060eaaf49f98dc1e40c53686a1e440180dccb0a.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田真弓","creatorId":"vndb:s944","sourcePersonId":"vndb:s944","canonicalEntityId":"vndb:s944","name":"吉田 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:417463:11812:5926:1","source":"bangumi"}]},{"characterId":"char_vndb_c132285","characterName":"母ぱんにゃ","sourceIds":{"vndbCharacterId":"c132285"},"originalCharacterName":"母ぱんにゃ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Pannya's mother."}],"source":"vndb","sourceCharacterId":"c132285"}],"profileFacts":[],"metadata