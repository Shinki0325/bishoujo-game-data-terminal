aracterId":"c165093"},{"segments":[{"spoiler":false,"text":"幼さの残る体型と容貌が特徴的だがれっきとした３年生。"},{"spoiler":false,"text":"大人しい性格ながらも融通は利かず、学園内に潜む風紀の乱れを探しては些細な内容でも口先をツンと尖らせて、上目遣いでしっかりと指摘する。"},{"spoiler":false,"text":"主人公の悪行の一部を目にしたことで、風紀委員としてこれ以上の被害を拡大させないように、コソコソと主人公を監視してなんとか追い出せないかと画策している。"}],"source":"egs","sourceCharacterId":"28395","sourceWorkId":"40433","spoiler":false},{"segments":[{"spoiler":false,"text":"幼さの残る体型と容貌が特徴的だがれっきとした3年生。"},{"spoiler":false,"text":"大人しい性格ながらも融通は利かず、学園内に潜む風紀の乱れを探しては、"},{"spoiler":false,"text":"些細な内容でも口先をツンと尖らせて、上目遣いでしっかりと指摘する。"},{"spoiler":false,"text":"主人公の悪行の一部を目にしたことで、風紀委員としてこれ以上の被害を拡大させないように、"},{"spoiler":false,"text":"コソコソと主人公を監視してなんとか追い出せないかと画策している。"}],"source":"bangumi","sourceCharacterId":"210356"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"210356","value":"3年生"},{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"28395","sourceWorkId":"40433","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"28395","sourceWorkId":"40433","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"28395","sourceWorkId":"40433","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"28395","sourceWorkId":"40433","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"28395","sourceWorkId":"40433","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2275fece6ad967338200c3f38b76099f65e9065a0a591a88e6644d1ab6bcdd3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f41eea4910579899c16a95126880f6d1cfa8c3d871fe732a687089a3bb8caad.webp","width":213,"height":256,"source":"stat