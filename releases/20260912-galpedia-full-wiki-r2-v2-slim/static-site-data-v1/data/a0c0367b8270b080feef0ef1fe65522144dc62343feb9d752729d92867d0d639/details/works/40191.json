,"relationId":"vndb:vn-staff:106829","source":"vndb"},{"creditedName":"鈴木 薫","creatorId":"vndb:s12848","sourcePersonId":"vndb:s12848","canonicalEntityId":"vndb:s12848","name":"鈴木 薫","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:106830","source":"vndb"},{"creditedName":"吉田","creatorId":"vndb:s19190","sourcePersonId":"vndb:s19190","canonicalEntityId":"vndb:s19190","name":"吉田","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:106833","source":"vndb"},{"creditedName":"禁肉さん","creatorId":"vndb:s19191","sourcePersonId":"vndb:s19191","canonicalEntityId":"vndb:s19191","name":"禁肉さん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:106834","source":"vndb"}]},"cast":[{"characterId":"char_c18011","characterName":"野宮 菜々子","sourceIds":{"bangumi":[{"characterId":"25636","match":"exact-normalized-name-in-linked-work","subjectId":"107489"}],"egsCharacterIds":["3313"],"vndbCharacterId":"c18011"},"originalCharacterName":"野宮 菜々子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A neighbourhood girl the protagonist tutored when he himself was still a student."},{"spoiler":false,"text":"She developed a crush on him from back then, even now she and the protagonist keep in good touch."},{"spoiler":false,"text":"Because she's known the protagonist since childhood she has unwavering confidence that she'll never lose him to anyone."},{"spoiler":false,"text":"Other than the strong feelings she has she's an utterly ordinary girl."},{"spoiler":false,"text":"Even her Academic and Athletic grades are unremarkably average. Yet, the protagonist is interested to see how much she's matured since childhood into a \"woman\"."}],"source":"vndb","sourceCharacterId":"c18011"},{"segments":[{"spoiler":false,"text":"主人公が学生時代、隣近所だったよしみで家庭教師に付いていた少女。その縁で主人公を慕っており、今でも好意を丸出しにして接してくる。"},{"spoiler":false,"text":"子供の頃から一途に想い続けているため、主人公のことを好きな気持ちは誰にも負けない、という自負がある。"},{"spoiler":false,"text":"その強い想いを除けば、どこにいても珍しくない明るく気さくな普通の女の子。"},{"spoiler":false,"text":"学業もスポーツも平均的で、取り立てて目立つタイプでもないのだが、子供から『女』へと成長した身体に興味を持った主人公に目を付けられる。"}],"source":"egs","sourceCharacterId":"3313","sourceWorkId":"20165","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が学生時代、隣近所だったよしみで家庭教師についていた少女。"},{"spoiler":false,"text":"その縁で主人公を慕っており、今でも好意を丸出しにして接してくる。"},{"spoiler":false,"text":"子供の頃から一途に想い続けているため、主人公のことを好きな気持ちは誰にも負けない、という自負がある。"},{"spoiler":false,"text":"その強い想いを除けば、どこにいても珍しくない明るく気さくな普通の女の子。"},{"spoiler":false,"text":"学業もスポーツも平均的で、取り立てて目立つタイプでもないのだが、子供から “女” へと成長した身体に興味を持った主人公に目を付けられる。"}],"source":"bangumi","sourceCharacterId":"25636"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6db1d0fbe742fe6882d6915387c6e69ff5da126addced1140d2101218f299e79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94914c413fa33bcba08c5fe0ab748b6c77c6a6ef184cf8b514f3ca1b52e427dc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:107489:25636:8055:1","source":"bangumi"}]},{"characterId":"char_c18012","characterName":"楠木 和葉","sourceIds":{"bangumi":[{"characterId":"25637","match":"exact-normalized-name-in-linked-work","subjectId":"107489"}],"egsCharacterIds":["3314"],"vndbCharacterId":"c18012"},"originalCharacterName":"楠木 和葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the girls in the class the protagonist teaches. She's a well mannered princess, who exudes maturity."},{"spoiler":false,"text":"Born to the upper crust of society, her father is the president of a pharmaceutical company; aware of how happy and blessed her life is, she firmly believes in bringing happiness to others as well."},{"spoiler":false,"text":"Her favourite motto is, \"Do a good deed every day!\" which she practices."},{"spoiler":false,"text":"Her breasts have an odd trait of secreting milk in response to sexual pleasure, ontop of that she has the largest bust of the entire student body, because of this she a complex about them."}],"source":"vndb","sourceCharacterId":"c18012"},{"segments":[{"spoiler":false,"text":"主人公が担任をしているクラスに所属する、大人っぽく落ち着いた雰囲気を漂わせる品行方正なお嬢様。"},{"spoiler":false,"text":"大手製薬会社の社長を父に持つ上流階級の生まれで、自分が恵まれている幸福な人間であることを自覚していることから、他人を幸せにしたい、という信念を持っている。"},{"spoiler":false,"text":"好きな言葉は『一日一善』であり、それを日頃から実践している。"},{"spoiler":false,"text":"乳房への性的快感に反応して母乳を噴いてしまう特異体質の持ち主で、その学生離れしたサイズも含め、自分の乳房にコンプレックスを持っている。"}],"source":"egs","sourceCharacterId":"3314","sourceWorkId":"20165","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が担任をしているクラスに所属する、大人っぽく落ち着いた雰囲気を漂わせる品行方正なお嬢様。"},{"spoiler":false,"text":"大手製薬会社の社長を父に持つ上流階級の生まれで、自分が恵まれている幸福な人間であることを自覚していることから、他人を幸せにしたい、という信念を持っている。"},{"spoiler":false,"text":"好きな言葉は “一日一善” であり、それを日頃から実践している。"},{"spoiler":false,"text":"乳房への性的快感に反応して母乳を噴いてしまう特異体質の持ち主で、その学生離れしたサイズも含め、自分の乳房にコンプレックスを持っている。"}],"source":"bangumi","sourceCharacterId":"25637"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/132ffe2cab708697eff9deabc3962e9f8e09236b1824ecfbe4a52c90803fe850.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bea5f0283ade17e3909b7f55335e802dfc909907546087bd033ba75dd47e802f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"花南","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:107489:25637:5928:1","source":"bangumi"}]},{"characterId":"char_c18013","characterName":"鳴川 まひる","sourceIds":{"bangumi":[{"characterId":"25638","match":"exact-normalized-name-in-linked-work","subjectId":"107489"}],"egsCharacterIds":["3315"],"vndbCharacterId":"c18013"},"originalCharacterName":"鳴川 まひる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cheery, and always the heart of the group around her friends."},{"spoiler":false,"text":"Prides herself in her excellent scores in rhythmic gymnastics. She enrolled in Meiran Girls Academy as a sports scholarship student."},{"spoiler":false,"text":"Although virtuous, and trusted by her friends, she also has a short temper, and snaps at enemies without self regard."},{"spoiler":false,"text":"Tough on the outside but weak on the inside. She hates losing and turns into a big crybaby when she's beat."},{"spoiler":false,"text":"Persistent to the point she always gets her way."},{"spoiler":false,"text":"Trusts the protagonist as her physical educator. She always asks him, \"Would you be my club supervisor?\"."}],"source":"vndb","sourceCharacterId":"c18013"},{"segments":[{"spoiler":false,"text":"快活な性格で、いつも周りに友人が集まってくるムードメーカー。"},{"spoiler":false,"text":"優秀な成績を誇る新体操選手で、学園にはスポーツ特待生として入学した。"},{"spoiler":false,"text":"正義感が強く仲間からは頼りにされるものの、単純で頭に血が上りやすく、相手の力量にも構わずすぐに噛みついてしまう。"},{"spoiler":false,"text":"気が強いくせに打たれ弱く、すぐ涙を見せる反面、負けず嫌いで立ち直りが早く、泣き止めばすぐにまた反抗する。"},{"spoiler":false,"text":"良くも悪くも引きずらない性格。懲りないとも言う。"},{"spoiler":false,"text":"主人公のことは体育教師として頼りにしており、しょっちゅう「部活の顧問にならないか」と誘ってくる。"}],"source":"egs","sourceCharacterId":"3315","sourceWorkId":"20165","spoiler":false},{"segments":[{"spoiler":false,"text":"快活な性格で、いつも周りに友人が集まってくるムードメーカー。"},{"spoiler":false,"text":"優秀な成績を誇る新体操選手で、学園にはスポーツ特待生として入学した。"},{"spoiler":false,"text":"正義感が強く仲間からは頼りにされるものの、単純で頭に血が上りやすく、相手の力量にも構わずすぐに噛みついてしまう。"},{"spoiler":false,"text":"気が強いくせに打たれ弱く、すぐ涙を見せる反面、負けず嫌いで立ち直りが早く、泣き止めばすぐにまた反抗する。"},{"spoiler":false,"text":"良くも悪くも引きずらない性格。 懲りないとも言う。"},{"spoiler":false,"text":"主人公のことは体育教師として頼りにしており、しょっちゅう 「部活の顧問にならないか」 と誘ってくる。"}],"source":"bangumi","sourceCharacterId":"25638"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc843aefb9268cc97343c40b81564ee74733a9ef6ddfca1f55c69e77adac29c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45fe84df66400d45f7253665539d83e1ccf4af5919adfe5d3c161665665794fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:107489:25638:4799:1","source":"bangumi"}]},{"characterId":"char_c18014","characterName":"小南 結芽","sourceIds":{"bangumi":[{"characterId":"25639","match":"exact-normalized-name-in-linked-work","subjectId":"107489"}],"egsCharacterIds":["3316"],"vndbCharacterId":"c18014"},"originalCharacterName":"小南 結芽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A quiet, lonely girl who always has her head in her books."},{"spoiler":false,"text":"Because of her expressionless, and childish appearance people often think of her as doll-like."},{"spoiler":false,"text":"As a child she was abandoned by both of her parents and left an orphan. This caused her heart to grow cold. Such that she has no interest in anyone, not even herself."},{"spoiler":false,"text":"And so she's never had any friendships, when she needs to talk to someone it's usually short."},{"spoiler":false,"text":"As her usual past time is reading she is quite book smart. Her entrance exam results were top grade."},{"spoiler":false,"text":"And yet, she has no stamina due to lack of exercise. Though she's a member of the Badminton club she always skips it."}],"source":"vndb","sourceCharacterId":"c18014"},{"segments":[{"spoiler":false,"text":"物静かで、いつも本を読んでいる孤独な少女。"},{"spoiler":false,"text":"無表情で、見た目が子供のように幼いことから、人形のような印象を他人に与える。幼い頃に両親に捨てられて孤児となった経験をきっかけに、心が十分に育まれず、他人はおろか、自分自身にさえ興味を持てなくなってしまっている。"},{"spoiler":false,"text":"そのため、人と関わりを持たず、会話も淡々としており必要最低限のことしか喋らない。"},{"spoiler":false,"text":"普段は読書か勉強しかしていないので、学力は超が付くほど優秀で入試もトップの成績を収めている。"},{"spoiler":false,"text":"その反面、運動は大の苦手で体力もなく、所属しているバドミントン部はいつもサボっている。"}],"source":"egs","sourceCharacterId":"3316","sourceWorkId":"20165","spoiler":false},{"segments":[{"spoiler":false,"text":"物静かで、いつも本を読んでいる孤独な少女。"},{"spoiler":false,"text":"無表情で見た目が子供のように幼いことから、人形のような印象を他人に与える。"},{"spoiler":false,"text":"幼い頃に両親に捨てられて孤児となった経験から、心の成長が十分に育まれず、他人はおろか自分自身にさえ興味を持てなくなってしまっている。"},{"spoiler":false,"text":"そのため人と関わりを持たず、会話も淡々としており必要最低限のことしか喋らない。"},{"spoiler":false,"text":"普段は読書か勉強しかしていないので、学力は超が付くほど優秀。 入試もトップの成績を収めている。"},{"spoiler":false,"text":"その反面、運動は大の苦手で体力もなく、所属しているバドミントン部はいつもサボっている。"}],"source":"bangumi","sourceCharacterId":"25639"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bca8c3b594c643fb34c382ea6a72b628b8042bce92f9884edf68ecdd37a37b2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf4a1a1a8b957a4975457676694a68590c160c644db4c934a5b9d1bbd4eadda5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:107489:25639:15684:1","source":"bangumi"}]},{"characterId":"char_c18015","characterName":"有栖川 冴香","sourceIds":{"bangumi":[{"characterId":"25640","match":"exact-normalized-name-in-linked-work","subjectId":"107489"}],"egsCharacterIds":["3317"],"vndbCharacterId":"c18015"},"originalCharacterName":"有栖川 冴香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"926"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young headmaster who rules over Meiran Girls Academy."},{"spoiler":false,"text":"With a strong-will, and pride, she fits the snobby Ojou archetype to a tee."},{"spoiler":false,"text":"Everyone obeys her authority, yet she obeys someone else."},{"spoiler":false,"text":"It's the protagonist, who trained her in the past to become absolutely obedient to him. To the point of devotion."},{"spoiler":false,"text":"Entrusted with Meiran Girls Academy she converted it into a hunting ground for the protagonist. While the protagonist commits immoral acts, she hides them away with her powers as Principal."}],"source":"vndb","sourceCharacterId":"c18015"},{"segments":[{"spoiler":false,"text":"舞台となる明蘭女学園を治める若き学園長。"},{"spoiler":false,"text":"気が強くてプライドも高い、絵に描いたような高慢な性格のお嬢様。"},{"spoiler":false,"text":"傍若無人で、顎で他人を使い、権力で相手をねじ伏せる。"},{"spoiler":false,"text":"だが主人公にだけは、過去に調教を受けたことにより絶対服従しており、媚びた態度を見せる。"},{"spoiler":false,"text":"自身が経営を任されている明蘭女学園を主人公が楽しむための狩り場へと作り替えており、主人公が学園で起こす様々な無茶を、学園長の権力をもって隠蔽する。"}],"source":"egs","sourceCharacterId":"3317","sourceWorkId":"20165","spoiler":false},{"segments":[{"spoiler":false,"text":"舞台となる明蘭女学園を治める若き学園長。"},{"spoiler":false,"text":"気が強くてプライドも高い、絵に描いたような高慢な性格のお嬢様。"},{"spoiler":false,"text":"傍若無人で顎で他人を使い、権力で相手をねじ伏せる。"},{"spoiler":false,"text":"だが主人公にだけは、過去に調教を受けたことにより絶対服従しており、媚びた態度を見せる。"},{"spoiler":false,"text":"自身が経営を任されている明蘭女学園を主人公が楽しむための狩り場へと作り替えており、主人公が学園で起こす様々な無茶を、学園長の権力をもって隠蔽する。"}],"source":"bangumi","sourceCharacterId":"25640"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/456ff03387ab7597e55c7d1d6e3c1ee259d05335c812670c1d5ece5b4d449301.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/im