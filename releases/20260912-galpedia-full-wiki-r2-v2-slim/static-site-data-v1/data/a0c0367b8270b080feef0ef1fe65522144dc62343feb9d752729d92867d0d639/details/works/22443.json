bangumi","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Karen is a proud goddess of love. Falling in love with a human is beneath her. After she realizes she's been struck by her own love arrow she works on a cure but Keisuke's kindness toward her and her overwhelming feelings of love for him make it difficult to concentrate sometimes."},{"spoiler":false,"text":"Her name is based on Voluptas, daughter of Cupid and Psyche."}],"source":"vndb","sourceCharacterId":"c37254"},{"segments":[{"spoiler":false,"text":"正真正銘の女神。恋の矢を使って運命の相手同士を結び付ける役目を担っている。"},{"spoiler":false,"text":"自分では優秀だと思っているが、本能のまま後先考えず行動しては失敗しており、メイラに馬鹿にされている。"},{"spoiler":false,"text":"女神という崇高な立場に強い自尊心を持っており、人間と神との恋愛には否定的。自分が結び付けているという自覚からか、人間を見下しているが……。"}],"source":"egs","sourceCharacterId":"7192","sourceWorkId":"22443","spoiler":false},{"segments":[{"spoiler":false,"text":"正真正銘の女神。 恋の矢を使って運命の相手同士を結び付ける役目を担っている。"},{"spoiler":false,"text":"自分では優秀だと思っているが、本能のまま後先考えずに行動しては失敗している。"},{"spoiler":false,"text":"おかげでメイラからは “ダメガミ” と呼ばれ、いつも馬鹿にされている。"},{"spoiler":false,"text":"女神という崇高な立場に強い自尊心を持っており、人間と神との恋愛には否定的。"},{"spoiler":false,"text":"自分が結び付けているという自負からか、人間を見下しているが……。"},{"spoiler":false,"text":"「女神と人間を一緒にしないでよね。 女神っていうのは崇高で、高貴で、高潔なんだから。 わたしのように！」"}],"source":"bangumi","sourceCharacterId":"37145"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"7192","sourceWorkId":"22443","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"7192","sourceWorkId":"22443","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"7192","sourceWorkId":"22443","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"7192